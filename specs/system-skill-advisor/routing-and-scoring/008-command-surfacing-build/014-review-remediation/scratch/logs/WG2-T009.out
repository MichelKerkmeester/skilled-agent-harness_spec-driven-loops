,\n218:   '/doctor:sk-code setup': { policy: 'run', ownerSkillId: 'sk-code', scorerRow: true },\n219:   '/doctor:sk-skill check': { policy: 'run', ownerSkillId: 'sk-doc', scorerRow: true },\n220:   '/doctor:sk-skill convert': { policy: 'ask', ownerSkillId: 'sk-doc', scorerRow: true },\n221:   '/doctor:skill-advisor embedder': { policy: 'ask', ownerSkillId: 'system-skill-advisor', scorerRow: true },\n222:   '/doctor:skill-advisor parent-skill': { policy: 'run', ownerSkillId: 'system-skill-advisor', scorerRow: true },\n223:   '/doctor:skill-advisor rebuild': { policy: 'ask', ownerSkillId: 'system-skill-advisor', scorerRow: true },\n224:   '/doctor:skill-advisor router-reach': { policy: 'run', ownerSkillId: 'system-skill-advisor', scorerRow: true },\n225:   '/doctor:skill-advisor skill-budget': { policy: 'run', ownerSkillId: 'system-skill-advisor', scorerRow: true },\n226:   '/doctor:skill-advisor skill-graph-freshness': { policy: 'run', ownerSkillId: 'system-skill-advisor', scorerRow: true },\n227:   '/doctor:skill-advisor tune': { policy: 'ask', ownerSkillId: 'system-skill-advisor', scorerRow: true },\n228:   '/doctor:speckit': { policy: 'run', ownerSkillId: 'system-skilled-doctor', scorerRow: true },\n229:   '/doctor:symlink check': { policy: 'run', ownerSkillId: 'system-skilled-doctor', scorerRow: true },\n230:   '/doctor:symlink link': { policy: 'ask', ownerSkillId: 'system-skilled-doctor', scorerRow: true },\n231:   '/doctor:symlink unlink': { policy: 'ask', ownerSkillId: 'system-skilled-doctor', scorerRow: true },\n232:   '/doctor:update': { policy: 'ask', ownerSkillId: 'system-skilled-doctor', scorerRow: true },\n233:   '/prompt:improve': { policy: 'start', ownerSkillId: 'sk-prompt', scorerRow: true },\n234:   '/speckit:complete': { policy: 'start', ownerSkillId: 'system-spec-kit', scorerRow: true },\n235:   '/speckit:handoff': { policy: 'ask', ownerSkillId: 'system-spec-kit', scorerRow: true },\n236:   '/speckit:implement': { policy: 'start', ownerSkillId: 'system-spec-kit', scorerRow: true },\n237:   '/speckit:plan': { policy: 'start', ownerSkillId: 'system-spec-kit', scorerRow: true },\n238:   '/speckit:resume': { policy: 'start', ownerSkillId: 'system-spec-kit', scorerRow: true },\n239:   '/speckit:save': { policy: 'start', ownerSkillId: 'system-spec-kit', scorerRow: true },\n240:   '/speckit:search': { policy: 'run', ownerSkillId: 'system-spec-kit', scorerRow: true },\n241: };\n242: // END GENERATED COMMAND ROWS\n243: \n244: // The row for an id a recommendation carries, or undefined when that id names no\n245: // command. Own-key lookup because the table is generated data, so an inherited\n246: // name such as `constructor` must not resolve to a row nobody declared.\n247: export function commandRowFor(id: string): CommandRow | undefined {\n248:   return Object.hasOwn(COMMAND_ROWS, id) ? COMMAND_ROWS[id] : undefined;\n249: }\n250: \n251: // A typed command is the reader's own wording, so it counts only where a command\n252: // can start and where it ends on a boundary. That keeps a path such as\n253: // `docs/create:goal.md` and a prefix such as `/create:sk` from reading as a\n254: // command, and the longest key wins so `/create:skill-parent` is never reduced to\n255: // its `/create:skill` prefix.\n256: const COMMAND_START_BOUNDARY = /[\\s`'\"(]/;\n257: const COMMAND_CONTINUATION = /[a-z0-9_:-]/;\n258: \n259: export function typedCommandIn(prompt: string): string | undefined {\n260:   const lowered = prompt.toLowerCase();\n261:   let found: string | undefined;\n262:   for (const key of Object.keys(TRACKED_COMMANDS)) {\n263:     let index = lowered.indexOf(key);\n264:     while (index !== -1) {\n265:       const before = index === 0 ? '' : lowered[index - 1];\n266:       const after = lowered[index + key.length] ?? '';\n267:       const startsAtBoundary = before === '' || COMMAND_START_BOUNDARY.test(before);\n268:       const endsAtBoundary = after === '' || !COMMAND_CONTINUATION.test(after);\n269:       if (startsAtBoundary && endsAtBoundary) {\n270:         if (found === undefined || key.length > found.length) found = key;\n271:         break;\n272:       }\n273:       index = lowered.indexOf(key, index + 1);\n274:     }\n275:   }\n276:   return found;\n277: }\n278: \n279: // A typed command travels on the recommendation that leads, so it is delivered\n280: // only when the leading skill owns the command or carries the same command row.\n281: // A leading skill unrelated to the command must not carry it.\n282: export interface TypedCommand {\n283:   readonly command: string;\n284:   readonly policy: 'run' | 'start' | 'ask';\n285:   readonly ownerSkillId: string;\n286: }\n287: \n288: export function typedCommandForTop(topSkillId: string, prompt: string): TypedCommand | undefined {\n289:   const command = typedCommandIn(prompt);\n290:   if (command === undefined || !Object.hasOwn(TRACKED_COMMANDS, command)) return undefined;\n291:   const row = TRACKED_COMMANDS[command];\n292:   const sameCommandRow = commandRowFor(topSkillId)?.command === command;\n293:   if (topSkillId !== row.ownerSkillId && !sameCommandRow) return undefined;\n294:   return { command, policy: row.policy, ownerSkillId: row.ownerSkillId };\n295: }\n296: \n297: // Deep-loop commands open a long, multi-pass run, so one attached to a prompt\n298: // that merely mentions the topic spends the reader's budget on work they never\n299: // asked for. The list below is the vocabulary that counts as asking for it, and\n300: // it holds only effort wording: a bare topic word such as `research`, `review`\n301: // or `council` says what to look at, never how far to go, so it never qualifies\n302: // on its own.\n303: //\n304: // The phrases live in a data list, one per line, so the vocabulary a reviewer\n305: // has to judge stays visible and cheap to correct.\n306: export const DEPTH_WORDING: readonly string[] = [\n307:   'in depth',\n308:   'deep dive',\n309:   'deep research',\n310:   'deep review',\n311:   'thorough',\n312:   'thoroughly',\n313:   'exhaustive',\n314:   'iteratively',\n315:   'multiple passes',\n316:   'many passes',\n317:   'several passes',\n318:   'ask the council',\n319:   'convene',\n320:   'several models',\n321:   'final verdict',\n322:   'everything you can',\n323: ];\n324: \n325: // A phrase may carry punctuation a regex would read as a metacharacter, so it is\n326: // escaped before it is trusted as a pattern.\n327: function escapePhrase(phrase: string): string {\n328:   return phrase.replace(/[.*+?^${}()|[\\]\\\\]/g, '\\\\$&');\n329: }\n330: \n331: // One alternation over the list keeps the gate a single test per prompt, and the\n332: // boundary markers keep `thorough` from firing inside a longer word while a\n333: // multi-word phrase still has to match as a whole.\n334: const DEPTH_REQUEST = new RegExp(`\\\\b(?:${DEPTH_WORDING.map(escapePhrase).join('|')})\\\\b`);\n335: \n336: // A compiled route arrives as unvalidated JSON from a separate process, so the\n337: // shape is narrowed here rather than trusted. Arrays count as objects in\n338: // JavaScript and would let `action` read off an unrelated field, so they are\n339: // excluded explicitly.\n340: function asRecord(value: unknown): Record<string, unknown> | undefined {\n341:   if (typeof value !== 'object' || value === null || Array.isArray(value)) return undefined;\n342:   return value as Record<string, unknown>;\n343: }\n344: \n345: // The command for a hub's recommendation, or undefined when the route does not\n346: // single out one mode. Only a single-mode route names a command unambiguously:\n347: // a bundle or a multi-target route has more than one answer, and asking the\n348: // reader to pick belongs to the recommend path, not here. Never throws, because\n349: // a missing command must degrade to \"no command offered\" rather than break\n350: // routing. The prompt decides whether a costly deep-loop command is offered at\n351: // all: a reader who only asks about the topic gets no command, rather than one\n352: // that would launch work they never requested.\n353: export function attachCommand(\n354:   skillId: string,\n355:   compiledRoute: unknown,\n356:   prompt: string,\n357:   modeCommands: Readonly<Record<string, Readonly<Record<string, string>>>> = MODE_COMMANDS,\n358: ): string | undefined {\n359:   const route = asRecord(compiledRoute);\n360:   if (!route) return undefined;\n361:   if (route.action !== 'route' || route.selectionKind !== 'single') return undefined;\n362: \n363:   const targets = route.targets;\n364:   if (!Array.isArray(targets) || targets.length !== 1) return undefined;\n365: \n366:   const onlyTarget = asRecord(targets[0]);\n367:   if (!onlyTarget) return undefined;\n368: \n369:   const workflowMode = onlyTarget.workflowMode;\n370:   if (typeof workflowMode !== 'string' || workflowMode === '') return undefined;\n371: \n372:   // Own-key lookup on both levels: the table is data read from a generated\n373:   // object, so an inherited name such as `constructor` must not resolve to a\n374:   // command the hub never declared.\n375:   if (!Object.prototype.hasOwnProperty.call(modeCommands, skillId)) return undefined;\n376:   const commands = modeCommands[skillId];\n377:   if (!Object.prototype.hasOwnProperty.call(commands, workflowMode)) return undefined;\n378: \n379:   // Deep-loop commands are the ones that commit the reader to a long, multi-pass\n380:   // run, so they are offered only when the prompt asks for that effort. Typing\n381:   // the slash command is itself the ask, and every other hub answers a short\n382:   // question with a short answer, so no other skill consults the wording list.\n383:   if (skillId === 'system-deep-loop') {\n384:     const lowered = prompt.toLowerCase();\n385:     if (!lowered.includes('/deep:') && !DEPTH_REQUEST.test(lowered)) return undefined;\n386:   }\n387: \n388:   return commands[workflowMode];\n389: }\n390: \n391: // A hub that withholds its command because the prompt names no single mode must\n392: // still tell the reader why no command came with it, and only a hub whose modes\n393: // map to commands withholds one.\n394: export function routeNeedsMode(skillId: string, compiledRoute: unknown): boolean {\n395:   const route = asRecord(compiledRoute);\n396:   if (!route) return false;\n397:   if (route.action !== 'defer' && route.action !== 'clarify') return false;\n398:   return Object.prototype.hasOwnProperty.call(MODE_COMMANDS, skillId);\n399: }","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/lib/command-attach.ts, lines 1-399\n1: // ───────────────────────────────────────────────────────────────\n2: // MODULE: Slash command attached to a hub's recommendation\n3: // ───────────────────────────────────────────────────────────────\n4: //\n5: // The advisor can name the workflow mode a hub would route a prompt to, but the\n6: // reader still has to translate that mode into the slash command that acts on\n7: // it. This module owns that translation and nothing else, kept free of imports\n8: // so the recommend path and a test read the same semantics.\n9: //\n10: // The mode-to-command table is generated rather than hand-maintained: each row is\n11: // derived from a hub's own command files, so a hub that adds or renames a mode\n12: // regenerates its row instead of drifting from a copy someone forgot to update.\n13: \n14: // BEGIN GENERATED MODE COMMANDS\n15: export const MODE_COMMANDS: Readonly<Record<string, Readonly<Record<string, string>>>> = {\n16:   'sk-design': {\n17:     'sk-design-chart': '/design:chart',\n18:     'sk-design-diagram': '/design:diagram',\n19:     'sk-design-md-generator': '/design:extract',\n20:   },\n21:   'sk-doc': {\n22:     'sk-create-agent': '/create:agent',\n23:     'sk-create-benchmark': '/create:benchmark',\n24:     'sk-create-changelog': '/create:changelog',\n25:     'sk-create-command': '/create:command',\n26:     'sk-create-diff': '/create:diff',\n27:     'sk-create-feature-catalog': '/create:feature-catalog',\n28:     'sk-create-goal': '/create:goal',\n29:     'sk-create-manual-testing-playbook': '/create:manual-testing-playbook',\n30:     'sk-create-readme': '/create:readme',\n31:     'sk-create-repo-rule': '/create:repo-rule',\n32:     'sk-create-skill': '/create:skill',\n33:     'sk-create-skill-parent': '/create:skill-parent',\n34:     'sk-create-with-human-voice': '/create:with-human-voice',\n35:   },\n36:   'system-deep-loop': {\n37:     'ai-council': '/deep:ai-council',\n38:     'research': '/deep:research',\n39:     'review': '/deep:review',\n40:   },\n41: };\n42: // END GENERATED MODE COMMANDS\n43: \n44: // One row of the command table: the runnable slash command, the policy that says\n45: // whether it runs, asks or starts a session, the class that says what the run\n46: // writes, and the skill that owns it. The rows are generated, so only the shape\n47: // lives here.\n48: export interface CommandRow {\n49:   readonly command: string;\n50:   readonly policy?: 'run' | 'start' | 'ask';\n51:   readonly mutating?: 'read-only' | 'add-only' | 'mutates';\n52:   readonly ownerSkillId: string;\n53: }\n54: \n55: // The table below covers every tracked command, whether or not its bridge is\n56: // active, so a typed command always has a policy and an owner. `scorerRow` says\n57: // whether a scorer can also return the command on its own.\n58: export interface TrackedCommand {\n59:   readonly policy: 'run' | 'start' | 'ask';\n60:   readonly ownerSkillId: string;\n61:   readonly scorerRow: boolean;\n62: }\n63: \n64: // BEGIN GENERATED COMMAND ROWS\n65: export const COMMAND_ROWS: Readonly<Record<string, CommandRow>> = {\n66:   'command-create-agent': { command: '/create:agent', policy: 'start', mutating: 'mutates', ownerSkillId: 'sk-doc' },\n67:   'command-create-changelog': { command: '/create:changelog', policy: 'ask', mutating: 'mutates', ownerSkillId: 'sk-doc' },\n68:   'command-create-feature-catalog': { command: '/create:feature-catalog', policy: 'start', mutating: 'mutates', ownerSkillId: 'sk-doc' },\n69:   'command-create-manual-testing-playbook': { command: '/create:manual-testing-playbook', policy: 'start', mutating: 'mutates', ownerSkillId: 'sk-doc' },\n70:   'command-create-readme': { command: '/create:readme', policy: 'start', mutating: 'mutates', ownerSkillId: 'sk-doc' },\n71:   'command-create-skill': { command: '/create:skill', policy: 'start', mutating: 'mutates', ownerSkillId: 'sk-doc' },\n72:   'command-deep-research': { command: '/deep:research', policy: 'ask', mutating: 'mutates', ownerSkillId: 'system-deep-loop' },\n73:   'command-deep-review': { command: '/deep:review', policy: 'ask', mutating: 'mutates', ownerSkillId: 'system-deep-loop' },\n74:   'command-doctor-agents-md-check': { command: '/doctor:agents-md check', policy: 'run', mutating: 'read-only', ownerSkillId: 'system-skilled-doctor' },\n75:   'command-doctor-agents-md-embed': { command: '/doctor:agents-md embed', policy: 'ask', mutating: 'mutates', ownerSkillId: 'system-skilled-doctor' },\n76:   'command-doctor-agents-md-restore': { command: '/doctor:agents-md restore', policy: 'ask', mutating: 'mutates', ownerSkillId: 'system-skilled-doctor' },\n77:   'command-doctor-ci-report': { command: '/doctor:ci report', policy: 'run', mutating: 'read-only', ownerSkillId: 'sk-code' },\n78:   'command-doctor-ci-scaffold': { command: '/doctor:ci scaffold', policy: 'ask', mutating: 'mutates', ownerSkillId: 'sk-code' },\n79:   'command-doctor-ci-toggle': { command: '/doctor:ci toggle', policy: 'ask', mutating: 'mutates', ownerSkillId: 'sk-code' },\n80:   'command-doctor-deep-loop': { command: '/doctor:deep-loop', policy: 'run', mutating: 'add-only', ownerSkillId: 'system-deep-loop' },\n81:   'command-doctor-env': { command: '/doctor:env list', policy: 'run', mutating: 'read-only', ownerSkillId: 'system-skilled-doctor' },\n82:   'command-doctor-git-hooks': { command: '/doctor:git hooks', policy: 'ask', mutating: 'mutates', ownerSkillId: 'sk-git' },\n83:   'command-doctor-git-setup': { command: '/doctor:git setup', policy: 'run', mutating: 'read-only', ownerSkillId: 'sk-git' },\n84:   'command-doctor-git-standards': { command: '/doctor:git standards', policy: 'ask', mutating: 'mutates', ownerSkillId: 'sk-git' },\n85:   'command-doctor-helper': { command: '/doctor:helper', policy: 'run', mutating: 'read-only', ownerSkillId: 'system-skilled-doctor' },\n86:   'command-doctor-install': { command: '/doctor:install', policy: 'run', mutating: 'read-only', ownerSkillId: 'system-skilled-doctor' },\n87:   'command-doctor-mcp-debug': { command: '/doctor:mcp debug', policy: 'ask', mutating: 'mutates', ownerSkillId: 'system-skilled-doctor' },\n88:   'command-doctor-mcp-install': { command: '/doctor:mcp install', policy: 'ask', mutating: 'mutates', ownerSkillId: 'system-skilled-doctor' },\n89:   'command-doctor-overlay-apply': { command: '/doctor:overlay apply', policy: 'ask', mutating: 'mutates', ownerSkillId: 'system-skilled-doctor' },\n90:   'command-doctor-overlay-repin': { command: '/doctor:overlay repin', policy: 'ask', mutating: 'mutates', ownerSkillId: 'system-skilled-doctor' },\n91:   'command-doctor-overlay-status': { command: '/doctor:overlay status', policy: 'run', mutating: 'read-only', ownerSkillId: 'system-skilled-doctor' },\n92:   'command-doctor-runtime-mirrors': { command: '/doctor:runtime-mirrors', policy: 'run', mutating: 'read-only', ownerSkillId: 'system-skilled-doctor' },\n93:   'command-doctor-setup': { command: '/doctor:setup', policy: 'run', mutating: 'read-only', ownerSkillId: 'system-skilled-doctor' },\n94:   'command-doctor-sk-code-quality': { command: '/doctor:sk-code quality', policy: 'ask', mutating: 'mutates', ownerSkillId: 'sk-code' },\n95:   'command-doctor-sk-code-setup': { command: '/doctor:sk-code setup', policy: 'run', mutating: 'read-only', ownerSkillId: 'sk-code' },\n96:   'command-doctor-sk-skill-check': { command: '/doctor:sk-skill check', policy: 'run', mutating: 'read-only', ownerSkillId: 'sk-doc' },\n97:   'command-doctor-sk-skill-convert': { command: '/doctor:sk-skill convert', policy: 'ask', mutating: 'mutates', ownerSkillId: 'sk-doc' },\n98:   'command-doctor-skill-advisor-embedder': { command: '/doctor:skill-advisor embedder', policy: 'ask', mutating: 'mutates', ownerSkillId: 'system-skill-advisor' },\n99:   'command-doctor-skill-advisor-parent-skill': { command: '/doctor:skill-advisor parent-skill', policy: 'run', mutating: 'read-only', ownerSkillId: 'system-skill-advisor' },\n100:   'command-doctor-skill-advisor-rebuild': { command: '/doctor:skill-advisor rebuild', policy: 'ask', mutating: 'mutates', ownerSkillId: 'system-skill-advisor' },\n101:   'command-doctor-skill-advisor-router-reach': { command: '/doctor:skill-advisor router-reach', policy: 'run', mutating: 'read-only', ownerSkillId: 'system-skill-advisor' },\n102:   'command-doctor-skill-advisor-skill-budget': { command: '/doctor:skill-advisor skill-budget', policy: 'run', mutating: 'read-only', ownerSkillId: 'system-skill-advisor' },\n103:   'command-doctor-skill-advisor-skill-graph-freshness': { command: '/doctor:skill-advisor skill-graph-freshness', policy: 'run', mutating: 'read-only', ownerSkillId: 'system-skill-advisor' },\n104:   'command-doctor-skill-advisor-tune': { command: '/doctor:skill-advisor tune', policy: 'ask', mutating: 'mutates', ownerSkillId: 'system-skill-advisor' },\n105:   'command-doctor-speckit': { command: '/doctor:speckit', policy: 'run', mutating: 'add-only', ownerSkillId: 'system-skilled-doctor' },\n106:   'command-doctor-symlink-check': { command: '/doctor:symlink check', policy: 'run', mutating: 'read-only', ownerSkillId: 'system-skilled-doctor' },\n107:   'command-doctor-symlink-link': { command: '/doctor:symlink link', policy: 'ask', mutating: 'mutates', ownerSkillId: 'system-skilled-doctor' },\n108:   'command-doctor-symlink-unlink': { command: '/doctor:symlink unlink', policy: 'ask', mutating: 'mutates', ownerSkillId: 'system-skilled-doctor' },\n109:   'command-doctor-update': { command: '/doctor:update', policy: 'ask', mutating: 'mutates', ownerSkillId: 'system-skilled-doctor' },\n110:   'command-prompt-improve': { command: '/prompt:improve', policy: 'start', mutating: 'mutates', ownerSkillId: 'sk-prompt' },\n111:   'command-spec-kit-deep-research': { command: '/deep:research', policy: 'ask', mutating: 'mutates', ownerSkillId: 'system-deep-loop' },\n112:   'command-spec-kit-deep-review': { command: '/deep:review', policy: 'ask', mutating: 'mutates', ownerSkillId: 'system-deep-loop' },\n113:   'command-speckit-complete': { command: '/speckit:complete', policy: 'start', mutating: 'mutates', ownerSkillId: 'system-spec-kit' },\n114:   'command-speckit-handoff': { command: '/speckit:handoff', policy: 'ask', mutating: 'mutates', ownerSkillId: 'system-spec-kit' },\n115:   'command-speckit-implement': { command: '/speckit:implement', policy: 'start', mutating: 'mutates', ownerSkillId: 'system-spec-kit' },\n116:   'command-speckit-plan': { command: '/speckit:plan', policy: 'start', mutating: 'mutates', ownerSkillId: 'system-spec-kit' },\n117:   'command-speckit-resume': { command: '/speckit:resume', policy: 'start', mutating: 'mutates', ownerSkillId: 'system-spec-kit' },\n118:   'command-speckit-save': { command: '/speckit:save', policy: 'start', mutating: 'mutates', ownerSkillId: 'system-spec-kit' },\n119:   'command-speckit-search': { command: '/speckit:search', policy: 'run', mutating: 'read-only', ownerSkillId: 'system-spec-kit' },\n120:   'create:agent': { command: '/create:agent', policy: 'start', mutating: 'mutates', ownerSkillId: 'sk-doc' },\n121:   'create:manual-testing-playbook': { command: '/create:manual-testing-playbook', policy: 'start', mutating: 'mutates', ownerSkillId: 'sk-doc' },\n122: };\n123: export const COMMAND_POLICIES: Readonly<Record<string, 'run' | 'start' | 'ask'>> = {\n124:   '/create:agent': 'start',\n125:   '/create:changelog': 'ask',\n126:   '/create:feature-catalog': 'start',\n127:   '/create:manual-testing-playbook': 'start',\n128:   '/create:readme': 'start',\n129:   '/create:skill': 'start',\n130:   '/deep:research': 'ask',\n131:   '/deep:review': 'ask',\n132:   '/doctor:agents-md check': 'run',\n133:   '/doctor:agents-md embed': 'ask',\n134:   '/doctor:agents-md restore': 'ask',\n135:   '/doctor:ci report': 'run',\n136:   '/doctor:ci scaffold': 'ask',\n137:   '/doctor:ci toggle': 'ask',\n138:   '/doctor:deep-loop': 'run',\n139:   '/doctor:env list': 'run',\n140:   '/doctor:git hooks': 'ask',\n141:   '/doctor:git setup': 'run',\n142:   '/doctor:git standards': 'ask',\n143:   '/doctor:helper': 'run',\n144:   '/doctor:install': 'run',\n145:   '/doctor:mcp debug': 'ask',\n146:   '/doctor:mcp install': 'ask',\n147:   '/doctor:overlay apply': 'ask',\n148:   '/doctor:overlay repin': 'ask',\n149:   '/doctor:overlay status': 'run',\n150:   '/doctor:runtime-mirrors': 'run',\n151:   '/doctor:setup': 'run',\n152:   '/doctor:sk-code quality': 'ask',\n153:   '/doctor:sk-code setup': 'run',\n154:   '/doctor:sk-skill check': 'run',\n155:   '/doctor:sk-skill convert': 'ask',\n156:   '/doctor:skill-advisor embedder': 'ask',\n157:   '/doctor:skill-advisor parent-skill': 'run',\n158:   '/doctor:skill-advisor rebuild': 'ask',\n159:   '/doctor:skill-advisor router-reach': 'run',\n160:   '/doctor:skill-advisor skill-budget': 'run',\n161:   '/doctor:skill-advisor skill-graph-freshness': 'run',\n162:   '/doctor:skill-advisor tune': 'ask',\n163:   '/doctor:speckit': 'run',\n164:   '/doctor:symlink check': 'run',\n165:   '/doctor:symlink link': 'ask',\n166:   '/doctor:symlink unlink': 'ask',\n167:   '/doctor:update': 'ask',\n168:   '/prompt:improve': 'start',\n169:   '/speckit:complete': 'start',\n170:   '/speckit:handoff': 'ask',\n171:   '/speckit:implement': 'start',\n172:   '/speckit:plan': 'start',\n173:   '/speckit:resume': 'start',\n174:   '/speckit:save': 'start',\n175:   '/speckit:search': 'run',\n176: };\n177: export const TRACKED_COMMANDS: Readonly<Record<string, TrackedCommand>> = {\n178:   '/create:agent': { policy: 'start', ownerSkillId: 'sk-doc', scorerRow: true },\n179:   '/create:benchmark': { policy: 'start', ownerSkillId: 'sk-doc', scorerRow: false },\n180:   '/create:changelog': { policy: 'ask', ownerSkillId: 'sk-doc', scorerRow: false },\n181:   '/create:command': { policy: 'start', ownerSkillId: 'sk-doc', scorerRow: false },\n182:   '/create:diff': { policy: 'start', ownerSkillId: 'sk-doc', scorerRow: false },\n183:   '/create:feature-catalog': { policy: 'start', ownerSkillId: 'sk-doc', scorerRow: false },\n184:   '/create:goal': { policy: 'start', ownerSkillId: 'sk-doc', scorerRow: false },\n185:   '/create:manual-testing-playbook': { policy: 'start', ownerSkillId: 'sk-doc', scorerRow: true },\n186:   '/create:readme': { policy: 'start', ownerSkillId: 'sk-doc', scorerRow: false },\n187:   '/create:repo-rule': { policy: 'start', ownerSkillId: 'sk-doc', scorerRow: false },\n188:   '/create:skill': { policy: 'start', ownerSkillId: 'sk-doc', scorerRow: false },\n189:   '/create:skill-parent': { policy: 'start', ownerSkillId: 'sk-doc', scorerRow: false },\n190:   '/create:with-human-voice': { policy: 'start', ownerSkillId: 'sk-doc', scorerRow: false },\n191:   '/deep:ai-council': { policy: 'ask', ownerSkillId: 'system-deep-loop', scorerRow: false },\n192:   '/deep:research': { policy: 'ask', ownerSkillId: 'system-deep-loop', scorerRow: false },\n193:   '/deep:review': { policy: 'ask', ownerSkillId: 'system-deep-loop', scorerRow: false },\n194:   '/design:chart': { policy: 'start', ownerSkillId: 'sk-design', scorerRow: false },\n195:   '/design:diagram': { policy: 'start', ownerSkillId: 'sk-design', scorerRow: false },\n196:   '/design:extract': { policy: 'ask', ownerSkillId: 'sk-design', scorerRow: false },\n197:   '/doctor:agents-md check': { policy: 'run', ownerSkillId: 'system-skilled-doctor', scorerRow: true },\n198:   '/doctor:agents-md embed': { policy: 'ask', ownerSkillId: 'system-skilled-doctor', scorerRow: true },\n199:   '/doctor:agents-md restore': { policy: 'ask', ownerSkillId: 'system-skilled-doctor', scorerRow: true },\n200:   '/doctor:ci report': { policy: 'run', ownerSkillId: 'sk-code', scorerRow: true },\n201:   '/doctor:ci scaffold': { policy: 'ask', ownerSkillId: 'sk-code', scorerRow: true },\n202:   '/doctor:ci toggle': { policy: 'ask', ownerSkillId: 'sk-code', scorerRow: true },\n203:   '/doctor:deep-loop': { policy: 'run', ownerSkillId: 'system-deep-loop', scorerRow: true },\n204:   '/doctor:env list': { policy: 'run', ownerSkillId: 'system-skilled-doctor', scorerRow: true },\n205:   '/doctor:git hooks': { policy: 'ask', ownerSkillId: 'sk-git', scorerRow: true },\n206:   '/doctor:git setup': { policy: 'run', ownerSkillId: 'sk-git', scorerRow: true },\n207:   '/doctor:git standards': { policy: 'ask', ownerSkillId: 'sk-git', scorerRow: true },\n208:   '/doctor:helper': { policy: 'run', ownerSkillId: 'system-skilled-doctor', scorerRow: true },\n209:   '/doctor:install': { policy: 'run', ownerSkillId: 'system-skilled-doctor', scorerRow: true },\n210:   '/doctor:mcp debug': { policy: 'ask', ownerSkillId: 'system-skilled-doctor', scorerRow: true },\n211:   '/doctor:mcp install': { policy: 'ask', ownerSkillId: 'system-skilled-doctor', scorerRow: true },\n212:   '/doctor:overlay apply': { policy: 'ask', ownerSkillId: 'system-skilled-doctor', scorerRow: true },\n213:   '/doctor:overlay repin': { policy: 'ask', ownerSkillId: 'system-skilled-doctor', scorerRow: true },\n214:   '/doctor:overlay status': { policy: 'run', ownerSkillId: 'system-skilled-doctor', scorerRow: true },\n215:   '/doctor:runtime-mirrors': { policy: 'run', ownerSkillId: 'system-skilled-doctor', scorerRow: true },\n216:   '/doctor:setup': { policy: 'run', ownerSkillId: 'system-skilled-doctor', scorerRow: true },\n217:   '/doctor:sk-code quality': { policy: 'ask', ownerSkillId: 'sk-code', scorerRow: true },\n218:   '/doctor:sk-code setup': { policy: 'run', ownerSkillId: 'sk-code', scorerRow: true },\n219:   '/doctor:sk-skill check': { policy: 'run', ownerSkillId: 'sk-doc', scorerRow: true },\n220:   '/doctor:sk-skill convert': { policy: 'ask', ownerSkillId: 'sk-doc', scorerRow: true },\n221:   '/doctor:skill-advisor embedder': { policy: 'ask', ownerSkillId: 'system-skill-advisor', scorerRow: true },\n222:   '/doctor:skill-advisor parent-skill': { policy: 'run', ownerSkillId: 'system-skill-advisor', scorerRow: true },\n223:   '/doctor:skill-advisor rebuild': { policy: 'ask', ownerSkillId: 'system-skill-advisor', scorerRow: true },\n224:   '/doctor:skill-advisor router-reach': { policy: 'run', ownerSkillId: 'system-skill-advisor', scorerRow: true },\n225:   '/doctor:skill-advisor skill-budget': { policy: 'run', ownerSkillId: 'system-skill-advisor', scorerRow: true },\n226:   '/doctor:skill-advisor skill-graph-freshness': { policy: 'run', ownerSkillId: 'system-skill-advisor', scorerRow: true },\n227:   '/doctor:skill-advisor tune': { policy: 'ask', ownerSkillId: 'system-skill-advisor', scorerRow: true },\n228:   '/doctor:speckit': { policy: 'run', ownerSkillId: 'system-skilled-doctor', scorerRow: true },\n229:   '/doctor:symlink check': { policy: 'run', ownerSkillId: 'system-skilled-doctor', scorerRow: true },\n230:   '/doctor:symlink link': { policy: 'ask', ownerSkillId: 'system-skilled-doctor', scorerRow: true },\n231:   '/doctor:symlink unlink': { policy: 'ask', ownerSkillId: 'system-skilled-doctor', scorerRow: true },\n232:   '/doctor:update': { policy: 'ask', ownerSkillId: 'system-skilled-doctor', scorerRow: true },\n233:   '/prompt:improve': { policy: 'start', ownerSkillId: 'sk-prompt', scorerRow: true },\n234:   '/speckit:complete': { policy: 'start', ownerSkillId: 'system-spec-kit', scorerRow: true },\n235:   '/speckit:handoff': { policy: 'ask', ownerSkillId: 'system-spec-kit', scorerRow: true },\n236:   '/speckit:implement': { policy: 'start', ownerSkillId: 'system-spec-kit', scorerRow: true },\n237:   '/speckit:plan': { policy: 'start', ownerSkillId: 'system-spec-kit', scorerRow: true },\n238:   '/speckit:resume': { policy: 'start', ownerSkillId: 'system-spec-kit', scorerRow: true },\n239:   '/speckit:save': { policy: 'start', ownerSkillId: 'system-spec-kit', scorerRow: true },\n240:   '/speckit:search': { policy: 'run', ownerSkillId: 'system-spec-kit', scorerRow: true },\n241: };\n242: // END GENERATED COMMAND ROWS\n243: \n244: // The row for an id a recommendation carries, or undefined when that id names no\n245: // command. Own-key lookup because the table is generated data, so an inherited\n246: // name such as `constructor` must not resolve to a row nobody declared.\n247: export function commandRowFor(id: string): CommandRow | undefined {\n248:   return Object.hasOwn(COMMAND_ROWS, id) ? COMMAND_ROWS[id] : undefined;\n249: }\n250: \n251: // A typed command is the reader's own wording, so it counts only where a command\n252: // can start and where it ends on a boundary. That keeps a path such as\n253: // `docs/create:goal.md` and a prefix such as `/create:sk` from reading as a\n254: // command, and the longest key wins so `/create:skill-parent` is never reduced to\n255: // its `/create:skill` prefix.\n256: const COMMAND_START_BOUNDARY = /[\\s`'\"(]/;\n257: const COMMAND_CONTINUATION = /[a-z0-9_:-]/;\n258: \n259: export function typedCommandIn(prompt: string): string | undefined {\n260:   const lowered = prompt.toLowerCase();\n261:   let found: string | undefined;\n262:   for (const key of Object.keys(TRACKED_COMMANDS)) {\n263:     let index = lowered.indexOf(key);\n264:     while (index !== -1) {\n265:       const before = index === 0 ? '' : lowered[index - 1];\n266:       const after = lowered[index + key.length] ?? '';\n267:       const startsAtBoundary = before === '' || COMMAND_START_BOUNDARY.test(before);\n268:       const endsAtBoundary = after === '' || !COMMAND_CONTINUATION.test(after);\n269:       if (startsAtBoundary && endsAtBoundary) {\n270:         if (found === undefined || key.length > found.length) found = key;\n271:         break;\n272:       }\n273:       index = lowered.indexOf(key, index + 1);\n274:     }\n275:   }\n276:   return found;\n277: }\n278: \n279: // A typed command travels on the recommendation that leads, so it is delivered\n280: // only when the leading skill owns the command or carries the same command row.\n281: // A leading skill unrelated to the command must not carry it.\n282: export interface TypedCommand {\n283:   readonly command: string;\n284:   readonly policy: 'run' | 'start' | 'ask';\n285:   readonly ownerSkillId: string;\n286: }\n287: \n288: export function typedCommandForTop(topSkillId: string, prompt: string): TypedCommand | undefined {\n289:   const command = typedCommandIn(prompt);\n290:   if (command === undefined || !Object.hasOwn(TRACKED_COMMANDS, command)) return undefined;\n291:   const row = TRACKED_COMMANDS[command];\n292:   const sameCommandRow = commandRowFor(topSkillId)?.command === command;\n293:   if (topSkillId !== row.ownerSkillId && !sameCommandRow) return undefined;\n294:   return { command, policy: row.policy, ownerSkillId: row.ownerSkillId };\n295: }\n296: \n297: // Deep-loop commands open a long, multi-pass run, so one attached to a prompt\n298: // that merely mentions the topic spends the reader's budget on work they never\n299: // asked for. The list below is the vocabulary that counts as asking for it, and\n300: // it holds only effort wording: a bare topic word such as `research`, `review`\n301: // or `council` says what to look at, never how far to go, so it never qualifies\n302: // on its own.\n303: //\n304: // The phrases live in a data list, one per line, so the vocabulary a reviewer\n305: // has to judge stays visible and cheap to correct.\n306: export const DEPTH_WORDING: readonly string[] = [\n307:   'in depth',\n308:   'deep dive',\n309:   'deep research',\n310:   'deep review',\n311:   'thorough',\n312:   'thoroughly',\n313:   'exhaustive',\n314:   'iteratively',\n315:   'multiple passes',\n316:   'many passes',\n317:   'several passes',\n318:   'ask the council',\n319:   'convene',\n320:   'several models',\n321:   'final verdict',\n322:   'everything you can',\n323: ];\n324: \n325: // A phrase may carry punctuation a regex would read as a metacharacter, so it is\n326: // escaped before it is trusted as a pattern.\n327: function escapePhrase(phrase: string): string {\n328:   return phrase.replace(/[.*+?^${}()|[\\]\\\\]/g, '\\\\$&');\n329: }\n330: \n331: // One alternation over the list keeps the gate a single test per prompt, and the\n332: // boundary markers keep `thorough` from firing inside a longer word while a\n333: // multi-word phrase still has to match as a whole.\n334: const DEPTH_REQUEST = new RegExp(`\\\\b(?:${DEPTH_WORDING.map(escapePhrase).join('|')})\\\\b`);\n335: \n336: // A compiled route arrives as unvalidated JSON from a separate process, so the\n337: // shape is narrowed here rather than trusted. Arrays count as objects in\n338: // JavaScript and would let `action` read off an unrelated field, so they are\n339: // excluded explicitly.\n340: function asRecord(value: unknown): Record<string, unknown> | undefined {\n341:   if (typeof value !== 'object' || value === null || Array.isArray(value)) return undefined;\n342:   return value as Record<string, unknown>;\n343: }\n344: \n345: // The command for a hub's recommendation, or undefined when the route does not\n346: // single out one mode. Only a single-mode route names a command unambiguously:\n347: // a bundle or a multi-target route has more than one answer, and asking the\n348: // reader to pick belongs to the recommend path, not here. Never throws, because\n349: // a missing command must degrade to \"no command offered\" rather than break\n350: // routing. The prompt decides whether a costly deep-loop command is offered at\n351: // all: a reader who only asks about the topic gets no command, rather than one\n352: // that would launch work they never requested.\n353: export function attachCommand(\n354:   skillId: string,\n355:   compiledRoute: unknown,\n356:   prompt: string,\n357:   modeCommands: Readonly<Record<string, Readonly<Record<string, string>>>> = MODE_COMMANDS,\n358: ): string | undefined {\n359:   const route = asRecord(compiledRoute);\n360:   if (!route) return undefined;\n361:   if (route.action !== 'route' || route.selectionKind !== 'single') return undefined;\n362: \n363:   const targets = route.targets;\n364:   if (!Array.isArray(targets) || targets.length !== 1) return undefined;\n365: \n366:   const onlyTarget = asRecord(targets[0]);\n367:   if (!onlyTarget) return undefined;\n368: \n369:   const workflowMode = onlyTarget.workflowMode;\n370:   if (typeof workflowMode !== 'string' || workflowMode === '') return undefined;\n371: \n372:   // Own-key lookup on both levels: the table is data read from a generated\n373:   // object, so an inherited name such as `constructor` must not resolve to a\n374:   // command the hub never declared.\n375:   if (!Object.prototype.hasOwnProperty.call(modeCommands, skillId)) return undefined;\n376:   const commands = modeCommands[skillId];\n377:   if (!Object.prototype.hasOwnProperty.call(commands, workflowMode)) return undefined;\n378: \n379:   // Deep-loop commands are the ones that commit the reader to a long, multi-pass\n380:   // run, so they are offered only when the prompt asks for that effort. Typing\n381:   // the slash command is itself the ask, and every other hub answers a short\n382:   // question with a short answer, so no other skill consults the wording list.\n383:   if (skillId === 'system-deep-loop') {\n384:     const lowered = prompt.toLowerCase();\n385:     if (!lowered.includes('/deep:') && !DEPTH_REQUEST.test(lowered)) return undefined;\n386:   }\n387: \n388:   return commands[workflowMode];\n389: }\n390: \n391: // A hub that withholds its command because the prompt names no single mode must\n392: // still tell the reader why no command came with it, and only a hub whose modes\n393: // map to commands withholds one.\n394: export function routeNeedsMode(skillId: string, compiledRoute: unknown): boolean {\n395:   const route = asRecord(compiledRoute);\n396:   if (!route) return false;\n397:   if (route.action !== 'defer' && route.action !== 'clarify') return false;\n398:   return Object.prototype.hasOwnProperty.call(MODE_COMMANDS, skillId);\n399: }"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/lib/command-attach.ts\"}"},"time":{"start":1794558650012,"end":1794558650770}}}}
{"type":"tool_use","timestamp":1794558650773,"sessionID":"ses_e2bf947b9ffe73zBWlC0D8WZq4","part":{"partID":"prt_1d407e7d6001ZY1jzaZr9EjQo5","sessionID":"ses_e2bf947b9ffe73zBWlC0D8WZq4","messageID":"msg_1d407adbd0013H209z747mwbsf","type":"tool","id":"call_66b7e16857a34003bc59ddc3","tool":"read","state":{"status":"completed","input":{"path":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/lib/scorer/fusion.ts"},"output":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/lib/scorer/fusion.ts, lines 1-1056\n1: // ───────────────────────────────────────────────────────────────\n2: // MODULE: Advisor 5-Lane Fusion\n3: // ───────────────────────────────────────────────────────────────\n4: \n5: // ───────────────────────────────────────────────────────────────────\n6: // 1. IMPORTS\n7: // ───────────────────────────────────────────────────────────────────\n8: \n9: import { fuseResultsMulti } from '@spec-kit/shared/algorithms/rrf-fusion.js';\n10: \n11: import { applyAmbiguity, isAmbiguousTopTwo, wideAmbiguityMembers } from './ambiguity.js';\n12: import { attributionReason, dominantLane, isDerivedDominant } from './attribution.js';\n13: import {\n14:   ADVISOR_HOOK_FRESHNESS_VALUES,\n15:   ADVISOR_RUNTIME_VALUES,\n16:   isSpeckitMetricsEnabled,\n17:   speckitMetrics,\n18: } from '../metrics.js';\n19: import { normalize } from '../affordance-normalizer.js';\n20: import { COMMAND_ROWS, TRACKED_COMMANDS, typedCommandIn } from '../command-attach.js';\n21: import { scoreDerivedLane } from './lanes/derived.js';\n22: import { scoreExplicitLane } from './lanes/explicit.js';\n23: import { scoreGraphCausalLaneSplit } from './lanes/graph-causal.js';\n24: import { scoreLexicalLane } from './lanes/lexical.js';\n25: import { scoreSemanticShadowExactSubset, scoreSemanticShadowLane } from './lanes/semantic-shadow.js';\n26: import { applyExecutorDelegationOverride } from './executor-delegation.js';\n27: import {\n28:   DOCTOR_HELPER_BRIDGE_ID,\n29:   DOCTOR_HELPER_UNCUED_MIN_SCORE,\n30:   doctorProblemCue,\n31:   genericRepairCue,\n32:   matchDoctorProblem,\n33: } from './doctor-helper-handoff.js';\n34: import { loadAdvisorProjection } from './projection.js';\n35: import { SCORING_CALIBRATION } from './scoring-constants.js';\n36: import { isReadOnlyExplainer, matchesPhraseBoundary } from './text.js';\n37: import {\n38:   DEFAULT_SCORER_WEIGHTS,\n39:   SCORER_LANES,\n40:   liveWeightTotal,\n41: } from './weights-config.js';\n42: import { isLiveScorerLane } from './lane-registry.js';\n43: import { isRouteExcludedSkillId } from '../route-exclusions.js';\n44: import { SKILL_ADVISOR_COMPAT_CONTRACT, resolvedConfidenceThreshold, resolvedUncertaintyThreshold } from '../compat/contract.js';\n45: import type {\n46:   AdvisorProjection,\n47:   AdvisorScoredRecommendation,\n48:   AdvisorScoringOptions,\n49:   AdvisorScoringResult,\n50:   LaneContribution,\n51:   LaneMatch,\n52:   LaneRuntimeHealth,\n53:   LaneScores,\n54:   ScorerLane,\n55:   SkillProjection,\n56: } from './types.js';\n57: import type { NormalizedAffordance } from '../affordance-normalizer.js';\n58: import type { RankedList, RrfItem } from '@spec-kit/shared/algorithms/rrf-fusion.js';\n59: \n60: // ───────────────────────────────────────────────────────────────────\n61: // 2. CONSTANTS\n62: // ───────────────────────────────────────────────────────────────────\n63: \n64: const DEFAULT_CONFIDENCE_THRESHOLD = resolvedConfidenceThreshold();\n65: const DEFAULT_UNCERTAINTY_THRESHOLD = resolvedUncertaintyThreshold();\n66: export const ADVISOR_RRF_FUSION_FLAG = 'SPECKIT_ADVISOR_RRF_FUSION';\n67: export const ADVISOR_QUERY_CLASS_ROUTING_FLAG = 'SPECKIT_ADVISOR_QUERY_CLASS_ROUTING';\n68: export const ADVISOR_EXACT_SEMANTIC_RERANK_FLAG = 'SPECKIT_ADVISOR_EXACT_SEMANTIC_RERANK';\n69: export const ADVISOR_RRF_K = 8;\n70: export const ADVISOR_EXACT_SEMANTIC_RERANK_TOP_K = 10;\n71: const ADVISOR_EXACT_SEMANTIC_RERANK_WINDOW = 0.05;\n72: const TASK_INTENT = /\\b(add|append|build|change|configure|create|edit|fix|generate|implement|modify|move|patch|refactor|rename|replace|run|start|sweep|update|write)\\b/;\n73: const DEEP_RESEARCH_CYCLE = /\\b(automated research cycle|looped investigation|continue iteration|resume iteration|overnight run|overnight research run|packet-local iteration|delta record|canonical jsonl|same lineage)\\b/;\n74: // Writing a test or a helper is code work even when the prompt also names a deep-review phrase or a\n75: // study artifact: the thing asked for comes before the phrase it is written about, so a \"deep review\"\n76: // between the verb and the noun means the loop itself is the subject.\n77: const AUTHORS_CODE = /\\b(?:add|build|create|implement|write)\\b(?:(?!deep[- ]review)[^.?!]){0,60}?\\b(?:helper|vitest|tests?)\\b/;\n78: // Writing a changelog is sk-doc's changelog mode even when the prompt names a\n79: // packet or spec folder. That folder is only where the change history comes from.\n80: // The verb must govern the changelog itself: only articles and folder or scope\n81: // modifiers may sit between them, so \"add a nested phase ... for the changelog\n82: // work\" or \"write the spec folder docs, including the changelog ...\" stay\n83: // spec-folder work.\n84: const CHANGELOG_AUTHORING = /\\b(?:add|create|draft|write)\\s+(?:(?:a|an|the|new|nested|packet|packet-local|phase|global|release)\\s+){0,4}changelog(?:\\s+entry)?\\b/;\n85: const CHANGELOG_PACKET_SOURCE = /\\b(?:packet|nested|spec folder)\\b/;\n86: const FILE_SAVE_OPERATION = /\\bsave\\b.{0,48}\\b(file|files|document|documents|buffer|tab|workspace)\\b|\\b(file|files|document|documents|buffer|tab|workspace)\\b.{0,48}\\bsave\\b/;\n87: const MEMORY_SAVE_CONTEXT_ANCHOR = /\\b(memory|context|conversation|session|handover|checkpoint|resume|preserve|remember|capture|store)\\b|\\/memory:save|memory:save/;\n88: // Class C breadth/multi-concern abstention gates. A broad greenfield build or a\n89: // multi-concern optimization is under-specified for single-skill routing.\n90: const BREADTH_BUILD_VERB = /\\b(build|create|implement|generate|scaffold)\\b/;\n91: const BREADTH_NOUN = /\\b(full[- ]?stack|service|platform|application|microservice|saas|backend|whole (app|system))\\b/;\n92: // Narrow anchors that make a broad-build prompt specific enough to route.\n93: const BREADTH_NARROW_ANCHOR = /\\.[a-z]{2,4}\\b|\\b(test|tests|error|bug|failure|failing|handler|component|function|route|endpoint|class|method|benchmark|review|audit|migration|schema)\\b/;\n94: const MULTI_CONCERN_VERB = /\\b(optimize|improve|enhance|harden|speed up)\\b/;\n95: const CONCERN_PERF = /\\b(speed|latency|execution|throughput|performance|startup|memory|cpu)\\b/;\n96: const CONCERN_QUALITY = /\\b(quality|accuracy|recommendation|recommendations|correctness|reliability|coverage)\\b/;\n97: const TRUE_FLAG_VALUES = new Set(['1', 'true', 'yes', 'on', 'enabled']);\n98: const NO_RRF_RANK = Number.MAX_SAFE_INTEGER;\n99: const ADVISOR_SELF_RECOMMENDATION_SKILL_IDS = new Set(['system-skill-advisor', 'skill-advisor']);\n100: const DOCTOR_BRIDGE_PREFIX = 'command-doctor-';\n101: const DOCTOR_COMMAND_PREFIX = '/doctor:';\n102: \n103: // ───────────────────────────────────────────────────────────────────\n104: // 3. TYPE DEFINITIONS\n105: // ───────────────────────────────────────────────────────────────────\n106: \n107: type MutableLaneScores = {\n108:   -readonly [K in keyof LaneScores]: LaneMatch[];\n109: };\n110: \n111: interface LaneScoreBundle {\n112:   readonly laneScores: LaneScores;\n113:   readonly graphConflictMatches: readonly LaneMatch[];\n114:   readonly graphSupportBySeed: ReadonlyMap<string, ReadonlyMap<string, number>>;\n115: }\n116: \n117: interface AdvisorRrfFusion {\n118:   readonly scoreBySkill: ReadonlyMap<string, number>;\n119:   readonly rankBySkill: ReadonlyMap<string, number>;\n120: }\n121: \n122: type AdvisorRuntimeLabel = (typeof ADVISOR_RUNTIME_VALUES)[number];\n123: type AdvisorFreshnessLabel = (typeof ADVISOR_HOOK_FRESHNESS_VALUES)[number];\n124: export type AdvisorQueryClass = 'implementation' | 'review' | 'documentation' | 'memory' | 'tooling' | 'unknown';\n125: \n126: interface ExactSemanticRerankEntry {\n127:   readonly rawScore: number;\n128: }\n129: \n130: type ExactSemanticRerankIndex = ReadonlyMap<string, ExactSemanticRerankEntry>;\n131: \n132: // ───────────────────────────────────────────────────────────────────\n133: // 4. HELPERS\n134: // ───────────────────────────────────────────────────────────────────\n135: \n136: function emptyLaneScores(): MutableLaneScores {\n137:   return Object.fromEntries(SCORER_LANES.map((lane) => [lane, []])) as unknown as MutableLaneScores;\n138: }\n139: \n140: function projectionWithUsableSkillIds(projection: AdvisorProjection): AdvisorProjection {\n141:   const skills = projection.skills.filter((skill) => {\n142:     const skillId: unknown = skill.id;\n143:     return typeof skillId === 'string' && skillId.trim().length > 0;\n144:   });\n145:   return skills.length === projection.skills.length\n146:     ? projection\n147:     : { ...projection, skills };\n148: }\n149: \n150: export function isAdvisorRrfFusionEnabled(): boolean {\n151:   const value = process.env[ADVISOR_RRF_FUSION_FLAG]?.trim().toLowerCase();\n152:   return value ? TRUE_FLAG_VALUES.has(value) : false;\n153: }\n154: \n155: export function isAdvisorQueryClassRoutingEnabled(): boolean {\n156:   const value = process.env[ADVISOR_QUERY_CLASS_ROUTING_FLAG]?.trim().toLowerCase();\n157:   return value ? TRUE_FLAG_VALUES.has(value) : false;\n158: }\n159: \n160: export function isAdvisorExactSemanticRerankEnabled(): boolean {\n161:   const value = process.env[ADVISOR_EXACT_SEMANTIC_RERANK_FLAG]?.trim().toLowerCase();\n162:   return value ? TRUE_FLAG_VALUES.has(value) : false;\n163: }\n164: \n165: export function classifyAdvisorQuery(prompt: string): AdvisorQueryClass {\n166:   const promptLower = prompt.toLowerCase();\n167:   if (/\\b(save context|save memory|handover|resume|checkpoint|spec folder|implementation summary|packet docs?)\\b/.test(promptLower)) {\n168:     return 'memory';\n169:   }\n170:   if (/\\b(review|audit|findings|regression|pull request|pr readiness|release readiness)\\b/.test(promptLower)) {\n171:     return 'review';\n172:   }\n173:   if (/\\b(readme|markdown|documentation|docs|manual testing playbook|feature catalog|taxonomy)\\b/.test(promptLower)) {\n174:     return 'documentation';\n175:   }\n176:   if (/\\b(call_tool_chain|code mode|tool ?chain|chrome devtools|browser console|figma|github|clickup)\\b/.test(promptLower)) {\n177:     return 'tooling';\n178:   }\n179:   if (TASK_INTENT.test(promptLower) || /\\b(typescript|javascript|python|vitest|mcp|handler|schema|fixture)\\b/.test(promptLower)) {\n180:     return 'implementation';\n181:   }\n182:   return 'unknown';\n183: }\n184: \n185: export function queryClassLaneMultipliers(queryClass: AdvisorQueryClass): Readonly<Partial<Record<ScorerLane, number>>> {\n186:   switch (queryClass) {\n187:     case 'implementation':\n188:       return { explicit_author: 1.04, lexical: 1.00, graph_causal: 0.98, derived_generated: 0.98, semantic_shadow: 1.00 };\n189:     case 'review':\n190:       return { explicit_author: 1.03, lexical: 1.02, graph_causal: 0.96, derived_generated: 0.98, semantic_shadow: 1.00 };\n191:     case 'documentation':\n192:       return { explicit_author: 1.03, lexical: 0.98, graph_causal: 0.95, derived_generated: 1.04, semantic_shadow: 1.00 };\n193:     case 'memory':\n194:       return { explicit_author: 1.04, lexical: 0.98, graph_causal: 1.02, derived_generated: 1.00, semantic_shadow: 0.96 };\n195:     case 'tooling':\n196:       return { explicit_author: 1.04, lexical: 1.00, graph_causal: 0.98, derived_generated: 0.96, semantic_shadow: 1.00 };\n197:     case 'unknown':\n198:       return {};\n199:   }\n200: }\n201: \n202: export function applyQueryClassLaneMultipliers(\n203:   weights: Readonly<Record<ScorerLane, number>>,\n204:   queryClass: AdvisorQueryClass,\n205: ): Readonly<Record<ScorerLane, number>> {\n206:   const multipliers = queryClassLaneMultipliers(queryClass);\n207:   if (Object.keys(multipliers).length === 0) return weights;\n208:   const next = { ...weights };\n209:   for (const lane of SCORER_LANES) {\n210:     const multiplier = multipliers[lane];\n211:     if (typeof multiplier === 'number' && Number.isFinite(multiplier)) {\n212:       next[lane] = Number((next[lane] * multiplier).toFixed(6));\n213:     }\n214:   }\n215:   const strongestOther = Math.max(...SCORER_LANES\n216:     .filter((lane) => lane !== 'explicit_author')\n217:     .map((lane) => next[lane]));\n218:   if (next.explicit_author < strongestOther) {\n219:     next.explicit_author = Number(strongestOther.toFixed(6));\n220:   }\n221:   return next;\n222: }\n223: \n224: function effectiveScorerWeights(\n225:   override: AdvisorScoringOptions['laneWeightsOverride'] | undefined,\n226:   queryClass: AdvisorQueryClass = 'unknown',\n227: ): Readonly<Record<ScorerLane, number>> {\n228:   const base = !override ? DEFAULT_SCORER_WEIGHTS : (() => {\n229:     const weights: Record<ScorerLane, number> = { ...DEFAULT_SCORER_WEIGHTS };\n230:     const runtimeOverride = override as Partial<Record<string, number>>;\n231:     for (const lane of SCORER_LANES) {\n232:       const value = runtimeOverride[lane];\n233:       if (typeof value === 'number' && Number.isFinite(value)) {\n234:         weights[lane] = value;\n235:       }\n236:     }\n237:     return weights;\n238:   })();\n239:   if (queryClass === 'unknown') return base;\n240:   return applyQueryClassLaneMultipliers(base, queryClass);\n241: }\n242: \n243: function normalizeRuntimeLabel(value: string | undefined): AdvisorRuntimeLabel | null {\n244:   if (value === undefined) {\n245:     return null;\n246:   }\n247:   return ADVISOR_RUNTIME_VALUES.includes(value as AdvisorRuntimeLabel) ? value as AdvisorRuntimeLabel : null;\n248: }\n249: \n250: function normalizeFreshnessLabel(value: string | undefined): AdvisorFreshnessLabel | null {\n251:   if (value === undefined) {\n252:     return 'unavailable';\n253:   }\n254:   return ADVISOR_HOOK_FRESHNESS_VALUES.includes(value as AdvisorFreshnessLabel) ? value as AdvisorFreshnessLabel : null;\n255: }\n256: \n257: interface LaneMatchIndexEntry {\n258:   rawScore: number;\n259:   evidence: string[];\n260:   producerSkillIds: string[];\n261: }\n262: \n263: type LaneMatchIndex = Map<string, LaneMatchIndexEntry>;\n264: \n265: function buildLaneRuntimeHealth(\n266:   laneScores: LaneScores,\n267:   disabled: ReadonlySet<ScorerLane>,\n268:   runtimeLaneHealth: AdvisorScoringOptions['runtimeLaneHealth'] | undefined,\n269: ): readonly LaneRuntimeHealth[] {\n270:   return SCORER_LANES.map((lane): LaneRuntimeHealth => {\n271:     const matchCount = laneScores[lane].length;\n272:     const signal = runtimeLaneHealth?.[lane];\n273:     if (!disabled.has(lane) && signal?.status === 'runtime_degraded' && matchCount === 0) {\n274:       return {\n275:         lane,\n276:         status: 'runtime_degraded',\n277:         matchCount,\n278:         ...(signal.reason ? { reason: signal.reason } : {}),\n279:       };\n280:     }\n281:     return {\n282:       lane,\n283:       status: matchCount > 0 ? 'healthy' : 'matched_nothing',\n284:       matchCount,\n285:       ...(signal?.reason && signal.status === 'healthy' ? { reason: signal.reason } : {}),\n286:     };\n287:   });\n288: }\n289: \n290: function projectionRuntimeLaneHealth(\n291:   projection: AdvisorProjection,\n292:   runtimeLaneHealth: AdvisorScoringOptions['runtimeLaneHealth'] | undefined,\n293: ): AdvisorScoringOptions['runtimeLaneHealth'] | undefined {\n294:   if (!projection.embeddingStaleness?.stale) {\n295:     return runtimeLaneHealth;\n296:   }\n297:   return {\n298:     ...runtimeLaneHealth,\n299:     semantic_shadow: runtimeLaneHealth?.semantic_shadow ?? {\n300:       status: 'runtime_degraded',\n301:       reason: projection.embeddingStaleness.reason ?? 'projection_embedding_stale',\n302:     },\n303:   };\n304: }\n305: \n306: function degradedLaneReason(degradedLanes: readonly ScorerLane[]): string | null {\n307:   if (degradedLanes.length === 0) return null;\n308:   return `Runtime-degraded scorer lanes omitted from confidence normalization: ${degradedLanes.join(', ')}.`;\n309: }\n310: \n311: function buildLaneMatchIndex(matches: readonly LaneMatch[]): LaneMatchIndex {\n312:   const index: LaneMatchIndex = new Map();\n313:   for (const match of matches) {\n314:     const existing = index.get(match.skillId) ?? { rawScore: 0, evidence: [], producerSkillIds: [] };\n315:     existing.rawScore = Math.max(existing.rawScore, match.score);\n316:     if (existing.evidence.length < 6) {\n317:       existing.evidence.push(...match.evidence.slice(0, 6 - existing.evidence.length));\n318:     }\n319:     for (const producerSkillId of match.producerSkillIds ?? []) {\n320:       if (!existing.producerSkillIds.includes(producerSkillId)) {\n321:         existing.producerSkillIds.push(producerSkillId);\n322:       }\n323:     }\n324:     index.set(match.skillId, existing);\n325:   }\n326:   return index;\n327: }\n328: \n329: function buildConflictMatchIndex(matches: readonly LaneMatch[]): LaneMatchIndex {\n330:   const index: LaneMatchIndex = new Map();\n331:   for (const match of matches) {\n332:     const existing = index.get(match.skillId) ?? { rawScore: 0, evidence: [], producerSkillIds: [] };\n333:     existing.rawScore = Math.min(existing.rawScore, match.score);\n334:     if (existing.evidence.length < 6) {\n335:       existing.evidence.push(...match.evidence.slice(0, 6 - existing.evidence.length));\n336:     }\n337:     index.set(match.skillId, existing);\n338:   }\n339:   return index;\n340: }\n341: \n342: function rankedRrfItems(matches: readonly LaneMatch[]): RrfItem[] {\n343:   return [...matches]\n344:     .filter((match) => match.score > 0)\n345:     .sort((left, right) => right.score - left.score || left.skillId.localeCompare(right.skillId))\n346:     .map((match) => ({ id: match.skillId }));\n347: }\n348: \n349: export function fuseAdvisorLaneRanks(\n350:   laneScores: LaneScores,\n351:   weights: Readonly<Record<ScorerLane, number>>,\n352:   disabled: ReadonlySet<ScorerLane> = new Set(),\n353:   runtimeDegraded: ReadonlySet<ScorerLane> = new Set(),\n354: ): AdvisorRrfFusion {\n355:   const lists: RankedList[] = SCORER_LANES.map((lane) => ({\n356:     source: lane,\n357:     results: rankedRrfItems(laneScores[lane]),\n358:     weight: disabled.has(lane) || runtimeDegraded.has(lane) || !isLiveScorerLane(lane)\n359:       ? 0\n360:       : weights[lane],\n361:   }));\n362:   const fused = fuseResultsMulti(lists, {\n363:     k: ADVISOR_RRF_K,\n364:     convergenceBonus: 0,\n365:     calibratedOverlapBeta: 0,\n366:     bonusOverChannels: 'configured',\n367:   });\n368:   const scoreBySkill = new Map<string, number>();\n369:   const rankBySkill = new Map<string, number>();\n370:   fused.forEach((result, index) => {\n371:     const skillId = String(result.id);\n372:     scoreBySkill.set(skillId, result.rrfScore);\n373:     rankBySkill.set(skillId, index);\n374:   });\n375:   return { scoreBySkill, rankBySkill };\n376: }\n377: \n378: function graphConflictAdjustment(\n379:   conflictIndex: LaneMatchIndex,\n380:   recommendation: AdvisorScoredRecommendation,\n381: ): number {\n382:   return conflictIndex.get(recommendation.skill)?.rawScore ?? 0;\n383: }\n384: \n385: function buildExactSemanticRerankIndex(\n386:   prompt: string,\n387:   projection: AdvisorProjection,\n388:   recommendations: readonly AdvisorScoredRecommendation[],\n389:   fusion: AdvisorRrfFusion | null,\n390: ): ExactSemanticRerankIndex {\n391:   if (!fusion) return new Map();\n392:   const topSkillIds = [...recommendations]\n393:     .filter((recommendation) => fusion.rankBySkill.has(recommendation.skill))\n394:     .sort((left, right) => rrfRankFor(fusion, left) - rrfRankFor(fusion, right))\n395:     .slice(0, ADVISOR_EXACT_SEMANTIC_RERANK_TOP_K)\n396:     .map((recommendation) => recommendation.skill);\n397:   const matches = scoreSemanticShadowExactSubset(prompt, projection, topSkillIds);\n398:   return new Map(matches.map((match) => [match.skillId, {\n399:     rawScore: match.score,\n400:   }]));\n401: }\n402: \n403: function exactSemanticRerankScore(\n404:   rerankIndex: ExactSemanticRerankIndex,\n405:   recommendation: AdvisorScoredRecommendation,\n406: ): number | null {\n407:   return rerankIndex.get(recommendation.skill)?.rawScore ?? null;\n408: }\n409: \n410: function rrfRankFor(\n411:   fusion: AdvisorRrfFusion | null,\n412:   recommendation: AdvisorScoredRecommendation,\n413: ): number {\n414:   return fusion?.rankBySkill.get(recommendation.skill) ?? NO_RRF_RANK;\n415: }\n416: \n417: function promptMentionsSkill(promptLower: string, skill: SkillProjection): boolean {\n418:   const phrases = [skill.id, skill.name, skill.id.replace(/-/g, ' ')];\n419:   // A cli skill wraps one named external tool, so the tool's own name (\"orca\"\n420:   // for cli-orca) names the skill as surely as its id does.\n421:   if (skill.family === 'cli' && skill.id.startsWith('cli-')) {\n422:     phrases.push(skill.id.slice('cli-'.length).replace(/-/g, ' '));\n423:   }\n424:   return phrases.some((phrase) => matchesPhraseBoundary(promptLower, phrase.toLowerCase()));\n425: }\n426: \n427: function isDefaultRoutable(promptLower: string, skill: SkillProjection): boolean {\n428:   if (isRouteExcludedSkillId(skill.id)) return false;\n429:   if (skill.lifecycleStatus === 'archived' || skill.lifecycleStatus === 'future') return false;\n430:   if (skill.lifecycleStatus === 'deprecated') return promptMentionsSkill(promptLower, skill);\n431:   return true;\n432: }\n433: \n434: function isAdvisorSelfRecommendationSkill(skillId: string): boolean {\n435:   return ADVISOR_SELF_RECOMMENDATION_SKILL_IDS.has(skillId);\n436: }\n437: \n438: function confidenceFor(args: {\n439:   liveNormalized: number;\n440:   directScore: number;\n441:   readOnlyExplainer: boolean;\n442:   hasExplicitWorkflowSignal: boolean;\n443:   hasTaskIntent: boolean;\n444:   readOnlyRouteAllowed: boolean;\n445:   derivedDominant: boolean;\n446:   skillId: string;\n447: }): { value: number; floored: boolean } {\n448:   const C = SCORING_CALIBRATION.confidence;\n449:   // The advisor alias must never rank itself first on a read-only explainer;\n450:   // floor its confidence. The canonical id is demoted separately by the audit\n451:   // penalty in primaryIntentBonus, so this branch intentionally matches only\n452:   // the alias id.\n453:   if (args.readOnlyExplainer && args.skillId === 'skill-advisor') {\n454:     return { value: C.readOnlyExplainerFloor, floored: false };\n455:   }\n456:   const base = C.baseConstant\n457:     + Math.min(1, args.liveNormalized * C.liveNormalizedRampGain) * C.liveNormalizedRampCoefficient;\n458:   if (args.readOnlyExplainer && !args.readOnlyRouteAllowed) {\n459:     return { value: C.readOnlyExplainerFloor, floored: false };\n460:   }\n461:   if (args.readOnlyRouteAllowed) {\n462:     return {\n463:       value: Number(Math.max(base, C.readOnlyRouteAllowedFloor).toFixed(4)),\n464:       floored: C.readOnlyRouteAllowedFloor > base,\n465:     };\n466:   }\n467:   if (args.derivedDominant && args.directScore < C.derivedDominantDirectScoreCeiling) {\n468:     return { value: C.derivedDominantConfidence, floored: false };\n469:   }\n470:   if (args.hasTaskIntent\n471:     && (args.directScore >= C.taskIntentDirectScoreFloor\n472:       || args.liveNormalized >= C.taskIntentLiveNormalizedFloor)) {\n473:     // Token-stuffing dispersion guard. Without this, a prompt\n474:     // with task-intent + many weak signals (saturating liveNormalized) but\n475:     // no strong direct anchor would force confidence to taskIntentFloor for\n476:     // many unrelated skills. The guard fires when liveNormalized is near-\n477:     // saturated AND directScore is below the directScoreLiftThreshold —\n478:     // the precise signature of a token-stuffed prompt. Legitimate task-intent\n479:     // prompts have at least one strong direct hit and pass via directScore;\n480:     // they don't hit this branch. When the guard fires we fall through to\n481:     // the standard `base + directBonus` math below.\n482:     const dispersionGuardTripped = args.liveNormalized >= 0.95\n483:       && args.directScore < C.directScoreLiftThreshold;\n484:     if (!dispersionGuardTripped) {\n485:       return {\n486:         value: Number(Math.max(base, C.taskIntentFloor).toFixed(4)),\n487:         floored: C.taskIntentFloor > base,\n488:       };\n489:     }\n490:   }\n491:   if (args.directScore >= C.directScoreLiftThreshold) {\n492:     return {\n493:       value: Number(Math.max(base, C.directScoreFloor).toFixed(4)),\n494:       floored: C.directScoreFloor > base,\n495:     };\n496:   }\n497:   const directBonus = args.directScore >= C.directScoreBonusThreshold ? C.directScoreBonus : 0;\n498:   return { value: Number(Math.max(0, Math.min(C.hardCeiling, base + directBonus)).toFixed(4)), floored: false };\n499: }\n500: \n501: function uncertaintyFor(contributions: readonly LaneContribution[], confidence: number, ambiguousPressure: number): number {\n502:   const U = SCORING_CALIBRATION.uncertainty;\n503:   const evidenceCount = contributions.reduce((total, contribution) => total + contribution.evidence.length, 0);\n504:   const direct = contributions\n505:     .filter((contribution) => contribution.lane === 'explicit_author' || contribution.lane === 'lexical')\n506:     .reduce((max, contribution) => Math.max(max, contribution.rawScore), 0);\n507:   let uncertainty = U.noEvidenceDefault;\n508:   if (evidenceCount >= U.highEvidenceCount) uncertainty = U.lowFloor;\n509:   else if (evidenceCount >= U.mediumEvidenceCount) uncertainty = U.mediumFloor;\n510:   else if (evidenceCount >= U.someEvidenceCount) uncertainty = U.elevatedFloor;\n511:   if (direct >= U.directEvidenceDiscountThreshold) uncertainty -= U.directEvidenceDiscount;\n512:   if (confidence < U.lowConfidencePenaltyThreshold) uncertainty += U.lowConfidencePenalty;\n513:   uncertainty += ambiguousPressure;\n514:   return Number(Math.max(U.hardFloor, Math.min(U.hardCeiling, uncertainty)).toFixed(2));\n515: }\n516: \n517: function buildLaneScores(\n518:   prompt: string,\n519:   projection: AdvisorProjection,\n520:   disabled: Set<ScorerLane>,\n521:   affordances: readonly NormalizedAffordance[],\n522:   useRrfFusion: boolean,\n523: ): LaneScoreBundle {\n524:   const scores = emptyLaneScores();\n525:   if (!disabled.has('explicit_author')) {\n526:     scores.explicit_author = scoreExplicitLane(prompt, projection);\n527:   }\n528:   if (!disabled.has('lexical')) scores.lexical = scoreLexicalLane(prompt, projection);\n529:   if (!disabled.has('derived_generated')) scores.derived_generated = scoreDerivedLane(prompt, projection, new Date(), affordances);\n530:   if (!disabled.has('semantic_shadow')) scores.semantic_shadow = scoreSemanticShadowLane(prompt, projection);\n531:   let graphConflictMatches: readonly LaneMatch[] = [];\n532:   let graphSupportBySeed: ReadonlyMap<string, ReadonlyMap<string, number>> = new Map();\n533:   if (!disabled.has('graph_causal')) {\n534:     const graphSplit = scoreGraphCausalLaneSplit([\n535:       ...scores.explicit_author,\n536:       ...scores.lexical,\n537:       ...scores.derived_generated,\n538:     ], projection, {}, affordances);\n539:     scores.graph_causal = useRrfFusion ? graphSplit.positiveMatches : graphSplit.combinedMatches;\n540:     graphConflictMatches = graphSplit.conflictMatches;\n541:     graphSupportBySeed = graphSplit.positiveSupportBySeed;\n542:   }\n543:   return { laneScores: scores, graphConflictMatches, graphSupportBySeed };\n544: }\n545: \n546: // Smallest gap the rounded weighted score can still express, so a bounded\n547: // target sorts strictly below its seed instead of tying with it.\n548: const SEED_BOUND_GAP = 0.000001;\n549: \n550: // Below this explicit-lane score a match is a side mention, not a request.\n551: const EXPLICIT_WORKFLOW_SIGNAL_FLOOR = 0.55;\n552: \n553: // Explicit-lane evidence that a typed slash command named this skill.\n554: const SLASH_COMMAND_EVIDENCE = /^(phrase|author|explicit):\\//;\n555: \n556: export function hasSlashCommandAnchor(rawScore: number, evidence: readonly string[]): boolean {\n557:   return rawScore >= EXPLICIT_WORKFLOW_SIGNAL_FLOOR\n558:     && evidence.some((entry) => SLASH_COMMAND_EVIDENCE.test(entry));\n559: }\n560: \n561: // Graph support is lent: a seed's own evidence propagates to its neighbours so\n562: // related skills surface beside it. When the seed was invoked by a typed slash\n563: // command, the user has named it outright, so support it lends may lift a\n564: // target up to it but never past it; otherwise the command's own match is what\n565: // buries the command (a typed \"/deep:research\" handing its dependency enough\n566: // support to win). Seeds matched only on loose tokens keep ordinary graph\n567: // lending, since there the neighbour may well be the better route. Two skills\n568: // often lend to each other, so the pair is compared on what each holds once\n569: // the other's loan is taken back: a target whose own evidence still beats the\n570: // seed's own evidence keeps its score.\n571: export function boundGraphSupportBySeed(\n572:   scores: ReadonlyMap<string, number>,\n573:   graphRawBySkill: ReadonlyMap<string, number>,\n574:   graphSupportBySeed: ReadonlyMap<string, ReadonlyMap<string, number>>,\n575:   graphWeight: number,\n576:   slashAnchoredSeeds: ReadonlySet<string>,\n577: ): Map<string, number> {\n578:   return boundGraphSupportBySeedWithHolders(\n579:     scores,\n580:     graphRawBySkill,\n581:     graphSupportBySeed,\n582:     graphWeight,\n583:     slashAnchoredSeeds,\n584:   ).scores;\n585: }\n586: \n587: export interface SeedBoundResult {\n588:   readonly scores: Map<string, number>;\n589:   // Target skill -> the typed-command seed whose ceiling actually lowered it.\n590:   readonly heldBelow: Map<string, string>;\n591: }\n592: \n593: export function boundGraphSupportBySeedWithHolders(\n594:   scores: ReadonlyMap<string, number>,\n595:   graphRawBySkill: ReadonlyMap<string, number>,\n596:   graphSupportBySeed: ReadonlyMap<string, ReadonlyMap<string, number>>,\n597:   graphWeight: number,\n598:   slashAnchoredSeeds: ReadonlySet<string>,\n599: ): SeedBoundResult {\n600:   const bounded = new Map(scores);\n601:   const heldBelow = new Map<string, string>();\n602:   if (graphWeight <= 0) return { scores: bounded, heldBelow };\n603:   const lentBy = (lenderId: string, receiverId: string): number => {\n604:     const support = graphSupportBySeed.get(receiverId)?.get(lenderId) ?? 0;\n605:     const graphRaw = Math.max(0, graphRawBySkill.get(receiverId) ?? 0);\n606:     return Math.min(support, graphRaw) * graphWeight;\n607:   };\n608:   // Which seed holds which target down is decided once, on the unbounded\n609:   // scores, so the evidence comparison never sees a cap.\n610:   const holdersByTarget = new Map<string, string[]>();\n611:   for (const [targetId, supportBySeed] of graphSupportBySeed) {\n612:     const targetScore = scores.get(targetId);\n613:     if (targetScore === undefined) continue;\n614:     const holders: string[] = [];\n615:     for (const seedId of supportBySeed.keys()) {\n616:       if (seedId === targetId || !slashAnchoredSeeds.has(seedId)) continue;\n617:       const seedScore = scores.get(seedId);\n618:       if (seedScore === undefined) continue;\n619:       const targetOwn = targetScore - lentBy(seedId, targetId);\n620:       const seedOwn = seedScore - lentBy(targetId, seedId);\n621:       if (targetOwn < seedOwn) holders.push(seedId);\n622:     }\n623:     if (holders.length > 0) holdersByTarget.set(targetId, holders);\n624:   }\n625:   // A held seed can itself be held by another typed command, so each ceiling\n626:   // follows the seed's bounded score and the caps repeat until nothing moves.\n627:   // Caps only ever lower a score, and each pass settles at least one more link\n628:   // of a chain, so one pass per held target is enough.\n629:   for (let pass = 0; pass <= holdersByTarget.size; pass += 1) {\n630:     let moved = false;\n631:     for (const [targetId, holders] of holdersByTarget) {\n632:       const current = bounded.get(targetId) ?? 0;\n633:       let ceiling = current;\n634:       for (const seedId of holders) ceiling = Math.min(ceiling, (bounded.get(seedId) ?? 0) - SEED_BOUND_GAP);\n635:       if (ceiling < current) {\n636:         bounded.set(targetId, Math.max(0, ceiling));\n637:         moved = true;\n638:       }\n639:     }\n640:     if (!moved) break;\n641:   }\n642:   // Only a target the cap really lowered is marked, and only against the seed\n643:   // whose ceiling set its final score: a seed that merely could have held it\n644:   // ranked nothing, so the pair keeps its ordinary ambiguity check.\n645:   for (const [targetId, holders] of holdersByTarget) {\n646:     const final = bounded.get(targetId) ?? 0;\n647:     if (final >= (scores.get(targetId) ?? 0)) continue;\n648:     let binding: string | null = null;\n649:     let lowestSeed = Number.POSITIVE_INFINITY;\n650:     for (const seedId of holders) {\n651:       const seedScore = bounded.get(seedId) ?? 0;\n652:       if (seedScore < lowestSeed) {\n653:         lowestSeed = seedScore;\n654:         binding = seedId;\n655:       }\n656:     }\n657:     if (binding) heldBelow.set(targetId, binding);\n658:   }\n659:   return { scores: bounded, heldBelow };\n660: }\n661: \n662: function hasExplicitWorkflowSignal(contributions: readonly LaneContribution[], skillId: string): boolean {\n663:   const explicit = contributions.find((contribution) => contribution.lane === 'explicit_author');\n664:   if (!explicit || explicit.rawScore < EXPLICIT_WORKFLOW_SIGNAL_FLOOR) return false;\n665:   return explicit.evidence.some((entry) => (\n666:     entry.startsWith('phrase:')\n667:     || entry.startsWith('explicit:')\n668:     || entry.startsWith('author:')\n669:     || entry.includes(skillId)\n670:     || entry.includes('loop')\n671:     || entry.includes('write-')\n672:   ));\n673: }\n674: \n675: // Wording that asks for an answer and rules out a change. One pattern serves\n676: // every gate that has to honour it, so a new gate cannot drift from the first.\n677: const NO_EDIT_REQUEST = /\\b(no edits?|without making changes|do not (change|edit|modify|touch)|read-only only|no edits yet|only; do not|just show|just list)\\b/;\n678: \n679: export function readOnlyRouteAllowed(promptLower: string, skill: SkillProjection): boolean {\n680:   const skillId = skill.id;\n681:   if (NO_EDIT_REQUEST.test(promptLower)) {\n682:     return false;\n683:   }\n684:   // The explainer floor exists to stop an ambiguous read-only question from\n685:   // routing anywhere. Naming the skill removes the ambiguity: the caller has\n686:   // already chosen, and a read-only verb does not undo that choice. Without\n687:   // this, an explicit request is answered with an abstention while the same\n688:   // sentence phrased with a write verb routes fine.\n689:   if (promptMentionsSkill(promptLower, skill)) {\n690:     return true;\n691:   }\n692:   // A command whose route only reads (a report, a status check) is the answer\n693:   // to a list or show question, so its own trigger phrase lifts it off the\n694:   // floor. A mutating command never carries the flag and stays gated.\n695:   if (skill.kind === 'command' && 'readOnly' in skill && skill.readOnly === true\n696:     && skill.keywords.some((phrase) => matchesPhraseBoundary(promptLower, phrase.toLowerCase()))) {\n697:     return true;\n698:   }\n699:   if (skillId === 'sk-code' && /\\b(compare|audit|review)\\b/.test(promptLower)\n700:     && /\\b(classifier|vocabulary|prose|implementation|agents\\.md|drift|mismatch)\\b/.test(promptLower)) {\n701:     return true;\n702:   }\n703:   if (skillId === 'system-spec-kit' && /\\b(memory_save|resume_write|routing taxonomy|corpus|source-type|routing bucket)\\b/.test(promptLower)) {\n704:     return true;\n705:   }\n706:   if (skillId === 'system-spec-kit' && /\\b(packet|spec folder|save memory|phase|continuation prompts|resume handling)\\b/.test(promptLower)) {\n707:     return true;\n708:   }\n709:   // Captured operator answers wait in a queue that spec-kit's save step owns, so a show or list\n710:   // question about that queue, its chat candidates or the decision record is answered there.\n711:   // Only a read-only question is lifted: a lift applies to any prompt, and a request to research,\n712:   // dispatch or build something about decisions belongs to another skill.\n713:   if (skillId === 'system-spec-kit' && isReadOnlyExplainer(promptLower)\n714:     && /\\b(decision capture|decision record|chat candidates?|operator decisions?|recorded as decisions?)\\b/.test(promptLower)) {\n715:     return true;\n716:   }\n717:   // The trigger index is spec-kit's own lookup surface, so a question about what a lookup\n718:   // returned, counted or left out is answered there. Without the lift no skill passes on such a\n719:   // question, and the doctor hand-off claims it on the index noun alone. Drift is the doctor's\n720:   // own diagnosis, so a drift question stays with the hand-off.\n721:   if (skillId === 'system-spec-kit' && isReadOnlyExplainer(promptLower)\n722:     && /\\btrigger[- ]index\\b/.test(promptLower) && !/\\bdrift\\b/.test(promptLower)) {\n723:     return true;\n724:   }\n725:   if (skillId === 'system-deep-loop' && /\\b(ai council|planning council|council deliberation|council artifacts|multi-seat planning)\\b/.test(promptLower)) {\n726:     return true;\n727:   }\n728:   // Browser/devtools inspection is a genuine chrome-devtools task even though\n729:   // its verb (\"inspect\") reads as a read-only explainer. Lift it off the\n730:   // explainer floor when the prompt carries devtools-specific vocabulary.\n731:   if (skillId === 'mcp-tooling'\n732:     && /\\b(network waterfall|network tab|network request|dev ?tools|browser console|page inspector|dom inspector|performance trace|inspect (the )?(network|dom|page|element|browser))\\b/.test(promptLower)) {\n733:     return true;\n734:   }\n735:   if (skillId === 'sk-code' && /\\bgate-3-classifier\\.ts\\b/.test(promptLower)) {\n736:     return true;\n737:   }\n738:   return false;\n739: }\n740: \n741: function isPlainFileSavePrompt(promptLower: string): boolean {\n742:   return FILE_SAVE_OPERATION.test(promptLower) && !MEMORY_SAVE_CONTEXT_ANCHOR.test(promptLower.replace(/\\bfile(s)?\\b/g, ''));\n743: }\n744: \n745: function primaryIntentBonus(\n746:   promptLower: string,\n747:   recommendation: AdvisorScoredRecommendation,\n748: ): number {\n749:   const R = SCORING_CALIBRATION.routing;\n750:   if (/\\bsemantic (code )?search\\b/.test(promptLower)) {\n751:   }\n752:   if (/\\bdeep[- ]review\\b/.test(promptLower)) {\n753:     if (recommendation.skill === 'sk-code') {\n754:       return AUTHORS_CODE.test(promptLower) ? R.deepReviewCodeAuthoringSkCodeBonus : R.deepReviewSkCodeReviewPenalty;\n755:     }\n756:   }\n757:   if (/\\bdeep[- ]research\\b/.test(promptLower)) {\n758:     if (recommendation.skill === 'system-spec-kit' || recommendation.skill === 'sk-code') return R.deepResearchOtherSkillsPenalty;\n759:   }\n760:   if (DEEP_RESEARCH_CYCLE.test(promptLower)) {\n761:     if (recommendation.skill === 'system-spec-kit' || recommendation.skill === 'sk-code') return R.deepResearchCycleOtherSkillsPenalty;\n762:   }\n763:   if (/\\b(compare|audit|review)\\b/.test(promptLower) && /\\b(classifier|vocabulary|prose|implementation|agents\\.md|drift|mismatch)\\b/.test(promptLower)) {\n764:     if (recommendation.skill === 'sk-code') return R.compareAuditCodeReviewBonus;\n765:   }\n766:   // A changelog request that names its packet or spec folder still asks for a\n767:   // changelog, so sk-doc must outrank the spec workflow that \"spec folder\" lifts.\n768:   // Only those two skills are adjusted here. Every other skill falls through so\n769:   // later rules such as save-context or /speckit:plan still apply to it.\n770:   const changelogFromPacket = CHANGELOG_AUTHORING.test(promptLower)\n771:     && CHANGELOG_PACKET_SOURCE.test(promptLower)\n772:     && !AUTHORS_CODE.test(promptLower);\n773:   if (changelogFromPacket) {\n774:     if (recommendation.skill === 'sk-doc') return R.changelogFromPacketSkDocBonus;\n775:     if (recommendation.skill === 'system-spec-kit') return R.changelogFromPacketSpecKitPenalty;\n776:   }\n777:   // The corpus-study rule reads \"packet-local\" as study vocabulary, so it must\n778:   // stay off a changelog request or it would pull the prompt to system-spec-kit.\n779:   // \"packet-local changelog\" names sk-doc's changelog mode with or without an\n780:   // authoring verb, so packet-local is study vocabulary only when it qualifies\n781:   // something other than a changelog.\n782:   if (!changelogFromPacket && /\\b(corpus ids?|first-100 predictions|continuation prompts|routing study config|confusion matrix|source-mix note|prompt template|packet-local(?!\\s+changelog))\\b/.test(promptLower) && !AUTHORS_CODE.test(promptLower)) {\n783:     if (recommendation.skill === 'system-spec-kit') return R.corpusStudySpecKitBonus;\n784:     if (recommendation.skill === 'sk-prompt' || recommendation.skill === 'mcp-tooling' || recommendation.skill === 'sk-doc') return R.corpusStudyOtherSkillsPenalty;\n785:   }\n786:   if (promptLower.includes('/speckit:resume')) {\n787:     if (recommendation.skill === 'system-spec-kit') return R.speckitResumeSpecKitBonus;\n788:     if (recommendation.skill === 'command-speckit-resume') return R.speckitResumeCommandPenalty;\n789:   }\n790:   if (promptLower.includes('/speckit:plan')) {\n791:     if (recommendation.skill === 'command-speckit-plan') return R.speckitPlanCommandBonus;\n792:     if (recommendation.skill === 'sk-doc') return R.speckitPlanSkDocPenalty;\n793:   }\n794:   // External-tool-chain (\"call_tool_chain\") vocabulary belongs to mcp-code-mode,\n795:   // not the generic code skill. Disambiguate so the best guess for these\n796:   // toolchain-shaped prompts is mcp-code-mode.\n797:   // Toolchain + external-data-source vocabulary (webflow CMS, cms collection)\n798:   // is mcp-code-mode territory, not the generic code skill.\n799:   if (/\\b(call_tool_chain|code mode|tool ?chain|api chain|webflow cms|cms collection)\\b/.test(promptLower)) {\n800:     if (recommendation.skill === 'mcp-code-mode') return R.mcpToolchainCodeModeBonus;\n801:     if (recommendation.skill === 'sk-code') return R.mcpToolchainSkCodePenalty;\n802:   }\n803:   // A \"code audit\" is a single-pass code-review task, not a deep-review loop, so\n804:   // sk-code should win the near-tie this phrase produces. The sk-code bonus\n805:   // carries that; the deep-loop skills intentionally hold no \"code audit\"\n806:   // vocabulary, so they need no counter-penalty here.\n807:   if (/\\bcode audit\\b/.test(promptLower)) {\n808:     if (recommendation.skill === 'sk-code') return R.codeAuditCodeReviewBonus;\n809:   }\n810:   // Colon-command review-loop syntax (\":review:auto\") invokes the deep-review\n811:   // loop; rank it above single-pass code review.\n812:   if (/:review:(auto|confirm)\\b/.test(promptLower)) {\n813:     if (recommendation.skill === 'system-deep-loop') return R.reviewLoopDeepReviewBonus;\n814:     if (recommendation.skill === 'sk-code') return R.deepReviewSkCodeReviewPenalty;\n815:   }\n816:   // Auditing recommendation quality is a review task, not an advisor-self task.\n817:   if (/\\baudit\\b/.test(promptLower) && /\\b(recommendation|recommendations|recommendation quality|routing quality)\\b/.test(promptLower)) {\n818:     if (recommendation.skill === 'sk-code') return R.auditRecsCodeReviewBonus;\n819:     // Auditing routing output is a review task, not an advisor invocation: demote\n820:     // the advisor and its alias (the canonical self-rec id set) so neither ranks\n821:     // itself first here.\n822:     if (isAdvisorSelfRecommendationSkill(recommendation.skill)) return R.auditRecsAdvisorPenalty;\n823:   }\n824:   if (/\\b(save context|save memory)\\b/.test(promptLower)) {\n825:     if (recommendation.skill === 'command-speckit-save') return R.saveContextMemorySaveBonus;\n826:     if (recommendation.skill === 'system-spec-kit') return R.saveContextMemorySpecKitPenalty;\n827:   }\n828:   if (/\\b(create (a )?new agent|create agent)\\b/.test(promptLower) || promptLower.includes('/create:agent')) {\n829:     if (recommendation.skill === 'create:agent') return R.createAgentCreateAgentBonus;\n830:     if (recommendation.skill === 'sk-doc') return R.createAgentSkDocPenalty;\n831:   }\n832:   if (/\\bcreate (a )?(test|testing) playbook\\b/.test(promptLower) || promptLower.includes('/create:manual-testing-playbook')) {\n833:     if (recommendation.skill === 'create:manual-testing-playbook' || recommendation.skill === 'command-create-manual-testing-playbook') return R.createTestingPlaybookBonus;\n834:     if (recommendation.skill === 'sk-doc') return R.createTestingPlaybookSkDocPenalty;\n835:     if (recommendation.skill === 'system-deep-loop') return R.createTestingPlaybookOtherSkillsPenalty;\n836:   }\n837:   if (/\\bphase folder\\b/.test(promptLower)) {\n838:     if (recommendation.skill === 'system-spec-kit') return R.phaseFolderSpecKitBonus;\n839:   }\n840:   return 0;\n841: }\n842: \n843: // ───────────────────────────────────────────────────────────────────\n844: // 5. CORE LOGIC\n845: // ───────────────────────────────────────────────────────────────────\n846: \n847: // The bar sits above the highest cosine any prompt that must stay silent reached\n848: // against a command row, with headroom, because a command offered for the wrong\n849: // prompt costs more than one that stays quiet. The margin asks for a small lead\n850: // over the next command and over the top skill, which is what kept a wrong\n851: // command out of first place on the tuning rows. Raise the bar before the\n852: // margin if a false offer appears.\n853: export const COMMAND_MEANING_MIN_COSINE = 0.72;\n854: export const COMMAND_MEANING_MARGIN = 0.02;\n855: \n856: // The lane reports a real embedder cosine as \"cosine:\", while the word-overlap\n857: // stand-in used under test reports \"shadow:\". Only a real cosine may carry a\n858: // command on meaning, because the stand-in measures shared words rather than\n859: // shared meaning.\n860: function commandMeaningCosine(contribution: LaneContribution | undefined): number | null {\n861:   if (!contribution) return null;\n862:   return contribution.evidence.some((entry) => entry.startsWith('cosine:'))\n863:     ? contribution.rawScore\n864:     : null;\n865: }\n866: \n867: // A command bridge passes on its own wording: one of its authored phrases or its\n868: // runnable slash string, which the explicit-author lane reports. A bridge that\n869: // passed on shared single tokens alone stays scored but stops passing, because\n870: // its phrases are everyday words and a command must not be offered for a prompt\n871: // that merely shares some of them. A paraphrase shares no words at all, so the\n872: // second way in is meaning: a real prompt embedding that clears both bars above.\n873: // Meaning-passed ids are collected so a later ordering step can tell them apart,\n874: // and a doctor problem in other words reaches /doctor:helper through\n875: // applyDoctorHelperHandoff instead.\n876: // A question that only wants an answer must not be handed a command that\n877: // changes things, however close the meaning. Phrase matches are already held to\n878: // this by the read-only confidence floor, and a meaning match lifts confidence\n879: // past that floor, so it has to ask the same question itself. A command whose\n880: // route only reads stays eligible for a plain explainer, because running it is\n881: // the answer. An explicit no-edit request rules out every command.\n882: export function commandMeaningEligible(\n883:   promptLower: string,\n884:   readOnlyExplainer: boolean,\n885:   skill: SkillProjection | undefined,\n886: ): boolean {\n887:   if (NO_EDIT_REQUEST.test(promptLower)) return false;\n888:   if (!readOnlyExplainer) return true;\n889:   return skill !== undefined && skill.kind === 'command' && 'readOnly' in skill && skill.readOnly === true;\n890: }\n891: \n892: export function requireCommandPhraseAnchor(\n893:   ranked: readonly AdvisorScoredRecommendation[],\n894:   confidenceThreshold: number = DEFAULT_CONFIDENCE_THRESHOLD,\n895:   meaningPassed: Set<string> = new Set(),\n896:   meaningEligible: (skillId: string) => boolean = () => true,\n897: ): AdvisorScoredRecommendation[] {\n898:   const cosineByCommandId = new Map<string, number>();\n899:   for (const recommendation of ranked) {\n900:     if (recommendation.kind !== 'command') continue;\n901:     const cosine = commandMeaningCosine(\n902:       recommendation.laneContributions.find((contribution) => contribution.lane === 'semantic_shadow'),\n903:     );\n904:     if (cosine !== null) cosineByCommandId.set(recommendation.skill, cosine);\n905:   }\n906:   // A command row with no cosine counts as 0, so the bar is the strongest other\n907:   // command row, not the strongest row overall: a skill row never decides this.\n908:   const leadingOtherCosine = (skillId: string): number => {\n909:     let lead = 0;\n910:     for (const [otherSkillId, cosine] of cosineByCommandId) {\n911:       if (otherSkillId !== skillId && cosine > lead) lead = cosine;\n912:     }\n913:     return lead;\n914:   };\n915:   return ranked.map((recommendation) => {\n916:     if (recommendation.kind !== 'command') return recommendation;\n917:     const anchored = recommendation.laneContributions.some((contribution) => (\n918:       contribution.lane === 'explicit_author' && contribution.rawScore > 0\n919:     ));\n920:     if (anchored) return recommendation;\n921:     const cosine = cosineByCommandId.get(recommendation.skill);\n922:     if (cosine !== undefined\n923:       && cosine >= COMMAND_MEANING_MIN_COSINE\n924:       && cosine - leadingOtherCosine(recommendation.skill) >= COMMAND_MEANING_MARGIN\n925:       && meaningEligible(recommendation.skill)) {\n926:       // A meaning match alone rarely clears the threshold on its lane weight, so\n927:       // the anchor lifts the row to it rather than leaving it scored but unpassed.\n928:       meaningPassed.add(recommendation.skill);\n929:       return {\n930:         ...recommendation,\n931:         confidence: Math.max(recommendation.confidence, confidenceThreshold),\n932:         passes_threshold: true,\n933:       };\n934:     }\n935:     return recommendation.passes_threshold\n936:       ? { ...recommendation, passes_threshold: false }\n937:       : recommendation;\n938:   });\n939: }\n940: \n941: function findTypedDoctorCommandText(promptLower: string): string | null {\n942:   const prompt = promptLower.trim();\n943:   if (prompt.startsWith(DOCTOR_COMMAND_PREFIX)) {\n944:     return prompt.slice(DOCTOR_COMMAND_PREFIX.length);\n945:   }\n946: \n947:   const invocationPattern = /\\b(?:run|execute|start|launch|use|kick\\s+off)\\s+\\/doctor:/g;\n948:   let quote: \"'\" | '\"' | '`' | null = null;\n949:   let quoteScanPosition = 0;\n950:   let invocation: RegExpExecArray | null;\n951: \n952:   while ((invocation = invocationPattern.exec(prompt)) !== null) {\n953:     const commandPosition = (\n954:       invocation.index + invocation[0].length - DOCTOR_COMMAND_PREFIX.length\n955:     );\n956:     while (quoteScanPosition < commandPosition) {\n957:       const character = prompt.charAt(quoteScanPosition);\n958:       const isWordApostrophe = character === \"'\"\n959:         && /[a-z0-9]/.test(prompt.charAt(quoteScanPosition - 1))\n960:         && /[a-z0-9]/.test(prompt.charAt(quoteScanPosition + 1));\n961:       if (!isWordApostrophe) {\n962:         if (quote === null) {\n963:           if (character === \"'\" || character === '\"' || character === '`') {\n964:             quote = character;\n965:           }\n966:         } else if (character === quote) {\n967:           quote = null;\n968:         }\n969:       }\n970:       quoteScanPosition += 1;\n971:     }\n972:     if (quote === null) return prompt.slice(commandPosition + DOCTOR_COMMAND_PREFIX.length);\n973:   }\n974:   return null;\n975: }\n976: \n977: export function isDoctorCommandTyped(promptLower: string): boolean {\n978:   return findTypedDoctorCommandText(promptLower) !== null;\n979: }\n980: \n981: // A typed command or matching doctor lead phrase moves its passing bridge first; otherwise passing\n982: // bridges follow the second passing skill or the only passing skill, and other recommendations keep order.\n983: export function keepPassingSkillsAboveDoctorBridges(\n984:   ranked: readonly AdvisorScoredRecommendation[],\n985:   promptLower: string,\n986:   leadPhrasesById: ReadonlyMap<string, readonly string[]> = new Map(),\n987: ): AdvisorScoredRecommendation[] {\n988:   const isDoctorBridge = (recommendation: AdvisorScoredRecommendation): boolean => (\n989:     recommendation.kind === 'command' && recommendation.skill.startsWith(DOCTOR_BRIDGE_PREFIX)\n990:   );\n991:   const isPassingDoctorBridge = (recommendation: AdvisorScoredRecommendation): boolean => (\n992:     isDoctorBridge(recommendation) && recommendation.passes_threshold\n993:   );\n994:   const typedCommandText = findTypedDoctorCommandText(promptLower);\n995:   if (typedCommandText !== null) {\n996:     const normalizedCommand = typedCommandText.toLowerCase().trim().replace(/\\s+/g, '-');\n997:     let matchedBridgeIndex = -1;\n998:     let matchedBridgeLength = -1;\n999:     ranked.forEach((recommendation, index) => {\n1000:       if (!isPassingDoctorBridge(recommendation)) return;\n1001:       const bridgeName = recommendation.skill.slice(DOCTOR_BRIDGE_PREFIX.length);\n1002:       if (bridgeName.length === 0 || !normalizedCommand.startsWith(bridgeName)) return;\n1003:       const nextCharacter = normalizedCommand.charAt(bridgeName.length);\n1004:       const endsAtWordBoundary = (\n1005:         nextCharacter === '' || !/[a-z0-9_]/.test(nextCharacter)\n1006:       );\n1007:       if (!endsAtWordBoundary || bridgeName.length <= matchedBridgeLength) return;\n1008:       matchedBridgeIndex = index;\n1009:       matchedBridgeLength = bridgeName.length;\n1010:     });\n1011:     const matchedBridge = ranked[matchedBridgeIndex];\n1012:     if (!matchedBridge) return [...ranked];\n1013:     return [\n1014:       matchedBridge,\n1015:       ...ranked.slice(0, matchedBridgeIndex),\n1016:       ...ranked.slice(matchedBridgeIndex + 1),\n1017:     ];\n1018:   }\n1019: \n1020:   const leadPhraseBridgeIndex = ranked.findIndex((recommendation) => {\n1021:     if (!isPassingDoctorBridge(recommendation)) return false;\n1022:     return leadPhrasesById.get(recommendation.skill)?.some((phrase) => (\n1023:       matchesPhraseBoundary(promptLower, phrase.toLowerCase())\n1024:     )) ?? false;\n1025:   });\n1026:   const leadPhraseBridge = ranked[leadPhraseBridgeIndex];\n1027:   if (leadPhraseBridge) {\n1028:     return [\n1029:       leadPhraseBridge,\n1030:       ...ranked.slice(0, leadPhraseBridgeIndex),\n1031:       ...ranked.slice(leadPhraseBridgeIndex + 1),\n1032:     ];\n1033:   }\n1034: \n1035:   const passingSkillCount = ranked.filter((recommendation) => (\n1036:     recommendation.kind === 'skill' && recommendation.passes_threshold\n1037:   )).length;\n1038:   if (passingSkillCount === 0) return [...ranked];\n1039: \n1040:   const passingDoctorBridges = ranked.filter(isPassingDoctorBridge);\n1041:   if (passingDoctorBridges.length === 0) return [...ranked];\n1042:   const remaining = ranked.filter((recommendation) => !isPassingDoctorBridge(recommendation));\n1043:   const targetPassingSkillCount = Math.min(2, passingSkillCount);\n1044:   let seenPassingSkills = 0;\n1045:   let insertionIndex = remaining.length;\n1046:   for (const [index, recommendation] of remaining.entries()) {\n1047:     if (recommendation.kind !== 'skill' || !recommendation.passes_threshold) continue;\n1048:     seenPassingSkills += 1;\n1049:     if (seenPassingSkills === targetPassingSkillCount) {\n1050:       insertionIndex = index + 1;\n1051:       break;\n1052:     }\n1053:   }\n1054:   return [\n1055:     ...remaining.slice(0, insertionIndex),\n1056:     ...passingDoctorBridges,\n[Output truncated. Continue reading with offset: 1057]","title":"read","metadata":{"metadata":{"truncated":true},"content":[{"type":"text","text":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/lib/scorer/fusion.ts, lines 1-1056\n1: // ───────────────────────────────────────────────────────────────\n2: // MODULE: Advisor 5-Lane Fusion\n3: // ───────────────────────────────────────────────────────────────\n4: \n5: // ───────────────────────────────────────────────────────────────────\n6: // 1. IMPORTS\n7: // ───────────────────────────────────────────────────────────────────\n8: \n9: import { fuseResultsMulti } from '@spec-kit/shared/algorithms/rrf-fusion.js';\n10: \n11: import { applyAmbiguity, isAmbiguousTopTwo, wideAmbiguityMembers } from './ambiguity.js';\n12: import { attributionReason, dominantLane, isDerivedDominant } from './attribution.js';\n13: import {\n14:   ADVISOR_HOOK_FRESHNESS_VALUES,\n15:   ADVISOR_RUNTIME_VALUES,\n16:   isSpeckitMetricsEnabled,\n17:   speckitMetrics,\n18: } from '../metrics.js';\n19: import { normalize } from '../affordance-normalizer.js';\n20: import { COMMAND_ROWS, TRACKED_COMMANDS, typedCommandIn } from '../command-attach.js';\n21: import { scoreDerivedLane } from './lanes/derived.js';\n22: import { scoreExplicitLane } from './lanes/explicit.js';\n23: import { scoreGraphCausalLaneSplit } from './lanes/graph-causal.js';\n24: import { scoreLexicalLane } from './lanes/lexical.js';\n25: import { scoreSemanticShadowExactSubset, scoreSemanticShadowLane } from './lanes/semantic-shadow.js';\n26: import { applyExecutorDelegationOverride } from './executor-delegation.js';\n27: import {\n28:   DOCTOR_HELPER_BRIDGE_ID,\n29:   DOCTOR_HELPER_UNCUED_MIN_SCORE,\n30:   doctorProblemCue,\n31:   genericRepairCue,\n32:   matchDoctorProblem,\n33: } from './doctor-helper-handoff.js';\n34: import { loadAdvisorProjection } from './projection.js';\n35: import { SCORING_CALIBRATION } from './scoring-constants.js';\n36: import { isReadOnlyExplainer, matchesPhraseBoundary } from './text.js';\n37: import {\n38:   DEFAULT_SCORER_WEIGHTS,\n39:   SCORER_LANES,\n40:   liveWeightTotal,\n41: } from './weights-config.js';\n42: import { isLiveScorerLane } from './lane-registry.js';\n43: import { isRouteExcludedSkillId } from '../route-exclusions.js';\n44: import { SKILL_ADVISOR_COMPAT_CONTRACT, resolvedConfidenceThreshold, resolvedUncertaintyThreshold } from '../compat/contract.js';\n45: import type {\n46:   AdvisorProjection,\n47:   AdvisorScoredRecommendation,\n48:   AdvisorScoringOptions,\n49:   AdvisorScoringResult,\n50:   LaneContribution,\n51:   LaneMatch,\n52:   LaneRuntimeHealth,\n53:   LaneScores,\n54:   ScorerLane,\n55:   SkillProjection,\n56: } from './types.js';\n57: import type { NormalizedAffordance } from '../affordance-normalizer.js';\n58: import type { RankedList, RrfItem } from '@spec-kit/shared/algorithms/rrf-fusion.js';\n59: \n60: // ───────────────────────────────────────────────────────────────────\n61: // 2. CONSTANTS\n62: // ───────────────────────────────────────────────────────────────────\n63: \n64: const DEFAULT_CONFIDENCE_THRESHOLD = resolvedConfidenceThreshold();\n65: const DEFAULT_UNCERTAINTY_THRESHOLD = resolvedUncertaintyThreshold();\n66: export const ADVISOR_RRF_FUSION_FLAG = 'SPECKIT_ADVISOR_RRF_FUSION';\n67: export const ADVISOR_QUERY_CLASS_ROUTING_FLAG = 'SPECKIT_ADVISOR_QUERY_CLASS_ROUTING';\n68: export const ADVISOR_EXACT_SEMANTIC_RERANK_FLAG = 'SPECKIT_ADVISOR_EXACT_SEMANTIC_RERANK';\n69: export const ADVISOR_RRF_K = 8;\n70: export const ADVISOR_EXACT_SEMANTIC_RERANK_TOP_K = 10;\n71: const ADVISOR_EXACT_SEMANTIC_RERANK_WINDOW = 0.05;\n72: const TASK_INTENT = /\\b(add|append|build|change|configure|create|edit|fix|generate|implement|modify|move|patch|refactor|rename|replace|run|start|sweep|update|write)\\b/;\n73: const DEEP_RESEARCH_CYCLE = /\\b(automated research cycle|looped investigation|continue iteration|resume iteration|overnight run|overnight research run|packet-local iteration|delta record|canonical jsonl|same lineage)\\b/;\n74: // Writing a test or a helper is code work even when the prompt also names a deep-review phrase or a\n75: // study artifact: the thing asked for comes before the phrase it is written about, so a \"deep review\"\n76: // between the verb and the noun means the loop itself is the subject.\n77: const AUTHORS_CODE = /\\b(?:add|build|create|implement|write)\\b(?:(?!deep[- ]review)[^.?!]){0,60}?\\b(?:helper|vitest|tests?)\\b/;\n78: // Writing a changelog is sk-doc's changelog mode even when the prompt names a\n79: // packet or spec folder. That folder is only where the change history comes from.\n80: // The verb must govern the changelog itself: only articles and folder or scope\n81: // modifiers may sit between them, so \"add a nested phase ... for the changelog\n82: // work\" or \"write the spec folder docs, including the changelog ...\" stay\n83: // spec-folder work.\n84: const CHANGELOG_AUTHORING = /\\b(?:add|create|draft|write)\\s+(?:(?:a|an|the|new|nested|packet|packet-local|phase|global|release)\\s+){0,4}changelog(?:\\s+entry)?\\b/;\n85: const CHANGELOG_PACKET_SOURCE = /\\b(?:packet|nested|spec folder)\\b/;\n86: const FILE_SAVE_OPERATION = /\\bsave\\b.{0,48}\\b(file|files|document|documents|buffer|tab|workspace)\\b|\\b(file|files|document|documents|buffer|tab|workspace)\\b.{0,48}\\bsave\\b/;\n87: const MEMORY_SAVE_CONTEXT_ANCHOR = /\\b(memory|context|conversation|session|handover|checkpoint|resume|preserve|remember|capture|store)\\b|\\/memory:save|memory:save/;\n88: // Class C breadth/multi-concern abstention gates. A broad greenfield build or a\n89: // multi-concern optimization is under-specified for single-skill routing.\n90: const BREADTH_BUILD_VERB = /\\b(build|create|implement|generate|scaffold)\\b/;\n91: const BREADTH_NOUN = /\\b(full[- ]?stack|service|platform|application|microservice|saas|backend|whole (app|system))\\b/;\n92: // Narrow anchors that make a broad-build prompt specific enough to route.\n93: const BREADTH_NARROW_ANCHOR = /\\.[a-z]{2,4}\\b|\\b(test|tests|error|bug|failure|failing|handler|component|function|route|endpoint|class|method|benchmark|review|audit|migration|schema)\\b/;\n94: const MULTI_CONCERN_VERB = /\\b(optimize|improve|enhance|harden|speed up)\\b/;\n95: const CONCERN_PERF = /\\b(speed|latency|execution|throughput|performance|startup|memory|cpu)\\b/;\n96: const CONCERN_QUALITY = /\\b(quality|accuracy|recommendation|recommendations|correctness|reliability|coverage)\\b/;\n97: const TRUE_FLAG_VALUES = new Set(['1', 'true', 'yes', 'on', 'enabled']);\n98: const NO_RRF_RANK = Number.MAX_SAFE_INTEGER;\n99: const ADVISOR_SELF_RECOMMENDATION_SKILL_IDS = new Set(['system-skill-advisor', 'skill-advisor']);\n100: const DOCTOR_BRIDGE_PREFIX = 'command-doctor-';\n101: const DOCTOR_COMMAND_PREFIX = '/doctor:';\n102: \n103: // ───────────────────────────────────────────────────────────────────\n104: // 3. TYPE DEFINITIONS\n105: // ───────────────────────────────────────────────────────────────────\n106: \n107: type MutableLaneScores = {\n108:   -readonly [K in keyof LaneScores]: LaneMatch[];\n109: };\n110: \n111: interface LaneScoreBundle {\n112:   readonly laneScores: LaneScores;\n113:   readonly graphConflictMatches: readonly LaneMatch[];\n114:   readonly graphSupportBySeed: ReadonlyMap<string, ReadonlyMap<string, number>>;\n115: }\n116: \n117: interface AdvisorRrfFusion {\n118:   readonly scoreBySkill: ReadonlyMap<string, number>;\n119:   readonly rankBySkill: ReadonlyMap<string, number>;\n120: }\n121: \n122: type AdvisorRuntimeLabel = (typeof ADVISOR_RUNTIME_VALUES)[number];\n123: type AdvisorFreshnessLabel = (typeof ADVISOR_HOOK_FRESHNESS_VALUES)[number];\n124: export type AdvisorQueryClass = 'implementation' | 'review' | 'documentation' | 'memory' | 'tooling' | 'unknown';\n125: \n126: interface ExactSemanticRerankEntry {\n127:   readonly rawScore: number;\n128: }\n129: \n130: type ExactSemanticRerankIndex = ReadonlyMap<string, ExactSemanticRerankEntry>;\n131: \n132: // ───────────────────────────────────────────────────────────────────\n133: // 4. HELPERS\n134: // ───────────────────────────────────────────────────────────────────\n135: \n136: function emptyLaneScores(): MutableLaneScores {\n137:   return Object.fromEntries(SCORER_LANES.map((lane) => [lane, []])) as unknown as MutableLaneScores;\n138: }\n139: \n140: function projectionWithUsableSkillIds(projection: AdvisorProjection): AdvisorProjection {\n141:   const skills = projection.skills.filter((skill) => {\n142:     const skillId: unknown = skill.id;\n143:     return typeof skillId === 'string' && skillId.trim().length > 0;\n144:   });\n145:   return skills.length === projection.skills.length\n146:     ? projection\n147:     : { ...projection, skills };\n148: }\n149: \n150: export function isAdvisorRrfFusionEnabled(): boolean {\n151:   const value = process.env[ADVISOR_RRF_FUSION_FLAG]?.trim().toLowerCase();\n152:   return value ? TRUE_FLAG_VALUES.has(value) : false;\n153: }\n154: \n155: export function isAdvisorQueryClassRoutingEnabled(): boolean {\n156:   const value = process.env[ADVISOR_QUERY_CLASS_ROUTING_FLAG]?.trim().toLowerCase();\n157:   return value ? TRUE_FLAG_VALUES.has(value) : false;\n158: }\n159: \n160: export function isAdvisorExactSemanticRerankEnabled(): boolean {\n161:   const value = process.env[ADVISOR_EXACT_SEMANTIC_RERANK_FLAG]?.trim().toLowerCase();\n162:   return value ? TRUE_FLAG_VALUES.has(value) : false;\n163: }\n164: \n165: export function classifyAdvisorQuery(prompt: string): AdvisorQueryClass {\n166:   const promptLower = prompt.toLowerCase();\n167:   if (/\\b(save context|save memory|handover|resume|checkpoint|spec folder|implementation summary|packet docs?)\\b/.test(promptLower)) {\n168:     return 'memory';\n169:   }\n170:   if (/\\b(review|audit|findings|regression|pull request|pr readiness|release readiness)\\b/.test(promptLower)) {\n171:     return 'review';\n172:   }\n173:   if (/\\b(readme|markdown|documentation|docs|manual testing playbook|feature catalog|taxonomy)\\b/.test(promptLower)) {\n174:     return 'documentation';\n175:   }\n176:   if (/\\b(call_tool_chain|code mode|tool ?chain|chrome devtools|browser console|figma|github|clickup)\\b/.test(promptLower)) {\n177:     return 'tooling';\n178:   }\n179:   if (TASK_INTENT.test(promptLower) || /\\b(typescript|javascript|python|vitest|mcp|handler|schema|fixture)\\b/.test(promptLower)) {\n180:     return 'implementation';\n181:   }\n182:   return 'unknown';\n183: }\n184: \n185: export function queryClassLaneMultipliers(queryClass: AdvisorQueryClass): Readonly<Partial<Record<ScorerLane, number>>> {\n186:   switch (queryClass) {\n187:     case 'implementation':\n188:       return { explicit_author: 1.04, lexical: 1.00, graph_causal: 0.98, derived_generated: 0.98, semantic_shadow: 1.00 };\n189:     case 'review':\n190:       return { explicit_author: 1.03, lexical: 1.02, graph_causal: 0.96, derived_generated: 0.98, semantic_shadow: 1.00 };\n191:     case 'documentation':\n192:       return { explicit_author: 1.03, lexical: 0.98, graph_causal: 0.95, derived_generated: 1.04, semantic_shadow: 1.00 };\n193:     case 'memory':\n194:       return { explicit_author: 1.04, lexical: 0.98, graph_causal: 1.02, derived_generated: 1.00, semantic_shadow: 0.96 };\n195:     case 'tooling':\n196:       return { explicit_author: 1.04, lexical: 1.00, graph_causal: 0.98, derived_generated: 0.96, semantic_shadow: 1.00 };\n197:     case 'unknown':\n198:       return {};\n199:   }\n200: }\n201: \n202: export function applyQueryClassLaneMultipliers(\n203:   weights: Readonly<Record<ScorerLane, number>>,\n204:   queryClass: AdvisorQueryClass,\n205: ): Readonly<Record<ScorerLane, number>> {\n206:   const multipliers = queryClassLaneMultipliers(queryClass);\n207:   if (Object.keys(multipliers).length === 0) return weights;\n208:   const next = { ...weights };\n209:   for (const lane of SCORER_LANES) {\n210:     const multiplier = multipliers[lane];\n211:     if (typeof multiplier === 'number' && Number.isFinite(multiplier)) {\n212:       next[lane] = Number((next[lane] * multiplier).toFixed(6));\n213:     }\n214:   }\n215:   const strongestOther = Math.max(...SCORER_LANES\n216:     .filter((lane) => lane !== 'explicit_author')\n217:     .map((lane) => next[lane]));\n218:   if (next.explicit_author < strongestOther) {\n219:     next.explicit_author = Number(strongestOther.toFixed(6));\n220:   }\n221:   return next;\n222: }\n223: \n224: function effectiveScorerWeights(\n225:   override: AdvisorScoringOptions['laneWeightsOverride'] | undefined,\n226:   queryClass: AdvisorQueryClass = 'unknown',\n227: ): Readonly<Record<ScorerLane, number>> {\n228:   const base = !override ? DEFAULT_SCORER_WEIGHTS : (() => {\n229:     const weights: Record<ScorerLane, number> = { ...DEFAULT_SCORER_WEIGHTS };\n230:     const runtimeOverride = override as Partial<Record<string, number>>;\n231:     for (const lane of SCORER_LANES) {\n232:       const value = runtimeOverride[lane];\n233:       if (typeof value === 'number' && Number.isFinite(value)) {\n234:         weights[lane] = value;\n235:       }\n236:     }\n237:     return weights;\n238:   })();\n239:   if (queryClass === 'unknown') return base;\n240:   return applyQueryClassLaneMultipliers(base, queryClass);\n241: }\n242: \n243: function normalizeRuntimeLabel(value: string | undefined): AdvisorRuntimeLabel | null {\n244:   if (value === undefined) {\n245:     return null;\n246:   }\n247:   return ADVISOR_RUNTIME_VALUES.includes(value as AdvisorRuntimeLabel) ? value as AdvisorRuntimeLabel : null;\n248: }\n249: \n250: function normalizeFreshnessLabel(value: string | undefined): AdvisorFreshnessLabel | null {\n251:   if (value === undefined) {\n252:     return 'unavailable';\n253:   }\n254:   return ADVISOR_HOOK_FRESHNESS_VALUES.includes(value as AdvisorFreshnessLabel) ? value as AdvisorFreshnessLabel : null;\n255: }\n256: \n257: interface LaneMatchIndexEntry {\n258:   rawScore: number;\n259:   evidence: string[];\n260:   producerSkillIds: string[];\n261: }\n262: \n263: type LaneMatchIndex = Map<string, LaneMatchIndexEntry>;\n264: \n265: function buildLaneRuntimeHealth(\n266:   laneScores: LaneScores,\n267:   disabled: ReadonlySet<ScorerLane>,\n268:   runtimeLaneHealth: AdvisorScoringOptions['runtimeLaneHealth'] | undefined,\n269: ): readonly LaneRuntimeHealth[] {\n270:   return SCORER_LANES.map((lane): LaneRuntimeHealth => {\n271:     const matchCount = laneScores[lane].length;\n272:     const signal = runtimeLaneHealth?.[lane];\n273:     if (!disabled.has(lane) && signal?.status === 'runtime_degraded' && matchCount === 0) {\n274:       return {\n275:         lane,\n276:         status: 'runtime_degraded',\n277:         matchCount,\n278:         ...(signal.reason ? { reason: signal.reason } : {}),\n279:       };\n280:     }\n281:     return {\n282:       lane,\n283:       status: matchCount > 0 ? 'healthy' : 'matched_nothing',\n284:       matchCount,\n285:       ...(signal?.reason && signal.status === 'healthy' ? { reason: signal.reason } : {}),\n286:     };\n287:   });\n288: }\n289: \n290: function projectionRuntimeLaneHealth(\n291:   projection: AdvisorProjection,\n292:   runtimeLaneHealth: AdvisorScoringOptions['runtimeLaneHealth'] | undefined,\n293: ): AdvisorScoringOptions['runtimeLaneHealth'] | undefined {\n294:   if (!projection.embeddingStaleness?.stale) {\n295:     return runtimeLaneHealth;\n296:   }\n297:   return {\n298:     ...runtimeLaneHealth,\n299:     semantic_shadow: runtimeLaneHealth?.semantic_shadow ?? {\n300:       status: 'runtime_degraded',\n301:       reason: projection.embeddingStaleness.reason ?? 'projection_embedding_stale',\n302:     },\n303:   };\n304: }\n305: \n306: function degradedLaneReason(degradedLanes: readonly ScorerLane[]): string | null {\n307:   if (degradedLanes.length === 0) return null;\n308:   return `Runtime-degraded scorer lanes omitted from confidence normalization: ${degradedLanes.join(', ')}.`;\n309: }\n310: \n311: function buildLaneMatchIndex(matches: readonly LaneMatch[]): LaneMatchIndex {\n312:   const index: LaneMatchIndex = new Map();\n313:   for (const match of matches) {\n314:     const existing = index.get(match.skillId) ?? { rawScore: 0, evidence: [], producerSkillIds: [] };\n315:     existing.rawScore = Math.max(existing.rawScore, match.score);\n316:     if (existing.evidence.length < 6) {\n317:       existing.evidence.push(...match.evidence.slice(0, 6 - existing.evidence.length));\n318:     }\n319:     for (const producerSkillId of match.producerSkillIds ?? []) {\n320:       if (!existing.producerSkillIds.includes(producerSkillId)) {\n321:         existing.producerSkillIds.push(producerSkillId);\n322:       }\n323:     }\n324:     index.set(match.skillId, existing);\n325:   }\n326:   return index;\n327: }\n328: \n329: function buildConflictMatchIndex(matches: readonly LaneMatch[]): LaneMatchIndex {\n330:   const index: LaneMatchIndex = new Map();\n331:   for (const match of matches) {\n332:     const existing = index.get(match.skillId) ?? { rawScore: 0, evidence: [], producerSkillIds: [] };\n333:     existing.rawScore = Math.min(existing.rawScore, match.score);\n334:     if (existing.evidence.length < 6) {\n335:       existing.evidence.push(...match.evidence.slice(0, 6 - existing.evidence.length));\n336:     }\n337:     index.set(match.skillId, existing);\n338:   }\n339:   return index;\n340: }\n341: \n342: function rankedRrfItems(matches: readonly LaneMatch[]): RrfItem[] {\n343:   return [...matches]\n344:     .filter((match) => match.score > 0)\n345:     .sort((left, right) => right.score - left.score || left.skillId.localeCompare(right.skillId))\n346:     .map((match) => ({ id: match.skillId }));\n347: }\n348: \n349: export function fuseAdvisorLaneRanks(\n350:   laneScores: LaneScores,\n351:   weights: Readonly<Record<ScorerLane, number>>,\n352:   disabled: ReadonlySet<ScorerLane> = new Set(),\n353:   runtimeDegraded: ReadonlySet<ScorerLane> = new Set(),\n354: ): AdvisorRrfFusion {\n355:   const lists: RankedList[] = SCORER_LANES.map((lane) => ({\n356:     source: lane,\n357:     results: rankedRrfItems(laneScores[lane]),\n358:     weight: disabled.has(lane) || runtimeDegraded.has(lane) || !isLiveScorerLane(lane)\n359:       ? 0\n360:       : weights[lane],\n361:   }));\n362:   const fused = fuseResultsMulti(lists, {\n363:     k: ADVISOR_RRF_K,\n364:     convergenceBonus: 0,\n365:     calibratedOverlapBeta: 0,\n366:     bonusOverChannels: 'configured',\n367:   });\n368:   const scoreBySkill = new Map<string, number>();\n369:   const rankBySkill = new Map<string, number>();\n370:   fused.forEach((result, index) => {\n371:     const skillId = String(result.id);\n372:     scoreBySkill.set(skillId, result.rrfScore);\n373:     rankBySkill.set(skillId, index);\n374:   });\n375:   return { scoreBySkill, rankBySkill };\n376: }\n377: \n378: function graphConflictAdjustment(\n379:   conflictIndex: LaneMatchIndex,\n380:   recommendation: AdvisorScoredRecommendation,\n381: ): number {\n382:   return conflictIndex.get(recommendation.skill)?.rawScore ?? 0;\n383: }\n384: \n385: function buildExactSemanticRerankIndex(\n386:   prompt: string,\n387:   projection: AdvisorProjection,\n388:   recommendations: readonly AdvisorScoredRecommendation[],\n389:   fusion: AdvisorRrfFusion | null,\n390: ): ExactSemanticRerankIndex {\n391:   if (!fusion) return new Map();\n392:   const topSkillIds = [...recommendations]\n393:     .filter((recommendation) => fusion.rankBySkill.has(recommendation.skill))\n394:     .sort((left, right) => rrfRankFor(fusion, left) - rrfRankFor(fusion, right))\n395:     .slice(0, ADVISOR_EXACT_SEMANTIC_RERANK_TOP_K)\n396:     .map((recommendation) => recommendation.skill);\n397:   const matches = scoreSemanticShadowExactSubset(prompt, projection, topSkillIds);\n398:   return new Map(matches.map((match) => [match.skillId, {\n399:     rawScore: match.score,\n400:   }]));\n401: }\n402: \n403: function exactSemanticRerankScore(\n404:   rerankIndex: ExactSemanticRerankIndex,\n405:   recommendation: AdvisorScoredRecommendation,\n406: ): number | null {\n407:   return rerankIndex.get(recommendation.skill)?.rawScore ?? null;\n408: }\n409: \n410: function rrfRankFor(\n411:   fusion: AdvisorRrfFusion | null,\n412:   recommendation: AdvisorScoredRecommendation,\n413: ): number {\n414:   return fusion?.rankBySkill.get(recommendation.skill) ?? NO_RRF_RANK;\n415: }\n416: \n417: function promptMentionsSkill(promptLower: string, skill: SkillProjection): boolean {\n418:   const phrases = [skill.id, skill.name, skill.id.replace(/-/g, ' ')];\n419:   // A cli skill wraps one named external tool, so the tool's own name (\"orca\"\n420:   // for cli-orca) names the skill as surely as its id does.\n421:   if (skill.family === 'cli' && skill.id.startsWith('cli-')) {\n422:     phrases.push(skill.id.slice('cli-'.length).replace(/-/g, ' '));\n423:   }\n424:   return phrases.some((phrase) => matchesPhraseBoundary(promptLower, phrase.toLowerCase()));\n425: }\n426: \n427: function isDefaultRoutable(promptLower: string, skill: SkillProjection): boolean {\n428:   if (isRouteExcludedSkillId(skill.id)) return false;\n429:   if (skill.lifecycleStatus === 'archived' || skill.lifecycleStatus === 'future') return false;\n430:   if (skill.lifecycleStatus === 'deprecated') return promptMentionsSkill(promptLower, skill);\n431:   return true;\n432: }\n433: \n434: function isAdvisorSelfRecommendationSkill(skillId: string): boolean {\n435:   return ADVISOR_SELF_RECOMMENDATION_SKILL_IDS.has(skillId);\n436: }\n437: \n438: function confidenceFor(args: {\n439:   liveNormalized: number;\n440:   directScore: number;\n441:   readOnlyExplainer: boolean;\n442:   hasExplicitWorkflowSignal: boolean;\n443:   hasTaskIntent: boolean;\n444:   readOnlyRouteAllowed: boolean;\n445:   derivedDominant: boolean;\n446:   skillId: string;\n447: }): { value: number; floored: boolean } {\n448:   const C = SCORING_CALIBRATION.confidence;\n449:   // The advisor alias must never rank itself first on a read-only explainer;\n450:   // floor its confidence. The canonical id is demoted separately by the audit\n451:   // penalty in primaryIntentBonus, so this branch intentionally matches only\n452:   // the alias id.\n453:   if (args.readOnlyExplainer && args.skillId === 'skill-advisor') {\n454:     return { value: C.readOnlyExplainerFloor, floored: false };\n455:   }\n456:   const base = C.baseConstant\n457:     + Math.min(1, args.liveNormalized * C.liveNormalizedRampGain) * C.liveNormalizedRampCoefficient;\n458:   if (args.readOnlyExplainer && !args.readOnlyRouteAllowed) {\n459:     return { value: C.readOnlyExplainerFloor, floored: false };\n460:   }\n461:   if (args.readOnlyRouteAllowed) {\n462:     return {\n463:       value: Number(Math.max(base, C.readOnlyRouteAllowedFloor).toFixed(4)),\n464:       floored: C.readOnlyRouteAllowedFloor > base,\n465:     };\n466:   }\n467:   if (args.derivedDominant && args.directScore < C.derivedDominantDirectScoreCeiling) {\n468:     return { value: C.derivedDominantConfidence, floored: false };\n469:   }\n470:   if (args.hasTaskIntent\n471:     && (args.directScore >= C.taskIntentDirectScoreFloor\n472:       || args.liveNormalized >= C.taskIntentLiveNormalizedFloor)) {\n473:     // Token-stuffing dispersion guard. Without this, a prompt\n474:     // with task-intent + many weak signals (saturating liveNormalized) but\n475:     // no strong direct anchor would force confidence to taskIntentFloor for\n476:     // many unrelated skills. The guard fires when liveNormalized is near-\n477:     // saturated AND directScore is below the directScoreLiftThreshold —\n478:     // the precise signature of a token-stuffed prompt. Legitimate task-intent\n479:     // prompts have at least one strong direct hit and pass via directScore;\n480:     // they don't hit this branch. When the guard fires we fall through to\n481:     // the standard `base + directBonus` math below.\n482:     const dispersionGuardTripped = args.liveNormalized >= 0.95\n483:       && args.directScore < C.directScoreLiftThreshold;\n484:     if (!dispersionGuardTripped) {\n485:       return {\n486:         value: Number(Math.max(base, C.taskIntentFloor).toFixed(4)),\n487:         floored: C.taskIntentFloor > base,\n488:       };\n489:     }\n490:   }\n491:   if (args.directScore >= C.directScoreLiftThreshold) {\n492:     return {\n493:       value: Number(Math.max(base, C.directScoreFloor).toFixed(4)),\n494:       floored: C.directScoreFloor > base,\n495:     };\n496:   }\n497:   const directBonus = args.directScore >= C.directScoreBonusThreshold ? C.directScoreBonus : 0;\n498:   return { value: Number(Math.max(0, Math.min(C.hardCeiling, base + directBonus)).toFixed(4)), floored: false };\n499: }\n500: \n501: function uncertaintyFor(contributions: readonly LaneContribution[], confidence: number, ambiguousPressure: number): number {\n502:   const U = SCORING_CALIBRATION.uncertainty;\n503:   const evidenceCount = contributions.reduce((total, contribution) => total + contribution.evidence.length, 0);\n504:   const direct = contributions\n505:     .filter((contribution) => contribution.lane === 'explicit_author' || contribution.lane === 'lexical')\n506:     .reduce((max, contribution) => Math.max(max, contribution.rawScore), 0);\n507:   let uncertainty = U.noEvidenceDefault;\n508:   if (evidenceCount >= U.highEvidenceCount) uncertainty = U.lowFloor;\n509:   else if (evidenceCount >= U.mediumEvidenceCount) uncertainty = U.mediumFloor;\n510:   else if (evidenceCount >= U.someEvidenceCount) uncertainty = U.elevatedFloor;\n511:   if (direct >= U.directEvidenceDiscountThreshold) uncertainty -= U.directEvidenceDiscount;\n512:   if (confidence < U.lowConfidencePenaltyThreshold) uncertainty += U.lowConfidencePenalty;\n513:   uncertainty += ambiguousPressure;\n514:   return Number(Math.max(U.hardFloor, Math.min(U.hardCeiling, uncertainty)).toFixed(2));\n515: }\n516: \n517: function buildLaneScores(\n518:   prompt: string,\n519:   projection: AdvisorProjection,\n520:   disabled: Set<ScorerLane>,\n521:   affordances: readonly NormalizedAffordance[],\n522:   useRrfFusion: boolean,\n523: ): LaneScoreBundle {\n524:   const scores = emptyLaneScores();\n525:   if (!disabled.has('explicit_author')) {\n526:     scores.explicit_author = scoreExplicitLane(prompt, projection);\n527:   }\n528:   if (!disabled.has('lexical')) scores.lexical = scoreLexicalLane(prompt, projection);\n529:   if (!disabled.has('derived_generated')) scores.derived_generated = scoreDerivedLane(prompt, projection, new Date(), affordances);\n530:   if (!disabled.has('semantic_shadow')) scores.semantic_shadow = scoreSemanticShadowLane(prompt, projection);\n531:   let graphConflictMatches: readonly LaneMatch[] = [];\n532:   let graphSupportBySeed: ReadonlyMap<string, ReadonlyMap<string, number>> = new Map();\n533:   if (!disabled.has('graph_causal')) {\n534:     const graphSplit = scoreGraphCausalLaneSplit([\n535:       ...scores.explicit_author,\n536:       ...scores.lexical,\n537:       ...scores.derived_generated,\n538:     ], projection, {}, affordances);\n539:     scores.graph_causal = useRrfFusion ? graphSplit.positiveMatches : graphSplit.combinedMatches;\n540:     graphConflictMatches = graphSplit.conflictMatches;\n541:     graphSupportBySeed = graphSplit.positiveSupportBySeed;\n542:   }\n543:   return { laneScores: scores, graphConflictMatches, graphSupportBySeed };\n544: }\n545: \n546: // Smallest gap the rounded weighted score can still express, so a bounded\n547: // target sorts strictly below its seed instead of tying with it.\n548: const SEED_BOUND_GAP = 0.000001;\n549: \n550: // Below this explicit-lane score a match is a side mention, not a request.\n551: const EXPLICIT_WORKFLOW_SIGNAL_FLOOR = 0.55;\n552: \n553: // Explicit-lane evidence that a typed slash command named this skill.\n554: const SLASH_COMMAND_EVIDENCE = /^(phrase|author|explicit):\\//;\n555: \n556: export function hasSlashCommandAnchor(rawScore: number, evidence: readonly string[]): boolean {\n557:   return rawScore >= EXPLICIT_WORKFLOW_SIGNAL_FLOOR\n558:     && evidence.some((entry) => SLASH_COMMAND_EVIDENCE.test(entry));\n559: }\n560: \n561: // Graph support is lent: a seed's own evidence propagates to its neighbours so\n562: // related skills surface beside it. When the seed was invoked by a typed slash\n563: // command, the user has named it outright, so support it lends may lift a\n564: // target up to it but never past it; otherwise the command's own match is what\n565: // buries the command (a typed \"/deep:research\" handing its dependency enough\n566: // support to win). Seeds matched only on loose tokens keep ordinary graph\n567: // lending, since there the neighbour may well be the better route. Two skills\n568: // often lend to each other, so the pair is compared on what each holds once\n569: // the other's loan is taken back: a target whose own evidence still beats the\n570: // seed's own evidence keeps its score.\n571: export function boundGraphSupportBySeed(\n572:   scores: ReadonlyMap<string, number>,\n573:   graphRawBySkill: ReadonlyMap<string, number>,\n574:   graphSupportBySeed: ReadonlyMap<string, ReadonlyMap<string, number>>,\n575:   graphWeight: number,\n576:   slashAnchoredSeeds: ReadonlySet<string>,\n577: ): Map<string, number> {\n578:   return boundGraphSupportBySeedWithHolders(\n579:     scores,\n580:     graphRawBySkill,\n581:     graphSupportBySeed,\n582:     graphWeight,\n583:     slashAnchoredSeeds,\n584:   ).scores;\n585: }\n586: \n587: export interface SeedBoundResult {\n588:   readonly scores: Map<string, number>;\n589:   // Target skill -> the typed-command seed whose ceiling actually lowered it.\n590:   readonly heldBelow: Map<string, string>;\n591: }\n592: \n593: export function boundGraphSupportBySeedWithHolders(\n594:   scores: ReadonlyMap<string, number>,\n595:   graphRawBySkill: ReadonlyMap<string, number>,\n596:   graphSupportBySeed: ReadonlyMap<string, ReadonlyMap<string, number>>,\n597:   graphWeight: number,\n598:   slashAnchoredSeeds: ReadonlySet<string>,\n599: ): SeedBoundResult {\n600:   const bounded = new Map(scores);\n601:   const heldBelow = new Map<string, string>();\n602:   if (graphWeight <= 0) return { scores: bounded, heldBelow };\n603:   const lentBy = (lenderId: string, receiverId: string): number => {\n604:     const support = graphSupportBySeed.get(receiverId)?.get(lenderId) ?? 0;\n605:     const graphRaw = Math.max(0, graphRawBySkill.get(receiverId) ?? 0);\n606:     return Math.min(support, graphRaw) * graphWeight;\n607:   };\n608:   // Which seed holds which target down is decided once, on the unbounded\n609:   // scores, so the evidence comparison never sees a cap.\n610:   const holdersByTarget = new Map<string, string[]>();\n611:   for (const [targetId, supportBySeed] of graphSupportBySeed) {\n612:     const targetScore = scores.get(targetId);\n613:     if (targetScore === undefined) continue;\n614:     const holders: string[] = [];\n615:     for (const seedId of supportBySeed.keys()) {\n616:       if (seedId === targetId || !slashAnchoredSeeds.has(seedId)) continue;\n617:       const seedScore = scores.get(seedId);\n618:       if (seedScore === undefined) continue;\n619:       const targetOwn = targetScore - lentBy(seedId, targetId);\n620:       const seedOwn = seedScore - lentBy(targetId, seedId);\n621:       if (targetOwn < seedOwn) holders.push(seedId);\n622:     }\n623:     if (holders.length > 0) holdersByTarget.set(targetId, holders);\n624:   }\n625:   // A held seed can itself be held by another typed command, so each ceiling\n626:   // follows the seed's bounded score and the caps repeat until nothing moves.\n627:   // Caps only ever lower a score, and each pass settles at least one more link\n628:   // of a chain, so one pass per held target is enough.\n629:   for (let pass = 0; pass <= holdersByTarget.size; pass += 1) {\n630:     let moved = false;\n631:     for (const [targetId, holders] of holdersByTarget) {\n632:       const current = bounded.get(targetId) ?? 0;\n633:       let ceiling = current;\n634:       for (const seedId of holders) ceiling = Math.min(ceiling, (bounded.get(seedId) ?? 0) - SEED_BOUND_GAP);\n635:       if (ceiling < current) {\n636:         bounded.set(targetId, Math.max(0, ceiling));\n637:         moved = true;\n638:       }\n639:     }\n640:     if (!moved) break;\n641:   }\n642:   // Only a target the cap really lowered is marked, and only against the seed\n643:   // whose ceiling set its final score: a seed that merely could have held it\n644:   // ranked nothing, so the pair keeps its ordinary ambiguity check.\n645:   for (const [targetId, holders] of holdersByTarget) {\n646:     const final = bounded.get(targetId) ?? 0;\n647:     if (final >= (scores.get(targetId) ?? 0)) continue;\n648:     let binding: string | null = null;\n649:     let lowestSeed = Number.POSITIVE_INFINITY;\n650:     for (const seedId of holders) {\n651:       const seedScore = bounded.get(seedId) ?? 0;\n652:       if (seedScore < lowestSeed) {\n653:         lowestSeed = seedScore;\n654:         binding = seedId;\n655:       }\n656:     }\n657:     if (binding) heldBelow.set(targetId, binding);\n658:   }\n659:   return { scores: bounded, heldBelow };\n660: }\n661: \n662: function hasExplicitWorkflowSignal(contributions: readonly LaneContribution[], skillId: string): boolean {\n663:   const explicit = contributions.find((contribution) => contribution.lane === 'explicit_author');\n664:   if (!explicit || explicit.rawScore < EXPLICIT_WORKFLOW_SIGNAL_FLOOR) return false;\n665:   return explicit.evidence.some((entry) => (\n666:     entry.startsWith('phrase:')\n667:     || entry.startsWith('explicit:')\n668:     || entry.startsWith('author:')\n669:     || entry.includes(skillId)\n670:     || entry.includes('loop')\n671:     || entry.includes('write-')\n672:   ));\n673: }\n674: \n675: // Wording that asks for an answer and rules out a change. One pattern serves\n676: // every gate that has to honour it, so a new gate cannot drift from the first.\n677: const NO_EDIT_REQUEST = /\\b(no edits?|without making changes|do not (change|edit|modify|touch)|read-only only|no edits yet|only; do not|just show|just list)\\b/;\n678: \n679: export function readOnlyRouteAllowed(promptLower: string, skill: SkillProjection): boolean {\n680:   const skillId = skill.id;\n681:   if (NO_EDIT_REQUEST.test(promptLower)) {\n682:     return false;\n683:   }\n684:   // The explainer floor exists to stop an ambiguous read-only question from\n685:   // routing anywhere. Naming the skill removes the ambiguity: the caller has\n686:   // already chosen, and a read-only verb does not undo that choice. Without\n687:   // this, an explicit request is answered with an abstention while the same\n688:   // sentence phrased with a write verb routes fine.\n689:   if (promptMentionsSkill(promptLower, skill)) {\n690:     return true;\n691:   }\n692:   // A command whose route only reads (a report, a status check) is the answer\n693:   // to a list or show question, so its own trigger phrase lifts it off the\n694:   // floor. A mutating command never carries the flag and stays gated.\n695:   if (skill.kind === 'command' && 'readOnly' in skill && skill.readOnly === true\n696:     && skill.keywords.some((phrase) => matchesPhraseBoundary(promptLower, phrase.toLowerCase()))) {\n697:     return true;\n698:   }\n699:   if (skillId === 'sk-code' && /\\b(compare|audit|review)\\b/.test(promptLower)\n700:     && /\\b(classifier|vocabulary|prose|implementation|agents\\.md|drift|mismatch)\\b/.test(promptLower)) {\n701:     return true;\n702:   }\n703:   if (skillId === 'system-spec-kit' && /\\b(memory_save|resume_write|routing taxonomy|corpus|source-type|routing bucket)\\b/.test(promptLower)) {\n704:     return true;\n705:   }\n706:   if (skillId === 'system-spec-kit' && /\\b(packet|spec folder|save memory|phase|continuation prompts|resume handling)\\b/.test(promptLower)) {\n707:     return true;\n708:   }\n709:   // Captured operator answers wait in a queue that spec-kit's save step owns, so a show or list\n710:   // question about that queue, its chat candidates or the decision record is answered there.\n711:   // Only a read-only question is lifted: a lift applies to any prompt, and a request to research,\n712:   // dispatch or build something about decisions belongs to another skill.\n713:   if (skillId === 'system-spec-kit' && isReadOnlyExplainer(promptLower)\n714:     && /\\b(decision capture|decision record|chat candidates?|operator decisions?|recorded as decisions?)\\b/.test(promptLower)) {\n715:     return true;\n716:   }\n717:   // The trigger index is spec-kit's own lookup surface, so a question about what a lookup\n718:   // returned, counted or left out is answered there. Without the lift no skill passes on such a\n719:   // question, and the doctor hand-off claims it on the index noun alone. Drift is the doctor's\n720:   // own diagnosis, so a drift question stays with the hand-off.\n721:   if (skillId === 'system-spec-kit' && isReadOnlyExplainer(promptLower)\n722:     && /\\btrigger[- ]index\\b/.test(promptLower) && !/\\bdrift\\b/.test(promptLower)) {\n723:     return true;\n724:   }\n725:   if (skillId === 'system-deep-loop' && /\\b(ai council|planning council|council deliberation|council artifacts|multi-seat planning)\\b/.test(promptLower)) {\n726:     return true;\n727:   }\n728:   // Browser/devtools inspection is a genuine chrome-devtools task even though\n729:   // its verb (\"inspect\") reads as a read-only explainer. Lift it off the\n730:   // explainer floor when the prompt carries devtools-specific vocabulary.\n731:   if (skillId === 'mcp-tooling'\n732:     && /\\b(network waterfall|network tab|network request|dev ?tools|browser console|page inspector|dom inspector|performance trace|inspect (the )?(network|dom|page|element|browser))\\b/.test(promptLower)) {\n733:     return true;\n734:   }\n735:   if (skillId === 'sk-code' && /\\bgate-3-classifier\\.ts\\b/.test(promptLower)) {\n736:     return true;\n737:   }\n738:   return false;\n739: }\n740: \n741: function isPlainFileSavePrompt(promptLower: string): boolean {\n742:   return FILE_SAVE_OPERATION.test(promptLower) && !MEMORY_SAVE_CONTEXT_ANCHOR.test(promptLower.replace(/\\bfile(s)?\\b/g, ''));\n743: }\n744: \n745: function primaryIntentBonus(\n746:   promptLower: string,\n747:   recommendation: AdvisorScoredRecommendation,\n748: ): number {\n749:   const R = SCORING_CALIBRATION.routing;\n750:   if (/\\bsemantic (code )?search\\b/.test(promptLower)) {\n751:   }\n752:   if (/\\bdeep[- ]review\\b/.test(promptLower)) {\n753:     if (recommendation.skill === 'sk-code') {\n754:       return AUTHORS_CODE.test(promptLower) ? R.deepReviewCodeAuthoringSkCodeBonus : R.deepReviewSkCodeReviewPenalty;\n755:     }\n756:   }\n757:   if (/\\bdeep[- ]research\\b/.test(promptLower)) {\n758:     if (recommendation.skill === 'system-spec-kit' || recommendation.skill === 'sk-code') return R.deepResearchOtherSkillsPenalty;\n759:   }\n760:   if (DEEP_RESEARCH_CYCLE.test(promptLower)) {\n761:     if (recommendation.skill === 'system-spec-kit' || recommendation.skill === 'sk-code') return R.deepResearchCycleOtherSkillsPenalty;\n762:   }\n763:   if (/\\b(compare|audit|review)\\b/.test(promptLower) && /\\b(classifier|vocabulary|prose|implementation|agents\\.md|drift|mismatch)\\b/.test(promptLower)) {\n764:     if (recommendation.skill === 'sk-code') return R.compareAuditCodeReviewBonus;\n765:   }\n766:   // A changelog request that names its packet or spec folder still asks for a\n767:   // changelog, so sk-doc must outrank the spec workflow that \"spec folder\" lifts.\n768:   // Only those two skills are adjusted here. Every other skill falls through so\n769:   // later rules such as save-context or /speckit:plan still apply to it.\n770:   const changelogFromPacket = CHANGELOG_AUTHORING.test(promptLower)\n771:     && CHANGELOG_PACKET_SOURCE.test(promptLower)\n772:     && !AUTHORS_CODE.test(promptLower);\n773:   if (changelogFromPacket) {\n774:     if (recommendation.skill === 'sk-doc') return R.changelogFromPacketSkDocBonus;\n775:     if (recommendation.skill === 'system-spec-kit') return R.changelogFromPacketSpecKitPenalty;\n776:   }\n777:   // The corpus-study rule reads \"packet-local\" as study vocabulary, so it must\n778:   // stay off a changelog request or it would pull the prompt to system-spec-kit.\n779:   // \"packet-local changelog\" names sk-doc's changelog mode with or without an\n780:   // authoring verb, so packet-local is study vocabulary only when it qualifies\n781:   // something other than a changelog.\n782:   if (!changelogFromPacket && /\\b(corpus ids?|first-100 predictions|continuation prompts|routing study config|confusion matrix|source-mix note|prompt template|packet-local(?!\\s+changelog))\\b/.test(promptLower) && !AUTHORS_CODE.test(promptLower)) {\n783:     if (recommendation.skill === 'system-spec-kit') return R.corpusStudySpecKitBonus;\n784:     if (recommendation.skill === 'sk-prompt' || recommendation.skill === 'mcp-tooling' || recommendation.skill === 'sk-doc') return R.corpusStudyOtherSkillsPenalty;\n785:   }\n786:   if (promptLower.includes('/speckit:resume')) {\n787:     if (recommendation.skill === 'system-spec-kit') return R.speckitResumeSpecKitBonus;\n788:     if (recommendation.skill === 'command-speckit-resume') return R.speckitResumeCommandPenalty;\n789:   }\n790:   if (promptLower.includes('/speckit:plan')) {\n791:     if (recommendation.skill === 'command-speckit-plan') return R.speckitPlanCommandBonus;\n792:     if (recommendation.skill === 'sk-doc') return R.speckitPlanSkDocPenalty;\n793:   }\n794:   // External-tool-chain (\"call_tool_chain\") vocabulary belongs to mcp-code-mode,\n795:   // not the generic code skill. Disambiguate so the best guess for these\n796:   // toolchain-shaped prompts is mcp-code-mode.\n797:   // Toolchain + external-data-source vocabulary (webflow CMS, cms collection)\n798:   // is mcp-code-mode territory, not the generic code skill.\n799:   if (/\\b(call_tool_chain|code mode|tool ?chain|api chain|webflow cms|cms collection)\\b/.test(promptLower)) {\n800:     if (recommendation.skill === 'mcp-code-mode') return R.mcpToolchainCodeModeBonus;\n801:     if (recommendation.skill === 'sk-code') return R.mcpToolchainSkCodePenalty;\n802:   }\n803:   // A \"code audit\" is a single-pass code-review task, not a deep-review loop, so\n804:   // sk-code should win the near-tie this phrase produces. The sk-code bonus\n805:   // carries that; the deep-loop skills intentionally hold no \"code audit\"\n806:   // vocabulary, so they need no counter-penalty here.\n807:   if (/\\bcode audit\\b/.test(promptLower)) {\n808:     if (recommendation.skill === 'sk-code') return R.codeAuditCodeReviewBonus;\n809:   }\n810:   // Colon-command review-loop syntax (\":review:auto\") invokes the deep-review\n811:   // loop; rank it above single-pass code review.\n812:   if (/:review:(auto|confirm)\\b/.test(promptLower)) {\n813:     if (recommendation.skill === 'system-deep-loop') return R.reviewLoopDeepReviewBonus;\n814:     if (recommendation.skill === 'sk-code') return R.deepReviewSkCodeReviewPenalty;\n815:   }\n816:   // Auditing recommendation quality is a review task, not an advisor-self task.\n817:   if (/\\baudit\\b/.test(promptLower) && /\\b(recommendation|recommendations|recommendation quality|routing quality)\\b/.test(promptLower)) {\n818:     if (recommendation.skill === 'sk-code') return R.auditRecsCodeReviewBonus;\n819:     // Auditing routing output is a review task, not an advisor invocation: demote\n820:     // the advisor and its alias (the canonical self-rec id set) so neither ranks\n821:     // itself first here.\n822:     if (isAdvisorSelfRecommendationSkill(recommendation.skill)) return R.auditRecsAdvisorPenalty;\n823:   }\n824:   if (/\\b(save context|save memory)\\b/.test(promptLower)) {\n825:     if (recommendation.skill === 'command-speckit-save') return R.saveContextMemorySaveBonus;\n826:     if (recommendation.skill === 'system-spec-kit') return R.saveContextMemorySpecKitPenalty;\n827:   }\n828:   if (/\\b(create (a )?new agent|create agent)\\b/.test(promptLower) || promptLower.includes('/create:agent')) {\n829:     if (recommendation.skill === 'create:agent') return R.createAgentCreateAgentBonus;\n830:     if (recommendation.skill === 'sk-doc') return R.createAgentSkDocPenalty;\n831:   }\n832:   if (/\\bcreate (a )?(test|testing) playbook\\b/.test(promptLower) || promptLower.includes('/create:manual-testing-playbook')) {\n833:     if (recommendation.skill === 'create:manual-testing-playbook' || recommendation.skill === 'command-create-manual-testing-playbook') return R.createTestingPlaybookBonus;\n834:     if (recommendation.skill === 'sk-doc') return R.createTestingPlaybookSkDocPenalty;\n835:     if (recommendation.skill === 'system-deep-loop') return R.createTestingPlaybookOtherSkillsPenalty;\n836:   }\n837:   if (/\\bphase folder\\b/.test(promptLower)) {\n838:     if (recommendation.skill === 'system-spec-kit') return R.phaseFolderSpecKitBonus;\n839:   }\n840:   return 0;\n841: }\n842: \n843: // ───────────────────────────────────────────────────────────────────\n844: // 5. CORE LOGIC\n845: // ───────────────────────────────────────────────────────────────────\n846: \n847: // The bar sits above the highest cosine any prompt that must stay silent reached\n848: // against a command row, with headroom, because a command offered for the wrong\n849: // prompt costs more than one that stays quiet. The margin asks for a small lead\n850: // over the next command and over the top skill, which is what kept a wrong\n851: // command out of first place on the tuning rows. Raise the bar before the\n852: // margin if a false offer appears.\n853: export const COMMAND_MEANING_MIN_COSINE = 0.72;\n854: export const COMMAND_MEANING_MARGIN = 0.02;\n855: \n856: // The lane reports a real embedder cosine as \"cosine:\", while the word-overlap\n857: // stand-in used under test reports \"shadow:\". Only a real cosine may carry a\n858: // command on meaning, because the stand-in measures shared words rather than\n859: // shared meaning.\n860: function commandMeaningCosine(contribution: LaneContribution | undefined): number | null {\n861:   if (!contribution) return null;\n862:   return contribution.evidence.some((entry) => entry.startsWith('cosine:'))\n863:     ? contribution.rawScore\n864:     : null;\n865: }\n866: \n867: // A command bridge passes on its own wording: one of its authored phrases or its\n868: // runnable slash string, which the explicit-author lane reports. A bridge that\n869: // passed on shared single tokens alone stays scored but stops passing, because\n870: // its phrases are everyday words and a command must not be offered for a prompt\n871: // that merely shares some of them. A paraphrase shares no words at all, so the\n872: // second way in is meaning: a real prompt embedding that clears both bars above.\n873: // Meaning-passed ids are collected so a later ordering step can tell them apart,\n874: // and a doctor problem in other words reaches /doctor:helper through\n875: // applyDoctorHelperHandoff instead.\n876: // A question that only wants an answer must not be handed a command that\n877: // changes things, however close the meaning. Phrase matches are already held to\n878: // this by the read-only confidence floor, and a meaning match lifts confidence\n879: // past that floor, so it has to ask the same question itself. A command whose\n880: // route only reads stays eligible for a plain explainer, because running it is\n881: // the answer. An explicit no-edit request rules out every command.\n882: export function commandMeaningEligible(\n883:   promptLower: string,\n884:   readOnlyExplainer: boolean,\n885:   skill: SkillProjection | undefined,\n886: ): boolean {\n887:   if (NO_EDIT_REQUEST.test(promptLower)) return false;\n888:   if (!readOnlyExplainer) return true;\n889:   return skill !== undefined && skill.kind === 'command' && 'readOnly' in skill && skill.readOnly === true;\n890: }\n891: \n892: export function requireCommandPhraseAnchor(\n893:   ranked: readonly AdvisorScoredRecommendation[],\n894:   confidenceThreshold: number = DEFAULT_CONFIDENCE_THRESHOLD,\n895:   meaningPassed: Set<string> = new Set(),\n896:   meaningEligible: (skillId: string) => boolean = () => true,\n897: ): AdvisorScoredRecommendation[] {\n898:   const cosineByCommandId = new Map<string, number>();\n899:   for (const recommendation of ranked) {\n900:     if (recommendation.kind !== 'command') continue;\n901:     const cosine = commandMeaningCosine(\n902:       recommendation.laneContributions.find((contribution) => contribution.lane === 'semantic_shadow'),\n903:     );\n904:     if (cosine !== null) cosineByCommandId.set(recommendation.skill, cosine);\n905:   }\n906:   // A command row with no cosine counts as 0, so the bar is the strongest other\n907:   // command row, not the strongest row overall: a skill row never decides this.\n908:   const leadingOtherCosine = (skillId: string): number => {\n909:     let lead = 0;\n910:     for (const [otherSkillId, cosine] of cosineByCommandId) {\n911:       if (otherSkillId !== skillId && cosine > lead) lead = cosine;\n912:     }\n913:     return lead;\n914:   };\n915:   return ranked.map((recommendation) => {\n916:     if (recommendation.kind !== 'command') return recommendation;\n917:     const anchored = recommendation.laneContributions.some((contribution) => (\n918:       contribution.lane === 'explicit_author' && contribution.rawScore > 0\n919:     ));\n920:     if (anchored) return recommendation;\n921:     const cosine = cosineByCommandId.get(recommendation.skill);\n922:     if (cosine !== undefined\n923:       && cosine >= COMMAND_MEANING_MIN_COSINE\n924:       && cosine - leadingOtherCosine(recommendation.skill) >= COMMAND_MEANING_MARGIN\n925:       && meaningEligible(recommendation.skill)) {\n926:       // A meaning match alone rarely clears the threshold on its lane weight, so\n927:       // the anchor lifts the row to it rather than leaving it scored but unpassed.\n928:       meaningPassed.add(recommendation.skill);\n929:       return {\n930:         ...recommendation,\n931:         confidence: Math.max(recommendation.confidence, confidenceThreshold),\n932:         passes_threshold: true,\n933:       };\n934:     }\n935:     return recommendation.passes_threshold\n936:       ? { ...recommendation, passes_threshold: false }\n937:       : recommendation;\n938:   });\n939: }\n940: \n941: function findTypedDoctorCommandText(promptLower: string): string | null {\n942:   const prompt = promptLower.trim();\n943:   if (prompt.startsWith(DOCTOR_COMMAND_PREFIX)) {\n944:     return prompt.slice(DOCTOR_COMMAND_PREFIX.length);\n945:   }\n946: \n947:   const invocationPattern = /\\b(?:run|execute|start|launch|use|kick\\s+off)\\s+\\/doctor:/g;\n948:   let quote: \"'\" | '\"' | '`' | null = null;\n949:   let quoteScanPosition = 0;\n950:   let invocation: RegExpExecArray | null;\n951: \n952:   while ((invocation = invocationPattern.exec(prompt)) !== null) {\n953:     const commandPosition = (\n954:       invocation.index + invocation[0].length - DOCTOR_COMMAND_PREFIX.length\n955:     );\n956:     while (quoteScanPosition < commandPosition) {\n957:       const character = prompt.charAt(quoteScanPosition);\n958:       const isWordApostrophe = character === \"'\"\n959:         && /[a-z0-9]/.test(prompt.charAt(quoteScanPosition - 1))\n960:         && /[a-z0-9]/.test(prompt.charAt(quoteScanPosition + 1));\n961:       if (!isWordApostrophe) {\n962:         if (quote === null) {\n963:           if (character === \"'\" || character === '\"' || character === '`') {\n964:             quote = character;\n965:           }\n966:         } else if (character === quote) {\n967:           quote = null;\n968:         }\n969:       }\n970:       quoteScanPosition += 1;\n971:     }\n972:     if (quote === null) return prompt.slice(commandPosition + DOCTOR_COMMAND_PREFIX.length);\n973:   }\n974:   return null;\n975: }\n976: \n977: export function isDoctorCommandTyped(promptLower: string): boolean {\n978:   return findTypedDoctorCommandText(promptLower) !== null;\n979: }\n980: \n981: // A typed command or matching doctor lead phrase moves its passing bridge first; otherwise passing\n982: // bridges follow the second passing skill or the only passing skill, and other recommendations keep order.\n983: export function keepPassingSkillsAboveDoctorBridges(\n984:   ranked: readonly AdvisorScoredRecommendation[],\n985:   promptLower: string,\n986:   leadPhrasesById: ReadonlyMap<string, readonly string[]> = new Map(),\n987: ): AdvisorScoredRecommendation[] {\n988:   const isDoctorBridge = (recommendation: AdvisorScoredRecommendation): boolean => (\n989:     recommendation.kind === 'command' && recommendation.skill.startsWith(DOCTOR_BRIDGE_PREFIX)\n990:   );\n991:   const isPassingDoctorBridge = (recommendation: AdvisorScoredRecommendation): boolean => (\n992:     isDoctorBridge(recommendation) && recommendation.passes_threshold\n993:   );\n994:   const typedCommandText = findTypedDoctorCommandText(promptLower);\n995:   if (typedCommandText !== null) {\n996:     const normalizedCommand = typedCommandText.toLowerCase().trim().replace(/\\s+/g, '-');\n997:     let matchedBridgeIndex = -1;\n998:     let matchedBridgeLength = -1;\n999:     ranked.forEach((recommendation, index) => {\n1000:       if (!isPassingDoctorBridge(recommendation)) return;\n1001:       const bridgeName = recommendation.skill.slice(DOCTOR_BRIDGE_PREFIX.length);\n1002:       if (bridgeName.length === 0 || !normalizedCommand.startsWith(bridgeName)) return;\n1003:       const nextCharacter = normalizedCommand.charAt(bridgeName.length);\n1004:       const endsAtWordBoundary = (\n1005:         nextCharacter === '' || !/[a-z0-9_]/.test(nextCharacter)\n1006:       );\n1007:       if (!endsAtWordBoundary || bridgeName.length <= matchedBridgeLength) return;\n1008:       matchedBridgeIndex = index;\n1009:       matchedBridgeLength = bridgeName.length;\n1010:     });\n1011:     const matchedBridge = ranked[matchedBridgeIndex];\n1012:     if (!matchedBridge) return [...ranked];\n1013:     return [\n1014:       matchedBridge,\n1015:       ...ranked.slice(0, matchedBridgeIndex),\n1016:       ...ranked.slice(matchedBridgeIndex + 1),\n1017:     ];\n1018:   }\n1019: \n1020:   const leadPhraseBridgeIndex = ranked.findIndex((recommendation) => {\n1021:     if (!isPassingDoctorBridge(recommendation)) return false;\n1022:     return leadPhrasesById.get(recommendation.skill)?.some((phrase) => (\n1023:       matchesPhraseBoundary(promptLower, phrase.toLowerCase())\n1024:     )) ?? false;\n1025:   });\n1026:   const leadPhraseBridge = ranked[leadPhraseBridgeIndex];\n1027:   if (leadPhraseBridge) {\n1028:     return [\n1029:       leadPhraseBridge,\n1030:       ...ranked.slice(0, leadPhraseBridgeIndex),\n1031:       ...ranked.slice(leadPhraseBridgeIndex + 1),\n1032:     ];\n1033:   }\n1034: \n1035:   const passingSkillCount = ranked.filter((recommendation) => (\n1036:     recommendation.kind === 'skill' && recommendation.passes_threshold\n1037:   )).length;\n1038:   if (passingSkillCount === 0) return [...ranked];\n1039: \n1040:   const passingDoctorBridges = ranked.filter(isPassingDoctorBridge);\n1041:   if (passingDoctorBridges.length === 0) return [...ranked];\n1042:   const remaining = ranked.filter((recommendation) => !isPassingDoctorBridge(recommendation));\n1043:   const targetPassingSkillCount = Math.min(2, passingSkillCount);\n1044:   let seenPassingSkills = 0;\n1045:   let insertionIndex = remaining.length;\n1046:   for (const [index, recommendation] of remaining.entries()) {\n1047:     if (recommendation.kind !== 'skill' || !recommendation.passes_threshold) continue;\n1048:     seenPassingSkills += 1;\n1049:     if (seenPassingSkills === targetPassingSkillCount) {\n1050:       insertionIndex = index + 1;\n1051:       break;\n1052:     }\n1053:   }\n1054:   return [\n1055:     ...remaining.slice(0, insertionIndex),\n1056:     ...passingDoctorBridges,\n[Output truncated. Continue reading with offset: 1057]"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/lib/scorer/fusion.ts\"}"},"time":{"start":1794558650326,"end":1794558650773}}}}
