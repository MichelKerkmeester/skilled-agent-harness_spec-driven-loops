{"type":"tool_use","timestamp":1794558687668,"sessionID":"ses_e2bf947b9ffe73zBWlC0D8WZq4","part":{"partID":"prt_1d4087800001Gi6QXU8bmZZxQC","sessionID":"ses_e2bf947b9ffe73zBWlC0D8WZq4","messageID":"msg_1d408641f001TAHD1ul7IUNRzt","type":"tool","id":"call_9e9bb709fc2b48eab6da814c","tool":"read","state":{"status":"completed","input":{"path":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/tests/command-head-length.vitest.ts"},"output":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/tests/command-head-length.vitest.ts, lines 1-129\n1: // ───────────────────────────────────────────────────────────────\n2: // MODULE: Command Head Length Tests\n3: // ───────────────────────────────────────────────────────────────\n4: \n5: import { describe, expect, it } from 'vitest';\n6: import { COMMAND_ROWS, TRACKED_COMMANDS } from '../lib/command-attach.js';\n7: import { renderAdvisorBrief } from '../lib/render.js';\n8: \n9: const DIRECTIVES_LABEL = '\\nDirectives:';\n10: // The renderer caps the advisor portion at its default 80 tokens and estimates\n11: // four characters per token, so a head over this byte budget has lost the\n12: // command it was supposed to carry.\n13: const HEAD_BYTE_LIMIT = 80 * 4;\n14: // A child session replaces start and ask policies with a parent-named marker,\n15: // so the cases pin the plain head a top-level reader receives.\n16: const TOP_LEVEL_OPTIONS = { childSession: false } as const;\n17: \n18: type AdvisorBriefResult = Parameters<typeof renderAdvisorBrief>[0];\n19: \n20: interface RecommendationInput {\n21:   readonly skill: string;\n22:   readonly kind?: 'skill' | 'command';\n23:   readonly command?: string;\n24:   readonly policy?: 'run' | 'start' | 'ask';\n25:   readonly ownerSkillId?: string;\n26:   readonly confidence: number;\n27:   readonly uncertainty: number;\n28: }\n29: \n30: interface HeadCase {\n31:   readonly name: string;\n32:   readonly recommendation: RecommendationInput;\n33:   readonly command: string;\n34:   readonly policy: string | undefined;\n35: }\n36: \n37: // Every tracked command renders through its owner so the head carries the\n38: // command, the policy and the owner even where no scorer row can return it.\n39: const TRACKED_CASES: readonly HeadCase[] = Object.entries(TRACKED_COMMANDS).map(([command, row]) => ({\n40:   name: `tracked ${command}`,\n41:   command,\n42:   policy: row.policy,\n43:   recommendation: {\n44:     skill: row.ownerSkillId,\n45:     kind: 'skill',\n46:     command,\n47:     policy: row.policy,\n48:     ownerSkillId: row.ownerSkillId,\n49:     confidence: 0.9,\n50:     uncertainty: 0.1,\n51:   },\n52: }));\n53: \n54: // A recommendation may carry only a row id and still fill its command, policy\n55: // and owner from the generated table, which is the path the brief relies on.\n56: const ROW_CASES: readonly HeadCase[] = Object.entries(COMMAND_ROWS).map(([id, row]) => ({\n57:   name: `row ${id}`,\n58:   command: row.command,\n59:   policy: row.policy,\n60:   recommendation: {\n61:     skill: id,\n62:     kind: 'command',\n63:     confidence: 0.9,\n64:     uncertainty: 0.1,\n65:   },\n66: }));\n67: \n68: // Every recommendation is marked as passing so each case isolates the head form\n69: // instead of threshold filtering.\n70: function advisorResult(recommendation: RecommendationInput): AdvisorBriefResult {\n71:   return {\n72:     status: 'ok',\n73:     freshness: 'live',\n74:     recommendations: [{ ...recommendation, passes_threshold: true }],\n75:     metrics: { tokenCap: 80 },\n76:   };\n77: }\n78: \n79: function headOf(rendered: string | null): string {\n80:   if (rendered === null) {\n81:     throw new Error('expected a rendered brief');\n82:   }\n83:   return rendered.split(DIRECTIVES_LABEL)[0];\n84: }\n85: \n86: function headViolations(head: string, command: string, policy: string | undefined): readonly string[] {\n87:   const violations: string[] = [];\n88:   const bytes = Buffer.byteLength(head, 'utf8');\n89:   if (bytes > HEAD_BYTE_LIMIT) {\n90:     violations.push(`${bytes} bytes over the ${HEAD_BYTE_LIMIT} byte limit`);\n91:   }\n92:   if (head.endsWith('...')) {\n93:     violations.push('head ends with an ellipsis');\n94:   }\n95:   const commandLabel = policy === undefined ? null : `${command} (${policy})`;\n96:   if (commandLabel === null || !head.includes(commandLabel)) {\n97:     violations.push(`${command} (${policy ?? 'no policy'}) is missing`);\n98:   }\n99:   return violations;\n100: }\n101: \n102: describe('command head length', () => {\n103:   it.each(TRACKED_CASES)('fits $name in the default cap', ({ recommendation, command, policy }) => {\n104:     const head = headOf(renderAdvisorBrief(advisorResult(recommendation), TOP_LEVEL_OPTIONS));\n105: \n106:     expect(headViolations(head, command, policy)).toEqual([]);\n107:   });\n108: \n109:   it.each(ROW_CASES)('fits $name in the default cap', ({ recommendation, command, policy }) => {\n110:     const head = headOf(renderAdvisorBrief(advisorResult(recommendation), TOP_LEVEL_OPTIONS));\n111: \n112:     expect(headViolations(head, command, policy)).toEqual([]);\n113:   });\n114: \n115:   it('rejects a command long enough to push the policy out of the head', () => {\n116:     const longCommand = `/${'x'.repeat(329)}`;\n117:     const head = headOf(renderAdvisorBrief(advisorResult({\n118:       skill: 'sk-doc',\n119:       kind: 'command',\n120:       command: longCommand,\n121:       policy: 'start',\n122:       ownerSkillId: 'sk-doc',\n123:       confidence: 0.9,\n124:       uncertainty: 0.1,\n125:     }), TOP_LEVEL_OPTIONS));\n126: \n127:     expect(headViolations(head, longCommand, 'start')).not.toEqual([]);\n128:   });\n129: });","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/tests/command-head-length.vitest.ts, lines 1-129\n1: // ───────────────────────────────────────────────────────────────\n2: // MODULE: Command Head Length Tests\n3: // ───────────────────────────────────────────────────────────────\n4: \n5: import { describe, expect, it } from 'vitest';\n6: import { COMMAND_ROWS, TRACKED_COMMANDS } from '../lib/command-attach.js';\n7: import { renderAdvisorBrief } from '../lib/render.js';\n8: \n9: const DIRECTIVES_LABEL = '\\nDirectives:';\n10: // The renderer caps the advisor portion at its default 80 tokens and estimates\n11: // four characters per token, so a head over this byte budget has lost the\n12: // command it was supposed to carry.\n13: const HEAD_BYTE_LIMIT = 80 * 4;\n14: // A child session replaces start and ask policies with a parent-named marker,\n15: // so the cases pin the plain head a top-level reader receives.\n16: const TOP_LEVEL_OPTIONS = { childSession: false } as const;\n17: \n18: type AdvisorBriefResult = Parameters<typeof renderAdvisorBrief>[0];\n19: \n20: interface RecommendationInput {\n21:   readonly skill: string;\n22:   readonly kind?: 'skill' | 'command';\n23:   readonly command?: string;\n24:   readonly policy?: 'run' | 'start' | 'ask';\n25:   readonly ownerSkillId?: string;\n26:   readonly confidence: number;\n27:   readonly uncertainty: number;\n28: }\n29: \n30: interface HeadCase {\n31:   readonly name: string;\n32:   readonly recommendation: RecommendationInput;\n33:   readonly command: string;\n34:   readonly policy: string | undefined;\n35: }\n36: \n37: // Every tracked command renders through its owner so the head carries the\n38: // command, the policy and the owner even where no scorer row can return it.\n39: const TRACKED_CASES: readonly HeadCase[] = Object.entries(TRACKED_COMMANDS).map(([command, row]) => ({\n40:   name: `tracked ${command}`,\n41:   command,\n42:   policy: row.policy,\n43:   recommendation: {\n44:     skill: row.ownerSkillId,\n45:     kind: 'skill',\n46:     command,\n47:     policy: row.policy,\n48:     ownerSkillId: row.ownerSkillId,\n49:     confidence: 0.9,\n50:     uncertainty: 0.1,\n51:   },\n52: }));\n53: \n54: // A recommendation may carry only a row id and still fill its command, policy\n55: // and owner from the generated table, which is the path the brief relies on.\n56: const ROW_CASES: readonly HeadCase[] = Object.entries(COMMAND_ROWS).map(([id, row]) => ({\n57:   name: `row ${id}`,\n58:   command: row.command,\n59:   policy: row.policy,\n60:   recommendation: {\n61:     skill: id,\n62:     kind: 'command',\n63:     confidence: 0.9,\n64:     uncertainty: 0.1,\n65:   },\n66: }));\n67: \n68: // Every recommendation is marked as passing so each case isolates the head form\n69: // instead of threshold filtering.\n70: function advisorResult(recommendation: RecommendationInput): AdvisorBriefResult {\n71:   return {\n72:     status: 'ok',\n73:     freshness: 'live',\n74:     recommendations: [{ ...recommendation, passes_threshold: true }],\n75:     metrics: { tokenCap: 80 },\n76:   };\n77: }\n78: \n79: function headOf(rendered: string | null): string {\n80:   if (rendered === null) {\n81:     throw new Error('expected a rendered brief');\n82:   }\n83:   return rendered.split(DIRECTIVES_LABEL)[0];\n84: }\n85: \n86: function headViolations(head: string, command: string, policy: string | undefined): readonly string[] {\n87:   const violations: string[] = [];\n88:   const bytes = Buffer.byteLength(head, 'utf8');\n89:   if (bytes > HEAD_BYTE_LIMIT) {\n90:     violations.push(`${bytes} bytes over the ${HEAD_BYTE_LIMIT} byte limit`);\n91:   }\n92:   if (head.endsWith('...')) {\n93:     violations.push('head ends with an ellipsis');\n94:   }\n95:   const commandLabel = policy === undefined ? null : `${command} (${policy})`;\n96:   if (commandLabel === null || !head.includes(commandLabel)) {\n97:     violations.push(`${command} (${policy ?? 'no policy'}) is missing`);\n98:   }\n99:   return violations;\n100: }\n101: \n102: describe('command head length', () => {\n103:   it.each(TRACKED_CASES)('fits $name in the default cap', ({ recommendation, command, policy }) => {\n104:     const head = headOf(renderAdvisorBrief(advisorResult(recommendation), TOP_LEVEL_OPTIONS));\n105: \n106:     expect(headViolations(head, command, policy)).toEqual([]);\n107:   });\n108: \n109:   it.each(ROW_CASES)('fits $name in the default cap', ({ recommendation, command, policy }) => {\n110:     const head = headOf(renderAdvisorBrief(advisorResult(recommendation), TOP_LEVEL_OPTIONS));\n111: \n112:     expect(headViolations(head, command, policy)).toEqual([]);\n113:   });\n114: \n115:   it('rejects a command long enough to push the policy out of the head', () => {\n116:     const longCommand = `/${'x'.repeat(329)}`;\n117:     const head = headOf(renderAdvisorBrief(advisorResult({\n118:       skill: 'sk-doc',\n119:       kind: 'command',\n120:       command: longCommand,\n121:       policy: 'start',\n122:       ownerSkillId: 'sk-doc',\n123:       confidence: 0.9,\n124:       uncertainty: 0.1,\n125:     }), TOP_LEVEL_OPTIONS));\n126: \n127:     expect(headViolations(head, longCommand, 'start')).not.toEqual([]);\n128:   });\n129: });"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/tests/command-head-length.vitest.ts\"}"},"time":{"start":1794558687232,"end":1794558687668}}}}
{"type":"tool_use","timestamp":1794558687687,"sessionID":"ses_e2bf947b9ffe73zBWlC0D8WZq4","part":{"partID":"prt_1d408762e001ILt5RrlBpkJfyB","sessionID":"ses_e2bf947b9ffe73zBWlC0D8WZq4","messageID":"msg_1d408641f001TAHD1ul7IUNRzt","type":"tool","id":"call_a624a00786e54922b915d4a2","tool":"read","state":{"status":"completed","input":{"path":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/tests/command-attach.vitest.ts"},"output":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/tests/command-attach.vitest.ts, lines 1-206\n1: // ───────────────────────────────────────────────────────────────\n2: // MODULE: Command attach for a hub recommendation\n3: // ───────────────────────────────────────────────────────────────\n4: \n5: // The advisor names the workflow mode a hub would route a prompt to, and\n6: // `attachCommand()` turns that mode into the slash command a reader can type.\n7: // The table it reads is generated from each hub's own command files, so these\n8: // tests assert the properties the generator has to keep — an own-key lookup on\n9: // both levels, and a real command file behind every row — rather than restating\n10: // today's rows, which would drift from the generator instead of catching it.\n11: //\n12: // The deep-loop gate is asserted on its own, because a command offered for a\n13: // prompt that never asked for that effort commits the reader to a long run they\n14: // did not request, and the prompt is the only thing that can tell the two apart.\n15: \n16: import { existsSync } from 'node:fs';\n17: import { join } from 'node:path';\n18: \n19: import { describe, expect, it } from 'vitest';\n20: \n21: import {\n22:   attachCommand,\n23:   DEPTH_WORDING,\n24:   MODE_COMMANDS,\n25:   routeNeedsMode,\n26:   typedCommandForTop,\n27:   typedCommandIn,\n28: } from '../lib/command-attach.js';\n29: import { findAdvisorWorkspaceRoot } from '../lib/utils/workspace-root.js';\n30: import { AdvisorRecommendationSchema } from '../schemas/advisor-tool-schemas.js';\n31: \n32: type ModeCommands = Readonly<Record<string, Readonly<Record<string, string>>>>;\n33: \n34: const REPO_ROOT = findAdvisorWorkspaceRoot(import.meta.dirname);\n35: \n36: // A slash command spelling that also names the file behind it, so a generated row\n37: // can be checked against the command tree rather than against a second copy of\n38: // itself.\n39: const COMMAND_ID = /^\\/([a-z][a-z0-9-]*):([a-z0-9-]+)$/;\n40: \n41: // The only route shape that can name a command unambiguously: one decision, one\n42: // selected target, so the target's mode is the answer.\n43: function singleRoute(workflowMode: string, overrides: Record<string, unknown> = {}): Record<string, unknown> {\n44:   return { action: 'route', selectionKind: 'single', targets: [{ workflowMode }], ...overrides };\n45: }\n46: \n47: // Distinct from what the generated table holds for the same hub and mode, so a\n48: // passing assertion proves the injected table was read rather than the real one.\n49: const INJECTED_COMMAND = '/injected:readme';\n50: const INJECTED: ModeCommands = { 'sk-doc': { 'sk-create-readme': INJECTED_COMMAND } };\n51: const OTHER_HUB: ModeCommands = { 'made-up-hub': { 'made-up-mode': '/made-up:command' } };\n52: \n53: // Wording that names a topic without asking for effort: no phrase in the effort\n54: // vocabulary, and no typed slash command.\n55: const PLAIN_PROMPT = 'how does the routing table pick a skill';\n56: \n57: describe('command attach for a single routed mode', () => {\n58:   it('names the command the routed mode maps to', () => {\n59:     // Any generated hub except the gated one, read at test time so the case\n60:     // follows a regenerated table instead of pinning one of its rows.\n61:     const generated = Object.entries(MODE_COMMANDS).find(([hub]) => hub !== 'system-deep-loop');\n62:     expect(generated, 'the generated table names a hub outside the depth gate').toBeDefined();\n63:     const [hub, modes] = generated as [string, Readonly<Record<string, string>>];\n64:     const [mode, command] = Object.entries(modes)[0] as [string, string];\n65:     expect(command).toBeTypeOf('string');\n66: \n67:     expect(attachCommand(hub, singleRoute(mode), 'add a readme')).toBe(command);\n68: \n69:     expect(attachCommand('sk-doc', singleRoute('sk-create-readme'), 'anything', INJECTED)).toBe(INJECTED_COMMAND);\n70:     expect(attachCommand('made-up-hub', singleRoute('made-up-mode'), 'anything', OTHER_HUB)).toBe('/made-up:command');\n71:   });\n72: \n73:   it('offers no command unless the route names exactly one mode the table holds', () => {\n74:     const rows: Array<[string, string, unknown]> = [\n75:       ['a multi-selection route', 'sk-doc', {\n76:         action: 'route', selectionKind: 'multi', targets: [{ workflowMode: 'sk-create-readme' }],\n77:       }],\n78:       ['an ask decision', 'sk-doc', {\n79:         action: 'ask', selectionKind: 'single', targets: [{ workflowMode: 'sk-create-readme' }],\n80:       }],\n81:       ['a route with two targets', 'sk-doc', {\n82:         action: 'route',\n83:         selectionKind: 'single',\n84:         targets: [{ workflowMode: 'sk-create-readme' }, { workflowMode: 'sk-create-benchmark' }],\n85:       }],\n86:       ['a mode the table does not hold', 'sk-doc', singleRoute('sk-create-benchmark')],\n87:       ['a hub the table does not hold', 'sk-git', singleRoute('sk-create-readme')],\n88:       ['no route at all', 'sk-doc', null],\n89:       ['a route that is an array', 'sk-doc', [singleRoute('sk-create-readme')]],\n90:       // An inherited name such as `constructor` is never a command the hub\n91:       // declared, so the lookup must read own keys at both levels.\n92:       ['a mode named after an inherited key', 'sk-doc', singleRoute('constructor')],\n93:       ['a hub named after an inherited key', 'constructor', singleRoute('sk-create-readme')],\n94:     ];\n95: \n96:     for (const [label, skillId, compiledRoute] of rows) {\n97:       expect(attachCommand(skillId, compiledRoute, PLAIN_PROMPT, INJECTED), label).toBeUndefined();\n98:     }\n99:     expect(attachCommand('constructor', singleRoute('constructor'), PLAIN_PROMPT), 'both levels inherited').toBeUndefined();\n100:   });\n101: \n102:   it('offers a deep-loop command only when the prompt asks for that effort', () => {\n103:     const plainIsQuiet = DEPTH_WORDING.every((phrase) => !PLAIN_PROMPT.toLowerCase().includes(phrase));\n104:     expect(plainIsQuiet, 'the effort-free probe prompt mentions no effort wording').toBe(true);\n105: \n106:     const modes = Object.entries(MODE_COMMANDS['system-deep-loop']);\n107:     expect(modes.length).toBeGreaterThan(0);\n108:     const [effortPhrase] = DEPTH_WORDING;\n109:     expect(effortPhrase).toBeTruthy();\n110: \n111:     for (const [mode, command] of modes) {\n112:       const route = singleRoute(mode);\n113:       expect(attachCommand('system-deep-loop', route, PLAIN_PROMPT), mode).toBeUndefined();\n114:       expect(attachCommand('system-deep-loop', route, `explain the scorer ${effortPhrase}`), mode).toBe(command);\n115:       expect(attachCommand('system-deep-loop', route, `run ${command} for me`), mode).toBe(command);\n116:     }\n117: \n118:     // The gate belongs to the deep-loop hub alone: every other hub answers the\n119:     // same effort-free prompt with its command.\n120:     expect(attachCommand('sk-doc', singleRoute('sk-create-benchmark'), PLAIN_PROMPT, INJECTED)).toBeUndefined();\n121:     expect(attachCommand('sk-doc', singleRoute('sk-create-readme'), PLAIN_PROMPT, INJECTED)).toBe(INJECTED_COMMAND);\n122:   });\n123: \n124:   it('stays quiet when a prompt only names a deep-loop mode by its topic', () => {\n125:     const topicOnly: ReadonlyArray<readonly [string, string]> = [\n126:       ['ai-council', 'What does the AI council mode do?'],\n127:       ['research', 'what is research mode?'],\n128:       ['review', 'how does the review mode work?'],\n129:     ];\n130:     for (const [mode, prompt] of topicOnly) {\n131:       expect(MODE_COMMANDS['system-deep-loop'], mode).toHaveProperty(mode);\n132:       expect(attachCommand('system-deep-loop', singleRoute(mode), prompt), prompt).toBeUndefined();\n133:     }\n134:     expect(attachCommand('system-deep-loop', singleRoute('ai-council'), 'ask the council whether to split billing'))\n135:       .toBe(MODE_COMMANDS['system-deep-loop']['ai-council']);\n136:   });\n137: \n138:   it('names a real command file behind every generated row', () => {\n139:     const hubs = Object.keys(MODE_COMMANDS);\n140:     expect(hubs.length).toBeGreaterThan(0);\n141: \n142:     for (const hub of hubs) {\n143:       const modes = Object.entries(MODE_COMMANDS[hub]);\n144:       expect(modes.length, hub).toBeGreaterThan(0);\n145:       for (const [mode, command] of modes) {\n146:         const label = `${hub} ${mode}: ${command}`;\n147:         const match = command.match(COMMAND_ID);\n148:         expect(match, label).not.toBeNull();\n149:         const [, namespace, name] = match as RegExpMatchArray;\n150:         expect(existsSync(join(REPO_ROOT, '.skilled', 'commands', namespace, `${name}.md`)), label).toBe(true);\n151:       }\n152:     }\n153:   });\n154: \n155:   it('accepts a named command on a recommendation and refuses an empty one', () => {\n156:     // Only the schema's required keys, so the object proves the command field is\n157:     // the one under test rather than something an unrelated field satisfied.\n158:     const minimal = {\n159:       skillId: 'sk-create-readme',\n160:       score: 1,\n161:       confidence: 0.9,\n162:       uncertainty: 0.1,\n163:       dominantLane: null,\n164:     };\n165: \n166:     expect(AdvisorRecommendationSchema.safeParse(minimal).success).toBe(true);\n167:     expect(AdvisorRecommendationSchema.safeParse({ ...minimal, command: '/create:readme' }).success).toBe(true);\n168:     expect(AdvisorRecommendationSchema.safeParse({ ...minimal, command: '' }).success).toBe(false);\n169:   });\n170: });\n171: \n172: // A typed command is the reader's own wording, so the match runs on boundaries\n173: // and prefers the longest key, and it is delivered only through the skill that\n174: // owns it or through a recommendation carrying the same command row.\n175: describe('typed command on the leading recommendation', () => {\n176:   it('reads the longest typed command at a command boundary', () => {\n177:     expect(typedCommandIn('/create:skill-parent deploy-hub with three modes')).toBe('/create:skill-parent');\n178:     expect(typedCommandIn('/create:sk')).toBeUndefined();\n179:     expect(typedCommandIn('see docs/create:goal.md')).toBeUndefined();\n180:   });\n181: \n182:   it('delivers a typed command through its owner or through the same command row', () => {\n183:     const expected = { command: '/speckit:resume', policy: 'start', ownerSkillId: 'system-spec-kit' };\n184: \n185:     expect(typedCommandForTop('system-spec-kit', '/speckit:resume cache work')).toEqual(expected);\n186:     expect(typedCommandForTop('command-speckit-resume', '/speckit:resume cache work')).toEqual(expected);\n187:     expect(typedCommandForTop('sk-doc', '/speckit:resume cache work')).toBeUndefined();\n188:   });\n189: });\n190: \n191: // A route that holds back its command for want of a single mode is worth saying\n192: // out loud, but only for a hub that had a command to withhold, so the flag does\n193: // not fire for a deferral that never named a mode in the first place.\n194: describe('a route that waits for a mode', () => {\n195:   it('flags a defer or clarify on a hub whose modes map to commands', () => {\n196:     expect(routeNeedsMode('system-deep-loop', { action: 'defer' })).toBe(true);\n197:     expect(routeNeedsMode('sk-doc', { action: 'clarify' })).toBe(true);\n198:   });\n199: \n200:   it('stays quiet for a routed mode, a hub outside the table and a shape that is no route', () => {\n201:     expect(routeNeedsMode('sk-doc', singleRoute('sk-create-readme'))).toBe(false);\n202:     expect(routeNeedsMode('sk-code', { action: 'defer' })).toBe(false);\n203:     expect(routeNeedsMode('sk-doc', undefined)).toBe(false);\n204:     expect(routeNeedsMode('sk-doc', ['defer'])).toBe(false);\n205:   });\n206: });","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/tests/command-attach.vitest.ts, lines 1-206\n1: // ───────────────────────────────────────────────────────────────\n2: // MODULE: Command attach for a hub recommendation\n3: // ───────────────────────────────────────────────────────────────\n4: \n5: // The advisor names the workflow mode a hub would route a prompt to, and\n6: // `attachCommand()` turns that mode into the slash command a reader can type.\n7: // The table it reads is generated from each hub's own command files, so these\n8: // tests assert the properties the generator has to keep — an own-key lookup on\n9: // both levels, and a real command file behind every row — rather than restating\n10: // today's rows, which would drift from the generator instead of catching it.\n11: //\n12: // The deep-loop gate is asserted on its own, because a command offered for a\n13: // prompt that never asked for that effort commits the reader to a long run they\n14: // did not request, and the prompt is the only thing that can tell the two apart.\n15: \n16: import { existsSync } from 'node:fs';\n17: import { join } from 'node:path';\n18: \n19: import { describe, expect, it } from 'vitest';\n20: \n21: import {\n22:   attachCommand,\n23:   DEPTH_WORDING,\n24:   MODE_COMMANDS,\n25:   routeNeedsMode,\n26:   typedCommandForTop,\n27:   typedCommandIn,\n28: } from '../lib/command-attach.js';\n29: import { findAdvisorWorkspaceRoot } from '../lib/utils/workspace-root.js';\n30: import { AdvisorRecommendationSchema } from '../schemas/advisor-tool-schemas.js';\n31: \n32: type ModeCommands = Readonly<Record<string, Readonly<Record<string, string>>>>;\n33: \n34: const REPO_ROOT = findAdvisorWorkspaceRoot(import.meta.dirname);\n35: \n36: // A slash command spelling that also names the file behind it, so a generated row\n37: // can be checked against the command tree rather than against a second copy of\n38: // itself.\n39: const COMMAND_ID = /^\\/([a-z][a-z0-9-]*):([a-z0-9-]+)$/;\n40: \n41: // The only route shape that can name a command unambiguously: one decision, one\n42: // selected target, so the target's mode is the answer.\n43: function singleRoute(workflowMode: string, overrides: Record<string, unknown> = {}): Record<string, unknown> {\n44:   return { action: 'route', selectionKind: 'single', targets: [{ workflowMode }], ...overrides };\n45: }\n46: \n47: // Distinct from what the generated table holds for the same hub and mode, so a\n48: // passing assertion proves the injected table was read rather than the real one.\n49: const INJECTED_COMMAND = '/injected:readme';\n50: const INJECTED: ModeCommands = { 'sk-doc': { 'sk-create-readme': INJECTED_COMMAND } };\n51: const OTHER_HUB: ModeCommands = { 'made-up-hub': { 'made-up-mode': '/made-up:command' } };\n52: \n53: // Wording that names a topic without asking for effort: no phrase in the effort\n54: // vocabulary, and no typed slash command.\n55: const PLAIN_PROMPT = 'how does the routing table pick a skill';\n56: \n57: describe('command attach for a single routed mode', () => {\n58:   it('names the command the routed mode maps to', () => {\n59:     // Any generated hub except the gated one, read at test time so the case\n60:     // follows a regenerated table instead of pinning one of its rows.\n61:     const generated = Object.entries(MODE_COMMANDS).find(([hub]) => hub !== 'system-deep-loop');\n62:     expect(generated, 'the generated table names a hub outside the depth gate').toBeDefined();\n63:     const [hub, modes] = generated as [string, Readonly<Record<string, string>>];\n64:     const [mode, command] = Object.entries(modes)[0] as [string, string];\n65:     expect(command).toBeTypeOf('string');\n66: \n67:     expect(attachCommand(hub, singleRoute(mode), 'add a readme')).toBe(command);\n68: \n69:     expect(attachCommand('sk-doc', singleRoute('sk-create-readme'), 'anything', INJECTED)).toBe(INJECTED_COMMAND);\n70:     expect(attachCommand('made-up-hub', singleRoute('made-up-mode'), 'anything', OTHER_HUB)).toBe('/made-up:command');\n71:   });\n72: \n73:   it('offers no command unless the route names exactly one mode the table holds', () => {\n74:     const rows: Array<[string, string, unknown]> = [\n75:       ['a multi-selection route', 'sk-doc', {\n76:         action: 'route', selectionKind: 'multi', targets: [{ workflowMode: 'sk-create-readme' }],\n77:       }],\n78:       ['an ask decision', 'sk-doc', {\n79:         action: 'ask', selectionKind: 'single', targets: [{ workflowMode: 'sk-create-readme' }],\n80:       }],\n81:       ['a route with two targets', 'sk-doc', {\n82:         action: 'route',\n83:         selectionKind: 'single',\n84:         targets: [{ workflowMode: 'sk-create-readme' }, { workflowMode: 'sk-create-benchmark' }],\n85:       }],\n86:       ['a mode the table does not hold', 'sk-doc', singleRoute('sk-create-benchmark')],\n87:       ['a hub the table does not hold', 'sk-git', singleRoute('sk-create-readme')],\n88:       ['no route at all', 'sk-doc', null],\n89:       ['a route that is an array', 'sk-doc', [singleRoute('sk-create-readme')]],\n90:       // An inherited name such as `constructor` is never a command the hub\n91:       // declared, so the lookup must read own keys at both levels.\n92:       ['a mode named after an inherited key', 'sk-doc', singleRoute('constructor')],\n93:       ['a hub named after an inherited key', 'constructor', singleRoute('sk-create-readme')],\n94:     ];\n95: \n96:     for (const [label, skillId, compiledRoute] of rows) {\n97:       expect(attachCommand(skillId, compiledRoute, PLAIN_PROMPT, INJECTED), label).toBeUndefined();\n98:     }\n99:     expect(attachCommand('constructor', singleRoute('constructor'), PLAIN_PROMPT), 'both levels inherited').toBeUndefined();\n100:   });\n101: \n102:   it('offers a deep-loop command only when the prompt asks for that effort', () => {\n103:     const plainIsQuiet = DEPTH_WORDING.every((phrase) => !PLAIN_PROMPT.toLowerCase().includes(phrase));\n104:     expect(plainIsQuiet, 'the effort-free probe prompt mentions no effort wording').toBe(true);\n105: \n106:     const modes = Object.entries(MODE_COMMANDS['system-deep-loop']);\n107:     expect(modes.length).toBeGreaterThan(0);\n108:     const [effortPhrase] = DEPTH_WORDING;\n109:     expect(effortPhrase).toBeTruthy();\n110: \n111:     for (const [mode, command] of modes) {\n112:       const route = singleRoute(mode);\n113:       expect(attachCommand('system-deep-loop', route, PLAIN_PROMPT), mode).toBeUndefined();\n114:       expect(attachCommand('system-deep-loop', route, `explain the scorer ${effortPhrase}`), mode).toBe(command);\n115:       expect(attachCommand('system-deep-loop', route, `run ${command} for me`), mode).toBe(command);\n116:     }\n117: \n118:     // The gate belongs to the deep-loop hub alone: every other hub answers the\n119:     // same effort-free prompt with its command.\n120:     expect(attachCommand('sk-doc', singleRoute('sk-create-benchmark'), PLAIN_PROMPT, INJECTED)).toBeUndefined();\n121:     expect(attachCommand('sk-doc', singleRoute('sk-create-readme'), PLAIN_PROMPT, INJECTED)).toBe(INJECTED_COMMAND);\n122:   });\n123: \n124:   it('stays quiet when a prompt only names a deep-loop mode by its topic', () => {\n125:     const topicOnly: ReadonlyArray<readonly [string, string]> = [\n126:       ['ai-council', 'What does the AI council mode do?'],\n127:       ['research', 'what is research mode?'],\n128:       ['review', 'how does the review mode work?'],\n129:     ];\n130:     for (const [mode, prompt] of topicOnly) {\n131:       expect(MODE_COMMANDS['system-deep-loop'], mode).toHaveProperty(mode);\n132:       expect(attachCommand('system-deep-loop', singleRoute(mode), prompt), prompt).toBeUndefined();\n133:     }\n134:     expect(attachCommand('system-deep-loop', singleRoute('ai-council'), 'ask the council whether to split billing'))\n135:       .toBe(MODE_COMMANDS['system-deep-loop']['ai-council']);\n136:   });\n137: \n138:   it('names a real command file behind every generated row', () => {\n139:     const hubs = Object.keys(MODE_COMMANDS);\n140:     expect(hubs.length).toBeGreaterThan(0);\n141: \n142:     for (const hub of hubs) {\n143:       const modes = Object.entries(MODE_COMMANDS[hub]);\n144:       expect(modes.length, hub).toBeGreaterThan(0);\n145:       for (const [mode, command] of modes) {\n146:         const label = `${hub} ${mode}: ${command}`;\n147:         const match = command.match(COMMAND_ID);\n148:         expect(match, label).not.toBeNull();\n149:         const [, namespace, name] = match as RegExpMatchArray;\n150:         expect(existsSync(join(REPO_ROOT, '.skilled', 'commands', namespace, `${name}.md`)), label).toBe(true);\n151:       }\n152:     }\n153:   });\n154: \n155:   it('accepts a named command on a recommendation and refuses an empty one', () => {\n156:     // Only the schema's required keys, so the object proves the command field is\n157:     // the one under test rather than something an unrelated field satisfied.\n158:     const minimal = {\n159:       skillId: 'sk-create-readme',\n160:       score: 1,\n161:       confidence: 0.9,\n162:       uncertainty: 0.1,\n163:       dominantLane: null,\n164:     };\n165: \n166:     expect(AdvisorRecommendationSchema.safeParse(minimal).success).toBe(true);\n167:     expect(AdvisorRecommendationSchema.safeParse({ ...minimal, command: '/create:readme' }).success).toBe(true);\n168:     expect(AdvisorRecommendationSchema.safeParse({ ...minimal, command: '' }).success).toBe(false);\n169:   });\n170: });\n171: \n172: // A typed command is the reader's own wording, so the match runs on boundaries\n173: // and prefers the longest key, and it is delivered only through the skill that\n174: // owns it or through a recommendation carrying the same command row.\n175: describe('typed command on the leading recommendation', () => {\n176:   it('reads the longest typed command at a command boundary', () => {\n177:     expect(typedCommandIn('/create:skill-parent deploy-hub with three modes')).toBe('/create:skill-parent');\n178:     expect(typedCommandIn('/create:sk')).toBeUndefined();\n179:     expect(typedCommandIn('see docs/create:goal.md')).toBeUndefined();\n180:   });\n181: \n182:   it('delivers a typed command through its owner or through the same command row', () => {\n183:     const expected = { command: '/speckit:resume', policy: 'start', ownerSkillId: 'system-spec-kit' };\n184: \n185:     expect(typedCommandForTop('system-spec-kit', '/speckit:resume cache work')).toEqual(expected);\n186:     expect(typedCommandForTop('command-speckit-resume', '/speckit:resume cache work')).toEqual(expected);\n187:     expect(typedCommandForTop('sk-doc', '/speckit:resume cache work')).toBeUndefined();\n188:   });\n189: });\n190: \n191: // A route that holds back its command for want of a single mode is worth saying\n192: // out loud, but only for a hub that had a command to withhold, so the flag does\n193: // not fire for a deferral that never named a mode in the first place.\n194: describe('a route that waits for a mode', () => {\n195:   it('flags a defer or clarify on a hub whose modes map to commands', () => {\n196:     expect(routeNeedsMode('system-deep-loop', { action: 'defer' })).toBe(true);\n197:     expect(routeNeedsMode('sk-doc', { action: 'clarify' })).toBe(true);\n198:   });\n199: \n200:   it('stays quiet for a routed mode, a hub outside the table and a shape that is no route', () => {\n201:     expect(routeNeedsMode('sk-doc', singleRoute('sk-create-readme'))).toBe(false);\n202:     expect(routeNeedsMode('sk-code', { action: 'defer' })).toBe(false);\n203:     expect(routeNeedsMode('sk-doc', undefined)).toBe(false);\n204:     expect(routeNeedsMode('sk-doc', ['defer'])).toBe(false);\n205:   });\n206: });"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/tests/command-attach.vitest.ts\"}"},"time":{"start":1794558686766,"end":1794558687687}}}}
{"type":"step_finish","timestamp":1794558691097,"sessionID":"ses_e2bf947b9ffe73zBWlC0D8WZq4","part":{"id":"prt_1d4088719001xgDpn4T7auA1HC","sessionID":"ses_e2bf947b9ffe73zBWlC0D8WZq4","messageID":"msg_1d408641f001TAHD1ul7IUNRzt","type":"step-finish","reason":"tool-calls","snapshot":"f3477bff8d9cc1c8f011cd7c752e541fcf33f27b","cost":0,"tokens":{"input":1119,"output":151,"reasoning":47,"cache":{"read":60416,"write":0}}}}
{"type":"step_start","timestamp":1794558694308,"sessionID":"ses_e2bf947b9ffe73zBWlC0D8WZq4","part":{"id":"prt_1d40893a4001rvDWXxSo2otj59","sessionID":"ses_e2bf947b9ffe73zBWlC0D8WZq4","messageID":"msg_1d4088720001Jp9z760KIdsL0e","type":"step-start","snapshot":"aabb5e4c1752bd699385e61c900107c3af411791"}}
{"type":"tool_use","timestamp":1794558712458,"sessionID":"ses_e2bf947b9ffe73zBWlC0D8WZq4","part":{"partID":"prt_1d408d9a3002pqNXWqLWL30eGn","sessionID":"ses_e2bf947b9ffe73zBWlC0D8WZq4","messageID":"msg_1d4088720001Jp9z760KIdsL0e","type":"tool","id":"call_a980220d801144ba9ae3c4ad","tool":"skill","state":{"status":"completed","input":{"id":"sk-code"},"output":"<skill_content name=\"sk-code\">\n# Skill: sk-code\n\n<!-- Keywords: sk-code, code, surface-aware, two-axis, opencode, typescript, python, shell, json, jsonc, github-actions, ci-workflow, sk-code-quality, sk-code-review, sk-code-ci, sk-code-frontend, quality, code-review, verification, debug, implement, workflow-doctrine, mode-registry, workflowmode, packetkind, backendkind, surface-router, evidence-base, surface-packet, guard, adapter, stderr, detector -->\n\n# Code Family Hub (sk-code)\n\nOne skill has two axes, one shared surface-detection router and one advisor identity.\nThe **workflow axis** has two code modes that act: sk-code-quality and sk-code-review.\nThe **surface axis** has three read-only evidence packets the hub bundles alongside a workflow mode: sk-code-ci, sk-code-frontend and sk-code-skilled.\nEach packet carries the shared **implement → debug → verify** workflow doctrine (`shared/references/workflow-*.md`, symlinked in) plus its own domain knowledge.\nThis hub holds NO per-mode logic. It routes by `workflowMode` through `mode-registry.json`, and each mode or surface keeps its own contract in its packet.\n\n**Version authority.** This file's `version` frontmatter is the hub's release version and matches the newest entry under `changelog/`.\n`description.json`, `mode-registry.json` and `hub-router.json` carry the same value. Each hub-root JSON routing file therefore states the same release.\n`ROUTER.md` and `README.md` keep their own document versions, as the frontmatter-versioning standard gives every doc but `SKILL.md`.\nThe authority stops at the hub root. Each `modes[]` packet carries its own version and release cadence.\nA packet version is independent of this one by design, so a gap between them is not drift.\n\n---\n\n## 1. WHEN TO USE\n\nUse this skill for code-family workflows. Invoke it as `sk-code` with an optional mode hint such as `quality: <request>`. The hub classifies the request, resolves a mode key, and loads the matching nested packet.\n\n**Workflow axis** (modes that act, one of them chosen as primary):\n\n| Mode | Use it for | Packet |\n|------|------------|--------|\n| **sk-code-quality** | Quality gate, P0/P1/P2 author checks, comment hygiene and surface checklists. | `sk-code/sk-code-quality/` |\n| **sk-code-review** | Findings-first review, security and correctness baseline, checklists, output contract and PR-state gates. | `sk-code/sk-code-review/` |\n\n**Surface axis** (read-only, advisor-invisible evidence. When a workflow mode scores, the hub bundles the surface after that primary mode. When no workflow mode scores, the hub routes the surface alone for a lookup, implement, debug or verify task, and the acting agent hands the author gates to `sk-code-quality` before it claims completion):\n\n| Surface | Carries | Packet |\n|---------|---------|--------|\n| **sk-code-ci** | GitHub Actions evidence: trigger, filter, permission, timeout, concurrency and caching rules, the protected set, the intentional message-contract exception and the scaffold templates, with the repository-specific values read from a CI profile. Read-only. | `sk-code/sk-code-ci/` |\n| **sk-code-frontend** | Stack-agnostic frontend evidence: web markup and CSS, web layout and accessibility, visual values, visual hierarchy and review, motion and interaction, the `tokens.css` starter tokens and Figma-to-code checks. Read-only. | `sk-code/sk-code-frontend/` |\n| **sk-code-skilled** | System-code evidence: TypeScript/Python/shell/config standards, hooks, alignment verification, authoring checklists. Bundles the implement → debug → verify workflow doctrine (read-only evidence) for the Skilled surface, and the acting agent applies it. | `sk-code/sk-code-skilled/` |\n\n**Surface list.** The hub has exactly three surfaces:\n- SKILLED (`sk-code-skilled`): the native surface for this framework's own code.\n- CI (`sk-code-ci`): the GitHub Actions workflow standards surface.\n- Frontend (`sk-code-frontend`): the stack-agnostic web practice and Figma-to-code surface, with visual values, visual hierarchy and review, and motion and interaction guidance, bundled from request vocabulary alone.\n\nThe hub also has two workflow modes: quality (`sk-code-quality`) and review (`sk-code-review`).\nAny other sk-code doc that counts surfaces points to this sentence.\n\n### When NOT to Use\n- Documentation-only changes with no code-work contract - use `sk-doc`.\n- Git workflow, branch, commit, PR, merge, or release work - use `sk-git`.\n- Pure browser inspection or external MCP transport work - use the relevant MCP skill.\n- For a measured Style Reference (design tokens extracted from a live source), use `sk-design-md-generator` first.\n- When a request or a frame leaves a visual value open (spacing, type, color, radius, shadow or motion), or a value sits off every token and scale, load `sk-code-frontend` and decide it from its visual-values reference.\n- Backend support primitives in `shared/` - they are consumed by the modes, not invoked as a user workflow.\n\n---\n\n## 2. SMART ROUTING\n\nRouting is **registry-driven at runtime and authored in `hub-router.json`** in two stages.\nStage 1 (hub → mode) uses `hub-router.json` as the authored mode vocabulary. `mode-registry.json` carries the packet contracts, whose aliases are checked against that vocabulary.\nStage 2 (mode → leaves) uses the root [`ROUTER.md`](./ROUTER.md) as the authored leaf-set router.\nBoth files point back here instead of restating the split.\n\nThe advisor routes every code query to the single identity `sk-code`. Resolve the mode with `node .skilled/bin/compiled-route.cjs --hub sk-code --prompt \"<task>\"` and follow the decision: `route` loads its `targets`, `clarify` and `defer` ask, `reject` refuses.\nCompiled routing is the default. The legacy fallback, the kill-switch and the `UNKNOWN_FALLBACK_CHECKLIST` live in the compiled-routing section of [`ROUTER.md`](./ROUTER.md).\n\nA bare implement, debug or verify request with no workflow mode becomes a pure surface bundle, and an unclear code intent asks for disambiguation. Neither path forces a stale default.\nRun the compiled-routing directive in [`ROUTER.md`](./ROUTER.md) before selecting hub resources.\n\n---\n\n## 3. HOW IT WORKS\n\n### Terms\n\n- **`workflowMode`**: the public mode or surface key a request resolves to.\n- **`packetKind`**: the axis a packet sits on, `workflow` for a mode that acts and `surface` for read-only evidence bundled alongside a mode.\n- **`backendKind`**: which backend runs the packet, `surface-router` or `review-cache` for a workflow mode and `evidence-base` for a surface.\n- **`surfaceBundle`**: the `routerPolicy.outcomes` entry where one workflow mode leads and zero or more surfaces follow as evidence.\n- **`mode-registry.json`**: the registry that owns each mode's discriminator, `surfaceDetection` markers and `advisorRouting`.\n- **`hub-router.json`**: stage one's `routerSignals`, `vocabularyClasses` and the surface-bundling policy.\n- **`ROUTER.md`**: stage two's `INTENT_SIGNALS` and `RESOURCE_MAP`, plus the `SHARED_CONTROL_RESOURCES` list and the always-loaded `DEFAULT_RESOURCE` preamble.\n- **shared control**: a hub-level resource declared in `SHARED_CONTROL_RESOURCES`, which resolves on disk and never projects as a leaf.\n- **leaf**: a typed `(workflowMode, leafResourceId)` pair from `leaf-manifest.json` that a `RESOURCE_MAP` path converts to.\n- **surface detection**: the shared detection order over the declared surfaces, which tries each specific surface first, then the `SKILLED` fallback, then `UNKNOWN`.\n- **`--surface-hint`**: the front-door flag that carries the detected surface into the compiled route, so a hinted surface leads a keyword tie.\n- **`UNKNOWN_FALLBACK`**: the load level the router returns, with a disambiguation checklist, when no mode resolves.\n\n### Layout\n```\nsk-code/\n  SKILL.md               # this routing hub (no per-mode code logic)\n  README.md              # human-facing front page for the hub\n  ROUTER.md              # active stage-two surface router and shared-control declaration\n  mode-registry.json     # the two-axis discriminator + advisorRouting contract\n  hub-router.json        # lexical routing signals + surfaceBundle policy for hub-local choice\n  description.json       # hub advisor descriptor\n  graph-metadata.json    # the ONE advisor identity for the whole skill\n  leaf-manifest.json     # typed (workflowMode, leaf) pairs the router guards validate\n  changelog/             # hub release notes, one v<version>.md per hub release\n  feature-catalog/       # current-state inventory of the hub's routing capabilities\n  manual-testing-playbook/  # routing and disambiguation scenarios for the hub\n  benchmark/             # historical routing benchmark inputs and reports\n  sk-code-quality/       # quality mode packet     (workflow)\n  sk-code-review/        # review mode packet      (workflow)\n  sk-code-ci/            # GitHub Actions workflow standards packet (read-only evidence; rules, protected set and scaffold templates)\n  sk-code-frontend/      # stack-agnostic web and Figma-to-code evidence packet (read-only; references/web-visual-values.md, web-visual-hierarchy.md and web-motion-and-interaction.md plus assets/tokens.css)\n  sk-code-skilled/      # skilled surface packet (read-only evidence; carries the workflow doctrine)\n  shared/                # shared surface-detection router, cross-mode helpers, and the implement/debug/verify workflow doctrine (references/workflow-*.md)\n```\n\nEach mode or surface packet is self-contained and carries no per-packet `graph-metadata.json`. Only this hub carries one, so the advisor discovers exactly one code skill identity. The implement/debug/verify workflow doctrine is a single shared source under `shared/references/`, and each surface symlinks it in rather than duplicating it.\n\n### Backend\nThe `surface-router` backend is the shared surface-detection router under `shared/`.\nIt centralizes the detection order over the declared surfaces, the SKILLED fallback and UNKNOWN.\nIt carries the shared implement → debug → verify workflow doctrine consumed by each surface.\nThe `review-cache` backend supports the sk-code-review mode's non-mutating review output cache.\nThe `evidence-base` backend serves the surface packets as read-only domain evidence (`sk-code-ci/`, `sk-code-frontend/`, `sk-code-skilled/`). The hub bundles them alongside the primary mode.\nThe packet mutates nothing and never carries process. The acting agent applies the doctrine it bundles.\nShared backend material provides surface identity, the workflow doctrine and cross-mode helpers.\nIt must never gain per-mode workflow contracts.\n\nThe **implement → debug → verify** phases are not standalone modes.\nTheir surface-agnostic doctrine lives once in `shared/references/workflow-implement.md`, `workflow-debug.md` and `workflow-verify.md`.\nThose files are symlinked into each surface, so the active surface carries the full workflow.\nA request to implement, debug or verify code causes the router to detect its surface and load that surface's bundled doctrine.\nThe acting agent applies that doctrine.\n\n### Maintenance\n\nAfter adding or removing a surface, run `/doctor:sk-code setup`. It checks the hub and names the repair for each failing check.\n\n---\n\n## 4. RULES\n\n### ✅ ALWAYS\n- **ALWAYS** resolve a mode through `mode-registry.json`, and never hardcode a router mapping in the hub.\n- **ALWAYS** keep mode contracts in the mode packets, so the hub stays routing-only.\n- **ALWAYS** keep exactly one `graph-metadata.json` (this hub's) so the advisor sees one skill identity.\n- **ALWAYS** give every mode an `advisorRouting` block with `routingClass: \"metadata\"` and the correct `packetSkillName`.\n- **ALWAYS** keep the implement/debug/verify workflow doctrine as one shared source under `shared/references/`, symlinked into each surface, and never fork per-surface copies.\n- **ALWAYS** keep `ROUTER.md` `RESOURCE_MAP` keys aligned with its intent keys and packet leaves aligned with `leaf-manifest.json`.\n- **ALWAYS** keep hub-shared map inputs explicit in `SHARED_CONTROL_RESOURCES`, because they are control resources and never typed leaves.\n\n### ⛔ NEVER\n- **NEVER** add a `graph-metadata.json` inside a mode packet or `shared/`.\n- **NEVER** put per-mode quality, review, or surface workflow logic in the hub.\n- **NEVER** hardcode a router mapping outside `mode-registry.json`.\n- **NEVER** reintroduce implement, debug, or verify as standalone mode packets, because they are surface-owned doctrine.\n\n### ⚠️ ESCALATE IF\n- A new code mode is needed - extend `mode-registry.json` and open a packet. Do not bolt logic onto the hub.\n- Surface identity and workflow ownership conflict in a way the shared router cannot classify.\n\n---\n\n## 5. REFERENCES\n\n- Workflow mode packets: `sk-code-quality/SKILL.md`, `sk-code-review/SKILL.md`.\n- Surface evidence packets: `sk-code-ci/SKILL.md`, `sk-code-frontend/SKILL.md`, `sk-code-skilled/SKILL.md`.\n- Shared workflow doctrine: `shared/references/workflow-implement.md`, `shared/references/workflow-debug.md`, `shared/references/workflow-verify.md` (symlinked into each surface).\n- Registry: `mode-registry.json` (two-axis: `packetKind` discriminates workflow vs surface).\n- Hub router signals + surface bundling: `hub-router.json`.\n- Surface router and shared controls: `ROUTER.md`.\n- Parent-skill pattern: `.skilled/skills/sk-doc/sk-create-skill/references/parent-skill/parent-skills-nested-packets.md`.\n- Sibling example: `.skilled/skills/sk-prompt/`.\n\nBase directory for this skill: /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.opencode/skills/sk-code\nRelative paths in this skill (e.g., scripts/, reference/) are relative to this base directory.\nNote: file list is sampled.\n\n<skill_files>\n<file>/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.opencode/skills/sk-code/README.md</file>\n<file>/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.opencode/skills/sk-code/ROUTER.md</file>\n<file>/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.opencode/skills/sk-code/benchmark/README.md</file>\n<file>/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.opencode/skills/sk-code/benchmark/reports/2026-06-01--after--router/README.md</file>\n<file>/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.opencode/skills/sk-code/benchmark/reports/2026-06-01--after--router/failed-runs.md</file>\n<file>/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.opencode/skills/sk-code/benchmark/reports/2026-06-01--after--router/findings-and-recommendations.md</file>\n<file>/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.opencode/skills/sk-code/benchmark/reports/2026-06-01--after--router/results.csv</file>\n<file>/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.opencode/skills/sk-code/benchmark/reports/2026-06-01--after--router/skill-benchmark-report.json</file>\n<file>/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.opencode/skills/sk-code/benchmark/reports/2026-06-01--after--router/skill-benchmark-report.md</file>\n<file>/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.opencode/skills/sk-code/benchmark/reports/2026-06-01--after--router/source.md</file>\n</skill_files>\n</skill_content>","title":"skill","metadata":{"metadata":{"name":"sk-code","directory":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.opencode/skills/sk-code","truncated":false},"content":[{"type":"text","text":"<skill_content name=\"sk-code\">\n# Skill: sk-code\n\n<!-- Keywords: sk-code, code, surface-aware, two-axis, opencode, typescript, python, shell, json, jsonc, github-actions, ci-workflow, sk-code-quality, sk-code-review, sk-code-ci, sk-code-frontend, quality, code-review, verification, debug, implement, workflow-doctrine, mode-registry, workflowmode, packetkind, backendkind, surface-router, evidence-base, surface-packet, guard, adapter, stderr, detector -->\n\n# Code Family Hub (sk-code)\n\nOne skill has two axes, one shared surface-detection router and one advisor identity.\nThe **workflow axis** has two code modes that act: sk-code-quality and sk-code-review.\nThe **surface axis** has three read-only evidence packets the hub bundles alongside a workflow mode: sk-code-ci, sk-code-frontend and sk-code-skilled.\nEach packet carries the shared **implement → debug → verify** workflow doctrine (`shared/references/workflow-*.md`, symlinked in) plus its own domain knowledge.\nThis hub holds NO per-mode logic. It routes by `workflowMode` through `mode-registry.json`, and each mode or surface keeps its own contract in its packet.\n\n**Version authority.** This file's `version` frontmatter is the hub's release version and matches the newest entry under `changelog/`.\n`description.json`, `mode-registry.json` and `hub-router.json` carry the same value. Each hub-root JSON routing file therefore states the same release.\n`ROUTER.md` and `README.md` keep their own document versions, as the frontmatter-versioning standard gives every doc but `SKILL.md`.\nThe authority stops at the hub root. Each `modes[]` packet carries its own version and release cadence.\nA packet version is independent of this one by design, so a gap between them is not drift.\n\n---\n\n## 1. WHEN TO USE\n\nUse this skill for code-family workflows. Invoke it as `sk-code` with an optional mode hint such as `quality: <request>`. The hub classifies the request, resolves a mode key, and loads the matching nested packet.\n\n**Workflow axis** (modes that act, one of them chosen as primary):\n\n| Mode | Use it for | Packet |\n|------|------------|--------|\n| **sk-code-quality** | Quality gate, P0/P1/P2 author checks, comment hygiene and surface checklists. | `sk-code/sk-code-quality/` |\n| **sk-code-review** | Findings-first review, security and correctness baseline, checklists, output contract and PR-state gates. | `sk-code/sk-code-review/` |\n\n**Surface axis** (read-only, advisor-invisible evidence. When a workflow mode scores, the hub bundles the surface after that primary mode. When no workflow mode scores, the hub routes the surface alone for a lookup, implement, debug or verify task, and the acting agent hands the author gates to `sk-code-quality` before it claims completion):\n\n| Surface | Carries | Packet |\n|---------|---------|--------|\n| **sk-code-ci** | GitHub Actions evidence: trigger, filter, permission, timeout, concurrency and caching rules, the protected set, the intentional message-contract exception and the scaffold templates, with the repository-specific values read from a CI profile. Read-only. | `sk-code/sk-code-ci/` |\n| **sk-code-frontend** | Stack-agnostic frontend evidence: web markup and CSS, web layout and accessibility, visual values, visual hierarchy and review, motion and interaction, the `tokens.css` starter tokens and Figma-to-code checks. Read-only. | `sk-code/sk-code-frontend/` |\n| **sk-code-skilled** | System-code evidence: TypeScript/Python/shell/config standards, hooks, alignment verification, authoring checklists. Bundles the implement → debug → verify workflow doctrine (read-only evidence) for the Skilled surface, and the acting agent applies it. | `sk-code/sk-code-skilled/` |\n\n**Surface list.** The hub has exactly three surfaces:\n- SKILLED (`sk-code-skilled`): the native surface for this framework's own code.\n- CI (`sk-code-ci`): the GitHub Actions workflow standards surface.\n- Frontend (`sk-code-frontend`): the stack-agnostic web practice and Figma-to-code surface, with visual values, visual hierarchy and review, and motion and interaction guidance, bundled from request vocabulary alone.\n\nThe hub also has two workflow modes: quality (`sk-code-quality`) and review (`sk-code-review`).\nAny other sk-code doc that counts surfaces points to this sentence.\n\n### When NOT to Use\n- Documentation-only changes with no code-work contract - use `sk-doc`.\n- Git workflow, branch, commit, PR, merge, or release work - use `sk-git`.\n- Pure browser inspection or external MCP transport work - use the relevant MCP skill.\n- For a measured Style Reference (design tokens extracted from a live source), use `sk-design-md-generator` first.\n- When a request or a frame leaves a visual value open (spacing, type, color, radius, shadow or motion), or a value sits off every token and scale, load `sk-code-frontend` and decide it from its visual-values reference.\n- Backend support primitives in `shared/` - they are consumed by the modes, not invoked as a user workflow.\n\n---\n\n## 2. SMART ROUTING\n\nRouting is **registry-driven at runtime and authored in `hub-router.json`** in two stages.\nStage 1 (hub → mode) uses `hub-router.json` as the authored mode vocabulary. `mode-registry.json` carries the packet contracts, whose aliases are checked against that vocabulary.\nStage 2 (mode → leaves) uses the root [`ROUTER.md`](./ROUTER.md) as the authored leaf-set router.\nBoth files point back here instead of restating the split.\n\nThe advisor routes every code query to the single identity `sk-code`. Resolve the mode with `node .skilled/bin/compiled-route.cjs --hub sk-code --prompt \"<task>\"` and follow the decision: `route` loads its `targets`, `clarify` and `defer` ask, `reject` refuses.\nCompiled routing is the default. The legacy fallback, the kill-switch and the `UNKNOWN_FALLBACK_CHECKLIST` live in the compiled-routing section of [`ROUTER.md`](./ROUTER.md).\n\nA bare implement, debug or verify request with no workflow mode becomes a pure surface bundle, and an unclear code intent asks for disambiguation. Neither path forces a stale default.\nRun the compiled-routing directive in [`ROUTER.md`](./ROUTER.md) before selecting hub resources.\n\n---\n\n## 3. HOW IT WORKS\n\n### Terms\n\n- **`workflowMode`**: the public mode or surface key a request resolves to.\n- **`packetKind`**: the axis a packet sits on, `workflow` for a mode that acts and `surface` for read-only evidence bundled alongside a mode.\n- **`backendKind`**: which backend runs the packet, `surface-router` or `review-cache` for a workflow mode and `evidence-base` for a surface.\n- **`surfaceBundle`**: the `routerPolicy.outcomes` entry where one workflow mode leads and zero or more surfaces follow as evidence.\n- **`mode-registry.json`**: the registry that owns each mode's discriminator, `surfaceDetection` markers and `advisorRouting`.\n- **`hub-router.json`**: stage one's `routerSignals`, `vocabularyClasses` and the surface-bundling policy.\n- **`ROUTER.md`**: stage two's `INTENT_SIGNALS` and `RESOURCE_MAP`, plus the `SHARED_CONTROL_RESOURCES` list and the always-loaded `DEFAULT_RESOURCE` preamble.\n- **shared control**: a hub-level resource declared in `SHARED_CONTROL_RESOURCES`, which resolves on disk and never projects as a leaf.\n- **leaf**: a typed `(workflowMode, leafResourceId)` pair from `leaf-manifest.json` that a `RESOURCE_MAP` path converts to.\n- **surface detection**: the shared detection order over the declared surfaces, which tries each specific surface first, then the `SKILLED` fallback, then `UNKNOWN`.\n- **`--surface-hint`**: the front-door flag that carries the detected surface into the compiled route, so a hinted surface leads a keyword tie.\n- **`UNKNOWN_FALLBACK`**: the load level the router returns, with a disambiguation checklist, when no mode resolves.\n\n### Layout\n```\nsk-code/\n  SKILL.md               # this routing hub (no per-mode code logic)\n  README.md              # human-facing front page for the hub\n  ROUTER.md              # active stage-two surface router and shared-control declaration\n  mode-registry.json     # the two-axis discriminator + advisorRouting contract\n  hub-router.json        # lexical routing signals + surfaceBundle policy for hub-local choice\n  description.json       # hub advisor descriptor\n  graph-metadata.json    # the ONE advisor identity for the whole skill\n  leaf-manifest.json     # typed (workflowMode, leaf) pairs the router guards validate\n  changelog/             # hub release notes, one v<version>.md per hub release\n  feature-catalog/       # current-state inventory of the hub's routing capabilities\n  manual-testing-playbook/  # routing and disambiguation scenarios for the hub\n  benchmark/             # historical routing benchmark inputs and reports\n  sk-code-quality/       # quality mode packet     (workflow)\n  sk-code-review/        # review mode packet      (workflow)\n  sk-code-ci/            # GitHub Actions workflow standards packet (read-only evidence; rules, protected set and scaffold templates)\n  sk-code-frontend/      # stack-agnostic web and Figma-to-code evidence packet (read-only; references/web-visual-values.md, web-visual-hierarchy.md and web-motion-and-interaction.md plus assets/tokens.css)\n  sk-code-skilled/      # skilled surface packet (read-only evidence; carries the workflow doctrine)\n  shared/                # shared surface-detection router, cross-mode helpers, and the implement/debug/verify workflow doctrine (references/workflow-*.md)\n```\n\nEach mode or surface packet is self-contained and carries no per-packet `graph-metadata.json`. Only this hub carries one, so the advisor discovers exactly one code skill identity. The implement/debug/verify workflow doctrine is a single shared source under `shared/references/`, and each surface symlinks it in rather than duplicating it.\n\n### Backend\nThe `surface-router` backend is the shared surface-detection router under `shared/`.\nIt centralizes the detection order over the declared surfaces, the SKILLED fallback and UNKNOWN.\nIt carries the shared implement → debug → verify workflow doctrine consumed by each surface.\nThe `review-cache` backend supports the sk-code-review mode's non-mutating review output cache.\nThe `evidence-base` backend serves the surface packets as read-only domain evidence (`sk-code-ci/`, `sk-code-frontend/`, `sk-code-skilled/`). The hub bundles them alongside the primary mode.\nThe packet mutates nothing and never carries process. The acting agent applies the doctrine it bundles.\nShared backend material provides surface identity, the workflow doctrine and cross-mode helpers.\nIt must never gain per-mode workflow contracts.\n\nThe **implement → debug → verify** phases are not standalone modes.\nTheir surface-agnostic doctrine lives once in `shared/references/workflow-implement.md`, `workflow-debug.md` and `workflow-verify.md`.\nThose files are symlinked into each surface, so the active surface carries the full workflow.\nA request to implement, debug or verify code causes the router to detect its surface and load that surface's bundled doctrine.\nThe acting agent applies that doctrine.\n\n### Maintenance\n\nAfter adding or removing a surface, run `/doctor:sk-code setup`. It checks the hub and names the repair for each failing check.\n\n---\n\n## 4. RULES\n\n### ✅ ALWAYS\n- **ALWAYS** resolve a mode through `mode-registry.json`, and never hardcode a router mapping in the hub.\n- **ALWAYS** keep mode contracts in the mode packets, so the hub stays routing-only.\n- **ALWAYS** keep exactly one `graph-metadata.json` (this hub's) so the advisor sees one skill identity.\n- **ALWAYS** give every mode an `advisorRouting` block with `routingClass: \"metadata\"` and the correct `packetSkillName`.\n- **ALWAYS** keep the implement/debug/verify workflow doctrine as one shared source under `shared/references/`, symlinked into each surface, and never fork per-surface copies.\n- **ALWAYS** keep `ROUTER.md` `RESOURCE_MAP` keys aligned with its intent keys and packet leaves aligned with `leaf-manifest.json`.\n- **ALWAYS** keep hub-shared map inputs explicit in `SHARED_CONTROL_RESOURCES`, because they are control resources and never typed leaves.\n\n### ⛔ NEVER\n- **NEVER** add a `graph-metadata.json` inside a mode packet or `shared/`.\n- **NEVER** put per-mode quality, review, or surface workflow logic in the hub.\n- **NEVER** hardcode a router mapping outside `mode-registry.json`.\n- **NEVER** reintroduce implement, debug, or verify as standalone mode packets, because they are surface-owned doctrine.\n\n### ⚠️ ESCALATE IF\n- A new code mode is needed - extend `mode-registry.json` and open a packet. Do not bolt logic onto the hub.\n- Surface identity and workflow ownership conflict in a way the shared router cannot classify.\n\n---\n\n## 5. REFERENCES\n\n- Workflow mode packets: `sk-code-quality/SKILL.md`, `sk-code-review/SKILL.md`.\n- Surface evidence packets: `sk-code-ci/SKILL.md`, `sk-code-frontend/SKILL.md`, `sk-code-skilled/SKILL.md`.\n- Shared workflow doctrine: `shared/references/workflow-implement.md`, `shared/references/workflow-debug.md`, `shared/references/workflow-verify.md` (symlinked into each surface).\n- Registry: `mode-registry.json` (two-axis: `packetKind` discriminates workflow vs surface).\n- Hub router signals + surface bundling: `hub-router.json`.\n- Surface router and shared controls: `ROUTER.md`.\n- Parent-skill pattern: `.skilled/skills/sk-doc/sk-create-skill/references/parent-skill/parent-skills-nested-packets.md`.\n- Sibling example: `.skilled/skills/sk-prompt/`.\n\nBase directory for this skill: /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.opencode/skills/sk-code\nRelative paths in this skill (e.g., scripts/, reference/) are relative to this base directory.\nNote: file list is sampled.\n\n<skill_files>\n<file>/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.opencode/skills/sk-code/README.md</file>\n<file>/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.opencode/skills/sk-code/ROUTER.md</file>\n<file>/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.opencode/skills/sk-code/benchmark/README.md</file>\n<file>/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.opencode/skills/sk-code/benchmark/reports/2026-06-01--after--router/README.md</file>\n<file>/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.opencode/skills/sk-code/benchmark/reports/2026-06-01--after--router/failed-runs.md</file>\n<file>/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.opencode/skills/sk-code/benchmark/reports/2026-06-01--after--router/findings-and-recommendations.md</file>\n<file>/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.opencode/skills/sk-code/benchmark/reports/2026-06-01--after--router/results.csv</file>\n<file>/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.opencode/skills/sk-code/benchmark/reports/2026-06-01--after--router/skill-benchmark-report.json</file>\n<file>/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.opencode/skills/sk-code/benchmark/reports/2026-06-01--after--router/skill-benchmark-report.md</file>\n<file>/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.opencode/skills/sk-code/benchmark/reports/2026-06-01--after--router/source.md</file>\n</skill_files>\n</skill_content>"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"id\":\"sk-code\"}"},"time":{"start":1794558712227,"end":1794558712458}}}}
{"type":"step_finish","timestamp":1794558714844,"sessionID":"ses_e2bf947b9ffe73zBWlC0D8WZq4","part":{"id":"prt_1d408e3dc001AWAIXXkiYe3hat","sessionID":"ses_e2bf947b9ffe73zBWlC0D8WZq4","messageID":"msg_1d4088720001Jp9z760KIdsL0e","type":"step-finish","reason":"tool-calls","snapshot":"bee744fc6a81b0df1a40b317e0cf4655b0e06483","cost":0,"tokens":{"input":4996,"output":39,"reasoning":1926,"cache":{"read":61440,"write":0}}}}
{"type":"step_start","timestamp":1794558718373,"sessionID":"ses_e2bf947b9ffe73zBWlC0D8WZq4","part":{"id":"prt_1d408f1a5001QctQttLuHx4EwC","sessionID":"ses_e2bf947b9ffe73zBWlC0D8WZq4","messageID":"msg_1d408e3e1001Z4HGvwPrxTVjvX","type":"step-start","snapshot":"681a95f4afefd1de1d137e0c8e1c3095c775414a"}}
{"type":"tool_use","timestamp":1794558721872,"sessionID":"ses_e2bf947b9ffe73zBWlC0D8WZq4","part":{"partID":"prt_1d408fde9001Sr5inPvvpoHcoQ","sessionID":"ses_e2bf947b9ffe73zBWlC0D8WZq4","messageID":"msg_1d408e3e1001Z4HGvwPrxTVjvX","type":"tool","id":"call_525f6bbbc576408b99b7c999","tool":"read","state":{"status":"completed","input":{"path":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/repo-rules/prevent-overengineering.md"},"output":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/repo-rules/prevent-overengineering.md, lines 1-175\n1: ---\n2: title: \"Rule: Prevent overengineering\"\n3: description: \"Build the smallest thing that solves the stated problem; take a costlier move only by naming what fails at the cheaper one.\"\n4: trigger_phrases:\n5:   - \"restraint ladder\"\n6:   - \"reversal cost order\"\n7:   - \"does this need to exist\"\n8:   - \"build nothing\"\n9:   - \"future proof\"\n10:   - \"might need it later\"\n11:   - \"flexible\"\n12:   - \"best practice\"\n13:   - \"while we're here\"\n14:   - \"premature abstraction\"\n15:   - \"DRY it up\"\n16:   - \"two is not a pattern\"\n17:   - \"speculative optimization\"\n18:   - \"add a config option\"\n19:   - \"add a dependency\"\n20:   - \"feature flag\"\n21:   - \"new abstraction layer\"\n22:   - \"pre-write pass\"\n23:   - \"climbing sentence\"\n24:   - \"fallback for a constraint that does not exist\"\n25:   - \"over-engineering\"\n26: importance_tier: important\n27: contextType: reference\n28: version: 1.0.1.4\n29: ---\n30: \n31: # Rule: Prevent overengineering\n32: \n33: > Routed from [`REPO RULES.md`](../../REPO%20RULES.md). Load before the first write of anything new.\n34: > Expands `AGENTS.md`, never overrides it. Where they appear to disagree, `AGENTS.md` wins and this file is wrong. Say so.\n35: \n36: ## Fires when\n37: \n38: - Adding a file, module, class, interface, abstraction, config option, feature flag, layer, or dependency.\n39: - Writing a spec or plan whose scope adds a file, module, option, layer, or dependency, before that scope is frozen.\n40: - Generalizing something that already works for its one caller.\n41: - Writing or thinking: *flexible*, *future-proof*, *scalable*, *extensible*, *might need*, *best practice*, *while we're here*.\n42: - Adding a test beyond the coverage floor, or wrapping something already callable.\n43: \n44: ## The rule\n45: \n46: **Build the smallest thing that solves the stated problem. Build the bigger thing only\n47: after naming what fails at the smaller one.**\n48: \n49: \"It's cleaner\" is not a failure. \"A future caller might\" is not a failure. A failure\n50: is something that breaks today, for a requirement that exists today.\n51: \n52: ---\n53: \n54: ## 1. THE REVERSAL-COST ORDER\n55: \n56: Start at the cheapest move every time. **Take a costlier one only by writing the sentence\n57: that says what fails at the cheaper one** in the response, not just in your head.\n58: \n59: | Move | Cost when wrong |\n60: |------|-----------------|\n61: | **Build nothing:** existing behavior already meets the requirement | zero |\n62: | Change a value, constant, or config that exists | one line to revert |\n63: | Extend an existing function or module in place | contained to one unit |\n64: | Add a new function beside the existing ones | one new symbol to learn |\n65: | Add a new file or module | a new place readers must look |\n66: | Add an abstraction, interface, or indirection layer | every future reader pays the hop |\n67: | Add a dependency | permanent supply-chain, version and trust surface |\n68: \n69: > **This orders moves by what being wrong costs, and it is deliberately not the numbered\n70: > rung ladder.** For code, the code skill's universal quality standards are the\n71: > authoritative rungs. Route through `sk-code` to reach them. That ladder orders\n72: > *solution sources*: standard library, then native platform, then an installed\n73: > dependency. Two orderings, two axes, one authority: cite rung numbers from that file,\n74: > and cite moves by name from this one. A \"rung 2\" named here would mean something\n75: > different there.\n76: \n77: Building nothing is not a formality: a surprising share of requests are already satisfied\n78: by code that exists, and reading first is what reveals it. The sentence, written out:\n79: \n80: > \"Extending `parseConfig` in place fails, because the CLI and the daemon call it with\n81: > incompatible defaults today, so the change breaks the daemon. Adding a new function\n82: > beside it.\"\n83: \n84: If you cannot write that with a real symbol and a real caller in it, you are reaching\n85: past the move you can justify.\n86: \n87: **A short diff is not a cheaper move when the next reader has to decode it.** A one-liner that packs two decisions into one expression moves the cost to every later reader, who must rebuild the intent before they can check it. When two moves cost the same, the one that handles the edge cases correctly wins.\n88: \n89: ---\n90: \n91: ## 2. THE PRE-WRITE PASS\n92: \n93: After reading the existing code, before the first edit, and before a spec or plan freezes its scope:\n94: \n95: 1. **Does this need to exist?** Walk §1 in order. Answer by naming the move and writing\n96:    its climbing sentence.\n97: 2. **What does it touch?** If the change can break a caller or a shared contract, name\n98:    the owning module, one real caller (`file:line`) and the contract that must not\n99:    break. Then list the tests, fixtures, config and exports the change must reach. No\n100:    real caller means the change is smaller than you think, or the code should not exist\n101:    either.\n102: \n103: ---\n104: \n105: ## 3. TWO SIGNALS `AGENTS.md` DOES NOT CARRY\n106: \n107: Its Restraint Signals table binds and is not repeated here.\n108: \n109: | Signal | What it means | Do this |\n110: |--------|---------------|---------|\n111: | A config option \"so we can change it later\" | a decision deferred into a permanent branch | Hardcode it (§4) |\n112: | A wrapper that only forwards arguments | indirection with no behavior | Call the thing directly |\n113: \n114: ---\n115: \n116: ## 4. SPECIFIC RESTRAINTS\n117: \n118: **Options.** Every option is a permanent branch in the code, a row in the docs, and an\n119: axis in the test matrix. Default to hardcoding. An option earns existence when **two\n120: real callers need different values today**.\n121: \n122: **Abstraction.** One instance is a case, two a coincidence, three a pattern. Abstracting\n123: at two buys a wrong abstraction more often than it saves a duplication.\n124: \n125: **Error handling.** Catch only what you can handle. A `try` that logs and re-raises, or\n126: swallows an exception into a default, converts a loud failure into a silent wrong answer.\n127: \n128: **Defensive checks.** Do not validate what the type system, the caller contract, or the\n129: layer above already guarantees. A null check on something never null tells the next\n130: reader it *is* sometimes null.\n131: \n132: **Tests.** The coverage floor and the earns-its-place bar are `AGENTS.md` §3. The ladder\n133: applies to test code exactly as to the code under test.\n134: \n135: **Performance.** No speculative optimization. Measure under stated conditions and report\n136: baseline and delta, or leave it alone.\n137: \n138: **Fallbacks.** A second code path for a constraint the target environment does not\n139: actually have is an untested branch that will rot. Add the no-install path, the offline\n140: path, or the degraded path only when you can name the environment that needs it. \"In\n141: case\" is not an environment.\n142: \n143: **Dependencies.** Prefer what the project has. A new one also takes the\n144: `blast-radius.md` pass, because installing mutates the environment.\n145: \n146: **Moves and merges.** Moved or merged code keeps its error handling and validation. Dropping a check during a move is a behavior change that needs its own reason.\n147: \n148: ---\n149: \n150: ## 5. WHAT THIS RULE IS NOT\n151: \n152: Restraint constrains *how much you build*, never *how much you deliver*.\n153: \n154: - **Not a license to under-deliver.** \"This part is unnecessary\" never authorizes\n155:   cutting it. Build the frozen scope **and** raise the amendment in the same response.\n156: - **Not a reason to skip real error handling.** A failure mode that happens is not\n157:   speculative.\n158: \n159: - **Not a reason to cut accessibility.** Restraint never cuts accessibility on user-facing UI: interactive elements stay keyboard-operable, carry an accessible name and keep a visible focus state.\n160: \n161: ---\n162: \n163: ## 6. SELF-CHECK\n164: \n165: - [ ] Named the move and wrote the climbing sentence for every move past \"build nothing\".\n166: - [ ] When two moves cost the same, I took the one that handles the edge cases correctly. A shorter diff that the next reader must decode did not count as cheaper.\n167: - [ ] Every new option, abstraction and dependency has a caller that needs it **today**.\n168: - [ ] Nothing is justified only by a future nobody asked for.\n169: - [ ] If I judged part of the scope unnecessary, I built it anyway and said so.\n170: - [ ] Any fallback path I added names the environment that requires it.\n171: - [ ] Where the change touches a caller or a shared contract, I named the owner, one real caller and the contract before editing. I listed the tests, fixtures, config and exports it must reach.\n172: - [ ] Every catch handles what it catches, and no check re-validates what a type or a caller contract already guarantees.\n173: - [ ] Every performance claim carries a measurement, and every new dependency names what the project's own tools could not do.\n174: - [ ] Moved or merged code kept its error handling and validation. Every check dropped during a move has its own stated reason.\n175: - [ ] Restraint did not cut accessibility on user-facing UI, where interactive elements stay keyboard-operable, carry an accessible name and keep a visible focus state.","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/repo-rules/prevent-overengineering.md, lines 1-175\n1: ---\n2: title: \"Rule: Prevent overengineering\"\n3: description: \"Build the smallest thing that solves the stated problem; take a costlier move only by naming what fails at the cheaper one.\"\n4: trigger_phrases:\n5:   - \"restraint ladder\"\n6:   - \"reversal cost order\"\n7:   - \"does this need to exist\"\n8:   - \"build nothing\"\n9:   - \"future proof\"\n10:   - \"might need it later\"\n11:   - \"flexible\"\n12:   - \"best practice\"\n13:   - \"while we're here\"\n14:   - \"premature abstraction\"\n15:   - \"DRY it up\"\n16:   - \"two is not a pattern\"\n17:   - \"speculative optimization\"\n18:   - \"add a config option\"\n19:   - \"add a dependency\"\n20:   - \"feature flag\"\n21:   - \"new abstraction layer\"\n22:   - \"pre-write pass\"\n23:   - \"climbing sentence\"\n24:   - \"fallback for a constraint that does not exist\"\n25:   - \"over-engineering\"\n26: importance_tier: important\n27: contextType: reference\n28: version: 1.0.1.4\n29: ---\n30: \n31: # Rule: Prevent overengineering\n32: \n33: > Routed from [`REPO RULES.md`](../../REPO%20RULES.md). Load before the first write of anything new.\n34: > Expands `AGENTS.md`, never overrides it. Where they appear to disagree, `AGENTS.md` wins and this file is wrong. Say so.\n35: \n36: ## Fires when\n37: \n38: - Adding a file, module, class, interface, abstraction, config option, feature flag, layer, or dependency.\n39: - Writing a spec or plan whose scope adds a file, module, option, layer, or dependency, before that scope is frozen.\n40: - Generalizing something that already works for its one caller.\n41: - Writing or thinking: *flexible*, *future-proof*, *scalable*, *extensible*, *might need*, *best practice*, *while we're here*.\n42: - Adding a test beyond the coverage floor, or wrapping something already callable.\n43: \n44: ## The rule\n45: \n46: **Build the smallest thing that solves the stated problem. Build the bigger thing only\n47: after naming what fails at the smaller one.**\n48: \n49: \"It's cleaner\" is not a failure. \"A future caller might\" is not a failure. A failure\n50: is something that breaks today, for a requirement that exists today.\n51: \n52: ---\n53: \n54: ## 1. THE REVERSAL-COST ORDER\n55: \n56: Start at the cheapest move every time. **Take a costlier one only by writing the sentence\n57: that says what fails at the cheaper one** in the response, not just in your head.\n58: \n59: | Move | Cost when wrong |\n60: |------|-----------------|\n61: | **Build nothing:** existing behavior already meets the requirement | zero |\n62: | Change a value, constant, or config that exists | one line to revert |\n63: | Extend an existing function or module in place | contained to one unit |\n64: | Add a new function beside the existing ones | one new symbol to learn |\n65: | Add a new file or module | a new place readers must look |\n66: | Add an abstraction, interface, or indirection layer | every future reader pays the hop |\n67: | Add a dependency | permanent supply-chain, version and trust surface |\n68: \n69: > **This orders moves by what being wrong costs, and it is deliberately not the numbered\n70: > rung ladder.** For code, the code skill's universal quality standards are the\n71: > authoritative rungs. Route through `sk-code` to reach them. That ladder orders\n72: > *solution sources*: standard library, then native platform, then an installed\n73: > dependency. Two orderings, two axes, one authority: cite rung numbers from that file,\n74: > and cite moves by name from this one. A \"rung 2\" named here would mean something\n75: > different there.\n76: \n77: Building nothing is not a formality: a surprising share of requests are already satisfied\n78: by code that exists, and reading first is what reveals it. The sentence, written out:\n79: \n80: > \"Extending `parseConfig` in place fails, because the CLI and the daemon call it with\n81: > incompatible defaults today, so the change breaks the daemon. Adding a new function\n82: > beside it.\"\n83: \n84: If you cannot write that with a real symbol and a real caller in it, you are reaching\n85: past the move you can justify.\n86: \n87: **A short diff is not a cheaper move when the next reader has to decode it.** A one-liner that packs two decisions into one expression moves the cost to every later reader, who must rebuild the intent before they can check it. When two moves cost the same, the one that handles the edge cases correctly wins.\n88: \n89: ---\n90: \n91: ## 2. THE PRE-WRITE PASS\n92: \n93: After reading the existing code, before the first edit, and before a spec or plan freezes its scope:\n94: \n95: 1. **Does this need to exist?** Walk §1 in order. Answer by naming the move and writing\n96:    its climbing sentence.\n97: 2. **What does it touch?** If the change can break a caller or a shared contract, name\n98:    the owning module, one real caller (`file:line`) and the contract that must not\n99:    break. Then list the tests, fixtures, config and exports the change must reach. No\n100:    real caller means the change is smaller than you think, or the code should not exist\n101:    either.\n102: \n103: ---\n104: \n105: ## 3. TWO SIGNALS `AGENTS.md` DOES NOT CARRY\n106: \n107: Its Restraint Signals table binds and is not repeated here.\n108: \n109: | Signal | What it means | Do this |\n110: |--------|---------------|---------|\n111: | A config option \"so we can change it later\" | a decision deferred into a permanent branch | Hardcode it (§4) |\n112: | A wrapper that only forwards arguments | indirection with no behavior | Call the thing directly |\n113: \n114: ---\n115: \n116: ## 4. SPECIFIC RESTRAINTS\n117: \n118: **Options.** Every option is a permanent branch in the code, a row in the docs, and an\n119: axis in the test matrix. Default to hardcoding. An option earns existence when **two\n120: real callers need different values today**.\n121: \n122: **Abstraction.** One instance is a case, two a coincidence, three a pattern. Abstracting\n123: at two buys a wrong abstraction more often than it saves a duplication.\n124: \n125: **Error handling.** Catch only what you can handle. A `try` that logs and re-raises, or\n126: swallows an exception into a default, converts a loud failure into a silent wrong answer.\n127: \n128: **Defensive checks.** Do not validate what the type system, the caller contract, or the\n129: layer above already guarantees. A null check on something never null tells the next\n130: reader it *is* sometimes null.\n131: \n132: **Tests.** The coverage floor and the earns-its-place bar are `AGENTS.md` §3. The ladder\n133: applies to test code exactly as to the code under test.\n134: \n135: **Performance.** No speculative optimization. Measure under stated conditions and report\n136: baseline and delta, or leave it alone.\n137: \n138: **Fallbacks.** A second code path for a constraint the target environment does not\n139: actually have is an untested branch that will rot. Add the no-install path, the offline\n140: path, or the degraded path only when you can name the environment that needs it. \"In\n141: case\" is not an environment.\n142: \n143: **Dependencies.** Prefer what the project has. A new one also takes the\n144: `blast-radius.md` pass, because installing mutates the environment.\n145: \n146: **Moves and merges.** Moved or merged code keeps its error handling and validation. Dropping a check during a move is a behavior change that needs its own reason.\n147: \n148: ---\n149: \n150: ## 5. WHAT THIS RULE IS NOT\n151: \n152: Restraint constrains *how much you build*, never *how much you deliver*.\n153: \n154: - **Not a license to under-deliver.** \"This part is unnecessary\" never authorizes\n155:   cutting it. Build the frozen scope **and** raise the amendment in the same response.\n156: - **Not a reason to skip real error handling.** A failure mode that happens is not\n157:   speculative.\n158: \n159: - **Not a reason to cut accessibility.** Restraint never cuts accessibility on user-facing UI: interactive elements stay keyboard-operable, carry an accessible name and keep a visible focus state.\n160: \n161: ---\n162: \n163: ## 6. SELF-CHECK\n164: \n165: - [ ] Named the move and wrote the climbing sentence for every move past \"build nothing\".\n166: - [ ] When two moves cost the same, I took the one that handles the edge cases correctly. A shorter diff that the next reader must decode did not count as cheaper.\n167: - [ ] Every new option, abstraction and dependency has a caller that needs it **today**.\n168: - [ ] Nothing is justified only by a future nobody asked for.\n169: - [ ] If I judged part of the scope unnecessary, I built it anyway and said so.\n170: - [ ] Any fallback path I added names the environment that requires it.\n171: - [ ] Where the change touches a caller or a shared contract, I named the owner, one real caller and the contract before editing. I listed the tests, fixtures, config and exports it must reach.\n172: - [ ] Every catch handles what it catches, and no check re-validates what a type or a caller contract already guarantees.\n173: - [ ] Every performance claim carries a measurement, and every new dependency names what the project's own tools could not do.\n174: - [ ] Moved or merged code kept its error handling and validation. Every check dropped during a move has its own stated reason.\n175: - [ ] Restraint did not cut accessibility on user-facing UI, where interactive elements stay keyboard-operable, carry an accessible name and keep a visible focus state."}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/repo-rules/prevent-overengineering.md\"}"},"time":{"start":1794558721514,"end":1794558721872}}}}
{"type":"tool_use","timestamp":1794558721893,"sessionID":"ses_e2bf947b9ffe73zBWlC0D8WZq4","part":{"partID":"prt_1d408fca8001laFYogDIHMim5c","sessionID":"ses_e2bf947b9ffe73zBWlC0D8WZq4","messageID":"msg_1d408e3e1001Z4HGvwPrxTVjvX","type":"tool","id":"call_46c4bb4ceac242cfacdec820","tool":"read","state":{"status":"completed","input":{"path":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/sk-code/shared/references/workflow-verify.md"},"output":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/sk-code/shared/references/workflow-verify.md, lines 1-177\n1: ---\n2: title: Workflow Reference - Verification\n3: description: Shared sk-code doctrine for the final non-mutating evidence phase that gates every done, works, complete, fixed, passing or ready claim.\n4: trigger_phrases:\n5:   - \"sk-code verification workflow\"\n6:   - \"verify workflow doctrine\"\n7:   - \"falsifier discipline\"\n8:   - \"completion claim gate\"\n9: importance_tier: important\n10: contextType: general\n11: version: 2.2.7.0\n12: ---\n13: \n14: # Workflow Reference - Verification\n15: \n16: Open this before you claim a change is finished, and when you need a falsifier that could disprove it.\n17: \n18: ---\n19: \n20: ## 1. OVERVIEW\n21: \n22: ### Purpose\n23: \n24: Verification owns evidence, not fixes. It runs fresh surface-appropriate commands, records the outcomes, compares them against the implementation baseline, names the blind spots and claims only what the evidence proves. When verification fails, it hands back to debugging, implementation or quality without editing.\n25: \n26: ### When to Use\n27: \n28: - Verifying work after implementation, quality checks or debugging.\n29: - Running final commands before a done, works, complete, fixed, passing or ready claim.\n30: - Collecting evidence for active-surface behavior or system-code changes.\n31: - Reporting the delta from the baseline captured before implementation.\n32: - Running a mutation check or claim falsifier after a green result.\n33: - Walking the verification ladder and naming each rung's blind spot.\n34: \n35: ### When Not to Use\n36: \n37: - The task needs code written, files scaffolded or behavior changed. Use [implementation](./workflow-implement.md).\n38: - The task is author-side quality cleanup. Use the `sk-code-quality` mode.\n39: - Verification finds a defect that needs root-cause repair. Use [debugging](./workflow-debug.md).\n40: - The user wants findings-first review output or PR-style critique. Use the `sk-code-review` mode.\n41: - The active surface and verification command set are unknown. Ask for them before claiming anything.\n42: \n43: ### Iron Law\n44: \n45: **Iron Law**: no completion claim without fresh surface-appropriate verification evidence.\n46: \n47: A clean static read is not runtime evidence. A green unit test is not live proof. A successful build is not exercised behavior. One exercised path is not full regression coverage. Name the rung you reached and its blind spot.\n48: \n49: ---\n50: \n51: ## 2. WORKFLOW\n52: \n53: ### Verification Loop\n54: \n55: 1. Resolve the active surface through [stack-detection.md](../../shared/references/stack-detection.md). If it is unsupported or ambiguous, ask for the verification command set before claiming anything. The quality config, `repository/quality.json` in the `sk-code-quality` packet, names quality checks only, so it never supplies the verification command set.\n56: 2. Read the implementation, quality or debug handoff for the intended behavior, changed scope, baseline and accepted risks.\n57:    - From the quality envelope, read the `checker_outputs` field with the `gate` and `unverified` values it carries, and any field that still reads `PENDING_AGENT_JUDGMENT`.\n58:    - Hand back to quality only on `BLOCKED`, `ERROR` or a field still reading `PENDING_AGENT_JUDGMENT`, which is the 3 to 1.5 transition in [phase-detection.md](../../shared/references/phase-detection.md).\n59:    - On `UNVERIFIED`, prove each id it lists with this phase's own command or report that id open.\n60:    - On `NOTHING_CHECKED`, prove the claim with this phase's own commands and never read the gate as clean, because no check read any file as code, which is where a Markdown-only change lands.\n61:    - The run verdict has three readers: this step, the @code RETURN `Quality Gate` field and `sk-code-review`, which reads it as input evidence only.\n62: 3. Name the claim to prove and the command, action or observation that proves it.\n63: 4. Select the surface-appropriate command set and targeted tests from the active-surface guidance.\n64: 5. Run fresh commands and capture the command names, exit codes, test counts, important output and failures.\n65: 6. Add end-to-end, runtime or performance evidence when the claim depends on behavior outside static checks.\n66: 7. Compare the current evidence to the baseline and report the delta.\n67: 8. Run a mutation check or claim falsifier when the claim depends on a new or changed test.\n68: 9. Walk the Pre-Claim Gate below, then state only the claims the evidence proves. If the evidence fails, hand back without editing.\n69: \n70: ### Baseline And Delta\n71: \n72: Verification compares against the baseline whenever it states a no-regressions or improvement claim.\n73: \n74: | Field | Required Content |\n75: | --- | --- |\n76: | Baseline | Starting command status, failing tests, warning count, runtime issue, performance number or `UNKNOWN` when no baseline was captured. |\n77: | Current | Fresh output from the whole gate, not only the subset you iterated on: exit codes, test counts, runtime observations or measured numbers. |\n78: | Delta | What changed, improved, regressed or remains unproven, including the parts that did not move. |\n79: | Claim Scope | The exact claim the evidence supports and the blind spot that remains. |\n80: \n81: No baseline means no broad no-regressions claim. A narrower claim tied to fresh evidence still stands.\n82: \n83: The baseline floor belongs to `.skilled/repo-rules/evidence-and-proof.md` section 5 (BASELINES). This table is the sk-code record shape for it. Implementation records its Baseline row before the first edit.\n84: \n85: ### Verification Ladder\n86: \n87: Climb from the cheapest rung to the most authoritative and name what each rung cannot see:\n88: \n89: | Rung | Proves | Blind Spot |\n90: | --- | --- | --- |\n91: | Unit | Isolated logic or assertion path | Integration, wiring, real I/O, runtime state |\n92: | In-memory | Multiple modules without external runtime | Real file system, serialization, deployed config, external state |\n93: | On-server | Runtime service or local server path | Deployment differences, caches, real user environment |\n94: | Live | Exact exercised path in real target | Unexercised paths, other users, other environments, future data |\n95: \n96: ### Mutation Check And Claim Falsifier\n97: \n98: After green evidence for a new or modified test, confirm the test can fail for the right reason when that is feasible. A true red result is an assertion failing against the intended behavior. A compile error, or a command that never reached the assertion, is not a satisfying red. If a test stays green after the guarded behavior is broken, report it as a verification defect and hand back.\n99: \n100: This applies the idea behind `.skilled/repo-rules/evidence-and-proof.md` section 4 (THE NEGATIVE CONTROL): a check that passes whether or not the behavior works proves nothing. The before-fix half of that control, reproducing the failure with the same check, is step 2 of the [Debug Loop](./workflow-debug.md#debug-loop).\n101: \n102: ### Pre-Claim Gate Substance\n103: \n104: Walk every gate in order before any status claim:\n105: \n106: | Gate | Required Discipline |\n107: | --- | --- |\n108: | Identify | Name the command, action or observation that proves the claim. |\n109: | Run | Execute the surface-appropriate verification commands in the current session. |\n110: | Test | Exercise targeted unit, integration, end-to-end, runtime or manual checks where available, including at least one edge case and one error path. |\n111: | Verify | Confirm the output, exit code, test count and observed behavior match expectations, and that the run reached the changed code on a fresh build with real assertions. |\n112: | Record | Save the exact evidence the final claim rests on. |\n113: | Reread | Reread the request and its amendments, and confirm each outcome it asks for is backed by recorded evidence or named as not done. |\n114: | Claim | State only the narrow claim the evidence supports. |\n115: \n116: The Verify row guards against the four ways a green run lies, which `.skilled/repo-rules/evidence-and-proof.md` section 3 lists: it did not run, it ran on the wrong thing, it ran on stale artifacts or it asserted nothing.\n117: \n118: ### OpenCode Verification Reality\n119: \n120: For system code under `.skilled/` (the `sk-code-skilled` surface), also apply the [verification reality](../../sk-code-skilled/references/shared/workflow-guardrails.md#3-verification-reality), including the `validate.sh` pointer, and the [runtime build traps](../../sk-code-skilled/references/shared/workflow-guardrails.md#4-runtime-build-traps).\n121: \n122: ---\n123: \n124: ## 3. DISCIPLINE\n125: \n126: ### Always\n127: \n128: - Always run fresh verification in the current session before a completion-related claim.\n129: - Always resolve surface identity before selecting commands.\n130: - Always record command names, exit codes, key output, test counts and runtime observations.\n131: - Always report the baseline, current result, delta and claim scope for a no-regressions or improvement claim.\n132: - Always name the verification ladder rung reached and the blind spot that remains.\n133: - Always include behavior evidence when runtime behavior changed and tooling is available.\n134: - Always hand back when verification finds a defect.\n135: - Always confirm the diff scope matches the stated change, with no accidental extras or debug residue.\n136: - Always compare warnings against the last working state, so a new warning is reported and not absorbed.\n137: \n138: ### Never\n139: \n140: - Never edit or create files during verification.\n141: - Never dispatch subagents from verification.\n142: - Never claim done, works, complete, fixed, passing or ready from unrun commands.\n143: - Never claim no regressions without a baseline and a delta.\n144: - Never treat one green rung as proof of a higher rung.\n145: - Never hide a failed or skipped verifier behind a positive summary.\n146: - Never invent runtime, test or performance evidence.\n147: - Never verify against stale build output. Clean and rebuild first when an artifact is suspect.\n148: - Never present a check run in one environment as proof for every environment.\n149: \n150: ### Escalate If\n151: \n152: - The surface or the required verification command set is unknown.\n153: - A required verifier path is missing or unsafe to run.\n154: - Commands contradict each other on a blocking outcome.\n155: - Runtime evidence is required but unavailable and the claim would mislead without it.\n156: - The baseline is missing and the requested claim needs a regression comparison.\n157: - A mutation check shows the test is vacuous.\n158: \n159: ---\n160: \n161: ## 4. HANDOFF BOUNDARIES\n162: \n163: - [Debugging](./workflow-debug.md) receives reproducible verification failures, failed commands, broken runtime checks or vacuous tests.\n164: - [Implementation](./workflow-implement.md) receives the handback when required behavior is missing or build work is incomplete.\n165: - Quality (`sk-code-quality`) receives the handback when author-side checks, comment hygiene or checklist issues block verification.\n166: - Review (`sk-code-review`) owns critique when the user wants findings instead of final evidence.\n167: \n168: Verification is ready to report only when it ran last, used only non-mutating actions, recorded fresh active-surface evidence, compared against the baseline when the claim needed it, named its blind spots and handed back any defect without editing.\n169: \n170: ---\n171: \n172: ## 5. RELATED RESOURCES\n173: \n174: - [workflow-implement.md](./workflow-implement.md) - the build phase whose baseline and handoff this phase reads.\n175: - [workflow-debug.md](./workflow-debug.md) - the repair phase that receives every failed verification.\n176: - [stack-detection.md](../../shared/references/stack-detection.md) - surface detection, which decides the command set.\n177: - [workflow-guardrails.md](../../sk-code-skilled/references/shared/workflow-guardrails.md) - the verification command chain for system code under `.skilled/`.","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/sk-code/shared/references/workflow-verify.md, lines 1-177\n1: ---\n2: title: Workflow Reference - Verification\n3: description: Shared sk-code doctrine for the final non-mutating evidence phase that gates every done, works, complete, fixed, passing or ready claim.\n4: trigger_phrases:\n5:   - \"sk-code verification workflow\"\n6:   - \"verify workflow doctrine\"\n7:   - \"falsifier discipline\"\n8:   - \"completion claim gate\"\n9: importance_tier: important\n10: contextType: general\n11: version: 2.2.7.0\n12: ---\n13: \n14: # Workflow Reference - Verification\n15: \n16: Open this before you claim a change is finished, and when you need a falsifier that could disprove it.\n17: \n18: ---\n19: \n20: ## 1. OVERVIEW\n21: \n22: ### Purpose\n23: \n24: Verification owns evidence, not fixes. It runs fresh surface-appropriate commands, records the outcomes, compares them against the implementation baseline, names the blind spots and claims only what the evidence proves. When verification fails, it hands back to debugging, implementation or quality without editing.\n25: \n26: ### When to Use\n27: \n28: - Verifying work after implementation, quality checks or debugging.\n29: - Running final commands before a done, works, complete, fixed, passing or ready claim.\n30: - Collecting evidence for active-surface behavior or system-code changes.\n31: - Reporting the delta from the baseline captured before implementation.\n32: - Running a mutation check or claim falsifier after a green result.\n33: - Walking the verification ladder and naming each rung's blind spot.\n34: \n35: ### When Not to Use\n36: \n37: - The task needs code written, files scaffolded or behavior changed. Use [implementation](./workflow-implement.md).\n38: - The task is author-side quality cleanup. Use the `sk-code-quality` mode.\n39: - Verification finds a defect that needs root-cause repair. Use [debugging](./workflow-debug.md).\n40: - The user wants findings-first review output or PR-style critique. Use the `sk-code-review` mode.\n41: - The active surface and verification command set are unknown. Ask for them before claiming anything.\n42: \n43: ### Iron Law\n44: \n45: **Iron Law**: no completion claim without fresh surface-appropriate verification evidence.\n46: \n47: A clean static read is not runtime evidence. A green unit test is not live proof. A successful build is not exercised behavior. One exercised path is not full regression coverage. Name the rung you reached and its blind spot.\n48: \n49: ---\n50: \n51: ## 2. WORKFLOW\n52: \n53: ### Verification Loop\n54: \n55: 1. Resolve the active surface through [stack-detection.md](../../shared/references/stack-detection.md). If it is unsupported or ambiguous, ask for the verification command set before claiming anything. The quality config, `repository/quality.json` in the `sk-code-quality` packet, names quality checks only, so it never supplies the verification command set.\n56: 2. Read the implementation, quality or debug handoff for the intended behavior, changed scope, baseline and accepted risks.\n57:    - From the quality envelope, read the `checker_outputs` field with the `gate` and `unverified` values it carries, and any field that still reads `PENDING_AGENT_JUDGMENT`.\n58:    - Hand back to quality only on `BLOCKED`, `ERROR` or a field still reading `PENDING_AGENT_JUDGMENT`, which is the 3 to 1.5 transition in [phase-detection.md](../../shared/references/phase-detection.md).\n59:    - On `UNVERIFIED`, prove each id it lists with this phase's own command or report that id open.\n60:    - On `NOTHING_CHECKED`, prove the claim with this phase's own commands and never read the gate as clean, because no check read any file as code, which is where a Markdown-only change lands.\n61:    - The run verdict has three readers: this step, the @code RETURN `Quality Gate` field and `sk-code-review`, which reads it as input evidence only.\n62: 3. Name the claim to prove and the command, action or observation that proves it.\n63: 4. Select the surface-appropriate command set and targeted tests from the active-surface guidance.\n64: 5. Run fresh commands and capture the command names, exit codes, test counts, important output and failures.\n65: 6. Add end-to-end, runtime or performance evidence when the claim depends on behavior outside static checks.\n66: 7. Compare the current evidence to the baseline and report the delta.\n67: 8. Run a mutation check or claim falsifier when the claim depends on a new or changed test.\n68: 9. Walk the Pre-Claim Gate below, then state only the claims the evidence proves. If the evidence fails, hand back without editing.\n69: \n70: ### Baseline And Delta\n71: \n72: Verification compares against the baseline whenever it states a no-regressions or improvement claim.\n73: \n74: | Field | Required Content |\n75: | --- | --- |\n76: | Baseline | Starting command status, failing tests, warning count, runtime issue, performance number or `UNKNOWN` when no baseline was captured. |\n77: | Current | Fresh output from the whole gate, not only the subset you iterated on: exit codes, test counts, runtime observations or measured numbers. |\n78: | Delta | What changed, improved, regressed or remains unproven, including the parts that did not move. |\n79: | Claim Scope | The exact claim the evidence supports and the blind spot that remains. |\n80: \n81: No baseline means no broad no-regressions claim. A narrower claim tied to fresh evidence still stands.\n82: \n83: The baseline floor belongs to `.skilled/repo-rules/evidence-and-proof.md` section 5 (BASELINES). This table is the sk-code record shape for it. Implementation records its Baseline row before the first edit.\n84: \n85: ### Verification Ladder\n86: \n87: Climb from the cheapest rung to the most authoritative and name what each rung cannot see:\n88: \n89: | Rung | Proves | Blind Spot |\n90: | --- | --- | --- |\n91: | Unit | Isolated logic or assertion path | Integration, wiring, real I/O, runtime state |\n92: | In-memory | Multiple modules without external runtime | Real file system, serialization, deployed config, external state |\n93: | On-server | Runtime service or local server path | Deployment differences, caches, real user environment |\n94: | Live | Exact exercised path in real target | Unexercised paths, other users, other environments, future data |\n95: \n96: ### Mutation Check And Claim Falsifier\n97: \n98: After green evidence for a new or modified test, confirm the test can fail for the right reason when that is feasible. A true red result is an assertion failing against the intended behavior. A compile error, or a command that never reached the assertion, is not a satisfying red. If a test stays green after the guarded behavior is broken, report it as a verification defect and hand back.\n99: \n100: This applies the idea behind `.skilled/repo-rules/evidence-and-proof.md` section 4 (THE NEGATIVE CONTROL): a check that passes whether or not the behavior works proves nothing. The before-fix half of that control, reproducing the failure with the same check, is step 2 of the [Debug Loop](./workflow-debug.md#debug-loop).\n101: \n102: ### Pre-Claim Gate Substance\n103: \n104: Walk every gate in order before any status claim:\n105: \n106: | Gate | Required Discipline |\n107: | --- | --- |\n108: | Identify | Name the command, action or observation that proves the claim. |\n109: | Run | Execute the surface-appropriate verification commands in the current session. |\n110: | Test | Exercise targeted unit, integration, end-to-end, runtime or manual checks where available, including at least one edge case and one error path. |\n111: | Verify | Confirm the output, exit code, test count and observed behavior match expectations, and that the run reached the changed code on a fresh build with real assertions. |\n112: | Record | Save the exact evidence the final claim rests on. |\n113: | Reread | Reread the request and its amendments, and confirm each outcome it asks for is backed by recorded evidence or named as not done. |\n114: | Claim | State only the narrow claim the evidence supports. |\n115: \n116: The Verify row guards against the four ways a green run lies, which `.skilled/repo-rules/evidence-and-proof.md` section 3 lists: it did not run, it ran on the wrong thing, it ran on stale artifacts or it asserted nothing.\n117: \n118: ### OpenCode Verification Reality\n119: \n120: For system code under `.skilled/` (the `sk-code-skilled` surface), also apply the [verification reality](../../sk-code-skilled/references/shared/workflow-guardrails.md#3-verification-reality), including the `validate.sh` pointer, and the [runtime build traps](../../sk-code-skilled/references/shared/workflow-guardrails.md#4-runtime-build-traps).\n121: \n122: ---\n123: \n124: ## 3. DISCIPLINE\n125: \n126: ### Always\n127: \n128: - Always run fresh verification in the current session before a completion-related claim.\n129: - Always resolve surface identity before selecting commands.\n130: - Always record command names, exit codes, key output, test counts and runtime observations.\n131: - Always report the baseline, current result, delta and claim scope for a no-regressions or improvement claim.\n132: - Always name the verification ladder rung reached and the blind spot that remains.\n133: - Always include behavior evidence when runtime behavior changed and tooling is available.\n134: - Always hand back when verification finds a defect.\n135: - Always confirm the diff scope matches the stated change, with no accidental extras or debug residue.\n136: - Always compare warnings against the last working state, so a new warning is reported and not absorbed.\n137: \n138: ### Never\n139: \n140: - Never edit or create files during verification.\n141: - Never dispatch subagents from verification.\n142: - Never claim done, works, complete, fixed, passing or ready from unrun commands.\n143: - Never claim no regressions without a baseline and a delta.\n144: - Never treat one green rung as proof of a higher rung.\n145: - Never hide a failed or skipped verifier behind a positive summary.\n146: - Never invent runtime, test or performance evidence.\n147: - Never verify against stale build output. Clean and rebuild first when an artifact is suspect.\n148: - Never present a check run in one environment as proof for every environment.\n149: \n150: ### Escalate If\n151: \n152: - The surface or the required verification command set is unknown.\n153: - A required verifier path is missing or unsafe to run.\n154: - Commands contradict each other on a blocking outcome.\n155: - Runtime evidence is required but unavailable and the claim would mislead without it.\n156: - The baseline is missing and the requested claim needs a regression comparison.\n157: - A mutation check shows the test is vacuous.\n158: \n159: ---\n160: \n161: ## 4. HANDOFF BOUNDARIES\n162: \n163: - [Debugging](./workflow-debug.md) receives reproducible verification failures, failed commands, broken runtime checks or vacuous tests.\n164: - [Implementation](./workflow-implement.md) receives the handback when required behavior is missing or build work is incomplete.\n165: - Quality (`sk-code-quality`) receives the handback when author-side checks, comment hygiene or checklist issues block verification.\n166: - Review (`sk-code-review`) owns critique when the user wants findings instead of final evidence.\n167: \n168: Verification is ready to report only when it ran last, used only non-mutating actions, recorded fresh active-surface evidence, compared against the baseline when the claim needed it, named its blind spots and handed back any defect without editing.\n169: \n170: ---\n171: \n172: ## 5. RELATED RESOURCES\n173: \n174: - [workflow-implement.md](./workflow-implement.md) - the build phase whose baseline and handoff this phase reads.\n175: - [workflow-debug.md](./workflow-debug.md) - the repair phase that receives every failed verification.\n176: - [stack-detection.md](../../shared/references/stack-detection.md) - surface detection, which decides the command set.\n177: - [workflow-guardrails.md](../../sk-code-skilled/references/shared/workflow-guardrails.md) - the verification command chain for system code under `.skilled/`."}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/sk-code/shared/references/workflow-verify.md\"}"},"time":{"start":1794558721192,"end":1794558721893}}}}
{"type":"tool_use","timestamp":1794558721918,"sessionID":"ses_e2bf947b9ffe73zBWlC0D8WZq4","part":{"partID":"prt_1d408f98d001BsDGMT4tXLmH4M","sessionID":"ses_e2bf947b9ffe73zBWlC0D8WZq4","messageID":"msg_1d408e3e1001Z4HGvwPrxTVjvX","type":"tool","id":"call_80d83648071249a7bd11ba7d","tool":"read","state":{"status":"completed","input":{"path":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/sk-code/sk-code-skilled/SKILL.md"},"output":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/sk-code/sk-code-skilled/SKILL.md, lines 1-203\n1: ---\n2: name: sk-code-skilled\n3: description: \"sk-code SKILLED surface: system-code evidence (TypeScript/Python/shell/Rust/config standards, language-agnostic patterns, hooks, alignment verification, and skill/agent/command/MCP authoring checklists) plus shared implement/debug/verify workflow doctrine.\"\n4: allowed-tools: [Read, Bash, Grep, Glob]\n5: version: 2.1.18.0\n6: metadata:\n7:   family: sk-code\n8:   packetKind: surface\n9: ---\n10: \n11: # Skilled Surface — System-Code Evidence\n12: \n13: **Domain evidence** and shared workflow doctrine for OpenCode system code (the `.skilled/` tree: skills, agents, commands, plugins, MCP servers, config, changelogs, and runtime bridge wiring). This surface owns the implement -> debug -> verify phases through the workflow references below, then slices evidence by the detected language so a TypeScript task never pulls the Python/shell/config guides.\n14: \n15: Detection has two steps:\n16: \n17: - First, select the Skilled surface for work under `.skilled/`. This includes `SKILL.md`, descriptors, commands, agents, plugins, MCP servers, assets, scripts and changelogs.\n18: - Then use file extensions and local markers to select the language trio:\n19:   - `.cjs`/`.mjs`/`.js` -> JavaScript\n20:   - `.ts`/`.tsx`/`.mts`/`.d.ts` -> TypeScript\n21:   - `.py` plus `argparse` -> Python\n22:   - `.sh`/`.bash` -> shell\n23:   - `.rs` -> Rust\n24:   - `.json`/`.jsonc`/`.yaml`/`.yml` plus `graph-metadata` or `spec-folder` -> config\n25: \n26: For Rust, when no `.rs` file is present, local `Cargo.toml`/`Cargo.lock` markers select it after the Skilled surface is established.\n27: napi-rs and wasm-bindgen vocabulary are additional intent signals, not cross-project surface detectors.\n28: \n29: ## 1. WHEN THE HUB BUNDLES THIS\n30: \n31: - The task touches `.skilled/` system code — a skill, agent, command, plugin, MCP server, or descriptor/config.\n32: - The active workflow phase needs a language standard, a language-agnostic organization pattern, a hook contract, an alignment-verification procedure, or an authoring checklist.\n33: - This surface owns edits, tests, and verification through the workflow references; hand off formal findings-first review to `sk-code-review` and author-side quality gates to `sk-code-quality`.\n34: \n35: ---\n36: \n37: ## 2. SMART ROUTING\n38: \n39: The hub bundles this surface when the task touches `.skilled/` system code — a skill, agent, command, plugin, MCP server, descriptor or config — and a language or authoring signal then selects the leaf. The first leaves it loads are the shared tier under `references/shared/` and `references/shared/workflow-guardrails.md`, because every language standard builds on them.\n40: \n41: The parent hub `RESOURCE_MAP` carries this map re-prefixed with `sk-code-skilled/` plus the parent-owned universal tier, and the router-sync guard (`assets/scripts/verify-router-sync.cjs`, leg 2) checks that equality. A new doc under `references/` or `assets/` needs a `RESOURCE_MAP` entry here, or leg 1b fails.\n42: \n43: Read [`ROUTER.md`](./ROUTER.md) before selecting skill-local resources; open only the matched files.\n44: \n45: ---\n46: \n47: ## 3. REFERENCE MAP\n48: \n49: Language standards — after `.skilled/` selects this surface, load the exact split resources for the detected language:\n50: - TypeScript:\n51:   - `references/typescript/style-guide/overview-strict-and-naming.md`\n52:   - `references/typescript/style-guide/formatting-imports-and-coexistence.md`\n53:   - `references/typescript/quality-standards/overview-and-type-system.md`\n54:   - `references/typescript/quality-standards/tsdoc-errors-and-async.md`\n55:   - `references/typescript/quality-standards/tsconfig-and-modules.md`\n56:   - `references/typescript/quick-reference/template-naming-and-types.md`\n57:   - `references/typescript/quick-reference/imports-errors-and-tsconfig.md`\n58: - Python — `references/python/style-guide.md`, `references/python/quality-standards.md`, `references/python/quick-reference.md`\n59: - Shell:\n60:   - `references/shell/style-guide/overview-structure-and-naming.md`\n61:   - `references/shell/style-guide/variables-functions-and-output.md`\n62:   - `references/shell/quality-standards/overview-and-priority-blockers.md`\n63:   - `references/shell/quality-standards/validation-security-and-shellcheck.md`\n64:   - `references/shell/quick-reference/template-variables-and-loops.md`\n65:   - `references/shell/quick-reference/functions-strings-and-checklist.md`\n66: - Rust:\n67:   - Style guide:\n68:     - `references/rust/style-guide/overview-and-file-header.md`\n69:     - `references/rust/style-guide/toolchain-and-project-structure.md`\n70:     - `references/rust/style-guide/naming-conventions.md`\n71:     - `references/rust/style-guide/formatting-and-imports.md`\n72:     - `references/rust/style-guide/commenting-and-rustdoc.md`\n73:     - `references/rust/style-guide/interop-model.md`\n74:     - `references/rust/style-guide/interop-errors-and-parity.md`\n75:   - Quality standards:\n76:     - `references/rust/quality-standards/overview-and-data-ownership.md`\n77:     - `references/rust/quality-standards/modeling-collections-and-api.md`\n78:     - `references/rust/quality-standards/docs-errors-and-async.md`\n79:     - `references/rust/quality-standards/build-and-organization.md`\n80:     - `references/rust/quality-standards/determinism-and-parity.md`\n81:   - Quick reference:\n82:     - `references/rust/quick-reference/overview-and-boundary-template.md`\n83:     - `references/rust/quick-reference/naming-ordering-and-signatures.md`\n84:     - `references/rust/quick-reference/collections-imports-and-errors.md`\n85:     - `references/rust/quick-reference/rustdoc-and-cargo.md`\n86:     - `references/rust/quick-reference/determinism-parity-and-related.md`\n87: - Config (JSON/JSONC/YAML descriptors and route assets) — `references/config/style-guide.md`, `references/config/quality-standards.md`, `references/config/quick-reference.md`, `assets/checklists/config-checklist.md`\n88: - JavaScript (CommonJS/ESM plugins) — `references/javascript/style-guide.md`, `references/javascript/quality-standards/overview-modules-and-docs.md`, `references/javascript/quality-standards/security-testing-and-exemptions.md`, `references/javascript/quick-reference.md`\n89: \n90: Language-agnostic shared tier (`references/shared/`, always kept within OpenCode regardless of language):\n91: - `references/shared/universal-patterns/naming-and-commenting.md`, `references/shared/universal-patterns/organization-security-and-examples.md`, `references/shared/code-organization/overview-and-module-organization.md`, `references/shared/code-organization/imports-and-exports.md`, `references/shared/code-organization/directory-and-test-conventions.md`\n92: - `hooks.md` — runtime hook entrypoints, checked-in Claude wiring, OpenCode plugin-bridge delivery, and wrapper reachability; defer to that file for current hook infrastructure instead of duplicating it here\n93: - `alignment-verification-automation.md` — the alignment-drift verifier\n94: - `workflow-guardrails.md`: OpenCode-only implementation guardrails, the verification command chain and runtime build traps, applied on top of the shared implement and verify workflow\n95: \n96: Authoring and validation assets:\n97: \n98: - Checklists:\n99:   - `assets/checklists/agent-authoring.md`\n100:   - `assets/checklists/command-authoring.md`\n101:   - `assets/checklists/javascript-checklist.md`\n102:   - `assets/checklists/js-css-style/overview-header-and-comments.md`\n103:   - `assets/checklists/js-css-style/naming-init-formatting-and-css.md`\n104:   - `assets/checklists/js-css-style/verification-quick-reference-and-related.md`\n105:   - `assets/checklists/mcp-server-authoring.md`\n106:   - `assets/checklists/python-checklist.md`\n107:   - `assets/checklists/rust-checklist/overview-and-p0-parity.md`\n108:   - `assets/checklists/rust-checklist/p0-safety-and-boundary-discipline.md`\n109:   - `assets/checklists/rust-checklist/p1-required.md`\n110:   - `assets/checklists/rust-checklist/p2-evidence-validation-and-resources.md`\n111:   - `assets/checklists/shell-checklist.md`\n112:   - `assets/checklists/skill-authoring.md`\n113:   - `assets/checklists/typescript-checklist.md`\n114:   - `assets/checklists/universal-checklist.md`\n115: - Scripts:\n116:   - `assets/scripts/README.md`\n117: - References:\n118:   - `references/shared/alignment-verification-automation.md`\n119:   - `references/shared/hooks.md`\n120: \n121: Workflow: `references/workflow-implement.md`, `references/workflow-debug.md` and `references/workflow-verify.md` link to the hub's shared implement -> debug -> verify doctrine in `../../shared/references/`; the split shared, language, hook and alignment resources above apply on top of it.\n122: \n123: ---\n124: \n125: ## 4. SURFACE STANDARDS (the non-negotiables)\n126: \n127: - **Plugins never write to the TUI.** OpenCode plugins must not print to the process stdout/stderr (no overlay on the chat input); user/agent-visible output goes through system-context injection, tools, or append-only log files; DEBUG-gated stderr is allowed only behind an env flag. See `references/javascript/quality-standards/overview-modules-and-docs.md` and the plugin exemption tier.\n128: - **Descriptors are load-bearing.** `graph-metadata.json` / `description.json` shape drives discovery; validate JSON/JSONC against `references/config/quality-standards.md`.\n129: - **Alignment drift is a verification gate.** Before any completion claim, re-run the four live sk-code drift guards on a system-code change through the single entry point `scripts/run-all-drift-guards.sh`.\n130:   - `assets/scripts/verify_alignment_drift.py` checks language integrity, plus dead RESOURCE_MAP routes with `--check-router`.\n131:   - `assets/scripts/verify_stack_folders.py` checks that language reference folders resolve.\n132:   - `assets/scripts/verify-router-sync.cjs` is the router-sync guard. It restores the four checks of the `sk-code-router-sync.vitest.ts` suite, which was deleted, and the wrapper runs every leg of it: 1a, 1b, 2, 3 and 4.\n133:     - Check (1): router paths exist on disk, every routable doc is routed, and every full path the prose maps name is routed.\n134:     - Check (2): the parent RESOURCE_MAP equals the union of the surface children's maps plus the parent tier.\n135:     - Check (3): compiled route-gold destinations, `leaf-manifest.json` and this RESOURCE_MAP agree through `qualifiedIdToLeaf`.\n136:     - Check (4): every playbook routing scenario's `expected_resource` is emitted by the router.\n137:   - The dead-path part of check (1) is also checked by `--check-router`. Leg 1b, the orphan-doc walk, fails on any reference or asset doc that no router names. It allowlists only the three shared workflow docs, which each surface reaches through a symlink.\n138:   - `.github/workflows/routing-registry-drift.yml` covers the compiled side of (3) and (4) in CI only, with the admission step warn-only.\n139:   - The documentation claim guard (`assets/scripts/verify-doc-claims.cjs`) reads the sk-code prose the other guards skip, from the hub folder on disk.\n140:     It checks that path references resolve and that no retired packet name remains.\n141:     It also checks that every surface count matches the surface modes in `mode-registry.json`, and that every file the `ROUTER.md` load-tier prose says loads on every route is in `DEFAULT_RESOURCE`.\n142:     Lines that keep a legacy name on purpose sit in its allowlist with a reason. See `references/shared/alignment-verification-automation.md`.\n143:   The wrapper scans repository content only: the files git tracks, so ignored trees, sibling worktrees and vendored clones stay out of a gate they can never pass. It exits 0 on a clean tree, so a completion claim requires wrapper rc 0 rather than a delta against a backlog.\n144: - **Rust preserves the TypeScript contract.** Rust napi-rs, WASM/WASI, and sidecar modules are compatibility implementations, not independent behavior authorities. JS-visible bytes, six-decimal numeric behavior, comparator tie-breaks, deterministic IDs, collection order, DTOs, and error shapes must remain identical to the TypeScript oracle.\n145: - **Touched-language set, not one-per-task.** Most `.skilled/` tasks touch a single language. Keep that slice tight and use the shared tier for cross-language rules.\n146: \n147: An interop task that spans a language pair, such as a napi-rs / WASM / sidecar Rust module held to its TypeScript oracle, legitimately touches both languages.\n148: The router selects the languages the task actually touches and loads both trios plus the shared tier.\n149: You cannot hold Rust byte-identical to TypeScript without seeing both standards.\n150: \n151: ---\n152: \n153: ## 5. SUPPORTING ASSETS\n154: \n155: Component authoring (`assets/checklists/`): `skill-authoring.md`, `agent-authoring.md`, `command-authoring.md`, `mcp-server-authoring.md`\n156: \n157: Language quality gates (`assets/checklists/`): `universal-checklist.md`, `typescript-checklist.md`, `python-checklist.md`, `shell-checklist.md`, `javascript-checklist.md`, `rust-checklist/` (split into topic parts), `config-checklist.md`\n158: \n159: Verifier assets (`assets/scripts/`): alignment-drift and stack-folder verifier scripts, the router-sync guard (`verify-router-sync.cjs`) with its replay library (`router-replay-lib.cjs`) and the documentation claim guard (`verify-doc-claims.cjs`), used by this surface. `scripts/run-all-drift-guards.sh` is the single entry point that runs all four as one gate (non-zero if any fails).\n160: \n161: Changelog directories (`changelog/`): real skill and packet changelog files are part of the Skilled surface inventory, not out-of-scope documentation noise.\n162: \n163: Daemon IPC/socket wiring: daemon-backed CLIs and plugin bridges resolve runtime Unix socket paths such as `daemon-ipc.sock`; sockets are runtime artifacts, so checked-in evidence lives in launcher, bridge, and config files rather than in committed `.sock` files.\n164: \n165: Spec-folder authoring lives in system-spec-kit (`.skilled/skills/system-spec-kit/references/workflows/spec-folder-write-recipe.md` + `spec-folder-authoring-checklist.md`), not in this surface. Checklists are pulled on demand by the active workflow phase.\n166: \n167: ---\n168: \n169: ## 6. QUALITY CHECKLIST MAP\n170: \n171: This is this repository's quality checklist map, not a universal one.\n172: The quality runner resolves checklists from two sources: the rows owned by the quality mode in `../sk-code-quality/assets/quality-defaults.json` and each surface's `quality.checklists` declaration in `../mode-registry.json`.\n173: This table renders both sources in that order.\n174: `scripts/tests/quality-checklist-map.test.cjs` fails when the two differ.\n175: In any repository, run `node ../sk-code-quality/scripts/quality-gate.cjs --explain <path>` to see the checklists for a file and why they apply.\n176: \n177: A SKILLED row applies only to a file that resolves to SKILLED.\n178: A `sk-code-ci` row applies by path alone because that surface declares no detection block.\n179: The spec-folder row applies only inside this hub's own repository.\n180: Applies to lists path globs and extensions. A row with several values matches on any of them.\n181: The MCP server checklist, `assets/checklists/mcp-server-authoring.md`, has no path to declare, so load it by judgment when your target is MCP server source.\n182: \n183: | Owner | Applies to | Checklist |\n184: | --- | --- | --- |\n185: | quality defaults | `**` | `../shared/references/universal/code-quality-standards.md` |\n186: | quality defaults | `specs/**` | `../../system-spec-kit/references/workflows/spec-folder-authoring-checklist.md` |\n187: | SKILLED | `.skilled/**` | `assets/checklists/universal-checklist.md` |\n188: | SKILLED | `.skilled/skills/**` | `assets/checklists/skill-authoring.md` |\n189: | SKILLED | `.skilled/agents/**` | `assets/checklists/agent-authoring.md` |\n190: | SKILLED | `.skilled/commands/**` | `assets/checklists/command-authoring.md` |\n191: | SKILLED | `.js`, `.cjs`, `.mjs` | `assets/checklists/javascript-checklist.md` |\n192: | SKILLED | `.js`, `.css` | `assets/checklists/js-css-style/overview-header-and-comments.md` |\n193: | SKILLED | `.js`, `.css` | `assets/checklists/js-css-style/naming-init-formatting-and-css.md` |\n194: | SKILLED | `.js`, `.css` | `assets/checklists/js-css-style/verification-quick-reference-and-related.md` |\n195: | SKILLED | `.ts`, `.tsx`, `.mts`, `.cts` | `assets/checklists/typescript-checklist.md` |\n196: | SKILLED | `.py` | `assets/checklists/python-checklist.md` |\n197: | SKILLED | `.sh`, `.bash` | `assets/checklists/shell-checklist.md` |\n198: | SKILLED | `.rs` | `assets/checklists/rust-checklist/overview-and-p0-parity.md` |\n199: | SKILLED | `.rs` | `assets/checklists/rust-checklist/p0-safety-and-boundary-discipline.md` |\n200: | SKILLED | `.rs` | `assets/checklists/rust-checklist/p1-required.md` |\n201: | SKILLED | `.rs` | `assets/checklists/rust-checklist/p2-evidence-validation-and-resources.md` |\n202: | SKILLED | `.json`, `.jsonc`, `.yaml`, `.yml` | `assets/checklists/config-checklist.md` |\n203: | sk-code-ci | `.github/workflows/**` | `../sk-code-ci/references/ci-workflow-standards.md` |","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/sk-code/sk-code-skilled/SKILL.md, lines 1-203\n1: ---\n2: name: sk-code-skilled\n3: description: \"sk-code SKILLED surface: system-code evidence (TypeScript/Python/shell/Rust/config standards, language-agnostic patterns, hooks, alignment verification, and skill/agent/command/MCP authoring checklists) plus shared implement/debug/verify workflow doctrine.\"\n4: allowed-tools: [Read, Bash, Grep, Glob]\n5: version: 2.1.18.0\n6: metadata:\n7:   family: sk-code\n8:   packetKind: surface\n9: ---\n10: \n11: # Skilled Surface — System-Code Evidence\n12: \n13: **Domain evidence** and shared workflow doctrine for OpenCode system code (the `.skilled/` tree: skills, agents, commands, plugins, MCP servers, config, changelogs, and runtime bridge wiring). This surface owns the implement -> debug -> verify phases through the workflow references below, then slices evidence by the detected language so a TypeScript task never pulls the Python/shell/config guides.\n14: \n15: Detection has two steps:\n16: \n17: - First, select the Skilled surface for work under `.skilled/`. This includes `SKILL.md`, descriptors, commands, agents, plugins, MCP servers, assets, scripts and changelogs.\n18: - Then use file extensions and local markers to select the language trio:\n19:   - `.cjs`/`.mjs`/`.js` -> JavaScript\n20:   - `.ts`/`.tsx`/`.mts`/`.d.ts` -> TypeScript\n21:   - `.py` plus `argparse` -> Python\n22:   - `.sh`/`.bash` -> shell\n23:   - `.rs` -> Rust\n24:   - `.json`/`.jsonc`/`.yaml`/`.yml` plus `graph-metadata` or `spec-folder` -> config\n25: \n26: For Rust, when no `.rs` file is present, local `Cargo.toml`/`Cargo.lock` markers select it after the Skilled surface is established.\n27: napi-rs and wasm-bindgen vocabulary are additional intent signals, not cross-project surface detectors.\n28: \n29: ## 1. WHEN THE HUB BUNDLES THIS\n30: \n31: - The task touches `.skilled/` system code — a skill, agent, command, plugin, MCP server, or descriptor/config.\n32: - The active workflow phase needs a language standard, a language-agnostic organization pattern, a hook contract, an alignment-verification procedure, or an authoring checklist.\n33: - This surface owns edits, tests, and verification through the workflow references; hand off formal findings-first review to `sk-code-review` and author-side quality gates to `sk-code-quality`.\n34: \n35: ---\n36: \n37: ## 2. SMART ROUTING\n38: \n39: The hub bundles this surface when the task touches `.skilled/` system code — a skill, agent, command, plugin, MCP server, descriptor or config — and a language or authoring signal then selects the leaf. The first leaves it loads are the shared tier under `references/shared/` and `references/shared/workflow-guardrails.md`, because every language standard builds on them.\n40: \n41: The parent hub `RESOURCE_MAP` carries this map re-prefixed with `sk-code-skilled/` plus the parent-owned universal tier, and the router-sync guard (`assets/scripts/verify-router-sync.cjs`, leg 2) checks that equality. A new doc under `references/` or `assets/` needs a `RESOURCE_MAP` entry here, or leg 1b fails.\n42: \n43: Read [`ROUTER.md`](./ROUTER.md) before selecting skill-local resources; open only the matched files.\n44: \n45: ---\n46: \n47: ## 3. REFERENCE MAP\n48: \n49: Language standards — after `.skilled/` selects this surface, load the exact split resources for the detected language:\n50: - TypeScript:\n51:   - `references/typescript/style-guide/overview-strict-and-naming.md`\n52:   - `references/typescript/style-guide/formatting-imports-and-coexistence.md`\n53:   - `references/typescript/quality-standards/overview-and-type-system.md`\n54:   - `references/typescript/quality-standards/tsdoc-errors-and-async.md`\n55:   - `references/typescript/quality-standards/tsconfig-and-modules.md`\n56:   - `references/typescript/quick-reference/template-naming-and-types.md`\n57:   - `references/typescript/quick-reference/imports-errors-and-tsconfig.md`\n58: - Python — `references/python/style-guide.md`, `references/python/quality-standards.md`, `references/python/quick-reference.md`\n59: - Shell:\n60:   - `references/shell/style-guide/overview-structure-and-naming.md`\n61:   - `references/shell/style-guide/variables-functions-and-output.md`\n62:   - `references/shell/quality-standards/overview-and-priority-blockers.md`\n63:   - `references/shell/quality-standards/validation-security-and-shellcheck.md`\n64:   - `references/shell/quick-reference/template-variables-and-loops.md`\n65:   - `references/shell/quick-reference/functions-strings-and-checklist.md`\n66: - Rust:\n67:   - Style guide:\n68:     - `references/rust/style-guide/overview-and-file-header.md`\n69:     - `references/rust/style-guide/toolchain-and-project-structure.md`\n70:     - `references/rust/style-guide/naming-conventions.md`\n71:     - `references/rust/style-guide/formatting-and-imports.md`\n72:     - `references/rust/style-guide/commenting-and-rustdoc.md`\n73:     - `references/rust/style-guide/interop-model.md`\n74:     - `references/rust/style-guide/interop-errors-and-parity.md`\n75:   - Quality standards:\n76:     - `references/rust/quality-standards/overview-and-data-ownership.md`\n77:     - `references/rust/quality-standards/modeling-collections-and-api.md`\n78:     - `references/rust/quality-standards/docs-errors-and-async.md`\n79:     - `references/rust/quality-standards/build-and-organization.md`\n80:     - `references/rust/quality-standards/determinism-and-parity.md`\n81:   - Quick reference:\n82:     - `references/rust/quick-reference/overview-and-boundary-template.md`\n83:     - `references/rust/quick-reference/naming-ordering-and-signatures.md`\n84:     - `references/rust/quick-reference/collections-imports-and-errors.md`\n85:     - `references/rust/quick-reference/rustdoc-and-cargo.md`\n86:     - `references/rust/quick-reference/determinism-parity-and-related.md`\n87: - Config (JSON/JSONC/YAML descriptors and route assets) — `references/config/style-guide.md`, `references/config/quality-standards.md`, `references/config/quick-reference.md`, `assets/checklists/config-checklist.md`\n88: - JavaScript (CommonJS/ESM plugins) — `references/javascript/style-guide.md`, `references/javascript/quality-standards/overview-modules-and-docs.md`, `references/javascript/quality-standards/security-testing-and-exemptions.md`, `references/javascript/quick-reference.md`\n89: \n90: Language-agnostic shared tier (`references/shared/`, always kept within OpenCode regardless of language):\n91: - `references/shared/universal-patterns/naming-and-commenting.md`, `references/shared/universal-patterns/organization-security-and-examples.md`, `references/shared/code-organization/overview-and-module-organization.md`, `references/shared/code-organization/imports-and-exports.md`, `references/shared/code-organization/directory-and-test-conventions.md`\n92: - `hooks.md` — runtime hook entrypoints, checked-in Claude wiring, OpenCode plugin-bridge delivery, and wrapper reachability; defer to that file for current hook infrastructure instead of duplicating it here\n93: - `alignment-verification-automation.md` — the alignment-drift verifier\n94: - `workflow-guardrails.md`: OpenCode-only implementation guardrails, the verification command chain and runtime build traps, applied on top of the shared implement and verify workflow\n95: \n96: Authoring and validation assets:\n97: \n98: - Checklists:\n99:   - `assets/checklists/agent-authoring.md`\n100:   - `assets/checklists/command-authoring.md`\n101:   - `assets/checklists/javascript-checklist.md`\n102:   - `assets/checklists/js-css-style/overview-header-and-comments.md`\n103:   - `assets/checklists/js-css-style/naming-init-formatting-and-css.md`\n104:   - `assets/checklists/js-css-style/verification-quick-reference-and-related.md`\n105:   - `assets/checklists/mcp-server-authoring.md`\n106:   - `assets/checklists/python-checklist.md`\n107:   - `assets/checklists/rust-checklist/overview-and-p0-parity.md`\n108:   - `assets/checklists/rust-checklist/p0-safety-and-boundary-discipline.md`\n109:   - `assets/checklists/rust-checklist/p1-required.md`\n110:   - `assets/checklists/rust-checklist/p2-evidence-validation-and-resources.md`\n111:   - `assets/checklists/shell-checklist.md`\n112:   - `assets/checklists/skill-authoring.md`\n113:   - `assets/checklists/typescript-checklist.md`\n114:   - `assets/checklists/universal-checklist.md`\n115: - Scripts:\n116:   - `assets/scripts/README.md`\n117: - References:\n118:   - `references/shared/alignment-verification-automation.md`\n119:   - `references/shared/hooks.md`\n120: \n121: Workflow: `references/workflow-implement.md`, `references/workflow-debug.md` and `references/workflow-verify.md` link to the hub's shared implement -> debug -> verify doctrine in `../../shared/references/`; the split shared, language, hook and alignment resources above apply on top of it.\n122: \n123: ---\n124: \n125: ## 4. SURFACE STANDARDS (the non-negotiables)\n126: \n127: - **Plugins never write to the TUI.** OpenCode plugins must not print to the process stdout/stderr (no overlay on the chat input); user/agent-visible output goes through system-context injection, tools, or append-only log files; DEBUG-gated stderr is allowed only behind an env flag. See `references/javascript/quality-standards/overview-modules-and-docs.md` and the plugin exemption tier.\n128: - **Descriptors are load-bearing.** `graph-metadata.json` / `description.json` shape drives discovery; validate JSON/JSONC against `references/config/quality-standards.md`.\n129: - **Alignment drift is a verification gate.** Before any completion claim, re-run the four live sk-code drift guards on a system-code change through the single entry point `scripts/run-all-drift-guards.sh`.\n130:   - `assets/scripts/verify_alignment_drift.py` checks language integrity, plus dead RESOURCE_MAP routes with `--check-router`.\n131:   - `assets/scripts/verify_stack_folders.py` checks that language reference folders resolve.\n132:   - `assets/scripts/verify-router-sync.cjs` is the router-sync guard. It restores the four checks of the `sk-code-router-sync.vitest.ts` suite, which was deleted, and the wrapper runs every leg of it: 1a, 1b, 2, 3 and 4.\n133:     - Check (1): router paths exist on disk, every routable doc is routed, and every full path the prose maps name is routed.\n134:     - Check (2): the parent RESOURCE_MAP equals the union of the surface children's maps plus the parent tier.\n135:     - Check (3): compiled route-gold destinations, `leaf-manifest.json` and this RESOURCE_MAP agree through `qualifiedIdToLeaf`.\n136:     - Check (4): every playbook routing scenario's `expected_resource` is emitted by the router.\n137:   - The dead-path part of check (1) is also checked by `--check-router`. Leg 1b, the orphan-doc walk, fails on any reference or asset doc that no router names. It allowlists only the three shared workflow docs, which each surface reaches through a symlink.\n138:   - `.github/workflows/routing-registry-drift.yml` covers the compiled side of (3) and (4) in CI only, with the admission step warn-only.\n139:   - The documentation claim guard (`assets/scripts/verify-doc-claims.cjs`) reads the sk-code prose the other guards skip, from the hub folder on disk.\n140:     It checks that path references resolve and that no retired packet name remains.\n141:     It also checks that every surface count matches the surface modes in `mode-registry.json`, and that every file the `ROUTER.md` load-tier prose says loads on every route is in `DEFAULT_RESOURCE`.\n142:     Lines that keep a legacy name on purpose sit in its allowlist with a reason. See `references/shared/alignment-verification-automation.md`.\n143:   The wrapper scans repository content only: the files git tracks, so ignored trees, sibling worktrees and vendored clones stay out of a gate they can never pass. It exits 0 on a clean tree, so a completion claim requires wrapper rc 0 rather than a delta against a backlog.\n144: - **Rust preserves the TypeScript contract.** Rust napi-rs, WASM/WASI, and sidecar modules are compatibility implementations, not independent behavior authorities. JS-visible bytes, six-decimal numeric behavior, comparator tie-breaks, deterministic IDs, collection order, DTOs, and error shapes must remain identical to the TypeScript oracle.\n145: - **Touched-language set, not one-per-task.** Most `.skilled/` tasks touch a single language. Keep that slice tight and use the shared tier for cross-language rules.\n146: \n147: An interop task that spans a language pair, such as a napi-rs / WASM / sidecar Rust module held to its TypeScript oracle, legitimately touches both languages.\n148: The router selects the languages the task actually touches and loads both trios plus the shared tier.\n149: You cannot hold Rust byte-identical to TypeScript without seeing both standards.\n150: \n151: ---\n152: \n153: ## 5. SUPPORTING ASSETS\n154: \n155: Component authoring (`assets/checklists/`): `skill-authoring.md`, `agent-authoring.md`, `command-authoring.md`, `mcp-server-authoring.md`\n156: \n157: Language quality gates (`assets/checklists/`): `universal-checklist.md`, `typescript-checklist.md`, `python-checklist.md`, `shell-checklist.md`, `javascript-checklist.md`, `rust-checklist/` (split into topic parts), `config-checklist.md`\n158: \n159: Verifier assets (`assets/scripts/`): alignment-drift and stack-folder verifier scripts, the router-sync guard (`verify-router-sync.cjs`) with its replay library (`router-replay-lib.cjs`) and the documentation claim guard (`verify-doc-claims.cjs`), used by this surface. `scripts/run-all-drift-guards.sh` is the single entry point that runs all four as one gate (non-zero if any fails).\n160: \n161: Changelog directories (`changelog/`): real skill and packet changelog files are part of the Skilled surface inventory, not out-of-scope documentation noise.\n162: \n163: Daemon IPC/socket wiring: daemon-backed CLIs and plugin bridges resolve runtime Unix socket paths such as `daemon-ipc.sock`; sockets are runtime artifacts, so checked-in evidence lives in launcher, bridge, and config files rather than in committed `.sock` files.\n164: \n165: Spec-folder authoring lives in system-spec-kit (`.skilled/skills/system-spec-kit/references/workflows/spec-folder-write-recipe.md` + `spec-folder-authoring-checklist.md`), not in this surface. Checklists are pulled on demand by the active workflow phase.\n166: \n167: ---\n168: \n169: ## 6. QUALITY CHECKLIST MAP\n170: \n171: This is this repository's quality checklist map, not a universal one.\n172: The quality runner resolves checklists from two sources: the rows owned by the quality mode in `../sk-code-quality/assets/quality-defaults.json` and each surface's `quality.checklists` declaration in `../mode-registry.json`.\n173: This table renders both sources in that order.\n174: `scripts/tests/quality-checklist-map.test.cjs` fails when the two differ.\n175: In any repository, run `node ../sk-code-quality/scripts/quality-gate.cjs --explain <path>` to see the checklists for a file and why they apply.\n176: \n177: A SKILLED row applies only to a file that resolves to SKILLED.\n178: A `sk-code-ci` row applies by path alone because that surface declares no detection block.\n179: The spec-folder row applies only inside this hub's own repository.\n180: Applies to lists path globs and extensions. A row with several values matches on any of them.\n181: The MCP server checklist, `assets/checklists/mcp-server-authoring.md`, has no path to declare, so load it by judgment when your target is MCP server source.\n182: \n183: | Owner | Applies to | Checklist |\n184: | --- | --- | --- |\n185: | quality defaults | `**` | `../shared/references/universal/code-quality-standards.md` |\n186: | quality defaults | `specs/**` | `../../system-spec-kit/references/workflows/spec-folder-authoring-checklist.md` |\n187: | SKILLED | `.skilled/**` | `assets/checklists/universal-checklist.md` |\n188: | SKILLED | `.skilled/skills/**` | `assets/checklists/skill-authoring.md` |\n189: | SKILLED | `.skilled/agents/**` | `assets/checklists/agent-authoring.md` |\n190: | SKILLED | `.skilled/commands/**` | `assets/checklists/command-authoring.md` |\n191: | SKILLED | `.js`, `.cjs`, `.mjs` | `assets/checklists/javascript-checklist.md` |\n192: | SKILLED | `.js`, `.css` | `assets/checklists/js-css-style/overview-header-and-comments.md` |\n193: | SKILLED | `.js`, `.css` | `assets/checklists/js-css-style/naming-init-formatting-and-css.md` |\n194: | SKILLED | `.js`, `.css` | `assets/checklists/js-css-style/verification-quick-reference-and-related.md` |\n195: | SKILLED | `.ts`, `.tsx`, `.mts`, `.cts` | `assets/checklists/typescript-checklist.md` |\n196: | SKILLED | `.py` | `assets/checklists/python-checklist.md` |\n197: | SKILLED | `.sh`, `.bash` | `assets/checklists/shell-checklist.md` |\n198: | SKILLED | `.rs` | `assets/checklists/rust-checklist/overview-and-p0-parity.md` |\n199: | SKILLED | `.rs` | `assets/checklists/rust-checklist/p0-safety-and-boundary-discipline.md` |\n200: | SKILLED | `.rs` | `assets/checklists/rust-checklist/p1-required.md` |\n201: | SKILLED | `.rs` | `assets/checklists/rust-checklist/p2-evidence-validation-and-resources.md` |\n202: | SKILLED | `.json`, `.jsonc`, `.yaml`, `.yml` | `assets/checklists/config-checklist.md` |\n203: | sk-code-ci | `.github/workflows/**` | `../sk-code-ci/references/ci-workflow-standards.md` |"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/sk-code/sk-code-skilled/SKILL.md\"}"},"time":{"start":1794558720397,"end":1794558721918}}}}
{"type":"tool_use","timestamp":1794558721938,"sessionID":"ses_e2bf947b9ffe73zBWlC0D8WZq4","part":{"partID":"prt_1d408fb48001vIo1xIZSguDFbm","sessionID":"ses_e2bf947b9ffe73zBWlC0D8WZq4","messageID":"msg_1d408e3e1001Z4HGvwPrxTVjvX","type":"tool","id":"call_aaeb614c80c142e99e1db704","tool":"read","state":{"status":"completed","input":{"path":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/sk-code/shared/references/workflow-implement.md"},"output":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/sk-code/shared/references/workflow-implement.md, lines 1-133\n1: ---\n2: title: Workflow Reference - Implementation\n3: description: Shared sk-code doctrine for the mutating build phase, from research before a change to the handoff into quality and verification.\n4: trigger_phrases:\n5:   - \"sk-code implementation workflow\"\n6:   - \"implement workflow doctrine\"\n7:   - \"mutating build workflow\"\n8:   - \"surface implementation standards\"\n9: importance_tier: important\n10: contextType: general\n11: version: 2.1.6.0\n12: ---\n13: \n14: # Workflow Reference - Implementation\n15: \n16: Open this when you are about to change behavior and need to know how much to read before the first edit.\n17: \n18: ---\n19: \n20: ## 1. OVERVIEW\n21: \n22: ### Purpose\n23: \n24: Implementation is the one lifecycle phase that builds new behavior. It reads before it writes, lands the smallest correct edit and hands the result on with the facts later phases need. It takes the active surface from the shared router and loads only that surface's resources.\n25: \n26: ### When to Use\n27: \n28: - Writing, modifying, refactoring or building code in the active surface.\n29: - Implementing a feature, script, component, module, fallback, parameter, authoring packet or runtime behavior.\n30: - Researching unfamiliar, risky, config-sensitive, security-sensitive or multi-file code before changing it.\n31: - Applying surface authoring patterns once the shared router has resolved the surface.\n32: - Using a library or framework overlay as peer reference after surface detection, never as a replacement for surface standards.\n33: \n34: ### When Not to Use\n35: \n36: - A concrete failing symptom dominates the task. Use [debugging](./workflow-debug.md).\n37: - The code is written and needs author-side P0/P1/P2 checks, comment hygiene or surface checklists. Use the `sk-code-quality` mode, which runs `quality-gate.cjs` first.\n38: - The task is final non-mutating evidence. Use [verification](./workflow-verify.md).\n39: - The user wants findings-first review output instead of workspace edits. Use the `sk-code-review` mode.\n40: - The change is documentation-only prose with no executable behavior or routing change.\n41: \n42: ### Core Principle\n43: \n44: Read first, change the least and write the baseline down before the first edit. Debugging and verification can only measure a change against the starting state this phase recorded.\n45: \n46: ---\n47: \n48: ## 2. WORKFLOW\n49: \n50: ### Research\n51: \n52: Research comes before any change to unfamiliar or high-blast code. For a small local edit it can be brief, but it always includes reading the target file.\n53: \n54: 1. Read every target file in this session before editing it.\n55: 2. List every place the change must reach (callers, tests, fixtures, config and exports). Read them, with nearby conventions and existing examples, before introducing a new shape.\n56: 3. Use the surface the shared router resolved ([stack-detection.md](../../shared/references/stack-detection.md)). Never re-detect or override it inside this phase.\n57: 4. Load the smallest active-surface resource set that covers the intent and the changed file types.\n58: 5. For broad or risky work, run a bounded read-only research sweep before editing.\n59: 6. When design or other upstream guidance handed off locked values, constraints or risks, keep them as given instead of redesigning the task.\n60: \n61: ### Pre-Write Restraint\n62: \n63: Before the first edit of non-trivial work, record two facts:\n64: \n65: | Field | Content |\n66: | --- | --- |\n67: | Baseline | The starting state, in the shape of the Baseline row in the verification [Baseline And Delta](./workflow-verify.md#baseline-and-delta) table. Write `UNKNOWN` when no safe baseline exists, because verification then has to settle for a narrower claim. |\n68: | Blast Radius | One phrase, such as `low-blast, reversible`, `medium-blast: multi-file behavior` or `high-blast: touches auth/data/filesystem/config`. |\n69: \n70: Then walk the [Design Restraint Ladder](../../shared/references/universal/code-quality-standards.md#design-restraint-ladder-pre-write) and stop at the first rung that holds. The ladder never cuts a P0 item or anything the user asked for. When requested scope looks unnecessary or risky, implement the requirement and raise a scope-amendment recommendation in the same response. Never cut scope silently. The restraint floor belongs to `.skilled/repo-rules/prevent-overengineering.md` sections 1 and 2 and the Restraint Signals table in `AGENTS.md` section 3.\n71: \n72: ### Write\n73: \n74: 1. Write the smallest correct change that meets the request and the active-surface standards.\n75: 2. Keep the project's existing conventions unless the request changes them.\n76: 3. Stay inside the user's scope and the established documentation scope.\n77: 4. Keep comments durable and explanatory. Never add artifact labels or temporary process markers, because they go stale the moment the work that named them closes.\n78: 5. Keep routing metadata, config shapes, generated-metadata ownership and packet boundaries intact when authoring system assets.\n79: 6. Prepare the handoff: changed scope, baseline, likely checks and accepted residual risks.\n80: \n81: ### OpenCode Implementation Guardrails\n82: \n83: For system code under `.skilled/` (the `sk-code-skilled` surface), also apply the [implementation guardrails](../../sk-code-skilled/references/shared/workflow-guardrails.md#2-implementation-guardrails).\n84: \n85: ---\n86: \n87: ## 3. DISCIPLINE\n88: \n89: ### Always\n90: \n91: - Always read a target file before editing it, including skeletons and existing README or contract files.\n92: - Always use the surface identity the shared router resolved before loading implementation resources.\n93: - Always pick the active-surface language or file-type guidance before applying standards.\n94: - Always load authoring checklists at write time when the active surface requires them.\n95: - Always record a baseline and a one-phrase blast-radius read for non-trivial work.\n96: - Always build the simplest correct implementation of the stated requirement.\n97: - Always hand off to quality and verification explicitly once the code is written.\n98: \n99: ### Never\n100: \n101: - Never claim completion from implementation alone. The [Iron Law](./workflow-verify.md#iron-law) gates every completion claim.\n102: - Never treat an unsupported or ambiguous surface as supported.\n103: - Never apply one surface's standards to another surface's runtime behavior.\n104: - Never narrow requested scope silently because part of it looks unnecessary.\n105: - Never add packet-local advisor metadata when the parent owns the identity.\n106: - Never paste whole reference documents into the workflow. Link or load the focused reference instead.\n107: \n108: ### Escalate If\n109: \n110: - Surface identity stays ambiguous after the shared-router inputs are read.\n111: - Implementation evidence conflicts with the approved spec or a user instruction.\n112: - The verification command set is unknown and the user expects a completion claim.\n113: - Security-sensitive, filesystem, credential, destructive or production-data behavior is unclear.\n114: \n115: ---\n116: \n117: ## 4. HANDOFF BOUNDARIES\n118: \n119: - Quality (`sk-code-quality`) receives the change for author-side checks, comment hygiene and active-surface checklists. The mode runs `quality-gate.cjs` first and loads every checklist its verdict lists.\n120: - [Debugging](./workflow-debug.md) receives failing checks or runtime symptoms and traces one root cause at a time.\n121: - [Verification](./workflow-verify.md) receives the final changed state, the baseline, the commands to run and the exact claim to prove.\n122: - Review (`sk-code-review`) owns findings-first critique when the user asks for severity-ranked risks instead of edits.\n123: \n124: The handoff is ready when the surface is known, the target files were read, the loaded resources match the active surface, non-trivial work carries a baseline and a blast-radius note and the change is the smallest correct implementation of the stated requirement.\n125: \n126: ---\n127: \n128: ## 5. RELATED RESOURCES\n129: \n130: - [workflow-debug.md](./workflow-debug.md) - the repair phase that takes over when a symptom appears.\n131: - [workflow-verify.md](./workflow-verify.md) - the evidence phase, the Iron Law and the baseline shape this phase records.\n132: - [phase-detection.md](../../shared/references/phase-detection.md) - how a request maps to this phase and what each phase hands on.\n133: - [code-quality-standards.md](../../shared/references/universal/code-quality-standards.md) - the Design Restraint Ladder and the P0 items it never cuts.","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/sk-code/shared/references/workflow-implement.md, lines 1-133\n1: ---\n2: title: Workflow Reference - Implementation\n3: description: Shared sk-code doctrine for the mutating build phase, from research before a change to the handoff into quality and verification.\n4: trigger_phrases:\n5:   - \"sk-code implementation workflow\"\n6:   - \"implement workflow doctrine\"\n7:   - \"mutating build workflow\"\n8:   - \"surface implementation standards\"\n9: importance_tier: important\n10: contextType: general\n11: version: 2.1.6.0\n12: ---\n13: \n14: # Workflow Reference - Implementation\n15: \n16: Open this when you are about to change behavior and need to know how much to read before the first edit.\n17: \n18: ---\n19: \n20: ## 1. OVERVIEW\n21: \n22: ### Purpose\n23: \n24: Implementation is the one lifecycle phase that builds new behavior. It reads before it writes, lands the smallest correct edit and hands the result on with the facts later phases need. It takes the active surface from the shared router and loads only that surface's resources.\n25: \n26: ### When to Use\n27: \n28: - Writing, modifying, refactoring or building code in the active surface.\n29: - Implementing a feature, script, component, module, fallback, parameter, authoring packet or runtime behavior.\n30: - Researching unfamiliar, risky, config-sensitive, security-sensitive or multi-file code before changing it.\n31: - Applying surface authoring patterns once the shared router has resolved the surface.\n32: - Using a library or framework overlay as peer reference after surface detection, never as a replacement for surface standards.\n33: \n34: ### When Not to Use\n35: \n36: - A concrete failing symptom dominates the task. Use [debugging](./workflow-debug.md).\n37: - The code is written and needs author-side P0/P1/P2 checks, comment hygiene or surface checklists. Use the `sk-code-quality` mode, which runs `quality-gate.cjs` first.\n38: - The task is final non-mutating evidence. Use [verification](./workflow-verify.md).\n39: - The user wants findings-first review output instead of workspace edits. Use the `sk-code-review` mode.\n40: - The change is documentation-only prose with no executable behavior or routing change.\n41: \n42: ### Core Principle\n43: \n44: Read first, change the least and write the baseline down before the first edit. Debugging and verification can only measure a change against the starting state this phase recorded.\n45: \n46: ---\n47: \n48: ## 2. WORKFLOW\n49: \n50: ### Research\n51: \n52: Research comes before any change to unfamiliar or high-blast code. For a small local edit it can be brief, but it always includes reading the target file.\n53: \n54: 1. Read every target file in this session before editing it.\n55: 2. List every place the change must reach (callers, tests, fixtures, config and exports). Read them, with nearby conventions and existing examples, before introducing a new shape.\n56: 3. Use the surface the shared router resolved ([stack-detection.md](../../shared/references/stack-detection.md)). Never re-detect or override it inside this phase.\n57: 4. Load the smallest active-surface resource set that covers the intent and the changed file types.\n58: 5. For broad or risky work, run a bounded read-only research sweep before editing.\n59: 6. When design or other upstream guidance handed off locked values, constraints or risks, keep them as given instead of redesigning the task.\n60: \n61: ### Pre-Write Restraint\n62: \n63: Before the first edit of non-trivial work, record two facts:\n64: \n65: | Field | Content |\n66: | --- | --- |\n67: | Baseline | The starting state, in the shape of the Baseline row in the verification [Baseline And Delta](./workflow-verify.md#baseline-and-delta) table. Write `UNKNOWN` when no safe baseline exists, because verification then has to settle for a narrower claim. |\n68: | Blast Radius | One phrase, such as `low-blast, reversible`, `medium-blast: multi-file behavior` or `high-blast: touches auth/data/filesystem/config`. |\n69: \n70: Then walk the [Design Restraint Ladder](../../shared/references/universal/code-quality-standards.md#design-restraint-ladder-pre-write) and stop at the first rung that holds. The ladder never cuts a P0 item or anything the user asked for. When requested scope looks unnecessary or risky, implement the requirement and raise a scope-amendment recommendation in the same response. Never cut scope silently. The restraint floor belongs to `.skilled/repo-rules/prevent-overengineering.md` sections 1 and 2 and the Restraint Signals table in `AGENTS.md` section 3.\n71: \n72: ### Write\n73: \n74: 1. Write the smallest correct change that meets the request and the active-surface standards.\n75: 2. Keep the project's existing conventions unless the request changes them.\n76: 3. Stay inside the user's scope and the established documentation scope.\n77: 4. Keep comments durable and explanatory. Never add artifact labels or temporary process markers, because they go stale the moment the work that named them closes.\n78: 5. Keep routing metadata, config shapes, generated-metadata ownership and packet boundaries intact when authoring system assets.\n79: 6. Prepare the handoff: changed scope, baseline, likely checks and accepted residual risks.\n80: \n81: ### OpenCode Implementation Guardrails\n82: \n83: For system code under `.skilled/` (the `sk-code-skilled` surface), also apply the [implementation guardrails](../../sk-code-skilled/references/shared/workflow-guardrails.md#2-implementation-guardrails).\n84: \n85: ---\n86: \n87: ## 3. DISCIPLINE\n88: \n89: ### Always\n90: \n91: - Always read a target file before editing it, including skeletons and existing README or contract files.\n92: - Always use the surface identity the shared router resolved before loading implementation resources.\n93: - Always pick the active-surface language or file-type guidance before applying standards.\n94: - Always load authoring checklists at write time when the active surface requires them.\n95: - Always record a baseline and a one-phrase blast-radius read for non-trivial work.\n96: - Always build the simplest correct implementation of the stated requirement.\n97: - Always hand off to quality and verification explicitly once the code is written.\n98: \n99: ### Never\n100: \n101: - Never claim completion from implementation alone. The [Iron Law](./workflow-verify.md#iron-law) gates every completion claim.\n102: - Never treat an unsupported or ambiguous surface as supported.\n103: - Never apply one surface's standards to another surface's runtime behavior.\n104: - Never narrow requested scope silently because part of it looks unnecessary.\n105: - Never add packet-local advisor metadata when the parent owns the identity.\n106: - Never paste whole reference documents into the workflow. Link or load the focused reference instead.\n107: \n108: ### Escalate If\n109: \n110: - Surface identity stays ambiguous after the shared-router inputs are read.\n111: - Implementation evidence conflicts with the approved spec or a user instruction.\n112: - The verification command set is unknown and the user expects a completion claim.\n113: - Security-sensitive, filesystem, credential, destructive or production-data behavior is unclear.\n114: \n115: ---\n116: \n117: ## 4. HANDOFF BOUNDARIES\n118: \n119: - Quality (`sk-code-quality`) receives the change for author-side checks, comment hygiene and active-surface checklists. The mode runs `quality-gate.cjs` first and loads every checklist its verdict lists.\n120: - [Debugging](./workflow-debug.md) receives failing checks or runtime symptoms and traces one root cause at a time.\n121: - [Verification](./workflow-verify.md) receives the final changed state, the baseline, the commands to run and the exact claim to prove.\n122: - Review (`sk-code-review`) owns findings-first critique when the user asks for severity-ranked risks instead of edits.\n123: \n124: The handoff is ready when the surface is known, the target files were read, the loaded resources match the active surface, non-trivial work carries a baseline and a blast-radius note and the change is the smallest correct implementation of the stated requirement.\n125: \n126: ---\n127: \n128: ## 5. RELATED RESOURCES\n129: \n130: - [workflow-debug.md](./workflow-debug.md) - the repair phase that takes over when a symptom appears.\n131: - [workflow-verify.md](./workflow-verify.md) - the evidence phase, the Iron Law and the baseline shape this phase records.\n132: - [phase-detection.md](../../shared/references/phase-detection.md) - how a request maps to this phase and what each phase hands on.\n133: - [code-quality-standards.md](../../shared/references/universal/code-quality-standards.md) - the Design Restraint Ladder and the P0 items it never cuts."}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/sk-code/shared/references/workflow-implement.md\"}"},"time":{"start":1794558720840,"end":1794558721938}}}}
