'fixtures'],\n66:   },\n67:   {\n68:     id: 'system-spec-kit/runtime',\n69:     name: '@spec-kit/runtime',\n70:     root: '.skilled/skills/system-spec-kit/runtime',\n71:     distEntries: {\n72:       default: 'dist/tsconfig.tsbuildinfo',\n73:       'validation-orchestrator': 'dist/lib/validation/orchestrator.js',\n74:     },\n75:     rebuildCommand: 'cd .skilled/skills/system-spec-kit/runtime && npm run build',\n76:     sourceCandidates: [\n77:       'package.json',\n78:       'tsconfig.json',\n79:       'api',\n80:       'core',\n81:       'handlers',\n82:       'hooks',\n83:       'lib',\n84:       // runtime/scripts is the engine's own build tooling (finalize-dist, test\n85:       // runners), not the CLI workspace, which lives at runtime/cli.\n86:       'scripts',\n87:     ],\n88:     entrySourceCandidates: {\n89:       'validation-orchestrator': [\n90:         'package.json',\n91:         'tsconfig.json',\n92:         'lib/validation',\n93:         'lib/templates',\n94:         'lib/spec',\n95:         'lib/graph',\n96:         'lib/config',\n97:         'lib/description',\n98:       ],\n99:     },\n100:     excludedSegments: ['tests', 'stress-test'],\n101:   },\n102:   {\n103:     id: 'mcp-code-mode/mcp-server',\n104:     name: '@utcp/code-mode-mcp',\n105:     root: '.skilled/skills/mcp-code-mode/mcp-server',\n106:     distEntries: { default: 'dist/index.js' },\n107:     rebuildCommand: 'cd .skilled/skills/mcp-code-mode/mcp-server && npm run build',\n108:     sourceCandidates: ['package.json', 'tsconfig.json', 'index.ts'],\n109:   },\n110:   {\n111:     id: 'system-skill-advisor/runtime',\n112:     name: '@spec-kit/system-skill-advisor',\n113:     root: '.skilled/skills/system-skill-advisor/runtime',\n114:     distEntries: {\n115:       default: 'dist/runtime/advisor-server.js',\n116:       'skill-advisor-cli': 'dist/runtime/skill-advisor-cli.js',\n117:     },\n118:     rebuildCommand: 'cd .skilled/skills/system-skill-advisor/runtime && npm run build',\n119: 