nstalled dependencies are both present. Each package's dist/ and node_modules\n175: // are gitignored and populated per-checkout — by a local build, or by the\n176: // launch-wrapper symlinking them from the main tree. A bare worktree that ran\n177: // neither has neither, so its rebuildCommand (`npm run build`) cannot succeed\n178: // here. That is a provisioning gap, not source drift: reporting it as \"stale\"\n179: // makes the guard warn (or attempt a doomed rebuild) about work it is powerless\n180: // to do in this checkout. Distinguishing the two keeps the guard silent where\n181: // it cannot help and fully active where it can.\n182: //\n183: // A workspace install hoists dependencies to an ancestor, so the package itself\n184: // often holds no node_modules while its imports resolve fine. The walk therefore\n185: // climbs to the workspace root and no further: a node_modules above that root\n186: // belongs to another checkout and could never satisfy this one's imports.\n187: function isPackageProvisioned(root, workspaceRoot) {\n188:   if (!fs.existsSync(path.join(root, 'package.json'))) return false;\n189:   const boundary = path.resolve(workspaceRoot);\n190:   const relative = path.relative(boundary, path.resolve(root));\n191:   const inside = relative && !relative.startsWith('..') && !path.isAbsolute(relative);\n192:   const depth = inside ? relative.split(path.sep).length : 0;\n193:   let current = path.resolve(root);\n194:   for (let step = 0; step <= depth; step += 1) {\n195:     if (fs.existsSync(path.join(current, 'node_modules'))) return true;\n196:     current = path.dirname(current);\n197:   }\n198:   return false;\n199: }\n200: \n201: function unprovisionedResult(pkg, root, distEntry, entry) {\n202:   return {\n203:     packageId: pkg.id,\n204:     packageName: pkg.name,\n205:     status: 'unprovisioned',\n206:     stale: false,\n207:     packageRoot: root,\n208:     distEntry: distEntry || null,\n209:     entry,\n210:     rebuildCommand: pkg.rebuildCommand,\n211:     message: `${pkg.name} is not provisioned in this checkout (no package.json, or no node_modules up to the workspace root); dist freshness cannot be assessed or rebuilt here`,\n212:   };\n213: }\n214: \n215: function normalizeEntryName(pkg, entryName = 'default') {\n216:   if (pkg.distEntries[entryName]) return entryName;\n217:   if (entryName === 'default') return 'default';\n218:   return null;\n219: }\n220: \n221: function distEntryFor(pkg, root, entryName = 'default') {\n222:   const normalizedEntry = normalizeEntryName(pkg, entryName);\n223:   if (!normalizedEntry) return null;\n224:   return path.join(root, pkg.distEntries[normalizedEntry]);\n225: }\n226: \n227: function shouldSkipPath(filePath, root, pkg) {\n228:   const relative = path.relative(root, filePath);\n229:   const segments = relative.split(path.sep);\n230:   const excluded = new Set([...DEFAULT_EXCLUDED_SEGMENTS, ...(pkg.excludedSegments || [])]);\n231:   return segments.some((segment) => excluded.has(segment));\n232: }\n233: \n234: function sourceExtensionsFor(pkg) {\n235:   return new Set(pkg.sourceExtensions || [...SOURCE_EXTENSIONS]);\n236: }\n237: \n238: function isWatchedSourceFile(filePath, pkg) {\n239:   return sourceExtensionsFor(pkg).has(path.extname(filePath)) || MANIFEST_BASENAMES.has(path.basename(filePath));\n240: }\n241: \n242: function sourceCandidatesFor(pkg, entryName) {\n243:   return pkg.entrySourceCandidates?.[entryName] || pkg.sourceCandidates;\n244: }\n245: \n246: function collectSourceFiles(pkg, root, entryName) {\n247:   const files = [];\n248:   const missing = [];\n249:   const visitedRealPaths = new Set();\n250: \n251:   const visit = (candidate) => {\n252:     if (!fs.existsSync(candidate)) {\n253:       missing.push(candidate);\n254:       return;\n255:     }\n256:     const realPath = fs.realpathSync(candidate);\n257:     if (visitedRealPaths.has(realPath)) return;\n258:     visitedRealPaths.add(realPath);\n259:     const stat = fs.statSync(candidate);\n260:     if (stat.isDirectory()) {\n261:       if (shouldSkipPath(candidate, root, pkg)) return;\n262:       for (const entry of fs.readdirSync(candidate)) {\n263:         const child = path.join(candidate, entry);\n264:         // A symlinked directory points at another package's tree (for example\n265:         // scripts/runtime -> ../runtime/dist). Its contents are that package's\n266:         // outputs, not this package's sources, so descending would make every\n267:         // rebuild there flag this package stale. A dangling link (the target\n268:         // not built yet on a fresh checkout) is skipped the same way rather\n269:         // than turning the whole freshness check into an error.\n270:         if (fs.lstatSync(child).isSymbolicLink()) {\n271:           let target = null;\n272:           try {\n273:             target = fs.statSync(child);\n274:           } catch (_) {\n275:             continue;\n276:           }\n277:           if (target.isDirectory()) continue;\n278:         }\n279:         visit(child);\n280:       }\n281:       return;\n282:     }\n283:     if (!stat.isFile() || shouldSkipPath(candidate, root, pkg)) return;\n284:     if (isWatchedSourceFile(candidate, pkg)) files.push(candidate);\n285:   };\n286: \n287:   for (const candidate of sourceCandidatesFor(pkg, entryName)) {\n288:     visit(path.resolve(root, candidate));\n289:   }\n290: \n291:   return { files, missing };\n292: }\n293: \n294: function hashSourceFiles(root, sources) {\n295:   const hash = crypto.createHash('sha256');\n296:   for (const filePath of [...sources].sort()) {\n297:     hash.update(path.relative(root, filePath));\n298:     hash.update('\\0');\n299:     hash.update(fs.readFileSync(filePath));\n300:     hash.update('\\0');\n301:   }\n302:   return hash.digest('hex');\n303: }\n304: \n305: function hashFile(filePath) {\n306:   return crypto.createHash('sha256').update(fs.readFileSync(filePath)).digest('hex');\n307: }\n308: \n309: function cachePathFor(root, distEntry, pkg, entryName) {\n310:   const suffix = crypto.createHash('sha1').update(`${pkg.id}:${entryName}:${distEntry}`).digest('hex').slice(0, 12);\n311:   const safeId = pkg.id.replace(/[^a-z0-9_-]+/gi, '-');\n312:   return path.join(path.dirname(distEntry), `.dist-freshness-${safeId}-${suffix}.json`);\n313: }\n314: \n315: function readStoredBuildRecord(cachePath) {\n316:   try {\n317:     const parsed = JSON.parse(fs.readFileSync(cachePath, 'utf8'));\n318:     return parsed && typeof parsed === 'object' && typeof parsed.sourceHash === 'string' ? parsed : null;\n319:   } catch (_) {\n320:     return null;\n321:   }\n322: }\n323: \n324: function cleanupCacheTemps(cachePath) {\n325:   try {\n326:     const directory = path.dirname(cachePath);\n327:     const basename = path.basename(cachePath);\n328:     const now = Date.now();\n329:     for (const entry of fs.readdirSync(directory)) {\n330:       if (!entry.startsWith(`${basename}.`) || !/^\\d+(?:-[a-f0-9]+)?\\.tmp$/.test(entry.slice(basename.length + 1))) continue;\n331:       const tempPath = path.join(directory, entry);\n332:       if ((now - fs.statSync(tempPath).mtimeMs) > CACHE_TEMP_MAX_AGE_MS) fs.unlinkSync(tempPath);\n333:     }\n334:   } catch (_) {\n335:     // Cleanup is best-effort so cache maintenance cannot affect freshness checks.\n336:   }\n337: }\n338: \n339: function writeStoredBuildRecord(cachePath, record) {\n340:   let tempPath = null;\n341:   let wasWritten = false;\n342:   try {\n343:     fs.mkdirSync(path.dirname(cachePath), { recursive: true });\n344:     cleanupCacheTemps(cachePath);\n345:     const token = crypto.randomBytes(6).toString('hex');\n346:     tempPath = `${cachePath}.${process.pid}-${token}.tmp`;\n347:     fs.writeFileSync(tempPath, `${JSON.stringify(record)}\\n`);\n348:     fs.renameSync(tempPath, cachePath);\n349:     tempPath = null;\n350:     wasWritten = true;\n351:   } catch (_) {\n352:     // Cache writes are an optimization; staleness detection remains conservative.\n353:   } finally {\n354:     if (tempPath) {\n355:       try {\n356:         fs.unlinkSync(tempPath);\n357:       } catch (_) {\n358:         // A failed cleanup is pruned by a later cache write after the age guard.\n359:       }\n360:     }\n361:   }\n362:   return wasWritten;\n363: }\n364: \n365: function pendingBuildPath(cachePath) {\n366:   return `${cachePath}.pending`;\n367: }\n368: \n369: function rebuildMessage(pkg, state, detail = null) {\n370:   const suffix = detail ? ` (${detail})` : '';\n371:   return `${pkg.name} dist is ${state}${suffix}. Rebuild with: ${pkg.rebuildCommand}`;\n372: }\n373: \n374: // ───────────────────────────────────────────────────────────────────\n375: // 6. CORE LOGIC\n376: // ───────────────────────────────────────────────────────────────────\n377: function writePackageSourceHashCache(packageId, options = {}) {\n378:   const workspaceRoot = workspaceRootFromOptions(options);\n379:   const pkg = packageById(packageId);\n380:   if (!pkg) return freshnessError(null, `Unknown dist package: ${packageId}`);\n381: \n382:   const root = packageRoot(workspaceRoot, pkg);\n383:   if (!fs.existsSync(root)) {\n384:     return freshnessError(pkg, `Watched package root is missing: ${root}`, { packageRoot: root });\n385:   }\n386: \n387:   const entryName = options.entry || 'default';\n388:   const normalizedEntry = normalizeEntryName(pkg, entryName);\n389:   if (!normalizedEntry) {\n390:     return freshnessError(pkg, `Unknown dist entry \"${entryName}\" for ${pkg.id}`, { packageRoot: root });\n391:   }\n392: \n393:   const distEntry = distEntryFor(pkg, root, normalizedEntry);\n394:   if (!distEntry || !fs.existsSync(distEntry)) {\n395:     return {\n396:       packageId: pkg.id,\n397:       packageName: pkg.name,\n398:       status: 'missing',\n399:       stale: true,\n400:       packageRoot: root,\n401:       distEntry,\n402:       entry: normalizedEntry,\n403:       rebuildCommand: pkg.rebuildCommand,\n404:       message: rebuildMessage(pkg, 'missing', distEntry),\n405:     };\n406:   }\n407: \n408:   try {\n409:     const { files, missing } = collectSourceFiles(pkg, root, normalizedEntry);\n410:     if (missing.length > 0) {\n411:       return freshnessError(\n412:         pkg,\n413:         `Watched source path is missing for ${pkg.id}: ${missing.map((item) => path.relative(workspaceRoot, item)).join(', ')}`,\n414:         { packageRoot: root, distEntry, entry: normalizedEntry, missingSourcePaths: missing },\n415:       );\n416:     }\n417:     if (files.length === 0) {\n418:       return freshnessError(pkg, `No watched source files found for ${pkg.id}`, {\n419:         packageRoot: root,\n420:         distEntry,\n421:         entry: normalizedEntry,\n422:       });\n423:     }\n424: \n425:     const sourceHash = hashSourceFiles(root, files);\n426:     const cachePath = cachePathFor(root, distEntry, pkg, normalizedEntry);\n427:     const distHash = hashFile(distEntry);\n428:     const wasWritten = writeStoredBuildRecord(cachePath, {\n429:       version: CACHE_VERSION,\n430:       origin: 'checker',\n431:       sourceHash,\n432:       distHash,\n433:     });\n434:     if (!wasWritten) {\n435:       return freshnessError(pkg, `Dist freshness cache write failed for ${pkg.id}`, {\n436:         packageRoot: root,\n437:         distEntry,\n438:         entry: normalizedEntry,\n439:       });\n440:     }\n441:     return {\n442:       packageId: pkg.id,\n443:       packageName: pkg.name,\n444:       status: 'cached',\n445:       stale: false,\n446:       packageRoot: root,\n447:       distEntry,\n448:       entry: normalizedEntry,\n449:       rebuildCommand: pkg.rebuildCommand,\n450:       sourceCount: files.length,\n451:       cachePath,\n452:       sourceHash,\n453:       distHash,\n454:       origin: 'checker',\n455:       message: `${pkg.name} dist freshness cache written`,\n456:     };\n457:   } catch (error) {\n458:     return freshnessError(pkg, `Dist freshness cache write failed for ${pkg.id}: ${error.message}`, {\n459:       packageRoot: root,\n460:       distEntry,\n461:       entry: normalizedEntry,\n462:     });\n463:   }\n464: }\n465: \n466: function preparePackageBuild(packageId, options = {}) {\n467:   const workspaceRoot = workspaceRootFromOptions(options);\n468:   const pkg = packageById(packageId);\n469:   if (!pkg) return freshnessError(null, `Unknown dist package: ${packageId}`);\n470: \n471:   const root = packageRoot(workspaceRoot, pkg);\n472:   if (!fs.existsSync(root)) {\n473:     return freshnessError(pkg, `Watched package root is missing: ${root}`, { packageRoot: root });\n474:   }\n475: \n476:   const entryName = options.entry || 'default';\n477:   const normalizedEntry = normalizeEntryName(pkg, entryName);\n478:   if (!normalizedEntry) {\n479:     return freshnessError(pkg, `Unknown dist entry \"${entryName}\" for ${pkg.id}`, { packageRoot: root });\n480:   }\n481: \n482:   const distEntry = distEntryFor(pkg, root, normalizedEntry);\n483:   try {\n484:     const { files, missing } = collectSourceFiles(pkg, root, normalizedEntry);\n485:     if (missing.length > 0) {\n486:       return freshnessError(\n487:         pkg,\n488:         `Watched source path is missing for ${pkg.id}: ${missing.map((item) => path.relative(workspaceRoot, item)).join(', ')}`,\n489:         { packageRoot: root, distEntry, entry: normalizedEntry, missingSourcePaths: missing },\n490:       );\n491:     }\n492:     if (files.length === 0) {\n493:       return freshnessError(pkg, `No watched source files found for ${pkg.id}`, {\n494:         packageRoot: root,\n495:         distEntry,\n496:         entry: normalizedEntry,\n497:       });\n498:     }\n499: \n500:     const sourceHash = hashSourceFiles(root, files);\n501:     const cachePath = cachePathFor(root, distEntry, pkg, normalizedEntry);\n502:     const pendingPath = pendingBuildPath(cachePath);\n503:     const wasPrepared = writeStoredBuildRecord(pendingPath, {\n504:       version: CACHE_VERSION,\n505:       origin: 'prepare',\n506:       packageId: pkg.id,\n507:       entry: normalizedEntry,\n508:       sourceHash,\n509:     });\n510:     if (!wasPrepared) {\n511:       return freshnessError(pkg, `Dist freshness build preparation could not be stored for ${pkg.id}`, {\n512:         packageRoot: root,\n513:         distEntry,\n514:         entry: normalizedEntry,\n515:       });\n516:     }\n517:     return {\n518:       packageId: pkg.id,\n519:       packageName: pkg.name,\n520:       status: 'prepared',\n521:       stale: false,\n522:       packageRoot: root,\n523:       distEntry,\n524:       entry: normalizedEntry,\n525:       rebuildCommand: pkg.rebuildCommand,\n526:       sourceCount: files.length,\n527:       cachePath,\n528:       pendingPath,\n529:       sourceHash,\n530:       message: `${pkg.name} dist build preparation recorded`,\n531:     };\n532:   } catch (error) {\n533:     return freshnessError(pkg, `Dist freshness build preparation failed for ${pkg.id}: ${error.message}`, {\n534:       packageRoot: root,\n535:       distEntry,\n536:       entry: normalizedEntry,\n537:     });\n538:   }\n539: }\n540: \n541: function recordPackageBuild(packageId, options = {}) {\n542:   const workspaceRoot = workspaceRootFromOptions(options);\n543:   const pkg = packageById(packageId);\n544:   if (!pkg) return freshnessError(null, `Unknown dist package: ${packageId}`);\n545: \n546:   const root = packageRoot(workspaceRoot, pkg);\n547:   if (!fs.existsSync(root)) {\n548:     return freshnessError(pkg, `Watched package root is missing: ${root}`, { packageRoot: root });\n549:   }\n550: \n551:   const entryName = options.entry || 'default';\n552:   const normalizedEntry = normalizeEntryName(pkg, entryName);\n553:   if (!normalizedEntry) {\n554:     return freshnessError(pkg, `Unknown dist entry \"${entryName}\" for ${pkg.id}`, { packageRoot: root });\n555:   }\n556: \n557:   const distEntry = distEntryFor(pkg, root, normalizedEntry);\n558:   if (!distEntry || !fs.existsSync(distEntry)) {\n559:     return freshnessError(pkg, `Built dist entry is missing for ${pkg.id}: ${distEntry}`, {\n560:       packageRoot: root,\n561:       distEntry,\n562:       entry: normalizedEntry,\n563:     });\n564:   }\n565: \n566:   try {\n567:     const { files, missing } = collectSourceFiles(pkg, root, normalizedEntry);\n568:     if (missing.length > 0 || files.length === 0) {\n569:       return freshnessError(pkg, `Cannot attest ${pkg.id}; watched build inputs are unavailable`, {\n570:         packageRoot: root,\n571:         distEntry,\n572:         entry: normalizedEntry,\n573:         missingSourcePaths: missing,\n574:       });\n575:     }\n576: \n577:     const cachePath = cachePathFor(root, distEntry, pkg, normalizedEntry);\n578:     const pendingPath = pendingBuildPath(cachePath);\n579:     const pending = readStoredBuildRecord(pendingPath);\n580:     if (pending?.version !== CACHE_VERSION || pending.origin !== 'prepare'\n581:       || pending.packageId !== pkg.id || pending.entry !== normalizedEntry) {\n582:       return freshnessError(pkg, `No valid prepared build record exists for ${pkg.id}:${normalizedEntry}`, {\n583:         packageRoot: root,\n584:         distEntry,\n585:         entry: normalizedEntry,\n586:       });\n587:     }\n588: \n589:     const sourceHash = hashSourceFiles(root, files);\n590:     if (sourceHash !== pending.sourceHash) {\n591:       return freshnessError(pkg, `Watched source content changed while building ${pkg.id}:${normalizedEntry}`, {\n592:         packageRoot: root,\n593:         distEntry,\n594:         entry: normalizedEntry,\n595:       });\n596:     }\n597:     const distHash = hashFile(distEntry);\n598:     if (hashSourceFiles(root, files) !== pending.sourceHash) {\n599:       return freshnessError(pkg, `Watched source content changed while finalizing ${pkg.id}:${normalizedEntry}`, {\n600:         packageRoot: root,\n601:         distEntry,\n602:         entry: normalizedEntry,\n603:       });\n604:     }\n605: \n606:     const wasRecorded = writeStoredBuildRecord(cachePath, {\n607:       version: CACHE_VERSION,\n608:       origin: 'build',\n609:       sourceHash,\n610:       distHash,\n611:     });\n612:     if (!wasRecorded) {\n613:       return freshnessError(pkg, `Dist freshness build attestation could not be stored for ${pkg.id}`, {\n614:         packageRoot: root,\n615:         distEntry,\n616:         entry: normalizedEntry,\n617:       });\n618:     }\n619:     try {\n620:       fs.unlinkSync(pendingPath);\n621:     } catch (_) {\n622:       // The promoted record is authoritative; a leftover preparation is harmless.\n623:     }\n624:     return {\n625:       packageId: pkg.id,\n626:       packageName: pkg.name,\n627:       status: 'recorded',\n628:       stale: false,\n629:       packageRoot: root,\n630:       distEntry,\n631:       entry: normalizedEntry,\n632:       rebuildCommand: pkg.rebuildCommand,\n633:       sourceCount: files.length,\n634:       cachePath,\n635:       sourceHash,\n636:       distHash,\n637:       origin: 'build',\n638:       message: `${pkg.name} dist build attestation recorded`,\n639:     };\n640:   } catch (error) {\n641:     return freshnessError(pkg, `Dist freshness build attestation failed for ${pkg.id}: ${error.message}`, {\n642:       packageRoot: root,\n643:       distEntry,\n644:       entry: normalizedEntry,\n645:     });\n646:   }\n647: }\n648: \n649: function freshnessError(pkg, message, extra = {}) {\n650:   return {\n651:     packageId: pkg?.id || null,\n652:     packageName: pkg?.name || null,\n653:     status: 'error',\n654:     stale: false,\n655:     message,\n656:     rebuildCommand: pkg?.rebuildCommand || null,\n657:     ...extra,\n658:   };\n659: }\n660: \n661: function checkPackageFreshness(packageId, options = {}) {\n662:   const workspaceRoot = workspaceRootFromOptions(options);\n663:   const pkg = packageById(packageId);\n664:   if (!pkg) return freshnessError(null, `Unknown dist package: ${packageId}`);\n665: \n666:   const root = packageRoot(workspaceRoot, pkg);\n667:   if (!fs.existsSync(root)) {\n668:     return freshnessError(pkg, `Watched package root is missing: ${root}`, { packageRoot: root });\n669:   }\n670: \n671:   const entryName = options.entry || 'default';\n672:   const normalizedEntry = normalizeEntryName(pkg, entryName);\n673:   if (!normalizedEntry) {\n674:     return freshnessError(pkg, `Unknown dist entry \"${entryName}\" for ${pkg.id}`, { packageRoot: root });\n675:   }\n676: \n677:   const provisioned = isPackageProvisioned(root, workspaceRoot);\n678: \n679:   const distEntry = distEntryFor(pkg, root, normalizedEntry);\n680:   if (!distEntry || !fs.existsSync(distEntry)) {\n681:     if (!provisioned) return unprovisionedResult(pkg, root, distEntry, normalizedEntry);\n682:     return {\n683:       packageId: pkg.id,\n684:       packageName: pkg.name,\n685:       status: 'missing',\n686:       stale: true,\n687:       packageRoot: root,\n688:       distEntry,\n689:       entry: normalizedEntry,\n690:       rebuildCommand: pkg.rebuildCommand,\n691:       message: rebuildMessage(pkg, 'missing', distEntry),\n692:     };\n693:   }\n694: \n695:   if (options.allowStale) {\n696:     return {\n697:       packageId: pkg.id,\n698:       packageName: pkg.name,\n699:       status: 'fresh',\n700:       stale: false,\n701:       packageRoot: root,\n702:       distEntry,\n703:       entry: normalizedEntry,\n704:       rebuildCommand: pkg.rebuildCommand,\n705:       message: `${pkg.name} dist freshness check bypassed by caller option`,\n706:     };\n707:   }\n708: \n709:   try {\n710:     const { files, missing } = collectSourceFiles(pkg, root, normalizedEntry);\n711:     if (missing.length > 0) {\n712:       return freshnessError(\n713:         pkg,\n714:         `Watched source path is missing for ${pkg.id}: ${missing.map((item) => path.relative(workspaceRoot, item)).join(', ')}`,\n715:         { packageRoot: root, distEntry, entry: normalizedEntry, missingSourcePaths: missing },\n716:       );\n717:     }\n718:     if (files.length === 0) {\n719:       return freshnessError(pkg, `No watched source files found for ${pkg.id}`, {\n720:         packageRoot: root,\n721:         distEntry,\n722:         entry: normalizedEntry,\n723:       });\n724:     }\n725: \n726:     const sourceHash = hashSourceFiles(root, files);\n727:     const cachePath = cachePathFor(root, distEntry, pkg, normalizedEntry);\n728:     const distHash = hashFile(distEntry);\n729:     const stored = readStoredBuildRecord(cachePath);\n730:     if (stored?.version === CACHE_VERSION && stored.origin === 'build') {\n731:       if (stored.sourceHash !== sourceHash) {\n732:         if (!provisioned) return unprovisionedResult(pkg, root, distEntry, normalizedEntry);\n733:         return {\n734:           packageId: pkg.id,\n735:           packageName: pkg.name,\n736:           status: 'stale',\n737:           stale: true,\n738:           packageRoot: root,\n739:           distEntry,\n740:           entry: normalizedEntry,\n741:           rebuildCommand: pkg.rebuildCommand,\n742:           sourceCount: files.length,\n743:           message: rebuildMessage(pkg, 'stale', 'source content differs from the attested build'),\n744:         };\n745:       }\n746:       if (typeof stored.distHash !== 'string' || stored.distHash !== distHash) {\n747:         if (!provisioned) return unprovisionedResult(pkg, root, distEntry, normalizedEntry);\n748:         return {\n749:           packageId: pkg.id,\n750:           packageName: pkg.name,\n751:           status: 'stale',\n752:           stale: true,\n753:           packageRoot: root,\n754:           distEntry,\n755:           entry: normalizedEntry,\n756:           rebuildCommand: pkg.rebuildCommand,\n757:           sourceCount: files.length,\n758:           message: rebuildMessage(pkg, 'stale', 'dist content differs from the attested build'),\n759:         };\n760:       }\n761:       return {\n762:         packageId: pkg.id,\n763:         packageName: pkg.name,\n764:         status: 'fresh',\n765:         stale: false,\n766:         packageRoot: root,\n767:         distEntry,\n768:         entry: normalizedEntry,\n769:         rebuildCommand: pkg.rebuildCommand,\n770:         sourceCount: files.length,\n771:         origin: 'build',\n772:         message: `${pkg.name} dist is fresh`,\n773:       };\n774:     }\n775:     if (stored?.version === CACHE_VERSION && stored.sourceHash === sourceHash && stored.distHash === distHash) {\n776:       return {\n777:         packageId: pkg.id,\n778:         packageName: pkg.name,\n779:         status: 'fresh',\n780:         stale: false,\n781:         packageRoot: root,\n782:         distEntry,\n783:         entry: normalizedEntry,\n784:         rebuildCommand: pkg.rebuildCommand,\n785:         sourceCount: files.length,\n786:         origin: stored.origin || 'checker',\n787:         message: `${pkg.name} dist is fresh`,\n788:       };\n789:     }\n790: \n791:     let newestSourceFile = files[0];\n792:     let newestSourceMtime = fs.statSync(newestSourceFile).mtimeMs;\n793:     for (const filePath of files.slice(1)) {\n794:       const fileMtime = fs.statSync(filePath).mtimeMs;\n795:       if (fileMtime > newestSourceMtime) {\n796:         newestSourceMtime = fileMtime;\n797:         newestSourceFile = filePath;\n798:       }\n799:     }\n800:     const distMtime = fs.statSync(distEntry).mtimeMs;\n801:     if (newestSourceMtime > distMtime) {\n802:       if (!provisioned) return unprovisionedResult(pkg, root, distEntry, normalizedEntry);\n803:       return {\n804:         packageId: pkg.id,\n805:         packageName: pkg.name,\n806:         status: 'stale',\n807:         stale: true,\n808:         packageRoot: root,\n809:         distEntry,\n810:         entry: normalizedEntry,\n811:         rebuildCommand: pkg.rebuildCommand,\n812:         sourceCount: files.length,\n813:         newestSourceMtime,\n814:         newestSourceFile,\n815:         distMtime,\n816:         message: rebuildMessage(pkg, 'stale'),\n817:       };\n818:     }\n819: \n820:     // A read-only caller asks for the verdict without this write, because a gate\n821:     // run promises to leave the tree untouched and the record sits beside the\n822:     // dist entry. The default stays writable: the session-start self-heal reads\n823:     // the record first and would pay a full source hash on every run without it.\n824:     if (!options.readOnly) {\n825:       writeStoredBuildRecord(cachePath, {\n826:         version: CACHE_VERSION,\n827:         origin: 'checker',\n828:         sourceHash,\n829:         distHash,\n830:       });\n831:     }\n832:     return {\n833:       packageId: pkg.id,\n834:       packageName: pkg.name,\n835:       status: 'fresh',\n836:       stale: false,\n837:       packageRoot: root,\n838:       distEntry,\n839:       entry: normalizedEntry,\n840:       rebuildCommand: pkg.rebuildCommand,\n841:       sourceCount: files.length,\n842:       newestSourceMtime,\n843:       newestSourceFile,\n844:       distMtime,\n845:       origin: 'checker',\n846:       message: `${pkg.name} dist is fresh`,\n847:     };\n848:   } catch (error) {\n849:     return freshnessError(pkg, `Dist freshness checker failed for ${pkg.id}: ${error.message}`, {\n850:       packageRoot: root,\n851:       distEntry,\n852:       entry: normalizedEntry,\n853:     });\n854:   }\n855: }\n856: \n857: // Options reach every package check unchanged, so a caller that asks for the\n858: // read-only path gets it across the whole registry rather than per package.\n859: function checkAllFreshness(options = {}) {\n860:   return DIST_PACKAGES.map((pkg) => checkPackageFreshness(pkg.id, options));\n861: }\n862: \n863: function sourceContainsFile(workspaceRoot, pkg, filePath) {\n864:   const root = packageRoot(workspaceRoot, pkg);\n865:   const absoluteFile = path.resolve(filePath);\n866:   if (!fs.existsSync(root) || !isWatchedSourceFile(absoluteFile, pkg)) return false;\n867:   if (shouldSkipPath(absoluteFile, root, pkg)) return false;\n868:   return pkg.sourceCandidates.some((candidate) => {\n869:     const candidatePath = path.resolve(root, candidate);\n870:     if (!fs.existsSync(candidatePath)) return false;\n871:     const stat = fs.statSync(candidatePath);\n872:     if (stat.isDirectory()) {\n873:       const relative = path.relative(candidatePath, absoluteFile);\n874:       return relative && !relative.startsWith('..') && !path.isAbsolute(relative);\n875:     }\n876:     return candidatePath === absoluteFile;\n877:   });\n878: }\n879: \n880: // A built file is not source, so the source lookup cannot answer for it. A path\n881: // under a package's own dist folder belongs to the package that produced it, and\n882: // the longest matching root wins where one package root sits inside another's.\n883: function isUnderDistOutput(workspaceRoot, pkg, filePath) {\n884:   const root = packageRoot(workspaceRoot, pkg);\n885:   const relative = path.relative(root, filePath);\n886:   if (!relative || relative.startsWith('..') || path.isAbsolute(relative)) return false;\n887:   const [first, ...rest] = relative.split(path.sep);\n888:   const distFolders = new Set(Object.values(pkg.distEntries).map((entry) => entry.split('/')[0]));\n889:   return rest.length > 0 && distFolders.has(first);\n890: }\n891: \n892: function distEntryNameFor(pkg, root, filePath) {\n893:   for (const [entryName, relativeEntry] of Object.entries(pkg.distEntries)) {\n894:     if (path.resolve(root, relativeEntry) === filePath) return entryName;\n895:   }\n896:   return 'default';\n897: }\n898: \n899: function packageForDistFile(filePath, options = {}) {\n900:   const workspaceRoot = workspaceRootFromOptions(options);\n901:   const absoluteFile = path.resolve(filePath);\n902:   let match = null;\n903:   for (const pkg of DIST_PACKAGES) {\n904:     if (!isUnderDistOutput(workspaceRoot, pkg, absoluteFile)) continue;\n905:     const root = packageRoot(workspaceRoot, pkg);\n906:     if (!match || root.length > match.root.length) match = { pkg, root };\n907:   }\n908:   if (!match) return null;\n909:   return { pkg: match.pkg, entry: distEntryNameFor(match.pkg, match.root, absoluteFile) };\n910: }\n911: \n912: function packageForSourceFile(filePath, options = {}) {\n913:   const workspaceRoot = workspaceRootFromOptions(options);\n914:   return DIST_PACKAGES.find((pkg) => sourceContainsFile(workspaceRoot, pkg, filePath)) || null;\n915: }\n916: \n917: function checkFileFreshness(filePath, options = {}) {\n918:   const absoluteFile = path.resolve(filePath);\n919:   const sourcePackage = packageForSourceFile(filePath, options);\n920:   if (sourcePackage) return { ...checkPackageFreshness(sourcePackage.id, options), filePath: absoluteFile };\n921:   const distMatch = packageForDistFile(filePath, options);\n922:   if (!distMatch) {\n923:     return {\n924:       packageId: null,\n925:       packageName: null,\n926:       status: 'unmatched',\n927:       stale: false,\n928:       filePath: absoluteFile,\n929:       message: 'Edited file is not under a watched dist-producing source tree',\n930:     };\n931:   }\n932:   const entry = options.entry || distMatch.entry;\n933:   return { ...checkPackageFreshness(distMatch.pkg.id, { ...options, entry }), filePath: absoluteFile };\n934: }\n935: \n936: function formatWarning(result) {\n937:   if (!result || !result.stale) return '';\n938:   return `STALE DIST WARNING: ${result.packageName || result.packageId} -- run: ${result.rebuildCommand}`;\n939: }\n940: \n941: function formatCheckError(result) {\n942:   if (!result || result.status !== 'error') return '';\n943:   const name = result.packageName || result.packageId || 'unknown package';\n944:   return `DIST FRESHNESS CHECK ERROR: ${name} -- ${result.message}`;\n945: }\n946: \n947: function summarizeFreshness(results) {\n948:   const stale = results.filter((item) => item.stale);\n949:   const errors = results.filter((item) => item.status === 'error');\n950:   return {\n951:     status: stale.length > 0 ? 'stale' : errors.length > 0 ? 'degraded' : 'fresh',\n952:     stale: stale.length > 0,\n953:     degraded: errors.length > 0,\n954:     errors,\n955:     results,\n956:   };\n957: }\n958: \n959: // ───────────────────────────────────────────────────────────────────\n960: // 7. CLI ENTRY\n961: // ───────────────────────────────────────────────────────────────────\n962: function parseArgs(argv) {\n963:   const parsed = { positional: [], json: false, workspaceRoot: null, packageId: null, entry: null, filePath: null, readOnly: false };\n964:   for (let index = 0; index < argv.length; index += 1) {\n965:     const arg = argv[index];\n966:     if (arg === '--json') parsed.json = true;\n967:     else if (arg === '--workspace-root') parsed.workspaceRoot = argv[++index];\n968:     else if (arg === '--package') parsed.packageId = argv[++index];\n969:     else if (arg === '--entry') parsed.entry = argv[++index];\n970:     else if (arg === '--file') parsed.filePath = argv[++index];\n971:     else if (arg === '--no-write') parsed.readOnly = true;\n972:     else if (arg.startsWith('--')) {\n973:       // A misspelled option used to fall through to the positional list and run\n974:       // the default command as if the flag had never been passed.\n975:       process.stderr.write(`dist-freshness: unknown option: ${arg}\\n`);\n976:       process.stderr.write('Usage: dist-freshness.cjs <check|prepare-build|record-build|check-file|check-all|list> [options]\\n');\n977:       process.exit(64);\n978:     } else parsed.positional.push(arg);\n979:   }\n980:   return parsed;\n981: }\n982: \n983: function printResult(result, asJson) {\n984:   if (asJson) {\n985:     process.stdout.write(`${JSON.stringify(result)}\\n`);\n986:     return;\n987:   }\n988:   if (result.status === 'error') process.stderr.write(`DIST FRESHNESS CHECK ERROR: ${result.message}\\n`);\n989:   else if (Array.isArray(result.results)) {\n990:     const stale = result.results.filter((item) => item.stale).map(formatWarning).filter(Boolean);\n991:     const errors = result.results.filter((item) => item.status === 'error').map(formatCheckError).filter(Boolean);\n992:     if (stale.length > 0) process.stdout.write(`${stale.join('\\n')}\\n`);\n993:     if (errors.length > 0) process.stderr.write(`${errors.slice(0, 8).join('\\n')}\\n`);\n994:     if (stale.length === 0 && errors.length === 0) process.stdout.write('All watched dist outputs are fresh.\\n');\n995:   }\n996:   else process.stdout.write(`${result.message}\\n`);\n997: }\n998: \n999: function runCli() {\n1000:   const args = parseArgs(process.argv.slice(2));\n1001:   const command = args.positional[0] || 'check-all';\n1002:   const options = { workspaceRoot: args.workspaceRoot, entry: args.entry };\n1003:   // Only a check command reaches the cache write, so the read-only switch is\n1004:   // handed to those and never to the record commands, which exist to write one.\n1005:   const checkOptions = { ...options, readOnly: args.readOnly };\n1006:   let result;\n1007: \n1008:   if (command === 'check') {\n1009:     if (!args.packageId) {\n1010:       process.stderr.write('Usage: dist-freshness.cjs check --package <package-id> [--entry <entry>] [--json]\\n');\n1011:       process.exit(64);\n1012:     }\n1013:     result = checkPackageFreshness(args.packageId, checkOptions);\n1014:   } else if (command === 'prepare-build' || command === 'record-build') {\n1015:     if (!args.packageId) {\n1016:       process.stderr.write(`Usage: dist-freshness.cjs ${command} --package <package-id> [--entry <entry>] [--json]\\n`);\n1017:       process.exit(64);\n1018:     }\n1019:     result = command === 'prepare-build'\n1020:       ? preparePackageBuild(args.packageId, options)\n1021:       : recordPackageBuild(args.packageId, options);\n1022:   } else if (command === 'check-file') {\n1023:     if (!args.filePath) {\n1024:       process.stderr.write('Usage: dist-freshness.cjs check-file --file <path> [--json]\\n');\n1025:       process.exit(64);\n1026:     }\n1027:     result = checkFileFreshness(args.filePath, checkOptions);\n1028:   } else if (command === 'check-all') {\n1029:     result = summarizeFreshness(checkAllFreshness(checkOptions));\n1030:   } else if (command === 'list') {\n1031:     result = { status: 'ok', packages: DIST_PACKAGES };\n1032:   } else {\n1033:     process.stderr.write(`Unknown dist freshness command: ${command}\\n`);\n1034:     process.exit(64);\n1035:   }\n1036: \n1037:   printResult(result, args.json);\n1038:   if (result.stale) process.exit(STALE_EXIT_CODE);\n1039:   // An error result means the check could not verify freshness; exiting 0 let\n1040:   // callers that read only the exit code treat the failure as a pass.\n1041:   if (result.status === 'error') process.exit(1);\n1042:   process.exit(0);\n1043: }\n1044: \n1045: if (require.main === module) runCli();\n1046: \n1047: // ───────────────────────────────────────────────────────────────────\n1048: // 8. EXPORTS\n1049: // ───────────────────────────────────────────────────────────────────\n1050: module.exports = {\n1051:   DIST_PACKAGES,\n1052:   STALE_EXIT_CODE,\n1053:   checkAllFreshness,\n1054:   cachePathFor,\n1055:   checkFileFreshness,\n1056:   checkPackageFreshness,\n1057:   collectSourceFiles,\n1058:   formatCheckError,\n1059:   formatWarning,\n1060:   hashFile,\n1061:   hashSourceFiles,\n1062:   packageForDistFile,\n1063:   packageForSourceFile,\n1064:   preparePackageBuild,\n1065:   recordPackageBuild,\n1066:   summarizeFreshness,\n1067:   writePackageSourceHashCache,\n1068: };","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-spec-kit/runtime/cli/lib/dist-freshness.cjs, lines 1-1068\n1: #!/usr/bin/env node\n2: // ───────────────────────────────────────────────────────────────────\n3: // MODULE: Dist Freshness Utility\n4: // ───────────────────────────────────────────────────────────────────\n5: // Shared source-vs-dist staleness checks for local TypeScript build outputs,\n6: // without rebuilding or blocking on checker bugs.\n7: // ───────────────────────────────────────────────────────────────────\n8: 'use strict';\n9: \n10: // ───────────────────────────────────────────────────────────────────\n11: // 1. IMPORTS\n12: // ───────────────────────────────────────────────────────────────────\n13: const crypto = require('node:crypto');\n14: const fs = require('node:fs');\n15: const path = require('node:path');\n16: \n17: // ───────────────────────────────────────────────────────────────────\n18: // 2. CONSTANTS\n19: // ───────────────────────────────────────────────────────────────────\n20: const STALE_EXIT_CODE = 69;\n21: const SOURCE_EXTENSIONS = new Set(['.ts', '.tsx', '.mts', '.cts', '.json']);\n22: const MANIFEST_BASENAMES = new Set(['package.json', 'tsconfig.json', 'tsconfig.build.json']);\n23: const DEFAULT_EXCLUDED_SEGMENTS = new Set(['node_modules', 'dist']);\n24: const CACHE_VERSION = 2;\n25: const CACHE_TEMP_MAX_AGE_MS = 24 * 60 * 60 * 1000;\n26: \n27: // ───────────────────────────────────────────────────────────────────\n28: // 3. WORKSPACE ROOT\n29: // ───────────────────────────────────────────────────────────────────\n30: const { findRepoRoot } = require('@spec-kit/shared/workspace/repo-root.mjs');\n31: const WORKSPACE_ROOT = findRepoRoot(__dirname);\n32: \n33: // ───────────────────────────────────────────────────────────────────\n34: // 4. PACKAGE REGISTRY\n35: // ───────────────────────────────────────────────────────────────────\n36: const DIST_PACKAGES = Object.freeze([\n37:   {\n38:     id: 'system-spec-kit/shared',\n39:     name: '@spec-kit/shared',\n40:     root: '.skilled/skills/system-spec-kit/shared',\n41:     distEntries: { default: 'dist/tsconfig.tsbuildinfo' },\n42:     rebuildCommand: 'cd .skilled/skills/system-spec-kit/shared && npm run build',\n43:     sourceCandidates: ['.'],\n44:   },\n45:   {\n46:     id: 'system-spec-kit/runtime/cli',\n47:     name: '@spec-kit/cli',\n48:     root: '.skilled/skills/system-spec-kit/runtime/cli',\n49:     distEntries: {\n50:       default: 'dist/tsconfig.tsbuildinfo',\n51:       'is-phase-parent': 'dist/spec/is-phase-parent.js',\n52:     },\n53:     rebuildCommand: 'cd .skilled/skills/system-spec-kit/runtime/cli && npm run build',\n54:     sourceCandidates: ['.'],\n55:     // is-phase-parent.ts imports only Node builtins (fs, path) -- no local\n56:     // project dependencies -- so its own freshness check is scoped to just\n57:     // that one file rather than the whole cli/ tree. This keeps the\n58:     // child-drift guard immune to unrelated concurrent edits anywhere else\n59:     // under cli/, which the whole-tree 'default' entry is not.\n60:     entrySourceCandidates: {\n61:       'is-phase-parent': ['package.json', 'tsconfig.json', 'spec/is-phase-parent.ts'],\n62:     },\n63:     // retrieval/fixtures is rewritten by every trigger-index run; it is generator\n64:     // output that happens to live beside the generator, not a build input.\n65:     excludedSegments: ['tests', 'test-fixtures', 'fixtures'],\n66:   },\n67:   {\n68:     id: 'system-spec-kit/runtime',\n69:     name: '@spec-kit/runtime',\n70:     root: '.skilled/skills/system-spec-kit/runtime',\n71:     distEntries: {\n72:       default: 'dist/tsconfig.tsbuildinfo',\n73:       'validation-orchestrator': 'dist/lib/validation/orchestrator.js',\n74:     },\n75:     rebuildCommand: 'cd .skilled/skills/system-spec-kit/runtime && npm run build',\n76:     sourceCandidates: [\n77:       'package.json',\n78:       'tsconfig.json',\n79:       'api',\n80:       'core',\n81:       'handlers',\n82:       'hooks',\n83:       'lib',\n84:       // runtime/scripts is the engine's own build tooling (finalize-dist, test\n85:       // runners), not the CLI workspace, which lives at runtime/cli.\n86:       'scripts',\n87:     ],\n88:     entrySourceCandidates: {\n89:       'validation-orchestrator': [\n90:         'package.json',\n91:         'tsconfig.json',\n92:         'lib/validation',\n93:         'lib/templates',\n94:         'lib/spec',\n95:         'lib/graph',\n96:         'lib/config',\n97:         'lib/description',\n98:       ],\n99:     },\n100:     excludedSegments: ['tests', 'stress-test'],\n101:   },\n102:   {\n103:     id: 'mcp-code-mode/mcp-server',\n104:     name: '@utcp/code-mode-mcp',\n105:     root: '.skilled/skills/mcp-code-mode/mcp-server',\n106:     distEntries: { default: 'dist/index.js' },\n107:     rebuildCommand: 'cd .skilled/skills/mcp-code-mode/mcp-server && npm run build',\n108:     sourceCandidates: ['package.json', 'tsconfig.json', 'index.ts'],\n109:   },\n110:   {\n111:     id: 'system-skill-advisor/runtime',\n112:     name: '@spec-kit/system-skill-advisor',\n113:     root: '.skilled/skills/system-skill-advisor/runtime',\n114:     distEntries: {\n115:       default: 'dist/runtime/advisor-server.js',\n116:       'skill-advisor-cli': 'dist/runtime/skill-advisor-cli.js',\n117:     },\n118:     rebuildCommand: 'cd .skilled/skills/system-skill-advisor/runtime && npm run build',\n119:     sourceCandidates: [\n120:       'package.json',\n121:       'tsconfig.json',\n122:       'tsconfig.build.json',\n123:       '../hooks',\n124:       'advisor-server.ts',\n125:       'skill-advisor-cli.ts',\n126:       'skill-advisor-cli-manifest.ts',\n127:       'compat',\n128:       'handlers',\n129:       'lib',\n130:       'schemas',\n131:       'tools',\n132:       'data',\n133:     ],\n134:     entrySourceCandidates: {\n135:       'skill-advisor-cli': [\n136:         'package.json',\n137:         'tsconfig.json',\n138:         'tsconfig.build.json',\n139:         'skill-advisor-cli.ts',\n140:         'skill-advisor-cli-manifest.ts',\n141:         'schemas/advisor-tool-schemas.ts',\n142:         'tools',\n143:       ],\n144:     },\n145:     excludedSegments: ['tests', 'stress-test', 'bench', '__tests__'],\n146:   },\n147:   {\n148:     id: 'sk-design-md-generator/backend',\n149:     name: 'design-system-extractor',\n150:     root: '.skilled/skills/sk-design/sk-design-md-generator/backend',\n151:     distEntries: { default: 'dist/cli.js' },\n152:     rebuildCommand: 'cd .skilled/skills/sk-design/sk-design-md-generator/backend && npm run build',\n153:     sourceCandidates: ['package.json', 'tsconfig.json', 'tsconfig.build.json', 'scripts'],\n154:     excludedSegments: ['tests', 'output'],\n155:   },\n156: ]);\n157: \n158: // ───────────────────────────────────────────────────────────────────\n159: // 5. HELPERS\n160: // ───────────────────────────────────────────────────────────────────\n161: function workspaceRootFromOptions(options = {}) {\n162:   return path.resolve(options.workspaceRoot || WORKSPACE_ROOT);\n163: }\n164: \n165: function packageById(packageId) {\n166:   return DIST_PACKAGES.find((pkg) => pkg.id === packageId) || null;\n167: }\n168: \n169: function packageRoot(workspaceRoot, pkg) {\n170:   return path.resolve(workspaceRoot, pkg.root);\n171: }\n172: \n173: // A package is buildable in THIS checkout only when its own manifest and its\n174: // installed dependencies are both present. Each package's dist/ and node_modules\n175: // are gitignored and populated per-checkout — by a local build, or by the\n176: // launch-wrapper symlinking them from the main tree. A bare worktree that ran\n177: // neither has neither, so its rebuildCommand (`npm run build`) cannot succeed\n178: // here. That is a provisioning gap, not source drift: reporting it as \"stale\"\n179: // makes the guard warn (or attempt a doomed rebuild) about work it is powerless\n180: // to do in this checkout. Distinguishing the two keeps the guard silent where\n181: // it cannot help and fully active where it can.\n182: //\n183: // A workspace install hoists dependencies to an ancestor, so the package itself\n184: // often holds no node_modules while its imports resolve fine. The walk therefore\n185: // climbs to the workspace root and no further: a node_modules above that root\n186: // belongs to another checkout and could never satisfy this one's imports.\n187: function isPackageProvisioned(root, workspaceRoot) {\n188:   if (!fs.existsSync(path.join(root, 'package.json'))) return false;\n189:   const boundary = path.resolve(workspaceRoot);\n190:   const relative = path.relative(boundary, path.resolve(root));\n191:   const inside = relative && !relative.startsWith('..') && !path.isAbsolute(relative);\n192:   const depth = inside ? relative.split(path.sep).length : 0;\n193:   let current = path.resolve(root);\n194:   for (let step = 0; step <= depth; step += 1) {\n195:     if (fs.existsSync(path.join(current, 'node_modules'))) return true;\n196:     current = path.dirname(current);\n197:   }\n198:   return false;\n199: }\n200: \n201: function unprovisionedResult(pkg, root, distEntry, entry) {\n202:   return {\n203:     packageId: pkg.id,\n204:     packageName: pkg.name,\n205:     status: 'unprovisioned',\n206:     stale: false,\n207:     packageRoot: root,\n208:     distEntry: distEntry || null,\n209:     entry,\n210:     rebuildCommand: pkg.rebuildCommand,\n211:     message: `${pkg.name} is not provisioned in this checkout (no package.json, or no node_modules up to the workspace root); dist freshness cannot be assessed or rebuilt here`,\n212:   };\n213: }\n214: \n215: function normalizeEntryName(pkg, entryName = 'default') {\n216:   if (pkg.distEntries[entryName]) return entryName;\n217:   if (entryName === 'default') return 'default';\n218:   return null;\n219: }\n220: \n221: function distEntryFor(pkg, root, entryName = 'default') {\n222:   const normalizedEntry = normalizeEntryName(pkg, entryName);\n223:   if (!normalizedEntry) return null;\n224:   return path.join(root, pkg.distEntries[normalizedEntry]);\n225: }\n226: \n227: function shouldSkipPath(filePath, root, pkg) {\n228:   const relative = path.relative(root, filePath);\n229:   const segments = relative.split(path.sep);\n230:   const excluded = new Set([...DEFAULT_EXCLUDED_SEGMENTS, ...(pkg.excludedSegments || [])]);\n231:   return segments.some((segment) => excluded.has(segment));\n232: }\n233: \n234: function sourceExtensionsFor(pkg) {\n235:   return new Set(pkg.sourceExtensions || [...SOURCE_EXTENSIONS]);\n236: }\n237: \n238: function isWatchedSourceFile(filePath, pkg) {\n239:   return sourceExtensionsFor(pkg).has(path.extname(filePath)) || MANIFEST_BASENAMES.has(path.basename(filePath));\n240: }\n241: \n242: function sourceCandidatesFor(pkg, entryName) {\n243:   return pkg.entrySourceCandidates?.[entryName] || pkg.sourceCandidates;\n244: }\n245: \n246: function collectSourceFiles(pkg, root, entryName) {\n247:   const files = [];\n248:   const missing = [];\n249:   const visitedRealPaths = new Set();\n250: \n251:   const visit = (candidate) => {\n252:     if (!fs.existsSync(candidate)) {\n253:       missing.push(candidate);\n254:       return;\n255:     }\n256:     const realPath = fs.realpathSync(candidate);\n257:     if (visitedRealPaths.has(realPath)) return;\n258:     visitedRealPaths.add(realPath);\n259:     const stat = fs.statSync(candidate);\n260:     if (stat.isDirectory()) {\n261:       if (shouldSkipPath(candidate, root, pkg)) return;\n262:       for (const entry of fs.readdirSync(candidate)) {\n263:         const child = path.join(candidate, entry);\n264:         // A symlinked directory points at another package's tree (for example\n265:         // scripts/runtime -> ../runtime/dist). Its contents are that package's\n266:         // outputs, not this package's sources, so descending would make every\n267:         // rebuild there flag this package stale. A dangling link (the target\n268:         // not built yet on a fresh checkout) is skipped the same way rather\n269:         // than turning the whole freshness check into an error.\n270:         if (fs.lstatSync(child).isSymbolicLink()) {\n271:           let target = null;\n272:           try {\n273:             target = fs.statSync(child);\n274:           } catch (_) {\n275:             continue;\n276:           }\n277:           if (target.isDirectory()) continue;\n278:         }\n279:         visit(child);\n280:       }\n281:       return;\n282:     }\n283:     if (!stat.isFile() || shouldSkipPath(candidate, root, pkg)) return;\n284:     if (isWatchedSourceFile(candidate, pkg)) files.push(candidate);\n285:   };\n286: \n287:   for (const candidate of sourceCandidatesFor(pkg, entryName)) {\n288:     visit(path.resolve(root, candidate));\n289:   }\n290: \n291:   return { files, missing };\n292: }\n293: \n294: function hashSourceFiles(root, sources) {\n295:   const hash = crypto.createHash('sha256');\n296:   for (const filePath of [...sources].sort()) {\n297:     hash.update(path.relative(root, filePath));\n298:     hash.update('\\0');\n299:     hash.update(fs.readFileSync(filePath));\n300:     hash.update('\\0');\n301:   }\n302:   return hash.digest('hex');\n303: }\n304: \n305: function hashFile(filePath) {\n306:   return crypto.createHash('sha256').update(fs.readFileSync(filePath)).digest('hex');\n307: }\n308: \n309: function cachePathFor(root, distEntry, pkg, entryName) {\n310:   const suffix = crypto.createHash('sha1').update(`${pkg.id}:${entryName}:${distEntry}`).digest('hex').slice(0, 12);\n311:   const safeId = pkg.id.replace(/[^a-z0-9_-]+/gi, '-');\n312:   return path.join(path.dirname(distEntry), `.dist-freshness-${safeId}-${suffix}.json`);\n313: }\n314: \n315: function readStoredBuildRecord(cachePath) {\n316:   try {\n317:     const parsed = JSON.parse(fs.readFileSync(cachePath, 'utf8'));\n318:     return parsed && typeof parsed === 'object' && typeof parsed.sourceHash === 'string' ? parsed : null;\n319:   } catch (_) {\n320:     return null;\n321:   }\n322: }\n323: \n324: function cleanupCacheTemps(cachePath) {\n325:   try {\n326:     const directory = path.dirname(cachePath);\n327:     const basename = path.basename(cachePath);\n328:     const now = Date.now();\n329:     for (const entry of fs.readdirSync(directory)) {\n330:       if (!entry.startsWith(`${basename}.`) || !/^\\d+(?:-[a-f0-9]+)?\\.tmp$/.test(entry.slice(basename.length + 1))) continue;\n331:       const tempPath = path.join(directory, entry);\n332:       if ((now - fs.statSync(tempPath).mtimeMs) > CACHE_TEMP_MAX_AGE_MS) fs.unlinkSync(tempPath);\n333:     }\n334:   } catch (_) {\n335:     // Cleanup is best-effort so cache maintenance cannot affect freshness checks.\n336:   }\n337: }\n338: \n339: function writeStoredBuildRecord(cachePath, record) {\n340:   let tempPath = null;\n341:   let wasWritten = false;\n342:   try {\n343:     fs.mkdirSync(path.dirname(cachePath), { recursive: true });\n344:     cleanupCacheTemps(cachePath);\n345:     const token = crypto.randomBytes(6).toString('hex');\n346:     tempPath = `${cachePath}.${process.pid}-${token}.tmp`;\n347:     fs.writeFileSync(tempPath, `${JSON.stringify(record)}\\n`);\n348:     fs.renameSync(tempPath, cachePath);\n349:     tempPath = null;\n350:     wasWritten = true;\n351:   } catch (_) {\n352:     // Cache writes are an optimization; staleness detection remains conservative.\n353:   } finally {\n354:     if (tempPath) {\n355:       try {\n356:         fs.unlinkSync(tempPath);\n357:       } catch (_) {\n358:         // A failed cleanup is pruned by a later cache write after the age guard.\n359:       }\n360:     }\n361:   }\n362:   return wasWritten;\n363: }\n364: \n365: function pendingBuildPath(cachePath) {\n366:   return `${cachePath}.pending`;\n367: }\n368: \n369: function rebuildMessage(pkg, state, detail = null) {\n370:   const suffix = detail ? ` (${detail})` : '';\n371:   return `${pkg.name} dist is ${state}${suffix}. Rebuild with: ${pkg.rebuildCommand}`;\n372: }\n373: \n374: // ───────────────────────────────────────────────────────────────────\n375: // 6. CORE LOGIC\n376: // ───────────────────────────────────────────────────────────────────\n377: function writePackageSourceHashCache(packageId, options = {}) {\n378:   const workspaceRoot = workspaceRootFromOptions(options);\n379:   const pkg = packageById(packageId);\n380:   if (!pkg) return freshnessError(null, `Unknown dist package: ${packageId}`);\n381: \n382:   const root = packageRoot(workspaceRoot, pkg);\n383:   if (!fs.existsSync(root)) {\n384:     return freshnessError(pkg, `Watched package root is missing: ${root}`, { packageRoot: root });\n385:   }\n386: \n387:   const entryName = options.entry || 'default';\n388:   const normalizedEntry = normalizeEntryName(pkg, entryName);\n389:   if (!normalizedEntry) {\n390:     return freshnessError(pkg, `Unknown dist entry \"${entryName}\" for ${pkg.id}`, { packageRoot: root });\n391:   }\n392: \n393:   const distEntry = distEntryFor(pkg, root, normalizedEntry);\n394:   if (!distEntry || !fs.existsSync(distEntry)) {\n395:     return {\n396:       packageId: pkg.id,\n397:       packageName: pkg.name,\n398:       status: 'missing',\n399:       stale: true,\n400:       packageRoot: root,\n401:       distEntry,\n402:       entry: normalizedEntry,\n403:       rebuildCommand: pkg.rebuildCommand,\n404:       message: rebuildMessage(pkg, 'missing', distEntry),\n405:     };\n406:   }\n407: \n408:   try {\n409:     const { files, missing } = collectSourceFiles(pkg, root, normalizedEntry);\n410:     if (missing.length > 0) {\n411:       return freshnessError(\n412:         pkg,\n413:         `Watched source path is missing for ${pkg.id}: ${missing.map((item) => path.relative(workspaceRoot, item)).join(', ')}`,\n414:         { packageRoot: root, distEntry, entry: normalizedEntry, missingSourcePaths: missing },\n415:       );\n416:     }\n417:     if (files.length === 0) {\n418:       return freshnessError(pkg, `No watched source files found for ${pkg.id}`, {\n419:         packageRoot: root,\n420:         distEntry,\n421:         entry: normalizedEntry,\n422:       });\n423:     }\n424: \n425:     const sourceHash = hashSourceFiles(root, files);\n426:     const cachePath = cachePathFor(root, distEntry, pkg, normalizedEntry);\n427:     const distHash = hashFile(distEntry);\n428:     const wasWritten = writeStoredBuildRecord(cachePath, {\n429:       version: CACHE_VERSION,\n430:       origin: 'checker',\n431:       sourceHash,\n432:       distHash,\n433:     });\n434:     if (!wasWritten) {\n435:       return freshnessError(pkg, `Dist freshness cache write failed for ${pkg.id}`, {\n436:         packageRoot: root,\n437:         distEntry,\n438:         entry: normalizedEntry,\n439:       });\n440:     }\n441:     return {\n442:       packageId: pkg.id,\n443:       packageName: pkg.name,\n444:       status: 'cached',\n445:       stale: false,\n446:       packageRoot: root,\n447:       distEntry,\n448:       entry: normalizedEntry,\n449:       rebuildCommand: pkg.rebuildCommand,\n450:       sourceCount: files.length,\n451:       cachePath,\n452:       sourceHash,\n453:       distHash,\n454:       origin: 'checker',\n455:       message: `${pkg.name} dist freshness cache written`,\n456:     };\n457:   } catch (error) {\n458:     return freshnessError(pkg, `Dist freshness cache write failed for ${pkg.id}: ${error.message}`, {\n459:       packageRoot: root,\n460:       distEntry,\n461:       entry: normalizedEntry,\n462:     });\n463:   }\n464: }\n465: \n466: function preparePackageBuild(packageId, options = {}) {\n467:   const workspaceRoot = workspaceRootFromOptions(options);\n468:   const pkg = packageById(packageId);\n469:   if (!pkg) return freshnessError(null, `Unknown dist package: ${packageId}`);\n470: \n471:   const root = packageRoot(workspaceRoot, pkg);\n472:   if (!fs.existsSync(root)) {\n473:     return freshnessError(pkg, `Watched package root is missing: ${root}`, { packageRoot: root });\n474:   }\n475: \n476:   const entryName = options.entry || 'default';\n477:   const normalizedEntry = normalizeEntryName(pkg, entryName);\n478:   if (!normalizedEntry) {\n479:     return freshnessError(pkg, `Unknown dist entry \"${entryName}\" for ${pkg.id}`, { packageRoot: root });\n480:   }\n481: \n482:   const distEntry = distEntryFor(pkg, root, normalizedEntry);\n483:   try {\n484:     const { files, missing } = collectSourceFiles(pkg, root, normalizedEntry);\n485:     if (missing.length > 0) {\n486:       return freshnessError(\n487:         pkg,\n488:         `Watched source path is missing for ${pkg.id}: ${missing.map((item) => path.relative(workspaceRoot, item)).join(', ')}`,\n489:         { packageRoot: root, distEntry, entry: normalizedEntry, missingSourcePaths: missing },\n490:       );\n491:     }\n492:     if (files.length === 0) {\n493:       return freshnessError(pkg, `No watched source files found for ${pkg.id}`, {\n494:         packageRoot: root,\n495:         distEntry,\n496:         entry: normalizedEntry,\n497:       });\n498:     }\n499: \n500:     const sourceHash = hashSourceFiles(root, files);\n501:     const cachePath = cachePathFor(root, distEntry, pkg, normalizedEntry);\n502:     const pendingPath = pendingBuildPath(cachePath);\n503:     const wasPrepared = writeStoredBuildRecord(pendingPath, {\n504:       version: CACHE_VERSION,\n505:       origin: 'prepare',\n506:       packageId: pkg.id,\n507:       entry: normalizedEntry,\n508:       sourceHash,\n509:     });\n510:     if (!wasPrepared) {\n511:       return freshnessError(pkg, `Dist freshness build preparation could not be stored for ${pkg.id}`, {\n512:         packageRoot: root,\n513:         distEntry,\n514:         entry: normalizedEntry,\n515:       });\n516:     }\n517:     return {\n518:       packageId: pkg.id,\n519:       packageName: pkg.name,\n520:       status: 'prepared',\n521:       stale: false,\n522:       packageRoot: root,\n523:       distEntry,\n524:       entry: normalizedEntry,\n525:       rebuildCommand: pkg.rebuildCommand,\n526:       sourceCount: files.length,\n527:       cachePath,\n528:       pendingPath,\n529:       sourceHash,\n530:       message: `${pkg.name} dist build preparation recorded`,\n531:     };\n532:   } catch (error) {\n533:     return freshnessError(pkg, `Dist freshness build preparation failed for ${pkg.id}: ${error.message}`, {\n534:       packageRoot: root,\n535:       distEntry,\n536:       entry: normalizedEntry,\n537:     });\n538:   }\n539: }\n540: \n541: function recordPackageBuild(packageId, options = {}) {\n542:   const workspaceRoot = workspaceRootFromOptions(options);\n543:   const pkg = packageById(packageId);\n544:   if (!pkg) return freshnessError(null, `Unknown dist package: ${packageId}`);\n545: \n546:   const root = packageRoot(workspaceRoot, pkg);\n547:   if (!fs.existsSync(root)) {\n548:     return freshnessError(pkg, `Watched package root is missing: ${root}`, { packageRoot: root });\n549:   }\n550: \n551:   const entryName = options.entry || 'default';\n552:   const normalizedEntry = normalizeEntryName(pkg, entryName);\n553:   if (!normalizedEntry) {\n554:     return freshnessError(pkg, `Unknown dist entry \"${entryName}\" for ${pkg.id}`, { packageRoot: root });\n555:   }\n556: \n557:   const distEntry = distEntryFor(pkg, root, normalizedEntry);\n558:   if (!distEntry || !fs.existsSync(distEntry)) {\n559:     return freshnessError(pkg, `Built dist entry is missing for ${pkg.id}: ${distEntry}`, {\n560:       packageRoot: root,\n561:       distEntry,\n562:       entry: normalizedEntry,\n563:     });\n564:   }\n565: \n566:   try {\n567:     const { files, missing } = collectSourceFiles(pkg, root, normalizedEntry);\n568:     if (missing.length > 0 || files.length === 0) {\n569:       return freshnessError(pkg, `Cannot attest ${pkg.id}; watched build inputs are unavailable`, {\n570:         packageRoot: root,\n571:         distEntry,\n572:         entry: normalizedEntry,\n573:         missingSourcePaths: missing,\n574:       });\n575:     }\n576: \n577:     const cachePath = cachePathFor(root, distEntry, pkg, normalizedEntry);\n578:     const pendingPath = pendingBuildPath(cachePath);\n579:     const pending = readStoredBuildRecord(pendingPath);\n580:     if (pending?.version !== CACHE_VERSION || pending.origin !== 'prepare'\n581:       || pending.packageId !== pkg.id || pending.entry !== normalizedEntry) {\n582:       return freshnessError(pkg, `No valid prepared build record exists for ${pkg.id}:${normalizedEntry}`, {\n583:         packageRoot: root,\n584:         distEntry,\n585:         entry: normalizedEntry,\n586:       });\n587:     }\n588: \n589:     const sourceHash = hashSourceFiles(root, files);\n590:     if (sourceHash !== pending.sourceHash) {\n591:       return freshnessError(pkg, `Watched source content changed while building ${pkg.id}:${normalizedEntry}`, {\n592:         packageRoot: root,\n593:         distEntry,\n594:         entry: normalizedEntry,\n595:       });\n596:     }\n597:     const distHash = hashFile(distEntry);\n598:     if (hashSourceFiles(root, files) !== pending.sourceHash) {\n599:       return freshnessError(pkg, `Watched source content changed while finalizing ${pkg.id}:${normalizedEntry}`, {\n600:         packageRoot: root,\n601:         distEntry,\n602:         entry: normalizedEntry,\n603:       });\n604:     }\n605: \n606:     const wasRecorded = writeStoredBuildRecord(cachePath, {\n607:       version: CACHE_VERSION,\n608:       origin: 'build',\n609:       sourceHash,\n610:       distHash,\n611:     });\n612:     if (!wasRecorded) {\n613:       return freshnessError(pkg, `Dist freshness build attestation could not be stored for ${pkg.id}`, {\n614:         packageRoot: root,\n615:         distEntry,\n616:         entry: normalizedEntry,\n617:       });\n618:     }\n619:     try {\n620:       fs.unlinkSync(pendingPath);\n621:     } catch (_) {\n622:       // The promoted record is authoritative; a leftover preparation is harmless.\n623:     }\n624:     return {\n625:       packageId: pkg.id,\n626:       packageName: pkg.name,\n627:       status: 'recorded',\n628:       stale: false,\n629:       packageRoot: root,\n630:       distEntry,\n631:       entry: normalizedEntry,\n632:       rebuildCommand: pkg.rebuildCommand,\n633:       sourceCount: files.length,\n634:       cachePath,\n635:       sourceHash,\n636:       distHash,\n637:       origin: 'build',\n638:       message: `${pkg.name} dist build attestation recorded`,\n639:     };\n640:   } catch (error) {\n641:     return freshnessError(pkg, `Dist freshness build attestation failed for ${pkg.id}: ${error.message}`, {\n642:       packageRoot: root,\n643:       distEntry,\n644:       entry: normalizedEntry,\n645:     });\n646:   }\n647: }\n648: \n649: function freshnessError(pkg, message, extra = {}) {\n650:   return {\n651:     packageId: pkg?.id || null,\n652:     packageName: pkg?.name || null,\n653:     status: 'error',\n654:     stale: false,\n655:     message,\n656:     rebuildCommand: pkg?.rebuildCommand || null,\n657:     ...extra,\n658:   };\n659: }\n660: \n661: function checkPackageFreshness(packageId, options = {}) {\n662:   const workspaceRoot = workspaceRootFromOptions(options);\n663:   const pkg = packageById(packageId);\n664:   if (!pkg) return freshnessError(null, `Unknown dist package: ${packageId}`);\n665: \n666:   const root = packageRoot(workspaceRoot, pkg);\n667:   if (!fs.existsSync(root)) {\n668:     return freshnessError(pkg, `Watched package root is missing: ${root}`, { packageRoot: root });\n669:   }\n670: \n671:   const entryName = options.entry || 'default';\n672:   const normalizedEntry = normalizeEntryName(pkg, entryName);\n673:   if (!normalizedEntry) {\n674:     return freshnessError(pkg, `Unknown dist entry \"${entryName}\" for ${pkg.id}`, { packageRoot: root });\n675:   }\n676: \n677:   const provisioned = isPackageProvisioned(root, workspaceRoot);\n678: \n679:   const distEntry = distEntryFor(pkg, root, normalizedEntry);\n680:   if (!distEntry || !fs.existsSync(distEntry)) {\n681:     if (!provisioned) return unprovisionedResult(pkg, root, distEntry, normalizedEntry);\n682:     return {\n683:       packageId: pkg.id,\n684:       packageName: pkg.name,\n685:       status: 'missing',\n686:       stale: true,\n687:       packageRoot: root,\n688:       distEntry,\n689:       entry: normalizedEntry,\n690:       rebuildCommand: pkg.rebuildCommand,\n691:       message: rebuildMessage(pkg, 'missing', distEntry),\n692:     };\n693:   }\n694: \n695:   if (options.allowStale) {\n696:     return {\n697:       packageId: pkg.id,\n698:       packageName: pkg.name,\n699:       status: 'fresh',\n700:       stale: false,\n701:       packageRoot: root,\n702:       distEntry,\n703:       entry: normalizedEntry,\n704:       rebuildCommand: pkg.rebuildCommand,\n705:       message: `${pkg.name} dist freshness check bypassed by caller option`,\n706:     };\n707:   }\n708: \n709:   try {\n710:     const { files, missing } = collectSourceFiles(pkg, root, normalizedEntry);\n711:     if (missing.length > 0) {\n712:       return freshnessError(\n713:         pkg,\n714:         `Watched source path is missing for ${pkg.id}: ${missing.map((item) => path.relative(workspaceRoot, item)).join(', ')}`,\n715:         { packageRoot: root, distEntry, entry: normalizedEntry, missingSourcePaths: missing },\n716:       );\n717:     }\n718:     if (files.length === 0) {\n719:       return freshnessError(pkg, `No watched source files found for ${pkg.id}`, {\n720:         packageRoot: root,\n721:         distEntry,\n722:         entry: normalizedEntry,\n723:       });\n724:     }\n725: \n726:     const sourceHash = hashSourceFiles(root, files);\n727:     const cachePath = cachePathFor(root, distEntry, pkg, normalizedEntry);\n728:     const distHash = hashFile(distEntry);\n729:     const stored = readStoredBuildRecord(cachePath);\n730:     if (stored?.version === CACHE_VERSION && stored.origin === 'build') {\n731:       if (stored.sourceHash !== sourceHash) {\n732:         if (!provisioned) return unprovisionedResult(pkg, root, distEntry, normalizedEntry);\n733:         return {\n734:           packageId: pkg.id,\n735:           packageName: pkg.name,\n736:           status: 'stale',\n737:           stale: true,\n738:           packageRoot: root,\n739:           distEntry,\n740:           entry: normalizedEntry,\n741:           rebuildCommand: pkg.rebuildCommand,\n742:           sourceCount: files.length,\n743:           message: rebuildMessage(pkg, 'stale', 'source content differs from the attested build'),\n744:         };\n745:       }\n746:       if (typeof stored.distHash !== 'string' || stored.distHash !== distHash) {\n747:         if (!provisioned) return unprovisionedResult(pkg, root, distEntry, normalizedEntry);\n748:         return {\n749:           packageId: pkg.id,\n750:           packageName: pkg.name,\n751:           status: 'stale',\n752:           stale: true,\n753:           packageRoot: root,\n754:           distEntry,\n755:           entry: normalizedEntry,\n756:           rebuildCommand: pkg.rebuildCommand,\n757:           sourceCount: files.length,\n758:           message: rebuildMessage(pkg, 'stale', 'dist content differs from the attested build'),\n759:         };\n760:       }\n761:       return {\n762:         packageId: pkg.id,\n763:         packageName: pkg.name,\n764:         status: 'fresh',\n765:         stale: false,\n766:         packageRoot: root,\n767:         distEntry,\n768:         entry: normalizedEntry,\n769:         rebuildCommand: pkg.rebuildCommand,\n770:         sourceCount: files.length,\n771:         origin: 'build',\n772:         message: `${pkg.name} dist is fresh`,\n773:       };\n774:     }\n775:     if (stored?.version === CACHE_VERSION && stored.sourceHash === sourceHash && stored.distHash === distHash) {\n776:       return {\n777:         packageId: pkg.id,\n778:         packageName: pkg.name,\n779:         status: 'fresh',\n780:         stale: false,\n781:         packageRoot: root,\n782:         distEntry,\n783:         entry: normalizedEntry,\n784:         rebuildCommand: pkg.rebuildCommand,\n785:         sourceCount: files.length,\n786:         origin: stored.origin || 'checker',\n787:         message: `${pkg.name} dist is fresh`,\n788:       };\n789:     }\n790: \n791:     let newestSourceFile = files[0];\n792:     let newestSourceMtime = fs.statSync(newestSourceFile).mtimeMs;\n793:     for (const filePath of files.slice(1)) {\n794:       const fileMtime = fs.statSync(filePath).mtimeMs;\n795:       if (fileMtime > newestSourceMtime) {\n796:         newestSourceMtime = fileMtime;\n797:         newestSourceFile = filePath;\n798:       }\n799:     }\n800:     const distMtime = fs.statSync(distEntry).mtimeMs;\n801:     if (newestSourceMtime > distMtime) {\n802:       if (!provisioned) return unprovisionedResult(pkg, root, distEntry, normalizedEntry);\n803:       return {\n804:         packageId: pkg.id,\n805:         packageName: pkg.name,\n806:         status: 'stale',\n807:         stale: true,\n808:         packageRoot: root,\n809:         distEntry,\n810:         entry: normalizedEntry,\n811:         rebuildCommand: pkg.rebuildCommand,\n812:         sourceCount: files.length,\n813:         newestSourceMtime,\n814:         newestSourceFile,\n815:         distMtime,\n816:         message: rebuildMessage(pkg, 'stale'),\n817:       };\n818:     }\n819: \n820:     // A read-only caller asks for the verdict without this write, because a gate\n821:     // run promises to leave the tree untouched and the record sits beside the\n822:     // dist entry. The default stays writable: the session-start self-heal reads\n823:     // the record first and would pay a full source hash on every run without it.\n824:     if (!options.readOnly) {\n825:       writeStoredBuildRecord(cachePath, {\n826:         version: CACHE_VERSION,\n827:         origin: 'checker',\n828:         sourceHash,\n829:         distHash,\n830:       });\n831:     }\n832:     return {\n833:       packageId: pkg.id,\n834:       packageName: pkg.name,\n835:       status: 'fresh',\n836:       stale: false,\n837:       packageRoot: root,\n838:       distEntry,\n839:       entry: normalizedEntry,\n840:       rebuildCommand: pkg.rebuildCommand,\n841:       sourceCount: files.length,\n842:       newestSourceMtime,\n843:       newestSourceFile,\n844:       distMtime,\n845:       origin: 'checker',\n846:       message: `${pkg.name} dist is fresh`,\n847:     };\n848:   } catch (error) {\n849:     return freshnessError(pkg, `Dist freshness checker failed for ${pkg.id}: ${error.message}`, {\n850:       packageRoot: root,\n851:       distEntry,\n852:       entry: normalizedEntry,\n853:     });\n854:   }\n855: }\n856: \n857: // Options reach every package check unchanged, so a caller that asks for the\n858: // read-only path gets it across the whole registry rather than per package.\n859: function checkAllFreshness(options = {}) {\n860:   return DIST_PACKAGES.map((pkg) => checkPackageFreshness(pkg.id, options));\n861: }\n862: \n863: function sourceContainsFile(workspaceRoot, pkg, filePath) {\n864:   const root = packageRoot(workspaceRoot, pkg);\n865:   const absoluteFile = path.resolve(filePath);\n866:   if (!fs.existsSync(root) || !isWatchedSourceFile(absoluteFile, pkg)) return false;\n867:   if (shouldSkipPath(absoluteFile, root, pkg)) return false;\n868:   return pkg.sourceCandidates.some((candidate) => {\n869:     const candidatePath = path.resolve(root, candidate);\n870:     if (!fs.existsSync(candidatePath)) return false;\n871:     const stat = fs.statSync(candidatePath);\n872:     if (stat.isDirectory()) {\n873:       const relative = path.relative(candidatePath, absoluteFile);\n874:       return relative && !relative.startsWith('..') && !path.isAbsolute(relative);\n875:     }\n876:     return candidatePath === absoluteFile;\n877:   });\n878: }\n879: \n880: // A built file is not source, so the source lookup cannot answer for it. A path\n881: // under a package's own dist folder belongs to the package that produced it, and\n882: // the longest matching root wins where one package root sits inside another's.\n883: function isUnderDistOutput(workspaceRoot, pkg, filePath) {\n884:   const root = packageRoot(workspaceRoot, pkg);\n885:   const relative = path.relative(root, filePath);\n886:   if (!relative || relative.startsWith('..') || path.isAbsolute(relative)) return false;\n887:   const [first, ...rest] = relative.split(path.sep);\n888:   const distFolders = new Set(Object.values(pkg.distEntries).map((entry) => entry.split('/')[0]));\n889:   return rest.length > 0 && distFolders.has(first);\n890: }\n891: \n892: function distEntryNameFor(pkg, root, filePath) {\n893:   for (const [entryName, relativeEntry] of Object.entries(pkg.distEntries)) {\n894:     if (path.resolve(root, relativeEntry) === filePath) return entryName;\n895:   }\n896:   return 'default';\n897: }\n898: \n899: function packageForDistFile(filePath, options = {}) {\n900:   const workspaceRoot = workspaceRootFromOptions(options);\n901:   const absoluteFile = path.resolve(filePath);\n902:   let match = null;\n903:   for (const pkg of DIST_PACKAGES) {\n904:     if (!isUnderDistOutput(workspaceRoot, pkg, absoluteFile)) continue;\n905:     const root = packageRoot(workspaceRoot, pkg);\n906:     if (!match || root.length > match.root.length) match = { pkg, root };\n907:   }\n908:   if (!match) return null;\n909:   return { pkg: match.pkg, entry: distEntryNameFor(match.pkg, match.root, absoluteFile) };\n910: }\n911: \n912: function packageForSourceFile(filePath, options = {}) {\n913:   const workspaceRoot = workspaceRootFromOptions(options);\n914:   return DIST_PACKAGES.find((pkg) => sourceContainsFile(workspaceRoot, pkg, filePath)) || null;\n915: }\n916: \n917: function checkFileFreshness(filePath, options = {}) {\n918:   const absoluteFile = path.resolve(filePath);\n919:   const sourcePackage = packageForSourceFile(filePath, options);\n920:   if (sourcePackage) return { ...checkPackageFreshness(sourcePackage.id, options), filePath: absoluteFile };\n921:   const distMatch = packageForDistFile(filePath, options);\n922:   if (!distMatch) {\n923:     return {\n924:       packageId: null,\n925:       packageName: null,\n926:       status: 'unmatched',\n927:       stale: false,\n928:       filePath: absoluteFile,\n929:       message: 'Edited file is not under a watched dist-producing source tree',\n930:     };\n931:   }\n932:   const entry = options.entry || distMatch.entry;\n933:   return { ...checkPackageFreshness(distMatch.pkg.id, { ...options, entry }), filePath: absoluteFile };\n934: }\n935: \n936: function formatWarning(result) {\n937:   if (!result || !result.stale) return '';\n938:   return `STALE DIST WARNING: ${result.packageName || result.packageId} -- run: ${result.rebuildCommand}`;\n939: }\n940: \n941: function formatCheckError(result) {\n942:   if (!result || result.status !== 'error') return '';\n943:   const name = result.packageName || result.packageId || 'unknown package';\n944:   return `DIST FRESHNESS CHECK ERROR: ${name} -- ${result.message}`;\n945: }\n946: \n947: function summarizeFreshness(results) {\n948:   const stale = results.filter((item) => item.stale);\n949:   const errors = results.filter((item) => item.status === 'error');\n950:   return {\n951:     status: stale.length > 0 ? 'stale' : errors.length > 0 ? 'degraded' : 'fresh',\n952:     stale: stale.length > 0,\n953:     degraded: errors.length > 0,\n954:     errors,\n955:     results,\n956:   };\n957: }\n958: \n959: // ───────────────────────────────────────────────────────────────────\n960: // 7. CLI ENTRY\n961: // ───────────────────────────────────────────────────────────────────\n962: function parseArgs(argv) {\n963:   const parsed = { positional: [], json: false, workspaceRoot: null, packageId: null, entry: null, filePath: null, readOnly: false };\n964:   for (let index = 0; index < argv.length; index += 1) {\n965:     const arg = argv[index];\n966:     if (arg === '--json') parsed.json = true;\n967:     else if (arg === '--workspace-root') parsed.workspaceRoot = argv[++index];\n968:     else if (arg === '--package') parsed.packageId = argv[++index];\n969:     else if (arg === '--entry') parsed.entry = argv[++index];\n970:     else if (arg === '--file') parsed.filePath = argv[++index];\n971:     else if (arg === '--no-write') parsed.readOnly = true;\n972:     else if (arg.startsWith('--')) {\n973:       // A misspelled option used to fall through to the positional list and run\n974:       // the default command as if the flag had never been passed.\n975:       process.stderr.write(`dist-freshness: unknown option: ${arg}\\n`);\n976:       process.stderr.write('Usage: dist-freshness.cjs <check|prepare-build|record-build|check-file|check-all|list> [options]\\n');\n977:       process.exit(64);\n978:     } else parsed.positional.push(arg);\n979:   }\n980:   return parsed;\n981: }\n982: \n983: function printResult(result, asJson) {\n984:   if (asJson) {\n985:     process.stdout.write(`${JSON.stringify(result)}\\n`);\n986:     return;\n987:   }\n988:   if (result.status === 'error') process.stderr.write(`DIST FRESHNESS CHECK ERROR: ${result.message}\\n`);\n989:   else if (Array.isArray(result.results)) {\n990:     const stale = result.results.filter((item) => item.stale).map(formatWarning).filter(Boolean);\n991:     const errors = result.results.filter((item) => item.status === 'error').map(formatCheckError).filter(Boolean);\n992:     if (stale.length > 0) process.stdout.write(`${stale.join('\\n')}\\n`);\n993:     if (errors.length > 0) process.stderr.write(`${errors.slice(0, 8).join('\\n')}\\n`);\n994:     if (stale.length === 0 && errors.length === 0) process.stdout.write('All watched dist outputs are fresh.\\n');\n995:   }\n996:   else process.stdout.write(`${result.message}\\n`);\n997: }\n998: \n999: function runCli() {\n1000:   const args = parseArgs(process.argv.slice(2));\n1001:   const command = args.positional[0] || 'check-all';\n1002:   const options = { workspaceRoot: args.workspaceRoot, entry: args.entry };\n1003:   // Only a check command reaches the cache write, so the read-only switch is\n1004:   // handed to those and never to the record commands, which exist to write one.\n1005:   const checkOptions = { ...options, readOnly: args.readOnly };\n1006:   let result;\n1007: \n1008:   if (command === 'check') {\n1009:     if (!args.packageId) {\n1010:       process.stderr.write('Usage: dist-freshness.cjs check --package <package-id> [--entry <entry>] [--json]\\n');\n1011:       process.exit(64);\n1012:     }\n1013:     result = checkPackageFreshness(args.packageId, checkOptions);\n1014:   } else if (command === 'prepare-build' || command === 'record-build') {\n1015:     if (!args.packageId) {\n1016:       process.stderr.write(`Usage: dist-freshness.cjs ${command} --package <package-id> [--entry <entry>] [--json]\\n`);\n1017:       process.exit(64);\n1018:     }\n1019:     result = command === 'prepare-build'\n1020:       ? preparePackageBuild(args.packageId, options)\n1021:       : recordPackageBuild(args.packageId, options);\n1022:   } else if (command === 'check-file') {\n1023:     if (!args.filePath) {\n1024:       process.stderr.write('Usage: dist-freshness.cjs check-file --file <path> [--json]\\n');\n1025:       process.exit(64);\n1026:     }\n1027:     result = checkFileFreshness(args.filePath, checkOptions);\n1028:   } else if (command === 'check-all') {\n1029:     result = summarizeFreshness(checkAllFreshness(checkOptions));\n1030:   } else if (command === 'list') {\n1031:     result = { status: 'ok', packages: DIST_PACKAGES };\n1032:   } else {\n1033:     process.stderr.write(`Unknown dist freshness command: ${command}\\n`);\n1034:     process.exit(64);\n1035:   }\n1036: \n1037:   printResult(result, args.json);\n1038:   if (result.stale) process.exit(STALE_EXIT_CODE);\n1039:   // An error result means the check could not verify freshness; exiting 0 let\n1040:   // callers that read only the exit code treat the failure as a pass.\n1041:   if (result.status === 'error') process.exit(1);\n1042:   process.exit(0);\n1043: }\n1044: \n1045: if (require.main === module) runCli();\n1046: \n1047: // ───────────────────────────────────────────────────────────────────\n1048: // 8. EXPORTS\n1049: // ───────────────────────────────────────────────────────────────────\n1050: module.exports = {\n1051:   DIST_PACKAGES,\n1052:   STALE_EXIT_CODE,\n1053:   checkAllFreshness,\n1054:   cachePathFor,\n1055:   checkFileFreshness,\n1056:   checkPackageFreshness,\n1057:   collectSourceFiles,\n1058:   formatCheckError,\n1059:   formatWarning,\n1060:   hashFile,\n1061:   hashSourceFiles,\n1062:   packageForDistFile,\n1063:   packageForSourceFile,\n1064:   preparePackageBuild,\n1065:   recordPackageBuild,\n1066:   summarizeFreshness,\n1067:   writePackageSourceHashCache,\n1068: };"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-spec-kit/runtime/cli/lib/dist-freshness.cjs\"}"},"time":{"start":1794559437184,"end":1794559437644}}}}
