y the allowlisted environment, the shell basics and each runtime's own prefixes plus the GitHub and git overrides. Verify: `rg -c \"head_moved\" $RA` prints at least 1, `rg -c \"arena_unprepared\" $RA` prints 1 and `rg -c \"allowlist\" $RA` prints at least 1.\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"pattern\":\"^- \\\\[ \\\\] T054 \",\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/specs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/014-review-remediation/tasks.md\"}"},"time":{"start":1794560959249,"end":1794560959798}}}}
