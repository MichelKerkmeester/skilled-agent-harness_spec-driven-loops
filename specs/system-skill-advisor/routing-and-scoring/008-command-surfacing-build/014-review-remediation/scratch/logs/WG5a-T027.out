{"type":"tool_use","timestamp":1794559471981,"sessionID":"ses_e2bed8c89ffeaoDJMekw21nJMc","part":{"partID":"prt_1d41470e80019b6jt2wVxIga0g","sessionID":"ses_e2bed8c89ffeaoDJMekw21nJMc","messageID":"msg_1d4144e84001WqFMAkUDSszHs9","type":"tool","id":"chatcmpl-tool-9666c2b40550ffd7","tool":"read","state":{"status":"completed","input":{"path":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/sk-doc/sk-create-repo-rule/scripts/check-repo-rules.cjs"},"output":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/sk-doc/sk-create-repo-rule/scripts/check-repo-rules.cjs, lines 1-662\n1: #!/usr/bin/env node\n2: // ───────────────────────────────────────────────────────────────────\n3: // MODULE: Repo rules corpus checker\n4: // ───────────────────────────────────────────────────────────────────\n5: // The corpus is hand-maintained and nothing else reads it: ordinary link\n6: // checkers walk other roots, and no hook or workflow touches the router or the\n7: // bodies of the rule files themselves. One report keeps files, router rows,\n8: // phrases, structure, body links and firing conditions in agreement, so drift\n9: // fails here instead of surfacing later as a rule that silently never loads or\n10: // points at a file that is gone. Generated rule cards are held to the same\n11: // standard: each committed card must equal the one its rule renders today.\n12: 'use strict';\n13: \n14: // ─────────────────────────────────────────────────────────────────────────────\n15: // 1. IMPORTS\n16: // ─────────────────────────────────────────────────────────────────────────────\n17: \n18: const fs = require('node:fs');\n19: const path = require('node:path');\n20: const { exitIfValidationOff } = require('../../shared/scripts/validation-switch.cjs');\n21: const { renderCard, CARDS_DIR } = require('./build-rule-cards.cjs');\n22: \n23: // ─────────────────────────────────────────────────────────────────────────────\n24: // 2. CONSTANTS\n25: // ─────────────────────────────────────────────────────────────────────────────\n26: \n27: const TAG = '[repo-rules-check]';\n28: const ROUTER_FILE = 'REPO RULES.md';\n29: // A repository that keeps its toolchain under a source root keeps the corpus\n30: // inside it, and one that does not keeps the corpus at the repository root. The\n31: // probe order is the whole layout decision: the first candidate that exists as a\n32: // directory is the one this run reads, so both layouts pass the same checks.\n33: const RULES_DIR_CANDIDATES = ['.skilled/repo-rules', 'repo-rules'];\n34: const LINE_LIMIT = 250;\n35: const NAME_WIDTH = 19;\n36: // Check 10 compares words, not meaning. A Fires-when bullet is covered when one\n37: // router item carries at least this share of its content words. Measured across\n38: // the corpus, a bullet's own row covers a median 0.75 of its words and the best\n39: // other row 0.17. Every bullet under 0.30 named a condition its row never did.\n40: const COVERAGE_THRESHOLD = 0.3;\n41: const STOP_WORDS = new Set(('a an the to of or and in on at by for with from as is are be any all that this which ' +\n42:   'you your it its one two about into than when what how there their not will was has have can do does did own off out')\n43:   .split(' '));\n44: const SUFFIXES = ['ations', 'ation', 'ions', 'ion', 'ings', 'ing', 'ers', 'er', 'ed', 'es', 's', 'e'];\n45: const SHORT_STEM_SUFFIXES = new Set(['ed', 'ing']);\n46: const REQUIRED_KEYS = [\n47:   'title',\n48:   'description',\n49:   'trigger_phrases',\n50:   'importance_tier',\n51:   'contextType',\n52:   'version'\n53: ];\n54: \n55: // ─────────────────────────────────────────────────────────────────────────────\n56: // 3. HELPERS\n57: // ─────────────────────────────────────────────────────────────────────────────\n58: \n59: // `--root <dir>` points the checker at another tree, such as a test fixture.\n60: function parseRootArg(argv) {\n61:   const index = argv.indexOf('--root');\n62:   return index !== -1 && argv[index + 1] ? path.resolve(argv[index + 1]) : null;\n63: }\n64: \n65: // An unknown flag must fail loudly rather than fall back to a default run. A\n66: // token is an option only when it stands in option position: the token after\n67: // `--root` is that option's value, even when it begins with `--`.\n68: function findUnknownOption(argv) {\n69:   for (let index = 0; index < argv.length; index += 1) {\n70:     const token = argv[index];\n71:     if (token === '--root') {\n72:       index += 1;\n73:       continue;\n74:     }\n75:     if (token.startsWith('-')) return token;\n76:   }\n77:   return null;\n78: }\n79: \n80: // Walk up from the script so the command works from anywhere in the tree.\n81: function findRepoRoot(startDir) {\n82:   let current = path.resolve(startDir);\n83:   for (;;) {\n84:     const hasRouter = fs.existsSync(path.join(current, ROUTER_FILE));\n85:     const rulesDir = resolveRulesDir(current);\n86:     if (hasRouter && rulesDir !== null) return { root: current, rulesDir };\n87:     const parent = path.dirname(current);\n88:     if (parent === current) return null;\n89:     current = parent;\n90:   }\n91: }\n92: \n93: // The rules directory of one candidate root, or null when that root has none.\n94: function resolveRulesDir(root) {\n95:   for (const candidate of RULES_DIR_CANDIDATES) {\n96:     const absolute = path.join(root, candidate);\n97:     if (fs.existsSync(absolute) && fs.statSync(absolute).isDirectory()) return candidate;\n98:   }\n99:   return null;\n100: }\n101: \n102: // A router row belongs to the corpus when its link resolves into a rules\n103: // directory or its cards subdirectory, whichever layout this checkout uses and whichever spelling the row\n104: // carries. Resolving instead of matching a prefix keeps rows recognized while a\n105: // corpus is mid-move, when the rows may still name the public path and that\n106: // path is a link into the canonical one.\n107: function ruleLinkDir(context, target) {\n108:   let resolved;\n109:   try {\n110:     resolved = fs.realpathSync(path.resolve(context.root, target));\n111:   } catch {\n112:     return null;\n113:   }\n114:   for (const candidate of RULES_DIR_CANDIDATES) {\n115:     let dirAbsolute;\n116:     try {\n117:       dirAbsolute = fs.realpathSync(path.resolve(context.root, candidate));\n118:     } catch {\n119:       continue;\n120:     }\n121:     // A rule's card shares its file name, so a link to the card credits the rule.\n122:     const parent = path.dirname(resolved);\n123:     if (parent === dirAbsolute || parent === path.join(dirAbsolute, CARDS_DIR)) return candidate;\n124:   }\n125:   return null;\n126: }\n127: \n128: // Count displayed lines; a single trailing newline is a terminator, not a line.\n129: function lineCount(content) {\n130:   const lines = content.split(/\\r\\n|\\r|\\n/u);\n131:   if (lines.length > 0 && lines[lines.length - 1] === '') lines.pop();\n132:   return lines.length;\n133: }\n134: \n135: function frontmatterRange(lines) {\n136:   if (lines[0] === undefined || lines[0].trim() !== '---') return null;\n137:   for (let index = 1; index < lines.length; index += 1) {\n138:     if (lines[index].trim() === '---') return { start: 1, end: index };\n139:   }\n140:   return null;\n141: }\n142: \n143: function parseTriggerPhrases(lines, range) {\n144:   const phrases = [];\n145:   if (range === null) return phrases;\n146:   let inList = false;\n147:   for (let index = range.start; index < range.end; index += 1) {\n148:     const line = lines[index];\n149:     if (/^trigger_phrases\\s*:/u.test(line)) {\n150:       inList = true;\n151:       continue;\n152:     }\n153:     if (!inList) continue;\n154:     const item = line.match(/^\\s+-\\s+(.*)$/u);\n155:     if (item === null) break;\n156:     const value = item[1].trim().replace(/^\"(.*)\"$/u, '$1').replace(/^'(.*)'$/u, '$1').trim();\n157:     if (value !== '') phrases.push(value);\n158:   }\n159:   return phrases;\n160: }\n161: \n162: function parseDescription(lines, range) {\n163:   if (range === null) return null;\n164:   for (let index = range.start; index < range.end; index += 1) {\n165:     const match = lines[index].match(/^description\\s*:\\s*(.*)$/u);\n166:     if (match === null) continue;\n167:     return match[1].trim().replace(/^\"(.*)\"$/u, '$1').replace(/^'(.*)'$/u, '$1').trim();\n168:   }\n169:   return null;\n170: }\n171: \n172: function parseTopLevelKeys(lines, range) {\n173:   const keys = new Set();\n174:   if (range === null) return keys;\n175:   for (let index = range.start; index < range.end; index += 1) {\n176:     const match = lines[index].match(/^([A-Za-z_][A-Za-z0-9_]*)\\s*:/u);\n177:     if (match !== null) keys.add(match[1]);\n178:   }\n179:   return keys;\n180: }\n181: \n182: function extractLinks(text) {\n183:   const links = [];\n184:   const pattern = /\\]\\(([^)]+)\\)/gu;\n185:   let match = pattern.exec(text);\n186:   while (match !== null) {\n187:     links.push(match[1].trim());\n188:     match = pattern.exec(text);\n189:   }\n190:   return links;\n191: }\n192: \n193: function normalizeTarget(target) {\n194:   const withoutAnchor = target.split('#')[0];\n195:   try {\n196:     return decodeURIComponent(withoutAnchor);\n197:   } catch {\n198:     return withoutAnchor;\n199:   }\n200: }\n201: \n202: function isExternal(target) {\n203:   return /^[a-z][a-z0-9+.-]*:/iu.test(target);\n204: }\n205: \n206: // Table rows only: the header row opens the table, separator rows are skipped,\n207: // and a `---` closes the section the way the next heading does.\n208: function splitRouterSections(lines) {\n209:   const sections = new Map();\n210:   let current = null;\n211:   let headerSeen = false;\n212:   for (let index = 0; index < lines.length; index += 1) {\n213:     const line = lines[index];\n214:     const heading = line.match(/^##\\s+(\\d+)\\./u);\n215:     if (heading !== null) {\n216:       current = heading[1];\n217:       headerSeen = false;\n218:       sections.set(current, []);\n219:       continue;\n220:     }\n221:     if (line.trim() === '---') {\n222:       current = null;\n223:       continue;\n224:     }\n225:     if (current === null || !line.trim().startsWith('|')) continue;\n226:     if (/^\\|[\\s:|-]+\\|$/u.test(line.trim())) continue;\n227:     if (!headerSeen) {\n228:       headerSeen = true;\n229:       continue;\n230:     }\n231:     sections.get(current).push({\n232:       lineNumber: index + 1,\n233:       text: line,\n234:       links: extractLinks(line)\n235:     });\n236:   }\n237:   return sections;\n238: }\n239: \n240: // Content words, crudely stemmed. The stem floor is four letters, except after\n241: // SHORT_STEM_SUFFIXES, where a three-letter stem still names the act: \"moved\"\n242: // and \"moving\" both leave \"mov\". A three-letter stem also keeps its silent-e\n243: // form (\"move\") so the stem still meets its base word. \"fails\" and \"failure\"\n244: // meet through wordsMeet's prefix rule, not through this stemming.\n245: function contentWords(text) {\n246:   const words = new Set();\n247:   const plain = text.replace(/\\]\\([^)]*\\)/gu, ']').toLowerCase();\n248:   for (const word of plain.match(/[a-z]+/gu) || []) {\n249:     if (word.length < 3 || STOP_WORDS.has(word)) continue;\n250:     const suffix = SUFFIXES.find((candidate) => word.endsWith(candidate)\n251:       && word.length - candidate.length >= (SHORT_STEM_SUFFIXES.has(candidate) ? 3 : 4));\n252:     const stem = suffix === undefined ? word : word.slice(0, -suffix.length);\n253:     words.add(stem);\n254:     if (suffix !== undefined && SHORT_STEM_SUFFIXES.has(suffix) && stem.length === 3) {\n255:       words.add(`${stem}e`);\n256:     }\n257:   }\n258:   return words;\n259: }\n260: \n261: // Two stems meet when equal, or when the shorter, at four letters or more,\n262: // begins the longer: \"auth\" meets \"authentication\".\n263: function wordsMeet(left, right) {\n264:   if (left === right) return true;\n265:   const [shorter, longer] = left.length <= right.length ? [left, right] : [right, left];\n266:   return shorter.length >= 4 && longer.startsWith(shorter);\n267: }\n268: \n269: // A three-letter stem and the silent-e form contentWords adds beside it name one\n270: // concept, so coverage scores them as one unit: met when either form meets an\n271: // item word, counted once in the denominator. Scoring them apart let the token\n272: // added to rescue a match also enlarge the set being divided by, so the bullets\n273: // the pair was meant to rescue could still fall under the threshold.\n274: function coverageUnits(words) {\n275:   const units = [];\n276:   const claimed = new Set();\n277:   for (const word of words) {\n278:     if (claimed.has(word)) continue;\n279:     const forms = word.length === 3 && words.has(`${word}e`) ? [word, `${word}e`] : [word];\n280:     for (const form of forms) claimed.add(form);\n281:     units.push(forms);\n282:   }\n283:   return units;\n284: }\n285: \n286: function coverage(bulletWords, itemWords) {\n287:   if (bulletWords.size === 0) return 1;\n288:   const units = coverageUnits(bulletWords);\n289:   let met = 0;\n290:   for (const forms of units) {\n291:     if ([...itemWords].some((other) => forms.some((form) => wordsMeet(form, other)))) met += 1;\n292:   }\n293:   return met / units.length;\n294: }\n295: \n296: function summarize(problems) {\n297:   const shown = problems.slice(0, 4).join('; ');\n298:   const extra = problems.length > 4 ? ` (+${problems.length - 4} more)` : '';\n299:   return `${shown}${extra}`;\n300: }\n301: \n302: // ─────────────────────────────────────────────────────────────────────────────\n303: // 4. CORE LOGIC\n304: // ─────────────────────────────────────────────────────────────────────────────\n305: \n306: function loadContext(root, rulesDir) {\n307:   const routerLines = fs.readFileSync(path.join(root, ROUTER_FILE), 'utf8').split(/\\r\\n|\\r|\\n/u);\n308:   const sections = splitRouterSections(routerLines);\n309: \n310:   const rules = fs\n311:     .readdirSync(path.join(root, rulesDir))\n312:     .filter((name) => name.endsWith('.md'))\n313:     .sort()\n314:     .map((name) => {\n315:       const content = fs.readFileSync(path.join(root, rulesDir, name), 'utf8');\n316:       const lines = content.split(/\\r\\n|\\r|\\n/u);\n317:       const range = frontmatterRange(lines);\n318:       const bodyStart = range === null ? 0 : range.end + 1;\n319:       const body = lines.slice(bodyStart);\n320:       return {\n321:         name,\n322:         content,\n323:         lines: lineCount(content),\n324:         phrases: parseTriggerPhrases(lines, range),\n325:         keys: parseTopLevelKeys(lines, range),\n326:         description: parseDescription(lines, range),\n327:         dividers: body.filter((line) => line.trim() === '---').length,\n328:         sections: body.filter((line) => /^##\\s+\\d+\\./u.test(line)).length,\n329:         body,\n330:         bodyStartLine: bodyStart + 1\n331:       };\n332:     });\n333: \n334:   return {\n335:     root,\n336:     rulesDir,\n337:     rules,\n338:     triggerRows: sections.get('2') || [],\n339:     indexRows: sections.get('3') || []\n340:   };\n341: }\n342: \n343: // 1. Files, trigger rows and index rows stay the same count.\n344: function checkCounts(context) {\n345:   const files = context.rules.length;\n346:   const triggerRows = context.triggerRows.length;\n347:   const indexRows = context.indexRows.length;\n348:   const ok = files === triggerRows && triggerRows === indexRows;\n349:   return { ok, detail: `files=${files} triggerRows=${triggerRows} indexRows=${indexRows}` };\n350: }\n351: \n352: // 2. Every rule has both rows, and every linked target exists.\n353: function checkWiring(context) {\n354:   const problems = [];\n355:   const linkedBy = { trigger: new Set(), index: new Set() };\n356:   const visit = (rows, kind) => {\n357:     for (const row of rows) {\n358:       if (row.links.length === 0) problems.push(`line ${row.lineNumber}: ${kind} row has no link`);\n359:       for (const link of row.links) {\n360:         const target = normalizeTarget(link);\n361:         if (!isExternal(target) && !fs.existsSync(path.resolve(context.root, target))) {\n362:           problems.push(`line ${row.lineNumber}: missing ${target}`);\n363:         }\n364:         if (!isExternal(target) && ruleLinkDir(context, target) !== null) linkedBy[kind].add(path.basename(target));\n365:       }\n366:     }\n367:   };\n368:   visit(context.triggerRows, 'trigger');\n369:   visit(context.indexRows, 'index');\n370: \n371:   for (const rule of context.rules) {\n372:     if (!linkedBy.trigger.has(rule.name)) problems.push(`${rule.name}: no trigger row`);\n373:     if (!linkedBy.index.has(rule.name)) problems.push(`${rule.name}: no index row`);\n374:   }\n375: \n376:   return {\n377:     ok: problems.length === 0,\n378:     detail: problems.length === 0\n379:       ? `files=${context.rules.length} triggerRows=${context.triggerRows.length} indexRows=${context.indexRows.length} all links resolve`\n380:       : summarize(problems)\n381:   };\n382: }\n383: \n384: // 3. No trigger phrase is claimed by two different rule files.\n385: function checkTriggerPhraseUniqueness(context) {\n386:   const owners = new Map();\n387:   for (const rule of context.rules) {\n388:     for (const phrase of rule.phrases) {\n389:       const key = phrase.toLowerCase();\n390:       if (!owners.has(key)) owners.set(key, new Set());\n391:       owners.get(key).add(rule.name);\n392:     }\n393:   }\n394:   const collisions = [];\n395:   for (const [phrase, files] of owners) {\n396:     if (files.size > 1) collisions.push(`\"${phrase}\" in ${[...files].join(', ')}`);\n397:   }\n398:   return {\n399:     ok: collisions.length === 0,\n400:     detail: collisions.length === 0\n401:       ? `phrases=${owners.size} collisions=0`\n402:       : summarize(collisions)\n403:   };\n404: }\n405: \n406: // 4. No rule file exceeds the hard line ceiling.\n407: function checkLineCeiling(context) {\n408:   const offenders = context.rules\n409:     .filter((rule) => rule.lines > LINE_LIMIT)\n410:     .map((rule) => `${rule.name}: ${rule.lines} lines`);\n411:   const longest = context.rules.reduce((max, rule) => Math.max(max, rule.lines), 0);\n412:   return {\n413:     ok: offenders.length === 0,\n414:     detail: offenders.length === 0\n415:       ? `max=${longest} limit=${LINE_LIMIT}`\n416:       : summarize(offenders)\n417:   };\n418: }\n419: \n420: // 5. Every rule carries the six-key frontmatter contract.\n421: function checkFrontmatterKeys(context) {\n422:   const missing = [];\n423:   for (const rule of context.rules) {\n424:     const absent = REQUIRED_KEYS.filter((key) => !rule.keys.has(key));\n425:     if (absent.length > 0) missing.push(`${rule.name}: missing ${absent.join(', ')}`);\n426:   }\n427:   return {\n428:     ok: missing.length === 0,\n429:     detail: missing.length === 0\n430:       ? `files=${context.rules.length} keys=${REQUIRED_KEYS.length}`\n431:       : summarize(missing)\n432:   };\n433: }\n434: \n435: // 6. Dividers equal numbered sections in each body after the frontmatter.\n436: function checkDividerParity(context) {\n437:   const offenders = context.rules\n438:     .filter((rule) => rule.dividers !== rule.sections)\n439:     .map((rule) => `${rule.name}: ${rule.dividers} dividers vs ${rule.sections} sections`);\n440:   return {\n441:     ok: offenders.length === 0,\n442:     detail: offenders.length === 0\n443:       ? `files=${context.rules.length}`\n444:       : summarize(offenders)\n445:   };\n446: }\n447: \n448: // 7. Every link inside a rule body resolves, relative to the rules directory.\n449: function checkRuleLinks(context) {\n450:   const problems = [];\n451:   let links = 0;\n452:   for (const rule of context.rules) {\n453:     rule.body.forEach((line, index) => {\n454:       for (const link of extractLinks(line)) {\n455:         const target = normalizeTarget(link);\n456:         if (isExternal(target)) continue;\n457:         links += 1;\n458:         if (!fs.existsSync(path.resolve(context.root, context.rulesDir, target))) {\n459:           problems.push(`${rule.name}: line ${rule.bodyStartLine + index}: unresolved ${target}`);\n460:         }\n461:       }\n462:     });\n463:   }\n464:   return {\n465:     ok: problems.length === 0,\n466:     detail: problems.length === 0\n467:       ? `files=${context.rules.length} links=${links} all resolve`\n468:       : summarize(problems)\n469:   };\n470: }\n471: \n472: // 8. Every rule declares at least one firing condition, or it can never be reached.\n473: function checkFiresWhenSections(context) {\n474:   const problems = [];\n475:   for (const rule of context.rules) {\n476:     const start = rule.body.findIndex((line) => /^##\\s+Fires when\\s*$/u.test(line));\n477:     if (start === -1) {\n478:       problems.push(`${rule.name}: no \"## Fires when\" section`);\n479:       continue;\n480:     }\n481:     let items = 0;\n482:     for (let index = start + 1; index < rule.body.length; index += 1) {\n483:       const line = rule.body[index];\n484:       if (/^##\\s/u.test(line)) break;\n485:       if (/^\\s*(?:[-*+]|\\d+[.)])\\s+\\S/u.test(line)) items += 1;\n486:     }\n487:     if (items === 0) problems.push(`${rule.name}: empty \"## Fires when\" section`);\n488:   }\n489:   return {\n490:     ok: problems.length === 0,\n491:     detail: problems.length === 0\n492:       ? `files=${context.rules.length} all declare firing conditions`\n493:       : summarize(problems)\n494:   };\n495: }\n496: \n497: // The index summary is a copy of the rule's own description, and a copy nobody compares\n498: // drifts: seven of eleven had diverged before this check existed, invisibly to every other\n499: // check and to CI. Whitespace is normalized because the router wraps cells and the\n500: // frontmatter does not; the words must match exactly.\n501: function checkIndexSummaries(context) {\n502:   const problems = [];\n503:   const normalize = (value) => value.replace(/\\s+/gu, ' ').trim();\n504:   const byName = new Map(context.rules.map((rule) => [rule.name, rule]));\n505:   for (const row of context.indexRows) {\n506:     const cells = row.text.split('|').map((cell) => cell.trim());\n507:     const summary = cells[2] === undefined ? '' : cells[2];\n508:     const target = row.links.map(normalizeTarget).find((link) => ruleLinkDir(context, link) !== null);\n509:     if (target === undefined) continue;\n510:     const rule = byName.get(path.basename(target));\n511:     if (rule === undefined) continue;\n512:     if (rule.description === null) {\n513:       problems.push(`${rule.name}: no description in frontmatter`);\n514:       continue;\n515:     }\n516:     if (normalize(summary) !== normalize(rule.description)) {\n517:       problems.push(`line ${row.lineNumber}: ${rule.name} summary differs from its description`);\n518:     }\n519:   }\n520:   return {\n521:     ok: problems.length === 0,\n522:     detail: problems.length === 0\n523:       ? `indexRows=${context.indexRows.length} every summary matches its rule's description`\n524:       : summarize(problems)\n525:   };\n526: }\n527: \n528: // 10. Every Fires-when bullet has a counterpart in its rule's router row, because\n529: // Gate 5 loads by the row: a condition the row never names is one no session is\n530: // sent to the rule for. A bullet whose head ends in a colon is also scored on the\n531: // head alone, so a long list of examples does not hide a covered condition.\n532: function checkFiresWhenCoverage(context) {\n533:   const problems = [];\n534:   let bullets = 0;\n535:   const rows = new Map();\n536:   for (const row of context.triggerRows) {\n537:     const target = row.links.map(normalizeTarget).find((link) => ruleLinkDir(context, link) !== null);\n538:     if (target === undefined) continue;\n539:     const cells = row.text.split('|');\n540:     const items = (cells[1] || '').split('·').map(contentWords);\n541:     rows.set(path.basename(target), { lineNumber: row.lineNumber, items });\n542:   }\n543:   for (const rule of context.rules) {\n544:     const row = rows.get(rule.name);\n545:     const start = rule.body.findIndex((line) => /^##\\s+Fires when\\s*$/u.test(line));\n546:     if (row === undefined || start === -1) continue;\n547:     for (let index = start + 1; index < rule.body.length; index += 1) {\n548:       const line = rule.body[index];\n549:       if (/^##\\s/u.test(line)) break;\n550:       const bullet = line.match(/^\\s*(?:[-*+]|\\d+[.)])\\s+(.*)$/u);\n551:       if (bullet === null) continue;\n552:       bullets += 1;\n553:       const text = bullet[1].trim();\n554:       const head = text.includes(': ') ? text.slice(0, text.indexOf(': ')) : null;\n555:       const score = (words) => Math.max(...row.items.map((item) => coverage(words, item)));\n556:       const best = Math.max(score(contentWords(text)), head === null ? 0 : score(contentWords(head)));\n557:       if (best < COVERAGE_THRESHOLD) {\n558:         problems.push(`${rule.name}: \"${text}\" has no counterpart in router line ${row.lineNumber}`);\n559:       }\n560:     }\n561:   }\n562:   return {\n563:     ok: problems.length === 0,\n564:     detail: problems.length === 0\n565:       ? `bullets=${bullets} every bullet has a router counterpart (threshold ${COVERAGE_THRESHOLD})`\n566:       : problems.join('; ')\n567:   };\n568: }\n569: \n570: // 11. Every committed card equals the card its rule renders now. A card is a\n571: // verbatim copy, so any difference is a rule edit nobody regenerated, a card\n572: // left behind by a removed rule, or a rule whose card was never built. A corpus\n573: // without a cards directory has opted out of cards and passes.\n574: function checkCardSync(context) {\n575:   const cardsDirAbs = path.join(context.root, context.rulesDir, CARDS_DIR);\n576:   if (!fs.existsSync(cardsDirAbs) || !fs.statSync(cardsDirAbs).isDirectory()) {\n577:     return { ok: true, detail: 'no cards directory' };\n578:   }\n579:   const present = new Set(fs\n580:     .readdirSync(cardsDirAbs, { withFileTypes: true })\n581:     .filter((entry) => entry.isFile() && entry.name.endsWith('.md'))\n582:     .map((entry) => entry.name));\n583:   const problems = [];\n584:   const ruleNames = new Set();\n585:   for (const rule of context.rules) {\n586:     ruleNames.add(rule.name);\n587:     let expected;\n588:     try {\n589:       expected = renderCard(rule.name, rule.content);\n590:     } catch (error) {\n591:       problems.push(`${CARDS_DIR}/${rule.name}: cannot render (${error.message})`);\n592:       continue;\n593:     }\n594:     if (!present.has(rule.name)) {\n595:       problems.push(`${CARDS_DIR}/${rule.name}: missing`);\n596:     } else if (fs.readFileSync(path.join(cardsDirAbs, rule.name), 'utf8') !== expected) {\n597:       problems.push(`${CARDS_DIR}/${rule.name}: drifted from its rule`);\n598:     }\n599:   }\n600:   for (const name of [...present].sort()) {\n601:     if (!ruleNames.has(name)) problems.push(`${CARDS_DIR}/${name}: orphaned, no rule backs it`);\n602:   }\n603:   return {\n604:     ok: problems.length === 0,\n605:     detail: problems.length === 0\n606:       ? `cards=${present.size} every card matches its rule`\n607:       : problems.join('; ')\n608:   };\n609: }\n610: \n611: const CHECKS = [\n612:   ['count parity', checkCounts],\n613:   ['row coverage', checkWiring],\n614:   ['phrase uniqueness', checkTriggerPhraseUniqueness],\n615:   ['line ceiling', checkLineCeiling],\n616:   ['frontmatter keys', checkFrontmatterKeys],\n617:   ['divider parity', checkDividerParity],\n618:   ['rule links', checkRuleLinks],\n619:   ['fires-when sections', checkFiresWhenSections],\n620:   ['index summaries', checkIndexSummaries],\n621:   ['fires-when coverage', checkFiresWhenCoverage],\n622:   ['card sync', checkCardSync]\n623: ];\n624: \n625: function main() {\n626:   const argv = process.argv.slice(2);\n627:   const unknown = findUnknownOption(argv);\n628:   if (unknown !== null) {\n629:     console.error(`check-repo-rules.cjs: unknown option: ${unknown}`);\n630:     console.error('usage: check-repo-rules.cjs [--root <dir>]');\n631:     return 2;\n632:   }\n633:   exitIfValidationOff('check-repo-rules.cjs');\n634:   const rootArg = parseRootArg(argv);\n635:   const located = findRepoRoot(rootArg || __dirname);\n636:   if (located === null || (rootArg !== null && located.root !== rootArg)) {\n637:     console.error(`${TAG} ERROR: no ${ROUTER_FILE} with a ${RULES_DIR_CANDIDATES.join(' or ')} directory found at ${rootArg || `or above ${__dirname}`}`);\n638:     return 2;\n639:   }\n640: \n641:   const context = loadContext(located.root, located.rulesDir);\n642:   let failed = 0;\n643:   CHECKS.forEach(([name, run], index) => {\n644:     const result = run(context);\n645:     if (!result.ok) failed += 1;\n646:     const verdict = result.ok ? 'PASS' : 'FAIL';\n647:     console.log(`${TAG} ${index + 1}/${CHECKS.length} ${verdict} ${name.padEnd(NAME_WIDTH)} - ${result.detail}`);\n648:   });\n649: \n650:   const passed = CHECKS.length - failed;\n651:   console.log(`${TAG} RESULT: ${failed === 0 ? 'PASSED' : 'FAILED'} (${passed}/${CHECKS.length} checks)`);\n652:   return failed === 0 ? 0 : 1;\n653: }\n654: \n655: if (require.main === module) {\n656:   try {\n657:     process.exitCode = main();\n658:   } catch (error) {\n659:     console.error(`${TAG} ERROR: ${error.message}`);\n660:     process.exitCode = 2;\n661:   }\n662: }","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/sk-doc/sk-create-repo-rule/scripts/check-repo-rules.cjs, lines 1-662\n1: #!/usr/bin/env node\n2: // ───────────────────────────────────────────────────────────────────\n3: // MODULE: Repo rules corpus checker\n4: // ───────────────────────────────────────────────────────────────────\n5: // The corpus is hand-maintained and nothing else reads it: ordinary link\n6: // checkers walk other roots, and no hook or workflow touches the router or the\n7: // bodies of the rule files themselves. One report keeps files, router rows,\n8: // phrases, structure, body links and firing conditions in agreement, so drift\n9: // fails here instead of surfacing later as a rule that silently never loads or\n10: // points at a file that is gone. Generated rule cards are held to the same\n11: // standard: each committed card must equal the one its rule renders today.\n12: 'use strict';\n13: \n14: // ─────────────────────────────────────────────────────────────────────────────\n15: // 1. IMPORTS\n16: // ─────────────────────────────────────────────────────────────────────────────\n17: \n18: const fs = require('node:fs');\n19: const path = require('node:path');\n20: const { exitIfValidationOff } = require('../../shared/scripts/validation-switch.cjs');\n21: const { renderCard, CARDS_DIR } = require('./build-rule-cards.cjs');\n22: \n23: // ─────────────────────────────────────────────────────────────────────────────\n24: // 2. CONSTANTS\n25: // ─────────────────────────────────────────────────────────────────────────────\n26: \n27: const TAG = '[repo-rules-check]';\n28: const ROUTER_FILE = 'REPO RULES.md';\n29: // A repository that keeps its toolchain under a source root keeps the corpus\n30: // inside it, and one that does not keeps the corpus at the repository root. The\n31: // probe order is the whole layout decision: the first candidate that exists as a\n32: // directory is the one this run reads, so both layouts pass the same checks.\n33: const RULES_DIR_CANDIDATES = ['.skilled/repo-rules', 'repo-rules'];\n34: const LINE_LIMIT = 250;\n35: const NAME_WIDTH = 19;\n36: // Check 10 compares words, not meaning. A Fires-when bullet is covered when one\n37: // router item carries at least this share of its content words. Measured across\n38: // the corpus, a bullet's own row covers a median 0.75 of its words and the best\n39: // other row 0.17. Every bullet under 0.30 named a condition its row never did.\n40: const COVERAGE_THRESHOLD = 0.3;\n41: const STOP_WORDS = new Set(('a an the to of or and in on at by for with from as is are be any all that this which ' +\n42:   'you your it its one two about into than when what how there their not will was has have can do does did own off out')\n43:   .split(' '));\n44: const SUFFIXES = ['ations', 'ation', 'ions', 'ion', 'ings', 'ing', 'ers', 'er', 'ed', 'es', 's', 'e'];\n45: const SHORT_STEM_SUFFIXES = new Set(['ed', 'ing']);\n46: const REQUIRED_KEYS = [\n47:   'title',\n48:   'description',\n49:   'trigger_phrases',\n50:   'importance_tier',\n51:   'contextType',\n52:   'version'\n53: ];\n54: \n55: // ─────────────────────────────────────────────────────────────────────────────\n56: // 3. HELPERS\n57: // ─────────────────────────────────────────────────────────────────────────────\n58: \n59: // `--root <dir>` points the checker at another tree, such as a test fixture.\n60: function parseRootArg(argv) {\n61:   const index = argv.indexOf('--root');\n62:   return index !== -1 && argv[index + 1] ? path.resolve(argv[index + 1]) : null;\n63: }\n64: \n65: // An unknown flag must fail loudly rather than fall back to a default run. A\n66: // token is an option only when it stands in option position: the token after\n67: // `--root` is that option's value, even when it begins with `--`.\n68: function findUnknownOption(argv) {\n69:   for (let index = 0; index < argv.length; index += 1) {\n70:     const token = argv[index];\n71:     if (token === '--root') {\n72:       index += 1;\n73:       continue;\n74:     }\n75:     if (token.startsWith('-')) return token;\n76:   }\n77:   return null;\n78: }\n79: \n80: // Walk up from the script so the command works from anywhere in the tree.\n81: function findRepoRoot(startDir) {\n82:   let current = path.resolve(startDir);\n83:   for (;;) {\n84:     const hasRouter = fs.existsSync(path.join(current, ROUTER_FILE));\n85:     const rulesDir = resolveRulesDir(current);\n86:     if (hasRouter && rulesDir !== null) return { root: current, rulesDir };\n87:     const parent = path.dirname(current);\n88:     if (parent === current) return null;\n89:     current = parent;\n90:   }\n91: }\n92: \n93: // The rules directory of one candidate root, or null when that root has none.\n94: function resolveRulesDir(root) {\n95:   for (const candidate of RULES_DIR_CANDIDATES) {\n96:     const absolute = path.join(root, candidate);\n97:     if (fs.existsSync(absolute) && fs.statSync(absolute).isDirectory()) return candidate;\n98:   }\n99:   return null;\n100: }\n101: \n102: // A router row belongs to the corpus when its link resolves into a rules\n103: // directory or its cards subdirectory, whichever layout this checkout uses and whichever spelling the row\n104: // carries. Resolving instead of matching a prefix keeps rows recognized while a\n105: // corpus is mid-move, when the rows may still name the public path and that\n106: // path is a link into the canonical one.\n107: function ruleLinkDir(context, target) {\n108:   let resolved;\n109:   try {\n110:     resolved = fs.realpathSync(path.resolve(context.root, target));\n111:   } catch {\n112:     return null;\n113:   }\n114:   for (const candidate of RULES_DIR_CANDIDATES) {\n115:     let dirAbsolute;\n116:     try {\n117:       dirAbsolute = fs.realpathSync(path.resolve(context.root, candidate));\n118:     } catch {\n119:       continue;\n120:     }\n121:     // A rule's card shares its file name, so a link to the card credits the rule.\n122:     const parent = path.dirname(resolved);\n123:     if (parent === dirAbsolute || parent === path.join(dirAbsolute, CARDS_DIR)) return candidate;\n124:   }\n125:   return null;\n126: }\n127: \n128: // Count displayed lines; a single trailing newline is a terminator, not a line.\n129: function lineCount(content) {\n130:   const lines = content.split(/\\r\\n|\\r|\\n/u);\n131:   if (lines.length > 0 && lines[lines.length - 1] === '') lines.pop();\n132:   return lines.length;\n133: }\n134: \n135: function frontmatterRange(lines) {\n136:   if (lines[0] === undefined || lines[0].trim() !== '---') return null;\n137:   for (let index = 1; index < lines.length; index += 1) {\n138:     if (lines[index].trim() === '---') return { start: 1, end: index };\n139:   }\n140:   return null;\n141: }\n142: \n143: function parseTriggerPhrases(lines, range) {\n144:   const phrases = [];\n145:   if (range === null) return phrases;\n146:   let inList = false;\n147:   for (let index = range.start; index < range.end; index += 1) {\n148:     const line = lines[index];\n149:     if (/^trigger_phrases\\s*:/u.test(line)) {\n150:       inList = true;\n151:       continue;\n152:     }\n153:     if (!inList) continue;\n154:     const item = line.match(/^\\s+-\\s+(.*)$/u);\n155:     if (item === null) break;\n156:     const value = item[1].trim().replace(/^\"(.*)\"$/u, '$1').replace(/^'(.*)'$/u, '$1').trim();\n157:     if (value !== '') phrases.push(value);\n158:   }\n159:   return phrases;\n160: }\n161: \n162: function parseDescription(lines, range) {\n163:   if (range === null) return null;\n164:   for (let index = range.start; index < range.end; index += 1) {\n165:     const match = lines[index].match(/^description\\s*:\\s*(.*)$/u);\n166:     if (match === null) continue;\n167:     return match[1].trim().replace(/^\"(.*)\"$/u, '$1').replace(/^'(.*)'$/u, '$1').trim();\n168:   }\n169:   return null;\n170: }\n171: \n172: function parseTopLevelKeys(lines, range) {\n173:   const keys = new Set();\n174:   if (range === null) return keys;\n175:   for (let index = range.start; index < range.end; index += 1) {\n176:     const match = lines[index].match(/^([A-Za-z_][A-Za-z0-9_]*)\\s*:/u);\n177:     if (match !== null) keys.add(match[1]);\n178:   }\n179:   return keys;\n180: }\n181: \n182: function extractLinks(text) {\n183:   const links = [];\n184:   const pattern = /\\]\\(([^)]+)\\)/gu;\n185:   let match = pattern.exec(text);\n186:   while (match !== null) {\n187:     links.push(match[1].trim());\n188:     match = pattern.exec(text);\n189:   }\n190:   return links;\n191: }\n192: \n193: function normalizeTarget(target) {\n194:   const withoutAnchor = target.split('#')[0];\n195:   try {\n196:     return decodeURIComponent(withoutAnchor);\n197:   } catch {\n198:     return withoutAnchor;\n199:   }\n200: }\n201: \n202: function isExternal(target) {\n203:   return /^[a-z][a-z0-9+.-]*:/iu.test(target);\n204: }\n205: \n206: // Table rows only: the header row opens the table, separator rows are skipped,\n207: // and a `---` closes the section the way the next heading does.\n208: function splitRouterSections(lines) {\n209:   const sections = new Map();\n210:   let current = null;\n211:   let headerSeen = false;\n212:   for (let index = 0; index < lines.length; index += 1) {\n213:     const line = lines[index];\n214:     const heading = line.match(/^##\\s+(\\d+)\\./u);\n215:     if (heading !== null) {\n216:       current = heading[1];\n217:       headerSeen = false;\n218:       sections.set(current, []);\n219:       continue;\n220:     }\n221:     if (line.trim() === '---') {\n222:       current = null;\n223:       continue;\n224:     }\n225:     if (current === null || !line.trim().startsWith('|')) continue;\n226:     if (/^\\|[\\s:|-]+\\|$/u.test(line.trim())) continue;\n227:     if (!headerSeen) {\n228:       headerSeen = true;\n229:       continue;\n230:     }\n231:     sections.get(current).push({\n232:       lineNumber: index + 1,\n233:       text: line,\n234:       links: extractLinks(line)\n235:     });\n236:   }\n237:   return sections;\n238: }\n239: \n240: // Content words, crudely stemmed. The stem floor is four letters, except after\n241: // SHORT_STEM_SUFFIXES, where a three-letter stem still names the act: \"moved\"\n242: // and \"moving\" both leave \"mov\". A three-letter stem also keeps its silent-e\n243: // form (\"move\") so the stem still meets its base word. \"fails\" and \"failure\"\n244: // meet through wordsMeet's prefix rule, not through this stemming.\n245: function contentWords(text) {\n246:   const words = new Set();\n247:   const plain = text.replace(/\\]\\([^)]*\\)/gu, ']').toLowerCase();\n248:   for (const word of plain.match(/[a-z]+/gu) || []) {\n249:     if (word.length < 3 || STOP_WORDS.has(word)) continue;\n250:     const suffix = SUFFIXES.find((candidate) => word.endsWith(candidate)\n251:       && word.length - candidate.length >= (SHORT_STEM_SUFFIXES.has(candidate) ? 3 : 4));\n252:     const stem = suffix === undefined ? word : word.slice(0, -suffix.length);\n253:     words.add(stem);\n254:     if (suffix !== undefined && SHORT_STEM_SUFFIXES.has(suffix) && stem.length === 3) {\n255:       words.add(`${stem}e`);\n256:     }\n257:   }\n258:   return words;\n259: }\n260: \n261: // Two stems meet when equal, or when the shorter, at four letters or more,\n262: // begins the longer: \"auth\" meets \"authentication\".\n263: function wordsMeet(left, right) {\n264:   if (left === right) return true;\n265:   const [shorter, longer] = left.length <= right.length ? [left, right] : [right, left];\n266:   return shorter.length >= 4 && longer.startsWith(shorter);\n267: }\n268: \n269: // A three-letter stem and the silent-e form contentWords adds beside it name one\n270: // concept, so coverage scores them as one unit: met when either form meets an\n271: // item word, counted once in the denominator. Scoring them apart let the token\n272: // added to rescue a match also enlarge the set being divided by, so the bullets\n273: // the pair was meant to rescue could still fall under the threshold.\n274: function coverageUnits(words) {\n275:   const units = [];\n276:   const claimed = new Set();\n277:   for (const word of words) {\n278:     if (claimed.has(word)) continue;\n279:     const forms = word.length === 3 && words.has(`${word}e`) ? [word, `${word}e`] : [word];\n280:     for (const form of forms) claimed.add(form);\n281:     units.push(forms);\n282:   }\n283:   return units;\n284: }\n285: \n286: function coverage(bulletWords, itemWords) {\n287:   if (bulletWords.size === 0) return 1;\n288:   const units = coverageUnits(bulletWords);\n289:   let met = 0;\n290:   for (const forms of units) {\n291:     if ([...itemWords].some((other) => forms.some((form) => wordsMeet(form, other)))) met += 1;\n292:   }\n293:   return met / units.length;\n294: }\n295: \n296: function summarize(problems) {\n297:   const shown = problems.slice(0, 4).join('; ');\n298:   const extra = problems.length > 4 ? ` (+${problems.length - 4} more)` : '';\n299:   return `${shown}${extra}`;\n300: }\n301: \n302: // ─────────────────────────────────────────────────────────────────────────────\n303: // 4. CORE LOGIC\n304: // ─────────────────────────────────────────────────────────────────────────────\n305: \n306: function loadContext(root, rulesDir) {\n307:   const routerLines = fs.readFileSync(path.join(root, ROUTER_FILE), 'utf8').split(/\\r\\n|\\r|\\n/u);\n308:   const sections = splitRouterSections(routerLines);\n309: \n310:   const rules = fs\n311:     .readdirSync(path.join(root, rulesDir))\n312:     .filter((name) => name.endsWith('.md'))\n313:     .sort()\n314:     .map((name) => {\n315:       const content = fs.readFileSync(path.join(root, rulesDir, name), 'utf8');\n316:       const lines = content.split(/\\r\\n|\\r|\\n/u);\n317:       const range = frontmatterRange(lines);\n318:       const bodyStart = range === null ? 0 : range.end + 1;\n319:       const body = lines.slice(bodyStart);\n320:       return {\n321:         name,\n322:         content,\n323:         lines: lineCount(content),\n324:         phrases: parseTriggerPhrases(lines, range),\n325:         keys: parseTopLevelKeys(lines, range),\n326:         description: parseDescription(lines, range),\n327:         dividers: body.filter((line) => line.trim() === '---').length,\n328:         sections: body.filter((line) => /^##\\s+\\d+\\./u.test(line)).length,\n329:         body,\n330:         bodyStartLine: bodyStart + 1\n331:       };\n332:     });\n333: \n334:   return {\n335:     root,\n336:     rulesDir,\n337:     rules,\n338:     triggerRows: sections.get('2') || [],\n339:     indexRows: sections.get('3') || []\n340:   };\n341: }\n342: \n343: // 1. Files, trigger rows and index rows stay the same count.\n344: function checkCounts(context) {\n345:   const files = context.rules.length;\n346:   const triggerRows = context.triggerRows.length;\n347:   const indexRows = context.indexRows.length;\n348:   const ok = files === triggerRows && triggerRows === indexRows;\n349:   return { ok, detail: `files=${files} triggerRows=${triggerRows} indexRows=${indexRows}` };\n350: }\n351: \n352: // 2. Every rule has both rows, and every linked target exists.\n353: function checkWiring(context) {\n354:   const problems = [];\n355:   const linkedBy = { trigger: new Set(), index: new Set() };\n356:   const visit = (rows, kind) => {\n357:     for (const row of rows) {\n358:       if (row.links.length === 0) problems.push(`line ${row.lineNumber}: ${kind} row has no link`);\n359:       for (const link of row.links) {\n360:         const target = normalizeTarget(link);\n361:         if (!isExternal(target) && !fs.existsSync(path.resolve(context.root, target))) {\n362:           problems.push(`line ${row.lineNumber}: missing ${target}`);\n363:         }\n364:         if (!isExternal(target) && ruleLinkDir(context, target) !== null) linkedBy[kind].add(path.basename(target));\n365:       }\n366:     }\n367:   };\n368:   visit(context.triggerRows, 'trigger');\n369:   visit(context.indexRows, 'index');\n370: \n371:   for (const rule of context.rules) {\n372:     if (!linkedBy.trigger.has(rule.name)) problems.push(`${rule.name}: no trigger row`);\n373:     if (!linkedBy.index.has(rule.name)) problems.push(`${rule.name}: no index row`);\n374:   }\n375: \n376:   return {\n377:     ok: problems.length === 0,\n378:     detail: problems.length === 0\n379:       ? `files=${context.rules.length} triggerRows=${context.triggerRows.length} indexRows=${context.indexRows.length} all links resolve`\n380:       : summarize(problems)\n381:   };\n382: }\n383: \n384: // 3. No trigger phrase is claimed by two different rule files.\n385: function checkTriggerPhraseUniqueness(context) {\n386:   const owners = new Map();\n387:   for (const rule of context.rules) {\n388:     for (const phrase of rule.phrases) {\n389:       const key = phrase.toLowerCase();\n390:       if (!owners.has(key)) owners.set(key, new Set());\n391:       owners.get(key).add(rule.name);\n392:     }\n393:   }\n394:   const collisions = [];\n395:   for (const [phrase, files] of owners) {\n396:     if (files.size > 1) collisions.push(`\"${phrase}\" in ${[...files].join(', ')}`);\n397:   }\n398:   return {\n399:     ok: collisions.length === 0,\n400:     detail: collisions.length === 0\n401:       ? `phrases=${owners.size} collisions=0`\n402:       : summarize(collisions)\n403:   };\n404: }\n405: \n406: // 4. No rule file exceeds the hard line ceiling.\n407: function checkLineCeiling(context) {\n408:   const offenders = context.rules\n409:     .filter((rule) => rule.lines > LINE_LIMIT)\n410:     .map((rule) => `${rule.name}: ${rule.lines} lines`);\n411:   const longest = context.rules.reduce((max, rule) => Math.max(max, rule.lines), 0);\n412:   return {\n413:     ok: offenders.length === 0,\n414:     detail: offenders.length === 0\n415:       ? `max=${longest} limit=${LINE_LIMIT}`\n416:       : summarize(offenders)\n417:   };\n418: }\n419: \n420: // 5. Every rule carries the six-key frontmatter contract.\n421: function checkFrontmatterKeys(context) {\n422:   const missing = [];\n423:   for (const rule of context.rules) {\n424:     const absent = REQUIRED_KEYS.filter((key) => !rule.keys.has(key));\n425:     if (absent.length > 0) missing.push(`${rule.name}: missing ${absent.join(', ')}`);\n426:   }\n427:   return {\n428:     ok: missing.length === 0,\n429:     detail: missing.length === 0\n430:       ? `files=${context.rules.length} keys=${REQUIRED_KEYS.length}`\n431:       : summarize(missing)\n432:   };\n433: }\n434: \n435: // 6. Dividers equal numbered sections in each body after the frontmatter.\n436: function checkDividerParity(context) {\n437:   const offenders = context.rules\n438:     .filter((rule) => rule.dividers !== rule.sections)\n439:     .map((rule) => `${rule.name}: ${rule.dividers} dividers vs ${rule.sections} sections`);\n440:   return {\n441:     ok: offenders.length === 0,\n442:     detail: offenders.length === 0\n443:       ? `files=${context.rules.length}`\n444:       : summarize(offenders)\n445:   };\n446: }\n447: \n448: // 7. Every link inside a rule body resolves, relative to the rules directory.\n449: function checkRuleLinks(context) {\n450:   const problems = [];\n451:   let links = 0;\n452:   for (const rule of context.rules) {\n453:     rule.body.forEach((line, index) => {\n454:       for (const link of extractLinks(line)) {\n455:         const target = normalizeTarget(link);\n456:         if (isExternal(target)) continue;\n457:         links += 1;\n458:         if (!fs.existsSync(path.resolve(context.root, context.rulesDir, target))) {\n459:           problems.push(`${rule.name}: line ${rule.bodyStartLine + index}: unresolved ${target}`);\n460:         }\n461:       }\n462:     });\n463:   }\n464:   return {\n465:     ok: problems.length === 0,\n466:     detail: problems.length === 0\n467:       ? `files=${context.rules.length} links=${links} all resolve`\n468:       : summarize(problems)\n469:   };\n470: }\n471: \n472: // 8. Every rule declares at least one firing condition, or it can never be reached.\n473: function checkFiresWhenSections(context) {\n474:   const problems = [];\n475:   for (const rule of context.rules) {\n476:     const start = rule.body.findIndex((line) => /^##\\s+Fires when\\s*$/u.test(line));\n477:     if (start === -1) {\n478:       problems.push(`${rule.name}: no \"## Fires when\" section`);\n479:       continue;\n480:     }\n481:     let items = 0;\n482:     for (let index = start + 1; index < rule.body.length; index += 1) {\n483:       const line = rule.body[index];\n484:       if (/^##\\s/u.test(line)) break;\n485:       if (/^\\s*(?:[-*+]|\\d+[.)])\\s+\\S/u.test(line)) items += 1;\n486:     }\n487:     if (items === 0) problems.push(`${rule.name}: empty \"## Fires when\" section`);\n488:   }\n489:   return {\n490:     ok: problems.length === 0,\n491:     detail: problems.length === 0\n492:       ? `files=${context.rules.length} all declare firing conditions`\n493:       : summarize(problems)\n494:   };\n495: }\n496: \n497: // The index summary is a copy of the rule's own description, and a copy nobody compares\n498: // drifts: seven of eleven had diverged before this check existed, invisibly to every other\n499: // check and to CI. Whitespace is normalized because the router wraps cells and the\n500: // frontmatter does not; the words must match exactly.\n501: function checkIndexSummaries(context) {\n502:   const problems = [];\n503:   const normalize = (value) => value.replace(/\\s+/gu, ' ').trim();\n504:   const byName = new Map(context.rules.map((rule) => [rule.name, rule]));\n505:   for (const row of context.indexRows) {\n506:     const cells = row.text.split('|').map((cell) => cell.trim());\n507:     const summary = cells[2] === undefined ? '' : cells[2];\n508:     const target = row.links.map(normalizeTarget).find((link) => ruleLinkDir(context, link) !== null);\n509:     if (target === undefined) continue;\n510:     const rule = byName.get(path.basename(target));\n511:     if (rule === undefined) continue;\n512:     if (rule.description === null) {\n513:       problems.push(`${rule.name}: no description in frontmatter`);\n514:       continue;\n515:     }\n516:     if (normalize(summary) !== normalize(rule.description)) {\n517:       problems.push(`line ${row.lineNumber}: ${rule.name} summary differs from its description`);\n518:     }\n519:   }\n520:   return {\n521:     ok: problems.length === 0,\n522:     detail: problems.length === 0\n523:       ? `indexRows=${context.indexRows.length} every summary matches its rule's description`\n524:       : summarize(problems)\n525:   };\n526: }\n527: \n528: // 10. Every Fires-when bullet has a counterpart in its rule's router row, because\n529: // Gate 5 loads by the row: a condition the row never names is one no session is\n530: // sent to the rule for. A bullet whose head ends in a colon is also scored on the\n531: // head alone, so a long list of examples does not hide a covered condition.\n532: function checkFiresWhenCoverage(context) {\n533:   const problems = [];\n534:   let bullets = 0;\n535:   const rows = new Map();\n536:   for (const row of context.triggerRows) {\n537:     const target = row.links.map(normalizeTarget).find((link) => ruleLinkDir(context, link) !== null);\n538:     if (target === undefined) continue;\n539:     const cells = row.text.split('|');\n540:     const items = (cells[1] || '').split('·').map(contentWords);\n541:     rows.set(path.basename(target), { lineNumber: row.lineNumber, items });\n542:   }\n543:   for (const rule of context.rules) {\n544:     const row = rows.get(rule.name);\n545:     const start = rule.body.findIndex((line) => /^##\\s+Fires when\\s*$/u.test(line));\n546:     if (row === undefined || start === -1) continue;\n547:     for (let index = start + 1; index < rule.body.length; index += 1) {\n548:       const line = rule.body[index];\n549:       if (/^##\\s/u.test(line)) break;\n550:       const bullet = line.match(/^\\s*(?:[-*+]|\\d+[.)])\\s+(.*)$/u);\n551:       if (bullet === null) continue;\n552:       bullets += 1;\n553:       const text = bullet[1].trim();\n554:       const head = text.includes(': ') ? text.slice(0, text.indexOf(': ')) : null;\n555:       const score = (words) => Math.max(...row.items.map((item) => coverage(words, item)));\n556:       const best = Math.max(score(contentWords(text)), head === null ? 0 : score(contentWords(head)));\n557:       if (best < COVERAGE_THRESHOLD) {\n558:         problems.push(`${rule.name}: \"${text}\" has no counterpart in router line ${row.lineNumber}`);\n559:       }\n560:     }\n561:   }\n562:   return {\n563:     ok: problems.length === 0,\n564:     detail: problems.length === 0\n565:       ? `bullets=${bullets} every bullet has a router counterpart (threshold ${COVERAGE_THRESHOLD})`\n566:       : problems.join('; ')\n567:   };\n568: }\n569: \n570: // 11. Every committed card equals the card its rule renders now. A card is a\n571: // verbatim copy, so any difference is a rule edit nobody regenerated, a card\n572: // left behind by a removed rule, or a rule whose card was never built. A corpus\n573: // without a cards directory has opted out of cards and passes.\n574: function checkCardSync(context) {\n575:   const cardsDirAbs = path.join(context.root, context.rulesDir, CARDS_DIR);\n576:   if (!fs.existsSync(cardsDirAbs) || !fs.statSync(cardsDirAbs).isDirectory()) {\n577:     return { ok: true, detail: 'no cards directory' };\n578:   }\n579:   const present = new Set(fs\n580:     .readdirSync(cardsDirAbs, { withFileTypes: true })\n581:     .filter((entry) => entry.isFile() && entry.name.endsWith('.md'))\n582:     .map((entry) => entry.name));\n583:   const problems = [];\n584:   const ruleNames = new Set();\n585:   for (const rule of context.rules) {\n586:     ruleNames.add(rule.name);\n587:     let expected;\n588:     try {\n589:       expected = renderCard(rule.name, rule.content);\n590:     } catch (error) {\n591:       problems.push(`${CARDS_DIR}/${rule.name}: cannot render (${error.message})`);\n592:       continue;\n593:     }\n594:     if (!present.has(rule.name)) {\n595:       problems.push(`${CARDS_DIR}/${rule.name}: missing`);\n596:     } else if (fs.readFileSync(path.join(cardsDirAbs, rule.name), 'utf8') !== expected) {\n597:       problems.push(`${CARDS_DIR}/${rule.name}: drifted from its rule`);\n598:     }\n599:   }\n600:   for (const name of [...present].sort()) {\n601:     if (!ruleNames.has(name)) problems.push(`${CARDS_DIR}/${name}: orphaned, no rule backs it`);\n602:   }\n603:   return {\n604:     ok: problems.length === 0,\n605:     detail: problems.length === 0\n606:       ? `cards=${present.size} every card matches its rule`\n607:       : problems.join('; ')\n608:   };\n609: }\n610: \n611: const CHECKS = [\n612:   ['count parity', checkCounts],\n613:   ['row coverage', checkWiring],\n614:   ['phrase uniqueness', checkTriggerPhraseUniqueness],\n615:   ['line ceiling', checkLineCeiling],\n616:   ['frontmatter keys', checkFrontmatterKeys],\n617:   ['divider parity', checkDividerParity],\n618:   ['rule links', checkRuleLinks],\n619:   ['fires-when sections', checkFiresWhenSections],\n620:   ['index summaries', checkIndexSummaries],\n621:   ['fires-when coverage', checkFiresWhenCoverage],\n622:   ['card sync', checkCardSync]\n623: ];\n624: \n625: function main() {\n626:   const argv = process.argv.slice(2);\n627:   const unknown = findUnknownOption(argv);\n628:   if (unknown !== null) {\n629:     console.error(`check-repo-rules.cjs: unknown option: ${unknown}`);\n630:     console.error('usage: check-repo-rules.cjs [--root <dir>]');\n631:     return 2;\n632:   }\n633:   exitIfValidationOff('check-repo-rules.cjs');\n634:   const rootArg = parseRootArg(argv);\n635:   const located = findRepoRoot(rootArg || __dirname);\n636:   if (located === null || (rootArg !== null && located.root !== rootArg)) {\n637:     console.error(`${TAG} ERROR: no ${ROUTER_FILE} with a ${RULES_DIR_CANDIDATES.join(' or ')} directory found at ${rootArg || `or above ${__dirname}`}`);\n638:     return 2;\n639:   }\n640: \n641:   const context = loadContext(located.root, located.rulesDir);\n642:   let failed = 0;\n643:   CHECKS.forEach(([name, run], index) => {\n644:     const result = run(context);\n645:     if (!result.ok) failed += 1;\n646:     const verdict = result.ok ? 'PASS' : 'FAIL';\n647:     console.log(`${TAG} ${index + 1}/${CHECKS.length} ${verdict} ${name.padEnd(NAME_WIDTH)} - ${result.detail}`);\n648:   });\n649: \n650:   const passed = CHECKS.length - failed;\n651:   console.log(`${TAG} RESULT: ${failed === 0 ? 'PASSED' : 'FAILED'} (${passed}/${CHECKS.length} checks)`);\n652:   return failed === 0 ? 0 : 1;\n653: }\n654: \n655: if (require.main === module) {\n656:   try {\n657:     process.exitCode = main();\n658:   } catch (error) {\n659:     console.error(`${TAG} ERROR: ${error.message}`);\n660:     process.exitCode = 2;\n661:   }\n662: }"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\": \"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/sk-doc/sk-create-repo-rule/scripts/check-repo-rules.cjs\"}"},"time":{"start":1794559471848,"end":1794559471981}}}}
{"type":"tool_use","timestamp":1794559471984,"sessionID":"ses_e2bed8c89ffeaoDJMekw21nJMc","part":{"partID":"prt_1d41470e70020hsi3jvOtS6gH3","sessionID":"ses_e2bed8c89ffeaoDJMekw21nJMc","messageID":"msg_1d4144e84001WqFMAkUDSszHs9","type":"tool","id":"chatcmpl-tool-af3a97f910d2d20a","tool":"read","state":{"status":"completed","input":{"path":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/sk-doc/sk-create-repo-rule/assets/repo-rules-router-template.md"},"output":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/sk-doc/sk-create-repo-rule/assets/repo-rules-router-template.md, lines 1-132\n1: ---\n2: title: \"Repo Rules Router Template\"\n3: description: \"The prerequisite. A repository with no trigger table cannot load a rule at all, so the mode emits this before writing its first rule. Structurally unlike a rule and deliberately so.\"\n4: trigger_phrases:\n5:   - \"router template\"\n6:   - \"REPO RULES.md scaffold\"\n7:   - \"trigger table\"\n8:   - \"no router exists\"\n9:   - \"first rule in a repository\"\n10: importance_tier: important\n11: contextType: reference\n12: version: 1.1.1.0\n13: ---\n14: \n15: # Repo Rules Router Template\n16: \n17: Emitted only when `REPO RULES.md` does not exist. **Nobody asks for this.** It is\n18: created because the destination is missing, the way a build makes a directory before\n19: writing into it.\n20: \n21: ---\n22: \n23: ## 1. OVERVIEW\n24: \n25: ### Purpose\n26: \n27: The router is **not a rule**, and the difference is measured, not stylistic: no\n28: frontmatter, no `Fires when`, no `The rule`, no self-check, and four numbered sections\n29: against a rule's six to twelve. It holds no doctrine of its own. Every rule it lists is\n30: a file, and the router is the index.\n31: \n32: ### Usage\n33: \n34: - `REPO RULES.md` does not exist yet.\n35: - You are about to write the first rule in a repository.\n36: - A repository has no trigger table, so no rule can load.\n37: \n38: ---\n39: \n40: ## 2. THE TEMPLATE\n41: \n42: <!-- BEGIN TEMPLATE -->\n43: ```markdown\n44: # REPO RULES\n45: \n46: Repo-local operating rules. `AGENTS.md` **Gate 5 (§2)** makes reading this mandatory\n47: before your first write of the session. This document then routes you to every rule\n48: file that governs what you are about to do. **It is a router, not a rulebook:** it\n49: holds no rules of its own.\n50: \n51: ---\n52: \n53: ## 1. HOW TO USE THIS\n54: \n55: 1. **Match on the action you are about to take**, not the topic of the request.\n56: 2. **Load before the action.** A rule read afterwards is a post-mortem.\n57: 3. **A file already in context is not re-read.**\n58: 4. **Every trigger that fires is loaded, not just the first.** They compose, and the more\n59:    specific wins on conflict. Three and four firing at once is the normal case, not an\n60:    edge case.\n61: 5. **Nothing fires → `AGENTS.md` alone governs.** Do not hunt for a rule to apply.\n62: \n63: ### Precedence\n64: \n65: | Level | Source | Can be overridden? |\n66: |-------|--------|--------------------|\n67: | 1 | Every `AGENTS.md` §1 hard blocker, the Four Laws, PLAN-WORKFLOW LOCK, Comment Hygiene, and every mandatory gate in §2 | No |\n68: | 2 | An explicit, in-the-moment operator instruction | Not applicable, it is the instruction |\n69: | 3 | These rule files | Only by level 1 or 2 |\n70: | 4 | General judgment | By anything above |\n71: \n72: A rule file may tighten `AGENTS.md`. None relaxes a HARD BLOCK or authorizes what\n73: `AGENTS.md` forbids. Gate 5 does not change that: it makes the **load** mandatory,\n74: while what you load stays at level 3, the obligation to read is tier 1, the content\n75: is not.\n76: \n77: ---\n78: \n79: ## 2. TRIGGER TABLE\n80: \n81: | You are about to… | Load | It settles |\n82: |-------------------|------|-----------|\n83: | <the action, in the words someone would use> | [`<rule>.md`](repo-rules/<rule>.md) | <the question it answers> |\n84: \n85: ---\n86: \n87: ## 3. INDEX\n88: \n89: | Rule | Summary |\n90: |------|---------|\n91: | [<Rule>](repo-rules/<rule>.md) | <the binding sentence, compressed to one line> |\n92: \n93: ---\n94: \n95: ## 4. SCOPE OF THIS DOCUMENT\n96: \n97: **In:** <what this rule set is for, the categories of discipline it carries.>\n98: \n99: **Out:** <what it deliberately excludes, and which document owns each instead.>\n100: ```\n101: <!-- END TEMPLATE -->\n102: \n103: ---\n104: \n105: ## 3. WHAT THE ROUTER MUST NOT BECOME\n106: \n107: **It holds no rules.** The moment a router explains *how* to do something rather than\n108: *where to look*, it has become a rule file with a routing table attached, and the set has\n109: two places to change instead of one.\n110: \n111: **Its scope statement is load-bearing.** A trigger row pointing at a rule the scope\n112: statement excludes is a document contradicting itself at the exact point a reader\n113: consults it. The shipped router hit this twice and both times the boundary had to move.\n114: \n115: **Every link resolves.** A router row pointing at a missing file is worse than a missing\n116: row, because it looks like coverage.\n117: \n118: ---\n119: \n120: ## 4. ADDING A RULE LATER\n121: \n122: Two rows, one file. If a new rule costs more than that, the router is not a router.\n123: \n124: ---\n125: \n126: ## 5. SELF-CHECK\n127: \n128: - [ ] The router contains no doctrine of its own.\n129: - [ ] Every trigger row is written on an action, not a topic.\n130: - [ ] Every link resolves to a file that exists.\n131: - [ ] The scope statement admits every rule the trigger table routes to.\n132: - [ ] Trigger rows and index rows are the same count as the rule files.","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/sk-doc/sk-create-repo-rule/assets/repo-rules-router-template.md, lines 1-132\n1: ---\n2: title: \"Repo Rules Router Template\"\n3: description: \"The prerequisite. A repository with no trigger table cannot load a rule at all, so the mode emits this before writing its first rule. Structurally unlike a rule and deliberately so.\"\n4: trigger_phrases:\n5:   - \"router template\"\n6:   - \"REPO RULES.md scaffold\"\n7:   - \"trigger table\"\n8:   - \"no router exists\"\n9:   - \"first rule in a repository\"\n10: importance_tier: important\n11: contextType: reference\n12: version: 1.1.1.0\n13: ---\n14: \n15: # Repo Rules Router Template\n16: \n17: Emitted only when `REPO RULES.md` does not exist. **Nobody asks for this.** It is\n18: created because the destination is missing, the way a build makes a directory before\n19: writing into it.\n20: \n21: ---\n22: \n23: ## 1. OVERVIEW\n24: \n25: ### Purpose\n26: \n27: The router is **not a rule**, and the difference is measured, not stylistic: no\n28: frontmatter, no `Fires when`, no `The rule`, no self-check, and four numbered sections\n29: against a rule's six to twelve. It holds no doctrine of its own. Every rule it lists is\n30: a file, and the router is the index.\n31: \n32: ### Usage\n33: \n34: - `REPO RULES.md` does not exist yet.\n35: - You are about to write the first rule in a repository.\n36: - A repository has no trigger table, so no rule can load.\n37: \n38: ---\n39: \n40: ## 2. THE TEMPLATE\n41: \n42: <!-- BEGIN TEMPLATE -->\n43: ```markdown\n44: # REPO RULES\n45: \n46: Repo-local operating rules. `AGENTS.md` **Gate 5 (§2)** makes reading this mandatory\n47: before your first write of the session. This document then routes you to every rule\n48: file that governs what you are about to do. **It is a router, not a rulebook:** it\n49: holds no rules of its own.\n50: \n51: ---\n52: \n53: ## 1. HOW TO USE THIS\n54: \n55: 1. **Match on the action you are about to take**, not the topic of the request.\n56: 2. **Load before the action.** A rule read afterwards is a post-mortem.\n57: 3. **A file already in context is not re-read.**\n58: 4. **Every trigger that fires is loaded, not just the first.** They compose, and the more\n59:    specific wins on conflict. Three and four firing at once is the normal case, not an\n60:    edge case.\n61: 5. **Nothing fires → `AGENTS.md` alone governs.** Do not hunt for a rule to apply.\n62: \n63: ### Precedence\n64: \n65: | Level | Source | Can be overridden? |\n66: |-------|--------|--------------------|\n67: | 1 | Every `AGENTS.md` §1 hard blocker, the Four Laws, PLAN-WORKFLOW LOCK, Comment Hygiene, and every mandatory gate in §2 | No |\n68: | 2 | An explicit, in-the-moment operator instruction | Not applicable, it is the instruction |\n69: | 3 | These rule files | Only by level 1 or 2 |\n70: | 4 | General judgment | By anything above |\n71: \n72: A rule file may tighten `AGENTS.md`. None relaxes a HARD BLOCK or authorizes what\n73: `AGENTS.md` forbids. Gate 5 does not change that: it makes the **load** mandatory,\n74: while what you load stays at level 3, the obligation to read is tier 1, the content\n75: is not.\n76: \n77: ---\n78: \n79: ## 2. TRIGGER TABLE\n80: \n81: | You are about to… | Load | It settles |\n82: |-------------------|------|-----------|\n83: | <the action, in the words someone would use> | [`<rule>.md`](repo-rules/<rule>.md) | <the question it answers> |\n84: \n85: ---\n86: \n87: ## 3. INDEX\n88: \n89: | Rule | Summary |\n90: |------|---------|\n91: | [<Rule>](repo-rules/<rule>.md) | <the binding sentence, compressed to one line> |\n92: \n93: ---\n94: \n95: ## 4. SCOPE OF THIS DOCUMENT\n96: \n97: **In:** <what this rule set is for, the categories of discipline it carries.>\n98: \n99: **Out:** <what it deliberately excludes, and which document owns each instead.>\n100: ```\n101: <!-- END TEMPLATE -->\n102: \n103: ---\n104: \n105: ## 3. WHAT THE ROUTER MUST NOT BECOME\n106: \n107: **It holds no rules.** The moment a router explains *how* to do something rather than\n108: *where to look*, it has become a rule file with a routing table attached, and the set has\n109: two places to change instead of one.\n110: \n111: **Its scope statement is load-bearing.** A trigger row pointing at a rule the scope\n112: statement excludes is a document contradicting itself at the exact point a reader\n113: consults it. The shipped router hit this twice and both times the boundary had to move.\n114: \n115: **Every link resolves.** A router row pointing at a missing file is worse than a missing\n116: row, because it looks like coverage.\n117: \n118: ---\n119: \n120: ## 4. ADDING A RULE LATER\n121: \n122: Two rows, one file. If a new rule costs more than that, the router is not a router.\n123: \n124: ---\n125: \n126: ## 5. SELF-CHECK\n127: \n128: - [ ] The router contains no doctrine of its own.\n129: - [ ] Every trigger row is written on an action, not a topic.\n130: - [ ] Every link resolves to a file that exists.\n131: - [ ] The scope statement admits every rule the trigger table routes to.\n132: - [ ] Trigger rows and index rows are the same count as the rule files."}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\": \"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/sk-doc/sk-create-repo-rule/assets/repo-rules-router-template.md\"}"},"time":{"start":1794559471847,"end":1794559471984}}}}
