{"type":"tool_use","timestamp":1794559359465,"sessionID":"ses_e2bed8c89ffeaoDJMekw21nJMc","part":{"partID":"prt_1d412b706001L10mOhrGWQ822t","sessionID":"ses_e2bed8c89ffeaoDJMekw21nJMc","messageID":"msg_1d412a8f0001cfwR2WmSIX57tw","type":"tool","id":"call_4c732129ed204132a6631f26","tool":"read","state":{"status":"completed","input":{"path":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/commands/doctor/scripts/agents-md-check.cjs"},"output":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/commands/doctor/scripts/agents-md-check.cjs, lines 1-1049\n1: #!/usr/bin/env node\n2: // ───────────────────────────────────────────────────────────────────\n3: // MODULE: Shipped Instruction Check Engine\n4: // ───────────────────────────────────────────────────────────────────\n5: 'use strict';\n6: \n7: // A repository that took the shipped instruction template can be in any of seven\n8: // states, and nothing in it says which one. Its shipped sections may be current, one\n9: // release behind, or edited in place; its own content may sit in the marked block or be\n10: // scattered between shipped sections; it may have no root document at all. Without that\n11: // answer there is nothing to plan a rewrite from, and no way to tell a safe replacement\n12: // from one that would drop a line somebody wrote. So this engine reports, per row and\n13: // without writing a byte, what the repository holds against the manifest.\n14: //\n15: // Three of the twelve rows are answers this engine must not invent. The delivery budget\n16: // and its anchors belong to the rule-copy canary, the Cursor pointer block belongs to\n17: // the gate 1 sync, and the router belongs to the repo-rules checker. Each already has\n18: // tests and an owner, so each is run as a child process and its own lines are carried\n19: // into the report; re-deriving any of them here would be a second opinion that drifts\n20: // from the first. The rest are pure classifiers over one read of the target tree.\n21: //\n22: // The run is read-only by construction: the only paths it opens for reading are under\n23: // the target root plus the manifest, and the three child tools it runs are read-only\n24: // modes. A repository that cannot be classified at all (no manifest, no target\n25: // directory, an unreadable root document) is a failed precondition and exits 2, because\n26: // an empty report would read like a clean one.\n27: //\n28: // Usage: agents-md-check.cjs [--root <dir>] [--manifest <path>] [--source] [--json]\n29: //   --root <dir>      classify this repository instead of the one this script ships in\n30: //   --manifest <path> read this manifest instead of the shipped one\n31: //   --source          run the template-purity row even outside the source repository\n32: //   --json            print one JSON object instead of the text report\n33: // Exit codes: 0 nothing to report, 1 at least one finding or an unproven row,\n34: //             2 a precondition failed\n35: \n36: // ─────────────────────────────────────────────────────────────────────────────\n37: // 1. IMPORTS\n38: // ─────────────────────────────────────────────────────────────────────────────\n39: \n40: const { spawnSync } = require('node:child_process');\n41: const fs = require('node:fs');\n42: const path = require('node:path');\n43: \n44: const {\n45:   classifyBody,\n46:   deliveryAnchorEnd,\n47:   matchSections,\n48:   segment,\n49: } = require('./lib/agents-md-sections.cjs');\n50: const { sourceStatus } = require('./agents-md-manifest.cjs');\n51: \n52: // ─────────────────────────────────────────────────────────────────────────────\n53: // 2. CONSTANTS\n54: // ─────────────────────────────────────────────────────────────────────────────\n55: \n56: const TAG = '[agents-md-check]';\n57: const REPO_ROOT = path.resolve(__dirname, '../../../..');\n58: const MANIFEST_PATH = path.resolve(__dirname, '../assets/agents-md-manifest.json');\n59: const GENERATOR = path.resolve(__dirname, 'agents-md-manifest.cjs');\n60: // The router checker ships beside the skill that authors rules, and the manifest links\n61: // it only through the router's own row, so its path is named here once.\n62: const REPO_RULES_CHECKER = path.resolve(\n63:   REPO_ROOT,\n64:   '.skilled/skills/sk-doc/sk-create-repo-rule/scripts/check-repo-rules.cjs',\n65: );\n66: // The checker's own tag prefix. Matching on it is what keeps this row a carrier of that\n67: // tool's verdict instead of a second implementation of its checks.\n68: const REPO_RULES_TAG = '[repo-rules-check]';\n69: const USAGE = 'Usage: node .skilled/commands/doctor/scripts/agents-md-check.cjs [--root <dir>] [--manifest <path>] [--source] [--json]';\n70: const TOOL_TIMEOUT_MS = 120000;\n71: \n72: // A repository where fewer than half the shipped sections survive is carrying its own\n73: // document, not a copy of the template. Above the line the question becomes which parts\n74: // of the template are still there, which is a per-section answer.\n75: const FOREIGN_SHARE = 0.5;\n76: \n77: const PASS = 'PASS';\n78: const FINDING = 'FINDING';\n79: const UNKNOWN = 'UNKNOWN';\n80: const INFO = 'INFO';\n81: \n82: class UsageError extends Error {}\n83: \n84: // ─────────────────────────────────────────────────────────────────────────────\n85: // 3. ARGUMENTS\n86: // ─────────────────────────────────────────────────────────────────────────────\n87: \n88: function parseArgs(argv) {\n89:   const options = { root: REPO_ROOT, manifest: MANIFEST_PATH, source: false, json: false, help: false };\n90:   for (let index = 0; index < argv.length; index += 1) {\n91:     const argument = argv[index];\n92:     if (argument === '--root') {\n93:       const value = argv[index + 1];\n94:       if (!value || value.startsWith('--')) throw new UsageError('--root needs a directory');\n95:       options.root = path.resolve(value);\n96:       index += 1;\n97:     } else if (argument === '--manifest') {\n98:       const value = argv[index + 1];\n99:       if (!value || value.startsWith('--')) throw new UsageError('--manifest needs a file path');\n100:       options.manifest = path.resolve(value);\n101:       index += 1;\n102:     } else if (argument === '--source') {\n103:       options.source = true;\n104:     } else if (argument === '--json') {\n105:       options.json = true;\n106:     } else if (argument === '--help' || argument === '-h') {\n107:       options.help = true;\n108:     } else {\n109:       throw new UsageError(`unknown argument: ${argument}`);\n110:     }\n111:   }\n112:   return options;\n113: }\n114: \n115: // ─────────────────────────────────────────────────────────────────────────────\n116: // 4. READING THE TARGET ONCE\n117: // ─────────────────────────────────────────────────────────────────────────────\n118: \n119: // Section offsets are byte offsets because the delivery budget is a byte count, while a\n120: // reader opens the file by line number. One conversion, in one place.\n121: function lineNumberAt(text, byteOffset) {\n122:   return Buffer.from(text, 'utf8').subarray(0, byteOffset).toString('utf8').split('\\n').length;\n123: }\n124: \n125: function trimmedLines(text) {\n126:   const lines = new Set();\n127:   for (const raw of String(text).split('\\n')) {\n128:     const line = raw.trim();\n129:     if (line !== '' && line !== '---') lines.add(line);\n130:   }\n131:   return lines;\n132: }\n133: \n134: // The repository's own lines, in order and with repeats. A set would report one line for\n135: // two occurrences, and a replacement loses both, so a duplicate is a second line to keep.\n136: function localLinesOf(body, reference) {\n137:   const known = trimmedLines(reference);\n138:   const local = [];\n139:   for (const raw of body.split('\\n')) {\n140:     const line = raw.trim();\n141:     if (line === '' || line === '---' || known.has(line)) continue;\n142:     local.push(line);\n143:   }\n144:   return local;\n145: }\n146: \n147: function knownBodies(manifest) {\n148:   const sections = manifest.derived && manifest.derived.sections ? manifest.derived.sections : {};\n149:   return {\n150:     current: Object.keys(sections).map((id) => ({ id, sha256: sections[id].sha256, body: sections[id].body })),\n151:     history: (manifest.derived && manifest.derived.history) || [],\n152:   };\n153: }\n154: \n155: // The block carries a heading and a note that the template itself ships, so \"the block is\n156: // empty\" means nothing beyond those two lines, not that the markers bracket no text.\n157: function blockHasContent(block, markers) {\n158:   if (!block || !block.complete) return false;\n159:   const shipped = new Set([markers.heading.trim(), markers.note.trim()]);\n160:   for (const raw of block.content.split('\\n')) {\n161:     const line = raw.trim();\n162:     if (line === '' || shipped.has(line)) continue;\n163:     return true;\n164:   }\n165:   return false;\n166: }\n167: \n168: /**\n169:  * Read the target tree once and keep what every row needs.\n170:  *\n171:  * @param {{root: string, manifest: Object}} input\n172:  * @returns {Object|null} Null when the root directory is not there.\n173:  */\n174: function readTarget({ root, manifest }) {\n175:   if (!fs.existsSync(root) || !fs.statSync(root).isDirectory()) return null;\n176: \n177:   const rootPath = path.join(root, manifest.root_file);\n178:   const exists = fs.existsSync(rootPath);\n179:   const text = exists ? fs.readFileSync(rootPath, 'utf8') : null;\n180:   const segmentation = exists\n181:     ? segment(text, manifest.markers, manifest.sections)\n182:     : { sections: [], block: null, prelude: null };\n183:   const pairing = matchSections(segmentation.sections, manifest.sections, segmentation.prelude);\n184: \n185:   return {\n186:     root,\n187:     rootPath,\n188:     exists,\n189:     text,\n190:     totalBytes: exists ? Buffer.byteLength(text, 'utf8') : 0,\n191:     block: segmentation.block,\n192:     prelude: segmentation.prelude,\n193:     sections: segmentation.sections,\n194:     matched: pairing.matched,\n195:     unregistered: pairing.unregistered,\n196:     unmatched: pairing.unmatched,\n197:     conflicts: pairing.conflicts,\n198:     currency: pairing.matched.map((row) => ({\n199:       id: row.entry.id,\n200:       section: row.section,\n201:       ...classifyBody(row.section.body, knownBodies(manifest)),\n202:     })),\n203:     blockContent: blockHasContent(segmentation.block, manifest.markers),\n204:   };\n205: }\n206: \n207: // ─────────────────────────────────────────────────────────────────────────────\n208: // 5. THE TWELVE ROWS\n209: // ─────────────────────────────────────────────────────────────────────────────\n210: \n211: function row(id, name, state, detail, extra = {}) {\n212:   return { id, name, state, detail, lines: extra.lines || [], entries: extra.entries || [] };\n213: }\n214: \n215: // A1. The one row an operator reads first: which of the seven shapes this repository is.\n216: function rowInstallState(context, manifest) {\n217:   const claudePath = path.join(context.root, 'CLAUDE.md');\n218:   if (!context.exists) {\n219:     if (fs.existsSync(claudePath)) {\n220:       return row('A1', 'install state', FINDING, 'claude-only',\n221:         { lines: [`no ${manifest.root_file}; CLAUDE.md is the only instruction file`] });\n222:     }\n223:     return row('A1', 'install state', FINDING, 'absent',\n224:       { lines: [`no ${manifest.root_file} and no CLAUDE.md`] });\n225:   }\n226: \n227:   const share = manifest.sections.length === 0 ? 0 : context.matched.length / manifest.sections.length;\n228:   if (share < FOREIGN_SHARE) {\n229:     return row('A1', 'install state', FINDING, 'foreign', {\n230:       lines: [\n231:         `${context.matched.length} of ${manifest.sections.length} shipped sections match, under the ${Math.round(FOREIGN_SHARE * 100)}% floor`,\n232:         'the root document is the repository\\'s own file',\n233:       ],\n234:     });\n235:   }\n236: \n237:   const localEdits = context.currency.filter((entry) => entry.state === 'edited' || entry.state === 'unknown-base');\n238:   const behind = context.currency.filter((entry) => entry.state === 'stale-known');\n239:   // A local edit outranks a missed release in the reading order: it is the shape that\n240:   // loses text if somebody replaces the document, and staleness only loses a patch.\n241:   if (localEdits.length > 0 || context.unregistered.length > 0) {\n242:     const lines = [];\n243:     for (const entry of localEdits) lines.push(`${entry.id}: ${entry.state}`);\n244:     for (const entry of context.unregistered) {\n245:       lines.push(entry.heading === null\n246:         ? 'unmarked text before the first heading'\n247:         : `unmarked section ${JSON.stringify(entry.heading)}`);\n248:     }\n249:     return row('A1', 'install state', FINDING, 'forked', { lines });\n250:   }\n251:   if (behind.length > 0) {\n252:     return row('A1', 'install state', FINDING, 'stale',\n253:       { lines: behind.map((entry) => `${entry.id}: ${entry.state}`) });\n254:   }\n255:   if (context.blockContent) {\n256:     return row('A1', 'install state', PASS, 'adopted',\n257:       { lines: ['every shipped section is current and the repository block carries content'] });\n258:   }\n259:   return row('A1', 'install state', PASS, 'pure',\n260:     { lines: ['every shipped section is current and the repository block is empty'] });\n261: }\n262: \n263: // A2. Which shipped sections survived, by the prefix each authored entry carries.\n264: function rowSectionsPresent(context, manifest) {\n265:   const present = new Set(context.matched.map((row_) => row_.entry.id));\n266:   const missing = manifest.sections.map((entry) => entry.id).filter((id) => !present.has(id));\n267:   const detail = `${present.size}/${manifest.sections.length} matched`;\n268:   if (missing.length === 0 && context.conflicts.length === 0) {\n269:     return row('A2', 'sections present', PASS, detail);\n270:   }\n271:   const lines = missing.map((id) => `missing section ${id}`);\n272:   for (const conflict of context.conflicts) lines.push(conflict.message);\n273:   return row('A2', 'sections present', FINDING, `${present.size}/${manifest.sections.length} matched, ${missing.length} missing`, {\n274:     lines,\n275:     entries: missing.map((id) => ({ id, present: false })),\n276:   });\n277: }\n278: \n279: // The byte offset of the first line that is exactly this text, or -1 when the document\n280: // does not carry it.\n281: function firstLineOffset(text, needle) {\n282:   if (text.startsWith(needle)) return 0;\n283:   const at = text.indexOf(`\\n${needle}`);\n284:   return at === -1 ? -1 : at + 1;\n285: }\n286: \n287: // The shipped numbering, read from the pin that names it. Hundreds of files cite these\n288: // numbers, and the document carries its fourth section before its third, so the citation\n289: // order is not the reading order and only the pin carries the expected one.\n290: function numberingReport(context, manifest) {\n291:   if (!context.exists) return { state: INFO, detail: 'no root document to number', lines: [] };\n292: \n293:   const pin = (manifest.pins || []).find((entry) => entry.kind === 'order');\n294:   if (!pin) return { state: INFO, detail: 'the manifest declares no numbering pin', lines: [] };\n295: \n296:   const found = [];\n297:   const absent = [];\n298:   for (const text of pin.texts) {\n299:     const at = firstLineOffset(context.text, text);\n300:     if (at === -1) absent.push(text.trim());\n301:     else found.push({ text: text.trim(), at });\n302:   }\n303:   const expected = pin.texts.map((text) => text.trim()).filter((text) => found.some((entry) => entry.text === text));\n304:   const actual = found.slice().sort((left, right) => left.at - right.at).map((entry) => entry.text);\n305: \n306:   const lines = absent.map((text) => `missing section number ${JSON.stringify(text)}`);\n307:   if (expected.join('|') !== actual.join('|')) {\n308:     lines.push(`the numbers appear as ${actual.join(', ')} instead of ${expected.join(', ')}`);\n309:   }\n310:   return { state: lines.length === 0 ? PASS : FINDING, detail: `${found.length}/${pin.texts.length} section numbers in place`, lines };\n311: }\n312: \n313: // A3. Shipped sections in manifest order, and section numbers unchanged.\n314: function rowOrderAndNumbering(context, manifest) {\n315:   const order = manifest.sections.map((entry) => entry.id);\n316:   const seen = context.matched.map((entry) => entry.entry.id);\n317:   const expected = order.filter((id) => seen.includes(id));\n318:   const numbering = numberingReport(context, manifest);\n319: \n320:   const lines = [...numbering.lines];\n321:   if (expected.join('|') !== seen.join('|')) {\n322:     const first = seen.findIndex((id, index) => id !== expected[index]);\n323:     lines.unshift(`section order differs at position ${first + 1}: found ${seen[first]}, expected ${expected[first]}`);\n324:   }\n325:   const state = lines.length === 0 ? PASS : FINDING;\n326:   return row('A3', 'order and numbering', state, state === PASS ? 'manifest order and section numbers unchanged' : 'order or numbering drifted', { lines });\n327: }\n328: \n329: // A4. Per section, whether the body is the shipped one, an older release, a local edit\n330: // or something with no base to name.\n331: function rowCurrency(context) {\n332:   const counts = { current: 0, 'stale-known': 0, edited: 0, 'unknown-base': 0 };\n333:   const entries = [];\n334:   for (const entry of context.currency) {\n335:     counts[entry.state] += 1;\n336:     entries.push({ id: entry.id, state: entry.state, base: entry.base || null });\n337:   }\n338:   // Nothing to classify is not a clean bill: the rows around this one report the empty or\n339:   // foreign document, and a pass here would read as currency that was checked.\n340:   if (entries.length === 0) {\n341:     return row('A4', 'section currency', INFO, 'no shipped section matched, so there is no body to classify');\n342:   }\n343:   const detail = `${counts.current} current, ${counts['stale-known']} stale-known, ${counts.edited} edited, ${counts['unknown-base']} unknown-base`;\n344:   const lines = [];\n345:   for (const entry of context.currency) {\n346:     if (entry.state === 'current') continue;\n347:     const base = entry.base ? entry.base.slice(0, 12) : 'none';\n348:     lines.push(`${entry.id}: ${entry.state} (closest known body ${base})`);\n349:   }\n350:   return row('A4', 'section currency', lines.length === 0 ? PASS : FINDING, detail, { lines, entries });\n351: }\n352: \n353: // A5. Every string downstream tooling greps out of the document, checked by its rule.\n354: function rowPins(context, manifest) {\n355:   const entries = [];\n356:   const byId = new Map(context.matched.map((entry) => [entry.entry.id, entry.section]));\n357: \n358:   for (const pin of manifest.pins || []) {\n359:     const verdict = pinVerdict(pin, context, manifest, byId);\n360:     entries.push({ id: pin.id, kind: pin.kind, state: verdict.state, detail: verdict.detail });\n361:   }\n362: \n363:   const failed = entries.filter((entry) => entry.state === FINDING);\n364:   const unmeasured = entries.filter((entry) => entry.state === UNKNOWN);\n365:   const lines = failed.map((entry) => `${entry.id} (${entry.kind}): ${entry.detail}`);\n366:   for (const entry of unmeasured) lines.push(`${entry.id} (${entry.kind}): ${entry.detail}`);\n367:   const state = failed.length > 0 ? FINDING : (unmeasured.length > 0 ? UNKNOWN : PASS);\n368:   const detail = `${entries.length - failed.length - unmeasured.length}/${entries.length} pins hold${unmeasured.length > 0 ? `, ${unmeasured.length} unmeasured` : ''}`;\n369:   return row('A5', 'pins', state, detail, { lines, entries });\n370: }\n371: \n372: function pinVerdict(pin, context, manifest, byId) {\n373:   const section = pin.section ? byId.get(pin.section) : null;\n374:   if (pin.section && !section) {\n375:     return { state: FINDING, detail: `the section ${pin.section} that carries this pin is missing` };\n376:   }\n377: \n378:   switch (pin.kind) {\n379:     case 'exact': {\n380:       const missing = pin.texts.filter((text) => !section.body.includes(text));\n381:       return missing.length === 0\n382:         ? { state: PASS, detail: `all ${pin.texts.length} strings present in ${pin.section}` }\n383:         : { state: FINDING, detail: `missing ${JSON.stringify(missing[0])} in ${pin.section}` };\n384:     }\n385:     case 'line': {\n386:       const required = (pin.requires || pin.texts).map((text) => text.toLowerCase());\n387:       const hit = section.body.split('\\n').some((line) => {\n388:         const lower = line.toLowerCase();\n389:         return required.every((text) => lower.includes(text));\n390:       });\n391:       return hit\n392:         ? { state: PASS, detail: `a line in ${pin.section} carries ${required.join(', ')}` }\n393:         : { state: FINDING, detail: `no line in ${pin.section} carries ${required.join(', ')}` };\n394:     }\n395:     case 'first-occurrence': {\n396:       const at = context.text.indexOf(pin.texts[0]);\n397:       const inside = at >= section.start && at < section.end;\n398:       if (inside) return { state: PASS, detail: `the first occurrence sits inside ${pin.section}` };\n399:       return {\n400:         state: FINDING,\n401:         detail: at === -1\n402:           ? `the text ${JSON.stringify(pin.texts[0])} is absent`\n403:           : `the first occurrence at byte ${at} sits outside ${pin.section} (${section.start}..${section.end}), so anything reading the first line of the document follows it instead`,\n404:       };\n405:     }\n406:     case 'delivery-anchor': {\n407:       const end = deliveryAnchorEnd(section, pin);\n408:       if (end === null) return { state: FINDING, detail: `the anchor text is absent from ${pin.section}` };\n409:       const limit = manifest.budget.prefix_bytes;\n410:       return end <= limit\n411:         ? { state: PASS, detail: `${pin.section} ends at byte ${end}, inside ${limit}` }\n412:         : { state: FINDING, detail: `${pin.section} ends at byte ${end}, past the ${limit}-byte delivery prefix` };\n413:     }\n414:     case 'budget': {\n415:       const declared = manifest.budget[pin.limit_key];\n416:       const pinned = Number(pin.texts[0]);\n417:       return declared === pinned\n418:         ? { state: PASS, detail: `${pin.limit_key} is ${declared}` }\n419:         : { state: FINDING, detail: `${pin.limit_key} reads ${declared}, the pin says ${pinned}` };\n420:     }\n421:     case 'order': {\n422:       const numbering = numberingReport(context, manifest);\n423:       return { state: numbering.state, detail: numbering.detail };\n424:     }\n425:     case 'file': {\n426:       const target = path.join(context.root, pin.path);\n427:       return fs.existsSync(target)\n428:         ? { state: PASS, detail: `${pin.path} exists` }\n429:         : { state: FINDING, detail: `${pin.path} is missing` };\n430:     }\n431:     default:\n432:       // A kind the engine has no rule for is a pin nobody measured. Counting it as a hold\n433:       // would report a manifest edit as verified.\n434:       return { state: UNKNOWN, detail: `no rule for a pin of kind ${pin.kind}` };\n435:   }\n436: }\n437: \n438: // A6. The delivery budget: the canary's own AGENTS.md lines, plus the two measurements\n439: // the report needs. Only this row's file is kept, because the canary also pins the skill\n440: // it ships in and a consumer legitimately has none of those.\n441: function rowBudget(context, manifest, tools) {\n442:   if (typeof tools.canary !== 'string' || !fs.existsSync(tools.canary)) {\n443:     return row('A6', 'delivery budget', UNKNOWN,\n444:       `the rule-copy canary is not installed at ${tools.canary || '(no path)'}; the budget cannot be measured`);\n445:   }\n446: \n447:   const run = spawnSync(process.execPath, [tools.canary, '--root', context.root], {\n448:     encoding: 'utf8',\n449:     timeout: TOOL_TIMEOUT_MS,\n450:     maxBuffer: 16 * 1024 * 1024,\n451:   });\n452:   const output = `${run.stdout || ''}\\n${run.stderr || ''}`.split('\\n').map((line) => line.trim()).filter((line) => line !== '');\n453:   if (run.error || (run.status !== 0 && run.status !== 1)) {\n454:     return row('A6', 'delivery budget', UNKNOWN,\n455:       `the rule-copy canary could not run: ${run.error ? run.error.message : `exit ${run.status}`}`);\n456:   }\n457: \n458:   // The canary prints its verdict, an anchor table and its findings. Only the findings\n459:   // that name this document belong to this row; its PASS and table lines are its own\n460:   // report, and the anchor end byte is measured below instead of parsed back out.\n461:   const own = output\n462:     .filter((line) => line.includes(manifest.root_file))\n463:     .filter((line) => /^(MISSING|BLOCKED):/u.test(line));\n464:   const elsewhere = output.filter((line) => !line.includes(manifest.root_file));\n465: \n466:   const limit = manifest.budget.prefix_bytes;\n467:   const ceiling = manifest.budget.max_bytes;\n468:   const prefixEnd = (manifest.pins || [])\n469:     .filter((pin) => pin.kind === 'delivery-anchor')\n470:     .reduce((max, pin) => {\n471:       const section = context.matched.find((entry) => entry.entry.id === pin.section);\n472:       if (!section) return max;\n473:       const end = deliveryAnchorEnd(section.section, pin);\n474:       return end === null ? max : Math.max(max, end);\n475:     }, 0);\n476: \n477:   const failures = [...own];\n478:   // The canary already names whatever it measured, so this row adds a figure only for a\n479:   // defect the canary did not report, instead of printing the same ceiling twice.\n480:   if (prefixEnd > limit && !own.some((line) => line.includes('delivery prefix'))) {\n481:     failures.push(`the last anchor ends at byte ${prefixEnd}, past the ${limit}-byte delivery prefix`);\n482:   }\n483:   if (context.totalBytes > ceiling && !own.some((line) => line.includes('ceiling'))) {\n484:     failures.push(`${context.totalBytes} bytes exceeds the ${ceiling}-byte ceiling`);\n485:   }\n486:   // A failing canary that names other files only is still a fact worth stating, because\n487:   // its exit status would otherwise read as this row's verdict. A passing one needs no\n488:   // note: its remaining lines are its own anchor table.\n489:   const notes = failures.length === 0 && run.status !== 0 && elsewhere.length > 0\n490:     ? [`the canary exits ${run.status} over ${elsewhere.length} line(s) outside ${manifest.root_file}, which belong to other files' pins`]\n491:     : [];\n492: \n493:   return row('A6', 'delivery budget', failures.length === 0 ? PASS : FINDING,\n494:     `${prefixEnd} of ${limit} bytes to the last anchor, ${context.totalBytes} of ${ceiling} bytes total`,\n495:     { lines: [...failures, ...notes] });\n496: }\n497: \n498: // A7. The repository block: one start marker line, one end marker line, in that order,\n499: // after every shipped section, small enough to leave headroom. A marker is the whole line,\n500: // so the same bytes quoted inside a sentence are prose and do not make a second block.\n501: function rowBlock(context, manifest) {\n502:   const { budget } = manifest;\n503:   const block = context.block;\n504:   const starts = block === null ? 0 : block.markerLines.start.length;\n505:   const ends = block === null ? 0 : block.markerLines.end.length;\n506: \n507:   if (starts === 0 && ends === 0) {\n508:     return row('A7', 'repo-local block', PASS, `no block; ${context.totalBytes} of ${budget.max_bytes} bytes used`);\n509:   }\n510:   if (starts !== 1 || ends !== 1) {\n511:     const lines = ['the block cannot be placed, so nothing inside it can be carried'];\n512:     const where = [];\n513:     if (block !== null && starts > 0) where.push(`the start marker sits on line ${block.markerLines.start.join(' and line ')}`);\n514:     if (block !== null && ends > 0) where.push(`the end marker on line ${block.markerLines.end.join(' and line ')}`);\n515:     if (where.length > 0) lines.push(where.join(', '));\n516:     return row('A7', 'repo-local block', FINDING,\n517:       `expected one start and one end marker line, found ${starts} and ${ends}`, { lines });\n518:   }\n519: \n520:   const lines = [];\n521:   if (!block || !block.complete) {\n522:     lines.push('the end marker sits before the start marker, so the block is out of order and unreadable');\n523:   }\n524:   // Whatever the document carries below the block is content a replacement has to place\n525:   // around the block, so a block above it cannot be the one block a rewrite writes last.\n526:   const following = block === null ? [] : context.sections.filter((section) => section.start > block.start);\n527:   if (block && block.complete && following.length > 0) {\n528:     lines.push(`the block starts at byte ${block.start}, before ${following.length} section(s) that follow it (the first is ${JSON.stringify(following[0].heading)} at byte ${following[0].start})`);\n529:   }\n530:   if (block && block.complete && block.start < budget.prefix_bytes) {\n531:     lines.push(`the block starts at byte ${block.start}, inside the ${budget.prefix_bytes}-byte delivery prefix`);\n532:   }\n533:   if (context.totalBytes > budget.max_bytes) {\n534:     lines.push(`${context.totalBytes} bytes exceeds the ${budget.max_bytes}-byte ceiling`);\n535:   }\n536: \n537:   const size = block && block.complete ? Buffer.byteLength(block.content, 'utf8') : 0;\n538:   const headroom = budget.max_bytes - context.totalBytes;\n539:   const detail = block && block.complete\n540:     ? `block ${size} bytes, ${headroom} bytes of headroom`\n541:     : `block unreadable, ${headroom} bytes of headroom`;\n542:   return row('A7', 'repo-local block', lines.length === 0 ? PASS : FINDING, detail,\n543:     { lines, entries: [{ size, headroom, complete: Boolean(block && block.complete) }] });\n544: }\n545: \n546: // A8. Repository content outside the block that matches no shipped section. This is the\n547: // content a replacement would drop, so it is reported by line and byte range. The text\n548: // above the first heading has no heading to match, and arrives here with a null one.\n549: function rowUnmarked(context, manifest) {\n550:   const prefixBytes = manifest.budget.prefix_bytes;\n551:   const entries = context.unregistered.map((entry) => ({\n552:     heading: entry.heading,\n553:     line_start: lineNumberAt(context.text, entry.start),\n554:     line_end: lineNumberAt(context.text, Math.max(entry.start, entry.end - 1)),\n555:     byte_start: entry.start,\n556:     byte_end: entry.end,\n557:     in_prefix: entry.start < prefixBytes,\n558:   }));\n559:   if (entries.length === 0) return row('A8', 'unmarked repo-unique content', PASS, 'no section outside the block');\n560: \n561:   const headings = entries.filter((entry) => entry.heading !== null).length;\n562:   const detail = [];\n563:   if (headings > 0) detail.push(`${headings} section(s) outside the block match no shipped section`);\n564:   if (entries.length > headings) detail.push('the text above the first heading is repository content no section carries');\n565: \n566:   return row('A8', 'unmarked repo-unique content', FINDING,\n567:     detail.join('; '),\n568:     {\n569:       lines: entries.map((entry) => `${entry.heading === null ? 'text before the first heading' : JSON.stringify(entry.heading)}: lines ${entry.line_start}-${entry.line_end}, bytes ${entry.byte_start}-${entry.byte_end}${entry.in_prefix ? ', inside the delivery prefix' : ''}`),\n570:       entries,\n571:     });\n572: }\n573: \n574: // The line where two bodies first part company, with the two raw lines. A body can carry\n575: // every line the shipped body carries and still not be it — an extra space on an indent, a\n576: // line written twice, two lines swapped — and the operator needs the line to look at\n577: // rather than a finding with nothing under it.\n578: function bodyDifference(actual, expected) {\n579:   const left = String(actual).split('\\n');\n580:   const right = String(expected).split('\\n');\n581:   const last = Math.max(left.length, right.length);\n582:   for (let index = 0; index < last; index += 1) {\n583:     if (left[index] === right[index]) continue;\n584:     return {\n585:       line: index + 1,\n586:       actual: left[index] === undefined ? null : left[index],\n587:       shipped: right[index] === undefined ? null : right[index],\n588:     };\n589:   }\n590:   return null;\n591: }\n592: \n593: // A9. For a section that is not the shipped body, the lines the shipped body does not\n594: // carry, once per occurrence. A body that carries every shipped line can still differ, so\n595: // the row names that difference by line instead of reporting a finding with no line under\n596: // it: a finding nobody can act on reads like a bug in the checker.\n597: function rowUnmarkedEdits(context, manifest) {\n598:   const entries = [];\n599:   for (const entry of context.currency) {\n600:     if (entry.state !== 'edited' && entry.state !== 'unknown-base') continue;\n601:     const shipped = manifest.derived.sections[entry.id];\n602:     const body = shipped ? shipped.body : '';\n603:     const lines = localLinesOf(entry.section.body, body);\n604:     entries.push({\n605:       id: entry.id,\n606:       state: entry.state,\n607:       lines,\n608:       difference: lines.length === 0 ? bodyDifference(entry.section.body, body) : null,\n609:     });\n610:   }\n611:   if (entries.length === 0) return row('A9', 'unmarked local edits', PASS, 'no edited section');\n612: \n613:   const total = entries.reduce((sum, entry) => sum + entry.lines.length, 0);\n614:   const formatting = entries.filter((entry) => entry.lines.length === 0).length;\n615:   const detail = [`${entries.length} section(s) carry ${total} local line(s)`];\n616:   if (formatting > 0) detail.push(`${formatting} of them differ only in whitespace, order or a repeat`);\n617: \n618:   const lines = [];\n619:   for (const entry of entries) {\n620:     for (const line of entry.lines) lines.push(`${entry.id}: ${line}`);\n621:     if (entry.difference === null) continue;\n622:     lines.push(`${entry.id}: only whitespace, order or a repeat differs from the shipped body, at line ${entry.difference.line}: shipped ${JSON.stringify(entry.difference.shipped)}, the document carries ${JSON.stringify(entry.difference.actual)}`);\n623:   }\n624:   return row('A9', 'unmarked local edits', lines.length === 0 ? INFO : FINDING,\n625:     detail.join('; '), { lines, entries });\n626: }\n627: \n628: // A10. The copies each runtime loads. Claude Code reaches the root document only through\n629: // CLAUDE.md, so a missing pointer leaves Claude without it and a full copy double-loads\n630: // and drifts. The Cursor rule is generated and alone carries the gate 1 lookup to Cursor\n631: // and Devin, so it is checked by its own generator.\n632: function rowRuntimeCopies(context, manifest, tools) {\n633:   const entries = [];\n634:   const lines = [];\n635: \n636:   for (const expected of manifest.runtime_copies || []) {\n637:     const verdict = copyVerdict(expected, context, manifest, tools);\n638:     entries.push({ path: expected.path, kind: verdict.kind, state: verdict.state, detail: verdict.detail, lines: verdict.lines || [] });\n639:     // A copy nobody could measure is printed like a finding: a pass line with no detail\n640:     // reads as a copy that was checked and found right.\n641:     if (verdict.state === FINDING || verdict.state === UNKNOWN || verdict.kind === 'pointer missing') {\n642:       lines.push(`${expected.path}: ${verdict.kind} - ${verdict.detail}`);\n643:     }\n644:   }\n645: \n646:   const failed = entries.filter((entry) => entry.state === FINDING);\n647:   const unmeasured = entries.filter((entry) => entry.state === UNKNOWN);\n648:   // A missing pointer is a route the runtime does not have, not a copy that was checked.\n649:   const pointerMissing = entries.filter((entry) => entry.kind === 'pointer missing');\n650:   const expected = entries.length - failed.length - unmeasured.length - pointerMissing.length;\n651:   const state = failed.length > 0 ? FINDING : (unmeasured.length > 0 ? UNKNOWN : PASS);\n652:   const detail = `${expected}/${entries.length} copies as expected${unmeasured.length > 0 ? `, ${unmeasured.length} unmeasured` : ''}${pointerMissing.length > 0 ? `, ${pointerMissing.length} pointer missing` : ''}`;\n653:   return row('A10', 'runtime copies', state, detail, { lines, entries });\n654: }\n655: \n656: function copyVerdict(expected, context, manifest, tools) {\n657:   if (expected.report_only) {\n658:     return { state: INFO, kind: 'reported only', detail: 'outside the checklist this command rewrites' };\n659:   }\n660:   if (expected.path.startsWith('~')) {\n661:     return { state: INFO, kind: 'outside the repository', detail: 'reported, never read' };\n662:   }\n663: \n664:   const target = path.join(context.root, expected.path);\n665:   if (expected.path.endsWith('.md') && expected.expect.includes('gate1-block-in-sync')) {\n666:     if (typeof tools.pointerSync !== 'string' || !fs.existsSync(tools.pointerSync)) {\n667:       return { state: UNKNOWN, kind: 'gate1 block unmeasured', detail: `the pointer sync is not installed at ${tools.pointerSync || '(no path)'}` };\n668:     }\n669:     const run = spawnSync(process.execPath, [tools.pointerSync, '--check', '--root', context.root], {\n670:       encoding: 'utf8',\n671:       timeout: TOOL_TIMEOUT_MS,\n672:     });\n673:     const output = `${run.stdout || ''}\\n${run.stderr || ''}`.split('\\n').map((line) => line.trim()).filter((line) => line !== '');\n674:     if (run.status === 0) return { state: PASS, kind: 'gate1 block in sync', detail: 'the generator reports no drift' };\n675:     if (run.status === 1) return { state: FINDING, kind: 'gate1 block out of sync', detail: output.join('; ') };\n676:     return { state: UNKNOWN, kind: 'gate1 block unmeasured', detail: output.join('; ') || `the pointer sync exited ${run.status}` };\n677:   }\n678: \n679:   const exists = fs.existsSync(target) || isSymlink(target);\n680:   const expectsAbsent = expected.expect.length === 1 && expected.expect[0] === 'absent';\n681: \n682:   if (expected.path === '.cursor/rules/repo-local.md') {\n683:     if (context.blockContent) {\n684:       if (!exists) return { state: FINDING, kind: 'mirror missing', detail: 'the block carries content and nothing mirrors it' };\n685:       const mirror = fs.readFileSync(target, 'utf8');\n686:       const missing = [...trimmedLines(context.block.content)].filter((line) => !mirror.includes(line));\n687:       return missing.length === 0\n688:         ? { state: PASS, kind: 'mirror current', detail: 'the mirror carries the block' }\n689:         : { state: FINDING, kind: 'mirror behind', detail: `${missing.length} block line(s) are not in the mirror` };\n690:     }\n691:     return exists\n692:       ? { state: FINDING, kind: 'mirror of an empty block', detail: 'the block is empty and a mirror exists' }\n693:       : { state: PASS, kind: 'absent', detail: 'no block content to mirror' };\n694:   }\n695: \n696:   // Claude Code reaches the root document only through this file, so its absence is a route\n697:   // the runtime does not have rather than a copy that is wrong.\n698:   if (expected.path === 'CLAUDE.md' && !exists && context.exists) {\n699:     return {\n700:       state: INFO,\n701:       kind: 'pointer missing',\n702:       detail: 'Claude Code reads only CLAUDE.md, so without a one-line @' + manifest.root_file + ' pointer it never loads ' + manifest.root_file,\n703:     };\n704:   }\n705: \n706:   if (!exists) {\n707:     return expectsAbsent\n708:       ? { state: PASS, kind: 'absent', detail: 'nothing to load twice' }\n709:       : { state: PASS, kind: 'absent', detail: 'absent, which the checklist allows' };\n710:   }\n711: \n712:   if (isSymlink(target)) {\n713:     const link = fs.readlinkSync(target);\n714:     // A path the checklist expects to be absent is one no runtime should load, and a link\n715:     // there loads the root document under that name just as a copy would.\n716:     if (expectsAbsent) {\n717:       return { state: FINDING, kind: 'symlink where none belongs', detail: `links to ${link}, where the checklist expects no file` };\n718:     }\n719:     const pointsAtRoot = path.basename(link) === manifest.root_file;\n720:     if (pointsAtRoot) return { state: PASS, kind: 'symlink', detail: `links to ${link}` };\n721:     return { state: FINDING, kind: 'symlink elsewhere', detail: `links to ${link} instead of ${manifest.root_file}` };\n722:   }\n723: \n724:   const content = fs.readFileSync(target, 'utf8');\n725:   if (!context.exists) {\n726:     return { state: FINDING, kind: 'sole instruction file', detail: `there is no ${manifest.root_file} for it to point at` };\n727:   }\n728:   if (content === context.text) {\n729:     return { state: FINDING, kind: 'identical copy', detail: `byte-identical to ${manifest.root_file}, so the two will drift` };\n730:   }\n731: \n732:   const unique = localLinesOf(content, context.text);\n733:   const rootLines = trimmedLines(context.text);\n734:   const sharesShippedLine = [...trimmedLines(content)].some((line) => rootLines.has(line));\n735:   const namesRoot = [...trimmedLines(content)].some((line) => line.includes(manifest.root_file));\n736:   // A pointer is a file that carries no shipped line and names the root document. Anything\n737:   // else is either a copy or a copy plus local lines, and both drift: the second also\n738:   // loses text when it is replaced, so the lines only it carries are listed.\n739:   if (!sharesShippedLine && namesRoot) {\n740:     return { state: PASS, kind: 'pointer', detail: `names ${manifest.root_file} and carries no shipped line` };\n741:   }\n742:   return { state: FINDING, kind: 'divergent copy', detail: `${unique.length} line(s) only this file carries`, lines: unique };\n743: }\n744: \n745: function isSymlink(target) {\n746:   try {\n747:     return fs.lstatSync(target).isSymbolicLink();\n748:   } catch {\n749:     return false;\n750:   }\n751: }\n752: \n753: // A11. The router: present, carrying the rows the template ships, and passing its own\n754: // checker. The checker's summary line is carried through, never rebuilt.\n755: function rowRouter(context, manifest, tools) {\n756:   const routerPath = path.join(context.root, manifest.router_file);\n757:   if (!fs.existsSync(routerPath)) {\n758:     return row('A11', 'REPO RULES.md', FINDING, 'absent',\n759:       { lines: [`no ${manifest.router_file}: no repository rule can load`], entries: [{ path: manifest.router_file, present: false }] });\n760:   }\n761: \n762:   const text = fs.readFileSync(routerPath, 'utf8');\n763:   const shipped = (manifest.derived && manifest.derived.repo_rules) || { trigger_rows: [], index_rows: [] };\n764:   const lines = [];\n765:   const missing = [\n766:     ...missingRows(shipped.trigger_rows, parseTableRows(text, 'TRIGGER TABLE'), 'trigger'),\n767:     ...missingRows(shipped.index_rows, parseTableRows(text, 'INDEX'), 'index'),\n768:   ];\n769:   for (const entry of missing) lines.push(`missing ${entry.kind} row for ${entry.rule}`);\n770: \n771:   if (typeof tools.repoRules !== 'string' || !fs.existsSync(tools.repoRules)) {\n772:     return row('A11', 'REPO RULES.md', UNKNOWN, 'present; the repo-rules checker is not installed',\n773:       { lines: [...lines, `the checker is not installed at ${tools.repoRules || '(no path)'}`] });\n774:   }\n775: \n776:   const run = spawnSync(process.execPath, [tools.repoRules, '--root', context.root], {\n777:     encoding: 'utf8',\n778:     timeout: TOOL_TIMEOUT_MS,\n779:   });\n780:   const output = `${run.stdout || ''}\\n${run.stderr || ''}`.split('\\n').map((line) => line.trim()).filter((line) => line !== '');\n781:   const summary = output.find((line) => line.includes(REPO_RULES_TAG) && line.includes('RESULT:'));\n782: \n783:   if (run.status === 2 || !summary) {\n784:     return row('A11', 'REPO RULES.md', UNKNOWN, 'the repo-rules checker could not run',\n785:       { lines: [...lines, ...output.filter((line) => line.includes(REPO_RULES_TAG))] });\n786:   }\n787:   if (run.status !== 0) {\n788:     return row('A11', 'REPO RULES.md', FINDING, `${missing.length} shipped row(s) missing; the checker fails`,\n789:       { lines: [...lines, summary] });\n790:   }\n791:   return row('A11', 'REPO RULES.md', lines.length === 0 ? PASS : FINDING,\n792:     `${missing.length} shipped row(s) missing; ${summary}`, { lines: [...lines, summary] });\n793: }\n794: \n795: // The router's own table, read the same way the manifest's rows were derived. Comparing\n796: // shipped rows to the file is the only way to say which of them a consumer dropped.\n797: function parseTableRows(text, anchor) {\n798:   const lines = text.split('\\n');\n799:   const start = lines.findIndex((line) => line.startsWith('#') && line.includes(anchor));\n800:   if (start === -1) return [];\n801: \n802:   const rows = [];\n803:   let width = 0;\n804:   for (let index = start + 1; index < lines.length; index += 1) {\n805:     const line = lines[index].trim();\n806:     if (line.startsWith('#')) break;\n807:     if (!line.startsWith('|')) {\n808:       if (rows.length > 0 && line === '') break;\n809:       continue;\n810:     }\n811:     const cells = line.replace(/^\\|/u, '').replace(/\\|$/u, '').split('|').map((cell) => cell.trim());\n812:     if (cells.every((cell) => /^:?-+:?$/u.test(cell) || cell === '')) continue;\n813:     if (width === 0) {\n814:       width = cells.length;\n815:       continue;\n816:     }\n817:     if (cells.length !== width) continue;\n818:     rows.push(cells);\n819:   }\n820:   return rows;\n821: }\n822: \n823: function rulePathOf(cells) {\n824:   for (const cell of cells) {\n825:     const linked = /\\(([^)]+\\.md)\\)/u.exec(cell);\n826:     if (linked) return linked[1];\n827:     const bare = /`([^`]+\\.md)`/u.exec(cell);\n828:     if (bare) return bare[1];\n829:   }\n830:   return null;\n831: }\n832: \n833: function missingRows(shipped, present, kind) {\n834:   const found = new Set(present.map((cells) => rulePathOf(cells) || cells.join(' | ')));\n835:   const missing = [];\n836:   for (const cells of shipped) {\n837:     const rule = rulePathOf(cells) || cells.join(' | ');\n838:     if (!found.has(rule)) missing.push({ kind, rule });\n839:   }\n840:   return missing;\n841: }\n842: \n843: // A12. The source repository's own two promises: its block stays empty, and its derived\n844: // copy of the template is fresh. A consumer's block is its own, so this row reports INFO\n845: // there instead of telling it what to do with its own file.\n846: function rowTemplatePurity(context, manifest, tools, options) {\n847:   let source = { isSource: false, reason: `origin was not compared` };\n848:   try {\n849:     source = sourceStatus({ root: context.root, manifest });\n850:   } catch (error) {\n851:     source = { isSource: false, reason: error.message };\n852:   }\n853: \n854:   if (!options.source && !source.isSource) {\n855:     return row('A12', 'template purity', INFO,\n856:       `runs only in the source repository; ${source.reason || 'the origin differs'}`);\n857:   }\n858: \n859:   const lines = [];\n860:   if (context.blockContent) lines.push('the source repository block carries content, and every line here ships to every consumer');\n861:   if (context.block && !context.block.complete) lines.push('the source repository block is not well formed');\n862: \n863:   if (typeof tools.generator !== 'string' || !fs.existsSync(tools.generator)) {\n864:     return row('A12', 'template purity', UNKNOWN,\n865:       `the manifest generator is not installed at ${tools.generator || '(no path)'}`);\n866:   }\n867:   const run = spawnSync(process.execPath, [tools.generator, '--check', '--root', context.root, '--manifest', options.manifest], {\n868:     encoding: 'utf8',\n869:     timeout: TOOL_TIMEOUT_MS,\n870:   });\n871:   const output = `${run.stdout || ''}\\n${run.stderr || ''}`.split('\\n').map((line) => line.trim()).filter((line) => line !== '');\n872:   if (run.status !== 0) lines.push(...output);\n873: \n874:   const state = lines.length === 0 ? PASS : FINDING;\n875:   return row('A12', 'template purity', state,\n876:     state === PASS ? 'block empty and the derived copy is fresh' : 'the source template is not pure', { lines });\n877: }\n878: \n879: // ─────────────────────────────────────────────────────────────────────────────\n880: // 6. REPORT\n881: // ─────────────────────────────────────────────────────────────────────────────\n882: \n883: function defaultTools(manifest) {\n884:   const canaryPin = (manifest.pins || []).find((pin) => String(pin.consumer || '').endsWith('check-rule-copies.js'));\n885:   const pointerPin = (manifest.pins || []).find((pin) => pin.kind === 'first-occurrence');\n886:   return {\n887:     canary: canaryPin ? path.join(REPO_ROOT, canaryPin.consumer) : null,\n888:     pointerSync: pointerPin ? path.join(REPO_ROOT, pointerPin.consumer) : null,\n889:     repoRules: REPO_RULES_CHECKER,\n890:     generator: GENERATOR,\n891:   };\n892: }\n893: \n894: /**\n895:  * Classify one repository.\n896:  *\n897:  * @param {{root?: string, manifestPath?: string, source?: boolean, tools?: Object}} [input]\n898:  * @returns {{root: string, manifest: string, state: string, status: string, exitCode: number,\n899:  *   findings: number, unknown: number, rows: Array<Object>} | null} Null when the root\n900:  *   directory or the manifest is not readable.\n901:  */\n902: function buildReport(input = {}) {\n903:   const root = input.root ? path.resolve(input.root) : REPO_ROOT;\n904:   const manifestPath = input.manifestPath ? path.resolve(input.manifestPath) : MANIFEST_PATH;\n905:   if (!fs.existsSync(manifestPath)) return null;\n906: \n907:   let manifest;\n908:   try {\n909:     manifest = JSON.parse(fs.readFileSync(manifestPath, 'utf8'));\n910:   } catch {\n911:     return null;\n912:   }\n913: \n914:   const context = readTarget({ root, manifest });\n915:   if (context === null) return null;\n916: \n917:   const tools = { ...defaultTools(manifest), ...(input.tools || {}) };\n918:   const rows = [\n919:     rowInstallState(context, manifest),\n920:     rowSectionsPresent(context, manifest),\n921:     rowOrderAndNumbering(context, manifest),\n922:     rowCurrency(context),\n923:     rowPins(context, manifest),\n924:     rowBudget(context, manifest, tools),\n925:     rowBlock(context, manifest),\n926:     rowUnmarked(context, manifest),\n927:     rowUnmarkedEdits(context, manifest),\n928:     rowRuntimeCopies(context, manifest, tools),\n929:     rowRouter(context, manifest, tools),\n930:     rowTemplatePurity(context, manifest, tools, { source: Boolean(input.source), manifest: manifestPath }),\n931:   ];\n932: \n933:   const findings = rows.filter((entry) => entry.state === FINDING).length;\n934:   const unknown = rows.filter((entry) => entry.state === UNKNOWN).length;\n935:   const exitCode = findings > 0 || unknown > 0 ? 1 : 0;\n936:   const status = exitCode === 0 ? 'OK' : (findings > 0 ? 'FINDINGS' : 'UNKNOWN');\n937: \n938:   return {\n939:     root,\n940:     manifest: manifestPath,\n941:     state: rows[0].detail,\n942:     status,\n943:     exitCode,\n944:     findings,\n945:     unknown,\n946:     rows,\n947:   };\n948: }\n949: \n950: // A long row is a list, not a wall: the report keeps every line in the JSON form and\n951: // prints the first few here, so a reader sees the shape before the volume.\n952: const PRINTED_LINES = 20;\n953: \n954: function renderText(report) {\n955:   const lines = [];\n956:   for (const entry of report.rows) {\n957:     lines.push(`${entry.id} ${entry.name}: ${entry.detail}   (${entry.state})`);\n958:     for (const line of entry.lines.slice(0, PRINTED_LINES)) lines.push(`  ${line}`);\n959:     if (entry.lines.length > PRINTED_LINES) {\n960:       lines.push(`  ... ${entry.lines.length - PRINTED_LINES} more line(s), all of them in the JSON report`);\n961:     }\n962:   }\n963:   lines.push(`STATUS=${report.status} rows=${report.rows.length} findings=${report.findings} unknown=${report.unknown}`);\n964:   return `${lines.join('\\n')}\\n`;\n965: }\n966: \n967: function renderJson(report) {\n968:   const shaped = {\n969:     root: report.root,\n970:     manifest: report.manifest,\n971:     state: report.state,\n972:     status: report.status,\n973:     exit_code: report.exitCode,\n974:     findings: report.findings,\n975:     unknown: report.unknown,\n976:     rows: report.rows.map((entry) => ({\n977:       id: entry.id,\n978:       name: entry.name,\n979:       state: entry.state,\n980:       detail: entry.detail,\n981:       lines: entry.lines,\n982:       entries: entry.entries,\n983:     })),\n984:   };\n985:   return `${JSON.stringify(shaped, null, 2)}\\n`;\n986: }\n987: \n988: // ─────────────────────────────────────────────────────────────────────────────\n989: // 7. MAIN\n990: // ─────────────────────────────────────────────────────────────────────────────\n991: \n992: /**\n993:  * @param {string[]} argv\n994:  * @param {{tools?: Object}} [hooks] - test seams for the child tools\n995:  * @returns {number} the process exit code\n996:  */\n997: function main(argv, hooks = {}) {\n998:   const options = parseArgs(argv);\n999:   if (options.help) {\n1000:     console.log(USAGE);\n1001:     return 0;\n1002:   }\n1003: \n1004:   if (!fs.existsSync(options.manifest)) {\n1005:     console.error(`${TAG} ERROR: the manifest is missing at ${options.manifest}`);\n1006:     return 2;\n1007:   }\n1008:   if (!fs.existsSync(options.root) || !fs.statSync(options.root).isDirectory()) {\n1009:     console.error(`${TAG} ERROR: the target root is not a directory: ${options.root}`);\n1010:     return 2;\n1011:   }\n1012:   // The root file's name is the manifest's to declare, so this precondition reads the same\n1013:   // declaration every other read does instead of a name of its own.\n1014:   let rootFile = null;\n1015:   try {\n1016:     rootFile = JSON.parse(fs.readFileSync(options.manifest, 'utf8')).root_file || null;\n1017:   } catch {\n1018:     // An unreadable manifest is refused below, where the run has no report to print.\n1019:     rootFile = null;\n1020:   }\n1021:   const rootPath = rootFile === null ? null : path.join(options.root, rootFile);\n1022:   if (rootPath !== null && fs.existsSync(rootPath)) {\n1023:     try {\n1024:       fs.readFileSync(rootPath, 'utf8');\n1025:     } catch (error) {\n1026:       console.error(`${TAG} ERROR: cannot read ${rootPath}: ${error.message}`);\n1027:       return 2;\n1028:     }\n1029:   }\n1030: \n1031:   const report = buildReport({\n1032:     root: options.root,\n1033:     manifestPath: options.manifest,\n1034:     source: options.source,\n1035:     tools: hooks.tools || {},\n1036:   });\n1037:   if (report === null) {\n1038:     // A manifest that cannot be parsed leaves nothing to compare against, and an empty\n1039:     // report would read like a clean one.\n1040:     console.error(`${TAG} ERROR: cannot classify ${options.root}: the manifest at ${options.manifest} could not be read as JSON`);\n1041:     return 2;\n1042:   }\n1043: \n1044:   process.stdout.write(options.json ? renderJson(report) : renderText(report));\n1045:   return report.exitCode;\n1046: }\n1047: \n1048: if (require.main === module) {\n1049:   try {\n[Output truncated. Continue reading with offset: 1050]","title":"read","metadata":{"metadata":{"truncated":true},"content":[{"type":"text","text":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/commands/doctor/scripts/agents-md-check.cjs, lines 1-1049\n1: #!/usr/bin/env node\n2: // ───────────────────────────────────────────────────────────────────\n3: // MODULE: Shipped Instruction Check Engine\n4: // ───────────────────────────────────────────────────────────────────\n5: 'use strict';\n6: \n7: // A repository that took the shipped instruction template can be in any of seven\n8: // states, and nothing in it says which one. Its shipped sections may be current, one\n9: // release behind, or edited in place; its own content may sit in the marked block or be\n10: // scattered between shipped sections; it may have no root document at all. Without that\n11: // answer there is nothing to plan a rewrite from, and no way to tell a safe replacement\n12: // from one that would drop a line somebody wrote. So this engine reports, per row and\n13: // without writing a byte, what the repository holds against the manifest.\n14: //\n15: // Three of the twelve rows are answers this engine must not invent. The delivery budget\n16: // and its anchors belong to the rule-copy canary, the Cursor pointer block belongs to\n17: // the gate 1 sync, and the router belongs to the repo-rules checker. Each already has\n18: // tests and an owner, so each is run as a child process and its own lines are carried\n19: // into the report; re-deriving any of them here would be a second opinion that drifts\n20: // from the first. The rest are pure classifiers over one read of the target tree.\n21: //\n22: // The run is read-only by construction: the only paths it opens for reading are under\n23: // the target root plus the manifest, and the three child tools it runs are read-only\n24: // modes. A repository that cannot be classified at all (no manifest, no target\n25: // directory, an unreadable root document) is a failed precondition and exits 2, because\n26: // an empty report would read like a clean one.\n27: //\n28: // Usage: agents-md-check.cjs [--root <dir>] [--manifest <path>] [--source] [--json]\n29: //   --root <dir>      classify this repository instead of the one this script ships in\n30: //   --manifest <path> read this manifest instead of the shipped one\n31: //   --source          run the template-purity row even outside the source repository\n32: //   --json            print one JSON object instead of the text report\n33: // Exit codes: 0 nothing to report, 1 at least one finding or an unproven row,\n34: //             2 a precondition failed\n35: \n36: // ─────────────────────────────────────────────────────────────────────────────\n37: // 1. IMPORTS\n38: // ─────────────────────────────────────────────────────────────────────────────\n39: \n40: const { spawnSync } = require('node:child_process');\n41: const fs = require('node:fs');\n42: const path = require('node:path');\n43: \n44: const {\n45:   classifyBody,\n46:   deliveryAnchorEnd,\n47:   matchSections,\n48:   segment,\n49: } = require('./lib/agents-md-sections.cjs');\n50: const { sourceStatus } = require('./agents-md-manifest.cjs');\n51: \n52: // ─────────────────────────────────────────────────────────────────────────────\n53: // 2. CONSTANTS\n54: // ─────────────────────────────────────────────────────────────────────────────\n55: \n56: const TAG = '[agents-md-check]';\n57: const REPO_ROOT = path.resolve(__dirname, '../../../..');\n58: const MANIFEST_PATH = path.resolve(__dirname, '../assets/agents-md-manifest.json');\n59: const GENERATOR = path.resolve(__dirname, 'agents-md-manifest.cjs');\n60: // The router checker ships beside the skill that authors rules, and the manifest links\n61: // it only through the router's own row, so its path is named here once.\n62: const REPO_RULES_CHECKER = path.resolve(\n63:   REPO_ROOT,\n64:   '.skilled/skills/sk-doc/sk-create-repo-rule/scripts/check-repo-rules.cjs',\n65: );\n66: // The checker's own tag prefix. Matching on it is what keeps this row a carrier of that\n67: // tool's verdict instead of a second implementation of its checks.\n68: const REPO_RULES_TAG = '[repo-rules-check]';\n69: const USAGE = 'Usage: node .skilled/commands/doctor/scripts/agents-md-check.cjs [--root <dir>] [--manifest <path>] [--source] [--json]';\n70: const TOOL_TIMEOUT_MS = 120000;\n71: \n72: // A repository where fewer than half the shipped sections survive is carrying its own\n73: // document, not a copy of the template. Above the line the question becomes which parts\n74: // of the template are still there, which is a per-section answer.\n75: const FOREIGN_SHARE = 0.5;\n76: \n77: const PASS = 'PASS';\n78: const FINDING = 'FINDING';\n79: const UNKNOWN = 'UNKNOWN';\n80: const INFO = 'INFO';\n81: \n82: class UsageError extends Error {}\n83: \n84: // ─────────────────────────────────────────────────────────────────────────────\n85: // 3. ARGUMENTS\n86: // ─────────────────────────────────────────────────────────────────────────────\n87: \n88: function parseArgs(argv) {\n89:   const options = { root: REPO_ROOT, manifest: MANIFEST_PATH, source: false, json: false, help: false };\n90:   for (let index = 0; index < argv.length; index += 1) {\n91:     const argument = argv[index];\n92:     if (argument === '--root') {\n93:       const value = argv[index + 1];\n94:       if (!value || value.startsWith('--')) throw new UsageError('--root needs a directory');\n95:       options.root = path.resolve(value);\n96:       index += 1;\n97:     } else if (argument === '--manifest') {\n98:       const value = argv[index + 1];\n99:       if (!value || value.startsWith('--')) throw new UsageError('--manifest needs a file path');\n100:       options.manifest = path.resolve(value);\n101:       index += 1;\n102:     } else if (argument === '--source') {\n103:       options.source = true;\n104:     } else if (argument === '--json') {\n105:       options.json = true;\n106:     } else if (argument === '--help' || argument === '-h') {\n107:       options.help = true;\n108:     } else {\n109:       throw new UsageError(`unknown argument: ${argument}`);\n110:     }\n111:   }\n112:   return options;\n113: }\n114: \n115: // ─────────────────────────────────────────────────────────────────────────────\n116: // 4. READING THE TARGET ONCE\n117: // ─────────────────────────────────────────────────────────────────────────────\n118: \n119: // Section offsets are byte offsets because the delivery budget is a byte count, while a\n120: // reader opens the file by line number. One conversion, in one place.\n121: function lineNumberAt(text, byteOffset) {\n122:   return Buffer.from(text, 'utf8').subarray(0, byteOffset).toString('utf8').split('\\n').length;\n123: }\n124: \n125: function trimmedLines(text) {\n126:   const lines = new Set();\n127:   for (const raw of String(text).split('\\n')) {\n128:     const line = raw.trim();\n129:     if (line !== '' && line !== '---') lines.add(line);\n130:   }\n131:   return lines;\n132: }\n133: \n134: // The repository's own lines, in order and with repeats. A set would report one line for\n135: // two occurrences, and a replacement loses both, so a duplicate is a second line to keep.\n136: function localLinesOf(body, reference) {\n137:   const known = trimmedLines(reference);\n138:   const local = [];\n139:   for (const raw of body.split('\\n')) {\n140:     const line = raw.trim();\n141:     if (line === '' || line === '---' || known.has(line)) continue;\n142:     local.push(line);\n143:   }\n144:   return local;\n145: }\n146: \n147: function knownBodies(manifest) {\n148:   const sections = manifest.derived && manifest.derived.sections ? manifest.derived.sections : {};\n149:   return {\n150:     current: Object.keys(sections).map((id) => ({ id, sha256: sections[id].sha256, body: sections[id].body })),\n151:     history: (manifest.derived && manifest.derived.history) || [],\n152:   };\n153: }\n154: \n155: // The block carries a heading and a note that the template itself ships, so \"the block is\n156: // empty\" means nothing beyond those two lines, not that the markers bracket no text.\n157: function blockHasContent(block, markers) {\n158:   if (!block || !block.complete) return false;\n159:   const shipped = new Set([markers.heading.trim(), markers.note.trim()]);\n160:   for (const raw of block.content.split('\\n')) {\n161:     const line = raw.trim();\n162:     if (line === '' || shipped.has(line)) continue;\n163:     return true;\n164:   }\n165:   return false;\n166: }\n167: \n168: /**\n169:  * Read the target tree once and keep what every row needs.\n170:  *\n171:  * @param {{root: string, manifest: Object}} input\n172:  * @returns {Object|null} Null when the root directory is not there.\n173:  */\n174: function readTarget({ root, manifest }) {\n175:   if (!fs.existsSync(root) || !fs.statSync(root).isDirectory()) return null;\n176: \n177:   const rootPath = path.join(root, manifest.root_file);\n178:   const exists = fs.existsSync(rootPath);\n179:   const text = exists ? fs.readFileSync(rootPath, 'utf8') : null;\n180:   const segmentation = exists\n181:     ? segment(text, manifest.markers, manifest.sections)\n182:     : { sections: [], block: null, prelude: null };\n183:   const pairing = matchSections(segmentation.sections, manifest.sections, segmentation.prelude);\n184: \n185:   return {\n186:     root,\n187:     rootPath,\n188:     exists,\n189:     text,\n190:     totalBytes: exists ? Buffer.byteLength(text, 'utf8') : 0,\n191:     block: segmentation.block,\n192:     prelude: segmentation.prelude,\n193:     sections: segmentation.sections,\n194:     matched: pairing.matched,\n195:     unregistered: pairing.unregistered,\n196:     unmatched: pairing.unmatched,\n197:     conflicts: pairing.conflicts,\n198:     currency: pairing.matched.map((row) => ({\n199:       id: row.entry.id,\n200:       section: row.section,\n201:       ...classifyBody(row.section.body, knownBodies(manifest)),\n202:     })),\n203:     blockContent: blockHasContent(segmentation.block, manifest.markers),\n204:   };\n205: }\n206: \n207: // ─────────────────────────────────────────────────────────────────────────────\n208: // 5. THE TWELVE ROWS\n209: // ─────────────────────────────────────────────────────────────────────────────\n210: \n211: function row(id, name, state, detail, extra = {}) {\n212:   return { id, name, state, detail, lines: extra.lines || [], entries: extra.entries || [] };\n213: }\n214: \n215: // A1. The one row an operator reads first: which of the seven shapes this repository is.\n216: function rowInstallState(context, manifest) {\n217:   const claudePath = path.join(context.root, 'CLAUDE.md');\n218:   if (!context.exists) {\n219:     if (fs.existsSync(claudePath)) {\n220:       return row('A1', 'install state', FINDING, 'claude-only',\n221:         { lines: [`no ${manifest.root_file}; CLAUDE.md is the only instruction file`] });\n222:     }\n223:     return row('A1', 'install state', FINDING, 'absent',\n224:       { lines: [`no ${manifest.root_file} and no CLAUDE.md`] });\n225:   }\n226: \n227:   const share = manifest.sections.length === 0 ? 0 : context.matched.length / manifest.sections.length;\n228:   if (share < FOREIGN_SHARE) {\n229:     return row('A1', 'install state', FINDING, 'foreign', {\n230:       lines: [\n231:         `${context.matched.length} of ${manifest.sections.length} shipped sections match, under the ${Math.round(FOREIGN_SHARE * 100)}% floor`,\n232:         'the root document is the repository\\'s own file',\n233:       ],\n234:     });\n235:   }\n236: \n237:   const localEdits = context.currency.filter((entry) => entry.state === 'edited' || entry.state === 'unknown-base');\n238:   const behind = context.currency.filter((entry) => entry.state === 'stale-known');\n239:   // A local edit outranks a missed release in the reading order: it is the shape that\n240:   // loses text if somebody replaces the document, and staleness only loses a patch.\n241:   if (localEdits.length > 0 || context.unregistered.length > 0) {\n242:     const lines = [];\n243:     for (const entry of localEdits) lines.push(`${entry.id}: ${entry.state}`);\n244:     for (const entry of context.unregistered) {\n245:       lines.push(entry.heading === null\n246:         ? 'unmarked text before the first heading'\n247:         : `unmarked section ${JSON.stringify(entry.heading)}`);\n248:     }\n249:     return row('A1', 'install state', FINDING, 'forked', { lines });\n250:   }\n251:   if (behind.length > 0) {\n252:     return row('A1', 'install state', FINDING, 'stale',\n253:       { lines: behind.map((entry) => `${entry.id}: ${entry.state}`) });\n254:   }\n255:   if (context.blockContent) {\n256:     return row('A1', 'install state', PASS, 'adopted',\n257:       { lines: ['every shipped section is current and the repository block carries content'] });\n258:   }\n259:   return row('A1', 'install state', PASS, 'pure',\n260:     { lines: ['every shipped section is current and the repository block is empty'] });\n261: }\n262: \n263: // A2. Which shipped sections survived, by the prefix each authored entry carries.\n264: function rowSectionsPresent(context, manifest) {\n265:   const present = new Set(context.matched.map((row_) => row_.entry.id));\n266:   const missing = manifest.sections.map((entry) => entry.id).filter((id) => !present.has(id));\n267:   const detail = `${present.size}/${manifest.sections.length} matched`;\n268:   if (missing.length === 0 && context.conflicts.length === 0) {\n269:     return row('A2', 'sections present', PASS, detail);\n270:   }\n271:   const lines = missing.map((id) => `missing section ${id}`);\n272:   for (const conflict of context.conflicts) lines.push(conflict.message);\n273:   return row('A2', 'sections present', FINDING, `${present.size}/${manifest.sections.length} matched, ${missing.length} missing`, {\n274:     lines,\n275:     entries: missing.map((id) => ({ id, present: false })),\n276:   });\n277: }\n278: \n279: // The byte offset of the first line that is exactly this text, or -1 when the document\n280: // does not carry it.\n281: function firstLineOffset(text, needle) {\n282:   if (text.startsWith(needle)) return 0;\n283:   const at = text.indexOf(`\\n${needle}`);\n284:   return at === -1 ? -1 : at + 1;\n285: }\n286: \n287: // The shipped numbering, read from the pin that names it. Hundreds of files cite these\n288: // numbers, and the document carries its fourth section before its third, so the citation\n289: // order is not the reading order and only the pin carries the expected one.\n290: function numberingReport(context, manifest) {\n291:   if (!context.exists) return { state: INFO, detail: 'no root document to number', lines: [] };\n292: \n293:   const pin = (manifest.pins || []).find((entry) => entry.kind === 'order');\n294:   if (!pin) return { state: INFO, detail: 'the manifest declares no numbering pin', lines: [] };\n295: \n296:   const found = [];\n297:   const absent = [];\n298:   for (const text of pin.texts) {\n299:     const at = firstLineOffset(context.text, text);\n300:     if (at === -1) absent.push(text.trim());\n301:     else found.push({ text: text.trim(), at });\n302:   }\n303:   const expected = pin.texts.map((text) => text.trim()).filter((text) => found.some((entry) => entry.text === text));\n304:   const actual = found.slice().sort((left, right) => left.at - right.at).map((entry) => entry.text);\n305: \n306:   const lines = absent.map((text) => `missing section number ${JSON.stringify(text)}`);\n307:   if (expected.join('|') !== actual.join('|')) {\n308:     lines.push(`the numbers appear as ${actual.join(', ')} instead of ${expected.join(', ')}`);\n309:   }\n310:   return { state: lines.length === 0 ? PASS : FINDING, detail: `${found.length}/${pin.texts.length} section numbers in place`, lines };\n311: }\n312: \n313: // A3. Shipped sections in manifest order, and section numbers unchanged.\n314: function rowOrderAndNumbering(context, manifest) {\n315:   const order = manifest.sections.map((entry) => entry.id);\n316:   const seen = context.matched.map((entry) => entry.entry.id);\n317:   const expected = order.filter((id) => seen.includes(id));\n318:   const numbering = numberingReport(context, manifest);\n319: \n320:   const lines = [...numbering.lines];\n321:   if (expected.join('|') !== seen.join('|')) {\n322:     const first = seen.findIndex((id, index) => id !== expected[index]);\n323:     lines.unshift(`section order differs at position ${first + 1}: found ${seen[first]}, expected ${expected[first]}`);\n324:   }\n325:   const state = lines.length === 0 ? PASS : FINDING;\n326:   return row('A3', 'order and numbering', state, state === PASS ? 'manifest order and section numbers unchanged' : 'order or numbering drifted', { lines });\n327: }\n328: \n329: // A4. Per section, whether the body is the shipped one, an older release, a local edit\n330: // or something with no base to name.\n331: function rowCurrency(context) {\n332:   const counts = { current: 0, 'stale-known': 0, edited: 0, 'unknown-base': 0 };\n333:   const entries = [];\n334:   for (const entry of context.currency) {\n335:     counts[entry.state] += 1;\n336:     entries.push({ id: entry.id, state: entry.state, base: entry.base || null });\n337:   }\n338:   // Nothing to classify is not a clean bill: the rows around this one report the empty or\n339:   // foreign document, and a pass here would read as currency that was checked.\n340:   if (entries.length === 0) {\n341:     return row('A4', 'section currency', INFO, 'no shipped section matched, so there is no body to classify');\n342:   }\n343:   const detail = `${counts.current} current, ${counts['stale-known']} stale-known, ${counts.edited} edited, ${counts['unknown-base']} unknown-base`;\n344:   const lines = [];\n345:   for (const entry of context.currency) {\n346:     if (entry.state === 'current') continue;\n347:     const base = entry.base ? entry.base.slice(0, 12) : 'none';\n348:     lines.push(`${entry.id}: ${entry.state} (closest known body ${base})`);\n349:   }\n350:   return row('A4', 'section currency', lines.length === 0 ? PASS : FINDING, detail, { lines, entries });\n351: }\n352: \n353: // A5. Every string downstream tooling greps out of the document, checked by its rule.\n354: function rowPins(context, manifest) {\n355:   const entries = [];\n356:   const byId = new Map(context.matched.map((entry) => [entry.entry.id, entry.section]));\n357: \n358:   for (const pin of manifest.pins || []) {\n359:     const verdict = pinVerdict(pin, context, manifest, byId);\n360:     entries.push({ id: pin.id, kind: pin.kind, state: verdict.state, detail: verdict.detail });\n361:   }\n362: \n363:   const failed = entries.filter((entry) => entry.state === FINDING);\n364:   const unmeasured = entries.filter((entry) => entry.state === UNKNOWN);\n365:   const lines = failed.map((entry) => `${entry.id} (${entry.kind}): ${entry.detail}`);\n366:   for (const entry of unmeasured) lines.push(`${entry.id} (${entry.kind}): ${entry.detail}`);\n367:   const state = failed.length > 0 ? FINDING : (unmeasured.length > 0 ? UNKNOWN : PASS);\n368:   const detail = `${entries.length - failed.length - unmeasured.length}/${entries.length} pins hold${unmeasured.length > 0 ? `, ${unmeasured.length} unmeasured` : ''}`;\n369:   return row('A5', 'pins', state, detail, { lines, entries });\n370: }\n371: \n372: function pinVerdict(pin, context, manifest, byId) {\n373:   const section = pin.section ? byId.get(pin.section) : null;\n374:   if (pin.section && !section) {\n375:     return { state: FINDING, detail: `the section ${pin.section} that carries this pin is missing` };\n376:   }\n377: \n378:   switch (pin.kind) {\n379:     case 'exact': {\n380:       const missing = pin.texts.filter((text) => !section.body.includes(text));\n381:       return missing.length === 0\n382:         ? { state: PASS, detail: `all ${pin.texts.length} strings present in ${pin.section}` }\n383:         : { state: FINDING, detail: `missing ${JSON.stringify(missing[0])} in ${pin.section}` };\n384:     }\n385:     case 'line': {\n386:       const required = (pin.requires || pin.texts).map((text) => text.toLowerCase());\n387:       const hit = section.body.split('\\n').some((line) => {\n388:         const lower = line.toLowerCase();\n389:         return required.every((text) => lower.includes(text));\n390:       });\n391:       return hit\n392:         ? { state: PASS, detail: `a line in ${pin.section} carries ${required.join(', ')}` }\n393:         : { state: FINDING, detail: `no line in ${pin.section} carries ${required.join(', ')}` };\n394:     }\n395:     case 'first-occurrence': {\n396:       const at = context.text.indexOf(pin.texts[0]);\n397:       const inside = at >= section.start && at < section.end;\n398:       if (inside) return { state: PASS, detail: `the first occurrence sits inside ${pin.section}` };\n399:       return {\n400:         state: FINDING,\n401:         detail: at === -1\n402:           ? `the text ${JSON.stringify(pin.texts[0])} is absent`\n403:           : `the first occurrence at byte ${at} sits outside ${pin.section} (${section.start}..${section.end}), so anything reading the first line of the document follows it instead`,\n404:       };\n405:     }\n406:     case 'delivery-anchor': {\n407:       const end = deliveryAnchorEnd(section, pin);\n408:       if (end === null) return { state: FINDING, detail: `the anchor text is absent from ${pin.section}` };\n409:       const limit = manifest.budget.prefix_bytes;\n410:       return end <= limit\n411:         ? { state: PASS, detail: `${pin.section} ends at byte ${end}, inside ${limit}` }\n412:         : { state: FINDING, detail: `${pin.section} ends at byte ${end}, past the ${limit}-byte delivery prefix` };\n413:     }\n414:     case 'budget': {\n415:       const declared = manifest.budget[pin.limit_key];\n416:       const pinned = Number(pin.texts[0]);\n417:       return declared === pinned\n418:         ? { state: PASS, detail: `${pin.limit_key} is ${declared}` }\n419:         : { state: FINDING, detail: `${pin.limit_key} reads ${declared}, the pin says ${pinned}` };\n420:     }\n421:     case 'order': {\n422:       const numbering = numberingReport(context, manifest);\n423:       return { state: numbering.state, detail: numbering.detail };\n424:     }\n425:     case 'file': {\n426:       const target = path.join(context.root, pin.path);\n427:       return fs.existsSync(target)\n428:         ? { state: PASS, detail: `${pin.path} exists` }\n429:         : { state: FINDING, detail: `${pin.path} is missing` };\n430:     }\n431:     default:\n432:       // A kind the engine has no rule for is a pin nobody measured. Counting it as a hold\n433:       // would report a manifest edit as verified.\n434:       return { state: UNKNOWN, detail: `no rule for a pin of kind ${pin.kind}` };\n435:   }\n436: }\n437: \n438: // A6. The delivery budget: the canary's own AGENTS.md lines, plus the two measurements\n439: // the report needs. Only this row's file is kept, because the canary also pins the skill\n440: // it ships in and a consumer legitimately has none of those.\n441: function rowBudget(context, manifest, tools) {\n442:   if (typeof tools.canary !== 'string' || !fs.existsSync(tools.canary)) {\n443:     return row('A6', 'delivery budget', UNKNOWN,\n444:       `the rule-copy canary is not installed at ${tools.canary || '(no path)'}; the budget cannot be measured`);\n445:   }\n446: \n447:   const run = spawnSync(process.execPath, [tools.canary, '--root', context.root], {\n448:     encoding: 'utf8',\n449:     timeout: TOOL_TIMEOUT_MS,\n450:     maxBuffer: 16 * 1024 * 1024,\n451:   });\n452:   const output = `${run.stdout || ''}\\n${run.stderr || ''}`.split('\\n').map((line) => line.trim()).filter((line) => line !== '');\n453:   if (run.error || (run.status !== 0 && run.status !== 1)) {\n454:     return row('A6', 'delivery budget', UNKNOWN,\n455:       `the rule-copy canary could not run: ${run.error ? run.error.message : `exit ${run.status}`}`);\n456:   }\n457: \n458:   // The canary prints its verdict, an anchor table and its findings. Only the findings\n459:   // that name this document belong to this row; its PASS and table lines are its own\n460:   // report, and the anchor end byte is measured below instead of parsed back out.\n461:   const own = output\n462:     .filter((line) => line.includes(manifest.root_file))\n463:     .filter((line) => /^(MISSING|BLOCKED):/u.test(line));\n464:   const elsewhere = output.filter((line) => !line.includes(manifest.root_file));\n465: \n466:   const limit = manifest.budget.prefix_bytes;\n467:   const ceiling = manifest.budget.max_bytes;\n468:   const prefixEnd = (manifest.pins || [])\n469:     .filter((pin) => pin.kind === 'delivery-anchor')\n470:     .reduce((max, pin) => {\n471:       const section = context.matched.find((entry) => entry.entry.id === pin.section);\n472:       if (!section) return max;\n473:       const end = deliveryAnchorEnd(section.section, pin);\n474:       return end === null ? max : Math.max(max, end);\n475:     }, 0);\n476: \n477:   const failures = [...own];\n478:   // The canary already names whatever it measured, so this row adds a figure only for a\n479:   // defect the canary did not report, instead of printing the same ceiling twice.\n480:   if (prefixEnd > limit && !own.some((line) => line.includes('delivery prefix'))) {\n481:     failures.push(`the last anchor ends at byte ${prefixEnd}, past the ${limit}-byte delivery prefix`);\n482:   }\n483:   if (context.totalBytes > ceiling && !own.some((line) => line.includes('ceiling'))) {\n484:     failures.push(`${context.totalBytes} bytes exceeds the ${ceiling}-byte ceiling`);\n485:   }\n486:   // A failing canary that names other files only is still a fact worth stating, because\n487:   // its exit status would otherwise read as this row's verdict. A passing one needs no\n488:   // note: its remaining lines are its own anchor table.\n489:   const notes = failures.length === 0 && run.status !== 0 && elsewhere.length > 0\n490:     ? [`the canary exits ${run.status} over ${elsewhere.length} line(s) outside ${manifest.root_file}, which belong to other files' pins`]\n491:     : [];\n492: \n493:   return row('A6', 'delivery budget', failures.length === 0 ? PASS : FINDING,\n494:     `${prefixEnd} of ${limit} bytes to the last anchor, ${context.totalBytes} of ${ceiling} bytes total`,\n495:     { lines: [...failures, ...notes] });\n496: }\n497: \n498: // A7. The repository block: one start marker line, one end marker line, in that order,\n499: // after every shipped section, small enough to leave headroom. A marker is the whole line,\n500: // so the same bytes quoted inside a sentence are prose and do not make a second block.\n501: function rowBlock(context, manifest) {\n502:   const { budget } = manifest;\n503:   const block = context.block;\n504:   const starts = block === null ? 0 : block.markerLines.start.length;\n505:   const ends = block === null ? 0 : block.markerLines.end.length;\n506: \n507:   if (starts === 0 && ends === 0) {\n508:     return row('A7', 'repo-local block', PASS, `no block; ${context.totalBytes} of ${budget.max_bytes} bytes used`);\n509:   }\n510:   if (starts !== 1 || ends !== 1) {\n511:     const lines = ['the block cannot be placed, so nothing inside it can be carried'];\n512:     const where = [];\n513:     if (block !== null && starts > 0) where.push(`the start marker sits on line ${block.markerLines.start.join(' and line ')}`);\n514:     if (block !== null && ends > 0) where.push(`the end marker on line ${block.markerLines.end.join(' and line ')}`);\n515:     if (where.length > 0) lines.push(where.join(', '));\n516:     return row('A7', 'repo-local block', FINDING,\n517:       `expected one start and one end marker line, found ${starts} and ${ends}`, { lines });\n518:   }\n519: \n520:   const lines = [];\n521:   if (!block || !block.complete) {\n522:     lines.push('the end marker sits before the start marker, so the block is out of order and unreadable');\n523:   }\n524:   // Whatever the document carries below the block is content a replacement has to place\n525:   // around the block, so a block above it cannot be the one block a rewrite writes last.\n526:   const following = block === null ? [] : context.sections.filter((section) => section.start > block.start);\n527:   if (block && block.complete && following.length > 0) {\n528:     lines.push(`the block starts at byte ${block.start}, before ${following.length} section(s) that follow it (the first is ${JSON.stringify(following[0].heading)} at byte ${following[0].start})`);\n529:   }\n530:   if (block && block.complete && block.start < budget.prefix_bytes) {\n531:     lines.push(`the block starts at byte ${block.start}, inside the ${budget.prefix_bytes}-byte delivery prefix`);\n532:   }\n533:   if (context.totalBytes > budget.max_bytes) {\n534:     lines.push(`${context.totalBytes} bytes exceeds the ${budget.max_bytes}-byte ceiling`);\n535:   }\n536: \n537:   const size = block && block.complete ? Buffer.byteLength(block.content, 'utf8') : 0;\n538:   const headroom = budget.max_bytes - context.totalBytes;\n539:   const detail = block && block.complete\n540:     ? `block ${size} bytes, ${headroom} bytes of headroom`\n541:     : `block unreadable, ${headroom} bytes of headroom`;\n542:   return row('A7', 'repo-local block', lines.length === 0 ? PASS : FINDING, detail,\n543:     { lines, entries: [{ size, headroom, complete: Boolean(block && block.complete) }] });\n544: }\n545: \n546: // A8. Repository content outside the block that matches no shipped section. This is the\n547: // content a replacement would drop, so it is reported by line and byte range. The text\n548: // above the first heading has no heading to match, and arrives here with a null one.\n549: function rowUnmarked(context, manifest) {\n550:   const prefixBytes = manifest.budget.prefix_bytes;\n551:   const entries = context.unregistered.map((entry) => ({\n552:     heading: entry.heading,\n553:     line_start: lineNumberAt(context.text, entry.start),\n554:     line_end: lineNumberAt(context.text, Math.max(entry.start, entry.end - 1)),\n555:     byte_start: entry.start,\n556:     byte_end: entry.end,\n557:     in_prefix: entry.start < prefixBytes,\n558:   }));\n559:   if (entries.length === 0) return row('A8', 'unmarked repo-unique content', PASS, 'no section outside the block');\n560: \n561:   const headings = entries.filter((entry) => entry.heading !== null).length;\n562:   const detail = [];\n563:   if (headings > 0) detail.push(`${headings} section(s) outside the block match no shipped section`);\n564:   if (entries.length > headings) detail.push('the text above the first heading is repository content no section carries');\n565: \n566:   return row('A8', 'unmarked repo-unique content', FINDING,\n567:     detail.join('; '),\n568:     {\n569:       lines: entries.map((entry) => `${entry.heading === null ? 'text before the first heading' : JSON.stringify(entry.heading)}: lines ${entry.line_start}-${entry.line_end}, bytes ${entry.byte_start}-${entry.byte_end}${entry.in_prefix ? ', inside the delivery prefix' : ''}`),\n570:       entries,\n571:     });\n572: }\n573: \n574: // The line where two bodies first part company, with the two raw lines. A body can carry\n575: // every line the shipped body carries and still not be it — an extra space on an indent, a\n576: // line written twice, two lines swapped — and the operator needs the line to look at\n577: // rather than a finding with nothing under it.\n578: function bodyDifference(actual, expected) {\n579:   const left = String(actual).split('\\n');\n580:   const right = String(expected).split('\\n');\n581:   const last = Math.max(left.length, right.length);\n582:   for (let index = 0; index < last; index += 1) {\n583:     if (left[index] === right[index]) continue;\n584:     return {\n585:       line: index + 1,\n586:       actual: left[index] === undefined ? null : left[index],\n587:       shipped: right[index] === undefined ? null : right[index],\n588:     };\n589:   }\n590:   return null;\n591: }\n592: \n593: // A9. For a section that is not the shipped body, the lines the shipped body does not\n594: // carry, once per occurrence. A body that carries every shipped line can still differ, so\n595: // the row names that difference by line instead of reporting a finding with no line under\n596: // it: a finding nobody can act on reads like a bug in the checker.\n597: function rowUnmarkedEdits(context, manifest) {\n598:   const entries = [];\n599:   for (const entry of context.currency) {\n600:     if (entry.state !== 'edited' && entry.state !== 'unknown-base') continue;\n601:     const shipped = manifest.derived.sections[entry.id];\n602:     const body = shipped ? shipped.body : '';\n603:     const lines = localLinesOf(entry.section.body, body);\n604:     entries.push({\n605:       id: entry.id,\n606:       state: entry.state,\n607:       lines,\n608:       difference: lines.length === 0 ? bodyDifference(entry.section.body, body) : null,\n609:     });\n610:   }\n611:   if (entries.length === 0) return row('A9', 'unmarked local edits', PASS, 'no edited section');\n612: \n613:   const total = entries.reduce((sum, entry) => sum + entry.lines.length, 0);\n614:   const formatting = entries.filter((entry) => entry.lines.length === 0).length;\n615:   const detail = [`${entries.length} section(s) carry ${total} local line(s)`];\n616:   if (formatting > 0) detail.push(`${formatting} of them differ only in whitespace, order or a repeat`);\n617: \n618:   const lines = [];\n619:   for (const entry of entries) {\n620:     for (const line of entry.lines) lines.push(`${entry.id}: ${line}`);\n621:     if (entry.difference === null) continue;\n622:     lines.push(`${entry.id}: only whitespace, order or a repeat differs from the shipped body, at line ${entry.difference.line}: shipped ${JSON.stringify(entry.difference.shipped)}, the document carries ${JSON.stringify(entry.difference.actual)}`);\n623:   }\n624:   return row('A9', 'unmarked local edits', lines.length === 0 ? INFO : FINDING,\n625:     detail.join('; '), { lines, entries });\n626: }\n627: \n628: // A10. The copies each runtime loads. Claude Code reaches the root document only through\n629: // CLAUDE.md, so a missing pointer leaves Claude without it and a full copy double-loads\n630: // and drifts. The Cursor rule is generated and alone carries the gate 1 lookup to Cursor\n631: // and Devin, so it is checked by its own generator.\n632: function rowRuntimeCopies(context, manifest, tools) {\n633:   const entries = [];\n634:   const lines = [];\n635: \n636:   for (const expected of manifest.runtime_copies || []) {\n637:     const verdict = copyVerdict(expected, context, manifest, tools);\n638:     entries.push({ path: expected.path, kind: verdict.kind, state: verdict.state, detail: verdict.detail, lines: verdict.lines || [] });\n639:     // A copy nobody could measure is printed like a finding: a pass line with no detail\n640:     // reads as a copy that was checked and found right.\n641:     if (verdict.state === FINDING || verdict.state === UNKNOWN || verdict.kind === 'pointer missing') {\n642:       lines.push(`${expected.path}: ${verdict.kind} - ${verdict.detail}`);\n643:     }\n644:   }\n645: \n646:   const failed = entries.filter((entry) => entry.state === FINDING);\n647:   const unmeasured = entries.filter((entry) => entry.state === UNKNOWN);\n648:   // A missing pointer is a route the runtime does not have, not a copy that was checked.\n649:   const pointerMissing = entries.filter((entry) => entry.kind === 'pointer missing');\n650:   const expected = entries.length - failed.length - unmeasured.length - pointerMissing.length;\n651:   const state = failed.length > 0 ? FINDING : (unmeasured.length > 0 ? UNKNOWN : PASS);\n652:   const detail = `${expected}/${entries.length} copies as expected${unmeasured.length > 0 ? `, ${unmeasured.length} unmeasured` : ''}${pointerMissing.length > 0 ? `, ${pointerMissing.length} pointer missing` : ''}`;\n653:   return row('A10', 'runtime copies', state, detail, { lines, entries });\n654: }\n655: \n656: function copyVerdict(expected, context, manifest, tools) {\n657:   if (expected.report_only) {\n658:     return { state: INFO, kind: 'reported only', detail: 'outside the checklist this command rewrites' };\n659:   }\n660:   if (expected.path.startsWith('~')) {\n661:     return { state: INFO, kind: 'outside the repository', detail: 'reported, never read' };\n662:   }\n663: \n664:   const target = path.join(context.root, expected.path);\n665:   if (expected.path.endsWith('.md') && expected.expect.includes('gate1-block-in-sync')) {\n666:     if (typeof tools.pointerSync !== 'string' || !fs.existsSync(tools.pointerSync)) {\n667:       return { state: UNKNOWN, kind: 'gate1 block unmeasured', detail: `the pointer sync is not installed at ${tools.pointerSync || '(no path)'}` };\n668:     }\n669:     const run = spawnSync(process.execPath, [tools.pointerSync, '--check', '--root', context.root], {\n670:       encoding: 'utf8',\n671:       timeout: TOOL_TIMEOUT_MS,\n672:     });\n673:     const output = `${run.stdout || ''}\\n${run.stderr || ''}`.split('\\n').map((line) => line.trim()).filter((line) => line !== '');\n674:     if (run.status === 0) return { state: PASS, kind: 'gate1 block in sync', detail: 'the generator reports no drift' };\n675:     if (run.status === 1) return { state: FINDING, kind: 'gate1 block out of sync', detail: output.join('; ') };\n676:     return { state: UNKNOWN, kind: 'gate1 block unmeasured', detail: output.join('; ') || `the pointer sync exited ${run.status}` };\n677:   }\n678: \n679:   const exists = fs.existsSync(target) || isSymlink(target);\n680:   const expectsAbsent = expected.expect.length === 1 && expected.expect[0] === 'absent';\n681: \n682:   if (expected.path === '.cursor/rules/repo-local.md') {\n683:     if (context.blockContent) {\n684:       if (!exists) return { state: FINDING, kind: 'mirror missing', detail: 'the block carries content and nothing mirrors it' };\n685:       const mirror = fs.readFileSync(target, 'utf8');\n686:       const missing = [...trimmedLines(context.block.content)].filter((line) => !mirror.includes(line));\n687:       return missing.length === 0\n688:         ? { state: PASS, kind: 'mirror current', detail: 'the mirror carries the block' }\n689:         : { state: FINDING, kind: 'mirror behind', detail: `${missing.length} block line(s) are not in the mirror` };\n690:     }\n691:     return exists\n692:       ? { state: FINDING, kind: 'mirror of an empty block', detail: 'the block is empty and a mirror exists' }\n693:       : { state: PASS, kind: 'absent', detail: 'no block content to mirror' };\n694:   }\n695: \n696:   // Claude Code reaches the root document only through this file, so its absence is a route\n697:   // the runtime does not have rather than a copy that is wrong.\n698:   if (expected.path === 'CLAUDE.md' && !exists && context.exists) {\n699:     return {\n700:       state: INFO,\n701:       kind: 'pointer missing',\n702:       detail: 'Claude Code reads only CLAUDE.md, so without a one-line @' + manifest.root_file + ' pointer it never loads ' + manifest.root_file,\n703:     };\n704:   }\n705: \n706:   if (!exists) {\n707:     return expectsAbsent\n708:       ? { state: PASS, kind: 'absent', detail: 'nothing to load twice' }\n709:       : { state: PASS, kind: 'absent', detail: 'absent, which the checklist allows' };\n710:   }\n711: \n712:   if (isSymlink(target)) {\n713:     const link = fs.readlinkSync(target);\n714:     // A path the checklist expects to be absent is one no runtime should load, and a link\n715:     // there loads the root document under that name just as a copy would.\n716:     if (expectsAbsent) {\n717:       return { state: FINDING, kind: 'symlink where none belongs', detail: `links to ${link}, where the checklist expects no file` };\n718:     }\n719:     const pointsAtRoot = path.basename(link) === manifest.root_file;\n720:     if (pointsAtRoot) return { state: PASS, kind: 'symlink', detail: `links to ${link}` };\n721:     return { state: FINDING, kind: 'symlink elsewhere', detail: `links to ${link} instead of ${manifest.root_file}` };\n722:   }\n723: \n724:   const content = fs.readFileSync(target, 'utf8');\n725:   if (!context.exists) {\n726:     return { state: FINDING, kind: 'sole instruction file', detail: `there is no ${manifest.root_file} for it to point at` };\n727:   }\n728:   if (content === context.text) {\n729:     return { state: FINDING, kind: 'identical copy', detail: `byte-identical to ${manifest.root_file}, so the two will drift` };\n730:   }\n731: \n732:   const unique = localLinesOf(content, context.text);\n733:   const rootLines = trimmedLines(context.text);\n734:   const sharesShippedLine = [...trimmedLines(content)].some((line) => rootLines.has(line));\n735:   const namesRoot = [...trimmedLines(content)].some((line) => line.includes(manifest.root_file));\n736:   // A pointer is a file that carries no shipped line and names the root document. Anything\n737:   // else is either a copy or a copy plus local lines, and both drift: the second also\n738:   // loses text when it is replaced, so the lines only it carries are listed.\n739:   if (!sharesShippedLine && namesRoot) {\n740:     return { state: PASS, kind: 'pointer', detail: `names ${manifest.root_file} and carries no shipped line` };\n741:   }\n742:   return { state: FINDING, kind: 'divergent copy', detail: `${unique.length} line(s) only this file carries`, lines: unique };\n743: }\n744: \n745: function isSymlink(target) {\n746:   try {\n747:     return fs.lstatSync(target).isSymbolicLink();\n748:   } catch {\n749:     return false;\n750:   }\n751: }\n752: \n753: // A11. The router: present, carrying the rows the template ships, and passing its own\n754: // checker. The checker's summary line is carried through, never rebuilt.\n755: function rowRouter(context, manifest, tools) {\n756:   const routerPath = path.join(context.root, manifest.router_file);\n757:   if (!fs.existsSync(routerPath)) {\n758:     return row('A11', 'REPO RULES.md', FINDING, 'absent',\n759:       { lines: [`no ${manifest.router_file}: no repository rule can load`], entries: [{ path: manifest.router_file, present: false }] });\n760:   }\n761: \n762:   const text = fs.readFileSync(routerPath, 'utf8');\n763:   const shipped = (manifest.derived && manifest.derived.repo_rules) || { trigger_rows: [], index_rows: [] };\n764:   const lines = [];\n765:   const missing = [\n766:     ...missingRows(shipped.trigger_rows, parseTableRows(text, 'TRIGGER TABLE'), 'trigger'),\n767:     ...missingRows(shipped.index_rows, parseTableRows(text, 'INDEX'), 'index'),\n768:   ];\n769:   for (const entry of missing) lines.push(`missing ${entry.kind} row for ${entry.rule}`);\n770: \n771:   if (typeof tools.repoRules !== 'string' || !fs.existsSync(tools.repoRules)) {\n772:     return row('A11', 'REPO RULES.md', UNKNOWN, 'present; the repo-rules checker is not installed',\n773:       { lines: [...lines, `the checker is not installed at ${tools.repoRules || '(no path)'}`] });\n774:   }\n775: \n776:   const run = spawnSync(process.execPath, [tools.repoRules, '--root', context.root], {\n777:     encoding: 'utf8',\n778:     timeout: TOOL_TIMEOUT_MS,\n779:   });\n780:   const output = `${run.stdout || ''}\\n${run.stderr || ''}`.split('\\n').map((line) => line.trim()).filter((line) => line !== '');\n781:   const summary = output.find((line) => line.includes(REPO_RULES_TAG) && line.includes('RESULT:'));\n782: \n783:   if (run.status === 2 || !summary) {\n784:     return row('A11', 'REPO RULES.md', UNKNOWN, 'the repo-rules checker could not run',\n785:       { lines: [...lines, ...output.filter((line) => line.includes(REPO_RULES_TAG))] });\n786:   }\n787:   if (run.status !== 0) {\n788:     return row('A11', 'REPO RULES.md', FINDING, `${missing.length} shipped row(s) missing; the checker fails`,\n789:       { lines: [...lines, summary] });\n790:   }\n791:   return row('A11', 'REPO RULES.md', lines.length === 0 ? PASS : FINDING,\n792:     `${missing.length} shipped row(s) missing; ${summary}`, { lines: [...lines, summary] });\n793: }\n794: \n795: // The router's own table, read the same way the manifest's rows were derived. Comparing\n796: // shipped rows to the file is the only way to say which of them a consumer dropped.\n797: function parseTableRows(text, anchor) {\n798:   const lines = text.split('\\n');\n799:   const start = lines.findIndex((line) => line.startsWith('#') && line.includes(anchor));\n800:   if (start === -1) return [];\n801: \n802:   const rows = [];\n803:   let width = 0;\n804:   for (let index = start + 1; index < lines.length; index += 1) {\n805:     const line = lines[index].trim();\n806:     if (line.startsWith('#')) break;\n807:     if (!line.startsWith('|')) {\n808:       if (rows.length > 0 && line === '') break;\n809:       continue;\n810:     }\n811:     const cells = line.replace(/^\\|/u, '').replace(/\\|$/u, '').split('|').map((cell) => cell.trim());\n812:     if (cells.every((cell) => /^:?-+:?$/u.test(cell) || cell === '')) continue;\n813:     if (width === 0) {\n814:       width = cells.length;\n815:       continue;\n816:     }\n817:     if (cells.length !== width) continue;\n818:     rows.push(cells);\n819:   }\n820:   return rows;\n821: }\n822: \n823: function rulePathOf(cells) {\n824:   for (const cell of cells) {\n825:     const linked = /\\(([^)]+\\.md)\\)/u.exec(cell);\n826:     if (linked) return linked[1];\n827:     const bare = /`([^`]+\\.md)`/u.exec(cell);\n828:     if (bare) return bare[1];\n829:   }\n830:   return null;\n831: }\n832: \n833: function missingRows(shipped, present, kind) {\n834:   const found = new Set(present.map((cells) => rulePathOf(cells) || cells.join(' | ')));\n835:   const missing = [];\n836:   for (const cells of shipped) {\n837:     const rule = rulePathOf(cells) || cells.join(' | ');\n838:     if (!found.has(rule)) missing.push({ kind, rule });\n839:   }\n840:   return missing;\n841: }\n842: \n843: // A12. The source repository's own two promises: its block stays empty, and its derived\n844: // copy of the template is fresh. A consumer's block is its own, so this row reports INFO\n845: // there instead of telling it what to do with its own file.\n846: function rowTemplatePurity(context, manifest, tools, options) {\n847:   let source = { isSource: false, reason: `origin was not compared` };\n848:   try {\n849:     source = sourceStatus({ root: context.root, manifest });\n850:   } catch (error) {\n851:     source = { isSource: false, reason: error.message };\n852:   }\n853: \n854:   if (!options.source && !source.isSource) {\n855:     return row('A12', 'template purity', INFO,\n856:       `runs only in the source repository; ${source.reason || 'the origin differs'}`);\n857:   }\n858: \n859:   const lines = [];\n860:   if (context.blockContent) lines.push('the source repository block carries content, and every line here ships to every consumer');\n861:   if (context.block && !context.block.complete) lines.push('the source repository block is not well formed');\n862: \n863:   if (typeof tools.generator !== 'string' || !fs.existsSync(tools.generator)) {\n864:     return row('A12', 'template purity', UNKNOWN,\n865:       `the manifest generator is not installed at ${tools.generator || '(no path)'}`);\n866:   }\n867:   const run = spawnSync(process.execPath, [tools.generator, '--check', '--root', context.root, '--manifest', options.manifest], {\n868:     encoding: 'utf8',\n869:     timeout: TOOL_TIMEOUT_MS,\n870:   });\n871:   const output = `${run.stdout || ''}\\n${run.stderr || ''}`.split('\\n').map((line) => line.trim()).filter((line) => line !== '');\n872:   if (run.status !== 0) lines.push(...output);\n873: \n874:   const state = lines.length === 0 ? PASS : FINDING;\n875:   return row('A12', 'template purity', state,\n876:     state === PASS ? 'block empty and the derived copy is fresh' : 'the source template is not pure', { lines });\n877: }\n878: \n879: // ─────────────────────────────────────────────────────────────────────────────\n880: // 6. REPORT\n881: // ─────────────────────────────────────────────────────────────────────────────\n882: \n883: function defaultTools(manifest) {\n884:   const canaryPin = (manifest.pins || []).find((pin) => String(pin.consumer || '').endsWith('check-rule-copies.js'));\n885:   const pointerPin = (manifest.pins || []).find((pin) => pin.kind === 'first-occurrence');\n886:   return {\n887:     canary: canaryPin ? path.join(REPO_ROOT, canaryPin.consumer) : null,\n888:     pointerSync: pointerPin ? path.join(REPO_ROOT, pointerPin.consumer) : null,\n889:     repoRules: REPO_RULES_CHECKER,\n890:     generator: GENERATOR,\n891:   };\n892: }\n893: \n894: /**\n895:  * Classify one repository.\n896:  *\n897:  * @param {{root?: string, manifestPath?: string, source?: boolean, tools?: Object}} [input]\n898:  * @returns {{root: string, manifest: string, state: string, status: string, exitCode: number,\n899:  *   findings: number, unknown: number, rows: Array<Object>} | null} Null when the root\n900:  *   directory or the manifest is not readable.\n901:  */\n902: function buildReport(input = {}) {\n903:   const root = input.root ? path.resolve(input.root) : REPO_ROOT;\n904:   const manifestPath = input.manifestPath ? path.resolve(input.manifestPath) : MANIFEST_PATH;\n905:   if (!fs.existsSync(manifestPath)) return null;\n906: \n907:   let manifest;\n908:   try {\n909:     manifest = JSON.parse(fs.readFileSync(manifestPath, 'utf8'));\n910:   } catch {\n911:     return null;\n912:   }\n913: \n914:   const context = readTarget({ root, manifest });\n915:   if (context === null) return null;\n916: \n917:   const tools = { ...defaultTools(manifest), ...(input.tools || {}) };\n918:   const rows = [\n919:     rowInstallState(context, manifest),\n920:     rowSectionsPresent(context, manifest),\n921:     rowOrderAndNumbering(context, manifest),\n922:     rowCurrency(context),\n923:     rowPins(context, manifest),\n924:     rowBudget(context, manifest, tools),\n925:     rowBlock(context, manifest),\n926:     rowUnmarked(context, manifest),\n927:     rowUnmarkedEdits(context, manifest),\n928:     rowRuntimeCopies(context, manifest, tools),\n929:     rowRouter(context, manifest, tools),\n930:     rowTemplatePurity(context, manifest, tools, { source: Boolean(input.source), manifest: manifestPath }),\n931:   ];\n932: \n933:   const findings = rows.filter((entry) => entry.state === FINDING).length;\n934:   const unknown = rows.filter((entry) => entry.state === UNKNOWN).length;\n935:   const exitCode = findings > 0 || unknown > 0 ? 1 : 0;\n936:   const status = exitCode === 0 ? 'OK' : (findings > 0 ? 'FINDINGS' : 'UNKNOWN');\n937: \n938:   return {\n939:     root,\n940:     manifest: manifestPath,\n941:     state: rows[0].detail,\n942:     status,\n943:     exitCode,\n944:     findings,\n945:     unknown,\n946:     rows,\n947:   };\n948: }\n949: \n950: // A long row is a list, not a wall: the report keeps every line in the JSON form and\n951: // prints the first few here, so a reader sees the shape before the volume.\n952: const PRINTED_LINES = 20;\n953: \n954: function renderText(report) {\n955:   const lines = [];\n956:   for (const entry of report.rows) {\n957:     lines.push(`${entry.id} ${entry.name}: ${entry.detail}   (${entry.state})`);\n958:     for (const line of entry.lines.slice(0, PRINTED_LINES)) lines.push(`  ${line}`);\n959:     if (entry.lines.length > PRINTED_LINES) {\n960:       lines.push(`  ... ${entry.lines.length - PRINTED_LINES} more line(s), all of them in the JSON report`);\n961:     }\n962:   }\n963:   lines.push(`STATUS=${report.status} rows=${report.rows.length} findings=${report.findings} unknown=${report.unknown}`);\n964:   return `${lines.join('\\n')}\\n`;\n965: }\n966: \n967: function renderJson(report) {\n968:   const shaped = {\n969:     root: report.root,\n970:     manifest: report.manifest,\n971:     state: report.state,\n972:     status: report.status,\n973:     exit_code: report.exitCode,\n974:     findings: report.findings,\n975:     unknown: report.unknown,\n976:     rows: report.rows.map((entry) => ({\n977:       id: entry.id,\n978:       name: entry.name,\n979:       state: entry.state,\n980:       detail: entry.detail,\n981:       lines: entry.lines,\n982:       entries: entry.entries,\n983:     })),\n984:   };\n985:   return `${JSON.stringify(shaped, null, 2)}\\n`;\n986: }\n987: \n988: // ─────────────────────────────────────────────────────────────────────────────\n989: // 7. MAIN\n990: // ─────────────────────────────────────────────────────────────────────────────\n991: \n992: /**\n993:  * @param {string[]} argv\n994:  * @param {{tools?: Object}} [hooks] - test seams for the child tools\n995:  * @returns {number} the process exit code\n996:  */\n997: function main(argv, hooks = {}) {\n998:   const options = parseArgs(argv);\n999:   if (options.help) {\n1000:     console.log(USAGE);\n1001:     return 0;\n1002:   }\n1003: \n1004:   if (!fs.existsSync(options.manifest)) {\n1005:     console.error(`${TAG} ERROR: the manifest is missing at ${options.manifest}`);\n1006:     return 2;\n1007:   }\n1008:   if (!fs.existsSync(options.root) || !fs.statSync(options.root).isDirectory()) {\n1009:     console.error(`${TAG} ERROR: the target root is not a directory: ${options.root}`);\n1010:     return 2;\n1011:   }\n1012:   // The root file's name is the manifest's to declare, so this precondition reads the same\n1013:   // declaration every other read does instead of a name of its own.\n1014:   let rootFile = null;\n1015:   try {\n1016:     rootFile = JSON.parse(fs.readFileSync(options.manifest, 'utf8')).root_file || null;\n1017:   } catch {\n1018:     // An unreadable manifest is refused below, where the run has no report to print.\n1019:     rootFile = null;\n1020:   }\n1021:   const rootPath = rootFile === null ? null : path.join(options.root, rootFile);\n1022:   if (rootPath !== null && fs.existsSync(rootPath)) {\n1023:     try {\n1024:       fs.readFileSync(rootPath, 'utf8');\n1025:     } catch (error) {\n1026:       console.error(`${TAG} ERROR: cannot read ${rootPath}: ${error.message}`);\n1027:       return 2;\n1028:     }\n1029:   }\n1030: \n1031:   const report = buildReport({\n1032:     root: options.root,\n1033:     manifestPath: options.manifest,\n1034:     source: options.source,\n1035:     tools: hooks.tools || {},\n1036:   });\n1037:   if (report === null) {\n1038:     // A manifest that cannot be parsed leaves nothing to compare against, and an empty\n1039:     // report would read like a clean one.\n1040:     console.error(`${TAG} ERROR: cannot classify ${options.root}: the manifest at ${options.manifest} could not be read as JSON`);\n1041:     return 2;\n1042:   }\n1043: \n1044:   process.stdout.write(options.json ? renderJson(report) : renderText(report));\n1045:   return report.exitCode;\n1046: }\n1047: \n1048: if (require.main === module) {\n1049:   try {\n[Output truncated. Continue reading with offset: 1050]"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/commands/doctor/scripts/agents-md-check.cjs\"}"},"time":{"start":1794559358726,"end":1794559359465}}}}
{"type":"tool_use","timestamp":1794559359469,"sessionID":"ses_e2bed8c89ffeaoDJMekw21nJMc","part":{"partID":"prt_1d412b8ec001EMgvMmb8PctLbQ","sessionID":"ses_e2bed8c89ffeaoDJMekw21nJMc","messageID":"msg_1d412a8f0001cfwR2WmSIX57tw","type":"tool","id":"call_d24722b92634405cacccf4cb","tool":"read","state":{"status":"completed","input":{"path":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/commands/doctor/scripts/tests/agents-md-check.test.cjs"},"output":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/commands/doctor/scripts/tests/agents-md-check.test.cjs, lines 1-705\n1: #!/usr/bin/env node\n2: // ───────────────────────────────────────────────────────────────────\n3: // MODULE: Shipped Instruction Check Engine Tests\n4: // ───────────────────────────────────────────────────────────────────\n5: 'use strict';\n6: \n7: // The check engine answers one question per repository: what do we hold against what\n8: // was shipped, and what would be lost by replacing it. Its whole value is that the\n9: // answer is trustworthy in a repository nobody inspected, so this suite proves each\n10: // answer on a synthetic repository carrying exactly one shape of drift, and proves the\n11: // run itself leaves the tree untouched.\n12: //\n13: // Each synthetic repository is composed from the manifest's derived bodies into a\n14: // throwaway directory, never committed and never read twice. A fixture folder therefore\n15: // holds a recipe and no document: the tree is a statement about the template that ships\n16: // today rather than a snapshot of it at the time the recipe was written, and a fixture\n17: // cannot describe a template the manifest does not ship. Refreshing a released body in\n18: // the manifest refreshes every fixture in the same edit, and no copy of the template\n19: // sits in the tree for a link checker or a runtime to pick up.\n20: \n21: // ─────────────────────────────────────────────────────────────────────────────\n22: // 1. IMPORTS AND PATHS\n23: // ─────────────────────────────────────────────────────────────────────────────\n24: \n25: const assert = require('node:assert/strict');\n26: const { spawnSync } = require('node:child_process');\n27: const crypto = require('node:crypto');\n28: const fs = require('node:fs');\n29: const os = require('node:os');\n30: const path = require('node:path');\n31: const test = require('node:test');\n32: \n33: const { buildReport, main, renderText } = require('../agents-md-check.cjs');\n34: const { segment } = require('../lib/agents-md-sections.cjs');\n35: const {\n36:   FIXTURES,\n37:   MANIFEST_PATH,\n38:   REPO_ROOT,\n39:   SCRIPTS_DIR,\n40:   composeFixture,\n41:   fixtureNames,\n42:   loadRecipe,\n43:   moveBlockBefore,\n44: } = require('./fixtures/agents-md/compose-fixture.cjs');\n45: \n46: const ENGINE = path.join(SCRIPTS_DIR, 'agents-md-check.cjs');\n47: // The composer writes the Gate 1 mirror only, so a case that reads a whole runtime-copy row\n48: // finishes the mirrors with the generator that owns them, as a repository that ran its own\n49: // generators would.\n50: const POINTER_SYNC = path.join(\n51:   REPO_ROOT,\n52:   '.skilled/skills/system-spec-kit/runtime/cli/runtime-mirrors/sync-gate1-pointers.cjs',\n53: );\n54: \n55: const manifest = JSON.parse(fs.readFileSync(MANIFEST_PATH, 'utf8'));\n56: \n57: // The rows every report carries, in the order the engine prints them.\n58: const ROWS = ['A1', 'A2', 'A3', 'A4', 'A5', 'A6', 'A7', 'A8', 'A9', 'A10', 'A11', 'A12'];\n59: \n60: // ─────────────────────────────────────────────────────────────────────────────\n61: // 2. FIXTURE TREES\n62: // ─────────────────────────────────────────────────────────────────────────────\n63: \n64: // Every engine run happens on a tree composed for it and removed afterwards, so no case\n65: // can read a stale copy of a document, and the tree a case runs against is always the\n66: // template that ships in this repository.\n67: function buildFixture(t, name) {\n68:   const parent = fs.mkdtempSync(path.join(os.tmpdir(), `agents-md-check-${name}-`));\n69:   t.after(() => fs.rmSync(parent, { recursive: true, force: true }));\n70:   const dir = path.join(parent, name);\n71:   composeFixture(name, dir);\n72:   const documentPath = path.join(dir, manifest.root_file);\n73:   return {\n74:     dir,\n75:     recipe: loadRecipe(name),\n76:     document: fs.existsSync(documentPath) ? fs.readFileSync(documentPath, 'utf8') : null,\n77:   };\n78: }\n79: \n80: // ─────────────────────────────────────────────────────────────────────────────\n81: // 3. RUNNERS AND READERS\n82: // ─────────────────────────────────────────────────────────────────────────────\n83: \n84: function runCheck(args) {\n85:   const result = spawnSync(process.execPath, [ENGINE, ...args], { encoding: 'utf8' });\n86:   return { code: result.status, out: result.stdout || '', err: result.stderr || '' };\n87: }\n88: \n89: function runJson(args) {\n90:   const run = runCheck([...args, '--json']);\n91:   let report = null;\n92:   try {\n93:     report = JSON.parse(run.out);\n94:   } catch {\n95:     report = null;\n96:   }\n97:   return { ...run, report };\n98: }\n99: \n100: function rowOf(report, id) {\n101:   const row = report.rows.find((entry) => entry.id === id);\n102:   assert.ok(row, `the report carries row ${id}`);\n103:   return row;\n104: }\n105: \n106: // The text form prints one line per row, ending in the row's verdict, so the two\n107: // renderers can be compared without re-implementing either.\n108: function textRowStates(out) {\n109:   const states = {};\n110:   for (const line of out.split('\\n')) {\n111:     const hit = /^(A\\d+) .*\\((PASS|FINDING|UNKNOWN|INFO)\\)$/.exec(line);\n112:     if (hit) states[hit[1]] = hit[2];\n113:   }\n114:   return states;\n115: }\n116: \n117: function listFiles(dir) {\n118:   const files = [];\n119:   for (const entry of fs.readdirSync(dir, { withFileTypes: true })) {\n120:     const target = path.join(dir, entry.name);\n121:     if (entry.isDirectory()) files.push(...listFiles(target));\n122:     else files.push(target);\n123:   }\n124:   return files;\n125: }\n126: \n127: // A fixture's document is rewritten by a case that needs a shape no recipe describes,\n128: // so the tree a case reads is always the template the manifest ships today.\n129: function rewriteDocument(fixture, text) {\n130:   fs.writeFileSync(path.join(fixture.dir, manifest.root_file), text, 'utf8');\n131: }\n132: \n133: // A throwaway manifest: pin kinds and root file names are the two places a case needs a\n134: // declaration the shipped manifest does not carry.\n135: function writeManifest(t, patch) {\n136:   const dir = fs.mkdtempSync(path.join(os.tmpdir(), 'agents-md-check-manifest-'));\n137:   t.after(() => fs.rmSync(dir, { recursive: true, force: true }));\n138:   const target = path.join(dir, 'agents-md-manifest.json');\n139:   fs.writeFileSync(target, `${JSON.stringify({ ...manifest, ...patch }, null, 2)}\\n`, 'utf8');\n140:   return target;\n141: }\n142: \n143: function treeDigest(dir) {\n144:   const hash = crypto.createHash('sha256');\n145:   for (const file of listFiles(dir).sort()) {\n146:     hash.update(path.relative(dir, file));\n147:     hash.update(fs.readFileSync(file));\n148:   }\n149:   return hash.digest('hex');\n150: }\n151: \n152: // ─────────────────────────────────────────────────────────────────────────────\n153: // 4. THE FIXTURES ARE RECIPES, NOT COPIES\n154: // ─────────────────────────────────────────────────────────────────────────────\n155: \n156: // A composed tree committed beside its recipe would be a second copy of the template,\n157: // and the copy is what the repository would then have to keep: relative links would\n158: // resolve against the fixture folder, a runtime loading nested instruction files would\n159: // read it as somebody's own document, and each template edit would need a regeneration\n160: // commit. This case holds the rule the fixtures are arranged by.\n161: test('every fixture folder holds its recipe and no composed tree', () => {\n162:   const stray = [];\n163:   for (const name of fixtureNames()) {\n164:     for (const entry of fs.readdirSync(path.join(FIXTURES, name), { withFileTypes: true })) {\n165:       if (entry.name !== 'fixture.json' || entry.isDirectory()) stray.push(`${name}/${entry.name}`);\n166:     }\n167:   }\n168:   assert.deepEqual(stray, [],\n169:     'compose a fixture into a temporary folder with the suite\\'s composer instead of committing the tree it describes');\n170: });\n171: \n172: test('composer: the pure fixture rebuilds the shipped document from the manifest', (t) => {\n173:   const fixture = buildFixture(t, 'pure');\n174:   const { sections } = segment(fixture.document, manifest.markers, manifest.sections);\n175: \n176:   assert.equal(sections.length, manifest.sections.length, 'the composed document carries every shipped section');\n177:   for (const section of sections) {\n178:     assert.ok(section.id, `the composed heading ${JSON.stringify(section.heading)} matches a manifest entry`);\n179:     assert.equal(section.sha256, manifest.derived.sections[section.id].sha256,\n180:       `section ${section.id} is byte-identical to the manifest's derived body`);\n181:   }\n182:   const rootDocument = fs.readFileSync(path.join(REPO_ROOT, manifest.root_file), 'utf8');\n183:   assert.ok(rootDocument.startsWith(fixture.document),\n184:     'the composed document is the root document up to its repository block');\n185: });\n186: \n187: test('composer: each fixture declares the install state it plants', () => {\n188:   const names = fixtureNames();\n189:   assert.equal(names.length, 9, 'there are nine fixture recipes');\n190:   for (const name of names) {\n191:     const recipe = loadRecipe(name);\n192:     assert.equal(recipe.name, name, `${name} names itself`);\n193:     assert.ok(recipe.expect_state, `${name} declares its expected install state`);\n194:     assert.ok(recipe.notes, `${name} says what defect it plants`);\n195:   }\n196: });\n197: \n198: // ─────────────────────────────────────────────────────────────────────────────\n199: // 5. A1 INSTALL STATE, ONE FIXTURE PER STATE\n200: // ─────────────────────────────────────────────────────────────────────────────\n201: \n202: for (const name of ['pure', 'adopted', 'stale', 'forked', 'foreign', 'claude-only', 'absent', 'shadowed-pin', 'over-budget']) {\n203:   test(`A1 install state: the ${name} fixture classifies as ${loadRecipe(name).expect_state}`, (t) => {\n204:     const fixture = buildFixture(t, name);\n205:     const run = runJson(['--root', fixture.dir]);\n206: \n207:     assert.ok(run.report, `the engine prints a JSON report for ${name}; stderr: ${run.err}`);\n208:     assert.equal(run.report.state, fixture.recipe.expect_state);\n209:     assert.match(run.out, new RegExp(`\"state\": \"${fixture.recipe.expect_state}\"`));\n210:   });\n211: }\n212: \n213: test('A1 install state: this repository is the source template and classifies as pure', () => {\n214:   const report = buildReport({ root: REPO_ROOT });\n215:   assert.equal(report.state, 'pure', 'the shipped template carries every section current and an empty block');\n216: });\n217: \n218: // ─────────────────────────────────────────────────────────────────────────────\n219: // 6. UNMARKED CONTENT AND UNMARKED EDITS\n220: // ─────────────────────────────────────────────────────────────────────────────\n221: \n222: test('forked: A8 lists the unmarked section with its byte range and A9 lists the local line', (t) => {\n223:   const fixture = buildFixture(t, 'forked');\n224:   const run = runJson(['--root', fixture.dir]);\n225: \n226:   assert.equal(run.code, 1, 'a forked repository is a finding, not a pass');\n227:   assert.equal(rowOf(run.report, 'A1').detail, 'forked');\n228: \n229:   const unmarked = rowOf(run.report, 'A8');\n230:   assert.equal(unmarked.state, 'FINDING');\n231:   const section = unmarked.entries.find((entry) => entry.heading.includes('Local release checklist'));\n232:   assert.ok(section, \"A8 lists the repository's own section by heading\");\n233:   assert.ok(section.byte_start > 0 && section.byte_end > section.byte_start, 'A8 gives the section a byte range');\n234:   assert.equal(section.line_start, fixture.document.split('\\n').indexOf('## Local release checklist') + 1,\n235:     'A8 gives the section a line range that a reader can open');\n236:   assert.equal(section.in_prefix, false, 'the section sits outside the delivery prefix');\n237: \n238:   const edits = rowOf(run.report, 'A9');\n239:   assert.equal(edits.state, 'FINDING');\n240:   const edited = edits.entries.find((entry) => entry.id === 's6-spec-folder');\n241:   assert.ok(edited, 'A9 names the edited section');\n242:   assert.equal(edited.state, 'edited');\n243:   assert.deepEqual(edited.lines, ['Local rule: name the packet in the first line of every pull request.']);\n244: });\n245: \n246: // The same sentence written twice is two lines a replacement would lose, so the row\n247: // counts occurrences: a set would report one line and hide the other.\n248: test('A9 counts a repeated local line once per occurrence', (t) => {\n249:   const fixture = buildFixture(t, 'forked');\n250:   const line = 'Local rule: name the packet in the first line of every pull request.';\n251:   rewriteDocument(fixture, fixture.document.replace(line, `${line}\\n${line}`));\n252: \n253:   const run = runJson(['--root', fixture.dir]);\n254:   const edits = rowOf(run.report, 'A9');\n255:   assert.equal(edits.state, 'FINDING');\n256:   const edited = edits.entries.find((entry) => entry.id === 's6-spec-folder');\n257:   assert.deepEqual(edited.lines, [line, line], 'the repeated line is listed twice');\n258:   assert.match(edits.detail, /1 section\\(s\\) carry 2 local line\\(s\\)/);\n259: });\n260: \n261: // A repository that wrote its block between two shipped sections still carries every\n262: // shipped section, and the block is in the one place the template does not put it. Read\n263: // only above the block, the document looks like somebody else's file and the position is\n264: // never named.\n265: test('a block placed between shipped sections is reported by A7 with its position', (t) => {\n266:   const fixture = buildFixture(t, 'adopted');\n267:   const moved = moveBlockBefore(fixture.document, '#### The Four Laws');\n268:   rewriteDocument(fixture, moved);\n269: \n270:   const run = runJson(['--root', fixture.dir]);\n271:   assert.equal(rowOf(run.report, 'A1').detail, 'adopted', 'every shipped section is still current');\n272:   assert.equal(rowOf(run.report, 'A2').detail, '44/44 matched', 'the sections below the block are shipped ones');\n273:   assert.equal(rowOf(run.report, 'A8').state, 'PASS', 'nothing below the block is unmarked content');\n274: \n275:   const block = rowOf(run.report, 'A7');\n276:   assert.equal(block.state, 'FINDING');\n277:   const position = block.lines.join(' ');\n278:   // Offsets in the report are bytes, and the template carries multi-byte headings above\n279:   // the block, so the character index is not the figure to compare against.\n280:   const blockByte = Buffer.byteLength(moved.slice(0, moved.indexOf(manifest.markers.start)), 'utf8');\n281:   assert.ok(position.includes(`byte ${blockByte}`), `A7 names where the block sits: ${position}`);\n282:   assert.match(position, /The Four Laws/, 'A7 names the shipped section the block sits in front of');\n283: });\n284: \n285: // The end marker is not the end of the file: a line typed below it is the repository's\n286: // own, and a rewrite that keeps only the block would drop it without a word.\n287: test('a line after the block end marker is reported as a local edit', (t) => {\n288:   const fixture = buildFixture(t, 'adopted');\n289:   const line = 'Ship the release note in the same commit as the tag.';\n290:   rewriteDocument(fixture, `${fixture.document}${line}\\n`);\n291: \n292:   const run = runJson(['--root', fixture.dir]);\n293:   assert.equal(rowOf(run.report, 'A1').detail, 'forked');\n294: \n295:   const edits = rowOf(run.report, 'A9');\n296:   assert.equal(edits.state, 'FINDING');\n297:   const carrier = edits.entries.find((entry) => entry.lines.includes(line));\n298:   assert.ok(carrier, `A9 lists the line below the end marker: ${JSON.stringify(edits.entries)}`);\n299: });\n300: \n301: // Text above the first heading belongs to no section, so it is the one piece of\n302: // repository content a heading-shaped comparison cannot see. Left unreported, a document\n303: // carrying it reads as a pure template and a rewrite drops it.\n304: test('text before the first shipped heading is reported as unmarked repository content', (t) => {\n305:   const fixture = buildFixture(t, 'pure');\n306:   const line = 'Read me first.';\n307:   rewriteDocument(fixture, `${line}\\n${fixture.document}`);\n308: \n309:   const run = runJson(['--root', fixture.dir]);\n310:   assert.equal(rowOf(run.report, 'A1').detail, 'forked');\n311: \n312:   const unmarked = rowOf(run.report, 'A8');\n313:   assert.equal(unmarked.state, 'FINDING');\n314:   const prelude = unmarked.entries.find((entry) => entry.heading === null);\n315:   assert.ok(prelude, `A8 names the text above the first heading: ${JSON.stringify(unmarked.entries)}`);\n316:   assert.equal(prelude.byte_start, 0, 'the region starts at the first byte');\n317:   assert.equal(prelude.line_start, 1);\n318:   assert.match(unmarked.lines.join(' '), /before the first heading/);\n319: });\n320: \n321: // A body can carry every line the shipped body carries and still not be it: one extra\n322: // space on an indented bullet is a real difference and a rewrite replaces it. A finding\n323: // with nothing under it names no line to look at, so the row says what the difference is\n324: // and where the two bodies part company.\n325: test('A9 names a body that differs only in whitespace, by line', (t) => {\n326:   const fixture = buildFixture(t, 'pure');\n327:   const shipped = manifest.derived.sections['gate-3'].body;\n328:   const lines = shipped.split('\\n');\n329:   const indented = lines.findIndex((row) => row.startsWith('  '));\n330:   assert.notEqual(indented, -1, 'the shipped body carries an indented line');\n331:   lines[indented] = ` ${lines[indented]}`;\n332:   assert.notEqual(lines[indented], shipped.split('\\n')[indented]);\n333:   rewriteDocument(fixture, fixture.document.replace(shipped, lines.join('\\n')));\n334: \n335:   const run = runJson(['--root', fixture.dir]);\n336:   assert.equal(rowOf(run.report, 'A4').entries.find((entry) => entry.id === 'gate-3').state, 'edited', 'the body is not the shipped one');\n337: \n338:   const edits = rowOf(run.report, 'A9');\n339:   assert.equal(edits.state, 'FINDING', 'the section is not the shipped one, so the row reports it');\n340:   assert.ok(edits.lines.length > 0, 'a finding names at least one line to act on');\n341:   assert.match(edits.lines[0], /gate-3/u, 'the line names the section');\n342:   assert.match(edits.lines[0], new RegExp(`line ${indented + 1}\\\\b`, 'u'), 'and the line of the body where the two differ');\n343:   assert.match(edits.lines[0], /whitespace/u, 'and says the difference is whitespace');\n344: \n345:   const text = runCheck(['--root', fixture.dir]);\n346:   assert.match(text.out, /A9 unmarked local edits: .*\\(FINDING\\)/u);\n347:   assert.match(text.out, /gate-3: only whitespace/u, 'the text form prints the same line');\n348: });\n349: \n350: // A marker is the whole line, so a sentence that quotes both markers is prose. Counting\n351: // the bytes instead would report a document with no block as carrying two of them, which\n352: // is a finding about a file nobody can fix.\n353: test('A7 counts marker lines, not the marker text quoted inside a sentence', (t) => {\n354:   const fixture = buildFixture(t, 'pure');\n355:   const sentence = 'The block is fenced by `<!-- skilled:repo-local:start -->` and `<!-- skilled:repo-local:end -->` in this framework.';\n356:   rewriteDocument(fixture, `${fixture.document}${sentence}\\n`);\n357: \n358:   const run = runJson(['--root', fixture.dir]);\n359:   const block = rowOf(run.report, 'A7');\n360:   assert.equal(block.state, 'PASS', `a sentence quoting both markers is prose, not a block: ${block.lines.join(' | ')}`);\n361:   assert.match(block.detail, /no block/u, 'the document carries no block, because neither marker is a line of its own');\n362: });\n363: \n364: // ─────────────────────────────────────────────────────────────────────────────\n365: // 7. PINS, BUDGET AND BLOCK SHAPE\n366: // ─────────────────────────────────────────────────────────────────────────────\n367: \n368: test('shadowed-pin: A5 fails because the local lookup line comes before Gate 1', (t) => {\n369:   const fixture = buildFixture(t, 'shadowed-pin');\n370:   const run = runJson(['--root', fixture.dir]);\n371: \n372:   const pins = rowOf(run.report, 'A5');\n373:   assert.equal(pins.state, 'FINDING');\n374:   const pin = pins.entries.find((entry) => entry.id === 'gate1-lookup');\n375:   assert.ok(pin, 'A5 names the pin the local line shadows');\n376:   assert.equal(pin.state, 'FINDING');\n377:   assert.match(pin.detail, /first occurrence/i);\n378: });\n379: \n380: test('over-budget: A6 and A7 both fail', (t) => {\n381:   const fixture = buildFixture(t, 'over-budget');\n382:   const total = Buffer.byteLength(fixture.document, 'utf8');\n383:   assert.ok(total > manifest.budget.max_bytes, `the fixture is ${total} bytes, past the ${manifest.budget.max_bytes}-byte ceiling`);\n384: \n385:   const run = runJson(['--root', fixture.dir]);\n386:   assert.equal(rowOf(run.report, 'A6').state, 'FINDING');\n387:   const block = rowOf(run.report, 'A7');\n388:   assert.equal(block.state, 'FINDING');\n389:   assert.match(block.lines.join(' '), /end marker sits before the start marker/i);\n390:   assert.match(block.lines.join(' '), /exceeds the 32768-byte ceiling/);\n391: });\n392: \n393: // A pin the engine has no rule for is a pin nobody measured. Counting it as a hold is\n394: // how a manifest edit that adds a kind is reported as verified instead of unmeasured.\n395: test('a pin kind with no rule is UNKNOWN, never a hold', (t) => {\n396:   const fixture = buildFixture(t, 'pure');\n397:   const manifestPath = writeManifest(t, {\n398:     pins: [...manifest.pins, { id: 'invented-pin', kind: 'invented', texts: ['nothing'] }],\n399:   });\n400: \n401:   const run = runJson(['--root', fixture.dir, '--manifest', manifestPath]);\n402:   const pins = rowOf(run.report, 'A5');\n403:   assert.equal(pins.state, 'UNKNOWN');\n404:   const entry = pins.entries.find((candidate) => candidate.id === 'invented-pin');\n405:   assert.equal(entry.state, 'UNKNOWN', 'the entry is not recorded as a pass');\n406:   assert.match(pins.detail, /1 unmeasured/);\n407:   assert.equal(run.report.unknown, 1);\n408:   assert.match(run.out, /\"unknown\": 1/);\n409: });\n410: \n411: // An empty classification is not a verified one. The rows around it already say the\n412: // document is empty or foreign, so a PASS here reads as \"currency checked, all current\".\n413: test('A4 reports INFO when there is no matched section to classify', (t) => {\n414:   const fixture = buildFixture(t, 'foreign');\n415:   const run = runJson(['--root', fixture.dir]);\n416: \n417:   const currency = rowOf(run.report, 'A4');\n418:   assert.equal(currency.state, 'INFO');\n419:   assert.match(currency.detail, /no shipped section/i);\n420: });\n421: \n422: test('a missing canary leaves A6 UNKNOWN, never a pass, and fails the run', (t) => {\n423:   const report = buildReport({\n424:     root: REPO_ROOT,\n425:     tools: { canary: path.join(REPO_ROOT, 'no-such-canary.js') },\n426:   });\n427: \n428:   const budget = report.rows.find((row) => row.id === 'A6');\n429:   assert.equal(budget.state, 'UNKNOWN', 'an absent canary cannot be reported as a pass');\n430:   assert.match(budget.detail, /not installed|absent|missing/i);\n431:   assert.equal(report.exitCode, 1, 'a row that could not be proven keeps the run from claiming a pass');\n432:   assert.equal(report.status, 'UNKNOWN');\n433: \n434:   // Installed on a throwaway root, the same row measures instead of giving up.\n435:   const fixture = buildFixture(t, 'pure');\n436:   assert.notEqual(rowOf(runJson(['--root', fixture.dir]).report, 'A6').state, 'UNKNOWN');\n437: });\n438: \n439: // ─────────────────────────────────────────────────────────────────────────────\n440: // 8. RUNTIME COPIES\n441: // ─────────────────────────────────────────────────────────────────────────────\n442: \n443: test('a divergent CLAUDE.md fails A10 and lists the lines only it carries', (t) => {\n444:   const fixture = buildFixture(t, 'adopted');\n445:   const run = runJson(['--root', fixture.dir]);\n446: \n447:   const copies = rowOf(run.report, 'A10');\n448:   assert.equal(copies.state, 'FINDING');\n449:   const copy = copies.entries.find((entry) => entry.path === 'CLAUDE.md');\n450:   assert.ok(copy, 'A10 names the CLAUDE.md row');\n451:   assert.equal(copy.state, 'FINDING');\n452:   assert.equal(copy.kind, 'divergent copy');\n453:   assert.deepEqual(copy.lines, [\n454:     '# Project notes',\n455:     'Run `make check` before you open a pull request.',\n456:     'Update the changelog in the same commit as the code.',\n457:   ]);\n458: });\n459: \n460: test('A10 reports a pointer-only CLAUDE.md and an absent .codex/AGENTS.md without a finding', (t) => {\n461:   const fixture = buildFixture(t, 'pure');\n462:   fs.writeFileSync(\n463:     path.join(fixture.dir, 'CLAUDE.md'),\n464:     '# Claude\\n\\nAll project instructions live in `AGENTS.md`.\\n',\n465:     'utf8',\n466:   );\n467:   const report = buildReport({ root: fixture.dir });\n468: \n469:   const copies = report.rows.find((row) => row.id === 'A10');\n470:   const claude = copies.entries.find((entry) => entry.path === 'CLAUDE.md');\n471:   assert.equal(claude.kind, 'pointer');\n472:   assert.equal(claude.state, 'PASS');\n473:   const codex = copies.entries.find((entry) => entry.path === '.codex/AGENTS.md');\n474:   assert.equal(codex.kind, 'absent');\n475:   assert.equal(codex.state, 'PASS');\n476: });\n477: \n478: // A pointer names the root document on one line and carries no shipped line of its own.\n479: // Its other lines are prose the author wrote, so a verdict claiming every line names the\n480: // root would describe a shape the file never had to hold.\n481: test('A10 describes a pointer by what it does, not by what every line holds', (t) => {\n482:   const fixture = buildFixture(t, 'pure');\n483:   fs.writeFileSync(\n484:     path.join(fixture.dir, 'CLAUDE.md'),\n485:     '@AGENTS.md\\n\\nUse the house style.\\n',\n486:     'utf8',\n487:   );\n488:   const report = buildReport({ root: fixture.dir });\n489: \n490:   const copies = report.rows.find((row) => row.id === 'A10');\n491:   const claude = copies.entries.find((entry) => entry.path === 'CLAUDE.md');\n492:   assert.equal(claude.kind, 'pointer');\n493:   assert.equal(claude.detail, 'names AGENTS.md and carries no shipped line');\n494: });\n495: \n496: // A path the checklist expects to be absent is one no runtime should load. A symlink is\n497: // still a file at that path, so the root document reaches the runtime a second time under\n498: // a name the checklist says nothing belongs at, which reads the same as a hand-kept copy.\n499: test('a symlinked copy where the checklist expects no file is a finding', (t) => {\n500:   const fixture = buildFixture(t, 'pure');\n501:   fs.mkdirSync(path.join(fixture.dir, '.codex'));\n502:   fs.symlinkSync('../AGENTS.md', path.join(fixture.dir, '.codex/AGENTS.md'));\n503: \n504:   const report = buildReport({ root: fixture.dir });\n505:   const copies = report.rows.find((row) => row.id === 'A10');\n506:   const codex = copies.entries.find((entry) => entry.path === '.codex/AGENTS.md');\n507:   assert.equal(codex.state, 'FINDING', 'a link at an absent-only path is not a pass');\n508:   assert.equal(codex.kind, 'symlink where none belongs');\n509: });\n510: \n511: // Claude Code reads only CLAUDE.md, so a tree without one leaves Claude with no route to\n512: // the root document. That is a missing route, not a copy that is wrong, so the row stays a\n513: // pass and the line still prints what Claude never loads.\n514: test('a pure tree with no CLAUDE.md reports a missing pointer and keeps A10 a pass', (t) => {\n515:   const fixture = buildFixture(t, 'pure');\n516:   assert.equal(fs.existsSync(path.join(fixture.dir, 'CLAUDE.md')), false, 'the composed template carries no CLAUDE.md');\n517:   const mirrors = spawnSync(process.execPath, [POINTER_SYNC, '--root', fixture.dir], { encoding: 'utf8' });\n518:   assert.equal(mirrors.status, 0, `the pointer sync completes the fixture's mirrors: ${mirrors.stderr}`);\n519: \n520:   const report = buildReport({ root: fixture.dir });\n521:   const copies = report.rows.find((row) => row.id === 'A10');\n522:   const claude = copies.entries.find((entry) => entry.path === 'CLAUDE.md');\n523:   assert.equal(claude.kind, 'pointer missing');\n524:   assert.equal(claude.state, 'INFO');\n525:   assert.equal(copies.state, 'PASS');\n526:   assert.ok(copies.lines.some((line) => line.startsWith('CLAUDE.md: pointer missing')),\n527:     `the missing pointer is printed, not only recorded: ${JSON.stringify(copies.lines)}`);\n528: });\n529: \n530: // A missing pointer is a route the runtime does not have, not a copy that was checked.\n531: // Counting it among the copies as expected reports a full set from a tree that leaves\n532: // Claude with no route to the root document, so the count leaves it out and names it after.\n533: test('A10 leaves a missing pointer out of the count and names it after the copies', (t) => {\n534:   const fixture = buildFixture(t, 'pure');\n535:   assert.equal(fs.existsSync(path.join(fixture.dir, 'CLAUDE.md')), false, 'the composed template carries no CLAUDE.md');\n536:   const mirrors = spawnSync(process.execPath, [POINTER_SYNC, '--root', fixture.dir], { encoding: 'utf8' });\n537:   assert.equal(mirrors.status, 0, `the pointer sync completes the fixture's mirrors: ${mirrors.stderr}`);\n538: \n539:   const report = buildReport({ root: fixture.dir });\n540:   const copies = report.rows.find((row) => row.id === 'A10');\n541:   assert.ok(copies.detail.endsWith(', 1 pointer missing'),\n542:     `the detail names the missing pointer after the count: ${copies.detail}`);\n543:   assert.match(copies.detail, /^5\\/6 copies as expected/u,\n544:     `the count leaves the CLAUDE.md entry out: ${copies.detail}`);\n545: });\n546: \n547: // A copy whose own tool is missing was not checked. Recorded only in the JSON entries, it\n548: // prints as a pass line with no detail and leaves the run reporting unknown=0.\n549: test('an unmeasured runtime copy makes A10 UNKNOWN and is counted in unknown=', (t) => {\n550:   const fixture = buildFixture(t, 'pure');\n551:   const report = buildReport({\n552:     root: fixture.dir,\n553:     tools: { pointerSync: path.join(fixture.dir, 'no-such-pointer-sync.cjs') },\n554:   });\n555: \n556:   const copies = report.rows.find((row) => row.id === 'A10');\n557:   assert.equal(copies.state, 'UNKNOWN', 'a copy that could not be checked is not a pass');\n558:   const entry = copies.entries.find((candidate) => candidate.path === '.cursor/rules/skill-routing.md');\n559:   assert.equal(entry.state, 'UNKNOWN');\n560:   assert.ok(copies.lines.some((line) => line.includes('.cursor/rules/skill-routing.md')),\n561:     `the unmeasured copy is printed, not only recorded: ${JSON.stringify(copies.lines)}`);\n562:   assert.equal(report.unknown, 1);\n563:   assert.equal(report.exitCode, 1);\n564:   assert.match(renderText(report), /unknown=1/u);\n565: });\n566: \n567: // ─────────────────────────────────────────────────────────────────────────────\n568: // 9. EXIT CODES AND THE READ-ONLY PROMISE\n569: // ─────────────────────────────────────────────────────────────────────────────\n570: \n571: test('exit codes: 0 on this repository, 1 on a finding, 2 on a failed precondition', (t) => {\n572:   const clean = runCheck([]);\n573:   assert.equal(clean.code, 0, `this repository reports no finding; output: ${clean.out}`);\n574: \n575:   const fixture = buildFixture(t, 'forked');\n576:   const finding = runCheck(['--root', fixture.dir]);\n577:   assert.equal(finding.code, 1, 'a finding exits 1');\n578: \n579:   const missingRoot = runCheck(['--root', path.join(fixture.dir, 'no-such-directory')]);\n580:   assert.equal(missingRoot.code, 2, 'a missing root is a failed precondition');\n581:   assert.match(missingRoot.err, /no-such-directory/, 'the failure names the path it could not read');\n582: \n583:   const missingManifest = runCheck(['--root', fixture.dir, '--manifest', path.join(fixture.dir, 'no-such-manifest.json')]);\n584:   assert.equal(missingManifest.code, 2, 'a missing manifest is a failed precondition');\n585:   assert.match(missingManifest.err, /no-such-manifest\\.json/);\n586: });\n587: \n588: test('exit codes: an absent instruction file is a finding, not a precondition failure', (t) => {\n589:   const fixture = buildFixture(t, 'absent');\n590:   const run = runCheck(['--root', fixture.dir]);\n591:   assert.equal(run.code, 1, 'nothing to compare is an answer about the repository, not a broken run');\n592: });\n593: \n594: // The root file's name is the manifest's to declare. Naming it here means a manifest that\n595: // moves the document leaves this precondition reading a file nobody ships.\n596: test('the readability precondition reads the manifest\\'s root file, not a fixed name', (t) => {\n597:   const root = fs.mkdtempSync(path.join(os.tmpdir(), 'agents-md-check-root-file-'));\n598:   t.after(() => fs.rmSync(root, { recursive: true, force: true }));\n599:   // A directory under the name the script used to hardcode: reading it throws, so a run\n600:   // that reads it exits 2 instead of classifying the tree.\n601:   fs.mkdirSync(path.join(root, 'AGENTS.md'));\n602:   const manifestPath = writeManifest(t, { root_file: 'GUIDE.md' });\n603: \n604:   const run = runCheck(['--root', root, '--manifest', manifestPath]);\n605:   assert.equal(run.code, 1, `the tree is classified rather than refused: ${run.err}`);\n606:   assert.doesNotMatch(run.err, /cannot read/u);\n607: });\n608: \n609: test('the write-spy records no filesystem write while every row executes', (t) => {\n610:   const fixture = buildFixture(t, 'forked');\n611:   const watched = [\n612:     'writeFileSync', 'appendFileSync', 'mkdirSync', 'rmSync', 'rmdirSync', 'unlinkSync',\n613:     'copyFileSync', 'renameSync', 'symlinkSync', 'linkSync', 'truncateSync', 'chmodSync',\n614:     'writeFile', 'appendFile', 'mkdir', 'rm', 'unlink', 'copyFile', 'rename', 'openSync',\n615:   ];\n616:   const calls = [];\n617:   const originals = new Map();\n618:   for (const name of watched) {\n619:     if (typeof fs[name] !== 'function') continue;\n620:     originals.set(name, fs[name]);\n621:     fs[name] = (...args) => {\n622:       calls.push(`${name}(${String(args[0])})`);\n623:       return originals.get(name).apply(fs, args);\n624:     };\n625:   }\n626: \n627:   let report = null;\n628:   try {\n629:     report = buildReport({ root: fixture.dir });\n630:   } finally {\n631:     for (const [name, original] of originals) fs[name] = original;\n632:   }\n633: \n634:   assert.deepEqual(calls, [], 'the run wrote nothing');\n635:   assert.equal(report.rows.length, ROWS.length, 'every row ran with the spy in place');\n636: });\n637: \n638: test('every fixture run leaves its tree byte-identical', (t) => {\n639:   for (const name of ['pure', 'adopted', 'stale', 'forked', 'foreign', 'claude-only', 'absent', 'shadowed-pin', 'over-budget']) {\n640:     const fixture = buildFixture(t, name);\n641:     const before = treeDigest(fixture.dir);\n642:     runCheck(['--root', fixture.dir, '--json']);\n643:     runCheck(['--root', fixture.dir]);\n644:     assert.equal(treeDigest(fixture.dir), before, `the ${name} fixture was not touched`);\n645:   }\n646: });\n647: \n648: // ─────────────────────────────────────────────────────────────────────────────\n649: // 10. REPORT SHAPE\n650: // ─────────────────────────────────────────────────────────────────────────────\n651: \n652: test('every row appears in the report, once, in order', (t) => {\n653:   const fixture = buildFixture(t, 'pure');\n654:   const run = runCheck(['--root', fixture.dir]);\n655:   const printed = run.out.split('\\n').map((line) => /^(A\\d+) /.exec(line)).filter(Boolean).map((hit) => hit[1]);\n656:   assert.deepEqual(printed, ROWS);\n657: \n658:   const report = buildReport({ root: fixture.dir });\n659:   assert.deepEqual(report.rows.map((row) => row.id), ROWS);\n660: });\n661: \n662: test('--json carries the same rows and the same state as the text form', (t) => {\n663:   const fixture = buildFixture(t, 'forked');\n664:   const text = runCheck(['--root', fixture.dir]);\n665:   const json = runJson(['--root', fixture.dir]);\n666: \n667:   assert.equal(json.code, text.code, 'the two forms agree on the exit code');\n668:   assert.equal(json.report.state, 'forked');\n669:   const fromText = textRowStates(text.out);\n670:   assert.deepEqual(Object.keys(fromText).sort(), ROWS.slice().sort());\n671:   for (const row of json.report.rows) {\n672:     assert.equal(row.state, fromText[row.id], `row ${row.id} reads the same in both forms`);\n673:   }\n674: });\n675: \n676: test('this repository reports STATUS=OK and a pure install state', () => {\n677:   const run = runCheck([]);\n678:   assert.equal(run.code, 0);\n679:   assert.match(run.out, /^STATUS=OK/m);\n680:   assert.match(run.out, /^A1 install state: pure/m);\n681: });\n682: \n683: test('A11 embeds the repo-rules checker\\'s own summary line instead of re-deriving it', () => {\n684:   const report = buildReport({ root: REPO_ROOT });\n685:   const row = report.rows.find((entry) => entry.id === 'A11');\n686:   assert.equal(row.state, 'PASS');\n687:   assert.match(row.detail, /\\[repo-rules-check\\] RESULT: PASSED \\(\\d+\\/\\d+ checks\\)/);\n688: });\n689: \n690: test('A12 reports INFO outside the source repository and runs inside it', (t) => {\n691:   const fixture = buildFixture(t, 'pure');\n692:   const outside = buildReport({ root: fixture.dir });\n693:   const row = outside.rows.find((entry) => entry.id === 'A12');\n694:   assert.equal(row.state, 'INFO');\n695:   assert.match(row.detail, /source repository/);\n696: \n697:   const inside = buildReport({ root: REPO_ROOT });\n698:   assert.equal(inside.rows.find((entry) => entry.id === 'A12').state, 'PASS');\n699: });\n700: \n701: test('a precondition failure exits 2 rather than printing an empty report', (t) => {\n702:   const fixture = buildFixture(t, 'pure');\n703:   const code = main(['--root', fixture.dir, '--manifest', path.join(fixture.dir, 'missing.json')]);\n704:   assert.equal(code, 2);\n705: });","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/commands/doctor/scripts/tests/agents-md-check.test.cjs, lines 1-705\n1: #!/usr/bin/env node\n2: // ───────────────────────────────────────────────────────────────────\n3: // MODULE: Shipped Instruction Check Engine Tests\n4: // ───────────────────────────────────────────────────────────────────\n5: 'use strict';\n6: \n7: // The check engine answers one question per repository: what do we hold against what\n8: // was shipped, and what would be lost by replacing it. Its whole value is that the\n9: // answer is trustworthy in a repository nobody inspected, so this suite proves each\n10: // answer on a synthetic repository carrying exactly one shape of drift, and proves the\n11: // run itself leaves the tree untouched.\n12: //\n13: // Each synthetic repository is composed from the manifest's derived bodies into a\n14: // throwaway directory, never committed and never read twice. A fixture folder therefore\n15: // holds a recipe and no document: the tree is a statement about the template that ships\n16: // today rather than a snapshot of it at the time the recipe was written, and a fixture\n17: // cannot describe a template the manifest does not ship. Refreshing a released body in\n18: // the manifest refreshes every fixture in the same edit, and no copy of the template\n19: // sits in the tree for a link checker or a runtime to pick up.\n20: \n21: // ─────────────────────────────────────────────────────────────────────────────\n22: // 1. IMPORTS AND PATHS\n23: // ─────────────────────────────────────────────────────────────────────────────\n24: \n25: const assert = require('node:assert/strict');\n26: const { spawnSync } = require('node:child_process');\n27: const crypto = require('node:crypto');\n28: const fs = require('node:fs');\n29: const os = require('node:os');\n30: const path = require('node:path');\n31: const test = require('node:test');\n32: \n33: const { buildReport, main, renderText } = require('../agents-md-check.cjs');\n34: const { segment } = require('../lib/agents-md-sections.cjs');\n35: const {\n36:   FIXTURES,\n37:   MANIFEST_PATH,\n38:   REPO_ROOT,\n39:   SCRIPTS_DIR,\n40:   composeFixture,\n41:   fixtureNames,\n42:   loadRecipe,\n43:   moveBlockBefore,\n44: } = require('./fixtures/agents-md/compose-fixture.cjs');\n45: \n46: const ENGINE = path.join(SCRIPTS_DIR, 'agents-md-check.cjs');\n47: // The composer writes the Gate 1 mirror only, so a case that reads a whole runtime-copy row\n48: // finishes the mirrors with the generator that owns them, as a repository that ran its own\n49: // generators would.\n50: const POINTER_SYNC = path.join(\n51:   REPO_ROOT,\n52:   '.skilled/skills/system-spec-kit/runtime/cli/runtime-mirrors/sync-gate1-pointers.cjs',\n53: );\n54: \n55: const manifest = JSON.parse(fs.readFileSync(MANIFEST_PATH, 'utf8'));\n56: \n57: // The rows every report carries, in the order the engine prints them.\n58: const ROWS = ['A1', 'A2', 'A3', 'A4', 'A5', 'A6', 'A7', 'A8', 'A9', 'A10', 'A11', 'A12'];\n59: \n60: // ─────────────────────────────────────────────────────────────────────────────\n61: // 2. FIXTURE TREES\n62: // ─────────────────────────────────────────────────────────────────────────────\n63: \n64: // Every engine run happens on a tree composed for it and removed afterwards, so no case\n65: // can read a stale copy of a document, and the tree a case runs against is always the\n66: // template that ships in this repository.\n67: function buildFixture(t, name) {\n68:   const parent = fs.mkdtempSync(path.join(os.tmpdir(), `agents-md-check-${name}-`));\n69:   t.after(() => fs.rmSync(parent, { recursive: true, force: true }));\n70:   const dir = path.join(parent, name);\n71:   composeFixture(name, dir);\n72:   const documentPath = path.join(dir, manifest.root_file);\n73:   return {\n74:     dir,\n75:     recipe: loadRecipe(name),\n76:     document: fs.existsSync(documentPath) ? fs.readFileSync(documentPath, 'utf8') : null,\n77:   };\n78: }\n79: \n80: // ─────────────────────────────────────────────────────────────────────────────\n81: // 3. RUNNERS AND READERS\n82: // ─────────────────────────────────────────────────────────────────────────────\n83: \n84: function runCheck(args) {\n85:   const result = spawnSync(process.execPath, [ENGINE, ...args], { encoding: 'utf8' });\n86:   return { code: result.status, out: result.stdout || '', err: result.stderr || '' };\n87: }\n88: \n89: function runJson(args) {\n90:   const run = runCheck([...args, '--json']);\n91:   let report = null;\n92:   try {\n93:     report = JSON.parse(run.out);\n94:   } catch {\n95:     report = null;\n96:   }\n97:   return { ...run, report };\n98: }\n99: \n100: function rowOf(report, id) {\n101:   const row = report.rows.find((entry) => entry.id === id);\n102:   assert.ok(row, `the report carries row ${id}`);\n103:   return row;\n104: }\n105: \n106: // The text form prints one line per row, ending in the row's verdict, so the two\n107: // renderers can be compared without re-implementing either.\n108: function textRowStates(out) {\n109:   const states = {};\n110:   for (const line of out.split('\\n')) {\n111:     const hit = /^(A\\d+) .*\\((PASS|FINDING|UNKNOWN|INFO)\\)$/.exec(line);\n112:     if (hit) states[hit[1]] = hit[2];\n113:   }\n114:   return states;\n115: }\n116: \n117: function listFiles(dir) {\n118:   const files = [];\n119:   for (const entry of fs.readdirSync(dir, { withFileTypes: true })) {\n120:     const target = path.join(dir, entry.name);\n121:     if (entry.isDirectory()) files.push(...listFiles(target));\n122:     else files.push(target);\n123:   }\n124:   return files;\n125: }\n126: \n127: // A fixture's document is rewritten by a case that needs a shape no recipe describes,\n128: // so the tree a case reads is always the template the manifest ships today.\n129: function rewriteDocument(fixture, text) {\n130:   fs.writeFileSync(path.join(fixture.dir, manifest.root_file), text, 'utf8');\n131: }\n132: \n133: // A throwaway manifest: pin kinds and root file names are the two places a case needs a\n134: // declaration the shipped manifest does not carry.\n135: function writeManifest(t, patch) {\n136:   const dir = fs.mkdtempSync(path.join(os.tmpdir(), 'agents-md-check-manifest-'));\n137:   t.after(() => fs.rmSync(dir, { recursive: true, force: true }));\n138:   const target = path.join(dir, 'agents-md-manifest.json');\n139:   fs.writeFileSync(target, `${JSON.stringify({ ...manifest, ...patch }, null, 2)}\\n`, 'utf8');\n140:   return target;\n141: }\n142: \n143: function treeDigest(dir) {\n144:   const hash = crypto.createHash('sha256');\n145:   for (const file of listFiles(dir).sort()) {\n146:     hash.update(path.relative(dir, file));\n147:     hash.update(fs.readFileSync(file));\n148:   }\n149:   return hash.digest('hex');\n150: }\n151: \n152: // ─────────────────────────────────────────────────────────────────────────────\n153: // 4. THE FIXTURES ARE RECIPES, NOT COPIES\n154: // ─────────────────────────────────────────────────────────────────────────────\n155: \n156: // A composed tree committed beside its recipe would be a second copy of the template,\n157: // and the copy is what the repository would then have to keep: relative links would\n158: // resolve against the fixture folder, a runtime loading nested instruction files would\n159: // read it as somebody's own document, and each template edit would need a regeneration\n160: // commit. This case holds the rule the fixtures are arranged by.\n161: test('every fixture folder holds its recipe and no composed tree', () => {\n162:   const stray = [];\n163:   for (const name of fixtureNames()) {\n164:     for (const entry of fs.readdirSync(path.join(FIXTURES, name), { withFileTypes: true })) {\n165:       if (entry.name !== 'fixture.json' || entry.isDirectory()) stray.push(`${name}/${entry.name}`);\n166:     }\n167:   }\n168:   assert.deepEqual(stray, [],\n169:     'compose a fixture into a temporary folder with the suite\\'s composer instead of committing the tree it describes');\n170: });\n171: \n172: test('composer: the pure fixture rebuilds the shipped document from the manifest', (t) => {\n173:   const fixture = buildFixture(t, 'pure');\n174:   const { sections } = segment(fixture.document, manifest.markers, manifest.sections);\n175: \n176:   assert.equal(sections.length, manifest.sections.length, 'the composed document carries every shipped section');\n177:   for (const section of sections) {\n178:     assert.ok(section.id, `the composed heading ${JSON.stringify(section.heading)} matches a manifest entry`);\n179:     assert.equal(section.sha256, manifest.derived.sections[section.id].sha256,\n180:       `section ${section.id} is byte-identical to the manifest's derived body`);\n181:   }\n182:   const rootDocument = fs.readFileSync(path.join(REPO_ROOT, manifest.root_file), 'utf8');\n183:   assert.ok(rootDocument.startsWith(fixture.document),\n184:     'the composed document is the root document up to its repository block');\n185: });\n186: \n187: test('composer: each fixture declares the install state it plants', () => {\n188:   const names = fixtureNames();\n189:   assert.equal(names.length, 9, 'there are nine fixture recipes');\n190:   for (const name of names) {\n191:     const recipe = loadRecipe(name);\n192:     assert.equal(recipe.name, name, `${name} names itself`);\n193:     assert.ok(recipe.expect_state, `${name} declares its expected install state`);\n194:     assert.ok(recipe.notes, `${name} says what defect it plants`);\n195:   }\n196: });\n197: \n198: // ─────────────────────────────────────────────────────────────────────────────\n199: // 5. A1 INSTALL STATE, ONE FIXTURE PER STATE\n200: // ─────────────────────────────────────────────────────────────────────────────\n201: \n202: for (const name of ['pure', 'adopted', 'stale', 'forked', 'foreign', 'claude-only', 'absent', 'shadowed-pin', 'over-budget']) {\n203:   test(`A1 install state: the ${name} fixture classifies as ${loadRecipe(name).expect_state}`, (t) => {\n204:     const fixture = buildFixture(t, name);\n205:     const run = runJson(['--root', fixture.dir]);\n206: \n207:     assert.ok(run.report, `the engine prints a JSON report for ${name}; stderr: ${run.err}`);\n208:     assert.equal(run.report.state, fixture.recipe.expect_state);\n209:     assert.match(run.out, new RegExp(`\"state\": \"${fixture.recipe.expect_state}\"`));\n210:   });\n211: }\n212: \n213: test('A1 install state: this repository is the source template and classifies as pure', () => {\n214:   const report = buildReport({ root: REPO_ROOT });\n215:   assert.equal(report.state, 'pure', 'the shipped template carries every section current and an empty block');\n216: });\n217: \n218: // ─────────────────────────────────────────────────────────────────────────────\n219: // 6. UNMARKED CONTENT AND UNMARKED EDITS\n220: // ─────────────────────────────────────────────────────────────────────────────\n221: \n222: test('forked: A8 lists the unmarked section with its byte range and A9 lists the local line', (t) => {\n223:   const fixture = buildFixture(t, 'forked');\n224:   const run = runJson(['--root', fixture.dir]);\n225: \n226:   assert.equal(run.code, 1, 'a forked repository is a finding, not a pass');\n227:   assert.equal(rowOf(run.report, 'A1').detail, 'forked');\n228: \n229:   const unmarked = rowOf(run.report, 'A8');\n230:   assert.equal(unmarked.state, 'FINDING');\n231:   const section = unmarked.entries.find((entry) => entry.heading.includes('Local release checklist'));\n232:   assert.ok(section, \"A8 lists the repository's own section by heading\");\n233:   assert.ok(section.byte_start > 0 && section.byte_end > section.byte_start, 'A8 gives the section a byte range');\n234:   assert.equal(section.line_start, fixture.document.split('\\n').indexOf('## Local release checklist') + 1,\n235:     'A8 gives the section a line range that a reader can open');\n236:   assert.equal(section.in_prefix, false, 'the section sits outside the delivery prefix');\n237: \n238:   const edits = rowOf(run.report, 'A9');\n239:   assert.equal(edits.state, 'FINDING');\n240:   const edited = edits.entries.find((entry) => entry.id === 's6-spec-folder');\n241:   assert.ok(edited, 'A9 names the edited section');\n242:   assert.equal(edited.state, 'edited');\n243:   assert.deepEqual(edited.lines, ['Local rule: name the packet in the first line of every pull request.']);\n244: });\n245: \n246: // The same sentence written twice is two lines a replacement would lose, so the row\n247: // counts occurrences: a set would report one line and hide the other.\n248: test('A9 counts a repeated local line once per occurrence', (t) => {\n249:   const fixture = buildFixture(t, 'forked');\n250:   const line = 'Local rule: name the packet in the first line of every pull request.';\n251:   rewriteDocument(fixture, fixture.document.replace(line, `${line}\\n${line}`));\n252: \n253:   const run = runJson(['--root', fixture.dir]);\n254:   const edits = rowOf(run.report, 'A9');\n255:   assert.equal(edits.state, 'FINDING');\n256:   const edited = edits.entries.find((entry) => entry.id === 's6-spec-folder');\n257:   assert.deepEqual(edited.lines, [line, line], 'the repeated line is listed twice');\n258:   assert.match(edits.detail, /1 section\\(s\\) carry 2 local line\\(s\\)/);\n259: });\n260: \n261: // A repository that wrote its block between two shipped sections still carries every\n262: // shipped section, and the block is in the one place the template does not put it. Read\n263: // only above the block, the document looks like somebody else's file and the position is\n264: // never named.\n265: test('a block placed between shipped sections is reported by A7 with its position', (t) => {\n266:   const fixture = buildFixture(t, 'adopted');\n267:   const moved = moveBlockBefore(fixture.document, '#### The Four Laws');\n268:   rewriteDocument(fixture, moved);\n269: \n270:   const run = runJson(['--root', fixture.dir]);\n271:   assert.equal(rowOf(run.report, 'A1').detail, 'adopted', 'every shipped section is still current');\n272:   assert.equal(rowOf(run.report, 'A2').detail, '44/44 matched', 'the sections below the block are shipped ones');\n273:   assert.equal(rowOf(run.report, 'A8').state, 'PASS', 'nothing below the block is unmarked content');\n274: \n275:   const block = rowOf(run.report, 'A7');\n276:   assert.equal(block.state, 'FINDING');\n277:   const position = block.lines.join(' ');\n278:   // Offsets in the report are bytes, and the template carries multi-byte headings above\n279:   // the block, so the character index is not the figure to compare against.\n280:   const blockByte = Buffer.byteLength(moved.slice(0, moved.indexOf(manifest.markers.start)), 'utf8');\n281:   assert.ok(position.includes(`byte ${blockByte}`), `A7 names where the block sits: ${position}`);\n282:   assert.match(position, /The Four Laws/, 'A7 names the shipped section the block sits in front of');\n283: });\n284: \n285: // The end marker is not the end of the file: a line typed below it is the repository's\n286: // own, and a rewrite that keeps only the block would drop it without a word.\n287: test('a line after the block end marker is reported as a local edit', (t) => {\n288:   const fixture = buildFixture(t, 'adopted');\n289:   const line = 'Ship the release note in the same commit as the tag.';\n290:   rewriteDocument(fixture, `${fixture.document}${line}\\n`);\n291: \n292:   const run = runJson(['--root', fixture.dir]);\n293:   assert.equal(rowOf(run.report, 'A1').detail, 'forked');\n294: \n295:   const edits = rowOf(run.report, 'A9');\n296:   assert.equal(edits.state, 'FINDING');\n297:   const carrier = edits.entries.find((entry) => entry.lines.includes(line));\n298:   assert.ok(carrier, `A9 lists the line below the end marker: ${JSON.stringify(edits.entries)}`);\n299: });\n300: \n301: // Text above the first heading belongs to no section, so it is the one piece of\n302: // repository content a heading-shaped comparison cannot see. Left unreported, a document\n303: // carrying it reads as a pure template and a rewrite drops it.\n304: test('text before the first shipped heading is reported as unmarked repository content', (t) => {\n305:   const fixture = buildFixture(t, 'pure');\n306:   const line = 'Read me first.';\n307:   rewriteDocument(fixture, `${line}\\n${fixture.document}`);\n308: \n309:   const run = runJson(['--root', fixture.dir]);\n310:   assert.equal(rowOf(run.report, 'A1').detail, 'forked');\n311: \n312:   const unmarked = rowOf(run.report, 'A8');\n313:   assert.equal(unmarked.state, 'FINDING');\n314:   const prelude = unmarked.entries.find((entry) => entry.heading === null);\n315:   assert.ok(prelude, `A8 names the text above the first heading: ${JSON.stringify(unmarked.entries)}`);\n316:   assert.equal(prelude.byte_start, 0, 'the region starts at the first byte');\n317:   assert.equal(prelude.line_start, 1);\n318:   assert.match(unmarked.lines.join(' '), /before the first heading/);\n319: });\n320: \n321: // A body can carry every line the shipped body carries and still not be it: one extra\n322: // space on an indented bullet is a real difference and a rewrite replaces it. A finding\n323: // with nothing under it names no line to look at, so the row says what the difference is\n324: // and where the two bodies part company.\n325: test('A9 names a body that differs only in whitespace, by line', (t) => {\n326:   const fixture = buildFixture(t, 'pure');\n327:   const shipped = manifest.derived.sections['gate-3'].body;\n328:   const lines = shipped.split('\\n');\n329:   const indented = lines.findIndex((row) => row.startsWith('  '));\n330:   assert.notEqual(indented, -1, 'the shipped body carries an indented line');\n331:   lines[indented] = ` ${lines[indented]}`;\n332:   assert.notEqual(lines[indented], shipped.split('\\n')[indented]);\n333:   rewriteDocument(fixture, fixture.document.replace(shipped, lines.join('\\n')));\n334: \n335:   const run = runJson(['--root', fixture.dir]);\n336:   assert.equal(rowOf(run.report, 'A4').entries.find((entry) => entry.id === 'gate-3').state, 'edited', 'the body is not the shipped one');\n337: \n338:   const edits = rowOf(run.report, 'A9');\n339:   assert.equal(edits.state, 'FINDING', 'the section is not the shipped one, so the row reports it');\n340:   assert.ok(edits.lines.length > 0, 'a finding names at least one line to act on');\n341:   assert.match(edits.lines[0], /gate-3/u, 'the line names the section');\n342:   assert.match(edits.lines[0], new RegExp(`line ${indented + 1}\\\\b`, 'u'), 'and the line of the body where the two differ');\n343:   assert.match(edits.lines[0], /whitespace/u, 'and says the difference is whitespace');\n344: \n345:   const text = runCheck(['--root', fixture.dir]);\n346:   assert.match(text.out, /A9 unmarked local edits: .*\\(FINDING\\)/u);\n347:   assert.match(text.out, /gate-3: only whitespace/u, 'the text form prints the same line');\n348: });\n349: \n350: // A marker is the whole line, so a sentence that quotes both markers is prose. Counting\n351: // the bytes instead would report a document with no block as carrying two of them, which\n352: // is a finding about a file nobody can fix.\n353: test('A7 counts marker lines, not the marker text quoted inside a sentence', (t) => {\n354:   const fixture = buildFixture(t, 'pure');\n355:   const sentence = 'The block is fenced by `<!-- skilled:repo-local:start -->` and `<!-- skilled:repo-local:end -->` in this framework.';\n356:   rewriteDocument(fixture, `${fixture.document}${sentence}\\n`);\n357: \n358:   const run = runJson(['--root', fixture.dir]);\n359:   const block = rowOf(run.report, 'A7');\n360:   assert.equal(block.state, 'PASS', `a sentence quoting both markers is prose, not a block: ${block.lines.join(' | ')}`);\n361:   assert.match(block.detail, /no block/u, 'the document carries no block, because neither marker is a line of its own');\n362: });\n363: \n364: // ─────────────────────────────────────────────────────────────────────────────\n365: // 7. PINS, BUDGET AND BLOCK SHAPE\n366: // ─────────────────────────────────────────────────────────────────────────────\n367: \n368: test('shadowed-pin: A5 fails because the local lookup line comes before Gate 1', (t) => {\n369:   const fixture = buildFixture(t, 'shadowed-pin');\n370:   const run = runJson(['--root', fixture.dir]);\n371: \n372:   const pins = rowOf(run.report, 'A5');\n373:   assert.equal(pins.state, 'FINDING');\n374:   const pin = pins.entries.find((entry) => entry.id === 'gate1-lookup');\n375:   assert.ok(pin, 'A5 names the pin the local line shadows');\n376:   assert.equal(pin.state, 'FINDING');\n377:   assert.match(pin.detail, /first occurrence/i);\n378: });\n379: \n380: test('over-budget: A6 and A7 both fail', (t) => {\n381:   const fixture = buildFixture(t, 'over-budget');\n382:   const total = Buffer.byteLength(fixture.document, 'utf8');\n383:   assert.ok(total > manifest.budget.max_bytes, `the fixture is ${total} bytes, past the ${manifest.budget.max_bytes}-byte ceiling`);\n384: \n385:   const run = runJson(['--root', fixture.dir]);\n386:   assert.equal(rowOf(run.report, 'A6').state, 'FINDING');\n387:   const block = rowOf(run.report, 'A7');\n388:   assert.equal(block.state, 'FINDING');\n389:   assert.match(block.lines.join(' '), /end marker sits before the start marker/i);\n390:   assert.match(block.lines.join(' '), /exceeds the 32768-byte ceiling/);\n391: });\n392: \n393: // A pin the engine has no rule for is a pin nobody measured. Counting it as a hold is\n394: // how a manifest edit that adds a kind is reported as verified instead of unmeasured.\n395: test('a pin kind with no rule is UNKNOWN, never a hold', (t) => {\n396:   const fixture = buildFixture(t, 'pure');\n397:   const manifestPath = writeManifest(t, {\n398:     pins: [...manifest.pins, { id: 'invented-pin', kind: 'invented', texts: ['nothing'] }],\n399:   });\n400: \n401:   const run = runJson(['--root', fixture.dir, '--manifest', manifestPath]);\n402:   const pins = rowOf(run.report, 'A5');\n403:   assert.equal(pins.state, 'UNKNOWN');\n404:   const entry = pins.entries.find((candidate) => candidate.id === 'invented-pin');\n405:   assert.equal(entry.state, 'UNKNOWN', 'the entry is not recorded as a pass');\n406:   assert.match(pins.detail, /1 unmeasured/);\n407:   assert.equal(run.report.unknown, 1);\n408:   assert.match(run.out, /\"unknown\": 1/);\n409: });\n410: \n411: // An empty classification is not a verified one. The rows around it already say the\n412: // document is empty or foreign, so a PASS here reads as \"currency checked, all current\".\n413: test('A4 reports INFO when there is no matched section to classify', (t) => {\n414:   const fixture = buildFixture(t, 'foreign');\n415:   const run = runJson(['--root', fixture.dir]);\n416: \n417:   const currency = rowOf(run.report, 'A4');\n418:   assert.equal(currency.state, 'INFO');\n419:   assert.match(currency.detail, /no shipped section/i);\n420: });\n421: \n422: test('a missing canary leaves A6 UNKNOWN, never a pass, and fails the run', (t) => {\n423:   const report = buildReport({\n424:     root: REPO_ROOT,\n425:     tools: { canary: path.join(REPO_ROOT, 'no-such-canary.js') },\n426:   });\n427: \n428:   const budget = report.rows.find((row) => row.id === 'A6');\n429:   assert.equal(budget.state, 'UNKNOWN', 'an absent canary cannot be reported as a pass');\n430:   assert.match(budget.detail, /not installed|absent|missing/i);\n431:   assert.equal(report.exitCode, 1, 'a row that could not be proven keeps the run from claiming a pass');\n432:   assert.equal(report.status, 'UNKNOWN');\n433: \n434:   // Installed on a throwaway root, the same row measures instead of giving up.\n435:   const fixture = buildFixture(t, 'pure');\n436:   assert.notEqual(rowOf(runJson(['--root', fixture.dir]).report, 'A6').state, 'UNKNOWN');\n437: });\n438: \n439: // ─────────────────────────────────────────────────────────────────────────────\n440: // 8. RUNTIME COPIES\n441: // ─────────────────────────────────────────────────────────────────────────────\n442: \n443: test('a divergent CLAUDE.md fails A10 and lists the lines only it carries', (t) => {\n444:   const fixture = buildFixture(t, 'adopted');\n445:   const run = runJson(['--root', fixture.dir]);\n446: \n447:   const copies = rowOf(run.report, 'A10');\n448:   assert.equal(copies.state, 'FINDING');\n449:   const copy = copies.entries.find((entry) => entry.path === 'CLAUDE.md');\n450:   assert.ok(copy, 'A10 names the CLAUDE.md row');\n451:   assert.equal(copy.state, 'FINDING');\n452:   assert.equal(copy.kind, 'divergent copy');\n453:   assert.deepEqual(copy.lines, [\n454:     '# Project notes',\n455:     'Run `make check` before you open a pull request.',\n456:     'Update the changelog in the same commit as the code.',\n457:   ]);\n458: });\n459: \n460: test('A10 reports a pointer-only CLAUDE.md and an absent .codex/AGENTS.md without a finding', (t) => {\n461:   const fixture = buildFixture(t, 'pure');\n462:   fs.writeFileSync(\n463:     path.join(fixture.dir, 'CLAUDE.md'),\n464:     '# Claude\\n\\nAll project instructions live in `AGENTS.md`.\\n',\n465:     'utf8',\n466:   );\n467:   const report = buildReport({ root: fixture.dir });\n468: \n469:   const copies = report.rows.find((row) => row.id === 'A10');\n470:   const claude = copies.entries.find((entry) => entry.path === 'CLAUDE.md');\n471:   assert.equal(claude.kind, 'pointer');\n472:   assert.equal(claude.state, 'PASS');\n473:   const codex = copies.entries.find((entry) => entry.path === '.codex/AGENTS.md');\n474:   assert.equal(codex.kind, 'absent');\n475:   assert.equal(codex.state, 'PASS');\n476: });\n477: \n478: // A pointer names the root document on one line and carries no shipped line of its own.\n479: // Its other lines are prose the author wrote, so a verdict claiming every line names the\n480: // root would describe a shape the file never had to hold.\n481: test('A10 describes a pointer by what it does, not by what every line holds', (t) => {\n482:   const fixture = buildFixture(t, 'pure');\n483:   fs.writeFileSync(\n484:     path.join(fixture.dir, 'CLAUDE.md'),\n485:     '@AGENTS.md\\n\\nUse the house style.\\n',\n486:     'utf8',\n487:   );\n488:   const report = buildReport({ root: fixture.dir });\n489: \n490:   const copies = report.rows.find((row) => row.id === 'A10');\n491:   const claude = copies.entries.find((entry) => entry.path === 'CLAUDE.md');\n492:   assert.equal(claude.kind, 'pointer');\n493:   assert.equal(claude.detail, 'names AGENTS.md and carries no shipped line');\n494: });\n495: \n496: // A path the checklist expects to be absent is one no runtime should load. A symlink is\n497: // still a file at that path, so the root document reaches the runtime a second time under\n498: // a name the checklist says nothing belongs at, which reads the same as a hand-kept copy.\n499: test('a symlinked copy where the checklist expects no file is a finding', (t) => {\n500:   const fixture = buildFixture(t, 'pure');\n501:   fs.mkdirSync(path.join(fixture.dir, '.codex'));\n502:   fs.symlinkSync('../AGENTS.md', path.join(fixture.dir, '.codex/AGENTS.md'));\n503: \n504:   const report = buildReport({ root: fixture.dir });\n505:   const copies = report.rows.find((row) => row.id === 'A10');\n506:   const codex = copies.entries.find((entry) => entry.path === '.codex/AGENTS.md');\n507:   assert.equal(codex.state, 'FINDING', 'a link at an absent-only path is not a pass');\n508:   assert.equal(codex.kind, 'symlink where none belongs');\n509: });\n510: \n511: // Claude Code reads only CLAUDE.md, so a tree without one leaves Claude with no route to\n512: // the root document. That is a missing route, not a copy that is wrong, so the row stays a\n513: // pass and the line still prints what Claude never loads.\n514: test('a pure tree with no CLAUDE.md reports a missing pointer and keeps A10 a pass', (t) => {\n515:   const fixture = buildFixture(t, 'pure');\n516:   assert.equal(fs.existsSync(path.join(fixture.dir, 'CLAUDE.md')), false, 'the composed template carries no CLAUDE.md');\n517:   const mirrors = spawnSync(process.execPath, [POINTER_SYNC, '--root', fixture.dir], { encoding: 'utf8' });\n518:   assert.equal(mirrors.status, 0, `the pointer sync completes the fixture's mirrors: ${mirrors.stderr}`);\n519: \n520:   const report = buildReport({ root: fixture.dir });\n521:   const copies = report.rows.find((row) => row.id === 'A10');\n522:   const claude = copies.entries.find((entry) => entry.path === 'CLAUDE.md');\n523:   assert.equal(claude.kind, 'pointer missing');\n524:   assert.equal(claude.state, 'INFO');\n525:   assert.equal(copies.state, 'PASS');\n526:   assert.ok(copies.lines.some((line) => line.startsWith('CLAUDE.md: pointer missing')),\n527:     `the missing pointer is printed, not only recorded: ${JSON.stringify(copies.lines)}`);\n528: });\n529: \n530: // A missing pointer is a route the runtime does not have, not a copy that was checked.\n531: // Counting it among the copies as expected reports a full set from a tree that leaves\n532: // Claude with no route to the root document, so the count leaves it out and names it after.\n533: test('A10 leaves a missing pointer out of the count and names it after the copies', (t) => {\n534:   const fixture = buildFixture(t, 'pure');\n535:   assert.equal(fs.existsSync(path.join(fixture.dir, 'CLAUDE.md')), false, 'the composed template carries no CLAUDE.md');\n536:   const mirrors = spawnSync(process.execPath, [POINTER_SYNC, '--root', fixture.dir], { encoding: 'utf8' });\n537:   assert.equal(mirrors.status, 0, `the pointer sync completes the fixture's mirrors: ${mirrors.stderr}`);\n538: \n539:   const report = buildReport({ root: fixture.dir });\n540:   const copies = report.rows.find((row) => row.id === 'A10');\n541:   assert.ok(copies.detail.endsWith(', 1 pointer missing'),\n542:     `the detail names the missing pointer after the count: ${copies.detail}`);\n543:   assert.match(copies.detail, /^5\\/6 copies as expected/u,\n544:     `the count leaves the CLAUDE.md entry out: ${copies.detail}`);\n545: });\n546: \n547: // A copy whose own tool is missing was not checked. Recorded only in the JSON entries, it\n548: // prints as a pass line with no detail and leaves the run reporting unknown=0.\n549: test('an unmeasured runtime copy makes A10 UNKNOWN and is counted in unknown=', (t) => {\n550:   const fixture = buildFixture(t, 'pure');\n551:   const report = buildReport({\n552:     root: fixture.dir,\n553:     tools: { pointerSync: path.join(fixture.dir, 'no-such-pointer-sync.cjs') },\n554:   });\n555: \n556:   const copies = report.rows.find((row) => row.id === 'A10');\n557:   assert.equal(copies.state, 'UNKNOWN', 'a copy that could not be checked is not a pass');\n558:   const entry = copies.entries.find((candidate) => candidate.path === '.cursor/rules/skill-routing.md');\n559:   assert.equal(entry.state, 'UNKNOWN');\n560:   assert.ok(copies.lines.some((line) => line.includes('.cursor/rules/skill-routing.md')),\n561:     `the unmeasured copy is printed, not only recorded: ${JSON.stringify(copies.lines)}`);\n562:   assert.equal(report.unknown, 1);\n563:   assert.equal(report.exitCode, 1);\n564:   assert.match(renderText(report), /unknown=1/u);\n565: });\n566: \n567: // ─────────────────────────────────────────────────────────────────────────────\n568: // 9. EXIT CODES AND THE READ-ONLY PROMISE\n569: // ─────────────────────────────────────────────────────────────────────────────\n570: \n571: test('exit codes: 0 on this repository, 1 on a finding, 2 on a failed precondition', (t) => {\n572:   const clean = runCheck([]);\n573:   assert.equal(clean.code, 0, `this repository reports no finding; output: ${clean.out}`);\n574: \n575:   const fixture = buildFixture(t, 'forked');\n576:   const finding = runCheck(['--root', fixture.dir]);\n577:   assert.equal(finding.code, 1, 'a finding exits 1');\n578: \n579:   const missingRoot = runCheck(['--root', path.join(fixture.dir, 'no-such-directory')]);\n580:   assert.equal(missingRoot.code, 2, 'a missing root is a failed precondition');\n581:   assert.match(missingRoot.err, /no-such-directory/, 'the failure names the path it could not read');\n582: \n583:   const missingManifest = runCheck(['--root', fixture.dir, '--manifest', path.join(fixture.dir, 'no-such-manifest.json')]);\n584:   assert.equal(missingManifest.code, 2, 'a missing manifest is a failed precondition');\n585:   assert.match(missingManifest.err, /no-such-manifest\\.json/);\n586: });\n587: \n588: test('exit codes: an absent instruction file is a finding, not a precondition failure', (t) => {\n589:   const fixture = buildFixture(t, 'absent');\n590:   const run = runCheck(['--root', fixture.dir]);\n591:   assert.equal(run.code, 1, 'nothing to compare is an answer about the repository, not a broken run');\n592: });\n593: \n594: // The root file's name is the manifest's to declare. Naming it here means a manifest that\n595: // moves the document leaves this precondition reading a file nobody ships.\n596: test('the readability precondition reads the manifest\\'s root file, not a fixed name', (t) => {\n597:   const root = fs.mkdtempSync(path.join(os.tmpdir(), 'agents-md-check-root-file-'));\n598:   t.after(() => fs.rmSync(root, { recursive: true, force: true }));\n599:   // A directory under the name the script used to hardcode: reading it throws, so a run\n600:   // that reads it exits 2 instead of classifying the tree.\n601:   fs.mkdirSync(path.join(root, 'AGENTS.md'));\n602:   const manifestPath = writeManifest(t, { root_file: 'GUIDE.md' });\n603: \n604:   const run = runCheck(['--root', root, '--manifest', manifestPath]);\n605:   assert.equal(run.code, 1, `the tree is classified rather than refused: ${run.err}`);\n606:   assert.doesNotMatch(run.err, /cannot read/u);\n607: });\n608: \n609: test('the write-spy records no filesystem write while every row executes', (t) => {\n610:   const fixture = buildFixture(t, 'forked');\n611:   const watched = [\n612:     'writeFileSync', 'appendFileSync', 'mkdirSync', 'rmSync', 'rmdirSync', 'unlinkSync',\n613:     'copyFileSync', 'renameSync', 'symlinkSync', 'linkSync', 'truncateSync', 'chmodSync',\n614:     'writeFile', 'appendFile', 'mkdir', 'rm', 'unlink', 'copyFile', 'rename', 'openSync',\n615:   ];\n616:   const calls = [];\n617:   const originals = new Map();\n618:   for (const name of watched) {\n619:     if (typeof fs[name] !== 'function') continue;\n620:     originals.set(name, fs[name]);\n621:     fs[name] = (...args) => {\n622:       calls.push(`${name}(${String(args[0])})`);\n623:       return originals.get(name).apply(fs, args);\n624:     };\n625:   }\n626: \n627:   let report = null;\n628:   try {\n629:     report = buildReport({ root: fixture.dir });\n630:   } finally {\n631:     for (const [name, original] of originals) fs[name] = original;\n632:   }\n633: \n634:   assert.deepEqual(calls, [], 'the run wrote nothing');\n635:   assert.equal(report.rows.length, ROWS.length, 'every row ran with the spy in place');\n636: });\n637: \n638: test('every fixture run leaves its tree byte-identical', (t) => {\n639:   for (const name of ['pure', 'adopted', 'stale', 'forked', 'foreign', 'claude-only', 'absent', 'shadowed-pin', 'over-budget']) {\n640:     const fixture = buildFixture(t, name);\n641:     const before = treeDigest(fixture.dir);\n642:     runCheck(['--root', fixture.dir, '--json']);\n643:     runCheck(['--root', fixture.dir]);\n644:     assert.equal(treeDigest(fixture.dir), before, `the ${name} fixture was not touched`);\n645:   }\n646: });\n647: \n648: // ─────────────────────────────────────────────────────────────────────────────\n649: // 10. REPORT SHAPE\n650: // ─────────────────────────────────────────────────────────────────────────────\n651: \n652: test('every row appears in the report, once, in order', (t) => {\n653:   const fixture = buildFixture(t, 'pure');\n654:   const run = runCheck(['--root', fixture.dir]);\n655:   const printed = run.out.split('\\n').map((line) => /^(A\\d+) /.exec(line)).filter(Boolean).map((hit) => hit[1]);\n656:   assert.deepEqual(printed, ROWS);\n657: \n658:   const report = buildReport({ root: fixture.dir });\n659:   assert.deepEqual(report.rows.map((row) => row.id), ROWS);\n660: });\n661: \n662: test('--json carries the same rows and the same state as the text form', (t) => {\n663:   const fixture = buildFixture(t, 'forked');\n664:   const text = runCheck(['--root', fixture.dir]);\n665:   const json = runJson(['--root', fixture.dir]);\n666: \n667:   assert.equal(json.code, text.code, 'the two forms agree on the exit code');\n668:   assert.equal(json.report.state, 'forked');\n669:   const fromText = textRowStates(text.out);\n670:   assert.deepEqual(Object.keys(fromText).sort(), ROWS.slice().sort());\n671:   for (const row of json.report.rows) {\n672:     assert.equal(row.state, fromText[row.id], `row ${row.id} reads the same in both forms`);\n673:   }\n674: });\n675: \n676: test('this repository reports STATUS=OK and a pure install state', () => {\n677:   const run = runCheck([]);\n678:   assert.equal(run.code, 0);\n679:   assert.match(run.out, /^STATUS=OK/m);\n680:   assert.match(run.out, /^A1 install state: pure/m);\n681: });\n682: \n683: test('A11 embeds the repo-rules checker\\'s own summary line instead of re-deriving it', () => {\n684:   const report = buildReport({ root: REPO_ROOT });\n685:   const row = report.rows.find((entry) => entry.id === 'A11');\n686:   assert.equal(row.state, 'PASS');\n687:   assert.match(row.detail, /\\[repo-rules-check\\] RESULT: PASSED \\(\\d+\\/\\d+ checks\\)/);\n688: });\n689: \n690: test('A12 reports INFO outside the source repository and runs inside it', (t) => {\n691:   const fixture = buildFixture(t, 'pure');\n692:   const outside = buildReport({ root: fixture.dir });\n693:   const row = outside.rows.find((entry) => entry.id === 'A12');\n694:   assert.equal(row.state, 'INFO');\n695:   assert.match(row.detail, /source repository/);\n696: \n697:   const inside = buildReport({ root: REPO_ROOT });\n698:   assert.equal(inside.rows.find((entry) => entry.id === 'A12').state, 'PASS');\n699: });\n700: \n701: test('a precondition failure exits 2 rather than printing an empty report', (t) => {\n702:   const fixture = buildFixture(t, 'pure');\n703:   const code = main(['--root', fixture.dir, '--manifest', path.join(fixture.dir, 'missing.json')]);\n704:   assert.equal(code, 2);\n705: });"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/commands/doctor/scripts/tests/agents-md-check.test.cjs\"}"},"time":{"start":1794559359212,"end":1794559359469}}}}
