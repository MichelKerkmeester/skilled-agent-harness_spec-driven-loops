 a/.skilled/commands/doctor/scripts/agents-md-check.cjs b/.skilled/commands/doctor/scripts/agents-md-check.cjs\nindex c2e4f5f357..87bbc48c7d 100644\n--- a/.skilled/commands/doctor/scripts/agents-md-check.cjs\n+++ b/.skilled/commands/doctor/scripts/agents-md-check.cjs\n@@ -635,7 +635,7 @@ function rowRuntimeCopies(context, manifest, tools) {\n \n   for (const expected of manifest.runtime_copies || []) {\n     const verdict = copyVerdict(expected, context, manifest, tools);\n-    entries.push({ path: expected.path, kind: verdict.kind, state: verdict.state, lines: verdict.lines || [] });\n+    entries.push({ path: expected.path, kind: verdict.kind, state: verdict.state, detail: verdict.detail, lines: verdict.lines || [] });\n     // A copy nobody could measure is printed like a finding: a pass line with no detail\n     // reads as a copy that was checked and found right.\n     if (verdict.state === FINDING || verdict.state === UNKNOWN || verdict.kind === 'pointer missing') {\n@@ -645,8 +645,11 @@ function rowRuntimeCopies(context, manifest, tools) {\n \n   const failed = entries.filter((entry) => entry.state === FINDING);\n   const unmeasured = entries.filter((entry) => entry.state === UNKNOWN);\n+  // A missing pointer is a route the runtime does not have, not a copy that was checked.\n+  const pointerMissing = entries.filter((entry) => entry.kind === 'pointer missing');\n+  const expected = entries.length - failed.length - unmeasured.length - pointerMissing.length;\n   const state = failed.length > 0 ? FINDING : (unmeasured.length > 0 ? UNKNOWN : PASS);\n-  const detail = `${entries.length - failed.length - unmeasured.length}/${entries.length} copies as expected${unmeasured.length > 0 ? `, ${unmeasured.length} unmeasured` : ''}`;\n+  const detail = `${expected}/${entries.length} copies as expected${unmeasured.length > 0 ? `, ${unmeasured.length} unmeasured` : ''}${pointerMissing.length > 0 ? `, ${pointerMissing.length} pointer missing` : ''}`;\n   return row('A10', 'runtime copies', state, detail, { lines, entries });\n }\n \n@@ -708,6 +711,11 @@ function copyVerdict(expected, context, manifest, tools) {\n \n   if (isSymlink(target)) {\n     const link = fs.readlinkSync(target);\n+    // A path the checklist expects to be absent is one no runtime should load, and a link\n+    // there loads the root document under that name just as a copy would.\n+    if (expectsAbsent) {\n+      return { state: FINDING, kind: 'symlink where none belongs', detail: `links to ${link}, where the checklist expects no file` };\n+    }\n     const pointsAtRoot = path.basename(link) === manifest.root_file;\n     if (pointsAtRoot) return { state: PASS, kind: 'symlink', detail: `links to ${link}` };\n     return { state: FINDING, kind: 'symlink elsewhere', detail: `links to ${link} instead of ${manifest.root_file}` };\n@@ -729,7 +737,7 @@ function copyVerdict(expected, context, manifest, tools) {\n   // else is either a copy or a copy plus local lines, and both drift: the second also\n   // loses text when it is replaced, so the lines only it carries are listed.\n   if (!sharesShippedLine && namesRoot) {\n-    return { state: PASS, kind: 'pointer', detail: `every line names ${manifest.root_file}` };\n+    return { state: PASS, kind: 'pointer', detail: `names ${manifest.root_file} and carries no shipped line` };\n   }\n   return { state: FINDING, kind: 'divergent copy', detail: `${unique.length} line(s) only this file carries`, lines: unique };\n }\n@@ -753,12 +761,19 @@ function rowRouter(context, manifest, tools) {\n \n   const text = fs.readFileSync(routerPath, 'utf8');\n   const shipped = (manifest.derived && manifest.derived.repo_rules) || { trigger_rows: [], index_rows: [] };\n-  const lines = [];\n-  const missing = [\n-    ...missingRows(shipped.trigger_rows, parseTableRows(text, 'TRIGGER TABLE'), 'trigger'),\n-    ...missingRows(shipped.index_rows, parseTableRows(text, 'INDEX'), 'index'),\n+  const tables = [\n+    { kind: 'trigger', rows: parseTableRows(text, 'TRIGGER TABLE'), shipped: shipped.trigger_rows },\n+    { kind: 'index', rows: parseTableRows(text, 'INDEX'), shipped: shipped.index_rows },\n   ];\n+  const lines = [];\n+  const missing = tables.flatMap((table) => missingRows(table.shipped, table.rows, table.kind));\n   for (const entry of missing) lines.push(`missing ${entry.kind} row for ${entry.rule}`);\n+  for (const table of tables) {\n+    for (const entry of table.rows) {\n+      if (!entry.malformed) continue;\n+      lines.push(`malformed ${table.kind} row at line ${entry.line}: ${entry.cells.length} cells where the header has ${entry.width}`);\n+    }\n+  }\n \n   if (typeof tools.repoRules !== 'string' || !fs.existsSync(tools.repoRules)) {\n     return row('A11', 'REPO RULES.md', UNKNOWN, 'present; the repo-rules checker is not installed',\n@@ -785,7 +800,9 @@ function rowRouter(context, manifest, tools) {\n }\n \n // The router's own table, read the same way the manifest's rows were derived. Comparing\n-// shipped rows to the file is the only way to say which of them a consumer dropped.\n+// shipped rows to the file is the only way to say which of them a consumer dropped, and a\n+// row of another width is kept so the report can name the defect instead of the rule it\n+// would otherwise read as missing.\n function parseTableRows(text, anchor) {\n   const lines = text.split('\\n');\n   const start = lines.findIndex((line) => line.startsWith('#') && line.includes(anchor));\n@@ -806,8 +823,7 @@ function parseTableRows(text, anchor) {\n       width = cells.length;\n       continue;\n     }\n-    if (cells.length !== width) continue;\n-    rows.push(cells);\n+    rows.push({ cells, line: index + 1, width, malformed: cells.length !== width });\n   }\n   return rows;\n }\n@@ -823,7 +839,7 @@ function rulePathOf(cells) {\n }\n \n function missingRows(shipped, present, kind) {\n-  const found = new Set(present.map((cells) => rulePathOf(cells) || cells.join(' | ')));\n+  const found = new Set(present.map((entry) => rulePathOf(entry.cells) || entry.cells.join(' | ')));\n   const missing = [];\n   for (const cells of shipped) {\n     const rule = rulePathOf(cells) || cells.join(' | ');\ndiff --git a/.skilled/commands/doctor/scripts/tests/agents-md-check.test.cjs b/.skilled/commands/doctor/scripts/tests/agents-md-check.test.cjs\nindex 46d73c4459..c102f5f92f 100644\n--- a/.skilled/commands/doctor/scripts/tests/agents-md-check.test.cjs\n+++ b/.skilled/commands/doctor/scripts/tests/agents-md-check.test.cjs\n@@ -140,6 +140,55 @@ function writeManifest(t, patch) {\n   return target;\n }\n \n+// The router a fixture case reads, built from the rows the manifest ships so the case\n+// stays a statement about the template and not a copy of it. A router whose trigger row\n+// or index row is absent would make A11 report a missing row rather than the shape a\n+// case plants, which is the one thing every router case below needs to keep apart.\n+function routerRow(cells) {\n+  return `| ${cells.join(' | ')} |`;\n+}\n+\n+function completeRouter() {\n+  const shipped = (manifest.derived && manifest.derived.repo_rules) || { trigger_rows: [], index_rows: [] };\n+  return [\n+    '# REPO RULES',\n+    '',\n+    '---',\n+    '',\n+    '## 1. HOW TO USE THIS',\n+    '',\n+    'Read the rule the action fires.',\n+    '',\n+    '---',\n+    '',\n+    '## 2. TRIGGER TABLE',\n+    '',\n+    routerRow(['You are about to…', 'Load', 'It settles']),\n+    '|---|---|---|',\n+    ...shipped.trigger_rows.map(routerRow),\n+    '',\n+    '---',\n+    '',\n+    '## 3. INDEX',\n+    '',\n+    routerRow(['Rule', 'Summary']),\n+    '|---|---|',\n+    ...shipped.index_rows.map(routerRow),\n+    '',\n+  ].join('\\n');\n+}\n+\n+// A checker stand-in that prints the one line A11 carries through. The cases below ask\n+// what the row says about the document it read, and a stub keeps the answer from\n+// depending on a rule corpus the fixture does not carry.\n+function writeRouterChecker(t) {\n+  const dir = fs.mkdtempSync(path.join(os.tmpdir(), 'agents-md-check-router-tool-'));\n+  t.after(() => fs.rmSync(dir, { recursive: true, force: true }));\n+  const target = path.join(dir, 'check-repo-rules.cjs');\n+  fs.writeFileSync(target, \"console.log('[repo-rules-check] RESULT: PASSED (11/11 checks)');\\n\", 'utf8');\n+  return target;\n+}\n+\n function treeDigest(dir) {\n   const hash = crypto.createHash('sha256');\n   for (const file of listFiles(dir).sort()) {\n@@ -475,6 +524,39 @@ test('A10 reports a pointer-only CLAUDE.md and an absent .codex/AGENTS.md withou\n   assert.equal(codex.state, 'PASS');\n });\n \n+// A pointer names the root document on one line and carries no shipped line of its own.\n+// Its other lines are prose the author wrote, so a verdict claiming every line names the\n+// root would describe a shape the file never had to hold.\n+test('A10 describes a pointer by what it does, not by what every line holds', (t) => {\n+  const fixture = buildFixture(t, 'pure');\n+  fs.writeFileSync(\n+    path.join(fixture.dir, 'CLAUDE.md'),\n+    '@AGENTS.md\\n\\nUse the house style.\\n',\n+    'utf8',\n+  );\n+  const report = buildReport({ root: fixture.dir });\n+\n+  const copies = report.rows.find((row) => row.id === 'A10');\n+  const claude = copies.entries.find((entry) => entry.path === 'CLAUDE.md');\n+  assert.equal(claude.kind, 'pointer');\n+  assert.equal(claude.detail, 'names AGENTS.md and carries no shipped line');\n+});\n+\n+// A path the checklist expects to be absent is one no runtime should load. A symlink is\n+// still a file at that path, so the root document reaches the runtime a second time under\n+// a name the checklist says nothing belongs at, which reads the same as a hand-kept copy.\n+test('a symlinked copy where the checklist expects no file is a finding', (t) => {\n+  const fixture = buildFixture(t, 'pure');\n+  fs.mkdirSync(path.join(fixture.dir, '.codex'));\n+  fs.symlinkSync('../AGENTS.md', path.join(fixture.dir, '.codex/AGENTS.md'));\n+\n+  const report = buildReport({ root: fixture.dir });\n+  const copies = report.rows.find((row) => row.id === 'A10');\n+  const codex = copies.entries.find((entry) => entry.path === '.codex/AGENTS.md');\n+  assert.equal(codex.state, 'FINDING', 'a link at an absent-only path is not a pass');\n+  assert.equal(codex.kind, 'symlink where none belongs');\n+});\n+\n // Claude Code reads only CLAUDE.md, so a tree without one leaves Claude with no route to\n // the root document. That is a missing route, not a copy that is wrong, so the row stays a\n // pass and the line still prints what Claude never loads.\n@@ -494,6 +576,23 @@ test('a pure tree with no CLAUDE.md reports a missing pointer and keeps A10 a pa\n     `the missing pointer is printed, not only recorded: ${JSON.stringify(copies.lines)}`);\n });\n \n+// A missing pointer is a route the runtime does not have, not a copy that was checked.\n+// Counting it among the copies as expected reports a full set from a tree that leaves\n+// Claude with no route to the root document, so the count leaves it out and names it after.\n+test('A10 leaves a missing pointer out of the count and names it after the copies', (t) => {\n+  const fixture = buildFixture(t, 'pure');\n+  assert.equal(fs.existsSync(path.join(fixture.dir, 'CLAUDE.md')), false, 'the composed template carries no CLAUDE.md');\n+  const mirrors = spawnSync(process.execPath, [POINTER_SYNC, '--root', fixture.dir], { encoding: 'utf8' });\n+  assert.equal(mirrors.status, 0, `the pointer sync completes the fixture's mirrors: ${mirrors.stderr}`);\n+\n+  const report = buildReport({ root: fixture.dir });\n+  const copies = report.rows.find((row) => row.id === 'A10');\n+  assert.ok(copies.detail.endsWith(', 1 pointer missing'),\n+    `the detail names the missing pointer after the count: ${copies.detail}`);\n+  assert.match(copies.detail, /^5\\/6 copies as expected/u,\n+    `the count leaves the CLAUDE.md entry out: ${copies.detail}`);\n+});\n+\n // A copy whose own tool is missing was not checked. Recorded only in the JSON entries, it\n // prints as a pass line with no detail and leaves the run reporting unknown=0.\n test('an unmeasured runtime copy makes A10 UNKNOWN and is counted in unknown=', (t) => {\n@@ -637,6 +736,32 @@ test('A11 embeds the repo-rules checker\\'s own summary line instead of re-derivi\n   assert.match(row.detail, /\\[repo-rules-check\\] RESULT: PASSED \\(\\d+\\/\\d+ checks\\)/);\n });\n \n+// A table row of another width is a defect in the document a reader has to be sent to,\n+// and the rule it names still arrives as a row. Dropping it above the row comparison\n+// reports the one thing the document does not have, a missing row, and hides the reason.\n+test('A11 reports a router row of the wrong width as malformed', (t) => {\n+  const fixture = buildFixture(t, 'pure');\n+  const router = completeRouter();\n+  const rows = router.split('\\n');\n+  const at = rows.findIndex((line) => line.startsWith('| Add a file, module, class'));\n+  assert.notEqual(at, -1, 'the shipped prevent-overengineering row is in the trigger table');\n+  const cells = rows[at].replace(/^\\|/u, '').replace(/\\|$/u, '').split('|').map((cell) => cell.trim());\n+  rows[at] = `| ${cells.slice(0, -1).join(' | ')} | a | b |`;\n+  fs.writeFileSync(path.join(fixture.dir, 'REPO RULES.md'), rows.join('\\n'), 'utf8');\n+\n+  const report = buildReport({\n+    root: fixture.dir,\n+    tools: { repoRules: writeRouterChecker(t) },\n+  });\n+  const routerRow = report.rows.find((entry) => entry.id === 'A11');\n+  assert.equal(routerRow.state, 'FINDING', `a malformed row is a finding: ${JSON.stringify(routerRow.lines)}`);\n+  const malformed = routerRow.lines.find((line) => line.startsWith('malformed trigger row at line '));\n+  assert.ok(malformed, `A11 names the malformed row: ${JSON.stringify(routerRow.lines)}`);\n+  assert.match(malformed, new RegExp(`^malformed trigger row at line ${at + 1}: 4 cells where the header has 3$`, 'u'));\n+  assert.ok(!routerRow.lines.some((line) => line.includes('missing trigger row for prevent-overengineering.md')),\n+    'the row still names its rule, so it is not reported missing');\n+});\n+\n test('A12 reports INFO outside the source repository and runs inside it', (t) => {\n   const fixture = buildFixture(t, 'pure');\n   const outside = buildReport({ root: fixture.dir });\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\": \"git -c core.fsmonitor=false status --short; echo '---'; git -c core.fsmonitor=false diff -- .skilled/commands/doctor/scripts/agents-md-check.cjs .skilled/commands/doctor/scripts/tests/agents-md-check.test.cjs\", \"workdir\": \"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research\"}"},"time":{"start":1794559690579,"end":1794559691658}}}}
