[];\n180: \n181:   const rows = [];\n182:   let headerWidth = 0;\n183:   for (let index = start + 1; index < lines.length; index += 1) {\n184:     const line = lines[index].trim();\n185:     if (line.startsWith('#')) break;\n186:     if (!line.startsWith('|')) {\n187:       // A blank line ends the table; prose after it belongs to the next block.\n188:       if (rows.length > 0 && line === '') break;\n189:       continue;\n190:     }\n191:     const cells = line.replace(/^\\|/u, '').replace(/\\|$/u, '').split('|').map((cell) => cell.trim());\n192:     if (cells.every((cell) => /^:?-+:?$/u.test(cell) || cell === '')) continue;\n193:     if (headerWidth === 0) {\n194:       headerWidth = cells.length;\n195:       continue;\n196:     }\n197:     if (cells.length !== headerWidth) continue;\n198:     rows.push(cells);\n199:   }\n200:   return rows;\n201: }\n202: \n203: /**\n204:  * The release-tag history of shipped bodies: every body the current document does not\n205:  * already hold, deduped by hash, in release order.\n206:  *\n207:  * @param {Array<{body: string, tag: string}>} entries\n208:  * @param {Set<string>} [known] - Hashes already accounted for.\n209:  * @returns {Array<{sha256: string, first_tag: string, body: string}>}\n210:  */\n211: function dedupeBodies(entries, known = new Set()) {\n212:   const seen = new Set(known);\n213:   const history = [];\n214:   for (const entry of entries) {\n215:     const hash = sha256(entry.body);\n216:     if (seen.has(hash)) continue;\n217:     seen.add(hash);\n218:     history.push({ sha256: hash, first_tag: entry.tag, body: entry.body });\n219:   }\n[Output truncated. Continue reading with offset: 220]","title":"read","metadata":{"metadata":{"truncated":true},"content":[{"type":"text","text":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/commands/doctor/scripts/agents-md-manifest.cjs, lines 150-219\n150:       ? `origin remote (unreadable under ${root})`\n151:       : `${current.source === 'env' ? 'CI repository' : 'origin remote'} ${identity}`;\n152:   }\n153: \n154:   const isSource = expected !== null && identity !== null && identity.toLowerCase() === expected.toLowerCase();\n155:   if (isSource) return { isSource: true, identity, origin, reason: '' };\n156: \n157:   return {\n158:     isSource: false,\n159:     identity,\n160:     origin,\n161:     reason: `the ${origin} differs from the source repository manifest.source_repository (${declared})`,\n162:   };\n163: }\n164: \n165: // ─────────────────────────────────────────────────────────────────────────────\n166: // 5. DERIVED KEY\n167: // ─────────────────────────────────────────────────────────────────────────────\n168: \n169: /**\n170:  * Split a router document into the rows of the two tables the manifest carries.\n171:  *\n172:  * @param {string} text - The router document.\n173:  * @param {string} anchor - Text that identifies the table's heading.\n174:  * @returns {Array<Array<string>>} One array of trimmed cells per data row.\n175:  */\n176: function parseTableRows(text, anchor) {\n177:   const lines = text.split('\\n');\n178:   const start = lines.findIndex((line) => line.startsWith('#') && line.includes(anchor));\n179:   if (start === -1) return [];\n180: \n181:   const rows = [];\n182:   let headerWidth = 0;\n183:   for (let index = start + 1; index < lines.length; index += 1) {\n184:     const line = lines[index].trim();\n185:     if (line.startsWith('#')) break;\n186:     if (!line.startsWith('|')) {\n187:       // A blank line ends the table; prose after it belongs to the next block.\n188:       if (rows.length > 0 && line === '') break;\n189:       continue;\n190:     }\n191:     const cells = line.replace(/^\\|/u, '').replace(/\\|$/u, '').split('|').map((cell) => cell.trim());\n192:     if (cells.every((cell) => /^:?-+:?$/u.test(cell) || cell === '')) continue;\n193:     if (headerWidth === 0) {\n194:       headerWidth = cells.length;\n195:       continue;\n196:   