e) => {\n751:      const first = manifest.runtimes[name][0];\n776:    detected_runtimes: context.detectedRuntimes,\n1391:    runtimes: options.runtimes,\n1466:    ...Object.values(manifest.runtimes).flat(),\n1798:        runtimes: options.runtimes,\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"69:    runtimes: null,\n99:    } else if (argument === '--runtimes' || argument.startsWith('--runtimes=')) {\n100:      const read = readValue(argv, index, '--runtimes');\n101:      options.runtimes = read.value.split(',').map((name) => name.trim()).filter(Boolean);\n102:      specified.add('runtimes');\n157:    check: ['root', 'source', 'runtimes', 'include', 'linkInstructions', 'json'],\n158:    plan: ['root', 'source', 'runtimes', 'include', 'linkInstructions', 'mode', 'ignore', 'json'],\n159:    apply: ['root', 'source', 'runtimes', 'include', 'linkInstructions', 'mode', 'ignore', 'planDigest', 'json'],\n230:    || !manifest.runtimes || !manifest.extras || !Array.isArray(manifest.instructions)) {\n236:    ...Object.values(manifest.runtimes),\n428:  const requestedRuntimes = csvValues(options.runtimes);\n429:  const runtimes = options.runtimes === null || options.runtimes === undefined\n430:    ? Object.keys(manifest.runtimes).filter((name) => {\n431:      const first = manifest.runtimes[name][0];\n435:  for (const runtime of runtimes) {\n436:    if (!Object.prototype.hasOwnProperty.call(manifest.runtimes, runtime)) {\n449:  for (const runtime of runtimes) {\n450:    for (const entry of manifest.runtimes[runtime]) selected.push({ entry, group: runtime });\n547:const UNMIRRORED_PATHS = new Set([path.join('.skilled', 'output'), path.join('.claude', 'worktrees')]);\n750:    detectedRuntimes: Object.keys(manifest.runtimes).filter((name) => {\n751:      const first = manifest.runtimes[name][0];\n776:    detected_runtimes: context.detectedRuntimes,\n1391:    runtimes: options.runtimes,\n1466:    ...Ob