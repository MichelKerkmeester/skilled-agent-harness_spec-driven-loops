st / debug ---\n# SYSTEM_SKILL_ADVISOR_HOOK_DISABLED=   # Disable the skill-advisor hook (alias of the kill-switch)\n# SYSTEM_SKILL_ADVISOR_DEBUG=           # Enable skill-advisor debug logging\n# SYSTEM_SKILL_ADVISOR_DB_DIR=          # Override the skill-advisor DB directory (auto)\n# SYSTEM_SKILL_ADVISOR_NODE_BINARY=     # Node binary for the skill-advisor daemon (auto)\n# SYSTEM_SKILL_ADVISOR_TRUST_DEFAULT=   # Daemon-side trust default (set \"trusted\" for no-_meta clients)\n# SYSTEM_SKILL_ADVISOR_STRICT_SINGLE_WRITER= # Strict single-writer enforcement for the advisor DB\n# SYSTEM_SKILL_ADVISOR_THRESHOLD_CONFIDENCE=0.8 # Advisor recommend confidence threshold\n# SKILL_ADVISOR_DEBUG=                  # Enable debug output in the skill_advisor.py CLI\n# SKILL_ADVISOR_DISABLE_BUILTIN_SEMANTIC= # Disable built-in semantic matching in the advisor script\n# SKILL_ADVISOR_FRESH_PROMPTS_PATH=    # Test-only path of the fresh behaviour rows the command transcript scorer labels (default: its own behaviour-fresh-prompts.jsonl)\n# (Aliases that route to the SYSTEM_* names above: SPECKIT_SKILL_ADVISOR_HOOK_DISABLED,\n#  SPECKIT_SKILL_ADVISOR_PLUGIN_DISABLED, SPECKIT_SKILL_ADVISOR_CLI_TRUSTED,\n#  SPECKIT_SKILL_ADVISOR_CLI_DEV_ALLOW_STALE.)\n\n# ══════════════════════════════════════════════════════════════\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"cd /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research && sed -n '400,416p' .env.example\"}"},"time":{"start":1794848229449,"end":1794848229943}}}}
