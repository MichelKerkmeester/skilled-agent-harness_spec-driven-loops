'export const TRACKED_COMMANDS')[1];\\nconst tracked=[...trackedBlock.matchAll(/^  '([^']+)': \\\\{ policy: '[^']+', ownerSkillId: '[^']+', scorerRow: (true|false) \\\\}/gm)].map(m=>[m[1],m[2]]);\\nconsole.log('COMMAND_ROWS',rows.length);\\nconsole.log('TRACKED',tracked.length);\\nconsole.log('scorerRow true',tracked.filter(x=>x[1]==='true').length);\\nconsole.log('scorerRow false',tracked.filter(x=>x[1]==='false').length);\\n\\\"\"}"},"time":{"start":1794847794137,"end":1794847797128}}}}
