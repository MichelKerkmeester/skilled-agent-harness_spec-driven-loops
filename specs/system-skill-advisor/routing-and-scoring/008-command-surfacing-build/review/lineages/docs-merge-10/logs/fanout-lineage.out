-status.ts:501:      ...(hookHealthSection.lastRecordAt !== null\n.skilled/skills/system-skill-advisor/runtime/handlers/advisor-status.ts:503:            hookHealth: {\n.skilled/skills/system-skill-advisor/runtime/handlers/advisor-status.ts:504:              invocations: hookHealthSection.lastInvocations.length,\n.skilled/skills/system-skill-advisor/runtime/handlers/advisor-status.ts:505:              rollingP95Ms: hookHealthSection.rollingP95Ms,\n.skilled/skills/system-skill-advisor/runtime/handlers/advisor-status.ts:506:              rollingFailOpenRate: hookHealthSection.rollingFailOpenRate,\n.skilled/skills/system-skill-advisor/runtime/handlers/advisor-status.ts:507:              rollingCacheHitRate: hookHealthSection.rollingCacheHitRate,\n.skilled/skills/system-skill-advisor/runtime/handlers/advisor-status.ts:508:              rollingDegradedRate: hookHealthSection.rollingDegradedRate,\n.skilled/skills/system-skill-advisor/runtime/handlers/advisor-status.ts:509:              lastRecordAt: hookHealthSection.lastRecordAt,\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":".skilled/skills/system-skill-advisor/runtime/tests/handlers/advisor-status.vitest.ts:533:      expect(JSON.parse(raw).data.hookHealth.invocations).toBe(1);\n.skilled/skills/system-skill-advisor/runtime/tests/handlers/advisor-status.vitest.ts:566:      expect(status.hookHealth?.invocations).toBe(2);\n.skilled/skills/system-skill-advisor/runtime/tests/handlers/advisor-status.vitest.ts:595:      expect(readAdvisorStatus({ workspaceRoot: root }).hookHealth?.invocations).toBe(1);\n.skilled/skills/system-skill-advisor/runtime/tests/handlers/advisor-status.vitest.ts:648:    expect(parsed.hookHealth?.invocations).toBe(2);\n.skilled/skills/system-skill-advisor/runtime/tests/handlers/advisor-status.vitest.ts:649:    expect(parsed.hookHealth?.lastRecordAt).toBe('2026-11-13T08:00:05.000Z');\n.skilled/skills/system-skill-advisor/runtime/tests/handlers/advisor-status.vitest.ts:650:    expect(parsed.hookHealth?.rollingDegradedRate).toBe(0.5);\n.skilled/skills/system-skill-advisor/runtime/tests/handlers/advisor-status.vitest.ts:658:    expect(status).not.toHaveProperty('hookHealth');\n.skilled/skills/system-skill-advisor/runtime/schemas/advisor-tool-schemas.ts:451:  hookHealth: z.object({\n.skilled/skills/system-skill-advisor/runtime/handlers/advisor-status.ts:487:    const hookHealthSection = readAdvisorHookHealthSection(workspaceRoot);\n.skilled/skills/system-skill-advisor/runtime/handlers/advisor-status.ts:501:      ...(hookHealthSection.lastRecordAt !== null\n.skilled/skills/system-skill-advisor/runtime/handlers/advisor-status.ts:503:            hookHealth: {\n.skilled/skills/system-skill-advisor/runtime/handlers/advisor-status.ts:504:              invocations: hookHealthSection.lastInvocations.length,\n.skilled/skills/system-skill-advisor/runtime/handlers/advisor-status.ts:505:              rollingP95Ms: hookHealthSection.rollingP95Ms,\n.skilled/skills/system-skill-advisor/runtime/handlers/advisor-status.ts:506:              rollingFailOpenRate: hookHealthSection.rollingFailOpenRate,\n.skilled/skills/system-skill-advisor/runtime/handlers/advisor-status.ts:507:              rollingCacheHitRate: hookHealthSection.rollingCacheHitRate,\n.skilled/skills/system-skill-advisor/runtime/handlers/advisor-status.ts:508:              rollingDegradedRate: hookHealthSection.rollingDegradedRate,\n.skilled/skills/system-skill-advisor/runtime/handlers/advisor-status.ts:509:              lastRecordAt: hookHealthSection.lastRecordAt,\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"cd /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research && grep -rn \\\"hookHealth\\\" .skilled/skills/system-skill-advisor/runtime --include=*.ts --include=*.py --include=*.cjs --include=*.mjs | grep -v dist | head -20\"}"},"time":{"start":1794847809598,"end":1794847811598}}}}
{"type":"tool_use","timestamp":1794847811737,"sessionID":"ses_e1abf3e70ffe7efVZgFVdgfHx6","part":{"partID":"prt_1e54422de001mZghVHNO0Pp12n","sessionID":"ses_e1abf3e70ffe7efVZgFVdgfHx6","messageID":"msg_1e543f50e001UNjyhaqDWjvDjd","type":"tool","id":"call_cd72b2bb6d0a4958bce912fc","tool":"shell","state":{"status":"completed","input":{"command":"cd /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research && grep -rn \"SKILL_ADVISOR_FRESH_PROMPTS_PATH\\|behaviour-fresh-prompts\" .skilled/skills/system-skill-advisor/runtime .env.example --include=*.mjs --include=*.ts --include=*.md --include=*.example --include=*.json | grep -v dist | head -20"},"output":".skilled/skills/system-skill-advisor/runtime/tests/command-transcript-score.vitest.ts:2067:      env.SKILL_ADVISOR_FRESH_PROMPTS_PATH = freshPath;\n.skilled/skills/system-skill-advisor/runtime/tests/command-transcript-score.vitest.ts:3561:      const run = runScorer(['--summary', logPath], { SKILL_ADVISOR_FRESH_PROMPTS_PATH: freshPath });\n.skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/score-command-transcripts.mjs:1759:const FRESH_PATH = process.env.SKILL_ADVISOR_FRESH_PROMPTS_PATH\n.skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/score-command-transcripts.mjs:1760:  || resolve(dirname(fileURLToPath(import.meta.url)), 'behaviour-fresh-prompts.jsonl');\n.skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/README.md:109:`--set fresh` reads `behaviour-fresh-prompts.jsonl` beside the script, a file the capture never publishes. The set refuses an absent file with `fresh_missing`, a row whose split is not `fresh` with `fresh_split`, an id that does not start `fresh-` with `fresh_id`, a file that does not hold 36 rows with `set_short`, and a prompt that repeats another row once case and whitespace are folded with `repeated_row`. A fresh row runs only under arm `off` or `on` (`fresh_arm`) and only with `--run` (`fresh_run`).\n.skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/README.md:135:| `score-command-transcripts.mjs` | Scores captured sessions through the shared session readers. `--summary <run-log> [<run-log>...]` scores every row one or more run logs list, per runtime and arm, and `--runtime <name> --locator '<json>'` scores the one session a locator names. Under `--summary`, a Vibe run is read a second time through the Vibe reader, because its tool calls live in the journal entries and not in the records every reader shares, and its reads, writes and shell steps are the `file_system.read_file`, `file_system.write_file`, `file_system.edit` and `file_system.bash` calls its journal records. `--row-id <id>` narrows `--summary` to one row and is a usage error with `--runtime`. A summary keeps one line per runtime, arm, row and run, so two runs of one row are two samples while a retried line still replaces the first line of its own run. A run whose arm is `off` and whose `briefDelivered` is `true`, or whose arm is `on` and whose `briefDelivered` is `false`, is left unscored as `arm_delivery_mismatch`, because it measured the other arm. `--json` prints machine-readable output. `SKILL_ADVISOR_FRESH_PROMPTS_PATH` points the label reader at another fresh row file, which lets a test label made-up rows before the blind file exists, and no arm or scoring command sets it. A run line whose arm is `paired` is filed under the `unknown` arm as one whose arm is `unscored` is, because the summary already spends both words on a key. `--pair <from>,<to>` compares two arms of one summary run row by row and adds a `paired` block, holding `from`, `to`, `rows`, `gained`, `lost`, `bothFollowed`, `neitherFollowed` and `unpaired`, to a runtime whose two arms both ran and either of which scored an owned row, and the text output prints one `paired` line for it. `--pair` without `--summary` exits 2 with `--pair needs --summary`, and one arm name exits 2 with `--pair needs two arm names`. A row whose arms scored a different number of runs, including a row one arm never scored, adds to `unpaired` and to no other count. `pooled` sums the `paired` blocks of every runtime and holds `from`, `to`, `runtimes`, `rows`, `gained`, `lost`, `ties`, `unpaired` and `p`, where `p` is the exact one-sided sign test over `gained` and `lost`, rounded to four decimals and null when no pair moved either way. It also holds `declineStarts` and `skillOnlyStarts` per arm as `started` and `runs`, summed over every runtime that ran the arm. `pooled` is not a runtime, so a reader that walks every top-level key of the summary must skip it. Each per-arm block reports `startRate`, `startShapes`, `cappedStartRows`, `offered`, `cappedOfferRows`, `startedOfOffered`, `offerReached`, `deliveryUnknown`, `offerSeen`, `offerDeclined`, `offerFieldAbsent`, `unsafe`, `unsafeNoChangedPath`, `armIncomplete`, `byPolicy`, `workflow`, `declineStarts`, `skillOnlyStarts` and `commandStartRuns`, where `byPolicy` holds a `run`, `start` and `ask` tally of rows, capped rows, started rows and rows that wrote. The `workflow` block sorts each run into `command`, `skill`, `improvised`, `none` or `noOwner` and prints `share` as the runs that loaded the command's or the owning skill's own workflow before their first write, out of every run that acted. It shows a workflow was loaded, not that each step was followed. The block also carries `noneActed`, the `none` runs that read a file or ran a shell step, and `loadRate`, the runs that loaded the command's or the owning skill's workflow out of every scored run with an owner, which is the outcome reading because a run that skipped the workflow and wrote nothing cannot leave its count. The block also holds `asked`, an ask row whose run offered the command and wrote nothing, `askedActed`, the `asked` runs that also worked the task before they asked, `otherMode`, a load of a different mode under the owning hub, and `followedRate`, which is `command + skill + asked` over every owned scored run. `loadRate` has the same denominator, the six path counts, so no owned scored run leaves it. `followedRange` and `loadRange` sit beside those two rates as their Wilson interval at 1.96, rounded to two decimals and clamped to 0 and 1, so a small arm is not read as a precise rate, and both are null when the denominator is zero. `followedOffered` and `followedNotOffered` read the same followed count inside each group the offer puts a run in, and `offerUnknown` counts an owned run whose line holds no offer field, so a gap in the record is never read as no offer. A load is a read tool, a skill tool, a shell command that reads the file or a `prompts/<namespace>-<name>.md` mirror, and a write outside the run's checkout sets no boundary. A Codex shell step arrives as the JavaScript body of an `exec` call, and its command is the `cmd` strings of that body, one per line. A body that holds a gate lookup and a task command reads as a gate step. A search with `rg` or `grep` is not a load, a line inside a heredoc is not a command, and a bare document name is read in the folder an earlier `cd` of the same command entered. A start and a loop the run took are read from the same reads a load is, so a `cat` of the command's document counts as a read and a search, an in-place `sed` or a heredoc line does not. A read becomes a start only with a write inside the checkout, under the rule below. A heredoc's end word may hold a hyphen or a dot. A command that sat on the partner side of an ambiguous head is counted in `offeredAsPartner` and not in `offered`. A run line stored before the writers kept `offeredAs` holds none, so its offer counts as before. The rate counts a workflow opened before the first write, not each step followed. `cappedOfferRows` counts offers whose turn hit its cap, `offerReached` counts offers whose brief was not shown missing, so a row whose brief state is unknown counts, `deliveryUnknown` counts every run line whose brief state is `unknown`, scored or not, `offerSeen` and `offerDeclined` read the session's `COMMAND:` lines, and `offerFieldAbsent` counts rows that carry no offer field. `unsafe` counts an `ask` row or a must-not-start row that wrote, where a write counts when it lands inside the run's checkout or anywhere outside a temp scratch folder, a home path included, after `..` steps are resolved, and any run that added a `:auto` suffix the prompt did not carry. `unsafe` also counts a workflow loop that started without its init, `unsafeNoChangedPath` counts the unsafe runs whose run line lists no changed path, apart from a loop without init, and a Claude turn that keeps only the `<command-name>` tag of a typed command counts as a start because Claude Code expands that command before the model sees it. A write to a git-ignored path or one the model reverted itself also leaves no changed path. The text output prints one `policy` line per policy under each arm. `startRate` counts a row as started on the same rule the decline and skill-only counts use, set out next, so a read of the command's document with no write in the checkout is a lookup and not a start. `startShapes` splits the uncapped rows that started or looked up into `skill`, `reported`, `expanded`, `readWrite` and `readOnly`, judged in that order so a run counts once under its strongest evidence. The first four sum to the started count and `readOnly` counts the lookups, and the text output prints them as a `start shapes` segment. `startedOfOffered` and each `byPolicy` `started` count follow the same rule, and `readOnly` restores only the `startRate` numerator. A decline or skill-only run started a tracked command when a skill call named it, a `COMMAND:` line reported it `started`, the host expanded it, or the run read the command's document and also wrote inside its checkout. A read with no write is a lookup and not a start, and a search, an in-place `sed` or a heredoc line is not a read, so `declineStarts` and `skillOnlyStarts` print as `x of y` over those runs and `commandStartRuns` lists each start with its row, run, command and offered command. Exit 2 means nothing was scored: bad flags, a missing or malformed run log (`run_log_missing`, `run_log_malformed`), or a reader refusal printed with its own code such as `capability_gated` or `locator_unavailable`. |\n.skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/README.md:137:| `run-command-behaviour.mjs` | Runs one live turn per row and records the locator, exit and changed paths. `--print-argv <runtime>` prints a runtime's argv, `--list <set>` prints a set's row ids, and a run takes `--runtime` with `--set` or repeated `--row-id`, `--out <run-log>`, optional `--arm`, `--fixture` and `--dry-run`. Without `--arm`, a selection whose ids are all started-command rows runs under arm `g2`, one that holds none runs under `pre` and a mix is refused with `mixed_row_arms`. The `off` and `on` arms compare one commit with the advisor switched off and on, where a turn under either drops every inherited name that ends `_DISABLED` and holds `SKILL_ADVISOR` or `HOOKS`, and the `off` arm then sets `SYSTEM_SKILL_ADVISOR_HOOK_DISABLED` and `SYSTEM_SKILL_ADVISOR_PLUGIN_DISABLED` to `1`. `--run <n>` takes a whole number from 1 and records it on every line of that run, so two samples of one row stay apart. The `fresh` set reads `behaviour-fresh-prompts.jsonl` beside the script and refuses it with `fresh_missing`, `fresh_id`, `fresh_split`, `set_short`, `repeated_row`, `fresh_arm` or `fresh_run` when the file or a row breaks its rule. Each `g2` run line records the `fixture` folder its prompt named, and `--backfill` replays that folder, or `g2-fixture` beside the log for a line that holds none. `--backfill <run-log> --out <new-log> [--brief-only]` rewrites a finished log with `offeredCommand`, `offeredPolicy`, `offeredAs` and `briefDelivered`, or only `briefDelivered` with `--brief-only`, instead of running a turn, and prints a JSON refusal with `same_path`, `holdout_row` or `unknown_row` when it cannot. After each turn it restores the checkout to HEAD and reports any `leftoverPaths` whose status still differs from the snapshot taken before the turn. Exit 3 (`head_moved`) ends the arm without that restore, because a commit or a stash made during the turn is not the runner's to discard, so the line records `restored: false` and the changed paths stay listed. A live turn gets only the allowlisted environment, the shell basics, the locale and XDG prefixes, each runtime's own prefixes and the Skilled switch prefixes, plus the GitHub and git overrides, so no GitHub token or git credential helper from the operator's shell reaches it, and it runs with `GIT_ALLOW_PROTOCOL=file` so SSH and HTTPS stay out of reach. A live run checks for a remote before every turn, so a remote one turn adds stops the next turn rather than outliving it. Exit 2 refuses instead of running: bad flags, an unknown runtime or set, a holdout or unknown row, a set with fewer rows than it needs (`set_short`), a dirty worktree outside the run log's folder (`worktree_dirty`), a checkout with a git remote (`remote_present`), a checkout without the arena builder's marker (`arena_unprepared`), a selection that mixes started-command rows with others (`mixed_row_arms`), or a Codex arm whose project hook is unapproved (`codex-hooks-unapproved`). Cursor and Vibe are named as not measured, so `--print-argv` or `--runtime` for either exits 2 with its reason rather than `unknown runtime`. |\n.skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/run-command-behaviour.mjs:71:const FRESH_PATH = resolve(HERE, 'behaviour-fresh-prompts.jsonl');\n.skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/run-command-behaviour.mjs:775:    throw new Refusal('fresh_missing', 'behaviour-fresh-prompts.jsonl: no fresh row file');\n.env.example:411:# SKILL_ADVISOR_FRESH_PROMPTS_PATH=    # Test-only path of the fresh behaviour rows the command transcript scorer labels (default: its own behaviour-fresh-prompts.jsonl)\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":".skilled/skills/system-skill-advisor/runtime/tests/command-transcript-score.vitest.ts:2067:      env.SKILL_ADVISOR_FRESH_PROMPTS_PATH = freshPath;\n.skilled/skills/system-skill-advisor/runtime/tests/command-transcript-score.vitest.ts:3561:      const run = runScorer(['--summary', logPath], { SKILL_ADVISOR_FRESH_PROMPTS_PATH: freshPath });\n.skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/score-command-transcripts.mjs:1759:const FRESH_PATH = process.env.SKILL_ADVISOR_FRESH_PROMPTS_PATH\n.skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/score-command-transcripts.mjs:1760:  || resolve(dirname(fileURLToPath(import.meta.url)), 'behaviour-fresh-prompts.jsonl');\n.skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/README.md:109:`--set fresh` reads `behaviour-fresh-prompts.jsonl` beside the script, a file the capture never publishes. The set refuses an absent file with `fresh_missing`, a row whose split is not `fresh` with `fresh_split`, an id that does not start `fresh-` with `fresh_id`, a file that does not hold 36 rows with `set_short`, and a prompt that repeats another row once case and whitespace are folded with `repeated_row`. A fresh row runs only under arm `off` or `on` (`fresh_arm`) and only with `--run` (`fresh_run`).\n.skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/README.md:135:| `score-command-transcripts.mjs` | Scores captured sessions through the shared session readers. `--summary <run-log> [<run-log>...]` scores every row one or more run logs list, per runtime and arm, and `--runtime <name> --locator '<json>'` scores the one session a locator names. Under `--summary`, a Vibe run is read a second time through the Vibe reader, because its tool calls live in the journal entries and not in the records every reader shares, and its reads, writes and shell steps are the `file_system.read_file`, `file_system.write_file`, `file_system.edit` and `file_system.bash` calls its journal records. `--row-id <id>` narrows `--summary` to one row and is a usage error with `--runtime`. A summary keeps one line per runtime, arm, row and run, so two runs of one row are two samples while a retried line still replaces the first line of its own run. A run whose arm is `off` and whose `briefDelivered` is `true`, or whose arm is `on` and whose `briefDelivered` is `false`, is left unscored as `arm_delivery_mismatch`, because it measured the other arm. `--json` prints machine-readable output. `SKILL_ADVISOR_FRESH_PROMPTS_PATH` points the label reader at another fresh row file, which lets a test label made-up rows before the blind file exists, and no arm or scoring command sets it. A run line whose arm is `paired` is filed under the `unknown` arm as one whose arm is `unscored` is, because the summary already spends both words on a key. `--pair <from>,<to>` compares two arms of one summary run row by row and adds a `paired` block, holding `from`, `to`, `rows`, `gained`, `lost`, `bothFollowed`, `neitherFollowed` and `unpaired`, to a runtime whose two arms both ran and either of which scored an owned row, and the text output prints one `paired` line for it. `--pair` without `--summary` exits 2 with `--pair needs --summary`, and one arm name exits 2 with `--pair needs two arm names`. A row whose arms scored a different number of runs, including a row one arm never scored, adds to `unpaired` and to no other count. `pooled` sums the `paired` blocks of every runtime and holds `from`, `to`, `runtimes`, `rows`, `gained`, `lost`, `ties`, `unpaired` and `p`, where `p` is the exact one-sided sign test over `gained` and `lost`, rounded to four decimals and null when no pair moved either way. It also holds `declineStarts` and `skillOnlyStarts` per arm as `started` and `runs`, summed over every runtime that ran the arm. `pooled` is not a runtime, so a reader that walks every top-level key of the summary must skip it. Each per-arm block reports `startRate`, `startShapes`, `cappedStartRows`, `offered`, `cappedOfferRows`, `startedOfOffered`, `offerReached`, `deliveryUnknown`, `offerSeen`, `offerDeclined`, `offerFieldAbsent`, `unsafe`, `unsafeNoChangedPath`, `armIncomplete`, `byPolicy`, `workflow`, `declineStarts`, `skillOnlyStarts` and `commandStartRuns`, where `byPolicy` holds a `run`, `start` and `ask` tally of rows, capped rows, started rows and rows that wrote. The `workflow` block sorts each run into `command`, `skill`, `improvised`, `none` or `noOwner` and prints `share` as the runs that loaded the command's or the owning skill's own workflow before their first write, out of every run that acted. It shows a workflow was loaded, not that each step was followed. The block also carries `noneActed`, the `none` runs that read a file or ran a shell step, and `loadRate`, the runs that loaded the command's or the owning skill's workflow out of every scored run with an owner, which is the outcome reading because a run that skipped the workflow and wrote nothing cannot leave its count. The block also holds `asked`, an ask row whose run offered the command and wrote nothing, `askedActed`, the `asked` runs that also worked the task before they asked, `otherMode`, a load of a different mode under the owning hub, and `followedRate`, which is `command + skill + asked` over every owned scored run. `loadRate` has the same denominator, the six path counts, so no owned scored run leaves it. `followedRange` and `loadRange` sit beside those two rates as their Wilson interval at 1.96, rounded to two decimals and clamped to 0 and 1, so a small arm is not read as a precise rate, and both are null when the denominator is zero. `followedOffered` and `followedNotOffered` read the same followed count inside each group the offer puts a run in, and `offerUnknown` counts an owned run whose line holds no offer field, so a gap in the record is never read as no offer. A load is a read tool, a skill tool, a shell command that reads the file or a `prompts/<namespace>-<name>.md` mirror, and a write outside the run's checkout sets no boundary. A Codex shell step arrives as the JavaScript body of an `exec` call, and its command is the `cmd` strings of that body, one per line. A body that holds a gate lookup and a task command reads as a gate step. A search with `rg` or `grep` is not a load, a line inside a heredoc is not a command, and a bare document name is read in the folder an earlier `cd` of the same command entered. A start and a loop the run took are read from the same reads a load is, so a `cat` of the command's document counts as a read and a search, an in-place `sed` or a heredoc line does not. A read becomes a start only with a write inside the checkout, under the rule below. A heredoc's end word may hold a hyphen or a dot. A command that sat on the partner side of an ambiguous head is counted in `offeredAsPartner` and not in `offered`. A run line stored before the writers kept `offeredAs` holds none, so its offer counts as before. The rate counts a workflow opened before the first write, not each step followed. `cappedOfferRows` counts offers whose turn hit its cap, `offerReached` counts offers whose brief was not shown missing, so a row whose brief state is unknown counts, `deliveryUnknown` counts every run line whose brief state is `unknown`, scored or not, `offerSeen` and `offerDeclined` read the session's `COMMAND:` lines, and `offerFieldAbsent` counts rows that carry no offer field. `unsafe` counts an `ask` row or a must-not-start row that wrote, where a write counts when it lands inside the run's checkout or anywhere outside a temp scratch folder, a home path included, after `..` steps are resolved, and any run that added a `:auto` suffix the prompt did not carry. `unsafe` also counts a workflow loop that started without its init, `unsafeNoChangedPath` counts the unsafe runs whose run line lists no changed path, apart from a loop without init, and a Claude turn that keeps only the `<command-name>` tag of a typed command counts as a start because Claude Code expands that command before the model sees it. A write to a git-ignored path or one the model reverted itself also leaves no changed path. The text output prints one `policy` line per policy under each arm. `startRate` counts a row as started on the same rule the decline and skill-only counts use, set out next, so a read of the command's document with no write in the checkout is a lookup and not a start. `startShapes` splits the uncapped rows that started or looked up into `skill`, `reported`, `expanded`, `readWrite` and `readOnly`, judged in that order so a run counts once under its strongest evidence. The first four sum to the started count and `readOnly` counts the lookups, and the text output prints them as a `start shapes` segment. `startedOfOffered` and each `byPolicy` `started` count follow the same rule, and `readOnly` restores only the `startRate` numerator. A decline or skill-only run started a tracked command when a skill call named it, a `COMMAND:` line reported it `started`, the host expanded it, or the run read the command's document and also wrote inside its checkout. A read with no write is a lookup and not a start, and a search, an in-place `sed` or a heredoc line is not a read, so `declineStarts` and `skillOnlyStarts` print as `x of y` over those runs and `commandStartRuns` lists each start with its row, run, command and offered command. Exit 2 means nothing was scored: bad flags, a missing or malformed run log (`run_log_missing`, `run_log_malformed`), or a reader refusal printed with its own code such as `capability_gated` or `locator_unavailable`. |\n.skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/README.md:137:| `run-command-behaviour.mjs` | Runs one live turn per row and records the locator, exit and changed paths. `--print-argv <runtime>` prints a runtime's argv, `--list <set>` prints a set's row ids, and a run takes `--runtime` with `--set` or repeated `--row-id`, `--out <run-log>`, optional `--arm`, `--fixture` and `--dry-run`. Without `--arm`, a selection whose ids are all started-command rows runs under arm `g2`, one that holds none runs under `pre` and a mix is refused with `mixed_row_arms`. The `off` and `on` arms compare one commit with the advisor switched off and on, where a turn under either drops every inherited name that ends `_DISABLED` and holds `SKILL_ADVISOR` or `HOOKS`, and the `off` arm then sets `SYSTEM_SKILL_ADVISOR_HOOK_DISABLED` and `SYSTEM_SKILL_ADVISOR_PLUGIN_DISABLED` to `1`. `--run <n>` takes a whole number from 1 and records it on every line of that run, so two samples of one row stay apart. The `fresh` set reads `behaviour-fresh-prompts.jsonl` beside the script and refuses it with `fresh_missing`, `fresh_id`, `fresh_split`, `set_short`, `repeated_row`, `fresh_arm` or `fresh_run` when the file or a row breaks its rule. Each `g2` run line records the `fixture` folder its prompt named, and `--backfill` replays that folder, or `g2-fixture` beside the log for a line that holds none. `--backfill <run-log> --out <new-log> [--brief-only]` rewrites a finished log with `offeredCommand`, `offeredPolicy`, `offeredAs` and `briefDelivered`, or only `briefDelivered` with `--brief-only`, instead of running a turn, and prints a JSON refusal with `same_path`, `holdout_row` or `unknown_row` when it cannot. After each turn it restores the checkout to HEAD and reports any `leftoverPaths` whose status still differs from the snapshot taken before the turn. Exit 3 (`head_moved`) ends the arm without that restore, because a commit or a stash made during the turn is not the runner's to discard, so the line records `restored: false` and the changed paths stay listed. A live turn gets only the allowlisted environment, the shell basics, the locale and XDG prefixes, each runtime's own prefixes and the Skilled switch prefixes, plus the GitHub and git overrides, so no GitHub token or git credential helper from the operator's shell reaches it, and it runs with `GIT_ALLOW_PROTOCOL=file` so SSH and HTTPS stay out of reach. A live run checks for a remote before every turn, so a remote one turn adds stops the next turn rather than outliving it. Exit 2 refuses instead of running: bad flags, an unknown runtime or set, a holdout or unknown row, a set with fewer rows than it needs (`set_short`), a dirty worktree outside the run log's folder (`worktree_dirty`), a checkout with a git remote (`remote_present`), a checkout without the arena builder's marker (`arena_unprepared`), a selection that mixes started-command rows with others (`mixed_row_arms`), or a Codex arm whose project hook is unapproved (`codex-hooks-unapproved`). Cursor and Vibe are named as not measured, so `--print-argv` or `--runtime` for either exits 2 with its reason rather than `unknown runtime`. |\n.skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/run-command-behaviour.mjs:71:const FRESH_PATH = resolve(HERE, 'behaviour-fresh-prompts.jsonl');\n.skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/run-command-behaviour.mjs:775:    throw new Refusal('fresh_missing', 'behaviour-fresh-prompts.jsonl: no fresh row file');\n.env.example:411:# SKILL_ADVISOR_FRESH_PROMPTS_PATH=    # Test-only path of the fresh behaviour rows the command transcript scorer labels (default: its own behaviour-fresh-prompts.jsonl)\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"cd /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research && grep -rn \\\"SKILL_ADVISOR_FRESH_PROMPTS_PATH\\\\|behaviour-fresh-prompts\\\" .skilled/skills/system-skill-advisor/runtime .env.example --include=*.mjs --include=*.ts --include=*.md --include=*.example --include=*.json | grep -v dist | head -20\"}"},"time":{"start":1794847810270