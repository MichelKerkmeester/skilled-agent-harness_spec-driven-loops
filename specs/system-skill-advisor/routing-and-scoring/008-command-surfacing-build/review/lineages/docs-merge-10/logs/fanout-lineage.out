 => keys[0]),\n354-  );\n355-  const identifiableFindingCount = countDistinctFindings(\n356-    identifiableFindingGroups.map((keys) => keys[0]),\n357-  );\n358-  // The root dashboard is a single-executor artifact. Fan-out stores one\n359-  // beside each lineage, so it is required only when the close reads the root log.\n360-  const missingArtifacts = [\n361-    ['registry', args.registry],\n362-    [mode, args.output],\n363-    ...(lineageLogs.length > 0 ? [] : [['dashboard', args.dashboard]]),\n364-  ].filter(([, filePath]) => !hasFile(filePath)).map(([name, filePath]) => ({ name, path: filePath }));\n365-\n366-  const invariantFailures = [];\n367-  if (missingArtifacts.length > 0) invariantFailures.push('missing_synthesis_artifacts');\n368-  if (stateParseFailureCount > 0) invariantFailures.push('state_jsonl_parse_failure');\n369-  if (evidence.registryFindingCount === null) invariantFailures.push(evidence.missingCode);\n370-  if (iterationFindingCount > 0 && (evidence.registryFindingCount ?? 0) === 0) {\n371-    invariantFailures.push('state_findings_not_reflected_in_registry');\n372-  }\n373-  if (\n374-    identifiableFindingCount > 0\n375-    && evidence.registryFindingCount !== null\n376-    && evidence.registryFindingCount < identifiableFindingCount\n377-  ) {\n378-    invariantFailures.push('structured_state_findings_partially_reflected_in_registry');\n379-  }\n380-  if (missingStructuredFindingCount > 0) {\n381-    invariantFailures.push('structured_state_findings_missing_from_registry');\n382-  }\n383-\n384-  const counts = {\n385-    totalIterations,\n386-    registryFindingCount: evidence.registryFindingCount,\n387-    iterationFindingCount,\n388-    identifiableFindingCount,\n389-    missingStructuredFindingCount,\n390-    stateParseFailureCount,\n391-    missingArtifacts,\n392-    invariantFailures,\n393-  };\n394-\n395-  if (mode === 'research') {\n396-    const countOnlyFindingCount = countOnlyFindings(stateRecords);\n397-    const sourceFindingCount = Number(registry?.metrics?.sourceFindings);\n398-    const reconstructionGapCount = Number(registry?.metrics?.reconstructionGaps);\n399-    if (\n400-      countOnlyFindingCount > 0\n401-      && (!Number.isFinite(sourceFindingCount) || sourceFindingCount < countOnlyFindingCount)\n402-    ) {\n403-      invariantFailures.push('count_only_state_findings_not_reconstructed');\n404-    }\n405-    if (Number.isFinite(reconstructionGapCount) && reconstructionGapCount > 0) {\n406-      invariantFailures.push('state_finding_reconstruction_gap');\n407-    }\n408-    const answeredCount = Number(args.answeredCount);\n409-    const totalQuestions = Number(args.totalQuestions);\n410-    if (invariantFailures.length > 0) {\n411-      stage(args.eventDir, scope, mode, {\n412-        event: 'synthesis_incomplete',\n413-        mode: 'research',\n414-        severity: 'error',\n415-        totalIterations: counts.totalIterations,\n416-        answeredCount,\n417-        totalQuestions,\n418-        stopReason: args.stopReason,\n419-        reason: 'synthesis_artifact_invariant_failed',\n420-        invariantFailures,\n421-        missingArtifacts,\n422-        registryFindingCount: counts.registryFindingCount,\n423-        iterationFindingCount,\n424-        countOnlyFindingCount,\n425-        identifiableFindingCount,\n426-        missingStructuredFindingCount,\n427-        sourceFindingCount: Number.isFinite(sourceFindingCount) ? sourceFindingCount : null,\n428-        reconstructionGapCount: Number.isFinite(reconstructionGapCount) ? reconstructionGapCount : null,\n429-        stateParseFailureCount,\n430-      });\n431-      // Research incompleteness is an error the workflow must surface.\n432-      process.exitCode = 2;\n433-      return;\n434-    }\n435-    stage(args.eventDir, scope, mode, {\n436-      event: 'synthesis_complete',\n437-      totalIterations: counts.totalIterations,\n438-      answeredCount,\n439-      totalQuestions,\n440-      stopReason: args.stopReason,\n441-    });\n442-    return;\n443-  }\n444-\n445-  const activeP0 = Number(args.activeP0);\n446-  const activeP1 = Number(args.activeP1);\n447-  const activeP2 = Number(args.activeP2);\n448-  // A fan-out root stages the merged lineage verdict, and no single registry\n449-  // holds its totals, so only a single-executor run can be cross-checked here.\n450-  if (lineageLogs.length === 0) {\n451-    assertActiveSeverityCounts(registry, { P0: activeP0, P1: activeP1, P2: activeP2 });\n452-  }\n453-  const dimensionCoverage = Number(args.dimensionCoverage);\n454-  if (invariantFailures.length > 0) {\n455-    stage(args.eventDir, scope, mode, {\n456-      event: 'synthesis_incomplete',\n457-      mode: 'review',\n458-      severity: 'warning',\n459-      totalIterations: counts.totalIterations,\n460-      activeP0,\n461-      activeP1,\n462-      activeP2,\n463-      dimensionCoverage,\n464-      verdict: args.verdict,\n465-      releaseReadinessState: args.releaseReadinessState,\n466-      stopReason: args.stopReason,\n467-      reason: 'synthesis_artifact_invariant_failed',\n468-      invariantFailures,\n469-      missingArtifacts,\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"329:function closeOut(args) {\n330-  const mode = args.mode;\n331-  const fields = FINDING_FIELDS[mode];\n332-  const scope = runScope(mode, args.stateLog);\n333-  const registry = readJson(args.registry);\n334-  const evidence = registryEvidence(mode, registry);\n335-  const lineageLogs = lineageStateLogs(args.artifactDir, mode);\n336-  const parsedState = (lineageLogs.length > 0 ? lineageLogs : [args.stateLog])\n337-    .map(readJsonl)\n338-    .map((entry) => ({ ...entry, records: latestIterationRecords(entry.records) }));\n339-  const stateRecords = parsedState.flatMap((entry) => entry.records);\n340-  const stateParseFailureCount = parsedState.reduce((sum, entry) => sum + entry.parseFailures, 0);\n341-  cons