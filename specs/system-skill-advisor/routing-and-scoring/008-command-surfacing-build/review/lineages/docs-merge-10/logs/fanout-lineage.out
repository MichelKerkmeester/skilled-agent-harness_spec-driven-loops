d.length} fit ids`).toEqual([]);\n315:   });\n316: \n317:   it('matches the captured totals', () => {\n318:     expect(live.metrics).toEqual(baseline.metrics);\n319:     expect(live.unreachable).toEqual(baseline.unreachable);\n320:     // `capturedAtSha` is deliberately not compared: it names the commit of the\n321:     // checkout that ran the capture, not anything the scorer decided.\n322:     expect(live.commands).toEqual(baseline.commands);\n323:     // The attached keys sit outside `metrics` and `commands` by design: they\n324:     // measure what a hub's own compiled route adds on the same rows, kept apart\n325:     // so the bridge numbers above cannot absorb a row the route reached.\n326:     expect(\n327:       live.attachedMetrics,\n328:       `command routing attached reach drifted from the committed baseline; re-capture with \\`${RECAPTURE}\\` when the change is intended`,\n329:     ).toEqual(baseline.attachedMetrics);\n330:   });\n331: \n332:   it('pins the corpus the baseline was captured against', () => {\n333:     // Row comparison can only catch a prompt that stopped routing as expected.\n334:     // The corpus hash catches the other direction: an edited, added or removed\n335:     // prompt that leaves every surviving row untouched.\n336:     expect(live.corpusSha256).toBe(baseline.corpusSha256);\n337:   });\n338: \n339:   it('has a typed row and both plain splits for every command file', () => {\n340:     // A command with an empty split carries no evidence either way, so its\n341:     // recall reads as a pass while the corpus never exercised it.\n342:     const uncovered = Object.keys(live.commands).filter((command) => {\n343:       const tally = live.commands[command];\n344:       return tally.typed.rows < 1 || tally.plain.tune.rows < 1 || tally.plain.holdout.rows < 1;\n345:     });\n346:     expect(uncovered).toEqual([]);\n347:   });\n348: });\n349: \n350: describe('host capture selection', () => {\n351:   let dir = '';\n352:   let upstream = 