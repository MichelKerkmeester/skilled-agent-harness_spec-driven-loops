);\nconsole.log('report chars', rep.length, 'headings', (rep.match(/^## /gm)||[]).length);\nconsole.log('report has all sections', ['Executive Summary','Planning Trigger','Active Finding Registry','Remediation Workstreams','Spec Seed','Plan Seed','Traceability Status','Deferred Items','Dimension Expansion Map','Search Ledger','Audit Appendix'].every(h=>rep.includes('## '+h)));\nconsole.log('dashboard exists', fs.existsSync(`${dir}/deep-review-dashboard.md`), 'strategy exists', fs.existsSync(`${dir}/deep-review-strategy.md`));\nNODE"},"output":"state rows 14\n{\n  config: 1,\n  iteration: 5,\n  'event:graph_convergence': 4,\n  'event:stuckRecovery': 1,\n  'event:terminal_gates': 1,\n  'event:claim_adjudication': 1,\n  'event:synthesis_complete': 1\n}\niteration numbers 1,2,3,4,5\nregistry 5 {\"P0\":0,\"P1\":1,\"P2\":4}\nopen ids undefined:P1,undefined:P2,undefined:P2,undefined:P2,undefined:P2\nconfig status complete\nit1 final \"Review verdict: CONDITIONAL\"\nit2 final \"Review verdict: CONDITIONAL\"\nit3 final \"Review verdict: CONDITIONAL\"\nit4 final \"Review verdict: CONDITIONAL\"\nit5 final \"Review verdict: CONDITIONAL\"\ndelta1 iteration 1 10 lines\ndelta2 iteration 2 6 lines\ndelta3 iteration 3 6 lines\ndelta4 iteration 4 5 lines\ndelta5 iteration 5 4 lines\nreport chars 12173 headings 11\nreport has all sections false\ndashboard exists true strategy exists true\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"state rows 14\n{\n  config: 1,\n  iteration: 5,\n  'event:graph_convergence': 4,\n  'event:stuckRecovery': 1,\n  'event:terminal_gates': 1,\n  'event:claim_adjudication': 1,\n  'event:synthesis_complete': 1\n}\niteration numbers 1,2,3,4,5\nregistry 5 {\"P0\":0,\"P1\":1,\"P2\":4}\nopen ids undefined:P1,undefined:P2,undefined:P2,undefined:P2,undefined:P2\nconfig status complete\nit1 final \"Review verdict: CONDITIONAL\"\nit2 final \"Review verdict: CONDITIONAL\"\nit3 final \"Revi