h no embedder and no stored vectors', () => {\n  it('passes a command only on its own authored phrase', () => {\n    const workspaceRoot = findAdvisorWorkspaceRoot(import.meta.dirname);\n    const prompts = [\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"cd /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research && sed -n '420,485p' .skilled/skills/system-skill-advisor/runtime/tests/command-meaning-anchor.vitest.ts\"}"},"time":{"start":1794847860908,"end":1794847861503}}}}
