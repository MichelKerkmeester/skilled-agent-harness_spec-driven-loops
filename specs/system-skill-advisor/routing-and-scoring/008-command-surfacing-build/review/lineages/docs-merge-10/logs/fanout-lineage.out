:s.decision,stopReason:s.stopReason,reasonDetail:s.reasonDetail,blockedBy:s.blockedBy,score:s.weightedStopScore,signals:s.signals,gates:s.gates,loop:j.loop_counters_json},null,1))\\n\\\"\"}"},"time":{"start":1794849191983,"end":1794849192970}}}}
