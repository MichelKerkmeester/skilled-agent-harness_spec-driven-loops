{"type":"tool_use","timestamp":1794550672875,"sessionID":"ses_e2c7999e1ffeYcD6BDSYeMhQPJ","part":{"partID":"prt_1d38e13d5001DpoAjHgSfuXWfE","sessionID":"ses_e2c7999e1ffeYcD6BDSYeMhQPJ","messageID":"msg_1d38e0ce5001ElN6jvBfV5iyF0","type":"tool","id":"call_fbaa729f217940f89dba02a3","tool":"shell","state":{"status":"completed","input":{"command":"cd /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research; node -e '\nconst fs=require(\"fs\");\nconst reg=JSON.parse(fs.readFileSync(\".skilled/skills/sk-doc/mode-registry.json\",\"utf8\"));\nconst ts=fs.readFileSync(\".skilled/skills/system-skill-advisor/runtime/lib/command-attach.ts\",\"utf8\");\nconst block=ts.split(\"export const MODE_COMMANDS\")[1].split(\"// END GENERATED MODE COMMANDS\")[0];\nconst table={};\nlet cur=null;\nfor(const line of block.split(\"\\n\")){\n  let m=line.match(/^\\s*\\x27([^\\x27]+)\\x27:\\s*\\{/); if(m){cur=m[1];table[cur]={};continue;}\n  m=line.match(/^\\s*\\x27([^\\x27]+)\\x27:\\s*\\x27([^\\x27]+)\\x27,?$/); if(m&&cur){table[cur][m[1]]=m[2];}\n}\nconsole.log(\"table hubs:\", JSON.stringify(Object.fromEntries(Object.entries(table).map(([k,v])=>[k,Object.keys(v).length]))));\nfor(const [hub,modes] of Object.entries({ \"sk-doc\": reg.modes, \"system-deep-loop\": JSON.parse(fs.readFileSync(\".skilled/skills/system-deep-loop/hub-router.json\",\"utf8\")).modes, \"sk-design\": JSON.parse(fs.readFileSync(\".skilled/skills/sk-design/command-metadata.json\",\"utf8\")) })){\n  if(!modes) continue;\n  const entries = Array.isArray(modes)?modes:Object.values(modes);\n  const withCmd=[];\n  for(const e of entries){ if(e && typeof e===\"object\"){ const wm=e.workflowMode||e.mode||e.id; const c=e.command; if(wm&&c) withCmd.push([wm,c]); } }\n  const missing=withCmd.filter(([wm])=>!(table[hub]&&table[hub][wm]));\n  const extra=Object.keys(table[hub]||{}).filter(wm=>!withCmd.some(([w])=>w===wm));\n  console.log(`--- ${hub}: registry modes with command=${withCmd.length}; missing from MODE_COMMANDS=${missing.length}`, JSON.stringify(missing).slice(0,300), \"extra:\", JSON.stringify(extra).slice(0,200));\n}\n' 2>&1"},"output":"table hubs: {\"sk-design\":3,\"sk-doc\":13,\"system-deep-loop\":3}\n--- sk-doc: registry modes with command=13; missing from MODE_COMMANDS=0 [] extra: []\n--- sk-design: registry modes with command=0; missing from MODE_COMMANDS=0 [] extra: [\"sk-design-chart\",\"sk-design-diagram\",\"sk-design-md-generator\"]\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"table hubs: {\"sk-design\":3,\"sk-doc\":13,\"system-deep-loop\":3}\n--- sk-doc: registry modes with command=13; missing from MODE_COMMANDS=0 [] extra: []\n--- sk-design: registry modes with command=0; missing from MODE_COMMANDS=0 [] extra: [\"sk-design-chart\",\"sk-design-diagram\",\"sk-design-md-generator\"]\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"cd /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research; node -e '\\nconst fs=require(\\\"fs\\\");\\nconst reg=JSON.parse(fs.readFileSync(\\\".skilled/skills/sk-doc/mode-registry.json\\\",\\\"utf8\\\"));\\nconst ts=fs.readFileSync(\\\".skilled/skills/system-skill-advisor/runtime/lib/command-attach.ts\\\",\\\"utf8\\\");\\nconst block=ts.split(\\\"export const MODE_COMMANDS\\\")[1].split(\\\"// END GENERATED MODE COMMANDS\\\")[0];\\nconst table={};\\nlet cur=null;\\nfor(const line of block.split(\\\"\\\\n\\\")){\\n  let m=line.match(/^\\\\s*\\\\x27([^\\\\x27]+)\\\\x27:\\\\s*\\\\{/); if(m){cur=m[1];table[cur]={};continue;}\\n  m=line.match(/^\\\\s*\\\\x27([^\\\\x27]+)\\\\x27:\\\\s*\\\\x27([^\\\\x27]+)\\\\x27,?$/); if(m&&cur){table[cur][m[1]]=m[2];}\\n}\\nconsole.log(\\\"table hubs:\\\", JSON.stringify(Object.fromEntries(Object.entries(table).map(([k,v])=>[k,Object.keys(v).length]))));\\nfor(const [hub,modes] of Object.entries({ \\\"sk-doc\\\": reg.modes, \\\"system-deep-loop\\\": JSON.parse(fs.readFileSync(\\\".skilled/skills/system-deep-loop/hub-router.json\\\",\\\"utf8\\\")).modes, \\\"sk-design\\\": JSON.parse(fs.readFileSync(\\\".skilled/skills/sk-design/command-metadata.json\\\",\\\"utf8\\\")) })){\\n  if(!modes) continue;\\n  const entries = Array.isArray(modes)?modes:Object.values(modes);\\n  const withCmd=[];\\n  for(const e of entries){ if(e && typeof e===\\\"object\\\"){ const wm=e.workflowMode||e.mode||e.id; const c=e.command; if(wm&&c) withCmd.push([wm,c]); } }\\n  const missing=withCmd.filter(([wm])=>!(table[hub]&&table[hub][wm]));\\n  const extra=Object.keys(table[hub]||{}).filter(wm=>!withCmd.some(([w])=>w===wm));\\n  console.log(`--- ${hub}: registry modes with command=${withCmd.length}; missing from MODE_COMMANDS=${missing.length}`, JSON.stringify(missing).slice(0,300), \\\"extra:\\\", JSON.stringify(extra).slice(0,200));\\n}\\n' 2>&1\"}"},"time":{"start":1794550666197,"end":1794550672875}}}}
{"type":"step_finish","timestamp":1794550673971,"sessionID":"ses_e2c7999e1ffeYcD6BDSYeMhQPJ","part":{"id":"prt_1d38e3233001tZaCxdInSeHZoC","sessionID":"ses_e2c7999e1ffeYcD6BDSYeMhQPJ","messageID":"msg_1d38e0ce5001ElN6jvBfV5iyF0","type":"step-finish","reason":"tool-calls","snapshot":"c7414586fe02d7fff8eb5d934ac62f1d6e1145c4","cost":0,"tokens":{"input":1230,"output":594,"reasoning":0,"cache":{"read":116224,"write":0}}}}
{"type":"step_start","timestamp":1794550678805,"sessionID":"ses_e2c7999e1ffeYcD6BDSYeMhQPJ","part":{"id":"prt_1d38e451500195uns8NrLz3H2C","sessionID":"ses_e2c7999e1ffeYcD6BDSYeMhQPJ","messageID":"msg_1d38e3239001aaZPs7xZPYpkIA","type":"step-start","snapshot":"c7414586fe02d7fff8eb5d934ac62f1d6e1145c4"}}
{"type":"tool_use","timestamp":1794550682082,"sessionID":"ses_e2c7999e1ffeYcD6BDSYeMhQPJ","part":{"partID":"prt_1d38e50c9001412yxL220mKbTU","sessionID":"ses_e2c7999e1ffeYcD6BDSYeMhQPJ","messageID":"msg_1d38e3239001aaZPs7xZPYpkIA","type":"tool","id":"call_46a8dd383f9d464f9194eb5f","tool":"read","state":{"status":"completed","input":{"path":".skilled/skills/system-skill-advisor/runtime/scripts/command-bridges/README.md"},"output":"Read file .skilled/skills/system-skill-advisor/runtime/scripts/command-bridges/README.md, lines 1-134\n1: ---\n2: title: \"Command bridges\"\n3: description: \"Authored command-bridge inputs, compatibility evidence and the generated projection consumed by advisor scoring surfaces.\"\n4: trigger_phrases:\n5:   - \"command bridges\"\n6:   - \"generated command bridge projection\"\n7:   - \"command bridge compatibility\"\n8: ---\n9: \n10: # Command bridges\n11: \n12: ---\n13: \n14: ## 1. OVERVIEW\n15: \n16: `command-bridges/` is the source boundary for command metadata that is not yet represented uniformly by every scoring surface. The deriver combines live skill metadata with the authored compatibility inputs and writes the generated JSON projection.\n17: \n18: The doctor commands are a third source: the deriver reads `.skilled/commands/doctor/_routes.yaml` and writes one bridge per doctor route and per standalone doctor command and per MCP sub-route.\n19: \n20: Each hub's `mode-registry.json` is a fourth source: the deriver reads the `command` of every mode and writes the `MODE_COMMANDS` table the advisor uses to attach a slash command to a hub recommendation.\n21: \n22: ---\n23: \n24: ## 2. CONTENTS\n25: \n26: | File | Responsibility | Authority |\n27: |---|---|---|\n28: | `command-bridges.generated.json` | Stores the derived command-bridge projection. | Generated, do not edit |\n29: | `derive-command-bridges.cjs` | Reads live metadata and authored inputs, validates uniqueness and writes the projection. | Authored deriver |\n30: | `scoring-compatibility.json` | Holds TypeScript and Python scoring compatibility mappings. | Authored input |\n31: | `shadow-diff.md` | Records comparison evidence between generated and live bridge authorities. | Authored evidence |\n32: \n33: ---\n34: \n35: ## 3. DERIVATION FLOW\n36: \n37: ```text\n38: skill command metadata files\n39: scoring-compatibility.json\n40: .skilled/commands/doctor/_routes.yaml\n41: hub mode-registry.json files\n42:                          |\n43:                          v\n44:               derive-command-bridges.cjs\n45:                          |\n46:                          v\n47:               command-bridges.generated.json\n48: ```\n49: \n50: The deriver also updates generated projection blocks in the live TypeScript and Python scoring sources. Its `GENERATED COMMAND ROWS` block in `lib/command-attach.ts` holds `COMMAND_ROWS`, one row per id a scorer can return for an enabled entry, covering the entry id and every enabled runtime id. Each row carries the runnable slash command, its derived policy and the owning skill. The same block holds `COMMAND_POLICIES`, one policy per runnable string, so a surface that attaches a command can name its policy without a second lookup. It writes the `MODE_COMMANDS` block into the same file, one row per hub mode that names a command, and fails when a mode names a command with no file under `.skilled/commands/`. The same block also holds `TRACKED_COMMANDS`, one row per tracked command keyed by its runnable string, emitted for every bridge entry whether or not the bridge is active. Each TypeScript bridge in `lib/scorer/projection.ts` carries an `ownerSkill`, the skill that owns its command. The generated JSON and generated source blocks are outputs, not hand-edited inputs.\n51: \n52: Every tracked row carries the command's derived policy, the skill that owns it and `scorerRow`, which is true when the TypeScript scorer has a row for that entry. A typed command therefore always has a policy and an owner to deliver, even where no scorer row exists.\n53: \n54: Each bridge row with TypeScript enabled also carries an `embeddingText`, the plain sentence a scoring vector is built from. A Python-only row carries none. A metadata row leads with its `userIntent.job` sentence and adds every `userIntent.ownedSignals` phrase, because both are written in the asker's voice. The entry `description` stands in for the job only when the record states no job. A doctor row builds it from the router frontmatter `description` and the `trigger_phrases` of the route. The deriver drops each slash command string before the parts are joined, because a name left in would hand the scorer a second copy of the token it already matches literally. The field is derived on every run and never authored, so edit the sources rather than the JSON.\n55: \n56: ---\n57: \n58: ## 4. DOCTOR BRIDGES\n59: \n60: Ids are `command-doctor-<command>-<target>` when the doctor command owns more than one route, and `command-doctor-<command>` otherwise. `skillId` and `ownerMode` come from the router's `skill_agent` tag. A router without the tag fails the deriver with a named error.\n61: \n62: The runnable string is the command plus its target when the command owns more than one route. A standalone entry may set `runnable`, as `/doctor:env` does with `/doctor:env list`.\n63: \n64: A new route needs a hand-written entry in both the `typescript` and `python` lists in `scoring-compatibility.json`. Each entry carries only `inventoryId`, `order`, `id` (equal to `inventoryId`) and an empty `description`.\n65: \n66: The deriver fills the TypeScript name, keywords, intent signals and domains from the manifest, and the Python slash marker from the runnable string. A route marked `default_target` in `_routes.yaml` also gets the bare command (for example `/doctor:ci`) as a TypeScript keyword and a Python slash marker, so the bare typed command reaches it. A typed `<command> <target>` names that target, so the bare command inside it does not also match the default target. Python matches a doctor bridge only on a typed slash command.\n67: \n68: A doctor bridge passes on its own wording (an explicit-author phrase match). When none passes and no `/doctor:` command was typed, the scorer asks `/doctor:helper`'s own ranker, `doctor-helper-match.cjs`, whether the prompt describes a doctor problem. If it does, `command-doctor-helper` passes, and `/doctor:helper` then names the command. With no skill passing, a ranker score of 10 or more is enough, or 6 or more when the prompt names a problem. Beside a passing skill, the prompt must name a wrong state or a health check, such as `is not registered`, `never converges` or `turn off`. A `/doctor:` command counts as typed when the prompt starts with `/doctor:` or when it directly follows `run`, `execute`, `start`, `launch`, `use` or `kick off` outside quotes and backticks. A quoted command or a bare mid-sentence mention does not count. A typed command puts its own passing bridge first. A prompt that contains one of a bridge's `lead_phrases` also puts that passing bridge first, so `check my environment variables` leads with `/doctor:env`. For other prompts, a passing skill keeps first place and passing doctor bridges sit right after the second passing skill or the only passing skill. This keeps a doctor line within the CLI's three shown results. A typed command shows its matching runnable string on the top line. A skill-first brief shows `Also: /doctor:<command> <target>` on the second line. The Python fallback matches a doctor bridge only on a typed slash command.\n69: \n70: Each `mcp_subroutes` entry becomes the bridge `command-doctor-mcp-<sub_action>`, with the runnable string `/doctor:mcp <sub_action>` and its owner from the `skill_agent` tag in `mcp.md`. Every derived doctor bridge is active in both scorers, and `doctor-phrase-reach.cjs` proves each one.\n71: \n72: Check every admitted phrase with `node .skilled/commands/doctor/scripts/doctor-phrase-reach.cjs`.\n73: \n74: Every command bridge, not only a doctor bridge, passes on its own wording. `requireCommandPhraseAnchor` in `lib/scorer/fusion.ts` drops a passing command row below threshold unless the explicit-author lane matched one of its phrases or its slash string. The one other way in is meaning: a real embedder cosine of at least 0.72 against the row's `embeddingText` vector, with a 0.02 lead over the next command row. That needs the local embedder, so without it every command row passes on its wording alone. A prompt that asks for no change rules out every command on meaning, and a read-only question admits only a bridge marked `readOnly`.\n75: \n76: ---\n77: \n78: ## 5. STANDALONE SKILL COMMANDS\n79: \n80: A standalone skill has a `command-metadata.json` and no `mode-registry.json`, as `sk-prompt` and `system-spec-kit` do. Its commands are active in both scorers by construction and need no row in `scoring-compatibility.json`. The deriver builds each row from the metadata entry:\n81: \n82: - TypeScript: the `userIntent.ownedSignals` phrases become the keywords and intent signals, the command's namespace and `command` become the domains, and a `read-only` `mutating` class sets `readOnly: true`.\n83: - Python: the slash markers are the command with and without its leading slash, and `owningSkill` is the skill.\n84: \n85: A command needs at least two `userIntent.ownedSignals`, or the deriver fails. A hand row in `scoring-compatibility.json` still wins where one exists. Generated rows take orders after the highest hand-written order.\n86: \n87: ---\n88: \n89: ## 6. HUMAN EDIT BOUNDARY\n90: \n91: Humans may edit `derive-command-bridges.cjs`, `scoring-compatibility.json` and `shadow-diff.md`. Regenerate `command-bridges.generated.json` after changing an authored input or the deriver. Do not edit the generated JSON directly.\n92: \n93: ---\n94: \n95: ## 7. VALIDATION\n96: \n97: Run the deriver in check mode from the repository root:\n98: \n99: ```bash\n100: node .skilled/skills/system-skill-advisor/runtime/scripts/command-bridges/derive-command-bridges.cjs --check\n101: ```\n102: \n103: ---\n104: \n105: ## 8. RISK KEYS AND COMMAND POLICY\n106: \n107: The command tree `.skilled/commands/<namespace>/<name>.md` owns which commands exist. The deriver fails when a command file has no `command-metadata.json` entry and no doctor route. It fails again when a declaration names a command with no file.\n108: \n109: A `command-metadata.json` entry and a doctor route or action carry the same risk keys. A value outside the accepted set fails the deriver before any policy is derived.\n110: \n111: | Risk key | Accepted values | Applies to |\n112: |---|---|---|\n113: | `mutating` | `read-only`, `add-only`, `mutates` | Every metadata entry and every doctor route or action |\n114: | `gate3_location` | A non-empty string naming what the command writes | Required on every metadata entry |\n115: | `ask_first` | `settings`, `outside-repo`, `spend`, `relaunch` | Optional on both records |\n116: | `write_scope` | `spec-folder` | Optional on both records |\n117: \n118: `derivePolicy` reads those keys in order and stops at the first match.\n119: \n120: | Step | Condition | Policy |\n121: |---|---|---|\n122: | 1 | `ask_first` lists at least one reason | `ask` |\n123: | 2 | A doctor route or action classed `mutates` | `ask` |\n124: | 3 | `mutating` is `read-only` | `run` |\n125: | 4 | `mutating` is `add-only` with `write_scope` set to `spec-folder` | `run` |\n126: | 5 | Any other record | `start` |\n127: \n128: `commandPolicies` in `command-bridges.generated.json` holds one record per command, or one record per route or action for a doctor command. Each record carries five keys: `command`, `route`, `mutating`, `askFirst`, `policy`. Nothing scores on it yet.\n129: \n130: ---\n131: \n132: ## 9. RELATED\n133: \n134: - [`Skill-advisor scripts`](../README.md)","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file .skilled/skills/system-skill-advisor/runtime/scripts/command-bridges/README.md, lines 1-134\n1: ---\n2: title: \"Command bridges\"\n3: description: \"Authored command-bridge inputs, compatibility evidence and the generated projection consumed by advisor scoring surfaces.\"\n4: trigger_phrases:\n5:   - \"command bridges\"\n6:   - \"generated command bridge projection\"\n7:   - \"command bridge compatibility\"\n8: ---\n9: \n10: # Command bridges\n11: \n12: ---\n13: \n14: ## 1. OVERVIEW\n15: \n16: `command-bridges/` is the source boundary for command metadata that is not yet represented uniformly by every scoring surface. The deriver combines live skill metadata with the authored compatibility inputs and writes the generated JSON projection.\n17: \n18: The doctor commands are a third source: the deriver reads `.skilled/commands/doctor/_routes.yaml` and writes one bridge per doctor route and per standalone doctor command and per MCP sub-route.\n19: \n20: Each hub's `mode-registry.json` is a fourth source: the deriver reads the `command` of every mode and writes the `MODE_COMMANDS` table the advisor uses to attach a slash command to a hub recommendation.\n21: \n22: ---\n23: \n24: ## 2. CONTENTS\n25: \n26: | File | Responsibility | Authority |\n27: |---|---|---|\n28: | `command-bridges.generated.json` | Stores the derived command-bridge projection. | Generated, do not edit |\n29: | `derive-command-bridges.cjs` | Reads live metadata and authored inputs, validates uniqueness and writes the projection. | Authored deriver |\n30: | `scoring-compatibility.json` | Holds TypeScript and Python scoring compatibility mappings. | Authored input |\n31: | `shadow-diff.md` | Records comparison evidence between generated and live bridge authorities. | Authored evidence |\n32: \n33: ---\n34: \n35: ## 3. DERIVATION FLOW\n36: \n37: ```text\n38: skill command metadata files\n39: scoring-compatibility.json\n40: .skilled/commands/doctor/_routes.yaml\n41: hub mode-registry.json files\n42:                          |\n43:                          v\n44:               derive-command-bridges.cjs\n45:                          |\n46:                          v\n47:               command-bridges.generated.json\n48: ```\n49: \n50: The deriver also updates generated projection blocks in the live TypeScript and Python scoring sources. Its `GENERATED COMMAND ROWS` block in `lib/command-attach.ts` holds `COMMAND_ROWS`, one row per id a scorer can return for an enabled entry, covering the entry id and every enabled runtime id. Each row carries the runnable slash command, its derived policy and the owning skill. The same block holds `COMMAND_POLICIES`, one policy per runnable string, so a surface that attaches a command can name its policy without a second lookup. It writes the `MODE_COMMANDS` block into the same file, one row per hub mode that names a command, and fails when a mode names a command with no file under `.skilled/commands/`. The same block also holds `TRACKED_COMMANDS`, one row per tracked command keyed by its runnable string, emitted for every bridge entry whether or not the bridge is active. Each TypeScript bridge in `lib/scorer/projection.ts` carries an `ownerSkill`, the skill that owns its command. The generated JSON and generated source blocks are outputs, not hand-edited inputs.\n51: \n52: Every tracked row carries the command's derived policy, the skill that owns it and `scorerRow`, which is true when the TypeScript scorer has a row for that entry. A typed command therefore always has a policy and an owner to deliver, even where no scorer row exists.\n53: \n54: Each bridge row with TypeScript enabled also carries an `embeddingText`, the plain sentence a scoring vector is built from. A Python-only row carries none. A metadata row leads with its `userIntent.job` sentence and adds every `userIntent.ownedSignals` phrase, because both are written in the asker's voice. The entry `description` stands in for the job only when the record states no job. A doctor row builds it from the router frontmatter `description` and the `trigger_phrases` of the route. The deriver drops each slash command string before the parts are joined, because a name left in would hand the scorer a second copy of the token it already matches literally. The field is derived on every run and never authored, so edit the sources rather than the JSON.\n55: \n56: ---\n57: \n58: ## 4. DOCTOR BRIDGES\n59: \n60: Ids are `command-doctor-<command>-<target>` when the doctor command owns more than one route, and `command-doctor-<command>` otherwise. `skillId` and `ownerMode` come from the router's `skill_agent` tag. A router without the tag fails the deriver with a named error.\n61: \n62: The runnable string is the command plus its target when the command owns more than one route. A standalone entry may set `runnable`, as `/doctor:env` does with `/doctor:env list`.\n63: \n64: A new route needs a hand-written entry in both the `typescript` and `python` lists in `scoring-compatibility.json`. Each entry carries only `inventoryId`, `order`, `id` (equal to `inventoryId`) and an empty `description`.\n65: \n66: The deriver fills the TypeScript name, keywords, intent signals and domains from the manifest, and the Python slash marker from the runnable string. A route marked `default_target` in `_routes.yaml` also gets the bare command (for example `/doctor:ci`) as a TypeScript keyword and a Python slash marker, so the bare typed command reaches it. A typed `<command> <target>` names that target, so the bare command inside it does not also match the default target. Python matches a doctor bridge only on a typed slash command.\n67: \n68: A doctor bridge passes on its own wording (an explicit-author phrase match). When none passes and no `/doctor:` command was typed, the scorer asks `/doctor:helper`'s own ranker, `doctor-helper-match.cjs`, whether the prompt describes a doctor problem. If it does, `command-doctor-helper` passes, and `/doctor:helper` then names the command. With no skill passing, a ranker score of 10 or more is enough, or 6 or more when the prompt names a problem. Beside a passing skill, the prompt must name a wrong state or a health check, such as `is not registered`, `never converges` or `turn off`. A `/doctor:` command counts as typed when the prompt starts with `/doctor:` or when it directly follows `run`, `execute`, `start`, `launch`, `use` or `kick off` outside quotes and backticks. A quoted command or a bare mid-sentence mention does not count. A typed command puts its own passing bridge first. A prompt that contains one of a bridge's `lead_phrases` also puts that passing bridge first, so `check my environment variables` leads with `/doctor:env`. For other prompts, a passing skill keeps first place and passing doctor bridges sit right after the second passing skill or the only passing skill. This keeps a doctor line within the CLI's three shown results. A typed command shows its matching runnable string on the top line. A skill-first brief shows `Also: /doctor:<command> <target>` on the second line. The Python fallback matches a doctor bridge only on a typed slash command.\n69: \n70: Each `mcp_subroutes` entry becomes the bridge `command-doctor-mcp-<sub_action>`, with the runnable string `/doctor:mcp <sub_action>` and its owner from the `skill_agent` tag in `mcp.md`. Every derived doctor bridge is active in both scorers, and `doctor-phrase-reach.cjs` proves each one.\n71: \n72: Check every admitted phrase with `node .skilled/commands/doctor/scripts/doctor-phrase-reach.cjs`.\n73: \n74: Every command bridge, not only a doctor bridge, passes on its own wording. `requireCommandPhraseAnchor` in `lib/scorer/fusion.ts` drops a passing command row below threshold unless the explicit-author lane matched one of its phrases or its slash string. The one other way in is meaning: a real embedder cosine of at least 0.72 against the row's `embeddingText` vector, with a 0.02 lead over the next command row. That needs the local embedder, so without it every command row passes on its wording alone. A prompt that asks for no change rules out every command on meaning, and a read-only question admits only a bridge marked `readOnly`.\n75: \n76: ---\n77: \n78: ## 5. STANDALONE SKILL COMMANDS\n79: \n80: A standalone skill has a `command-metadata.json` and no `mode-registry.json`, as `sk-prompt` and `system-spec-kit` do. Its commands are active in both scorers by construction and need no row in `scoring-compatibility.json`. The deriver builds each row from the metadata entry:\n81: \n82: - TypeScript: the `userIntent.ownedSignals` phrases become the keywords and intent signals, the command's namespace and `command` become the domains, and a `read-only` `mutating` class sets `readOnly: true`.\n83: - Python: the slash markers are the command with and without its leading slash, and `owningSkill` is the skill.\n84: \n85: A command needs at least two `userIntent.ownedSignals`, or the deriver fails. A hand row in `scoring-compatibility.json` still wins where one exists. Generated rows take orders after the highest hand-written order.\n86: \n87: ---\n88: \n89: ## 6. HUMAN EDIT BOUNDARY\n90: \n91: Humans may edit `derive-command-bridges.cjs`, `scoring-compatibility.json` and `shadow-diff.md`. Regenerate `command-bridges.generated.json` after changing an authored input or the deriver. Do not edit the generated JSON directly.\n92: \n93: ---\n94: \n95: ## 7. VALIDATION\n96: \n97: Run the deriver in check mode from the repository root:\n98: \n99: ```bash\n100: node .skilled/skills/system-skill-advisor/runtime/scripts/command-bridges/derive-command-bridges.cjs --check\n101: ```\n102: \n103: ---\n104: \n105: ## 8. RISK KEYS AND COMMAND POLICY\n106: \n107: The command tree `.skilled/commands/<namespace>/<name>.md` owns which commands exist. The deriver fails when a command file has no `command-metadata.json` entry and no doctor route. It fails again when a declaration names a command with no file.\n108: \n109: A `command-metadata.json` entry and a doctor route or action carry the same risk keys. A value outside the accepted set fails the deriver before any policy is derived.\n110: \n111: | Risk key | Accepted values | Applies to |\n112: |---|---|---|\n113: | `mutating` | `read-only`, `add-only`, `mutates` | Every metadata entry and every doctor route or action |\n114: | `gate3_location` | A non-empty string naming what the command writes | Required on every metadata entry |\n115: | `ask_first` | `settings`, `outside-repo`, `spend`, `relaunch` | Optional on both records |\n116: | `write_scope` | `spec-folder` | Optional on both records |\n117: \n118: `derivePolicy` reads those keys in order and stops at the first match.\n119: \n120: | Step | Condition | Policy |\n121: |---|---|---|\n122: | 1 | `ask_first` lists at least one reason | `ask` |\n123: | 2 | A doctor route or action classed `mutates` | `ask` |\n124: | 3 | `mutating` is `read-only` | `run` |\n125: | 4 | `mutating` is `add-only` with `write_scope` set to `spec-folder` | `run` |\n126: | 5 | Any other record | `start` |\n127: \n128: `commandPolicies` in `command-bridges.generated.json` holds one record per command, or one record per route or action for a doctor command. Each record carries five keys: `command`, `route`, `mutating`, `askFirst`, `policy`. Nothing scores on it yet.\n129: \n130: ---\n131: \n132: ## 9. RELATED\n133: \n134: - [`Skill-advisor scripts`](../README.md)"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\".skilled/skills/system-skill-advisor/runtime/scripts/command-bridges/README.md\"}"},"time":{"start":1794550681801,"end":1794550682082}}}}
