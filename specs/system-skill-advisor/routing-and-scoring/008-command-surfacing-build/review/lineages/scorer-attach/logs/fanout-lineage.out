ommand-bridges.generated.json\\\");\\nconst ts=fs.readFileSync(\\\".skilled/skills/system-skill-advisor/runtime/lib/command-attach.ts\\\",\\\"utf8\\\");\\nconst polBlock=ts.split(\\\"export const COMMAND_POLICIES\\\")[1].split(\\\"};\\\")[0];\\nconst tsPol={}; for(const m of polBlock.matchAll(/^\\\\s*\\\\x27([^\\\\x27]+)\\\\x27:\\\\s*\\\\x27([^\\\\x27]+)\\\\x27,/gm)) tsPol[m[1]]=m[2];\\nconst genPol={}; for(const r of gen.commandPolicies) genPol[r.command]=r.policy;\\nconst all=new Set([...Object.keys(tsPol),...Object.keys(genPol)]);\\nconst diffs=[...all].filter(k=>tsPol[k]!==genPol[k]).map(k=>`${k}: ts=${tsPol[k]} gen=${genPol[k]}`);\\nconsole.log(\\\"ts:\\\",Object.keys(tsPol).length,\\\"gen:\\\",Object.keys(genPol).length,\\\"diffs:\\\",diffs.length); console.log(diffs.join(\\\"\\\\n\\\"));\\nconst rowsBlock=ts.split(\\\"export const COMMAND_ROWS\\\")[1].split(\\\"};\\\")[0];\\nconst tsRows={}; for(const m of rowsBlock.matchAll(/^\\\\s*\\\\x27([^\\\\x27]+)\\\\x27:\\\\s*\\\\{\\\\s*command:\\\\s*\\\\x27([^\\\\x27]+)\\\\x27,\\\\s*policy:\\\\s*\\\\x27([^\\\\x27]+)\\\\x27(?:,\\\\s*mutating:\\\\s*\\\\x27([^\\\\x27]+)\\\\x27)?,\\\\s*ownerSkillId:\\\\s*\\\\x27([^\\\\x27]+)\\\\x27/gm)) tsRows[m[1]]={command:m[2],policy:m[3],mutating:m[4],owner:m[5]};\\nconst genById={}; for(const e of gen.entries) genById[e.id]=e;\\nconst diffs2=[];\\nfor(const [id,row] of Object.entries(tsRows)){\\n  const g=genById[id];\\n  if(!g){diffs2.push(`${id}: row not in generated entries`);continue;}\\n  if(row.command!==g.command) diffs2.push(`${id}: command ${row.command} vs ${g.command}`);\\n  if(row.policy!==(g.policy||genPol[g.command])) diffs2.push(`${id}: policy ${row.policy} vs ${g.policy||genPol[g.command]}`);\\n  if(row.mutating!==g.mutating) diffs2.push(`${id}: mutating ${row.mutating} vs ${g.mutating}`);\\n}\\nconsole.log(\\\"row diffs:\\\",diffs2.length); console.log(diffs2.slice(0,20).join(\\\"\\\\n\\\"));\\nconsole.log(\\\"gen entry policy field sample:\\\", gen.entries.filter(e=>e.policy).length);\\n' 2>&1\"}"},"time":{"start":1794550601780,"end":1794550608459}}}}
