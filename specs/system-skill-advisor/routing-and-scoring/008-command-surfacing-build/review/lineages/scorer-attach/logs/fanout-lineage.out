urn `  ${tsString(id)}: { ${fields.join(', ')} },`;\n1204:     });\n1205:   const policyLines = [...runnablePolicies.entries()]\n1206:     .sort(([left], [right]) => left.localeCompare(right))\n1207:     .map(([runnable, policy]) => `  ${tsString(runnable)}: ${tsString(policy)},`);\n1208:   const trackedLines = [...tracked.entries()]\n1209:     .sort(([left], [right]) => left.localeCompare(right))\n1210:     .map(([runnable, row]) => (\n1211:       `  ${tsString(runnable)}: { policy: ${tsString(row.policy)}, `\n1212:         + `ownerSkillId: ${tsString(row.ownerSkillId)}, scorerRow: ${row.scorerRow} },`\n1213:     ));\n1214:   return [\n1215:     'export const COMMAND_ROWS: Readonly<Record<string, CommandRow>> = {',\n1216:     ...rowLines,\n1217:     '};',\n1218:     \"export const COMMAND_POLICIES: Readonly<Record<string, 'run' | 'start' | 'ask'>> = {\",\n1219:     ...policyLines,\n1220:     '};',\n1221:     'export const TRACKED_COMMANDS: Readonly<Record<string, TrackedCommand>> = {',\n1222:     ...trackedLines,\n1223:     '};',\n1224:   ].join('\\n');\n1225: }\n1226: \n1227: // Hub-then-mode nesting so a reader scans one hub's modes together, and the\n1228: // records arrive already ordered so the block is byte-identical between runs.\n1229: function renderModeCommands(records) {\n1230:   const lines = [\n1231:     'export const MODE_COMMANDS: Readonly<Record<string, Readonly<Record<string, string>>>> = {',\n1232:   ];\n1233:   let hubId = null;\n1234:   for (const record of records) {\n[Output truncated. Continue reading with offset: 1235]","title":"read","metadata":{"metadata":{"truncated":true},"content":[{"type":"text","text":"Read file .skilled/skills/system-skill-advisor/runtime/scripts/command-bridges/derive-command-bridges.cjs, lines 1175-1234\n1175:     }\n1176:   }\n1177:   // Every tracked command gets a row whether or not a bridge is active, because a\n1178:   // reader can type a command no scorer offers and still needs its policy and its\n1179:   //