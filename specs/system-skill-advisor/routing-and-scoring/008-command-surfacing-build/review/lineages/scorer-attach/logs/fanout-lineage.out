  \"create an OpenCode skill\",\n        \"scaffold a skill package\",\n        \"update a skill definition\"\n      ]\n    },\n    \"choreography\": [\n      {\n        \"order\": 1,\n        \"skill\": \"sk-doc\",\n        \"resource\": \".skilled/skills/sk-doc/SKILL.md\",\n        \"action\": \"load the sk-doc parent hub routing table\"\n      },\n      {\n        \"order\": 2,\n        \"skill\": \"create-skill\",\n        \"resource\": \".skilled/skills/sk-doc/sk-create-skill/SKILL.md\",\n        \"action\": \"load the standalone-skill scaffolding mode contract, then apply the workflow to $ARGUMENTS\"\n      },\n      {\n        \"order\": 3,\n        \"skill\": \"create-skill\",\n        \"resource\": \".skilled/commands/create/assets/create-skill-presentation.txt\",\n        \"action\": \"load the command presentation contract before resolving setup and execution mode\"\n      }\n    ],\n    \"discriminator\": {\n      \"whenToUse\": \"Use this command when the deliverable is a standalone OpenCode skill or a shared skill packet.\",\n      \"preferSiblingWhen\": [\n        {\n          \"sibling\": \"/create:skill-parent\",\n          \"when\": \"Prefer the parent command when the deliverable is a hub with multiple nested workflow or surface packets.\"\n        }\n      ]\n    }\n  },\n  {\n    \"command\": \"/create:skill-parent\",\n    \"ownerMode\": \"sk-create-skill-parent\",\n    \"description\": \"Scaffold a parent skill with nested mode packets (one hub identity, registry source of truth). :auto/:confirm.\",\n    \"argumentHint\": \"<skill-name> [create|update] [--modes <mode1,mode2,...>] [--surfaces <s1,s2,...>] [--path <dir>] [:auto|:confirm]\",\n    \"mutating\": \"mutates\",\n    \"gate3_location\": \"a parent skill hub with nested mode packets, one graph-metadata.json, at the resolved --path\",\n    \"userIntent\": {\n      \"job\": \"I want to scaffold or update a parent skill hub with nested mode packets.\",\n      \"ownedSignals\": [\n        \"create a parent skill hub\",\n        \"add nested mode packets\",\n        \"scaffold a skill rout","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"runtime values: {\"[object Object]\":63}\nsources: .skilled/skills/sk-doc/command-metadata.json\n  .skilled/skills/system-deep-loop/command-metadata.json\n  .skilled/skills/sk-design/command-metadata.json\n  .skilled/commands/doctor/_routes.yaml\n  .skilled/skills/sk-prompt/command-metadata.json\n  .skilled/skills/system-spec-kit/command-metadata.json\n=== sk-doc command-metadata ===\n[\n  {\n    \"command\": \"/create:skill\",\n    \"ownerMode\": \"sk-create-skill\",\n    \"description\": \"Create or update OpenCode skills via one unified command with operation routing. :auto/:confirm.\",\n    \"argumentHint\": \"<skill-name> [operation] [type] [--path <dir>] [--chained] [:auto|:confirm]\",\n    \"mutating\": \"mutates\",\n    \"gate3_location\": \"a new or updated OpenCode skill package at --path or the path setup resolves\",\n    \"userIntent\": {\n      \"job\": \"I want to create or update a standalone OpenCode skill package.\",\n      \"ownedSignals\": [\n        \"create an OpenCode skill\",\n        \"scaffold a skill package\",\n        \"update a skill definition\"\n      ]\n    },\n    \"choreography\": [\n      {\n        \"order\": 1,\n        \"skill\": \"sk-doc\",\n        \"resource\": \".skilled/skills/sk-doc/SKILL.md\",\n        \"action\": \"load the sk-doc parent hub routing table\"\n      },\n      {\n        \"order\": 2,\n        \"skill\": \"create-skill\",\n        \"resource\": \".skilled/skills/sk-doc/sk-create-skill/SKILL.md\",\n        \"action\": \"load the standalone-skill scaffolding mode contract, then apply the workflow to $ARGUMENTS\"\n      },\n      {\n        \"order\": 3,\n        \"skill\": \"create-skill\",\n        \"resource\": \".skilled/commands/create/assets/create-skill-presentation.txt\",\n        \