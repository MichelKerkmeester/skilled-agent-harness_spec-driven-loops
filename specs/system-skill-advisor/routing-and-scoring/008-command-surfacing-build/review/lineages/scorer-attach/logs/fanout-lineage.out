47: \n248: // The companion line normally shows only the runnable command. A child gets the\n249: // downgrade marker appended because that command must not be started there.\n250: function companionCommandLabel(skillId: string, childSession: boolean): string | null {\n251:   const command = doctorCommandString(skillId);\n252:   if (command === null) {\n253:     return null;\n254:   }\n255:   const row = commandRowFor(skillId);\n256:   return childSession && parentNamedOnly(row?.policy, row?.mutating)\n257:     ? `${command} (${PARENT_NAMED_POLICY})`\n258:     : command;\n259: }\n260: \n261: function formatScore(value: number): string {\n262:   return Number.isFinite(value) ? value.toFixed(2) : '0.00';\n263: }\n264: \n265: type RenderableRecommendation = AdvisorRecommendation & {\n266:   readonly score?: number;\n267:   readonly ambiguousWith?: readonly string[];\n268:   readonly heldBelow?: string;\n269: };\n270: \n271: function toScoredRecommendation(recommendation: RenderableRecommendation): AdvisorScoredRecommendation {\n272:   return {\n273:     skill: recommendation.skill,\n274:     kind: recommendation.kind === 'command' ? 'command' : 'skill',\n275:     confidence: recommendation.confidence,\n276:     uncertainty: recommendation.uncertainty,\n277:     passes_threshold: recommendation.passes_threshold ?? true,\n278:     reason: '',\n279:     score: typeof recommendation.score === 'number' && Number.isFinite(recommendation.score)\n[Output truncated. Continue reading with offset: 280]","title":"read","metadata":{"metadata":{"truncated":true},"content":[{"type":"text","text":"Read file .skilled/skills/system-skill-advisor/runtime/lib/render.ts, lines 170-279\n170:     .trim();\n171:   if (!singleLine || INSTRUCTION_LABEL_PATTERN.test(singleLine)) {\n172:     return null;\n173:   }\n174:   return singleLine;\n175: }\n176: \n177: const DOCTOR_BRIDGE_PREFIX = 'command-doctor-';\n178: \n179: function isDoctorBridgeId(skillId: string): boolean {\n180:   return skillId