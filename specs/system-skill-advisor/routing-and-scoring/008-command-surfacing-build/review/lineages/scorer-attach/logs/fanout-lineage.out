{"type":"tool_use","timestamp":1794550531646,"sessionID":"ses_e2c7999e1ffeYcD6BDSYeMhQPJ","part":{"partID":"prt_1d38c0522001uYWo6sx4mKKohD","sessionID":"ses_e2c7999e1ffeYcD6BDSYeMhQPJ","messageID":"msg_1d38bf08f001nrzJPEtAWJ651a","type":"tool","id":"call_db3a96b1390840878738e377","tool":"read","state":{"status":"completed","input":{"path":".skilled/skills/system-skill-advisor/runtime/lib/compiled-routing-flag.ts"},"output":"Read file .skilled/skills/system-skill-advisor/runtime/lib/compiled-routing-flag.ts, lines 1-65\n1: // ───────────────────────────────────────────────────────────────\n2: // MODULE: Compiled-routing flag (tri-state) + hub eligibility set\n3: // ───────────────────────────────────────────────────────────────\n4: //\n5: // Single source for the advisor recommend path's view of the compiled-routing\n6: // runtime flag and the hubs it may enrich. Kept dependency-free so the runtime\n7: // and the cross-site truth-table test read exactly the same semantics, and so a\n8: // cross-check test can assert this hub set never diverges from the runtime\n9: // engine-dispatch map.\n10: \n11: // Hubs the advisor may attach a compiled route for. Eligibility to actually\n12: // serve compiled is decided downstream by manifest freshness in the resolver;\n13: // this is only the set the advisor will probe.\n14: export const COMPILED_ROUTING_HUBS: ReadonlySet<string> = new Set([\n15:   'sk-code',\n16:   'mcp-tooling',\n17:   'system-deep-loop',\n18:   'cli-external-orchestration',\n19:   'cli-classifier',\n20:   'sk-doc',\n21:   'sk-design',\n22: ]);\n23: \n24: // Per-hub default-on cohort. Mirrors the runtime resolver's own default-on\n25: // cohort (the seven hubs verified compiled-serving, 0 drift — see\n26: // `014-runtime-engine/lib/resolve.cjs`): this enrichment shells out to the same\n27: // public front door (`.skilled/bin/compiled-route.cjs`), which delegates to\n28: // that identical resolver, so surfacing it here attaches only additive\n29: // metadata and never changes which skill is recommended. An unset flag now\n30: // attaches `compiledRoute` for these hubs; SPECKIT_COMPILED_ROUTING=0 remains\n31: // the explicit fleet-wide kill-switch (no field attached, legacy shape).\n32: export const DEFAULT_ON_HUBS: ReadonlySet<string> = new Set([\n33:   'sk-code',\n34:   'mcp-tooling',\n35:   'system-deep-loop',\n36:   'cli-external-orchestration',\n37:   'cli-classifier',\n38:   'sk-doc',\n39:   'sk-design',\n40: ]);\n41: \n42: export type CompiledRoutingFlagMode = 'force-on' | 'force-legacy' | 'default' | 'invalid';\n43: \n44: // Tri-state parse of SPECKIT_COMPILED_ROUTING:\n45: //   'force-on'     '1'                    serve compiled where a hub is eligible\n46: //   'force-legacy' '0' | 'false' | 'off'  explicit fleet-wide kill-switch\n47: //   'default'      unset                  per-hub cohort decides (empty => legacy)\n48: //   'invalid'      anything else          fail closed to legacy\n49: export function parseCompiledRoutingFlagMode(raw: string | undefined): CompiledRoutingFlagMode {\n50:   if (raw === undefined || raw === '') return 'default';\n51:   if (raw === '1') return 'force-on';\n52:   if (raw === '0' || raw === 'false' || raw === 'off') return 'force-legacy';\n53:   return 'invalid';\n54: }\n55: \n56: // Whether the flag permits the advisor to attach a compiled route for this hub.\n57: export function compiledRoutingEnabledForHub(\n58:   hubId: string,\n59:   raw: string | undefined = process.env.SPECKIT_COMPILED_ROUTING,\n60: ): boolean {\n61:   const mode = parseCompiledRoutingFlagMode(raw);\n62:   if (mode === 'force-on') return true;\n63:   if (mode === 'default') return DEFAULT_ON_HUBS.has(hubId);\n64:   return false; // force-legacy | invalid\n65: }","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file .skilled/skills/system-skill-advisor/runtime/lib/compiled-routing-flag.ts, lines 1-65\n1: // ───────────────────────────────────────────────────────────────\n2: // MODULE: Compiled-routing flag (tri-state) + hub eligibility set\n3: // ───────────────────────────────────────────────────────────────\n4: //\n5: // Single source for the advisor recommend path's view of the compiled-routing\n6: // runtime flag and the hubs it may enrich. Kept dependency-free so the runtime\n7: // and the cross-site truth-table test read exactly the same semantics, and so a\n8: // cross-check test can assert this hub set never diverges from the runtime\n9: // engine-dispatch map.\n10: \n11: // Hubs the advisor may attach a compiled route for. Eligibility to actually\n12: // serve compiled is decided downstream by manifest freshness in the resolver;\n13: // this is only the set the advisor will probe.\n14: export const COMPILED_ROUTING_HUBS: ReadonlySet<string> = new Set([\n15:   'sk-code',\n16:   'mcp-tooling',\n17:   'system-deep-loop',\n18:   'cli-external-orchestration',\n19:   'cli-classifier',\n20:   'sk-doc',\n21:   'sk-design',\n22: ]);\n23: \n24: // Per-hub default-on cohort. Mirrors the runtime resolver's own default-on\n25: // cohort (the seven hubs verified compiled-serving, 0 drift — see\n26: // `014-runtime-engine/lib/resolve.cjs`): this enrichment shells out to the same\n27: // public front door (`.skilled/bin/compiled-route.cjs`), which delegates to\n28: // that identical resolver, so surfacing it here attaches only additive\n29: // metadata and never changes which skill is recommended. An unset flag now\n30: // attaches `compiledRoute` for these hubs; SPECKIT_COMPILED_ROUTING=0 remains\n31: // the explicit fleet-wide kill-switch (no field attached, legacy shape).\n32: export const DEFAULT_ON_HUBS: ReadonlySet<string> = new Set([\n33:   'sk-code',\n34:   'mcp-tooling',\n35:   'system-deep-loop',\n36:   'cli-external-orchestration',\n37:   'cli-classifier',\n38:   'sk-doc',\n39:   'sk-design',\n40: ]);\n41: \n42: export type CompiledRoutingFlagMode = 'force-on' | 'force-legacy' | 'default' | 'invalid';\n43: \n44: // Tri-state parse of SPECKIT_COMPILED_ROUTING:\n45: //   'force-on'     '1'                    serve compiled where a hub is eligible\n46: //   'force-legacy' '0' | 'false' | 'off'  explicit fleet-wide kill-switch\n47: //   'default'      unset                  per-hub cohort decides (empty => legacy)\n48: //   'invalid'      anything else          fail closed to legacy\n49: export function parseCompiledRoutingFlagMode(raw: string | undefined): CompiledRoutingFlagMode {\n50:   if (raw === undefined || raw === '') return 'default';\n51:   if (raw === '1') return 'force-on';\n52:   if (raw === '0' || raw === 'false' || raw === 'off') return 'force-legacy';\n53:   return 'invalid';\n54: }\n55: \n56: // Whether the flag permits the advisor to attach a compiled route for this hub.\n57: export function compiledRoutingEnabledForHub(\n58:   hubId: string,\n59:   raw: string | undefined = process.env.SPECKIT_COMPILED_ROUTING,\n60: ): boolean {\n61:   const mode = parseCompiledRoutingFlagMode(raw);\n62:   if (mode === 'force-on') return true;\n63:   if (mode === 'default') return DEFAULT_ON_HUBS.has(hubId);\n64:   return false; // force-legacy | invalid\n65: }"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\".skilled/skills/system-skill-advisor/runtime/lib/compiled-routing-flag.ts\"}"},"time":{"start":1794550531362,"end":1794550531646}}}}
