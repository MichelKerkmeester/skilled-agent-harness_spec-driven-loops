ng semantics.'),\n568:   overallAccuracy: z.number().min(0).max(1),\n569:   perSkill: z.array(z.object({\n570:     skillId: z.string().min(1),\n571:     status: z.enum(['pass', 'fail', 'skipped']),\n572:     matched: z.number().int().nonnegative(),\n573:     total: z.number().int().nonnegative(),\n574:   }).strict()),\n575:   slices: z.object({\n576:     corpus: z.object({\n577:       full_corpus_top1: validationSliceSchema,\n578:       unknown_count: z.object({\n579:         value: z.number().int().nonnegative(),\n580:         targetMax: z.number().int().nonnegative(),\n581:         passed: z.boolean(),\n582:       }).strict(),\n583:       gold_none_false_fire_count: z.object({\n584:         value: z.number().int().nonnegative(),\n585:         baselineDelta: z.number().int(),\n586:       }).strict(),\n587:     }).strict(),\n588:     holdout: z.object({\n589:       holdout_top1: validationSliceSchema,\n590:     }).strict(),\n591:     parity: z.object({\n592:       explicit_skill_top1_regression: z.object({\n593:         passed: z.boolean(),\n594:         regressions: z.array(z.string()),\n595:       }).strict(),\n596:       ambiguity_slice_stable: z.object({\n597:         passed: z.boolean(),\n598:         top2Within005: z.boolean(),\n599:       }).strict(),\n600:       derived_lane_attribution_complete: z.boolean(),\n601:     }).strict(),\n602:     safety: z.object({\n603:       adversarial_stuffing_blocked: z.object({\n604:         passed: z.boolean(),\n605:         fixtureCount: z.number().int().nonnegative(),\n606:       }).strict(),\n607:     }).strict(),\n608:     latency: z.object({\n609:       regression_suite_status: z.object({\n610:         p0PassRate: z.number().min(0).max(1),\n611:         failedCount: z.number().int().nonnegative(),\n612:         commandBridgeFalsePositiveRate: z.number().min(0).max(1),\n613:         cacheHitP95Ms: z.number().min(0),\n614:         uncachedP95Ms: z.number().min(0),\n[Output truncated. Continue reading with offset: 615]",