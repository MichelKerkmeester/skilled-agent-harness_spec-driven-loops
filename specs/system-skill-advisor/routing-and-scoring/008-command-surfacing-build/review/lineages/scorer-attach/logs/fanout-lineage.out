but stops passing, because\n870: // its phrases are everyday words and a command must not be offered for a prompt\n871: // that merely shares some of them. A paraphrase shares no words at all, so the\n872: // second way in is meaning: a real prompt embedding that clears both bars above.\n873: // Meaning-passed ids are collected so a later ordering step can tell them apart,\n874: // and a doctor problem in other words reaches /doctor:helper through\n875: // applyDoctorHelperHandoff instead.\n876: // A question that only wants an answer must not be handed a command that\n877: // changes things, however close the meaning. Phrase matches are already held to\n878: // this by the read-only confidence floor, and a meaning match lifts confidence\n879: // past that floor, so it has to ask the same question itself. A command whose\n880: // route only reads stays eligible for a plain explainer, because running it is\n881: // the answer. An explicit no-edit request rules out every command.\n882: export function commandMeaningEligible(\n883:   promptLower: string,\n884:   readOnlyExplainer: boolean,\n885:   skill: SkillProjection | undefined,\n886: ): boolean {\n887:   if (NO_EDIT_REQUEST.test(promptLower)) return false;\n888:   if (!readOnlyExplainer) return true;\n889:   return skill !== undefined && skill.kind === 'command' && 'readOnly' in skill && skill.readOnly === true;\n890: }\n891: \n892: export function requireCommandPhraseAnchor(\n893:   ranked: readonly AdvisorScoredRecommendation[],\n894:   confidenceThreshold: number = DEFAULT_CONFIDENCE_THRESHOLD,\n895:   meaningPassed: Set<string> = new Set(),\n896:   meaningEligible: (skillId: string) => boolean = () => true,\n897: ): AdvisorScoredRecommendation[] {\n898:   const cosineByCommandId = new Map<string, number>();\n899:   for (const recommendation of ranked) {\n900:     if (recommendation.kind !== 'command') continue;\n901:     const cosine = commandMeaningCosine(\n902:       recommendation.laneContributions.find((contribution) => contribution.lane === 'semantic_shadow'),\n903:     );\n904:     if (cosine !== null) cosineByCommandId.set(recommendation.skill, cosine);\n905:   }\n906:   // A command row with no cosine counts as 0, so the bar is the strongest other\n907:   // command row, not the strongest row overall: a skill row never decides this.\n908:   const leadingOtherCosine = (skillId: string): number => {\n909:     let lead = 0;\n910:     for (const [otherSkillId, cosine] of cosineByCommandId) {\n911:       if (otherSkillId !== skillId && cosine > lead) lead = cosine;\n912:     }\n913:     return lead;\n914:   };\n915:   return ranked.map((recommendation) => {\n916:     if (recommendation.kind !== 'command') return recommendation;\n917:     const anchored = recommendation.laneContributions.some((contribution) => (\n918:       contribution.lane === 'explicit_author' && contribution.rawScore > 0\n919:     ));\n920:     if (anchored) return recommendation;\n921:     const cosine = cosineByCommandId.get(recommendation.skill);\n922:     if (cosine !== undefined\n923:       && cosine >= COMMAND_MEANING_MIN_COSINE\n924:       && cosine - leadingOtherCosine(recommendation.skill) >= COMMAND_MEANING_MARGIN\n925:       && meaningEligible(recommendation.skill)) {\n926:       // A meaning match alone rarely clears the threshold on its lane weight, so\n927:       // the anchor lifts the row to it rather than leaving it scored but unpassed.\n928:       meaningPassed.add(recommendation.skill);\n929:       return {\n930:         ...recommendation,\n931:         confidence: Math.max(recommendation.confidence, confidenceThreshold),\n932:         passes_threshold: true,\n933:       };\n934:     }\n935:     return recommendation.passes_threshold\n936:       ? { ...recommendation, passes_threshold: false }\n937:       : recommendation;\n938:   });\n939: }\n940: \n941: function findTypedDoctorCommandText(promptLower: string): string | null {\n942:   const prompt = promptLower.trim();\n943:   i