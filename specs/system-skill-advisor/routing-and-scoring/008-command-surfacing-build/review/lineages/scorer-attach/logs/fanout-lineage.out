{"type":"tool_use","timestamp":1794550853412,"sessionID":"ses_e2c7999e1ffeYcD6BDSYeMhQPJ","part":{"partID":"prt_1d390e9910027QbVdtEcIrkFQH","sessionID":"ses_e2c7999e1ffeYcD6BDSYeMhQPJ","messageID":"msg_1d39092fa001STMOZOMpS3ov9j","type":"tool","id":"call_f5a607af0f0044438b87608d","tool":"read","state":{"status":"completed","input":{"path":".skilled/skills/system-skill-advisor/runtime/lib/scorer/doctor-helper-handoff.ts"},"output":"Read file .skilled/skills/system-skill-advisor/runtime/lib/scorer/doctor-helper-handoff.ts, lines 1-173\n1: // ───────────────────────────────────────────────────────────────\n2: // MODULE: Doctor Helper Hand-off\n3: // ───────────────────────────────────────────────────────────────\n4: \n5: // A doctor bridge passes only on its own declared wording, so a doctor problem\n6: // described in other words reaches no doctor command at all. /doctor:helper\n7: // already ranks free-text problems against every doctor route by word overlap.\n8: // When no doctor bridge passes, this module asks that same ranker whether the\n9: // prompt describes a doctor problem, and if it does the advisor offers the command the ranker named, or\n10: // /doctor:helper when that command asks before it runs.\n11: //\n12: // Two durable design choices:\n13: //   1. The ranker is the helper's own script, loaded from the workspace at run\n14: //      time, so the advisor and /doctor:helper can never disagree about what\n15: //      counts as a doctor problem. Any failure to load or rank is a no-match.\n16: //   2. Word overlap alone also fires on ordinary requests that share doctor\n17: //      vocabulary (\"start a deep review loop\"), so a weak match also needs the\n18: //      prompt to name a problem. Beside a passing skill only a strong cue\n19: //      counts, because bare words such as \"missing\" or \"broken\" are common in\n20: //      ordinary work. With no skill passing, a strong ranker match stands in\n21: //      for the cue.\n22: \n23: // ───────────────────────────────────────────────────────────────────\n24: // 1. IMPORTS\n25: // ───────────────────────────────────────────────────────────────────\n26: \n27: import { existsSync, statSync } from 'node:fs';\n28: import { createRequire } from 'node:module';\n29: import { join } from 'node:path';\n30: \n31: // ───────────────────────────────────────────────────────────────────\n32: // 2. CONSTANTS\n33: // ───────────────────────────────────────────────────────────────────\n34: \n35: const HELPER_SCRIPT = join('.skilled', 'commands', 'doctor', 'scripts', 'doctor-helper-match.cjs');\n36: const ROUTE_MANIFEST = join('.skilled', 'commands', 'doctor', '_routes.yaml');\n37: \n38: /** The bridge id the hand-off surfaces. */\n39: export const DOCTOR_HELPER_BRIDGE_ID = 'command-doctor-helper';\n40: \n41: /** Lowest helper rank score that counts as a doctor problem. */\n42: export const DOCTOR_HELPER_MIN_SCORE = 6;\n43: \n44: /** Helper rank score that stands in for a cue when no skill passes. */\n45: export const DOCTOR_HELPER_UNCUED_MIN_SCORE = 10;\n46: \n47: // A strong cue says a state is wrong or asks for a health or switch change, so\n48: // it can surface the helper beside a passing skill. A weak cue is a bare word\n49: // that ordinary work requests also use (\"fix the broken example\"), so it counts\n50: // only when no skill passes. Every hand-off needs at least one cue.\n51: const STRONG_PROBLEM_CUE = new RegExp([\n52:   \"\\\\b(?:not|isn'?t|aren'?t|doesn'?t|don'?t|won'?t|can'?t) (?:\\\\w+ )?(?:work|working|registered|found|load|loading|run|running|active|linked|fir(?:e|es|ing)|trigger(?:s|ing)?|converg\\\\w*)\\\\b\",\n53:   '\\\\bnever (?:converg\\\\w*|finish\\\\w*|stops?|works?|loads?|runs?)\\\\b',\n54:   '\\\\bstopped converg\\\\w*\\\\b',\n55:   '\\\\breturns? nothing\\\\b',\n56:   '\\\\b(?:healthy|health|diagnos\\\\w*)\\\\b',\n57:   '\\\\bturn(?:ed)? (?:on|off)\\\\b',\n58:   '\\\\bswitch(?:ed)? (?:on|off)\\\\b',\n59: ].join('|'), 'i');\n60: \n61: const WEAK_PROBLEM_CUE = new RegExp([\n62:   '\\\\b(?:broken|breaks?|failing|fails?|failed|wrong|stale|missing|stuck|errors?|drift(?:ed|s|ing)?)\\\\b',\n63:   '\\\\bout of (?:date|sync)\\\\b',\n64: ].join('|'), 'i');\n65: \n66: // A request for a repair route that names no problem the ranker knows still\n67: // belongs to /doctor:helper, which lists the routes and their reasons. The two\n68: // phrases are exact, so ordinary work requests never carry them.\n69: const GENERIC_REPAIR_CUE = /\\b(?:repair path|i have a problem)\\b/i;\n70: \n71: // ───────────────────────────────────────────────────────────────────\n72: // 3. TYPES\n73: // ───────────────────────────────────────────────────────────────────\n74: \n75: interface HelperCandidate {\n76:   readonly command: string;\n77:   readonly runnable?: string;\n78:   readonly score: number;\n79: }\n80: \n81: interface HelperModule {\n82:   readonly loadEntries: (root: string) => { readonly entries: readonly unknown[] };\n83:   readonly rankProblem: (\n84:     entries: readonly unknown[],\n85:     text: string,\n86:     options: { readonly top: number },\n87:   ) => { readonly candidates?: readonly HelperCandidate[] };\n88: }\n89: \n90: interface LoadedHelper {\n91:   readonly manifestMtimeMs: number;\n92:   readonly module: HelperModule;\n93:   readonly entries: readonly unknown[];\n94: }\n95: \n96: /** The doctor command the helper ranked first, with its rank score. */\n97: export interface DoctorProblemMatch {\n98:   readonly command: string;\n99:   /** The command with its subcommand, such as `/doctor:agents-md check`. */\n100:   readonly runnable: string;\n101:   readonly score: number;\n102: }\n103: \n104: // ───────────────────────────────────────────────────────────────────\n105: // 4. HELPERS\n106: // ───────────────────────────────────────────────────────────────────\n107: \n108: const loadedByRoot = new Map<string, LoadedHelper | null>();\n109: \n110: function loadHelper(workspaceRoot: string): LoadedHelper | null {\n111:   const scriptPath = join(workspaceRoot, HELPER_SCRIPT);\n112:   const manifestPath = join(workspaceRoot, ROUTE_MANIFEST);\n113:   if (!existsSync(scriptPath) || !existsSync(manifestPath)) return null;\n114:   let manifestMtimeMs: number;\n115:   try {\n116:     manifestMtimeMs = statSync(manifestPath).mtimeMs;\n117:   } catch {\n118:     return null;\n119:   }\n120:   const cached = loadedByRoot.get(workspaceRoot);\n121:   if (cached && cached.manifestMtimeMs === manifestMtimeMs) return cached;\n122:   try {\n123:     const helper = createRequire(import.meta.url)(scriptPath) as HelperModule;\n124:     const loaded: LoadedHelper = {\n125:       manifestMtimeMs,\n126:       module: helper,\n127:       entries: helper.loadEntries(workspaceRoot).entries,\n128:     };\n129:     loadedByRoot.set(workspaceRoot, loaded);\n130:     return loaded;\n131:   } catch {\n132:     loadedByRoot.set(workspaceRoot, null);\n133:     return null;\n134:   }\n135: }\n136: \n137: // ───────────────────────────────────────────────────────────────────\n138: // 5. CORE LOGIC\n139: // ───────────────────────────────────────────────────────────────────\n140: \n141: /** The strongest problem cue the prompt carries. */\n142: export function doctorProblemCue(prompt: string): 'strong' | 'weak' | null {\n143:   if (STRONG_PROBLEM_CUE.test(prompt)) return 'strong';\n144:   if (WEAK_PROBLEM_CUE.test(prompt)) return 'weak';\n145:   return null;\n146: }\n147: \n148: /** True when the prompt asks for a repair route without naming the problem. */\n149: export function genericRepairCue(prompt: string): boolean {\n150:   return GENERIC_REPAIR_CUE.test(prompt);\n151: }\n152: \n153: /**\n154:  * Ranks the prompt with /doctor:helper's own matcher and returns its first\n155:  * candidate when that candidate reaches the hand-off score, or null.\n156:  */\n157: export function matchDoctorProblem(prompt: string, workspaceRoot: string): DoctorProblemMatch | null {\n158:   const loaded = loadHelper(workspaceRoot);\n159:   if (!loaded) return null;\n160:   try {\n161:     const first = loaded.module.rankProblem(loaded.entries, prompt, { top: 1 }).candidates?.[0];\n162:     if (!first || typeof first.command !== 'string' || typeof first.score !== 'number') return null;\n163:     return first.score >= DOCTOR_HELPER_MIN_SCORE\n164:       ? {\n165:           command: first.command,\n166:           runnable: typeof first.runnable === 'string' && first.runnable !== '' ? first.runnable : first.command,\n167:           score: first.score,\n168:         }\n169:       : null;\n170:   } catch {\n171:     return null;\n172:   }\n173: }","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file .skilled/skills/system-skill-advisor/runtime/lib/scorer/doctor-helper-handoff.ts, lines 1-173\n1: // ───────────────────────────────────────────────────────────────\n2: // MODULE: Doctor Helper Hand-off\n3: // ───────────────────────────────────────────────────────────────\n4: \n5: // A doctor bridge passes only on its own declared wording, so a doctor problem\n6: // described in other words reaches no doctor command at all. /doctor:helper\n7: // already ranks free-text problems against every doctor route by word overlap.\n8: // When no doctor bridge passes, this module asks that same ranker whether the\n9: // prompt describes a doctor problem, and if it does the advisor offers the command the ranker named, or\n10: // /doctor:helper when that command asks before it runs.\n11: //\n12: // Two durable design choices:\n13: //   1. The ranker is the helper's own script, loaded from the workspace at run\n14: //      time, so the advisor and /doctor:helper can never disagree about what\n15: //      counts as a doctor problem. Any failure to load or rank is a no-match.\n16: //   2. Word overlap alone also fires on ordinary requests that share doctor\n17: //      vocabulary (\"start a deep review loop\"), so a weak match also needs the\n18: //      prompt to name a problem. Beside a passing skill only a strong cue\n19: //      counts, because bare words such as \"missing\" or \"broken\" are common in\n20: //      ordinary work. With no skill passing, a strong ranker match stands in\n21: //      for the cue.\n22: \n23: // ───────────────────────────────────────────────────────────────────\n24: // 1. IMPORTS\n25: // ───────────────────────────────────────────────────────────────────\n26: \n27: import { existsSync, statSync } from 'node:fs';\n28: import { createRequire } from 'node:module';\n29: import { join } from 'node:path';\n30: \n31: // ───────────────────────────────────────────────────────────────────\n32: // 2. CONSTANTS\n33: // ───────────────────────────────────────────────────────────────────\n34: \n35: const HELPER_SCRIPT = join('.skilled', 'commands', 'doctor', 'scripts', 'doctor-helper-match.cjs');\n36: const ROUTE_MANIFEST = join('.skilled', 'commands', 'doctor', '_routes.yaml');\n37: \n38: /** The bridge id the hand-off surfaces. */\n39: export const DOCTOR_HELPER_BRIDGE_ID = 'command-doctor-helper';\n40: \n41: /** Lowest helper rank score that counts as a doctor problem. */\n42: export const DOCTOR_HELPER_MIN_SCORE = 6;\n43: \n44: /** Helper rank score that stands in for a cue when no skill passes. */\n45: export const DOCTOR_HELPER_UNCUED_MIN_SCORE = 10;\n46: \n47: // A strong cue says a state is wrong or asks for a health or switch change, so\n48: // it can surface the helper beside a passing skill. A weak cue is a bare word\n49: // that ordinary work requests also use (\"fix the broken example\"), so it counts\n50: // only when no skill passes. Every hand-off needs at least one cue.\n51: const STRONG_PROBLEM_CUE = new RegExp([\n52:   \"\\\\b(?:not|isn'?t|aren'?t|doesn'?t|don'?t|won'?t|can'?t) (?:\\\\w+ )?(?:work|working|registered|found|load|loading|run|running|active|linked|fir(?:e|es|ing)|trigger(?:s|ing)?|converg\\\\w*)\\\\b\",\n53:   '\\\\bnever (?:converg\\\\w*|finish\\\\w*|stops?|works?|loads?|runs?)\\\\b',\n54:   '\\\\bstopped converg\\\\w*\\\\b',\n55:   '\\\\breturns? nothing\\\\b',\n56:   '\\\\b(?:healthy|health|diagnos\\\\w*)\\\\b',\n57:   '\\\\bturn(?:ed)? (?:on|off)\\\\b',\n58:   '\\\\bswitch(?:ed)? (?:on|off)\\\\b',\n59: ].join('|'), 'i');\n60: \n61: const WEAK_PROBLEM_CUE = new RegExp([\n62:   '\\\\b(?:broken|breaks?|failing|fails?|failed|wrong|stale|missing|stuck|errors?|drift(?:ed|s|ing)?)\\\\b',\n63:   '\\\\bout of (?:date|sync)\\\\b',\n64: ].join('|'), 'i');\n65: \n66: // A request for a repair route that names no problem the ranker knows still\n67: // belongs to /doctor:helper, which lists the routes and their reasons. The two\n68: // phrases are exact, so ordinary work requests never carry them.\n69: const GENERIC_REPAIR_CUE = /\\b(?:repair path|i have a problem)\\b/i;\n70: \n71: // ───────────────────────────────────────────────────────────────────\n72: // 3. TYPES\n73: // ───────────────────────────────────────────────────────────────────\n74: \n75: interface HelperCandidate {\n76:   readonly command: string;\n77:   readonly runnable?: string;\n78:   readonly score: number;\n79: }\n80: \n81: interface HelperModule {\n82:   readonly loadEntries: (root: string) => { readonly entries: readonly unknown[] };\n83:   readonly rankProblem: (\n84:     entries: readonly unknown[],\n85:     text: string,\n86:     options: { readonly top: number },\n87:   ) => { readonly candidates?: readonly HelperCandidate[] };\n88: }\n89: \n90: interface LoadedHelper {\n91:   readonly manifestMtimeMs: number;\n92:   readonly module: HelperModule;\n93:   readonly entries: readonly unknown[];\n94: }\n95: \n96: /** The doctor command the helper ranked first, with its rank score. */\n97: export interface DoctorProblemMatch {\n98:   readonly command: string;\n99:   /** The command with its subcommand, such as `/doctor:agents-md check`. */\n100:   readonly runnable: string;\n101:   readonly score: number;\n102: }\n103: \n104: // ───────────────────────────────────────────────────────────────────\n105: // 4. HELPERS\n106: // ───────────────────────────────────────────────────────────────────\n107: \n108: const loadedByRoot = new Map<string, LoadedHelper | null>();\n109: \n110: function loadHelper(workspaceRoot: string): LoadedHelper | null {\n111:   const scriptPath = join(workspaceRoot, HELPER_SCRIPT);\n112:   const manifestPath = join(workspaceRoot, ROUTE_MANIFEST);\n113:   if (!existsSync(scriptPath) || !existsSync(manifestPath)) return null;\n114:   let manifestMtimeMs: number;\n115:   try {\n116:     manifestMtimeMs = statSync(manifestPath).mtimeMs;\n117:   } catch {\n118:     return null;\n119:   }\n120:   const cached = loadedByRoot.get(workspaceRoot);\n121:   if (cached && cached.manifestMtimeMs === manifestMtimeMs) return cached;\n122:   try {\n123:     const helper = createRequire(import.meta.url)(scriptPath) as HelperModule;\n124:     const loaded: LoadedHelper = {\n125:       manifestMtimeMs,\n126:       module: helper,\n127:       entries: helper.loadEntries(workspaceRoot).entries,\n128:     };\n129:     loadedByRoot.set(workspaceRoot, loaded);\n130:     return loaded;\n131:   } catch {\n132:     loadedByRoot.set(workspaceRoot, null);\n133:     return null;\n134:   }\n135: }\n136: \n137: // ───────────────────────────────────────────────────────────────────\n138: // 5. CORE LOGIC\n139: // ───────────────────────────────────────────────────────────────────\n140: \n141: /** The strongest problem cue the prompt carries. */\n142: export function doctorProblemCue(prompt: string): 'strong' | 'weak' | null {\n143:   if (STRONG_PROBLEM_CUE.test(prompt)) return 'strong';\n144:   if (WEAK_PROBLEM_CUE.test(prompt)) return 'weak';\n145:   return null;\n146: }\n147: \n148: /** True when the prompt asks for a repair route without naming the problem. */\n149: export function genericRepairCue(prompt: string): boolean {\n150:   return GENERIC_REPAIR_CUE.test(prompt);\n151: }\n152: \n153: /**\n154:  * Ranks the prompt with /doctor:helper's own matcher and returns its first\n155:  * candidate when that candidate reaches the hand-off score, or null.\n156:  */\n157: export function matchDoctorProblem(prompt: string, workspaceRoot: string): DoctorProblemMatch | null {\n158:   const loaded = loadHelper(workspaceRoot);\n159:   if (!loaded) return null;\n160:   try {\n161:     const first = loaded.module.rankProblem(loaded.entries, prompt, { top: 1 }).candidates?.[0];\n162:     if (!first || typeof first.command !== 'string' || typeof first.score !== 'number') return null;\n163:     return first.score >= DOCTOR_HELPER_MIN_SCORE\n164:       ? {\n165:           command: first.command,\n166:           runnable: typeof first.runnable === 'string' && first.runnable !== '' ? first.runnable : first.command,\n167:           score: first.score,\n168:         }\n169:       : null;\n170:   } catch {\n171:     return null;\n172:   }\n173: }"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\".skilled/skills/system-skill-advisor/runtime/lib/scorer/doctor-helper-handoff.ts\"}"},"time":{"start":1794550851985,"end":1794550853412}}}}
{"type":"tool_use","timestamp":1794550853416,"sessionID":"ses_e2c7999e1ffeYcD6BDSYeMhQPJ","part":{"partID":"prt_1d390eb81001BVkWj4WY1Wc8Sb","sessionID":"ses_e2c7999e1ffeYcD6BDSYeMhQPJ","messageID":"msg_1d39092fa001STMOZOMpS3ov9j","type":"tool","id":"call_2b2d2b7312b24a62bec4c61b","tool":"read","state":{"status":"completed","input":{"path":".skilled/skills/system-skill-advisor/runtime/lib/scorer/ambiguity.ts"},"output":"Read file .skilled/skills/system-skill-advisor/runtime/lib/scorer/ambiguity.ts, lines 1-125\n1: // ───────────────────────────────────────────────────────────────\n2: // MODULE: Advisor Ambiguity\n3: // ───────────────────────────────────────────────────────────────\n4: \n5: import { COMMAND_BRIDGES } from './projection.js';\n6: import type { AdvisorScoredRecommendation } from './types.js';\n7: \n8: export const AMBIGUITY_MARGIN = 0.05;\n9: export const AMBIGUITY_CONFIDENCE_MARGIN = 0.05;\n10: \n11: // Compute ambiguity from ranking `score` so the cluster aligns\n12: // with the score-based fusion ranking (top-two-by-confidence may not match\n13: // top-two-by-score).\n14: //\n15: // Also compute on `confidence` and union the two\n16: // clusters. Score-margin keeps ranking alignment; confidence-margin restores\n17: // the documented \"0.05 confidence window\" and catches\n18: // cross-domain prompts where confidence is near-tied (user-visible signal)\n19: // even when score gaps just exceed the score margin. A candidate is in the\n20: // ambiguity cluster when EITHER gap is within its respective 0.05 margin —\n21: // \"outside both margins\" is required to be unambiguously ranked.\n22: //\n23: // One exception: a skill the typed-command bound capped just below the top\n24: // (`heldBelow` names the top) sits close to it only because of that cap, and the\n25: // cap already ranked the pair from the user's own command. Counting that gap as\n26: // a tie would report the explicit command as a coin flip. Two skills close on\n27: // their own evidence still cluster.\n28: //\n29: // The confidence margin has one exception of its own. A confidence floor pins\n30: // many unrelated skills to the same confidence, so a floored member never ties\n31: // on confidence alone. When the top is not floored, the member clusters on the\n32: // score margin alone. When both are floored, the equal confidence carries no\n33: // evidence either, so the score margin alone decides there too.\n34: \n35: // A command bridge row and the skill that owns that command are one answer, so\n36: // their near-tie is a single route rather than a choice between two. Two\n37: // different skills, or a command row and a skill that does not own it, stay a\n38: // real tie.\n39: \n40: // The owner comes from the generated bridge data, never from the shape of an\n41: // id: a bridge id says nothing reliable about which skill runs the command.\n42: const OWNER_BY_BRIDGE_ID: ReadonlyMap<string, string> = new Map(\n43:   COMMAND_BRIDGES.flatMap((bridge) => (bridge.ownerSkill ? [[bridge.id, bridge.ownerSkill] as const] : [])),\n44: );\n45: \n46: function ownsCommandBridge(skillId: string, bridgeId: string): boolean {\n47:   return OWNER_BY_BRIDGE_ID.get(bridgeId) === skillId;\n48: }\n49: \n50: function answersSameRoute(\n51:   top: AdvisorScoredRecommendation,\n52:   recommendation: AdvisorScoredRecommendation,\n53: ): boolean {\n54:   if (top.kind === 'command' && recommendation.kind === 'skill') {\n55:     return ownsCommandBridge(recommendation.skill, top.skill);\n56:   }\n57:   if (top.kind === 'skill' && recommendation.kind === 'command') {\n58:     return ownsCommandBridge(top.skill, recommendation.skill);\n59:   }\n60:   return false;\n61: }\n62: \n63: function clustersWithTop(\n64:   top: AdvisorScoredRecommendation,\n65:   recommendation: AdvisorScoredRecommendation,\n66:   applyFloorException: boolean,\n67: ): boolean {\n68:   if (recommendation !== top && recommendation.heldBelow === top.skill) return false;\n69:   const scoreGap = Math.abs(top.score - recommendation.score);\n70:   if (scoreGap <= AMBIGUITY_MARGIN + Number.EPSILON) return true;\n71:   // The score margin already failed, so a floored member has nothing left to\n72:   // cluster on. Its confidence is the floor, not its own evidence.\n73:   const flooredMember = applyFloorException && recommendation.confidenceFloored === true;\n74:   if (flooredMember) return false;\n75:   return Math.abs(top.confidence - recommendation.confidence)\n76:     <= AMBIGUITY_CONFIDENCE_MARGIN + Number.EPSILON;\n77: }\n78: \n79: function ambiguousCluster(\n80:   recommendations: readonly AdvisorScoredRecommendation[],\n81:   applyFloorException = true,\n82: ): AdvisorScoredRecommendation[] {\n83:   const passing = recommendations.filter((recommendation) => recommendation.passes_threshold);\n84:   const [top] = passing;\n85:   if (!top) return [];\n86:   // A member that answers the top's own route is the same recommendation written\n87:   // twice, so it never counts as the rival that makes the top a coin flip.\n88:   return passing.filter((recommendation) => (\n89:     clustersWithTop(top, recommendation, applyFloorException)\n90:     && !answersSameRoute(top, recommendation)\n91:   ));\n92: }\n93: \n94: export function isAmbiguousTopTwo(recommendations: readonly AdvisorScoredRecommendation[]): boolean {\n95:   // Name preserved for back-compat with existing call sites; semantics are\n96:   // now \"is the passing top a member of an ambiguity cluster of size >= 2\".\n97:   return ambiguousCluster(recommendations).length >= 2;\n98: }\n99: \n100: export function wideAmbiguityMembers(\n101:   recommendations: readonly AdvisorScoredRecommendation[],\n102: ): Set<string> {\n103:   // The low-information abstention reads this wider set, so a skill the floor\n104:   // exception dropped cannot slip through as the top of an under-specified\n105:   // prompt.\n106:   const wide = ambiguousCluster(recommendations, false);\n107:   if (wide.length < 2) return new Set();\n108:   return new Set(wide.map((recommendation) => recommendation.skill));\n109: }\n110: \n111: export function applyAmbiguity(\n112:   recommendations: readonly AdvisorScoredRecommendation[],\n113: ): AdvisorScoredRecommendation[] {\n114:   const cluster = ambiguousCluster(recommendations);\n115:   if (cluster.length < 2) return [...recommendations];\n116:   const ambiguousSet = new Set(cluster.map((recommendation) => recommendation.skill));\n117:   return recommendations.map((recommendation) => (\n118:     ambiguousSet.has(recommendation.skill)\n119:       ? {\n120:         ...recommendation,\n121:         ambiguousWith: [...ambiguousSet].filter((skill) => skill !== recommendation.skill),\n122:       }\n123:       : recommendation\n124:   ));\n125: }","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file .skilled/skills/system-skill-advisor/runtime/lib/scorer/ambiguity.ts, lines 1-125\n1: // ───────────────────────────────────────────────────────────────\n2: // MODULE: Advisor Ambiguity\n3: // ───────────────────────────────────────────────────────────────\n4: \n5: import { COMMAND_BRIDGES } from './projection.js';\n6: import type { AdvisorScoredRecommendation } from './types.js';\n7: \n8: export const AMBIGUITY_MARGIN = 0.05;\n9: export const AMBIGUITY_CONFIDENCE_MARGIN = 0.05;\n10: \n11: // Compute ambiguity from ranking `score` so the cluster aligns\n12: // with the score-based fusion ranking (top-two-by-confidence may not match\n13: // top-two-by-score).\n14: //\n15: // Also compute on `confidence` and union the two\n16: // clusters. Score-margin keeps ranking alignment; confidence-margin restores\n17: // the documented \"0.05 confidence window\" and catches\n18: // cross-domain prompts where confidence is near-tied (user-visible signal)\n19: // even when score gaps just exceed the score margin. A candidate is in the\n20: // ambiguity cluster when EITHER gap is within its respective 0.05 margin —\n21: // \"outside both margins\" is required to be unambiguously ranked.\n22: //\n23: // One exception: a skill the typed-command bound capped just below the top\n24: // (`heldBelow` names the top) sits close to it only because of that cap, and the\n25: // cap already ranked the pair from the user's own command. Counting that gap as\n26: // a tie would report the explicit command as a coin flip. Two skills close on\n27: // their own evidence still cluster.\n28: //\n29: // The confidence margin has one exception of its own. A confidence floor pins\n30: // many unrelated skills to the same confidence, so a floored member never ties\n31: // on confidence alone. When the top is not floored, the member clusters on the\n32: // score margin alone. When both are floored, the equal confidence carries no\n33: // evidence either, so the score margin alone decides there too.\n34: \n35: // A command bridge row and the skill that owns that command are one answer, so\n36: // their near-tie is a single route rather than a choice between two. Two\n37: // different skills, or a command row and a skill that does not own it, stay a\n38: // real tie.\n39: \n40: // The owner comes from the generated bridge data, never from the shape of an\n41: // id: a bridge id says nothing reliable about which skill runs the command.\n42: const OWNER_BY_BRIDGE_ID: ReadonlyMap<string, string> = new Map(\n43:   COMMAND_BRIDGES.flatMap((bridge) => (bridge.ownerSkill ? [[bridge.id, bridge.ownerSkill] as const] : [])),\n44: );\n45: \n46: function ownsCommandBridge(skillId: string, bridgeId: string): boolean {\n47:   return OWNER_BY_BRIDGE_ID.get(bridgeId) === skillId;\n48: }\n49: \n50: function answersSameRoute(\n51:   top: AdvisorScoredRecommendation,\n52:   recommendation: AdvisorScoredRecommendation,\n53: ): boolean {\n54:   if (top.kind === 'command' && recommendation.kind === 'skill') {\n55:     return ownsCommandBridge(recommendation.skill, top.skill);\n56:   }\n57:   if (top.kind === 'skill' && recommendation.kind === 'command') {\n58:     return ownsCommandBridge(top.skill, recommendation.skill);\n59:   }\n60:   return false;\n61: }\n62: \n63: function clustersWithTop(\n64:   top: AdvisorScoredRecommendation,\n65:   recommendation: AdvisorScoredRecommendation,\n66:   applyFloorException: boolean,\n67: ): boolean {\n68:   if (recommendation !== top && recommendation.heldBelow === top.skill) return false;\n69:   const scoreGap = Math.abs(top.score - recommendation.score);\n70:   if (scoreGap <= AMBIGUITY_MARGIN + Number.EPSILON) return true;\n71:   // The score margin already failed, so a floored member has nothing left to\n72:   // cluster on. Its confidence is the floor, not its own evidence.\n73:   const flooredMember = applyFloorException && recommendation.confidenceFloored === true;\n74:   if (flooredMember) return false;\n75:   return Math.abs(top.confidence - recommendation.confidence)\n76:     <= AMBIGUITY_CONFIDENCE_MARGIN + Number.EPSILON;\n77: }\n78: \n79: function ambiguousCluster(\n80:   recommendations: readonly AdvisorScoredRecommendation[],\n81:   applyFloorException = true,\n82: ): AdvisorScoredRecommendation[] {\n83:   const passing = recommendations.filter((recommendation) => recommendation.passes_threshold);\n84:   const [top] = passing;\n85:   if (!top) return [];\n86:   // A member that answers the top's own route is the same recommendation written\n87:   // twice, so it never counts as the rival that makes the top a coin flip.\n88:   return passing.filter((recommendation) => (\n89:     clustersWithTop(top, recommendation, applyFloorException)\n90:     && !answersSameRoute(top, recommendation)\n91:   ));\n92: }\n93: \n94: export function isAmbiguousTopTwo(recommendations: readonly AdvisorScoredRecommendation[]): boolean {\n95:   // Name preserved for back-compat with existing call sites; semantics are\n96:   // now \"is the passing top a member of an ambiguity cluster of size >= 2\".\n97:   return ambiguousCluster(recommendations).length >= 2;\n98: }\n99: \n100: export function wideAmbiguityMembers(\n101:   recommendations: readonly AdvisorScoredRecommendation[],\n102: ): Set<string> {\n103:   // The low-information abstention reads this wider set, so a skill the floor\n104:   // exception dropped cannot slip through as the top of an under-specified\n105:   // prompt.\n106:   const wide = ambiguousCluster(recommendations, false);\n107:   if (wide.length < 2) return new Set();\n108:   return new Set(wide.map((recommendation) => recommendation.skill));\n109: }\n110: \n111: export function applyAmbiguity(\n112:   recommendations: readonly AdvisorScoredRecommendation[],\n113: ): AdvisorScoredRecommendation[] {\n114:   const cluster = ambiguousCluster(recommendations);\n115:   if (cluster.length < 2) return [...recommendations];\n116:   const ambiguousSet = new Set(cluster.map((recommendation) => recommendation.skill));\n117:   return recommendations.map((recommendation) => (\n118:     ambiguousSet.has(recommendation.skill)\n119:       ? {\n120:         ...recommendation,\n121:         ambiguousWith: [...ambiguousSet].filter((skill) => skill !== recommendation.skill),\n122:       }\n123:       : recommendation\n124:   ));\n125: }"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\".skilled/skills/system-skill-advisor/runtime/lib/scorer/ambiguity.ts\"}"},"time":{"start":1794550852481,"end":1794550853416}}}}
