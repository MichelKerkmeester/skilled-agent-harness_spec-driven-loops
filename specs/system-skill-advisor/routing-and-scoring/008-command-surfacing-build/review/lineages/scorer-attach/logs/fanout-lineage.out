hase_init, so pass the raw review_focus. fanout-run.cjs\n220:      After all lineages complete, jump directly to phase_synthesis — skip phase_init and\n221:      phase_main_loop entirely (those are the single-executor path). The merge step in\n222:      phase_synthesis will consolidate results across all lineages.\n245:  phase_init:\n389:          open_run: \"Run step_create_state_log.command unchanged. With the hand-written log set aside, it opens the run from the moved config.\"\n420:          skip_to: phase_synthesis\n547:      step_create_state_log:\n653:      step_init_complete:\n1105:                  skip_to: phase_synthesis\n1108:              skip_to: phase_synthesis\n1111:            skip_to: phase_synthesis\n2222:  phase_synthesis:\n2452:      step_update_config_status:\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"cd .skilled/commands/deep/assets && wc -l deep-review-auto.yaml && grep -n \\\"step_init\\\\|step_create_state_log\\\\|step_reduce_state\\\\|step_synthesis\\\\|step_update_config_status\\\\|phase_init\\\\|phase_main_loop\\\\|phase_synthesis\\\" deep-review-auto.yaml | head -60\"}"},"time":{"start":1794550258201,"end":1794550258955}}}}
