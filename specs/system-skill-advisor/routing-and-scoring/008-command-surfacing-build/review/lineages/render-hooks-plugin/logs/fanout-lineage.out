{"type":"tool_use","timestamp":1794550448686,"sessionID":"ses_e2c799690ffeJQrMJ5OzboPGaV","part":{"partID":"prt_1d38abf66001kDKsXZRJma1TjN","sessionID":"ses_e2c799690ffeJQrMJ5OzboPGaV","messageID":"msg_1d38ab412001n1KyyVnmbntfF2","type":"tool","id":"call_4d36994e349940d4ac8dbfe4","tool":"shell","state":{"status":"completed","input":{"command":"cd /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research && for f in .skilled/hooks/shared/session-readers/index.mjs .skilled/hooks/shared/session-readers/claude.mjs .skilled/hooks/shared/session-readers/pi.mjs; do echo \"===FILE $f\"; cat -n \"$f\"; done"},"output":"===FILE .skilled/hooks/shared/session-readers/index.mjs\n     1\t// ───────────────────────────────────────────────────────────────────\n     2\t// MODULE: Session Reader Dispatcher\n     3\t// ───────────────────────────────────────────────────────────────────\n     4\t// One read-only entry point per runtime. A caller names a runtime and an exact\n     5\t// session id; the dispatcher checks the id shape, then delegates. It does not\n     6\t// consult `capabilities`: the callers that offer or redeem history check a\n     7\t// runtime's status there before they read. It owns the one failure envelope,\n     8\t// so a reader may fail but never throw across this boundary, and a projection\n     9\t// defect can never return a partial list.\n    10\t\n    11\t// ─────────────────────────────────────────────────────────────────────────────\n    12\t// 1. IMPORTS\n    13\t// ─────────────────────────────────────────────────────────────────────────────\n    14\t\n    15\timport { loadClaudeSession } from './claude.mjs';\n    16\timport { loadCodexSession } from './codex.mjs';\n    17\timport { loadCursorSession } from './cursor.mjs';\n    18\timport { loadDevinSession } from './devin.mjs';\n    19\timport { loadDshSession } from './dsh.mjs';\n    20\timport { loadOpenCodeSession } from './opencode.mjs';\n    21\timport { loadPiSession } from './pi.mjs';\n    22\timport { projectEntries } from './project.mjs';\n    23\t\n    24\t// ─────────────────────────────────────────────────────────────────────────────\n    25\t// 2. CAPABILITIES\n    26\t// ─────────────────────────────────────────────────────────────────────────────\n    27\t\n    28\texport const capabilities = Object.freeze({\n    29\t  claude: Object.freeze({\n    30\t    status: 'ready',\n    31\t    locatorKind: 'transcript_path',\n    32\t    storeRoot: '~/.claude/projects',\n    33\t  }),\n    34\t  codex: Object.freeze({\n    35\t    status: 'ready',\n    36\t    locatorKind: 'transcript_path',\n    37\t    storeRoot: '$CODEX_HOME/sessions',\n    38\t  }),\n    39\t  pi: Object.freeze({\n    40\t    status: 'ready',\n    41\t    locatorKind: 'live_branch_or_session_log',\n    42\t    storeRoot: '~/.pi/agent/sessions',\n    43\t  }),\n    44\t  opencode: Object.freeze({\n    45\t    status: 'ready',\n    46\t    locatorKind: 'session-store',\n    47\t    storeRoot: '$XDG_DATA_HOME/opencode/opencode.db',\n    48\t  }),\n    49\t  devin: Object.freeze({\n    50\t    status: 'ready',\n    51\t    locatorKind: 'transcript_file',\n    52\t    storeRoot: '$XDG_DATA_HOME/devin/cli/sessions.db',\n    53\t  }),\n    54\t  dsh: Object.freeze({\n    55\t    status: 'ready',\n    56\t    locatorKind: 'session_log',\n    57\t    storeRoot: '$DSH_HOME/sessions',\n    58\t  }),\n    59\t  cursor: Object.freeze({\n    60\t    status: 'gated',\n    61\t    locatorKind: 'capability_flag',\n    62\t    storeRoot: '(unconfirmed)',\n    63\t    reason: 'PreCompact delivery is unconfirmed, so there is no trustworthy capture point',\n    64\t  }),\n    65\t});\n    66\t\n    67\tconst READERS = Object.freeze({\n    68\t  claude: loadClaudeSession,\n    69\t  codex: loadCodexSession,\n    70\t  pi: loadPiSession,\n    71\t  opencode: loadOpenCodeSession,\n    72\t  devin: loadDevinSession,\n    73\t  dsh: loadDshSession,\n    74\t  cursor: loadCursorSession,\n    75\t});\n    76\t\n    77\t// ─────────────────────────────────────────────────────────────────────────────\n    78\t// 3. ENVELOPE\n    79\t// ─────────────────────────────────────────────────────────────────────────────\n    80\t\n    81\tfunction failure(code) {\n    82\t  return { ok: false, code };\n    83\t}\n    84\t\n    85\tfunction hasSessionId(sessionId) {\n    86\t  return typeof sessionId === 'string' && sessionId.trim().length > 0;\n    87\t}\n    88\t\n    89\tfunction normalize(options) {\n    90\t  return options && typeof options === 'object' ? options : {};\n    91\t}\n    92\t\n    93\t// ─────────────────────────────────────────────────────────────────────────────\n    94\t// 4. DISPATCH\n    95\t// ─────────────────────────────────────────────────────────────────────────────\n    96\t\n    97\tasync function load(options) {\n    98\t  const { runtime, sessionId } = options;\n    99\t  if (!hasSessionId(sessionId)) return failure('locator_unavailable');\n   100\t\n   101\t  const reader = READERS[runtime];\n   102\t  if (!reader) return failure('capability_gated');\n   103\t\n   104\t  return reader(options);\n   105\t}\n   106\t\n   107\t/**\n   108\t * Resolve one exact session and return the shared entry list.\n   109\t * @param {{ runtime: string, sessionId: string }} options - Runtime and exact id,\n   110\t *   plus the runtime-specific locator fields its reader accepts.\n   111\t * @returns {Promise<{ ok: true, source: object, items: Array<object> }\n   112\t *   | { ok: false, code: string }>}\n   113\t */\n   114\texport async function readSession(input) {\n   115\t  const options = normalize(input);\n   116\t  try {\n   117\t    const loaded = await load(options);\n   118\t    if (!loaded.ok) return loaded;\n   119\t\n   120\t    const projected = projectEntries(loaded.records);\n   121\t    if (!projected.ok) return failure('store_unreadable');\n   122\t\n   123\t    return { ok: true, source: loaded.source, items: projected.items };\n   124\t  } catch {\n   125\t    return failure('store_unreadable');\n   126\t  }\n   127\t}\n   128\t\n   129\t/**\n   130\t * Resolve one exact session and return its raw neutral records.\n   131\t * This is the only raw path; `readSession` is the projected one.\n   132\t */\n   133\texport async function loadSession(input) {\n   134\t  const options = normalize(input);\n   135\t  try {\n   136\t    const loaded = await load(options);\n   137\t    if (!loaded.ok) return loaded;\n   138\t    return {\n   139\t      ok: true,\n   140\t      source: loaded.source,\n   141\t      records: loaded.records,\n   142\t      ...(Array.isArray(loaded.injected) ? { injected: loaded.injected } : {}),\n   143\t    };\n   144\t  } catch {\n   145\t    return failure('store_unreadable');\n   146\t  }\n   147\t}\n===FILE .skilled/hooks/shared/session-readers/claude.mjs\n     1\t// ───────────────────────────────────────────────────────────────────\n     2\t// MODULE: Claude Transcript Reader\n     3\t// ───────────────────────────────────────────────────────────────────\n     4\t// Claude hands a hook the transcript it is already writing. The reader trusts\n     5\t// that path only after the identity guard proves it lives under the Claude\n     6\t// store and that the file's own session id equals the requested one. A\n     7\t// subagent transcript is a side conversation, so it can never stand in for the\n     8\t// parent session.\n     9\t\n    10\t// ─────────────────────────────────────────────────────────────────────────────\n    11\t// 1. IMPORTS\n    12\t// ─────────────────────────────────────────────────────────────────────────────\n    13\t\n    14\timport { readFileSync, statSync } from 'node:fs';\n    15\timport { basename, join } from 'node:path';\n    16\timport { homeDir, isSafeSessionId, resolveInside } from './identity.mjs';\n    17\timport {\n    18\t  contentText,\n    19\t  imageBlock,\n    20\t  parseJsonObject,\n    21\t  textBlock,\n    22\t  thinkingBlock,\n    23\t  toolCallBlock,\n    24\t} from './project.mjs';\n    25\t\n    26\t// ─────────────────────────────────────────────────────────────────────────────\n    27\t// 2. CONSTANTS\n    28\t// ─────────────────────────────────────────────────────────────────────────────\n    29\t\n    30\tconst RUNTIME = 'claude';\n    31\tconst LOCATOR_KIND = 'transcript_path';\n    32\t\n    33\t// ─────────────────────────────────────────────────────────────────────────────\n    34\t// 3. STORE\n    35\t// ─────────────────────────────────────────────────────────────────────────────\n    36\t\n    37\texport function claudeStoreRoot(options = {}) {\n    38\t  return options.claudeRoot ?? join(homeDir(options), '.claude', 'projects');\n    39\t}\n    40\t\n    41\tfunction recordedSessionId(entries, transcriptPath) {\n    42\t  const declared = entries.find((entry) => typeof entry?.sessionId === 'string' && entry.sessionId)?.sessionId;\n    43\t  if (declared) return declared;\n    44\t  return basename(transcriptPath).replace(/\\.jsonl$/, '');\n    45\t}\n    46\t\n    47\tfunction isSubagentPath(filePath) {\n    48\t  return filePath.split(/[\\\\/]+/).includes('subagents');\n    49\t}\n    50\t\n    51\t// ─────────────────────────────────────────────────────────────────────────────\n    52\t// 4. ENTRY MAPPING\n    53\t// ─────────────────────────────────────────────────────────────────────────────\n    54\t\n    55\tfunction assistantBlocks(content) {\n    56\t  const blocks = [];\n    57\t  for (const block of Array.isArray(content) ? content : []) {\n    58\t    if (!block || typeof block !== 'object') continue;\n    59\t    if (block.type === 'text' && typeof block.text === 'string') {\n    60\t      blocks.push(textBlock(block.text));\n    61\t    } else if (block.type === 'thinking' && typeof block.thinking === 'string') {\n    62\t      blocks.push(thinkingBlock(block.thinking));\n    63\t    } else if (block.type === 'tool_use' && typeof block.id === 'string' && typeof block.name === 'string') {\n    64\t      blocks.push(toolCallBlock({ id: block.id, name: block.name, arguments: block.input }));\n    65\t    } else if (block.type === 'image' && block.source) {\n    66\t      blocks.push(imageBlock({\n    67\t        data: block.source.data,\n    68\t        mimeType: block.source.media_type ?? block.source.mediaType,\n    69\t      }));\n    70\t    }\n    71\t  }\n    72\t  return blocks;\n    73\t}\n    74\t\n    75\tfunction toolResultBlocks(content) {\n    76\t  if (typeof content === 'string') return [textBlock(content)];\n    77\t  const blocks = [];\n    78\t  for (const item of Array.isArray(content) ? content : []) {\n    79\t    if (!item || typeof item !== 'object') continue;\n    80\t    if (item.type === 'text' && typeof item.text === 'string') blocks.push(textBlock(item.text));\n    81\t    if (item.type === 'image' && item.source) {\n    82\t      blocks.push(imageBlock({\n    83\t        data: item.source.data,\n    84\t        mimeType: item.source.media_type ?? item.source.mediaType,\n    85\t      }));\n    86\t    }\n    87\t  }\n    88\t  return blocks;\n    89\t}\n    90\t\n    91\tfunction userRecords(entry, index, timestamp) {\n    92\t  const content = entry?.message?.content;\n    93\t  const uuid = typeof entry.uuid === 'string' && entry.uuid ? entry.uuid : `claude-entry-${index}`;\n    94\t  const blocks = Array.isArray(content) ? content.filter((block) => block && typeof block === 'object') : [];\n    95\t  const toolResults = blocks.filter((block) => block.type === 'tool_result' && typeof block.tool_use_id === 'string');\n    96\t\n    97\t  // A tool result must directly follow the assistant call it answers, or the\n    98\t  // projection treats the whole turn as broken. A user message that also\n    99\t  // carries typed text or an image therefore emits its results first and keeps\n   100\t  // the operator content as the user entry that follows them.\n   101\t  const records = toolResults.map((block) => ({\n   102\t    id: `${uuid}:result:${block.tool_use_id}`.slice(0, 128),\n   103\t    role: 'toolResult',\n   104\t    timestamp,\n   105\t    content: toolResultBlocks(block.content),\n   106\t    toolCallId: block.tool_use_id,\n   107\t    isError: block.is_error === true,\n   108\t  }));\n   109\t\n   110\t  const text = contentText(content);\n   111\t  const images = blocks.filter((block) => block.type === 'image' && block.source);\n   112\t  if (text || images.length > 0) {\n   113\t    const mapped = blocks.length > 0\n   114\t      ? blocks\n   115\t        .filter((block) => (block.type === 'text' && typeof block.text === 'string')\n   116\t          || (block.type === 'image' && block.source))\n   117\t        .map((block) => (\n   118\t          block.type === 'text'\n   119\t            ? textBlock(block.text)\n   120\t            : imageBlock({ data: block.source?.data, mimeType: block.source?.media_type ?? block.source?.mediaType })\n   121\t        ))\n   122\t      : [textBlock(text)];\n   123\t    records.push({ id: uuid, role: 'user', timestamp, content: mapped });\n   124\t  }\n   125\t  return records;\n   126\t}\n   127\t\n   128\t// Claude Code records the printed output of a local command, such as the\n   129\t// `/compact` report, as a user entry. The operator never typed it, so it is\n   130\t// host output rather than conversation and stays out of the history. The\n   131\t// command the operator typed stays in.\n   132\tconst LOCAL_COMMAND_OUTPUT = /^\\s*<local-command-(?:stdout|stderr)>/u;\n   133\t\n   134\tfunction isLocalCommandOutput(entry) {\n   135\t  const content = entry?.message?.content;\n   136\t  return typeof content === 'string' && LOCAL_COMMAND_OUTPUT.test(content);\n   137\t}\n   138\t\n   139\tfunction recordsFromEntries(entries) {\n   140\t  const records = [];\n   141\t  entries.forEach((entry, index) => {\n   142\t    if (!entry || typeof entry !== 'object') return;\n   143\t    if (entry.isSidechain === true || entry.isMeta === true || entry.isCompactSummary === true) return;\n   144\t\n   145\t    const timestamp = entry.timestamp;\n   146\t    if (entry.type === 'assistant') {\n   147\t      const id = typeof entry.uuid === 'string' && entry.uuid ? entry.uuid : `claude-entry-${index}`;\n   148\t      const content = assistantBlocks(entry?.message?.content);\n   149\t      if (content.length > 0) records.push({ id, role: 'assistant', timestamp, content });\n   150\t      return;\n   151\t    }\n   152\t\n   153\t    if (entry.type === 'user') {\n   154\t      if (isLocalCommandOutput(entry)) return;\n   155\t      records.push(...userRecords(entry, index, timestamp));\n   156\t    }\n   157\t  });\n   158\t  return records;\n   159\t}\n   160\t\n   161\t// Claude records the context a hook adds as an attachment entry rather than a\n   162\t// message, so the history never carried it. A caller that asks whether the\n   163\t// advisor brief reached the turn needs that text, and it has to stay apart from\n   164\t// the operator and assistant records.\n   165\tfunction attachmentText(content) {\n   166\t  if (typeof content === 'string') return content;\n   167\t  if (!Array.isArray(content)) return '';\n   168\t  return content\n   169\t    .map((item) => (typeof item === 'string' ? item : item?.text))\n   170\t    .filter((text) => typeof text === 'string' && text.length > 0)\n   171\t    .join('\\n');\n   172\t}\n   173\t\n   174\tfunction injectedFromEntries(entries) {\n   175\t  const injected = [];\n   176\t  for (const entry of entries) {\n   177\t    if (!entry || typeof entry !== 'object') continue;\n   178\t    if (entry.type !== 'attachment' || entry?.attachment?.type !== 'hook_additional_context') continue;\n   179\t    const text = attachmentText(entry.attachment.content);\n   180\t    if (text) injected.push({ source: 'hook_additional_context', text });\n   181\t  }\n   182\t  return injected;\n   183\t}\n   184\t\n   185\t// ─────────────────────────────────────────────────────────────────────────────\n   186\t// 5. LOADER\n   187\t// ─────────────────────────────────────────────────────────────────────────────\n   188\t\n   189\texport function loadClaudeSession({ sessionId, transcriptPath, ...options } = {}) {\n   190\t  if (typeof transcriptPath !== 'string' || !transcriptPath.trim()) {\n   191\t    return { ok: false, code: 'locator_unavailable' };\n   192\t  }\n   193\t  if (!isSafeSessionId(sessionId)) {\n   194\t    return { ok: false, code: sessionId ? 'session_mismatch' : 'locator_unavailable' };\n   195\t  }\n   196\t  if (isSubagentPath(transcriptPath)) {\n   197\t    return { ok: false, code: 'session_mismatch' };\n   198\t  }\n   199\t\n   200\t  // Containment is decided before the file is opened, so a path outside the\n   201\t  // store is refused without its content ever being read.\n   202\t  const root = claudeStoreRoot(options);\n   203\t  const containment = resolveInside({ path: transcriptPath, root });\n   204\t  if (!containment.ok) {\n   205\t    if (containment.code === 'session_mismatch') return containment;\n   206\t    try {\n   207\t      statSync(root);\n   208\t      return { ok: false, code: 'session_not_found' };\n   209\t    } catch {\n   210\t      return { ok: false, code: 'store_unreadable' };\n   211\t    }\n   212\t  }\n   213\t  const storePath = containment.path;\n   214\t\n   215\t  let raw;\n   216\t  try {\n   217\t    raw = readFileSync(transcriptPath, 'utf8');\n   218\t  } catch {\n   219\t    try {\n   220\t      statSync(root);\n   221\t      return { ok: false, code: 'session_not_found' };\n   222\t    } catch {\n   223\t      return { ok: false, code: 'store_unreadable' };\n   224\t    }\n   225\t  }\n   226\t\n   227\t  const entries = [];\n   228\t  for (const line of raw.split('\\n')) {\n   229\t    if (!line.trim()) continue;\n   230\t    const parsed = parseJsonObject(line);\n   231\t    if (parsed) entries.push(parsed);\n   232\t  }\n   233\t\n   234\t  if (recordedSessionId(entries, transcriptPath) !== sessionId) {\n   235\t    return { ok: false, code: 'session_mismatch' };\n   236\t  }\n   237\t\n   238\t  return {\n   239\t    ok: true,\n   240\t    source: {\n   241\t      runtime: RUNTIME,\n   242\t      sessionId,\n   243\t      locatorKind: LOCATOR_KIND,\n   244\t      storePath,\n   245\t    },\n   246\t    records: recordsFromEntries(entries),\n   247\t    injected: injectedFromEntries(entries),\n   248\t  };\n   249\t}\n===FILE .skilled/hooks/shared/session-readers/pi.mjs\n     1\t// ───────────────────────────────────────────────────────────────────\n     2\t// MODULE: Pi Session Reader\n     3\t// ───────────────────────────────────────────────────────────────────\n     4\t// Pi exposes its live branch in-process, so the current session needs no disk\n     5\t// read at all. An older session is found only by an exact header id inside the\n     6\t// caller's project directory. The header's `cwd` is the tie-breaker because\n     7\t// separator flattening lets two projects share one directory name.\n     8\t\n     9\t// ─────────────────────────────────────────────────────────────────────────────\n    10\t// 1. IMPORTS\n    11\t// ─────────────────────────────────────────────────────────────────────────────\n    12\t\n    13\timport { Buffer } from 'node:buffer';\n    14\timport { closeSync, openSync, readFileSync, readSync, readdirSync, statSync } from 'node:fs';\n    15\timport { join } from 'node:path';\n    16\timport {\n    17\t  guardSessionPath,\n    18\t  homeDir,\n    19\t  isSafeSessionId,\n    20\t  samePath,\n    21\t} from './identity.mjs';\n    22\timport {\n    23\t  contentText,\n    24\t  parseJsonObject,\n    25\t  textBlock,\n    26\t  thinkingBlock,\n    27\t  toolCallBlock,\n    28\t} from './project.mjs';\n    29\t\n    30\t// ─────────────────────────────────────────────────────────────────────────────\n    31\t// 2. CONSTANTS\n    32\t// ─────────────────────────────────────────────────────────────────────────────\n    33\t\n    34\tconst RUNTIME = 'pi';\n    35\t// One vocabulary across the capability table and both source envelopes.\n    36\tconst LOCATOR_KIND = 'live_branch_or_session_log';\n    37\tconst TRANSCRIPT_EXT = '.jsonl';\n    38\tconst HEADER_PROBE_BYTES = 64 * 1024;\n    39\t\n    40\t// ─────────────────────────────────────────────────────────────────────────────\n    41\t// 3. STORE\n    42\t// ─────────────────────────────────────────────────────────────────────────────\n    43\t\n    44\texport function piStoreRoot(options = {}) {\n    45\t  return options.piRoot ?? join(homeDir(options), '.pi', 'agent', 'sessions');\n    46\t}\n    47\t\n    48\texport function piProjectDirectory(projectDir) {\n    49\t  const projectKey = projectDir.replace(/^\\/+/, '').replaceAll('/', '-');\n    50\t  return '--' + projectKey + '--';\n    51\t}\n    52\t\n    53\tfunction headerOf(filePath) {\n    54\t  // Only the first line is needed, so the probe reads a bounded prefix rather\n    55\t  // than a whole session file that may run to many megabytes.\n    56\t  const buffer = Buffer.alloc(HEADER_PROBE_BYTES);\n    57\t  const fd = openSync(filePath, 'r');\n    58\t  let length;\n    59\t  try {\n    60\t    length = readSync(fd, buffer, 0, HEADER_PROBE_BYTES, 0);\n    61\t  } finally {\n    62\t    closeSync(fd);\n    63\t  }\n    64\t  const head = buffer.subarray(0, length).toString('utf8');\n    65\t  return parseJsonObject(head.split('\\n')[0]);\n    66\t}\n    67\t\n    68\t// Session file names start with their creation time and end with the session\n    69\t// id, so the id filters candidates before any file is opened.\n    70\tfunction idFromFileName(fileName) {\n    71\t  const withoutExtension = fileName.endsWith(TRANSCRIPT_EXT)\n    72\t    ? fileName.slice(0, -TRANSCRIPT_EXT.length)\n    73\t    : fileName;\n    74\t  const separator = withoutExtension.indexOf('_');\n    75\t  return separator === -1 ? withoutExtension : withoutExtension.slice(separator + 1) || withoutExtension;\n    76\t}\n    77\t\n    78\tfunction liveSessionId(sessionManager) {\n    79\t  if (!sessionManager || typeof sessionManager !== 'object') return null;\n    80\t  const value = typeof sessionManager.getSessionId === 'function'\n    81\t    ? sessionManager.getSessionId()\n    82\t    : sessionManager.sessionId;\n    83\t  return typeof value === 'string' && value ? value : null;\n    84\t}\n    85\t\n    86\tfunction branchEntries(sessionManager) {\n    87\t  if (typeof sessionManager.getBranch === 'function') return sessionManager.getBranch();\n    88\t  if (Array.isArray(sessionManager.branch)) return sessionManager.branch;\n    89\t  return null;\n    90\t}\n    91\t\n    92\t// ─────────────────────────────────────────────────────────────────────────────\n    93\t// 4. ENTRY MAPPING\n    94\t// ─────────────────────────────────────────────────────────────────────────────\n    95\t\n    96\tfunction assistantBlocks(content) {\n    97\t  const blocks = [];\n    98\t  for (const item of Array.isArray(content) ? content : []) {\n    99\t    if (!item || typeof item !== 'object') continue;\n   100\t    if (item.type === 'text' && typeof item.text === 'string') {\n   101\t      blocks.push(textBlock(item.text));\n   102\t    } else if (item.type === 'thinking' && typeof item.thinking === 'string') {\n   103\t      blocks.push(thinkingBlock(item.thinking));\n   104\t    } else if (item.type === 'toolCall' && typeof item.id === 'string' && typeof item.name === 'string') {\n   105\t      blocks.push(toolCallBlock({ id: item.id, name: item.name, arguments: item.arguments }));\n   106\t    }\n   107\t  }\n   108\t  return blocks;\n   109\t}\n   110\t\n   111\tfunction recordsFromLines(lines) {\n   112\t  const records = [];\n   113\t\n   114\t  lines.forEach((line, index) => {\n   115\t    if (line?.type !== 'message' || !line.message || typeof line.message !== 'object') return;\n   116\t    const message = line.message;\n   117\t    const id = typeof line.id === 'string' && line.id ? line.id : `pi-entry-${index}`;\n   118\t    const timestamp = line.timestamp;\n   119\t\n   120\t    if (message.role === 'user') {\n   121\t      const blocks = [];\n   122\t      for (const item of Array.isArray(message.content) ? message.content : []) {\n   123\t        if (item?.type === 'text' && typeof item.text === 'string') blocks.push(textBlock(item.text));\n   124\t      }\n   125\t      // Pi records harness injections as their own `custom_message` entry type,\n   126\t      // which this mapping never reads, so a user message is operator content\n   127\t      // even when it opens with '<'.\n   128\t      const text = contentText(blocks);\n   129\t      if (!text) return;\n   130\t      records.push({ id, role: 'user', timestamp, content: blocks });\n   131\t      return;\n   132\t    }\n   133\t\n   134\t    if (message.role === 'assistant') {\n   135\t      const blocks = assistantBlocks(message.content);\n   136\t      if (blocks.length === 0) return;\n   137\t      records.push({ id, role: 'assistant', timestamp, content: blocks });\n   138\t      return;\n   139\t    }\n   140\t\n   141\t    if (message.role === 'toolResult') {\n   142\t      if (typeof message.toolCallId !== 'string' || !message.toolCallId) return;\n   143\t      const blocks = [];\n   144\t      for (const item of Array.isArray(message.content) ? message.content : []) {\n   145\t        if (item?.type === 'text' && typeof item.text === 'string') blocks.push(textBlock(item.text));\n   146\t      }\n   147\t      const record = {\n   148\t        id,\n   149\t        role: 'toolResult',\n   150\t        timestamp,\n   151\t        content: blocks.length > 0 ? blocks : [textBlock(contentText(message.content))],\n   152\t        toolCallId: message.toolCallId,\n   153\t      };\n   154\t      if (message.isError === true) record.isError = true;\n   155\t      records.push(record);\n   156\t    }\n   157\t  });\n   158\t\n   159\t  return records;\n   160\t}\n   161\t\n   162\t// A `custom_message` is context a hook or harness put into the session rather\n   163\t// than a turn the operator wrote, so it stays out of `records` and travels as\n   164\t// its own list. The custom type names the producer when the entry carries one.\n   165\tfunction injectedFromLines(lines) {\n   166\t  const injected = [];\n   167\t  for (const line of lines) {\n   168\t    if (line?.type !== 'custom_message') continue;\n   169\t    const text = contentText(line.content);\n   170\t    if (!text) continue;\n   171\t    injected.push({ source: line.customType ?? 'custom_message', text });\n   172\t  }\n   173\t  return injected;\n   174\t}\n   175\t\n   176\t// ─────────────────────────────────────────────────────────────────────────────\n   177\t// 5. LOADER\n   178\t// ─────────────────────────────────────────────────────────────────────────────\n   179\t\n   180\tfunction liveResult({ sessionId, sessionManager, options }) {\n   181\t  const entries = branchEntries(sessionManager);\n   182\t  if (!Array.isArray(entries)) return { ok: false, code: 'store_unreadable' };\n   183\t  if (entries.length === 0) return { ok: false, code: 'session_not_found' };\n   184\t  return {\n   185\t    ok: true,\n   186\t    source: {\n   187\t      runtime: RUNTIME,\n   188\t      sessionId,\n   189\t      locatorKind: LOCATOR_KIND,\n   190\t      mode: 'live',\n   191\t      storePath: typeof sessionManager.getSessionFile === 'function'\n   192\t        ? String(sessionManager.getSessionFile())\n   193\t        : piStoreRoot(options),\n   194\t    },\n   195\t    records: recordsFromLines(entries),\n   196\t    injected: injectedFromLines(entries),\n   197\t  };\n   198\t}\n   199\t\n   200\tfunction diskResult({ sessionId, projectDir, options }) {\n   201\t  if (typeof projectDir !== 'string' || !projectDir.trim()) {\n   202\t    return { ok: false, code: 'locator_unavailable' };\n   203\t  }\n   204\t\n   205\t  const root = piStoreRoot(options);\n   206\t  const directory = join(root, piProjectDirectory(projectDir));\n   207\t\n   208\t  let names;\n   209\t  try {\n   210\t    names = readdirSync(directory);\n   211\t  } catch {\n   212\t    // A missing root means the store itself cannot be read; a known root with\n   213\t    // no project directory means this project simply has no saved session.\n   214\t    try {\n   215\t      statSync(root);\n   216\t      return { ok: false, code: 'session_not_found' };\n   217\t    } catch {\n   218\t      return { ok: false, code: 'store_unreadable' };\n   219\t    }\n   220\t  }\n   221\t\n   222\t  const candidates = names.filter(\n   223\t    (name) => name.endsWith(TRANSCRIPT_EXT) && idFromFileName(name) === sessionId,\n   224\t  );\n   225\t  if (candidates.length === 0) return { ok: false, code: 'session_not_found' };\n   226\t  // Two files that decode to one id are two possible sessions, and neither the\n   227\t  // name nor the header can choose between them, so a recovery read refuses\n   228\t  // rather than guessing.\n   229\t  if (candidates.length > 1) return { ok: false, code: 'session_ambiguous' };\n   230\t\n   231\t  const filePath = join(directory, candidates[0]);\n   232\t  let header;\n   233\t  try {\n   234\t    header = headerOf(filePath);\n   235\t  } catch {\n   236\t    return { ok: false, code: 'store_unreadable' };\n   237\t  }\n   238\t\n   239\t  if (header?.type !== 'session' || header.id !== sessionId) {\n   240\t    return { ok: false, code: 'session_mismatch' };\n   241\t  }\n   242\t  if (!samePath(header.cwd, projectDir)) {\n   243\t    return { ok: false, code: 'session_mismatch' };\n   244\t  }\n   245\t\n   246\t  const guard = guardSessionPath({\n   247\t    path: filePath,\n   248\t    root,\n   249\t    sessionId,\n   250\t    recordedId: header.id,\n   251\t  });\n   252\t  if (!guard.ok) return guard;\n   253\t\n   254\t  let raw;\n   255\t  try {\n   256\t    raw = readFileSync(filePath, 'utf8');\n   257\t  } catch {\n   258\t    return { ok: false, code: 'store_unreadable' };\n   259\t  }\n   260\t\n   261\t  const lines = [];\n   262\t  for (const line of raw.split('\\n')) {\n   263\t    if (!line.trim()) continue;\n   264\t    const parsed = parseJsonObject(line);\n   265\t    if (parsed) lines.push(parsed);\n   266\t  }\n   267\t\n   268\t  return {\n   269\t    ok: true,\n   270\t    source: {\n   271\t      runtime: RUNTIME,\n   272\t      sessionId,\n   273\t      locatorKind: LOCATOR_KIND,\n   274\t      mode: 'disk',\n   275\t      storePath: guard.path,\n   276\t    },\n   277\t    records: recordsFromLines(lines),\n   278\t    injected: injectedFromLines(lines),\n   279\t  };\n   280\t}\n   281\t\n   282\texport function loadPiSession({ sessionId, projectDir, sessionManager, ...options } = {}) {\n   283\t  if (!isSafeSessionId(sessionId)) {\n   284\t    return { ok: false, code: sessionId ? 'session_mismatch' : 'locator_unavailable' };\n   285\t  }\n   286\t\n   287\t  if (sessionManager && liveSessionId(sessionManager) === sessionId) {\n   288\t    return liveResult({ sessionId, sessionManager, options });\n   289\t  }\n   290\t  return diskResult({ sessionId, projectDir, options });\n   291\t}\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"===FILE .skilled/hooks/shared/session-readers/index.mjs\n     1\t// ───────────────────────────────────────────────────────────────────\n     2\t// MODULE: Session Reader Dispatcher\n     3\t// ───────────────────────────────────────────────────────────────────\n     4\t// One read-only entry point per runtime. A caller names a runtime and an exact\n     5\t// session id; the dispatcher checks the id shape, then delegates. It does not\n     6\t// consult `capabilities`: the callers that offer or redeem history check a\n     7\t// runtime's status there before they read. It owns the one failure envelope,\n     8\t// so a reader may fail but never throw across this boundary, and a projection\n     9\t// defect can never return a partial list.\n    10\t\n    11\t// ─────────────────────────────────────────────────────────────────────────────\n    12\t// 1. IMPORTS\n    13\t// ─────────────────────────────────────────────────────────────────────────────\n    14\t\n    15\timport { loadClaudeSession } from './claude.mjs';\n    16\timport { loadCodexSession } from './codex.mjs';\n    17\timport { loadCursorSession } from './cursor.mjs';\n    18\timport { loadDevinSession } from './devin.mjs';\n    19\timport { loadDshSession } from './dsh.mjs';\n    20\timport { loadOpenCodeSession } from './opencode.mjs';\n    21\timport { loadPiSession } from './pi.mjs';\n    22\timport { projectEntries } from './project.mjs';\n    23\t\n    24\t// ─────────────────────────────────────────────────────────────────────────────\n    25\t// 2. CAPABILITIES\n    26\t// ─────────────────────────────────────────────────────────────────────────────\n    27\t\n    28\texport const capabilities = Object.freeze({\n    29\t  claude: Object.freeze({\n    30\t    status: 'ready',\n    31\t    locatorKind: 'transcript_path',\n    32\t    storeRoot: '~/.claude/projects',\n    33\t  }),\n    34\t  codex: Object.freeze({\n    35\t    status: 'ready',\n    36\t    locatorKind: 'transcript_path',\n    37\t    storeRoot: '$CODEX_HOME/sessions',\n    38\t  }),\n    39\t  pi: Object.freeze({\n    40\t    status: 'ready',\n    41\t    locatorKind: 'live_branch_or_session_log',\n    42\t    storeRoot: '~/.pi/agent/sessions',\n    43\t  }),\n    44\t  opencode: Object.freeze({\n    45\t    status: 'ready',\n    46\t    locatorKind: 'session-store',\n    47\t    storeRoot: '$XDG_DATA_HOME/opencode/opencode.db',\n    48\t  }),\n    49\t  devin: Object.freeze({\n    50\t    status: 'ready',\n    51\t    locatorKind: 'transcript_file',\n    52\t    storeRoot: '$XDG_DATA_HOME/devin/cli/sessions.db',\n    53\t  }),\n    54\t  dsh: Object.freeze({\n    55\t    status: 'ready',\n    56\t    locatorKind: 'session_log',\n    57\t    storeRoot: '$DSH_HOME/sessions',\n    58\t  }),\n    59\t  cursor: Object.freeze({\n    60\t    status: 'gated',\n    61\t    locatorKind: 'capability_flag',\n    62\t    storeRoot: '(unconfirmed)',\n    63\t    reason: 'PreCompact delivery is unconfirmed, so there is no trustworthy capture point',\n    64\t  }),\n    65\t});\n    66\t\n    67\tconst READERS = Object.freeze({\n    68\t  claude: loadClaudeSession,\n    69\t  codex: loadCodexSession,\n    70\t  pi: loadPiSession,\n    71\t  opencode: loadOpenCodeSession,\n    72\t  devin: loadDevinSession,\n    73\t  dsh: loadDshSession,\n    74\t  cursor: loadCursorSession,\n    75\t});\n    76\t\n    77\t// ─────────────────────────────────────────────────────────────────────────────\n    78\t// 3. ENVELOPE\n    79\t// ─────────────────────────────────────────────────────────────────────────────\n    80\t\n    81\tfunction failure(code) {\n    82\t  return { ok: false, code };\n    83\t}\n    84\t\n    85\tfunction hasSessionId(sessionId) {\n    86\t  return typeof sessionId === 'string' && sessionId.trim().length > 0;\n    87\t}\n    88\t\n    89\tfunction normalize(options) {\n    90\t  return options && typeof options === 'object' ? options : {};\n    91\t}\n    92\t\n    93\t// ─────────────────────────────────────────────────────────────────────────────\n    94\t// 4. DISPATCH\n    95\t// ─────────────────────────────────────────────────────────────────────────────\n    96\t\n    97\tasync function load(options) {\n    98\t  const { runtime, sessionId } = options;\n    99\t  if (!hasSessionId(sessionId)) return failure('locator_unavailable');\n   100\t\n   101\t  const reader = READERS[runtime];\n   102\t  if (!reader) return failure('capability_gated');\n   103\t\n   104\t  return reader(options);\n   105\t}\n   106\t\n   107\t/**\n   108\t * Resolve one exact session and return the shared entry list.\n   109\t * @param {{ runtime: string, sessionId: string }} options - Runtime and exact id,\n   110\t *   plus the runtime-specific locator fields its reader accepts.\n   111\t * @returns {Promise<{ ok: true, source: object, items: Array<object> }\n   112\t *   | { ok: false, code: string }>}\n   113\t */\n   114\texport async function readSession(input) {\n   115\t  const options = normalize(input);\n   116\t  try {\n   117\t    const loaded = await load(options);\n   118\t    if (!loaded.ok) return loaded;\n   119\t\n   120\t    const projected = projectEntries(loaded.records);\n   121\t    if (!projected.ok) return failure('store_unreadable');\n   122\t\n   123\t    return { ok: true, source: loaded.source, items: projected.items };\n   124\t  } catch {\n   125\t    return failure('store_unreadable');\n   126\t  }\n   127\t}\n   128\t\n   129\t/**\n   130\t * Resolve one exact session and return its raw neutral records.\n   131\t * This is the only raw path; `readSession` is the projected one.\n   132\t */\n   133\texport async function loadSession(input) {\n   134\t  const options = normalize(input);\n   135\t  try {\n   136\t    const loaded = await load(options);\n   137\t    if (!loaded.ok) return loaded;\n   138\t    return {\n   139\t      ok: true,\n   140\t      source: loaded.source,\n   141\t      records: loaded.records,\n   142\t      ...(Array.isArray(loaded.injected) ? { injected: loaded.injected } : {}),\n   143\t    };\n   144\t  } catch {\n   145\t    return failure('store_unreadable');\n   146\t  }\n   147\t}\n===FILE .skilled/hooks/shared/session-readers/claude.mjs\n     1\t// ───────────────────────────────────────────────────────────────────\n     2\t// MODULE: Claude Transcript Reader\n     3\t// ───────────────────────────────────────────────────────────────────\n     4\t// Claude hands a hook the transcript it is already writing. The reader trusts\n     5\t// that path only after the identity guard proves it lives under the Claude\n     6\t// store and that the file's own session id equals the requested one. A\n     7\t// subagent transcript is a side conversation, so it can never stand in for the\n     8\t// parent session.\n     9\t\n    10\t// ─────────────────────────────────────────────────────────────────────────────\n    11\t// 1. IMPORTS\n    12\t// ─────────────────────────────────────────────────────────────────────────────\n    13\t\n    14\timport { readFileSync, statSync } from 'node:fs';\n    15\timport { basename, join } from 'node:path';\n    16\timport { homeDir, isSafeSessionId, resolveInside } from './identity.mjs';\n    17\timport {\n    18\t  contentText,\n    19\t  imageBlock,\n    20\t  parseJsonObject,\n    21\t  textBlock,\n    22\t  thinkingBlock,\n    23\t  toolCallBlock,\n    24\t} from './project.mjs';\n    25\t\n    26\t// ─────────────────────────────────────────────────────────────────────────────\n    27\t// 2. CONSTANTS\n    28\t// ─────────────────────────────────────────────────────────────────────────────\n    29\t\n    30\tconst RUNTIME = 'claude';\n    31\tconst LOCATOR_KIND = 'transcript_path';\n    32\t\n    33\t// ─────────────────────────────────────────────────────────────────────────────\n    34\t// 3. STORE\n    35\t// ─────────────────────────────────────────────────────────────────────────────\n    36\t\n    37\texport function claudeStoreRoot(options = {}) {\n    38\t  return options.claudeRoot ?? join(homeDir(options), '.claude', 'projects');\n    39\t}\n    40\t\n    41\tfunction recordedSessionId(entries, transcriptPath) {\n    42\t  const declared = entries.find((entry) => typeof entry?.sessionId === 'string' && entry.sessionId)?.sessionId;\n    43\t  if (declared) return declared;\n    44\t  return basename(transcriptPath).replace(/\\.jsonl$/, '');\n    45\t}\n    46\t\n    47\tfunction isSubagentPath(filePath) {\n    48\t  return filePath.split(/[\\\\/]+/).includes('subagents');\n    49\t}\n    50\t\n    51\t// ─────────────────────────────────────────────────────────────────────────────\n    52\t// 4. ENTRY MAPPING\n    53\t// ─────────────────────────────────────────────────────────────────────────────\n    54\t\n    55\tfunction assistantBlocks(content) {\n    56\t  const blocks = [];\n    57\t  for (const block of Array.isArray(content) ? content : []) {\n    58\t    if (!block || typeof block !== 'object') continue;\n    59\t    if (block.type === 'text' && typeof block.text === 'string') {\n    60\t      blocks.push(textBlock(block.text));\n    61\t    } else if (block.type === 'thinking' && typeof block.thinking === 'string') {\n    62\t      blocks.push(thinkingBlock(block.thinking));\n    63\t    } else if (block.type === 'tool_use' && typeof block.id === 'string' && typeof block.name === 'string') {\n    64\t      blocks.push(toolCallBlock({ id: block.id, name: block.name, arguments: block.input }));\n    65\t    } else if (block.type === 'image' && block.source) {\n    66\t      blocks.push(imageBlock({\n    67\t        data: block.source.data,\n    68\t        mimeType: block.source.media_type ?? block.source.mediaType,\n    69\t      }));\n    70\t    }\n    71\t  }\n    72\t  return blocks;\n    73\t}\n    74\t\n    75\tfunction toolResultBlocks(content) {\n    76\t  if (typeof content === 'string') return [textBlock(content)];\n    77\t  const blocks = [];\n    78\t  for (const item of Array.isArray(content) ? content : []) {\n    79\t    if (!item || typeof item !== 'object') continue;\n    80\t    if (item.type === 'text' && typeof item.text === 'string') blocks.push(textBlock(item.text));\n    81\t    if (item.type === 'image' && item.source) {\n    82\t      blocks.push(imageBlock({\n    83\t        data: item.source.data,\n    84\t        mimeType: item.source.media_type ?? item.source.mediaType,\n    85\t      }));\n    86\t    }\n    87\t  }\n    88\t  return blocks;\n    89\t}\n    90\t\n    91\tfunction userRecords(entry, index, timestamp) {\n    92\t  const content = entry?.message?.content;\n    93\t  const uuid = typeof entry.uuid === 'string' && entry.uuid ? entry.uuid : `claude-entry-${index}`;\n    94\t  const blocks = Array.isArray(content) ? content.filter((block) => block && typeof block === 'object') : [];\n    95\t  const toolResults = blocks.filter((block) => block.type === 'tool_result' && typeof block.tool_use_id === 'string');\n    96\t\n    97\t  // A tool result must directly follow the assistant call it answers, or the\n    98\t  // projection treats the whole turn as broken. A user message that also\n    99\t  // carries typed text or an image therefore emits its results first and keeps\n   100\t  // the operator content as the user entry that follows them.\n   101\t  const records = toolResults.map((block) => ({\n   102\t    id: `${uuid}:result:${block.tool_use_id}`.slice(0, 128),\n   103\t    role: 'toolResult',\n   104\t    timestamp,\n   105\t    content: toolResultBlocks(block.content),\n   106\t    toolCallId: block.tool_use_id,\n   107\t    isError: block.is_error === true,\n   108\t  }));\n   109\t\n   110\t  const text = contentText(content);\n   111\t  const images = blocks.filter((block) => block.type === 'image' && block.source);\n   112\t  if (text || images.length > 0) {\n   113\t    const mapped = blocks.length > 0\n   114\t      ? blocks\n   115\t        .filter((block) => (block.type === 'text' && typeof block.text === 'string')\n   116\t          || (block.type === 'image' && block.source))\n   117\t        .map((block) => (\n   118\t          block.type === 'text'\n   119\t            ? textBlock(block.text)\n   120\t            : imageBlock({ data: block.source?.data, mimeType: block.source?.media_type ?? block.source?.mediaType })\n   121\t        ))\n   122\t      : [textBlock(text)];\n   123\t    records.push({ id: uuid, role: 'user', timestamp, content: mapped });\n   124\t  }\n   125\t  return records;\n   126\t}\n   127\t\n   128\t// Claude Code records the printed output of a local command, such as the\n   129\t// `/compact` report, as a user entry. The operator never typed it, so it is\n   130\t// host output rather than conversation and stays out of the history. The\n   131\t// command the operator typed stays in.\n   132\tconst LOCAL_COMMAND_OUTPUT = /^\\s*<local-command-(?:stdout|stderr)>/u;\n   133\t\n   134\tfunction isLocalCommandOutput(entry) {\n   135\t  const content = entry?.message?.content;\n   136\t  return typeof content === 'string' && LOCAL_COMMAND_OUTPUT.test(content);\n   137\t}\n   138\t\n   139\tfunction recordsFromEntries(entries) {\n   140\t  const records = [];\n   141\t  entries.forEach((entry, index) => {\n   142\t    if (!entry || typeof entry !== 'object') return;\n   143\t    if (entry.isSidechain === true || entry.isMeta === true || entry.isCompactSummary === true) return;\n   144\t\n   145\t    const timestamp = entry.timestamp;\n   146\t    if (entry.type === 'assistant') {\n   147\t      const id = typeof entry.uuid === 'string' && entry.uuid ? entry.uuid : `claude-entry-${index}`;\n   148\t      const content = assistantBlocks(entry?.message?.content);\n   149\t      if (content.length > 0) records.push({ id, role: 'assistant', timestamp, content });\n   150\t      return;\n   151\t    }\n   152\t\n   153\t    if (entry.type === 'user') {\n   154\t      if (isLocalCommandOutput(entry)) return;\n   155\t      records.push(...userRecords(entry, index, timestamp));\n   156\t    }\n   157\t  });\n   158\t  return records;\n   159\t}\n   160\t\n   161\t// Claude records the context a hook adds as an attachment entry rather than a\n   162\t// message, so the history never carried it. A caller that asks whether the\n   163\t// advisor brief reached the turn needs that text, and it has to stay apart from\n   164\t// the operator and assistant records.\n   165\tfunction attachmentText(content) {\n   166\t  if (typeof content === 'string') return content;\n   167\t  if (!Array.isArray(content)) return '';\n   168\t  return content\n   169\t    .map((item) => (typeof item === 'string' ? item : item?.text))\n   170\t    .filter((text) => typeof text === 'string' && text.length > 0)\n   171\t    .join('\\n');\n   172\t}\n   173\t\n   174\tfunction injectedFromEntries(entries) {\n   175\t  const injected = [];\n   176\t  for (const entry of entries) {\n   177\t    if (!entry || typeof entry !== 'object') continue;\n   178\t    if (entry.type !== 'attachment' || entry?.attachment?.type !== 'hook_additional_context') continue;\n   179\t    const text = attachmentText(entry.attachment.content);\n   180\t    if (text) injected.push({ source: 'hook_additional_context', text });\n   181\t  }\n   182\t  return injected;\n   183\t}\n   184\t\n   185\t// ─────────────────────────────────────────────────────────────────────────────\n   186\t// 5. LOADER\n   187\t// ─────────────────────────────────────────────────────────────────────────────\n   188\t\n   189\texport function loadClaudeSession({ sessionId, transcriptPath, ...options } = {}) {\n   190\t  if (typeof transcriptPath !== 'string' || !transcriptPath.trim()) {\n   191\t    return { ok: false, code: 'locator_unavailable' };\n   192\t  }\n   193\t  if (!isSafeSessionId(sessionId)) {\n   194\t    return { ok: false, code: sessionId ? 'session_mismatch' : 'locator_unavailable' };\n   195\t  }\n   196\t  if (isSubagentPath(transcriptPath)) {\n   197\t    return { ok: false, code: 'session_mismatch' };\n   198\t  }\n   199\t\n   200\t  // Containment is decided before the file is opened, so a path outside the\n   201\t  // store is refused without its content ever being read.\n   202\t  const root = claudeStoreRoot(options);\n   203\t  const containment = resolveInside({ path: transcriptPath, root });\n   204\t  if (!containment.ok) {\n   205\t    if (containment.code === 'session_mismatch') return containment;\n   206\t    try {\n   207\t      statSync(root);\n   208\t      return { ok: false, code: 'session_not_found' };\n   209\t    } catch {\n   210\t      return { ok: false, code: 'store_unreadable' };\n   211\t    }\n   212\t  }\n   213\t  const storePath = containment.path;\n   214\t\n   215\t  let raw;\n   216\t  try {\n   217\t    raw = readFileSync(transcriptPath, 'utf8');\n   218\t  } catch {\n   219\t    try {\n   220\t      statSync(root);\n   221\t      return { ok: false, code: 'session_not_found' };\n   222\t    } catch {\n   223\t      return { ok: false, code: 'store_unreadable' };\n   224\t    }\n   225\t  }\n   226\t\n   227\t  const entries = [];\n   228\t  for (const line of raw.split('\\n')) {\n   229\t    if (!line.trim()) continue;\n   230\t    const parsed = parseJsonObject(line);\n   231\t    if (parsed) entries.push(parsed);\n   232\t  }\n   233\t\n   234\t  if (recordedSessionId(entries, transcriptPath) !== sessionId) {\n   235\t    return { ok: false, code: 'session_mismatch' };\n   236\t  }\n   237\t\n   238\t  return {\n   239\t    ok: true,\n   240\t    source: {\n   241\t      runtime: RUNTIME,\n   242\t      sessionId,\n   243\t      locatorKind: LOCATOR_KIND,\n   244\t      storePath,\n   245\t    },\n   246\t    records: recordsFromEntries(entries),\n   247\t    injected: injectedFromEntries(entries),\n   248\t  };\n   249\t}\n===FILE .skilled/hooks/shared/session-readers/pi.mjs\n     1\t// ───────────────────────────────────────────────────────────────────\n     2\t// MODULE: Pi Session Reader\n     3\t// ───────────────────────────────────────────────────────────────────\n     4\t// Pi exposes its live branch in-process, so the current session needs no disk\n     5\t// read at all. An older session is found only by an exact header id inside the\n     6\t// caller's project directory. The header's `cwd` is the tie-breaker because\n     7\t// separator flattening lets two projects share one directory name.\n     8\t\n     9\t// ─────────────────────────────────────────────────────────────────────────────\n    10\t// 1. IMPORTS\n    11\t// ─────────────────────────────────────────────────────────────────────────────\n    12\t\n    13\timport { Buffer } from 'node:buffer';\n    14\timport { closeSync, openSync, readFileSync, readSync, readdirSync, statSync } from 'node:fs';\n    15\timport { join } from 'node:path';\n    16\timport {\n    17\t  guardSessionPath,\n    18\t  homeDir,\n    19\t  isSafeSessionId,\n    20\t  samePath,\n    21\t} from './identity.mjs';\n    22\timport {\n    23\t  contentText,\n    24\t  parseJsonObject,\n    25\t  textBlock,\n    26\t  thinkingBlock,\n    27\t  toolCallBlock,\n    28\t} from './project.mjs';\n    29\t\n    30\t// ─────────────────────────────────────────────────────────────────────────────\n    31\t// 2. CONSTANTS\n    32\t// ─────────────────────────────────────────────────────────────────────────────\n    33\t\n    34\tconst RUNTIME = 'pi';\n    35\t// One vocabulary across the capability table and both source envelopes.\n    36\tconst LOCATOR_KIND = 'live_branch_or_session_log';\n    37\tconst TRANSCRIPT_EXT = '.jsonl';\n    38\tconst HEADER_PROBE_BYTES = 64 * 1024;\n    39\t\n    40\t// ─────────────────────────────────────────────────────────────────────────────\n    41\t// 3. STORE\n    42\t// ─────────────────────────────────────────────────────────────────────────────\n    43\t\n    44\texport function piStoreRoot(options = {}) {\n    45\t  return options.piRoot ?? join(homeDir(options), '.pi', 'agent', 'sessions');\n    46\t}\n    47\t\n    48\texport function piProjectDirectory(projectDir) {\n    49\t  const projectKey = projectDir.replace(/^\\/+/, '').replaceAll('/', '-');\n    50\t  return '--' + projectKey + '--';\n    51\t}\n    52\t\n    53\tfunction headerOf(filePath) {\n    54\t  // Only the first line is needed, so the probe reads a bounded prefix rather\n    55\t  // than a whole session file that may run to many megabytes.\n    56\t  const buffer = Buffer.alloc(HEADER_PROBE_BYTES);\n    57\t  const fd = openSync(filePath, 'r');\n    58\t  let length;\n    59\t  try {\n    60\t    length = readSync(fd, buffer, 0, HEADER_PROBE_BYTES, 0);\n    61\t  } finally {\n    62\t    closeSync(fd);\n    63\t  }\n    64\t  const head = buffer.subarray(0, length).toString('utf8');\n    65\t  return parseJsonObject(head.split('\\n')[0]);\n    66\t}\n    67\t\n    68\t// Session file names start with their creation time and end with the session\n    69\t// id, so the id filters candidates before any file is opened.\n    70\tfunction idFromFileName(fileName) {\n    71\t  const withoutExtension = fileName.endsWith(TRANSCRIPT_EXT)\n    72\t    ? fileName.slice(0, -TRANSCRIPT_EXT.length)\n    73\t    : fileName;\n    74\t  const separator = withoutExtension.indexOf('_');\n    75\t  return separator === -1 ? withoutExtension : withoutExtension.slice(separator + 1) || withoutExtension;\n    76\t}\n    77\t\n    78\tfunction liveSessionId(sessionManager) {\n    79\t  if (!sessionManager || typeof sessionManager !== 'object') return null;\n    80\t  const value = typeof sessionManager.getSessionId === 'function'\n    81\t    ? sessionManager.getSessionId()\n    82\t    : sessionManager.sessionId;\n    83\t  return typeof value === 'string' && value ? value : null;\n    84\t}\n    85\t\n    86\tfunction branchEntries(sessionManager) {\n    87\t  if (typeof sessionManager.getBranch === 'function') return sessionManager.getBranch();\n    88\t  if (Array.isArray(sessionManager.branch)) return sessionManager.branch;\n    89\t  return null;\n    90\t}\n    91\t\n    92\t// ─────────────────────────────────────────────────────────────────────────────\n    93\t// 4. ENTRY MAPPING\n    94\t// ─────────────────────────────────────────────────────────────────────────────\n    95\t\n    96\tfunction assistantBlocks(content) {\n    97\t  const blocks = [];\n    98\t  for (const item of Array.isArray(content) ? content : []) {\n    99\t    if (!item || typeof item !== 'object') continue;\n   100\t    if (item.type === 'text' && typeof item.text === 'string') {\n   101\t      blocks.push(textBlock(item.text));\n   102\t    } else if (item.type === 'thinking' && typeof item.thinking === 'string') {\n   103\t      blocks.push(thinkingBlock(item.thinking));\n   104\t    } else if (item.type === 'toolCall' && typeof item.id === 'string' && typeof item.name === 'string') {\n   105\t      blocks.push(toolCallBlock({ id: item.id, name: item.name, arguments: item.arguments }));\n   106\t    }\n   107\t  }\n   108\t  return blocks;\n   109\t}\n   110\t\n   111\tfunction recordsFromLines(lines) {\n   112\t  const records = [];\n   113\t\n   114\t  lines.forEach((line, index) => {\n   115\t    if (line?.type !== 'message' || !line.message || typeof line.message !== 'object') return;\n   116\t    const message = line.message;\n   117\t    const id = typeof line.id === 'string' && line.id ? line.id : `pi-entry-${index}`;\n   118\t    const timestamp = line.timestamp;\n   119\t\n   120\t    if (message.role === 'user') {\n   121\t      const blocks = [];\n   122\t      for (const item of Array.isArray(message.content) ? message.content : []) {\n   123\t        if (item?.type === 'text' && typeof item.text === 'string') blocks.push(textBlock(item.text));\n   124\t      }\n   125\t      // Pi records harness injections as their own `custom_message` entry type,\n   126\t      // which this mapping never reads, so a user message is operator content\n   127\t      // even when it opens with '<'.\n   128\t      const text = contentText(blocks);\n   129\t      if (!text) return;\n   130\t      records.push({ id, role: 'user', timestamp, content: blocks });\n   131\t      return;\n   132\t    }\n   133\t\n   134\t    if (message.role === 'assistant') {\n   135\t      const blocks = assistantBlocks(message.content);\n   136\t      if (blocks.length === 0) return;\n   137\t      records.push({ id, role: 'assistant', timestamp, content: blocks });\n   138\t      return;\n   139\t    }\n   140\t\n   141\t    if (message.role === 'toolResult') {\n   142\t      if (typeof message.toolCallId !== 'string' || !message.toolCallId) return;\n   143\t      const blocks = [];\n   144\t      for (const item of Array.isArray(message.content) ? message.content : []) {\n   145\t        if (item?.type === 'text' && typeof item.text === 'string') blocks.push(textBlock(item.text));\n   146\t      }\n   147\t      const record = {\n   148\t        id,\n   149\t        role: 'toolResult',\n   150\t        timestamp,\n   151\t        content: blocks.length > 0 ? blocks : [textBlock(contentText(message.content))],\n   152\t        toolCallId: message.toolCallId,\n   153\t      };\n   154\t      if (message.isError === true) record.isError = true;\n   155\t      records.push(record);\n   156\t    }\n   157\t  });\n   158\t\n   159\t  return records;\n   160\t}\n   161\t\n   162\t// A `custom_message` is context a hook or harness put into the session rather\n   163\t// than a turn the operator wrote, so it stays out of `records` and travels as\n   164\t// its own list. The custom type names the producer when the entry carries one.\n   165\tfunction injectedFromLines(lines) {\n   166\t  const injected = [];\n   167\t  for (const line of lines) {\n   168\t    if (line?.type !== 'custom_message') continue;\n   169\t    const text = contentText(line.content);\n   170\t    if (!text) continue;\n   171\t    injected.push({ source: line.customType ?? 'custom_message', text });\n   172\t  }\n   173\t  return injected;\n   174\t}\n   175\t\n   176\t// ─────────────────────────────────────────────────────────────────────────────\n   177\t// 5. LOADER\n   178\t// ─────────────────────────────────────────────────────────────────────────────\n   179\t\n   180\tfunction liveResult({ sessionId, sessionManager, options }) {\n   181\t  const entries = branchEntries(sessionManager);\n   182\t  if (!Array.isArray(entries)) return { ok: false, code: 'store_unreadable' };\n   183\t  if (entries.length === 0) return { ok: false, code: 'session_not_found' };\n   184\t  return {\n   185\t    ok: true,\n   186\t    source: {\n   187\t      runtime: RUNTIME,\n   188\t      sessionId,\n   189\t      locatorKind: LOCATOR_KIND,\n   190\t      mode: 'live',\n   191\t      storePath: typeof sessionManager.getSessionFile === 'function'\n   192\t        ? String(sessionManager.getSessionFile())\n   193\t        : piStoreRoot(options),\n   194\t    },\n   195\t    records: recordsFromLines(entries),\n   196\t    injected: injectedFromLines(entries),\n   197\t  };\n   198\t}\n   199\t\n   200\tfunction diskResult({ sessionId, projectDir, options }) {\n   201\t  if (typeof projectDir !== 'string' || !projectDir.trim()) {\n   202\t    return { ok: false, code: 'locator_unavailable' };\n   203\t  }\n   204\t\n   205\t  const root = piStoreRoot(options);\n   206\t  const directory = join(root, piProjectDirectory(projectDir));\n   207\t\n   208\t  let names;\n   209\t  try {\n   210\t    names = readdirSync(directory);\n   211\t  } catch {\n   212\t    // A missing root means the store itself cannot be read; a known root with\n   213\t    // no project directory means this project simply has no saved session.\n   214\t    try {\n   215\t      statSync(root);\n   216\t      return { ok: false, code: 'session_not_found' };\n   217\t    } catch {\n   218\t      return { ok: false, code: 'store_unreadable' };\n   219\t    }\n   220\t  }\n   221\t\n   222\t  const candidates = names.filter(\n   223\t    (name) => name.endsWith(TRANSCRIPT_EXT) && idFromFileName(name) === sessionId,\n   224\t  );\n   225\t  if (candidates.length === 0) return { ok: false, code: 'session_not_found' };\n   226\t  // Two files that decode to one id are two possible sessions, and neither the\n   227\t  // name nor the header can choose between them, so a recovery read refuses\n   228\t  // rather than guessing.\n   229\t  if (candidates.length > 1) return { ok: false, code: 'session_ambiguous' };\n   230\t\n   231\t  const filePath = join(directory, candidates[0]);\n   232\t  let header;\n   233\t  try {\n   234\t    header = headerOf(filePath);\n   235\t  } catch {\n   236\t    return { ok: false, code: 'store_unreadable' };\n   237\t  }\n   238\t\n   239\t  if (header?.type !== 'session' || header.id !== sessionId) {\n   240\t    return { ok: false, code: 'session_mismatch' };\n   241\t  }\n   242\t  if (!samePath(header.cwd, projectDir)) {\n   243\t    return { ok: false, code: 'session_mismatch' };\n   244\t  }\n   245\t\n   246\t  const guard = guardSessionPath({\n   247\t    path: filePath,\n   248\t    root,\n   249\t    sessionId,\n   250\t    recordedId: header.id,\n   251\t  });\n   252\t  if (!guard.ok) return guard;\n   253\t\n   254\t  let raw;\n   255\t  try {\n   256\t    raw = readFileSync(filePath, 'utf8');\n   257\t  } catch {\n   258\t    return { ok: false, code: 'store_unreadable' };\n   259\t  }\n   260\t\n   261\t  const lines = [];\n   262\t  for (const line of raw.split('\\n')) {\n   263\t    if (!line.trim()) continue;\n   264\t    const parsed = parseJsonObject(line);\n   265\t    if (parsed) lines.push(parsed);\n   266\t  }\n   267\t\n   268\t  return {\n   269\t    ok: true,\n   270\t    source: {\n   271\t      runtime: RUNTIME,\n   272\t      sessionId,\n   273\t      locatorKind: LOCATOR_KIND,\n   274\t      mode: 'disk',\n   275\t      storePath: guard.path,\n   276\t    },\n   277\t    records: recordsFromLines(lines),\n   278\t    injected: injectedFromLines(lines),\n   279\t  };\n   280\t}\n   281\t\n   282\texport function loadPiSession({ sessionId, projectDir, sessionManager, ...options } = {}) {\n   283\t  if (!isSafeSessionId(sessionId)) {\n   284\t    return { ok: false, code: sessionId ? 'session_mismatch' : 'locator_unavailable' };\n   285\t  }\n   286\t\n   287\t  if (sessionManager && liveSessionId(sessionManager) === sessionId) {\n   288\t    return liveResult({ sessionId, sessionManager, options });\n   289\t  }\n   290\t  return diskResult({ sessionId, projectDir, options });\n   291\t}\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"cd /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research && for f in .skilled/hooks/shared/session-readers/index.mjs .skilled/hooks/shared/session-readers/claude.mjs .skilled/hooks/shared/session-readers/pi.mjs; do echo \\\"===FILE $f\\\"; cat -n \\\"$f\\\"; done\"}"},"time":{"start":1794550447974,"end":1794550448686}}}}
