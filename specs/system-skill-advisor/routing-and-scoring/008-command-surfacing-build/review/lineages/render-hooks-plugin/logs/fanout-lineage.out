 at :447.\"},{\"id\":\"R1-P2-005\",\"severity\":\"P2\",\"title\":\"needsMode withholding is defeated when the skill also has a generated command row\",\"file\":\".skilled/skills/system-skill-advisor/runtime/lib/render.ts:226\",\"case\":\"A recommendation with needsMode true, no command, and a skill that has a generated row renders as a runnable command instead of a needs-a-mode head.\",\"findingClass\":\"instance-only\",\"scopeProof\":\"render.ts:226 is the only place row?.command backfills a recommendation; command-attach.ts:66-100 keys rows by command-* ids, so no needsMode hub skill currently resolves one.\"}],\"traceabilityChecks\":{\"spec_code\":\"partial\",\"checklist_evidence\":\"pending\",\"skill_agent\":\"pending\",\"agent_cross_runtime\":\"partial\",\"feature_catalog_code\":\"pending\",\"playbook_capability\":\"notApplicable\"},\"newFindingsRatio\":1.0,\"sessionId\":\"fanout-render-hooks-plugin-1794550137809-1ecgc7\",\"generation\":1,\"lineageMode\":\"new\",\"timestamp\":\"2026-11-13T06:20:00.000Z\",\"durationMs\":420000,\"reviewDepthSchemaVersion\":2,\"reviewDepthApplicability\":{\"scopeClass\":\"standard\",\"enforcement\":\"warn\",\"reason\":\"53 changed files in one command-surfacing area, non-trivial but bounded to the hook/plugin render surface\",\"evidenceRefs\":[\"specs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/review/review-scope.txt:1\"]},\"targetSelection\":{\"selectedTargets\":[\".opencode/plugins/system-skill-advisor.js\",\".skilled/hooks/shared/session-readers/index.mjs\",\".skilled/hooks/shared/session-readers/claude.mjs\",\".skilled/hooks/shared/session-readers/pi.mjs\",\".skilled/hooks/shared/session-readers/devin.mjs\",\".skilled/hooks/shared/session-readers/dsh.mjs\",\".skilled/skills/system-skill-advisor/runtime/lib/render.ts\"],\"selectionReason\":\"The six runtimes the operator named resolve to one dispatcher, four changed readers, and the render path that turns a scored row into a brief.\",\"discoveryMethods\":[\"direct_read\",\"exact_search\",\"scope_manifest\"],\"omittedHighRiskTargets\":[\"codex.mjs\",\"opencode.mjs\",\"cursor.mjs\",\"project.mjs\",\"identity.mjs\"],\"graphStatus\":\"unavailable\",\"semanticSearchStatus\":\"unavailable\",\"evidenceRefs\":[\"specs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/review/review-scope.txt:1\"]},\"searchCoverage\":{\"requiredBugClasses\":[\"contract_violation\",\"silent_data_loss\",\"error_path_masking\",\"path_traversal\",\"state_transition\"],\"covered\":[\"contract_violation\",\"silent_data_loss\"],\"ruledOut\":[\"path_traversal\",\"state_transition\"],\"deferred\":[\"error_path_masking\"],\"blocked\":[],\"graphCoverageMode\":\"graphless_fallback\"},\"searchLedger\":[{\"id\":\"SL-001\",\"dimension\":\"correctness\",\"targetRefs\":[\".skilled/hooks/shared/session-readers/index.mjs\"],\"bugClass\":\"contract_violation\",\"invariant\":\"An unknown runtime must be distinguishable from a missing locator.\",\"searchActions\":[{\"method\":\"direct_read\",\"queryOrPath\":\".skilled/hooks/shared/session-readers/index.mjs\",\"result\":\"session id is validated before the runtime resolves\",\"evidenceRefs\":[\".skilled/hooks/shared/session-readers/index.mjs:99\"]}],\"disposition\":\"finding\",\"rationale\":\"The documented envelope has both codes but only one is reachable for this shape.\",\"linkedFindingId\":\"R1-P2-001\"},{\"id\":\"SL-002\",\"dimension\":\"correctness\",\"targetRefs\":[\".skilled/hooks/shared/session-readers/claude.mjs\",\".skilled/hooks/shared/session-readers/devin.mjs\",\".skilled/hooks/shared/session-readers/dsh.mjs\"],\"bugClass\":\"contract_violation\",\"invariant\":\"source.storePath names the file whose bytes produced the records.\",\"searchActions\":[{\"method\":\"exact_search\",\"queryOrPath\":\"storePath = containment.path\",\"result\":\"three readers compute a resolved path and then open the unresolved one\",\"evidenceRefs\":[\".skilled/hooks/shared/session-readers/claude.mjs:213