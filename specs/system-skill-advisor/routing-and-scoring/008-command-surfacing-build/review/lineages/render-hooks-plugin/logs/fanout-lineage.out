{"type":"step_start","timestamp":1794550631665,"sessionID":"ses_e2c799690ffeJQrMJ5OzboPGaV","part":{"id":"prt_1d38d8cf1001fkTE8AFGuW0c9J","sessionID":"ses_e2c799690ffeJQrMJ5OzboPGaV","messageID":"msg_1d38d7657001eeFOKLoyld1FZT","type":"step-start","snapshot":"6fbe61994d866f13b63fbd1daa8f0b3b0031b6b4"}}
