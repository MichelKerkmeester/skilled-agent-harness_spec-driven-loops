{"type":"tool_use","timestamp":1794550457183,"sessionID":"ses_e2c799690ffeJQrMJ5OzboPGaV","part":{"partID":"prt_1d38ae0a1001jzCA769ULbT1cw","sessionID":"ses_e2c799690ffeJQrMJ5OzboPGaV","messageID":"msg_1d38ac790001L9KQ1eKDaGqfni","type":"tool","id":"call_3f6393e1be504fdd95f3c158","tool":"shell","state":{"status":"completed","input":{"command":"cd /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research && ls -la .skilled/hooks/shared/session-readers/ && echo \"=== devin/dsh ===\" && for f in .skilled/hooks/shared/session-readers/devin.mjs .skilled/hooks/shared/session-readers/dsh.mjs; do echo \"---FILE $f\"; cat -n \"$f\"; done"},"output":"total 416\ndrwxr-xr-x@ 33 michelkerkmeester  staff   1056 Nov 13 06:59 .\ndrwxr-xr-x@ 16 michelkerkmeester  staff    512 Nov 12 10:24 ..\n-rw-r--r--@  1 michelkerkmeester  staff    486 Nov 13 06:59 claude.d.mts\n-rw-r--r--@  1 michelkerkmeester  staff    140 Nov 13 06:59 claude.d.mts.map\n-rw-r--r--@  1 michelkerkmeester  staff  11177 Nov 13 06:59 claude.mjs\n-rw-r--r--@  1 michelkerkmeester  staff    412 Nov 13 06:08 codex.d.mts\n-rw-r--r--@  1 michelkerkmeester  staff    134 Nov 13 06:08 codex.d.mts.map\n-rw-r--r--@  1 michelkerkmeester  staff   8732 Nov 12 10:24 codex.mjs\n-rw-r--r--@  1 michelkerkmeester  staff    188 Nov 13 06:08 cursor.d.mts\n-rw-r--r--@  1 michelkerkmeester  staff    124 Nov 13 06:08 cursor.d.mts.map\n-rw-r--r--@  1 michelkerkmeester  staff   2839 Nov 12 10:24 cursor.mjs\n-rw-r--r--@  1 michelkerkmeester  staff    653 Nov 13 06:59 devin.d.mts\n-rw-r--r--@  1 michelkerkmeester  staff    164 Nov 13 06:59 devin.d.mts.map\n-rw-r--r--@  1 michelkerkmeester  staff  17398 Nov 13 06:59 devin.mjs\n-rw-r--r--@  1 michelkerkmeester  staff    662 Nov 13 06:59 dsh.d.mts\n-rw-r--r--@  1 michelkerkmeester  staff    163 Nov 13 06:59 dsh.d.mts.map\n-rw-r--r--@  1 michelkerkmeester  staff  13783 Nov 13 06:59 dsh.mjs\n-rw-r--r--@  1 michelkerkmeester  staff    945 Nov 13 06:08 identity.d.mts\n-rw-r--r--@  1 michelkerkmeester  staff    211 Nov 13 06:08 identity.d.mts.map\n-rw-r--r--@  1 michelkerkmeester  staff   6854 Nov 12 10:24 identity.mjs\n-rw-r--r--@  1 michelkerkmeester  staff   1842 Nov 13 06:08 index.d.mts\n-rw-r--r--@  1 michelkerkmeester  staff    373 Nov 13 06:59 index.d.mts.map\n-rw-r--r--@  1 michelkerkmeester  staff   6293 Nov 13 06:59 index.mjs\n-rw-r--r--@  1 michelkerkmeester  staff   1271 Nov 13 06:08 opencode.d.mts\n-rw-r--r--@  1 michelkerkmeester  staff    191 Nov 13 06:08 opencode.d.mts.map\n-rw-r--r--@  1 michelkerkmeester  staff  13470 Nov 12 10:24 opencode.mjs\n-rw-r--r--@  1 michelkerkmeester  staff   1023 Nov 13 06:59 pi.d.mts\n-rw-r--r--@  1 michelkerkmeester  staff    168 Nov 13 06:59 pi.d.mts.map\n-rw-r--r--@  1 michelkerkmeester  staff  11899 Nov 13 06:59 pi.mjs\n-rw-r--r--@  1 michelkerkmeester  staff   1192 Nov 13 06:08 project.d.mts\n-rw-r--r--@  1 michelkerkmeester  staff    234 Nov 13 06:08 project.d.mts.map\n-rw-r--r--@  1 michelkerkmeester  staff  10119 Nov 12 10:24 project.mjs\n-rw-r--r--@  1 michelkerkmeester  staff   4683 Nov 13 06:59 README.md\n=== devin/dsh ===\n---FILE .skilled/hooks/shared/session-readers/devin.mjs\n     1\t// ───────────────────────────────────────────────────────────────────\n     2\t// MODULE: Devin CLI Session Reader\n     3\t// ───────────────────────────────────────────────────────────────────\n     4\t// Devin writes its history to a SQLite sessions database, with one row per\n     5\t// session and one message row per node of that session's conversation tree.\n     6\t// Older builds named a JSON transcript after the session instead, so the file\n     7\t// remains a fallback for a store that has no database record. A read is accepted\n     8\t// only when the session's own row agrees with the request and its recorded\n     9\t// working directory is the caller's project; either disagreement means the\n    10\t// record describes another session.\n    11\t\n    12\t// ─────────────────────────────────────────────────────────────────────────────\n    13\t// 1. IMPORTS\n    14\t// ─────────────────────────────────────────────────────────────────────────────\n    15\t\n    16\timport { createRequire } from 'node:module';\n    17\timport { existsSync, readFileSync, statSync } from 'node:fs';\n    18\timport { join } from 'node:path';\n    19\timport {\n    20\t  envOf,\n    21\t  homeDir,\n    22\t  isSafeSessionId,\n    23\t  resolveInside,\n    24\t  atOrBelow,\n    25\t  samePath,\n    26\t} from './identity.mjs';\n    27\timport {\n    28\t  isoOr,\n    29\t  parseJsonObject,\n    30\t  textBlock,\n    31\t  toolCallBlock,\n    32\t} from './project.mjs';\n    33\t\n    34\tconst require = createRequire(import.meta.url);\n    35\t\n    36\t// ─────────────────────────────────────────────────────────────────────────────\n    37\t// 2. CONSTANTS\n    38\t// ─────────────────────────────────────────────────────────────────────────────\n    39\t\n    40\tconst RUNTIME = 'devin';\n    41\tconst DATABASE_LOCATOR_KIND = 'session_id';\n    42\tconst TRANSCRIPT_LOCATOR_KIND = 'transcript_file';\n    43\tconst DATABASE_FILE = 'sessions.db';\n    44\tconst TRANSCRIPT_EXT = '.json';\n    45\t\n    46\t// ─────────────────────────────────────────────────────────────────────────────\n    47\t// 3. STORE\n    48\t// ─────────────────────────────────────────────────────────────────────────────\n    49\t\n    50\texport function devinDataDirectory(options = {}) {\n    51\t  if (options.devinDataHome) return options.devinDataHome;\n    52\t  const dataHome = envOf(options).XDG_DATA_HOME || join(homeDir(options), '.local', 'share');\n    53\t  return join(dataHome, 'devin', 'cli');\n    54\t}\n    55\t\n    56\texport function devinTranscriptRoot(options = {}) {\n    57\t  return join(devinDataDirectory(options), 'transcripts');\n    58\t}\n    59\t\n    60\texport function devinDatabasePath(options = {}) {\n    61\t  return options.dbPath ?? join(devinDataDirectory(options), DATABASE_FILE);\n    62\t}\n    63\t\n    64\tfunction openDatabase(dbPath) {\n    65\t  const { DatabaseSync } = require('node:sqlite');\n    66\t  return new DatabaseSync(dbPath, { readOnly: true });\n    67\t}\n    68\t\n    69\tfunction tableColumns(database, table) {\n    70\t  return new Set(database.prepare(`PRAGMA table_info('${table}')`).all().map((row) => row.name));\n    71\t}\n    72\t\n    73\tfunction sessionRow(database, sessionId) {\n    74\t  const columns = tableColumns(database, 'sessions');\n    75\t  if (!columns.has('id')) return null;\n    76\t\n    77\t  // A store that predates a column still names the session, so each optional\n    78\t  // column is selected only when the table has it.\n    79\t  const selected = ['id'];\n    80\t  for (const name of ['working_directory', 'main_chain_id']) {\n    81\t    if (columns.has(name)) selected.push(name);\n    82\t  }\n    83\t\n    84\t  const row = database.prepare(`SELECT ${selected.join(', ')} FROM sessions WHERE id = ?`).get(sessionId);\n    85\t  return row && row.id === sessionId ? row : null;\n    86\t}\n    87\t\n    88\t// ─────────────────────────────────────────────────────────────────────────────\n    89\t// 4. DATABASE PROJECTION\n    90\t// ─────────────────────────────────────────────────────────────────────────────\n    91\t\n    92\tfunction nodeTimestamp(node, message) {\n    93\t  const recorded = message.metadata?.created_at;\n    94\t  if (recorded !== undefined && recorded !== null) return isoOr(recorded);\n    95\t  // The node clock is stored in whole seconds, while the shared normalizer\n    96\t  // expects milliseconds.\n    97\t  return isoOr(typeof node.created_at === 'number' ? node.created_at * 1000 : undefined);\n    98\t}\n    99\t\n   100\tfunction nodeIdentifier(node, message) {\n   101\t  const stored = typeof message.message_id === 'string' && message.message_id\n   102\t    ? message.message_id\n   103\t    : String(node.node_id);\n   104\t  return `devin-${stored}`.slice(0, 128);\n   105\t}\n   106\t\n   107\t// The message store is a forest: every request re-records the prompt it was\n   108\t// built from, so a plain row scan would repeat messages. The session's main\n   109\t// chain names the live path, and walking it back to its root yields each node\n   110\t// once in conversation order.\n   111\tfunction chainFromHead(nodes, headId) {\n   112\t  if (headId == null) return null;\n   113\t\n   114\t  const byNodeId = new Map(nodes.map((node) => [node.node_id, node]));\n   115\t  const chain = [];\n   116\t  const seen = new Set();\n   117\t  let cursor = byNodeId.get(headId);\n   118\t\n   119\t  while (cursor) {\n   120\t    if (seen.has(cursor.node_id)) return null;\n   121\t    seen.add(cursor.node_id);\n   122\t    chain.push(cursor);\n   123\t\n   124\t    if (cursor.parent_node_id == null) break;\n   125\t    const parent = byNodeId.get(cursor.parent_node_id);\n   126\t    if (!parent) return null;\n   127\t    cursor = parent;\n   128\t  }\n   129\t\n   130\t  return chain.reverse();\n   131\t}\n   132\t\n   133\tfunction recordsFromChain(chain) {\n   134\t  const records = [];\n   135\t\n   136\t  for (const node of chain) {\n   137\t    const message = parseJsonObject(node.chat_message);\n   138\t    if (!message) continue;\n   139\t\n   140\t    const timestamp = nodeTimestamp(node, message);\n   141\t    const id = nodeIdentifier(node, message);\n   142\t    const text = typeof message.content === 'string' ? message.content : '';\n   143\t\n   144\t    if (message.role === 'user') {\n   145\t      // Synthetic prompt context is also stored as a user row; only content the\n   146\t      // operator typed carries the input flag, so an unflagged row is skipped.\n   147\t      const isInput = message.metadata?.is_user_input;\n   148\t      if (isInput !== true && isInput !== 1) continue;\n   149\t      if (!text) continue;\n   150\t      records.push({ id, role: 'user', timestamp, content: [textBlock(text)] });\n   151\t      continue;\n   152\t    }\n   153\t\n   154\t    if (message.role === 'assistant') {\n   155\t      const blocks = [];\n   156\t      if (text) blocks.push(textBlock(text));\n   157\t      for (const call of Array.isArray(message.tool_calls) ? message.tool_calls : []) {\n   158\t        if (typeof call?.id !== 'string' || typeof call.name !== 'string') continue;\n   159\t        blocks.push(toolCallBlock({\n   160\t          id: call.id,\n   161\t          name: call.name,\n   162\t          arguments: call.arguments,\n   163\t        }));\n   164\t      }\n   165\t      if (blocks.length > 0) {\n   166\t        records.push({ id, role: 'assistant', timestamp, content: blocks });\n   167\t      }\n   168\t      continue;\n   169\t    }\n   170\t\n   171\t    if (message.role === 'tool' && typeof message.tool_call_id === 'string') {\n   172\t      records.push({\n   173\t        id,\n   174\t        role: 'toolResult',\n   175\t        timestamp,\n   176\t        content: [textBlock(text)],\n   177\t        toolCallId: message.tool_call_id,\n   178\t      });\n   179\t    }\n   180\t  }\n   181\t\n   182\t  return records;\n   183\t}\n   184\t\n   185\t// A system node carries the harness context a compaction or a session start\n   186\t// injected. A user node without the input flag is prompt context the harness\n   187\t// wrote, not text the operator typed, so it is injected context too and never\n   188\t// a conversation record.\n   189\tfunction injectedFromChain(chain) {\n   190\t  const injected = [];\n   191\t\n   192\t  for (const node of chain) {\n   193\t    const message = parseJsonObject(node.chat_message);\n   194\t    if (!message) continue;\n   195\t\n   196\t    const text = typeof message.content === 'string' ? message.content : '';\n   197\t    if (!text) continue;\n   198\t\n   199\t    if (message.role === 'system') {\n   200\t      injected.push({ source: message.role, text });\n   201\t      continue;\n   202\t    }\n   203\t\n   204\t    if (message.role === 'user') {\n   205\t      const isInput = message.metadata?.is_user_input;\n   206\t      if (isInput === true || isInput === 1) continue;\n   207\t      injected.push({ source: 'unflagged-user', text });\n   208\t    }\n   209\t  }\n   210\t\n   211\t  return injected;\n   212\t}\n   213\t\n   214\tfunction summarizedFrom(node) {\n   215\t  const value = parseJsonObject(node.metadata)?.summarized_from;\n   216\t  return Number.isInteger(value) ? value : null;\n   217\t}\n   218\t\n   219\t// A compaction starts a new thread whose root has no parent, so the live chain\n   220\t// alone holds only the turns after it. The thread's continuation node names\n   221\t// the last node of the thread it summarized, and following that link back,\n   222\t// once per compaction, restores the turns the compaction dropped.\n   223\tfunction chainWithEarlierThreads(nodes, headId) {\n   224\t  const threads = [];\n   225\t  const visited = new Set();\n   226\t  let head = headId;\n   227\t  while (head != null) {\n   228\t    if (visited.has(head)) return null;\n   229\t    visited.add(head);\n   230\t    const thread = chainFromHead(nodes, head);\n   231\t    if (!thread) return null;\n   232\t    threads.unshift(thread);\n   233\t    const link = thread.find((node) => summarizedFrom(node) !== null);\n   234\t    head = link ? summarizedFrom(link) : null;\n   235\t  }\n   236\t  return threads.flat();\n   237\t}\n   238\t\n   239\tfunction recordsFromDatabase(database, sessionId, headId) {\n   240\t  const nodes = database\n   241\t    .prepare('SELECT node_id, parent_node_id, chat_message, metadata, created_at FROM message_nodes WHERE session_id = ? ORDER BY node_id')\n   242\t    .all(sessionId);\n   243\t\n   244\t  if (nodes.length === 0) return { records: [], injected: [] };\n   245\t\n   246\t  const chain = chainWithEarlierThreads(nodes, headId);\n   247\t  return chain ? { records: recordsFromChain(chain), injected: injectedFromChain(chain) } : null;\n   248\t}\n   249\t\n   250\t// ─────────────────────────────────────────────────────────────────────────────\n   251\t// 5. TRANSCRIPT MAPPING\n   252\t// ─────────────────────────────────────────────────────────────────────────────\n   253\t\n   254\tfunction recordsFromSteps(steps) {\n   255\t  const records = [];\n   256\t\n   257\t  steps.forEach((step, stepIndex) => {\n   258\t    if (!step || typeof step !== 'object') return;\n   259\t    const stepId = step.step_id ?? stepIndex;\n   260\t    const timestamp = step.timestamp;\n   261\t    const message = typeof step.message === 'string' ? step.message : '';\n   262\t\n   263\t    if (step.source === 'user') {\n   264\t      // Harness and system content arrives under a different `source` value, so\n   265\t      // a user step is operator content even when it opens with '<'.\n   266\t      if (!message) return;\n   267\t      records.push({\n   268\t        id: `devin-${stepId}`.slice(0, 128),\n   269\t        role: 'user',\n   270\t        timestamp,\n   271\t        content: [textBlock(message)],\n   272\t      });\n   273\t      return;\n   274\t    }\n   275\t\n   276\t    if (step.source !== 'agent') return;\n   277\t\n   278\t    const toolCalls = Array.isArray(step.tool_calls) ? step.tool_calls : [];\n   279\t    const blocks = [];\n   280\t    if (message) blocks.push(textBlock(message));\n   281\t    for (const call of toolCalls) {\n   282\t      if (typeof call?.tool_call_id !== 'string' || typeof call.function_name !== 'string') continue;\n   283\t      blocks.push(toolCallBlock({\n   284\t        id: call.tool_call_id,\n   285\t        name: call.function_name,\n   286\t        arguments: call.arguments,\n   287\t      }));\n   288\t    }\n   289\t    if (blocks.length > 0) {\n   290\t      records.push({\n   291\t        id: `devin-${stepId}`.slice(0, 128),\n   292\t        role: 'assistant',\n   293\t        timestamp,\n   294\t        content: blocks,\n   295\t      });\n   296\t    }\n   297\t\n   298\t    const results = Array.isArray(step.observation?.results) ? step.observation.results : [];\n   299\t    results.forEach((result, resultIndex) => {\n   300\t      if (typeof result?.source_call_id !== 'string') return;\n   301\t      const content = typeof result.content === 'string' ? result.content : '';\n   302\t      records.push({\n   303\t        id: `devin-${stepId}-result-${resultIndex}`.slice(0, 128),\n   304\t        role: 'toolResult',\n   305\t        timestamp,\n   306\t        content: [textBlock(content)],\n   307\t        toolCallId: result.source_call_id,\n   308\t      });\n   309\t    });\n   310\t  });\n   311\t\n   312\t  return records;\n   313\t}\n   314\t\n   315\t// Harness and system steps are not conversation records, but they are context\n   316\t// the next turn saw, kept apart so a caller can tell what the operator typed.\n   317\tfunction injectedFromSteps(steps) {\n   318\t  const injected = [];\n   319\t\n   320\t  for (const step of steps) {\n   321\t    if (!step || typeof step !== 'object') continue;\n   322\t    if (step.source === 'user' || step.source === 'agent') continue;\n   323\t    if (typeof step.message !== 'string' || !step.message) continue;\n   324\t    injected.push({ source: step.source, text: step.message });\n   325\t  }\n   326\t\n   327\t  return injected;\n   328\t}\n   329\t\n   330\t// ─────────────────────────────────────────────────────────────────────────────\n   331\t// 6. LOADER\n   332\t// ─────────────────────────────────────────────────────────────────────────────\n   333\t\n   334\tfunction loadTranscript(sessionId, dataDirectory, options) {\n   335\t  const root = devinTranscriptRoot(options);\n   336\t  const transcriptPath = options.transcriptPath ?? join(root, `${sessionId}${TRANSCRIPT_EXT}`);\n   337\t\n   338\t  // Containment is decided before the file is opened, so a path outside the\n   339\t  // store is refused without its content ever being read.\n   340\t  const containment = resolveInside({ path: transcriptPath, root });\n   341\t  if (!containment.ok) {\n   342\t    if (containment.code === 'session_mismatch') return containment;\n   343\t    try {\n   344\t      statSync(dataDirectory);\n   345\t      return { ok: false, code: 'session_not_found' };\n   346\t    } catch {\n   347\t      return { ok: false, code: 'store_unreadable' };\n   348\t    }\n   349\t  }\n   350\t  const storePath = containment.path;\n   351\t\n   352\t  let raw;\n   353\t  try {\n   354\t    raw = readFileSync(transcriptPath, 'utf8');\n   355\t  } catch {\n   356\t    try {\n   357\t      statSync(dataDirectory);\n   358\t      return { ok: false, code: 'session_not_found' };\n   359\t    } catch {\n   360\t      return { ok: false, code: 'store_unreadable' };\n   361\t    }\n   362\t  }\n   363\t\n   364\t  const transcript = parseJsonObject(raw);\n   365\t  if (!transcript) return { ok: false, code: 'store_unreadable' };\n   366\t  if (typeof transcript.session_id === 'string' && transcript.session_id !== sessionId) {\n   367\t    return { ok: false, code: 'session_mismatch' };\n   368\t  }\n   369\t\n   370\t  const steps = Array.isArray(transcript.steps) ? transcript.steps : [];\n   371\t  return {\n   372\t    ok: true,\n   373\t    source: {\n   374\t      runtime: RUNTIME,\n   375\t      sessionId,\n   376\t      locatorKind: TRANSCRIPT_LOCATOR_KIND,\n   377\t      storePath,\n   378\t    },\n   379\t    records: recordsFromSteps(steps),\n   380\t    injected: injectedFromSteps(steps),\n   381\t  };\n   382\t}\n   383\t\n   384\texport function loadDevinSession({ sessionId, projectDir, ...options } = {}) {\n   385\t  if (!isSafeSessionId(sessionId)) {\n   386\t    return { ok: false, code: sessionId ? 'session_mismatch' : 'locator_unavailable' };\n   387\t  }\n   388\t  if (typeof projectDir !== 'string' || !projectDir.trim()) {\n   389\t    return { ok: false, code: 'locator_unavailable' };\n   390\t  }\n   391\t\n   392\t  const dataDirectory = devinDataDirectory(options);\n   393\t  const dbPath = devinDatabasePath(options);\n   394\t\n   395\t  if (existsSync(dbPath)) {\n   396\t    const dbContainment = resolveInside({ path: dbPath, root: dataDirectory });\n   397\t    if (!dbContainment.ok) return dbContainment;\n   398\t\n   399\t    let database;\n   400\t    try {\n   401\t      database = openDatabase(dbContainment.path);\n   402\t    } catch {\n   403\t      return { ok: false, code: 'store_unreadable' };\n   404\t    }\n   405\t\n   406\t    try {\n   407\t      const row = sessionRow(database, sessionId);\n   408\t      if (row) {\n   409\t        // Devin's hooks receive the project root, while the row records the\n   410\t        // folder the session ran in, which may sit below that root.\n   411\t        if (Object.hasOwn(row, 'working_directory') && !atOrBelow(row.working_directory, projectDir)) {\n   412\t          return { ok: false, code: 'session_mismatch' };\n   413\t        }\n   414\t\n   415\t        // An older store names its sessions but keeps their turns only in\n   416\t        // transcript files, so a database with no message rows for this\n   417\t        // session, or no chain head to walk, falls through.\n   418\t        if (tableColumns(database, 'message_nodes').size > 0) {\n   419\t          const projection = recordsFromDatabase(database, sessionId, row.main_chain_id);\n   420\t          if (!projection) return { ok: false, code: 'store_unreadable' };\n   421\t\n   422\t          const { records, injected } = projection;\n   423\t          if (records.length > 0) {\n   424\t            return {\n   425\t              ok: true,\n   426\t              source: {\n   427\t                runtime: RUNTIME,\n   428\t                sessionId,\n   429\t                locatorKind: DATABASE_LOCATOR_KIND,\n   430\t                storePath: dbContainment.path,\n   431\t              },\n   432\t              records,\n   433\t              injected,\n   434\t            };\n   435\t          }\n   436\t        }\n   437\t      }\n   438\t    } catch {\n   439\t      return { ok: false, code: 'store_unreadable' };\n   440\t    } finally {\n   441\t      database.close();\n   442\t    }\n   443\t  }\n   444\t\n   445\t  // The database has no turns for this id, so the store is either an older\n   446\t  // transcript-only install or a request for a session it never held.\n   447\t  return loadTranscript(sessionId, dataDirectory, options);\n   448\t}\n---FILE .skilled/hooks/shared/session-readers/dsh.mjs\n     1\t// ───────────────────────────────────────────────────────────────────\n     2\t// MODULE: DeepSeek Harness Session Log Reader\n     3\t// ───────────────────────────────────────────────────────────────────\n     4\t// The harness writes a session log under a project key that collapses path\n     5\t// separators, so two projects can share one directory name. The session id is\n     6\t// the directory name and the log's own header is checked against both the id\n     7\t// and the caller's cwd before any event becomes an entry. Logs may be written\n     8\t// as a chain of Zstandard frames, one per append batch.\n     9\t\n    10\t// ─────────────────────────────────────────────────────────────────────────────\n    11\t// 1. IMPORTS\n    12\t// ─────────────────────────────────────────────────────────────────────────────\n    13\t\n    14\timport { readFileSync, readdirSync, statSync } from 'node:fs';\n    15\timport { join } from 'node:path';\n    16\timport { zstdDecompressSync } from 'node:zlib';\n    17\timport {\n    18\t  envOf,\n    19\t  homeDir,\n    20\t  isSafeSessionId,\n    21\t  resolveInside,\n    22\t  samePath,\n    23\t} from './identity.mjs';\n    24\timport {\n    25\t  contentText,\n    26\t  parseJsonObject,\n    27\t  textBlock,\n    28\t  thinkingBlock,\n    29\t  toolCallBlock,\n    30\t} from './project.mjs';\n    31\t\n    32\t// ─────────────────────────────────────────────────────────────────────────────\n    33\t// 2. CONSTANTS\n    34\t// ─────────────────────────────────────────────────────────────────────────────\n    35\t\n    36\tconst RUNTIME = 'dsh';\n    37\tconst LOCATOR_KIND = 'session_log';\n    38\tconst OPERATOR_SOURCE = 'user';\n    39\tconst SESSION_LOG_NAME = /^session(?:\\.v([1-9]\\d*))?\\.jsonl(\\.zstd)?$/;\n    40\t\n    41\tconst ZSTD_FRAME_MAGIC = 0xfd2fb528;\n    42\tconst SKIPPABLE_MAGIC_MASK = 0xfffffff0;\n    43\tconst SKIPPABLE_MAGIC = 0x184d2a50;\n    44\t\n    45\t// ─────────────────────────────────────────────────────────────────────────────\n    46\t// 3. LOG DECODING\n    47\t// ─────────────────────────────────────────────────────────────────────────────\n    48\t\n    49\t// Length of one Zstandard frame from its header and block headers (RFC 8878\n    50\t// §3.1.1). Node decodes only the first frame of a buffer, so the frames are cut\n    51\t// out and decoded one by one.\n    52\tfunction zstdFrameLength(buffer, start) {\n    53\t  let offset = start + 4;\n    54\t  const descriptor = buffer[offset];\n    55\t  if (descriptor === undefined) throw new Error('truncated Zstandard frame header');\n    56\t  offset += 1;\n    57\t\n    58\t  const contentSizeFlag = descriptor >> 6;\n    59\t  const singleSegment = (descriptor >> 5) & 1;\n    60\t  const hasChecksum = (descriptor >> 2) & 1;\n    61\t  const dictionaryIdFlag = descriptor & 3;\n    62\t  if (!singleSegment) offset += 1;\n    63\t  offset += [0, 1, 2, 4][dictionaryIdFlag];\n    64\t  offset += [singleSegment ? 1 : 0, 2, 4, 8][contentSizeFlag];\n    65\t\n    66\t  for (;;) {\n    67\t    if (offset + 3 > buffer.length) throw new Error('truncated Zstandard block header');\n    68\t    const header = buffer[offset] | (buffer[offset + 1] << 8) | (buffer[offset + 2] << 16);\n    69\t    offset += 3;\n    70\t    const lastBlock = header & 1;\n    71\t    const blockType = (header >> 1) & 3;\n    72\t    const blockSize = header >>> 3;\n    73\t    if (blockType === 3) throw new Error('reserved Zstandard block type');\n    74\t    offset += blockType === 1 ? 1 : blockSize;\n    75\t    if (lastBlock) break;\n    76\t  }\n    77\t  if (hasChecksum) offset += 4;\n    78\t  if (offset > buffer.length) throw new Error('truncated Zstandard frame');\n    79\t  return offset - start;\n    80\t}\n    81\t\n    82\texport function decodeSessionLog(buffer, fileName) {\n    83\t  if (!fileName.endsWith('.zstd')) return buffer.toString('utf8');\n    84\t\n    85\t  const parts = [];\n    86\t  let offset = 0;\n    87\t  while (offset + 4 <= buffer.length) {\n    88\t    const magic = buffer.readUInt32LE(offset);\n    89\t    if ((magic & SKIPPABLE_MAGIC_MASK) >>> 0 === SKIPPABLE_MAGIC) {\n    90\t      if (offset + 8 > buffer.length) throw new Error('truncated skippable frame');\n    91\t      offset += 8 + buffer.readUInt32LE(offset + 4);\n    92\t      continue;\n    93\t    }\n    94\t    if (magic !== ZSTD_FRAME_MAGIC) throw new Error(`unknown frame at byte ${offset}`);\n    95\t    const length = zstdFrameLength(buffer, offset);\n    96\t    parts.push(zstdDecompressSync(buffer.subarray(offset, offset + length)));\n    97\t    offset += length;\n    98\t  }\n    99\t  return Buffer.concat(parts).toString('utf8');\n   100\t}\n   101\t\n   102\tfunction parseEvents(text) {\n   103\t  const events = [];\n   104\t  for (const line of text.split('\\n')) {\n   105\t    if (!line.trim()) continue;\n   106\t    const parsed = parseJsonObject(line);\n   107\t    if (parsed) events.push(parsed);\n   108\t  }\n   109\t  return events;\n   110\t}\n   111\t\n   112\t// ─────────────────────────────────────────────────────────────────────────────\n   113\t// 4. STORE\n   114\t// ─────────────────────────────────────────────────────────────────────────────\n   115\t\n   116\texport function dshStoreRoot(options = {}) {\n   117\t  if (options.dshRoot) return options.dshRoot;\n   118\t  return join(envOf(options).DSH_HOME || join(homeDir(options), '.dsh'), 'sessions');\n   119\t}\n   120\t\n   121\t// The harness's own project-directory key: separators collapse to one `-`, and\n   122\t// any other unsafe code unit becomes a `~XXXX` escape.\n   123\texport function dshProjectKey(cwd) {\n   124\t  let readable = '';\n   125\t  let separatorRun = false;\n   126\t  for (let index = 0; index < cwd.length; index += 1) {\n   127\t    const code = cwd.charCodeAt(index);\n   128\t    const ch = String.fromCharCode(code);\n   129\t    if (ch === '/' || ch === '\\\\' || ch === ':') {\n   130\t      if (!separatorRun) readable += '-';\n   131\t      separatorRun = true;\n   132\t    } else if (ch !== '~' && /^[A-Za-z0-9._-]$/.test(ch)) {\n   133\t      readable += ch;\n   134\t      separatorRun = false;\n   135\t    } else {\n   136\t      readable += '~' + code.toString(16).toUpperCase().padStart(4, '0');\n   137\t      separatorRun = false;\n   138\t    }\n   139\t  }\n   140\t  return `--${(readable.replace(/^-+/, '') || 'root').slice(0, 251)}--`;\n   141\t}\n   142\t\n   143\tfunction sessionLogIn(directory) {\n   144\t  let best = null;\n   145\t  for (const fileName of readdirSync(directory)) {\n   146\t    const match = SESSION_LOG_NAME.exec(fileName);\n   147\t    if (!match) continue;\n   148\t    const version = Number(match[1] ?? 0);\n   149\t    if (!best || version > best.version) best = { version, path: join(directory, fileName) };\n   150\t  }\n   151\t  return best?.path ?? null;\n   152\t}\n   153\t\n   154\t// ─────────────────────────────────────────────────────────────────────────────\n   155\t// 5. ENTRY MAPPING\n   156\t// ─────────────────────────────────────────────────────────────────────────────\n   157\t\n   158\tfunction assistantBlocks(content) {\n   159\t  const blocks = [];\n   160\t  for (const item of Array.isArray(content) ? content : []) {\n   161\t    if (!item || typeof item !== 'object') continue;\n   162\t    if (item.type === 'text' && typeof item.text === 'string') {\n   163\t      blocks.push(textBlock(item.text));\n   164\t    } else if (item.type === 'thinking' && typeof item.thinking === 'string') {\n   165\t      blocks.push(thinkingBlock(item.thinking));\n   166\t    } else if (item.type === 'tool-call' && typeof item.id === 'string' && typeof item.name === 'string') {\n   167\t      blocks.push(toolCallBlock({\n   168\t        id: item.id,\n   169\t        name: item.name,\n   170\t        arguments: parseJsonObject(item.arguments) ?? item.arguments,\n   171\t      }));\n   172\t    }\n   173\t  }\n   174\t  return blocks;\n   175\t}\n   176\t\n   177\tfunction recordsFromEvents(events) {\n   178\t  const records = [];\n   179\t  const seenIds = new Set();\n   180\t  const keepFirst = (record) => {\n   181\t    // A compaction prune re-emits a shortened tool result under the same\n   182\t    // message id. The first copy holds the full output, which is what a\n   183\t    // lookup after compaction is for, so a repeated id is dropped.\n   184\t    if (seenIds.has(record.id)) return;\n   185\t    seenIds.add(record.id);\n   186\t    records.push(record);\n   187\t  };\n   188\t\n   189\t  events.forEach((event, index) => {\n   190\t    const data = event?.data;\n   191\t    if (!data || typeof data !== 'object') return;\n   192\t    // DSH stamps each event with `time` in epoch milliseconds.\n   193\t    const timestamp = event.time ?? event.timestamp ?? data.timestamp;\n   194\t\n   195\t    if (event.type === 'user/message' && data.source?.kind === OPERATOR_SOURCE) {\n   196\t      // Injected notices carry a non-operator source kind, so this text is\n   197\t      // operator content even when it opens with '<'.\n   198\t      const text = contentText(data.content);\n   199\t      if (!text) return;\n   200\t      keepFirst({\n   201\t        id: String(data.id ?? `dsh-user-${index}`).slice(0, 128),\n   202\t        role: 'user',\n   203\t        timestamp,\n   204\t        content: [textBlock(text)],\n   205\t      });\n   206\t      return;\n   207\t    }\n   208\t\n   209\t    if (event.type === 'assistant/message') {\n   210\t      const message = data.message;\n   211\t      const blocks = assistantBlocks(message?.content);\n   212\t      if (blocks.length === 0) return;\n   213\t      keepFirst({\n   214\t        id: String(message?.id ?? data.id ?? `dsh-assistant-${index}`).slice(0, 128),\n   215\t        role: 'assistant',\n   216\t        timestamp,\n   217\t        content: blocks,\n   218\t      });\n   219\t      return;\n   220\t    }\n   221\t\n   222\t    if (event.type === 'tool/result') {\n   223\t      const message = data.message;\n   224\t      if (typeof message?.toolCallId !== 'string' || !message.toolCallId) return;\n   225\t      const text = contentText(message.content);\n   226\t      const record = {\n   227\t        id: String(message.id ?? `dsh-result-${index}`).slice(0, 128),\n   228\t        role: 'toolResult',\n   229\t        timestamp,\n   230\t        content: [textBlock(text)],\n   231\t        toolCallId: message.toolCallId,\n   232\t      };\n   233\t      if (message.isError === true) record.isError = true;\n   234\t      keepFirst(record);\n   235\t    }\n   236\t  });\n   237\t\n   238\t  return records;\n   239\t}\n   240\t\n   241\t// A hook notice arrives as a user-role message whose source is not the operator.\n   242\t// It never becomes a record, because the operator did not write it, and the text\n   243\t// is kept here so a caller can still tell what the harness put into the turn.\n   244\tfunction injectedFromEvents(events) {\n   245\t  const injected = [];\n   246\t  for (const event of events) {\n   247\t    if (event?.type !== 'user/message') continue;\n   248\t    const data = event.data;\n   249\t    if (!data || typeof data !== 'object') continue;\n   250\t    if (data.source?.kind === OPERATOR_SOURCE) continue;\n   251\t    const text = contentText(data.content);\n   252\t    if (!text) continue;\n   253\t    injected.push({ source: data.source?.kind ?? 'unknown', text });\n   254\t  }\n   255\t  return injected;\n   256\t}\n   257\t\n   258\t// ─────────────────────────────────────────────────────────────────────────────\n   259\t// 6. LOADER\n   260\t// ─────────────────────────────────────────────────────────────────────────────\n   261\t\n   262\texport function loadDshSession({ sessionId, projectDir, sessionPath, ...options } = {}) {\n   263\t  if (!isSafeSessionId(sessionId)) {\n   264\t    return { ok: false, code: sessionId ? 'session_mismatch' : 'locator_unavailable' };\n   265\t  }\n   266\t  if (typeof projectDir !== 'string' || !projectDir.trim()) {\n   267\t    return { ok: false, code: 'locator_unavailable' };\n   268\t  }\n   269\t\n   270\t  const root = dshStoreRoot(options);\n   271\t  let logPath = sessionPath;\n   272\t\n   273\t  if (!logPath) {\n   274\t    const projectRoot = join(root, dshProjectKey(projectDir));\n   275\t    try {\n   276\t      statSync(root);\n   277\t    } catch {\n   278\t      return { ok: false, code: 'store_unreadable' };\n   279\t    }\n   280\t    try {\n   281\t      statSync(projectRoot);\n   282\t    } catch {\n   283\t      return { ok: false, code: 'session_not_found' };\n   284\t    }\n   285\t\n   286\t    // The session directory is named by the exact id, so a newer decoy session\n   287\t    // is never opened while the requested one is missing.\n   288\t    const sessionDirectory = join(projectRoot, sessionId);\n   289\t    try {\n   290\t      statSync(sessionDirectory);\n   291\t    } catch {\n   292\t      return { ok: false, code: 'session_not_found' };\n   293\t    }\n   294\t    try {\n   295\t      logPath = sessionLogIn(sessionDirectory);\n   296\t    } catch {\n   297\t      return { ok: false, code: 'store_unreadable' };\n   298\t    }\n   299\t    if (!logPath) return { ok: false, code: 'session_not_found' };\n   300\t  }\n   301\t\n   302\t  // Containment is decided before the file is opened, so a path outside the\n   303\t  // store is refused without its content ever being read.\n   304\t  const containment = resolveInside({ path: logPath, root });\n   305\t  if (!containment.ok) return containment;\n   306\t  const storePath = containment.path;\n   307\t\n   308\t  let events;\n   309\t  try {\n   310\t    events = parseEvents(decodeSessionLog(readFileSync(logPath), logPath));\n   311\t  } catch {\n   312\t    return { ok: false, code: 'store_unreadable' };\n   313\t  }\n   314\t\n   315\t  const header = events[0]?.type === 'session' ? events[0] : null;\n   316\t  if (typeof header?.id !== 'string' || !header.id) {\n   317\t    return { ok: false, code: 'store_unreadable' };\n   318\t  }\n   319\t  if (header.id !== sessionId) return { ok: false, code: 'session_mismatch' };\n   320\t  if (!samePath(header.cwd, projectDir)) return { ok: false, code: 'session_mismatch' };\n   321\t\n   322\t  return {\n   323\t    ok: true,\n   324\t    source: {\n   325\t      runtime: RUNTIME,\n   326\t      sessionId,\n   327\t      locatorKind: LOCATOR_KIND,\n   328\t      storePath,\n   329\t    },\n   330\t    records: recordsFromEvents(events),\n   331\t    injected: injectedFromEvents(events),\n   332\t  };\n   333\t}\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"total 416\ndrwxr-xr-x@ 33 michelkerkmeester  staff   1056 Nov 13 06:59 .\ndrwxr-xr-x@ 16 michelkerkmeester  staff    512 Nov 12 10:24 ..\n-rw-r--r--@  1 michelkerkmeester  staff    486 Nov 13 06:59 claude.d.mts\n-rw-r--r--@  1 michelkerkmeester  staff    140 Nov 13 06:59 claude.d.mts.map\n-rw-r--r--@  1 michelkerkmeester  staff  11177 Nov 13 06:59 claude.mjs\n-rw-r--r--@  1 michelkerkmeester  staff    412 Nov 13 06:08 codex.d.mts\n-rw-r--r--@  1 michelkerkmeester  staff    134 Nov 13 06:08 codex.d.mts.map\n-rw-r--r--@  1 michelkerkmeester  staff   8732 Nov 12 10:24 codex.mjs\n-rw-r--r--@  1 michelkerkmeester  staff    188 Nov 13 06:08 cursor.d.mts\n-rw-r--r--@  1 michelkerkmeester  staff    124 Nov 13 06:08 cursor.d.mts.map\n-rw-r--r--@  1 michelkerkmeester  staff   2839 Nov 12 10:24 cursor.mjs\n-rw-r--r--@  1 michelkerkmeester  staff    653 Nov 13 06:59 devin.d.mts\n-rw-r--r--@  1 michelkerkmeester  staff    164 Nov 13 06:59 devin.d.mts.map\n-rw-r--r--@  1 michelkerkmeester  staff  17398 Nov 13 06:59 devin.mjs\n-rw-r--r--@  1 michelkerkmeester  staff    662 Nov 13 06:59 dsh.d.mts\n-rw-r--r--@  1 michelkerkmeester  staff    163 Nov 13 06:59 dsh.d.mts.map\n-rw-r--r--@  1 michelkerkmeester  staff  13783 Nov 13 06:59 dsh.mjs\n-rw-r--r--@  1 michelkerkmeester  staff    945 Nov 13 06:08 identity.d.mts\n-rw-r--r--@  1 michelkerkmeester  staff    211 Nov 13 06:08 identity.d.mts.map\n-rw-r--r--@  1 michelkerkmeester  staff   6854 Nov 12 10:24 identity.mjs\n-rw-r--r--@  1 michelkerkmeester  staff   1842 Nov 13 06:08 index.d.mts\n-rw-r--r--@  1 michelkerkmeester  staff    373 Nov 13 06:59 index.d.mts.map\n-rw-r--r--@  1 michelkerkmeester  staff   6293 Nov 13 06:59 index.mjs\n-rw-r--r--@  1 michelkerkmeester  staff   1271 Nov 13 06:08 opencode.d.mts\n-rw-r--r--@  1 michelkerkmeester  staff    191 Nov 13 06:08 opencode.d.mts.map\n-rw-r--r--@  1 michelkerkmeester  staff  13470 Nov 12 10:24 opencode.mjs\n-rw-r--r--@  1 michelkerkmeester  staff   1023 Nov 13 06:59 pi.d.mts\n-rw-r--r--@  1 michelkerkmeester  staff    168 Nov 13 06:59 pi.d.mts.map\n-rw-r--r--@  1 michelkerkmeester  staff  11899 Nov 13 06:59 pi.mjs\n-rw-r--r--@  1 michelkerkmeester  staff   1192 Nov 13 06:08 project.d.mts\n-rw-r--r--@  1 michelkerkmeester  staff    234 Nov 13 06:08 project.d.mts.map\n-rw-r--r--@  1 michelkerkmeester  staff  10119 Nov 12 10:24 project.mjs\n-rw-r--r--@  1 michelkerkmeester  staff   4683 Nov 13 06:59 README.md\n=== devin/dsh ===\n---FILE .skilled/hooks/shared/session-readers/devin.mjs\n     1\t// ───────────────────────────────────────────────────────────────────\n     2\t// MODULE: Devin CLI Session Reader\n     3\t// ───────────────────────────────────────────────────────────────────\n     4\t// Devin writes its history to a SQLite sessions database, with one row per\n     5\t// session and one message row per node of that session's conversation tree.\n     6\t// Older builds named a JSON transcript after the session instead, so the file\n     7\t// remains a fallback for a store that has no database record. A read is accepted\n     8\t// only when the session's own row agrees with the request and its recorded\n     9\t// working directory is the caller's project; either disagreement means the\n    10\t// record describes another session.\n    11\t\n    12\t// ─────────────────────────────────────────────────────────────────────────────\n    13\t// 1. IMPORTS\n    14\t// ─────────────────────────────────────────────────────────────────────────────\n    15\t\n    16\timport { createRequire } from 'node:module';\n    17\timport { existsSync, readFileSync, statSync } from 'node:fs';\n    18\timport { join } from 'node:path';\n    19\timport {\n    20\t  envOf,\n    21\t  homeDir,\n    22\t  isSafeSessionId,\n    23\t  resolveInside,\n    24\t  atOrBelow,\n    25\t  samePath,\n    26\t} from './identity.mjs';\n    27\timport {\n    28\t  isoOr,\n    29\t  parseJsonObject,\n    30\t  textBlock,\n    31\t  toolCallBlock,\n    32\t} from './project.mjs';\n    33\t\n    34\tconst require = createRequire(import.meta.url);\n    35\t\n    36\t// ─────────────────────────────────────────────────────────────────────────────\n    37\t// 2. CONSTANTS\n    38\t// ─────────────────────────────────────────────────────────────────────────────\n    39\t\n    40\tconst RUNTIME = 'devin';\n    41\tconst DATABASE_LOCATOR_KIND = 'session_id';\n    42\tconst TRANSCRIPT_LOCATOR_KIND = 'transcript_file';\n    43\tconst DATABASE_FILE = 'sessions.db';\n    44\tconst TRANSCRIPT_EXT = '.json';\n    45\t\n    46\t// ─────────────────────────────────────────────────────────────────────────────\n    47\t// 3. STORE\n    48\t// ─────────────────────────────────────────────────────────────────────────────\n    49\t\n    50\texport function devinDataDirectory(options = {}) {\n    51\t  if (options.devinDataHome) return options.devinDataHome;\n    52\t  const dataHome = envOf(options).XDG_DATA_HOME || join(homeDir(options), '.local', 'share');\n    53\t  return join(dataHome, 'devin', 'cli');\n    54\t}\n    55\t\n    56\texport function devinTranscriptRoot(options = {}) {\n    57\t  return join(devinDataDirectory(options), 'transcripts');\n    58\t}\n    59\t\n    60\texport function devinDatabasePath(options = {}) {\n    61\t  return options.dbPath ?? join(devinDataDirectory(options), DATABASE_FILE);\n    62\t}\n    63\t\n    64\tfunction openDatabase(dbPath) {\n    65\t  const { DatabaseSync } = require('node:sqlite');\n    66\t  return new DatabaseSync(dbPath, { readOnly: true });\n    67\t}\n    68\t\n    69\tfunction tableColumns(database, table) {\n    70\t  return new Set(database.prepare(`PRAGMA table_info('${table}')`).all().map((row) => row.name));\n    71\t}\n    72\t\n    73\tfunction sessionRow(database, sessionId) {\n    74\t  const columns = tableColumns(database, 'sessions');\n    75\t  if (!columns.has('id')) return null;\n    76\t\n    77\t  // A store that predates a column still names the session, so each optional\n    78\t  // column is selected only when the table has it.\n    79\t  const selected = ['id'];\n    80\t  for (const name of ['working_directory', 'main_chain_id']) {\n    81\t    if (columns.has(name)) selected.push(name);\n    82\t  }\n    83\t\n    84\t  const row = database.prepare(`SELECT ${selected.join(', ')} FROM sessions WHERE id = ?`).get(sessionId);\n    85\t  return row && row.id === sessionId ? row : null;\n    86\t}\n    87\t\n    88\t// ─────────────────────────────────────────────────────────────────────────────\n    89\t// 4. DATABASE PROJECTION\n    90\t// ─────────────────────────────────────────────────────────────────────────────\n    91\t\n    92\tfunction nodeTimestamp(node, message) {\n    93\t  const recorded = message.metadata?.created_at;\n    94\t  if (recorded !== undefined && recorded !== null) return isoOr(recorded);\n    95\t  // The node clock is stored in whole seconds, while the shared normalizer\n    96\t  // expects milliseconds.\n    97\t  return isoOr(typeof node.created_at === 'number' ? node.created_at * 1000 : undefined);\n    98\t}\n    99\t\n   100\tfunction nodeIdentifier(node, message) {\n   101\t  const stored = typeof message.message_id === 'string' && message.message_id\n   102\t    ? message.message_id\n   103\t    : String(node.node_id);\n   104\t  return `devin-${stored}`.slice(0, 128);\n   105\t}\n   106\t\n   107\t// The message store is a forest: every request re-records the prompt it was\n   108\t// built from, so a plain row scan would repeat messages. The session's main\n   109\t// chain names the live path, and walking it back to its root yields each node\n   110\t// once in conversation order.\n   111\tfunction chainFromHead(nodes, headId) {\n   112\t  if (headId == null) return null;\n   113\t\n   114\t  const byNodeId = new Map(nodes.map((node) => [node.node_id, node]));\n   115\t  const chain = [];\n   116\t  const seen = new Set();\n   117\t  let cursor = byNodeId.get(headId);\n   118\t\n   119\t  while (cursor) {\n   120\t    if (seen.has(cursor.node_id)) return null;\n   121\t    seen.add(cursor.node_id);\n   122\t    chain.push(cursor);\n   123\t\n   124\t    if (cursor.parent_node_id == null) break;\n   125\t    const parent = byNodeId.get(cursor.parent_node_id);\n   126\t    if (!parent) return null;\n   127\t    cursor = parent;\n   128\t  }\n   129\t\n   130\t  return chain.reverse();\n   131\t}\n   132\t\n   133\tfunction recordsFromChain(chain) {\n   134\t  const records = [];\n   135\t\n   136\t  for (const node of chain) {\n   137\t    const message = parseJsonObject(node.chat_message);\n   138\t    if (!message) continue;\n   139\t\n   140\t    const timestamp = nodeTimestamp(node, message);\n   141\t    const id = nodeIdentifier(node, message);\n   142\t    const text = typeof message.content === 'string' ? message.content : '';\n   143\t\n   144\t    if (message.role === 'user') {\n   145\t      // Synthetic prompt context is also stored as a user row; only content the\n   146\t      // operator typed carries the input flag, so an unflagged row is skipped.\n   147\t      const isInput = message.metadata?.is_user_input;\n   148\t      if (isInput !== true && isInput !== 1) continue;\n   149\t      if (!text) continue;\n   150\t      records.push({ id, role: 'user', timestamp, content: [textBlock(text)] });\n   151\t      continue;\n   152\t    }\n   153\t\n   154\t    if (message.role === 'assistant') {\n   155\t      const blocks = [];\n   156\t      if (text) blocks.push(textBlock(text));\n   157\t      for (const call of Array.isArray(message.tool_calls) ? message.tool_calls : []) {\n   158\t        if (typeof call?.id !== 'string' || typeof call.name !== 'string') continue;\n   159\t        blocks.push(toolCallBlock({\n   160\t          id: call.id,\n   161\t          name: call.name,\n   162\t          arguments: call.arguments,\n   163\t        }));\n   164\t      }\n   165\t      if (blocks.length > 0) {\n   166\t        records.push({ id, role: 'assistant', timestamp, content: blocks });\n   167\t      }\n   168\t      continue;\n   169\t    }\n   170\t\n   171\t    if (message.role === 'tool' && typeof message.tool_call_id === 'string') {\n   172\t      records.push({\n   173\t        id,\n   174\t        role: 'toolResult',\n   175\t        timestamp,\n   176\t        content: [textBlock(text)],\n   177\t        toolCallId: message.tool_call_id,\n   178\t      });\n   179\t    }\n   180\t  }\n   181\t\n   182\t  return records;\n   183\t}\n   184\t\n   185\t// A system node carries the harness context a compaction or a session start\n   186\t// injected. A user node without the input flag is prompt context the harness\n   187\t// wrote, not text the operator typed, so it is injected context too and never\n   188\t// a conversation record.\n   189\tfunction injectedFromChain(chain) {\n   190\t  const injected = [];\n   191\t\n   192\t  for (const node of chain) {\n   193\t    const message = parseJsonObject(node.chat_message);\n   194\t    if (!message) continue;\n   195\t\n   196\t    const text = typeof message.content === 'string' ? message.content : '';\n   197\t    if (!text) continue;\n   198\t\n   199\t    if (message.role === 'system') {\n   200\t      injected.push({ source: message.role, text });\n   201\t      continue;\n   202\t    }\n   203\t\n   204\t    if (message.role === 'user') {\n   205\t      const isInput = message.metadata?.is_user_input;\n   206\t      if (isInput === true || isInput === 1) continue;\n   207\t      injected.push({ source: 'unflagged-user', text });\n   208\t    }\n   209\t  }\n   210\t\n   211\t  return injected;\n   212\t}\n   213\t\n   214\tfunction summarizedFrom(node) {\n   215\t  const value = parseJsonObject(node.metadata)?.summarized_from;\n   216\t  return Number.isInteger(value) ? value : null;\n   217\t}\n   218\t\n   219\t// A compaction starts a new thread whose root has no parent, so the live chain\n   220\t// alone holds only the turns after it. The thread's continuation node names\n   221\t// the last node of the thread it summarized, and following that link back,\n   222\t// once per compaction, restores the turns the compaction dropped.\n   223\tfunction chainWithEarlierThreads(nodes, headId) {\n   224\t  const threads = [];\n   225\t  const visited = new Set();\n   226\t  let head = headId;\n   227\t  while (head != null) {\n   228\t    if (visited.has(head)) return null;\n   229\t    visited.add(head);\n   230\t    const thread = chainFromHead(nodes, head);\n   231\t    if (!thread) return null;\n   232\t    threads.unshift(thread);\n   233\t    const link = thread.find((node) => summarizedFrom(node) !== null);\n   234\t    head = link ? summarizedFrom(link) : null;\n   235\t  }\n   236\t  return threads.flat();\n   237\t}\n   238\t\n   239\tfunction recordsFromDatabase(database, sessionId, headId) {\n   240\t  const nodes = database\n   241\t    .prepare('SELECT node_id, parent_node_id, chat_message, metadata, created_at FROM message_nodes WHERE session_id = ? ORDER BY node_id')\n   242\t    .all(sessionId);\n   243\t\n   244\t  if (nodes.length === 0) return { records: [], injected: [] };\n   245\t\n   246\t  const chain = chainWithEarlierThreads(nodes, headId);\n   247\t  return chain ? { records: recordsFromChain(chain), injected: injectedFromChain(chain) } : null;\n   248\t}\n   249\t\n   250\t// ─────────────────────────────────────────────────────────────────────────────\n   251\t// 5. TRANSCRIPT MAPPING\n   252\t// ─────────────────────────────────────────────────────────────────────────────\n   253\t\n   254\tfunction recordsFromSteps(steps) {\n   255\t  const records = [];\n   256\t\n   257\t  steps.forEach((step, stepIndex) => {\n   258\t    if (!step || typeof step !== 'object') return;\n   259\t    const stepId = step.step_id ?? stepIndex;\n   260\t    const timestamp = step.timestamp;\n   261\t    const message = typeof step.message === 'string' ? step.message : '';\n   262\t\n   263\t    if (step.source === 'user') {\n   264\t      // Harness and system content arrives under a different `source` value, so\n   265\t      // a user step is operator content even when it opens with '<'.\n   266\t      if (!message) return;\n   267\t      records.push({\n   268\t        id: `devin-${stepId}`.slice(0, 128),\n   269\t        role: 'user',\n   270\t        timestamp,\n   271\t        content: [textBlock(message)],\n   272\t      });\n   273\t      return;\n   274\t    }\n   275\t\n   276\t    if (step.source !== 'agent') return;\n   277\t\n   278\t    const toolCalls = Array.isArray(step.tool_calls) ? step.tool_calls : [];\n   279\t    const blocks = [];\n   280\t    if (message) blocks.push(textBlock(message));\n   281\t    for (const call of toolCalls) {\n   282\t      if (typeof call?.tool_call_id !== 'string' || typeof call.function_name !== 'string') continue;\n   283\t      blocks.push(toolCallBlock({\n   284\t        id: call.tool_call_id,\n   285\t        name: call.function_name,\n   286\t        arguments: call.arguments,\n   287\t      }));\n   288\t    }\n   289\t    if (blocks.length > 0) {\n   290\t      records.push({\n   291\t        id: `devin-${stepId}`.slice(0, 128),\n   292\t        role: 'assistant',\n   293\t        timestamp,\n   294\t        content: blocks,\n   295\t      });\n   296\t    }\n   297\t\n   298\t    const results = Array.isArray(step.observation?.results) ? step.observation.results : [];\n   299\t    results.forEach((result, resultIndex) => {\n   300\t      if (typeof result?.source_call_id !== 'string') return;\n   301\t      const content = typeof result.content === 'string' ? result.content : '';\n   302\t      records.push({\n   303\t        id: `devin-${stepId}-result-${resultIndex}`.slice(0, 128),\n   304\t        role: 'toolResult',\n   305\t        timestamp,\n   306\t        content: [textBlock(content)],\n   307\t        toolCallId: result.source_call_id,\n   308\t      });\n   309\t    });\n   310\t  });\n   311\t\n   312\t  return records;\n   313\t}\n   314\t\n   315\t// Harness and system steps are not conversation records, but they are context\n   316\t// the next turn saw, kept apart so a caller can tell what the operator typed.\n   317\tfunction injectedFromSteps(steps) {\n   318\t  const injected = [];\n   319\t\n   320\t  for (const step of steps) {\n   321\t    if (!step || typeof step !== 'object') continue;\n   322\t    if (step.source === 'user' || step.source === 'agent') continue;\n   323\t    if (typeof step.message !== 'string' || !step.message) continue;\n   324\t    injected.push({ source: step.source, text: step.message });\n   325\t  }\n   326\t\n   327\t  return injected;\n   328\t}\n   329\t\n   330\t// ─────────────────────────────────────────────────────────────────────────────\n   331\t// 6. LOADER\n   332\t// ─────────────────────────────────────────────────────────────────────────────\n   333\t\n   334\tfunction loadTranscript(sessionId, dataDirectory, options) {\n   335\t  const root = devinTranscriptRoot(options);\n   336\t  const transcriptPath = options.transcriptPath ?? join(root, `${sessionId}${TRANSCRIPT_EXT}`);\n   337\t\n   338\t  // Containment is decided before the file is opened, so a path outside the\n   339\t  // store is refused without its content ever being read.\n   340\t  const containment = resolveInside({ path: transcriptPath, root });\n   341\t  if (!containment.ok) {\n   342\t    if (containment.code === 'session_mismatch') return containment;\n   343\t    try {\n   344\t      statSync(dataDirectory);\n   345\t      return { ok: false, code: 'session_not_found' };\n   346\t    } catch {\n   347\t      return { ok: false, code: 'store_unreadable' };\n   348\t    }\n   349\t  }\n   350\t  const storePath = containment.path;\n   351\t\n   352\t  let raw;\n   353\t  try {\n   354\t    raw = readFileSync(transcriptPath, 'utf8');\n   355\t  } catch {\n   356\t    try {\n   357\t      statSync(dataDirectory);\n   358\t      return { ok: false, code: 'session_not_found' };\n   359\t    } catch {\n   360\t      return { ok: false, code: 'store_unreadable' };\n   361\t    }\n   362\t  }\n   363\t\n   364\t  const transcript = parseJsonObject(raw);\n   365\t  if (!transcript) return { ok: false, code: 'store_unreadable' };\n   366\t  if (typeof transcript.session_id === 'string' && transcript.session_id !== sessionId) {\n   367\t    return { ok: false, code: 'session_mismatch' };\n   368\t  }\n   369\t\n   370\t  const steps = Array.isArray(transcript.steps) ? transcript.steps : [];\n   371\t  return {\n   372\t    ok: true,\n   373\t    source: {\n   374\t      runtime: RUNTIME,\n   375\t      sessionId,\n   376\t      locatorKind: TRANSCRIPT_LOCATOR_KIND,\n   377\t      storePath,\n   378\t    },\n   379\t    records: recordsFromSteps(steps),\n   380\t    injected: injectedFromSteps(steps),\n   381\t  };\n   382\t}\n   383\t\n   384\texport function loadDevinSession({ sessionId, projectDir, ...options } = {}) {\n   385\t  if (!isSafeSessionId(sessionId)) {\n   386\t    return { ok: false, code: sessionId ? 'session_mismatch' : 'locator_unavailable' };\n   387\t  }\n   388\t  if (typeof projectDir !== 'string' || !projectDir.trim()) {\n   389\t    return { ok: false, code: 'locator_unavailable' };\n   390\t  }\n   391\t\n   392\t  const dataDirectory = devinDataDirectory(options);\n   393\t  const dbPath = devinDatabasePath(options);\n   394\t\n   395\t  if (existsSync(dbPath)) {\n   396\t    const dbContainment = resolveInside({ path: dbPath, root: dataDirectory });\n   397\t    if (!dbContainment.ok) return dbContainment;\n   398\t\n   399\t    let database;\n   400\t    try {\n   401\t      database = openDatabase(dbContainment.path);\n   402\t    } catch {\n   403\t      return { ok: false, code: 'store_unreadable' };\n   404\t    }\n   405\t\n   406\t    try {\n   407\t      const row = sessionRow(database, sessionId);\n   408\t      if (row) {\n   409\t        // Devin's hooks receive the project root, while the row records the\n   410\t        // folder the session ran in, which may sit below that root.\n   411\t        if (Object.hasOwn(row, 'working_directory') && !atOrBelow(row.working_directory, projectDir)) {\n   412\t          return { ok: false, code: 'session_mismatch' };\n   413\t        }\n   414\t\n   415\t        // An older store names its sessions but keeps their turns only in\n   416\t        // transcript files, so a database with no message rows for this\n   417\t        // session, or no chain head to walk, falls through.\n   418\t        if (tableColumns(database, 'message_nodes').size > 0) {\n   419\t          const projection = recordsFromDatabase(database, sessionId, row.main_chain_id);\n   420\t          if (!projection) return { ok: false, code: 'store_unreadable' };\n   421\t\n   422\t          const { records, injected } = projection;\n   423\t          if (records.length > 0) {\n   424\t            return {\n   425\t              ok: true,\n   426\t              source: {\n   427\t                runtime: RUNTIME,\n   428\t                sessionId,\n   429\t                locatorKind: DATABASE_LOCATOR_KIND,\n   430\t                storePath: dbContainment.path,\n   431\t              },\n   432\t              records,\n   433\t              injected,\n   434\t            };\n   435\t          }\n   436\t        }\n   437\t      }\n   438\t    } catch {\n   439\t      return { ok: false, code: 'store_unreadable' };\n   440\t    } finally {\n   441\t      database.close();\n   442\t    }\n   443\t  }\n   444\t\n   445\t  // The database has no turns for this id, so the store is either an older\n   446\t  // transcript-only install or a request for a session it never held.\n   447\t  return loadTranscript(sessionId, dataDirectory, options);\n   448\t}\n---FILE .skilled/hooks/shared/session-readers/dsh.mjs\n     1\t// ───────────────────────────────────────────────────────────────────\n     2\t// MODULE: DeepSeek Harness Session Log Reader\n     3\t// ───────────────────────────────────────────────────────────────────\n     4\t// The harness writes a session log under a project key that collapses path\n     5\t// separators, so two projects can share one directory name. The session id is\n     6\t// the directory name and the log's own header is checked against both the id\n     7\t// and the caller's cwd before any event becomes an entry. Logs may be written\n     8\t// as a chain of Zstandard frames, one per append batch.\n     9\t\n    10\t// ─────────────────────────────────────────────────────────────────────────────\n    11\t// 1. IMPORTS\n    12\t// ─────────────────────────────────────────────────────────────────────────────\n    13\t\n    14\timport { readFileSync, readdirSync, statSync } from 'node:fs';\n    15\timport { join } from 'node:path';\n    16\timport { zstdDecompressSync } from 'node:zlib';\n    17\timport {\n    18\t  envOf,\n    19\t  homeDir,\n    20\t  isSafeSessionId,\n    21\t  resolveInside,\n    22\t  samePath,\n    23\t} from './identity.mjs';\n    24\timport {\n    25\t  contentText,\n    26\t  parseJsonObject,\n    27\t  textBlock,\n    28\t  thinkingBlock,\n    29\t  toolCallBlock,\n    30\t} from './project.mjs';\n    31\t\n    32\t// ─────────────────────────────────────────────────────────────────────────────\n    33\t// 2. CONSTANTS\n    34\t// ─────────────────────────────────────────────────────────────────────────────\n    35\t\n    36\tconst RUNTIME = 'dsh';\n    37\tconst LOCATOR_KIND = 'session_log';\n    38\tconst OPERATOR_SOURCE = 'user';\n    39\tconst SESSION_LOG_NAME = /^session(?:\\.v([1-9]\\d*))?\\.jsonl(\\.zstd)?$/;\n    40\t\n    41\tconst ZSTD_FRAME_MAGIC = 0xfd2fb528;\n    42\tconst SKIPPABLE_MAGIC_MASK = 0xfffffff0;\n    43\tconst SKIPPABLE_MAGIC = 0x184d2a50;\n    44\t\n    45\t// ─────────────────────────────────────────────────────────────────────────────\n    46\t// 3. LOG DECODING\n    47\t// ─────────────────────────────────────────────────────────────────────────────\n    48\t\n    49\t// Length of one Zstandard frame from its header and block headers (RFC 8878\n    50\t// §3.1.1). Node decodes only the first frame of a buffer, so the frames are cut\n    51\t// out and decoded one by one.\n    52\tfunction zstdFrameLength(buffer, start) {\n    53\t  let offset = start + 4;\n    54\t  const descriptor = buffer[offset];\n    55\t  if (descriptor === undefined) throw new Error('truncated Zstandard frame header');\n    56\t  offset += 1;\n    57\t\n    58\t  const contentSizeFlag = descriptor >> 6;\n    59\t  const singleSegment = (descriptor >> 5) & 1;\n    60\t  const hasChecksum = (descriptor >> 2) & 1;\n    61\t  const dictionaryIdFlag = descriptor & 3;\n    62\t  if (!singleSegment) offset += 1;\n    63\t  offset += [0, 1, 2, 4][dictionaryIdFlag];\n    64\t  offset += [singleSegment ? 1 : 0, 2, 4, 8][contentSizeFlag];\n    65\t\n    66\t  for (;;) {\n    67\t    if (offset + 3 > buffer.length) throw new Error('truncated Zstandard block header');\n    68\t    const header = buffer[offset] | (buffer[offset + 1] << 8) | (buffer[offset + 2] << 16);\n    69\t    offset += 3;\n    70\t    const lastBlock = header & 1;\n    71\t    const blockType = (header >> 1) & 3;\n    72\t    const blockSize = header >>> 3;\n    73\t    if (blockType === 3) throw new Error('reserved Zstandard block type');\n    74\t    offset += blockType === 1 ? 1 : blockSize;\n    75\t    if (lastBlock) break;\n    76\t  }\n    77\t  if (hasChecksum) offset += 4;\n    78\t  if (offset > buffer.length) throw new Error('truncated Zstandard frame');\n    79\t  return offset - start;\n    80\t}\n    81\t\n    82\texport function decodeSessionLog(buffer, fileName) {\n    83\t  if (!fileName.endsWith('.zstd')) return buffer.toString('utf8');\n    84\t\n    85\t  const parts = [];\n    86\t  let offset = 0;\n    87\t  while (offset + 4 <= buffer.length) {\n    88\t    const magic = buffer.readUInt32LE(offset);\n    89\t    if ((magic & SKIPPABLE_MAGIC_MASK) >>> 0 === SKIPPABLE_MAGIC) {\n    90\t      if (offset + 8 > buffer.length) throw new Error('truncated skippable frame');\n    91\t      offset += 8 + buffer.readUInt32LE(offset + 4);\n    92\t      continue;\n    93\t    }\n    94\t    if (magic !== ZSTD_FRAME_MAGIC) throw new Error(`unknown frame at byte ${offset}`);\n    95\t    const length = zstdFrameLength(buffer, offset);\n    96\t    parts.push(zstdDecompressSync(buffer.subarray(offset, offset + length)));\n    97\t    offset += length;\n    98\t  }\n    99\t  return Buffer.concat(parts).toString('utf8');\n   100\t}\n   101\t\n   102\tfunction parseEvents(text) {\n   103\t  const events = [];\n   104\t  for (const line of text.split('\\n')) {\n   105\t    if (!line.trim()) continue;\n   106\t    const parsed = parseJsonObject(line);\n   107\t    if (parsed) events.push(parsed);\n   108\t  }\n   109\t  return events;\n   110\t}\n   111\t\n   112\t// ─────────────────────────────────────────────────────────────────────────────\n   113\t// 4. STORE\n   114\t// ─────────────────────────────────────────────────────────────────────────────\n   115\t\n   116\texport function dshStoreRoot(options = {}) {\n   117\t  if (options.dshRoot) return options.dshRoot;\n   118\t  return join(envOf(options).DSH_HOME || join(homeDir(options), '.dsh'), 'sessions');\n   119\t}\n   120\t\n   121\t// The harness's own project-directory key: separators collapse to one `-`, and\n   122\t// any other unsafe code unit becomes a `~XXXX` escape.\n   123\texport function dshProjectKey(cwd) {\n   124\t  let readable = '';\n   125\t  let separatorRun = false;\n   126\t  for (let index = 0; index < cwd.length; index += 1) {\n   127\t    const code = cwd.charCodeAt(index);\n   128\t    const ch = String.fromCharCode(code);\n   129\t    if (ch === '/' || ch === '\\\\' || ch === ':') {\n   130\t      if (!separatorRun) readable += '-';\n   131\t      separatorRun = true;\n   132\t    } else if (ch !== '~' && /^[A-Za-z0-9._-]$/.test(ch)) {\n   133\t      readable += ch;\n   134\t      separatorRun = false;\n   135\t    } else {\n   136\t      readable += '~' + code.toString(16).toUpperCase().padStart(4, '0');\n   137\t      separatorRun = false;\n   138\t    }\n   139\t  }\n   140\t  return `--${(readable.replace(/^-+/, '') || 'root').slice(0, 251)}--`;\n   141\t}\n   142\t\n   143\tfunction sessionLogIn(directory) {\n   144\t  let best = null;\n   145\t  for (const fileName of readdirSync(directory)) {\n   146\t    const match = SESSION_LOG_NAME.exec(fileName);\n   147\t    if (!match) continue;\n   148\t    const version = Number(match[1] ?? 0);\n   149\t    if (!best || version > best.version) best = { version, path: join(directory, fileName) };\n   150\t  }\n   151\t  return best?.path ?? null;\n   152\t}\n   153\t\n   154\t// ─────────────────────────────────────────────────────────────────────────────\n   155\t// 5. ENTRY MAPPING\n   156\t// ─────────────────────────────────────────────────────────────────────────────\n   157\t\n   158\tfunction assistantBlocks(content) {\n   159\t  const blocks = [];\n   160\t  for (const item of Array.isArray(content) ? content : []) {\n   161\t    if (!item || typeof item !== 'object') continue;\n   162\t    if (item.type === 'text' && typeof item.text === 'string') {\n   163\t      blocks.push(textBlock(item.text));\n   164\t    } else if (item.type === 'thinking' && typeof item.thinking === 'string') {\n   165\t      blocks.push(thinkingBlock(item.thinking));\n   166\t    } else if (item.type === 'tool-call' && typeof item.id === 'string' && typeof item.name === 'string') {\n   167\t      blocks.push(toolCallBlock({\n   168\t        id: item.id,\n   169\t        name: item.name,\n   170\t        arguments: parseJsonObject(item.arguments) ?? item.arguments,\n   171\t      }));\n   172\t    }\n   173\t  }\n   174\t  return blocks;\n   175\t}\n   176\t\n   177\tfunction recordsFromEvents(events) {\n   178\t  const records = [];\n   179\t  const seenIds = new Set();\n   180\t  const keepFirst = (record) => {\n   181\t    // A compaction prune re-emits a shortened tool result under the same\n   182\t    // message id. The first copy holds the full output, which is what a\n   183\t    // lookup after compaction is for, so a repeated id is dropped.\n   184\t    if (seenIds.has(record.id)) return;\n   185\t    seenIds.add(record.id);\n   186\t    records.push(record);\n   187\t  };\n   188\t\n   189\t  events.forEach((event, index) => {\n   190\t    const data = event?.data;\n   191\t    if (!data || typeof data !== 'object') return;\n   192\t    // DSH stamps each event with `time` in epoch milliseconds.\n   193\t    const timestamp = event.time ?? event.timestamp ?? data.timestamp;\n   194\t\n   195\t    if (event.type === 'user/message' && data.source?.kind === OPERATOR_SOURCE) {\n   196\t      // Injected notices carry a non-operator source kind, so this text is\n   197\t      // operator content even when it opens with '<'.\n   198\t      const text = contentText(data.content);\n   199\t      if (!text) return;\n   200\t      keepFirst({\n   201\t        id: String(data.id ?? `dsh-user-${index}`).slice(0, 128),\n   202\t        role: 'user',\n   203\t        timestamp,\n   204\t        content: [textBlock(text)],\n   205\t      });\n   206\t      return;\n   207\t    }\n   208\t\n   209\t    if (event.type === 'assistant/message') {\n   210\t      const message = data.message;\n   211\t      const blocks = assistantBlocks(message?.content);\n   212\t      if (blocks.length === 0) return;\n   213\t      keepFirst({\n   214\t        id: String(message?.id ?? data.id ?? `dsh-assistant-${index}`).slice(0, 128),\n   215\t        role: 'assistant',\n   216\t        timestamp,\n   217\t        content: blocks,\n   218\t      });\n   219\t      return;\n   220\t    }\n   221\t\n   222\t    if (event.type === 'tool/result') {\n   223\t      const message = data.message;\n   224\t      if (typeof message?.toolCallId !== 'string' || !message.toolCallId) return;\n   225\t      const text = contentText(message.content);\n   226\t      const record = {\n   227\t        id: String(message.id ?? `dsh-result-${index}`).slice(0, 128),\n   228\t        role: 'toolResult',\n   229\t        timestamp,\n   230\t        content: [textBlock(text)],\n   231\t        toolCallId: message.toolCallId,\n   232\t      };\n   233\t      if (message.isError === true) record.isError = true;\n   234\t      keepFirst(record);\n   235\t    }\n   236\t  });\n   237\t\n   238\t  return records;\n   239\t}\n   240\t\n   241\t// A hook notice arrives as a user-role message whose source is not the operator.\n   242\t// It never becomes a record, because the operator did not write it, and the text\n   243\t// is kept here so a caller can still tell what the harness put into the turn.\n   244\tfunction injectedFromEvents(events) {\n   245\t  const injected = [];\n   246\t  for (const event of events) {\n   247\t    if (event?.type !== 'user/message') continue;\n   248\t    const data = event.data;\n   249\t    if (!data || typeof data !== 'object') continue;\n   250\t    if (data.source?.kind === OPERATOR_SOURCE) continue;\n   251\t    const text = contentText(data.content);\n   252\t    if (!text) continue;\n   253\t    injected.push({ source: data.source?.kind ?? 'unknown', text });\n   254\t  }\n   255\t  return injected;\n   256\t}\n   257\t\n   258\t// ─────────────────────────────────────────────────────────────────────────────\n   259\t// 6. LOADER\n   260\t// ─────────────────────────────────────────────────────────────────────────────\n   261\t\n   262\texport function loadDshSession({ sessionId, projectDir, sessionPath, ...options } = {}) {\n   263\t  if (!isSafeSessionId(sessionId)) {\n   264\t    return { ok: false, code: sessionId ? 'session_mismatch' : 'locator_unavailable' };\n   265\t  }\n   266\t  if (typeof projectDir !== 'string' || !projectDir.trim()) {\n   267\t    return { ok: false, code: 'locator_unavailable' };\n   268\t  }\n   269\t\n   270\t  const root = dshStoreRoot(options);\n   271\t  let logPath = sessionPath;\n   272\t\n   273\t  if (!logPath) {\n   274\t    const projectRoot = join(root, dshProjectKey(projectDir));\n   275\t    try {\n   276\t      statSync(root);\n   277\t    } catch {\n   278\t      return { ok: false, code: 'store_unreadable' };\n   279\t    }\n   280\t    try {\n   281\t      statSync(projectRoot);\n   282\t    } catch {\n   283\t      return { ok: false, code: 'session_not_found' };\n   284\t    }\n   285\t\n   286\t    // The session directory is named by the exact id, so a newer decoy session\n   287\t    // is never opened while the requested one is missing.\n   288\t    const sessionDirectory = join(projectRoot, sessionId);\n   289\t    try {\n   290\t      statSync(sessionDirectory);\n   291\t    } catch {\n   292\t      return { ok: false, code: 'session_not_found' };\n   293\t    }\n   294\t    try {\n   295\t      logPath = sessionLogIn(sessionDirectory);\n   296\t    } catch {\n   297\t      return { ok: false, code: 'store_unreadable' };\n   298\t    }\n   299\t    if (!logPath) return { ok: false, code: 'session_not_found' };\n   300\t  }\n   301\t\n   302\t  // Containment is decided before the file is opened, so a path outside the\n   303\t  // store is refused without its content ever being read.\n   304\t  const containment = resolveInside({ path: logPath, root });\n   305\t  if (!containment.ok) return containment;\n   306\t  const storePath = containment.path;\n   307\t\n   308\t  let events;\n   309\t  try {\n   310\t    events = parseEvents(decodeSessionLog(readFileSync(logPath), logPath));\n   311\t  } catch {\n   312\t    return { ok: false, code: 'store_unreadable' };\n   313\t  }\n   314\t\n   315\t  const header = events[0]?.type === 'session' ? events[0] : null;\n   316\t  if (typeof header?.id !== 'string' || !header.id) {\n   317\t    return { ok: false, code: 'store_unreadable' };\n   318\t  }\n   319\t  if (header.id !== sessionId) return { ok: false, code: 'session_mismatch' };\n   320\t  if (!samePath(header.cwd, projectDir)) return { ok: false, code: 'session_mismatch' };\n   321\t\n   322\t  return {\n   323\t    ok: true,\n   324\t    source: {\n   325\t      runtime: RUNTIME,\n   326\t      sessionId,\n   327\t      locatorKind: LOCATOR_KIND,\n   328\t      storePath,\n   329\t    },\n   330\t    records: recordsFromEvents(events),\n   331\t    injected: injectedFromEvents(events),\n   332\t  };\n   333\t}\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"cd /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research && ls -la .skilled/hooks/shared/session-readers/ && echo \\\"=== devin/dsh ===\\\" && for f in .skilled/hooks/shared/session-readers/devin.mjs .skilled/hooks/shared/session-readers/dsh.mjs; do echo \\\"---FILE $f\\\"; cat -n \\\"$f\\\"; done\"}"},"time":{"start":1794550456481,"end":1794550457183}}}}
