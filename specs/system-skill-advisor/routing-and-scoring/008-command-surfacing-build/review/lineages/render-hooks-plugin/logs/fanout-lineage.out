{"type":"step_start","timestamp":1794550528391,"sessionID":"ses_e2c799690ffeJQrMJ5OzboPGaV","part":{"id":"prt_1d38bf987001o8kYUhVMRHEtIR","sessionID":"ses_e2c799690ffeJQrMJ5OzboPGaV","messageID":"msg_1d38bed42001tdpQSjBeBdSBVT","type":"step-start","snapshot":"8b7c316892ce0858e679387b9f8266f043946d1c"}}
{"type":"tool_use","timestamp":1794550528517,"sessionID":"ses_e2c799690ffeJQrMJ5OzboPGaV","part":{"partID":"prt_1d38bf98c0024oXvBzEUsbjKp8","sessionID":"ses_e2c799690ffeJQrMJ5OzboPGaV","messageID":"msg_1d38bed42001tdpQSjBeBdSBVT","type":"tool","id":"call_9ecdceb85ae6499297b7225f","tool":"shell","state":{"status":"completed","input":{"command":"cd /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research && sed -n '120,229p' .skilled/hooks/shared/tests/session-readers/injected-text.test.mjs"},"output":"  await withTempAsync('pi-load-session-injected', async (root) => {\n    const projectDir = join(root, 'project');\n    mkdirSync(projectDir, { recursive: true });\n    const fixture = piSession({ root, projectDir });\n    appendJsonLines(fixture.filePath, [\n      {\n        type: 'custom_message',\n        customType: 'session-start-context',\n        id: 'pi-context',\n        timestamp: NOW,\n        content: BRIEF,\n      },\n    ]);\n\n    const loaded = await loadSession({ runtime: 'pi', sessionId: SESSION, ...fixture.options });\n    assert.equal(loaded.ok, true);\n    assert.deepEqual(loaded.injected, [{ source: 'session-start-context', text: BRIEF }]);\n\n    const projected = await readSession({ runtime: 'pi', sessionId: SESSION, ...fixture.options });\n    assert.equal(projected.ok, true);\n    assert.equal(projected.items.some((item) => item.id === 'pi-context'), false);\n  });\n});\n\ntest('Devin keeps an operator step that opens with a tag and ignores system steps in a transcript-only store', async () => {\n  await withTempAsync('devin-injected-text', async (root) => {\n    const projectDir = join(root, 'project');\n    mkdirSync(projectDir, { recursive: true });\n    const fixture = devinSession({ root, projectDir, withSessionsRow: false });\n    const transcript = JSON.parse(readFileSync(fixture.filePath, 'utf8'));\n    transcript.steps.push(\n      { step_id: 90, timestamp: NOW, source: 'system', message: '<system>injected</system>' },\n      { step_id: 91, timestamp: NOW, source: 'user', message: '<div>hello</div>' },\n    );\n    writeJson(fixture.filePath, transcript);\n\n    const result = await readSession({ runtime: 'devin', sessionId: SESSION, ...fixture.options });\n    assert.equal(result.ok, true);\n    assert.equal(result.items.some((item) => item.id === 'devin-90'), false);\n    assert.equal(result.items.find((item) => item.id === 'devin-91')?.content[0].text, '<div>hello</div>');\n  });\n});\n\ntest('DSH keeps an operator message that opens with a tag and ignores injected source kinds', async () => {\n  await withTempAsync('dsh-injected-text', async (root) => {\n    const projectDir = join(root, 'project');\n    mkdirSync(projectDir, { recursive: true });\n    const fixture = dshSession({ root, projectDir });\n    appendJsonLines(fixture.filePath, [\n      {\n        type: 'user/message',\n        seq: 5,\n        data: {\n          role: 'user',\n          id: 'dsh-injected',\n          source: { kind: 'repo-guards' },\n          content: [{ type: 'text', text: '<system>injected</system>' }],\n        },\n      },\n      {\n        type: 'user/message',\n        seq: 6,\n        data: {\n          role: 'user',\n          id: 'dsh-div',\n          source: { kind: 'user' },\n          content: [{ type: 'text', text: '<div>hello</div>' }],\n        },\n      },\n    ]);\n\n    const result = await readSession({ runtime: 'dsh', sessionId: SESSION, ...fixture.options });\n    assert.equal(result.ok, true);\n    assert.equal(result.items.some((item) => item.id === 'dsh-injected'), false);\n    assert.equal(result.items.find((item) => item.id === 'dsh-div')?.content[0].text, '<div>hello</div>');\n  });\n});\n\ntest('OpenCode keeps an operator row that opens with a tag and ignores synthetic rows', async () => {\n  await withTempAsync('opencode-injected-text', async (root) => {\n    const fixture = opencodeSession({ root });\n    const database = new DatabaseSync(fixture.dbPath);\n    try {\n      const insert = database.prepare(\n        'INSERT INTO session_message (id, session_id, type, seq, data) VALUES (?, ?, ?, ?, ?)',\n      );\n      insert.run(\n        'oc-synthetic',\n        SESSION,\n        'synthetic',\n        3,\n        JSON.stringify({ text: '<system>injected</system>', time: { created: T0 + 3000 } }),\n      );\n      insert.run(\n        'oc-div',\n        SESSION,\n        'user',\n        4,\n        JSON.stringify({ text: '<div>hello</div>', time: { created: T0 + 4000 } }),\n      );\n    } finally {\n      database.close();\n    }\n\n    const result = await readSession({ runtime: 'opencode', sessionId: SESSION, ...fixture.options });\n    assert.equal(result.ok, true);\n    assert.equal(result.items.some((item) => item.id === 'oc-synthetic'), false);\n    assert.equal(result.items.find((item) => item.id === 'oc-div')?.content[0].text, '<div>hello</div>');\n  });\n});\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"  await withTempAsync('pi-load-session-injected', async (root) => {\n    const projectDir = join(root, 'project');\n    mkdirSync(projectDir, { recursive: true });\n    const fixture = piSession({ root, projectDir });\n    appendJsonLines(fixture.filePath, [\n      {\n        type: 'custom_message',\n        customType: 'session-start-context',\n        id: 'pi-context',\n        timestamp: NOW,\n        content: BRIEF,\n      },\n    ]);\n\n    const loaded = await loadSession({ runtime: 'pi', sessionId: SESSION, ...fixture.options });\n    assert.equal(loaded.ok, true);\n    assert.deepEqual(loaded.injected, [{ source: 'session-start-context', text: BRIEF }]);\n\n    const projected = await readSession({ runtime: 'pi', sessionId: SESSION, ...fixture.options });\n    assert.equal(projected.ok, true);\n    assert.equal(projected.items.some((item) => item.id === 'pi-context'), false);\n  });\n});\n\ntest('Devin keeps an operator step that opens with a tag and ignores system steps in a transcript-only store', async () => {\n  await withTempAsync('devin-injected-text', async (root) => {\n    const projectDir = join(root, 'project');\n    mkdirSync(projectDir, { recursive: true });\n    const fixture = devinSession({ root, projectDir, withSessionsRow: false });\n    const transcript = JSON.parse(readFileSync(fixture.filePath, 'utf8'));\n    transcript.steps.push(\n      { step_id: 90, timestamp: NOW, source: 'system', message: '<system>injected</system>' },\n      { step_id: 91, timestamp: NOW, source: 'user', message: '<div>hello</div>' },\n    );\n    writeJson(fixture.filePath, transcript);\n\n    const result = await readSession({ runtime: 'devin', sessionId: SESSION, ...fixture.options });\n    assert.equal(result.ok, true);\n    assert.equal(result.items.some((item) => item.id === 'devin-90'), false);\n    assert.equal(result.items.find((item) => item.id === 'devin-91')?.content[0].text, '<div>hello</div>');\n  });\n});\n\ntest('DSH keeps an operator message that opens with a tag and ignores injected source kinds', async () => {\n  await withTempAsync('dsh-injected-text', async (root) => {\n    const projectDir = join(root, 'project');\n    mkdirSync(projectDir, { recursive: true });\n    const fixture = dshSession({ root, projectDir });\n    appendJsonLines(fixture.filePath, [\n      {\n        type: 'user/message',\n        seq: 5,\n        data: {\n          role: 'user',\n          id: 'dsh-injected',\n          source: { kind: 'repo-guards' },\n          content: [{ type: 'text', text: '<system>injected</system>' }],\n        },\n      },\n      {\n        type: 'user/message',\n        seq: 6,\n        data: {\n          role: 'user',\n          id: 'dsh-div',\n          source: { kind: 'user' },\n          content: [{ type: 'text', text: '<div>hello</div>' }],\n        },\n      },\n    ]);\n\n    const result = await readSession({ runtime: 'dsh', sessionId: SESSION, ...fixture.options });\n    assert.equal(result.ok, true);\n    assert.equal(result.items.some((item) => item.id === 'dsh-injected'), false);\n    assert.equal(result.items.find((item) => item.id === 'dsh-div')?.content[0].text, '<div>hello</div>');\n  });\n});\n\ntest('OpenCode keeps an operator row that opens with a tag and ignores synthetic rows', async () => {\n  await withTempAsync('opencode-injected-text', async (root) => {\n    const fixture = opencodeSession({ root });\n    const database = new DatabaseSync(fixture.dbPath);\n    try {\n      const insert = database.prepare(\n        'INSERT INTO session_message (id, session_id, type, seq, data) VALUES (?, ?, ?, ?, ?)',\n      );\n      insert.run(\n        'oc-synthetic',\n        SESSION,\n        'synthetic',\n        3,\n        JSON.stringify({ text: '<system>injected</system>', time: { created: T0 + 3000 } }),\n      );\n      insert.run(\n        'oc-div',\n        SESSION,\n        'user',\n        4,\n        JSON.stringify({ text: '<div>hello</div>', time: { created: T0 + 4000 } }),\n      );\n    } finally {\n      database.close();\n    }\n\n    const result = await readSession({ runtime: 'opencode', sessionId: SESSION, ...fixture.options });\n    assert.equal(result.ok, true);\n    assert.equal(result.items.some((item) => item.id === 'oc-synthetic'), false);\n    assert.equal(result.items.find((item) => item.id === 'oc-div')?.content[0].text, '<div>hello</div>');\n  });\n});\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"cd /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research && sed -n '120,229p' .skilled/hooks/shared/tests/session-readers/injected-text.test.mjs\"}"},"time":{"start":1794550528396,"end":1794550528517}}}}
{"type":"step_finish","timestamp":1794550530868,"sessionID":"ses_e2c799690ffeJQrMJ5OzboPGaV","part":{"id":"prt_1d38c0334001hBdWCplAgFdPeF","sessionID":"ses_e2c799690ffeJQrMJ5OzboPGaV","messageID":"msg_1d38bed42001tdpQSjBeBdSBVT","type":"step-finish","reason":"tool-calls","snapshot":"8b7c316892ce0858e679387b9f8266f043946d1c","cost":0,"tokens":{"input":2921,"output":88,"reasoning":99,"cache":{"read":120320,"write":0}}}}
{"type":"step_start","timestamp":1794550535245,"sessionID":"ses_e2c799690ffeJQrMJ5OzboPGaV","part":{"id":"prt_1d38c144d001jPp7Yi3eQDJFCW","sessionID":"ses_e2c799690ffeJQrMJ5OzboPGaV","messageID":"msg_1d38c0343001uMrDKgAA9lZblc","type":"step-start","snapshot":"41cac6f83048713c58ca05239a7dde2c57ebcf80"}}
{"type":"tool_use","timestamp":1794550558590,"sessionID":"ses_e2c799690ffeJQrMJ5OzboPGaV","part":{"partID":"prt_1d38c69e800167u6fKvHLHfw7t","sessionID":"ses_e2c799690ffeJQrMJ5OzboPGaV","messageID":"msg_1d38c0343001uMrDKgAA9lZblc","type":"tool","id":"call_d578772c2ce34408a17ae9ff","tool":"shell","state":{"status":"completed","input":{"command":"cd /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research && for p in .opencode/plugins/lib/tool-identity.js .opencode/plugins/lib/v2-bridge.js .opencode/plugins/lib/opencode-message-identity.js .opencode/plugins/lib/skill-advisor-render.js .opencode/hooks/shared/hook-flags.cjs .opencode/skills/system-spec-kit/runtime/hooks/lib/workspace/repo-root.mjs; do if [ -e \"$p\" ]; then echo \"OK   $p\"; else echo \"MISS $p\"; fi; done; echo \"=== README ===\"; cat -n .opencode/plugins/README.md"},"output":"OK   .opencode/plugins/lib/tool-identity.js\nOK   .opencode/plugins/lib/v2-bridge.js\nOK   .opencode/plugins/lib/opencode-message-identity.js\nOK   .opencode/plugins/lib/skill-advisor-render.js\nOK   .opencode/hooks/shared/hook-flags.cjs\nOK   .opencode/skills/system-spec-kit/runtime/hooks/lib/workspace/repo-root.mjs\n=== README ===\n     1\t---\n     2\ttitle: \"OpenCode Plugin Entrypoints\"\n     3\tdescription: \"JavaScript plugin entrypoints for context injection, lifecycle handling, policy guards, runtime tools and post-action checks. OpenCode discovers these via a flat glob over .opencode/plugins/, and each module default-exports the object `{ id, setup, server }`.\"\n     4\ttrigger_phrases:\n     5\t  - \"OpenCode plugins\"\n     6\t  - \"plugin entrypoints\"\n     7\t  - \"OpenCode hook events\"\n     8\t---\n     9\t\n    10\t# OpenCode Plugin Entrypoints\n    11\t\n    12\t> JavaScript plugin entrypoints for context injection, lifecycle handling, policy guards, runtime tools and post-action checks.\n    13\t\n    14\t---\n    15\t\n    16\t## 1. OVERVIEW\n    17\t\n    18\t`.opencode/plugins/` contains the JavaScript modules OpenCode discovers as local plugins. Each module default-exports one plain object `{ id, setup, server }`: `setup` is the OpenCode 2 (recommended) entry and `server` the OpenCode 1 (fallback) entry. Source plugins build that object with `dualPlugin(id, server)` from `lib/v2-bridge.js`, so the v1 factory stays the single implementation and the bridge derives the v2 leg from it. OpenCode loads plugins by a flat glob over this folder (it does not recurse), so every loadable plugin lives directly here. The `lib/` and `tests/` subfolders are not plugin sources.\n    19\t\n    20\tEvery plugin here runs on both OpenCode majors. OpenCode 2 calls `setup(ctx)` and OpenCode 1 calls `server(input)`, and neither host calls the other's entry, so a plugin that exported only one entry would do nothing on the other host. On 2026-10-19 the 17 plugin files then present were verified on OpenCode 2.0.32 and OpenCode 1.19.3: the doctor battery reported all 17 active on 2.0.32 and discovered all 17 on 1.19.3. On 2026-10-20 a live run of every plugin showed each one's effect on both versions. One of those plugins has since been removed, and `decision-capture.js` was added later through the same bridge without a rerun of that battery. `session-history-lookup.js` was added the same way, and so was `env-secret-guard.js`, which has no live battery run yet; on 2026-11-08 a live OpenCode 2.2.5 session showed its section and redeemed the printed command, and a live OpenCode 1.19.4 session did the same. `overlay-guard.js` was added the same way and has no live battery run yet. [ARCHITECTURE.md](./ARCHITECTURE.md) explains the dual export, the bridge and what has no OpenCode 2 equivalent.\n    21\t\n    22\t<!-- readme-check\n    23\tallow-count 17 plugin files | a dated count of the files present at the 2026-10-19 battery, not the current folder\n    24\tallow-count 17 plugins | a dated count of the files present at the 2026-10-19 battery, not the current folder\n    25\t-->\n    26\t\n    27\tThe directory inventory is authoritative for the auto-loaded plugin surface. Shared policy cores stay under their owning skill (`system-spec-kit`, `system-skill-advisor`, `sk-git`, `sk-code`, `system-completion`, `system-deep-loop`). Most files here are **transport adapters** that translate OpenCode events into those cores and keep terminal output out of the TUI. `opencode-goal.js` is the exception: it implements the goal state machine and goal tools itself and shares only selected helpers. The single shared boundary every plugin honors in normal operation: **never write to stdout or stderr**, because OpenCode overlays those onto the TUI prompt line and corrupts the interactive session. Findings are injected via `experimental.chat.system.transform`, returned from tool handlers or persisted to bounded workspace logs.\n    28\t\n    29\tMost plugins honor a per-concern kill switch through the shared `hook-flags.cjs` resolver (`isHookEnabled('<concern>')`), plus the master `SYSTEM_HOOKS_DISABLED`. A disabled plugin stops its main work.\n    30\t\n    31\tMost become full no-ops, while the goal tools and the advisor status tool stay registered and report that they are disabled. All advisory checks fail open.\n    32\t\n    33\tFour plugins reject by default by throwing from `tool.execute.before`: `sk-git-message-gate.js`, the dispatch guard in `cli-dispatch-audit.js`, `env-secret-guard.js`, which refuses a read or write of a dotenv file, and `overlay-guard.js`, which refuses a write to a file a vendored tree's overlay owns. Other rejection is opt-in: `SYSTEM_SPEC_GATE_ENFORCE` for spec-gate deny, and `SYSTEM_DEEP_LOOP_GUARD_REJECT=1` or `SYSTEM_DEEP_LOOP_GUARD_REJECT_LOOP=1` for the deep-loop guard, which otherwise only warns.\n    34\t\n    35\tOne plugin is an exception. `sk-git-message-gate.js` has no switch, because the commit, PR and branch rules carry no bypass on any surface.\n    36\t\n    37\t---\n    38\t\n    39\t## 2. WHAT'S HERE / INVENTORY\n    40\t\n    41\t| File | Concern | Hook surface | Responsibility |\n    42\t|---|---|---|---|\n    43\t| `ask-surface-guard.js` | `ask-surface` | `event` (`session.idle`) | When a turn ends in a typed option menu and called no `question` tool, sends the turn back once through `session.promptAsync` with an instruction to ask through `question`. Writes nothing to stdout or stderr, fails open, and stays off under `SYSTEM_ASK_SURFACE_DISABLED=1`. |\n    44\t| `classifier-injection-screen.js` | `injection-screen` | `tool.execute.after` for `webfetch`, `experimental.chat.system.transform` | Screens fetched `webfetch` text for instructions aimed at the agent. Buffers up to 20 advisories per session and drains them on the next transform, the model call that reads the fetch result. Never writes stdout/stderr. |\n    45\t| `cli-dispatch-audit.js` | `dispatch`, `dispatch-guard` | `tool.execute.before` and `tool.execute.after` for Bash | `tool.execute.before` blocks a CLI dispatch that breaks a hard rule declared in the target skill's `SKILL.md` by throwing, and fails open on its own errors. `tool.execute.after` records redacted dispatch telemetry after completed CLI calls, recognizes an `opencode` or `opencode2` invocation and appends a bounded audit record. |\n    46\t| `codex-hooks-watchdog.js` | `codex-watchdog` | `event` (`session.created`) | Watches Codex hook installation and reports drift. Never affects the guarded session. |\n    47\t| `decision-capture.js` | `decision-capture` | `tool.execute.after` for `question`, `experimental.chat.system.transform` | Queues each answered `question` call for the next full-auto save under the same key as the save-time sweep, and pushes one system line when the count of answers still waiting for a decision record rises. Fails open and never changes the tool output. |\n    48\t| `env-secret-guard.js` | `env-secret-guard` | `tool.execute.before`, `tool` (`env_secret_list_keys`, `env_secret_validate`, `env_secret_fingerprint`) | Refuses a file tool or shell command that would read or write a dotenv file by throwing, through the shared core in `../hooks/env-secret-guard/`. Its three tools list keys, check syntax and fingerprint one value without returning any value. Fails open on its own errors. |\n    49\t| `mcp-route-guard.js` | `mcp-route-guard` | `tool.execute.before` | Advises when native MCP calls should use Code Mode. Persists to a bounded, rotated workspace log. |\n    50\t| `overlay-guard.js` | `overlay-guard` | `tool.execute.before` for write tools | Refuses a write tool that names a file a vendored tree's overlay owns, by throwing, through the shared core in `../hooks/overlay-guard/`. The reason names the overlay file to edit instead. A write it cannot judge is allowed, and its notes go to a bounded, rotated log because OpenCode paints stdout and stderr onto the prompt line. |\n    51\t| `opencode-goal.js` | `goal` | `event` (`session.created`/`status`/`idle`/`deleted`, `message.updated`/`message.part.updated`, `permission.asked`/`replied`, `question.asked`/`replied`/`rejected`), `experimental.chat.system.transform`, `tool` (goal tools) | Holds a text goal or binds a session to a packet `goal.md` and injects the objective slice built from it (via `../hooks/goal/lib/goal-slice.cjs`). Largest plugin in this folder. Owns the goal state machine, supervisor, continuation, capabilities and the goal tool surface including `bind`, `resent` and `packet`. |\n    52\t| `session-cleanup.js` | `session-cleanup` | `event` (`session.created`/`deleted`), `experimental.chat.system.transform`, `dispose` | Performs bounded session and host cleanup. Startup guards and teardown cleanup. Reaps MCP helper processes via `session-cleanup.sh`. |\n    53\t| `session-history-lookup.js` | `session-lifecycle` | `event` (`session.compacted`), `experimental.chat.system.transform` | On `session.compacted`, saves a history locator keyed by the checkout root above the session folder, then pushes the shared `## History Lookup` section into each request's system array while the locator is under 30 minutes old. Fails open: no build, no checkout or a failed save means no section. |\n    54\t| `session-relaunch.js` | `session-relaunch` | `event` (`message.updated`/`message.part.updated`/`session.idle`), `experimental.chat.system.transform` | Tracks usage and seed text. Inside `skilled-loop`, while this session has no matching relaunch record, it pushes the active nudge on every request. Outside the loop the nudge asks for a note and `keep` instead of `prepare`, because only the wrapper can relaunch the session. While a matching seed's note is open, it injects the seed on each request, then a claimed reminder once the note is claimed. It arms the record on `session.idle`. The plugin runs the detached killer with `node` because OpenCode hosts plugins on Bun. |\n    55\t| `sk-code-post-edit-quality.js` | `post-edit-quality` | `tool.execute.before`, `tool.execute.after`, `experimental.chat.system.transform` | Runs bounded post-edit quality checks. `tool.execute.before` stashes the edited path keyed by callID, because the after hook has no file path. `tool.execute.after` runs the router core. Findings drain on the next transform and are recorded to a workspace log. |\n    56\t| `sk-git-message-gate.js` | `git-message-gate` (no kill switch) | `tool.execute.before` for `bash` | Refuses a `git commit` message, `gh pr` description or new branch name that breaks the repository's own sk-git templates by throwing. Allows what the shared gate cannot parse, but refuses when the repository's rules exist and cannot be read. It has no kill switch, because the commit and push rules carry no bypass on any surface. |\n    57\t| `sk-git-preflight-advisory.js` | `git-preflight` | `tool.execute.before` for `bash`, `experimental.chat.system.transform` | Advises on Git command scope before execution. Buffers at most 20 advisory events and drains them on the next transform. Never prints. |\n    58\t| `system-completion-sentinel.js` | `completion` | `event` (`session.created`/`idle`) | Checks completion evidence at session lifecycle points. On `session.idle`, resolves completion state via `ctx.client.session.messages()` (guarded, fail-open). Throttled-sweeps the shared state dir on `session.created`. |\n    59\t| `system-deep-loop-guard.js` | `task-dispatch` | `event` (`session.created`), `tool.execute.before` | Checks deep-loop Task dispatches and repeat handoffs. Sweeps stale loop-guard state on `session.created`. |\n    60\t| `system-dist-freshness-guard.js` | `dist-freshness` | `tool.execute.before`, `event` (`session.created`/`deleted`), `experimental.chat.system.transform` | Reports stale compiled outputs and invalidates diagnostics. Short-circuits the whole plugin at factory entry when disabled. |\n    61\t| `system-skill-advisor.js` | `skill-advisor` | `experimental.chat.system.transform`, `event`, `tool` (`spec_kit_skill_advisor_status`) | Injects skill-routing guidance per prompt and exposes advisor status. Spawns the advisor subprocess only on a cache miss, behind a TTL+LRU prompt cache with in-flight dedup. |\n    62\t| `system-spec-gate.js` | `spec-gate` | `experimental.chat.system.transform`, `tool.execute.before`, `event` | Classifies and evaluates mutation-gate state. Classify best-effort fetches the last user message via `ctx.client`. Enforce throws `system-spec-gate:` on deny (OpenCode's deny signal). |\n    63\t| `system-speckit-completion.js` | `completion` | `tool` (read-only completion evidence) | Exposes read-only completion evidence. Checks the `completion` concern at factory entry. |\n    64\t\n    65\t---\n    66\t\n    67\t## 3. SHARED LIB MODULES\n    68\t\n    69\t`lib/` holds the modules the entry files import. None of them is a plugin source, and the loader never registers one on its own.\n    70\t\n    71\t| File | Responsibility |\n    72\t|---|---|\n    73\t| `lib/v2-bridge.js` | Builds the dual export. `dualPlugin(id, server)` returns `{ id, setup, server }`: `setup` maps its hooks (event stream, `tool.execute.before`/`after`, `experimental.chat.system.transform`, tool definitions) onto OpenCode 2 registrations and returns a cleanup function, while `server` stays the unchanged OpenCode 1 factory. It reports v2 `shell` and `subagent` calls under their v1 names, announces each session once with `session.created`, and fills the message events v1 plugins read. Hook keys the bridge does not map are reported through `cleanup.skippedKeys`. |\n    74\t| `lib/tool-identity.js` | Identity helper for tool definitions. `tool(definition)` returns the definition unchanged, and `tool.schema` is zod, so one definition serves the v1 `tool` hook and the bridge's v2 tool registration. |\n    75\t| `lib/opencode-message-identity.js` | Stable transform identity and dedup state. `system-skill-advisor.js` uses it when `deduplicateTransforms` is on. |\n    76\t| `lib/skill-advisor-render.js` | Advisor fallback and compiled-route renderers, shared by the advisor plugin and its tests. |\n    77\t| `lib/classifier-injection-screen-core.js` | Constants and the session-id resolver for the injection-screen plugin. |\n    78\t| `lib/completion-sentinel-core.js` | Re-export of the completion-evidence sentinel core under `skills/system-spec-kit`. |\n    79\t| `lib/opencode-goal-core.js` | WeakMap registry that binds a goal plugin module's helpers to its server, so both entries read the same state. |\n    80\t| `lib/sk-code-post-edit-quality-core.js` | Constants, the callID-to-filePath correlation map and the finding formatter for the post-edit-quality plugin. |\n    81\t\n    82\tThe bridge mapping is exercised against stub contexts in the test suites. On 2026-10-19 the doctor battery confirmed that all 17 plugins load on 1.19.3 and show active on 2.0.32. On 2026-10-20 a probe plugin on a private OpenCode 2.0.32 host received `session.created` and `session.deleted` under those names for sessions created and removed through the server API, and received `location.shutdown` instead of `server.instance.disposed` or `global.disposed`. The probe did not start a session with `opencode run`, and v2 can deliver session traffic before `session.created`, so the bridge synthesizes a `session.created` the first time it sees traffic for a session and drops a later duplicate (`specs/cli-external-orchestration/opencode-platform/002-opencode-v1-v2-dual-compat/024-plugin-inventory-guards/scratch/v2-events/README.txt`). `tests/plugin-inventory.json` lists every event name a bridged plugin handles that the bridge neither maps nor aliases, grouped as observed, not delivered or unverified. The `plugin-utilization` playbook in `cli-opencode` checks each plugin's effect in a live session; on 2026-10-20 all 17 acted on OpenCode 1.19.3 and 2.0.32.\n    83\t\n    84\t---\n    85\t\n    86\t## 4. TEST SUITES\n    87\t\n    88\t`tests/` holds the regression suites for the entry files. They run on the Node built-in test runner with hermetic stubs. The v2 suites are:\n    89\t\n    90\t| File | Covers |\n    91\t|---|---|\n    92\t| `tests/v2-bridge.test.cjs` | The bridge itself: event aliases and mappings, the v1 client adapters, hook registration and cleanup, tool result conversion and the `tool` identity contract. |\n    93\t| `tests/v2-hard-plugins.test.cjs` | Selected hard cases, not the plugin list: expected v2 registrations for `system-completion-sentinel`, `system-spec-gate`, `system-skill-advisor` and `opencode-goal` through a stub v2 context, plus behavior cases for the first four. It also requires a case for every native-dual exception in the inventory. |\n    94\t| `tests/v2-registration.test.cjs` | The dual export shape, at least one v2 registration and the cleanup function for every bridged plugin the inventory finds. |\n    95\t| `tests/plugin-inventory.test.cjs` | The inventory itself: every `.js` file is bridged or a listed native-dual exception, every bridged plugin maps all its hooks, and every event name a bridged plugin compares against is mapped, aliased or listed in `tests/plugin-inventory.json`. The event names come from parsing each plugin's `type` comparisons, `switch` statements on the event type and literal collections; any other kind of event check, such as `eventType.endsWith('.disposed')`, must be listed under `unscannedEventChecks` with a reason. |\n    96\t\n    97\tThe plugin list comes from the folder, not from a hand-written list. `tests/helpers/plugin-inventory.cjs` treats a file as bridged when its source contains `dualPlugin('<file stem>'`, and `tests/v2-registration.test.cjs` then checks that its default export has the dual shape, and `tests/plugin-inventory.json` names the exceptions, with an empty `nativeDual` list. A new plugin file that is neither bridged nor listed fails `tests/plugin-inventory.test.cjs`.\n    98\t\n    99\tThe remaining `*.test.cjs` files cover v1 behavior and adjacent contracts. `tests/README.md` indexes every suite, and `tests/helpers/` holds the shared fixtures.\n   100\t\n   101\t---\n   102\t\n   103\t## 5. DIRECTORY TREE\n   104\t\n   105\t```text\n   106\tplugins/\n   107\t+-- README.md                              # this index\n   108\t+-- ARCHITECTURE.md                        # dual-version design, bridge and limits\n   109\t+-- ask-surface-guard.js\n   110\t+-- classifier-injection-screen.js\n   111\t+-- cli-dispatch-audit.js\n   112\t+-- codex-hooks-watchdog.js\n   113\t+-- decision-capture.js\n   114\t+-- env-secret-guard.js\n   115\t+-- mcp-route-guard.js\n   116\t+-- overlay-guard.js\n   117\t+-- opencode-goal.js\n   118\t+-- session-cleanup.js\n   119\t+-- session-history-lookup.js\n   120\t+-- session-relaunch.js\n   121\t+-- sk-code-post-edit-quality.js\n   122\t+-- sk-git-message-gate.js\n   123\t+-- sk-git-preflight-advisory.js\n   124\t+-- system-completion-sentinel.js\n   125\t+-- system-deep-loop-guard.js\n   126\t+-- system-dist-freshness-guard.js\n   127\t+-- system-skill-advisor.js\n   128\t+-- system-spec-gate.js\n   129\t+-- system-speckit-completion.js\n   130\t+-- lib/\n   131\t|   +-- classifier-injection-screen-core.js\n   132\t|   +-- completion-sentinel-core.js\n   133\t|   +-- opencode-goal-core.js\n   134\t|   +-- opencode-message-identity.js\n   135\t|   +-- sk-code-post-edit-quality-core.js\n   136\t|   +-- skill-advisor-render.js\n   137\t|   +-- tool-identity.js\n   138\t|   `-- v2-bridge.js\n   139\t`-- tests/\n   140\t    +-- README.md\n   141\t    +-- helpers/\n   142\t    +-- plugin-inventory.test.cjs\n   143\t    +-- plugin-inventory.json\n   144\t    +-- v2-bridge.test.cjs\n   145\t    +-- v2-hard-plugins.test.cjs\n   146\t    +-- v2-registration.test.cjs\n   147\t    `-- *.test.cjs                         # the remaining plugin suites\n   148\t```\n   149\t\n   150\t---\n   151\t\n   152\t## 6. KEY FILES\n   153\t\n   154\t| File | Responsibility |\n   155\t|---|---|\n   156\t| `opencode-goal.js` | The largest plugin. Owns the goal state machine, supervisor, continuation, capabilities and the goal tool surface. Hooks session, message, permission and question events, `experimental.chat.system.transform` and a family of goal tools. |\n   157\t| `system-skill-advisor.js` | Spawns the skill-advisor subprocess on a prompt-cache miss, manages a TTL+LRU prompt cache with in-flight dedup, integrates transform-dedup where the opt-in same-message dedup bases its decision on the full advisor block before directive-lifecycle reduction and suppresses a repeated transform for the same message and exposes `spec_kit_skill_advisor_status`. Its recommendation mapper keeps each CLI row's `command`, `policy`, `ownerSkillId` and `needsMode` under the names `renderAdvisorBrief` reads, so an OpenCode brief names the same command and policy as a hook brief. |\n   158\t| `system-spec-gate.js` | Maps OpenCode's transport onto the runtime-neutral spec-gate core. Classify best-effort fetches the last user message via `ctx.client`. Enforce throws `system-spec-gate:` on deny. `event` sweeps, advances and evicts state. |\n   159\t| `sk-code-post-edit-quality.js` | Correlates `tool.execute.before` file paths to `tool.execute.after` callIDs, runs the post-edit router core and drains findings on the next transform. |\n   160\t| `lib/v2-bridge.js` | Builds the dual export for every bridged plugin. `server` is the unchanged v1 factory, and `setup` maps its hooks onto OpenCode 2 registrations and returns a cleanup function. |\n   161\t| `lib/tool-identity.js` | The `tool` identity helper. Returns a v1 tool definition unchanged and carries zod as `tool.schema`. |\n   162\t| `lib/opencode-message-identity.js` | Shared stable transform identity and dedup state used by the advisor plugin. |\n   163\t\n   164\t---\n   165\t\n   166\t## 7. CONFIGURATION\n   167\t\n   168\tEvery plugin except `session-relaunch.js` is enabled by default. Truthy disable values are `1`, `true`, `yes` and `on` (case-insensitive) for the shared resolver. Each plugin that honors a switch checks `isHookEnabled('<concern>')` at entry (some at factory entry, some per-hook) and stops its main work when disabled. Housekeeping can still run, such as the deep-loop guard's stale-state sweep on `session.created`. The one exception named in the overview does not.\n   169\t\n   170\t| Variable | Effect |\n   171\t|---|---|\n   172\t| `SYSTEM_HOOKS_DISABLED=1` | Master switch that disables every plugin in this folder that reads `hook-flags.cjs`, along with every other repo hook. It does not reach `sk-git-message-gate.js`. |\n   173\t| Per-concern switch | The default name is `SYSTEM_<CONCERN>_DISABLED` (e.g. `SYSTEM_SPEC_GATE_DISABLED`, `SYSTEM_SKILL_ADVISOR_DISABLED`). Six concerns use another canonical name: `OPENCODE_GOAL_DISABLED`, `CLI_DISPATCH_AUDIT_DISABLED`, `MCP_ROUTE_GUARD_DISABLED`, `CODEX_HOOKS_WATCHDOG_DISABLED`, `SK_GIT_PREFLIGHT_DISABLED` and `SK_CODE_POST_EDIT_QUALITY_DISABLED`. |\n   174\t| Older aliases | `hook-flags.cjs` still honors older names, e.g. `SPECKIT_SKILL_ADVISOR_HOOK_DISABLED` and `OPENCODE_GOAL_PLUGIN_DISABLED`. See each plugin's own README. |\n   175\t| `SYSTEM_SESSION_RELAUNCH_OPENCODE_ENABLED`, `SYSTEM_SESSION_RELAUNCH_ENABLED` | Turn on `session-relaunch.js`, which ships off. A non-empty OpenCode flag decides for OpenCode (`1` on, `0` off), and the global flag decides otherwise. `SYSTEM_SESSION_RELAUNCH_DISABLED=1` and the master switch still win. Also read from `.skilled/hooks/hook-flags.env`. |\n   176\t\n   177\tOptional tuning: `SPECKIT_OPENCODE_HOOK_TIMEOUT_MS` (default 3000, owned by `system-skill-advisor`), `SYSTEM_OPENCODE_TRANSFORM_DEDUP=1` (opt-in transform dedup for the advisor plugin), plus per-plugin cache/budget/timeout envs documented in each plugin's README.\n   178\t\n   179\tSet a flag inline for one command, export it for a session or persist it in `.skilled/hooks/hook-flags.env` (copied from `hook-flags.env.example`, gitignored). The environment always wins over the file, so a persisted default can be overridden for a single session. Only switches read through `hook-flags.cjs` can be persisted there.\n   180\t\n   181\t---\n   182\t\n   183\t## 8. BOUNDARIES AND FLOW\n   184\t\n   185\t| Boundary | Rule |\n   186\t|---|---|\n   187\t| Transport only | Plugin files own the OpenCode transport boundary. Shared policy and runtime-neutral logic belongs under the owning skill. |\n   188\t| Dual export | Every plugin file default-exports one plain object `{ id, setup, server }`: `setup` is the OpenCode 2 (recommended) entry and `server` the OpenCode 1 (fallback) entry. `lib/` modules are shared helpers, never plugin sources. |\n   189\t| No stdout/stderr | Plugins do not print to stdout or stderr in normal operation. The only writes are opt-in debug output, such as the goal plugin's debug env. OpenCode overlays those onto the TUI prompt line and corrupts the interactive session. Findings go through `experimental.chat.system.transform`, tool returns or bounded workspace logs. |\n   190\t| Fail-open | All advisory checks fail open. A missing payload, a subprocess timeout, a parse failure or any internal error resolves to a no-op, or for the read-only completion tool to a payload that marks the missing sections unavailable. The skill advisor is the exception to the no-op because on a subprocess timeout, a parse failure, a missing prompt or an internal error it injects its status-headed fallback (an `Advisor: outage (...)` or `Advisor: prompt skipped.` line above the directives block) and never blocks the prompt. The git message gate and the dispatch guard reject by default. Spec-gate rejection is opt-in through `SYSTEM_SPEC_GATE_ENFORCE`, and deep-loop guard rejection through `SYSTEM_DEEP_LOOP_GUARD_REJECT=1` or `SYSTEM_DEEP_LOOP_GUARD_REJECT_LOOP=1`. |\n   191\t| Kill-switch | Every plugin except the one named in the overview honors its per-concern kill-switch via the shared `hook-flags.cjs` resolver plus the master `SYSTEM_HOOKS_DISABLED`. A disabled plugin stops its main work, and the goal and advisor status tools stay registered to report that. Housekeeping such as the deep-loop guard's stale-state sweep can still run. |\n   192\t| Bounded | Subprocess spawns, pending-event buffers and workspace logs are bounded, as is the skill advisor's TTL+LRU prompt cache (per-plugin limits documented in each plugin's README). The advisor's workspace-surface cache instead keeps one entry per workspace directory the process has seen, so it is not capped. |\n   193\t| Tests | Plugin tests stay under `tests/`. |\n   194\t\n   195\t---\n   196\t\n   197\t## 9. HOOK MODEL\n   198\t\n   199\tPlugin factories register some subset of:\n   200\t\n   201\t- `tool`: tools exposed to the model (e.g. `spec_kit_skill_advisor_status`, the goal tools, the read-only completion-evidence tool).\n   202\t- `tool.execute.before`: pre-tool evaluation (spec-gate enforce, dispatch guard, env-secret-guard, git message gate, git-preflight, mcp-route-guard, post-edit-quality path stash, deep-loop guard).\n   203\t- `tool.execute.after`: post-tool evaluation (cli-dispatch-audit, post-edit-quality run, injection screen).\n   204\t- `experimental.chat.system.transform`: per-turn system-context injection (advisor, spec-gate classify, goal, session-cleanup, session-relaunch nudge and seed, git-preflight drain, post-edit-quality drain, dist-freshness and injection-screen drain).\n   205\t- `event`: lifecycle and activity handlers (`session.created`/`status`/`idle`/`deleted`/`resumed`/`compacted`/`compact`, `message.updated`/`message.part.updated`, the goal plugin's permission and question events, `server.instance.disposed`/`global.disposed`).\n   206\t- `dispose`: teardown when the host unloads the plugin (session-cleanup).\n   207\t\n   208\tThe bridge in `lib/v2-bridge.js` maps that set onto OpenCode 2 registrations: `event` to the event stream, `tool.execute.before`/`after` to the tool execute hooks, `experimental.chat.system.transform` to the session context hook and `tool` definitions to the tool transform. A key outside the set is reported through `cleanup.skippedKeys`.\n   209\t\n   210\t---\n   211\t\n   212\t## 10. VALIDATION\n   213\t\n   214\tRun the Node regression command from the repository root:\n   215\t\n   216\t```bash\n   217\tnode --test .opencode/plugins/tests/*.test.cjs\n   218\t```\n   219\t\n   220\tExpected result: Node discovers every current CJS test file and reports the suite result. A failing test is a validation failure.\n   221\t\n   222\t```bash\n   223\t(\n   224\t  rc=0\n   225\t  for f in .opencode/plugins/*.js\n   226\t  do node --check \"$f\" || rc=1\n   227\t  done\n   228\t  exit \"$rc\"\n   229\t)\n   230\t```\n   231\t\n   232\tExpected result: exit status 0, with no syntax errors across every plugin. Any failing file makes the command exit 1. `node --check` checks syntax only and does not resolve imports.\n   233\t\n   234\tCheck both OpenCode versions with the doctor battery:\n   235\t\n   236\t```bash\n   237\tnode .skilled/commands/doctor/scripts/opencode-version-battery.cjs --family=v1\n   238\tnode .skilled/commands/doctor/scripts/opencode-version-battery.cjs --family=v2\n   239\t```\n   240\t\n   241\tExpected result: each exits 0, reporting all plugin files active on OpenCode 2 (recommended) and all discovered on OpenCode 1 (fallback). The v2 run starts its own private server.\n   242\t\n   243\t---\n   244\t\n   245\t## 11. RELATED\n   246\t\n   247\t- [`ARCHITECTURE.md`](./ARCHITECTURE.md): the dual-version design, the bridge, the kill switches and the known limits.\n   248\t- [`tests/README.md`](./tests/README.md): the plugin regression suites.\n   249\t- [`tests/helpers/README.md`](./tests/helpers/README.md): the shared test helpers.\n   250\t- [`../hooks/README.md`](../hooks/README.md): the unified hooks tree with the kill-switch index and coverage matrix. Plugins are mirrored there as the OpenCode adapter for their concern (`spec-gate`, `skill-advisor`, `git-preflight`, `git-message-gate`, `session-cleanup`, `injection-screen`).\n   251\t- [`../skills/`](../skills/): the shared skill cores these plugins adapt.\n   252\t\n   253\t<!-- readme-check\n   254\tallow-count four plugins | the sentence counts the plugins that reject by default by behavior, not the plugin files in this folder\n   255\tallow-count 17 plugin files | the sentence reports the 2026-10-19 battery run and names the plugins added since\n   256\tallow-count 17 plugins | the sentence reports the 2026-10-19 battery run, not the current folder\n   257\t-->\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"OK   .opencode/plugins/lib/tool-identity.js\nOK   .opencode/plugins/lib/v2-bridge.js\nOK   .opencode/plugins/lib/opencode-message-identity.js\nOK   .opencode/plugins/lib/skill-advisor-render.js\nOK   .opencode/hooks/shared/hook-flags.cjs\nOK   .opencode/skills/system-spec-kit/runtime/hooks/lib/workspace/repo-root.mjs\n=== README ===\n     1\t---\n     2\ttitle: \"OpenCode Plugin Entrypoints\"\n     3\tdescription: \"JavaScript plugin entrypoints for context injection, lifecycle handling, policy guards, runtime tools and post-action checks. OpenCode discovers these via a flat glob over .opencode/plugins/, and each module default-exports the object `{ id, setup, server }`.\"\n     4\ttrigger_phrases:\n     5\t  - \"OpenCode plugins\"\n     6\t  - \"plugin entrypoints\"\n     7\t  - \"OpenCode hook events\"\n     8\t---\n     9\t\n    10\t# OpenCode Plugin Entrypoints\n    11\t\n    12\t> JavaScript plugin entrypoints for context injection, lifecycle handling, policy guards, runtime tools and post-action checks.\n    13\t\n    14\t---\n    15\t\n    16\t## 1. OVERVIEW\n    17\t\n    18\t`.opencode/plugins/` contains the JavaScript modules OpenCode discovers as local plugins. Each module default-exports one plain object `{ id, setup, server }`: `setup` is the OpenCode 2 (recommended) entry and `server` the OpenCode 1 (fallback) entry. Source plugins build that object with `dualPlugin(id, server)` from `lib/v2-bridge.js`, so the v1 factory stays the single implementation and the bridge derives the v2 leg from it. OpenCode loads plugins by a flat glob over this folder (it does not recurse), so every loadable plugin lives directly here. The `lib/` and `tests/` subfolders are not plugin sources.\n    19\t\n    20\tEvery plugin here runs on both OpenCode majors. OpenCode 2 calls `setup(ctx)` and OpenCode 1 calls `server(input)`, and neither host calls the other's entry, so a plugin that exported only one entry would do nothing on the other host. On 2026-10-19 the 17 plugin files then present were verified on OpenCode 2.0.32 and OpenCode 1.19.3: the doctor battery reported all 17 active on 2.0.32 and discovered all 17 on 1.19.3. On 2026-10-20 a live run of every plugin showed each one's effect on both versions. One of those plugins has since been removed, and `decision-capture.js` was added later through the same bridge without a rerun of that battery. `session-history-lookup.js` was added the same way, and so was `env-secret-guard.js`, which has no live battery run yet; on 2026-11-08 a live OpenCode 2.2.5 session showed its section and redeemed the printed command, and a live OpenCode 1.19.4 session did the same. `overlay-guard.js` was added the same way and has no live battery run yet. [ARCHITECTURE.md](./ARCHITECTURE.md) explains the dual export, the bridge and what has no OpenCode 2 equivalent.\n    21\t\n    22\t<!-- readme-check\n    23\tallow-count 17 plugin files | a dated count of the files present at the 2026-10-19 battery, not the current folder\n    24\tallow-count 17 plugins | a dated count of the files present at the 2026-10-19 battery, not the current folder\n    25\t-->\n    26\t\n    27\tThe directory inventory is authoritative for the auto-loaded plugin surface. Shared policy cores stay under their owning skill (`system-spec-kit`, `system-skill-advisor`, `sk-git`, `sk-code`, `system-completion`, `system-deep-loop`). Most files here are **transport adapters** that translate OpenCode events into those cores and keep terminal output out of the TUI. `opencode-goal.js` is the exception: it implements the goal state machine and goal tools itself and shares only selected helpers. The single shared boundary every plugin honors in normal operation: **never write to stdout or stderr**, because OpenCode overlays those onto the TUI prompt line and corrupts the interactive session. Findings are injected via `experimental.chat.system.transform`, returned from tool handlers or persisted to bounded workspace logs.\n    28\t\n    29\tMost plugins honor a per-concern kill switch through the shared `hook-flags.cjs` resolver (`isHookEnabled('<concern>')`), plus the master `SYSTEM_HOOKS_DISABLED`. A disabled plugin stops its main work.\n    30\t\n    31\tMost become full no-ops, while the goal tools and the advisor status tool stay registered and report that they are disabled. All advisory checks fail open.\n    32\t\n    33\tFour plugins reject by default by throwing from `tool.execute.before`: `sk-git-message-gate.js`, the dispatch guard in `cli-dispatch-audit.js`, `env-secret-guard.js`, which refuses a read or write of a dotenv file, and `overlay-guard.js`, which refuses a write to a file a vendored tree's overlay owns. Other rejection is opt-in: `SYSTEM_SPEC_GATE_ENFORCE` for spec-gate deny, and `SYSTEM_DEEP_LOOP_GUARD_REJECT=1` or `SYSTEM_DEEP_LOOP_GUARD_REJECT_LOOP=1` for the deep-loop guard, which otherwise only warns.\n    34\t\n    35\tOne plugin is an exception. `sk-git-message-gate.js` has no switch, because the commit, PR and branch rules carry no bypass on any surface.\n    36\t\n    37\t---\n    38\t\n    39\t## 2. WHAT'S HERE / INVENTORY\n    40\t\n    41\t| File | Concern | Hook surface | Responsibility |\n    42\t|---|---|---|---|\n    43\t| `ask-surface-guard.js` | `ask-surface` | `event` (`session.idle`) | When a turn ends in a typed option menu and called no `question` tool, sends the turn back once through `session.promptAsync` with an instruction to ask through `question`. Writes nothing to stdout or stderr, fails open, and stays off under `SYSTEM_ASK_SURFACE_DISABLED=1`. |\n    44\t| `classifier-injection-screen.js` | `injection-screen` | `tool.execute.after` for `webfetch`, `experimental.chat.system.transform` | Screens fetched `webfetch` text for instructions aimed at the agent. Buffers up to 20 advisories per session and drains them on the next transform, the model call that reads the fetch result. Never writes stdout/stderr. |\n    45\t| `cli-dispatch-audit.js` | `dispatch`, `dispatch-guard` | `tool.execute.before` and `tool.execute.after` for Bash | `tool.execute.before` blocks a CLI dispatch that breaks a hard rule declared in the target skill's `SKILL.md` by throwing, and fails open on its own errors. `tool.execute.after` records redacted dispatch telemetry after completed CLI calls, recognizes an `opencode` or `opencode2` invocation and appends a bounded audit record. |\n    46\t| `codex-hooks-watchdog.js` | `codex-watchdog` | `event` (`session.created`) | Watches Codex hook installation and reports drift. Never affects the guarded session. |\n    47\t| `decision-capture.js` | `decision-capture` | `tool.execute.after` for `question`, `experimental.chat.system.transform` | Queues each answered `question` call for the next full-auto save under the same key as the save-time sweep, and pushes one system line when the count of answers still waiting for a decision record rises. Fails open and never changes the tool output. |\n    48\t| `env-secret-guard.js` | `env-secret-guard` | `tool.execute.before`, `tool` (`env_secret_list_keys`, `env_secret_validate`, `env_secret_fingerprint`) | Refuses a file tool or shell command that would read or write a dotenv file by throwing, through the shared core in `../hooks/env-secret-guard/`. Its three tools list keys, check syntax and fingerprint one value without returning any value. Fails open on its own errors. |\n    49\t| `mcp-route-guard.js` | `mcp-route-guard` | `tool.execute.before` | Advises when native MCP calls should use Code Mode. Persists to a bounded, rotated workspace log. |\n    50\t| `overlay-guard.js` | `overlay-guard` | `tool.execute.before` for write tools | Refuses a write tool that names a file a vendored tree's overlay owns, by throwing, through the shared core in `../hooks/overlay-guard/`. The reason names the overlay file to edit instead. A write it cannot judge is allowed, and its notes go to a bounded, rotated log because OpenCode paints stdout and stderr onto the prompt line. |\n    51\t| `opencode-goal.js` | `goal` | `event` (`session.created`/`status`/`idle`/`deleted`, `message.updated`/`message.part.updated`, `permission.asked`/`replied`, `question.asked`/`replied`/`rejected`), `experimental.chat.system.transform`, `tool` (goal tools) | Holds a text goal or binds a session to a packet `goal.md` and injects the objective slice built from it (via `../hooks/goal/lib/goal-slice.cjs`). Largest plugin in this folder. Owns the goal state machine, supervisor, continuation, capabilities and the goal tool surface including `bind`, `resent` and `packet`. |\n    52\t| `session-cleanup.js` | `session-cleanup` | `event` (`session.created`/`deleted`), `experimental.chat.system.transform`, `dispose` | Performs bounded session and host cleanup. Startup guards and teardown cleanup. Reaps MCP helper processes via `session-cleanup.sh`. |\n    53\t| `session-history-lookup.js` | `session-lifecycle` | `event` (`session.compacted`), `experimental.chat.system.transform` | On `session.compacted`, saves a history locator keyed by the checkout root above the session folder, then pushes the shared `## History Lookup` section into each request's system array while the locator is under 30 minutes old. Fails open: no build, no checkout or a failed save means no section. |\n    54\t| `session-relaunch.js` | `session-relaunch` | `event` (`message.updated`/`message.part.updated`/`session.idle`), `experimental.chat.system.transform` | Tracks usage and seed text. Inside `skilled-loop`, while this session has no matching relaunch record, it pushes the active nudge on every request. Outside the loop the nudge asks for a note and `keep` instead of `prepare`, because only the wrapper can relaunch the session. While a matching seed's note is open, it injects the seed on each request, then a claimed reminder once the note is claimed. It arms the record on `session.idle`. The plugin runs the detached killer with `node` because OpenCode hosts plugins on Bun. |\n    55\t| `sk-code-post-edit-quality.js` | `post-edit-quality` | `tool.execute.before`, `tool.execute.after`, `experimental.chat.system.transform` | Runs bounded post-edit quality checks. `tool.execute.before` stashes the edited path keyed by callID, because the after hook has no file path. `tool.execute.after` runs the router core. Findings drain on the next transform and are recorded to a workspace log. |\n    56\t| `sk-git-message-gate.js` | `git-message-gate` (no kill switch) | `tool.execute.before` for `bash` | Refuses a `git commit` message, `gh pr` description or new branch name that breaks the repository's own sk-git templates by throwing. Allows what the shared gate cannot parse, but refuses when the repository's rules exist and cannot be read. It has no kill switch, because the commit and push rules carry no bypass on any surface. |\n    57\t| `sk-git-preflight-advisory.js` | `git-preflight` | `tool.execute.before` for `bash`, `experimental.chat.system.transform` | Advises on Git command scope before execution. Buffers at most 20 advisory events and drains them on the next transform. Never prints. |\n    58\t| `system-completion-sentinel.js` | `completion` | `event` (`session.created`/`idle`) | Checks completion evidence at session lifecycle points. On `session.idle`, resolves completion state via `ctx.client.session.messages()` (guarded, fail-open). Throttled-sweeps the shared state dir on `session.created`. |\n    59\t| `system-deep-loop-guard.js` | `task-dispatch` | `event` (`session.created`), `tool.execute.before` | Checks deep-loop Task dispatches and repeat handoffs. Sweeps stale loop-guard state on `session.created`. |\n    60\t| `system-dist-freshness-guard.js` | `dist-freshness` | `tool.execute.before`, `event` (`session.created`/`deleted`), `experimental.chat.system.transform` | Reports stale compiled outputs and invalidates diagnostics. Short-circuits the whole plugin at factory entry when disabled. |\n    61\t| `system-skill-advisor.js` | `skill-advisor` | `experimental.chat.system.transform`, `event`, `tool` (`spec_kit_skill_advisor_status`) | Injects skill-routing guidance per prompt and exposes advisor status. Spawns the advisor subprocess only on a cache miss, behind a TTL+LRU prompt cache with in-flight dedup. |\n    62\t| `system-spec-gate.js` | `spec-gate` | `experimental.chat.system.transform`, `tool.execute.before`, `event` | Classifies and evaluates mutation-gate state. Classify best-effort fetches the last user message via `ctx.client`. Enforce throws `system-spec-gate:` on deny (OpenCode's deny signal). |\n    63\t| `system-speckit-completion.js` | `completion` | `tool` (read-only completion evidence) | Exposes read-only completion evidence. Checks the `completion` concern at factory entry. |\n    64\t\n    65\t---\n    66\t\n    67\t## 3. SHARED LIB MODULES\n    68\t\n    69\t`lib/` holds the modules the entry files import. None of them is a plugin source, and the loader never registers one on its own.\n    70\t\n    71\t| File | Responsibility |\n    72\t|---|---|\n    73\t| `lib/v2-bridge.js` | Builds the dual export. `dualPlugin(id, server)` returns `{ id, setup, server }`: `setup` maps its hooks (event stream, `tool.execute.before`/`after`, `experimental.chat.system.transform`, tool definitions) onto OpenCode 2 registrations and returns a cleanup function, while `server` stays the unchanged OpenCode 1 factory. It reports v2 `shell` and `subagent` calls under their v1 names, announces each session once with `session.created`, and fills the message events v1 plugins read. Hook keys the bridge does not map are reported through `cleanup.skippedKeys`. |\n    74\t| `lib/tool-identity.js` | Identity helper for tool definitions. `tool(definition)` returns the definition unchanged, and `tool.schema` is zod, so one definition serves the v1 `tool` hook and the bridge's v2 tool registration. |\n    75\t| `lib/opencode-message-identity.js` | Stable transform identity and dedup state. `system-skill-advisor.js` uses it when `deduplicateTransforms` is on. |\n    76\t| `lib/skill-advisor-render.js` | Advisor fallback and compiled-route renderers, shared by the advisor plugin and its tests. |\n    77\t| `lib/classifier-injection-screen-core.js` | Constants and the session-id resolver for the injection-screen plugin. |\n    78\t| `lib/completion-sentinel-core.js` | Re-export of the completion-evidence sentinel core under `skills/system-spec-kit`. |\n    79\t| `lib/opencode-goal-core.js` | WeakMap registry that binds a goal plugin module's helpers to its server, so both entries read the same state. |\n    80\t| `lib/sk-code-post-edit-quality-core.js` | Constants, the callID-to-filePath correlation map and the finding formatter for the post-edit-quality plugin. |\n    81\t\n    82\tThe bridge mapping is exercised against stub contexts in the test suites. On 2026-10-19 the doctor battery confirmed that all 17 plugins load on 1.19.3 and show active on 2.0.32. On 2026-10-20 a probe plugin on a private OpenCode 2.0.32 host received `session.created` and `session.deleted` under those names for sessions created and removed through the server API, and received `location.shutdown` instead of `server.instance.disposed` or `global.disposed`. The probe did not start a session with `opencode run`, and v2 can deliver session traffic before `session.created`, so the bridge synthesizes a `session.created` the first time it sees traffic for a session and drops a later duplicate (`specs/cli-external-orchestration/opencode-platform/002-opencode-v1-v2-dual-compat/024-plugin-inventory-guards/scratch/v2-events/README.txt`). `tests/plugin-inventory.json` lists every event name a bridged plugin handles that the bridge neither maps nor aliases, grouped as observed, not delivered or unverified. The `plugin-utilization` playbook in `cli-opencode` checks each plugin's effect in a live session; on 2026-10-20 all 17 acted on OpenCode 1.19.3 and 2.0.32.\n    83\t\n    84\t---\n    85\t\n    86\t## 4. TEST SUITES\n    87\t\n    88\t`tests/` holds the regression suites for the entry files. They run on the Node built-in test runner with hermetic stubs. The v2 suites are:\n    89\t\n    90\t| File | Covers |\n    91\t|---|---|\n    92\t| `tests/v2-bridge.test.cjs` | The bridge itself: event aliases and mappings, the v1 client adapters, hook registration and cleanup, tool result conversion and the `tool` identity contract. |\n    93\t| `tests/v2-hard-plugins.test.cjs` | Selected hard cases, not the plugin list: expected v2 registrations for `system-completion-sentinel`, `system-spec-gate`, `system-skill-advisor` and `opencode-goal` through a stub v2 context, plus behavior cases for the first four. It also requires a case for every native-dual exception in the inventory. |\n    94\t| `tests/v2-registration.test.cjs` | The dual export shape, at least one v2 registration and the cleanup function for every bridged plugin the inventory finds. |\n    95\t| `tests/plugin-inventory.test.cjs` | The inventory itself: every `.js` file is bridged or a listed native-dual exception, every bridged plugin maps all its hooks, and every event name a bridged plugin compares against is mapped, aliased or listed in `tests/plugin-inventory.json`. The event names come from parsing each plugin's `type` comparisons, `switch` statements on the event type and literal collections; any other kind of event check, such as `eventType.endsWith('.disposed')`, must be listed under `unscannedEventChecks` with a reason. |\n    96\t\n    97\tThe plugin list comes from the folder, not from a hand-written list. `tests/helpers/plugin-inventory.cjs` treats a file as bridged when its source contains `dualPlugin('<file stem>'`, and `tests/v2-registration.test.cjs` then checks that its default export has the dual shape, and `tests/plugin-inventory.json` names the exceptions, with an empty `nativeDual` list. A new plugin file that is neither bridged nor listed fails `tests/plugin-inventory.test.cjs`.\n    98\t\n    99\tThe remaining `*.test.cjs` files cover v1 behavior and adjacent contracts. `tests/README.md` indexes every suite, and `tests/helpers/` holds the shared fixtures.\n   100\t\n   101\t---\n   102\t\n   103\t## 5. DIRECTORY TREE\n   104\t\n   105\t```text\n   106\tplugins/\n   107\t+-- README.md                              # this index\n   108\t+-- ARCHITECTURE.md                        # dual-version design, bridge and limits\n   109\t+-- ask-surface-guard.js\n   110\t+-- classifier-injection-screen.js\n   111\t+-- cli-dispatch-audit.js\n   112\t+-- codex-hooks-watchdog.js\n   113\t+-- decision-capture.js\n   114\t+-- env-secret-guard.js\n   115\t+-- mcp-route-guard.js\n   116\t+-- overlay-guard.js\n   117\t+-- opencode-goal.js\n   118\t+-- session-cleanup.js\n   119\t+-- session-history-lookup.js\n   120\t+-- session-relaunch.js\n   121\t+-- sk-code-post-edit-quality.js\n   122\t+-- sk-git-message-gate.js\n   123\t+-- sk-git-preflight-advisory.js\n   124\t+-- system-completion-sentinel.js\n   125\t+-- system-deep-loop-guard.js\n   126\t+-- system-dist-freshness-guard.js\n   127\t+-- system-skill-advisor.js\n   128\t+-- system-spec-gate.js\n   129\t+-- system-speckit-completion.js\n   130\t+-- lib/\n   131\t|   +-- classifier-injection-screen-core.js\n   132\t|   +-- completion-sentinel-core.js\n   133\t|   +-- opencode-goal-core.js\n   134\t|   +-- opencode-message-identity.js\n   135\t|   +-- sk-code-post-edit-quality-core.js\n   136\t|   +-- skill-advisor-render.js\n   137\t|   +-- tool-identity.js\n   138\t|   `-- v2-bridge.js\n   139\t`-- tests/\n   140\t    +-- README.md\n   141\t    +-- helpers/\n   142\t    +-- plugin-inventory.test.cjs\n   143\t    +-- plugin-inventory.json\n   144\t    +-- v2-bridge.test.cjs\n   145\t    +-- v2-hard-plugins.test.cjs\n   146\t    +-- v2-registration.test.cjs\n   147\t    `-- *.test.cjs                         # the remaining plugin suites\n   148\t```\n   149\t\n   150\t---\n   151\t\n   152\t## 6. KEY FILES\n   153\t\n   154\t| File | Responsibility |\n   155\t|---|---|\n   156\t| `opencode-goal.js` | The largest plugin. Owns the goal state machine, supervisor, continuation, capabilities and the goal tool surface. Hooks session, message, permission and question events, `experimental.chat.system.transform` and a family of goal tools. |\n   157\t| `system-skill-advisor.js` | Spawns the skill-advisor subprocess on a prompt-cache miss, manages a TTL+LRU prompt cache with in-flight dedup, integrates transform-dedup where the opt-in same-message dedup bases its decision on the full advisor block before directive-lifecycle reduction and suppresses a repeated transform for the same message and exposes `spec_kit_skill_advisor_status`. Its recommendation mapper keeps each CLI row's `command`, `policy`, `ownerSkillId` and `needsMode` under the names `renderAdvisorBrief` reads, so an OpenCode brief names the same command and policy as a hook brief. |\n   158\t| `system-spec-gate.js` | Maps OpenCode's transport onto the runtime-neutral spec-gate core. Classify best-effort fetches the last user message via `ctx.client`. Enforce throws `system-spec-gate:` on deny. `event` sweeps, advances and evicts state. |\n   159\t| `sk-code-post-edit-quality.js` | Correlates `tool.execute.before` file paths to `tool.execute.after` callIDs, runs the post-edit router core and drains findings on the next transform. |\n   160\t| `lib/v2-bridge.js` | Builds the dual export for every bridged plugin. `server` is the unchanged v1 factory, and `setup` maps its hooks onto OpenCode 2 registrations and returns a cleanup function. |\n   161\t| `lib/tool-identity.js` | The `tool` identity helper. Returns a v1 tool definition unchanged and carries zod as `tool.schema`. |\n   162\t| `lib/opencode-message-identity.js` | Shared stable transform identity and dedup state used by the advisor plugin. |\n   163\t\n   164\t---\n   165\t\n   166\t## 7. CONFIGURATION\n   167\t\n   168\tEvery plugin except `session-relaunch.js` is enabled by default. Truthy disable values are `1`, `true`, `yes` and `on` (case-insensitive) for the shared resolver. Each plugin that honors a switch checks `isHookEnabled('<concern>')` at entry (some at factory entry, some per-hook) and stops its main work when disabled. Housekeeping can still run, such as the deep-loop guard's stale-state sweep on `session.created`. The one exception named in the overview does not.\n   169\t\n   170\t| Variable | Effect |\n   171\t|---|---|\n   172\t| `SYSTEM_HOOKS_DISABLED=1` | Master switch that disables every plugin in this folder that reads `hook-flags.cjs`, along with every other repo hook. It does not reach `sk-git-message-gate.js`. |\n   173\t| Per-concern switch | The default name is `SYSTEM_<CONCERN>_DISABLED` (e.g. `SYSTEM_SPEC_GATE_DISABLED`, `SYSTEM_SKILL_ADVISOR_DISABLED`). Six concerns use another canonical name: `OPENCODE_GOAL_DISABLED`, `CLI_DISPATCH_AUDIT_DISABLED`, `MCP_ROUTE_GUARD_DISABLED`, `CODEX_HOOKS_WATCHDOG_DISABLED`, `SK_GIT_PREFLIGHT_DISABLED` and `SK_CODE_POST_EDIT_QUALITY_DISABLED`. |\n   174\t| Older aliases | `hook-flags.cjs` still honors older names, e.g. `SPECKIT_SKILL_ADVISOR_HOOK_DISABLED` and `OPENCODE_GOAL_PLUGIN_DISABLED`. See each plugin's own README. |\n   175\t| `SYSTEM_SESSION_RELAUNCH_OPENCODE_ENABLED`, `SYSTEM_SESSION_RELAUNCH_ENABLED` | Turn on `session-relaunch.js`, which ships off. A non-empty OpenCode flag decides for OpenCode (`1` on, `0` off), and the global flag decides otherwise. `SYSTEM_SESSION_RELAUNCH_DISABLED=1` and the master switch still win. Also read from `.skilled/hooks/hook-flags.env`. |\n   176\t\n   177\tOptional tuning: `SPECKIT_OPENCODE_HOOK_TIMEOUT_MS` (default 3000, owned by `system-skill-advisor`), `SYSTEM_OPENCODE_TRANSFORM_DEDUP=1` (opt-in transform dedup for the advisor plugin), plus per-plugin cache/budget/timeout envs documented in each plugin's README.\n   178\t\n   179\tSet a flag inline for one command, export it for a session or persist it in `.skilled/hooks/hook-flags.env` (copied from `hook-flags.env.example`, gitignored). The environment always wins over the file, so a persisted default can be overridden for a single session. Only switches read through `hook-flags.cjs` can be persisted there.\n   180\t\n   181\t---\n   182\t\n   183\t## 8. BOUNDARIES AND FLOW\n   184\t\n   185\t| Boundary | Rule |\n   186\t|---|---|\n   187\t| Transport only | Plugin files own the OpenCode transport boundary. Shared policy and runtime-neutral logic belongs under the owning skill. |\n   188\t| Dual export | Every plugin file default-exports one plain object `{ id, setup, server }`: `setup` is the OpenCode 2 (recommended) entry and `server` the OpenCode 1 (fallback) entry. `lib/` modules are shared helpers, never plugin sources. |\n   189\t| No stdout/stderr | Plugins do not print to stdout or stderr in normal operation. The only writes are opt-in debug output, such as the goal plugin's debug env. OpenCode overlays those onto the TUI prompt line and corrupts the interactive session. Findings go through `experimental.chat.system.transform`, tool returns or bounded workspace logs. |\n   190\t| Fail-open | All advisory checks fail open. A missing payload, a subprocess timeout, a parse failure or any internal error resolves to a no-op, or for the read-only completion tool to a payload that marks the missing sections unavailable. The skill advisor is the exception to the no-op because on a subprocess timeout, a parse failure, a missing prompt or an internal error it injects its status-headed fallback (an `Advisor: outage (...)` or `Advisor: prompt skipped.` line above the directives block) and never blocks the prompt. The git message gate and the dispatch guard reject by default. Spec-gate rejection is opt-in through `SYSTEM_SPEC_GATE_ENFORCE`, and deep-loop guard rejection through `SYSTEM_DEEP_LOOP_GUARD_REJECT=1` or `SYSTEM_DEEP_LOOP_GUARD_REJECT_LOOP=1`. |\n   191\t| Kill-switch | Every plugin except the one named in the overview honors its per-concern kill-switch via the shared `hook-flags.cjs` resolver plus the master `SYSTEM_HOOKS_DISABLED`. A disabled plugin stops its main work, and the goal and advisor status tools stay registered to report that. Housekeeping such as the deep-loop guard's stale-state sweep can still run. |\n   192\t| Bounded | Subprocess spawns, pending-event buffers and workspace logs are bounded, as is the skill advisor's TTL+LRU prompt cache (per-plugin limits documented in each plugin's README). The advisor's workspace-surface cache instead keeps one entry per workspace directory the process has seen, so it is not capped. |\n   193\t| Tests | Plugin tests stay under `tests/`. |\n   194\t\n   195\t---\n   196\t\n   197\t## 9. HOOK MODEL\n   198\t\n   199\tPlugin factories register some subset of:\n   200\t\n   201\t- `tool`: tools exposed to the model (e.g. `spec_kit_skill_advisor_status`, the goal tools, the read-only completion-evidence tool).\n   202\t- `tool.execute.before`: pre-tool evaluation (spec-gate enforce, dispatch guard, env-secret-guard, git message gate, git-preflight, mcp-route-guard, post-edit-quality path stash, deep-loop guard).\n   203\t- `tool.execute.after`: post-tool evaluation (cli-dispatch-audit, post-edit-quality run, injection screen).\n   204\t- `experimental.chat.system.transform`: per-turn system-context injection (advisor, spec-gate classify, goal, session-cleanup, session-relaunch nudge and seed, git-preflight drain, post-edit-quality drain, dist-freshness and injection-screen drain).\n   205\t- `event`: lifecycle and activity handlers (`session.created`/`status`/`idle`/`deleted`/`resumed`/`compacted`/`compact`, `message.updated`/`message.part.updated`, the goal plugin's permission and question events, `server.instance.disposed`/`global.disposed`).\n   206\t- `dispose`: teardown when the host unloads the plugin (session-cleanup).\n   207\t\n   208\tThe bridge in `lib/v2-bridge.js` maps that set onto OpenCode 2 registrations: `event` to the event stream, `tool.execute.before`/`after` to the tool execute hooks, `experimental.chat.system.transform` to the session context hook and `tool` definitions to the tool transform. A key outside the set is reported through `cleanup.skippedKeys`.\n   209\t\n   210\t---\n   211\t\n   212\t## 10. VALIDATION\n   213\t\n   214\tRun the Node regression command from the repository root:\n   215\t\n   216\t```bash\n   217\tnode --test .opencode/plugins/tests/*.test.cjs\n   218\t```\n   219\t\n   220\tExpected result: Node discovers every current CJS test file and reports the suite result. A failing test is a validation failure.\n   221\t\n   222\t```bash\n   223\t(\n   224\t  rc=0\n   225\t  for f in .opencode/plugins/*.js\n   226\t  do node --check \"$f\" || rc=1\n   227\t  done\n   228\t  exit \"$rc\"\n   229\t)\n   230\t```\n   231\t\n   232\tExpected result: exit status 0, with no syntax errors across every plugin. Any failing file makes the command exit 1. `node --check` checks syntax only and does not resolve imports.\n   233\t\n   234\tCheck both OpenCode versions with the doctor battery:\n   235\t\n   236\t```bash\n   237\tnode .skilled/commands/doctor/scripts/opencode-version-battery.cjs --family=v1\n   238\tnode .skilled/commands/doctor/scripts/opencode-version-battery.cjs --family=v2\n   239\t```\n   240\t\n   241\tExpected result: each exits 0, reporting all plugin files active on OpenCode 2 (recommended) and all discovered on OpenCode 1 (fallback). The v2 run starts its own private server.\n   242\t\n   243\t---\n   244\t\n   245\t## 11. RELATED\n   246\t\n   247\t- [`ARCHITECTURE.md`](./ARCHITECTURE.md): the dual-version design, the bridge, the kill switches and the known limits.\n   248\t- [`tests/README.md`](./tests/README.md): the plugin regression suites.\n   249\t- [`tests/helpers/README.md`](./tests/helpers/README.md): the shared test helpers.\n   250\t- [`../hooks/README.md`](../hooks/README.md): the unified hooks tree with the kill-switch index and coverage matrix. Plugins are mirrored there as the OpenCode adapter for their concern (`spec-gate`, `skill-advisor`, `git-preflight`, `git-message-gate`, `session-cleanup`, `injection-screen`).\n   251\t- [`../skills/`](../skills/): the shared skill cores these plugins adapt.\n   252\t\n   253\t<!-- readme-check\n   254\tallow-count four plugins | the sentence counts the plugins that reject by default by behavior, not the plugin files in this folder\n   255\tallow-count 17 plugin files | the sentence reports the 2026-10-19 battery run and names the plugins added since\n   256\tallow-count 17 plugins | the sentence reports the 2026-10-19 battery run, not the current folder\n   257\t-->\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"cd /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research && for p in .opencode/plugins/lib/tool-identity.js .opencode/plugins/lib/v2-bridge.js .opencode/plugins/lib/opencode-message-identity.js .opencode/plugins/lib/skill-advisor-render.js .opencode/hooks/shared/hook-flags.cjs .opencode/skills/system-spec-kit/runtime/hooks/lib/workspace/repo-root.mjs; do if [ -e \\\"$p\\\" ]; then echo \\\"OK   $p\\\"; else echo \\\"MISS $p\\\"; fi; done; echo \\\"=== README ===\\\"; cat -n .opencode/plugins/README.md\"}"},"time":{"start":1794550557160,"end":1794550558590}}}}
