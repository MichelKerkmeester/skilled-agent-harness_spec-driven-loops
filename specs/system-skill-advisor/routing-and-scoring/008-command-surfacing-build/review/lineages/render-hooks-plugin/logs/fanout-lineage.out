ess-state': 'releaseReadinessState',\n62:  ['eventDir', '--event-dir'],\n63:  ['artifactDir', '--artifact-dir'],\n64:  ['stateLog', '--state-log'],\n65:  ['registry', '--registry'],\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"bySeverity {\"P0\":0,\"P1\":0,\"P2\":11}\nopen 11 resolved 2\nR1-P2-002:P2 R1-P2-003:P2 R1-P2-004:P2 R1-P2-005:P2 R2-P2-002:P2 R2-P2-003:P2 R3-P2-001:P2 R3-P2-002:P2 R4-P2-001:P2 R4-P2-002:P2 R4-P2-003:P2\ndimCoverage {\"correctness\":true,\"security\":true,\"traceability\":true,\"maintainability\":true}\n=== closeout usage ===\n43:  '--mode': 'mode',\n44:  '--event-dir': 'eventDir',\n45:  '--artifact-dir': 'artifactDir',\n46:  '--state-log': 'stateLog',\n47:  '--registry': 'registry',\n48:  '--output': 'output',\n49:  '--dashboard': 'dashboard',\n50:  '--stop-reason': 'stopReason',\n51:  '--answered-count': 'answeredCount',\n52:  '--total-questions': 'totalQuestions',\n53:  '--active-p0': 'activeP0',\n54:  '--active-p1': 'activeP1',\n55:  '--active-p2': 'activeP2',\n56:  '--dimension-coverage': 'dimensionCoverage',\n57:  '--verdict': 'verdict',\n58:  '--release-readiness-state': 'releaseReadinessState',\n62:  ['eventDir', '--event-dir'],\n63:  ['artifactDir', '--artifact-dir'],\n64:  ['stateLog', '--state-log'],\n65:  ['registry', '--registry'],\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"cd /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research && ART=specs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/review/lineages/render-hooks-plugin && node -e 'const r=JSON.parse(require(\\\"fs\\\").readFileSync(process.argv[1]+\\\"/deep-review-findings-registry.json\\\",\\\"utf8\\\"));console.log(\\\"bySeverity\\\",JSON.stringify(r.findingsBySeverity));console.log(\\\"open\\\",r.openFindingsCount,\\\"resolved\\\",r.resolvedFindingsCount);console.log(r.openFindings.map(f=>f.findingId+\\\":\\\"+f.severity).join(\\\" \\\"));console.log(\\\"dimCoverage\\\",JSON.stringify(r.dimensionCoverage));' \\\"$ART\\\"; echo \\\"=== closeout usage ===\\\"; grep -n \\\"argv\\\\|--\\\\w*\\\" .skilled/skills/system-deep-loop/runtime/scripts/synthesis-closeout.cjs | head -20\"}"},"time":{"start":1794551635152,"end":1794551636409}}}}
