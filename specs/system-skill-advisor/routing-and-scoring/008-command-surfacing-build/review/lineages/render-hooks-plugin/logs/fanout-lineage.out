{"type":"tool_use","timestamp":1794550484094,"sessionID":"ses_e2c799690ffeJQrMJ5OzboPGaV","part":{"partID":"prt_1d38b4840001UF1lQV0iXYJRyq","sessionID":"ses_e2c799690ffeJQrMJ5OzboPGaV","messageID":"msg_1d38ae783001Kmz7wph0KBUxeD","type":"tool","id":"call_3073c781bd3546a8a55f0158","tool":"shell","state":{"status":"completed","input":{"command":"cd /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research && sed -n '1,80p' .opencode/plugins/system-skill-advisor.js && echo \"...[SNIP]...\" && grep -n \"function \\|const .* = (\\|=> {$\\|session-readers\\|readSession\\|loadSession\\|fallback\\|budget\\|mutat\\|holdout\\|command\" .opencode/plugins/system-skill-advisor.js | head -120"},"output":"// ╔══════════════════════════════════════════════════════════════════════════╗\n// ║ COMPONENT: Skill Advisor OpenCode Plugin (system-skill-advisor)              ║\n// ╠══════════════════════════════════════════════════════════════════════════╣\n// ║ PURPOSE: Inject skill advisor brief into OpenCode model context per      ║\n// ║          prompt; expose status tool; manage per-instance state,          ║\n// ║          in-flight dedup, and bounded prompt/brief/cache sizes.           ║\n// ╚══════════════════════════════════════════════════════════════════════════╝\n'use strict';\n\n// ─────────────────────────────────────────────────────────────────────────────\n// 1. IMPORTS\n// ─────────────────────────────────────────────────────────────────────────────\n\nimport { createHash } from 'node:crypto';\nimport { spawn } from 'node:child_process';\nimport { existsSync, readFileSync, readdirSync, realpathSync, statSync } from 'node:fs';\nimport { resolve as resolvePath } from 'node:path';\nimport { readFile } from 'node:fs/promises';\nimport { homedir } from 'node:os';\nimport { dirname, join, sep } from 'node:path';\nimport { fileURLToPath } from 'node:url';\nimport { createRequire } from 'node:module';\n\nimport { tool } from './lib/tool-identity.js';\nimport { dualPlugin } from './lib/v2-bridge.js';\n\nimport * as messageIdentity from './lib/opencode-message-identity.js';\nimport {\n  FALLBACK_DIRECTIVE,\n  SETUP_WORDING,\n  renderCompiledRouteSummaryLine,\n  renderPluginFallbackDirective,\n} from './lib/skill-advisor-render.js';\nimport { findRepoRoot, findSourceRoot } from '../skills/system-spec-kit/runtime/hooks/lib/workspace/repo-root.mjs';\n\n// ─────────────────────────────────────────────────────────────────────────────\n// 2. CONSTANTS\n// ─────────────────────────────────────────────────────────────────────────────\n\nconst PLUGIN_ID = 'system-skill-advisor';\nconst DEFAULT_CACHE_TTL_MS = 5 * 60 * 1000;\nconst DEFAULT_THRESHOLD_CONFIDENCE = 0.8;\n// Mirrors the compat contract's uncertainty ceiling. The CLI request and the\n// brief render must carry the same bound, or a recommendation can pass one and\n// fail the other.\nconst DEFAULT_THRESHOLD_UNCERTAINTY = 0.35;\nconst DEFAULT_MAX_TOKENS = 80;\nconst AMBIGUOUS_TOKEN_CAP = 120;\nconst DEFAULT_BRIDGE_TIMEOUT_MS = 2500;\nconst OBSERVED_ADVISOR_POLICY_CANDIDATE = '004';\nconst DEFAULT_NODE_BINARY = 'node';\nconst DEFAULT_MAX_PROMPT_BYTES = 64 * 1024;\n// advisor_recommend refuses a longer prompt, so a longer one is sent as its head\n// rather than refused and reported as an outage.\nconst ADVISOR_PROMPT_MAX_CHARS = 10_000;\nconst DEFAULT_MAX_BRIEF_CHARS = 2 * 1024;\nconst DEFAULT_MAX_CACHE_ENTRIES = 1000;\nconst MAX_BRIDGE_STDOUT_BYTES = 256 * 1024;\n// Unique prompts each need their own advisor child, so a burst must not multiply\n// live processes without limit.\nconst MAX_CONCURRENT_ADVISOR_RUNS = 2;\nconst BRIDGE_TERMINATION_GRACE_MS = 250;\nconst COMPILED_ROUTE_BOUNDING_ENV = 'SYSTEM_SKILL_ADVISOR_COMPILED_ROUTE_BOUNDING';\nconst DISABLED_ENV = 'SYSTEM_SKILL_ADVISOR_HOOK_DISABLED';\nconst DISABLED_ENV_PLUGIN = 'SYSTEM_SKILL_ADVISOR_PLUGIN_DISABLED';\nconst LEGACY_HOOK_DISABLED_ENV = 'SPECKIT_SKILL_ADVISOR_HOOK_DISABLED';\nconst LEGACY_PLUGIN_DISABLED_ENV = 'SPECKIT_SKILL_ADVISOR_PLUGIN_DISABLED';\n\n// Directive-lifecycle dedup: this plugin is a plain-JS mirror of the canonical\n// rule in hooks/lib/directive-lifecycle.ts (same separator, same fail-open\n// semantics). Deliver the full brief on the first message of a session and\n// after every lifecycle boundary; on a same-content repeat keep the dynamic\n// Advisor: route line and drop the constant directive block. The canonical\n// copy stays in directive-lifecycle.ts; when that module gains a compiled\n// dist, prefer importing it over extending this mirror.\nconst DIRECTIVE_LIFECYCLE_DEDUP_ENV = 'SPECKIT_DIRECTIVE_LIFECYCLE_DEDUP';\nconst DIRECTIVE_SEPARATOR = '\\nDirectives:';\nconst MAX_DIRECTIVE_DEDUP_SESSIONS = 64;\nconst pluginRequire = createRequire(import.meta.url);\nconst { isHookEnabled } = pluginRequire('../hooks/shared/hook-flags.cjs');\n...[SNIP]...\n85:function resolveCompiledRouteStatusModule() {\n99:function compiledRoutingStatusLines() {\n124:function compiledServingSignature() {\n163:function loadShadowRenderer() {\n168:async function loadConfig() {\n195:function normalizePositiveInt(value, fallback) {\n196:  return Number.isFinite(value) && value > 0 ? Math.trunc(value) : fallback;\n199:function normalizeThreshold(value) {\n206:function envDisablesPlugin() {\n210:function isDirectiveLifecycleDedupEnabled() {\n215:function splitDirectiveBrief(context) {\n223:function decideOpenCodeDirectiveLifecycle(brief, identity, lifecycleEvent, state) {\n257:function disabledEnvName() {\n279:function fileDigest(sourcePath, stat) {\n299:function addFileSignature(hash, label, sourcePath) {\n321:function advisorSourceSignature(workspaceRoot) {\n365:function normalizeOptions(rawOptions) {\n409:function sessionIdFrom(input) {\n422:function directiveSessionIdentityFrom(input) {\n452:function advanceOpenCodeDirectiveBoundary(state, input) {\n466:function stableStringify(value) {\n481:function normalizeSessionID(value) {\n491:function normalizeWorkspaceRoot(workspaceRoot) {\n498:function statusSafeBinary(binary) {\n505:function cacheKeyForPrompt(prompt, options, sessionID, sourceSignature, workspaceRoot, servingSignature) {\n523:function extractPrompt(input) {\n558:function cliRecommendations(data, options) {\n578:        // The renderer prints a command, its policy and its owner only from these\n579:        // fields. A skill row such as sk-doc has no generated command row to refill\n580:        // them, so a dropped field hides the command the advisor attached.\n581:        ...(typeof recommendation.command === 'string' && recommendation.command.trim() !== '' ? { command: recommendation.command } : {}),\n592:function compiledRouteSummary(data) {\n614:async function parseCliResponse(stdout, options) {\n686:function clampBrief(brief, maxChars) {\n702:function insertWithEviction(cache, key, value, maxEntries) {\n712:function advisorCliArgs() {\n716:// Build the stdin request, or null when the byte budget cannot hold even one prompt\n723:function resolveHubSkilledRoot() {\n737:// and the hub's one fallback last. An outside block that claims the fallback role is\n738:// ignored, because the fallback is the hub's own code.\n742:function readJsonFile(file) {\n753:function surfaceEntry(block) {\n755:  const markerList = (list) => (Array.isArray(list) ? list : [])\n767:function loadPrivateSkillTarget() {\n782:function privateSkillLinkCheck(skillsDir) {\n789:function declaredSurfaces(hubRoot) {\n792:  const hub = (registry && Array.isArray(registry.modes) ? registry.modes : [])\n821:    ...hub.filter((entry) => entry.role === 'fallback'),\n828:function workspaceHasMarker(real, entry) {\n839:// adds always leads the hub's own. The fallback holds only when the resolved\n846:function detectWorkspaceSurface(projectDir) {\n856:        entry.role === 'fallback' ? insideHub : workspaceHasMarker(real, entry)\n867:function advisorCliRequest({ prompt, options, surfaceHint = null }) {\n878:  const request = (text) => JSON.stringify({ prompt: text, options: requestOptions });\n893:function eventPayloadFrom(event) {\n900:function eventTypeFrom(event) {\n905:function lifecycleEventFrom(input, eventType = null) {\n925:function rawSessionValueFrom(input) {\n933:function shadowDeliveryStateFor(input, sessionID, lifecycleEvent, deliveryConfirmed) {\n957:async function observeShadowDeliveryForRuntime(\n976:async function observeEmittedAdvisorBlock(\n998:function transformContributionDecision(input, options, blockId, content, order) {\n1021:function commitTransformContribution(decision) {\n1039:function releaseTransformContribution(decision) {\n1048:function deliverTransformContribution(decision, deliver) {\n1086:async function MkSkillAdvisorPlugin(ctx, rawOptions) {\n1123:  function acquireAdvisorRunSlot(sessionID, timeoutMs) {\n1160:      // Queue time counts against the same budget as the run, or a backlog makes\n1168:  function releaseAdvisorRunSlot() {\n1184:  function cancelAdvisorRunWaiters() {\n1192:  function cancelAdvisorRunWaitersForSession(sessionID) {\n1215:  async function runAdvisorCli({ projectDir, prompt, sessionID, options }) {\n1233:  function invokeAdvisorCli({ projectDir, prompt, options }) {\n1246:      const finish = (response) => {\n1352:  async function getAdvisorContext({ projectDir, prompt, sessionID, options }) {\n1413:  function resetRuntimeState() {\n1435:  function cacheHitRate() {\n1445:   * @param {Array<string>} [output.system] - System context entries mutated in place\n1448:  async function appendAdvisorBrief(input = {}, output = { system: [] }) {\n1521:        const fallbackDecision = transformContributionDecision(\n1528:        deliverTransformContribution(fallbackDecision, () => {\n1531:        if (fallbackDecision.shouldDeliver) {\n1544:      const fallbackResult = response.status === 'fail_open'\n1551:        : renderPluginFallbackDirective(fallbackResult, {\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"// ╔══════════════════════════════════════════════════════════════════════════╗\n// ║ COMPONENT: Skill Advisor OpenCode Plugin (system-skill-advisor)              ║\n// ╠══════════════════════════════════════════════════════════════════════════╣\n// ║ PURPOSE: Inject skill advisor brief into OpenCode model context per      ║\n// ║          prompt; expose status tool; manage per-instance state,          ║\n// ║          in-flight dedup, and bounded prompt/brief/cache sizes.           ║\n// ╚══════════════════════════════════════════════════════════════════════════╝\n'use strict';\n\n// ─────────────────────────────────────────────────────────────────────────────\n// 1. IMPORTS\n// ─────────────────────────────────────────────────────────────────────────────\n\nimport { createHash } from 'node:crypto';\nimport { spawn } from 'node:child_process';\nimport { existsSync, readFileSync, readdirSync, realpathSync, statSync } from 'node:fs';\nimport { resolve as resolvePath } from 'node:path';\nimport { readFile } from 'node:fs/promises';\nimport { homedir } from 'node:os';\nimport { dirname, join, sep } from 'node:path';\nimport { fileURLToPath } from 'node:url';\nimport { createRequire } from 'node:module';\n\nimport { tool } from './lib/tool-identity.js';\nimport { dualPlugin } from './lib/v2-bridge.js';\n\nimport * as messageIdentity from './lib/opencode-message-identity.js';\nimport {\n  FALLBACK_DIRECTIVE,\n  SETUP_WORDING,\n  renderCompiledRouteSummaryLine,\n  renderPluginFallbackDirective,\n} from './lib/skill-advisor-render.js';\nimport { findRepoRoot, findSourceRoot } from '../skills/system-spec-kit/runtime/hooks/lib/workspace/repo-root.mjs';\n\n// ─────────────────────────────────────────────────────────────────────────────\n// 2. CONSTANTS\n// ─────────────────────────────────────────────────────────────────────────────\n\nconst PLUGIN_ID = 'system-skill-advisor';\nconst DEFAULT_CACHE_TTL_MS = 5 * 60 * 1000;\nconst DEFAULT_THRESHOLD_CONFIDENCE = 0.8;\n// Mirrors the compat contract's uncertainty ceiling. The CLI request and the\n// brief render must carry the same bound, or a recommendation can pass one and\n// fail the other.\nconst DEFAULT_THRESHOLD_UNCERTAINTY = 0.35;\nconst DEFAULT_MAX_TOKENS = 80;\nconst AMBIGUOUS_TOKEN_CAP = 120;\nconst DEFAULT_BRIDGE_TIMEOUT_MS = 2500;\nconst OBSERVED_ADVISOR_POLICY_CANDIDATE = '004';\nconst DEFAULT_NODE_BINARY = 'node';\nconst DEFAULT_MAX_PROMPT_BYTES = 64 * 1024;\n// advisor_recommend refuses a longer prompt, so a longer one is sent as its head\n// rather than refused and reported as an outage.\nconst ADVISOR_PROMPT_MAX_CHARS = 10_000;\nconst DEFAULT_MAX_BRIEF_CHARS = 2 * 1024;\nconst DEFAULT_MAX_CACHE_ENTRIES = 1000;\nconst MAX_BRIDGE_STDOUT_BYTES = 256 * 1024;\n// Unique prompts each need their own advisor child, so a burst must not multiply\n// live processes without limit.\nconst MAX_CONCURRENT_ADVISOR_RUNS = 2;\nconst BRIDGE_TERMINATION_GRACE_MS = 250;\nconst COMPILED_ROUTE_BOUNDING_ENV = 'SYSTEM_SKILL_ADVISOR_COMPILED_ROUTE_BOUNDING';\nconst DISABLED_ENV = 'SYSTEM_SKILL_ADVISOR_HOOK_DISABLED';\nconst DISABLED_ENV_PLUGIN = 'SYSTEM_SKILL_ADVISOR_PLUGIN_DISABLED';\nconst LEGACY_HOOK_DISABLED_ENV = 'SPECKIT_SKILL_ADVISOR_HOOK_DISABLED';\nconst LEGACY_PLUGIN_DISABLED_ENV = 'SPECKIT_SKILL_ADVISOR_PLUGIN_DISABLED';\n\n// Directive-lifecycle dedup: this plugin is a plain-JS mirror of the canonical\n// rule in hooks/lib/directive-lifecycle.ts (same separator, same fail-open\n// semantics). Deliver the full brief on the first message of a session and\n// after every lifecycle boundary; on a same-content repeat keep the dynamic\n// Advisor: route line and drop the constant directive block. The canonical\n// copy stays in directive-lifecycle.ts; when that module gains a compiled\n// dist, prefer importing it over extending this mirror.\nconst DIRECTIVE_LIFECYCLE_DEDUP_ENV = 'SPECKIT_DIRECTIVE_LIFECYCLE_DEDUP';\nconst DIRECTIVE_SEPARATOR = '\\nDirectives:';\nconst MAX_DIRECTIVE_DEDUP_SESSIONS = 64;\nconst pluginRequire = createRequire(import.meta.url);\nconst { isHookEnabled } = pluginRequire('../hooks/shared/hook-flags.cjs');\n...[SNIP]...\n85:function resolveCompiledRouteStatusModule() {\n99:function compiledRoutingStatusLines() {\n124:function compiledServingSignature() {\n163:function loadShadowRenderer() {\n168:async function loadConfig() {\n195:function normalizePositiveInt(value, fallback) {\n196:  return Number.isFinite(value) && value > 0 ? Math.trunc(value) : fallback;\n199:function normalizeThreshold(value) {\n206:function envDisablesPlugin() {\n210:function isDirectiveLifecycleDedupEnabled() {\n215:function splitDirectiveBrief(context) {\n223:function decideOpenCodeDirectiveLifecycle(brief, identity, lifecycleEvent, state) {\n257:function disabledEnvName() {\n279:function fileDigest(sourcePath, stat) {\n299:function addFileSignature(hash, label, sourcePath) {\n321:function advisorSourceSignature(workspaceRoot) {\n365:function normalizeOptions(rawOptions) {\n409:function sessionIdFrom(input) {\n422:function directiveSessionIdentityFrom(input) {\n452:function advanceOpenCodeDirectiveBoundary(state, input) {\n466:function stableStringify(value) {\n481:function normalizeSessionID(value) {\n491:function normalizeWorkspaceRoot(workspaceRoot) {\n498:function statusSafeBinary(binary) {\n505:function cacheKeyForPrompt(prompt, options, sessionID, sourceSignature, workspaceRoot, servingSignature) {\n523:function extractPrompt(input) {\n558:function cliRecommendations(data, options) {\n578:        // The renderer prints a command, its policy and its owner only from these\n579:        // fields. A skill row such as sk-doc has no generated command row to refill\n580:        // them, so a dropped field hides the command the advisor attached.\n581:        ...(typeof recommendation.command === 'string' && recommendation.command.trim() !== '' ? { command: recommendation.command } : {}),\n592:function compiledRouteSummary(data) {\n614:async function parseCliResponse(stdout, options) {\n686:function clampBrief(brief, maxChars) {\n702:function insertWithEviction(cache, key, value, maxEntries) {\n712:function advisorCliArgs() {\n716:// Build the stdin request, or null when the byte budget cannot hold even one prompt\n723:function resolveHubSkilledRoot() {\n737:// and the hub's one fallback last. An outside block that claims the fallback role is\n738:// ignored, because the fallback is the hub's own code.\n742:function readJsonFile(file) {\n753:function surfaceEntry(block) {\n755:  const markerList = (list) => (Array.isArray(list) ? list : [])\n767:function loadPrivateSkillTarget() {\n782:function privateSkillLinkCheck(skillsDir) {\n789:function declaredSurfaces(hubRoot) {\n792:  const hub = (registry && Array.isArray(registry.modes) ? registry.modes : [])\n821:    ...hub.filter((entry) => entry.role === 'fallback'),\n828:function workspaceHasMarker(real, entry) {\n839:// adds always leads the hub's own. The fallback holds only when the resolved\n846:function detectWorkspaceSurface(projectDir) {\n856:        entry.role === 'fallback' ? insideHub : workspaceHasMarker(real, entry)\n867:function advisorCliRequest({ prompt, options, surfaceHint = null }) {\n878:  const request = (text) => JSON.stringify({ prompt: text, options: requestOptions });\n893:function eventPayloadFrom(event) {\n900:function eventTypeFrom(event) {\n905:function lifecycleEventFrom(input, eventType = null) {\n925:function rawSessionValueFrom(input) {\n933:function shadowDeliveryStateFor(input, sessionID, lifecycleEvent, deliveryConfirmed) {\n957:async function observeShadowDeliveryForRuntime(\n976:async function observeEmittedAdvisorBlock(\n998:function transformContributionDecision(input, options, blockId, content, order) {\n1021:function commitTransformContribution(decision) {\n1039:function releaseTransformContribution(decision) {\n1048:function deliverTransformContribution(decision, deliver) {\n1086:async function MkSkillAdvisorPlugin(ctx, rawOptions) {\n1123:  function acquireAdvisorRunSlot(sessionID, timeoutMs) {\n1160:      // Queue time counts against the same budget as the run, or a backlog makes\n1168:  function releaseAdvisorRunSlot() {\n1184:  function cancelAdvisorRunWaiters() {\n1192:  function cancelAdvisorRunWaitersForSession(sessionID) {\n1215:  async function runAdvisorCli({ projectDir, prompt, sessionID, options }) {\n1233:  function invokeAdvisorCli({ projectDir, prompt, options }) {\n1246:      const finish = (response) => {\n1352:  async function getAdvisorContext({ projectDir, prompt, sessionID, options }) {\n1413:  function resetRuntimeState() {\n1435:  function cacheHitRate() {\n1445:   * @param {Array<string>} [output.system] - System context entries mutated in place\n1448:  async function appendAdvisorBrief(input = {}, output = { system: [] }) {\n1521:        const fallbackDecision = transformContributionDecision(\n1528:        deliverTransformContribution(fallbackDecision, () => {\n1531:        if (fallbackDecision.shouldDeliver) {\n1544:      const fallbackResult = response.status === 'fail_open'\n1551:        : renderPluginFallbackDirective(fallbackResult, {\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"cd /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research && sed -n '1,80p' .opencode/plugins/system-skill-advisor.js && echo \\\"...[SNIP]...\\\" && grep -n \\\"function \\\\|const .* = (\\\\|=> {$\\\\|session-readers\\\\|readSession\\\\|loadSession\\\\|fallback\\\\|budget\\\\|mutat\\\\|holdout\\\\|command\\\" .opencode/plugins/system-skill-advisor.js | head -120\"}"},"time":{"start":1794550483008,"end":1794550484094}}}}
