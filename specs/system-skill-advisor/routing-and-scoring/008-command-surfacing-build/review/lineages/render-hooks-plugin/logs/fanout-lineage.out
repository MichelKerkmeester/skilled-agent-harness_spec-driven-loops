ck.ts\\\"],\\\"bugClass\\\":\\\"secret_exposure\\\",\\\"invariant\\\":\\\"The prompt never appears in argv.\\\",\\\"searchActions\\\":[{\\\"method\\\":\\\"direct_read\\\",\\\"queryOrPath\\\":\\\".skilled/skills/system-skill-advisor/hooks/lib/skill-advisor-cli-fallback.ts\\\",\\\"result\\\":\\\"payload is written to stdin; argv carries only flags\\\",\\\"evidenceRefs\\\":[\\\".skilled/skills/system-skill-advisor/hooks/lib/skill-advisor-cli-fallback.ts:277\\\"]}],\\\"disposition\\\":\\\"ruled_out\\\",\\\"rationale\\\":\\\"Stdin delivery verified in code and comment.\\\",\\\"ruledOutReason\\\":\\\"No prompt text enters argv.\\\"}],\\\"graphEvents\\\":[{\\\"type\\\":\\\"node\\\",\\\"id\\\":\\\"dim-security\\\",\\\"kind\\\":\\\"DIMENSION\\\",\\\"label\\\":\\\"Security\\\"},{\\\"type\\\":\\\"node\\\",\\\"id\\\":\\\"R2-P1-001\\\",\\\"kind\\\":\\\"FINDING\\\",\\\"label\\\":\\\"Child downgrade keyed on process env\\\"},{\\\"type\\\":\\\"node\\\",\\\"id\\\":\\\"R2-P2-002\\\",\\\"kind\\\":\\\"FINDING\\\",\\\"label\\\":\\\"Unbounded advisor stdout\\\"},{\\\"type\\\":\\\"node\\\",\\\"id\\\":\\\"R2-P2-003\\\",\\\"kind\\\":\\\"FINDING\\\",\\\"label\\\":\\\"Mutability read from skill row\\\"},{\\\"type\\\":\\\"edge\\\",\\\"id\\\":\\\"e-r2-1\\\",\\\"source\\\":\\\"R2-P1-001\\\",\\\"target\\\":\\\"file-render-runtime\\\",\\\"relation\\\":\\\"IN_FILE\\\"},{\\\"type\\\":\\\"edge\\\",\\\"id\\\":\\\"e-r2-2\\\",\\\"source\\\":\\\"R2-P2-002\\\",\\\"target\\\":\\\"dim-security\\\",\\\"relation\\\":\\\"IN_DIMENSION\\\"},{\\\"type\\\":\\\"edge\\\",\\\"id\\\":\\\"e-r2-3\\\",\\\"source\\\":\\\"R2-P2-003\\\",\\\"target\\\":\\\"file-render-runtime\\\",\\\"relation\\\":\\\"IN_FILE\\\"},{\\\"type\\\":\\\"edge\\\",\\\"id\\\":\\\"e-r2-dim\\\",\\\"source\\\":\\\"file-render-runtime\\\",\\\"target\\\":\\\"dim-security\\\",\\\"relation\\\":\\\"IN_DIMENSION\\\"}]}\\nJSON\\nnode -e 'JSON.parse(require(\\\"fs\\\").readFileSync(process.argv[1],\\\"utf8\\\"));console.log(\\\"JSON_OK\\\")' \\\"$EVENT_FILE\\\" && node .skilled/skills/system-deep-loop/runtime/scripts/append-mode-event.cjs --mode review --run-directory \\\"$ART\\\" --event-json \\\"$EVENT_FILE\\\"; echo \\\"GATEWAY_EXIT=$?\\\"; rm -f \\\"$EVENT_FILE\\\"\"}"},"time":{"start":1794551052170,"end":1794551069786}}}}
