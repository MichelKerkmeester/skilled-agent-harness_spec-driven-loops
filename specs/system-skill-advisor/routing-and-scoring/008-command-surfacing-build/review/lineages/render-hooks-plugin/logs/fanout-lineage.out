ngs.push(finding);\n1122:  resolvedFindings.sort(compareFindings);\n1124:  return { openFindings, resolvedFindings };\n1393:      pass: statuses.filter((status) => status === 'pass').length,\n1394:      partial: statuses.filter((status) => status === 'partial').length,\n1395:      fail: statuses.filter((status) => status === 'fail').length,\n1396:      blocked: statuses.filter((status) => status === 'blocked').length,\n1397:      notApplicable: statuses.filter((status) => status === 'not_applicable').length,\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"811:// resolvedFindings names the ids the state closed at a run; a finding resolved\n813:function resolvedIdsSeenByRun(records, run) {\n814:  const resolvedIds = new Set();\n819:    const resolvedRun = getIterationRun(record);\n820:    if (!isFiniteNumber(resolvedRun) || resolvedRun > run) {\n823:    for (const id of Array.isArray(record.resolvedFindings) ? record.resolvedFindings : []) {\n824:      resolvedIds.add(id);\n827:  return resolvedIds;\n830:function countFindingsActiveByRun(findingById, run, resolvedIds) {\n836:    if (finding.firstSeen <= run && !resolvedIds.has(finding.findingId)) {\n1080:      ? countFindingsActiveByRun(findingById, run, resolvedIdsSeenByRun(mergedRecords, run))\n1094:  const resolvedIdSet = new Set();\n1096:    if (Array.isArray(record.resolvedFindings)) {\n1097:      for (const id of record.resolvedFindings) {\n1098:        resolvedIdSet.add(id);\n1103:  // Deduplicate restatements before splitting open and resolved findings.\n1107:  const resolvedFindings = [];\n1109:    // A collapsed finding is resolved only when its canonical id and every\n1110:    // merged id are resolved, so a duplicate that lingers keeps the entry open.\n1112:    const resolved = allIds.length > 0 && allIds.every((id) => resolvedIdSet.has(id));\n1113:    if (resolved) {\n1114:      finding.status = 'resolved';\n1115:      resolvedFindings.push(finding);\n1122:  resolvedFindings.sort(compareFindings);\n1124:  return { openFindings, resolvedFindings };\n1393:      pass: statuses.filter((status) => status === 'pass').length,\n1394:      partial: statuses.filter((status) => status === 'partial').length,\n1395:      fail: statuses.filter((status) => status === 'fail').length,\n1396:      blocked: statuses.filter((status) => status === 'blocked').length,\n1397:      notApplicable: statuses.filter((status) => status === 'not_applicable').length,\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"cd /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research && grep -n \\\"case \\\\\\\"\\\\|=== \\\\\\\"finding\\\\\\\"\\\\|=== \\\\\\\"resolution\\\\\\\"\\\\|=== \\\\\\\"classification\\\\\\\"\\\\|resolved\\\\|status ===\\\" .skilled/skills/system-deep-loop/runtime/scripts/reduce-state.cjs | head -30\"}"},"time":{"start":1794551511171,"end":1794551512069}}}}
