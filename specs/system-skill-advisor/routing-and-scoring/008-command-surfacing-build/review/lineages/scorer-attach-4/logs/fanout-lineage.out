e fields so registry consumers do not need to\n663-    // re-open raw delta files for scope and surface hints.\n664-    scopeProof: typeof record.scopeProof === 'string' ? record.scopeProof : null,\n665-    affectedSurfaceHints: asStringList(record.affectedSurfaceHints),\n666-    // Content hashes let the registry collapse repeated findings across review\n667-    // dimensions; legacy records remain valid without one.\n668-    contentHash: typeof record.content_hash === 'string' && record.content_hash\n669-      ? record.content_hash\n670-      : (typeof record.contentHash === 'string' && record.contentHash ? record.contentHash : null),\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"625:function deltaRecordToFinding(record) {\n626-  // The producer keys the row `id` or `findingId`; either names the same finding.\n627-  const id = record ? record.id || record.findingId : null;\n628-  if (!record || record.type !== 'finding' || !id) {\n629-    return null;\n630-  }\n631-  const file = typeof record.file === 'string' ? record.file : null;\n632-  let fileBase = null;\n633-  let lineNumber = null;\n634-  if (file) {\n635-    const m = file.match(/^(.+?):(\\d+)(?:[:-].*)?$/);\n636-    if (m) {\n637-      fileBase = m[1];\n638-      lineNumber = Number(m[2]);\n639-    } else {\n640-      fileBase = file;\n641-    }\n642-  }\n643-  // Prefer finalSeverity (post-adjudication) over initial severity.\n644-  const rawSeverity = record.finalSeverity || record.severity;\n645-  const severity = normalizeSeverity(rawSeverity);\n646-  if (!severity) {\n647-    return null;\n648-  }\n649-  // Description: claim is most informative; fall back to recommendation/evidence.\n650-  const description = normalizeText(\n651-    record.claim || record.recommendation || record.alternativeExplanation || '',\n652-  );\n653-  return {\n654-    findingId: id,\n655-    severity,\n656-    title: normalizeText(record.title || ''),\n657-    file: fileBase,\n658-    line: lineNumber,\n659-    description,\n660-    findingClass: record.findingClass || null,\n661-    deltaStatus: record.status || null,\n662-    // Preserve structured evidence fields so registry consumers do not need to\n663-    // re-open raw delta files for scope and surface hints.\n664-    scopeProof: typeof record.scopeProof === 'string' ? record.scopeProof : null,\n665-    affectedSurfaceHints: asStringList(record.affectedSurfaceHints),\n666-    // Content hashes let the registry collapse repeated findings across review\n667-    // dimensions; legacy records remain valid without one.\n668-    contentHash: typeof record.content_hash === 'string' && record.content_hash\n669-      ? record.content_hash\n670-      : (typeof record.contentHash === 'string' && record.contentHash ? record.contentHash : null),\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\": \"cd /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research && grep -n \\\"function deltaRecordToFinding\\\" -A45 .skilled/skills/system-deep-loop/runtime/scripts/reduce-state.cjs\"}"},"time":{"start":1794670540550,"end":1794670540726}}}}
