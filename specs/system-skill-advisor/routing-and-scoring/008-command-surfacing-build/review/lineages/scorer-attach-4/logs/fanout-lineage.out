{"type":"tool_use","timestamp":1794669509248,"sessionID":"ses_e255ff46fffexTncZnylD3HfiJ","part":{"partID":"prt_1daa3798f002MQByyVEQu972SG","sessionID":"ses_e255ff46fffexTncZnylD3HfiJ","messageID":"msg_1daa35da4001iiHbL1qfiNhbMe","type":"tool","id":"call_00_qxlfh5m02bsviwm05jws4ksr","tool":"shell","state":{"status":"completed","input":{"command":"git -C /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research diff 0cdc9fa3ef -- .skilled/skills/system-skill-advisor/runtime/tests/command-attach-guards.vitest.ts .skilled/skills/system-skill-advisor/runtime/tests/command-meaning-anchor.vitest.ts .skilled/skills/system-skill-advisor/runtime/tests/doctor-helper-handoff.vitest.ts .skilled/skills/system-skill-advisor/runtime/tests/handlers/advisor-recommend-compiled-route-option.vitest.ts .skilled/skills/system-skill-advisor/runtime/tests/scorer/doctor-handoff-command.vitest.ts .skilled/skills/system-skill-advisor/runtime/tests/scorer/typed-command-owner.vitest.ts"},"output":"diff --git a/.skilled/skills/system-skill-advisor/runtime/tests/command-attach-guards.vitest.ts b/.skilled/skills/system-skill-advisor/runtime/tests/command-attach-guards.vitest.ts\nindex 440a6db96d..7fda21d4b2 100644\n--- a/.skilled/skills/system-skill-advisor/runtime/tests/command-attach-guards.vitest.ts\n+++ b/.skilled/skills/system-skill-advisor/runtime/tests/command-attach-guards.vitest.ts\n@@ -13,7 +13,9 @@ import { describe, expect, it } from 'vitest';\n \n import {\n   attachCommand,\n+  commandOnlyMentioned,\n   isNoEditRequest,\n+  MODE_COMMANDS,\n   NO_EDIT_REQUEST,\n   typedCommandForTop,\n   typedCommandIn,\n@@ -34,6 +36,42 @@ const NOEDIT4 = [\n   'make no changes',\n ];\n \n+// The prompts that name a command to refuse it or ask about it, the prompts that\n+// ask for the command, and the prompts that hold a refusal or question word and\n+// still ask for the command.\n+const REFUSE8: ReadonlyArray<readonly [string, string]> = [\n+  ['do not run /speckit:complete yet, just explain what it does', '/speckit:complete'],\n+  ['I never want to use /create:agent again, delete the agent file', '/create:agent'],\n+  ['someone ran /speckit:save by accident, how do I undo what it wrote', '/speckit:save'],\n+  ['please do not start /deep:research, I only want a two line summary of the readme', '/deep:research'],\n+  ['what does /create:readme do?', '/create:readme'],\n+  ['do not run it, just tell me what /doctor:update would change', '/doctor:update'],\n+  ['explain /deep:review to me', '/deep:review'],\n+  ['skip /create:readme, just append one line to the existing README', '/create:readme'],\n+];\n+\n+const QUESTION2: ReadonlyArray<readonly [string, string]> = [\n+  ['is /speckit:complete overkill for a two line fix?', '/speckit:complete'],\n+  ['should I use /deep:research for this or just read the two files myself?', '/deep:research'],\n+];\n+\n+const REQUEST6: ReadonlyArray<readonly [string, string]> = [\n+  ['run /speckit:complete for the rate limiter', '/speckit:complete'],\n+  ['/create:agent security-reviewer', '/create:agent'],\n+  [\"don't forget to run /speckit:save\", '/speckit:save'],\n+  ['explain the diff then run /speckit:save', '/speckit:save'],\n+  ['use /speckit:plan, not /speckit:complete', '/speckit:plan'],\n+  ['I ran /speckit:plan yesterday, now run /speckit:implement', '/speckit:implement'],\n+];\n+\n+const CONTROL5: ReadonlyArray<readonly [string, string]> = [\n+  ['dont guess, run /speckit:plan', '/speckit:plan'],\n+  ['never mind just run /speckit:save', '/speckit:save'],\n+  ['not sure, use /create:readme', '/create:readme'],\n+  ['without asking, run /speckit:complete', '/speckit:complete'],\n+  ['can you run /speckit:plan?', '/speckit:plan'],\n+];\n+\n describe('command attach on a no-edit prompt', () => {\n   it('offers no hub command when the prompt rules out a change', () => {\n     const prompt = 'use sk-doc to create a skill called invoice-parser, do not change anything yet';\n@@ -97,6 +135,222 @@ describe('command attach on a no-edit prompt', () => {\n   });\n });\n \n+describe('a command the prompt only mentions', () => {\n+  it.each(REFUSE8)('reads %s as a mention of %s', (prompt, command) => {\n+    expect(commandOnlyMentioned(prompt, command)).toBe(true);\n+  });\n+\n+  it.each(QUESTION2)('reads the question %s as a mention of %s', (prompt, command) => {\n+    expect(commandOnlyMentioned(prompt, command)).toBe(true);\n+  });\n+\n+  it.each(REQUEST6)('reads %s as a request for %s', (prompt, command) => {\n+    expect(commandOnlyMentioned(prompt, command)).toBe(false);\n+  });\n+\n+  it.each(CONTROL5)('reads %s as a request for %s beside a refusal word', (prompt, command) => {\n+    expect(commandOnlyMentioned(prompt, command)).toBe(false);\n+  });\n+\n+  // A bare lead opens a statement as often as a question, so it marks a mention\n+  // only before a question. One led occurrence does not make a request either\n+  // when a later occurrence of the same command is not led.\n+  it.each([\n+    ['the next step is /speckit:implement', '/speckit:implement'],\n+    ['is this right? run /speckit:plan', '/speckit:plan'],\n+    ['the next step is /speckit:implement\\nany questions?', '/speckit:implement'],\n+    ['what does /speckit:save do? ok now run /speckit:save', '/speckit:save'],\n+    ['the plan is /speckit:plan then tests', '/speckit:plan'],\n+  ])('reads %s as a request for %s', (prompt, command) => {\n+    expect(commandOnlyMentioned(prompt, command)).toBe(false);\n+  });\n+\n+  // A chat question often leaves the question mark off, so a bare ask word that\n+  // opens a sentence still marks the command as the subject.\n+  it.each([\n+    ['is /speckit:resume safe to run twice', '/speckit:resume'],\n+    ['does /doctor:git change files or just report problems', '/doctor:git'],\n+    ['can /prompt:improve make a vague request easier to follow', '/prompt:improve'],\n+    ['ok. is /speckit:plan enough here', '/speckit:plan'],\n+    ['quick question? is /speckit:resume safe to run twice', '/speckit:resume'],\n+  ])('reads %s as a question about %s', (prompt, command) => {\n+    expect(commandOnlyMentioned(prompt, command)).toBe(true);\n+  });\n+\n+  it('reads each command of a two-command prompt on its own', () => {\n+    expect(commandOnlyMentioned('use /speckit:plan, not /speckit:complete', '/speckit:complete')).toBe(true);\n+  });\n+\n+  it('reads a curly apostrophe as a straight one', () => {\n+    expect(commandOnlyMentioned('don\\u2019t run /speckit:save', '/speckit:save')).toBe(true);\n+  });\n+\n+  it('reads no need to run as a refusal of the command', () => {\n+    expect(commandOnlyMentioned('no need to run /doctor:setup, the hooks are fine', '/doctor:setup')).toBe(true);\n+  });\n+\n+  it('still reads a request after no need to ask', () => {\n+    expect(commandOnlyMentioned('no need to ask, run /speckit:save', '/speckit:save')).toBe(false);\n+  });\n+\n+  it('reads stop using as a refusal of the command', () => {\n+    expect(commandOnlyMentioned('stop using /create:changelog for this, write the changelog entry by hand', '/create:changelog')).toBe(true);\n+  });\n+\n+  it('still reads a request after stop and', () => {\n+    expect(commandOnlyMentioned('stop and run /speckit:plan', '/speckit:plan')).toBe(false);\n+  });\n+\n+  it('reads why not use as a request for the command', () => {\n+    expect(commandOnlyMentioned('why not use /create:agent for this? go ahead and make a security reviewer agent', '/create:agent')).toBe(false);\n+  });\n+\n+  it.each([\n+    ['I have not run /speckit:plan yet, please start it for the login feature', '/speckit:plan'],\n+    ['I already ran /create:readme but the output was wrong, run it again for the hooks folder', '/create:readme'],\n+    ['not run /speckit:plan yet, write notes to /tmp/notes.md, then run it', '/speckit:plan'],\n+    ['not run /speckit:plan yet, read https://example.com/spec first, then run it', '/speckit:plan'],\n+  ])('reads %s as a request for %s made by a later clause', (prompt, command) => {\n+    expect(commandOnlyMentioned(prompt, command)).toBe(false);\n+  });\n+\n+  it.each([\n+    ['do not run /speckit:complete, I will run it myself later', '/speckit:complete'],\n+    ['do not use /create:agent, use that other one', '/create:agent'],\n+    ['do not run /speckit:complete, run /speckit:plan for the rate limiter instead', '/speckit:complete'],\n+    ['do not run /speckit:complete, run /speckit:plan, then run it for the auth module', '/speckit:complete'],\n+  ])('still reads %s as a mention of %s', (prompt, command) => {\n+    expect(commandOnlyMentioned(prompt, command)).toBe(true);\n+  });\n+\n+  it('does not read a longer command name as the shorter one', () => {\n+    expect(commandOnlyMentioned('do not run /create:sk-skill-parent', '/create:sk-skill')).toBe(false);\n+  });\n+\n+  it.each([\n+    'what does /create:readme do?',\n+    'skip /create:readme, just append one line to the existing README',\n+  ])('offers no hub command for %s', (prompt) => {\n+    expect(attachCommand('sk-doc', SINGLE('sk-create-readme'), prompt)).toBeUndefined();\n+  });\n+\n+  it('offers no deep-loop command the prompt refuses', () => {\n+    const deepLoopModes = MODE_COMMANDS['system-deep-loop'];\n+    const mode = Object.keys(deepLoopModes).find((key) => deepLoopModes[key] === '/deep:research');\n+    expect(mode, 'the generated table names the research mode').toBeDefined();\n+    expect(attachCommand('system-deep-loop', SINGLE(mode!), 'please do not start /deep:research, I only want a two line summary of the readme')).toBeUndefined();\n+  });\n+\n+  it('still offers the hub command a plain request routes to', () => {\n+    expect(attachCommand('sk-doc', SINGLE('sk-create-readme'), 'write a readme for the doctor scripts folder')).toBe('/create:readme');\n+  });\n+});\n+\n+describe('command attach on a small edit', () => {\n+  it.each([\n+    'update the README typo in line 3',\n+    'fix the typo in the README',\n+    'correct the spelling in the hooks readme',\n+    'fix the broken link in the install guide readme',\n+  ])('offers no creation command for %s', (prompt) => {\n+    expect(attachCommand('sk-doc', SINGLE('sk-create-readme'), prompt)).toBeUndefined();\n+  });\n+\n+  it.each([\n+    'write a readme for the doctor scripts folder',\n+    'create a readme for the payments module, check it for typos when done',\n+  ])('still offers the creation command for %s', (prompt) => {\n+    expect(attachCommand('sk-doc', SINGLE('sk-create-readme'), prompt)).toBe('/create:readme');\n+  });\n+\n+  it.each([\n+    ['sk-doc', 'sk-create-agent', 'build an agent that fixes typos in our docs'],\n+    ['sk-doc', 'sk-create-readme', 'writing a readme for the grammar module'],\n+    ['sk-doc', 'sk-create-readme', 'add a readme for the spelling package'],\n+    ['sk-doc', 'sk-create-changelog', 'add a changelog entry for the typo fixes in the cli help'],\n+  ])('still offers the creation command on %s %s for %s', (skill, mode, prompt) => {\n+    expect(attachCommand(skill, SINGLE(mode), prompt)).toBe(MODE_COMMANDS[skill][mode]);\n+  });\n+\n+  it('leaves the wording commands outside the gate', () => {\n+    const docModes = MODE_COMMANDS['sk-doc'];\n+    const mode = Object.keys(docModes).find((key) => docModes[key] === '/create:with-human-voice');\n+    expect(mode, 'the generated table names the human voice mode').toBeDefined();\n+    expect(attachCommand('sk-doc', SINGLE(mode!), 'humanize the wording in the onboarding guide')).toBe('/create:with-human-voice');\n+  });\n+\n+  it.each([\n+    ['sk-create-changelog', 'changelog for v2.1, it fixes the broken link checker and spelling errors'],\n+    ['sk-create-changelog', 'log the spelling fixes in the changelog'],\n+    ['sk-create-readme', 'document the cli in a readme, each flag gets a one line description'],\n+    ['sk-create-readme', 'readme for the spelling package'],\n+    ['sk-create-agent', 'an agent that fixes typos'],\n+  ])('keeps the creation command for %s on %s', (mode, prompt) => {\n+    expect(attachCommand('sk-doc', SINGLE(mode), prompt)).toBe(MODE_COMMANDS['sk-doc'][mode]);\n+  });\n+\n+  it('keeps the goal command when the goal is about fixes', () => {\n+    const docModes = MODE_COMMANDS['sk-doc'];\n+    const mode = Object.keys(docModes).find((key) => docModes[key] === '/create:goal');\n+    expect(mode, 'the generated table names the goal mode').toBeDefined();\n+    expect(attachCommand('sk-doc', SINGLE(mode!), 'set a goal to fix all the typos in the docs')).toBe('/create:goal');\n+  });\n+\n+  it.each([\n+    'fix the broken links in the install guide readme',\n+    'fix the dead links in the hooks readme',\n+  ])('offers no creation command for %s', (prompt) => {\n+    expect(attachCommand('sk-doc', SINGLE('sk-create-readme'), prompt)).toBeUndefined();\n+  });\n+\n+  it('leaves a command outside the create namespace alone', () => {\n+    const deepLoopModes = MODE_COMMANDS['system-deep-loop'];\n+    const mode = Object.keys(deepLoopModes).find((key) => deepLoopModes[key] === '/deep:review');\n+    expect(mode, 'the generated table names the review mode').toBeDefined();\n+    expect(attachCommand('system-deep-loop', SINGLE(mode!), 'do a thorough deep review of the typo handling')).toBe('/deep:review');\n+  });\n+\n+  it.each([\n+    ['sk-create-agent', 'an agent to fix typos'],\n+    ['sk-create-agent', 'give me an agent to fix broken links in the docs'],\n+    ['sk-create-agent', 'I want an agent to correct spelling in pull requests'],\n+  ])('keeps the creation command for %s on %s', (mode, prompt) => {\n+    expect(attachCommand('sk-doc', SINGLE(mode), prompt)).toBe(MODE_COMMANDS['sk-doc'][mode]);\n+  });\n+\n+  // A skill or a command names its own purpose, so a correction word inside that\n+  // purpose is the reason the artifact exists and not a request to edit one.\n+  it.each([\n+    ['/create:sk-skill', 'a skill to correct spelling in markdown'],\n+    ['/create:command', \"I'd like a command to fix dead links\"],\n+  ])('keeps the command %s on %s', (command, prompt) => {\n+    const docModes = MODE_COMMANDS['sk-doc'];\n+    const mode = Object.keys(docModes).find((key) => docModes[key] === command);\n+    expect(mode, 'the generated table names the ' + command + ' mode').toBeDefined();\n+    expect(attachCommand('sk-doc', SINGLE(mode!), prompt)).toBe(command);\n+  });\n+\n+  // A repo rule or a benchmark also names its purpose the way an agent does, so\n+  // the correction word belongs to what the artifact is for rather than to an\n+  // edit of a document that already exists.\n+  it.each([\n+    'I want a repo rule that says fix typos in the same commit',\n+    'repo rule: always fix typos in the same commit',\n+  ])('keeps the repo-rule command on %s', (prompt) => {\n+    const docModes = MODE_COMMANDS['sk-doc'];\n+    const mode = Object.keys(docModes).find((key) => docModes[key] === '/create:repo-rule');\n+    expect(mode, 'the generated table names the repo rule mode').toBeDefined();\n+    expect(attachCommand('sk-doc', SINGLE(mode!), prompt)).toBe('/create:repo-rule');\n+  });\n+\n+  it('keeps the benchmark command on benchmark how fast we fix typos', () => {\n+    const docModes = MODE_COMMANDS['sk-doc'];\n+    const mode = Object.keys(docModes).find((key) => docModes[key] === '/create:benchmark');\n+    expect(mode, 'the generated table names the benchmark mode').toBeDefined();\n+    expect(attachCommand('sk-doc', SINGLE(mode!), 'benchmark how fast we fix typos')).toBe('/create:benchmark');\n+  });\n+});\n+\n describe('command attach on a deep-loop prompt', () => {\n   it('withholds the review command when another deep-loop command is named', () => {\n     expect(attachCommand('system-deep-loop', SINGLE('review'), 'what did /deep:ai-council decide')).toBeUndefined();\n@@ -136,9 +390,46 @@ describe('typed command boundaries', () => {\n     expect(typedCommandIn('/create:skill-parent now')).toBe('/create:skill-parent');\n   });\n \n+  it('reads a command typed with its mode suffix', () => {\n+    expect(typedCommandIn('/deep:review:auto review the diff')).toBe('/deep:review');\n+    expect(typedCommandIn('/speckit:plan:confirm add a login page')).toBe('/speckit:plan');\n+    expect(typedCommandIn('/speckit:implement:autopilot')).toBe('/speckit:implement');\n+  });\n+\n+  it('does not read a command followed by an unknown suffix', () => {\n+    expect(typedCommandIn('/deep:review:automation notes')).toBeUndefined();\n+    expect(typedCommandIn('/create:readme:draft')).toBeUndefined();\n+  });\n+\n+  it('attaches the deep-loop command typed with its mode suffix', () => {\n+    expect(attachCommand('system-deep-loop', SINGLE('review'), '/deep:review:auto review the diff')).toBe('/deep:review');\n+  });\n+\n+  it('reads a retired command name as the command that replaced it', () => {\n+    expect(typedCommandIn('/create:skill')).toBe('/create:sk-skill');\n+    expect(typedCommandIn('/create:skill make a linting skill')).toBe('/create:sk-skill');\n+    expect(typedCommandForTop('sk-doc', '/create:skill')).toEqual({\n+      command: '/create:sk-skill',\n+      policy: 'start',\n+      ownerSkillId: 'sk-doc',\n+    });\n+  });\n+\n+  it('does not read a retired name inside a path', () => {\n+    expect(typedCommandIn('open docs/create:skill.md')).toBeUndefined();\n+  });\n+\n   it('carries no command when the prompt only names a file', () => {\n     expect(typedCommandForTop('sk-doc', 'open /create:readme.md and summarise it')).toBeUndefined();\n   });\n+\n+  it('delivers no typed command the prompt refuses', () => {\n+    expect(typedCommandForTop('system-spec-kit', 'do not run /speckit:complete yet, just explain what it does')).toBeUndefined();\n+  });\n+\n+  it('still delivers a typed command the prompt asks for', () => {\n+    expect(typedCommandForTop('system-spec-kit', 'run /speckit:complete for the rate limiter')?.command).toBe('/speckit:complete');\n+  });\n });\n \n describe('generated command table', () => {\ndiff --git a/.skilled/skills/system-skill-advisor/runtime/tests/command-meaning-anchor.vitest.ts b/.skilled/skills/system-skill-advisor/runtime/tests/command-meaning-anchor.vitest.ts\nindex 8915cd1b02..b81ac3293f 100644\n--- a/.skilled/skills/system-skill-advisor/runtime/tests/command-meaning-anchor.vitest.ts\n+++ b/.skilled/skills/system-skill-advisor/runtime/tests/command-meaning-anchor.vitest.ts\n@@ -37,7 +37,10 @@ import {\n   rankMeaningPassedCommandFirst,\n   requireCommandPhraseAnchor,\n   scoreAdvisorPrompt,\n+  withholdMentionedCommands,\n+  withholdWritingCommandsOnNoEdit,\n } from '../lib/scorer/fusion.js';\n+import { commandRowFor } from '../lib/command-attach.js';\n import { COMMAND_BRIDGES } from '../lib/scorer/projection.js';\n import { findAdvisorWorkspaceRoot } from '../lib/utils/workspace-root.js';\n import type { AdvisorScoredRecommendation, LaneContribution } from '../lib/scorer/types.js';\n@@ -152,6 +155,41 @@ describe('requireCommandPhraseAnchor', () => {\n     expect(meaningPassed.size).toBe(1);\n   });\n \n+  it('leaves a meaning match unpassed when its uncertainty is above the bar', () => {\n+    const meaningPassed = new Set<string>();\n+    // The same clear lead over the same trailing rival, held back only by the\n+    // uncertainty the caller's bar would drop the row for.\n+    const ranked = [\n+      row('create:agent', 'command', [semantic(AT_BAR)], { uncertainty: 0.42 }),\n+      row('sk-doc', 'skill', [], { passes_threshold: true }),\n+      row('memory:save', 'command', [semantic(Math.max(AT_BAR - MARGIN - 0.05, 0))]),\n+    ];\n+\n+    const result = requireCommandPhraseAnchor(ranked, CONFIDENCE_THRESHOLD, meaningPassed, () => true, 0.35);\n+    if (!MEANING_REACHABLE) { expect(result[0]!.passes_threshold).toBe(false); return; }\n+    const anchored = result[0]!;\n+\n+    expect(anchored.passes_threshold).toBe(false);\n+    expect(anchored.confidence).toBe(ROW_CONFIDENCE);\n+    expect(meaningPassed.size).toBe(0);\n+  });\n+\n+  it('passes a meaning match at the bar', () => {\n+    const meaningPassed = new Set<string>();\n+    // An uncertainty exactly at the bar still passes, because a caller keeps a\n+    // row that sits at or under its threshold.\n+    const ranked = [\n+      row('create:agent', 'command', [semantic(AT_BAR)], { uncertainty: 0.35 }),\n+      row('sk-doc', 'skill', [], { passes_threshold: true }),\n+      row('memory:save', 'command', [semantic(Math.max(AT_BAR - MARGIN - 0.05, 0))]),\n+    ];\n+\n+    const result = requireCommandPhraseAnchor(ranked, CONFIDENCE_THRESHOLD, meaningPassed, () => true, 0.35);\n+    if (!MEANING_REACHABLE) { expect(result[0]!.passes_threshold).toBe(false); return; }\n+\n+    expect(result[0]!.passes_threshold).toBe(true);\n+  });\n+\n   it('refuses a cosine under the bar and drops a pass it cannot justify', () => {\n     const meaningPassed = new Set<string>();\n     const ranked = [row('create:agent', 'command', [semantic(UNDER_BAR)], { passes_threshold: true })];\n@@ -344,6 +382,103 @@ describe('commandMeaningEligible', () => {\n   });\n });\n \n+describe('withholdMentionedCommands', () => {\n+  // A command row reaches its pass on the command name in its own wording, so a\n+  // prompt that names that command only to refuse it or ask about it would carry\n+  // the row through. The skill row shares no command name and must stay as it was.\n+  const rows = [\n+    row('command-speckit-complete', 'command', [], { passes_threshold: true }),\n+    row('system-spec-kit', 'skill', [], { passes_threshold: true }),\n+  ];\n+\n+  it('stops the command row a refusal names', () => {\n+    const result = withholdMentionedCommands(rows, 'do not run /speckit:complete yet, just explain what it does');\n+\n+    expect(result[0]!.passes_threshold).toBe(false);\n+    expect(result[1]).toBe(rows[1]);\n+  });\n+\n+  it('leaves both rows passing when the prompt asks for the command', () => {\n+    const result = withholdMentionedCommands(rows, 'run /speckit:complete for the rate limiter');\n+\n+    expect(result[0]).toBe(rows[0]);\n+    expect(result[1]).toBe(rows[1]);\n+  });\n+\n+  it('stops the command row a question names', () => {\n+    const result = withholdMentionedCommands(rows, 'is /speckit:complete overkill for a two line fix?');\n+\n+    expect(result[0]!.passes_threshold).toBe(false);\n+  });\n+\n+  // The prompt names a command with subcommands by its base alone, so the row's\n+  // own name has to be reduced the same way before the two are compared.\n+  it('matches a command that carries a subcommand by its base', () => {\n+    const doctorRow = row('command-doctor-env', 'command', [], { passes_threshold: true });\n+\n+    const result = withholdMentionedCommands([doctorRow], 'do not run /doctor:env on this machine');\n+\n+    expect(result[0]!.passes_threshold).toBe(false);\n+  });\n+});\n+\n+describe('withholdWritingCommandsOnNoEdit', () => {\n+  // Three commands of each writing class beside a skill row, so the gate is\n+  // shown to choose by the class the command carries rather than by its name.\n+  const rows = [\n+    row('command-doctor-speckit', 'command', [], { passes_threshold: true }),\n+    row('command-speckit-complete', 'command', [], { passes_threshold: true }),\n+    row('command-doctor-env', 'command', [], { passes_threshold: true }),\n+    row('system-spec-kit', 'skill', [], { passes_threshold: true }),\n+  ];\n+\n+  it('stops every command that writes and keeps the one that only reads', () => {\n+    // A regenerated table that changes a class fails here by name, before the\n+    // behavioural assertion below can pass for an unrelated reason.\n+    expect(commandRowFor('command-doctor-speckit')?.mutating).toBe('add-only');\n+    expect(commandRowFor('command-speckit-complete')?.mutating).toBe('mutates');\n+    expect(commandRowFor('command-doctor-env')?.mutating).toBe('read-only');\n+\n+    const result = withholdWritingCommandsOnNoEdit(\n+      rows,\n+      'the trigger index lookup returns nothing for my packet, do not change anything',\n+    );\n+\n+    expect(result.filter((recommendation) => recommendation.passes_threshold).map((recommendation) => recommendation.skill))\n+      .toEqual(['command-doctor-env', 'system-spec-kit']);\n+  });\n+\n+  it('leaves every row as it was when the prompt allows a change', () => {\n+    const result = withholdWritingCommandsOnNoEdit(\n+      rows,\n+      'the trigger index lookup returns nothing for my packet',\n+    );\n+\n+    expect(result).toEqual(rows);\n+    expect(result.every((recommendation) => recommendation.passes_threshold)).toBe(true);\n+  });\n+\n+  it('keeps a writing command the prompt types and asks for', () => {\n+    const result = withholdWritingCommandsOnNoEdit(\n+      rows,\n+      'run /speckit:complete for the rate limiter, do not change the public api',\n+    );\n+\n+    expect(result.find((recommendation) => recommendation.skill === 'command-speckit-complete')?.passes_threshold)\n+      .toBe(true);\n+  });\n+\n+  it('still withholds a writing command the prompt only names', () => {\n+    const result = withholdWritingCommandsOnNoEdit(\n+      rows,\n+      'do not run /speckit:complete, and do not change anything',\n+    );\n+\n+    expect(result.find((recommendation) => recommendation.skill === 'command-speckit-complete')?.passes_threshold)\n+      .toBe(false);\n+  });\n+});\n+\n describe('scoring with no embedder and no stored vectors', () => {\n   it('passes a command only on its own authored phrase', () => {\n     const workspaceRoot = findAdvisorWorkspaceRoot(import.meta.dirname);\ndiff --git a/.skilled/skills/system-skill-advisor/runtime/tests/doctor-helper-handoff.vitest.ts b/.skilled/skills/system-skill-advisor/runtime/tests/doctor-helper-handoff.vitest.ts\nindex 7ed2e67b82..b10d3d1953 100644\n--- a/.skilled/skills/system-skill-advisor/runtime/tests/doctor-helper-handoff.vitest.ts\n+++ b/.skilled/skills/system-skill-advisor/runtime/tests/doctor-helper-handoff.vitest.ts\n@@ -12,7 +12,12 @@ import { fileURLToPath } from 'node:url';\n \n import { describe, expect, it } from 'vitest';\n \n-import { doctorProblemCue, genericRepairCue, matchDoctorProblem } from '../lib/scorer/doctor-helper-handoff.js';\n+import {\n+  DOCTOR_HELPER_UNCUED_MIN_SCORE,\n+  doctorProblemCue,\n+  genericRepairCue,\n+  matchDoctorProblem,\n+} from '../lib/scorer/doctor-helper-handoff.js';\n import { findAdvisorWorkspaceRoot } from '../lib/utils/workspace-root.js';\n \n const HERE = dirname(fileURLToPath(import.meta.url));\n@@ -47,6 +52,11 @@ describe('doctor problem cue', () => {\n     expect(doctorProblemCue('show me how the advisor ranks skills')).toBeNull();\n   });\n \n+  it('reads a contraction typed with a curly apostrophe', () => {\n+    expect(doctorProblemCue('Code Mode tools aren’t showing up in my session')).toBe('strong');\n+    expect(doctorProblemCue('my new agent isn’t appearing in the picker')).toBe('strong');\n+  });\n+\n   // A loop that stopped converging reports the same wrong state in the past\n   // tense, which the \"never <verb>\" form does not cover.\n   it('reads a loop that stopped converging as a strong cue', () => {\n@@ -103,6 +113,20 @@ describe('doctor helper ranker bridge', () => {\n     expect(matchDoctorProblem('write me a poem about cats', WORKSPACE)).toBeNull();\n   });\n \n+  // The helper ranks on shared words, so a doctor route phrase built from\n+  // everyday repair words pulls a code or release request onto a doctor command.\n+  it('keeps a code repair request off the doctor commands', () => {\n+    expect(matchDoctorProblem('tell me what to fix where the tests fail', WORKSPACE)).toBeNull();\n+    expect(matchDoctorProblem('fix the failing tests', WORKSPACE)).toBeNull();\n+  });\n+\n+  it('keeps a release notes request under the bar for a prompt with no problem cue', () => {\n+    const prompt = 'summarize what changed in the newer release';\n+    expect(doctorProblemCue(prompt)).toBeNull();\n+    expect(matchDoctorProblem(prompt, WORKSPACE)?.score ?? 0).toBeLessThan(DOCTOR_HELPER_UNCUED_MIN_SCORE);\n+    expect(matchDoctorProblem('what changed in the last release of our api', WORKSPACE)).toBeNull();\n+  });\n+\n   it('returns null when the workspace has no doctor helper', () => {\n     expect(matchDoctorProblem('my deep research run never converges', mkdtempSync(join(tmpdir(), 'no-doctor-')))).toBeNull();\n   });\ndiff --git a/.skilled/skills/system-skill-advisor/runtime/tests/handlers/advisor-recommend-compiled-route-option.vitest.ts b/.skilled/skills/system-skill-advisor/runtime/tests/handlers/advisor-recommend-compiled-route-option.vitest.ts\nindex 4c4f7fc5a2..aa2532cb5e 100644\n--- a/.skilled/skills/system-skill-advisor/runtime/tests/handlers/advisor-recommend-compiled-route-option.vitest.ts\n+++ b/.skilled/skills/system-skill-advisor/runtime/tests/handlers/advisor-recommend-compiled-route-option.vitest.ts\n@@ -155,7 +155,7 @@ describe('advisor_recommend compiled-route option', () => {\n     expect(hubOnly.find((row) => row.skillId === 'sk-doc')?.command).toBe(command);\n   });\n \n-  it('lets the top hub carry a command only a lower row would offer', async () => {\n+  it('lets the top hub carry its command under every request shape', async () => {\n     const corpusRow = readFileSync(CORPUS_PATH, 'utf8')\n       .split('\\n')\n       .filter((line) => line.trim() !== '')\n@@ -187,7 +187,9 @@ describe('advisor_recommend compiled-route option', () => {\n       prompt: corpusRow.prompt,\n       options: { includeCompiledRoute: true },\n     })).data?.recommendations ?? [];\n-    expect(everyRow.find((row) => row.skillId === 'sk-doc')?.command).toBeUndefined();\n+    expect(everyRow[0]?.skillId).toBe('sk-doc');\n+    expect(everyRow[0]?.command).toBe(command);\n+    expect(everyRow[0]?.command).toBe(topOnly[0]?.command);\n   });\n \n   it('marks a hub that needs a mode without marking a hub that has none', async () => {\ndiff --git a/.skilled/skills/system-skill-advisor/runtime/tests/scorer/doctor-handoff-command.vitest.ts b/.skilled/skills/system-skill-advisor/runtime/tests/scorer/doctor-handoff-command.vitest.ts\nindex 0cf0bc6206..052b998d53 100644\n--- a/.skilled/skills/system-skill-advisor/runtime/tests/scorer/doctor-handoff-command.vitest.ts\n+++ b/.skilled/skills/system-skill-advisor/runtime/tests/scorer/doctor-handoff-command.vitest.ts\n@@ -68,6 +68,15 @@ function scoredIds(prompt: string): string[] {\n     .recommendations.map((recommendation) => recommendation.skill);\n }\n \n+// Only a passing row is offered, so a case about the hand-off reads the passing\n+// doctor rows alone.\n+function passingDoctorIds(prompt: string): string[] {\n+  return scoreAdvisorPrompt(prompt, { workspaceRoot, projection })\n+    .recommendations\n+    .filter((recommendation) => recommendation.passes_threshold && recommendation.skill.startsWith(DOCTOR_PREFIX))\n+    .map((recommendation) => recommendation.skill);\n+}\n+\n describe('doctor hand-off command', () => {\n   beforeAll(async () => {\n     freezeEvalEnv();\n@@ -130,6 +139,24 @@ describe('doctor hand-off command', () => {\n     expect(ids.slice(0, 3)).toContain('command-doctor-helper');\n   });\n \n+  // A skill that passed on shared single words holds no phrase of its own in the\n+  // prompt, so a bare problem word with a strong ranker match leads it.\n+  it('puts the ranked command before a skill that passed on shared words alone', () => {\n+    const ids = scoredIds('the agents md file is missing the gate sections');\n+\n+    expect(ids[0]).toBe('command-doctor-agents-md-check');\n+    expect(ids).toContain('sk-doc');\n+  });\n+\n+  // The same bare problem word beside a skill the prompt names with its own\n+  // phrase is ordinary work, however strongly the ranker matches.\n+  it('leaves a bare problem word beside a phrase-matched skill with no doctor command', () => {\n+    const ids = scoredIds('update the readme because the agents md sections are stale');\n+\n+    expect(ids[0]).toBe('sk-doc');\n+    expect(ids.filter((id) => id.startsWith(DOCTOR_PREFIX))).toEqual([]);\n+  });\n+\n   it('falls back to the helper for a repair request with no ranked command', () => {\n     expect(scoredIds('I have a problem and want the right repair path suggested with reasons')[0])\n       .toBe('command-doctor-helper');\n@@ -148,6 +175,21 @@ describe('doctor hand-off command', () => {\n \n     expect(doctorIds).toEqual([]);\n   });\n+\n+  // A bare word that ordinary work also uses is a weak cue, so it needs a stronger ranker match than a strong cue.\n+  it.each([\n+    'the environment variable for the database url is missing in production',\n+    'the install step in our dockerfile is broken, the overlay filesystem is stale',\n+  ])('hands off no doctor command for the app problem %s', (prompt) => {\n+    expect(passingDoctorIds(prompt)).toEqual([]);\n+  });\n+\n+  it.each([\n+    ['AGENTS.md is missing the shipped sections', 'command-doctor-agents-md-check'],\n+    ['the symlink to the skilled checkout is broken', 'command-doctor-helper'],\n+  ])('still hands off %s', (prompt, id) => {\n+    expect(passingDoctorIds(prompt)).toContain(id);\n+  });\n });\n \n describe('runnableDoctorBridgeId', () => {\ndiff --git a/.skilled/skills/system-skill-advisor/runtime/tests/scorer/typed-command-owner.vitest.ts b/.skilled/skills/system-skill-advisor/runtime/tests/scorer/typed-command-owner.vitest.ts\nindex 2eb34dfead..664c7b02b6 100644\n--- a/.skilled/skills/system-skill-advisor/runtime/tests/scorer/typed-command-owner.vitest.ts\n+++ b/.skilled/skills/system-skill-advisor/runtime/tests/scorer/typed-command-owner.vitest.ts\n@@ -69,4 +69,9 @@ describe('a typed command without a scorer row leads through its owner', () => {\n     ];\n     expect(rankedSkills(ranked, 'create a goal for the utils folder')).toEqual(['sk-code', 'sk-doc']);\n   });\n+\n+  it('keeps the order when the prompt refuses the typed command', () => {\n+    const ranked = [recommendation('sk-code'), recommendation('sk-doc'), recommendation('sk-prompt')];\n+    expect(rankedSkills(ranked, 'do not run /create:goal')).toEqual(['sk-code', 'sk-doc', 'sk-prompt']);\n+  });\n });\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"diff --git a/.skilled/skills/system-skill-advisor/runtime/tests/command-attach-guards.vitest.ts b/.skilled/skills/system-skill-advisor/runtime/tests/command-attach-guards.vitest.ts\nindex 440a6db96d..7fda21d4b2 100644\n--- a/.skilled/skills/system-skill-advisor/runtime/tests/command-attach-guards.vitest.ts\n+++ b/.skilled/skills/system-skill-advisor/runtime/tests/command-attach-guards.vitest.ts\n@@ -13,7 +13,9 @@ import { describe, expect, it } from 'vitest';\n \n import {\n   attachCommand,\n+  commandOnlyMentioned,\n   isNoEditRequest,\n+  MODE_COMMANDS,\n   NO_EDIT_REQUEST,\n   typedCommandForTop,\n   typedCommandIn,\n@@ -34,6 +36,42 @@ const NOEDIT4 = [\n   'make no changes',\n ];\n \n+// The prompts that name a command to refuse it or ask about it, the prompts that\n+// ask for the command, and the prompts that hold a refusal or question word and\n+// still ask for the command.\n+const REFUSE8: ReadonlyArray<readonly [string, string]> = [\n+  ['do not run /speckit:complete yet, just explain what it does', '/speckit:complete'],\n+  ['I never want to use /create:agent again, delete the agent file', '/create:agent'],\n+  ['someone ran /speckit:save by accident, how do I undo what it wrote', '/speckit:save'],\n+  ['please do not start /deep:research, I only want a two line summary of the readme', '/deep:research'],\n+  ['what does /create:readme do?', '/create:readme'],\n+  ['do not run it, just tell me what /doctor:update would change', '/doctor:update'],\n+  ['explain /deep:review to me', '/deep:review'],\n+  ['skip /create:readme, just append one line to the existing README', '/create:readme'],\n+];\n+\n+const QUESTION2: ReadonlyArray<readonly [string, string]> = [\n+  ['is /speckit:complete overkill for a two line fix?', '/speckit:complete'],\n+  ['should I use /deep:research for this or just read the two files myself?', '/deep:research'],\n+];\n+\n+const REQUEST6: ReadonlyArray<readonly [string, string]> = [\n+  ['run /speckit:complete for the rate limiter', '/speckit:complete'],\n+  ['/create:agent security-reviewer', '/create:agent'],\n+  [\"don't forget to run /speckit:save\", '/speckit:save'],\n+  ['explain the diff then run /speckit:save', '/speckit:save'],\n+  ['use /speckit:plan, not /speckit:complete', '/speckit:plan'],\n+  ['I ran /speckit:plan yesterday, now run /speckit:implement', '/speckit:implement'],\n+];\n+\n+const CONTROL5: ReadonlyArray<readonly [string, string]> = [\n+  ['dont guess, run /speckit:plan', '/speckit:plan'],\n+  ['never mind just run /speckit:save', '/speckit:save'],\n+  ['not sure, use /create:readme', '/create:readme'],\n+  ['without asking, run /speckit:complete', '/speckit:complete'],\n+  ['can you run /speckit:plan?', '/speckit:plan'],\n+];\n+\n describe('command attach on a no-edit prompt', () => {\n   it('offers no hub command when the prompt rules out a change', () => {\n     const prompt = 'use sk-doc to create a skill called invoice-parser, do not change anything yet';\n@@ -97,6 +135,222 @@ describe('command attach on a no-edit prompt', () => {\n   });\n });\n \n+describe('a command the prompt only mentions', () => {\n+  it.each(REFUSE8)('reads %s as a mention of %s', (prompt, command) => {\n+    expect(commandOnlyMentioned(prompt, command)).toBe(true);\n+  });\n+\n+  it.each(QUESTION2)('reads the question %s as a mention of %s', (prompt, command) => {\n+    expect(commandOnlyMentioned(prompt, command)).toBe(true);\n+  });\n+\n+  it.each(REQUEST6)('reads %s as a request for %s', (prompt, command) => {\n+    expect(commandOnlyMentioned(prompt, command)).toBe(false);\n+  });\n+\n+  it.each(CONTROL5)('reads %s as a request for %s beside a refusal word', (prompt, command) => {\n+    expect(commandOnlyMentioned(prompt, command)).toBe(false);\n+  });\n+\n+  // A bare lead opens a statement as often as a question, so it marks a mention\n+  // only before a question. One led occurrence does not make a request either\n+  // when a later occurrence of the same command is not led.\n+  it.each([\n+    ['the next step is /speckit:implement', '/speckit:implement'],\n+    ['is this right? run /speckit:plan', '/speckit:plan'],\n+    ['the next step is /speckit:implement\\nany questions?', '/speckit:implement'],\n+    ['what does /speckit:save do? ok now run /speckit:save', '/speckit:save'],\n+    ['the plan is /speckit:plan then tests', '/speckit:plan'],\n+  ])('reads %s as a request for %s', (prompt, command) => {\n+    expect(commandOnlyMentioned(prompt, command)).toBe(false);\n+  });\n+\n+  // A chat question often leaves the question mark off, so a bare ask word that\n+  // opens a sentence still marks the command as the subject.\n+  it.each([\n+    ['is /speckit:resume safe to run twice', '/speckit:resume'],\n+    ['does /doctor:git change files or just report problems', '/doctor:git'],\n+    ['can /prompt:improve make a vague request easier to follow', '/prompt:improve'],\n+    ['ok. is /speckit:plan enough here', '/speckit:plan'],\n+    ['quick question? is /speckit:resume safe to run twice', '/speckit:resume'],\n+  ])('reads %s as a question about %s', (prompt, command) => {\n+    expect(commandOnlyMentioned(prompt, command)).toBe(true);\n+  });\n+\n+  it('reads each command of a two-command prompt on its own', () => {\n+    expect(commandOnlyMentioned('use /speckit:plan, not /speckit:complete', '/speckit:complete')).toBe(true);\n+  });\n+\n+  it('reads a curly apostrophe as a straight one', () => {\n+    expect(commandOnlyMentioned('don\\u2019t run /speckit:save', '/speckit:save')).toBe(true);\n+  });\n+\n+  it('reads no need to run as a refusal of the command', () => {\n+    expect(commandOnlyMentioned('no need to run /doctor:setup, the hooks are fine', '/doctor:setup')).toBe(true);\n+  });\n+\n+  it('still reads a request after no need to ask', () => {\n+    expect(commandOnlyMentioned('no need to ask, run /speckit:save', '/speckit:save')).toBe(false);\n+  });\n+\n+  it('reads stop using as a refusal of the command', () => {\n+    expect(commandOnlyMentioned('stop using /create:changelog for this, write the changelog entry by hand', '/create:changelog')).toBe(true);\n+  });\n+\n+  it('still reads a request after stop and', () => {\n+    expect(commandOnlyMentioned('stop and run /speckit:plan', '/speckit:plan')).toBe(false);\n+  });\n+\n+  it('reads why not use as a request for the command', () => {\n+    expect(commandOnlyMentioned('why not use /create:agent for this? go ahead and make a security reviewer agent', '/create:agent')).toBe(false);\n+  });\n+\n+  it.each([\n+    ['I have not run /speckit:plan yet, please start it for the login feature', '/speckit:plan'],\n+    ['I already ran /create:readme but the output was wrong, run it again for the hooks folder', '/create:readme'],\n+    ['not run /speckit:plan yet, write notes to /tmp/notes.md, then run it', '/speckit:plan'],\n+    ['not run /speckit:plan yet, read https://example.com/spec first, then run it', '/speckit:plan'],\n+  ])('reads %s as a request for %s made by a later clause', (prompt, command) => {\n+    expect(commandOnlyMentioned(prompt, command)).toBe(false);\n+  });\n+\n+  it.each([\n+    ['do not run /speckit:complete, I will run it myself later', '/speckit:complete'],\n+    ['do not use /create:agent, use that other one', '/create:agent'],\n+    ['do not run /speckit:complete, run /speckit:plan for the rate limiter instead', '/speckit:complete'],\n+    ['do not run /speckit:complete, run /speckit:plan, then run it for the auth module', '/speckit:complete'],\n+  ])('still reads %s as a mention of %s', (prompt, command) => {\n+    expect(commandOnlyMentioned(prompt, command)).toBe(true);\n+  });\n+\n+  it('does not read a longer command name as the shorter one', () => {\n+    expect(commandOnlyMentioned('do not run /create:sk-skill-parent', '/create:sk-skill')).toBe(false);\n+  });\n+\n+  it.each([\n+    'what does /create:readme do?',\n+    'skip /create:readme, just append one line to the existing README',\n+  ])('offers no hub command for %s', (prompt) => {\n+    expect(attachCommand('sk-doc', SINGLE('sk-create-readme'), prompt)).toBeUndefined();\n+  });\n+\n+  it('offers no deep-loop command the prompt refuses', () => {\n+    const deepLoopModes = MODE_COMMANDS['system-deep-loop'];\n+    const mode = Object.keys(deepLoopModes).find((key) => deepLoopModes[key] === '/deep:research');\n+    expect(mode, 'the generated table names the research mode').toBeDefined();\n+    expect(attachCommand('system-deep-loop', SINGLE(mode!), 'please do not start /deep:research, I only want a two line summary of the readme')).toBeUndefined();\n+  });\n+\n+  it('still offers the hub command a plain request routes to', () => {\n+    expect(attachCommand('sk-doc', SINGLE('sk-create-readme'), 'write a readme for the doctor scripts folder')).toBe('/create:readme');\n+  });\n+});\n+\n+describe('command attach on a small edit', () => {\n+  it.each([\n+    'update the README typo in line 3',\n+    'fix the typo in the README',\n+    'correct the spelling in the hooks readme',\n+    'fix the broken link in the install guide readme',\n+  ])('offers no creation command for %s', (prompt) => {\n+    expect(attachCommand('sk-doc', SINGLE('sk-create-readme'), prompt)).toBeUndefined();\n+  });\n+\n+  it.each([\n+    'write a readme for the doctor scripts folder',\n+    'create a readme for the payments module, check it for typos when done',\n+  ])('still offers the creation command for %s', (prompt) => {\n+    expect(attachCommand('sk-doc', SINGLE('sk-create-readme'), prompt)).toBe('/create:readme');\n+  });\n+\n+  it.each([\n+    ['sk-doc', 'sk-create-agent', 'build an agent that fixes typos in our docs'],\n+    ['sk-doc', 'sk-create-readme', 'writing a readme for the grammar module'],\n+    ['sk-doc', 'sk-create-readme', 'add a readme for the spelling package'],\n+    ['sk-doc', 'sk-create-changelog', 'add a changelog entry for the typo fixes in the cli help'],\n+  ])('still offers the creation command on %s %s for %s', (skill, mode, prompt) => {\n+    expect(attachCommand(skill, SINGLE(mode), prompt)).toBe(MODE_COMMANDS[skill][mode]);\n+  });\n+\n+  it('leaves the wording commands outside the gate', () => {\n+    const docModes = MODE_COMMANDS['sk-doc'];\n+    const mode = Object.keys(docModes).find((key) => docModes[key] === '/create:with-human-voice');\n+    expect(mode, 'the generated table names the human voice mode').toBeDefined();\n+    expect(attachCommand('sk-doc', SINGLE(mode!), 'humanize the wording in the onboarding guide')).toBe('/create:with-human-voice');\n+  });\n+\n+  it.each([\n+    ['sk-create-changelog', 'changelog for v2.1, it fixes the broken link checker and spelling errors'],\n+    ['sk-create-changelog', 'log the spelling fixes in the changelog'],\n+    ['sk-create-readme', 'document the cli in a readme, each flag gets a one line description'],\n+    ['sk-create-readme', 'readme for the spelling package'],\n+    ['sk-create-agent', 'an agent that fixes typos'],\n+  ])('keeps the creation command for %s on %s', (mode, prompt) => {\n+    expect(attachCommand('sk-doc', SINGLE(mode), prompt)).toBe(MODE_COMMANDS['sk-doc'][mode]);\n+  });\n+\n+  it('keeps the goal command when the goal is about fixes', () => {\n+    const docModes = MODE_COMMANDS['sk-doc'];\n+    const mode = Object.keys(docModes).find((key) => docModes[key] === '/create:goal');\n+    expect(mode, 'the generated table names the goal mode').toBeDefined();\n+    expect(attachCommand('sk-doc', SINGLE(mode!), 'set a goal to fix all the typos in the docs')).toBe('/create:goal');\n+  });\n+\n+  it.each([\n+    'fix the broken links in the install guide readme',\n+    'fix the dead links in the hooks readme',\n+  ])('offers no creation command for %s', (prompt) => {\n+    expect(attachCommand('sk-doc', SINGLE('sk-create-readme'), prompt)).toBeUndefined();\n+  });\n+\n+  it('leaves a command outside the create namespace alone', () => {\n+    const deepLoopModes = MODE_COMMANDS['system-deep-loop'];\n+    const mode = Object.keys(deepLoopModes).find((key) => deepLoopModes[key] === '/deep:review');\n+    expect(mode, 'the generated table names the review mode').toBeDefined();\n+    expect(attachCommand('system-deep-loop', SINGLE(mode!), 'do a thorough deep review of the typo handling')).toBe('/deep:review');\n+  });\n+\n+  it.each([\n+    ['sk-create-agent', 'an agent to fix typos'],\n+    ['sk-create-agent', 'give me an agent to fix broken links in the docs'],\n+    ['sk-create-agent', 'I want an agent to correct spelling in pull requests'],\n+  ])('keeps the creation command for %s on %s', (mode, prompt) => {\n+    expect(attachCommand('sk-doc', SINGLE(mode), prompt)).toBe(MODE_COMMANDS['sk-doc'][mode]);\n+  });\n+\n+  // A skill or a command names its own purpose, so a correction word inside that\n+  // purpose is the reason the artifact exists and not a request to edit one.\n+  it.each([\n+    ['/create:sk-skill', 'a skill to correct spelling in markdown'],\n+    ['/create:command', \"I'd like a command to fix dead links\"],\n+  ])('keeps the command %s on %s', (command, prompt) => {\n+    const docModes = MODE_COMMANDS['sk-doc'];\n+    const mode = Object.keys(docModes).find((key) => docModes[key] === command);\n+    expect(mode, 'the generated table names the ' + command + ' mode').toBeDefined();\n+    expect(attachCommand('sk-doc', SINGLE(mode!), prompt)).toBe(command);\n+  });\n+\n+  // A repo rule or a benchmark also names its purpose the way an agent does, so\n+  // the correction word belongs to what the artifact is for rather than to an\n+  // edit of a document that already exists.\n+  it.each([\n+    'I want a repo rule that says fix typos in the same commit',\n+    'repo rule: always fix typos in the same commit',\n+  ])('keeps the repo-rule command on %s', (prompt) => {\n+    const docModes = MODE_COMMANDS['sk-doc'];\n+    const mode = Object.keys(docModes).find((key) => docModes[key] === '/create:repo-rule');\n+    expect(mode, 'the generated table names the repo rule mode').toBeDefined();\n+    expect(attachCommand('sk-doc', SINGLE(mode!), prompt)).toBe('/create:repo-rule');\n+  });\n+\n+  it('keeps the benchmark command on benchmark how fast we fix typos', () => {\n+    const docModes = MODE_COMMANDS['sk-doc'];\n+    const mode = Object.keys(docModes).find((key) => docModes[key] === '/create:benchmark');\n+    expect(mode, 'the generated table names the benchmark mode').toBeDefined();\n+    expect(attachCommand('sk-doc', SINGLE(mode!), 'benchmark how fast we fix typos')).toBe('/create:benchmark');\n+  });\n+});\n+\n describe('command attach on a deep-loop prompt', () => {\n   it('withholds the review command when another deep-loop command is named', () => {\n     expect(attachCommand('system-deep-loop', SINGLE('review'), 'what did /deep:ai-council decide')).toBeUndefined();\n@@ -136,9 +390,46 @@ describe('typed command boundaries', () => {\n     expect(typedCommandIn('/create:skill-parent now')).toBe('/create:skill-parent');\n   });\n \n+  it('reads a command typed with its mode suffix', () => {\n+    expect(typedCommandIn('/deep:review:auto review the diff')).toBe('/deep:review');\n+    expect(typedCommandIn('/speckit:plan:confirm add a login page')).toBe('/speckit:plan');\n+    expect(typedCommandIn('/speckit:implement:autopilot')).toBe('/speckit:implement');\n+  });\n+\n+  it('does not read a command followed by an unknown suffix', () => {\n+    expect(typedCommandIn('/deep:review:automation notes')).toBeUndefined();\n+    expect(typedCommandIn('/create:readme:draft')).toBeUndefined();\n+  });\n+\n+  it('attaches the deep-loop command typed with its mode suffix', () => {\n+    expect(attachCommand('system-deep-loop', SINGLE('review'), '/deep:review:auto review the diff')).toBe('/deep:review');\n+  });\n+\n+  it('reads a retired command name as the command that replaced it', () => {\n+    expect(typedCommandIn('/create:skill')).toBe('/create:sk-skill');\n+    expect(typedCommandIn('/create:skill make a linting skill')).toBe('/create:sk-skill');\n+    expect(typedCommandForTop('sk-doc', '/create:skill')).toEqual({\n+      command: '/create:sk-skill',\n+      policy: 'start',\n+      ownerSkillId: 'sk-doc',\n+    });\n+  });\n+\n+  it('does not read a retired name inside a path', () => {\n+    expect(typedCommandIn('open docs/create:skill.md')).toBeUndefined();\n+  });\n+\n   it('carries no command when the prompt only names a file', () => {\n     expect(typedCommandForTop('sk-doc', 'open /create:readme.md and summarise it')).toBeUndefined();\n   });\n+\n+  it('delivers no typed command the prompt refuses', () => {\n+    expect(typedCommandForTop('system-spec-kit', 'do not run /speckit:complete yet, just explain what it does')).toBeUndefined();\n+  });\n+\n+  it('still delivers a typed command the prompt asks for', () => {\n+    expect(typedCommandForTop('system-spec-kit', 'run /speckit:complete for the rate limiter')?.command).toBe('/speckit:complete');\n+  });\n });\n \n describe('generated command table', () => {\ndiff --git a/.skilled/skills/system-skill-advisor/runtime/tests/command-meaning-anchor.vitest.ts b/.skilled/skills/system-skill-advisor/runtime/tests/command-meaning-anchor.vitest.ts\nindex 8915cd1b02..b81ac3293f 100644\n--- a/.skilled/skills/system-skill-advisor/runtime/tests/command-meaning-anchor.vitest.ts\n+++ b/.skilled/skills/system-skill-advisor/runtime/tests/command-meaning-anchor.vitest.ts\n@@ -37,7 +37,10 @@ import {\n   rankMeaningPassedCommandFirst,\n   requireCommandPhraseAnchor,\n   scoreAdvisorPrompt,\n+  withholdMentionedCommands,\n+  withholdWritingCommandsOnNoEdit,\n } from '../lib/scorer/fusion.js';\n+import { commandRowFor } from '../lib/command-attach.js';\n import { COMMAND_BRIDGES } from '../lib/scorer/projection.js';\n import { findAdvisorWorkspaceRoot } from '../lib/utils/workspace-root.js';\n import type { AdvisorScoredRecommendation, LaneContribution } from '../lib/scorer/types.js';\n@@ -152,6 +155,41 @@ describe('requireCommandPhraseAnchor', () => {\n     expect(meaningPassed.size).toBe(1);\n   });\n \n+  it('leaves a meaning match unpassed when its uncertainty is above the bar', () => {\n+    const meaningPassed = new Set<string>();\n+    // The same clear lead over the same trailing rival, held back only by the\n+    // uncertainty the caller's bar would drop the row for.\n+    const ranked = [\n+      row('create:agent', 'command', [semantic(AT_BAR)], { uncertainty: 0.42 }),\n+      row('sk-doc', 'skill', [], { passes_threshold: true }),\n+      row('memory:save', 'command', [semantic(Math.max(AT_BAR - MARGIN - 0.05, 0))]),\n+    ];\n+\n+    const result = requireCommandPhraseAnchor(ranked, CONFIDENCE_THRESHOLD, meaningPassed, () => true, 0.35);\n+    if (!MEANING_REACHABLE) { expect(result[0]!.passes_threshold).toBe(false); return; }\n+    const anchored = result[0]!;\n+\n+    expect(anchored.passes_threshold).toBe(false);\n+    expect(anchored.confidence).toBe(ROW_CONFIDENCE);\n+    expect(meaningPassed.size).toBe(0);\n+  });\n+\n+  it('passes a meaning match at the bar', () => {\n+    const meaningPassed = new Set<string>();\n+    // An uncertainty exactly at the bar still passes, because a caller keeps a\n+    // row that sits at or under its threshold.\n+    const ranked = [\n+      row('create:agent', 'command', [semantic(AT_BAR)], { uncertainty: 0.35 }),\n+      row('sk-doc', 'skill', [], { passes_threshold: true }),\n+      row('memory:save', 'command', [semantic(Math.max(AT_BAR - MARGIN - 0.05, 0))]),\n+    ];\n+\n+    const result = requireCommandPhraseAnchor(ranked, CONFIDENCE_THRESHOLD, meaningPassed, () => true, 0.35);\n+    if (!MEANING_REACHABLE) { expect(result[0]!.passes_threshold).toBe(false); return; }\n+\n+    expect(result[0]!.passes_threshold).toBe(true);\n+  });\n+\n   it('refuses a cosine under the bar and drops a pass it cannot justify', () => {\n     const meaningPassed = new Set<string>();\n     const ranked = [row('create:agent', 'command', [semantic(UNDER_BAR)], { passes_threshold: true })];\n@@ -344,6 +382,103 @@ describe('commandMeaningEligible', () => {\n   });\n });\n \n+describe('withholdMentionedCommands', () => {\n+  // A command row reaches its pass on the command name in its own wording, so a\n+  // prompt that names that command only to refuse it or ask about it would carry\n+  // the row through. The skill row shares no command name and must stay as it was.\n+  const rows = [\n+    row('command-speckit-complete', 'command', [], { passes_threshold: true }),\n+    row('system-spec-kit', 'skill', [], { passes_threshold: true }),\n+  ];\n+\n+  it('stops the command row a refusal names', () => {\n+    const result = withholdMentionedCommands(rows, 'do not run /speckit:complete yet, just explain what it does');\n+\n+    expect(result[0]!.passes_threshold).toBe(false);\n+    expect(result[1]).toBe(rows[1]);\n+  });\n+\n+  it('leaves both rows passing when the prompt asks for the command', () => {\n+    const result = withholdMentionedCommands(rows, 'run /speckit:complete for the rate limiter');\n+\n+    expect(result[0]).toBe(rows[0]);\n+    expect(result[1]).toBe(rows[1]);\n+  });\n+\n+  it('stops the command row a question names', () => {\n+    const result = withholdMentionedCommands(rows, 'is /speckit:complete overkill for a two line fix?');\n+\n+    expect(result[0]!.passes_threshold).toBe(false);\n+  });\n+\n+  // The prompt names a command with subcommands by its base alone, so the row's\n+  // own name has to be reduced the same way before the two are compared.\n+  it('matches a command that carries a subcommand by its base', () => {\n+    const doctorRow = row('command-doctor-env', 'command', [], { passes_threshold: true });\n+\n+    const result = withholdMentionedCommands([doctorRow], 'do not run /doctor:env on this machine');\n+\n+    expect(result[0]!.passes_threshold).toBe(false);\n+  });\n+});\n+\n+describe('withholdWritingCommandsOnNoEdit', () => {\n+  // Three commands of each writing class beside a skill row, so the gate is\n+  // shown to choose by the class the command carries rather than by its name.\n+  const rows = [\n+    row('command-doctor-speckit', 'command', [], { passes_threshold: true }),\n+    row('command-speckit-complete', 'command', [], { passes_threshold: true }),\n+    row('command-doctor-env', 'command', [], { passes_threshold: true }),\n+    row('system-spec-kit', 'skill', [], { passes_threshold: true }),\n+  ];\n+\n+  it('stops every command that writes and keeps the one that only reads', () => {\n+    // A regenerated table that changes a class fails here by name, before the\n+    // behavioural assertion below can pass for an unrelated reason.\n+    expect(commandRowFor('command-doctor-speckit')?.mutating).toBe('add-only');\n+    expect(commandRowFor('command-speckit-complete')?.mutating).toBe('mutates');\n+    expect(commandRowFor('command-doctor-env')?.mutating).toBe('read-only');\n+\n+    const result = withholdWritingCommandsOnNoEdit(\n+      rows,\n+      'the trigger index lookup returns nothing for my packet, do not change anything',\n+    );\n+\n+    expect(result.filter((recommendation) => recommendation.passes_threshold).map((recommendation) => recommendation.skill))\n+      .toEqual(['command-doctor-env', 'system-spec-kit']);\n+  });\n+\n+  it('leaves every row as it was when the prompt allows a change', () => {\n+    const result = withholdWritingCommandsOnNoEdit(\n+      rows,\n+      'the trigger index lookup returns nothing for my packet',\n+    );\n+\n+    expect(result).toEqual(rows);\n+    expect(result.every((recommendation) => recommendation.passes_threshold)).toBe(true);\n+  });\n+\n+  it('keeps a writing command the prompt types and asks for', () => {\n+    const result = withholdWritingCommandsOnNoEdit(\n+      rows,\n+      'run /speckit:complete for the rate limiter, do not change the public api',\n+    );\n+\n+    expect(result.find((recommendation) => recommendation.skill === 'command-speckit-complete')?.passes_threshold)\n+      .toBe(true);\n+  });\n+\n+  it('still withholds a writing command the prompt only names', () => {\n+    const result = withholdWritingCommandsOnNoEdit(\n+      rows,\n+      'do not run /speckit:complete, and do not change anything',\n+    );\n+\n+    expect(result.find((recommendation) => recommendation.skill === 'command-speckit-complete')?.passes_threshold)\n+      .toBe(false);\n+  });\n+});\n+\n describe('scoring with no embedder and no stored vectors', () => {\n   it('passes a command only on its own authored phrase', () => {\n     const workspaceRoot = findAdvisorWorkspaceRoot(import.meta.dirname);\ndiff --git a/.skilled/skills/system-skill-advisor/runtime/tests/doctor-helper-handoff.vitest.ts b/.skilled/skills/system-skill-advisor/runtime/tests/doctor-helper-handoff.vitest.ts\nindex 7ed2e67b82..b10d3d1953 100644\n--- a/.skilled/skills/system-skill-advisor/runtime/tests/doctor-helper-handoff.vitest.ts\n+++ b/.skilled/skills/system-skill-advisor/runtime/tests/doctor-helper-handoff.vitest.ts\n@@ -12,7 +12,12 @@ import { fileURLToPath } from 'node:url';\n \n import { describe, expect, it } from 'vitest';\n \n-import { doctorProblemCue, genericRepairCue, matchDoctorProblem } from '../lib/scorer/doctor-helper-handoff.js';\n+import {\n+  DOCTOR_HELPER_UNCUED_MIN_SCORE,\n+  doctorProblemCue,\n+  genericRepairCue,\n+  matchDoctorProblem,\n+} from '../lib/scorer/doctor-helper-handoff.js';\n import { findAdvisorWorkspaceRoot } from '../lib/utils/workspace-root.js';\n \n const HERE = dirname(fileURLToPath(import.meta.url));\n@@ -47,6 +52,11 @@ describe('doctor problem cue', () => {\n     expect(doctorProblemCue('show me how the advisor ranks skills')).toBeNull();\n   });\n \n+  it('reads a contraction typed with a curly apostrophe', () => {\n+    expect(doctorProblemCue('Code Mode tools aren’t showing up in my session')).toBe('strong');\n+    expect(doctorProblemCue('my new agent isn’t appearing in the picker')).toBe('strong');\n+  });\n+\n   // A loop that stopped converging reports the same wrong state in the past\n   // tense, which the \"never <verb>\" form does not cover.\n   it('reads a loop that stopped converging as a strong cue', () => {\n@@ -103,6 +113,20 @@ describe('doctor helper ranker bridge', () => {\n     expect(matchDoctorProblem('write me a poem about cats', WORKSPACE)).toBeNull();\n   });\n \n+  // The helper ranks on shared words, so a doctor route phrase built from\n+  // everyday repair words pulls a code or release request onto a doctor command.\n+  it('keeps a code repair request off the doctor commands', () => {\n+    expect(matchDoctorProblem('tell me what to fix where the tests fail', WORKSPACE)).toBeNull();\n+    expect(matchDoctorProblem('fix the failing tests', WORKSPACE)).toBeNull();\n+  });\n+\n+  it('keeps a release notes request under the bar for a prompt with no problem cue', () => {\n+    const prompt = 'summarize what changed in the newer release';\n+    expect(doctorProblemCue(prompt)).toBeNull();\n+    expect(matchDoctorProblem(prompt, WORKSPACE)?.score ?? 0).toBeLessThan(DOCTOR_HELPER_UNCUED_MIN_SCORE);\n+    expect(matchDoctorProblem('what changed in the last release of our api', WORKSPACE)).toBeNull();\n+  });\n+\n   it('returns null when the workspace has no doctor helper', () => {\n     expect(matchDoctorProblem('my deep research run never converges', mkdtempSync(join(tmpdir(), 'no-doctor-')))).toBeNull();\n   });\ndiff --git a/.skilled/skills/system-skill-advisor/runtime/tests/handlers/advisor-recommend-compiled-route-option.vitest.ts b/.skilled/skills/system-skill-advisor/runtime/tests/handlers/advisor-recommend-compiled-route-option.vitest.ts\nindex 4c4f7fc5a2..aa2532cb5e 100644\n--- a/.skilled/skills/system-skill-advisor/runtime/tests/handlers/advisor-recommend-compiled-route-option.vitest.ts\n+++ b/.skilled/skills/system-skill-advisor/runtime/tests/handlers/advisor-recommend-compiled-route-option.vitest.ts\n@@ -155,7 +155,7 @@ describe('advisor_recommend compiled-route option', () => {\n     expect(hubOnly.find((row) => row.skillId === 'sk-doc')?.command).toBe(command);\n   });\n \n-  it('lets the top hub carry a command only a lower row would offer', async () => {\n+  it('lets the top hub carry its command under every request shape', async () => {\n     const corpusRow = readFileSync(CORPUS_PATH, 'utf8')\n       .split('\\n')\n       .filter((line) => line.trim() !== '')\n@@ -187,7 +187,9 @@ describe('advisor_recommend compiled-route option', () => {\n       prompt: corpusRow.prompt,\n       options: { includeCompiledRoute: true },\n     })).data?.recommendations ?? [];\n-    expect(everyRow.find((row) => row.skillId === 'sk-doc')?.command).toBeUndefined();\n+    expect(everyRow[0]?.skillId).toBe('sk-doc');\n+    expect(everyRow[0]?.command).toBe(command);\n+    expect(everyRow[0]?.command).toBe(topOnly[0]?.command);\n   });\n \n   it('marks a hub that needs a mode without marking a hub that has none', async () => {\ndiff --git a/.skilled/skills/system-skill-advisor/runtime/tests/scorer/doctor-handoff-command.vitest.ts b/.skilled/skills/system-skill-advisor/runtime/tests/scorer/doctor-handoff-command.vitest.ts\nindex 0cf0bc6206..052b998d53 100644\n--- a/.skilled/skills/system-skill-advisor/runtime/tests/scorer/doctor-handoff-command.vitest.ts\n+++ b/.skilled/skills/system-skill-advisor/runtime/tests/scorer/doctor-handoff-command.vitest.ts\n@@ -68,6 +68,15 @@ function scoredIds(prompt: string): string[] {\n     .recommendations.map((recommendation) => recommendation.skill);\n }\n \n+// Only a passing row is offered, so a case about the hand-off reads the passing\n+// doctor rows alone.\n+function passingDoctorIds(prompt: string): string[] {\n+  return scoreAdvisorPrompt(prompt, { workspaceRoot, projection })\n+    .recommendations\n+    .filter((recommendation) => recommendation.passes_threshold && recommendation.skill.startsWith(DOCTOR_PREFIX))\n+    .map((recommendation) => recommendation.skill);\n+}\n+\n describe('doctor hand-off command', () => {\n   beforeAll(async () => {\n     freezeEvalEnv();\n@@ -130,6 +139,24 @@ describe('doctor hand-off command', () => {\n     expect(ids.slice(0, 3)).toContain('command-doctor-helper');\n   });\n \n+  // A skill that passed on shared single words holds no phrase of its own in the\n+  // prompt, so a bare problem word with a strong ranker match leads it.\n+  it('puts the ranked command before a skill that passed on shared words alone', () => {\n+    const ids = scoredIds('the agents md file is missing the gate sections');\n+\n+    expect(ids[0]).toBe('command-doctor-agents-md-check');\n+    expect(ids).toContain('sk-doc');\n+  });\n+\n+  // The same bare problem word beside a skill the prompt names with its own\n+  // phrase is ordinary work, however strongly the ranker matches.\n+  it('leaves a bare problem word beside a phrase-matched skill with no doctor command', () => {\n+    const ids = scoredIds('update the readme because the agents md sections are stale');\n+\n+    expect(ids[0]).toBe('sk-doc');\n+    expect(ids.filter((id) => id.startsWith(DOCTOR_PREFIX))).toEqual([]);\n+  });\n+\n   it('falls back to the helper for a repair request with no ranked command', () => {\n     expect(scoredIds('I have a problem and want the right repair path suggested with reasons')[0])\n       .toBe('command-doctor-helper');\n@@ -148,6 +175,21 @@ describe('doctor hand-off command', () => {\n \n     expect(doctorIds).toEqual([]);\n   });\n+\n+  // A bare word that ordinary work also uses is a weak cue, so it needs a stronger ranker match than a strong cue.\n+  it.each([\n+    'the environment variable for the database url is missing in production',\n+    'the install step in our dockerfile is broken, the overlay filesystem is stale',\n+  ])('hands off no doctor command for the app problem %s', (prompt) => {\n+    expect(passingDoctorIds(prompt)).toEqual([]);\n+  });\n+\n+  it.each([\n+    ['AGENTS.md is missing the shipped sections', 'command-doctor-agents-md-check'],\n+    ['the symlink to the skilled checkout is broken', 'command-doctor-helper'],\n+  ])('still hands off %s', (prompt, id) => {\n+    expect(passingDoctorIds(prompt)).toContain(id);\n+  });\n });\n \n describe('runnableDoctorBridgeId', () => {\ndiff --git a/.skilled/skills/system-skill-advisor/runtime/tests/scorer/typed-command-owner.vitest.ts b/.skilled/skills/system-skill-advisor/runtime/tests/scorer/typed-command-owner.vitest.ts\nindex 2eb34dfead..664c7b02b6 100644\n--- a/.skilled/skills/system-skill-advisor/runtime/tests/scorer/typed-command-owner.vitest.ts\n+++ b/.skilled/skills/system-skill-advisor/runtime/tests/scorer/typed-command-owner.vitest.ts\n@@ -69,4 +69,9 @@ describe('a typed command without a scorer row leads through its owner', () => {\n     ];\n     expect(rankedSkills(ranked, 'create a goal for the utils folder')).toEqual(['sk-code', 'sk-doc']);\n   });\n+\n+  it('keeps the order when the prompt refuses the typed command', () => {\n+    const ranked = [recommendation('sk-code'), recommendation('sk-doc'), recommendation('sk-prompt')];\n+    expect(rankedSkills(ranked, 'do not run /create:goal')).toEqual(['sk-code', 'sk-doc', 'sk-prompt']);\n+  });\n });\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\": \"git -C /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research diff 0cdc9fa3ef -- .skilled/skills/system-skill-advisor/runtime/tests/command-attach-guards.vitest.ts .skilled/skills/system-skill-advisor/runtime/tests/command-meaning-anchor.vitest.ts .skilled/skills/system-skill-advisor/runtime/tests/doctor-helper-handoff.vitest.ts .skilled/skills/system-skill-advisor/runtime/tests/handlers/advisor-recommend-compiled-route-option.vitest.ts .skilled/skills/system-skill-advisor/runtime/tests/scorer/doctor-handoff-command.vitest.ts .skilled/skills/system-skill-advisor/runtime/tests/scorer/typed-command-owner.vitest.ts\"}"},"time":{"start":1794669509007,"end":1794669509248}}}}
