tach.ts:487\\\"]},\\n        {\\\"method\\\": \\\"probe\\\", \\\"queryOrPath\\\": \\\"compiled-route and attachCommand for four correction prompts\\\", \\\"result\\\": \\\"All route to sk-create-readme and return /create:readme.\\\", \\\"evidenceRefs\\\": [\\\"probes/probe-scorer.vitest.ts\\\"]}\\n      ],\\n      \\\"disposition\\\": \\\"finding\\\",\\n      \\\"linkedFindingId\\\": \\\"SA4-P1-003\\\",\\n      \\\"rationale\\\": \\\"The exact REQ-004 controls pass, but the class the phase purpose names still attaches the creation workflow.\\\"\\n    },\\n    {\\n      \\\"id\\\": \\\"SL-004\\\",\\n      \\\"dimension\\\": \\\"correctness\\\",\\n      \\\"targetRefs\\\": [\\\".skilled/skills/system-skill-advisor/runtime/lib/command-attach.ts\\\"],\\n      \\\"bugClass\\\": \\\"boundary_parsing\\\",\\n      \\\"invariant\\\": \\\"A longer command name must not read as its shorter prefix, and a mode suffix must end the command name.\\\",\\n      \\\"searchActions\\\": [\\n        {\\\"method\\\": \\\"direct_read\\\", \\\"queryOrPath\\\": \\\"command-attach.ts:205-242\\\", \\\"result\\\": \\\"The continuation and mode-suffix checks cover both boundaries.\\\", \\\"evidenceRefs\\\": [\\\"command-attach.ts:228-232\\\"]},\\n        {\\\"method\\\": \\\"probe\\\", \\\"queryOrPath\\\": \\\"typedCommandIn on the changed test prompts\\\", \\\"result\\\": \\\"/deep:review:auto and /create:sk-skill-parent behave as pinned.\\\", \\\"evidenceRefs\\\": [\\\"tests/command-attach-guards.vitest.ts:390-420\\\"]}\\n      ],\\n      \\\"disposition\\\": \\\"ruled_out\\\",\\n      \\\"ruledOutReason\\\": \\\"The changed boundary tests pass and the probe finds no prefix or suffix leak.\\\",\\n      \\\"rationale\\\": \\\"No finding.\\\"\\n    },\\n    {\\n      \\\"id\\\": \\\"SL-005\\\",\\n      \\\"dimension\\\": \\\"correctness\\\",\\n      \\\"targetRefs\\\": [\\\".skilled/skills/system-skill-advisor/runtime/lib/scorer/fusion.ts\\\"],\\n      \\\"bugClass\\\": \\\"state_transition\\\",