ints\": [\"typed-command attach\", \"retired-command map\", \"/create:sk-skill start policy\"],\n      \"claim\": \"A refusal written with the retired command name still attaches the live command because the retired-name rewrite runs before the mention guard.\",\n      \"evidenceRefs\": [\"command-attach.ts:240\", \"command-attach.ts:256\", \"handlers/advisor-recommend.ts:500\"],\n      \"counterevidenceSought\": \"The compiled route for the same prompt returns defer, so the typed path is the live caller; the probe confirms the top row is sk-doc.\",\n      \"alternativeExplanation\": \"The retired name could be treated as a distinct command, but the map's comment says it reads as the replacement, so the guards should agree.\",\n      \"finalSeverity\": \"P1\",\n      \"confidence\": \"high\",\n      \"downgradeTrigger\": \"Downgrade to P2 if the retired name is deliberately excluded from the live command's refusal semantics.\"\n    },\n    {\n      \"id\": \"SA4-P1-002\",\n      \"severity\": \"P1\",\n      \"iteration\": 1,\n      \"title\": \"A coordinated refusal names the second command without a lead, so the typed path still delivers it\",\n      \"file\": \".skilled/skills/system-skill-advisor/runtime/lib/command-attach.ts:414\",\n      \"findingClass\": \"guard_gap\",\n      \"scopeProof\": \"The prompt is an ordinary refusal of two tracked commands; the typed path and handler are in scope, and no other module rewrites the lead.\",\n      \"affectedSurfaceHints\": [\"typed-command attach\", \"multi-command refusals\", \"/deep:research ask policy\"],\n      \"claim\": \"A refusal that coordinates two command names attaches the second one because the mention reader requires a separate lead before each occurrence.\",\n      \"evidenceRefs\": [\"command-attach.ts:414\", \"command-attach.ts:419\", \"command-attach.ts:360\"],\n      \"counterevidenceSought\": \"The compiled route returns defer and the scorer top is system-deep-loop; a single-command refusal is correctly withheld, so the gap is the coordinated form.\",\n      \"alternativeExplanation\": \"The reader may have refused only the first command and merely named the second, but 'do not run A or B' refuses both.\",\n      \"finalSeverity\": \"P1\",\n      \"confidence\": \"high\",\n      \"downgradeTrigger\": \"Downgrade to P2 if a coordinated refusal is judged a mention of both commands rather than a refusal of both.\"\n    },\n    {\n      \"id\": \"SA4-P1-003\",\n      \"severity\": \"P1\",\n      \"iteration\": 1,\n      \"title\": \"A correction inside one document still attaches the creation workflow when the sentence carries a generic creation word\",\n      \"file\": \".skilled/skills/system-skill-advisor/runtime/lib/command-attach.ts:487\",\n      \"findingClass\": \"guard_gap\",\n      \"scopeProof\": \"All four prompts are correction requests inside an existing readme; the compiled route for the sk-doc hub and the attach function are the declared target.\",\n      \"affectedSurfaceHints\": [\"small-edit gate\", \"/create:readme start policy\", \"correction prompts with verification clauses\"],\n      \"claim\": \"The small-edit gate treats generic creation words inside a correction clause as a request to create the whole document, so a correction prompt still receives /create:readme.\",\n      \"evidenceRefs\": [\"command-attach.ts:331\", \"command-attach.ts:487\"],\n      \"counterevidenceSought\": \"The two REQ-004 control prompts return no command, and the phase Out of Scope excludes edits with no correction word; these prompts name a typo or grammar error.\",\n      \"alternativeExplanation\": \"'new' or 'make sure' could be read as a request to author a fresh document, but the sentence's verb is fix and the object is an existing readme.\",\n      \"finalSeverity\": \"P1\",\n      \"confidence\": \"high\",\n      \"downgradeTrigger\": \"Downgrade to P2 if the creation-request guard is intentionally broad and these clauses are judged outside the correction class.\"\n    }\n  ],\n  \"traceabilityChecks\": {\n    \"spec_code\": {\"level\": \"core\", \"status\": \"partial\", \"notes\": \"REQ-004's two exact controls pass; three refusal/correction inputs still carry a command (SA4-P1-001..003).\"},\n    \"checklist_evidence\": {\"level\": \"core\", \"status\": \"pending\", \"notes\": \"No packet checklist claim in this iteration.\"},\n    \"feature_catalog_code\": {\"level\": \"overlay\", \"status\": \"pending\", \"notes\": \"Scheduled for iteration 3.\"},\n    \"skill_agent\": {\"level\": \"overlay\", \"status\": \"pending\", \"notes\": \"-\"},\n    \"agent_cross_runtime\": {\"level\": \"overlay\", \"status\": \"partial\", \"notes\": \"No runtime branch in the changed attach/handler files; live per-runtime proof belongs to the phase 007 arm.\"},\n    \"playbook_capability\": {\"level\": \"overlay\", \"status\": \"notApplicable\", \"notes\": \"No playbook surface changed.\"}\n  },\n  \"newFindingsRatio\": 1.0,\n  \"sessionId\": \"fanout-scorer-attach-4-1794669272137-9v23rz\",\n  \"generation\": 1,\n  \"lineageMode\": \"new\",\n  \"timestamp\": \"2026-11-14T15:36:00Z\",\n  \"durationMs\": 420000,\n  \"reviewDepthSchemaVersion\": 2,\n  \"reviewDepthApplicability\": {\n    \"scopeClass\": \"standard\",\n    \"enforcement\": \"strict\",\n    \"reason\": \"Eleven changed source and test files across the attach, scorer and recommend handler modules.\",\n    \"evidenceRefs\": [\"review/review-scope-4.txt:12-30\", \".skilled/skills/system-skill-advisor/runtime/lib/command-attach.ts:1-522\"]\n  },\n  \"targetSelection\": {\n    \"selectedTargets\": [\n      \".skilled/skills/system-skill-advisor/runtime/lib/command-attach.ts\",\n      \".skilled/skills/system-skill-advisor/runtime/lib/scorer/fusion.ts\",\n      \".skilled/skills/system-skill-advisor/runtime/handlers/advisor-recommend.ts\",\n      \".skilled/skills/system-skill-advisor/runtime/tests/command-attach-guards.vitest.ts\",\n      \".skilled/skills/system-skill-advisor