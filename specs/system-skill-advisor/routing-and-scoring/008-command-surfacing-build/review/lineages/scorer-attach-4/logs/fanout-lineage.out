t.*holdout\\\" .skilled/skills/system-skill-advisor/runtime/lib/command-attach.ts .skilled/skills/system-skill-advisor/runtime/lib/scorer/fusion.ts .skilled/skills/system-skill-advisor/runtime/lib/scorer/doctor-helper-handoff.ts .skilled/skills/system-skill-advisor/runtime/lib/scorer/projection.ts .skilled/skills/system-skill-advisor/runtime/handlers/advisor-recommend.ts .skilled/skills/system-skill-advisor/runtime/tests/command-attach-guards.vitest.ts .skilled/skills/system-skill-advisor/runtime/tests/command-meaning-anchor.vitest.ts .skilled/skills/system-skill-advisor/runtime/tests/doctor-helper-handoff.vitest.ts .skilled/skills/system-skill-advisor/runtime/tests/scorer/doctor-handoff-command.vitest.ts .skilled/skills/system-skill-advisor/runtime/tests/scorer/typed-command-owner.vitest.ts | head -20\"}"},"time":{"start":1794670370072,"end":1794670370323}}}}
