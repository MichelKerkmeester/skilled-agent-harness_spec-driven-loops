mand-attach.ts\"],\n      \"bugClass\": \"guard_gap\",\n      \"hypothesis\": \"A coordinated refusal leaves the second command unled, so the typed path delivers it.\",\n      \"searchActions\": [\n        {\"method\": \"direct_read\", \"queryOrPath\": \"command-attach.ts:360-431\", \"result\": \"Leads are anchored directly before each occurrence; the gap cannot cross a command token.\", \"evidenceRefs\": [\"command-attach.ts:414\", \"command-attach.ts:419\"]},\n        {\"method\": \"probe\", \"queryOrPath\": \"typedCommandForTop('system-deep-loop', 'do not run /deep:review or /deep:research')\", \"result\": \"Returns /deep:research with policy ask.\", \"evidenceRefs\": [\"probes/probe-scorer.vitest.ts\"]}\n      ],\n      \"disposition\": \"finding\",\n      \"linkedFindingId\": \"SA4-P1-002\",\n      \"rationale\": \"The top row for the prompt is system-deep-loop, the command's owner.\"\n    },\n    {\n      \"id\": \"SL-003\",\n      \"dimension\": \"correctness\",\n      \"targetRefs\": [\".skilled/skills/system-skill-advisor/runtime/lib/command-attach.ts\"],\n      \"bugClass\": \"guard_gap\",\n      \"hypothesis\": \"Generic creation words in a correction clause stand the small-edit gate down.\",\n      \"searchActions\": [\n        {\"method\": \"direct_read\", \"queryOrPath\": \"command-attach.ts:324-339,478-492\", \"result\": \"The creation regex includes make, new, add a and need an.\", \"evidenceRefs\": [\"command-attach.ts:331\", \"command-attach.ts:487\"]},\n        {\"method\": \"probe\", \"queryOrPath\": \"compiled-route and attachCommand for four correction prompts\", \"result\": \"All route to sk-create-readme and return /create:readme.\", \"evidenceRefs\": [\"probes/probe-scorer.vitest.ts\"]}\n      ],\n      \"disposition\": \"finding\",\n      \"linkedFindingId\": \"SA4-P1-003\",\n      \"rationale\": \"The exact REQ-004 controls pass, but the class the phase purpose names still attaches the creation workflow.\"\n    },\n    {\n      \"id\": \"SL-004\",\n      \"dimension\": \"correctness\",\n      \"targetRefs\": [\".skilled/skills/system-skill-advisor/runtime/lib/command-attach.ts\"],\n      \"bugClass\": \"boundary_parsing\",\n      \"invariant\": \"A longer command name must not read as its shorter prefix, and a mode suffix must end the command name.\",\n      \"searchActions\": [\n        {\"method\": \"direct_read\", \"queryOrPath\": \"command-attach.ts:205-242\", \"result\": \"The continuation and mode-suffix checks cover both boundaries.\", \"evidenceRefs\": [\"command-attach.ts:228-232\"]},\n        {\"method\": \"probe\", \"queryOrPath\": \"typedCommandIn on the changed test prompts\", \"result\": \"/deep:review:auto and /create:sk-skill-parent behave as pinned.\", \"evidenceRefs\": [\"tests/command-attach-guards.vitest.ts:390-420\"]}\n      ],\n      \"disposition\": \"ruled_out\",\n      \"ruledOutReason\": \"The changed boundary tests pass and the probe finds no prefix or suffix leak.\",\n      \"rationale\": \"No finding.\"\n    },\n    {\n      \"id\": \"SL-005\",\n      \"dimension\": \"correctness\",\n      \"targetRefs\": [\".skilled/skills/system-skill-advisor/runtime/lib/scorer/fusion.ts\"],\n      \"bugClass\": \"state_transition\",\n      \"hypothesis\": \"The scorer's no-edit gate and the hub attach path disagree on read-only commands.\",\n      \"searchActions\": [\n        {\"method\": \"direct_read\", \"queryOrPath\": \"fusion.ts:1216-1231 and command-attach.ts:470-472\", \"result\": \"The scorer keeps read-only rows; the hub path withholds every command on a no-edit prompt.\", \"evidenceRefs\": [\"fusion.ts:1223\", \"command-attach.ts:472\"]}\n      ],\n      \"disposition\": \"deferred\",\n      \"deferredReason\": \"The security iteration reviews the path split and needs a compiled-hub read-only route to prove reach.\",\n      \"rationale\": \"No finding yet.\"\n    },\n    {\n      \"id\": \"SL-006\",\n      \"dimension\": \"correctness\",\n      \"targetRefs\": [\".skilled/sk