ut\\\", direction: \\\"A changed path reads or prints a holdout row\\\", reason: \\\"only tune-id-selected corpus tests read the file, and they assert the split\\\", iteration: 2 });\\nrows.push({ type: \\\"ruled_out\\\", direction: \\\"A command offer differs by runtime in the changed modules\\\", reason: \\\"no runtime branch in the attach or handler modules\\\", iteration: 2 });\\nfs.writeFileSync(base + \\\"/deltas/iter-002.jsonl\\\", rows.map((r) => JSON.stringify(r)).join(\\\"\\\\n\\\") + \\\"\\\\n\\\");\\nconsole.log(\\\"delta rows:\\\", rows.length);\\n' && node .skilled/skills/system-deep-loop/runtime/scripts/reduce-state.cjs specs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build --artifact-dir specs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/review/lineages/scorer-attach-4 --create-missing-anchors; echo \\\"REDUCE_EXIT:$?\\\"\"}"},"time":{"start":1794670484437,"end":1794670484980}}}}
