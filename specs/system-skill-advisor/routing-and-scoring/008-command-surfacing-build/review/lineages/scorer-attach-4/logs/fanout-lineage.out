amed is still typed from habit. Its old name reads as\n+// the command that replaced it, so the reader lands on the live workflow and\n+// not on whatever skill the leftover words happen to score for. The old name\n+// gets no command file of its own: this table is the only place it lives.\n+const RETIRED_COMMANDS: Readonly<Record<string, string>> = {\n+  '/create:skill': '/create:sk-skill',\n+};\n \n export function typedCommandIn(prompt: string): string | undefined {\n   const lowered = prompt.toLowerCase();\n   let found: string | undefined;\n-  for (const key of Object.keys(TRACKED_COMMANDS)) {\n+  for (const key of [...Object.keys(TRACKED_COMMANDS), ...Object.keys(RETIRED_COMMANDS)]) {\n     let index = lowered.indexOf(key);\n     while (index !== -1) {\n       const before = index === 0 ? '' : lowered[index - 1];\n       const after = lowered[index + key.length] ?? '';\n       const next = lowered[index + key.length + 1] ?? '';\n       const startsAtBoundary = before === '' || COMMAND_START_BOUNDARY.test(before);\n+      const hasModeSuffix = MODE_SUFFIX.test(lowered.slice(index + key.length));\n       const continuesName =\n-        COMMAND_CONTINUATION.test(after) || ((after === '/' || after === '.') && WORD_CHARACTER.test(next));\n+        !hasModeSuffix\n+        && (COMMAND_CONTINUATION.test(after) || ((after === '/' || after === '.') && WORD_CHARACTER.test(next)));\n       const endsAtBoundary = after === '' || !continuesName;\n       if (startsAtBoundary && endsAtBoundary) {\n         if (found === undefined || key.length > found.length) found = key;\n@@ -224,6 +237,7 @@ export function typedCommandIn(prompt: string): string | undefined {\n       index = lowered.indexOf(key, index + 1);\n     }\n   }\n+  if (found !== undefined && Object.hasOwn(RETIRED_COMMANDS, found)) return RETIRED_COMMANDS[found];\n   return found;\n }\n \n@@ -239,6 +253,7 @@ export interface TypedCommand {\n export function typedCommandForTop(topSkillId: string, prompt: string): TypedCommand | undefined {\n   const command = typedCommandIn(prompt);\n   if (command === undefined || !Object.hasOwn(TRACKED_COMMANDS, command)) return undefined;\n+  if (commandOnlyMentioned(prompt, command)) return undefined;\n   const row = TRACKED_COMMANDS[command];\n   const sameCommandRow = commandRowFor(topSkillId)?.command === command;\n   if (topSkillId !== row.ownerSkillId && !sameCommandRow) return undefined;\n@@ -273,6 +288,26 @@ export const DEPTH_WORDING: readonly string[] = [\n   'everything you can',\n ];\n \n+// A creation workflow scaffolds, reviews and validates a whole document, which is\n+// the wrong size for a correction inside one. The list below is the vocabulary\n+// that marks that correction, and a line number points at one the same way.\n+export const SMALL_EDIT_WORDING: readonly string[] = [\n+  'typo',\n+  'typos',\n+  'spelling',\n+  'misspelled',\n+  'misspelling',\n+  'grammar',\n+  'punctuation',\n+  'wording',\n+  'broken link',\n+  'broken links',\n+  'dead link',\n+  'dead links',\n+  'one line',\n+  'single line',\n+];\n+\n // A phrase may carry punctuation a regex would read as a metacharacter, so it is\n // escaped before it is trusted as a pattern.\n function escapePhrase(phrase: string): string {\n@@ -284,6 +319,25 @@ function escapePhrase(phrase: string): string {\n // multi-word phrase still has to match as a whole.\n const DEPTH_REQUEST = new RegExp(`\\\\b(?:${DEPTH_WORDING.map(escapePhrase).join('|')})\\\\b`);\n \n+// The line alternative is a pattern rather than a phrase, so it is appended raw\n+// beside the escaped vocabulary instead of being escaped with it.\n+const SMALL_EDIT_REQUEST = new RegExp(\n+  `\\\\b(?:${SMALL_EDIT_WORDING.map(escapePhrase).join('|')}|line \\\\d+)\\\\b`,\n+);\n+\n+// A request that asks for a document to be created or written wants the whole\n+// document, even when it names a correction to make afterwards, so this check\n+// stands the small-edit gate down.\n+const CREATION_REQUEST = /\\b(?:creat(?:e|es|ing)|writ(?:e|es|ing)|author(?:ing)?|draft(?:ing)?|scaffold(?:ing)?|generat(?:e|es|ing)|mak(?:e|es|ing)|new|build(?:ing)?|set up|add an?|need an?)\\b/;\n+\n+// A small edit names the correction to make, so the verb is what marks one.\n+const CORRECTION_VERB = /\\b(?:fix|correct|update|edit|change|tweak|repair)\\b/;\n+\n+// These three creation commands write a whole document that is later corrected in\n+// place, so a correction request names an edit to it rather than a new one. Every\n+// other creation command names a purpose that a correction word belongs to.\n+const SMALL_EDIT_GATED_COMMANDS: ReadonlySet<string> = new Set(['/create:readme', '/create:feature-catalog', '/create:manual-testing-playbook']);\n+\n // Wording that asks for an answer and rules out a change. One pattern serves\n // every gate that has to honour it, so a new gate cannot drift from the first.\n // Words alone cannot tell \"make no changes to the files\" from a change request\n@@ -299,6 +353,84 @@ export function isNoEditRequest(text: string): boolean {\n   return NO_EDIT_REQUEST.test(text.toLowerCase().replace(/[\\u2018\\u2019]/g, \"'\"));\n }\n \n+// A refusal or a question reaches its command through a use verb, so the two\n+// lists below share this one. A gap holds one or two plain words and no\n+// punctuation, because a comma ends the clause that holds the lead.\n+export const COMMAND_USE_VERB = '(?:run|start|use|invoke|launch|execute|call|trigger|open|rerun|re-run|kick off)';\n+export const COMMAND_GAP_WORDS = \"(?:[a-z']+ ){0,2}\";\n+\n+// `why not` proposes the command rather than refusing it, so the word refuses\n+// only where no `why` stands before it.\n+const COMMAND_NOT_WORD = '(?<!\\\\bwhy )not';\n+\n+// A command the reader refuses is named without being asked for, so this list\n+// holds the leads that mark that naming. A lead must sit directly before the\n+// command so a later clause cannot refuse an earlier request, and a gap holds\n+// plain words only so a refusal before a comma cannot swallow the request after\n+// it. A reader who stops using a command names it only to refuse it.\n+export const COMMAND_DECLINE_LEADS: readonly string[] = [\n+  `(?:do not|don't|dont|never|${COMMAND_NOT_WORD}|won't|wont|no longer|cannot|can't|no need to|need not|needn't) (?!(?:forget|hesitate|fail|mind)\\\\b)${COMMAND_GAP_WORDS}${COMMAND_USE_VERB} ${COMMAND_GAP_WORDS}`,\n+  `(?:skip|skipping|without|instead of|rather than|avoid|stop|stopped|quit|${COMMAND_NOT_WORD}) (?:(?!${COMMAND_USE_VERB}\\\\b)[a-z']+ ){0,2}`,\n+];\n+\n+// A command the reader asks about is named without being asked for, so this list\n+// holds the leads that mark that naming. A lead must sit directly before the\n+// command so a later clause cannot turn an earlier request into a question, and\n+// a gap holds plain words only so a question before a comma cannot swallow the\n+// request after it.\n+export const COMMAND_ASK_LEADS: readonly string[] = [\n+  \"(?:what does|what is|what's|what would|what will|what did|how does|how did|why does|why did|explain|describe|tell me what|tell me how|tell me about|tell me why|difference between|differ from|differs from|different from|undo what|ran|already ran|was running) (?:the )?(?:command )?\",\n+  `(?:should i|should we|do i need to|when would i) ${COMMAND_USE_VERB} (?:the )?(?:command )?`,\n+];\n+\n+// A bare ask word opens a statement as often as a question, so it marks a naming\n+// only when the command it precedes is followed by a question mark before the\n+// sentence ends, or when the lead itself opens a sentence, which a question mark ends as a full stop does.\n+export const COMMAND_BARE_ASK_LEAD = '(?:is|does|can|will|would) ';\n+\n+// A clause that opens with a use verb and `it` asks for the command an earlier\n+// clause only named, so a naming such as `not run /x yet, please start it`\n+// becomes a request. The clause has to open that way so `I will run it` stays a\n+// statement.\n+const COMMAND_ASKED_BY_PRONOUN = new RegExp(`(?:^|[,.;!?\\\\n]) *(?:(?:and|then|so|please|now|just|go ahead and) )*${COMMAND_USE_VERB} it\\\\b`);\n+\n+// A prompt names a command to refuse it or to ask about it as often as it names\n+// one to run it, so an offer must read the naming before it trusts the name. The\n+// text is folded first, because a keyed apostrophe or a run of spaces must not\n+// hide the lead, while a line break survives as the sentence end it is. The\n+// boundary before the lead keeps a command name from matching inside a word or a\n+// path, and the boundary after it keeps a longer command name from reading as the\n+// shorter one. Every occurrence has to carry a lead, because one led naming does\n+// not turn a later unled naming into a request.\n+export function commandOnlyMentioned(prompt: string, command: string): boolean {\n+  const text = prompt\n+    .toLowerCase()\n+    .replace(/[\\u2018\\u2019]/g, \"'\")\n+    .replace(/[^\\S\\n]+/g, ' ')\n+    .replace(/ *\\n\\s*/g, '\\n');\n+  const name = escapePhrase(command.toLowerCase());\n+  const occurrences = [...text.matchAll(new RegExp(`(?:^|[^a-z0-9_/])${name}(?![a-z0-9_-])`, 'g'))];\n+  if (occurrences.length === 0) return false;\n+  return occurrences.every((occurrence) => {\n+    const nameEnd = (occurrence.index ?? 0) + occurrence[0].length;\n+    const before = text.slice(0, nameEnd);\n+    const tail = text.slice(nameEnd);\n+    if (COMMAND_ASKED_BY_PRONOUN.test(tail.split(/(?:^|[\\s,;(])\\/[a-z][a-z0-9_-]*(?::[a-z][a-z0-9_-]*)?(?![a-z0-9_\\/-]|\\.[a-z0-9])/)[0])) return false;\n+    const led = [...COMMAND_DECLINE_LEADS, ...COMMAND_ASK_LEADS].some((lead) => (\n+      new RegExp(`(?:^|[^a-z0-9_/])${lead}${name}$`).test(before)\n+    ));\n+    if (led) return true;\n+    const bareLead = new RegExp(`(?:^|[^a-z0-9_/])${COMMAND_BARE_ASK_LEAD}${name}$`).test(before);\n+    if (!bareLead) return false;\n+    const sentenceEnd = tail.search(/[.!\\n]/);\n+    const sentence = sentenceEnd === -1 ? tail : tail.slice(0, sentenceEnd);\n+    // A chat question often leaves the question mark off, so a bare ask word that\n+    // opens a sentence still asks about the command.\n+    return sentence.includes('?')\n+      || new RegExp(`(?:^|[.!?\\\\n] *)${COMMAND_BARE_ASK_LEAD}${name}$`).test(before);\n+  });\n+}\n+\n // A compiled route arrives as unvalidated JSON from a separate process, so the\n // shape is narrowed here rather than trusted. Arrays count as objects in\n // JavaScript and would let `action` read off an unrelated field, so they are\n@@ -346,6 +478,19 @@ export function attachCommand(\n   const commands = modeCommands[skillId];\n   if (!Object.prototype.hasOwnProperty.call(commands, workflowMode)) return undefined;\n \n+  // A route can pick the mode because the prompt named its command, so a naming\n+  // that refused or asked about the command must not produce the offer.\n+  if (commandOnlyMentioned(prompt, commands[workflowMode])) return undefined;\n+\n+  // A correction inside one document is not a request for a creation workflow,\n+  // which scaffolds, reviews and validates a whole one.\n+  if (\n+    SMALL_EDIT_GATED_COMMANDS.has(commands[workflowMode])\n+    && SMALL_EDIT_REQUEST.test(prompt.toLowerCase())\n+    && !CREATION_REQUEST.test(prompt.toLowerCase())\n+    && CORRECTION_VERB.test(prompt.toLowerCase())\n+  ) return undefined;\n+\n   // Deep-loop commands are the ones that commit the reader to a long, multi-pass\n   // run, so they are offered only when the prompt asks for that effort. Typing\n   // the command being attached is itself the ask, while typing another deep-loop\ndiff --git a/.skilled/skills/system-skill-advisor/runtime/lib/scorer/doctor-helper-handoff.ts b/.skilled/skills/system-skill-advisor/runtime/lib/scorer/doctor-helper-handoff.ts\nindex e509457f6e..2e45ac1b7e 100644\n--- a/.skilled/skills/system-skill-advisor/runtime/lib/scorer/doctor-helper-handoff.ts\n+++ b/.skilled/skills/system-skill-advisor/runtime/lib/scorer/doctor-helper-handoff.ts\n@@ -17,8 +17,10 @@\n //      vocabulary (\"start a deep review loop\"), so a weak match also needs the\n //      prompt to name a problem. Beside a passing skill only a strong cue\n //      counts, because bare words such as \"missing\" or \"broken\" are common in\n-//      ordinary work. With no skill passing, a strong ranker match stands in\n-//      for the cue.\n+//      ordinary work. A skill that passed with none of its own phrases in the\n+//      prompt is the exception: there a bare word with a strong ranker match\n+//      leads. With no skill passing, a weak cue or no cue needs a strong ranker match,\n+//      and only a strong cue hands off on the lower score.\n \n // ───────────────────────────────────────────────────────────────────\n // 1. IMPORTS\n@@ -44,6 +46,13 @@ export const DOCTOR_HELPER_MIN_SCORE = 6;\n /** Helper rank score that stands in for a cue when no skill passes. */\n export const DOCTOR_HELPER_UNCUED_MIN_SCORE = 10;\n \n+/**\n+ * Helper rank score a weak cue needs when no skill passes. A weak cue is a bare\n+ * word ordinary work also uses, so it needs a stronger ranker match than a\n+ * strong cue, though less than no cue.\n+ */\n+export const DOCTOR_HELPER_WEAK_CUE_MIN_SCORE = 9;\n+\n // A strong cue says a state is wrong or asks for a health or switch change, so\n // it can surface the helper beside a passing skill. A tool or command that does\n // not show up or appear is that wrong state, like one that is not registered or\n@@ -143,8 +152,11 @@ function loadHelper(workspaceRoot: string): LoadedHelper | null {\n \n /** The strongest problem cue the prompt carries. */\n export function doctorProblemCue(prompt: string): 'strong' | 'weak' | null {\n-  if (STRONG_PROBLEM_CUE.test(prompt)) return 'strong';\n-  if (WEAK_PROBLEM_CUE.test(prompt)) return 'weak';\n+  // Many keyboards type a contraction with a curly apostrophe, and the cue\n+  // patterns spell it straight.\n+  const folded = prompt.replace(/[‘’]/g, \"'\");\n+  if (STRONG_PROBLEM_CUE.test(folded)) return 'strong';\n+  if (WEAK_PROBLEM_CUE.test(folded)) return 'weak';\n   return null;\n }\n \ndiff --git a/.skilled/skills/system-skill-advisor/runtime/lib/scorer/fusion.ts b/.skilled/skills/system-skill-advisor/runtime/lib/scorer/fusion.ts\nindex fa4af6d450..7f081a94f3 100644\n--- a/.skilled/skills/system-skill-advisor/runtime/lib/scorer/fusion.ts\n+++ b/.skilled/skills/system-skill-advisor/runtime/lib/scorer/fusion.ts\n@@ -17,7 +17,14 @@ import {\n   speckitMetrics,\n } from '../metrics.js';\n import { normalize } from '../affordance-normalizer.js';\n-import { COMMAND_ROWS, isNoEditRequest, TRACKED_COMMANDS, typedCommandIn } from '../command-attach.js';\n+import {\n+  COMMAND_ROWS,\n+  commandOnlyMentioned,\n+  commandRowFor,\n+  isNoEditRequest,\n+  TRACKED_COMMANDS,\n+  typedCommandIn,\n+} from '../command-attach.js';\n import { scoreDerivedLane } from './lanes/derived.js';\n import { scoreExplicitLane } from './lanes/explicit.js';\n import { scoreGraphCausalLaneSplit } from './lanes/graph-causal.js';\n@@ -27,6 +34,7 @@ import { applyExecutorDelegationOverride } from './executor-delegation.js';\n import {\n   DOCTOR_HELPER_BRIDGE_ID,\n   DOCTOR_HELPER_UNCUED_MIN_SCORE,\n+  DOCTOR_HELPER_WEAK_CUE_MIN_SCORE,\n   doctorProblemCue,\n   genericRepairCue,\n   matchDoctorProblem,\n@@ -731,6 +739,13 @@ export function readOnlyRouteAllowed(promptLower: string, skill: SkillProjection\n   if (skillId === 'sk-code' && /\\bgate-3-classifier\\.ts\\b/.test(promptLower)) {\n     return true;\n   }\n+  // Reading history is a git task even though its verb reads as a read-only\n+  // explainer. A lift applies to any prompt, so only a read-only question is\n+  // lifted, and only when it names git, a commit-history object or a branch ref.\n+  if (skillId === 'sk-git' && isReadOnlyExplainer(promptLower)\n+    && /\\b(git|commit (?:history|log)|(?:recent|latest) commits?|last (?:\\w+ )?commits?|branch(?:es)? (?:main|master|develop))\\b/.test(promptLower)) {\n+    return true;\n+  }\n   return false;\n }\n \n@@ -888,6 +903,7 @@ export function requireCommandPhraseAnchor(\n   confidenceThreshold: number = DEFAULT_CONFIDENCE_THRESHOLD,\n   meaningPassed: Set<string> = new Set(),\n   meaningEligible: (skillId: string) => boolean = () => true,\n+  uncertaintyThreshold: number = DEFAULT_UNCERTAINTY_THRESHOLD,\n ): AdvisorScoredRecommendation[] {\n   const cosineByCommandId = new Map<string, number>();\n   for (const recommendation of ranked) {\n@@ -916,9 +932,12 @@ export function requireCommandPhraseAnchor(\n     if (cosine !== undefined\n       && cosine >= COMMAND_MEANING_MIN_COSINE\n       && cosine - leadingOtherCosine(recommendation.skill) >= COMMAND_MEANING_MARGIN\n+      && recommendation.uncertainty <= uncertaintyThreshold\n       && meaningEligible(recommendation.skill)) {\n       // A meaning match alone rarely clears the threshold on its lane weight, so\n       // the anchor lifts the row to it rather than leaving it scored but unpassed.\n+      // A row the hooks would drop for its uncertainty must not be reported as\n+      // passing, or the direct CLI call shows a head no hook renders.\n       meaningPassed.add(recommendation.skill);\n       return {\n         ...recommendation,\n@@ -1128,17 +1147,29 @@ export function applyDoctorHelperHandoff(\n     return [...ranked];\n   }\n   if (isDoctorCommandTyped(context.promptLower)) return [...ranked];\n-  const skillPasses = ranked.some((recommendation) => (\n+  const passingSkills = ranked.filter((recommendation) => (\n     !isDoctorBridge(recommendation) && recommendation.passes_threshold\n   ));\n+  const skillPasses = passingSkills.length > 0;\n+  // A skill that passed with none of its own phrases in the prompt passed on\n+  // shared single words. A command is not allowed to pass that way at all, so\n+  // such a pass does not outweigh a named problem the ranker matches strongly.\n+  const wordsOnlyPass = skillPasses && passingSkills.every((recommendation) => (\n+    !recommendation.laneContributions.some((contribution) => (\n+      contribution.lane === 'explicit_author' && contribution.rawScore > 0\n+    ))\n+  ));\n   const cue = doctorProblemCue(context.prompt);\n-  if (skillPasses && cue !== 'strong') return [...ranked];\n+  const weakCueOverWords = wordsOnlyPass && cue === 'weak';\n+  if (skillPasses && cue !== 'strong' && !weakCueOverWords) return [...ranked];\n \n   const helperSkill = context.projection.skills.find((skill) => skill.id === DOCTOR_HELPER_BRIDGE_ID);\n   if (!helperSkill) return [...ranked];\n   const match = matchDoctorProblem(context.prompt, context.workspaceRoot);\n   if (!match && (skillPasses || !genericRepairCue(context.prompt))) return [...ranked];\n   if (match && cue === null && match.score < DOCTOR_HELPER_UNCUED_MIN_SCORE) return [...ranked];\n+  if (match && cue === 'weak' && match.score < DOCTOR_HELPER_WEAK_CUE_MIN_SCORE) return [...ranked];\n+  if (match && weakCueOverWords && match.score < DOCTOR_HELPER_UNCUED_MIN_SCORE) return [...ranked];\n \n   const handoffId = (match ? runnableDoctorBridgeId(match.runnable, context.projection) : undefined) ?? DOCTOR_HELPER_BRIDGE_ID;\n   const handoffSkill = context.projection.skills.find((skill) => skill.id === handoffId) ?? helperSkill;\n@@ -1157,11 +1188,46 @@ export function applyDoctorHelperHandoff(\n     dominantLane: existing?.dominantLane ?? null,\n     lifecycleStatus: handoffSkill.lifecycleStatus,\n   };\n-  const withHandoff = [\n-    ...ranked.filter((recommendation) => recommendation.skill !== handoffId),\n-    handoff,\n-  ];\n-  return keepPassingSkillsAboveDoctorBridges(withHandoff, context.promptLower, context.leadPhrasesById);\n+  const others = ranked.filter((recommendation) => recommendation.skill !== handoffId);\n+  if (weakCueOverWords) return [handoff, ...others];\n+  return keepPassingSkillsAboveDoctorBridges([...others, handoff], context.promptLower, context.leadPhrasesById);\n+}\n+\n+// A command row passes on its typed name, so a prompt that names the command to\n+// refuse it or ask about it would otherwise pass that row. The skill behind the\n+// command keeps its own pass, because refusing the command is not refusing the\n+// skill.\n+export function withholdMentionedCommands(\n+  ranked: readonly AdvisorScoredRecommendation[],\n+  prompt: string,\n+): AdvisorScoredRecommendation[] {\n+  return ranked.map((recommendation) => {\n+    if (recommendation.kind !== 'command' || !recommendation.passes_threshold) return recommendation;\n+    // A row names a command with its subcommands, while a prompt names only the\n+    // base, so both sides are compared on the base alone.\n+    const command = commandRowFor(recommendation.skill)?.command.split(' ')[0];\n+    if (command === undefined || !commandOnlyMentioned(prompt, command)) return recommendation;\n+    return { ...recommendation, passes_threshold: false };\n+  });\n+}\n+\n+// A reader who ruled out a change must not be handed a command that writes,\n+// whichever path chose it. A command that only reads is still the answer.\n+export function withholdWritingCommandsOnNoEdit(\n+  ranked: readonly AdvisorScoredRecommendation[],\n+  promptLower: string,\n+): AdvisorScoredRecommendation[] {\n+  if (!isNoEditRequest(promptLower)) return [...ranked];\n+  return ranked.map((recommendation) => {\n+    if (recommendation.kind !== 'command' || !recommendation.passes_threshold) return recommendation;\n+    if (commandRowFor(recommendation.skill)?.mutating === 'read-only') return recommendation;\n+    // A command the reader typed and asked for is the request, and the no-edit words limit its scope.\n+    const base = commandRowFor(recommendation.skill)?.command.split(' ')[0];\n+    if (base !== undefined\n+      && typedCommandIn(promptLower) === base\n+      && !commandOnlyMentioned(promptLower, base)) return recommendation;\n+    return { ...recommendation, passes_threshold: false };\n+  });\n }\n \n // A typed command with no scorer row of its own can only reach the reader through\n@@ -1173,6 +1239,9 @@ export function rankTypedCommandOwnerFirst(\n ): AdvisorScoredRecommendation[] {\n   const command = typedCommandIn(promptLower);\n   if (command === undefined || !Object.hasOwn(TRACKED_COMMANDS, command)) return [...ranked];\n+  // A command the reader refused must not pull its owner to the front, because\n+  // the ranking would then lead with the skill that offers it.\n+  if (commandOnlyMentioned(promptLower, command)) return [...ranked];\n   const row = TRACKED_COMMANDS[command];\n   if (row.scorerRow) return [...ranked];\n   const ownerIndex = ranked.findIndex((recommendation) => (\n@@ -1524,6 +1593,7 @@ export function scoreAdvisorPrompt(prompt: string, options: AdvisorScoringOption\n     options.confidenceThreshold ?? DEFAULT_CONFIDENCE_THRESHOLD,\n     commandMeaningPassed,\n     (skillId) => commandMeaningEligible(promptLower, readOnlyExplainer, projectionSkillById.get(skillId)),\n+    options.uncertaintyThreshold ?? DEFAULT_UNCERTAINTY_THRESHOLD,\n   );\n   const leadPhrasesById = new Map<string, readonly string[]>();\n   for (const skill of projection.skills) {\n@@ -1541,6 +1611,8 @@ export function scoreAdvisorPrompt(prompt: string, options: AdvisorScoringOption\n     uncertaintyThreshold: options.uncertaintyThreshold ?? DEFAULT_UNCERTAINTY_THRESHOLD,\n     leadPhrasesById,\n   });\n+  ranked = withholdMentionedCommands(ranked, prompt);\n+  ranked = withholdWritingCommandsOnNoEdit(ranked, promptLower);\n   ranked = rankTypedCommandOwnerFirst(ranked, promptLower);\n \n   const passing = ranked.filter((recommendation) => recommendation.passes_threshold);\ndiff --git a/.skilled/skills/system-skill-advisor/runtime/lib/scorer/projection.ts b/.skilled/skills/system-skill-advisor/runtime/lib/scorer/projection.ts\nindex d12047cf8b..c0f472219f 100644\n--- a/.skilled/skills/system-skill-advisor/runtime/lib/scorer/projection.ts\n+++ b/.skilled/skills/system-skill-advisor/runtime/lib/scorer/projection.ts\n@@ -125,7 +125,7 @@ export const GENERATED_COMMAND_BRIDGES: readonly CommandBridgeProjection[] = [\n     category: 'command',\n     name: '/doctor:setup',\n     description: '',\n-    keywords: ['set up skilled', 'help me set up skilled', 'is my skilled install healthy', 'skilled setup check', 'run the doctor setup checks', 'getting started with skilled', 'overview of every doctor command', 'model server or helper process still running after the session closed', 'list every check this project has', 'tell me what to fix where it fails', 'which checks fail and what to fix', 'run every check in this project', 'show me every check and the fix'],\n+    keywords: ['set up skilled', 'help me set up skilled', 'is my skilled install healthy', 'skilled setup check', 'run the doctor setup checks', 'getting started with skilled', 'overview of every doctor command', 'model server or helper process still running after the session closed', 'list every check this project has', 'run every check in this project'],\n     domains: ['doctor', 'command'],\n     intentSignals: ['/doctor:setup'],\n     readOnly: true,\n@@ -387,7 +387,7 @@ export const GENERATED_COMMAND_BRIDGES: readonly CommandBridgeProjection[] = [\n     category: 'command',\n     name: '/doctor:update',\n     description: '',\n-    keywords: ['doctor update command', 'update skills to latest release', 'skilled release update', 'update skilled to the latest release', 'check for skilled updates', 'is there a newer skilled release', 'update my project to a newer skilled release', 'move my project to the newer spec-kit release', 'is there a newer release of the toolkit', 'what changed in the newer release', 'are we on the latest release and what changed', 'check whether a newer version exists and what changed'],\n+    keywords: ['doctor update command', 'update skills to latest release', 'skilled release update', 'update skilled to the latest release', 'check for skilled updates', 'is there a newer skilled release', 'update my project to a newer skilled release', 'move my project to the newer spec-kit release', 'is there a newer release of the toolkit'],\n     domains: ['doctor', 'command'],\n     intentSignals: ['/doctor:update'],\n     derivedTriggers: [],\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\": \"git -C /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research diff 0cdc9fa3ef -- .skilled/skills/system-skill-advisor/runtime/handlers/advisor-recommend.ts .skilled/skills/system-skill-advisor/runtime/lib/command-attach.ts .skilled/skills/system-skill-advisor/runtime/lib/scorer/doctor-helper-handoff.ts .skilled/skills/system-skill-advisor/runtime/lib/scorer/fusion.ts .skilled/skills/system-skill-advisor/runtime/lib/scorer/projection.ts\"}"},"time":{"start":1794669406041,"end":1794669406508}}}}
