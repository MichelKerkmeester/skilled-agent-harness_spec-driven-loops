(workspaceRoot, '.skilled', 'bin', 'compiled-route.cjs');\n386-  if (!frontDoorReadsPromptFromStdin(frontDoor)) {\n387-    emitCompiledRoutingBreadcrumb(`compiled-route front door cannot read the prompt from stdin; skipping hub=${skillId}`);\n388-    return undefined;\n389-  }\n390-  try {\n391-    const args = [\n.skilled/skills/system-skill-advisor/runtime/handlers/advisor-recommend.ts:42:  COMPILED_ROUTING_HUBS,\n.skilled/skills/system-skill-advisor/runtime/handlers/advisor-recommend.ts:384:  if (!COMPILED_ROUTING_HUBS.has(skillId)) return undefined;\n.skilled/skills/system-skill-advisor/runtime/handlers/advisor-recommend.ts:387:    emitCompiledRoutingBreadcrumb(`compiled-route front door cannot read the prompt from stdin; skipping hub=${skillId}`);\n.skilled/skills/system-skill-advisor/runtime/handlers/advisor-recommend.ts:423:      `compiled-route subprocess failed for hub=${skillId}: ${error instanceof Error ? error.message : String(error)}${detail}`,\n.skilled/skills/system-skill-advisor/runtime/handlers/advisor-recommend.ts:443:  // compiled-eligible hubs (mirrors the runtime resolver's own default-on\n.skilled/skills/system-skill-advisor/runtime/handlers/advisor-recommend.ts:444:  // cohort), so unset attaches compiledRoute for those hubs; the kill-switch\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"42:  COMPILED_ROUTING_HUBS,\n43-  compiledRoutingEnabledForHub,\n44-  parseCompiledRoutingFlagMode,\n45-} from '../lib/compiled-routing-flag.js';\n46-import type { AdvisorScoringOptions } from '../lib/scorer/types.js';\n47-\n48-// ───────────────────────────────────────────────────────────────────\n49-// 2. TYPE DEFINITIONS\n50-// ───────────────────────────────────────────────────────────────────\n51-\n52-type HandlerResponse = { content: Array<{ type: string; text: string }> };\n53-type AdvisorStatus = ReturnType<typeof readAdvisorStatus>;\n54-type ScoredRecommendation = ReturnType<typeof scoreAdvisorPrompt>['recommendations'][number];\n55-type PublicRecommendationStatus = NonNullable<AdvisorRecommendOutput['recommendations'][number]['status']>;\n56-type PublicThresholds = AdvisorRecommendOutput['effectiveThresholds'];\n57-type ShadowRecommendation = NonNullable<AdvisorRecommendOutput['_shadow']>['recommendations'][number];\n58-\n59-// ───────────────────────────────────────────────────────────────────\n60-// 3. HELPERS\n61-// ───────────────────────────────────────────────────────────────────\n62-\n--\n384:  if (!COMPILED_ROUTING_HUBS.has(skillId)) return undefined;\n385-  const frontDoor = resolve(workspaceRoot, '.skilled', 'bin', 'compiled-route.cjs');\n386-  if (!frontDoorReadsPromptFromStdin(frontDoor)) {\n387-    emitCompiledRoutingBreadcrumb(`compiled-route front door cannot read the prompt from stdin; skipping hub=${skillId}`);\n388-    return undefined;\n389-  }\n390-  try {\n391-    const args = [\n.skilled/skills/system-skill-advisor/runtime/handlers/advisor-recommend.ts:42:  COMPILED_ROUTING_HUBS,\n.skilled/skills/system-skill-advisor/runtime/handlers/advisor-recommend.ts:384:  if (!COMPILED_ROUTING_HUBS.has(skillId)) return undefined;\n.skilled/skills/system-skill-advisor/runtime/handlers/advisor-recommend.ts:387:    emitCompiledRoutingBreadcrumb(`compiled-route front door cannot read the prompt from stdin; skipping hub=${skillId}`);\n.skilled/skills/system-skill-advisor/runtime/handlers/advisor-recommend.ts:423:      `compiled-route subprocess failed for hub=${skillId}: ${error instanceof Error ? error.message : String(error)}${detail}`,\n.skilled/skills/system-skill-advisor/runtime/handlers/advisor-recommend.ts:443:  // compiled-eligible hubs (mirrors the runtime resolver's own default-on\n.skilled/skills/system-skill-advisor/runtime/handlers/advisor-recommend.ts:444:  // cohort), so unset attaches compiledRoute for those hubs; the kill-switch\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\": \"cd /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research && grep -n \\\"COMPILED_ROUTING_HUBS\\\" -A20 .skilled/skills/system-skill-advisor/runtime/handlers/advisor-recommend.ts | head -30; grep -rn \\\"COMPILED_ROUTING_HUBS\\\\|compiled.*hub\\\" .skilled/skills/system-skill-advisor/runtime/lib/compiled-routing.ts .skilled/skills/system-skill-advisor/runtime/handlers/advisor-recommend.ts 2>/dev/null | head\"}"},"time":{"start":1794670369894,"end":1794670370304}}}}
