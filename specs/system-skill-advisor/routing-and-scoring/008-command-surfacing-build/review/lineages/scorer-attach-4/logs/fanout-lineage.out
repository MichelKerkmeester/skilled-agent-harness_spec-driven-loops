}\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"specs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/review/lineages/scorer-attach-4/deep-review-effect-ledger/frames/0000000000000001.frame\nspecs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/review/lineages/scorer-attach-4/locks-and-fencing-v1/2153efebfc6fc439b5f53412041541aeb7e0d32c56ab6e944a316000bf174704/grant-journal.jsonl\nspecs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/review/lineages/scorer-attach-4/locks-and-fencing-v1/2153efebfc6fc439b5f53412041541aeb7e0d32c56ab6e944a316000bf174704/coordinator-state.json\nspecs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/review/lineages/scorer-attach-4/invocation-metadata.json\nspecs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/review/lineages/scorer-attach-4/deep-review-audit-ledger/frames/0000000000000001.frame\n{\"effectiveConfig\":{\"kind\":\"cli-opencode\",\"executable\":\"opencode\",\"executableVersion\":\"sha256:9f3147cae4ca323827d3ca39451b0d3431b2906e79a08e9b09d1eb34bb703f52\",\"model\":\"opencode-go/deepseek-v4.1-flash\",\"reasoningEffort\":\"max\",\"serviceTier\":null,\"sandboxMode\":\"danger-full-access\",\"permissionMode\":\"acceptEdits\",\"webSearch\":\"inherit\"},\"invocationFingerprint\":\"inv:7fd1d90c94086d986648cb9f5b15a650ae425ece7f91fca55cf4ba2686b63c6a\"}\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\": \"find specs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/review/lineages/scorer-attach-4 -maxdepth 3 -type f | head -50; cat specs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/review/lineages/scorer-attach-4/invocation-metadata.json\"}"},"time":{"start":1794669299910,"end":1794669300075}}}}
