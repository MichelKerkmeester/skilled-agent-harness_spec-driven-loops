{"type":"tool_use","timestamp":1794669429393,"sessionID":"ses_e255ff46fffexTncZnylD3HfiJ","part":{"partID":"prt_1daa242790021tQc3MTFiZJJs3","sessionID":"ses_e255ff46fffexTncZnylD3HfiJ","messageID":"msg_1daa221e7001g6jk0A1ksFi8nS","type":"tool","id":"call_00_em9kipqo0bpwq7mvcdjpaeic","tool":"read","state":{"status":"completed","input":{"path":".skilled/skills/system-skill-advisor/runtime/lib/command-attach.ts"},"output":"Read file .skilled/skills/system-skill-advisor/runtime/lib/command-attach.ts, lines 1-522\n1: // ───────────────────────────────────────────────────────────────\n2: // MODULE: Slash command attached to a hub's recommendation\n3: // ───────────────────────────────────────────────────────────────\n4: //\n5: // The advisor can name the workflow mode a hub would route a prompt to, but the\n6: // reader still has to translate that mode into the slash command that acts on\n7: // it. This module owns that translation and nothing else, kept free of imports\n8: // so the recommend path and a test read the same semantics.\n9: //\n10: // The mode-to-command table is generated rather than hand-maintained: each row is\n11: // derived from a hub's own command files, so a hub that adds or renames a mode\n12: // regenerates its row instead of drifting from a copy someone forgot to update.\n13: \n14: // BEGIN GENERATED MODE COMMANDS\n15: export const MODE_COMMANDS: Readonly<Record<string, Readonly<Record<string, string>>>> = {\n16:   'sk-design': {\n17:     'sk-design-chart': '/design:chart',\n18:     'sk-design-diagram': '/design:diagram',\n19:     'sk-design-md-generator': '/design:extract',\n20:   },\n21:   'sk-doc': {\n22:     'sk-create-agent': '/create:agent',\n23:     'sk-create-benchmark': '/create:benchmark',\n24:     'sk-create-changelog': '/create:changelog',\n25:     'sk-create-command': '/create:command',\n26:     'sk-create-diff': '/create:diff',\n27:     'sk-create-feature-catalog': '/create:feature-catalog',\n28:     'sk-create-goal': '/create:goal',\n29:     'sk-create-manual-testing-playbook': '/create:manual-testing-playbook',\n30:     'sk-create-readme': '/create:readme',\n31:     'sk-create-repo-rule': '/create:repo-rule',\n32:     'sk-create-skill': '/create:sk-skill',\n33:     'sk-create-skill-parent': '/create:skill-parent',\n34:     'sk-create-with-human-voice': '/create:with-human-voice',\n35:   },\n36:   'system-deep-loop': {\n37:     'ai-council': '/deep:ai-council',\n38:     'research': '/deep:research',\n39:     'review': '/deep:review',\n40:   },\n41: };\n42: // END GENERATED MODE COMMANDS\n43: \n44: // One row of the command table: the runnable slash command, the policy that says\n45: // whether it runs, asks or starts a session, the class that says what the run\n46: // writes, and the skill that owns it. The rows are generated, so only the shape\n47: // lives here.\n48: export interface CommandRow {\n49:   readonly command: string;\n50:   readonly policy?: 'run' | 'start' | 'ask';\n51:   readonly mutating?: 'read-only' | 'add-only' | 'mutates';\n52:   readonly ownerSkillId: string;\n53: }\n54: \n55: // The table below covers every tracked command, whether or not its bridge is\n56: // active, so a typed command always has a policy and an owner. `scorerRow` says\n57: // whether a scorer can also return the command on its own.\n58: export interface TrackedCommand {\n59:   readonly policy: 'run' | 'start' | 'ask';\n60:   readonly ownerSkillId: string;\n61:   readonly scorerRow: boolean;\n62: }\n63: \n64: // BEGIN GENERATED COMMAND ROWS\n65: export const COMMAND_ROWS: Readonly<Record<string, CommandRow>> = {\n66:   'command-create-agent': { command: '/create:agent', policy: 'start', mutating: 'mutates', ownerSkillId: 'sk-doc' },\n67:   'command-create-changelog': { command: '/create:changelog', policy: 'ask', mutating: 'mutates', ownerSkillId: 'sk-doc' },\n68:   'command-create-feature-catalog': { command: '/create:feature-catalog', policy: 'start', mutating: 'mutates', ownerSkillId: 'sk-doc' },\n69:   'command-create-manual-testing-playbook': { command: '/create:manual-testing-playbook', policy: 'start', mutating: 'mutates', ownerSkillId: 'sk-doc' },\n70:   'command-create-readme': { command: '/create:readme', policy: 'start', mutating: 'mutates', ownerSkillId: 'sk-doc' },\n71:   'command-create-sk-skill': { command: '/create:sk-skill', policy: 'start', mutating: 'mutates', ownerSkillId: 'sk-doc' },\n72:   'command-deep-research': { command: '/deep:research', policy: 'ask', mutating: 'mutates', ownerSkillId: 'system-deep-loop' },\n73:   'command-deep-review': { command: '/deep:review', policy: 'ask', mutating: 'mutates', ownerSkillId: 'system-deep-loop' },\n74:   'command-doctor-agents-md-check': { command: '/doctor:agents-md check', policy: 'run', mutating: 'read-only', ownerSkillId: 'system-skilled-doctor' },\n75:   'command-doctor-agents-md-embed': { command: '/doctor:agents-md embed', policy: 'ask', mutating: 'mutates', ownerSkillId: 'system-skilled-doctor' },\n76:   'command-doctor-agents-md-restore': { command: '/doctor:agents-md restore', policy: 'ask', mutating: 'mutates', ownerSkillId: 'system-skilled-doctor' },\n77:   'command-doctor-ci-report': { command: '/doctor:ci report', policy: 'run', mutating: 'read-only', ownerSkillId: 'sk-code' },\n78:   'command-doctor-ci-scaffold': { command: '/doctor:ci scaffold', policy: 'ask', mutating: 'mutates', ownerSkillId: 'sk-code' },\n79:   'command-doctor-ci-toggle': { command: '/doctor:ci toggle', policy: 'ask', mutating: 'mutates', ownerSkillId: 'sk-code' },\n80:   'command-doctor-deep-loop': { command: '/doctor:deep-loop', policy: 'run', mutating: 'add-only', ownerSkillId: 'system-deep-loop' },\n81:   'command-doctor-env': { command: '/doctor:env list', policy: 'run', mutating: 'read-only', ownerSkillId: 'system-skilled-doctor' },\n82:   'command-doctor-git-hooks': { command: '/doctor:git hooks', policy: 'ask', mutating: 'mutates', ownerSkillId: 'sk-git' },\n83:   'command-doctor-git-setup': { command: '/doctor:git setup', policy: 'run', mutating: 'read-only', ownerSkillId: 'sk-git' },\n84:   'command-doctor-git-standards': { command: '/doctor:git standards', policy: 'ask', mutating: 'mutates', ownerSkillId: 'sk-git' },\n85:   'command-doctor-helper': { command: '/doctor:helper', policy: 'run', mutating: 'read-only', ownerSkillId: 'system-skilled-doctor' },\n86:   'command-doctor-install': { command: '/doctor:install', policy: 'run', mutating: 'read-only', ownerSkillId: 'system-skilled-doctor' },\n87:   'command-doctor-mcp-debug': { command: '/doctor:mcp debug', policy: 'ask', mutating: 'mutates', ownerSkillId: 'system-skilled-doctor' },\n88:   'command-doctor-mcp-install': { command: '/doctor:mcp install', policy: 'ask', mutating: 'mutates', ownerSkillId: 'system-skilled-doctor' },\n89:   'command-doctor-overlay-apply': { command: '/doctor:overlay apply', policy: 'ask', mutating: 'mutates', ownerSkillId: 'system-skilled-doctor' },\n90:   'command-doctor-overlay-repin': { command: '/doctor:overlay repin', policy: 'ask', mutating: 'mutates', ownerSkillId: 'system-skilled-doctor' },\n91:   'command-doctor-overlay-status': { command: '/doctor:overlay status', policy: 'run', mutating: 'read-only', ownerSkillId: 'system-skilled-doctor' },\n92:   'command-doctor-runtime-mirrors': { command: '/doctor:runtime-mirrors', policy: 'run', mutating: 'read-only', ownerSkillId: 'system-skilled-doctor' },\n93:   'command-doctor-setup': { command: '/doctor:setup', policy: 'run', mutating: 'read-only', ownerSkillId: 'system-skilled-doctor' },\n94:   'command-doctor-sk-code-quality': { command: '/doctor:sk-code quality', policy: 'ask', mutating: 'mutates', ownerSkillId: 'sk-code' },\n95:   'command-doctor-sk-code-setup': { command: '/doctor:sk-code setup', policy: 'run', mutating: 'read-only', ownerSkillId: 'sk-code' },\n96:   'command-doctor-sk-skill-check': { command: '/doctor:sk-skill check', policy: 'run', mutating: 'read-only', ownerSkillId: 'sk-doc' },\n97:   'command-doctor-sk-skill-convert': { command: '/doctor:sk-skill convert', policy: 'ask', mutating: 'mutates', ownerSkillId: 'sk-doc' },\n98:   'command-doctor-skill-advisor-embedder': { command: '/doctor:skill-advisor embedder', policy: 'ask', mutating: 'mutates', ownerSkillId: 'system-skill-advisor' },\n99:   'command-doctor-skill-advisor-parent-skill': { command: '/doctor:skill-advisor parent-skill', policy: 'run', mutating: 'read-only', ownerSkillId: 'system-skill-advisor' },\n100:   'command-doctor-skill-advisor-rebuild': { command: '/doctor:skill-advisor rebuild', policy: 'ask', mutating: 'mutates', ownerSkillId: 'system-skill-advisor' },\n101:   'command-doctor-skill-advisor-router-reach': { command: '/doctor:skill-advisor router-reach', policy: 'run', mutating: 'read-only', ownerSkillId: 'system-skill-advisor' },\n102:   'command-doctor-skill-advisor-skill-budget': { command: '/doctor:skill-advisor skill-budget', policy: 'run', mutating: 'read-only', ownerSkillId: 'system-skill-advisor' },\n103:   'command-doctor-skill-advisor-skill-graph-freshness': { command: '/doctor:skill-advisor skill-graph-freshness', policy: 'run', mutating: 'read-only', ownerSkillId: 'system-skill-advisor' },\n104:   'command-doctor-skill-advisor-tune': { command: '/doctor:skill-advisor tune', policy: 'ask', mutating: 'mutates', ownerSkillId: 'system-skill-advisor' },\n105:   'command-doctor-speckit': { command: '/doctor:speckit', policy: 'run', mutating: 'add-only', ownerSkillId: 'system-skilled-doctor' },\n106:   'command-doctor-symlink-check': { command: '/doctor:symlink check', policy: 'run', mutating: 'read-only', ownerSkillId: 'system-skilled-doctor' },\n107:   'command-doctor-symlink-link': { command: '/doctor:symlink link', policy: 'ask', mutating: 'mutates', ownerSkillId: 'system-skilled-doctor' },\n108:   'command-doctor-symlink-unlink': { command: '/doctor:symlink unlink', policy: 'ask', mutating: 'mutates', ownerSkillId: 'system-skilled-doctor' },\n109:   'command-doctor-update': { command: '/doctor:update', policy: 'ask', mutating: 'mutates', ownerSkillId: 'system-skilled-doctor' },\n110:   'command-prompt-improve': { command: '/prompt:improve', policy: 'start', mutating: 'mutates', ownerSkillId: 'sk-prompt' },\n111:   'command-spec-kit-deep-research': { command: '/deep:research', policy: 'ask', mutating: 'mutates', ownerSkillId: 'system-deep-loop' },\n112:   'command-spec-kit-deep-review': { command: '/deep:review', policy: 'ask', mutating: 'mutates', ownerSkillId: 'system-deep-loop' },\n113:   'command-speckit-complete': { command: '/speckit:complete', policy: 'start', mutating: 'mutates', ownerSkillId: 'system-spec-kit' },\n114:   'command-speckit-handoff': { command: '/speckit:handoff', policy: 'ask', mutating: 'mutates', ownerSkillId: 'system-spec-kit' },\n115:   'command-speckit-implement': { command: '/speckit:implement', policy: 'start', mutating: 'mutates', ownerSkillId: 'system-spec-kit' },\n116:   'command-speckit-plan': { command: '/speckit:plan', policy: 'start', mutating: 'mutates', ownerSkillId: 'system-spec-kit' },\n117:   'command-speckit-resume': { command: '/speckit:resume', policy: 'start', mutating: 'mutates', ownerSkillId: 'system-spec-kit' },\n118:   'command-speckit-save': { command: '/speckit:save', policy: 'start', mutating: 'mutates', ownerSkillId: 'system-spec-kit' },\n119:   'command-speckit-search': { command: '/speckit:search', policy: 'run', mutating: 'read-only', ownerSkillId: 'system-spec-kit' },\n120:   'create:agent': { command: '/create:agent', policy: 'start', mutating: 'mutates', ownerSkillId: 'sk-doc' },\n121:   'create:manual-testing-playbook': { command: '/create:manual-testing-playbook', policy: 'start', mutating: 'mutates', ownerSkillId: 'sk-doc' },\n122: };\n123: export const TRACKED_COMMANDS: Readonly<Record<string, TrackedCommand>> = {\n124:   '/create:agent': { policy: 'start', ownerSkillId: 'sk-doc', scorerRow: true },\n125:   '/create:benchmark': { policy: 'start', ownerSkillId: 'sk-doc', scorerRow: false },\n126:   '/create:changelog': { policy: 'ask', ownerSkillId: 'sk-doc', scorerRow: false },\n127:   '/create:command': { policy: 'start', ownerSkillId: 'sk-doc', scorerRow: false },\n128:   '/create:diff': { policy: 'start', ownerSkillId: 'sk-doc', scorerRow: false },\n129:   '/create:feature-catalog': { policy: 'start', ownerSkillId: 'sk-doc', scorerRow: false },\n130:   '/create:goal': { policy: 'start', ownerSkillId: 'sk-doc', scorerRow: false },\n131:   '/create:manual-testing-playbook': { policy: 'start', ownerSkillId: 'sk-doc', scorerRow: true },\n132:   '/create:readme': { policy: 'start', ownerSkillId: 'sk-doc', scorerRow: false },\n133:   '/create:repo-rule': { policy: 'start', ownerSkillId: 'sk-doc', scorerRow: false },\n134:   '/create:sk-skill': { policy: 'start', ownerSkillId: 'sk-doc', scorerRow: false },\n135:   '/create:skill-parent': { policy: 'start', ownerSkillId: 'sk-doc', scorerRow: false },\n136:   '/create:with-human-voice': { policy: 'start', ownerSkillId: 'sk-doc', scorerRow: false },\n137:   '/deep:ai-council': { policy: 'ask', ownerSkillId: 'system-deep-loop', scorerRow: false },\n138:   '/deep:research': { policy: 'ask', ownerSkillId: 'system-deep-loop', scorerRow: false },\n139:   '/deep:review': { policy: 'ask', ownerSkillId: 'system-deep-loop', scorerRow: false },\n140:   '/design:chart': { policy: 'start', ownerSkillId: 'sk-design', scorerRow: false },\n141:   '/design:diagram': { policy: 'start', ownerSkillId: 'sk-design', scorerRow: false },\n142:   '/design:extract': { policy: 'ask', ownerSkillId: 'sk-design', scorerRow: false },\n143:   '/doctor:agents-md check': { policy: 'run', ownerSkillId: 'system-skilled-doctor', scorerRow: true },\n144:   '/doctor:agents-md embed': { policy: 'ask', ownerSkillId: 'system-skilled-doctor', scorerRow: true },\n145:   '/doctor:agents-md restore': { policy: 'ask', ownerSkillId: 'system-skilled-doctor', scorerRow: true },\n146:   '/doctor:ci report': { policy: 'run', ownerSkillId: 'sk-code', scorerRow: true },\n147:   '/doctor:ci scaffold': { policy: 'ask', ownerSkillId: 'sk-code', scorerRow: true },\n148:   '/doctor:ci toggle': { policy: 'ask', ownerSkillId: 'sk-code', scorerRow: true },\n149:   '/doctor:deep-loop': { policy: 'run', ownerSkillId: 'system-deep-loop', scorerRow: true },\n150:   '/doctor:env list': { policy: 'run', ownerSkillId: 'system-skilled-doctor', scorerRow: true },\n151:   '/doctor:git hooks': { policy: 'ask', ownerSkillId: 'sk-git', scorerRow: true },\n152:   '/doctor:git setup': { policy: 'run', ownerSkillId: 'sk-git', scorerRow: true },\n153:   '/doctor:git standards': { policy: 'ask', ownerSkillId: 'sk-git', scorerRow: true },\n154:   '/doctor:helper': { policy: 'run', ownerSkillId: 'system-skilled-doctor', scorerRow: true },\n155:   '/doctor:install': { policy: 'run', ownerSkillId: 'system-skilled-doctor', scorerRow: true },\n156:   '/doctor:mcp debug': { policy: 'ask', ownerSkillId: 'system-skilled-doctor', scorerRow: true },\n157:   '/doctor:mcp install': { policy: 'ask', ownerSkillId: 'system-skilled-doctor', scorerRow: true },\n158:   '/doctor:overlay apply': { policy: 'ask', ownerSkillId: 'system-skilled-doctor', scorerRow: true },\n159:   '/doctor:overlay repin': { policy: 'ask', ownerSkillId: 'system-skilled-doctor', scorerRow: true },\n160:   '/doctor:overlay status': { policy: 'run', ownerSkillId: 'system-skilled-doctor', scorerRow: true },\n161:   '/doctor:runtime-mirrors': { policy: 'run', ownerSkillId: 'system-skilled-doctor', scorerRow: true },\n162:   '/doctor:setup': { policy: 'run', ownerSkillId: 'system-skilled-doctor', scorerRow: true },\n163:   '/doctor:sk-code quality': { policy: 'ask', ownerSkillId: 'sk-code', scorerRow: true },\n164:   '/doctor:sk-code setup': { policy: 'run', ownerSkillId: 'sk-code', scorerRow: true },\n165:   '/doctor:sk-skill check': { policy: 'run', ownerSkillId: 'sk-doc', scorerRow: true },\n166:   '/doctor:sk-skill convert': { policy: 'ask', ownerSkillId: 'sk-doc', scorerRow: true },\n167:   '/doctor:skill-advisor embedder': { policy: 'ask', ownerSkillId: 'system-skill-advisor', scorerRow: true },\n168:   '/doctor:skill-advisor parent-skill': { policy: 'run', ownerSkillId: 'system-skill-advisor', scorerRow: true },\n169:   '/doctor:skill-advisor rebuild': { policy: 'ask', ownerSkillId: 'system-skill-advisor', scorerRow: true },\n170:   '/doctor:skill-advisor router-reach': { policy: 'run', ownerSkillId: 'system-skill-advisor', scorerRow: true },\n171:   '/doctor:skill-advisor skill-budget': { policy: 'run', ownerSkillId: 'system-skill-advisor', scorerRow: true },\n172:   '/doctor:skill-advisor skill-graph-freshness': { policy: 'run', ownerSkillId: 'system-skill-advisor', scorerRow: true },\n173:   '/doctor:skill-advisor tune': { policy: 'ask', ownerSkillId: 'system-skill-advisor', scorerRow: true },\n174:   '/doctor:speckit': { policy: 'run', ownerSkillId: 'system-skilled-doctor', scorerRow: true },\n175:   '/doctor:symlink check': { policy: 'run', ownerSkillId: 'system-skilled-doctor', scorerRow: true },\n176:   '/doctor:symlink link': { policy: 'ask', ownerSkillId: 'system-skilled-doctor', scorerRow: true },\n177:   '/doctor:symlink unlink': { policy: 'ask', ownerSkillId: 'system-skilled-doctor', scorerRow: true },\n178:   '/doctor:update': { policy: 'ask', ownerSkillId: 'system-skilled-doctor', scorerRow: true },\n179:   '/prompt:improve': { policy: 'start', ownerSkillId: 'sk-prompt', scorerRow: true },\n180:   '/speckit:complete': { policy: 'start', ownerSkillId: 'system-spec-kit', scorerRow: true },\n181:   '/speckit:handoff': { policy: 'ask', ownerSkillId: 'system-spec-kit', scorerRow: true },\n182:   '/speckit:implement': { policy: 'start', ownerSkillId: 'system-spec-kit', scorerRow: true },\n183:   '/speckit:plan': { policy: 'start', ownerSkillId: 'system-spec-kit', scorerRow: true },\n184:   '/speckit:resume': { policy: 'start', ownerSkillId: 'system-spec-kit', scorerRow: true },\n185:   '/speckit:save': { policy: 'start', ownerSkillId: 'system-spec-kit', scorerRow: true },\n186:   '/speckit:search': { policy: 'run', ownerSkillId: 'system-spec-kit', scorerRow: true },\n187: };\n188: // END GENERATED COMMAND ROWS\n189: \n190: // The row for an id a recommendation carries, or undefined when that id names no\n191: // command. Own-key lookup because the table is generated data, so an inherited\n192: // name such as `constructor` must not resolve to a row nobody declared.\n193: export function commandRowFor(id: string): CommandRow | undefined {\n194:   return Object.hasOwn(COMMAND_ROWS, id) ? COMMAND_ROWS[id] : undefined;\n195: }\n196: \n197: // A typed command is the reader's own wording, so it counts only where a command\n198: // can start and where it ends on a boundary. That keeps a path such as\n199: // `docs/create:goal.md` and a prefix such as `/create:sk` from reading as a\n200: // command, and the longest key wins so `/group:name-parent` is never reduced to\n201: // its `/group:name` prefix. A dot or a slash followed by a word character\n202: // continues a file name or a path, while a sentence-ending period does not.\n203: // A mode suffix is how the command documents say to type a command, so it ends\n204: // the command name the way a space does.\n205: const COMMAND_START_BOUNDARY = /[\\s`'\"(]/;\n206: const COMMAND_CONTINUATION = /[a-z0-9_:-]/;\n207: const WORD_CHARACTER = /[a-z0-9_]/;\n208: const MODE_SUFFIX = /^:(?:auto|confirm|autopilot)(?![a-z0-9_:-])/;\n209: \n210: // A command that was renamed is still typed from habit. Its old name reads as\n211: // the command that replaced it, so the reader lands on the live workflow and\n212: // not on whatever skill the leftover words happen to score for. The old name\n213: // gets no command file of its own: this table is the only place it lives.\n214: const RETIRED_COMMANDS: Readonly<Record<string, string>> = {\n215:   '/create:skill': '/create:sk-skill',\n216: };\n217: \n218: export function typedCommandIn(prompt: string): string | undefined {\n219:   const lowered = prompt.toLowerCase();\n220:   let found: string | undefined;\n221:   for (const key of [...Object.keys(TRACKED_COMMANDS), ...Object.keys(RETIRED_COMMANDS)]) {\n222:     let index = lowered.indexOf(key);\n223:     while (index !== -1) {\n224:       const before = index === 0 ? '' : lowered[index - 1];\n225:       const after = lowered[index + key.length] ?? '';\n226:       const next = lowered[index + key.length + 1] ?? '';\n227:       const startsAtBoundary = before === '' || COMMAND_START_BOUNDARY.test(before);\n228:       const hasModeSuffix = MODE_SUFFIX.test(lowered.slice(index + key.length));\n229:       const continuesName =\n230:         !hasModeSuffix\n231:         && (COMMAND_CONTINUATION.test(after) || ((after === '/' || after === '.') && WORD_CHARACTER.test(next)));\n232:       const endsAtBoundary = after === '' || !continuesName;\n233:       if (startsAtBoundary && endsAtBoundary) {\n234:         if (found === undefined || key.length > found.length) found = key;\n235:         break;\n236:       }\n237:       index = lowered.indexOf(key, index + 1);\n238:     }\n239:   }\n240:   if (found !== undefined && Object.hasOwn(RETIRED_COMMANDS, found)) return RETIRED_COMMANDS[found];\n241:   return found;\n242: }\n243: \n244: // A typed command travels on the recommendation that leads, so it is delivered\n245: // only when the leading skill owns the command or carries the same command row.\n246: // A leading skill unrelated to the command must not carry it.\n247: export interface TypedCommand {\n248:   readonly command: string;\n249:   readonly policy: 'run' | 'start' | 'ask';\n250:   readonly ownerSkillId: string;\n251: }\n252: \n253: export function typedCommandForTop(topSkillId: string, prompt: string): TypedCommand | undefined {\n254:   const command = typedCommandIn(prompt);\n255:   if (command === undefined || !Object.hasOwn(TRACKED_COMMANDS, command)) return undefined;\n256:   if (commandOnlyMentioned(prompt, command)) return undefined;\n257:   const row = TRACKED_COMMANDS[command];\n258:   const sameCommandRow = commandRowFor(topSkillId)?.command === command;\n259:   if (topSkillId !== row.ownerSkillId && !sameCommandRow) return undefined;\n260:   return { command, policy: row.policy, ownerSkillId: row.ownerSkillId };\n261: }\n262: \n263: // Deep-loop commands open a long, multi-pass run, so one attached to a prompt\n264: // that merely mentions the topic spends the reader's budget on work they never\n265: // asked for. The list below is the vocabulary that counts as asking for it, and\n266: // it holds only effort wording: a bare topic word such as `research`, `review`\n267: // or `council` says what to look at, never how far to go, so it never qualifies\n268: // on its own.\n269: //\n270: // The phrases live in a data list, one per line, so the vocabulary a reviewer\n271: // has to judge stays visible and cheap to correct.\n272: export const DEPTH_WORDING: readonly string[] = [\n273:   'in depth',\n274:   'deep dive',\n275:   'deep research',\n276:   'deep review',\n277:   'thorough',\n278:   'thoroughly',\n279:   'exhaustive',\n280:   'iteratively',\n281:   'multiple passes',\n282:   'many passes',\n283:   'several passes',\n284:   'ask the council',\n285:   'convene',\n286:   'several models',\n287:   'final verdict',\n288:   'everything you can',\n289: ];\n290: \n291: // A creation workflow scaffolds, reviews and validates a whole document, which is\n292: // the wrong size for a correction inside one. The list below is the vocabulary\n293: // that marks that correction, and a line number points at one the same way.\n294: export const SMALL_EDIT_WORDING: readonly string[] = [\n295:   'typo',\n296:   'typos',\n297:   'spelling',\n298:   'misspelled',\n299:   'misspelling',\n300:   'grammar',\n301:   'punctuation',\n302:   'wording',\n303:   'broken link',\n304:   'broken links',\n305:   'dead link',\n306:   'dead links',\n307:   'one line',\n308:   'single line',\n309: ];\n310: \n311: // A phrase may carry punctuation a regex would read as a metacharacter, so it is\n312: // escaped before it is trusted as a pattern.\n313: function escapePhrase(phrase: string): string {\n314:   return phrase.replace(/[.*+?^${}()|[\\]\\\\]/g, '\\\\$&');\n315: }\n316: \n317: // One alternation over the list keeps the gate a single test per prompt, and the\n318: // boundary markers keep `thorough` from firing inside a longer word while a\n319: // multi-word phrase still has to match as a whole.\n320: const DEPTH_REQUEST = new RegExp(`\\\\b(?:${DEPTH_WORDING.map(escapePhrase).join('|')})\\\\b`);\n321: \n322: // The line alternative is a pattern rather than a phrase, so it is appended raw\n323: // beside the escaped vocabulary instead of being escaped with it.\n324: const SMALL_EDIT_REQUEST = new RegExp(\n325:   `\\\\b(?:${SMALL_EDIT_WORDING.map(escapePhrase).join('|')}|line \\\\d+)\\\\b`,\n326: );\n327: \n328: // A request that asks for a document to be created or written wants the whole\n329: // document, even when it names a correction to make afterwards, so this check\n330: // stands the small-edit gate down.\n331: const CREATION_REQUEST = /\\b(?:creat(?:e|es|ing)|writ(?:e|es|ing)|author(?:ing)?|draft(?:ing)?|scaffold(?:ing)?|generat(?:e|es|ing)|mak(?:e|es|ing)|new|build(?:ing)?|set up|add an?|need an?)\\b/;\n332: \n333: // A small edit names the correction to make, so the verb is what marks one.\n334: const CORRECTION_VERB = /\\b(?:fix|correct|update|edit|change|tweak|repair)\\b/;\n335: \n336: // These three creation commands write a whole document that is later corrected in\n337: // place, so a correction request names an edit to it rather than a new one. Every\n338: // other creation command names a purpose that a correction word belongs to.\n339: const SMALL_EDIT_GATED_COMMANDS: ReadonlySet<string> = new Set(['/create:readme', '/create:feature-catalog', '/create:manual-testing-playbook']);\n340: \n341: // Wording that asks for an answer and rules out a change. One pattern serves\n342: // every gate that has to honour it, so a new gate cannot drift from the first.\n343: // Words alone cannot tell \"make no changes to the files\" from a change request\n344: // that says what to leave alone, so both read as no change: losing an offer\n345: // costs less than offering a mutating command on a prompt that ruled one out.\n346: // A negated write verb counts only with an object that names nothing in\n347: // particular, because \"don't add tools\" limits a change and does not refuse it.\n348: export const NO_EDIT_REQUEST = /\\b(no edits?|make no changes|no changes yet|without making changes|(?:do not|don't|dont) (?:make (?:any )?changes|change|edit|modify|touch|(?:create|write|add|delete|remove) (?:it|this|that|anything|any files?))|read-only only|no edits yet|only; do not|just show|just list)\\b/;\n349: \n350: // Many keyboards type the contraction with a curly apostrophe, so the text is\n351: // folded to the straight form before the pattern reads it.\n352: export function isNoEditRequest(text: string): boolean {\n353:   return NO_EDIT_REQUEST.test(text.toLowerCase().replace(/[\\u2018\\u2019]/g, \"'\"));\n354: }\n355: \n356: // A refusal or a question reaches its command through a use verb, so the two\n357: // lists below share this one. A gap holds one or two plain words and no\n358: // punctuation, because a comma ends the clause that holds the lead.\n359: export const COMMAND_USE_VERB = '(?:run|start|use|invoke|launch|execute|call|trigger|open|rerun|re-run|kick off)';\n360: export const COMMAND_GAP_WORDS = \"(?:[a-z']+ ){0,2}\";\n361: \n362: // `why not` proposes the command rather than refusing it, so the word refuses\n363: // only where no `why` stands before it.\n364: const COMMAND_NOT_WORD = '(?<!\\\\bwhy )not';\n365: \n366: // A command the reader refuses is named without being asked for, so this list\n367: // holds the leads that mark that naming. A lead must sit directly before the\n368: // command so a later clause cannot refuse an earlier request, and a gap holds\n369: // plain words only so a refusal before a comma cannot swallow the request after\n370: // it. A reader who stops using a command names it only to refuse it.\n371: export const COMMAND_DECLINE_LEADS: readonly string[] = [\n372:   `(?:do not|don't|dont|never|${COMMAND_NOT_WORD}|won't|wont|no longer|cannot|can't|no need to|need not|needn't) (?!(?:forget|hesitate|fail|mind)\\\\b)${COMMAND_GAP_WORDS}${COMMAND_USE_VERB} ${COMMAND_GAP_WORDS}`,\n373:   `(?:skip|skipping|without|instead of|rather than|avoid|stop|stopped|quit|${COMMAND_NOT_WORD}) (?:(?!${COMMAND_USE_VERB}\\\\b)[a-z']+ ){0,2}`,\n374: ];\n375: \n376: // A command the reader asks about is named without being asked for, so this list\n377: // holds the leads that mark that naming. A lead must sit directly before the\n378: // command so a later clause cannot turn an earlier request into a question, and\n379: // a gap holds plain words only so a question before a comma cannot swallow the\n380: // request after it.\n381: export const COMMAND_ASK_LEADS: readonly string[] = [\n382:   \"(?:what does|what is|what's|what would|what will|what did|how does|how did|why does|why did|explain|describe|tell me what|tell me how|tell me about|tell me why|difference between|differ from|differs from|different from|undo what|ran|already ran|was running) (?:the )?(?:command )?\",\n383:   `(?:should i|should we|do i need to|when would i) ${COMMAND_USE_VERB} (?:the )?(?:command )?`,\n384: ];\n385: \n386: // A bare ask word opens a statement as often as a question, so it marks a naming\n387: // only when the command it precedes is followed by a question mark before the\n388: // sentence ends, or when the lead itself opens a sentence, which a question mark ends as a full stop does.\n389: export const COMMAND_BARE_ASK_LEAD = '(?:is|does|can|will|would) ';\n390: \n391: // A clause that opens with a use verb and `it` asks for the command an earlier\n392: // clause only named, so a naming such as `not run /x yet, please start it`\n393: // becomes a request. The clause has to open that way so `I will run it` stays a\n394: // statement.\n395: const COMMAND_ASKED_BY_PRONOUN = new RegExp(`(?:^|[,.;!?\\\\n]) *(?:(?:and|then|so|please|now|just|go ahead and) )*${COMMAND_USE_VERB} it\\\\b`);\n396: \n397: // A prompt names a command to refuse it or to ask about it as often as it names\n398: // one to run it, so an offer must read the naming before it trusts the name. The\n399: // text is folded first, because a keyed apostrophe or a run of spaces must not\n400: // hide the lead, while a line break survives as the sentence end it is. The\n401: // boundary before the lead keeps a command name from matching inside a word or a\n402: // path, and the boundary after it keeps a longer command name from reading as the\n403: // shorter one. Every occurrence has to carry a lead, because one led naming does\n404: // not turn a later unled naming into a request.\n405: export function commandOnlyMentioned(prompt: string, command: string): boolean {\n406:   const text = prompt\n407:     .toLowerCase()\n408:     .replace(/[\\u2018\\u2019]/g, \"'\")\n409:     .replace(/[^\\S\\n]+/g, ' ')\n410:     .replace(/ *\\n\\s*/g, '\\n');\n411:   const name = escapePhrase(command.toLowerCase());\n412:   const occurrences = [...text.matchAll(new RegExp(`(?:^|[^a-z0-9_/])${name}(?![a-z0-9_-])`, 'g'))];\n413:   if (occurrences.length === 0) return false;\n414:   return occurrences.every((occurrence) => {\n415:     const nameEnd = (occurrence.index ?? 0) + occurrence[0].length;\n416:     const before = text.slice(0, nameEnd);\n417:     const tail = text.slice(nameEnd);\n418:     if (COMMAND_ASKED_BY_PRONOUN.test(tail.split(/(?:^|[\\s,;(])\\/[a-z][a-z0-9_-]*(?::[a-z][a-z0-9_-]*)?(?![a-z0-9_\\/-]|\\.[a-z0-9])/)[0])) return false;\n419:     const led = [...COMMAND_DECLINE_LEADS, ...COMMAND_ASK_LEADS].some((lead) => (\n420:       new RegExp(`(?:^|[^a-z0-9_/])${lead}${name}$`).test(before)\n421:     ));\n422:     if (led) return true;\n423:     const bareLead = new RegExp(`(?:^|[^a-z0-9_/])${COMMAND_BARE_ASK_LEAD}${name}$`).test(before);\n424:     if (!bareLead) return false;\n425:     const sentenceEnd = tail.search(/[.!\\n]/);\n426:     const sentence = sentenceEnd === -1 ? tail : tail.slice(0, sentenceEnd);\n427:     // A chat question often leaves the question mark off, so a bare ask word that\n428:     // opens a sentence still asks about the command.\n429:     return sentence.includes('?')\n430:       || new RegExp(`(?:^|[.!?\\\\n] *)${COMMAND_BARE_ASK_LEAD}${name}$`).test(before);\n431:   });\n432: }\n433: \n434: // A compiled route arrives as unvalidated JSON from a separate process, so the\n435: // shape is narrowed here rather than trusted. Arrays count as objects in\n436: // JavaScript and would let `action` read off an unrelated field, so they are\n437: // excluded explicitly.\n438: function asRecord(value: unknown): Record<string, unknown> | undefined {\n439:   if (typeof value !== 'object' || value === null || Array.isArray(value)) return undefined;\n440:   return value as Record<string, unknown>;\n441: }\n442: \n443: // The command for a hub's recommendation, or undefined when the route does not\n444: // single out one mode. Only a single-mode route names a command unambiguously:\n445: // a bundle or a multi-target route has more than one answer, and asking the\n446: // reader to pick belongs to the recommend path, not here. Never throws, because\n447: // a missing command must degrade to \"no command offered\" rather than break\n448: // routing. The prompt decides whether a costly deep-loop command is offered at\n449: // all: a reader who only asks about the topic gets no command, rather than one\n450: // that would launch work they never requested.\n451: export function attachCommand(\n452:   skillId: string,\n453:   compiledRoute: unknown,\n454:   prompt: string,\n455:   modeCommands: Readonly<Record<string, Readonly<Record<string, string>>>> = MODE_COMMANDS,\n456: ): string | undefined {\n457:   const route = asRecord(compiledRoute);\n458:   if (!route) return undefined;\n459:   if (route.action !== 'route' || route.selectionKind !== 'single') return undefined;\n460: \n461:   const targets = route.targets;\n462:   if (!Array.isArray(targets) || targets.length !== 1) return undefined;\n463: \n464:   const onlyTarget = asRecord(targets[0]);\n465:   if (!onlyTarget) return undefined;\n466: \n467:   const workflowMode = onlyTarget.workflowMode;\n468:   if (typeof workflowMode !== 'string' || workflowMode === '') return undefined;\n469: \n470:   // A reader who rules out a change gets no command from either path, so the hub\n471:   // route never offers what the scorer already withholds.\n472:   if (isNoEditRequest(prompt)) return undefined;\n473: \n474:   // Own-key lookup on both levels: the table is data read from a generated\n475:   // object, so an inherited name such as `constructor` must not resolve to a\n476:   // command the hub never declared.\n477:   if (!Object.prototype.hasOwnProperty.call(modeCommands, skillId)) return undefined;\n478:   const commands = modeCommands[skillId];\n479:   if (!Object.prototype.hasOwnProperty.call(commands, workflowMode)) return undefined;\n480: \n481:   // A route can pick the mode because the prompt named its command, so a naming\n482:   // that refused or asked about the command must not produce the offer.\n483:   if (commandOnlyMentioned(prompt, commands[workflowMode])) return undefined;\n484: \n485:   // A correction inside one document is not a request for a creation workflow,\n486:   // which scaffolds, reviews and validates a whole one.\n487:   if (\n488:     SMALL_EDIT_GATED_COMMANDS.has(commands[workflowMode])\n489:     && SMALL_EDIT_REQUEST.test(prompt.toLowerCase())\n490:     && !CREATION_REQUEST.test(prompt.toLowerCase())\n491:     && CORRECTION_VERB.test(prompt.toLowerCase())\n492:   ) return undefined;\n493: \n494:   // Deep-loop commands are the ones that commit the reader to a long, multi-pass\n495:   // run, so they are offered only when the prompt asks for that effort. Typing\n496:   // the command being attached is itself the ask, while typing another deep-loop\n497:   // command asks for that command, not this one. Every other hub answers a short\n498:   // question with a short answer, so no other skill consults the wording list.\n499:   if (skillId === 'system-deep-loop') {\n500:     const typesThisCommand = typedCommandIn(prompt) === commands[workflowMode];\n501:     if (!typesThisCommand && !DEPTH_REQUEST.test(prompt.toLowerCase())) return undefined;\n502:   }\n503: \n504:   return commands[workflowMode];\n505: }\n506: \n507: // A hub that withholds its command because the prompt names no single mode must\n508: // still tell the reader why no command came with it, and only a hub whose modes\n509: // map to commands withholds one. A hub that tops a prompt which never named it\n510: // is the scorer's guess, so the label would point at modes the reader did not\n511: // ask about.\n512: export function routeNeedsMode(\n513:   skillId: string,\n514:   compiledRoute: unknown,\n515:   namedSkills: readonly string[],\n516: ): boolean {\n517:   if (!namedSkills.includes(skillId)) return false;\n518:   const route = asRecord(compiledRoute);\n519:   if (!route) return false;\n520:   if (route.action !== 'defer' && route.action !== 'clarify') return false;\n521:   return Object.prototype.hasOwnProperty.call(MODE_COMMANDS, skillId);\n522: }","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file .skilled/skills/system-skill-advisor/runtime/lib/command-attach.ts, lines 1-522\n1: // ───────────────────────────────────────────────────────────────\n2: // MODULE: Slash command attached to a hub's recommendation\n3: // ───────────────────────────────────────────────────────────────\n4: //\n5: // The advisor can name the workflow mode a hub would route a prompt to, but the\n6: // reader still has to translate that mode into the slash command that acts on\n7: // it. This module owns that translation and nothing else, kept free of imports\n8: // so the recommend path and a test read the same semantics.\n9: //\n10: // The mode-to-command table is generated rather than hand-maintained: each row is\n11: // derived from a hub's own command files, so a hub that adds or renames a mode\n12: // regenerates its row instead of drifting from a copy someone forgot to update.\n13: \n14: // BEGIN GENERATED MODE COMMANDS\n15: export const MODE_COMMANDS: Readonly<Record<string, Readonly<Record<string, string>>>> = {\n16:   'sk-design': {\n17:     'sk-design-chart': '/design:chart',\n18:     'sk-design-diagram': '/design:diagram',\n19:     'sk-design-md-generator': '/design:extract',\n20:   },\n21:   'sk-doc': {\n22:     'sk-create-agent': '/create:agent',\n23:     'sk-create-benchmark': '/create:benchmark',\n24:     'sk-create-changelog': '/create:changelog',\n25:     'sk-create-command': '/create:command',\n26:     'sk-create-diff': '/create:diff',\n27:     'sk-create-feature-catalog': '/create:feature-catalog',\n28:     'sk-create-goal': '/create:goal',\n29:     'sk-create-manual-testing-playbook': '/create:manual-testing-playbook',\n30:     'sk-create-readme': '/create:readme',\n31:     'sk-create-repo-rule': '/create:repo-rule',\n32:     'sk-create-skill': '/create:sk-skill',\n33:     'sk-create-skill-parent': '/create:skill-parent',\n34:     'sk-create-with-human-voice': '/create:with-human-voice',\n35:   },\n36:   'system-deep-loop': {\n37:     'ai-council': '/deep:ai-council',\n38:     'research': '/deep:research',\n39:     'review': '/deep:review',\n40:   },\n41: };\n42: // END GENERATED MODE COMMANDS\n43: \n44: // One row of the command table: the runnable slash command, the policy that says\n45: // whether it runs, asks or starts a session, the class that says what the run\n46: // writes, and the skill that owns it. The rows are generated, so only the shape\n47: // lives here.\n48: export interface CommandRow {\n49:   readonly command: string;\n50:   readonly policy?: 'run' | 'start' | 'ask';\n51:   readonly mutating?: 'read-only' | 'add-only' | 'mutates';\n52:   readonly ownerSkillId: string;\n53: }\n54: \n55: // The table below covers every tracked command, whether or not its bridge is\n56: // active, so a typed command always has a policy and an owner. `scorerRow` says\n57: // whether a scorer can also return the command on its own.\n58: export interface TrackedCommand {\n59:   readonly policy: 'run' | 'start' | 'ask';\n60:   readonly ownerSkillId: string;\n61:   readonly scorerRow: boolean;\n62: }\n63: \n64: // BEGIN GENERATED COMMAND ROWS\n65: export const COMMAND_ROWS: Readonly<Record<string, CommandRow>> = {\n66:   'command-create-agent': { command: '/create:agent', policy: 'start', mutating: 'mutates', ownerSkillId: 'sk-doc' },\n67:   'command-create-changelog': { command: '/create:changelog', policy: 'ask', mutating: 'mutates', ownerSkillId: 'sk-doc' },\n68:   'command-create-feature-catalog': { command: '/create:feature-catalog', policy: 'start', mutating: 'mutates', ownerSkillId: 'sk-doc' },\n69:   'command-create-manual-testing-playbook': { command: '/create:manual-testing-playbook', policy: 'start', mutating: 'mutates', ownerSkillId: 'sk-doc' },\n70:   'command-create-readme': { command: '/create:readme', policy: 'start', mutating: 'mutates', ownerSkillId: 'sk-doc' },\n71:   'command-create-sk-skill': { command: '/create:sk-skill', policy: 'start', mutating: 'mutates', ownerSkillId: 'sk-doc' },\n72:   'command-deep-research': { command: '/deep:research', policy: 'ask', mutating: 'mutates', ownerSkillId: 'system-deep-loop' },\n73:   'command-deep-review': { command: '/deep:review', policy: 'ask', mutating: 'mutates', ownerSkillId: 'system-deep-loop' },\n74:   'command-doctor-agents-md-check': { command: '/doctor:agents-md check', policy: 'run', mutating: 'read-only', ownerSkillId: 'system-skilled-doctor' },\n75:   'command-doctor-agents-md-embed': { command: '/doctor:agents-md embed', policy: 'ask', mutating: 'mutates', ownerSkillId: 'system-skilled-doctor' },\n76:   'command-doctor-agents-md-restore': { command: '/doctor:agents-md restore', policy: 'ask', mutating: 'mutates', ownerSkillId: 'system-skilled-doctor' },\n77:   'command-doctor-ci-report': { command: '/doctor:ci report', policy: 'run', mutating: 'read-only', ownerSkillId: 'sk-code' },\n78:   'command-doctor-ci-scaffold': { command: '/doctor:ci scaffold', policy: 'ask', mutating: 'mutates', ownerSkillId: 'sk-code' },\n79:   'command-doctor-ci-toggle': { command: '/doctor:ci toggle', policy: 'ask', mutating: 'mutates', ownerSkillId: 'sk-code' },\n80:   'command-doctor-deep-loop': { command: '/doctor:deep-loop', policy: 'run', mutating: 'add-only', ownerSkillId: 'system-deep-loop' },\n81:   'command-doctor-env': { command: '/doctor:env list', policy: 'run', mutating: 'read-only', ownerSkillId: 'system-skilled-doctor' },\n82:   'command-doctor-git-hooks': { command: '/doctor:git hooks', policy: 'ask', mutating: 'mutates', ownerSkillId: 'sk-git' },\n83:   'command-doctor-git-setup': { command: '/doctor:git setup', policy: 'run', mutating: 'read-only', ownerSkillId: 'sk-git' },\n84:   'command-doctor-git-standards': { command: '/doctor:git standards', policy: 'ask', mutating: 'mutates', ownerSkillId: 'sk-git' },\n85:   'command-doctor-helper': { command: '/doctor:helper', policy: 'run', mutating: 'read-only', ownerSkillId: 'system-skilled-doctor' },\n86:   'command-doctor-install': { command: '/doctor:install', policy: 'run', mutating: 'read-only', ownerSkillId: 'system-skilled-doctor' },\n87:   'command-doctor-mcp-debug': { command: '/doctor:mcp debug', policy: 'ask', mutating: 'mutates', ownerSkillId: 'system-skilled-doctor' },\n88:   'command-doctor-mcp-install': { command: '/doctor:mcp install', policy: 'ask', mutating: 'mutates', ownerSkillId: 'system-skilled-doctor' },\n89:   'command-doctor-overlay-apply': { command: '/doctor:overlay apply', policy: 'ask', mutating: 'mutates', ownerSkillId: 'system-skilled-doctor' },\n90:   'command-doctor-overlay-repin': { command: '/doctor:overlay repin', policy: 'ask', mutating: 'mutates', ownerSkillId: 'system-skilled-doctor' },\n91:   'command-doctor-overlay-status': { command: '/doctor:overlay status', policy: 'run', mutating: 'read-only', ownerSkillId: 'system-skilled-doctor' },\n92:   'command-doctor-runtime-mirrors': { command: '/doctor:runtime-mirrors', policy: 'run', mutating: 'read-only', ownerSkillId: 'system-skilled-doctor' },\n93:   'command-doctor-setup': { command: '/doctor:setup', policy: 'run', mutating: 'read-only', ownerSkillId: 'system-skilled-doctor' },\n94:   'command-doctor-sk-code-quality': { command: '/doctor:sk-code quality', policy: 'ask', mutating: 'mutates', ownerSkillId: 'sk-code' },\n95:   'command-doctor-sk-code-setup': { command: '/doctor:sk-code setup', policy: 'run', mutating: 'read-only', ownerSkillId: 'sk-code' },\n96:   'command-doctor-sk-skill-check': { command: '/doctor:sk-skill check', policy: 'run', mutating: 'read-only', ownerSkillId: 'sk-doc' },\n97:   'command-doctor-sk-skill-convert': { command: '/doctor:sk-skill convert', policy: 'ask', mutating: 'mutates', ownerSkillId: 'sk-doc' },\n98:   'command-doctor-skill-advisor-embedder': { command: '/doctor:skill-advisor embedder', policy: 'ask', mutating: 'mutates', ownerSkillId: 'system-skill-advisor' },\n99:   'command-doctor-skill-advisor-parent-skill': { command: '/doctor:skill-advisor parent-skill', policy: 'run', mutating: 'read-only', ownerSkillId: 'system-skill-advisor' },\n100:   'command-doctor-skill-advisor-rebuild': { command: '/doctor:skill-advisor rebuild', policy: 'ask', mutating: 'mutates', ownerSkillId: 'system-skill-advisor' },\n101:   'command-doctor-skill-advisor-router-reach': { command: '/doctor:skill-advisor router-reach', policy: 'run', mutating: 'read-only', ownerSkillId: 'system-skill-advisor' },\n102:   'command-doctor-skill-advisor-skill-budget': { command: '/doctor:skill-advisor skill-budget', policy: 'run', mutating: 'read-only', ownerSkillId: 'system-skill-advisor' },\n103:   'command-doctor-skill-advisor-skill-graph-freshness': { command: '/doctor:skill-advisor skill-graph-freshness', policy: 'run', mutating: 'read-only', ownerSkillId: 'system-skill-advisor' },\n104:   'command-doctor-skill-advisor-tune': { command: '/doctor:skill-advisor tune', policy: 'ask', mutating: 'mutates', ownerSkillId: 'system-skill-advisor' },\n105:   'command-doctor-speckit': { command: '/doctor:speckit', policy: 'run', mutating: 'add-only', ownerSkillId: 'system-skilled-doctor' },\n106:   'command-doctor-symlink-check': { command: '/doctor:symlink check', policy: 'run', mutating: 'read-only', ownerSkillId: 'system-skilled-doctor' },\n107:   'command-doctor-symlink-link': { command: '/doctor:symlink link', policy: 'ask', mutating: 'mutates', ownerSkillId: 'system-skilled-doctor' },\n108:   'command-doctor-symlink-unlink': { command: '/doctor:symlink unlink', policy: 'ask', mutating: 'mutates', ownerSkillId: 'system-skilled-doctor' },\n109:   'command-doctor-update': { command: '/doctor:update', policy: 'ask', mutating: 'mutates', ownerSkillId: 'system-skilled-doctor' },\n110:   'command-prompt-improve': { command: '/prompt:improve', policy: 'start', mutating: 'mutates', ownerSkillId: 'sk-prompt' },\n111:   'command-spec-kit-deep-research': { command: '/deep:research', policy: 'ask', mutating: 'mutates', ownerSkillId: 'system-deep-loop' },\n112:   'command-spec-kit-deep-review': { command: '/deep:review', policy: 'ask', mutating: 'mutates', ownerSkillId: 'system-deep-loop' },\n113:   'command-speckit-complete': { command: '/speckit:complete', policy: 'start', mutating: 'mutates', ownerSkillId: 'system-spec-kit' },\n114:   'command-speckit-handoff': { command: '/speckit:handoff', policy: 'ask', mutating: 'mutates', ownerSkillId: 'system-spec-kit' },\n115:   'command-speckit-implement': { command: '/speckit:implement', policy: 'start', mutating: 'mutates', ownerSkillId: 'system-spec-kit' },\n116:   'command-speckit-plan': { command: '/speckit:plan', policy: 'start', mutating: 'mutates', ownerSkillId: 'system-spec-kit' },\n117:   'command-speckit-resume': { command: '/speckit:resume', policy: 'start', mutating: 'mutates', ownerSkillId: 'system-spec-kit' },\n118:   'command-speckit-save': { command: '/speckit:save', policy: 'start', mutating: 'mutates', ownerSkillId: 'system-spec-kit' },\n119:   'command-speckit-search': { command: '/speckit:search', policy: 'run', mutating: 'read-only', ownerSkillId: 'system-spec-kit' },\n120:   'create:agent': { command: '/create:agent', policy: 'start', mutating: 'mutates', ownerSkillId: 'sk-doc' },\n121:   'create:manual-testing-playbook': { command: '/create:manual-testing-playbook', policy: 'start', mutating: 'mutates', ownerSkillId: 'sk-doc' },\n122: };\n123: export const TRACKED_COMMANDS: Readonly<Record<string, TrackedCommand>> = {\n124:   '/create:agent': { policy: 'start', ownerSkillId: 'sk-doc', scorerRow: true },\n125:   '/create:benchmark': { policy: 'start', ownerSkillId: 'sk-doc', scorerRow: false },\n126:   '/create:changelog': { policy: 'ask', ownerSkillId: 'sk-doc', scorerRow: false },\n127:   '/create:command': { policy: 'start', ownerSkillId: 'sk-doc', scorerRow: false },\n128:   '/create:diff': { policy: 'start', ownerSkillId: 'sk-doc', scorerRow: false },\n129:   '/create:feature-catalog': { policy: 'start', ownerSkillId: 'sk-doc', scorerRow: false },\n130:   '/create:goal': { policy: 'start', ownerSkillId: 'sk-doc', scorerRow: false },\n131:   '/create:manual-testing-playbook': { policy: 'start', ownerSkillId: 'sk-doc', scorerRow: true },\n132:   '/create:readme': { policy: 'start', ownerSkillId: 'sk-doc', scorerRow: false },\n133:   '/create:repo-rule': { policy: 'start', ownerSkillId: 'sk-doc', scorerRow: false },\n134:   '/create:sk-skill': { policy: 'start', ownerSkillId: 'sk-doc', scorerRow: false },\n135:   '/create:skill-parent': { policy: 'start', ownerSkillId: 'sk-doc', scorerRow: false },\n136:   '/create:with-human-voice': { policy: 'start', ownerSkillId: 'sk-doc', scorerRow: false },\n137:   '/deep:ai-council': { policy: 'ask', ownerSkillId: 'system-deep-loop', scorerRow: false },\n138:   '/deep:research': { policy: 'ask', ownerSkillId: 'system-deep-loop', scorerRow: false },\n139:   '/deep:review': { policy: 'ask', ownerSkillId: 'system-deep-loop', scorerRow: false },\n140:   '/design:chart': { policy: 'start', ownerSkillId: 'sk-design', scorerRow: false },\n141:   '/design:diagram': { policy: 'start', ownerSkillId: 'sk-design', scorerRow: false },\n142:   '/design:extract': { policy: 'ask', ownerSkillId: 'sk-design', scorerRow: false },\n143:   '/doctor:agents-md check': { policy: 'run', ownerSkillId: 'system-skilled-doctor', scorerRow: true },\n144:   '/doctor:agents-md embed': { policy: 'ask', ownerSkillId: 'system-skilled-doctor', scorerRow: true },\n145:   '/doctor:agents-md restore': { policy: 'ask', ownerSkillId: 'system-skilled-doctor', scorerRow: true },\n146:   '/doctor:ci report': { policy: 'run', ownerSkillId: 'sk-code', scorerRow: true },\n147:   '/doctor:ci scaffold': { policy: 'ask', ownerSkillId: 'sk-code', scorerRow: true },\n148:   '/doctor:ci toggle': { policy: 'ask', ownerSkillId: 'sk-code', scorerRow: true },\n149:   '/doctor:deep-loop': { policy: 'run', ownerSkillId: 'system-deep-loop', scorerRow: true },\n150:   '/doctor:env list': { policy: 'run', ownerSkillId: 'system-skilled-doctor', scorerRow: true },\n151:   '/doctor:git hooks': { policy: 'ask', ownerSkillId: 'sk-git', scorerRow: true },\n152:   '/doctor:git setup': { policy: 'run', ownerSkillId: 'sk-git', scorerRow: true },\n153:   '/doctor:git standards': { policy: 'ask', ownerSkillId: 'sk-git', scorerRow: true },\n154:   '/doctor:helper': { policy: 'run', ownerSkillId: 'system-skilled-doctor', scorerRow: true },\n155:   '/doctor:install': { policy: 'run', ownerSkillId: 'system-skilled-doctor', scorerRow: true },\n156:   '/doctor:mcp debug': { policy: 'ask', ownerSkillId: 'system-skilled-doctor', scorerRow: true },\n157:   '/doctor:mcp install': { policy: 'ask', ownerSkillId: 'system-skilled-doctor', scorerRow: true },\n158:   '/doctor:overlay apply': { policy: 'ask', ownerSkillId: 'system-skilled-doctor', scorerRow: true },\n159:   '/doctor:overlay repin': { policy: 'ask', ownerSkillId: 'system-skilled-doctor', scorerRow: true },\n160:   '/doctor:overlay status': { policy: 'run', ownerSkillId: 'system-skilled-doctor', scorerRow: true },\n161:   '/doctor:runtime-mirrors': { policy: 'run', ownerSkillId: 'system-skilled-doctor', scorerRow: true },\n162:   '/doctor:setup': { policy: 'run', ownerSkillId: 'system-skilled-doctor', scorerRow: true },\n163:   '/doctor:sk-code quality': { policy: 'ask', ownerSkillId: 'sk-code', scorerRow: true },\n164:   '/doctor:sk-code setup': { policy: 'run', ownerSkillId: 'sk-code', scorerRow: true },\n165:   '/doctor:sk-skill check': { policy: 'run', ownerSkillId: 'sk-doc', scorerRow: true },\n166:   '/doctor:sk-skill convert': { policy: 'ask', ownerSkillId: 'sk-doc', scorerRow: true },\n167:   '/doctor:skill-advisor embedder': { policy: 'ask', ownerSkillId: 'system-skill-advisor', scorerRow: true },\n168:   '/doctor:skill-advisor parent-skill': { policy: 'run', ownerSkillId: 'system-skill-advisor', scorerRow: true },\n169:   '/doctor:skill-advisor rebuild': { policy: 'ask', ownerSkillId: 'system-skill-advisor', scorerRow: true },\n170:   '/doctor:skill-advisor router-reach': { policy: 'run', ownerSkillId: 'system-skill-advisor', scorerRow: true },\n171:   '/doctor:skill-advisor skill-budget': { policy: 'run', ownerSkillId: 'system-skill-advisor', scorerRow: true },\n172:   '/doctor:skill-advisor skill-graph-freshness': { policy: 'run', ownerSkillId: 'system-skill-advisor', scorerRow: true },\n173:   '/doctor:skill-advisor tune': { policy: 'ask', ownerSkillId: 'system-skill-advisor', scorerRow: true },\n174:   '/doctor:speckit': { policy: 'run', ownerSkillId: 'system-skilled-doctor', scorerRow: true },\n175:   '/doctor:symlink check': { policy: 'run', ownerSkillId: 'system-skilled-doctor', scorerRow: true },\n176:   '/doctor:symlink link': { policy: 'ask', ownerSkillId: 'system-skilled-doctor', scorerRow: true },\n177:   '/doctor:symlink unlink': { policy: 'ask', ownerSkillId: 'system-skilled-doctor', scorerRow: true },\n178:   '/doctor:update': { policy: 'ask', ownerSkillId: 'system-skilled-doctor', scorerRow: true },\n179:   '/prompt:improve': { policy: 'start', ownerSkillId: 'sk-prompt', scorerRow: true },\n180:   '/speckit:complete': { policy: 'start', ownerSkillId: 'system-spec-kit', scorerRow: true },\n181:   '/speckit:handoff': { policy: 'ask', ownerSkillId: 'system-spec-kit', scorerRow: true },\n182:   '/speckit:implement': { policy: 'start', ownerSkillId: 'system-spec-kit', scorerRow: true },\n183:   '/speckit:plan': { policy: 'start', ownerSkillId: 'system-spec-kit', scorerRow: true },\n184:   '/speckit:resume': { policy: 'start', ownerSkillId: 'system-spec-kit', scorerRow: true },\n185:   '/speckit:save': { policy: 'start', ownerSkillId: 'system-spec-kit', scorerRow: true },\n186:   '/speckit:search': { policy: 'run', ownerSkillId: 'system-spec-kit', scorerRow: true },\n187: };\n188: // END GENERATED COMMAND ROWS\n189: \n190: // The row for an id a recommendation carries, or undefined when that id names no\n191: // command. Own-key lookup because the table is generated data, so an inherited\n192: // name such as `constructor` must not resolve to a row nobody declared.\n193: export function commandRowFor(id: string): CommandRow | undefined {\n194:   return Object.hasOwn(COMMAND_ROWS, id) ? COMMAND_ROWS[id] : undefined;\n195: }\n196: \n197: // A typed command is the reader's own wording, so it counts only where a command\n198: // can start and where it ends on a boundary. That keeps a path such as\n199: // `docs/create:goal.md` and a prefix such as `/create:sk` from reading as a\n200: // command, and the longest key wins so `/group:name-parent` is never reduced to\n201: // its `/group:name` prefix. A dot or a slash followed by a word character\n202: // continues a file name or a path, while a sentence-ending period does not.\n203: // A mode suffix is how the command documents say to type a command, so it ends\n204: // the command name the way a space does.\n205: const COMMAND_START_BOUNDARY = /[\\s`'\"(]/;\n206: const COMMAND_CONTINUATION = /[a-z0-9_:-]/;\n207: const WORD_CHARACTER = /[a-z0-9_]/;\n208: const MODE_SUFFIX = /^:(?:auto|confirm|autopilot)(?![a-z0-9_:-])/;\n209: \n210: // A command that was renamed is still typed from habit. Its old name reads as\n211: // the command that replaced it, so the reader lands on the live workflow and\n212: // not on whatever skill the leftover words happen to score for. The old name\n213: // gets no command file of its own: this table is the only place it lives.\n214: const RETIRED_COMMANDS: Readonly<Record<string, string>> = {\n215:   '/create:skill': '/create:sk-skill',\n216: };\n217: \n218: export function typedCommandIn(prompt: string): string | undefined {\n219:   const lowered = prompt.toLowerCase();\n220:   let found: string | undefined;\n221:   for (const key of [...Object.keys(TRACKED_COMMANDS), ...Object.keys(RETIRED_COMMANDS)]) {\n222:     let index = lowered.indexOf(key);\n223:     while (index !== -1) {\n224:       const before = index === 0 ? '' : lowered[index - 1];\n225:       const after = lowered[index + key.length] ?? '';\n226:       const next = lowered[index + key.length + 1] ?? '';\n227:       const startsAtBoundary = before === '' || COMMAND_START_BOUNDARY.test(before);\n228:       const hasModeSuffix = MODE_SUFFIX.test(lowered.slice(index + key.length));\n229:       const continuesName =\n230:         !hasModeSuffix\n231:         && (COMMAND_CONTINUATION.test(after) || ((after === '/' || after === '.') && WORD_CHARACTER.test(next)));\n232:       const endsAtBoundary = after === '' || !continuesName;\n233:       if (startsAtBoundary && endsAtBoundary) {\n234:         if (found === undefined || key.length > found.length) found = key;\n235:         break;\n236:       }\n237:       index = lowered.indexOf(key, index + 1);\n238:     }\n239:   }\n240:   if (found !== undefined && Object.hasOwn(RETIRED_COMMANDS, found)) return RETIRED_COMMANDS[found];\n241:   return found;\n242: }\n243: \n244: // A typed command travels on the recommendation that leads, so it is delivered\n245: // only when the leading skill owns the command or carries the same command row.\n246: // A leading skill unrelated to the command must not carry it.\n247: export interface TypedCommand {\n248:   readonly command: string;\n249:   readonly policy: 'run' | 'start' | 'ask';\n250:   readonly ownerSkillId: string;\n251: }\n252: \n253: export function typedCommandForTop(topSkillId: string, prompt: string): TypedCommand | undefined {\n254:   const command = typedCommandIn(prompt);\n255:   if (command === undefined || !Object.hasOwn(TRACKED_COMMANDS, command)) return undefined;\n256:   if (commandOnlyMentioned(prompt, command)) return undefined;\n257:   const row = TRACKED_COMMANDS[command];\n258:   const sameCommandRow = commandRowFor(topSkillId)?.command === command;\n259:   if (topSkillId !== row.ownerSkillId && !sameCommandRow) return undefined;\n260:   return { command, policy: row.policy, ownerSkillId: row.ownerSkillId };\n261: }\n262: \n263: // Deep-loop commands open a long, multi-pass run, so one attached to a prompt\n264: // that merely mentions the topic spends the reader's budget on work they never\n265: // asked for. The list below is the vocabulary that counts as asking for it, and\n266: // it holds only effort wording: a bare topic word such as `research`, `review`\n267: // or `council` says what to look at, never how far to go, so it never qualifies\n268: // on its own.\n269: //\n270: // The phrases live in a data list, one per line, so the vocabulary a reviewer\n271: // has to judge stays visible and cheap to correct.\n272: export const DEPTH_WORDING: readonly string[] = [\n273:   'in depth',\n274:   'deep dive',\n275:   'deep research',\n276:   'deep review',\n277:   'thorough',\n278:   'thoroughly',\n279:   'exhaustive',\n280:   'iteratively',\n281:   'multiple passes',\n282:   'many passes',\n283:   'several passes',\n284:   'ask the council',\n285:   'convene',\n286:   'several models',\n287:   'final verdict',\n288:   'everything you can',\n289: ];\n290: \n291: // A creation workflow scaffolds, reviews and validates a whole document, which is\n292: // the wrong size for a correction inside one. The list below is the vocabulary\n293: // that marks that correction, and a line number points at one the same way.\n294: export const SMALL_EDIT_WORDING: readonly string[] = [\n295:   'typo',\n296:   'typos',\n297:   'spelling',\n298:   'misspelled',\n299:   'misspelling',\n300:   'grammar',\n301:   'punctuation',\n302:   'wording',\n303:   'broken link',\n304:   'broken links',\n305:   'dead link',\n306:   'dead links',\n307:   'one line',\n308:   'single line',\n309: ];\n310: \n311: // A phrase may carry punctuation a regex would read as a metacharacter, so it is\n312: // escaped before it is trusted as a pattern.\n313: function escapePhrase(phrase: string): string {\n314:   return phrase.replace(/[.*+?^${}()|[\\]\\\\]/g, '\\\\$&');\n315: }\n316: \n317: // One alternation over the list keeps the gate a single test per prompt, and the\n318: // boundary markers keep `thorough` from firing inside a longer word while a\n319: // multi-word phrase still has to match as a whole.\n320: const DEPTH_REQUEST = new RegExp(`\\\\b(?:${DEPTH_WORDING.map(escapePhrase).join('|')})\\\\b`);\n321: \n322: // The line alternative is a pattern rather than a phrase, so it is appended raw\n323: // beside the escaped vocabulary instead of being escaped with it.\n324: const SMALL_EDIT_REQUEST = new RegExp(\n325:   `\\\\b(?:${SMALL_EDIT_WORDING.map(escapePhrase).join('|')}|line \\\\d+)\\\\b`,\n326: );\n327: \n328: // A request that asks for a document to be created or written wants the whole\n329: // document, even when it names a correction to make afterwards, so this check\n330: // stands the small-edit gate down.\n331: const CREATION_REQUEST = /\\b(?:creat(?:e|es|ing)|writ(?:e|es|ing)|author(?:ing)?|draft(?:ing)?|scaffold(?:ing)?|generat(?:e|es|ing)|mak(?:e|es|ing)|new|build(?:ing)?|set up|add an?|need an?)\\b/;\n332: \n333: // A small edit names the correction to make, so the verb is what marks one.\n334: const CORRECTION_VERB = /\\b(?:fix|correct|update|edit|change|tweak|repair)\\b/;\n335: \n336: // These three creation commands write a whole document that is later corrected in\n337: // place, so a correction request names an edit to it rather than a new one. Every\n338: // other creation command names a purpose that a correction word belongs to.\n339: const SMALL_EDIT_GATED_COMMANDS: ReadonlySet<string> = new Set(['/create:readme', '/create:feature-catalog', '/create:manual-testing-playbook']);\n340: \n341: // Wording that asks for an answer and rules out a change. One pattern serves\n342: // every gate that has to honour it, so a new gate cannot drift from the first.\n343: // Words alone cannot tell \"make no changes to the files\" from a change request\n344: // that says what to leave alone, so both read as no change: losing an offer\n345: // costs less than offering a mutating command on a prompt that ruled one out.\n346: // A negated write verb counts only with an object that names nothing in\n347: // particular, because \"don't add tools\" limits a change and does not refuse it.\n348: export const NO_EDIT_REQUEST = /\\b(no edits?|make no changes|no changes yet|without making changes|(?:do not|don't|dont) (?:make (?:any )?changes|change|edit|modify|touch|(?:create|write|add|delete|remove) (?:it|this|that|anything|any files?))|read-only only|no edits yet|only; do not|just show|just list)\\b/;\n349: \n350: // Many keyboards type the contraction with a curly apostrophe, so the text is\n351: // folded to the straight form before the pattern reads it.\n352: export function isNoEditRequest(text: string): boolean {\n353:   return NO_EDIT_REQUEST.test(text.toLowerCase().replace(/[\\u2018\\u2019]/g, \"'\"));\n354: }\n355: \n356: // A refusal or a question reaches its command through a use verb, so the two\n357: // lists below share this one. A gap holds one or two plain words and no\n358: // punctuation, because a comma ends the clause that holds the lead.\n359: export const COMMAND_USE_VERB = '(?:run|start|use|invoke|launch|execute|call|trigger|open|rerun|re-run|kick off)';\n360: export const COMMAND_GAP_WORDS = \"(?:[a-z']+ ){0,2}\";\n361: \n362: // `why not` proposes the command rather than refusing it, so the word refuses\n363: // only where no `why` stands before it.\n364: const COMMAND_NOT_WORD = '(?<!\\\\bwhy )not';\n365: \n366: // A command the reader refuses is named without being asked for, so this list\n367: // holds the leads that mark that naming. A lead must sit directly before the\n368: // command so a later clause cannot refuse an earlier request, and a gap holds\n369: // plain words only so a refusal before a comma cannot swallow the request after\n370: // it. A reader who stops using a command names it only to refuse it.\n371: export const COMMAND_DECLINE_LEADS: readonly string[] = [\n372:   `(?:do not|don't|dont|never|${COMMAND_NOT_WORD}|won't|wont|no longer|cannot|can't|no need to|need not|needn't) (?!(?:forget|hesitate|fail|mind)\\\\b)${COMMAND_GAP_WORDS}${COMMAND_USE_VERB} ${COMMAND_GAP_WORDS}`,\n373:   `(?:skip|skipping|without|instead of|rather than|avoid|stop|stopped|quit|${COMMAND_NOT_WORD}) (?:(?!${COMMAND_USE_VERB}\\\\b)[a-z']+ ){0,2}`,\n374: ];\n375: \n376: // A command the reader asks about is named without being asked for, so this list\n377: // holds the leads that mark that naming. A lead must sit directly before the\n378: // command so a later clause cannot turn an earlier request into a question, and\n379: // a gap holds plain words only so a question before a comma cannot swallow the\n380: // request after it.\n381: export const COMMAND_ASK_LEADS: readonly string[] = [\n382:   \"(?:what does|what is|what's|what would|what will|what did|how does|how did|why does|why did|explain|describe|tell me what|tell me how|tell me about|tell me why|difference between|differ from|differs from|different from|undo what|ran|already ran|was running) (?:the )?(?:command )?\",\n383:   `(?:should i|should we|do i need to|when would i) ${COMMAND_USE_VERB} (?:the )?(?:command )?`,\n384: ];\n385: \n386: // A bare ask word opens a statement as often as a question, so it marks a naming\n387: // only when the command it precedes is followed by a question mark before the\n388: // sentence ends, or when the lead itself opens a sentence, which a question mark ends as a full stop does.\n389: export const COMMAND_BARE_ASK_LEAD = '(?:is|does|can|will|would) ';\n390: \n391: // A clause that opens with a use verb and `it` asks for the command an earlier\n392: // clause only named, so a naming such as `not run /x yet, please start it`\n393: // becomes a request. The clause has to open that way so `I will run it` stays a\n394: // statement.\n395: const COMMAND_ASKED_BY_PRONOUN = new RegExp(`(?:^|[,.;!?\\\\n]) *(?:(?:and|then|so|please|now|just|go ahead and) )*${COMMAND_USE_VERB} it\\\\b`);\n396: \n397: // A prompt names a command to refuse it or to ask about it as often as it names\n398: // one to run it, so an offer must read the naming before it trusts the name. The\n399: // text is folded first, because a keyed apostrophe or a run of spaces must not\n400: // hide the lead, while a line break survives as the sentence end it is. The\n401: // boundary before the lead keeps a command name from matching inside a word or a\n402: // path, and the boundary after it keeps a longer command name from reading as the\n403: // shorter one. Every occurrence has to carry a lead, because one led naming does\n404: // not turn a later unled naming into a request.\n405: export function commandOnlyMentioned(prompt: string, command: string): boolean {\n406:   const text = prompt\n407:     .toLowerCase()\n408:     .replace(/[\\u2018\\u2019]/g, \"'\")\n409:     .replace(/[^\\S\\n]+/g, ' ')\n410:     .replace(/ *\\n\\s*/g, '\\n');\n411:   const name = escapePhrase(command.toLowerCase());\n412:   const occurrences = [...text.matchAll(new RegExp(`(?:^|[^a-z0-9_/])${name}(?![a-z0-9_-])`, 'g'))];\n413:   if (occurrences.length === 0) return false;\n414:   return occurrences.every((occurrence) => {\n415:     const nameEnd = (occurrence.index ?? 0) + occurrence[0].length;\n416:     const before = text.slice(0, nameEnd);\n417:     const tail = text.slice(nameEnd);\n418:     if (COMMAND_ASKED_BY_PRONOUN.test(tail.split(/(?:^|[\\s,;(])\\/[a-z][a-z0-9_-]*(?::[a-z][a-z0-9_-]*)?(?![a-z0-9_\\/-]|\\.[a-z0-9])/)[0])) return false;\n419:     const led = [...COMMAND_DECLINE_LEADS, ...COMMAND_ASK_LEADS].some((lead) => (\n420:       new RegExp(`(?:^|[^a-z0-9_/])${lead}${name}$`).test(before)\n421:     ));\n422:     if (led) return true;\n423:     const bareLead = new RegExp(`(?:^|[^a-z0-9_/])${COMMAND_BARE_ASK_LEAD}${name}$`).test(before);\n424:     if (!bareLead) return false;\n425:     const sentenceEnd = tail.search(/[.!\\n]/);\n426:     const sentence = sentenceEnd === -1 ? tail : tail.slice(0, sentenceEnd);\n427:     // A chat question often leaves the question mark off, so a bare ask word that\n428:     // opens a sentence still asks about the command.\n429:     return sentence.includes('?')\n430:       || new RegExp(`(?:^|[.!?\\\\n] *)${COMMAND_BARE_ASK_LEAD}${name}$`).test(before);\n431:   });\n432: }\n433: \n434: // A compiled route arrives as unvalidated JSON from a separate process, so the\n435: // shape is narrowed here rather than trusted. Arrays count as objects in\n436: // JavaScript and would let `action` read off an unrelated field, so they are\n437: // excluded explicitly.\n438: function asRecord(value: unknown): Record<string, unknown> | undefined {\n439:   if (typeof value !== 'object' || value === null || Array.isArray(value)) return undefined;\n440:   return value as Record<string, unknown>;\n441: }\n442: \n443: // The command for a hub's recommendation, or undefined when the route does not\n444: // single out one mode. Only a single-mode route names a command unambiguously:\n445: // a bundle or a multi-target route has more than one answer, and asking the\n446: // reader to pick belongs to the recommend path, not here. Never throws, because\n447: // a missing command must degrade to \"no command offered\" rather than break\n448: // routing. The prompt decides whether a costly deep-loop command is offered at\n449: // all: a reader who only asks about the topic gets no command, rather than one\n450: // that would launch work they never requested.\n451: export function attachCommand(\n452:   skillId: string,\n453:   compiledRoute: unknown,\n454:   prompt: string,\n455:   modeCommands: Readonly<Record<string, Readonly<Record<string, string>>>> = MODE_COMMANDS,\n456: ): string | undefined {\n457:   const route = asRecord(compiledRoute);\n458:   if (!route) return undefined;\n459:   if (route.action !== 'route' || route.selectionKind !== 'single') return undefined;\n460: \n461:   const targets = route.targets;\n462:   if (!Array.isArray(targets) || targets.length !== 1) return undefined;\n463: \n464:   const onlyTarget = asRecord(targets[0]);\n465:   if (!onlyTarget) return undefined;\n466: \n467:   const workflowMode = onlyTarget.workflowMode;\n468:   if (typeof workflowMode !== 'string' || workflowMode === '') return undefined;\n469: \n470:   // A reader who rules out a change gets no command from either path, so the hub\n471:   // route never offers what the scorer already withholds.\n472:   if (isNoEditRequest(prompt)) return undefined;\n473: \n474:   // Own-key lookup on both levels: the table is data read from a generated\n475:   // object, so an inherited name such as `constructor` must not resolve to a\n476:   // command the hub never declared.\n477:   if (!Object.prototype.hasOwnProperty.call(modeCommands, skillId)) return undefined;\n478:   const commands = modeCommands[skillId];\n479:   if (!Object.prototype.hasOwnProperty.call(commands, workflowMode)) return undefined;\n480: \n481:   // A route can pick the mode because the prompt named its command, so a naming\n482:   // that refused or asked about the command must not produce the offer.\n483:   if (commandOnlyMentioned(prompt, commands[workflowMode])) return undefined;\n484: \n485:   // A correction inside one document is not a request for a creation workflow,\n486:   // which scaffolds, reviews and validates a whole one.\n487:   if (\n488:     SMALL_EDIT_GATED_COMMANDS.has(commands[workflowMode])\n489:     && SMALL_EDIT_REQUEST.test(prompt.toLowerCase())\n490:     && !CREATION_REQUEST.test(prompt.toLowerCase())\n491:     && CORRECTION_VERB.test(prompt.toLowerCase())\n492:   ) return undefined;\n493: \n494:   // Deep-loop commands are the ones that commit the reader to a long, multi-pass\n495:   // run, so they are offered only when the prompt asks for that effort. Typing\n496:   // the command being attached is itself the ask, while typing another deep-loop\n497:   // command asks for that command, not this one. Every other hub answers a short\n498:   // question with a short answer, so no other skill consults the wording list.\n499:   if (skillId === 'system-deep-loop') {\n500:     const typesThisCommand = typedCommandIn(prompt) === commands[workflowMode];\n501:     if (!typesThisCommand && !DEPTH_REQUEST.test(prompt.toLowerCase())) return undefined;\n502:   }\n503: \n504:   return commands[workflowMode];\n505: }\n506: \n507: // A hub that withholds its command because the prompt names no single mode must\n508: // still tell the reader why no command came with it, and only a hub whose modes\n509: // map to commands withholds one. A hub that tops a prompt which never named it\n510: // is the scorer's guess, so the label would point at modes the reader did not\n511: // ask about.\n512: export function routeNeedsMode(\n513:   skillId: string,\n514:   compiledRoute: unknown,\n515:   namedSkills: readonly string[],\n516: ): boolean {\n517:   if (!namedSkills.includes(skillId)) return false;\n518:   const route = asRecord(compiledRoute);\n519:   if (!route) return false;\n520:   if (route.action !== 'defer' && route.action !== 'clarify') return false;\n521:   return Object.prototype.hasOwnProperty.call(MODE_COMMANDS, skillId);\n522: }"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\": \".skilled/skills/system-skill-advisor/runtime/lib/command-attach.ts\"}"},"time":{"start":1794669429369,"end":1794669429393}}}}
{"type":"step_finish","timestamp":1794669437680,"sessionID":"ses_e255ff46fffexTncZnylD3HfiJ","part":{"id":"prt_1daa262f0001CPd2dpqHqvcBWJ","sessionID":"ses_e255ff46fffexTncZnylD3HfiJ","messageID":"msg_1daa221e7001g6jk0A1ksFi8nS","type":"step-finish","reason":"tool-calls","snapshot":"c554db15e70b1dd377919e598bcb0f122d0df60d","cost":0,"tokens":{"input":2728,"output":55,"reasoning":25,"cache":{"read":111616,"write":0}}}}
{"type":"step_start","timestamp":1794669445014,"sessionID":"ses_e255ff46fffexTncZnylD3HfiJ","part":{"id":"prt_1daa27f96001JRVzRiL7C1KMnD","sessionID":"ses_e255ff46fffexTncZnylD3HfiJ","messageID":"msg_1daa262f7001al7UemOIuviKwH","type":"step-start","snapshot":"c554db15e70b1dd377919e598bcb0f122d0df60d"}}
{"type":"tool_use","timestamp":1794669473806,"sessionID":"ses_e255ff46fffexTncZnylD3HfiJ","part":{"partID":"prt_1daa2ef60001hoymy2RXkIdoeR","sessionID":"ses_e255ff46fffexTncZnylD3HfiJ","messageID":"msg_1daa262f7001al7UemOIuviKwH","type":"tool","id":"call_01_h7tgvf4ch1n4w2lnd6cjnuq5","tool":"shell","state":{"status":"completed","input":{"command":"sed -n '1530,1643p' .skilled/skills/system-skill-advisor/runtime/lib/scorer/fusion.ts; sed -n '430,540p' .skilled/skills/system-skill-advisor/runtime/handlers/advisor-recommend.ts"},"output":"        && BREADTH_NOUN.test(promptLower)\n        && !BREADTH_NARROW_ANCHOR.test(promptLower);\n      const multiConcern = MULTI_CONCERN_VERB.test(promptLower)\n        && concernClasses >= 2;\n      if (broadBuild || multiConcern) {\n        const topRec = finished.find((recommendation) => recommendation.passes_threshold)\n          ?? null;\n        if (topRec && (\n          topRec.skill === 'sk-code'\n          || topRec.skill === 'system-skill-advisor'\n        )) {\n          const confThreshold = options.confidenceThreshold\n            ?? DEFAULT_CONFIDENCE_THRESHOLD;\n          const uncThreshold = options.uncertaintyThreshold\n            ?? DEFAULT_UNCERTAINTY_THRESHOLD;\n          const floor = SCORING_CALIBRATION.uncertainty.lowInfoAmbiguityFloor;\n          finished = finished.map((recommendation) => {\n            if (!recommendation.passes_threshold) return recommendation;\n            const uncertainty = Math.max(recommendation.uncertainty, floor);\n            return {\n              ...recommendation,\n              uncertainty,\n              passes_threshold: recommendation.confidence >= confThreshold\n                && uncertainty <= uncThreshold,\n            };\n          });\n        }\n      }\n    }\n\n    // Post-fusion so a resolved executor delegation can carry negative evidence\n    // the pre-clamp explicit lane cannot express, and so it runs after every\n    // abstention gate. The alias table is metadata-derived, so new executors or\n    // small models need no change here. It is a no-op on non-delegation prompts.\n    return applyExecutorDelegationOverride(finished, {\n      promptLower,\n      projection,\n      workspaceRoot: options.workspaceRoot,\n      confidenceThreshold: options.confidenceThreshold ?? DEFAULT_CONFIDENCE_THRESHOLD,\n      uncertaintyThreshold: options.uncertaintyThreshold ?? DEFAULT_UNCERTAINTY_THRESHOLD,\n    });\n  };\n\n  const fullRun = finishRanked(ranked);\n  const doctorFreeRun = finishRanked(ranked.filter((recommendation) => (\n    recommendation.kind !== 'command'\n    || !recommendation.skill.startsWith(DOCTOR_BRIDGE_PREFIX)\n  )));\n  let doctorFreeIndex = 0;\n  ranked = fullRun.map((recommendation) => {\n    if (\n      recommendation.kind === 'command'\n      && recommendation.skill.startsWith(DOCTOR_BRIDGE_PREFIX)\n    ) {\n      return recommendation;\n    }\n    return doctorFreeRun[doctorFreeIndex++]!;\n  });\n\n  const commandMeaningPassed = new Set<string>();\n  const projectionSkillById = new Map(projection.skills.map((skill) => [skill.id, skill]));\n  ranked = requireCommandPhraseAnchor(\n    ranked,\n    options.confidenceThreshold ?? DEFAULT_CONFIDENCE_THRESHOLD,\n    commandMeaningPassed,\n    (skillId) => commandMeaningEligible(promptLower, readOnlyExplainer, projectionSkillById.get(skillId)),\n    options.uncertaintyThreshold ?? DEFAULT_UNCERTAINTY_THRESHOLD,\n  );\n  const leadPhrasesById = new Map<string, readonly string[]>();\n  for (const skill of projection.skills) {\n    if (!skill.id.startsWith(DOCTOR_BRIDGE_PREFIX) || !skill.leadPhrases?.length) continue;\n    leadPhrasesById.set(skill.id, skill.leadPhrases);\n  }\n  ranked = keepPassingSkillsAboveDoctorBridges(ranked, promptLower, leadPhrasesById);\n  ranked = rankMeaningPassedCommandFirst(ranked, commandMeaningPassed);\n  ranked = applyDoctorHelperHandoff(ranked, {\n    prompt,\n    promptLower,\n    projection,\n    workspaceRoot: options.workspaceRoot,\n    confidenceThreshold: options.confidenceThreshold ?? DEFAULT_CONFIDENCE_THRESHOLD,\n    uncertaintyThreshold: options.uncertaintyThreshold ?? DEFAULT_UNCERTAINTY_THRESHOLD,\n    leadPhrasesById,\n  });\n  ranked = withholdMentionedCommands(ranked, prompt);\n  ranked = withholdWritingCommandsOnNoEdit(ranked, promptLower);\n  ranked = rankTypedCommandOwnerFirst(ranked, promptLower);\n\n  const passing = ranked.filter((recommendation) => recommendation.passes_threshold);\n  const visible = options.includeAllCandidates ? ranked : passing;\n  const top = passing[0] ?? null;\n  const laneHealthReason = degradedLaneReason(degradedLanes);\n  const abstainReasons = laneHealthReason ? [laneHealthReason] : [];\n  if (isSpeckitMetricsEnabled() && top) {\n    const runtimeLabel = normalizeRuntimeLabel(process.env.SPECKIT_RUNTIME);\n    const freshnessLabel = normalizeFreshnessLabel(process.env.SPECKIT_ADVISOR_FRESHNESS);\n    if (runtimeLabel && freshnessLabel) {\n      speckitMetrics.incrementCounter('spec_kit.advisor.recommendation_emitted_total', { runtime: runtimeLabel, freshness_state: freshnessLabel });\n    }\n    speckitMetrics.recordConfidenceBracket(top.confidence);\n  }\n  return {\n    recommendations: visible,\n    topSkill: top?.skill ?? null,\n    unknown: !top,\n    ambiguous: isAmbiguousTopTwo(ranked),\n    metrics: {\n      candidateCount: ranked.length,\n      liveLaneCount: runtimeLiveLaneCount,\n      ...(degradedLanes.length > 0 ? { degradedLanes, laneHealth } : {}),\n    },\n    ...(abstainReasons.length > 0 ? { abstainReasons } : {}),\n  };\n}\n  output: AdvisorRecommendOutput,\n  prompt: string,\n  workspaceRoot: string,\n  surfaceHint?: string,\n  topOnly = false,\n): AdvisorRecommendOutput {\n  const mode = parseCompiledRoutingFlagMode(process.env.SPECKIT_COMPILED_ROUTING);\n  if (mode === 'invalid') {\n    emitCompiledRoutingBreadcrumb(\n      `ignoring invalid SPECKIT_COMPILED_ROUTING=${JSON.stringify(process.env.SPECKIT_COMPILED_ROUTING)}; serving legacy`,\n    );\n  }\n  // Only enrich hubs the flag permits. The default cohort now covers all 7\n  // compiled-eligible hubs (mirrors the runtime resolver's own default-on\n  // cohort), so unset attaches compiledRoute for those hubs; the kill-switch\n  // ('0'|'false'|'off') and invalid values still skip enrichment for every hub.\n  // Skip the schema re-parse entirely when nothing is eligible so the output is\n  // returned unchanged.\n  const anyEligible = output.recommendations.some((r) => compiledRoutingEnabledForHub(r.skillId));\n  if (!anyEligible) return output;\n  const namedSkills = extractMetalinguisticSkillMentions(prompt);\n  // A command row that already ranks in this result offers its command by itself,\n  // so the owning hub must not offer the same one again and spend a second slot on it.\n  const alreadyOffered = new Set<string>();\n  for (const recommendation of output.recommendations) {\n    if (recommendation.command) alreadyOffered.add(recommendation.command);\n  }\n  return AdvisorRecommendOutputSchema.parse({\n    ...output,\n    recommendations: output.recommendations.map((recommendation, index) => {\n      // Each lookup is a subprocess, so a caller that acts on the top pick alone\n      // pays for that one and no more.\n      if (topOnly && index > 0) return recommendation;\n      if (!compiledRoutingEnabledForHub(recommendation.skillId)) return recommendation;\n      const compiledRoute = compiledRouteForRecommendation(\n        recommendation.skillId,\n        prompt,\n        workspaceRoot,\n        surfaceHint,\n      );\n      if (!compiledRoute) return recommendation;\n      // The route answers which mode the hub would take; the command is what a reader\n      // types to run it, so it rides along only when the route names exactly one mode\n      // that has a command. A broader route leaves the key off rather than guessing.\n      const command = attachCommand(recommendation.skillId, compiledRoute, prompt);\n      // Every caller renders the head and at most one partner, so a command a\n      // lower row carries would never reach the reader. The head keeps the\n      // command whichever request shape the caller asked for.\n      return command && (!alreadyOffered.has(command) || index === 0)\n        ? {\n          ...recommendation,\n          compiledRoute,\n          command,\n          ...(Object.hasOwn(TRACKED_COMMANDS, command) ? { policy: TRACKED_COMMANDS[command].policy } : {}),\n        }\n        : { ...recommendation, compiledRoute, ...(!command && routeNeedsMode(recommendation.skillId, compiledRoute, namedSkills) ? { needsMode: true as const } : {}) };\n    }),\n  });\n}\n\n// A typed command is the reader's own choice, so it outranks a routed mode: the\n// reader already named the command, and a compiled route only guesses which mode\n// they meant. The top recommendation carries it because that is the row a reader\n// acts on, and an unrelated top keeps the output it had.\nexport function attachTypedCommand(\n  output: AdvisorRecommendOutput,\n  prompt: string,\n): AdvisorRecommendOutput {\n  const top = output.recommendations[0];\n  if (!top) return output;\n  const typed = typedCommandForTop(top.skillId, prompt);\n  if (!typed) return output;\n  return AdvisorRecommendOutputSchema.parse({\n    ...output,\n    recommendations: [\n      {\n        ...top,\n        command: typed.command,\n        policy: typed.policy,\n        ownerSkillId: typed.ownerSkillId,\n      },\n      ...output.recommendations.slice(1),\n    ],\n  });\n}\n\nfunction publicShadowRecommendations(recommendations: readonly ScoredRecommendation[], topK: number): ShadowRecommendation[] {\n  const shadowRecommendations: ShadowRecommendation[] = [];\n  for (const recommendation of recommendations) {\n    const skillId = sanitizeSkillLabel(recommendation.skill);\n    if (!skillId) continue;\n    const shadowContributions = recommendation.laneContributions.map((lane) => ({\n      lane: lane.lane,\n      weightedScore: lane.rawScore * DEFAULT_SHADOW_SCORER_LANE_WEIGHTS[lane.lane],\n    }));\n    const shadowScore = roundScore(shadowContributions.reduce((total, lane) => total + lane.weightedScore, 0));\n    const dominant = shadowContributions\n      .filter((lane) => lane.weightedScore > 0)\n      .sort((left, right) => right.weightedScore - left.weightedScore)[0]?.lane ?? null;\n    shadowRecommendations.push({\n        skillId,\n        liveScore: recommendation.score,\n        shadowScore,\n        delta: roundScore(shadowScore - recommendation.score),\n        dominantShadowLane: dominant,\n    });\n  }\n  return shadowRecommendations\n    .sort((left, right) => right.shadowScore - left.shadowScore || left.skillId.localeCompare(right.skillId))\n    .slice(0, topK);\n}\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"        && BREADTH_NOUN.test(promptLower)\n        && !BREADTH_NARROW_ANCHOR.test(promptLower);\n      const multiConcern = MULTI_CONCERN_VERB.test(promptLower)\n        && concernClasses >= 2;\n      if (broadBuild || multiConcern) {\n        const topRec = finished.find((recommendation) => recommendation.passes_threshold)\n          ?? null;\n        if (topRec && (\n          topRec.skill === 'sk-code'\n          || topRec.skill === 'system-skill-advisor'\n        )) {\n          const confThreshold = options.confidenceThreshold\n            ?? DEFAULT_CONFIDENCE_THRESHOLD;\n          const uncThreshold = options.uncertaintyThreshold\n            ?? DEFAULT_UNCERTAINTY_THRESHOLD;\n          const floor = SCORING_CALIBRATION.uncertainty.lowInfoAmbiguityFloor;\n          finished = finished.map((recommendation) => {\n            if (!recommendation.passes_threshold) return recommendation;\n            const uncertainty = Math.max(recommendation.uncertainty, floor);\n            return {\n              ...recommendation,\n              uncertainty,\n              passes_threshold: recommendation.confidence >= confThreshold\n                && uncertainty <= uncThreshold,\n            };\n          });\n        }\n      }\n    }\n\n    // Post-fusion so a resolved executor delegation can carry negative evidence\n    // the pre-clamp explicit lane cannot express, and so it runs after every\n    // abstention gate. The alias table is metadata-derived, so new executors or\n    // small models need no change here. It is a no-op on non-delegation prompts.\n    return applyExecutorDelegationOverride(finished, {\n      promptLower,\n      projection,\n      workspaceRoot: options.workspaceRoot,\n      confidenceThreshold: options.confidenceThreshold ?? DEFAULT_CONFIDENCE_THRESHOLD,\n      uncertaintyThreshold: options.uncertaintyThreshold ?? DEFAULT_UNCERTAINTY_THRESHOLD,\n    });\n  };\n\n  const fullRun = finishRanked(ranked);\n  const doctorFreeRun = finishRanked(ranked.filter((recommendation) => (\n    recommendation.kind !== 'command'\n    || !recommendation.skill.startsWith(DOCTOR_BRIDGE_PREFIX)\n  )));\n  let doctorFreeIndex = 0;\n  ranked = fullRun.map((recommendation) => {\n    if (\n      recommendation.kind === 'command'\n      && recommendation.skill.startsWith(DOCTOR_BRIDGE_PREFIX)\n    ) {\n      return recommendation;\n    }\n    return doctorFreeRun[doctorFreeIndex++]!;\n  });\n\n  const commandMeaningPassed = new Set<string>();\n  const projectionSkillById = new Map(projection.skills.map((skill) => [skill.id, skill]));\n  ranked = requireCommandPhraseAnchor(\n    ranked,\n    options.confidenceThreshold ?? DEFAULT_CONFIDENCE_THRESHOLD,\n    commandMeaningPassed,\n    (skillId) => commandMeaningEligible(promptLower, readOnlyExplainer, projectionSkillById.get(skillId)),\n    options.uncertaintyThreshold ?? DEFAULT_UNCERTAINTY_THRESHOLD,\n  );\n  const leadPhrasesById = new Map<string, readonly string[]>();\n  for (const skill of projection.skills) {\n    if (!skill.id.startsWith(DOCTOR_BRIDGE_PREFIX) || !skill.leadPhrases?.length) continue;\n    leadPhrasesById.set(skill.id, skill.leadPhrases);\n  }\n  ranked = keepPassingSkillsAboveDoctorBridges(ranked, promptLower, leadPhrasesById);\n  ranked = rankMeaningPassedCommandFirst(ranked, commandMeaningPassed);\n  ranked = applyDoctorHelperHandoff(ranked, {\n    prompt,\n    promptLower,\n    projection,\n    workspaceRoot: options.workspaceRoot,\n    confidenceThreshold: options.confidenceThreshold ?? DEFAULT_CONFIDENCE_THRESHOLD,\n    uncertaintyThreshold: options.uncertaintyThreshold ?? DEFAULT_UNCERTAINTY_THRESHOLD,\n    leadPhrasesById,\n  });\n  ranked = withholdMentionedCommands(ranked, prompt);\n  ranked = withholdWritingCommandsOnNoEdit(ranked, promptLower);\n  ranked = rankTypedCommandOwnerFirst(ranked, promptLower);\n\n  const passing = ranked.filter((recommendation) => recommendation.passes_threshold);\n  const visible = options.includeAllCandidates ? ranked : passing;\n  const top = passing[0] ?? null;\n  const laneHealthReason = degradedLaneReason(degradedLanes);\n  const abstainReasons = laneHealthReason ? [laneHealthReason] : [];\n  if (isSpeckitMetricsEnabled() && top) {\n    const runtimeLabel = normalizeRuntimeLabel(process.env.SPECKIT_RUNTIME);\n    const freshnessLabel = normalizeFreshnessLabel(process.env.SPECKIT_ADVISOR_FRESHNESS);\n    if (runtimeLabel && freshnessLabel) {\n      speckitMetrics.incrementCounter('spec_kit.advisor.recommendation_emitted_total', { runtime: runtimeLabel, freshness_state: freshnessLabel });\n    }\n    speckitMetrics.recordConfidenceBracket(top.confidence);\n  }\n  return {\n    recommendations: visible,\n    topSkill: top?.skill ?? null,\n    unknown: !top,\n    ambiguous: isAmbiguousTopTwo(ranked),\n    metrics: {\n      candidateCount: ranked.length,\n      liveLaneCount: runtimeLiveLaneCount,\n      ...(degradedLanes.length > 0 ? { degradedLanes, laneHealth } : {}),\n    },\n    ...(abstainReasons.length > 0 ? { abstainReasons } : {}),\n  };\n}\n  output: AdvisorRecommendOutput,\n  prompt: string,\n  workspaceRoot: string,\n  surfaceHint?: string,\n  topOnly = false,\n): AdvisorRecommendOutput {\n  const mode = parseCompiledRoutingFlagMode(process.env.SPECKIT_COMPILED_ROUTING);\n  if (mode === 'invalid') {\n    emitCompiledRoutingBreadcrumb(\n      `ignoring invalid SPECKIT_COMPILED_ROUTING=${JSON.stringify(process.env.SPECKIT_COMPILED_ROUTING)}; serving legacy`,\n    );\n  }\n  // Only enrich hubs the flag permits. The default cohort now covers all 7\n  // compiled-eligible hubs (mirrors the runtime resolver's own default-on\n  // cohort), so unset attaches compiledRoute for those hubs; the kill-switch\n  // ('0'|'false'|'off') and invalid values still skip enrichment for every hub.\n  // Skip the schema re-parse entirely when nothing is eligible so the output is\n  // returned unchanged.\n  const anyEligible = output.recommendations.some((r) => compiledRoutingEnabledForHub(r.skillId));\n  if (!anyEligible) return output;\n  const namedSkills = extractMetalinguisticSkillMentions(prompt);\n  // A command row that already ranks in this result offers its command by itself,\n  // so the owning hub must not offer the same one again and spend a second slot on it.\n  const alreadyOffered = new Set<string>();\n  for (const recommendation of output.recommendations) {\n    if (recommendation.command) alreadyOffered.add(recommendation.command);\n  }\n  return AdvisorRecommendOutputSchema.parse({\n    ...output,\n    recommendations: output.recommendations.map((recommendation, index) => {\n      // Each lookup is a subprocess, so a caller that acts on the top pick alone\n      // pays for that one and no more.\n      if (topOnly && index > 0) return recommendation;\n      if (!compiledRoutingEnabledForHub(recommendation.skillId)) return recommendation;\n      const compiledRoute = compiledRouteForRecommendation(\n        recommendation.skillId,\n        prompt,\n        workspaceRoot,\n        surfaceHint,\n      );\n      if (!compiledRoute) return recommendation;\n      // The route answers which mode the hub would take; the command is what a reader\n      // types to run it, so it rides along only when the route names exactly one mode\n      // that has a command. A broader route leaves the key off rather than guessing.\n      const command = attachCommand(recommendation.skillId, compiledRoute, prompt);\n      // Every caller renders the head and at most one partner, so a command a\n      // lower row carries would never reach the reader. The head keeps the\n      // command whichever request shape the caller asked for.\n      return command && (!alreadyOffered.has(command) || index === 0)\n        ? {\n          ...recommendation,\n          compiledRoute,\n          command,\n          ...(Object.hasOwn(TRACKED_COMMANDS, command) ? { policy: TRACKED_COMMANDS[command].policy } : {}),\n        }\n        : { ...recommendation, compiledRoute, ...(!command && routeNeedsMode(recommendation.skillId, compiledRoute, namedSkills) ? { needsMode: true as const } : {}) };\n    }),\n  });\n}\n\n// A typed command is the reader's own choice, so it outranks a routed mode: the\n// reader already named the command, and a compiled route only guesses which mode\n// they meant. The top recommendation carries it because that is the row a reader\n// acts on, and an unrelated top keeps the output it had.\nexport function attachTypedCommand(\n  output: AdvisorRecommendOutput,\n  prompt: string,\n): AdvisorRecommendOutput {\n  const top = output.recommendations[0];\n  if (!top) return output;\n  const typed = typedCommandForTop(top.skillId, prompt);\n  if (!typed) return output;\n  return AdvisorRecommendOutputSchema.parse({\n    ...output,\n    recommendations: [\n      {\n        ...top,\n        command: typed.command,\n        policy: typed.policy,\n        ownerSkillId: typed.ownerSkillId,\n      },\n      ...output.recommendations.slice(1),\n    ],\n  });\n}\n\nfunction publicShadowRecommendations(recommendations: readonly ScoredRecommendation[], topK: number): ShadowRecommendation[] {\n  const shadowRecommendations: ShadowRecommendation[] = [];\n  for (const recommendation of recommendations) {\n    const skillId = sanitizeSkillLabel(recommendation.skill);\n    if (!skillId) continue;\n    const shadowContributions = recommendation.laneContributions.map((lane) => ({\n      lane: lane.lane,\n      weightedScore: lane.rawScore * DEFAULT_SHADOW_SCORER_LANE_WEIGHTS[lane.lane],\n    }));\n    const shadowScore = roundScore(shadowContributions.reduce((total, lane) => total + lane.weightedScore, 0));\n    const dominant = shadowContributions\n      .filter((lane) => lane.weightedScore > 0)\n      .sort((left, right) => right.weightedScore - left.weightedScore)[0]?.lane ?? null;\n    shadowRecommendations.push({\n        skillId,\n        liveScore: recommendation.score,\n        shadowScore,\n        delta: roundScore(shadowScore - recommendation.score),\n        dominantShadowLane: dominant,\n    });\n  }\n  return shadowRecommendations\n    .sort((left, right) => right.shadowScore - left.shadowScore || left.skillId.localeCompare(right.skillId))\n    .slice(0, topK);\n}\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\": \"sed -n '1530,1643p' .skilled/skills/system-skill-advisor/runtime/lib/scorer/fusion.ts; sed -n '430,540p' .skilled/skills/system-skill-advisor/runtime/handlers/advisor-recommend.ts\"}"},"time":{"start":1794669473632,"end":1794669473806}}}}
