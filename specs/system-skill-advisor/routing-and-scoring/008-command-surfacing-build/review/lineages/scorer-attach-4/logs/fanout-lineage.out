r: 1.03, lexical: 1.02, graph_causal: 0.96, derived_generated: 0.98, semantic_shadow: 1.00 };\n.skilled/skills/system-skill-advisor/runtime/lib/scorer/fusion.ts:200:      return { explicit_author: 1.03, lexical: 0.98, graph_causal: 0.95, derived_generated: 1.04, semantic_shadow: 1.00 };\n.skilled/skills/system-skill-advisor/runtime/lib/scorer/fusion.ts:202:      return { explicit_author: 1.04, lexical: 0.98, graph_causal: 1.02, derived_generated: 1.00, semantic_shadow: 0.96 };\n.skilled/skills/system-skill-advisor/runtime/lib/scorer/fusion.ts:204:      return { explicit_author: 1.04, lexical: 1.00, graph_causal: 0.98, derived_generated: 0.96, semantic_shadow: 1.00 };\n.skilled/skills/system-skill-advisor/runtime/lib/scorer/fusion.ts:224:    .filter((lane) => lane !== 'explicit_author')\n.skilled/skills/system-skill-advisor/runtime/lib/scorer/fusion.ts:226:  if (next.explicit_author < strongestOther) {\n.skilled/skills/system-skill-advisor/runtime/lib/scorer/fusion.ts:227:    next.explicit_author = Number(strongestOther.toFixed(6));\n.skilled/skills/system-skill-advisor/runtime/lib/scorer/fusion.ts:513:    .filter((contribution) => contribution.lane === 'explicit_author' || contribution.lane === 'lexical')\n.skilled/skills/system-skill-advisor/runtime/lib/scorer/fusion.ts:533:  if (!disabled.has('explicit_author')) {\n.skilled/skills/system-skill-advisor/runtime/lib/scorer/fusion.ts:534:    scores.explicit_author = scoreExplicitLane(prompt, projection);\n.skilled/skills/system-skill-advisor/runtime/lib/scorer/fusion.ts:543:      ...scores.explicit_author,\n.skilled/skills/system-skill-advisor/runtime/lib/scorer/fusion.ts:671:  const explicit = contributions.find((contribution) => contribution.lane === 'explicit_author');\n.skilled/skills/system-skill-advisor/runtime/lib/scorer/fusion.ts:928:      contribution.lane === 'explicit_author' && contribution.rawScore > 0\n.skilled/skills/system-skill-advisor/runtime/lib/scorer/fusion.ts:1159:      contribution.lane === 'explicit_author' && contribution.rawScore > 0\n.skilled/skills/system-skill-advisor/runtime/lib/scorer/fusion.ts:1341:      new Set([...laneScoreIndexes.explicit_author]\n.skilled/skills/system-skill-advisor/runtime/lib/scorer/fusion.ts:1362:      contributions.find((contribution) => contribution.lane === 'explicit_author')?.rawScore ?? 0,\n.skilled/skills/system-skill-advisor/runtime/lib/scorer/fusion.ts:1494:          (contribution.lane === 'explicit_author'\n.skilled/skills/system-skill-advisor/runtime/lib/scorer/attribution.ts:31:    .filter((contribution) => contribution.lane === 'explicit_author' || contribution.lane === 'lexical')\n.skilled/skills/system-skill-advisor/runtime/lib/scorer/lanes/explicit.ts:429:      lane: 'explicit_author' as const,\n.skilled/skills/system-skill-advisor/runtime/lib/scorer/executor-delegation.ts:491:  const explicit = rec.laneContributions.find((contribution) => contribution.lane === 'explicit_author');\n.skilled/skills/system-skill-advisor/runtime/lib/scorer/lane-registry.ts:9:  { id: 'explicit_author', defaultWeight: 0.42, defaultShadowWeight: 0.40, live: true },\n.skilled/skills/system-skill-advisor/runtime/lib/scorer/weights-config.ts:14:export const EXPLICIT_AUTHOR_WEIGHT = DEFAULT_SCORER_LANE_WEIGHTS.explicit_author;\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\": \"grep -n \\\"uncertaintyThreshold\\\\|DEFAULT_UNCERTAINTY_THRESHOLD\\\\|uncertainty\\\" .skilled/skills/system-skill-advisor/runtime/lib/scorer/fusion.ts | head -40; grep -rn \\\"explicit_author\\\\|lane: 'explicit\\\\|\\\\\\\"explicit\\\\\\\"\\\" .skilled/skills/system-skill-advisor/runtime/lib/scorer/ | head -30\"}"},"time":{"start":1794669473549,"end":1794669473842}}}}
