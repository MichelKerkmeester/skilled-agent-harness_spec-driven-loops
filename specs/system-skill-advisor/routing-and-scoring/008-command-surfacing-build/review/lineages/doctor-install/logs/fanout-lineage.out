\noverlay-engine-fixes.test.cjs\noverlay-engine-fixtures.cjs\noverlay-engine-follow-up.test.cjs\noverlay-engine-repin.test.cjs\noverlay-engine-replay.test.cjs\noverlay-engine-strict-writes.test.cjs\noverlay-engine-sync.test.cjs\nparent-skill-check-command-column.test.cjs\nparent-skill-check-invariants.test.cjs\nparent-skill-check-leaf-manifest.test.cjs\nparent-skill-check-root-router.test.cjs\nparent-skill-check-routing-shape.test.cjs\nREADME.markdown\nrelease-update.test.cjs\nroute-validate.test.sh\nrouting-shape-parity.test.cjs\nrun-all.sh\nsk-code-quality-config.test.cjs\nsk-code-setup-check.test.cjs\nsk-skill-check.test.cjs\nsk-skill-convert.test.cjs\nsk-skill-integrate.test.cjs\nskill-advisor-route-contract.test.cjs\nsymlink-engine.test.cjs\ntest_audit_descriptions.py\n=== fixtures\nagents-md\ndoctor-helper\nsk-skill-check\nsk-skill-convert\nsk-skill-integrate\n=== runtime-mirrors approval\n.skilled/commands/doctor/scripts/hook-wiring-check.cjs:30:  'Usage: hook-wiring-check.cjs --root <dir> [--json]',\n.skilled/commands/doctor/scripts/hook-wiring-check.cjs:75:  process.stderr.write(`hook-wiring-check: ${message}\\n`);\n.skilled/commands/doctor/scripts/hook-wiring-check.cjs:156:    process.stderr.write(`hook-wiring-check: ${err && err.message ? err.message : String(err)}\\n`);\n.skilled/commands/doctor/assets/doctor-runtime-mirrors.yaml:41:  codex_hook_approval: \".skilled/commands/doctor/scripts/codex-hook-approval-check.cjs\"\n.skilled/commands/doctor/scripts/codex-hook-approval-check.cjs:23:// Usage: codex-hook-approval-check.cjs [--root <dir>] [--config <path>] [--json]\n.skilled/commands/doctor/scripts/codex-hook-approval-check.cjs:42:const USAGE = 'Usage: codex-hook-approval-check.cjs [--root <dir>] [--config <path>] [--json]\\n';\n.skilled/commands/doctor/scripts/codex-hook-approval-check.cjs:186:      code: 'codex-hooks-approved',\n.skilled/commands/doctor/scripts/codex-hook-approval-check.cjs:191:    }, ['PASS codex-hooks-approved']);\n","title":"shell