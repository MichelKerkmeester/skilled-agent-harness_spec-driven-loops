{"type":"tool_use","timestamp":1794550360274,"sessionID":"ses_e2c799ae9ffehgaY2UX9uAVWD2","part":{"partID":"prt_1d38968b0001gY9e2N4AfJGyyQ","sessionID":"ses_e2c799ae9ffehgaY2UX9uAVWD2","messageID":"msg_1d3895db50014hBdipF7Xds4Fr","type":"tool","id":"call_00_oszzRCevdXeC8Z1fHYlI8507","tool":"read","state":{"status":"completed","input":{"path":".skilled/commands/doctor/scripts/agents-md-check.cjs"},"output":"Read file .skilled/commands/doctor/scripts/agents-md-check.cjs, lines 1-1056\n1: #!/usr/bin/env node\n2: // ───────────────────────────────────────────────────────────────────\n3: // MODULE: Shipped Instruction Check Engine\n4: // ───────────────────────────────────────────────────────────────────\n5: 'use strict';\n6: \n7: // A repository that took the shipped instruction template can be in any of seven\n8: // states, and nothing in it says which one. Its shipped sections may be current, one\n9: // release behind, or edited in place; its own content may sit in the marked block or be\n10: // scattered between shipped sections; it may have no root document at all. Without that\n11: // answer there is nothing to plan a rewrite from, and no way to tell a safe replacement\n12: // from one that would drop a line somebody wrote. So this engine reports, per row and\n13: // without writing a byte, what the repository holds against the manifest.\n14: //\n15: // Three of the twelve rows are answers this engine must not invent. The delivery budget\n16: // and its anchors belong to the rule-copy canary, the Cursor pointer block belongs to\n17: // the gate 1 sync, and the router belongs to the repo-rules checker. Each already has\n18: // tests and an owner, so each is run as a child process and its own lines are carried\n19: // into the report; re-deriving any of them here would be a second opinion that drifts\n20: // from the first. The rest are pure classifiers over one read of the target tree.\n21: //\n22: // The run is read-only by construction: the only paths it opens for reading are under\n23: // the target root plus the manifest, and the three child tools it runs are read-only\n24: // modes. A repository that cannot be classified at all (no manifest, no target\n25: // directory, an unreadable root document) is a failed precondition and exits 2, because\n26: // an empty report would read like a clean one.\n27: //\n28: // Usage: agents-md-check.cjs [--root <dir>] [--manifest <path>] [--source] [--json]\n29: //   --root <dir>      classify this repository instead of the one this script ships in\n30: //   --manifest <path> read this manifest instead of the shipped one\n31: //   --source          run the template-purity row even outside the source repository\n32: //   --json            print one JSON object instead of the text report\n33: // Exit codes: 0 nothing to report, 1 at least one finding or an unproven row,\n34: //             2 a precondition failed\n35: \n36: // ─────────────────────────────────────────────────────────────────────────────\n37: // 1. IMPORTS\n38: // ─────────────────────────────────────────────────────────────────────────────\n39: \n40: const { spawnSync } = require('node:child_process');\n41: const fs = require('node:fs');\n42: const path = require('node:path');\n43: \n44: const {\n45:   classifyBody,\n46:   deliveryAnchorEnd,\n47:   matchSections,\n48:   segment,\n49: } = require('./lib/agents-md-sections.cjs');\n50: const { sourceStatus } = require('./agents-md-manifest.cjs');\n51: \n52: // ─────────────────────────────────────────────────────────────────────────────\n53: // 2. CONSTANTS\n54: // ─────────────────────────────────────────────────────────────────────────────\n55: \n56: const TAG = '[agents-md-check]';\n57: const REPO_ROOT = path.resolve(__dirname, '../../../..');\n58: const MANIFEST_PATH = path.resolve(__dirname, '../assets/agents-md-manifest.json');\n59: const GENERATOR = path.resolve(__dirname, 'agents-md-manifest.cjs');\n60: // The router checker ships beside the skill that authors rules, and the manifest links\n61: // it only through the router's own row, so its path is named here once.\n62: const REPO_RULES_CHECKER = path.resolve(\n63:   REPO_ROOT,\n64:   '.skilled/skills/sk-doc/sk-create-repo-rule/scripts/check-repo-rules.cjs',\n65: );\n66: // The checker's own tag prefix. Matching on it is what keeps this row a carrier of that\n67: // tool's verdict instead of a second implementation of its checks.\n68: const REPO_RULES_TAG = '[repo-rules-check]';\n69: const USAGE = 'Usage: node .skilled/commands/doctor/scripts/agents-md-check.cjs [--root <dir>] [--manifest <path>] [--source] [--json]';\n70: const TOOL_TIMEOUT_MS = 120000;\n71: \n72: // A repository where fewer than half the shipped sections survive is carrying its own\n73: // document, not a copy of the template. Above the line the question becomes which parts\n74: // of the template are still there, which is a per-section answer.\n75: const FOREIGN_SHARE = 0.5;\n76: \n77: const PASS = 'PASS';\n78: const FINDING = 'FINDING';\n79: const UNKNOWN = 'UNKNOWN';\n80: const INFO = 'INFO';\n81: \n82: class UsageError extends Error {}\n83: \n84: // ─────────────────────────────────────────────────────────────────────────────\n85: // 3. ARGUMENTS\n86: // ─────────────────────────────────────────────────────────────────────────────\n87: \n88: function parseArgs(argv) {\n89:   const options = { root: REPO_ROOT, manifest: MANIFEST_PATH, source: false, json: false, help: false };\n90:   for (let index = 0; index < argv.length; index += 1) {\n91:     const argument = argv[index];\n92:     if (argument === '--root') {\n93:       const value = argv[index + 1];\n94:       if (!value || value.startsWith('--')) throw new UsageError('--root needs a directory');\n95:       options.root = path.resolve(value);\n96:       index += 1;\n97:     } else if (argument === '--manifest') {\n98:       const value = argv[index + 1];\n99:       if (!value || value.startsWith('--')) throw new UsageError('--manifest needs a file path');\n100:       options.manifest = path.resolve(value);\n101:       index += 1;\n102:     } else if (argument === '--source') {\n103:       options.source = true;\n104:     } else if (argument === '--json') {\n105:       options.json = true;\n106:     } else if (argument === '--help' || argument === '-h') {\n107:       options.help = true;\n108:     } else {\n109:       throw new UsageError(`unknown argument: ${argument}`);\n110:     }\n111:   }\n112:   return options;\n113: }\n114: \n115: // ─────────────────────────────────────────────────────────────────────────────\n116: // 4. READING THE TARGET ONCE\n117: // ─────────────────────────────────────────────────────────────────────────────\n118: \n119: // Section offsets are byte offsets because the delivery budget is a byte count, while a\n120: // reader opens the file by line number. One conversion, in one place.\n121: function lineNumberAt(text, byteOffset) {\n122:   return Buffer.from(text, 'utf8').subarray(0, byteOffset).toString('utf8').split('\\n').length;\n123: }\n124: \n125: function trimmedLines(text) {\n126:   const lines = new Set();\n127:   for (const raw of String(text).split('\\n')) {\n128:     const line = raw.trim();\n129:     if (line !== '' && line !== '---') lines.add(line);\n130:   }\n131:   return lines;\n132: }\n133: \n134: // The repository's own lines, in order and with repeats. A set would report one line for\n135: // two occurrences, and a replacement loses both, so a duplicate is a second line to keep.\n136: function localLinesOf(body, reference) {\n137:   const known = trimmedLines(reference);\n138:   const local = [];\n139:   for (const raw of body.split('\\n')) {\n140:     const line = raw.trim();\n141:     if (line === '' || line === '---' || known.has(line)) continue;\n142:     local.push(line);\n143:   }\n144:   return local;\n145: }\n146: \n147: function knownBodies(manifest) {\n148:   const sections = manifest.derived && manifest.derived.sections ? manifest.derived.sections : {};\n149:   return {\n150:     current: Object.keys(sections).map((id) => ({ id, sha256: sections[id].sha256, body: sections[id].body })),\n151:     history: (manifest.derived && manifest.derived.history) || [],\n152:   };\n153: }\n154: \n155: // The block carries a heading and a note that the template itself ships, so \"the block is\n156: // empty\" means nothing beyond those two lines, not that the markers bracket no text.\n157: function blockHasContent(block, markers) {\n158:   if (!block || !block.complete) return false;\n159:   const shipped = new Set([markers.heading.trim(), markers.note.trim()]);\n160:   for (const raw of block.content.split('\\n')) {\n161:     const line = raw.trim();\n162:     if (line === '' || shipped.has(line)) continue;\n163:     return true;\n164:   }\n165:   return false;\n166: }\n167: \n168: /**\n169:  * Read the target tree once and keep what every row needs.\n170:  *\n171:  * @param {{root: string, manifest: Object}} input\n172:  * @returns {Object|null} Null when the root directory is not there.\n173:  */\n174: function readTarget({ root, manifest }) {\n175:   if (!fs.existsSync(root) || !fs.statSync(root).isDirectory()) return null;\n176: \n177:   const rootPath = path.join(root, manifest.root_file);\n178:   const exists = fs.existsSync(rootPath);\n179:   const text = exists ? fs.readFileSync(rootPath, 'utf8') : null;\n180:   const segmentation = exists\n181:     ? segment(text, manifest.markers, manifest.sections)\n182:     : { sections: [], block: null, prelude: null };\n183:   const pairing = matchSections(segmentation.sections, manifest.sections, segmentation.prelude);\n184: \n185:   return {\n186:     root,\n187:     rootPath,\n188:     exists,\n189:     text,\n190:     totalBytes: exists ? Buffer.byteLength(text, 'utf8') : 0,\n191:     block: segmentation.block,\n192:     prelude: segmentation.prelude,\n193:     sections: segmentation.sections,\n194:     matched: pairing.matched,\n195:     unregistered: pairing.unregistered,\n196:     unmatched: pairing.unmatched,\n197:     conflicts: pairing.conflicts,\n198:     currency: pairing.matched.map((row) => ({\n199:       id: row.entry.id,\n200:       section: row.section,\n201:       ...classifyBody(row.section.body, knownBodies(manifest)),\n202:     })),\n203:     blockContent: blockHasContent(segmentation.block, manifest.markers),\n204:   };\n205: }\n206: \n207: // ─────────────────────────────────────────────────────────────────────────────\n208: // 5. THE TWELVE ROWS\n209: // ─────────────────────────────────────────────────────────────────────────────\n210: \n211: function row(id, name, state, detail, extra = {}) {\n212:   return { id, name, state, detail, lines: extra.lines || [], entries: extra.entries || [] };\n213: }\n214: \n215: // A1. The one row an operator reads first: which of the seven shapes this repository is.\n216: function rowInstallState(context, manifest) {\n217:   const claudePath = path.join(context.root, 'CLAUDE.md');\n218:   if (!context.exists) {\n219:     if (fs.existsSync(claudePath)) {\n220:       return row('A1', 'install state', FINDING, 'claude-only',\n221:         { lines: [`no ${manifest.root_file}; CLAUDE.md is the only instruction file`] });\n222:     }\n223:     return row('A1', 'install state', FINDING, 'absent',\n224:       { lines: [`no ${manifest.root_file} and no CLAUDE.md`] });\n225:   }\n226: \n227:   const share = manifest.sections.length === 0 ? 0 : context.matched.length / manifest.sections.length;\n228:   if (share < FOREIGN_SHARE) {\n229:     return row('A1', 'install state', FINDING, 'foreign', {\n230:       lines: [\n231:         `${context.matched.length} of ${manifest.sections.length} shipped sections match, under the ${Math.round(FOREIGN_SHARE * 100)}% floor`,\n232:         'the root document is the repository\\'s own file',\n233:       ],\n234:     });\n235:   }\n236: \n237:   const localEdits = context.currency.filter((entry) => entry.state === 'edited' || entry.state === 'unknown-base');\n238:   const behind = context.currency.filter((entry) => entry.state === 'stale-known');\n239:   // A local edit outranks a missed release in the reading order: it is the shape that\n240:   // loses text if somebody replaces the document, and staleness only loses a patch.\n241:   if (localEdits.length > 0 || context.unregistered.length > 0) {\n242:     const lines = [];\n243:     for (const entry of localEdits) lines.push(`${entry.id}: ${entry.state}`);\n244:     for (const entry of context.unregistered) {\n245:       lines.push(entry.heading === null\n246:         ? 'unmarked text before the first heading'\n247:         : `unmarked section ${JSON.stringify(entry.heading)}`);\n248:     }\n249:     return row('A1', 'install state', FINDING, 'forked', { lines });\n250:   }\n251:   if (behind.length > 0) {\n252:     return row('A1', 'install state', FINDING, 'stale',\n253:       { lines: behind.map((entry) => `${entry.id}: ${entry.state}`) });\n254:   }\n255:   if (context.blockContent) {\n256:     return row('A1', 'install state', PASS, 'adopted',\n257:       { lines: ['every shipped section is current and the repository block carries content'] });\n258:   }\n259:   return row('A1', 'install state', PASS, 'pure',\n260:     { lines: ['every shipped section is current and the repository block is empty'] });\n261: }\n262: \n263: // A2. Which shipped sections survived, by the prefix each authored entry carries.\n264: function rowSectionsPresent(context, manifest) {\n265:   const present = new Set(context.matched.map((row_) => row_.entry.id));\n266:   const missing = manifest.sections.map((entry) => entry.id).filter((id) => !present.has(id));\n267:   const detail = `${present.size}/${manifest.sections.length} matched`;\n268:   if (missing.length === 0 && context.conflicts.length === 0) {\n269:     return row('A2', 'sections present', PASS, detail);\n270:   }\n271:   const lines = missing.map((id) => `missing section ${id}`);\n272:   for (const conflict of context.conflicts) lines.push(conflict.message);\n273:   return row('A2', 'sections present', FINDING, `${present.size}/${manifest.sections.length} matched, ${missing.length} missing`, {\n274:     lines,\n275:     entries: missing.map((id) => ({ id, present: false })),\n276:   });\n277: }\n278: \n279: // The byte offset of the first line that is exactly this text, or -1 when the document\n280: // does not carry it.\n281: function firstLineOffset(text, needle) {\n282:   if (text.startsWith(needle)) return 0;\n283:   const at = text.indexOf(`\\n${needle}`);\n284:   return at === -1 ? -1 : at + 1;\n285: }\n286: \n287: // The shipped numbering, read from the pin that names it. Hundreds of files cite these\n288: // numbers, and the document carries its fourth section before its third, so the citation\n289: // order is not the reading order and only the pin carries the expected one.\n290: function numberingReport(context, manifest) {\n291:   if (!context.exists) return { state: INFO, detail: 'no root document to number', lines: [] };\n292: \n293:   const pin = (manifest.pins || []).find((entry) => entry.kind === 'order');\n294:   if (!pin) return { state: INFO, detail: 'the manifest declares no numbering pin', lines: [] };\n295: \n296:   const found = [];\n297:   const absent = [];\n298:   for (const text of pin.texts) {\n299:     const at = firstLineOffset(context.text, text);\n300:     if (at === -1) absent.push(text.trim());\n301:     else found.push({ text: text.trim(), at });\n302:   }\n303:   const expected = pin.texts.map((text) => text.trim()).filter((text) => found.some((entry) => entry.text === text));\n304:   const actual = found.slice().sort((left, right) => left.at - right.at).map((entry) => entry.text);\n305: \n306:   const lines = absent.map((text) => `missing section number ${JSON.stringify(text)}`);\n307:   if (expected.join('|') !== actual.join('|')) {\n308:     lines.push(`the numbers appear as ${actual.join(', ')} instead of ${expected.join(', ')}`);\n309:   }\n310:   return { state: lines.length === 0 ? PASS : FINDING, detail: `${found.length}/${pin.texts.length} section numbers in place`, lines };\n311: }\n312: \n313: // A3. Shipped sections in manifest order, and section numbers unchanged.\n314: function rowOrderAndNumbering(context, manifest) {\n315:   const order = manifest.sections.map((entry) => entry.id);\n316:   const seen = context.matched.map((entry) => entry.entry.id);\n317:   const expected = order.filter((id) => seen.includes(id));\n318:   const numbering = numberingReport(context, manifest);\n319: \n320:   const lines = [...numbering.lines];\n321:   if (expected.join('|') !== seen.join('|')) {\n322:     const first = seen.findIndex((id, index) => id !== expected[index]);\n323:     lines.unshift(`section order differs at position ${first + 1}: found ${seen[first]}, expected ${expected[first]}`);\n324:   }\n325:   const state = lines.length === 0 ? PASS : FINDING;\n326:   return row('A3', 'order and numbering', state, state === PASS ? 'manifest order and section numbers unchanged' : 'order or numbering drifted', { lines });\n327: }\n328: \n329: // A4. Per section, whether the body is the shipped one, an older release, a local edit\n330: // or something with no base to name.\n331: function rowCurrency(context) {\n332:   const counts = { current: 0, 'stale-known': 0, edited: 0, 'unknown-base': 0 };\n333:   const entries = [];\n334:   for (const entry of context.currency) {\n335:     counts[entry.state] += 1;\n336:     entries.push({ id: entry.id, state: entry.state, base: entry.base || null });\n337:   }\n338:   // Nothing to classify is not a clean bill: the rows around this one report the empty or\n339:   // foreign document, and a pass here would read as currency that was checked.\n340:   if (entries.length === 0) {\n341:     return row('A4', 'section currency', INFO, 'no shipped section matched, so there is no body to classify');\n342:   }\n343:   const detail = `${counts.current} current, ${counts['stale-known']} stale-known, ${counts.edited} edited, ${counts['unknown-base']} unknown-base`;\n344:   const lines = [];\n345:   for (const entry of context.currency) {\n346:     if (entry.state === 'current') continue;\n347:     const base = entry.base ? entry.base.slice(0, 12) : 'none';\n348:     lines.push(`${entry.id}: ${entry.state} (closest known body ${base})`);\n349:   }\n350:   return row('A4', 'section currency', lines.length === 0 ? PASS : FINDING, detail, { lines, entries });\n351: }\n352: \n353: // A5. Every string downstream tooling greps out of the document, checked by its rule.\n354: function rowPins(context, manifest) {\n355:   const entries = [];\n356:   const byId = new Map(context.matched.map((entry) => [entry.entry.id, entry.section]));\n357: \n358:   for (const pin of manifest.pins || []) {\n359:     const verdict = pinVerdict(pin, context, manifest, byId);\n360:     entries.push({ id: pin.id, kind: pin.kind, state: verdict.state, detail: verdict.detail });\n361:   }\n362: \n363:   const failed = entries.filter((entry) => entry.state === FINDING);\n364:   const unmeasured = entries.filter((entry) => entry.state === UNKNOWN);\n365:   const lines = failed.map((entry) => `${entry.id} (${entry.kind}): ${entry.detail}`);\n366:   for (const entry of unmeasured) lines.push(`${entry.id} (${entry.kind}): ${entry.detail}`);\n367:   const state = failed.length > 0 ? FINDING : (unmeasured.length > 0 ? UNKNOWN : PASS);\n368:   const detail = `${entries.length - failed.length - unmeasured.length}/${entries.length} pins hold${unmeasured.length > 0 ? `, ${unmeasured.length} unmeasured` : ''}`;\n369:   return row('A5', 'pins', state, detail, { lines, entries });\n370: }\n371: \n372: function pinVerdict(pin, context, manifest, byId) {\n373:   const section = pin.section ? byId.get(pin.section) : null;\n374:   if (pin.section && !section) {\n375:     return { state: FINDING, detail: `the section ${pin.section} that carries this pin is missing` };\n376:   }\n377: \n378:   switch (pin.kind) {\n379:     case 'exact': {\n380:       const missing = pin.texts.filter((text) => !section.body.includes(text));\n381:       return missing.length === 0\n382:         ? { state: PASS, detail: `all ${pin.texts.length} strings present in ${pin.section}` }\n383:         : { state: FINDING, detail: `missing ${JSON.stringify(missing[0])} in ${pin.section}` };\n384:     }\n385:     case 'line': {\n386:       const required = (pin.requires || pin.texts).map((text) => text.toLowerCase());\n387:       const hit = section.body.split('\\n').some((line) => {\n388:         const lower = line.toLowerCase();\n389:         return required.every((text) => lower.includes(text));\n390:       });\n391:       return hit\n392:         ? { state: PASS, detail: `a line in ${pin.section} carries ${required.join(', ')}` }\n393:         : { state: FINDING, detail: `no line in ${pin.section} carries ${required.join(', ')}` };\n394:     }\n395:     case 'first-occurrence': {\n396:       const at = context.text.indexOf(pin.texts[0]);\n397:       const inside = at >= section.start && at < section.end;\n398:       if (inside) return { state: PASS, detail: `the first occurrence sits inside ${pin.section}` };\n399:       return {\n400:         state: FINDING,\n401:         detail: at === -1\n402:           ? `the text ${JSON.stringify(pin.texts[0])} is absent`\n403:           : `the first occurrence at byte ${at} sits outside ${pin.section} (${section.start}..${section.end}), so anything reading the first line of the document follows it instead`,\n404:       };\n405:     }\n406:     case 'delivery-anchor': {\n407:       const end = deliveryAnchorEnd(section, pin);\n408:       if (end === null) return { state: FINDING, detail: `the anchor text is absent from ${pin.section}` };\n409:       const limit = manifest.budget.prefix_bytes;\n410:       return end <= limit\n411:         ? { state: PASS, detail: `${pin.section} ends at byte ${end}, inside ${limit}` }\n412:         : { state: FINDING, detail: `${pin.section} ends at byte ${end}, past the ${limit}-byte delivery prefix` };\n413:     }\n414:     case 'budget': {\n415:       const declared = manifest.budget[pin.limit_key];\n416:       const pinned = Number(pin.texts[0]);\n417:       return declared === pinned\n418:         ? { state: PASS, detail: `${pin.limit_key} is ${declared}` }\n419:         : { state: FINDING, detail: `${pin.limit_key} reads ${declared}, the pin says ${pinned}` };\n420:     }\n421:     case 'order': {\n422:       const numbering = numberingReport(context, manifest);\n423:       return { state: numbering.state, detail: numbering.detail };\n424:     }\n425:     case 'file': {\n426:       const target = path.join(context.root, pin.path);\n427:       return fs.existsSync(target)\n428:         ? { state: PASS, detail: `${pin.path} exists` }\n429:         : { state: FINDING, detail: `${pin.path} is missing` };\n430:     }\n431:     default:\n432:       // A kind the engine has no rule for is a pin nobody measured. Counting it as a hold\n433:       // would report a manifest edit as verified.\n434:       return { state: UNKNOWN, detail: `no rule for a pin of kind ${pin.kind}` };\n435:   }\n436: }\n437: \n438: // A6. The delivery budget: the canary's own AGENTS.md lines, plus the two measurements\n439: // the report needs. Only this row's file is kept, because the canary also pins the skill\n440: // it ships in and a consumer legitimately has none of those.\n441: function rowBudget(context, manifest, tools) {\n442:   if (typeof tools.canary !== 'string' || !fs.existsSync(tools.canary)) {\n443:     return row('A6', 'delivery budget', UNKNOWN,\n444:       `the rule-copy canary is not installed at ${tools.canary || '(no path)'}; the budget cannot be measured`);\n445:   }\n446: \n447:   const run = spawnSync(process.execPath, [tools.canary, '--root', context.root], {\n448:     encoding: 'utf8',\n449:     timeout: TOOL_TIMEOUT_MS,\n450:     maxBuffer: 16 * 1024 * 1024,\n451:   });\n452:   const output = `${run.stdout || ''}\\n${run.stderr || ''}`.split('\\n').map((line) => line.trim()).filter((line) => line !== '');\n453:   if (run.error || (run.status !== 0 && run.status !== 1)) {\n454:     return row('A6', 'delivery budget', UNKNOWN,\n455:       `the rule-copy canary could not run: ${run.error ? run.error.message : `exit ${run.status}`}`);\n456:   }\n457: \n458:   // The canary prints its verdict, an anchor table and its findings. Only the findings\n459:   // that name this document belong to this row; its PASS and table lines are its own\n460:   // report, and the anchor end byte is measured below instead of parsed back out.\n461:   const own = output\n462:     .filter((line) => line.includes(manifest.root_file))\n463:     .filter((line) => /^(MISSING|BLOCKED):/u.test(line));\n464:   const elsewhere = output.filter((line) => !line.includes(manifest.root_file));\n465: \n466:   const limit = manifest.budget.prefix_bytes;\n467:   const ceiling = manifest.budget.max_bytes;\n468:   const prefixEnd = (manifest.pins || [])\n469:     .filter((pin) => pin.kind === 'delivery-anchor')\n470:     .reduce((max, pin) => {\n471:       const section = context.matched.find((entry) => entry.entry.id === pin.section);\n472:       if (!section) return max;\n473:       const end = deliveryAnchorEnd(section.section, pin);\n474:       return end === null ? max : Math.max(max, end);\n475:     }, 0);\n476: \n477:   const failures = [...own];\n478:   // The canary already names whatever it measured, so this row adds a figure only for a\n479:   // defect the canary did not report, instead of printing the same ceiling twice.\n480:   if (prefixEnd > limit && !own.some((line) => line.includes('delivery prefix'))) {\n481:     failures.push(`the last anchor ends at byte ${prefixEnd}, past the ${limit}-byte delivery prefix`);\n482:   }\n483:   if (context.totalBytes > ceiling && !own.some((line) => line.includes('ceiling'))) {\n484:     failures.push(`${context.totalBytes} bytes exceeds the ${ceiling}-byte ceiling`);\n485:   }\n486:   // A failing canary that names other files only is still a fact worth stating, because\n487:   // its exit status would otherwise read as this row's verdict. A passing one needs no\n488:   // note: its remaining lines are its own anchor table.\n489:   const notes = failures.length === 0 && run.status !== 0 && elsewhere.length > 0\n490:     ? [`the canary exits ${run.status} over ${elsewhere.length} line(s) outside ${manifest.root_file}, which belong to other files' pins`]\n491:     : [];\n492: \n493:   return row('A6', 'delivery budget', failures.length === 0 ? PASS : FINDING,\n494:     `${prefixEnd} of ${limit} bytes to the last anchor, ${context.totalBytes} of ${ceiling} bytes total`,\n495:     { lines: [...failures, ...notes] });\n496: }\n497: \n498: // A7. The repository block: one start marker line, one end marker line, in that order,\n499: // after every shipped section, small enough to leave headroom. A marker is the whole line,\n500: // so the same bytes quoted inside a sentence are prose and do not make a second block.\n501: function rowBlock(context, manifest) {\n502:   const { budget } = manifest;\n503:   const block = context.block;\n504:   const starts = block === null ? 0 : block.markerLines.start.length;\n505:   const ends = block === null ? 0 : block.markerLines.end.length;\n506: \n507:   if (starts === 0 && ends === 0) {\n508:     return row('A7', 'repo-local block', PASS, `no block; ${context.totalBytes} of ${budget.max_bytes} bytes used`);\n509:   }\n510:   if (starts !== 1 || ends !== 1) {\n511:     const lines = ['the block cannot be placed, so nothing inside it can be carried'];\n512:     const where = [];\n513:     if (block !== null && starts > 0) where.push(`the start marker sits on line ${block.markerLines.start.join(' and line ')}`);\n514:     if (block !== null && ends > 0) where.push(`the end marker on line ${block.markerLines.end.join(' and line ')}`);\n515:     if (where.length > 0) lines.push(where.join(', '));\n516:     return row('A7', 'repo-local block', FINDING,\n517:       `expected one start and one end marker line, found ${starts} and ${ends}`, { lines });\n518:   }\n519: \n520:   const lines = [];\n521:   if (!block || !block.complete) {\n522:     lines.push('the end marker sits before the start marker, so the block is out of order and unreadable');\n523:   }\n524:   // Whatever the document carries below the block is content a replacement has to place\n525:   // around the block, so a block above it cannot be the one block a rewrite writes last.\n526:   const following = block === null ? [] : context.sections.filter((section) => section.start > block.start);\n527:   if (block && block.complete && following.length > 0) {\n528:     lines.push(`the block starts at byte ${block.start}, before ${following.length} section(s) that follow it (the first is ${JSON.stringify(following[0].heading)} at byte ${following[0].start})`);\n529:   }\n530:   if (block && block.complete && block.start < budget.prefix_bytes) {\n531:     lines.push(`the block starts at byte ${block.start}, inside the ${budget.prefix_bytes}-byte delivery prefix`);\n532:   }\n533:   if (context.totalBytes > budget.max_bytes) {\n534:     lines.push(`${context.totalBytes} bytes exceeds the ${budget.max_bytes}-byte ceiling`);\n535:   }\n536: \n537:   const size = block && block.complete ? Buffer.byteLength(block.content, 'utf8') : 0;\n538:   const headroom = budget.max_bytes - context.totalBytes;\n539:   const detail = block && block.complete\n540:     ? `block ${size} bytes, ${headroom} bytes of headroom`\n541:     : `block unreadable, ${headroom} bytes of headroom`;\n542:   return row('A7', 'repo-local block', lines.length === 0 ? PASS : FINDING, detail,\n543:     { lines, entries: [{ size, headroom, complete: Boolean(block && block.complete) }] });\n544: }\n545: \n546: // A8. Repository content outside the block that matches no shipped section. This is the\n547: // content a replacement would drop, so it is reported by line and byte range. The text\n548: // above the first heading has no heading to match, and arrives here with a null one.\n549: function rowUnmarked(context, manifest) {\n550:   const prefixBytes = manifest.budget.prefix_bytes;\n551:   const entries = context.unregistered.map((entry) => ({\n552:     heading: entry.heading,\n553:     line_start: lineNumberAt(context.text, entry.start),\n554:     line_end: lineNumberAt(context.text, Math.max(entry.start, entry.end - 1)),\n555:     byte_start: entry.start,\n556:     byte_end: entry.end,\n557:     in_prefix: entry.start < prefixBytes,\n558:   }));\n559:   if (entries.length === 0) return row('A8', 'unmarked repo-unique content', PASS, 'no section outside the block');\n560: \n561:   const headings = entries.filter((entry) => entry.heading !== null).length;\n562:   const detail = [];\n563:   if (headings > 0) detail.push(`${headings} section(s) outside the block match no shipped section`);\n564:   if (entries.length > headings) detail.push('the text above the first heading is repository content no section carries');\n565: \n566:   return row('A8', 'unmarked repo-unique content', FINDING,\n567:     detail.join('; '),\n568:     {\n569:       lines: entries.map((entry) => `${entry.heading === null ? 'text before the first heading' : JSON.stringify(entry.heading)}: lines ${entry.line_start}-${entry.line_end}, bytes ${entry.byte_start}-${entry.byte_end}${entry.in_prefix ? ', inside the delivery prefix' : ''}`),\n570:       entries,\n571:     });\n572: }\n573: \n574: // The line where two bodies first part company, with the two raw lines. A body can carry\n575: // every line the shipped body carries and still not be it — an extra space on an indent, a\n576: // line written twice, two lines swapped — and the operator needs the line to look at\n577: // rather than a finding with nothing under it.\n578: function bodyDifference(actual, expected) {\n579:   const left = String(actual).split('\\n');\n580:   const right = String(expected).split('\\n');\n581:   const last = Math.max(left.length, right.length);\n582:   for (let index = 0; index < last; index += 1) {\n583:     if (left[index] === right[index]) continue;\n584:     return {\n585:       line: index + 1,\n586:       actual: left[index] === undefined ? null : left[index],\n587:       shipped: right[index] === undefined ? null : right[index],\n588:     };\n589:   }\n590:   return null;\n591: }\n592: \n593: // A9. For a section that is not the shipped body, the lines the shipped body does not\n594: // carry, once per occurrence. A body that carries every shipped line can still differ, so\n595: // the row names that difference by line instead of reporting a finding with no line under\n596: // it: a finding nobody can act on reads like a bug in the checker.\n597: function rowUnmarkedEdits(context, manifest) {\n598:   const entries = [];\n599:   for (const entry of context.currency) {\n600:     if (entry.state !== 'edited' && entry.state !== 'unknown-base') continue;\n601:     const shipped = manifest.derived.sections[entry.id];\n602:     const body = shipped ? shipped.body : '';\n603:     const lines = localLinesOf(entry.section.body, body);\n604:     entries.push({\n605:       id: entry.id,\n606:       state: entry.state,\n607:       lines,\n608:       difference: lines.length === 0 ? bodyDifference(entry.section.body, body) : null,\n609:     });\n610:   }\n611:   if (entries.length === 0) return row('A9', 'unmarked local edits', PASS, 'no edited section');\n612: \n613:   const total = entries.reduce((sum, entry) => sum + entry.lines.length, 0);\n614:   const formatting = entries.filter((entry) => entry.lines.length === 0).length;\n615:   const detail = [`${entries.length} section(s) carry ${total} local line(s)`];\n616:   if (formatting > 0) detail.push(`${formatting} of them differ only in whitespace, order or a repeat`);\n617: \n618:   const lines = [];\n619:   for (const entry of entries) {\n620:     for (const line of entry.lines) lines.push(`${entry.id}: ${line}`);\n621:     if (entry.difference === null) continue;\n622:     lines.push(`${entry.id}: only whitespace, order or a repeat differs from the shipped body, at line ${entry.difference.line}: shipped ${JSON.stringify(entry.difference.shipped)}, the document carries ${JSON.stringify(entry.difference.actual)}`);\n623:   }\n624:   return row('A9', 'unmarked local edits', lines.length === 0 ? INFO : FINDING,\n625:     detail.join('; '), { lines, entries });\n626: }\n627: \n628: // A10. The copies each runtime loads. Claude Code reaches the root document only through\n629: // CLAUDE.md, so a missing pointer leaves Claude without it and a full copy double-loads\n630: // and drifts. The Cursor rule is generated and alone carries the gate 1 lookup to Cursor\n631: // and Devin, so it is checked by its own generator.\n632: function rowRuntimeCopies(context, manifest, tools) {\n633:   const entries = [];\n634:   const lines = [];\n635: \n636:   for (const expected of manifest.runtime_copies || []) {\n637:     const verdict = copyVerdict(expected, context, manifest, tools);\n638:     entries.push({ path: expected.path, kind: verdict.kind, state: verdict.state, lines: verdict.lines || [] });\n639:     // A copy nobody could measure is printed like a finding: a pass line with no detail\n640:     // reads as a copy that was checked and found right.\n641:     if (verdict.state === FINDING || verdict.state === UNKNOWN || verdict.kind === 'pointer missing') {\n642:       lines.push(`${expected.path}: ${verdict.kind} - ${verdict.detail}`);\n643:     }\n644:   }\n645: \n646:   const failed = entries.filter((entry) => entry.state === FINDING);\n647:   const unmeasured = entries.filter((entry) => entry.state === UNKNOWN);\n648:   const state = failed.length > 0 ? FINDING : (unmeasured.length > 0 ? UNKNOWN : PASS);\n649:   const detail = `${entries.length - failed.length - unmeasured.length}/${entries.length} copies as expected${unmeasured.length > 0 ? `, ${unmeasured.length} unmeasured` : ''}`;\n650:   return row('A10', 'runtime copies', state, detail, { lines, entries });\n651: }\n652: \n653: function copyVerdict(expected, context, manifest, tools) {\n654:   if (expected.report_only) {\n655:     return { state: INFO, kind: 'reported only', detail: 'outside the checklist this command rewrites' };\n656:   }\n657:   if (expected.path.startsWith('~')) {\n658:     return { state: INFO, kind: 'outside the repository', detail: 'reported, never read' };\n659:   }\n660: \n661:   const target = path.join(context.root, expected.path);\n662:   if (expected.path.endsWith('.md') && expected.expect.includes('gate1-block-in-sync')) {\n663:     if (typeof tools.pointerSync !== 'string' || !fs.existsSync(tools.pointerSync)) {\n664:       return { state: UNKNOWN, kind: 'gate1 block unmeasured', detail: `the pointer sync is not installed at ${tools.pointerSync || '(no path)'}` };\n665:     }\n666:     const run = spawnSync(process.execPath, [tools.pointerSync, '--check', '--root', context.root], {\n667:       encoding: 'utf8',\n668:       timeout: TOOL_TIMEOUT_MS,\n669:     });\n670:     const output = `${run.stdout || ''}\\n${run.stderr || ''}`.split('\\n').map((line) => line.trim()).filter((line) => line !== '');\n671:     if (run.status === 0) return { state: PASS, kind: 'gate1 block in sync', detail: 'the generator reports no drift' };\n672:     if (run.status === 1) return { state: FINDING, kind: 'gate1 block out of sync', detail: output.join('; ') };\n673:     return { state: UNKNOWN, kind: 'gate1 block unmeasured', detail: output.join('; ') || `the pointer sync exited ${run.status}` };\n674:   }\n675: \n676:   const exists = fs.existsSync(target) || isSymlink(target);\n677:   const expectsAbsent = expected.expect.length === 1 && expected.expect[0] === 'absent';\n678: \n679:   if (expected.path === '.cursor/rules/repo-local.md') {\n680:     if (context.blockContent) {\n681:       if (!exists) return { state: FINDING, kind: 'mirror missing', detail: 'the block carries content and nothing mirrors it' };\n682:       const mirror = fs.readFileSync(target, 'utf8');\n683:       const missing = [...trimmedLines(context.block.content)].filter((line) => !mirror.includes(line));\n684:       return missing.length === 0\n685:         ? { state: PASS, kind: 'mirror current', detail: 'the mirror carries the block' }\n686:         : { state: FINDING, kind: 'mirror behind', detail: `${missing.length} block line(s) are not in the mirror` };\n687:     }\n688:     return exists\n689:       ? { state: FINDING, kind: 'mirror of an empty block', detail: 'the block is empty and a mirror exists' }\n690:       : { state: PASS, kind: 'absent', detail: 'no block content to mirror' };\n691:   }\n692: \n693:   // Claude Code reaches the root document only through this file, so its absence is a route\n694:   // the runtime does not have rather than a copy that is wrong.\n695:   if (expected.path === 'CLAUDE.md' && !exists && context.exists) {\n696:     return {\n697:       state: INFO,\n698:       kind: 'pointer missing',\n699:       detail: 'Claude Code reads only CLAUDE.md, so without a one-line @' + manifest.root_file + ' pointer it never loads ' + manifest.root_file,\n700:     };\n701:   }\n702: \n703:   if (!exists) {\n704:     return expectsAbsent\n705:       ? { state: PASS, kind: 'absent', detail: 'nothing to load twice' }\n706:       : { state: PASS, kind: 'absent', detail: 'absent, which the checklist allows' };\n707:   }\n708: \n709:   if (isSymlink(target)) {\n710:     const link = fs.readlinkSync(target);\n711:     const pointsAtRoot = path.basename(link) === manifest.root_file;\n712:     if (pointsAtRoot) return { state: PASS, kind: 'symlink', detail: `links to ${link}` };\n713:     return { state: FINDING, kind: 'symlink elsewhere', detail: `links to ${link} instead of ${manifest.root_file}` };\n714:   }\n715: \n716:   const content = fs.readFileSync(target, 'utf8');\n717:   if (!context.exists) {\n718:     return { state: FINDING, kind: 'sole instruction file', detail: `there is no ${manifest.root_file} for it to point at` };\n719:   }\n720:   if (content === context.text) {\n721:     return { state: FINDING, kind: 'identical copy', detail: `byte-identical to ${manifest.root_file}, so the two will drift` };\n722:   }\n723: \n724:   const unique = localLinesOf(content, context.text);\n725:   const rootLines = trimmedLines(context.text);\n726:   const sharesShippedLine = [...trimmedLines(content)].some((line) => rootLines.has(line));\n727:   const namesRoot = [...trimmedLines(content)].some((line) => line.includes(manifest.root_file));\n728:   // A pointer is a file that carries no shipped line and names the root document. Anything\n729:   // else is either a copy or a copy plus local lines, and both drift: the second also\n730:   // loses text when it is replaced, so the lines only it carries are listed.\n731:   if (!sharesShippedLine && namesRoot) {\n732:     return { state: PASS, kind: 'pointer', detail: `every line names ${manifest.root_file}` };\n733:   }\n734:   return { state: FINDING, kind: 'divergent copy', detail: `${unique.length} line(s) only this file carries`, lines: unique };\n735: }\n736: \n737: function isSymlink(target) {\n738:   try {\n739:     return fs.lstatSync(target).isSymbolicLink();\n740:   } catch {\n741:     return false;\n742:   }\n743: }\n744: \n745: // A11. The router: present, carrying the rows the template ships, and passing its own\n746: // checker. The checker's summary line is carried through, never rebuilt.\n747: function rowRouter(context, manifest, tools) {\n748:   const routerPath = path.join(context.root, manifest.router_file);\n749:   if (!fs.existsSync(routerPath)) {\n750:     return row('A11', 'REPO RULES.md', FINDING, 'absent',\n751:       { lines: [`no ${manifest.router_file}: no repository rule can load`], entries: [{ path: manifest.router_file, present: false }] });\n752:   }\n753: \n754:   const text = fs.readFileSync(routerPath, 'utf8');\n755:   const shipped = (manifest.derived && manifest.derived.repo_rules) || { trigger_rows: [], index_rows: [] };\n756:   const lines = [];\n757:   const missing = [\n758:     ...missingRows(shipped.trigger_rows, parseTableRows(text, 'TRIGGER TABLE'), 'trigger'),\n759:     ...missingRows(shipped.index_rows, parseTableRows(text, 'INDEX'), 'index'),\n760:   ];\n761:   for (const entry of missing) lines.push(`missing ${entry.kind} row for ${entry.rule}`);\n762: \n763:   if (typeof tools.repoRules !== 'string' || !fs.existsSync(tools.repoRules)) {\n764:     return row('A11', 'REPO RULES.md', UNKNOWN, 'present; the repo-rules checker is not installed',\n765:       { lines: [...lines, `the checker is not installed at ${tools.repoRules || '(no path)'}`] });\n766:   }\n767: \n768:   const run = spawnSync(process.execPath, [tools.repoRules, '--root', context.root], {\n769:     encoding: 'utf8',\n770:     timeout: TOOL_TIMEOUT_MS,\n771:   });\n772:   const output = `${run.stdout || ''}\\n${run.stderr || ''}`.split('\\n').map((line) => line.trim()).filter((line) => line !== '');\n773:   const summary = output.find((line) => line.includes(REPO_RULES_TAG) && line.includes('RESULT:'));\n774: \n775:   if (run.status === 2 || !summary) {\n776:     return row('A11', 'REPO RULES.md', UNKNOWN, 'the repo-rules checker could not run',\n777:       { lines: [...lines, ...output.filter((line) => line.includes(REPO_RULES_TAG))] });\n778:   }\n779:   if (run.status !== 0) {\n780:     return row('A11', 'REPO RULES.md', FINDING, `${missing.length} shipped row(s) missing; the checker fails`,\n781:       { lines: [...lines, summary] });\n782:   }\n783:   return row('A11', 'REPO RULES.md', lines.length === 0 ? PASS : FINDING,\n784:     `${missing.length} shipped row(s) missing; ${summary}`, { lines: [...lines, summary] });\n785: }\n786: \n787: // The router's own table, read the same way the manifest's rows were derived. Comparing\n788: // shipped rows to the file is the only way to say which of them a consumer dropped.\n789: function parseTableRows(text, anchor) {\n790:   const lines = text.split('\\n');\n791:   const start = lines.findIndex((line) => line.startsWith('#') && line.includes(anchor));\n792:   if (start === -1) return [];\n793: \n794:   const rows = [];\n795:   let width = 0;\n796:   for (let index = start + 1; index < lines.length; index += 1) {\n797:     const line = lines[index].trim();\n798:     if (line.startsWith('#')) break;\n799:     if (!line.startsWith('|')) {\n800:       if (rows.length > 0 && line === '') break;\n801:       continue;\n802:     }\n803:     const cells = line.replace(/^\\|/u, '').replace(/\\|$/u, '').split('|').map((cell) => cell.trim());\n804:     if (cells.every((cell) => /^:?-+:?$/u.test(cell) || cell === '')) continue;\n805:     if (width === 0) {\n806:       width = cells.length;\n807:       continue;\n808:     }\n809:     if (cells.length !== width) continue;\n810:     rows.push(cells);\n811:   }\n812:   return rows;\n813: }\n814: \n815: function rulePathOf(cells) {\n816:   for (const cell of cells) {\n817:     const linked = /\\(([^)]+\\.md)\\)/u.exec(cell);\n818:     if (linked) return linked[1];\n819:     const bare = /`([^`]+\\.md)`/u.exec(cell);\n820:     if (bare) return bare[1];\n821:   }\n822:   return null;\n823: }\n824: \n825: function missingRows(shipped, present, kind) {\n826:   const found = new Set(present.map((cells) => rulePathOf(cells) || cells.join(' | ')));\n827:   const missing = [];\n828:   for (const cells of shipped) {\n829:     const rule = rulePathOf(cells) || cells.join(' | ');\n830:     if (!found.has(rule)) missing.push({ kind, rule });\n831:   }\n832:   return missing;\n833: }\n834: \n835: // A12. The source repository's own two promises: its block stays empty, and its derived\n836: // copy of the template is fresh. A consumer's block is its own, so this row reports INFO\n837: // there instead of telling it what to do with its own file.\n838: function rowTemplatePurity(context, manifest, tools, options) {\n839:   let source = { isSource: false, reason: `origin was not compared` };\n840:   try {\n841:     source = sourceStatus({ root: context.root, manifest });\n842:   } catch (error) {\n843:     source = { isSource: false, reason: error.message };\n844:   }\n845: \n846:   if (!options.source && !source.isSource) {\n847:     return row('A12', 'template purity', INFO,\n848:       `runs only in the source repository; ${source.reason || 'the origin differs'}`);\n849:   }\n850: \n851:   const lines = [];\n852:   if (context.blockContent) lines.push('the source repository block carries content, and every line here ships to every consumer');\n853:   if (context.block && !context.block.complete) lines.push('the source repository block is not well formed');\n854: \n855:   if (typeof tools.generator !== 'string' || !fs.existsSync(tools.generator)) {\n856:     return row('A12', 'template purity', UNKNOWN,\n857:       `the manifest generator is not installed at ${tools.generator || '(no path)'}`);\n858:   }\n859:   const run = spawnSync(process.execPath, [tools.generator, '--check', '--root', context.root, '--manifest', options.manifest], {\n860:     encoding: 'utf8',\n861:     timeout: TOOL_TIMEOUT_MS,\n862:   });\n863:   const output = `${run.stdout || ''}\\n${run.stderr || ''}`.split('\\n').map((line) => line.trim()).filter((line) => line !== '');\n864:   if (run.status !== 0) lines.push(...output);\n865: \n866:   const state = lines.length === 0 ? PASS : FINDING;\n867:   return row('A12', 'template purity', state,\n868:     state === PASS ? 'block empty and the derived copy is fresh' : 'the source template is not pure', { lines });\n869: }\n870: \n871: // ─────────────────────────────────────────────────────────────────────────────\n872: // 6. REPORT\n873: // ─────────────────────────────────────────────────────────────────────────────\n874: \n875: function defaultTools(manifest) {\n876:   const canaryPin = (manifest.pins || []).find((pin) => String(pin.consumer || '').endsWith('check-rule-copies.js'));\n877:   const pointerPin = (manifest.pins || []).find((pin) => pin.kind === 'first-occurrence');\n878:   return {\n879:     canary: canaryPin ? path.join(REPO_ROOT, canaryPin.consumer) : null,\n880:     pointerSync: pointerPin ? path.join(REPO_ROOT, pointerPin.consumer) : null,\n881:     repoRules: REPO_RULES_CHECKER,\n882:     generator: GENERATOR,\n883:   };\n884: }\n885: \n886: /**\n887:  * Classify one repository.\n888:  *\n889:  * @param {{root?: string, manifestPath?: string, source?: boolean, tools?: Object}} [input]\n890:  * @returns {{root: string, manifest: string, state: string, status: string, exitCode: number,\n891:  *   findings: number, unknown: number, rows: Array<Object>} | null} Null when the root\n892:  *   directory or the manifest is not readable.\n893:  */\n894: function buildReport(input = {}) {\n895:   const root = input.root ? path.resolve(input.root) : REPO_ROOT;\n896:   const manifestPath = input.manifestPath ? path.resolve(input.manifestPath) : MANIFEST_PATH;\n897:   if (!fs.existsSync(manifestPath)) return null;\n898: \n899:   let manifest;\n900:   try {\n901:     manifest = JSON.parse(fs.readFileSync(manifestPath, 'utf8'));\n902:   } catch {\n903:     return null;\n904:   }\n905: \n906:   const context = readTarget({ root, manifest });\n907:   if (context === null) return null;\n908: \n909:   const tools = { ...defaultTools(manifest), ...(input.tools || {}) };\n910:   const rows = [\n911:     rowInstallState(context, manifest),\n912:     rowSectionsPresent(context, manifest),\n913:     rowOrderAndNumbering(context, manifest),\n914:     rowCurrency(context),\n915:     rowPins(context, manifest),\n916:     rowBudget(context, manifest, tools),\n917:     rowBlock(context, manifest),\n918:     rowUnmarked(context, manifest),\n919:     rowUnmarkedEdits(context, manifest),\n920:     rowRuntimeCopies(context, manifest, tools),\n921:     rowRouter(context, manifest, tools),\n922:     rowTemplatePurity(context, manifest, tools, { source: Boolean(input.source), manifest: manifestPath }),\n923:   ];\n924: \n925:   const findings = rows.filter((entry) => entry.state === FINDING).length;\n926:   const unknown = rows.filter((entry) => entry.state === UNKNOWN).length;\n927:   const exitCode = findings > 0 || unknown > 0 ? 1 : 0;\n928:   const status = exitCode === 0 ? 'OK' : (findings > 0 ? 'FINDINGS' : 'UNKNOWN');\n929: \n930:   return {\n931:     root,\n932:     manifest: manifestPath,\n933:     state: rows[0].detail,\n934:     status,\n935:     exitCode,\n936:     findings,\n937:     unknown,\n938:     rows,\n939:   };\n940: }\n941: \n942: // A long row is a list, not a wall: the report keeps every line in the JSON form and\n943: // prints the first few here, so a reader sees the shape before the volume.\n944: const PRINTED_LINES = 20;\n945: \n946: function renderText(report) {\n947:   const lines = [];\n948:   for (const entry of report.rows) {\n949:     lines.push(`${entry.id} ${entry.name}: ${entry.detail}   (${entry.state})`);\n950:     for (const line of entry.lines.slice(0, PRINTED_LINES)) lines.push(`  ${line}`);\n951:     if (entry.lines.length > PRINTED_LINES) {\n952:       lines.push(`  ... ${entry.lines.length - PRINTED_LINES} more line(s), all of them in the JSON report`);\n953:     }\n954:   }\n955:   lines.push(`STATUS=${report.status} rows=${report.rows.length} findings=${report.findings} unknown=${report.unknown}`);\n956:   return `${lines.join('\\n')}\\n`;\n957: }\n958: \n959: function renderJson(report) {\n960:   const shaped = {\n961:     root: report.root,\n962:     manifest: report.manifest,\n963:     state: report.state,\n964:     status: report.status,\n965:     exit_code: report.exitCode,\n966:     findings: report.findings,\n967:     unknown: report.unknown,\n968:     rows: report.rows.map((entry) => ({\n969:       id: entry.id,\n970:       name: entry.name,\n971:       state: entry.state,\n972:       detail: entry.detail,\n973:       lines: entry.lines,\n974:       entries: entry.entries,\n975:     })),\n976:   };\n977:   return `${JSON.stringify(shaped, null, 2)}\\n`;\n978: }\n979: \n980: // ─────────────────────────────────────────────────────────────────────────────\n981: // 7. MAIN\n982: // ─────────────────────────────────────────────────────────────────────────────\n983: \n984: /**\n985:  * @param {string[]} argv\n986:  * @param {{tools?: Object}} [hooks] - test seams for the child tools\n987:  * @returns {number} the process exit code\n988:  */\n989: function main(argv, hooks = {}) {\n990:   const options = parseArgs(argv);\n991:   if (options.help) {\n992:     console.log(USAGE);\n993:     return 0;\n994:   }\n995: \n996:   if (!fs.existsSync(options.manifest)) {\n997:     console.error(`${TAG} ERROR: the manifest is missing at ${options.manifest}`);\n998:     return 2;\n999:   }\n1000:   if (!fs.existsSync(options.root) || !fs.statSync(options.root).isDirectory()) {\n1001:     console.error(`${TAG} ERROR: the target root is not a directory: ${options.root}`);\n1002:     return 2;\n1003:   }\n1004:   // The root file's name is the manifest's to declare, so this precondition reads the same\n1005:   // declaration every other read does instead of a name of its own.\n1006:   let rootFile = null;\n1007:   try {\n1008:     rootFile = JSON.parse(fs.readFileSync(options.manifest, 'utf8')).root_file || null;\n1009:   } catch {\n1010:     // An unreadable manifest is refused below, where the run has no report to print.\n1011:     rootFile = null;\n1012:   }\n1013:   const rootPath = rootFile === null ? null : path.join(options.root, rootFile);\n1014:   if (rootPath !== null && fs.existsSync(rootPath)) {\n1015:     try {\n1016:       fs.readFileSync(rootPath, 'utf8');\n1017:     } catch (error) {\n1018:       console.error(`${TAG} ERROR: cannot read ${rootPath}: ${error.message}`);\n1019:       return 2;\n1020:     }\n1021:   }\n1022: \n1023:   const report = buildReport({\n1024:     root: options.root,\n1025:     manifestPath: options.manifest,\n1026:     source: options.source,\n1027:     tools: hooks.tools || {},\n1028:   });\n1029:   if (report === null) {\n1030:     // A manifest that cannot be parsed leaves nothing to compare against, and an empty\n1031:     // report would read like a clean one.\n1032:     console.error(`${TAG} ERROR: cannot classify ${options.root}: the manifest at ${options.manifest} could not be read as JSON`);\n1033:     return 2;\n1034:   }\n1035: \n1036:   process.stdout.write(options.json ? renderJson(report) : renderText(report));\n1037:   return report.exitCode;\n1038: }\n1039: \n1040: if (require.main === module) {\n1041:   try {\n1042:     process.exitCode = main(process.argv.slice(2));\n1043:   } catch (error) {\n1044:     console.error(`${TAG} ERROR: ${error.message}`);\n1045:     if (error instanceof UsageError) console.error(USAGE);\n1046:     process.exitCode = 2;\n1047:   }\n1048: }\n1049: \n1050: module.exports = {\n1051:   MANIFEST_PATH,\n1052:   buildReport,\n1053:   main,\n1054:   renderJson,\n1055:   renderText,\n1056: };","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file .skilled/commands/doctor/scripts/agents-md-check.cjs, lines 1-1056\n1: #!/usr/bin/env node\n2: // ───────────────────────────────────────────────────────────────────\n3: // MODULE: Shipped Instruction Check Engine\n4: // ───────────────────────────────────────────────────────────────────\n5: 'use strict';\n6: \n7: // A repository that took the shipped instruction template can be in any of seven\n8: // states, and nothing in it says which one. Its shipped sections may be current, one\n9: // release behind, or edited in place; its own content may sit in the marked block or be\n10: // scattered between shipped sections; it may have no root document at all. Without that\n11: // answer there is nothing to plan a rewrite from, and no way to tell a safe replacement\n12: // from one that would drop a line somebody wrote. So this engine reports, per row and\n13: // without writing a byte, what the repository holds against the manifest.\n14: //\n15: // Three of the twelve rows are answers this engine must not invent. The delivery budget\n16: // and its anchors belong to the rule-copy canary, the Cursor pointer block belongs to\n17: // the gate 1 sync, and the router belongs to the repo-rules checker. Each already has\n18: // tests and an owner, so each is run as a child process and its own lines are carried\n19: // into the report; re-deriving any of them here would be a second opinion that drifts\n20: // from the first. The rest are pure classifiers over one read of the target tree.\n21: //\n22: // The run is read-only by construction: the only paths it opens for reading are under\n23: // the target root plus the manifest, and the three child tools it runs are read-only\n24: // modes. A repository that cannot be classified at all (no manifest, no target\n25: // directory, an unreadable root document) is a failed precondition and exits 2, because\n26: // an empty report would read like a clean one.\n27: //\n28: // Usage: agents-md-check.cjs [--root <dir>] [--manifest <path>] [--source] [--json]\n29: //   --root <dir>      classify this repository instead of the one this script ships in\n30: //   --manifest <path> read this manifest instead of the shipped one\n31: //   --source          run the template-purity row even outside the source repository\n32: //   --json            print one JSON object instead of the text report\n33: // Exit codes: 0 nothing to report, 1 at least one finding or an unproven row,\n34: //             2 a precondition failed\n35: \n36: // ─────────────────────────────────────────────────────────────────────────────\n37: // 1. IMPORTS\n38: // ─────────────────────────────────────────────────────────────────────────────\n39: \n40: const { spawnSync } = require('node:child_process');\n41: const fs = require('node:fs');\n42: const path = require('node:path');\n43: \n44: const {\n45:   classifyBody,\n46:   deliveryAnchorEnd,\n47:   matchSections,\n48:   segment,\n49: } = require('./lib/agents-md-sections.cjs');\n50: const { sourceStatus } = require('./agents-md-manifest.cjs');\n51: \n52: // ─────────────────────────────────────────────────────────────────────────────\n53: // 2. CONSTANTS\n54: // ─────────────────────────────────────────────────────────────────────────────\n55: \n56: const TAG = '[agents-md-check]';\n57: const REPO_ROOT = path.resolve(__dirname, '../../../..');\n58: const MANIFEST_PATH = path.resolve(__dirname, '../assets/agents-md-manifest.json');\n59: const GENERATOR = path.resolve(__dirname, 'agents-md-manifest.cjs');\n60: // The router checker ships beside the skill that authors rules, and the manifest links\n61: // it only through the router's own row, so its path is named here once.\n62: const REPO_RULES_CHECKER = path.resolve(\n63:   REPO_ROOT,\n64:   '.skilled/skills/sk-doc/sk-create-repo-rule/scripts/check-repo-rules.cjs',\n65: );\n66: // The checker's own tag prefix. Matching on it is what keeps this row a carrier of that\n67: // tool's verdict instead of a second implementation of its checks.\n68: const REPO_RULES_TAG = '[repo-rules-check]';\n69: const USAGE = 'Usage: node .skilled/commands/doctor/scripts/agents-md-check.cjs [--root <dir>] [--manifest <path>] [--source] [--json]';\n70: const TOOL_TIMEOUT_MS = 120000;\n71: \n72: // A repository where fewer than half the shipped sections survive is carrying its own\n73: // document, not a copy of the template. Above the line the question becomes which parts\n74: // of the template are still there, which is a per-section answer.\n75: const FOREIGN_SHARE = 0.5;\n76: \n77: const PASS = 'PASS';\n78: const FINDING = 'FINDING';\n79: const UNKNOWN = 'UNKNOWN';\n80: const INFO = 'INFO';\n81: \n82: class UsageError extends Error {}\n83: \n84: // ─────────────────────────────────────────────────────────────────────────────\n85: // 3. ARGUMENTS\n86: // ─────────────────────────────────────────────────────────────────────────────\n87: \n88: function parseArgs(argv) {\n89:   const options = { root: REPO_ROOT, manifest: MANIFEST_PATH, source: false, json: false, help: false };\n90:   for (let index = 0; index < argv.length; index += 1) {\n91:     const argument = argv[index];\n92:     if (argument === '--root') {\n93:       const value = argv[index + 1];\n94:       if (!value || value.startsWith('--')) throw new UsageError('--root needs a directory');\n95:       options.root = path.resolve(value);\n96:       index += 1;\n97:     } else if (argument === '--manifest') {\n98:       const value = argv[index + 1];\n99:       if (!value || value.startsWith('--')) throw new UsageError('--manifest needs a file path');\n100:       options.manifest = path.resolve(value);\n101:       index += 1;\n102:     } else if (argument === '--source') {\n103:       options.source = true;\n104:     } else if (argument === '--json') {\n105:       options.json = true;\n106:     } else if (argument === '--help' || argument === '-h') {\n107:       options.help = true;\n108:     } else {\n109:       throw new UsageError(`unknown argument: ${argument}`);\n110:     }\n111:   }\n112:   return options;\n113: }\n114: \n115: // ─────────────────────────────────────────────────────────────────────────────\n116: // 4. READING THE TARGET ONCE\n117: // ─────────────────────────────────────────────────────────────────────────────\n118: \n119: // Section offsets are byte offsets because the delivery budget is a byte count, while a\n120: // reader opens the file by line number. One conversion, in one place.\n121: function lineNumberAt(text, byteOffset) {\n122:   return Buffer.from(text, 'utf8').subarray(0, byteOffset).toString('utf8').split('\\n').length;\n123: }\n124: \n125: function trimmedLines(text) {\n126:   const lines = new Set();\n127:   for (const raw of String(text).split('\\n')) {\n128:     const line = raw.trim();\n129:     if (line !== '' && line !== '---') lines.add(line);\n130:   }\n131:   return lines;\n132: }\n133: \n134: // The repository's own lines, in order and with repeats. A set would report one line for\n135: // two occurrences, and a replacement loses both, so a duplicate is a second line to keep.\n136: function localLinesOf(body, reference) {\n137:   const known = trimmedLines(reference);\n138:   const local = [];\n139:   for (const raw of body.split('\\n')) {\n140:     const line = raw.trim();\n141:     if (line === '' || line === '---' || known.has(line)) continue;\n142:     local.push(line);\n143:   }\n144:   return local;\n145: }\n146: \n147: function knownBodies(manifest) {\n148:   const sections = manifest.derived && manifest.derived.sections ? manifest.derived.sections : {};\n149:   return {\n150:     current: Object.keys(sections).map((id) => ({ id, sha256: sections[id].sha256, body: sections[id].body })),\n151:     history: (manifest.derived && manifest.derived.history) || [],\n152:   };\n153: }\n154: \n155: // The block carries a heading and a note that the template itself ships, so \"the block is\n156: // empty\" means nothing beyond those two lines, not that the markers bracket no text.\n157: function blockHasContent(block, markers) {\n158:   if (!block || !block.complete) return false;\n159:   const shipped = new Set([markers.heading.trim(), markers.note.trim()]);\n160:   for (const raw of block.content.split('\\n')) {\n161:     const line = raw.trim();\n162:     if (line === '' || shipped.has(line)) continue;\n163:     return true;\n164:   }\n165:   return false;\n166: }\n167: \n168: /**\n169:  * Read the target tree once and keep what every row needs.\n170:  *\n171:  * @param {{root: string, manifest: Object}} input\n172:  * @returns {Object|null} Null when the root directory is not there.\n173:  */\n174: function readTarget({ root, manifest }) {\n175:   if (!fs.existsSync(root) || !fs.statSync(root).isDirectory()) return null;\n176: \n177:   const rootPath = path.join(root, manifest.root_file);\n178:   const exists = fs.existsSync(rootPath);\n179:   const text = exists ? fs.readFileSync(rootPath, 'utf8') : null;\n180:   const segmentation = exists\n181:     ? segment(text, manifest.markers, manifest.sections)\n182:     : { sections: [], block: null, prelude: null };\n183:   const pairing = matchSections(segmentation.sections, manifest.sections, segmentation.prelude);\n184: \n185:   return {\n186:     root,\n187:     rootPath,\n188:     exists,\n189:     text,\n190:     totalBytes: exists ? Buffer.byteLength(text, 'utf8') : 0,\n191:     block: segmentation.block,\n192:     prelude: segmentation.prelude,\n193:     sections: segmentation.sections,\n194:     matched: pairing.matched,\n195:     unregistered: pairing.unregistered,\n196:     unmatched: pairing.unmatched,\n197:     conflicts: pairing.conflicts,\n198:     currency: pairing.matched.map((row) => ({\n199:       id: row.entry.id,\n200:       section: row.section,\n201:       ...classifyBody(row.section.body, knownBodies(manifest)),\n202:     })),\n203:     blockContent: blockHasContent(segmentation.block, manifest.markers),\n204:   };\n205: }\n206: \n207: // ─────────────────────────────────────────────────────────────────────────────\n208: // 5. THE TWELVE ROWS\n209: // ─────────────────────────────────────────────────────────────────────────────\n210: \n211: function row(id, name, state, detail, extra = {}) {\n212:   return { id, name, state, detail, lines: extra.lines || [], entries: extra.entries || [] };\n213: }\n214: \n215: // A1. The one row an operator reads first: which of the seven shapes this repository is.\n216: function rowInstallState(context, manifest) {\n217:   const claudePath = path.join(context.root, 'CLAUDE.md');\n218:   if (!context.exists) {\n219:     if (fs.existsSync(claudePath)) {\n220:       return row('A1', 'install state', FINDING, 'claude-only',\n221:         { lines: [`no ${manifest.root_file}; CLAUDE.md is the only instruction file`] });\n222:     }\n223:     return row('A1', 'install state', FINDING, 'absent',\n224:       { lines: [`no ${manifest.root_file} and no CLAUDE.md`] });\n225:   }\n226: \n227:   const share = manifest.sections.length === 0 ? 0 : context.matched.length / manifest.sections.length;\n228:   if (share < FOREIGN_SHARE) {\n229:     return row('A1', 'install state', FINDING, 'foreign', {\n230:       lines: [\n231:         `${context.matched.length} of ${manifest.sections.length} shipped sections match, under the ${Math.round(FOREIGN_SHARE * 100)}% floor`,\n232:         'the root document is the repository\\'s own file',\n233:       ],\n234:     });\n235:   }\n236: \n237:   const localEdits = context.currency.filter((entry) => entry.state === 'edited' || entry.state === 'unknown-base');\n238:   const behind = context.currency.filter((entry) => entry.state === 'stale-known');\n239:   // A local edit outranks a missed release in the reading order: it is the shape that\n240:   // loses text if somebody replaces the document, and staleness only loses a patch.\n241:   if (localEdits.length > 0 || context.unregistered.length > 0) {\n242:     const lines = [];\n243:     for (const entry of localEdits) lines.push(`${entry.id}: ${entry.state}`);\n244:     for (const entry of context.unregistered) {\n245:       lines.push(entry.heading === null\n246:         ? 'unmarked text before the first heading'\n247:         : `unmarked section ${JSON.stringify(entry.heading)}`);\n248:     }\n249:     return row('A1', 'install state', FINDING, 'forked', { lines });\n250:   }\n251:   if (behind.length > 0) {\n252:     return row('A1', 'install state', FINDING, 'stale',\n253:       { lines: behind.map((entry) => `${entry.id}: ${entry.state}`) });\n254:   }\n255:   if (context.blockContent) {\n256:     return row('A1', 'install state', PASS, 'adopted',\n257:       { lines: ['every shipped section is current and the repository block carries content'] });\n258:   }\n259:   return row('A1', 'install state', PASS, 'pure',\n260:     { lines: ['every shipped section is current and the repository block is empty'] });\n261: }\n262: \n263: // A2. Which shipped sections survived, by the prefix each authored entry carries.\n264: function rowSectionsPresent(context, manifest) {\n265:   const present = new Set(context.matched.map((row_) => row_.entry.id));\n266:   const missing = manifest.sections.map((entry) => entry.id).filter((id) => !present.has(id));\n267:   const detail = `${present.size}/${manifest.sections.length} matched`;\n268:   if (missing.length === 0 && context.conflicts.length === 0) {\n269:     return row('A2', 'sections present', PASS, detail);\n270:   }\n271:   const lines = missing.map((id) => `missing section ${id}`);\n272:   for (const conflict of context.conflicts) lines.push(conflict.message);\n273:   return row('A2', 'sections present', FINDING, `${present.size}/${manifest.sections.length} matched, ${missing.length} missing`, {\n274:     lines,\n275:     entries: missing.map((id) => ({ id, present: false })),\n276:   });\n277: }\n278: \n279: // The byte offset of the first line that is exactly this text, or -1 when the document\n280: // does not carry it.\n281: function firstLineOffset(text, needle) {\n282:   if (text.startsWith(needle)) return 0;\n283:   const at = text.indexOf(`\\n${needle}`);\n284:   return at === -1 ? -1 : at + 1;\n285: }\n286: \n287: // The shipped numbering, read from the pin that names it. Hundreds of files cite these\n288: // numbers, and the document carries its fourth section before its third, so the citation\n289: // order is not the reading order and only the pin carries the expected one.\n290: function numberingReport(context, manifest) {\n291:   if (!context.exists) return { state: INFO, detail: 'no root document to number', lines: [] };\n292: \n293:   const pin = (manifest.pins || []).find((entry) => entry.kind === 'order');\n294:   if (!pin) return { state: INFO, detail: 'the manifest declares no numbering pin', lines: [] };\n295: \n296:   const found = [];\n297:   const absent = [];\n298:   for (const text of pin.texts) {\n299:     const at = firstLineOffset(context.text, text);\n300:     if (at === -1) absent.push(text.trim());\n301:     else found.push({ text: text.trim(), at });\n302:   }\n303:   const expected = pin.texts.map((text) => text.trim()).filter((text) => found.some((entry) => entry.text === text));\n304:   const actual = found.slice().sort((left, right) => left.at - right.at).map((entry) => entry.text);\n305: \n306:   const lines = absent.map((text) => `missing section number ${JSON.stringify(text)}`);\n307:   if (expected.join('|') !== actual.join('|')) {\n308:     lines.push(`the numbers appear as ${actual.join(', ')} instead of ${expected.join(', ')}`);\n309:   }\n310:   return { state: lines.length === 0 ? PASS : FINDING, detail: `${found.length}/${pin.texts.length} section numbers in place`, lines };\n311: }\n312: \n313: // A3. Shipped sections in manifest order, and section numbers unchanged.\n314: function rowOrderAndNumbering(context, manifest) {\n315:   const order = manifest.sections.map((entry) => entry.id);\n316:   const seen = context.matched.map((entry) => entry.entry.id);\n317:   const expected = order.filter((id) => seen.includes(id));\n318:   const numbering = numberingReport(context, manifest);\n319: \n320:   const lines = [...numbering.lines];\n321:   if (expected.join('|') !== seen.join('|')) {\n322:     const first = seen.findIndex((id, index) => id !== expected[index]);\n323:     lines.unshift(`section order differs at position ${first + 1}: found ${seen[first]}, expected ${expected[first]}`);\n324:   }\n325:   const state = lines.length === 0 ? PASS : FINDING;\n326:   return row('A3', 'order and numbering', state, state === PASS ? 'manifest order and section numbers unchanged' : 'order or numbering drifted', { lines });\n327: }\n328: \n329: // A4. Per section, whether the body is the shipped one, an older release, a local edit\n330: // or something with no base to name.\n331: function rowCurrency(context) {\n332:   const counts = { current: 0, 'stale-known': 0, edited: 0, 'unknown-base': 0 };\n333:   const entries = [];\n334:   for (const entry of context.currency) {\n335:     counts[entry.state] += 1;\n336:     entries.push({ id: entry.id, state: entry.state, base: entry.base || null });\n337:   }\n338:   // Nothing to classify is not a clean bill: the rows around this one report the empty or\n339:   // foreign document, and a pass here would read as currency that was checked.\n340:   if (entries.length === 0) {\n341:     return row('A4', 'section currency', INFO, 'no shipped section matched, so there is no body to classify');\n342:   }\n343:   const detail = `${counts.current} current, ${counts['stale-known']} stale-known, ${counts.edited} edited, ${counts['unknown-base']} unknown-base`;\n344:   const lines = [];\n345:   for (const entry of context.currency) {\n346:     if (entry.state === 'current') continue;\n347:     const base = entry.base ? entry.base.slice(0, 12) : 'none';\n348:     lines.push(`${entry.id}: ${entry.state} (closest known body ${base})`);\n349:   }\n350:   return row('A4', 'section currency', lines.length === 0 ? PASS : FINDING, detail, { lines, entries });\n351: }\n352: \n353: // A5. Every string downstream tooling greps out of the document, checked by its rule.\n354: function rowPins(context, manifest) {\n355:   const entries = [];\n356:   const byId = new Map(context.matched.map((entry) => [entry.entry.id, entry.section]));\n357: \n358:   for (const pin of manifest.pins || []) {\n359:     const verdict = pinVerdict(pin, context, manifest, byId);\n360:     entries.push({ id: pin.id, kind: pin.kind, state: verdict.state, detail: verdict.detail });\n361:   }\n362: \n363:   const failed = entries.filter((entry) => entry.state === FINDING);\n364:   const unmeasured = entries.filter((entry) => entry.state === UNKNOWN);\n365:   const lines = failed.map((entry) => `${entry.id} (${entry.kind}): ${entry.detail}`);\n366:   for (const entry of unmeasured) lines.push(`${entry.id} (${entry.kind}): ${entry.detail}`);\n367:   const state = failed.length > 0 ? FINDING : (unmeasured.length > 0 ? UNKNOWN : PASS);\n368:   const detail = `${entries.length - failed.length - unmeasured.length}/${entries.length} pins hold${unmeasured.length > 0 ? `, ${unmeasured.length} unmeasured` : ''}`;\n369:   return row('A5', 'pins', state, detail, { lines, entries });\n370: }\n371: \n372: function pinVerdict(pin, context, manifest, byId) {\n373:   const section = pin.section ? byId.get(pin.section) : null;\n374:   if (pin.section && !section) {\n375:     return { state: FINDING, detail: `the section ${pin.section} that carries this pin is missing` };\n376:   }\n377: \n378:   switch (pin.kind) {\n379:     case 'exact': {\n380:       const missing = pin.texts.filter((text) => !section.body.includes(text));\n381:       return missing.length === 0\n382:         ? { state: PASS, detail: `all ${pin.texts.length} strings present in ${pin.section}` }\n383:         : { state: FINDING, detail: `missing ${JSON.stringify(missing[0])} in ${pin.section}` };\n384:     }\n385:     case 'line': {\n386:       const required = (pin.requires || pin.texts).map((text) => text.toLowerCase());\n387:       const hit = section.body.split('\\n').some((line) => {\n388:         const lower = line.toLowerCase();\n389:         return required.every((text) => lower.includes(text));\n390:       });\n391:       return hit\n392:         ? { state: PASS, detail: `a line in ${pin.section} carries ${required.join(', ')}` }\n393:         : { state: FINDING, detail: `no line in ${pin.section} carries ${required.join(', ')}` };\n394:     }\n395:     case 'first-occurrence': {\n396:       const at = context.text.indexOf(pin.texts[0]);\n397:       const inside = at >= section.start && at < section.end;\n398:       if (inside) return { state: PASS, detail: `the first occurrence sits inside ${pin.section}` };\n399:       return {\n400:         state: FINDING,\n401:         detail: at === -1\n402:           ? `the text ${JSON.stringify(pin.texts[0])} is absent`\n403:           : `the first occurrence at byte ${at} sits outside ${pin.section} (${section.start}..${section.end}), so anything reading the first line of the document follows it instead`,\n404:       };\n405:     }\n406:     case 'delivery-anchor': {\n407:       const end = deliveryAnchorEnd(section, pin);\n408:       if (end === null) return { state: FINDING, detail: `the anchor text is absent from ${pin.section}` };\n409:       const limit = manifest.budget.prefix_bytes;\n410:       return end <= limit\n411:         ? { state: PASS, detail: `${pin.section} ends at byte ${end}, inside ${limit}` }\n412:         : { state: FINDING, detail: `${pin.section} ends at byte ${end}, past the ${limit}-byte delivery prefix` };\n413:     }\n414:     case 'budget': {\n415:       const declared = manifest.budget[pin.limit_key];\n416:       const pinned = Number(pin.texts[0]);\n417:       return declared === pinned\n418:         ? { state: PASS, detail: `${pin.limit_key} is ${declared}` }\n419:         : { state: FINDING, detail: `${pin.limit_key} reads ${declared}, the pin says ${pinned}` };\n420:     }\n421:     case 'order': {\n422:       const numbering = numberingReport(context, manifest);\n423:       return { state: numbering.state, detail: numbering.detail };\n424:     }\n425:     case 'file': {\n426:       const target = path.join(context.root, pin.path);\n427:       return fs.existsSync(target)\n428:         ? { state: PASS, detail: `${pin.path} exists` }\n429:         : { state: FINDING, detail: `${pin.path} is missing` };\n430:     }\n431:     default:\n432:       // A kind the engine has no rule for is a pin nobody measured. Counting it as a hold\n433:       // would report a manifest edit as verified.\n434:       return { state: UNKNOWN, detail: `no rule for a pin of kind ${pin.kind}` };\n435:   }\n436: }\n437: \n438: // A6. The delivery budget: the canary's own AGENTS.md lines, plus the two measurements\n439: // the report needs. Only this row's file is kept, because the canary also pins the skill\n440: // it ships in and a consumer legitimately has none of those.\n441: function rowBudget(context, manifest, tools) {\n442:   if (typeof tools.canary !== 'string' || !fs.existsSync(tools.canary)) {\n443:     return row('A6', 'delivery budget', UNKNOWN,\n444:       `the rule-copy canary is not installed at ${tools.canary || '(no path)'}; the budget cannot be measured`);\n445:   }\n446: \n447:   const run = spawnSync(process.execPath, [tools.canary, '--root', context.root], {\n448:     encoding: 'utf8',\n449:     timeout: TOOL_TIMEOUT_MS,\n450:     maxBuffer: 16 * 1024 * 1024,\n451:   });\n452:   const output = `${run.stdout || ''}\\n${run.stderr || ''}`.split('\\n').map((line) => line.trim()).filter((line) => line !== '');\n453:   if (run.error || (run.status !== 0 && run.status !== 1)) {\n454:     return row('A6', 'delivery budget', UNKNOWN,\n455:       `the rule-copy canary could not run: ${run.error ? run.error.message : `exit ${run.status}`}`);\n456:   }\n457: \n458:   // The canary prints its verdict, an anchor table and its findings. Only the findings\n459:   // that name this document belong to this row; its PASS and table lines are its own\n460:   // report, and the anchor end byte is measured below instead of parsed back out.\n461:   const own = output\n462:     .filter((line) => line.includes(manifest.root_file))\n463:     .filter((line) => /^(MISSING|BLOCKED):/u.test(line));\n464:   const elsewhere = output.filter((line) => !line.includes(manifest.root_file));\n465: \n466:   const limit = manifest.budget.prefix_bytes;\n467:   const ceiling = manifest.budget.max_bytes;\n468:   const prefixEnd = (manifest.pins || [])\n469:     .filter((pin) => pin.kind === 'delivery-anchor')\n470:     .reduce((max, pin) => {\n471:       const section = context.matched.find((entry) => entry.entry.id === pin.section);\n472:       if (!section) return max;\n473:       const end = deliveryAnchorEnd(section.section, pin);\n474:       return end === null ? max : Math.max(max, end);\n475:     }, 0);\n476: \n477:   const failures = [...own];\n478:   // The canary already names whatever it measured, so this row adds a figure only for a\n479:   // defect the canary did not report, instead of printing the same ceiling twice.\n480:   if (prefixEnd > limit && !own.some((line) => line.includes('delivery prefix'))) {\n481:     failures.push(`the last anchor ends at byte ${prefixEnd}, past the ${limit}-byte delivery prefix`);\n482:   }\n483:   if (context.totalBytes > ceiling && !own.some((line) => line.includes('ceiling'))) {\n484:     failures.push(`${context.totalBytes} bytes exceeds the ${ceiling}-byte ceiling`);\n485:   }\n486:   // A failing canary that names other files only is still a fact worth stating, because\n487:   // its exit status would otherwise read as this row's verdict. A passing one needs no\n488:   // note: its remaining lines are its own anchor table.\n489:   const notes = failures.length === 0 && run.status !== 0 && elsewhere.length > 0\n490:     ? [`the canary exits ${run.status} over ${elsewhere.length} line(s) outside ${manifest.root_file}, which belong to other files' pins`]\n491:     : [];\n492: \n493:   return row('A6', 'delivery budget', failures.length === 0 ? PASS : FINDING,\n494:     `${prefixEnd} of ${limit} bytes to the last anchor, ${context.totalBytes} of ${ceiling} bytes total`,\n495:     { lines: [...failures, ...notes] });\n496: }\n497: \n498: // A7. The repository block: one start marker line, one end marker line, in that order,\n499: // after every shipped section, small enough to leave headroom. A marker is the whole line,\n500: // so the same bytes quoted inside a sentence are prose and do not make a second block.\n501: function rowBlock(context, manifest) {\n502:   const { budget } = manifest;\n503:   const block = context.block;\n504:   const starts = block === null ? 0 : block.markerLines.start.length;\n505:   const ends = block === null ? 0 : block.markerLines.end.length;\n506: \n507:   if (starts === 0 && ends === 0) {\n508:     return row('A7', 'repo-local block', PASS, `no block; ${context.totalBytes} of ${budget.max_bytes} bytes used`);\n509:   }\n510:   if (starts !== 1 || ends !== 1) {\n511:     const lines = ['the block cannot be placed, so nothing inside it can be carried'];\n512:     const where = [];\n513:     if (block !== null && starts > 0) where.push(`the start marker sits on line ${block.markerLines.start.join(' and line ')}`);\n514:     if (block !== null && ends > 0) where.push(`the end marker on line ${block.markerLines.end.join(' and line ')}`);\n515:     if (where.length > 0) lines.push(where.join(', '));\n516:     return row('A7', 'repo-local block', FINDING,\n517:       `expected one start and one end marker line, found ${starts} and ${ends}`, { lines });\n518:   }\n519: \n520:   const lines = [];\n521:   if (!block || !block.complete) {\n522:     lines.push('the end marker sits before the start marker, so the block is out of order and unreadable');\n523:   }\n524:   // Whatever the document carries below the block is content a replacement has to place\n525:   // around the block, so a block above it cannot be the one block a rewrite writes last.\n526:   const following = block === null ? [] : context.sections.filter((section) => section.start > block.start);\n527:   if (block && block.complete && following.length > 0) {\n528:     lines.push(`the block starts at byte ${block.start}, before ${following.length} section(s) that follow it (the first is ${JSON.stringify(following[0].heading)} at byte ${following[0].start})`);\n529:   }\n530:   if (block && block.complete && block.start < budget.prefix_bytes) {\n531:     lines.push(`the block starts at byte ${block.start}, inside the ${budget.prefix_bytes}-byte delivery prefix`);\n532:   }\n533:   if (context.totalBytes > budget.max_bytes) {\n534:     lines.push(`${context.totalBytes} bytes exceeds the ${budget.max_bytes}-byte ceiling`);\n535:   }\n536: \n537:   const size = block && block.complete ? Buffer.byteLength(block.content, 'utf8') : 0;\n538:   const headroom = budget.max_bytes - context.totalBytes;\n539:   const detail = block && block.complete\n540:     ? `block ${size} bytes, ${headroom} bytes of headroom`\n541:     : `block unreadable, ${headroom} bytes of headroom`;\n542:   return row('A7', 'repo-local block', lines.length === 0 ? PASS : FINDING, detail,\n543:     { lines, entries: [{ size, headroom, complete: Boolean(block && block.complete) }] });\n544: }\n545: \n546: // A8. Repository content outside the block that matches no shipped section. This is the\n547: // content a replacement would drop, so it is reported by line and byte range. The text\n548: // above the first heading has no heading to match, and arrives here with a null one.\n549: function rowUnmarked(context, manifest) {\n550:   const prefixBytes = manifest.budget.prefix_bytes;\n551:   const entries = context.unregistered.map((entry) => ({\n552:     heading: entry.heading,\n553:     line_start: lineNumberAt(context.text, entry.start),\n554:     line_end: lineNumberAt(context.text, Math.max(entry.start, entry.end - 1)),\n555:     byte_start: entry.start,\n556:     byte_end: entry.end,\n557:     in_prefix: entry.start < prefixBytes,\n558:   }));\n559:   if (entries.length === 0) return row('A8', 'unmarked repo-unique content', PASS, 'no section outside the block');\n560: \n561:   const headings = entries.filter((entry) => entry.heading !== null).length;\n562:   const detail = [];\n563:   if (headings > 0) detail.push(`${headings} section(s) outside the block match no shipped section`);\n564:   if (entries.length > headings) detail.push('the text above the first heading is repository content no section carries');\n565: \n566:   return row('A8', 'unmarked repo-unique content', FINDING,\n567:     detail.join('; '),\n568:     {\n569:       lines: entries.map((entry) => `${entry.heading === null ? 'text before the first heading' : JSON.stringify(entry.heading)}: lines ${entry.line_start}-${entry.line_end}, bytes ${entry.byte_start}-${entry.byte_end}${entry.in_prefix ? ', inside the delivery prefix' : ''}`),\n570:       entries,\n571:     });\n572: }\n573: \n574: // The line where two bodies first part company, with the two raw lines. A body can carry\n575: // every line the shipped body carries and still not be it — an extra space on an indent, a\n576: // line written twice, two lines swapped — and the operator needs the line to look at\n577: // rather than a finding with nothing under it.\n578: function bodyDifference(actual, expected) {\n579:   const left = String(actual).split('\\n');\n580:   const right = String(expected).split('\\n');\n581:   const last = Math.max(left.length, right.length);\n582:   for (let index = 0; index < last; index += 1) {\n583:     if (left[index] === right[index]) continue;\n584:     return {\n585:       line: index + 1,\n586:       actual: left[index] === undefined ? null : left[index],\n587:       shipped: right[index] === undefined ? null : right[index],\n588:     };\n589:   }\n590:   return null;\n591: }\n592: \n593: // A9. For a section that is not the shipped body, the lines the shipped body does not\n594: // carry, once per occurrence. A body that carries every shipped line can still differ, so\n595: // the row names that difference by line instead of reporting a finding with no line under\n596: // it: a finding nobody can act on reads like a bug in the checker.\n597: function rowUnmarkedEdits(context, manifest) {\n598:   const entries = [];\n599:   for (const entry of context.currency) {\n600:     if (entry.state !== 'edited' && entry.state !== 'unknown-base') continue;\n601:     const shipped = manifest.derived.sections[entry.id];\n602:     const body = shipped ? shipped.body : '';\n603:     const lines = localLinesOf(entry.section.body, body);\n604:     entries.push({\n605:       id: entry.id,\n606:       state: entry.state,\n607:       lines,\n608:       difference: lines.length === 0 ? bodyDifference(entry.section.body, body) : null,\n609:     });\n610:   }\n611:   if (entries.length === 0) return row('A9', 'unmarked local edits', PASS, 'no edited section');\n612: \n613:   const total = entries.reduce((sum, entry) => sum + entry.lines.length, 0);\n614:   const formatting = entries.filter((entry) => entry.lines.length === 0).length;\n615:   const detail = [`${entries.length} section(s) carry ${total} local line(s)`];\n616:   if (formatting > 0) detail.push(`${formatting} of them differ only in whitespace, order or a repeat`);\n617: \n618:   const lines = [];\n619:   for (const entry of entries) {\n620:     for (const line of entry.lines) lines.push(`${entry.id}: ${line}`);\n621:     if (entry.difference === null) continue;\n622:     lines.push(`${entry.id}: only whitespace, order or a repeat differs from the shipped body, at line ${entry.difference.line}: shipped ${JSON.stringify(entry.difference.shipped)}, the document carries ${JSON.stringify(entry.difference.actual)}`);\n623:   }\n624:   return row('A9', 'unmarked local edits', lines.length === 0 ? INFO : FINDING,\n625:     detail.join('; '), { lines, entries });\n626: }\n627: \n628: // A10. The copies each runtime loads. Claude Code reaches the root document only through\n629: // CLAUDE.md, so a missing pointer leaves Claude without it and a full copy double-loads\n630: // and drifts. The Cursor rule is generated and alone carries the gate 1 lookup to Cursor\n631: // and Devin, so it is checked by its own generator.\n632: function rowRuntimeCopies(context, manifest, tools) {\n633:   const entries = [];\n634:   const lines = [];\n635: \n636:   for (const expected of manifest.runtime_copies || []) {\n637:     const verdict = copyVerdict(expected, context, manifest, tools);\n638:     entries.push({ path: expected.path, kind: verdict.kind, state: verdict.state, lines: verdict.lines || [] });\n639:     // A copy nobody could measure is printed like a finding: a pass line with no detail\n640:     // reads as a copy that was checked and found right.\n641:     if (verdict.state === FINDING || verdict.state === UNKNOWN || verdict.kind === 'pointer missing') {\n642:       lines.push(`${expected.path}: ${verdict.kind} - ${verdict.detail}`);\n643:     }\n644:   }\n645: \n646:   const failed = entries.filter((entry) => entry.state === FINDING);\n647:   const unmeasured = entries.filter((entry) => entry.state === UNKNOWN);\n648:   const state = failed.length > 0 ? FINDING : (unmeasured.length > 0 ? UNKNOWN : PASS);\n649:   const detail = `${entries.length - failed.length - unmeasured.length}/${entries.length} copies as expected${unmeasured.length > 0 ? `, ${unmeasured.length} unmeasured` : ''}`;\n650:   return row('A10', 'runtime copies', state, detail, { lines, entries });\n651: }\n652: \n653: function copyVerdict(expected, context, manifest, tools) {\n654:   if (expected.report_only) {\n655:     return { state: INFO, kind: 'reported only', detail: 'outside the checklist this command rewrites' };\n656:   }\n657:   if (expected.path.startsWith('~')) {\n658:     return { state: INFO, kind: 'outside the repository', detail: 'reported, never read' };\n659:   }\n660: \n661:   const target = path.join(context.root, expected.path);\n662:   if (expected.path.endsWith('.md') && expected.expect.includes('gate1-block-in-sync')) {\n663:     if (typeof tools.pointerSync !== 'string' || !fs.existsSync(tools.pointerSync)) {\n664:       return { state: UNKNOWN, kind: 'gate1 block unmeasured', detail: `the pointer sync is not installed at ${tools.pointerSync || '(no path)'}` };\n665:     }\n666:     const run = spawnSync(process.execPath, [tools.pointerSync, '--check', '--root', context.root], {\n667:       encoding: 'utf8',\n668:       timeout: TOOL_TIMEOUT_MS,\n669:     });\n670:     const output = `${run.stdout || ''}\\n${run.stderr || ''}`.split('\\n').map((line) => line.trim()).filter((line) => line !== '');\n671:     if (run.status === 0) return { state: PASS, kind: 'gate1 block in sync', detail: 'the generator reports no drift' };\n672:     if (run.status === 1) return { state: FINDING, kind: 'gate1 block out of sync', detail: output.join('; ') };\n673:     return { state: UNKNOWN, kind: 'gate1 block unmeasured', detail: output.join('; ') || `the pointer sync exited ${run.status}` };\n674:   }\n675: \n676:   const exists = fs.existsSync(target) || isSymlink(target);\n677:   const expectsAbsent = expected.expect.length === 1 && expected.expect[0] === 'absent';\n678: \n679:   if (expected.path === '.cursor/rules/repo-local.md') {\n680:     if (context.blockContent) {\n681:       if (!exists) return { state: FINDING, kind: 'mirror missing', detail: 'the block carries content and nothing mirrors it' };\n682:       const mirror = fs.readFileSync(target, 'utf8');\n683:       const missing = [...trimmedLines(context.block.content)].filter((line) => !mirror.includes(line));\n684:       return missing.length === 0\n685:         ? { state: PASS, kind: 'mirror current', detail: 'the mirror carries the block' }\n686:         : { state: FINDING, kind: 'mirror behind', detail: `${missing.length} block line(s) are not in the mirror` };\n687:     }\n688:     return exists\n689:       ? { state: FINDING, kind: 'mirror of an empty block', detail: 'the block is empty and a mirror exists' }\n690:       : { state: PASS, kind: 'absent', detail: 'no block content to mirror' };\n691:   }\n692: \n693:   // Claude Code reaches the root document only through this file, so its absence is a route\n694:   // the runtime does not have rather than a copy that is wrong.\n695:   if (expected.path === 'CLAUDE.md' && !exists && context.exists) {\n696:     return {\n697:       state: INFO,\n698:       kind: 'pointer missing',\n699:       detail: 'Claude Code reads only CLAUDE.md, so without a one-line @' + manifest.root_file + ' pointer it never loads ' + manifest.root_file,\n700:     };\n701:   }\n702: \n703:   if (!exists) {\n704:     return expectsAbsent\n705:       ? { state: PASS, kind: 'absent', detail: 'nothing to load twice' }\n706:       : { state: PASS, kind: 'absent', detail: 'absent, which the checklist allows' };\n707:   }\n708: \n709:   if (isSymlink(target)) {\n710:     const link = fs.readlinkSync(target);\n711:     const pointsAtRoot = path.basename(link) === manifest.root_file;\n712:     if (pointsAtRoot) return { state: PASS, kind: 'symlink', detail: `links to ${link}` };\n713:     return { state: FINDING, kind: 'symlink elsewhere', detail: `links to ${link} instead of ${manifest.root_file}` };\n714:   }\n715: \n716:   const content = fs.readFileSync(target, 'utf8');\n717:   if (!context.exists) {\n718:     return { state: FINDING, kind: 'sole instruction file', detail: `there is no ${manifest.root_file} for it to point at` };\n719:   }\n720:   if (content === context.text) {\n721:     return { state: FINDING, kind: 'identical copy', detail: `byte-identical to ${manifest.root_file}, so the two will drift` };\n722:   }\n723: \n724:   const unique = localLinesOf(content, context.text);\n725:   const rootLines = trimmedLines(context.text);\n726:   const sharesShippedLine = [...trimmedLines(content)].some((line) => rootLines.has(line));\n727:   const namesRoot = [...trimmedLines(content)].some((line) => line.includes(manifest.root_file));\n728:   // A pointer is a file that carries no shipped line and names the root document. Anything\n729:   // else is either a copy or a copy plus local lines, and both drift: the second also\n730:   // loses text when it is replaced, so the lines only it carries are listed.\n731:   if (!sharesShippedLine && namesRoot) {\n732:     return { state: PASS, kind: 'pointer', detail: `every line names ${manifest.root_file}` };\n733:   }\n734:   return { state: FINDING, kind: 'divergent copy', detail: `${unique.length} line(s) only this file carries`, lines: unique };\n735: }\n736: \n737: function isSymlink(target) {\n738:   try {\n739:     return fs.lstatSync(target).isSymbolicLink();\n740:   } catch {\n741:     return false;\n742:   }\n743: }\n744: \n745: // A11. The router: present, carrying the rows the template ships, and passing its own\n746: // checker. The checker's summary line is carried through, never rebuilt.\n747: function rowRouter(context, manifest, tools) {\n748:   const routerPath = path.join(context.root, manifest.router_file);\n749:   if (!fs.existsSync(routerPath)) {\n750:     return row('A11', 'REPO RULES.md', FINDING, 'absent',\n751:       { lines: [`no ${manifest.router_file}: no repository rule can load`], entries: [{ path: manifest.router_file, present: false }] });\n752:   }\n753: \n754:   const text = fs.readFileSync(routerPath, 'utf8');\n755:   const shipped = (manifest.derived && manifest.derived.repo_rules) || { trigger_rows: [], index_rows: [] };\n756:   const lines = [];\n757:   const missing = [\n758:     ...missingRows(shipped.trigger_rows, parseTableRows(text, 'TRIGGER TABLE'), 'trigger'),\n759:     ...missingRows(shipped.index_rows, parseTableRows(text, 'INDEX'), 'index'),\n760:   ];\n761:   for (const entry of missing) lines.push(`missing ${entry.kind} row for ${entry.rule}`);\n762: \n763:   if (typeof tools.repoRules !== 'string' || !fs.existsSync(tools.repoRules)) {\n764:     return row('A11', 'REPO RULES.md', UNKNOWN, 'present; the repo-rules checker is not installed',\n765:       { lines: [...lines, `the checker is not installed at ${tools.repoRules || '(no path)'}`] });\n766:   }\n767: \n768:   const run = spawnSync(process.execPath, [tools.repoRules, '--root', context.root], {\n769:     encoding: 'utf8',\n770:     timeout: TOOL_TIMEOUT_MS,\n771:   });\n772:   const output = `${run.stdout || ''}\\n${run.stderr || ''}`.split('\\n').map((line) => line.trim()).filter((line) => line !== '');\n773:   const summary = output.find((line) => line.includes(REPO_RULES_TAG) && line.includes('RESULT:'));\n774: \n775:   if (run.status === 2 || !summary) {\n776:     return row('A11', 'REPO RULES.md', UNKNOWN, 'the repo-rules checker could not run',\n777:       { lines: [...lines, ...output.filter((line) => line.includes(REPO_RULES_TAG))] });\n778:   }\n779:   if (run.status !== 0) {\n780:     return row('A11', 'REPO RULES.md', FINDING, `${missing.length} shipped row(s) missing; the checker fails`,\n781:       { lines: [...lines, summary] });\n782:   }\n783:   return row('A11', 'REPO RULES.md', lines.length === 0 ? PASS : FINDING,\n784:     `${missing.length} shipped row(s) missing; ${summary}`, { lines: [...lines, summary] });\n785: }\n786: \n787: // The router's own table, read the same way the manifest's rows were derived. Comparing\n788: // shipped rows to the file is the only way to say which of them a consumer dropped.\n789: function parseTableRows(text, anchor) {\n790:   const lines = text.split('\\n');\n791:   const start = lines.findIndex((line) => line.startsWith('#') && line.includes(anchor));\n792:   if (start === -1) return [];\n793: \n794:   const rows = [];\n795:   let width = 0;\n796:   for (let index = start + 1; index < lines.length; index += 1) {\n797:     const line = lines[index].trim();\n798:     if (line.startsWith('#')) break;\n799:     if (!line.startsWith('|')) {\n800:       if (rows.length > 0 && line === '') break;\n801:       continue;\n802:     }\n803:     const cells = line.replace(/^\\|/u, '').replace(/\\|$/u, '').split('|').map((cell) => cell.trim());\n804:     if (cells.every((cell) => /^:?-+:?$/u.test(cell) || cell === '')) continue;\n805:     if (width === 0) {\n806:       width = cells.length;\n807:       continue;\n808:     }\n809:     if (cells.length !== width) continue;\n810:     rows.push(cells);\n811:   }\n812:   return rows;\n813: }\n814: \n815: function rulePathOf(cells) {\n816:   for (const cell of cells) {\n817:     const linked = /\\(([^)]+\\.md)\\)/u.exec(cell);\n818:     if (linked) return linked[1];\n819:     const bare = /`([^`]+\\.md)`/u.exec(cell);\n820:     if (bare) return bare[1];\n821:   }\n822:   return null;\n823: }\n824: \n825: function missingRows(shipped, present, kind) {\n826:   const found = new Set(present.map((cells) => rulePathOf(cells) || cells.join(' | ')));\n827:   const missing = [];\n828:   for (const cells of shipped) {\n829:     const rule = rulePathOf(cells) || cells.join(' | ');\n830:     if (!found.has(rule)) missing.push({ kind, rule });\n831:   }\n832:   return missing;\n833: }\n834: \n835: // A12. The source repository's own two promises: its block stays empty, and its derived\n836: // copy of the template is fresh. A consumer's block is its own, so this row reports INFO\n837: // there instead of telling it what to do with its own file.\n838: function rowTemplatePurity(context, manifest, tools, options) {\n839:   let source = { isSource: false, reason: `origin was not compared` };\n840:   try {\n841:     source = sourceStatus({ root: context.root, manifest });\n842:   } catch (error) {\n843:     source = { isSource: false, reason: error.message };\n844:   }\n845: \n846:   if (!options.source && !source.isSource) {\n847:     return row('A12', 'template purity', INFO,\n848:       `runs only in the source repository; ${source.reason || 'the origin differs'}`);\n849:   }\n850: \n851:   const lines = [];\n852:   if (context.blockContent) lines.push('the source repository block carries content, and every line here ships to every consumer');\n853:   if (context.block && !context.block.complete) lines.push('the source repository block is not well formed');\n854: \n855:   if (typeof tools.generator !== 'string' || !fs.existsSync(tools.generator)) {\n856:     return row('A12', 'template purity', UNKNOWN,\n857:       `the manifest generator is not installed at ${tools.generator || '(no path)'}`);\n858:   }\n859:   const run = spawnSync(process.execPath, [tools.generator, '--check', '--root', context.root, '--manifest', options.manifest], {\n860:     encoding: 'utf8',\n861:     timeout: TOOL_TIMEOUT_MS,\n862:   });\n863:   const output = `${run.stdout || ''}\\n${run.stderr || ''}`.split('\\n').map((line) => line.trim()).filter((line) => line !== '');\n864:   if (run.status !== 0) lines.push(...output);\n865: \n866:   const state = lines.length === 0 ? PASS : FINDING;\n867:   return row('A12', 'template purity', state,\n868:     state === PASS ? 'block empty and the derived copy is fresh' : 'the source template is not pure', { lines });\n869: }\n870: \n871: // ─────────────────────────────────────────────────────────────────────────────\n872: // 6. REPORT\n873: // ─────────────────────────────────────────────────────────────────────────────\n874: \n875: function defaultTools(manifest) {\n876:   const canaryPin = (manifest.pins || []).find((pin) => String(pin.consumer || '').endsWith('check-rule-copies.js'));\n877:   const pointerPin = (manifest.pins || []).find((pin) => pin.kind === 'first-occurrence');\n878:   return {\n879:     canary: canaryPin ? path.join(REPO_ROOT, canaryPin.consumer) : null,\n880:     pointerSync: pointerPin ? path.join(REPO_ROOT, pointerPin.consumer) : null,\n881:     repoRules: REPO_RULES_CHECKER,\n882:     generator: GENERATOR,\n883:   };\n884: }\n885: \n886: /**\n887:  * Classify one repository.\n888:  *\n889:  * @param {{root?: string, manifestPath?: string, source?: boolean, tools?: Object}} [input]\n890:  * @returns {{root: string, manifest: string, state: string, status: string, exitCode: number,\n891:  *   findings: number, unknown: number, rows: Array<Object>} | null} Null when the root\n892:  *   directory or the manifest is not readable.\n893:  */\n894: function buildReport(input = {}) {\n895:   const root = input.root ? path.resolve(input.root) : REPO_ROOT;\n896:   const manifestPath = input.manifestPath ? path.resolve(input.manifestPath) : MANIFEST_PATH;\n897:   if (!fs.existsSync(manifestPath)) return null;\n898: \n899:   let manifest;\n900:   try {\n901:     manifest = JSON.parse(fs.readFileSync(manifestPath, 'utf8'));\n902:   } catch {\n903:     return null;\n904:   }\n905: \n906:   const context = readTarget({ root, manifest });\n907:   if (context === null) return null;\n908: \n909:   const tools = { ...defaultTools(manifest), ...(input.tools || {}) };\n910:   const rows = [\n911:     rowInstallState(context, manifest),\n912:     rowSectionsPresent(context, manifest),\n913:     rowOrderAndNumbering(context, manifest),\n914:     rowCurrency(context),\n915:     rowPins(context, manifest),\n916:     rowBudget(context, manifest, tools),\n917:     rowBlock(context, manifest),\n918:     rowUnmarked(context, manifest),\n919:     rowUnmarkedEdits(context, manifest),\n920:     rowRuntimeCopies(context, manifest, tools),\n921:     rowRouter(context, manifest, tools),\n922:     rowTemplatePurity(context, manifest, tools, { source: Boolean(input.source), manifest: manifestPath }),\n923:   ];\n924: \n925:   const findings = rows.filter((entry) => entry.state === FINDING).length;\n926:   const unknown = rows.filter((entry) => entry.state === UNKNOWN).length;\n927:   const exitCode = findings > 0 || unknown > 0 ? 1 : 0;\n928:   const status = exitCode === 0 ? 'OK' : (findings > 0 ? 'FINDINGS' : 'UNKNOWN');\n929: \n930:   return {\n931:     root,\n932:     manifest: manifestPath,\n933:     state: rows[0].detail,\n934:     status,\n935:     exitCode,\n936:     findings,\n937:     unknown,\n938:     rows,\n939:   };\n940: }\n941: \n942: // A long row is a list, not a wall: the report keeps every line in the JSON form and\n943: // prints the first few here, so a reader sees the shape before the volume.\n944: const PRINTED_LINES = 20;\n945: \n946: function renderText(report) {\n947:   const lines = [];\n948:   for (const entry of report.rows) {\n949:     lines.push(`${entry.id} ${entry.name}: ${entry.detail}   (${entry.state})`);\n950:     for (const line of entry.lines.slice(0, PRINTED_LINES)) lines.push(`  ${line}`);\n951:     if (entry.lines.length > PRINTED_LINES) {\n952:       lines.push(`  ... ${entry.lines.length - PRINTED_LINES} more line(s), all of them in the JSON report`);\n953:     }\n954:   }\n955:   lines.push(`STATUS=${report.status} rows=${report.rows.length} findings=${report.findings} unknown=${report.unknown}`);\n956:   return `${lines.join('\\n')}\\n`;\n957: }\n958: \n959: function renderJson(report) {\n960:   const shaped = {\n961:     root: report.root,\n962:     manifest: report.manifest,\n963:     state: report.state,\n964:     status: report.status,\n965:     exit_code: report.exitCode,\n966:     findings: report.findings,\n967:     unknown: report.unknown,\n968:     rows: report.rows.map((entry) => ({\n969:       id: entry.id,\n970:       name: entry.name,\n971:       state: entry.state,\n972:       detail: entry.detail,\n973:       lines: entry.lines,\n974:       entries: entry.entries,\n975:     })),\n976:   };\n977:   return `${JSON.stringify(shaped, null, 2)}\\n`;\n978: }\n979: \n980: // ─────────────────────────────────────────────────────────────────────────────\n981: // 7. MAIN\n982: // ─────────────────────────────────────────────────────────────────────────────\n983: \n984: /**\n985:  * @param {string[]} argv\n986:  * @param {{tools?: Object}} [hooks] - test seams for the child tools\n987:  * @returns {number} the process exit code\n988:  */\n989: function main(argv, hooks = {}) {\n990:   const options = parseArgs(argv);\n991:   if (options.help) {\n992:     console.log(USAGE);\n993:     return 0;\n994:   }\n995: \n996:   if (!fs.existsSync(options.manifest)) {\n997:     console.error(`${TAG} ERROR: the manifest is missing at ${options.manifest}`);\n998:     return 2;\n999:   }\n1000:   if (!fs.existsSync(options.root) || !fs.statSync(options.root).isDirectory()) {\n1001:     console.error(`${TAG} ERROR: the target root is not a directory: ${options.root}`);\n1002:     return 2;\n1003:   }\n1004:   // The root file's name is the manifest's to declare, so this precondition reads the same\n1005:   // declaration every other read does instead of a name of its own.\n1006:   let rootFile = null;\n1007:   try {\n1008:     rootFile = JSON.parse(fs.readFileSync(options.manifest, 'utf8')).root_file || null;\n1009:   } catch {\n1010:     // An unreadable manifest is refused below, where the run has no report to print.\n1011:     rootFile = null;\n1012:   }\n1013:   const rootPath = rootFile === null ? null : path.join(options.root, rootFile);\n1014:   if (rootPath !== null && fs.existsSync(rootPath)) {\n1015:     try {\n1016:       fs.readFileSync(rootPath, 'utf8');\n1017:     } catch (error) {\n1018:       console.error(`${TAG} ERROR: cannot read ${rootPath}: ${error.message}`);\n1019:       return 2;\n1020:     }\n1021:   }\n1022: \n1023:   const report = buildReport({\n1024:     root: options.root,\n1025:     manifestPath: options.manifest,\n1026:     source: options.source,\n1027:     tools: hooks.tools || {},\n1028:   });\n1029:   if (report === null) {\n1030:     // A manifest that cannot be parsed leaves nothing to compare against, and an empty\n1031:     // report would read like a clean one.\n1032:     console.error(`${TAG} ERROR: cannot classify ${options.root}: the manifest at ${options.manifest} could not be read as JSON`);\n1033:     return 2;\n1034:   }\n1035: \n1036:   process.stdout.write(options.json ? renderJson(report) : renderText(report));\n1037:   return report.exitCode;\n1038: }\n1039: \n1040: if (require.main === module) {\n1041:   try {\n1042:     process.exitCode = main(process.argv.slice(2));\n1043:   } catch (error) {\n1044:     console.error(`${TAG} ERROR: ${error.message}`);\n1045:     if (error instanceof UsageError) console.error(USAGE);\n1046:     process.exitCode = 2;\n1047:   }\n1048: }\n1049: \n1050: module.exports = {\n1051:   MANIFEST_PATH,\n1052:   buildReport,\n1053:   main,\n1054:   renderJson,\n1055:   renderText,\n1056: };"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\": \".skilled/commands/doctor/scripts/agents-md-check.cjs\"}"},"time":{"start":1794550360240,"end":1794550360274}}}}
