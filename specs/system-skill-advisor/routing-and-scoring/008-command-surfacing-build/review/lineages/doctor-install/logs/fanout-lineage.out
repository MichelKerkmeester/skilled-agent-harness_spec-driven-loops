{"type":"tool_use","timestamp":1794550375910,"sessionID":"ses_e2c799ae9ffehgaY2UX9uAVWD2","part":{"partID":"prt_1d389a593002Yuvg4nnkNHKHbi","sessionID":"ses_e2c799ae9ffehgaY2UX9uAVWD2","messageID":"msg_1d3899cb20013gnUtkJmhtoF53","type":"tool","id":"call_00_ZGqhl3qk9zTGJOR3mUWX2292","tool":"read","state":{"status":"completed","input":{"offset":821,"path":".skilled/commands/doctor/scripts/agents-md-embed.cjs"},"output":"Read file .skilled/commands/doctor/scripts/agents-md-embed.cjs, lines 821-1599\n821:       before: mirrorExists ? fs.readFileSync(mirrorPath, 'utf8') : null,\n822:     });\n823:   }\n824: \n825:   for (const copy of removedCopies) {\n826:     if (copy.path === CLAUDE_POINTER_PATH) {\n827:       files.push({ path: copy.path, action: 'replace', content: claudePointer, before: copy.content });\n828:       continue;\n829:     }\n830:     files.push({ path: copy.path, action: 'remove', content: null, before: copy.content });\n831:   }\n832: \n833:   // Claude Code reads only CLAUDE.md, so the pointer is its one route to the root document.\n834:   const claudePath = path.join(root, CLAUDE_POINTER_PATH);\n835:   if (\n836:     files.some((file) => ['create', 'replace', 'remove'].includes(file.action))\n837:     && !fs.existsSync(claudePath)\n838:     && !isSymlink(claudePath)\n839:   ) {\n840:     files.push({ path: CLAUDE_POINTER_PATH, action: 'create', content: claudePointer, before: null });\n841:   }\n842: \n843:   const composition = {\n844:     root,\n845:     state: report.state,\n846:     report,\n847:     markers,\n848:     rootFile,\n849:     oldText,\n850:     composed,\n851:     block: { text: renderBlock(markers, blockText), body: blockText },\n852:     chunks,\n853:     removedCopies,\n854:     notes,\n855:     files,\n856:     budget: {\n857:       before: { prefix: prefixEndOf(oldText, manifest), total: oldText === null ? 0 : Buffer.byteLength(oldText, 'utf8') },\n858:       after: { prefix: prefixEndOf(composed, manifest), total: Buffer.byteLength(composed, 'utf8') },\n859:       limits: { prefix: manifest.budget.prefix_bytes, total: manifest.budget.max_bytes },\n860:     },\n861:     ledger: {\n862:       kept: chunks.filter((chunk) => ['block', 'preamble', 'unmarked', 'edited'].includes(chunk.kind)).reduce((sum, chunk) => sum + chunk.lines, 0),\n863:       carried: chunks.filter((chunk) => chunk.kind === 'copy').reduce((sum, chunk) => sum + chunk.lines, 0),\n864:       shippedReplaced: manifest.sections.length,\n865:       dropped: 0,\n866:     },\n867:   };\n868: \n869:   // What the run would put on disk, which is exactly the three actions a target can take.\n870:   composition.writes = composition.files.filter((file) => ['create', 'replace', 'remove'].includes(file.action));\n871:   return composition;\n872: }\n873: \n874: // ─────────────────────────────────────────────────────────────────────────────\n875: // 11. THE WRITE ALLOWLIST\n876: // ─────────────────────────────────────────────────────────────────────────────\n877: \n878: /**\n879:  * Resolve one path a run wants to touch, or refuse it.\n880:  *\n881:  * Containment is checked before membership, so a path that climbs out of the root is\n882:  * reported as what it is rather than as a missing allowlist entry.\n883:  *\n884:  * @param {string} root\n885:  * @param {string} relative\n886:  * @returns {string} the absolute path\n887:  */\n888: function assertWritable(root, relative) {\n889:   const base = path.resolve(root);\n890:   const normalized = String(relative).split(path.sep).join('/');\n891:   const absolute = path.resolve(base, normalized);\n892:   if (absolute !== path.join(base, normalized) || !absolute.startsWith(base + path.sep)) {\n893:     throw new AllowlistError(`${relative} resolves outside the target root ${base}`);\n894:   }\n895:   if (!ALLOWLIST.includes(normalized)) {\n896:     throw new AllowlistError(`${relative} is not on the write allowlist (${ALLOWLIST.join(', ')})`);\n897:   }\n898:   // Every path a run reaches must sit inside the root where the root really is, not only\n899:   // under its name: a link inside the tree can aim a legal-looking path at a file outside it.\n900:   const realBase = fs.realpathSync(base);\n901:   const realTarget = resolveThroughLinks(absolute);\n902:   if (realTarget !== realBase && !realTarget.startsWith(realBase + path.sep)) {\n903:     throw new AllowlistError(`${relative} resolves outside the target root ${realBase} through a link`);\n904:   }\n905:   return absolute;\n906: }\n907: \n908: // The real path of a path that may not exist yet: the nearest existing ancestor is resolved\n909: // and the rest of the name is appended to it.\n910: function resolveThroughLinks(absolute) {\n911:   try {\n912:     return fs.realpathSync(absolute);\n913:   } catch {\n914:     const parent = path.dirname(absolute);\n915:     if (parent === absolute) return absolute;\n916:     return path.join(resolveThroughLinks(parent), path.basename(absolute));\n917:   }\n918: }\n919: \n920: // ─────────────────────────────────────────────────────────────────────────────\n921: // 12. BACKUPS\n922: // ─────────────────────────────────────────────────────────────────────────────\n923: \n924: function utcStamp(date = new Date()) {\n925:   return date.toISOString().replace(/[-:]/gu, '').replace(/\\.\\d+Z$/u, 'Z');\n926: }\n927: \n928: /**\n929:  * The directory a plan's backup sits in, named after the plan digest.\n930:  *\n931:  * Named by the digest rather than by a clock reading because apply has to land exactly\n932:  * where the plan pointed and the digest is the only thing the operator carries across. The\n933:  * consequence is that a directory is a plan's own: a second plan of the same work finds it\n934:  * taken and moves to the next ordinal instead of writing beside it.\n935:  *\n936:  * @param {string} base\n937:  * @param {string} digest\n938:  * @returns {string}\n939:  */\n940: function backupDirectoryOf(base, digest) {\n941:   return path.join(base, digest.slice(0, BACKUP_NAME_CHARS));\n942: }\n943: \n944: /**\n945:  * Where a run's backup goes, without creating anything.\n946:  *\n947:  * The output directory is used only when git ignores it, because a backup inside a tracked\n948:  * path is a backup the next commit publishes. Everything else leaves the repository.\n949:  *\n950:  * @param {{root: string}} input\n951:  * @returns {{dir: string, fallback: boolean, reason: string}}\n952:  */\n953: function backupBase({ root }) {\n954:   const candidate = path.join(root, BACKUP_DIR);\n955:   // The question is the one the run depends on: would a plan directory under this one be\n956:   // published by the next commit? Asking about the base alone would miss a rule written as\n957:   // `.skilled/output/*`, which ignores the per-plan directories and not their parent, so\n958:   // the probe is a path of the same shape as the one the plan takes.\n959:   const probe = path.join(candidate, 'probe');\n960:   const ignored = spawnSync('git', ['-C', root, '-c', 'core.fsmonitor=false', 'check-ignore', '-q', probe], {\n961:     encoding: 'utf8',\n962:     timeout: TOOL_TIMEOUT_MS,\n963:   });\n964:   if (ignored.status === 0) return { dir: candidate, fallback: false, reason: '' };\n965:   const reason = ignored.status === 1\n966:     ? `git does not ignore ${BACKUP_DIR} under ${root}`\n967:     : `git cannot answer whether ${BACKUP_DIR} is ignored under ${root} (exit ${ignored.status})`;\n968:   return { dir: path.join(os.tmpdir(), BACKUP_FALLBACK_DIR), fallback: true, reason };\n969: }\n970: \n971: /**\n972:  * The plan a run stands on: the composition, plus where its backup goes and the digest\n973:  * that says both.\n974:  *\n975:  * The loop is what makes a re-plan honest. A directory an earlier run already holds is not\n976:  * suffixed into a second name, because the printed undo command would then point at that\n977:  * run's bytes; the next ordinal is a different plan with a different digest and a\n978:  * directory of its own.\n979:  *\n980:  * @param {Object} composition\n981:  * @returns {{dir: string, fallback: boolean, reason: string, digest: string, ordinal: number, base: string}}\n982:  */\n983: function planFor(composition) {\n984:   const base = backupBase({ root: composition.root });\n985:   for (let ordinal = 0; ordinal < BACKUP_ATTEMPTS; ordinal += 1) {\n986:     const digest = planDigest(composition, { ordinal, base: base.dir });\n987:     const dir = backupDirectoryOf(base.dir, digest);\n988:     if (!fs.existsSync(dir)) return { dir, fallback: base.fallback, reason: base.reason, digest, ordinal, base: base.dir };\n989:   }\n990:   throw new PreconditionError(`every backup directory for this composition under ${base.dir} is taken, so nothing was written`);\n991: }\n992: \n993: // The folders a new file needs that do not exist yet, deepest first. A restore removes\n994: // only these, so on a record the run wrote, a folder that was there before the run is never\n995: // taken away with it.\n996: function missingParents(root, relative) {\n997:   const missing = [];\n998:   let dir = path.posix.dirname(relative);\n999:   while (dir !== '.' && dir !== '' && !fs.existsSync(path.join(root, dir))) {\n1000:     missing.push(dir);\n1001:     dir = path.posix.dirname(dir);\n1002:   }\n1003:   return missing;\n1004: }\n1005: \n1006: // A record is data, so a recorded folder counts only while it is a proper ancestor of the\n1007: // entry's own allowlisted path; the list stops at the first one that is not.\n1008: function recordedCreatedDirs(entry) {\n1009:   const dirs = [];\n1010:   if (entry.existed || !Array.isArray(entry.createdDirs)) return dirs;\n1011:   for (const dir of entry.createdDirs) {\n1012:     if (typeof dir !== 'string' || dir === '' || dir.split('/').includes('..') || !entry.path.startsWith(`${dir}/`)) break;\n1013:     dirs.push(dir);\n1014:   }\n1015:   return dirs;\n1016: }\n1017: \n1018: // Runs after every file is back, because two new files can share one new folder. Only the\n1019: // folders above a file this restore just deleted are considered, and only an empty one is\n1020: // removed, so a hand-edited record can at most take away an empty folder on the path to a\n1021: // file the run created.\n1022: function removeCreatedDirs(root, entries, deleted) {\n1023:   const removed = [];\n1024:   for (const entry of entries) {\n1025:     if (!deleted.has(entry.path)) continue;\n1026:     for (const dir of recordedCreatedDirs(entry)) {\n1027:       const absolute = path.join(root, dir);\n1028:       let names;\n1029:       try { names = fs.readdirSync(absolute); } catch { continue; }\n1030:       if (names.length > 0) break;\n1031:       fs.rmdirSync(absolute);\n1032:       removed.push(dir);\n1033:     }\n1034:   }\n1035:   return removed;\n1036: }\n1037: \n1038: // What one path looked like before the run, kept beside a copy of it so a restore is a\n1039: // copy rather than a reconstruction.\n1040: function backupEntry(root, file) {\n1041:   const absolute = path.join(root, file.path);\n1042:   const exists = fs.existsSync(absolute);\n1043:   const entry = { path: file.path, action: file.action, existed: exists, sha256: null, backup: null, mode: null, symlink: false };\n1044:   if (!exists) {\n1045:     entry.createdDirs = missingParents(root, file.path);\n1046:     return entry;\n1047:   }\n1048:   const stats = fs.lstatSync(absolute);\n1049:   entry.mode = stats.mode.toString(8).slice(-4);\n1050:   entry.symlink = stats.isSymbolicLink();\n1051:   const bytes = fs.readFileSync(absolute);\n1052:   entry.sha256 = sha256(bytes.toString('utf8'));\n1053:   entry.backup = path.posix.join('files', file.path);\n1054:   return entry;\n1055: }\n1056: \n1057: function writeBackup({ root, manifest, composition, plan }) {\n1058:   // The plan chose a directory nothing owned, so a directory here is somebody else's run\n1059:   // finishing first: writing beside its record would make the undo ambiguous.\n1060:   if (fs.existsSync(plan.dir)) {\n1061:     throw new PreconditionError(`the backup directory ${plan.dir} already exists; nothing was written`);\n1062:   }\n1063:   fs.mkdirSync(plan.dir, { recursive: true });\n1064: \n1065:   const entries = [];\n1066:   for (const file of composition.writes) entries.push(backupEntry(root, file));\n1067:   // The pointer block is regenerated by its own tool, so it is backed up whenever the run\n1068:   // would touch it, even though this engine composes nothing for it.\n1069:   const pointerAbsolute = path.join(root, POINTER_FILE);\n1070:   if (composition.writes.some((file) => file.path === manifest.root_file) && fs.existsSync(pointerAbsolute) && !isSymlink(pointerAbsolute)) {\n1071:     entries.push(backupEntry(root, { path: POINTER_FILE, action: 'regenerated' }));\n1072:   }\n1073: \n1074:   // The backup and its record are written by plain fs, never by the caller's write hook:\n1075:   // the rollback must not share a path with the writer it exists to undo.\n1076:   for (const entry of entries) {\n1077:     if (!entry.existed) continue;\n1078:     const destination = path.join(plan.dir, entry.backup);\n1079:     fs.mkdirSync(path.dirname(destination), { recursive: true });\n1080:     fs.copyFileSync(path.join(root, entry.path), destination);\n1081:   }\n1082: \n1083:   const record = {\n1084:     schema: 1,\n1085:     root,\n1086:     created_at: utcStamp(),\n1087:     plan_digest: plan.digest,\n1088:     paths: entries,\n1089:   };\n1090:   fs.writeFileSync(path.join(plan.dir, 'manifest.json'), `${JSON.stringify(record, null, 2)}\\n`, 'utf8');\n1091:   return record;\n1092: }\n1093: \n1094: // ─────────────────────────────────────────────────────────────────────────────\n1095: // 13. THE DIFF\n1096: // ─────────────────────────────────────────────────────────────────────────────\n1097: \n1098: function diffLines(text) {\n1099:   if (text === null) return [];\n1100:   const lines = String(text).split('\\n');\n1101:   if (lines.length > 0 && lines[lines.length - 1] === '') lines.pop();\n1102:   return lines;\n1103: }\n1104: \n1105: function diffOps(left, right) {\n1106:   const rows = left.length + 1;\n1107:   const columns = right.length + 1;\n1108:   const table = Array.from({ length: rows }, () => new Uint32Array(columns));\n1109:   for (let i = left.length - 1; i >= 0; i -= 1) {\n1110:     for (let j = right.length - 1; j >= 0; j -= 1) {\n1111:       table[i][j] = left[i] === right[j]\n1112:         ? table[i + 1][j + 1] + 1\n1113:         : Math.max(table[i + 1][j], table[i][j + 1]);\n1114:     }\n1115:   }\n1116:   const ops = [];\n1117:   let i = 0;\n1118:   let j = 0;\n1119:   while (i < left.length && j < right.length) {\n1120:     if (left[i] === right[j]) {\n1121:       ops.push({ kind: ' ', text: left[i] });\n1122:       i += 1;\n1123:       j += 1;\n1124:     } else if (table[i + 1][j] >= table[i][j + 1]) {\n1125:       ops.push({ kind: '-', text: left[i] });\n1126:       i += 1;\n1127:     } else {\n1128:       ops.push({ kind: '+', text: right[j] });\n1129:       j += 1;\n1130:     }\n1131:   }\n1132:   while (i < left.length) {\n1133:     ops.push({ kind: '-', text: left[i] });\n1134:     i += 1;\n1135:   }\n1136:   while (j < right.length) {\n1137:     ops.push({ kind: '+', text: right[j] });\n1138:     j += 1;\n1139:   }\n1140:   return ops;\n1141: }\n1142: \n1143: /**\n1144:  * A unified diff with three lines of context, which is what makes a plan reviewable.\n1145:  *\n1146:  * @param {string|null} beforeText\n1147:  * @param {string|null} afterText\n1148:  * @param {string} relative\n1149:  * @returns {string[]}\n1150:  */\n1151: function unifiedDiff(beforeText, afterText, relative) {\n1152:   const left = diffLines(beforeText);\n1153:   const right = diffLines(afterText);\n1154:   const ops = diffOps(left, right);\n1155:   if (!ops.some((op) => op.kind !== ' ')) return [];\n1156: \n1157:   const changed = ops.map((op, index) => (op.kind === ' ' ? -1 : index)).filter((index) => index !== -1);\n1158:   const hunks = [];\n1159:   for (const index of changed) {\n1160:     const start = Math.max(0, index - 3);\n1161:     const end = Math.min(ops.length, index + 4);\n1162:     const last = hunks[hunks.length - 1];\n1163:     if (last && start <= last.end) last.end = Math.max(last.end, end);\n1164:     else hunks.push({ start, end });\n1165:   }\n1166: \n1167:   const output = [`--- ${beforeText === null ? '/dev/null' : `a/${relative}`}`, `+++ ${afterText === null ? '/dev/null' : `b/${relative}`}`];\n1168:   let consumed = 0;\n1169:   for (const hunk of hunks) {\n1170:     // A create has no left side and a removal has no right side, so their cursors start at\n1171:     // zero rather than at the first line of a file that is not there.\n1172:     let leftCursor = beforeText === null ? 0 : 1;\n1173:     let rightCursor = afterText === null ? 0 : 1;\n1174:     for (let index = 0; index < hunk.start; index += 1) {\n1175:       if (ops[index].kind !== '+') leftCursor += 1;\n1176:       if (ops[index].kind !== '-') rightCursor += 1;\n1177:     }\n1178:     const slice = ops.slice(hunk.start, hunk.end);\n1179:     const leftCount = slice.filter((op) => op.kind !== '+').length;\n1180:     const rightCount = slice.filter((op) => op.kind !== '-').length;\n1181:     output.push(`@@ -${leftCursor},${leftCount} +${rightCursor},${rightCount} @@`);\n1182:     for (const op of slice) output.push(`${op.kind}${op.text}`);\n1183:     consumed += slice.length;\n1184:   }\n1185:   return consumed === 0 ? [] : output;\n1186: }\n1187: \n1188: // ─────────────────────────────────────────────────────────────────────────────\n1189: // 14. THE PLAN\n1190: // ─────────────────────────────────────────────────────────────────────────────\n1191: \n1192: function renderTargets(composition) {\n1193:   return composition.files.map((file) => `target ${file.path}: ${file.action}`);\n1194: }\n1195: \n1196: function renderPlan(composition, plan) {\n1197:   const lines = [];\n1198:   lines.push(`${TAG} plan for ${composition.root} (state: ${composition.state})`);\n1199:   lines.push(...renderTargets(composition));\n1200:   for (const note of composition.notes) lines.push(`note: ${note}`);\n1201: \n1202:   for (const file of composition.writes) {\n1203:     if (file.action === 'remove') {\n1204:       lines.push(`diff ${file.path}:`);\n1205:       for (const line of unifiedDiff(file.before, null, file.path)) lines.push(line);\n1206:       continue;\n1207:     }\n1208:     const diff = unifiedDiff(file.before, file.content, file.path);\n1209:     lines.push(`diff ${file.path}:`);\n1210:     if (diff.length === 0) lines.push('  (no line changes)');\n1211:     lines.push(...diff);\n1212:   }\n1213: \n1214:   lines.push('block:');\n1215:   lines.push(...composition.block.text.replace(/\\n$/u, '').split('\\n'));\n1216:   lines.push('block-end:');\n1217: \n1218:   const { before, after, limits } = composition.budget;\n1219:   lines.push(`budget: ${before.prefix} -> ${after.prefix} of ${limits.prefix} bytes to the last anchor, ${before.total} -> ${after.total} of ${limits.total} bytes total, ${limits.total - after.total} bytes headroom`);\n1220:   if (after.total > limits.total) {\n1221:     lines.push(`finding: the composed document is ${after.total} bytes, past the ${limits.total}-byte ceiling the truncating runtimes stop at; every carried line is still kept, because preservation outranks the budget`);\n1222:   }\n1223:   if (after.prefix > limits.prefix) {\n1224:     lines.push(`finding: the last delivery anchor now ends at byte ${after.prefix}, past the ${limits.prefix}-byte prefix`);\n1225:   }\n1226: \n1227:   lines.push(`preservation: kept ${composition.ledger.kept}, carried ${composition.ledger.carried}, shipped-replaced ${composition.ledger.shippedReplaced}, dropped ${composition.ledger.dropped}`);\n1228:   lines.push(`backup: ${plan.dir}`);\n1229:   if (plan.fallback) lines.push(`backup-fallback: ${plan.reason}`);\n1230:   lines.push(`undo: ${undoCommand(plan.dir, composition.root)}`);\n1231:   lines.push(`plan-digest: ${plan.digest}`);\n1232:   return lines;\n1233: }\n1234: \n1235: function renderDropped(dropped) {\n1236:   return dropped.map((entry) => `dropped: ${entry.line} (part ${entry.part}, from ${entry.from}: ${entry.after} of ${entry.before} kept)`);\n1237: }\n1238: \n1239: // ─────────────────────────────────────────────────────────────────────────────\n1240: // 15. PLAN\n1241: // ─────────────────────────────────────────────────────────────────────────────\n1242: \n1243: function preflight(composition, manifest) {\n1244:   return preservationCheck(composition.oldText, composition.composed, manifest, { removed: composition.removedCopies });\n1245: }\n1246: \n1247: function commandPlan(options, output, hooks) {\n1248:   const manifest = loadManifest();\n1249:   const composition = compose({ root: options.root, manifest, keepClaudeMd: options.keepClaudeMd, createRouter: options.createRouter });\n1250: \n1251:   const checked = preflight(composition, manifest);\n1252:   composition.ledger.dropped = checked.dropped.length;\n1253: \n1254:   if (composition.writes.length === 0) {\n1255:     output.log(`${TAG} plan for ${composition.root} (state: ${composition.state})`);\n1256:     for (const note of composition.notes) output.log(`note: ${note}`);\n1257:     output.log('NOTHING TO DO');\n1258:     return 0;\n1259:   }\n1260: \n1261:   const plan = planFor(composition);\n1262:   for (const line of renderPlan(composition, plan)) output.log(line);\n1263:   if (checked.dropped.length > 0) {\n1264:     for (const line of renderDropped(checked.dropped)) output.warn(line);\n1265:     output.warn(`${TAG} the composition drops ${checked.dropped.length} line(s), so it will not be offered for writing`);\n1266:     output.warn('STATUS=FAIL');\n1267:     return 1;\n1268:   }\n1269:   if (options.dryRun) output.log('dry-run: nothing was written');\n1270:   return 0;\n1271: }\n1272: \n1273: // ─────────────────────────────────────────────────────────────────────────────\n1274: // 16. APPLY\n1275: // ─────────────────────────────────────────────────────────────────────────────\n1276: \n1277: function runTool(script, args) {\n1278:   if (!fs.existsSync(script)) return { code: null, output: `the tool is not installed at ${script}` };\n1279:   const result = spawnSync(process.execPath, [script, ...args], { encoding: 'utf8', timeout: TOOL_TIMEOUT_MS });\n1280:   const output = `${result.stdout || ''}\\n${result.stderr || ''}`.split('\\n').map((line) => line.trim()).filter((line) => line !== '');\n1281:   return { code: result.status, output };\n1282: }\n1283: \n1284: function restoreFromBackup({ root, dir, output }) {\n1285:   const record = JSON.parse(fs.readFileSync(path.join(dir, 'manifest.json'), 'utf8'));\n1286:   let restored = 0;\n1287:   const deleted = new Set();\n1288:   for (const entry of record.paths) {\n1289:     const target = path.join(root, entry.path);\n1290:     if (!entry.existed) {\n1291:       if (fs.existsSync(target)) {\n1292:         fs.rmSync(target);\n1293:         deleted.add(entry.path);\n1294:       }\n1295:       continue;\n1296:     }\n1297:     const source = path.join(dir, entry.backup);\n1298:     fs.mkdirSync(path.dirname(target), { recursive: true });\n1299:     fs.copyFileSync(source, target);\n1300:     restored += 1;\n1301:   }\n1302:   removeCreatedDirs(root, record.paths, deleted);\n1303:   output.warn(`${TAG} restored: ${restored} file(s) from ${dir}`);\n1304:   return restored;\n1305: }\n1306: \n1307: function commandApply(options, output, hooks) {\n1308:   if (!options.digest) {\n1309:     output.warn(`${TAG} ERROR: apply needs --plan-digest, the digest the plan printed; nothing was written`);\n1310:     return 2;\n1311:   }\n1312: \n1313:   const manifest = loadManifest();\n1314:   const composition = compose({ root: options.root, manifest, keepClaudeMd: options.keepClaudeMd, createRouter: options.createRouter });\n1315: \n1316:   // A tree already in its target state has nothing a digest could authorise.\n1317:   if (composition.writes.length === 0) {\n1318:     output.log(`${TAG} apply on ${composition.root} (state: ${composition.state})`);\n1319:     output.log('NOTHING TO DO');\n1320:     return 0;\n1321:   }\n1322: \n1323:   const plan = planFor(composition);\n1324:   if (plan.digest !== options.digest) {\n1325:     // The digest also names the backup directory, so an operator replaying a plan whose run\n1326:     // already happened gets told which directory holds those bytes instead of a claim\n1327:     // about the tree that would be false.\n1328:     const held = backupDirectoryOf(plan.base, options.digest);\n1329:     if (fs.existsSync(held)) {\n1330:       output.warn(`${TAG} ERROR: the plan digest ${options.digest} names the backup ${held}, which an earlier run already holds; nothing was written. Plan again for a directory of its own`);\n1331:       return 2;\n1332:     }\n1333:     output.warn(`${TAG} ERROR: the plan digest ${options.digest} does not match the composition now (${plan.digest}); the tree changed since the plan, so nothing was written`);\n1334:     return 2;\n1335:   }\n1336: \n1337:   // The same proof the plan ran, because a composition that already loses a line must\n1338:   // never reach a backup, let alone the tree.\n1339:   const checked = preflight(composition, manifest);\n1340:   composition.ledger.dropped = checked.dropped.length;\n1341:   if (checked.dropped.length > 0) {\n1342:     for (const line of renderDropped(checked.dropped)) output.warn(line);\n1343:     output.warn(`${TAG} the composition drops ${checked.dropped.length} line(s); nothing was written`);\n1344:     output.warn('STATUS=FAIL');\n1345:     return 1;\n1346:   }\n1347: \n1348:   // Every path is resolved before the first byte, so a path outside the allowlist stops\n1349:   // the run before a backup exists rather than after a partial write.\n1350:   const targets = [];\n1351:   for (const file of composition.writes) targets.push({ file, absolute: assertWritable(options.root, file.path) });\n1352: \n1353:   // A dry run is the same plan the operator would give a yes to, minus the write: it stops\n1354:   // here, where every precondition has already passed and nothing has been created.\n1355:   if (options.dryRun) {\n1356:     for (const line of renderPlan(composition, plan)) output.log(line);\n1357:     output.log('dry-run: nothing was written');\n1358:     return 0;\n1359:   }\n1360: \n1361:   const record = writeBackup({ root: options.root, manifest, composition, plan });\n1362:   output.log(`${TAG} apply on ${composition.root} (state: ${composition.state})`);\n1363: \n1364:   const write = hooks.write || ((file, content) => fs.writeFileSync(file, content, 'utf8'));\n1365:   for (const target of targets) {\n1366:     if (target.file.action === 'remove') {\n1367:       if (fs.existsSync(target.absolute)) fs.rmSync(target.absolute);\n1368:       output.log(`removed ${target.file.path} (backed up first)`);\n1369:       continue;\n1370:     }\n1371:     fs.mkdirSync(path.dirname(target.absolute), { recursive: true });\n1372:     write(target.absolute, target.file.content);\n1373:     output.log(`wrote ${target.file.path}`);\n1374:   }\n1375: \n1376:   // The pointer block belongs to its generator, and the router verdict to its checker.\n1377:   const rootTouched = composition.writes.some((file) => file.path === manifest.root_file);\n1378:   if (rootTouched) {\n1379:     const wrote = runTool(POINTER_SYNC, ['--root', options.root]);\n1380:     const checkedPointer = runTool(POINTER_SYNC, ['--check', '--root', options.root]);\n1381:     output.log(`pointer-sync: ${checkedPointer.code === 0 ? 'in sync' : `exit ${checkedPointer.code}`}${wrote.output.length > 0 ? ` (${wrote.output.join('; ')})` : ''}`);\n1382:   }\n1383:   if (composition.writes.some((file) => file.path === manifest.router_file)) {\n1384:     const router = runTool(REPO_RULES_CHECKER, ['--root', options.root]);\n1385:     const summary = router.output.find((line) => line.includes(REPO_RULES_TAG) && line.includes('RESULT:')) || router.output[router.output.length - 1] || '';\n1386:     output.log(`repo-rules: ${summary}`);\n1387:   }\n1388: \n1389:   // The proof runs against the bytes on disk, never against the bytes still in memory.\n1390:   const rootPath = path.join(options.root, manifest.root_file);\n1391:   const onDisk = fs.existsSync(rootPath) ? fs.readFileSync(rootPath, 'utf8') : '';\n1392:   const after = preservationCheck(composition.oldText, onDisk, manifest, { removed: composition.removedCopies });\n1393:   const report = buildReport({ root: options.root, manifestPath: MANIFEST_PATH });\n1394: \n1395:   if (after.dropped.length > 0) {\n1396:     for (const line of renderDropped(after.dropped)) output.warn(line);\n1397:     restoreFromBackup({ root: options.root, dir: plan.dir, output });\n1398:     output.warn(`${TAG} the write dropped ${after.dropped.length} line(s), so the run was undone; the backup is kept at ${plan.dir}`);\n1399:     output.warn('STATUS=FAIL');\n1400:     return 1;\n1401:   }\n1402: \n1403:   output.log(`preservation: kept ${composition.ledger.kept}, carried ${composition.ledger.carried}, shipped-replaced ${composition.ledger.shippedReplaced}, dropped ${after.dropped.length}`);\n1404:   if (report !== null) {\n1405:     output.log(`check-after: state=${report.state} findings=${report.findings} unknown=${report.unknown}`);\n1406:   }\n1407:   output.log(`backup: ${plan.dir}`);\n1408:   output.log(`undo: ${undoCommand(plan.dir, options.root)}`);\n1409:   for (const entry of record.paths) {\n1410:     if (!entry.existed) continue;\n1411:     output.log(`cp ${path.join(plan.dir, entry.backup)} ${entry.path}`);\n1412:   }\n1413:   output.log('STATUS=OK');\n1414:   return 0;\n1415: }\n1416: \n1417: // ─────────────────────────────────────────────────────────────────────────────\n1418: // 17. RESTORE\n1419: // ─────────────────────────────────────────────────────────────────────────────\n1420: \n1421: function readConfirmation() {\n1422:   try {\n1423:     return fs.readFileSync(0, 'utf8').split('\\n')[0].trim();\n1424:   } catch {\n1425:     return '';\n1426:   }\n1427: }\n1428: \n1429: function commandRestore(options, output, hooks) {\n1430:   if (!options.run) {\n1431:     output.warn(`${TAG} ERROR: restore needs --run=<dir>, the backup directory a run printed`);\n1432:     return 2;\n1433:   }\n1434:   const recordPath = path.join(options.run, 'manifest.json');\n1435:   if (!fs.existsSync(recordPath)) {\n1436:     output.warn(`${TAG} ERROR: no manifest.json under ${options.run}, so there is nothing recorded to put back`);\n1437:     return 2;\n1438:   }\n1439: \n1440:   const record = JSON.parse(fs.readFileSync(recordPath, 'utf8'));\n1441:   const root = record.root;\n1442:   // The record names its own root, and a record is data: it is trusted only when it names\n1443:   // the root this restore runs against, so a record repointed at another folder is refused\n1444:   // instead of written to. Restoring another folder takes --root naming that folder.\n1445:   if (typeof root !== 'string' || !sameDirectory(root, options.root)) {\n1446:     output.warn(`${TAG} ERROR: the record names the root ${root}, and this restore runs against ${options.root}; pass --root ${root} to restore that folder. Nothing was written`);\n1447:     return 2;\n1448:   }\n1449:   const steps = [];\n1450:   for (const entry of record.paths) {\n1451:     // A record is data, and data can be wrong: the same allowlist decides what it may\n1452:     // touch, so a hand-edited record cannot turn a restore into an arbitrary write.\n1453:     const absolute = assertWritable(root, entry.path);\n1454:     if (!entry.existed) {\n1455:       steps.push({ entry, absolute, action: fs.existsSync(absolute) ? 'delete' : 'absent' });\n1456:       continue;\n1457:     }\n1458:     const source = path.join(options.run, entry.backup);\n1459:     if (!fs.existsSync(source)) {\n1460:       output.warn(`${TAG} ERROR: the backup of ${entry.path} is missing at ${source}; nothing was written`);\n1461:       return 2;\n1462:     }\n1463:     const bytes = fs.readFileSync(source);\n1464:     if (sha256(bytes.toString('utf8')) !== entry.sha256) {\n1465:       output.warn(`${TAG} ERROR: the backup copy of ${entry.path} does not match its recorded hash; nothing was written`);\n1466:       return 2;\n1467:     }\n1468:     steps.push({ entry, absolute, action: 'put back', bytes });\n1469:   }\n1470: \n1471:   output.log(`${TAG} restore plan for ${root} from ${options.run}`);\n1472:   for (const step of steps) {\n1473:     const note = step.action === 'delete' && step.entry.path === 'AGENTS.md'\n1474:       ? ' (this run created it; without it Gate 3 no longer detects this directory as a workspace root)'\n1475:       : '';\n1476:     output.log(`restore ${step.entry.path}: ${step.action}${note}`);\n1477:   }\n1478:   const createdDirs = new Set(steps.flatMap((step) => (step.action === 'delete' ? recordedCreatedDirs(step.entry) : [])));\n1479:   for (const dir of createdDirs) output.log(`restore ${dir}/: remove if empty (this run created it)`);\n1480: \n1481:   if (options.dryRun) {\n1482:     output.log('dry-run: nothing was written');\n1483:     return 0;\n1484:   }\n1485: \n1486:   if (!options.yes) {\n1487:     output.log(`type yes to put ${steps.length} path(s) back:`);\n1488:     if (readConfirmation() !== 'yes') {\n1489:       output.log('cancelled: no confirmation, nothing was written');\n1490:       return 1;\n1491:     }\n1492:   }\n1493: \n1494:   let touched = 0;\n1495:   const deleted = new Set();\n1496:   for (const step of steps) {\n1497:     if (step.action === 'delete') {\n1498:       fs.rmSync(step.absolute);\n1499:       deleted.add(step.entry.path);\n1500:       touched += 1;\n1501:       continue;\n1502:     }\n1503:     if (step.action === 'absent') continue;\n1504:     fs.mkdirSync(path.dirname(step.absolute), { recursive: true });\n1505:     fs.writeFileSync(step.absolute, step.bytes);\n1506:     touched += 1;\n1507:   }\n1508:   for (const dir of removeCreatedDirs(root, record.paths, deleted)) output.log(`restore ${dir}/: removed the empty folder this run created`);\n1509: \n1510:   // Byte equality after the write, measured against the recorded hash rather than against\n1511:   // the copy that was just read.\n1512:   for (const step of steps) {\n1513:     if (step.action === 'delete' || step.action === 'absent') continue;\n1514:     if (sha256(fs.readFileSync(step.absolute, 'utf8')) !== step.entry.sha256) {\n1515:       output.warn(`${TAG} ERROR: ${step.entry.path} does not match its recorded hash after the restore`);\n1516:       output.warn('STATUS=FAIL');\n1517:       return 1;\n1518:     }\n1519:   }\n1520: \n1521:   output.log(`restore: ${touched} path(s) put back, the backup at ${options.run} is kept`);\n1522:   output.log('STATUS=OK');\n1523:   return 0;\n1524: }\n1525: \n1526: // ─────────────────────────────────────────────────────────────────────────────\n1527: // 18. MAIN\n1528: // ─────────────────────────────────────────────────────────────────────────────\n1529: \n1530: function outputOf(hooks) {\n1531:   return {\n1532:     log: typeof hooks.log === 'function' ? hooks.log : (line) => console.log(line),\n1533:     warn: typeof hooks.warn === 'function' ? hooks.warn : (line) => console.error(line),\n1534:   };\n1535: }\n1536: \n1537: /**\n1538:  * @param {string[]} argv\n1539:  * @param {{log?: Function, warn?: Function, write?: Function}} [hooks]\n1540:  * @returns {number} the process exit code\n1541:  */\n1542: function main(argv, hooks = {}) {\n1543:   const options = parseArgs(argv);\n1544:   const output = outputOf(hooks);\n1545:   if (options.help) {\n1546:     output.log(USAGE);\n1547:     return 0;\n1548:   }\n1549:   if (options.command === null) {\n1550:     output.warn(`${TAG} ERROR: one of plan, apply or restore is required\\n${USAGE}`);\n1551:     return 2;\n1552:   }\n1553:   if (!fs.existsSync(options.root) || !fs.statSync(options.root).isDirectory()) {\n1554:     output.warn(`${TAG} ERROR: the target root is not a directory: ${options.root}`);\n1555:     return 2;\n1556:   }\n1557: \n1558:   try {\n1559:     if (options.command === 'plan') return commandPlan(options, output, hooks);\n1560:     if (options.command === 'apply') return commandApply(options, output, hooks);\n1561:     return commandRestore(options, output, hooks);\n1562:   } catch (error) {\n1563:     if (error instanceof AllowlistError) {\n1564:       output.warn(`${TAG} ERROR: ${error.message}; nothing was written`);\n1565:       return 2;\n1566:     }\n1567:     if (error instanceof PreconditionError || error instanceof UsageError) {\n1568:       output.warn(`${TAG} ERROR: ${error.message}`);\n1569:       if (error instanceof UsageError) output.warn(USAGE);\n1570:       return 2;\n1571:     }\n1572:     throw error;\n1573:   }\n1574: }\n1575: \n1576: if (require.main === module) {\n1577:   try {\n1578:     process.exitCode = main(process.argv.slice(2));\n1579:   } catch (error) {\n1580:     console.error(`${TAG} ERROR: ${error.message}`);\n1581:     process.exitCode = 2;\n1582:   }\n1583: }\n1584: \n1585: module.exports = {\n1586:   ALLOWLIST,\n1587:   MANIFEST_PATH,\n1588:   addRouterRows,\n1589:   assertWritable,\n1590:   backupBase,\n1591:   compose,\n1592:   main,\n1593:   planDigest,\n1594:   planFor,\n1595:   preservationCheck,\n1596:   renderBlock,\n1597:   renderMirror,\n1598:   renderRouter,\n1599: };","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file .skilled/commands/doctor/scripts/agents-md-embed.cjs, lines 821-1599\n821:       before: mirrorExists ? fs.readFileSync(mirrorPath, 'utf8') : null,\n822:     });\n823:   }\n824: \n825:   for (const copy of removedCopies) {\n826:     if (copy.path === CLAUDE_POINTER_PATH) {\n827:       files.push({ path: copy.path, action: 'replace', content: claudePointer, before: copy.content });\n828:       continue;\n829:     }\n830:     files.push({ path: copy.path, action: 'remove', content: null, before: copy.content });\n831:   }\n832: \n833:   // Claude Code reads only CLAUDE.md, so the pointer is its one route to the root document.\n834:   const claudePath = path.join(root, CLAUDE_POINTER_PATH);\n835:   if (\n836:     files.some((file) => ['create', 'replace', 'remove'].includes(file.action))\n837:     && !fs.existsSync(claudePath)\n838:     && !isSymlink(claudePath)\n839:   ) {\n840:     files.push({ path: CLAUDE_POINTER_PATH, action: 'create', content: claudePointer, before: null });\n841:   }\n842: \n843:   const composition = {\n844:     root,\n845:     state: report.state,\n846:     report,\n847:     markers,\n848:     rootFile,\n849:     oldText,\n850:     composed,\n851:     block: { text: renderBlock(markers, blockText), body: blockText },\n852:     chunks,\n853:     removedCopies,\n854:     notes,\n855:     files,\n856:     budget: {\n857:       before: { prefix: prefixEndOf(oldText, manifest), total: oldText === null ? 0 : Buffer.byteLength(oldText, 'utf8') },\n858:       after: { prefix: prefixEndOf(composed, manifest), total: Buffer.byteLength(composed, 'utf8') },\n859:       limits: { prefix: manifest.budget.prefix_bytes, total: manifest.budget.max_bytes },\n860:     },\n861:     ledger: {\n862:       kept: chunks.filter((chunk) => ['block', 'preamble', 'unmarked', 'edited'].includes(chunk.kind)).reduce((sum, chunk) => sum + chunk.lines, 0),\n863:       carried: chunks.filter((chunk) => chunk.kind === 'copy').reduce((sum, chunk) => sum + chunk.lines, 0),\n864:       shippedReplaced: manifest.sections.length,\n865:       dropped: 0,\n866:     },\n867:   };\n868: \n869:   // What the run would put on disk, which is exactly the three actions a target can take.\n870:   composition.writes = composition.files.filter((file) => ['create', 'replace', 'remove'].includes(file.action));\n871:   return composition;\n872: }\n873: \n874: // ─────────────────────────────────────────────────────────────────────────────\n875: // 11. THE WRITE ALLOWLIST\n876: // ─────────────────────────────────────────────────────────────────────────────\n877: \n878: /**\n879:  * Resolve one path a run wants to touch, or refuse it.\n880:  *\n881:  * Containment is checked before membership, so a path that climbs out of the root is\n882:  * reported as what it is rather than as a missing allowlist entry.\n883:  *\n884:  * @param {string} root\n885:  * @param {string} relative\n886:  * @returns {string} the absolute path\n887:  */\n888: function assertWritable(root, relative) {\n889:   const base = path.resolve(root);\n890:   const normalized = String(relative).split(path.sep).join('/');\n891:   const absolute = path.resolve(base, normalized);\n892:   if (absolute !== path.join(base, normalized) || !absolute.startsWith(base + path.sep)) {\n893:     throw new AllowlistError(`${relative} resolves outside the target root ${base}`);\n894:   }\n895:   if (!ALLOWLIST.includes(normalized)) {\n896:     throw new AllowlistError(`${relative} is not on the write allowlist (${ALLOWLIST.join(', ')})`);\n897:   }\n898:   // Every path a run reaches must sit inside the root where the root really is, not only\n899:   // under its name: a link inside the tree can aim a legal-looking path at a file outside it.\n900:   const realBase = fs.realpathSync(base);\n901:   const realTarget = resolveThroughLinks(absolute);\n902:   if (realTarget !== realBase && !realTarget.startsWith(realBase + path.sep)) {\n903:     throw new AllowlistError(`${relative} resolves outside the target root ${realBase} through a link`);\n904:   }\n905:   return absolute;\n906: }\n907: \n908: // The real path of a path that may not exist yet: the nearest existing ancestor is resolved\n909: // and the rest of the name is appended to it.\n910: function resolveThroughLinks(absolute) {\n911:   try {\n912:     return fs.realpathSync(absolute);\n913:   } catch {\n914:     const parent = path.dirname(absolute);\n915:     if (parent === absolute) return absolute;\n916:     return path.join(resolveThroughLinks(parent), path.basename(absolute));\n917:   }\n918: }\n919: \n920: // ─────────────────────────────────────────────────────────────────────────────\n921: // 12. BACKUPS\n922: // ─────────────────────────────────────────────────────────────────────────────\n923: \n924: function utcStamp(date = new Date()) {\n925:   return date.toISOString().replace(/[-:]/gu, '').replace(/\\.\\d+Z$/u, 'Z');\n926: }\n927: \n928: /**\n929:  * The directory a plan's backup sits in, named after the plan digest.\n930:  *\n931:  * Named by the digest rather than by a clock reading because apply has to land exactly\n932:  * where the plan pointed and the digest is the only thing the operator carries across. The\n933:  * consequence is that a directory is a plan's own: a second plan of the same work finds it\n934:  * taken and moves to the next ordinal instead of writing beside it.\n935:  *\n936:  * @param {string} base\n937:  * @param {string} digest\n938:  * @returns {string}\n939:  */\n940: function backupDirectoryOf(base, digest) {\n941:   return path.join(base, digest.slice(0, BACKUP_NAME_CHARS));\n942: }\n943: \n944: /**\n945:  * Where a run's backup goes, without creating anything.\n946:  *\n947:  * The output directory is used only when git ignores it, because a backup inside a tracked\n948:  * path is a backup the next commit publishes. Everything else leaves the repository.\n949:  *\n950:  * @param {{root: string}} input\n951:  * @returns {{dir: string, fallback: boolean, reason: string}}\n952:  */\n953: function backupBase({ root }) {\n954:   const candidate = path.join(root, BACKUP_DIR);\n955:   // The question is the one the run depends on: would a plan directory under this one be\n956:   // published by the next commit? Asking about the base alone would miss a rule written as\n957:   // `.skilled/output/*`, which ignores the per-plan directories and not their parent, so\n958:   // the probe is a path of the same shape as the one the plan takes.\n959:   const probe = path.join(candidate, 'probe');\n960:   const ignored = spawnSync('git', ['-C', root, '-c', 'core.fsmonitor=false', 'check-ignore', '-q', probe], {\n961:     encoding: 'utf8',\n962:     timeout: TOOL_TIMEOUT_MS,\n963:   });\n964:   if (ignored.status === 0) return { dir: candidate, fallback: false, reason: '' };\n965:   const reason = ignored.status === 1\n966:     ? `git does not ignore ${BACKUP_DIR} under ${root}`\n967:     : `git cannot answer whether ${BACKUP_DIR} is ignored under ${root} (exit ${ignored.status})`;\n968:   return { dir: path.join(os.tmpdir(), BACKUP_FALLBACK_DIR), fallback: true, reason };\n969: }\n970: \n971: /**\n972:  * The plan a run stands on: the composition, plus where its backup goes and the digest\n973:  * that says both.\n974:  *\n975:  * The loop is what makes a re-plan honest. A directory an earlier run already holds is not\n976:  * suffixed into a second name, because the printed undo command would then point at that\n977:  * run's bytes; the next ordinal is a different plan with a different digest and a\n978:  * directory of its own.\n979:  *\n980:  * @param {Object} composition\n981:  * @returns {{dir: string, fallback: boolean, reason: string, digest: string, ordinal: number, base: string}}\n982:  */\n983: function planFor(composition) {\n984:   const base = backupBase({ root: composition.root });\n985:   for (let ordinal = 0; ordinal < BACKUP_ATTEMPTS; ordinal += 1) {\n986:     const digest = planDigest(composition, { ordinal, base: base.dir });\n987:     const dir = backupDirectoryOf(base.dir, digest);\n988:     if (!fs.existsSync(dir)) return { dir, fallback: base.fallback, reason: base.reason, digest, ordinal, base: base.dir };\n989:   }\n990:   throw new PreconditionError(`every backup directory for this composition under ${base.dir} is taken, so nothing was written`);\n991: }\n992: \n993: // The folders a new file needs that do not exist yet, deepest first. A restore removes\n994: // only these, so on a record the run wrote, a folder that was there before the run is never\n995: // taken away with it.\n996: function missingParents(root, relative) {\n997:   const missing = [];\n998:   let dir = path.posix.dirname(relative);\n999:   while (dir !== '.' && dir !== '' && !fs.existsSync(path.join(root, dir))) {\n1000:     missing.push(dir);\n1001:     dir = path.posix.dirname(dir);\n1002:   }\n1003:   return missing;\n1004: }\n1005: \n1006: // A record is data, so a recorded folder counts only while it is a proper ancestor of the\n1007: // entry's own allowlisted path; the list stops at the first one that is not.\n1008: function recordedCreatedDirs(entry) {\n1009:   const dirs = [];\n1010:   if (entry.existed || !Array.isArray(entry.createdDirs)) return dirs;\n1011:   for (const dir of entry.createdDirs) {\n1012:     if (typeof dir !== 'string' || dir === '' || dir.split('/').includes('..') || !entry.path.startsWith(`${dir}/`)) break;\n1013:     dirs.push(dir);\n1014:   }\n1015:   return dirs;\n1016: }\n1017: \n1018: // Runs after every file is back, because two new files can share one new folder. Only the\n1019: // folders above a file this restore just deleted are considered, and only an empty one is\n1020: // removed, so a hand-edited record can at most take away an empty folder on the path to a\n1021: // file the run created.\n1022: function removeCreatedDirs(root, entries, deleted) {\n1023:   const removed = [];\n1024:   for (const entry of entries) {\n1025:     if (!deleted.has(entry.path)) continue;\n1026:     for (const dir of recordedCreatedDirs(entry)) {\n1027:       const absolute = path.join(root, dir);\n1028:       let names;\n1029:       try { names = fs.readdirSync(absolute); } catch { continue; }\n1030:       if (names.length > 0) break;\n1031:       fs.rmdirSync(absolute);\n1032:       removed.push(dir);\n1033:     }\n1034:   }\n1035:   return removed;\n1036: }\n1037: \n1038: // What one path looked like before the run, kept beside a copy of it so a restore is a\n1039: // copy rather than a reconstruction.\n1040: function backupEntry(root, file) {\n1041:   const absolute = path.join(root, file.path);\n1042:   const exists = fs.existsSync(absolute);\n1043:   const entry = { path: file.path, action: file.action, existed: exists, sha256: null, backup: null, mode: null, symlink: false };\n1044:   if (!exists) {\n1045:     entry.createdDirs = missingParents(root, file.path);\n1046:     return entry;\n1047:   }\n1048:   const stats = fs.lstatSync(absolute);\n1049:   entry.mode = stats.mode.toString(8).slice(-4);\n1050:   entry.symlink = stats.isSymbolicLink();\n1051:   const bytes = fs.readFileSync(absolute);\n1052:   entry.sha256 = sha256(bytes.toString('utf8'));\n1053:   entry.backup = path.posix.join('files', file.path);\n1054:   return entry;\n1055: }\n1056: \n1057: function writeBackup({ root, manifest, composition, plan }) {\n1058:   // The plan chose a directory nothing owned, so a directory here is somebody else's run\n1059:   // finishing first: writing beside its record would make the undo ambiguous.\n1060:   if (fs.existsSync(plan.dir)) {\n1061:     throw new PreconditionError(`the backup directory ${plan.dir} already exists; nothing was written`);\n1062:   }\n1063:   fs.mkdirSync(plan.dir, { recursive: true });\n1064: \n1065:   const entries = [];\n1066:   for (const file of composition.writes) entries.push(backupEntry(root, file));\n1067:   // The pointer block is regenerated by its own tool, so it is backed up whenever the run\n1068:   // would touch it, even though this engine composes nothing for it.\n1069:   const pointerAbsolute = path.join(root, POINTER_FILE);\n1070:   if (composition.writes.some((file) => file.path === manifest.root_file) && fs.existsSync(pointerAbsolute) && !isSymlink(pointerAbsolute)) {\n1071:     entries.push(backupEntry(root, { path: POINTER_FILE, action: 'regenerated' }));\n1072:   }\n1073: \n1074:   // The backup and its record are written by plain fs, never by the caller's write hook:\n1075:   // the rollback must not share a path with the writer it exists to undo.\n1076:   for (const entry of entries) {\n1077:     if (!entry.existed) continue;\n1078:     const destination = path.join(plan.dir, entry.backup);\n1079:     fs.mkdirSync(path.dirname(destination), { recursive: true });\n1080:     fs.copyFileSync(path.join(root, entry.path), destination);\n1081:   }\n1082: \n1083:   const record = {\n1084:     schema: 1,\n1085:     root,\n1086:     created_at: utcStamp(),\n1087:     plan_digest: plan.digest,\n1088:     paths: entries,\n1089:   };\n1090:   fs.writeFileSync(path.join(plan.dir, 'manifest.json'), `${JSON.stringify(record, null, 2)}\\n`, 'utf8');\n1091:   return record;\n1092: }\n1093: \n1094: // ─────────────────────────────────────────────────────────────────────────────\n1095: // 13. THE DIFF\n1096: // ─────────────────────────────────────────────────────────────────────────────\n1097: \n1098: function diffLines(text) {\n1099:   if (text === null) return [];\n1100:   const lines = String(text).split('\\n');\n1101:   if (lines.length > 0 && lines[lines.length - 1] === '') lines.pop();\n1102:   return lines;\n1103: }\n1104: \n1105: function diffOps(left, right) {\n1106:   const rows = left.length + 1;\n1107:   const columns = right.length + 1;\n1108:   const table = Array.from({ length: rows }, () => new Uint32Array(columns));\n1109:   for (let i = left.length - 1; i >= 0; i -= 1) {\n1110:     for (let j = right.length - 1; j >= 0; j -= 1) {\n1111:       table[i][j] = left[i] === right[j]\n1112:         ? table[i + 1][j + 1] + 1\n1113:         : Math.max(table[i + 1][j], table[i][j + 1]);\n1114:     }\n1115:   }\n1116:   const ops = [];\n1117:   let i = 0;\n1118:   let j = 0;\n1119:   while (i < left.length && j < right.length) {\n1120:     if (left[i] === right[j]) {\n1121:       ops.push({ kind: ' ', text: left[i] });\n1122:       i += 1;\n1123:       j += 1;\n1124:     } else if (table[i + 1][j] >= table[i][j + 1]) {\n1125:       ops.push({ kind: '-', text: left[i] });\n1126:       i += 1;\n1127:     } else {\n1128:       ops.push({ kind: '+', text: right[j] });\n1129:       j += 1;\n1130:     }\n1131:   }\n1132:   while (i < left.length) {\n1133:     ops.push({ kind: '-', text: left[i] });\n1134:     i += 1;\n1135:   }\n1136:   while (j < right.length) {\n1137:     ops.push({ kind: '+', text: right[j] });\n1138:     j += 1;\n1139:   }\n1140:   return ops;\n1141: }\n1142: \n1143: /**\n1144:  * A unified diff with three lines of context, which is what makes a plan reviewable.\n1145:  *\n1146:  * @param {string|null} beforeText\n1147:  * @param {string|null} afterText\n1148:  * @param {string} relative\n1149:  * @returns {string[]}\n1150:  */\n1151: function unifiedDiff(beforeText, afterText, relative) {\n1152:   const left = diffLines(beforeText);\n1153:   const right = diffLines(afterText);\n1154:   const ops = diffOps(left, right);\n1155:   if (!ops.some((op) => op.kind !== ' ')) return [];\n1156: \n1157:   const changed = ops.map((op, index) => (op.kind === ' ' ? -1 : index)).filter((index) => index !== -1);\n1158:   const hunks = [];\n1159:   for (const index of changed) {\n1160:     const start = Math.max(0, index - 3);\n1161:     const end = Math.min(ops.length, index + 4);\n1162:     const last = hunks[hunks.length - 1];\n1163:     if (last && start <= last.end) last.end = Math.max(last.end, end);\n1164:     else hunks.push({ start, end });\n1165:   }\n1166: \n1167:   const output = [`--- ${beforeText === null ? '/dev/null' : `a/${relative}`}`, `+++ ${afterText === null ? '/dev/null' : `b/${relative}`}`];\n1168:   let consumed = 0;\n1169:   for (const hunk of hunks) {\n1170:     // A create has no left side and a removal has no right side, so their cursors start at\n1171:     // zero rather than at the first line of a file that is not there.\n1172:     let leftCursor = beforeText === null ? 0 : 1;\n1173:     let rightCursor = afterText === null ? 0 : 1;\n1174:     for (let index = 0; index < hunk.start; index += 1) {\n1175:       if (ops[index].kind !== '+') leftCursor += 1;\n1176:       if (ops[index].kind !== '-') rightCursor += 1;\n1177:     }\n1178:     const slice = ops.slice(hunk.start, hunk.end);\n1179:     const leftCount = slice.filter((op) => op.kind !== '+').length;\n1180:     const rightCount = slice.filter((op) => op.kind !== '-').length;\n1181:     output.push(`@@ -${leftCursor},${leftCount} +${rightCursor},${rightCount} @@`);\n1182:     for (const op of slice) output.push(`${op.kind}${op.text}`);\n1183:     consumed += slice.length;\n1184:   }\n1185:   return consumed === 0 ? [] : output;\n1186: }\n1187: \n1188: // ─────────────────────────────────────────────────────────────────────────────\n1189: // 14. THE PLAN\n1190: // ─────────────────────────────────────────────────────────────────────────────\n1191: \n1192: function renderTargets(composition) {\n1193:   return composition.files.map((file) => `target ${file.path}: ${file.action}`);\n1194: }\n1195: \n1196: function renderPlan(composition, plan) {\n1197:   const lines = [];\n1198:   lines.push(`${TAG} plan for ${composition.root} (state: ${composition.state})`);\n1199:   lines.push(...renderTargets(composition));\n1200:   for (const note of composition.notes) lines.push(`note: ${note}`);\n1201: \n1202:   for (const file of composition.writes) {\n1203:     if (file.action === 'remove') {\n1204:       lines.push(`diff ${file.path}:`);\n1205:       for (const line of unifiedDiff(file.before, null, file.path)) lines.push(line);\n1206:       continue;\n1207:     }\n1208:     const diff = unifiedDiff(file.before, file.content, file.path);\n1209:     lines.push(`diff ${file.path}:`);\n1210:     if (diff.length === 0) lines.push('  (no line changes)');\n1211:     lines.push(...diff);\n1212:   }\n1213: \n1214:   lines.push('block:');\n1215:   lines.push(...composition.block.text.replace(/\\n$/u, '').split('\\n'));\n1216:   lines.push('block-end:');\n1217: \n1218:   const { before, after, limits } = composition.budget;\n1219:   lines.push(`budget: ${before.prefix} -> ${after.prefix} of ${limits.prefix} bytes to the last anchor, ${before.total} -> ${after.total} of ${limits.total} bytes total, ${limits.total - after.total} bytes headroom`);\n1220:   if (after.total > limits.total) {\n1221:     lines.push(`finding: the composed document is ${after.total} bytes, past the ${limits.total}-byte ceiling the truncating runtimes stop at; every carried line is still kept, because preservation outranks the budget`);\n1222:   }\n1223:   if (after.prefix > limits.prefix) {\n1224:     lines.push(`finding: the last delivery anchor now ends at byte ${after.prefix}, past the ${limits.prefix}-byte prefix`);\n1225:   }\n1226: \n1227:   lines.push(`preservation: kept ${composition.ledger.kept}, carried ${composition.ledger.carried}, shipped-replaced ${composition.ledger.shippedReplaced}, dropped ${composition.ledger.dropped}`);\n1228:   lines.push(`backup: ${plan.dir}`);\n1229:   if (plan.fallback) lines.push(`backup-fallback: ${plan.reason}`);\n1230:   lines.push(`undo: ${undoCommand(plan.dir, composition.root)}`);\n1231:   lines.push(`plan-digest: ${plan.digest}`);\n1232:   return lines;\n1233: }\n1234: \n1235: function renderDropped(dropped) {\n1236:   return dropped.map((entry) => `dropped: ${entry.line} (part ${entry.part}, from ${entry.from}: ${entry.after} of ${entry.before} kept)`);\n1237: }\n1238: \n1239: // ─────────────────────────────────────────────────────────────────────────────\n1240: // 15. PLAN\n1241: // ─────────────────────────────────────────────────────────────────────────────\n1242: \n1243: function preflight(composition, manifest) {\n1244:   return preservationCheck(composition.oldText, composition.composed, manifest, { removed: composition.removedCopies });\n1245: }\n1246: \n1247: function commandPlan(options, output, hooks) {\n1248:   const manifest = loadManifest();\n1249:   const composition = compose({ root: options.root, manifest, keepClaudeMd: options.keepClaudeMd, createRouter: options.createRouter });\n1250: \n1251:   const checked = preflight(composition, manifest);\n1252:   composition.ledger.dropped = checked.dropped.length;\n1253: \n1254:   if (composition.writes.length === 0) {\n1255:     output.log(`${TAG} plan for ${composition.root} (state: ${composition.state})`);\n1256:     for (const note of composition.notes) output.log(`note: ${note}`);\n1257:     output.log('NOTHING TO DO');\n1258:     return 0;\n1259:   }\n1260: \n1261:   const plan = planFor(composition);\n1262:   for (const line of renderPlan(composition, plan)) output.log(line);\n1263:   if (checked.dropped.length > 0) {\n1264:     for (const line of renderDropped(checked.dropped)) output.warn(line);\n1265:     output.warn(`${TAG} the composition drops ${checked.dropped.length} line(s), so it will not be offered for writing`);\n1266:     output.warn('STATUS=FAIL');\n1267:     return 1;\n1268:   }\n1269:   if (options.dryRun) output.log('dry-run: nothing was written');\n1270:   return 0;\n1271: }\n1272: \n1273: // ─────────────────────────────────────────────────────────────────────────────\n1274: // 16. APPLY\n1275: // ─────────────────────────────────────────────────────────────────────────────\n1276: \n1277: function runTool(script, args) {\n1278:   if (!fs.existsSync(script)) return { code: null, output: `the tool is not installed at ${script}` };\n1279:   const result = spawnSync(process.execPath, [script, ...args], { encoding: 'utf8', timeout: TOOL_TIMEOUT_MS });\n1280:   const output = `${result.stdout || ''}\\n${result.stderr || ''}`.split('\\n').map((line) => line.trim()).filter((line) => line !== '');\n1281:   return { code: result.status, output };\n1282: }\n1283: \n1284: function restoreFromBackup({ root, dir, output }) {\n1285:   const record = JSON.parse(fs.readFileSync(path.join(dir, 'manifest.json'), 'utf8'));\n1286:   let restored = 0;\n1287:   const deleted = new Set();\n1288:   for (const entry of record.paths) {\n1289:     const target = path.join(root, entry.path);\n1290:     if (!entry.existed) {\n1291:       if (fs.existsSync(target)) {\n1292:         fs.rmSync(target);\n1293:         deleted.add(entry.path);\n1294:       }\n1295:       continue;\n1296:     }\n1297:     const source = path.join(dir, entry.backup);\n1298:     fs.mkdirSync(path.dirname(target), { recursive: true });\n1299:     fs.copyFileSync(source, target);\n1300:     restored += 1;\n1301:   }\n1302:   removeCreatedDirs(root, record.paths, deleted);\n1303:   output.warn(`${TAG} restored: ${restored} file(s) from ${dir}`);\n1304:   return restored;\n1305: }\n1306: \n1307: function commandApply(options, output, hooks) {\n1308:   if (!options.digest) {\n1309:     output.warn(`${TAG} ERROR: apply needs --plan-digest, the digest the plan printed; nothing was written`);\n1310:     return 2;\n1311:   }\n1312: \n1313:   const manifest = loadManifest();\n1314:   const composition = compose({ root: options.root, manifest, keepClaudeMd: options.keepClaudeMd, createRouter: options.createRouter });\n1315: \n1316:   // A tree already in its target state has nothing a digest could authorise.\n1317:   if (composition.writes.length === 0) {\n1318:     output.log(`${TAG} apply on ${composition.root} (state: ${composition.state})`);\n1319:     output.log('NOTHING TO DO');\n1320:     return 0;\n1321:   }\n1322: \n1323:   const plan = planFor(composition);\n1324:   if (plan.digest !== options.digest) {\n1325:     // The digest also names the backup directory, so an operator replaying a plan whose run\n1326:     // already happened gets told which directory holds those bytes instead of a claim\n1327:     // about the tree that would be false.\n1328:     const held = backupDirectoryOf(plan.base, options.digest);\n1329:     if (fs.existsSync(held)) {\n1330:       output.warn(`${TAG} ERROR: the plan digest ${options.digest} names the backup ${held}, which an earlier run already holds; nothing was written. Plan again for a directory of its own`);\n1331:       return 2;\n1332:     }\n1333:     output.warn(`${TAG} ERROR: the plan digest ${options.digest} does not match the composition now (${plan.digest}); the tree changed since the plan, so nothing was written`);\n1334:     return 2;\n1335:   }\n1336: \n1337:   // The same proof the plan ran, because a composition that already loses a line must\n1338:   // never reach a backup, let alone the tree.\n1339:   const checked = preflight(composition, manifest);\n1340:   composition.ledger.dropped = checked.dropped.length;\n1341:   if (checked.dropped.length > 0) {\n1342:     for (const line of renderDropped(checked.dropped)) output.warn(line);\n1343:     output.warn(`${TAG} the composition drops ${checked.dropped.length} line(s); nothing was written`);\n1344:     output.warn('STATUS=FAIL');\n1345:     return 1;\n1346:   }\n1347: \n1348:   // Every path is resolved before the first byte, so a path outside the allowlist stops\n1349:   // the run before a backup exists rather than after a partial write.\n1350:   const targets = [];\n1351:   for (const file of composition.writes) targets.push({ file, absolute: assertWritable(options.root, file.path) });\n1352: \n1353:   // A dry run is the same plan the operator would give a yes to, minus the write: it stops\n1354:   // here, where every precondition has already passed and nothing has been created.\n1355:   if (options.dryRun) {\n1356:     for (const line of renderPlan(composition, plan)) output.log(line);\n1357:     output.log('dry-run: nothing was written');\n1358:     return 0;\n1359:   }\n1360: \n1361:   const record = writeBackup({ root: options.root, manifest, composition, plan });\n1362:   output.log(`${TAG} apply on ${composition.root} (state: ${composition.state})`);\n1363: \n1364:   const write = hooks.write || ((file, content) => fs.writeFileSync(file, content, 'utf8'));\n1365:   for (const target of targets) {\n1366:     if (target.file.action === 'remove') {\n1367:       if (fs.existsSync(target.absolute)) fs.rmSync(target.absolute);\n1368:       output.log(`removed ${target.file.path} (backed up first)`);\n1369:       continue;\n1370:     }\n1371:     fs.mkdirSync(path.dirname(target.absolute), { recursive: true });\n1372:     write(target.absolute, target.file.content);\n1373:     output.log(`wrote ${target.file.path}`);\n1374:   }\n1375: \n1376:   // The pointer block belongs to its generator, and the router verdict to its checker.\n1377:   const rootTouched = composition.writes.some((file) => file.path === manifest.root_file);\n1378:   if (rootTouched) {\n1379:     const wrote = runTool(POINTER_SYNC, ['--root', options.root]);\n1380:     const checkedPointer = runTool(POINTER_SYNC, ['--check', '--root', options.root]);\n1381:     output.log(`pointer-sync: ${checkedPointer.code === 0 ? 'in sync' : `exit ${checkedPointer.code}`}${wrote.output.length > 0 ? ` (${wrote.output.join('; ')})` : ''}`);\n1382:   }\n1383:   if (composition.writes.some((file) => file.path === manifest.router_file)) {\n1384:     const router = runTool(REPO_RULES_CHECKER, ['--root', options.root]);\n1385:     const summary = router.output.find((line) => line.includes(REPO_RULES_TAG) && line.includes('RESULT:')) || router.output[router.output.length - 1] || '';\n1386:     output.log(`repo-rules: ${summary}`);\n1387:   }\n1388: \n1389:   // The proof runs against the bytes on disk, never against the bytes still in memory.\n1390:   const rootPath = path.join(options.root, manifest.root_file);\n1391:   const onDisk = fs.existsSync(rootPath) ? fs.readFileSync(rootPath, 'utf8') : '';\n1392:   const after = preservationCheck(composition.oldText, onDisk, manifest, { removed: composition.removedCopies });\n1393:   const report = buildReport({ root: options.root, manifestPath: MANIFEST_PATH });\n1394: \n1395:   if (after.dropped.length > 0) {\n1396:     for (const line of renderDropped(after.dropped)) output.warn(line);\n1397:     restoreFromBackup({ root: options.root, dir: plan.dir, output });\n1398:     output.warn(`${TAG} the write dropped ${after.dropped.length} line(s), so the run was undone; the backup is kept at ${plan.dir}`);\n1399:     output.warn('STATUS=FAIL');\n1400:     return 1;\n1401:   }\n1402: \n1403:   output.log(`preservation: kept ${composition.ledger.kept}, carried ${composition.ledger.carried}, shipped-replaced ${composition.ledger.shippedReplaced}, dropped ${after.dropped.length}`);\n1404:   if (report !== null) {\n1405:     output.log(`check-after: state=${report.state} findings=${report.findings} unknown=${report.unknown}`);\n1406:   }\n1407:   output.log(`backup: ${plan.dir}`);\n1408:   output.log(`undo: ${undoCommand(plan.dir, options.root)}`);\n1409:   for (const entry of record.paths) {\n1410:     if (!entry.existed) continue;\n1411:     output.log(`cp ${path.join(plan.dir, entry.backup)} ${entry.path}`);\n1412:   }\n1413:   output.log('STATUS=OK');\n1414:   return 0;\n1415: }\n1416: \n1417: // ─────────────────────────────────────────────────────────────────────────────\n1418: // 17. RESTORE\n1419: // ─────────────────────────────────────────────────────────────────────────────\n1420: \n1421: function readConfirmation() {\n1422:   try {\n1423:     return fs.readFileSync(0, 'utf8').split('\\n')[0].trim();\n1424:   } catch {\n1425:     return '';\n1426:   }\n1427: }\n1428: \n1429: function commandRestore(options, output, hooks) {\n1430:   if (!options.run) {\n1431:     output.warn(`${TAG} ERROR: restore needs --run=<dir>, the backup directory a run printed`);\n1432:     return 2;\n1433:   }\n1434:   const recordPath = path.join(options.run, 'manifest.json');\n1435:   if (!fs.existsSync(recordPath)) {\n1436:     output.warn(`${TAG} ERROR: no manifest.json under ${options.run}, so there is nothing recorded to put back`);\n1437:     return 2;\n1438:   }\n1439: \n1440:   const record = JSON.parse(fs.readFileSync(recordPath, 'utf8'));\n1441:   const root = record.root;\n1442:   // The record names its own root, and a record is data: it is trusted only when it names\n1443:   // the root this restore runs against, so a record repointed at another folder is refused\n1444:   // instead of written to. Restoring another folder takes --root naming that folder.\n1445:   if (typeof root !== 'string' || !sameDirectory(root, options.root)) {\n1446:     output.warn(`${TAG} ERROR: the record names the root ${root}, and this restore runs against ${options.root}; pass --root ${root} to restore that folder. Nothing was written`);\n1447:     return 2;\n1448:   }\n1449:   const steps = [];\n1450:   for (const entry of record.paths) {\n1451:     // A record is data, and data can be wrong: the same allowlist decides what it may\n1452:     // touch, so a hand-edited record cannot turn a restore into an arbitrary write.\n1453:     const absolute = assertWritable(root, entry.path);\n1454:     if (!entry.existed) {\n1455:       steps.push({ entry, absolute, action: fs.existsSync(absolute) ? 'delete' : 'absent' });\n1456:       continue;\n1457:     }\n1458:     const source = path.join(options.run, entry.backup);\n1459:     if (!fs.existsSync(source)) {\n1460:       output.warn(`${TAG} ERROR: the backup of ${entry.path} is missing at ${source}; nothing was written`);\n1461:       return 2;\n1462:     }\n1463:     const bytes = fs.readFileSync(source);\n1464:     if (sha256(bytes.toString('utf8')) !== entry.sha256) {\n1465:       output.warn(`${TAG} ERROR: the backup copy of ${entry.path} does not match its recorded hash; nothing was written`);\n1466:       return 2;\n1467:     }\n1468:     steps.push({ entry, absolute, action: 'put back', bytes });\n1469:   }\n1470: \n1471:   output.log(`${TAG} restore plan for ${root} from ${options.run}`);\n1472:   for (const step of steps) {\n1473:     const note = step.action === 'delete' && step.entry.path === 'AGENTS.md'\n1474:       ? ' (this run created it; without it Gate 3 no longer detects this directory as a workspace root)'\n1475:       : '';\n1476:     output.log(`restore ${step.entry.path}: ${step.action}${note}`);\n1477:   }\n1478:   const createdDirs = new Set(steps.flatMap((step) => (step.action === 'delete' ? recordedCreatedDirs(step.entry) : [])));\n1479:   for (const dir of createdDirs) output.log(`restore ${dir}/: remove if empty (this run created it)`);\n1480: \n1481:   if (options.dryRun) {\n1482:     output.log('dry-run: nothing was written');\n1483:     return 0;\n1484:   }\n1485: \n1486:   if (!options.yes) {\n1487:     output.log(`type yes to put ${steps.length} path(s) back:`);\n1488:     if (readConfirmation() !== 'yes') {\n1489:       output.log('cancelled: no confirmation, nothing was written');\n1490:       return 1;\n1491:     }\n1492:   }\n1493: \n1494:   let touched = 0;\n1495:   const deleted = new Set();\n1496:   for (const step of steps) {\n1497:     if (step.action === 'delete') {\n1498:       fs.rmSync(step.absolute);\n1499:       deleted.add(step.entry.path);\n1500:       touched += 1;\n1501:       continue;\n1502:     }\n1503:     if (step.action === 'absent') continue;\n1504:     fs.mkdirSync(path.dirname(step.absolute), { recursive: true });\n1505:     fs.writeFileSync(step.absolute, step.bytes);\n1506:     touched += 1;\n1507:   }\n1508:   for (const dir of removeCreatedDirs(root, record.paths, deleted)) output.log(`restore ${dir}/: removed the empty folder this run created`);\n1509: \n1510:   // Byte equality after the write, measured against the recorded hash rather than against\n1511:   // the copy that was just read.\n1512:   for (const step of steps) {\n1513:     if (step.action === 'delete' || step.action === 'absent') continue;\n1514:     if (sha256(fs.readFileSync(step.absolute, 'utf8')) !== step.entry.sha256) {\n1515:       output.warn(`${TAG} ERROR: ${step.entry.path} does not match its recorded hash after the restore`);\n1516:       output.warn('STATUS=FAIL');\n1517:       return 1;\n1518:     }\n1519:   }\n1520: \n1521:   output.log(`restore: ${touched} path(s) put back, the backup at ${options.run} is kept`);\n1522:   output.log('STATUS=OK');\n1523:   return 0;\n1524: }\n1525: \n1526: // ─────────────────────────────────────────────────────────────────────────────\n1527: // 18. MAIN\n1528: // ─────────────────────────────────────────────────────────────────────────────\n1529: \n1530: function outputOf(hooks) {\n1531:   return {\n1532:     log: typeof hooks.log === 'function' ? hooks.log : (line) => console.log(line),\n1533:     warn: typeof hooks.warn === 'function' ? hooks.warn : (line) => console.error(line),\n1534:   };\n1535: }\n1536: \n1537: /**\n1538:  * @param {string[]} argv\n1539:  * @param {{log?: Function, warn?: Function, write?: Function}} [hooks]\n1540:  * @returns {number} the process exit code\n1541:  */\n1542: function main(argv, hooks = {}) {\n1543:   const options = parseArgs(argv);\n1544:   const output = outputOf(hooks);\n1545:   if (options.help) {\n1546:     output.log(USAGE);\n1547:     return 0;\n1548:   }\n1549:   if (options.command === null) {\n1550:     output.warn(`${TAG} ERROR: one of plan, apply or restore is required\\n${USAGE}`);\n1551:     return 2;\n1552:   }\n1553:   if (!fs.existsSync(options.root) || !fs.statSync(options.root).isDirectory()) {\n1554:     output.warn(`${TAG} ERROR: the target root is not a directory: ${options.root}`);\n1555:     return 2;\n1556:   }\n1557: \n1558:   try {\n1559:     if (options.command === 'plan') return commandPlan(options, output, hooks);\n1560:     if (options.command === 'apply') return commandApply(options, output, hooks);\n1561:     return commandRestore(options, output, hooks);\n1562:   } catch (error) {\n1563:     if (error instanceof AllowlistError) {\n1564:       output.warn(`${TAG} ERROR: ${error.message}; nothing was written`);\n1565:       return 2;\n1566:     }\n1567:     if (error instanceof PreconditionError || error instanceof UsageError) {\n1568:       output.warn(`${TAG} ERROR: ${error.message}`);\n1569:       if (error instanceof UsageError) output.warn(USAGE);\n1570:       return 2;\n1571:     }\n1572:     throw error;\n1573:   }\n1574: }\n1575: \n1576: if (require.main === module) {\n1577:   try {\n1578:     process.exitCode = main(process.argv.slice(2));\n1579:   } catch (error) {\n1580:     console.error(`${TAG} ERROR: ${error.message}`);\n1581:     process.exitCode = 2;\n1582:   }\n1583: }\n1584: \n1585: module.exports = {\n1586:   ALLOWLIST,\n1587:   MANIFEST_PATH,\n1588:   addRouterRows,\n1589:   assertWritable,\n1590:   backupBase,\n1591:   compose,\n1592:   main,\n1593:   planDigest,\n1594:   planFor,\n1595:   preservationCheck,\n1596:   renderBlock,\n1597:   renderMirror,\n1598:   renderRouter,\n1599: };"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"offset\": 821, \"path\": \".skilled/commands/doctor/scripts/agents-md-embed.cjs\"}"},"time":{"start":1794550375827,"end":1794550375910}}}}
{"type":"step_finish","timestamp":1794550377689,"sessionID":"ses_e2c799ae9ffehgaY2UX9uAVWD2","part":{"id":"prt_1d389acd8001chCOiN7Ig0Y8s9","sessionID":"ses_e2c799ae9ffehgaY2UX9uAVWD2","messageID":"msg_1d3899cb20013gnUtkJmhtoF53","type":"step-finish","reason":"tool-calls","snapshot":"87a09e97f8637987f75b85be232f8e0a66649a0d","cost":0,"tokens":{"input":11251,"output":68,"reasoning":8,"cache":{"read":113664,"write":0}}}}
{"type":"step_start","timestamp":1794550379251,"sessionID":"ses_e2c799ae9ffehgaY2UX9uAVWD2","part":{"id":"prt_1d389b2f3001W1HWTalZjGrKBt","sessionID":"ses_e2c799ae9ffehgaY2UX9uAVWD2","messageID":"msg_1d389acde001AKg242lkZ49Wo1","type":"step-start","snapshot":"87a09e97f8637987f75b85be232f8e0a66649a0d"}}
{"type":"tool_use","timestamp":1794550392712,"sessionID":"ses_e2c799ae9ffehgaY2UX9uAVWD2","part":{"partID":"prt_1d389e62b001lNqRccawN62ZIF","sessionID":"ses_e2c799ae9ffehgaY2UX9uAVWD2","messageID":"msg_1d389acde001AKg242lkZ49Wo1","type":"tool","id":"call_01_bKVbYeUyMyTJcNvBfR2S9412","tool":"shell","state":{"status":"completed","input":{"command":"cd /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research && sed -n '1,120p' .skilled/commands/doctor/scripts/tests/doctor-install-contract.test.cjs"},"output":"#!/usr/bin/env node\n// ───────────────────────────────────────────────────────────────────\n// MODULE: Doctor Install Contract Tests\n// ───────────────────────────────────────────────────────────────────\n\n'use strict';\n\n// ─────────────────────────────────────────────────────────────────────────────\n// 1. IMPORTS AND FIXTURES\n// ─────────────────────────────────────────────────────────────────────────────\n\nconst assert = require('node:assert/strict');\nconst fs = require('node:fs');\nconst path = require('node:path');\nconst test = require('node:test');\nconst { parse: parseYaml } = require('yaml');\n\nconst DOCTOR = path.resolve(__dirname, '..', '..');\nconst ASSETS = path.join(DOCTOR, 'assets');\nconst CONTRACT_ASSETS = path.resolve(DOCTOR, '..', '..', 'skills', 'sk-doc', 'sk-create-command', 'assets');\n\nconst read = (file) => fs.readFileSync(file, 'utf8');\n\nconst MANIFEST = parseYaml(read(path.join(DOCTOR, '_routes.yaml')));\nconst ROUTES = MANIFEST.routes.filter((route) => route.command === '/doctor:install');\nconst installRoute = () => ROUTES[0];\n\nconst ROUTER = read(path.join(DOCTOR, 'install.md'));\nconst PRESENTATION = read(path.join(ASSETS, 'doctor-install-presentation.txt'));\nconst WORKFLOW_TEXT = read(path.join(ASSETS, 'doctor-install.yaml'));\nconst WORKFLOW = parseYaml(WORKFLOW_TEXT);\n// The install guide's frozen interface lives here rather than in a planning document, so the\n// test keeps running wherever the planning notes move.\nconst INSTALL_PHRASES = [\n  'install skilled into my project',\n  'set up skilled in another repo',\n  'use skilled in my own project',\n  'onboard a project repo to skilled',\n  'guide me through installing skilled',\n  'walk me through a first install of skilled',\n  'first install of skilled in my project',\n  'skilled in my other repository',\n  'skilled in another repository',\n];\nconst WORKFLOW_STEP_NAMES = ['Locate', 'Ask', 'Inspect', 'Checklist', 'Warn'];\nconst SAVE_CAVEAT = 'context saves land in the target repo\\'s own specs/ when they run from inside it, so run /doctor:setup and later saves from inside the target repo, not from the Skilled checkout.';\n\nconst CONTRACT = JSON.parse(read(path.join(CONTRACT_ASSETS, 'command-contract.json')));\nconst SCHEMA = JSON.parse(read(path.join(CONTRACT_ASSETS, 'command-contract.schema.json')));\nconst DOCTOR_CONTRACT = CONTRACT.families.doctor;\nconst FAMILY_SCHEMA = SCHEMA.definitions.familyContract;\n\nconst WORKFLOW_ASSET = 'doctor-install.yaml';\nconst PRESENTATION_ASSET = 'doctor-install-presentation.txt';\nconst ENGINE = '.skilled/commands/doctor/scripts/symlink-engine.cjs';\n\nconst CHECKLIST_STEPS = [\n  {\n    command: '/doctor:symlink link --root <dir> --runtimes <list> --mode <shape>',\n    owner: '/doctor:symlink',\n    target: 'link',\n    mutating: 'mutates',\n  },\n  {\n    command: '/doctor:agents-md embed --root <dir>',\n    owner: '/doctor:agents-md',\n    target: 'embed',\n    mutating: 'mutates',\n  },\n  {\n    command: '/doctor:mcp install',\n    owner: '/doctor:mcp',\n    target: 'install',\n    mutating: 'mutates',\n  },\n  {\n    command: '/doctor:git setup',\n    owner: '/doctor:git',\n    target: 'setup',\n    mutating: 'read-only',\n  },\n  {\n    command: '/doctor:skill-advisor embedder',\n    owner: '/doctor:skill-advisor',\n    target: 'embedder',\n    mutating: 'mutates',\n  },\n  {\n    command: '/doctor:setup',\n    owner: '/doctor:setup',\n    target: 'setup',\n    mutating: 'read-only',\n  },\n];\n\nfunction checklistOwner(step) {\n  if (step.owner === '/doctor:mcp') {\n    return MANIFEST.mcp_subroutes.find((route) => route.sub_action === step.target);\n  }\n  return MANIFEST.routes.find((route) => route.command === step.owner && route.target === step.target);\n}\n\n// ─────────────────────────────────────────────────────────────────────────────\n// 2. THE ROUTE\n// ─────────────────────────────────────────────────────────────────────────────\n\ntest('the manifest holds one read-only install route matching the frozen contract', () => {\n  assert.equal(ROUTES.length, 1, '/doctor:install must own exactly one route');\n  const route = installRoute();\n  assert.equal(route.target, 'guide');\n  assert.equal(route.mutating, 'read-only');\n  assert.match(route.gate3_location, /^n\\/a/);\n  assert.equal(route.default_target, undefined);\n  assert.equal(route.yaml, WORKFLOW_ASSET);\n  assert.ok(fs.existsSync(path.join(ASSETS, route.yaml)), route.yaml);\n  assert.deepEqual(route.allowed_flags, ['--json', '--root <dir>', '--runtimes <list>']);\n  assert.deepEqual(route.setup_vars, ['execution_mode', 'root', 'runtimes', 'json_output']);\n  assert.deepEqual(route.mcp_tools, []);\n});\n\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"#!/usr/bin/env node\n// ───────────────────────────────────────────────────────────────────\n// MODULE: Doctor Install Contract Tests\n// ───────────────────────────────────────────────────────────────────\n\n'use strict';\n\n// ─────────────────────────────────────────────────────────────────────────────\n// 1. IMPORTS AND FIXTURES\n// ─────────────────────────────────────────────────────────────────────────────\n\nconst assert = require('node:assert/strict');\nconst fs = require('node:fs');\nconst path = require('node:path');\nconst test = require('node:test');\nconst { parse: parseYaml } = require('yaml');\n\nconst DOCTOR = path.resolve(__dirname, '..', '..');\nconst ASSETS = path.join(DOCTOR, 'assets');\nconst CONTRACT_ASSETS = path.resolve(DOCTOR, '..', '..', 'skills', 'sk-doc', 'sk-create-command', 'assets');\n\nconst read = (file) => fs.readFileSync(file, 'utf8');\n\nconst MANIFEST = parseYaml(read(path.join(DOCTOR, '_routes.yaml')));\nconst ROUTES = MANIFEST.routes.filter((route) => route.command === '/doctor:install');\nconst installRoute = () => ROUTES[0];\n\nconst ROUTER = read(path.join(DOCTOR, 'install.md'));\nconst PRESENTATION = read(path.join(ASSETS, 'doctor-install-presentation.txt'));\nconst WORKFLOW_TEXT = read(path.join(ASSETS, 'doctor-install.yaml'));\nconst WORKFLOW = parseYaml(WORKFLOW_TEXT);\n// The install guide's frozen interface lives here rather than in a planning document, so the\n// test keeps running wherever the planning notes move.\nconst INSTALL_PHRASES = [\n  'install skilled into my project',\n  'set up skilled in another repo',\n  'use skilled in my own project',\n  'onboard a project repo to skilled',\n  'guide me through installing skilled',\n  'walk me through a first install of skilled',\n  'first install of skilled in my project',\n  'skilled in my other repository',\n  'skilled in another repository',\n];\nconst WORKFLOW_STEP_NAMES = ['Locate', 'Ask', 'Inspect', 'Checklist', 'Warn'];\nconst SAVE_CAVEAT = 'context saves land in the target repo\\'s own specs/ when they run from inside it, so run /doctor:setup and later saves from inside the target repo, not from the Skilled checkout.';\n\nconst CONTRACT = JSON.parse(read(path.join(CONTRACT_ASSETS, 'command-contract.json')));\nconst SCHEMA = JSON.parse(read(path.join(CONTRACT_ASSETS, 'command-contract.schema.json')));\nconst DOCTOR_CONTRACT = CONTRACT.families.doctor;\nconst FAMILY_SCHEMA = SCHEMA.definitions.familyContract;\n\nconst WORKFLOW_ASSET = 'doctor-install.yaml';\nconst PRESENTATION_ASSET = 'doctor-install-presentation.txt';\nconst ENGINE = '.skilled/commands/doctor/scripts/symlink-engine.cjs';\n\nconst CHECKLIST_STEPS = [\n  {\n    command: '/doctor:symlink link --root <dir> --runtimes <list> --mode <shape>',\n    owner: '/doctor:symlink',\n    target: 'link',\n    mutating: 'mutates',\n  },\n  {\n    command: '/doctor:agents-md embed --root <dir>',\n    owner: '/doctor:agents-md',\n    target: 'embed',\n    mutating: 'mutates',\n  },\n  {\n    command: '/doctor:mcp install',\n    owner: '/doctor:mcp',\n    target: 'install',\n    mutating: 'mutates',\n  },\n  {\n    command: '/doctor:git setup',\n    owner: '/doctor:git',\n    target: 'setup',\n    mutating: 'read-only',\n  },\n  {\n    command: '/doctor:skill-advisor embedder',\n    owner: '/doctor:skill-advisor',\n    target: 'embedder',\n    mutating: 'mutates',\n  },\n  {\n    command: '/doctor:setup',\n    owner: '/doctor:setup',\n    target: 'setup',\n    mutating: 'read-only',\n  },\n];\n\nfunction checklistOwner(step) {\n  if (step.owner === '/doctor:mcp') {\n    return MANIFEST.mcp_subroutes.find((route) => route.sub_action === step.target);\n  }\n  return MANIFEST.routes.find((route) => route.command === step.owner && route.target === step.target);\n}\n\n// ─────────────────────────────────────────────────────────────────────────────\n// 2. THE ROUTE\n// ─────────────────────────────────────────────────────────────────────────────\n\ntest('the manifest holds one read-only install route matching the frozen contract', () => {\n  assert.equal(ROUTES.length, 1, '/doctor:install must own exactly one route');\n  const route = installRoute();\n  assert.equal(route.target, 'guide');\n  assert.equal(route.mutating, 'read-only');\n  assert.match(route.gate3_location, /^n\\/a/);\n  assert.equal(route.default_target, undefined);\n  assert.equal(route.yaml, WORKFLOW_ASSET);\n  assert.ok(fs.existsSync(path.join(ASSETS, route.yaml)), route.yaml);\n  assert.deepEqual(route.allowed_flags, ['--json', '--root <dir>', '--runtimes <list>']);\n  assert.deepEqual(route.setup_vars, ['execution_mode', 'root', 'runtimes', 'json_output']);\n  assert.deepEqual(route.mcp_tools, []);\n});\n\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\": \"cd /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research && sed -n '1,120p' .skilled/commands/doctor/scripts/tests/doctor-install-contract.test.cjs\"}"},"time":{"start":1794550392363,"end":1794550392712}}}}
{"type":"tool_use","timestamp":1794550392721,"sessionID":"ses_e2c799ae9ffehgaY2UX9uAVWD2","part":{"partID":"prt_1d389e473002JOeZB8RzuFKV1b","sessionID":"ses_e2c799ae9ffehgaY2UX9uAVWD2","messageID":"msg_1d389acde001AKg242lkZ49Wo1","type":"tool","id":"call_00_KGLs1XQRncj9xNDpllz23630","tool":"shell","state":{"status":"completed","input":{"command":"cd /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research && rg -n \"symlink|codex/AGENTS|every line|namesRoot|pointer\" .skilled/commands/doctor/scripts/tests/agents-md-check.test.cjs | head -40; echo \"=== embed tests\"; rg -n \"codex/AGENTS|symlink|foreign|restore|rollback\" .skilled/commands/doctor/scripts/tests/agents-md-embed.test.cjs | head -40"},"output":"52:  '.skilled/skills/system-spec-kit/runtime/cli/runtime-mirrors/sync-gate1-pointers.cjs',\n321:// A body can carry every line the shipped body carries and still not be it: one extra\n460:test('A10 reports a pointer-only CLAUDE.md and an absent .codex/AGENTS.md without a finding', (t) => {\n471:  assert.equal(claude.kind, 'pointer');\n473:  const codex = copies.entries.find((entry) => entry.path === '.codex/AGENTS.md');\n481:test('a pure tree with no CLAUDE.md reports a missing pointer and keeps A10 a pass', (t) => {\n485:  assert.equal(mirrors.status, 0, `the pointer sync completes the fixture's mirrors: ${mirrors.stderr}`);\n490:  assert.equal(claude.kind, 'pointer missing');\n493:  assert.ok(copies.lines.some((line) => line.startsWith('CLAUDE.md: pointer missing')),\n494:    `the missing pointer is printed, not only recorded: ${JSON.stringify(copies.lines)}`);\n503:    tools: { pointerSync: path.join(fixture.dir, 'no-such-pointer-sync.cjs') },\n563:    'copyFileSync', 'renameSync', 'symlinkSync', 'linkSync', 'truncateSync', 'chmodSync',\n=== embed tests\n19:// The backup the engine leaves behind is the rollback, so the engine never deletes it.\n341:  const restore = spyOnWrites(writes);\n346:    restore();\n395:  assert.deepEqual(clean.foreign, []);\n419:  const foreign = embed.preservationCheck(compose(''), `A line above the block.\\n${compose('')}`, manifest);\n420:  assert.deepEqual(foreign.foreign.map((entry) => entry.line), ['A line above the block.']);\n427:test('the foreign shape keeps its whole original document inside the block', (t) => {\n428:  const dir = composeTree(t, 'foreign');\n448:  assert.deepEqual(checked.foreign, []);\n474:  assert.deepEqual(checked.foreign, []);\n515:  assert.deepEqual(checked.foreign, []);\n537:  assert.deepEqual(checked.foreign, []);\n560:  assert.deepEqual(checked.foreign, []);\n587:test('a planted drop restores the backup and ends STATUS=FAIL', (t) => {\n588:  const dir = composeTree(t, 'foreign');\n611:  assert.match(text, /restored/u);\n615:test('restore puts every recorded file back byte for byte', (t) => {\n616:  const dir = composeTree(t, 'foreign');\n625:  const restored = run([`restore`, `--run=${backup}`, '--root', dir], { input: 'yes\\n' });\n626:  assert.equal(restored.code, 0, `${restored.err}${restored.out}`);\n627:  assert.match(restored.out, /restore: /u);\n629:  assert.ok(fs.existsSync(backup), 'the restore keeps the backup');\n632:test('restore recreates a removed file and deletes a file the run created', (t) => {\n641:  const restored = run(['restore', `--run=${backup}`, '--root', dir], { input: 'yes\\n' });\n642:  assert.equal(restored.code, 0, `${restored.err}${restored.out}`);\n647:test('restore removes the folders a run created and keeps a folder that was already there', (t) => {\n651:  const freshRestored = run(['restore', `--run=${trackBackup(t, freshApplied.out)}`, '--root', fresh], { input: 'yes\\n' });\n653:  assert.equal(existsInside(fresh, '.cursor'), false, 'a folder the run created is gone after the restore');\n659:  const keptRestored = run(['restore', `--run=${trackBackup(t, keptApplied.out)}`, '--root', kept], { input: 'yes\\n' });\n665:test('restore refuses a record whose root is not the one it runs against', (t) => {\n666:  const dir = composeTree(t, 'foreign');\n672:  const other = composeTree(t, 'foreign');\n678:  const repointed = run(['restore', `--run=${backup}`, '--root', dir], { input: 'yes\\n' });\n684:  const unnamed = run(['restore', `--run=${backup}`], { input: 'yes\\n' });\n685:  assert.equal(unnamed.code, 2, 'a restore of another root without --root is refused');\n688:test('restore cancels without a yes', (t) => {\n689:  const dir = composeTree(t, 'foreign');\n694:  const cancelled = run(['restore', `--run=${backup}`, '--root', dir], { input: 'no\\n' });\n695:  assert.equal(cancelled.code, 1, 'a cancelled restore is not a completed one');\n697:  assert.equal(treeDigest(dir), afterApply, 'a cancelled restore writes nothing');\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"52:  '.skilled/skills/system-spec-kit/runtime/cli/runtime-mirrors/sync-gate1-pointers.cjs',\n321:// A body can carry every line the shipped body carries and still not be it: one extra\n460:test('A10 reports a pointer-only CLAUDE.md and an absent .codex/AGENTS.md without a finding', (t) => {\n471:  assert.equal(claude.kind, 'pointer');\n473:  const codex = copies.entries.find((entry) => entry.path === '.codex/AGENTS.md');\n481:test('a pure tree with no CLAUDE.md reports a missing pointer and keeps A10 a pass', (t) => {\n485:  assert.equal(mirrors.status, 0, `the pointer sync completes the fixture's mirrors: ${mirrors.stderr}`);\n490:  assert.equal(claude.kind, 'pointer missing');\n493:  assert.ok(copies.lines.some((line) => line.startsWith('CLAUDE.md: pointer missing')),\n494:    `the missing pointer is printed, not only recorded: ${JSON.stringify(copies.lines)}`);\n503:    tools: { pointerSync: path.join(fixture.dir, 'no-such-pointer-sync.cjs') },\n563:    'copyFileSync', 'renameSync', 'symlinkSync', 'linkSync', 'truncateSync', 'chmodSync',\n=== embed tests\n19:// The backup the engine leaves behind is the rollback, so the engine never deletes it.\n341:  const restore = spyOnWrites(writes);\n346:    restore();\n395:  assert.deepEqual(clean.foreign, []);\n419:  const foreign = embed.preservationCheck(compose(''), `A line above the block.\\n${compose('')}`, manifest);\n420:  assert.deepEqual(foreign.foreign.map((entry) => entry.line), ['A line above the block.']);\n427:test('the foreign shape keeps its whole original document inside the block', (t) => {\n428:  const dir = composeTree(t, 'foreign');\n448:  assert.deepEqual(checked.foreign, []);\n474:  assert.deepEqual(checked.foreign, []);\n515:  assert.deepEqual(checked.foreign, []);\n537:  assert.deepEqual(checked.foreign, []);\n560:  assert.deepEqual(checked.foreign, []);\n587:test('a planted drop restores the backup and ends STATUS=FAIL', (t) => {\n588:  const dir = composeTree(t, 'foreign');\n611:  assert.match(text, /restored/u);\n615:test('restore puts every recorded file back byte for byte', (t) => {\n616:  const dir = composeTree(t, 'foreign');\n625:  const restored = run([`restore`, `--run=${backup}`, '--root', dir], { input: 'yes\\n' });\n626:  assert.equal(restored.code, 0, `${restored.err}${restored.out}`);\n627:  assert.match(restored.out, /restore: /u);\n629:  assert.ok(fs.existsSync(backup), 'the restore keeps the backup');\n632:test('restore recreates a removed file and deletes a file the run created', (t) => {\n641:  const restored = run(['restore', `--run=${backup}`, '--root', dir], { input: 'yes\\n' });\n642:  assert.equal(restored.code, 0, `${restored.err}${restored.out}`);\n647:test('restore removes the folders a run created and keeps a folder that was already there', (t) => {\n651:  const freshRestored = run(['restore', `--run=${trackBackup(t, freshApplied.out)}`, '--root', fresh], { input: 'yes\\n' });\n653:  assert.equal(existsInside(fresh, '.cursor'), false, 'a folder the run created is gone after the restore');\n659:  const keptRestored = run(['restore', `--run=${trackBackup(t, keptApplied.out)}`, '--root', kept], { input: 'yes\\n' });\n665:test('restore refuses a record whose root is not the one it runs against', (t) => {\n666:  const dir = composeTree(t, 'foreign');\n672:  const other = composeTree(t, 'foreign');\n678:  const repointed = run(['restore', `--run=${backup}`, '--root', dir], { input: 'yes\\n' });\n684:  const unnamed = run(['restore', `--run=${backup}`], { input: 'yes\\n' });\n685:  assert.equal(unnamed.code, 2, 'a restore of another root without --root is refused');\n688:test('restore cancels without a yes', (t) => {\n689:  const dir = composeTree(t, 'foreign');\n694:  const cancelled = run(['restore', `--run=${backup}`, '--root', dir], { input: 'no\\n' });\n695:  assert.equal(cancelled.code, 1, 'a cancelled restore is not a completed one');\n697:  assert.equal(treeDigest(dir), afterApply, 'a cancelled restore writes nothing');\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\": \"cd /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research && rg -n \\\"symlink|codex/AGENTS|every line|namesRoot|pointer\\\" .skilled/commands/doctor/scripts/tests/agents-md-check.test.cjs | head -40; echo \\\"=== embed tests\\\"; rg -n \\\"codex/AGENTS|symlink|foreign|restore|rollback\\\" .skilled/commands/doctor/scripts/tests/agents-md-embed.test.cjs | head -40\"}"},"time":{"start":1794550391923,"end":1794550392721}}}}
