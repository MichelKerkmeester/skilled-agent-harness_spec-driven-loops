ot <dir>\", \"--runtimes <list>\", \"--include <list>\", \"--link-instructions\"]\n/doctor:symlink | target: link | mutating: mutates | yaml: doctor-symlink-link.yaml | allowed_flags: [\"--root <dir>\", \"--runtimes <list>\", \"--mode <shape>\", \"--include <list>\", \"--link-instructions\", \"--ignore <where>\", \"--dry-run\", \"--plan-digest <digest>\"]\n/doctor:install | target: guide | mutating: read-only | yaml: doctor-install.yaml | allowed_flags: [\"--json\", \"--root <dir>\", \"--runtimes <list>\"]\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"/doctor:setup | target: setup | mutating: read-only | yaml: doctor-setup.yaml | allowed_flags: []\n/doctor:agents-md | target: check | mutating: read-only | yaml: doctor-agents-md-check.yaml | allowed_flags: [\"--json\", \"--root <dir>\"]\n/doctor:agents-md | target: embed | mutating: mutates | yaml: doctor-agents-md-embed.yaml | allowed_flags: [\"--dry-run\", \"--root <dir>\", \"--plan-digest <digest>\", \"--keep-claude-md\", \"--remove-claude-md\", \"--create-router\"]\n/doctor:symlink | target: check | mutating: read-only | yaml: doctor-symlink-check.yaml | allowed_flags: [\"--json\", \"--root <dir>\", \"--runtimes <list>\", \"--include <list>\", \"--link-instructions\"]\n/doctor:symlink | target: link | mutating: mutates | yaml: doctor-symlink-link.yaml | allowed_flags: [\"--root <dir>\", \"--runtimes <list>\", \"--mode <shape>\", \"--include <list>\", \"--link-instructions\", \"--ignore <where>\", \"--dry-run\", \"--plan-digest <digest>\"]\n/doctor:install | target: guide | mutating: read-only | yaml: doctor-install.yaml | allowed_flags: [\"--json\", \"--root <dir>\", \"--runtimes <list>\"]\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\": \"cd /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research && node -e '\\nconst fs=require(\\\"fs\\\");\\nconst t=fs.readFileSync(\\\".skilled/commands/doctor/_routes.yaml\\\",\\\"utf8\\\").split(\\\"\\\\n\\\");\\nconst cmds=[\\\"/doctor:install\\\",\\\"/doctor:setup\\\",\\\"/doctor:agents-md\\\",\\\"/doctor:symlink\\\",\\\"/doctor:mcp\\\"];\\nlet i=0;\\nwhile(i<t.length){\\n  const m=/^  - command: (\\\\S+)$/.exec(t[i]);\\n  if(m && cmds.includes(m[1])){\\n    let j=i; const block=[];\\n    while(j<t.length && !(j>i && /^  - command: /.test(t[j]))) { block.push(t[j]); j++; }\\n    const target=block.find(l=>/^    target: /.test(l));\\n    const mut=block.find(l=>/^    mutating: /.test(l));\\n    const yaml=block.find(l=>/^    yaml: /.test(l));\\n    const flags=block.find(l=>/^    allowed_flags: /.test(l));\\n    if(target && /target: (guide|setup|check|embed|link|install)$/.test(target)) console.log(m[1], \\\"|\\\", (target||\\\"\\\").trim(), \\\"|\\\", (mut||\\\"\\\").trim(), \\\"|\\\", (yaml||\\\"\\\").trim(), \\\"|\\\", (flags||\\\"\\\").trim());\\n    i=j; continue;\\n  }\\n  i++;\\n}\\n'\"}"},"time":{"start":1794550541890,"end":1794550543183}}}}
