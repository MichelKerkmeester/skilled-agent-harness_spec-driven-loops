l-advisor\n133-    target: rebuild\n134-    yaml: doctor-skill-advisor-rebuild.yaml\n135-    setup_vars: [execution_mode, dry_run]\n136-    allowed_flags: [\"--dry-run\"]\n137-    mutating: mutates\n138-    gate3_location: \".skilled/skills/system-skill-advisor/runtime/database/skill-graph.sqlite (backed up beside itself before the rebuild)\"\n139-    cli_commands:\n140-      - 'node .skilled/bin/skill-advisor.cjs advisor_status --workspace-root \"$PWD\" --format json --warm-only'\n141-      - 'node .skilled/bin/skill-advisor.cjs advisor_rebuild --trusted --force true --format json'\n142-      - 'node .skilled/bin/skill-advisor.cjs skill_graph_scan --trusted --format json'\n143-      - 'node .skilled/bin/skill-advisor.cjs skill_graph_validate --format json --warm-only'\n144-    mcp_tools: []   # CLI front door only, no MCP calls\n145-    trigger_phrases:\n146-      - \"skill advisor rebuild\"\n--\n152:  - command: /doctor:skill-advisor\n153-    target: skill-budget\n154-    yaml: doctor-skill-budget.yaml\n155-    setup_vars: [execution_mode, json_output, top_n, fail_over, project_ceiling]\n156-    allowed_flags: [\"--json\", \"--top-n=N\", \"--fail-over=N\", \"--project-ceiling=N\"]\n157-    mutating: read-only\n158-    gate3_location: \"n/a (read-only audit; no spec folder required)\"\n159-    mcp_tools: []   # script-only audit; no MCP calls\n160-    script_invocations:\n161-      - 'python3 .skilled/commands/doctor/scripts/audit_descriptions.py --repo-root \"$PWD\"  # description-budget audit. The workflow adds --json, --top-n, --fail-over, and --project-ceiling from the resolved flags'\n162-      - 'Warm-only: probe the existing system-skill-advisor IPC socket first; only when it answers, run node .skilled/bin/skill-advisor.cjs advisor_status --workspace-root \"$PWD\" --format json --timeout-ms 500 --warm-only (the flag guarantees no daemon start; exit 75 = backend unavailable, retryable)'\n163-    trigger_phrases:\n164-      - \"skill budget audit\"\n165-      - \"description budget check\"\n166-      - \"skill char count drift\"\n--\n171:  - command: /doctor:skill-advisor\n172-    target: parent-skill\n173-    yaml: doctor-parent-skill.yaml\n174-    setup_vars: [execution_mode, parent_skill_dir]\n175-    allowed_flags: [\"--dir=<path>\"]\n176-    mutating: read-only\n177-    gate3_location: \"n/a (read-only structural audit; inspects a parent skill's graph-metadata/registry and reports, no writes)\"\n178-    mcp_tools: []   # script-only structural audit; no MCP calls\n179-    script_invocations:\n180-      # The fleet class gate runs first: it starts from SKILL.md, so it is the only\n181-      # check that can report a metadata file a root never wrote. The per-hub audit\n182-      # then goes deep on the one directory the operator named.\n183-      - 'node .skilled/skills/sk-doc/sk-create-skill/scripts/ci-skill-root-metadata.cjs'\n184-      - 'node .skilled/commands/doctor/scripts/parent-skill-check.cjs \"{parent_skill_dir}\"'\n185-    trigger_phrases:\n--\n193:  - command: /doctor:skill-advisor\n194-    target: skill-graph-freshness\n195-    yaml: doctor-skill-graph-freshness.yaml\n196-    setup_vars: [execution_mode]\n197-    allowed_flags: []\n198-    mutating: read-only\n199-    gate3_location: \"n/a (read-only diagnostic; 3-way diffs the skill-graph representations and reports drift, writes nothing)\"\n200-    mcp_tools: []   # script-only read; no MCP calls\n201-    script_invocations:\n202-      - 'node .skilled/commands/doctor/scripts/skill-graph-freshness.cjs'\n203-    trigger_phrases:\n204-      - \"skill graph freshness\"\n205-      - \"skill-graph zombie ghost nodes\"\n206-      - \"compiled vs sqlite vs disk graph drift\"\n207-      - \"reindex staleness check\"\n--\n209:  - command: /doctor:skill-advisor\n210-    target: router-reach\n211-    yaml: doctor-router-reach.yaml\n212-    setup_vars: [execution_mode, hub, concurrency]\n213-    allowed_flags: [\"--hub=<skill-id>\", \"--concurrency=<n>\"]\n214-    mutating: read-only\n215-    gate3_location: \"n/a (read-only routing diagnostic; probes the live advisor for every declared phrase and reports, writes nothing)\"\n216-    mcp_tools: []   # spawns the advisor CLI per phrase; no MCP calls\n217-    script_invocations:\n218-      - 'node .skilled/skills/sk-doc/sk-create-skill/scripts/ci-router-vocabulary-reach.cjs'\n219-      - 'node .skilled/commands/doctor/scripts/doctor-phrase-reach.cjs  # doctor bridges: every admitted manifest phrase reaches its /doctor:x bridge as the top pick or the second line; scores in process, writes nothing tracked (the freshness check may refresh a cached build record in the ignored dist folder)'\n220-    trigger_phrases:\n221-      - \"router reach check\"\n222-      - \"does a declared phrase reach its hub\"\n223-      - \"router vocabulary reach\"\n--\n227:  - command: /doctor:skill-advisor\n228-    target: embedder\n229-    yaml: doctor-skill-advisor-embedder.yaml\n230-    setup_vars: [execution_mode, dry_run]\n231-    allowed_flags: [\"--dry-run\"]\n232-    mutating: mutates\n233-    gate3_location: \"the advisor database .skilled/skills/system-skill-advisor/runtime/database/skill-graph.sqlite, through skill_graph_scan only, and the user's Ollama model store, one pulled copy of nomic-embed-text:v1.5\"\n234-    cli_commands:\n235-      - 'node .skilled/bin/skill-advisor.cjs advisor_status --workspace-root \"$PWD\" --include-semantic-health true --format json --warm-only'\n236-      - 'node .skilled/bin/skill-advisor.cjs skill_graph_scan --trusted --format json'\n237-    mcp_tools: []   # CLI front door only, no MCP calls\n238-    trigger_phrases:\n239-      - \"set up meaning matching\"\n240-      - \"install the local embedder\"\n241-      - \"ollama is not running for the advisor\"\n--\n314:  - command: /doctor:git\n315-    target: hooks\n316-    yaml: doctor-git-hooks.yaml\n317-    setup_vars: [execution_mode, dry_run]\n318-    allowed_flags: [\"--dry-run\"]\n319-    mutating: mutat