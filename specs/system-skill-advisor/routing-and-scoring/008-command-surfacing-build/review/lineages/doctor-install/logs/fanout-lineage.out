iles under .skilled/skills/mcp-code-mode beyond the build outputs and package-manager outputs produced by the approved commands.\"\n83:    condition: \"The user approves a .utcp_config.json change.\"\n84:    approval: per_mutation\n94:    condition: \"The user approves a runtime config change.\"\n95:    approval: per_mutation\n101:      - \"Request explicit approval for each runtime file before editing it.\"\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\": \"cd /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research && node -e '\\nconst fs=require(\\\"fs\\\");const t=fs.readFileSync(\\\".skilled/commands/doctor/_routes.yaml\\\",\\\"utf8\\\");\\nconst rows=t.split(/^  - command: /m).filter(b=>b.startsWith(\\\"/doctor:agents-md\\\"));\\nfor(const b of rows){const head=b.split(\\\"\\\\n\\\").slice(0,6).join(\\\" | \\\");console.log(head);}\\n' ; echo \\\"=== mcp install approval\\\"; rg -n \\\"approval|approve|asks|yes|mutation_boundaries|read_only\\\" .skilled/commands/doctor/assets/doctor-mcp-install.yaml | head -20\"}"},"time":{"start":1794550617352,"end":1794550618188}}}}
