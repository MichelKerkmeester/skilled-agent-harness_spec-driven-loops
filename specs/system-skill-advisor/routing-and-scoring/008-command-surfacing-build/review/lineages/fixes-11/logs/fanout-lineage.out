e or /create:feature-catalog', '/create:feature-catalog'],\n158:     ['do not run /deep:review, or /deep:research', '/deep:research'],\n159:     ['skip /create:agent or /create:readme', '/create:readme'],\n160:     ['do not run /speckit:plan or /speckit:implement or /speckit:complete', '/speckit:complete'],\n161:     ['do not run /create:agent or the /create:readme command', '/create:readme'],\n162:     ['do not run /create:agent, or the /create:readme command', '/create:readme'],\n163:     ['skip /create:agent or the /create:readme command', '/create:readme'],\n164:     ['never use the /create:readme command or the /create:feature-catalog command', '/create:feature-catalog'],\n165:     ['do not run /doctor:ci report or /create:readme', '/create:readme'],\n166:     ['do not run /doctor:ci report or /doctor:ci scaffold', '/doctor:ci scaffold'],\n167:     ['never use /doctor:git hooks or /doctor:skill-advisor tune', '/doctor:skill-advisor tune'],\n168:   ])('reads %s as a refusal of %s through an or-list', (prompt, command) => {\n169:     expect(commandOnlyMentioned(prompt, command)).toBe(true);\n170:   });\n171: \n172:   // Markup around the name must not hide the lead before it.\n173:   it.each([\n174:     ['do not run `/create:readme`, just tell me what it covers', '/create:readme'],\n175:     ['what does `/create:readme` do?', '/create:readme'],\n176:     ['never use **/deep:review** here', '/deep:review'],\n177:     ['do not run \"/create:readme\" yet', '/create:readme'],\n178:     [\"do not run '/create:readme' yet\", '/create:readme'],\n179:     [\"what's '/create:readme' for?\", '/create:readme'],\n180:     ['never use ‘/deep:review’ here', '/deep:review'],\n181:     ['do not run “/create:readme” yet', '/create:readme'],\n182:   ])('reads the marked-up %s as a mention of %s', (prompt, command) => {\n183:     expect(commandOnlyMentioned(prompt, command)).toBe(true);\n184:   });\n185: \n186:   it('still reads a marked-up request as a request', () => {\n187:     expect(commandOnlyMentioned('run `/create:readme` for the advisor skill', '/create:readme')).toBe(false);\n188:     expect(commandOnlyMentioned(\"run '/create:readme' for the advisor skill\", '/create:readme')).toBe(false);\n189:     expect(commandOnlyMentioned(\"don't skip '/create:readme', run it\", '/create:readme')).toBe(false);\n190:   });\n191: \n192:   it.each([\n193:     ['use /create:agent or /create:readme', '/create:agent'],\n194:     ['use /create:agent or /create:readme', '/create:readme'],\n195:     ['use /speckit:plan, not /speckit:complete', '/speckit:plan'],\n196:     ['do not run /speckit:complete, run /speckit:plan or /speckit:implement', '/speckit:plan'],\n197:     ['do not run /speckit:complete, run /speckit:plan or /speckit:implement', '/speckit:implement'],\n198:     ['do not run /speckit:complete or run /speckit:plan', '/speckit:plan'],\n199:     ['use /create:agent or the /create:readme command', '/create:readme'],\n200:     ['the next step is /create:agent or /create:readme', '/create:readme'],\n201:     ['use /doctor:ci report or /create:readme', '/create:readme'],\n202:   ])('still reads %s as a request for %s beside an or-list', (prompt, command) => {\n203:     expect(commandOnlyMentioned(prompt, command)).toBe(false);\n204:   });\n205: \n206:   // A bare lead opens a statement as often as a question, so it marks a mention\n207:   // only before a question. One led occurrence does not make a request either\n208:   // when a later occurrence of the same command is not led.\n209:   it.each([\n210:     ['the next step is /speckit:implement', '/speckit:implement'],\n211:     ['the next step is the /speckit:implement command', '/speckit:implement'],\n212:     ['is this right? run /speckit:plan', '/speckit:plan'],\n213:     ['the next step is /speckit:implement\\nany questions?', '/speckit:implement'],\n214:     ['what does /speckit:save do? ok now run /speckit:save', '/speckit:save'],\n215:     ['the plan is /speckit:plan then tests', '/speckit:plan'],\n216:   ])('reads %s as a request for %s', (prompt, command) => {\n217:     expect(commandOnlyMentioned(prompt, command)).toBe(false);\n218:   });\n219: \n220:   // A chat question often leaves the question mark off, so a bare ask word that\n221:   // opens a sentence still marks the command as the subject.\n222:   it.each([\n223:     ['is /speckit:resume safe to run twice', '/speckit:resume'],\n224:     ['does /doctor:git change files or just report problems', '/doctor:git'],\n225:     ['can /prompt:improve make a vague request easier to follow', '/prompt:improve'],\n226:     ['ok. is /speckit:plan enough here', '/speckit:plan'],\n227:     ['quick question? is /speckit:resume safe to run twice', '/speckit:resume'],\n228:     ['Is the /doctor:update command safe?', '/doctor:update'],\n229:   ])('reads %s as a question about %s', (prompt, command) => {\n230:     expect(commandOnlyMentioned(prompt, command)).toBe(true);\n231:   });\n232: \n233:   it.each([\n234:     ['should I run /create:agent or /create:readme?', '/create:readme'],\n235:     ['is /create:agent or /create:readme better?', '/create:readme'],\n236:     ['what does /create:agent or /create:readme do?', '/create:readme'],\n237:   ])('reads %s as a question about %s through an or-list', (prompt, command) => {\n238:     expect(commandOnlyMentioned(prompt, command)).toBe(true);\n239:   });\n240: \n241:   it('reads each command of a two-command prompt on its own', () => {\n242:     expect(commandOnlyMentioned('use /speckit:plan, not /speckit:complete', '/speckit:complete')).toBe(true);\n243:   });\n244: \n245:   it('reads a curly apostrophe as a straight one', () => {\n246:     expect(commandOnlyMentioned('don\\u2019t run /speckit:save', '/speckit:save')).toBe(true);\n247:   });\n248: \n249:   it('reads no need to run as a refusal of the command', () => {\n250:     expect(commandOnlyMentioned('no need to run /doctor:setup, the hooks are fine', '/doctor:setup')).toBe(true);\n251:   });\n252: \n253:   it('still reads a request after no need to ask', () => {\n254:     expect(commandOnlyMentioned('no need to ask, run /speckit:save', '/speckit:save')).toBe(false);\n255:   });\n256: \n257:   it('reads stop using as a refusal of the command', () => {\n258:     expect(commandOnlyMentioned('stop using /create:changelog for this, write the changelog entry by hand', '/create:changelog')).toBe(true);\n259:   });\n260: \n261:   it('still reads a request after stop and', () => {\n262:     expect(commandOnlyMentioned('stop and run /speckit:plan', '/speckit:plan')).toBe(false);\n263:   });\n264: \n265:   it('reads why not use as a request for the command', () => {\n266:     expect(commandOnlyMentioned('why not use /create:agent for this? go ahead and make a security reviewer agent', '/create:agent')).toBe(false);\n267:   });\n268: \n269:   it.each([\n270:     ['I have not run /speckit:plan yet, please start it for the login feature', '/speckit:plan'],\n271:     ['I already ran /create:readme but the output was wrong, run it again for the hooks folder', '/create:readme'],\n272:     ['not run /speckit:plan yet, write notes to /tmp/notes.md, then run it', '/speckit:plan'],\n273:     ['not run /speckit:plan yet, read https://example.com/spec first, then run it', '/speckit:plan'],\n274:   ])('reads %s as a request for %s made by a later clause', (prompt, command) => {\n275:     expect(commandOnlyMentioned(prompt, command)).toBe(false);\n276:   });\n277: \n278:   it.each([\n279:     ['do not run /speckit:complete, I will run it myself later', '/speckit:complete'],\n280:     ['do not use /create:agent, use that other one', '/create:agent'],\n281:     ['do not run /speckit:complete, run /speckit:plan for the rate limiter instead', '/speckit:complete'],\n282:     ['do not run /speckit:complete, run /speckit:plan, then run it for the auth module', '/speckit:complete'],\n283:   ])('still reads %s as a mention of %s', (prompt, command) => {\n284:     expect(commandOnlyMentioned(prompt, command)).toBe(true);\n285:   });\n286: \n287:   it('does not read a longer command name as the shorter one', () => {\n288:     expect(commandOnlyMentioned('do not run /create:sk-skill-parent', '/create:sk-skill')).toBe(false);\n289:   });\n290: \n291:   it.each([\n292:     'what does /create:readme do?',\n293:     'skip /create:readme, just append one line to the existing README',\n294:     'do not run /create:agent or /create:readme',\n295:   ])('offers no hub command for %s', (prompt) => {\n296:     expect(attachCommand('sk-doc', SINGLE('sk-create-readme'), prompt)).toBeUndefined();\n297:   });\n298: \n299:   it('offers no deep-loop command the prompt refuses', () => {\n300:     const deepLoopModes = MODE_COMMANDS['system-deep-loop'];\n301:     const mode = Object.keys(deepLoopModes).find((key) => deepLoopModes[key] === '/deep:research');\n302:     expect(mode, 'the generated table names the research mode').toBeDefined();\n303:     expect(attachCommand('system-deep-loop', SINGLE(mode!), 'please do not start /deep:research, I only want a two line summary of the readme')).toBeUndefined();\n304:   });\n305: \n306:   it('still offers the hub command a plain request routes to', () => {\n307:     expect(attachCommand('sk-doc', SINGLE('sk-create-readme'), 'write a readme for the doctor scripts folder')).toBe('/create:readme');\n308:   });\n309: });\n310: \n311: describe('command attach on a small edit', () => {\n312:   it.each([\n313:     'update the README typo in line 3',\n314:     'fix the typo in the README',\n315:     'correct the spelling in the hooks readme',\n316:     'fix the broken link in the install guide readme',\n317:   ])('offers no creation command for %s', (prompt) => {\n318:     expect(attachCommand('sk-doc', SINGLE('sk-create-readme'), prompt)).toBeUndefined();\n319:   });\n320: \n321:   it.each([\n322:     'write a readme for the doctor scripts folder',\n323:     'create a readme for the payments module, check it for typos when done',\n324:   ])('still offers the creation command for %s', (prompt) => {\n325:     expect(attachCommand('sk-doc', SINGLE('sk-create-readme'), prompt)).toBe('/create:readme');\n326:   });\n327: \n328:   it.each([\n329:     ['sk-doc', 'sk-create-agent', 'build an agent that fixes typos in our docs'],\n330:     ['sk-doc', 'sk-create-readme', 'writing a readme for the grammar module'],\n331:     ['sk-doc', 'sk-create-readme', 'add a readme for the spelling package'],\n332:     ['sk-doc', 'sk-create-changelog', 'add a changelog entry for the typo fixes in the cli help'],\n333:   ])('still offers the creation command on %s %s for %s', (skill, mode, prompt) => {\n334:     expect(attachCommand(skill, SINGLE(mode), prompt)).toBe(MODE_COMMANDS[skill][mode]);\n335:   });\n336: \n337:   it('leaves the wording commands outside the gate', () => {\n338:     const docModes = MODE_COMMANDS['sk-doc'];\n339:     const mode = Object.keys(docModes).find((key) => docModes[key] === '/create:with-human-voice');\n340:     expect(mode, 'the generated table names the human voice mode').toBeDefined();\n341:     expect(attachCommand('sk-doc', SINGLE(mode!), 'humanize the wording in the onboarding guide')).toBe('/create:with-human-voice');\n342:   });\n343: \n344:   it.each([\n345:     ['sk-create-changelog', 'changelog for v2.1, it fixes the broken link checker and spelling errors'],\n346:     ['sk-create-changelog', 'log the spelling fixes in the changelog'],\n347:     ['sk-create-readme', 'document the cli in a readme, each flag gets a one line description'],\n348:     ['sk-create-readme', 'readme for the spelling package'],\n349:     ['sk-create-agent', 'an agent that fixes typos'],\n350:   ])('keeps the creation command for %s on %s', (mode, prompt) => {\n351:     expect(attachCommand('sk-doc', SINGLE(mode), prompt)).toBe(MODE_COMMANDS['sk-doc'][mode]);\n352:   });\n353: \n354:   it('keeps the goal command when the goal is about fixes', () => {\n355:     const docModes = MODE_COMMANDS['sk-doc'];\n356:     const mode = Object.keys(docModes).find((key) => docModes[key] === '/create:goal');\n357:     expect(mode, 'the generated table names the goal mode').toBeDefined();\n358:     expect(attachCommand('sk-doc', SINGLE(mode!), 'set a goal to fix all the typos in the docs')).toBe('/create:goal');\n359:   });\n360: \n361:   it.each([\n362:     'fix the broken links in the install guide readme',\n363:     'fix the dead links in the hooks readme',\n364:   ])('offers no creation command for %s', (prompt) => {\n365:     expect(attachCommand('sk-doc', SINGLE('sk-create-readme'), prompt)).toBeUndefined();\n366:   });\n367: \n368:   it('leaves a command outside the create namespace alone', () => {\n369:     const deepLoopModes = MODE_COMMANDS['system-deep-loop'];\n[Output truncated. Continue reading with offset: 370]"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"limit\":240,\"offset\":130,\"path\":\".skilled/skills/system-skill-advisor/runtime/tests/command-attach-guards.vitest.ts\"}"},"time":{"start":1794851726529,"end":1794851727012}}}}
