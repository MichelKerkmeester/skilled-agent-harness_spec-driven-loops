:[{"type":"text","text":"ok\n{\"ok\":true,\"receipt\":{\"ledger_id\":\"deep-review-ledger\",\"sequence\":9,\"event_id\":\"event-7ccb26ab-9f19-46ce-94cc-87ae252082\n===REGISTRY===\n[\n  'sessionId',         'parentSessionId',\n  'generation',        'lineageMode',\n  'continuedFromRun',  'terminalStop',\n  'status',            'openFindings',\n  'resolvedFindings',  'blockedStopHistory',\n  'terminalGates',     'persistentSameSeverity',\n  'severityChanged',   'repeatedFindings',\n  'dimensionCoverage', 'findingsBySeverity',\n  'openFindingsCount', 'resolvedFindingsCount',\n  'convergenceScore',  'graphConvergenceScore',\n  'graphDecision',     'graphBlockers',\n  'graphSignals',      'candidateCoverage',\n  'searchDebt',        'ruledOutCandidates',\n  'cleanSearchProof',  'searchCoverage',\n  'traceability',      'divergence',\n  'fieldWarnings',     'corruptionWarnings'\n]\nopen [\n  { id: undefined, severity: 'P1', status: 'active' },\n  { id: undefined, severity: 'P1', status: 'active' },\n  { id: undefined, severity: 'P2', status: 'active' },\n  { id: undefined, severity: 'P2', status: 'active' },\n  { id: undefined, severity: 'P2', status: 'active' },\n  { id: undefined, severity: 'P2', status: 'active' },\n  { id: undefined, severity: 'P2', status: 'active' }\n]\ncounts { P0: 0, P1: 2, P2: 5 } openCount 7\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"cd /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research && D=specs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/review/lineages/fixes-11 && node -e '\\nconst fs=require(\\\"fs\\\"),crypto=require(\\\"crypto\\\");const sha=(v)=>crypto.createHash(\\\"sha256\\\").update(typeof v===\\\"string\\\"?v:JSON.stringify(v)).digest(\\\"hex\\\");\\nconst signals={noveltyRatio:0.2,coverageRatio:1,findingStabilityRatio:0.5,evidenceDensityRatio:1,hotspotSaturationRatio:1,observationDigest:sha({noveltyRatio:0.2,coverageRatio:1,find