-summary.md\n./017-review-pass-two-remediation/tasks.md\n./017-review-pass-two-remediation/scratch/verify-wg1-4.md\n./017-review-pass-two-remediation/plan.md\n./017-review-pass-two-remediation/spec.md\n./goal.md\n./025-release-notes-and-doc-sync/implementation-summary.md\n./025-release-notes-and-doc-sync/acceptance-criteria.md\n./025-release-notes-and-doc-sync/goal.md\n./025-release-notes-and-doc-sync/tasks.md\n./025-release-notes-and-doc-sync/spec.md\n./031-alignment-findings-remediation/tasks.md\n./031-alignment-findings-remediation/plan.md\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"cd /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/specs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build && grep -rln \\\"commandOnlyMentioned\\\\|single quote\\\\|apostrophe\\\" --include=\\\"*.md\\\" . | head -20\"}"},"time":{"start":1794852005258,"end":1794852006440}}}}
