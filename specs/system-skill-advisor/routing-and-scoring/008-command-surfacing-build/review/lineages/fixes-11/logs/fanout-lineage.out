{"type":"step_start","timestamp":1794851641600,"sessionID":"ses_e1a82d918ffeSg4o2dc6d2Zt3H","part":{"id":"prt_1e57e9900001IktSdXRlNRSj43","sessionID":"ses_e1a82d918ffeSg4o2dc6d2Zt3H","messageID":"msg_1e57e8dd6001aEUHWoCORHmgJW","type":"step-start","snapshot":"54ddf6a978af86fe5472976852d7ca646d55ac8a"}}
{"type":"tool_use","timestamp":1794851642282,"sessionID":"ses_e1a82d918ffeSg4o2dc6d2Zt3H","part":{"partID":"prt_1e57e99f4001mGGgy2ppuq5mVU","sessionID":"ses_e1a82d918ffeSg4o2dc6d2Zt3H","messageID":"msg_1e57e8dd6001aEUHWoCORHmgJW","type":"tool","id":"call_7e2e9c03308f4f1a8c29c3e7","tool":"read","state":{"status":"completed","input":{"path":".skilled/commands/doctor/assets/doctor-install.yaml"},"output":"Read file .skilled/commands/doctor/assets/doctor-install.yaml, lines 1-70\n1: # ─────────────────────────────────────────────────────────────────\n2: # DOCTOR: INSTALL (READ-ONLY GUIDE)\n3: # ─────────────────────────────────────────────────────────────────\n4: role: Diagnostic guide that checks install prerequisites, inspects a target repository and prints the writing commands for the operator\n5: purpose: Check both required builds -> gather the target and install choices -> inspect the target repo once -> print the ordered install checklist and caveat\n6: action: Check the builds -> ask for missing target details -> run the symlink engine check once -> render the result through the presentation contract\n7: skill_owner: \".skilled/skills/system-skilled-doctor/\"\n8: \n9: # ─────────────────────────────────────────────────────────────────\n10: # OPERATING MODE\n11: # ─────────────────────────────────────────────────────────────────\n12: operating_mode:\n13:   workflow: single-step\n14:   compliance: MANDATORY\n15:   execution: read_only\n16:   approvals: none\n17:   tracking: single_run\n18:   validation: read_only_assertion\n19: \n20: # ─────────────────────────────────────────────────────────────────\n21: # MUTATION BOUNDARIES (READ-ONLY)\n22: # ─────────────────────────────────────────────────────────────────\n23: mutation_boundaries:\n24:   read_only: true\n25:   allowed_targets: []\n26:   forbidden_targets:\n27:     - \"**/*\"\n28:   invariant: \"This route checks the Skilled checkout and target repo, then prints the ordered install commands. It MUST NOT run a target that writes, build either runtime, or add an argument to a writing command beyond the values the operator gave.\"\n29: \n30: # ─────────────────────────────────────────────────────────────────\n31: # UPSTREAM ASSETS\n32: # ─────────────────────────────────────────────────────────────────\n33: upstream_assets:\n34:   spec_kit_build_check: \"test -d .skilled/skills/system-spec-kit/runtime/dist && test -f .skilled/skills/system-spec-kit/runtime/cli/dist/continuity/generate-context.js (the compiled runtime and continuity writer /speckit:save runs)\"\n35:   advisor_build_check: \"node .skilled/bin/skill-advisor.cjs list-tools --format json\"\n36:   symlink_engine: \".skilled/commands/doctor/scripts/symlink-engine.cjs (check subcommand only)\"\n37:   route_manifest: \".skilled/commands/doctor/_routes.yaml (the source for each printed route's mutation class)\"\n38:   presentation: \".skilled/commands/doctor/assets/doctor-install-presentation.txt\"\n39: \n40: # ─────────────────────────────────────────────────────────────────\n41: # INPUTS\n42: # ─────────────────────────────────────────────────────────────────\n43: inputs:\n44:   target: \"The command takes no positional target. A whole argument of list, ? or menu prints the ordered install steps and stops.\"\n45:   root: \"The target repository's absolute path, supplied with --root or in the consolidated prompt.\"\n46:   runtimes: \"The runtime list, supplied with --runtimes or in the consolidated prompt; the operator can choose the runtimes already there.\"\n47:   link_shape: \"The operator's choice of auto, whole or merge; auto is recommended.\"\n48:   instruction_choice: \"The operator's choice of embed or link; embed is recommended and keeps the repo's own AGENTS.md.\"\n49:   json_output: \"True when --json is passed; print one JSON object and nothing else.\"\n50:   execution_mode: \"INTERACTIVE\"\n51: \n52: # ─────────────────────────────────────────────────────────────────\n53: # EXECUTION\n54: # ─────────────────────────────────────────────────────────────────\n55: execution:\n56:   steps:\n57:     - \"Locate: For a whole argument of list, ? or menu, print the ordered install steps from the presentation contract and stop. Otherwise check the spec-kit build with test -d .skilled/skills/system-spec-kit/runtime/dist && test -f .skilled/skills/system-spec-kit/runtime/cli/dist/continuity/generate-context.js; exit 0 means built. Check the advisor build with node .skilled/bin/skill-advisor.cjs list-tools --format json; exit 0 means built. If either build is missing, add a nonexecuted step 0 and print its build commands from the Skilled checkout's README.md.\"\n58:     - \"Ask: When --root or --runtimes is missing, ask once for the target repo's absolute path, runtimes (claude, opencode, codex, cursor, devin, pi, vibe, dsh, or the ones already there), link shape (auto, whole or merge) and instruction file (embed or link). Stop for the answers.\"\n59:     - \"Inspect: Run node .skilled/commands/doctor/scripts/symlink-engine.cjs check --root <dir> [--runtimes <list>] [--link-instructions] once in place. Use only the check subcommand; include --link-instructions only when the operator chose link. Render the engine's entry lines through the presentation contract.\"\n60:     - \"Checklist: Print these ordered writing steps through the presentation contract and stop; never run them. For each command, copy its mutation class verbatim from _routes.yaml and print one line explaining why: 1) /doctor:symlink link --root <dir> --runtimes <list> --mode <shape>, with --link-instructions only when link was chosen; it shows a plan and asks before writing. 2) /doctor:agents-md embed --root <dir>, only when embed was chosen. 3) /doctor:mcp install, from the Skilled checkout, to build and register Code Mode. 4) /doctor:git setup, from inside the target repo. 5) /doctor:skill-advisor embedder, from inside the target repo, to set up meaning matching for commands. It shows its cost and asks before it pulls the model or starts the server, and a no leaves a phrase-only install. 6) /doctor:setup, from inside the target repo, to confirm the result. Pass only values the operator gave.\"\n61:     - \"Warn: Print this fixed caveat: Context saves land in the target repo's own specs/ when they run from inside it. Run /doctor:setup and later saves from inside the target repo, not from the Skilled checkout.\"\n62: \n63: # ─────────────────────────────────────────────────────────────────\n64: # OUTPUT\n65: # ─────────────────────────────────────────────────────────────────\n66: output: |\n67:   A whole argument of list, ? or menu prints the ordered install steps from the presentation and stops.\n68:   --json prints one JSON object with source, root, runtimes, builds, symlink_check and steps: [{ order, command, mutating, why }], and nothing else.\n69:   Otherwise render the engine entry lines, ordered writing steps and caveat through the presentation contract.\n70:   Missing builds add step 0 with the build commands from the README. Build and install commands are printed for the operator and never run by this workflow.","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file .skilled/commands/doctor/assets/doctor-install.yaml, lines 1-70\n1: # ─────────────────────────────────────────────────────────────────\n2: # DOCTOR: INSTALL (READ-ONLY GUIDE)\n3: # ─────────────────────────────────────────────────────────────────\n4: role: Diagnostic guide that checks install prerequisites, inspects a target repository and prints the writing commands for the operator\n5: purpose: Check both required builds -> gather the target and install choices -> inspect the target repo once -> print the ordered install checklist and caveat\n6: action: Check the builds -> ask for missing target details -> run the symlink engine check once -> render the result through the presentation contract\n7: skill_owner: \".skilled/skills/system-skilled-doctor/\"\n8: \n9: # ─────────────────────────────────────────────────────────────────\n10: # OPERATING MODE\n11: # ─────────────────────────────────────────────────────────────────\n12: operating_mode:\n13:   workflow: single-step\n14:   compliance: MANDATORY\n15:   execution: read_only\n16:   approvals: none\n17:   tracking: single_run\n18:   validation: read_only_assertion\n19: \n20: # ─────────────────────────────────────────────────────────────────\n21: # MUTATION BOUNDARIES (READ-ONLY)\n22: # ─────────────────────────────────────────────────────────────────\n23: mutation_boundaries:\n24:   read_only: true\n25:   allowed_targets: []\n26:   forbidden_targets:\n27:     - \"**/*\"\n28:   invariant: \"This route checks the Skilled checkout and target repo, then prints the ordered install commands. It MUST NOT run a target that writes, build either runtime, or add an argument to a writing command beyond the values the operator gave.\"\n29: \n30: # ─────────────────────────────────────────────────────────────────\n31: # UPSTREAM ASSETS\n32: # ─────────────────────────────────────────────────────────────────\n33: upstream_assets:\n34:   spec_kit_build_check: \"test -d .skilled/skills/system-spec-kit/runtime/dist && test -f .skilled/skills/system-spec-kit/runtime/cli/dist/continuity/generate-context.js (the compiled runtime and continuity writer /speckit:save runs)\"\n35:   advisor_build_check: \"node .skilled/bin/skill-advisor.cjs list-tools --format json\"\n36:   symlink_engine: \".skilled/commands/doctor/scripts/symlink-engine.cjs (check subcommand only)\"\n37:   route_manifest: \".skilled/commands/doctor/_routes.yaml (the source for each printed route's mutation class)\"\n38:   presentation: \".skilled/commands/doctor/assets/doctor-install-presentation.txt\"\n39: \n40: # ─────────────────────────────────────────────────────────────────\n41: # INPUTS\n42: # ─────────────────────────────────────────────────────────────────\n43: inputs:\n44:   target: \"The command takes no positional target. A whole argument of list, ? or menu prints the ordered install steps and stops.\"\n45:   root: \"The target repository's absolute path, supplied with --root or in the consolidated prompt.\"\n46:   runtimes: \"The runtime list, supplied with --runtimes or in the consolidated prompt; the operator can choose the runtimes already there.\"\n47:   link_shape: \"The operator's choice of auto, whole or merge; auto is recommended.\"\n48:   instruction_choice: \"The operator's choice of embed or link; embed is recommended and keeps the repo's own AGENTS.md.\"\n49:   json_output: \"True when --json is passed; print one JSON object and nothing else.\"\n50:   execution_mode: \"INTERACTIVE\"\n51: \n52: # ─────────────────────────────────────────────────────────────────\n53: # EXECUTION\n54: # ─────────────────────────────────────────────────────────────────\n55: execution:\n56:   steps:\n57:     - \"Locate: For a whole argument of list, ? or menu, print the ordered install steps from the presentation contract and stop. Otherwise check the spec-kit build with test -d .skilled/skills/system-spec-kit/runtime/dist && test -f .skilled/skills/system-spec-kit/runtime/cli/dist/continuity/generate-context.js; exit 0 means built. Check the advisor build with node .skilled/bin/skill-advisor.cjs list-tools --format json; exit 0 means built. If either build is missing, add a nonexecuted step 0 and print its build commands from the Skilled checkout's README.md.\"\n58:     - \"Ask: When --root or --runtimes is missing, ask once for the target repo's absolute path, runtimes (claude, opencode, codex, cursor, devin, pi, vibe, dsh, or the ones already there), link shape (auto, whole or merge) and instruction file (embed or link). Stop for the answers.\"\n59:     - \"Inspect: Run node .skilled/commands/doctor/scripts/symlink-engine.cjs check --root <dir> [--runtimes <list>] [--link-instructions] once in place. Use only the check subcommand; include --link-instructions only when the operator chose link. Render the engine's entry lines through the presentation contract.\"\n60:     - \"Checklist: Print these ordered writing steps through the presentation contract and stop; never run them. For each command, copy its mutation class verbatim from _routes.yaml and print one line explaining why: 1) /doctor:symlink link --root <dir> --runtimes <list> --mode <shape>, with --link-instructions only when link was chosen; it shows a plan and asks before writing. 2) /doctor:agents-md embed --root <dir>, only when embed was chosen. 3) /doctor:mcp install, from the Skilled checkout, to build and register Code Mode. 4) /doctor:git setup, from inside the target repo. 5) /doctor:skill-advisor embedder, from inside the target repo, to set up meaning matching for commands. It shows its cost and asks before it pulls the model or starts the server, and a no leaves a phrase-only install. 6) /doctor:setup, from inside the target repo, to confirm the result. Pass only values the operator gave.\"\n61:     - \"Warn: Print this fixed caveat: Context saves land in the target repo's own specs/ when they run from inside it. Run /doctor:setup and later saves from inside the target repo, not from the Skilled checkout.\"\n62: \n63: # ─────────────────────────────────────────────────────────────────\n64: # OUTPUT\n65: # ─────────────────────────────────────────────────────────────────\n66: output: |\n67:   A whole argument of list, ? or menu prints the ordered install steps from the presentation and stops.\n68:   --json prints one JSON object with source, root, runtimes, builds, symlink_check and steps: [{ order, command, mutating, why }], and nothing else.\n69:   Otherwise render the engine entry lines, ordered writing steps and caveat through the presentation contract.\n70:   Missing builds add step 0 with the build commands from the README. Build and install commands are printed for the operator and never run by this workflow."}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\".skilled/commands/doctor/assets/doctor-install.yaml\"}"},"time":{"start":1794851641844,"end":1794851642282}}}}
{"type":"tool_use","timestamp":1794851642288,"sessionID":"ses_e1a82d918ffeSg4o2dc6d2Zt3H","part":{"partID":"prt_1e57e9abb0013iGar3y6OMS18h","sessionID":"ses_e1a82d918ffeSg4o2dc6d2Zt3H","messageID":"msg_1e57e8dd6001aEUHWoCORHmgJW","type":"tool","id":"call_7424a16b94874b8ab084a82a","tool":"read","state":{"status":"completed","input":{"path":".skilled/commands/doctor/scripts/tests/doctor-install-contract.test.cjs"},"output":"Read file .skilled/commands/doctor/scripts/tests/doctor-install-contract.test.cjs, lines 1-320\n1: #!/usr/bin/env node\n2: // ───────────────────────────────────────────────────────────────────\n3: // MODULE: Doctor Install Contract Tests\n4: // ───────────────────────────────────────────────────────────────────\n5: \n6: 'use strict';\n7: \n8: // ─────────────────────────────────────────────────────────────────────────────\n9: // 1. IMPORTS AND FIXTURES\n10: // ─────────────────────────────────────────────────────────────────────────────\n11: \n12: const assert = require('node:assert/strict');\n13: const fs = require('node:fs');\n14: const path = require('node:path');\n15: const test = require('node:test');\n16: const { parse: parseYaml } = require('yaml');\n17: \n18: const DOCTOR = path.resolve(__dirname, '..', '..');\n19: const ASSETS = path.join(DOCTOR, 'assets');\n20: const CONTRACT_ASSETS = path.resolve(DOCTOR, '..', '..', 'skills', 'sk-doc', 'sk-create-command', 'assets');\n21: \n22: const read = (file) => fs.readFileSync(file, 'utf8');\n23: \n24: const MANIFEST = parseYaml(read(path.join(DOCTOR, '_routes.yaml')));\n25: const ROUTES = MANIFEST.routes.filter((route) => route.command === '/doctor:install');\n26: const installRoute = () => ROUTES[0];\n27: \n28: const ROUTER = read(path.join(DOCTOR, 'install.md'));\n29: const PRESENTATION = read(path.join(ASSETS, 'doctor-install-presentation.txt'));\n30: const WORKFLOW_TEXT = read(path.join(ASSETS, 'doctor-install.yaml'));\n31: const WORKFLOW = parseYaml(WORKFLOW_TEXT);\n32: // The install guide's frozen interface lives here rather than in a planning document, so the\n33: // test keeps running wherever the planning notes move.\n34: const INSTALL_PHRASES = [\n35:   'install skilled into my project',\n36:   'set up skilled in another repo',\n37:   'use skilled in my own project',\n38:   'onboard a project repo to skilled',\n39:   'guide me through installing skilled',\n40:   'walk me through a first install of skilled',\n41:   'first install of skilled in my project',\n42:   'skilled in my other repository',\n43:   'skilled in another repository',\n44:   'walk me through adding this toolkit to my own project repository',\n45:   'put this toolkit into my own project repository',\n46:   'use this toolkit in my own project',\n47:   'install this toolkit into another repository',\n48:   'onboard this project repository',\n49: ];\n50: const WORKFLOW_STEP_NAMES = ['Locate', 'Ask', 'Inspect', 'Checklist', 'Warn'];\n51: const SAVE_CAVEAT = 'context saves land in the target repo\\'s own specs/ when they run from inside it, so run /doctor:setup and later saves from inside the target repo, not from the Skilled checkout.';\n52: \n53: const CONTRACT = JSON.parse(read(path.join(CONTRACT_ASSETS, 'command-contract.json')));\n54: const SCHEMA = JSON.parse(read(path.join(CONTRACT_ASSETS, 'command-contract.schema.json')));\n55: const DOCTOR_CONTRACT = CONTRACT.families.doctor;\n56: const FAMILY_SCHEMA = SCHEMA.definitions.familyContract;\n57: \n58: const WORKFLOW_ASSET = 'doctor-install.yaml';\n59: const PRESENTATION_ASSET = 'doctor-install-presentation.txt';\n60: const ENGINE = '.skilled/commands/doctor/scripts/symlink-engine.cjs';\n61: \n62: const CHECKLIST_STEPS = [\n63:   {\n64:     command: '/doctor:symlink link --root <dir> --runtimes <list> --mode <shape>',\n65:     owner: '/doctor:symlink',\n66:     target: 'link',\n67:     mutating: 'mutates',\n68:   },\n69:   {\n70:     command: '/doctor:agents-md embed --root <dir>',\n71:     owner: '/doctor:agents-md',\n72:     target: 'embed',\n73:     mutating: 'mutates',\n74:   },\n75:   {\n76:     command: '/doctor:mcp install',\n77:     owner: '/doctor:mcp',\n78:     target: 'install',\n79:     mutating: 'mutates',\n80:   },\n81:   {\n82:     command: '/doctor:git setup',\n83:     owner: '/doctor:git',\n84:     target: 'setup',\n85:     mutating: 'read-only',\n86:   },\n87:   {\n88:     command: '/doctor:skill-advisor embedder',\n89:     owner: '/doctor:skill-advisor',\n90:     target: 'embedder',\n91:     mutating: 'mutates',\n92:   },\n93:   {\n94:     command: '/doctor:setup',\n95:     owner: '/doctor:setup',\n96:     target: 'setup',\n97:     mutating: 'read-only',\n98:   },\n99: ];\n100: \n101: function checklistOwner(step) {\n102:   if (step.owner === '/doctor:mcp') {\n103:     return MANIFEST.mcp_subroutes.find((route) => route.sub_action === step.target);\n104:   }\n105:   return MANIFEST.routes.find((route) => route.command === step.owner && route.target === step.target);\n106: }\n107: \n108: // ─────────────────────────────────────────────────────────────────────────────\n109: // 2. THE ROUTE\n110: // ─────────────────────────────────────────────────────────────────────────────\n111: \n112: test('the manifest holds one read-only install route matching the frozen contract', () => {\n113:   assert.equal(ROUTES.length, 1, '/doctor:install must own exactly one route');\n114:   const route = installRoute();\n115:   assert.equal(route.target, 'guide');\n116:   assert.equal(route.mutating, 'read-only');\n117:   assert.match(route.gate3_location, /^n\\/a/);\n118:   assert.equal(route.default_target, undefined);\n119:   assert.equal(route.yaml, WORKFLOW_ASSET);\n120:   assert.ok(fs.existsSync(path.join(ASSETS, route.yaml)), route.yaml);\n121:   assert.deepEqual(route.allowed_flags, ['--json', '--root <dir>', '--runtimes <list>']);\n122:   assert.deepEqual(route.setup_vars, ['execution_mode', 'root', 'runtimes', 'json_output']);\n123:   assert.deepEqual(route.mcp_tools, []);\n124: });\n125: \n126: test('the install route phrases and declared commands agree with the workflow contract', () => {\n127:   for (const phrase of installRoute().trigger_phrases) {\n128:     assert.ok(phrase.trim().split(/\\s+/).length >= 3, phrase);\n129:     assert.ok(INSTALL_PHRASES.includes(phrase), phrase);\n130:   }\n131: \n132:   assert.equal(installRoute().script_invocations.length, 3);\n133:   for (const invocation of installRoute().script_invocations) {\n134:     const command = invocation.split('#')[0].trim();\n135:     assert.ok(WORKFLOW_TEXT.includes(command), command);\n136:   }\n137: });\n138: \n139: test('the printed checklist names each route owner with its mutation class and reason', () => {\n140:   for (const [index, step] of CHECKLIST_STEPS.entries()) {\n141:     const owner = checklistOwner(step);\n142:     assert.ok(owner, `${step.owner} ${step.target} has no manifest entry`);\n143:     assert.equal(owner.mutating, step.mutating, step.command);\n144:     assert.ok(WORKFLOW_TEXT.includes(step.command), step.command);\n145: \n146:     const numbered = `${index + 1}) ${step.command}`;\n147:     assert.ok(PRESENTATION.includes(numbered), numbered);\n148:     assert.ok(WORKFLOW_TEXT.includes(numbered), numbered);\n149: \n150:     const lineIndex = PRESENTATION.indexOf(step.command);\n151:     assert.notEqual(lineIndex, -1, step.command);\n152:     const commandLineEnd = PRESENTATION.indexOf('\\n', lineIndex);\n153:     const whyLineEnd = PRESENTATION.indexOf('\\n', commandLineEnd + 1);\n154:     const commandLine = PRESENTATION.slice(lineIndex, commandLineEnd);\n155:     const whyLine = PRESENTATION.slice(commandLineEnd + 1, whyLineEnd);\n156:     assert.match(commandLine, /\\[class\\]$/);\n157:     assert.match(whyLine, /^\\s+Why: .+/);\n158:   }\n159: });\n160: \n161: // ─────────────────────────────────────────────────────────────────────────────\n162: // 3. ROUTER AND PRESENTATION\n163: // ─────────────────────────────────────────────────────────────────────────────\n164: \n165: test('the router follows the router template: six canonical sections in order and no inline presentation', () => {\n166:   const headings = [...ROUTER.matchAll(/^## \\d+\\. ([A-Z ]+)$/gm)].map((match) => match[1]);\n167:   assert.deepEqual(headings, [\n168:     'ROUTER CONTRACT',\n169:     'OWNED ASSETS',\n170:     'MODE ROUTING',\n171:     'EXECUTION TARGETS',\n172:     'PRESENTATION BOUNDARY',\n173:     'WORKFLOW SUMMARY',\n174:   ]);\n175:   assert.doesNotMatch(ROUTER, /```/);\n176:   assert.doesNotMatch(ROUTER, /STATUS=/);\n177: });\n178: \n179: test('the router frontmatter stays within budget and grants only the tools it uses', () => {\n180:   const description = ROUTER.match(/^description:\\s*\"(.*)\"$/m)[1];\n181:   assert.ok(description.length <= 110, `description is ${description.length} chars`);\n182:   assert.doesNotMatch(description, /[<>]/);\n183:   const hint = ROUTER.match(/^argument-hint:\\s*\"(.*)\"$/m)[1];\n184:   assert.ok(hint.length <= 140, `argument-hint is ${hint.length} chars`);\n185:   const tools = ROUTER.match(/^allowed-tools:\\s*(.+)$/m)[1].split(',').map((tool) => tool.trim());\n186:   assert.deepEqual(tools, ['Read', 'Bash']);\n187:   assert.equal(ROUTER.split('<!-- skill_agent: system-skilled-doctor -->').length - 1, 1);\n188: });\n189: \n190: test('the router binds its guide target to the workflow asset named by the route', () => {\n191:   const targetRow = `| \\`guide\\` | \\`.skilled/commands/doctor/assets/${WORKFLOW_ASSET}\\` |`;\n192:   assert.ok(ROUTER.includes(targetRow), targetRow);\n193: });\n194: \n195: test('the router keeps shortcuts and flag handling within the frozen interface', () => {\n196:   assert.match(ROUTER, /`list`, `\\?` and `menu` as the whole argument/);\n197:   assert.match(ROUTER, /A second positional token is an argument failure/);\n198:   for (const flag of installRoute().allowed_flags) {\n199:     assert.ok(ROUTER.includes(flag), flag);\n200:   }\n201: });\n202: \n203: test('the presentation carries install errors, the build checks, prompt, inspection and ordered steps', () => {\n204:   for (const heading of [\n205:     '## 1. Argument Failure',\n206:     '## 2. The Build Check',\n207:     '## 3. The Install Prompt',\n208:     '## 4. Accepted Answers',\n209:     '## 5. The Symlink Check',\n210:     '## 6. The Ordered Steps',\n211:     '## 7. The Caveat Line',\n212:     '## 8. Result Templates',\n213:   ]) {\n214:     assert.ok(PRESENTATION.includes(heading), heading);\n215:   }\n216:   assert.ok(PRESENTATION.includes('`STATUS=FAIL ERROR=\"unknown_argument\"`'));\n217:   assert.match(PRESENTATION, /^STATUS=OK STEPS=\\[n\\]$/m);\n218:   assert.match(PRESENTATION, /^1\\) Target repo:/m);\n219:   assert.match(PRESENTATION, /^2\\) Runtimes:/m);\n220:   assert.match(PRESENTATION, /^3\\) Link shape:/m);\n221:   assert.match(PRESENTATION, /^4\\) Instruction file:/m);\n222:   assert.match(PRESENTATION, /DOCTOR INSTALL — BUILDS/);\n223:   assert.match(PRESENTATION, /DOCTOR INSTALL — WHAT IS ALREADY THERE/);\n224: \n225:   const workflowSteps = WORKFLOW.execution.steps.map((step) => step.match(/^([A-Za-z]+):/)[1]);\n226:   assert.deepEqual(workflowSteps, WORKFLOW_STEP_NAMES);\n227: });\n228: \n229: test('the presentation prints writing commands for the operator and closes on the family convention', () => {\n230:   assert.match(PRESENTATION, /A printed step is handed back, never run/);\n231:   assert.match(PRESENTATION, /the operator runs it/);\n232:   assert.match(PRESENTATION, /^STATUS=FAIL ERROR=\"\\[message\\]\"$/m);\n233:   assert.ok(PRESENTATION.includes('End interactive presentations with: `What would you like to do next?`'));\n234: \n235:   assert.ok(PRESENTATION.includes(`\\n${SAVE_CAVEAT}\\n`), SAVE_CAVEAT);\n236: });\n237: \n238: test('the presentation and the workflow name the accepted runtimes instead of a count', () => {\n239:   assert.doesNotMatch(PRESENTATION, /outside the seven/);\n240:   assert.doesNotMatch(PRESENTATION, /outside the (?:seven|eight|nine)/);\n241:   const named = Object.keys(JSON.parse(read(path.join(ASSETS, 'symlink-manifest.json'))).runtimes).sort();\n242:   const list = `${named.slice(0, -1).join(', ')} and ${named[named.length - 1]}`;\n243:   assert.ok(PRESENTATION.includes(`outside ${list} or the ones already there`), list);\n244: });\n245: \n246: // ─────────────────────────────────────────────────────────────────────────────\n247: // 4. THE READ-ONLY WORKFLOW\n248: // ─────────────────────────────────────────────────────────────────────────────\n249: \n250: test('the workflow is read-only, grants no write target and runs the route scripts', () => {\n251:   assert.equal(WORKFLOW.operating_mode.execution, 'read_only');\n252:   assert.equal(WORKFLOW.mutation_boundaries.read_only, true);\n253:   assert.deepEqual(WORKFLOW.mutation_boundaries.allowed_targets, []);\n254:   assert.ok(WORKFLOW_TEXT.includes(ENGINE), ENGINE);\n255: \n256:   for (const invocation of installRoute().script_invocations) {\n257:     const command = invocation.split('#')[0].trim();\n258:     assert.ok(WORKFLOW_TEXT.includes(command), command);\n259:   }\n260: });\n261: \n262: test('the workflow declares every variable its route resolves', () => {\n263:   for (const key of installRoute().setup_vars) {\n264:     assert.ok(key in WORKFLOW.inputs, `inputs.${key} is missing`);\n265:   }\n266: });\n267: \n268: test('the workflow asks once, inspects once and hands all writing steps back', () => {\n269:   const steps = WORKFLOW.execution.steps;\n270:   assert.match(steps[1], /ask once/i);\n271:   assert.match(steps[2], /symlink-engine\\.cjs check/);\n272:   assert.equal((steps[2].match(/symlink-engine\\.cjs check/g) || []).length, 1);\n273:   assert.match(steps[3], /Print these ordered writing steps/);\n274:   assert.match(steps[3], /never run them/);\n275:   assert.match(steps[4], /fixed caveat/);\n276: });\n277: \n278: // ─────────────────────────────────────────────────────────────────────────────\n279: // 5. THE COMMAND CONTRACT\n280: // ─────────────────────────────────────────────────────────────────────────────\n281: \n282: test('the doctor contract carries every field its schema requires and nothing it forbids', () => {\n283:   for (const key of FAMILY_SCHEMA.required) {\n284:     assert.ok(key in DOCTOR_CONTRACT, `families.doctor is missing ${key}`);\n285:   }\n286:   const known = new Set(Object.keys(FAMILY_SCHEMA.properties));\n287:   assert.deepEqual(\n288:     Object.keys(DOCTOR_CONTRACT).filter((key) => !known.has(key)),\n289:     [],\n290:     'the schema forbids an additional property',\n291:   );\n292: });\n293: \n294: test('the contract names the install router, workflow, presentation and hint', () => {\n295:   const hint = ROUTER.match(/^argument-hint:\\s*\"(.*)\"$/m)[1];\n296:   const presentationPath = `.skilled/commands/doctor/assets/${PRESENTATION_ASSET}`;\n297:   const ownsPresentation = DOCTOR_CONTRACT.owned_assets.some((entry) => (\n298:     entry.purpose === 'presentation'\n299:     && entry.path.replace('doctor-<entry>-presentation.txt', PRESENTATION_ASSET) === presentationPath\n300:   ));\n301: \n302:   assert.ok(DOCTOR_CONTRACT.router_path.includes('.skilled/commands/doctor/install.md'));\n303:   assert.ok(DOCTOR_CONTRACT.execution_targets\n304:     .some((entry) => entry.target.endsWith(WORKFLOW_ASSET)), WORKFLOW_ASSET);\n305:   assert.ok(ownsPresentation, presentationPath);\n306:   assert.ok(DOCTOR_CONTRACT.input.argument_hint.includes(`${hint} (install)`));\n307: });\n308: \n309: test('the contract publishes the install invocation alias', () => {\n310:   const hint = ROUTER.match(/^argument-hint:\\s*\"(.*)\"$/m)[1];\n311:   const alias = `/doctor:install ${hint.replace(/ \\| list \\| \\?$/, '')}`;\n312:   assert.ok(DOCTOR_CONTRACT.invocation_aliases.includes(alias), alias);\n313: });\n314: \n315: test('the contract describes the install loader behavior', () => {\n316:   assert.ok(\n317:     DOCTOR_CONTRACT.loader_requirements.some((line) => line.includes('/doctor:install')),\n318:     '/doctor:install is missing from loader_requirements',\n319:   );\n320: });","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file .skilled/commands/doctor/scripts/tests/doctor-install-contract.test.cjs, lines 1-320\n1: #!/usr/bin/env node\n2: // ───────────────────────────────────────────────────────────────────\n3: // MODULE: Doctor Install Contract Tests\n4: // ───────────────────────────────────────────────────────────────────\n5: \n6: 'use strict';\n7: \n8: // ─────────────────────────────────────────────────────────────────────────────\n9: // 1. IMPORTS AND FIXTURES\n10: // ─────────────────────────────────────────────────────────────────────────────\n11: \n12: const assert = require('node:assert/strict');\n13: const fs = require('node:fs');\n14: const path = require('node:path');\n15: const test = require('node:test');\n16: const { parse: parseYaml } = require('yaml');\n17: \n18: const DOCTOR = path.resolve(__dirname, '..', '..');\n19: const ASSETS = path.join(DOCTOR, 'assets');\n20: const CONTRACT_ASSETS = path.resolve(DOCTOR, '..', '..', 'skills', 'sk-doc', 'sk-create-command', 'assets');\n21: \n22: const read = (file) => fs.readFileSync(file, 'utf8');\n23: \n24: const MANIFEST = parseYaml(read(path.join(DOCTOR, '_routes.yaml')));\n25: const ROUTES = MANIFEST.routes.filter((route) => route.command === '/doctor:install');\n26: const installRoute = () => ROUTES[0];\n27: \n28: const ROUTER = read(path.join(DOCTOR, 'install.md'));\n29: const PRESENTATION = read(path.join(ASSETS, 'doctor-install-presentation.txt'));\n30: const WORKFLOW_TEXT = read(path.join(ASSETS, 'doctor-install.yaml'));\n31: const WORKFLOW = parseYaml(WORKFLOW_TEXT);\n32: // The install guide's frozen interface lives here rather than in a planning document, so the\n33: // test keeps running wherever the planning notes move.\n34: const INSTALL_PHRASES = [\n35:   'install skilled into my project',\n36:   'set up skilled in another repo',\n37:   'use skilled in my own project',\n38:   'onboard a project repo to skilled',\n39:   'guide me through installing skilled',\n40:   'walk me through a first install of skilled',\n41:   'first install of skilled in my project',\n42:   'skilled in my other repository',\n43:   'skilled in another repository',\n44:   'walk me through adding this toolkit to my own project repository',\n45:   'put this toolkit into my own project repository',\n46:   'use this toolkit in my own project',\n47:   'install this toolkit into another repository',\n48:   'onboard this project repository',\n49: ];\n50: const WORKFLOW_STEP_NAMES = ['Locate', 'Ask', 'Inspect', 'Checklist', 'Warn'];\n51: const SAVE_CAVEAT = 'context saves land in the target repo\\'s own specs/ when they run from inside it, so run /doctor:setup and later saves from inside the target repo, not from the Skilled checkout.';\n52: \n53: const CONTRACT = JSON.parse(read(path.join(CONTRACT_ASSETS, 'command-contract.json')));\n54: const SCHEMA = JSON.parse(read(path.join(CONTRACT_ASSETS, 'command-contract.schema.json')));\n55: const DOCTOR_CONTRACT = CONTRACT.families.doctor;\n56: const FAMILY_SCHEMA = SCHEMA.definitions.familyContract;\n57: \n58: const WORKFLOW_ASSET = 'doctor-install.yaml';\n59: const PRESENTATION_ASSET = 'doctor-install-presentation.txt';\n60: const ENGINE = '.skilled/commands/doctor/scripts/symlink-engine.cjs';\n61: \n62: const CHECKLIST_STEPS = [\n63:   {\n64:     command: '/doctor:symlink link --root <dir> --runtimes <list> --mode <shape>',\n65:     owner: '/doctor:symlink',\n66:     target: 'link',\n67:     mutating: 'mutates',\n68:   },\n69:   {\n70:     command: '/doctor:agents-md embed --root <dir>',\n71:     owner: '/doctor:agents-md',\n72:     target: 'embed',\n73:     mutating: 'mutates',\n74:   },\n75:   {\n76:     command: '/doctor:mcp install',\n77:     owner: '/doctor:mcp',\n78:     target: 'install',\n79:     mutating: 'mutates',\n80:   },\n81:   {\n82:     command: '/doctor:git setup',\n83:     owner: '/doctor:git',\n84:     target: 'setup',\n85:     mutating: 'read-only',\n86:   },\n87:   {\n88:     command: '/doctor:skill-advisor embedder',\n89:     owner: '/doctor:skill-advisor',\n90:     target: 'embedder',\n91:     mutating: 'mutates',\n92:   },\n93:   {\n94:     command: '/doctor:setup',\n95:     owner: '/doctor:setup',\n96:     target: 'setup',\n97:     mutating: 'read-only',\n98:   },\n99: ];\n100: \n101: function checklistOwner(step) {\n102:   if (step.owner === '/doctor:mcp') {\n103:     return MANIFEST.mcp_subroutes.find((route) => route.sub_action === step.target);\n104:   }\n105:   return MANIFEST.routes.find((route) => route.command === step.owner && route.target === step.target);\n106: }\n107: \n108: // ─────────────────────────────────────────────────────────────────────────────\n109: // 2. THE ROUTE\n110: // ─────────────────────────────────────────────────────────────────────────────\n111: \n112: test('the manifest holds one read-only install route matching the frozen contract', () => {\n113:   assert.equal(ROUTES.length, 1, '/doctor:install must own exactly one route');\n114:   const route = installRoute();\n115:   assert.equal(route.target, 'guide');\n116:   assert.equal(route.mutating, 'read-only');\n117:   assert.match(route.gate3_location, /^n\\/a/);\n118:   assert.equal(route.default_target, undefined);\n119:   assert.equal(route.yaml, WORKFLOW_ASSET);\n120:   assert.ok(fs.existsSync(path.join(ASSETS, route.yaml)), route.yaml);\n121:   assert.deepEqual(route.allowed_flags, ['--json', '--root <dir>', '--runtimes <list>']);\n122:   assert.deepEqual(route.setup_vars, ['execution_mode', 'root', 'runtimes', 'json_output']);\n123:   assert.deepEqual(route.mcp_tools, []);\n124: });\n125: \n126: test('the install route phrases and declared commands agree with the workflow contract', () => {\n127:   for (const phrase of installRoute().trigger_phrases) {\n128:     assert.ok(phrase.trim().split(/\\s+/).length >= 3, phrase);\n129:     assert.ok(INSTALL_PHRASES.includes(phrase), phrase);\n130:   }\n131: \n132:   assert.equal(installRoute().script_invocations.length, 3);\n133:   for (const invocation of installRoute().script_invocations) {\n134:     const command = invocation.split('#')[0].trim();\n135:     assert.ok(WORKFLOW_TEXT.includes(command), command);\n136:   }\n137: });\n138: \n139: test('the printed checklist names each route owner with its mutation class and reason', () => {\n140:   for (const [index, step] of CHECKLIST_STEPS.entries()) {\n141:     const owner = checklistOwner(step);\n142:     assert.ok(owner, `${step.owner} ${step.target} has no manifest entry`);\n143:     assert.equal(owner.mutating, step.mutating, step.command);\n144:     assert.ok(WORKFLOW_TEXT.includes(step.command), step.command);\n145: \n146:     const numbered = `${index + 1}) ${step.command}`;\n147:     assert.ok(PRESENTATION.includes(numbered), numbered);\n148:     assert.ok(WORKFLOW_TEXT.includes(numbered), numbered);\n149: \n150:     const lineIndex = PRESENTATION.indexOf(step.command);\n151:     assert.notEqual(lineIndex, -1, step.command);\n152:     const commandLineEnd = PRESENTATION.indexOf('\\n', lineIndex);\n153:     const whyLineEnd = PRESENTATION.indexOf('\\n', commandLineEnd + 1);\n154:     const commandLine = PRESENTATION.slice(lineIndex, commandLineEnd);\n155:     const whyLine = PRESENTATION.slice(commandLineEnd + 1, whyLineEnd);\n156:     assert.match(commandLine, /\\[class\\]$/);\n157:     assert.match(whyLine, /^\\s+Why: .+/);\n158:   }\n159: });\n160: \n161: // ─────────────────────────────────────────────────────────────────────────────\n162: // 3. ROUTER AND PRESENTATION\n163: // ─────────────────────────────────────────────────────────────────────────────\n164: \n165: test('the router follows the router template: six canonical sections in order and no inline presentation', () => {\n166:   const headings = [...ROUTER.matchAll(/^## \\d+\\. ([A-Z ]+)$/gm)].map((match) => match[1]);\n167:   assert.deepEqual(headings, [\n168:     'ROUTER CONTRACT',\n169:     'OWNED ASSETS',\n170:     'MODE ROUTING',\n171:     'EXECUTION TARGETS',\n172:     'PRESENTATION BOUNDARY',\n173:     'WORKFLOW SUMMARY',\n174:   ]);\n175:   assert.doesNotMatch(ROUTER, /```/);\n176:   assert.doesNotMatch(ROUTER, /STATUS=/);\n177: });\n178: \n179: test('the router frontmatter stays within budget and grants only the tools it uses', () => {\n180:   const description = ROUTER.match(/^description:\\s*\"(.*)\"$/m)[1];\n181:   assert.ok(description.length <= 110, `description is ${description.length} chars`);\n182:   assert.doesNotMatch(description, /[<>]/);\n183:   const hint = ROUTER.match(/^argument-hint:\\s*\"(.*)\"$/m)[1];\n184:   assert.ok(hint.length <= 140, `argument-hint is ${hint.length} chars`);\n185:   const tools = ROUTER.match(/^allowed-tools:\\s*(.+)$/m)[1].split(',').map((tool) => tool.trim());\n186:   assert.deepEqual(tools, ['Read', 'Bash']);\n187:   assert.equal(ROUTER.split('<!-- skill_agent: system-skilled-doctor -->').length - 1, 1);\n188: });\n189: \n190: test('the router binds its guide target to the workflow asset named by the route', () => {\n191:   const targetRow = `| \\`guide\\` | \\`.skilled/commands/doctor/assets/${WORKFLOW_ASSET}\\` |`;\n192:   assert.ok(ROUTER.includes(targetRow), targetRow);\n193: });\n194: \n195: test('the router keeps shortcuts and flag handling within the frozen interface', () => {\n196:   assert.match(ROUTER, /`list`, `\\?` and `menu` as the whole argument/);\n197:   assert.match(ROUTER, /A second positional token is an argument failure/);\n198:   for (const flag of installRoute().allowed_flags) {\n199:     assert.ok(ROUTER.includes(flag), flag);\n200:   }\n201: });\n202: \n203: test('the presentation carries install errors, the build checks, prompt, inspection and ordered steps', () => {\n204:   for (const heading of [\n205:     '## 1. Argument Failure',\n206:     '## 2. The Build Check',\n207:     '## 3. The Install Prompt',\n208:     '## 4. Accepted Answers',\n209:     '## 5. The Symlink Check',\n210:     '## 6. The Ordered Steps',\n211:     '## 7. The Caveat Line',\n212:     '## 8. Result Templates',\n213:   ]) {\n214:     assert.ok(PRESENTATION.includes(heading), heading);\n215:   }\n216:   assert.ok(PRESENTATION.includes('`STATUS=FAIL ERROR=\"unknown_argument\"`'));\n217:   assert.match(PRESENTATION, /^STATUS=OK STEPS=\\[n\\]$/m);\n218:   assert.match(PRESENTATION, /^1\\) Target repo:/m);\n219:   assert.match(PRESENTATION, /^2\\) Runtimes:/m);\n220:   assert.match(PRESENTATION, /^3\\) Link shape:/m);\n221:   assert.match(PRESENTATION, /^4\\) Instruction file:/m);\n222:   assert.match(PRESENTATION, /DOCTOR INSTALL — BUILDS/);\n223:   assert.match(PRESENTATION, /DOCTOR INSTALL — WHAT IS ALREADY THERE/);\n224: \n225:   const workflowSteps = WORKFLOW.execution.steps.map((step) => step.match(/^([A-Za-z]+):/)[1]);\n226:   assert.deepEqual(workflowSteps, WORKFLOW_STEP_NAMES);\n227: });\n228: \n229: test('the presentation prints writing commands for the operator and closes on the family convention', () => {\n230:   assert.match(PRESENTATION, /A printed step is handed back, never run/);\n231:   assert.match(PRESENTATION, /the operator runs it/);\n232:   assert.match(PRESENTATION, /^STATUS=FAIL ERROR=\"\\[message\\]\"$/m);\n233:   assert.ok(PRESENTATION.includes('End interactive presentations with: `What would you like to do next?`'));\n234: \n235:   assert.ok(PRESENTATION.includes(`\\n${SAVE_CAVEAT}\\n`), SAVE_CAVEAT);\n236: });\n237: \n238: test('the presentation and the workflow name the accepted runtimes instead of a count', () => {\n239:   assert.doesNotMatch(PRESENTATION, /outside the seven/);\n240:   assert.doesNotMatch(PRESENTATION, /outside the (?:seven|eight|nine)/);\n241:   const named = Object.keys(JSON.parse(read(path.join(ASSETS, 'symlink-manifest.json'))).runtimes).sort();\n242:   const list = `${named.slice(0, -1).join(', ')} and ${named[named.length - 1]}`;\n243:   assert.ok(PRESENTATION.includes(`outside ${list} or the ones already there`), list);\n244: });\n245: \n246: // ─────────────────────────────────────────────────────────────────────────────\n247: // 4. THE READ-ONLY WORKFLOW\n248: // ─────────────────────────────────────────────────────────────────────────────\n249: \n250: test('the workflow is read-only, grants no write target and runs the route scripts', () => {\n251:   assert.equal(WORKFLOW.operating_mode.execution, 'read_only');\n252:   assert.equal(WORKFLOW.mutation_boundaries.read_only, true);\n253:   assert.deepEqual(WORKFLOW.mutation_boundaries.allowed_targets, []);\n254:   assert.ok(WORKFLOW_TEXT.includes(ENGINE), ENGINE);\n255: \n256:   for (const invocation of installRoute().script_invocations) {\n257:     const command = invocation.split('#')[0].trim();\n258:     assert.ok(WORKFLOW_TEXT.includes(command), command);\n259:   }\n260: });\n261: \n262: test('the workflow declares every variable its route resolves', () => {\n263:   for (const key of installRoute().setup_vars) {\n264:     assert.ok(key in WORKFLOW.inputs, `inputs.${key} is missing`);\n265:   }\n266: });\n267: \n268: test('the workflow asks once, inspects once and hands all writing steps back', () => {\n269:   const steps = WORKFLOW.execution.steps;\n270:   assert.match(steps[1], /ask once/i);\n271:   assert.match(steps[2], /symlink-engine\\.cjs check/);\n272:   assert.equal((steps[2].match(/symlink-engine\\.cjs check/g) || []).length, 1);\n273:   assert.match(steps[3], /Print these ordered writing steps/);\n274:   assert.match(steps[3], /never run them/);\n275:   assert.match(steps[4], /fixed caveat/);\n276: });\n277: \n278: // ─────────────────────────────────────────────────────────────────────────────\n279: // 5. THE COMMAND CONTRACT\n280: // ─────────────────────────────────────────────────────────────────────────────\n281: \n282: test('the doctor contract carries every field its schema requires and nothing it forbids', () => {\n283:   for (const key of FAMILY_SCHEMA.required) {\n284:     assert.ok(key in DOCTOR_CONTRACT, `families.doctor is missing ${key}`);\n285:   }\n286:   const known = new Set(Object.keys(FAMILY_SCHEMA.properties));\n287:   assert.deepEqual(\n288:     Object.keys(DOCTOR_CONTRACT).filter((key) => !known.has(key)),\n289:     [],\n290:     'the schema forbids an additional property',\n291:   );\n292: });\n293: \n294: test('the contract names the install router, workflow, presentation and hint', () => {\n295:   const hint = ROUTER.match(/^argument-hint:\\s*\"(.*)\"$/m)[1];\n296:   const presentationPath = `.skilled/commands/doctor/assets/${PRESENTATION_ASSET}`;\n297:   const ownsPresentation = DOCTOR_CONTRACT.owned_assets.some((entry) => (\n298:     entry.purpose === 'presentation'\n299:     && entry.path.replace('doctor-<entry>-presentation.txt', PRESENTATION_ASSET) === presentationPath\n300:   ));\n301: \n302:   assert.ok(DOCTOR_CONTRACT.router_path.includes('.skilled/commands/doctor/install.md'));\n303:   assert.ok(DOCTOR_CONTRACT.execution_targets\n304:     .some((entry) => entry.target.endsWith(WORKFLOW_ASSET)), WORKFLOW_ASSET);\n305:   assert.ok(ownsPresentation, presentationPath);\n306:   assert.ok(DOCTOR_CONTRACT.input.argument_hint.includes(`${hint} (install)`));\n307: });\n308: \n309: test('the contract publishes the install invocation alias', () => {\n310:   const hint = ROUTER.match(/^argument-hint:\\s*\"(.*)\"$/m)[1];\n311:   const alias = `/doctor:install ${hint.replace(/ \\| list \\| \\?$/, '')}`;\n312:   assert.ok(DOCTOR_CONTRACT.invocation_aliases.includes(alias), alias);\n313: });\n314: \n315: test('the contract describes the install loader behavior', () => {\n316:   assert.ok(\n317:     DOCTOR_CONTRACT.loader_requirements.some((line) => line.includes('/doctor:install')),\n318:     '/doctor:install is missing from loader_requirements',\n319:   );\n320: });"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\"