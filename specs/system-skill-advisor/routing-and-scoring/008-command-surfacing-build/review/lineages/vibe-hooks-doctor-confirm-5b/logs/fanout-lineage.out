{"type":"tool_use","timestamp":1794780697057,"sessionID":"ses_e1ebd75cbffeKCKhhfHEFy30Ji","part":{"partID":"prt_1e1440e60001yAx6Y4YU2c8vYA","sessionID":"ses_e1ebd75cbffeKCKhhfHEFy30Ji","messageID":"msg_1e143d676001xsebOJaKsbZt5p","type":"tool","id":"call_5cf52f9dc2864d27bbbcf369","tool":"shell","state":{"status":"completed","input":{"command":"git -c core.fsmonitor=false diff 2a1a42263cc d21dbc1cafe -- .skilled/commands/doctor/scripts/tests/hook-wiring-check.test.cjs","workdir":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research"},"output":"diff --git a/.skilled/commands/doctor/scripts/tests/hook-wiring-check.test.cjs b/.skilled/commands/doctor/scripts/tests/hook-wiring-check.test.cjs\nindex ea8e27b0129..7d9dfcb103d 100644\n--- a/.skilled/commands/doctor/scripts/tests/hook-wiring-check.test.cjs\n+++ b/.skilled/commands/doctor/scripts/tests/hook-wiring-check.test.cjs\n@@ -39,21 +39,25 @@ function writeClaudeSettings(root, hooks) {\n   fs.writeFileSync(path.join(root, CLAUDE_FILE), JSON.stringify({ hooks }, null, 2));\n }\n \n-function writeVibeHooks(root, text) {\n+// A case can replace the match line of the text it writes, and null drops it.\n+// The line is written as the case spells it, so a case chooses its quoting and\n+// any trailing comment.\n+function writeVibeHooks(root, text, matchLine) {\n   fs.mkdirSync(path.join(root, '.vibe'), { recursive: true });\n-  fs.writeFileSync(path.join(root, VIBE_FILE), text);\n+  let body = text;\n+  if (matchLine === null) body = body.replace(/^match = .*\\n/m, '');\n+  else if (typeof matchLine === 'string') body = body.replace(/^match = .*$/m, matchLine);\n+  fs.writeFileSync(path.join(root, VIBE_FILE), body);\n }\n \n // The Vibe hook file is TOML, so one block is built as the lines the check reads.\n-function vibeBlock(type, commandLine) {\n-  return [\n-    '[[hooks]]',\n-    'name = \"turn-start\"',\n-    `type = \"${type}\"`,\n-    'match = \"main\"',\n-    'timeout = 20.0',\n-    commandLine,\n-  ].join('\\n');\n+// A block omits its match line when the case passes null for it, and otherwise\n+// writes the line as the case spells it.\n+function vibeBlock(type, commandLine, match = 'match = \"main\"') {\n+  const lines = ['[[hooks]]', 'name = \"turn-start\"', `type = \"${type}\"`];\n+  if (match !== null) lines.push(match);\n+  lines.push('timeout = 20.0', commandLine);\n+  return lines.join('\\n');\n }\n \n // ─────────────────────────────────────────────────────────────────────────────\n@@ -231,8 +235,9 @@ test('names a runtime whose entry echoes a quoted command', (t) => {\n   assert.match(result.out, /^hook-missing claude \\.claude\\/settings\\.json$/m);\n });\n \n-// Vibe keeps its hooks in TOML and only a `pre_agent` entry that starts node on\n-// the turn-start script runs before the prompt, so each shape below must not count.\n+// Vibe keeps its hooks in TOML and only a `pre_agent` entry for the main agent\n+// that starts node on the turn-start script runs before the prompt, so each\n+// shape below must not count.\n test('passes the Vibe turn-start entry under pre_agent', (t) => {\n   const f = fixture(t);\n   writeVibeHooks(f.root, vibeBlock('pre_agent', 'command = \"' + VIBE_COMMAND + '\"'));\n@@ -241,6 +246,74 @@ test('passes the Vibe turn-start entry under pre_agent', (t) => {\n   assert.equal(text.out.trim(), 'ok vibe');\n });\n \n+test('passes a Vibe entry whose match selector names the main agent', (t) => {\n+  const f = fixture(t);\n+  writeVibeHooks(f.root, vibeBlock('pre_agent', 'command = \"' + VIBE_COMMAND + '\"', 'match = \"main\"'));\n+  const text = f.run();\n+  assert.equal(text.code, 0);\n+  assert.equal(text.out.trim(), 'ok vibe');\n+});\n+\n+test('passes a Vibe entry with no match line', (t) => {\n+  const f = fixture(t);\n+  writeVibeHooks(f.root, vibeBlock('pre_agent', 'command = \"' + VIBE_COMMAND + '\"', null));\n+  const text = f.run();\n+  assert.equal(text.code, 0);\n+  assert.equal(text.out.trim(), 'ok vibe');\n+});\n+\n+test('names Vibe when its turn-start entry matches another agent', (t) => {\n+  const f = fixture(t);\n+  writeVibeHooks(f.root, vibeBlock('pre_agent', 'command = \"' + VIBE_COMMAND + '\"'), 'match = \"agents_spawn\"');\n+  const result = f.run();\n+  assert.equal(result.code, 1, result.out.trim());\n+  assert.match(result.out, /^hook-missing vibe \\.vibe\\/hooks\\.toml$/m);\n+});\n+\n+test('names Vibe when its match selector is a regular expression', (t) => {\n+  const f = fixture(t);\n+  writeVibeHooks(f.root, vibeBlock('pre_agent', 'command = \"' + VIBE_COMMAND + '\"', 'match = \"re:main|other\"'));\n+  const result = f.run();\n+  assert.equal(result.code, 1, result.out.trim());\n+  assert.match(result.out, /^hook-missing vibe \\.vibe\\/hooks\\.toml$/m);\n+});\n+\n+test('names Vibe when its match selector is a literal string', (t) => {\n+  const f = fixture(t);\n+  writeVibeHooks(f.root, vibeBlock(\n+    'pre_agent',\n+    'command = \"' + VIBE_COMMAND + '\"',\n+    \"match = 'agents_spawn'\",\n+  ));\n+  const result = f.run();\n+  assert.equal(result.code, 1, result.out.trim());\n+  assert.match(result.out, /^hook-missing vibe \\.vibe\\/hooks\\.toml$/m);\n+});\n+\n+test('names Vibe when its match line carries a trailing comment', (t) => {\n+  const f = fixture(t);\n+  writeVibeHooks(f.root, vibeBlock(\n+    'pre_agent',\n+    'command = \"' + VIBE_COMMAND + '\"',\n+    'match = \"agents_spawn\"  # subagents',\n+  ));\n+  const result = f.run();\n+  assert.equal(result.code, 1, result.out.trim());\n+  assert.match(result.out, /^hook-missing vibe \\.vibe\\/hooks\\.toml$/m);\n+});\n+\n+test('passes a Vibe match selector written as a literal string', (t) => {\n+  const f = fixture(t);\n+  writeVibeHooks(f.root, vibeBlock(\n+    'pre_agent',\n+    'command = \"' + VIBE_COMMAND + '\"',\n+    \"match = 'main'\",\n+  ));\n+  const text = f.run();\n+  assert.equal(text.code, 0);\n+  assert.equal(text.out.trim(), 'ok vibe');\n+});\n+\n test('names Vibe when its turn-start entry runs under post_agent', (t) => {\n   const f = fixture(t);\n   writeVibeHooks(f.root, vibeBlock('post_agent', 'command = \"' + VIBE_COMMAND + '\"'));\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"diff --git a/.skilled/commands/doctor/scripts/tests/hook-wiring-check.test.cjs b/.skilled/commands/doctor/scripts/tests/hook-wiring-check.test.cjs\nindex ea8e27b0129..7d9dfcb103d 100644\n--- a/.skilled/commands/doctor/scripts/tests/hook-wiring-check.test.cjs\n+++ b/.skilled/commands/doctor/scripts/tests/hook-wiring-check.test.cjs\n@@ -39,21 +39,25 @@ function writeClaudeSettings(root, hooks) {\n   fs.writeFileSync(path.join(root, CLAUDE_FILE), JSON.stringify({ hooks }, null, 2));\n }\n \n-function writeVibeHooks(root, text) {\n+// A case can replace the match line of the text it writes, and null drops it.\n+// The line is written as the case spells it, so a case chooses its quoting and\n+// any trailing comment.\n+function writeVibeHooks(root, text, matchLine) {\n   fs.mkdirSync(path.join(root, '.vibe'), { recursive: true });\n-  fs.writeFileSync(path.join(root, VIBE_FILE), text);\n+  let body = text;\n+  if (matchLine === null) body = body.replace(/^match = .*\\n/m, '');\n+  else if (typeof matchLine === 'string') body = body.replace(/^match = .*$/m, matchLine);\n+  fs.writeFileSync(path.join(root, VIBE_FILE), body);\n }\n \n // The Vibe hook file is TOML, so one block is built as the lines the check reads.\n-function vibeBlock(type, commandLine) {\n-  return [\n-    '[[hooks]]',\n-    'name = \"turn-start\"',\n-    `type = \"${type}\"`,\n-    'match = \"main\"',\n-    'timeout = 20.0',\n-    commandLine,\n-  ].join('\\n');\n+// A block omits its match line when the case passes null for it, and otherwise\n+// writes the line as the case spells it.\n+function vibeBlock(type, commandLine, match = 'match = \"main\"') {\n+  const lines = ['[[hooks]]', 'name = \"turn-start\"', `type = \"${type}\"`];\n+  if (match !== null) lines.push(match);\n+  lines.push('timeout = 20.0', commandLine);\n+  return lines.join('\\n');\n }\n \n // ─────────────────────────────────────────────────────────────────────────────\n@@ -231,8 +235,9 @@ test('names a runtime whose entry echoes a quoted command', (t) => {\n   assert.match(result.out, /^hook-missing claude \\.claude\\/settings\\.json$/m);\n });\n \n-// Vibe keeps its hooks in TOML and only a `pre_agent` entry that starts node on\n-// the turn-start script runs before the prompt, so each shape below must not count.\n+// Vibe keeps its hooks in TOML and only a `pre_agent` entry for the main agent\n+// that starts node on the turn-start script runs before the prompt, so each\n+// shape below must not count.\n test('passes the Vibe turn-start entry under pre_agent', (t) => {\n   const f = fixture(t);\n   writeVibeHooks(f.root, vibeBlock('pre_agent', 'command = \"' + VIBE_COMMAND + '\"'));\n@@ -241,6 +246,74 @@ test('passes the Vibe turn-start entry under pre_agent', (t) => {\n   assert.equal(text.out.trim(), 'ok vibe');\n });\n \n+test('passes a Vibe entry whose match selector names the main agent', (t) => {\n+  const f = fixture(t);\n+  writeVibeHooks(f.root, vibeBlock('pre_agent', 'command = \"' + VIBE_COMMAND + '\"', 'match = \"main\"'));\n+  const text = f.run();\n+  assert.equal(text.code, 0);\n+  assert.equal(text.out.trim(), 'ok vibe');\n+});\n+\n+test('passes a Vibe entry with no match line', (t) => {\n+  const f = fixture(t);\n+  writeVibeHooks(f.root, vibeBlock('pre_agent', 'command = \"' + VIBE_COMMAND + '\"', null));\n+  const text = f.run();\n+  assert.equal(text.code, 0);\n+  assert.equal(text.out.trim(), 'ok vibe');\n+});\n+\n+test('names Vibe when its turn-start entry matches another agent', (t) => {\n+  const f = fixture(t);\n+  writeVibeHooks(f.root, vibeBlock('pre_agent', 'command = \"' + VIBE_COMMAND + '\"'), 'match = \"agents_spawn\"');\n+  const result = f.run();\n+  assert.equal(result.code, 1, result.out.trim());\n+  assert.match(result.out, /^hook-missing vibe \\.vibe\\/hooks\\.toml$/m);\n+});\n+\n+test('names Vibe when its match selector is a regular expression', (t) => {\n+  const f = fixture(t);\n+  writeVibeHooks(f.root, vibeBlock('pre_agent', 'command = \"' + VIBE_COMMAND + '\"', 'match = \"re:main|other\"'));\n+  const result = f.run();\n+  assert.equal(result.code, 1, result.out.trim());\n+  assert.match(result.out, /^hook-missing vibe \\.vibe\\/hooks\\.toml$/m);\n+});\n+\n+test('names Vibe when its match selector is a literal string', (t) => {\n+  const f = fixture(t);\n+  writeVibeHooks(f.root, vibeBlock(\n+    'pre_agent',\n+    'command = \"' + VIBE_COMMAND + '\"',\n+    \"match = 'agents_spawn'\",\n+  ));\n+  const result = f.run();\n+  assert.equal(result.code, 1, result.out.trim());\n+  assert.match(result.out, /^hook-missing vibe \\.vibe\\/hooks\\.toml$/m);\n+});\n+\n+test('names Vibe when its match line carries a trailing comment', (t) => {\n+  const f = fixture(t);\n+  writeVibeHooks(f.root, vibeBlock(\n+    'pre_agent',\n+    'command = \"' + VIBE_COMMAND + '\"',\n+    'match = \"agents_spawn\"  # subagents',\n+  ));\n+  const result = f.run();\n+  assert.equal(result.code, 1, result.out.trim());\n+  assert.match(result.out, /^hook-missing vibe \\.vibe\\/hooks\\.toml$/m);\n+});\n+\n+test('passes a Vibe match selector written as a literal string', (t) => {\n+  const f = fixture(t);\n+  writeVibeHooks(f.root, vibeBlock(\n+    'pre_agent',\n+    'command = \"' + VIBE_COMMAND + '\"',\n+    \"match = 'main'\",\n+  ));\n+  const text = f.run();\n+  assert.equal(text.code, 0);\n+  assert.equal(text.out.trim(), 'ok vibe');\n+});\n+\n test('names Vibe when its turn-start entry runs under post_agent', (t) => {\n   const f = fixture(t);\n   writeVibeHooks(f.root, vibeBlock('post_agent', 'command = \"' + VIBE_COMMAND + '\"'));\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"git -c core.fsmonitor=false diff 2a1a42263cc d21dbc1cafe -- .skilled/commands/doctor/scripts/tests/hook-wiring-check.test.cjs\",\"workdir\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research\"}"},"time":{"start":1794780696160,"end":1794780697057}}}}
{"type":"tool_use","timestamp":1794780697065,"sessionID":"ses_e1ebd75cbffeKCKhhfHEFy30Ji","part":{"partID":"prt_1e1440bb10013AHshPV9y773Cd","sessionID":"ses_e1ebd75cbffeKCKhhfHEFy30Ji","messageID":"msg_1e143d676001xsebOJaKsbZt5p","type":"tool","id":"call_2fd068e754b447b0bf5df64e","tool":"shell","state":{"status":"completed","input":{"command":"git -c core.fsmonitor=false diff 2a1a42263cc d21dbc1cafe -- .skilled/skills/system-skill-advisor/hooks/skill-advisor-hook.md","workdir":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research"},"output":"diff --git a/.skilled/skills/system-skill-advisor/hooks/skill-advisor-hook.md b/.skilled/skills/system-skill-advisor/hooks/skill-advisor-hook.md\nindex 61b04f1dba9..8421b0c636f 100644\n--- a/.skilled/skills/system-skill-advisor/hooks/skill-advisor-hook.md\n+++ b/.skilled/skills/system-skill-advisor/hooks/skill-advisor-hook.md\n@@ -1,6 +1,6 @@\n ---\n title: Skill Advisor Hook Reference\n-description: Operator contract for the maintained Skill Advisor adapters across Claude, Codex, Cursor, Devin, Pi, DSH and the OpenCode plugin. Surfaces a prompt-safe routing brief on each user prompt; advisory only and fail-open.\n+description: Operator contract for the maintained Skill Advisor adapters across Claude, Codex, Cursor, Devin, Pi, DSH, Vibe and the OpenCode plugin. Surfaces a prompt-safe routing brief on each user prompt. Advisory only and fail-open.\n trigger_phrases:\n   - \"skill advisor hook reference\"\n   - \"native-first advisor hooks\"\n@@ -9,7 +9,7 @@ trigger_phrases:\n   - \"advisor hook smoke tests\"\n importance_tier: important\n contextType: implementation\n-version: 3.6.18.0\n+version: 3.6.20.0\n ---\n \n # Skill Advisor Hook Reference\n@@ -81,7 +81,7 @@ Rows below the threshold are discarded before either rule applies. The degraded\n \n ## 3. PER-RUNTIME DELIVERY\n \n-Every native runtime, Pi and DSH run the same hook handler, which gates the prompt, calls the advisor CLI and renders with `renderAdvisorBrief`. The OpenCode plugin calls the CLI itself. The native adapters differ in prompt event, transport and delivery channel.\n+Every native runtime, Pi, DSH and Vibe run the same hook handler, which gates the prompt, calls the advisor CLI and renders with `renderAdvisorBrief`. The OpenCode plugin calls the CLI itself. The native adapters differ in prompt event, transport and delivery channel.\n \n | Runtime | Adapter | Event / wiring | Payload difference it handles | Delivery |\n |---|---|---|---|---|\n@@ -109,6 +109,7 @@ The document behind a surfaced command is `.skilled/commands/<group>/<name>.md`.\n | Pi | No model path found | The mirror is a pointer stub. Public Pi docs were not fetched, so this is unverified beyond the repository |\n | OpenCode | No documented model path. A parent process can start one with `opencode run --command` | Commands are user-triggered templates, while skills are loaded by the model through a skill tool |\n | DSH | No | dsh has no agent-file loader and no command loader |\n+| Vibe | No | Vibe has no command loader. The brief names each offered command's document, which the model reads in full |\n \n ---\n \n@@ -170,11 +171,15 @@ The advisor is enabled by default. Truthy disable values are `1`, `true`, `yes`,\n | Variable | Effect |\n |---|---|\n | `SYSTEM_SKILL_ADVISOR_DISABLED=1` | Canonical kill-switch. Every adapter checks `isHookEnabled('skill-advisor')` and returns empty/skipped prompt-safe output, and the `advisor_recommend` direct call abstains. |\n-| `SYSTEM_SKILL_ADVISOR_HOOK_DISABLED=1` | Alias. Disables the native adapters and makes the `advisor_recommend` direct call abstain. |\n+| `SYSTEM_SKILL_ADVISOR_HOOK_DISABLED=1` | Alias. Disables every adapter and makes the `advisor_recommend` direct call abstain. |\n | `SYSTEM_SKILL_ADVISOR_PLUGIN_DISABLED=1` | Alias. Disables every adapter and makes the `advisor_recommend` direct call abstain. |\n-| `SPECKIT_SKILL_ADVISOR_HOOK_DISABLED=1` | Legacy alias for the native adapters and the `advisor_recommend` direct call. The standalone Python CLI (`skill_advisor.py`) reads only this name, set to exactly `1`, from `runtime/schemas/compat-contract.json`. |\n+| `SPECKIT_SKILL_ADVISOR_HOOK_DISABLED=1` | Legacy alias that disables every adapter and makes the `advisor_recommend` direct call abstain. The standalone Python CLI (`skill_advisor.py`) reads only this name, set to exactly `1`, from `runtime/schemas/compat-contract.json`. |\n | `SPECKIT_SKILL_ADVISOR_PLUGIN_DISABLED=1` | Legacy alias. Disables every adapter and makes the `advisor_recommend` direct call abstain. |\n | `SYSTEM_HOOKS_DISABLED=1` | Master switch that disables this concern along with every other repo hook. |\n+| `MK_HOOKS_DISABLED=1` | Older alias of `SYSTEM_HOOKS_DISABLED`. Master switch that disables this concern along with every other repo hook. |\n+| `MK_SKILL_ADVISOR_DISABLED=1` | Older alias of `SYSTEM_SKILL_ADVISOR_DISABLED`. Every adapter checks `isHookEnabled('skill-advisor')` and returns empty/skipped prompt-safe output, and the `advisor_recommend` direct call abstains. |\n+| `MK_SKILL_ADVISOR_HOOK_DISABLED=1` | Older alias of `SYSTEM_SKILL_ADVISOR_HOOK_DISABLED`. Disables every adapter and makes the `advisor_recommend` direct call abstain. |\n+| `MK_SKILL_ADVISOR_PLUGIN_DISABLED=1` | Older alias of `SYSTEM_SKILL_ADVISOR_PLUGIN_DISABLED`. Disables every adapter and makes the `advisor_recommend` direct call abstain. |\n \n The direct call decides in the caller's own process, by the same resolution the adapters use. `node .skilled/bin/skill-advisor.cjs advisor_recommend` asks `hookFlagDecision('skill-advisor')` in `.skilled/hooks/shared/hook-flags.cjs`, with the caller's environment over `.skilled/hooks/hook-flags.env`, before it connects to a daemon or runs the local scorer. Whenever the adapters are off, under any name in this table or its older `MK_` form, any truthy value or a line in the flags file, it prints the empty envelope with `ADVISOR_DISABLED` and names the switch that decided. A daemon reads the same names from its own environment and never reads the flags file, and the launcher passes no switch name and no `HOOK_FLAGS_CONFIG` to a daemon it starts, so a flagged command that happens to start the daemon does not leave it abstaining for every later caller. The standalone Python CLI keeps its own rule: only `SPECKIT_SKILL_ADVISOR_HOOK_DISABLED`, set to exactly `1`.\n \n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"diff --git a/.skilled/skills/system-skill-advisor/hooks/skill-advisor-hook.md b/.skilled/skills/system-skill-advisor/hooks/skill-advisor-hook.md\nindex 61b04f1dba9..8421b0c636f 100644\n--- a/.skilled/skills/system-skill-advisor/hooks/skill-advisor-hook.md\n+++ b/.skilled/skills/system-skill-advisor/hooks/skill-advisor-hook.md\n@@ -1,6 +1,6 @@\n ---\n title: Skill Advisor Hook Reference\n-description: Operator contract for the maintained Skill Advisor adapters across Claude, Codex, Cursor, Devin, Pi, DSH and the OpenCode plugin. Surfaces a prompt-safe routing brief on each user prompt; advisory only and fail-open.\n+description: Operator contract for the maintained Skill Advisor adapters across Claude, Codex, Cursor, Devin, Pi, DSH, Vibe and the OpenCode plugin. Surfaces a prompt-safe routing brief on each user prompt. Advisory only and fail-open.\n trigger_phrases:\n   - \"skill advisor hook reference\"\n   - \"native-first advisor hooks\"\n@@ -9,7 +9,7 @@ trigger_phrases:\n   - \"advisor hook smoke tests\"\n importance_tier: important\n contextType: implementation\n-version: 3.6.18.0\n+version: 3.6.20.0\n ---\n \n # Skill Advisor Hook Reference\n@@ -81,7 +81,7 @@ Rows below the threshold are discarded before either rule applies. The degraded\n \n ## 3. PER-RUNTIME DELIVERY\n \n-Every native runtime, Pi and DSH run the same hook handler, which gates the prompt, calls the advisor CLI and renders with `renderAdvisorBrief`. The OpenCode plugin calls the CLI itself. The native adapters differ in prompt event, transport and delivery channel.\n+Every native runtime, Pi, DSH and Vibe run the same hook handler, which gates the prompt, calls the advisor CLI and renders with `renderAdvisorBrief`. The OpenCode plugin calls the CLI itself. The native adapters differ in prompt event, transport and delivery channel.\n \n | Runtime | Adapter | Event / wiring | Payload difference it handles | Delivery |\n |---|---|---|---|---|\n@@ -109,6 +109,7 @@ The document behind a surfaced command is `.skilled/commands/<group>/<name>.md`.\n | Pi | No model path found | The mirror is a pointer stub. Public Pi docs were not fetched, so this is unverified beyond the repository |\n | OpenCode | No documented model path. A parent process can start one with `opencode run --command` | Commands are user-triggered templates, while skills are loaded by the model through a skill tool |\n | DSH | No | dsh has no agent-file loader and no command loader |\n+| Vibe | No | Vibe has no command loader. The brief names each offered command's document, which the model reads in full |\n \n ---\n \n@@ -170,11 +171,15 @@ The advisor is enabled by default. Truthy disable values are `1`, `true`, `yes`,\n | Variable | Effect |\n |---|---|\n | `SYSTEM_SKILL_ADVISOR_DISABLED=1` | Canonical kill-switch. Every adapter checks `isHookEnabled('skill-advisor')` and returns empty/skipped prompt-safe output, and the `advisor_recommend` direct call abstains. |\n-| `SYSTEM_SKILL_ADVISOR_HOOK_DISABLED=1` | Alias. Disables the native adapters and makes the `advisor_recommend` direct call abstain. |\n+| `SYSTEM_SKILL_ADVISOR_HOOK_DISABLED=1` | Alias. Disables every adapter and makes the `advisor_recommend` direct call abstain. |\n | `SYSTEM_SKILL_ADVISOR_PLUGIN_DISABLED=1` | Alias. Disables every adapter and makes the `advisor_recommend` direct call abstain. |\n-| `SPECKIT_SKILL_ADVISOR_HOOK_DISABLED=1` | Legacy alias for the native adapters and the `advisor_recommend` direct call. The standalone Python CLI (`skill_advisor.py`) reads only this name, set to exactly `1`, from `runtime/schemas/compat-contract.json`. |\n+| `SPECKIT_SKILL_ADVISOR_HOOK_DISABLED=1` | Legacy alias that disables every adapter and makes the `advisor_recommend` direct call abstain. The standalone Python CLI (`skill_advisor.py`) reads only this name, set to exactly `1`, from `runtime/schemas/compat-contract.json`. |\n | `SPECKIT_SKILL_ADVISOR_PLUGIN_DISABLED=1` | Legacy alias. Disables every adapter and makes the `advisor_recommend` direct call abstain. |\n | `SYSTEM_HOOKS_DISABLED=1` | Master switch that disables this concern along with every other repo hook. |\n+| `MK_HOOKS_DISABLED=1` | Older alias of `SYSTEM_HOOKS_DISABLED`. Master switch that disables this concern along with every other repo hook. |\n+| `MK_SKILL_ADVISOR_DISABLED=1` | Older alias of `SYSTEM_SKILL_ADVISOR_DISABLED`. Every adapter checks `isHookEnabled('skill-advisor')` and returns empty/skipped prompt-safe output, and the `advisor_recommend` direct call abstains. |\n+| `MK_SKILL_ADVISOR_HOOK_DISABLED=1` | Older alias of `SYSTEM_SKILL_ADVISOR_HOOK_DISABLED`. Disables every adapter and makes the `advisor_recommend` direct call abstain. |\n+| `MK_SKILL_ADVISOR_PLUGIN_DISABLED=1` | Older alias of `SYSTEM_SKILL_ADVISOR_PLUGIN_DISABLED`. Disables every adapter and makes the `advisor_recommend` direct call abstain. |\n \n The direct call decides in the caller's own process, by the same resolution the adapters use. `node .skilled/bin/skill-advisor.cjs advisor_recommend` asks `hookFlagDecision('skill-advisor')` in `.skilled/hooks/shared/hook-flags.cjs`, with the caller's environment over `.skilled/hooks/hook-flags.env`, before it connects to a daemon or runs the local scorer. Whenever the adapters are off, under any name in this table or its older `MK_` form, any truthy value or a line in the flags file, it prints the empty envelope with `ADVISOR_DISABLED` and names the switch that decided. A daemon reads the same names from its own environment and never reads the flags file, and the launcher passes no switch name and no `HOOK_FLAGS_CONFIG` to a daemon it starts, so a flagged command that happens to start the daemon does not leave it abstaining for every later caller. The standalone Python CLI keeps its own rule: only `SPECKIT_SKILL_ADVISOR_HOOK_DISABLED`, set to exactly `1`.\n \n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"git -c core.fsmonitor=false diff 2a1a42263cc d21dbc1cafe -- .skilled/skills/system-skill-advisor/hooks/skill-advisor-hook.md\",\"workdir\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research\"}"},"time":{"start":1794780695473,"end":1794780697065}}}}
{"type":"step_finish","timestamp":1794780698237,"sessionID":"ses_e1ebd75cbffeKCKhhfHEFy30Ji","part":{"id":"prt_1e144167d001nqJMKqvbewrZjK","sessionID":"ses_e1ebd75cbffeKCKhhfHEFy30Ji","messageID":"msg_1e143d676001xsebOJaKsbZt5p","type":"step-finish","reason":"tool-calls","snapshot":"23fdb2f4324e86228b479750e8866387f9b4e452","cost":0,"tokens":{"input":3100,"output":226,"reasoning":1165,"cache":{"read":60672,"write":0}}}}
{"type":"step_start","timestamp":1794780700439,"sessionID":"ses_e1ebd75cbffeKCKhhfHEFy30Ji","part":{"id":"prt_1e1441f17001OatZ2NxwQeioZd","sessionID":"ses_e1ebd75cbffeKCKhhfHEFy30Ji","messageID":"msg_1e1441682001WdNu5l7kiFn9Ea","type":"step-start","snapshot":"23fdb2f4324e86228b479750e8866387f9b4e452"}}
{"type":"tool_use","timestamp":1794780715381,"sessionID":"ses_e1ebd75cbffeKCKhhfHEFy30Ji","part":{"partID":"prt_1e1445847002ZA1zE9izIRmyOa","sessionID":"ses_e1ebd75cbffeKCKhhfHEFy30Ji","messageID":"msg_1e1441682001WdNu5l7kiFn9Ea","type":"tool","id":"call_268484be137d4e9fa7d0a460","tool":"read","state":{"status":"completed","input":{"path":".skilled/skills/system-skill-advisor/hooks/vibe/prompt-advisor.mjs"},"output":"Read file .skilled/skills/system-skill-advisor/hooks/vibe/prompt-advisor.mjs, lines 1-242\n1: // ───────────────────────────────────────────────────────────────────\n2: // MODULE: Vibe Prompt Advisor Part\n3: // ───────────────────────────────────────────────────────────────────\n4: // The turn-start composer's advisor part. Vibe runs a fresh hook process for\n5: // every turn, so the receipts that keep a brief from repeating have to survive\n6: // the process: the shared handler's own file-backed store drops the constant\n7: // directive block once it is proven delivered, and a per-session head receipt\n8: // drops the routing head while the route has not changed. A child session, a\n9: // subagent and a blank prompt get nothing. Every failure contributes no text,\n10: // so a slow or broken advisor never blocks the turn.\n11: \n12: // ─────────────────────────────────────────────────────────────────────────────\n13: // 1. IMPORTS\n14: // ─────────────────────────────────────────────────────────────────────────────\n15: \n16: import { createHash } from 'node:crypto';\n17: import { existsSync, mkdirSync, readFileSync, readdirSync, statSync, unlinkSync, writeFileSync } from 'node:fs';\n18: import { tmpdir } from 'node:os';\n19: import { dirname, join, resolve } from 'node:path';\n20: import { fileURLToPath } from 'node:url';\n21: \n22: import { isHookEnabled } from '../../../../hooks/shared/hook-flags.mjs';\n23: \n24: // ─────────────────────────────────────────────────────────────────────────────\n25: // 2. CONSTANTS\n26: // ─────────────────────────────────────────────────────────────────────────────\n27: \n28: // A Vibe session runs in a throwaway folder, so the checkout is located from\n29: // this file instead: vibe -> hooks -> system-skill-advisor -> skills -> .skilled -> root.\n30: const REPO_ROOT = resolve(dirname(fileURLToPath(import.meta.url)), '../../../../..');\n31: \n32: const ADVISOR_MODULE_URL = new URL(\n33:   '../../runtime/dist/hooks/claude/user-prompt-submit.js',\n34:   import.meta.url,\n35: ).href;\n36: \n37: // Mirrors the advisor renderer's directive label. A brief that drifts past it is\n38: // never split, so it is always delivered whole.\n39: const DIRECTIVE_SEPARATOR = '\\nDirectives:';\n40: const CHILD_SESSION_ENV = 'AI_SESSION_CHILD';\n41: // The directive store's own base directory, so one switch isolates both receipts\n42: // in a test or a scratch run.\n43: const STATE_DIR_ENV = 'SPECKIT_DIRECTIVE_LIFECYCLE_STATE_DIR';\n44: const HEAD_RECEIPT_SUBDIR = 'vibe-turn-start';\n45: const MAX_HEAD_RECEIPTS = 64;\n46: // Vibe has no command loader and its prompt stubs name the dash form, so a head\n47: // that names a command is the one place a model learns which document to read.\n48: const COMMAND_DOCUMENT_LABEL = 'Command documents (read in full before taking one): ';\n49: const COMMAND_TOKEN_PATTERN = /(?:^|[\\s(])\\/([a-z][a-z0-9-]*)(?::([a-z][a-z0-9-]*))?/g;\n50: \n51: export const ERROR_POLICY = 'fail-open';\n52: // The advisor keys its metrics and outcome records by runtime and drops a label it does not list.\n53: export const ADVISOR_RUNTIME = 'vibe';\n54: \n55: // ─────────────────────────────────────────────────────────────────────────────\n56: // 3. HELPERS\n57: // ─────────────────────────────────────────────────────────────────────────────\n58: \n59: // A dispatched child inherits AI_SESSION_CHILD=1, and a subagent Vibe spawned\n60: // itself carries a parent session id. Either marks a session whose prompt is a\n61: // fixed task, where a route suggestion is noise.\n62: function isChildSession(payload, env) {\n63:   if (String(env[CHILD_SESSION_ENV] ?? '').trim() === '1') return true;\n64:   const parent = payload?.parent_session_id;\n65:   return typeof parent === 'string' && parent.trim() !== '';\n66: }\n67: \n68: function headReceiptDir(env) {\n69:   const configured = env[STATE_DIR_ENV]?.trim();\n70:   const base = configured ? resolve(configured) : join(tmpdir(), 'speckit-advisor');\n71:   return join(base, HEAD_RECEIPT_SUBDIR);\n72: }\n73: \n74: function headReceiptPath(sessionId, env) {\n75:   const digest = createHash('sha256').update(sessionId).digest('hex').slice(0, 16);\n76:   return join(headReceiptDir(env), `${digest}.head`);\n77: }\n78: \n79: function readHeadReceipt(sessionId, env = process.env) {\n80:   try {\n81:     return readFileSync(headReceiptPath(sessionId, env), 'utf8');\n82:   } catch {\n83:     return '';\n84:   }\n85: }\n86: \n87: // The folder is bounded the way the directive store bounds its sessions, so a\n88: // long-lived machine does not keep one file per session forever.\n89: function evictOldestReceipts(directory) {\n90:   const names = readdirSync(directory).filter((name) => name.endsWith('.head'));\n91:   if (names.length < MAX_HEAD_RECEIPTS) return;\n92:   const oldest = names\n93:     .map((name) => ({ name, mtime: statSync(join(directory, name)).mtimeMs }))\n94:     .sort((left, right) => left.mtime - right.mtime)\n95:     .slice(0, names.length - MAX_HEAD_RECEIPTS + 1);\n96:   for (const entry of oldest) unlinkSync(join(directory, entry.name));\n97: }\n98: \n99: function writeHeadReceipt(sessionId, head, env = process.env) {\n100:   try {\n101:     const directory = headReceiptDir(env);\n102:     mkdirSync(directory, { recursive: true, mode: 0o700 });\n103:     const target = headReceiptPath(sessionId, env);\n104:     if (!existsSync(target)) evictOldestReceipts(directory);\n105:     writeFileSync(target, head, { mode: 0o600 });\n106:   } catch {\n107:     // A receipt that cannot be written only costs a repeated head next turn.\n108:   }\n109: }\n110: \n111: /**\n112:  * Name the canonical document of each command the routing head mentions.\n113:  *\n114:  * Vibe has no command loader and its prompt stubs name the dash form, so the\n115:  * head is where each offered command's document has to be named. The line is\n116:  * added before the head receipt, so two equal heads stay equal and a repeated\n117:  * brief is still dropped.\n118:  *\n119:  * @param {string} context - The advisor's additional context.\n120:  * @param {string} [root] - The checkout the document paths resolve under.\n121:  * @returns {string} The context with one document line, or unchanged.\n122:  */\n123: export function withCommandDocuments(context, root = REPO_ROOT) {\n124:   try {\n125:     // A context that opens with the directive label has no routing head for a\n126:     // document line to sit under, and its block is the handler's to deliver.\n127:     const label = DIRECTIVE_SEPARATOR.slice(1);\n128:     if (context.startsWith(label)) return context;\n129: \n130:     const separator = context.indexOf(DIRECTIVE_SEPARATOR);\n131:     const head = separator > 0 ? context.slice(0, separator) : context;\n132:     const rest = separator > 0 ? context.slice(separator) : '';\n133: \n134:     const documents = [];\n135:     for (const [, namespace, name] of head.matchAll(COMMAND_TOKEN_PATTERN)) {\n136:       const command = name ? `/${namespace}:${name}` : `/${namespace}`;\n137:       const relative = name\n138:         ? `.skilled/commands/${namespace}/${name}.md`\n139:         : `.skilled/commands/${namespace}.md`;\n140:       if (documents.some((document) => document.relative === relative)) continue;\n141:       if (!existsSync(join(root, relative))) continue;\n142:       documents.push({ command, relative });\n143:     }\n144:     if (documents.length === 0) return context;\n145: \n146:     const pairs = documents\n147:       .map((document) => `${document.command} is ${document.relative}`)\n148:       .join(', ');\n149:     return `${head}\\n${COMMAND_DOCUMENT_LABEL}${pairs}.${rest}`;\n150:   } catch {\n151:     return context;\n152:   }\n153: }\n154: \n155: /**\n156:  * Drop the routing head when this session already received it unchanged.\n157:  *\n158:  * A brief that still carries its directive block is delivered whole: the shared\n159:  * handler owns that block's lifecycle, and its presence means the block has not\n160:  * been proven delivered yet. A head-only brief is the handler's reduced repeat,\n161:  * so the head receipt decides whether even that text adds anything.\n162:  *\n163:  * @param {string} context - The advisor's additional context.\n164:  * @param {string} sessionId - The Vibe session id, the receipt key.\n165:  * @param {{read?: Function, write?: Function, env?: Object}} [receipts] - Injectable for tests.\n166:  * @returns {string} The text to deliver, or an empty string to deliver nothing.\n167:  */\n168: export function reduceRepeatedHead(context, sessionId, {\n169:   read = readHeadReceipt,\n170:   write = writeHeadReceipt,\n171:   env = process.env,\n172: } = {}) {\n173:   if (typeof sessionId !== 'string' || !sessionId.trim()) return context;\n174: \n175:   const separator = context.indexOf(DIRECTIVE_SEPARATOR);\n176:   if (separator > 0) {\n177:     write(sessionId, context.slice(0, separator), env);\n178:     return context;\n179:   }\n180:   // An older build rendered the no-brief fallback as the directive block alone.\n181:   // Its block is the handler's to dedupe, and there is no head to compare.\n182:   const label = DIRECTIVE_SEPARATOR.slice(1);\n183:   if (context.startsWith(label)) return context;\n184: \n185:   if (read(sessionId, env) === context) return '';\n186:   write(sessionId, context, env);\n187:   return context;\n188: }\n189: \n190: async function runAdvisor(input) {\n191:   const advisor = await import(ADVISOR_MODULE_URL);\n192:   return advisor.handleClaudeUserPromptSubmit(input, {\n193:     runtime: ADVISOR_RUNTIME,\n194:     writeDiagnostic: () => {},\n195:   });\n196: }\n197: \n198: // ─────────────────────────────────────────────────────────────────────────────\n199: // 4. CORE LOGIC\n200: // ─────────────────────────────────────────────────────────────────────────────\n201: \n202: /**\n203:  * Build the advisor part of one turn-start context.\n204:  *\n205:  * @param {Object} payload - The Vibe pre_agent payload.\n206:  * @param {Object} [dependencies] - Injectable for deterministic tests.\n207:  * @returns {Promise<string>} The advisor brief, or an empty string.\n208:  */\n209: export async function buildAdvisorPart(payload, {\n210:   run = runAdvisor,\n211:   env = process.env,\n212:   isEnabled = isHookEnabled,\n213:   read = readHeadReceipt,\n214:   write = writeHeadReceipt,\n215: } = {}) {\n216:   try {\n217:     if (!payload || payload.hook_event_name !== 'pre_agent') return '';\n218:     if (isChildSession(payload, env)) return '';\n219: \n220:     const prompt = typeof payload.prompt === 'string' ? payload.prompt : '';\n221:     if (!prompt.trim()) return '';\n222:     if (isEnabled('skill-advisor') === false) return '';\n223: \n224:     const sessionId = typeof payload.session_id === 'string' ? payload.session_id : '';\n225:     const transcriptPath = typeof payload.transcript_path === 'string' && payload.transcript_path\n226:       ? payload.transcript_path\n227:       : undefined;\n228:     const output = await run({\n229:       prompt,\n230:       cwd: REPO_ROOT,\n231:       session_id: sessionId,\n232:       transcript_path: transcriptPath,\n233:       hook_event_name: 'UserPromptSubmit',\n234:     });\n235: \n236:     const context = output?.hookSpecificOutput?.additionalContext;\n237:     if (typeof context !== 'string' || !context.trim()) return '';\n238:     return reduceRepeatedHead(withCommandDocuments(context), sessionId, { read, write, env });\n239:   } catch {\n240:     return '';\n241:   }\n242: }","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file .skilled/skills/system-skill-advisor/hooks/vibe/prompt-advisor.mjs, lines 1-242\n1: // ───────────────────────────────────────────────────────────────────\n2: // MODULE: Vibe Prompt Advisor Part\n3: // ───────────────────────────────────────────────────────────────────\n4: // The turn-start composer's advisor part. Vibe runs a fresh hook process for\n5: // every turn, so the receipts that keep a brief from repeating have to survive\n6: // the process: the shared handler's own file-backed store drops the constant\n7: // directive block once it is proven delivered, and a per-session head receipt\n8: // drops the routing head while the route has not changed. A child session, a\n9: // subagent and a blank prompt get nothing. Every failure contributes no text,\n10: // so a slow or broken advisor never blocks the turn.\n11: \n12: // ─────────────────────────────────────────────────────────────────────────────\n13: // 1. IMPORTS\n14: // ─────────────────────────────────────────────────────────────────────────────\n15: \n16: import { createHash } from 'node:crypto';\n17: import { existsSync, mkdirSync, readFileSync, readdirSync, statSync, unlinkSync, writeFileSync } from 'node:fs';\n18: import { tmpdir } from 'node:os';\n19: import { dirname, join, resolve } from 'node:path';\n20: import { fileURLToPath } from 'node:url';\n21: \n22: import { isHookEnabled } from '../../../../hooks/shared/hook-flags.mjs';\n23: \n24: // ─────────────────────────────────────────────────────────────────────────────\n25: // 2. CONSTANTS\n26: // ─────────────────────────────────────────────────────────────────────────────\n27: \n28: // A Vibe session runs in a throwaway folder, so the checkout is located from\n29: // this file instead: vibe -> hooks -> system-skill-advisor -> skills -> .skilled -> root.\n30: const REPO_ROOT = resolve(dirname(fileURLToPath(import.meta.url)), '../../../../..');\n31: \n32: const ADVISOR_MODULE_URL = new URL(\n33:   '../../runtime/dist/hooks/claude/user-prompt-submit.js',\n34:   import.meta.url,\n35: ).href;\n36: \n37: // Mirrors the advisor renderer's directive label. A brief that drifts past it is\n38: // never split, so it is always delivered whole.\n39: const DIRECTIVE_SEPARATOR = '\\nDirectives:';\n40: const CHILD_SESSION_ENV = 'AI_SESSION_CHILD';\n41: // The directive store's own base directory, so one switch isolates both receipts\n42: // in a test or a scratch run.\n43: const STATE_DIR_ENV = 'SPECKIT_DIRECTIVE_LIFECYCLE_STATE_DIR';\n44: const HEAD_RECEIPT_SUBDIR = 'vibe-turn-start';\n45: const MAX_HEAD_RECEIPTS = 64;\n46: // Vibe has no command loader and its prompt stubs name the dash form, so a head\n47: // that names a command is the one place a model learns which document to read.\n48: const COMMAND_DOCUMENT_LABEL = 'Command documents (read in full before taking one): ';\n49: const COMMAND_TOKEN_PATTERN = /(?:^|[\\s(])\\/([a-z][a-z0-9-]*)(?::([a-z][a-z0-9-]*))?/g;\n50: \n51: export const ERROR_POLICY = 'fail-open';\n52: // The advisor keys its metrics and outcome records by runtime and drops a label it does not list.\n53: export const ADVISOR_RUNTIME = 'vibe';\n54: \n55: // ─────────────────────────────────────────────────────────────────────────────\n56: // 3. HELPERS\n57: // ─────────────────────────────────────────────────────────────────────────────\n58: \n59: // A dispatched child inherits AI_SESSION_CHILD=1, and a subagent Vibe spawned\n60: // itself carries a parent session id. Either marks a session whose prompt is a\n61: // fixed task, where a route suggestion is noise.\n62: function isChildSession(payload, env) {\n63:   if (String(env[CHILD_SESSION_ENV] ?? '').trim() === '1') return true;\n64:   const parent = payload?.parent_session_id;\n65:   return typeof parent === 'string' && parent.trim() !== '';\n66: }\n67: \n68: function headReceiptDir(env) {\n69:   const configured = env[STATE_DIR_ENV]?.trim();\n70:   const base = configured ? resolve(configured) : join(tmpdir(), 'speckit-advisor');\n71:   return join(base, HEAD_RECEIPT_SUBDIR);\n72: }\n73: \n74: function headReceiptPath(sessionId, env) {\n75:   const digest = createHash('sha256').update(sessionId).digest('hex').slice(0, 16);\n76:   return join(headReceiptDir(env), `${digest}.head`);\n77: }\n78: \n79: function readHeadReceipt(sessionId, env = process.env) {\n80:   try {\n81:     return readFileSync(headReceiptPath(sessionId, env), 'utf8');\n82:   } catch {\n83:     return '';\n84:   }\n85: }\n86: \n87: // The folder is bounded the way the directive store bounds its sessions, so a\n88: // long-lived machine does not keep one file per session forever.\n89: function evictOldestReceipts(directory) {\n90:   const names = readdirSync(directory).filter((name) => name.endsWith('.head'));\n91:   if (names.length < MAX_HEAD_RECEIPTS) return;\n92:   const oldest = names\n93:     .map((name) => ({ name, mtime: statSync(join(directory, name)).mtimeMs }))\n94:     .sort((left, right) => left.mtime - right.mtime)\n95:     .slice(0, names.length - MAX_HEAD_RECEIPTS + 1);\n96:   for (const entry of oldest) unlinkSync(join(directory, entry.name));\n97: }\n98: \n99: function writeHeadReceipt(sessionId, head, env = process.env) {\n100:   try {\n101:     const directory = headReceiptDir(env);\n102:     mkdirSync(directory, { recursive: true, mode: 0o700 });\n103:     const target = headReceiptPath(sessionId, env);\n104:     if (!existsSync(target)) evictOldestReceipts(directory);\n105:     writeFileSync(target, head, { mode: 0o600 });\n106:   } catch {\n107:     // A receipt that cannot be written only costs a repeated head next turn.\n108:   }\n109: }\n110: \n111: /**\n112:  * Name the canonical document of each command the routing head mentions.\n113:  *\n114:  * Vibe has no command loader and its prompt stubs name the dash form, so the\n115:  * head is where each offered command's document has to be named. The line is\n116:  * added before the head receipt, so two equal heads stay equal and a repeated\n117:  * brief is still dropped.\n118:  *\n119:  * @param {string} context - The advisor's additional context.\n120:  * @param {string} [root] - The checkout the document paths resolve under.\n121:  * @returns {string} The context with one document line, or unchanged.\n122:  */\n123: export function withCommandDocuments(context, root = REPO_ROOT) {\n124:   try {\n125:     // A context that opens with the directive label has no routing head for a\n126:     // document line to sit under, and its block is the handler's to deliver.\n127:     const label = DIRECTIVE_SEPARATOR.slice(1);\n128:     if (context.startsWith(label)) return context;\n129: \n130:     const separator = context.indexOf(DIRECTIVE_SEPARATOR);\n131:     const head = separator > 0 ? context.slice(0, separator) : context;\n132:     const rest = separator > 0 ? context.slice(separator) : '';\n133: \n134:     const documents = [];\n135:     for (const [, namespace, name] of head.matchAll(COMMAND_TOKEN_PATTERN)) {\n136:       const command = name ? `/${namespace}:${name}` : `/${namespace}`;\n137:       const relative = name\n138:         ? `.skilled/commands/${namespace}/${name}.md`\n139:         : `.skilled/commands/${namespace}.md`;\n140:       if (documents.some((document) => document.relative === relative)) continue;\n141:       if (!existsSync(join(root, relative))) continue;\n142:       documents.push({ command, relative });\n143:     }\n144:     if (documents.length === 0) return context;\n145: \n146:     const pairs = documents\n147:       .map((document) => `${document.command} is ${document.relative}`)\n148:       .join(', ');\n149:     return `${head}\\n${COMMAND_DOCUMENT_LABEL}${pairs}.${rest}`;\n150:   } catch {\n151:     return context;\n152:   }\n153: }\n154: \n155: /**\n156:  * Drop the routing head when this session already received it unchanged.\n157:  *\n158:  * A brief that still carries its directive block is delivered whole: the shared\n159:  * handler owns that block's lifecycle, and its presence means the block has not\n160:  * been proven delivered yet. A head-only brief is the handler's reduced repeat,\n161:  * so the head receipt decides whether even that text adds anything.\n162:  *\n163:  * @param {string} context - The advisor's additional context.\n164:  * @param {string} sessionId - The Vibe session id, the receipt key.\n165:  * @param {{read?: Function, write?: Function, env?: Object}} [receipts] - Injectable for tests.\n166:  * @returns {string} The text to deliver, or an empty string to deliver nothing.\n167:  */\n168: export function reduceRepeatedHead(context, sessionId, {\n169:   read = readHeadReceipt,\n170:   write = writeHeadReceipt,\n171:   env = process.env,\n172: } = {}) {\n173:   if (typeof sessionId !== 'string' || !sessionId.trim()) return context;\n174: \n175:   const separator = context.indexOf(DIRECTIVE_SEPARATOR);\n176:   if (separator > 0) {\n177:     write(sessionId, context.slice(0, separator), env);\n178:     return context;\n179:   }\n180:   // An older build rendered the no-brief fallback as the directive block alone.\n181:   // Its block is the handler's to dedupe, and there is no head to compare.\n182:   const label = DIRECTIVE_SEPARATOR.slice(1);\n183:   if (context.startsWith(label)) return context;\n184: \n185:   if (read(sessionId, env) === context) return '';\n186:   write(sessionId, context, env);\n187:   return context;\n188: }\n189: \n190: async function runAdvisor(input) {\n191:   const advisor = await import(ADVISOR_MODULE_URL);\n192:   return advisor.handleClaudeUserPromptSubmit(input, {\n193:     runtime: ADVISOR_RUNTIME,\n194:     writeDiagnostic: () => {},\n195:   });\n196: }\n197: \n198: // ─────────────────────────────────────────────────────────────────────────────\n199: // 4. CORE LOGIC\n200: // ─────────────────────────────────────────────────────────────────────────────\n201: \n202: /**\n203:  * Build the advisor part of one turn-start context.\n204:  *\n205:  * @param {Object} payload - The Vibe pre_agent payload.\n206:  * @param {Object} [dependencies] - Injectable for deterministic tests.\n207:  * @returns {Promise<string>} The advisor brief, or an empty string.\n208:  */\n209: export async function buildAdvisorPart(payload, {\n210:   run = runAdvisor,\n211:   env = process.env,\n212:   isEnabled = isHookEnabled,\n213:   read = readHeadReceipt,\n214:   write = writeHeadReceipt,\n215: } = {}) {\n216:   try {\n217:     if (!payload || payload.hook_event_name !== 'pre_agent') return '';\n218:     if (isChildSession(payload, env)) return '';\n219: \n220:     const prompt = typeof payload.prompt === 'string' ? payload.prompt : '';\n221:     if (!prompt.trim()) return '';\n222:     if (isEnabled('skill-advisor') === false) return '';\n223: \n224:     const sessionId = typeof payload.session_id === 'string' ? payload.session_id : '';\n225:     const transcriptPath = typeof payload.transcript_path === 'string' && payload.transcript_path\n226:       ? payload.transcript_path\n227:       : undefined;\n228:     const output = await run({\n229:       prompt,\n230:       cwd: REPO_ROOT,\n231:       session_id: sessionId,\n232:       transcript_path: transcriptPath,\n233:       hook_event_name: 'UserPromptSubmit',\n234:     });\n235: \n236:     const context = output?.hookSpecificOutput?.additionalContext;\n237:     if (typeof context !== 'string' || !context.trim()) return '';\n238:     return reduceRepeatedHead(withCommandDocuments(context), sessionId, { read, write, env });\n239:   } catch {\n240:     return '';\n241:   }\n242: }"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\".skilled/skills/system-skill-advisor/hooks/vibe/prompt-advisor.mjs\"}"},"time":{"start":1794780715079,"end":1794780715381}}}}
