\n104:  if (ORIGINAL_HOOK_FLAGS_CONFIG === undefined) delete process.env.HOOK_FLAGS_CONFIG;\n105:  else process.env.HOOK_FLAGS_CONFIG = ORIGINAL_HOOK_FLAGS_CONFIG;\n416:  it('AS4b honors SYSTEM_SKILL_ADVISOR_DISABLED=1 through the repo hook resolver without calling the producer', async () => {\n417:    process.env.SYSTEM_SKILL_ADVISOR_DISABLED = '1';\n418:    process.env.HOOK_FLAGS_CONFIG = '/dev/null';\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"ls -la .skilled/hooks/hook-flags.env 2>/dev/null || echo \\\"NO_FLAGS_FILE\\\"; echo ===; grep -n \\\"HOOK_FLAGS_CONFIG\\\\|_resetConfigCache\\\\|skillAdvisorHookEnabled\\\\|SYSTEM_SKILL_ADVISOR_DISABLED\\\" .skilled/skills/system-skill-advisor/runtime/tests/hooks/claude-user-prompt-submit-hook.vitest.ts\",\"workdir\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research\"}"},"time":{"start":1794780945275,"end":1794780948116}}}}
