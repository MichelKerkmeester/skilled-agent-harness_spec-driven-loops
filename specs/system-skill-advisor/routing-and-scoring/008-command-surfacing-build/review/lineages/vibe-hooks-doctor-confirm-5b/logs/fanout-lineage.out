  file: '.claude/settings.json',\n45:     event: 'UserPromptSubmit',\n46:     marker: 'hooks/claude/user-prompt-submit.js',\n47:   },\n48:   {\n49:     id: 'codex',\n50:     dir: '.codex',\n51:     file: '.codex/hooks.json',\n52:     event: 'UserPromptSubmit',\n53:     marker: 'hooks/codex/user-prompt-submit.js',\n54:   },\n55:   {\n56:     id: 'cursor',\n57:     dir: '.cursor',\n58:     file: '.cursor/hooks.json',\n59:     event: 'beforeSubmitPrompt',\n60:     marker: 'hooks/cursor/user-prompt-submit.js',\n61:   },\n62:   {\n63:     id: 'devin',\n64:     dir: '.devin',\n65:     file: '.devin/hooks.v1.json',\n66:     event: 'UserPromptSubmit',\n67:     marker: 'hooks/devin/user-prompt-submit.js',\n68:   },\n69:   {\n70:     id: 'vibe',\n71:     dir: '.vibe',\n72:     file: '.vibe/hooks.toml',\n73:     event: 'pre_agent',\n74:     marker: 'hooks/session-lifecycle/vibe/turn-start.mjs',\n75:     format: 'toml',\n76:   },\n77: ];\n78: \n79: // ─────────────────────────────────────────────────────────────────────────────\n80: // 3. HELPERS\n81: // ─────────────────────────────────────────────────────────────────────────────\n82: \n83: function fail(message) {\n84:   process.stderr.write(`hook-wiring-check: ${message}\\n`);\n85:   process.exit(2);\n86: }\n87: \n88: function parseArgs(argv) {\n89:   const opts = { root: null, json: false };\n90:   for (let i = 0; i < argv.length; i += 1) {\n91:     const arg = argv[i];\n92:     if (arg === '--json') {\n93:       opts.json = true;\n94:     } else if (arg === '--root') {\n95:       const value = argv[i + 1];\n96:       if (!value || value.startsWith('-')) fail(`--root needs a directory\\n${USAGE}`);\n97:       opts.root = path.resolve(value);\n98:       i += 1;\n99:     } else {\n100:       fail(`unknown argument: ${arg}\\n${USAGE}`);\n101:     }\n102:   }\n103:   if (!opts.root) fail(`--root is required\\n${USAGE}`);\n104:   if (!fs.existsSync(opts.root) || !fs.statSync(opts.root).isDirectory()) {\n105:     fail(`root not found: ${opts.root}`);\n106:   }\n107:   return opts;\n108: }\n109: \n110: // Hook files either wrap their events in a `hooks` object or place them at the\n111: // top level, and the cursor file omits the nested hook array the others carry.\n112: // A mention is not a wired hook, so only a command that runs the script counts:\n113: // the event's entries and their nested hooks arrays are walked for command\n114: // entries, and a runtime is wired when one starts node on the marker path.\n115: function eventPayload(document, event) {\n116:   if (!document || typeof document !== 'object') return undefined;\n117:   if (document.hooks && typeof document.hooks === 'object' && event in document.hooks) {\n118:     return document.hooks[event];\n119:   }\n120:   if (event in document) return document[event];\n121:   return undefined;\n122: }\n123: \n124: // A shell groups quoted text into one word and ends a simple command at an\n125: // operator that stands outside quotes, even one stuck to the word before it.\n126: // Reading the words first keeps an echo of a quoted script a mention, because a\n127: // quoted word is only an argument unless a shell is told to run it.\n128: function readWords(command) {\n129:   const words = [];\n130:   let text = '';\n131:   let started = false;\n132: \n133:   function flush() {\n134:     if (!started) return;\n135:     words.push({ text, separator: false });\n136:     text = '';\n137:     started = false;\n138:   }\n139: \n140:   for (let i = 0; i < command.length; i += 1) {\n141:     const char = command[i];\n142:     if (char === \"'\" || char === '\"') {\n143:       started = true;\n144:       i += 1;\n145:       // A shell refuses a line whose quote never closes, so nothing in it runs.\n146:       if (command.indexOf(char, i) === -1) return [];\n147:       while (i < command.length && command[i] !== char) {\n148:         if (char === '\"' && command[i] === '\\\\' && i + 1 < command.length) {\n149:           text += command[i + 1];\n1