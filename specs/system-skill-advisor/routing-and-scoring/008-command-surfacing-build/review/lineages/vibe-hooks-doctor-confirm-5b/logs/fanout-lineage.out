{"type":"tool_use","timestamp":1794780731028,"sessionID":"ses_e1ebd75cbffeKCKhhfHEFy30Ji","part":{"partID":"prt_1e14494d9001sKnp8xCVTw9byx","sessionID":"ses_e1ebd75cbffeKCKhhfHEFy30Ji","messageID":"msg_1e1445e00001wEkOfbkT9gP6L0","type":"tool","id":"call_9fa488a8d7ca44cf9f1a423d","tool":"read","state":{"status":"completed","input":{"path":".skilled/skills/system-skill-advisor/hooks/claude/user-prompt-submit.ts","limit":140},"output":"Read file .skilled/skills/system-skill-advisor/hooks/claude/user-prompt-submit.ts, lines 1-140\n1: #!/usr/bin/env node\n2: // ───────────────────────────────────────────────────────────────\n3: // MODULE: UserPromptSubmit Hook — Skill Advisor Brief\n4: // ───────────────────────────────────────────────────────────────\n5: // Runs on Claude Code UserPromptSubmit. Emits a JSON additionalContext\n6: // envelope for model-visible advisor guidance and fails open on all errors.\n7: \n8: // ───────────────────────────────────────────────────────────────\n9: // 1. IMPORTS\n10: // ───────────────────────────────────────────────────────────────\n11: \n12: import { existsSync, statSync } from 'node:fs';\n13: import { createRequire } from 'node:module';\n14: import { performance } from 'node:perf_hooks';\n15: import { dirname, join, resolve } from 'node:path';\n16: import { fileURLToPath } from 'node:url';\n17: import { isAdvisorRuntime, type AdvisorRuntime } from '../../runtime/lib/advisor-runtime-values.js';\n18: import { findAdvisorWorkspaceRoot } from '../../runtime/lib/utils/workspace-root.js';\n19: import {\n20:   buildSkillAdvisorBrief,\n21:   skippedAdvisorResultFor,\n22:   type AdvisorHookResult,\n23:   type AdvisorHookStatus,\n24:   type AdvisorHookFreshness,\n25: } from '../../runtime/lib/skill-advisor-brief.js';\n26: import {\n27:   decideDirectiveLifecycleDelivery,\n28:   defaultDirectiveLifecycleStore,\n29:   isDirectiveLifecycleDedupEnabled,\n30:   type DirectiveLifecycleState,\n31: } from '../lib/directive-lifecycle.js';\n32: import {\n33:   renderAdvisorBrief,\n34:   renderAdvisorFallbackDirective,\n35:   observeEmittedAdvisorPolicy,\n36: } from '../../runtime/lib/render.js';\n37: import type { ShadowDeliveryRenderOptions } from '../../runtime/lib/render.js';\n38: import {\n39:   createAdvisorHookDiagnosticRecord,\n40:   persistAdvisorHookDiagnosticRecord,\n41:   serializeAdvisorHookDiagnosticRecord,\n42: } from '../../runtime/lib/metrics.js';\n43: import { buildSkillAdvisorBriefFromCli } from '../lib/skill-advisor-cli-fallback.js';\n44: \n45: export { renderAdvisorFallbackDirective };\n46: \n47: // ───────────────────────────────────────────────────────────────\n48: // 2. CONFIGURATION\n49: // ───────────────────────────────────────────────────────────────\n50: \n51: const IS_CLI_ENTRY = process.argv[1]\n52:   ? resolve(process.argv[1]) === fileURLToPath(import.meta.url)\n53:   : false;\n54: \n55: const requireFromAdvisor = createRequire(import.meta.url);\n56: \n57: // Setup, install and configure words trigger the hint; check needs nearby tooling context.\n58: // Bounded context keeps unrelated checks quiet without scanning long prompts.\n59: export const SETUP_WORDING = new RegExp(\n60:   String.raw`\\b(?:set[\\s-]?up|setups?`\n61:     + String.raw`|(?:re)?install(?:s|ed|ing|ation|er|ers)?`\n62:     + String.raw`|configur(?:e|es|ed|ing|ations?)`\n63:     + String.raw`|check(?:s|ed|ing)?(?:\\s+\\S+){0,2}?\\s+`\n64:     + String.raw`(?:environment|env|config(?:s|urations?)?`\n65:     + String.raw`|hooks?|tools|tooling|toolchain|skilled))\\b`,\n66:   'i',\n67: );\n68: // The source and the built module sit at different depths below .skilled, so the\n69: // resolver is found by walking up rather than by counting parent hops. A missing\n70: // resolver answers as if no switch were set, as every adapter does.\n71: function hookFlagsResolverPath(): string | null {\n72:   let folder = dirname(fileURLToPath(import.meta.url));\n73:   while (true) {\n74:     const resolverPath = join(folder, 'hooks', 'shared', 'hook-flags.cjs');\n75:     if (existsSync(resolverPath)) return resolverPath;\n76:     const parent = dirname(folder);\n77:     if (parent === folder) return null;\n78:     folder = parent;\n79:   }\n80: }\n81: \n82: function skillAdvisorHookEnabled(): boolean {\n83:   try {\n84:     const resolverPath = hookFlagsResolverPath();\n85:     if (resolverPath === null) return true;\n86:     const { isHookEnabled } = requireFromAdvisor(resolverPath) as {\n87:       isHookEnabled?: (concern: string) => boolean;\n88:     };\n89:     return typeof isHookEnabled !== 'function' || isHookEnabled('skill-advisor') !== false;\n90:   } catch {\n91:     return true;\n92:   }\n93: }\n94: \n95: // ───────────────────────────────────────────────────────────────\n96: // 3. TYPES\n97: // ───────────────────────────────────────────────────────────────\n98: \n99: export interface ClaudeUserPromptSubmitInput {\n100:   readonly session_id?: string;\n101:   readonly session_identity_confirmed?: boolean;\n102:   readonly session_identity_ambiguous?: boolean;\n103:   readonly hook_event_name?: string;\n104:   readonly lifecycle_event?: string;\n105:   readonly lifecycle_source?: string;\n106:   readonly source?: string;\n107:   readonly scope_changed?: boolean;\n108:   readonly policy_set_changed?: boolean;\n109:   readonly goal_changed?: boolean;\n110:   readonly delivery_receipt_status?: 'configured' | 'observed' | 'unobserved' | 'unknown';\n111:   readonly prompt?: string;\n112:   readonly cwd?: string;\n113:   readonly transcript_path?: string;\n114:   readonly [key: string]: unknown;\n115: }\n116: \n117: export interface ClaudeHookSpecificOutput {\n118:   readonly hookSpecificOutput: {\n119:     readonly hookEventName: 'UserPromptSubmit';\n120:     readonly additionalContext: string;\n121:   };\n122: }\n123: \n124: export type ClaudeUserPromptSubmitOutput = ClaudeHookSpecificOutput | Record<string, never>;\n125: \n126: export interface UserPromptSubmitDependencies {\n127:   /** In-process callers such as Pi pass their runtime directly. */\n128:   readonly runtime?: AdvisorRuntime;\n129:   readonly buildBrief?: typeof buildSkillAdvisorBrief;\n130:   readonly buildCliBrief?: typeof buildSkillAdvisorBriefFromCli;\n131:   readonly renderBrief?: typeof renderAdvisorBrief;\n132:   readonly now?: () => number;\n133:   readonly writeDiagnostic?: (line: string) => void;\n134:   /** Per-session directive-lifecycle dedup state; defaults to the durable file-backed store. */\n135:   readonly directiveLifecycleStore?: DirectiveLifecycleState;\n136:   /** Delay a full-delivery receipt until the process handoff acknowledges stdout. */\n137:   readonly deferDirectiveReceipt?: boolean;\n138: }\n139: \n140: interface HookDiagnosticInput {\n[Output truncated. Continue reading with offset: 141]","title":"read","metadata":{"metadata":{"truncated":true},"content":[{"type":"text","text":"Read file .skilled/skills/system-skill-advisor/hooks/claude/user-prompt-submit.ts, lines 1-140\n1: #!/usr/bin/env node\n2: // ───────────────────────────────────────────────────────────────\n3: // MODULE: UserPromptSubmit Hook — Skill Advisor Brief\n4: // ───────────────────────────────────────────────────────────────\n5: // Runs on Claude Code UserPromptSubmit. Emits a JSON additionalContext\n6: // envelope for model-visible advisor guidance and fails open on all errors.\n7: \n8: // ───────────────────────────────────────────────────────────────\n9: // 1. IMPORTS\n10: // ───────────────────────────────────────────────────────────────\n11: \n12: import { existsSync, statSync } from 'node:fs';\n13: import { createRequire } from 'node:module';\n14: import { performance } from 'node:perf_hooks';\n15: import { dirname, join, resolve } from 'node:path';\n16: import { fileURLToPath } from 'node:url';\n17: import { isAdvisorRuntime, type AdvisorRuntime } from '../../runtime/lib/advisor-runtime-values.js';\n18: import { findAdvisorWorkspaceRoot } from '../../runtime/lib/utils/workspace-