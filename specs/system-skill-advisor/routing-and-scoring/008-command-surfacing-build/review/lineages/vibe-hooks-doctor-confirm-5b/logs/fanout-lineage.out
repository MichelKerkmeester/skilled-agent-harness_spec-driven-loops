sWith(\".head\")).length : 0;\nconsole.log(\"first:\", first === head, \"second-empty:\", second === \"\");\nconsole.log(\"injected receipts:\", count(injected), \"process receipts:\", count(processDir));\n'","workdir":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research"},"output":"syntax ok prompt-advisor\nsyntax ok hook-wiring\ndirective-only changed: false\nheaded document line: \"\\nCommand documents (read in full before taking one): /create:readme is .skilled/commands/create/readme.md.\"\nfirst: true second-empty: true\ninjected receipts: 1 process receipts: 0\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"syntax ok prompt-advisor\nsyntax ok hook-wiring\ndirective-only changed: false\nheaded document line: \"\\nCommand documents (read in full before taking one): /create:readme is .skilled/commands/create/readme.md.\"\nfirst: true second-empty: true\ninjected receipts: 1 process receipts: 0\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"LINEAGE=specs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/review/lineages/vibe-hooks-doctor-confirm-5b\\nmkdir -p \\\"$LINEAGE/probe/injected\\\" \\\"$LINEAGE/probe/process\\\"\\nnode --check .skilled/skills/system-skill-advisor/hooks/vibe/prompt-advisor.mjs && echo \\\"syntax ok prompt-advisor\\\"\\nnode --check .skilled/commands/doctor/scripts/hook-wiring-check.cjs && echo \\\"syntax ok hook-wiring\\\"\\nPROBE_DIR=\\\"$PWD/$LINEAGE/probe\\\" node --input-type=module -e '\\nimport { readdirSync, existsSync } from \\\"node:fs\\\";\\nimport { join } from \\\"node:path\\\";\\nconst { withCommandDocuments, reduceRepeatedHead } = await import(\\\"./.skilled/skills/system-skill-advisor/hooks/vibe/prompt-advisor.mjs\\\");\\nconst base = process.env.PROBE_DIR;\\nconst injected = join(base, \\\"injected\\\");\\nconst processDir = join(base, \\\"process\\\");\\nprocess.env.SPECKIT_DIRECTIVE_LIFECYCLE_STATE_DIR = processDir;\\n\\nconst fallback = \\\"Directives:\\\\n- When a save is due, run /speckit:save to record the session.\\\";\\nconsole.log(\\\"directive-only changed:\\\", withCommandDocuments(fallback) !== fallback);\\n\\nconst head = \\\"Advisor: live; use sk-doc → /create:readme (start) 0.94/0.12 pass.\\\";\\nconst withDoc = withCommandDocuments(head);\\nconsole.log(\\\"headed document line:\\\", JSON.stringify(withDoc.slice(head.length)));\\n\\nconst env = { SPECKIT_DIRECTIVE_LIFECYCLE_STATE_DIR: injected };\\nconst first = reduceRepeatedHead(head, \\\"probe-session-1\\\", { env });\\nconst second = reduceRepeatedHead(head, \\\"probe-session-1\\\", { env });\\nconst count = (dir) => existsSync(join(dir, \\\"vibe-turn-start\\\")) ? readdirSync(join(dir, \\\"vibe-turn-start\\\")).filter((n) => n.endsWith(\\\".head\\\")).length : 0;\\nconsole.log(\\\"first:\\\", first === head, \\\"second-empty:\\\", second === \\\"\\\");\\nconsole.log(\\\"injected receipts:\\\", count(injected), \\\"process receipts:\\\", count(processDir));\\n'\",\"workdir\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research\"}"},"time":{"start":1794781338619,"end":1794781342536}}}}
