ced`,\n277-    );\n278-  }\n279-});\n280-\n281-test('the contract fails when a mirror asset, step or repair line leaves the workflow', () => {\n282-  const workflowText = read(WORKFLOW_PATH);\n283-  for (const check of MIRROR_CHECKS) {\n284-    const withoutAsset = deleteLines(workflowText, (line) => line.includes(check.script));\n285-    assert.ok(\n286:      workflowGaps(withoutAsset).some((gap) => gap.includes(`upstream_assets.${check.key}`)),\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"grep -n \\\"MIRROR_CHECKS\\\" -A 30 .skilled/commands/doctor/scripts/tests/doctor-runtime-mirrors-contract.test.cjs | head -50; echo ===; grep -n \\\"routeGaps\\\\|workflowGaps\\\" -A 12 .skilled/commands/doctor/scripts/tests/doctor-runtime-mirrors-contract.test.cjs | head -60\",\"workdir\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research\"}"},"time":{"start":1794780956137,"end":1794780957104}}}}
