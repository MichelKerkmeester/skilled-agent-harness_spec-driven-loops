{"type":"tool_use","timestamp":1794815598369,"sessionID":"ses_e1ca84ea7ffeYndeEpFMNWYowo","part":{"partID":"prt_1e3589dcb0029O5wM8kD1gNoXQ","sessionID":"ses_e1ca84ea7ffeYndeEpFMNWYowo","messageID":"msg_1e3588f7c001VGs7F4Nxs85QX3","type":"tool","id":"call_544cfb465ce74b4c97db9e7b","tool":"shell","state":{"status":"completed","input":{"command":"grep -n \"phase_init\" -A 120 .skilled/commands/deep/assets/deep-review.yaml | head -220"},"output":"102:  trigger: \"At workflow START, before phase_init\"\n103-  purpose: \"Load prior review context for the target and buffer it until strategy.md exists\"\n104-  retrieval:\n105-    mechanism: \"continuity-ladder-then-ripgrep\"\n106-    note: \"File reads only. Nothing here needs a running daemon, and every step is reproducible by hand.\"\n107-    ladder:\n108-      - \"{spec_folder}/handover.md when present\"\n109-      - \"the _memory.continuity frontmatter block in {spec_folder}/implementation-summary.md\"\n110-      - \"the packet's canonical spec docs, spec.md and decision-record.md, for what the first two steps leave open\"\n111-    free_text_recipe: \"rg --no-config --json --fixed-strings --ignore-case -C 2 --glob '*.md' --glob '!**/z_archive/**' --glob '!**/node_modules/**' -- '{review_target}' specs .skilled\"\n112-    recipe_contract: \".skilled/skills/system-spec-kit/references/retrieval/retrieval-conventions.md\"\n113-    exit_status: \"0 is a hit set, 1 is a clean no-hit, 2 or higher is a failure that must be surfaced instead of reported as no-hit\"\n114-    ranking: \"Ripgrep does not rank. Order the hits caller-side with the tuple in retrieval-conventions.md section 5.\"\n115-  when_to_skip: [\"User says 'skip context' or 'fresh start'\"]\n116-  behavior:\n117-    if_context_found: \"Store full results as prior_context plus a concise prior_context_summary; inject after strategy.md is created.\"\n118-    if_no_context: \"Set prior_context and prior_context_summary to 'None' and continue.\"\n119-\n120-# ────────\n121-# SKILL REFERENCE\n122-# ────────\n123-skill_reference:\n124-  skill: system-deep-loop\n125-  skill_md: .skilled/skills/system-deep-loop/deep-review/SKILL.md\n126-  references:\n127-    loop_protocol: .skilled/skills/system-deep-loop/deep-review/references/protocol/loop-protocol.md\n128-    state_format: .skilled/skills/system-deep-loop/deep-review/references/state/state-format.md\n129-    convergence: .skilled/skills/system-deep-loop/deep-review/references/convergence/convergence.md\n130-  templates:\n131-    config: .skilled/skills/system-deep-loop/deep-review/assets/deep-review-config.json\n132-    strategy: .skilled/skills/system-deep-loop/deep-review/assets/deep-review-strategy.md\n133-\n134-# ────────\n135-# AGENT CONFIGURATION\n136-# ────────\n137-agent_config:\n138-  agent: deep-review\n139-  agent_file: \".skilled/agents/deep-review.md\"\n140-  # Canonical path. Runtime-specific directories (e.g. .claude/agents/) reference this source.\n141-  mode: subagent\n142-  model: opus\n143-  leaf_only: true\n144-  tools: [Read, Write, Edit, Bash, Grep, Glob]\n145-  mcp_servers: []\n146-\n147-# ────────\n148-# STATE FILE PATHS\n149-# ────────\n150-# ────────\n151-# CANONICAL STATE WRITE MECHANISM\n152-# ────────\n153-state_write_protocol:\n154-  mechanism: \"append-gateway\"\n155-  command: \"node .skilled/skills/system-deep-loop/runtime/scripts/append-mode-event.cjs --mode review --run-directory {artifact_dir} --event-json <record file>\"\n156-  applies_to: \"every append_to_jsonl and append_jsonl directive in this workflow\"\n157-  refusal_handling: \"halt on exit 2; never fall back to a direct file write. Exit 1 on a row that is still routed through the gateway is a workflow defect and halts; the pinned_bookkeeping rows are recorded through bookkeeping_log and are never routed.\"\n158-  pinned_bookkeeping:\n159-    events: [config_warning, lock_released, pivot_confirm_accepted, manualStop, pivot_override_accepted, maxDurationReached]\n160-    directive: \"bookkeeping_log\"\n161-    handling: \"These rows are workflow bookkeeping that the review ledger schema pins to the legacy path: they have no lossless review-event target, so the gateway would refuse them with exit 1 and write nothing. They are never sent to the gateway. The step prints the row in its log line and continues; none of them is a halt condition.\"\n162-  contract: |\n163-    The directives below specify WHAT to record; this block specifies the mechanism. The gateway\n164-    authorizes the write against the mode's durable authority record, serialises it behind the\n165-    ledger fence, returns a receipt, and refreshes state_log from the ledger. Exit 0 means the\n166-    record is durable in the ledger and the refreshed state_log carries it. Exit 2 means it was\n167-    refused, and the refusal names the check that failed.\n168-\n169-    Writing state_log directly bypasses ordering, authorization, and the receipt. Two writers\n170-    can then interleave with no shared ordering, and a record nobody authorized carries no\n171-    receipt, so a later reader cannot tell an accepted record from an invented one. A refusal\n172-    is a halt, never a reason to write the file directly.\n173-\n174-    There is no direct-append exception. state_log is a projection the gateway rebuilds from\n175-    the ledger, so a row written beside it is dropped by the next refresh: the migration\n176-    marker, the recovery baseline, the iteration-error row and the claim-adjudication gate\n177-    row are canonical ledger events like every other record.\n178-\n179-state_paths:\n180-  # Template paths document the canonical packet layout. Runtime resolution happens via\n181-  # step_resolve_artifact_root plus the shared resolver, so root specs keep\n182-  # root-local review/ and child phases keep local review/ packet dirs.\n183-  # Canonical root-spec write targets remain review/deep-review-config.json,\n184-  # review/deep-review-state.jsonl, and review/deep-review-findings-registry.json.\n185-  packet_dir: \"{artifact_dir}\"\n186-  local_packet_dir: \"{spec_folder}/review\"\n187-  legacy_root_report: \"{spec_folder}/review-report.md\"\n188-  config: \"{artifact_dir}/deep-review-config.json\"\n189-  state_log: \"{artifact_dir}/deep-review-state.jsonl\"\n190-  findings_registry: \"{artifact_dir}/deep-review-findings-registry.json\"\n191-  strategy: \"{artifact_dir}/deep-review-strategy.md\"\n192-  dashboard: \"{artifact_dir}/deep-review-dashboard.md\"\n193-  pause_sentinel: \"{artifact_dir}/.deep-review-pause\"\n194-  lock_file: \"{artifact_dir}/.deep-review.lock\"\n195-  prompt_dir: \"{artifact_dir}/prompts\"\n196-  iteration_dir: \"{artifact_dir}/iterations\"\n197-  iteration_pattern: \"{artifact_dir}/iterations/iteration-{NNN}.md\"\n198-  # Per-iteration structured delta stream — complement to the canonical state_log\n199-  # append. MUST contain at least one record with `type === \"iteration\"`; variants\n200-  # like `\"iteration_delta\"` are silently dropped by the reducer.\n201-  delta_dir: \"{artifact_dir}/deltas\"\n202-  delta_pattern: \"{artifact_dir}/deltas/iter-{NNN}.jsonl\"\n203-  review_output: \"{artifact_dir}/review-report.md\"\n204-  resource_map_output: \"{artifact_dir}/resource-map.md\"\n205-  archive_root: \"{artifact_archive_root}\"\n206-\n207-# ────────\n208-# WORKFLOW\n209-# ────────\n210-\n211-gate_defaults:\n212-  after_gate_refresh_lock:\n213-    action: \"Refresh the packet lock heartbeat immediately after the operator response\"\n214-    command: \"node .skilled/skills/system-deep-loop/runtime/scripts/loop-lock.cjs refresh --lock-path {state_paths.lock_file} --owner-pid {captured_owner_pid} --nonce {captured_acquire_nonce}\"\n215-    on_refresh: \"If the refresh output has refreshed:false, fail closed: lost the packet lock. This run no longer holds the packet, so run step_release_lock and stop rather than continue without it.\"\n216-\n217-workflow:\n218-\n219-  step_resolve_artifact_root:\n220-    description: \"Resolve artifact directory — use fan-out lineage override when provided, else resolve from spec_folder\"\n221-    note: \"Root specs keep review artifacts directly in {spec_folder}/review/. Child phases and sub-phases keep local packet directories in {spec_folder}/review/{packet}/, and archives stay local at {spec_folder}/review-archive/{packet}/.\"\n222-    branch_on: \"config.fanout_lineage_artifact_dir\"\n--\n305:    description: \"Spawn fan-out lineages; skip and proceed to phase_init normally when single-executor\"\n306-    dry_run_boundary: \"child-spawn\"\n307-    skip_when: \"config.fanout is absent\"\n308-    instructions: |\n309-      Fan-out mode is active. Spawn all lineages. Each lineage runs the full loop in its own\n310-      isolated sub-packet under {artifact_dir}/lineages/{label}/.\n311:      This step runs before phase_init, so pass the raw review_focus. fanout-run.cjs\n312-      normalizes it and hands every lineage the same single-line text. Escape any double\n313-      quote, backslash, dollar sign or backtick in it for the shell, and pass an empty\n314-      string when no focus was given.\n315-      A cli-opencode lineage inside this fan-out is an explicit parallel-detached OpenCode\n316-      session with a separate lineage directory and session id; it is not the single-executor\n317-      self-invocation path. fanout-run.cjs owns the stack-only recursion guard for that\n318-      first-level detached lineage and still blocks recursive same-kind dispatch from inside it.\n319-      fanout-run.cjs owns native and CLI lineage execution; native is run through the\n320-      deep/review command surface with config.fanout_lineage_artifact_dir so the LEAF\n321-      deep-review agent is used only for individual iterations, never as a full-loop\n322-      sub-agent or pasted phase-running prompt.\n323:      After all lineages complete, jump directly to phase_synthesis — skip phase_init and\n324-      phase_main_loop entirely (those are the single-executor path). The merge step in\n325-      phase_synthesis will consolidate results across all lineages.\n326-    sub_steps:\n327-      step_fanout_spawn_cli:\n328-        description: \"Spawn all native and CLI lineages in capped worker pool\"\n329-        skip_when: \"no entries in config.fanout.executors\"\n330-        command: |\n331-          node .skilled/skills/system-deep-loop/runtime/scripts/fanout-run.cjs \\\n332-            --spec-folder {spec_folder} \\\n333-            --loop-type review \\\n334-            --review-focus \"{review_focus}\" \\\n335-            --review-target \"{review_target}\" \\\n336-            --review-target-type {review_target_type} \\\n337-            --fanout-config-json '{config.fanout_json}' \\\n338-            --base-artifact-dir {artifact_dir} \\\n339-            --convergence-threshold {convergence_threshold} \\\n340-            --stop-policy {stop_policy} \\\n341-            --convergence-mode {convergence_mode}\n342-        working_directory: \"{repo_root}\"\n343-        wait_for_completion: true\n344-        optional_flags: \"When lineage_timeout_hours is bound, append `--lineage-timeout-hours {lineage_timeout_hours}` to the command. When it is unset, append nothing, which keeps the 4 hour ceiling.\"\n345-\n346-  # ════════\n347-  # PHASE 1: INITIALIZATION\n348-  # ════════\n349:  phase_init:\n350-    purpose: Create all state files for the review session and resolve review scope\n351-    steps:\n352-\n353-      step_preflight_contract:\n354-        action: \"Validate required setup bindings and executable workflow contract before any file writes\"\n355-        verify:\n356-          - required_values_present: [review_target, review_target_type, review_dimensions, spec_folder, lineage_mode, max_iterations, convergence_threshold, convergence_mode, stop_policy]\n357-          - dry_run_normalized: \"Boolean true or false before workflow loading; absent flag resolves to false.\"\n358-          - spec_folder_is_within: \"specs/ or .opencode/specs/ (canonicalize alias roots before validation)\"\n359-          - unresolved_placeholders: \"FAIL if any user-facing template references placeholders not produced by earlier steps\"\n360-          - tool_contract: \"FAIL if executable steps reference tools outside the command allowlist\"\n361-        on_fail: \"Halt with STATUS=FAIL and report the missing binding or unsupported contract reference\"\n362-\n363-      step_create_directories:\n364-        action: \"Create spec folder and canonical review packet directories if they don't exist\"\n365-        dry_run_boundary: \"state-mutation\"\n366-        command: \"mkdir -p {state_paths.prompt_dir} {state_paths.iteration_dir} {state_paths.delta_dir}\"\n367-\n368-      step_detect_resource_map:\n369-        action: \"Detect resource-map.md before config creation so init can persist coverage-gate state\"\n370-        inspect:\n371-          - \"{spec_folder}/resource-map.md\"\n372-        classify:\n373-          present: \"resource-map.md exists at init\"\n374-          absent: \"resource-map.md does not exist at init\"\n375-        outputs:\n376-          - resource_map_present: \"Boolean true when {spec_folder}/resource-map.md exists, else false\"\n377-          - resource_map_known_context: \"When present: concise resource-map snapshot for Known Context and charter framing. When absent: 'resource-map.md not present; skipping coverage gate'.\"\n378-\n379-      step_migrate_legacy_review_state:\n380-        action: \"Rehome legacy review artifacts into review/iterations before session classification\"\n381-        dry_run_boundary: \"state-mutation\"\n382-        detect:\n383-          canonical_review_state:\n384-            - \"{state_paths.config}\"\n385-            - \"{state_paths.state_log}\"\n386-            - \"{state_paths.findings_registry}\"\n387-            - \"{state_paths.strategy}\"\n388-          legacy_review_state:\n389-            - \"{spec_folder}/scratch/deep-research-config.json\"\n390-            - \"{spec_folder}/scratch/deep-research-state.jsonl\"\n391-            - \"{spec_folder}/scratch/deep-review-strategy.md\"\n392-            - \"{spec_folder}/scratch/deep-review-dashboard.md\"\n393-            - \"{spec_folder}/scratch/iteration-*.md\"\n394-            - \"{spec_folder}/scratch/.deep-research-pause\"\n395-            - \"{state_paths.local_packet_dir}/iteration-*.md\"\n396-            - \"{state_paths.legacy_root_report}\"\n397-          legacy_review_markers:\n398-            - \"scratch/deep-review-strategy.md exists\"\n399-            - \"scratch/deep-research-config.json declares mode == 'review' OR scratch/deep-research-state.jsonl contains mode == 'review'\"\n400-        migrate_only:\n401-          - \"{spec_folder}/scratch/deep-research-config.json -> {state_paths.config}\"\n402-          - \"{spec_folder}/scratch/deep-research-state.jsonl -> {state_paths.state_log}\"\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"102:  trigger: \"At workflow START, before phase_init\"\n103-  purpose: \"Load prior review context for the target and buffer it until strategy.md exists\"\n104-  retrieval:\n105-    mechanism: \"continuity-ladder-then-ripgrep\"\n106-    note: \"File reads only. Nothing here needs a running daemon, and every step is reproducible by hand.\"\n107-    ladder:\n108-      - \"{spec_folder}/handover.md when present\"\n109-      - \"the _memory.continuity frontmatter block in {spec_folder}/implementation-summary.md\"\n110-      - \"the packet's canonical spec docs, spec.md and decision-record.md, for what the first two steps leave open\"\n111-    free_text_recipe: \"rg --no-config --json --fixed-strings --ignore-case -C 2 --glob '*.md' --glob '!**/z_archive/**' --glob '!**/node_modules/**' -- '{review_target}' specs .skilled\"\n112-    recipe_contract: \".skilled/skills/system-spec-kit/references/retrieval/retrieval-conventions.md\"\n113-    exit_status: \"0 is a hit set, 1 is a clean no-hit, 2 or higher is a failure that must be surfaced instead of reported as no-hit\"\n114-    ranking: \"Ripgrep does not rank. Order the hits caller-side with the tuple in retrieval-conventions.md section 5.\"\n115-  when_to_skip: [\"User says 'skip context' or 'fresh start'\"]\n116-  behavior:\n117-    if_context_found: \"Store full results as prior_context plus a concise prior_context_summary; inject after strategy.md is created.\"\n118-    if_no_context: \"Set prior_context and prior_context_summary to 'None' and continue.\"\n119-\n120-# ────────\n121-# SKILL REFERENCE\n122-# ────────\n123-skill_reference:\n124-  skill: system-deep-loop\n125-  skill_md: .skilled/skills/system-deep-loop/deep-review/SKILL.md\n126-  references:\n127-    loop_protocol: .skilled/skills/system-deep-loop/deep-review/references/protocol/loop-protocol.md\n128-    state_format: .skilled/skills/system-deep-loop/deep-review/references/state/state-format.md\n129-    convergence: .skilled/skills/system-deep-loop/deep-review/references/convergence/convergence.md\n130-  templates:\n131-    config: .skilled/skills/system-deep-loop/deep-review/assets/deep-review-config.json\n132-    strategy: .skilled/skills/system-deep-loop/deep-review/assets/deep-review-strategy.md\n133-\n134-# ────────\n135-# AGENT CONFIGURATION\n136-# ────────\n137-agent_config:\n138-  agent: deep-review\n139-  agent_file: \".skilled/agents/deep-review.md\"\n140-  # Canonical path. Runtime-specific directories (e.g. .claude/agents/) reference this source.\n141-  mode: subagent\n142-  model: opus\n143-  leaf_only: true\n144-  tools: [Read, Write, Edit, Bash, Grep, Glob]\n145-  mcp_servers: []\n146-\n147-# ────────\n148-# STATE FILE PATHS\n149-# ────────\n150-# ────────\n151-# CANONICAL STATE WRITE MECHANISM\n152-# ────────\n153-state_write_protocol:\n154-  mechanism: \"append-gateway\"\n155-  command: \"node .skilled/skills/system-deep-loop/runtime/scripts/append-mode-event.cjs --mode review --run-directory {artifact_dir} --event-json <record file>\"\n156-  applies_to: \"every append_to_jsonl and append_jsonl directive in this workflow\"\n157-  refusal_handling: \"halt on exit 2; never fall back to a direct file write. Exit 1 on a row that is still routed through the gateway is a workflow defect and halts; the pinned_bookkeeping rows are recorded through bookkeeping_log and are never routed.\"\n158-  pinned_bookkeeping:\n159-    events: [config_warning, lock_released, pivot_confirm_accepted, manualStop, pivot_override_accepted, maxDurationReached]\n160-    directive: \"bookkeeping_log\"\n161-    handling: \"These rows are workflow bookkeeping that the review ledger schema pins to the legacy path: they have no lossless review-event target, so the gateway would refuse them with exit 1 and write nothing. They are never sent to the gateway. The step prints the row in its log line and continues; none of them is a halt condition.\"\n162-  contract: |\n163-    The directives below specify WHAT to record; this block specifies the mechanism. The gateway\n164-    authorizes the write against the mode's durable authority record, serialises it behind the\n165-    ledger fence, returns a receipt, and refreshes state_log from the ledger. Exit 0 means the\n166-    record is durable in the ledger and the refreshed state_log carries it. Exit 2 means it was\n167-    refused, and the refusal names the check that failed.\n168-\n169-    Writing state_log directly bypasses ordering, authorization, and the receipt. Two writers\n170-    can then interleave with no shared ordering, and a record nobody authorized carries no\n171-    receipt, so a later reader cannot tell an accepted record from an invented one. A refusal\n172-    is a halt, never a reason to write the file directly.\n173-\n174-    There is no direct-append exception. state_log is a projection the gateway rebuilds from\n175-    the ledger, so a row written beside it is dropped by the next refresh: the migration\n176-    marker, the recovery baseline, the iteration-error row and the claim-adjudication gate\n177-    row are canonical ledger events like every other record.\n178-\n179-state_paths:\n180-  # Template paths document the canonical packet layout. Runtime resolution happens via\n181-  # step_resolve_artifact_root plus the shared resolver, so root specs keep\n182-  # root-local review/ and child phases keep local review/ packet dirs.\n183-  # Canonical root-spec write targets remain review/deep-review-config.json,\n184-  # review/deep-review-state.jsonl, and review/deep-review-findings-registry.json.\n185-  packet_dir: \"{artifact_dir}\"\n186-  local_packet_dir: \"{spec_folder}/review\"\n187-  legacy_root_report: \"{spec_folder}/review-report.md\"\n188-  config: \"{artifact_dir}/deep-review-config.json\"\n189-  state_log: \"{artifact_dir}/deep-review-state.jsonl\"\n190-  findings_registry: \"{artifact_dir}/deep-review-findings-registry.json\"\n191-  strategy: \"{artifact_dir}/deep-review-strategy.md\"\n192-  dashboard: \"{artifact_dir}/deep-review-dashboard.md\"\n193-  pause_sentinel: \"{artifact_dir}/.deep-review-pause\"\n194-  lock_file: \"{artifact_dir}/.deep-review.lock\"\n195-  prompt_dir: \"{artifact_dir}/prompts\"\n196-  iteration_dir: \"{artifact_dir}/iterations\"\n197-  iteration_pattern: \"{artifact_dir}/iterations/iteration-{NNN}.md\"\n198-  # Per-iteration structured delta stream — complement to the canonical state_log\n199-  # append. MUST contain at least one record with `type === \"iteration\"`; variants\n200-  # like `\"iteration_delta\"` are silently dropped by the reducer.\n201-  delta_dir: \"{artifact_dir}/deltas\"\n202-  delta_pattern: \"{artifact_dir}/deltas/iter-{NNN}.jsonl\"\n203-  review_output: \"{artifact_dir}/review-report.md\"\n204-  resource_map_output: \"{artifact_dir}/resource-map.md\"\n205-  archive_root: \"{artifact_archive_root}\"\n206-\n207-# ────────\n208-# WORKFLOW\n209-# ────────\n210-\n211-gate_defaults:\n212-  after_gate_refresh_lock:\n213-    action: \"Refresh the packet lock heartbeat immediately after the operator response\"\n214-    command: \"node .skilled/skills/system-deep-loop/runtime/scripts/loop-lock.cjs refresh --lock-path {state_paths.lock_file} --owner-pid {captured_owner_pid} --nonce {captured_acquire_nonce}\"\n215-    on_refresh: \"If the refresh output has refreshed:false, fail closed: lost the packet lock. This run no longer holds the packet, so run step_release_lock and stop rather than continue without it.\"\n216-\n217-workflow:\n218-\n219-  step_resolve_artifact_root:\n220-    description: \"Resolve artifact directory — use fan-out lineage override when provided, else resolve from spec_folder\"\n221-    note: \"Root specs keep review artifacts directly in {spec_folder}/review/. Child phases and sub-phases keep local packet directories in {spec_folder}/review/{packet}/, and archives stay local at {spec_folder}/review-archive/{packet}/.\"\n222-    branch_on: \"config.fanout_lineage_artifact_dir\"\n--\n305:    description: \"Spawn fan-out lineages; skip and proceed to phase_init normally when single-executor\"\n306-    dry_run_boundary: \"child-spawn\"\n307-    skip_when: \"config.fanout is absent\"\n308-    instructions: |\n309-      Fan-out mode is active. Spawn all lineages. Each lineage runs the full loop in its own\n310-      isolated sub-packet under {artifact_dir}/lineages/{label}/.\n311:      This step runs before phase_init, so pass the raw review_focus. fanout-run.cjs\n312-      normalizes it and hands every lineage the same single-line text. Escape any double\n313-      quote, backslash, dollar sign or backtick in it for the shell, and pass an empty\n314-      string when no focus was given.\n315-      A cli-opencode lineage inside this fan-out is an explicit parallel-detached OpenCode\n316-      session with a separate lineage directory and session id; it is not the single-executor\n317-      self-invocation path. fanout-run.cjs owns the stack-only recursion guard for that\n318-      first-level detached lineage and still blocks recursive same-kind dispatch from inside it.\n319-      fanout-run.cjs owns native and CLI lineage execution; native is run through the\n320-      deep/review command surface with config.fanout_lineage_artifact_dir so the LEAF\n321-      deep-review agent is used only for individual iterations, never as a full-loop\n322-      sub-agent or pasted phase-running prompt.\n323:      After all lineages complete, jump directly to phase_synthesis — skip phase_init and\n324-      phase_main_loop entirely (those are the single-executor path). The merge step in\n325-      phase_synthesis will consolidate results across all lineages.\n326-    sub_steps:\n327-      step_fanout_spawn_cli:\n328-        description: \"Spawn all native and CLI lineages in capped worker pool\"\n329-        skip_when: \"no entries in config.fanout.executors\"\n330-        command: |\n331-          node .skilled/skills/system-deep-loop/runtime/scripts/fanout-run.cjs \\\n332-            --spec-folder {spec_folder} \\\n333-            --loop-type review \\\n334-            --review-focus \"{review_focus}\" \\\n335-            --review-target \"{review_target}\" \\\n336-            --review-target-type {review_target_type} \\\n337-            --fanout-config-json '{config.fanout_json}' \\\n338-            --base-artifact-dir {artifact_dir} \\\n339-            --convergence-threshold {convergence_threshold} \\\n340-            --stop-policy {stop_policy} \\\n341-            --convergence-mode {convergence_mode}\n342-        working_directory: \"{repo_root}\"\n343-        wait_for_completion: true\n344-        optional_flags: \"When lineage_timeout_hours is bound, append `--lineage-timeout-hours {lineage_timeout_hours}` to the command. When it is unset, append nothing, which keeps the 4 hour ceiling.\"\n345-\n346-  # ════════\n347-  # PHASE 1: INITIALIZATION\n348-  # ════════\n349:  phase_init:\n350-    purpose: Create all state files for the review session and resolve review scope\n351-    steps:\n352-\n353-      step_preflight_contract:\n354-        action: \"Validate required setup bindings and executable workflow contract before any file writes\"\n355-        verify:\n356-          - required_values_present: [review_target, review_target_type, review_dimensions, spec_folder, lineage_mode, max_iterations, convergence_threshold, convergence_mode, stop_policy]\n357-          - dry_run_normalized: \"Boolean true or false before workflow loading; absent flag resolves to false.\"\n358-          - spec_folder_is_within: \"specs/ or .opencode/specs/ (canonicalize alias roots before validation)\"\n359-          - unresolved_placeholders: \"FAIL if any user-facing template references placeholders not produced by earlier steps\"\n360-          - tool_contract: \"FAIL if executable steps reference tools outside the command allowlist\"\n361-        on_fail: \"Halt with STATUS=FAIL and report the missing binding or unsupported contract reference\"\n362-\n363-      step_create_directories:\n364-        action: \"Create spec folder and canonical review packet directories if they don't exist\"\n365-        dry_run_boundary: \"state-mutation\"\n366-        command: \"mkdir -p {state_paths.prompt_dir} {state_paths.iteration_dir} {state_paths.delta_dir}\"\n367-\n368-      step_detect_resource_map:\n369-        action: \"Detect resource-map.md before config creation so init can persist coverage-gate state\"\n370-        inspect:\n371-          - \"{spec_folder}/resource-map.md\"\n372-        classify:\n373-          present: \"resource-map.md exists at init\"\n374-          absent: \"resource-map.md does not exist at init\"\n375-        outputs:\n376-          - resource_map_present: \"Boolean true when {spec_folder}/resource-map.md exists, else false\"\n377-          - resource_map_known_context: \"When present: concise resource-map snapshot for Known Context and charter framing. When absent: 'resource-map.md not present; skipping coverage gate'.\"\n378-\n379-      step_migrate_legacy_review_state:\n380-        action: \"Rehome legacy review artifacts into review/iterations before session classification\"\n381-        dry_run_boundary: \"state-mutation\"\n382-        detect:\n383-          canonical_review_state:\n384-            - \"{state_paths.config}\"\n385-            - \"{state_paths.state_log}\"\n386-            - \"{state_paths.findings_registry}\"\n387-            - \"{state_paths.strategy}\"\n388-          legacy_review_state:\n389-            - \"{spec_folder}/scratch/deep-research-config.json\"\n390-            - \"{spec_folder}/scratch/deep-research-state.jsonl\"\n391-            - \"{spec_folder}/scratch/deep-review-strategy.md\"\n392-            - \"{spec_folder}/scratch/deep-review-dashboard.md\"\n393-            - \"{spec_folder}/scratch/iteration-*.md\"\n394-            - \"{spec_folder}/scratch/.deep-research-pause\"\n395-            - \"{state_paths.local_packet_dir}/iteration-*.md\"\n396-            - \"{state_paths.legacy_root_report}\"\n397-          legacy_review_markers:\n398-            - \"scratch/deep-review-strategy.md exists\"\n399-            - \"scratch/deep-research-config.json declares mode == 'review' OR scratch/deep-research-state.jsonl contains mode == 'review'\"\n400-        migrate_only:\n401-          - \"{spec_folder}/scratch/deep-research-config.json -> {state_paths.config}\"\n402-          - \"{spec_folder}/scratch/deep-research-state.jsonl -> {state_paths.state_log}\"\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"grep -n \\\"phase_init\\\" -A 120 .skilled/commands/deep/assets/deep-review.yaml | head -220\"}"},"time":{"start":1794815598027,"end":1794815598369}}}}
