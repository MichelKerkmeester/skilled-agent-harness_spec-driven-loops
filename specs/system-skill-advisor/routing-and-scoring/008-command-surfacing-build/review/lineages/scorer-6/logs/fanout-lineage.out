ote, mode, policy, checkoutDir }) {\n1331:    && (followedBeforeWrite(stream, command, checkoutDir) || hostExpanded(stream, wanted))) {\n1335:  const ownerLoad = ownerLoadedBeforeWrite(stream, owner, mode, checkoutDir);\n1340:  if (policy === ASK_POLICY && wrote !== true && firstWritePosition(stream, checkoutDir) === null\n1345:  return wrote === true || firstWritePosition(stream, checkoutDir) !== null ? 'improvised' : 'none';\n1425: * @param {string} [checkoutDir] - The folder the run's checkout names, so a write\n1429:export function startedCommand(events, commands, checkoutDir) {\n1431:  const boundary = firstWritePosition(stream, checkoutDir);\n1482: * @param {string} [checkoutDir] - The folder the run's checkout names. It decides\n1489:export function startState(events, row, checkoutDir) {\n1497:  const shape = touched ? startShape(stream, wanted, checkoutDir) : null;\n1513:function startShape(stream, wanted, checkoutDir) {\n1517:  return firstWritePosition(stream, checkoutDir) !== null ? 'readWrite' : 'readOnly';\n2083:  const start = startState(events, label, line.locator?.projectDir);\n2099:      ? startedCommand(events, owners.commands, line.locator?.projectDir)\n2135:      wrote: changedPathWrite || firstWritePosition(events, line.locator?.projectDir) !== null,\n2136:      checkoutDir: line.locator?.projectDir,\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"cd /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research && grep -n \\\"projectDir\\\\|checkoutDir\\\\|startedCommand(\\\" .skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/score-command-transcripts.mjs | head -60\"}"},"time":{"start":1794815691531,"end":1794815692354}}}}
