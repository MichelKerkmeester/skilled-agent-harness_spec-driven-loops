ize(options), options.json);\n    } catch (error) {\n      if (!(error instanceof LogError)) throw error;\n      writeRefusal(error.code);\n      return EXIT_UNREADABLE;\n    }\n    return 0;\n  }\n  return scoreSession(options);\n}\n\n// The scorer's facts are exported for direct tests, so the CLI runs only when\n// this file is the entry point. An imported module that parsed the host's argv\n// would refuse on flags it never received. The entry path is compared after\n// resolving links, because Node names a linked entry by its real path.\nconst invokedDirectly = (() => {\n  if (typeof process.argv[1] !== 'string') return false;\n  try {\n    return realpathSync(process.argv[1]) === realpathSync(fileURLToPath(import.meta.url));\n  } catch {\n    return false;\n  }\n})();\n\nif (invokedDirectly) process.exitCode = await main(process.argv.slice(2));\n=== loadRowLabels ===\n1758:function loadRowLabels() {\n1759-  const labels = new Map();\n1760-\n1761-  for (const path of [PROMPTS_PATH, FRESH_PATH]) {\n1762-    if (!existsSync(path)) continue;\n1763-    for (const line of readFileSync(path, 'utf8').split('\\n')) {\n1764-      if (line.trim() === '') continue;\n1765-      const row = JSON.parse(line);\n1766-      if (typeof row.id !== 'string' || row.id === '') continue;\n1767-      labels.set(row.id, row.split === 'holdout' ? { holdout: true } : rowLabel(row));\n1768-    }\n1769-  }\n1770-\n1771-  return labels;\n1772-}\n1773-\n1774-// A command is keyed by the parts its row spells, so a mode suffix or a routed\n1775-// target cannot change which owner the command resolves to. A command that parses\n1776-// to nothing is left out rather than keyed under an empty string, and a read or\n1777-// parse error is allowed to end the run because a summary without the owner table\n1778-// would report every run as unowned. A command's mode is kept beside its owner, so\n1779-// a load of another mode under the same hub can be told apart. The distinct\n1780-// commands are list