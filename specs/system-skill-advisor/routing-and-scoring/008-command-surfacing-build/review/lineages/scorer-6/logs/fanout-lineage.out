tch-cwd/journal/0000000000000001.jsonl';\\nconst lines=fs.readFileSync(p,'utf8').split('\\\\n').filter(Boolean);\\nfor(const line of lines){\\n  const r=JSON.parse(line);\\n  const s=JSON.stringify(r);\\n  if(!s.includes('file_system.write_file')) continue;\\n  const walk=(o,path)=>{\\n    if(o&&typeof o==='object'){\\n      if(o.kind==='tool'&&o.toolName) console.log(o.toolName, JSON.stringify(Object.keys(o.input||{})), JSON.stringify(o.input||{}).slice(0,150));\\n      for(const [k,v] of Object.entries(o)) walk(v,path+'.'+k);\\n    }\\n  };\\n  walk(r,'');\\n}\\n\\\"\"}"},"time":{"start":1794816290521,"end":1794816292221}}}}
