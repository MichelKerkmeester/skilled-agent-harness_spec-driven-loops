\n  },\n  {\n    id: 'mns-d3-08',\n    type: 'must-not-start',\n    top: null,\n    cmd: null,\n    split: 'none'\n  },\n  {\n    id: 'mns-d3-09',\n    type: 'must-not-start',\n    top: null,\n    cmd: null,\n    split: 'none'\n  },\n  {\n    id: 'mns-d3-10',\n    type: 'must-not-start',\n    top: null,\n    cmd: null,\n    split: 'none'\n  }\n]\n{\n  typed: 44,\n  plain: 89,\n  'must-not-start': 22,\n  'near-miss': 9,\n  'slash-variant': 12,\n  'skill-only': 24,\n  decline: 24\n}\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"noOwner rows 54 [\n  {\n    id: 'mns-d3-01',\n    type: 'must-not-start',\n    top: null,\n    cmd: null,\n    split: 'none'\n  },\n  {\n    id: 'mns-d3-02',\n    type: 'must-not-start',\n    top: null,\n    cmd: null,\n    split: 'none'\n  },\n  {\n    id: 'mns-d3-03',\n    type: 'must-not-start',\n    top: null,\n    cmd: null,\n    split: 'none'\n  },\n  {\n    id: 'mns-d3-04',\n    type: 'must-not-start',\n    top: null,\n    cmd: null,\n    split: 'none'\n  },\n  {\n    id: 'mns-d3-05',\n    type: 'must-not-start',\n    top: null,\n    cmd: null,\n    split: 'none'\n  },\n  {\n    id: 'mns-d3-06',\n    type: 'must-not-start',\n    top: null,\n    cmd: null,\n    split: 'none'\n  },\n  {\n    id: 'mns-d3-07',\n    type: 'must-not-start',\n    top: null,\n    cmd: null,\n    split: 'none'\n  },\n  {\n    id: 'mns-d3-08',\n    type: 'must-not-start',\n    top: null,\n    cmd: null,\n    split: 'none'\n  },\n  {\n    id: 'mns-d3-09',\n    type: 'must-not-start',\n    top: null,\n    cmd: null,\n    split: 'none'\n  },\n  {\n    id: 'mns-d3-10',\n    type: 'must-not-start',\n    top: null,\n    cmd: null,\n    split: 'none'\n  }\n]\n{\n  typed: 44,\n  plain: 89,\n  'must-not-start': 22,\n  'near-miss': 9,\n  'slash-variant': 12,\n  'skill-only': 24,\n  decline: 24\n}\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"node -e \\\"\\nconst fs=require('fs');\\nconst rows=fs.readFileSync('.skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/command-prompts.jsonl','utf8').trim().split('\\\\n').map(JSON.parse);\\nconst bridges=JSON.parse(fs.readFileSync('.skilled/skills/system-skill-advisor/runtime/scripts/command-bridges/command-bridges.generated.json','utf8'));\\nconst skills=new Set(bridges.entries.map(e=>e.skillId));\\nconst cmds=new Set(bridges.entries.map(e=>e.command));\\nconst noOwner=rows.filter(r=>!r.expected_command && !(r.expected_top&&skills.has(r.expected_top)));\\nconsole.log('noOwner rows',noOwner.length, noOwner.slice(0,10).map(r=>({id:r.id,type:r.row_type,top:r.expected_top,cmd:r.expected_command,split:r.split})));\\nconst byType={}; for(const r of rows) byType[r.row_type]=(byType[r.row_type]||0)+1; console.log(byType);\\n\\\"\"}"},"time":{"start":1794669971174,"end":1794669973504}}}}
