ne.runtime, locator, loadSession: loadSharedSession });\n482: \n483:     // A recorded offer belongs to the head the turn saw, so recomputing\n484:     // delivery must not replay it. A brief-only pass copies the line forward\n485:     // untouched, so a present offer stays and an absent one stays absent.\n486:     let nextLine;\n487:     if (briefOnly) {\n488:       nextLine = { ...line, briefDelivered: delivered, briefBackfilled: true };\n489:     } else {\n490:       nextLine = {\n491:         ...line,\n492:         offeredCommand: offer.offeredCommand ?? null,\n493:         offeredPolicy: offer.offeredPolicy ?? null,\n494:         offerError: offer.offerError ?? null,\n495:         briefDelivered: delivered,\n496:         offerBackfilled: true,\n497:       };\n498:     }\n499:     output.push(nextLine);\n500:   }\n501: \n502:   mkdirSync(dirname(outPath), { recursive: true });\n503:   writeFileSync(outPath, output.map((line) => `${JSON.stringify(line)}\\n`).join(''), 'utf8');\n504:   return { ok: true, lines: output.length, outPath };\n505: }"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"limit\":80,\"offset\":430,\"path\":\".skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/command-offer.mjs\"}"},"time":{"start":1794669729235,"end":1794669730207}}}}
