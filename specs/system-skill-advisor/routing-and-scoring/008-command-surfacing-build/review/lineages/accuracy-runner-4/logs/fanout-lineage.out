\n      confidence: 0.85,\n      downgradeTrigger: 'If the packet decision record says the fit block is advisory-only and the 8 are accepted, downgrade to P2 and record it as an accepted risk; if a test or gate is added that fails on carried > baseline, the finding resolves.',\n    },\n    {\n      id: 'iter2-P2-live-holdout-guard-baseline-only',\n      severity: 'P2',\n      title: 'The holdout publication guard reads the baseline, not the live capture',\n      file: '.skilled/skills/system-skill-advisor/runtime/tests/command-routing-slice.vitest.ts:181',\n      findingClass: 'security/evaluation-integrity',\n      scopeProof: 'publishRow is the only publication gate; the live row comparison filters holdout ids; the only live holdout check is the fit- prefix filter.',\n      affectedSurfaceHints: ['command-routing-slice holdout tests', 'capture publishRow and row maps'],\n    },\n  ],\n  traceabilityChecks: {\n    spec_code: { status: 'partial', notes: 'Fit/decline rows measure the packet command-surfacing safety rule; no spec threshold is wired.' },\n    checklist_evidence: { status: 'partial', notes: 'Parent packet holds no checklist.' },\n    skill_agent: { status: 'notApplicable', notes: 'No agent definition owns the area.' },\n    agent_cross_runtime: { status: 'partial', notes: 'Fit rows are runtime-independent; live per-runtime proof stays phase 007.' },\n    feature_catalog_code: { status: 'pending', notes: 'Scheduled for iteration 3.' },\n    playbook_capability: { status: 'pending', notes: 'Scheduled for iteration 3 if reached.' },\n  },\n  newFindingsRatio: 1,\n  noveltyJustification: 'First security pass over the pass-four area; both findings are new and neither repeats a pass-one, pass-two or iteration-1 finding.',\n  sessionId: 'fanout-accuracy-runner-4-1794669272137-9v23rz',\n  generation: 1,\n  lineageMode: 'new',\n  timestamp: '2026-11-14T15:47:00Z',\n  durationMs: 360000,\n  reviewDepthSchemaVersion: 2,\n  reviewDepthApplicability: { scopeClass: '