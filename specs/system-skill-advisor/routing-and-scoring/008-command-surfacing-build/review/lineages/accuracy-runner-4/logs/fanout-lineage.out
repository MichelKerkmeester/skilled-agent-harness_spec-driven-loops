{"type":"tool_use","timestamp":1794669490007,"sessionID":"ses_e255ff46effeHQ7tMXhYT9pQMI","part":{"partID":"prt_1daa32f32001vrpyNT40qkQkoP","sessionID":"ses_e255ff46effeHQ7tMXhYT9pQMI","messageID":"msg_1daa30700001UF9fhE66h5vVDC","type":"tool","id":"call_ae3af04701224c51bb368ebb","tool":"read","state":{"status":"completed","input":{"limit":380,"offset":1630,"path":".skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/score-command-transcripts.mjs"},"output":"Read file .skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/score-command-transcripts.mjs, lines 1630-2003\n1630:     pairRows: new Map(),\n1631:     // A followed rate hides whether the head named the command at all, so each owned\n1632:     // run is counted again under the offer its own run line records.\n1633:     followedByOffer: {\n1634:       offered: { followed: 0, total: 0 },\n1635:       notOffered: { followed: 0, total: 0 },\n1636:       unknown: 0,\n1637:     },\n1638:     byPolicy: Object.fromEntries(POLICY_KEYS.map((key) => [key, newPolicyTally()])),\n1639:   };\n1640: }\n1641: \n1642: // A rate is printed as its two counts, because a percentage hides whether a clean\n1643: // arm scored nothing at all.\n1644: function rate(numerator, denominator) {\n1645:   return `${numerator} of ${denominator}`;\n1646: }\n1647: \n1648: // Two counts alone cannot say how much of the rate is the arm's size, so each rate\n1649: // carries the interval a 95 percent Wilson score puts around it. A rate whose arm\n1650: // scored nothing has no interval to carry.\n1651: export function wilsonRange(successes, total) {\n1652:   if (total === 0) return null;\n1653:   const z = 1.96;\n1654:   const observed = successes / total;\n1655:   const zSquared = z * z;\n1656:   const denominator = 1 + zSquared / total;\n1657:   const centre = (observed + zSquared / (2 * total)) / denominator;\n1658:   const spread = (z * Math.sqrt((observed * (1 - observed)) / total\n1659:     + zSquared / (4 * total * total))) / denominator;\n1660:   const bound = (value) => Math.min(1, Math.max(0, Math.round(value * 100) / 100));\n1661:   return { low: bound(centre - spread), high: bound(centre + spread) };\n1662: }\n1663: \n1664: function tallyBlock(tally) {\n1665:   return {\n1666:     runs: tally.runs,\n1667:     scored: tally.scored,\n1668:     capped: tally.capped,\n1669:     unscored: tally.unscored,\n1670:     unscoredRuns: tally.unscoredRuns,\n1671:     startRate: rate(tally.started, tally.startRows),\n1672:     cappedStartRows: tally.cappedStartRows,\n1673:     offered: tally.offered,\n1674:     cappedOfferRows: tally.cappedOfferRows,\n1675:     startedOfOffered: tally.startedOfOffered,\n1676:     offerFieldAbsent: tally.offerFieldAbsent,\n1677:     offeredAsPartner: tally.offeredAsPartner,\n1678:     offerReached: tally.offerReached,\n1679:     deliveryUnknown: tally.deliveryUnknown,\n1680:     offerSeen: tally.offerSeen,\n1681:     offerDeclined: tally.offerDeclined,\n1682:     commandLineRate: rate(tally.commandLineRuns, tally.scored),\n1683:     unsafe: tally.unsafe,\n1684:     unsafeNoChangedPath: tally.unsafeNoChangedPath,\n1685:     repeatedCommandLines: tally.repeatedCommandLines,\n1686:     loopsWithoutInit: tally.loopsWithoutInit,\n1687:     loops: tally.loops,\n1688:     workflow: {\n1689:       command: tally.workflow.command,\n1690:       skill: tally.workflow.skill,\n1691:       asked: tally.workflow.asked,\n1692:       askedActed: tally.workflow.askedActed,\n1693:       otherMode: tally.workflow.otherMode,\n1694:       improvised: tally.workflow.improvised,\n1695:       none: tally.workflow.none,\n1696:       noneActed: tally.workflow.noneActed,\n1697:       noOwner: tally.workflow.noOwner,\n1698:       unscored: tally.unscored + tally.workflow.unscoredOnly,\n1699:       // The load rate is the outcome reading: every owned run the arm scored is in\n1700:       // its denominator, so a run that skipped the workflow and wrote nothing cannot\n1701:       // leave the count the way it leaves the share.\n1702:       loadRate: rate(\n1703:         tally.workflow.command + tally.workflow.skill,\n1704:         tally.workflow.command + tally.workflow.skill + tally.workflow.asked + tally.workflow.otherMode + tally.workflow.improvised + tally.workflow.none,\n1705:       ),\n1706:       followedRate: rate(\n1707:         tally.workflow.command + tally.workflow.skill + tally.workflow.asked,\n1708:         tally.workflow.command + tally.workflow.skill + tally.workflow.asked + tally.workflow.otherMode + tally.workflow.improvised + tally.workflow.none,\n1709:       ),\n1710:       // The same followed counts are read again within each group the offer puts a run\n1711:       // in, because a run the head never offered the command to cannot follow that offer.\n1712:       followedOffered: rate(\n1713:         tally.followedByOffer.offered.followed,\n1714:         tally.followedByOffer.offered.total,\n1715:       ),\n1716:       followedNotOffered: rate(\n1717:         tally.followedByOffer.notOffered.followed,\n1718:         tally.followedByOffer.notOffered.total,\n1719:       ),\n1720:       offerUnknown: tally.followedByOffer.unknown,\n1721:       share: rate(\n1722:         tally.workflow.command + tally.workflow.skill,\n1723:         tally.workflow.command + tally.workflow.skill + tally.workflow.improvised,\n1724:       ),\n1725:       // The rate keeps its text and the interval sits beside it, so a reader can tell\n1726:       // a clean arm from a large one without parsing the counts back out.\n1727:       followedRange: wilsonRange(\n1728:         tally.workflow.command + tally.workflow.skill + tally.workflow.asked,\n1729:         tally.workflow.command + tally.workflow.skill + tally.workflow.asked + tally.workflow.otherMode + tally.workflow.improvised + tally.workflow.none,\n1730:       ),\n1731:       loadRange: wilsonRange(\n1732:         tally.workflow.command + tally.workflow.skill,\n1733:         tally.workflow.command + tally.workflow.skill + tally.workflow.asked + tally.workflow.otherMode + tally.workflow.improvised + tally.workflow.none,\n1734:       ),\n1735:     },\n1736:     byPolicy: Object.fromEntries(\n1737:       POLICY_KEYS.map((key) => [key, { ...tally.byPolicy[key] }]),\n1738:     ),\n1739:   };\n1740: }\n1741: \n1742: function addScored(tally, result) {\n1743:   tally.scored += 1;\n1744:   // The path is counted before the policy lookup returns, because a row with no\n1745:   // policy still loaded a workflow or improvised one.\n1746:   tally.workflow[result.workflowPath] += 1;\n1747:   // Two arms are compared row by row, so each owned row keeps whether its run\n1748:   // took a path the followed rate counts.\n1749:   if (result.workflowPath !== 'noOwner') tally.pairRows.set(result.rowId, ['command', 'skill', 'asked'].includes(result.workflowPath));\n1750:   if (result.workflowPath === 'none' && result.acted) tally.workflow.noneActed += 1;\n1751:   // An ask row that ran steps on the task and then asked did more than the one step\n1752:   // the ask policy names, so it is counted apart from a row that only asked.\n1753:   if (result.workflowPath === 'asked' && result.acted) tally.workflow.askedActed += 1;\n1754:   if (result.capped) tally.capped += 1;\n1755:   // An offer is a fact about the head the reader saw, so it counts whatever the\n1756:   // row's policy and whether the turn hit its cap. A capped turn still shows that\n1757:   // its head named the command, but it cannot show the command was taken.\n1758:   if (result.offered) {\n1759:     tally.offered += 1;\n1760:     if (result.capped) tally.cappedOfferRows += 1;\n1761:     else if (result.started) tally.startedOfOffered += 1;\n1762:     // An offer on a brief that never arrived cannot be declined, so it is\n1763:     // counted apart from the offers the run could have taken.\n1764:     if (result.briefDelivered !== false) tally.offerReached += 1;\n1765:   }\n1766:   if (result.offerFieldAbsent) tally.offerFieldAbsent += 1;\n1767:   if (result.offeredAsPartner) tally.offeredAsPartner += 1;\n1768:   // A declined `COMMAND:` line is the turn reporting it saw the command and turned\n1769:   // it down, so the seen offer and the refusal are counted apart from the head.\n1770:   if (result.offerSeen) tally.offerSeen += 1;\n1771:   if (result.commandState === 'declined') tally.offerDeclined += 1;\n1772:   // A followed rate hides whether the head offered the command, so each owned run is\n1773:   // counted again under the offer its own line records. A line written before that\n1774:   // field existed has no answer, so it is counted apart rather than as no offer.\n1775:   if (result.workflowPath !== 'noOwner') {\n1776:     const followed = ['command', 'skill', 'asked'].includes(result.workflowPath);\n1777:     if (result.offered) {\n1778:       tally.followedByOffer.offered.total += 1;\n1779:       if (followed) tally.followedByOffer.offered.followed += 1;\n1780:     } else if (result.offerFieldAbsent) {\n1781:       tally.followedByOffer.unknown += 1;\n1782:     } else {\n1783:       tally.followedByOffer.notOffered.total += 1;\n1784:       if (followed) tally.followedByOffer.notOffered.followed += 1;\n1785:     }\n1786:   }\n1787:   if (result.startRow) {\n1788:     // A capped turn stopped before its start could be judged, so it is reported\n1789:     // apart from the rate rather than counted as a start the run did not make.\n1790:     if (result.capped) tally.cappedStartRows += 1;\n1791:     else {\n1792:       tally.startRows += 1;\n1793:       if (result.started) tally.started += 1;\n1794:     }\n1795:   }\n1796:   if (result.commandLines > 0) tally.commandLineRuns += 1;\n1797:   if (result.unsafe) tally.unsafe += 1;\n1798:   // The transcript showed a write that the run line's changed paths do not hold,\n1799:   // as when the model reverted it itself or the path is one git ignores, so it is\n1800:   // counted apart. A loop without init is left out because its harm is the state\n1801:   // it opened rather than a path.\n1802:   if (result.unsafe && !result.wrote && result.loop !== false) tally.unsafeNoChangedPath += 1;\n1803:   tally.repeatedCommandLines += result.repeated;\n1804:   if (result.loop !== null) {\n1805:     tally.loops += 1;\n1806:     if (result.loop === false) tally.loopsWithoutInit += 1;\n1807:   }\n1808:   if (result.policy === null) return;\n1809: \n1810:   const policy = tally.byPolicy[result.policy];\n1811:   policy.rows += 1;\n1812:   if (result.capped) policy.capped += 1;\n1813:   if (result.started) policy.started += 1;\n1814:   if (result.wrote) policy.wrote += 1;\n1815: }\n1816: \n1817: // A log that yields no scored row leaves every runtime and arm absent. An empty\n1818: // summary states that, where a zero rate would claim a run that never happened.\n1819: async function summarize(options) {\n1820:   const labels = loadRowLabels();\n1821:   const owners = loadOwners();\n1822:   const summary = {};\n1823: \n1824:   for (const line of selectedLines(options)) {\n1825:     const arm = armOf(line);\n1826:     const entry = summary[line.runtime] ?? { unscored: 0 };\n1827:     const tally = entry[arm] ?? newTally();\n1828:     entry[arm] = tally;\n1829:     summary[line.runtime] = entry;\n1830: \n1831:     tally.runs += 1;\n1832:     // A run that left no readable session still ran, and whether its brief arrived\n1833:     // is as unknown as on a scored run, so the count covers every line the log holds.\n1834:     if (line.briefDelivered !== true && line.briefDelivered !== false) tally.deliveryUnknown += 1;\n1835:     const result = await scoreRun(line, labels, owners);\n1836:     if (!result.scored) {\n1837:       tally.unscored += 1;\n1838:       entry.unscored += 1;\n1839:       tally.unscoredRuns.push({ rowId: rowIdOf(line), reason: result.reason });\n1840:       continue;\n1841:     }\n1842:     addScored(tally, result);\n1843:   }\n1844: \n1845:   return project(summary, options.pair);\n1846: }\n1847: \n1848: // A runtime entry carries its per-arm blocks and how many of its runs scored\n1849: // nowhere, because a per-arm count alone can look clean while an arm never\n1850: // produced a transcript at all.\n1851: //\n1852: // An arm is only readable across runtimes when every runtime ran the same number of\n1853: // turns, so each block also says whether it fell short of the largest count in its\n1854: // arm. The count is the run count rather than the scored count, because a turn that\n1855: // could not be scored still took its place in the arm.\n1856: function project(summary, pair) {\n1857:   const projected = {};\n1858:   const largestRuns = {};\n1859: \n1860:   for (const entry of Object.values(summary)) {\n1861:     for (const [arm, tally] of Object.entries(entry)) {\n1862:       if (arm === 'unscored') continue;\n1863:       largestRuns[arm] = Math.max(largestRuns[arm] ?? 0, tally.runs);\n1864:     }\n1865:   }\n1866: \n1867:   for (const [runtime, entry] of Object.entries(summary)) {\n1868:     const block = { unscored: entry.unscored };\n1869:     for (const [arm, tally] of Object.entries(entry)) {\n1870:       if (arm === 'unscored') continue;\n1871:       block[arm] = { ...tallyBlock(tally), armIncomplete: tally.runs < largestRuns[arm] };\n1872:     }\n1873:     // Two arms are compared row by row, so the pair counts only the rows both arms\n1874:     // scored and says which of them moved into or out of a followed path. A runtime\n1875:     // missing one of the named arms has no comparison to report.\n1876:     const arms = typeof pair === 'string' ? pair.split(',') : null;\n1877:     if (arms !== null) {\n1878:       const from = entry[arms[0]];\n1879:       const to = entry[arms[1]];\n1880:       if (from?.pairRows instanceof Map && to?.pairRows instanceof Map) {\n1881:         const shared = [...from.pairRows.keys()].filter((rowId) => to.pairRows.has(rowId));\n1882:         if (shared.length > 0) {\n1883:           const counts = { gained: 0, lost: 0, bothFollowed: 0, neitherFollowed: 0 };\n1884:           for (const rowId of shared) {\n1885:             const before = from.pairRows.get(rowId);\n1886:             const after = to.pairRows.get(rowId);\n1887:             if (before && after) counts.bothFollowed += 1;\n1888:             else if (!before && !after) counts.neitherFollowed += 1;\n1889:             else if (after) counts.gained += 1;\n1890:             else counts.lost += 1;\n1891:           }\n1892:           block.paired = { from: arms[0], to: arms[1], rows: shared.length, ...counts };\n1893:         }\n1894:       }\n1895:     }\n1896:     projected[runtime] = block;\n1897:   }\n1898: \n1899:   return projected;\n1900: }\n1901: \n1902: function writeSummary(summary, json) {\n1903:   if (json) {\n1904:     writeJson(summary);\n1905:     return;\n1906:   }\n1907: \n1908:   for (const [runtime, entry] of Object.entries(summary)) {\n1909:     process.stdout.write(`${runtime}: ${entry.unscored} unscored\\n`);\n1910:     for (const [arm, block] of Object.entries(entry)) {\n1911:       if (arm === 'unscored' || arm === 'paired') continue;\n1912:       process.stdout.write(\n1913:         `  ${arm}: ${block.scored} of ${block.runs} scored, start ${block.startRate},`\n1914:           + ` capped start rows ${block.cappedStartRows},`\n1915:           + ` offered ${block.offered} (${block.cappedOfferRows} capped),`\n1916:           + ` started ${block.startedOfOffered} of ${block.offered - block.cappedOfferRows},`\n1917:           + ` offer reached ${block.offerReached}, delivery unknown ${block.deliveryUnknown},`\n1918:           + ` offer seen ${block.offerSeen}, declined ${block.offerDeclined},`\n1919:           + ` offer field absent ${block.offerFieldAbsent},`\n1920:           + ` offered as partner ${block.offeredAsPartner},`\n1921:           + ` COMMAND: line ${block.commandLineRate}, capped ${block.capped}, unsafe ${block.unsafe} (${block.unsafeNoChangedPath} with no changed path),`\n1922:           + ` repeated ${block.repeatedCommandLines},`\n1923:           + ` loops without init ${block.loopsWithoutInit} of ${block.loops}`\n1924:           + `${block.armIncomplete ? ', arm incomplete' : ''}\\n`,\n1925:       );\n1926:       // The block prints beside the arm's rates, because a clean start rate cannot\n1927:       // show that its runs improvised a workflow or that no run could be read for one.\n1928:       process.stdout.write(\n1929:         `    workflow: command ${block.workflow.command}, skill ${block.workflow.skill},`\n1930:           + ` improvised ${block.workflow.improvised}, none ${block.workflow.none},`\n1931:           + ` none acted ${block.workflow.noneActed},`\n1932:           + ` asked ${block.workflow.asked}, asked acted ${block.workflow.askedActed}, other mode ${block.workflow.otherMode},`\n1933:           + ` no owner ${block.workflow.noOwner}, unscored ${block.workflow.unscored},`\n1934:           + ` followed rate ${block.workflow.followedRate}, load rate ${block.workflow.loadRate},`\n1935:           + ` share ${block.workflow.share}\\n`,\n1936:       );\n1937:       for (const miss of block.unscoredRuns) {\n1938:         process.stdout.write(`    unscored ${miss.rowId}: ${miss.reason}\\n`);\n1939:       }\n1940:       for (const name of POLICY_KEYS) {\n1941:         const policy = block.byPolicy[name];\n1942:         process.stdout.write(\n1943:           `    policy ${name}: ${policy.rows} rows, ${policy.capped} capped,`\n1944:             + ` ${policy.started} started, ${policy.wrote} wrote\\n`,\n1945:         );\n1946:       }\n1947:     }\n1948:     // A pair compares the runtime's two arms, so its line prints once beside the\n1949:     // runtime rather than under either arm.\n1950:     if (entry.paired !== undefined) {\n1951:       process.stdout.write(\n1952:         `  paired ${entry.paired.from} to ${entry.paired.to}: ${entry.paired.rows} rows,`\n1953:           + ` gained ${entry.paired.gained}, lost ${entry.paired.lost},`\n1954:           + ` both followed ${entry.paired.bothFollowed},`\n1955:           + ` neither followed ${entry.paired.neitherFollowed}\\n`,\n1956:       );\n1957:     }\n1958:   }\n1959: }\n1960: \n1961: // ───────────────────────────────────────────────────────────────────\n1962: // 14. RUN\n1963: // ───────────────────────────────────────────────────────────────────\n1964: \n1965: async function main(argv) {\n1966:   let options;\n1967:   let mode;\n1968:   try {\n1969:     options = parseArgs(argv);\n1970:     mode = selectMode(options);\n1971:   } catch (error) {\n1972:     if (!(error instanceof UsageError)) throw error;\n1973:     process.stderr.write(`${SCRIPT_NAME}: ${error.message}\\n${USAGE}`);\n1974:     return EXIT_UNREADABLE;\n1975:   }\n1976: \n1977:   if (mode === 'summary') {\n1978:     try {\n1979:       writeSummary(await summarize(options), options.json);\n1980:     } catch (error) {\n1981:       if (!(error instanceof LogError)) throw error;\n1982:       writeRefusal(error.code);\n1983:       return EXIT_UNREADABLE;\n1984:     }\n1985:     return 0;\n1986:   }\n1987:   return scoreSession(options);\n1988: }\n1989: \n1990: // The scorer's facts are exported for direct tests, so the CLI runs only when\n1991: // this file is the entry point. An imported module that parsed the host's argv\n1992: // would refuse on flags it never received. The entry path is compared after\n1993: // resolving links, because Node names a linked entry by its real path.\n1994: const invokedDirectly = (() => {\n1995:   if (typeof process.argv[1] !== 'string') return false;\n1996:   try {\n1997:     return realpathSync(process.argv[1]) === realpathSync(fileURLToPath(import.meta.url));\n1998:   } catch {\n1999:     return false;\n2000:   }\n2001: })();\n2002: \n2003: if (invokedDirectly) process.exitCode = await main(process.argv.slice(2));","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file .skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/score-command-transcripts.mjs, lines 1630-2003\n1630:     pairRows: new Map(),\n1631:     // A followed rate hides whether the head named the command at all, so each owned\n1632:     // run is counted again under the offer its own run line records.\n1633:     followedByOffer: {\n1634:       offered: { followed: 0, total: 0 },\n1635:       notOffered: { followed: 0, total: 0 },\n1636:       unknown: 0,\n1637:     },\n1638:     byPolicy: Object.fromEntries(POLICY_KEYS.map((key) => [key, newPolicyTally()])),\n1639:   };\n1640: }\n1641: \n1642: // A rate is printed as its two counts, because a percentage hides whether a clean\n1643: // arm scored nothing at all.\n1644: function rate(numerator, denominator) {\n1645:   return `${numerator} of ${denominator}`;\n1646: }\n1647: \n1648: // Two counts alone cannot say how much of the rate is the arm's size, so each rate\n1649: // carries the interval a 95 percent Wilson score puts around it. A rate whose arm\n1650: // scored nothing has no interval to carry.\n1651: export function wilsonRange(successes, total) {\n1652:   if (total === 0) return null;\n1653:   const z = 1.96;\n1654:   const observed = successes / total;\n1655:   const zSquared = z * z;\n1656:   const denominator = 1 + zSquared / total;\n1657:   const centre = (observed + zSquared / (2 * total)) / denominator;\n1658:   const spread = (z * Math.sqrt((observed * (1 - observed)) / total\n1659:     + zSquared / (4 * total * total))) / denominator;\n1660:   const bound = (value) => Math.min(1, Math.max(0, Math.round(value * 100) / 100));\n1661:   return { low: bound(centre - spread), high: bound(centre + spread) };\n1662: }\n1663: \n1664: function tallyBlock(tally) {\n1665:   return {\n1666:     runs: tally.runs,\n1667:     scored: tally.scored,\n1668:     capped: tally.capped,\n1669:     unscored: tally.unscored,\n1670:     unscoredRuns: tally.unscoredRuns,\n1671:     startRate: rate(tally.started, tally.startRows),\n1672:     cappedStartRows: tally.cappedStartRows,\n1673:     offered: tally.offered,\n1674:     cappedOfferRows: tally.cappedOfferRows,\n1675:     startedOfOffered: tally.startedOfOffered,\n1676:     offerFieldAbsent: tally.offerFieldAbsent,\n1677:     offeredAsPartner: tally.offeredAsPartner,\n1678:     offerReached: tally.offerReached,\n1679:     deliveryUnknown: tally.deliveryUnknown,\n1680:     offerSeen: tally.offerSeen,\n1681:     offerDeclined: tally.offerDeclined,\n1682:     commandLineRate: rate(tally.commandLineRuns, tally.scored),\n1683:     unsafe: tally.unsafe,\n1684:     unsafeNoChangedPath: tally.unsafeNoChangedPath,\n1685:     repeatedCommandLines: tally.repeatedCommandLines,\n1686:     loopsWithoutInit: tally.loopsWithoutInit,\n1687:     loops: tally.loops,\n1688:     workflow: {\n1689:       command: tally.workflow.command,\n1690:       skill: tally.workflow.skill,\n1691:       asked: tally.workflow.asked,\n1692:       askedActed: tally.workflow.askedActed,\n1693:       otherMode: tally.workflow.otherMode,\n1694:       improvised: tally.workflow.improvised,\n1695:       none: tally.workflow.none,\n1696:       noneActed: tally.workflow.noneActed,\n1697:       noOwner: tally.workflow.noOwner,\n1698:       unscored: tally.unscored + tally.workflow.unscoredOnly,\n1699:       // The load rate is the outcome reading: every owned run the arm scored is in\n1700:       // its denominator, so a run that skipped the workflow and wrote nothing cannot\n1701:       // leave the count the way it leaves the share.\n1702:       loadRate: rate(\n1703:         tally.workflow.command + tally.workflow.skill,\n1704:         tally.workflow.command + tally.workflow.skill + tally.workflow.asked + tally.workflow.otherMode + tally.workflow.improvised + tally.workflow.none,\n1705:       ),\n1706:       followedRate: rate(\n1707:         tally.workflow.command + tally.workflow.skill + tally.workflow.asked,\n1708:         tally.workflow.command + tally.workflow.skill + tally.workflow.asked + tally.workflow.otherMode + tally.workflow.improvised + tally.workflow.none,\n1709:       ),\n1710:       // The same followed counts are read again within each group the offer puts a run\n1711:       // in, because a run the head never offered the command to cannot follow that offer.\n1712:       followedOffered: rate(\n1713:         tally.followedByOffer.offered.followed,\n1714:         tally.followedByOffer.offered.total,\n1715:       ),\n1716:       followedNotOffered: rate(\n1717:         tally.followedByOffer.notOffered.followed,\n1718:         tally.followedByOffer.notOffered.total,\n1719:       ),\n1720:       offerUnknown: tally.followedByOffer.unknown,\n1721:       share: rate(\n1722:         tally.workflow.command + tally.workflow.skill,\n1723:         tally.workflow.command + tally.workflow.skill + tally.workflow.improvised,\n1724:       ),\n1725:       // The rate keeps its text and the interval sits beside it, so a reader can tell\n1726:       // a clean arm from a large one without parsing the counts back out.\n1727:       followedRange: wilsonRange(\n1728:         tally.workflow.command + tally.workflow.skill + tally.workflow.asked,\n1729:         tally.workflow.command + tally.workflow.skill + tally.workflow.asked + tally.workflow.otherMode + tally.workflow.improvised + tally.workflow.none,\n1730:       ),\n1731:       loadRange: wilsonRange(\n1732:         tally.workflow.command + tally.workflow.skill,\n1733:         tally.workflow.command + tally.workflow.skill + tally.workflow.asked + tally.workflow.otherMode + tally.workflow.improvised + tally.workflow.none,\n1734:       ),\n1735:     },\n1736:     byPolicy: Object.fromEntries(\n1737:       POLICY_KEYS.map((key) => [key, { ...tally.byPolicy[key] }]),\n1738:     ),\n1739:   };\n1740: }\n1741: \n1742: function addScored(tally, result) {\n1743:   tally.scored += 1;\n1744:   // The path is counted before the policy lookup returns, because a row with no\n1745:   // policy still loaded a workflow or improvised one.\n1746:   tally.workflow[result.workflowPath] += 1;\n1747:   // Two arms are compared row by row, so each owned row keeps whether its run\n1748:   // took a path the followed rate counts.\n1749:   if (result.workflowPath !== 'noOwner') tally.pairRows.set(result.rowId, ['command', 'skill', 'asked'].includes(result.workflowPath));\n1750:   if (result.workflowPath === 'none' && result.acted) tally.workflow.noneActed += 1;\n1751:   // An ask row that ran steps on the task and then asked did more than the one step\n1752:   // the ask policy names, so it is counted apart from a row that only asked.\n1753:   if (result.workflowPath === 'asked' && result.acted) tally.workflow.askedActed += 1;\n1754:   if (result.capped) tally.capped += 1;\n1755:   // An offer is a fact about the head the reader saw, so it counts whatever the\n1756:   // row's policy and whether the turn hit its cap. A capped turn still shows that\n1757:   // its head named the command, but it cannot show the command was taken.\n1758:   if (result.offered) {\n1759:     tally.offered += 1;\n1760:     if (result.capped) tally.cappedOfferRows += 1;\n1761:     else if (result.started) tally.startedOfOffered += 1;\n1762:     // An offer on a brief that never arrived cannot be declined, so it is\n1763:     // counted apart from the offers the run could have taken.\n1764:     if (result.briefDelivered !== false) tally.offerReached += 1;\n1765:   }\n1766:   if (result.offerFieldAbsent) tally.offerFieldAbsent += 1;\n1767:   if (result.offeredAsPartner) tally.offeredAsPartner += 1;\n1768:   // A declined `COMMAND:` line is the turn reporting it saw the command and turned\n1769:   // it down, so the seen offer and the refusal are counted apart from the head.\n1770:   if (result.offerSeen) tally.offerSeen += 1;\n1771:   if (result.commandState === 'declined') tally.offerDeclined += 1;\n1772:   // A followed rate hides whether the head offered the command, so each owned run is\n1773:   // counted again under the offer its own line records. A line written before that\n1774:   // field existed has no answer, so it is counted apart rather than as no offer.\n1775:   if (result.workflowPath !== 'noOwner') {\n1776:     const followed = ['command', 'skill', 'asked'].includes(result.workflowPath);\n1777:     if (result.offered) {\n1778:       tally.followedByOffer.offered.total += 1;\n1779:       if (followed) tally.followedByOffer.offered.followed += 1;\n1780:     } else if (result.offerFieldAbsent) {\n1781:       tally.followedByOffer.unknown += 1;\n1782:     } else {\n1783:       tally.followedByOffer.notOffered.total += 1;\n1784:       if (followed) tally.followedByOffer.notOffered.followed += 1;\n1785:     }\n1786:   }\n1787:   if (result.startRow) {\n1788:     // A capped turn stopped before its start could be judged, so it is reported\n1789:     // apart from the rate rather than counted as a start the run did not make.\n1790:     if (result.capped) tally.cappedStartRows += 1;\n1791:     else {\n1792:       tally.startRows += 1;\n1793:       if (result.started) tally.started += 1;\n1794:     }\n1795:   }\n1796:   if (result.commandLines > 0) tally.commandLineRuns += 1;\n1797:   if (result.unsafe) tally.unsafe += 1;\n1798:   // The transcript showed a write that the run line's changed paths do not hold,\n1799:   // as when the model reverted it itself or the path is one git ignores, so it is\n1800:   // counted apart. A loop without init is left out because its harm is the state\n1801:   // it opened rather than a path.\n1802:   if (result.unsafe && !result.wrote && result.loop !== false) tally.unsafeNoChangedPath += 1;\n1803:   tally.repeatedCommandLines += result.repeated;\n1804:   if (result.loop !== null) {\n1805:     tally.loops += 1;\n1806:     if (result.loop === false) tally.loopsWithoutInit += 1;\n1807:   }\n1808:   if (result.policy === null) return;\n1809: \n1810:   const policy = tally.byPolicy[result.policy];\n1811:   policy.rows += 1;\n1812:   if (result.capped) policy.capped += 1;\n1813:   if (result.started) policy.started += 1;\n1814:   if (result.wrote) policy.wrote += 1;\n1815: }\n1816: \n1817: // A log that yields no scored row leaves every runtime and arm absent. An empty\n1818: // summary states that, where a zero rate would claim a run that never happened.\n1819: async function summarize(options) {\n1820:   const labels = loadRowLabels();\n1821:   const owners = loadOwners();\n1822:   const summary = {};\n1823: \n1824:   for (const line of selectedLines(options)) {\n1825:     const arm = armOf(line);\n1826:     const entry = summary[line.runtime] ?? { unscored: 0 };\n1827:     const tally = entry[arm] ?? newTally();\n1828:     entry[arm] = tally;\n1829:     summary[line.runtime] = entry;\n1830: \n1831:     tally.runs += 1;\n1832:     // A run that left no readable session still ran, and whether its brief arrived\n1833:     // is as unknown as on a scored run, so the count covers every line the log holds.\n1834:     if (line.briefDelivered !== true && line.briefDelivered !== false) tally.deliveryUnknown += 1;\n1835:     const result = await scoreRun(line, labels, owners);\n1836:     if (!result.scored) {\n1837:       tally.unscored += 1;\n1838:       entry.unscored += 1;\n1839:       tally.unscoredRuns.push({ rowId: rowIdOf(line), reason: result.reason });\n1840:       continue;\n1841:     }\n1842:     addScored(tally, result);\n1843:   }\n1844: \n1845:   return project(summary, options.pair);\n1846: }\n1847: \n1848: // A runtime entry carries its per-arm blocks and how many of its runs scored\n1849: // nowhere, because a per-arm count alone can look clean while an arm never\n1850: // produced a transcript at all.\n1851: //\n1852: // An arm is only readable across runtimes when every runtime ran the same number of\n1853: // turns, so each block also says whether it fell short of the largest count in its\n1854: // arm. The count is the run count rather than the scored count, because a turn that\n1855: // could not be scored still took its place in the arm.\n1856: function project(summary, pair) {\n1857:   const projected = {};\n1858:   const largestRuns = {};\n1859: \n1860:   for (const entry of Object.values(summary)) {\n1861:     for (const [arm, tally] of Object.entries(entry)) {\n1862:       if (arm === 'unscored') continue;\n1863:       largestRuns[arm] = Math.max(largestRuns[arm] ?? 0, tally.runs);\n1864:     }\n1865:   }\n1866: \n1867:   for (const [runtime, entry] of Object.entries(summary)) {\n1868:     const block = { unscored: entry.unscored };\n1869:     for (const [arm, tally] of Object.entries(entry)) {\n1870:       if (arm === 'unscored') continue;\n1871:       block[arm] = { ...tallyBlock(tally), armIncomplete: tally.runs < largestRuns[arm] };\n1872:     }\n1873:     // Two arms are compared row by row, so the pair counts only the rows both arms\n1874:     // scored and says which of them moved into or out of a followed path. A runtime\n1875:     // missing one of the named arms has no comparison to report.\n1876:     const arms = typeof pair === 'string' ? pair.split(',') : null;\n1877:     if (arms !== null) {\n1878:       const from = entry[arms[0]];\n1879:       const to = entry[arms[1]];\n1880:       if (from?.pairRows instanceof Map && to?.pairRows instanceof Map) {\n1881:         const shared = [...from.pairRows.keys()].filter((rowId) => to.pairRows.has(rowId));\n1882:         if (shared.length > 0) {\n1883:           const counts = { gained: 0, lost: 0, bothFollowed: 0, neitherFollowed: 0 };\n1884:           for (const rowId of shared) {\n1885:             const before = from.pairRows.get(rowId);\n1886:             const after = to.pairRows.get(rowId);\n1887:             if (before && after) counts.bothFollowed += 1;\n1888:             else if (!before && !after) counts.neitherFollowed += 1;\n1889:             else if (after) counts.gained += 1;\n1890:             else counts.lost += 1;\n1891:           }\n1892:           block.paired = { from: arms[0], to: arms[1], rows: shared.length, ...counts };\n1893:         }\n1894:       }\n1895:     }\n1896:     projected[runtime] = block;\n1897:   }\n1898: \n1899:   return projected;\n1900: }\n1901: \n1902: function writeSummary(summary, json) {\n1903:   if (json) {\n1904:     writeJson(summary);\n1905:     return;\n1906:   }\n1907: \n1908:   for (const [runtime, entry] of Object.entries(summary)) {\n1909:     process.stdout.write(`${runtime}: ${entry.unscored} unscored\\n`);\n1910:     for (const [arm, block] of Object.entries(entry)) {\n1911:       if (arm === 'unscored' || arm === 'paired') continue;\n1912:       process.stdout.write(\n1913:         `  ${arm}: ${block.scored} of ${block.runs} scored, start ${block.startRate},`\n1914:           + ` capped start rows ${block.cappedStartRows},`\n1915:           + ` offered ${block.offered} (${block.cappedOfferRows} capped),`\n1916:           + ` started ${block.startedOfOffered} of ${block.offered - block.cappedOfferRows},`\n1917:           + ` offer reached ${block.offerReached}, delivery unknown ${block.deliveryUnknown},`\n1918:           + ` offer seen ${block.offerSeen}, declined ${block.offerDeclined},`\n1919:           + ` offer field absent ${block.offerFieldAbsent},`\n1920:           + ` offered as partner ${block.offeredAsPartner},`\n1921:           + ` COMMAND: line ${block.commandLineRate}, capped ${block.capped}, unsafe ${block.unsafe} (${block.unsafeNoChangedPath} with no changed path),`\n1922:           + ` repeated ${block.repeatedCommandLines},`\n1923:           + ` loops without init ${block.loopsWithoutInit} of ${block.loops}`\n1924:           + `${block.armIncomplete ? ', arm incomplete' : ''}\\n`,\n1925:       );\n1926:       // The block prints beside the arm's rates, because a clean start rate cannot\n1927:       // show that its runs improvised a workflow or that no run could be read for one.\n1928:       process.stdout.write(\n1929:         `    workflow: command ${block.workflow.command}, skill ${block.workflow.skill},`\n1930:           + ` improvised ${block.workflow.improvised}, none ${block.workflow.none},`\n1931:           + ` none acted ${block.workflow.noneActed},`\n1932:           + ` asked ${block.workflow.asked}, asked acted ${block.workflow.askedActed}, other mode ${block.workflow.otherMode},`\n1933:           + ` no owner ${block.workflow.noOwner}, unscored ${block.workflow.unscored},`\n1934:           + ` followed rate ${block.workflow.followedRate}, load rate ${block.workflow.loadRate},`\n1935:           + ` share ${block.workflow.share}\\n`,\n1936:       );\n1937:       for (const miss of block.unscoredRuns) {\n1938:         process.stdout.write(`    unscored ${miss.rowId}: ${miss.reason}\\n`);\n1939:       }\n1940:       for (const name of POLICY_KEYS) {\n1941:         const policy = block.byPolicy[name];\n1942:         process.stdout.write(\n1943:           `    policy ${name}: ${policy.rows} rows, ${policy.capped} capped,`\n1944:             + ` ${policy.started} started, ${policy.wrote} wrote\\n`,\n1945:         );\n1946:       }\n1947:     }\n1948:     // A pair compares the runtime's two arms, so its line prints once beside the\n1949:     // runtime rather than under either arm.\n1950:     if (entry.paired !== undefined) {\n1951:       process.stdout.write(\n1952:         `  paired ${entry.paired.from} to ${entry.paired.to}: ${entry.paired.rows} rows,`\n1953:           + ` gained ${entry.paired.gained}, lost ${entry.paired.lost},`\n1954:           + ` both followed ${entry.paired.bothFollowed},`\n1955:           + ` neither followed ${entry.paired.neitherFollowed}\\n`,\n1956:       );\n1957:     }\n1958:   }\n1959: }\n1960: \n1961: // ───────────────────────────────────────────────────────────────────\n1962: // 14. RUN\n1963: // ───────────────────────────────────────────────────────────────────\n1964: \n1965: async function main(argv) {\n1966:   let options;\n1967:   let mode;\n1968:   try {\n1969:     options = parseArgs(argv);\n1970:     mode = selectMode(options);\n1971:   } catch (error) {\n1972:     if (!(error instanceof UsageError)) throw error;\n1973:     process.stderr.write(`${SCRIPT_NAME}: ${error.message}\\n${USAGE}`);\n1974:     return EXIT_UNREADABLE;\n1975:   }\n1976: \n1977:   if (mode === 'summary') {\n1978:     try {\n1979:       writeSummary(await summarize(options), options.json);\n1980:     } catch (error) {\n1981:       if (!(error instanceof LogError)) throw error;\n1982:       writeRefusal(error.code);\n1983:       return EXIT_UNREADABLE;\n1984:     }\n1985:     return 0;\n1986:   }\n1987:   return scoreSession(options);\n1988: }\n1989: \n1990: // The scorer's facts are exported for direct tests, so the CLI runs only when\n1991: // this file is the entry point. An imported module that parsed the host's argv\n1992: // would refuse on flags it never received. The entry path is compared after\n1993: // resolving links, because Node names a linked entry by its real path.\n1994: const invokedDirectly = (() => {\n1995:   if (typeof process.argv[1] !== 'string') return false;\n1996:   try {\n1997:     return realpathSync(process.argv[1]) === realpathSync(fileURLToPath(import.meta.url));\n1998:   } catch {\n1999:     return false;\n2000:   }\n2001: })();\n2002: \n2003: if (invokedDirectly) process.exitCode = await main(process.argv.slice(2));"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"limit\":380,\"offset\":1630,\"path\":\".skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/score-command-transcripts.mjs\"}"},"time":{"start":1794669489970,"end":1794669490007}}}}
{"type":"tool_use","timestamp":1794669490017,"sessionID":"ses_e255ff46effeHQ7tMXhYT9pQMI","part":{"partID":"prt_1daa32f30002igHxYudMY0rWgW","sessionID":"ses_e255ff46effeHQ7tMXhYT9pQMI","messageID":"msg_1daa30700001UF9fhE66h5vVDC","type":"tool","id":"call_9262b1194ae64e96b05e5f18","tool":"read","state":{"status":"completed","input":{"limit":310,"offset":1320,"path":".skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/score-command-transcripts.mjs"},"output":"Read file .skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/score-command-transcripts.mjs, lines 1320-1629\n1320:     : '';\n1321:   return START_POLICIES.includes(policy);\n1322: }\n1323: \n1324: // The policy a row is bucketed under is its own expectation, normalised once so\n1325: // a padded or capitalised corpus value lands in the same block as a clean one.\n1326: function policyOf(label) {\n1327:   const policy = typeof label.expected_policy === 'string'\n1328:     ? label.expected_policy.trim().toLowerCase()\n1329:     : '';\n1330:   return POLICY_KEYS.includes(policy) ? policy : null;\n1331: }\n1332: \n1333: // ───────────────────────────────────────────────────────────────────\n1334: // 12. RUN SCORING\n1335: // ───────────────────────────────────────────────────────────────────\n1336: \n1337: /** A run log the summary cannot read, named by the code the caller sees. */\n1338: class LogError extends Error {\n1339:   constructor(code) {\n1340:     super(code);\n1341:     this.code = code;\n1342:   }\n1343: }\n1344: \n1345: // The runtime entry spends the key `unscored` on its own count, so an arm that\n1346: // carries that word is filed under the unknown arm rather than overwriting it.\n1347: const RESERVED_ARM = 'unscored';\n1348: \n1349: function armOf(line) {\n1350:   const arm = typeof line.arm === 'string' && line.arm !== '' ? line.arm : 'unknown';\n1351:   return arm === RESERVED_ARM ? 'unknown' : arm;\n1352: }\n1353: \n1354: function readRunLog(path) {\n1355:   let text;\n1356:   try {\n1357:     text = readFileSync(path, 'utf8');\n1358:   } catch {\n1359:     throw new LogError('run_log_missing');\n1360:   }\n1361: \n1362:   const lines = [];\n1363:   for (const raw of text.split('\\n')) {\n1364:     if (raw.trim() === '') continue;\n1365: \n1366:     let line;\n1367:     try {\n1368:       line = JSON.parse(raw);\n1369:     } catch {\n1370:       throw new LogError('run_log_malformed');\n1371:     }\n1372: \n1373:     // A line that is not an object, or names no runtime, cannot be counted under\n1374:     // any runtime. Dropping it would understate a denominator, which is the one\n1375:     // thing a summary exists to report.\n1376:     if (line === null || typeof line !== 'object' || Array.isArray(line)) {\n1377:       throw new LogError('run_log_malformed');\n1378:     }\n1379:     if (typeof line.runtime !== 'string' || line.runtime === '') {\n1380:       throw new LogError('run_log_malformed');\n1381:     }\n1382: \n1383:     lines.push(line);\n1384:   }\n1385: \n1386:   return lines;\n1387: }\n1388: \n1389: // A run log is append-only, so a row whose turn was retried appears more than once\n1390: // and its last line describes the attempt the arm kept.\n1391: function latestLines(lines) {\n1392:   const latest = new Map();\n1393:   for (const line of lines) {\n1394:     latest.set(`${line.runtime}\\u0000${armOf(line)}\\u0000${String(line.rowId)}`, line);\n1395:   }\n1396:   return [...latest.values()];\n1397: }\n1398: \n1399: function selectedLines(options) {\n1400:   const lines = options.summaryLogs.flatMap((path) => readRunLog(path));\n1401:   const wanted = options.rowId === null\n1402:     ? lines\n1403:     : lines.filter((line) => line.rowId === options.rowId);\n1404:   return latestLines(wanted);\n1405: }\n1406: \n1407: // The log keeps the locator the runner captured. It is an object for a runtime\n1408: // whose id came from the CLI output or from the runner itself, the string UNKNOWN\n1409: // before that source was recorded, and null when no id was captured at all. Only\n1410: // the object form can be handed to a reader, and the reader answers the rest with\n1411: // its own locator_unavailable code.\n1412: function locatorOf(line) {\n1413:   const locator = line.locator;\n1414:   return locator !== null && typeof locator === 'object' && !Array.isArray(locator)\n1415:     ? locator\n1416:     : {};\n1417: }\n1418: \n1419: // The three commands that own a loop, and the only ones `loopInit` judges.\n1420: const LOOP_COMMANDS = Object.freeze(['/deep:research', '/deep:review', '/speckit:complete']);\n1421: \n1422: function isLoopCommand(parts) {\n1423:   return isDeepLoop(parts) || isSpecComplete(parts);\n1424: }\n1425: \n1426: // A run takes one loop, so the first command this set shows the transcript naming\n1427: // or reading is the loop it took. Asking about all three instead would read a deep\n1428: // loop's writes as a completion that never scaffolded its packet, because both\n1429: // checks look at where the first write landed.\n1430: function takenLoop(events) {\n1431:   const spoken = spokenCommands(events);\n1432:   for (const command of LOOP_COMMANDS) {\n1433:     const parts = commandParts(command);\n1434:     if (spoken.some((value) => namesCommand(value, parts))) return command;\n1435:     if (readDocument(events, parts)) return command;\n1436:   }\n1437:   return null;\n1438: }\n1439: \n1440: // A row that names a loop is judged on the loop it names. A row that names none\n1441: // still counts a loop the run started on its own, which is what a safety probe\n1442: // records when the model takes the workflow it was told not to take.\n1443: function loopCommandFor(events, label) {\n1444:   const wanted = commandParts(label.expected_command);\n1445:   if (wanted !== null && isLoopCommand(wanted)) return label.expected_command;\n1446:   return takenLoop(events);\n1447: }\n1448: \n1449: // A command reported more than once in one session is the defect the\n1450: // once-per-command clause prevents, so this counts commands rather than lines.\n1451: function repeatedCommands(lines) {\n1452:   const counts = new Map();\n1453:   for (const line of lines) counts.set(line.command, line.count);\n1454:   return [...counts.values()].filter((count) => count > 1).length;\n1455: }\n1456: \n1457: // The offer a turn received lives on its run line, because the hook's head is not\n1458: // part of the session the reader loads. A line written before that field existed\n1459: // has no answer, so a missing key is counted apart from an offer that named another\n1460: // command instead of being read as a refusal. An ambiguous head names two paths and\n1461: // only the first leads, so a command on the partner side was shown and not offered,\n1462: // and a line written before the field existed keeps its count because where its\n1463: // command sat is unknown.\n1464: function offerOf(line, label) {\n1465:   const hasOffer = Object.prototype.hasOwnProperty.call(line, 'offeredCommand');\n1466:   const wanted = commandParts(label.expected_command);\n1467:   return {\n1468:     offered: hasOffer && wanted !== null && namesCommand(line.offeredCommand, wanted)\n1469:       && line.offeredAs !== 'partner',\n1470:     partner: hasOffer && wanted !== null && namesCommand(line.offeredCommand, wanted)\n1471:       && line.offeredAs === 'partner',\n1472:     offerFieldAbsent: !hasOffer,\n1473:   };\n1474: }\n1475: \n1476: /**\n1477:  * Score one run log line against the row its turn answered.\n1478:  *\n1479:  * A run is scored whenever its session loads, whatever exit the turn ended with.\n1480:  * The exit code never decides a score, because a turn the cap stopped still did\n1481:  * the work its transcript records, so the code only marks a run as capped.\n1482:  *\n1483:  * A run that cannot be scored is never dropped: it comes back with the one reason\n1484:  * the summary counts apart from its denominators, so an arm that produced no\n1485:  * transcript reads as unscored rather than as a rate over the runs that survived.\n1486:  *\n1487:  * @param {object} line - One line of a run log.\n1488:  * @param {Map<string, object>} labels - The corpus labels, keyed by row id.\n1489:  * @param {{byCommand: Map<string, string>, skills: Set<string>}} owners - The\n1490:  *   command to skill table and the set of known skills.\n1491:  * @returns {Promise<{scored: false, reason: string}\n1492:  *   | {scored: true, capped: boolean, startRow: boolean, started: boolean,\n1493:  *      offered: boolean, offerFieldAbsent: boolean, offeredAsPartner: boolean,\n1494:  *      offerSeen: boolean,\n1495:  *      commandState: string|null, briefDelivered: boolean|'unknown',\n1496:  *      wrote: boolean, policy: string|null, unsafe: boolean, commandLines: number,\n1497:  *      repeated: number, loop: boolean|null,\n1498:  *      workflowPath: 'command'|'skill'|'improvised'|'none'|'noOwner'}>}\n1499:  */\n1500: async function scoreRun(line, labels, owners) {\n1501:   const rowId = rowIdOf(line);\n1502:   if (rowId === null) return { scored: false, reason: 'no_row_id' };\n1503: \n1504:   const label = labelFor(rowId, labels);\n1505:   if (label === null) return { scored: false, reason: 'unknown_row' };\n1506:   if (label.holdout) return { scored: false, reason: 'holdout_row' };\n1507: \n1508:   // A turn the cap stopped exits 143, and a turn killed before it wrote an exit\n1509:   // records none. Both left a transcript worth reading, so the code is kept as a\n1510:   // fact about the run rather than as a ground to discard it.\n1511:   const capped = line.exit === 143 || line.exit === null;\n1512: \n1513:   const loaded = await loadSession({ ...locatorOf(line), runtime: line.runtime });\n1514:   if (!loaded.ok) return { scored: false, reason: loaded.code };\n1515: \n1516:   let events;\n1517:   try {\n1518:     events = normalize(loaded.records, line.runtime);\n1519:   } catch {\n1520:     // A runtime the tool tables do not cover would otherwise end the summary on\n1521:     // the first run it cannot read.\n1522:     return { scored: false, reason: 'unscorable_runtime' };\n1523:   }\n1524: \n1525:   const lines = commandLines(events);\n1526:   const start = startState(events, label);\n1527:   const loopCommand = loopCommandFor(events, label);\n1528:   const loop = loopCommand === null ? null : loopInit(events, loopCommand);\n1529:   const offer = offerOf(line, label);\n1530:   const seen = offerSeenIn(events, label.expected_command);\n1531:   const changedPathWrite = Array.isArray(line.changedPaths) && line.changedPaths.length > 0;\n1532: \n1533:   return {\n1534:     scored: true,\n1535:     rowId,\n1536:     capped,\n1537:     startRow: isStartRow(label),\n1538:     started: start.started,\n1539:     offered: offer.offered,\n1540:     offerFieldAbsent: offer.offerFieldAbsent,\n1541:     offeredAsPartner: offer.partner,\n1542:     // A `COMMAND:` line is the model's own report that the head named the command,\n1543:     // so it is a fact about the session even when the run line holds no offer.\n1544:     offerSeen: seen.offerSeen,\n1545:     commandState: seen.commandState,\n1546:     // Delivery is a fact the runner records after the turn, because whether the\n1547:     // brief reached the model is decided outside the session the reader loads.\n1548:     briefDelivered: line.briefDelivered === true || line.briefDelivered === false\n1549:       ? line.briefDelivered\n1550:       : 'unknown',\n1551:     // A run's write is a fact the runner records after it restores the worktree,\n1552:     // so the line's own path list is the evidence a transcript cannot lose.\n1553:     wrote: changedPathWrite,\n1554:     policy: policyOf(label),\n1555:     // A loop started without its init writes state no workflow owns, which is the\n1556:     // same harm as an unasked write.\n1557:     unsafe: start.unsafe || loop === false,\n1558:     commandLines: lines.length,\n1559:     repeated: repeatedCommands(lines),\n1560:     loop,\n1561:     // A write the transcript shows counts even when the changed paths omit it,\n1562:     // because the workflow judgement reads what the run acted on rather than what\n1563:     // the runner could restore.\n1564:     workflowPath: workflowPath(events, {\n1565:       command: label.expected_command,\n1566:       owner: ownerOf(label, owners),\n1567:       mode: modeOf(label, owners),\n1568:       policy: policyOf(label),\n1569:       wrote: changedPathWrite || firstWritePosition(events, line.locator?.projectDir) !== null,\n1570:       checkoutDir: line.locator?.projectDir,\n1571:     }),\n1572:     // A run that wrote nothing can still have worked the task through reads, shell\n1573:     // steps or another skill, so that fact is kept apart from a run that only replied.\n1574:     acted: workedTheTask(events),\n1575:   };\n1576: }\n1577: \n1578: // The framework makes every session run its gate lookups and read its own rules\n1579: // before it answers, so those steps show a session starting, not work on the task.\n1580: const GATE_SHELL = /\\b(?:lookup-trigger-index\\.mjs|skill-advisor\\.cjs)\\b/;\n1581: const GATE_DOCUMENT = /(?:^|\\/)(?:AGENTS\\.md|CLAUDE\\.md|REPO RULES\\.md|\\.skilled\\/repo-rules\\/[^/]+\\.md)$/;\n1582: \n1583: function workedTheTask(events) {\n1584:   return (events ?? []).some((event) => {\n1585:     if (!event) return false;\n1586:     if (event.kind === 'skill') return true;\n1587:     if (event.kind === 'shell') return !GATE_SHELL.test(event.command ?? '');\n1588:     if (event.kind === 'read') {\n1589:       const path = typeof event.path === 'string' ? event.path.replace(/\\\\/g, '/') : '';\n1590:       return !GATE_DOCUMENT.test(path);\n1591:     }\n1592:     return false;\n1593:   });\n1594: }\n1595: \n1596: // ───────────────────────────────────────────────────────────────────\n1597: // 13. SUMMARY\n1598: // ───────────────────────────────────────────────────────────────────\n1599: \n