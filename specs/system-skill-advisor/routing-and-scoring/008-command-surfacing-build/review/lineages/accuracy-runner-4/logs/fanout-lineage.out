epthSchemaVersion\":2,\"run\":\"fanout-accuracy-runner-2-1794570021136-noekp0\",\"searchCoverage\":{\"blocked\":[],\"covered\":[\"metric_drift\",\"documentation_drift\",\"test_description_drift\",\"silent_flag\"],\"deferred\":[],\"graphCoverageMode\":\"graphless_fallback\",\"requiredBugClasses\":[\"metric_drift\",\"documentation_drift\",\"test_description_drift\",\"silent_flag\"],\"ruledOut\":[\"metric_drift\"]},\"searchLedger\":[{\"bugClass\":\"metric_drift\",\"dimension\":\"traceability\",\"disposition\":\"ruled_out\",\"hypothesis\":\"A spec floor no longer matches the committed baseline.\",\"id\":\"SL-301\",\"rationale\":\"Every floor re-derives exactly.\",\"ruledOutReason\":\"five of five floors hold\",\"searchActions\":[{\"evidenceRefs\":[\"command-routing-baseline.json\"],\"method\":\"direct_read\",\"queryOrPath\":\"baseline metrics and attachedMetrics\",\"result\":\"typed 24/44, typed combined 44/44, plain tune combined 23/45, false offers 0/35, holdout 1/44\"},{\"evidenceRefs\":[\"scorer-eval-baseline.json\"],\"method\":\"direct_read\",\"queryOrPath\":\"scorer-eval-baseline.json capturedAt\",\"result\":\"2026-10-11, equal to the command baseline's pinned date\"}],\"targetRefs\":[\"runtime/scripts/routing-accuracy/command-routing-baseline.json\",\"runtime/scripts/routing-accuracy/scorer-eval-baseline.json\"]},{\"bugClass\":\"documentation_drift\",\"dimension\":\"traceability\",\"disposition\":\"finding\",\"hypothesis\":\"The coverage note's file convention and count disagree with the tree.\",\"id\":\"SL-302\",\"linkedFindingId\":\"iter4-P2-playbook-inventory-note\",\"rationale\":\"The note contradicts the document and the tree, and the gate does not check it.\",\"searchActions\":[{\"evidenceRefs\":[\"manual-testing-playbook.md:40\"],\"method\":\"tree_listing\",\"queryOrPath\":\"find manual-testing-playbook -mindepth 2 -name '*.md'\",\"result\":\"50 files, 0 named NNN-*.md\"},{\"evidenceRefs\":[\"manual-testing-playbook.md:36\",\"manual-testing-playbook.vitest