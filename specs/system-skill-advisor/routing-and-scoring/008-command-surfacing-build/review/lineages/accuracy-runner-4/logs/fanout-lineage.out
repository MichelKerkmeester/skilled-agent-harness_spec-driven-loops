length === 0) throw new UsageError('--summary: at least one run log is required');\n      options.summaryLogs = logs;\n    } else if (token === '--pair') {\n      index += 1;\n      options.pair = valueAfter(argv, index, '--pair');\n    } else {\n      throw new UsageError(`unknown option: ${token}`);\n    }\n  }\n\n  return options;\n}\n\n// One input shape per run: a session named by a locator, or a run log that names\n// many. Accepting both at once would score one of them silently. A row id narrows\n// a run log, so the session form has no row it could pick.\nfunction selectMode(options) {\n  if (options.summaryLogs !== null) {\n    if (options.runtime !== null || options.locator !== null) {\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"wc -l .skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/score-command-transcripts.mjs .skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/capture-command-routing-baseline.mjs .skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/command-offer.mjs; echo \\\"---head of scorer---\\\"; sed -n '1,120p' .skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/score-command-transcripts.mjs\"}"},"time":{"start":1794669437576,"end":1794669437950}}}}
