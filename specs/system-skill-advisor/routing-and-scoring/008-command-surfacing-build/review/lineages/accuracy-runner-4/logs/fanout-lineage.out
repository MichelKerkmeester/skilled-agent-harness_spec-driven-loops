 to compare.\n154:     const holdoutIds = new Set(corpus.filter((row) => row.split === 'holdout').map((row) => row.id));\n155:     const ids = [\n156:       ...new Set([...corpus.map((row) => row.id), ...Object.keys(baseline.rows), ...Object.keys(live.rows)]),\n157:     ].filter((id) => !holdoutIds.has(id));\n158:     const drifted: string[] = [];\n159:     for (const id of ids) {\n160:       const baselineJson = rowJson(baseline.rows, id);\n161:       const liveJson = rowJson(live.rows, id);\n162:       if (baselineJson !== liveJson) drifted.push(`${id}: baseline ${baselineJson} live ${liveJson}`);\n163:     }\n164:     expect(\n165:       drifted,\n166:       `command routing rows drifted from the committed baseline; re-capture with \\`${RECAPTURE}\\` when the change is intended`,\n167:     ).toEqual([]);\n168:   });\n169: \n170:   it('publishes no holdout row', () => {\n171:     // The split exists to keep a holdout prompt's outcome unseen, so the\n172:     // published maps may carry its counts but never the row they were counted\n173:     // from.\n174:     const holdoutIds = new Set(corpus.filter((row) => row.split === 'holdout').map((row) => row.id));\n175:     // An empty set would make the check pass on a corpus that no longer marks\n176:     // its holdout rows.\n177:     expect(\n178:       holdoutIds.size,\n179:       'the corpus marks no holdout row, so this check would pass without testing anything',\n180:     ).toBeGreaterThan(0);\n181:     const attached = baseline.attachedMetrics as {\n182:       readonly attachedRows: Readonly<Record<string, string>>;\n183:       readonly typedRows: Readonly<Record<string, unknown>>;\n184:       readonly needsModeRows?: readonly string[];\n185:     };\n186:     const published = [\n187:       ...new Set(\n188:         [\n189:           ...Object.keys(baseline.rows),\n190:           ...Object.keys(attached.attachedRows),\n191:           ...Object.keys(attached.typedRows),\n192:           ...(attached.needsModeRows ?