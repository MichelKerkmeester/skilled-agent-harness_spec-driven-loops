N.stringify(registry.findingsBySeverity));\\nif (registry.openFindings.length !== 9) fail.push('openFindings ' + registry.openFindings.length);\\nconst expected = { 1: 3, 2: 2, 3: 2, 4: 2 };\\nfor (const row of iterations) {\\n  const n = row.iteration;\\n  if (!row.sessionId || !row.generation || !row.lineageMode || !row.resolved_route || row.target_agent !== 'deep-review' || row.agent_definition_loaded !== true) fail.push('iteration ' + n + ' route proof incomplete');\\n  if (row.findingDetails.length !== expected[n]) fail.push('iteration ' + n + ' findingDetails ' + row.findingDetails.length);\\n  const delta = read('deltas/iter-00' + n + '.jsonl').trim().split('\\\\n').map((l) => JSON.parse(l));\\n  const record = JSON.parse(read('iter-00' + n + '.record.json'));\\n  if (JSON.stringify(sorted(delta[0])) !== JSON.stringify(sorted(record))) fail.push('iteration ' + n + ' delta first line != record');\\n  if (JSON.stringify(sorted(delta[0])) !== JSON.stringify(sorted(row))) fail.push('iteration ' + n + ' delta first line != state row');\\n  const narr = read('iterations/iteration-00' + n + '.md').replace(/\\\\s+$/, '');\\n  const finalLine = narr.split('\\\\n').pop();\\n  if (finalLine !== 'Review verdict: CONDITIONAL') fail.push('iteration ' + n + ' final line ' + JSON.stringify(finalLine));\\n  const findingRows = delta.filter((d) => d.type === 'finding');\\n  if (findingRows.length !== expected[n]) fail.push('iteration ' + n + ' delta finding rows ' + findingRows.length);\\n}\\nconst report = read('review-report.md');\\nfor (const section of ['## 1. Executive Summary','## 2. Planning Trigger','## 3. Active Finding Registry','## 4. Remediation Workstreams','## 5. Spec Seed','## 6. Plan Seed','## 7. Traceability Status','## 8. Deferred Items','## 9. Dimension Expansion Map','## 10. Search Ledger','## 11. Audit Appendix']) {\\n  if (!report.includes(section)) fail.push('report missing ' + section);\\n}\\nconst strategy = read('deep-review-strategy.md');\\nif (!strategy.includes('P1 (Required): 2') || !strategy.includes('P2 (Suggestions): 7')) fail.push('strategy counts');\\nconsole.log(JSON.stringify({ ok: fail.length === 0, failures: fail, stateRows: state.length, iterations: iterations.length, registry: registry.findingsBySeverity, lastRow: { type: last.type, event: last.event, stopReason: last.stopReason, verdict: last.verdict, activeP1: last.activeP1, activeP2: last.activeP2 }, configStatus: config.status }, null, 2));\\nNODE\"}"},"time":{"start":1794671275148,"end":1794671282530}}}}
