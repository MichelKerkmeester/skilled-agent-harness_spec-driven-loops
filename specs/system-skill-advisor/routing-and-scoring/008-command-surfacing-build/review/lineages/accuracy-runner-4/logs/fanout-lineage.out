{"type":"tool_use","timestamp":1794669554536,"sessionID":"ses_e255ff46effeHQ7tMXhYT9pQMI","part":{"partID":"prt_1daa42648002UaES2ThdupoaZj","sessionID":"ses_e255ff46effeHQ7tMXhYT9pQMI","messageID":"msg_1daa3544c001K9NjTKmpdlbYRx","type":"tool","id":"call_8e9bf226f7664a9dad6fb794","tool":"read","state":{"status":"completed","input":{"limit":240,"offset":280,"path":".skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/capture-command-routing-baseline.mjs"},"output":"Read file .skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/capture-command-routing-baseline.mjs, lines 280-519\n280: function commandOf(idToCommand, id) {\n281:   return idToCommand.get(id)?.command ?? null;\n282: }\n283: \n284: // The route arrives from a separate process, so a spawn that fails, times out or\n285: // prints anything unparsable yields no route: a broken read must degrade to \"no\n286: // command offered\" rather than to an invented one.\n287: function readCompiledRoute(workspaceRoot, hubId, prompt) {\n288:   try {\n289:     const stdout = execFileSync('node', [join(workspaceRoot, COMPILED_ROUTE_CLI), '--hub', hubId, '--prompt-stdin'], {\n290:       cwd: workspaceRoot,\n291:       input: prompt,\n292:       encoding: 'utf8',\n293:       timeout: COMPILED_ROUTE_TIMEOUT_MS,\n294:       stdio: ['pipe', 'pipe', 'ignore'],\n295:     });\n296:     const route = JSON.parse(stdout);\n297:     return typeof route === 'object' && route !== null ? route : undefined;\n298:   } catch {\n299:     return undefined;\n300:   }\n301: }\n302: \n303: // A bridge that outranks nothing still stays reachable: when the two leaders are\n304: // a bridge and the skill that owns it, the reader gets the command without the\n305: // bridge displacing the skill the prompt actually asked for. The order is\n306: // irrelevant because the scorer's tie-break says nothing about ownership.\n307: function isBridgeOwnerPair(idToCommand, ids, expected) {\n308:   const [first, second] = ids;\n309:   if (first === undefined || second === undefined) return false;\n310:   const leading = idToCommand.get(first);\n311:   if (leading && leading.command === expected && leading.skillId === second) return true;\n312:   const trailing = idToCommand.get(second);\n313:   return Boolean(trailing && trailing.command === expected && trailing.skillId === first);\n314: }\n315: \n316: // A fit row asks whether the head carries a command where none fits its request,\n317: // so the head carries one when the leading recommendation reaches a command, or\n318: // when a typed command or hub route delivered one.\n319: function headCarriesCommand(landed, delivered) {\n320:   return landed[0] != null || delivered !== undefined;\n321: }\n322: \n323: // The scorer reports ranked recommendations when the projection produced a\n324: // list, and only a top pick otherwise; both shapes have to be scorable.\n325: function recommendationIds(result) {\n326:   if (Array.isArray(result?.recommendations)) {\n327:     return result.recommendations.slice(0, 3).map((recommendation) => recommendation.skill);\n328:   }\n329:   return result?.topSkill === null || result?.topSkill === undefined ? [] : [result.topSkill];\n330: }\n331: \n332: function emptyTally() {\n333:   return { rows: 0, top1: 0, top3: 0 };\n334: }\n335: \n336: function addRow(tally, top1Hit, top3Hit) {\n337:   tally.rows += 1;\n338:   if (top1Hit) tally.top1 += 1;\n339:   if (top3Hit) tally.top3 += 1;\n340: }\n341: \n342: // Attached reach is kept apart from bridge reach and only ever counts a row the\n343: // ranked bridge did not already land, so `own` and `attached` partition the rows\n344: // and their sum is real reach rather than one row claimed twice.\n345: function emptyAttachedTally() {\n346:   return { own: 0, attached: 0, total: 0 };\n347: }\n348: \n349: function addAttachedRow(tally, ownHit, attachedHit) {\n350:   tally.total += 1;\n351:   if (ownHit) tally.own += 1;\n352:   if (attachedHit) tally.attached += 1;\n353: }\n354: \n355: // A plain row leaves the path to its command at one stage, and the tally says\n356: // which stage that was.\n357: function emptyStageTally() {\n358:   return { total: 0, own: 0, ownerLed: 0, routed: 0, withCommand: 0, attached: 0, neither: 0 };\n359: }\n360: \n361: function addStageRow(tally, facts) {\n362:   tally.total += 1;\n363:   if (facts.own) tally.own += 1;\n364:   if (facts.ownerLed) tally.ownerLed += 1;\n365:   if (facts.routed) tally.routed += 1;\n366:   if (facts.withCommand) tally.withCommand += 1;\n367:   if (facts.attached) tally.attached += 1;\n368:   if (facts.neither) tally.neither += 1;\n369: }\n370: \n371: function attachedTallyJson(tally) {\n372:   return { own: tally.own, attached: tally.attached, combined: tally.own + tally.attached, total: tally.total };\n373: }\n374: \n375: // Commands are named `<namespace>:<name>`, so the namespace is the workflow\n376: // family a reach number belongs to.\n377: function commandNamespace(command) {\n378:   if (typeof command !== 'string' || !command.startsWith('/')) return null;\n379:   const colon = command.indexOf(':');\n380:   return colon > 1 ? command.slice(1, colon) : null;\n381: }\n382: \n383: // Individual rows roll up to a family only when their command names one, so a\n384: // command outside the `<namespace>:<name>` grammar still counts in the split\n385: // total without inventing a family for itself.\n386: function attachedFamilyTally(byFamily, command) {\n387:   const namespace = commandNamespace(command);\n388:   if (namespace === null) return undefined;\n389:   if (!byFamily.has(namespace)) {\n390:     byFamily.set(namespace, { tune: emptyAttachedTally(), holdout: emptyAttachedTally() });\n391:   }\n392:   return byFamily.get(namespace);\n393: }\n394: \n395: function readHeadSha(workspaceRoot) {\n396:   const spawned = spawnSync('git', ['rev-parse', '--short', 'HEAD'], { cwd: workspaceRoot, encoding: 'utf8' });\n397:   return spawned.status === 0 ? spawned.stdout.trim() : 'unknown';\n398: }\n399: \n400: // ───────────────────────────────────────────────────────────────────\n401: // 6. CORE LOGIC\n402: // ───────────────────────────────────────────────────────────────────\n403: \n404: export async function scoreCommandCorpus(options = {}) {\n405:   const realEmbedding = options.realEmbedding === true;\n406:   const RealDate = Date;\n407:   // A harness imports this module and scores in process, so the projection must\n408:   // not outlive the call: every name it writes or deletes is saved here and put\n409:   // back in the `finally`, with an absent name deleted again.\n410:   const savedEnv = new Map(PROJECTED_ENV_NAMES.map((name) => [name, process.env[name]]));\n411:   // The projection needs an existing, empty cache directory, and that directory\n412:   // is scratch space this run owns. It is created before the `try` so a failure\n413:   // to create it has nothing left to remove, and removed in the `finally` so\n414:   // repeated captures do not leave one behind per run. A real capture reads the\n415:   // operator's own skill graph, so it owns no scratch directory and sweeps none.\n416:   const dbDir = realEmbedding ? null : mkdtempSync(join(tmpdir(), 'advisor-command-routing-'));\n417:   try {\n418:     // Environment projection. That empty directory makes the SQLite loader\n419:     // return null, so the projection is built from committed metadata alone,\n420:     // which is the only state a clean checkout can reproduce. A real capture reads\n421:     // the operator's own skill graph and embedder instead, so the three variables\n422:     // that select the projection are exactly the three it leaves unset.\n423:     if (!realEmbedding) {\n424:       process.env.SYSTEM_SKILL_ADVISOR_DB_DIR = dbDir;\n425:       process.env.SKILL_ADVISOR_DISABLE_BUILTIN_SEMANTIC = '1';\n426:       // Match the test-harness regime: the semantic-shadow lane substitutes\n427:       // deterministic fixture vectors under the harness flag (real embeddings are\n428:       // not reproducible in CI), so every scorer gate runs this way. The baseline\n429:       // must be captured under the same regime the ratchet re-scores it in.\n430:       process.env.VITEST = 'true';\n431:     }\n432:     process.env.SPECKIT_SKILL_ADVISOR_FORCE_LOCAL = '1';\n433:     process.env.PYTHONDONTWRITEBYTECODE = '1';\n434:     delete process.env.SPECKIT_ADVISOR_LANE_WEIGHTS_JSON;\n435:     delete process.env.SPECKIT_ADVISOR_LANE_SHADOW_WEIGHTS_JSON;\n436:     delete process.env.SPECKIT_ADVISOR_BM25_LEXICAL_SHADOW;\n437:     // Private `local-*` skills linked in through this variable live outside the\n438:     // checkout, so a baseline measured on a clean checkout must not see them.\n439:     delete process.env.SPECKIT_PRIVATE_SKILL_ROOTS;\n440: \n441:     // Pin the scoring clock to midnight UTC on the inherited scoring date.\n442:     const capturedAt = readPinnedScoringDate();\n443:     const scoringInstant = Date.parse(`${capturedAt}T00:00:00Z`);\n444:     globalThis.Date = class extends RealDate {\n445:       constructor(...args) {\n446:         if (args.length === 0) super(scoringInstant);\n447:         else super(...args);\n448:       }\n449: \n450:       static now() {\n451:         return scoringInstant;\n452:       }\n453:     };\n454: \n455:     if (!existsSync(FUSION_MODULE)) {\n456:       throw new Error(`built scorer file missing: ${FUSION_MODULE}`);\n457:     }\n458:     for (const modulePath of [COMMAND_ATTACH_MODULE, COMPILED_ROUTING_FLAG_MODULE, PROMPT_POLICY_MODULE]) {\n459:       if (!existsSync(modulePath)) {\n460:         throw new Error(`built command-attach file missing: ${modulePath}`);\n461:       }\n462:     }\n463: \n464:     // Imported after the clock is pinned so the compiled scorer initializes\n465:     // against the pinned date, and only after it is known to exist so a missing\n466:     // build is reported as such rather than as a module-resolution failure.\n467:     const { scoreAdvisorPrompt } = await import(pathToFileURL(FUSION_MODULE).href);\n468:     const { findAdvisorWorkspaceRoot } = await import(pathToFileURL(WORKSPACE_ROOT_MODULE).href);\n469:     const { attachCommand, typedCommandForTop, TRACKED_COMMANDS, routeNeedsMode } = await import(pathToFileURL(COMMAND_ATTACH_MODULE).href);\n470:     const { extractMetalinguisticSkillMentions } = await import(pathToFileURL(PROMPT_POLICY_MODULE).href);\n471:     const { COMPILED_ROUTING_HUBS } = await import(pathToFileURL(COMPILED_ROUTING_FLAG_MODULE).href);\n472:     const workspaceRoot = findAdvisorWorkspaceRoot(HERE, { maxDepth: 14, sentinel: SENTINEL });\n473: \n474:     // A missing front door would make every spawn fail and report the same zero\n475:     // as a hub with nothing to attach, so it fails the capture instead.\n476:     if (!existsSync(resolve(workspaceRoot, COMPILED_ROUTE_CLI))) {\n477:       throw new Error(`compiled route front door missing: ${resolve(workspaceRoot, COMPILED_ROUTE_CLI)}`);\n478:     }\n479: \n480:     // A build older than its source scores code that no longer exists, so its\n481:     // numbers would describe a scorer nobody can read. Refuse it, and likewise\n482:     // a build whose freshness cannot be assessed.\n483:     const { checkPackageFreshness } = createRequire(import.meta.url)(DIST_FRESHNESS_MODULE);\n484:     const freshness = checkPackageFreshness('system-skill-advisor/runtime', { workspaceRoot });\n485:     if (freshness.status !== 'fresh') {\n486:       throw new Error(freshness.message);\n487:     }\n488: \n489:     // Real scoring is the only mode that reads this machine, so it is the only one\n490:     // that has to prove the machine can answer before walking the corpus. Without\n491:     // the flag nothing here runs and the prompt embedding is the direct call below.\n492:     const embedPrompt = realEmbedding ? await prepareRealEmbeddingScoring() : null;\n493: \n494:     const commandNames = readCommandFileNames(workspaceRoot);\n495:     const commandSet = new Set(commandNames);\n496:     const { bridgeCounts, idToCommand } = readBridgeMap(BRIDGES_JSON);\n497:     // A hub route attaches commands whose TypeScript bridge is disabled, so the\n498:     // scorer-id map cannot name their owner and every bridge entry is the only\n499:     // complete command-to-owner source.\n500:     const commandOwner = new Map();\n501:     for (const entry of JSON.parse(readFileSync(BRIDGES_JSON, 'utf8')).entries ?? []) {\n502:       commandOwner.set(entry.command, entry.skillId);\n503:     }\n504:     const corpus = readCorpus(CORPUS_JSONL);\n505:     assertFitRowsUnique(corpus);\n506: \n507:     // A label naming a command that does not exist would silently score as a\n508:     // permanent miss, so it fails the capture instead of deflating a metric.\n509:     for (const row of corpus) {\n510:       if (row.expected_command === null || row.expected_command === undefined) continue;\n511:       if (!commandSet.has(row.expected_command)) {\n512:         throw new Error(`corpus row ${row.id} expects ${row.expected_command}, which is not a command file under ${resolve(workspaceRoot, COMMANDS_DIR)}`);\n513:       }\n514:     }\n515: \n516:     const perCommand = new Map();\n517:     for (const command of commandNames) {\n518:       perCommand.set(command, { typed: emptyTally(), plain: { tune: emptyTally(), holdout: emptyTally() } });\n519:     }\n[Output truncated. Continue reading with offset: 520]","title":"read","metadata":{"metadata":{"truncated":true},"content":[{"type":"text","text":"Read file .skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/capture-command-routing-baseline.mjs, lines 280-519\n280: function commandOf(idToCommand, id) {\n281:   return idToCommand.get(id)?.command ?? null;\n282: }\n283: \n284: // The route arrives from a separate process, so a spawn that fails, times out or\n285: // prints anything unparsable yields no route: a broken read must degrade to \"no\n286: // command offered\" rather than to an invented one.\n287: function readCompiledRoute(workspaceRoot, hubId, prompt) {\n288:   try {\n289:     const stdout = execFileSync('node', [join(workspaceRoot, COMPILED_ROUTE_CLI), '--hub', hubId, '--prompt-stdin'], {\n290:       cwd: workspaceRoot,\n291:       input: prompt,\n292:       encoding: 'utf8',\n293:       timeout: COMPILED_ROUTE_TIMEOUT_MS,\n294:       stdio: ['pipe', 'pipe', 'ignore'],\n295:     });\n296:     const route = JSON.parse(stdout);\n297:     return typeof route === 'object' && route !== null ? route : undefined;\n298:   } catch {\n299:     return undefined;\n300:   }\n301: }\n302: \n303: // A bridge that outranks nothing still stays reachable: when the two leaders are\n304: // a bridge and the skill that owns it, the reader gets the command without the\n305: // bridge displacing the skill the prompt actually asked for. The order is\n306: // irrelevant because the scorer's tie-break says nothing about ownership.\n307: function isBridgeOwnerPair(idToCommand, ids, expected) {\n308:   const [first, second] = ids;\n309:   if (first === undefined || second === undefined) return false;\n310:   const leading = idToCommand.get(first);\n311:   if (leading && leading.command === expected && leading.skillId === second) return true;\n312:   const trailing = idToCommand.get(second);\n313:   return Boolean(trailing && trailing.command === expected && trailing.skillId === first);\n314: }\n315: \n316: // A fit row asks whether the head carries a command where none fits its request,\n317: // so the head carries one when the leading recommendation reaches a command, or\n318: // when a typed command or hub route delivered one.\n319: function headCarriesCommand(landed, delivered) {\n320:   return landed[0] != null || delivered !== undefined;\n321: }\n322: \n323: // The scorer reports ranked recommendations when the projection produced a\n324: // list, and only a top pick otherwise; both shapes have to be scorable.\n325: function recommendationIds(result) {\n326:   if (Array.isArray(result?.recommendations)) {\n327:     return result.recommendations.slice(0, 3).map((recommendation) => recommendation.skill);\n328:   }\n329:   return result?.topSkill === null || result?.topSkill === undefined ? [] : [result.topSkill];\n330: }\n331: \n332: function emptyTally() {\n333:   return { rows: 0, top1: 0, top3: 0 };\n334: }\n335: \n336: function addRow(tally, top1Hit, top3Hit) {\n337:   tally.rows += 1;\n338:   if (top1Hit) tally.top1 += 1;\n339:   if (top3Hit) tally.top3 += 1;\n340: }\n341: \n342: // Attached reach is kept apart from bridge reach and only ever counts a row the\n343: // ranked bridge did not already land, so `own` and `attached` partition the rows\n344: // and their sum is real reach rather than one row claimed twice.\n345: function emptyAttachedTally() {\n346:   return { own: 0, attached: 0, total: 0 };\n347: }\n348: \n349: function addAttachedRow(tally, ownHit, attachedHit) {\n350:   tally.total += 1;\n351:   if (ownHit) tally.own += 1;\n352:   if (attachedHit) tally.attached += 1;\n353: }\n354: \n355: // A plain row leaves the path to its command at one stage, and the tally says\n356: // which stage that was.\n357: function emptyStageTally() {\n358:   return { total: 0, own: 0, ownerLed: 0, routed: 0, withCommand: 0, attached: 0, neither: 0 };\n359: }\n360: \n361: function addStageRow(tally, facts) {\n362:   tally.total += 1;\n363:   if (facts.own) tally.own += 1;\n364:   if (facts.ownerLed) tally.ownerLed += 1;\n365:   if (facts.routed) tally.routed += 1;\n366:   if (facts.withCommand) tally.withCommand += 1;\n367:   if (facts.attached) tally.attached += 1;\n368:   if (facts.neither) tally.neither += 1;\n369: }\n370: \n371: function attachedTallyJson(tally) {\n372:   return { own: tally.own, attached: tally.attached, combined: tally.own + tally.attached, total: tally.total };\n373: }\n374: \n375: // Commands are named `<namespace>:<name>`, so the namespace is the workflow\n376: // family a reach number belongs to.\n377: function commandNamespace(command) {\n378:   if (typeof command !== 'string' || !command.startsWith('/')) return null;\n379:   const colon = command.indexOf(':');\n380:   return colon > 1 ? command.slice(1, colon) : null;\n381: }\n382: \n383: // Individual rows roll up to a family only when their command names one, so a\n384: // command outside the `<namespace>:<name>` grammar still counts in the split\n385: // total without inventing a family for itself.\n386: function attachedFamilyTally(byFamily, command) {\n387:   const namespace = commandNamespace(command);\n388:   if (namespace === null) return undefined;\n389:   if (!byFamily.has(namespace)) {\n390:     byFamily.set(namespace, { tune: emptyAttachedTally(), holdout: emptyAttachedTally() });\n391:   }\n392:   return byFamily.get(namespace);\n393: }\n394: \n395: function readHeadSha(workspaceRoot) {\n396:   const spawned = spawnSync('git', ['rev-parse', '--short', 'HEAD'], { cwd: workspaceRoot, encoding: 'utf8' });\n397:   return spawned.status === 0 ? spawned.stdout.trim() : 'unknown';\n398: }\n399: \n400: // ───────────────────────────────────────────────────────────────────\n401: // 6. CORE LOGIC\n402: // ───────────────────────────────────────────────────────────────────\n403: \n404: export async function scoreCommandCorpus(options = {}) {\n405:   const realEmbedding = options.realEmbedding === true;\n406:   const RealDate = Date;\n407:   // A harness imports this module and scores in process, so the projection must\n408:   // not outlive the call: every name it writes or deletes is saved here and put\n409:   // back in the `finally`, with an absent name deleted again.\n410:   const savedEnv = new Map(PROJECTED_ENV_NAMES.map((name) => [name, process.env[name]]));\n411:   // The projection needs an existing, empty cache directory, and that directory\n412:   // is scratch space this run owns. It is created before the `try` so a failure\n413:   // to create it has nothing left to remove, and removed in the `finally` so\n414:   // repeated captures do not leave one behind per run. A real capture reads the\n415:   // operator's own skill graph, so it owns no scratch directory and sweeps none.\n416:   const dbDir = realEmbedding ? null : mkdtempSync(join(tmpdir(), 'advisor-command-routing-'));\n417:   try {\n418:     // Environment projection. That empty directory makes the SQLite loader\n419:     // return null, so the projection is built from committed metadata alone,\n420:     // which is the only state a clean checkout can reproduce. A real capture reads\n421:     // the operator's own skill graph and embedder instead, so the three variables\n422:     // that select the projection are exactly the three it leaves unset.\n423:     if (!realEmbedding) {\n424:       process.env.SYSTEM_SKILL_ADVISOR_DB_DIR = dbDir;\n425:       process.env.SKILL_ADVISOR_DISABLE_BUILTIN_SEMANTIC = '1';\n426:       // Match the test-harness regime: the semantic-shadow lane substitutes\n427:       // deterministic fixture vectors under the harness flag (real embeddings are\n428:       // not reproducible in CI), so every scorer gate runs this way. The baseline\n429:       // must be captured under the same regime the ratchet re-scores it in.\n430:       process.env.VITEST = 'true';\n431:     }\n432:     process.env.SPECKIT_SKILL_ADVISOR_FORCE_LOCAL = '1';\n433:     process.env.PYTHONDONTWRITEBYTECODE = '1';\n434:     delete process.env.SPECKIT_ADVISOR_LANE_WEIGHTS_JSON;\n435:     delete process.env.SPECKIT_ADVISOR_LANE_SHADOW_WEIGHTS_JSON;\n436:     delete process.env.SPECKIT_ADVISOR_BM25_LEXICAL_SHADOW;\n437:     // Private `local-*` skills linked in through this variable live outside the\n438:     // checkout, so a baseline measured on a clean checkout must not see them.\n439:     delete process.env.SPECKIT_PRIVATE_SKILL_ROOTS;\n440: \n441:     // Pin the scoring clock to midnight UTC on the inherited scoring date.\n442:     const capturedAt = readPinnedScoringDate();\n443:     const scoringInstant = Date.parse(`${capturedAt}T00:00:00Z`);\n444:     globalThis.Date = class extends RealDate {\n445:       constructor(...args) {\n446:         if (args.length === 0) super(scoringInstant);\n447:         else super(...args);\n448:       }\n449: \n450:       static now() {\n451:         return scoringInstant;\n452:       }\n453:     };\n454: \n455:     if (!existsSync(FUSION_MODULE)) {\n456:       throw new Error(`built scorer file missing: ${FUSION_MODULE}`);\n457:     }\n458:     for (const modulePath of [COMMAND_ATTACH_MODULE, COMPILED_ROUTING_FLAG_MODULE, PROMPT_POLICY_MODULE]) {\n459:       if (!existsSync(modulePath)) {\n460:         throw new Error(`built command-attach file missing: ${modulePath}`);\n461:       }\n462:     }\n463: \n464:     // Imported after the clock is pinned so the compiled scorer initializes\n465:     // against the pinned date, and only after it is known to exist so a missing\n466:     // build is reported as such rather than as a module-resolution failure.\n467:     const { scoreAdvisorPrompt } = await import(pathToFileURL(FUSION_MODULE).href);\n468:     const { findAdvisorWorkspaceRoot } = await import(pathToFileURL(WORKSPACE_ROOT_MODULE).href);\n469:     const { attachCommand, typedCommandForTop, TRACKED_COMMANDS, routeNeedsMode } = await import(pathToFileURL(COMMAND_ATTACH_MODULE).href);\n470:     const { extractMetalinguisticSkillMentions } = await import(pathToFileURL(PROMPT_POLICY_MODULE).href);\n471:     const { COMPILED_ROUTING_HUBS } = await import(pathToFileURL(COMPILED_ROUTING_FLAG_MODULE).href);\n472:     const workspaceRoot = findAdvisorWorkspaceRoot(HERE, { maxDepth: 14, sentinel: SENTINEL });\n473: \n474:     // A missing front door would make every spawn fail and report the same zero\n475:     // as a hub with nothing to attach, so it fails the capture instead.\n476:     if (!existsSync(resolve(workspaceRoot, COMPILED_ROUTE_CLI))) {\n477:       throw new Error(`compiled route front door missing: ${resolve(workspaceRoot, COMPILED_ROUTE_CLI)}`);\n478:     }\n479: \n480:     // A build older than its source scores code that no longer exists, so its\n481:     // numbers would describe a scorer nobody can read. Refuse it, and likewise\n482:     // a build whose freshness cannot be assessed.\n483:     const { checkPackageFreshness } = createRequire(import.meta.url)(DIST_FRESHNESS_MODULE);\n484:     const freshness = checkPackageFreshness('system-skill-advisor/runtime', { workspaceRoot });\n485:     if (freshness.status !== 'fresh') {\n486:       throw new Error(freshness.message);\n487:     }\n488: \n489:     // Real scoring is the only mode that reads this machine, so it is the only one\n490:     // that has to prove the machine can answer before walking the corpus. Without\n491:     // the flag nothing here runs and the prompt embedding is the direct call below.\n492:     const embedPrompt = realEmbedding ? await prepareRealEmbeddingScoring() : null;\n493: \n494:     const commandNames = readCommandFileNames(workspaceRoot);\n495:     const commandSet = new Set(commandNames);\n496:     const { bridgeCounts, idToCommand } = readBridgeMap(BRIDGES_JSON);\n497:     // A hub route attaches commands whose TypeScript bridge is disabled, so the\n498:     // scorer-id map cannot name their owner and every bridge entry is the only\n499:     // complete command-to-owner source.\n500:     const commandOwner = new Map();\n501:     for (const entry of JSON.parse(readFileSync(BRIDGES_JSON, 'utf8')).entries ?? []) {\n502:       commandOwner.set(entry.command, entry.skillId);\n503:     }\n504:     const corpus = readCorpus(CORPUS_JSONL);\n505:     assertFitRowsUnique(corpus);\n506: \n507:     // A label naming a command that does not exist would silently score as a\n508:     // permanent miss, so it fails the capture instead of deflating a metric.\n509:     for (const row of corpus) {\n510:       if (row.expected_command === null || row.expected_command === undefined) continue;\n511:       if (!commandSet.has(row.expected_command)) {\n512:         throw new Error(`corpus row ${row.id} expects ${row.expected_command}, which is not a command file under ${resolve(workspaceRoot, COMMANDS_DIR)}`);\n513:       }\n514:     }\n515: \n516:     const perCommand = new Map();\n517:     for (const command of commandNames) {\n518:       perCommand.set(command, { typed: emptyTally(), plain: { tune: emptyTally(), holdout: emptyTally() } });\n519:     }\n[Output truncated. Continue reading with offset: 520]"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"limit\":240,\"offset\":280,\"path\":\".skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/capture-command-routing-baseline.mjs\"}"},"time":{"start":1794669553224,"end":1794669554536}}}}
{"type":"tool_use","timestamp":1794669554560,"sessionID":"ses_e255ff46effeHQ7tMXhYT9pQMI","part":{"partID":"prt_1daa4285d001Uf07bVl0ocIeLU","sessionID":"ses_e255ff46effeHQ7tMXhYT9pQMI","messageID":"msg_1daa3544c001K9NjTKmpdlbYRx","type":"tool","id":"call_4e21eecb9f034f25becaad67","tool":"read","state":{"status":"completed","input":{"limit":220,"offset":520,"path":".skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/capture-command-routing-baseline.mjs"},"output":"Read file .skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/capture-command-routing-baseline.mjs, lines 520-739\n520: \n521:     const typed = emptyTally();\n522:     const plain = { tune: emptyTally(), holdout: emptyTally() };\n523:     let falseOfferCount = 0;\n524:     let falseOfferTotal = 0;\n525:     let slashReachedTop3 = 0;\n526:     let slashNamedTotal = 0;\n527:     let slashOfferedOnPartial = 0;\n528:     let slashPartialTotal = 0;\n529:     let agreementCorrect = 0;\n530:     let agreementTotal = 0;\n531:     // Per-row results sit beside the totals because a total can hold still\n532:     // while one row is gained and another lost, and a changed label has to\n533:     // surface under the id of the row it belongs to.\n534:     const rows = {};\n535:     // Attached reach: what a hub's own route adds on the same rows, split the\n536:     // same way, plus the rows that had to stay silent and the ties a bridge\n537:     // leaves with its own owner.\n538:     const attachedRows = {};\n539:     // A typed command reaches the reader through the recommendation that leads,\n540:     // so it is tallied apart from hub-attached reach: `own` is a row the scorer\n541:     // already landed and `attached` is one delivered by the reader's own typed\n542:     // command. Its resolution follows the recommend handler exactly.\n543:     const typedAttached = emptyAttachedTally();\n544:     const typedRowResults = {};\n545:     const plainAttached = { tune: emptyAttachedTally(), holdout: emptyAttachedTally() };\n546:     const plainStages = { tune: emptyStageTally(), holdout: emptyStageTally() };\n547:     // A fit row asks a question of its own, whether the head carries a command\n548:     // where none fits, so its counts sit apart from every recall tally and never\n549:     // reach a row map.\n550:     const fitTally = {\n551:       skillOnly: { carried: 0, total: 0 },\n552:       decline: { carried: 0, total: 0, byKind: {} },\n553:     };\n554:     const plainAttachedByFamily = new Map();\n555:     const sameOwnerAmbiguous = [];\n556:     let falseOfferAttached = 0;\n557:     const needsModeRows = [];\n558:     let needsModeFloor = 0;\n559: \n560:     for (const row of corpus) {\n561:       // The recommend path supplies the semantic lane's prompt vector through this\n562:       // wrapper, so a real capture threads the same path rather than scoring with\n563:       // the lane blind. Under the fixture regime the lane derives its own\n564:       // deterministic vector and the direct call is the whole behavior.\n565:       const score = () => scoreAdvisorPrompt(row.prompt, { workspaceRoot });\n566:       const result = embedPrompt === null ? score() : await embedPrompt(row.prompt, score);\n567:       const ids = recommendationIds(result);\n568:       const landed = ids.map((id) => commandOf(idToCommand, id));\n569:       const expected = row.expected_command ?? null;\n570:       const top1Hit = expected !== null && landed[0] === expected;\n571:       const top3Hit = expected !== null && landed.includes(expected);\n572:       // True when any of the top three recommendations maps to a command bridge,\n573:       // so this is a reach measure. It is not whether a brief head offered the\n574:       // command, which the behaviour run line records as `offeredCommand`.\n575:       const offered = landed.some((command) => command !== null);\n576:       const isPlainSplit = row.row_type === 'plain' && (row.split === 'tune' || row.split === 'holdout');\n577:       // A holdout row's outcome is what the split exists to keep unseen, so\n578:       // only its counts are published.\n579:       const publishRow = row.split !== 'holdout';\n580: \n581:       // A hub can name the slash command its route would take, which is reach a\n582:       // reader otherwise gets only by translating the workflow mode by hand.\n583:       const topId = ids[0];\n584:       const route = topId !== undefined && COMPILED_ROUTING_HUBS.has(topId)\n585:         ? readCompiledRoute(workspaceRoot, topId, row.prompt)\n586:         : undefined;\n587:       const attached = route !== undefined ? attachCommand(topId, route, row.prompt) : undefined;\n588:       const attachedHit = attached !== undefined && attached === expected && !top1Hit;\n589:       // A typed command is the reader's own wording, so it outranks the hub's\n590:       // route in the delivered command, the same precedence the handler applies.\n591:       const delivered = typedCommandForTop(topId, row.prompt)?.command ?? attached;\n592:       // A fit row is counted here and then leaves the loop, so no recall, reach,\n593:       // silence or agreement count below describes it and no row map publishes\n594:       // it. A decline row also rolls up under the kind it declares.\n595:       if (row.row_type === 'skill-only' || row.row_type === 'decline') {\n596:         const carries = headCarriesCommand(landed, delivered);\n597:         const tally = row.row_type === 'skill-only' ? fitTally.skillOnly : fitTally.decline;\n598:         tally.total += 1;\n599:         if (carries) tally.carried += 1;\n600:         if (row.row_type === 'decline') {\n601:           const kind = row.decline_kind;\n602:           if (tally.byKind[kind] === undefined) tally.byKind[kind] = { carried: 0, total: 0 };\n603:           tally.byKind[kind].total += 1;\n604:           if (carries) tally.byKind[kind].carried += 1;\n605:         }\n606:         continue;\n607:       }\n608:       // A head shows that label only when nothing else names a command, so a row\n609:       // counts only when neither the typed command nor the route delivered one. A\n610:       // silent row that carries it shows a label nobody asked for.\n611:       const needsMode = route !== undefined && delivered === undefined && routeNeedsMode(topId, route, extractMetalinguisticSkillMentions(row.prompt));\n612:       // The list names rows with their outcome, so a holdout row stays out of it\n613:       // as it stays out of the row maps.\n614:       if (needsMode && publishRow) needsModeRows.push(row.id);\n615:       const deliveredPolicy = delivered === undefined ? null : TRACKED_COMMANDS[delivered]?.policy ?? null;\n616:       const deliveredHit = !top1Hit && delivered === expected && deliveredPolicy !== null;\n617: \n618:       if (row.row_type === 'typed') {\n619:         addRow(typed, top1Hit, top3Hit);\n620:         addAttachedRow(typedAttached, top1Hit, deliveredHit);\n621:         if (publishRow) {\n622:           typedRowResults[row.id] = {\n623:             expected_command: expected,\n624:             top: ids[0] ?? null,\n625:             carried: top1Hit ? 'own' : deliveredHit ? 'attached' : null,\n626:             command: delivered ?? null,\n627:             policy: deliveredPolicy,\n628:           };\n629:         }\n630:       }\n631:       if (isPlainSplit) {\n632:         addRow(plain[row.split], top1Hit, top3Hit);\n633:         addAttachedRow(plainAttached[row.split], top1Hit, attachedHit);\n634:         const family = attachedFamilyTally(plainAttachedByFamily, expected);\n635:         if (family) addAttachedRow(family[row.split], top1Hit, attachedHit);\n636:         // `own` and `ownerLed` split the rows and `neither` is the remainder,\n637:         // while the counted stages nest from owner-led down to attached.\n638:         const owningSkill = expected === null ? undefined : commandOwner.get(expected);\n639:         const ownerLed = !top1Hit && owningSkill !== undefined && owningSkill === topId;\n640:         const routed = ownerLed && route !== undefined;\n641:         const withCommand = routed && attached !== undefined;\n642:         addStageRow(plainStages[row.split], {\n643:           own: top1Hit,\n644:           ownerLed,\n645:           routed,\n646:           withCommand,\n647:           attached: attachedHit,\n648:           neither: !top1Hit && !ownerLed,\n649:         });\n650:       }\n651:       if (publishRow && attached !== undefined) attachedRows[row.id] = attached;\n652:       if (row.row_type === 'typed' && result?.ambiguous === true && isBridgeOwnerPair(idToCommand, ids, expected)) {\n653:         sameOwnerAmbiguous.push(row.id);\n654:       }\n655: \n656:       const commandTally = expected === null ? undefined : perCommand.get(expected);\n657:       if (commandTally) {\n658:         if (row.row_type === 'typed') addRow(commandTally.typed, top1Hit, top3Hit);\n659:         else if (isPlainSplit) addRow(commandTally.plain[row.split], top1Hit, top3Hit);\n660:       }\n661: \n662:       if (publishRow) {\n663:         rows[row.id] = { expected_command: expected, top: ids[0] ?? null, top1: top1Hit, top3: top3Hit, offered };\n664:       }\n665: \n666:       const isSlashVariant = row.row_type === 'slash-variant';\n667:       // Silence is the requirement for a near miss, a prompt that must not\n668:       // trigger a command, and a partial slash mention that names no command.\n669:       const wantsSilence = row.row_type === 'must-not-start'\n670:         || row.row_type === 'near-miss'\n671:         || (isSlashVariant && expected === null);\n672:       if (wantsSilence) {\n673:         falseOfferTotal += 1;\n674:         if (offered) falseOfferCount += 1;\n675:         if (attached !== undefined) falseOfferAttached += 1;\n676:         if (needsMode) needsModeFloor += 1;\n677:       }\n678: \n679:       if (isSlashVariant) {\n680:         if (expected === null) {\n681:           slashPartialTotal += 1;\n682:           if (offered) slashOfferedOnPartial += 1;\n683:         } else {\n684:           slashNamedTotal += 1;\n685:           if (top3Hit) slashReachedTop3 += 1;\n686:         }\n687:       }\n688: \n689:       // A bridge offered below a skill is correct when the skill that outranked\n690:       // it is the bridge's own owner: the command stays reachable without the\n691:       // bridge displacing the skill the prompt actually asked for.\n692:       if (!idToCommand.has(ids[0])) {\n693:         const laterBridgeId = ids.slice(1).find((id) => idToCommand.has(id));\n694:         if (laterBridgeId !== undefined) {\n695:           agreementTotal += 1;\n696:           if (idToCommand.get(laterBridgeId).skillId === ids[0]) agreementCorrect += 1;\n697:         }\n698:       }\n699:     }\n700: \n701:     const commands = {};\n702:     for (const command of [...perCommand.keys()].sort()) {\n703:       commands[command] = perCommand.get(command);\n704:     }\n705: \n706:     // Row ids are keyed in sorted order so a diff between two captures reads as\n707:     // the rows that changed rather than as reordered output.\n708:     const typedRows = {};\n709:     for (const id of Object.keys(typedRowResults).sort()) {\n710:       typedRows[id] = typedRowResults[id];\n711:     }\n712: \n713:     const reachableCommands = new Set();\n714:     for (const value of idToCommand.values()) reachableCommands.add(value.command);\n715:     const unreachable = commandNames.filter((command) => !reachableCommands.has(command)).sort();\n716: \n717:     const plainByFamily = {};\n718:     for (const namespace of [...plainAttachedByFamily.keys()].sort()) {\n719:       const family = plainAttachedByFamily.get(namespace);\n720:       plainByFamily[namespace] = {\n721:         tune: attachedTallyJson(family.tune),\n722:         holdout: attachedTallyJson(family.holdout),\n723:       };\n724:     }\n725: \n726:     return {\n727:       schemaVersion: 1,\n728:       capturedAt,\n729:    