 'traceability_check', protocol: 'playbook_capability', status: 'notApplicable', iteration: 3, detail: 'No playbook scenario names the new counts.' }),\n  JSON.stringify({ type: 'ruled_out', direction: 'The README offeredAs claim as a separate doc finding', reason: 'Same root cause as iter1-P1-offeredas-not-persisted.', iteration: 3 }),\n  JSON.stringify({ type: 'ruled_out', direction: 'A Wilson interval using a different denominator', reason: 'Both ranges use the same six path counts as the rates.', iteration: 3 }),\n].join('\\n') + '\\n';\nfs.writeFileSync(`${DIR}/deltas/iter-003.jsonl`, delta, 'utf8');\nNODE\nnode .skilled/skills/system-deep-loop/runtime/scripts/append-mode-event.cjs --mode review --run-directory specs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/review/lineages/accuracy-runner-4 --event-json specs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/review/lineages/accuracy-runner-4/iter-003.record.json\nnode .skilled/skills/system-deep-loop/runtime/scripts/reduce-state.cjs specs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build --artifact-dir specs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/review/lineages/accuracy-runner-4 --create-missing-anchors"},"output":"{\"ok\":true,\"receipt\":{\"ledger_id\":\"deep-review-ledger\",\"sequence\":4,\"event_id\":\"event-415b0127-8d3c-4dc0-b0c9-5d7909050a9c\",\"event_type\":\"deep-review.ledger.iteration-recorded\",\"event_version\":1,\"stream_id\":\"deep-review-ledger\",\"stream_sequence\":4,\"committed_at\":\"2026-11-14T15:42:13.782Z\",\"canonicalEventHash\":\"0c99f6c82953a9b269958aba31f3591f75d3d4412d4742175e9207c0e9125210\",\"recordHash\":\"ddaf0aade020d48e84ebddc107cd588e53ee59b3851291e184081554b3b19a0f\",\"authorizationRef\":{\"audit_ledger_id\":\"deep-review-audit-ledger\",\"audit_sequence\":5,\"audit_record_hash\":\"7894800f413eeb5d10c4ac9b899d4f5e4e8f0cea04fa74bb3bacbc478cad71e7\",\"decision_id\":\"decision-3e98888b