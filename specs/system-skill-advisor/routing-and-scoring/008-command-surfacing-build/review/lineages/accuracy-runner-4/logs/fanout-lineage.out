adata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"{\"ok\":true,\"receipt\":{\"ledger_id\":\"deep-review-ledger\",\"sequence\":1,\"event_id\":\"event-7f370bce-45c9-438c-9958-de0f086cb057\",\"event_type\":\"deep-review.ledger.run-initialized\",\"event_version\":1,\"stream_id\":\"deep-review-ledger\",\"stream_sequence\":1,\"committed_at\":\"2026-11-14T15:34:33.534Z\",\"canonicalEventHash\":\"9ded53e68bd844f3a25813f3b99ce42eb0d6f5660c69c1f18e63279fa5575956\",\"recordHash\":\"15c22f4387a1195c18c11bfa2ad2406b686b14b15d64540d154d92e25cbf3547\",\"authorizationRef\":{\"audit_ledger_id\":\"deep-review-audit-ledger\",\"audit_sequence\":2,\"audit_record_hash\":\"5b6ee079bb800120f35996704b5e5cf5def573092cf24008fb60dfb71e4c84bc\",\"decision_id\":\"decision-5a690036-673a-4b57-9943-ddb5ce49cc3d\",\"decision_digest\":\"09954a5af1a310e8afd9f1ff69eba28bcccd8514f2e6282d8a550b7ec9622f34\",\"request_digest\":\"d9674a716e05d90dfbc1f5b8e4a6e65351f51b54cc015d36c02a1ad97ea48e1c\",\"policy_digest\":\"883e5d03486b26c23ecdb48a893d8b0db0d8e2e7125e0847705bfd4a2b1a4500\",\"authority_epoch\":1,\"fence_token\":1},\"ledgerId\":\"deep-review-ledger\",\"eventId\":\"event-7f370bce-45c9-438c-9958-de0f086cb057\",\"eventType\":\"deep-review.ledger.run-initialized\",\"eventVersion\":1,\"streamId\":\"deep-review-ledger\",\"streamSequence\":1,\"committedAt\":\"2026-11-14T15:34:33.534Z\"},\"projectionRefreshed\":true,\"projectionError\":null}\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"node -e '\\nconst fs = require(\\\"fs\\\"), crypto = require(\\\"crypto\\\");\\nconst [configPath, workflowPath] = process.argv.slice(1);\\nconst sha = (bytes) => crypto.createHash(\\\"sha256\\\").update(bytes).digest(\\\"hex\\\");\\nconst raw = fs.readFileSync(configPath);\\nconst config = JSON.parse(raw);\\nconst targetTypes = { files: \\\"file\\\", file: \\\"file\\\", directory: \\\"directory\\\", \\\"spec-folder\\\": \\\"directory\\\", track: \\\"directory\\\", repository: \\\"repository\\\" };\\nconst lineageModes = { new: \\\"fresh\\\", fresh: \\\"fresh\\\", restart: \\\"restart\\\", resume: \\\"resume\\\" };\\nconst topic = typeof config.topic === \\\"string\\\" && config.topic.trim() !== \\\"\\\" && config.topic.length <= 4096 ? config.topic : null;\\nprocess.stdout.write(JSON.stringify({\\n  stem: \\\"deep_review.run_initialized\\\",\\n  scope: { runId: config.sessionId, sessionId: config.sessionId, generation: Number(config.generation) || 1 },\\n  data: {\\n    target: { targetId: \\\"review-target\\\", targetType: targetTypes[config.reviewTargetType] || \\\"artifact\\\", artifactRef: \\\"deep-review-config.json#reviewTarget\\\", sourceDigest: sha(String(config.reviewTarget)), contentDigest: sha(raw) },\\n    lineageMode: lineageModes[config.lineageMode] || \\\"fresh\\\",\\n    maxIterations: Number(config.maxIterations),\\n    convergencePolicyVersion: \\\"convergence-policy@\\\" + ((config.antiConvergence && config.antiConvergence.convergenceMode) || \\\"default\\\"),\\n    reviewModeContractDigest: sha(fs.readFileSync(workflowPath)),\\n    initialReleaseReadinessState: \\\"not-assessed\\\",\\n    ...(topic === null ? {} : { topic }),\\n  },\\n}));\\n' specs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/review/lineages/accuracy-runner-4/deep-review-config.json .skilled/commands/deep/assets/deep-review-auto.yaml > specs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/review/lineages/accuracy-runner-4/.run-open-event.json\\nnode .skilled/skills/system-deep-loop/runtime/scripts/append-mode-event.cjs --mode review --run-directory specs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/review/lineages/accuracy-runner-4 --event-json specs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/review/lineages/accuracy-runner-4/.run-open-event.json\"}"},"time":{"start":1794670469024,"end":179467047386