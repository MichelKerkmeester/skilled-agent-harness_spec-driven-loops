{"type":"tool_use","timestamp":1794669724625,"sessionID":"ses_e255ff46effeHQ7tMXhYT9pQMI","part":{"partID":"prt_1daa6c1e60025SKE2rk1Lt75U0","sessionID":"ses_e255ff46effeHQ7tMXhYT9pQMI","messageID":"msg_1daa695ac001Oq7dnpRQIgBciQ","type":"tool","id":"call_eba113156fb349c790447ef1","tool":"read","state":{"status":"completed","input":{"limit":280,"offset":150,"path":".skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/command-offer.mjs"},"output":"Read file .skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/command-offer.mjs, lines 150-429\n150:   if (typeof content === 'string') return BRIEF_PATTERN.test(content);\n151:   if (!Array.isArray(content)) return false;\n152:   return content.some((part) => {\n153:     if (typeof part === 'string') return BRIEF_PATTERN.test(part);\n154:     return typeof part?.text === 'string' && BRIEF_PATTERN.test(part.text);\n155:   });\n156: }\n157: \n158: // A brief arrives as session input, so a tool that printed a document quoting a\n159: // head delivered nothing. Neutral records keep their text in content blocks, and\n160: // the block shape differs by runtime, so the serialized record is the one place\n161: // the brief is found whichever block carries it.\n162: function recordsHaveBrief(records) {\n163:   return (Array.isArray(records) ? records : []).some((record) =>\n164:     record?.role !== 'toolResult'\n165:     && BRIEF_PATTERN.test(JSON.stringify(record ?? null)));\n166: }\n167: \n168: // Injected context sits beside the records rather than inside them, so a reader\n169: // that reports it gives the brief a second place to be found.\n170: function injectedHasBrief(injected) {\n171:   return (Array.isArray(injected) ? injected : []).some(\n172:     (entry) => typeof entry?.text === 'string' && BRIEF_PATTERN.test(entry.text),\n173:   );\n174: }\n175: \n176: /**\n177:  * Ask the project's Codex approval check whether its advisor hook can run.\n178:  *\n179:  * Codex skips an unapproved project hook without a warning, so a wired hook can\n180:  * still deliver nothing. The check reports the approval recorded in the config\n181:  * file it reads, and this wrapper turns that verdict into the answer the\n182:  * delivery decision needs.\n183:  *\n184:  * @param {object} [options]\n185:  * @param {string} [options.projectDir] - Project root whose hooks file is read.\n186:  * @param {string} [options.configPath] - Codex config file, defaulting to the\n187:  *   environment's Codex home.\n188:  * @returns {'approved' | 'unapproved' | 'absent' | 'no-hooks' | 'unknown'}\n189:  */\n190: export function codexHookApproval({ projectDir, configPath } = {}) {\n191:   if (typeof projectDir !== 'string' || projectDir === '') return 'unknown';\n192: \n193:   const args = [CODEX_CHECK, '--root', projectDir, '--json'];\n194:   if (configPath) args.push('--config', configPath);\n195:   const result = spawnSync('node', args, { encoding: 'utf8', timeout: 10_000 });\n196:   if (result.error || typeof result.stdout !== 'string') return 'unknown';\n197: \n198:   let verdict;\n199:   try {\n200:     verdict = JSON.parse(result.stdout);\n201:   } catch {\n202:     return 'unknown';\n203:   }\n204: \n205:   switch (verdict?.code) {\n206:     case 'codex-hooks-approved':\n207:       return 'approved';\n208:     case 'codex-hooks-unapproved':\n209:       return 'unapproved';\n210:     case 'codex-advisor-hook-absent':\n211:       return 'absent';\n212:     case 'no-codex-hooks':\n213:       return 'no-hooks';\n214:     default:\n215:       return 'unknown';\n216:   }\n217: }\n218: \n219: /**\n220:  * Decide whether the advisor brief reached the session that ran the turn.\n221:  *\n222:  * A Claude transcript records the hook context as its own attachment line, so a\n223:  * missing attachment is a real miss. Pi, Devin and DSH keep the brief in their\n224:  * session store, either as a record or as injected context beside it, and Codex\n225:  * answers from its approval plus whatever its store holds. OpenCode stays\n226:  * `unknown`, because its plugin adds the brief in memory and the store keeps no\n227:  * copy.\n228:  *\n229:  * @param {object} options\n230:  * @param {string} options.runtime - The measured runtime.\n231:  * @param {object|null} [options.locator] - The locator the run line recorded.\n232:  * @param {Function} [options.loadSession] - Reader for a runtime whose brief\n233:  *   lives in session records rather than a transcript file.\n234:  * @param {string} [options.codexConfig] - Codex config file the approval is\n235:  *   read from, defaulting to the environment's Codex home.\n236:  * @returns {Promise<boolean | 'unknown'>}\n237:  */\n238: export async function briefDelivered({ runtime, locator, loadSession, codexConfig } = {}) {\n239:   if (runtime === 'claude') {\n240:     const transcriptPath = locator?.transcriptPath;\n241:     if (typeof transcriptPath !== 'string' || transcriptPath.length === 0) {\n242:       return 'unknown';\n243:     }\n244: \n245:     let raw;\n246:     try {\n247:       raw = readFileSync(transcriptPath, 'utf8');\n248:     } catch {\n249:       return 'unknown';\n250:     }\n251: \n252:     for (const line of raw.split('\\n')) {\n253:       if (!line.trim()) continue;\n254:       let entry;\n255:       try {\n256:         entry = JSON.parse(line);\n257:       } catch {\n258:         continue;\n259:       }\n260:       if (entry?.type !== 'attachment') continue;\n261:       const attachment = entry.attachment;\n262:       if (attachment?.type !== 'hook_additional_context') continue;\n263:       if (attachment.hookEvent !== CLAUDE_ATTACHMENT_EVENT) continue;\n264:       if (contentHasBrief(attachment.content)) return true;\n265:     }\n266:     return false;\n267:   }\n268: \n269:   if (runtime === 'pi' || runtime === 'devin' || runtime === 'dsh') {\n270:     if (typeof loadSession !== 'function') return 'unknown';\n271:     let loaded;\n272:     try {\n273:       loaded = await loadSession({ ...locator, runtime });\n274:     } catch {\n275:       return 'unknown';\n276:     }\n277:     if (!loaded?.ok) return 'unknown';\n278:     return recordsHaveBrief(loaded.records) || injectedHasBrief(loaded.injected);\n279:   }\n280: \n281:   if (runtime === 'codex') {\n282:     // An unapproved project hook never runs, so the brief cannot have arrived.\n283:     // An approved one may store its context where no reader looks yet.\n284:     if (codexHookApproval({ projectDir: locator?.projectDir, configPath: codexConfig }) === 'unapproved') {\n285:       return false;\n286:     }\n287: \n288:     if (typeof loadSession !== 'function') return 'unknown';\n289:     let loaded;\n290:     try {\n291:       loaded = await loadSession({ ...locator, runtime });\n292:     } catch {\n293:       return 'unknown';\n294:     }\n295:     if (!loaded?.ok) return 'unknown';\n296:     return recordsHaveBrief(loaded.records) || injectedHasBrief(loaded.injected)\n297:       ? true\n298:       : 'unknown';\n299:   }\n300: \n301:   return 'unknown';\n302: }\n303: \n304: /**\n305:  * Pick the session a DSH prompt opened among the sessions a turn added.\n306:  *\n307:  * A DSH turn can add helper sessions beside its own, and only the session the\n308:  * prompt opened holds that prompt as its first user message, so the prompt\n309:  * decides between them and a tie names none.\n310:  *\n311:  * @param {object} options\n312:  * @param {string[]} options.before - Session ids the store held before the turn.\n313:  * @param {string[]} options.after - Session ids the store held after the turn.\n314:  * @param {string} options.prompt - The prompt the turn ran.\n315:  * @param {(id: string) => Promise<string | null>} options.firstUserText - Reads a\n316:  *   session's first user message.\n317:  * @returns {Promise<string | null>} The session the prompt opened, or null.\n318:  */\n319: export async function promptSessionId({ before, after, prompt, firstUserText }) {\n320:   if (!Array.isArray(before) || !Array.isArray(after)) return null;\n321:   if (typeof prompt !== 'string' || prompt.length === 0) return null;\n322: \n323:   const known = new Set(before);\n324:   const added = [...new Set(after)].filter((id) => !known.has(id));\n325:   const wanted = prompt.trim();\n326:   const matched = [];\n327: \n328:   for (const id of added) {\n329:     let text;\n330:     try {\n331:       text = await firstUserText(id);\n332:     } catch {\n333:       continue;\n334:     }\n335:     if (typeof text !== 'string') continue;\n336:     if (text.trim() === wanted) matched.push(id);\n337:   }\n338: \n339:   return matched.length === 1 ? matched[0] : null;\n340: }\n341: \n342: // ───────────────────────────────────────────────────────────────\n343: // Run-log backfill\n344: // ───────────────────────────────────────────────────────────────\n345: \n346: // A run log is input, and the folder it names may hold any code, so only this\n347: // project root or an arena holding the builder's marker may be replayed.\n348: /**\n349:  * Decide whether a run line's checkout may run its own code.\n350:  *\n351:  * @param {string} checkoutDir - Root of the checkout a run line names.\n352:  * @returns {boolean} True when the folder may be warmed and replayed.\n353:  */\n354: export function trustedCheckout(checkoutDir) {\n355:   try {\n356:     return (\n357:       realpathSync(checkoutDir) === realpathSync(REPO_ROOT)\n358:       || existsSync(join(checkoutDir, '.git', 'skilled-behaviour-arena'))\n359:     );\n360:   } catch {\n361:     return false;\n362:   }\n363: }\n364: \n365: // A fresh daemon can outlast the first prompt's budget, so the backfill asks\n366: // each checkout to start one before it replays. The status call writes nothing,\n367: // and its failure is ignored because a replay that finds no daemon records its\n368: // own error instead of losing the line.\n369: function warmCheckout(checkoutDir) {\n370:   const cliPath = join(checkoutDir, ADVISOR_CLI_RELATIVE);\n371:   if (!existsSync(cliPath)) return;\n372:   spawnSync(\n373:     'node',\n374:     [cliPath, 'advisor_status', '--workspace-root', checkoutDir, '--format', 'json', '--no-warm-only'],\n375:     {\n376:       cwd: checkoutDir,\n377:       encoding: 'utf8',\n378:       timeout: DEFAULT_TIMEOUT_MS,\n379:       maxBuffer: MAX_OUTPUT_BYTES,\n380:     },\n381:   );\n382: }\n383: \n384: function refused(code, detail) {\n385:   return { ok: false, code, detail };\n386: }\n387: \n388: /**\n389:  * Add the offer, its policy and the brief to every line of a run log.\n390:  *\n391:  * The prompts are resolved before the first line is written, so a row the\n392:  * corpus refuses leaves no output file behind. A line whose locator names no\n393:  * checkout keeps null offer fields and its own error code, and the rest of the\n394:  * log is still written.\n395:  *\n396:  * @param {object} options\n397:  * @param {string} options.inPath - Run log to read.\n398:  * @param {string} options.outPath - New run log to write.\n399:  * @param {(rowId: string, line: object) => string} options.promptFor - Prompt\n400:  *   lookup. It also receives the line, so a prompt can be rebuilt from the\n401:  *   fixture the line records, and it refuses an unknown or holdout row by\n402:  *   throwing an error with a `code`.\n403:  * @param {boolean} [options.briefOnly] - Write only the delivery answer and\n404:  *   leave every offer field exactly as the input line holds it.\n405:  * @param {Function} [options.replay] - Offer replay, injectable for tests.\n406:  * @param {Function} [options.brief] - Brief delivery reader, injectable for tests.\n407:  * @param {(checkoutDir: string) => boolean} [options.trusted] - Checkout trust\n408:  *   check, injectable for tests.\n409:  * @param {(checkoutDir: string) => unknown} [options.warm] - Daemon warm-up,\n410:  *   injectable for tests.\n411:  * @returns {Promise<{ ok: true, lines: number, outPath: string }\n412:  *   | { ok: false, code: string, detail: string }>}\n413:  */\n414: export async function backfillRunLog({\n415:   inPath,\n416:   outPath,\n417:   promptFor,\n418:   briefOnly = false,\n419:   replay = replayOffer,\n420:   brief = briefDelivered,\n421:   trusted = trustedCheckout,\n422:   warm = warmCheckout,\n423: }) {\n424:   if (resolve(outPath) === resolve(inPath)) {\n425:     return refused('same_path', `${outPath}: the backfill writes a new log`);\n426:   }\n427: \n428:   const rows = [];\n429:   for (const raw of readFileSync(inPath, 'utf8').split('\\n')) {\n[Output truncated. Continue reading with offset: 430]","title":"read","metadata":{"metadata":{"truncated":true},"content":[{"type":"text","text":"Read file .skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/command-offer.mjs, lines 150-429\n150:   if (typeof content === 'string') return BRIEF_PATTERN.test(content);\n151:   if (!Array.isArray(content)) return false;\n152:   return content.some((part) => {\n153:     if (typeof part === 'string') return BRIEF_PATTERN.test(part);\n154:     return typeof part?.text === 'string' && BRIEF_PATTERN.test(part.text);\n155:   });\n156: }\n157: \n158: // A brief arrives as session input, so a tool that printed a document quoting a\n159: // head delivered nothing. Neutral records keep their text in content blocks, and\n160: // the block shape differs by runtime, so the serialized record is the one place\n161: // the brief is found whichever block carries it.\n162: function recordsHaveBrief(records) {\n163:   return (Array.isArray(records) ? records : []).some((record) =>\n164:     record?.role !== 'toolResult'\n165:     && BRIEF_PATTERN.test(JSON.stringify(record ?? null)));\n166: }\n167: \n168: // Injected context sits beside the records rather than inside them, so a reader\n169: // that reports it gives the brief a second place to be found.\n170: function injectedHasBrief(injected) {\n171:   return (Array.isArray(injected) ? injected : []).some(\n172:     (entry) => typeof entry?.text === 'string' && BRIEF_PATTERN.test(entry.text),\n173:   );\n174: }\n175: \n176: /**\n177:  * Ask the project's Codex approval check whether its advisor hook can run.\n178:  *\n179:  * Codex skips an unapproved project hook without a warning, so a wired hook can\n180:  * still deliver nothing. The check reports the approval recorded in the config\n181:  * file it reads, and this wrapper turns that verdict into the answer the\n182:  * delivery decision needs.\n183:  *\n184:  * @param {object} [options]\n185:  * @param {string} [options.projectDir] - Project root whose hooks file is read.\n186:  * @param {string} [options.configPath] - Codex config file, defaulting to the\n187:  *   environment's Codex home.\n188:  * @returns {'approved' | 'unapproved' | 'absent' | 'no-hooks' | 'unknown'}\n189:  */\n190: export function codexHookApproval({ projectDir, configPath } = {}) {\n191:   if (typeof projectDir !== 'string' || projectDir === '') return 'unknown';\n192: \n193:   const args = [CODEX_CHECK, '--root', projectDir, '--json'];\n194:   if (configPath) args.push('--config', configPath);\n195:   const result = spawnSync('node', args, { encoding: 'utf8', timeout: 10_000 });\n196:   if (result.error || typeof result.stdout !== 'string') return 'unknown';\n197: \n198:   let verdict;\n199:   try {\n200:     verdict = JSON.parse(result.stdout);\n201:   } catch {\n202:     return 'unknown';\n203:   }\n204: \n205:   switch (verdict?.code) {\n206:     case 'codex-hooks-approved':\n207:       return 'approved';\n208:     case 'codex-hooks-unapproved':\n209:       return 'unapproved';\n210:     case 'codex-advisor-hook-absent':\n211:       return 'absent';\n212:     case 'no-codex-hooks':\n213:       return 'no-hooks';\n214:     default:\n215:       return 'unknown';\n216:   }\n217: }\n218: \n219: /**\n220:  * Decide whether the advisor brief reached the session that ran the turn.\n221:  *\n222:  * A Claude transcript records the hook context as its own attachment line, so a\n223:  * missing attachment is a real miss. Pi, Devin and DSH keep the brief in their\n224:  * session store, either as a record or as injected context beside it, and Codex\n225:  * answers from its approval plus whatever its store holds. OpenCode stays\n226:  * `unknown`, because its plugin adds the brief in memory and the store keeps no\n227:  * copy.\n228:  *\n229:  * @param {object} options\n230:  * @param {string} options.runtime - The measured runtime.\n231:  * @param {object|null} [options.locator] - The locator the run line recorded.\n232:  * @param {Function} [options.loadSession] - Reader for a runtime whose brief\n233:  *   lives in session records rather than a transcript file.\n234:  * @param {string} [options.codexConfig] - Codex config file the approval is\n235:  *   read from, defaulting to the environment's Codex home.\n236:  * @returns {Promise<boolean | 'unknown'>}\n237:  */\n238: export async function briefDelivered({ runtime, locator, loadSession, codexConfig } = {}) {\n239:   if (runtime === 'claude') {\n240:     const transcriptPath = locator?.transcriptPath;\n241:     if (typeof transcriptPath !== 'string' || transcriptPath.length === 0) {\n242:       return 'unknown';\n243:     }\n244: \n245:     let raw;\n246:     try {\n247:       raw = readFileSync(transcriptPath, 'utf8');\n248:     } catch {\n249:       return 'unknown';\n250:     }\n251: \n252:     for (const line of raw.split('\\n')) {\n253:       if (!line.trim()) continue;\n254:       let entry;\n255:       try {\n256:         entry = JSON.parse(line);\n257:       } catch {\n258:         continue;\n259:       }\n260:       if (entry?.type !== 'attachment') continue;\n261:       const attachment = entry.attachment;\n262:       if (attachment?.type !== 'hook_additional_context') continue;\n263:       if (attachment.hookEvent !== CLAUDE_ATTACHMENT_EVENT) continue;\n264:       if (contentHasBrief(attachment.content)) return true;\n265:     }\n266:     return false;\n267:   }\n268: \n269:   if (runtime === 'pi' || runtime === 'devin' || runtime === 'dsh') {\n270:     if (typeof loadSession !== 'function') return 'unknown';\n271:     let loaded;\n272:     try {\n273:       loaded = await loadSession({ ...locator, runtime });\n274:     } catch {\n275:       return 'unknown';\n276:     }\n277:     if (!loaded?.ok) return 'unknown';\n278:     return recordsHaveBrief(loaded.records) || injectedHasBrief(loaded.injected);\n279:   }\n280: \n281:   if (runtime === 'codex') {\n282:     // An unapproved project hook never runs, so the brief cannot have arrived.\n283:     // An approved one may store its context where no reader looks yet.\n284:     if (codexHookApproval({ projectDir: locator?.projectDir, configPath: codexConfig }) === 'unapproved') {\n285:       return false;\n286:     }\n287: \n288:     if (typeof loadSession !== 'function') return 'unknown';\n289:     let loaded;\n290:     try {\n291:       loaded = await loadSession({ ...locator, runtime });\n292:     } catch {\n293:       return 'unknown';\n294:     }\n295:     if (!loaded?.ok) return 'unknown';\n296:     return recordsHaveBrief(loaded.records) || injectedHasBrief(loaded.injected)\n297:       ? true\n298:       : 'unknown';\n299:   }\n300: \n301:   return 'unknown';\n302: }\n303: \n304: /**\n305:  * Pick the session a DSH prompt opened among the sessions a turn added.\n306:  *\n307:  * A DSH turn can add helper sessions beside its own, and only the session the\n308:  * prompt opened holds that prompt as its first user message, so the prompt\n309:  * decides between them and a tie names none.\n310:  *\n311:  * @param {object} options\n312:  * @param {string[]} options.before - Session ids the store held before the turn.\n313:  * @param {string[]} options.after - Session ids the store held after the turn.\n314:  * @param {string} options.prompt - The prompt the turn ran.\n315:  * @param {(id: string) => Promise<string | null>} options.firstUserText - Reads a\n316:  *   session's first user message.\n