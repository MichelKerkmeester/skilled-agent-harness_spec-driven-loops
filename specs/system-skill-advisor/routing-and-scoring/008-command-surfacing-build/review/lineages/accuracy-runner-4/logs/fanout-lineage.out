) => ({\n+        ok: true,\n+        records: [{ role: 'toolResult', content: [{ type: 'text', text: 'Advisor: live; use sk-doc 0.95/0.12 pass.' }] }],\n+        injected: [],\n+      }),\n+    })).resolves.toBe(false);\n+  });\n+\n+  it('counts a head in a user record', async () => {\n+    await expect(briefDelivered({\n+      runtime: 'pi',\n+      locator: {},\n+      loadSession: async () => ({\n+        ok: true,\n+        records: [{ role: 'user', content: [{ type: 'text', text: 'Advisor: live; use sk-doc 0.95/0.12 pass.' }] }],\n+        injected: [],\n+      }),\n+    })).resolves.toBe(true);\n+  });\n });\n \n describe('backfillRunLog', () => {\ndiff --git a/.skilled/skills/system-skill-advisor/runtime/tests/command-routing-slice.vitest.ts b/.skilled/skills/system-skill-advisor/runtime/tests/command-routing-slice.vitest.ts\nindex 61fb41c5af..8cdc31b6d2 100644\n--- a/.skilled/skills/system-skill-advisor/runtime/tests/command-routing-slice.vitest.ts\n+++ b/.skilled/skills/system-skill-advisor/runtime/tests/command-routing-slice.vitest.ts\n@@ -13,7 +13,10 @@ import { dirname, join, resolve } from 'node:path';\n import { fileURLToPath } from 'node:url';\n \n import { beforeAll, describe, expect, it } from 'vitest';\n-import { scoreCommandCorpus as captureCommandCorpus } from '../scripts/routing-accuracy/capture-command-routing-baseline.mjs';\n+import {\n+  assertFitRowsUnique as captureAssertFitRowsUnique,\n+  scoreCommandCorpus as captureCommandCorpus,\n+} from '../scripts/routing-accuracy/capture-command-routing-baseline.mjs';\n \n const HERE = dirname(fileURLToPath(import.meta.url));\n const ROUTING = resolve(HERE, '../scripts/routing-accuracy');\n@@ -59,6 +62,21 @@ interface CommandTally {\n   readonly plain: { readonly tune: SplitTally; readonly holdout: SplitTally };\n }\n \n+interface StageTally {\n+  readonly total: number;\n+  readonly own: number;\n+  readonly ownerLed: number;\n+  readonly routed: number;\n+  readonly withCommand: number;\n+  readonly attached: number;\n+  readonly neither: number;\n+}\n+\n+interface FitTally {\n+  readonly carried: number;\n+  readonly total: number;\n+}\n+\n interface CommandRow {\n   readonly expected_command: string | null;\n   readonly top: string | null;\n@@ -80,11 +98,21 @@ interface CommandRoutingBaseline {\n   readonly attachedMetrics: Readonly<Record<string, unknown>>;\n }\n \n+interface PromptRow {\n+  readonly id: string;\n+  readonly row_type: string;\n+  readonly prompt: string;\n+}\n+\n // The capture script is plain JavaScript with no declaration file of its own, so\n // the shape it returns is declared here and the import is cast to that shape\n // rather than left implicitly `any` at every call site.\n const scoreCommandCorpus = captureCommandCorpus as unknown as () => Promise<CommandRoutingBaseline>;\n \n+// The duplicate guard reads whole corpus rows, so its input is declared apart\n+// from the captured result rather than typed as a row of that result.\n+const assertFitRowsUnique = captureAssertFitRowsUnique as unknown as (rows: readonly PromptRow[]) => void;\n+\n function readJsonl<T>(path: string): T[] {\n   return readFileSync(path, 'utf8').trim().split('\\n').filter(Boolean).map((line) => JSON.parse(line) as T);\n }\n@@ -168,6 +196,75 @@ describe('command routing slice', () => {\n     expect(published, `the baseline publishes a per-row outcome for ${published.length} holdout ids`).toEqual([]);\n   });\n \n+  it('refuses a fit row that repeats another row', () => {\n+    // A fit row shares the corpus with every other row, so a prompt that already\n+    // exists would count one request twice. Case and whitespace do not make two\n+    // prompts different, so a reflowed copy still names the row it repeats.\n+    expect(() =>\n+      assertFitRowsUnique([\n+        { id: 'fit-skill-only-91', row_type: 'skill-only', prompt: 'Rename  the Helper function' },\n+        { id: 'made-up-92', row_type: 'plain', prompt: 'rename the helper function' },\n+      ]),\n+    ).toThrow('fit row fit-skill-only-91 repeats row made-up-92');\n+    expect(() =>\n+      assertFitRowsUnique([\n+        { id: 'fit-skill-only-91', row_type: 'skill-only', prompt: 'Rename  the Helper function' },\n+        { id: 'made-up-92', row_type: 'plain', prompt: 'rename the other function' },\n+      ]),\n+    ).not.toThrow();\n+  });\n+\n+  it('splits each plain row into one reach stage', () => {\n+    // A plain row leaves the path to its command at one stage, so the stage\n+    // counts have to partition the split and narrow toward the rows a command\n+    // actually carried. Reading the same split's plain tally proves both views\n+    // count the same rows rather than two different row sets.\n+    const attached = live.attachedMetrics as {\n+      readonly plain: Readonly<Record<'tune' | 'holdout', { readonly own: number; readonly attached: number }>>;\n+      readonly plain_stages: Readonly<Record<'tune' | 'holdout', StageTally>>;\n+    };\n+    for (const split of ['tune', 'holdout'] as const) {\n+      const stage = attached.plain_stages[split];\n+      expect(stage.own + stage.ownerLed + stage.neither).toBe(stage.total);\n+      expect(stage.attached).toBeLessThanOrEqual(stage.withCommand);\n+      expect(stage.withCommand).toBeLessThanOrEqual(stage.routed);\n+      expect(stage.routed).toBeLessThanOrEqual(stage.ownerLed);\n+      expect(stage.own).toBe(attached.plain[split].own);\n+      expect(stage.attached).toBe(attached.plain[split].attached);\n+    }\n+  });\n+\n+  it('counts the sealed fit rows and publishes none', () => {\n+    // A fit row asks whether the head carries a command where none fits, so its\n+    // counts are kept apart from every recall tally and its outcome is never\n+    // published row by row: one corpus then answers both questions.\n+    const attached = live.attachedMetrics as {\n+      readonly fit: {\n+        readonly skillOnly: FitTally;\n+        readonly decline: FitTally & { readonly byKind: Readonly<Record<string, FitTally>> };\n+      };\n+      readonly attachedRows: Readonly<Record<string, string>>;\n+      readonly typedRows: Readonly<Record<string, unknown>>;\n+    };\n+    const { skillOnly, decline } = attached.fit;\n+    expect(skillOnly.total).toBe(24);\n+    expect(decline.total).toBe(24);\n+    expect(Object.keys(decline.byKind).sort()).toEqual(['app-problem', 'question', 'refusal', 'small-edit']);\n+    for (const [kind, tally] of Object.entries(decline.byKind)) {\n+      expect(tally.total, `decline kind ${kind} counts ${tally.total} rows`).toBe(6);\n+    }\n+    for (const tally of [skillOnly, decline, ...Object.values(decline.byKind)]) {\n+      expect(tally.carried).toBeLessThanOrEqual(tally.total);\n+    }\n+    // A published fit row would expose the outcome the sealed split withholds.\n+    const published = [\n+      ...Object.keys(live.rows),\n+      ...Object.keys(attached.attachedRows),\n+      ...Object.keys(attached.typedRows),\n+    ].filter((id) => id.startsWith('fit-'));\n+    expect(published, `the baseline publishes a per-row outcome for ${published.length} fit ids`).toEqual([]);\n+  });\n+\n   it('matches the captured totals', () => {\n     expect(live.metrics).toEqual(baseline.metrics);\n     expect(live.unreachable).toEqual(baseline.unreachable);\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"diff --git a/.skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/capture-command-routing-baseline.mjs b/.skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/capture-command-routing-baseline.mjs\nindex f4af787341..f17d88f85e 100644\n--- a/.skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/capture-command-routing-baseline.mjs\n+++ b/.skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/capture-command-routing-baseline.mjs\n@@ -225,6 +225,26 @@ function readCorpus(path) {\n   return rows;\n }\n \n+// A fit row shares the corpus with every other row, so a prompt that already\n+// exists would count one request twice. Case and whitespace do not make two\n+// prompts different. The message names the two ids and never the text, because\n+// an error must not republish a prompt.\n+export function assertFitRowsUnique(rows) {\n+  const folded = rows.map((row) => ({\n+    id: row.id,\n+    isFit: row.row_type === 'skill-only' || row.row_type === 'decline',\n+    text: row.prompt.toLowerCase().trim().replace(/\\s+/g, ' '),\n+  }));\n+  for (let index = 0; index < folded.length; index += 1) {\n+    if (!folded[index].isFit) continue;\n+    for (let other = 0; other < folded.length; other += 1) {\n+      if (other !== index && folded[other].text === folded[index].text) {\n+        throw new Error(`fit row ${folded[index].id} repeats row ${folded[other].id}`);\n+      }\n+    }\n+  }\n+}\n+\n // Commands live exactly two levels deep, `<namespace>/<name>.md`, and become\n // `/<namespace>:<name>`. Anything directly in the commands root is a document\n // rather than a command, and deeper nesting is a command's own assets.\n@@ -293,6 +313,13 @@ function isBridgeOwnerPair(idToCommand, ids, expected) {\n   return Boolean(trailing && trailing.command === expected && trailing.skillId === first);\n }\n \n+// A fit row asks whether the head carries a command where none fits its request,\n+// so the head carries one when the leading recommendation reaches a command, or\n+// when a typed command or hub route delivered one.\n+function headCarriesCommand(landed, delivered) {\n+  return landed[0] != null || delivered !== undefined;\n+}\n+\n // The scorer reports ranked recommendations when the projection produced a\n // list, and only a top pick otherwise; both shapes have to be scorable.\n function recommendationIds(result) {\n@@ -325,6 +352,22 @@ function addAttachedRow(tally, ownHit, attachedHit) {\n   if (attachedHit) tally.attached += 1;\n }\n \n+// A plain row leaves the path to its command at one stage, and the tally says\n+// which stage that was.\n+function emptyStageTally() {\n+  return { total: 0, own: 0, ownerLed: 0, routed: 0, withCommand: 0, attached: 0, neither: 0 };\n+}\n+\n+function addStageRow(tally, facts) {\n+  tally.total += 1;\n+  if (facts.own) tally.own += 1;\n+  if (facts.ownerLed) tally.ownerLed += 1;\n+  if (facts.routed) tally.routed += 1;\n+  if (facts.withCommand) tally.withCommand += 1;\n+  if (facts.attached) tally.attached += 1;\n+  if (facts.neither) tally.neither += 1;\n+}\n+\n function attachedTallyJson(tally) {\n   return { own: tally.own, attached: tally.attached, combined: tally.own + tally.attached, total: tally.total };\n }\n@@ -451,7 +494,15 @@ export async function scoreCommandCorpus(options = {}) {\n     const commandNames = readCommandFileNames(workspaceRoot);\n     const commandSet = new Set(commandNames);\n     const { bridgeCounts, idToCommand } = readBridgeMap(BRIDGES_JSON);\n+    // A hub route attaches commands whose TypeScript bridge is disabled, so the\n+    // scorer-id map cannot name their owner and every bridge entry is the only\n+    // complete command-to-owner source.\n+    const commandOwner = new Map();\n+    for (const entry of JSON.parse(readFileSync(BRIDGES_JSON, 'utf8')).entries ?? []) {\n+      commandOwner.set(entry.command, entry.skillId);\n+    }\n     const corpus = readCorpus(CORPUS_JSONL);\n+    assertFitRowsUnique(corpus);\n \n     // A label naming a command that does not exist would silently score as a\n     // permanent miss, so it fails the capture instead of deflating a metric.\n@@ -492,6 +543,14 @@ export async function scoreCommandCorpus(options = {}) {\n     const typedAttached = emptyAttachedTally();\n     const typedRowResults = {};\n     const plainAttached = { tune: emptyAttachedTally(), holdout: emptyAttachedTally() };\n+    const plainStages = { tune: emptyStageTally(), holdout: emptyStageTally() };\n+    // A fit row asks a question of its own, whether the head carries a command\n+    // where none fits, so its counts sit apart from every recall tally and never\n+    // reach a row map.\n+    const fitTally = {\n+      skillOnly: { carried: 0, total: 0 },\n+      decline: { carried: 0, total: 0, byKind: {} },\n+    };\n     const plainAttachedByFamily = new Map();\n     const sameOwnerAmbiguous = [];\n     let falseOfferAttached = 0;\n@@ -530,6 +589,22 @@ export async function scoreCommandCorpus(options = {}) {\n       // A typed command is the reader's own wording, so it outranks the hub's\n       // route in the delivered command, the same precedence the handler applies.\n       const delivered = typedCommandForTop(topId, row.prompt)?.command ?? attached;\n+      // A fit row is counted here and then leaves the loop, so no recall, reach,\n+      // silence or agreement count below describes it and no row map publishes\n+      // it. A decline row also rolls up under the kind it declares.\n+      if (row.row_type === 'skill-only' || row.row_type === 'decline') {\n+        const carries = headCarriesCommand(landed, delivered);\n+        const tally = row.row_type === 'skill-only' ? fitTally.skillOnly : fitTally.decline;\n+        tally.total += 1;\n+        if (carries) tally.carried += 1;\n+        if (row.row_type === 'decline') {\n+          const kind = row.decline_kind;\n+          if (tally.byKind[kind] === undefined) tally.byKind[kind] = { carried: 0, total: 0 };\n+          tally.byKind[kind].total += 1;\n+          if (carries) tally.byKind[kind].carried += 1;\n+        }\n+        continue;\n+      }\n       // A head shows that label only when nothing else names a command, so a row\n       // counts only when neither the typed command nor the route delivered one. A\n       // silent row that carries it shows a label nobody asked for.\n@@ -558,6 +633,20 @@ export async function scoreCommandCorpus(options = {}) {\n         addAttachedRow(plainAttached[row.split], top1Hit, attachedHit);\n         const family = attachedFamilyTally(plainAttachedByFamily, expected);\n         if (family) addAttachedRow(family[row.split], top1Hit, attachedHit);\n+        // `own` and `ownerLed` split the rows and `neither` is the remainder,\n+        // while the counted stages nest from owner-led down to attached.\n+        const owningSkill = expected === null ? undefined : commandOwner.get(expected);\n+        const ownerLed = !top1Hit && owningSkill !== undefined && owningSkill === topId;\n+        const routed = ownerLed && route !== undefined;\n+        const withCommand = routed && attached !== undefined;\n+        addStageRow(plainStages[row.split], {\n+          own: top1Hit,\n+          ownerLed,\n+          routed,\n+          withCommand,\n+          attached: attachedHit,\n+          neither: !top1Hit && !ownerLed,\n+        });\n       }\n       if (publishRow && attached !== undefined) attachedRows[row.id] = attached;\n       if (row.row_type === 'typed' && result?.ambiguous === true && isBridgeOwnerPair(idToCommand, ids, expected)) {\n@@ -668,7 +757,15 @@ export async function scoreCommandCorpus(options = {}) {\n           tune: attachedTallyJson(plainAttached.tune),\n           holdout: attachedTallyJson(plainAttached.holdout),\n         },\n+        plain_stages: {\n+          tune: plainStages.tune,\n+          holdout: plainStages.holdout,\n+        },\n         plain_by_family: plainByFamily,\n+        fit: {\n+          skillOnly: fitTally.skillOnly,\n+          decline: fitTally.decline,\n+        },\n         false_offer_attached: { count: falseOfferAttached, total: falseOfferTotal },\n         typed: attachedTallyJson(typedAttached),\n         typedRows,\ndiff --git a/.skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/command-offer.mjs b/.skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/command-offer.mjs\nindex cde98615c4..17b589f99c 100644\n--- a/.skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/command-offer.mjs\n+++ b/.skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/command-offer.mjs\n@@ -9,6 +9,15 @@\n // the command and the policy, and a replay keeps the recorded value independent\n // of whatever the session reader happened to retain.\n //\n+// The handler gives the head row its command under every request shape and\n+// every caller asks for the route of the top pick alone, so for a run made\n+// from that state on, the Claude hook's head is\n+// the head every runtime's reader got.\n+// A run stored before that state carries the Claude hook's replay, which\n+// could differ from the head a non-Claude reader saw, at the head row or at\n+// the partner of an ambiguous head. A runtime whose renderer differs would\n+// need its own replay.\n+//\n // A failed replay returns null fields plus an offerError, so a backfill over a\n // checkout without the hook, or a hook that crashes, still produces a readable\n // line instead of aborting the run.\n@@ -41,28 +50,34 @@ const REPO_ROOT = resolve(dirname(fileURLToPath(import.meta.url)), '../../../../\n const CODEX_CHECK = join(REPO_ROOT, '.skilled/commands/doctor/scripts/codex-hook-approval-check.cjs');\n \n function failedOffer(offerError) {\n-  return { offeredCommand: null, offeredPolicy: null, offerError };\n+  return { offeredCommand: null, offeredPolicy: null, offeredAs: null, offerError };\n }\n \n /**\n- * Read the command and the policy out of the first line of a head.\n+ * Read the command, the policy and the side of `vs` out of the first line of a\n+ * head.\n  *\n  * The policy only counts when it directly follows the command, so a `(ask)`\n  * that belongs to a later clause cannot attach itself to an earlier match.\n+ * An ambiguous head names two paths, and only one of them leads, so\n+ * `offeredAs` records whether the match sat before `vs` as the head or after\n+ * it as the partner.\n  *\n  * @param {string} head - One line of advisor output.\n- * @returns {{ offeredCommand: string | null, offeredPolicy: string | null }}\n+ * @returns {{ offeredCommand: string | null, offeredPolicy: string | null,\n+ *   offeredAs: 'head' | 'partner' | null }}\n  */\n export function parseOffer(head) {\n   const text = typeof head === 'string' ? head : '';\n   const match = text.match(OFFER_PATTERN);\n   if (!match) {\n-    return { offeredCommand: null, offeredPolicy: null };\n+    return { offeredCommand: null, offeredPolicy: null, offeredAs: null };\n   }\n   const policy = text.slice(match.index + match[0].length).match(POLICY_PATTERN);\n   return {\n     offeredCommand: match[0],\n     offeredPolicy: policy ? policy[1] : null,\n+    offeredAs: text.slice(0, match.index).includes(' vs ') ? 'partner' : 'head',\n   };\n }\n \n@@ -78,7 +93,8 @@ export function parseOffer(head) {\n  * @param {string} options.prompt - The prompt to replay.\n  * @param {string} options.sessionId - Session id for the hook payload.\n  * @param {number} [options.timeoutMs] - Hook timeout before the replay fails.\n- * @returns {{ offeredCommand: string | null, offeredPolicy: string | null, offerError: string | null }}\n+ * @returns {{ offeredCommand: string | null, offeredPolicy: string | null,\n+ *   offeredAs: 'head' | 'partner' | null, offerError: string | null }}\n  */\n export function replayOffer({ checkoutDir, prompt, sessionId, timeoutMs = DEFAULT_TIMEOUT_MS }) {\n   const hookPath = join(checkoutDir, HOOK_RELATIVE);\n@@ -139,12 +155,14 @@ function contentHasBrief(content) {\n   });\n }\n \n-// Neutral records keep their text in content blocks, and the block shape differs\n-// by runtime, so the serialized record is the one place the brief is found\n-// whichever block carries it.\n+// A brief arrives as session input, so a tool that printed a document quoting a\n+// head delivered nothing. Neutral records keep their text in content blocks, and\n+// the block shape differs by runtime, so the serialized record is the one place\n+// the brief is found whichever block carries it.\n function recordsHaveBrief(records) {\n   return (Array.isArray(records) ? records : []).some((record) =>\n-    BRIEF_PATTERN.test(JSON.stringify(record ?? null)));\n+    record?.role !== 'toolResult'\n+    && BRIEF_PATTERN.test(JSON.stringify(record ?? null)));\n }\n \n // Injected context sits beside the records rather than inside them, so a reader\ndiff --git a/.skilled/skills/system-skill-advisor/runtime/tests/command-offer.vitest.ts b/.skilled/skills/system-skill-advisor/runtime/tests/command-offer.vitest.ts\nindex 6df195078d..79cb77268e 100644\n--- a/.skilled/skills/system-skill-advisor/runtime/tests/command-offer.vitest.ts\n+++ b/.skilled/skills/system-skill-advisor/runtime/tests/command-offer.vitest.ts\n@@ -75,6 +75,7 @@ describe('parseOffer', () => {\n     expect(parseOffer(OFFERED_HEAD)).toEqual({\n       offeredCommand: '/doctor:git hooks',\n       offeredPolicy: 'ask',\n+      offeredAs: 'head',\n     });\n   });\n \n@@ -82,6 +83,7 @@ describe('parseOffer', () => {\n     expect(parseOffer(AMBIGUOUS_HEAD)).toEqual({\n       offeredCommand: '/doctor:git hooks',\n       offeredPolicy: null,\n+      offeredAs: 'head',\n     });\n   });\n \n@@ -89,6 +91,23 @@ describe('parseOffer', () => {\n     expect(parseOffer(NO_COMMAND_HEAD)).toEqual({\n       offeredCommand: null,\n       offeredPolicy: null,\n+      offeredAs: null,\n+    });\n+  });\n+\n+  it('marks a command that sits after vs as the partner', () => {\n+    expect(parseOffer('Advisor: live; ambiguous: sk-code 0.95/0.12 vs sk-doc → /create:manual-testing-playbook (start) 0.82/0.12 pass.')).toEqual({\n+      offeredCommand: '/create:manual-testing-playbook',\n+      offeredPolicy: 'start',\n+      offeredAs: 'partner',\n+    });\n+  });\n+\n+  it('marks a command before vs as the head', () => {\n+    expect(parseOffer('Advisor: live; ambiguous: sk-doc → /create:agent (start) 0.82/0.12 vs sk-code 0.82/0.12 pass.')).toEqual({\n+      offeredCommand: '/create:agent',\n+      offeredPolicy: 'start',\n+      offeredAs: 'head',\n     });\n   });\n });\n@@ -134,6 +153,7 @@ describe('replayOffer', () => {\n       expect(replayOffer({ checkoutDir, prompt: 'create a readme', sessionId: 'offer-test' })).toEqual({\n         offeredCommand: null,\n         offeredPolicy: null,\n+        offeredAs: null,\n         offerError: 'hook_missing',\n       });\n     } finally {\n@@ -256,6 +276,30 @@ describe('briefDelivered', () => {\n       rmSync(dir, { recursive: true, force: true });\n     }\n   });\n+\n+  it('does not count a head quoted inside a tool result', async () => {\n+    await expect(briefDelivered({\n+      runtime: 'pi',\n+      locator: {},\n+      loadSession: async () => ({\n+        ok: true,\n+        records: [{ role: 'toolResult', content: [{ type: 'text', text: 'Advisor: live; use sk-doc 0.95/0.12 pass.' }] }],\n+        injected: [],\n+      }),\n+    })).resolves.toBe(false);\n+  });\n+\n+  it('counts a head in a user record', async () => {\n+    await expect(briefDelivered({\n+      runtime: 'pi',\n+      locator: {},\n+      loadSession: async () => ({\n+        ok: true,\n+        records: [{ role: 'user', content: [{ type: 'text', text: 'Advisor: live; use sk-doc 0.95/0.12 pass.' }] }],\n+        injected: [],\n+      }),\n+    })).resolves.toBe(true);\n+  });\n });\n \n describe('backfillRunLog', () => {\ndiff --git a/.skilled/skills/system-skill-advisor/runtime/tests/command-routing-slice.vitest.ts b/.skilled/skills/system-skill-advisor/runtime/tests/command-routing-slice.vitest.ts\nindex 61fb41c5af..8cdc31b6d2 100644\n--- a/.skilled/skills/system-skill-advisor/runtime/tests/command-routing-slice.vitest.ts\n+++ b/.skilled/skills/system-skill-advisor/runtime/tests/command-routing-slice.vitest.ts\n@@ -13,7 +13,10 @@ import { dirname, join, resolve } from 'node:path';\n import { fileURLToPath } from 'node:url';\n \n import { beforeAll, describe, expect, it } from 'vitest';\n-import { scoreCommandCorpus as captureCommandCorpus } from '../scripts/routing-accuracy/capture-command-routing-baseline.mjs';\n+import {\n+  assertFitRowsUnique as captureAssertFitRowsUnique,\n+  scoreCommandCorpus as captureCommandCorpus,\n+} from '../scripts/routing-accuracy/capture-command-routing-baseline.mjs';\n \n const HERE = dirname(fileURLToPath(import.meta.url));\n const ROUTING = resolve(HERE, '../scripts/routing-accuracy');\n@@ -59,6 +62,21 @@ interface CommandTally {\n   readonly plain: { readonly tune: SplitTally; readonly holdout: SplitTally };\n }\n \n+interface StageTally {\n+  readonly total: number;\n+  readonly own: number;\n+  readonly ownerLed: number;\n+  readonly routed: number;\n+  readonly withCommand: number;\n+  readonly attached: number;\n+  readonly neither: number;\n+}\n+\n+interface FitTally {\n+  readonly carried: number;\n+  readonly total: number;\n+}\n+\n interface CommandRow {\n   readonly expected_command: string | null;\n   readonly top: string | null;\n@@ -80,11 +98,21 @@ interface CommandRoutingBaseline {\n   readonly attachedMetrics: Readonly<Record<string, unknown>>;\n }\n \n+interface PromptRow {\n+  readonly id: string;\n+  readonly row_type: string;\n+  readonly prompt: string;\n+}\n+\n // The capture script is plain JavaScript with no declaration file of its own, so\n // the shape it returns is declared here and the import is cast to that shape\n // rather than left implicitly `any` at every call site.\n const scoreCommandCorpus = captureCommandCorpus as unknown as () => Promise<CommandRoutingBaseline>;\n \n+// The duplicate guard reads whole corpus rows, so its input is declared apart\n+// from the captured result rather than typed as a row of that result.\n+const assertFitRowsUnique = captureAssertFitRowsUnique as unknown as (rows: readonly PromptRow[]) => void;\n+\n function readJsonl<T>(path: string): T[] {\n   return readFileSync(path, 'utf8').trim().split('\\n').filter(Boolean).map((line) => JSON.parse(line) as T);\n }\n@@ -168,6 +196,75 @@ describe('command routing slice', () => {\n     expect(published, `the baseline publishes a per-row outcome for ${published.length} holdout ids`).toEqual([]);\n   });\n \n+  it('refuses a fit row that repeats another row', () => {\n+    // A fit row shares the corpus with every other row, so a prompt that already\n+    // exists would count one request twice. Case and whitespace do not make two\n+    // prompts different, so a reflowed copy still names the row it repeats.\n+    expect(() =>\n+      assertFitRowsUnique([\n+        { id: 'fit-skill-only-91', row_type: 'skill-only', prompt: 'Rename  the Helper function' },\n+        { id: 'made-up-92', row_type: 'plain', prompt: 'rename the helper function' },\n+      ]),\n+    ).toThrow('fit row fit-skill-only-91 repeats row made-up-92');\n+    expect(() =>\n+      assertFitRowsUnique([\n+        { id: 'fit-skill-only-91', row_type: 'skill-only', prompt: 'Rename  the Helper function' },\n+        { id: 'made-up-92', row_type: 'plain', prompt: 'rename the other function' },\n+      ]),\n+    ).not.toThrow();\n+  });\n+\n+  it('splits each plain row into one reach stage', () => {\n+    // A plain row leaves the path to its command at one stage, so the stage\n+    // counts have to partition the split and narrow toward the rows a command\n+    // actually carried. Reading the same split's plain tally proves both views\n+    // count the same rows rather than two different row sets.\n+    const attached = live.attachedMetrics as {\n+      readonly plain: Readonly<Record<'tune' | 'holdout', { readonly own: number; readonly attached: number }>>;\n+      readonly plain_stages: Readonly<Record<'tune' | 'holdout', StageTally>>;\n+    };\n+    for (const split of ['tune', 'holdout'] as const) {\n+      const stage = attached.plain_stages[split];\n+      expect(stage.own + stage.ownerLed + stage.neither).toBe(stage.total);\n+      expect(stage.attached).toBeLessThanOrEqual(stage.withCommand);\n+      expect(stage.withCommand).toBeLessThanOrEqual(stage.routed);\n+      expect(stage.routed).toBeLessThanOrEqual(stage.ownerLed);\n+      expect(stage.own).toBe(attached.plain[split].own);\n+      expect(stage.attached).toBe(attached.plain[split].attached);\n+    }\n+  });\n+\n+  it('counts the sealed fit rows and publishes none', () => {\n+    // A fit row asks whether the head carries a command where none fits, so its\n+    // counts are kept apart from every recall tally and its outcome is never\n+    // published row by row: one corpus then answers both questions.\n+    const attached = live.attachedMetrics as {\n+      readonly fit: {\n+        readonly skillOnly: FitTally;\n+        readonly decline: FitTally & { readonly byKind: Readonly<Record<string, FitTally>> };\n+      };\n+      readonly attachedRows: Readonly<Record<string, string>>;\n+      readonly typedRows: Readonly<Record<string, unknown>>;\n+    };\n+    const { skillOnly, decline } = attached.fit;\n+    expect(skillOnly.total).toBe(24);\n+    expect(decline.total).toBe(24);\n+    expect(Object.keys(decline.byKind).sort()).toEqual(['app-problem', 'question', 'refusal', 'small-edit']);\n+    for (const [kind, tally] of Object.entries(decline.byKind)) {\n+      expect(tally.total, `decline kind ${kind} counts ${tally.total} rows`).toBe(6);\n+    }\n+    for (const tally of [skillOnly, decline, ...Object.values(decline.byKind)]) {\n+      expect(tally.carried).toBeLessThanOrEqual(tally.total);\n+    }\n+    // A published fit row would expose the outcome the sealed split withholds.\n+    const published = [\n+      ...Object.keys(live.rows),\n+      ...Object.keys(attached.attachedRows),\n+      ...Object.keys(attached.typedRows),\n+    ].filter((id) => id.startsWith('fit-'));\n+    expect(published, `the baseline publishes a per-row outcome for ${published.length} fit ids`).toEqual([]);\n+  });\n+\n   it('matches the captured totals', () => {\n     expect(live.metrics).toEqual(baseline.metrics);\n     expect(live.unreachable).toEqual(baseline.unreachable);\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"git diff 0cdc9fa3ef..HEAD -- .skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/command-offer.mjs .skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/capture-command-routing-baseline.mjs .skilled/skills/system-skill-advisor/runtime/tests/command-offer.vitest.ts .skilled/skills/system-skill-advisor/runtime/tests/command-routing-slice.vitest.ts | head -500\"}"},"time":{"start":1794669420922,"end":1794669421462}}}}
