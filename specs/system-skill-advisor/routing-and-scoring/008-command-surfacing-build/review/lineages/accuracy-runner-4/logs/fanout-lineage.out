ng copy happens to say.\n90:  *\n91:  * @param {object} options\n92:  * @param {string} options.checkoutDir - Root of the checkout whose hook runs.\n93:  * @param {string} options.prompt - The prompt to replay.\n94:  * @param {string} options.sessionId - Session id for the hook payload.\n95:  * @param {number} [options.timeoutMs] - Hook timeout before the replay fails.\n96:  * @returns {{ offeredCommand: string | null, offeredPolicy: string | null,\n97:  *   offeredAs: 'head' | 'partner' | null, offerError: string | null }}\n98:  */\n99: export function replayOffer({ checkoutDir, prompt, sessionId, timeoutMs = DEFAULT_TIMEOUT_MS }) {\n100:   const hookPath = join(checkoutDir, HOOK_RELATIVE);\n101:   if (!existsSync(hookPath)) {\n102:     return failedOffer('hook_missing');\n103:   }\n104: \n105:   const payload = {\n106:     prompt,\n107:     cwd: checkoutDir,\n108:     hook_event_name: 'UserPromptSubmit',\n109:     session_id: sessionId,\n110:   };\n111: \n112:   let result;\n113:   try {\n114:     result = spawnSync('node', [hookPath], {\n115:       cwd: checkoutDir,\n116:       input: JSON.stringify(payload),\n117:       encoding: 'utf8',\n118:       timeout: timeoutMs,\n119:       maxBuffer: MAX_OUTPUT_BYTES,\n120:     });\n121:   } catch {\n122:     return failedOffer('hook_failed');\n123:   }\n124: \n125:   if (result.error || result.status !== 0 || typeof result.stdout !== 'string') {\n126:     return failedOffer('hook_failed');\n127:   }\n128: \n129:   let output;\n130:   try {\n131:     output = JSON.parse(result.stdout);\n132:   } catch {\n133:     return failedOffer('hook_failed');\n134:   }\n135: \n136:   const context = output?.hookSpecificOutput?.additionalContext;\n137:   if (typeof context !== 'string') {\n138:     return failedOffer('no_head');\n139:   }\n140: \n141:   const [firstLine = ''] = context.split(/\\r?\\n/);\n142:   if (!firstLine.trim()) {\n143:     return failedOffer('no_head');\n144:   }\n145: \n146:   return { ...parseOffer(firstLine), offerError: null };\n147: }\n148: \n149: function contentHasBrief(content) {\n150:   if (typeof content === 'string') return BRIEF_PATTERN.test(content);\n151:   if (!Array.isArray(content)) return false;\n152:   return content.some((part) => {\n153:     if (typeof part === 'string') return BRIEF_PATTERN.test(part);\n154:     return typeof part?.text === 'string' && BRIEF_PATTERN.test(part.text);\n155:   });\n156: }\n157: \n158: // A brief arrives as session input, so a tool that printed a document quoting a\n159: // head delivered nothing. Neutral records keep their text in content blocks, and\n160: // the block shape differs by runtime, so the serialized record is the one place\n161: // the brief is found whichever block carries it.\n162: function recordsHaveBrief(records) {\n163:   return (Array.isArray(records) ? records : []).some((record) =>\n164:     record?.role !== 'toolResult'\n165:     && BRIEF_PATTERN.test(JSON.stringify(record ?? null)));\n166: }\n167: \n168: // Injected context sits beside the records rather than inside them, so a reader\n169: // that reports it gives the brief a second place to be found.\n170: function injectedHasBrief(injected) {\n171:   return (Array.isArray(injected) ? injected : []).some(\n172:     (entry) => typeof entry?.text === 'string' && BRIEF_PATTERN.test(entry.text),\n173:   );\n174: }\n175: \n176: /**\n177:  * Ask the project's Codex approval check whether its advisor hook can run.\n178:  *\n179:  * Codex skips an unapproved project hook without a warning, so a wired hook can\n[Output truncated. Continue reading with offset: 180]","title":"read","metadata":{"metadata":{"truncated":true},"content":[{"type":"text","text":"Read file .skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/command-offer.mjs, lines 60-179\n60:  * The policy only counts when it directly follows the command, so a `(ask)`\n61:  * that belongs to a later clause cannot attach itself to an earlier match.\n62:  * An ambiguous head name