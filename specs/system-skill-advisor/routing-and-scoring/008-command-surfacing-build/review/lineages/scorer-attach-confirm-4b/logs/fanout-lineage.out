50 accuracy-runner-4\ndrwx------@  8 michelkerkmeester  staff   256 Nov 14 19:16 accuracy-runner-confirm-4b\ndrwx------@ 20 michelkerkmeester  staff   640 Nov 13 20:41 advisor-runtime-3\ndrwx------@ 20 michelkerkmeester  staff   640 Nov 13 20:41 doctor-docs-3\ndrwx------@ 20 michelkerkmeester  staff   640 Nov 14 16:56 doctor-docs-4\ndrwx------@ 20 michelkerkmeester  staff   640 Nov 13 20:41 doctor-install\ndrwx------@ 21 michelkerkmeester  staff   672 Nov 13 20:41 doctor-install-2\ndrwx------@ 21 michelkerkmeester  staff   672 Nov 13 20:41 hook-close-3c\ndrwx------@ 20 michelkerkmeester  staff   640 Nov 13 20:41 hook-confirm-3b\ndrwx------@ 21 michelkerkmeester  staff   672 Nov 13 20:41 noedit-close-3c\ndrwx------@ 23 michelkerkmeester  staff   736 Nov 13 20:41 noedit-confirm-3b\ndrwx------@ 20 michelkerkmeester  staff   640 Nov 13 20:41 render-hooks-plugin\ndrwx------@ 20 michelkerkmeester  staff   640 Nov 13 20:41 render-hooks-plugin-2\ndrwx------@ 20 michelkerkmeester  staff   640 Nov 14 16:52 render-hooks-plugin-4\ndrwx------@ 19 michelkerkmeester  staff   608 Nov 13 20:41 scorer-attach\ndrwx------@ 19 michelkerkmeester  staff   608 Nov 13 20:41 scorer-attach-2\ndrwx------@ 22 michelkerkmeester  staff   704 Nov 14 16:43 scorer-attach-4\ndrwx------@  8 michelkerkmeester  staff   256 Nov 14 19:16 scorer-attach-confirm-4b\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\": \"ls -la specs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/review/lineages/scorer-attach-confirm-4b/ 2>&1; echo \\\"---\\\"; ls -la specs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/review/lineages/ 2>&1\"}"},"time":{"start":1794680200184,"end":1794680200833}}}}
