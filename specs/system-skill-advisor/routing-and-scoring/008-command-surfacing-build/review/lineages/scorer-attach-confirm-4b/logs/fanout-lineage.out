the reader refuses is named without being asked for, so this list\n367: // holds the leads that mark that naming. A lead must sit directly before the\n368: // command so a later clause cannot refuse an earlier request, and a gap holds\n369: // plain words only so a refusal before a comma cannot swallow the request after\n370: // it. A reader who stops using a command names it only to refuse it.\n371: export const COMMAND_DECLINE_LEADS: readonly string[] = [\n372:   `(?:do not|don't|dont|never|${COMMAND_NOT_WORD}|won't|wont|no longer|cannot|can't|no need to|need not|needn't) (?!(?:forget|hesitate|fail|mind)\\\\b)${COMMAND_GAP_WORDS}${COMMAND_USE_VERB} ${COMMAND_GAP_WORDS}`,\n373:   `(?:skip|skipping|without|instead of|rather than|avoid|stop|stopped|quit|${COMMAND_NOT_WORD}) (?:(?!${COMMAND_USE_VERB}\\\\b)[a-z']+ ){0,2}`,\n374: ];\n375: \n376: // A refusal over an or-list refuses every command the list joins to the one its\n377: // lead names, while a second use verb opens a clause of its own, so the list\n378: // joins only `or` and `, or`.\n379: const COMMAND_OR_LIST = '(?:\\\\/[a-z][a-z0-9_-]*(?::[a-z][a-z0-9_-]*)?,? or )*';\n380: \n381: // A command the reader asks about is named without being asked for, so this list\n382: // holds the leads that mark that naming. A lead must sit directly before the\n383: // command so a later clause cannot turn an earlier request into a question, and\n384: // a gap holds plain words only so a question before a comma cannot swallow the\n385: // request after it.\n386: export const COMMAND_ASK_LEADS: readonly string[] = [\n387:   \"(?:what does|what is|what's|what would|what will|what did|how does|how did|why does|why did|explain|describe|tell me what|tell me how|tell me about|tell me why|difference between|differ from|differs from|different from|undo what|ran|already ran|was running) (?:the )?(?:command )?\",\n388:   `(?:should i|should we|do i need to|when would i) ${COMMAND_USE_VERB} (?:the )?(?:command )?`,\n389: ];\n390: \n391