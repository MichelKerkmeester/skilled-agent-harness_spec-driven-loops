lity\",\n    \"maintainability\"\n  ],\n  \"reviewFocus\": \"Confirming round of review pass four of command surfacing. FIRST read and follow specs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/review/review-brief-4b.txt: it names the scope file, the commit range, which files your lineage reviews and the checks. HOLDOUT RULE: never open command-prompts.jsonl or holdout-prompts.jsonl except through jq 'del(.prompt)', never run git diff, show or log -p over a path that includes command-prompts.jsonl without the pathspec ':(exclude)**/command-prompts.jsonl', and never print a prompt whose split is holdout. The reviewer changes no code and writes only inside its lineage folder.\",\n  \"reviewScopeFiles\": [\n    \".skilled/skills/system-skill-advisor/README.md\",\n    \".skilled/skills/system-skill-advisor/feature-catalog/cli-surface/advisor-recommend.md\",\n    \".skilled/skills/system-skill-advisor/feature-catalog/scorer-fusion/command-meaning-matching.md\",\n    \".skilled/skills/system-skill-advisor/runtime/lib/command-attach.ts\",\n    \".skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/score-command-transcripts.mjs\",\n    \".skilled/skills/system-skill-advisor/runtime/tests/command-attach-guards.vitest.ts\",\n    \".skilled/skills/system-skill-advisor/runtime/tests/command-routing-slice.vitest.ts\",\n    \".skilled/skills/system-skill-advisor/runtime/tests/command-transcript-score.vitest.ts\"\n  ],\n  \"resource_map_present\": false,\n  \"resource_map\": {\n    \"emit\": true\n  },\n  \"severityThreshold\": \"P2\",\n  \"crossReference\": {\n    \"core\": [\n      \"spec_code\",\n      \"checklist_evidence\"\n    ],\n    \"overlay\": [\n      \"skill_agent\",\n      \"agent_cross_runtime\",\n      \"feature_catalog_code\",\n      \"playbook_capability\"\n    ]\n  },\n  \"qualityGateThreshold\": true,\n  \"runtimeCapabilityResolver\": \".skilled/skills/system-deep-loop/deep-review/scripts/runtime-capabilities.cjs\",\n  \"r