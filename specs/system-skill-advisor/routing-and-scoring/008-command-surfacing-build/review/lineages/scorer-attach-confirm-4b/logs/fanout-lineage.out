 => {\n45:    vi.unstubAllEnvs();\n48:  it('renders a start command as parent-named only', () => {\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"cd /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research && rg -n \\\"parent-named|PARENT_NAMED|policyWord\\\" .skilled/skills/system-skill-advisor/runtime/lib/render.ts | head -10; echo \\\"--- test\\\"; rg -n \\\"doctor:update\\\" .skilled/skills/system-skill-advisor/runtime/tests/doctor-brief-render.vitest.ts | head -5; echo \\\"--- render-child\\\"; rg -n \\\"policy|\\\\\\\\(\\\" .skilled/skills/system-skill-advisor/runtime/tests/render-child-session.vitest.ts | head -10\"}"},"time":{"start":1794681141251,"end":1794681142782}}}}
