rmLate;\n750: }\n751: \n752: // A hub dispatch runs one compiled route and names the workflow it loads only in\n753: // an argument, so a shell event that runs that script is a load when it names the\n754: // owner's hub.\n755: const COMPILED_ROUTE = /\\bcompiled-route\\.cjs\\b/;\n756: \n757: function escapePattern(text) {\n758:   return text.replace(/[.*+?^${}()|[\\]\\\\]/g, '\\\\$&');\n759: }\n760: \n761: // A mode can keep its workflow in the packet folder of another mode of its hub.\n762: const MODE_FOLDERS = Object.freeze({ 'sk-create-skill-parent': 'sk-create-skill' });\n763: \n764: // A skill load has three shapes in a transcript: a read of the skill's own entry\n765: // document, whether through a read tool or the shell, a skill tool naming it, and a\n766: // hub dispatch naming it. The entry document may sit one mode folder below the skill,\n767: // so the segment that names the owner is the one directly under `skills`. A mode\n768: // folder is the mode id alone or the hub name and the mode id joined with a dash, so\n769: // the folder matches when it equals the mode or ends with a dash and the mode. A\n770: // document under another mode of the same hub is a different workflow, so it is named\n771: // apart from the owner's own load. A load after the first write is the deviation the\n772: // order exists to show, and a run that wrote nothing has no boundary for its load to\n773: // cross. A hub dispatch that saves its route to a file is that first write itself, and\n774: // the route is resolved before the file is written, so such a call still counts when\n775: // it is the first write.\n776: function ownerLoadedBeforeWrite(events, owner, mode, checkoutDir) {\n777:   const wanted = escapePattern(owner);\n778:   const documents = new RegExp(`(?:^|/)skills/${wanted}/(?:(.+)/)?(?:SKILL|ROUTER)\\\\.md$`);\n779:   const hub = new RegExp(`(?:^|\\\\s)--hub\\\\s+${wanted}(?![\\\\w-])`);\n780:   const boundary = firstWritePosition(events, checkoutDir);\n781:   let otherMode = false;\n782: \n783:   for (let index = 0; index < events.length; index += 1) {\n784:     const event = events[index];\n785:     if (!event) continue;\n786:     const position = positionOf(event, index);\n787:     const atBoundaryWrite = event.kind === 'write' && position === boundary;\n788:     if (boundary !== null && position >= boundary && !atBoundaryWrite) continue;\n789: \n790:     const command = typeof event.command === 'string' ? event.command : '';\n791:     const path = typeof event.path === 'string' ? event.path.replace(/\\\\/g, '/') : '';\n792:     const targets = [];\n793:     if (!atBoundaryWrite && (event.kind === 'read' || event.kind === 'skill') && path !== '') targets.push(path);\n794:     if (!atBoundaryWrite && event.kind === 'shell') targets.push(...shellReadTargets(command));\n795: \n796:     for (const target of targets) {\n797:       const match = documents.exec(target);\n798:       if (match === null) continue;\n[Output truncated. Continue reading with offset: 799]","title":"read","metadata":{"metadata":{"truncated":true},"content":[{"type":"text","text":"Read file .skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/score-command-transcripts.mjs, lines 719-798\n719: export function followedBeforeWrite(events, command, checkoutDir) {\n720:   const wanted = commandParts(command);\n721:   if (wanted === null) return false;\n722: \n723:   const stream = Array.isArray(events) ? events : [];\n724:   const documents = documentTails(wanted);\n725:   const confirms = confirmTails(wanted);\n726:   const boundary = firstWritePosition(stream, checkoutDir);\n727: \n728:   let followDocument = false;\n729:   let confirmLate = false;\n730: \n731:   for (let index = 0; index < stream.length; index += 1) {\n732:     const event = stream[index];\n733:     if (!event || (event.kind !== 'read' && event.kind !== 'skill' && event.kind !== 'shell')) continue;\n734: \n735:     const named = event.kind === 'shell'\n736:       ? shellReadTargets(event.command)\n737:       : [event.path, event.command].filter((value) => typeof value === 'string' && value.trim());\n738:     const before = boundary === null || positionOf(event, index) < boundary;\n739: \n740:     if (before) {\n741:       const followed = named.some((value) => tailMatches(value, documents))\n742:         || (event.kind === 'skill' && namesCommand(event.command, wanted));\n743:       if (followed) followDocument = true;\n744:     } else if (named.some((value) => tailMatches(value, confirms))) {\n745:       confirmLate = true;\n746:     }\n747:   }\n748: \n749:   return followDocument && !confirmLate;\n750: }\n751: \n752: // A hub dispatch runs one compiled route and names the workflow it loads only in\n753: // an argument, so a shell event that runs that script is a load when it names the\n754: // owner's hub.\n755: const COMPILED_ROUTE = /\\bcompiled-route\\.cjs\\b/;\n756: \n757: function escapePattern(text) {\n758:   return text.replace(/[.*+?^${}()|[\\]\\\\]/g, '\\\\$&');\n759: }\n760: \n761: // A mode can keep its workflow in the packet folder of another mode of its hub.\n762: const MODE_FOLDERS = Object.freeze({ 'sk-create-skill-parent': 'sk-create-skill' });\n763: \n764: // A skill load has three shapes in a transcript: a read of the skill's own entry\n765: // document, whether through a read tool or the shell, a skill tool naming it, and a\n766: // hub dispatch naming it. The entry document may sit one mode folder below the skill,\n767: // so the segment that names the owner is the one directly under `skills`. A mode\n768: // folder is the mode id alone or the hub name and the mode id joined with a dash, so\n769: // the folder matches when it equals the mode or ends with a dash and the mode. A\n770: // document under another mode of the same hub is a different workflow, so it is named\n771: // apart from the owner's own load. A load after the first write is the deviation the\n772: // order exists to show, and a run that wrote nothing has no boundary for its load to\n773: // cross. A hub dispatch that saves its route to a file is that first write itself, and\n774: // the route is resolved before the file is written, so such a call still counts when\n775: // it is the first write.\n776: function ownerLoadedBeforeWrite(events, owner, mode, checkoutDir) {\n777:   const wanted = escapePattern(owner);\n778:   const documents = new RegExp(`(?:^|/)skills/${wanted}/(?:(.+)/)?(?:SKILL|ROUTER)\\\\.md$`);\n779:   const hub = new RegExp(`(?:^|\\\\s)--hub\\\\s+${wanted}(?![\\\\w-])`);\n780:   const boundary = firstWritePosition(events, checkoutDir);\n781:   let otherMode = false;\n782: \n783:   for (let index = 0; index < events.length; index += 1) {\n784:     const event = events[index];\n785:     if (!event) continue;\n786:     const position = positionOf(event, index);\n787:     const atBoundaryWrite = event.kind === 'write' && position === boundary;\n788:     if (boundary !== null && position >= boundary && !atBoundaryWrite) continue;\n789: \n790:     const command = typeof event.command === 'string' ? event.command : '';\n791:     const path = typeof event.path === 'string' ? event.path.replace(/\\\\/g, '/') : '';\n792:     const targets = [];\n793:     if (!atBoundaryWrite && (event.kind === 'read' || event.kind === 'skill') && path !== '') targets.push(path);\n794:     if (!atBoundaryWrite && event.kind === 'shell') targets.push(...shellReadTargets(command));\n795: \n796:     for (const target of targets) {\n797:       const match = documents.exec(target);\n798:       if (match === null) continue;\n[Output truncated. Continue reading with offset: 799]"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"limit\":80,\"offset\":719,\"path\":\".skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/score-command-transcripts.mjs\"}"},"time":{"start":1794680410256,"end":1794680410898}}}}
