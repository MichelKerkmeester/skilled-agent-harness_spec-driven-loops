:implement'],\n184:     ['what does /speckit:save do? ok now run /speckit:save', '/speckit:save'],\n185:     ['the plan is /speckit:plan then tests', '/speckit:plan'],\n186:   ])('reads %s as a request for %s', (prompt, command) => {\n187:     expect(commandOnlyMentioned(prompt, command)).toBe(false);\n188:   });\n189: \n190:   // A chat question often leaves the question mark off, so a bare ask word that\n191:   // opens a sentence still marks the command as the subject.\n192:   it.each([\n193:     ['is /speckit:resume safe to run twice', '/speckit:resume'],\n194:     ['does /doctor:git change files or just report problems', '/doctor:git'],\n195:     ['can /prompt:improve make a vague request easier to follow', '/prompt:improve'],\n196:     ['ok. is /speckit:plan enough here', '/speckit:plan'],\n197:     ['quick question? is /speckit:resume safe to run twice', '/speckit:resume'],\n198:     ['Is the /doctor:update command safe?', '/doctor:update'],\n199:   ])('reads %s as a question about %s', (prompt, command) => {\n200:     expect(commandOnlyMentioned(prompt, command)).toBe(true);\n201:   });\n202: \n203:   it('reads each command of a two-command prompt on its own', () => {\n204:     expect(commandOnlyMentioned('use /speckit:plan, not /speckit:complete', '/speckit:complete')).toBe(true);\n205:   });\n206: \n207:   it('reads a curly apostrophe as a straight one', () => {\n208:     expect(commandOnlyMentioned('don\\u2019t run /speckit:save', '/speckit:save')).toBe(true);\n209:   });\n210: \n211:   it('reads no need to run as a refusal of the command', () => {\n212:     expect(commandOnlyMentioned('no need to run /doctor:setup, the hooks are fine', '/doctor:setup')).toBe(true);\n213:   });\n214: \n215:   it('still reads a request after no need to ask', () => {\n216:     expect(commandOnlyMentioned('no need to ask, run /speckit:save', '/speckit:save')).toBe(false);\n217:   });\n218: \n219:   it('reads stop using as a refusal of the command', () => {\n220:     expect(c