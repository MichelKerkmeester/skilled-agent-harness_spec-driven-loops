rocess.stderr.write(`${result.stdout}${result.stderr}`);\n60:     console.log('STATUS=ERROR session-reader-declarations: the compiler failed');\n61:     process.exit(2);\n62:   }\n63: }\n64: \n65: // Builds in a temporary copy so the compiler never writes declarations for the\n66: // helpers beside this folder into the checkout. A reader may require such a\n67: // helper, like the Cursor reader's `../hook-flags.cjs`, so the copy keeps that\n68: // layout. Returns the temporary root and the folder holding the declarations.\n69: function build() {\n70:   const root = mkdtempSync(join(tmpdir(), 'session-reader-declarations-'));\n71:   const scratch = join(root, 'session-readers');\n72:   mkdirSync(scratch);\n73:   for (const name of readdirSync(HERE).filter((entry) => /\\.(c|m)?js$/.test(entry))) {\n74:     copyFileSync(join(HERE, name), join(root, name));\n75:   }\n76:   for (const name of sources(READERS_DIR)) copyFileSync(join(READERS_DIR, name), join(scratch, name));\n77:   emit(scratch);\n78:   return { root, scratch };\n79: }\n80: \n[Output truncated. Continue reading with offset: 81]"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"limit\":80,\"path\":\".skilled/hooks/shared/session-reader-declarations.mjs\"}"},"time":{"start":1794680527071,"end":1794680527803}}}}
