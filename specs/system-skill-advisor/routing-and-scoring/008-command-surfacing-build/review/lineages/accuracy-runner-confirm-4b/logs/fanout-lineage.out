pletion: true\n1863:           notes:\n1864:             - \"cli-devin single-executor: dispatches per-iteration through the shared fan-out command builder (buildLineageCommand) so the enforced cli-devin model allowlist + headless write flags stay one source of truth; runAuditedExecutorCommand emits INTENT + COMPLETION receipts\"\n1865:             - \"Fails closed when devin is absent or the model is off the allowlist (buildLineageCommand throws, exit non-zero) — a requested cli-devin executor never degrades to native\"\n1866:         if_cli_pi:\n1867:           command: |\n1868:             node --import \"$(node -p \"require.resolve('tsx', { paths: ['.skilled/skills/system-deep-loop/runtime'] })\")\" --input-type=module <<'EOF'\n1869:             import { readFileSync } from 'node:fs';\n1870:             import { createRequire } from 'node:module';\n1871:             import { runAuditedExecutorCommand } from './.skilled/skills/system-deep-loop/runtime/lib/deep-loop/executor-audit.ts';\n1872:             import { resolveSandboxMode, resolveClaudePermissionMode } from './.skilled/skills/system-deep-loop/runtime/lib/deep-loop/executor-config.ts';\n1873:             import {\n1874:               snapshotOutOfScopeDirtyPaths,\n1875:               enforceWriteContainment,\n1876:             } from './.skilled/skills/system-deep-loop/runtime/lib/deep-loop/write-containment.ts';\n1877: \n1878:             // cursor-agent/devin/pi have no single-executor branch of their own, so\n1879:             // without this they silently degrade to native. The command builder is the\n1880:             // same one the fan-out lineage path uses, so the enforced model allowlist,\n1881:             // headless write-mode flags, and binary preflight stay one source of truth.\n1882:             // It throws (fail closed) when the binary is absent or the model is off the\n1883:             // allowlist, so a requested CLI executor never becomes native.\n1884:             const require = cre