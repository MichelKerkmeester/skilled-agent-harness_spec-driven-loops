deep-review', readFileSync('{state_paths.prompt_dir}/iteration-{current_iteration}.md', 'utf8'), '{repo_root}'),\n1279:               '--model',\n1280:               executor.model,\n1281:               '--permission-mode',\n1282:               'acceptEdits',\n1283:               '--output-format',\n1284:               'text',\n1285:             ];\n1286:             if (executor.reasoningEffort) {\n1287:               args.push('--effort', executor.reasoningEffort);\n1288:             }\n1289: \n1290:             // CLAUDE_CONFIG_DIR rides through guardContext.env; the CLAUDE_ prefix is\n1291:             // on the cli-claude-code env allowlist so buildExecutorDispatchEnv admits it.\n1292:             const parentEnv = { ...process.env };\n1293:             if (configDir) {\n1294:               parentEnv.CLAUDE_CONFIG_DIR = configDir;\n1295:             }\n1296: \n1297:             const dispatchFacts = {\n1298:               command: 'deep/review',\n1299:               mode: 'review',\n1300:               specFolder: '{spec_folder}',\n1301:               artifactDir: '{state_paths.packet_dir}',\n1302:               iteration: Number('{current_iteration}'),\n1303:               executorKind: '{config.executor.kind}',\n1304:               branchId: '{config.executor.kind}',\n1305:               sessionId: '{session_id}',\n1306:               generation: Number('{generation}'),\n1307:             };\n1308:             const dispatchId = 'review-i{current_iteration}-g{generation}';\n1309:             process.exit(\n1310:               runAuditedExecutorCommand({\n1311:                 command: 'claude',\n1312:                 args,\n1313:                 cwd: '{repo_root}',\n1314:                 timeoutSeconds: executor.timeoutSeconds,\n1315:                 stateLogPath: '{state_paths.state_log}',\n1316:                 executor,\n1317:                 iteration: Number('{current_iteration}'),\n1318:                 guardContext: { env: parentEnv },\n1319:                 receiptDir: '{state_paths.packet_dir}/dispatch-receipts',\n1320:                 dispatchId,\n1321:               }),\n1322:             );\n1323:             EOF\n1324:           working_directory: \"{repo_root}\"\n1325:           timeout_seconds: \"{config.executor.timeoutSeconds}\"\n1326:           wait_for_completion: true\n1327:           render_hint:\n1328:             optional_claude_config_dir: |\n1329:               If config.executor.configDir is set and non-null, expand a leading ~ to HOME and bind that path.\n1330:               Otherwise expand to empty string.\n1331:           notes:\n1332:             - \"Routed through runAuditedExecutorCommand so claude-code produces INTENT + COMPLETION dispatch receipts; recursion guard + env allowlist enforced via buildExecutorDispatchEnv\"\n1333:             - \"CLAUDE_CONFIG_DIR is forwarded through guardContext.env (CLAUDE_ prefix is allowlisted) so account-specific Claude Code routing is preserved\"\n[Output truncated. Continue reading with offset: 1334]"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\".skilled/commands/deep/assets/deep-review-auto.yaml\",\"offset\":700,\"limit\":700}"},"time":{"start":1794680238525,"end":1794680238956}}}}
