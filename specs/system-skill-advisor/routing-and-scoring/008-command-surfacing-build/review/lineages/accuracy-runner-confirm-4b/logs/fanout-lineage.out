tent ever being read.\n  const root = claudeStoreRoot(options);\n  const containment = resolveInside({ path: transcriptPath, root });\n  if (!containment.ok) {\n    if (containment.code === 'session_mismatch') return containment;\n    try {\n      statSync(root);\n      return { ok: false, code: 'session_not_found' };\n    } catch {\n      return { ok: false, code: 'store_unreadable' };\n    }\n  }\n  const storePath = containment.path;\n\n  let raw;\n  try {\n    // The file read is the path the containment check resolved, so a path\n    // swapped after the check is not followed.\n    raw = readFileSync(storePath, 'utf8');\n  } catch {\n    try {\n      statSync(root);\n      return { ok: false, code: 'session_not_found' };\n    } catch {\n      return { ok: false, code: 'store_unreadable' };\n    }\n  }\n\n  const entries = [];\n  for (const line of raw.split('\\n')) {\n    if (!line.trim()) continue;\n    const parsed = parseJsonObject(line);\n    if (parsed) entries.push(parsed);\n  }\n\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"sed -n '195,235p' .skilled/hooks/shared/session-readers/claude.mjs\"}"},"time":{"start":1794680577601,"end":1794680578732}}}}
