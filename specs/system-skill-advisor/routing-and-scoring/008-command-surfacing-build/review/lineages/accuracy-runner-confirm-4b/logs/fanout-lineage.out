{"type":"tool_use","timestamp":1794680347697,"sessionID":"ses_e24b9ad86ffemxqRFlUJ7Tx0bg","part":{"partID":"prt_1db48d873001g3n3Kx7RgZAYz5","sessionID":"ses_e24b9ad86ffemxqRFlUJ7Tx0bg","messageID":"msg_1db48cdc30010uHudLE7BlGOYK","type":"tool","id":"call_7396212958bf438a9e2f5ed4","tool":"read","state":{"status":"completed","input":{"limit":70,"offset":70,"path":".skilled/hooks/shared/session-readers/identity.mjs"},"output":"Read file .skilled/hooks/shared/session-readers/identity.mjs, lines 70-138\n70:   return rel !== ''\n71:     && rel !== '..'\n72:     && !rel.startsWith('..' + sep)\n73:     && !isAbsolute(rel);\n74: }\n75: \n76: /**\n77:  * Whether `child` is `parent` or a folder below it, compared by real path. A\n78:  * runtime that hands its hooks the project root while recording the session's\n79:  * own subfolder still proves the session belongs to that checkout.\n80:  */\n81: export function atOrBelow(child, parent) {\n82:   if (samePath(child, parent)) return true;\n83:   if (typeof child !== 'string' || typeof parent !== 'string' || !child || !parent) return false;\n84:   try {\n85:     return inside(realpathSync(parent), realpathSync(child));\n86:   } catch {\n87:     return false;\n88:   }\n89: }\n90: \n91: // Resolve both spellings first, because a symlink inside the store can point\n92: // at a file outside it and a textual prefix check would accept it.\n93: export function resolveInside({ path, root }) {\n94:   if (typeof path !== 'string' || !path.trim()) {\n95:     return { ok: false, code: 'locator_unavailable' };\n96:   }\n97:   if (typeof root !== 'string' || !root.trim()) {\n98:     return { ok: false, code: 'store_unreadable' };\n99:   }\n100:   if (path.split(/[\\\\/]+/).includes('..')) {\n101:     return { ok: false, code: 'session_mismatch' };\n102:   }\n103: \n104:   let realRoot;\n105:   let realPath;\n106:   try {\n107:     realRoot = realpathSync(root);\n108:     realPath = realpathSync(path);\n109:   } catch {\n110:     return { ok: false, code: 'store_unreadable' };\n111:   }\n112: \n113:   if (!inside(realRoot, realPath)) {\n114:     return { ok: false, code: 'session_mismatch' };\n115:   }\n116:   return { ok: true, path: realPath };\n117: }\n118: \n119: // ─────────────────────────────────────────────────────────────────────────────\n120: // 6. FULL GUARD\n121: // ─────────────────────────────────────────────────────────────────────────────\n122: \n123: export function guardSessionPath({ path, root, sessionId, recordedId } = {}) {\n124:   if (typeof sessionId !== 'string' || !sessionId.trim()) {\n125:     return { ok: false, code: 'locator_unavailable' };\n126:   }\n127:   if (!isSafeSessionId(sessionId)) {\n128:     return { ok: false, code: 'session_mismatch' };\n129:   }\n130: \n131:   const contained = resolveInside({ path, root });\n132:   if (!contained.ok) return contained;\n133: \n134:   if (recordedId !== sessionId) {\n135:     return { ok: false, code: 'session_mismatch' };\n136:   }\n137:   return contained;\n138: }","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file .skilled/hooks/shared/session-readers/identity.mjs, lines 70-138\n70:   return rel !== ''\n71:     && rel !== '..'\n72:     && !rel.startsWith('..' + sep)\n73:     && !isAbsolute(rel);\n74: }\n75: \n76: /**\n77:  * Whether `child` is `parent` or a folder below it, compared by real path. A\n78:  * runtime that hands its hooks the project root while recording the session's\n79:  * own subfolder still proves the session belongs to that checkout.\n80:  */\n81: export function atOrBelow(child, parent) {\n82:   if (samePath(child, parent)) return true;\n83:   if (typeof child !== 'string' || typeof parent !== 'string' || !child || !parent) return false;\n84:   try {\n85:     return inside(realpathSync(parent), realpathSync(child));\n86:   } catch {\n87:     return false;\n88:   }\n89: }\n90: \n91: // Resolve both spellings first, because a symlink inside the store can point\n92: // at a file outside it and a textual prefix check would accept it.\n93: export function resolveInside({ path, root }) {\n94:   if (typeof path !== 'string' || !path.trim()) {\n95:     return { ok: false, code: 'locator_unavailable' };\n96:   }\n97:   if (typeof root !== 'string' || !root.trim()) {\n98:     return { ok: false, code: 'store_unreadable' };\n99:   }\n100:   if (path.split(/[\\\\/]+/).includes('..')) {\n101:     return { ok: false, code: 'session_mismatch' };\n102:   }\n103: \n104:   let realRoot;\n105:   let realPath;\n106:   try {\n107:     realRoot = realpathSync(root);\n108:     realPath = realpathSync(path);\n109:   } catch {\n110:     return { ok: false, code: 'store_unreadable' };\n111:   }\n112: \n113:   if (!inside(realRoot, realPath)) {\n114:     return { ok: false, code: 'session_mismatch' };\n115:   }\n116:   return { ok: true, path: realPath };\n117: }\n118: \n119: // ─────────────────────────────────────────────────────────────────────────────\n120: // 6. FULL GUARD\n121: // ─────────────────────────────────────────────────────────────────────────────\n122: \n123: export function guardSessionPath({ path, root, sessionId, recordedId } = {}) {\n124:   if (typeof sessionId !== 'string' || !sessionId.trim()) {\n125:     return { ok: false, code: 'locator_unavailable' };\n126:   }\n127:   if (!isSafeSessionId(sessionId)) {\n128:     return { ok: false, code: 'session_mismatch' };\n129:   }\n130: \n131:   const contained = resolveInside({ path, root });\n132:   if (!contained.ok) return contained;\n133: \n134:   if (recordedId !== sessionId) {\n135:     return { ok: false, code: 'session_mismatch' };\n136:   }\n137:   return contained;\n138: }"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"limit\":70,\"offset\":70,\"path\":\".skilled/hooks/shared/session-readers/identity.mjs\"}"},"time":{"start":1794680346739,"end":1794680347697}}}}
{"type":"tool_use","timestamp":1794680347726,"sessionID":"ses_e24b9ad86ffemxqRFlUJ7Tx0bg","part":{"partID":"prt_1db48da65001xNlJlmdKAO1EhP","sessionID":"ses_e24b9ad86ffemxqRFlUJ7Tx0bg","messageID":"msg_1db48cdc30010uHudLE7BlGOYK","type":"tool","id":"call_89098e7e37b24ef0a6568e36","tool":"read","state":{"status":"completed","input":{"limit":80,"offset":1150,"path":".skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/run-command-behaviour.mjs"},"output":"Read file .skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/run-command-behaviour.mjs, lines 1150-1229\n1150:   let reportedId = listed\n1151:     ? addedSessionId(listingBefore, listingAfter)\n1152:     : turn.streamId;\n1153:   // A DSH turn can add helper sessions to the store, so a difference of several\n1154:   // entries names no single session. The one its prompt opened is the turn's own.\n1155:   if (reportedId === null && job.runtime.locator.kind === 'store') {\n1156:     reportedId = await promptSessionId({\n1157:       before: listingBefore,\n1158:       after: listingAfter,\n1159:       prompt: job.prompt,\n1160:       firstUserText,\n1161:     });\n1162:   }\n1163: \n1164:   const after = { status: statusPaths(), ...gitSnapshot() };\n1165:   const headMoved = before.head !== after.head || before.stash !== after.stash;\n1166:   const changed = changedPaths(before.status, after.status);\n1167:   // The locator is kept in hand because the brief reader opens the same session\n1168:   // the line records, and resolving it twice could name a different file.\n1169:   const locator = locatorFor(job.runtime, sessionId, reportedId);\n1170:   const line = {\n1171:     runtime: job.runtimeName,\n1172:     rowId: job.rowId,\n1173:     arm: options.arm,\n1174:     locator,\n1175:     ...(job.fixture === undefined ? {} : { fixture: job.fixture }),\n1176:     exit: turn.exit,\n1177:     changedPaths: changed,\n1178:   };\n1179: \n1180:   if (headMoved) {\n1181:     // The worktree the restore was written for is gone. Restoring now could discard\n1182:     // whatever the commit or stash brought in, so the paths stay listed instead.\n1183:     appendRunLine(options.out, { ...line, restored: false, headMoved: true });\n1184:     return { status: EXIT_HEAD_MOVED, refusal: { ok: false, code: 'head_moved', rowId: job.rowId } };\n1185:   }\n1186: \n1187:   // A dry run spawns nothing, so an unchanged worktree is the only thing it can\n1188:   // honestly report as left as found.\n1189:   const restore = options.dryRun ? null : restoreTurn({ cwd: REPO_ROOT, before: before.status });\n1190:   const restored = options.dryRun ? changed.length === 0 : restore.restored;\n1191:   // The head the reader saw is the only place the offer was named, and not every\n1192:   // runtime keeps it, so the offer is replayed after the turn. A dry run still\n1193:   // replays it, which lets an operator read the offer without paying for a model\n1194:   // call, while the brief stays `unknown` because no session exists to read.\n1195:   const offer = replayOffer({ checkoutDir: PROJECT_DIR, prompt: job.prompt, sessionId });\n1196:   // Pi, Devin and DSH keep the brief in their session store rather than in the\n1197:   // turn records, so the delivery check needs the reader that opens that store.\n1198:   const delivered = options.dryRun\n1199:     ? 'unknown'\n1200:     : await briefDelivered({ runtime: job.runtimeName, locator, loadSession: loadSharedSession });\n1201:   appendRunLine(options.out, {\n1202:     ...line,\n1203:     ...offerLineFields(offer),\n1204:     briefDelivered: delivered,\n1205:     restored,\n1206:     ...(restore !== null && restore.leftoverPaths.length > 0\n1207:       ? { leftoverPaths: restore.leftoverPaths }\n1208:       : {}),\n1209:   });\n1210: \n1211:   if (turn.error !== null) {\n1212:     const detail = turn.error.message;\n1213:     return { status: 1, refusal: { ok: false, code: 'spawn_failed', runtime: job.runtimeName, detail } };\n1214:   }\n1215:   if (!restored) {\n1216:     return {\n1217:       status: 1,\n1218:       refusal: {\n1219:         ok: false,\n1220:         code: 'restore_failed',\n1221:         rowId: job.rowId,\n1222:         paths: changed,\n1223:         ...(restore === null ? {} : { leftoverPaths: restore.leftoverPaths }),\n1224:       },\n1225:     };\n1226:   }\n1227:   return { status: 0, refusal: null };\n1228: }\n1229: \n[Output truncated. Continue reading with offset: 1230]","title":"read","metadata":{"metadata":{"truncated":true},"content":[{"type":"text","text":"Read file .skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/run-command-behaviour.mjs, lines 1150-1229\n1150:   let reportedId = listed\n1151:     ? addedSessionId(listingBefore, listingAfter)\n1152:     : turn.streamId;\n1153:   // A DSH turn can add helper sessions to the store, so a difference of several\n1154:   // entries names no single session. The one its prompt opened is the turn's own.\n1155:   if (reportedId === null && job.runtime.locator.kind === 'store') {\n1156:     reportedId = await promptSessionId({\n1157:       before: listingBefore,\n1158:       after: listingAfter,\n1159:       prompt: job.prompt,\n1160:       firstUserText,\n1161:     });\n1162:   }\n1163: \n1164:   const after = { status: statusPaths(), ...gitSnapshot() };\n1165:   const headMoved = before.head !== after.head || before.stash !== after.stash;\n1166:   const changed = changedPaths(before.status, after.status);\n1167:   // The locator is kept in hand because the brief reader opens the same session\n1168:   // the line records, and resolving it twice could name a different file.\n1169:   const locator = locatorFor(job.runtime, sessionId, reportedId);\n1170:   const line = {\n1171:     runtime: job.runtimeName,\n1172:     rowId: job.rowId,\n1173:     arm: options.arm,\n1174:     locator,\n1175:     ...(job.fixture === undefined ? {} : { fixture: job.fixture }),\n1176:     exit: turn.exit,\n1177:     changedPaths: changed,\n1178:   };\n1179: \n1180:   if (headMoved) {\n1181:     // The worktree the restore was written for is gone. Restoring now could discard\n1182:     // whatever the commit or stash brought in, so the paths stay listed instead.\n1183:     appendRunLine(options.out, { ...line, restored: false, headMoved: true });\n1184:     return { status: EXIT_HEAD_MOVED, refusal: { ok: false, code: 'head_moved', rowId: job.rowId } };\n1185:   }\n1186: \n1187:   // A dry run spawns nothing, so an unchanged worktree is the only thing it can\n1188:   // honestly report as left as found.\n1189:   const restore = options.dryRun ? null : restoreTurn({ cwd: REPO_ROOT, before: before.status });\n1190:   const restored = options.dryRun ? changed.length === 0 : restore.restored;\n1191:   // The head the reader saw is the only place the offer was named, and not every\n1192:   // runtime keeps it, so the offer is replayed after the turn. A dry run still\n1193:   // replays it, which lets an operator read the offer without paying for a model\n1194:   // call, while the brief stays `unknown` because no session exists to read.\n1195:   const offer = replayOffer({ checkoutDir: PROJECT_DIR, prompt: job.prompt, sessionId });\n1196:   // Pi, Devin and DSH keep the brief in their session store rather than in the\n1197:   // turn records, so the delivery check needs the reader that opens that store.\n1198:   const delivered = options.dryRun\n1199:     ? 'unknown'\n1200:     : await briefDelivered({ runtime: job.runtimeName, locator, loadSession: loadSharedSession });\n1201:   appendRunLine(options.out, {\n1202:     ...line,\n1203:     ...offerLineFields(offer),\n1204:     briefDelivered: delivered,\n1205:     restored,\n1206:     ...(restore !== null && restore.leftoverPaths.length > 0\n1207:       ? { leftoverPaths: restore.leftoverPaths }\n1208:       : {}),\n1209:   });\n1210: \n1211:   if (turn.error !== null) {\n1212:     const detail = turn.error.message;\n1213:     return { status: 1, refusal: { ok: false, code: 'spawn_failed', runtime: job.runtimeName, detail } };\n1214:   }\n1215:   if (!restored) {\n1216:     return {\n1217:       status: 1,\n1218:       refusal: {\n1219:         ok: false,\n1220:         code: 'restore_failed',\n1221:         rowId: job.rowId,\n1222:         paths: changed,\n1223:         ...(restore === null ? {} : { leftoverPaths: restore.leftoverPaths }),\n1224:       },\n1225:     };\n1226:   }\n1227:   return { status: 0, refusal: null };\n1228: }\n1229: \n[Output truncated. Continue reading with offset: 1230]"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"limit\":80,\"offset\":1150,\"path\":\".skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/run-command-behaviour.mjs\"}"},"time":{"start":1794680347237,"end":1794680347726}}}}
{"type":"step_finish","timestamp":1794680348977,"sessionID":"ses_e24b9ad86ffemxqRFlUJ7Tx0bg","part":{"id":"prt_1db48e131001PsntBKO1zv3Bng","sessionID":"ses_e24b9ad86ffemxqRFlUJ7Tx0bg","messageID":"msg_1db48cdc30010uHudLE7BlGOYK","type":"step-finish","reason":"tool-calls","snapshot":"6aa2be5a0392c9e9abc181585938b61945ab33fd","cost":0,"tokens":{"input":3402,"output":170,"reasoning":0,"cache":{"read":126976,"write":0}}}}
{"type":"step_start","timestamp":1794680352271,"sessionID":"ses_e24b9ad86ffemxqRFlUJ7Tx0bg","part":{"id":"prt_1db48ee0f001XIIgDCo6vgqw5d","sessionID":"ses_e24b9ad86ffemxqRFlUJ7Tx0bg","messageID":"msg_1db48e135001ouOWWqFnXeXZ03","type":"step-start","snapshot":"6aa2be5a0392c9e9abc181585938b61945ab33fd"}}
{"type":"tool_use","timestamp":1794680355598,"sessionID":"ses_e24b9ad86ffemxqRFlUJ7Tx0bg","part":{"partID":"prt_1db48f9a5001LbWe3jlue0IXPp","sessionID":"ses_e24b9ad86ffemxqRFlUJ7Tx0bg","messageID":"msg_1db48e135001ouOWWqFnXeXZ03","type":"tool","id":"call_738ac1a9a2e14f6a96ce5310","tool":"shell","state":{"status":"completed","input":{"command":"sed -n '55,130p' .skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/README.md"},"output":"## 3. FEATURES\n\n| Feature | What It Does |\n|---|---|\n| Folder boundary | Documents direct code files under `runtime/scripts/routing-accuracy`. |\n| sk-code alignment | Points reviewers at OpenCode naming, header, error-handling and type-discipline checks. |\n| Verification handoff | Records the expected owner and audit packet for follow-up work. |\n\n### Attribution on every run line\n\nEach line a behaviour run appends carries four fields beside the locator, exit and changed paths:\n\n- `offeredCommand` is the slash command the advisor head named, or `null` when the head named none.\n- `offeredPolicy` is the policy that directly follows that command, one of `run`, `start` or `ask`, or `null` when no policy follows it.\n- `offeredAs` says where that command sat in the head: `head`, `partner` when it followed `vs` on an ambiguous head, or `null` when the head named none.\n- `briefDelivered` says whether the advisor brief reached the session. It is `true` or `false` where the runtime keeps a readable record, and `unknown` where none exists or cannot be read, so a gap in the record never reads as a miss.\n\nThe offer is a replay of the Claude prompt hook after the turn instead of a copy of the live session head. The head is the only text that names both the command and the policy, and not every runtime keeps it, so `replayOffer` runs the checkout's own hook and records what that checkout would have offered at the time of the run. A replay that finds no hook, a failing hook or a head without an offer writes null fields plus an `offerError` of `hook_missing`, `hook_failed` or `no_head`, so one bad line never aborts a run.\n\n### Backfill a finished log\n\n`run-command-behaviour.mjs --backfill <run-log> --out <new-log>` adds those three fields to a log written before they existed, and a `--backfill` run without `--out` is a usage error that exits 2. The mode refuses with exit 2 and a JSON body holding its `code`:\n\n- `same_path` when `--out` resolves to the input log, because the backfill writes a new file.\n- `holdout_row` or `unknown_row` when the corpus refuses a row id, because every prompt is resolved before the first line is written and a refused row leaves no output file behind.\n\nA line whose locator names no checkout keeps null offer fields and `offerError` `no_checkout`, and the rest of the log is still written with `offerBackfilled: true`.\n\nA line whose checkout is neither this project root nor an arena holding the `skilled-behaviour-arena` marker also keeps null offer fields, with `offerError` `untrusted_checkout`, because a run log is input and the folder it names may hold any code. Nothing from that folder runs, and the rest of the log is still written.\n\n`--brief-only` keeps every offer field exactly as the input line holds it, present or absent, and recomputes only `briefDelivered`, because a recorded offer belongs to the head the turn saw and replaying it would describe a different head. Brief delivery now comes from the session records of Pi, Devin, DSH and Codex, while OpenCode stays `unknown` because its plugin adds the brief in memory and the store keeps no copy.\n\n### The typed attachment block\n\n`capture-command-routing-baseline.mjs` reports typed reach twice under `attachedMetrics`:\n\n- `attachedMetrics.typed` counts `own`, `attached`, `combined` and `total` across the typed rows. `own` is a row the ranked bridge already landed, `attached` is a row the typed command itself delivered, and `combined` is their sum.\n- `attachedMetrics.typedRows` keys one record per typed row id in sorted order with `expected_command`, `top`, `carried`, `command` and `policy`. `carried` is `own`, `attached` or null, so a missed row names the command it did carry instead of only lowering a count.\n\nA typed command travels on its owner. It is delivered only when the leading recommendation is that command's owner skill or carries the same command row, so an unrelated leading skill never presents it. A typed command with no scorer row of its own has no other path to the reader, so its owner is ranked first.\n\n### Measure the brief cost\n\n`.skilled/skills/system-skill-advisor/runtime/scripts/measure-brief-cost.mjs` reports what the Claude prompt hook actually sends the model for a typed row.\n\n- Flags: `node measure-brief-cost.mjs [--rows <id,id>] [--root <dir>]` keeps every typed row on the `none` split, `--rows` narrows the run to named corpus ids and `--root` names the checkout the corpus and hook are read from, defaulting to the current directory. A holdout or unknown id exits 2 before anything is spawned, and no prompt is ever printed.\n- Output keys: one JSON object holds `rows`, then `liveRows`, `totalBytes`, `medianBytes`, `maxBytes`, `medianHeadBytes` and `maxHeadBytes`. Each entry of `rows` carries `id`, `bytes`, `headBytes`, `estimatedTokens` and `live`, where bytes are the UTF-8 length of `hookSpecificOutput.additionalContext`, headBytes is the UTF-8 length of its first line, live says whether that first line starts `Advisor: live`, and tokens divide the context bytes by four, the renderer's own characters per token. Every byte statistic is taken over live rows only.\n- Refusal: a run with no live head prints `{\"error\":\"degraded_brief\",...}` and exits 2, which happens when the sandboxed hook cannot reach a live advisor.\n- Sandbox: the run makes one `ssa-cost-` directory under the OS temp dir and sets `SPECKIT_IPC_SOCKET_DIR` to it for every hook process, so the operator's warm daemon is never reached. Each hook process also runs without `AI_SESSION_CHILD`, so a run from a dispatched worker measures the brief an operator's own session receives rather than the child form. Each hook child runs with `TMPDIR` set to the sandbox, so a cost run writes no health record into the shared metrics folder. At the end it stops only a process whose command line names that directory and removes it.\n\n### Reading the outcome\n\n- A loaded document is not a followed step, so `loadRate` and `followedRange` say a workflow opened, not that its steps were taken.\n- The behaviour rows are tuned rows, so `followedOffered` and `followedNotOffered` describe the corpus the brief was built against, not a fresh one.\n- Each row ran once, so one run moves a rate by more than the range around it can settle.\n- Two arms differ in more than the brief, so a `--pair` gain or loss is not the brief's effect alone.\n- The offer on a stored run of a runtime other than Claude is the Claude hook's replay, recorded when the run was made, so the split by offer says what the Claude head carried for that row.\n\n---\n\n## 4. STRUCTURE\n\n| Path | Purpose |\n|---|---|\n| `gate3-corpus-runner.mjs` | MJS source file in this folder. |\n| `score-routing-corpus.py` | PY source file in this folder. |\n| `command-prompts.jsonl` | Prompt corpus with a gold slash command per row, covering every tracked command. |\n| `capture-command-routing-baseline.mjs` | Scores `command-prompts.jsonl` under the pinned regime and prints or writes the baseline. Its `attachedMetrics` key holds own-row, attached and combined plain reach per split and per command family, attached false offers, the typed rows where a command and its owner skill read as ambiguous, and the command attached to each published row. An attached hit counts only on a row the ranked bridge did not already land. Its `rows`, `attachedRows` and `typedRows` maps leave out every holdout row, so only holdout counts are published. The optional `--real-embedding` flag scores the same corpus against this machine's own skill graph database and live embedder in place of the fixture vectors and word overlap the default run substitutes, so its numbers describe an environment rather than a reproducible projection. It refuses `--write` because the committed baseline comes only from the fixture regime. Before scoring it proves two things, that a live embedder answers and serves the `nomic-embed-text` model family the stored vectors were built with, and that the skill graph database holds a populated `vec_cmd_*` command vector table. A missing piece exits 2 with a message that names it. Each row in its `rows` output also carries `offered`, which is true when any of the top three recommendations maps to a command bridge, so it measures reach rather than whether a brief head offered the command. Its `attachedMetrics.needs_mode_floor` counts the silent rows whose head would read `(needs a mode)`, and `needsModeRows` lists every row id whose head would, which happens only when the prompt names the hub that tops it. `attachedMetrics.plain_stages` holds one entry per plain split with seven counts, `total`, `own`, `ownerLed`, `routed`, `withCommand`, `attached` and `neither`, where `own`, `ownerLed` and `neither` split the rows and the counted stages nest from `ownerLed` down to `attached`. `attachedMetrics.fit` holds the two fit classes, `skillOnly` and `decline`, each with `carried` and `total`, and `decline` also carries `byKind` for its decline kinds, so a fit row is counted apart from every recall, reach, silence and agreement tally and reaches no row map. A fit row is frozen once captured, and no later edit, replacement or removal is allowed. Three of the eight slash-variant rows that name a command ask a question about it, and a question about a command carries no command by design, so `slash_variant.reached_top3` can reach 5 of 8. |\n| `score-command-transcripts.mjs` | Scores captured sessions through the shared session readers. `--summary <run-log> [<run-log>...]` scores every row one or more run logs list, per runtime and arm, and `--runtime <name> --locator '<json>'` scores the one session a locator names. `--row-id <id>` narrows `--summary` to one row and is a usage error with `--runtime`. `--json` prints machine-readable output. `--pair <from>,<to>` compares two arms of one summary run row by row and adds a `paired` block, holding `from`, `to`, `rows`, `gained`, `lost`, `bothFollowed` and `neitherFollowed`, to a runtime that scored both arms, and the text output prints one `paired` line for it. `--pair` without `--summary` exits 2 with `--pair needs --summary`, and one arm name exits 2 with `--pair needs two arm names`. Each per-arm block reports `startRate`, `cappedStartRows`, `offered`, `cappedOfferRows`, `startedOfOffered`, `offerReached`, `deliveryUnknown`, `offerSeen`, `offerDeclined`, `offerFieldAbsent`, `unsafe`, `unsafeNoChangedPath`, `armIncomplete`, `byPolicy` and `workflow`, where `byPolicy` holds a `run`, `start` and `ask` tally of rows, capped rows, started rows and rows that wrote. The `workflow` block sorts each run into `command`, `skill`, `improvised`, `none` or `noOwner` and prints `share` as the runs that loaded the command's or the owning skill's own workflow before their first write, out of every run that acted. It shows a workflow was loaded, not that each step was followed. The block also carries `noneActed`, the `none` runs that read a file or ran a shell step, and `loadRate`, the runs that loaded the command's or the owning skill's workflow out of every scored run with an owner, which is the outcome reading because a run that skipped the workflow and wrote nothing cannot leave its count. The block also holds `asked`, an ask row whose run offered the command and wrote nothing, `askedActed`, the `asked` runs that also worked the task before they asked, `otherMode`, a load of a different mode under the owning hub, and `followedRate`, which is `command + skill + asked` over every owned scored run. `loadRate` has the same denominator, the six path counts, so no owned scored run leaves it. `followedRange` and `loadRange` sit beside those two rates as their Wilson interval at 1.96, rounded to two decimals and clamped to 0 and 1, so a small arm is not read as a precise rate, and both are null when the denominator is zero. `followedOffered` and `followedNotOffered` read the same followed count inside each group the offer puts a run in, and `offerUnknown` counts an owned run whose line holds no offer field, so a gap in the record is never read as no offer. A load is a read tool, a skill tool, a shell command that reads the file or a `prompts/<namespace>-<name>.md` mirror, and a write outside the run's checkout sets no boundary. A Codex shell step arrives as the JavaScript body of an `exec` call, and its command is the `cmd` strings of that body, one per line. A body that holds a gate lookup and a task command reads as a gate step. A search with `rg` or `grep` is not a load, a line inside a heredoc is not a command, and a bare document name is read in the folder an earlier `cd` of the same command entered. A start and a loop the run took are read from the same reads a load is, so a `cat` of the command's document counts and a search, an in-place `sed` or a heredoc line does not. A heredoc's end word may hold a hyphen or a dot. A command that sat on the partner side of an ambiguous head is counted in `offeredAsPartner` and not in `offered`. A stored run line holds no `offeredAs`, so its offer counts as before. The rate counts a workflow opened before the first write, not each step followed, on tuned rows with one run each. `cappedOfferRows` counts offers whose turn hit its cap, `offerReached` counts offers whose brief was not shown missing, so a row whose brief state is unknown counts, `deliveryUnknown` counts every run line whose brief state is `unknown`, scored or not, `offerSeen` and `offerDeclined` read the session's `COMMAND:` lines, and `offerFieldAbsent` counts rows that carry no offer field. `unsafe` also counts a workflow loop that started without its init, `unsafeNoChangedPath` counts the unsafe runs whose run line lists no changed path, apart from a loop without init, and a Claude turn that keeps only the `<command-name>` tag of a typed command counts as a start because Claude Code expands that command before the model sees it. A write to a git-ignored path or one the model reverted itself also leaves no changed path. The text output prints one `policy` line per policy under each arm. Exit 2 means nothing was scored: bad flags, a missing or malformed run log (`run_log_missing`, `run_log_malformed`), or a reader refusal printed with its own code such as `capability_gated` or `locator_unavailable`. |\n| `command-offer.mjs` | Recovers the attribution fields for a run line. `parseOffer` reads the command and policy out of one head, `replayOffer` replays a checkout's Claude prompt hook after the turn, `briefDelivered` reads the session record, and `backfillRunLog` writes the fields onto a finished log with a refusal code for a holdout, unknown or same-path input, after `trustedCheckout` confirms each line's checkout is the project root or a marked arena. Each offer carries `offeredAs`, `head` or `partner`. A fallback head such as `Advisor: no skill matched.` counts as a delivered brief with a null offer, and a head quoted inside a tool result does not count. The offer on a stored run of a runtime other than Claude is the Claude hook's replay, recorded when the run was made, and no rescore rewrites it. |\n| `run-command-behaviour.mjs` | Runs one live turn per row and records the locator, exit and changed paths. `--print-argv <runtime>` prints a runtime's argv, `--list <set>` prints a set's row ids, and a run takes `--runtime` with `--set` or repeated `--row-id`, `--out <run-log>`, optional `--arm`, `--fixture` and `--dry-run`. Without `--arm`, a selection whose ids are all started-command rows runs under arm `g2`, one that holds none runs under `pre` and a mix is refused with `mixed_row_arms`. Each `g2` run line records the `fixture` folder its prompt named, and `--backfill` replays that folder, or `g2-fixture` beside the log for a line that holds none. `--backfill <run-log> --out <new-log> [--brief-only]` rewrites a finished log with `offeredCommand`, `offeredPolicy` and `briefDelivered` instead of running a turn, and prints a JSON refusal with `same_path`, `holdout_row` or `unknown_row` when it cannot. After each turn it restores the checkout to HEAD and reports any `leftoverPaths` whose status still differs from the snapshot taken before the turn. Exit 3 (`head_moved`) ends the arm without that restore, because a commit or a stash made during the turn is not the runner's to discard, so the line records `restored: false` and the changed paths stay listed. A live turn gets only the allowlisted environment, the shell basics, the locale and XDG prefixes, each runtime's own prefixes and the Skilled switch prefixes, plus the GitHub and git overrides, so no GitHub token or git credential helper from the operator's shell reaches it. Exit 2 refuses instead of running: bad flags, an unknown runtime or set, a holdout or unknown row, a set with fewer rows than it needs (`set_short`), a dirty worktree outside the run log's folder (`worktree_dirty`), a checkout with a git remote (`remote_present`), a checkout without the arena builder's marker (`arena_unprepared`), a selection that mixes started-command rows with others (`mixed_row_arms`), or a Codex arm whose project hook is unapproved (`codex-hooks-unapproved`). |\n| `command-routing-baseline.json` | Captured command routing numbers that `tests/command-routing-slice.vitest.ts` holds the scorer to. |\n| `build-holdout.mjs` | Builds the frozen holdout from three separately authored fixtures that are disjoint from the labeled corpus, copying each row's own label and keeping its provenance in `source_type` and `origin_fixture`. Family-normalized dedup keeps the first occurrence and drops any prompt that collides with the training corpus. `--write` rewrites `holdout-prompts.jsonl`. |\n| `capture-local-native-divergence-ledger.mjs` | Recomputes the strict Python/native top-1 divergence set the ratchet replays. An existing approval is kept only while its prompt hash and both current tops still match, so the output is a capture of live scoring rather than a hand-edited fixture. Scores both scorers against a skill graph indexed fresh into a temporary directory with the clock pinned to the capture day, and `--write` records the result. |\n| `capture-scorer-eval-baseline.mjs` | Captures scorer accuracy across the full corpus, the independent holdout, the frozen ambiguity slice and the named intent buckets under the reproducible filesystem projection, then `--write` records `scorer-eval-baseline.json`. Fixture hashes pin the baseline to the exact corpora it was captured against, so editing a fixture forces a conscious re-capture. `--misses` prints one failing prompt per line. |\n| `derive-ambiguity-slice.mjs` | Derives the frozen ambiguity slice as the corpus rows whose top-2 fused-score margin is at or below `tau`, keeping each row's existing gold label, so a regression that only hurts contested prompts still fails a gate. `--write` rewrites `ambiguity-prompts.jsonl`, and the frozen `margin_at_capture` documents why a row is in the slice without being trusted by the gate. |\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"## 3. FEATURES\n\n| Feature | What It Does |\n|---|---|\n| Folder boundary | Documents direct code files under `runtime/scripts/routing-accuracy`. |\n| sk-code alignment | Points reviewers at OpenCode naming, header, error-handling and type-discipline checks. |\n| Verification handoff | Records the expected owner and audit packet for follow-up work. |\n\n### Attribution on every run line\n\nEach line a behaviour run appends carries four fields beside the locator, exit and changed paths:\n\n- `offeredCommand` is the slash command the advisor head named, or `null` when the head named none.\n- `offeredPolicy` is the policy that directly follows that command, one of `run`, `start` or `ask`, or `null` when no policy follows it.\n- `offeredAs` says where that command sat in the head: `head`, `partner` when it followed `vs` on an ambiguous head, or `null` when the head named none.\n- `briefDelivered` says whether the advisor brief reached the session. It is `true` or `false` where the runtime keeps a readable record, and `unknown` where none exists or cannot be read, so a gap in the record never reads as a miss.\n\nThe offer is a replay of the Claude prompt hook after the turn instead of a copy of the live session head. The head is the only text that names both the command and the policy, and not every runtime keeps it, so `replayOffer` runs the checkout's own hook and records what that checkout would have offered at the time of the run. A replay that finds no hook, a failing hook or a head without an offer writes null fields plus an `offerError` of `hook_missing`, `hook_failed` or `no_head`, so one bad line never aborts a run.\n\n### Backfill a finished log\n\n`run-command-behaviour.mjs --backfill <run-log> --out <new-log>` adds those three fields to a log written before they existed, and a `--backfill` run without `--out` is a usage error that exits 2. The mode refuses with exit 2 and a JSON body holding its `code`:\n\n- `same_path` when `--out` resolves to the input log, because the backfill writes a new file.\n- `holdout_row` or `unknown_row` when the corpus refuses a row id, because every prompt is resolved before the first line is written and a refused row leaves no output file behind.\n\nA line whose locator names no checkout keeps null offer fields and `offerError` `no_checkout`, and the rest of the log is still written with `offerBackfilled: true`.\n\nA line whose checkout is neither this project root nor an arena holding the `skilled-behaviour-arena` marker also keeps null offer fields, with `offerError` `untrusted_checkout`, because a run log is input and the folder it names may hold any code. Nothing from that folder runs, and the rest of the log is still written.\n\n`--brief-only` keeps every offer field exactly as the input line holds it, present or absent, and recomputes only `briefDelivered`, because a recorded offer belongs to the head the turn saw and replaying it would describe a different head. Brief delivery now comes from the session records of Pi, Devin, DSH and Codex, while OpenCode stays `unknown` because its plugin adds the brief in memory and the store keeps no copy.\n\n### The typed attachment block\n\n`capture-command-routing-baseline.mjs` reports typed reach twice under `attachedMetrics`:\n\n- `attachedMetrics.typed` counts `own`, `attached`, `combined` and `total` across the typed rows. `own` is a row the ranked bridge already landed, `attached` is a row the typed command itself delivered, and `combined` is their sum.\n- `attachedMetrics.typedRows` keys one record per typed row id in sorted order with `expected_command`, `top`, `carried`, `command` and `policy`. `carried` is `own`, `attached` or null, so a missed row names the command it did carry instead of only lowering a count.\n\nA typed command travels on its owner. It is delivered only when the leading recommendation is that command's owner skill or carries the same command row, so an unrelated leading skill never presents it. A typed command with no scorer row of its own has no other path to the reader, so its owner is ranked first.\n\n### Measure the brief cost\n\n`.skilled/skills/system-skill-advisor/runtime/scripts/measure-brief-cost.mjs` reports what the Claude prompt hook actually sends the model for a typed row.\n\n- Flags: `node measure-brief-cost.mjs [--rows <id,id>] [--root <dir>]` keeps every typed row on the `none` split, `--rows` narrows the run to named corpus ids and `--root` names the checkout the corpus and hook are read from, defaulting to the current directory. A holdout or unknown id exits 2 before anything is spawned, and no prompt is ever printed.\n- Output keys: one JSON object holds `rows`, then `liveRows`, `totalBytes`, `medianBytes`, `maxBytes`, `medianHeadBytes` and `maxHeadBytes`. Each entry of `rows` carries `id`, `bytes`, `headBytes`, `estimatedTokens` and `live`, where bytes are the UTF-8 length of `hookSpecificOutput.additionalContext`, headBytes is the UTF-8 length of its first line, live says whether that first line starts `Advisor: live`, and tokens divide the context bytes by four, the renderer's own characters per token. Every byte statistic is taken over live rows only.\n- Refusal: a run with no live head prints `{\"error\":\"degraded_brief\",...}` and exits 2, which happens when the sandboxed hook cannot reach a live advisor.\n- Sandbox: the run makes one `ssa-cost-` directory under the OS temp dir and sets `SPECKIT_IPC_SOCKET_DIR` to it for every hook process, so the operator's warm daemon is never reached. Each hook process also runs without `AI_SESSION_CHILD`, so a run from a dispatched worker measures the brief an operator's own session receives rather than the child form. Each hook child runs with `TMPDIR` set to the sandbox, so a cost run writes no health record into the shared metrics folder. At the end it stops only a process whose command line names that directory and removes it.\n\n### Reading the outcome\n\n- A loaded document is not a followed step, so `loadRate` and `followedRange` say a workflow opened, not that its steps were taken.\n- The behaviour rows are tuned rows, so `followedOffered` and `followedNotOffered` describe the corpus the brief was built against, not a fresh one.\n- Each row ran once, so one run moves a rate by more than the range around it can settle.\n- Two arms differ in more than the brief, so a `--pair` gain or loss is not the brief's effect alone.\n- The offer on a stored run of a runtime other than Claude is the Claude hook's replay, recorded when the run was made, so the split by offer says what the Claude head carried for that row.\n\n---\n\n## 4. STRUCTURE\n\n| Path | Purpose |\n|---|---|\n| `gate3-corpus-runner.mjs` | MJS source file in this folder. |\n| `score-routing-corpus.py` | PY source file in this folder. |\n| `command-prompts.jsonl` | Prompt corpus with a gold slash command per row, covering every tracked command. |\n| `capture-command-routing-baseline.mjs` | Scores `command-prompts.jsonl` under the pinned regime and prints or writes the baseline. Its `attachedMetrics` key holds own-row, attached and combined plain reach per split and per command family, attached false offers, the typed rows where a command and its owner skill read as ambiguous, and the command attached to each published row. An attached hit counts only on a row the ranked bridge did not already land. Its `rows`, `attachedRows` and `typedRows` maps leave out every holdout row, so only holdout counts are published. The optional `--real-embedding` flag scores the same corpus against this machine's own skill graph database and live embedder in place of the fixture vectors and word overlap the default run substitutes, so its numbers describe an environment rather than a reproducible projection. It refuses `--write` because the committed baseline comes only from the fixture regime. Before scoring it proves two things, that a live embedder answers and serves the `nomic-embed-text` model family the stored vectors were built with, and that the skill graph database holds a populated `vec_cmd_*` command vector table. A missing piece exits 2 with a message that names it. Each row in its `rows` output also carries `offered`, which is true when any of the top three recommendations maps to a command bridge, so it measures reach rather than whether a brief head offered the command. Its `attachedMetrics.needs_mode_floor` counts the silent rows whose head would read `(needs a mode)`, and `needsModeRows` lists every row id whose head would, which happens only when the prompt names the hub that tops it. `attachedMetrics.plain_stages` holds one entry per plain split with seven counts, `total`, `own`, `ownerLed`, `routed`, `withCommand`, `attached` and `neither`, where `own`, `ownerLed` and `neither` split the rows and the counted stages nest from `ownerLed` down to `attached`. `attachedMetrics.fit` holds the two fit classes, `skillOnly` and `decline`, each with `carried` and `total`, and `decline` also carries `byKind` for its decline kinds, so a fit row is counted apart from every recall, reach, silence and agreement tally and reaches no row map. A fit row is frozen once captured, and no later edit, replacement or removal is allowed. Three of the eight slash-variant rows that name a command ask a question about it, and a question about a command carries no command by design, so `slash_variant.reached_top3` can reach 5 of 8. |\n| `score-command-transcripts.mjs` | Scores captured sessions through the shared session readers. `--summary <run-log> [<run-log>...]` scores every row one or more run logs list, per runtime and arm, and `--runtime <name> --locator '<json>'` scores the one session a locator names. `--row-id <id>` narrows `--summary` to one row and is a usage error with `--runtime`. `--json` prints machine-readable output. `--pair <from>,<to>` compares two arms of one summary run row by row and adds a `paired` block, holding `from`, `to`, `rows`, `gained`, `lost`, `bothFollowed` and `neitherFollowed`, to a runtime that scored both arms, and the text output prints one `paired` line for it. `--pair` without `--summary` exits 2 with `--pair needs --summary`, and one arm name exits 2 with `--pair needs two arm names`. Each per-arm block reports `startRate`, `cappedStartRows`, `offered`, `cappedOfferRows`, `startedOfOffered`, `offerReached`, `deliveryUnknown`, `offerSeen`, `offerDeclined`, `offerFieldAbsent`, `unsafe`, `unsafeNoChangedPath`, `armIncomplete`, `byPolicy` and `workflow`, where `byPolicy` holds a `run`, `start` and `ask` tally of rows, capped rows, started rows and rows that wrote. The `workflow` block sorts each run into `command`, `skill`, `improvised`, `none` or `noOwner` and prints `share` as the runs that loaded the command's or the owning skill's own workflow before their first write, out of every run that acted. It shows a workflow was loaded, not that each step was followed. The block also carries `noneActed`, the `none` runs that read a file or ran a shell step, and `loadRate`, the runs that loaded the command's or the owning skill's workflow out of every scored run with an owner, which is the outcome reading because a run that skipped the workflow and wrote nothing cannot leave its count. The block also holds `asked`, an ask row whose run offered the command and wrote nothing, `askedActed`, the `asked` runs that also worked the task before they asked, `otherMode`, a load of a different mode under the owning hub, and `followedRate`, which is `command + skill + asked` over every owned scored run. `loadRate` has the same denominator, the six path counts, so no owned scored run leaves it. `followedRange` and `loadRange` sit beside those two rates as their Wilson interval at 1.96, rounded to two decimals and clamped to 0 and 1, so a small arm is not read as a precise rate, and both are null when the denominator is zero. `followedOffered` and `followedNotOffered` read the same followed count inside each group the offer puts a run in, and `offerUnknown` counts an owned run whose line holds no offer field, so a gap in the record is never read as no offer. A load is a read tool, a skill tool, a shell command that reads the file or a `prompts/<namespace>-<name>.md` mirror, and a write outside the run's checkout sets no boundary. A Codex shell step arrives as the JavaScript body of an `exec` call, and its command is the `cmd` strings of that body, one per line. A body that holds a gate lookup and a task command reads as a gate step. A search with `rg` or `grep` is not a load, a line inside a heredoc is not a command, and a bare document name is read in the folder an earlier `cd` of the same command entered. A start and a loop the run took are read from the same reads a load is, so a `cat` of the command's document counts and a search, an in-place `sed` or a heredoc line does not. A heredoc's end word may hold a hyphen or a dot. A command that sat on the partner side of an ambiguous head is counted in `offeredAsPartner` and not in `offered`. A stored run line holds no `offeredAs`, so its offer counts as before. The rate counts a workflow opened before the first write, not each step followed, on tuned rows with one run each. `cappedOfferRows` counts offers whose turn hit its cap, `offerReached` counts offers whose brief was not shown missing, so a row whose brief state is unknown counts, `deliveryUnknown` counts every run line whose brief state is `unknown`, scored or not, `offerSeen` and `offerDeclined` read the session's `COMMAND:` lines, and `offerFieldAbsent` counts rows that carry no offer field. `unsafe` also counts a workflow loop that started without its init, `unsafeNoChangedPath` counts the unsafe runs whose run line lists no changed path, apart from a loop without init, and a Claude turn that keeps only the `<command-name>` tag of a typed command counts as a start because Claude Code expands that command before the model sees it. A write to a git-ignored path or one the model reverted itself also leaves no changed path. The text output prints one `policy` line per policy under each arm. Exit 2 means nothing was scored: bad flags, a missing or malformed run log (`run_log_missing`, `run_log_malformed`), or a reader refusal printed with its own code such as `capability_gated` or `locator_unavailable`. |\n| `command-offer.mjs` | Recovers the attribution fields for a run line. `parseOffer` reads the command and policy out of one head, `replayOffer` replays a checkout's Claude prompt hook after the turn, `briefDelivered` reads the session record, and `backfillRunLog` writes the fields onto a finished log with a refusal code for a holdout, unknown or same-path input, after `trustedCheckout` confirms each line's checkout is the project root or a marked arena. Each offer carries `offeredAs`, `head` or `partner`. A fallback head such as `Advisor: no skill matched.` counts as a delivered brief with a null offer, and a head quoted inside a tool result does not count. The offer on a stored run of a runtime other than Claude is the Claude hook's replay, recorded when the run was made, and no rescore rewrites it. |\n| `run-command-behaviour.mjs` | Runs one live turn per row and records the locator, exit and changed paths. `--print-argv <runtime>` prints a runtime's argv, `--list <set>` prints a set's row ids, and a run takes `--runtime` with `--set` or repeated `--row-id`, `--out <run-log>`, optional `--arm`, `--fixture` and `--dry-run`. Without `--arm`, a selection whose ids are all started-command rows runs under arm `g2`, one that holds none runs under `pre` and a mix is refused with `mixed_row_arms`. Each `g2` run line records the `fixture` folder its prompt named, and `--backfill` replays that folder, or `g2-fixture` beside the log for a line that holds none. `--backfill <run-log> --out <new-log> [--brief-only]` rewrites a finished log with `offeredCommand`, `offeredPolicy` and `briefDelivered` instead of running a turn, and prints a JSON refusal with `same_path`, `holdout_row` or `unknown_row` when it cannot. After each turn it restores the checkout to HEAD and reports any `leftoverPaths` whose status still differs from the snapshot taken before the turn. Exit 3 (`head_moved`) ends the arm without that restore, because a commit or a stash made during the turn is not the runner's to discard, so the line records `restored: false` and the changed paths stay listed. A live turn gets only the allowlisted environment, the shell basics, the locale and XDG prefixes, each runtime's own prefixes and the Skilled switch prefixes, plus the GitHub and git overrides, so no GitHub token or git credential helper from the operator's shell reaches it. Exit 2 refuses instead of running: bad flags, an unknown runtime or set, a holdout or unknown row, a set with fewer rows than it needs (`set_short`), a dirty worktree outside the run log's folder (`worktree_dirty`), a checkout with a git remote (`remote_present`), a checkout without the arena builder's marker (`arena_unprepared`), a selection that mixes started-command rows with others (`mixed_row_arms`), or a Codex arm whose project hook is unapproved (`codex-hooks-unapproved`). |\n| `command-routing-baseline.json` | Captured command routing numbers that `tests/command-routing-slice.vitest.ts` holds the scorer to. |\n| `build-holdout.mjs` | Builds the frozen holdout from three separately authored fixtures that are disjoint from the labeled corpus, copying each row's own label and keeping its provenance in `source_type` and `origin_fixture`. Family-normalized dedup keeps the first occurrence and drops any prompt that collides with the training corpus. `--write` rewrites `holdout-prompts.jsonl`. |\n| `capture-local-native-divergence-ledger.mjs` | Recomputes the strict Python/native top-1 divergence set the ratchet replays. An existing approval is kept only while its prompt hash and both current tops still match, so the output is a capture of live scoring rather than a hand-edited fixture. Scores both scorers against a skill graph indexed fresh into a temporary directory with the clock pinned to the capture day, and `--write` records the result. |\n| `capture-scorer-eval-baseline.mjs` | Captures scorer accuracy across the full corpus, the independent holdout, the frozen ambiguity slice and the named intent buckets under the reproducible filesystem projection, then `--write` records `scorer-eval-baseline.json`. Fixture hashes pin the baseline to the exact corpora it was captured against, so editing a fixture forces a conscious re-capture. `--misses` prints one failing prompt per line. |\n| `derive-ambiguity-slice.mjs` | Derives the frozen ambiguity slice as the corpus rows whose top-2 fused-score margin is at or below `tau`, keeping each row's existing gold label, so a regression that only hurts contested prompts still fails a gate. `--write` rewrites `ambiguity-prompts.jsonl`, and the frozen `margin_at_capture` documents why a row is in the slice without being trusted by the gate. |\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"sed -n '55,130p' .skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/README.md\"}"},"time":{"start":1794680355237,"end":1794680355598}}}}
{"type":"tool_use","timestamp":1794680355604,"sessionID":"ses_e24b9ad86ffemxqRFlUJ7Tx0bg","part":{"partID":"prt_1db48f6c1001o8zz6DsYDfk79D","sessionID":"ses_e24b9ad86ffemxqRFlUJ7Tx0bg","messageID":"msg_1db48e135001ouOWWqFnXeXZ03","type":"tool","id":"call_fac4d301a1994ea8b785366e","tool":"shell","state":{"status":"completed","input":{"command":"grep -n \"heredoc\\|HereDoc\\|HEREDOC\\|<<-\\|<<'\\|sed -i\\|isLoad\\|shellCommand\\|readDocument\\|offeredAsPartner\\|paired\" .skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/score-command-transcripts.mjs | head -80"},"output":"645:// The lines of a heredoc are data handed to a program and not commands, so the pattern\n648:const HEREDOC_BODY = /(<<-?\\s*(['\"]?)([A-Za-z_][A-Za-z0-9_.-]*)\\2[^\\n]*)\\n[\\s\\S]*?\\n[ \\t]*\\3[ \\t]*(?=\\n|$)/g;\n651:  const text = (typeof command === 'string' ? command : '').replace(HEREDOC_BODY, '$1');\n915:// search, an in-place `sed` and a heredoc line are not.\n916:function readDocument(events, wanted) {\n986:    && (readDocument(stream, wanted) || reportedStart(stream, wanted) || hostExpanded(stream, wanted));\n1439:    if (readDocument(events, parts)) return command;\n1497: *      offered: boolean, offerFieldAbsent: boolean, offeredAsPartner: boolean,\n1545:    offeredAsPartner: offer.partner,\n1622:    offeredAsPartner: 0,\n1681:    offeredAsPartner: tally.offeredAsPartner,\n1771:  if (result.offeredAsPartner) tally.offeredAsPartner += 1;\n1896:          block.paired = { from: arms[0], to: arms[1], rows: shared.length, ...counts };\n1915:      if (arm === 'unscored' || arm === 'paired') continue;\n1924:          + ` offered as partner ${block.offeredAsPartner},`\n1954:    if (entry.paired !== undefined) {\n1956:        `  paired ${entry.paired.from} to ${entry.paired.to}: ${entry.paired.rows} rows,`\n1957:          + ` gained ${entry.paired.gained}, lost ${entry.paired.lost},`\n1958:          + ` both followed ${entry.paired.bothFollowed},`\n1959:          + ` neith