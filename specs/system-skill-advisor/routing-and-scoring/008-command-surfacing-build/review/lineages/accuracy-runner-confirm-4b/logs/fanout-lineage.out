{"type":"tool_use","timestamp":1794680246382,"sessionID":"ses_e24b9ad86ffemxqRFlUJ7Tx0bg","part":{"partID":"prt_1db474eae002Xk8ilmcfO3D65c","sessionID":"ses_e24b9ad86ffemxqRFlUJ7Tx0bg","messageID":"msg_1db473e1f001aaVOMF4mRyw3kf","type":"tool","id":"call_28b6bf1dc81f47b88605c57d","tool":"read","state":{"status":"completed","input":{"limit":700,"offset":1334,"path":".skilled/commands/deep/assets/deep-review-auto.yaml"},"output":"Read file .skilled/commands/deep/assets/deep-review-auto.yaml, lines 1334-2033\n1334:             - \"permission-mode stays acceptEdits (review's existing iteration-write behavior); claude-code has no serviceTier flag\"\n1335:             - \"claude-code supports --effort for reasoning depth\"\n1336:         if_cli_opencode:\n1337:           command: |\n1338:             GATEWAY=\".skilled/skills/system-deep-loop/runtime/scripts/append-mode-event.cjs\"\n1339:             [ -f \"$GATEWAY\" ] || GATEWAY=\"scripts/append-mode-event.cjs\"\n1340:             EVENT_DIR=\"$(mktemp -d \"${TMPDIR:-/tmp}/deep-review-baseline.XXXXXX\")\"\n1341:             node --import \"$(node -p \"require.resolve('tsx', { paths: ['.skilled/skills/system-deep-loop/runtime'] })\")\" --input-type=module - \"$EVENT_DIR\" <<'EOF'\n1342:             import { execFileSync } from 'node:child_process';\n1343:             import { readFileSync, readlinkSync, realpathSync, writeFileSync } from 'node:fs';\n1344:             import { createHash } from 'node:crypto';\n1345:             import { createRequire } from 'node:module';\n1346:             import { basename, dirname, isAbsolute, join, relative, resolve } from 'node:path';\n1347: \n1348:             import { runAuditedExecutorCommand } from './.skilled/skills/system-deep-loop/runtime/lib/deep-loop/executor-audit.ts';\n1349:             import { resolveClaudePermissionMode } from './.skilled/skills/system-deep-loop/runtime/lib/deep-loop/executor-config.ts';\n1350: \n1351:             const reasoningEffort = '{config.executor.reasoningEffort}' === 'null' ? null : '{config.executor.reasoningEffort}';\n1352:             const require = createRequire(import.meta.url);\n1353:             const { buildLineageCommand, withAgentPersona } = require('./.skilled/skills/system-deep-loop/runtime/scripts/fanout-run.cjs');\n1354:             const model = '{config.executor.model}' === 'null' ? null : '{config.executor.model}';\n1355:             const sandboxMode = '{config.executor.sandboxMode}' === 'null' ? 'danger-full-access' : '{config.executor.sandboxMode}';\n1356:             const executor = {\n1357:               kind: 'cli-opencode',\n1358:               model,\n1359:               configDir: null,\n1360:               reasoningEffort,\n1361:               serviceTier: null,\n1362:               sandboxMode,\n1363:               timeoutSeconds: Number('{config.executor.timeoutSeconds}'),\n1364:               governor: null,\n1365:             };\n1366:             const promptBody = withAgentPersona('deep-review', readFileSync('{state_paths.prompt_dir}/iteration-{current_iteration}.md', 'utf8'), '{repo_root}');\n1367:             if (!promptBody.includes('BANNED OPERATIONS') || !promptBody.includes('ALLOWED WRITE PATHS')) {\n1368:               throw new Error('Unsafe cli-opencode dispatch: rendered prompt is missing required write-containment sections');\n1369:             }\n1370: \n1371:             const repoRoot = realpathSync('{repo_root}');\n1372:             const artifactDir = resolve(repoRoot, '{state_paths.packet_dir}');\n1373:             const artifactRelative = relative(repoRoot, artifactDir);\n1374:             if (artifactRelative === '' || artifactRelative.startsWith('..') || isAbsolute(artifactRelative)) {\n1375:               throw new Error('Unsafe cli-opencode dispatch: artifact directory must be a strict descendant of the worktree root');\n1376:             }\n1377: \n1378:             const git = (args, cwd = repoRoot, trim = true) => {\n1379:               const output = execFileSync('git', args, { cwd, encoding: 'utf8' });\n1380:               return trim ? output.trim() : output;\n1381:             };\n1382:             const resolveGitPath = (candidate) => realpathSync(isAbsolute(candidate) ? candidate : resolve(repoRoot, candidate));\n1383:             const gitDir = resolveGitPath(git(['rev-parse', '--git-dir']));\n1384:             const commonGitDir = resolveGitPath(git(['rev-parse', '--git-common-dir']));\n1385:             if (gitDir === commonGitDir) {\n1386:               throw new Error('Unsafe cli-opencode dispatch: --dir must point at an isolated linked worktree');\n1387:             }\n1388: \n1389:             const primaryBlock = git(['worktree', 'list', '--porcelain'])\n1390:               .split(/\\n\\n+/)\n1391:               .find((block) => /^branch refs\\/heads\\/(?:main|master)$/m.test(block));\n1392:             const primaryLine = primaryBlock?.split('\\n').find((line) => line.startsWith('worktree '));\n1393:             if (!primaryLine) {\n1394:               throw new Error('Unsafe cli-opencode dispatch: primary main/master worktree could not be resolved');\n1395:             }\n1396:             const primaryRoot = realpathSync(primaryLine.slice('worktree '.length));\n1397:             const primaryStatus = git(['status', '--porcelain=v1', '--untracked-files=all'], primaryRoot);\n1398:             if (primaryStatus) {\n1399:               throw new Error('Unsafe cli-opencode dispatch: primary worktree must be clean before unrestricted execution');\n1400:             }\n1401: \n1402:             const dirtyPaths = [\n1403:               ...git(['diff', '--name-only', '-z', 'HEAD', '--'], repoRoot, false).split('\\0'),\n1404:               ...git(['ls-files', '--others', '--exclude-standard', '-z'], repoRoot, false).split('\\0'),\n1405:             ].filter(Boolean);\n1406:             const canonicalLocation = (absolutePath) => {\n1407:               try {\n1408:                 return realpathSync(absolutePath);\n1409:               } catch {\n1410:                 let parentReal;\n1411:                 try {\n1412:                   parentReal = realpathSync(dirname(absolutePath));\n1413:                 } catch {\n1414:                   return absolutePath;\n1415:                 }\n1416:                 const leaf = resolve(parentReal, basename(absolutePath));\n1417:                 try {\n1418:                   // A dangling link still names the location it points at, and becomes a live\n1419:                   // escape the moment that target is created.\n1420:                   const target = readlinkSync(leaf);\n1421:                   return isAbsolute(target) ? resolve(target) : resolve(parentReal, target);\n1422:                 } catch {\n1423:                   return leaf;\n1424:                 }\n1425:               }\n1426:             };\n1427:             const artifactDirReal = canonicalLocation(artifactDir);\n1428:             // git reports the path it walked, not where the bytes land: a symlink component\n1429:             // under the artifact dir leaves a path that looks contained while its real\n1430:             // location is wherever the link points. Containment has to hold both by name and\n1431:             // after every component is resolved, so resolution can only ever narrow scope.\n1432:             const escapesArtifactDir = (absolutePath) => {\n1433:               const lexical = relative(artifactDir, absolutePath);\n1434:               if (lexical.startsWith('..') || isAbsolute(lexical)) return true;\n1435:               const canonical = relative(artifactDirReal, canonicalLocation(absolutePath));\n1436:               return canonical.startsWith('..') || isAbsolute(canonical);\n1437:             };\n1438:             const outsideArtifactDir = dirtyPaths.filter((candidate) => escapesArtifactDir(resolve(repoRoot, candidate)));\n1439:             if (outsideArtifactDir.length > 0) {\n1440:               throw new Error(`Unsafe cli-opencode dispatch: worktree changes outside the artifact directory: ${outsideArtifactDir.join(', ')}`);\n1441:             }\n1442: \n1443:             const recoveryBaselineCommit = git(['rev-parse', '--verify', 'HEAD']);\n1444:             // The state log is a projection the gateway rebuilds from the ledger, so the\n1445:             // recovery baseline is staged as a canonical ledger event for the wrapper\n1446:             // below to append; a write beside the projection is dropped by the next refresh.\n1447:             writeFileSync(\n1448:               join(process.argv[2], '01-recovery_baseline.json'),\n1449:               JSON.stringify({\n1450:                 stem: 'deep_review.recovery_baseline',\n1451:                 scope: { runId: '{session_id}', sessionId: '{session_id}' },\n1452:                 data: {\n1453:                   mode: 'review',\n1454:                   iteration: Number('{current_iteration}'),\n1455:                   recoveryBaselineCommit,\n1456:                   worktree: repoRoot,\n1457:                 },\n1458:               }),\n1459:               'utf8',\n1460:             );\n1461:             const message = 'Resolved route: mode=review; target_agent=@deep-review; execution=single_review_iteration; state_source=externalized_files; do_not_switch_mode=true'\n1462:               + '\\n\\n'\n1463:               + promptBody;\n1464: \n1465:             const lineage = { kind: 'cli-opencode', model, reasoningEffort, sandboxMode };\n1466:             const resolvedPermission = resolveClaudePermissionMode(sandboxMode);\n1467:             const { command, args, input, cwd } = buildLineageCommand(\n1468:               lineage,\n1469:               message,\n1470:               sandboxMode,\n1471:               resolvedPermission,\n1472:               { env: process.env, cwd: repoRoot, directoryRoot: repoRoot },\n1473:             );\n1474: \n1475:             const dispatchFacts = {\n1476:               command: 'deep/review',\n1477:               mode: 'review',\n1478:               specFolder: '{spec_folder}',\n1479:               artifactDir: '{state_paths.packet_dir}',\n1480:               iteration: Number('{current_iteration}'),\n1481:               executorKind: '{config.executor.kind}',\n1482:               branchId: '{config.executor.kind}',\n1483:               sessionId: '{session_id}',\n1484:               generation: Number('{generation}'),\n1485:             };\n1486:             const dispatchId = 'review-i{current_iteration}-g{generation}';\n1487:             process.exit(\n1488:               runAuditedExecutorCommand({\n1489:                 command,\n1490:                 args,\n1491:                 cwd: cwd || repoRoot,\n1492:                 timeoutSeconds: executor.timeoutSeconds,\n1493:                 stateLogPath: '{state_paths.state_log}',\n1494:                 executor,\n1495:                 iteration: Number('{current_iteration}'),\n1496:                 // buildLineageCommand returns empty input, so stdin is closed for OpenCode.\n1497:                 input,\n1498:                 receiptDir: '{state_paths.packet_dir}/dispatch-receipts',\n1499:                 dispatchId,\n1500:               }),\n1501:             );\n1502:             EOF\n1503:             NODE_STATUS=$?\n1504:             for eventFile in \"$EVENT_DIR\"/*.json; do\n1505:               [ -e \"$eventFile\" ] || continue\n1506:               node \"$GATEWAY\" --mode review --run-directory \"$(dirname \"{state_paths.state_log}\")\" --event-json \"$eventFile\"\n1507:               GATEWAY_STATUS=$?\n1508:               if [ \"$GATEWAY_STATUS\" -ne 0 ]; then\n1509:                 rm -rf \"$EVENT_DIR\"\n1510:                 exit \"$GATEWAY_STATUS\"\n1511:               fi\n1512:             done\n1513:             rm -rf \"$EVENT_DIR\"\n1514:             exit \"$NODE_STATUS\"\n1515:           working_directory: \"{repo_root}\"\n1516:           timeout_seconds: \"{config.executor.timeoutSeconds}\"\n1517:           wait_for_completion: true\n1518:           notes:\n1519:             - \"Routed through runAuditedExecutorCommand so opencode produces INTENT + COMPLETION dispatch receipts; recursion guard + env allowlist enforced via buildExecutorDispatchEnv\"\n1520:             - \"Fail closed before dispatch unless the rendered containment sections exist, --dir is an isolated linked worktree, the primary worktree is clean, and current-worktree changes are confined to artifact_dir both by name and after every path component is resolved through symlinks; append the recovery-baseline commit to state_log\"\n1521:             - \"buildLineageCommand returns empty input, so stdin is closed (EOF), equivalent to </dev/null\"\n1522:             - \"buildLineageCommand receives the route-proof preamble + iteration body as its message\"\n1523:             - \"buildLineageCommand maps reasoningEffort to the installed OpenCode version's supported option\"\n1524:             - \"buildLineageCommand resolves the OpenCode binary and version-correct argv for the configured sandboxMode\"\n1525:             - \"cli-opencode self-invocation guard: this single-executor branch must only run from a non-OpenCode dispatch surface (Claude Code/raw shell). Explicit parallel-detached cli-opencode fan-out is handled by step_fanout_spawn_cli/fanout-run.cjs, not this branch. the `cli-external-orchestration/cli-opencode` mode's SKILL.md (`.skilled/skills/cli-external-orchestration/cli-opencode/SKILL.md`) §SELF-INVOCATION PROHIBITED contract is the authoritative gate\"\n1526:         if_cli_codex:\n1527:           command: |\n1528:             node --import \"$(node -p \"require.resolve('tsx', { paths: ['.skilled/skills/system-deep-loop/runtime'] })\")\" --input-type=module <<'EOF'\n1529:             import { readFileSync } from 'node:fs';\n1530:             import { execFileSync } from 'node:child_process';\n1531:             import { createRequire } from 'node:module';\n1532: \n1533:             import {\n1534:               RECURSION_GUARD_EXIT_CODE,\n1535:               formatRecursionGuardRefusal,\n1536:               runAuditedExecutorCommand,\n1537:               validateExecutorDispatchAllowed,\n1538:             } from './.skilled/skills/system-deep-loop/runtime/lib/deep-loop/executor-audit.ts';\n1539:             import {\n1540:               snapshotOutOfScopeDirtyPaths,\n1541:               enforceWriteContainment,\n1542:             } from './.skilled/skills/system-deep-loop/runtime/lib/deep-loop/write-containment.ts';\n1543: \n1544:             // Fail closed: a requested codex executor must dispatch codex or abort,\n1545:             // never silently degrade to another executor. Undetected absence is what\n1546:             // got Codex deprecated before, so the branch exits non-zero when the\n1547:             // binary is missing instead of falling through to a native/other path.\n1548:             let codexAvailable = false;\n1549:             try {\n1550:               execFileSync('/bin/sh', ['-c', 'command -v codex >/dev/null 2>&1'], { stdio: 'ignore' });\n1551:               codexAvailable = true;\n1552:             } catch {}\n1553:             if (!codexAvailable) {\n1554:               console.error('cli-codex executor unavailable: command -v codex failed');\n1555:               process.exit(1);\n1556:             }\n1557: \n1558:             const reasoningEffort = '{config.executor.reasoningEffort}' === 'null' ? null : '{config.executor.reasoningEffort}';\n1559:             const serviceTier = '{config.executor.serviceTier}' === 'null' ? null : '{config.executor.serviceTier}';\n1560:             const model = '{config.executor.model}' === 'null' ? null : '{config.executor.model}';\n1561:             const executor = {\n1562:               kind: 'cli-codex',\n1563:               model,\n1564:               configDir: null,\n1565:               reasoningEffort,\n1566:               serviceTier,\n1567:               sandboxMode: 'workspace-write',\n1568:               timeoutSeconds: Number('{config.executor.timeoutSeconds}'),\n1569:               governor: null,\n1570:             };\n1571: \n1572:             // Refuse before any spawn and before any receipt is written, so a refusal can\n1573:             // never be mistaken for a real attempt. A process that is already a CLI lineage\n1574:             // or a codex session must run the iteration itself, not delegate it onward.\n1575:             const guardVerdict = validateExecutorDispatchAllowed(executor, { env: process.env });\n1576:             if (!guardVerdict.allowed) {\n1577:               console.error(formatRecursionGuardRefusal(guardVerdict, executor));\n1578:               process.exit(RECURSION_GUARD_EXIT_CODE);\n1579:             }\n1580: \n1581:             const require = createRequire(import.meta.url);\n1582:             const { withAgentPersona } = require('./.skilled/skills/system-deep-loop/runtime/scripts/fanout-run.cjs');\n1583:             const promptBody = withAgentPersona('deep-review', readFileSync('{state_paths.prompt_dir}/iteration-{current_iteration}.md', 'utf8'), '{repo_root}');\n1584: \n1585:             // codex reads the iteration prompt from stdin via the trailing '-'. A review\n1586:             // iteration must WRITE its own iteration file, delta and state record, so the\n1587:             // sandbox is workspace-write — read-only would block those required writes.\n1588:             // approval_policy=never keeps the run non-interactive.\n1589:             const args = ['exec'];\n1590:             if (model) {\n1591:               args.push('--model', model);\n1592:             }\n1593:             args.push('-c', 'model_reasoning_effort=' + (reasoningEffort || 'medium'));\n1594:             if (serviceTier) {\n1595:               args.push('-c', 'service_tier=' + serviceTier);\n1596:             }\n1597:             args.push('-c', 'approval_policy=never', '--sandbox', executor.sandboxMode, '-');\n1598: \n1599:             const dispatchId = 'review-i{current_iteration}-g{generation}';\n1600:             const repoRoot = '{repo_root}';\n1601:             const artifactDir = '{artifact_dir}';\n1602:             const preDispatchDirtyPaths = snapshotOutOfScopeDirtyPaths({ repoRoot, artifactDir });\n1603:             const dispatchExit = runAuditedExecutorCommand({\n1604:               command: 'codex',\n1605:               args,\n1606:               cwd: repoRoot,\n1607:               timeoutSeconds: executor.timeoutSeconds,\n1608:               stateLogPath: '{state_paths.state_log}',\n1609:               executor,\n1610:               iteration: Number('{current_iteration}'),\n1611:               input: promptBody,\n1612:               receiptDir: '{state_paths.packet_dir}/dispatch-receipts',\n1613:               dispatchId,\n1614:             });\n1615:             // Structural write-containment: the artifact-dir boundary is prompt-only, so a\n1616:             // workspace-write leaf can write anywhere in the repo. The guard diffs the tree\n1617:             // after the dispatch and reports every NEW out-of-artifact-dir path. Its remedy\n1618:             // PRESERVES by default -- event recorded, copy quarantined, bytes left on disk --\n1619:             // because a path it cannot attribute may belong to a concurrent writer, so a\n1620:             // revert here would destroy work this lane never wrote; reverting is opt-in per\n1621:             // run and is not implied by this call. Remedy authority, both modes:\n1622:             // runtime/lib/deep-loop/write-containment.ts. A violation is reported below and\n1623:             // left on disk, never made fatal here: what the run does about it is the\n1624:             // verdict's to decide. The leaf's own writes under artifactDir (iteration\n1625:             // file/delta/state record) are never flagged.\n1626:             const containment = enforceWriteContainment({\n1627:               repoRoot,\n1628:               artifactDir,\n1629:               preDispatchDirtyPaths,\n1630:               stateLogPath: '{state_paths.state_log}',\n1631:               iteration: Number('{current_iteration}'),\n1632:               label: dispatchId,\n1633:             });\n1634:             if (containment.violations.length > 0) {\n1635:               console.error(\n1636:                 'write-containment advisory: detected ' + containment.violations.length\n1637:                   + ' out-of-scope path(s), left on disk: '\n1638:                   + containment.violations.map((v) => v.path).join(', '),\n1639:               );\n1640:             }\n1641:             // A path that was already dirty before the dispatch and changed during it is held out of\n1642:             // violations. enforceWriteContainment records it in the state log as containment_contested;\n1643:             // this prints it so the run's own output says so too.\n1644:             if (containment.contested.length > 0) {\n1645:               console.error(\n1646:                 'write-containment contested: ' + containment.contested.length\n1647:                   + ' path(s) already dirty before the dispatch changed during it, left on disk: '\n1648:                   + containment.contested.map((v) => v.path).join(', ')\n1649:                   + '\\n' + containment.contestedNote,\n1650:               );\n1651:             }\n1652:             process.exit(dispatchExit);\n1653:             EOF\n1654:           working_directory: \"{repo_root}\"\n1655:           timeout_seconds: \"{config.executor.timeoutSeconds}\"\n1656:           wait_for_completion: true\n1657:           notes:\n1658:             - \"PRE-DISPATCH RULE (read before running the script): when this run is ITSELF a fan-out CLI lineage — config.fanout_lineage_artifact_dir is bound, or SPECKIT_FANOUT_LINEAGE_ID / SPECKIT_CLI_DISPATCH_STACK / CODEX_SESSION_ID is present in the environment — the lineage IS the executor. Do NOT run this dispatch script. Perform the iteration in-process instead: read the rendered prompt at {state_paths.prompt_dir}/iteration-{current_iteration}.md, do the review pass yourself, write the iteration file and the delta, and hand the iteration record to the append gateway (append-mode-event.cjs) exactly as the leaf contract requires, never writing the state log yourself, then continue to post_dispatch_validate.\"\n1659:             - \"Nested CLI dispatch from a lineage is a route violation, not a slow path: a codex lineage that runs this script spawns codex inside its own sandbox, where the child cannot initialize and every iteration fails. The script refuses that case before any spawn and before any dispatch receipt is written, exiting RECURSION_GUARD_EXIT_CODE; that refusal is a route error to fix, never a redispatchable executor failure.\"\n1660:             - \"Routed through runAuditedExecutorCommand so codex produces INTENT + COMPLETION dispatch receipts; recursion guard (CODEX_SESSION_ID) + env allowlist (CODEX_/OPENAI_/AZURE_OPENAI_) enforced via buildExecutorDispatchEnv\"\n1661:             - \"Fails closed when the codex binary is absent (exit 1) — parity with the fan-out cli-codex lineage guard in fanout-run.cjs; codex routing never degrades to native\"\n1662:             - \"codex exec reads the iteration prompt from stdin via the trailing '-' (input: promptBody); '-c model_reasoning_effort=' maps reasoning depth, default medium; '-c service_tier=' forwarded when configured\"\n1663:             - \"--sandbox workspace-write is required so the iteration can write its own iteration file/delta/state record (read-only would fail the post-dispatch artifact gate); -c approval_policy=never keeps it non-interactive; --model omitted when unset so ~/.codex/config.toml default applies\"\n1664:         if_cli_cursor:\n1665:           command: |\n1666:             node --import \"$(node -p \"require.resolve('tsx', { paths: ['.skilled/skills/system-deep-loop/runtime'] })\")\" --input-type=module <<'EOF'\n1667:             import { readFileSync } from 'node:fs';\n1668:             import { createRequire } from 'node:module';\n1669:             import { runAuditedExecutorCommand } from './.skilled/skills/system-deep-loop/runtime/lib/deep-loop/executor-audit.ts';\n1670:             import { resolveSandboxMode, resolveClaudePermissionMode } from './.skilled/skills/system-deep-loop/runtime/lib/deep-loop/executor-config.ts';\n1671:             import {\n1672:               snapshotOutOfScopeDirtyPaths,\n1673:               enforceWriteContainment,\n1674:             } from './.skilled/skills/system-deep-loop/runtime/lib/deep-loop/write-containment.ts';\n1675: \n1676:             // cursor-agent/devin/pi have no single-executor branch of their own, so\n1677:             // without this they silently degrade to native. The command builder is the\n1678:             // same one the fan-out lineage path uses, so the enforced model allowlist,\n1679:             // headless write-mode flags, and binary preflight stay one source of truth.\n1680:             // It throws (fail closed) when the binary is absent or the model is off the\n1681:             // allowlist, so a requested CLI executor never becomes native.\n1682:             const require = createRequire(import.meta.url);\n1683:             const { buildLineageCommand, withAgentPersona } = require('./.skilled/skills/system-deep-loop/runtime/scripts/fanout-run.cjs');\n1684: \n1685:             const kind = '{config.executor.kind}';\n1686:             const model = '{config.executor.model}' === 'null' ? null : '{config.executor.model}';\n1687:             const timeoutSeconds = Number('{config.executor.timeoutSeconds}');\n1688:             // The iteration must write its own iteration file, delta and state record,\n1689:             // so the leaf runs workspace-write; the builder maps that to each CLI's real\n1690:             // write-permitting headless flags.\n1691:             const sandboxMode = 'workspace-write';\n1692:             const lineage = { kind, model, sandboxMode };\n1693:             const resolvedSandbox = resolveSandboxMode(sandboxMode);\n1694:             const resolvedPermission = resolveClaudePermissionMode(sandboxMode);\n1695: \n1696:             const repoRoot = '{repo_root}';\n1697:             const promptBody = withAgentPersona('deep-review', readFileSync('{state_paths.prompt_dir}/iteration-{current_iteration}.md', 'utf8'), repoRoot);\n1698:             const { command, args, input } = buildLineageCommand(\n1699:               lineage,\n1700:               promptBody,\n1701:               resolvedSandbox,\n1702:               resolvedPermission,\n1703:               { env: process.env, cwd: repoRoot },\n1704:             );\n1705: \n1706:             const executor = {\n1707:               kind,\n1708:               model,\n1709:               configDir: null,\n1710:               reasoningEffort: null,\n1711:               serviceTier: null,\n1712:               sandboxMode,\n1713:               timeoutSeconds,\n1714:               governor: null,\n1715:             };\n1716:             const dispatchId = 'review-i{current_iteration}-g{generation}';\n1717:             const artifactDir = '{artifact_dir}';\n1718:             const preDispatchDirtyPaths = snapshotOutOfScopeDirtyPaths({ repoRoot, artifactDir });\n1719:             const dispatchExit = runAuditedExecutorCommand({\n1720:               command,\n1721:               args,\n1722:               cwd: repoRoot,\n1723:               timeoutSeconds,\n1724:               stateLogPath: '{state_paths.state_log}',\n1725:               executor,\n1726:               iteration: Number('{current_iteration}'),\n1727:               input,\n1728:               receiptDir: '{state_paths.packet_dir}/dispatch-receipts',\n1729:               dispatchId,\n1730:             });\n1731:             const containment = enforceWriteContainment({\n1732:               repoRoot,\n1733:               artifactDir,\n1734:               preDispatchDirtyPaths,\n1735:               stateLogPath: '{state_paths.state_log}',\n1736:               iteration: Number('{current_iteration}'),\n1737:               label: dispatchId,\n1738:             });\n1739:             if (containment.violations.length > 0) {\n1740:               console.error(\n1741:                 'write-containment advisory: detected ' + containment.violations.length\n1742:                   + ' out-of-scope path(s), left on disk: '\n1743:                   + containment.violations.map((v) => v.path).join(', '),\n1744:               );\n1745:             }\n1746:             // A path that was already dirty before the dispatch and changed during it is held out of\n1747:             // violations. enforceWriteContainment records it in the state log as containment_contested;\n1748:             // this prints it so the run's own output says so too.\n1749:             if (containment.contested.length > 0) {\n1750:               console.error(\n1751:                 'write-containment contested: ' + containment.contested.length\n1752:                   + ' path(s) already dirty before the dispatch changed during it, left on disk: '\n1753:                   + containment.contested.map((v) => v.path).join(', ')\n1754:                   + '\\n' + containment.contestedNote,\n1755:               );\n1756:             }\n1757:             process.exit(dispatchExit);\n1758:             EOF\n1759:           working_directory: \"{repo_root}\"\n1760:           timeout_seconds: \"{config.executor.timeoutSeconds}\"\n1761:           wait_for_completion: true\n1762:           notes:\n1763:             - \"cli-cursor single-executor: dispatches per-iteration through the shared fan-out command builder (buildLineageCommand) so the enforced cli-cursor model allowlist + headless write flags stay one source of truth; runAuditedExecutorCommand emits INTENT + COMPLETION receipts\"\n1764:             - \"Fails closed when cursor-agent is absent or the model is off the allowlist (buildLineageCommand throws, exit non-zero) — a requested cli-cursor executor never degrades to native\"\n1765:         if_cli_devin:\n1766:           command: |\n1767:             node --import \"$(node -p \"require.resolve('tsx', { paths: ['.skilled/skills/system-deep-loop/runtime'] })\")\" --input-type=module <<'EOF'\n1768:             import { readFileSync } from 'node:fs';\n1769:             import { createRequire } from 'node:module';\n1770:             import { runAuditedExecutorCommand } from './.skilled/skills/system-deep-loop/runtime/lib/deep-loop/executor-audit.ts';\n1771:             import { resolveSandboxMode, resolveClaudePermissionMode } from './.skilled/skills/system-deep-loop/runtime/lib/deep-loop/executor-config.ts';\n1772:             import {\n1773:               snapshotOutOfScopeDirtyPaths,\n1774:               enforceWriteContainment,\n1775:             } from './.skilled/skills/system-deep-loop/runtime/lib/deep-loop/write-containment.ts';\n1776: \n1777:             // cursor-agent/devin/pi have no single-executor branch of their own, so\n1778:             // without this they silently degrade to native. The command builder is the\n1779:             // same one the fan-out lineage path uses, so the enforced model allowlist,\n1780:             // headless write-mode flags, and binary preflight stay one source of truth.\n1781:             // It throws (fail closed) when the binary is absent or the model is off the\n1782:             // allowlist, so a requested CLI executor never becomes native.\n1783:             const require = createRequire(import.meta.url);\n1784:             const { buildLineageCommand, withAgentPersona } = require('./.skilled/skills/system-deep-loop/runtime/scripts/fanout-run.cjs');\n1785: \n1786:             const kind = '{config.executor.kind}';\n1787:             const model = '{config.executor.model}' === 'null' ? null : '{config.executor.model}';\n1788:             const timeoutSeconds = Number('{config.executor.timeoutSeconds}');\n1789:             // The iteration must write its own iteration file, delta and state record,\n1790:             // so the leaf runs workspace-write; the builder maps that to each CLI's real\n1791:             // write-permitting headless flags.\n1792:             const sandboxMode = 'workspace-write';\n1793:             const lineage = { kind, model, sandboxMode };\n1794:             const resolvedSandbox = resolveSandboxMode(sandboxMode);\n1795:             const resolvedPermission = resolveClaudePermissionMode(sandboxMode);\n1796: \n1797:             const repoRoot = '{repo_root}';\n1798:             const promptBody = withAgentPersona('deep-review', readFileSync('{state_paths.prompt_dir}/iteration-{current_iteration}.md', 'utf8'), repoRoot);\n1799:             const { command, args, input } = buildLineageCommand(\n1800:               lineage,\n1801:               promptBody,\n1802:               resolvedSandbox,\n1803:               resolvedPermission,\n1804:               { env: process.env, cwd: repoRoot },\n1805:             );\n1806: \n1807:             const executor = {\n1808:               kind,\n1809:               model,\n1810:               configDir: null,\n1811:               reasoningEffort: null,\n1812:               serviceTier: null,\n1813:               sandboxMode,\n1814:               timeoutSeconds,\n1815:               governor: null,\n1816:             };\n1817:             const dispatchId = 'review-i{current_iteration}-g{generation}';\n1818:             const artifactDir = '{artifact_dir}';\n1819:             const preDispatchDirtyPaths = snapshotOutOfScopeDirtyPaths({ repoRoot, artifactDir });\n1820:             const dispatchExit = runAuditedExecutorCommand({\n1821:               command,\n1822:               args,\n1823:               cwd: repoRoot,\n1824:               timeoutSeconds,\n1825:               stateLogPath: '{state_paths.state_