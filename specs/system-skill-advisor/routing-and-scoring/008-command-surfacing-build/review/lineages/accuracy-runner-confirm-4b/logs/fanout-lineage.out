ll lists remain stale. CHK-FIX-003/004 stay open with the phase.\\\"},\\\"feature_catalog_code\\\":{\\\"level\\\":\\\"overlay\\\",\\\"status\\\":\\\"notApplicable\\\",\\\"notes\\\":\\\"No feature-catalog page describes the two changed writers.\\\"},\\\"agent_cross_runtime\\\":{\\\"level\\\":\\\"overlay\\\",\\\"status\\\":\\\"notApplicable\\\",\\\"notes\\\":\\\"No runtime branch in the changed docs or writers.\\\"},\\\"skill_agent\\\":{\\\"level\\\":\\\"overlay\\\",\\\"status\\\":\\\"notApplicable\\\",\\\"notes\\\":\\\"No agent definition changed.\\\"},\\\"playbook_capability\\\":{\\\"level\\\":\\\"overlay\\\",\\\"status\\\":\\\"notApplicable\\\",\\\"notes\\\":\\\"No playbook surface changed.\\\"}},\\\"newFindingsRatio\\\":1.0,\\\"sessionId\\\":\\\"fanout-accuracy-runner-confirm-4b-1794680176420-xvj4ed\\\",\\\"generation\\\":1,\\\"lineageMode\\\":\\\"new\\\",\\\"timestamp\\\":\\\"2026-11-14T18:35:10Z\\\",\\\"durationMs\\\":127000,\\\"reviewDepthSchemaVersion\\\":2,\\\"reviewDepthApplicability\\\":{\\\"scopeClass\\\":\\\"standard\\\",\\\"enforcement\\\":\\\"strict\\\",\\\"reason\\\":\\\"The recovery pass checks two shared docs against three code paths and the packet task rows.\\\",\\\"evidenceRefs\\\":[\\\"review/review-scope-4b.txt:3-17\\\",\\\"027-review-pass-four-remediation/tasks.md:84-110\\\"]},\\\"targetSelection\\\":{\\\"selectedTargets\\\":[\\\".skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/README.md\\\",\\\".skilled/commands/doctor/assets/doctor-agents-md-presentation.txt\\\",\\\"specs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/027-review-pass-four-remediation/tasks.md\\\"],\\\"selectionReason\\\":\\\"The recovery pass follows the docs and packet rows that describe the changed writers.\\\",\\\"discoveryMethods\\\":[\\\"direct_read\\\",\\\"exact_grep for the field lists and the A11 row\\\",\\\"line comparison against the writers\\\"],\\\"omittedHighRiskTargets\\\":[],\\\"graphStatus\\\":\\\"unavailable\\\",\\\"s