ill-advisor/routing-and-scoring/008-command-surfacing-build/review/lineages/scorer-attach-2/.legacy-projection-watermarks\nspecs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/review/lineages/scorer-attach-2/.executor-state\nspecs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/review/lineages/scorer-attach-2/deltas\nspecs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/review/lineages/scorer-attach-2/logs\nspecs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/review/lineages/scorer-attach-2/locks-and-fencing-v1\nspecs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/review/lineages/scorer-attach-2/iterations\nspecs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/review/lineages/scorer-attach-2/deep-review-audit-ledger\nspecs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/review/lineages/scorer-attach-4\nspecs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/review/lineages/scorer-attach-4/probes\nspecs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/review/lineages/scorer-attach-4/containment\nspecs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/review/lineages/scorer-attach-4/deep-review-ledger\nspecs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/review/lineages/scorer-attach-4/deep-review-effect-ledger\nspecs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/review/lineages/scorer-attach-4/.legacy-projection-watermarks\nspecs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/review/lineages/scorer-attach-4/.executor-state\nspecs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/review/lineages/scorer-attach-4/deltas\nspecs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/review/lineages/scorer-attach-4/logs\nspecs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/review/lineages/scorer-attach-4/locks-and-fencing-v1\nspecs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/review/lineages/scorer-attach-4/prompts\nspecs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/review/lineages/scorer-attach-4/iterations\nspecs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/review/lineages/scorer-attach-4/tmp\nspecs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/review/lineages/scorer-attach-4/deep-review-audit-ledger\nspecs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/review/lineages/doctor-docs-4\nspecs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/review/lineages/doctor-docs-4/containment\nspecs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/review/lineages/doctor-docs-4/deep-review-ledger\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"ls -la specs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/review/lineages/; echo \\\"---\\\"; find specs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/review/lineages -maxdepth 2 -type d | head -60\"}"},"time":{"start":1794680221030,"end":1794680221784}}}}
