ine);\n    if (row.id !== rowId) continue;\n    if (row.split === 'holdout') {\n      throw new Refusal('holdout_row', `${rowId}: a holdout row is never run`);\n    }\n    return row;\n  }\n  throw new Refusal('unknown_row', `${rowId}: no row holds that id`);\n}\n\nfunction lookupPrompt(rowId) {\n  const row = findRow(rowId);\n  if (typeof row.prompt !== 'string' || row.prompt === '') {\n    throw new Refusal('unknown_row', `${rowId}: row holds no prompt`);\n  }\n  return { prompt: row.prompt };\n}\n\n// Selection reads the labels only, so no picker walks a structure that carries a\n// prompt.\n=== promptFor callers ===\n830:function promptFor(rowId, fixture) {\n1240:    const prompt = promptFor(rowId, fixture);\n1265:    promptFor: (rowId, line) => promptFor(rowId, lineFixture(line, fixture)),\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"  };\n  const remotes = gitAt(['remote'])\n    .split('\\n')\n    .map((name) => name.trim())\n    .filter((name) => name !== '');\n  if (remotes.length > 0) return { ok: false, code: 'remote_present', remotes };\n  const marker = resolve(root, gitAt(['rev-parse', '--git-path', MARK]).trim());\n  if (!existsSync(marker)) return { ok: false, code: 'arena_unprepared', marker };\n  return null;\n}\n\n// ───────────────────────────────────────────────────────────────\n// Prompt source and run log\n// ───────────────────────────────────────────────────────────────\n\n/** A refusal the operator can act on without a stack trace. */\nclass Refusal extends Error {\n  constructor(code, message) {\n    super(message);\n    this.code = code;\n  }\n}\n\n// A row is read one line at a time so a holdout row is refused before its prompt\n// reaches a child process or the run log. Discarding the text after reading it\n// would still have put an unmeasured prompt in the arm's path. The guard sits in\n// the lookup itself, so a run, a selection and a listing all answer a refused id\n// the same way instead of one of them getting there through a usage error.\nfunction findRow(rowId) {\n  for (const line of readFileSync(PROMPTS_PATH, 'utf8').split('\\n')) {\n    if (line.trim() === '') continue;\n    const row = JSON.parse(line);\n    if (row.id !== rowId) continue;\n    if (row.split === 'holdout') {\n      throw new Refusal('holdout_row', `${rowId}: a holdout row is never run`);\n    }\n    return row;\n  }\n  throw new Refusal('unknown_row', `${rowId}: no row holds that id`);\n}\n\nfunction lookupPrompt(rowId) {\n  const row = findRow(rowId);\n  if (typeof row.prompt !== 'string' || row.prompt === '') {\n    throw new Refusal('unknown_row', `${rowId}: row holds no prompt`);\n  }\n  return { prompt: row.prompt };\n}\n\n// Selection reads the labels only, so no picker walks a structure that carries a\n// prompt.\n=== promptFor callers ===\n830:function promptFor(rowId, fixture) {\n1240:    const prompt = promptFor(rowId, fixture);\n1265:    promptFor: (rowId, line) => promptFor(rowId, lineFixture(line, fixture)),\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"sed -n '600,650p' .skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/run-command-behaviour.mjs; echo \\\"=== promptFor callers ===\\\"; grep -n \\\"promptFor\\\\|loadRows\\\\|readRows\\\\|promptForRow\\\" .skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/run-command-behaviour.mjs | head -30\"}"},"time":{"start":1794680740211,"end":1794680741592}}}}
