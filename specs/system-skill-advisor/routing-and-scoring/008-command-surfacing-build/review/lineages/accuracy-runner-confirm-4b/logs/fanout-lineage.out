ser-role messages, so the reader has to\n34: // recognize those tags explicitly; any other text is operator content even when\n35: // it happens to open with a tag-like string.\n36: const INJECTED_USER_TAGS = ['<environment_context>', '<user_instructions>', '<permissions instructions>'];\n37: \n38: // ─────────────────────────────────────────────────────────────────────────────\n39: // 3. STORE\n40: // ─────────────────────────────────────────────────────────────────────────────\n41: \n42: export function codexStoreRoot(options = {}) {\n43:   if (options.codexRoot) return options.codexRoot;\n44:   return join(envOf(options).CODEX_HOME || join(homeDir(options), '.codex'), 'sessions');\n45: }\n46: \n47: function recordedSessionId(lines, transcriptPath) {\n48:   const metadata = lines.find((line) => line?.type === 'session_meta');\n49:   const declared = metadata?.payload?.id;\n50:   if (typeof declared === 'string' && declared) return declared;\n51: \n52:   const fileName = basename(transcriptPath);\n53:   const match = fileName.match(ROLLOUT_PATTERN);\n54:   if (match?.[1]) return match[1];\n55:   return fileName.endsWith(TRANSCRIPT_EXT) ? fileName.slice(0, -TRANSCRIPT_EXT.length) : fileName;\n56: }\n57: \n58: // ─────────────────────────────────────────────────────────────────────────────\n59: // 4. ENTRY MAPPING\n60: // ─────────────────────────────────────────────────────────────────────────────\n61: \n62: function messageBlocks(payload) {\n63:   const blocks = [];\n64:   const itemType = payload.role === 'assistant' ? 'output_text' : 'input_text';\n65:   for (const item of Array.isArray(payload.content) ? payload.content : []) {\n66:     if (!item || typeof item !== 'object') continue;\n67:     if ((item.type === itemType || item.type === 'text') && typeof item.text === 'string') {\n68:       blocks.push(textBlock(item.text));\n69:     } else if (item.type === 'thinking' && typeof item.thinking === 'string') {\n70:       blocks.push(thinkingBlock(item.thinking));\n71:     }\n72:   }\n73:   return blocks;\n74: }\n75: \n76: function recordsFromLines(lines) {\n77:   const records = [];\n78: \n79:   lines.forEach((line, index) => {\n80:     if (line?.type !== 'response_item') return;\n81:     const payload = line.payload;\n82:     if (!payload || typeof payload !== 'object') return;\n83: \n84:     const timestamp = line.timestamp;\n85:     const id = typeof payload.id === 'string' && payload.id\n86:       ? payload.id\n87:       : typeof payload.call_id === 'string' && payload.call_id\n88:         ? payload.call_id\n89:         : `codex-entry-${index}`;\n90: \n91:     if (payload.type === 'message') {\n92:       if (payload.role !== 'user' && payload.role !== 'assistant') return;\n93:       const blocks = messageBlocks(payload);\n94:       const text = contentText(blocks);\n95:       if (!text) return;\n96:       // Codex injects environment context and harness notes as user messages;\n97:       // they are attached to the turn, not typed by the operator.\n98:       if (payload.role === 'user' && INJECTED_USER_TAGS.some((tag) => text.startsWith(tag))) return;\n99:       records.push({ id, role: payload.role, timestamp, content: blocks });\n100:       return;\n[Output truncated. Continue reading with offset: 101]","title":"read","metadata":{"metadata":{"truncated":true},"content":[{"type":"text","text":"Read file .skilled/hooks/shared/session-readers/codex.mjs, lines 1-100\n1: // ───────────────────────────────────────────────────────────────────\n2: // MODULE: Codex Rollout Reader\n3: // ───────────────────────────────────────────────────────────────────\n4: // Codex supplies a nullable transcript path. A missing path has no owner to\n5: // fall back to, so the reader stops rather than guessing at another runtime's\n6: // store. The rollout header is the identity authority: its `session_meta`\n7: // payload id wins over the file name when the two disagree.\n8: \n9: // ────────────────────────────────────────────────────────────