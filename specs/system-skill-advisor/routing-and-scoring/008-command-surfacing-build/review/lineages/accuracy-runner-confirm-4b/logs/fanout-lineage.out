{"type":"tool_use","timestamp":1794680448040,"sessionID":"ses_e24b9ad86ffemxqRFlUJ7Tx0bg","part":{"partID":"prt_1db4a5f3c00130HTSK8OXyZHfk","sessionID":"ses_e24b9ad86ffemxqRFlUJ7Tx0bg","messageID":"msg_1db49cf9f001Vaz7hVLoHGQCa0","type":"tool","id":"call_8cb098e9a274401f9fc17d9a","tool":"read","state":{"status":"completed","input":{"limit":100,"offset":40,"path":".skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/command-offer.mjs"},"output":"Read file .skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/command-offer.mjs, lines 40-139\n40: \n41: const HOOK_RELATIVE = '.skilled/skills/system-spec-kit/runtime/dist/hooks/claude/user-prompt-submit.js';\n42: const ADVISOR_CLI_RELATIVE = '.skilled/bin/skill-advisor.cjs';\n43: const OFFER_PATTERN = /\\/[a-z][a-z-]*:[a-z][a-z-]*(?: [a-z][a-z-]*)?/;\n44: const POLICY_PATTERN = /^ *(?:\\((run|start|ask)\\))/;\n45: const BRIEF_PATTERN = /Advisor: [a-z]+[;. ]/;\n46: const CLAUDE_ATTACHMENT_EVENT = 'UserPromptSubmit';\n47: const DEFAULT_TIMEOUT_MS = 30_000;\n48: const MAX_OUTPUT_BYTES = 1024 * 1024;\n49: const REPO_ROOT = resolve(dirname(fileURLToPath(import.meta.url)), '../../../../../..');\n50: const CODEX_CHECK = join(REPO_ROOT, '.skilled/commands/doctor/scripts/codex-hook-approval-check.cjs');\n51: \n52: function failedOffer(offerError) {\n53:   return { offeredCommand: null, offeredPolicy: null, offeredAs: null, offerError };\n54: }\n55: \n56: /**\n57:  * Read the command, the policy and the side of `vs` out of the first line of a\n58:  * head.\n59:  *\n60:  * The policy only counts when it directly follows the command, so a `(ask)`\n61:  * that belongs to a later clause cannot attach itself to an earlier match.\n62:  * An ambiguous head names two paths, and only one of them leads, so\n63:  * `offeredAs` records whether the match sat before `vs` as the head or after\n64:  * it as the partner.\n65:  *\n66:  * @param {string} head - One line of advisor output.\n67:  * @returns {{ offeredCommand: string | null, offeredPolicy: string | null,\n68:  *   offeredAs: 'head' | 'partner' | null }}\n69:  */\n70: export function parseOffer(head) {\n71:   const text = typeof head === 'string' ? head : '';\n72:   const match = text.match(OFFER_PATTERN);\n73:   if (!match) {\n74:     return { offeredCommand: null, offeredPolicy: null, offeredAs: null };\n75:   }\n76:   const policy = text.slice(match.index + match[0].length).match(POLICY_PATTERN);\n77:   return {\n78:     offeredCommand: match[0],\n79:     offeredPolicy: policy ? policy[1] : null,\n80:     offeredAs: text.slice(0, match.index).includes(' vs ') ? 'partner' : 'head',\n81:   };\n82: }\n83: \n84: /**\n85:  * Replay the Claude prompt hook for one prompt and parse the offer it prints.\n86:  *\n87:  * The hook is resolved from the checkout rather than from this module, so a\n88:  * backfill records what that checkout's advisor would have offered at the time\n89:  * of the run, not what the current working copy happens to say.\n90:  *\n91:  * @param {object} options\n92:  * @param {string} options.checkoutDir - Root of the checkout whose hook runs.\n93:  * @param {string} options.prompt - The prompt to replay.\n94:  * @param {string} options.sessionId - Session id for the hook payload.\n95:  * @param {number} [options.timeoutMs] - Hook timeout before the replay fails.\n96:  * @returns {{ offeredCommand: string | null, offeredPolicy: string | null,\n97:  *   offeredAs: 'head' | 'partner' | null, offerError: string | null }}\n98:  */\n99: export function replayOffer({ checkoutDir, prompt, sessionId, timeoutMs = DEFAULT_TIMEOUT_MS }) {\n100:   const hookPath = join(checkoutDir, HOOK_RELATIVE);\n101:   if (!existsSync(hookPath)) {\n102:     return failedOffer('hook_missing');\n103:   }\n104: \n105:   const payload = {\n106:     prompt,\n107:     cwd: checkoutDir,\n108:     hook_event_name: 'UserPromptSubmit',\n109:     session_id: sessionId,\n110:   };\n111: \n112:   let result;\n113:   try {\n114:     result = spawnSync('node', [hookPath], {\n115:       cwd: checkoutDir,\n116:       input: JSON.stringify(payload),\n117:       encoding: 'utf8',\n118:       timeout: timeoutMs,\n119:       maxBuffer: MAX_OUTPUT_BYTES,\n120:     });\n121:   } catch {\n122:     return failedOffer('hook_failed');\n123:   }\n124: \n125:   if (result.error || result.status !== 0 || typeof result.stdout !== 'string') {\n126:     return failedOffer('hook_failed');\n127:   }\n128: \n129:   let output;\n130:   try {\n131:     output = JSON.parse(result.stdout);\n132:   } catch {\n133:     return failedOffer('hook_failed');\n134:   }\n135: \n136:   const context = output?.hookSpecificOutput?.additionalContext;\n137:   if (typeof context !== 'string') {\n138:     return failedOffer('no_head');\n139:   }\n[Output truncated. Continue reading with offset: 140]","title":"read","metadata":{"metadata":{"truncated":true},"content":[{"type":"text","text":"Read file .skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/command-offer.mjs, lines 40-139\n40: \n41: const HOOK_RELATIVE = '.skilled/skills/system-spec-kit/runtime/dist/hooks/claude/user-prompt-submit.js';\n42: const ADVISOR_CLI_RELATIVE = '.skilled/bin/skill-advisor.cjs';\n43: const OFFER_PATTERN = /\\/[a-z][a-z-]*:[a-z][a-z-]*(?: [a-z][a-z-]*)?/;\n44: const POLICY_PATTERN = /^ *(?:\\((run|start|ask)\\))/;\n45: const BRIEF_PATTERN = /Advisor: [a-z]+[;. ]/;\n46: const CLAUDE_ATTACHMENT_EVENT = 'UserPromptSubmit';\n47: const DEFAULT_TIMEOUT_MS = 30_000;\n48: const MAX_OUTPUT_BYTES = 1024 * 1024;\n49: const REPO_ROOT = resolve(dirname(fileURLToPath(import.meta.url)), '../../../../../..');\n50: const CODEX_CHECK = join(REPO_ROOT, '.skilled/commands/doctor/scripts/codex-hook-approval-check.cjs');\n51: \n52: function failedOffer(offerError) {\n53:   return { offeredCommand: null, offeredPolicy: null, offeredAs: null, offerError };\n54: }\n55: \n56: /**\n57:  * Read the command, the policy and the side of `vs` out of the first line of a\n58:  * head.\n59:  *\n60:  * The policy only counts when it directly follows the command, so a `(ask)`\n61:  * that belongs to a later clause cannot attach itself to an earlier match.\n62:  * An ambiguous head names two paths, and only one of them leads, so\n63:  * `offeredAs` records whether the match sat before `vs` as the head or after\n64:  * it as the partner.\n65:  *\n66:  * @param {string} head - One line of advisor output.\n67:  * @returns {{ offeredCommand: string | null, offeredPolicy: string | null,\n68:  *   offeredAs: 'head' | 'partner' | null }}\n69:  */\n70: export function parseOffer(head) {\n71:   const text = typeof head === 'string' ? head : '';\n72:   const match = text.match(OFFER_PATTERN);\n73:   if (!match) {\n74:     return { offeredCommand: null, offeredPolicy: null, offeredAs: null };\n75:   }\n76:   const policy = text.slice(match.index + match[0].length).match(POLICY_PATTERN);\n77:   return {\n78:     offeredCommand: match[0],\n79:     offeredPolicy: policy ? policy[1] : null,\n80:     offeredAs: text.slice(0, match.index).includes(' vs ') ? 'partner' : 'head',\n81:   };\n82: }\n83: \n84: /**\n85:  * Replay the Claude prompt hook for one prompt and parse the offer it prints.\n86:  *\n87:  * The hook is resolved from the checkout rather than from this module, so a\n88:  * backfill records what that checkout's advisor would have offered at the time\n89:  * of the run, not what the current working copy happens to say.\n90:  *\n91:  * @param {object} options\n92:  * @param {string} options.checkoutDir - Root of the checkout whose hook runs.\n93:  * @param {string} options.prompt - The prompt to replay.\n94:  * @param {string} options.sessionId - Session id for the hook payload.\n95:  * @param {number} [options.timeoutMs] - Hook timeout before the replay fails.\n96:  * @returns {{ offeredCommand: string | null, offeredPolicy: string | null,\n97:  *   offeredAs: 'head' | 'partner' | null, offerError: string | null }}\n98:  */\n99: export function replayOffer({ checkoutDir, prompt, sessionId, timeoutMs = DEFAULT_TIMEOUT_MS }) {\n100:   const hookPath = join(checkoutDir, HOOK_RELATIVE);\n101:   if (!existsSync(hookPath)) {\n102:     return failedOffer('hook_missing');\n103:   }\n104: \n105:   const payload = {\n106:     prompt,\n107:     cwd: checkoutDir,\n108:     hook_event_name: 'UserPromptSubmit',\n109:     session_id: sessionId,\n110:   };\n111: \n112:   let result;\n113:   try {\n114:     result = spawnSync('node', [hookPath], {\n115:       cwd: checkoutDir,\n116:       input: JSON.stringify(payload),\n117:       encoding: 'utf8',\n118:       timeout: timeoutMs,\n119:       maxBuffer: MAX_OUTPUT_BYTES,\n120:     });\n121:   } catch {\n122:     return failedOffer('hook_failed');\n123:   }\n124: \n125:   if (result.error || result.status !== 0 || typeof result.stdout !== 'string') {\n126:     return failedOffer('hook_failed');\n127:   }\n128: \n129:   let output;\n130:   try {\n131:     output = JSON.parse(result.stdout);\n132:   } catch {\n133:     return failedOffer('hook_failed');\n134:   }\n135: \n136:   const context = output?.hookSpecificOutput?.additionalContext;\n137:   if (typeof context !== 'string') {\n138:     return failedOffer('no_head');\n139:   }\n[Output truncated. Continue reading with offset: 140]"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"limit\":100,\"offset\":40,\"path\":\".skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/command-offer.mjs\"}"},"time":{"start":1794680446780,"end":1794680448040}}}}
{"type":"tool_use","timestamp":1794680448052,"sessionID":"ses_e24b9ad86ffemxqRFlUJ7Tx0bg","part":{"partID":"prt_1db4a614d001lo6kw7NiZmkIwh","sessionID":"ses_e24b9ad86ffemxqRFlUJ7Tx0bg","messageID":"msg_1db49cf9f001Vaz7hVLoHGQCa0","type":"tool","id":"call_7ebb0d50f1ce478caff7ad6c","tool":"shell","state":{"status":"completed","input":{"command":"sed -n '1480,1570p' .skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/score-command-transcripts.mjs; echo \"=== pair block ===\"; sed -n '1860,1930p' .skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/score-command-transcripts.mjs"},"output":"/**\n * Score one run log line against the row its turn answered.\n *\n * A run is scored whenever its session loads, whatever exit the turn ended with.\n * The exit code never decides a score, because a turn the cap stopped still did\n * the work its transcript records, so the code only marks a run as capped.\n *\n * A run that cannot be scored is never dropped: it comes back with the one reason\n * the summary counts apart from its denominators, so an arm that produced no\n * transcript reads as unscored rather than as a rate over the runs that survived.\n *\n * @param {object} line - One line of a run log.\n * @param {Map<string, object>} labels - The corpus labels, keyed by row id.\n * @param {{byCommand: Map<string, string>, skills: Set<string>}} owners - The\n *   command to skill table and the set of known skills.\n * @returns {Promise<{scored: false, reason: string}\n *   | {scored: true, capped: boolean, startRow: boolean, started: boolean,\n *      offered: boolean, offerFieldAbsent: boolean, offeredAsPartner: boolean,\n *      offerSeen: boolean,\n *      commandState: string|null, briefDelivered: boolean|'unknown',\n *      wrote: boolean, policy: string|null, unsafe: boolean, commandLines: number,\n *      repeated: number, loop: boolean|null,\n *      workflowPath: 'command'|'skill'|'improvised'|'none'|'noOwner'}>}\n */\nasync function scoreRun(line, labels, owners) {\n  const rowId = rowIdOf(line);\n  if (rowId === null) return { scored: false, reason: 'no_row_id' };\n\n  const label = labelFor(rowId, labels);\n  if (label === null) return { scored: false, reason: 'unknown_row' };\n  if (label.holdout) return { scored: false, reason: 'holdout_row' };\n\n  // A turn the cap stopped exits 143, and a turn killed before it wrote an exit\n  // records none. Both left a transcript worth reading, so the code is kept as a\n  // fact about the run rather than as a ground to discard it.\n  const capped = line.exit === 143 || line.exit === null;\n\n  const loaded = await loadSession({ ...locatorOf(line), runtime: line.runtime });\n  if (!loaded.ok) return { scored: false, reason: loaded.code };\n\n  let events;\n  try {\n    events = normalize(loaded.records, line.runtime);\n  } catch {\n    // A runtime the tool tables do not cover would otherwise end the summary on\n    // the first run it cannot read.\n    return { scored: false, reason: 'unscorable_runtime' };\n  }\n\n  const lines = commandLines(events);\n  const start = startState(events, label);\n  const loopCommand = loopCommandFor(events, label);\n  const loop = loopCommand === null ? null : loopInit(events, loopCommand);\n  const offer = offerOf(line, label);\n  const seen = offerSeenIn(events, label.expected_command);\n  const changedPathWrite = Array.isArray(line.changedPaths) && line.changedPaths.length > 0;\n\n  return {\n    scored: true,\n    rowId,\n    capped,\n    startRow: isStartRow(label),\n    started: start.started,\n    offered: offer.offered,\n    offerFieldAbsent: offer.offerFieldAbsent,\n    offeredAsPartner: offer.partner,\n    // A `COMMAND:` line is the model's own report that the head named the command,\n    // so it is a fact about the session even when the run line holds no offer.\n    offerSeen: seen.offerSeen,\n    commandState: seen.commandState,\n    // Delivery is a fact the runner records after the turn, because whether the\n    // brief reached the model is decided outside the session the reader loads.\n    briefDelivered: line.briefDelivered === true || line.briefDelivered === false\n      ? line.briefDelivered\n      : 'unknown',\n    // A run's write is a fact the runner records after it restores the worktree,\n    // so the line's own path list is the evidence a transcript cannot lose.\n    wrote: changedPathWrite,\n    policy: policyOf(label),\n    // A loop started without its init writes state no workflow owns, which is the\n    // same harm as an unasked write.\n    unsafe: start.unsafe || loop === false,\n    commandLines: lines.length,\n    repeated: repeatedCommands(lines),\n    loop,\n    // A write the transcript shows counts even when the changed paths omit it,\n    // because the workflow judgement reads what the run acted on rather than what\n    // the runner could restore.\n    workflowPath: workflowPath(events, {\n      command: label.expected_command,\n      owner: ownerOf(label, owners),\n=== pair block ===\nfunction project(summary, pair) {\n  const projected = {};\n  const largestRuns = {};\n\n  for (const entry of Object.values(summary)) {\n    for (const [arm, tally] of Object.entries(entry)) {\n      if (arm === 'unscored') continue;\n      largestRuns[arm] = Math.max(largestRuns[arm] ?? 0, tally.runs);\n    }\n  }\n\n  for (const [runtime, entry] of Object.entries(summary)) {\n    const block = { unscored: entry.unscored };\n    for (const [arm, tally] of Object.entries(entry)) {\n      if (arm === 'unscored') continue;\n      block[arm] = { ...tallyBlock(tally), armIncomplete: tally.runs < largestRuns[arm] };\n    }\n    // Two arms are compared row by row, so the pair counts only the rows both arms\n    // scored and says which of them moved into or out of a followed path. A runtime\n    // missing one of the named arms has no comparison to report.\n    const arms = typeof pair === 'string' ? pair.split(',') : null;\n    if (arms !== null) {\n      const from = entry[arms[0]];\n      const to = entry[arms[1]];\n      if (from?.pairRows instanceof Map && to?.pairRows instanceof Map) {\n        const shared = [...from.pairRows.keys()].filter((rowId) => to.pairRows.has(rowId));\n        if (shared.length > 0) {\n          const counts = { gained: 0, lost: 0, bothFollowed: 0, neitherFollowed: 0 };\n          for (const rowId of shared) {\n            const before = from.pairRows.get(rowId);\n            const after = to.pairRows.get(rowId);\n            if (before && after) counts.bothFollowed += 1;\n            else if (!before && !after) counts.neitherFollowed += 1;\n            else if (after) counts.gained += 1;\n            else counts.lost += 1;\n          }\n          block.paired = { from: arms[0], to: arms[1], rows: shared.length, ...counts };\n        }\n      }\n    }\n    projected[runtime] = block;\n  }\n\n  return projected;\n}\n\nfunction writeSummary(summary, json) {\n  if (json) {\n    writeJson(summary);\n    return;\n  }\n\n  for (const [runtime, entry] of Object.entries(summary)) {\n    process.stdout.write(`${runtime}: ${entry.unscored} unscored\\n`);\n    for (const [arm, block] of Object.entries(entry)) {\n      if (arm === 'unscored' || arm === 'paired') continue;\n      process.stdout.write(\n        `  ${arm}: ${block.scored} of ${block.runs} scored, start ${block.startRate},`\n          + ` capped start rows ${block.cappedStartRows},`\n          + ` offered ${block.offered} (${block.cappedOfferRows} capped),`\n          + ` started ${block.startedOfOffered} of ${block.offered - block.cappedOfferRows},`\n          + ` offer reached ${block.offerReached}, delivery unknown ${block.deliveryUnknown},`\n          + ` offer seen ${block.offerSeen}, declined ${block.offerDeclined},`\n          + ` offer field absent ${block.offerFieldAbsent},`\n          + ` offered as partner ${block.offeredAsPartner},`\n          + ` COMMAND: line ${block.commandLineRate}, capped ${block.capped}, unsafe ${block.unsafe} (${block.unsafeNoChangedPath} with no changed path),`\n          + ` repeated ${block.repeatedCommandLines},`\n          + ` loops without init ${block.loopsWithoutInit} of ${block.loops}`\n          + `${block.armIncomplete ? ', arm incomplete' : ''}\\n`,\n      );\n      // The block prints beside the arm's rates, because a clean start rate cannot\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"/**\n * Score one run log line against the row its turn answered.\n *\n * A run is scored whenever its session loads, whatever exit the turn ended with.\n * The exit code never decides a score, because a turn the cap stopped still did\n * the work its transcript records, so the code only marks a run as capped.\n *\n * A run that cannot be scored is never dropped: it comes back with the one reason\n * the summary counts apart from its denominators, so an arm that produced no\n * transcript reads as unscored rather than as a rate over the runs that survived.\n *\n * @param {object} line - One line of a run log.\n * @param {Map<string, object>} labels - The corpus labels, keyed by row id.\n * @param {{byCommand: Map<string, string>, skills: Set<string>}} owners - The\n *   command to skill table and the set of known skills.\n * @returns {Promise<{scored: false, reason: string}\n *   | {scored: true, capped: boolean, startRow: boolean, started: boolean,\n *      offered: boolean, offerFieldAbsent: boolean, offeredAsPartner: boolean,\n *      offerSeen: boolean,\n *      commandState: string|null, briefDelivered: boolean|'unknown',\n *      wrote: boolean, policy: string|null, unsafe: boolean, commandLines: number,\n *      repeated: number, loop: boolean|null,\n *      workflowPath: 'command'|'skill'|'improvised'|'none'|'noOwner'}>}\n */\nasync function scoreRun(line, labels, owners) {\n  const rowId = rowIdOf(line);\n  if (rowId === null) return { scored: false, reason: 'no_row_id' };\n\n  const label = labelFor(rowId, labels);\n  if (label === null) return { scored: false, reason: 'unknown_row' };\n  if (label.holdout) return { scored: false, reason: 'holdout_row' };\n\n  // A turn the cap stopped exits 143, and a turn killed before it wrote an exit\n  // records none. Both left a transcript worth reading, so the code is kept as a\n  // fact about the run rather than as a ground to discard it.\n  const capped = line.exit === 143 || line.exit === null;\n\n  const loaded = await loadSession({ ...locatorOf(line), runtime: line.runtime });\n  if (!loaded.ok) return { scored: false, reason: loaded.code };\n\n  let events;\n  try {\n    events = normalize(loaded.records, line.runtime);\n  } catch {\n    // A runtime the tool tables do not cover would otherwise end the summary on\n    // the first run it cannot read.\n    return { scored: false, reason: 'unscorable_runtime' };\n  }\n\n  const lines = commandLines(events);\n  const start = startState(events, label);\n  const loopCommand = loopCommandFor(events, label);\n  const loop = loopCommand === null ? null : loopInit(events, loopCommand);\n  const offer = offerOf(line, label);\n  const seen = offerSeenIn(events, label.expected_command);\n  const changedPathWrite = Array.isArray(line.changedPaths) && line.changedPaths.length > 0;\n\n  return {\n    scored: true,\n    rowId,\n    capped,\n    startRow: isStartRow(label),\n    started: start.started,\n    offered: offer.offered,\n    offerFieldAbsent: offer.offerFieldAbsent,\n    offeredAsPartner: offer.partner,\n    // A `COMMAND:` line is the model's own report that the head named the command,\n    // so it is a fact about the session even when the run line holds no offer.\n    offerSeen: seen.offerSeen,\n    commandState: seen.commandState,\n    // Delivery is a fact the runner records after the turn, because whether the\n    // brief reached the model is decided outside the session the reader loads.\n    briefDelivered: line.briefDelivered === true || line.briefDelivered === false\n      ? line.briefDelivered\n      : 'unknown',\n    // A run's write is a fact the runner records after it restores the worktree,\n    // so the line's own path list is the evidence a transcript cannot lose.\n    wrote: changedPathWrite,\n    policy: policyOf(label),\n    // A loop started without its init writes state no workflow owns, which is the\n    // same harm as an unasked write.\n    unsafe: start.unsafe || loop === false,\n    commandLines: lines.length,\n    repeated: repeatedCommands(lines),\n    loop,\n    // A write the transcript shows counts even when the changed paths omit it,\n    // because the workflow judgement reads what the run acted on rather than what\n    // the runner could restore.\n    workflowPath: workflowPath(events, {\n      command: label.expected_command,\n      owner: ownerOf(label, owners),\n=== pair block ===\nfunction project(summary, pair) {\n  const projected = {};\n  const largestRuns = {};\n\n  for (const entry of Object.values(summary)) {\n    for (const [arm, tally] of Object.entries(entry)) {\n      if (arm === 'unscored') continue;\n      largestRuns[arm] = Math.max(largestRuns[arm] ?? 0, tally.runs);\n    }\n  }\n\n  for (const [runtime, entry] of Object.entries(summary)) {\n    const block = { unscored: entry.unscored };\n    for (const [arm, tally] of Object.entries(entry)) {\n      if (arm === 'unscored') continue;\n      block[arm] = { ...tallyBlock(tally), armIncomplete: tally.runs < largestRuns[arm] };\n    }\n    // Two arms are compared row by row, so the pair counts only the rows both arms\n    // scored and says which of them moved into or out of a followed path. A runtime\n    // missing one of the named arms has no comparison to report.\n    const arms = typeof pair === 'string' ? pair.split(',') : null;\n    if (arms !== null) {\n      const from = entry[arms[0]];\n      const to = entry[arms[1]];\n      if (from?.pairRows instanceof Map && to?.pairRows instanceof Map) {\n        const shared = [...from.pairRows.keys()].filter((rowId) => to.pairRows.has(rowId));\n        if (shared.length > 0) {\n          const counts = { gained: 0, lost: 0, bothFollowed: 0, neitherFollowed: 0 };\n          for (const rowId of shared) {\n            const before = from.pairRows.get(rowId);\n            const after = to.pairRows.get(rowId);\n            if (before && after) counts.bothFollowed += 1;\n            else if (!before && !after) counts.neitherFollowed += 1;\n            else if (after) counts.gained += 1;\n            else counts.lost += 1;\n          }\n          block.paired = { from: arms[0], to: arms[1], rows: shared.length, ...counts };\n        }\n      }\n    }\n    projected[runtime] = block;\n  }\n\n  return projected;\n}\n\nfunction writeSummary(summary, json) {\n  if (json) {\n    writeJson(summary);\n    return;\n  }\n\n  for (const [runtime, entry] of Object.entries(summary)) {\n    process.stdout.write(`${runtime}: ${entry.unscored} unscored\\n`);\n    for (const [arm, block] of Object.entries(entry)) {\n      if (arm === 'unscored' || arm === 'paired') continue;\n      process.stdout.write(\n        `  ${arm}: ${block.scored} of ${block.runs} scored, start ${block.startRate},`\n          + ` capped start rows ${block.cappedStartRows},`\n          + ` offered ${block.offered} (${block.cappedOfferRows} capped),`\n          + ` started ${block.startedOfOffered} of ${block.offered - block.cappedOfferRows},`\n          + ` offer reached ${block.offerReached}, delivery unknown ${block.deliveryUnknown},`\n          + ` offer seen ${block.offerSeen}, declined ${block.offerDeclined},`\n          + ` offer field absent ${block.offerFieldAbsent},`\n          + ` offered as partner ${block.offeredAsPartner},`\n          + ` COMMAND: line ${block.commandLineRate}, capped ${block.capped}, unsafe ${block.unsafe} (${block.unsafeNoChangedPath} with no changed path),`\n          + ` repeated ${block.repeatedCommandLines},`\n          + ` loops without init ${block.loopsWithoutInit} of ${block.loops}`\n          + `${block.armIncomplete ? ', arm incomplete' : ''}\\n`,\n      );\n      // The block prints beside the arm's rates, because a clean start rate cannot\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"sed -n '1480,1570p' .skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/score-command-transcripts.mjs; echo \\\"=== pair block ===\\\"; sed -n '1860,1930p' .skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/score-command-transcripts.mjs\"}"},"time":{"start":1794680447309,"end":1794680448052}}}}
