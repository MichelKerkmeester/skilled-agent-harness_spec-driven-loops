: false,\n131:       });\n132:     }\n133:   });\n134: \n135:   return records;\n136: }\n137: \n138: // ─────────────────────────────────────────────────────────────────────────────\n139: // 5. LOADER\n140: // ─────────────────────────────────────────────────────────────────────────────\n141: \n142: export function loadCodexSession({ sessionId, transcriptPath, ...options } = {}) {\n143:   if (typeof transcriptPath !== 'string' || !transcriptPath.trim()) {\n144:     return { ok: false, code: 'locator_unavailable' };\n145:   }\n146:   if (!isSafeSessionId(sessionId)) {\n147:     return { ok: false, code: sessionId ? 'session_mismatch' : 'locator_unavailable' };\n148:   }\n149: \n150:   // Containment is decided before the file is opened, so a path outside the\n151:   // store is refused without its content ever being read.\n152:   const root = codexStoreRoot(options);\n153:   const containment = resolveInside({ path: transcriptPath, root });\n154:   if (!containment.ok) {\n155:     if (containment.code === 'session_mismatch') return containment;\n156:     try {\n157:       statSync(root);\n158:       return { ok: false, code: 'session_not_found' };\n159:     } catch {\n160:       return { ok: false, code: 'store_unreadable' };\n161:     }\n162:   }\n163:   const storePath = containment.path;\n164: \n165:   let raw;\n166:   try {\n167:     // The read is the file containment resolved, so a path repointed after the\n168:     // check is not read in its place.\n169:     raw = readFileSync(storePath, 'utf8');\n170:   } catch {\n171:     try {\n172:       statSync(root);\n173:       return { ok: false, code: 'session_not_found' };\n174:     } catch {\n175:       return { ok: false, code: 'store_unreadable' };\n176:     }\n177:   }\n178: \n179:   const lines = parseJsonLines(raw);\n180:   if (recordedSessionId(lines, transcriptPath) !== sessionId) {\n181:     return { ok: false, code: 'session_mismatch' };\n182:   }\n183: \n184:   return {\n185:     ok: true,\n186:     sour