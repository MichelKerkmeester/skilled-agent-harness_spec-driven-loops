ge label (last folder of config.fanout_lineage_artifact_dir) without its -4 suffix, plus shared docs that describe them. Every finding is P0, P1 or P2 with file:line and a concrete input that shows it. Check: behaviour on claude, codex, opencode, pi, devin and dsh; whether a refusal, a question or a mention of a command can still attach or start a mutating command; whether the transcript scorer counts a load, a followed step or an offer that did not happen (Codex exec bodies, rg and grep, heredocs, cd, partner-side commands, paired arms, Wilson ranges); holdout hygiene, so no tune, fix or report path reads or leaks holdout rows; docs that disagree with code. HOLDOUT RULE: never open command-prompts.jsonl or holdout-prompts.jsonl except through jq 'del(.prompt)', never run git diff, git show or git log -p on a path that includes command-prompts.jsonl without the pathspec ':(exclude)**/command-prompts.jsonl', and never print a prompt whose split is holdout: counts only. The reviewer changes no code and writes only inside its lineage folder. It never edits goal.md or any file outside its lineage folder.\",\n  \"reviewScopeFiles\": [\n    \".skilled/skills/system-skill-advisor/runtime/handlers/advisor-recommend.ts\",\n    \".skilled/skills/system-skill-advisor/runtime/lib/command-attach.ts\",\n    \".skilled/skills/system-skill-advisor/runtime/lib/scorer/doctor-helper-handoff.ts\",\n    \".skilled/skills/system-skill-advisor/runtime/lib/scorer/fusion.ts\",\n    \".skilled/skills/system-skill-advisor/runtime/lib/scorer/projection.ts\",\n    \".skilled/skills/system-skill-advisor/runtime/tests/command-attach-guards.vitest.ts\",\n    \".skilled/skills/system-skill-advisor/runtime/tests/command-meaning-anchor.vitest.ts\",\n    \".skilled/skills/system-skill-advisor/runtime/tests/doctor-helper-handoff.vitest.ts\",\n    \".skilled/skills/system-skill-advisor/runtime/tests/handlers/advisor-recommend-compiled-route-option.vitest.ts\",\n    \".skilled/skills/system-skill-advisor/runtime/tests/scorer/doctor-handoff-command.vitest.ts\",\n    \".skilled/skills/system-skill-advisor/runtime/tests/scorer/typed-command-owner.vitest.ts\"\n  ],\n  \"resource_map_present\": false,\n  \"resource_map\": {\n    \"emit\": true\n  },\n  \"severityThreshold\": \"P2\",\n  \"crossReference\": {\n    \"core\": [\n      \"spec_code\",\n      \"checklist_evidence\"\n    ],\n    \"overlay\": [\n      \"skill_agent\",\n      \"agent_cross_runtime\",\n      \"feature_catalog_code\",\n      \"playbook_capability\"\n    ]\n  },\n  \"qualityGateThreshold\": true,\n  \"runtimeCapabilityResolver\": \".skilled/skills/system-deep-loop/deep-review/scripts/runtime-capabilities.cjs\",\n  \"reducerScriptPath\": \".skilled/skills/system-deep-loop/runtime/scripts/reduce-state.cjs\",\n  \"fileProtection\": {\n    \"deep-review-config.json\": \"immutable\",\n    \"deep-review-state.jsonl\": \"append-only\",\n    \"deep-review-findings-registry.json\": \"auto-generated\",\n    \"deep-review-strategy.md\": \"mutable\",\n    \"deep-review-dashboard.md\": \"auto-generated\",\n    \".deep-review-pause\": \"operator-controlled\",\n    \"review-report.md\": \"mutable\",\n    \"review-report-v*.md\": \"write-once\",\n    \"iteration-*.md\": \"write-once\"\n  },\n  \"reducer\": {\n    \"enabled\": true,\n    \"inputs\": [\n      \"latestJSONLDelta\",\n      \"newIterationFile\",\n      \"priorReducedState\"\n    ],\n    \"outputs\": [\n      \"findingsRegistry\",\n      \"dashboardMetrics\",\n      \"strategyUpdates\"\n    ],\n    \"metrics\": [\n      \"dimensionsCovered\",\n      \"findingsBySeverity\",\n      \"openFindings\",\n      \"resolvedFindings\",\n      \"convergenceScore\"\n    ]\n  }\n}\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"cat specs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/review/lineages/scorer-attach-4/deep-review-config.json\"}"},"time":{"start":1794680604172,"end":1794680604994