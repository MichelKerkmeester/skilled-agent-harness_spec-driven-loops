line is written, so a row the dataset guard refuses leaves no output file behind.\nasync function backfillLog(options) {\n  const fixture = resolve(dirname(options.backfill), G2_FIXTURE_DIRNAME);\n  const result = await backfillRunLog({\n    inPath: options.backfill,\n    outPath: options.out,\n    promptFor: (rowId, line) => promptFor(rowId, lineFixture(line, fixture)),\n    briefOnly: options.briefOnly,\n  });\n  writeJson(result);\n  return result.ok ? 0 : EXIT_REFUSED;\n}\n\nasync function main(argv) {\n  try {\n    const options = parseOptions(argv);\n    // Selection runs before the mode check, so an id the dataset guard refuses is\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"grep -rn \\\"g2-\\\" .skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/score-command-transcripts.mjs .skilled/skills/system-skill-advisor/runtime/tests/command-behaviour-guards.vitest.ts .skilled/skills/system-skill-advisor/runtime/tests/command-transcript-score.vitest.ts 2>/dev/null | head -20; echo \\\"=== runner G2 id use ===\\\"; sed -n '1230,1275p' .skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/run-command-behaviour.mjs\"}"},"time":{"start":1794680964750,"end":1794680965958}}}}
