"{repo_root}\"\n1963:           timeout_seconds: \"{config.executor.timeoutSeconds}\"\n1964:           wait_for_completion: true\n1965:           notes:\n1966:             - \"cli-pi single-executor: dispatches per-iteration through the shared fan-out command builder (buildLineageCommand) so the enforced cli-pi model allowlist + headless write flags stay one source of truth; runAuditedExecutorCommand emits INTENT + COMPLETION receipts\"\n1967:             - \"Fails closed when pi is absent or the model is off the allowlist (buildLineageCommand throws, exit non-zero) — a requested cli-pi executor never degrades to native\"\n1968:             - \"cli-deepseek-harness has no single-executor path: its branch above exits 2, and the kind runs only as a fan-out lineage\"\n1969:         post_dispatch_validate:\n1970:           validator: \".skilled/skills/system-deep-loop/runtime/lib/deep-loop/post-dispatch-validate.ts#validateIterationOutputs\"\n1971:           command: \"node .skilled/skills/system-deep-loop/runtime/scripts/verify-iteration.cjs --loop-type review --artifact-dir {artifact_dir} --iteration {current_iteration}\"\n1972:           command_note: \"Mechanical leaf-reliability gate: exit 0 = complete; non-zero prints one machine reason (dispatch_failed|iteration_file_missing|iteration_verdict_missing|state_record_missing|route_proof_missing|route_proof_mismatch|delta_file_missing). dispatch_failed means the narrative is missing and the completion receipt shows a non-zero exit or a signal. The script enforces the artifact + route-proof contract instead of trusting the leaf to self-report, and a non-zero exit triggers on_failure.redispatch_once.\"\n1973:           assert_exists: \"{state_paths.iteration_pattern}\"\n1974:           assert_appended: \"{state_paths.state_log}\"\n1975:           assert_jsonl_fields: [type, iteration, mode, run, status, focus, dimensions, filesReviewed, findingsCount, findingsSummary, findingsNew, findingDetails, newFindingsRatio, sessionId, generation, lineageMode, timestamp, durationMs]\n1976:           route_proof:\n1977:             mode: review\n1978:             target_agent: deep-review\n1979:             agent_definition_loaded: true\n1980:             resolved_route: \"Resolved route: mode=review target_agent=deep-review\"\n1981:           dispatchReceipt:\n1982:             receiptDir: \"{state_paths.packet_dir}/dispatch-receipts\"\n1983:             dispatchId: \"review-i{current_iteration}-g{generation}\"\n1984:           assert_canonical_type: \"iteration\"\n1985:           assert_delta_file_exists: \"{state_paths.delta_pattern}\"\n1986:           assert_delta_file_has_iteration_record: true\n1987:           failure_reasons:\n1988:             - iteration_file_missing\n1989:             - iteration_file_empty\n1990:             - jsonl_not_appended\n1991:             - jsonl_missing_fields\n1992:             - jsonl_parse_error\n1993:             - jsonl_wrong_type\n1994:             - delta_file_missing\n1995:             - delta_file_empty\n1996:             - delta_file_missing_iteration_record\n1997:             - executor_missing\n1998:             - dispatch_failure_logged\n1999:             - v2_missing_ledger\n2000:             - v2_uncited_ledger_row\n2001:             - v2_broken_linked_finding\n2002:             - v2_shallow_finding_details\n2003:             - delta_iteration_id_mismatch\n2004:             - state_delta_iteration_mismatch\n2005:             - route_proof_missing\n2006:             - route_proof_mismatch\n2007:           warning_surface:\n2008:             source: \"result.warnings\"\n2009:             action: \"emit schema_advisory canonical conflict event\"\n2010:             severity: \"advisory\"\n2011:             event_shape: '{\"type\":\"event\",\"event\":\"schema_advisory\",\"mode\":\"review\",\"iteration\":{current_iteration},\"warnings\":{result.warnings},\"severity\":\"advisory\",\"timestamp\":\"{ISO_8601_NOW}\"}'\n2012:             note: \"Warnings do not fail dispatch. Hard failures still emit schema_mismatch through on_failure.\"\n2013:           on_failure:\n2014:             action: \"emit schema_mismatch canonical conflict event\"\n2015:             redispatch_once: \"On the FIRST failure of the mechanical command check for this iteration, re-run step_dispatch_iteration exactly once for the same iteration number, then re-run the check. If it still fails, record the iteration as error (per step_evaluate_results.on_missing_outputs) and continue. Never re-dispatch a given iteration more than once.\"\n2016:             escalation: \"After 3 consecutive failures across iterations, trigger stuck_recovery event with diagnostic context\"\n2017:         record_executor_audit:\n2018:           skip_when: \"config.executor.kind == 'native'\"\n2019:           target: \"{state_paths.state_log}\"\n2020:           field: \"executor\"\n2021:           value:\n2022:             kind: \"{config.executor.kind}\"\n2023:             model: \"{config.executor.model}\"\n2024:             reasoningEffort: \"{config.executor.reasoningEffort}\"\n2025:             serviceTier: \"{config.executor.serviceTier}\"\n2026: \n2027:       step_evaluate_results:\n2028:         action: \"Verify iteration outputs and extract metrics\"\n2029:         verify:\n2030:           - file_exists: \"{state_paths.iteration_pattern}\"\n2031:           - jsonl_appended: \"New iteration record in state.jsonl\"\n2032:           - strategy_updated: \"Strategy.md has been modified\"\n2033:         extract:\n[Output truncated. Continue reading with offset: 2034]"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"limit\":700,\"offset\":1334,\"path\":\".skilled/commands/deep/assets/deep-review-auto.yaml\"}"},"time":{"start":1794680245934,"end":1794680246382}}}}
