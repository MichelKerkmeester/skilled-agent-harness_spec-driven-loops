\\".skilled/skills/system-skill-advisor/runtime/lib/command-attach.ts\\\",\\\"utf8\\\");\\nconst re=/\\\\x27(command-[a-z0-9-]+)\\\\x27:\\\\s*\\\\{\\\\s*command:\\\\s*\\\\x27([^\\\\x27]+)\\\\x27,\\\\s*policy:\\\\s*\\\\x27([^\\\\x27]+)\\\\x27,\\\\s*mutating:\\\\s*\\\\x27([^\\\\x27]+)\\\\x27(?:,\\\\s*ownerSkillId:\\\\s*\\\\x27([^\\\\x27]+)\\\\x27)?/g;\\nlet m; const rows=[]; while((m=re.exec(src))) rows.push({id:m[1],command:m[2],policy:m[3],mutating:m[4],owner:m[5]});\\nconsole.log(\\\"parsed\\\",rows.length);\\nconst byCmd=new Map(); for(const r of rows){ (byCmd.get(r.command)||byCmd.set(r.command,[]).get(r.command)).push(r); }\\nfor(const [cmd,list] of byCmd) if(list.length>1) console.log(\\\"DUP\\\",cmd,list.map(r=>`${r.id}:${r.policy}/${r.mutating}`).join(\\\" | \\\"));\\n'\"}"},"time":{"start":1794570477572,"end":1794570481350}}}}
