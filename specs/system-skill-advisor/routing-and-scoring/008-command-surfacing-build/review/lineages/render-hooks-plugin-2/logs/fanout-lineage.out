urn path;\n }\n \n@@ -468,6 +479,7 @@ export function buildAdvisorHookHealthSection(\n   const lastInvocations = records.slice(-MAX_HEALTH_RECORDS);\n   const cacheHits = lastInvocations.filter((record) => record.cacheHit).length;\n   const failOpen = lastInvocations.filter((record) => record.status === 'fail_open').length;\n+  const degraded = lastInvocations.filter((record) => record.degraded === true).length;\n   return {\n     key: 'advisor-hook-health',\n     lastInvocations,\n@@ -477,6 +489,8 @@ export function buildAdvisorHookHealthSection(\n       95,\n     ),\n     rollingFailOpenRate: lastInvocations.length > 0 ? failOpen / lastInvocations.length : 0,\n+    rollingDegradedRate: lastInvocations.length > 0 ? degraded / lastInvocations.length : 0,\n+    lastRecordAt: lastInvocations[lastInvocations.length - 1]?.timestamp ?? null,\n   };\n }\n \n=== degraded refs ===\n.skilled/skills/system-skill-advisor/runtime/lib/metrics.ts:24:export const ADVISOR_HOOK_STATUS_VALUES = ['ok', 'skipped', 'stale', 'degraded', 'fail_open'] as const;\n.skilled/skills/system-skill-advisor/runtime/lib/metrics.ts:63:  readonly degraded?: boolean;\n.skilled/skills/system-skill-advisor/runtime/lib/metrics.ts:392:  readonly degraded?: boolean;\n.skilled/skills/system-skill-advisor/runtime/lib/metrics.ts:410:    ...(input.degraded === true ? { degraded: true } : {}),\n.skilled/skills/system-skill-advisor/runtime/lib/metrics.ts:438:    && (record.degraded === undefined || typeof record.degraded === 'boolean');\n.skilled/skills/system-skill-advisor/runtime/lib/metrics.ts:482:  const degraded = lastInvocations.filter((record) => record.degraded === true).length;\n.skilled/skills/system-skill-advisor/runtime/lib/metrics.ts:492:    rollingDegradedRate: lastInvocations.length > 0 ? degraded / lastInvocations.length : 0,\n.skilled/skills/system-skill-advisor/hooks/claude/user-prompt-submit.ts:134:  readonly degraded?: boolean;\n.skilled/skills/system-skill-advisor/hooks/claude/user-prompt-sub