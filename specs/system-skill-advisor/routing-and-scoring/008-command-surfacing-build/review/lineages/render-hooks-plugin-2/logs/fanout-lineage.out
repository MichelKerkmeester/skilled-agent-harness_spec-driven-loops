{"type":"tool_use","timestamp":1794570648453,"sessionID":"ses_e2b4a243affexa25EPiSDt2Sxc","part":{"partID":"prt_1d4bef7e5001VgmvoSr9uGk9EO","sessionID":"ses_e2b4a243affexa25EPiSDt2Sxc","messageID":"msg_1d4bee8a3001tP4RMXmRq8hlGK","type":"tool","id":"chatcmpl-tool-a110ab14bb6894ee","tool":"shell","state":{"status":"completed","input":{"command":"cd /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research && git diff 35c3188681..HEAD -- .skilled/skills/system-skill-advisor/runtime/lib/subprocess.ts .skilled/skills/system-skill-advisor/hooks/lib/skill-advisor-cli-fallback.ts .skilled/skills/system-skill-advisor/hooks/claude/user-prompt-submit.ts .skilled/skills/system-skill-advisor/hooks/skill-advisor-hook-validation.md"},"output":"diff --git a/.skilled/skills/system-skill-advisor/hooks/claude/user-prompt-submit.ts b/.skilled/skills/system-skill-advisor/hooks/claude/user-prompt-submit.ts\nindex d42d2074cc..db3c2f9bdb 100644\n--- a/.skilled/skills/system-skill-advisor/hooks/claude/user-prompt-submit.ts\n+++ b/.skilled/skills/system-skill-advisor/hooks/claude/user-prompt-submit.ts\n@@ -131,6 +131,7 @@ interface HookDiagnosticInput {\n   readonly errorCode?: unknown;\n   readonly errorDetails?: string;\n   readonly skillLabel?: string | null;\n+  readonly degraded?: boolean;\n   readonly generation?: number;\n   readonly emittedBytes?: number;\n   readonly directivesSuppressed?: boolean;\n@@ -422,6 +423,7 @@ export async function handleClaudeUserPromptSubmit(\n       errorCode: result.diagnostics?.errorCode,\n       errorDetails: result.diagnostics?.errorMessage ?? result.diagnostics?.policyReason ?? result.diagnostics?.staleReason,\n       skillLabel: skillLabelFor(result),\n+      degraded: result.metrics.degraded === true,\n       emittedBytes: Buffer.byteLength(effectiveEmitted, 'utf8'),\n       directivesSuppressed: effectiveEmitted !== emitted,\n     }, writeDiagnostic);\ndiff --git a/.skilled/skills/system-skill-advisor/hooks/lib/skill-advisor-cli-fallback.ts b/.skilled/skills/system-skill-advisor/hooks/lib/skill-advisor-cli-fallback.ts\nindex f7368150ef..1d32fe10d0 100644\n--- a/.skilled/skills/system-skill-advisor/hooks/lib/skill-advisor-cli-fallback.ts\n+++ b/.skilled/skills/system-skill-advisor/hooks/lib/skill-advisor-cli-fallback.ts\n@@ -2,6 +2,10 @@\n // MODULE: Skill Advisor CLI Fallback\n // ───────────────────────────────────────────────────────────────\n \n+// ───────────────────────────────────────────────────────────────\n+// 1. IMPORTS\n+// ───────────────────────────────────────────────────────────────\n+\n import { spawn } from 'node:child_process';\n import { existsSync } from 'node:fs';\n import { dirname, join, resolve } from 'node:path';\n@@ -16,6 +20,10 @@ import type {\n import type { AdvisorRecommendation } from '../../runtime/lib/subprocess.js';\n import { ADVISOR_PROMPT_MAX_CHARS } from '../../runtime/schemas/advisor-tool-schemas.js';\n \n+// ───────────────────────────────────────────────────────────────\n+// 2. TYPES\n+// ───────────────────────────────────────────────────────────────\n+\n interface CliFallbackPaths {\n   readonly repoRoot: string;\n   readonly cliPath: string;\n@@ -73,6 +81,10 @@ interface SkillAdvisorCliFallbackDependencies {\n   readonly now?: () => number;\n }\n \n+// ───────────────────────────────────────────────────────────────\n+// 3. CONSTANTS\n+// ───────────────────────────────────────────────────────────────\n+\n const DEFAULT_CLI_FALLBACK_TIMEOUT_MS = 250;\n const EXIT_RETRYABLE = 75;\n const EXIT_SETTLE_GRACE_MS = 25;\n@@ -90,6 +102,10 @@ const RETRYABLE_REASONS = new Set([\n   'warm_daemon_unavailable',\n ]);\n \n+// ───────────────────────────────────────────────────────────────\n+// 4. HELPERS\n+// ───────────────────────────────────────────────────────────────\n+\n function isRecord(value: unknown): value is Record<string, unknown> {\n   return typeof value === 'object' && value !== null && !Array.isArray(value);\n }\n@@ -216,9 +232,13 @@ function runCliRecommend(args: {\n       topK: 3,\n       includeAttribution: false,\n       includeAbstainReasons: true,\n-      // The hook never reads compiled routing data, so requesting it only\n-      // spends the hook's budget on a subprocess.\n-      includeCompiledRoute: false,\n+      // The hook reads nothing out of the compiled route itself. It asks for the\n+      // route only because the advisor derives the slash command from it, and a\n+      // recommendation with no command cannot tell the reader which mode to run.\n+      includeCompiledRoute: true,\n+      // Each route is a subprocess inside the hook's time budget, and the brief\n+      // leads with the top pick, so only that one is looked up.\n+      compiledRouteTopOnly: true,\n       // Forward caller thresholds so the CLI scorer applies them; without this\n       // the scorer uses its own defaults and thresholdsFrom trusts the echoed\n       // defaults, silently discarding a caller's stricter thresholds.\n@@ -332,6 +352,9 @@ function thresholdsFrom(data: CliRecommendData, options: SkillAdvisorCliFallback\n type CliAdvisorRecommendation = AdvisorRecommendation & {\n   readonly ambiguousWith?: readonly string[];\n   readonly heldBelow?: string;\n+  // The slash command that runs the mode the advisor routed this skill to. Absent\n+  // when the route names no single mode, and never derived here: the CLI owns it.\n+  readonly command?: string;\n };\n \n function recommendationFromCli(value: unknown, thresholds: { readonly confidenceThreshold: number; readonly uncertaintyThreshold: number }): CliAdvisorRecommendation | null {\n@@ -342,7 +365,9 @@ function recommendationFromCli(value: unknown, thresholds: { readonly confidence\n   const uncertainty = typeof value.uncertainty === 'number' ? value.uncertainty : 1;\n   return {\n     skill: value.skillId,\n-    kind: 'skill',\n+    // A command row names the mode it runs, so the reader must keep that kind\n+    // rather than having every CLI row flattened back to a skill.\n+    kind: value.kind === 'skill' || value.kind === 'command' ? value.kind : 'skill',\n     confidence,\n     uncertainty,\n     passes_threshold: confidence >= thresholds.confidenceThreshold && uncertainty <= thresholds.uncertaintyThreshold,\n@@ -352,6 +377,16 @@ function recommendationFromCli(value: unknown, thresholds: { readonly confidence\n     // The brief re-derives ambiguity from these fields, so the typed-command hold\n     // must survive the trip or a pair the command already ranked reads as a tie.\n     ...(typeof value.heldBelow === 'string' ? { heldBelow: value.heldBelow } : {}),\n+    // Kept only when it names something: an empty command would render a blank\n+    // prompt where the reader expects a slash command to type.\n+    ...(typeof value.command === 'string' && value.command.trim() !== '' ? { command: value.command } : {}),\n+    // An unknown policy or a blank owner would render as if it were real, so each\n+    // is kept only when its value is one a renderer knows how to print.\n+    ...(value.policy === 'run' || value.policy === 'start' || value.policy === 'ask' ? { policy: value.policy } : {}),\n+    ...(typeof value.ownerSkillId === 'string' && value.ownerSkillId.trim() !== '' ? { ownerSkillId: value.ownerSkillId } : {}),\n+    // A hub that held back its command for want of a mode keeps that signal, so\n+    // the head can say why no command came with it.\n+    ...(value.needsMode === true ? { needsMode: true } : {}),\n   };\n }\n \n@@ -412,6 +447,10 @@ type CliFallbackHookResult = AdvisorHookResult & {\n   readonly ambiguous?: boolean;\n };\n \n+// ───────────────────────────────────────────────────────────────\n+// 5. CORE LOGIC\n+// ───────────────────────────────────────────────────────────────\n+\n // Exported as a test seam. The diagnostics this builds are the only signal a\n // reader gets about why no brief appeared, and a wrong one here sends them\n // hunting a transport failure that never happened.\n@@ -472,6 +511,10 @@ export function resultFromCliData(args: {\n       retriesAttempted: 0,\n       recommendationCount: recommendations.length,\n       tokenCap,\n+      // The health record counts degraded answers, and only this step knows the\n+      // answer came from the local scorer: freshness folds it into stale beside\n+      // a stale graph, so the freshness field alone cannot carry the signal.\n+      ...(degraded ? { degraded: true } : {}),\n     },\n     generatedAt: new Date().toISOString(),\n     sharedPayload: null,\ndiff --git a/.skilled/skills/system-skill-advisor/hooks/skill-advisor-hook-validation.md b/.skilled/skills/system-skill-advisor/hooks/skill-advisor-hook-validation.md\nindex 4b24b854c9..267dc2f6c4 100644\n--- a/.skilled/skills/system-skill-advisor/hooks/skill-advisor-hook-validation.md\n+++ b/.skilled/skills/system-skill-advisor/hooks/skill-advisor-hook-validation.md\n@@ -8,7 +8,7 @@ trigger_phrases:\n   - \"cross-runtime hook smoke\"\n importance_tier: normal\n contextType: implementation\n-version: 3.6.2.0\n+version: 3.6.3.0\n ---\n \n # Skill Advisor Hook Validation Playbook\n@@ -97,7 +97,7 @@ Pass conditions:\n \n Goal: confirm hook diagnostics persist to bounded JSONL sinks under the temp metrics root and that `advisor_validate` can read them back across processes.\n \n-Durable JSONL writes only occur when `SKILL_ADVISOR_DEBUG=1` is set; otherwise the sink early-returns.\n+Every hook run writes a prompt-free health record to the diagnostics sink, and `SKILL_ADVISOR_DEBUG=1` adds the skill label and the error text to each record.\n \n ```bash\n export SKILL_ADVISOR_DEBUG=1\n@@ -229,7 +229,7 @@ Pass condition: rollback and re-enable need no state cleanup.\n | Different brief bodies from OpenCode vs OpenCode for equivalent input | One path still routes through a custom formatter | Run Step 7 grep; any `formatAdvisorBrief`/`legacyAdvisorRender` hit is drift to fix |\n | No brief appears in any runtime | Disable flag set, advisor script missi