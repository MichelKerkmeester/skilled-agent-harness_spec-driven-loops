so the add never loses a record\n328-    // under concurrency. Bounding stays correct under the same per-path queue: trim\n329-    // only once the file drifts past 1.5x the cap, so the common path is a cheap\n330-    // append and the read-trim-rewrite amortizes to once per ~0.5*maxRecords writes.\n331-    await appendFile(path, `${line}\\n`, { encoding: 'utf8', mode: PRIVATE_FILE_MODE });\n332-    await securePrivateLog(path);\n333-    if (maxRecords > 0) {\n334-      const lines = readJsonlLines(path);\n335-      if (lines.length > Math.floor(maxRecords * 1.5)) {\n336-        const temporaryPath = `${path}.${process.pid}.${Date.now()}.tmp`;\n337-        // Rename swaps atomically, so a crash mid-trim leaves the old log instead of a truncated one.\n338-        await writeFile(temporaryPath, `${lines.slice(-maxRecords).join('\\n')}\\n`, { encoding: 'utf8', mode: PRIVATE_FILE_MODE });\n339-        try {\n340-          await rename(temporaryPath, path);\n341-        } catch (error) {\n342-          await unlink(temporaryPath);\n343-          throw error;\n344-        }\n345-      }\n346-    }\n347-  });\n348-  writeQueues.set(path, next.catch(() => undefined));\n349-  await next;\n350-}\n351-\n352-function tryParseJsonLine(line: string): unknown | null {\n353-  try {\n354-    return JSON.parse(line) as unknown;\n355-  } catch {\n356-    return null;\n357-  }\n358-}\n359-\n360-// ───────────────────────────────────────────────────────────────\n361-// 4. CORE LOGIC\n362-// ───────────────────────────────────────────────────────────────\n=== record interface ===\n  'PARSE_FAIL',\n  'SIGNAL_KILLED',\n  'GENERATION_COUNTER_CORRUPT',\n  'PYTHON_MISSING',\n  'NONZERO_EXIT',\n  'SQLITE_BUSY_EXHAUSTED',\n  'DELETED_SKILL',\n  'UNKNOWN',\n] as const;\n\nexport type AdvisorErrorCode = (typeof ADVISOR_ERROR_CODE_VALUES)[number];\nexport type AdvisorMetricType = 'counter' | 'histogram' | 'gauge';\nexport type AdvisorOutcome = 'accepted' | 'corrected' | 'ignored';\n\nexport interf