cted.push({ source: 'hook_additional_context', text });\n+  }\n+  return injected;\n+}\n+\n // ─────────────────────────────────────────────────────────────────────────────\n // 5. LOADER\n // ─────────────────────────────────────────────────────────────────────────────\n@@ -190,7 +214,9 @@ export function loadClaudeSession({ sessionId, transcriptPath, ...options } = {}\n \n   let raw;\n   try {\n-    raw = readFileSync(transcriptPath, 'utf8');\n+    // The file read is the path the containment check resolved, so a path\n+    // swapped after the check is not followed.\n+    raw = readFileSync(storePath, 'utf8');\n   } catch {\n     try {\n       statSync(root);\n@@ -220,5 +246,6 @@ export function loadClaudeSession({ sessionId, transcriptPath, ...options } = {}\n       storePath,\n     },\n     records: recordsFromEntries(entries),\n+    injected: injectedFromEntries(entries),\n   };\n }\ndiff --git a/.skilled/hooks/shared/session-readers/devin.mjs b/.skilled/hooks/shared/session-readers/devin.mjs\nindex 90d5d19a5e..32237ce8bd 100644\n--- a/.skilled/hooks/shared/session-readers/devin.mjs\n+++ b/.skilled/hooks/shared/session-readers/devin.mjs\n@@ -182,6 +182,35 @@ function recordsFromChain(chain) {\n   return records;\n }\n \n+// A system node carries the harness context a compaction or a session start\n+// injected. A user node without the input flag is prompt context the harness\n+// wrote, not text the operator typed, so it is injected context too and never\n+// a conversation record.\n+function injectedFromChain(chain) {\n+  const injected = [];\n+\n+  for (const node of chain) {\n+    const message = parseJsonObject(node.chat_message);\n+    if (!message) continue;\n+\n+    const text = typeof message.content === 'string' ? message.content : '';\n+    if (!text) continue;\n+\n+    if (message.role === 'system') {\n+      injected.push({ source: message.role, text });\n+      continue;\n+    }\n+\n+    if (message.role === 'user') {\n+      const isInput = message.metadata?.is_user_input;\n+      if (isInput === true || isInput === 1) continue;\n+      injected.push({ source: 'unflagged-user', text });\n+    }\n+  }\n+\n+  return injected;\n+}\n+\n function summarizedFrom(node) {\n   const value = parseJsonObject(node.metadata)?.summarized_from;\n   return Number.isInteger(value) ? value : null;\n@@ -212,10 +241,10 @@ function recordsFromDatabase(database, sessionId, headId) {\n     .prepare('SELECT node_id, parent_node_id, chat_message, metadata, created_at FROM message_nodes WHERE session_id = ? ORDER BY node_id')\n     .all(sessionId);\n \n-  if (nodes.length === 0) return [];\n+  if (nodes.length === 0) return { records: [], injected: [] };\n \n   const chain = chainWithEarlierThreads(nodes, headId);\n-  return chain ? recordsFromChain(chain) : null;\n+  return chain ? { records: recordsFromChain(chain), injected: injectedFromChain(chain) } : null;\n }\n \n // ─────────────────────────────────────────────────────────────────────────────\n@@ -283,6 +312,21 @@ function recordsFromSteps(steps) {\n   return records;\n }\n \n+// Harness and system steps are not conversation records, but they are context\n+// the next turn saw, kept apart so a caller can tell what the operator typed.\n+function injectedFromSteps(steps) {\n+  const injected = [];\n+\n+  for (const step of steps) {\n+    if (!step || typeof step !== 'object') continue;\n+    if (step.source === 'user' || step.source === 'agent') continue;\n+    if (typeof step.message !== 'string' || !step.message) continue;\n+    injected.push({ source: step.source, text: step.message });\n+  }\n+\n+  return injected;\n+}\n+\n // ─────────────────────────────────────────────────────────────────────────────\n // 6. LOADER\n // ─────────────────────────────────────────────────────────────────────────────\n@@ -307,7 +351,9 @@ function loadTranscript(sessionId, dataDirectory, options) {\n \n   let raw;\n   try {\n-    raw = readFileSync(transcriptPath, 'utf8');\n+    // The file read is the path the containment check resolved, so a path\n+    // swapped after the check is not followed.\n+    raw = readFileSync(storePath, 'utf8');\n   } catch {\n     try {\n       statSync(dataDirectory);\n@@ -333,6 +379,7 @@ function loadTranscript(sessionId, dataDirectory, options) {\n       storePath,\n     },\n     records: recordsFromSteps(steps),\n+    injected: injectedFromSteps(steps),\n   };\n }\n \n@@ -347,6 +394,16 @@ export function loadDevinSession({ sessionId, projectDir, ...options } = {}) {\n   const dataDirectory = devinDataDirectory(options);\n   const dbPath = devinDatabasePath(options);\n \n+  // A damaged or older database must not hide a transcript the store still\n+  // holds, so a failure here falls back to the file. A transcript that also\n+  // fails keeps the store unreadable.\n+  const transcriptFallback = () => {\n+    const transcript = loadTranscript(sessionId, dataDirectory, options);\n+    return transcript.ok || transcript.code === 'session_mismatch'\n+      ? transcript\n+      : { ok: false, code: 'store_unreadable' };\n+  };\n+\n   if (existsSync(dbPath)) {\n     const dbContainment = resolveInside({ path: dbPath, root: dataDirectory });\n     if (!dbContainment.ok) return dbContainment;\n@@ -355,7 +412,7 @@ export function loadDevinSession({ sessionId, projectDir, ...options } = {}) {\n     try {\n       database = openDatabase(dbContainment.path);\n     } catch {\n-      return { ok: false, code: 'store_unreadable' };\n+      return transcriptFallback();\n     }\n \n     try {\n@@ -371,9 +428,10 @@ export function loadDevinSession({ sessionId, projectDir, ...options } = {}) {\n         // transcript files, so a database with no message rows for this\n         // session, or no chain head to walk, falls through.\n         if (tableColumns(database, 'message_nodes').size > 0) {\n-          const records = recordsFromDatabase(database, sessionId, row.main_chain_id);\n-          if (!records) return { ok: false, code: 'store_unreadable' };\n+          const projection = recordsFromDatabase(database, sessionId, row.main_chain_id);\n+          if (!projection) return transcriptFallback();\n \n+          const { records, injected } = projection;\n           if (records.length > 0) {\n             return {\n               ok: true,\n@@ -384,12 +442,13 @@ export function loadDevinSession({ sessionId, projectDir, ...options } = {}) {\n                 storePath: dbContainment.path,\n               },\n               records,\n+              injected,\n             };\n           }\n         }\n       }\n     } catch {\n-      return { ok: false, code: 'store_unreadable' };\n+      return transcriptFallback();\n     } finally {\n       database.close();\n     }\ndiff --git a/.skilled/hooks/shared/session-readers/dsh.mjs b/.skilled/hooks/shared/session-readers/dsh.mjs\nindex aa1d366353..c2877301cc 100644\n--- a/.skilled/hooks/shared/session-readers/dsh.mjs\n+++ b/.skilled/hooks/shared/session-readers/dsh.mjs\n@@ -238,6 +238,23 @@ function recordsFromEvents(events) {\n   return records;\n }\n \n+// A hook notice arrives as a user-role message whose source is not the operator.\n+// It never becomes a record, because the operator did not write it, and the text\n+// is kept here so a caller can still tell what the harness put into the turn.\n+function injectedFromEvents(events) {\n+  const injected = [];\n+  for (const event of events) {\n+    if (event?.type !== 'user/message') continue;\n+    const data = event.data;\n+    if (!data || typeof data !== 'object') continue;\n+    if (data.source?.kind === OPERATOR_SOURCE) continue;\n+    const text = contentText(data.content);\n+    if (!text) continue;\n+    injected.push({ source: data.source?.kind ?? 'unknown', text });\n+  }\n+  return injected;\n+}\n+\n // ─────────────────────────────────────────────────────────────────────────────\n // 6. LOADER\n // ─────────────────────────────────────────────────────────────────────────────\n@@ -290,7 +307,10 @@ export function loadDshSession({ sessionId, projectDir, sessionPath, ...options\n \n   let events;\n   try {\n-    events = parseEvents(decodeSessionLog(readFileSync(logPath), logPath));\n+    // The file read is the path the containment check resolved, so a path\n+    // swapped after the check is not followed. The decoder still takes the\n+    // locator name, because it picks the format from the extension.\n+    events = parseEvents(decodeSessionLog(readFileSync(storePath), logPath));\n   } catch {\n     return { ok: false, code: 'store_unreadable' };\n   }\n@@ -311,5 +331,6 @@ export function loadDshSession({ sessionId, projectDir, sessionPath, ...options\n       storePath,\n     },\n     records: recordsFromEvents(events),\n+    injected: injectedFromEvents(events),\n   };\n }\ndiff --git a/.skilled/hooks/shared/session-readers/index.mjs b/.skilled/hooks/shared/session-readers/index.mjs\nindex 2c792b384e..ac4e0fbdde 100644\n--- a/.skilled/hooks/shared/session-readers/index.mjs\n+++ b/.skilled/hooks/shared/session-readers/index.mjs\n@@ -135,7 +135,12 @@ export async function loadSession(input) {\n   try {\n     const loaded = await load(options);\n     if (!loaded.ok) return loaded;\n-    return { ok: true, source: loaded.source, records: loaded.records };\n+    return {\n+      ok: true,\n+      source: loaded.source,\n+      records: loaded.records,\n+      ...(Array.isArray(loaded.injected) ? { injected: loaded.injected } : {}),\n+    };\n   } catch {\n     return failure('store_unreadable');\n   }\ndiff --git a/.skilled/hooks/shared/session-readers/pi.mjs b/.skilled/hooks/shared/session-readers/pi.mjs\nindex acd7bdaa4a..fa730bb8db 100644\n--- a/.skilled/hooks/shared/session-readers/pi.mjs\n+++ b/.skilled/hooks/shared/session-readers/pi.mjs\n@@ -17,6 +17,7 @@ import {\n   guardSessionPath,\n   homeDir,\n   isSafeSessionId,\n+  resolveInside,\n   samePath,\n } from './identity.mjs';\n import {\n@@ -159,6 +160,20 @@ function recordsFromLines(lines) {\n