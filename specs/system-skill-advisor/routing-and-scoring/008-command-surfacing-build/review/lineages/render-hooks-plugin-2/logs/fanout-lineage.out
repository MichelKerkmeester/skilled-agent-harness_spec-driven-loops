{"type":"tool_use","timestamp":1794570384655,"sessionID":"ses_e2b4a243affexa25EPiSDt2Sxc","part":{"partID":"prt_1d4baf3e30027VdNd7ZNN2hct9","sessionID":"ses_e2b4a243affexa25EPiSDt2Sxc","messageID":"msg_1d4badf0c001rAqEEeWoTwhPQl","type":"tool","id":"chatcmpl-tool-88fe35f8ce5bdfc7","tool":"shell","state":{"status":"completed","input":{"command":"cd /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research && git diff 35c3188681..HEAD -- .skilled/skills/system-skill-advisor/runtime/lib/render.ts"},"output":"diff --git a/.skilled/skills/system-skill-advisor/runtime/lib/render.ts b/.skilled/skills/system-skill-advisor/runtime/lib/render.ts\nindex 7cd4058681..84ae4cb058 100644\n--- a/.skilled/skills/system-skill-advisor/runtime/lib/render.ts\n+++ b/.skilled/skills/system-skill-advisor/runtime/lib/render.ts\n@@ -18,6 +18,7 @@ import {\n   type DeliveryStateName,\n   type DeliveryStateSignals,\n } from './policy-plan.js';\n+import { COMMAND_ROWS, commandRowFor } from './command-attach.js';\n import { isAmbiguousTopTwo } from './scorer/ambiguity.js';\n import type { AdvisorRecommendation } from './subprocess.js';\n import type { AdvisorScoredRecommendation } from './scorer/types.js';\n@@ -42,6 +43,12 @@ export interface AdvisorBriefRenderOptions {\n    * toolchain or skilled. The renderer never reads prompt text.\n    */\n   readonly setupWording?: boolean;\n+  /**\n+   * True when a dispatched child renders the brief. A child keeps the skill line\n+   * but a command it must not start alone renders as parent-named only. Defaults\n+   * to `AI_SESSION_CHILD === '1'`.\n+   */\n+  readonly childSession?: boolean;\n }\n \n export interface ShadowDeliveryRenderOptions extends DeliveryStateSignals {\n@@ -103,52 +110,10 @@ const INSTRUCTION_LABEL_PATTERN =\n const CONTROL_CHAR_PATTERN = /[\\u0000-\\u0008\\u000B\\u000C\\u000E-\\u001F\\u007F]/g;\n const ROUTE_ONLY_SHADOW_ID = 'shadow.route-only.advisor.v1';\n const OBSERVED_ADVISOR_POLICY_CANDIDATE = '004';\n+const PARENT_NAMED_POLICY = 'parent-named only';\n export const ROUTE_ONLY_ESTIMATED_BYTES = 43;\n const MAX_SHADOW_ROUTE_ONLY_LOG = 256;\n \n-// Maps each doctor command bridge id to the runnable command string the brief\n-// shows. Generated by derive-command-bridges.cjs from the doctor route manifest,\n-// so the renderer never imports the scorer projection (which loads SQLite).\n-// BEGIN GENERATED DOCTOR COMMANDS\n-const DOCTOR_COMMAND_STRINGS: Readonly<Record<string, string>> = Object.freeze({\n-  'command-doctor-agents-md-check': '/doctor:agents-md check',\n-  'command-doctor-agents-md-embed': '/doctor:agents-md embed',\n-  'command-doctor-agents-md-restore': '/doctor:agents-md restore',\n-  'command-doctor-ci-report': '/doctor:ci report',\n-  'command-doctor-ci-scaffold': '/doctor:ci scaffold',\n-  'command-doctor-ci-toggle': '/doctor:ci toggle',\n-  'command-doctor-deep-loop': '/doctor:deep-loop',\n-  'command-doctor-env': '/doctor:env list',\n-  'command-doctor-git-hooks': '/doctor:git hooks',\n-  'command-doctor-git-setup': '/doctor:git setup',\n-  'command-doctor-git-standards': '/doctor:git standards',\n-  'command-doctor-helper': '/doctor:helper',\n-  'command-doctor-install': '/doctor:install',\n-  'command-doctor-mcp-debug': '/doctor:mcp debug',\n-  'command-doctor-mcp-install': '/doctor:mcp install',\n-  'command-doctor-overlay-apply': '/doctor:overlay apply',\n-  'command-doctor-overlay-repin': '/doctor:overlay repin',\n-  'command-doctor-overlay-status': '/doctor:overlay status',\n-  'command-doctor-runtime-mirrors': '/doctor:runtime-mirrors',\n-  'command-doctor-setup': '/doctor:setup',\n-  'command-doctor-sk-code-quality': '/doctor:sk-code quality',\n-  'command-doctor-sk-code-setup': '/doctor:sk-code setup',\n-  'command-doctor-sk-skill-check': '/doctor:sk-skill check',\n-  'command-doctor-sk-skill-convert': '/doctor:sk-skill convert',\n-  'command-doctor-skill-advisor-parent-skill': '/doctor:skill-advisor parent-skill',\n-  'command-doctor-skill-advisor-rebuild': '/doctor:skill-advisor rebuild',\n-  'command-doctor-skill-advisor-router-reach': '/doctor:skill-advisor router-reach',\n-  'command-doctor-skill-advisor-skill-budget': '/doctor:skill-advisor skill-budget',\n-  'command-doctor-skill-advisor-skill-graph-freshness': '/doctor:skill-advisor skill-graph-freshness',\n-  'command-doctor-skill-advisor-tune': '/doctor:skill-advisor tune',\n-  'command-doctor-speckit': '/doctor:speckit',\n-  'command-doctor-symlink-check': '/doctor:symlink check',\n-  'command-doctor-symlink-link': '/doctor:symlink link',\n-  'command-doctor-symlink-unlink': '/doctor:symlink unlink',\n-  'command-doctor-update': '/doctor:update',\n-});\n-// END GENERATED DOCTOR COMMANDS\n-\n function directiveBlockIds(): readonly string[] {\n   return Object.freeze([\n     POLICY_COMMENT_HYGIENE_ID,\n@@ -215,18 +180,89 @@ function isDoctorBridgeId(skillId: string): boolean {\n   return skillId.startsWith(DOCTOR_BRIDGE_PREFIX);\n }\n \n-/** Return the sanitized runnable doctor command for a doctor bridge id, or null when unmapped. */\n+/** Return the sanitized runnable command for a doctor bridge id, or null when unmapped. */\n export function doctorCommandString(skillId: string): string | null {\n-  if (!isDoctorBridgeId(skillId) || !Object.hasOwn(DOCTOR_COMMAND_STRINGS, skillId)) {\n+  if (!isDoctorBridgeId(skillId)) {\n+    return null;\n+  }\n+  const command = commandRowFor(skillId)?.command;\n+  return command === undefined ? null : sanitizeSkillLabel(command);\n+}\n+\n+// A dispatched child cannot ask its operator whether to start an interactive run\n+// or one that writes, so only a read-only run stays fully visible there.\n+function parentNamedOnly(policy: string | undefined, mutating: string | undefined): boolean {\n+  if (policy === 'start' || policy === 'ask') {\n+    return true;\n+  }\n+  return policy === 'run' && mutating !== 'read-only';\n+}\n+\n+// The policy word is the only part of a command label a child replaces. The\n+// command itself and its owner stay visible so the child can report what the\n+// parent named.\n+function policyWord(\n+  policy: string | undefined,\n+  mutating: string | undefined,\n+  childSession: boolean,\n+): string | null {\n+  if (policy === undefined) {\n     return null;\n   }\n-  return sanitizeSkillLabel(DOCTOR_COMMAND_STRINGS[skillId]);\n+  const word = sanitizeSkillLabel(policy);\n+  if (word === null) {\n+    return null;\n+  }\n+  return childSession && parentNamedOnly(policy, mutating) ? PARENT_NAMED_POLICY : word;\n+}\n+\n+// A recommendation that names a command renders as the skill that owns it, the\n+// runnable command and the policy that governs the run. The recommendation's own\n+// fields stay authoritative and the generated row fills only what they omit, so a\n+// caller that already resolved the command is never second-guessed.\n+function commandLabel(recommendation: RenderableRecommendation, childSession: boolean): string | null {\n+  // A hub that withheld its mode must not regress to the command its generated\n+  // row names, because that command is the mode the reader has not chosen yet.\n+  const row = recommendation.needsMode === true ? undefined : commandRowFor(recommendation.skill);\n+  const command = recommendation.command ?? row?.command;\n+  const owner = recommendation.ownerSkillId ?? row?.ownerSkillId ?? recommendation.skill;\n+  const policy = recommendation.policy ?? row?.policy;\n+  const commandPart = command === undefined ? null : sanitizeSkillLabel(command);\n+  const ownerPart = sanitizeSkillLabel(owner);\n+  if (!commandPart || !ownerPart) {\n+    return null;\n+  }\n+  // The class belongs to the command printed, not to the skill that carried it,\n+  // so a recommendation that names another command takes that command's class.\n+  const mutating = row !== undefined && row.command === commandPart\n+    ? row.mutating\n+    : Object.values(COMMAND_ROWS).find((candidate) => candidate.command === commandPart)?.mutating;\n+  const policyPart = policyWord(policy, mutating, childSession);\n+  return policyPart === null\n+    ? `${ownerPart} → ${commandPart}`\n+    : `${ownerPart} → ${commandPart} (${policyPart})`;\n }\n \n // A doctor bridge renders as its runnable command and never as its raw id; an\n // unmapped doctor id renders nothing.\n-function recommendationLabel(skillId: string): string | null {\n-  return isDoctorBridgeId(skillId) ? doctorCommandString(skillId) : sanitizeSkillLabel(skillId);\n+function recommendationLabel(recommendation: RenderableRecommendation, childSession: boolean): string | null {\n+  return commandLabel(recommendation, childSession)\n+    ?? (isDoctorBridgeId(recommendation.skill)\n+      ? doctorCommandString(recommendation.skill)\n+      : sanitizeSkillLabel(recommendation.skill));\n+}\n+\n+// The companion line normally shows only the runnable command. A child gets the\n+// downgrade marker appended because that command must not be started there.\n+function companionCommandLabel(skillId: string, childSession: boolean): string | null {\n+  const command = doctorCommandString(skillId);\n+  if (command === null) {\n+    return null;\n+  }\n+  const row = commandRowFor(skillId);\n+  return childSession && parentNamedOnly(row?.policy, row?.mutating)\n+    ? `${command} (${PARENT_NAMED_POLICY})`\n+    : command;\n }\n \n function formatScore(value: number): string {\n@@ -490,6 +526,7 @@ export function renderAdvisorBrief(\n \n   const tokenCap = clampTokenCap(result.metrics?.tokenCap ?? options.tokenCap);\n   const thresholdConfig = options.thresholdConfig;\n+  const childSession = options.childSession ?? process.env.AI_SESSION_CHILD === '1';\n   const recommendations = result.recommendations.filter((recommendation) => (\n     recommendation.passes_threshold === true\n     || (\n@@ -506,18 +543,27 @@ export function renderAdvisorBrief(\n     return null;\n   }\n \n-  const topLabel = isDoctorBridgeId(top.skill)\n-    ? doctorCommandString(top.skill)\n-    : sanitizeSkillLabel(metadataSkillLabel(result) ?? top.skill);\n+  // A recommendation that needs a mode is named by the skill that owns its row,\n+  // because the row id is an internal key the reader cannot run.\n+  const topLabel = commandLabel(top, childSession)\n+    ?? (isDoctorBridgeId(top.skill)\n+      ? doctorCommandString(top.skill)\n+      : sanitizeSkillLabel(metadataSkillLabel(result) ?? (top.needsMode === true ? commandRowFor(top.skill)?.ownerSkillId : undefined) ?? top.skill));\n   if (!topLabel) {\n     observeAdvisorPolicy(null, options);\n     return null;\n   }\n \n+  // A hub that withheld its command because the prompt names no single mode says\n+  // so, so the reader asks for the mode instead of improvising one.\n+  const headLabel = top.needsMode === true && top.command === undefined\n+    ? `${topLabel} (needs a mode)`\n+    : topLabel;\n+\n   const companion = isDoctorBridgeId(top.skill)\n     ? undefined\n     : recommendations.slice(1).find((recommendation) => doctorCommandString(recommendation.skill) !== null);\n-  const companionLabel = companion ? doctorCommandString(companion.skill) : null;\n+  const companionLabel = companion ? companionCommandLabel(companion.skill, childSession) : null;\n   const companionLine = (shownSecond: string | undefined): string => (\n     companionLabel && companion && companion.skill !== shownSecond ? `\\nAlso: ${companionLabel}` : ''\n   );\n@@ -535,13 +581,13 @@ export function renderAdvisorBrief(\n     const vs = (ambiguousWith.length > 0\n       ? recommendations.find((recommendation) => ambiguousWith.includes(recommendation.skill))\n       : undefined) ?? second;\n-    const vsLabel = recommendationLabel(vs.skill);\n+    const vsLabel = recommendationLabel(vs, childSession);\n     if (!vsLabel && !isDoctorBridgeId(vs.skill)) {\n       observeAdvisorPolicy(null, options);\n       return null;\n     }\n     if (vsLabel) {\n-      const head = `Advisor: ${result.freshness}; ambiguous: ${topLabel} `\n+      const head = `Advisor: ${result.freshness}; ambiguous: ${headLabel} `\n         + `${formatScore(top.confidence)}/${formatScore(top.uncertainty)} vs ${vsLabel} `\n         + `${formatScore(vs.confidence)}/${formatScore(vs.uncertainty)} pass.`;\n       const rendered = capWithCompanion(\n@@ -554,7 +600,7 @@ export function renderAdvisorBrief(\n     }\n   }\n \n-  const head = `Advisor: ${result.freshness}; use ${topLabel} `\n+  const head = `Advisor: ${result.freshness}; use ${headLabel} `\n     + `${formatScore(top.confidence)}/${formatScore(top.uncertainty)} pass.`;\n   const rendered = capWithCompanion(\n     head,\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"diff --git a/.skilled/skills/system-skill-advisor/runtime/lib/render.ts b/.skilled/skills/system-skill-advisor/runtime/lib/render.ts\nindex 7cd4058681..84ae4cb058 100644\n--- a/.skilled/skills/system-skill-advisor/runtime/lib/render.ts\n+++ b/.skilled/skills/system-skill-advisor/runtime/lib/render.ts\n@@ -18,6 +18,7 @@ import {\n   type DeliveryStateName,\n   type DeliveryStateSignals,\n } from './policy-plan.js';\n+import { COMMAND_ROWS, commandRowFor } from './command-attach.js';\n import { isAmbiguousTopTwo } from './scorer/ambiguity.js';\n import type { AdvisorRecommendation } from './subprocess.js';\n import type { AdvisorScoredRecommendation } from './scorer/types.js';\n@@ -42,6 +43,12 @@ export interface AdvisorBriefRenderOptions {\n    * toolchain or skilled. The renderer never reads prompt text.\n    */\n   readonly setupWording?: boolean;\n+  /**\n+   * True when a dispatched child renders the brief. A child keeps the skill line\n+   * but a command it must not start alone renders as parent-named only. Defaults\n+   * to `AI_SESSION_CHILD === '1'`.\n+   */\n+  readonly childSession?: boolean;\n }\n \n export interface ShadowDeliveryRenderOptions extends DeliveryStateSignals {\n@@ -103,52 +110,10 @@ const INSTRUCTION_LABEL_PATTERN =\n const CONTROL_CHAR_PATTERN = /[\\u0000-\\u0008\\u000B\\u000C\\u000E-\\u001F\\u007F]/g;\n const ROUTE_ONLY_SHADOW_ID = 'shadow.route-only.advisor.v1';\n const OBSERVED_ADVISOR_POLICY_CANDIDATE = '004';\n+const PARENT_NAMED_POLICY = 'parent-named only';\n export const ROUTE_ONLY_ESTIMATED_BYTES = 43;\n const MAX_SHADOW_ROUTE_ONLY_LOG = 256;\n \n-// Maps each doctor command bridge id to the runnable command string the brief\n-// shows. Generated by derive-command-bridges.cjs from the doctor route manifest,\n-// so the renderer never imports the scorer projection (which loads SQLite).\n-// BEGIN GENERATED DOCTOR COMMANDS\n-const DOCTOR_COMMAND_STRINGS: Readonly<Record<string, string>> = Object.freeze({\n-  'command-doctor-agents-md-check': '/doctor:agents-md check',\n-  'command-doctor-agents-md-embed': '/doctor:agents-md embed',\n-  'command-doctor-agents-md-restore': '/doctor:agents-md restore',\n-  'command-doctor-ci-report': '/doctor:ci report',\n-  'command-doctor-ci-scaffold': '/doctor:ci scaffold',\n-  'command-doctor-ci-toggle': '/doctor:ci toggle',\n-  'command-doctor-deep-loop': '/doctor:deep-loop',\n-  'command-doctor-env': '/doctor:env list',\n-  'command-doctor-git-hooks': '/doctor:git hooks',\n-  'command-doctor-git-setup': '/doctor:git setup',\n-  'command-doctor-git-standards': '/doctor:git standards',\n-  'command-doctor-helper': '/doctor:helper',\n-  'command-doctor-install': '/doctor:install',\n-  'command-doctor-mcp-debug': '/doctor:mcp debug',\n-  'command-doctor-mcp-install': '/doctor:mcp install',\n-  'command-doctor-overlay-apply': '/doctor:overlay apply',\n-  'command-doctor-overlay-repin': '/doctor:overlay repin',\n-  'command-doctor-overlay-status': '/doctor:overlay status',\n-  'command-doctor-runtime-mirrors': '/doctor:runtime-mirrors',\n-  'command-doctor-setup': '/doctor:setup',\n-  'command-doctor-sk-code-quality': '/doctor:sk-code quality',\n-  'command-doctor-sk-code-setup': '/doctor:sk-code setup',\n-  'command-doctor-sk-skill-check': '/doctor:sk-skill check',\n-  'command-doctor-sk-skill-convert': '/doctor:sk-skill convert',\n-  'command-doctor-skill-advisor-parent-skill': '/doctor:skill-advisor parent-skill',\n-  'command-doctor-skill-advisor-rebuild': '/doctor:skill-advisor rebuild',\n-  'command-doctor-skill-advisor-router-reach': '/doctor:skill-advisor router-reach',\n-  'command-doctor-skill-advisor-skill-budget': '/doctor:skill-advisor skill-budget',\n-  'command-doctor-skill-advisor-skill-graph-freshness': '/doctor:skill-advisor skill-graph-freshness',\n-  'command-doctor-skill-advisor-tune': '/doctor:skill-advisor tune',\n-  'command-doctor-speckit': '/doctor:speckit',\n-  'command-doctor-symlink-check': '/doctor:symlink check',\n-  'command-doctor-symlink-link': '/doctor:symlink link',\n-  'command-doctor-symlink-unlink': '/doctor:symlink unlink',\n-  'command-doctor-update': '/doctor:update',\n-});\n-// END GENERATED DOCTOR COMMANDS\n-\n function directiveBlockIds(): readonly string[] {\n   return Object.freeze([\n     POLICY_COMMENT_HYGIENE_ID,\n@@ -215,18 +180,89 @@ function isDoctorBridgeId(skillId: string): boolean {\n   return skillId.startsWith(DOCTOR_BRIDGE_PREFIX);\n }\n \n-/** Return the sanitized runnable doctor command for a doctor bridge id, or null when unmapped. */\n+/** Return the sanitized runnable command for a doctor bridge id, or null when unmapped. */\n export function doctorCommandString(skillId: string): string | null {\n-  if (!isDoctorBridgeId(skillId) || !Object.hasOwn(DOCTOR_COMMAND_STRINGS, skillId)) {\n+  if (!isDoctorBridgeId(skillId)) {\n+    return null;\n+  }\n+  const command = commandRowFor(skillId)?.command;\n+  return command === undefined ? null : sanitizeSkillLabel(command);\n+}\n+\n+// A dispatched child cannot ask its operator whether to start an interactive run\n+// or one that writes, so only a read-only run stays fully visible there.\n+function parentNamedOnly(policy: string | undefined, mutating: string | undefined): boolean {\n+  if (policy === 'start' || policy === 'ask') {\n+    return true;\n+  }\n+  return policy === 'run' && mutating !== 'read-only';\n+}\n+\n+// The policy word is the only part of a command label a child replaces. The\n+// command itself and its owner stay visible so the child can report what the\n+// parent named.\n+function policyWord(\n+  policy: string | undefined,\n+  mutating: string | undefined,\n+  childSession: boolean,\n+): string | null {\n+  if (policy === undefined) {\n     return null;\n   }\n-  return sanitizeSkillLabel(DOCTOR_COMMAND_STRINGS[skillId]);\n+  const word = sanitizeSkillLabel(policy);\n+  if (word === null) {\n+    return null;\n+  }\n+  return childSession && parentNamedOnly(policy, mutating) ? PARENT_NAMED_POLICY : word;\n+}\n+\n+// A recommendation that names a command renders as the skill that owns it, the\n+// runnable command and the policy that governs the run. The recommendation's own\n+// fields stay authoritative and the generated row fills only what they omit, so a\n+// caller that already resolved the command is never second-guessed.\n+function commandLabel(recommendation: RenderableRecommendation, childSession: boolean): string | null {\n+  // A hub that withheld its mode must not regress to the command its generated\n+  // row names, because that command is the mode the reader has not chosen yet.\n+  const row = recommendation.needsMode === true ? undefined : commandRowFor(recommendation.skill);\n+  const command = recommendation.command ?? row?.command;\n+  const owner = recommendation.ownerSkillId ?? row?.ownerSkillId ?? recommendation.skill;\n+  const policy = recommendation.policy ?? row?.policy;\n+  const commandPart = command === undefined ? null : sanitizeSkillLabel(command);\n+  const ownerPart = sanitizeSkillLabel(owner);\n+  if (!commandPart || !ownerPart) {\n+    return null;\n+  }\n+  // The class belongs to the command printed, not to the skill that carried it,\n+  // so a recommendation that names another command takes that command's class.\n+  const mutating = row !== undefined && row.command === commandPart\n+    ? row.mutating\n+    : Object.values(COMMAND_ROWS).find((candidate) => candidate.command === commandPart)?.mutating;\n+  const policyPart = policyWord(policy, mutating, childSession);\n+  return policyPart === null\n+    ? `${ownerPart} → ${commandPart}`\n+    : `${ownerPart} → ${commandPart} (${policyPart})`;\n }\n \n // A doctor bridge renders as its runnable command and never as its raw id; an\n // unmapped doctor id renders nothing.\n-function recommendationLabel(skillId: string): string | null {\n-  return isDoctorBridgeId(skillId) ? doctorCommandString(skillId) : sanitizeSkillLabel(skillId);\n+function recommendationLabel(recommendation: RenderableRecommendation, childSession: boolean): string | null {\n+  return commandLabel(recommendation, childSession)\n+    ?? (isDoctorBridgeId(recommendation.skill)\n+      ? doctorCommandString(recommendation.skill)\n+      : sanitizeSkillLabel(recommendation.skill));\n+}\n+\n+// The companion line normally shows only the runnable command. A child gets the\n+// downgrade marker appended because that command must not be started there.\n+function companionCommandLabel(skillId: string, childSession: boolean): string | null {\n+  const command = doctorCommandString(skillId);\n+  if (command === null) {\n+    return null;\n+  }\n+  const row = commandRowFor(skillId);\n+  return childSession && parentNamedOnly(row?.policy, row?.mutating)\n+    ? `${command} (${PARENT_NAMED_POLICY})`\n+    : command;\n }\n \n function formatScore(value: number): string {\n@@ -490,6 +526,7 @@ export function renderAdvisorBrief(\n \n   const tokenCap = clampTokenCap(result.metrics?.tokenCap ?? options.tokenCap);\n   const thresholdConfig = options.thresholdConfig;\n+  const childSession = options.childSession ?? process.env.AI_SESSION_CHILD === '1';\n   const recommendations = result.recommendations.filter((recommendation) => (\n     recommendation.passes_threshold === true\n     || (\n@@ -506,18 +543,27 @@ export function renderAdvisorBrief(\n     return null;\n   }\n \n-  const topLabel = isDoctorBridgeId(top.skill)\n-    ? doctorCommandString(top.skill)\n-    : sanitizeSkillLabel(metadataSkillLabel(result) ?? top.skill);\n+  // A recommendation that needs a mode is named by the skill that owns its row,\n+  // because the row id is an internal key the reader cannot run.\n+  const topLabel = commandLabel(top, childSession)\n+    ?? (isDoctorBridgeId(top.skill)\n+      ? doctorCommandString(top.skill)\n+      : sanitizeSkillLabel(metadataSkillLabel(result) ?? (top.needsMode === true ? commandRowFor(top.skill)?.ownerSkillId : undefined) ?? top.skill));\n   if (!topLabel) {\n     observeAdvisorPolicy(null, options);\n     return null;\n   }\n \n+  // A hub that withheld its command because the prompt names no single mode says\n+  // so, so the reader asks for the mode instead of improvising one.\n+  const headLabel = top.needsMode === true && top.command === undefined\n+    ? `${topLabel} (needs a mode)`\n+    : topLabel;\n+\n   const companion = isDoctorBridgeId(top.skill)\n     ? undefined\n     : recommendations.slice(1).find((recommendation) => doctorCommandString(recommendation.skill) !== null);\n-  const companionLabel = companion ? doctorCommandString(companion.skill) : null;\n+  const companionLabel = companion ? companionCommandLabel(companion.skill, childSession) : null;\n   const companionLine = (shownSecond: string | undefined): string => (\n     companionLabel && companion && companion.skill !== shownSecond ? `\\nAlso: ${companionLabel}` : ''\n   );\n@@ -535,13 +581,13 @@ export function renderAdvisorBrief(\n     const vs = (ambiguousWith.length > 0\n       ? recommendations.find((recommendation) => ambiguousWith.includes(recommendation.skill))\n       : undefined) ?? second;\n-    const vsLabel = recommendationLabel(vs.skill);\n+    const vsLabel = recommendationLabel(vs, childSession);\n     if (!vsLabel && !isDoctorBridgeId(vs.skill)) {\n       observeAdvisorPolicy(null, options);\n       return null;\n     }\n     if (vsLabel) {\n-      const head = `Advisor: ${result.freshness}; ambiguous: ${topLabel} `\n+      const head = `Advisor: ${result.freshness}; ambiguous: ${headLabel} `\n         + `${formatScore(top.confidence)}/${formatScore(top.uncertainty)} vs ${vsLabel} `\n         + `${formatScore(vs.confidence)}/${formatScore(vs.uncertainty)} pass.`;\n       const rendered = capWithCompanion(\n@@ -554,7 +600,7 @@ export function renderAdvisorBrief(\n     }\n   }\n \n-  const head = `Advisor: ${result.freshness}; use ${topLabel} `\n+  const head = `Advisor: ${result.freshness}; use ${headLabel} `\n     + `${formatScore(top.confidence)}/${formatScore(top.uncertainty)} pass.`;\n   const rendered = capWithCompanion(\n     head,\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\": \"cd /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research && git diff 35c3188681..HEAD -- .skilled/skills/system-skill-advisor/runtime/lib/render.ts\"}"},"time":{"start":1794570384355,"end":1794570384655}}}}
{"type":"tool_use","timestamp":1794570384671,"sessionID":"ses_e2b4a243affexa25EPiSDt2Sxc","part":{"partID":"prt_1d4baf3e4001YyKibv6osK3lfg","sessionID":"ses_e2b4a243affexa25EPiSDt2Sxc","messageID":"msg_1d4badf0c001rAqEEeWoTwhPQl","type":"tool","id":"chatcmpl-tool-bfb296d05db0e45b","tool":"read","state":{"status":"completed","input":{"path":".skilled/skills/sk-code/sk-code-review/references/review-core.md","limit":120},"output":"Read file .skilled/skills/sk-code/sk-code-review/references/review-core.md, lines 1-120\n1: ---\n2: title: Review Core Doctrine\n3: description: Shared findings-first review doctrine for both single-pass and deep-review workflows.\n4: trigger_phrases:\n5:   - \"findings first severity ordering\"\n6:   - \"review finding schema\"\n7:   - \"severity contract for merge decisions\"\n8:   - \"evidence file line citation\"\n9:   - \"baseline surface precedence\"\n10:   - \"baseline check families\"\n11: importance_tier: important\n12: contextType: implementation\n13: version: 1.5.9.0\n14: ---\n15: \n16: # Review Core Doctrine\n17: \n18: Shared doctrine consumed by both `@review` and `@deep-review`.\n19: \n20: **Ownership.** This file owns the severity ids and their meanings (section 2), the evidence rules (section 3) and the finding schema (section 7). The deep-review contract, [`review-mode-contract.yaml`](../../../system-deep-loop/deep-review/assets/review-mode-contract.yaml), is an external consumer: it owns the deep-review loop (dimensions, verdicts, severity weights, convergence and quality gates) and reuses the severity ids defined here. When the two disagree on a severity id or its meaning, this file wins and the YAML is corrected by its owner, `deep-review`. The YAML may be stricter for its own loop, as when it requires `file:line` evidence on `P2`, but never looser.\n21: \n22: ---\n23: \n24: ## 1. OVERVIEW\n25: \n26: ### Purpose\n27: \n28: Shared findings-first review doctrine for both single-pass and deep-review workflows.\n29: \n30: ### When to Use\n31: \n32: - A `@review` or `@deep-review` pass that needs the severity contract, the evidence rules or the finding schema.\n33: - A review that must state its `Rule sources:` line, or apply a repository or surface override to a default-lens rule.\n34: \n35: Every rule in sections 2 to 7 is review floor, the part no repository or surface can change. Section 8 names the floor ids, the default lens that a repository may drop or replace, and how the review reads and reports those overrides.\n36: \n37: ---\n38: \n39: ## 2. SEVERITY DEFINITIONS\n40: \n41: | Level | Meaning | Handling |\n42: | --- | --- | --- |\n43: | P0 | Blocker: exploitable security issue, auth bypass, destructive data loss | Block merge |\n44: | P1 | Required: correctness bug, spec mismatch, must-fix gate issue | Fix before merge |\n45: | P2 | Suggestion: non-blocking improvement, documentation polish, style or maintainability follow-up | Optional or schedule follow-up |\n46: \n47: ### Reach Calibration\n48: \n49: A `P0` or `P1` finding names its reach: an input or call path that the code's stated contract allows, or a real caller that sends the failing input. The stated contract is what the code promises through its signature, types, doc comment, name and the checks it already makes.\n50: \n51: - A failure that needs input outside the stated contract, such as `NaN` where the contract says a number, a wrong type, or an inverted range the code already rejects, is `P2` hardening.\n52: - The exception is input the code claims to validate. When a guard, a thrown error or a doc line promises to reject an input class and the promise fails for an input in that class, the gap is a correctness finding and keeps `P1` or higher. A guard claims only the class it checks: an ordering check such as `min > max` does not claim that its operands are numbers.\n53: - At a trust boundary (user input, network, files, environment, another service), every value the outside can send is in reach. The stated contract of internal code never narrows a security finding on data that crosses that boundary.\n54: - A finding that cannot name its reach is `P2`, however severe the failure would be.\n55: \n56: Escalation rule: if confidence is low but impact is high, classify toward the higher severity and state the uncertainty explicitly. The confidence is confidence that the reach exists. The rule raises a finding whose reach is named but not proven, such as a caller that probably sends the input. It never raises a finding with no reach, so it cannot lift an out-of-contract failure above `P2`.\n57: \n58: ### Numeric Severity Calibration\n59: \n60: Numeric scores are advisory context, not the gate. A reviewer may add an optional `riskScore` to a finding and adjust it by `+/-2` for local context such as exploitability, blast radius, user impact, confidence, or proven containment. The merge/block decision remains the severity contract above: `P0` blocks, `P1` requires remediation, and `P2` is advisory. Do not adopt `score>=4` or any numeric threshold as a blocker.\n61: \n62: ---\n63: \n64: ## 3. EVIDENCE REQUIREMENTS\n65: \n66: - Every `P0` and `P1` finding must include a concrete `file:line` citation.\n67: - Evidence must tie the finding to observed code behavior, not just a general concern.\n68: - `P2` findings should still include specific evidence when available, even if impact is advisory.\n69: - If evidence is incomplete, state the assumption and why the risk still matters.\n70: \n71: ---\n72: \n73: ## 4. FINDINGS OUTPUT ORDERING\n74: \n75: - Present findings before summary or praise sections.\n76: - Order findings by severity first: `P0`, then `P1`, then `P2`.\n77: - Keep ordering stable within a severity bucket by impact and confidence.\n78: - Separate required fixes from optional suggestions so merge decisions stay clear.\n79: \n80: ---\n81: \n82: ## 5. BASELINE + SURFACE PRECEDENCE\n83: \n84: Apply this skill as the baseline first, then pair it with `sk-code` surface evidence when available:\n85: \n86: - Detected code surfaces -> the surfaces the quality runner's resolver places each reviewed file in, specific surfaces first and the `SKILLED` fallback last. Each one pairs with its `sk-code` evidence packet, such as `sk-code-skilled` for `SKILLED`. No match -> `UNKNOWN`. The resolver applies the shared detection contract, [`stack-detection.md`](../../shared/references/stack-detection.md) section 2, so the review keeps no detection of its own. Section 8 describes what it returns.\n87: - Unclear surfaces -> baseline-only plus explicit uncertainty\n88: \n89: Precedence rules:\n90: \n91: - Baseline security and correctness minimums are always enforced.\n92: - Surface style, process, build, and test conventions override generic baseline guidance.\n93: - A repository or surface changes one default-lens rule only through a `## Rule overrides` row, by the precedence in section 8.\n94: - Unclear conflicts must be escalated rather than guessed.\n95: \n96: ---\n97: \n98: ## 6. BASELINE CHECK FAMILIES\n99: \n100: Mandatory baseline families:\n101: \n102: - Correctness minimums: regression risk, contract safety, spec mismatch, destructive side effects, and boundary handling.\n103: - Security minimums: auth and authorization gaps, injection exposure, unsafe secrets handling, privilege misuse, and reliability risks with security impact.\n104: \n105: These minimums cannot be relaxed by surface guidance.\n106: \n107: ---\n108: \n109: ## 7. FINDING SCHEMA\n110: \n111: Each finding should provide:\n112: \n113: | Field | Requirement |\n114: | --- | --- |\n115: | `id` | The finding's number in the Findings list, counted once across severity groups, such as `2` |\n116: | `severity` | One of `P0`, `P1`, `P2` |\n117: | `title` | Short, risk-oriented summary |\n118: | `case` | The input or situation that produces the wrong result. A finding with no case is not reported |\n119: | `file` | Primary `path:line` location |\n120: | `evidence` | Plain-language explanation tied to observed code; for a performance finding, name the workload it assumes, such as row count, request rate or payload size |\n[Output truncated. Continue reading with offset: 121]","title":"read","metadata":{"metadata":{"truncated":true},"content":[{"type":"text","text":"Read file .skilled/skills/sk-code/sk-code-review/references/review-core.md, lines 1-120\n1: ---\n2: title: Review Core Doctrine\n3: description: Shared findings-first review doctrine for both single-pass and deep-review workflows.\n4: trigger_phrases:\n5:   - \"findings first severity ordering\"\n6:   - \"review finding schema\"\n7:   - \"severity contract for merge decisions\"\n8:   - \"evidence file line citation\"\n9:   - \"baseline surface precedence\"\n10:   - \"baseline check families\"\n11: importance_tier: important\n12: contextType: implementation\n13: version: 1.5.9.0\n14: ---\n15: \n16: # Review Core Doctrine\n17: \n18: Shared doctrine consumed by both `@review` and `@deep-review`.\n19: \n20: **Ownership.** This file owns the severity ids and their meanings (section 2), the evidence rules (section 3) and the finding schema (section 7). The deep-review contract, [`review-mode-contract.yaml`](../../../system-deep-loop/deep-review/assets/review-mode-contract.yaml), is an external consumer: it owns the deep-review loop (dimensions, verdicts, severity weights, convergence and quality gates) and reuses the severity ids defined here. When the two disagree on a severity id or its meaning, this file wins and the YAML is corrected by its owner, `deep-review`. The YAML may be stricter for its own loop, as when it requires `file:line` evidence on `P2`, but never looser.\n21: \n22: ---\n23: \n24: ## 1. OVERVIEW\n25: \n26: ### Purpose\n27: \n28: Shared findings-first review doctrine for both single-pass and deep-review workflows.\n29: \n30: ### When to Use\n31: \n32: - A `@review` or `@deep-review` pass that needs the severity contract, the evidence rules or the finding schema.\n33: - A review that must state its `Rule sources:` line, or apply a repository or surface override to a default-lens rule.\n34: \n35: Every rule in sections 2 to 7 is review floor, the part no repository or surface can change. Section 8 names the floor ids, the default lens that a repository may drop or replace, and how the review reads and reports those overrides.\n36: \n37: ---\n38: \n39: ## 2. SEVERITY DEFINITIONS\n40: \n41: | Level | Meaning | Handling |\n42: | --- | --- | --- |\n43: | P0 | Blocker: exploitable security issue, auth bypass, destructive data loss | Block merge |\n44: | P1 | Required: correctness bug, spec mismatch, must-fix gate issue | Fix before merge |\n45: | P2 | Suggestion: non-blocking improvement, documentation polish, style or maintainability follow-up | Optional or schedule follow-up |\n46: \n47: ### Reach Calibration\n48: \n49: A `P0` or `P1` finding names its reach: an input or call path that the code's stated contract allows, or a real caller that sends the failing input. The stated contract is what the code promises through its signature, types, doc comment, name and the checks it already makes.\n50: \n51: - A failure that needs input outside the stated contract, such as `NaN` where the contract says a number, a wrong type, or an inverted range the code already rejects, is `P2` hardening.\n52: - The exception is input the code claims to validate. When a guard, a thrown error or a doc line promises to reject an input class and the promise fails for an input in that class, the gap is a correctness finding and keeps `P1` or higher. A guard claims only the class it checks: an ordering check such as `min > max` does not claim that its operands are numbers.\n53: - At a trust boundary (user input, network, files, environment, another service), every value the outside can send is in reach. The stated contract of internal code never narrows a security finding on data that crosses that boundary.\n54: - A finding that cannot name its reach is `P2`, however severe the failure would be.\n55: \n56: Escalation rule: if confidence is low but impact is high, classify toward the higher severity and state the uncertainty explicitly. The confidence is confidence that the reach exists. The rule raises a finding whose reach is named but not proven, such as a caller that probably sends the input. It never raises a finding with no reach, so it cannot lift an out-of-contract failure above `P2`.\n57: \n58: ### Numeric Severity Calibration\n59: \n60: Numeric scores are advisory context, not the gate. A reviewer may add an optional `riskScore` to a finding and adjust it by `+/-2` for local context such as exploitability, blast radius, user impact, confidence, or proven containment. The merge/block decision remains the severity contract above: `P0` blocks, `P1` requires remediation, and `P2` is advisory. Do not adopt `score>=4` or any numeric threshold as a blocker.\n61: \n62: ---\n63: \n64: ## 3. EVIDENCE REQUIREMENTS\n65: \n66: - Every `P0` and `P1` finding must include a concrete `file:line` citation.\n67: - Evidence must tie the finding to observed code behavior, not just a general concern.\n68: - `P2` findings should still include specific evidence when available, even if impact is advisory.\n69: - If evidence is incomplete, state the assumption and why the risk still matters.\n70: \n71: ---\n72: \n73: ## 4. FINDINGS OUTPUT ORDERING\n74: \n75: - Present findings before summary or praise sections.\n76: - Order findings by severity first: `P0`, then `P1`, then `P2`.\n77: - Keep ordering stable within a severity bucket by impact and confidence.\n78: - Separate required fixes from optional suggestions so merge decisions stay clear.\n79: \n80: ---\n81: \n82: ## 5. BASELINE + SURFACE PRECEDENCE\n83: \n84: Apply this skill as the baseline first, then pair it with `sk-code` surface evidence when available:\n85: \n86: - Detected code surfaces -> the surfaces the quality runner's resolver places each reviewed file in, specific surfaces first and the `SKILLED` fallback last. Each one pairs with its `sk-code` evidence packet, such as `sk-code-skilled` for `SKILLED`. No match -> `UNKNOWN`. The resolver applies the shared detection contract, [`stack-detection.md`](../../shared/references/stack-detection.md) section 2, so the review keeps no detection of its own. Section 8 describes what it returns.\n87: - Unclear surfaces -> baseline-only plus explicit uncertainty\n88: \n89: Precedence rules:\n90: \n91: - Baseline security and correctness minimums are always enforced.\n92: - Surface style, process, build, and test conventions override generic baseline guidance.\n93: - A repository or surface changes one default-lens rule only through a `## Rule overrides` row, by the precedence in section 8.\n94: - Unclear conflicts must be escalated rather than guessed.\n95: \n96: ---\n97: \n98: ## 6. BASELINE CHECK FAMILIES\n99: \n100: Mandatory baseline families:\n101: \n102: - Correctness minimums: regression risk, contract safety, spec mismatch, destructive side effects, and boundary handling.\n103: - Security minimums: auth and authorization gaps, injection exposure, unsafe secrets handling, privilege misuse, and reliability risks with security impact.\n104: \n105: These minimums cannot be relaxed by surface guidance.\n106: \n107: ---\n108: \n109: ## 7. FINDING SCHEMA\n110: \n111: Each finding should provide:\n112: \n113: | Field | Requirement |\n114: | --- | --- |\n115: | `id` | The finding's number in the Findings list, counted once across severity groups, such as `2` |\n116: | `severity` | One of `P0`, `P1`, `P2` |\n117: | `title` | Short, risk-oriented summary |\n118: | `case` | The input or situation that produces the wrong result. A finding with no case is not reported |\n119: | `file` | Primary `path:line` location |\n120: | `evidence` | Plain-language explanation tied to observed code; for a performance finding, name the workload it assumes, such as row count, request rate or payload size |\n[Output truncated. Continue reading with offset: 121]"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\": \".skilled/skills/sk-code/sk-code-review/references/review-core.md\", \"limit\": 120}"},"time":{"start":1794570384356,"end":1794570384671}}}}
