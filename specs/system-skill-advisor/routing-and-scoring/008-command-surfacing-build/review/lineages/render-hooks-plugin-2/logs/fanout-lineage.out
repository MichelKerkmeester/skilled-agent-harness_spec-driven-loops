{"type":"tool_use","timestamp":1794570422712,"sessionID":"ses_e2b4a243affexa25EPiSDt2Sxc","part":{"partID":"prt_1d4bb84e7001cd2tz3JhuC96J3","sessionID":"ses_e2b4a243affexa25EPiSDt2Sxc","messageID":"msg_1d4bb6ac90015fnGZSkZdRf8wa","type":"tool","id":"chatcmpl-tool-a7c73e21b36edb00","tool":"read","state":{"status":"completed","input":{"path":".skilled/skills/system-skill-advisor/runtime/tests/render-child-session.vitest.ts"},"output":"Read file .skilled/skills/system-skill-advisor/runtime/tests/render-child-session.vitest.ts, lines 1-154\n1: // ───────────────────────────────────────────────────────────────\n2: // MODULE: Child Session Brief Render Tests\n3: // ───────────────────────────────────────────────────────────────\n4: //\n5: // A dispatched child must not start a workflow its parent did not name, so the\n6: // brief swaps the policy word for a marker there and nowhere else.\n7: //\n8: // Axes, one row each:\n9: //   child variable: set to 1, set to another value (0), unset\n10: //   policy: run, start, ask\n11: //   class: read-only, not read-only (add-only)\n12: \n13: import { afterEach, describe, expect, it, vi } from 'vitest';\n14: import {\n15:   DIRECTIVES_LABEL,\n16:   HYGIENE_DIRECTIVE,\n17:   renderAdvisorBrief,\n18: } from '../lib/render.js';\n19: import { isChildSession } from '../../../system-spec-kit/runtime/hooks/lib/spec-gate/spec-gate-core.mjs';\n20: \n21: type AdvisorBriefResult = Parameters<typeof renderAdvisorBrief>[0];\n22: \n23: function expectedBrief(summary: string): string {\n24:   return `${summary}${DIRECTIVES_LABEL}${HYGIENE_DIRECTIVE}`;\n25: }\n26: \n27: // One passing recommendation isolates the label form from threshold filtering.\n28: function advisorResult(skill: string): AdvisorBriefResult {\n29:   return {\n30:     status: 'ok',\n31:     freshness: 'live',\n32:     recommendations: [{\n33:       skill,\n34:       kind: 'command',\n35:       confidence: 0.85,\n36:       uncertainty: 0.2,\n37:       passes_threshold: true,\n38:     }],\n39:     metrics: { tokenCap: 80 },\n40:   };\n41: }\n42: \n43: describe('child session command brief', () => {\n44:   afterEach(() => {\n45:     vi.unstubAllEnvs();\n46:   });\n47: \n48:   it('renders a start command as parent-named only', () => {\n49:     vi.stubEnv('AI_SESSION_CHILD', '1');\n50: \n51:     const rendered = renderAdvisorBrief(advisorResult('command-create-readme'));\n52: \n53:     expect(rendered).toBe(expectedBrief(\n54:       'Advisor: live; use sk-doc → /create:readme (parent-named only) 0.85/0.20 pass.',\n55:     ));\n56:   });\n57: \n58:   it('renders an ask command as parent-named only', () => {\n59:     vi.stubEnv('AI_SESSION_CHILD', '1');\n60: \n61:     const rendered = renderAdvisorBrief(advisorResult('command-deep-research'));\n62: \n63:     expect(rendered).toBe(expectedBrief(\n64:       'Advisor: live; use system-deep-loop → /deep:research (parent-named only) 0.85/0.20 pass.',\n65:     ));\n66:   });\n67: \n68:   it('keeps the policy word for a read-only run', () => {\n69:     vi.stubEnv('AI_SESSION_CHILD', '1');\n70: \n71:     const rendered = renderAdvisorBrief(advisorResult('command-doctor-git-setup'));\n72: \n73:     expect(rendered).toBe(expectedBrief(\n74:       'Advisor: live; use sk-git → /doctor:git setup (run) 0.85/0.20 pass.',\n75:     ));\n76:   });\n77: \n78:   it('renders a run command that adds files as parent-named only', () => {\n79:     vi.stubEnv('AI_SESSION_CHILD', '1');\n80: \n81:     const rendered = renderAdvisorBrief(advisorResult('command-doctor-speckit'));\n82: \n83:     expect(rendered).toBe(expectedBrief(\n84:       'Advisor: live; use system-skilled-doctor → /doctor:speckit (parent-named only) 0.85/0.20 pass.',\n85:     ));\n86:   });\n87: \n88:   it('takes the class from the row of the command it prints', () => {\n89:     vi.stubEnv('AI_SESSION_CHILD', '1');\n90: \n91:     const rendered = renderAdvisorBrief({\n92:       status: 'ok',\n93:       freshness: 'live',\n94:       recommendations: [{\n95:         skill: 'command-speckit-search',\n96:         kind: 'command',\n97:         command: '/doctor:speckit',\n98:         policy: 'run',\n99:         confidence: 0.85,\n100:         uncertainty: 0.2,\n101:         passes_threshold: true,\n102:       }],\n103:       metrics: { tokenCap: 80 },\n104:     });\n105:     const head = rendered.slice(0, rendered.indexOf(DIRECTIVES_LABEL));\n106: \n107:     expect(head).toContain('/doctor:speckit (parent-named only)');\n108:   });\n109: \n110:   it('matches the non-child render when the variable is 0', () => {\n111:     vi.stubEnv('AI_SESSION_CHILD', '0');\n112:     const baseline = renderAdvisorBrief(advisorResult('command-create-readme'), { childSession: false });\n113: \n114:     const rendered = renderAdvisorBrief(advisorResult('command-create-readme'));\n115: \n116:     expect(rendered).toBe(baseline);\n117:     expect(rendered).toBe(expectedBrief(\n118:       'Advisor: live; use sk-doc → /create:readme (start) 0.85/0.20 pass.',\n119:     ));\n120:   });\n121: \n122:   it('matches the non-child render when the variable is unset', () => {\n123:     vi.stubEnv('AI_SESSION_CHILD', undefined);\n124:     const baseline = renderAdvisorBrief(advisorResult('command-deep-research'), { childSession: false });\n125: \n126:     const rendered = renderAdvisorBrief(advisorResult('command-deep-research'));\n127: \n128:     expect(rendered).toBe(baseline);\n129:     expect(rendered).toBe(expectedBrief(\n130:       'Advisor: live; use system-deep-loop → /deep:research (ask) 0.85/0.20 pass.',\n131:     ));\n132:   });\n133: \n134:   it('renders a doctor bridge at the top as parent-named only', () => {\n135:     vi.stubEnv('AI_SESSION_CHILD', '1');\n136: \n137:     const rendered = renderAdvisorBrief(advisorResult('command-doctor-git-hooks'));\n138: \n139:     expect(rendered).toBe(expectedBrief(\n140:       'Advisor: live; use sk-git → /doctor:git hooks (parent-named only) 0.85/0.20 pass.',\n141:     ));\n142:   });\n143: \n144:   // The renderer keeps its own literal so the runtime build has no edge into\n145:   // the spec kit, and this case keeps the two rules equal.\n146:   it.each(['1', '0', 'true', ''])('reads AI_SESSION_CHILD=%s as the spec gate does', (value) => {\n147:     vi.stubEnv('AI_SESSION_CHILD', value);\n148: \n149:     const rendered = renderAdvisorBrief(advisorResult('command-create-readme'));\n150:     const head = rendered.slice(0, rendered.indexOf(DIRECTIVES_LABEL));\n151: \n152:     expect(head.includes('(parent-named only)')).toBe(isChildSession({ AI_SESSION_CHILD: value }));\n153:   });\n154: });","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file .skilled/skills/system-skill-advisor/runtime/tests/render-child-session.vitest.ts, lines 1-154\n1: // ───────────────────────────────────────────────────────────────\n2: // MODULE: Child Session Brief Render Tests\n3: // ───────────────────────────────────────────────────────────────\n4: //\n5: // A dispatched child must not start a workflow its parent did not name, so the\n6: // brief swaps the policy word for a marker there and nowhere else.\n7: //\n8: // Axes, one row each:\n9: //   child variable: set to 1, set to another value (0), unset\n10: //   policy: run, start, ask\n11: //   class: read-only, not read-only (add-only)\n12: \n13: import { afterEach, describe, expect, it, vi } from 'vitest';\n14: import {\n15:   DIRECTIVES_LABEL,\n16:   HYGIENE_DIRECTIVE,\n17:   renderAdvisorBrief,\n18: } from '../lib/render.js';\n19: import { isChildSession } from '../../../system-spec-kit/runtime/hooks/lib/spec-gate/spec-gate-core.mjs';\n20: \n21: type AdvisorBriefResult = Parameters<typeof renderAdvisorBrief>[0];\n22: \n23: function expectedBrief(summary: string): string {\n24:   return `${summary}${DIRECTIVES_LABEL}${HYGIENE_DIRECTIVE}`;\n25: }\n26: \n27: // One passing recommendation isolates the label form from threshold filtering.\n28: function advisorResult(skill: string): AdvisorBriefResult {\n29:   return {\n30:     status: 'ok',\n31:     freshness: 'live',\n32:     recommendations: [{\n33:       skill,\n34:       kind: 'command',\n35:       confidence: 0.85,\n36:       uncertainty: 0.2,\n37:       passes_threshold: true,\n38:     }],\n39:     metrics: { tokenCap: 80 },\n40:   };\n41: }\n42: \n43: describe('child session command brief', () => {\n44:   afterEach(() => {\n45:     vi.unstubAllEnvs();\n46:   });\n47: \n48:   it('renders a start command as parent-named only', () => {\n49:     vi.stubEnv('AI_SESSION_CHILD', '1');\n50: \n51:     const rendered = renderAdvisorBrief(advisorResult('command-create-readme'));\n52: \n53:     expect(rendered).toBe(expectedBrief(\n54:       'Advisor: live; use sk-doc → /create:readme (parent-named only) 0.85/0.20 pass.',\n55:     ));\n56:   });\n57: \n58:   it('renders an ask command as parent-named only', () => {\n59:     vi.stubEnv('AI_SESSION_CHILD', '1');\n60: \n61:     const rendered = renderAdvisorBrief(advisorResult('command-deep-research'));\n62: \n63:     expect(rendered).toBe(expectedBrief(\n64:       'Advisor: live; use system-deep-loop → /deep:research (parent-named only) 0.85/0.20 pass.',\n65:     ));\n66:   });\n67: \n68:   it('keeps the policy word for a read-only run', () => {\n69:     vi.stubEnv('AI_SESSION_CHILD', '1');\n70: \n71:     const rendered = renderAdvisorBrief(advisorResult('command-doctor-git-setup'));\n72: \n73:     expect(rendered).toBe(expectedBrief(\n74:       'Advisor: live; use sk-git → /doctor:git setup (run) 0.85/0.20 pass.',\n75:     ));\n76:   });\n77: \n78:   it('renders a run command that adds files as parent-named only', () => {\n79:     vi.stubEnv('AI_SESSION_CHILD', '1');\n80: \n81:     const rendered = renderAdvisorBrief(advisorResult('command-doctor-speckit'));\n82: \n83:     expect(rendered).toBe(expectedBrief(\n84:       'Advisor: live; use system-skilled-doctor → /doctor:speckit (parent-named only) 0.85/0.20 pass.',\n85:     ));\n86:   });\n87: \n88:   it('takes the class from the row of the command it prints', () => {\n89:     vi.stubEnv('AI_SESSION_CHILD', '1');\n90: \n91:     const rendered = renderAdvisorBrief({\n92:       status: 'ok',\n93:       freshness: 'live',\n94:       recommendations: [{\n95:         skill: 'command-speckit-search',\n96:         kind: 'command',\n97:         command: '/doctor:speckit',\n98:         policy: 'run',\n99:         confidence: 0.85,\n100:         uncertainty: 0.2,\n101:         passes_threshold: true,\n102:       }],\n103:       metrics: { tokenCap: 80 },\n104:     });\n105:     const head = rendered.slice(0, rendered.indexOf(DIRECTIVES_LABEL));\n106: \n107:     expect(head).toContain('/doctor:speckit (parent-named only)');\n108:   });\n109: \n110:   it('matches the non-child render when the variable is 0', () => {\n111:     vi.stubEnv('AI_SESSION_CHILD', '0');\n112:     const baseline = renderAdvisorBrief(advisorResult('command-create-readme'), { childSession: false });\n113: \n114:     const rendered = renderAdvisorBrief(advisorResult('command-create-readme'));\n115: \n116:     expect(rendered).toBe(baseline);\n117:     expect(rendered).toBe(expectedBrief(\n118:       'Advisor: live; use sk-doc → /create:readme (start) 0.85/0.20 pass.',\n119:     ));\n120:   });\n121: \n122:   it('matches the non-child render when the variable is unset', () => {\n123:     vi.stubEnv('AI_SESSION_CHILD', undefined);\n124:     const baseline = renderAdvisorBrief(advisorResult('command-deep-research'), { childSession: false });\n125: \n126:     const rendered = renderAdvisorBrief(advisorResult('command-deep-research'));\n127: \n128:     expect(rendered).toBe(baseline);\n129:     expect(rendered).toBe(expectedBrief(\n130:       'Advisor: live; use system-deep-loop → /deep:research (ask) 0.85/0.20 pass.',\n131:     ));\n132:   });\n133: \n134:   it('renders a doctor bridge at the top as parent-named only', () => {\n135:     vi.stubEnv('AI_SESSION_CHILD', '1');\n136: \n137:     const rendered = renderAdvisorBrief(advisorResult('command-doctor-git-hooks'));\n138: \n139:     expect(rendered).toBe(expectedBrief(\n140:       'Advisor: live; use sk-git → /doctor:git hooks (parent-named only) 0.85/0.20 pass.',\n141:     ));\n142:   });\n143: \n144:   // The renderer keeps its own literal so the runtime build has no edge into\n145:   // the spec kit, and this case keeps the two rules equal.\n146:   it.each(['1', '0', 'true', ''])('reads AI_SESSION_CHILD=%s as the spec gate does', (value) => {\n147:     vi.stubEnv('AI_SESSION_CHILD', value);\n148: \n149:     const rendered = renderAdvisorBrief(advisorResult('command-create-readme'));\n150:     const head = rendered.slice(0, rendered.indexOf(DIRECTIVES_LABEL));\n151: \n152:     expect(head.includes('(parent-named only)')).toBe(isChildSession({ AI_SESSION_CHILD: value }));\n153:   });\n154: });"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\": \".skilled/skills/system-skill-advisor/runtime/tests/render-child-session.vitest.ts\"}"},"time":{"start":1794570421479,"end":1794570422712}}}}
{"type":"tool_use","timestamp":1794570422740,"sessionID":"ses_e2b4a243affexa25EPiSDt2Sxc","part":{"partID":"prt_1d4bb83e0001TkpAnpRYXZrzIY","sessionID":"ses_e2b4a243affexa25EPiSDt2Sxc","messageID":"msg_1d4bb6ac90015fnGZSkZdRf8wa","type":"tool","id":"chatcmpl-tool-a84b2f952a5736dd","tool":"read","state":{"status":"completed","input":{"path":".skilled/skills/system-skill-advisor/runtime/tests/command-brief-golden.vitest.ts"},"output":"Read file .skilled/skills/system-skill-advisor/runtime/tests/command-brief-golden.vitest.ts, lines 1-254\n1: // ───────────────────────────────────────────────────────────────\n2: // MODULE: Command Brief Golden Tests\n3: // ───────────────────────────────────────────────────────────────\n4: \n5: import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';\n6: import { renderAdvisorBrief } from '../lib/render.js';\n7: \n8: const DIRECTIVES_LABEL = '\\nDirectives:';\n9: // The advisor portion is capped at 80 tokens and the renderer estimates four\n10: // characters per token, so a longer head has already lost the command it offered.\n11: const HEAD_CHARACTER_CAP = 320;\n12: \n13: type AdvisorBriefResult = Parameters<typeof renderAdvisorBrief>[0];\n14: \n15: interface RecommendationInput {\n16:   readonly skill: string;\n17:   readonly kind?: 'skill' | 'command';\n18:   readonly command?: string;\n19:   readonly policy?: 'run' | 'start' | 'ask';\n20:   readonly ownerSkillId?: string;\n21:   readonly needsMode?: boolean;\n22:   readonly confidence: number;\n23:   readonly uncertainty: number;\n24: }\n25: \n26: interface HeadCase {\n27:   readonly name: string;\n28:   readonly recommendation: RecommendationInput;\n29:   readonly expectedHead: string;\n30: }\n31: \n32: const HEAD_CASES: readonly HeadCase[] = [\n33:   {\n34:     name: 'a documentation request names the owning skill, the command and its policy',\n35:     recommendation: {\n36:       skill: 'sk-doc',\n37:       kind: 'command',\n38:       command: '/create:readme',\n39:       policy: 'start',\n40:       ownerSkillId: 'sk-doc',\n41:       confidence: 0.95,\n42:       uncertainty: 0.12,\n43:     },\n44:     expectedHead: 'Advisor: live; use sk-doc → /create:readme (start) 0.95/0.12 pass.',\n45:   },\n46:   {\n47:     name: 'a research hub names the deep workflow it would start',\n48:     recommendation: {\n49:       skill: 'system-deep-loop',\n50:       kind: 'command',\n51:       command: '/deep:research',\n52:       policy: 'ask',\n53:       ownerSkillId: 'system-deep-loop',\n54:       confidence: 0.82,\n55:       uncertainty: 0.16,\n56:     },\n57:     expectedHead: 'Advisor: live; use system-deep-loop → /deep:research (ask) 0.82/0.16 pass.',\n58:   },\n59:   {\n60:     name: 'a design request names the chart mode',\n61:     recommendation: {\n62:       skill: 'sk-design',\n63:       kind: 'command',\n64:       command: '/design:chart',\n65:       policy: 'start',\n66:       ownerSkillId: 'sk-design',\n67:       confidence: 0.9,\n68:       uncertainty: 0.12,\n69:     },\n70:     expectedHead: 'Advisor: live; use sk-design → /design:chart (start) 0.90/0.12 pass.',\n71:   },\n72:   {\n73:     name: 'a doctor bridge names the owning skill and the runnable subcommand',\n74:     recommendation: {\n75:       skill: 'command-doctor-git-hooks',\n76:       kind: 'command',\n77:       command: '/doctor:git hooks',\n78:       policy: 'ask',\n79:       ownerSkillId: 'sk-git',\n80:       confidence: 0.82,\n81:       uncertainty: 0.12,\n82:     },\n83:     expectedHead: 'Advisor: live; use sk-git → /doctor:git hooks (ask) 0.82/0.12 pass.',\n84:   },\n85:   {\n86:     name: 'a memory save names the spec workflow',\n87:     recommendation: {\n88:       skill: 'system-spec-kit',\n89:       kind: 'command',\n90:       command: '/speckit:save',\n91:       policy: 'start',\n92:       ownerSkillId: 'system-spec-kit',\n93:       confidence: 0.89,\n94:       uncertainty: 0.12,\n95:     },\n96:     expectedHead: 'Advisor: live; use system-spec-kit → /speckit:save (start) 0.89/0.12 pass.',\n97:   },\n98:   {\n99:     name: 'a prompt rewrite names the prompt skill',\n100:     recommendation: {\n101:       skill: 'sk-prompt',\n102:       kind: 'command',\n103:       command: '/prompt:improve',\n104:       policy: 'start',\n105:       ownerSkillId: 'sk-prompt',\n106:       confidence: 0.89,\n107:       uncertainty: 0.12,\n108:     },\n109:     expectedHead: 'Advisor: live; use sk-prompt → /prompt:improve (start) 0.89/0.12 pass.',\n110:   },\n111:   {\n112:     name: 'a row id with no fields is filled from the generated command table',\n113:     recommendation: {\n114:       skill: 'command-create-readme',\n115:       kind: 'command',\n116:       confidence: 0.91,\n117:       uncertainty: 0.11,\n118:     },\n119:     expectedHead: 'Advisor: live; use sk-doc → /create:readme (start) 0.91/0.11 pass.',\n120:   },\n121:   {\n122:     name: 'an id with no row keeps the plain skill head',\n123:     recommendation: {\n124:       skill: 'sk-review',\n125:       confidence: 0.61,\n126:       uncertainty: 0.28,\n127:     },\n128:     expectedHead: 'Advisor: live; use sk-review 0.61/0.28 pass.',\n129:   },\n130:   {\n131:     name: 'a command with no known policy drops the parenthesis',\n132:     recommendation: {\n133:       skill: 'command-doctor-review-gate',\n134:       kind: 'command',\n135:       command: '/doctor:review gate',\n136:       ownerSkillId: 'sk-code',\n137:       confidence: 0.77,\n138:       uncertainty: 0.2,\n139:     },\n140:     expectedHead: 'Advisor: live; use sk-code → /doctor:review gate 0.77/0.20 pass.',\n141:   },\n142:   {\n143:     name: 'a hub that needs a mode says so instead of naming a command',\n144:     recommendation: {\n145:       skill: 'system-deep-loop',\n146:       needsMode: true,\n147:       confidence: 0.82,\n148:       uncertainty: 0.2,\n149:     },\n150:     expectedHead: 'Advisor: live; use system-deep-loop (needs a mode) 0.82/0.20 pass.',\n151:   },\n152:   {\n153:     name: 'a command on the hub wins over the mode flag',\n154:     recommendation: {\n155:       skill: 'system-deep-loop',\n156:       kind: 'command',\n157:       command: '/deep:review',\n158:       policy: 'ask',\n159:       ownerSkillId: 'system-deep-loop',\n160:       needsMode: true,\n161:       confidence: 0.82,\n162:       uncertainty: 0.16,\n163:     },\n164:     expectedHead: 'Advisor: live; use system-deep-loop → /deep:review (ask) 0.82/0.16 pass.',\n165:   },\n166: ];\n167: \n168: // Every recommendation is marked as passing so each case isolates the head form\n169: // instead of threshold filtering.\n170: function advisorResult(recommendation: RecommendationInput): AdvisorBriefResult {\n171:   return {\n172:     status: 'ok',\n173:     freshness: 'live',\n174:     recommendations: [{ ...recommendation, passes_threshold: true }],\n175:     metrics: { tokenCap: 80 },\n176:   };\n177: }\n178: \n179: // The ambiguous branch renders only above the default token cap, so the two-sided\n180: // case carries its own wider-capped result instead of the single-entry helper.\n181: const AMBIGUOUS_COMMAND_RESULT: AdvisorBriefResult = {\n182:   status: 'ok',\n183:   freshness: 'live',\n184:   recommendations: [\n185:     {\n186:       skill: 'command-doctor-git-hooks',\n187:       kind: 'command',\n188:       confidence: 0.82,\n189:       uncertainty: 0.12,\n190:       passes_threshold: true,\n191:     },\n192:     {\n193:       skill: 'command-speckit-save',\n194:       kind: 'command',\n195:       confidence: 0.89,\n196:       uncertainty: 0.12,\n197:       passes_threshold: true,\n198:     },\n199:   ],\n200:   ambiguous: true,\n201:   metrics: { tokenCap: 120 },\n202: };\n203: \n204: function headOf(rendered: string | null): string {\n205:   if (rendered === null) {\n206:     throw new Error('expected a rendered brief');\n207:   }\n208:   return rendered.split(DIRECTIVES_LABEL)[0];\n209: }\n210: \n211: describe('command brief golden heads', () => {\n212:   // The expected heads are the interactive ones, so a run inside a dispatched\n213:   // child must not turn them into the child form.\n214:   beforeEach(() => {\n215:     vi.stubEnv('AI_SESSION_CHILD', '');\n216:   });\n217: \n218:   afterEach(() => {\n219:     vi.unstubAllEnvs();\n220:   });\n221: \n222:   it.each(HEAD_CASES)('renders $name', ({ recommendation, expectedHead }) => {\n223:     const head = headOf(renderAdvisorBrief(advisorResult(recommendation)));\n224: \n225:     expect(head).toBe(expectedHead);\n226:     expect(head.length).toBeLessThanOrEqual(HEAD_CHARACTER_CAP);\n227:     expect(head).not.toContain('command-');\n228:   });\n229: \n230:   // A generated row can name a command the hub withheld because the prompt names\n231:   // no single mode, so the marker wins over the row instead of printing a command\n232:   // the reader never asked for.\n233:   it('renders needs a mode even when the id has a command row', () => {\n234:     const head = headOf(renderAdvisorBrief(advisorResult({\n235:       skill: 'command-create-agent',\n236:       needsMode: true,\n237:       confidence: 0.95,\n238:       uncertainty: 0.12,\n239:     })));\n240: \n241:     expect(head).toContain('use sk-doc (needs a mode)');\n242:     expect(head).not.toContain('command-');\n243:     expect(head).not.toContain('/create:agent');\n244:   });\n245: \n246:   it('renders both command labels under an ambiguous head', () => {\n247:     const head = headOf(renderAdvisorBrief(AMBIGUOUS_COMMAND_RESULT));\n248: \n249:     expect(head.startsWith('Advisor: live; ambiguous: sk-git → /doctor:git hooks (ask)')).toBe(true);\n250:     expect(head).toContain(' vs system-spec-kit → /speckit:save (start)');\n251:     expect(head.length).toBeLessThanOrEqual(HEAD_CHARACTER_CAP);\n252:     expect(head).not.toContain('command-');\n253:   });\n254: });","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file .skilled/skills/system-skill-advisor/runtime/tests/command-brief-golden.vitest.ts, lines 1-254\n1: // ───────────────────────────────────────────────────────────────\n2: // MODULE: Command Brief Golden Tests\n3: // ───────────────────────────────────────────────────────────────\n4: \n5: import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';\n6: import { renderAdvisorBrief } from '../lib/render.js';\n7: \n8: const DIRECTIVES_LABEL = '\\nDirectives:';\n9: // The advisor portion is capped at 80 tokens and the renderer estimates four\n10: // characters per token, so a longer head has already lost the command it offered.\n11: const HEAD_CHARACTER_CAP = 320;\n12: \n13: type AdvisorBriefResult = Parameters<typeof renderAdvisorBrief>[0];\n14: \n15: interface RecommendationInput {\n16:   readonly skill: string;\n17:   readonly kind?: 'skill' | 'command';\n18:   readonly command?: string;\n19:   readonly policy?: 'run' | 'start' | 'ask';\n20:   readonly ownerSkillId?: string;\n21:   readonly needsMode?: boolean;\n22:   readonly confidence: number;\n23:   readonly uncertainty: number;\n24: }\n25: \n26: interface HeadCase {\n27:   readonly name: string;\n28:   readonly recommendation: RecommendationInput;\n29:   readonly expectedHead: string;\n30: }\n31: \n32: const HEAD_CASES: readonly HeadCase[] = [\n33:   {\n34:     name: 'a documentation request names the owning skill, the command and its policy',\n35:     recommendation: {\n36:       skill: 'sk-doc',\n37:       kind: 'command',\n38:       command: '/create:readme',\n39:       policy: 'start',\n40:       ownerSkillId: 'sk-doc',\n41:       confidence: 0.95,\n42:       uncertainty: 0.12,\n43:     },\n44:     expectedHead: 'Advisor: live; use sk-doc → /create:readme (start) 0.95/0.12 pass.',\n45:   },\n46:   {\n47:     name: 'a research hub names the deep workflow it would start',\n48:     recommendation: {\n49:       skill: 'system-deep-loop',\n50:       kind: 'command',\n51:       command: '/deep:research',\n52:       policy: 'ask',\n53:       ownerSkillId: 'system-deep-loop',\n54:       confidence: 0.82,\n55:       uncertainty: 0.16,\n56:     },\n57:     expectedHead: 'Advisor: live; use system-deep-loop → /deep:research (ask) 0.82/0.16 pass.',\n58:   },\n59:   {\n60:     name: 'a design request names the chart mode',\n61:     recommendation: {\n62:       skill: 'sk-design',\n63:       kind: 'command',\n64:       command: '/design:chart',\n65:       policy: 'start',\n66:       ownerSkillId: 'sk-design',\n67:       confidence: 0.9,\n68:       uncertainty: 0.12,\n69:     },\n70:     expectedHead: 'Advisor: live; use sk-design → /design:chart (start) 0.90/0.12 pass.',\n71:   },\n72:   {\n73:     name: 'a doctor bridge names the owning skill and the runnable subcommand',\n74:     recommendation: {\n75:       skill: 'command-doctor-git-hooks',\n76:       kind: 'command',\n77:       command: '/doctor:git hooks',\n78:       policy: 'ask',\n79:       ownerSkillId: 'sk-git',\n80:       confidence: 0.82,\n81:       uncertainty: 0.12,\n82:     },\n83:     expectedHead: 'Advisor: live; use sk-git → /doctor:git hooks (ask) 0.82/0.12 pass.',\n84:   },\n85:   {\n86:     name: 'a memory save names the spec workflow',\n87:     recommendation: {\n88:       skill: 'system-spec-kit',\n89:       kind: 'command',\n90:       command: '/speckit:save',\n91:       policy: 'start',\n92:       ownerSkillId: 'system-spec-kit',\n93:       confidence: 0.89,\n94:       uncertainty: 0.12,\n95:     },\n96:     expectedHead: 'Advisor: live; use system-spec-kit → /speckit:save (start) 0.89/0.12 pass.',\n97:   },\n98:   {\n99:     name: 'a prompt rewrite names the prompt skill',\n100:     recommendation: {\n101:       skill: 'sk-prompt',\n102:       kind: 'command',\n103:       command: '/prompt:improve',\n104:       policy: 'start',\n105:       ownerSkillId: 'sk-prompt',\n106:       confidence: 0.89,\n107:       uncertainty: 0.12,\n108:     },\n109:     expectedHead: 'Advisor: live; use sk-prompt → /prompt:improve (start) 0.89/0.12 pass.',\n110:   },\n111:   {\n112:     name: 'a row id with no fields is filled from the generated command table',\n113:     recommendation: {\n114:       skill: 'command-create-readme',\n115:       kind: 'command',\n116:       confidence: 0.91,\n117:       uncertainty: 0.11,\n118:     },\n119:     expectedHead: 'Advisor: live; use sk-doc → /create:readme (start) 0.91/0.11 pass.',\n120:   },\n121:   {\n122:     name: 'an id with no row keeps the plain skill head',\n123:     recommendation: {\n124:       skill: 'sk-review',\n125:       confidence: 0.61,\n126:       uncertainty: 0.28,\n127:     },\n128:     expectedHead: 'Advisor: live; use sk-review 0.61/0.28 pass.',\n129:   },\n130:   {\n131:     name: 'a command with no known policy drops the parenthesis',\n132:     recommendation: {\n133:       skill: 'command-doctor-review-gate',\n134:       kind: 'command',\n135:       command: '/doctor:review gate',\n136:       ownerSkillId: 'sk-code',\n137:       confidence: 0.77,\n138:       uncertainty: 0.2,\n139:     },\n140:     expectedHead: 'Advisor: live; use sk-code → /doctor:review gate 0.77/0.20 pass.',\n141:   },\n142:   {\n143:     name: 'a hub that needs a mode says so instead of naming a command',\n144:     recommendation: {\n145:       skill: 'system-deep-loop',\n146:       needsMode: true,\n147:       confidence: 0.82,\n148:       uncertainty: 0.2,\n149:     },\n150:     expectedHead: 'Advisor: live; use system-deep-loop (needs a mode) 0.82/0.20 pass.',\n151:   },\n152:   {\n153:     name: 'a command on the hub wins over the mode flag',\n154:     recommendation: {\n155:       skill: 'system-deep-loop',\n156:       kind: 'command',\n157:       command: '/deep:review',\n158:       policy: 'ask',\n159:       ownerSkillId: 'system-deep-loop',\n160:       needsMode: true,\n161:       confidence: 0.82,\n162:       uncertainty: 0.16,\n163:     },\n164:     expectedHead: 'Advisor: live; use system-deep-loop → /deep:review (ask) 0.82/0.16 pass.',\n165:   },\n166: ];\n167: \n168: // Every recommendation is marked as passing so each case isolates the head form\n169: // instead of threshold filtering.\n170: function advisorResult(recommendation: RecommendationInput): AdvisorBriefResult {\n171:   return {\n172:     status: 'ok',\n173:     freshness: 'live',\n174:     recommendations: [{ ...recommendation, passes_threshold: true }],\n175:     metrics: { tokenCap: 80 },\n176:   };\n177: }\n178: \n179: // The ambiguous branch renders only above the default token cap, so the two-sided\n180: // case carries its own wider-capped result instead of the single-entry helper.\n181: const AMBIGUOUS_COMMAND_RESULT: AdvisorBriefResult = {\n182:   status: 'ok',\n183:   freshness: 'live',\n184:   recommendations: [\n185:     {\n186:       skill: 'command-doctor-git-hooks',\n187:       kind: 'command',\n188:       confidence: 0.82,\n189:       uncertainty: 0.12,\n190:       passes_threshold: true,\n191:     },\n192:     {\n193:       skill: 'command-speckit-save',\n194:       kind: 'command',\n195:       confidence: 0.89,\n196:       uncertainty: 0.12,\n197:       passes_threshold: true,\n198:     },\n199:   ],\n200:   ambiguous: true,\n201:   metrics: { tokenCap: 120 },\n202: };\n203: \n204: function headOf(rendered: string | null): string {\n205:   if (rendered === null) {\n206:     throw new Error('expected a rendered brief');\n207:   }\n208:   return rendered.split(DIRECTIVES_LABEL)[0];\n209: }\n210: \n211: describe('command brief golden heads', () => {\n212:   // The expected heads are the interactive ones, so a run inside a dispatched\n213:   // child must not turn them into the child form.\n214:   beforeEach(() => {\n215:     vi.stubEnv('AI_SESSION_CHILD', '');\n216:   });\n217: \n218:   afterEach(() => {\n219:     vi.unstubAllEnvs();\n220:   });\n221: \n222:   it.each(HEAD_CASES)('renders $name', ({ recommendation, expectedHead }) => {\n223:     const head = headOf(renderAdvisorBrief(advisorResult(recommendation)));\n224: \n225:     expect(head).toBe(expectedHead);\n226:     expect(head.length).toBeLessThanOrEqual(HEAD_CHARACTER_CAP);\n227:     expect(head).not.toContain('command-');\n228:   });\n229: \n230:   // A generated row can name a command the hub withheld because the prompt names\n231:   // no single mode, so the marker wins over the row instead of printing a command\n232:   // the reader never asked for.\n233:   it('renders needs a mode even when the id has a command row', () => {\n234:     const head = headOf(renderAdvisorBrief(advisorResult({\n235:       skill: 'command-create-agent',\n236:       needsMode: true,\n237:       confidence: 0.95,\n238:       uncertainty: 0.12,\n239:     })));\n240: \n241:     expect(head).toContain('use sk-doc (needs a mode)');\n242:     expect(head).not.toContain('command-');\n243:     expect(head).not.toContain('/create:agent');\n244:   });\n245: \n246:   it('renders both command labels under an ambiguous head', () => {\n247:     const head = headOf(renderAdvisorBrief(AMBIGUOUS_COMMAND_RESULT));\n248: \n249:     expect(head.startsWith('Advisor: live; ambiguous: sk-git → /doctor:git hooks (ask)')).toBe(true);\n250:     expect(head).toContain(' vs system-spec-kit → /speckit:save (start)');\n251:     expect(head.length).toBeLessThanOrEqual(HEAD_CHARACTER_CAP);\n252:     expect(head).not.toContain('command-');\n253:   });\n254: });"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\": \".skilled/skills/system-skill-advisor/runtime/tests/command-brief-golden.vitest.ts\"}"},"time":{"start":1794570421216,"end":1794570422740}}}}
