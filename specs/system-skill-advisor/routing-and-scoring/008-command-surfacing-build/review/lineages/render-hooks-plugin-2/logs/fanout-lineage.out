{"type":"tool_use","timestamp":1794571478439,"sessionID":"ses_e2b4a243affexa25EPiSDt2Sxc","part":{"partID":"prt_1d4cba4a0002wr3Xx6SnT5EBK7","sessionID":"ses_e2b4a243affexa25EPiSDt2Sxc","messageID":"msg_1d4cb9a15001326pdtDk7bo65J","type":"tool","id":"chatcmpl-tool-b419653adbd124ea","tool":"read","state":{"status":"completed","input":{"path":".skilled/skills/system-skill-advisor/runtime/tests/hooks/skill-advisor-cli-fallback-envelope.vitest.ts"},"output":"Read file .skilled/skills/system-skill-advisor/runtime/tests/hooks/skill-advisor-cli-fallback-envelope.vitest.ts, lines 1-88\n1: // ───────────────────────────────────────────────────────────────\n2: // MODULE: Skill Advisor CLI Fallback Envelope Tests\n3: // ───────────────────────────────────────────────────────────────\n4: \n5: import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';\n6: \n7: import {\n8:   resultFromCliData,\n9:   skillAdvisorCliFallbackEnvelope,\n10: } from '../../../hooks/lib/skill-advisor-cli-fallback.js';\n11: import { renderAdvisorBrief } from '../../lib/render.js';\n12: \n13: describe('skill advisor CLI fallback envelope', () => {\n14:   // The expected heads are the interactive ones, so a run inside a dispatched\n15:   // child must not turn them into the child form.\n16:   beforeEach(() => {\n17:     vi.stubEnv('AI_SESSION_CHILD', '');\n18:   });\n19: \n20:   afterEach(() => {\n21:     vi.unstubAllEnvs();\n22:   });\n23: \n24:   it('normalizes advisor fallback outcomes to the shared warm-fallback shape', () => {\n25:     const skipped = skillAdvisorCliFallbackEnvelope({ status: 'skipped', reason: 'CLI_SOCKET_ABSENT', exitCode: 75 });\n26:     const failed = skillAdvisorCliFallbackEnvelope({ status: 'fail_open', reason: 'CLI_EXIT_1', exitCode: 1 });\n27:     const ok = skillAdvisorCliFallbackEnvelope({ status: 'ok', exitCode: 0 });\n28: \n29:     expect(skipped).toEqual({\n30:       status: 'skipped',\n31:       reason: 'socket_absent',\n32:       exitCode: 75,\n33:       retryable: true,\n34:     });\n35:     expect(failed).toEqual({\n36:       status: 'fail_open',\n37:       reason: 'exit_1',\n38:       exitCode: 1,\n39:       retryable: false,\n40:     });\n41:     expect(ok).toEqual({\n42:       status: 'ok',\n43:       reason: 'ok',\n44:       exitCode: 0,\n45:       retryable: false,\n46:     });\n47:   });\n48: \n49:   it('renders a CLI row without command fields from the generated table', () => {\n50:     // An older daemon sends no command, policy or owner, so the generated row\n51:     // must supply all three for the head to name the runnable mode.\n52:     const result = resultFromCliData({\n53:       data: {\n54:         freshness: 'live',\n55:         recommendations: [\n56:           { skillId: 'command-speckit-save', confidence: 0.89, uncertainty: 0.12 },\n57:         ],\n58:       },\n59:       options: { maxTokens: 80 } as never,\n60:       startedAt: 0,\n61:       now: () => 1,\n62:     });\n63: \n64:     const rendered = renderAdvisorBrief(result);\n65: \n66:     expect(rendered).not.toBeNull();\n67:     expect(rendered?.split('\\n')[0]).toContain('system-spec-kit → /speckit:save (start)');\n68:   });\n69: \n70:   it('keeps a hub that needs a mode from the CLI row', () => {\n71:     const result = resultFromCliData({\n72:       data: {\n73:         freshness: 'live',\n74:         recommendations: [\n75:           { skillId: 'system-deep-loop', confidence: 0.89, uncertainty: 0.12, needsMode: true },\n76:         ],\n77:       },\n78:       options: { maxTokens: 80 } as never,\n79:       startedAt: 0,\n80:       now: () => 1,\n81:     });\n82: \n83:     const rendered = renderAdvisorBrief(result);\n84: \n85:     expect(rendered).not.toBeNull();\n86:     expect(rendered?.split('\\n')[0]).toContain('use system-deep-loop (needs a mode)');\n87:   });\n88: });","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file .skilled/skills/system-skill-advisor/runtime/tests/hooks/ski