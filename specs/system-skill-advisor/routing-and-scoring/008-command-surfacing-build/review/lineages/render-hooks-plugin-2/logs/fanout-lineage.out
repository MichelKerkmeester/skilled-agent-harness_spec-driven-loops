{ ok: false, code: 'store_unreadable' };\n    }\n  }\n  const storePath = containment.path;\n\n  let raw;\n  try {\n    // The file read is the path the containment check resolved, so a path\n    // swapped after the check is not followed.\n    raw = readFileSync(storePath, 'utf8');\n  } catch {\n    try {\n      statSync(root);\n      return { ok: false, code: 'session_not_found' };\n    } catch {\n      return { ok: false, code: 'store_unreadable' };\n    }\n  }\n\n  const entries = [];\n  for (const line of raw.split('\\n')) {\n    if (!line.trim()) continue;\n    const parsed = parseJsonObject(line);\n    if (parsed) entries.push(parsed);\n  }\n\n  if (recordedSessionId(entries, transcriptPath) !== sessionId) {\n    return { ok: false, code: 'session_mismatch' };\n  }\n\n  return {\n    ok: true,\n    source: {\n      runtime: RUNTIME,\n      sessionId,\n      locatorKind: LOCATOR_KIND,\n      storePath,\n    },\n    records: recordsFromEntries(entries),\n    injected: injectedFromEntries(entries),\n  };\n=== identity resolveInside/guardSessionPath ===\n93:export function resolveInside({ path, root }) {\n94-  if (typeof path !== 'string' || !path.trim()) {\n95-    return { ok: false, code: 'locator_unavailable' };\n96-  }\n97-  if (typeof root !== 'string' || !root.trim()) {\n98-    return { ok: false, code: 'store_unreadable' };\n99-  }\n100-  if (path.split(/[\\\\/]+/).includes('..')) {\n101-    return { ok: false, code: 'session_mismatch' };\n102-  }\n103-\n104-  let realRoot;\n105-  let realPath;\n106-  try {\n107-    realRoot = realpathSync(root);\n108-    realPath = realpathSync(path);\n109-  } catch {\n110-    return { ok: false, code: 'store_unreadable' };\n111-  }\n112-\n113-  if (!inside(realRoot, realPath)) {\n114-    return { ok: false, code: 'session_mismatch' };\n115-  }\n116-  return { ok: true, path: realPath };\n117-}\n118-\n119-// ─────────────────────────────────────────────────────────────────────────────\n120-// 6. FULL GUARD\n121-// ───────