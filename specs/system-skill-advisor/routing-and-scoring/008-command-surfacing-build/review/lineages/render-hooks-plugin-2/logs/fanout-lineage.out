{"type":"tool_use","timestamp":1794570828639,"sessionID":"ses_e2b4a243affexa25EPiSDt2Sxc","part":{"partID":"prt_1d4c1b89e001UZML4jwy9XZ5TX","sessionID":"ses_e2b4a243affexa25EPiSDt2Sxc","messageID":"msg_1d4c1aa36001DKkb93zawkGR6C","type":"tool","id":"chatcmpl-tool-bd0b36028b0c2d8e","tool":"shell","state":{"status":"completed","input":{"command":"cd /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research && sed -n '1,40p' .skilled/skills/system-skill-advisor/hooks/pi/prompt-advisor.ts; echo \"=== pi around 270-320 ===\"; sed -n '270,320p' .skilled/skills/system-skill-advisor/hooks/pi/prompt-advisor.ts; echo \"=== dsh 100-140 ===\"; sed -n '100,140p' .skilled/skills/system-skill-advisor/hooks/dsh/prompt-advisor.mjs"},"output":"// ───────────────────────────────────────────────────────────────────\n// MODULE: Pi Extension - Prompt Advisor\n// ───────────────────────────────────────────────────────────────────\n\n// ───────────────────────────────────────────────────────────────────\n// 1. IMPORTS\n// ───────────────────────────────────────────────────────────────────\n\nimport type { ExtensionAPI } from \"@earendil-works/pi-coding-agent\";\n\n// ───────────────────────────────────────────────────────────────────\n// 2. CONSTANTS\n// ───────────────────────────────────────────────────────────────────\n\nconst RAW_INPUT_STORE_KEY = Symbol.for(\"mk.pi.dispatch.raw-input\");\nconst MAX_CAPTURED_USER_TEXT = 32_768;\nconst MAX_CAPTURED_SESSIONS = 64;\nconst MAX_TRACKED_SESSIONS = 64;\n// The advisor's CLI budget ends first; this margin only catches a call that hangs past it.\nconst PI_ADVISOR_DEADLINE_MARGIN_MS = 300;\n// Mirrors the Claude hook's default budget, which Pi cannot import statically because it loads the hook lazily.\nconst PI_ADVISOR_DEFAULT_BUDGET_MS = 2500;\n\n// ───────────────────────────────────────────────────────────────────\n// 3. HELPERS\n// ───────────────────────────────────────────────────────────────────\n\n// The hook applies the same parse rule; diverging here would let Pi's deadline fire\n// before the hook's own budget expires.\nfunction advisorBudgetMs(): number {\n  const value = process.env.SPECKIT_CLAUDE_HOOK_TIMEOUT_MS;\n  const parsed = Number.parseInt(value ?? \"\", 10);\n  return Number.isFinite(parsed) && parsed > 0 ? parsed : PI_ADVISOR_DEFAULT_BUDGET_MS;\n}\n\ninterface RawInputStore {\n  readonly bySession: Map<string, string>;\n}\n\nfunction captureRawPiUserInput(text: unknown, sessionId: unknown): void {\n=== pi around 270-320 ===\n    try {\n      if (!event.text.trim()) return;\n\n      const advisorModule = await import(ADVISOR_HOOK_MODULE).catch(\n        () => import(ADVISOR_HOOK_FALLBACK_MODULE),\n      );\n      const { handleClaudeUserPromptSubmit, renderAdvisorFallbackDirective, SETUP_WORDING } = advisorModule as {\n        handleClaudeUserPromptSubmit?: (\n          input: {\n            prompt?: string;\n            cwd?: string;\n            hook_event_name?: string;\n          },\n          dependencies?: { runtime?: \"pi\"; writeDiagnostic?: (line: string) => void },\n        ) => Promise<AdvisorEnvelope | Record<string, unknown>>;\n        renderAdvisorFallbackDirective?: (options?: { setupWording?: boolean }) => string;\n        SETUP_WORDING?: RegExp;\n      };\n      if (typeof handleClaudeUserPromptSubmit === \"function\") {\n        let deadlineTimer: ReturnType<typeof setTimeout> | undefined;\n        try {\n          const outcome = await Promise.race([\n            handleClaudeUserPromptSubmit(\n              {\n                prompt: event.text,\n                cwd: ctx.cwd,\n                hook_event_name: \"UserPromptSubmit\",\n              },\n              // The hook runs inside Pi's own process, so its default stderr\n              // diagnostic would draw over Pi's input line. The record is\n              // still persisted to disk by the hook.\n              { runtime: \"pi\", writeDiagnostic: () => {} },\n            ).then((output) => ({ timedOut: false as const, output })),\n            new Promise<{ timedOut: true }>((resolve) => {\n              const budgetMs = advisorBudgetMs();\n              deadlineTimer = setTimeout(\n                () => resolve({ timedOut: true }),\n                budgetMs + PI_ADVISOR_DEADLINE_MARGIN_MS,\n              );\n              deadlineTimer.unref();\n            }),\n          ]);\n          if (outcome.timedOut) {\n            if (typeof renderAdvisorFallbackDirective === \"function\") {\n              context = renderAdvisorFallbackDirective({\n                setupWording: SETUP_WORDING?.test(event.text) === true,\n              });\n            }\n          } else {\n            context = (outcome.output as AdvisorEnvelope).hookSpecificOutput\n              ?.additionalContext;\n=== dsh 100-140 ===\n  return undefined;\n}\n\nasync function makeNotice(text) {\n  const { createUserMessage } = await loadDshLlm();\n  return createUserMessage({\n    content: [{ type: 'text', text }],\n    source: { kind: 'repo-guards' },\n  });\n}\n\n// ─────────────────────────────────────────────────────────────────────────────\n// 4. CORE LOGIC\n// ─────────────────────────────────────────────────────────────────────────────\n\n/**\n * Run the shared advisor hook for one operator prompt under the DSH runtime label.\n *\n * @param {Object} input - The UserPromptSubmit-shaped input.\n * @param {Function} [load] - Loads the advisor module, injectable for tests.\n * @returns {Promise<Object>} The advisor hook output.\n */\nexport async function runAdvisor(input, load = () => import(ADVISOR_MODULE_URL)) {\n  const advisor = await load();\n  return advisor.handleClaudeUserPromptSubmit(input, {\n    runtime: ADVISOR_RUNTIME,\n    writeDiagnostic: () => {},\n  });\n}\n\n/**\n * Register the advisor brief on the DSH pre-step waterfall for interactive sessions.\n *\n * A fan-out leaf, marked by the lineage patch, gets no brief: its prompt is a fixed\n * task, so a route suggestion is noise. The directive block follows the shared\n * directive-lifecycle contract: once per session start or compaction.\n *\n * @param {Object} ctx - dsh plugin context with `on` and `logger`.\n * @param {Object} [options] - Row flag and dependencies for deterministic tests.\n */\nexport function registerPromptAdvisor(ctx, {\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"// ───────────────────────────────────────────────────────────────────\n// MODULE: Pi Extension - Prompt Advisor\n// ───────────────────────────────────────────────────────────────────\n\n// ───────────────────────────────────────────────────────────────────\n// 1. IMPORTS\n// ───────────────────────────────────────────────────────────────────\n\nimport type { ExtensionAPI } from \"@earendil-works/pi-coding-agent\";\n\n// ───────────────────────────────────────────────────────────────────\n// 2. CONSTANTS\n// ───────────────────────────────────────────────────────────────────\n\nconst RAW_INPUT_STORE_KEY = Symbol.for(\"mk.pi.dispatch.raw-input\");\nconst MAX_CAPTURED_USER_TEXT = 32_768;\nconst MAX_CAPTURED_SESSIONS = 64;\nconst MAX_TRACKED_SESSIONS = 64;\n// The advisor's CLI budget ends first; this margin only catches a call that hangs past it.\nconst PI_ADVISOR_DEADLINE_MARGIN_MS = 300;\n// Mirrors the Claude hook's default budget, which Pi cannot import statically because it loads the hook lazily.\nconst PI_ADVISOR_DEFAULT_BUDGET_MS = 2500;\n\n// ───────────────────────────────────────────────────────────────────\n// 3. HELPERS\n// ───────────────────────────────────────────────────────────────────\n\n// The hook applies the same parse rule; diverging here would let Pi's deadline fire\n// before the hook's own budget expires.\nfunction advisorBudgetMs(): number {\n  const value = process.env.SPECKIT_CLAUDE_HOOK_TIMEOUT_MS;\n  const parsed = Number.parseInt(value ?? \"\", 10);\n  return Number.isFinite(parsed) && parsed > 0 ? parsed : PI_ADVISOR_DEFAULT_BUDGET_MS;\n}\n\ninterface RawInputStore {\n  readonly bySession: Map<string, string>;\n}\n\nfunction captureRawPiUserInput(text: unknown, sessionId: unknown): void {\n=== pi around 270-320 ===\n    try {\n      if (!event.text.trim()) return;\n\n      const advisorModule = await import(ADVISOR_HOOK_MODULE).catch(\n        () => import(ADVISOR_HOOK_FALLBACK_MODULE),\n      );\n      const { handleClaudeUserPromptSubmit, renderAdvisorFallbackDirective, SETUP_WORDING } = advisorModule as {\n        handleClaudeUserPromptSubmit?: (\n          input: {\n            prompt?: string;\n            cwd?: string;\n            hook_event_name?: string;\n          },\n          dependencies?: { runtime?: \"pi\"; writeDiagnostic?: (line: string) => void },\n        ) => Promise<AdvisorEnvelope | Record<string, unknown>>;\n        renderAdvisorFallbackDirective?: (options?: { setupWording?: boolean }) => string;\n        SETUP_WORDING?: RegExp;\n      };\n      if (typeof handleClaudeUserPromptSubmit === \"function\") {\n        let deadlineTimer: ReturnType<typeof setTimeout> | undefined;\n        try {\n          const outcome = await Promise.race([\n            handleClaudeUserPromptSubmit(\n              {\n                prompt: event.text,\n                cwd: ctx.cwd,\n                hook_event_name: \"UserPromptSubmit\",\n              },\n              // The hook runs inside Pi's own process, so its default stderr\n              // diagnostic would draw over Pi's input line. The record is\n              // still persisted to disk by the hook.\n              { runtime: \"pi\", writeDiagnostic: () => {} },\n            ).then((output) => ({ timedOut: false as const, output })),\n            new Promise<{ timedOut: true }>((resolve) => {\n              const budgetMs = advisorBudgetMs();\n              deadlineTimer = setTimeout(\n                () => resolve({ timedOut: true }),\n                budgetMs + PI_ADVISOR_DEADLINE_MARGIN_MS,\n              );\n              deadlineTimer.unref();\n            }),\n          ]);\n          if (outcome.timedOut) {\n            if (typeof renderAdvisorFallbackDirective === \"function\") {\n              context = renderAdvisorFallbackDirective({\n                setupWording: SETUP_WORDING?.test(event.text) === true,\n              });\n            }\n          } else {\n            context = (outcome.output as AdvisorEnvelope).hookSpecificOutput\n              ?.additionalContext;\n=== dsh 100-140 ===\n  return undefined;\n}\n\nasync function makeNotice(text) {\n  const { createUserMessage } = await loadDshLlm();\n  return createUserMessage({\n    content: [{ type: 'text', text }],\n    source: { kind: 'repo-guards' },\n  });\n}\n\n// ─────────────────────────────────────────────────────────────────────────────\n// 4. CORE LOGIC\n// ─────────────────────────────────────────────────────────────────────────────\n\n/**\n * Run the shared advisor hook for one operator prompt under the DSH runtime label.\n *\n * @param {Object} input - The UserPromptSubmit-shaped input.\n * @param {Function} [load] - Loads the advisor module, injectable for tests.\n * @returns {Promise<Object>} The advisor hook output.\n */\nexport async function runAdvisor(input, load = () => import(ADVISOR_MODULE_URL)) {\n  const advisor = await load();\n  return advisor.handleClaudeUserPromptSubmit(input, {\n    runtime: ADVISOR_RUNTIME,\n    writeDiagnostic: () => {},\n  });\n}\n\n/**\n * Register the advisor brief on the DSH pre-step waterfall for interactive sessions.\n *\n * A fan-out leaf, marked by the lineage patch, gets no brief: its prompt is a fixed\n * task, so a route suggestion is noise. The directive block follows the shared\n * directive-lifecycle contract: once per session start or compaction.\n *\n * @param {Object} ctx - dsh plugin context with `on` and `logger`.\n * @param {Object} [options] - Row flag and dependencies for deterministic tests.\n */\nexport function registerPromptAdvisor(ctx, {\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\": \"cd /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research && sed -n '1,40p' .skilled/skills/system-skill-advisor/hooks/pi/prompt-advisor.ts; echo \\\"=== pi around 270-320 ===\\\"; sed -n '270,320p' .skilled/skills/system-skill-advisor/hooks/pi/prompt-advisor.ts; echo \\\"=== dsh 100-140 ===\\\"; sed -n '100,140p' .skilled/skills/system-skill-advisor/hooks/dsh/prompt-advisor.mjs\"}"},"time":{"start":1794570827934,"end":1794570828639}}}}
