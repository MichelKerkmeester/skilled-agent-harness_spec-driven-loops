:     // must supply all three for the head to name the runnable mode.\n52:     const result = resultFromCliData({\n53:       data: {\n54:         freshness: 'live',\n55:         recommendations: [\n56:           { skillId: 'command-speckit-save', confidence: 0.89, uncertainty: 0.12 },\n57:         ],\n58:       },\n59:       options: { maxTokens: 80 } as never,\n60:       startedAt: 0,\n61:       now: () => 1,\n62:     });\n63: \n64:     const rendered = renderAdvisorBrief(result);\n65: \n66:     expect(rendered).not.toBeNull();\n67:     expect(rendered?.split('\\n')[0]).toContain('system-spec-kit → /speckit:save (start)');\n68:   });\n69: \n70:   it('keeps a hub that needs a mode from the CLI row', () => {\n71:     const result = resultFromCliData({\n72:       data: {\n73:         freshness: 'live',\n74:         recommendations: [\n75:           { skillId: 'system-deep-loop', confidence: 0.89, uncertainty: 0.12, needsMode: true },\n76:         ],\n77:       },\n78:       options: { maxTokens: 80 } as never,\n79:       startedAt: 0,\n80:       now: () => 1,\n81:     });\n82: \n83:     const rendered = renderAdvisorBrief(result);\n84: \n85:     expect(rendered).not.toBeNull();\n86:     expect(rendered?.split('\\n')[0]).toContain('use system-deep-loop (needs a mode)');\n87:   });\n88: });"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\": \".skilled/skills/system-skill-advisor/runtime/tests/hooks/skill-advisor-cli-fallback-envelope.vitest.ts\"}"},"time":{"start":1794571478176,"end":1794571478439}}}}
