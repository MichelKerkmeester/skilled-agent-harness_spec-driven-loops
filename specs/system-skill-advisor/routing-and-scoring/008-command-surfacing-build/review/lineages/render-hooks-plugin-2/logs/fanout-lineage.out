le mode.\n+  readonly needsMode?: boolean;\n   readonly confidence: number;\n   readonly uncertainty: number;\n   readonly passes_threshold?: boolean;\n@@ -96,6 +101,7 @@ interface SpawnAttemptResult {\n // ───────────────────────────────────────────────────────────────────\n \n const DEFAULT_TIMEOUT_MS = 3000;\n+const MAX_OUTPUT_CHARS = 1024 * 1024;\n const SQLITE_BUSY_PATTERN = /\\bSQLITE_BUSY\\b|database is locked/i;\n \n // ───────────────────────────────────────────────────────────────────\n@@ -135,6 +141,16 @@ function sanitizeStderr(stderr: string): string | null {\n   return compact.slice(0, 240);\n }\n \n+// Only the timeout bounded the child's output before, so a runaway child could\n+// hold the hook's memory until it was killed. Both streams stop growing at the\n+// cap instead.\n+function capOutput(current: string, chunk: string): string {\n+  if (current.length >= MAX_OUTPUT_CHARS) {\n+    return current;\n+  }\n+  return (current + chunk).slice(0, MAX_OUTPUT_CHARS);\n+}\n+\n function coerceCompiledRouteSummary(value: unknown): CompiledRouteSummary | undefined {\n   if (!isRecord(value)) return undefined;\n   if (typeof value.outcome !== 'string' || value.outcome.length === 0) return undefined;\n@@ -231,10 +247,10 @@ function runSpawnAttempt(args: {\n     child.stdout?.setEncoding('utf8');\n     child.stderr?.setEncoding('utf8');\n     child.stdout?.on('data', (chunk: string) => {\n-      stdout += chunk;\n+      stdout = capOutput(stdout, chunk);\n     });\n     child.stderr?.on('data', (chunk: string) => {\n-      stderr += chunk;\n+      stderr = capOutput(stderr, chunk);\n     });\n     child.on('error', (error: NodeJS.ErrnoException) => {\n       if (settled) {\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"diff --git a/.skilled/skills/system-skill-advisor/hooks/claude/user-prompt-submit.ts b/.skilled/skills/system-skill-advisor/hooks/claude/user-prompt-submit.ts\nindex