{"type":"tool_use","timestamp":1794571110511,"sessionID":"ses_e2b4a243affexa25EPiSDt2Sxc","part":{"partID":"prt_1d4c604e5001itHrt916BEhlQ9","sessionID":"ses_e2b4a243affexa25EPiSDt2Sxc","messageID":"msg_1d4c5c75f001EH9rZm81gvFNKh","type":"tool","id":"chatcmpl-tool-9a4383f1412f910a","tool":"shell","state":{"status":"completed","input":{"command":"cd /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research && grep -n \"Object.keys\\|capabilities\" .skilled/skills/system-skill-advisor/runtime/tests/hooks/advisor-runtime-list-parity.vitest.ts | head -12; echo \"=== devin test diff ===\"; git diff 35c3188681..HEAD -- .skilled/hooks/shared/tests/session-readers/devin.test.mjs | head -70; echo \"=== pi test diff ===\"; git diff 35c3188681..HEAD -- .skilled/hooks/shared/tests/session-readers/pi.test.mjs | head -60"},"output":"16:import { capabilities } from '../../../../../hooks/shared/session-readers/index.mjs';\n134:    expect(Object.keys(capabilities).sort()).toEqual([...ADVISOR_RUNTIME_VALUES].sort());\n=== devin test diff ===\ndiff --git a/.skilled/hooks/shared/tests/session-readers/devin.test.mjs b/.skilled/hooks/shared/tests/session-readers/devin.test.mjs\nindex 620db76fd6..b041570138 100644\n--- a/.skilled/hooks/shared/tests/session-readers/devin.test.mjs\n+++ b/.skilled/hooks/shared/tests/session-readers/devin.test.mjs\n@@ -12,6 +12,7 @@ import { join } from 'node:path';\n import { DatabaseSync } from 'node:sqlite';\n import { test } from 'node:test';\n \n+import { loadDevinSession } from '../../session-readers/devin.mjs';\n import { readSession } from '../../session-readers/index.mjs';\n import { DECOY, devinSession, NOW, SESSION } from './fixtures.mjs';\n import { trackFileOpens, withTempAsync, writeJson } from './helpers.mjs';\n@@ -62,6 +63,19 @@ test('a sessions row whose turns are not in the database falls through to its tr\n   });\n });\n \n+test('a damaged sessions database falls back to its transcript', async () => {\n+  await withTempAsync('devin-db-damaged', async (root) => {\n+    const projectDir = join(root, 'project');\n+    mkdirSync(projectDir, { recursive: true });\n+    const fixture = devinSession({ root, projectDir });\n+    writeFileSync(fixture.dbPath, 'not a database');\n+    const result = await readSession({ runtime: 'devin', sessionId: SESSION, ...fixture.options });\n+    assert.equal(result.ok, true);\n+    assert.equal(result.source.locatorKind, 'transcript_file');\n+    assert.equal(result.items[0].content[0].text, 'Read the file.');\n+  });\n+});\n+\n test('a transcript outside the store is refused without reading it', async () => {\n   await withTempAsync('devin-outside', async (root) => {\n     const projectDir = join(root, 'project');\n@@ -100,6 +114,23 @@ test('a compacted session keeps the turns from before the compaction', async ()\n   });\n });\n \n+test('a compacted session reports its continuation prompt as injected context', async () => {\n+  await withTempAsync('devin-injected', async (root) => {\n+    const projectDir = join(root, 'project');\n+    mkdirSync(projectDir, { recursive: true });\n+    const fixture = devinSession({ root, projectDir, compacted: true });\n+    const result = await loadDevinSession({ sessionId: SESSION, ...fixture.options });\n+    assert.equal(result.ok, true);\n+    const continuation = result.injected.find((entry) => entry.source === 'system');\n+    assert.ok(continuation, 'the continuation prompt is missing from injected context');\n+    assert.ok(continuation.text.startsWith('You are continuing work'));\n+    assert.deepEqual(\n+      result.records.map((record) => record.role),\n+      ['user', 'assistant', 'toolResult', 'assistant', 'user'],\n+    );\n+  });\n+});\n+\n test('a session recorded in a folder below the named folder resolves', async () => {\n   await withTempAsync('devin-subfolder', async (root) => {\n     const project = realpathSync(root);\n=== pi test diff ===\ndiff --git a/.skilled/hooks/shared/tests/session-readers/pi.test.mjs b/.skilled/hooks/shared/tests/session-readers/pi.test.mjs\nindex 3863c96376..3e042ec004 100644\n--- a/.skilled/hooks/shared/tests/session-readers/pi.test.mjs\n+++ b/.skilled/hooks/shared/tests/session-readers/pi.test.mjs\n@@ -7,14 +7,18 @@\n // is part of the identity.\n \n import assert from 'node:assert/strict';\n-import { mkdirSync } from 'node:fs';\n+import { appendFileSync, mkdirSync, rmSync, symlinkSync } from 'node:fs';\n import { join } from 'node:path';\n import { test } from 'node:test';\n \n import { capabilities, readSession } from '../../session-readers/index.mjs';\n-import { piProjectDirectory } from '../../session-readers/pi.mjs';\n+import { loadPiSession, piProjectDirectory } from '../../session-readers/pi.mjs';\n import { DECOY, piSession, SESSION, T0 } from './fixtures.mjs';\n-import { withTempAsync } from './helpers.mjs';\n+import { trackFileOpens, withTempAsync, writeJsonl } from './helpers.mjs';\n+\n+// The head of a live advisor brief, used as the text a harness injects into a\n+// session through an entry that is not a turn.\n+const BRIEF = 'Advisor: live; use sk-doc → /create:readme (start) 0.82/0.12 pass.';\n \n // The fixtures build store folders with the reader's own key helper, so this\n // pins the helper to a folder name a real Pi install wrote.\n@@ -108,3 +112,60 @@ test('a missing store is a store_unreadable', async () => {\n     assert.equal(result.code, 'store_unreadable');\n   });\n });\n+\n+test('a custom_message entry is injected context, not a turn', async () => {\n+  await withTempAsync('pi-injected', async (root) => {\n+    const projectDir = join(root, 'project');\n+    mkdirSync(projectDir, { recursive: true });\n+    const fixture = piSession({ root, projectDir });\n+    appendFileSync(\n+      fixture.filePath,\n+      JSON.stringify({\n+        type: 'custom_message',\n+        customType: 'session-start-context',\n+        id: 'pi-context',\n+        content: BRIEF,\n+      }) + '\\n',\n+    );\n+\n+    const result = await loadPiSession({ sessionId: SESSION, ...fixture.options });\n+    assert.equal(result.ok, true);\n+    assert.deepEqual(result.injected, [{ source: 'session-start-context', text: BRIEF }]);\n+    assert.equal(result.records.some((record) => record.id === 'pi-context'), false);\n+  });\n+});\n+\n+test('a session file linked outside the store is refused without opening it', async () => {\n+  await withTempAsync('pi-outside', async (root) => {\n+    const projectDir = join(root, 'project');\n+    mkdirSync(projectDir, { recursive: true });\n+    const fixture = piSession({ root, projectDir });\n+\n+    const outside = join(root, 'outside-pi.jsonl');\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"16:import { capabilities } from '../../../../../hooks/shared/session-readers/index.mjs';\n134:    expect(Object.keys(capabilities).sort()).toEqual([...ADVISOR_RUNTIME_VALUES].sort());\n=== devin test diff ===\ndiff --git a/.skilled/hooks/shared/tests/session-readers/devin.test.mjs b/.skilled/hooks/shared/tests/session-readers/devin.test.mjs\nindex 620db76fd6..b041570138 100644\n--- a/.skilled/hooks/shared/tests/session-readers/devin.test.mjs\n+++ b/.skilled/hooks/shared/tests/session-readers/devin.test.mjs\n@@ -12,6 +12,7 @@ import { join } from 'node:path';\n import { DatabaseSync } from 'node:sqlite';\n import { test } from 'node:test';\n \n+import { loadDevinSession } from '../../session-readers/devin.mjs';\n import { readSession } from '../../session-readers/index.mjs';\n import { DECOY, devinSession, NOW, SESSION } from './fixtures.mjs';\n import { trackFileOpens, withTempAsync, writeJson } from './helpers.mjs';\n@@ -62,6 +63,19 @@ test('a sessions row whose turns are not in the database falls through to its tr\n   });\n });\n \n+test('a damaged sessions database falls back to its transcript', async () => {\n+  await withTempAsync('devin-db-damaged', async (root) => {\n+    const projectDir = join(root, 'project');\n+    mkdirSync(projectDir, { recursive: true });\n+    const fixture = devinSession({ root, projectDir });\n+    writeFileSync(fixture.dbPath, 'not a database');\n+    const result = await readSession({ runtime: 'devin', sessionId: SESSION, ...fixture.options });\n+    assert.equal(result.ok, true);\n+    assert.equal(result.source.locatorKind, 'transcript_file');\n+    assert.equal(result.items[0].content[0].text, 'Read the file.');\n+  });\n+});\n+\n test('a transcript outside the store is refused without reading it', async () => {\n   await withTempAsync('devin-outside', async (root) => {\n     const projectDir = join(root, 'project');\n@@ -100,6 +114,23 @@ test('a compacted session keeps the turns from before the compaction', async ()\n   });\n });\n \n+test('a compacted session reports its continuation prompt as injected context', async () => {\n+  await withTempAsync('devin-injected', async (root) => {\n+    const projectDir = join(root, 'project');\n+    mkdirSync(projectDir, { recursive: true });\n+    const fixture = devinSession({ root, projectDir, compacted: true });\n+    const result = await loadDevinSession({ sessionId: SESSION, ...fixture.options });\n+    assert.equal(result.ok, true);\n+    const continuation = result.injected.find((entry) => entry.source === 'system');\n+    assert.ok(continuation, 'the continuation prompt is missing from injected context');\n+    assert.ok(continuation.text.startsWith('You are continuing work'));\n+    assert.deepEqual(\n+      result.records.map((record) => record.role),\n+      ['user', 'assistant', 'toolResult', 'assistant', 'user'],\n+    );\n+  });\n+});\n+\n test('a session recorded in a folder below the named folder resolves', async () => {\n   await withTempAsync('devin-subfolder', async (root) => {\n     const project = realpathSync(root);\n=== pi test diff ===\ndiff --git a/.skilled/hooks/shared/tests/session-readers/pi.test.mjs b/.skilled/hooks/shared/tests/session-readers/pi.test.mjs\nindex 3863c96376..3e042ec004 100644\n--- a/.skilled/hooks/shared/tests/session-readers/pi.test.mjs\n+++ b/.skilled/hooks/shared/tests/session-readers/pi.test.mjs\n@@ -7,14 +7,18 @@\n // is part of the identity.\n \n import assert from 'node:assert/strict';\n-import { mkdirSync } from 'node:fs';\n+import { appendFileSync, mkdirSync, rmSync, symlinkSync } from 'node:fs';\n import { join } from 'node:path';\n import { test } from 'node:test';\n \n import { capabilities, readSession } from '../../session-readers/index.mjs';\n-import { piProjectDirectory } from '../../session-readers/pi.mjs';\n+import { loadPiSession, piProjectDirectory } from '../../session-readers/pi.mjs';\n import { DECOY, piSession, SESSION, T0 } from './fixtures.mjs';\n-import { withTempAsync } from './helpers.mjs';\n+import { trackFileOpens, withTempAsync, writeJsonl } from './helpers.mjs';\n+\n+// The head of a live advisor brief, used as the text a harness injects into a\n+// session through an entry that is not a turn.\n+const BRIEF = 'Advisor: live; use sk-doc → /create:readme (start) 0.82/0.12 pass.';\n \n // The fixtures build store folders with the reader's own key helper, so this\n // pins the helper to a folder name a real Pi install wrote.\n@@ -108,3 +112,60 @@ test('a missing store is a store_unreadable', async () => {\n     assert.equal(result.code, 'store_unreadable');\n   });\n });\n+\n+test('a custom_message entry is injected context, not a turn', async () => {\n+  await withTempAsync('pi-injected', async (root) => {\n+    const projectDir = join(root, 'project');\n+    mkdirSync(projectDir, { recursive: true });\n+    const fixture = piSession({ root, projectDir });\n+    appendFileSync(\n+      fixture.filePath,\n+      JSON.stringify({\n+        type: 'custom_message',\n+        customType: 'session-start-context',\n+        id: 'pi-context',\n+        content: BRIEF,\n+      }) + '\\n',\n+    );\n+\n+    const result = await loadPiSession({ sessionId: SESSION, ...fixture.options });\n+    assert.equal(result.ok, true);\n+    assert.deepEqual(result.injected, [{ source: 'session-start-context', text: BRIEF }]);\n+    assert.equal(result.records.some((record) => record.id === 'pi-context'), false);\n+  });\n+});\n+\n+test('a session file linked outside the store is refused without opening it', async () => {\n+  await withTempAsync('pi-outside', async (root) => {\n+    const projectDir = join(root, 'project');\n+    mkdirSync(projectDir, { recursive: true });\n+    const fixture = piSession({ root, projectDir });\n+\n+    const outside = join(root, 'outside-pi.jsonl');\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\": \"cd /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research && grep -n \\\"Object.keys\\\\|capabilities\\\" .skilled/skills/system-skill-advisor/runtime/tests/hooks/advisor-runtime-list-parity.vitest.ts | head -12; echo \\\"=== devin test diff ===\\\"; git diff 35c3188681..HEAD -- .skilled/hooks/shared/tests/session-readers/devin.test.mjs | head -70; echo \\\"=== pi test diff ===\\\"; git diff 35c3188681..HEAD -- .skilled/hooks/shared/tests/session-readers/pi.test.mjs | head -60\"}"},"time":{"start":1794571109605,"end":1794571110511}}}}
