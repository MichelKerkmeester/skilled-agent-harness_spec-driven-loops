ter((value) => typeof value === 'string') }\n           : {}),\n+        // The renderer prints a command, its policy and its owner only from these\n+        // fields. A skill row such as sk-doc has no generated command row to refill\n+        // them, so a dropped field hides the command the advisor attached.\n+        ...(typeof recommendation.command === 'string' && recommendation.command.trim() !== '' ? { command: recommendation.command } : {}),\n+        ...(recommendation.policy === 'run' || recommendation.policy === 'start' || recommendation.policy === 'ask' ? { policy: recommendation.policy } : {}),\n+        ...(typeof recommendation.ownerSkillId === 'string' && recommendation.ownerSkillId.trim() !== '' ? { ownerSkillId: recommendation.ownerSkillId } : {}),\n+        ...(recommendation.needsMode === true ? { needsMode: true } : {}),\n       };\n     });\n }\n@@ -1576,24 +1582,9 @@ async function MkSkillAdvisorPlugin(ctx, rawOptions) {\n       if (advisorDecision.shouldDeliver) {\n         await observeBlock(deliveredAdvisorBlock);\n       }\n-      const compiledLine = renderCompiledRouteSummaryLine(response.metadata?.compiledRouteSummary, {\n-        bounded: options.boundedCompiledRouteSummary,\n-      });\n-      if (compiledLine) {\n-        const compiledDecision = transformContributionDecision(\n-          input,\n-          options,\n-          messageIdentity.POLICY_BLOCK_IDS.RUNTIME_OPENCODE_COMPILED_ROUTE,\n-          compiledLine,\n-          8,\n-        );\n-        deliverTransformContribution(compiledDecision, () => {\n-          output.system.push(compiledLine);\n-        });\n-        if (compiledDecision.shouldDeliver) {\n-          await observeBlock(compiledLine);\n-        }\n-      }\n+      // The head entry already names the hub, its command and its policy. The\n+      // route summary keeps string targets only while the routes carry objects,\n+      // so a second entry repeated the head with `targets=none`.\n     } catch {\n       state.lastBridgeStatus = 'fail_open';\n       state.lastErrorCode = 'UNEXPECTED_HOOK_ERROR';\ndiff --git a/.opencode/plugins/tests/system-skill-advisor.test.cjs b/.opencode/plugins/tests/system-skill-advisor.test.cjs\nindex 490a95bcbb..de5d05d19b 100644\n--- a/.opencode/plugins/tests/system-skill-advisor.test.cjs\n+++ b/.opencode/plugins/tests/system-skill-advisor.test.cjs\n@@ -411,12 +411,11 @@ test('flag-off route rendering and plugin delivery remain byte-identical to the\n   });\n   const output = await runPrompt(hooks);\n \n-  assert.equal(output.system[1], baseline);\n+  assert.equal(output.system.length, 1);\n   assert.match(await status(hooks), /bounded_compiled_route_summary=false/);\n });\n \n-test('bounded flag selects the bounded line in the OpenCode transform', async () => {\n-  const renderHelpers = await loadRenderHelpers();\n+test('bounding leaves the OpenCode transform with the head entry alone', async () => {\n   const summary = compiledRouteSummary(['quality', 'review', 'opencode', 'skilled', 'typescript']);\n   const child = fakeChild({\n     stdout: cliEnvelope({\n@@ -432,11 +431,7 @@ test('bounded flag selects the bounded line in the OpenCode transform', async ()\n   });\n   const output = await runPrompt(hooks);\n \n-  assert.equal(\n-    output.system[1],\n-    renderHelpers.renderCompiledRouteSummaryLine(summary, { bounded: true }),\n-  );\n-  assert.match(output.system[1], /\\+2 more/);\n+  assert.equal(output.system.length, 1);\n });\n \n test('target digest is stable for the same membership and changes for a changed omitted set', async () => {\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"=== holdout refs in area ===\n.skilled/skills/system-skill-advisor/hooks/skill-advisor-hook-validation.md:94:- Corpus/holdout/parity/safety/latency slices still render (existing contract preserved).\n=== plugin diff ===\ndiff --git a/.opencode/plugins/system-skill-advisor.js 