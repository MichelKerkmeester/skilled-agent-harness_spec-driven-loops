{"type":"tool_use","timestamp":1794571089779,"sessionID":"ses_e2b4a243affexa25EPiSDt2Sxc","part":{"partID":"prt_1d4c5af12001dUktPJFWna88iV","sessionID":"ses_e2b4a243affexa25EPiSDt2Sxc","messageID":"msg_1d4c56225001kXussamHLNeuLQ","type":"tool","id":"chatcmpl-tool-a07de72340d739ae","tool":"shell","state":{"status":"completed","input":{"command":"cd /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research && sed -n '200,265p' .skilled/hooks/shared/session-readers/pi.mjs; echo \"=== dsh test diff ===\"; git diff 35c3188681..HEAD -- .skilled/hooks/shared/tests/session-readers/dsh.test.mjs | head -80; echo \"=== reader README diff ===\"; git diff 35c3188681..HEAD -- .skilled/hooks/shared/session-readers/README.md"},"output":"\nfunction diskResult({ sessionId, projectDir, options }) {\n  if (typeof projectDir !== 'string' || !projectDir.trim()) {\n    return { ok: false, code: 'locator_unavailable' };\n  }\n\n  const root = piStoreRoot(options);\n  const directory = join(root, piProjectDirectory(projectDir));\n\n  let names;\n  try {\n    names = readdirSync(directory);\n  } catch {\n    // A missing root means the store itself cannot be read; a known root with\n    // no project directory means this project simply has no saved session.\n    try {\n      statSync(root);\n      return { ok: false, code: 'session_not_found' };\n    } catch {\n      return { ok: false, code: 'store_unreadable' };\n    }\n  }\n\n  const candidates = names.filter(\n    (name) => name.endsWith(TRANSCRIPT_EXT) && idFromFileName(name) === sessionId,\n  );\n  if (candidates.length === 0) return { ok: false, code: 'session_not_found' };\n  // Two files that decode to one id are two possible sessions, and neither the\n  // name nor the header can choose between them, so a recovery read refuses\n  // rather than guessing.\n  if (candidates.length > 1) return { ok: false, code: 'session_ambiguous' };\n\n  const filePath = join(directory, candidates[0]);\n  const contained = resolveInside({ path: filePath, root });\n  if (!contained.ok) return contained;\n\n  let header;\n  try {\n    // The header is read from the path the containment check resolved, so a\n    // link out of the store is refused before any byte of it is read.\n    header = headerOf(contained.path);\n  } catch {\n    return { ok: false, code: 'store_unreadable' };\n  }\n\n  if (header?.type !== 'session' || header.id !== sessionId) {\n    return { ok: false, code: 'session_mismatch' };\n  }\n  if (!samePath(header.cwd, projectDir)) {\n    return { ok: false, code: 'session_mismatch' };\n  }\n\n  const guard = guardSessionPath({\n    path: contained.path,\n    root,\n    sessionId,\n    recordedId: header.id,\n  });\n  if (!guard.ok) return guard;\n\n  let raw;\n  try {\n    // The file read is the path the containment check resolved, so a path\n    // swapped after the check is not followed.\n    raw = readFileSync(guard.path, 'utf8');\n  } catch {\n=== dsh test diff ===\ndiff --git a/.skilled/hooks/shared/tests/session-readers/dsh.test.mjs b/.skilled/hooks/shared/tests/session-readers/dsh.test.mjs\nindex ec6ede5ab2..05d5eefcb9 100644\n--- a/.skilled/hooks/shared/tests/session-readers/dsh.test.mjs\n+++ b/.skilled/hooks/shared/tests/session-readers/dsh.test.mjs\n@@ -6,16 +6,18 @@\n // is checked before any event is trusted. Logs may be compressed frame chains.\n \n import assert from 'node:assert/strict';\n-import { mkdirSync, writeFileSync } from 'node:fs';\n+import { appendFileSync, mkdirSync, writeFileSync } from 'node:fs';\n import { join } from 'node:path';\n import { test } from 'node:test';\n import { zstdCompressSync } from 'node:zlib';\n \n import { readSession } from '../../session-readers/index.mjs';\n-import { dshProjectKey } from '../../session-readers/dsh.mjs';\n+import { dshProjectKey, loadDshSession } from '../../session-readers/dsh.mjs';\n import { DECOY, dshSession, NOW, SESSION } from './fixtures.mjs';\n import { trackFileOpens, withTempAsync, writeJsonl } from './helpers.mjs';\n \n+const BRIEF = 'Advisor: live; use sk-doc → /create:readme (start) 0.82/0.12 pass.';\n+\n // The fixtures build store folders with the reader's own key helper, so this\n // pins the helper to a folder name a real DSH install wrote.\n test('the project key matches the folder name DSH writes', () => {\n@@ -38,6 +40,56 @@ test('a session log resolves by header id and matching cwd', async () => {\n   });\n });\n \n+test('an injected notice is returned apart from the records', async () => {\n+  await withTempAsync('dsh-injected', async (root) => {\n+    const projectDir = join(root, 'project');\n+    mkdirSync(projectDir, { recursive: true });\n+    const fixture = dshSession({ root, projectDir });\n+    appendFileSync(fixture.filePath, `${JSON.stringify({\n+      type: 'user/message',\n+      seq: 5,\n+      data: {\n+        role: 'user',\n+        id: 'dsh-injected-1',\n+        source: { kind: 'repo-guards' },\n+        content: [{ type: 'text', text: BRIEF }],\n+      },\n+    })}\\n`);\n+\n+    const result = await loadDshSession({ sessionId: SESSION, ...fixture.options });\n+    assert.equal(result.ok, true);\n+    assert.deepEqual(result.injected, [{ source: 'repo-guards', text: BRIEF }]);\n+  });\n+});\n+\n+// A message that names no source cannot be proven operator-written, so the\n+// reader fails closed: the text is kept as an injected notice and never becomes\n+// a record the session history reports as the operator's.\n+test('an event with no source is injected as unknown', async () => {\n+  await withTempAsync('dsh-unsourced', async (root) => {\n+    const projectDir = join(root, 'project');\n+    mkdirSync(projectDir, { recursive: true });\n+    const fixture = dshSession({ root, projectDir });\n+    appendFileSync(fixture.filePath, `${JSON.stringify({\n+      type: 'user/message',\n+      seq: 5,\n+      data: {\n+        role: 'user',\n+        id: 'dsh-unsourced-1',\n+        content: [{ type: 'text', text: 'notice' }],\n+      },\n+    })}\\n`);\n+\n+    const result = await loadDshSession({ sessionId: SESSION, ...fixture.options });\n+    assert.equal(result.ok, true);\n+    assert.deepEqual(result.injected, [{ source: 'unknown', text: 'notice' }]);\n+    assert.equal(\n+      result.records.some((record) => record.content.some((block) => block.text === 'notice')),\n+      false,\n+    );\n+  });\n+});\n+\n test('a session path outside the store is refused without reading it', async () => {\n=== reader README diff ===\ndiff --git a/.skilled/hooks/shared/session-readers/README.md b/.skilled/hooks/shared/session-readers/README.md\nindex d039a3b5fa..4d0640c9a8 100644\n--- a/.skilled/hooks/shared/session-readers/README.md\n+++ b/.skilled/hooks/shared/session-readers/README.md\n@@ -25,9 +25,17 @@ The six decision-capture sweeps keep their own inline readers and remain the wri\n \n - **Exact id only.** A caller names a runtime and one session id. No reader guesses the newest session or lists a store.\n - **Read-only.** Files are read and SQLite stores are opened with read-only flags. The side-effect suite checks that no read changes a store's bytes or modification time.\n+- **Contained open.** A reader resolves its store path against the runtime's root before opening it, and opens the path its containment check resolved, so a path swapped after the check is not followed.\n - **One envelope.** `readSession` returns `{ ok: true, source, items }` or `{ ok: false, code }`. It never throws across the boundary and never returns a partial list.\n - **Capability is the caller's gate.** `index.mjs` exports `capabilities`, one row per runtime with its `status`, locator kind and store root, plus a `reason` when the runtime is gated. The dispatcher does not consult it. The compaction hooks and the lookup CLI check that a runtime is `ready` before they offer or read history.\n \n+`loadSession` returns the raw neutral records. Claude, Pi, Devin and DSH also return `injected`, a list of `{ source, text }` for context a hook or harness put into the session, which `records` never carries. `loadSession` passes `injected` through and `readSession` ignores it, so only a caller on the raw path sees what the harness added.\n+\n+- Claude's `injected` source is `hook_additional_context`, one entry per hook context attachment.\n+- Pi's `injected` source is the entry's custom type, such as `session-start-context`, or `custom_message` when it carries none.\n+- Devin's `injected` source is `system` for a harness node and `unflagged-user` for a user node the harness wrote. The transcript fallback uses the step's own source.\n+- DSH's `injected` source is the event's source kind, such as `repo-guards`, or `unknown` when it names none. A `user/message` with no source stays injected and never becomes a record.\n+\n Failure codes:\n \n | Code | Meaning |\n@@ -37,7 +45,7 @@ Failure codes:\n | `session_not_found` | No store record matches the id |\n | `session_mismatch` | A record was found, but its recorded id or path does not match |\n | `session_ambiguous` | More than one record claims the id |\n-| `store_unreadable` | The store could not be read or projected |\n+| `store_unreadable` | The store could not be read or projected. For Devin, an open or projection failure falls back to the transcript first, so the code means the transcript failed too |\n \n ---\n \n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"\nfunction diskResult({ sessionId, projectDir, options }) {\n  if (typeof projectDir !== 'string' || !projectDir.trim()) {\n    return { ok: false, code: 'locator_unavailable' };\n  }\n\n  const root = piStoreRoot(options);\n  const directory = join(root, piProjectDirectory(projectDir));\n\n  let names;\n  try {\n    names = readdirSync(directory);\n  } catch {\n    // A missing root means the store itself cannot be read; a known root with\n    // no project directory means this project simply has no saved session.\n    try {\n      statSync(root);\n      return { ok: false, code: 'session_not_found' };\n    } catch {\n      return { ok: false, code: 'store_unreadable' };\n    }\n  }\n\n  const candidates = names.filter(\n    (name) => name.endsWith(TRANSCRIPT_EXT) && idFromFileName(name) === sessionId,\n  );\n  if (candidates.length === 0) return { ok: false, code: 'session_not_found' };\n  // Two files that decode to one id are two possible sessions, and neither the\n  // name nor the header can choose between them, so a recovery read refuses\n  // rather than guessing.\n  if (candidates.length > 1) return { ok: false, code: 'session_ambiguous' };\n\n  const filePath = join(directory, candidates[0]);\n  const contained = resolveInside({ path: filePath, root });\n  if (!contained.ok) return contained;\n\n  let header;\n  try {\n    // The header is read from the path the containment check resolved, so a\n    // link out of the store is refused before any byte of it is read.\n    header = headerOf(contained.path);\n  } catch {\n    return { ok: false, code: 'store_unreadable' };\n  }\n\n  if (header?.type !== 'session' || header.id !== sessionId) {\n    return { ok: false, code: 'session_mismatch' };\n  }\n  if (!samePath(header.cwd, projectDir)) {\n    return { ok: false, code: 'session_mismatch' };\n  }\n\n  const guard = guardSessionPath({\n    path: contained.path,\n    root,\n    sessionId,\n    recordedId: header.id,\n  });\n  if (!guard.ok) return guard;\n\n  let raw;\n  try {\n    // The file read is the path the containment check resolved, so a path\n    // swapped after the check is not followed.\n    raw = readFileSync(guard.path, 'utf8');\n  } catch {\n=== dsh test diff ===\ndiff --git a/.skilled/hooks/shared/tests/session-readers/dsh.test.mjs b/.skilled/hooks/shared/tests/session-readers/dsh.test.mjs\nindex ec6ede5ab2..05d5eefcb9 100644\n--- a/.skilled/hooks/shared/tests/session-readers/dsh.test.mjs\n+++ b/.skilled/hooks/shared/tests/session-readers/dsh.test.mjs\n@@ -6,16 +6,18 @@\n // is checked before any event is trusted. Logs may be compressed frame chains.\n \n import assert from 'node:assert/strict';\n-import { mkdirSync, writeFileSync } from 'node:fs';\n+import { appendFileSync, mkdirSync, writeFileSync } from 'node:fs';\n import { join } from 'node:path';\n import { test } from 'node:test';\n import { zstdCompressSync } from 'node:zlib';\n \n import { readSession } from '../../session-readers/index.mjs';\n-import { dshProjectKey } from '../../session-readers/dsh.mjs';\n+import { dshProjectKey, loadDshSession } from '../../session-readers/dsh.mjs';\n import { DECOY, dshSession, NOW, SESSION } from './fixtures.mjs';\n import { trackFileOpens, withTempAsync, writeJsonl } from './helpers.mjs';\n \n+const BRIEF = 'Advisor: live; use sk-doc → /create:readme (start) 0.82/0.12 pass.';\n+\n // The fixtures build store folders with the reader's own key helper, so this\n // pins the helper to a folder name a real DSH install wrote.\n test('the project key matches the folder name DSH writes', () => {\n@@ -38,6 +40,56 @@ test('a session log resolves by header id and matching cwd', async () => {\n   });\n });\n \n+test('an injected notice is returned apart from the records', async () => {\n+  await withTempAsync('dsh-injected', async (root) => {\n+    const projectDir = join(root, 'project');\n+    mkdirSync(projectDir, { recursive: true });\n+    const fixture = dshSession({ root, projectDir });\n+    appendFileSync(fixture.filePath, `${JSON.stringify({\n+      type: 'user/message',\n+      seq: 5,\n+      data: {\n+        role: 'user',\n+        id: 'dsh-injected-1',\n+        source: { kind: 'repo-guards' },\n+        content: [{ type: 'text', text: BRIEF }],\n+      },\n+    })}\\n`);\n+\n+    const result = await loadDshSession({ sessionId: SESSION, ...fixture.options });\n+    assert.equal(result.ok, true);\n+    assert.deepEqual(result.injected, [{ source: 'repo-guards', text: BRIEF }]);\n+  });\n+});\n+\n+// A message that names no source cannot be proven operator-written, so the\n+// reader fails closed: the text is kept as an injected notice and never becomes\n+// a record the session history reports as the operator's.\n+test('an event with no source is injected as unknown', async () => {\n+  await withTempAsync('dsh-unsourced', async (root) => {\n+    const projectDir = join(root, 'project');\n+    mkdirSync(projectDir, { recursive: true });\n+    const fixture = dshSession({ root, projectDir });\n+    appendFileSync(fixture.filePath, `${JSON.stringify({\n+      type: 'user/message',\n+      seq: 5,\n+      data: {\n+        role: 'user',\n+        id: 'dsh-unsourced-1',\n+        content: [{ type: 'text', text: 'notice' }],\n+      },\n+    })}\\n`);\n+\n+    const result = await loadDshSession({ sessionId: SESSION, ...fixture.options });\n+    assert.equal(result.ok, true);\n+    assert.deepEqual(result.injected, [{ source: 'unknown', text: 'notice' }]);\n+    assert.equal(\n+      result.records.some((record) => record.content.some((block) => block.text === 'notice')),\n+      false,\n+    );\n+  });\n+});\n+\n test('a session path outside the store is refused without reading it', async () => {\n=== reader README diff ===\ndiff --git a/.skilled/hooks/shared/session-readers/README.md b/.skilled/hooks/shared/session-readers/README.md\nindex d039a3b5fa..4d0640c9a8 100644\n--- a/.skilled/hooks/shared/session-readers/README.md\n+++ b/.skilled/hooks/shared/session-readers/README.md\n@@ -25,9 +25,17 @@ The six decision-capture sweeps keep their own inline readers and remain the wri\n \n - **Exact id only.** A caller names a runtime and one session id. No reader guesses the newest session or lists a store.\n - **Read-only.** Files are read and SQLite stores are opened with read-only flags. The side-effect suite checks that no read changes a store's bytes or modification time.\n+- **Contained open.** A reader resolves its store path against the runtime's root before opening it, and opens the path its containment check resolved, so a path swapped after the check is not followed.\n - **One envelope.** `readSession` returns `{ ok: true, source, items }` or `{ ok: false, code }`. It never throws across the boundary and never returns a partial list.\n - **Capability is the caller's gate.** `index.mjs` exports `capabilities`, one row per runtime with its `status`, locator kind and store root, plus a `reason` when the runtime is gated. The dispatcher does not consult it. The compaction hooks and the lookup CLI check that a runtime is `ready` before they offer or read history.\n \n+`loadSession` returns the raw neutral records. Claude, Pi, Devin and DSH also return `injected`, a list of `{ source, text }` for context a hook or harness put into the session, which `records` never carries. `loadSession` passes `injected` through and `readSession` ignores it, so only a caller on the raw path sees what the harness added.\n+\n+- Claude's `injected` source is `hook_additional_context`, one entry per hook context attachment.\n+- Pi's `injected` source is the entry's custom type, such as `session-start-context`, or `custom_message` when it carries none.\n+- Devin's `injected` source is `system` for a harness node and `unflagged-user` for a user node the harness wrote. The transcript fallback uses the step's own source.\n+- DSH's `injected` source is the event's source kind, such as `repo-guards`, or `unknown` when it names none. A `user/message` with no source stays injected and never becomes a record.\n+\n Failure codes:\n \n | Code | Meaning |\n@@ -37,7 +45,7 @@ Failure codes:\n | `session_not_found` | No store record matches the id |\n | `session_mismatch` | A record was found, but its recorded id or path does not match |\n | `session_ambiguous` | More than one record claims the id |\n-| `store_unreadable` | The store could not be read or projected |\n+| `store_unreadable` | The store could not be read or projected. For Devin, an open or projection failure falls back to the transcript first, so the code means the transcript failed too |\n \n ---\n \n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\": \"cd /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research && sed -n '200,265p' .skilled/hooks/shared/session-readers/pi.mjs; echo \\\"=== dsh test diff ===\\\"; git diff 35c3188681..HEAD -- .skilled/hooks/shared/tests/session-readers/dsh.test.mjs | head -80; echo \\\"=== reader README diff ===\\\"; git diff 35c3188681..HEAD -- .skilled/hooks/shared/session-readers/README.md\"}"},"time":{"start":1794571087634,"end":1794571089779}}}}
