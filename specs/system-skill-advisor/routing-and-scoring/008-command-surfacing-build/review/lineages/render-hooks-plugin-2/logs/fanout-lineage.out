th, ...options\n \n   let events;\n   try {\n-    events = parseEvents(decodeSessionLog(readFileSync(logPath), logPath));\n+    // The file read is the path the containment check resolved, so a path\n+    // swapped after the check is not followed. The decoder still takes the\n+    // locator name, because it picks the format from the extension.\n+    events = parseEvents(decodeSessionLog(readFileSync(storePath), logPath));\n   } catch {\n     return { ok: false, code: 'store_unreadable' };\n   }\n@@ -311,5 +331,6 @@ export function loadDshSession({ sessionId, projectDir, sessionPath, ...options\n       storePath,\n     },\n     records: recordsFromEvents(events),\n+    injected: injectedFromEvents(events),\n   };\n }\ndiff --git a/.skilled/hooks/shared/session-readers/index.mjs b/.skilled/hooks/shared/session-readers/index.mjs\nindex 2c792b384e..ac4e0fbdde 100644\n--- a/.skilled/hooks/shared/session-readers/index.mjs\n+++ b/.skilled/hooks/shared/session-readers/index.mjs\n@@ -135,7 +135,12 @@ export async function loadSession(input) {\n   try {\n     const loaded = await load(options);\n     if (!loaded.ok) return loaded;\n-    return { ok: true, source: loaded.source, records: loaded.records };\n+    return {\n+      ok: true,\n+      source: loaded.source,\n+      records: loaded.records,\n+      ...(Array.isArray(loaded.injected) ? { injected: loaded.injected } : {}),\n+    };\n   } catch {\n     return failure('store_unreadable');\n   }\ndiff --git a/.skilled/hooks/shared/session-readers/pi.mjs b/.skilled/hooks/shared/session-readers/pi.mjs\nindex acd7bdaa4a..fa730bb8db 100644\n--- a/.skilled/hooks/shared/session-readers/pi.mjs\n+++ b/.skilled/hooks/shared/session-readers/pi.mjs\n@@ -17,6 +17,7 @@ import {\n   guardSessionPath,\n   homeDir,\n   isSafeSessionId,\n+  resolveInside,\n   samePath,\n } from './identity.mjs';\n import {\n@@ -159,6 +160,20 @@ function recordsFromLines(lines) {\n   return records;\n }\n \n+// A `custom_message` is context a hook or harness put into the session rather\n+// than a turn the operator wrote, so it stays out of `records` and travels as\n+// its own list. The custom type names the producer when the entry carries one.\n+function injectedFromLines(lines) {\n+  const injected = [];\n+  for (const line of lines) {\n+    if (line?.type !== 'custom_message') continue;\n+    const text = contentText(line.content);\n+    if (!text) continue;\n+    injected.push({ source: line.customType ?? 'custom_message', text });\n+  }\n+  return injected;\n+}\n+\n // ─────────────────────────────────────────────────────────────────────────────\n // 5. LOADER\n // ─────────────────────────────────────────────────────────────────────────────\n@@ -179,6 +194,7 @@ function liveResult({ sessionId, sessionManager, options }) {\n         : piStoreRoot(options),\n     },\n     records: recordsFromLines(entries),\n+    injected: injectedFromLines(entries),\n   };\n }\n \n@@ -214,9 +230,14 @@ function diskResult({ sessionId, projectDir, options }) {\n   if (candidates.length > 1) return { ok: false, code: 'session_ambiguous' };\n \n   const filePath = join(directory, candidates[0]);\n+  const contained = resolveInside({ path: filePath, root });\n+  if (!contained.ok) return contained;\n+\n   let header;\n   try {\n-    header = headerOf(filePath);\n+    // The header is read from the path the containment check resolved, so a\n+    // link out of the store is refused before any byte of it is read.\n+    header = headerOf(contained.path);\n   } catch {\n     return { ok: false, code: 'store_unreadable' };\n   }\n@@ -229,7 +250,7 @@ function diskResult({ sessionId, projectDir, options }) {\n   }\n \n   const guard = guardSessionPath({\n-    path: filePath,\n+    path: contained.path,\n     root,\n     sessionId,\n     recordedId: header.id,\n@@ -238,7 +259,9 @@ function diskResult({ sessionId, projectDir, options }) {\n \n   let raw;\n   try {\n-    raw = readFileSync(filePath, 'utf8');\n+    // The file read is the path the containment check resolved, so a path\n+    // swapped after the check is not followed.\n+    raw = readFileSync(guard.path, 'utf8');\n   } catch {\n     return { ok: false, code: 'store_unreadable' };\n   }\n@@ -260,6 +283,7 @@ function diskResult({ sessionId, projectDir, options }) {\n       storePath: guard.path,\n     },\n     records: recordsFromLines(lines),\n+    injected: injectedFromLines(lines),\n   };\n }\n \n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\": \"cd /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research && git diff 35c3188681..HEAD -- .skilled/hooks/shared/session-readers/index.mjs .skilled/hooks/shared/session-readers/claude.mjs .skilled/hooks/shared/session-readers/devin.mjs .skilled/hooks/shared/session-readers/dsh.mjs .skilled/hooks/shared/session-readers/pi.mjs\"}"},"time":{"start":1794570964001,"end":1794570964374}}}}
