= typeof rendered === 'string' && rendered.trim() ? rendered : null;\n  const routeSummary = compiledRouteSummary(data);\n\n  return {\n    brief,\n    status: brief ? 'ok' : 'skipped',\n    metadata: {\n      route: parsed.degraded === true ? 'cli-local-scorer' : 'cli',\n      freshness,\n      recommendationCount: recommendations.length,\n      tokenCap,\n      skillLabel: top?.skill ?? null,\n      cacheHit: Boolean(data.cache?.hit),\n      ...(routeSummary ? { compiledRouteSummary: routeSummary } : {}),\n    },\n  };\n}\n\n// ─────────────────────────────────────────────────────────────────────────────\n// 4. SIZE-CAP HELPERS\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":".opencode/plugins/lib/skill-advisor-render.js:107:export function compiledRouteSummaryTargetDigest(summary) {\n.skilled/skills/system-skill-advisor/runtime/dist/runtime/lib/subprocess.js:99:        const compiledRouteSummary = coerceCompiledRouteSummary(item.compiledRouteSummary);\n.skilled/skills/system-skill-advisor/runtime/dist/runtime/lib/subprocess.js:107:            ...(compiledRouteSummary ? { compiledRouteSummary } : {}),\n.skilled/skills/system-skill-advisor/runtime/lib/subprocess.ts:55:  readonly compiledRouteSummary?: CompiledRouteSummary;\n.skilled/skills/system-skill-advisor/runtime/lib/subprocess.ts:193:    const compiledRouteSummary = coerceCompiledRouteSummary(item.compiledRouteSummary);\n.skilled/skills/system-skill-advisor/runtime/lib/subprocess.ts:201:      ...(compiledRouteSummary ? { compiledRouteSummary } : {}),\n=== line 645-675 ===\n      ambiguous: data.ambiguous === true,\n      metrics: { tokenCap },\n      sharedPayload: { metadata: { skillLabel: top?.skill ?? null } },\n    }, {\n      tokenCap,\n      thresholdConfig: {\n        confidenceThreshold: options.thresholdConfidence,\n        uncertaintyThreshold: DEFAULT_THRESHOLD_UNCERTAINTY,\n      },\n    })\n    : null;\n  const brief = typeof rendered === 'string' && rendered.trim() ? rendered : null;\n  const routeSummary = compiledRouteSummary(data);\n\n  return {\n    brief,\n    status: brief ? 'ok' : 'skipped',\n    metadata: {\n      route: parsed.degraded === true ? 'cli-local-scorer' : 'cli',\n      freshness,\n      recommendationCount: recommendations.length,\n      tokenCap,\n      skillLabel: top?.skill ?? null,\n      cacheHit: Boolean(data.cache?.hit),\n      ...(routeSummary ? { compiledRouteSummary: routeSummary } : {}),\n    },\n  };\n}\n\n// ─────────────────────────────────────────────────────────────────────────────\n// 4. SIZE-CAP HELPERS\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\": \"cd /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research && grep -rn \\\"compiledRouteSummary\\\" .opencode .skilled/skills/system-skill-advisor --include=*.js --include=*.ts --include=*.mjs --include=*.cjs | grep -v \\\"system-skill-advisor.test.cjs\\\" | grep -v \\\"system-skill-advisor.js:\\\" | head -20; echo \\\"=== line 645-675 ===\\\"; sed -n '645,675p' .opencode/plugins/system-skill-advisor.js\"}"},"time":{"start":1794571496545,"end":1794571501026}}}}
