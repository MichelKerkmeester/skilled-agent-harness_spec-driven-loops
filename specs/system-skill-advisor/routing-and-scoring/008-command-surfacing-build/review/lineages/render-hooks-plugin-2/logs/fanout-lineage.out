rCompiledRouteSummaryLine(\n.opencode/plugins/tests/system-skill-advisor.test.cjs:462:    renderHelpers.renderCompiledRouteSummaryLine(compiledRouteSummary([]), { bounded: true }),\n.opencode/plugins/tests/system-skill-advisor.test.cjs:465:  assert.equal(renderHelpers.renderCompiledRouteSummaryLine(null, { bounded: true }), null);\n.opencode/plugins/lib/skill-advisor-render.js:124:export function renderCompiledRouteSummaryLine(summary, renderOptions = {}) {\n=== boundedCompiledRouteSummary ===\n.opencode/plugins/tests/system-skill-advisor.test.cjs:409:    boundedCompiledRouteSummary: false,\n.opencode/plugins/tests/system-skill-advisor.test.cjs:429:    boundedCompiledRouteSummary: true,\n.opencode/plugins/system-skill-advisor.js:379:  const configuredBounding = typeof options.boundedCompiledRouteSummary === 'boolean'\n.opencode/plugins/system-skill-advisor.js:380:    ? options.boundedCompiledRouteSummary\n.opencode/plugins/system-skill-advisor.js:395:    boundedCompiledRouteSummary: configuredBounding ?? process.env[COMPILED_ROUTE_BOUNDING_ENV] === '1',\n.opencode/plugins/system-skill-advisor.js:1080: * @param {boolean} [rawOptions.boundedCompiledRouteSummary] - Bound long compiled-route target lists\n.opencode/plugins/system-skill-advisor.js:1704:            `bounded_compiled_route_summary=${options.boundedCompiledRouteSummary}`,\n=== loadRenderHelpers ===\n.opencode/plugins/tests/system-skill-advisor.test.cjs:112:function loadRenderHelpers() {\n.opencode/plugins/tests/system-skill-advisor.test.cjs:372:  const renderHelpers = await loadRenderHelpers();\n.opencode/plugins/tests/system-skill-advisor.test.cjs:393:  const renderHelpers = await loadRenderHelpers();\n.opencode/plugins/tests/system-skill-advisor.test.cjs:438:  const renderHelpers = await loadRenderHelpers();\n.opencode/plugins/tests/system-skill-advisor.test.cjs:453:  const renderHelpers = await loadRenderHelpers();\n=== README diff ===\ndiff --git a/.opencode/plugins/README.md b/.opencode/plugins/README.md\nindex a6413e7d7f..4dc7533ca7 100644\n--- a/.opencode/plugins/README.md\n+++ b/.opencode/plugins/README.md\n@@ -154,7 +154,7 @@ plugins/\n | File | Responsibility |\n |---|---|\n | `opencode-goal.js` | The largest plugin. Owns the goal state machine, supervisor, continuation, capabilities and the goal tool surface. Hooks session, message, permission and question events, `experimental.chat.system.transform` and a family of goal tools. |\n-| `system-skill-advisor.js` | Spawns the skill-advisor subprocess on a prompt-cache miss, manages a TTL+LRU prompt cache with in-flight dedup, integrates transform-dedup where the opt-in same-message dedup bases its decision on the full advisor block before directive-lifecycle reduction and suppresses a repeated transform for the same message and exposes `spec_kit_skill_advisor_status`. |\n+| `system-skill-advisor.js` | Spawns the skill-advisor subprocess on a prompt-cache miss, manages a TTL+LRU prompt cache with in-flight dedup, integrates transform-dedup where the opt-in same-message dedup bases its decision on the full advisor block before directive-lifecycle reduction and suppresses a repeated transform for the same message and exposes `spec_kit_skill_advisor_status`. Its recommendation mapper keeps each CLI row's `command`, `policy`, `ownerSkillId` and `needsMode` under the names `renderAdvisorBrief` reads, so an OpenCode brief names the same command and policy as a hook brief. |\n | `system-spec-gate.js` | Maps OpenCode's transport onto the runtime-neutral spec-gate core. Classify best-effort fetches the last user message via `ctx.client`. Enforce throws `system-spec-gate:` on deny. `event` sweeps, advances and evicts state. |\n | `sk-code-post-edit-quality.js` | Correlates `tool.execute.before` file paths to `tool.execute.after` callIDs, runs the post-edit router core and drains findings on the next transform. |\n | `lib/v2-bridge.js` | Builds the dual export for every bridged plugin. `server` is the unchanged v1 factory, and `setup` maps its hooks onto OpenCode 2 registrations and returns a cleanup function. |\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"=== renderCompiledRouteSummaryLine uses ===\n.opencode/plugins/tests/system-skill-advisor.test.cjs:374:  const unbounded = renderHelpers.renderCompiledRouteSummaryLine(summary);\n.opencode/plugins/tests/system-skill-advisor.test.cjs:375:  const bounded = renderHelpers.renderCompiledRouteSummaryLine(summary, { bounded: true });\n.opencode/plugins/tests/system-skill-advisor.test.cjs:387:    renderHelpers.renderCompiledRouteSummaryLine(summary, { reveal: true }),\n.opencode/plugins/tests/system-skill-advisor.test.cjs:397:  assert.equal(renderHelpers.renderCompiledRouteSummaryLine(summary), baseline);\n.opencode/plugins/tests/system-skill-advisor.test.cjs:398:  assert.equal(renderHelpers.renderCompiledRouteSummaryLine(summary, { bounded: false }), baseline);\n.opencode/plugins/tests/system-skill-advisor.test.cjs:447:    renderHelpers.renderCompiledRouteSummaryLine(summary, { bounded: true }),\n.opencode/plugins/tests/system-skill-advisor.test.cjs:455:  const exactLine = renderHelpers.renderCompiledRouteSummaryLine(\n.opencode/plugins/tests/system-skill-advisor.test.cjs:462:    renderHelpers.renderCompiledRouteSummaryLine(compiledRouteSummary([]), { bounded: true }),\n.opencode/plugins/tests/system-skill-advisor.test.cjs:465:  assert.equal(renderHelpers.renderCompiledRouteSummaryLine(null, { bounded: true }), null);\n.opencode/plugins/lib/skill-advisor-render.js:124:export function renderCompiledRouteSummaryLine(summary, renderOptions = {}) {\n=== boundedCompiledRouteSummary ===\n.opencode/plugins/tests/system-skill-advisor.test.cjs:409:    boundedCompiledRouteSummary: false,\n.opencode/plugins/tests/system-skill-advisor.test.cjs:429:    boundedCompiledRouteSummary: true,\n.opencode/plugins/system-skill-advisor.js:379:  const configuredBounding = typeof opt