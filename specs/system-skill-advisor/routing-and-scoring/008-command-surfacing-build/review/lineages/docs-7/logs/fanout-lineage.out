eview\n607:/design:chart\n607:/design:diagram\n607:/design:extract\n652:/doctor:agents-md\n657:/doctor:ci\n662:/doctor:deep-loop\n654:/doctor:env\n103:/doctor:git\n642:/doctor:helper\n83:/doctor:install\n69:/doctor:mcp\n81:/doctor:overlay\n632:/doctor:runtime-mirrors\n66:/doctor:setup\n311:/doctor:sk-code\n660:/doctor:sk-skill\n659:/doctor:skill-advisor\n658:/doctor:speckit\n649:/doctor:symlink\n651:/doctor:update\n609:/prompt:improve\n601:/speckit:ai-council\n90:/speckit:complete\n247:/speckit:handoff\n245:/speckit:implement\n245:/speckit:plan\n93:/speckit:resume\n219:/speckit:save\n247:/speckit:search\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"cd /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research && grep -no \\\"/\\\\(speckit\\\\|create\\\\|deep\\\\|design\\\\|prompt\\\\|doctor\\\\):[a-z-]*\\\" README.md | sort -u -t: -k2 | head -80\"}"},"time":{"start":1794830116358,"end":1794830117183}}}}
