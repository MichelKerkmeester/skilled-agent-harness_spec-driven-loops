/routing-and-scoring/008-command-surfacing-build/review/lineages/attach-docs-8/deep-review-audit-ledger/pending:\n\nspecs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/review/lineages/attach-docs-8/deep-review-audit-ledger/quarantine:\n\nspecs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/review/lineages/attach-docs-8/deep-review-audit-ledger/recoveries:\n\nspecs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/review/lineages/attach-docs-8/deep-review-audit-ledger/stale-locks:\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"ls -la specs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/review/lineages/ ; echo \\\"=== ledger\\\"; ls -R specs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/review/lineages/attach-docs-8/deep-review-audit-ledger | head -50\"}"},"time":{"start":1794832909153,"end":1794832910128}}}}
