,\n    {\n      \"kind\": \"cli-opencode\",\n      \"model\": \"opencode-go/deepseek-v4.1-flash\",\n      \"reasoningEffort\": \"max\",\n      \"iterations\": 5,\n      \"label\": \"attach-docs-8\",\n      \"count\": 1\n    }\n  ],\n  \"concurrency\": 2\n}\n====INVOCATION====\n{\"effectiveConfig\":{\"kind\":\"cli-opencode\",\"executable\":\"opencode\",\"executableVersion\":\"sha256:9f3147cae4ca323827d3ca39451b0d3431b2906e79a08e9b09d1eb34bb703f52\",\"model\":\"opencode-go/deepseek-v4.1-flash\",\"reasoningEffort\":\"max\",\"serviceTier\":null,\"sandboxMode\":\"danger-full-access\",\"permissionMode\":\"acceptEdits\",\"webSearch\":\"inherit\"},\"invocationFingerprint\":\"inv:2de60dc413630e19a286a4aa2008ab4df949a64de623dbbb0a60b6e0fb675cf9\"}\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"cat specs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/review/deep-review-fanout-config-pass-8.json; echo \\\"====INVOCATION====\\\"; cat specs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/review/lineages/attach-docs-8/invocation-metadata.json\"}"},"time":{"start":1794832908289,"end":1794832910083}}}}
