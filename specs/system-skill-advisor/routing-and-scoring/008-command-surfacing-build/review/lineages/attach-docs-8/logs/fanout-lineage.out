tryPath = path.join(reviewDir, 'deep-review-findings-registry.json');\n2526:   const dashboardPath = path.join(reviewDir, 'deep-review-dashboard.md');\n2527:   const resourceMapPath = path.join(reviewDir, 'resource-map.md');\n2528:   const iterationDir = path.join(reviewDir, 'iterations');\n2529:   const deltaDir = path.join(reviewDir, 'deltas');\n2530: \n2531:   // Older and per-lineage review folders keep a state log without a config file. Treat\n2532:   // the missing file like a corrupt line: reduce on defaults, and let the strict path\n2533:   // below fail loudly with the file named rather than a bare ENOENT.\n2534:   const configWarnings = [];\n2535:   let config = {};\n2536:   if (fs.existsSync(configPath)) {\n2537:     config = readJson(configPath);\n2538:   } else {\n2539:     configWarnings.push({ file: 'deep-review-config.json', error: 'config file is missing; reduced on default settings' });\n2540:   }\n2541:   const { records: allRecords, corruptionWarnings: logWarnings } = parseJsonlDetailed(readUtf8(stateLogPath));\n2542:   const corruptionWarnings = configWarnings.concat(logWarnings);\n2543:   // Allowlist: only iteration + event types bear completion semantics. Progress\n2544:   // records (type:'progress') are additive liveness signals — they reset the\n2545:   // no-progress watchdog but MUST NOT count as iterations or completion events.\n2546:   const records = filterCompletionBearingRecords(allRecords);\n2547:   const terminalStop = buildTerminalStopState(records);\n2548:   const lineage = buildLineageState(config, records, terminalStop);\n2549:   config.sessionId = lineage.sessionId || config.sessionId || '';\n2550:   config.parentSessionId = lineage.parentSessionId;\n2551:   config.lineageMode = lineage.lineageMode;\n2552:   config.generation = lineage.generation;\n2553:   config.continuedFromRun = lineage.continuedFromRun;\n2554:   if (terminalStop?.stopReason) {\n2555:     config.stopReason = terminalStop.stopReason;\n2556:   }\n2557:   const strategyContent = fs.existsSync(strategyPath) ? readUtf8(strategyPath) : '';\n2558:   const strategyDimensions = parseStrategyDimensions(strategyContent);\n2559:   const iterationFiles = fs.existsSync(iterationDir)\n2560:     ? fs.readdirSync(iterationDir)\n2561:         .filter((fileName) => /^iteration-\\d+\\.md$/.test(fileName))\n2562:         .sort()\n2563:         .map((fileName) => parseIterationFile(path.join(iterationDir, fileName)))\n2564:     : [];\n2565: \n2566:   // Load delta payloads up-front so the finding registry can use structured\n2567:   // rows first while the resource-map emit path reuses the same parsed data.\n2568:   const deltaLoad = fs.existsSync(deltaDir)\n2569:     ? loadDeltaPayloads(deltaDir)\n2570:     : { payloads: [], corruptionWarnings: [] };\n2571:   const deltaPayloads = deltaLoad.payloads;\n2572:   const allCorruptionWarnings = corruptionWarnings.concat(deltaLoad.corruptionWarnings);\n2573:   const flattenedDeltaRecords = deltaPayloads\n2574:     .flat()\n2575:     .filter((record) => record !== null && record !== undefined);\n2576: \n2577:   const pivotEvents = loadPivotEventRecords(reviewDir);\n2578:   const registry = buildRegistry(\n2579:     strategyDimensions,\n[Output truncated. Continue reading with offset: 2580]","title":"read","metadata":{"metadata":{"truncated":true},"content":[{"type":"text","text":"Read file .skilled/skills/system-deep-loop/runtime/scripts/reduce-state.cjs, lines 2500-2579\n2500:   ].join('\\n');\n2501: }\n2502: \n2503: /**\n2504:  * Reduce JSONL state, iteration files, and strategy into synchronized registry,\n2505:  * strategy, and dashboard outputs. Idempotent: repeated calls produce identical results.\n2506:  *\n2507:  * @param {string} specFolder - Path to the target spec folder for the review packet\n2508:  * @param {Object} [options] - Reducer options\n2509:  * @param {boolean} [options.write=true] - Write outputs to disk when true\n2510:  * @param {string} [options.artifactDir] - Explicit 