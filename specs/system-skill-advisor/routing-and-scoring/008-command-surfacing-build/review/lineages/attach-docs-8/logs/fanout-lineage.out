n968-        if_not_exists:\n969-          proceed: true\n970-\n971-      step_validate_convergence_config:\n972-        action: \"Validate convergence mode when loading config\"\n973-        if_convergence_mode_invalid:\n974-          bookkeeping_log: '{\"type\":\"event\",\"event\":\"config_warning\",\"mode\":\"review\",\"field\":\"antiConvergence.convergenceMode\",\"fallback\":\"default\",\"message\":\"Unsupported convergenceMode; using default convergence behavior.\",\"timestamp\":\"{ISO_8601_NOW}\",\"sessionId\":\"{session_id}\",\"generation\":{generation}}'\n975-          dry_run_event_policy: preview-only\n976-          log: \"Unsupported convergenceMode; using default convergence behavior.\"\n977-\n978-      step_graph_convergence:\n979-        action: \"Run convergence.cjs once: it evaluates the coverage graph and computes the whole review stop decision\"\n980-        inspect:\n981-          - \"{state_paths.state_log}\"\n982-          - \"{state_paths.findings_registry}\"\n983-        transform: |\n--\n1132-            on_A: { set: { decision: \"CONTINUE\" }, proceed_to: step_normalize_pause_events }\n1133-            on_B: { action: \"Advance next_dimension to the next uncovered dimension in strategy.md\", set: { decision: \"CONTINUE\" }, proceed_to: step_normalize_pause_events }\n1134-            on_C: { action: \"Cancel workflow\", status: \"CANCELLED\", release_lock: step_release_lock }\n1135-          note: \"The failure count is rebuilt from the state log, so this gate asks again after each further failed iteration and stops asking once an iteration completes.\"\n1136-        if_stop:\n1137:          record_terminal_gates:\n1138-            when: \"Run once, immediately before control jumps to phase_synthesis: in if_existing_terminal_path, in the divergent pivot's if_failed and on_error branches, and in every confirm-mode manualStop exit (on_C) into phase_synthesis: both divergent pivot gates, gate_pre_iteration and the post-iteration gate. The auto three-errors stop (reason error) reaches it through if_existing_terminal_path. The duration stop in step_check_max_duration runs it, once, before its jump to phase_synthesis. Never run it when the pivot continues the loop.\"\n1139-            bash: 'node .skilled/skills/system-deep-loop/runtime/scripts/terminal-gates.cjs --config-path \"{state_paths.config}\" --state-log \"{state_paths.state_log}\" --registry-path \"{state_paths.findings_registry}\"'\n1140-            note: \"The script computes all three gates from the config, state log and registry: evidence by the evidenceDensityGate rule, coverage by the dimensionCoverageGate rule, and scope by matching every open finding's file against reviewScopeFiles. Never judge a gate from the findings yourself. Run it fresh at this stop, even when an earlier blocked stop recorded failures.\"\n1141-            on_error: \"When the script exits non-zero or prints status error, fail closed: bind terminal_gate_results_json to three rows, evidence, scope and coverage, each with status fail, reasonCode gate-script-error and evidenceDigest the sha256 of the script's error text, and bind failed_required_gate_ids to [\\\"evidence\\\",\\\"scope\\\",\\\"coverage\\\"].\"\n1142-            evaluate: |\n1143-              terminal_stop_reason = reason when it is maxIterationsReached, maxDurationReached, manualStop or error, else \"converged\". Read reason, never stopReason: every manual stop sets reason to manualStop while stopReason may still hold blockedStop or stuckRecovery\n1144-            outputs:\n1145-              - terminal_gate_results_json: \"Tool terminal_gate_results_json: three rows {gateId, status, reasonCode, evidenceDigest} in the order evidence, scope, coverage\"\n1146-              - failed_required_gate_ids: \"Tool failed_required_gate_ids: the gateIds whose status is fail, in that order; [] when all pass\"\n1147-              - terminal_stop_reason: \"From evaluate\"\n1148:            append_jsonl: '{\"stem\":\"deep_review.terminal_gates_recorded\",\"scope\":{\"runId\":\"{session_id}\",\"sessionId\":\"{session_id}\",\"generation\":{generation},\"iterationId\":\"iteration-{current_iteration}\"},\"data\":{\"stopReason\":\"{terminal_stop_reason}\",\"gateResults\":{terminal_gate_results_json},\"failedRequiredGateIds\":{failed_required_gate_ids},\"appendPosition\":{current_iteration}}}'\n1149-            log: \"Terminal gates recorded at stop {terminal_stop_reason}. Failed required gates: {failed_required_gate_ids}\"\n1150-          branch_on: \"convergence_mode == 'divergent' AND stop_decision.reasonDetail == 'all_dimensions_clean'\"\n1151-          if_divergent_eligible:\n1152-            eligibility_contract:\n1153-              required_decision: \"STOP\"\n1154-              eligible_reasons: [all_dimensions_clean]\n1155-              excluded_reasons: [maxIterationsReached, blockedStop, stuckRecovery, error, manualStop, userPaused, maxDurationReached]\n1156-              fail_closed: \"Any missing or ambiguous reason uses if_existing_terminal_path without preparing a pivot. The nine legal-stop gates have already run and remain unchanged.\"\n1157-            steps:\n1158-              step_prepare_divergent_pivot:\n1159-                action: \"Generate state-grounded read-only review candidates and prepare or resume the pivot transaction\"\n1160-                dry_run_boundary: \"state-mutation\"\n1161-                command: |\n1162-                  node .skilled/skills/system-deep-loop/runtime/scripts/divergent-pivot.cjs prepare --loop-type review --artifact-root \"{state_paths.packet_dir}\" --config \"{state_paths.config}\" --state-log \"{state_paths.state_log}\" --strategy \"{state_paths.strategy}\" --registry \"{state_paths.findings_registry}\" --current-iteration \"{current_iteration}\" --max-iterations \"{max_iterations}\" --trigger-reason \"{reason_detail}\"\n1163-                working_directory: \"{repo_root}\"\n1164-                outputs:\n","title":"shell","