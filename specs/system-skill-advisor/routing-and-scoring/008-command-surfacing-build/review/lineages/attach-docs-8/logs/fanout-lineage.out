n a prior packet existed, else null\"\n320:      deep/review command surface with config.fanout_lineage_artifact_dir so the LEAF\n366:        command: \"mkdir -p {state_paths.prompt_dir} {state_paths.iteration_dir} {state_paths.delta_dir}\"\n384:            - \"{state_paths.config}\"\n385:            - \"{state_paths.state_log}\"\n386:            - \"{state_paths.findings_registry}\"\n387:            - \"{state_paths.strategy}\"\n395:            - \"{state_paths.local_packet_dir}/iteration-*.md\"\n396:            - \"{state_paths.legacy_root_report}\"\n401:          - \"{spec_folder}/scratch/deep-research-config.json -> {state_paths.config}\"\n402:          - \"{spec_folder}/scratch/deep-research-state.jsonl -> {state_paths.state_log}\"\n403:          - \"{spec_folder}/scratch/deep-review-strategy.md -> {state_paths.strategy}\"\n404:          - \"{spec_folder}/scratch/deep-review-dashboard.md -> {state_paths.dashboard}\"\n405:          - \"{spec_folder}/scratch/iteration-*.md -> {state_paths.iteration_dir}/\"\n406:          - \"{spec_folder}/scratch/.deep-research-pause -> {state_paths.pause_sentinel}\"\n407:          - \"{state_paths.local_packet_dir}/iteration-*.md -> {state_paths.iteration_dir}/\"\n408:          - \"{state_paths.legacy_root_report} -> {state_paths.review_output}\"\n416:          mkdir -p {state_paths.iteration_dir}\n417:          if [ ! -e {state_paths.config} ] && [ ! -e {state_paths.state_log} ] && [ ! -e {state_paths.strategy} ] && [ -e {spec_folder}/scratch/deep-review-strategy.md ] && ( [ -e {spec_folder}/scratch/deep-research-config.json ] || [ -e {spec_folder}/scratch/deep-research-state.jsonl ] ); then\n418:            [ -e {spec_folder}/scratch/deep-research-config.json ] && mv {spec_folder}/scratch/deep-research-config.json {state_paths.config}\n419:            [ -e {spec_folder}/scratch/deep-research-state.jsonl ] && mv {spec_folder}/scratch/deep-research-state.jsonl {state_paths.state_log}\n420:            [ -e {spec_folder}/scratch/deep-review-strategy.md ] && mv {spec_folder}/scratch/deep-review-strategy.md {state_paths.strategy}\n421:            [ -e {spec_folder}/scratch/deep-review-dashboard.md ] && mv {spec_folder}/scratch/deep-review-dashboard.md {state_paths.dashboard}\n422:            find {spec_folder}/scratch -maxdepth 1 -name 'iteration-*.md' -exec mv {} {state_paths.iteration_dir}/ \\;\n423:            [ -e {spec_folder}/scratch/.deep-research-pause ] && mv {spec_folder}/scratch/.deep-research-pause {state_paths.pause_sentinel}\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"65:  config.fanout_lineage_artifact_dir: \"[optional internal path] - Fan-out lineage artifact override for command-owned single-lineage execution.\"\n86:    sink: \"terminal JSONL preview only; never append to {state_paths.state_log}\"\n179:state_paths:\n214:    command: \"node .skilled/skills/system-deep-loop/runtime/scripts/loop-lock.cjs refresh --lock-path {state_paths.lock_file} --owner-pid {captured_owner_pid} --nonce {captured_acquire_nonce}\"\n222:    branch_on: \"config.fanout_lineage_artifact_dir\"\n225:        artifact_dir: \"{config.fanout_lineage_artifact_dir}\"\n226:        artifact_root_dir: \"{config.fanout_lineage_artifact_dir}\"\n228:        artifact_archive_root: \"{config.fanout_lineage_artifact_dir}/_archive\"\n239:    branch_on: \"config.fanout_lineage_artifact_dir\"\n284:        ' \"{state_paths.config}\" \"{state_paths.state_log}\"\n291:      if [ -e \"{state_paths.archive_root}/{timestamp_slug}\" ]; then\n292:        echo \"The archive folder {state_paths.archive_root}/{timestamp_slug} is already there.\" >&2\n295:      if [ -d \"{state_paths.packet_dir}\" ]; then\n296:        mkdir -p \"{state_paths.archive_root}\" && mv \"{state_paths.packet_dir}\" \"{state_paths.archive_root}/{timestamp_slug}\" || exit 1\n298:      mkdir -p \"{state_paths.packet_dir}\"\n300:      - archived_path: \"{state_paths.archive_root}