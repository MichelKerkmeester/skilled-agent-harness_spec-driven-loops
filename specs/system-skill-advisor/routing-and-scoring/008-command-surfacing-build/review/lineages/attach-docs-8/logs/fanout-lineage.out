pec_folder}/scratch/deep-review-strategy.md ] && mv {spec_folder}/scratch/deep-review-strategy.md {state_paths.strategy}\n421:            [ -e {spec_folder}/scratch/deep-review-dashboard.md ] && mv {spec_folder}/scratch/deep-review-dashboard.md {state_paths.dashboard}\n422:            find {spec_folder}/scratch -maxdepth 1 -name 'iteration-*.md' -exec mv {} {state_paths.iteration_dir}/ \\;\n423:            [ -e {spec_folder}/scratch/.deep-research-pause ] && mv {spec_folder}/scratch/.deep-research-pause {state_paths.pause_sentinel}\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"cd /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research && grep -n \\\"step_init\\\\|step_create_state_log\\\\|step_reduce_state\\\\|step_synthesis\\\\|fanout_lineage_artifact_dir\\\\|state_paths\\\" .skilled/commands/deep/assets/deep-review.yaml | head -40\"}"},"time":{"start":1794833577519,"end":1794833578503}}}}
