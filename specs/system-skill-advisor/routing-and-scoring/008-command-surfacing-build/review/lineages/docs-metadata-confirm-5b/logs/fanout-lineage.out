d-bridges/scoring-compatibility.json:624): Cannot index array with string \"python\"\n38\n.skilled/skills/system-skill-advisor/feature-catalog/scorer-fusion/ablation.md:9:version: 0.8.0.14\n.skilled/skills/system-skill-advisor/feature-catalog/scorer-fusion/ambiguity.md:10:version: 0.8.1.0\n.skilled/skills/system-skill-advisor/feature-catalog/scorer-fusion/attribution.md:10:version: 0.8.0.15\n.skilled/skills/system-skill-advisor/feature-catalog/scorer-fusion/command-meaning-matching.md:9:version: 1.0.4.0\n.skilled/skills/system-skill-advisor/feature-catalog/scorer-fusion/doctor-command-routing.md:10:version: 1.0.14.0\n.skilled/skills/system-skill-advisor/feature-catalog/scorer-fusion/executor-delegation.md:10:version: 1.0.1.0\n.skilled/skills/system-skill-advisor/feature-catalog/scorer-fusion/five-lane-fusion.md:9:version: 0.8.0.16\n.skilled/skills/system-skill-advisor/feature-catalog/scorer-fusion/projection.md:11:version: 0.8.0.12\n.skilled/skills/system-skill-advisor/feature-catalog/scorer-fusion/weights-config.md:9:version: 0.8.0.14\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"cd /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research && jq '.typescript|length, .python|length' .skilled/skills/system-skill-advisor/runtime/scripts/command-bridges/scoring-compatibility.json; grep -rn \\\"^version:\\\" .skilled/skills/system-skill-advisor/feature-catalog/scorer-fusion/*.md | head\"}"},"time":{"start":1794781039257,"end":1794781040350}}}}
