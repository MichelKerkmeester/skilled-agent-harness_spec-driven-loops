ional leaf-aliases.json and leaf-scopes.json alongside their\n77:  const aliasPath = path.join(skillDir, 'leaf-aliases.json');\n480: * Build the canonical `leaf-manifest.json` bytes for a skill root (hub or\n561:    fs.writeFileSync(descriptor, bytes);\n577: * Regenerate and write `leaf-manifest.json` for a skill root.\n584: * @throws {Error} When `leaf-manifest.json` is a symbolic link.\n587:  const manifestPath = path.join(skillDir, 'leaf-manifest.json');\n589:    throw new Error(`leaf-manifest.json is a symbolic link, not followed: ${manifestPath}; remove the link and write the manifest again`);\n594:    // generated noise, so the bytes may list leaves git ignores. Refuse to write\n596:    process.stderr.write(`generate-leaf-manifest: git call timed out (${gitFailure.command}); leaf-manifest.json not written under ${skillDir}\\n`);\n600:  process.stdout.write(`leaf-manifest.json written (${contract.digestManifestBytes(bytes)})\\n`);\n605: * Check that a skill root's committed `leaf-manifest.json` matches a fresh\n614: * @throws {Error} When `leaf-manifest.json` is a symbolic link.\n617:  const manifestPath = path.join(skillDir, 'leaf-manifest.json');\n619:    throw new Error(`leaf-manifest.json is a symbolic link, not followed: ${manifestPath}; remove the link and regenerate it with --write`);\n622:    process.stderr.write(`generate-leaf-manifest: no leaf-manifest.json to check under ${skillDir}\\n`);\n630:    process.stderr.write(`generate-leaf-manifest: git call timed out (${gitFailure.command}); leaf-manifest.json not checked under ${skillDir}\\n`);\n634:    process.stdout.write(`leaf-manifest.json OK (${contract.digestManifestBytes(fresh)})\\n`);\n661:    `generate-leaf-manifest: leaf-manifest.json is stale under ${skillDir}\\n`\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"cd /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research && ls .skilled/skills/sk-doc/sk-create-skill/scripts/ | 