rAt(text, match.index)));\n963-  }\n964-  return warnings;\n965-}\n966-\n967-function evergreenChecks(text, relPath) {\n968-  const errors = [];\n969-  const lines = text.split('\\n');\n970-  lines.forEach((line, index) => {\n971-    if (/\\/(?:Users|home)\\/[^\\s`)'\"|]+/i.test(line) || /[A-Za-z]:\\\\Users\\\\/i.test(line)) {\n972-      errors.push(issue('DEVELOPER_ABSOLUTE_PATH', relPath, 'developer-absolute path appears in scenario truth', 'error', index + 1));\n973-    }\n974-    if (/(?:run|transcript|execution|measured|observed|result|verdict|last validated|as of|timestamp)\\b[^\\n]{0,140}\\b20\\d{2}-\\d{2}-\\d{2}\\b/i.test(line)\n975-      || /\"timestamp\"\\s*:\\s*\"20\\d{2}-\\d{2}-\\d{2}/i.test(line)) {\n976-      errors.push(issue('BAKED_RUN_TRANSCRIPT', relPath, 'dated run evidence appears in scenario truth', 'error', index + 1));\n977-    }\n978-  });\n979-  return errors;\n980-}\n981-\n982-function placeholderChecks(text, relPath) {\n983-  if (/placeholder remains|no execution contract|retired .* scenario|reserved only to keep/i.test(text)\n984-    && !/^##\\s+1\\.\\s+OVERVIEW/m.test(text)) {\n985-    return [issue('PLACEHOLDER_SCENARIO', relPath, 'placeholder file has no executable scenario contract')];\n986-  }\n987-  return [];\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"942:function backtickPathChecks(text, absPath, playbookRoot, repoRoot, relPath) {\n943-  const warnings = [];\n944-  // Scenarios write paths relative to themselves, their playbook root, their skill or\n945-  // hub root, or that root's runtime/ and scripts/ code, as well as to the repository.\n946-  const skillRoot = path.dirname(playbookRoot);\n947-  const roots = [skillRoot];\n948-  if (fs.existsSync(path.join(path.dirname(skillRoot), 'SKILL.md'))) roots.push(path.dirname(skillRoot));\n949-  const bases = [path.dirname(absPath), playbookRoot,\n950-    ...roots.flatMap((root) => [root, path.join(root,