.cjs:1679:          warnings.push({ index, rule: 'findingsNew-shape', detail: 'findingsNew must be an array of findings or an object with P0, P1, P2 keys' });\n.skilled/skills/system-deep-loop/runtime/scripts/reduce-state.cjs:1682:      if (record.findingDetails !== undefined && !Array.isArray(record.findingDetails)) {\n.skilled/skills/system-deep-loop/runtime/scripts/reduce-state.cjs:1683:        warnings.push({ index, rule: 'findingDetails-array', detail: 'findingDetails must be an array' });\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":".skilled/skills/system-deep-loop/runtime/scripts/reduce-state.cjs:768:    const details = Array.isArray(record.findingDetails) ? record.findingDetails : [];\n.skilled/skills/system-deep-loop/runtime/scripts/reduce-state.cjs:860:  const details = Array.isArray(record.findingDetails) ? record.findingDetails : [];\n.skilled/skills/system-deep-loop/runtime/scripts/reduce-state.cjs:1026:  // An iteration that recorded delta finding rows or findingDetails already has its\n.skilled/skills/system-deep-loop/runtime/scripts/reduce-state.cjs:1045:      && Array.isArray(record.findingDetails) && record.findingDetails.length > 0) {\n.skilled/skills/system-deep-loop/runtime/scripts/reduce-state.cjs:1047:      // The summary fallback reads findingDetails only for a run with no delta rows.\n.skilled/skills/system-deep-loop/runtime/scripts/reduce-state.cjs:1049:        for (const detail of record.findingDetails) {\n.skilled/skills/system-deep-loop/runtime/scripts/reduce-state.cjs:1669:      // findingsNew is contractually polymorphic: prompt_pack_iteration.md.tmpl documents it\n.skilled/skills/system-deep-loop/runtime/scripts/reduce-state.cjs:1673:      if (record.findingsNew !== undefined) {\n.skilled/skills/system-deep-loop/runtime/scripts/reduce-state.cjs:1674:        const value = record.findingsNew;\n.skilled/skills/system-deep-loop/runtime/scripts/reduce-state.cj