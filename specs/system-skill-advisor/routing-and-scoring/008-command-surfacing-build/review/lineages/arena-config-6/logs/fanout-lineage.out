_PREFIX, ...args], {\n     5\t    cwd,\n     6\t    encoding: 'utf8',\n     7\t    maxBuffer: 512 * 1024 * 1024,\n     8\t  });\n     9\t  if (result.error) throw new StepFailure('spawn_failed', result.error.message);\n    10\t  return result;\n    11\t}\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"grep -n \\\"builds a source whose tracked listing passes the default buffer\\\\|const name = \\\\|for (let index = 0; index < 6000\\\" .skilled/skills/system-skill-advisor/runtime/tests/command-behaviour-guards.vitest.ts; echo ===; sed -n '142,152p' .skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/prepare-behaviour-arena.mjs | cat -n\"}"},"time":{"start":1794816947846,"end":1794816948740}}}}
