{"type":"tool_use","timestamp":1794815779682,"sessionID":"ses_e1ca84eaaffePZ4Vo82UrPH517","part":{"partID":"prt_1e35b5ff6002sihrjBtk9I0LXz","sessionID":"ses_e1ca84eaaffePZ4Vo82UrPH517","messageID":"msg_1e35ac0ae001VQqU4Kuejv2mpK","type":"tool","id":"call_6dcaabf51bb84f50bbf74f3b","tool":"read","state":{"status":"completed","input":{"path":".skilled/skills/system-skill-advisor/runtime/vitest.config.ts"},"output":"Read file .skilled/skills/system-skill-advisor/runtime/vitest.config.ts, lines 1-62\n1: // ───────────────────────────────────────────────────────────────\n2: // MODULE: System Skill Advisor Vitest Config\n3: // ───────────────────────────────────────────────────────────────\n4: \n5: import { mkdtempSync, rmSync } from 'node:fs';\n6: import { tmpdir } from 'node:os';\n7: import path from 'node:path';\n8: \n9: // The advisor keeps its durable health records under the system temp folder, where\n10: // its health readers take every record as real use. A suite run gets a temp folder\n11: // of its own, set before any worker starts so tests and the processes they spawn\n12: // inherit it, and the run removes it on exit. A folder that cannot be made throws\n13: // here, so no run falls back to the shared folder unnoticed.\n14: const RUN_TMPDIR = mkdtempSync(path.join(tmpdir(), 'sav-'));\n15: process.env.TMPDIR = RUN_TMPDIR;\n16: process.on('exit', () => {\n17:   rmSync(RUN_TMPDIR, { recursive: true, force: true });\n18: });\n19: \n20: const TEST_TIMEOUT_MS = 30_000;\n21: const TEARDOWN_TIMEOUT_MS = 1_000;\n22: const INCLUDE_BENCHES = process.env.SPECKIT_RUN_BENCHES === 'true';\n23: // The stress suites are excluded from the default run because they are slow, not\n24: // because they are unwanted. Without a way to opt in they were unreachable: no\n25: // script and no pattern selected them, so 21 files sat in the tree running never.\n26: // Opting in REPLACES the default set rather than adding to it: these suites churn\n27: // the daemon, its socket and its lease, and running them beside the ordinary\n28: // suites fails a handful of those on shared state rather than on their own logic.\n29: const INCLUDE_STRESS = process.env.SPECKIT_RUN_STRESS === 'true';\n30: \n31: // A plain object export instead of vitest's defineConfig wrapper: the config is\n32: // loaded by node's own module graph, where a bare `vitest` import resolves to\n33: // whatever node_modules sits next to this file. CI's routing job runs the suites\n34: // under a vitest pinned through npx, which can differ from the runtime's own\n35: // vitest range, so importing from the package here could load a second vitest\n36: // copy. defineConfig is an identity type-helper; dropping it changes nothing at\n37: // runtime.\n38: export default ({\n39:   root: import.meta.dirname,\n40:   test: {\n41:     include: [\n42:       ...(INCLUDE_STRESS ? ['stress-test/**/*.vitest.ts'] : ['tests/**/*.vitest.ts']),\n43:       ...(INCLUDE_BENCHES ? ['bench/**/*.bench.ts'] : []),\n44:     ],\n45:     exclude: [\n46:       'node_modules',\n47:       'dist',\n48:       ...(INCLUDE_BENCHES ? [] : ['bench/**/*.bench.ts']),\n49:     ],\n50:     setupFiles: [\n51:       path.resolve(import.meta.dirname, '../../system-spec-kit/runtime/tests/_support/vitest-setup.ts'),\n52:     ],\n53:     fileParallelism: false,\n54:     globals: true,\n55:     environment: 'node',\n56:     testTimeout: TEST_TIMEOUT_MS,\n57:     teardownTimeout: TEARDOWN_TIMEOUT_MS,\n58:     alias: {\n59:       '@lib': path.resolve(import.meta.dirname, 'lib'),\n60:     },\n61:   },\n62: });","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file .skilled/skills/system-skill-advisor/runtime/vitest.config.ts, lines 1-62\n1: // ───────────────────────────────────────────────────────────────\n2: // MODULE: System Skill Advisor Vitest Config\n3: // ───────────────────────────────────────────────────────────────\n4: \n5: import { mkdtempSync, rmSync } from 'node:fs';\n6: import { tmpdir } from 'node:os';\n7: import path from 'node:path';\n8: \n9: // The advisor keeps its durable health records under the system temp folder, where\n10: // its health readers take every record as real use. A suite run gets a temp folder\n11: // of its own, set before any worker starts so tests and the processes they spawn\n12: // inherit it, and the run removes it on exit. A folder that cannot be made throws\n13: // here, so no run falls back to the shared folder unnoticed.\n14: const RUN_TMPDIR = mkdtempSync(path.join(tmpdir(), 'sav-'));\n15: process.env.TMPDIR = RUN_TMPDIR;\n16: process.on('exit', () => {\n17:   rmSync(RUN_TMPDIR, { recursive: true, force: true });\n18: });\n19: \n20: const TEST_TIMEOUT_MS = 30_000;\n21: const TEARDOWN_TIMEOUT_MS = 1_000;\n22: const INCLUDE_BENCHES = process.env.SPECKIT_RUN_BENCHES === 'true';\n23: // The stress suites are excluded from the default run because they are slow, not\n24: // because they are unwanted. Without a way to opt in they were unreachable: no\n25: // script and no pattern selected them, so 21 files sat in the tree running never.\n26: // Opting in REPLACES the default set rather than adding to it: these suites churn\n27: // the daemon, its socket and its lease, and running them beside the ordinary\n28: // suites fails a handful of those on shared state rather than on their own logic.\n29: const INCLUDE_STRESS = process.env.SPECKIT_RUN_STRESS === 'true';\n30: \n31: // A plain object export instead of vitest's defineConfig wrapper: the config is\n32: // loaded by node's own module graph, where a bare `vitest` import resolves to\n33: // whatever node_modules sits next to this file. CI's routing job runs the suites\n34: // under a vitest pinned through npx, which can differ from the runtime's own\n35: // vitest range, so importing from the package here could load a second vitest\n36: // copy. defineConfig is an identity type-helper; dropping it changes nothing at\n37: // runtime.\n38: export default ({\n39:   root: import.meta.dirname,\n40:   test: {\n41:     include: [\n42:       ...(INCLUDE_STRESS ? ['stress-test/**/*.vitest.ts'] : ['tests/**/*.vitest.ts']),\n43:       ...(INCLUDE_BENCHES ? ['bench/**/*.bench.ts'] : []),\n44:     ],\n45:     exclude: [\n46:       'node_modules',\n47:       'dist',\n48:       ...(INCLUDE_BENCHES ? [] : ['bench/**/*.bench.ts']),\n49:     ],\n50:     setupFiles: [\n51:       path.resolve(import.meta.dirname, '../../system-spec-kit/runtime/tests/_support/vitest-setup.ts'),\n52:     ],\n53:     fileParallelism: false,\n54:     globals: true,\n55:     environment: 'node',\n56:     testTimeout: TEST_TIMEOUT_MS,\n57:     teardownTimeout: TEARDOWN_TIMEOUT_MS,\n58:     alias: {\n59:       '@lib': path.resolve(import.meta.dirname, 'lib'),\n60:     },\n61:   },\n62: });"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\".skilled/skills/system-skill-advisor/runtime/vitest.config.ts\"}"},"time":{"start":1794815778806,"end":1794815779682}}}}
