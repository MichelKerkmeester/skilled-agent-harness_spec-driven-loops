{"type":"tool_use","timestamp":1794815882184,"sessionID":"ses_e1ca84eaaffePZ4Vo82UrPH517","part":{"partID":"prt_1e35cf2a2002Vsta0hzoKjQ6Ty","sessionID":"ses_e1ca84eaaffePZ4Vo82UrPH517","messageID":"msg_1e35cd9dc001LNARp6c624tXKF","type":"tool","id":"call_ecb22bc9bf9a4afa825655d6","tool":"read","state":{"status":"completed","input":{"path":".skilled/skills/system-spec-kit/runtime/tests/_support/vitest-setup.ts"},"output":"Read file .skilled/skills/system-spec-kit/runtime/tests/_support/vitest-setup.ts, lines 1-74\n1: // ───────────────────────────────────────────────────────────────────\n2: // MODULE: Vitest Setup\n3: // ───────────────────────────────────────────────────────────────────\n4: \n5: import fs from 'node:fs';\n6: import os from 'node:os';\n7: import path from 'node:path';\n8: import { afterAll } from 'vitest';\n9: \n10: function ensureAbsoluteTempEnv(): void {\n11:   const currentTmp = os.tmpdir();\n12:   const absoluteTmp = path.isAbsolute(currentTmp) ? currentTmp : path.resolve(currentTmp);\n13: \n14:   fs.mkdirSync(absoluteTmp, { recursive: true });\n15: \n16:   for (const key of ['TMPDIR', 'TMP', 'TEMP'] as const) {\n17:     const currentValue = process.env[key];\n18:     if (!currentValue || !path.isAbsolute(currentValue)) {\n19:       process.env[key] = absoluteTmp;\n20:     }\n21:   }\n22: }\n23: \n24: ensureAbsoluteTempEnv();\n25: \n26: // ───────────────────────────────────────────────────────────────────\n27: // PRODUCTION DATABASE ISOLATION\n28: // With neither MEMORY_DB_PATH nor SPEC_KIT_DB_DIR set, the resolver derives\n29: // <runtime>/database/context-index.sqlite. That directory is checked-in runtime\n30: // state, so a test opening the default path writes into the real tree instead of a\n31: // scratch copy. Force a throwaway DB dir for the whole suite so the resolver can\n32: // never fall back to it, and fail closed if any env var explicitly targets it.\n33: // ───────────────────────────────────────────────────────────────────\n34: function isolateProductionDatabase(): void {\n35:   // This setup file lives at <runtime>/tests/_support/, so two levels up is\n36:   // <runtime>. The filename is the retired memory server's and no such file\n37:   // exists now; it is still the name the profile resolver derives by default,\n38:   // which is exactly what has to be kept out of reach.\n39:   const productionDir = path.resolve(import.meta.dirname, '..', '..', 'database');\n40:   const productionDb = path.join(productionDir, 'context-index.sqlite');\n41: \n42:   const memEnv = process.env.MEMORY_DB_PATH;\n43:   if (memEnv && path.resolve(memEnv) === productionDb) {\n44:     throw new Error(\n45:       `[vitest-setup] refusing to run: MEMORY_DB_PATH points at the checked-in database dir's derived default (${productionDb}). Tests must use a throwaway DB.`,\n46:     );\n47:   }\n48:   const dirEnv = process.env.SPEC_KIT_DB_DIR;\n49:   if (dirEnv && path.resolve(dirEnv) === productionDir) {\n50:     throw new Error(\n51:       `[vitest-setup] refusing to run: SPEC_KIT_DB_DIR points at the production database dir (${productionDir}). Tests must use a throwaway dir.`,\n52:     );\n53:   }\n54: \n55:   // Default-safe: with no explicit override, derive a per-file scratch dir so the\n56:   // resolver lands on throwaway storage instead of the production file. Setup runs\n57:   // once per test file, so remove the dir when the file finishes; otherwise every\n58:   // suite run leaves thousands of them in the system temp dir.\n59:   if (!memEnv && !dirEnv) {\n60:     // The run-level setup names one root for every scratch dir and removes it when\n61:     // the run ends, which covers a file that never reaches its afterAll hook.\n62:     const scratchRoot = process.env.SPECKIT_TEST_DB_ROOT || os.tmpdir();\n63:     const scratch = fs.mkdtempSync(path.join(scratchRoot, 'speckit-test-db-'));\n64:     process.env.SPEC_KIT_DB_DIR = scratch;\n65:     afterAll(() => {\n66:       fs.rmSync(scratch, { recursive: true, force: true });\n67:       if (process.env.SPEC_KIT_DB_DIR === scratch) {\n68:         delete process.env.SPEC_KIT_DB_DIR;\n69:       }\n70:     });\n71:   }\n72: }\n73: \n74: isolateProductionDatabase();","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file .skilled/skills/system-spec-kit/runtime/tests/_support/vitest-setup.ts, lines 1-74\n1: // ───────────────────────────────────────────────────────────────────\n2: // MODULE: Vitest Setup\n3: // ───────────────────────────────────────────────────────────────────\n4: \n5: import fs from 'node:fs';\n6: import os from 'node:os';\n7: import path from 'node:path';\n8: import { afterAll } from 'vitest';\n9: \n10: function ensureAbsoluteTempEnv(): void {\n11:   const currentTmp = os.tmpdir();\n12:   const absoluteTmp = path.isAbsolute(currentTmp) ? currentTmp : path.resolve(currentTmp);\n13: \n14:   fs.mkdirSync(absoluteTmp, { recursive: true });\n15: \n16:   for (const key of ['TMPDIR', 'TMP', 'TEMP'] as const) {\n17:     const currentValue = process.env[key];\n18:     if (!currentValue || !path.isAbsolute(currentValue)) {\n19:       process.env[key] = absoluteTmp;\n20:     }\n21:   }\n22: }\n23: \n24: ensureAbsoluteTempEnv();\n25: \n26: // ───────────────────────────────────────────────────────────────────\n27: // PRODUCTION DATABASE ISOLATION\n28: // With neither MEMORY_DB_PATH nor SPEC_KIT_DB_DIR set, the resolver derives\n29: // <runtime>/database/context-index.sqlite. That directory is checked-in runtime\n30: // state, so a test opening the default path writes into the real tree instead of a\n31: // scratch copy. Force a throwaway DB dir for the whole suite so the resolver can\n32: // never fall back to it, and fail closed if any env var explicitly targets it.\n33: // ───────────────────────────────────────────────────────────────────\n34: function isolateProductionDatabase(): void {\n35:   // This setup file lives at <runtime>/tests/_support/, so two levels up is\n36:   // <runtime>. The filename is the retired memory server's and no such file\n37:   // exists now; it is still the name the profile resolver derives by default,\n38:   // which is exactly what has to be kept out of reach.\n39:   const productionDir = path.resolve(import.meta.dirname, '..', '..', 'database');\n40:   const productionDb = path.join(productionDir, 'context-index.sqlite');\n41: \n42:   const memEnv = process.env.MEMORY_DB_PATH;\n43:   if (memEnv && path.resolve(memEnv) === productionDb) {\n44:     throw new Error(\n45:       `[vitest-setup] refusing to run: MEMORY_DB_PATH points at the checked-in database dir's derived default (${productionDb}). Tests must use a throwaway DB.`,\n46:     );\n47:   }\n48:   const dirEnv = process.env.SPEC_KIT_DB_DIR;\n49:   if (dirEnv && path.resolve(dirEnv) === productionDir) {\n50:     throw new Error(\n51:       `[vitest-setup] refusing to run: SPEC_KIT_DB_DIR points at the production database dir (${productionDir}). Tests must use a throwaway dir.`,\n52:     );\n53:   }\n54: \n55:   // Default-safe: with no explicit override, derive a per-file scratch dir so the\n56:   // resolver lands on throwaway storage instead of the production file. Setup runs\n57:   // once per test file, so remove the dir when the file finishes; otherwise every\n58:   // suite run leaves thousands of them in the system temp dir.\n59:   if (!memEnv && !dirEnv) {\n60:     // The run-level setup names one root for every scratch dir and removes it when\n61:     // the run ends, which covers a file that never reaches its afterAll hook.\n62:     const scratchRoot = process.env.SPECKIT_TEST_DB_ROOT || os.tmpdir();\n63:     const scratch = fs.mkdtempSync(path.join(scratchRoot, 'speckit-test-db-'));\n64:     process.env.SPEC_KIT_DB_DIR = scratch;\n65:     afterAll(() => {\n66:       fs.rmSync(scratch, { recursive: true, force: true });\n67:       if (process.env.SPEC_KIT_DB_DIR === scratch) {\n68:         delete process.env.SPEC_KIT_DB_DIR;\n69:       }\n70:     });\n71:   }\n72: }\n73: \n74: isolateProductionDatabase();"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\".skilled/skills/system-spec-kit/runtime/tests/_support/vitest-setup.ts\"}"},"time":{"start":1794815881890,"end":1794815882184}}}}
