view/lineages/docs-metadata-5/containment/baseline/specs/system-skill-advisor/routing-and-scoring:\n008-command-surfacing-build\n\nspecs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/review/lineages/docs-metadata-5/containment/baseline/specs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build:\ngoal.md\nreview\n\nspecs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/review/lineages/docs-metadata-5/containment/baseline/specs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/review:\ndeep-review-fanout-config-pass-5.json\nreview-brief-5.txt\nreview-focus-5.txt\nreview-scope-5.txt\n\nspecs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/review/lineages/docs-metadata-5/deep-review-audit-ledger:\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"_events\ncontainment\ndeep-review-audit-ledger\ndeep-review-config.json\ndeep-review-dashboard.md\ndeep-review-effect-ledger\ndeep-review-findings-registry.json\ndeep-review-ledger\ndeep-review-state.jsonl\ndeep-review-strategy.md\ndeltas\ninvocation-metadata.json\niterations\nlocks-and-fencing-v1\nlogs\nprompts\nreview-report.md\n\nspecs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/review/lineages/docs-metadata-5/_events:\nclaim-adjudication-001.json\nclaim-adjudication-002.json\nclaim-adjudication-003.json\nclaim-adjudication-004.json\ncloseout\niter-001.json\niter-002.json\niter-003.json\niter-004.json\nrun-open.json\nterminal-gates.json\n\nspecs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/review/lineages/docs-metadata-5/_events/closeout:\nsynthesis_complete.json\n\nspecs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/review/lineages/docs-metadata-5/containment:\nbaseline\n\nspecs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/review/lineages/docs-metadata-5/containment/baseline:\nspecs\n\nspecs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/review/lineages/docs-metadata-5/containment/baseline/specs:\nsystem-skill-advisor\n\nspecs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/review/lineages/docs-metadata-5/containment/baseline/specs/system-skill-advisor:\nrouting-and-scoring\n\nspecs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/review/lineages/docs-metadata-5/containment/baseline/specs/system-skill-advisor/routing-and-scoring:\n008-command-surfacing-build\n\nspecs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/review/lineages/docs-metadata-5/containment/baseline/specs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build:\ngoal.md\nreview\n\nspecs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/review/lineages/docs-metadata-5/containment/baseline/specs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/review:\ndeep-review-fanout-config-pass-5.json\nreview-brief-5.txt\nreview-focus-5.txt\nreview-scope-5.txt\n\nspecs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/review/lineages/docs-metadata-5/deep-review-audit-ledger:\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"ls -R specs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/review/lineages/docs-metadata-5 | head -60\"}"},"time":{"start":1794815571540,"end":1794815572299}}}}
