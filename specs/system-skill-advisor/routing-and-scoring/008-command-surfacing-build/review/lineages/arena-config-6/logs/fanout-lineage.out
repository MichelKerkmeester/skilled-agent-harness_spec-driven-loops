ep-loop/runtime/scripts/reduce-state.cjs\",\n82:   \"fileProtection\": {\n83:     \"deep-review-config.json\": \"immutable\",\n84:     \"deep-review-state.jsonl\": \"append-only\",\n85:     \"deep-review-findings-registry.json\": \"auto-generated\",\n86:     \"deep-review-strategy.md\": \"mutable\",\n87:     \"deep-review-dashboard.md\": \"auto-generated\",\n88:     \".deep-review-pause\": \"operator-controlled\",\n89:     \"review-report.md\": \"mutable\",\n90:     \"review-report-v*.md\": \"write-once\",\n91:     \"iteration-*.md\": \"write-once\"\n92:   },\n93:   \"reducer\": {\n94:     \"enabled\": true,\n95:     \"inputs\": [\n96:       \"latestJSONLDelta\",\n97:       \"newIterationFile\",\n98:       \"priorReducedState\"\n99:     ],\n100:     \"outputs\": [\n101:       \"findingsRegistry\",\n102:       \"dashboardMetrics\",\n103:       \"strategyUpdates\"\n104:     ],\n105:     \"metrics\": [\n106:       \"dimensionsCovered\",\n107:       \"findingsBySeverity\",\n108:       \"openFindings\",\n109:       \"resolvedFindings\",\n110:       \"convergenceScore\"\n111:     ]\n112:   },\n113:   \"_optimizerManaged\": {\n114:     \"description\": \"Fields managed by the offline loop optimizer (042.004). See optimizer-manifest.json for the canonical tunable/locked field registry.\",\n115:     \"manifestPath\": \".skilled/skills/system-spec-kit/runtime/cli/optimizer/optimizer-manifest.json\",\n116:     \"tunableFields\": [\n117:       \"convergenceThreshold\",\n118:       \"stuckThreshold\",\n119:       \"maxIterations\"\n120:     ],\n121:     \"lockedFields\": [\n122:       \"lineageMode\",\n123:       \"reducer\",\n124:       \"fileProtection\",\n125:       \"sessionId\",\n126:       \"mode\",\n127:       \"reviewDimensions\",\n128:       \"antiConvergence.convergenceMode\",\n129:       \"antiConvergence.stopPolicy\"\n130:     ],\n131:     \"promotionMode\": \"advisory-only\"\n132:   }\n133: }"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\"specs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/review/lineages/docs-metadata-5/deep-review-config.json\"}"},"time":{"start":1794815571797,"end":1794815572214}}}}
