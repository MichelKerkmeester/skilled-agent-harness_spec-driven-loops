{"type":"tool_use","timestamp":1794815734415,"sessionID":"ses_e1ca84eaaffePZ4Vo82UrPH517","part":{"partID":"prt_1e35ab15d002PQxxxqoi2TQiGh","sessionID":"ses_e1ca84eaaffePZ4Vo82UrPH517","messageID":"msg_1e35a6fb00012PqazHN8AqWP0V","type":"tool","id":"call_7367df93e8544e9ba91542ee","tool":"read","state":{"status":"completed","input":{"path":".skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/prepare-behaviour-arena.mjs"},"output":"Read file .skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/prepare-behaviour-arena.mjs, lines 1-614\n1: // ───────────────────────────────────────────────────────────────\n2: // MODULE: Behaviour Arena Builder\n3: // ───────────────────────────────────────────────────────────────\n4: //\n5: // A live turn has to run where the advisor it measures is built the way a user\n6: // gets it. A clone of the branch tip in a directory git does not own gives that\n7: // and takes the outside world's handles away. It has no remote, so a turn has\n8: // nothing to push to by name, and no outer repository whose hooks or credentials\n9: // it could borrow. Its tracked tree is exactly the commit under test, so a\n10: // per-turn restore has a clean baseline to put back. What the clone does not\n11: // take away is the filesystem, since a turn can still read and write anywhere\n12: // its user can by absolute path.\n13: //\n14: // A clone also leaves out every ignored build output. The advisor under test\n15: // runs from compiled JavaScript and its SQLite skill graph, so those trees are\n16: // copied in afterwards. Building them inside the clone instead would measure a\n17: // bundle nobody reviewed, and would need the network while an arena is meant to\n18: // be offline.\n19: //\n20: // A copy also has to look like a build. The freshness guard each CLI shim runs\n21: // falls back to comparing the newest watched source against the build's own\n22: // timestamp, and a checkout stamps every source with the clone time while the\n23: // copied build keeps the moment it was compiled. Left alone, that order says\n24: // every copied package is stale and every shim exits before running. The copied\n25: // build is the same commit's build, so its timestamp is set to the copy time,\n26: // which is what a build in this checkout would carry.\n27: //\n28: // Nothing is copied before the destination is checked. A destination inside a\n29: // repository would inherit that repository's hooks and ignore rules, and a\n30: // destination that already exists may hold another arm's log, so both are\n31: // refused rather than merged into.\n32: //\n33: // The copy reads the source worktree, so the one thing it must never carry\n34: // across is a dotenv file. A model reads and writes an arena, so a secret that\n35: // followed the build output in would sit where a run can print it. Every file\n36: // whose name begins with `.env` is skipped while copying the build trees, at\n37: // every depth. A clone brings every tracked file, so a dotenv file in the commit\n38: // is already in the arena, and the output and the marker name it instead.\n39: //\n40: // Usage:\n41: //   node prepare-behaviour-arena.mjs --source <repo root> --dest <dir>\n42: \n43: // ───────────────────────────────────────────────────────────────\n44: // 1. IMPORTS\n45: // ───────────────────────────────────────────────────────────────\n46: \n47: import { appendFileSync, existsSync, lstatSync, lutimesSync, mkdirSync, readFileSync, readdirSync, readlinkSync, realpathSync, rmSync, utimesSync, writeFileSync } from 'node:fs';\n48: import { spawnSync } from 'node:child_process';\n49: import { basename, dirname, isAbsolute, join, relative, resolve, sep } from 'node:path';\n50: import { fileURLToPath } from 'node:url';\n51: \n52: // ───────────────────────────────────────────────────────────────\n53: // 2. CONSTANTS\n54: // ───────────────────────────────────────────────────────────────\n55: \n56: const SCRIPT_NAME = basename(fileURLToPath(import.meta.url));\n57: const EXIT_REFUSED = 2;\n58: \n59: const USAGE = `usage: node ${SCRIPT_NAME} --source <repo root> --dest <dir>`;\n60: \n61: // A filesystem monitor that decides a path is unchanged makes the clone and the\n62: // clean-tree check disagree about what the checkout holds.\n63: const GIT_PREFIX = ['-c', 'core.fsmonitor=false'];\n64: \n65: export const MARK = 'skilled-behaviour-arena';\n66: \n67: // The two ignored trees a build writes and a clone never carries.\n68: const BUILD_DIR_NAMES = new Set(['dist', 'node_modules']);\n69: \n70: const SQLITE_SUFFIX = '.sqlite';\n71: const SKILLED_PREFIX = '.skilled/';\n72: const DOTENV_PATTERN = /^\\.env/;\n73: \n74: // ───────────────────────────────────────────────────────────────\n75: // 3. FAILURE SHAPES\n76: // ───────────────────────────────────────────────────────────────\n77: \n78: // A refusal is a precondition the caller can act on, so it carries a code on\n79: // stdout. A step failure leaves no usable arena behind, so it reports the code\n80: // and the failing command on stderr instead.\n81: class StepFailure extends Error {\n82:   constructor(code, detail) {\n83:     super(detail === '' ? code : `${code}: ${detail}`);\n84:     this.code = code;\n85:   }\n86: }\n87: \n88: function writeJson(value) {\n89:   process.stdout.write(`${JSON.stringify(value)}\\n`);\n90: }\n91: \n92: function refuse(code, extra = {}) {\n93:   writeJson({ ok: false, code, ...extra });\n94:   process.exit(EXIT_REFUSED);\n95: }\n96: \n97: function abort(code, detail = '') {\n98:   process.stderr.write(`${SCRIPT_NAME}: ${detail === '' ? code : `${code}: ${detail}`}\\n`);\n99:   writeJson({ ok: false, code });\n100:   process.exit(1);\n101: }\n102: \n103: // ───────────────────────────────────────────────────────────────\n104: // 4. ARGUMENT PARSING\n105: // ───────────────────────────────────────────────────────────────\n106: \n107: function valueAfter(argv, index, flag) {\n108:   const value = argv[index];\n109:   if (value === undefined || value.startsWith('--')) {\n110:     process.stderr.write(`${SCRIPT_NAME}: ${flag} needs a value\\n${USAGE}\\n`);\n111:     process.exit(EXIT_REFUSED);\n112:   }\n113:   return value;\n114: }\n115: \n116: function parseOptions(argv) {\n117:   const options = { source: null, dest: null };\n118:   for (let index = 0; index < argv.length; index += 1) {\n119:     const token = argv[index];\n120:     if (token === '--source') {\n121:       index += 1;\n122:       options.source = valueAfter(argv, index, '--source');\n123:     } else if (token === '--dest') {\n124:       index += 1;\n125:       options.dest = valueAfter(argv, index, '--dest');\n126:     } else {\n127:       process.stderr.write(`${SCRIPT_NAME}: unknown option: ${token}\\n${USAGE}\\n`);\n128:       process.exit(EXIT_REFUSED);\n129:     }\n130:   }\n131:   if (options.source === null || options.dest === null) {\n132:     process.stderr.write(`${SCRIPT_NAME}: --source and --dest are required\\n${USAGE}\\n`);\n133:     process.exit(EXIT_REFUSED);\n134:   }\n135:   return options;\n136: }\n137: \n138: // ───────────────────────────────────────────────────────────────\n139: // 5. GIT HELPERS\n140: // ───────────────────────────────────────────────────────────────\n141: \n142: // A whole-repository listing passes the 1 MiB buffer a spawnSync call starts with,\n143: // so every git call gets room for the largest tree a source may hold.\n144: function git(args, cwd) {\n145:   const result = spawnSync('git', [...GIT_PREFIX, ...args], {\n146:     cwd,\n147:     encoding: 'utf8',\n148:     maxBuffer: 512 * 1024 * 1024,\n149:   });\n150:   if (result.error) throw new StepFailure('spawn_failed', result.error.message);\n151:   return result;\n152: }\n153: \n154: function gitText(args, cwd, code) {\n155:   const result = git(args, cwd);\n156:   if (result.status !== 0) throw new StepFailure(code, (result.stderr ?? '').trim());\n157:   return result.stdout;\n158: }\n159: \n160: function headOf(cwd, code) {\n161:   const head = gitText(['rev-parse', 'HEAD'], cwd, code).trim();\n162:   if (head === '') throw new StepFailure(code, `no HEAD in ${cwd}`);\n163:   return head;\n164: }\n165: \n166: // Whether git would leave a path out of a checkout decides whether a clone\n167: // already holds it, so ignore rules are asked rather than guessed from a name.\n168: function isIgnored(cwd, relPath) {\n169:   return git(['check-ignore', '-q', '--', relPath], cwd).status === 0;\n170: }\n171: \n172: // ───────────────────────────────────────────────────────────────\n173: // 6. DESTINATION CHECKS\n174: // ───────────────────────────────────────────────────────────────\n175: \n176: function pathExists(path) {\n177:   try {\n178:     lstatSync(path);\n179:     return true;\n180:   } catch {\n181:     return false;\n182:   }\n183: }\n184: \n185: function nearestExistingAncestor(path) {\n186:   let current = path;\n187:   while (!existsSync(current) && dirname(current) !== current) current = dirname(current);\n188:   return current;\n189: }\n190: \n191: function isInsideRepository(path) {\n192:   return git(['rev-parse', '--show-toplevel'], path).status === 0;\n193: }\n194: \n195: // ───────────────────────────────────────────────────────────────\n196: // 7. SOURCE CHECKS\n197: // ───────────────────────────────────────────────────────────────\n198: \n199: // A clone carries the commit and nothing else, so a changed or untracked path is\n200: // what the arena would silently not measure.\n201: function sourceChanges(source) {\n202:   return gitText(['status', '--porcelain'], source, 'source_status_unreadable')\n203:     .split('\\n')\n204:     .filter((line) => line !== '')\n205:     .map((line) => line.slice(3));\n206: }\n207: \n208: function newestFileTime(path) {\n209:   let newest = 0;\n210:   for (const entry of readdirSync(path, { withFileTypes: true })) {\n211:     const child = join(path, entry.name);\n212:     if (entry.isDirectory()) {\n213:       newest = Math.max(newest, newestFileTime(child));\n214:       continue;\n215:     }\n216:     newest = Math.max(newest, lstatSync(child).mtimeMs);\n217:   }\n218:   return newest;\n219: }\n220: \n221: // The guard a CLI shim runs compares a build with the newest watched source, so a\n222: // build's inputs are the folder that holds it and, where a tsconfig beside it names\n223: // sources above, the folders those includes reach. The build has to be at least as\n224: // new as the newest tracked file in every one of them.\n225: function newestTrackedTime(source, folder) {\n226:   const prefix = folder === '.' ? '' : `${folder}/`;\n227:   const tracked = gitText(['ls-files', '-z', '--', folder], source, 'tracked_files_unreadable')\n228:     .split('\\0')\n229:     .filter(\n230:       (relPath) =>\n231:         relPath !== '' &&\n232:         !relPath.startsWith(`${prefix}dist/`) &&\n233:         !relPath.startsWith(`${prefix}node_modules/`),\n234:     );\n235:   let newest = 0;\n236:   for (const relPath of tracked) newest = Math.max(newest, lstatSync(join(source, relPath)).mtimeMs);\n237:   return newest;\n238: }\n239: \n240: // A tsconfig is read by the compiler with `//` and `/* */` comments allowed, so the\n241: // text is scanned here instead of being handed to JSON as it stands. A string is\n242: // copied through untouched, because one may hold `//` of its own.\n243: function stripJsonComments(text) {\n244:   let out = '';\n245:   let index = 0;\n246:   let inString = false;\n247:   while (index < text.length) {\n248:     const char = text[index];\n249:     if (inString) {\n250:       out += char;\n251:       if (char === '\\\\' && index + 1 < text.length) {\n252:         out += text[index + 1];\n253:         index += 2;\n254:         continue;\n255:       }\n256:       if (char === '\"') inString = false;\n257:       index += 1;\n258:       continue;\n259:     }\n260:     if (char === '\"') {\n261:       inString = true;\n262:       out += char;\n263:       index += 1;\n264:       continue;\n265:     }\n266:     if (char === '/' && text[index + 1] === '/') {\n267:       while (index < text.length && text[index] !== '\\n') index += 1;\n268:       continue;\n269:     }\n270:     if (char === '/' && text[index + 1] === '*') {\n271:       const end = text.indexOf('*/', index + 2);\n272:       index = end === -1 ? text.length : end + 2;\n273:       continue;\n274:     }\n275:     out += char;\n276:     index += 1;\n277:   }\n278:   return out;\n279: }\n280: \n281: // An include entry names files as patterns, and the folder a change can land in is\n282: // the path above the first segment holding a wildcard. Everything below that segment\n283: // names files, so nothing below it names a folder to watch.\n284: function includeFolder(entry) {\n285:   const segments = entry.split('/');\n286:   const first = segments.findIndex((segment) => /[*?{]/.test(segment));\n287:   return (first === -1 ? segments : segments.slice(0, first)).join('/');\n288: }\n289: \n290: // A build's inputs are its own folder, plus every folder a tsconfig beside it reaches\n291: // when an include entry climbs out of that folder. A tsconfig that cannot be read or\n292: // parsed adds nothing, because nothing then shows which files it would watch.\n293: function buildInputFolders(source, folder) {\n294:   const folders = [folder];\n295:   let names;\n296:   try {\n297:     names = readdirSync(join(source, folder));\n298:   } catch {\n299:     return folders;\n300:   }\n301:   const root = realpathSync(source);\n302:   const own = resolve(root, folder);\n303:   const ownPrefix = `${own}${sep}`;\n304:   for (const name of names.sort()) {\n305:     if (!/^tsconfig.*\\.json$/.test(name)) continue;\n306:     let include;\n307:     try {\n308:       include = JSON.parse(stripJsonComments(readFileSync(join(source, folder, name), 'utf8'))).include;\n309:     } catch {\n310:       continue;\n311:     }\n312:     if (!Array.isArray(include)) continue;\n313:     for (const entry of include) {\n314:       if (typeof entry !== 'string') continue;\n315:       const prefix = includeFolder(entry);\n316:       if (prefix === '') continue;\n317:       const reached = resolve(root, folder, prefix);\n318:       if (reached === own || reached.startsWith(ownPrefix)) continue;\n319:       const fromRoot = relative(root, reached);\n320:       if (isAbsolute(fromRoot) || fromRoot === '..' || fromRoot.startsWith(`..${sep}`)) continue;\n321:       const relFolder = fromRoot === '' ? '.' : fromRoot.split(sep).join('/');\n322:       if (!folders.includes(relFolder)) folders.push(relFolder);\n323:     }\n324:   }\n325:   return folders;\n326: }\n327: \n328: // One refusal lists every stale build, so a single rebuild round clears the tree\n329: // instead of one refusal per build.\n330: function staleBuilds(source, copied) {\n331:   const stale = [];\n332:   for (const relPath of copied) {\n333:     if (basename(relPath) !== 'dist') continue;\n334:     const folder = dirname(relPath);\n335:     const buildTime = newestFileTime(join(source, relPath));\n336:     const sourceTime = buildInputFolders(source, folder).reduce(\n337:       (newest, inputFolder) => Math.max(newest, newestTrackedTime(source, inputFolder)),\n338:       0,\n339:     );\n340:     if (buildTime >= sourceTime) continue;\n341:     stale.push({\n342:       path: relPath,\n343:       source: new Date(sourceTime).toISOString(),\n344:       build: new Date(buildTime).toISOString(),\n345:     });\n346:   }\n347:   return stale;\n348: }\n349: \n350: // A copied build tree can hold a link whose target sits outside the checkout, and\n351: // copying the link would bring that data into the arena where a run can read it.\n352: // A link is allowed only when it already resolves inside the source, so a dangling\n353: // link is refused too because nothing shows where it would land. A link written as\n354: // an absolute path is refused even when it resolves inside the source, because the\n355: // copy keeps its text and it would still name the source instead of the arena it\n356: // sits in. The walk reads the trees a clone never carries, which is where such a\n357: // link can hide.\n358: function escapingLinks(source, copied) {\n359:   const root = realpathSync(source);\n360:   const escapes = [];\n361:   const visit = (relPath) => {\n362:     for (const entry of readdirSync(join(source, relPath), { withFileTypes: true })) {\n363:       const childRel = `${relPath}/${entry.name}`;\n364:       const childPath = join(source, childRel);\n365:       if (entry.isSymbolicLink()) {\n366:         let target = null;\n367:         try {\n368:           target = realpathSync(childPath);\n369:         } catch {\n370:           escapes.push({ path: childRel, target: null });\n371:           continue;\n372:         }\n373:         const fromRoot = relative(root, target);\n374:         const outside = isAbsolute(fromRoot) || fromRoot === '..' || fromRoot.startsWith(`..${sep}`);\n375:         if (outside || isAbsolute(readlinkSync(childPath))) escapes.push({ path: childRel, target });\n376:         continue;\n377:       }\n378:       if (entry.isDirectory()) visit(childRel);\n379:     }\n380:   };\n381:   for (const relPath of copied) {\n382:     if (lstatSync(join(source, relPath)).isDirectory()) visit(relPath);\n383:   }\n384:   return escapes;\n385: }\n386: \n387: // ───────────────────────────────────────────────────────────────\n388: // 8. COPY PLAN\n389: // ───────────────────────────────────────────────────────────────\n390: \n391: // One walk of the source decides what a clone is missing. A build directory is\n392: // recorded and not descended into, so anything inside it travels with the tree.\n393: // The SQLite files searched for sit under the tooling root only, because that is\n394: // where the advisor keeps its graph.\n395: function copyPlan(source) {\n396:   const trees = [];\n397:   const sqlite = [];\n398:   const walk = (relPath) => {\n399:     const absPath = relPath === '' ? source : join(source, relPath);\n400:     for (const entry of readdirSync(absPath, { withFileTypes: true })) {\n401:       if (entry.name === '.git') continue;\n402:       const childRel = relPath === '' ? entry.name : `${relPath}/${entry.name}`;\n403:       if (entry.isDirectory()) {\n404:         if (BUILD_DIR_NAMES.has(entry.name)) {\n405:           trees.push(childRel);\n406:           continue;\n407:         }\n408:         walk(childRel);\n409:         continue;\n410:       }\n411:       if (entry.isFile() && entry.name.endsWith(SQLITE_SUFFIX) && childRel.startsWith(SKILLED_PREFIX)) {\n412:         sqlite.push(childRel);\n413:       }\n414:     }\n415:   };\n416:   walk('');\n417:   return [...trees, ...sqlite].filter((relPath) => isIgnored(source, relPath)).sort();\n418: }\n419: \n420: // A tracked dotenv file is already in the commit, so a clone carries it and the\n421: // copy below never sees it. Naming it is what tells the operator the arena holds\n422: // one, and the commit already published it to anyone who clones.\n423: function trackedDotenvFiles(source) {\n424:   return gitText(['ls-files', '-z'], source, 'tracked_files_unreadable')\n425:     .split('\\0')\n426:     .filter((relPath) => relPath !== '' && DOTENV_PATTERN.test(basename(relPath)));\n427: }\n428: \n429: function holdsDotenv(dirPath) {\n430:   for (const entry of readdirSync(dirPath, { withFileTypes: true })) {\n431:     if (DOTENV_PATTERN.test(entry.name)) return true;\n432:     if (entry.isDirectory() && holdsDotenv(join(dirPath, entry.name))) return true;\n433:   }\n434:   return false;\n435: }\n436: \n437: // The clonefile flag copies a file's blocks instead of its bytes, and only the\n438: // macOS `cp` has it, so the platform picks the list rather than assuming every\n439: // `cp` accepts the flag.\n440: export function copyArgs(platform) {\n441:   return platform === 'darwin' ? ['-Rc'] : ['-R'];\n442: }\n443: \n444: function runCp(sourcePath, destParent) {\n445:   const result = spawnSync('cp', [...copyArgs(process.platform), sourcePath, destParent], { encoding: 'utf8' });\n446:   if (result.error) throw new StepFailure('copy_failed', `${sourcePath}: ${result.error.message}`);\n447:   if (result.status !== 0) throw new StepFailure('copy_failed', `${sourcePath}: ${(result.stderr ?? '').trim()}`);\n448: }\n449: \n450: // A symlink is stamped through the link itself, because its target may live\n451: // outside the arena and is not this copy's to change.\n452: function stampPath(path, time) {\n453:   if (lstatSync(path).isSymbolicLink()) {\n454:     lutimesSync(path, time, time);\n455:     return;\n456:   }\n457:   utimesSync(path, time, time);\n458: }\n459: \n460: // Only a build tree is stamped. The guard reads the timestamp of a dist entry,\n461: // and neither a dependency tree nor a database file is watched.\n462: function stampBuildTree(path) {\n463:   const time = new Date();\n464:   for (const entry of readdirSync(path, { withFileTypes: true })) {\n465:     const child = join(path, entry.name);\n466:     if (entry.isDirectory()) stampBuildTree(child);\n467:     else stampPath(child, time);\n468:   }\n469:   stampPath(path, time);\n470: }\n471: \n472: // The clonefile flag is macOS only, and on the same volume it keeps the copy\n473: // cheap. The walk only happens where a dotenv file is actually present, so the\n474: // common tree is one `cp` call rather than one call per file.\n475: function copyPath(sourcePath, destPath) {\n476:   const isDirectory = lstatSync(sourcePath).isDirectory();\n477:   if (!isDirectory || !holdsDotenv(sourcePath)) {\n478:     mkdirSync(dirname(destPath), { recursive: true });\n479:     runCp(sourcePath, dirname(destPath));\n480:     return;\n481:   }\n482:   mkdirSync(destPath, { recursive: true });\n483:   for (const entry of readdirSync(sourcePath, { withFileTypes: true })) {\n484:     if (DOTENV_PATTERN.test(entry.name)) continue;\n485:     copyPath(join(sourcePath, entry.name), join(destPath, entry.name));\n486:   }\n487: }\n488: \n489: // ───────────────────────────────────────────────────────────────\n490: // 9. ARENA BUILD\n491: // ───────────────────────────────────────────────────────────────\n492: \n493: function cloneInto(source, dest) {\n494:   const result = git(['clone', '--no-hardlinks', source, dest], process.cwd());\n495:   if (result.status !== 0) throw new StepFailure('clone_failed', (result.stderr ?? '').trim());\n496: }\n497: \n498: function checkoutDetached(dest, head) {\n499:   const result = git(['checkout', '--quiet', '--detach', head], dest);\n500:   if (result.status !== 0) throw new StepFailure('checkout_failed', (result.stderr ?? '').trim());\n501: }\n502: \n503: // A remote is the one piece of git state a turn could use to reach outside the\n504: // checkout, so every one the clone inherits is removed rather than left dormant.\n505: function removeRemotes(dest) {\n506:   const names = gitText(['remote'], dest, 'remote_unreadable')\n507:     .split('\\n')\n508:     .map((name) => name.trim())\n509:     .filter((name) => name !== '');\n510:   for (const name of names) gitText(['remote', 'remove', name], dest, 'remote_unreadable');\n511: }\n512: \n513: function assertHead(dest, head) {\n514:   const cloned = gitText(['rev-parse', 'HEAD'], dest, 'head_unreadable').trim();\n515:   if (cloned !== head) throw new StepFailure('head_mismatch', `expected ${head}, got ${cloned}`);\n516: }\n517: \n518: // Claude Code reads CLAUDE.md and not AGENTS.md, so the arena imports its own\n519: // rules, and the exclude line keeps the clean-tree check and the head unchanged.\n520: function writeClaudePointer(dest) {\n521:   const pointerPath = join(dest, 'CLAUDE.md');\n522:   if (existsSync(pointerPath)) return;\n523:   writeFileSync(pointerPath, '@AGENTS.md\\n');\n524:   mkdirSync(join(dest, '.git', 'info'), { recursive: true });\n525:   appendFileSync(join(dest, '.git', 'info', 'exclude'), '/CLAUDE.md\\n');\n526: }\n527: \n528: function buildArena(source, dest, head, copied, trackedDotenv) {\n529:   cloneInto(source, dest);\n530:   checkoutDetached(dest, head);\n531:   removeRemotes(dest);\n532:   for (const relPath of copied) {\n533:     const destPath = join(dest, relPath);\n534:     copyPath(join(source, relPath), destPath);\n535:     if (basename(relPath) === 'dist') stampBuildTree(destPath);\n536:   }\n537:   assertHead(dest, head);\n538:   writeClaudePointer(dest);\n539:   // The runner refuses a live arm in a checkout without this file, because only a\n540:   // checkout built here has no remote, no outer repository and no dotenv file in\n541:   // its copied build trees. The lines after the head record what the source checks\n542:   // found and when each copied build was compiled.\n543:   const marker = [head, 'source clean'];\n544:   for (const relPath of copied) {\n545:     if (basename(relPath) !== 'dist') continue;\n546:     marker.push(`built ${relPath} ${new Date(newestFileTime(join(source, relPath))).toISOString()}`);\n547:   }\n548:   for (const relPath of trackedDotenv) marker.push(`tracked-dotenv ${relPath}`);\n549:   writeFileSync(join(dest, '.git', MARK), `${marker.join('\\n')}\\n`);\n550: }\n551: \n552: // ───────────────────────────────────────────────────────────────\n553: // 10. ENTRY POINT\n554: // ───────────────────────────────────────────────────────────────\n555: \n556: function main(argv) {\n557:   const options = parseOptions(argv);\n558:   const source = resolve(options.source);\n559:   const dest = resolve(options.dest);\n560:   const head = headOf(source, 'source_not_repo');\n561: \n562:   if (pathExists(dest)) refuse('dest_exists', { dest });\n563:   if (isInsideRepository(nearestExistingAncestor(dirname(dest)))) refuse('dest_in_repo', { dest });\n564: \n565:   // An uncommitted edit also makes its build read stale, so the tree is checked\n566:   // before the builds, and both run before anything is copied. A source check reads\n567:   // the worktree itself, so a folder it cannot read has to end the run the way a\n568:   // failed step does rather than as a stack trace a caller cannot read.\n569:   let copied;\n570:   let trackedDotenv;\n571:   try {\n572:     const changes = sourceChanges(source);\n573:     if (changes.length > 0) refuse('source_dirty', { paths: changes.slice(0, 10) });\n574: \n575:     copied = copyPlan(source);\n576:     const stale = staleBuilds(source, copied);\n577:     if (stale.length > 0) refuse('stale_build', { stale });\n578: \n579:     const escaping = escapingLinks(source, copied);\n580:     if (escaping.length > 0) refuse('symlink_escape', { links: escaping });\n581: \n582:     trackedDotenv = trackedDotenvFiles(source);\n583:   } catch (error) {\n584:     abort(error.code ?? 'arena_failed', error.message);\n585:   }\n586: \n587:   mkdirSync(dirname(dest), { recursive: true });\n588:   try {\n589:     buildArena(source, dest, head, copied, trackedDotenv);\n590:     writeJson({ ok: true, dest, head, copied, ...(trackedDotenv.length > 0 ? { trackedDotenv } : {}) });\n591:   } catch (error) {\n592:     // A half-built arena would answer the next call with `dest_exists` while\n593:     // holding a checkout nobody finished, so the failed attempt removes itself.\n594:     rmSync(dest, { recursive: true, force: true });\n595:     abort(error.code ?? 'arena_failed', error.message);\n596:   }\n597: }\n598: \n599: // The marker name is exported for the tests that write it, so the CLI runs only\n600: // when this file is the entry point. An imported module that parsed the host's\n601: // argv would refuse on flags it never received. The entry path is compared after\n602: // resolving links, because Node names a linked entry by its real path.\n603: const invokedDirectly = (() => {\n604:   if (typeof process.argv[1] !== 'string') return false;\n605:   try {\n606:     return realpathSync(process.argv[1]) === realpathSync(fileURLToPath(import.meta.url));\n607:   } catch {\n608:     return false;\n609:   }\n610: })();\n611: \n612: if (invokedDirectly) {\n613:   main(process.argv.slice(2));\n614: }","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file .skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/prepare-behaviour-arena.mjs, lines 1-614\n1: // ───────────────────────────────────────────────────────────────\n2: // MODULE: Behaviour Arena Builder\n3: // ───────────────────────────────────────────────────────────────\n4: //\n5: // A live turn has to run where the advisor it measures is built the way a user\n6: // gets it. A clone of the branch tip in a directory git does not own gives that\n7: // and takes the outside world's handles away. It has no remote, so a turn has\n8: // nothing to push to by name, and no outer repository whose hooks or credentials\n9: // it could borrow. Its tracked tree is exactly the commit under test, so a\n10: // per-turn restore has a clean baseline to put back. What the clone does not\n11: // take away is the filesystem, since a turn can still read and write anywhere\n12: // its user can by absolute path.\n13: //\n14: // A clone also leaves out every ignored build output. The advisor under test\n15: // runs from compiled JavaScript and its SQLite skill graph, so those trees are\n16: // copied in afterwards. Building them inside the clone instead would measure a\n17: // bundle nobody reviewed, and would need the network while an arena is meant to\n18: // be offline.\n19: //\n20: // A copy also has to look like a build. The freshness guard each CLI shim runs\n21: // falls back to comparing the newest watched source against the build's own\n22: // timestamp, and a checkout stamps every source with the clone time while the\n23: // copied build keeps the moment it was compiled. Left alone, that order says\n24: // every copied package is stale and every shim exits before running. The copied\n25: // build is the same commit's build, so its timestamp is set to the copy time,\n26: // which is what a build in this checkout would carry.\n27: //\n28: // Nothing is copied before the destination is checked. A destination inside a\n29: // repository would inherit that repository's hooks and ignore rules, and a\n30: // destination that already exists may hold another arm's log, so both are\n31: // refused rather than merged into.\n32: //\n33: // The copy reads the source worktree, so the one thing it must never carry\n34: // across is a dotenv file. A model reads and writes an arena, so a secret that\n35: // followed the build output in would sit where a run can print it. Every file\n36: // whose name begins with `.env` is skipped while copying the build trees, at\n37: // every depth. A clone brings every tracked file, so a dotenv file in the commit\n38: // is already in the arena, and the output and the marker name it instead.\n39: //\n40: // Usage:\n41: //   node prepare-behaviour-arena.mjs --source <repo root> --dest <dir>\n42: \n43: // ───────────────────────────────────────────────────────────────\n44: // 1. IMPORTS\n45: // ───────────────────────────────────────────────────────────────\n46: \n47: import { appendFileSync, existsSync, lstatSync, lutimesSync, mkdirSync, readFileSync, readdirSync, readlinkSync, realpathSync, rmSync, utimesSync, writeFileSync } from 'node:fs';\n48: import { spawnSync } from 'node:child_process';\n49: import { basename, dirname, isAbsolute, join, relative, resolve, sep } from 'node:path';\n50: import { fileURLToPath } from 'node:url';\n51: \n52: // ───────────────────────────────────────────────────────────────\n53: // 2. CONSTANTS\n54: // ───────────────────────────────────────────────────────────────\n55: \n56: const SCRIPT_NAME = basename(fileURLToPath(import.meta.url));\n57: const EXIT_REFUSED = 2;\n58: \n59: const USAGE = `usage: node ${SCRIPT_NAME} --source <repo root> --dest <dir>`;\n60: \n61: // A filesystem monitor that decides a path is unchanged makes the clone and the\n62: // clean-tree check disagree about what the checkout holds.\n63: const GIT_PREFIX = ['-c', 'core.fsmonitor=false'];\n64: \n65: export const MARK = 'skilled-behaviour-arena';\n66: \n67: // The two ignored trees a build writes and a clone never carries.\n68: const BUILD_DIR_NAMES = new Set(['dist', 'node_modules']);\n69: \n70: const SQLITE_SUFFIX = '.sqlite';\n71: const SKILLED_PREFIX = '.skilled/';\n72: const DOTENV_PATTERN = /^\\.env/;\n73: \n74: // ───────────────────────────────────────────────────────────────\n75: // 3. FAILURE SHAPES\n76: // ───────────────────────────────────────────────────────────────\n77: \n78: // A refusal is a precondition the caller can act on, so it carries a code on\n79: // stdout. A step failure leaves no usable arena behind, so it reports the code\n80: // and the failing command on stderr instead.\n81: class StepFailure extends Error {\n82:   constructor(code, detail) {\n83:     super(detail === '' ? code : `${code}: ${detail}`);\n84:     this.code = code;\n85:   }\n86: }\n87: \n88: function writeJson(value) {\n89:   process.stdout.write(`${JSON.stringify(value)}\\n`);\n90: }\n91: \n92: function refuse(code, extra = {}) {\n93:   writeJson({ ok: false, code, ...extra });\n94:   process.exit(EXIT_REFUSED);\n95: }\n96: \n97: function abort(code, detail = '') {\n98:   process.stderr.write(`${SCRIPT_NAME}: ${detail === '' ? code : `${code}: ${detail}`}\\n`);\n99:   writeJson({ ok: false, code });\n100:   process.exit(1);\n101: }\n102: \n103: // ───────────────────────────────────────────────────────────────\n104: // 4. ARGUMENT PARSING\n105: // ───────────────────────────────────────────────────────────────\n106: \n107: function valueAfter(argv, index, flag) {\n108:   const value = argv[index];\n109:   if (value === undefined || value.startsWith('--')) {\n110:     process.stderr.write(`${SCRIPT_NAME}: ${flag} needs a value\\n${USAGE}\\n`);\n111:     process.exit(EXIT_REFUSED);\n112:   }\n113:   return value;\n114: }\n115: \n116: function parseOptions(argv) {\n117:   const options = { source: null, dest: null };\n118:   for (let index = 0; index < argv.length; index += 1) {\n119:     const token = argv[index];\n120:     if (token === '--source') {\n121:       index += 1;\n122:       options.source = valueAfter(argv, index, '--source');\n123:     } else if (token === '--dest') {\n124:       index += 1;\n125:       options.dest = valueAfter(argv, index, '--dest');\n126:     } else {\n127:       process.stderr.write(`${SCRIPT_NAME}: unknown option: ${token}\\n${USAGE}\\n`);\n128:       process.exit(EXIT_REFUSED);\n129:     }\n130:   }\n131:   if (options.source === null || options.dest === null) {\n132:     process.stderr.write(`${SCRIPT_NAME}: --source and --dest are required\\n${USAGE}\\n`);\n133:     process.exit(EXIT_REFUSED);\n134:   }\n135:   return options;\n136: }\n137: \n138: // ───────────────────────────────────────────────────────────────\n139: // 5. GIT HELPERS\n140: // ───────────────────────────────────────────────────────────────\n141: \n142: // A whole-repository listing passes the 1 MiB buffer a spawnSync call starts with,\n143: // so every git call gets room for the largest tree a source may hold.\n144: function git(args, cwd) {\n145:   const result = spawnSync('git', [...GIT_PREFIX, ...args], {\n146:     cwd,\n147:     encoding: 'utf8',\n148:     maxBuffer: 512 * 1024 * 1024,\n149:   });\n150:   if (result.error) throw new StepFailure('spawn_failed', result.error.message);\n151:   return result;\n152: }\n153: \n154: function gitText(args, cwd, code) {\n155:   const result = git(args, cwd);\n156:   if (result.status !== 0) throw new StepFailure(code, (result.stderr ?? '').trim());\n157:   return result.stdout;\n158: }\n159: \n160: function headOf(cwd, code) {\n161:   const head = gitText(['rev-parse', 'HEAD'], cwd, code).trim();\n162:   if (head === '') throw new StepFailure(code, `no HEAD in ${cwd}`);\n163:   return head;\n164: }\n165: \n166: // Whether git would leave a path out of a checkout decides whether a clone\n167: // already holds it, so ignore rules are asked rather than guessed from a name.\n168: function isIgnored(cwd, relPath) {\n169:   return git(['check-ignore', '-q', '--', relPath], cwd).status === 0;\n170: }\n171: \n172: // ───────────────────────────────────────────────────────────────\n173: // 6. DESTINATION CHECKS\n174: // ───────────────────────────────────────────────────────────────\n175: \n176: function pathExists(path) {\n177:   try {\n178:     lstatSync(path);\n179:     return true;\n180:   } catch {\n181:     return false;\n182:   }\n183: }\n184: \n185: function nearestExistingAncestor(path) {\n186:   let current = path;\n187:   while (!existsSync(current) && dirname(current) !== current) current = dirname(current);\n188:   return current;\n189: }\n190: \n191: function isInsideRepository(path) {\n192:   return git(['rev-parse', '--show-toplevel'], path).status === 0;\n193: }\n194: \n195: // ───────────────────────────────────────────────────────────────\n196: // 7. SOURCE CHECKS\n197: // ───────────────────────────────────────────────────────────────\n198: \n199: // A clone carries the commit and nothing else, so a changed or untracked path is\n200: // what the arena would silently not measure.\n201: function sourceChanges(source) {\n202:   return gitText(['status', '--porcelain'], source, 'source_status_unreadable')\n203:     .split('\\n')\n204:     .filter((line) => line !== '')\n205:     .map((line) => line.slice(3));\n206: }\n207: \n208: function newestFileTime(path) {\n209:   let newest = 0;\n210:   for (const entry of readdirSync(path, { withFileTypes: true })) {\n211:     const child = join(path, entry.name);\n212:     if (entry.isDirectory()) {\n213:       newest = Math.max(newest, newestFileTime(child));\n214:       continue;\n215:     }\n216:     newest = Math.max(newest, lstatSync(child).mtimeMs);\n217:   }\n218:   return newest;\n219: }\n220: \n221: // The guard a CLI shim runs compares a build with the newest watched source, so a\n222: // build's inputs are the folder that holds it and, where a tsconfig beside it names\n223: // sources above, the folders those includes reach. The build has to be at least as\n224: // new as the newest tracked file in every one of them.\n225: function newestTrackedTime(source, folder) {\n226:   const prefix = folder === '.' ? '' : `${folder}/`;\n227:   const tracked = gitText(['ls-files', '-z', '--', folder], source, 'tracked_files_unreadable')\n228:     .split('\\0')\n229:     .filter(\n230:       (relPath) =>\n231:         relPath !== '' &&\n232:         !relPath.startsWith(`${prefix}dist/`) &&\n233:         !relPath.startsWith(`${prefix}node_modules/`),\n234:     );\n235:   let newest = 0;\n236:   for (const relPath of tracked) newest = Math.max(newest, lstatSync(join(source, relPath)).mtimeMs);\n237:   return newest;\n238: }\n239: \n240: // A tsconfig is read by the compiler with `//` and `/* */` comments allowed, so the\n241: // text is scanned here instead of being handed to JSON as it stands. A string is\n242: // copied through untouched, because one may hold `//` of its own.\n243: function stripJsonComments(text) {\n244:   let out = '';\n245:   let index = 0;\n246:   let inString = false;\n247:   while (index < text.length) {\n248:     const char = text[index];\n249:     if (inString) {\n250:       out += char;\n251:       if (char === '\\\\' && index + 1 < text.length) {\n252:         out += text[index + 1];\n253:         index += 2;\n254:         continue;\n255:       }\n256:       if (char === '\"') inString = false;\n257:       index += 1;\n258:       continue;\n259:     }\n260:     if (char === '\"') {\n261:       inString = true;\n262:       out += char;\n263:       index += 1;\n264:       continue;\n265:     }\n266:     if (char === '/' && text[index + 1] === '/') {\n267:       while (index < text.length && text[index] !== '\\n') index += 1;\n268:       continue;\n269:     }\n270:     if (char === '/' && text[index + 1] === '*') {\n271:       const end = text.indexOf('*/', index + 2);\n272:       index = end === -1 ? text.length : end + 2;\n273:       continue;\n274:     }\n275:     out += char;\n276:     index += 1;\n277:   }\n278:   return out;\n279: }\n280: \n281: // An include entry names files as patterns, and the folder a change can land in is\n282: // the path above the first segment holding a wildcard. Everything below that segment\n283: // names files, so nothing below it names a folder to watch.\n284: function includeFolder(entry) {\n285:   const segments = entry.split('/');\n286:   const first = segments.findIndex((segment) => /[*?{]/.test(segment));\n287:   return (first === -1 ? segments : segments.slice(0, first)).join('/');\n288: }\n289: \n290: // A build's inputs are its own folder, plus every folder a tsconfig beside it reaches\n291: // when an include entry climbs out of that folder. A tsconfig that cannot be read or\n292: // parsed adds nothing, because nothing then shows which files it would watch.\n293: function buildInputFolders(source, folder) {\n294:   const folders = [folder];\n295:   let names;\n296:   try {\n297:     names = readdirSync(join(source, folder));\n298:   } catch {\n299:     return folders;\n300:   }\n301:   const root = realpathSync(source);\n302:   const own = resolve(root, folder);\n303:   const ownPrefix = `${own}${sep}`;\n304:   for (const name of names.sort()) {\n305:     if (!/^tsconfig.*\\.json$/.test(name)) continue;\n306:     let include;\n307:     try {\n308:       include = JSON.parse(stripJsonComments(readFileSync(join(source, folder, name), 'utf8'))).include;\n309:     } catch {\n310:       continue;\n311:     }\n312:     if (!Array.isArray(include)) continue;\n313:     for (const entry of include) {\n314:       if (typeof entry !== 'string') continue;\n315:       const prefix = includeFolder(entry);\n316:       if (prefix === '') continue;\n317:       const reached = resolve(root, folder, prefix);\n318:       if (reached === own || reached.startsWith(ownPrefix)) continue;\n319:       const fromRoot = relative(root, reached);\n320:       if (isAbsolute(fromRoot) || fromRoot === '..' || fromRoot.startsWith(`..${sep}`)) continue;\n321:       const relFolder = fromRoot === '' ? '.' : fromRoot.split(sep).join('/');\n322:       if (!folders.includes(relFolder)) folders.push(relFolder);\n323:     }\n324:   }\n325:   return folders;\n326: }\n327: \n328: // One refusal lists every stale build, so a single rebuild round clears the tree\n329: // instead of one refusal per build.\n330: function staleBuilds(source, copied) {\n331:   const stale = [];\n332:   for (const relPath of copied) {\n333:     if (basename(relPath) !== 'dist') continue;\n334:     const folder = dirname(relPath);\n335:     const buildTime = newestFileTime(join(source, relPath));\n336:     const sourceTime = buildInputFolders(source, folder).reduce(\n337:       (newest, inputFolder) => Math.max(newest, newestTrackedTime(source, inputFolder)),\n338:       0,\n339:     );\n340:     if (buildTime >= sourceTime) continue;\n341:     stale.push({\n342:       path: relPath,\n343:       source: new Date(sourceTime).toISOString(),\n344:       build: new Date(buildTime).toISOString(),\n345:     });\n346:   }\n347:   return stale;\n348: }\n349: \n350: // A copied build tree can hold a link whose target sits outside the checkout, and\n351: // copying the link would bring that data into the arena where a run can read it.\n352: // A link is allowed only when it already resolves inside the source, so a dangling\n353: // link is refused too because nothing shows where it would land. A link written as\n354: // an absolute path is refused even when it resolves inside the source, because the\n355: // copy keeps its text and it would still name the source instead of the arena it\n356: // sits in. The walk reads the trees a clone never carries, which is where such a\n357: // link can hide.\n358: function escapingLinks(source, copied) {\n359:   const root = realpathSync(source);\n360:   const escapes = [];\n361:   const visit = (relPath) => {\n362:     for (const entry of readdirSync(join(source, relPath), { withFileTypes: true })) {\n363:       const childRel = `${relPath}/${entry.name}`;\n364:       const childPath = join(source, childRel);\n365:       if (entry.isSymbolicLink()) {\n366:         let target = null;\n367:         try {\n368:           target = realpathSync(childPath);\n369:         } catch {\n370:           escapes.push({ path: childRel, target: null });\n371:           continue;\n372:         }\n373:         const fromRoot = relative(root, target);\n374:         const outside = isAbsolute(fromRoot) || fromRoot === '..' || fromRoot.startsWith(`..${sep}`);\n375:         if (outside || isAbsolute(readlinkSync(childPath))) escapes.push({ path: childRel, target });\n376:         continue;\n377:       }\n378:       if (entry.isDirectory()) visit(childRel);\n379:     }\n380:   };\n381:   for (const relPath of copied) {\n382:     if (lstatSync(join(source, relPath)).isDirectory()) visit(relPath);\n383:   }\n384:   return escapes;\n385: }\n386: \n387: // ───────────────────────────────────────────────────────────────\n388: // 8. COPY PLAN\n389: // ───────────────────────────────────────────────────────────────\n390: \n391: // One walk of the source decides what a clone is missing. A build directory is\n392: // recorded and not descended into, so anything inside it travels with the tree.\n393: // The SQLite files searched for sit under the tooling root only, because that is\n394: // where the advisor keeps its graph.\n395: function copyPlan(source) {\n396:   const trees = [];\n397:   const sqlite = [];\n398:   const walk = (relPath) => {\n399:     const absPath = relPath === '' ? source : join(source, relPath);\n400:     for (const entry of readdirSync(absPath, { withFileTypes: true })) {\n401:       if (entry.name === '.git') continue;\n402:       const childRel = relPath === '' ? entry.name : `${relPath}/${entry.name}`;\n403:       if (entry.isDirectory()) {\n404:         if (BUILD_DIR_NAMES.has(entry.name)) {\n405:           trees.push(childRel);\n406:           continue;\n407:         }\n408:         walk(childRel);\n409:         continue;\n410:       }\n411:       if (entry.isFile() && entry.name.endsWith(SQLITE_SUFFIX) && childRel.startsWith(SKILLED_PREFIX)) {\n412:         sqlite.push(childRel);\n413:       }\n414:     }\n415:   };\n416:   walk('');\n417:   return [...trees, ...sqlite].filter((relPath) => isIgnored(source, relPath)).sort();\n418: }\n419: \n420: // A tracked dotenv file is already in the commit, so a clone carries it and the\n421: // copy below never sees it. Naming it is what tells the operator the arena holds\n422: // one, and the commit already published it to anyone who clones.\n423: function trackedDotenvFiles(source) {\n424:   return gitText(['ls-files', '-z'], source, 'tracked_files_unreadable')\n425:     .split('\\0')\n426:     .filter((relPath) => relPath !== '' && DOTENV_PATTERN.test(basename(relPath)));\n427: }\n428: \n429: function holdsDotenv(dirPath) {\n430:   for (const entry of readdirSync(dirPath, { withFileTypes: true })) {\n431:     if (DOTENV_PATTERN.test(entry.name)) return true;\n432:     if (entry.isDirectory() && holdsDotenv(join(dirPath, entry.name))) return true;\n433:   }\n434:   return false;\n435: }\n436: \n437: // The clonefile flag copies a file's blocks instead of its bytes, and only the\n438: // macOS `cp` has it, so the platform picks the list rather than assuming every\n439: // `cp` accepts the flag.\n440: export function copyArgs(platform) {\n441:   return platform === 'darwin' ? ['-Rc'] : ['-R'];\n442: }\n443: \n444: function runCp(sourcePath, destParent) {\n445:   const result = spawnSync('cp', [...copyArgs(process.platform), sourcePath, destParent], { encoding: 'utf8' });\n446:   if (result.error) throw new StepFailure('copy_failed', `${sourcePath}: ${result.error.message}`);\n447:   if (result.status !== 0) throw new StepFailure('copy_failed', `${sourcePath}: ${(result.stderr ?? '').trim()}`);\n448: }\n449: \n450: // A symlink is stamped through the link itself, because its target may live\n451: // outside the arena and is not this copy's to change.\n452: function stampPath(path, time) {\n453:   if (lstatSync(path).isSymbolicLink()) {\n454:     lutimesSync(path, time, time);\n455:     return;\n456:   }\n457:   utimesSync(path, time, time);\n458: }\n459: \n460: // Only a build tree is stamped. The guard reads the timestamp of a dist entry,\n461: // and neither a dependency tree nor a database file is watched.\n462: function stampBuildTree(path) {\n463:   const time = new Date();\n464:   for (const entry of readdirSync(path, { withFileTypes: true })) {\n465:     const child = join(path, entry.name);\n466:     if (entry.isDirectory()) stampBuildTree(child);\n467:     else stampPath(child, time);\n468:   }\n469:   stampPath(path, time);\n470: }\n471: \n472: // The clonefile flag is macOS only, and on the same volume it keeps the copy\n473: // cheap. The walk only happens where a dotenv file is actually present, so the\n474: // common tree is one `cp` call rather than one call per file.\n475: function copyPath(sourcePath, destPath) {\n476:   const isDirectory = lstatSync(sourcePath).isDirectory();\n477:   if (!isDirectory || !holdsDotenv(sourcePath)) {\n478:     mkdirSync(dirname(destPath), { recursive: true });\n479:     runCp(sourcePath, dirname(destPath));\n480:     return;\n481:   }\n482:   mkdirSync(destPath, { recursive: true });\n483:   for (const entry of readdirSync(sourcePath, { withFileTypes: true })) {\n484:     if (DOTENV_PATTERN.test(entry.name)) continue;\n485:     copyPath(join(sourcePath, entry.name), join(destPath, entry.name));\n486:   }\n487: }\n488: \n489: // ───────────────────────────────────────────────────────────────\n490: // 9. ARENA BUILD\n491: // ───────────────────────────────────────────────────────────────\n492: \n493: function cloneInto(source, dest) {\n494:   const result = git(['clone', '--no-hardlinks', source, dest], process.cwd());\n495:   if (result.status !== 0) throw new StepFailure('clone_failed', (result.stderr ?? '').trim());\n496: }\n497: \n498: function checkoutDetached(dest, head) {\n499:   const result = git(['checkout', '--quiet', '--detach', head], dest);\n500:   if (result.status !== 0) throw new StepFailure('checkout_failed', (result.stderr ?? '').trim());\n501: }\n502: \n503: // A remote is the one piece of git state a turn could use to reach outside the\n504: // checkout, so every one the clone inherits is removed rather than left dormant.\n505: function removeRemotes(dest) {\n506:   const names = gitText(['remote'], dest, 'remote_unreadable')\n507:     .split('\\n')\n508:     .map((name) => name.trim())\n509:     .filter((name) => name !== '');\n510:   for (const name of names) gitText(['remote', 'remove', name], dest, 'remote_unreadable');\n511: }\n512: \n513: function assertHead(dest, head) {\n514:   const cloned = gitText(['rev-parse', 'HEAD'], dest, 'head_unreadable').trim();\n515:   if (cloned !== head) throw new StepFailure('head_mismatch', `expected ${head}, got ${cloned}`);\n516: }\n517: \n518: // Claude Code reads CLAUDE.md and not AGENTS.md, so the arena imports its own\n519: // rules, and the exclude line keeps the clean-tree check and the head unchanged.\n520: function writeClaudePointer(dest) {\n521:   const pointerPath = join(dest, 'CLAUDE.md');\n522:   if (existsSync(pointerPath)) return;\n523:   writeFileSync(pointerPath, '@AGENTS.md\\n');\n524:   mkdirSync(join(dest, '.git', 'info'), { recursive: true });\n525:   appendFileSync(join(dest, '.git', 'info', 'exclude'), '/CLAUDE.md\\n');\n526: }\n527: \n528: function buildArena(source, dest, head, copied, trackedDotenv) {\n529:   cloneInto(source, dest);\n530:   checkoutDetached(dest, head);\n531:   removeRemotes(dest);\n532:   for (const relPath of copied) {\n533:     const destPath = join(dest, relPath);\n534:     copyPath(join(source, relPath), destPath);\n535:     if (basename(relPath) === 'dist') stampBuildTree(destPath);\n536:   }\n537:   assertHead(dest, head);\n538:   writeClaudePointer(dest);\n539:   // The runner refuses a live arm in a checkout without this file, because only a\n540:   // checkout built here has no remote, no outer repository and no dotenv file in\n541:   // its copied build trees. The lines after the head record what the source checks\n542:   // found and when each copied build was compiled.\n543:   const marker = [head, 'source clean'];\n544:   for (const relPath of copied) {\n545:     if (basename(relPath) !== 'dist') continue;\n546:     marker.push(`built ${relPath} ${new Date(newestFileTime(join(source, relPath))).toISOString()}`);\n547:   }\n548:   for (const relPath of trackedDotenv) marker.push(`tracked-dotenv ${relPath}`);\n549:   writeFileSync(join(dest, '.git', MARK), `${marker.join('\\n')}\\n`);\n550: }\n551: \n552: // ───────────────────────────────────────────────────────────────\n553: // 10. ENTRY POINT\n554: // ───────────────────────────────────────────────────────────────\n555: \n556: function main(argv) {\n557:   const options = parseOptions(argv);\n558:   const source = resolve(options.source);\n559:   const dest = resolve(options.dest);\n560:   const head = headOf(source, 'source_not_repo');\n561: \n562:   if (pathExists(dest)) refuse('dest_exists', { dest });\n563:   if (isInsideRepository(nearestExistingAncestor(dirname(dest)))) refuse('dest_in_repo', { dest });\n564: \n565:   // An uncommitted edit also makes its build read stale, so the tree is checked\n566:   // before the builds, and both run before anything is copied. A source check reads\n567:   // the worktree itself, so a folder it cannot read has to end the run the way a\n568:   // failed step does rather than as a stack trace a caller cannot read.\n569:   let copied;\n570:   let trackedDotenv;\n571:   try {\n572:     const changes = sourceChanges(source);\n573:     if (changes.length > 0) refuse('source_dirty', { paths: changes.slice(0, 10) });\n574: \n575:     copied = copyPlan(source);\n576:     const stale = staleBuilds(source, copied);\n577:     if (stale.length > 0) refuse('stale_build', { stale });\n578: \n579:     const escaping = escapingLinks(source, copied);\n580:     if (escaping.length > 0) refuse('symlink_escape', { links: escaping });\n581: \n582:     trackedDotenv = trackedDotenvFiles(source);\n583:   } catch (error) {\n584:     abort(error.code ?? 'arena_failed', error.message);\n585:   }\n586: \n587:   mkdirSync(dirname(dest), { recursive: true });\n588:   try {\n589:     buildArena(source, dest, head, copied, trackedDotenv);\n590:     writeJson({ ok: true, dest, head, copied, ...(trackedDotenv.length > 0 ? { trackedDotenv } : {}) });\n591:   } catch (error) {\n592:     // A half-built arena would answer the next call with `dest_exists` while\n593:     // holding a checkout nobody finished, so the failed attempt removes itself.\n594:     rmSync(dest, { recursive: true, force: true });\n595:     abort(error.code ?? 'arena_failed', error.message);\n596:   }\n597: }\n598: \n599: // The marker name is exported for the tests that write it, so the CLI runs only\n600: // when this file is the entry point. An imported module that parsed the host's\n601: // argv would refuse on flags it never received. The entry path is compared after\n602: // resolving links, because Node names a linked entry by its real path.\n603: const invokedDirectly = (() => {\n604:   if (typeof process.argv[1] !== 'string') return false;\n605:   try {\n606:     return realpathSync(process.argv[1]) === realpathSync(fileURLToPath(import.meta.url));\n607:   } catch {\n608:     return false;\n609:   }\n610: })();\n611: \n612: if (invokedDirectly) {\n613:   main(process.argv.slice(2));\n614: }"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\".skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/prepare-behaviour-arena.mjs\"}"},"time":{"start":1794815734109,"end":1794815734415}}}}
