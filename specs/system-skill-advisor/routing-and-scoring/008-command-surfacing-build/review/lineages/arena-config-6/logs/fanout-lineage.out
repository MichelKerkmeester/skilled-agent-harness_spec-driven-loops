eview/lineages/arena-config-6/deep-review-findings-registry.json\",\n  \"dashboardPath\": \"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/specs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/review/lineages/arena-config-6/deep-review-dashboard.md\",\n  \"strategyPath\": \"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/specs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/review/lineages/arena-config-6/deep-review-strategy.md\",\n  \"openFindingsCount\": 2,\n  \"resolvedFindingsCount\": 0,\n  \"convergenceScore\": 0,\n  \"graphConvergenceScore\": 0,\n  \"searchDebtCount\": 0,\n  \"corruptionCount\": 0,\n  \"strategyWarning\": null,\n  \"resourceMapPath\": null,\n  \"resourceMapSkipped\": null,\n  \"resourceMapSkipReason\": null\n}\nREDUCE_EXIT=0\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"node .skilled/skills/system-deep-loop/runtime/scripts/reduce-state.cjs specs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build --artifact-dir specs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/review/lineages/arena-config-6 --create-missing-anchors; echo \\\"REDUCE_EXIT=$?\\\"\"}"},"time":{"start":1794816725736,"end":1794816726488}}}}
