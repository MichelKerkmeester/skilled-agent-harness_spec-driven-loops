Mode) || \"default\"),\n      reviewModeContractDigest: sha(fs.readFileSync(workflowPath)),\n      initialReleaseReadinessState: \"not-assessed\",\n      ...(topic === null ? {} : { topic }),\n    },\n  }));\n' deep-review-config.json .skilled/commands/deep/assets/deep-review.yaml \"$EVENT_FILE\" && node \"$GATEWAY\" --mode review --run-directory . --event-json \"$EVENT_FILE\"; echo \"GATEWAY_EXIT=$?\""},"output":"node:fs:782\n  return binding.open(\n                 ^\n\nError: ENOENT: no such file or directory, open '.skilled/commands/deep/assets/deep-review.yaml'\n    at Object.openSync (node:fs:782:18)\n    at Object.readFileSync (node:fs:628:35)\n    at [eval]:18:40\n    at [eval]:23:4\n    at runScriptInThisContext (node:internal/vm:219:10)\n    at node:internal/process/execution:485:12\n    at [eval]-wrapper:6:24\n    at runScriptInContext (node:internal/process/execution:483:60)\n    at evalFunction (node:internal/process/execution:317:30)\n    at evalTypeScript (node:internal/process/execution:329:3) {\n  errno: -2,\n  code: 'ENOENT',\n  syscall: 'open',\n  path: '.skilled/commands/deep/assets/deep-review.yaml'\n}\n\nNode.js v26.13.0\nGATEWAY_EXIT=1\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"node:fs:782\n  return binding.open(\n                 ^\n\nError: ENOENT: no such file or directory, open '.skilled/commands/deep/assets/deep-review.yaml'\n    at Object.openSync (node:fs:782:18)\n    at Object.readFileSync (node:fs:628:35)\n    at [eval]:18:40\n    at [eval]:23:4\n    at runScriptInThisContext (node:internal/vm:219:10)\n    at node:internal/process/execution:485:12\n    at [eval]-wrapper:6:24\n    at runScriptInContext (node:internal/process/execution:483:60)\n    at evalFunction (node:internal/process/execution:317:30)\n    at evalTypeScript (node:internal/process/execution:329:3) {\n  errno: -2,\n  code: 'ENOENT',\n  syscall: 'open',\n  path: '.skilled/commands/deep/as