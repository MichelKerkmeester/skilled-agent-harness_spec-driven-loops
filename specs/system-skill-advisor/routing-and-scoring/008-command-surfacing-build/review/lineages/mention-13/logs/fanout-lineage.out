se /create:readme', '/create:readme', false],\\n  ['never mind just run /speckit:save', '/speckit:save', false],\\n  ['without asking, run /speckit:complete', '/speckit:complete', false],\\n  [\\\"don't skip it, run /speckit:save\\\", '/speckit:save', false],\\n  [\\\"run /speckit:save and don't forget to run it\\\", '/speckit:save', false],\\n];\\nlet bad = 0;\\nfor (const [p, c, expected] of rows) {\\n  const got = commandOnlyMentioned(p, c);\\n  if (got !== expected) { bad++; console.log('MISMATCH', JSON.stringify({ p, c, expected, got })); }\\n}\\nconsole.log(JSON.stringify({ checked: rows.length, mismatches: bad,\\n  typedF001: typedCommandForTop('system-deep-loop', 'open the /deep:review command file, then run it') ?? null,\\n  typedF002: typedCommandForTop('system-spec-kit', \\\"run /speckit:save and don't run it twice\\\") ?? null,\\n  attachDocThenRequest: attachCommand('system-deep-loop', { action: 'route', selectionKind: 'single', targets: [{ workflowMode: 'review' }] }, 'read the /deep:review docs, then do a thorough review of this diff') ?? null }));\\nEOF\"}"},"time":{"start":1794866864302,"end":1794866868757}}}}
