duce-state.cjs specs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build --artifact-dir \\\"$L\\\" --create-missing-anchors | rg 'openFindingsCount|convergenceScore' && node -e '\\nconst r = require(\\\"./\\\"+process.argv[1]);\\nconsole.log(JSON.stringify({severity:r.findingsBySeverity, ids:(r.openFindings||[]).map(f=>f.findingId)}));\\n' \\\"$L/deep-review-findings-registry.json\\\"\"}"},"time":{"start":1794866595761,"end":1794866599224}}}}
