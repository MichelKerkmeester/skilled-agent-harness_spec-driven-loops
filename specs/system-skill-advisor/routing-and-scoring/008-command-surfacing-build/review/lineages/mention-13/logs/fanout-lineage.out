t only' }));\ndelta.push(JSON.stringify({ type: 'ruled_out', iteration: 2, direction: 'AC-004 as a mention-area regression', reason: 'the waiver belongs to ADR-001 and the data area, reviewed by data-13' }));\nfor (const g of rec.graphEvents) delta.push(JSON.stringify({ type: 'graph_event', iteration: 2, event: g }));\nfs.writeFileSync(L + '/deltas/iter-002.jsonl', delta.join('\\n') + '\\n');\nconst nodes = rec.graphEvents.filter(e => e.type === 'node').map(e => ({ id: e.id, kind: e.kind, name: e.label, iteration: 2 }));\nconst edges = rec.graphEvents.filter(e => e.type === 'edge').map(e => ({ id: e.id, sourceId: e.source, targetId: e.target, relation: e.relation }));\nfs.writeFileSync(L + '/iter-002.nodes.json', JSON.stringify(nodes));\nfs.writeFileSync(L + '/iter-002.edges.json', JSON.stringify(edges));\nconsole.log(JSON.stringify({ timestamp: rec.timestamp, durationMs: rec.durationMs, deltaLines: delta.length, nodes: nodes.length, edges: edges.length }));\nEOF\nL=specs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/review/lineages/mention-13 && node .skilled/skills/system-deep-loop/runtime/scripts/append-mode-event.cjs --mode review --run-directory \"$L\" --event-json \"$L/iter-002.event.json\"; echo \"EXIT=$?\""},"output":"{\"timestamp\":\"2026-11-16T21:58:59Z\",\"durationMs\":89517,\"deltaLines\":37,\"nodes\":11,\"edges\":12}\n{\"ok\":true,\"receipt\":{\"ledger_id\":\"deep-review-ledger\",\"sequence\":4,\"event_id\":\"event-c9c12f7c-f275-42d3-b0a3-24d9aa9e3876\",\"event_type\":\"deep-review.ledger.iteration-recorded\",\"event_version\":1,\"stream_id\":\"deep-review-ledger\",\"stream_sequence\":4,\"committed_at\":\"2026-11-16T21:59:00.104Z\",\"canonicalEventHash\":\"a4529d2d9e1fb5fabe15dfd8a7c43a15520febce56983cfdee33ccbf9a485002\",\"recordHash\":\"3fe1490c7620331640bdfde7bf003bd324198e2b63fa5c748d42aca13e9793ae\",\"authorizationRef\":{\"audit_ledger_id\":\"deep-review-audit-ledger\",\"audit_sequence\":5,\"audit_record_hash\":\"23f5ec821c0b