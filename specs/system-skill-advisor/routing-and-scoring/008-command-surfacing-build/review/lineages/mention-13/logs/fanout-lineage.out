{"type":"tool_use","timestamp":1794865337402,"sessionID":"ses_e19b0e5bfffeS7sVTvhEMa7jvO","part":{"partID":"prt_1e64f934d00271aOpCwJpaD1ew","sessionID":"ses_e19b0e5bfffeS7sVTvhEMa7jvO","messageID":"msg_1e64f78f8001am4eL3cWBhfWMO","type":"tool","id":"call_e6f8635298bd411a83906807","tool":"read","state":{"status":"completed","input":{"path":".skilled/commands/deep/assets/deep-review.yaml"},"output":"Read file .skilled/commands/deep/assets/deep-review.yaml, lines 1-764\n1: # ────────\n2: # DEEP REVIEW: DEEP REVIEW LOOP (AUTO AND CONFIRM MODES)\n3: # ────────\n4: # DEEP REVIEW: DEEP REVIEW LOOP (AUTO AND CONFIRM MODES)\n5: # ────────\n6: role: Deep Review Loop Manager\n7: purpose: Iterative code/spec review with convergence detection across review dimensions\n8: action: Run deep-review loop from initialization through synthesis\n9: operating_mode:\n10:   workflow: iterative_loop\n11:   workflow_compliance: MANDATORY\n12:   workflow_execution: autonomous\n13:   approvals: none\n14:   tracking: progressive_review_state\n15:   validation: convergence_detection\n16: \n17: # ────────\n18: # OPERATING PRINCIPLES\n19: # ────────\n20: operating_principles:\n21:   core: \"Fresh context per iteration + externalized state = no context degradation\"\n22:   approach: \"Dispatch focused review agent per dimension, evaluate convergence, repeat or stop\"\n23:   mandate: \"Never hold findings in memory; write everything to files. Review target is READ-ONLY.\"\n24: \n25: # ────────\n26: # EXECUTION MODE\n27: # ────────\n28: execution_mode:\n29:   source: \"$ARGUMENTS\"\n30:   values: [auto, confirm]\n31:   default: confirm\n32:   rule: \"Every step, executor branch and flag in this file runs in both modes. Under confirm, also execute every block marked applies_to: confirm at the place that carries it, and apply the mode_overrides.confirm wording. Under auto, skip every block marked applies_to: confirm and keep the autonomous wording of this file.\"\n33: mode_overrides:\n34:   confirm:\n35:     purpose: \"Iterative code/spec review with convergence detection and user approval gates\"\n36:     action: \"Run deep-review loop with user confirmation at each phase transition\"\n37:     workflow_execution: \"interactive\"\n38:     approvals: \"multi_gate\"\n39:     approach: \"Dispatch focused review agent per dimension, show results, get approval, repeat or stop\"\n40:     mandate: \"Never hold findings in memory; write everything to files. Pause for user at each gate. Review target is READ-ONLY.\"\n41:     phase_loop_purpose: \"Dispatch review agent iterations with approval at each step\"\n42:     lock_not_acquired: \"If acquired=false, stop and present recovery choices: another deep-review run already holds this packet.\"\n43:     agent_dispatch_timeout: \"Retry once with reduced scope. If second timeout, mark as 'timeout' and show to user for decision.\"\n44:     continuity_save_failure: \"Preserve the review packet in review/ as backup. Inform user.\"\n45:     rules_always: [pause_at_approval_gates, present_clear_options_at_each_gate]\n46:     rules_never: [proceed_past_approval_gate_without_user_response, auto_approve_on_behalf_of_user]\n47: \n48: # ────────\n49: # USER INPUTS (from setup phase)\n50: # ────────\n51: user_inputs:\n52:   review_target: \"[REVIEW_TARGET] - What to review. REQUIRED.\"\n53:   review_target_type: \"[spec-folder|skill|agent|track|files] - Target type for scope derivation. REQUIRED.\"\n54:   review_dimensions: \"[all|correctness,security,traceability,maintainability] - Dimensions to check. Default: all.\"\n55:   review_focus: \"[optional free text] - Operator review focus that every iteration covers in addition to its dimension. Default: empty, which leaves the prompt unchanged.\"\n56:   spec_folder: \"[SPEC_FOLDER] - Spec folder path for state files. REQUIRED.\"\n57:   session_id: \"[SESSION_ID] - Optional caller-supplied session id for fan-out lineages. Default: timestamp.\"\n58:   lineage_mode: \"[auto|resume|restart] - Session lifecycle intent. Default: auto. The runtime only persists lineage events for `resume` (same sessionId, no archive) and `restart` (new sessionId, generation+1, prior review/ archived). `fork` and `completed-continue` are deferred and no longer accepted — see deep-review/references/protocol/loop-protocol.md §Lifecycle Branches.\"\n59:   max_iterations: 7\n60:   convergence_threshold: 0.10\n61:   convergence_mode: \"[default|off|sliding-window|divergent] - Convergence policy modifier. Default: default.\"\n62:   stop_policy: \"[convergence|max-iterations] - Stop behavior. Default: convergence. max-iterations treats convergence as telemetry until the hard iteration ceiling.\"\n63:   dry_run: \"[DRY_RUN] - Boolean pre-flight flag. Default: false.\"\n64:   lineage_timeout_hours: \"[LINEAGE_TIMEOUT_HOURS] - Optional per-lineage wall-clock ceiling in hours for fan-out runs, at most 4. Default: unset, which keeps the 4 hour ceiling.\"\n65:   config.fanout_lineage_artifact_dir: \"[optional internal path] - Fan-out lineage artifact override for command-owned single-lineage execution.\"\n66: \n67: # ────────\n68: # DRY-RUN CONTROL\n69: # ────────\n70: dry_run_control:\n71:   enabled_when: \"dry_run == true\"\n72:   default: false\n73:   modes: [auto, confirm]\n74:   purpose: \"Run safe setup and read-only inspection, then stop before side effects.\"\n75:   safe_operations:\n76:     - \"Resolve setup inputs and artifact roots.\"\n77:     - \"Read current state, strategy, focus, and convergence signals.\"\n78:     - \"Render the next prompt to terminal preview without writing prompt files.\"\n79:   forbidden_operations:\n80:     - \"Executor dispatch.\"\n81:     - \"Persistent state, queue, lock, git index, memory, or graph mutation.\"\n82:     - \"Reducer refresh or generated artifact writes.\"\n83:     - \"Child-lineage spawn.\"\n84:   event_policy:\n85:     event_name: dry_run_halt\n86:     sink: \"terminal JSONL preview only; never append to {state_paths.state_log}\"\n87:     required_fields: [type, event, mode, boundary, step, timestamp]\n88:     optional_fields: [run, sessionId, generation, detail]\n89:     default_halt_event: '{\"type\":\"event\",\"event\":\"dry_run_halt\",\"mode\":\"review\",\"boundary\":\"{dry_run_boundary}\",\"step\":\"{step_name}\",\"timestamp\":\"{ISO_8601_NOW}\"}'\n90:     preview_only: \"A step or branch marked dry_run_event_policy: preview-only still runs its read and classify work. It prints the event it would append as a terminal JSONL preview line and appends nothing.\"\n91:   halt_hook_rule: \"Before executing any command, dispatch, edit, output, template write, append_to_jsonl, append_jsonl, log_event, mcp_tool, write, or git-index mutation in a step tagged with dry_run_boundary, emit event_policy.default_halt_event with that step's name and boundary to the terminal and halt. This holds in both execution modes.\"\n92:   boundary_labels:\n93:     child_spawn: \"child-spawn\"\n94:     state_mutation: \"state-mutation\"\n95:     dispatch: \"dispatch\"\n96:     reducer_refresh: \"reducer-refresh\"\n97: \n98: # ────────\n99: # CONTEXT LOADING\n100: # ────────\n101: context_loading:\n102:   trigger: \"At workflow START, before phase_init\"\n103:   purpose: \"Load prior review context for the target and buffer it until strategy.md exists\"\n104:   retrieval:\n105:     mechanism: \"continuity-ladder-then-ripgrep\"\n106:     note: \"File reads only. Nothing here needs a running daemon, and every step is reproducible by hand.\"\n107:     ladder:\n108:       - \"{spec_folder}/handover.md when present\"\n109:       - \"the _memory.continuity frontmatter block in {spec_folder}/implementation-summary.md\"\n110:       - \"the packet's canonical spec docs, spec.md and decision-record.md, for what the first two steps leave open\"\n111:     free_text_recipe: \"rg --no-config --json --fixed-strings --ignore-case -C 2 --glob '*.md' --glob '!**/z_archive/**' --glob '!**/node_modules/**' -- '{review_target}' specs .skilled\"\n112:     recipe_contract: \".skilled/skills/system-spec-kit/references/retrieval/retrieval-conventions.md\"\n113:     exit_status: \"0 is a hit set, 1 is a clean no-hit, 2 or higher is a failure that must be surfaced instead of reported as no-hit\"\n114:     ranking: \"Ripgrep does not rank. Order the hits caller-side with the tuple in retrieval-conventions.md section 5.\"\n115:   when_to_skip: [\"User says 'skip context' or 'fresh start'\"]\n116:   behavior:\n117:     if_context_found: \"Store full results as prior_context plus a concise prior_context_summary; inject after strategy.md is created.\"\n118:     if_no_context: \"Set prior_context and prior_context_summary to 'None' and continue.\"\n119: \n120: # ────────\n121: # SKILL REFERENCE\n122: # ────────\n123: skill_reference:\n124:   skill: system-deep-loop\n125:   skill_md: .skilled/skills/system-deep-loop/deep-review/SKILL.md\n126:   references:\n127:     loop_protocol: .skilled/skills/system-deep-loop/deep-review/references/protocol/loop-protocol.md\n128:     state_format: .skilled/skills/system-deep-loop/deep-review/references/state/state-format.md\n129:     convergence: .skilled/skills/system-deep-loop/deep-review/references/convergence/convergence.md\n130:   templates:\n131:     config: .skilled/skills/system-deep-loop/deep-review/assets/deep-review-config.json\n132:     strategy: .skilled/skills/system-deep-loop/deep-review/assets/deep-review-strategy.md\n133: \n134: # ────────\n135: # AGENT CONFIGURATION\n136: # ────────\n137: agent_config:\n138:   agent: deep-review\n139:   agent_file: \".skilled/agents/deep-review.md\"\n140:   # Canonical path. Runtime-specific directories (e.g. .claude/agents/) reference this source.\n141:   mode: subagent\n142:   model: opus\n143:   leaf_only: true\n144:   tools: [Read, Write, Edit, Bash, Grep, Glob]\n145:   mcp_servers: []\n146: \n147: # ────────\n148: # STATE FILE PATHS\n149: # ────────\n150: # ────────\n151: # CANONICAL STATE WRITE MECHANISM\n152: # ────────\n153: state_write_protocol:\n154:   mechanism: \"append-gateway\"\n155:   command: \"node .skilled/skills/system-deep-loop/runtime/scripts/append-mode-event.cjs --mode review --run-directory {artifact_dir} --event-json <record file>\"\n156:   applies_to: \"every append_to_jsonl and append_jsonl directive in this workflow\"\n157:   refusal_handling: \"halt on exit 2; never fall back to a direct file write. Exit 1 on a row that is still routed through the gateway is a workflow defect and halts; the pinned_bookkeeping rows are recorded through bookkeeping_log and are never routed.\"\n158:   pinned_bookkeeping:\n159:     events: [config_warning, lock_released, pivot_confirm_accepted, manualStop, pivot_override_accepted, maxDurationReached]\n160:     directive: \"bookkeeping_log\"\n161:     handling: \"These rows are workflow bookkeeping that the review ledger schema pins to the legacy path: they have no lossless review-event target, so the gateway would refuse them with exit 1 and write nothing. They are never sent to the gateway. The step prints the row in its log line and continues; none of them is a halt condition.\"\n162:   contract: |\n163:     The directives below specify WHAT to record; this block specifies the mechanism. The gateway\n164:     authorizes the write against the mode's durable authority record, serialises it behind the\n165:     ledger fence, returns a receipt, and refreshes state_log from the ledger. Exit 0 means the\n166:     record is durable in the ledger and the refreshed state_log carries it. Exit 2 means it was\n167:     refused, and the refusal names the check that failed.\n168: \n169:     Writing state_log directly bypasses ordering, authorization, and the receipt. Two writers\n170:     can then interleave with no shared ordering, and a record nobody authorized carries no\n171:     receipt, so a later reader cannot tell an accepted record from an invented one. A refusal\n172:     is a halt, never a reason to write the file directly.\n173: \n174:     There is no direct-append exception. state_log is a projection the gateway rebuilds from\n175:     the ledger, so a row written beside it is dropped by the next refresh: the migration\n176:     marker, the recovery baseline, the iteration-error row and the claim-adjudication gate\n177:     row are canonical ledger events like every other record.\n178: \n179: state_paths:\n180:   # Template paths document the canonical packet layout. Runtime resolution happens via\n181:   # step_resolve_artifact_root plus the shared resolver, so root specs keep\n182:   # root-local review/ and child phases keep local review/ packet dirs.\n183:   # Canonical root-spec write targets remain review/deep-review-config.json,\n184:   # review/deep-review-state.jsonl, and review/deep-review-findings-registry.json.\n185:   packet_dir: \"{artifact_dir}\"\n186:   local_packet_dir: \"{spec_folder}/review\"\n187:   legacy_root_report: \"{spec_folder}/review-report.md\"\n188:   config: \"{artifact_dir}/deep-review-config.json\"\n189:   state_log: \"{artifact_dir}/deep-review-state.jsonl\"\n190:   findings_registry: \"{artifact_dir}/deep-review-findings-registry.json\"\n191:   strategy: \"{artifact_dir}/deep-review-strategy.md\"\n192:   dashboard: \"{artifact_dir}/deep-review-dashboard.md\"\n193:   pause_sentinel: \"{artifact_dir}/.deep-review-pause\"\n194:   lock_file: \"{artifact_dir}/.deep-review.lock\"\n195:   prompt_dir: \"{artifact_dir}/prompts\"\n196:   iteration_dir: \"{artifact_dir}/iterations\"\n197:   iteration_pattern: \"{artifact_dir}/iterations/iteration-{NNN}.md\"\n198:   # Per-iteration structured delta stream — complement to the canonical state_log\n199:   # append. MUST contain at least one record with `type === \"iteration\"`; variants\n200:   # like `\"iteration_delta\"` are silently dropped by the reducer.\n201:   delta_dir: \"{artifact_dir}/deltas\"\n202:   delta_pattern: \"{artifact_dir}/deltas/iter-{NNN}.jsonl\"\n203:   review_output: \"{artifact_dir}/review-report.md\"\n204:   resource_map_output: \"{artifact_dir}/resource-map.md\"\n205:   archive_root: \"{artifact_archive_root}\"\n206: \n207: # ────────\n208: # WORKFLOW\n209: # ────────\n210: \n211: gate_defaults:\n212:   after_gate_refresh_lock:\n213:     action: \"Refresh the packet lock heartbeat immediately after the operator response\"\n214:     command: \"node .skilled/skills/system-deep-loop/runtime/scripts/loop-lock.cjs refresh --lock-path {state_paths.lock_file} --owner-pid {captured_owner_pid} --nonce {captured_acquire_nonce}\"\n215:     on_refresh: \"If the refresh output has refreshed:false, fail closed: lost the packet lock. This run no longer holds the packet, so run step_release_lock and stop rather than continue without it.\"\n216: \n217: workflow:\n218: \n219:   step_resolve_artifact_root:\n220:     description: \"Resolve artifact directory — use fan-out lineage override when provided, else resolve from spec_folder\"\n221:     note: \"Root specs keep review artifacts directly in {spec_folder}/review/. Child phases and sub-phases keep local packet directories in {spec_folder}/review/{packet}/, and archives stay local at {spec_folder}/review-archive/{packet}/.\"\n222:     branch_on: \"config.fanout_lineage_artifact_dir\"\n223:     if_present:\n224:       bind:\n225:         artifact_dir: \"{config.fanout_lineage_artifact_dir}\"\n226:         artifact_root_dir: \"{config.fanout_lineage_artifact_dir}\"\n227:         artifact_subfolder: null\n228:         artifact_archive_root: \"{config.fanout_lineage_artifact_dir}/_archive\"\n229:     if_absent:\n230:       command: \"node -e \\\"const { resolveArtifactRoot } = require('./.skilled/skills/system-spec-kit/shared/review-research-paths.cjs'); console.log(JSON.stringify(resolveArtifactRoot('{spec_folder}', 'review')));\\\"\"\n231:       outputs:\n232:         - artifact_root_dir: \"Resolved local review owner directory\"\n233:         - artifact_subfolder: \"Local packet subfolder ({ownerSlug}-pt-{NN}), else null\"\n234:         - artifact_dir: \"Resolved review packet directory for this target\"\n235:         - artifact_archive_root: \"Resolved local review archive directory for this target\"\n236: \n237:   step_bind_reducer_artifact_arg:\n238:     description: \"Keep the reducer on the lineage-owned artifact directory during fan-out\"\n239:     branch_on: \"config.fanout_lineage_artifact_dir\"\n240:     if_present:\n241:       bind:\n242:         reducer_artifact_arg: \"--artifact-dir {artifact_dir}\"\n243:     if_absent:\n244:       bind:\n245:         reducer_artifact_arg: \"\"\n246: \n247:   step_apply_lifecycle_request:\n248:     description: \"Honor an explicit restart request before fan-out or normal initialization\"\n249:     dry_run_boundary: \"state-mutation\"\n250:     skip_when: \"lineage_mode != 'restart'\"\n251:     instructions: |\n252:       Run this step in both execution modes, immediately after artifact resolution\n253:       and before fan-out, so old packet files cannot be merged with fresh lineage\n254:       outputs. A restart request must never fall back to resume. The explicit\n255:       restart flag is operator authorization to archive the resolved review packet,\n256:       so do not ask for a second confirmation. Rollback is to move the timestamped\n257:       archive back to the packet directory.\n258:     bind_prior_lineage:\n259:       action: \"Read the session id and generation of the packet that is about to be archived\"\n260:       command: |\n261:         node -e '\n262:           const fs = require(\"fs\");\n263:           const crypto = require(\"crypto\");\n264:           let priorSessionId = null;\n265:           let priorGeneration = 0;\n266:           try {\n267:             const config = JSON.parse(fs.readFileSync(process.argv[1], \"utf8\"));\n268:             const lineage = config.lineage || config;\n269:             priorSessionId = typeof lineage.sessionId === \"string\" ? lineage.sessionId : null;\n270:             priorGeneration = Number(lineage.generation) || 0;\n271:           } catch (error) {\n272:             if (error.code !== \"ENOENT\") {\n273:               console.error(\"The old config cannot be read: \" + error.message);\n274:               process.exit(1);\n275:             }\n276:           }\n277:           let priorTailDigest = crypto.createHash(\"sha256\").update(\"\").digest(\"hex\");\n278:           try {\n279:             priorTailDigest = crypto.createHash(\"sha256\").update(fs.readFileSync(process.argv[2])).digest(\"hex\");\n280:           } catch (error) {\n281:             if (error.code !== \"ENOENT\") throw error;\n282:           }\n283:           console.log(JSON.stringify({ priorSessionId, priorGeneration, priorTailDigest }));\n284:         ' \"{state_paths.config}\" \"{state_paths.state_log}\"\n285:       outputs:\n286:         - prior_session_id: \"priorSessionId from the JSON output, null when no old config exists\"\n287:         - prior_generation: \"priorGeneration from the JSON output, 0 when no old config exists\"\n288:         - prior_tail_digest: \"priorTailDigest from the JSON output: the sha256 of the old state log bytes, or of zero bytes when no old state log exists\"\n289:       on_fail: \"Halt with STATUS=FAIL. The old config is unreadable, so repair or archive the packet by hand.\"\n290:     command: |\n291:       if [ -e \"{state_paths.archive_root}/{timestamp_slug}\" ]; then\n292:         echo \"The archive folder {state_paths.archive_root}/{timestamp_slug} is already there.\" >&2\n293:         exit 1\n294:       fi\n295:       if [ -d \"{state_paths.packet_dir}\" ]; then\n296:         mkdir -p \"{state_paths.archive_root}\" && mv \"{state_paths.packet_dir}\" \"{state_paths.archive_root}/{timestamp_slug}\" || exit 1\n297:       fi\n298:       mkdir -p \"{state_paths.packet_dir}\"\n299:     outputs:\n300:       - archived_path: \"{state_paths.archive_root}/{timestamp_slug} when a prior packet existed, else null\"\n301:       - lineage_mode: \"restart\"\n302:     on_fail: \"Halt with STATUS=FAIL; do not continue as resume or auto.\"\n303: \n304:   step_fanout_spawn:\n305:     description: \"Spawn fan-out lineages; skip and proceed to phase_init normally when single-executor\"\n306:     dry_run_boundary: \"child-spawn\"\n307:     skip_when: \"config.fanout is absent\"\n308:     instructions: |\n309:       Fan-out mode is active. Spawn all lineages. Each lineage runs the full loop in its own\n310:       isolated sub-packet under {artifact_dir}/lineages/{label}/.\n311:       This step runs before phase_init, so pass the raw review_focus. fanout-run.cjs\n312:       normalizes it and hands every lineage the same single-line text. Escape any double\n313:       quote, backslash, dollar sign or backtick in it for the shell, and pass an empty\n314:       string when no focus was given.\n315:       A cli-opencode lineage inside this fan-out is an explicit parallel-detached OpenCode\n316:       session with a separate lineage directory and session id; it is not the single-executor\n317:       self-invocation path. fanout-run.cjs owns the stack-only recursion guard for that\n318:       first-level detached lineage and still blocks recursive same-kind dispatch from inside it.\n319:       fanout-run.cjs owns native and CLI lineage execution; native is run through the\n320:       deep/review command surface with config.fanout_lineage_artifact_dir so the LEAF\n321:       deep-review agent is used only for individual iterations, never as a full-loop\n322:       sub-agent or pasted phase-running prompt.\n323:       After all lineages complete, jump directly to phase_synthesis — skip phase_init and\n324:       phase_main_loop entirely (those are the single-executor path). The merge step in\n325:       phase_synthesis will consolidate results across all lineages.\n326:     sub_steps:\n327:       step_fanout_spawn_cli:\n328:         description: \"Spawn all native and CLI lineages in capped worker pool\"\n329:         skip_when: \"no entries in config.fanout.executors\"\n330:         command: |\n331:           node .skilled/skills/system-deep-loop/runtime/scripts/fanout-run.cjs \\\n332:             --spec-folder {spec_folder} \\\n333:             --loop-type review \\\n334:             --review-focus \"{review_focus}\" \\\n335:             --review-target \"{review_target}\" \\\n336:             --review-target-type {review_target_type} \\\n337:             --fanout-config-json '{config.fanout_json}' \\\n338:             --base-artifact-dir {artifact_dir} \\\n339:             --convergence-threshold {convergence_threshold} \\\n340:             --stop-policy {stop_policy} \\\n341:             --convergence-mode {convergence_mode}\n342:         working_directory: \"{repo_root}\"\n343:         wait_for_completion: true\n344:         optional_flags: \"When lineage_timeout_hours is bound, append `--lineage-timeout-hours {lineage_timeout_hours}` to the command. When it is unset, append nothing, which keeps the 4 hour ceiling.\"\n345: \n346:   # ════════\n347:   # PHASE 1: INITIALIZATION\n348:   # ════════\n349:   phase_init:\n350:     purpose: Create all state files for the review session and resolve review scope\n351:     steps:\n352: \n353:       step_preflight_contract:\n354:         action: \"Validate required setup bindings and executable workflow contract before any file writes\"\n355:         verify:\n356:           - required_values_present: [review_target, review_target_type, review_dimensions, spec_folder, lineage_mode, max_iterations, convergence_threshold, convergence_mode, stop_policy]\n357:           - dry_run_normalized: \"Boolean true or false before workflow loading; absent flag resolves to false.\"\n358:           - spec_folder_is_within: \"specs/ or .opencode/specs/ (canonicalize alias roots before validation)\"\n359:           - unresolved_placeholders: \"FAIL if any user-facing template references placeholders not produced by earlier steps\"\n360:           - tool_contract: \"FAIL if executable steps reference tools outside the command allowlist\"\n361:         on_fail: \"Halt with STATUS=FAIL and report the missing binding or unsupported contract reference\"\n362: \n363:       step_create_directories:\n364:         action: \"Create spec folder and canonical review packet directories if they don't exist\"\n365:         dry_run_boundary: \"state-mutation\"\n366:         command: \"mkdir -p {state_paths.prompt_dir} {state_paths.iteration_dir} {state_paths.delta_dir}\"\n367: \n368:       step_detect_resource_map:\n369:         action: \"Detect resource-map.md before config creation so init can persist coverage-gate state\"\n370:         inspect:\n371:           - \"{spec_folder}/resource-map.md\"\n372:         classify:\n373:           present: \"resource-map.md exists at init\"\n374:           absent: \"resource-map.md does not exist at init\"\n375:         outputs:\n376:           - resource_map_present: \"Boolean true when {spec_folder}/resource-map.md exists, else false\"\n377:           - resource_map_known_context: \"When present: concise resource-map snapshot for Known Context and charter framing. When absent: 'resource-map.md not present; skipping coverage gate'.\"\n378: \n379:       step_migrate_legacy_review_state:\n380:         action: \"Rehome legacy review artifacts into review/iterations before session classification\"\n381:         dry_run_boundary: \"state-mutation\"\n382:         detect:\n383:           canonical_review_state:\n384:             - \"{state_paths.config}\"\n385:             - \"{state_paths.state_log}\"\n386:             - \"{state_paths.findings_registry}\"\n387:             - \"{state_paths.strategy}\"\n388:           legacy_review_state:\n389:             - \"{spec_folder}/scratch/deep-research-config.json\"\n390:             - \"{spec_folder}/scratch/deep-research-state.jsonl\"\n391:             - \"{spec_folder}/scratch/deep-review-strategy.md\"\n392:             - \"{spec_folder}/scratch/deep-review-dashboard.md\"\n393:             - \"{spec_folder}/scratch/iteration-*.md\"\n394:             - \"{spec_folder}/scratch/.deep-research-pause\"\n395:             - \"{state_paths.local_packet_dir}/iteration-*.md\"\n396:             - \"{state_paths.legacy_root_report}\"\n397:           legacy_review_markers:\n398:             - \"scratch/deep-review-strategy.md exists\"\n399:             - \"scratch/deep-research-config.json declares mode == 'review' OR scratch/deep-research-state.jsonl contains mode == 'review'\"\n400:         migrate_only:\n401:           - \"{spec_folder}/scratch/deep-research-config.json -> {state_paths.config}\"\n402:           - \"{spec_folder}/scratch/deep-research-state.jsonl -> {state_paths.state_log}\"\n403:           - \"{spec_folder}/scratch/deep-review-strategy.md -> {state_paths.strategy}\"\n404:           - \"{spec_folder}/scratch/deep-review-dashboard.md -> {state_paths.dashboard}\"\n405:           - \"{spec_folder}/scratch/iteration-*.md -> {state_paths.iteration_dir}/\"\n406:           - \"{spec_folder}/scratch/.deep-research-pause -> {state_paths.pause_sentinel}\"\n407:           - \"{state_paths.local_packet_dir}/iteration-*.md -> {state_paths.iteration_dir}/\"\n408:           - \"{state_paths.legacy_root_report} -> {state_paths.review_output}\"\n409:         on_canonical_present: \"Leave canonical review/ state untouched and do not overwrite it with legacy scratch artifacts.\"\n410:         on_legacy_detected: \"Move only the review-specific whitelist, print LEGACY_REVIEW_STATE_MOVED and leave unrelated scratch files untouched. Nothing is appended here: an append before session classification would create the state log and turn a fresh packet into a partial one, and the moved state log was written without the ledger, so the gateway refuses every append to it until step_classify_session.on_moved_legacy_state adopts it.\"\n411:         on_conflict: \"If canonical review/ state and legacy scratch review state both exist but disagree, halt for operator repair instead of merging contradictory state.\"\n412:         outputs:\n413:           - legacy_migration_detected: \"true when the command printed LEGACY_REVIEW_STATE_MOVED, else false\"\n414:           - migration_recorded: \"false; step_record_artifact_migration sets it once the migration row is appended\"\n415:         command: |\n416:           mkdir -p {state_paths.iteration_dir}\n417:           if [ ! -e {state_paths.config} ] && [ ! -e {state_paths.state_log} ] && [ ! -e {state_paths.strategy} ] && [ -e {spec_folder}/scratch/deep-review-strategy.md ] && ( [ -e {spec_folder}/scratch/deep-research-config.json ] || [ -e {spec_folder}/scratch/deep-research-state.jsonl ] ); then\n418:             [ -e {spec_folder}/scratch/deep-research-config.json ] && mv {spec_folder}/scratch/deep-research-config.json {state_paths.config}\n419:             [ -e {spec_folder}/scratch/deep-research-state.jsonl ] && mv {spec_folder}/scratch/deep-research-state.jsonl {state_paths.state_log}\n420:             [ -e {spec_folder}/scratch/deep-review-strategy.md ] && mv {spec_folder}/scratch/deep-review-strategy.md {state_paths.strategy}\n421:             [ -e {spec_folder}/scratch/deep-review-dashboard.md ] && mv {spec_folder}/scratch/deep-review-dashboard.md {state_paths.dashboard}\n422:             find {spec_folder}/scratch -maxdepth 1 -name 'iteration-*.md' -exec mv {} {state_paths.iteration_dir}/ \\;\n423:             [ -e {spec_folder}/scratch/.deep-research-pause ] && mv {spec_folder}/scratch/.deep-research-pause {state_paths.pause_sentinel}\n424:             [ -e {state_paths.legacy_root_report} ] && mv {state_paths.legacy_root_report} {state_paths.review_output}\n425:             echo \"LEGACY_REVIEW_STATE_MOVED\"\n426:           fi\n427:           find {state_paths.local_packet_dir} -maxdepth 1 -name 'iteration-*.md' -exec mv {} {state_paths.iteration_dir}/ \\; 2>/dev/null || true\n428: \n429:       step_acquire_lock:\n430:         action: \"Acquire the single-writer advisory lock before session classification\"\n431:         dry_run_boundary: \"state-mutation\"\n432:         ttl_ms: \"lock_ttl_ms = max(1800000, executor_timeout * 1000). executor_timeout is the bound dispatch timeout in seconds, 900 when unset. The lock is stale after twice this value, so it outlives the longest allowed dispatch.\"\n433:         command: \"node .skilled/skills/system-deep-loop/runtime/scripts/loop-lock.cjs acquire --lock-path {state_paths.lock_file} --packet-id {spec_folder} --ttl-ms {lock_ttl_ms}\"\n434:         on_acquire: \"Capture lock.ownerPid as captured_owner_pid and lock.acquireNonce as captured_acquire_nonce from the JSON output, and reuse both for every release below. If acquired=false, fail closed — another deep-review run already holds this packet. Under confirm, mode_overrides.confirm.lock_not_acquired applies instead.\"\n435:         note: \"Uses the promoted runtime/ loop-lock CLI (single source of truth: stale-lock reclaim, clean owner-scoped release). macOS/BSD locking is advisory — best-effort single-writer, not a hard mutex across host calls. Acquire reclaims a stale lock itself and reports the old holder under `reclaimed`. A lock is stale when its heartbeat is older than twice its TTL, or when its owning process is known to be dead. No confirmation step exists in either mode: log a `reclaimed` holder and continue.\"\n436:         # Lock-cleanup contract: the lock file MUST be released on every terminal exit path that follows acquisition.\n437:         # Runtimes honoring step_acquire_lock are required to perform this cleanup before halting or pausing.\n438:         on_halt:\n439:           action: \"Every terminal halt after the acquire runs step_release_lock before it returns control\"\n440:           command: \"node .skilled/skills/system-deep-loop/runtime/scripts/loop-lock.cjs release --lock-path {state_paths.lock_file} --owner-pid {captured_owner_pid} --nonce {captured_acquire_nonce}; failures here are logged but do not block the halt\"\n441:         on_cancel:\n442:           action: \"Release the lock on user cancel or pause-sentinel detection before sentinel processing\"\n443:           command: \"node .skilled/skills/system-deep-loop/runtime/scripts/loop-lock.cjs release --lock-path {state_paths.lock_file} --owner-pid {captured_owner_pid} --nonce {captured_acquire_nonce}; cancel completes regardless of cleanup result\"\n444:         on_workflow_exit:\n445:           action: \"Release the lock as the final step of any workflow exit path (success or failure)\"\n446:           command: \"node .skilled/skills/system-deep-loop/runtime/scripts/loop-lock.cjs release --lock-path {state_paths.lock_file} --owner-pid {captured_owner_pid} --nonce {captured_acquire_nonce}; idempotent — safe to invoke when already released\"\n447: \n448:       step_classify_session:\n449:         action: \"Classify the session before writing files\"\n450:         inspect:\n451:           - \"{state_paths.config}\"\n452:           - \"{state_paths.state_log}\"\n453:           - \"{state_paths.findings_registry}\"\n454:           - \"{state_paths.strategy}\"\n455:         classify:\n456:           fresh: \"None of the three state artifacts exist\"\n457:           resume: \"Config, JSONL, and strategy all exist and config.mode == 'review' and agree on target/spec folder\"\n458:           completed-session: \"Resume artifacts exist and config.status == 'complete'\"\n459:           invalid-state: \"Any partial, missing, or contradictory combination\"\n460:         outputs:\n461:           - session_state: \"fresh | resume | completed-session | invalid-state\"\n462:           - prior_tail_digest: \"sha256 of the state log bytes when resuming or restarting an existing lineage\"\n463:         lifecycle_routing:\n464:           - \"If lineage_mode == restart, step_apply_lifecycle_request archived the packet before the lock was taken, so session_state is fresh and on_fresh runs.\"\n465:           - \"If lineage_mode == auto or lineage_mode == resume, preserve the existing resume/completed/fresh behavior.\"\n466:         on_resume:\n467:           before_append: \"Run on_moved_legacy_state first when it applies.\"\n468:           log: \"Auto-resume: state artifacts are complete and consistent. Continue the same lineage (sessionId unchanged, generation unchanged, no archive).\"\n469:           append_jsonl: '{\"stem\":\"deep_review.run_resumed\",\"scope\":{\"runId\":\"{session_id}\",\"sessionId\":\"{session_id}\",\"generation\":{generation}},\"data\":{\"priorTailDigest\":\"{prior_tail_digest}\",\"sourceSessionId\":\"{session_id}\",\"resumeReason\":\"Auto-resume: state artifacts are complete and consistent; continue the same lineage.\",\"continuedFromRunId\":\"{session_id}-i{iteration_count}\",\"compatibilityDecision\":\"exact\",\"recoveryReceiptRef\":\"none\"}}'\n470:           skip_to: phase_loop\n471:           confirm_choice:\n472:             applies_to: confirm\n473:             preempts: \"Under confirm this block runs in place of the sibling log, append_jsonl and skip_to keys of on_resume. Under auto it is skipped and those keys run.\"\n474:             show_dashboard: \"{state_paths.dashboard}\"\n475:             ask: \"Existing review session is consistent. Resume where it left off, or restart (archive the current review packet under the root-level review-archive/ tree and start a fresh session)?\"\n476:             after_gate_refresh_lock: gate_defaults.after_gate_refresh_lock\n477:             options: [resume, restart, cancel]\n478:             on_resume_choice:\n479:               dry_run_boundary: \"state-mutation\"\n480:               before_append: \"Run on_moved_legacy_state first when it applies.\"\n481:               set:\n482:                 lineage_mode: \"resume\"\n483:                 parent_session_id: \"{session_id}\"\n484:               append_jsonl: '{\"stem\":\"deep_review.run_resumed\",\"scope\":{\"runId\":\"{session_id}\",\"sessionId\":\"{session_id}\",\"generation\":{generation}},\"data\":{\"priorTailDigest\":\"{prior_tail_digest}\",\"sourceSessionId\":\"{session_id}\",\"resumeReason\":\"Auto-resume: state artifacts are complete and consistent; continue the same lineage.\",\"continuedFromRunId\":\"{session_id}-i{iteration_count}\",\"compatibilityDecision\":\"exact\",\"recoveryReceiptRef\":\"none\"}}'\n485:               skip_to: gate_init_approval\n486:             on_restart_choice:\n487:               dry_run_boundary: \"state-mutation\"\n488:               bind_prior_lineage:\n489:                 action: \"Read the session id and generation of the packet that is about to be archived\"\n490:                 command: |\n491:                   node -e '\n492:                     const fs = require(\"fs\");\n493:                     const crypto = require(\"crypto\");\n494:                     let priorSessionId = null;\n495:                     let priorGeneration = 0;\n496:                     try {\n497:                       const config = JSON.parse(fs.readFileSync(process.argv[1], \"utf8\"));\n498:                       const lineage = config.lineage || config;\n499:                       priorSessionId = typeof lineage.sessionId === \"string\" ? lineage.sessionId : null;\n500:                       priorGeneration = Number(lineage.generation) || 0;\n501:                     } catch (error) {\n502:                       if (error.code !== \"ENOENT\") {\n503:                         console.error(\"The old config cannot be read: \" + error.message);\n504:                         process.exit(1);\n505:                       }\n506:                     }\n507:                     let priorTailDigest = crypto.createHash(\"sha256\").update(\"\").digest(\"hex\");\n508:                     try {\n509:                       priorTailDigest = crypto.createHash(\"sha256\").update(fs.readFileSync(process.argv[2])).digest(\"hex\");\n510:                     } catch (error) {\n511:                       if (error.code !== \"ENOENT\") throw error;\n512:                     }\n513:                     console.log(JSON.stringify({ priorSessionId, priorGeneration, priorTailDigest }));\n514:                   ' \"{state_paths.config}\" \"{state_paths.state_log}\"\n515:                 outputs:\n516:                   - prior_session_id: \"priorSessionId from the JSON output, null when no old config exists\"\n517:                   - prior_generation: \"priorGeneration from the JSON output, 0 when no old config exists\"\n518:                   - prior_tail_digest: \"priorTailDigest from the JSON output: the sha256 of the old state log bytes, or of zero bytes when no old state log exists\"\n519:                 on_fail: \"Halt with STATUS=FAIL through step_release_lock. The old config is unreadable, so repair or archive the packet by hand.\"\n520:               command: |\n521:                 if [ -e \"{state_paths.archive_root}/{timestamp_slug}\" ]; then\n522:                   echo \"The archive folder {state_paths.archive_root}/{timestamp_slug} is already there.\" >&2\n523:                   exit 1\n524:                 fi\n525:                 mkdir -p \"{state_paths.archive_root}/{timestamp_slug}\" || exit 1\n526:                 find \"{state_paths.packet_dir}\" -mindepth 1 -maxdepth 1 ! -name \"$(basename \"{state_paths.lock_file}\")\" -exec mv {} \"{state_paths.archive_root}/{timestamp_slug}/\" \\; || exit 1\n527:                 mkdir -p \"{state_paths.prompt_dir}\" \"{state_paths.iteration_dir}\" \"{state_paths.delta_dir}\"\n528:               on_fail: \"Halt with STATUS=FAIL through step_release_lock. Never fall back to resume.\"\n529:               set:\n530:                 lineage_mode: \"restart\"\n531:               skip_to: step_create_config\n532:             on_cancel_choice:\n533:               halt: true\n534:               release_lock: step_release_lock\n535:               message: \"Review session preserved. Manually archive or edit review/ before re-running.\"\n536:         on_restart:\n537:           action: \"Nothing is archived here. step_apply_lifecycle_request archived the packet before the lock was taken, so a restart run reaches this step as fresh and continues as on_fresh.\"\n538:         note_deferred_branches: \"fork and completed-continue are deferred and no longer runtime-supported in this release. The reducer still reads `lineageMode` from config for dashboards and analysis, but only `new`, `resume`, and `restart` are live. See deep-review/references/protocol/loop-protocol.md §Lifecycle Branches for the one-session contract.\"\n539:         on_moved_legacy_state:\n540:           applies_when: \"legacy_migration_detected == true and the branch taken resumes the session or goes to synthesis; never on restart or cancel\"\n541:           order: \"Runs after classification and before that branch appends anything, the resume event included.\"\n542:           note: |\n543:             The state log moved out of scratch/ was written by hand before the ledger existed, so the\n544:             gateway refuses every append to it. Set it aside unchanged as deep-review-state.legacy.jsonl,\n545:             open the run from the moved config, then replay its iteration rows through the gateway,\n546:             which carries each one whole. Rows the gateway cannot carry stay only in the set-aside file,\n547:             and the replay reports how many. Exit 2 from any of the three is a halt.\n548:           set_aside_command: |\n549:             STATE_LOG=\"{state_paths.state_log}\"\n550:             LEGACY_LOG=\"$(dirname \"$STATE_LOG\")/deep-review-state.legacy.jsonl\"\n551:             if [ -e \"$LEGACY_LOG\" ]; then\n552:               echo \"A set-aside legacy state log already exists at $LEGACY_LOG. Repair the packet by hand.\" >&2\n553:               exit 1\n554:             fi\n555:             mv \"$STATE_LOG\" \"$LEGACY_LOG\"\n556:           open_run: \"Run step_create_state_log.command unchanged. With the hand-written log set aside, it opens the run from the moved config.\"\n557:           replay_command: |\n558:             GATEWAY=\".skilled/skills/system-deep-loop/runtime/scripts/append-mode-event.cjs\"\n559:             [ -f \"$GATEWAY\" ] || GATEWAY=\"scripts/append-mode-event.cjs\"\n560:             RUN_DIR=\"$(dirname \"{state_paths.state_log}\")\"\n561:             node -e '\n562:               const fs = require(\"fs\"), os = require(\"os\"), path = require(\"path\");\n563:               const { spawnSync } = require(\"child_process\");\n564:               const [gateway, legacyLog, runDir] = process.argv.slice(1);\n565:               let replayedIterations = 0;\n566:               let keptOnlyInLegacyLog = 0;\n567:               for (const line of fs.readFileSync(legacyLog, \"utf8\").split(\"\\n\")) {\n568:                 if (line.trim() === \"\") continue;\n569:                 let row;\n570:                 try { row = JSON.parse(line); } catch { keptOnlyInLegacyLog += 1; continue; }\n571:                 // The run open already replaced the config row.\n572:                 if (row && row.type === \"config\") continue;\n573:                 if (!row || row.type !== \"iteration\") { keptOnlyInLegacyLog += 1; continue; }\n574:                 const tempDir = fs.mkdtempSync(path.join(os.tmpdir(), \"deep-review-replay-\"));\n575:                 const eventFile = path.join(tempDir, \"row.json\");\n576:                 fs.writeFileSync(eventFile, JSON.stringify(row));\n577:                 const result = spawnSync(process.execPath, [gateway, \"--mode\", \"review\", \"--run-directory\", runDir, \"--event-json\", eventFile], { encoding: \"utf8\" });\n578:                 fs.rmSync(tempDir, { recursive: true, force: true });\n579:                 if (result.status === 2) { process.stdout.write(result.stdout || \"\"); process.exit(2); }\n580:                 if (result.status === 0) replayedIterations += 1; else keptOnlyInLegacyLog += 1;\n581:               }\n582:               process.stdout.write(JSON.stringify({ replayedIterations, keptOnlyInLegacyLog, legacyLog }) + \"\\n\");\n583:             ' \"$GATEWAY\" \"$RUN_DIR/deep-review-state.legacy.jsonl\" \"$RUN_DIR\"\n584:         on_completed_session:\n585:           before_append: \"Run on_moved_legacy_state first when it applies.\"\n586:           log: \"Prior session already completed. Either archive the completed review/ tree and start a fresh session, or jump straight to synthesis with the existing artifacts.\"\n587:           skip_to: phase_synthesis\n588:         on_invalid_state:\n589:           halt: true\n590:           release_lock: step_release_lock\n591:           message: \"Existing deep-review state in review/ is incomplete or contradictory. Repair or archive the invalid review packet before continuing.\"\n592:         on_fresh:\n593:           action: \"Proceed with a new session\"\n594: \n595:       step_scope_discovery:\n596:         action: \"Resolve review target to a concrete file list based on target type\"\n597:         resolve:\n598:           spec-folder: |\n599:             1. Inspect spec.md, plan.md, tasks.md, acceptance-criteria.md, implementation-summary.md, and goal-file-manifest.txt when present\n600:             2. If goal-file-manifest.txt exists, parse one repo-relative path per non-empty, non-comment line; reject absolute paths, traversal outside repo_root, duplicates, missing paths, and non-file entries\n601:             3. Fail before dispatch with line-numbered validation errors when any manifest entry is invalid; otherwise set scope = the validated manifest paths in declared order\n602:             4. When no manifest exists, discover implementation files referenced in the canonical spec artifacts\n603:             5. Discover test files associated with the implementation files\n604:             6. Set scope = the packet's own canonical docs plus all discovered implementation and test files\n605:           skill: |\n606:             1. Read SKILL.md from .skilled/skills/{skill_name}/\n607:             2. Discover references/, assets/, scripts/ contents\n608:             3. Find agent definitions referencing this skill across runtimes\n609:             4. Find command entry points referencing this skill\n610:             5. Set scope = all discovered files\n611:           agent: |\n612:             1. Find agent definition across repo-managed runtimes (.claude/agents/, .skilled/agents/)\n613:             2. Compare agent definitions for consistency\n614:             3. Set scope = all discovered agent files\n615:           track: |\n616:             1. List all child spec folders under specs/{track}/ or .opencode/specs/{track}/\n617:             2. For each: read spec.md + acceptance-criteria.md\n618:             3. Set scope = all child spec artifacts\n619:           files: |\n620:             1. Expand glob patterns from review_target\n621:             2. Validate all files exist\n622:             3. Discover immediate cross-references (imports, links)\n623:             4. Set scope = expanded file list + cross-references\n624:         outputs:\n625:           - review_scope_files: \"List of all files in review scope\"\n626:           - cross_reference_targets: \"{ spec_paths: [...], code_paths: [...], test_paths: [...] }\"\n627: \n628:       step_order_dimensions:\n629:         action: \"Order review dimensions based on risk priority\"\n630:         algorithm: |\n631:           1. Iteration 0 (inventory pass): Build artifact map, identify file types, estimate complexity\n632:           2. Subsequent iterations follow risk-ordered deep passes:\n633:              correctness → security → traceability → maintainability\n634:           3. If review_dimensions != \"all\", filter to only requested dimensions\n635:           4. Derive traceability protocol plan:\n636:              - core: spec_code, checklist_evidence\n637:              - overlay: skill_agent, agent_cross_runtime, feature_catalog_code, playbook_capability\n638:           5. If resource_map_present, reserve at least one traceability-oriented pass to cross-check target_files from applied/T-*.md against resource-map.md and classify touched / expected-by-scope / gap / absent-from-map outcomes\n639:           6. Store ordered list as dimension_queue\n640:         outputs:\n641:           - dimension_queue: \"Ordered list of dimensions to review\"\n642:           - inventory_pass: true\n643: \n644:       step_normalize_review_dimensions:\n645:         action: \"Normalize reviewDimensions once during init for config + JSONL reuse\"\n646:         outputs:\n647:           - review_dimensions_normalized: \"Canonical string[] for deep-review-config.json\"\n648:           - review_dimensions_json: \"JSON.stringify(review_dimensions_normalized) for JSONL config record\"\n649:         normalize: |\n650:           Accept {review_dimensions} in any of these shapes and convert once:\n651:             - \"all\" → [\"correctness\",\"security\",\"traceability\",\"maintainability\"]\n652:             - \"correctness,security\" → [\"correctness\",\"security\"]\n653:             - [\"correctness\"] → [\"correctness\"]\n654:           Every element MUST be one of the four canonical dimension names.\n655: \n656:       step_normalize_review_focus:\n657:         action: \"Normalize the optional operator review focus once during init\"\n658:         outputs:\n659:           - review_focus_normalized: \"Single-line focus text, or empty string when no focus was given\"\n660:         normalize: |\n661:           Collapse every control character (C0, C1, DEL, U+2028, U+2029) and whitespace run to one space, trim, treat an empty result as absent, and fail setup when more than 1000 characters remain.\n662:           fanout-run.cjs applies the same rule in code, so a fan-out lineage receives the same text.\n663: \n664:       step_resolve_session_id:\n665:         action: \"Resolve init session id from caller when supplied, else preserve timestamp fallback\"\n666:         branch_on: \"session_id\"\n667:         if_present:\n668:           bind:\n669:             session_id_init: \"{session_id}\"\n670:         if_absent:\n671:           bind:\n672:             session_id_init: \"{ISO_8601_NOW}\"\n673: \n674:       step_create_config:\n675:         action: \"Create deep-review-config.json from template with review-specific fields\"\n676:         dry_run_boundary: \"state-mutation\"\n677:         template: .skilled/skills/system-deep-loop/deep-review/assets/deep-review-config.json\n678:         lineage_values:\n679:           generation_init: \"{prior_generation + 1} when lineage_mode == 'restart', else 1\"\n680:           lineage_mode_init: \"restart when lineage_mode == 'restart', else new\"\n681:           parent_session_id_init: \"{prior_session_id} when lineage_mode == 'restart', else null\"\n682:         populate:\n683:           topic: \"Review: {review_target}\"\n684:           mode: \"review\"\n685:           sessionId: \"{session_id_init}\"\n686:           parentSessionId: \"{parent_session_id_init}\"\n687:           lineageMode: \"{lineage_mode_init}\"\n688:           generation: \"{generation_init}\"\n689:           continuedFromRun: null\n690:           reviewTarget: \"{review_target}\"\n691:           reviewTargetType: \"{review_target_type}\"\n692:           # Reuse the single normalized init-time value from step_normalize_review_dimensions.\n693:           reviewDimensions: \"{review_dimensions_normalized}\"\n694:           # Null when review_focus_normalized is empty. The review report reads it back to show the focus.\n695:           reviewFocus: \"{review_focus_normalized}\"\n696:           resource_map_present: \"{resource_map_present}\"\n697:           reviewScopeFiles: \"{review_scope_files}\"\n698:           severityThreshold: \"P2\"\n699:           crossReference:\n700:             core: [\"spec_code\", \"checklist_evidence\"]\n701:             overlay: [\"skill_agent\", \"agent_cross_runtime\", \"feature_catalog_code\", \"playbook_capability\"]\n702:           maxIterations: \"{max_iterations}\"\n703:           # Semantic: weighted P0/P1/P2 severity ratio. See SKILL.md §\"Convergence Threshold Semantics\".\n704:           convergenceThreshold: \"{convergence_threshold}\"\n705:           antiConvergence.convergenceMode: \"{convergence_mode}\"\n706:           antiConvergence.divergent: {}\n707:           stopPolicy: \"{stop_policy}\"\n708:           stuckThreshold: 2\n709:           maxDurationMinutes: 120\n710:           specFolder: \"{spec_folder}\"\n711:           # Honor the parsed --no-resource-map flag from deep-review.md:71 (default true; false when flag is set).\n712:           # The markdown command parses $ARGUMENTS and binds {resource_map_emit} before this step runs.\n713:           resource_map.emit: \"{resource_map_emit}\"\n714:           createdAt: \"{ISO_8601_NOW}\"\n715:           status: \"initialized\"\n716:           releaseReadinessState: \"in-progress\"\n717:           executionMode: \"{execution_mode}\"\n718:         output: \"{state_paths.config}\"\n719: \n720:       step_create_state_log:\n721:         action: \"Open the run in the ledger: record deep_review.run_initialized through the append gateway, which writes the state log's first row\"\n722:         dry_run_boundary: \"state-mutation\"\n723:         note: |\n724:           The state log is a projection the gateway rebuilds from the ledger, so this step never writes\n725:           it directly. A config row written beside the ledger carries keys the projection cannot\n726:           rebuild, and the projection refuses to drop them, so every later append in the run would\n727:           commit to the ledger and then exit 2. Recording the run's opening as a ledger event makes\n728:           the projected config row the state log's first row from the start. The full config stays\n729:           in deep-review-config.json, which is what the reducer reads.\n730:         command: |\n731:           GATEWAY=\".skilled/skills/system-deep-loop/runtime/scripts/append-mode-event.cjs\"\n732:           [ -f \"$GATEWAY\" ] || GATEWAY=\"scripts/append-mode-event.cjs\"\n733:           EVENT_FILE=\"$(mktemp \"${TMPDIR:-/tmp}/deep-review-run-open.XXXXXX\")\"\n734:           node -e '\n735:             const fs = require(\"fs\"), crypto = require(\"crypto\");\n736:             const [configPath, workflowPath] = process.argv.slice(1);\n737:             const sha = (bytes) => crypto.createHash(\"sha256\").update(bytes).digest(\"hex\");\n738:             const raw = fs.readFileSync(configPath);\n739:             const config = JSON.parse(raw);\n740:             const targetTypes = { files: \"file\", file: \"file\", directory: \"directory\", \"spec-folder\": \"directory\", track: \"directory\", repository: \"repository\" };\n741:             const lineageModes = { new: \"fresh\", fresh: \"fresh\", restart: \"restart\", resume: \"resume\" };\n742:             // The projected config row shows this topic; one the schema cannot hold is left out,\n743:             // and the row falls back to the run id rather than the run failing to open.\n744:             const topic = typeof config.topic === \"string\" && config.topic.trim() !== \"\" && config.topic.length <= 4096\n745:               ? config.topic\n746:               : null;\n747:             process.stdout.write(JSON.stringify({\n748:               stem: \"deep_review.run_initialized\",\n749:               scope: { runId: config.sessionId, sessionId: config.sessionId, generation: Number(config.generation) || 1 },\n750:               data: {\n751:                 target: {\n752:                   targetId: \"review-target\",\n753:                   targetType: targetTypes[config.reviewTargetType] || \"artifact\",\n754:                   artifactRef: \"deep-review-config.json#reviewTarget\",\n755:                   sourceDigest: sha(String(config.reviewTarget)),\n756:                   contentDigest: sha(raw),\n757:                 },\n758:                 lineageMode: lineageModes[config.lineageMode] || \"fresh\",\n759:                 maxIterations: Number(config.maxIterations),\n760:                 convergencePolicyVersion: \"convergence-policy@\" + ((config.antiConvergence && config.antiConvergence.convergenceMode) || \"default\"),\n761:                 reviewModeContractDigest: sha(fs.readFileSync(workflowPath)),\n762:                 initialReleaseReadinessState: \"not-assessed\",\n763:                 ...(topic === null ? {} : { topic }),\n764:               },\n[Output truncated. Continue reading with offset: 765]","title":"read","metadata":{"metadata":{"truncated":true},"content":[{"type":"text","text":"Read file .skilled/commands/deep/assets/deep-review.yaml, lines 1-764\n1: # ────────\n2: # DEEP REVIEW: DEEP REVIEW LOOP (AUTO AND CONFIRM MODES)\n3: # ────────\n4: # DEEP REVIEW: DEEP REVIEW LOOP (AUTO AND CONFIRM MODES)\n5: # ────────\n6: role: Deep Review Loop Manager\n7: purpose: Iterative code/spec review with convergence detection across review dimensions\n8: action: Run deep-review loop from initialization through synthesis\n9: operating_mode:\n10:   workflow: iterative_loop\n11:   workflow_compliance: MANDATORY\n12:   workflow_execution: autonomous\n13:   approvals: none\n14:   tracking: progressive_review_state\n15:   validation: convergence_detection\n16: \n17: # ────────\n18: # OPERATING PRINCIPLES\n19: # ────────\n20: operating_principles:\n21:   core: \"Fresh context per iteration + externalized state = no context degradation\"\n22:   approach: \"Dispatch focused review agent per dimension, evaluate convergence, repeat or stop\"\n23:   mandate: \"Never hold findings in memory; write everything to files. Review target is READ-ONLY.\"\n24: \n25: # ────────\n26: # EXECUTION MODE\n27: # ────────\n28: execution_mode:\n29:   source: \"$ARGUMENTS\"\n30:   values: [auto, confirm]\n31:   default: confirm\n32:   rule: \"Every step, executor branch and flag in this file runs in both modes. Under confirm, also execute every block marked applies_to: confirm at the place that carries it, and apply the mode_overrides.confirm wording. Under auto, skip every block marked applies_to: confirm and keep the autonomous wording of this file.\"\n33: mode_overrides:\n34:   confirm:\n35:     purpose: \"Iterative code/spec review with convergence detection and user approval gates\"\n36:     action: \"Run deep-review loop with user confirmation at each phase transition\"\n37:     workflow_execution: \"interactive\"\n38:     approvals: \"multi_gate\"\n39:     approach: \"Dispatch focused review agent per dimension, show results, get approval, repeat or stop\"\n40:     mandate: \"Never hold findings in memory; write everything to files. Pause for user at each gate. Review target is READ-ONLY.\"\n41:     phase_loop_purpose: \"Dispatch review agent iterations with approval at each step\"\n42:     lock_not_acquired: \"If acquired=false, stop and present recovery choices: another deep-review run already holds this packet.\"\n43:     agent_dispatch_timeout: \"Retry once with reduced scope. If second timeout, mark as 'timeout' and show to user for decision.\"\n44:     continuity_save_failure: \"Preserve the review packet in review/ as backup. Inform user.\"\n45:     rules_always: [pause_at_approval_gates, present_clear_options_at_each_gate]\n46:     rules_never: [proceed_past_approval_gate_without_user_response, auto_approve_on_behalf_of_user]\n47: \n48: # ────────\n49: # USER INPUTS (from setup phase)\n50: # ────────\n51: user_inputs:\n52:   review_target: \"[REVIEW_TARGET] - What to review. REQUIRED.\"\n53:   review_target_type: \"[spec-folder|skill|agent|track|files] - Target type for scope derivation. REQUIRED.\"\n54:   review_dimensions: \"[all|correctness,security,traceability,maintainability] - Dimensions to check. Default: all.\"\n55:   review_focus: \"[optional free text] - Operator review focus that every iteration covers in addition to its dimension. Default: empty, which leaves the prompt unchanged.\"\n56:   spec_folder: \"[SPEC_FOLDER] - Spec folder path for state files. REQUIRED.\"\n57:   session_id: \"[SESSION_ID] - Optional caller-supplied session id for fan-out lineages. Default: timestamp.\"\n58:   lineage_mode: \"[auto|resume|restart] - Session lifecycle intent. Default: auto. The runtime only persists lineage events for `resume` (same sessionId, no archive) and `restart` (new sessionId, generation+1, prior review/ archived). `fork` and `completed-continue` are deferred and no longer accepted — see deep-review/references/protocol/loop-protocol.md §Lifecycle Branches.\"\n59:   max_iterations: 7\n60:   convergence_threshold: 0.10\n61:   convergence_mode: \"[default|off|sliding-window|divergent] - Convergence policy modifier. Default: default.\"\n62:   stop_policy: \"[convergence|max-iterations] - Stop behavior. Default: convergence. max-iterations treats convergence as telemetry until the hard iteration ceiling.\"\n63:   dry_run: \"[DRY_RUN] - Boolean pre-flight flag. Default: false.\"\n64:   lineage_timeout_hours: \"[LINEAGE_TIMEOUT_HOURS] - Optional per-lineage wall-clock ceiling in hours for fan-out runs, at most 4. Default: unset, which keeps the 4 hour ceiling.\"\n65:   config.fanout_lineage_artifact_dir: \"[optional internal path] - Fan-out lineage artifact override for command-owned single-lineage execution.\"\n66: \n67: # ────────\n68: # DRY-RUN CONTROL\n69: # ────────\n70: dry_run_control:\n71:   enabled_when: \"dry_run == true\"\n72:   default: false\n73:   modes: [auto, confirm]\n74:   purpose: \"Run safe setup and read-only inspection, then stop before side effects.\"\n75:   safe_operations:\n76:     - \"Resolve setup inputs and artifact roots.\"\n77:     - \"Read current state, strategy, focus, and convergence signals.\"\n78:     - \"Render the next prompt to terminal preview without writing prompt files.\"\n79:   forbidden_operations:\n80:     - \"Executor dispatch.\"\n81:     - \"Persistent state, queue, lock, git index, memory, or graph mutation.\"\n82:     - \"Reducer refresh or generated artifact writes.\"\n83:     - \"Child-lineage spawn.\"\n84:   event_policy:\n85:     event_name: dry_run_halt\n86:     sink: \"terminal JSONL preview only; never append to {state_paths.state_log}\"\n87:     required_fields: [type, event, mode, boundary, step, timestamp]\n88:     optional_fields: [run, sessionId, generation, detail]\n89:     default_halt_event: '{\"type\":\"event\",\"event\":\"dry_run_halt\",\"mode\":\"review\",\"boundary\":\"{dry_run_boundary}\",\"step\":\"{step_name}\",\"timestamp\":\"{ISO_8601_NOW}\"}'\n90:     preview_only: \"A step or branch marked dry_run_event_policy: preview-only still runs its read and classify work. It prints the event it would append as a terminal JSONL preview line and appends nothing.\"\n91:   halt_hook_rule: \"Before executing any command, dispatch, edit, output, template write, append_to_jsonl, append_jsonl, log_event, mcp_tool, write, or git-index mutation in a step tagged with dry_run_boundary, emit event_policy.default_halt_event with that step's name and boundary to the terminal and halt. This holds in both execution modes.\"\n92:   boundary_labels:\n93:     child_spawn: \"child-spawn\"\n94:     state_mutation: \"state-mutation\"\n95:     dispatch: \"dispatch\"\n96:     reducer_refresh: \"reducer-refresh\"\n97: \n98: # ────────\n99: # CONTEXT LOADING\n100: # ────────\n101: context_loading:\n102:   trigger: \"At workflow START, before phase_init\"\n103:   purpose: \"Load prior review context for the target and buffer it until strategy.md exists\"\n104:   retrieval:\n105:     mechanism: \"continuity-ladder-then-ripgrep\"\n106:     note: \"File reads only. Nothing here needs a running daemon, and every step is reproducible by hand.\"\n107:     ladder:\n108:       - \"{spec_folder}/handover.md when present\"\n109:       - \"the _memory.continuity frontmatter block in {spec_folder}/implementation-summary.md\"\n110:       - \"the packet's canonical spec docs, spec.md and decision-record.md, for what the first two steps leave open\"\n111:     free_text_recipe: \"rg --no-config --json --fixed-strings --ignore-case -C 2 --glob '*.md' --glob '!**/z_archive/**' --glob '!**/node_modules/**' -- '{review_target}' specs .skilled\"\n112:     recipe_contract: \".skilled/skills/system-spec-kit/references/retrieval/retrieval-conventions.md\"\n113:     exit_status: \"0 is a hit set, 1 is a clean no-hit, 2 or higher is a failure that must be surfaced instead of reported as no-hit\"\n114:     ranking: \"Ripgrep does not rank. Order the hits caller-side with the tuple in retrieval-conventions.md section 5.\"\n115:   when_to_skip: [\"User says 'skip context' or 'fresh start'\"]\n116:   behavior:\n117:     if_context_found: \"Store full results as prior_context plus a concise prior_context_summary; inject after strategy.md is created.\"\n118:     if_no_context: \"Set prior_context and prior_context_summary to 'None' and continue.\"\n119: \n120: # ────────\n121: # SKILL REFERENCE\n122: # ────────\n123: skill_reference:\n124:   skill: system-deep-loop\n125:   skill_md: .skilled/skills/system-deep-loop/deep-review/SKILL.md\n126:   references:\n127:     loop_protocol: .skilled/skills/system-deep-loop/deep-review/references/protocol/loop-protocol.md\n128:     state_format: .skilled/skills/system-deep-loop/deep-review/references/state/state-format.md\n129:     convergence: .skilled/skills/system-deep-loop/deep-review/references/convergence/convergence.md\n130:   templates:\n131:     config: .skilled/skills/system-deep-loop/deep-review/assets/deep-review-config.json\n132:     strategy: .skilled/skills/system-deep-loop/deep-review/assets/deep-review-strategy.md\n133: \n134: # ────────\n135: # AGENT CONFIGURATION\n136: # ────────\n137: agent_config:\n138:   agent: deep-review\n139:   agent_file: \".skilled/agents/deep-review.md\"\n140:   # Canonical path. Runtime-specific directories (e.g. .claude/agents/) reference this source.\n141:   mode: subagent\n142:   model: opus\n143:   leaf_only: true\n144:   tools: [Read, Write, Edit, Bash, Grep, Glob]\n145:   mcp_servers: []\n146: \n147: # ────────\n148: # STATE FILE PATHS\n149: # ────────\n150: # ────────\n151: # CANONICAL STATE WRITE MECHANISM\n152: # ────────\n153: state_write_protocol:\n154:   mechanism: \"append-gateway\"\n155:   command: \"node .skilled/skills/system-deep-loop/runtime/scripts/append-mode-event.cjs --mode review --run-directory {artifact_dir} --event-json <record file>\"\n156:   applies_to: \"every append_to_jsonl and append_jsonl directive in this workflow\"\n157:   refusal_handling: \"halt on exit 2; never fall back to a direct file write. Exit 1 on a row that is still routed through the gateway is a workflow defect and halts; the pinned_bookkeeping rows are recorded through bookkeeping_log and are never routed.\"\n158:   pinned_bookkeeping:\n159:     events: [config_warning, lock_released, pivot_confirm_accepted, manualStop, pivot_override_accepted, maxDurationReached]\n160:     directive: \"bookkeeping_log\"\n161:     handling: \"These rows are workflow bookkeeping that the review ledger schema pins to the legacy path: they have no lossless review-event target, so the gateway would refuse them with exit 1 and write nothing. They are never sent to the gateway. The step prints the row in its log line and continues; none of them is a halt condition.\"\n162:   contract: |\n163:     The directives below specify WHAT to record; this block specifies the mechanism. The gateway\n164:     authorizes the write against the mode's durable authority record, serialises it behind the\n165:     ledger fence, returns a receipt, and refreshes state_log from the ledger. Exit 0 means the\n166:     record is durable in the ledger and the refreshed state_log carries it. Exit 2 means it was\n167:     refused, and the refusal names the check that failed.\n168: \n169:     Writing state_log directly bypasses ordering, authorization, and the receipt. Two writers\n170:     can then interleave with no shared ordering, and a record nobody authorized carries no\n171:     receipt, so a later reader cannot tell an accepted record from an invented one. A refusal\n172:     is a halt, never a reason to write the file directly.\n173: \n174:     There is no direct-append exception. state_log is a projection the gateway rebuilds from\n175:     the ledger, so a row written beside it is dropped by the next refresh: the migration\n176:     marker, the recovery baseline, the iteration-error row and the claim-adjudication gate\n177:     row are canonical ledger events like every other record.\n178: \n179: state_paths:\n180:   # Template paths document the canonical packet layout. Runtime resolution happens via\n181:   # step_resolve_artifact_root plus the shared resolver, so root specs keep\n182:   # root-local review/ and child phases keep local review/ packet dirs.\n183:   # Canonical root-spec write targets remain review/deep-review-config.json,\n184:   # review/deep-review-state.jsonl, and review/deep-review-findings-registry.json.\n185:   packet_dir: \"{artifact_dir}\"\n186:   local_packet_dir: \"{spec_folder}/review\"\n187:   legacy_root_report: \"{spec_folder}/review-report.md\"\n188:   config: \"{artifact_dir}/deep-review-config.json\"\n189:   state_log: \"{artifact_dir}/deep-review-state.jsonl\"\n190:   findings_registry: \"{artifact_dir}/deep-review-findings-registry.json\"\n191:   strategy: \"{artifact_dir}/deep-review-strategy.md\"\n192:   dashboard: \"{artifact_dir}/deep-review-dashboard.md\"\n193:   pause_sentinel: \"{artifact_dir}/.deep-review-pause\"\n194:   lock_file: \"{artifact_dir}/.deep-review.lock\"\n195:   prompt_dir: \"{artifact_dir}/prompts\"\n196:   iteration_dir: \"{artifact_dir}/iterations\"\n197:   iteration_pattern: \"{artifact_dir}/iterations/iteration-{NNN}.md\"\n198:   # Per-iteration structured delta stream — complement to the canonical state_log\n199:   # append. MUST contain at least one record with `type === \"iteration\"`; variants\n200:   # like `\"iteration_delta\"` are silently dropped by the reducer.\n201:   delta_dir: \"{artifact_dir}/deltas\"\n202:   delta_pattern: \"{artifact_dir}/deltas/iter-{NNN}.jsonl\"\n203:   review_output: \"{artifact_dir}/review-report.md\"\n204:   resource_map_output: \"{artifact_dir}/resource-map.md\"\n205:   archive_root: \"{artifact_archive_root}\"\n206: \n207: # ────────\n208: # WORKFLOW\n209: # ────────\n210: \n211: gate_defaults:\n212:   after_gate_refresh_lock:\n213:     action: \"Refresh the packet lock heartbeat immediately after the operator response\"\n214:     command: \"node .skilled/skills/system-deep-loop/runtime/scripts/loop-lock.cjs refresh --lock-path {state_paths.lock_file} --owner-pid {captured_owner_pid} --nonce {captured_acquire_nonce}\"\n215:     on_refresh: \"If the refresh output has refreshed:false, fail closed: lost the packet lock. This run no longer holds the packet, so run step_release_lock and stop rather than continue without it.\"\n216: \n217: workflow:\n218: \n219:   step_resolve_artifact_root:\n220:     description: \"Resolve artifact directory — use fan-out lineage override when provided, else resolve from spec_folder\"\n221:     note: \"Root specs keep review artifacts directly in {spec_folder}/review/. Child phases and sub-phases keep local packet directories in {spec_folder}/review/{packet}/, and archives stay local at {spec_folder}/review-archive/{packet}/.\"\n222:     branch_on: \"config.fanout_lineage_artifact_dir\"\n223:     if_present:\n224:       bind:\n225:         artifact_dir: \"{config.fanout_lineage_artifact_dir}\"\n226:         artifact_root_dir: \"{config.fanout_lineage_artifact_dir}\"\n227:         artifact_subfolder: null\n228:         artifact_archive_root: \"{config.fanout_lineage_artifact_dir}/_archive\"\n229:     if_absent:\n230:       command: \"node -e \\\"const { resolveArtifactRoot } = require('./.skilled/skills/system-spec-kit/shared/review-research-paths.cjs'); console.log(JSON.stringify(resolveArtifactRoot('{spec_folder}', 'review')));\\\"\"\n231:       outputs:\n232:         - artifact_root_dir: \"Resolved local review owner directory\"\n233:         - artifact_subfolder: \"Local packet subfolder ({ownerSlug}-pt-{NN}), else null\"\n234:         - artifact_dir: \"Resolved review packet directory for this target\"\n235:         - artifact_archive_root: \"Resolved local review archive directory for this target\"\n236: \n237:   step_bind_reducer_artifact_arg:\n238:     description: \"Keep the reducer on the lineage-owned artifact directory during fan-out\"\n239:     branch_on: \"config.fanout_lineage_artifact_dir\"\n240:     if_present:\n241:       bind:\n242:         reducer_artifact_arg: \"--artifact-dir {artifact_dir}\"\n243:     if_absent:\n244:       bind:\n245:         reducer_artifact_arg: \"\"\n246: \n247:   step_apply_lifecycle_request:\n248:     description: \"Honor an explicit restart request before fan-out or normal initialization\"\n249:     dry_run_boundary: \"state-mutation\"\n250:     skip_when: \"lineage_mode != 'restart'\"\n251:     instructions: |\n252:       Run this step in both execution modes, immediately after artifact resolution\n253:       and before fan-out, so old packet files cannot be merged with fresh lineage\n254:       outputs. A restart request must never fall back to resume. The explicit\n255:       restart flag is operator authorization to archive the resolved review packet,\n256:       so do not ask for a second confirmation. Rollback is to move the timestamped\n257:       archive back to the packet directory.\n258:     bind_prior_lineage:\n259:       action: \"Read the session id and generation of the packet that is about to be archived\"\n260:       command: |\n261:         node -e '\n262:           const fs = require(\"fs\");\n263:           const crypto = require(\"crypto\");\n264:           let priorSessionId = null;\n265:           let priorGeneration = 0;\n266:           try {\n267:             const config = JSON.parse(fs.readFileSync(process.argv[1], \"utf8\"));\n268:             const lineage = config.lineage || config;\n269:             priorSessionId = typeof lineage.sessionId === \"string\" ? lineage.sessionId : null;\n270:             priorGeneration = Number(lineage.generation) || 0;\n271:           } catch (error) {\n272:             if (error.code !== \"ENOENT\") {\n273:               console.error(\"The old config cannot be read: \" + error.message);\n274:               process.exit(1);\n275:             }\n276:           }\n277:           let priorTailDigest = crypto.createHash(\"sha256\").update(\"\").digest(\"hex\");\n278:           try {\n279:             priorTailDigest = crypto.createHash(\"sha256\").update(fs.readFileSync(process.argv[2])).digest(\"hex\");\n280:           } catch (error) {\n281:             if (error.code !== \"ENOENT\") throw error;\n282:           }\n283:           console.log(JSON.stringify({ priorSessionId, priorGeneration, priorTailDigest }));\n284:         ' \"{state_paths.config}\" \"{state_paths.state_log}\"\n285:       outputs:\n286:         - prior_session_id: \"priorSessionId from the JSON output, null when no old config exists\"\n287:         - prior_generation: \"priorGeneration from the JSON output, 0 when no old config exists\"\n288:         - prior_tail_digest: \"priorTailDigest from the JSON output: the sha256 of the old state log bytes, or of zero bytes when no old state log exists\"\n289:       on_fail: \"Halt with STATUS=FAIL. The old config is unreadable, so repair or archive the packet by hand.\"\n290:     command: |\n291:       if [ -e \"{state_paths.archive_root}/{timestamp_slug}\" ]; then\n292:         echo \"The archive folder {state_paths.archive_root}/{timestamp_slug} is already there.\" >&2\n293:         exit 1\n294:       fi\n295:       if [ -d \"{state_paths.packet_dir}\" ]; then\n296:         mkdir -p \"{state_paths.archive_root}\" && mv \"{state_paths.packet_dir}\" \"{state_paths.archive_root}/{timestamp_slug}\" || exit 1\n297:       fi\n298:       mkdir -p \"{state_paths.packet_dir}\"\n299:     outputs:\n300:       - archived_path: \"{state_paths.archive_root}/{timestamp_slug} when a prior packet existed, else null\"\n301:       - lineage_mode: \"restart\"\n302:     on_fail: \"Halt with STATUS=FAIL; do not continue as resume or auto.\"\n303: \n304:   step_fanout_spawn:\n305:     description: \"Spawn fan-out lineages; skip and proceed to phase_init normally when single-executor\"\n306:     dry_run_boundary: \"child-spawn\"\n307:     skip_when: \"config.fanout is absent\"\n308:     instructions: |\n309:       Fan-out mode is active. Spawn all lineages. Each lineage runs the full loop in its own\n310:       isolated sub-packet under {artifact_dir}/lineages/{label}/.\n311:       This step runs before phase_init, so pass the raw review_focus. fanout-run.cjs\n312:       normalizes it and hands every lineage the same single-line text. Escape any double\n313:       quote, backslash, dollar sign or backtick in it for the shell, and pass an empty\n314:       string when no focus was given.\n315:       A cli-opencode lineage inside this fan-out is an explicit parallel-detached OpenCode\n316:       session with a separate lineage directory and session id; it is not the single-executor\n317:       self-invocation path. fanout-run.cjs owns the stack-only recursion guard for that\n318:       first-level detached lineage and still blocks recursive same-kind dispatch from inside it.\n319:       fanout-run.cjs owns native and CLI lineage execution; native is run through the\n320:       deep/review command surface with config.fanout_lineage_artifact_dir so the LEAF\n321:       deep-review agent is used only for individual iterations, never as a full-loop\n322:       sub-agent or pasted phase-running prompt.\n323:       After all lineages complete, jump directly to phase_synthesis — skip phase_init and\n324:       phase_main_loop entirely (those are the single-executor path). The merge step in\n325:       phase_synthesis will consolidate results across all lineages.\n326:     sub_steps:\n327:       step_fanout_spawn_cli:\n328:         description: \"Spawn all native and CLI lineages in capped worker pool\"\n329:         skip_when: \"no entries in config.fanout.executors\"\n330:         command: |\n331:           node .skilled/skills/system-deep-loop/runtime/scripts/fanout-run.cjs \\\n332:             --spec-folder {spec_folder} \\\n333:             --loop-type review \\\n334:             --review-focus \"{review_focus}\" \\\n335:             --review-target \"{review_target}\" \\\n336:             --review-target-type {review_target_type} \\\n337:             --fanout-config-json '{config.fanout_json}' \\\n338:             --base-artifact-dir {artifact_dir} \\\n339:             --convergence-threshold {convergence_threshold} \\\n340:             --stop-policy {stop_policy} \\\n341:             --convergence-mode {convergence_mode}\n342:         working_directory: \"{repo_root}\"\n343:         wait_for_completion: true\n344:         optional_flags: \"When lineage_timeout_hours is bound, append `--lineage-timeout-hours {lineage_timeout_hours}` to the command. When it is unset, append nothing, which keeps the 4 hour ceiling.\"\n345: \n346:   # ════════\n347:   # PHASE 1: INITIALIZATION\n348:   # ════════\n349:   phase_init:\n350:     purpose: Create all state files for the review session and resolve review scope\n351:     steps:\n352: \n353:       step_preflight_contract:\n354:         action: \"Validate required setup bindings and executable workflow contract before any file writes\"\n355:         verify:\n356:           - required_values_present: [review_target, review_target_type, review_dimensions, spec_folder, lineage_mode, max_iterations, convergence_threshold, convergence_mode, stop_policy]\n357:           - dry_run_normalized: \"Boolean true or false before workflow loading; absent flag resolves to false.\"\n358:           - spec_folder_is_within: \"specs/ or .opencode/specs/ (canonicalize alias roots before validation)\"\n359:           - unresolved_placeholders: \"FAIL if any user-facing template references placeholders not produced by earlier steps\"\n360:           - tool_contract: \"FAIL if executable steps reference tools outside the command allowlist\"\n361:         on_fail: \"Halt with STATUS=FAIL and report the missing binding or unsupported contract reference\"\n362: \n363:       step_create_directories:\n364:         action: \"Create spec folder and canonical review packet directories if they don't exist\"\n365:         dry_run_boundary: \"state-mutation\"\n366:         command: \"mkdir -p {state_paths.prompt_dir} {state_paths.iteration_dir} {state_paths.delta_dir}\"\n367: \n368:       step_detect_resource_map:\n369:         action: \"Detect resource-map.md before config creation so init can persist coverage-gate state\"\n370:         inspect:\n371:           - \"{spec_folder}/resource-map.md\"\n372:         classify:\n373:           present: \"resource-map.md exists at init\"\n374:           absent: \"resource-map.md does not exist at init\"\n375:         outputs:\n376:           - resource_map_present: \"Boolean true when {spec_folder}/resource-map.md exists, else false\"\n377:           - resource_map_known_context: \"When present: concise resource-map snapshot for Known Context and charter framing. When absent: 'resource-map.md not present; skipping coverage gate'.\"\n378: \n379:       step_migrate_legacy_review_state:\n380:         action: \"Rehome legacy review artifacts into review/iterations before session classification\"\n381:         dry_run_boundary: \"state-mutation\"\n382:         detect:\n383:           canonical_review_state:\n384:             - \"{state_paths.config}\"\n385:             - \"{state_paths.state_log}\"\n386:             - \"{state_paths.findings_registry}\"\n387:             - \"{state_paths.strategy}\"\n388:           legacy_review_state:\n389:             - \"{spec_folder}/scratch/deep-research-config.json\"\n390:             - \"{spec_folder}/scratch/deep-research-state.jsonl\"\n391:             - \"{spec_folder}/scratch/deep-review-strategy.md\"\n392:             - \"{spec_folder}/scratch/deep-review-dashboard.md\"\n393:             - \"{spec_folder}/scratch/iteration-*.md\"\n394:             - \"{spec_folder}/scratch/.deep-research-pause\"\n395:             - \"{state_paths.local_packet_dir}/iteration-*.md\"\n396:             - \"{state_paths.legacy_root_report}\"\n397:           legacy_review_markers:\n398:             - \"scratch/deep-review-strategy.md exists\"\n399:             - \"scratch/deep-research-config.json declares mode == 'review' OR scratch/deep-research-state.jsonl contains mode == 'review'\"\n400:         migrate_only:\n401:           - \"{spec_folder}/scratch/deep-research-config.json -> {state_paths.config}\"\n402:           - \"{spec_folder}/scratch/deep-research-state.jsonl -> {state_paths.state_log}\"\n403:           - \"{spec_folder}/scratch/deep-review-strategy.md -> {state_paths.strategy}\"\n404:           - \"{spec_folder}/scratch/deep-review-dashboard.md -> {state_paths.dashboard}\"\n405:           - \"{spec_folder}/scratch/iteration-*.md -> {state_paths.iteration_dir}/\"\n406:           - \"{spec_folder}/scratch/.deep-research-pause -> {state_paths.pause_sentinel}\"\n407:           - \"{state_paths.local_packet_dir}/iteration-*.md -> {state_paths.iteration_dir}/\"\n408:           - \"{state_paths.legacy_root_report} -> {state_paths.review_output}\"\n409:         on_canonical_present: \"Leave canonical review/ state untouched and do not overwrite it with legacy scratch artifacts.\"\n410:         on_legacy_detected: \"Move only the review-specific whitelist, print LEGACY_REVIEW_STATE_MOVED and leave unrelated scratch files untouched. Nothing is appended here: an append before session classification would create the state log and turn a fresh packet into a partial one, and the moved state log was written without the ledger, so the gateway refuses every append to it until step_classify_session.on_moved_legacy_state adopts it.\"\n411:         on_conflict: \"If canonical review/ state and legacy scratch review state both exist but disagree, halt for operator repair instead of merging contradictory state.\"\n412:         outputs:\n413:           - legacy_migration_detected: \"true when the command printed LEGACY_REVIEW_STATE_MOVED, else false\"\n414:           - migration_recorded: \"false; step_record_artifact_migration sets it once the migration row is appended\"\n415:         command: |\n416:           mkdir -p {state_paths.iteration_dir}\n417:           if [ ! -e {state_paths.config} ] && [ ! -e {state_paths.state_log} ] && [ ! -e {state_paths.strategy} ] && [ -e {spec_folder}/scratch/deep-review-strategy.md ] && ( [ -e {spec_folder}/scratch/deep-research-config.json ] || [ -e {spec_folder}/scratch/deep-research-state.jsonl ] ); then\n418:             [ -e {spec_folder}/scratch/deep-research-config.json ] && mv {spec_folder}/scratch/deep-research-config.json {state_paths.config}\n419:             [ -e {spec_folder}/scratch/deep-research-state.jsonl ] && mv {spec_folder}/scratch/deep-research-state.jsonl {state_paths.state_log}\n420:             [ -e {spec_folder}/scratch/deep-review-strategy.md ] && mv {spec_folder}/scratch/deep-review-strategy.md {state_paths.strategy}\n421:             [ -e {spec_folder}/scratch/deep-review-dashboard.md ] && mv {spec_folder}/scratch/deep-review-dashboard.md {state_paths.dashboard}\n422:             find {spec_folder}/scratch -maxdepth 1 -name 'iteration-*.md' -exec mv {} {state_paths.iteration_dir}/ \\;\n423:             [ -e {spec_folder}/scratch/.deep-research-pause ] && mv {spec_folder}/scratch/.deep-research-pause {state_paths.pause_sentinel}\n424:             [ -e {state_paths.legacy_root_report} ] && mv {state_paths.legacy_root_report} {state_paths.review_output}\n425:             echo \"LEGACY_REVIEW_STATE_MOVED\"\n426:           fi\n427:           find {state_paths.local_packet_dir} -maxdepth 1 -name 'iteration-*.md' -exec mv {} {state_paths.iteration_dir}/ \\; 2>/dev/null || true\n428: \n429:       step_acquire_lock:\n430:         action: \"Acquire the single-writer advisory lock before session classification\"\n431:         dry_run_boundary: \"state-mutation\"\n432:         ttl_ms: \"lock_ttl_ms = max(1800000, executor_timeout * 1000). executor_timeout is the bound dispatch timeout in seconds, 900 when unset. The lock is stale after twice this value, so it outlives the longest allowed dispatch.\"\n433:         command: \"node .skilled/skills/system-deep-loop/runtime/scripts/loop-lock.cjs acquire --lock-path {state_paths.lock_file} --packet-id {spec_folder} --ttl-ms {lock_ttl_ms}\"\n434:         on_acquire: \"Capture lock.ownerPid as captured_owner_pid and lock.acquireNonce as captured_acquire_nonce from the JSON output, and reuse both for every release below. If acquired=false, fail closed — another deep-review run already holds this packet. Under confirm, mode_overrides.confirm.lock_not_acquired applies instead.\"\n435:         note: \"Uses the promoted runtime/ loop-lock CLI (single source of truth: stale-lock reclaim, clean owner-scoped release). macOS/BSD locking is advisory — best-effort single-writer, not a hard mutex across host calls. Acquire reclaims a stale lock itself and reports the old holder under `reclaimed`. A lock is stale when its heartbeat is older than twice its TTL, or when its owning process is known to be dead. No confirmation step exists in either mode: log a `reclaimed` holder and continue.\"\n436:         # Lock-cleanup contract: the lock file MUST be released on every terminal exit path that follows acquisition.\n437:         # Runtimes honoring step_acquire_lock are required to perform this cleanup before halting or pausing.\n438:         on_halt:\n439:           action: \"Every terminal halt after the acquire runs step_release_lock before it returns control\"\n440:           command: \"node .skilled/skills/system-deep-loop/runtime/scripts/loop-lock.cjs release --lock-path {state_paths.lock_file} --owner-pid {captured_owner_pid} --nonce {captured_acquire_nonce}; failures here are logged but do not block the halt\"\n441:         on_cancel:\n442:           action: \"Release the lock on user cancel or pause-sentinel detection before sentinel processing\"\n443:           command: \"node .skilled/skills/system-deep-loop/runtime/scripts/loop-lock.cjs release --lock-path {state_paths.lock_file} --owner-pid {captured_owner_pid} --nonce {captured_acquire_nonce}; cancel completes regardless of cleanup result\"\n444:         on_workflow_exit:\n445:           action: \"Release the lock as the final step of any workflow exit path (success or failure)\"\n446:           command: \"node .skilled/skills/system-deep-loop/runtime/scripts/loop-lock.cjs release --lock-path {state_paths.lock_file} --owner-pid {captured_owner_pid} --nonce {captured_acquire_nonce}; idempotent — safe to invoke when already released\"\n447: \n448:       step_classify_session:\n449:         action: \"Classify the session before writing files\"\n450:         inspect:\n451:           - \"{state_paths.config}\"\n452:           - \"{state_paths.state_log}\"\n453:           - \"{state_paths.findings_registry}\"\n454:           - \"{state_paths.strategy}\"\n455:         classify:\n456:           fresh: \"None of the three state artifacts exist\"\n457:           resume: \"Config, JSONL, and strategy all exist and config.mode == 'review' and agree on target/spec folder\"\n458:           completed-session: \"Resume artifacts exist and config.status == 'complete'\"\n459:           invalid-state: \"Any partial, missing, or contradictory combination\"\n460:         outputs:\n461:           - session_state: \"fresh | resume | completed-session | invalid-state\"\n462:           - prior_tail_digest: \"sha256 of the state log bytes when resuming or restarting an existing lineage\"\n463:         lifecycle_routing:\n464:           - \"If lineage_mode == restart, step_apply_lifecycle_request archived the packet before the lock was taken, so session_state is fresh and on_fresh runs.\"\n465:           - \"If lineage_mode == auto or lineage_mode == resume, preserve the existing resume/completed/fresh behavior.\"\n466:         on_resume:\n467:           before_append: \"Run on_moved_legacy_state first when it applies.\"\n468:           log: \"Auto-resume: state artifacts are complete and consistent. Continue the same lineage (sessionId unchanged, generation unchanged, no archive).\"\n469:           append_jsonl: '{\"stem\":\"deep_review.run_resumed\",\"scope\":{\"runId\":\"{session_id}\",\"sessionId\":\"{session_id}\",\"generation\":{generation}},\"data\":{\"priorTailDigest\":\"{prior_tail_digest}\",\"sourceSessionId\":\"{session_id}\",\"resumeReason\":\"Auto-resume: state artifacts are complete and consistent; continue the same lineage.\",\"continuedFromRunId\":\"{session_id}-i{iteration_count}\",\"compatibilityDecision\":\"exact\",\"recoveryReceiptRef\":\"none\"}}'\n470:           skip_to: phase_loop\n471:           confirm_choice:\n472:             applies_to: confirm\n473:             preempts: \"Under confirm this block runs in place of the sibling log, append_jsonl and skip_to keys of on_resume. Under auto it is skipped and those keys run.\"\n474:             show_dashboard: \"{state_paths.dashboard}\"\n475:             ask: \"Existing review session is consistent. Resume where it left off, or restart (archive the current review packet under the root-level review-archive/ tree and start a fresh session)?\"\n476:             after_gate_refresh_lock: gate_defaults.after_gate_refresh_lock\n477:             options: [resume, restart, cancel]\n478:             on_resume_choice:\n479:               dry_run_boundary: \"state-mutation\"\n480:               before_append: \"Run on_moved_legacy_state first when it applies.\"\n481:               set:\n482:                 lineage_mode: \"resume\"\n483:                 parent_session_id: \"{session_id}\"\n484:               append_jsonl: '{\"stem\":\"deep_review.run_resumed\",\"scope\":{\"runId\":\"{session_id}\",\"sessionId\":\"{session_id}\",\"generation\":{generation}},\"data\":{\"priorTailDigest\":\"{prior_tail_digest}\",\"sourceSessionId\":\"{session_id}\",\"resumeReason\":\"Auto-resume: state artifacts are complete and consistent; continue the same lineage.\",\"continuedFromRunId\":\"{session_id}-i{iteration_count}\",\"compatibilityDecision\":\"exact\",\"recoveryReceiptRef\":\"none\"}}'\n485:               skip_to: gate_init_approval\n486:             on_restart_choice:\n487:               dry_run_boundary: \"state-mutation\"\n488:               bind_prior_lineage:\n489:                 action: \"Read the session id and generation of the packet that is about to be archived\"\n490:                 command: |\n491:                   node -e '\n492:                     const fs = require(\"fs\");\n493:                     const crypto = require(\"crypto\");\n494:                     let priorSessionId = null;\n495:                     let priorGeneration = 0;\n496:                     try {\n497:                       const config = JSON.parse(fs.readFileSync(process.argv[1], \"utf8\"));\n498:                       const lineage = config.lineage || config;\n499:                       priorSessionId = typeof lineage.sessionId === \"string\" ? lineage.sessionId : null;\n500:                       priorGeneration = Number(lineage.generation) || 0;\n501:                     } catch (error) {\n502:                       if (error.code !== \"ENOENT\") {\n503:                         console.error(\"The old config cannot be read: \" + error.message);\n504:                         process.exit(1);\n505:                       }\n506:                     }\n507:                     let priorTailDigest = crypto.createHash(\"sha256\").update(\"\").digest(\"hex\");\n508:                     try {\n509:                       priorTailDigest = crypto.createHash(\"sha256\").update(fs.readFileSync(process.argv[2])).digest(\"hex\");\n510:                     } catch (error) {\n511:                       if (error.code !== \"ENOENT\") throw error;\n512:                     }\n513:                     console.log(JSON.stringify({ priorSessionId, priorGeneration, priorTailDigest }));\n514:                   ' \"{state_paths.config}\" \"{state_paths.state_log}\"\n515:                 outputs:\n516:                   - prior_session_id: \"priorSessionId from the JSON output, null when no old config exists\"\n517:                   - prior_generation: \"priorGeneration from the JSON output, 0 when no old config exists\"\n518:                   - prior_tail_digest: \"priorTailDigest from the JSON output: the sha256 of the old state log bytes, or of zero bytes when no old state log exists\"\n519:                 on_fail: \"Halt with STATUS=FAIL through step_release_lock. The old config is unreadable, so repair or archive the packet by hand.\"\n520:               command: |\n521:                 if [ -e \"{state_paths.archive_root}/{timestamp_slug}\" ]; then\n522:                   echo \"The archive folder {state_paths.archive_root}/{timestamp_slug} is already there.\" >&2\n523:                   exit 1\n524:                 fi\n525:                 mkdir -p \"{state_paths.archive_root}/{timestamp_slug}\" || exit 1\n526:                 find \"{state_paths.packet_dir}\" -mindepth 1 -maxdepth 1 ! -name \"$(basename \"{state_paths.lock_file}\")\" -exec mv {} \"{state_paths.archive_root}/{timestamp_slug}/\" \\; || exit 1\n527:                 mkdir -p \"{state_paths.prompt_dir}\" \"{state_paths.iteration_dir}\" \"{state_paths.delta_dir}\"\n528:               on_fail: \"Halt with STATUS=FAIL through step_release_lock. Never fall back to resume.\"\n529:               set:\n530:                 lineage_mode: \"restart\"\n531:               skip_to: step_create_config\n532:             on_cancel_choice:\n533:               halt: true\n534:               release_lock: step_release_lock\n535:               message: \"Review session preserved. Manually archive or edit review/ before re-running.\"\n536:         on_restart:\n537:           action: \"Nothing is archived here. step_apply_lifecycle_request archived the packet before the lock was taken, so a restart run reaches this step as fresh and continues as on_fresh.\"\n538:         note_deferred_branches: \"fork and completed-continue are deferred and no longer runtime-supported in this release. The reducer still reads `lineageMode` from config for dashboards and analysis, but only `new`, `resume`, and `restart` are live. See deep-review/references/protocol/loop-protocol.md §Lifecycle Branches for the one-session contract.\"\n539:         on_moved_legacy_state:\n540:           applies_when: \"legacy_migration_detected == true and the branch taken resumes the session or goes to synthesis; never on restart or cancel\"\n541:           order: \"Runs after classification and before that branch appends anything, the resume event included.\"\n542:           note: |\n543:             The state log moved out of scratch/ was written by hand before the ledger existed, so the\n544:             gateway refuses every append to it. Set it aside unchanged as deep-review-state.legacy.jsonl,\n545:             open the run from the moved config, then replay its iteration rows through the gateway,\n546:             which carries each one whole. Rows the gateway cannot carry stay only in the set-aside file,\n547:             and the replay reports how many. Exit 2 from any of the three is a halt.\n548:           set_aside_command: |\n549:             STATE_LOG=\"{state_paths.state_log}\"\n550:             LEGACY_LOG=\"$(dirname \"$STATE_LOG\")/deep-review-state.legacy.jsonl\"\n551:             if [ -e \"$LEGACY_LOG\" ]; then\n552:               echo \"A set-aside legacy state log already exists at $LEGACY_LOG. Repair the packet by hand.\" >&2\n553:               exit 1\n554:             fi\n555:             mv \"$STATE_LOG\" \"$LEGACY_LOG\"\n556:           open_run: \"Run step_create_state_log.command unchanged. With the hand-written log set aside, it opens the run from the moved config.\"\n557:           replay_command: |\n558:             GATEWAY=\".skilled/skills/system-deep-loop/runtime/scripts/append-mode-event.cjs\"\n559:             [ -f \"$GATEWAY\" ] || GATEWAY=\"scripts/append-mode-event.cjs\"\n560:             RUN_DIR=\"$(dirname \"{state_paths.state_log}\")\"\n561:             node -e '\n562:               const fs = require(\"fs\"), os = require(\"os\"), path = require(\"path\");\n563:               const { spawnSync } = require(\"child_process\");\n564:               const [gateway, legacyLog, runDir] = process.argv.slice(1);\n565:               let replayedIterations = 0;\n566:               let keptOnlyInLegacyLog = 0;\n567:               for (const line of fs.readFileSync(legacyLog, \"utf8\").split(\"\\n\")) {\n568:                 if (line.trim() === \"\") continue;\n569:                 let row;\n570:                 try { row = JSON.parse(line); } catch { keptOnlyInLegacyLog += 1; continue; }\n571:                 // The run open already replaced the config row.\n572:                 if (row && row.type === \"config\") continue;\n573:                 if (!row || row.type !== \"iteration\") { keptOnlyInLegacyLog += 1; continue; }\n574:                 const tempDir = fs.mkdtempSync(path.join(os.tmpdir(), \"deep-review-replay-\"));\n575:                 const eventFile = path.join(tempDir, \"row.json\");\n576:                 fs.writeFileSync(eventFile, JSON.stringify(row));\n577:                 const result = spawnSync(process.execPath, [gateway, \"--mode\", \"review\", \"--run-directory\", runDir, \"--event-json\", eventFile], { encoding: \"utf8\" });\n578:                 fs.rmSync(tempDir, { recursive: true, force: true });\n579:                 if (result.status === 2) { process.stdout.write(result.stdout || \"\"); process.exit(2); }\n580:                 if (result.status === 0) replayedIterations += 1; else keptOnlyInLegacyLog += 1;\n581:               }\n582:               process.stdout.write(JSON.stringify({ replayedIterations, keptOnlyInLegacyLog, legacyLog }) + \"\\n\");\n583:             ' \"$GATEWAY\" \"$RUN_DIR/deep-review-state.legacy.jsonl\" \"$RUN_DIR\"\n584:         on_completed_session:\n585:           before_append: \"Run on_moved_legacy_state first when it applies.\"\n586:           log: \"Prior session already completed. Either archive the completed review/ tree and start a fresh session, or jump straight to synthesis with the existing artifacts.\"\n587:           skip_to: phase_synthesis\n588:         on_invalid_state:\n589:           halt: true\n590:           release_lock: step_release_lock\n591:           message: \"Existing deep-review state in review/ is incomplete or contradictory. Repair or archive the invalid review packet before continuing.\"\n592:         on_fresh:\n593:           action: \"Proceed with a new session\"\n594: \n595:       step_scope_discovery:\n596:         action: \"Resolve review target to a concrete file list based on target type\"\n597:         resolve:\n598:           spec-folder: |\n599:             1. Inspect spec.md, plan.md, tasks.md, acceptance-criteria.md, implementation-summary.md, and goal-file-manifest.txt when present\n600:             2. If goal-file-manifest.txt exists, parse one repo-relative path per non-empty, non-comment line; reject absolute paths, traversal outside repo_root, duplicates, missing paths, and non-file entries\n601:             3. Fail before dispatch with line-numbered validation errors when any manifest entry is invalid; otherwise set scope = the validated manifest paths in declared order\n602:             4. When no manifest exists, discover implementation files referenced in the canonical spec artifacts\n603:             5. Discover test files associated with the implementation files\n604:             6. Set scope = the packet's own canonical docs plus all discovered implementation and test files\n605:           skill: |\n606:             1. Read SKILL.md from .skilled/skills/{skill_name}/\n607:             2. Discover references/, assets/, scripts/ contents\n608:             3. Find agent definitions referencing this skill across runtimes\n609:             4. Find command entry points referencing this skill\n610:             5. Set scope = all discovered files\n611:           agent: |\n612:             1. Find agent definition across repo-managed runtimes (.claude/agents/, .skilled/agents/)\n613:             2. Compare agent definitions for consistency\n614:             3. Set scope = all discovered agent files\n615:           track: |\n616:             1. List all child spec folders under specs/{track}/ or .opencode/specs/{track}/\n617:             2. For each: read spec.md + acceptance-criteria.md\n618:             3. Set scope = all child spec artifacts\n619:           files: |\n620:             1. Expand glob patterns from review_target\n621:             2. Validate all files exist\n622:             3. Discover immediate cross-references (imports, links)\n623:             4. Set scope = expanded file list + cross-references\n624:         outputs:\n625:           - review_scope_files: \"List of all files in review scope\"\n626:           - cross_reference_targets: \"{ spec_paths: [...], code_paths: [...], test_paths: [...] }\"\n627: \n628:       step_order_dimensions:\n629:         action: \"Order review dimensions based on risk priority\"\n630:         algorithm: |\n631:           1. Iteration 0 (inventory pass): Build artifact map, identify file types, estimate complexity\n632:           2. Subsequent iterations follow risk-ordered deep passes:\n633:              correctness → security → traceability → maintainability\n634:           3. If review_dimensions != \"all\", filter to only requested dimensions\n635:           4. Derive traceability protocol plan:\n636:              - core: spec_code, checklist_evidence\n637:              - overlay: skill_agent, agent_cross_runtime, feature_catalog_code, playbook_capability\n638:           5. If resource_map_present, reserve at least one traceability-oriented pass to cross-check target_files from applied/T-*.md against resource-map.md and classify touched / expected-by-scope / gap / absent-from-map outcomes\n639:           6. Store ordered list as dimension_queue\n640:         outputs:\n641:           - dimension_queue: \"Ordered list of dimensions to review\"\n642:           - inventory_pass: true\n643: \n644:       step_normalize_review_dimensions:\n645:         action: \"Normalize reviewDimensions once during init for config + JSONL reuse\"\n646:         outputs:\n647:           - review_dimensions_normalized: \"Canonical string[] for deep-review-config.json\"\n648:           - review_dimensions_json: \"JSON.stringify(review_dimensions_normalized) for JSONL config record\"\n649:         normalize: |\n650:           Accept {review_dimensions} in any of these shapes and convert once:\n651:             - \"all\" → [\"correctness\",\"security\",\"traceability\",\"maintainability\"]\n652:             - \"correctness,security\" → [\"correctness\",\"security\"]\n653:             - [\"correctness\"] → [\"correctness\"]\n654:           Every element MUST be one of the four canonical dimension names.\n655: \n656:       step_normalize_review_focus:\n657:         action: \"Normalize the optional operator review focus once during init\"\n658:         outputs:\n659:           - review_focus_normalized: \"Single-line focus text, or empty string when no focus was given\"\n660:         normalize: |\n661:           Collapse every control character (C0, C1, DEL, U+2028, U+2029) and whitespace run to one space, trim, treat an empty result as absent, and fail setup when more than 1000 characters remain.\n662:           fanout-run.cjs applies the same rule in code, so a fan-out lineage receives the same text.\n663: \n664:       step_resolve_session_id:\n665:         action: \"Resolve init session id from caller when supplied, else preserve timestamp fallback\"\n666:         branch_on: \"session_id\"\n667:         if_present:\n668:           bind:\n669:             session_id_init: \"{session_id}\"\n670:         if_absent:\n671:           bind:\n672:             session_id_init: \"{ISO_8601_NOW}\"\n673: \n674:       step_create_config:\n675:         action: \"Create deep-review-config.json from template with review-specific fields\"\n676:         dry_run_boundary: \"state-mutation\"\n677:         template: .skilled/skills/system-deep-loop/deep-review/assets/deep-review-config.json\n678:         lineage_values:\n679:           generation_init: \"{prior_generation + 1} when lineage_mode == 'restart', else 1\"\n680:           lineage_mode_init: \"restart when lineage_mode == 'restart', else new\"\n681:           parent_session_id_init: \"{prior_session_id} when lineage_mode == 'restart', else null\"\n682:         populate:\n683:           topic: \"Review: {review_target}\"\n684:           mode: \"review\"\n685:           sessionId: \"{session_id_init}\"\n686:           parentSessionId: \"{parent_session_id_init}\"\n687:           lineageMode: \"{lineage_mode_init}\"\n688:           generation: \"{generation_init}\"\n689:           continuedFromRun: null\n690:           reviewTarget: \"{review_target}\"\n691:           reviewTargetType: \"{review_target_type}\"\n692:           # Reuse the single normalized init-time value from step_normalize_review_dimensions.\n693:           reviewDimensions: \"{review_dimensions_normalized}\"\n694:           # Null when review_focus_normalized is empty. The review report reads it back to show the focus.\n695:           reviewFocus: \"{review_focus_normalized}\"\n696:           resource_map_present: \"{resource_map_present}\"\n697:           reviewScopeFiles: \"{review_scope_files}\"\n698:           severityThreshold: \"P2\"\n699:           crossReference:\n700:             core: [\"spec_code\", \"checklist_evidence\"]\n701:             overlay: [\"skill_agent\", \"agent_cross_runtime\", \"feature_catalog_code\", \"playbook_capability\"]\n702:           maxIterations: \"{max_iterations}\"\n703:           # Semantic: weighted P0/P1/P2 severity ratio. See SKILL.md §\"Convergence Threshold Semantics\".\n704:           convergenceThreshold: \"{convergence_threshold}\"\n705:           antiConvergence.convergenceMode: \"{convergence_mode}\"\n706:           antiConvergence.divergent: {}\n707:           stopPolicy: \"{stop_policy}\"\n708:           stuckThreshold: 2\n709:           maxDurationMinutes: 120\n710:           specFolder: \"{spec_folder}\"\n711:           # Honor the parsed --no-resource-map flag from deep-review.md:71 (default true; false when flag is set).\n712:           # The markdown command parses $ARGUMENTS and binds {resource_map_emit} before this step runs.\n713:           resource_map.emit: \"{resource_map_emit}\"\n714:           createdAt: \"{ISO_8601_NOW}\"\n715:           status: \"initialized\"\n716:           releaseReadinessState: \"in-progress\"\n717:           executionMode: \"{execution_mode}\"\n718:         output: \"{state_paths.config}\"\n719: \n720:       step_create_state_log:\n721:         action: \"Open the run in the ledger: record deep_review.run_initialized through the append gateway, which writes the state log's first row\"\n722:         dry_run_boundary: \"state-mutation\"\n723:         note: |\n724:           The state log is a projection the gateway rebuilds from the ledger, so this step never writes\n725:           it directly. A config row written beside the ledger carries keys the projection cannot\n726:           rebuild, and the projection refuses to drop them, so every later append in the run would\n727:           commit to the ledger and then exit 2. Recording the run's opening as a ledger event makes\n728:           the projected config row the state log's first row from the start. The full config stays\n729:           in deep-review-config.json, which is what the reducer reads.\n730:         command: |\n731:           GATEWAY=\".skilled/skills/system-deep-loop/runtime/scripts/append-mode-event.cjs\"\n732:           [ -f \"$GATEWAY\" ] || GATEWAY=\"scripts/append-mode-event.cjs\"\n733:           EVENT_FILE=\"$(mktemp \"${TMPDIR:-/tmp}/deep-review-run-open.XXXXXX\")\"\n734:           node -e '\n735:             const fs = require(\"fs\"), crypto = require(\"crypto\");\n736:             const [configPath, workflowPath] = process.argv.slice(1);\n737:             const sha = (bytes) => crypto.createHash(\"sha256\").update(bytes).digest(\"hex\");\n738:             const raw = fs.readFileSync(configPath);\n739:             const config = JSON.parse(raw);\n740:             const targetTypes = { files: \"file\", file: \"file\", directory: \"directory\", \"spec-folder\": \"directory\", track: \"directory\", repository: \"repository\" };\n741:             const lineageModes = { new: \"fresh\", fresh: \"fresh\", restart: \"restart\", resume: \"resume\" };\n742:             // The projected config row shows this topic; one the schema cannot hold is left out,\n743:             // and the row falls back to the run id rather than the run failing to open.\n744:             const topic = typeof config.topic === \"string\" && config.topic.trim() !== \"\" && config.topic.length <= 4096\n745:               ? config.topic\n746:               : null;\n747:             process.stdout.write(JSON.stringify({\n748:               stem: \"deep_review.run_initialized\",\n749:               scope: { runId: config.sessionId, sessionId: config.sessionId, generation: Number(config.generation) || 1 },\n750:               data: {\n751:                 target: {\n752:                   targetId: \"review-target\",\n753:                   targetType: targetTypes[config.reviewTargetType] || \"artifact\",\n754:                   artifactRef: \"deep-review-config.json#reviewTarget\",\n755:                   sourceDigest: sha(String(config.reviewTarget)),\n756:                   contentDigest: sha(raw),\n757:                 },\n758:                 lineageMode: lineageModes[config.lineageMode] || \"fresh\",\n759:                 maxIterations: Number(config.maxIterations),\n760:                 convergencePolicyVersion: \"convergence-policy@\" + ((config.antiConvergence && config.antiConvergence.convergenceMode) || \"default\"),\n761:                 reviewModeContractDigest: sha(fs.readFileSync(workflowPath)),\n762:                 initialReleaseReadinessState: \"not-assessed\",\n763:                 ...(topic === null ? {} : { topic }),\n764:               },\n[Output truncated. Continue reading with offset: 765]"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\".skilled/commands/deep/assets/deep-review.yaml\"}"},"time":{"start":1794865337165,"end":1794865337402}}}}
{"type":"step_finish","timestamp":1794865338919,"sessionID":"ses_e19b0e5bfffeS7sVTvhEMa7jvO","part":{"id":"prt_1e64f9a270015Os9lF67lCD0lX","sessionID":"ses_e19b0e5bfffeS7sVTvhEMa7jvO","messageID":"msg_1e64f78f8001am4eL3cWBhfWMO","type":"step-finish","reason":"tool-calls","snapshot":"b1b966923c6d4213f5e02c3f91a98a53a2a66f86","cost":0,"tokens":{"input":672,"output":49,"reasoning":78,"cache":{"read":34816,"write":0}}}}
{"type":"step_start","timestamp":1794865342677,"sessionID":"ses_e19b0e5bfffeS7sVTvhEMa7jvO","part":{"id":"prt_1e64fa8d5001vjHceO64lTKs7A","sessionID":"ses_e19b0e5bfffeS7sVTvhEMa7jvO","messageID":"msg_1e64f9a2c001piAdE4nDR5hRUo","type":"step-start","snapshot":"b1b966923c6d4213f5e02c3f91a98a53a2a66f86"}}
{"type":"tool_use","timestamp":1794865343376,"sessionID":"ses_e19b0e5bfffeS7sVTvhEMa7jvO","part":{"partID":"prt_1e64faa2a002NTdR7f0Tae6oCf","sessionID":"ses_e19b0e5bfffeS7sVTvhEMa7jvO","messageID":"msg_1e64f9a2c001piAdE4nDR5hRUo","type":"tool","id":"call_75289776767543869a617b0a","tool":"read","state":{"status":"completed","input":{"path":".skilled/commands/deep/assets/deep-review.yaml","offset":765,"limit":700},"output":"Read file .skilled/commands/deep/assets/deep-review.yaml, lines 765-1332\n765:             }));\n766:           ' \"{state_paths.config}\" \".skilled/commands/deep/assets/deep-review.yaml\" > \"$EVENT_FILE\" || { rm -f \"$EVENT_FILE\"; exit 1; }\n767:           node \"$GATEWAY\" --mode review --run-directory \"$(dirname \"{state_paths.state_log}\")\" --event-json \"$EVENT_FILE\"\n768:           STATUS=$?\n769:           rm -f \"$EVENT_FILE\"\n770:           exit \"$STATUS\"\n771:         output: \"{state_paths.state_log}\"\n772: \n773:       step_record_restarted_run:\n774:         skip_when: \"lineage_mode != 'restart'\"\n775:         action: \"Record the restarted lineage after the run-open row so the restart marker never precedes deep_review.run_initialized\"\n776:         dry_run_boundary: \"state-mutation\"\n777:         append_jsonl: '{\"stem\":\"deep_review.run_restarted\",\"scope\":{\"runId\":\"{session_id}\",\"sessionId\":\"{session_id}\",\"generation\":{generation}},\"data\":{\"priorTailDigest\":\"{prior_tail_digest}\",\"archivedLineageId\":\"{prior_session_id}\",\"restartReason\":\"Restart requested: the prior review packet was archived and a new lineage segment opened.\",\"continuedFromRunId\":\"{prior_session_id}-i{iteration_count}\",\"compatibilityDecision\":\"exact\",\"recoveryReceiptRef\":\"none\"}}'\n778: \n779:       step_create_findings_registry:\n780:         action: \"Initialize reducer-owned review findings registry\"\n781:         dry_run_boundary: \"state-mutation\"\n782:         content: '{\"sessionId\":\"{session_id_init}\",\"generation\":{generation_init},\"lineageMode\":\"{lineage_mode_init}\",\"openFindings\":[],\"resolvedFindings\":[],\"repeatedFindings\":[],\"dimensionCoverage\":{\"correctness\":false,\"security\":false,\"traceability\":false,\"maintainability\":false},\"findingsBySeverity\":{\"P0\":0,\"P1\":0,\"P2\":0},\"openFindingsCount\":0,\"resolvedFindingsCount\":0,\"convergenceScore\":0.0}'\n783:         output: \"{state_paths.findings_registry}\"\n784: \n785:       step_create_strategy:\n786:         action: \"Create review strategy file from deep-review-strategy.md template\"\n787:         dry_run_boundary: \"state-mutation\"\n788:         template: .skilled/skills/system-deep-loop/deep-review/assets/deep-review-strategy.md\n789:         populate:\n790:           review_target: \"{review_target}\"\n791:           review_target_type: \"{review_target_type}\"\n792:           dimensions: \"{dimension_queue}\"\n793:           scope_files: \"{review_scope_files}\"\n794:           cross_reference_targets: \"{cross_reference_targets}\"\n795:           max_iterations: \"{max_iterations}\"\n796:           convergence_threshold: \"{convergence_threshold}\"\n797:           stop_policy: \"{stop_policy}\"\n798:         output: \"{state_paths.strategy}\"\n799: \n800:       step_seed_coverage_graph:\n801:         action: \"Seed the review coverage graph before the first convergence check\"\n802:         dry_run_boundary: \"state-mutation\"\n803:         transform: |\n804:           1. Convert review_scope_files into FILE nodes.\n805:           2. Convert review target groupings into coarse SLICE nodes only; do not expand SYMBOL\n806:              or DEPENDENCY nodes in review mode.\n807:           3. Emit COVERS edges from SLICE nodes to FILE nodes when the grouping is known.\n808:           4. Bind coverage_seed_source to \"scope_discovery\" and coverage_seed_confidence to 0.50.\n809:           5. When scope discovery yields no files, emit [] for both arrays; the upsert script\n810:              returns a warning and review continues with an empty graph.\n811:         bash: \"node .skilled/skills/system-deep-loop/runtime/scripts/upsert.cjs --spec-folder \\\"{spec_folder}\\\" --loop-type \\\"review\\\" --session-id \\\"{config.sessionId}\\\" --nodes '{coverage_seed_nodes_json}' --edges '{coverage_seed_edges_json}' --seed-source \\\"{coverage_seed_source}\\\" --seed-confidence \\\"{coverage_seed_confidence}\\\"\"\n812:         outputs:\n813:           - coverage_seed_nodes_json: \"Seed nodes for review SLICE and FILE kinds only\"\n814:           - coverage_seed_edges_json: \"Seed COVERS edges where review target groupings resolved\"\n815:           - coverage_seed_warning: \"Warning emitted when the seed batch inserts zero nodes, else empty\"\n816:         on_warning:\n817:           log: \"Coverage graph seed inserted zero nodes; continuing with an empty graph.\"\n818:           proceed: true\n819: \n820:       step_enrich_strategy_context:\n821:         action: \"Ensure Known Context is written only after strategy.md exists\"\n822:         dry_run_boundary: \"state-mutation\"\n823:         condition: \"prior_context_found\"\n824:         edit: \"{state_paths.strategy}\"\n825:         note: \"Append or replace the Known Context section with prior_context_summary and retained detail from prior_context\"\n826: \n827:       step_enrich_strategy_resource_map:\n828:         action: \"Inject resource-map status into Known Context after strategy.md exists\"\n829:         dry_run_boundary: \"state-mutation\"\n830:         edit: \"{state_paths.strategy}\"\n831:         note: \"When resource_map_present is true, append the resource_map_known_context snapshot and add Resource Map Coverage to the Review Charter. When false, append 'resource-map.md not present; skipping coverage gate'.\"\n832: \n833:       step_init_complete:\n834:         log: \"Initialization complete. Config, state, and strategy files created. Review scope: {review_scope_files_count} files, {dimension_queue_count} dimensions.\"\n835:         set: { current_iteration: 1, p0_count: 0, p1_count: 0, p2_count: 0 }\n836: \n837:       # ─── APPROVAL GATE: Post-Init ───\n838:       gate_init_approval:\n839:         applies_to: confirm\n840:         type: approval_gate\n841:         purpose: \"Show review scope, dimensions, and target files. Get approval to start loop.\"\n842:         present: |\n843:           ## Review Initialization Complete\n844: \n845:           **Review Target**: {review_target} ({review_target_type})\n846:           **Scope**: {review_scope_files_count} files\n847:           **Dimensions**: {dimension_queue}\n848:           **Max Iterations**: {max_iterations}\n849:           **Convergence Threshold**: {convergence_threshold}\n850:           **Known Context Summary**: {prior_context_summary}\n851: \n852:           **Files in scope:**\n853:           {review_scope_files_summary}\n854: \n855:           Review `{state_paths.strategy}` for the full scope and dimension ordering.\n856:           **State files located in**: {state_paths.packet_dir}/\n857: \n858:           Options:\n859:           A) Start review loop\n860:           B) Adjust scope or dimensions\n861:           C) Cancel\n862:         wait_for: \"User response\"\n863:         after_gate_refresh_lock: gate_defaults.after_gate_refresh_lock\n864:         on_A: { set: { current_iteration: 1, p0_count: 0, p1_count: 0, p2_count: 0 }, proceed_to: phase_loop }\n865:         on_B: { action: \"Apply user adjustments to strategy.md, scope, or dimensions\", return_to: gate_init_approval }\n866:         on_C: { action: \"Cancel workflow\", status: \"CANCELLED\", release_lock: step_release_lock }\n867: \n868:   # ════════\n869:   # PHASE 2: ITERATION LOOP\n870:   # ════════\n871:   phase_loop:\n872:     purpose: Dispatch review agent iterations until convergence\n873:     repeat: true\n874:     max_repeats: \"{max_iterations}\"\n875:     steps:\n876: \n877:       step_refresh_lock:\n878:         action: \"Refresh the packet lock heartbeat before the iteration begins\"\n879:         command: \"node .skilled/skills/system-deep-loop/runtime/scripts/loop-lock.cjs refresh --lock-path {state_paths.lock_file} --owner-pid {captured_owner_pid} --nonce {captured_acquire_nonce}\"\n880:         on_refresh: \"If the refresh output has refreshed:false, fail closed: lost the packet lock. This run no longer holds the packet, so run step_release_lock and stop rather than iterate without it.\"\n881: \n882:       step_record_artifact_migration:\n883:         action: \"Record the legacy review state move once per session, after the run is open\"\n884:         dry_run_boundary: \"state-mutation\"\n885:         skip_when: \"legacy_migration_detected != true or migration_recorded == true\"\n886:         append_jsonl: '{\"stem\":\"deep_review.migration\",\"scope\":{\"runId\":\"{session_id}\",\"sessionId\":\"{session_id}\"},\"data\":{\"mode\":\"review\",\"legacyArtifacts\":[\"deep-research-config.json\",\"deep-research-state.jsonl\",\".deep-research-pause\"],\"canonicalArtifacts\":[\"deep-review-config.json\",\"deep-review-state.jsonl\",\".deep-review-pause\"]}}'\n887:         set: { migration_recorded: true }\n888: \n889:       step_read_state:\n890:         action: \"Read current state from JSONL, strategy, and config\"\n891:         read:\n892:           - \"{state_paths.state_log}\"\n893:           - \"{state_paths.findings_registry}\"\n894:           - \"{state_paths.strategy}\"\n895:           - \"{state_paths.config}\"\n896:         extract:\n897:           - iteration_count: \"Count distinct run values (the integer iteration, else a numeric run) across lines where type === 'iteration'; a redispatched run counts once\"\n898:           - highest_run: \"Highest run value (the integer iteration, else a numeric run) across lines where type === 'iteration', else 0\"\n899:           - current_iteration: \"max(highest_run, iteration_count) + 1\"\n900:           - last_newFindingsRatio: \"Extract newFindingsRatio from last iteration record\"\n901:           - last_focus: \"Extract focus/dimension from latest iteration record, else 'none yet'\"\n902:           - ratio_prev: \"Extract newFindingsRatio from second-latest iteration record, else 'N/A'\"\n903:           - ratio_latest: \"Extract newFindingsRatio from latest iteration record, else 'N/A'\"\n904:           - next_dimension: \"When max_iterations >= 2, current_iteration == max_iterations and unfinished_core_protocols is non-empty, 'traceability': the last iteration under the cap finishes those core protocols. Otherwise the next uncovered dimension from dimension_queue in strategy.md.\"\n905:           - dimensions_covered: \"List of dimensions already reviewed\"\n906:           - dimensions_remaining: \"List of dimensions not yet reviewed\"\n907:           - dimension_coverage: \"covered / total dimensions\"\n908:           - coverage_age: \"Iterations since dimension coverage last changed; require >= 1 before STOP\"\n909:           - p0_count: \"findingsBySeverity.P0 from {state_paths.findings_registry}, the reducer's deduplicated count of open findings, else 0\"\n910:           - p1_count: \"findingsBySeverity.P1 from {state_paths.findings_registry}, else 0\"\n911:           - p2_count: \"findingsBySeverity.P2 from {state_paths.findings_registry}, else 0\"\n912:           - unfinished_core_protocols: \"registry.traceability.unfinishedCoreProtocols from {state_paths.findings_registry} as a JSON array, else []\"\n913:           - resource_map_present: \"Extract boolean from deep-review-config.json, default false\"\n914:           - resource_map_prompt_line: \"If resource_map_present is true, return 'Resource Map Coverage: cross-check target_files from {spec_folder}/applied/T-*.md against {spec_folder}/resource-map.md and classify only missed coverage as gaps.' Else return 'Resource Map Coverage: resource-map.md not present; skipping coverage gate.'\"\n915:           - session_id: \"Extract sessionId from deep-review-config.json\"\n916:           - generation: \"Extract generation from deep-review-config.json, else 1\"\n917:           - last_3_summaries: \"Summarize the latest 3 iteration records as 'run N: dimension (ratio, P0/P1/P2)'\"\n918:           - latest_status: \"Extract status from latest iteration record, else 'none yet'\"\n919:           - last_claim_adjudication_passed: \"Scan state.jsonl for the most recent `claim_adjudication` event; use its `passed` boolean. Default true when no event exists or when activeP0 + activeP1 == 0 (gate is vacuous without adjudicable findings).\"\n920:           - claim_adjudication_active_count: \"Count of active P0/P1 findings at the time of the last claim_adjudication event; 0 when none exist\"\n921:           - security_sensitive_fix_scope: \"Boolean true when the current review is a rerun after fixes involving security, path disclosure, auth/authz, sandboxing, env precedence, public schemas, persistence, or user-visible error payloads; derive from the latest review report, remediation notes, or planning packet when present, else false.\"\n922:           - fix_completeness_replay_required_rows: \"Count prior active or remediated P0/P1 findings, plus any prior security/path P2 findings, that require closed-gate replay before STOP.\"\n923:           - fix_completeness_replay_passing_rows: \"Count required replay rows marked PASS with file:line or command evidence and producer/consumer/matrix coverage.\"\n924:           - stop_policy: \"Extract stopPolicy from deep-review-config.json, default 'convergence'. Valid values: convergence, max-iterations.\"\n925:           - convergence_mode: \"Extract antiConvergence.convergenceMode when it is one of 'default', 'off', 'sliding-window', or 'divergent'; default to 'default'\"\n926:           - convergence_mode_warning: \"Boolean true when antiConvergence.convergenceMode is present with an unsupported value; use 'default'\"\n927:           - pivot_lineage: \"Summarize registry.divergence.completed and registry.divergence.overrides with pivot ids, source iterations, and selected review direction; else 'none yet'\"\n928:           - saturated_directions: \"List registry.divergence.saturatedDirections; else 'none yet'\"\n929:           - review_focus_block: \"When deep-review-config.json reviewFocus is a non-empty string, return 'Operator review focus (cover it in addition to the dimension of this iteration, and say in the narrative how you addressed it): <reviewFocus>'. Else return an empty string.\"\n930:           - unfinished_core_protocols_block: \"Under the same condition as next_dimension's traceability case, return 'This is the last iteration under the cap. Finish these core traceability protocols: <ids, comma-separated>. Record one traceabilityChecks.results[] entry for each. A result raised from partial to pass needs a file:line reference in evidenceRefs, or it stays partial.' Else return an empty string.\"\n931: \n932:       step_check_max_duration:\n933:         action: \"Stop the loop when the run has used its wall-clock budget, and still synthesize\"\n934:         command: |\n935:           node -e '\n936:             const config = JSON.parse(require(\"fs\").readFileSync(process.argv[1], \"utf8\"));\n937:             const maxDurationMinutes = Number(config.maxDurationMinutes);\n938:             const startedMs = Date.parse(config.createdAt);\n939:             const elapsedMinutes = Math.floor((Date.now() - startedMs) / 60000);\n940:             const reached = Number.isFinite(maxDurationMinutes) && maxDurationMinutes > 0\n941:               && Number.isFinite(startedMs) && elapsedMinutes >= maxDurationMinutes;\n942:             console.log(JSON.stringify({ elapsedMinutes, maxDurationMinutes, reached }));\n943:           ' \"{state_paths.config}\"\n944:         outputs:\n945:           - duration_reached: \"reached from the JSON output\"\n946:           - elapsed_minutes: \"elapsedMinutes from the JSON output\"\n947:         note: \"The clock starts at the createdAt of the current generation's config. A resume keeps it and a restart resets it, so paused and waiting time counts.\"\n948:         if_reached:\n949:           when: \"duration_reached == true\"\n950:           set: { decision: \"STOP\", reason: \"maxDurationReached\", stopReason: \"maxDurationReached\" }\n951:           bookkeeping_log: '{\"type\":\"event\",\"event\":\"maxDurationReached\",\"mode\":\"review\",\"run\":{current_iteration},\"stopReason\":\"maxDurationReached\",\"elapsedMinutes\":{elapsed_minutes},\"maxDurationMinutes\":{config.maxDurationMinutes},\"timestamp\":\"{ISO_8601_NOW}\",\"sessionId\":\"{session_id}\",\"generation\":{generation}}'\n952:           log: \"Duration limit reached after {elapsed_minutes} minutes. Skipping dispatch and entering synthesis with partial findings.\"\n953:           run_first: record_terminal_gates\n954:           skip_to: phase_synthesis\n955:           note: \"The stop row is printed, not appended: the gateway refuses an event it has no ledger stem for. The reason reaches the synthesis report through the bound reason.\"\n956:         if_not_reached:\n957:           action: \"Continue with the iteration\"\n958: \n959:       step_check_pause_sentinel:\n960:         action: \"Check for pause sentinel file\"\n961:         check: \"Does {state_paths.pause_sentinel} exist?\"\n962:         if_exists:\n963:           set:\n964:             pending_stop_event: \"paused\"\n965:             pending_stop_reason: \"userPaused\"\n966:             pending_stop_detail: \"sentinel file detected\"\n967:           skip_to: step_normalize_pause_events\n968:         if_not_exists:\n969:           proceed: true\n970: \n971:       step_validate_convergence_config:\n972:         action: \"Validate convergence mode when loading config\"\n973:         if_convergence_mode_invalid:\n974:           bookkeeping_log: '{\"type\":\"event\",\"event\":\"config_warning\",\"mode\":\"review\",\"field\":\"antiConvergence.convergenceMode\",\"fallback\":\"default\",\"message\":\"Unsupported convergenceMode; using default convergence behavior.\",\"timestamp\":\"{ISO_8601_NOW}\",\"sessionId\":\"{session_id}\",\"generation\":{generation}}'\n975:           dry_run_event_policy: preview-only\n976:           log: \"Unsupported convergenceMode; using default convergence behavior.\"\n977: \n978:       step_graph_convergence:\n979:         action: \"Run convergence.cjs once: it evaluates the coverage graph and computes the whole review stop decision\"\n980:         inspect:\n981:           - \"{state_paths.state_log}\"\n982:           - \"{state_paths.findings_registry}\"\n983:         transform: |\n984:           1. Call convergence.cjs once on the current review lineage. It returns the graph decision and the stop_decision object.\n985:           2. Record the decision as one of CONTINUE, STOP_ALLOWED, STOP_BLOCKED.\n986:           3. Preserve raw graph signals and blockers for reducer rollup and blocked-stop evidence.\n987:           4. Normalize blockers to both JSON array and CSV forms for downstream stop handling.\n988:           5. Set graph_stop_blocked = true only when graph_decision == \"STOP_BLOCKED\".\n989:         bash: 'node .skilled/skills/system-deep-loop/runtime/scripts/convergence.cjs --spec-folder \"{spec_folder}\" --loop-type \"review\" --session-id \"{session_id}\" --convergence-mode \"{convergence_mode}\" --stop-decision --config-path \"{state_paths.config}\" --state-log \"{state_paths.state_log}\" --registry-path \"{state_paths.findings_registry}\" --iteration-count \"{iteration_count}\" --security-sensitive-fix-scope \"{security_sensitive_fix_scope}\" --fix-replay-required-rows \"{fix_completeness_replay_required_rows}\" --fix-replay-passing-rows \"{fix_completeness_replay_passing_rows}\"'\n990:         note: \"The script is the only place the stop decision is computed. step_check_convergence branches on its stop_decision output.\"\n991:         append_jsonl: '{\"stem\":\"deep_review.graph_convergence_evaluated\",\"scope\":{\"runId\":\"{session_id}\",\"sessionId\":\"{session_id}\",\"generation\":{generation},\"iterationId\":\"iteration-{current_iteration}\"},\"data\":{\"rawSignals\":{graph_raw_signals_json},\"weightedSignals\":{graph_raw_signals_json},\"dimensionCoverageDigest\":\"{dimension_coverage_digest}\",\"protocolCoverageDigest\":\"{protocol_coverage_digest}\",\"findingStability\":\"{finding_stability}\",\"p0p1ResolutionState\":\"{p0p1_resolution_state}\",\"evidenceDensity\":{evidence_density},\"hotspotSaturation\":{hotspot_saturation},\"decision\":\"{graph_decision_code}\",\"policyFingerprint\":\"{policy_fingerprint}\",\"blockerIds\":{graph_blocker_ids_json},\"stopCandidate\":{stop_candidate},\"graphDecision\":\"{graph_decision_code}\",\"graphDigest\":\"{graph_digest}\",\"signals\":{graph_signals_json},\"blockers\":{graph_blockers_json}},\"eventId\":\"graph-{session_id}-g{generation}-i{current_iteration}\"}'\n992:         dry_run_event_policy: preview-only\n993:         on_missing_counters: \"If loop_counters_json is missing from the output, halt with stop reason error. Never bind a default counter. Run step_release_lock before the halt returns control.\"\n994:         outputs:\n995:           - graph_decision: \"CONTINUE | STOP_ALLOWED | STOP_BLOCKED\"\n996:           - stop_decision: \"Tool stop_decision object: decision, stopReason, reasonDetail, weightedStopScore, signals, gates, blockedBy, graphDecision, inputs\"\n997:           - loop_counters_json: \"Tool loop_counters_json object: stuckCount and consecutiveFailureCount, both rebuilt from the state log on this pass\"\n998:           - stuck_count: \"loop_counters_json.stuckCount\"\n999:           - consecutive_failure_count: \"loop_counters_json.consecutiveFailureCount\"\n1000:           - graph_decision_code: \"CONTINUE maps to continue, STOP_ALLOWED to converged, STOP_BLOCKED to blocked\"\n1001:           - graph_signals_json: \"JSON object returned by convergence.cjs\"\n1002:           - graph_raw_signals_json: \"Exact-field convergence-signals JSON built from the convergence.cjs signals; observationDigest is the sha256 of graph_signals_json\"\n1003:           - graph_blockers_json: \"JSON array of graph blockers when present, else []\"\n1004:           - graph_blocker_ids_json: \"JSON array of blocker type values; use [\\\"graph_blocker\\\"] when the decision is blocked and the list is empty\"\n1005:           - graph_blockers_csv: \"Comma-separated blocker summary when graph blocks STOP, else empty string\"\n1006:           - graph_stop_blocked: \"Boolean true when graph_decision == STOP_BLOCKED\"\n1007:           - dimension_coverage_digest: \"sha256 (64 lowercase hex) of the canonical JSON of the registry dimensionCoverage map\"\n1008:           - protocol_coverage_digest: \"sha256 (64 lowercase hex) of the canonical JSON of the protocol coverage object in graph_signals_json, or of {} when absent\"\n1009:           - finding_stability: \"stable when findingStabilityRatio >= convergenceThreshold, unstable when below, unknown when the signal is missing\"\n1010:           - p0p1_resolution_state: \"resolved when active P0 + P1 findings are 0, blocked when above 0, unknown when counts are unavailable\"\n1011:           - evidence_density: \"evidenceDensityRatio from graph_signals_json, capped at 1\"\n1012:           - hotspot_saturation: \"hotspotSaturationRatio from graph_signals_json, between 0 and 1\"\n1013:           - policy_fingerprint: \"sha256 (64 lowercase hex) of the canonical JSON {convergenceThreshold, stopPolicy, convergenceMode} from the review config\"\n1014:           - stop_candidate: \"true when graph_decision == STOP_ALLOWED, else false\"\n1015:           - graph_digest: \"sha256 (64 lowercase hex) of graph_signals_json\"\n1016: \n1017:       step_check_convergence:\n1018:         action: \"Branch on the stop decision that convergence.cjs computed in step_graph_convergence\"\n1019:         algorithm: |\n1020:           The whole stop decision is computed by convergence.cjs from the review config, the state log, the findings registry and the coverage graph. This step performs no arithmetic and never recomputes or overrides the result.\n1021:           The ratio signals leave out thought iterations and every iteration whose status is error or timeout, and stuck_count is loop_counters_json.stuckCount.\n1022:           The script applies this fixed order, first match wins:\n1023:           1. if iteration_count >= max_iterations: STOP (maxIterationsReached). This terminal cap is evaluated before every veto, the claim-adjudication veto included; failed legal-stop gates are recorded in stop_decision.blockedBy as synthesis evidence.\n1024:           1a. After 3 consecutive failed iterations (status error or timeout), halt the loop and enter synthesis with stop reason error and partial findings.\n1025:           2. if stuck_count >= config.stuckThreshold: STUCK_RECOVERY\n1026:           3. if convergence_mode == \"off\": skip convergence stop candidates and continue.\n1027:           3a. if stop_policy == \"max-iterations\" AND iteration_count < max_iterations: the vote is telemetry only and the decision is CONTINUE.\n1028:           4. a STOP candidate exists when every dimension is clean (all_dimensions_clean) or the weighted vote passes (composite_converged). The vote cutoffs follow the configured convergenceThreshold.\n1029:           5. the nine legal-stop gates run on a candidate: convergenceGate, dimensionCoverageGate, p0ResolutionGate, evidenceDensityGate, hotspotSaturationGate, claimAdjudicationGate, fixCompletenessReplayGate, candidateCoverageGate, graphlessFallbackGate. Any failed gate gives BLOCKED (blockedStop).\n1030:           6. the graph decision settles the candidate: STOP_ALLOWED keeps STOP, STOP_BLOCKED gives BLOCKED, CONTINUE or a missing graph decision gives CONTINUE.\n1031:           Bind the outputs from stop_decision, where G is stop_decision.gates and I is stop_decision.inputs.review:\n1032:             decision = stop_decision.decision\n1033:             stopReason = stop_decision.stopReason\n1034:             reason = stop_decision.stopReason when it is not null, else stop_decision.reasonDetail\n1035:             reason_detail = stop_decision.reasonDetail\n1036:             weighted_stop_score = stop_decision.weightedStopScore\n1037:             stop_blocked = (stop_decision.decision == \"BLOCKED\")\n1038:             blocked_by_json = stop_decision.blockedBy\n1039:             blocked_by_csv = the members of stop_decision.blockedBy joined with commas\n1040:             convergence_gate_pass = G.convergenceGate.pass\n1041:             convergence_gate_score = G.convergenceGate.score\n1042:             dimension_coverage_gate_pass = G.dimensionCoverageGate.pass\n1043:             dimension_coverage_gate_missing_json = G.dimensionCoverageGate.missing\n1044:             dimension_coverage_gate_covered_json = the configured review dimensions that are not in G.dimensionCoverageGate.missing\n1045:             p0_resolution_gate_pass = G.p0ResolutionGate.pass\n1046:             active_p0_count = G.p0ResolutionGate.activeP0\n1047:             evidence_density_gate_pass = G.evidenceDensityGate.pass\n1048:             avg_evidence_per_finding = I.evidenceBackedP0P1, the count of active P0 and P1 findings that carry file:line evidence\n1049:             hotspot_saturation_gate_pass = G.hotspotSaturationGate.pass\n1050:             claim_adjudication_gate_pass = G.claimAdjudicationGate.pass\n1051:             claim_adjudication_active_count = I.activeP0 plus I.activeP1\n1052:             fix_completeness_replay_gate_pass = G.fixCompletenessReplayGate.pass\n1053:             security_sensitive_fix_scope = I.securitySensitiveFixScope\n1054:             fix_completeness_replay_required_rows = I.fixReplayRequiredRows\n1055:             fix_completeness_replay_passing_rows = I.fixReplayPassingRows\n1056:             candidate_coverage_gate_pass = G.candidateCoverageGate.pass\n1057:             candidate_coverage_search_debt_json = I.searchDebt\n1058:             candidate_coverage_missing_json = the I.requiredBugClasses entries that are not in I.candidateCovered\n1059:             graphless_fallback_gate_pass = G.graphlessFallbackGate.pass\n1060:             graphless_fallback_mode = I.graphCoverageMode\n1061:             graphless_fallback_missing_json = the I.requiredBugClasses entries that are not in I.fallbackCoveredBugClasses\n1062:             graphless_fallback_unavailability_reason = the explicit reason when I.graphCoverageMode == \"unavailable_blocked\", else empty string\n1063:             graph_blocker_detail_json = graph_blockers_json\n1064:             recovery_strategy = one line naming the next review action for the gates in stop_decision.blockedBy. When claimAdjudicationGate is listed: \"Reviewer must add typed claim-adjudication packets (claim, evidenceRefs, counterevidenceSought, alternativeExplanation, finalSeverity, confidence, downgradeTrigger) for every active P0/P1 finding before STOP is allowed.\" When stop_decision.reasonDetail == \"graphStopBlocked\": \"Resolve review coverage-graph blockers before stopping.\" When candidateCoverageGate and graphlessFallbackGate both fail, combine their guidance. When I.unfinishedCoreProtocols is non-empty, name them and say the last iteration under the cap is reserved for them, each needing file:line evidence.\n1065:           If stop_decision is missing from the step_graph_convergence output, do not decide by hand: halt and report the script output.\n1066:         outputs:\n1067:           - decision: \"STOP | BLOCKED | STUCK_RECOVERY | CONTINUE\"\n1068:           - reason: \"stop_decision.stopReason when set, else stop_decision.reasonDetail\"\n1069:           - reason_detail: \"stop_decision.reasonDetail, the fine cause behind the decision\"\n1070:           - weighted_stop_score: \"stop_decision.weightedStopScore, for diagnostics only\"\n1071:           - stop_blocked: \"Boolean true when STOP is vetoed by inline legal-stop gates or graph_decision == STOP_BLOCKED\"\n1072:           - blocked_by_json: \"JSON array of failed legal-stop gates when decision == BLOCKED\"\n1073:           - blocked_by_csv: \"Comma-separated list of failed legal-stop gates when decision == BLOCKED\"\n1074:           - convergence_gate_pass: \"Boolean pass/fail for convergenceGate\"\n1075:           - convergence_gate_score: \"Numeric score recorded for convergenceGate\"\n1076:           - dimension_coverage_gate_pass: \"Boolean pass/fail for dimensionCoverageGate\"\n1077:           - dimension_coverage_gate_covered_json: \"JSON array of covered review dimensions\"\n1078:           - dimension_coverage_gate_missing_json: \"JSON array of missing review dimensions\"\n1079:           - p0_resolution_gate_pass: \"Boolean pass/fail for p0ResolutionGate\"\n1080:           - active_p0_count: \"Active P0 finding count at stop-check time\"\n1081:           - evidence_density_gate_pass: \"Boolean pass/fail for evidenceDensityGate\"\n1082:           - avg_evidence_per_finding: \"Numeric evidence density for active findings\"\n1083:           - hotspot_saturation_gate_pass: \"Boolean pass/fail for hotspotSaturationGate\"\n1084:           - claim_adjudication_gate_pass: \"Boolean pass/fail for claimAdjudicationGate (false vetoes STOP)\"\n1085:           - claim_adjudication_active_count: \"Count of active P0/P1 findings evaluated by claimAdjudicationGate\"\n1086:           - fix_completeness_replay_gate_pass: \"Boolean pass/fail for fixCompletenessReplayGate (false vetoes STOP on security-sensitive fix reruns)\"\n1087:           - security_sensitive_fix_scope: \"Boolean true when the review is a security-sensitive fix rerun\"\n1088:           - fix_completeness_replay_required_rows: \"Count of closed-gate replay rows required before STOP\"\n1089:           - fix_completeness_replay_passing_rows: \"Count of required closed-gate replay rows that passed with evidence\"\n1090:           - candidate_coverage_gate_pass: \"Boolean pass/fail for candidateCoverageGate (false vetoes STOP for unresolved reducer-owned search debt or uncovered required bug classes)\"\n1091:           - candidate_coverage_search_debt_json: \"JSON array of reducer-owned searchDebt obligations used as blocked-stop evidence\"\n1092:           - candidate_coverage_missing_json: \"JSON array of required bug classes missing from candidateCoverage.covered\"\n1093:           - graphless_fallback_gate_pass: \"Boolean pass/fail for graphlessFallbackGate (false vetoes STOP when graphless fallback evidence is absent or unavailable_blocked)\"\n1094:           - graphless_fallback_mode: \"Latest reducer-owned searchCoverage.graphCoverageMode value\"\n1095:           - graphless_fallback_missing_json: \"JSON array of required bug classes missing cited fallback ledger rows\"\n1096:           - graphless_fallback_unavailability_reason: \"Explicit unavailability reason when graphCoverageMode == unavailable_blocked\"\n1097:           - graph_decision: \"CONTINUE | STOP_ALLOWED | STOP_BLOCKED from step_graph_convergence\"\n1098:           - graph_signals_json: \"JSON object returned by graph convergence\"\n1099:           - graph_blockers_json: \"JSON array of graph blockers\"\n1100:           - graph_blockers_csv: \"Comma-separated graph blocker summary\"\n1101:           - recovery_strategy: \"One-line hint describing the next review action when decision == BLOCKED or STUCK_RECOVERY\"\n1102:           - recovery_strategy_code: \"Slug form of recovery_strategy for the ledger code fields\"\n1103:           - gate_results_array_json: \"One {gateId,status,reasonCode,evidenceDigest} row per legal-stop gate (convergenceGate, dimensionCoverageGate, evidenceDensityGate, hotspotSaturationGate, claimAdjudicationGate, fixCompletenessReplayGate, candidateCoverageGate, graphlessFallbackGate), with at least one fail row when decision == BLOCKED\"\n1104:           - active_total_count: \"p0_count + p1_count + p2_count, the active findings total\"\n1105: \n1106:       step_emit_blocked_stop:\n1107:         action: \"Persist blocked-stop evidence whenever the review legal-stop decision tree vetoes STOP\"\n1108:         if_blocked:\n1109:           append_jsonl: '{\"stem\":\"deep_review.blocked_stop_recorded\",\"scope\":{\"runId\":\"{session_id}\",\"sessionId\":\"{session_id}\",\"generation\":{generation},\"iterationId\":\"iteration-{current_iteration}\"},\"data\":{\"blockedGateIds\":{blocked_by_json},\"gateResults\":{gate_results_array_json},\"activeFindingCounts\":{\"candidates\":{active_total_count},\"adjudicated\":{active_total_count},\"p0\":{p0_count},\"p1\":{p1_count},\"p2\":{p2_count}},\"recoveryStrategy\":\"{recovery_strategy_code}\",\"targetDimensionId\":\"{next_dimension}\",\"originatingConvergenceEventId\":\"graph-{session_id}-g{generation}-i{current_iteration}\",\"appendPosition\":{current_iteration},\"gateDetail\":{gate_results_array_json},\"graphBlockerDetail\":{graph_blockers_json},\"recoveryHint\":\"{recovery_strategy}\"}}'\n1110:           dry_run_event_policy: preview-only\n1111:           log: \"Blocked STOP persisted for review loop. Failed gates: {blocked_by_csv}. Recovery strategy: {recovery_strategy}\"\n1112:         if_not_blocked:\n1113:           proceed: true\n1114: \n1115:       step_handle_convergence:\n1116:         action: \"Act on convergence decision\"\n1117:         if_consecutive_failures:\n1118:           applies_to: confirm\n1119:           when: \"stop_decision.reasonDetail == 'consecutiveFailures'. This branch runs instead of if_stop.\"\n1120:           gate_consecutive_failures:\n1121:             type: approval_gate\n1122:             purpose: \"In confirm mode, ask the operator Retry / Skip / Cancel before synthesis starts.\"\n1123:             present: |\n1124:               **{consecutive_failure_count} iterations in a row failed.**\n1125: \n1126:               Options:\n1127:               A) Retry: dispatch the next iteration with the same dimension\n1128:               B) Skip: dispatch the next iteration with the next dimension\n1129:               C) Cancel: end the run with no synthesis\n1130:             wait_for: \"User response\"\n1131:             after_gate_refresh_lock: gate_defaults.after_gate_refresh_lock\n1132:             on_A: { set: { decision: \"CONTINUE\" }, proceed_to: step_normalize_pause_events }\n1133:             on_B: { action: \"Advance next_dimension to the next uncovered dimension in strategy.md\", set: { decision: \"CONTINUE\" }, proceed_to: step_normalize_pause_events }\n1134:             on_C: { action: \"Cancel workflow\", status: \"CANCELLED\", release_lock: step_release_lock }\n1135:           note: \"The failure count is rebuilt from the state log, so this gate asks again after each further failed iteration and stops asking once an iteration completes.\"\n1136:         if_stop:\n1137:           record_terminal_gates:\n1138:             when: \"Run once, immediately before control jumps to phase_synthesis: in if_existing_terminal_path, in the divergent pivot's if_failed and on_error branches, and in every confirm-mode manualStop exit (on_C) into phase_synthesis: both divergent pivot gates, gate_pre_iteration and the post-iteration gate. The auto three-errors stop (reason error) reaches it through if_existing_terminal_path. The duration stop in step_check_max_duration runs it, once, before its jump to phase_synthesis. Never run it when the pivot continues the loop.\"\n1139:             bash: 'node .skilled/skills/system-deep-loop/runtime/scripts/terminal-gates.cjs --config-path \"{state_paths.config}\" --state-log \"{state_paths.state_log}\" --registry-path \"{state_paths.findings_registry}\"'\n1140:             note: \"The script computes all three gates from the config, state log and registry: evidence by the evidenceDensityGate rule, coverage by the dimensionCoverageGate rule, and scope by matching every open finding's file against reviewScopeFiles. Never judge a gate from the findings yourself. Run it fresh at this stop, even when an earlier blocked stop recorded failures.\"\n1141:             on_error: \"When the script exits non-zero or prints status error, fail closed: bind terminal_gate_results_json to three rows, evidence, scope and coverage, each with status fail, reasonCode gate-script-error and evidenceDigest the sha256 of the script's error text, and bind failed_required_gate_ids to [\\\"evidence\\\",\\\"scope\\\",\\\"coverage\\\"].\"\n1142:             evaluate: |\n1143:               terminal_stop_reason = reason when it is maxIterationsReached, maxDurationReached, manualStop or error, else \"converged\". Read reason, never stopReason: every manual stop sets reason to manualStop while stopReason may still hold blockedStop or stuckRecovery\n1144:             outputs:\n1145:               - terminal_gate_results_json: \"Tool terminal_gate_results_json: three rows {gateId, status, reasonCode, evidenceDigest} in the order evidence, scope, coverage\"\n1146:               - failed_required_gate_ids: \"Tool failed_required_gate_ids: the gateIds whose status is fail, in that order; [] when all pass\"\n1147:               - terminal_stop_reason: \"From evaluate\"\n1148:             append_jsonl: '{\"stem\":\"deep_review.terminal_gates_recorded\",\"scope\":{\"runId\":\"{session_id}\",\"sessionId\":\"{session_id}\",\"generation\":{generation},\"iterationId\":\"iteration-{current_iteration}\"},\"data\":{\"stopReason\":\"{terminal_stop_reason}\",\"gateResults\":{terminal_gate_results_json},\"failedRequiredGateIds\":{failed_required_gate_ids},\"appendPosition\":{current_iteration}}}'\n1149:             log: \"Terminal gates recorded at stop {terminal_stop_reason}. Failed required gates: {failed_required_gate_ids}\"\n1150:           branch_on: \"convergence_mode == 'divergent' AND stop_decision.reasonDetail == 'all_dimensions_clean'\"\n1151:           if_divergent_eligible:\n1152:             eligibility_contract:\n1153:               required_decision: \"STOP\"\n1154:               eligible_reasons: [all_dimensions_clean]\n1155:               excluded_reasons: [maxIterationsReached, blockedStop, stuckRecovery, error, manualStop, userPaused, maxDurationReached]\n1156:               fail_closed: \"Any missing or ambiguous reason uses if_existing_terminal_path without preparing a pivot. The nine legal-stop gates have already run and remain unchanged.\"\n1157:             steps:\n1158:               step_prepare_divergent_pivot:\n1159:                 action: \"Generate state-grounded read-only review candidates and prepare or resume the pivot transaction\"\n1160:                 dry_run_boundary: \"state-mutation\"\n1161:                 command: |\n1162:                   node .skilled/skills/system-deep-loop/runtime/scripts/divergent-pivot.cjs prepare --loop-type review --artifact-root \"{state_paths.packet_dir}\" --config \"{state_paths.config}\" --state-log \"{state_paths.state_log}\" --strategy \"{state_paths.strategy}\" --registry \"{state_paths.findings_registry}\" --current-iteration \"{current_iteration}\" --max-iterations \"{max_iterations}\" --trigger-reason \"{reason_detail}\"\n1163:                 working_directory: \"{repo_root}\"\n1164:                 outputs:\n1165:                   - pivot_prepare_json: \"The complete parsed JSON result\"\n1166:                   - pivot_prepare_status: \"status from the prepare result\"\n1167:                   - pivot_id: \"pivotId from the prepare result\"\n1168:                   - pivot_paths_json: \"paths from the prepare result as JSON\"\n1169:                   - pivot_resumed: \"resumed from the prepare result\"\n1170:                   - pivot_missing_seat_ids: \"missingSeats ids from a pending result\"\n1171:                   - pivot_seat_json: \"For the current seat_id, its mandate object from missingSeats\"\n1172:                   - pivot_seat_prompt: \"For the current seat_id, seatPrompts[seat_id]\"\n1173:                   - pivot_dispatch_context_json: \"dispatchContext from a pending result as JSON\"\n1174:                 short_circuit: \"When status is completed or failed, skip all dispatch and record steps and bind this result as pivot_result.\"\n1175: \n1176:               step_dispatch_pivot_seat:\n1177:                 action: \"Natively dispatch one read-only review direction-selection seat\"\n1178:                 for_each: \"seat_id in [seat-001, seat-002, seat-003], in that order. Run this step and then step_record_pivot_seat for one seat before the next seat starts. Seat roles: seat-001 analytical, seat-002 critical, seat-003 pragmatic.\"\n1179:                 skip_when: \"pivot_prepare_status != 'pending' or pivot_missing_seat_ids does not contain seat_id\"\n1180:                 dry_run_boundary: \"dispatch\"\n1181:                 capture_timing: true\n1182:                 if_native:\n1183:                   dispatch:\n1184:                     agent: deep-review\n1185:                     model: opus\n1186:                     context_source: \"pivot_seat_prompt\"\n1187:                   wait_for_completion: true\n1188:                 failure_contract: \"A native dispatch failure binds status=rejected, a {name,message} error, and the measured timestamps/duration, then proceeds to step_record_pivot_seat.\"\n1189:                 outputs:\n1190:                   - pivot_seat_dispatch_status: \"fulfilled or rejected\"\n1191:                   - pivot_seat_output_json: \"Raw native return serialized as JSON when fulfilled, else null\"\n1192:                   - pivot_seat_error_json: \"{name,message} when rejected, else null\"\n1193:                   - pivot_seat_started_at_iso: \"Dispatch start timestamp\"\n1194:                   - pivot_seat_completed_at_iso: \"Dispatch completion timestamp\"\n1195:                   - pivot_seat_duration_ms: \"Dispatch duration in milliseconds\"\n1196: \n1197:               step_record_pivot_seat:\n1198:                 action: \"Durably record the native dispatch outcome of the seat just dispatched\"\n1199:                 skip_when: \"pivot_prepare_status != 'pending' or pivot_missing_seat_ids does not contain seat_id\"\n1200:                 command: |\n1201:                   node .skilled/skills/system-deep-loop/runtime/scripts/divergent-pivot.cjs record-seat <<'PIVOT_SEAT'\n1202:                   {\"paths\":{pivot_paths_json},\"pivotId\":\"{pivot_id}\",\"seat\":{pivot_seat_json},\"status\":\"{pivot_seat_dispatch_status}\",\"output\":{pivot_seat_output_json},\"error\":{pivot_seat_error_json},\"startedAtIso\":\"{pivot_seat_started_at_iso}\",\"completedAtIso\":\"{pivot_seat_completed_at_iso}\",\"durationMs\":\"{pivot_seat_duration_ms}\"}\n1203:                   PIVOT_SEAT\n1204:                 working_directory: \"{repo_root}\"\n1205: \n1206:               step_finalize_divergent_pivot:\n1207:                 action: \"Finalize the prepared pivot after all missing native seats are durable\"\n1208:                 skip_when: \"pivot_prepare_status != 'pending'\"\n1209:                 command: |\n1210:                   node .skilled/skills/system-deep-loop/runtime/scripts/divergent-pivot.cjs finalize --paths-json '{pivot_paths_json}' --pivot-id \"{pivot_id}\" --resumed \"{pivot_resumed}\"\n1211:                 working_directory: \"{repo_root}\"\n1212:                 outputs:\n1213:                   - pivot_finalize_json: \"The complete parsed final result\"\n1214: \n1215:               step_resolve_divergent_pivot_result:\n1216:                 action: \"Use prepare's terminal result on resume/short-circuit, otherwise use finalize's result\"\n1217:                 branch_on: \"pivot_prepare_status\"\n1218:                 if_pending: { bind: { pivot_result: \"{pivot_finalize_json}\" } }\n1219:                 if_completed_or_failed: { bind: { pivot_result: \"{pivot_prepare_json}\" } }\n1220: \n1221:               step_apply_divergent_pivot_result:\n1222:                 action: \"Adopt a successful read-only review direction or fail closed to the existing synthesis path\"\n1223:                 branch_on: \"pivot_result.status\"\n1224:                 if_completed:\n1225:                   gate_divergent_pivot_choice:\n1226:                     applies_to: confirm\n1227:                     type: approval_gate\n1228:                     purpose: \"Approve the Council-selected read-only review direction before it becomes the next focus\"\n1229:                     order: \"Under confirm this gate runs before the set, command, log and proceed_to of this branch.\"\n1230:                     present: |\n1231:                       ## Divergent Review Pivot Candidate\n1232: \n1233:                       **Pivot**: {pivot_result.pivotId}\n1234:                       **Council-selected candidate**: {pivot_result.selectedCandidate.id}\n1235:                       **Review direction**: {pivot_result.restoredFocus}\n1236:                       **Agreement**: {pivot_result.agreement.endorsementCount}/3 material endorsements\n1237:                       **Swept direction**: {pivot_result.completedEvent.previousFocus}\n1238: \n1239:                       The adapter exposes an ordered candidate frontier and agreement tallies, but no ranked-candidate score contract. Choosing a different ranked candidate is therefore unavailable rather than inferred from array order. Every candidate remains read-only and cannot authorize a fix, target expansion, or file mutation.\n1240: \n1241:                       Options:\n1242:                       A) Accept the Council-selected candidate and continue\n1243:                       B) Choose a different ranked candidate (unavailable: no ranking contract)\n1244:                       C) manualStop and proceed to the existing pre-synthesis gate\n1245:                     wait_for: \"User response\"\n1246:                     after_gate_refresh_lock: gate_defaults.after_gate_refresh_lock\n1247:                     on_A:\n1248:                       bookkeeping_log: '{\"type\":\"event\",\"event\":\"pivot_confirm_accepted\",\"mode\":\"review\",\"run\":{current_iteration},\"pivotId\":\"{pivot_result.pivotId}\",\"selectedCandidate\":{pivot_result.selectedCandidate},\"timestamp\":\"{ISO_8601_NOW}\",\"sessionId\":\"{session_id}\",\"generation\":{generation}}'\n1249:                       continue: \"Run the set, command, log and proceed_to of this branch.\"\n1250:                     on_B:\n1251:                       message: \"No ranked alternative can be selected because the adapter exposes no ranking score or rank contract.\"\n1252:                       return_to: gate_divergent_pivot_choice\n1253:                     on_C:\n1254:                       bookkeeping_log: '{\"type\":\"event\",\"event\":\"manualStop\",\"mode\":\"review\",\"run\":{current_iteration},\"stopReason\":\"manualStop\",\"pivotId\":\"{pivot_result.pivotId}\",\"timestamp\":\"{ISO_8601_NOW}\",\"sessionId\":\"{session_id}\",\"generation\":{generation}}'\n1255:                       set: { reason: \"manualStop\" }\n1256:                       run_first: record_terminal_gates\n1257:                       skip_to: phase_synthesis\n1258:                   set:\n1259:                     next_dimension: \"{pivot_result.restoredFocus}\"\n1260:                     pivot_lineage: \"Pivot {pivot_result.pivotId} selected {pivot_result.selectedCandidate.id} from source iteration {current_iteration}.\"\n1261:                     saturated_directions: \"{pivot_result.completedEvent.saturatedDirections}\"\n1262:                   command: \"node .skilled/skills/system-deep-loop/runtime/scripts/reduce-state.cjs {spec_folder} {reducer_artifact_arg} --create-missing-anchors\"\n1263:                   log: \"Divergent review pivot {pivot_result.pivotId} restored focus to {pivot_result.restoredFocus}; continuing iteration {current_iteration}.\"\n1264:                   proceed_to: step_normalize_pause_events\n1265:                 if_failed:\n1266:                   gate_divergent_pivot_override:\n1267:                     applies_to: confirm\n1268:                     type: approval_gate\n1269:                     purpose: \"Offer the audited operator override when a failed pivot is recoverable\"\n1270:                     condition: \"Runs only when pivot_result.failedEvent.recoverableByOverride == true AND pivot_result.agreement.reason == 'insufficient_endorsement'. Otherwise this gate is skipped and the branch fails closed as written.\"\n1271:                     order: \"Under confirm this gate runs before the run_first, log and skip_to of this branch.\"\n1272:                     present: |\n1273:                       ## Divergent Review Pivot Did Not Converge\n1274: \n1275:                       **Pivot**: {pivot_result.pivotId}\n1276:                       **Failure**: {pivot_result.failureReason}\n1277:                       **Agreement tallies**: {pivot_result.agreement.tallies}\n1278: \n1279:                       The adapter marked this insufficient-endorsement failure as recoverable by explicit operator override. The candidate frontier is unranked; any override must name a persisted accepted candidate id, provide a rationale, and remains a read-only review direction.\n1280: \n1281:                       Options:\n1282:                       A) Fail closed to synthesis\n1283:                       B) Explicitly override with accepted candidate id + rationale\n1284:                       C) manualStop and proceed to the existing pre-synthesis gate\n1285:                     wait_for: \"User response\"\n1286:                     after_gate_refresh_lock: gate_defaults.after_gate_refresh_lock\n1287:                     on_A: { continue: \"Fail closed: run the run_first, log and skip_to of this branch.\" }\n1288:                     on_B:\n1289:                       action: \"Read pivot_result.paths.configPath, validate the supplied id against acceptedCandidates, bind the exact candidate and persisted previousFocus/saturatedDirections/frontier, and reject ids outside that frontier or any candidate that authorizes a fix, target expansion, or file mutation.\"\n1290:                       bookkeeping_log: '{\"type\":\"event\",\"event\":\"pivot_override_accepted\",\"mode\":\"review\",\"run\":{current_iteration},\"pivotId\":\"{pivot_result.pivotId}\",\"selectedCandidate\":{operator_selected_candidate},\"selectedFrontier\":{operator_selected_frontier},\"previousFocus\":\"{operator_previous_focus}\",\"saturatedDirections\":{operator_saturated_directions},\"reason\":\"{operator_override_rationale}\",\"agreementReason\":\"insufficient_endorsement\",\"timestamp\":\"{ISO_8601_NOW}\",\"sessionId\":\"{session_id}\",\"generation\":{generation}}'\n1291:                       set:\n1292:                         next_dimension: \"{operator_selected_candidate.focus}\"\n1293:                         pivot_lineage: \"Pivot {pivot_result.pivotId} used an audited insufficient-endorsement override for {operator_selected_candidate.id}.\"\n1294:                         saturated_directions: \"{operator_saturated_directions}\"\n1295:                       command: \"node .skilled/skills/system-deep-loop/runtime/scripts/reduce-state.cjs {spec_folder} {reducer_artifact_arg} --create-missing-anchors\"\n1296:                       proceed_to: step_normalize_pause_events\n1297:                     on_C:\n1298:                       bookkeeping_log: '{\"type\":\"event\",\"event\":\"manualStop\",\"mode\":\"review\",\"run\":{current_iteration},\"stopReason\":\"manualStop\",\"pivotId\":\"{pivot_result.pivotId}\",\"timestamp\":\"{ISO_8601_NOW}\",\"sessionId\":\"{session_id}\",\"generation\":{generation}}'\n1299:                       set: { reason: \"manualStop\" }\n1300:                       run_first: record_terminal_gates\n1301:                       skip_to: phase_synthesis\n1302:                   run_first: record_terminal_gates\n1303:                   log: \"Divergent review pivot {pivot_result.pivotId} failed closed ({pivot_result.failureReason}); proceeding to synthesis.\"\n1304:                   skip_to: phase_synthesis\n1305:             on_error:\n1306:               run_first: record_terminal_gates\n1307:               log: \"Divergent review pivot integration error; failing closed to the existing synthesis path.\"\n1308:               skip_to: phase_synthesis\n1309:           if_existing_terminal_path:\n1310:             run_first: record_terminal_gates\n1311:             log: \"Loop stopping. Reason: {reason}\"\n1312:             skip_to: phase_synthesis\n1313:         if_blocked:\n1314:           log: \"Legal-stop gates blocked STOP. Failed gates: {blocked_by_csv}. Continuing review.\"\n1315:         if_stuck_recovery:\n1316:           log: \"Stuck detected ({stuck_count} consecutive no-progress). Entering recovery.\"\n1317:           recovery_strategies:\n1318:             - \"Change granularity: file-level → function-level → line-level review\"\n1319:             - \"Traceability protocol replay: re-run unresolved core or overlay checks\"\n1320:             - \"Escalate severity review: re-examine P2 findings for potential P1 upgrades\"\n1321:           pivot_target: \"Pivot to the least-covered dimension (the review dimension with the fewest iteration passes and lowest coverage ratio).\"\n1322:           set:\n1323:             next_dimension: \"RECOVERY: {recovery_strategy}. Least-covered dimension: {least_explored}\"\n1324:             pending_stop_event: \"stuck_recovery\"\n1325:             pending_stop_reason: \"stuckRecovery\"\n1326:             pending_stop_detail: \"Recovery path activated after repeated no-progress iterations\"\n1327:         if_continue:\n1328:           log: \"Iteration {current_iteration}: Continuing. Dimension: {next_dimension}\"\n1329: \n1330:       step_normalize_pause_events:\n1331:         action: \"Rewrite raw pause and recovery events to the frozen STOP_REASONS enum at emission time: converged, maxIterationsReached, blockedStop, stuckRecovery, error, manualStop, userPaused, maxDurationReached\"\n1332:         if_pending_pause_event:\n[Output truncated. Continue reading with offset: 1333]","title":"read","metadata":{"metadata":{"truncated":true},"content":[{"type":"text","text":"Read file .skilled/commands/deep/assets/deep-review.yaml, lines 765-1332\n765:             }));\n766:           ' \"{state_paths.config}\" \".skilled/commands/deep/assets/deep-review.yaml\" > \"$EVENT_FILE\" || { rm -f \"$EVENT_FILE\"; exit 1; }\n767:           node \"$GATEWAY\" --mode review --run-directory \"$(dirname \"{state_paths.state_log}\")\" --event-json \"$EVENT_FILE\"\n768:           STATUS=$?\n769:           rm -f \"$EVENT_FILE\"\n770:           exit \"$STATUS\"\n771:         output: \"{state_paths.state_log}\"\n772: \n773:       step_record_restarted_run:\n774:         skip_when: \"lineage_mode != 'restart'\"\n775:         action: \"Record the restarted lineage after the run-open row so the restart marker never precedes deep_review.run_initialized\"\n776:         dry_run_boundary: \"state-mutation\"\n777:         append_jsonl: '{\"stem\":\"deep_review.run_restarted\",\"scope\":{\"runId\":\"{session_id}\",\"sessionId\":\"{session_id}\",\"generation\":{generation}},\"data\":{\"priorTailDigest\":\"{prior_tail_digest}\",\"archivedLineageId\":\"{prior_session_id}\",\"restartReason\":\"Restart requested: the prior review packet was archived and a new lineage segment opened.\",\"continuedFromRunId\":\"{prior_session_id}-i{iteration_count}\",\"compatibilityDecision\":\"exact\",\"recoveryReceiptRef\":\"none\"}}'\n778: \n779:       step_create_findings_registry:\n780:         action: \"Initialize reducer-owned review findings registry\"\n781:         dry_run_boundary: \"state-mutation\"\n782:         content: '{\"sessionId\":\"{session_id_init}\",\"generation\":{generation_init},\"lineageMode\":\"{lineage_mode_init}\",\"openFindings\":[],\"resolvedFindings\":[],\"repeatedFindings\":[],\"dimensionCoverage\":{\"correctness\":false,\"security\":false,\"traceability\":false,\"maintainability\":false},\"findingsBySeverity\":{\"P0\":0,\"P1\":0,\"P2\":0},\"openFindingsCount\":0,\"resolvedFindingsCount\":0,\"convergenceScore\":0.0}'\n783:         output: \"{state_paths.findings_registry}\"\n784: \n785:       step_create_strategy:\n786:         action: \"Create review strategy file from deep-review-strategy.md template\"\n787:         dry_run_boundary: \"state-mutation\"\n788:         template: .skilled/skills/system-deep-loop/deep-review/assets/deep-review-strategy.md\n789:         populate:\n790:           review_target: \"{review_target}\"\n791:           review_target_type: \"{review_target_type}\"\n792:           dimensions: \"{dimension_queue}\"\n793:           scope_files: \"{review_scope_files}\"\n794:           cross_reference_targets: \"{cross_reference_targets}\"\n795:           max_iterations: \"{max_iterations}\"\n796:           convergence_threshold: \"{convergence_threshold}\"\n797:           stop_policy: \"{stop_policy}\"\n798:         output: \"{state_paths.strategy}\"\n799: \n800:       step_seed_coverage_graph:\n801:         action: \"Seed the review coverage graph before the first convergence check\"\n802:         dry_run_boundary: \"state-mutation\"\n803:         transform: |\n804:           1. Convert review_scope_files into FILE nodes.\n805:           2. Convert review target groupings into coarse SLICE nodes only; do not expand SYMBOL\n806:              or DEPENDENCY nodes in review mode.\n807:           3. Emit COVERS edges from SLICE nodes to FILE nodes when the grouping is known.\n808:           4. Bind coverage_seed_source to \"scope_discovery\" and coverage_seed_confidence to 0.50.\n809:           5. When scope discovery yields no files, emit [] for both arrays; the upsert script\n810:              returns a warning and review continues with an empty graph.\n811:         bash: \"node .skilled/skills/system-deep-loop/runtime/scripts/upsert.cjs --spec-folder \\\"{spec_folder}\\\" --loop-type \\\"review\\\" --session-id \\\"{config.sessionId}\\\" --nodes '{coverage_seed_nodes_json}' --edges '{coverage_seed_edges_json}' --seed-source \\\"{coverage_seed_source}\\\" --seed-confidence \\\"{coverage_seed_confidence}\\\"\"\n812:         outputs:\n813:           - coverage_seed_nodes_json: \"Seed nodes for review SLICE and FILE kinds only\"\n814:           - coverage_seed_edges_json: \"Seed COVERS edges where review target groupings resolved\"\n815:           - coverage_seed_warning: \"Warning emitted when the seed batch inserts zero nodes, else empty\"\n816:         on_warning:\n817:           log: \"Coverage graph seed inserted zero nodes; continuing with an empty graph.\"\n818:           proceed: true\n819: \n820:       step_enrich_strategy_context:\n821:         action: \"Ensure Known Context is written only after strategy.md exists\"\n822:         dry_run_boundary: \"state-mutation\"\n823:         condition: \"prior_context_found\"\n824:         edit: \"{state_paths.strategy}\"\n825:         note: \"Append or replace the Known Context section with prior_context_summary and retained detail from prior_context\"\n826: \n827:       step_enrich_strategy_resource_map:\n828:         action: \"Inject resource-map status into Known Context after strategy.md exists\"\n829:         dry_run_boundary: \"state-mutation\"\n830:         edit: \"{state_paths.strategy}\"\n831:         note: \"When resource_map_present is true, append the resource_map_known_context snapshot and add Resource Map Coverage to the Review Charter. When false, append 'resource-map.md not present; skipping coverage gate'.\"\n832: \n833:       step_init_complete:\n834:         log: \"Initialization complete. Config, state, and strategy files created. Review scope: {review_scope_files_count} files, {dimension_queue_count} dimensions.\"\n835:         set: { current_iteration: 1, p0_count: 0, p1_count: 0, p2_count: 0 }\n836: \n837:       # ─── APPROVAL GATE: Post-Init ───\n838:       gate_init_approval:\n839:         applies_to: confirm\n840:         type: approval_gate\n841:         purpose: \"Show review scope, dimensions, and target files. Get approval to start loop.\"\n842:         present: |\n843:           ## Review Initialization Complete\n844: \n845:           **Review Target**: {review_target} ({review_target_type})\n846:           **Scope**: {review_scope_files_count} files\n847:           **Dimensions**: {dimension_queue}\n848:           **Max Iterations**: {max_iterations}\n849:           **Convergence Threshold**: {convergence_threshold}\n850:           **Known Context Summary**: {prior_context_summary}\n851: \n852:           **Files in scope:**\n853:           {review_scope_files_summary}\n854: \n855:           Review `{state_paths.strategy}` for the full scope and dimension ordering.\n856:           **State files located in**: {state_paths.packet_dir}/\n857: \n858:           Options:\n859:           A) Start review loop\n860:           B) Adjust scope or dimensions\n861:           C) Cancel\n862:         wait_for: \"User response\"\n863:         after_gate_refresh_lock: gate_defaults.after_gate_refresh_lock\n864:         on_A: { set: { current_iteration: 1, p0_count: 0, p1_count: 0, p2_count: 0 }, proceed_to: phase_loop }\n865:         on_B: { action: \"Apply user adjustments to strategy.md, scope, or dimensions\", return_to: gate_init_approval }\n866:         on_C: { action: \"Cancel workflow\", status: \"CANCELLED\", release_lock: step_release_lock }\n867: \n868:   # ════════\n869:   # PHASE 2: ITERATION LOOP\n870:   # ════════\n871:   phase_loop:\n872:     purpose: Dispatch review agent iterations until convergence\n873:     repeat: true\n874:     max_repeats: \"{max_iterations}\"\n875:     steps:\n876: \n877:       step_refresh_lock:\n878:         action: \"Refresh the packet lock heartbeat before the iteration begins\"\n879:         command: \"node .skilled/skills/system-deep-loop/runtime/scripts/loop-lock.cjs refresh --lock-path {state_paths.lock_file} --owner-pid {captured_owner_pid} --nonce {captured_acquire_nonce}\"\n880:         on_refresh: \"If the refresh output has refreshed:false, fail closed: lost the packet lock. This run no longer holds the packet, so run step_release_lock and stop rather than iterate without it.\"\n881: \n882:       step_record_artifact_migration:\n883:         action: \"Record the legacy review state move once per session, after the run is open\"\n884:         dry_run_boundary: \"state-mutation\"\n885:         skip_when: \"legacy_migration_detected != true or migration_recorded == true\"\n886:         append_jsonl: '{\"stem\":\"deep_review.migration\",\"scope\":{\"runId\":\"{session_id}\",\"sessionId\":\"{session_id}\"},\"data\":{\"mode\":\"review\",\"legacyArtifacts\":[\"deep-research-config.json\",\"deep-research-state.jsonl\",\".deep-research-pause\"],\"canonicalArtifacts\":[\"deep-review-config.json\",\"deep-review-state.jsonl\",\".deep-review-pause\"]}}'\n887:         set: { migration_recorded: true }\n888: \n889:       step_read_state:\n890:         action: \"Read current state from JSONL, strategy, and config\"\n891:         read:\n892:           - \"{state_paths.state_log}\"\n893:           - \"{state_paths.findings_registry}\"\n894:           - \"{state_paths.strategy}\"\n895:           - \"{state_paths.config}\"\n896:         extract:\n897:           - iteration_count: \"Count distinct run values (the integer iteration, else a numeric run) across lines where type === 'iteration'; a redispatched run counts once\"\n898:           - highest_run: \"Highest run value (the integer iteration, else a numeric run) across lines where type === 'iteration', else 0\"\n899:           - current_iteration: \"max(highest_run, iteration_count) + 1\"\n900:           - last_newFindingsRatio: \"Extract newFindingsRatio from last iteration record\"\n901:           - last_focus: \"Extract focus/dimension from latest iteration record, else 'none yet'\"\n902:           - ratio_prev: \"Extract newFindingsRatio from second-latest iteration record, else 'N/A'\"\n903:           - ratio_latest: \"Extract newFindingsRatio from latest iteration record, else 'N/A'\"\n904:           - next_dimension: \"When max_iterations >= 2, current_iteration == max_iterations and unfinished_core_protocols is non-empty, 'traceability': the last iteration under the cap finishes those core protocols. Otherwise the next uncovered dimension from dimension_queue in strategy.md.\"\n905:           - dimensions_covered: \"List of dimensions already reviewed\"\n906:           - dimensions_remaining: \"List of dimensions not yet reviewed\"\n907:           - dimension_coverage: \"covered / total dimensions\"\n908:           - coverage_age: \"Iterations since dimension coverage last changed; require >= 1 before STOP\"\n909:           - p0_count: \"findingsBySeverity.P0 from {state_paths.findings_registry}, the reducer's deduplicated count of open findings, else 0\"\n910:           - p1_count: \"findingsBySeverity.P1 from {state_paths.findings_registry}, else 0\"\n911:           - p2_count: \"findingsBySeverity.P2 from {state_paths.findings_registry}, else 0\"\n912:           - unfinished_core_protocols: \"registry.traceability.unfinishedCoreProtocols from {state_paths.findings_registry} as a JSON array, else []\"\n913:           - resource_map_present: \"Extract boolean from deep-review-config.json, default false\"\n914:           - resource_map_prompt_line: \"If resource_map_present is true, return 'Resource Map Coverage: cross-check target_files from {spec_folder}/applied/T-*.md against {spec_folder}/resource-map.md and classify only missed coverage as gaps.' Else return 'Resource Map Coverage: resource-map.md not present; skipping coverage gate.'\"\n915:           - session_id: \"Extract sessionId from deep-review-config.json\"\n916:           - generation: \"Extract generation from deep-review-config.json, else 1\"\n917:           - last_3_summaries: \"Summarize the latest 3 iteration records as 'run N: dimension (ratio, P0/P1/P2)'\"\n918:           - latest_status: \"Extract status from latest iteration record, else 'none yet'\"\n919:           - last_claim_adjudication_passed: \"Scan state.jsonl for the most recent `claim_adjudication` event; use its `passed` boolean. Default true when no event exists or when activeP0 + activeP1 == 0 (gate is vacuous without adjudicable findings).\"\n920:           - claim_adjudication_active_count: \"Count of active P0/P1 findings at the time of the last claim_adjudication event; 0 when none exist\"\n921:           - security_sensitive_fix_scope: \"Boolean true when the current review is a rerun after fixes involving security, path disclosure, auth/authz, sandboxing, env precedence, public schemas, persistence, or user-visible error payloads; derive from the latest review report, remediation notes, or planning packet when present, else false.\"\n922:           - fix_completeness_replay_required_rows: \"Count prior active or remediated P0/P1 findings, plus any prior security/path P2 findings, that require closed-gate replay before STOP.\"\n923:           - fix_completeness_replay_passing_rows: \"Count required replay rows marked PASS with file:line or command evidence and producer/consumer/matrix coverage.\"\n924:           - stop_policy: \"Extract stopPolicy from deep-review-config.json, default 'convergence'. Valid values: convergence, max-iterations.\"\n925:           - convergence_mode: \"Extract antiConvergence.convergenceMode when it is one of 'default', 'off', 'sliding-window', or 'divergent'; default to 'default'\"\n926:           - convergence_mode_warning: \"Boolean true when antiConvergence.convergenceMode is present with an unsupported value; use 'default'\"\n927:           - pivot_lineage: \"Summarize registry.divergence.completed and registry.divergence.overrides with pivot ids, source iterations, and selected review direction; else 'none yet'\"\n928:           - saturated_directions: \"List registry.divergence.saturatedDirections; else 'none yet'\"\n929:           - review_focus_block: \"When deep-review-config.json reviewFocus is a non-empty string, return 'Operator review focus (cover it in addition to the dimension of this iteration, and say in the narrative how you addressed it): <reviewFocus>'. Else return an empty string.\"\n930:           - unfinished_core_protocols_block: \"Under the same condition as next_dimension's traceability case, return 'This is the last iteration under the cap. Finish these core traceability protocols: <ids, comma-separated>. Record one traceabilityChecks.results[] entry for each. A result raised from partial to pass needs a file:line reference in evidenceRefs, or it stays partial.' Else return an empty string.\"\n931: \n932:       step_check_max_duration:\n933:         action: \"Stop the loop when the run has used its wall-clock budget, and still synthesize\"\n934:         command: |\n935:           node -e '\n936:             const config = JSON.parse(require(\"fs\").readFileSync(process.argv[1], \"utf8\"));\n937:             const maxDurationMinutes = Number(config.maxDurationMinutes);\n938:             const startedMs = Date.parse(config.createdAt);\n939:             const elapsedMinutes = Math.floor((Date.now() - startedMs) / 60000);\n940:             const reached = Number.isFinite(maxDurationMinutes) && maxDurationMinutes > 0\n941:               && Number.isFinite(startedMs) && elapsedMinutes >= maxDurationMinutes;\n942:             console.log(JSON.stringify({ elapsedMinutes, maxDurationMinutes, reached }));\n943:           ' \"{state_paths.config}\"\n944:         outputs:\n945:           - duration_reached: \"reached from the JSON output\"\n946:           - elapsed_minutes: \"elapsedMinutes from the JSON output\"\n947:         note: \"The clock starts at the createdAt of the current generation's config. A resume keeps it and a restart resets it, so paused and waiting time counts.\"\n948:         if_reached:\n949:           when: \"duration_reached == true\"\n950:           set: { decision: \"STOP\", reason: \"maxDurationReached\", stopReason: \"maxDurationReached\" }\n951:           bookkeeping_log: '{\"type\":\"event\",\"event\":\"maxDurationReached\",\"mode\":\"review\",\"run\":{current_iteration},\"stopReason\":\"maxDurationReached\",\"elapsedMinutes\":{elapsed_minutes},\"maxDurationMinutes\":{config.maxDurationMinutes},\"timestamp\":\"{ISO_8601_NOW}\",\"sessionId\":\"{session_id}\",\"generation\":{generation}}'\n952:           log: \"Duration limit reached after {elapsed_minutes} minutes. Skipping dispatch and entering synthesis with partial findings.\"\n953:           run_first: record_terminal_gates\n954:           skip_to: phase_synthesis\n955:           note: \"The stop row is printed, not appended: the gateway refuses an event it has no ledger stem for. The reason reaches the synthesis report through the bound reason.\"\n956:         if_not_reached:\n957:           action: \"Continue with the iteration\"\n958: \n959:       step_check_pause_sentinel:\n960:         action: \"Check for pause sentinel file\"\n961:         check: \"Does {state_paths.pause_sentinel} exist?\"\n962:         if_exists:\n963:           set:\n964:             pending_stop_event: \"paused\"\n965:             pending_stop_reason: \"userPaused\"\n966:             pending_stop_detail: \"sentinel file detected\"\n967:           skip_to: step_normalize_pause_events\n968:         if_not_exists:\n969:           proceed: true\n970: \n971:       step_validate_convergence_config:\n972:         action: \"Validate convergence mode when loading config\"\n973:         if_convergence_mode_invalid:\n974:           bookkeeping_log: '{\"type\":\"event\",\"event\":\"config_warning\",\"mode\":\"review\",\"field\":\"antiConvergence.convergenceMode\",\"fallback\":\"default\",\"message\":\"Unsupported convergenceMode; using default convergence behavior.\",\"timestamp\":\"{ISO_8601_NOW}\",\"sessionId\":\"{session_id}\",\"generation\":{generation}}'\n975:           dry_run_event_policy: preview-only\n976:           log: \"Unsupported convergenceMode; using default convergence behavior.\"\n977: \n978:       step_graph_convergence:\n979:         action: \"Run convergence.cjs once: it evaluates the coverage graph and computes the whole review stop decision\"\n980:         inspect:\n981:           - \"{state_paths.state_log}\"\n982:           - \"{state_paths.findings_registry}\"\n983:         transform: |\n984:           1. Call convergence.cjs once on the current review lineage. It returns the graph decision and the stop_decision object.\n985:           2. Record the decision as one of CONTINUE, STOP_ALLOWED, STOP_BLOCKED.\n986:           3. Preserve raw graph signals and blockers for reducer rollup and blocked-stop evidence.\n987:           4. Normalize blockers to both JSON array and CSV forms for downstream stop handling.\n988:           5. Set graph_stop_blocked = true only when graph_decision == \"STOP_BLOCKED\".\n989:         bash: 'node .skilled/skills/system-deep-loop/runtime/scripts/convergence.cjs --spec-folder \"{spec_folder}\" --loop-type \"review\" --session-id \"{session_id}\" --convergence-mode \"{convergence_mode}\" --stop-decision --config-path \"{state_paths.config}\" --state-log \"{state_paths.state_log}\" --registry-path \"{state_paths.findings_registry}\" --iteration-count \"{iteration_count}\" --security-sensitive-fix-scope \"{security_sensitive_fix_scope}\" --fix-replay-required-rows \"{fix_completeness_replay_required_rows}\" --fix-replay-passing-rows \"{fix_completeness_replay_passing_rows}\"'\n990:         note: \"The script is the only place the stop decision is computed. step_check_convergence branches on its stop_decision output.\"\n991:         append_jsonl: '{\"stem\":\"deep_review.graph_convergence_evaluated\",\"scope\":{\"runId\":\"{session_id}\",\"sessionId\":\"{session_id}\",\"generation\":{generation},\"iterationId\":\"iteration-{current_iteration}\"},\"data\":{\"rawSignals\":{graph_raw_signals_json},\"weightedSignals\":{graph_raw_signals_json},\"dimensionCoverageDigest\":\"{dimension_coverage_digest}\",\"protocolCoverageDigest\":\"{protocol_coverage_digest}\",\"findingStability\":\"{finding_stability}\",\"p0p1ResolutionState\":\"{p0p1_resolution_state}\",\"evidenceDensity\":{evidence_density},\"hotspotSaturation\":{hotspot_saturation},\"decision\":\"{graph_decision_code}\",\"policyFingerprint\":\"{policy_fingerprint}\",\"blockerIds\":{graph_blocker_ids_json},\"stopCandidate\":{stop_candidate},\"graphDecision\":\"{graph_decision_code}\",\"graphDigest\":\"{graph_digest}\",\"signals\":{graph_signals_json},\"blockers\":{graph_blockers_json}},\"eventId\":\"graph-{session_id}-g{generation}-i{current_iteration}\"}'\n992:         dry_run_event_policy: preview-only\n993:         on_missing_counters: \"If loop_counters_json is missing from the output, halt with stop reason error. Never bind a default counter. Run step_release_lock before the halt returns control.\"\n994:         outputs:\n995:           - graph_decision: \"CONTINUE | STOP_ALLOWED | STOP_BLOCKED\"\n996:           - stop_decision: \"Tool stop_decision object: decision, stopReason, reasonDetail, weightedStopScore, signals, gates, blockedBy, graphDecision, inputs\"\n997:           - loop_counters_json: \"Tool loop_counters_json object: stuckCount and consecutiveFailureCount, both rebuilt from the state log on this pass\"\n998:           - stuck_count: \"loop_counters_json.stuckCount\"\n999:           - consecutive_failure_count: \"loop_counters_json.consecutiveFailureCount\"\n1000:           - graph_decision_code: \"CONTINUE maps to continue, STOP_ALLOWED to converged, STOP_BLOCKED to blocked\"\n1001:           - graph_signals_json: \"JSON object returned by convergence.cjs\"\n1002:           - graph_raw_signals_json: \"Exact-field convergence-signals JSON built from the convergence.cjs signals; observationDigest is the sha256 of graph_signals_json\"\n1003:           - graph_blockers_json: \"JSON array of graph blockers when present, else []\"\n1004:           - graph_blocker_ids_json: \"JSON array of blocker type values; use [\\\"graph_blocker\\\"] when the decision is blocked and the list is empty\"\n1005:           - graph_blockers_csv: \"Comma-separated blocker summary when graph blocks STOP, else empty string\"\n1006:           - graph_stop_blocked: \"Boolean true when graph_decision == STOP_BLOCKED\"\n1007:           - dimension_coverage_digest: \"sha256 (64 lowercase hex) of the canonical JSON of the registry dimensionCoverage map\"\n1008:           - protocol_coverage_digest: \"sha256 (64 lowercase hex) of the canonical JSON of the protocol coverage object in graph_signals_json, or of {} when absent\"\n1009:           - finding_stability: \"stable when findingStabilityRatio >= convergenceThreshold, unstable when below, unknown when the signal is missing\"\n1010:           - p0p1_resolution_state: \"resolved when active P0 + P1 findings are 0, blocked when above 0, unknown when counts are unavailable\"\n1011:           - evidence_density: \"evidenceDensityRatio from graph_signals_json, capped at 1\"\n1012:           - hotspot_saturation: \"hotspotSaturationRatio from graph_signals_json, between 0 and 1\"\n1013:           - policy_fingerprint: \"sha256 (64 lowercase hex) of the canonical JSON {convergenceThreshold, stopPolicy, convergenceMode} from the review config\"\n1014:           - stop_candidate: \"true when graph_decision == STOP_ALLOWED, else false\"\n1015:           - graph_digest: \"sha256 (64 lowercase hex) of graph_signals_json\"\n1016: \n1017:       step_check_convergence:\n1018:         action: \"Branch on the stop decision that convergence.cjs computed in step_graph_convergence\"\n1019:         algorithm: |\n1020:           The whole stop decision is computed by convergence.cjs from the review config, the state log, the findings registry and the coverage graph. This step performs no arithmetic and never recomputes or overrides the result.\n1021:           The ratio signals leave out thought iterations and every iteration whose status is error or timeout, and stuck_count is loop_counters_json.stuckCount.\n1022:           The script applies this fixed order, first match wins:\n1023:           1. if iteration_count >= max_iterations: STOP (maxIterationsReached). This terminal cap is evaluated before every veto, the claim-adjudication veto included; failed legal-stop gates are recorded in stop_decision.blockedBy as synthesis evidence.\n1024:           1a. After 3 consecutive failed iterations (status error or timeout), halt the loop and enter synthesis with stop reason error and partial findings.\n1025:           2. if stuck_count >= config.stuckThreshold: STUCK_RECOVERY\n1026:           3. if convergence_mode == \"off\": skip convergence stop candidates and continue.\n1027:           3a. if stop_policy == \"max-iterations\" AND iteration_count < max_iterations: the vote is telemetry only and the decision is CONTINUE.\n1028:           4. a STOP candidate exists when every dimension is clean (all_dimensions_clean) or the weighted vote passes (composite_converged). The vote cutoffs follow the configured convergenceThreshold.\n1029:           5. the nine legal-stop gates run on a candidate: convergenceGate, dimensionCoverageGate, p0ResolutionGate, evidenceDensityGate, hotspotSaturationGate, claimAdjudicationGate, fixCompletenessReplayGate, candidateCoverageGate, graphlessFallbackGate. Any failed gate gives BLOCKED (blockedStop).\n1030:           6. the graph decision settles the candidate: STOP_ALLOWED keeps STOP, STOP_BLOCKED gives BLOCKED, CONTINUE or a missing graph decision gives CONTINUE.\n1031:           Bind the outputs from stop_decision, where G is stop_decision.gates and I is stop_decision.inputs.review:\n1032:             decision = stop_decision.decision\n1033:             stopReason = stop_decision.stopReason\n1034:             reason = stop_decision.stopReason when it is not null, else stop_decision.reasonDetail\n1035:             reason_detail = stop_decision.reasonDetail\n1036:             weighted_stop_score = stop_decision.weightedStopScore\n1037:             stop_blocked = (stop_decision.decision == \"BLOCKED\")\n1038:             blocked_by_json = stop_decision.blockedBy\n1039:             blocked_by_csv = the members of stop_decision.blockedBy joined with commas\n1040:             convergence_gate_pass = G.convergenceGate.pass\n1041:             convergence_gate_score = G.convergenceGate.score\n1042:             dimension_coverage_gate_pass = G.dimensionCoverageGate.pass\n1043:             dimension_coverage_gate_missing_json = G.dimensionCoverageGate.missing\n1044:             dimension_coverage_gate_covered_json = the configured review dimensions that are not in G.dimensionCoverageGate.missing\n1045:             p0_resolution_gate_pass = G.p0ResolutionGate.pass\n1046:             active_p0_count = G.p0ResolutionGate.activeP0\n1047:             evidence_density_gate_pass = G.evidenceDensityGate.pass\n1048:             avg_evidence_per_finding = I.evidenceBackedP0P1, the count of active P0 and P1 findings that carry file:line evidence\n1049:             hotspot_saturation_gate_pass = G.hotspotSaturationGate.pass\n1050:             claim_adjudication_gate_pass = G.claimAdjudicationGate.pass\n1051:             claim_adjudication_active_count = I.activeP0 plus I.activeP1\n1052:             fix_completeness_replay_gate_pass = G.fixCompletenessReplayGate.pass\n1053:             security_sensitive_fix_scope = I.securitySensitiveFixScope\n1054:             fix_completeness_replay_required_rows = I.fixReplayRequiredRows\n1055:             fix_completeness_replay_passing_rows = I.fixReplayPassingRows\n1056:             candidate_coverage_gate_pass = G.candidateCoverageGate.pass\n1057:             candidate_coverage_search_debt_json = I.searchDebt\n1058:             candidate_coverage_missing_json = the I.requiredBugClasses entries that are not in I.candidateCovered\n1059:             graphless_fallback_gate_pass = G.graphlessFallbackGate.pass\n1060:             graphless_fallback_mode = I.graphCoverageMode\n1061:             graphless_fallback_missing_json = the I.requiredBugClasses entries that are not in I.fallbackCoveredBugClasses\n1062:             graphless_fallback_unavailability_reason = the explicit reason when I.graphCoverageMode == \"unavailable_blocked\", else empty string\n1063:             graph_blocker_detail_json = graph_blockers_json\n1064:             recovery_strategy = one line naming the next review action for the gates in stop_decision.blockedBy. When claimAdjudicationGate is listed: \"Reviewer must add typed claim-adjudication packets (claim, evidenceRefs, counterevidenceSought, alternativeExplanation, finalSeverity, confidence, downgradeTrigger) for every active P0/P1 finding before STOP is allowed.\" When stop_decision.reasonDetail == \"graphStopBlocked\": \"Resolve review coverage-graph blockers before stopping.\" When candidateCoverageGate and graphlessFallbackGate both fail, combine their guidance. When I.unfinishedCoreProtocols is non-empty, name them and say the last iteration under the cap is reserved for them, each needing file:line evidence.\n1065:           If stop_decision is missing from the step_graph_convergence output, do not decide by hand: halt and report the script output.\n1066:         outputs:\n1067:           - decision: \"STOP | BLOCKED | STUCK_RECOVERY | CONTINUE\"\n1068:           - reason: \"stop_decision.stopReason when set, else stop_decision.reasonDetail\"\n1069:           - reason_detail: \"stop_decision.reasonDetail, the fine cause behind the decision\"\n1070:           - weighted_stop_score: \"stop_decision.weightedStopScore, for diagnostics only\"\n1071:           - stop_blocked: \"Boolean true when STOP is vetoed by inline legal-stop gates or graph_decision == STOP_BLOCKED\"\n1072:           - blocked_by_json: \"JSON array of failed legal-stop gates when decision == BLOCKED\"\n1073:           - blocked_by_csv: \"Comma-separated list of failed legal-stop gates when decision == BLOCKED\"\n1074:           - convergence_gate_pass: \"Boolean pass/fail for convergenceGate\"\n1075:           - convergence_gate_score: \"Numeric score recorded for convergenceGate\"\n1076:           - dimension_coverage_gate_pass: \"Boolean pass/fail for dimensionCoverageGate\"\n1077:           - dimension_coverage_gate_covered_json: \"JSON array of covered review dimensions\"\n1078:           - dimension_coverage_gate_missing_json: \"JSON array of missing review dimensions\"\n1079:           - p0_resolution_gate_pass: \"Boolean pass/fail for p0ResolutionGate\"\n1080:           - active_p0_count: \"Active P0 finding count at stop-check time\"\n1081:           - evidence_density_gate_pass: \"Boolean pass/fail for evidenceDensityGate\"\n1082:           - avg_evidence_per_finding: \"Numeric evidence density for active findings\"\n1083:           - hotspot_saturation_gate_pass: \"Boolean pass/fail for hotspotSaturationGate\"\n1084:           - claim_adjudication_gate_pass: \"Boolean pass/fail for claimAdjudicationGate (false vetoes STOP)\"\n1085:           - claim_adjudication_active_count: \"Count of active P0/P1 findings evaluated by claimAdjudicationGate\"\n1086:           - fix_completeness_replay_gate_pass: \"Boolean pass/fail for fixCompletenessReplayGate (false vetoes STOP on security-sensitive fix reruns)\"\n1087:           - security_sensitive_fix_scope: \"Boolean true when the review is a security-sensitive fix rerun\"\n1088:           - fix_completeness_replay_required_rows: \"Count of closed-gate replay rows required before STOP\"\n1089:           - fix_completeness_replay_passing_rows: \"Count of required closed-gate replay rows that passed with evidence\"\n1090:           - candidate_coverage_gate_pass: \"Boolean pass/fail for candidateCoverageGate (false vetoes STOP for unresolved reducer-owned search debt or uncovered required bug classes)\"\n1091:           - candidate_coverage_search_debt_json: \"JSON array of reducer-owned searchDebt obligations used as blocked-stop evidence\"\n1092:           - candidate_coverage_missing_json: \"JSON array of required bug classes missing from candidateCoverage.covered\"\n1093:           - graphless_fallback_gate_pass: \"Boolean pass/fail for graphlessFallbackGate (false vetoes STOP when graphless fallback evidence is absent or unavailable_blocked)\"\n1094:           - graphless_fallback_mode: \"Latest reducer-owned searchCoverage.graphCoverageMode value\"\n1095:           - graphless_fallback_missing_json: \"JSON array of required bug classes missing cited fallback ledger rows\"\n1096:           - graphless_fallback_unavailability_reason: \"Explicit unavailability reason when graphCoverageMode == unavailable_blocked\"\n1097:           - graph_decision: \"CONTINUE | STOP_ALLOWED | STOP_BLOCKED from step_graph_convergence\"\n1098:           - graph_signals_json: \"JSON object returned by graph convergence\"\n1099:           - graph_blockers_json: \"JSON array of graph blockers\"\n1100:           - graph_blockers_csv: \"Comma-separated graph blocker summary\"\n1101:           - recovery_strategy: \"One-line hint describing the next review action when decision == BLOCKED or STUCK_RECOVERY\"\n1102:           - recovery_strategy_code: \"Slug form of recovery_strategy for the ledger code fields\"\n1103:           - gate_results_array_json: \"One {gateId,status,reasonCode,evidenceDigest} row per legal-stop gate (convergenceGate, dimensionCoverageGate, evidenceDensityGate, hotspotSaturationGate, claimAdjudicationGate, fixCompletenessReplayGate, candidateCoverageGate, graphlessFallbackGate), with at least one fail row when decision == BLOCKED\"\n1104:           - active_total_count: \"p0_count + p1_count + p2_count, the active findings total\"\n1105: \n1106:       step_emit_blocked_stop:\n1107:         action: \"Persist blocked-stop evidence whenever the review legal-stop decision tree vetoes STOP\"\n1108:         if_blocked:\n1109:           append_jsonl: '{\"stem\":\"deep_review.blocked_stop_recorded\",\"scope\":{\"runId\":\"{session_id}\",\"sessionId\":\"{session_id}\",\"generation\":{generation},\"iterationId\":\"iteration-{current_iteration}\"},\"data\":{\"blockedGateIds\":{blocked_by_json},\"gateResults\":{gate_results_array_json},\"activeFindingCounts\":{\"candidates\":{active_total_count},\"adjudicated\":{active_total_count},\"p0\":{p0_count},\"p1\":{p1_count},\"p2\":{p2_count}},\"recoveryStrategy\":\"{recovery_strategy_code}\",\"targetDimensionId\":\"{next_dimension}\",\"originatingConvergenceEventId\":\"graph-{session_id}-g{generation}-i{current_iteration}\",\"appendPosition\":{current_iteration},\"gateDetail\":{gate_results_array_json},\"graphBlockerDetail\":{graph_blockers_json},\"recoveryHint\":\"{recovery_strategy}\"}}'\n1110:           dry_run_event_policy: preview-only\n1111:           log: \"Blocked STOP persisted for review loop. Failed gates: {blocked_by_csv}. Recovery strategy: {recovery_strategy}\"\n1112:         if_not_blocked:\n1113:           proceed: true\n1114: \n1115:       step_handle_convergence:\n1116:         action: \"Act on convergence decision\"\n1117:         if_consecutive_failures:\n1118:           applies_to: confirm\n1119:           when: \"stop_decision.reasonDetail == 'consecutiveFailures'. This branch runs instead of if_stop.\"\n1120:           gate_consecutive_failures:\n1121:             type: approval_gate\n1122:             purpose: \"In confirm mode, ask the operator Retry / Skip / Cancel before synthesis starts.\"\n1123:             present: |\n1124:               **{consecutive_failure_count} iterations in a row failed.**\n1125: \n1126:               Options:\n1127:               A) Retry: dispatch the next iteration with the same dimension\n1128:               B) Skip: dispatch the next iteration with the next dimension\n1129:               C) Cancel: end the run with no synthesis\n1130:             wait_for: \"User response\"\n1131:             after_gate_refresh_lock: gate_defaults.after_gate_refresh_lock\n1132:             on_A: { set: { decision: \"CONTINUE\" }, proceed_to: step_normalize_pause_events }\n1133:             on_B: { action: \"Advance next_dimension to the next uncovered dimension in strategy.md\", set: { decision: \"CONTINUE\" }, proceed_to: step_normalize_pause_events }\n1134:             on_C: { action: \"Cancel workflow\", status: \"CANCELLED\", release_lock: step_release_lock }\n1135:           note: \"The failure count is rebuilt from the state log, so this gate asks again after each further failed iteration and stops asking once an iteration completes.\"\n1136:         if_stop:\n1137:           record_terminal_gates:\n1138:             when: \"Run once, immediately before control jumps to phase_synthesis: in if_existing_terminal_path, in the divergent pivot's if_failed and on_error branches, and in every confirm-mode manualStop exit (on_C) into phase_synthesis: both divergent pivot gates, gate_pre_iteration and the post-iteration gate. The auto three-errors stop (reason error) reaches it through if_existing_terminal_path. The duration stop in step_check_max_duration runs it, once, before its jump to phase_synthesis. Never run it when the pivot continues the loop.\"\n1139:             bash: 'node .skilled/skills/system-deep-loop/runtime/scripts/terminal-gates.cjs --config-path \"{state_paths.config}\" --state-log \"{state_paths.state_log}\" --registry-path \"{state_paths.findings_registry}\"'\n1140:             note: \"The script computes all three gates from the config, state log and registry: evidence by the evidenceDensityGate rule, coverage by the dimensionCoverageGate rule, and scope by matching every open finding's file against reviewScopeFiles. Never judge a gate from the findings yourself. Run it fresh at this stop, even when an earlier blocked stop recorded failures.\"\n1141:             on_error: \"When the script exits non-zero or prints status error, fail closed: bind terminal_gate_results_json to three rows, evidence, scope and coverage, each with status fail, reasonCode gate-script-error and evidenceDigest the sha256 of the script's error text, and bind failed_required_gate_ids to [\\\"evidence\\\",\\\"scope\\\",\\\"coverage\\\"].\"\n1142:             evaluate: |\n1143:               terminal_stop_reason = reason when it is maxIterationsReached, maxDurationReached, manualStop or error, else \"converged\". Read reason, never stopReason: every manual stop sets reason to manualStop while stopReason may still hold blockedStop or stuckRecovery\n1144:             outputs:\n1145:               - terminal_gate_results_json: \"Tool terminal_gate_results_json: three rows {gateId, status, reasonCode, evidenceDigest} in the order evidence, scope, coverage\"\n1146:               - failed_required_gate_ids: \"Tool failed_required_gate_ids: the gateIds whose status is fail, in that order; [] when all pass\"\n1147:               - terminal_stop_reason: \"From evaluate\"\n1148:             append_jsonl: '{\"stem\":\"deep_review.terminal_gates_recorded\",\"scope\":{\"runId\":\"{session_id}\",\"sessionId\":\"{session_id}\",\"generation\":{generation},\"iterationId\":\"iteration-{current_iteration}\"},\"data\":{\"stopReason\":\"{terminal_stop_reason}\",\"gateResults\":{terminal_gate_results_json},\"failedRequiredGateIds\":{failed_required_gate_ids},\"appendPosition\":{current_iteration}}}'\n1149:             log: \"Terminal gates recorded at stop {terminal_stop_reason}. Failed required gates: {failed_required_gate_ids}\"\n1150:           branch_on: \"convergence_mode == 'divergent' AND stop_decision.reasonDetail == 'all_dimensions_clean'\"\n1151:           if_divergent_eligible:\n1152:             eligibility_contract:\n1153:               required_decision: \"STOP\"\n1154:               eligible_reasons: [all_dimensions_clean]\n1155:               excluded_reasons: [maxIterationsReached, blockedStop, stuckRecovery, error, manualStop, userPaused, maxDurationReached]\n1156:               fail_closed: \"Any missing or ambiguous reason uses if_existing_terminal_path without preparing a pivot. The nine legal-stop gates have already run and remain unchanged.\"\n1157:             steps:\n1158:               step_prepare_divergent_pivot:\n1159:                 action: \"Generate state-grounded read-only review candidates and prepare or resume the pivot transaction\"\n1160:                 dry_run_boundary: \"state-mutation\"\n1161:                 command: |\n1162:                   node .skilled/skills/system-deep-loop/runtime/scripts/divergent-pivot.cjs prepare --loop-type review --artifact-root \"{state_paths.packet_dir}\" --config \"{state_paths.config}\" --state-log \"{state_paths.state_log}\" --strategy \"{state_paths.strategy}\" --registry \"{state_paths.findings_registry}\" --current-iteration \"{current_iteration}\" --max-iterations \"{max_iterations}\" --trigger-reason \"{reason_detail}\"\n1163:                 working_directory: \"{repo_root}\"\n1164:                 outputs:\n1165:                   - pivot_prepare_json: \"The complete parsed JSON result\"\n1166:                   - pivot_prepare_status: \"status from the prepare result\"\n1167:                   - pivot_id: \"pivotId from the prepare result\"\n1168:                   - pivot_paths_json: \"paths from the prepare result as JSON\"\n1169:                   - pivot_resumed: \"resumed from the prepare result\"\n1170:                   - pivot_missing_seat_ids: \"missingSeats ids from a pending result\"\n1171:                   - pivot_seat_json: \"For the current seat_id, its mandate object from missingSeats\"\n1172:                   - pivot_seat_prompt: \"For the current seat_id, seatPrompts[seat_id]\"\n1173:                   - pivot_dispatch_context_json: \"dispatchContext from a pending result as JSON\"\n1174:                 short_circuit: \"When status is completed or failed, skip all dispatch and record steps and bind this result as pivot_result.\"\n1175: \n1176:               step_dispatch_pivot_seat:\n1177:                 action: \"Natively dispatch one read-only review direction-selection seat\"\n1178:                 for_each: \"seat_id in [seat-001, seat-002, seat-003], in that order. Run this step and then step_record_pivot_seat for one seat before the next seat starts. Seat roles: seat-001 analytical, seat-002 critical, seat-003 pragmatic.\"\n1179:                 skip_when: \"pivot_prepare_status != 'pending' or pivot_missing_seat_ids does not contain seat_id\"\n1180:                 dry_run_boundary: \"dispatch\"\n1181:                 capture_timing: true\n1182:                 if_native:\n1183:                   dispatch:\n1184:                     agent: deep-review\n1185:                     model: opus\n1186:                     context_source: \"pivot_seat_prompt\"\n1187:                   wait_for_completion: true\n1188:                 failure_contract: \"A native dispatch failure binds status=rejected, a {name,message} error, and the measured timestamps/duration, then proceeds to step_record_pivot_seat.\"\n1189:                 outputs:\n1190:                   - pivot_seat_dispatch_status: \"fulfilled or rejected\"\n1191:                   - pivot_seat_output_json: \"Raw native return serialized as JSON when fulfilled, else null\"\n1192:                   - pivot_seat_error_json: \"{name,message} when rejected, else null\"\n1193:                   - pivot_seat_started_at_iso: \"Dispatch start timestamp\"\n1194:                   - pivot_seat_completed_at_iso: \"Dispatch completion timestamp\"\n1195:                   - pivot_seat_duration_ms: \"Dispatch duration in milliseconds\"\n1196: \n1197:               step_record_pivot_seat:\n1198:                 action: \"Durably record the native dispatch outcome of the seat just dispatched\"\n1199:                 skip_when: \"pivot_prepare_status != 'pending' or pivot_missing_seat_ids does not contain seat_id\"\n1200:                 command: |\n1201:                   node .skilled/skills/system-deep-loop/runtime/scripts/divergent-pivot.cjs record-seat <<'PIVOT_SEAT'\n1202:                   {\"paths\":{pivot_paths_json},\"pivotId\":\"{pivot_id}\",\"seat\":{pivot_seat_json},\"status\":\"{pivot_seat_dispatch_status}\",\"output\":{pivot_seat_output_json},\"error\":{pivot_seat_error_json},\"startedAtIso\":\"{pivot_seat_started_at_iso}\",\"completedAtIso\":\"{pivot_seat_completed_at_iso}\",\"durationMs\":\"{pivot_seat_duration_ms}\"}\n1203:                   PIVOT_SEAT\n1204:                 working_directory: \"{repo_root}\"\n1205: \n1206:               step_finalize_divergent_pivot:\n1207:                 action: \"Finalize the prepared pivot after all missing native seats are durable\"\n1208:                 skip_when: \"pivot_prepare_status != 'pending'\"\n1209:                 command: |\n1210:                   node .skilled/skills/system-deep-loop/runtime/scripts/divergent-pivot.cjs finalize --paths-json '{pivot_paths_json}' --pivot-id \"{pivot_id}\" --resumed \"{pivot_resumed}\"\n1211:                 working_directory: \"{repo_root}\"\n1212:                 outputs:\n1213:                   - pivot_finalize_json: \"The complete parsed final result\"\n1214: \n1215:               step_resolve_divergent_pivot_result:\n1216:                 action: \"Use prepare's terminal result on resume/short-circuit, otherwise use finalize's result\"\n1217:                 branch_on: \"pivot_prepare_status\"\n1218:                 if_pending: { bind: { pivot_result: \"{pivot_finalize_json}\" } }\n1219:                 if_completed_or_failed: { bind: { pivot_result: \"{pivot_prepare_json}\" } }\n1220: \n1221:               step_apply_divergent_pivot_result:\n1222:                 action: \"Adopt a successful read-only review direction or fail closed to the existing synthesis path\"\n1223:                 branch_on: \"pivot_result.status\"\n1224:                 if_completed:\n1225:                   gate_divergent_pivot_choice:\n1226:                     applies_to: confirm\n1227:                     type: approval_gate\n1228:                     purpose: \"Approve the Council-selected read-only review direction before it becomes the next focus\"\n1229:                     order: \"Under confirm this gate runs before the set, command, log and proceed_to of this branch.\"\n1230:                     present: |\n1231:                       ## Divergent Review Pivot Candidate\n1232: \n1233:                       **Pivot**: {pivot_result.pivotId}\n1234:                       **Council-selected candidate**: {pivot_result.selectedCandidate.id}\n1235:                       **Review direction**: {pivot_result.restoredFocus}\n1236:                       **Agreement**: {pivot_result.agreement.endorsementCount}/3 material endorsements\n1237:                       **Swept direction**: {pivot_result.completedEvent.previousFocus}\n1238: \n1239:                       The adapter exposes an ordered candidate frontier and agreement tallies, but no ranked-candidate score contract. Choosing a different ranked candidate is therefore unavailable rather than inferred from array order. Every candidate remains read-only and cannot authorize a fix, target expansion, or file mutation.\n1240: \n1241:                       Options:\n1242:                       A) Accept the Council-selected candidate and continue\n1243:                       B) Choose a different ranked candidate (unavailable: no ranking contract)\n1244:                       C) manualStop and proceed to the existing pre-synthesis gate\n1245:                     wait_for: \"User response\"\n1246:                     after_gate_refresh_lock: gate_defaults.after_gate_refresh_lock\n1247:                     on_A:\n1248:                       bookkeeping_log: '{\"type\":\"event\",\"event\":\"pivot_confirm_accepted\",\"mode\":\"review\",\"run\":{current_iteration},\"pivotId\":\"{pivot_result.pivotId}\",\"selectedCandidate\":{pivot_result.selectedCandidate},\"timestamp\":\"{ISO_8601_NOW}\",\"sessionId\":\"{session_id}\",\"generation\":{generation}}'\n1249:                       continue: \"Run the set, command, log and proceed_to of this branch.\"\n1250:                     on_B:\n1251:                       message: \"No ranked alternative can be selected because the adapter exposes no ranking score or rank contract.\"\n1252:                       return_to: gate_divergent_pivot_choice\n1253:                     on_C:\n1254:                       bookkeeping_log: '{\"type\":\"event\",\"event\":\"manualStop\",\"mode\":\"review\",\"run\":{current_iteration},\"stopReason\":\"manualStop\",\"pivotId\":\"{pivot_result.pivotId}\",\"timestamp\":\"{ISO_8601_NOW}\",\"sessionId\":\"{session_id}\",\"generation\":{generation}}'\n1255:                       set: { reason: \"manualStop\" }\n1256:                       run_first: record_terminal_gates\n1257:                       skip_to: phase_synthesis\n1258:                   set:\n1259:                     next_dimension: \"{pivot_result.restoredFocus}\"\n1260:                     pivot_lineage: \"Pivot {pivot_result.pivotId} selected {pivot_result.selectedCandidate.id} from source iteration {current_iteration}.\"\n1261:                     saturated_directions: \"{pivot_result.completedEvent.saturatedDirections}\"\n1262:                   command: \"node .skilled/skills/system-deep-loop/runtime/scripts/reduce-state.cjs {spec_folder} {reducer_artifact_arg} --create-missing-anchors\"\n1263:                   log: \"Divergent review pivot {pivot_result.pivotId} restored focus to {pivot_result.restoredFocus}; continuing iteration {current_iteration}.\"\n1264:                   proceed_to: step_normalize_pause_events\n1265:                 if_failed:\n1266:                   gate_divergent_pivot_override:\n1267:                     applies_to: confirm\n1268:                     type: approval_gate\n1269:                     purpose: \"Offer the audited operator override when a failed pivot is recoverable\"\n1270:                     condition: \"Runs only when pivot_result.failedEvent.recoverableByOverride == true AND pivot_result.agreement.reason == 'insufficient_endorsement'. Otherwise this gate is skipped and the branch fails closed as written.\"\n1271:                     order: \"Under confirm this gate runs before the run_first, log and skip_to of this branch.\"\n1272:                     present: |\n1273:                       ## Divergent Review Pivot Did Not Converge\n1274: \n1275:                       **Pivot**: {pivot_result.pivotId}\n1276:                       **Failure**: {pivot_result.failureReason}\n1277:                       **Agreement tallies**: {pivot_result.agreement.tallies}\n1278: \n1279:                       The adapter marked this insufficient-endorsement failure as recoverable by explicit operator override. The candidate frontier is unranked; any override must name a persisted accepted candidate id, provide a rationale, and remains a read-only review direction.\n1280: \n1281:                       Options:\n1282:                       A) Fail closed to synthesis\n1283:                       B) Explicitly override with accepted candidate id + rationale\n1284:                       C) manualStop and proceed to the existing pre-synthesis gate\n1285:                     wait_for: \"User response\"\n1286:                     after_gate_refresh_lock: gate_defaults.after_gate_refresh_lock\n1287:                     on_A: { continue: \"Fail closed: run the run_first, log and skip_to of this branch.\" }\n1288:                     on_B:\n1289:                       action: \"Read pivot_result.paths.configPath, validate the supplied id against acceptedCandidates, bind the exact candidate and persisted previousFocus/saturatedDirections/frontier, and reject ids outside that frontier or any candidate that authorizes a fix, target expansion, or file mutation.\"\n1290:                       bookkeeping_log: '{\"type\":\"event\",\"event\":\"pivot_override_accepted\",\"mode\":\"review\",\"run\":{current_iteration},\"pivotId\":\"{pivot_result.pivotId}\",\"selectedCandidate\":{operator_selected_candidate},\"selectedFrontier\":{operator_selected_frontier},\"previousFocus\":\"{operator_previous_focus}\",\"saturatedDirections\":{operator_saturated_directions},\"reason\":\"{operator_override_rationale}\",\"agreementReason\":\"insufficient_endorsement\",\"timestamp\":\"{ISO_8601_NOW}\",\"sessionId\":\"{session_id}\",\"generation\":{generation}}'\n1291:                       set:\n1292:                         next_dimension: \"{operator_selected_candidate.focus}\"\n1293:                         pivot_lineage: \"Pivot {pivot_result.pivotId} used an audited insufficient-endorsement override for {operator_selected_candidate.id}.\"\n1294:                         saturated_directions: \"{operator_saturated_directions}\"\n1295:                       command: \"node .skilled/skills/system-deep-loop/runtime/scripts/reduce-state.cjs {spec_folder} {reducer_artifact_arg} --create-missing-anchors\"\n1296:                       proceed_to: step_normalize_pause_events\n1297:                     on_C:\n1298:                       bookkeeping_log: '{\"type\":\"event\",\"event\":\"manualStop\",\"mode\":\"review\",\"run\":{current_iteration},\"stopReason\":\"manualStop\",\"pivotId\":\"{pivot_result.pivotId}\",\"timestamp\":\"{ISO_8601_NOW}\",\"sessionId\":\"{session_id}\",\"generation\":{generation}}'\n1299:                       set: { reason: \"manualStop\" }\n1300:                       run_first: record_terminal_gates\n1301:                       skip_to: phase_synthesis\n1302:                   run_first: record_terminal_gates\n1303:                   log: \"Divergent review pivot {pivot_result.pivotId} failed closed ({pivot_result.failureReason}); proceeding to synthesis.\"\n1304:                   skip_to: phase_synthesis\n1305:             on_error:\n1306:               run_first: record_terminal_gates\n1307:               log: \"Divergent review pivot integration error; failing closed to the existing synthesis path.\"\n1308:               skip_to: phase_synthesis\n1309:           if_existing_terminal_path:\n1310:             run_first: record_terminal_gates\n1311:             log: \"Loop stopping. Reason: {reason}\"\n1312:             skip_to: phase_synthesis\n1313:         if_blocked:\n1314:           log: \"Legal-stop gates blocked STOP. Failed gates: {blocked_by_csv}. Continuing review.\"\n1315:         if_stuck_recovery:\n1316:           log: \"Stuck detected ({stuck_count} consecutive no-progress). Entering recovery.\"\n1317:           recovery_strategies:\n1318:             - \"Change granularity: file-level → function-level → line-level review\"\n1319:             - \"Traceability protocol replay: re-run unresolved core or overlay checks\"\n1320:             - \"Escalate severity review: re-examine P2 findings for potential P1 upgrades\"\n1321:           pivot_target: \"Pivot to the least-covered dimension (the review dimension with the fewest iteration passes and lowest coverage ratio).\"\n1322:           set:\n1323:             next_dimension: \"RECOVERY: {recovery_strategy}. Least-covered dimension: {least_explored}\"\n1324:             pending_stop_event: \"stuck_recovery\"\n1325:             pending_stop_reason: \"stuckRecovery\"\n1326:             pending_stop_detail: \"Recovery path activated after repeated no-progress iterations\"\n1327:         if_continue:\n1328:           log: \"Iteration {current_iteration}: Continuing. Dimension: {next_dimension}\"\n1329: \n1330:       step_normalize_pause_events:\n1331:         action: \"Rewrite raw pause and recovery events to the frozen STOP_REASONS enum at emission time: converged, maxIterationsReached, blockedStop, stuckRecovery, error, manualStop, userPaused, maxDurationReached\"\n1332:         if_pending_pause_event:\n[Output truncated. Continue reading with offset: 1333]"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\".skilled/commands/deep/assets/deep-review.yaml\",\"offset\":765,\"limit\":700}"},"time":{"start":1794865343018,"end":1794865343376}}}}
