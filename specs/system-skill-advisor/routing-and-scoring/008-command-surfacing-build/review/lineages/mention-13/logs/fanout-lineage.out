  '/doctor:skill-advisor embedder': { policy: 'ask', ownerSkillId: 'system-skill-advisor', scorerRow: true },\n167:   '/doctor:skill-advisor parent-skill': { policy: 'run', ownerSkillId: 'system-skill-advisor', scorerRow: true },\n168:   '/doctor:skill-advisor rebuild': { policy: 'ask', ownerSkillId: 'system-skill-advisor', scorerRow: true },\n169:   '/doctor:skill-advisor router-reach': { policy: 'run', ownerSkillId: 'system-skill-advisor', scorerRow: true },\n170:   '/doctor:skill-advisor skill-budget': { policy: 'run', ownerSkillId: 'system-skill-advisor', scorerRow: true },\n171:   '/doctor:skill-advisor skill-graph-freshness': { policy: 'run', ownerSkillId: 'system-skill-advisor', scorerRow: true },\n172:   '/doctor:skill-advisor tune': { policy: 'ask', ownerSkillId: 'system-skill-advisor', scorerRow: true },\n173:   '/doctor:speckit': { policy: 'run', ownerSkillId: 'system-skilled-doctor', scorerRow: true },\n174:   '/doctor:symlink check': { policy: 'run', ownerSkillId: 'system-skilled-doctor', scorerRow: true },\n175:   '/doctor:symlink link': { policy: 'ask', ownerSkillId: 'system-skilled-doctor', scorerRow: true },\n176:   '/doctor:symlink unlink': { policy: 'ask', ownerSkillId: 'system-skilled-doctor', scorerRow: true },\n177:   '/doctor:update': { policy: 'ask', ownerSkillId: 'system-skilled-doctor', scorerRow: true },\n178:   '/prompt:improve': { policy: 'start', ownerSkillId: 'sk-prompt', scorerRow: true },\n179:   '/speckit:ai-council': { policy: 'ask', ownerSkillId: 'system-spec-kit', scorerRow: true },\n180:   '/speckit:complete': { policy: 'start', ownerSkillId: 'system-spec-kit', scorerRow: true },\n181:   '/speckit:handoff': { policy: 'ask', ownerSkillId: 'system-spec-kit', scorerRow: true },\n182:   '/speckit:implement': { policy: 'start', ownerSkillId: 'system-spec-kit', scorerRow: true },\n183:   '/speckit:plan': { policy: 'start', ownerSkillId: 'system-spec-kit', scorerRow: true },\n184:   '/speckit:resume': { policy: 'start', ownerSkillId: 'system-spec-kit', scorerRow: true },\n185:   '/speckit:save': { policy: 'start', ownerSkillId: 'system-spec-kit', scorerRow: true },\n186:   '/speckit:search': { policy: 'run', ownerSkillId: 'system-spec-kit', scorerRow: true },\n187: };\n188: // END GENERATED COMMAND ROWS\n189: \n190: // The row for an id a recommendation carries, or undefined when that id names no\n191: // command. Own-key lookup because the table is generated data, so an inherited\n192: // name such as `constructor` must not resolve to a row nobody declared.\n193: export function commandRowFor(id: string): CommandRow | undefined {\n194:   return Object.hasOwn(COMMAND_ROWS, id) ? COMMAND_ROWS[id] : undefined;\n195: }\n196: \n197: // A typed command is the reader's own wording, so it counts only where a command\n198: // can start and where it ends on a boundary. That keeps a path such as\n199: // `docs/create:goal.md` and a prefix such as `/create:sk` from reading as a\n200: // command, and the longest key wins so `/group:name-parent` is never reduced to\n201: // its `/group:name` prefix. A dot or a slash followed by a word character\n202: // continues a file name or a path, while a sentence-ending period does not.\n203: // A mode suffix and a `:with-*` modifier end the command name the way a space\n204: // does, after any tracked command. The argument hints say which commands take\n205: // which, but a modifier typed on a command that does not take it still names\n206: // that command. The hints chain them, as in `:auto:with-research`, so a run of\n207: // them counts as one suffix.\n208: const COMMAND_START_BOUNDARY = /[\\s`'\"(*[~>\\u201c\\u2018\\u00ab\\u2032\\u2039]/;\n209: const COMMAND_CONTINUATION = /[a-z0-9_:-]/;\n210: const WORD_CHARACTER = /[a-z0-9_]/;\n211: const MODE_SUFFIX = /^(?::(?:auto|confirm|autopilot|unattended|with-(?:context|phases|research)))+(?![a-z0-9_:-])/;\n212: \n213: // A command that was renamed is still typed from habit. Its old name reads as\n214: // the command that replaced it, so the reader lands on the live workflow and\n215: // not on whatever skill the leftover words happen to score for. The old name\n216: // gets no command file of its own: this table is the only place it lives.\n217: const RETIRED_COMMANDS: Readonly<Record<string, string>> = {\n218:   '/create:skill': '/create:sk-skill',\n219: };\n220: \n221: export function typedCommandIn(prompt: string): string | undefined {\n222:   const lowered = prompt.toLowerCase();\n223:   let found: string | undefined;\n224:   for (const key of [...Object.keys(TRACKED_COMMANDS), ...Object.keys(RETIRED_COMMANDS)]) {\n225:     let index = lowered.indexOf(key);\n226:     while (index !== -1) {\n227:       const before = index === 0 ? '' : lowered[index - 1];\n228:       const after = lowered[index + key.length] ?? '';\n229:       const next = lowered[index + key.length + 1] ?? '';\n230:       const startsAtBoundary = before === '' || COMMAND_START_BOUNDARY.test(before);\n231:       const hasModeSuffix = MODE_SUFFIX.test(lowered.slice(index + key.length));\n232:       const continuesName =\n233:         !hasModeSuffix\n234:         && (COMMAND_CONTINUATION.test(after) || ((after === '/' || after === '.') && WORD_CHARACTER.test(next)));\n235:       const endsAtBoundary = after === '' || !continuesName;\n236:       if (startsAtBoundary && endsAtBoundary) {\n237:         if (found === undefined || key.length > found.length) found = key;\n238:         break;\n239:       }\n240:       index = lowered.indexOf(key, index + 1);\n241:     }\n242:   }\n243:   if (found !== undefined && Object.hasOwn(RETIRED_COMMANDS, found)) return RETIRED_COMMANDS[found];\n244:   return found;\n245: }\n246: \n247: // A typed command travels on the recommendation that leads, so it is delivered\n248: // only when the leading skill owns the command or carries the same command row.\n249: // A leading skill unrelated to the command must not carry it.\n250: export interface TypedCommand {\n251:   readonly command: string;\n252:   readonly policy: 'run' | 'start' | 'ask';\n253:   readonly ownerSkillId: string;\n254: }\n255: \n256: export function typedCommandForTop(topSkillId: string, prompt: string): TypedCommand | undefined {\n257:   const command = typedCommandIn(prompt);\n258:   if (command === undefined || !Object.hasOwn(TRACKED_COMMANDS, command)) return undefined;\n259:   if (commandOnlyMentioned(prompt, command)) return undefined;\n260:   const row = TRACKED_COMMANDS[command];\n261:   const sameCommandRow = commandRowFor(topSkillId)?.command === command;\n262:   if (topSkillId !== row.ownerSkillId && !sameCommandRow) return undefined;\n263:   return { command, policy: row.policy, ownerSkillId: row.ownerSkillId };\n264: }\n265: \n266: // Deep-loop commands open a long, multi-pass run, so one attached to a prompt\n267: // that merely mentions the topic spends the reader's budget on work they never\n268: // asked for. The list below is the vocabulary that counts as asking for it, and\n269: // it holds only effort wording: a bare topic word such as `research`, `review`\n270: // or `council` says what to look at, never how far to go, so it never qualifies\n271: // on its own.\n272: //\n273: // The phrases live in a data list, one per line, so the vocabulary a reviewer\n274: // has to judge stays visible and cheap to correct.\n275: export const DEPTH_WORDING: readonly string[] = [\n276:   'in depth',\n277:   'deep dive',\n278:   'deep research',\n279:   'deep review',\n280:   'thorough',\n281:   'thoroughly',\n282:   'exhaustive',\n283:   'iteratively',\n284:   'multiple passes',\n285:   'many passes',\n286:   'several passes',\n287:   'ask the council',\n288:   'convene',\n289:   'several models',\n290:   'final verdict',\n291:   'everything you can',\n292: ];\n293: \n294: // A creation workflow scaffolds, reviews and validates a whole document, which is\n295: // the wrong size for a correction inside one. The list below is the vocabulary\n296: // that marks that correction, and a line number points at one the same way.\n297: export const SMALL_EDIT_WORDING: readonly string[] = [\n298:   'typo',\n299:   'typos',\n300:   'spelling',\n301:   'misspelled',\n302:   'misspelling',\n303:   'grammar',\n304:   'punctuation',\n305:   'wording',\n306:   'broken link',\n307:   'broken links',\n308:   'dead link',\n309:   'dead links',\n310:   'one line',\n311:   'single line',\n312: ];\n313: \n314: // A phrase may carry punctuation a regex would read as a metacharacter, so it is\n315: // escaped before it is trusted as a pattern.\n316: function escapePhrase(phrase: string): string {\n317:   return phrase.replace(/[.*+?^${}()|[\\]\\\\]/g, '\\\\$&');\n318: }\n319: \n320: // One alternation over the list keeps the gate a single test per prompt, and the\n321: // boundary markers keep `thorough` from firing inside a longer word while a\n322: // multi-word phrase still has to match as a whole.\n323: const DEPTH_REQUEST = new RegExp(`\\\\b(?:${DEPTH_WORDING.map(escapePhrase).join('|')})\\\\b`);\n324: \n325: // The line alternative is a pattern rather than a phrase, so it is appended raw\n326: // beside the escaped vocabulary instead of being escaped with it.\n327: const SMALL_EDIT_REQUEST = new RegExp(\n328:   `\\\\b(?:${SMALL_EDIT_WORDING.map(escapePhrase).join('|')}|line \\\\d+)\\\\b`,\n329: );\n330: \n331: // A request that asks for a document to be created or written wants the whole\n332: // document, even when it names a correction to make afterwards, so this check\n333: // stands the small-edit gate down.\n334: const CREATION_REQUEST = /\\b(?:creat(?:e|es|ing)|writ(?:e|es|ing)|author(?:ing)?|draft(?:ing)?|scaffold(?:ing)?|generat(?:e|es|ing)|mak(?:e|es|ing)|new|build(?:ing)?|set up|add an?|need an?)\\b/;\n335: \n336: // A small edit names the correction to make, so the verb is what marks one.\n337: const CORRECTION_VERB = /\\b(?:fix|correct|update|edit|change|tweak|repair)\\b/;\n338: \n339: // These three creation commands write a whole document that is later corrected in\n340: // place, so a correction request names an edit to it rather than a new one. Every\n341: // other creation command names a purpose that a correction word belongs to.\n342: const SMALL_EDIT_GATED_COMMANDS: ReadonlySet<string> = new Set(['/create:readme', '/create:feature-catalog', '/create:manual-testing-playbook']);\n343: \n344: // Wording that asks for an answer and rules out a change. One pattern serves\n345: // every gate that has to honour it, so a new gate cannot drift from the first.\n346: // Words alone cannot tell \"make no changes to the files\" from a change request\n347: // that says what to leave alone, so both read as no change: losing an offer\n348: // costs less than offering a mutating command on a prompt that ruled one out.\n349: // A negated write verb counts only with an object that names nothing in\n350: // particular, because \"don't add tools\" limits a change and does not refuse it.\n351: export const NO_EDIT_REQUEST = /\\b(no edits?|make no changes|no changes yet|without making changes|(?:do not|don't|dont) (?:make (?:any )?changes|change|edit|modify|touch|(?:create|write|add|delete|remove) (?:it|this|that|anything|any files?))|read-only only|no edits yet|only; do not|just show|just list)\\b/;\n352: \n353: // Many keyboards type the contraction with a curly apostrophe, so the text is\n354: // folded to the straight form before the pattern reads it.\n355: export function isNoEditRequest(text: string): boolean {\n356:   return NO_EDIT_REQUEST.test(text.toLowerCase().replace(/[\\u2018\\u2019]/g, \"'\"));\n357: }\n358: \n359: // A refusal or a question reaches its command through a use verb, so the two\n360: // lists below share this one. A gap holds one or two plain words and no\n361: // punctuation, because a comma ends the clause that holds the lead.\n362: export const COMMAND_USE_VERB = '(?:run|start|use|invoke|launch|execute|call|trigger|open|rerun|re-run|kick off)';\n363: export const COMMAND_GAP_WORDS = \"(?:[a-z']+ ){0,2}\";\n364: \n365: // `why not` proposes the command rather than refusing it, so the word refuses\n366: // only where no `why` stands before it.\n367: const COMMAND_NOT_WORD = '(?<!\\\\bwhy )not';\n368: \n369: // A command the reader refuses is named without being asked for, so this list\n370: // holds the leads that mark that naming. A lead must sit directly before the\n371: // command so a later clause cannot refuse an earlier request, and a gap holds\n372: // plain words only so a refusal before a comma cannot swallow the request after\n373: // it. A reader who stops using a command names it only to refuse it.\n374: export const COMMAND_DECLINE_LEADS: readonly string[] = [\n375:   `(?:do not|don't|dont|never|${COMMAND_NOT_WORD}|won't|wont|no longer|cannot|can't|no need to|need not|needn't) (?!(?:forget|hesitate|fail|mind)\\\\b)${COMMAND_GAP_WORDS}${COMMAND_USE_VERB} ${COMMAND_GAP_WORDS}`,\n376:   `(?:skip|skipping|without|instead of|rather than|avoid|stop|stopped|quit|${COMMAND_NOT_WORD}) (?:(?!${COMMAND_USE_VERB}\\\\b)[a-z']+ ){0,2}`,\n377: ];\n378: \n379: // A refusal or a question over an or-list covers every command the list joins,\n380: // while a second use verb opens a clause of its own, so the list joins only `or`\n381: // and `, or`. A listed command may carry `the` before it and\n382: // `command` after it, and the command after the last `or` may carry `the`. A\n383: // listed command may also carry one plain word after it, such as the subcommand a\n384: // doctor command takes, so `do not run /x now or /y` refuses both.\n385: const COMMAND_OR_LIST = '(?:(?:the )?\\\\/[a-z][a-z0-9_-]*(?::[a-z][a-z0-9_-]*)?(?: [a-z][a-z0-9_-]*)?(?: command)?,? or (?:the )?)*';\n386: \n387: // A command the reader asks about is named without being asked for, so this list\n388: // holds the leads that mark that naming. A lead must sit directly before the\n389: // command so a later clause cannot turn an earlier request into a question, and\n390: // a gap holds plain words only so a question before a comma cannot swallow the\n391: // request after it.\n392: export const COMMAND_ASK_LEADS: readonly string[] = [\n393:   \"(?:what does|what is|what's|what would|what will|what did|how does|how did|why does|why did|explain|describe|tell me what|tell me how|tell me about|tell me why|difference between|differ from|differs from|different from|undo what|ran|already ran|was running) (?:the )?(?:command )?\",\n394:   `(?:should i|should we|do i need to|when would i) ${COMMAND_USE_VERB} (?:the )?(?:command )?`,\n395: ];\n396: \n397: // A bare ask word opens a statement as often as a question, so it marks a naming\n398: // only when the command it precedes is followed by a question mark before the\n399: // sentence ends, or when the lead itself opens a sentence, which a question mark ends as a full stop does.\n400: // A question often names the command after `the`, as in `is the /x command safe`.\n401: export const COMMAND_BARE_ASK_LEAD = '(?:is|does|can|will|would) (?:the )?';\n402: \n403: // A clause that opens with a use verb and `it` asks for the command an earlier\n404: // clause only named, so a naming such as `not run /x yet, please start it`\n405: // becomes a request. The clause has to open that way so `I will run it` stays a\n406: // statement.\n407: const COMMAND_ASKED_BY_PRONOUN = new RegExp(`(?:^|[,.;!?\\\\n]) *(?:(?:and|then|so|please|now|just|go ahead and) )*${COMMAND_USE_VERB} it\\\\b`);\n408: \n409: // A refusal can come after the name, as in \"/create:readme is not what I want, do\n410: // not run it\" or \"run /doctor:git setup but do not actually run it\". The clause\n411: // opens a new sentence or follows \"but\", \"and\" or \"so\", and refuses \"it\" with a\n412: // use verb, so \"run /speckit:save and don't skip it\" stays a request.\n413: const COMMAND_DECLINED_BY_PRONOUN = new RegExp(`(?:^|[,.;!?\\\\n]|\\\\b(?:but|and|so|though)\\\\b) *(?:(?:please|just|then|still) )*(?:do not|don't|dont|never)(?: (?:actually|really|yet|ever|even))? ${COMMAND_USE_VERB} it\\\\b`);\n414: \n415: // A command named as a document is read about, not run: \"read the /create:readme\n416: // document\", \"open the /deep:review command file\". The name needs a determiner\n417: // before it, because a typed request puts its argument there instead, as in\n418: // \"/create:diff file a.md b.md\".\n419: const COMMAND_AS_DOCUMENT = /^(?: command)?(?:'s)? (?:doc|docs|document|documentation|file|page|source|definition|markdown)\\b/;\n420: \n421: // A prompt names a command to refuse it or to ask about it as often as it names\n422: // one to run it, so an offer must read the naming before it trusts the name. The\n423: // text is folded first, because a keyed apostrophe or a run of spaces must not\n424: // hide the lead, while a line break survives as the sentence end it is. Inline\n425: // code, bold, strike, brackets, parentheses, guillemets, primes and quote marks\n426: // around a name are dropped for the same reason, so a refusal of a wrapped\n427: // command reads as the plain refusal does. An underscore\n428: // stays, because a command name may hold one. A single quote goes only where it\n429: // opens or closes a command name, because the same mark is the apostrophe of a\n430: // lead such as \"don't\" or \"what's\". A retired name is read beside the current\n431: // one, because a reader who refuses the old spelling refuses the command it now\n432: // maps to. The\n433: // boundary before the lead keeps a command name from matching inside a word or a\n434: // path, and the boundary after it keeps a longer command name from reading as the\n435: // shorter one or a doc path such as `/create:readme.md` from reading as a naming. Every occurrence has to carry a lead, because one led naming does\n436: // not turn a later unled naming into a request.\n437: export function commandOnlyMentioned(prompt: string, command: string): boolean {\n438:   const text = prompt\n439:     .toLowerCase()\n440:     .replace(/<\\/?(?:code|kbd|samp|tt)>/g, '')\n441:     .replace(/[`*\"\\u201c\\u201d[\\]()~\\u00ab\\u00bb\\u2032\\u2039\\u203a]/g, '')\n442:     .replace(/[\\u2018\\u2019]/g, \"'\")\n443:     .replace(/(^|[^a-z0-9])'(?=\\/[a-z])/g, '$1')\n444:     .replace(/(\\/[a-z][a-z0-9_-]*(?::[a-z][a-z0-9_-]*)*(?: [a-z][a-z0-9_-]*)?)'(?![a-z0-9])/g, '$1')\n445:     .replace(/[^\\S\\n]+/g, ' ')\n446:     .replace(/ *\\n\\s*/g, '\\n');\n447:   const current = command.toLowerCase();\n448:   const spellings = [current, ...Object.keys(RETIRED_COMMANDS).filter((retired) => RETIRED_COMMANDS[retired] === current)]\n449:     .sort((left, right) => right.length - left.length);\n450:   const name = `(?:${spellings.map(escapePhrase).join('|')})`;\n451:   const occurrences = [...text.matchAll(new RegExp(`(?:^|[^a-z0-9_/])${name}(?![a-z0-9_-]|[./][a-z0-9])`, 'g'))];\n452:   if (occurrences.length === 0) return false;\n453:   return occurrences.every((occurrence) => {\n454:     const nameEnd = (occurrence.index ?? 0) + occurrence[0].length;\n455:     const before = text.slice(0, nameEnd);\n456:     const tail = text.slice(nameEnd);\n457:     const clause = tail.split(/(?:^|[\\s,;(])\\/[a-z][a-z0-9_-]*(?::[a-z][a-z0-9_-]*)?(?![a-z0-9_\\/-]|\\.[a-z0-9])/)[0];\n458:     if (COMMAND_AS_DOCUMENT.test(tail) && new RegExp(`\\\\b(?:the|this|that) ${name}$`).test(before)) return true;\n459:     if (COMMAND_DECLINED_BY_PRONOUN.test(clause)) return true;\n460:     if (COMMAND_ASKED_BY_PRONOUN.test(clause)) return false;\n461:     const led = COMMAND_DECLINE_LEADS.some((lead) => (\n462:       new RegExp(`(?:^|[^a-z0-9_/])${lead}${COMMAND_OR_LIST}${name}$`).test(before)\n463:     )) || COMMAND_ASK_LEADS.some((lead) => (\n464:       new RegExp(`(?:^|[^a-z0-9_/])${lead}${COMMAND_OR_LIST}${name}$`).test(before)\n465:     ));\n466:     if (led) return true;\n467:     const bareLead = new RegExp(`(?:^|[^a-z0-9_/])${COMMAND_BARE_ASK_LEAD}${COMMAND_OR_LIST}${name}$`).test(before);\n468:     if (!bareLead) return false;\n469:     const sentenceEnd = tail.search(/[.!\\n]/);\n470:     const sentence = sentenceEnd === -1 ? tail : tail.slice(0, sentenceEnd);\n471:     // A chat question often leaves the question mark off, so a bare ask word that\n472:     // opens a sentence still asks about the command.\n473:     return sentence.includes('?')\n474:       || new RegExp(`(?:^|[.!?\\\\n] *)${COMMAND_BARE_ASK_LEAD}${COMMAND_OR_LIST}${name}$`).test(before);\n475:   });\n476: }\n477: \n478: // A compiled route arrives as unvalidated JSON from a separate process, so the\n479: // shape is narrowed here rather than trusted. Arrays count as objects in\n480: // JavaScript and would let `action` read off an unrelated field, so they are\n481: // excluded explicitly.\n482: function asRecord(value: unknown): Record<string, unknown> | undefined {\n483:   if (typeof value !== 'object' || value === null || Array.isArray(value)) return undefined;\n484:   return value as Record<string, unknown>;\n485: }\n486: \n487: // The command for a hub's recommendation, or undefined when the route does not\n488: // single out one mode. Only a single-mode route names a command unambiguously:\n489: // a bundle or a multi-target route has more than one answer, and asking the\n490: // reader to pick belongs to the recommend path, not here. Never throws, because\n491: // a missing command must degrade to \"no command offered\" rather than break\n492: // routing. The prompt decides whether a costly deep-loop command is offered at\n493: // all: a reader who only asks about the topic gets no command, rather than one\n494: // that would launch work they never requested.\n495: export function attachCommand(\n496:   skillId: string,\n497:   compiledRoute: unknown,\n498:   prompt: string,\n499:   modeCommands: Readonly<Record<string, Readonly<Record<string, string>>>> = MODE_COMMANDS,\n500: ): string | undefined {\n501:   const route = asRecord(compiledRoute);\n502:   if (!route) return undefined;\n503:   if (route.action !== 'route' || route.selectionKind !== 'single') return undefined;\n504: \n505:   const targets = route.targets;\n506:   if (!Array.isArray(targets) || targets.length !== 1) return undefined;\n507: \n508:   const onlyTarget = asRecord(targets[0]);\n509:   if (!onlyTarget) return undefined;\n510: \n511:   const workflowMode = onlyTarget.workflowMode;\n512:   if (typeof workflowMode !== 'string' || workflowMode === '') return undefined;\n513: \n514:   // A reader who rules out a change gets no command from either path, so the hub\n515:   // route never offers what the scorer already withholds.\n516:   if (isNoEditRequest(prompt)) return undefined;\n517: \n518:   // Own-key lookup on both levels: the table is data read from a generated\n519:   // object, so an inherited name such as `constructor` must not resolve to a\n520:   // command the hub never declared.\n521:   if (!Object.prototype.hasOwnProperty.call(modeCommands, skillId)) return undefined;\n522:   const commands = modeCommands[skillId];\n523:   if (!Object.prototype.hasOwnProperty.call(commands, workflowMode)) return undefined;\n524: \n525:   // A route can pick the mode because the prompt named its command, so a naming\n526:   // that refused or asked about the command must not produce the offer.\n527:   if (commandOnlyMentioned(prompt, commands[workflowMode])) return undefined;\n528: \n529:   // A correction inside one document is not a request for a creation workflow,\n530:   // which scaffolds, reviews and validates a whole one.\n531:   if (\n532:     SMALL_EDIT_GATED_COMMANDS.has(commands[workflowMode])\n533:     && SMALL_EDIT_REQUEST.test(prompt.toLowerCase())\n534:     && !CREATION_REQUEST.test(prompt.toLowerCase())\n535:     && CORRECTION_VERB.test(prompt.toLowerCase())\n536:   ) return undefined;\n537: \n538:   // Deep-loop commands are the ones that commit the reader to a long, multi-pass\n539:   // run, so they are offered only when the prompt asks for that effort. Typing\n540:   // the command being attached is itself the ask, while typing another deep-loop\n541:   // command asks for that command, not this one. Every other hub answers a short\n542:   // question with a short answer, so no other skill consults the wording list.\n543:   if (skillId === 'system-deep-loop') {\n544:     const typesThisCommand = typedCommandIn(prompt) === commands[workflowMode];\n545:     if (!typesThisCommand && !DEPTH_REQUEST.test(prompt.toLowerCase())) return undefined;\n546:   }\n547: \n548:   return commands[workflowMode];\n549: }\n550: \n551: // A hub that withholds its command because the prompt names no single mode must\n552: // still tell the reader why no command came with it, and only a hub whose modes\n553: // map to commands withholds one. A hub that tops a prompt which never named it\n554: // is the scorer's guess, so the label would point at modes the reader did not\n555: // ask about.\n556: export function routeNeedsMode(\n557:   skillId: string,\n558:   compiledRoute: unknown,\n559:   namedSkills: readonly string[],\n560: ): boolean {\n561:   if (!namedSkills.includes(skillId)) return false;\n562:   const route = asRecord(compiledRoute);\n563:   if (!route) return false;\n564:   if (route.action !== 'defer' && route.action !== 'clarify') return false;\n565:   return Object.prototype.hasOwnProperty.call(MODE_COMMANDS, skillId);\n566: }","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file .skilled/skills/system-skill-advisor/runtime/lib/command-attach.ts, lines 1-566\n1: // ───────────────────────────────────────────────────────────────\n2: // MODULE: Slash command attached to a hub's recommendation\n3: // ───────────────────────────────────────────────────────────────\n4: //\n5: // The advisor can name the workflow mode a hub would route a prompt to, but the\n6: // reader still has to translate that mode into the slash command that acts on\n7: // it. This module owns that translation and nothing else, kept free of imports\n8: // so the recommend path and a test read the same semantics.\n9: //\n10: // The mode-to-command table is generated rather than hand-maintained: each row is\n11: // derived from a hub's own command files, so a hub that adds or renames a mode\n12: // regenerates its row instead of drifting from a copy someone forgot to update.\n13: \n14: // BEGIN GENERATED MODE COMMANDS\n15: export const MODE_COMMANDS: Readonly<Record<string, Readonly<Record<string, string>>>> = {\n16:   'sk-design': {\n17:     'sk-design-chart': '/design:chart',\n18:     'sk-design-diagram': '/design:diagram',\n19:     'sk-design-md-generator': '/design:extract',\n20:   },\n21:   'sk-doc': {\n22:     'sk-create-agent': '/create:agent',\n23:     'sk-create-benchmark': '/create:benchmark',\n24:     'sk-create-changelog': '/create:changelog',\n25:     'sk-create-command': '/create:command',\n26:     'sk-create-diff': '/create:diff',\n27:     'sk-create-feature-catalog': '/create:feature-catalog',\n28:     'sk-create-goal': '/create:goal',\n29:     'sk-create-manual-testing-playbook': '/create:manual-testing-playbook',\n30:     'sk-create-readme': '/create:readme',\n31:     'sk-create-repo-rule': '/create:repo-rule',\n32:     'sk-create-skill': '/create:sk-skill',\n33:     'sk-create-skill-parent': '/create:skill-parent',\n34:     'sk-create-with-human-voice': '/create:with-human-voice',\n35:   },\n36:   'system-deep-loop': {\n37:     'research': '/deep:research',\n38:     'review': '/deep:review',\n39:   },\n40: };\n41: // END GENERATED MODE COMMANDS\n42: \n43: // One row of the command table: the runnable slash command, the policy that says\n44: // whether it runs, asks or starts a session, the class that says what the run\n45: // writes, and the skill that owns it. The rows are generated, so only the shape\n46: // lives here.\n47: export interface CommandRow {\n48:   readonly command: string;\n49:   readonly policy?: 'run' | 'start' | 'ask';\n50:   readonly mutating?: 'read-only' | 'add-only' | 'mutates';\n51:   readonly ownerSkillId: string;\n52: }\n53: \n54: // The table below covers every tracked command, whether or not its bridge is\n55: // active, so a typed command always has a policy and an owner. `scorerRow` says\n56: // whether a scorer can also return the command on its own.\n57: export interface TrackedCommand {\n58:   readonly policy: 'run' | 'start' | 'ask';\n59:   readonly ownerSkillId: string;\n60:   readonly scorerRow: boolean;\n61: }\n62: \n63: // BEGIN GENERATED COMMAND ROWS\n64: export const COMMAND_ROWS: Readonly<Record<string, CommandRow>> = {\n65:   'command-create-agent': { command: '/create:agent', policy: 'start', mutating: 'mutates', ownerSkillId: 'sk-doc' },\n66:   'command-create-changelog': { command: '/create:changelog', policy: 'ask', mutating: 'mutates', ownerSkillId: 'sk-doc' },\n67:   'command-create-feature-catalog': { command: '/create:feature-catalog', policy: 'start', mutating: 'mutates', ownerSkillId: 'sk-doc' },\n68:   'command-create-manual-testing-playbook': { command: '/create:manual-testing-playbook', policy: 'start', mutating: 'mutates', ownerSkillId: 'sk-doc' },\n69:   'command-create-readme': { command: '/create:readme', policy: 'start', mutating: 'mutates', ownerSkillId: 'sk-doc' },\n70:   'command-create-sk-skill': { command: '/create:sk-skill', policy: 'start', mutating: 'mutates', ownerSkillId: 'sk-doc' },\n71:   'command-deep-research': { command: '/deep:research', policy: 'ask', mutating: 'mutates', ownerSkillId: 'system-deep-loop' },\n72:   'command-deep-review': { command: '/deep:review', policy: 'ask', mutating: 'mutates', ownerSkillId: 'system-deep-loop' },\n73:   'command-doctor-agents-md-check': { command: '/doctor:agents-md check', policy: 'run', mutating: 'read-only', ownerSkillId: 'system-skilled-doctor' },\n74:   'command-doctor-agents-md-embed': { command: '/doctor:agents-md embed', policy: 'ask', mutating: 'mutates', ownerSkillId: 'system-skilled-doctor' },\n75:   'command-doctor-agents-md-restore': { command: '/doctor:agents-md restore', policy: 'ask', mutating: 'mutates', ownerSkillId: 'system-skilled-doctor' },\n76:   'command-doctor-ci-report': { command: '/doctor:ci report', policy: 'run', mutating: 'read-only', ownerSkillId: 'sk-code' },\n77:   'command-doctor-ci-scaffold': { command: '/doctor:ci scaffold', policy: 'ask', mutating: 'mutates', ownerSkillId: 'sk-code' },\n78:   'command-doctor-ci-toggle': { command: '/doctor:ci toggle', policy: 'ask', mutating: 'mutates', ownerSkillId: 'sk-code' },\n79:   'command-doctor-deep-loop': { command: '/doctor:deep-loop', policy: 'run', mutating: 'add-only', ownerSkillId: 'system-deep-loop' },\n80:   'command-doctor-env': { command: '/doctor:env list', policy: 'run', mutating: 'read-only', ownerSkillId: 'system-skilled-doctor' },\n81:   'command-doctor-git-hooks': { command: '/doctor:git hooks', policy: 'ask', mutating: 'mutates', ownerSkillId: 'sk-git' },\n82:   'command-doctor-git-setup': { command: '/doctor:git setup', policy: 'run', mutating: 'read-only', ownerSkillId: 'sk-git' },\n83:   'command-doctor-git-standards': { command: '/doctor:git standards', policy: 'ask', mutating: 'mutates', ownerSkillId: 'sk-git' },\n84:   'command-doctor-helper': { command: '/doctor:helper', policy: 'run', mutating: 'read-only', ownerSkillId: 'system-skilled-doctor' },\n85:   'command-doctor-install': { command: '/doctor:install', policy: 'run', mutating: 'read-only', ownerSkillId: 'system-skilled-doctor' },\n86:   'command-doctor-mcp-debug': { command: '/doctor:mcp debug', policy: 'ask', mutating: 'mutates', ownerSkillId: 'system-skilled-doctor' },\n87:   'command-doctor-mcp-install': { command: '/doctor:mcp install', policy: 'ask', mutating: 'mutates', ownerSkillId: 'system-skilled-doctor' },\n88:   'command-doctor-overlay-apply': { command: '/doctor:overlay apply', policy: 'ask', mutating: 'mutates', ownerSkillId: 'system-skilled-doctor' },\n89:   'command-doctor-overlay-repin': { command: '/doctor:overlay repin', policy: 'ask', mutating: 'mutates', ownerSkillId: 'system-skilled-doctor' },\n90:   'command-doctor-overlay-status': { command: '/doctor:overlay status', policy: 'run', mutating: 'read-only', ownerSkillId: 'system-skilled-doctor' },\n91:   'command-doctor-runtime-mirrors': { command: '/doctor:runtime-mirrors', policy: 'run', mutating: 'read-only', ownerSkillId: 'system-skilled-doctor' },\n92:   'command-doctor-setup': { command: '/doctor:setup', policy: 'run', mutating: 'read-only', ownerSkillId: 'system-skilled-doctor' },\n93:   'command-doctor-sk-code-quality': { command: '/doctor:sk-code quality', policy: 'ask', mutating: 'mutates', ownerSkillId: 'sk-code' },\n94:   'command-doctor-sk-code-setup': { command: '/doctor:sk-code setup', policy: 'run', mutating: 'read-only', ownerSkillId: 'sk-code' },\n95:   'command-doctor-sk-skill-check': { command: '/doctor:sk-skill check', policy: 'run', mutating: 'read-only', ownerSkillId: 'sk-doc' },\n96:   'command-doctor-sk-skill-convert': { command: '/doctor:sk-skill convert', policy: 'ask', mutating: 'mutates', ownerSkillId: 'sk-doc' },\n97:   'command-doctor-skill-advisor-embedder': { command: '/doctor:skill-advisor embedder', policy: 'ask', mutating: 'mutates', ownerSkillId: 'system-skill-advisor' },\n98:   'command-doctor-skill-advisor-parent-skill': { command: '/doctor:skill-advisor parent-skill', policy: 'run', mutating: 'read-only', ownerSkillId: 'system-skill-advisor' },\n99:   'command-doctor-skill-advisor-rebuild': { command: '/doctor:skill-advisor rebuild', policy: 'ask', mutating: 'mutates', ownerSkillId: 'system-skill-advisor' },\n100:   'command-doctor-skill-advisor-router-reach': { command: '/doctor:skill-advisor router-reach', policy: 'run', mutating: 'read-only', ownerSkillId: 'system-skill-advisor' },\n101:   'command-doctor-skill-advisor-skill-budget': { command: '/doctor:skill-advisor skill-budget', policy: 'run', mutating: 'read-only', ownerSkillId: 'system-skill-advisor' },\n102:   'command-doctor-skill-advisor-skill-graph-freshness': { command: '/doctor:skill-advisor skill-graph-freshness', policy: 'run', mutating: 'read-only', ownerSkillId: 'system-skill-advisor' },\n103:   'command-doctor-skill-advisor-tune': { command: '/doctor:skill-advisor tune', policy: 'ask', mutating: 'mutates', ownerSkillId: 'system-skill-advisor' },\n104:   'command-doctor-speckit': { command: '/doctor:speckit', policy: 'run', mutating: 'add-only', ownerSkillId: 'system-skilled-doctor' },\n105:   'command-doctor-symlink-check': { command: '/doctor:symlink check', policy: 'run', mutating: 'read-only', ownerSkillId: 'system-skilled-doctor' },\n106:   'command-doctor-symlink-link': { command: '/doctor:symlink link', policy: 'ask', mutating: 'mutates', ownerSkillId: 'system-skilled-doctor' },\n107:   'command-doctor-symlink-unlink': { command: '/doctor:symlink unlink', policy: 'ask', mutating: 'mutates', ownerSkillId: 'system-skilled-doctor' },\n108:   'command-doctor-update': { command: '/doctor:update', policy: 'ask', mutating: 'mutates', ownerSkillId: 'system-skilled-doctor' },\n109:   'command-prompt-improve': { command: '/prompt:improve', policy: 'start', mutating: 'mutates', ownerSkillId: 'sk-prompt' },\n110:   'command-spec-kit-deep-research': { command: '/deep:research', policy: 'ask', mutating: 'mutates', ownerSkillId: 'system-deep-loop' },\n111:   'command-spec-kit-deep-review': { command: '/deep:review', policy: 'ask', mutating: 'mutates', ownerSkillId: 'system-deep-loop' },\n112:   'command-speckit-ai-council': { command: '/speckit:ai-council', policy: 'ask', mutating: 'mutates', ownerSkillId: 'system-spec-kit' },\n113:   'command-speckit-complete': { command: '/speckit:complete', policy: 'start', mutating: 'mutates', ownerSkillId: 'system-spec-kit' },\n114:   'command-speckit-handoff': { command: '/speckit:handoff', policy: 'ask', mutating: 'mutates', ownerSkillId: 'system-spec-kit' },\n115:   'command-speckit-implement': { command: '/speckit:implement', policy: 'start', mutating: 'mutates', ownerSkillId: 'system-spec-kit' },\n116:   'command-speckit-plan': { command: '/speckit:plan', policy: 'start', mutating: 'mutates', ownerSkillId: 'system-spec-kit' },\n117:   'command-speckit-resume': { command: '/speckit:resume', policy: 'start', mutating: 'mutates', ownerSkillId: 'system-spec-kit' },\n118:   'command-speckit-save': { command: '/speckit:save', policy: 'start', mutating: 'mutates', ownerSkillId: 'system-spec-kit' },\n119:   'command-speckit-search': { command: '/speckit:search', policy: 'run', mutating: 'read-only', ownerSkillId: 'system-spec-kit' },\n120:   'create:agent': { command: '/create:agent', policy: 'start', mutating: 'mutates', ownerSkillId: 'sk-doc' },\n121:   'create:manual-testing-playbook': { command: '/create:manual-testing-playbook', policy: 'start', mutating: 'mutates', ownerSkillId: 'sk-doc' },\n122: };\n123: export const TRACKED_COMMANDS: Readonly<Record<string, TrackedCommand>> = {\n124:   '/create:agent': { policy: 'start', ownerSkillId: 'sk-doc', scorerRow: true },\n125:   '/create:benchmark': { policy: 'start', ownerSkillId: 'sk-doc', scorerRow: false },\n126:   '/create:changelog': { policy: 'ask', ownerSkillId: 'sk-doc', scorerRow: false },\n127:   '/create:command': { policy: 'start', ownerSkillId: 'sk-doc', scorerRow: false },\n128:   '/create:diff': { policy: 'start', ownerSkillId: 'sk-doc', scorerRow: false },\n129:   '/create:feature-catalog': { policy: 'start', ownerSkillId: 'sk-doc', scorerRow: false },\n130:   '/create:goal': { policy: 'start', ownerSkillId: 'sk-doc', scorerRow: false },\n131:   '/create:manual-testing-playbook': { policy: 'start', ownerSkillId: 'sk-doc', scorerRow: true },\n132:   '/create:readme': { policy: 'start', ownerSkillId: 'sk-doc', scorerRow: false },\n133:   '/create:repo-rule': { policy: 'start', ownerSkillId: 'sk-doc', scorerRow: false },\n134:   '/create:sk-skill': { policy: 'start', ownerSkillId: 'sk-doc', scorerRow: false },\n135:   '/create:skill-parent': { policy: 'start', ownerSkillId: 'sk-doc', scorerRow: false },\n136:   '/create:with-human-voice': { policy: 'start', ownerSkillId: 'sk-doc', scorerRow: false },\n137:   '/deep:research': { policy: 'ask', ownerSkillId: 'system-deep-loop', scorerRow: false },\n138:   '/deep:review': { policy: 'ask', ownerSkillId: 'system-deep-loop', scorerRow: false },\n139:   '/design:chart': { policy: 'start', ownerSkillId: 'sk-design', scorerRow: false },\n140:   '/design:diagram': { policy: 'start', ownerSkillId: 'sk-design', scorerRow: false },\n141:   '/design:extract': { policy: 'ask', ownerSkillId: 'sk-design', scorerRow: false },\n142:   '/doctor:agents-md check': { policy: 'run', ownerSkillId: 'system-skilled-doctor', scorerRow: true },\n143:   '/doctor:agents-md embed': { policy: 'ask', ownerSkillId: 'system-skilled-doctor', scorerRow: true },\n144:   '/doctor:agents-md restore': { policy: 'ask', ownerSkillId: 'system-skilled-doctor', scorerRow: true },\n145:   '/doctor:ci report': { policy: 'run', ownerSkillId: 'sk-code', scorerRow: true },\n146:   '/doctor:ci scaffold': { policy: 'ask', ownerSkillId: 'sk-code', scorerRow: true },\n147:   '/doctor:ci toggle': { policy: 'ask', ownerSkillId: 'sk-code', scorerRow: true },\n148:   '/doctor:deep-loop': { policy: 'run', ownerSkillId: 'system-deep-loop', scorerRow: true },\n149:   '/doctor:env list': { policy: 'run', ownerSkillId: 'system-skilled-doctor', scorerRow: true },\n150:   '/doctor:git hooks': { policy: 'ask', ownerSkillId: 'sk-git', scorerRow: true },\n151:   '/doctor:git setup': { policy: 'run', ownerSkillId: 'sk-git', scorerRow: true },\n152:   '/doctor:git standards': { policy: 'ask', ownerSkillId: 'sk-git', scorerRow: true },\n153:   '/doctor:helper': { policy: 'run', ownerSkillId: 'system-skilled-doctor', scorerRow: true },\n154:   '/doctor:install': { policy: 'run', ownerSkillId: 'system-skilled-doctor', scorerRow: true },\n155:   '/doctor:mcp debug': { policy: 'ask', ownerSkillId: 'system-skilled-doctor', scorerRow: true },\n156:   '/doctor:mcp install': { policy: 'ask', ownerSkillId: 'system-skilled-doctor', scorerRow: true },\n157:   '/doctor:overlay apply': { policy: 'ask', ownerSkillId: 'system-skilled-doctor', scorerRow: true },\n158:   '/doctor:overlay repin': { policy: 'ask', ownerSkillId: 'system-skilled-doctor', scorerRow: true },\n159:   '/doctor:overlay status': { policy: 'run', ownerSkillId: 'system-skilled-doctor', scorerRow: true },\n160:   '/doctor:runtime-mirrors': { policy: 'run', ownerSkillId: 'system-skilled-doctor', scorerRow: true },\n161:   '/doctor:setup': { policy: 'run', ownerSkillId: 'system-skilled-doctor', scorerRow: true },\n162:   '/doctor:sk-code quality': { policy: 'ask', ownerSkillId: 'sk-code', scorerRow: true },\n163:   '/doctor:sk-code setup': { policy: 'run', ownerSkillId: 'sk-code', scorerRow: true },\n164:   '/doctor:sk-skill check': { policy: 'run', ownerSkillId: 'sk-doc', scorerRow: true },\n165:   '/doctor:sk-skill convert': { policy: 'ask', ownerSkillId: 'sk-doc', scorerRow: true },\n166:   '/doctor:skill-advisor embedder': { policy: 'ask', ownerSkillId: 'system-skill-advisor', scorerRow: true },\n167:   '/doctor:skill-advisor parent-skill': { policy: 'run', ownerSkillId: 'system-skill-advisor', scorerRow: true },\n168:   '/doctor:skill-advisor rebuild': { policy: 'ask', ownerSkillId: 'system-skill-advisor', scorerRow: true },\n169:   '/doctor:skill-advisor router-reach': { policy: 'run', ownerSkillId: 'system-skill-advisor', scorerRow: true },\n170:   '/doctor:skill-advisor skill-budget': { policy: 'run', ownerSkillId: 'system-skill-advisor', scorerRow: true },\n171:   '/doctor:skill-advisor skill-graph-freshness': { policy: 'run', ownerSkillId: 'system-skill-advisor', scorerRow: true },\n172:   '/doctor:skill-advisor tune': { policy: 'ask', ownerSkillId: 'system-skill-advisor', scorerRow: true },\n173:   '/doctor:speckit': { policy: 'run', ownerSkillId: 'system-skilled-doctor', scorerRow: true },\n174:   '/doctor:symlink check': { policy: 'run', ownerSkillId: 'system-skilled-doctor', scorerRow: true },\n175:   '/doctor:symlink link': { policy: 'ask', ownerSkillId: 'system-skilled-doctor', scorerRow: true },\n176:   '/doctor:symlink unlink': { policy: 'ask', ownerSkillId: 'system-skilled-doctor', scorerRow: true },\n177:   '/doctor:update': { policy: 'ask', ownerSkillId: 'system-skilled-doctor', scorerRow: true },\n178:   '/prompt:improve': { policy: 'start', ownerSkillId: 'sk-prompt', scorerRow: true },\n179:   '/speckit:ai-council': { policy: 'ask', ownerSkillId: 'system-spec-kit', scorerRow: true },\n180:   '/speckit:complete': { policy: 'start', ownerSkillId: 'system-spec-kit', scorerRow: true },\n181:   '/speckit:handoff': { policy: 'ask', ownerSkillId: 'system-spec-kit', scorerRow: true },\n182:   '/speckit:implement': { policy: 'start', ownerSkillId: 'system-spec-kit', scorerRow: true },\n183:   '/speckit:plan': { policy: 'start', ownerSkillId: 'system-spec-kit', scorerRow: true },\n184:   '/speckit:resume': { policy: 'start', ownerSkillId: 'system-spec-kit', scorerRow: true },\n185:   '/speckit:save': { policy: 'start', ownerSkillId: 'system-spec-kit', scorerRow: true },\n186:   '/speckit:search': { policy: 'run', ownerSkillId: 'system-spec-kit', scorerRow: true },\n187: };\n188: // END GENERATED COMMAND ROWS\n189: \n190: // The row for an id a recommendation carries, or undefined when that id names no\n191: // command. Own-key lookup because the table is generated data, so an inherited\n192: // name such as `constructor` must not resolve to a row nobody declared.\n193: export function commandRowFor(id: string): CommandRow | undefined {\n194:   return Object.hasOwn(COMMAND_ROWS, id) ? COMMAND_ROWS[id] : undefined;\n195: }\n196: \n197: // A typed command is the reader's own wording, so it counts only where a command\n198: // can start and where it ends on a boundary. That keeps a path such as\n199: // `docs/create:goal.md` and a prefix such as `/create:sk` from reading as a\n200: // command, and the longest key wins so `/group:name-parent` is never reduced to\n201: // its `/group:name` prefix. A dot or a slash followed by a word character\n202: // continues a file name or a path, while a sentence-ending period does not.\n203: // A mode suffix and a `:with-*` modifier end the command name the way a space\n204: // does, after any tracked command. The argument hints say which commands take\n205: // which, but a modifier typed on a command that does not take it still names\n206: // that command. The hints chain them, as in `:auto:with-research`, so a run of\n207: // them counts as one suffix.\n208: const COMMAND_START_BOUNDARY = /[\\s`'\"(*[~>\\u201c\\u2018\\u00ab\\u2032\\u2039]/;\n209: const COMMAND_CONTINUATION = /[a-z0-9_:-]/;\n210: const WORD_CHARACTER = /[a-z0-9_]/;\n211: const MODE_SUFFIX = /^(?::(?:auto|confirm|autopilot|unattended|with-(?:context|phases|research)))+(?![a-z0-9_:-])/;\n212: \n213: // A command that was renamed is still typed from habit. Its old name reads as\n214: // the command that replaced it, so the reader lands on the live workflow and\n215: // not on whatever skill the leftover words happen to score for. The old name\n216: // gets no command file of its own: this table is the only place it lives.\n217: const RETIRED_COMMANDS: Readonly<Record<string, string>> = {\n218:   '/create:skill': '/create:sk-skill',\n219: };\n220: \n221: export function typedCommandIn(prompt: string): string | undefined {\n222:   const lowered = prompt.toLowerCase();\n223:   let found: string | undefined;\n224:   for (const key of [...Object.keys(TRACKED_COMMANDS), ...Object.keys(RETIRED_COMMANDS)]) {\n225:     let index = lowered.indexOf(key);\n226:     while (index !== -1) {\n227:       const before = index === 0 ? '' : lowered[index - 1];\n228:       const after = lowered[index + key.length] ?? '';\n229:       const next = lowered[index + key.length + 1] ?? '';\n230:       const startsAtBoundary = before === '' || COMMAND_START_BOUNDARY.test(before);\n231:       const hasModeSuffix = MODE_SUFFIX.test(lowered.slice(index + key.length));\n232:       const continuesName =\n233:         !hasModeSuffix\n234:         && (COMMAND_CONTINUATION.test(after) || ((after === '/' || after === '.') && WORD_CHARACTER.test(next)));\n235:       const endsAtBoundary = after === '' || !continuesName;\n236:       if (startsAtBoundary && endsAtBoundary) {\n237:         if (found === undefined || key.length > found.length) found = key;\n238:         break;\n239:       }\n240:       index = lowered.indexOf(key, index + 1);\n241:     }\n242:   }\n243:   if (found !== undefined && Object.hasOwn(RETIRED_COMMANDS, found)) return RETIRED_COMMANDS[found];\n244:   return found;\n245: }\n246: \n247: // A typed command travels on the recommendation that leads, so it is delivered\n248: // only when the leading skill owns the command or carries the same command row.\n249: // A leading skill unrelated to the command must not carry it.\n250: export interface TypedCommand {\n251:   readonly command: string;\n252:   readonly policy: 'run' | 'start' | 'ask';\n253:   readonly ownerSkillId: string;\n254: }\n255: \n256: export function typedCommandForTop(topSkillId: string, prompt: string): TypedCommand | undefined {\n257:   const command = typedCommandIn(prompt);\n258:   if (command === undefined || !Object.hasOwn(TRACKED_COMMANDS, command)) return undefined;\n259:   if (commandOnlyMentioned(prompt, command)) return undefined;\n260:   const row = TRACKED_COMMANDS[command];\n261:   const sameCommandRow = commandRowFor(topSkillId)?.command === command;\n262:   if (topSkillId !== row.ownerSkillId && !sameCommandRow) return undefined;\n263:   return { command, policy: row.policy, ownerSkillId: row.ownerSkillId };\n264: }\n265: \n266: // Deep-loop commands open a long, multi-pass run, so one attached to a prompt\n267: // that merely mentions the topic spends the reader's budget on work they never\n268: // asked for. The list below is the vocabulary that counts as asking for it, and\n269: // it holds only effort wording: a bare topic word such as `research`, `review`\n270: // or `council` says what to look at, never how far to go, so it never qualifies\n271: // on its own.\n272: //\n273: // The phrases live in a data list, one per line, so the vocabulary a reviewer\n274: // has to judge stays visible and cheap to correct.\n275: export const DEPTH_WORDING: readonly string[] = [\n276:   'in depth',\n277:   'deep dive',\n278:   'deep research',\n279:   'deep review',\n280:   'thorough',\n281:   'thoroughly',\n282:   'exhaustive',\n283:   'iteratively',\n284:   'multiple passes',\n285:   'many passes',\n286:   'several passes',\n287:   'ask the council',\n288:   'convene',\n289:   'several models',\n290:   'final verdict',\n291:   'everything you can',\n292: ];\n293: \n294: // A creation workflow scaffolds, reviews and validates a whole document, which is\n295: // the wrong size for a correction inside one. The list below is the vocabulary\n296: // that marks that correction, and a line number points at one the same way.\n297: export const SMALL_EDIT_WORDING: readonly string[] = [\n298:   'typo',\n299:   'typos',\n300:   'spelling',\n301:   'misspelled',\n302:   'misspelling',\n303:   'grammar',\n304:   'punctuation',\n305:   'wording',\n306:   'broken link',\n307:   'broken links',\n308:   'dead link',\n309:   'dead links',\n310:   'one line',\n311:   'single line',\n312: ];\n313: \n314: // A phrase may carry punctuation a regex would read as a metacharacter, so it is\n315: // escaped before it is trusted as a pattern.\n316: function escapePhrase(phrase: string): string {\n317:   return phrase.replace(/[.*+?^${}()|[\\]\\\\]/g, '\\\\$&');\n318: }\n319: \n320: // One alternation over the list keeps the gate a single test per prompt, and the\n321: // boundary markers keep `thorough` from firing inside a longer word while a\n322: // multi-word phrase still has to match as a whole.\n323: const DEPTH_REQUEST = new RegExp(`\\\\b(?:${DEPTH_WORDING.map(escapePhrase).join('|')})\\\\b`);\n324: \n325: // The line alternative is a pattern rather than a phrase, so it is appended raw\n326: // beside the escaped vocabulary instead of being escaped with it.\n327: const SMALL_EDIT_REQUEST = new RegExp(\n328:   `\\\\b(?:${SMALL_EDIT_WORDING.map(escapePhrase).join('|')}|line \\\\d+)\\\\b`,\n329: );\n330: \n331: // A request that asks for a document to be created or written wants the whole\n332: // document, even when it names a correction to make afterwards, so this check\n333: // stands the small-edit gate down.\n334: const CREATION_REQUEST = /\\b(?:creat(?:e|es|ing)|writ(?:e|es|ing)|author(?:ing)?|draft(?:ing)?|scaffold(?:ing)?|generat(?:e|es|ing)|mak(?:e|es|ing)|new|build(?:ing)?|set up|add an?|need an?)\\b/;\n335: \n336: // A small edit names the correction to make, so the verb is what marks one.\n337: const CORRECTION_VERB = /\\b(?:fix|correct|update|edit|change|tweak|repair)\\b/;\n338: \n339: // These three creation commands write a whole document that is later corrected in\n340: // place, so a correction request names an edit to it rather than a new one. Every\n341: // other creation command names a purpose that a correction word belongs to.\n342: const SMALL_EDIT_GATED_COMMANDS: ReadonlySet<string> = new Set(['/create:readme', '/create:feature-catalog', '/create:manual-testing-playbook']);\n343: \n344: // Wording that asks for an answer and rules out a change. One pattern serves\n345: // every gate that has to honour it, so a new gate cannot drift from the first.\n346: // Words alone cannot tell \"make no changes to the files\" from a change request\n347: // that says what to leave alone, so both read as no change: losing an offer\n348: // costs less than offering a mutating command on a prompt that ruled one out.\n349: // A negated write verb counts only with an object that names nothing in\n350: // particular, because \"don't add tools\" limits a change and does not refuse it.\n351: export const NO_EDIT_REQUEST = /\\b(no edits?|make no changes|no changes yet|without making changes|(?:do not|don't|dont) (?:make (?:any )?changes|change|edit|modify|touch|(?:create|write|add|delete|remove) (?:it|this|that|anything|any files?))|read-only only|no edits yet|only; do not|just show|just list)\\b/;\n352: \n353: // Many keyboards type the contraction with a curly apostrophe, so the text is\n354: // folded to the straight form before the pattern reads it.\n355: export function isNoEditRequest(text: string): boolean {\n356:   return NO_EDIT_REQUEST.test(text.toLowerCase().replace(/[\\u2018\\u2019]/g, \"'\"));\n357: }\n358: \n359: // A refusal or a question reaches its command through a use verb, so the two\n360: // lists below share this one. A gap holds one or two plain words and no\n361: // punctuation, because a comma ends the clause that holds the lead.\n362: export const COMMAND_USE_VERB = '(?:run|start|use|invoke|launch|execute|call|trigger|open|rerun|re-run|kick off)';\n363: export const COMMAND_GAP_WORDS = \"(?:[a-z']+ ){0,2}\";\n364: \n365: // `why not` proposes the command rather than refusing it, so the word refuses\n366: // only where no `why` stands before it.\n367: const COMMAND_NOT_WORD = '(?<!\\\\bwhy )not';\n368: \n369: // A command the reader refuses is named without being asked for, so this list\n370: // holds the leads that mark that naming. A lead must sit directly before the\n371: // command so a later clause cannot refuse an earlier request, and a gap holds\n372: // plain words only so a refusal before a comma cannot swallow the request after\n373: // it. A reader who stops using a command names it only to refuse it.\n374: export const COMMAND_DECLINE_LEADS: readonly string[] = [\n375:   `(?:do not|don't|dont|never|${COMMAND_NOT_WORD}|won't|wont|no longer|cannot|can't|no need to|need not|needn't) (?!(?:forget|hesitate|fail|mind)\\\\b)${COMMAND_GAP_WORDS}${COMMAND_USE_VERB} ${COMMAND_GAP_WORDS}`,\n376:   `(?:skip|skipping|without|instead of|rather than|avoid|stop|stopped|quit|${COMMAND_NOT_WORD}) (?:(?!${COMMAND_USE_VERB}\\\\b)[a-z']+ ){0,2}`,\n377: ];\n378: \n379: // A refusal or a question over an or-list covers every command the list joins,\n380: // while a second use verb opens a clause of its own, so the list joins only `or`\n381: // and `, or`. A listed command may carry `the` before it and\n382: // `command` after it, and the command after the last `or` may carry `the`. A\n383: // listed command may also carry one plain word after it, such as the subcommand a\n384: // doctor command takes, so `do not run /x now or /y` refuses both.\n385: const COMMAND_OR_LIST = '(?:(?:the )?\\\\/[a-z][a-z0-9_-]*(?::[a-z][a-z0-9_-]*)?(?: [a-z][a-z0-9_-]*)?(?: command)?,? or (?:the )?)*';\n386: \n387: // A command the reader asks about is named without being asked for, so this list\n388: // holds the leads that mark that naming. A lead must sit directly before the\n389: // command so a later clause cannot turn an earlier request into a question, and\n390: // a gap holds plain words only so a question before a comma cannot swallow the\n391: // request after it.\n392: export const COMMAND_ASK_LEADS: readonly string[] = [\n393:   \"(?:what does|what is|what's|what would|what will|what did|how does|how did|why does|why did|explain|describe|tell me what|tell me how|tell me about|tell me why|difference between|differ from|differs from|different from|undo what|ran|already ran|was running) (?:the )?(?:command )?\",\n394:   `(?:should i|should we|do i need to|when would i) ${COMMAND_USE_VERB} (?:the )?(?:command )?`,\n395: ];\n396: \n397: // A bare ask word opens a statement as often as a question, so it marks a naming\n398: // only when the command it precedes is followed by a question mark before the\n399: // sentence ends, or when the lead itself opens a sentence, which a question mark ends as a full stop does.\n400: // A question often names the command after `the`, as in `is the /x command safe`.\n401: export const COMMAND_BARE_ASK_LEAD = '(?:is|does|can|will|would) (?:the )?';\n402: \n403: // A clause that opens with a use verb and `it` asks for the command an earlier\n404: // clause only named, so a naming such as `not run /x yet, please start it`\n405: // becomes a request. The clause has to open that way so `I will run it` stays a\n406: // statement.\n407: const COMMAND_ASKED_BY_PRONOUN = new RegExp(`(?:^|[,.;!?\\\\n]) *(?:(?:and|then|so|please|now|just|go ahead and) )*${COMMAND_USE_VERB} it\\\\b`);\n408: \n409: // A refusal can come after the name, as in \"/create:readme is not what I want, do\n410: // not run it\" or \"run /doctor:git setup but do not actually run it\". The clause\n411: // opens a new sentence or follows \"but\", \"and\" or \"so\", and refuses \"it\" with a\n412: // use verb, so \"run /speckit:save and don't skip it\" stays a request.\n413: const COMMAND_DECLINED_BY_PRONOUN = new RegExp(`(?:^|[,.;!?\\\\n]|\\\\b(?:but|and|so|though)\\\\b) *(?:(?:please|just|then|still) )*(?:do not|don't|dont|never)(?: (?:actually|really|yet|ever|even))? ${COMMAND_USE_VERB} it\\\\b`);\n414: \n415: // A command named as a document is read about, not run: \"read the /create:readme\n416: // document\", \"open the /deep:review command file\". The name needs a determiner\n417: // before it, because a typed request puts its argument there instead, as in\n418: // \"/create:diff file a.md b.md\".\n419: const COMMAND_AS_DOCUMENT = /^(?: command)?(?:'s)? (?:doc|docs|document|documentation|file|page|source|definition|markdown)\\b/;\n420: \n421: // A prompt names a command to refuse it or to ask about it as often as it names\n422: // one to run it, so an offer must read the naming before it trusts the name. The\n423: // text is folded first, because a keyed apostrophe or a run of spaces must not\n424: // hide the lead, while a line break survives as the sentence end it is. Inline\n425: // code, bold, strike, brackets, parentheses, guillemets, primes and quote marks\n426: // around a name are dropped for the same reason, so a refusal of a wrapped\n427: // command reads as the plain refusal does. An underscore\n428: // stays, because a command name may hold one. A single quote goes only where it\n429: // opens or closes a command name, because the same mark is the apostrophe of a\n430: // lead such as \"don't\" or \"what's\". A retired name is read beside the current\n431: // one, because a reader who refuses the old spelling refuses the command it now\n432: // maps to. The\n433: // boundary before the lead keeps a command name from matching inside a word or a\n434: // path, and the boundary after it keeps a longer command name from reading as the\n435: // shorter one or a doc path such as `/create:readme.md` from reading as a naming. Every occurrence has to carry a lead, because one led naming does\n436: // not turn a later unled naming into a request.\n437: export function commandOnlyMentioned(prompt: string, command: string): boolean {\n438:   const text = prompt\n439:     .toLowerCase()\n440:     .replace(/<\\/?(?:code|kbd|samp|tt)>/g, '')\n441:     .replace(/[`*\"\\u201c\\u201d[\\]()~\\u00ab\\u00bb\\u2032\\u2039\\u203a]/g, '')\n442:     .replace(/[\\u2018\\u2019]/g, \"'\")\n443:     .replace(/(^|[^a-z0-9])'(?=\\/[a-z])/g, '$1')\n444:     .replace(/(\\/[a-z][a-z0-9_-]*(?::[a-z][a-z0-9_-]*)*(?: [a-z][a-z0-9_-]*)?)'(?![a-z0-9])/g, '$1')\n445:     .replace(/[^\\S\\n]+/g, ' ')\n446:     .replace(/ *\\n\\s*/g, '\\n');\n447:   const current = command.toLowerCase();\n448:   const spellings = [current, ...Object.keys(RETIRED_COMMANDS).filter((retired) => RETIRED_COMMANDS[retired] === current)]\n449:     .sort((left, right) => right.length - left.length);\n450:   const name = `(?:${spellings.map(escapePhrase).join('|')})`;\n451:   const occurrences = [...text.matchAll(new RegExp(`(?:^|[^a-z0-9_/])${name}(?![a-z0-9_-]|[./][a-z0-9])`, 'g'))];\n452:   if (occurrences.length === 0) return false;\n453:   return occurrences.every((occurrence) => {\n454:     const nameEnd = (occurrence.index ?? 0) + occurrence[0].length;\n455:     const before = text.slice(0, nameEnd);\n456:     const tail = text.slice(nameEnd);\n457:     const clause = tail.split(/(?:^|[\\s,;(])\\/[a-z][a-z0-9_-]*(?::[a-z][a-z0-9_-]*)?(?![a-z0-9_\\/-]|\\.[a-z0-9])/)[0];\n458:     if (COMMAND_AS_DOCUMENT.test(tail) && new RegExp(`\\\\b(?:the|this|that) ${name}$`).test(before)) return true;\n459:     if (COMMAND_DECLINED_BY_PRONOUN.test(clause)) return true;\n460:     if (COMMAND_ASKED_BY_PRONOUN.test(clause)) return false;\n461:     const led = COMMAND_DECLINE_LEADS.some((lead) => (\n462:       new RegExp(`(?:^|[^a-z0-9_/])${lead}${COMMAND_OR_LIST}${name}$`).test(before)\n463:     )) || COMMAND_ASK_LEADS.some((lead) => (\n464:       new RegExp(`(?:^|[^a-z0-9_/])${lead}${COMMAND_OR_LIST}${name}$`).test(before)\n465:     ));\n466:     if (led) return true;\n467:     const bareLead = new RegExp(`(?:^|[^a-z0-9_/])${COMMAND_BARE_ASK_LEAD}${COMMAND_OR_LIST}${name}$`).test(before);\n468:     if (!bareLead) return false;\n469:     const sentenceEnd = tail.search(/[.!\\n]/);\n470:     const sentence = sentenceEnd === -1 ? tail : tail.slice(0, sentenceEnd);\n471:     // A chat question often leaves the question mark off, so a bare ask word that\n472:     // opens a sentence still asks about the command.\n473:     return sentence.includes('?')\n474:       || new RegExp(`(?:^|[.!?\\\\n] *)${COMMAND_BARE_ASK_LEAD}${COMMAND_OR_LIST}${name}$`).test(before);\n475:   });\n476: }\n477: \n478: // A compiled route arrives as unvalidated JSON from a separate process, so the\n479: // shape is narrowed here rather than trusted. Arrays count as objects in\n480: // JavaScript and would let `action` read off an unrelated field, so they are\n481: // excluded explicitly.\n482: function asRecord(value: unknown): Record<string, unknown> | undefined {\n483:   if (typeof value !== 'object' || value === null || Array.isArray(value)) return undefined;\n484:   return value as Record<string, unknown>;\n485: }\n486: \n487: // The command for a hub's recommendation, or undefined when the route does not\n488: // single out one mode. Only a single-mode route names a command unambiguously:\n489: // a bundle or a multi-target route has more than one answer, and asking the\n490: // reader to pick belongs to the recommend path, not here. Never throws, because\n491: // a missing command must degrade to \"no command offered\" rather than break\n492: // routing. The prompt decides whether a costly deep-loop command is offered at\n493: // all: a reader who only asks about the topic gets no command, rather than one\n494: // that would launch work they never requested.\n495: export function attachCommand(\n496:   skillId: string,\n497:   compiledRoute: unknown,\n498:   prompt: string,\n499:   modeCommands: Readonly<Record<string, Readonly<Record<string, string>>>> = MODE_COMMANDS,\n500: ): string | undefined {\n501:   const route = asRecord(compiledRoute);\n502:   if (!route) return undefined;\n503:   if (route.action !== 'route' || route.selectionKind !== 'single') return undefined;\n504: \n505:   const targets = route.targets;\n506:   if (!Array.isArray(targets) || targets.length !== 1) return undefined;\n507: \n508:   const onlyTarget = asRecord(targets[0]);\n509:   if (!onlyTarget) return undefined;\n510: \n511:   const workflowMode = onlyTarget.workflowMode;\n512:   if (typeof workflowMode !== 'string' || workflowMode === '') return undefined;\n513: \n514:   // A reader who rules out a change gets no command from either path, so the hub\n515:   // route never offers what the scorer already withholds.\n516:   if (isNoEditRequest(prompt)) return undefined;\n517: \n518:   // Own-key lookup on both levels: the table is data read from a generated\n519:   // object, so an inherited name such as `constructor` must not resolve to a\n520:   // command the hub never declared.\n521:   if (!Object.prototype.hasOwnProperty.call(modeCommands, skillId)) return undefined;\n522:   const commands = modeCommands[skillId];\n523:   if (!Object.prototype.hasOwnProperty.call(commands, workflowMode)) return undefined;\n524: \n525:   // A route can pick the mode because the prompt named its command, so a naming\n526:   // that refused or asked about the command must not produce the offer.\n527:   if (commandOnlyMentioned(prompt, commands[workflowMode])) return undefined;\n528: \n529:   // A correction inside one document is not a request for a creation workflow,\n530:   // which scaffolds, reviews and validates a whole one.\n531:   if (\n532:     SMALL_EDIT_GATED_COMMANDS.has(commands[workflowMode])\n533:     && SMALL_EDIT_REQUEST.test(prompt.toLowerCase())\n534:     && !CREATION_REQUEST.test(prompt.toLowerCase())\n535:     && CORRECTION_VERB.test(prompt.toLowerCase())\n536:   ) return undefined;\n537: \n538:   // Deep-loop commands are the ones that commit the reader to a long, multi-pass\n539:   // run, so they are offered only when the prompt asks for that effort. Typing\n540:   // the command being attached is itself the ask, while typing another deep-loop\n541:   // command asks for that command, not this one. Every other hub answers a short\n542:   // question with a short answer, so no other skill consults the wording list.\n543:   if (skillId === 'system-deep-loop') {\n544:     const typesThisCommand = typedCommandIn(prompt) === commands[workflowMode];\n545:     if (!typesThisCommand && !DEPTH_REQUEST.test(prompt.toLowerCase())) return undefined;\n546:   }\n547: \n548:   return commands[workflowMode];\n549: }\n550: \n551: // A hub that withholds its command because the prompt names no single mode must\n552: // still tell the reader why no command came with it, and only a hub whose modes\n553: // map to commands withholds one. A hub that tops a prompt which never named it\n554: // is the scorer's guess, so the label would point at modes the reader did not\n555: // ask about.\n556: export function routeNeedsMode(\n557:   skillId: string,\n558:   compiledRoute: unknown,\n559:   namedSkills: readonly string[],\n560: ): boolean {\n561:   if (!namedSkills.includes(skillId)) return false;\n562:   const route = asRecord(compiledRoute);\n563:   if (!route) return false;\n564:   if (route.action !== 'defer' && route.action !== 'clarify') return false;\n565:   return Object.prototype.hasOwnProperty.call(MODE_COMMANDS, skillId);\n566: }"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\".skilled/skills/system-skill-advisor/runtime/lib/command-attach.ts\"}"},"time":{"start":1794865395794,"end":1794865396249}}}}
{"type":"step_finish","timestamp":1794865397251,"sessionID":"ses_e19b0e5bfffeS7sVTvhEMa7jvO","part":{"id":"prt_1e6507e03001jIG3IaT4YKiO5e","sessionID":"ses_e19b0e5bfffeS7sVTvhEMa7jvO","messageID":"msg_1e65064aa001YngVqK5U2sDIzT","type":"step-finish","reason":"tool-calls","snapshot":"ce4f71481bc72fd48eb325cba5416831780ba9e1","cost":0,"tokens":{"input":348,"output":56,"reasoning":24,"cache":{"read":90368,"write":0}}}}
{"type":"step_start","timestamp":1794865402665,"sessionID":"ses_e19b0e5bfffeS7sVTvhEMa7jvO","part":{"id":"prt_1e65093290017RT6N8YiJ0GRwL","sessionID":"ses_e19b0e5bfffeS7sVTvhEMa7jvO","messageID":"msg_1e6507e08001doGb5sKln4kh6z","type":"step-start","snapshot":"ce4f71481bc72fd48eb325cba5416831780ba9e1"}}
{"type":"tool_use","timestamp":1794865456233,"sessionID":"ses_e19b0e5bfffeS7sVTvhEMa7jvO","part":{"partID":"prt_1e651630e001XKZKmERMtVWD5D","sessionID":"ses_e19b0e5bfffeS7sVTvhEMa7jvO","messageID":"msg_1e6507e08001doGb5sKln4kh6z","type":"tool","id":"call_2e42827ef60c4742a9d7408b","tool":"read","state":{"status":"completed","input":{"path":".skilled/skills/system-skill-advisor/runtime/tests/command-attach-guards.vitest.ts"},"output":"Read file .skilled/skills/system-skill-advisor/runtime/tests/command-attach-guards.vitest.ts, lines 1-615\n1: // ───────────────────────────────────────────────────────────────\n2: // MODULE: Command attach guards\n3: // ───────────────────────────────────────────────────────────────\n4: \n5: // A hub route names the command that acts on the mode it picked, so it has to\n6: // honour the same no-edit wording the scorer honours. A reader who rules out a\n7: // change must not be handed a command that changes files.\n8: \n9: import { readFileSync } from 'node:fs';\n10: import { join } from 'node:path';\n11: \n12: import { describe, expect, it } from 'vitest';\n13: \n14: import {\n15:   attachCommand,\n16:   commandOnlyMentioned,\n17:   isNoEditRequest,\n18:   MODE_COMMANDS,\n19:   NO_EDIT_REQUEST,\n20:   typedCommandForTop,\n21:   typedCommandIn,\n22: } from '../lib/command-attach.js';\n23: \n24: // The only route shape that names a command unambiguously: one decision and one\n25: // selected target.\n26: function SINGLE(workflowMode: string): Record<string, unknown> {\n27:   return { action: 'route', selectionKind: 'single', targets: [{ workflowMode }] };\n28: }\n29: \n30: // The endings a reader uses to rule out a change. One writes the contraction\n31: // with a curly apostrophe, which is the form many keyboards produce.\n32: const NOEDIT4 = [\n33:   \"don't change anything yet\",\n34:   'no changes yet',\n35:   'don\\u2019t touch any files',\n36:   'make no changes',\n37: ];\n38: \n39: // The prompts that name a command to refuse it or ask about it, the prompts that\n40: // ask for the command, and the prompts that hold a refusal or question word and\n41: // still ask for the command.\n42: const REFUSE8: ReadonlyArray<readonly [string, string]> = [\n43:   ['do not run /speckit:complete yet, just explain what it does', '/speckit:complete'],\n44:   ['I never want to use /create:agent again, delete the agent file', '/create:agent'],\n45:   ['someone ran /speckit:save by accident, how do I undo what it wrote', '/speckit:save'],\n46:   ['please do not start /deep:research, I only want a two line summary of the readme', '/deep:research'],\n47:   ['what does /create:readme do?', '/create:readme'],\n48:   ['do not run it, just tell me what /doctor:update would change', '/doctor:update'],\n49:   ['explain /deep:review to me', '/deep:review'],\n50:   ['skip /create:readme, just append one line to the existing README', '/create:readme'],\n51: ];\n52: \n53: const QUESTION2: ReadonlyArray<readonly [string, string]> = [\n54:   ['is /speckit:complete overkill for a two line fix?', '/speckit:complete'],\n55:   ['should I use /deep:research for this or just read the two files myself?', '/deep:research'],\n56: ];\n57: \n58: const REQUEST6: ReadonlyArray<readonly [string, string]> = [\n59:   ['run /speckit:complete for the rate limiter', '/speckit:complete'],\n60:   ['/create:agent security-reviewer', '/create:agent'],\n61:   [\"don't forget to run /speckit:save\", '/speckit:save'],\n62:   ['explain the diff then run /speckit:save', '/speckit:save'],\n63:   ['use /speckit:plan, not /speckit:complete', '/speckit:plan'],\n64:   ['I ran /speckit:plan yesterday, now run /speckit:implement', '/speckit:implement'],\n65: ];\n66: \n67: const CONTROL5: ReadonlyArray<readonly [string, string]> = [\n68:   ['dont guess, run /speckit:plan', '/speckit:plan'],\n69:   ['never mind just run /speckit:save', '/speckit:save'],\n70:   ['not sure, use /create:readme', '/create:readme'],\n71:   ['without asking, run /speckit:complete', '/speckit:complete'],\n72:   ['can you run /speckit:plan?', '/speckit:plan'],\n73: ];\n74: \n75: describe('command attach on a no-edit prompt', () => {\n76:   it('offers no hub command when the prompt rules out a change', () => {\n77:     const prompt = 'use sk-doc to create a skill called invoice-parser, do not change anything yet';\n78:     expect(attachCommand('sk-doc', SINGLE('sk-create-skill'), prompt)).toBeUndefined();\n79:   });\n80: \n81:   it('offers the command when the same prompt asks for the change', () => {\n82:     const prompt = 'use sk-doc to create a skill called invoice-parser';\n83:     expect(attachCommand('sk-doc', SINGLE('sk-create-skill'), prompt)).toBe('/create:sk-skill');\n84:   });\n85: \n86:   it('reads the shared no-edit wording', () => {\n87:     expect(NO_EDIT_REQUEST.test('just show me the plan')).toBe(true);\n88:   });\n89: \n90:   it.each(NOEDIT4)('offers no hub command when the prompt ends %s', (ending) => {\n91:     const prompt = 'use sk-doc to create an agent called invoice-parser, ' + ending;\n92:     expect(attachCommand('sk-doc', SINGLE('sk-create-agent'), prompt)).toBeUndefined();\n93:   });\n94: \n95:   it('offers the agent command when the prompt asks for the change', () => {\n96:     const prompt = 'use sk-doc to create an agent called invoice-parser';\n97:     expect(attachCommand('sk-doc', SINGLE('sk-create-agent'), prompt)).toBe('/create:agent');\n98:   });\n99: \n100:   it('reads a curly apostrophe as a straight one', () => {\n101:     expect(isNoEditRequest('Don\\u2019t touch any files')).toBe(true);\n102:     expect(isNoEditRequest('touch the files')).toBe(false);\n103:   });\n104: \n105:   // A change request can say what must stay the same, and that is still a\n106:   // request for the change.\n107:   it.each([\n108:     'refactor the parser so there are no changes to its public api',\n109:     'fix the flaky test and make sure there are no changes in behaviour',\n110:     'create an agent called invoice-parser with no changes to existing agents',\n111:     \"create an agent called invoice-parser, don't add tools\",\n112:     \"refactor the parser, don't delete the old tests\",\n113:   ])('keeps a change request that limits its scope: %s', (prompt) => {\n114:     expect(isNoEditRequest(prompt)).toBe(false);\n115:   });\n116: \n117:   // The phrase reads as no change whatever follows it. The first row is a real\n118:   // no-edit request. The second is a change request that pays for the safe\n119:   // reading by losing its command.\n120:   it.each([\n121:     \"show me the plan, don't make any changes\",\n122:     'walk me through the fix, do not make changes',\n123:     'list the stale docs, dont change anything',\n124:     'use sk-doc to create an agent called invoice-parser, dont create it yet',\n125:     \"outline the readme, don't write anything\",\n126:   ])('reads a refusal to make changes as ruling out a change: %s', (prompt) => {\n127:     expect(isNoEditRequest(prompt)).toBe(true);\n128:   });\n129: \n130:   it.each([\n131:     'show me the plan and make no changes to the files',\n132:     'refactor the parser and make no changes to its public api',\n133:   ])('reads make no changes as ruling out a change: %s', (prompt) => {\n134:     expect(isNoEditRequest(prompt)).toBe(true);\n135:   });\n136: });\n137: \n138: describe('a command the prompt only mentions', () => {\n139:   it.each(REFUSE8)('reads %s as a mention of %s', (prompt, command) => {\n140:     expect(commandOnlyMentioned(prompt, command)).toBe(true);\n141:   });\n142: \n143:   it.each(QUESTION2)('reads the question %s as a mention of %s', (prompt, command) => {\n144:     expect(commandOnlyMentioned(prompt, command)).toBe(true);\n145:   });\n146: \n147:   it.each(REQUEST6)('reads %s as a request for %s', (prompt, command) => {\n148:     expect(commandOnlyMentioned(prompt, command)).toBe(false);\n149:   });\n150: \n151:   it.each(CONTROL5)('reads %s as a request for %s beside a refusal word', (prompt, command) => {\n152:     expect(commandOnlyMentioned(prompt, command)).toBe(false);\n153:   });\n154: \n155:   it.each([\n156:     ['do not run /create:agent or /create:readme', '/create:readme'],\n157:     ['never use /create:readme or /create:feature-catalog', '/create:feature-catalog'],\n158:     ['do not run /deep:review, or /deep:research', '/deep:research'],\n159:     ['skip /create:agent or /create:readme', '/create:readme'],\n160:     ['do not run /speckit:plan or /speckit:implement or /speckit:complete', '/speckit:complete'],\n161:     ['do not run /create:agent or the /create:readme command', '/create:readme'],\n162:     ['do not run /create:agent, or the /create:readme command', '/create:readme'],\n163:     ['skip /create:agent or the /create:readme command', '/create:readme'],\n164:     ['never use the /create:readme command or the /create:feature-catalog command', '/create:feature-catalog'],\n165:     ['do not run /doctor:ci report or /create:readme', '/create:readme'],\n166:     ['do not run /doctor:ci report or /doctor:ci scaffold', '/doctor:ci scaffold'],\n167:     ['never use /doctor:git hooks or /doctor:skill-advisor tune', '/doctor:skill-advisor tune'],\n168:   ])('reads %s as a refusal of %s through an or-list', (prompt, command) => {\n169:     expect(commandOnlyMentioned(prompt, command)).toBe(true);\n170:   });\n171: \n172:   // Chat wraps a command name in code, quote or bold marks, and a renamed command\n173:   // is still typed under its old name. Neither may change what the naming reads\n174:   // as, so every fixture must read the same wrapped or retired as it does plain.\n175:   const WRAPPERS: ReadonlyArray<readonly [string, string]> = [\n176:     ['`', '`'], [\"'\", \"'\"], ['\"', '\"'], ['\\u201c', '\\u201d'], ['\\u2018', '\\u2019'], ['**', '**'],\n177:     ['[', ']'], ['(', ')'], ['~~', '~~'], ['<code>', '</code>'], ['\\u00ab', '\\u00bb'], ['\\u2032', '\\u2032'],\n178:   ];\n179:   const PLAIN_ROWS = [...REFUSE8, ...QUESTION2, ...REQUEST6, ...CONTROL5,\n180:     ['do not run /create:agent or /create:readme', '/create:readme'],\n181:     ['skip /create:agent or the /create:readme command', '/create:readme'],\n182:   ] as const;\n183: \n184:   it.each(WRAPPERS)('reads every fixture wrapped in %s the same as plain', (open, close) => {\n185:     for (const [prompt, command] of PLAIN_ROWS) {\n186:       const wrapped = prompt.replace(/\\/[a-z][a-z-]*:[a-z][a-z-]*/g, (name) => `${open}${name}${close}`);\n187:       expect(commandOnlyMentioned(wrapped, command), wrapped).toBe(commandOnlyMentioned(prompt, command));\n188:     }\n189:   });\n190: \n191:   it('reads every fixture under the retired name the same as under the current one', () => {\n192:     for (const [prompt, command] of PLAIN_ROWS) {\n193:       const plain = prompt.split(command).join('/create:sk-skill');\n194:       const retired = prompt.split(command).join('/create:skill');\n195:       expect(commandOnlyMentioned(retired, '/create:sk-skill'), retired)\n196:         .toBe(commandOnlyMentioned(plain, '/create:sk-skill'));\n197:     }\n198:   });\n199: \n200:   // A refusal can follow the name it refuses, so the words after a naming are\n201:   // read for a refusal of \"it\" as well as for a request.\n202:   it.each([\n203:     ['/create:readme is not what I want, do not run it', '/create:readme'],\n204:     ['run /doctor:git setup but do not actually run it', '/doctor:git setup'],\n205:     [\"/speckit:complete came up, but please don't start it\", '/speckit:complete'],\n206:   ])('reads the later refusal in %s as a mention of %s', (prompt, command) => {\n207:     expect(commandOnlyMentioned(prompt, command)).toBe(true);\n208:   });\n209: \n210:   it('still reads a later request of the same command as a request', () => {\n211:     expect(commandOnlyMentioned(\"run /speckit:save and don't skip it\", '/speckit:save')).toBe(false);\n212:   });\n213: \n214:   // A command named as a document is being read about, not run.\n215:   it.each([\n216:     ['read the /create:readme document and tell me what it does', '/create:readme'],\n217:     ['open the /deep:review command file and summarize it', '/deep:review'],\n218:   ])('reads %s as a mention of %s', (prompt, command) => {\n219:     expect(commandOnlyMentioned(prompt, command)).toBe(true);\n220:   });\n221: \n222:   it('still reads a typed command whose argument is a file as a request', () => {\n223:     expect(commandOnlyMentioned('/create:diff file a.md b.md', '/create:diff')).toBe(false);\n224:   });\n225: \n226:   // A doc path that holds the name is a file, not a naming, so it cannot undo the\n227:   // refusal of the command itself.\n228:   it('reads a led refusal beside a doc path of the same command as a mention', () => {\n229:     expect(commandOnlyMentioned('do not run /create:readme, read /create:readme.md', '/create:readme')).toBe(true);\n230:   });\n231: \n232:   // Markup around the name must not hide the lead before it.\n233:   it.each([\n234:     ['do not run `/create:readme`, just tell me what it covers', '/create:readme'],\n235:     ['what does `/create:readme` do?', '/create:readme'],\n236:     ['never use **/deep:review** here', '/deep:review'],\n237:     ['do not run \"/create:readme\" yet', '/create:readme'],\n238:     [\"do not run '/create:readme' yet\", '/create:readme'],\n239:     [\"what's '/create:readme' for?\", '/create:readme'],\n240:     ['never use ‘/deep:review’ here', '/deep:review'],\n241:     ['do not run “/create:readme” yet', '/create:readme'],\n242:   ])('reads the marked-up %s as a mention of %s', (prompt, command) => {\n243:     expect(commandOnlyMentioned(prompt, command)).toBe(true);\n244:   });\n245: \n246:   it('still reads a marked-up request as a request', () => {\n247:     expect(commandOnlyMentioned('run `/create:readme` for the advisor skill', '/create:readme')).toBe(false);\n248:     expect(commandOnlyMentioned(\"run '/create:readme' for the advisor skill\", '/create:readme')).toBe(false);\n249:     expect(commandOnlyMentioned(\"don't skip '/create:readme', run it\", '/create:readme')).toBe(false);\n250:   });\n251: \n252:   it.each([\n253:     [\"do not run '/create:agent' or '/create:readme'\", '/create:readme'],\n254:     [\"do not run '/doctor:ci report' or '/create:readme'\", '/create:readme'],\n255:   ])('reads the quoted or-list %s as a refusal of %s', (prompt, command) => {\n256:     expect(commandOnlyMentioned(prompt, command)).toBe(true);\n257:   });\n258: \n259:   // A retired name maps to the command that replaced it, so refusing the old\n260:   // spelling refuses the new command too.\n261:   it('reads a refusal of a retired name as a refusal of its replacement', () => {\n262:     expect(commandOnlyMentioned('do not run /create:skill', '/create:sk-skill')).toBe(true);\n263:     expect(commandOnlyMentioned('what does /create:skill do?', '/create:sk-skill')).toBe(true);\n264:     expect(commandOnlyMentioned('run /create:skill for my new helper', '/create:sk-skill')).toBe(false);\n265:   });\n266: \n267:   it.each([\n268:     ['use /create:agent or /create:readme', '/create:agent'],\n269:     ['use /create:agent or /create:readme', '/create:readme'],\n270:     ['use /speckit:plan, not /speckit:complete', '/speckit:plan'],\n271:     ['do not run /speckit:complete, run /speckit:plan or /speckit:implement', '/speckit:plan'],\n272:     ['do not run /speckit:complete, run /speckit:plan or /speckit:implement', '/speckit:implement'],\n273:     ['do not run /speckit:complete or run /speckit:plan', '/speckit:plan'],\n274:     ['use /create:agent or the /create:readme command', '/create:readme'],\n275:     ['the next step is /create:agent or /create:readme', '/create:readme'],\n276:     ['use /doctor:ci report or /create:readme', '/create:readme'],\n277:   ])('still reads %s as a request for %s beside an or-list', (prompt, command) => {\n278:     expect(commandOnlyMentioned(prompt, command)).toBe(false);\n279:   });\n280: \n281:   // A bare lead opens a statement as often as a question, so it marks a mention\n282:   // only before a question. One led occurrence does not make a request either\n283:   // when a later occurrence of the same command is not led.\n284:   it.each([\n285:     ['the next step is /speckit:implement', '/speckit:implement'],\n286:     ['the next step is the /speckit:implement command', '/speckit:implement'],\n287:     ['is this right? run /speckit:plan', '/speckit:plan'],\n288:     ['the next step is /speckit:implement\\nany questions?', '/speckit:implement'],\n289:     ['what does /speckit:save do? ok now run /speckit:save', '/speckit:save'],\n290:     ['the plan is /speckit:plan then tests', '/speckit:plan'],\n291:   ])('reads %s as a request for %s', (prompt, command) => {\n292:     expect(commandOnlyMentioned(prompt, command)).toBe(false);\n293:   });\n294: \n295:   // A chat question often leaves the question mark off, so a bare ask word that\n296:   // opens a sentence still marks the command as the subject.\n297:   it.each([\n298:     ['is /speckit:resume safe to run twice', '/speckit:resume'],\n299:     ['does /doctor:git change files or just report problems', '/doctor:git'],\n300:     ['can /prompt:improve make a vague request easier to follow', '/prompt:improve'],\n301:     ['ok. is /speckit:plan enough here', '/speckit:plan'],\n302:     ['quick question? is /speckit:resume safe to run twice', '/speckit:resume'],\n303:     ['Is the /doctor:update command safe?', '/doctor:update'],\n304:   ])('reads %s as a question about %s', (prompt, command) => {\n305:     expect(commandOnlyMentioned(prompt, command)).toBe(true);\n306:   });\n307: \n308:   it.each([\n309:     ['should I run /create:agent or /create:readme?', '/create:readme'],\n310:     ['is /create:agent or /create:readme better?', '/create:readme'],\n311:     ['what does /create:agent or /create:readme do?', '/create:readme'],\n312:   ])('reads %s as a question about %s through an or-list', (prompt, command) => {\n313:     expect(commandOnlyMentioned(prompt, command)).toBe(true);\n314:   });\n315: \n316:   it('reads each command of a two-command prompt on its own', () => {\n317:     expect(commandOnlyMentioned('use /speckit:plan, not /speckit:complete', '/speckit:complete')).toBe(true);\n318:   });\n319: \n320:   it('reads a curly apostrophe as a straight one', () => {\n321:     expect(commandOnlyMentioned('don\\u2019t run /speckit:save', '/speckit:save')).toBe(true);\n322:   });\n323: \n324:   it('reads no need to run as a refusal of the command', () => {\n325:     expect(commandOnlyMentioned('no need to run /doctor:setup, the hooks are fine', '/doctor:setup')).toBe(true);\n326:   });\n327: \n328:   it('still reads a request after no need to ask', () => {\n329:     expect(commandOnlyMentioned('no need to ask, run /speckit:save', '/speckit:save')).toBe(false);\n330:   });\n331: \n332:   it('reads stop using as a refusal of the command', () => {\n333:     expect(commandOnlyMentioned('stop using /create:changelog for this, write the changelog entry by hand', '/create:changelog')).toBe(true);\n334:   });\n335: \n336:   it('still reads a request after stop and', () => {\n337:     expect(commandOnlyMentioned('stop and run /speckit:plan', '/speckit:plan')).toBe(false);\n338:   });\n339: \n340:   it('reads why not use as a request for the command', () => {\n341:     expect(commandOnlyMentioned('why not use /create:agent for this? go ahead and make a security reviewer agent', '/create:agent')).toBe(false);\n342:   });\n343: \n344:   it.each([\n345:     ['I have not run /speckit:plan yet, please start it for the login feature', '/speckit:plan'],\n346:     ['I already ran /create:readme but the output was wrong, run it again for the hooks folder', '/create:readme'],\n347:     ['not run /speckit:plan yet, write notes to /tmp/notes.md, then run it', '/speckit:plan'],\n348:     ['not run /speckit:plan yet, read https://example.com/spec first, then run it', '/speckit:plan'],\n349:   ])('reads %s as a request for %s made by a later clause', (prompt, command) => {\n350:     expect(commandOnlyMentioned(prompt, command)).toBe(false);\n351:   });\n352: \n353:   it.each([\n354:     ['do not run /speckit:complete, I will run it myself later', '/speckit:complete'],\n355:     ['do not use /create:agent, use that other one', '/create:agent'],\n356:     ['do not run /speckit:complete, run /speckit:plan for the rate limiter instead', '/speckit:complete'],\n357:     ['do not run /speckit:complete, run /speckit:plan, then run it for the auth module', '/speckit:complete'],\n358:   ])('still reads %s as a mention of %s', (prompt, command) => {\n359:     expect(commandOnlyMentioned(prompt, command)).toBe(true);\n360:   });\n361: \n362:   it('does not read a longer command name as the shorter one', () => {\n363:     expect(commandOnlyMentioned('do not run /create:sk-skill-parent', '/create:sk-skill')).toBe(false);\n364:   });\n365: \n366:   it.each([\n367:     'what does /create:readme do?',\n368:     'skip /create:readme, just append one line to the existing README',\n369:     'do not run /create:agent or /create:readme',\n370:   ])('offers no hub command for %s', (prompt) => {\n371:     expect(attachCommand('sk-doc', SINGLE('sk-create-readme'), prompt)).toBeUndefined();\n372:   });\n373: \n374:   it('offers no deep-loop command the prompt refuses', () => {\n375:     const deepLoopModes = MODE_COMMANDS['system-deep-loop'];\n376:     const mode = Object.keys(deepLoopModes).find((key) => deepLoopModes[key] === '/deep:research');\n377:     expect(mode, 'the generated table names the research mode').toBeDefined();\n378:     expect(attachCommand('system-deep-loop', SINGLE(mode!), 'please do not start /deep:research, I only want a two line summary of the readme')).toBeUndefined();\n379:   });\n380: \n381:   it('still offers the hub command a plain request routes to', () => {\n382:     expect(attachCommand('sk-doc', SINGLE('sk-create-readme'), 'write a readme for the doctor scripts folder')).toBe('/create:readme');\n383:   });\n384: });\n385: \n386: describe('command attach on a small edit', () => {\n387:   it.each([\n388:     'update the README typo in line 3',\n389:     'fix the typo in the README',\n390:     'correct the spelling in the hooks readme',\n391:     'fix the broken link in the install guide readme',\n392:   ])('offers no creation command for %s', (prompt) => {\n393:     expect(attachCommand('sk-doc', SINGLE('sk-create-readme'), prompt)).toBeUndefined();\n394:   });\n395: \n396:   it.each([\n397:     'write a readme for the doctor scripts folder',\n398:     'create a readme for the payments module, check it for typos when done',\n399:   ])('still offers the creation command for %s', (prompt) => {\n400:     expect(attachCommand('sk-doc', SINGLE('sk-create-readme'), prompt)).toBe('/create:readme');\n401:   });\n402: \n403:   it.each([\n404:     ['sk-doc', 'sk-create-agent', 'build an agent that fixes typos in our docs'],\n405:     ['sk-doc', 'sk-create-readme', 'writing a readme for the grammar module'],\n406:     ['sk-doc', 'sk-create-readme', 'add a readme for the spelling package'],\n407:     ['sk-doc', 'sk-create-changelog', 'add a changelog entry for the typo fixes in the cli help'],\n408:   ])('still offers the creation command on %s %s for %s', (skill, mode, prompt) => {\n409:     expect(attachCommand(skill, SINGLE(mode), prompt)).toBe(MODE_COMMANDS[skill][mode]);\n410:   });\n411: \n412:   it('leaves the wording commands outside the gate', () => {\n413:     const docModes = MODE_COMMANDS['sk-doc'];\n414:     const mode = Object.keys(docModes).find((key) => docModes[key] === '/create:with-human-voice');\n415:     expect(mode, 'the generated table names the human voice mode').toBeDefined();\n416:     expect(attachCommand('sk-doc', SINGLE(mode!), 'humanize the wording in the onboarding guide')).toBe('/create:with-human-voice');\n417:   });\n418: \n419:   it.each([\n420:     ['sk-create-changelog', 'changelog for v2.1, it fixes the broken link checker and spelling errors'],\n421:     ['sk-create-changelog', 'log the spelling fixes in the changelog'],\n422:     ['sk-create-readme', 'document the cli in a readme, each flag gets a one line description'],\n423:     ['sk-create-readme', 'readme for the spelling package'],\n424:     ['sk-create-agent', 'an agent that fixes typos'],\n425:   ])('keeps the creation command for %s on %s', (mode, prompt) => {\n426:     expect(attachCommand('sk-doc', SINGLE(mode), prompt)).toBe(MODE_COMMANDS['sk-doc'][mode]);\n427:   });\n428: \n429:   it('keeps the goal command when the goal is about fixes', () => {\n430:     const docModes = MODE_COMMANDS['sk-doc'];\n431:     const mode = Object.keys(docModes).find((key) => docModes[key] === '/create:goal');\n432:     expect(mode, 'the generated table names the goal mode').toBeDefined();\n433:     expect(attachCommand('sk-doc', SINGLE(mode!), 'set a goal to fix all the typos in the docs')).toBe('/create:goal');\n434:   });\n435: \n436:   it.each([\n437:     'fix the broken links in the install guide readme',\n438:     'fix the dead links in the hooks readme',\n439:   ])('offers no creation command for %s', (prompt) => {\n440:     expect(attachCommand('sk-doc', SINGLE('sk-create-readme'), prompt)).toBeUndefined();\n441:   });\n442: \n443:   it('leaves a command outside the create namespace alone', () => {\n444:     const deepLoopModes = MODE_COMMANDS['system-deep-loop'];\n445:     const mode = Object.keys(deepLoopModes).find((key) => deepLoopModes[key] === '/deep:review');\n446:     expect(mode, 'the generated table names the review mode').toBeDefined();\n447:     expect(attachCommand('system-deep-loop', SINGLE(mode!), 'do a thorough deep review of the typo handling')).toBe('/deep:review');\n448:   });\n449: \n450:   it.each([\n451:     ['sk-create-agent', 'an agent to fix typos'],\n452:     ['sk-create-agent', 'give me an agent to fix broken links in the docs'],\n453:     ['sk-create-agent', 'I want an agent to correct spelling in pull requests'],\n454:   ])('keeps the creation command for %s on %s', (mode, prompt) => {\n455:     expect(attachCommand('sk-doc', SINGLE(mode), prompt)).toBe(MODE_COMMANDS['sk-doc'][mode]);\n456:   });\n457: \n458:   // A skill or a command names its own purpose, so a correction word inside that\n459:   // purpose is the reason the artifact exists and not a request to edit one.\n460:   it.each([\n461:     ['/create:sk-skill', 'a skill to correct spelling in markdown'],\n462:     ['/create:command', \"I'd like a command to fix dead links\"],\n463:   ])('keeps the command %s on %s', (command, prompt) => {\n464:     const docModes = MODE_COMMANDS['sk-doc'];\n465:     const mode = Object.keys(docModes).find((key) => docModes[key] === command);\n466:     expect(mode, 'the generated table names the ' + command + ' mode').toBeDefined();\n467:     expect(attachCommand('sk-doc', SINGLE(mode!), prompt)).toBe(command);\n468:   });\n469: \n470:   // A repo rule or a benchmark also names its purpose the way an agent does, so\n471:   // the correction word belongs to what the artifact is for rather than to an\n472:   // edit of a document that already exists.\n473:   it.each([\n474:     'I want a repo rule that says fix typos in the same commit',\n475:     'repo rule: always fix typos in the same commit',\n476:   ])('keeps the repo-rule command on %s', (prompt) => {\n477:     const docModes = MODE_COMMANDS['sk-doc'];\n478:     const mode = Object.keys(docModes).find((key) => docModes[key] === '/create:repo-rule');\n479:     expect(mode, 'the generated table names the repo rule mode').toBeDefined();\n480:     expect(attachCommand('sk-doc', SINGLE(mode!), prompt)).toBe('/create:repo-rule');\n481:   });\n482: \n483:   it('keeps the benchmark command on benchmark how fast we fix typos', () => {\n484:     const docModes = MODE_COMMANDS['sk-doc'];\n485:     const mode = Object.keys(docModes).find((key) => docModes[key] === '/create:benchmark');\n486:     expect(mode, 'the generated table names the benchmark mode').toBeDefined();\n487:     expect(attachCommand('sk-doc', SINGLE(mode!), 'benchmark how fast we fix typos')).toBe('/create:benchmark');\n488:   });\n489: });\n490: \n491: describe('command attach on a deep-loop prompt', () => {\n492:   it('withholds the review command when another deep-loop command is named', () => {\n493:     expect(attachCommand('system-deep-loop', SINGLE('review'), 'what did /deep:ai-council decide')).toBeUndefined();\n494:   });\n495: \n496:   it('withholds the review command when an unknown deep-loop command is named', () => {\n497:     expect(attachCommand('system-deep-loop', SINGLE('review'), 'what did /deep:reviw decide')).toBeUndefined();\n498:   });\n499: \n500:   it('offers the review command when it is the command typed', () => {\n501:     expect(attachCommand('system-deep-loop', SINGLE('review'), 'run /deep:review now')).toBe('/deep:review');\n502:   });\n503: \n504:   it('offers the review command when the prompt asks for depth', () => {\n505:     expect(attachCommand('system-deep-loop', SINGLE('review'), 'review the parser in depth')).toBe('/deep:review');\n506:   });\n507: });\n508: \n509: describe('typed command boundaries', () => {\n510:   it('does not read a file name with an extension as a typed command', () => {\n511:     expect(typedCommandIn('see /create:sk-skill.md for details')).toBeUndefined();\n512:   });\n513: \n514:   it('does not read a path segment as a typed command', () => {\n515:     expect(typedCommandIn('open /create:readme/notes.txt')).toBeUndefined();\n516:   });\n517: \n518:   it.each([\n519:     ['run **/deep:review** now', '/deep:review'],\n520:     ['run [/deep:review] now', '/deep:review'],\n521:     ['run \\u201c/deep:review\\u201d now', '/deep:review'],\n522:     ['run <code>/deep:review</code> now', '/deep:review'],\n523:   ])('finds the command wrapped in %s', (prompt, command) => {\n524:     expect(typedCommandIn(prompt)).toBe(command);\n525:   });\n526: \n527:   it('reads a command that ends a sentence', () => {\n528:     expect(typedCommandIn('run /create:sk-skill.')).toBe('/create:sk-skill');\n529:   });\n530: \n531:   it('reads a command followed by a comma', () => {\n532:     expect(typedCommandIn('run /create:sk-skill, then stop')).toBe('/create:sk-skill');\n533:   });\n534: \n535:   it('reads the longest command when a prefix also matches', () => {\n536:     expect(typedCommandIn('/create:skill-parent now')).toBe('/create:skill-parent');\n537:   });\n538: \n539:   it('reads a command typed with its mode suffix', () => {\n540:     expect(typedCommandIn('/deep:review:auto review the diff')).toBe('/deep:review');\n541:     expect(typedCommandIn('/speckit:plan:confirm add a login page')).toBe('/speckit:plan');\n542:     expect(typedCommandIn('/speckit:implement:autopilot')).toBe('/speckit:implement');\n543:     expect(typedCommandIn('/speckit:implement:unattended the login spec')).toBe('/speckit:implement');\n544:   });\n545: \n546:   it('reads a command typed with a with-modifier or a chain of suffixes', () => {\n547:     expect(typedCommandIn('/speckit:complete:with-research the login spec')).toBe('/speckit:complete');\n548:     expect(typedCommandIn('/speckit:complete:with-context the login spec')).toBe('/speckit:complete');\n549:     expect(typedCommandIn('/speckit:complete:auto:with-research the login spec')).toBe('/speckit:complete');\n550:     expect(typedCommandIn('/speckit:plan:with-phases a login page')).toBe('/speckit:plan');\n551:   });\n552: \n553:   // The suffix rule is shared by every tracked command, so a modifier typed on a\n554:   // command whose hint does not list it still names that command.\n555:   it('reads a with-modifier on a command whose hint does not list it as that command', () => {\n556:     expect(typedCommandIn('/deep:review:with-research the diff')).toBe('/deep:review');\n557:   });\n558: \n559:   it('does not read a command followed by an unknown suffix', () => {\n560:     expect(typedCommandIn('/deep:review:automation notes')).toBeUndefined();\n561:     expect(typedCommandIn('/create:readme:draft')).toBeUndefined();\n562:     expect(typedCommandIn('/speckit:complete:with-everything now')).toBeUndefined();\n563:     expect(typedCommandIn('/speckit:complete:auto:draft now')).toBeUndefined();\n564:     // The chain must abut the name, so a known suffix after an unknown one is refused.\n565:     expect(typedCommandIn('/speckit:complete:draft:auto now')).toBeUndefined();\n566:   });\n567: \n568:   it('attaches the deep-loop command typed with its mode suffix', () => {\n569:     expect(attachCommand('system-deep-loop', SINGLE('review'), '/deep:review:auto review the diff')).toBe('/deep:review');\n570:   });\n571: \n572:   it('reads a retired command name as the command that replaced it', () => {\n573:     expect(typedCommandIn('/create:skill')).toBe('/create:sk-skill');\n574:     expect(typedCommandIn('/create:skill make a linting skill')).toBe('/create:sk-skill');\n575:     expect(typedCommandForTop('sk-doc', '/create:skill')).toEqual({\n576:       command: '/create:sk-skill',\n577:       policy: 'start',\n578:       ownerSkillId: 'sk-doc',\n579:     });\n580:   });\n581: \n582:   it('does not read a retired name inside a path', () => {\n583:     expect(typedCommandIn('open docs/create:skill.md')).toBeUndefined();\n584:   });\n585: \n586:   it('carries no command when the prompt only names a file', () => {\n587:     expect(typedCommandForTop('sk-doc', 'open /create:readme.md and summarise it')).toBeUndefined();\n588:   });\n589: \n590:   it('delivers no typed command the prompt refuses', () => {\n591:     expect(typedCommandForTop('system-spec-kit', 'do not run /speckit:complete yet, just explain what it does')).toBeUndefined();\n592:   });\n593: \n594:   it('still delivers a typed command the prompt asks for', () => {\n595:     expect(typedCommandForTop('system-spec-kit', 'run /speckit:complete for the rate limiter')?.command).toBe('/speckit:complete');\n596:   });\n597: });\n598: \n599: describe('generated command table', () => {\n600:   it('holds no separate policy table', async () => {\n601:     expect('COMMAND_POLICIES' in await import('../lib/command-attach.js')).toBe(false);\n602:   });\n603: \n604:   it('the command-bridges README names every command row field', () => {\n605:     const source = readFileSync(join(import.meta.dirname, '../lib/command-attach.ts'), 'utf8');\n606:     const readme = readFileSync(join(import.meta.dirname, '../scripts/command-bridges/README.md'), 'utf8');\n607:     const interfaceBlock = /export interface CommandRow \\{([\\s\\S]*?)\\n\\}/.exec(source)?.[1] ?? '';\n608:     const fields = [...interfaceBlock.matchAll(/readonly (\\w+)\\??:/g)].map((match) => match[1]);\n609:     expect(fields).toEqual(['command', 'policy', 'mutating', 'ownerSkillId']);\n610:     const sentence = /Each row carries [^\\n]*/.exec(readme)?.[0] ?? '';\n611:     for (const field of fields) {\n612:       expect(sentence).toContain('`' + field + '`');\n613:     }\n614:   });\n615: });","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file .skilled/skills/system-skill-advisor/runtime/tests/command-attach-guards.vitest.ts, lines 1-615\n1: // ───────────────────────────────────────────────────────────────\n2: // MODULE: Command attach guards\n3: // ───────────────────────────────────────────────────────────────\n4: \n5: // A hub route names the command that acts on the mode it picked, so it has to\n6: // honour the same no-edit wording the scorer honours. A reader who rules out a\n7: // change must not be handed a command that changes files.\n8: \n9: import { readFileSync } from 'node:fs';\n10: import { join } from 'node:path';\n11: \n12: import { describe, expect, it } from 'vitest';\n13: \n14: import {\n15:   attachCommand,\n16:   commandOnlyMentioned,\n17:   isNoEditRequest,\n18:   MODE_COMMANDS,\n19:   NO_EDIT_REQUEST,\n20:   typedCommandForTop,\n21:   typedCommandIn,\n22: } from '../lib/command-attach.js';\n23: \n24: // The only route shape that names a command unambiguously: one decision and one\n25: // selected target.\n26: function SINGLE(workflowMode: string): Record<string, unknown> {\n27:   return { action: 'route', selectionKind: 'single', targets: [{ workflowMode }] };\n28: }\n29: \n30: // The endings a reader uses to rule out a change. One writes the contraction\n31: // with a curly apostrophe, which is the form many keyboards produce.\n32: const NOEDIT4 = [\n33:   \"don't change anything yet\",\n34:   'no changes yet',\n35:   'don\\u2019t touch any files',\n36:   'make no changes',\n37: ];\n38: \n39: // The prompts that name a command to refuse it or ask about it, the prompts that\n40: // ask for the command, and the prompts that hold a refusal or question word and\n41: // still ask for the command.\n42: const REFUSE8: ReadonlyArray<readonly [string, string]> = [\n43:   ['do not run /speckit:complete yet, just explain what it does', '/speckit:complete'],\n44:   ['I never want to use /create:agent again, delete the agent file', '/create:agent'],\n45:   ['someone ran /speckit:save by accident, how do I undo what it wrote', '/speckit:save'],\n46:   ['please do not start /deep:research, I only want a two line summary of the readme', '/deep:research'],\n47:   ['what does /create:readme do?', '/create:readme'],\n48:   ['do not run it, just tell me what /doctor:update would change', '/doctor:update'],\n49:   ['explain /deep:review to me', '/deep:review'],\n50:   ['skip /create:readme, just append one line to the existing README', '/create:readme'],\n51: ];\n52: \n53: const QUESTION2: ReadonlyArray<readonly [string, string]> = [\n54:   ['is /speckit:complete overkill for a two line fix?', '/speckit:complete'],\n55:   ['should I use /deep:research for this or just read the two files myself?', '/deep:research'],\n56: ];\n57: \n58: const REQUEST6: ReadonlyArray<readonly [string, string]> = [\n59:   ['run /speckit:complete for the rate limiter', '/speckit:complete'],\n60:   ['/create:agent security-reviewer', '/create:agent'],\n61:   [\"don't forget to run /speckit:save\", '/speckit:save'],\n62:   ['explain the diff then run /speckit:save', '/speckit:save'],\n63:   ['use /speckit:plan, not /speckit:complete', '/speckit:plan'],\n64:   ['I ran /speckit:plan yesterday, now run /speckit:implement', '/speckit:implement'],\n65: ];\n66: \n67: const CONTROL5: ReadonlyArray<readonly [string, string]> = [\n68:   ['dont guess, run /speckit:plan', '/speckit:plan'],\n69:   ['never mind just run /speckit:save', '/speckit:save'],\n70:   ['not sure, use /create:readme', '/create:readme'],\n71:   ['without asking, run /speckit:complete', '/speckit:complete'],\n72:   ['can you run /speckit:plan?', '/speckit:plan'],\n73: ];\n74: \n75: describe('command attach on a no-edit prompt', () => {\n76:   it('offers no hub command when the prompt rules out a change', () => {\n77:     const prompt = 'use sk-doc to create a skill called invoice-parser, do not change anything yet';\n78:     expect(attachCommand('sk-doc', SINGLE('sk-create-skill'), prompt)).toBeUndefined();\n79:   });\n80: \n81:   it('offers the command when the same prompt asks for the change', () => {\n82:     const prompt = 'use sk-doc to create a skill called invoice-parser';\n83:     expect(attachCommand('sk-doc', SINGLE('sk-create-skill'), prompt)).toBe('/create:sk-skill');\n84:   });\n85: \n86:   it('reads the shared no-edit wording', () => {\n87:     expect(NO_EDIT_REQUEST.test('just show me the plan')).toBe(true);\n88:   });\n89: \n90:   it.each(NOEDIT4)('offers no hub command when the prompt ends %s', (ending) => {\n91:     const prompt = 'use sk-doc to create an agent called invoice-parser, ' + ending;\n92:     expect(attachCommand('sk-doc', SINGLE('sk-create-agent'), prompt)).toBeUndefined();\n93:   });\n94: \n95:   it('offers the agent command when the prompt asks for the change', () => {\n96:     const prompt = 'use sk-doc to create an agent called invoice-parser';\n97:     expect(attachCommand('sk-doc', SINGLE('sk-create-agent'), prompt)).toBe('/create:agent');\n98:   });\n99: \n100:   it('reads a curly apostrophe as a straight one', () => {\n101:     expect(isNoEditRequest('Don\\u2019t touch any files')).toBe(true);\n102:     expect(isNoEditRequest('touch the files')).toBe(false);\n103:   });\n104: \n105:   // A change request can say what must stay the same, and that is still a\n106:   // request for the change.\n107:   it.each([\n108:     'refactor the parser so there are no changes to its public api',\n109:     'fix the flaky test and make sure there are no changes in behaviour',\n110:     'create an agent called invoice-parser with no changes to existing agents',\n111:     \"create an agent called invoice-parser, don't add tools\",\n112:     \"refactor the parser, don't delete the old tests\",\n113:   ])('keeps a change request that limits its scope: %s', (prompt) => {\n114:     expect(isNoEditRequest(prompt)).toBe(false);\n115:   });\n116: \n117:   // The phrase reads as no change whatever follows it. The first row is a real\n118:   // no-edit request. The second is a change request that pays for the safe\n119:   // reading by losing its command.\n120:   it.each([\n121:     \"show me the plan, don't make any changes\",\n122:     'walk me through the fix, do not make changes',\n123:     'list the stale docs, dont change anything',\n124:     'use sk-doc to create an agent called invoice-parser, dont create it yet',\n125:     \"outline the readme, don't write anything\",\n126:   ])('reads a refusal to make changes as ruling out a change: %s', (prompt) => {\n127:     expect(isNoEditRequest(prompt)).toBe(true);\n128:   });\n129: \n130:   it.each([\n131:     'show me the plan and make no changes to the files',\n132:     'refactor the parser and make no changes to its public api',\n133:   ])('reads make no changes as ruling out a change: %s', (prompt) => {\n134:     expect(isNoEditRequest(prompt)).toBe(true);\n135:   });\n136: });\n137: \n138: describe('a command the prompt only mentions', () => {\n139:   it.each(REFUSE8)('reads %s as a mention of %s', (prompt, command) => {\n140:     expect(commandOnlyMentioned(prompt, command)).toBe(true);\n141:   });\n142: \n143:   it.each(QUESTION2)('reads the question %s as a mention of %s', (prompt, command) => {\n144:     expect(commandOnlyMentioned(prompt, command)).toBe(true);\n145:   });\n146: \n147:   it.each(REQUEST6)('reads %s as a request for %s', (prompt, command) => {\n148:     expect(commandOnlyMentioned(prompt, command)).toBe(false);\n149:   });\n150: \n151:   it.each(CONTROL5)('reads %s as a request for %s beside a refusal word', (prompt, command) => {\n152:     expect(commandOnlyMentioned(prompt, command)).toBe(false);\n153:   });\n154: \n155:   it.each([\n156:     ['do not run /create:agent or /create:readme', '/create:readme'],\n157:     ['never use /create:readme or /create:feature-catalog', '/create:feature-catalog'],\n158:     ['do not run /deep:review, or /deep:research', '/deep:research'],\n159:     ['skip /create:agent or /create:readme', '/create:readme'],\n160:     ['do not run /speckit:plan or /speckit:implement or /speckit:complete', '/speckit:complete'],\n161:     ['do not run /create:agent or the /create:readme command', '/create:readme'],\n162:     ['do not run /create:agent, or the /create:readme command', '/create:readme'],\n163:     ['skip /create:agent or the /create:readme command', '/create:readme'],\n164:     ['never use the /create:readme command or the /create:feature-catalog command', '/create:feature-catalog'],\n165:     ['do not run /doctor:ci report or /create:readme', '/create:readme'],\n166:     ['do not run /doctor:ci report or /doctor:ci scaffold', '/doctor:ci scaffold'],\n167:     ['never use /doctor:git hooks or /doctor:skill-advisor tune', '/doctor:skill-advisor tune'],\n168:   ])('reads %s as a refusal of %s through an or-list', (prompt, command) => {\n169:     expect(commandOnlyMentioned(prompt, command)).toBe(true);\n170:   });\n171: \n172:   // Chat wraps a command name in code, quote or bold marks, and a renamed command\n173:   // is still typed under its old name. Neither may change what the naming reads\n174:   // as, so every fixture must read the same wrapped or retired as it does plain.\n175:   const WRAPPERS: ReadonlyArray<readonly [string, string]> = [\n176:     ['`', '`'], [\"'\", \"'\"], ['\"', '\"'], ['\\u201c', '\\u201d'], ['\\u2018', '\\u2019'], ['**', '**'],\n177:     ['[', ']'], ['(', ')'], ['~~', '~~'], ['<code>', '</code>'], ['\\u00ab', '\\u00bb'], ['\\u2032', '\\u2032'],\n178:   ];\n179:   const PLAIN_ROWS = [...REFUSE8, ...QUESTION2, ...REQUEST6, ...CONTROL5,\n180:     ['do not run /create:agent or /create:readme', '/create:readme'],\n181:     ['skip /create:agent or the /create:readme command', '/create:readme'],\n182:   ] as const;\n183: \n184:   it.each(WRAPPERS)('reads every fixture wrapped in %s the same as plain', (open, close) => {\n185:     for (const [prompt, command] of PLAIN_ROWS) {\n186:       const wrapped = prompt.replace(/\\/[a-z][a-z-]*:[a-z][a-z-]*/g, (name) => `${open}${name}${close}`);\n187:       expect(commandOnlyMentioned(wrapped, command), wrapped).toBe(commandOnlyMentioned(prompt, command));\n188:     }\n189:   });\n190: \n191:   it('reads every fixture under the retired name the same as under the current one', () => {\n192:     for (const [prompt, command] of PLAIN_ROWS) {\n193:       const plain = prompt.split(command).join('/create:sk-skill');\n194:       const retired = prompt.split(command).join('/create:skill');\n195:       expect(commandOnlyMentioned(retired, '/create:sk-skill'), retired)\n196:         .toBe(commandOnlyMentioned(plain, '/create:sk-skill'));\n197:     }\n198:   });\n199: \n200:   // A refusal can follow the name it refuses, so the words after a naming are\n201:   // read for a refusal of \"it\" as well as for a request.\n202:   it.each([\n203:     ['/create:readme is not what I want, do not run it', '/create:readme'],\n204:     ['run /doctor:git setup but do not actually run it', '/doctor:git setup'],\n205:     [\"/speckit:complete came up, but please don't start it\", '/speckit:complete'],\n206:   ])('reads the later refusal in %s as a mention of %s', (prompt, command) => {\n207:     expect(commandOnlyMentioned(prompt, command)).toBe(true);\n208:   });\n209: \n210:   it('still reads a later request of the same command as a request', () => {\n211:     expect(commandOnlyMentioned(\"run /speckit:save and don't skip it\", '/speckit:save')).toBe(false);\n212:   });\n213: \n214:   // A command named as a document is being read about, not run.\n215:   it.each([\n216:     ['read the /create:readme document and tell me what it does', '/create:readme'],\n217:     ['open the /deep:review command file and summarize it', '/deep:review'],\n218:   ])('reads %s as a mention of %s', (prompt, command) => {\n219:     expect(commandOnlyMentioned(prompt, command)).toBe(true);\n220:   });\n221: \n222:   it('still reads a typed command whose argument is a file as a request', () => {\n223:     expect(commandOnlyMentioned('/create:diff file a.md b.md', '/create:diff')).toBe(false);\n224:   });\n225: \n226:   // A doc path that holds the name is a file, not a naming, so it cannot undo the\n227:   // refusal of the command itself.\n228:   it('reads a led refusal beside a doc path of the same command as a mention', () => {\n229:     expect(commandOnlyMentioned('do not run /create:readme, read /create:readme.md', '/create:readme')).toBe(true);\n230:   });\n231: \n232:   // Markup around the name must not hide the lead before it.\n233:   it.each([\n234:     ['do not run `/create:readme`, just tell me what it covers', '/create:readme'],\n235:     ['what does `/create:readme` do?', '/create:readme'],\n236:     ['never use **/deep:review** here', '/deep:review'],\n237:     ['do not run \"/create:readme\" yet', '/create:readme'],\n238:     [\"do not run '/create:readme' yet\", '/create:readme'],\n239:     [\"what's '/create:readme' for?\", '/create:readme'],\n240:     ['never use ‘/deep:review’ here', '/deep:review'],\n241:     ['do not run “/create:readme” yet', '/create:readme'],\n242:   ])('reads the marked-up %s as a mention of %s', (prompt, command) => {\n243:     expect(commandOnlyMentioned(prompt, command)).toBe(true);\n244:   });\n245: \n246:   it('still reads a marked-up request as a request', () => {\n247:     expect(commandOnlyMentioned('run `/create:readme` for the advisor skill', '/create:readme')).toBe(false);\n248:     expect(commandOnlyMentioned(\"run '/create:readme' for the advisor skill\", '/create:readme')).toBe(false);\n249:     expect(commandOnlyMentioned(\"don't skip '/create:readme', run it\", '/create:readme')).toBe(false);\n250:   });\n251: \n252:   it.each([\n253:     [\"do not run '/create:agent' or '/create:readme'\", '/create:readme'],\n254:     [\"do not run '/doctor:ci report' or '/create:readme'\", '/create:readme'],\n255:   ])('reads the quoted or-list %s as a refusal of %s', (prompt, command) => {\n256:     expect(commandOnlyMentioned(prompt, command)).toBe(true);\n257:   });\n258: \n259:   // A retired name maps to the command that replaced it, so refusing the old\n260:   // spelling refuses the new command too.\n261:   it('reads a refusal of a retired name as a refusal of its replacement', () => {\n262:     expect(commandOnlyMentioned('do not run /create:skill', '/create:sk-skill')).toBe(true);\n263:     expect(commandOnlyMentioned('what does /create:skill do?', '/create:sk-skill')).toBe(true);\n264:     expect(commandOnlyMentioned('run /create:skill for my new helper', '/create:sk-skill')).toBe(false);\n265:   });\n266: \n267:   it.each([\n268:     ['use /create:agent or /create:readme', '/create:agent'],\n269:     ['use /create:agent or /create:readme', '/create:readme'],\n270:     ['use /speckit:plan, not /speckit:complete', '/speckit:plan'],\n271:     ['do not run /speckit:complete, run /speckit:plan or /speckit:implement', '/speckit:plan'],\n272:     ['do not run /speckit:complete, run /speckit:plan or /speckit:implement', '/speckit:implement'],\n273:     ['do not run /speckit:complete or run /speckit:plan', '/speckit:plan'],\n274:     ['use /create:agent or the /create:readme command', '/create:readme'],\n275:     ['the next step is /create:agent or /create:readme', '/create:readme'],\n276:     ['use /doctor:ci report or /create:readme', '/create:readme'],\n277:   ])('still reads %s as a request for %s beside an or-list', (prompt, command) => {\n278:     expect(commandOnlyMentioned(prompt, command)).toBe(false);\n279:   });\n280: \n281:   // A bare lead opens a statement as often as a question, so it marks a mention\n282:   // only before a question. One led occurrence does not make a request either\n283:   // when a later occurrence of the same command is not led.\n284:   it.each([\n285:     ['the next step is /speckit:implement', '/speckit:implement'],\n286:     ['the next step is the /speckit:implement command', '/speckit:implement'],\n287:     ['is this right? run /speckit:plan', '/speckit:plan'],\n288:     ['the next step is /speckit:implement\\nany questions?', '/speckit:implement'],\n289:     ['what does /speckit:save do? ok now run /speckit:save', '/speckit:save'],\n290:     ['the plan is /speckit:plan then tests', '/speckit:plan'],\n291:   ])('reads %s as a request for %s', (prompt, command) => {\n292:     expect(commandOnlyMentioned(prompt, command)).toBe(false);\n293:   });\n294: \n295:   // A chat question often leaves the question mark off, so a bare ask word that\n296:   // opens a sentence still marks the command as the subject.\n297:   it.each([\n298:     ['is /speckit:resume safe to run twice', '/speckit:resume'],\n299:     ['does /doctor:git change files or just report problems', '/doctor:git'],\n300:     ['can /prompt:improve make a vague request easier to follow', '/prompt:improve'],\n301:     ['ok. is /speckit:plan enough here', '/speckit:plan'],\n302:     ['quick question? is /speckit:resume safe to run twice', '/speckit:resume'],\n303:     ['Is the /doctor:update command safe?', '/doctor:update'],\n304:   ])('reads %s as a question about %s', (prompt, command) => {\n305:     expect(commandOnlyMentioned(prompt, command)).toBe(true);\n306:   });\n307: \n308:   it.each([\n309:     ['should I run /create:agent or /create:readme?', '/create:readme'],\n310:     ['is /create:agent or /create:readme better?', '/create:readme'],\n311:     ['what does /create:agent or /create:readme do?', '/create:readme'],\n312:   ])('reads %s as a question about %s through an or-list', (prompt, command) => {\n313:     expect(commandOnlyMentioned(prompt, command)).toBe(true);\n314:   });\n315: \n316:   it('reads each command of a two-command prompt on its own', () => {\n317:     expect(commandOnlyMentioned('use /speckit:plan, not /speckit:complete', '/speckit:complete')).toBe(true);\n318:   });\n319: \n320:   it('reads a curly apostrophe as a straight one', () => {\n321:     expect(commandOnlyMentioned('don\\u2019t run /speckit:save', '/speckit:save')).toBe(true);\n322:   });\n323: \n324:   it('reads no need to run as a refusal of the command', () => {\n325:     expect(commandOnlyMentioned('no need to run /doctor:setup, the hooks are fine', '/doctor:setup')).toBe(true);\n326:   });\n327: \n328:   it('still reads a request after no need to ask', () => {\n329:     expect(commandOnlyMentioned('no need to ask, run /speckit:save', '/speckit:save')).toBe(false);\n330:   });\n331: \n332:   it('reads stop using as a refusal of the command', () => {\n333:     expect(commandOnlyMentioned('stop using /create:changelog for this, write the changelog entry by hand', '/create:changelog')).toBe(true);\n334:   });\n335: \n336:   it('still reads a request after stop and', () => {\n337:     expect(commandOnlyMentioned('stop and run /speckit:plan', '/speckit:plan')).toBe(false);\n338:   });\n339: \n340:   it('reads why not use as a request for the command', () => {\n341:     expect(commandOnlyMentioned('why not use /create:agent for this? go ahead and make a security reviewer agent', '/create:agent')).toBe(false);\n342:   });\n343: \n344:   it.each([\n345:     ['I have not run /speckit:plan yet, please start it for the login feature', '/speckit:plan'],\n346:     ['I already ran /create:readme but the output was wrong, run it again for the hooks folder', '/create:readme'],\n347:     ['not run /speckit:plan yet, write notes to /tmp/notes.md, then run it', '/speckit:plan'],\n348:     ['not run /speckit:plan yet, read https://example.com/spec first, then run it', '/speckit:plan'],\n349:   ])('reads %s as a request for %s made by a later clause', (prompt, command) => {\n350:     expect(commandOnlyMentioned(prompt, command)).toBe(false);\n351:   });\n352: \n353:   it.each([\n354:     ['do not run /speckit:complete, I will run it myself later', '/speckit:complete'],\n355:     ['do not use /create:agent, use that other one', '/create:agent'],\n356:     ['do not run /speckit:complete, run /speckit:plan for the rate limiter instead', '/speckit:complete'],\n357:     ['do not run /speckit:complete, run /speckit:plan, then run it for the auth module', '/speckit:complete'],\n358:   ])('still reads %s as a mention of %s', (prompt, command) => {\n359:     expect(commandOnlyMentioned(prompt, command)).toBe(true);\n360:   });\n361: \n362:   it('does not read a longer command name as the shorter one', () => {\n363:     expect(commandOnlyMentioned('do not run /create:sk-skill-parent', '/create:sk-skill')).toBe(false);\n364:   });\n365: \n366:   it.each([\n367:     'what does /create:readme do?',\n368:     'skip /create:readme, just append one line to the existing README',\n369:     'do not run /create:agent or /create:readme',\n370:   ])('offers no hub command for %s', (prompt) => {\n371:     expect(attachCommand('sk-doc', SINGLE('sk-create-readme'), prompt)).toBeUndefined();\n372:   });\n373: \n374:   it('offers no deep-loop command the prompt refuses', () => {\n375:     const deepLoopModes = MODE_COMMANDS['system-deep-loop'];\n376:     const mode = Object.keys(deepLoopModes).find((key) => deepLoopModes[key] === '/deep:research');\n377:     expect(mode, 'the generated table names the research mode').toBeDefined();\n378:     expect(attachCommand('system-deep-loop', SINGLE(mode!), 'please do not start /deep:research, I only want a two line summary of the readme')).toBeUndefined();\n379:   });\n380: \n381:   it('still offers the hub command a plain request routes to', () => {\n382:     expect(attachCommand('sk-doc', SINGLE('sk-create-readme'), 'write a readme for the doctor scripts folder')).toBe('/create:readme');\n383:   });\n384: });\n385: \n386: describe('command attach on a small edit', () => {\n387:   it.each([\n388:     'update the README typo in line 3',\n389:     'fix the typo in the README',\n390:     'correct the spelling in the hooks readme',\n391:     'fix the broken link in the install guide readme',\n392:   ])('offers no creation command for %s', (prompt) => {\n393:     expect(attachCommand('sk-doc', SINGLE('sk-create-readme'), prompt)).toBeUndefined();\n394:   });\n395: \n396:   it.each([\n397:     'write a readme for the doctor scripts folder',\n398:     'create a readme for the payments module, check it for typos when done',\n399:   ])('still offers the creation command for %s', (prompt) => {\n400:     expect(attachCommand('sk-doc', SINGLE('sk-create-readme'), prompt)).toBe('/create:readme');\n401:   });\n402: \n403:   it.each([\n404:     ['sk-doc', 'sk-create-agent', 'build an agent that fixes typos in our docs'],\n405:     ['sk-doc', 'sk-create-readme', 'writing a readme for the grammar module'],\n406:     ['sk-doc', 'sk-create-readme', 'add a readme for the spelling package'],\n407:     ['sk-doc', 'sk-create-changelog', 'add a changelog entry for the typo fixes in the cli help'],\n408:   ])('still offers the creation command on %s %s for %s', (skill, mode, prompt) => {\n409:     expect(attachCommand(skill, SINGLE(mode), prompt)).toBe(MODE_COMMANDS[skill][mode]);\n410:   });\n411: \n412:   it('leaves the wording commands outside the gate', () => {\n413:     const docModes = MODE_COMMANDS['sk-doc'];\n414:     const mode = Object.keys(docModes).find((key) => docModes[key] === '/create:with-human-voice');\n415:     expect(mode, 'the generated table names the human voice mode').toBeDefined();\n416:     expect(attachCommand('sk-doc', SINGLE(mode!), 'humanize the wording in the onboarding guide')).toBe('/create:with-human-voice');\n417:   });\n418: \n419:   it.each([\n420:     ['sk-create-changelog', 'changelog for v2.1, it fixes the broken link checker and spelling errors'],\n421:     ['sk-create-changelog', 'log the spelling fixes in the changelog'],\n422:     ['sk-create-readme', 'document the cli in a readme, each flag gets a one line description'],\n423:     ['sk-create-readme', 'readme for the spelling package'],\n424:     ['sk-create-agent', 'an agent that fixes typos'],\n425:   ])('keeps the creation command for %s on %s', (mode, prompt) => {\n426:     expect(attachCommand('sk-doc', SINGLE(mode), prompt)).toBe(MODE_COMMANDS['sk-doc'][mode]);\n427:   });\n428: \n429:   it('keeps the goal command when the goal is about fixes', () => {\n430:     const docModes = MODE_COMMANDS['sk-doc'];\n431:     const mode = Object.keys(docModes).find((key) => docModes[key] === '/create:goal');\n432:     expect(mode, 'the generated table names the goal mode').toBeDefined();\n433:     expect(attachCommand('sk-doc', SINGLE(mode!), 'set a goal to fix all the typos in the docs')).toBe('/create:goal');\n434:   });\n435: \n436:   it.each([\n437:     'fix the broken links in the install guide readme',\n438:     'fix the dead links in the hooks readme',\n439:   ])('offers no creation command for %s', (prompt) => {\n440:     expect(attachCommand('sk-doc', SINGLE('sk-create-readme'), prompt)).toBeUndefined();\n441:   });\n442: \n443:   it('leaves a command outside the create namespace alone', () => {\n444:     const deepLoopModes = MODE_COMMANDS['system-deep-loop'];\n445:     const mode = Object.keys(deepLoopModes).find((key) => deepLoopModes[key] === '/deep:review');\n446:     expect(mode, 'the generated table names the review mode').toBeDefined();\n447:     expect(attachCommand('system-deep-loop', SINGLE(mode!), 'do a thorough deep review of the typo handling')).toBe('/deep:review');\n448:   });\n449: \n450:   it.each([\n451:     ['sk-create-agent', 'an agent to fix typos'],\n452:     ['sk-create-agent', 'give me an agent to fix broken links in the docs'],\n453:     ['sk-create-agent', 'I want an agent to correct spelling in pull requests'],\n454:   ])('keeps the creation command for %s on %s', (mode, prompt) => {\n455:     expect(attachCommand('sk-doc', SINGLE(mode), prompt)).toBe(MODE_COMMANDS['sk-doc'][mode]);\n456:   });\n457: \n458:   // A skill or a command names its own purpose, so a correction word inside that\n459:   // purpose is the reason the artifact exists and not a request to edit one.\n460:   it.each([\n461:     ['/create:sk-skill', 'a skill to correct spelling in markdown'],\n462:     ['/create:command', \"I'd like a command to fix dead links\"],\n463:   ])('keeps the command %s on %s', (command, prompt) => {\n464:     const docModes = MODE_COMMANDS['sk-doc'];\n465:     const mode = Object.keys(docModes).find((key) => docModes[key] === command);\n466:     expect(mode, 'the generated table names the ' + command + ' mode').toBeDefined();\n467:     expect(attachCommand('sk-doc', SINGLE(mode!), prompt)).toBe(command);\n468:   });\n469: \n470:   // A repo rule or a benchmark also names its purpose the way an agent does, so\n471:   // the correction word belongs to what the artifact is for rather than to an\n472:   // edit of a document that already exists.\n473:   it.each([\n474:     'I want a repo rule that says fix typos in the same commit',\n475:     'repo rule: always fix typos in the same commit',\n476:   ])('keeps the repo-rule command on %s', (prompt) => {\n477:     const docModes = MODE_COMMANDS['sk-doc'];\n478:     const mode = Object.keys(docModes).find((key) => docModes[key] === '/create:repo-rule');\n479:     expect(mode, 'the generated table names the repo rule mode').toBeDefined();\n480:     expect(attachCommand('sk-doc', SINGLE(mode!), prompt)).toBe('/create:repo-rule');\n481:   });\n482: \n483:   it('keeps the benchmark command on benchmark how fast we fix typos', () => {\n484:     const docModes = MODE_COMMANDS['sk-doc'];\n485:     const mode = Object.keys(docModes).find((key) => docModes[key] === '/create:benchmark');\n486:     expect(mode, 'the generated table names the benchmark mode').toBeDefined();\n487:     expect(attachCommand('sk-doc', SINGLE(mode!), 'benchmark how fast we fix typos')).toBe('/create:benchmark');\n488:   });\n489: });\n490: \n491: describe('command attach on a deep-loop prompt', () => {\n492:   it('withholds the review command when another deep-loop command is named', () => {\n493:     expect(attachCommand('system-deep-loop', SINGLE('review'), 'what did /deep:ai-council decide')).toBeUndefined();\n494:   });\n495: \n496:   it('withholds the review command when an unknown deep-loop command is named', () => {\n497:     expect(attachCommand('system-deep-loop', SINGLE('review'), 'what did /deep:reviw decide')).toBeUndefined();\n498:   });\n499: \n500:   it('offers the review command when it is the command typed', () => {\n501:     expect(attachCommand('system-deep-loop', SINGLE('review'), 'run /deep:review now')).toBe('/deep:review');\n502:   });\n503: \n504:   it('offers the review command when the prompt asks for depth', () => {\n505:     expect(attachCommand('system-deep-loop', SINGLE('review'), 'review the parser in depth')).toBe('/deep:review');\n506:   });\n507: });\n508: \n509: describe('typed command boundaries', () => {\n510:   it('does not read a file name with an extension as a typed command', () => {\n511:     expect(typedCommandIn('see /create:sk-skill.md for details')).toBeUndefined();\n512:   });\n513: \n514:   it('does not read a path segment as a typed command', () => {\n515:     expect(typedCommandIn('open /create:readme/notes.txt')).toBeUndefined();\n516:   });\n517: \n518:   it.each([\n519:     ['run **/deep:review** now', '/deep:review'],\n520:     ['run [/deep:review] now', '/deep:review'],\n521:     ['run \\u201c/deep:review\\u201d now', '/deep:review'],\n522:     ['run <code>/deep:review</code> now', '/deep:review'],\n523:   ])('finds the command wrapped in %s', (prompt, command) => {\n524:     expect(typedCommandIn(prompt)).toBe(command);\n525:   });\n526: \n527:   it('reads a command that ends a sentence', () => {\n528:     expect(typedCommandIn('run /create:sk-skill.')).toBe('/create:sk-skill');\n529:   });\n530: \n531:   it('reads a command followed by a comma', () => {\n532:     expect(typedCommandIn('run /create:sk-skill, then stop')).toBe('/create:sk-skill');\n533:   });\n534: \n535:   it('reads the longest command when a prefix also matches', () => {\n536:     expect(typedCommandIn('/create:skill-parent now')).toBe('/create:skill-parent');\n537:   });\n538: \n539:   it('reads a command typed with its mode suffix', () => {\n540:     expect(typedCommandIn('/deep:review:auto review the diff')).toBe('/deep:review');\n541:     expect(typedCommandIn('/speckit:plan:confirm add a login page')).toBe('/speckit:plan');\n542:     expect(typedCommandIn('/speckit:implement:autopilot')).toBe('/speckit:implement');\n543:     expect(typedCommandIn('/speckit:implement:unattended the login spec')).toBe('/speckit:implement');\n544:   });\n545: \n546:   it('reads a command typed with a with-modifier or a chain of suffixes', () => {\n547:     expect(typedCommandIn('/speckit:complete:with-research the login spec')).toBe('/speckit:complete');\n548:     expect(typedCommandIn('/speckit:complete:with-context the login spec')).toBe('/speckit:complete');\n549:     expect(typedCommandIn('/speckit:complete:auto:with-research the login spec')).toBe('/speckit:complete');\n550:     expect(typedCommandIn('/speckit:plan:with-phases a login page')).toBe('/speckit:plan');\n551:   });\n552: \n553:   // The suffix rule is shared by every tracked command, so a modifier typed on a\n554:   // command whose hint does not list it still names that command.\n555:   it('reads a with-modifier on a command whose hint does not list it as that command', () => {\n556:     expect(typedCommandIn('/deep:review:with-research the diff')).toBe('/deep:review');\n557:   });\n558: \n559:   it('does not read a command followed by an unknown suffix', () => {\n560:     expect(typedCommandIn('/deep:review:automation notes')).toBeUndefined();\n561:     expect(typedCommandIn('/create:readme:draft')).toBeUndefined();\n562:     expect(typedCommandIn('/speckit:complete:with-everything now')).toBeUndefined();\n563:     expect(typedCommandIn('/speckit:complete:auto:draft now')).toBeUndefined();\n564:     // The chain must abut the name, so a known suffix after an unknown one is refused.\n565:     expect(typedCommandIn('/speckit:complete:draft:auto now')).toBeUndefined();\n566:   });\n567: \n568:   it('attaches the deep-loop command typed with its mode suffix', () => {\n569:     expect(attachCommand('system-deep-loop', SINGLE('review'), '/deep:review:auto review the diff')).toBe('/deep:review');\n570:   });\n571: \n572:   it('reads a retired command name as the command that replaced it', () => {\n573:     expect(typedCommandIn('/create:skill')).toBe('/create:sk-skill');\n574:     expect(typedCommandIn('/create:skill make a linting skill')).toBe('/create:sk-skill');\n575:     expect(typedCommandForTop('sk-doc', '/create:skill')).toEqual({\n576:       command: '/create:sk-skill',\n577:       policy: 'start',\n578:       ownerSkillId: 'sk-doc',\n579:     });\n580:   });\n581: \n582:   it('does not read a retired name inside a path', () => {\n583:     expect(typedCommandIn('open docs/create:skill.md')).toBeUndefined();\n584:   });\n585: \n586:   it('carries no command when the prompt only names a file', () => {\n587:     expect(typedCommandForTop('sk-doc', 'open /create:readme.md and summarise it')).toBeUndefined();\n588:   });\n589: \n590:   it('delivers no typed command the prompt refuses', () => {\n591:     expect(typedCommandForTop('system-spec-kit', 'do not run /speckit:complete yet, just explain what it does')).toBeUndefined();\n592:   });\n593: \n594:   it('still delivers a typed command the prompt asks for', () => {\n595:     expect(typedCommandForTop('system-spec-kit', 'run /speckit:complete for the rate limiter')?.command).toBe('/speckit:complete');\n596:   });\n597: });\n598: \n599: describe('generated command table', () => {\n600:   it('holds no separate policy table', async () => {\n601:     expect('COMMAND_POLICIES' in await import('../lib/command-attach.js')).toBe(false);\n602:   });\n603: \n604:   it('the command-bridges README names every command row field', () => {\n605:     const source = readFileSync(join(import.meta.dirname, '../lib/command-attach.ts'), 'utf8');\n606:     const readme = readFileSync(join(import.meta.dirname, '../scripts/command-bridges/README.md'), 'utf8');\n607:     const interfaceBlock = /export interface CommandRow \\{([\\s\\S]*?)\\n\\}/.exec(source)?.[1] ?? '';\n608:     const fields = [...interfaceBlock.matchAll(/readonly (\\w+)\\??:/g)].map((match) => match[1]);\n609:     expect(fields).toEqual(['command', 'policy', 'mutating', 'ownerSkillId']);\n610:     const sentence = /Each row carries [^\\n]*/.exec(readme)?.[0] ?? '';\n611:     for (const field of fields) {\n612:       expect(sentence).toContain('`' + field + '`');\n613:     }\n614:   });\n615: });"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\".skilled/skills/system-skill-advisor/runtime/tests/command-attach-guards.vitest.ts\"}"},"time":{"start":1794865455886,"end":1794865456233}}}}
