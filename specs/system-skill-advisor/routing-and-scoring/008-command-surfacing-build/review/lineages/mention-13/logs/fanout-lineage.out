xt","text":"{\"id\":\"F001\",\"sev\":\"P1\",\"title\":\"A document naming returns a mention before a later request clause is read\",\"file\":\".skilled/skills/system-skill-advisor/runtime/lib/command-attach.ts\",\"line\":458,\"first\":1,\"dims\":[\"correctness\"],\"desc\":\"\"}\n{\"id\":\"F002\",\"sev\":\"P1\",\"title\":\"A limiting negation after the name reads as a refusal\",\"file\":\".skilled/skills/system-skill-advisor/runtime/lib/command-attach.ts\",\"line\":413,\"first\":1,\"dims\":[\"correctness\"],\"desc\":\"\"}\n{\"id\":\"SUMMARY-P1-001\",\"sev\":\"P1\",\"title\":\"Summary P1 finding 1\",\"file\":null,\"line\":null,\"first\":3,\"dims\":[\"security\"],\"desc\":\"security - trust boundary of the prompt text, the two new pa\"}\n{\"id\":\"SUMMARY-P1-002\",\"sev\":\"P1\",\"title\":\"Summary P1 finding 2\",\"file\":null,\"line\":null,\"first\":3,\"dims\":[\"security\"],\"desc\":\"security - trust boundary of the prompt text, the two new pa\"}\n{\"id\":\"F003\",\"sev\":\"P2\",\"title\":\"A markdown link label abuts its target and the naming stops being an occurrence\",\"file\":\".skilled/skills/system-skill-advisor/runtime/lib/command-attach.ts\",\"line\":441,\"first\":1,\"dims\":[\"correctness\"],\"desc\":\"\"}\n{\"id\":\"F004\",\"sev\":\"P2\",\"title\":\"The post-name reader covers one clause shape, so a question or a sibling refusal after the\",\"file\":\".skilled/skills/system-skill-advisor/runtime/lib/command-attach.ts\",\"line\":459,\"first\":1,\"dims\":[\"correctness\"],\"desc\":\"\"}\n{\"id\":\"F005\",\"sev\":\"P2\",\"title\":\"The spec's document bullet is wider than the code's determiner rule\",\"file\":\"specs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/040-final-alignment-loop/spec.md\",\"line\":85,\"first\":2,\"dims\":[\"traceability\"],\"desc\":\"\"}\n{\"id\":\"F006\",\"sev\":\"P2\",\"title\":\"CHK-FIX-002 claims matrix coverage for leads the matrix never wraps\",\"file\":\"specs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/040-final-alignment-loop/tasks.md\",\"line\":131,\"first\":2,\"dims\":[\"traceability\"],\"desc\":\"\"}\n{\"id\":\"SUMMARY-P2-001\",\"sev\":\"P2\",\"title\":\"Summary P2 finding 1\",\"file\":null,\"line\":null,\"first\":3,\"dims\":[\"security\"],\"desc\":\"security - trust boundary of the prompt text, the two new pa\"}\n{\"id\":\"SUMMARY-P2-002\",\"sev\":\"P2\",\"title\":\"Summary P2 finding 2\",\"file\":null,\"line\":null,\"first\":3,\"dims\":[\"security\"],\"desc\":\"security - trust boundary of the prompt text, the two new pa\"}\n{\"id\":\"SUMMARY-P2-003\",\"sev\":\"P2\",\"title\":\"Summary P2 finding 3\",\"file\":null,\"line\":null,\"first\":3,\"dims\":[\"security\"],\"desc\":\"security - trust boundary of the prompt text, the two new pa\"}\n{\"id\":\"SUMMARY-P2-004\",\"sev\":\"P2\",\"title\":\"Summary P2 finding 4\",\"file\":null,\"line\":null,\"first\":3,\"dims\":[\"security\"],\"desc\":\"security - trust boundary of the prompt text, the two new pa\"}\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"cd /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research && L=specs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/review/lineages/mention-13 && node -e '\\nconst r = require(\\\"./\\\"+process.argv[1]);\\nfor (const f of r.openFindings) console.log(JSON.stringify({id:f.findingId||f.id, sev:f.severity, title:(f.title||\\\"\\\").slice(0,90), file:f.file, line:f.line, first:f.firstSeen, iter:f.iteration, dims:f.dimensions, desc:(f.description||\\\"\\\").slice(0,60)}));\\n' \\\"$L/deep-review-findings-registry.json\\\"\"}"},"time":{"start":1794866512014,"end":1794866513392}}}}
