1-615',\\n    '.skilled/skills/system-skill-advisor/runtime/tests/command-attach-guards.vitest.ts:138-320',\\n    '.skilled/skills/system-skill-advisor/runtime/tests/command-attach-guards.vitest.ts:509-597',\\n    '.skilled/skills/system-skill-advisor/runtime/lib/scorer/fusion.ts:1200-1216',\\n    'specs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/review/review-brief-13.txt:1-10',\\n    'specs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/review/review-scope-13.txt:1-6',\\n    'specs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/040-final-alignment-loop/spec.md:40-202',\\n    'specs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/040-final-alignment-loop/tasks.md:37-46,130-131',\\n    'specs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/040-final-alignment-loop/acceptance-criteria.md:56',\\n    '.skilled/skills/system-skill-advisor/manual-testing-playbook/native-cli-tools/command-offer-fit-gates.md:3-123'\\n  ],\\n  findingsCount: 4,\\n  findingsSummary: { P0: 0, P1: 2, P2: 2 },\\n  findingsNew: { P0: 0, P1: 2, P2: 2 },\\n  findingDetails: [\\n    {\\n      id: 'F001', severity: 'P1',\\n      title: 'A document naming returns a mention before a later request clause is read',\\n      dimension: 'correctness', file: '.skilled/skills/system-skill-advisor/runtime/lib/command-attach.ts:458',\\n      evidence: 'COMMAND_AS_DOCUMENT returns true from commandOnlyMentioned on the document noun alone, before the COMMAND_ASKED_BY_PRONOUN check at line 460. \\\"open the /deep:review command file, then run it\\\" reads as a mention and typedCommandForTop returns undefined; attachCommand(\\\"system-deep-loop\\\", SINGLE(\\\"review\\\"), \\\"read the /deep:review docs, then do a thorough review of this diff\\\") returns undefined although DEPTH_REQUEST matches \\\"thorough\\\". The contract at lines 403-407 says a use-verb clause with \\\"it\\\" turns an earlier naming into a request.',\\n      disposition: 'active', findingClass: 'logic-ordering',\\n      scopeProof: 'Ran the exported guards and consumer on two concrete prompts; both classify as mentions. The old tree had no document return and the unchanged pronoun regex matches the tail \\\"command file, then run it\\\", so the earlier read was a request. REQUEST6 and CONTROL5 carry no document naming, which is why the suite stays green.',\\n      affectedSurfaceHints: ['.skilled/skills/system-skill-advisor/runtime/lib/command-attach.ts', '.skilled/skills/system-skill-advisor/runtime/lib/scorer/fusion.ts', '.skilled/skills/system-skill-advisor/runtime/tests/command-attach-guards.vitest.ts'],\\n      recommendation: 'Move the COMMAND_AS_DOCUMENT return after the COMMAND_ASKED_BY_PRONOUN check, or let that check win when the clause carries a use verb, and add a row that names the document then asks to run it.',\\n      claimAdjudication: {\\n        claim: 'The new document rule returns a mention before the existing pronoun-request rule can read a later request, so a prompt that asks to run the command loses it.',\\n        evidenceRefs: ['.skilled/skills/system-skill-advisor/runtime/lib/command-attach.ts:458', '.skilled/skills/system-skill-advisor/runtime/lib/command-attach.ts:460', '.skilled/skills/system-skill-advisor/runtime/lib/command-attach.ts:403-407', '.skilled/skills/system-skill-advisor/runtime/lib/command-attach.ts:527'],\\n        counterevidenceSought: 'Checked whether the determiner test or the tail split excludes these prompts; neither does. Checked whether the deep-loop depth gate rescues the hub case; it runs after the mention check at line 527.',\\n        alternativeExplanation: 'A reader naming the command file may be assumed not to want the run. Rejected: both prompts carry an explicit later request and the function comment says that clause wins.',\\n        finalSeverity: 'P1', confidence: 0.9,\\n        downgradeTrigger: 'Downgrade to P2 if no caller reaches the guard with a document naming plus a later request, or if the reorder makes both prompts read as requests.'\\n      }\\n    },\\n    {\\n      id: 'F002', severity: 'P1',\\n      title: 'A limiting negation after the name reads as a refusal',\\n      dimension: 'correctness', file: '.skilled/skills/system-skill-advisor/runtime/lib/command-attach.ts:413',\\n      evidence: 'COMMAND_DECLINED_BY_PRONOUN ends at \\\"it\\\\\\\\b\\\", so a qualifier after \\\"it\\\" still satisfies the refusal. \\\"run /speckit:save and don\\\\'t run it twice\\\" reads as a mention and typedCommandForTop returns undefined; \\\"run /deep:review but never run it without a budget\\\" does the same on the hub path. spec.md:150 records this class as a High risk with REQUEST6, CONTROL5 and the wrapper matrix as the mitigation; none carries a limiting clause after \\\"it\\\".',\\n      disposition: 'active', findingClass: 'logic-overreach',\\n      scopeProof: 'Ran the exported guards on both prompts; both classify as mentions and the typed command is dropped. The unchanged lead tests cannot produce this reading: the pre-name decline would need \\\"do not run /speckit:save\\\", and the bare-ask lead is false, so b8ebee37d75 returned a request.',\\n      affectedSurfaceHints: ['.skilled/skills/system-skill-advisor/runtime/lib/command-attach.ts', '.skilled/skills/system-skill-advisor/runtime/lib/scorer/fusion.ts', '.skilled/skills/system-skill-advisor/runtime/tests/command-attach-guards.vitest.ts'],\\n      recommendation: 'Bound the tail refusal to a clause that ends at \\\"it\\\" or continues with a sentence boundary, and add REQUEST6 rows for a limiting clause after \\\"it\\\".',\\n      claimAdjudication: {\\n        claim: 'The tail refusal matches a negated use verb plus \\\"it\\\" without bounding what follows, so a request that limits how the command runs is read as a refusal and the command is dropped.',\\n        evidenceRefs: ['.skilled/skills/system-skill-advisor/runtime/lib/command-attach.ts:413', '.skilled/skills/system-skill-advisor/runtime/lib/command-attach.ts:459', 'specs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/040-final-alignment-loop/spec.md:150', '.skilled/skills/system-skill-advisor/runtime/tests/command-attach-guards.vitest.ts:58-73'],\\n        counterevidenceSought: 'Searched the fixtures for a limiting clause after \\\"it\\\": the one negative tail row is \\\"don\\\\'t skip it\\\", and the negation rows all sit before the name. Checked the \\\"why not\\\" guard at line 367; it does not apply.',\\n        alternativeExplanation: '\\\"don\\\\'t run it twice\\\" could be read as refusing a second run, which is still a refusal of a run. Rejected as the intended reading for a clause that limits a run already asked for.',\\n        finalSeverity: 'P1', confidence: 0.85,\\n        downgradeTrigger: 'Downgrade to P2 if the rule is narrowed to a clause ending at \\\"it\\\" and these prompts then read as requests.'\\n      }\\n    },\\n    {\\n      id: 'F003', severity: 'P2',\\n      title: 'A markdown link label abuts its target and the naming stops being an occurrence',\\n      dimension: 'correctness', file: '.skilled/skills/system-skill-advisor/runtime/lib/command-attach.ts:441',\\n      evidence: 'The fold drops brackets and parentheses, so \\\"[/create:readme](https://example.com/docs)\\\" becomes \\\"/create:readmehttps://example.com/docs\\\"; the lookahead at line 451 rejects the name and occurrences.length is 0 at line 452. \\\"do not run [/create:readme](https://example.com/docs) yet\\\" reads as a request and attachCommand returns /create:readme. The wrapper matrix pins \\\"[name]\\\" with nothing after the closing bracket.',\\n      disposition: 'active', findingClass: 'normalization-edge',\\n      scopeProof: 'Probed the guard and attachCommand with a linked label, a parenthesized aside with no space and the bracketed form the matrix covers; only the merged forms flip to request.',\\n      affectedSurfaceHints: ['.skilled/skills/system-skill-advisor/runtime/lib/command-attach.ts', '.skilled/skills/system-skill-advisor/runtime/lib/scorer/fusion.ts', '.skilled/skills/system-skill-advisor/runtime/tests/command-attach-guards.vitest.ts'],\\n      recommendation: 'Drop the \\\"](target)\\\" pair before the fold, or treat \\\"](\\\" as a boundary so the label keeps its own occurrence.'\\n    },\\n    {\\n      id: 'F004', severity: 'P2',\\n      title: 'The post-name reader covers one clause shape, so a question or a sibling refusal after the name still reads as a request',\\n      dimension: 'correctness', file: '.skilled/skills/system-skill-advisor/runtime/lib/command-attach.ts:459',\\n      evidence: 'The new rule reads \\\"(do not|don\\\\'t|dont|never) <use verb> it\\\" after the name while the ask rule at line 460 needs the clause to open with a use verb; COMMAND_ASK_LEADS only matches before the name. \\\"/create:readme, what does it do?\\\" reads as a request and attachCommand offers /create:readme; \\\"/create:readme is wrong, skip it\\\" also reads as a request even though \\\"skip\\\" is a decline lead before the name at line 376.',\\n      disposition: 'active', findingClass: 'vocabulary-asymmetry',\\n      scopeProof: 'Probed four post-name shapes (question, skip it, won\\\\'t run it, no need to run it); all return false and the first two offer the command. The pre-name lists already treat skip and won\\\\'t as refusals.',\\n      affectedSurfaceHints: ['.skilled/skills/system-skill-advisor/runtime/lib/command-attach.ts', '.skilled/skills/system-skill-advisor/runtime/tests/command-attach-guards.vitest.ts'],\\n      recommendation: 'Read a post-name question clause (\\\"what does it do\\\") and the pre-name decline vocabulary after the name, or record the narrower contract in the comment.'\\n    }\\n  ],\\n  traceabilityChecks: {\\n    results: [\\n      { protocolId: 'spec_code', status: 'partial', gateClass: 'hard', applicable: true, evidence: ['specs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/040-final-alignment-loop/spec.md:57', 'specs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/040-final-alignment-loop/spec.md:86', '.skilled/skills/system-skill-advisor/runtime/lib/command-attach.ts:440-441'], summary: 'The four refusal shapes and the wider fold match the spec; the request direction fails on F001 and F002.' },\\n      { protocolId: 'checklist_evidence', status: 'notApplicable', gateClass: 'hard', applicable: false, evidence: ['specs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/040-final-alignment-loop/tasks.md:45'], summary: 'The packet task closure is not this pass; 040 is still in progress.' },\\n      { protocolId: 'skill_agent', status: 'pass', gateClass: 'overlay', applicable: true, evidence: ['.skilled/skills/system-skill-advisor/runtime/lib/command-attach.ts:1-14'], summary: 'No agent definition is in the diff.' },\\n      { protocolId: 'agent_cross_runtime', status: 'notApplicable', gateClass: 'overlay', applicable: false, evidence: ['.skilled/skills/system-skill-advisor/runtime/tests/command-attach-guards.vitest.ts:1-22'], summary: 'No runtime mirror is touched by the two scope files.' },\\n      { protocolId: 'feature_catalog_code', status: 'partial', gateClass: 'overlay', applicable: true, evidence: ['.skilled/skills/system-skill-advisor/runtime/tests/command-attach-guards.vitest.ts:175-189'], summary: 'The matrix pins the twelve wrapper pairs; F001 to F004 are the shapes it cannot see.' },\\n      { protocolId: 'playbook_capability', status: 'partial', gateClass: 'overlay', applicable: true, evidence: ['.skilled/skills/system-skill-advisor/manual-testing-playbook/native-cli-tools/command-offer-fit-gates.md:22-24'], summary: 'Read the NC-012 contract; no playbook scenario was executed, the exported guards were run directly.' }\\n    ]\\n  },\\n  newFindingsRatio: 1.0,\\n  noveltyJustification: 'Four first-time findings, no