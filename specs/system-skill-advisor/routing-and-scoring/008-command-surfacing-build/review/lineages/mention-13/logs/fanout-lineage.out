, id: 'e1-ev-002', source: 'ev-002', target: 'f-002', relation: 'EVIDENCE_FOR' },\n    { type: 'edge', id: 'e1-ev-003', source: 'ev-003', target: 'f-003', relation: 'EVIDENCE_FOR' },\n    { type: 'edge', id: 'e1-ev-004', source: 'ev-004', target: 'f-004', relation: 'EVIDENCE_FOR' }\n  ]\n};\nfs.writeFileSync(L + '/iter-001.record.json', JSON.stringify(rec, null, 2) + '\\n');\n// one-row-event files and the delta\nfs.writeFileSync(L + '/iter-001.event.json', JSON.stringify(rec) + '\\n');\nconst delta = [JSON.stringify(rec)];\nfor (const f of rec.findingDetails) delta.push(JSON.stringify({ type: 'finding', id: f.id, severity: f.severity, title: f.title, file: f.file, iteration: 1, findingClass: f.findingClass, dimension: f.dimension }));\nfor (const t of rec.traceabilityChecks.results) delta.push(JSON.stringify({ type: 'traceability', protocolId: t.protocolId, status: t.status, gateClass: t.gateClass, applicable: t.applicable, iteration: 1 }));\ndelta.push(JSON.stringify({ type: 'classification', iteration: 1, detail: 'F001 is logic-ordering: a new early return precedes the existing pronoun-request rule. F002 is logic-overreach: the tail refusal is unbounded after \"it\". F003 is a normalization edge: the fold merges a link label with its target. F004 is vocabulary asymmetry: the post-name reader covers one verb family.' }));\ndelta.push(JSON.stringify({ type: 'ruled_out', iteration: 1, direction: 'A missing occurrence for the bracketed form', reason: 'the fold drops the brackets, so the name is still found; F003 is the merge with a following target' }));\ndelta.push(JSON.stringify({ type: 'ruled_out', iteration: 1, direction: 'A typedCommandIn regression from the widened start boundary', reason: 'glob, home, redirect, bracket, paren, guillemet and prime prefixes only match wrapped commands' }));\ndelta.push(JSON.stringify({ type: 'ruled_out', iteration: 1, direction: 'A new false offer from the decline leads before the name', reason: 'not sure, never mind, dont guess