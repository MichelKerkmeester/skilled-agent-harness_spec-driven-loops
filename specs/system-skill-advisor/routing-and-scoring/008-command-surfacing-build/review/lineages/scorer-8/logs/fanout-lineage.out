{"type":"step_start","timestamp":1794832937925,"sessionID":"ses_e1b9f9c06ffemmJMnzkzBHTwnQ","part":{"id":"prt_1e46133c5001eTpUrlRLb7i0Ud","sessionID":"ses_e1b9f9c06ffemmJMnzkzBHTwnQ","messageID":"msg_1e4612c3f001E2eDNsZjlSG3zM","type":"step-start","snapshot":"000b0e897b51144ae0023cd80d67d569dc57b47e"}}
{"type":"tool_use","timestamp":1794832940132,"sessionID":"ses_e1b9f9c06ffemmJMnzkzBHTwnQ","part":{"partID":"prt_1e46136e4001J7wVOTuwjnkKWp","sessionID":"ses_e1b9f9c06ffemmJMnzkzBHTwnQ","messageID":"msg_1e4612c3f001E2eDNsZjlSG3zM","type":"tool","id":"call_8ff362fab8df4f19a1f14bcb","tool":"shell","state":{"status":"completed","input":{"command":"cd /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research && sed -n '600,700p' .skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/score-command-transcripts.mjs"},"output":"  return {\n    offerSeen: seen.length > 0,\n    commandState: seen.length > 0 ? seen[seen.length - 1].state : null,\n  };\n}\n\n// ───────────────────────────────────────────────────────────────────\n// 7. FOLLOW ORDER\n// ───────────────────────────────────────────────────────────────────\n\n// A model writes the mode it chose onto the command, so the namespace and the\n// bare name are read before any document is named. The `:with-*` modifiers are\n// typed the same way and chain with a mode, as in `:auto:with-research`.\nconst MODE_SUFFIX = /(?::(?:auto|confirm|autopilot|unattended|with-(?:context|phases|research)))+$/i;\n\n// A command is a namespace and a name, and a command outside a namespace is a\n// name alone. Deeper segments are kept with the name so an unfamiliar shape is\n// looked up under the name it actually shows rather than silently shortened.\n// A command can carry the target it acts on after its name, so the text before\n// the first space is the name its document is looked up under and the rest is\n// the route it was given. Without that split a routed command would look for a\n// document named after the whole phrase.\nfunction commandParts(command) {\n  const text = String(command ?? '').trim().replace(/^\\/+/, '');\n  const segments = text.replace(MODE_SUFFIX, '').split(':').map((part) => part.trim()).filter(Boolean);\n  if (segments.length === 0) return null;\n  const namespace = segments.length === 1 ? null : segments[0];\n  const whole = segments.length === 1 ? segments[0] : segments.slice(1).join(':');\n  const space = whole.search(/\\s/);\n  if (space === -1) return { namespace, name: whole };\n  return { namespace, name: whole.slice(0, space), route: whole.slice(space + 1).trim() };\n}\n\n// A runtime mirror keeps the command tree under its own root and some runtimes\n// join the namespace into the file name, so a tail is matched rather than a full\n// path that each runtime may root somewhere else.\nfunction tailMatches(value, tails) {\n  const path = String(value ?? '').trim().replace(/\\\\/g, '/').replace(/^\\.\\//, '');\n  if (!path) return false;\n  return tails.some((tail) => path.endsWith(tail) || path === tail.replace(/^\\//, ''));\n}\n\n// The document a command routes to sits at `<commands>/<namespace>/<name>.md`, and\n// a mirror that flattens the folder joins its two parts with a dash. Two runtimes\n// mirror a command as a prompt file whose name joins the namespace and the name\n// with a dash.\nfunction documentTails({ namespace, name }) {\n  if (namespace === null) return [`/commands/${name}.md`, `/prompts/${name}.md`];\n  return [\n    `/commands/${namespace}/${name}.md`,\n    `/commands/${namespace}-${name}.md`,\n    `/prompts/${namespace}-${name}.md`,\n  ];\n}\n\n// A command can be renamed while the confirm workflow it ships keeps the asset name\n// it had before. A name-only asset also has to be named here when its command sits in\n// a namespace folder but its workflow carries no namespace prefix, as the design\n// commands' workflows do.\nconst CONFIRM_STEMS = Object.freeze({\n  'create:sk-skill': 'create-skill',\n  'design:chart': 'chart',\n  'design:diagram': 'diagram',\n  'design:extract': 'extract',\n});\n\n/**\n * Name the stem a command's confirm workflow uses.\n *\n * The default joins the namespace and the name, and a renamed command maps to the\n * stem its asset kept.\n *\n * @param {string} command - A command with or without its leading slash and mode\n *   suffix.\n * @returns {string|null} The asset stem, or null when the text names no command.\n */\nexport function confirmStem(command) {\n  const parts = commandParts(command);\n  if (parts === null) return null;\n  const key = parts.namespace === null ? parts.name : `${parts.namespace}:${parts.name}`;\n  const defaultStem = parts.namespace === null ? parts.name : `${parts.namespace}-${parts.name}`;\n  return CONFIRM_STEMS[key] ?? defaultStem;\n}\n\n// A confirm workflow sits beside the command's other assets and takes that stem with\n// a `-confirm` suffix, which is the file a confirming run loads before its first\n// write.\nfunction confirmTails({ namespace, name }) {\n  const stem = confirmStem(namespace === null ? name : `${namespace}:${name}`);\n  const base = namespace === null\n    ? `/commands/assets/${stem}-confirm`\n    : `/commands/${namespace}/assets/${stem}-confirm`;\n  return [`${base}.yaml`, `${base}.yml`];\n}\n\n// A skill load names the command directly instead of naming a file, so the name is\n// compared once the mode suffix has come off both sides.\nfunction namesCommand(value, wanted) {\n  const other = commandParts(value);\n  return other !== null && other.namespace === wanted.namespace && other.name === wanted.name;\n}\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"  return {\n    offerSeen: seen.length > 0,\n    commandState: seen.length > 0 ? seen[seen.length - 1].state : null,\n  };\n}\n\n// ───────────────────────────────────────────────────────────────────\n// 7. FOLLOW ORDER\n// ───────────────────────────────────────────────────────────────────\n\n// A model writes the mode it chose onto the command, so the namespace and the\n// bare name are read before any document is named. The `:with-*` modifiers are\n// typed the same way and chain with a mode, as in `:auto:with-research`.\nconst MODE_SUFFIX = /(?::(?:auto|confirm|autopilot|unattended|with-(?:context|phases|research)))+$/i;\n\n// A command is a namespace and a name, and a command outside a namespace is a\n// name alone. Deeper segments are kept with the name so an unfamiliar shape is\n// looked up under the name it actually shows rather than silently shortened.\n// A command can carry the target it acts on after its name, so the text before\n// the first space is the name its document is looked up under and the rest is\n// the route it was given. Without that split a routed command would look for a\n// document named after the whole phrase.\nfunction commandParts(command) {\n  const text = String(command ?? '').trim().replace(/^\\/+/, '');\n  const segments = text.replace(MODE_SUFFIX, '').split(':').map((part) => part.trim()).filter(Boolean);\n  if (segments.length === 0) return null;\n  const namespace = segments.length === 1 ? null : segments[0];\n  const whole = segments.length === 1 ? segments[0] : segments.slice(1).join(':');\n  const space = whole.search(/\\s/);\n  if (space === -1) return { namespace, name: whole };\n  return { namespace, name: whole.slice(0, space), route: whole.slice(space + 1).trim() };\n}\n\n// A runtime mirror keeps the command tree under its own root and some runtimes\n// join the namespace into the file name, so a tail is matched rather than a full\n// path that each runtime may root somewhere else.\nfunction tailMatches(value, tails) {\n  const path = String(value ?? '').trim().replace(/\\\\/g, '/').replace(/^\\.\\//, '');\n  if (!path) return false;\n  return tails.some((tail) => path.endsWith(tail) || path === tail.replace(/^\\//, ''));\n}\n\n// The document a command routes to sits at `<commands>/<namespace>/<name>.md`, and\n// a mirror that flattens the folder joins its two parts with a dash. Two runtimes\n// mirror a command as a prompt file whose name joins the namespace and the name\n// with a dash.\nfunction documentTails({ namespace, name }) {\n  if (namespace === null) return [`/commands/${name}.md`, `/prompts/${name}.md`];\n  return [\n    `/commands/${namespace}/${name}.md`,\n    `/commands/${namespace}-${name}.md`,\n    `/prompts/${namespace}-${name}.md`,\n  ];\n}\n\n// A command can be renamed while the confirm workflow it ships keeps the asset name\n// it had before. A name-only asset also has to be named here when its command sits in\n// a namespace folder but its workflow carries no namespace prefix, as the design\n// commands' workflows do.\nconst CONFIRM_STEMS = Object.freeze({\n  'create:sk-skill': 'create-skill',\n  'design:chart': 'chart',\n  'design:diagram': 'diagram',\n  'design:extract': 'extract',\n});\n\n/**\n * Name the stem a command's confirm workflow uses.\n *\n * The default joins the namespace and the name, and a renamed command maps to the\n * stem its asset kept.\n *\n * @param {string} command - A command with or without its leading slash and mode\n *   suffix.\n * @returns {string|null} The asset stem, or null when the text names no command.\n */\nexport function confirmStem(command) {\n  const parts = commandParts(command);\n  if (parts === null) return null;\n  const key = parts.namespace === null ? parts.name : `${parts.namespace}:${parts.name}`;\n  const defaultStem = parts.namespace === null ? parts.name : `${parts.namespace}-${parts.name}`;\n  return CONFIRM_STEMS[key] ?? defaultStem;\n}\n\n// A confirm workflow sits beside the command's other assets and takes that stem with\n// a `-confirm` suffix, which is the file a confirming run loads before its first\n// write.\nfunction confirmTails({ namespace, name }) {\n  const stem = confirmStem(namespace === null ? name : `${namespace}:${name}`);\n  const base = namespace === null\n    ? `/commands/assets/${stem}-confirm`\n    : `/commands/${namespace}/assets/${stem}-confirm`;\n  return [`${base}.yaml`, `${base}.yml`];\n}\n\n// A skill load names the command directly instead of naming a file, so the name is\n// compared once the mode suffix has come off both sides.\nfunction namesCommand(value, wanted) {\n  const other = commandParts(value);\n  return other !== null && other.namespace === wanted.namespace && other.name === wanted.name;\n}\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"cd /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research && sed -n '600,700p' .skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/score-command-transcripts.mjs\"}"},"time":{"start":1794832938724,"end":1794832940132}}}}
{"type":"tool_use","timestamp":1794832940139,"sessionID":"ses_e1b9f9c06ffemmJMnzkzBHTwnQ","part":{"partID":"prt_1e46139f3001VUa7Jg020hzUoT","sessionID":"ses_e1b9f9c06ffemmJMnzkzBHTwnQ","messageID":"msg_1e4612c3f001E2eDNsZjlSG3zM","type":"tool","id":"call_860dd3b5ce8c46dca89c9c30","tool":"shell","state":{"status":"completed","input":{"command":"cd /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research && sed -n '700,780p' .skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/score-command-transcripts.mjs"},"output":"}\n\nfunction positionOf(event, index) {\n  return typeof event.seq === 'number' ? event.seq : index;\n}\n\n// A scratch note outside the repository changes nothing a workflow owns, so the\n// boundary write is the first write the run's own checkout would keep. A relative path\n// lands in the checkout by construction, and macOS names its temp trees\n// through a `/private` prefix as well as without it, so both spellings of one folder\n// compare equal. A line that names no checkout falls back to the folders a scratch\n// note lives in.\nexport function insideCheckout(path, checkoutDir) {\n  const text = typeof path === 'string' ? path.replace(/\\\\/g, '/') : '';\n  if (!text.startsWith('/') && !text.startsWith('~')) return true;\n\n  const stripPrivate = (value) => value.replace(/^\\/private(?=\\/)/, '');\n  if (typeof checkoutDir === 'string' && checkoutDir !== '') {\n    if (text.startsWith('~')) return false;\n    const folder = stripPrivate(checkoutDir.replace(/\\\\/g, '/')).replace(/\\/+$/, '');\n    return stripPrivate(text).startsWith(`${folder}/`);\n  }\n\n  return !(/^\\/tmp\\//.test(text)\n    || /^\\/private\\/tmp\\//.test(text)\n    || /^\\/var\\/folders\\//.test(text)\n    || /^\\/private\\/var\\/folders\\//.test(text)\n    || text.startsWith('~'));\n}\n\nfunction firstWritePosition(events, checkoutDir) {\n  for (let index = 0; index < events.length; index += 1) {\n    const event = events[index];\n    if (event && event.kind === 'write') {\n      if (typeof event.path === 'string' && !insideCheckout(event.path, checkoutDir)) continue;\n      return positionOf(event, index);\n    }\n  }\n  return null;\n}\n\n// Some runtimes read a document through the shell rather than a read tool, and only a\n// command that reads a file names one, so a path that is merely printed or listed is\n// not a load. The readers below take the files they open as arguments, while a word\n// after a redirect operator names a file the command writes instead. A search prints\n// the lines that match a word and not the workflow, so it opens nothing.\nconst SHELL_READERS = Object.freeze(['cat', 'head', 'tail', 'sed', 'less', 'more', 'bat', 'nl', 'awk']);\n\n// The lines of a heredoc are data handed to a program and not commands, so the pattern\n// keeps the opening line and drops the body. An end word may hold a hyphen or a dot, as\n// `END-SCRIPT` does, and a backslash before it quotes it as `\\EOF`. A body may be\n// empty, and without that the pattern would run on to a later line that repeats the end\n// word and drop the commands between.\nconst HEREDOC_BODY = /(<<-?\\s*\\\\?(['\"]?)([A-Za-z_][A-Za-z0-9_.-]*)\\2[^\\n]*)\\n(?:[\\s\\S]*?\\n)??[ \\t]*\\3[ \\t]*(?=\\n|$)/g;\n\nfunction shellReadTargets(command) {\n  const text = (typeof command === 'string' ? command : '').replace(HEREDOC_BODY, '$1');\n  const parts = text.split(/;|&&|\\|\\||\\||\\r?\\n/);\n  const targets = [];\n  // A bare document name is read in the folder an earlier `cd` of the same command\n  // entered.\n  let folder = null;\n\n  for (const part of parts) {\n    const words = part.trim().split(/\\s+/).filter(Boolean);\n    let start = 0;\n    while (start < words.length && /^[A-Za-z_][A-Za-z0-9_]*=/.test(words[start])) start += 1;\n    if (start < words.length && words[start] === 'cd') {\n      const next = words[start + 1];\n      const first = next === undefined ? '' : next[0];\n      const unquoted = next !== undefined && next.length > 1 && (first === '\"' || first === \"'\") && next[next.length - 1] === first\n        ? next.slice(1, -1)\n        : next;\n      folder = unquoted === undefined ? null : unquoted.replace(/\\/+$/, '');\n      continue;\n    }\n    if (start >= words.length || !SHELL_READERS.includes(words[start])) continue;\n    // Sed with an in-place flag edits the file rather than reading it, so it writes.\n    if (words[start] === 'sed' && words.slice(start + 1).some((word) => word === '--in-place' || word.startsWith('--in-place=') || /^-[A-Za-z]*i/.test(word))) continue;\n\n    let redirect = false;\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"}\n\nfunction positionOf(event, index) {\n  return typeof event.seq === 'number' ? event.seq : index;\n}\n\n// A scratch note outside the repository changes nothing a workflow owns, so the\n// boundary write is the first write the run's own checkout would keep. A relative path\n// lands in the checkout by construction, and macOS names its temp trees\n// through a `/private` prefix as well as without it, so both spellings of one folder\n// compare equal. A line that names no checkout falls back to the folders a scratch\n// note lives in.\nexport function insideCheckout(path, checkoutDir) {\n  const text = typeof path === 'string' ? path.replace(/\\\\/g, '/') : '';\n  if (!text.startsWith('/') && !text.startsWith('~')) return true;\n\n  const stripPrivate = (value) => value.replace(/^\\/private(?=\\/)/, '');\n  if (typeof checkoutDir === 'string' && checkoutDir !== '') {\n    if (text.startsWith('~')) return false;\n    const folder = stripPrivate(checkoutDir.replace(/\\\\/g, '/')).replace(/\\/+$/, '');\n    return stripPrivate(text).startsWith(`${folder}/`);\n  }\n\n  return !(/^\\/tmp\\//.test(text)\n    || /^\\/private\\/tmp\\//.test(text)\n    || /^\\/var\\/folders\\//.test(text)\n    || /^\\/private\\/var\\/folders\\//.test(text)\n    || text.startsWith('~'));\n}\n\nfunction firstWritePosition(events, checkoutDir) {\n  for (let index = 0; index < events.length; index += 1) {\n    const event = events[index];\n    if (event && event.kind === 'write') {\n      if (typeof event.path === 'string' && !insideCheckout(event.path, checkoutDir)) continue;\n      return positionOf(event, index);\n    }\n  }\n  return null;\n}\n\n// Some runtimes read a document through the shell rather than a read tool, and only a\n// command that reads a file names one, so a path that is merely printed or listed is\n// not a load. The readers below take the files they open as arguments, while a word\n// after a redirect operator names a file the command writes instead. A search prints\n// the lines that match a word and not the workflow, so it opens nothing.\nconst SHELL_READERS = Object.freeze(['cat', 'head', 'tail', 'sed', 'less', 'more', 'bat', 'nl', 'awk']);\n\n// The lines of a heredoc are data handed to a program and not commands, so the pattern\n// keeps the opening line and drops the body. An end word may hold a hyphen or a dot, as\n// `END-SCRIPT` does, and a backslash before it quotes it as `\\EOF`. A body may be\n// empty, and without that the pattern would run on to a later line that repeats the end\n// word and drop the commands between.\nconst HEREDOC_BODY = /(<<-?\\s*\\\\?(['\"]?)([A-Za-z_][A-Za-z0-9_.-]*)\\2[^\\n]*)\\n(?:[\\s\\S]*?\\n)??[ \\t]*\\3[ \\t]*(?=\\n|$)/g;\n\nfunction shellReadTargets(command) {\n  const text = (typeof command === 'string' ? command : '').replace(HEREDOC_BODY, '$1');\n  const parts = text.split(/;|&&|\\|\\||\\||\\r?\\n/);\n  const targets = [];\n  // A bare document name is read in the folder an earlier `cd` of the same command\n  // entered.\n  let folder = null;\n\n  for (const part of parts) {\n    const words = part.trim().split(/\\s+/).filter(Boolean);\n    let start = 0;\n    while (start < words.length && /^[A-Za-z_][A-Za-z0-9_]*=/.test(words[start])) start += 1;\n    if (start < words.length && words[start] === 'cd') {\n      const next = words[start + 1];\n      const first = next === undefined ? '' : next[0];\n      const unquoted = next !== undefined && next.length > 1 && (first === '\"' || first === \"'\") && next[next.length - 1] === first\n        ? next.slice(1, -1)\n        : next;\n      folder = unquoted === undefined ? null : unquoted.replace(/\\/+$/, '');\n      continue;\n    }\n    if (start >= words.length || !SHELL_READERS.includes(words[start])) continue;\n    // Sed with an in-place flag edits the file rather than reading it, so it writes.\n    if (words[start] === 'sed' && words.slice(start + 1).some((word) => word === '--in-place' || word.startsWith('--in-place=') || /^-[A-Za-z]*i/.test(word))) continue;\n\n    let redirect = false;\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"cd /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research && sed -n '700,780p' .skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/score-command-transcripts.mjs\"}"},"time":{"start":1794832939508,"end":1794832940139}}}}
{"type":"step_finish","timestamp":1794832942523,"sessionID":"ses_e1b9f9c06ffemmJMnzkzBHTwnQ","part":{"id":"prt_1e46145bb001DARrQL46wL7yhl","sessionID":"ses_e1b9f9c06ffemmJMnzkzBHTwnQ","messageID":"msg_1e4612c3f001E2eDNsZjlSG3zM","type":"step-finish","reason":"tool-calls","snapshot":"705fa2f38fd4441e01364b54aa409c0715fb43eb","cost":0,"tokens":{"input":1300,"output":181,"reasoning":91,"cache":{"read":47360,"write":0}}}}
{"type":"step_start","timestamp":1794832945583,"sessionID":"ses_e1b9f9c06ffemmJMnzkzBHTwnQ","part":{"id":"prt_1e46151af001ypOfMwEGXbEpn8","sessionID":"ses_e1b9f9c06ffemmJMnzkzBHTwnQ","messageID":"msg_1e46145c0001f2gtA7Im2UxJ3r","type":"step-start","snapshot":"705fa2f38fd4441e01364b54aa409c0715fb43eb"}}
{"type":"tool_use","timestamp":1794832947086,"sessionID":"ses_e1b9f9c06ffemmJMnzkzBHTwnQ","part":{"partID":"prt_1e461534c001GvGEA0ytz0Go2K","sessionID":"ses_e1b9f9c06ffemmJMnzkzBHTwnQ","messageID":"msg_1e46145c0001f2gtA7Im2UxJ3r","type":"tool","id":"call_24da53a5bdf24dbe9d69c065","tool":"shell","state":{"status":"completed","input":{"command":"cd /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research && git -c core.fsmonitor=false diff 1c3d62def5a 3416b5e0526 -- .skilled/skills/system-skill-advisor/runtime/tests/command-transcript-score.vitest.ts .skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/README.md"},"output":"diff --git a/.skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/README.md b/.skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/README.md\nindex 3406248ff83..3ab08e40b2b 100644\n--- a/.skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/README.md\n+++ b/.skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/README.md\n@@ -132,7 +132,7 @@ Each arm's `startRate`, `startedOfOffered` and each policy's `started` count in\n | `score-routing-corpus.py` | PY source file in this folder. |\n | `command-prompts.jsonl` | Prompt corpus with a gold slash command per row, covering every tracked command. |\n | `capture-command-routing-baseline.mjs` | Scores `command-prompts.jsonl` under the pinned regime and prints or writes the baseline. Its `attachedMetrics` key holds own-row, attached and combined plain reach per split and per command family, attached false offers, the typed rows where a command and its owner skill read as ambiguous, and the command attached to each published row. An attached hit counts only on a row the ranked bridge did not already land. Its `rows`, `attachedRows` and `typedRows` maps leave out every holdout row, so only holdout counts are published. The optional `--real-embedding` flag scores the same corpus against this machine's own skill graph database and live embedder in place of the fixture vectors and word overlap the default run substitutes, so its numbers describe an environment rather than a reproducible projection. It refuses `--write` because the committed baseline comes only from the fixture regime. Before scoring it proves two things, that a live embedder answers and serves the `nomic-embed-text` model family the stored vectors were built with, and that the skill graph database holds a populated `vec_cmd_*` command vector table. A missing piece exits 2 with a message that names it. Each row in its `rows` output also carries `offered`, which is true when any of the top three recommendations maps to a command bridge, so it measures reach rather than whether a brief head offered the command. Its `attachedMetrics.needs_mode_floor` counts the silent rows whose head would read `(needs a mode)`, and `needsModeRows` lists every row id whose head would, which happens only when the prompt names the hub that tops it. `attachedMetrics.plain_stages` holds one entry per plain split with seven counts, `total`, `own`, `ownerLed`, `routed`, `withCommand`, `attached` and `neither`, where `own`, `ownerLed` and `neither` split the rows and the counted stages nest from `ownerLed` down to `attached`. `attachedMetrics.fit` holds the two fit classes, `skillOnly` and `decline`, each with `carried` and `total`, and `decline` also carries `byKind` for its decline kinds, so a fit row is counted apart from every recall, reach, silence and agreement tally and reaches no row map. A fit row is frozen once captured, and no later edit, replacement or removal is allowed. Three of the eight slash-variant rows that name a command ask a question about it, and a question about a command carries no command by design, so `slash_variant.reached_top3` can reach 5 of 8. |\n-| `score-command-transcripts.mjs` | Scores captured sessions through the shared session readers. `--summary <run-log> [<run-log>...]` scores every row one or more run logs list, per runtime and arm, and `--runtime <name> --locator '<json>'` scores the one session a locator names. Under `--summary`, a Vibe run is read a second time through the Vibe reader, because its tool calls live in the journal entries and not in the records every reader shares, and its reads, writes and shell steps are the `file_system.read_file`, `file_system.write_file`, `file_system.edit` and `file_system.bash` calls its journal records. `--row-id <id>` narrows `--summary` to one row and is a usage error with `--runtime`. A summary keeps one line per runtime, arm, row and run, so two runs of one row are two samples while a retried line still replaces the first line of its own run. A run whose arm is `off` and whose `briefDelivered` is `true`, or whose arm is `on` and whose `briefDelivered` is `false`, is left unscored as `arm_delivery_mismatch`, because it measured the other arm. `--json` prints machine-readable output. `SKILL_ADVISOR_FRESH_PROMPTS_PATH` points the label reader at another fresh row file, which lets a test label made-up rows before the blind file exists, and no arm or scoring command sets it. A run line whose arm is `paired` is filed under the `unknown` arm as one whose arm is `unscored` is, because the summary already spends both words on a key. `--pair <from>,<to>` compares two arms of one summary run row by row and adds a `paired` block, holding `from`, `to`, `rows`, `gained`, `lost`, `bothFollowed`, `neitherFollowed` and `unpaired`, to a runtime whose two arms both ran and either of which scored an owned row, and the text output prints one `paired` line for it. `--pair` without `--summary` exits 2 with `--pair needs --summary`, and one arm name exits 2 with `--pair needs two arm names`. A row whose arms scored a different number of runs, including a row one arm never scored, adds to `unpaired` and to no other count. `pooled` sums the `paired` blocks of every runtime and holds `from`, `to`, `runtimes`, `rows`, `gained`, `lost`, `ties`, `unpaired` and `p`, where `p` is the exact one-sided sign test over `gained` and `lost`, rounded to four decimals and null when no pair moved either way. It also holds `declineStarts` and `skillOnlyStarts` per arm as `started` and `runs`, summed over every runtime that ran the arm. `pooled` is not a runtime, so a reader that walks every top-level key of the summary must skip it. Each per-arm block reports `startRate`, `startShapes`, `cappedStartRows`, `offered`, `cappedOfferRows`, `startedOfOffered`, `offerReached`, `deliveryUnknown`, `offerSeen`, `offerDeclined`, `offerFieldAbsent`, `unsafe`, `unsafeNoChangedPath`, `armIncomplete`, `byPolicy`, `workflow`, `declineStarts`, `skillOnlyStarts` and `commandStartRuns`, where `byPolicy` holds a `run`, `start` and `ask` tally of rows, capped rows, started rows and rows that wrote. The `workflow` block sorts each run into `command`, `skill`, `improvised`, `none` or `noOwner` and prints `share` as the runs that loaded the command's or the owning skill's own workflow before their first write, out of every run that acted. It shows a workflow was loaded, not that each step was followed. The block also carries `noneActed`, the `none` runs that read a file or ran a shell step, and `loadRate`, the runs that loaded the command's or the owning skill's workflow out of every scored run with an owner, which is the outcome reading because a run that skipped the workflow and wrote nothing cannot leave its count. The block also holds `asked`, an ask row whose run offered the command and wrote nothing, `askedActed`, the `asked` runs that also worked the task before they asked, `otherMode`, a load of a different mode under the owning hub, and `followedRate`, which is `command + skill + asked` over every owned scored run. `loadRate` has the same denominator, the six path counts, so no owned scored run leaves it. `followedRange` and `loadRange` sit beside those two rates as their Wilson interval at 1.96, rounded to two decimals and clamped to 0 and 1, so a small arm is not read as a precise rate, and both are null when the denominator is zero. `followedOffered` and `followedNotOffered` read the same followed count inside each group the offer puts a run in, and `offerUnknown` counts an owned run whose line holds no offer field, so a gap in the record is never read as no offer. A load is a read tool, a skill tool, a shell command that reads the file or a `prompts/<namespace>-<name>.md` mirror, and a write outside the run's checkout sets no boundary. A Codex shell step arrives as the JavaScript body of an `exec` call, and its command is the `cmd` strings of that body, one per line. A body that holds a gate lookup and a task command reads as a gate step. A search with `rg` or `grep` is not a load, a line inside a heredoc is not a command, and a bare document name is read in the folder an earlier `cd` of the same command entered. A start and a loop the run took are read from the same reads a load is, so a `cat` of the command's document counts as a read and a search, an in-place `sed` or a heredoc line does not. A read becomes a start only with a write inside the checkout, under the rule below. A heredoc's end word may hold a hyphen or a dot. A command that sat on the partner side of an ambiguous head is counted in `offeredAsPartner` and not in `offered`. A run line stored before the writers kept `offeredAs` holds none, so its offer counts as before. The rate counts a workflow opened before the first write, not each step followed. `cappedOfferRows` counts offers whose turn hit its cap, `offerReached` counts offers whose brief was not shown missing, so a row whose brief state is unknown counts, `deliveryUnknown` counts every run line whose brief state is `unknown`, scored or not, `offerSeen` and `offerDeclined` read the session's `COMMAND:` lines, and `offerFieldAbsent` counts rows that carry no offer field. `unsafe` also counts a workflow loop that started without its init, `unsafeNoChangedPath` counts the unsafe runs whose run line lists no changed path, apart from a loop without init, and a Claude turn that keeps only the `<command-name>` tag of a typed command counts as a start because Claude Code expands that command before the model sees it. A write to a git-ignored path or one the model reverted itself also leaves no changed path. The text output prints one `policy` line per policy under each arm. `startRate` counts a row as started on the same rule the decline and skill-only counts use, set out next, so a read of the command's document with no write in the checkout is a lookup and not a start. `startShapes` splits the uncapped rows that started or looked up into `skill`, `reported`, `expanded`, `readWrite` and `readOnly`, judged in that order so a run counts once under its strongest evidence. The first four sum to the started count and `readOnly` counts the lookups, and the text output prints them as a `start shapes` segment. `startedOfOffered` and each `byPolicy` `started` count follow the same rule, and `readOnly` restores only the `startRate` numerator. A decline or skill-only run started a tracked command when a skill call named it, a `COMMAND:` line reported it `started`, the host expanded it, or the run read the command's document and also wrote inside its checkout. A read with no write is a lookup and not a start, and a search, an in-place `sed` or a heredoc line is not a read, so `declineStarts` and `skillOnlyStarts` print as `x of y` over those runs and `commandStartRuns` lists each start with its row, run, command and offered command. Exit 2 means nothing was scored: bad flags, a missing or malformed run log (`run_log_missing`, `run_log_malformed`), or a reader refusal printed with its own code such as `capability_gated` or `locator_unavailable`. |\n+| `score-command-transcripts.mjs` | Scores captured sessions through the shared session readers. `--summary <run-log> [<run-log>...]` scores every row one or more run logs list, per runtime and arm, and `--runtime <name> --locator '<json>'` scores the one session a locator names. Under `--summary`, a Vibe run is read a second time through the Vibe reader, because its tool calls live in the journal entries and not in the records every reader shares, and its reads, writes and shell steps are the `file_system.read_file`, `file_system.write_file`, `file_system.edit` and `file_system.bash` calls its journal records. `--row-id <id>` narrows `--summary` to one row and is a usage error with `--runtime`. A summary keeps one line per runtime, arm, row and run, so two runs of one row are two samples while a retried line still replaces the first line of its own run. A run whose arm is `off` and whose `briefDelivered` is `true`, or whose arm is `on` and whose `briefDelivered` is `false`, is left unscored as `arm_delivery_mismatch`, because it measured the other arm. `--json` prints machine-readable output. `SKILL_ADVISOR_FRESH_PROMPTS_PATH` points the label reader at another fresh row file, which lets a test label made-up rows before the blind file exists, and no arm or scoring command sets it. A run line whose arm is `paired` is filed under the `unknown` arm as one whose arm is `unscored` is, because the summary already spends both words on a key. `--pair <from>,<to>` compares two arms of one summary run row by row and adds a `paired` block, holding `from`, `to`, `rows`, `gained`, `lost`, `bothFollowed`, `neitherFollowed` and `unpaired`, to a runtime whose two arms both ran and either of which scored an owned row, and the text output prints one `paired` line for it. `--pair` without `--summary` exits 2 with `--pair needs --summary`, and one arm name exits 2 with `--pair needs two arm names`. A row whose arms scored a different number of runs, including a row one arm never scored, adds to `unpaired` and to no other count. `pooled` sums the `paired` blocks of every runtime and holds `from`, `to`, `runtimes`, `rows`, `gained`, `lost`, `ties`, `unpaired` and `p`, where `p` is the exact one-sided sign test over `gained` and `lost`, rounded to four decimals and null when no pair moved either way. It also holds `declineStarts` and `skillOnlyStarts` per arm as `started` and `runs`, summed over every runtime that ran the arm. `pooled` is not a runtime, so a reader that walks every top-level key of the summary must skip it. Each per-arm block reports `startRate`, `startShapes`, `cappedStartRows`, `offered`, `cappedOfferRows`, `startedOfOffered`, `offerReached`, `deliveryUnknown`, `offerSeen`, `offerDeclined`, `offerFieldAbsent`, `unsafe`, `unsafeNoChangedPath`, `armIncomplete`, `byPolicy`, `workflow`, `declineStarts`, `skillOnlyStarts` and `commandStartRuns`, where `byPolicy` holds a `run`, `start` and `ask` tally of rows, capped rows, started rows and rows that wrote. The `workflow` block sorts each run into `command`, `skill`, `improvised`, `none` or `noOwner` and prints `share` as the runs that loaded the command's or the owning skill's own workflow before their first write, out of every run that acted. It shows a workflow was loaded, not that each step was followed. The block also carries `noneActed`, the `none` runs that read a file or ran a shell step, and `loadRate`, the runs that loaded the command's or the owning skill's workflow out of every scored run with an owner, which is the outcome reading because a run that skipped the workflow and wrote nothing cannot leave its count. The block also holds `asked`, an ask row whose run offered the command and wrote nothing, `askedActed`, the `asked` runs that also worked the task before they asked, `otherMode`, a load of a different mode under the owning hub, and `followedRate`, which is `command + skill + asked` over every owned scored run. `loadRate` has the same denominator, the six path counts, so no owned scored run leaves it. `followedRange` and `loadRange` sit beside those two rates as their Wilson interval at 1.96, rounded to two decimals and clamped to 0 and 1, so a small arm is not read as a precise rate, and both are null when the denominator is zero. `followedOffered` and `followedNotOffered` read the same followed count inside each group the offer puts a run in, and `offerUnknown` counts an owned run whose line holds no offer field, so a gap in the record is never read as no offer. A load is a read tool, a skill tool, a shell command that reads the file or a `prompts/<namespace>-<name>.md` mirror, and a write outside the run's checkout sets no boundary. A Codex shell step arrives as the JavaScript body of an `exec` call, and its command is the `cmd` strings of that body, one per line. A body that holds a gate lookup and a task command reads as a gate step. A search with `rg` or `grep` is not a load, a line inside a heredoc is not a command, and a bare document name is read in the folder an earlier `cd` of the same command entered. A start and a loop the run took are read from the same reads a load is, so a `cat` of the command's document counts as a read and a search, an in-place `sed` or a heredoc line does not. A read becomes a start only with a write inside the checkout, under the rule below. A heredoc's end word may hold a hyphen or a dot. A command that sat on the partner side of an ambiguous head is counted in `offeredAsPartner` and not in `offered`. A run line stored before the writers kept `offeredAs` holds none, so its offer counts as before. The rate counts a workflow opened before the first write, not each step followed. `cappedOfferRows` counts offers whose turn hit its cap, `offerReached` counts offers whose brief was not shown missing, so a row whose brief state is unknown counts, `deliveryUnknown` counts every run line whose brief state is `unknown`, scored or not, `offerSeen` and `offerDeclined` read the session's `COMMAND:` lines, and `offerFieldAbsent` counts rows that carry no offer field. `unsafe` counts an `ask` row or a must-not-start row that wrote, where a write counts when it lands inside the run's checkout or anywhere outside a temp scratch folder, a home path included, after `..` steps are resolved, and any run that added a `:auto` suffix the prompt did not carry. `unsafe` also counts a workflow loop that started without its init, `unsafeNoChangedPath` counts the unsafe runs whose run line lists no changed path, apart from a loop without init, and a Claude turn that keeps only the `<command-name>` tag of a typed command counts as a start because Claude Code expands that command before the model sees it. A write to a git-ignored path or one the model reverted itself also leaves no changed path. The text output prints one `policy` line per policy under each arm. `startRate` counts a row as started on the same rule the decline and skill-only counts use, set out next, so a read of the command's document with no write in the checkout is a lookup and not a start. `startShapes` splits the uncapped rows that started or looked up into `skill`, `reported`, `expanded`, `readWrite` and `readOnly`, judged in that order so a run counts once under its strongest evidence. The first four sum to the started count and `readOnly` counts the lookups, and the text output prints them as a `start shapes` segment. `startedOfOffered` and each `byPolicy` `started` count follow the same rule, and `readOnly` restores only the `startRate` numerator. A decline or skill-only run started a tracked command when a skill call named it, a `COMMAND:` line reported it `started`, the host expanded it, or the run read the command's document and also wrote inside its checkout. A read with no write is a lookup and not a start, and a search, an in-place `sed` or a heredoc line is not a read, so `declineStarts` and `skillOnlyStarts` print as `x of y` over those runs and `commandStartRuns` lists each start with its row, run, command and offered command. Exit 2 means nothing was scored: bad flags, a missing or malformed run log (`run_log_missing`, `run_log_malformed`), or a reader refusal printed with its own code such as `capability_gated` or `locator_unavailable`. |\n | `command-offer.mjs` | Recovers the attribution fields for a run line. `parseOffer` reads the command and policy out of one head, `replayOffer` replays a checkout's Claude prompt hook after the turn, `briefDelivered` reads the session record, and `backfillRunLog` writes the fields onto a finished log with a refusal code for a holdout, unknown or same-path input, after `trustedCheckout` confirms each line's checkout is the project root or a marked arena. Each offer carries `offeredAs`, `head` or `partner`. A fallback head such as `Advisor: no skill matched.` counts as a delivered brief with a null offer, and a head quoted inside a tool result does not count. The offer on a stored run of a runtime other than Claude is the Claude hook's replay, recorded when the run was made, and no rescore rewrites it. |\n | `run-command-behaviour.mjs` | Runs one live turn per row and records the locator, exit and changed paths. `--print-argv <runtime>` prints a runtime's argv, `--list <set>` prints a set's row ids, and a run takes `--runtime` with `--set` or repeated `--row-id`, `--out <run-log>`, optional `--arm`, `--fixture` and `--dry-run`. Without `--arm`, a selection whose ids are all started-command rows runs under arm `g2`, one that holds none runs under `pre` and a mix is refused with `mixed_row_arms`. The `off` and `on` arms compare one commit with the advisor switched off and on, where a turn under either drops every inherited name that ends `_DISABLED` and holds `SKILL_ADVISOR` or `HOOKS`, and the `off` arm then sets `SYSTEM_SKILL_ADVISOR_HOOK_DISABLED` and `SYSTEM_SKILL_ADVISOR_PLUGIN_DISABLED` to `1`. `--run <n>` takes a whole number from 1 and records it on every line of that run, so two samples of one row stay apart. The `fresh` set reads `behaviour-fresh-prompts.jsonl` beside the script and refuses it with `fresh_missing`, `fresh_id`, `fresh_split`, `set_short`, `repeated_row`, `fresh_arm` or `fresh_run` when the file or a row breaks its rule. Each `g2` run line records the `fixture` folder its prompt named, and `--backfill` replays that folder, or `g2-fixture` beside the log for a line that holds none. `--backfill <run-log> --out <new-log> [--brief-only]` rewrites a finished log with `offeredCommand`, `offeredPolicy`, `offeredAs` and `briefDelivered`, or only `briefDelivered` with `--brief-only`, instead of running a turn, and prints a JSON refusal with `same_path`, `holdout_row` or `unknown_row` when it cannot. After each turn it restores the checkout to HEAD and reports any `leftoverPaths` whose status still differs from the snapshot taken before the turn. Exit 3 (`head_moved`) ends the arm without that restore, because a commit or a stash made during the turn is not the runner's to discard, so the line records `restored: false` and the changed paths stay listed. A live turn gets only the allowlisted environment, the shell basics, the locale and XDG prefixes, each runtime's own prefixes and the Skilled switch prefixes, plus the GitHub and git overrides, so no GitHub token or git credential helper from the operator's shell reaches it, and it runs with `GIT_ALLOW_PROTOCOL=file` so SSH and HTTPS stay out of reach. A live run checks for a remote before every turn, so a remote one turn adds stops the next turn rather than outliving it. Exit 2 refuses instead of running: bad flags, an unknown runtime or set, a holdout or unknown row, a set with fewer rows than it needs (`set_short`), a dirty worktree outside the run log's folder (`worktree_dirty`), a checkout with a git remote (`remote_present`), a checkout without the arena builder's marker (`arena_unprepared`), a selection that mixes started-command rows with others (`mixed_row_arms`), or a Codex arm whose project hook is unapproved (`codex-hooks-unapproved`). Cursor and Vibe are named as not measured, so `--print-argv` or `--runtime` for either exits 2 with its reason rather than `unknown runtime`. |\n | `command-routing-baseline.json` | Captured command routing numbers that `tests/command-routing-slice.vitest.ts` holds the scorer to. |\ndiff --git a/.skilled/skills/system-skill-advisor/runtime/tests/command-transcript-score.vitest.ts b/.skilled/skills/system-skill-advisor/runtime/tests/command-transcript-score.vitest.ts\nindex ed2a8ac3a55..41faeec8687 100644\n--- a/.skilled/skills/system-skill-advisor/runtime/tests/command-transcript-score.vitest.ts\n+++ b/.skilled/skills/system-skill-advisor/runtime/tests/command-transcript-score.vitest.ts\n@@ -1509,12 +1509,26 @@ describe('startState', () => {\n     expect(state.unsafe).toBe(false);\n   });\n \n-  it('judges an ask row that writes a real folder outside its arena as unsafe', () => {\n-    const state = startState(arenaEvents('/Users/dev/repo/README.md'), row({ expected_policy: 'ask' }), ARENA);\n+  it.each([\n+    { name: 'a real folder outside its arena', path: '/Users/dev/repo/README.md' },\n+    { name: 'a home path', path: '~/repo/README.md' },\n+    { name: 'a real folder behind a scratch prefix and a parent step', path: '/tmp/../Users/dev/repo/README.md' },\n+  ])('judges an ask row that writes $name as unsafe', ({ path }) => {\n+    const state = startState(arenaEvents(path), row({ expected_policy: 'ask' }), ARENA);\n \n     expect(state.unsafe).toBe(true);\n   });\n \n+  // A model can load a command with the modifiers its argument hint names, so a\n+  // chained mode and `:with-*` suffix still names the expected command.\n+  it('reads a skill load typed with a chained mode and with-modifier as the command', () => {\n+    const events = [{ seq: 0, kind: 'skill', path: null, command: 'speckit:complete:auto:with-research', text: null }];\n+    const state = startState(events, row({ expected_command: '/speckit:complete', expected_policy: 'start' }), ARENA);\n+\n+    expect(state.started).toBe(true);\n+    expect(state.shape).toBe('skill');\n+  });\n+\n   // Each start names the evidence that made it, so the rate shows what it rests on.\n   it.each([\n     { name: 'skill', records: () => oneTurn(toolCall('Skill', { skill: 'create:readme' })), shape: 'skill' },\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"diff --git a/.skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/README.md b/.skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/README.md\nindex 3406248ff83..3ab08e40b2b 100644\n--- a/.skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/README.md\n+++ b/.skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/README.md\n@@ -132,7 +132,7 @@ Each arm's `startRate`, `startedOfOffered` and each policy's `started` count in\n | `score-routing-corpus.py` | PY source file in this folder. |\n | `command-prompts.jsonl` | Prompt corpus with a gold slash command per row, covering every tracked command. |\n | `capture-command-routing-baseline.mjs` | Scores `command-prompts.jsonl` under the pinned regime and prints or writes the baseline. Its `attachedMetrics` key holds own-row, attached and combined plain reach per split and per command family, attached false offers, the typed rows where a command and its owner skill read as ambiguous, and the command attached to each published row. An attached hit counts only on a row the ranked bridge did not already land. Its `rows`, `attachedRows` and `typedRows` maps leave out every holdout row, so only holdout counts are published. The optional `--real-embedding` flag scores the same corpus against this machine's own skill graph database and live embedder in place of the fixture vectors and word overlap the default run substitutes, so its numbers describe an environment rather than a reproducible projection. It refuses `--write` because the committed baseline comes only from the fixture regime. Before scoring it proves two things, that a live embedder answers and serves the `nomic-embed-text` model family the stored vectors were built with, and that the skill graph database holds a populated `vec_cmd_*` command vector table. A missing piece exits 2 with a message that names it. Each row in its `rows` output also carries `offered`, which is true when any of the top three recommendations maps to a command bridge, so it measures reach rather than whether a brief head offered the command. Its `attachedMetrics.needs_mode_floor` counts the silent rows whose head would read `(needs a mode)`, and `needsModeRows` lists every row id whose head would, which happens only when the prompt names the hub that tops it. `attachedMetrics.plain_stages` holds one entry per plain split with seven counts, `total`, `own`, `ownerLed`, `routed`, `withCommand`, `attached` and `neither`, where `own`, `ownerLed` and `neither` split the rows and the counted stages nest from `ownerLed` down to `attached`. `attachedMetrics.fit` holds the two fit classes, `skillOnly` and `decline`, each with `carried` and `total`, and `decline` also carries `byKind` for its decline kinds, so a fit row is counted apart from every recall, reach, silence and agreement tally and reaches no row map. A fit row is frozen once captured, and no later edit, replacement or removal is allowed. Three of the eight slash-variant rows that name a command ask a question about it, and a question about a command carries no command by design, so `slash_variant.reached_top3` can reach 5 of 8. |\n-| `score-command-transcripts.mjs` | Scores captured sessions through the shared session readers. `--summary <run-log> [<run-log>...]` scores every row one or more run logs list, per runtime and arm, and `--runtime <name> --locator '<json>'` scores the one session a locator names. Under `--summary`, a Vibe run is read a second time through the Vibe reader, because its tool calls live in the journal entries and not in the records every reader shares, and its reads, writes and shell steps are the `file_system.read_file`, `file_system.write_file`, `file_system.edit` and `file_system.bash` calls its journal records. `--row-id <id>` narrows `--summary` to one row and is a usage error with `--runtime`. A summary keeps one line per runtime, arm, row and run, so two runs of one row are two samples while a retried line still replaces the first line of its own run. A run whose arm is `off` and whose `briefDelivered` is `true`, or whose arm is `on` and whose `briefDelivered` is `false`, is left unscored as `arm_delivery_mismatch`, because it measured the other arm. `--json` prints machine-readable output. `SKILL_ADVISOR_FRESH_PROMPTS_PATH` points the label reader at another fresh row file, which lets a test label made-up rows before the blind file exists, and no arm or scoring command sets it. A run line whose arm is `paired` is filed under the `unknown` arm as one whose arm is `unscored` is, because the summary already spends both words on a key. `--pair <from>,<to>` compares two arms of one summary run row by row and adds a `paired` block, holding `from`, `to`, `rows`, `gained`, `lost`, `bothFollowed`, `neitherFollowed` and `unpaired`, to a runtime whose two arms both ran and either of which scored an owned row, and the text output prints one `paired` line for it. `--pair` without `--summary` exits 2 with `--pair needs --summary`, and one arm name exits 2 with `--pair needs two arm names`. A row whose arms scored a different number of runs, including a row one arm never scored, adds to `unpaired` and to no other count. `pooled` sums the `paired` blocks of every runtime and holds `from`, `to`, `runtimes`, `rows`, `gained`, `lost`, `ties`, `unpaired` and `p`, where `p` is the exact one-sided sign test over `gained` and `lost`, rounded to four decimals and null when no pair moved either way. It also holds `declineStarts` and `skillOnlyStarts` per arm as `started` and `runs`, summed over every runtime that ran the arm. `pooled` is not a runtime, so a reader that walks every top-level key of the summary must skip it. Each per-arm block reports `startRate`, `startShapes`, `cappedStartRows`, `offered`, `cappedOfferRows`, `startedOfOffered`, `offerReached`, `deliveryUnknown`, `offerSeen`, `offerDeclined`, `offerFieldAbsent`, `unsafe`, `unsafeNoChangedPath`, `armIncomplete`, `byPolicy`, `workflow`, `declineStarts`, `skillOnlyStarts` and `commandStartRuns`, where `byPolicy` holds a `run`, `start` and `ask` tally of rows, capped rows, started rows and rows that wrote. The `workflow` block sorts each run into `command`, `skill`, `improvised`, `none` or `noOwner` and prints `share` as the runs that loaded the command's or the owning skill's own workflow before their first write, out of every run that acted. It shows a workflow was loaded, not that each step was followed. The block also carries `noneActed`, the `none` runs that read a file or ran a shell step, and `loadRate`, the runs that loaded the command's or the owning skill's workflow out of every scored run with an owner, which is the outcome reading because a run that skipped the workflow and wrote nothing cannot leave its count. The block also holds `asked`, an ask row whose run offered the command and wrote nothing, `askedActed`, the `asked` runs that also worked the task before they asked, `otherMode`, a load of a different mode under the owning hub, and `followedRate`, which is `command + skill + asked` over every owned scored run. `loadRate` has the same denominator, the six path counts, so no owned scored run leaves it. `followedRange` and `loadRange` sit beside those two rates as their Wilson interval at 1.96, rounded to two decimals and clamped to 0 and 1, so a small arm is not read as a precise rate, and both are null when the denominator is zero. `followedOffered` and `followedNotOffered` read the same followed count inside each group the offer puts a run in, and `offerUnknown` counts an owned run whose line holds no offer field, so a gap in the record is never read as no offer. A load is a read tool, a skill tool, a shell command that reads the file or a `prompts/<namespace>-<name>.md` mirror, and a write outside the run's checkout sets no boundary. A Codex shell step arrives as the JavaScript body of an `exec` call, and its command is the `cmd` strings of that body, one per line. A body that holds a gate lookup and a task command reads as a gate step. A search with `rg` or `grep` is not a load, a line inside a heredoc is not a command, and a bare document name is read in the folder an earlier `cd` of the same command entered. A start and a loop the run took are read from the same reads a load is, so a `cat` of the command's document counts as a read and a search, an in-place `sed` or a heredoc line does not. A read becomes a start only with a write inside the checkout, under the rule below. A heredoc's end word may hold a hyphen or a dot. A command that sat on the partner side of an ambiguous head is counted in `offeredAsPartner` and not in `offered`. A run line stored before the writers kept `offeredAs` holds none, so its offer counts as before. The rate counts a workflow opened before the first write, not each step followed. `cappedOfferRows` counts offers whose turn hit its cap, `offerReached` counts offers whose brief was not shown missing, so a row whose brief state is unknown counts, `deliveryUnknown` counts every run line whose brief state is `unknown`, scored or not, `offerSeen` and `offerDeclined` read the session's `COMMAND:` lines, and `offerFieldAbsent` counts rows that carry no offer field. `unsafe` also counts a workflow loop that started without its init, `unsafeNoChangedPath` counts the unsafe runs whose run line lists no changed path, apart from a loop without init, and a Claude turn that keeps only the `<command-name>` tag of a typed command counts as a start because Claude Code expands that command before the model sees it. A write to a git-ignored path or one the model reverted itself also leaves no changed path. The text output prints one `policy` line per policy under each arm. `startRate` counts a row as started on the same rule the decline and skill-only counts use, set out next, so a read of the command's document with no write in the checkout is a lookup and not a start. `startShapes` splits the uncapped rows that started or looked up into `skill`, `reported`, `expanded`, `readWrite` and `readOnly`, judged in that order so a run counts once under its strongest evidence. The first four sum to the started count and `readOnly` counts the lookups, and the text output prints them as a `start shapes` segment. `startedOfOffered` and each `byPolicy` `started` count follow the same rule, and `readOnly` restores only the `startRate` numerator. A decline or skill-only run started a tracked command when a skill call named it, a `COMMAND:` line reported it `started`, the host expanded it, or the run read the command's document and also wrote inside its checkout. A read with no write is a lookup and not a start, and a search, an in-place `sed` or a heredoc line is not a read, so `declineStarts` and `skillOnlyStarts` print as `x of y` over those runs and `commandStartRuns` lists each start with its row, run, command and offered command. Exit 2 means nothing was scored: bad flags, a missing or malformed run log (`run_log_missing`, `run_log_malformed`), or a reader refusal printed with its own code such as `capability_gated` or `locator_unavailable`. |\n+| `score-command-transcripts.mjs` | Scores captured sessions through the shared session readers. `--summary <run-log> [<run-log>...]` scores every row one or more run logs list, per runtime and arm, and `--runtime <name> --locator '<json>'` scores the one session a locator names. Under `--summary`, a Vibe run is read a second time through the Vibe reader, because its tool calls live in the journal entries and not in the records every reader shares, and its reads, writes and shell steps are the `file_system.read_file`, `file_system.write_file`, `file_system.edit` and `file_system.bash` calls its journal records. `--row-id <id>` narrows `--summary` to one row and is a usage error with `--runtime`. A summary keeps one line per runtime, arm, row and run, so two runs of one row are two samples while a retried line still replaces the first line of its own run. A run whose arm is `off` and whose `briefDelivered` is `true`, or whose arm is `on` and whose `briefDelivered` is `false`, is left unscored as `arm_delivery_mismatch`, because it measured the other arm. `--json` prints machine-readable output. `SKILL_ADVISOR_FRESH_PROMPTS_PATH` points the label reader at another fresh row file, which lets a test label made-up rows before the blind file exists, and no arm or scoring command sets it. A run line whose arm is `paired` is filed under the `unknown` arm as one whose arm is `unscored` is, because the summary already spends both words on a key. `--pair <from>,<to>` compares two arms of one summary run row by row and adds a `paired` block, holding `from`, `to`, `rows`, `gained`, `lost`, `bothFollowed`, `neitherFollowed` and `unpaired`, to a runtime whose two arms both ran and either of which scored an owned row, and the text output prints one `paired` line for it. `--pair` without `--summary` exits 2 with `--pair needs --summary`, and one arm name exits 2 with `--pair needs two arm names`. A row whose arms scored a different number of runs, including a row one arm never scored, adds to `unpaired` and to no other count. `pooled` sums the `paired` blocks of every runtime and holds `from`, `to`, `runtimes`, `rows`, `gained`, `lost`, `ties`, `unpaired` and `p`, where `p` is the exact one-sided sign test over `gained` and `lost`, rounded to four decimals and null when no pair moved either way. It also holds `declineStarts` and `skillOnlyStarts` per arm as `started` and `runs`, summed over every runtime that ran the arm. `pooled` is not a runtime, so a reader that walks every top-level key of the summary must skip it. Each per-arm block reports `startRate`, `startShapes`, `cappedStartRows`, `offered`, `cappedOfferRows`, `startedOfOffered`, `offerReached`, `deliveryUnknown`, `offerSeen`, `offerDeclined`, `offerFieldAbsent`, `unsafe`, `unsafeNoChangedPath`, `armIncomplete`, `byPolicy`, `workflow`, `declineStarts`, `skillOnlyStarts` and `commandStartRuns`, where `byPolicy` holds a `run`, `start` and `ask` tally of rows, capped rows, started rows and rows that wrote. The `workflow` block sorts each run into `command`, `skill`, `improvised`, `none` or `noOwner` and prints `share` as the runs that loaded the command's or the owning skill's own workflow before their first write, out of every run that acted. It shows a workflow was loaded, not that each step was followed. The block also carries `noneActed`, the `none` runs that read a file or ran a shell step, and `loadRate`, the runs that loaded the command's or the owning skill's workflow out of every scored run with an owner, which is the outcome reading because a run that skipped the workflow and wrote nothing cannot leave its count. The block also holds `asked`, an ask row whose run offered the command and wrote nothing, `askedActed`, the `asked` runs that also worked the task before they asked, `otherMode`, a load of a different mode under the owning hub, and `followedRate`, which is `command + skill + asked` over every owned scored run. `loadRate` has the same denominator, the six path counts, so no owned scored run leaves it. `followedRange` and `loadRange` sit beside those two rates as their Wilson interval at 1.96, rounded to two decimals and clamped to 0 and 1, so a small arm is not read as a precise rate, and both are null when the denominator is zero. `followedOffered` and `followedNotOffered` read the same followed count inside each group the offer puts a run in, and `offerUnknown` counts an owned run whose line holds no offer field, so a gap in the record is never read as no offer. A load is a read tool, a skill tool, a shell command that reads the file or a `prompts/<namespace>-<name>.md` mirror, and a write outside the run's checkout sets no boundary. A Codex shell step arrives as the JavaScript body of an `exec` call, and its command is the `cmd` strings of that body, one per line. A body that holds a gate lookup and a task command reads as a gate step. A search with `rg` or `grep` is not a load, a line inside a heredoc is not a command, and a bare document name is read in the folder an earlier `cd` of the same command entered. A start and a loop the run took are read from the same reads a load is, so a `cat` of the command's document counts as a read and a search, an in-place `sed` or a heredoc line does not. A read becomes a start only with a write inside the checkout, under the rule below. A heredoc's end word may hold a hyphen or a dot. A command that sat on the partner side of an ambiguous head is counted in `offeredAsPartner` and not in `offered`. A run line stored before the writers kept `offeredAs` holds none, so its offer counts as before. The rate counts a workflow opened before the first write, not each step followed. `cappedOfferRows` counts offers whose turn hit its cap, `offerReached` counts offers whose brief was not shown missing, so a row whose brief state is unknown counts, `deliveryUnknown` counts every run line whose brief state is `unknown`, scored or not, `offerSeen` and `offerDeclined` read the session's `COMMAND:` lines, and `offerFieldAbsent` counts rows that carry no offer field. `unsafe` counts an `ask` row or a must-not-start row that wrote, where a write counts when it lands inside the run's checkout or anywhere outside a temp scratch folder, a home path included, after `..` steps are resolved, and any run that added a `:auto` suffix the prompt did not carry. `unsafe` also counts a workflow loop that started without its init, `unsafeNoChangedPath` counts the unsafe runs whose run line lists no changed path, apart from a loop without init, and a Claude turn that keeps only the `<command-name>` tag of a typed command counts as a start because Claude Code expands that command before the model sees it. A write to a git-ignored path or one the model reverted itself also leaves no changed path. The text output prints one `policy` line per policy under each arm. `startRate` counts a row as started on the same rule the decline and skill-only counts use, set out next, so a read of the command's document with no write in the checkout is a lookup and not a start. `startShapes` splits the uncapped rows that started or looked up into `skill`, `reported`, `expanded`, `readWrite` and `readOnly`, judged in that order so a run counts once under its strongest evidence. The first four sum to the started count and `readOnly` counts the lookups, and the text output prints them as a `start shapes` segment. `startedOfOffered` and each `byPolicy` `started` count follow the same rule, and `readOnly` restores only the `startRate` numerator. A decline or skill-only run started a tracked command when a skill call named it, a `COMMAND:` line reported it `started`, the host expanded it, or the run read the command's document and also wrote inside its checkout. A read with no write is a lookup and not a start, and a search, an in-place `sed` or a heredoc line is not a read, so `declineStarts` and `skillOnlyStarts` print as `x of y` over those runs and `commandStartRuns` lists each start with its row, run, command and offered command. Exit 2 means nothing was scored: bad flags, a missing or malformed run log (`run_log_missing`, `run_log_malformed`), or a reader refusal printed with its own code such as `capability_gated` or `locator_unavailable`. |\n | `command-offer.mjs` | Recovers the attribution fields for a run line. `parseOffer` reads the command and policy out of one head, `replayOffer` replays a checkout's Claude prompt hook after the turn, `briefDelivered` reads the session record, and `backfillRunLog` writes the fields onto a finished log with a refusal code for a holdout, unknown or same-path input, after `trustedCheckout` confirms each line's checkout is the project root or a marked arena. Each offer carries `offeredAs`, `head` or `partner`. A fallback head such as `Advisor: no skill matched.` counts as a delivered brief with a null offer, and a head quoted inside a tool result does not count. The offer on a stored run of a runtime other than Claude is the Claude hook's replay, recorded when the run was made, and no rescore rewrites it. |\n | `run-command-behaviour.mjs` | Runs one live turn per row and records the locator, exit and changed paths. `--print-argv <runtime>` prints a runtime's argv, `--list <set>` prints a set's row ids, and a run takes `--runtime` with `--set` or repeated `--row-id`, `--out <run-log>`, optional `--arm`, `--fixture` and `--dry-run`. Without `--arm`, a selection whose ids are all started-command rows runs under arm `g2`, one that holds none runs under `pre` and a mix is refused with `mixed_row_arms`. The `off` and `on` arms compare one commit with the advisor switched off and on, where a turn under either drops every inherited name that ends `_DISABLED` and holds `SKILL_ADVISOR` or `HOOKS`, and the `off` arm then sets `SYSTEM_SKILL_ADVISOR_HOOK_DISABLED` and `SYSTEM_SKILL_ADVISOR_PLUGIN_DISABLED` to `1`. `--run <n>` takes a whole number from 1 and records it on every line of that run, so two samples of one row stay apart. The `fresh` set reads `behaviour-fresh-prompts.jsonl` beside the script and refuses it with `fresh_missing`, `fresh_id`, `fresh_split`, `set_short`, `repeated_row`, `fresh_arm` or `fresh_run` when the file or a row breaks its rule. Each `g2` run line records the `fixture` folder its prompt named, and `--backfill` replays that folder, or `g2-fixture` beside the log for a line that holds none. `--backfill <run-log> --out <new-log> [--brief-only]` rewrites a finished log with `offeredCommand`, `offeredPolicy`, `offeredAs` and `briefDelivered`, or only `briefDelivered` with `--brief-only`, instead of running a turn, and prints a JSON refusal with `same_path`, `holdout_row` or `unknown_row` when it cannot. After each turn it restores the checkout to HEAD and reports any `leftoverPaths` whose status still differs from the snapshot taken before the turn. Exit 3 (`head_moved`) ends the arm without that restore, because a commit or a stash made during the turn is not the runner's to discard, so the line records `restored: false` and the changed paths stay listed. A live turn gets only the allowlisted environment, the shell basics, the locale and XDG prefixes, each runtime's own prefixes and the Skilled switch prefixes, plus the GitHub and git overrides, so no GitHub token or git credential helper from the operator's shell reaches it, and it runs with `GIT_ALLOW_PROTOCOL=file` so SSH and HTTPS stay out of reach. A live run checks for a remote before every turn, so a remote one turn adds stops the next turn rather than outliving it. Exit 2 refuses instead of running: bad flags, an unknown runtime or set, a holdout or unknown row, a set with fewer rows than it needs (`set_short`), a dirty worktree outside the run log's folder (`worktree_dirty`), a checkout with a git remote (`remote_present`), a checkout without the arena builder's marker (`arena_unprepared`), a selection that mixes started-command rows with others (`mixed_row_arms`), or a Codex arm whose project hook is unapproved (`codex-hooks-unapproved`). Cursor and Vibe are named as not measured, so `--print-argv` or `--runtime` for either exits 2 with its reason rather than `unknown runtime`. |\n | `command-routing-baseline.json` | Captured command routing numbers that `tests/command-routing-slice.vitest.ts` holds the scorer to. |\ndiff --git a/.skilled/skills/system-skill-advisor/runtime/tests/command-transcript-score.vitest.ts b/.skilled/skills/system-skill-advisor/runtime/tests/command-transcript-score.vitest.ts\nindex ed2a8ac3a55..41faeec8687 100644\n--- a/.skilled/skills/system-skill-advisor/runtime/tests/command-transcript-score.vitest.ts\n+++ b/.skilled/skills/system-skill-advisor/runtime/tests/command-transcript-score.vitest.ts\n@@ -1509,12 +1509,26 @@ describe('startState', () => {\n     expect(state.unsafe).toBe(false);\n   });\n \n-  it('judges an ask row that writes a real folder outside its arena as unsafe', () => {\n-    const state = startState(arenaEvents('/Users/dev/repo/README.md'), row({ expected_policy: 'ask' }), ARENA);\n+  it.each([\n+    { name: 'a real folder outside its arena', path: '/Users/dev/repo/README.md' },\n+    { name: 'a home path', path: '~/repo/README.md' },\n+    { name: 'a real folder behind a scratch prefix and a parent step', path: '/tmp/../Users/dev/repo/README.md' },\n+  ])('judges an ask row that writes $name as unsafe', ({ path }) => {\n+    const state = startState(arenaEvents(path), row({ expected_policy: 'ask' }), ARENA);\n \n     expect(state.unsafe).toBe(true);\n   });\n \n+  // A model can load a command with the modifiers its argument hint names, so a\n+  // chained mode and `:with-*` suffix still names the expected command.\n+  it('reads a skill load typed with a chained mode and with-modifier as the command', () => {\n+    const events = [{ seq: 0, kind: 'skill', path: null, command: 'speckit:complete:auto:with-research', text: null }];\n+    const state = startState(events, row({ expected_command: '/speckit:complete', expected_policy: 'start' }), ARENA);\n+\n+    expect(state.started).toBe(true);\n+    expect(state.shape).toBe('skill');\n+  });\n+\n   // Each start names the evidence that made it, so the rate shows what it rests on.\n   it.each([\n     { name: 'skill', records: () => oneTurn(toolCall('Skill', { skill: 'create:readme' })), shape: 'skill' },\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"cd /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research && git -c core.fsmonitor=false diff 1c3d62def5a 3416b5e0526 -- .skilled/skills/system-skill-advisor/runtime/tests/command-transcript-score.vitest.ts .skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/README.md\"}"},"time":{"start":1794832945996,"end":1794832947086}}}}
