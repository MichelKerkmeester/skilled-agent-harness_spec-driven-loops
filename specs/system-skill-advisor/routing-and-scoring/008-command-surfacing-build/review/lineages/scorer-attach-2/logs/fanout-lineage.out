.shadowOnly,\n271:       evidenceTypes: Array.from(new Set(lane.evidence.map((entry) => evidenceFeature(entry)))),\n272:       evidenceCount: lane.evidence.length,\n273:     })),\n274:     matchedSkillFeatures,\n275:   };\n276: }\n277: \n278: // Doc evidence entries are skill-relative markdown paths emitted by the\n279: // derived lane as `doc:<path>`. The allowlist rejects anything that\n280: // could smuggle prompt content or path traversal into the response.\n281: const SAFE_DOC_PATH = /^(references|assets)\\/[A-Za-z0-9_./-]+\\.md$/;\n282: \n283: export function matchedDocsFromContributions(\n284:   recommendation: { readonly laneContributions: ReadonlyArray<{ readonly evidence: readonly string[] }> },\n285: ): string[] {\n286:   const docs: string[] = [];\n287:   for (const lane of recommendation.laneContributions) {\n288:     for (const entry of lane.evidence) {\n289:       if (!entry.startsWith('doc:')) continue;\n290:       const path = entry.slice(4);\n291:       if (!SAFE_DOC_PATH.test(path) || path.includes('..')) continue;\n292:       if (!docs.includes(path)) docs.push(path);\n293:       if (docs.length >= 3) return docs;\n294:     }\n295:   }\n296:   return docs;\n297: }\n298: \n299: function workflowModeForRecommendation(\n300:   recommendation: ScoredRecommendation,\n301:   prompt: string,\n302: ): string | undefined {\n303:   const directMode = modeForAlias(recommendation.skill);\n304:   const promptMode = recommendation.skill === MERGED_DEEP_SKILL_ID\n305:     ? modeForPromptAlias(prompt)\n306:     : null;\n307:   const workflowMode = sanitizeSkillLabel(directMode ?? promptMode ?? '');\n308:   return workflowMode || undefined;\n309: }\n310: \n311: function publicRecommendation(\n312:   recommendation: ScoredRecommendation,\n313:   includeAttribution: boolean,\n314:   prompt: string,\n315: ) {\n316:   const skillId = sanitizeSkillLabel(recommendation.skill);\n317:   if (!skillId) return null;\n318:   const commandRow = commandRowFor(recommendation.skill);\n319:   const matchedDocs = matchedDocsFromContributions(recommendation);\n320:   const redirectFrom = safeMany(recommendation.redirectFrom);\n321:   const redirectTo = sanitizeSkillLabel(recommendation.redirectTo ?? '');\n322:   const heldBelow = sanitizeSkillLabel(recommendation.heldBelow ?? '');\n323:   const sanitizedStatus = sanitizeSkillLabel(recommendation.lifecycleStatus);\n324:   const status: PublicRecommendationStatus | undefined = sanitizedStatus === 'active'\n325:     || sanitizedStatus === 'deprecated'\n326:     || sanitizedStatus === 'archived'\n327:     || sanitizedStatus === 'future'\n328:     ? sanitizedStatus as PublicRecommendationStatus\n329:     : undefined;\n330:   const workflowMode = workflowModeForRecommendation(recommendation, prompt);\n331:   return {\n332:     skillId,\n333:     kind: recommendation.kind,\n334:     score: recommendation.score,\n335:     confidence: recommendation.confidence,\n336:     uncertainty: recommendation.uncertainty,\n337:     dominantLane: recommendation.dominantLane,\n338:     ...(includeAttribution ? {\n339:       laneBreakdown: recommendation.laneContributions.map((lane) => ({\n340:         lane: lane.lane,\n341:         rawScore: lane.rawScore,\n342:         weightedScore: lane.weightedScore,\n343:         weight: lane.weight,\n344:         shadowOnly: lane.shadowOnly,\n345:       })),\n346:       why_recommended: publicWhyRecommended(recommendation),\n347:     } : {}),\n348:     ...(matchedDocs.length > 0 ? { matchedDocs } : {}),\n349:     ...(redirectFrom.length > 0 ? { redirectFrom } : {}),\n350:     ...(redirectTo ? { redirectTo } : {}),\n351:     // Hook briefs re-derive ambiguity from the public list, so a skill the typed\n352:     // command already ranked below its seed has to say so here.\n353:     ...(heldBelow ? { heldBelow } : {}),\n354:     ...(status ? { status } : {}),\n355:     ...(workflowMode ? { workflowMode } : {}),\n356:     // A command row is the contract a reader acts on, so its