),\n377:   // Run a read-only SQLite quick_check on the artifact so genuine corruption\n378:   // downgrades freshness to stale (and advisor_rebuild repairs it). Off by\n379:   // default so the read-style advisor_recommend path pays no per-call probe;\n380:   // the advisor_status diagnostic and advisor_rebuild pre-read opt in.\n381:   checkArtifactIntegrity: z.boolean().optional(),\n382:   debug: z.boolean().optional(),\n383: }).strict();\n384: \n385: const embeddingsHealthSchema = z.object({\n386:   checkedAt: z.string().datetime(),\n387:   provider: z.discriminatedUnion('state', [\n388:     z.object({\n389:       state: z.literal('resolved'),\n390:       requestedProvider: z.string(),\n391:       effectiveProvider: z.string(),\n392:       fallbackReason: z.string().nullable(),\n393:       dimensionChanged: z.boolean(),\n394:       reason: z.string(),\n395:     }).strict(),\n396:     z.object({\n397:       state: z.literal('unavailable'),\n398:       error: z.string().max(200),\n399:     }).strict(),\n400:   ]),\n401:   modelServer: z.discriminatedUnion('state', [\n402:     z.object({\n403:       state: z.literal('reachable'),\n404:       target: z.string().min(1),\n405:       serverState: z.string().nullable(),\n406:       model: z.string().nullable(),\n407:       dim: z.number().nullable(),\n408:       device: z.string().nullable(),\n409:       loadTimeMs: z.number().nullable(),\n410:       loadStartedAt: z.string().nullable(),\n411:       loadProgressAt: z.string().nullable(),\n412:       lastSuccessfulEmbedAt: z.string().nullable(),\n413:       inFlight: z.number().nullable(),\n414:       queueDepth: z.number().nullable(),\n415:       error: z.string().nullable(),\n416:     }).strict(),\n417:     z.object({\n418:       state: z.literal('unavailable'),\n419:       target: z.string().min(1),\n[Output truncated. Continue reading with offset: 420]"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"limit\": 120, \"offset\": 300