,\n    convergencePolicyVersion: \"convergence-policy@\" + ((config.antiConvergence && config.antiConvergence.convergenceMode) || \"default\"),\n    reviewModeContractDigest: sha(fs.readFileSync(workflowPath)),\n    initialReleaseReadinessState: \"not-assessed\",\n    ...(topic === null ? {} : { topic }),\n  },\n}));\n' \"$RUN_DIR/deep-review-config.json\" \".skilled/commands/deep/assets/deep-review-auto.yaml\" > \"$EVENT_FILE\" && node \"$GATEWAY\" --mode review --run-directory \"$RUN_DIR\" --event-json \"$EVENT_FILE\"; STATUS=$?; rm -f \"$EVENT_FILE\"; echo \"EXIT:$STATUS\""},"output":"{\"ok\":true,\"receipt\":{\"ledger_id\":\"deep-review-ledger\",\"sequence\":1,\"event_id\":\"event-29be9454-022d-4142-9b07-c61bd9746625\",\"event_type\":\"deep-review.ledger.run-initialized\",\"event_version\":1,\"stream_id\":\"deep-review-ledger\",\"stream_sequence\":1,\"committed_at\":\"2026-11-13T11:45:46.547Z\",\"canonicalEventHash\":\"1b427ecce2eb37e3beda94b5c63c230943370f68493b1ee7f7005618d3bbf601\",\"recordHash\":\"03b2d1f421627eb5d353d89da43031842557e2cd63a131fedba1c44c647a0201\",\"authorizationRef\":{\"audit_ledger_id\":\"deep-review-audit-ledger\",\"audit_sequence\":2,\"audit_record_hash\":\"a1f532fc67c6d8babc3cb6d41d370fd298c79499e1f98eeb183862300e863283\",\"decision_id\":\"decision-ce2c027c-f562-45a3-8414-bb195490e8e8\",\"decision_digest\":\"40a92dba74f6f2f0bdaaaab909b2bf95f3c64c9847cf9b323ad127a1dc267f7f\",\"request_digest\":\"b8f2bee843e63946119e5ecf44e1e3d055cca5bc58b8cd48107d10fc1824e474\",\"policy_digest\":\"883e5d03486b26c23ecdb48a893d8b0db0d8e2e7125e0847705bfd4a2b1a4500\",\"authority_epoch\":1,\"fence_token\":1},\"ledgerId\":\"deep-review-ledger\",\"eventId\":\"event-29be9454-022d-4142-9b07-c61bd9746625\",\"eventType\":\"deep-review.ledger.run-initialized\",\"eventVersion\":1,\"streamId\":\"deep-review-ledger\",\"streamSequence\":1,\"committedAt\":\"2026-11-13T11:45:46.547Z\"},\"projectionRefreshed\":true,\"projectionError\":null}\nEXIT:0\n","title":"shell","metad