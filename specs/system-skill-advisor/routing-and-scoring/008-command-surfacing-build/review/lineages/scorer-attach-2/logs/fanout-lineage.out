{"type":"tool_use","timestamp":1794571113709,"sessionID":"ses_e2b4a23c4ffeXM7ei3r7kNeMRl","part":{"partID":"prt_1d4c613a20026QBuR0Tc22TlG1","sessionID":"ses_e2b4a23c4ffeXM7ei3r7kNeMRl","messageID":"msg_1d4c60205001i7igsZKPQjR6hK","type":"tool","id":"chatcmpl-tool-a910a0fc1ffbc608","tool":"read","state":{"status":"completed","input":{"limit":200,"offset":540,"path":".skilled/skills/system-skill-advisor/runtime/handlers/advisor-recommend.ts"},"output":"Read file .skilled/skills/system-skill-advisor/runtime/handlers/advisor-recommend.ts, lines 540-737\n540: }\n541: \n542: function roundScore(value: number): number {\n543:   return Math.round(value * 1_000_000) / 1_000_000;\n544: }\n545: \n546: // A semantic lane that fell back to phrase scoring still answers, so the reason\n547: // it declined travels as a warning rather than changing the recommendation.\n548: export function semanticLaneOffWarning(reason: string | null): string[] {\n549:   return reason ? [`semantic_lane_off:${reason}`] : [];\n550: }\n551: \n552: function outputWarnings(\n553:   status: AdvisorStatus,\n554:   result: ReturnType<typeof scoreAdvisorPrompt>,\n555:   semanticLaneOffReason: string | null,\n556: ): string[] {\n557:   const degradedLanes = result.metrics.degradedLanes ?? [];\n558:   return [\n559:     ...(status.freshness === 'stale' ? [status.trustState.reason ?? 'STALE_ADVISOR_FRESHNESS'] : []),\n560:     ...(degradedLanes.length > 0\n561:       ? [`runtime_degraded_lanes:${degradedLanes.join(',')}`]\n562:       : []),\n563:     ...semanticLaneOffWarning(semanticLaneOffReason),\n564:   ];\n565: }\n566: \n567: function outputAbstainReasons(\n568:   input: AdvisorRecommendInput,\n569:   result: ReturnType<typeof scoreAdvisorPrompt>,\n570: ): string[] {\n571:   if (!input.options?.includeAbstainReasons) return [];\n572:   return [\n573:     ...(result.unknown ? ['No recommendation passed confidence and uncertainty thresholds.'] : []),\n574:     ...(result.abstainReasons ?? []),\n575:   ];\n576: }\n577: \n578: // ───────────────────────────────────────────────────────────────────\n579: // 4. CORE LOGIC\n580: // ───────────────────────────────────────────────────────────────────\n581: \n582: async function computeRecommendationOutput(input: AdvisorRecommendInput): Promise<AdvisorRecommendOutput> {\n583:   // Canonicalize via realpath after the schema allowlist check.\n584:   const workspaceRoot = input.workspaceRoot\n585:     ? canonicalizeWorkspaceRoot(input.workspaceRoot)\n586:     : findWorkspaceRoot();\n587:   const effectiveThresholds = publicThresholds({\n588:     confidenceThreshold: input.options?.confidenceThreshold,\n589:     uncertaintyThreshold: input.options?.uncertaintyThreshold,\n590:   });\n591:   // Detect on-disk corruption here too: without it a malformed artifact reads\n592:   // 'live' from the generation counters and the recommend path would serve\n593:   // results as fresh. The verdict is cached per generation, so the quick_check\n594:   // runs at most once per rebuild rather than on every recommendation.\n595:   const status = renderableStatus(readAdvisorStatus({ workspaceRoot, checkArtifactIntegrity: true }));\n596:   if (status.freshness === 'unavailable') {\n597:     return unavailableOutput(status, workspaceRoot, effectiveThresholds);\n598:   }\n599:   if (status.freshness === 'absent') {\n600:     return absentOutput(status, workspaceRoot, effectiveThresholds);\n601:   }\n602:   const sourceSignature = cacheSourceSignature(status);\n603:   advisorPromptCache.invalidateSourceSignatureChange(sourceSignature);\n604:   const key = advisorPromptCache.makeKey({\n605:     canonicalPrompt: input.prompt.trim(),\n606:     sourceSignature,\n607:     workspaceRoot,\n608:     runtime: 'mcp',\n609:     maxTokens: input.options?.topK,\n610:     thresholdConfig: {\n611:       confidenceThreshold: input.options?.confidenceThreshold,\n612:       uncertaintyThreshold: input.options?.uncertaintyThreshold,\n613:       includeAttribution: input.options?.includeAttribution,\n614:       includeAbstainReasons: input.options?.includeAbstainReasons,\n615:     },\n616:   });\n617:   const cached = advisorPromptCache.get(key);\n618:   if (cached) {\n619:     const cachedOutput = cached.value as AdvisorRecommendOutput;\n620:     const parsedCachedOutput = AdvisorRecommendOutputSchema.parse({\n621:       ...cachedOutput,\n622:       workspaceRoot,\n623:       effectiveThresholds,\n624:       cache: {\n625:         ...cachedOutput.cache,\n626:         hit: true,\n627:       },\n628:     });\n629:     return attachTypedCommand(\n630:       input.options?.includeCompiledRoute === false\n631:         ? parsedCachedOutput\n632:         : enrichCompiledRoutes(parsedCachedOutput, input.prompt, workspaceRoot, input.options?.surfaceHint, input.options?.compiledRouteTopOnly === true),\n633:       input.prompt,\n634:     );\n635:   }\n636: \n637:   const topK = input.options?.topK ?? 3;\n638:   const result = await withSemanticShadowPromptEmbedding(input.prompt, () => scoreAdvisorPrompt(input.prompt, {\n639:     workspaceRoot,\n640:     confidenceThreshold: input.options?.confidenceThreshold,\n641:     uncertaintyThreshold: input.options?.uncertaintyThreshold,\n642:     runtimeLaneHealth: runtimeLaneHealthForStatus(status),\n643:   }));\n644:   // The lane records its health while the scored call runs, so the reason is\n645:   // read right after that call settles to describe this call's own fallback.\n646:   const semanticLaneOffReason = getSemanticShadowRuntimeHealth().disabledReason;\n647:   const recommendations = result.recommendations\n648:     .map((recommendation) => publicRecommendation(\n649:       recommendation,\n650:       Boolean(input.options?.includeAttribution),\n651:       input.prompt,\n652:     ))\n653:     .filter((recommendation): recommendation is NonNullable<typeof recommendation> => Boolean(recommendation))\n654:     .slice(0, topK);\n655:   const degradedLanes = result.metrics.degradedLanes ?? [];\n656:   const warnings = outputWarnings(status, result, semanticLaneOffReason);\n657:   const abstainReasons = outputAbstainReasons(input, result);\n658:   const output: AdvisorRecommendOutput = {\n659:     workspaceRoot,\n660:     effectiveThresholds,\n661:     recommendations,\n662:     ambiguous: result.ambiguous,\n663:     freshness: status.freshness,\n664:     trustState: status.trustState,\n665:     generatedAt: new Date().toISOString(),\n666:     cache: {\n667:       hit: false,\n668:       sourceSignaturePresent: status.generation > 0 || status.lastGenerationBump !== null,\n669:     },\n670:     _shadow: {\n671:       model: 'advisor-shadow-learned-weights-v1',\n672:       liveWeightsFrozen: true,\n673:       recommendations: publicShadowRecommendations(result.recommendations, topK),\n674:     },\n675:     ...(degradedLanes.length > 0 ? {\n676:       runtimeLaneHealth: {\n677:         liveLaneCount: result.metrics.liveLaneCount,\n678:         degradedLanes: [...degradedLanes],\n679:       },\n680:     } : {}),\n681:     ...(warnings.length > 0 ? { warnings } : {}),\n682:     ...(abstainReasons.length > 0 ? { abstainReasons } : {}),\n683:   };\n684:   const parsed = AdvisorRecommendOutputSchema.parse(output);\n685:   if (shadowDeltaSinkEnabled()) {\n686:     for (const shadow of parsed._shadow?.recommendations ?? []) {\n687:       recordShadowDelta({\n688:         prompt: `hmac:${key}`,\n689:         recommendation: shadow.skillId,\n690:         liveScore: shadow.liveScore,\n691:         shadowScore: shadow.shadowScore,\n692:         delta: shadow.delta,\n693:         dominantLane: shadow.dominantShadowLane,\n694:         timestamp: parsed.generatedAt,\n695:       });\n696:     }\n697:   }\n698:   advisorPromptCache.set({\n699:     key,\n700:     sourceSignature,\n701:     value: parsed,\n702:     skillLabels: recommendationLabels(parsed),\n703:   });\n704:   return attachTypedCommand(\n705:     input.options?.includeCompiledRoute === false\n706:       ? parsed\n707:       : enrichCompiledRoutes(parsed, input.prompt, workspaceRoot, input.options?.surfaceHint, input.options?.compiledRouteTopOnly === true),\n708:     input.prompt,\n709:   );\n710: }\n711: \n712: // ───────────────────────────────────────────────────────────────────\n713: // 5. EXPORTS\n714: // ───────────────────────────────────────────────────────────────────\n715: \n716: export async function handleAdvisorRecommend(args: unknown): Promise<HandlerResponse> {\n717:   const input = AdvisorRecommendInputSchema.parse(args);\n718:   // Canonicalize via realpath after the schema allowlist check.\n719:   const workspaceRoot = input.workspaceRoot\n720:     ? canonicalizeWorkspaceRoot(input.workspaceRoot)\n721:     : findWorkspaceRoot();\n722:   const effectiveThresholds = publicThresholds({\n723:     confidenceThreshold: input.options?.confidenceThreshold,\n724:     uncertaintyThreshold: input.options?.uncertaintyThreshold,\n725:   });\n726:   const disabledBy = ADVISOR_DISABLED_FLAGS.find((flag) => process.env[flag] === '1');\n727:   const data = disabledBy\n728:     ? disabledOutput(workspaceRoot, effectiveThresholds, disabledBy)\n729:     : await computeRecommendationOutput(input);\n730:   return {\n731:     content: [{\n732:       type: 'text',\n733:       text: JSON.stringify({ status: 'ok', data }, null, 2),\n734:     }],\n735:   };\n736: }\n737: ","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file .skilled/skills/system-skill-advisor/runtime/handlers/advisor-recommend.ts, lines 540-737\n540: }\n541: \n542: function roundScore(value: number): number {\n543:   return Math.round(value * 1_000_000) / 1_000_000;\n544: }\n545: \n546: // A semantic lane that fell back to phrase scoring still answers, so the reason\n547: // it declined travels as a warning rather than changing the recommendation.\n548: export function semanticLaneOffWarning(reason: string | null): string[] {\n549:   return reason ? [`semantic_lane_off:${reason}`] : [];\n550: }\n551: \n552: function outputWarnings(\n553:   status: AdvisorStatus,\n554:   result: ReturnType<typeof scoreAdvisorPrompt>,\n555:   semanticLaneOffReason: string | null,\n556: ): string[] {\n557:   const degradedLanes = result.metrics.degradedLanes ?? [];\n558:   return [\n559:     ...(status.freshness === 'stale' ? [status.trustState.reason ?? 'STALE_ADVISOR_FRESHNESS'] : []),\n560:     ...(degradedLanes.length > 0\n561:       ? [`runtime_degraded_lanes:${degradedLanes.join(',')}`]\n562:       : []),\n563:     ...semanticLaneOffWarning(semanticLaneOffReason),\n564:   ];\n565: }\n566: \n567: function outputAbstainReasons(\n568:   input: AdvisorRecommendInput,\n569:   result: ReturnType<typeof scoreAdvisorPrompt>,\n570: ): string[] {\n571:   if (!input.options?.includeAbstainReasons) return [];\n572:   return [\n573:     ...(result.unknown ? ['No recommendation passed confidence and uncertainty thresholds.'] : []),\n574:     ...(result.abstainReasons ?? []),\n575:   ];\n576: }\n577: \n578: // ───────────────────────────────────────────────────────────────────\n579: // 4. CORE LOGIC\n580: // ───────────────────────────────────────────────────────────────────\n581: \n582: async function computeRecommendationOutput(input: AdvisorRecommendInput): Promise<AdvisorRecommendOutput> {\n583:   // Canonicalize via realpath after the schema allowlist check.\n584:   const workspaceRoot = input.workspaceRoot\n585:     ? canonicalizeWorkspaceRoot(input.workspaceRoot)\n586:     : findWorkspaceRoot();\n587:   const effectiveThresholds = publicThresholds({\n588:     confidenceThreshold: input.options?.confidenceThreshold,\n589:     uncertaintyThreshold: input.options?.uncertaintyThreshold,\n590:   });\n591:   // Detect on-disk corruption here too: without it a malformed artifact reads\n592:   // 'live' from the generation counters and the recommend path would serve\n593:   // results as fresh. The verdict is cached per generation, so the quick_check\n594:   // runs at most once per rebuild rather than on every recommendation.\n595:   const status = renderableStatus(readAdvisorStatus({ workspaceRoot, checkArtifactIntegrity: true }));\n596:   if (status.freshness === 'unavailable') {\n597:     return unavailableOutput(status, workspaceRoot, effectiveThresholds);\n598:   }\n599:   if (status.freshness === 'absent') {\n600:     return absentOutput(status, workspaceRoot, effectiveThresholds);\n601:   }\n602:   const sourceSignature = cacheSourceSignature(status);\n603:   advisorPromptCache.invalidateSourceSignatureChange(sourceSignature);\n604:   const key = advisorPromptCache.makeKey({\n605:     canonicalPrompt: input.prompt.trim(),\n606:     sourceSignature,\n607:     workspaceRoot,\n608:     runtime: 'mcp',\n609:     maxTokens: input.options?.topK,\n610:     thresholdConfig: {\n611:       confidenceThreshold: input.options?.confidenceThreshold,\n612:       uncertaintyThreshold: input.options?.uncertaintyThreshold,\n613:       includeAttribution: input.options?.includeAttribution,\n614:       includeAbstainReasons: input.options?.includeAbstainReasons,\n615:     },\n616:   });\n617:   const cached = advisorPromptCache.get(key);\n618:   if (cached) {\n619:     const cachedOutput = cached.value as AdvisorRecommendOutput;\n620:     const parsedCachedOutput = AdvisorRecommendOutputSchema.parse({\n621:       ...cachedOutput,\n622:       workspaceRoot,\n623:       effectiveThresholds,\n624:       cache: {\n625:         ...cachedOutput.cache,\n626:         hit: true,\n627:       },\n628:     });\n629:     return attachTypedCommand(\n630:       input.options?.includeCompiledRoute === false\n631:         ? parsedCachedOutput\n632:         : enrichCompiledRoutes(parsedCachedOutput, input.prompt, workspaceRoot, input.options?.surfaceHint, input.options?.compiledRouteTopOnly === true),\n633:       input.prompt,\n634:     );\n635:   }\n636: \n637:   const topK = input.options?.topK ?? 3;\n638:   const result = await withSemanticShadowPromptEmbedding(input.prompt, () => scoreAdvisorPrompt(input.prompt, {\n639:     workspaceRoot,\n640:     confidenceThreshold: input.options?.confidenceThreshold,\n641:     uncertaintyThreshold: input.options?.uncertaintyThreshold,\n642:     runtimeLaneHealth: runtimeLaneHealthForStatus(status),\n643:   }));\n644:   // The lane records its health while the scored call runs, so the reason is\n645:   // read right after that call settles to describe this call's own fallback.\n646:   const semanticLaneOffReason = getSemanticShadowRuntimeHealth().disabledReason;\n647:   const recommendations = result.recommendations\n648:     .map((recommendation) => publicRecommendation(\n649:       recommendation,\n650:       Boolean(input.options?.includeAttribution),\n651:       input.prompt,\n652:     ))\n653:     .filter((recommendation): recommendation is NonNullable<typeof recommendation> => Boolean(recommendation))\n654:     .slice(0, topK);\n655:   const degradedLanes = result.metrics.degradedLanes ?? [];\n656:   const warnings = outputWarnings(status, result, semanticLaneOffReason);\n657:   const abstainReasons = outputAbstainReasons(input, result);\n658:   const output: AdvisorRecommendOutput = {\n659:     workspaceRoot,\n660:     effectiveThresholds,\n661:     recommendations,\n662:     ambiguous: result.ambiguous,\n663:     freshness: status.freshness,\n664:     trustState: status.trustState,\n665:     generatedAt: new Date().toISOString(),\n666:     cache: {\n667:       hit: false,\n668:       sourceSignaturePresent: status.generation > 0 || status.lastGenerationBump !== null,\n669:     },\n670:     _shadow: {\n671:       model: 'advisor-shadow-learned-weights-v1',\n672:       liveWeightsFrozen: true,\n673:       recommendations: publicShadowRecommendations(result.recommendations, topK),\n674:     },\n675:     ...(degradedLanes.length > 0 ? {\n676:       runtimeLaneHealth: {\n677:         liveLaneCount: result.metrics.liveLaneCount,\n678:         degradedLanes: [...degradedLanes],\n679:       },\n680:     } : {}),\n681:     ...(warnings.length > 0 ? { warnings } : {}),\n682:     ...(abstainReasons.length > 0 ? { abstainReasons } : {}),\n683:   };\n684:   const parsed = AdvisorRecommendOutputSchema.parse(output);\n685:   if (shadowDeltaSinkEnabled()) {\n686:     for (const shadow of parsed._shadow?.recommendations ?? []) {\n687:       recordShadowDelta({\n688:         prompt: `hmac:${key}`,\n689:         recommendation: shadow.skillId,\n690:         liveScore: shadow.liveScore,\n691:         shadowScore: shadow.shadowScore,\n692:         delta: shadow.delta,\n693:         dominantLane: shadow.dominantShadowLane,\n694:         timestamp: parsed.generatedAt,\n695:       });\n696:     }\n697:   }\n698:   advisorPromptCache.set({\n699:     key,\n700:     sourceSignature,\n701:     value: parsed,\n702:     skillLabels: recommendationLabels(parsed),\n703:   });\n704:   return attachTypedCommand(\n705:     input.options?.includeCompiledRoute === false\n706:       ? parsed\n707:       : enrichCompiledRoutes(parsed, input.prompt, workspaceRoot, input.options?.surfaceHint, input.options?.compiledRouteTopOnly === true),\n708:     input.prompt,\n709:   );\n710: }\n711: \n712: // ───────────────────────────────────────────────────────────────────\n713: // 5. EXPORTS\n714: // ───────────────────────────────────────────────────────────────────\n715: \n716: export async function handleAdvisorRecommend(args: unknown): Promise<HandlerResponse> {\n717:   const input = AdvisorRecommendInputSchema.parse(args);\n718:   // Canonicalize via realpath after the schema allowlist check.\n719:   const workspaceRoot = input.workspaceRoot\n720:     ? canonicalizeWorkspaceRoot(input.workspaceRoot)\n721:     : findWorkspaceRoot();\n722:   const effectiveThresholds = publicThresholds({\n723:     confidenceThreshold: input.options?.confidenceThreshold,\n724:     uncertaintyThreshold: input.options?.uncertaintyThreshold,\n725:   });\n726:   const disabledBy = ADVISOR_DISABLED_FLAGS.find((flag) => process.env[flag] === '1');\n727:   const data = disabledBy\n728:     ? disabledOutput(workspaceRoot, effectiveThresholds, disabledBy)\n729:     : await computeRecommendationOutput(input);\n730:   return {\n731:     content: [{\n732:       type: 'text',\n733:       text: JSON.stringify({ status: 'ok', data }, null, 2),\n734:     }],\n735:   };\n736: }\n737: "}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"limit\": 200, \"offset\": 540, \"path\": \".skilled/skills/system-skill-advisor/runtime/handlers/advisor-recommend.ts\"}"},"time":{"start":1794571113378,"end":1794571113709}}}}
{"type":"step_finish","timestamp":1794571115892,"sessionID":"ses_e2b4a23c4ffeXM7ei3r7kNeMRl","part":{"id":"prt_1d4c61d74001relhQZd5UIOP9K","sessionID":"ses_e2b4a23c4ffeXM7ei3r7kNeMRl","messageID":"msg_1d4c60205001i7igsZKPQjR6hK","type":"step-finish","reason":"tool-calls","snapshot":"e16400638e52e496a28006c0ba033a9523ed67b3","cost":0,"tokens":{"input":2448,"output":91,"reasoning":226,"cache":{"read":194048,"write":0}}}}
{"type":"step_start","timestamp":1794571119003,"sessionID":"ses_e2b4a23c4ffeXM7ei3r7kNeMRl","part":{"id":"prt_1d4c6299b001h4uv9iTCS496S2","sessionID":"ses_e2b4a23c4ffeXM7ei3r7kNeMRl","messageID":"msg_1d4c61d81001et7zfvyGDj3PrE","type":"step-start","snapshot":"e16400638e52e496a28006c0ba033a9523ed67b3"}}
{"type":"tool_use","timestamp":1794571132981,"sessionID":"ses_e2b4a23c4ffeXM7ei3r7kNeMRl","part":{"partID":"prt_1d4c65c98001aX0iDEDfoDnKdt","sessionID":"ses_e2b4a23c4ffeXM7ei3r7kNeMRl","messageID":"msg_1d4c61d81001et7zfvyGDj3PrE","type":"tool","id":"chatcmpl-tool-bbf71b03b1072bcf","tool":"shell","state":{"status":"completed","input":{"command":"cd /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research && ls .skilled/skills/system-skill-advisor/runtime/tests/ | grep -i \"policy\\|drift\" ; echo \"=== policy derivation test content ===\"; sed -n '1,60p' .skilled/skills/system-skill-advisor/runtime/tests/command-policy-derivation.vitest.ts"},"output":"command-bridges-drift-guard.vitest.ts\ncommand-policy-derivation.vitest.ts\npolicy-observation-sink.vitest.ts\npolicy-plan-negative-controls.vitest.ts\npolicy-plan.vitest.ts\nprompt-policy-gold-replay.vitest.ts\nrouting-registry-drift-guard.vitest.ts\n=== policy derivation test content ===\n// ───────────────────────────────────────────────────────────────\n// MODULE: Command Policy Derivation\n// ───────────────────────────────────────────────────────────────\n\n// Pins the policy ladder and the closed key vocabularies that feed it. The ladder\n// is the only place an ask becomes a run, so each rung is asserted on its own: a\n// reordered branch would quietly promote a mutating command past the operator. The\n// real-tree tests read the repository once and assert the inventory agrees with\n// itself, which is the property a stale generated projection would break.\n//\n// A standalone skill declares its commands without a hub, so nothing but the\n// deriver's activation rule keeps them reachable. That rule lives in the main\n// path rather than an exported helper, so one case stages the folder layout the\n// deriver resolves from its own location and runs the real generator over it.\n\nimport { execFileSync } from 'node:child_process';\nimport { copyFileSync, mkdirSync, mkdtempSync, readFileSync, rmSync, writeFileSync } from 'node:fs';\nimport { createRequire } from 'node:module';\nimport { tmpdir } from 'node:os';\nimport { join } from 'node:path';\n\nimport { afterAll, beforeAll, describe, expect, it } from 'vitest';\n\nconst require = createRequire(import.meta.url);\n\nconst RUNTIME_ROOT = join(import.meta.dirname, '..');\n// The deriver loads its YAML parser from the workspace's shared module folder,\n// which a staged copy no longer sits under.\nconst SHARED_MODULES = join(RUNTIME_ROOT, '..', '..', '..', 'node_modules');\n\nconst bridges = require('../scripts/command-bridges/derive-command-bridges.cjs') as {\n  commandTreeNames(commandsRoot?: string): string[];\n  validateRiskKeys(record: Record<string, unknown>, label: string, requireTarget?: boolean): void;\n  derivePolicy(record: RiskRecord): string;\n  doctorLeadPhrases(\n    item: { mutating: string; lead_phrases: string[] },\n    label: string,\n    triggerPhrases: string[],\n  ): string[];\n  metadataRiskRecords(skillsRoot?: string): Array<{ command: string }>;\n  identityViolations(input: {\n    treeCommands: string[];\n    metadataCommands: string[];\n    doctorCommands: string[];\n  }): string[];\n  commandPolicies(\n    skillsRoot?: string,\n    routesPath?: string,\n  ): Array<{ command: string; route: string | null; policy: string }>;\n};\n\ninterface RiskRecord {\n  mutating: string;\n  ask_first?: string[];\n  write_scope?: string;\n  gate3_location?: string;\n  doctor?: boolean;\n}\n\nconst POLICY_VALUES = ['run', 'start', 'ask'];\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"command-bridges-drift-guard.vitest.ts\ncommand-policy-derivation.vitest.ts\npolicy-observation-sink.vitest.ts\npolicy-plan-negative-controls.vitest.ts\npolicy-plan.vitest.ts\nprompt-policy-gold-replay.vitest.ts\nrouting-registry-drift-guard.vitest.ts\n=== policy derivation test content ===\n// ───────────────────────────────────────────────────────────────\n// MODULE: Command Policy Derivation\n// ───────────────────────────────────────────────────────────────\n\n// Pins the policy ladder and the closed key vocabularies that feed it. The ladder\n// is the only place an ask becomes a run, so each rung is asserted on its own: a\n// reordered branch would quietly promote a mutating command past the operator. The\n// real-tree tests read the repository once and assert the inventory agrees with\n// itself, which is the property a stale generated projection would break.\n//\n// A standalone skill declares its commands without a hub, so nothing but the\n// deriver's activation rule keeps them reachable. That rule lives in the main\n// path rather than an exported helper, so one case stages the folder layout the\n// deriver resolves from its own location and runs the real generator over it.\n\nimport { execFileSync } from 'node:child_process';\nimport { copyFileSync, mkdirSync, mkdtempSync, readFileSync, rmSync, writeFileSync } from 'node:fs';\nimport { createRequire } from 'node:module';\nimport { tmpdir } from 'node:os';\nimport { join } from 'node:path';\n\nimport { afterAll, beforeAll, describe, expect, it } from 'vitest';\n\nconst require = createRequire(import.meta.url);\n\nconst RUNTIME_ROOT = join(import.meta.dirname, '..');\n// The deriver loads its YAML parser from the workspace's shared module folder,\n// which a staged copy no longer sits under.\nconst SHARED_MODULES = join(RUNTIME_ROOT, '..', '..', '..', 'node_modules');\n\nconst bridges = require('../scripts/command-bridges/derive-command-bridges.cjs') as {\n  commandTreeNames(commandsRoot?: string): string[];\n  validateRiskKeys(record: Record<string, unknown>, label: string, requireTarget?: boolean): void;\n  derivePolicy(record: RiskRecord): string;\n  doctorLeadPhrases(\n    item: { mutating: string; lead_phrases: string[] },\n    label: string,\n    triggerPhrases: string[],\n  ): string[];\n  metadataRiskRecords(skillsRoot?: string): Array<{ command: string }>;\n  identityViolations(input: {\n    treeCommands: string[];\n    metadataCommands: string[];\n    doctorCommands: string[];\n  }): string[];\n  commandPolicies(\n    skillsRoot?: string,\n    routesPath?: string,\n  ): Array<{ command: string; route: string | null; policy: string }>;\n};\n\ninterface RiskRecord {\n  mutating: string;\n  ask_first?: string[];\n  write_scope?: string;\n  gate3_location?: string;\n  doctor?: boolean;\n}\n\nconst POLICY_VALUES = ['run', 'start', 'ask'];\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\": \"cd /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research && ls .skilled/skills/system-skill-advisor/runtime/tests/ | grep -i \\\"policy\\\\|drift\\\" ; echo \\\"=== policy derivation test content ===\\\"; sed -n '1,60p' .skilled/skills/system-skill-advisor/runtime/tests/command-policy-derivation.vitest.ts\"}"},"time":{"start":1794571132056,"end":1794571132981}}}}
