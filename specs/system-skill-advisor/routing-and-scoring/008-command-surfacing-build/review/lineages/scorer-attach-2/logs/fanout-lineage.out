;\n450:   const namedSkills = extractMetalinguisticSkillMentions(prompt);\n451:   // A command row that already ranks in this result offers its command by itself,\n452:   // so the owning hub must not offer the same one again and spend a second slot on it.\n453:   const alreadyOffered = new Set<string>();\n454:   for (const recommendation of output.recommendations) {\n455:     if (recommendation.command) alreadyOffered.add(recommendation.command);\n456:   }\n457:   return AdvisorRecommendOutputSchema.parse({\n458:     ...output,\n459:     recommendations: output.recommendations.map((recommendation, index) => {\n460:       // Each lookup is a subprocess, so a caller that acts on the top pick alone\n461:       // pays for that one and no more.\n462:       if (topOnly && index > 0) return recommendation;\n463:       if (!compiledRoutingEnabledForHub(recommendation.skillId)) return recommendation;\n464:       const compiledRoute = compiledRouteForRecommendation(\n465:         recommendation.skillId,\n466:         prompt,\n467:         workspaceRoot,\n468:         surfaceHint,\n469:       );\n470:       if (!compiledRoute) return recommendation;\n471:       // The route answers which mode the hub would take; the command is what a reader\n472:       // types to run it, so it rides along only when the route names exactly one mode\n473:       // that has a command. A broader route leaves the key off rather than guessing.\n474:       const command = attachCommand(recommendation.skillId, compiledRoute, prompt);\n475:       // A caller that asks for the top pick alone renders that head and no row\n476:       // below it, so a command only a lower row carries would never reach the\n477:       // reader. The head keeps the command when it is the only row served.\n478:       return command && (!alreadyOffered.has(command) || (topOnly && index === 0))\n479:         ? {\n480:           ...recommendation,\n481:           compiledRoute,\n482:           command,\n483:           ...(Ob