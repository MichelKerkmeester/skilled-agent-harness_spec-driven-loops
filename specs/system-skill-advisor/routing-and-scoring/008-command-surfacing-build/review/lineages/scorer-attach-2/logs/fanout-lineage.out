{"type":"tool_use","timestamp":1794570760852,"sessionID":"ses_e2b4a23c4ffeXM7ei3r7kNeMRl","part":{"partID":"prt_1d4c0b12e002vjK55WaBVPzcYo","sessionID":"ses_e2b4a23c4ffeXM7ei3r7kNeMRl","messageID":"msg_1d4c08f71001HZoaHyphD8ZLWZ","type":"tool","id":"chatcmpl-tool-9f0d71f2692aa4ba","tool":"read","state":{"status":"completed","input":{"path":".skilled/skills/system-skill-advisor/runtime/handlers/advisor-status.ts","limit":200,"offset":1},"output":"Read file .skilled/skills/system-skill-advisor/runtime/handlers/advisor-status.ts, lines 1-200\n1: // ───────────────────────────────────────────────────────────────\n2: // MODULE: advisor_status Handler\n3: // ───────────────────────────────────────────────────────────────\n4: \n5: // ───────────────────────────────────────────────────────────────────\n6: // 1. IMPORTS\n7: // ───────────────────────────────────────────────────────────────────\n8: \n9: import { existsSync, readFileSync, readdirSync, statSync } from 'node:fs';\n10: import { join, resolve } from 'node:path';\n11: import Database from 'better-sqlite3';\n12: \n13: import { computeAdvisorSourceSignature } from '../lib/freshness.js';\n14: import { readSkillGraphGeneration } from '../lib/freshness/generation.js';\n15: import { checkSqliteIntegrity } from '../lib/freshness/sqlite-integrity.js';\n16: import { createPrivateSkillLinkCheck } from '../lib/private-skill-target.js';\n17: import {\n18:   computeSkillMetadataContentHash,\n19:   isGenuineCorruptionReason,\n20:   readCommandEmbeddingSources,\n21:   resolveSkillGraphDbDir,\n22:   DB_FILENAME,\n23: } from '../lib/skill-graph/skill-graph-db.js';\n24: import { createTrustState } from '../lib/freshness/trust-state.js';\n25: import { getAdapter, getManifest } from '../lib/embedders/registry.js';\n26: import { probeOllamaModel, resolveOllamaBaseUrl } from '../lib/embedders/adapters/ollama.js';\n27: import { commandVecTableNameForDim } from '../lib/embedders/schema.js';\n28: import { readEmbeddingsHealth } from '../lib/embedders/embeddings-health.js';\n29: import { getSemanticShadowRuntimeHealth } from '../lib/scorer/lanes/semantic-shadow.js';\n30: import { readAdvisorEmbeddingStaleness } from '../lib/scorer/projection.js';\n31: import { DEFAULT_SCORER_WEIGHTS } from '../lib/scorer/weights-config.js';\n32: import { readAdvisorHookHealthSection } from '../lib/metrics.js';\n33: import { errorMessage } from '../lib/utils/error-format.js';\n34: import { redactDiagnosticText } from './skill-graph/response-envelope.js';\n35: import {\n36:   AdvisorStatusInputSchema,\n37:   AdvisorStatusOutputSchema,\n38: } from '../schemas/advisor-tool-schemas.js';\n39: \n40: import type {\n41:   AdvisorFreshness,\n42:   AdvisorStatusInput,\n43:   AdvisorStatusOutput,\n44: } from '../schemas/advisor-tool-schemas.js';\n45: \n46: // ───────────────────────────────────────────────────────────────────\n47: // 2. TYPE DEFINITIONS AND CONSTANTS\n48: // ───────────────────────────────────────────────────────────────────\n49: \n50: type HandlerResponse = { content: Array<{ type: string; text: string }> };\n51: type IndexStaleness = NonNullable<AdvisorStatusOutput['indexStaleness']>;\n52: \n53: const SKILL_ROOT = join('.skilled', 'skills');\n54: const DEFAULT_MAX_METADATA_FILES = 5_000;\n55: type SemanticLaneHealth = NonNullable<AdvisorStatusOutput['semanticLaneHealth']>;\n56: \n57: // ───────────────────────────────────────────────────────────────────\n58: // 3. HELPERS\n59: // ───────────────────────────────────────────────────────────────────\n60: \n61: function isFreshness(value: string): value is AdvisorFreshness {\n62:   return value === 'live' || value === 'stale' || value === 'absent' || value === 'unavailable';\n63: }\n64: \n65: function parseDaemonPid(): number | undefined {\n66:   const raw = process.env.SPECKIT_SKILL_GRAPH_DAEMON_PID;\n67:   if (!raw) return undefined;\n68:   const parsed = Number(raw);\n69:   return Number.isSafeInteger(parsed) && parsed > 0 ? parsed : undefined;\n70: }\n71: \n72: function hasRunningDaemon(pid: number | undefined): boolean {\n73:   if (!pid) {\n74:     return false;\n75:   }\n76:   try {\n77:     process.kill(pid, 0);\n78:     return true;\n79:   } catch {\n80:     return false;\n81:   }\n82: }\n83: \n84: function fileMtimeMs(path: string): number {\n85:   if (!existsSync(path)) return 0;\n86:   const stat = statSync(path);\n87:   return stat.mtimeMs;\n88: }\n89: \n90: function resolveSkillGraphDbPath(workspaceRoot: string): string {\n91:   // Resolve through the writer's own resolver so the integrity probe always\n92:   // targets the exact file the daemon writes. An env override wins for both;\n93:   // otherwise the workspace root stands in for the writer's cwd, which match\n94:   // in the normal single-root deployment.\n95:   return join(resolveSkillGraphDbDir(workspaceRoot), DB_FILENAME);\n96: }\n97: \n98: // Per-(dbPath, generation, mtime) integrity verdict cache. A full quick_check\n99: // scans the artifact, which is too costly to run on the recommend hot path;\n100: // caching it lets recommend opt into corruption detection while paying the\n101: // scan at most once per generation. The only events that can change on-disk\n102: // integrity — a generation bump or an mtime change — invalidate the entry.\n103: const integrityVerdictCache = new Map<string, { ok: true } | { ok: false; reason: string }>();\n104: \n105: function checkSqliteIntegrityCached(\n106:   dbPath: string,\n107:   generation: number,\n108:   mtimeMs: number,\n109: ): { ok: true } | { ok: false; reason: string } {\n110:   const key = `${dbPath}::${generation}::${mtimeMs}`;\n111:   const cached = integrityVerdictCache.get(key);\n112:   if (cached) {\n113:     return cached;\n114:   }\n115:   const result = checkSqliteIntegrity(dbPath);\n116:   // Only the newest (path, generation, mtime) verdict is ever consulted, so a\n117:   // single-entry cache is sufficient and self-bounding.\n118:   integrityVerdictCache.clear();\n119:   integrityVerdictCache.set(key, result);\n120:   return result;\n121: }\n122: \n123: function tableExists(database: Database.Database, tableName: string): boolean {\n124:   const row = database.prepare(`\n125:     SELECT 1 AS present\n126:     FROM sqlite_master\n127:     WHERE type = 'table' AND name = ?\n128:     LIMIT 1\n129:   `).get(tableName) as { present: number } | undefined;\n130:   return Boolean(row);\n131: }\n132: \n133: function metadataValue(database: Database.Database, key: string): string | null {\n134:   if (!tableExists(database, 'vec_metadata')) return null;\n135:   const row = database.prepare('SELECT value FROM vec_metadata WHERE key = ?').get(key) as { value: string } | undefined;\n136:   return row?.value ?? null;\n137: }\n138: \n139: function countRows(database: Database.Database, sql: string): number {\n140:   const row = database.prepare(sql).get() as { c: number } | undefined;\n141:   return row?.c ?? 0;\n142: }\n143: \n144: function maxUpdatedAt(database: Database.Database, tableName: string): string | null {\n145:   const row = database.prepare(`SELECT MAX(updated_at) AS updatedAt FROM ${tableName}`).get() as { updatedAt: string | null } | undefined;\n146:   return row?.updatedAt ?? null;\n147: }\n148: \n149: function baseSemanticLaneHealth(disabledReason: string | null): SemanticLaneHealth {\n150:   return {\n151:     activeEmbedder: null,\n152:     vectorCoverage: { embedded: 0, total: 0, ratio: 0 },\n153:     dimMismatch: false,\n154:     lastRefresh: null,\n155:     disabledReason,\n156:     laneEnabled: false,\n157:     checkedAt: new Date().toISOString(),\n158:   };\n159: }\n160: \n161: function readSemanticLaneHealth(dbPath: string): SemanticLaneHealth {\n162:   const runtime = getSemanticShadowRuntimeHealth();\n163:   // The command projection's size does not depend on the database, so the\n164:   // denominator is known even when the artifact is missing or unreadable.\n165:   const commandTotal = readCommandEmbeddingSources()?.length ?? 0;\n166:   if (!existsSync(dbPath)) {\n167:     return {\n168:       ...baseSemanticLaneHealth(runtime.disabledReason ?? 'database_absent'),\n169:       commandVectorCoverage: { embedded: 0, total: commandTotal },\n170:     };\n171:   }\n172: \n173:   let database: Database.Database | null = null;\n174:   try {\n175:     database = new Database(dbPath, { readonly: true, fileMustExist: true });\n176:     const total = tableExists(database, 'skill_nodes')\n177:       ? countRows(database, 'SELECT COUNT(*) AS c FROM skill_nodes')\n178:       : 0;\n179:     const activeName = metadataValue(database, 'active_embedder_name');\n180:     const activeDimRaw = metadataValue(database, 'active_embedder_dim');\n181:     const activeDim = activeDimRaw ? Number.parseInt(activeDimRaw, 10) : 0;\n182:     const hasActive = Boolean(activeName) && Number.isInteger(activeDim) && activeDim > 0;\n183:     const adapter = activeName ? getAdapter(activeName) : undefined;\n184:     const activeEmbedder = activeName\n185:       ? { name: activeName, dim: Number.isInteger(activeDim) && activeDim > 0 ? activeDim : 0, adapterDim: adapter?.dim ?? null }\n186:       : null;\n187:     const tableName = hasActive ? `vec_${activeDim}` : null;\n188:     const hasVecTable = tableName ? tableExists(database, tableName) : false;\n189:     const embedded = hasVecTable\n190:       ? countRows(database, `SELECT COUNT(*) AS c FROM ${tableName} WHERE embedding IS NOT NULL`)\n191:       : (tableExists(database, 'skill_nodes') ? countRows(database, 'SELECT COUNT(*) AS c FROM skill_nodes WHERE embedding IS NOT NULL') : 0);\n192:     const lastRefresh = hasVecTable && tableName ? maxUpdatedAt(database, tableName) : null;\n193:     const commandTable = hasActive ? commandVecTableNameForDim(activeDim) : null;\n194:     const commandEmbedded = commandTable && tableExists(database, commandTable)\n195:       ? countRows(database, `SELECT COUNT(*) AS c FROM ${commandTable}`)\n196:       : 0;\n197:     const dimMismatch = Boolean(activeEmbedder && activeEmbedder.adapterDim !== null && activeEmbedder.dim !== activeEmbedder.adapterDim);\n198:     const staleness = readAdvisorEmbeddingStaleness(database);\n199:     const disabledReason = dimMismatch\n200:       ? 'dim_mismatch'\n[Output truncated. Continue reading with offset: 201]","title":"read","metadata":{"metadata":{"truncated":true},"content":[{"type":"text","text":"Read file .skilled/skills/system-skill-advisor/runtime/handlers/advisor-status.ts, lines 1-200\n1: // ───────────────────────────────────────────────────────────────\n2: // MODULE: advisor_status Handler\n3: // ───────────────────────────────────────────────────────────────\n4: \n5: // ───────────────────────────────────────────────────────────────────\n6: // 1. IMPORTS\n7: // ───────────────────────────────────────────────────────────────────\n8: \n9: import { existsSync, readFileSync, readdirSync, statSync } from 'node:fs';\n10: import { join, resolve } from 'node:path';\n11: import Database from 'better-sqlite3';\n12: \n13: import { computeAdvisorSourceSignature } from '../lib/freshness.js';\n14: import { readSkillGraphGeneration } from '../lib/freshness/generation.js';\n15: import { checkSqliteIntegrity } from '../lib/freshness/sqlite-integrity.js';\n16: import { createPrivateSkillLinkCheck } from '../lib/private-skill-target.js';\n17: import {\n18:   computeSkillMetadataContentHash,\n19:   isGenuineCorruptionReason,\n20:   readCommandEmbeddingSources,\n21:   resolveSkillGraphDbDir,\n22:   DB_FILENAME,\n23: } from '../lib/skill-graph/skill-graph-db.js';\n24: import { createTrustState } from '../lib/freshness/trust-state.js';\n25: import { getAdapter, getManifest } from '../lib/embedders/registry.js';\n26: import { probeOllamaModel, resolveOllamaBaseUrl } from '../lib/embedders/adapters/ollama.js';\n27: import { commandVecTableNameForDim } from '../lib/embedders/schema.js';\n28: import { readEmbeddingsHealth } from '../lib/embedders/embeddings-health.js';\n29: import { getSemanticShadowRuntimeHealth } from '../lib/scorer/lanes/semantic-shadow.js';\n30: import { readAdvisorEmbeddingStaleness } from '../lib/scorer/projection.js';\n31: import { DEFAULT_SCORER_WEIGHTS } from '../lib/scorer/weights-config.js';\n32: import { readAdvisorHookHealthSection } from '../lib/metrics.js';\n33: import { errorMessage } from '../lib/utils/error-format.js';\n34: import { redactDiagnosticText } from './skill-graph/response-envelope.js';\n35: import {\n36:   AdvisorStatusInputSchema,\n37:   AdvisorStatusOutputSchema,\n38: } from '../schemas/advisor-tool-schemas.js';\n39: \n40: import type {\n41:   AdvisorFreshness,\n42:   AdvisorStatusInput,\n43:   AdvisorStatusOutput,\n44: } from '../schemas/advisor-tool-schemas.js';\n45: \n46: // ───────────────────────────────────────────────────────────────────\n47: // 2. TYPE DEFINITIONS AND CONSTANTS\n48: // ───────────────────────────────────────────────────────────────────\n49: \n50: type HandlerResponse = { content: Array<{ type: string; text: string }> };\n51: type IndexStaleness = NonNullable<AdvisorStatusOutput['indexStaleness']>;\n52: \n53: const SKILL_ROOT = join('.skilled', 'skills');\n54: const DEFAULT_MAX_METADATA_FILES = 5_000;\n55: type SemanticLaneHealth = NonNullable<AdvisorStatusOutput['semanticLaneHealth']>;\n56: \n57: // ───────────────────────────────────────────────────────────────────\n58: // 3. HELPERS\n59: // ───────────────────────────────────────────────────────────────────\n60: \n61: function isFreshness(value: string): value is AdvisorFreshness {\n62:   return value === 'live' || value === 'stale' || value === 'absent' || value === 'unavailable';\n63: }\n64: \n65: function parseDaemonPid(): number | undefined {\n66:   const raw = process.env.SPECKIT_SKILL_GRAPH_DAEMON_PID;\n67:   if (!raw) return undefined;\n68:   const parsed = Number(raw);\n69:   return Number.isSafeInteger(parsed) && parsed > 0 ? parsed : undefined;\n70: }\n71: \n72: function hasRunningDaemon(pid: number | undefined): boolean {\n73:   if (!pid) {\n74:     return false;\n75:   }\n76:   try {\n77:     process.kill(pid, 0);\n78:     return true;\n79:   } catch {\n80:     return false;\n81:   }\n82: }\n83: \n84: function fileMtimeMs(path: string): number {\n85:   if (!existsSync(path)) return 0;\n86:   const stat = statSync(path);\n87:   return stat.mtimeMs;\n88: }\n89: \n90: function resolveSkillGraphDbPath(workspaceRoot: string): string {\n91:   // Resolve through the writer's own resolver so the integrity probe always\n92:   // targets the exact file the daemon writes. An env override wins for both;\n93:   // otherwise the workspace root stands in for the writer's cwd, which match\n94:   // in the normal single-root deployment.\n95:   return join(resolveSkillGraphDbDir(workspaceRoot), DB_FILENAME);\n96: }\n97: \n98: // Per-(dbPath, generation, mtime) integrity verdict cache. A full quick_check\n99: // scans the artifact, which is too costly to run on the recommend hot path;\n100: // caching it lets recommend opt into corruption detection while paying the\n101: // scan at most once per generation. The only events that can change on-disk\n102: // integrity — a generation bump or an mtime change — invalidate the entry.\n103: const integrityVerdictCache = new Map<string, { ok: true } | { ok: false; reason: string }>();\n104: \n105: function checkSqliteIntegrityCached(\n106:   dbPath: string,\n107:   generation: number,\n108:   mtimeMs: number,\n109: ): { ok: true } | { ok: false; reason: string } {\n110:   const key = `${dbPath}::${generation}::${mtimeMs}`;\n111:   const cached = integrityVerdictCache.get(key);\n112:   if (cached) {\n113:     return cached;\n114:   }\n115:   const result = checkSqliteIntegrity(dbPath);\n116:   // Only the newest (path, generation, mtime) verdict is ever consulted, so a\n117:   // single-entry cache is sufficient and self-bounding.\n118:   integrityVerdictCache.clear();\n119:   integrityVerdictCache.set(key, result);\n120:   return result;\n121: }\n122: \n123: function tableExists(database: Database.Database, tableName: string): boolean {\n124:   const row = database.prepare(`\n125:     SELECT 1 AS present\n126:     FROM sqlite_master\n127:     WHERE type = 'table' AND name = ?\n128:     LIMIT 1\n129:   `).get(tableName) as { present: number } | undefined;\n130:   return Boolean(row);\n131: }\n132: \n133: function metadataValue(database: Database.Database, key: string): string | null {\n134:   if (!tableExists(database, 'vec_metadata')) return null;\n135:   const row = database.prepare('SELECT value FROM vec_metadata WHERE key = ?').get(key) as { value: string } | undefined;\n136:   return row?.value ?? null;\n137: }\n138: \n139: function countRows(database: Database.Database, sql: string): number {\n140:   const row = database.prepare(sql).get() as { c: number } | undefined;\n141:   return row?.c ?? 0;\n142: }\n143: \n144: function maxUpdatedAt(database: Database.Database, tableName: string): string | null {\n145:   const row = database.prepare(`SELECT MAX(updated_at) AS updatedAt FROM ${tableName}`).get() as { updatedAt: string | null } | undefined;\n146:   return row?.updatedAt ?? null;\n147: }\n148: \n149: function baseSemanticLaneHealth(disabledReason: string | null): SemanticLaneHealth {\n150:   return {\n151:     activeEmbedder: null,\n152:     vectorCoverage: { embedded: 0, total: 0, ratio: 0 },\n153:     dimMismatch: false,\n154:     lastRefresh: null,\n155:     disabledReason,\n156:     laneEnabled: false,\n157:     checkedAt: new Date().toISOString(),\n158:   };\n159: }\n160: \n161: function readSemanticLaneHealth(dbPath: string): SemanticLaneHealth {\n162:   const runtime = getSemanticShadowRuntimeHealth();\n163:   // The command projection's size does not depend on the database, so the\n164:   // denominator is known even when the artifact is missing or unreadable.\n165:   const commandTotal = readCommandEmbeddingSources()?.length ?? 0;\n166:   if (!existsSync(dbPath)) {\n167:     return {\n168:       ...baseSemanticLaneHealth(runtime.disabledReason ?? 'database_absent'),\n169:       commandVectorCoverage: { embedded: 0, total: commandTotal },\n170:     };\n171:   }\n172: \n173:   let database: Database.Database | null = null;\n174:   try {\n175:     database = new Database(dbPath, { readonly: true, fileMustExist: true });\n176:     const total = tableExists(database, 'skill_nodes')\n177:       ? countRows(database, 'SELECT COUNT(*) AS c FROM skill_nodes')\n178:       : 0;\n179:     const activeName = metadataValue(database, 'active_embedder_name');\n180:     const activeDimRaw = metadataValue(database, 'active_embedder_dim');\n181:     const activeDim = activeDimRaw ? Number.parseInt(activeDimRaw, 10) : 0;\n182:     const hasActive = Boolean(activeName) && Number.isInteger(activeDim) && activeDim > 0;\n183:     const adapter = activeName ? getAdapter(activeName) : undefined;\n184:     const activeEmbedder = activeName\n185:       ? { name: activeName, dim: Number.isInteger(activeDim) && activeDim > 0 ? activeDim : 0, adapterDim: adapter?.dim ?? null }\n186:       : null;\n187:     const tableName = hasActive ? `vec_${activeDim}` : null;\n188:     const hasVecTable = tableName ? tableExists(database, tableName) : false;\n189:     const embedded = hasVecTable\n190:       ? countRows(database, `SELECT COUNT(*) AS c FROM ${tableName} WHERE embedding IS NOT NULL`)\n191:       : (tableExists(database, 'skill_nodes') ? countRows(database, 'SELECT COUNT(*) AS c FROM skill_nodes WHERE embedding IS NOT NULL') : 0);\n192:     const lastRefresh = hasVecTable && tableName ? maxUpdatedAt(database, tableName) : null;\n193:     const commandTable = hasActive ? commandVecTableNameForDim(activeDim) : null;\n194:     const commandEmbedded = commandTable && tableExists(database, commandTable)\n195:       ? countRows(database, `SELECT COUNT(*) AS c FROM ${commandTable}`)\n196:       : 0;\n197:     const dimMismatch = Boolean(activeEmbedder && activeEmbedder.adapterDim !== null && activeEmbedder.dim !== activeEmbedder.adapterDim);\n198:     const staleness = readAdvisorEmbeddingStaleness(database);\n199:     const disabledReason = dimMismatch\n200:       ? 'dim_mismatch'\n[Output truncated. Continue reading with offset: 201]"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\": \".skilled/skills/system-skill-advisor/runtime/handlers/advisor-status.ts\", \"limit\": 200, \"offset\": 1}"},"time":{"start":1794570760494,"end":1794570760852}}}}
