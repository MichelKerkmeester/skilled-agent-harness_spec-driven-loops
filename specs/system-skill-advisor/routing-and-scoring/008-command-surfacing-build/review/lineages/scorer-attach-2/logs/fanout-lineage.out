  effectiveThresholds,\n177:     freshness: 'unavailable',\n178:     trustState: unavailableTrustState('ADVISOR_DISABLED'),\n179:     warnings: ['ADVISOR_DISABLED'],\n180:     abstainReasons: [`Skill advisor disabled by ${disabledBy}.`],\n181:   });\n182: }\n183: \n184: function absentOutput(\n185:   status: AdvisorStatus,\n186:   workspaceRoot: string,\n187:   effectiveThresholds: AdvisorRecommendOutput['effectiveThresholds'],\n188: ): AdvisorRecommendOutput {\n189:   return emptyOutput({\n190:     workspaceRoot,\n191:     effectiveThresholds,\n192:     freshness: 'absent',\n193:     trustState: status.trustState,\n194:     warnings: [status.trustState.reason ?? 'ADVISOR_FRESHNESS_ABSENT'],\n195:     abstainReasons: ['Skill advisor freshness is absent; returning fail-open empty recommendations.'],\n196:   });\n197: }\n198: \n199: function unavailableOutput(\n200:   status: AdvisorStatus,\n201:   workspaceRoot: string,\n202:   effectiveThresholds: AdvisorRecommendOutput['effectiveThresholds'],\n203: ): AdvisorRecommendOutput {\n204:   return emptyOutput({\n205:     workspaceRoot,\n206:     effectiveThresholds,\n207:     freshness: 'unavailable',\n208:     trustState: {\n209:       ...status.trustState,\n210:       state: 'unavailable',\n211:       reason: 'advisor_unavailable',\n212:     },\n213:     warnings: ['advisor_unavailable', ...(status.errors ?? [])],\n214:     abstainReasons: ['Skill advisor freshness is unavailable; returning fail-open empty recommendations.'],\n215:   });\n216: }\n217: \n218: function safeMany(values: readonly string[] | undefined): string[] {\n219:   return (values ?? [])\n220:     .map((value) => sanitizeSkillLabel(value))\n221:     .filter((value): value is string => Boolean(value));\n222: }\n223: \n224: function evidenceFeature(value: string): string {\n225:   const prefix = value.split(':', 1)[0];\n226:   switch (prefix) {\n227:     case 'phrase':\n228:       return 'phrase_match';\n229:     case 'token':\n230:       return 'token_match';\n231:     case 'hint':\n232:       return 'category_hint';\n233:     case 'derived':\n234:       return 'derived_skill_signal';\n235:     case 'doc':\n236:       return 'doc_reference_signal';\n237:     case 'cosine':\n238:       return 'semantic_similarity';\n239:     default:\n240:       if (value.includes('disambiguation')) return 'disambiguation_rule';\n[Output truncated. Continue reading with offset: 241]"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"limit\": 240, \"offset\": 1, \"path\": \".skilled/skills/system-skill-advisor/runtime/handlers/advisor-recommend.ts\"}"},"time":{"start":1794571096081,"end":1794571096351}}}}
