ng with offset: 465]"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"limit\": 70, \"offset\": 395, \"path\": \".skilled/skills/system-skill-advisor/runtime/scripts/command-bridges/derive-command-bridges.cjs\"}"},"time":{"start":1794570944323,"end":1794570944720}}}}
