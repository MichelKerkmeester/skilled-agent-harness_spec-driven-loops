ow new Error(`[command-bridges] ${label} requires a non-empty string workflowMode`);\n421:       }\n422:       // One key per hub: a repeated workflow mode would leave the lookup holding\n423:       // whichever row the table happened to keep, so the registry has to say it\n424:       // once.\n425:       if (seen.has(workflowMode)) {\n426:         throw new Error(\n427:           `[command-bridges] Duplicate workflow mode ${workflowMode} in ${sourcePath(filePath)}`,\n428:         );\n429:       }\n430:       seen.add(workflowMode);\n431: \n432:       const { command } = mode;\n433:       // A null command is a mode with no dedicated slash command, which is a\n434:       // declared state rather than a mistake, so it contributes no row.\n435:       if (typeof command !== 'string' || !command) continue;\n436:       // A command with no router file is one the reader cannot type, so naming\n437:       // it here would promise a surface that does not exist.\n438:       if (!commandNames.has(command)) {\n439:         throw new Error(\n440:           `[command-bridges] ${label} names ${command}, which has no command file`,\n441:         );\n442:       }\n443:       records.push({ hubId, workflowMode, command });\n444:     }\n445:   }\n446:   // The generated file is compared byte for byte, so the order has to be total.\n447:   return records.sort((left, right) => (\n448:     left.hubId === right.hubId\n449:       ? left.workflowMode.localeCompare(right.workflowMode)\n450:       : left.hubId.localeCompare(right.hubId)\n451:   ));\n452: }\n453: \n454: // The policy ladder reads only these keys, so a wrong value has to fail here\n455: // rather than fall through to a branch that merely looks safe.\n456: function validateRiskKeys(record, label, requireTarget = false) {\n457:   if (!MUTATING_CLASSES.includes(record.mutating)) {\n458:     throw new Error(\n459:       `[command-bridges] ${label} has mutating ${JSON.stringify(record.mutating)}; `\n460:         + `expected one of ${MUTATING_CLASSES.join(', ')}`,\n461:     );\n462:   }\n463:   if (record.ask_first !== undefined) {\n464:     const askFirst = record.ask_first;\n[Output truncated. Continue reading with offset: 465]","title":"read","metadata":{"metadata":{"truncated":true},"content":[{"type":"text","text":"Read file .skilled/skills/system-skill-advisor/runtime/scripts/command-bridges/derive-command-bridges.cjs, lines 395-464\n395: // themselves rather than transcribed into the consumer and left to drift.\n396: function modeCommandRecords(skillsRoot = SKILLS_ROOT, commandsRoot = COMMANDS_ROOT) {\n397:   const commandNames = new Set(commandTreeNames(commandsRoot));\n398:   const records = [];\n399:   const hubIds = readdirSync(skillsRoot, { withFileTypes: true })\n400:     // The same skill folders as the bridge metadata, for the same reason: a\n401:     // private skill is local to one checkout and a linked folder is not a skill\n402:     // source.\n403:     .filter((entry) => !entry.name.startsWith('local-') && !entry.isSymbolicLink())\n404:     .map((entry) => entry.name)\n405:     .sort();\n406:   for (const hubId of hubIds) {\n407:     const filePath = join(skillsRoot, hubId, 'mode-registry.json');\n408:     if (!existsSync(filePath)) continue;\n409: \n410:     const registry = readJson(filePath);\n411:     const modes = registry && registry.modes;\n412:     if (!Array.isArray(modes)) {\n413:       throw new Error(`[command-bridges] ${sourcePath(filePath)} must contain a modes array`);\n414:     }\n415:     const seen = new Set();\n416:     for (const [index, mode] of modes.entries()) {\n417:       const label = `${sourcePath(filePath)} modes[${index}]`;\n418:       const workflowMode = mode && mode.workflowMode;\n419:       if (typeof workflowMode !== 'string' || !workflowMode) {\n420:         throw new Error(`[command-bridges] ${label} requires a non-empty string workflowMode`);\n421:       }\n422:       // One key per hub: a repeated workflow mode would leave the lookup ho