cy test precision\\\",title:\\\"Privacy guard cannot fail because the fixture stores nothing private\\\",file:\\\".skilled/skills/system-skill-advisor/runtime/tests/handlers/advisor-status.vitest.ts:493\\\",iteration:2}));\\nlines.push(JSON.stringify({type:\\\"classification\\\",detail:\\\"Mutating-command invariant proven over 56 rows/19 run/0 mutates; two P2 assurance findings\\\",iteration:2}));\\nlines.push(JSON.stringify({type:\\\"traceability\\\",protocol:\\\"spec_code\\\",level:\\\"core\\\",status:\\\"partial\\\",iteration:2}));\\nlines.push(JSON.stringify({type:\\\"ruled_out\\\",direction:\\\"a run row that mutates\\\",reason:\\\"executed enumeration: 0 of 19 run rows carry mutates\\\",iteration:2}));\\nlines.push(JSON.stringify({type:\\\"ruled_out\\\",direction:\\\"advisor_status leaking holdout prompt text\\\",reason:\\\"no prompt source read on that surface\\\",iteration:2}));\\nfs.writeFileSync(delta,lines.join(\\\"\\\\n\\\")+\\\"\\\\n\\\");\\nconsole.log(\\\"delta lines\\\",lines.length);\\n' && node .skilled/skills/system-deep-loop/runtime/scripts/reduce-state.cjs specs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build --artifact-dir specs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/review/lineages/scorer-attach-2 --create-missing-anchors | tail -6; echo \\\"EXIT:$?\\\"\"}"},"time":{"start":1794570895989,"end":1794570899684}}}}
