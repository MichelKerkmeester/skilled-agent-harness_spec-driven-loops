un';\n494-  if (record.mutating === 'add-only' && record.write_scope === 'spec-folder') return 'run';\n495-  return 'start';\n496-}\n497-\n498-// The same skill folders as the bridge metadata, for the same reason: a private\n499-// skill is local to a checkout and a linked folder is not a skill source. A\n500-// metadata command is reachable by typing its name, so it must also name where\n501-// its writes land before its policy may be derived.\n502-function metadataRiskRecords(skillsRoot = SKILLS_ROOT) {\n503-  const records = [];\n504-  const skillIds = readdirSync(skillsRoot, { withFileTypes: true })\n505-    .filter((entry) => !entry.name.startsWith('local-') && !entry.isSymbolicLink())\n506-    .map((entry) => entry.name)\n507-    .sort();\n508-  for (const skillId of skillIds) {\n509-    const filePath = join(skillsRoot, skillId, 'command-metadata.json');\n510-    if (!existsSync(filePath)) continue;\n511-    const metadata = readJson(filePath);\n512-    if (!Array.isArray(metadata)) {\n513-      throw new Error(`[command-bridges] ${sourcePath(filePath)} must contain a JSON array`);\n514-    }\n515-    for (const [index, entry] of metadata.entries()) {\n516-      if (!entry || typeof entry !== 'object') {\n517-        throw new Error(`[command-bridges] ${sourcePath(filePath)}[${index}] must be an object`);\n518-      }\n519-      validateRiskKeys(entry, `${sourcePath(filePath)}[${index}] ${entry.command}`, true);\n520-      records.push({\n521-        command: entry.command,\n522-        route: null,\n523-        mutating: entry.mutating,\n524-        ask_first: entry.ask_first || [],\n525-        write_scope: entry.write_scope,\n526-        doctor: false,\n527-      });\n528-    }\n529-  }\n530-  return records;\n531-}\n532-\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"command-bridges.generated.json\nderive-command-bridges.cjs\nREADME.md\nscoring-compatibility.json\nshadow-diff.m