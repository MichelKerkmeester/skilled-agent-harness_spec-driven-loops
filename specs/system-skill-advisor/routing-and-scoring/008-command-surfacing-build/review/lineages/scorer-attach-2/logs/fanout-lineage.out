mMismatch && !staleness.stale && hasVecTable && embedded > 0 && !disabledReason),\n222:       checkedAt: new Date().toISOString(),\n223:     };\n224:   } catch {\n225:     return {\n226:       ...baseSemanticLaneHealth(runtime.disabledReason ?? 'health_unavailable'),\n227:       commandVectorCoverage: { embedded: 0, total: commandTotal },\n228:     };\n229:   } finally {\n230:     database?.close();\n231:   }\n232: }\n233: \n234: function readIndexStaleness(dbPath: string, workspaceRoot: string): IndexStaleness {\n235:   const unavailable = (reason: string): IndexStaleness => ({\n236:     state: 'unavailable',\n237:     reason,\n238:     trackedSkills: 0,\n239:     freshSourceFiles: 0,\n240:     changedSourceFiles: 0,\n241:     missingSourceFiles: 0,\n242:     staleSkillIds: [],\n243:   });\n244:   if (!existsSync(dbPath)) return unavailable('database_absent');\n245: \n246:   let database: Database.Database | null = null;\n247:   let result = unavailable('index_read_failed');\n248:   try {\n249:     database = new Database(dbPath, { readonly: true, fileMustExist: true });\n250:     if (!tableExists(database, 'skill_nodes')) {\n251:       result = unavailable('index_rows_absent');\n252:     } else {\n253:       const columns = database.pragma('table_info(skill_nodes)') as Array<{ name: string }>;\n254:       const hasSourceColumns = columns.some((column) => column.name === 'source_path')\n255:         && columns.some((column) => column.name === 'content_hash');\n256:       if (!hasSourceColumns) {\n257:         result = unavailable('index_rows_absent');\n258:       } else {\n259:         const rows = database.prepare(`\n260:           SELECT id, source_path, content_hash\n261:           FROM skill_nodes\n262:           ORDER BY id\n263:         `).all() as Array<{\n264:           id: string;\n265:           source_path: string | null;\n266:           content_hash: string | null;\n267:         }>;\n268:         if (rows.length === 0) {\n269:           result = unavailable('index_rows_absent');\n270:         } else {\n271:           let freshSourceFiles = 0;\n272:           let changedSourceFiles = 0;\n273:           let missingSourceFiles = 0;\n274:           const staleSkillIds: string[] = [];\n275: \n276:           for (const row of rows) {\n277:             if (!row.source_path || row.source_path.trim().length === 0) {\n278:               missingSourceFiles++;\n279:               staleSkillIds.push(row.id);\n280:               continue;\n281:             }\n282: \n283:             let content: string;\n284:             try {\n285:               content = readFileSync(resolve(workspaceRoot, row.source_path), 'utf8');\n286:             } catch (error: unknown) {\n287:               if (error instanceof Error && 'code' in error && error.code === 'ENOENT') {\n288:                 missingSourceFiles++;\n289:                 staleSkillIds.push(row.id);\n290:                 continue;\n291:               }\n292:               throw error;\n293:             }\n294: \n295:             if (row.content_hash === null\n296:               || computeSkillMetadataContentHash(content) !== row.content_hash) {\n297:               changedSourceFiles++;\n298:               staleSkillIds.push(row.id);\n299:               continue;\n300:             }\n301: \n302:             freshSourceFiles++;\n303:           }\n304: \n305:           const stale = changedSourceFiles + missingSourceFiles > 0;\n306:           result = {\n307:             state: stale ? 'stale' : 'fresh',\n308:             reason: stale ? 'source_hash_mismatch' : null,\n309:             trackedSkills: rows.length,\n310:             freshSourceFiles,\n311:             changedSourceFiles,\n312:             missingSourceFiles,\n313:             staleSkillIds: staleSkillIds.slice(0, 25),\n314:           };\n315:         }\n316:       }\n317:     }\n318:   } catch {\n319:     result = unavailable('index_read_failed');\n320:   } finally {\n321:     try {\n322:       database?.close();\n323:     } catch {\n324:       result = unavailable('index_read_failed');\n325:     }\n326:   }\n327: \n328:   return result;\n329: }\n330: \n331: function scanSkillMetadataFiles(\n332:   skillRoot: string,\n333:   maxFiles = DEFAULT_MAX_METADATA_FILES,\n334: ): { count: number; maxMtimeMs: number; truncated: boolean } {\n335:   if (!existsSync(skillRoot)) return { count: 0, maxMtimeMs: 0, truncated: false };\n336:   const isTrustedLink = createPrivateSkillLinkCheck(skillRoot);\n337:   const skillRoots = readdirSync(skillRoot, { withFileTypes: true })\n338:     .filter((entry) => !entry.name.startsWith('.') && (entry.isDirectory()\n339:       || (entry.name.startsWith('local-')\n340:         && entry.isSymbolicLink()\n341:         && isTrustedLink(join(skillRoot, entry.name)))))\n342:     .sort((left, right) => left.name.localeCompare(right.name));\n343:   let count = 0;\n344:   let newest = 0;\n345:   let truncated = false;\n346:   for (const entry of skillRoots) {\n347:     const metadataPath = join(skillRoot, entry.name, 'graph-metadata.json');\n348:     if (!existsSync(metadataPath)) continue;\n349:     const metadataStat = statSync(metadataPath);\n350:     if (!metadataStat.isFile()) continue;\n351:     if (count >= maxFiles) {\n352:       truncated = true;\n353:       break;\n354:     }\n355:     count++;\n356:     newest = Math.max(newest, metadataStat.mtimeMs);\n357:   }\n358:   return { count, maxMtimeMs: newest, truncated };\n359: }\n360: \n361: // The status reader stays synchronous so the recommend path can call it, which\n362: // puts the only network probe here on the async command path. Reading /api/tags\n363: // is the only signal that separates a stopped server or a missing model from a\n364: // healthy lane: the pointer and the vectors survive both, so a lane that\n365: // reports enabled through an outage sends operators to rebuild a fine index\n366: // instead of starting the server.\n367: async function probeSemanticLaneBackend(health: SemanticLaneHealth): Promise<SemanticLaneHealth> {\n368:   const activeName = health.activeEmbedder?.name;\n369:   const manifest = activeName ? getManifest(activeName) : undefined;\n370:   if (!manifest) {\n371:     return health;\n372:   }\n373:   if (manifest.backend !== 'ollama') {\n374:     return {\n375:       ...health,\n376:       backend: { state: 'probe_not_implemented', reason: `no readiness probe for the ${manifest.backend} backend` },\n377:       laneEnabled: false,\n378:     };\n379:   }\n380:   const probe = await probeOllamaModel(\n381:     resolveOllamaBaseUrl(),\n382:     manifest.ollamaName ?? manifest.name,\n383:     500,\n384:   );\n385:   if (probe.available) {\n386:     return { ...health, backend: { state: 'reachable', reason: null } };\n387:   }\n388:   const reason = probe.reason ?? null;\n389:   return {\n390:     ...health,\n391:     backend: {\n392:       state: reason && /not loaded/i.test(reason) ? 'model_missing' : 'unreachable',\n393:       reason,\n394:     },\n395:     laneEnabled: false,\n396:   };\n397: }\n398: \n399: // ───────────────────────────────────────────────────────────────────\n400: // 4. CORE LOGIC\n401: // ───────────────────────────────────────────────────────────────────\n402: \n403: /** Read advisor freshness state.\n404:  *\n405:  * Diagnostic-only: this function reports stale, absent, or unavailable advisor\n406:  * state and does not rebuild it. Use `advisor_rebuild` to repair stale state.\n407:  */\n408: export function readAdvisorStatus(input: AdvisorStatusInput): AdvisorStatusOutput {\n409:   const args = AdvisorStatusInputSchema.parse(input);\n410:   const workspaceRoot = resolve(args.workspaceRoot);\n411:   const dbPath = resolveSkillGraphDbPath(workspaceRoot);\n412:   const skillRoot = join(workspaceRoot, SKILL_ROOT);\n413:   const errors: string[] = [];\n414: \n415:   try {\n416:     const generation = readSkillGraphGeneration(workspaceRoot);\n417:     const hasSources = existsSync(skillRoot);\n418:     const hasArtifact = existsSync(dbPath);\n419:     // Existence alone lets a corrupt-on-disk artifact report 'live' from the\n420:     // generation counters, which makes advisor_rebuild skip the repair it\n421:     // exists to perform. A read-only quick_check turns genuine corruption\n422:     // into a stale signal so rebuild runs. Transient lock/IO failures are\n423:     // excluded so contention never forces a spurious rebuild.\n424:     const integrity = (hasArtifact && args.checkArtifactIntegrity === true)\n425:       ? checkSqliteIntegrityCached(dbPath, generation.generation, fileMtimeMs(dbPath))\n426:       : null;\n427:     const artifactCorrupt = Boolean(\n428:       integrity && !integrity.ok\n429:         && integrity.reason !== 'SQLITE_ABSENT'\n430:         && isGenuineCorruptionReason(integrity.reason),\n431:     );\n432:     if (artifactCorrupt && integrity && !integrity.ok) {\n433:       errors.push(`advisor_status skill graph integrity check failed (${integrity.reason}); run advisor_rebuild`);\n434:     }\n435:     const sourceScan = scanSkillMetadataFiles(skillRoot, args.maxMetadataFiles ?? DEFAULT_MAX_METADATA_FILES);\n436:     if (sourceScan.truncated) {\n437:       errors.push(`advisor_status metadata scan capped at ${sourceScan.count} files`);\n438:     }\n439:     const indexStaleness = readIndexStaleness(dbPath, workspaceRoot);\n[Output truncated. Continue reading with offset: 440]"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"limit\": 240, \"offset\": 200, \"path\": \".skilled/skills/system-skill-advisor/runtime/handlers/advisor-status.ts\"}"},"time":{"start":1794570766050,"end":1794570766458}}}}
