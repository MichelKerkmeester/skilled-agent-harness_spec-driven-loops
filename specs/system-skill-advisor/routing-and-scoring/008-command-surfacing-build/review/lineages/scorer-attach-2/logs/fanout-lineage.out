25:       reason: status.trustState.reason ?? 'skill_graph_stale',\n126:     },\n127:   };\n128: }\n129: \n130: function renderableStatus(status: AdvisorStatus): AdvisorStatus {\n131:   const trustState = status.trustState.state;\n132:   if (status.freshness === 'unavailable' && (trustState === 'live' || trustState === 'stale')) {\n133:     return { ...status, freshness: trustState };\n134:   }\n135:   return status;\n136: }\n137: \n138: function emptyOutput(args: {\n139:   workspaceRoot: string;\n140:   effectiveThresholds: AdvisorRecommendOutput['effectiveThresholds'];\n141:   freshness: AdvisorRecommendOutput['freshness'];\n142:   trustState: AdvisorRecommendOutput['trustState'];\n143:   warnings?: readonly string[];\n144:   abstainReasons?: readonly string[];\n145: }): AdvisorRecommendOutput {\n146:   return AdvisorRecommendOutputSchema.parse({\n147:     workspaceRoot: args.workspaceRoot,\n148:     effectiveThresholds: args.effectiveThresholds,\n149:     recommendations: [],\n150:     ambiguous: false,\n151:     freshness: args.freshness,\n152:     trustState: args.trustState,\n153:     generatedAt: new Date().toISOString(),\n154:     cache: {\n155:       hit: false,\n156:       sourceSignaturePresent: false,\n157:     },\n158:     ...(args.warnings && args.warnings.length > 0 ? { warnings: [...args.warnings] } : {}),\n159:     ...(args.abstainReasons && args.abstainReasons.length > 0 ? { abstainReasons: [...args.abstainReasons] } : {}),\n160:   });\n161: }\n162: \n163: // The canonical flag is checked first so the reason names it when both are set.\n164: const ADVISOR_DISABLED_FLAGS = [\n165:   'SYSTEM_SKILL_ADVISOR_HOOK_DISABLED',\n166:   'SPECKIT_SKILL_ADVISOR_HOOK_DISABLED',\n167: ] as const;\n168: \n169: function disabledOutput(\n170:   workspaceRoot: string,\n171:   effectiveThresholds: PublicThresholds,\n172:   disabledBy: string,\n173: ): AdvisorRecommendOutput {\n174:   return emptyOutput({\n175:     workspaceRoot,\n176:     effectiveThresholds,\n177:  