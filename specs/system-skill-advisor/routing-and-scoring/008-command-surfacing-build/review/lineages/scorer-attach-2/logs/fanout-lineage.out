{"type":"tool_use","timestamp":1794570810326,"sessionID":"ses_e2b4a23c4ffeXM7ei3r7kNeMRl","part":{"partID":"prt_1d4c17303002qjCxf2RApkw3Tc","sessionID":"ses_e2b4a23c4ffeXM7ei3r7kNeMRl","messageID":"msg_1d4c1432e001ykAQ0SCjhEBqzm","type":"tool","id":"chatcmpl-tool-a8320782bdbcbc8a","tool":"read","state":{"status":"completed","input":{"path":".skilled/skills/system-skill-advisor/runtime/tests/handlers/advisor-status.vitest.ts"},"output":"Read file .skilled/skills/system-skill-advisor/runtime/tests/handlers/advisor-status.vitest.ts, lines 1-748\n1: // ───────────────────────────────────────────────────────────────\n2: // MODULE: Advisor Status Tests\n3: // ───────────────────────────────────────────────────────────────\n4: \n5: import { mkdtempSync, mkdirSync, readFileSync, symlinkSync, utimesSync, writeFileSync } from 'node:fs';\n6: import { join } from 'node:path';\n7: import { tmpdir } from 'node:os';\n8: import Database from 'better-sqlite3';\n9: \n10: import { beforeEach, describe, expect, it, vi } from 'vitest';\n11: \n12: const ollamaMocks = vi.hoisted(() => ({\n13:   probeOllamaModel: vi.fn(),\n14:   resolveOllamaBaseUrl: vi.fn(() => 'http://127.0.0.1:11434'),\n15: }));\n16: \n17: // The handler is the only caller that probes a backend, so the mock keeps\n18: // every other status case free of network access.\n19: vi.mock('../../lib/embedders/adapters/ollama.js', async (importOriginal) => {\n20:   const actual = await importOriginal<typeof import('../../lib/embedders/adapters/ollama.js')>();\n21:   return {\n22:     ...actual,\n23:     probeOllamaModel: ollamaMocks.probeOllamaModel,\n24:     resolveOllamaBaseUrl: ollamaMocks.resolveOllamaBaseUrl,\n25:   };\n26: });\n27: \n28: import { handleAdvisorStatus, readAdvisorStatus } from '../../handlers/advisor-status.js';\n29: import { computeAdvisorSourceSignature } from '../../lib/freshness.js';\n30: import {\n31:   advisorHookDiagnosticsPath,\n32:   createAdvisorHookDiagnosticRecord,\n33:   persistAdvisorHookDiagnosticRecord,\n34: } from '../../lib/metrics.js';\n35: import {\n36:   computeSkillMetadataContentHash,\n37:   readCommandEmbeddingSources,\n38: } from '../../lib/skill-graph/skill-graph-db.js';\n39: import { AdvisorStatusOutputSchema } from '../../schemas/advisor-tool-schemas.js';\n40: \n41: const ADVISOR_DB_RELATIVE_PATH = join(\n42:   '.skilled',\n43:   'skills',\n44:   'system-skill-advisor',\n45:   'runtime',\n46:   'database',\n47:   'skill-graph.sqlite',\n48: );\n49: \n50: function workspace(name: string): string {\n51:   const root = mkdtempSync(join(tmpdir(), `advisor-status-${name}-`));\n52:   mkdirSync(join(root, '.skilled', 'skills', '.state', 'advisor'), { recursive: true });\n53:   mkdirSync(join(root, '.skilled', 'skills', 'system-skill-advisor', 'runtime', 'database'), { recursive: true });\n54:   mkdirSync(join(root, '.skilled', 'skills', 'alpha'), { recursive: true });\n55:   writeFileSync(join(root, '.skilled', 'skills', 'alpha', 'graph-metadata.json'), '{\"skill_id\":\"alpha\"}\\n', 'utf8');\n56:   return root;\n57: }\n58: \n59: function writeGeneration(\n60:   root: string,\n61:   state: 'live' | 'stale' | 'absent' | 'unavailable',\n62:   generation = 1,\n63:   sourceSignature: string | null = null,\n64: ): void {\n65:   writeFileSync(join(root, '.skilled', 'skills', '.state', 'advisor', 'skill-graph-generation.json'), `${JSON.stringify({\n66:     generation,\n67:     updatedAt: '2026-04-20T00:00:00.000Z',\n68:     sourceSignature,\n69:     reason: `${state.toUpperCase()}_FIXTURE`,\n70:     state,\n71:   })}\\n`, 'utf8');\n72: }\n73: \n74: function writeDb(root: string): void {\n75:   writeFileSync(join(root, ADVISOR_DB_RELATIVE_PATH), '', 'utf8');\n76: }\n77: \n78: function writeIndexDb(root: string, contentHash: string | null): void {\n79:   const database = new Database(join(root, ADVISOR_DB_RELATIVE_PATH));\n80:   try {\n81:     database.exec(`\n82:       CREATE TABLE skill_nodes (\n83:         id TEXT PRIMARY KEY,\n84:         source_path TEXT,\n85:         content_hash TEXT\n86:       );\n87:     `);\n88:     database.prepare(`\n89:       INSERT INTO skill_nodes (id, source_path, content_hash)\n90:       VALUES (?, ?, ?)\n91:     `).run(\n92:       'alpha',\n93:       join('.skilled', 'skills', 'alpha', 'graph-metadata.json'),\n94:       contentHash,\n95:     );\n96:   } finally {\n97:     database.close();\n98:   }\n99: }\n100: \n101: function writeHealthDb(root: string): void {\n102:   const database = new Database(join(root, ADVISOR_DB_RELATIVE_PATH));\n103:   try {\n104:     database.exec(`\n105:       CREATE TABLE skill_nodes (\n106:         id TEXT PRIMARY KEY,\n107:         embedding BLOB,\n108:         embedding_model_id TEXT,\n109:         embedding_content_hash TEXT\n110:       );\n111:       CREATE TABLE vec_metadata (key TEXT PRIMARY KEY, value TEXT NOT NULL);\n112:       CREATE TABLE vec_768 (\n113:         skill_id TEXT PRIMARY KEY,\n114:         embedding BLOB NOT NULL,\n115:         model_id TEXT NOT NULL,\n116:         content_hash TEXT NOT NULL,\n117:         updated_at TEXT DEFAULT (datetime('now'))\n118:       );\n119:     `);\n120:     database.prepare('INSERT INTO skill_nodes (id) VALUES (?)').run('alpha');\n121:     database.prepare('INSERT INTO skill_nodes (id) VALUES (?)').run('beta');\n122:     database.prepare('INSERT INTO vec_metadata (key, value) VALUES (?, ?)').run('active_embedder_name', 'nomic-embed-text-v1.5');\n123:     database.prepare('INSERT INTO vec_metadata (key, value) VALUES (?, ?)').run('active_embedder_dim', '768');\n124:     database.prepare('INSERT INTO vec_768 (skill_id, embedding, model_id, content_hash, updated_at) VALUES (?, ?, ?, ?, ?)')\n125:       .run('alpha', Buffer.from([1, 2, 3]), 'nomic-embed-text-v1.5', 'hash-alpha', '2026-04-20T00:00:00.000Z');\n126:   } finally {\n127:     database.close();\n128:   }\n129: }\n130: \n131: function writeCommandVectorTable(root: string, rows: number): void {\n132:   const database = new Database(join(root, ADVISOR_DB_RELATIVE_PATH));\n133:   try {\n134:     database.exec(`\n135:       CREATE TABLE vec_cmd_768 (\n136:         command_id TEXT PRIMARY KEY,\n137:         embedding BLOB NOT NULL,\n138:         model_id TEXT NOT NULL,\n139:         content_hash TEXT NOT NULL,\n140:         updated_at TEXT DEFAULT (datetime('now'))\n141:       );\n142:     `);\n143:     const insert = database.prepare(`\n144:       INSERT INTO vec_cmd_768 (command_id, embedding, model_id, content_hash)\n145:       VALUES (?, ?, ?, ?)\n146:     `);\n147:     for (let index = 0; index < rows; index += 1) {\n148:       insert.run(`command-${index}`, Buffer.from([1, 2, 3]), 'nomic-embed-text-v1.5', `hash-${index}`);\n149:     }\n150:   } finally {\n151:     database.close();\n152:   }\n153: }\n154: \n155: function writeDimMismatchHealthDb(root: string): void {\n156:   const database = new Database(join(root, ADVISOR_DB_RELATIVE_PATH));\n157:   try {\n158:     database.exec(`\n159:       CREATE TABLE skill_nodes (id TEXT PRIMARY KEY, embedding BLOB);\n160:       CREATE TABLE vec_metadata (key TEXT PRIMARY KEY, value TEXT NOT NULL);\n161:       CREATE TABLE vec_123 (\n162:         skill_id TEXT PRIMARY KEY,\n163:         embedding BLOB NOT NULL,\n164:         model_id TEXT NOT NULL,\n165:         content_hash TEXT NOT NULL,\n166:         updated_at TEXT DEFAULT (datetime('now'))\n167:       );\n168:     `);\n169:     database.prepare('INSERT INTO skill_nodes (id) VALUES (?)').run('alpha');\n170:     database.prepare('INSERT INTO vec_metadata (key, value) VALUES (?, ?)').run('active_embedder_name', 'nomic-embed-text-v1.5');\n171:     database.prepare('INSERT INTO vec_metadata (key, value) VALUES (?, ?)').run('active_embedder_dim', '123');\n172:   } finally {\n173:     database.close();\n174:   }\n175: }\n176: \n177: describe('advisor_status handler', () => {\n178:   beforeEach(() => {\n179:     ollamaMocks.probeOllamaModel.mockReset();\n180:     ollamaMocks.resolveOllamaBaseUrl.mockReset();\n181:     ollamaMocks.resolveOllamaBaseUrl.mockReturnValue('http://127.0.0.1:11434');\n182:   });\n183: \n184:   it('includes a private skill linked from inside the skills root in the source signature', () => {\n185:     const root = workspace('linked');\n186:     const skills = join(root, '.skilled', 'skills');\n187:     mkdirSync(join(skills, '.private', 'private-beta'), { recursive: true });\n188:     writeFileSync(join(skills, '.private', 'private-beta', 'SKILL.md'), 'first\\n');\n189:     writeFileSync(join(skills, '.private', 'private-beta', 'graph-metadata.json'), '{\"skill_id\":\"local-beta\"}\\n');\n190:     symlinkSync(join(skills, '.private', 'private-beta'), join(skills, 'local-beta'));\n191:     const before = computeAdvisorSourceSignature(root);\n192:     writeFileSync(join(skills, '.private', 'private-beta', 'SKILL.md'), 'second\\n');\n193:     expect(computeAdvisorSourceSignature(root)).not.toBe(before);\n194:   });\n195: \n196:   it('ignores a private skill linked from outside every trusted root', () => {\n197:     const root = workspace('outside');\n198:     const skills = join(root, '.skilled', 'skills');\n199:     const outside = join(root, 'outside-beta');\n200:     mkdirSync(outside, { recursive: true });\n201:     writeFileSync(join(outside, 'SKILL.md'), 'first\\n');\n202:     writeFileSync(join(outside, 'graph-metadata.json'), '{\"skill_id\":\"local-beta\"}\\n');\n203:     symlinkSync(outside, join(skills, 'local-beta'));\n204:     const before = computeAdvisorSourceSignature(root);\n205:     writeFileSync(join(outside, 'SKILL.md'), 'second\\n');\n206:     expect(computeAdvisorSourceSignature(root)).toBe(before);\n207:   });\n208: \n209:   it('includes a private skill linked into a declared external root', () => {\n210:     const root = workspace('declared');\n211:     const skills = join(root, '.skilled', 'skills');\n212:     const external = join(root, 'private-repos');\n213:     const target = join(external, 'sk-code-webflow');\n214:     mkdirSync(target, { recursive: true });\n215:     writeFileSync(join(target, 'SKILL.md'), 'first\\n');\n216:     writeFileSync(join(target, 'graph-metadata.json'), '{\"skill_id\":\"local-webflow\"}\\n');\n217:     symlinkSync(target, join(skills, 'local-webflow'));\n218:     process.env.SPECKIT_PRIVATE_SKILL_ROOTS = external;\n219:     try {\n220:       const before = computeAdvisorSourceSignature(root);\n221:       writeFileSync(join(target, 'SKILL.md'), 'second\\n');\n222:       expect(computeAdvisorSourceSignature(root)).not.toBe(before);\n223:     } finally {\n224:       delete process.env.SPECKIT_PRIVATE_SKILL_ROOTS;\n225:     }\n226:   });\n227: \n228:   // drift: verified against shipped behavior during Unit H\n229:   it('reports live freshness', () => {\n230:     const root = workspace('live');\n231:     writeDb(root);\n232:     writeGeneration(root, 'live', 3);\n233: \n234:     const status = readAdvisorStatus({ workspaceRoot: root });\n235: \n236:     expect(status.freshness).toBe('live');\n237:     expect(status.trustState.state).toBe('live');\n238:     expect(status.generation).toBe(3);\n239:     expect(status.trustState.lastLiveAt).toBe('2026-04-20T00:00:00.000Z');\n240:     expect(status.lastScanAt).toBe('2026-04-20T00:00:00.000Z');\n241:     expect(status.skillCount).toBe(1);\n242:     expect(status.laneWeights.explicit_author).toBe(0.42);\n243:     expect(status.semanticLaneHealth).toBeUndefined();\n244:   });\n245: \n246:   it('reports fresh index hashes without changing a live generation', () => {\n247:     const root = workspace('index-fresh');\n248:     const metadataPath = join(root, '.skilled', 'skills', 'alpha', 'graph-metadata.json');\n249:     const contentHash = computeSkillMetadataContentHash(readFileSync(metadataPath, 'utf8'));\n250:     writeIndexDb(root, contentHash);\n251:     writeGeneration(root, 'live', 3, computeAdvisorSourceSignature(root));\n252: \n253:     const status = readAdvisorStatus({ workspaceRoot: root });\n254: \n255:     expect(status.freshness).toBe('live');\n256:     expect(status.indexStaleness).toEqual({\n257:       state: 'fresh',\n258:       reason: null,\n259:       trackedSkills: 1,\n260:       freshSourceFiles: 1,\n261:       changedSourceFiles: 0,\n262:       missingSourceFiles: 0,\n263:       staleSkillIds: [],\n264:     });\n265:   });\n266: \n267:   it('marks live generations stale when index hashes differ from disk', () => {\n268:     const root = workspace('index-stale');\n269:     writeIndexDb(root, 'outdated-hash');\n270:     writeGeneration(root, 'live', 4, computeAdvisorSourceSignature(root));\n271: \n272:     const status = readAdvisorStatus({ workspaceRoot: root });\n273: \n274:     expect(status.freshness).toBe('stale');\n275:     expect(status.trustState.state).toBe('stale');\n276:     expect(status.indexStaleness).toEqual(expect.objectContaining({\n277:       state: 'stale',\n278:       reason: 'source_hash_mismatch',\n279:       changedSourceFiles: 1,\n280:     }));\n281:     expect(status.errors).toContain(\n282:       'advisor_status index content hashes differ from disk for 1 skill; run advisor_rebuild',\n283:     );\n284:   });\n285: \n286:   it('reports unavailable index staleness when the database is absent', () => {\n287:     const root = workspace('index-absent');\n288:     writeGeneration(root, 'live', 5, computeAdvisorSourceSignature(root));\n289: \n290:     const status = readAdvisorStatus({ workspaceRoot: root });\n291: \n292:     expect(status.indexStaleness).toEqual(expect.objectContaining({\n293:       state: 'unavailable',\n294:       reason: 'database_absent',\n295:     }));\n296:   });\n297: \n298:   it('reports semantic-lane health only when requested', () => {\n299:     const root = workspace('semantic-health');\n300:     writeHealthDb(root);\n301:     writeGeneration(root, 'live', 8);\n302: \n303:     const compact = readAdvisorStatus({ workspaceRoot: root });\n304:     const detailed = readAdvisorStatus({ workspaceRoot: root, includeSemanticHealth: true });\n305: \n306:     expect(compact.semanticLaneHealth).toBeUndefined();\n307:     expect(detailed.semanticLaneHealth).toEqual(expect.objectContaining({\n308:       activeEmbedder: expect.objectContaining({\n309:         name: 'nomic-embed-text-v1.5',\n310:         dim: 768,\n311:         adapterDim: 768,\n312:       }),\n313:       vectorCoverage: {\n314:         embedded: 1,\n315:         total: 2,\n316:         ratio: 0.5,\n317:       },\n318:       dimMismatch: false,\n319:       lastRefresh: '2026-04-20T00:00:00.000Z',\n320:       disabledReason: null,\n321:       laneEnabled: true,\n322:     }));\n323:   });\n324: \n325:   it('surfaces semantic-lane dim mismatch as a disabled reason', () => {\n326:     const root = workspace('semantic-dim-mismatch');\n327:     writeDimMismatchHealthDb(root);\n328:     writeGeneration(root, 'live', 9);\n329: \n330:     const status = readAdvisorStatus({ workspaceRoot: root, includeSemanticHealth: true });\n331: \n332:     expect(status.semanticLaneHealth).toEqual(expect.objectContaining({\n333:       activeEmbedder: expect.objectContaining({\n334:         name: 'nomic-embed-text-v1.5',\n335:         dim: 123,\n336:         adapterDim: 768,\n337:       }),\n338:       dimMismatch: true,\n339:       disabledReason: 'dim_mismatch',\n340:       laneEnabled: false,\n341:     }));\n342:   });\n343: \n344:   it('reports zero command-vector coverage when no command table exists', () => {\n345:     const root = workspace('command-coverage-absent');\n346:     writeHealthDb(root);\n347:     writeGeneration(root, 'live', 10);\n348: \n349:     const status = readAdvisorStatus({ workspaceRoot: root, includeSemanticHealth: true });\n350:     const sourceTotal = readCommandEmbeddingSources()?.length ?? 0;\n351: \n352:     expect(status.semanticLaneHealth?.commandVectorCoverage).toEqual({\n353:       embedded: 0,\n354:       total: sourceTotal,\n355:     });\n356:   });\n357: \n358:   it('counts command-vector rows when the command table exists', () => {\n359:     const root = workspace('command-coverage-present');\n360:     writeHealthDb(root);\n361:     writeCommandVectorTable(root, 3);\n362:     writeGeneration(root, 'live', 10);\n363: \n364:     const status = readAdvisorStatus({ workspaceRoot: root, includeSemanticHealth: true });\n365:     const sourceTotal = readCommandEmbeddingSources()?.length ?? 0;\n366: \n367:     expect(status.semanticLaneHealth?.commandVectorCoverage).toEqual({\n368:       embedded: 3,\n369:       total: sourceTotal,\n370:     });\n371:   });\n372: \n373:   it('reports a reachable backend when the model is loaded', async () => {\n374:     const root = workspace('backend-reachable');\n375:     writeHealthDb(root);\n376:     writeGeneration(root, 'live', 14);\n377:     ollamaMocks.probeOllamaModel.mockResolvedValue({ available: true });\n378: \n379:     const response = await handleAdvisorStatus({ workspaceRoot: root, includeSemanticHealth: true });\n380:     const envelope = JSON.parse(response.content[0].text) as { data: unknown };\n381:     const status = AdvisorStatusOutputSchema.parse(envelope.data);\n382: \n383:     expect(ollamaMocks.probeOllamaModel).toHaveBeenCalledWith(\n384:       'http://127.0.0.1:11434',\n385:       'nomic-embed-text:v1.5',\n386:       500,\n387:     );\n388:     expect(status.semanticLaneHealth?.backend).toEqual({ state: 'reachable', reason: null });\n389:     expect(status.semanticLaneHealth?.laneEnabled).toBe(true);\n390:   });\n391: \n392:   it('reports an unreachable backend when the probe cannot connect', async () => {\n393:     const root = workspace('backend-unreachable');\n394:     writeHealthDb(root);\n395:     writeGeneration(root, 'live', 14);\n396:     const reason = 'Ollama backend unreachable at http://127.0.0.1:11434: fetch failed';\n397:     ollamaMocks.probeOllamaModel.mockResolvedValue({ available: false, reason });\n398: \n399:     const response = await handleAdvisorStatus({ workspaceRoot: root, includeSemanticHealth: true });\n400:     const envelope = JSON.parse(response.content[0].text) as { data: unknown };\n401:     const status = AdvisorStatusOutputSchema.parse(envelope.data);\n402: \n403:     expect(status.semanticLaneHealth?.backend).toEqual({ state: 'unreachable', reason });\n404:     expect(status.semanticLaneHealth?.laneEnabled).toBe(false);\n405:   });\n406: \n407:   it('reports a missing model when the server answers without it', async () => {\n408:     const root = workspace('backend-model-missing');\n409:     writeHealthDb(root);\n410:     writeGeneration(root, 'live', 14);\n411:     const reason = 'Ollama model is not loaded: nomic-embed-text:v1.5';\n412:     ollamaMocks.probeOllamaModel.mockResolvedValue({ available: false, reason });\n413: \n414:     const response = await handleAdvisorStatus({ workspaceRoot: root, includeSemanticHealth: true });\n415:     const envelope = JSON.parse(response.content[0].text) as { data: unknown };\n416:     const status = AdvisorStatusOutputSchema.parse(envelope.data);\n417: \n418:     expect(status.semanticLaneHealth?.backend).toEqual({ state: 'model_missing', reason });\n419:     expect(status.semanticLaneHealth?.laneEnabled).toBe(false);\n420:   });\n421: \n422:   // drift: verified against shipped behavior during Unit H\n423:   it('keeps signed generations live when source mtimes exceed skipped SQLite writes', () => {\n424:     const root = workspace('signed-live');\n425:     writeDb(root);\n426:     const dbPath = join(root, ADVISOR_DB_RELATIVE_PATH);\n427:     const metadataPath = join(root, '.skilled', 'skills', 'alpha', 'graph-metadata.json');\n428:     utimesSync(dbPath, new Date('2026-04-19T00:00:00.000Z'), new Date('2026-04-19T00:00:00.000Z'));\n429:     utimesSync(metadataPath, new Date('2026-04-21T00:00:00.000Z'), new Date('2026-04-21T00:00:00.000Z'));\n430:     const sourceSignature = computeAdvisorSourceSignature(root);\n431:     writeFileSync(join(root, '.skilled', 'skills', '.state', 'advisor', 'skill-graph-generation.json'), `${JSON.stringify({\n432:       generation: 9,\n433:       updatedAt: '2026-04-22T00:00:00.000Z',\n434:       sourceSignature,\n435:       reason: 'advisor_rebuild',\n436:       state: 'live',\n437:     })}\\n`, 'utf8');\n438: \n439:     const status = readAdvisorStatus({ workspaceRoot: root });\n440: \n441:     expect(status.freshness).toBe('live');\n442:     expect(status.trustState.state).toBe('live');\n443:   });\n444: \n445:   // drift: verified against shipped behavior during Unit H\n446:   it('marks live generations stale when nested graph metadata is newer than the database', () => {\n447:     const root = workspace('nested-mtime');\n448:     writeDb(root);\n449:     writeGeneration(root, 'live', 6);\n450:     const dbPath = join(root, ADVISOR_DB_RELATIVE_PATH);\n451:     const metadataPath = join(root, '.skilled', 'skills', 'alpha', 'graph-metadata.json');\n452:     utimesSync(dbPath, new Date('2026-04-19T00:00:00.000Z'), new Date('2026-04-19T00:00:00.000Z'));\n453:     utimesSync(metadataPath, new Date('2026-04-21T00:00:00.000Z'), new Date('2026-04-21T00:00:00.000Z'));\n454: \n455:     const status = readAdvisorStatus({ workspaceRoot: root });\n456: \n457:     expect(status.freshness).toBe('stale');\n458:     expect(status.trustState.lastLiveAt).toBe('2026-04-20T00:00:00.000Z');\n459:   });\n460: \n461:   // drift: verified against shipped behavior during Unit H\n462:   it('reports stale freshness', () => {\n463:     const root = workspace('stale');\n464:     writeDb(root);\n465:     writeGeneration(root, 'stale', 4);\n466: \n467:     const status = readAdvisorStatus({ workspaceRoot: root });\n468: \n469:     expect(status.freshness).toBe('stale');\n470:     expect(status.trustState.reason).toBe('STALE_FIXTURE');\n471:   });\n472: \n473:   it('reports absent freshness when no artifact exists', () => {\n474:     const root = workspace('absent');\n475:     writeGeneration(root, 'absent', 0);\n476: \n477:     const status = readAdvisorStatus({ workspaceRoot: root });\n478: \n479:     expect(status.freshness).toBe('absent');\n480:   });\n481: \n482:   // drift: verified against shipped behavior during Unit H\n483:   it('reports unavailable for corrupt generation metadata', () => {\n484:     const root = workspace('unavailable');\n485:     writeFileSync(join(root, '.skilled', 'skills', '.state', 'advisor', 'skill-graph-generation.json'), '{', 'utf8');\n486: \n487:     const status = readAdvisorStatus({ workspaceRoot: root });\n488: \n489:     expect(status.freshness).toBe('unavailable');\n490:     expect(status.errors?.length).toBeGreaterThan(0);\n491:   });\n492: \n493:   it('does not leak prompt content in status output', async () => {\n494:     const root = workspace('privacy');\n495:     writeDb(root);\n496:     writeGeneration(root, 'live', 5);\n497: \n498:     const raw = (await handleAdvisorStatus({ workspaceRoot: root })).content[0].text;\n499: \n500:     expect(raw).not.toContain('prompt');\n501:     expect(raw).not.toContain('secret@example.com');\n502:   });\n503: \n504:   it('omits embeddings health when the option is absent', async () => {\n505:     const root = workspace('embeddings-health-omitted');\n506:     const response = await handleAdvisorStatus({ workspaceRoot: root });\n507:     const envelope = JSON.parse(response.content[0].text) as { data: unknown };\n508:     const status = AdvisorStatusOutputSchema.parse(envelope.data);\n509: \n510:     expect(status).not.toHaveProperty('embeddingsHealth');\n511:   });\n512: \n513:   it('reports hook health from durable diagnostic records', async () => {\n514:     const root = workspace('hook-health');\n515:     const previousDebug = process.env.SKILL_ADVISOR_DEBUG;\n516:     process.env.SKILL_ADVISOR_DEBUG = '1';\n517:     try {\n518:       for (const durationMs of [10, 30]) {\n519:         await persistAdvisorHookDiagnosticRecord(root, createAdvisorHookDiagnosticRecord({\n520:           runtime: 'claude',\n521:           status: 'ok',\n522:           freshness: 'live',\n523:           durationMs,\n524:           cacheHit: true,\n525:         }));\n526:       }\n527: \n528:       const status = readAdvisorStatus({ workspaceRoot: root });\n529: \n530:       expect(status.hookHealth?.invocations).toBe(2);\n531:     } finally {\n532:       if (previousDebug === undefined) delete process.env.SKILL_ADVISOR_DEBUG;\n533:       else process.env.SKILL_ADVISOR_DEBUG = previousDebug;\n534:     }\n535:   });\n536: \n537:   it('writes a health record without the debug variable and keeps the skill label out', async () => {\n538:     const root = workspace('hook-health-default');\n539:     const previousDebug = process.env.SKILL_ADVISOR_DEBUG;\n540:     delete process.env.SKILL_ADVISOR_DEBUG;\n541:     try {\n542:       await persistAdvisorHookDiagnosticRecord(root, createAdvisorHookDiagnosticRecord({\n543:         runtime: 'claude',\n544:         status: 'ok',\n545:         freshness: 'live',\n546:         durationMs: 12,\n547:         cacheHit: true,\n548:         skillLabel: 'sk-doc',\n549:         errorDetails: 'probe detail',\n550:         degraded: true,\n551:       }));\n552: \n553:       const lines = readFileSync(advisorHookDiagnosticsPath(root), 'utf8').trimEnd().split('\\n');\n554:       expect(lines).toHaveLength(1);\n555:       const record = JSON.parse(lines[0] ?? '{}') as Record<string, unknown>;\n556:       expect(record).not.toHaveProperty('skillLabel');\n557:       expect(record).not.toHaveProperty('errorDetails');\n558:       expect(record.degraded).toBe(true);\n559:       expect(readAdvisorStatus({ workspaceRoot: root }).hookHealth?.invocations).toBe(1);\n560:     } finally {\n561:       if (previousDebug === undefined) delete process.env.SKILL_ADVISOR_DEBUG;\n562:       else process.env.SKILL_ADVISOR_DEBUG = previousDebug;\n563:     }\n564:   });\n565: \n566:   it('trims the default health log to 200 records', async () => {\n567:     const root = workspace('hook-health-trim');\n568:     const previousDebug = process.env.SKILL_ADVISOR_DEBUG;\n569:     delete process.env.SKILL_ADVISOR_DEBUG;\n570:     try {\n571:       for (let index = 0; index < 301; index += 1) {\n572:         await persistAdvisorHookDiagnosticRecord(root, createAdvisorHookDiagnosticRecord({\n573:           runtime: 'claude',\n574:           status: 'ok',\n575:           freshness: 'live',\n576:           durationMs: index,\n577:           cacheHit: true,\n578:         }));\n579:       }\n580: \n581:       const lines = readFileSync(advisorHookDiagnosticsPath(root), 'utf8').trimEnd().split('\\n');\n582:       expect(lines).toHaveLength(200);\n583:     } finally {\n584:       if (previousDebug === undefined) delete process.env.SKILL_ADVISOR_DEBUG;\n585:       else process.env.SKILL_ADVISOR_DEBUG = previousDebug;\n586:     }\n587:   });\n588: \n589:   it('reports the newest record time and the degraded share', async () => {\n590:     const root = workspace('hook-health-degraded');\n591:     await persistAdvisorHookDiagnosticRecord(root, createAdvisorHookDiagnosticRecord({\n592:       runtime: 'claude',\n593:       status: 'ok',\n594:       freshness: 'live',\n595:       durationMs: 10,\n596:       cacheHit: true,\n597:       timestamp: '2026-11-13T08:00:00.000Z',\n598:       degraded: true,\n599:     }));\n600:     await persistAdvisorHookDiagnosticRecord(root, createAdvisorHookDiagnosticRecord({\n601:       runtime: 'claude',\n602:       status: 'ok',\n603:       freshness: 'live',\n604:       durationMs: 30,\n605:       cacheHit: true,\n606:       timestamp: '2026-11-13T08:00:05.000Z',\n607:     }));\n608: \n609:     const status = readAdvisorStatus({ workspaceRoot: root });\n610:     const parsed = AdvisorStatusOutputSchema.parse(status);\n611: \n612:     expect(parsed.hookHealth?.invocations).toBe(2);\n613:     expect(parsed.hookHealth?.lastRecordAt).toBe('2026-11-13T08:00:05.000Z');\n614:     expect(parsed.hookHealth?.rollingDegradedRate).toBe(0.5);\n615:   });\n616: \n617:   it('omits hook health when no diagnostic records exist', () => {\n618:     const root = workspace('hook-health-absent');\n619: \n620:     const status = readAdvisorStatus({ workspaceRoot: root });\n621: \n622:     expect(status).not.toHaveProperty('hookHealth');\n623:   });\n624: \n625:   it('returns a schema-valid unavailable model-server state when requested', async () => {\n626:     const root = workspace('embeddings-health-unavailable');\n627:     const originalServerUrl = process.env.HF_EMBED_SERVER_URL;\n628: \n629:     try {\n630:       process.env.HF_EMBED_SERVER_URL = join(root, 'missing-hf-embed.sock');\n631:       const response = await handleAdvisorStatus({\n632:         workspaceRoot: root,\n633:         includeEmbeddingsHealth: true,\n634:       });\n635:       const envelope = JSON.parse(response.content[0].text) as { data: unknown };\n636:       const status = AdvisorStatusOutputSchema.parse(envelope.data);\n637: \n638:       expect(status.embeddingsHealth?.modelServer.state).toBe('unavailable');\n639:     } finally {\n640:       if (originalServerUrl === undefined) delete process.env.HF_EMBED_SERVER_URL;\n641:       else process.env.HF_EMBED_SERVER_URL = originalServerUrl;\n642:     }\n643:   });\n644: \n645:   // drift: verified against shipped behavior during Unit H\n646:   it('caps metadata scanning when requested to avoid unbounded status walks', () => {\n647:     const root = workspace('scan-cap');\n648:     writeDb(root);\n649:     writeGeneration(root, 'live', 7);\n650:     mkdirSync(join(root, '.skilled', 'skills', 'beta'), { recursive: true });\n651:     writeFileSync(join(root, '.skilled', 'skills', 'beta', 'graph-metadata.json'), '{\"skill_id\":\"beta\"}\\n', 'utf8');\n652: \n653:     const status = readAdvisorStatus({ workspaceRoot: root, maxMetadataFiles: 1 });\n654: \n655:     expect(status.skillCount).toBe(1);\n656:     expect(status.errors).toEqual([\n657:       expect.stringContaining('metadata scan capped at 1 files'),\n658:     ]);\n659:   });\n660: \n661:   it('counts only depth-one skill roots with graph metadata', () => {\n662:     const root = workspace('root-only-scan');\n663:     writeDb(root);\n664:     writeGeneration(root, 'live', 7);\n665:     mkdirSync(join(root, '.skilled', 'skills', 'beta'), { recursive: true });\n666:     writeFileSync(join(root, '.skilled', 'skills', 'beta', 'graph-metadata.json'), '{\"skill_id\":\"beta\"}\\n', 'utf8');\n667:     mkdirSync(join(root, '.skilled', 'skills', 'alpha', 'nested'), { recursive: true });\n668:     writeFileSync(join(root, '.skilled', 'skills', 'alpha', 'nested', 'graph-metadata.json'), '{\"skill_id\":\"nested\"}\\n', 'utf8');\n669: \n670:     const status = readAdvisorStatus({ workspaceRoot: root });\n671: \n672:     expect(status.skillCount).toBe(2);\n673:   });\n674: \n675:   it('counts a private skill linked from inside the skills root and not one linked from outside', () => {\n676:     const root = workspace('private-link-scan');\n677:     writeDb(root);\n678:     writeGeneration(root, 'live', 7);\n679:     const skills = join(root, '.skilled', 'skills');\n680:     const inside = join(skills, '.private', 'private-beta');\n681:     const outside = join(root, 'outside', 'private-evil');\n682:     for (const dir of [inside, outside]) {\n683:       mkdirSync(dir, { recursive: true });\n684:       writeFileSync(join(dir, 'graph-metadata.json'), '{\"skill_id\":\"local-x\"}\\n', 'utf8');\n685:     }\n686:     symlinkSync(inside, join(skills, 'local-beta'));\n687:     symlinkSync(outside, join(skills, 'local-evil'));\n688: \n689:     const status = readAdvisorStatus({ workspaceRoot: root });\n690: \n691:     // The fixture's own skill plus the trusted link; the outside link is not counted.\n692:     expect(status.skillCount).toBe(2);\n693:   });\n694: \n695:   it('probes the env-override artifact path the writer uses, read live', () => {\n696:     // The probe must target the file the writing daemon actually opens. With an\n697:     // env override set, the writer resolves there; the probe must too, even\n698:     // when called with an unrelated workspaceRoot. A healthy DB under the\n699:     // workspace would mask a corrupt override DB if the probe used the wrong\n700:     // base.\n701:     const workspaceRootDir = workspace('override-probe-workspace');\n702:     writeDb(workspaceRootDir);\n703:     writeGeneration(workspaceRootDir, 'live', 11);\n704: \n705:     const overrideDir = mkdtempSync(join(tmpdir(), 'advisor-status-override-'));\n706:     writeFileSync(join(overrideDir, 'skill-graph.sqlite'), 'not-a-sqlite-database-file-at-all-this-is-corrupt', 'utf8');\n707:     // The generation counter follows the DB dir override, so the live\n708:     // generation the writing daemon published sits beside its database.\n709:     writeFileSync(join(overrideDir, 'skill-graph-generation.json'), `${JSON.stringify({\n710:       generation: 11,\n711:       updatedAt: '2026-04-20T00:00:00.000Z',\n712:       sourceSignature: null,\n713:       reason: 'LIVE_FIXTURE',\n714:       state: 'live',\n715:     })}\\n`, 'utf8');\n716: \n717:     const previous = process.env.SYSTEM_SKILL_ADVISOR_DB_DIR;\n718:     process.env.SYSTEM_SKILL_ADVISOR_DB_DIR = overrideDir;\n719:     try {\n720:       const status = readAdvisorStatus({ workspaceRoot: workspaceRootDir, checkArtifactIntegrity: true });\n721:       // Corruption is read from the OVERRIDE artifact, not the healthy\n722:       // workspace-relative DB, so freshness downgrades to stale.\n723:       expect(status.freshness).toBe('stale');\n724:       expect(status.errors?.some((message) => message.includes('integrity check failed'))).toBe(true);\n725:     } finally {\n726:       if (previous === undefined) {\n727:         delete process.env.SYSTEM_SKILL_ADVISOR_DB_DIR;\n728:       } else {\n729:         process.env.SYSTEM_SKILL_ADVISOR_DB_DIR = previous;\n730:       }\n731:     }\n732:   });\n733: \n734:   it('downgrades a corrupt artifact from live to stale only when integrity is checked', () => {\n735:     const root = workspace('corrupt-artifact');\n736:     writeFileSync(join(root, ADVISOR_DB_RELATIVE_PATH), 'definitely-not-a-valid-sqlite-database-header', 'utf8');\n737:     writeGeneration(root, 'live', 12);\n738: \n739:     // Without the integrity opt-in the generation counters alone report live.\n740:     const optimistic = readAdvisorStatus({ workspaceRoot: root });\n741:     expect(optimistic.freshness).toBe('live');\n742: \n743:     // The recommend path opts in, so the same corrupt artifact reads stale.\n744:     const guarded = readAdvisorStatus({ workspaceRoot: root, checkArtifactIntegrity: true });\n745:     expect(guarded.freshness).toBe('stale');\n746:     expect(guarded.errors?.some((message) => message.includes('integrity check failed'))).toBe(true);\n747:   });\n748: });","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file .skilled/skills/system-skill-advisor/runtime/tests/handlers/advisor-status.vitest.ts, lines 1-748\n1: // ───────────────────────────────────────────────────────────────\n2: // MODULE: Advisor Status Tests\n3: // ───────────────────────────────────────────────────────────────\n4: \n5: import { mkdtempSync, mkdirSync, readFileSync, symlinkSync, utimesSync, writeFileSync } from 'node:fs';\n6: import { join } from 'node:path';\n7: import { tmpdir } from 'node:os';\n8: import Database from 'better-sqlite3';\n9: \n10: import { beforeEach, describe, expect, it, vi } from 'vitest';\n11: \n12: const ollamaMocks = vi.hoisted(() => ({\n13:   probeOllamaModel: vi.fn(),\n14:   resolveOllamaBaseUrl: vi.fn(() => 'http://127.0.0.1:11434'),\n15: }));\n16: \n17: // The handler is the only caller that probes a backend, so the mock keeps\n18: // every other status case free of network access.\n19: vi.mock('../../lib/embedders/adapters/ollama.js', async (importOriginal) => {\n20:   const actual = await importOriginal<typeof import('../../lib/embedders/adapters/ollama.js')>();\n21:   return {\n22:     ...actual,\n23:     probeOllamaModel: ollamaMocks.probeOllamaModel,\n24:     resolveOllamaBaseUrl: ollamaMocks.resolveOllamaBaseUrl,\n25:   };\n26: });\n27: \n28: import { handleAdvisorStatus, readAdvisorStatus } from '../../handlers/advisor-status.js';\n29: import { computeAdvisorSourceSignature } from '../../lib/freshness.js';\n30: import {\n31:   advisorHookDiagnosticsPath,\n32:   createAdvisorHookDiagnosticRecord,\n33:   persistAdvisorHookDiagnosticRecord,\n34: } from '../../lib/metrics.js';\n35: import {\n36:   computeSkillMetadataContentHash,\n37:   readCommandEmbeddingSources,\n38: } from '../../lib/skill-graph/skill-graph-db.js';\n39: import { AdvisorStatusOutputSchema } from '../../schemas/advisor-tool-schemas.js';\n40: \n41: const ADVISOR_DB_RELATIVE_PATH = join(\n42:   '.skilled',\n43:   'skills',\n44:   'system-skill-advisor',\n45:   'runtime',\n46:   'database',\n47:   'skill-graph.sqlite',\n48: );\n49: \n50: function workspace(name: string): string {\n51:   const root = mkdtempSync(join(tmpdir(), `advisor-status-${name}-`));\n52:   mkdirSync(join(root, '.skilled', 'skills', '.state', 'advisor'), { recursive: true });\n53:   mkdirSync(join(root, '.skilled', 'skills', 'system-skill-advisor', 'runtime', 'database'), { recursive: true });\n54:   mkdirSync(join(root, '.skilled', 'skills', 'alpha'), { recursive: true });\n55:   writeFileSync(join(root, '.skilled', 'skills', 'alpha', 'graph-metadata.json'), '{\"skill_id\":\"alpha\"}\\n', 'utf8');\n56:   return root;\n57: }\n58: \n59: function writeGeneration(\n60:   root: string,\n61:   state: 'live' | 'stale' | 'absent' | 'unavailable',\n62:   generation = 1,\n63:   sourceSignature: string | null = null,\n64: ): void {\n65:   writeFileSync(join(root, '.skilled', 'skills', '.state', 'advisor', 'skill-graph-generation.json'), `${JSON.stringify({\n66:     generation,\n67:     updatedAt: '2026-04-20T00:00:00.000Z',\n68:     sourceSignature,\n69:     reason: `${state.toUpperCase()}_FIXTURE`,\n70:     state,\n71:   })}\\n`, 'utf8');\n72: }\n73: \n74: function writeDb(root: string): void {\n75:   writeFileSync(join(root, ADVISOR_DB_RELATIVE_PATH), '', 'utf8');\n76: }\n77: \n78: function writeIndexDb(root: string, contentHash: string | null): void {\n79:   const database = new Database(join(root, ADVISOR_DB_RELATIVE_PATH));\n80:   try {\n81:     database.exec(`\n82:       CREATE TABLE skill_nodes (\n83:         id TEXT PRIMARY KEY,\n84:         source_path TEXT,\n85:         content_hash TEXT\n86:       );\n87:     `);\n88:     database.prepare(`\n89:       INSERT INTO skill_nodes (id, source_path, content_hash)\n90:       VALUES (?, ?, ?)\n91:     `).run(\n92:       'alpha',\n93:       join('.skilled', 'skills', 'alpha', 'graph-metadata.json'),\n94:       contentHash,\n95:     );\n96:   } finally {\n97:     database.close();\n98:   }\n99: }\n100: \n101: function writeHealthDb(root: string): void {\n102:   const database = new Database(join(root, ADVISOR_DB_RELATIVE_PATH));\n103:   try {\n104:     database.exec(`\n105:       CREATE TABLE skill_nodes (\n106:         id TEXT PRIMARY KEY,\n107:         embedding BLOB,\n108:         embedding_model_id TEXT,\n109:         embedding_content_hash TEXT\n110:       );\n111:       CREATE TABLE vec_metadata (key TEXT PRIMARY KEY, value TEXT NOT NULL);\n112:       CREATE TABLE vec_768 (\n113:         skill_id TEXT PRIMARY KEY,\n114:         embedding BLOB NOT NULL,\n115:         model_id TEXT NOT NULL,\n116:         content_hash TEXT NOT NULL,\n117:         updated_at TEXT DEFAULT (datetime('now'))\n118:       );\n119:     `);\n120:     database.prepare('INSERT INTO skill_nodes (id) VALUES (?)').run('alpha');\n121:     database.prepare('INSERT INTO skill_nodes (id) VALUES (?)').run('beta');\n122:     database.prepare('INSERT INTO vec_metadata (key, value) VALUES (?, ?)').run('active_embedder_name', 'nomic-embed-text-v1.5');\n123:     database.prepare('INSERT INTO vec_metadata (key, value) VALUES (?, ?)').run('active_embedder_dim', '768');\n124:     database.prepare('INSERT INTO vec_768 (skill_id, embedding, model_id, content_hash, updated_at) VALUES (?, ?, ?, ?, ?)')\n125:       .run('alpha', Buffer.from([1, 2, 3]), 'nomic-embed-text-v1.5', 'hash-alpha', '2026-04-20T00:00:00.000Z');\n126:   } finally {\n127:     database.close();\n128:   }\n129: }\n130: \n131: function writeCommandVectorTable(root: string, rows: number): void {\n132:   const database = new Database(join(root, ADVISOR_DB_RELATIVE_PATH));\n133:   try {\n134:     database.exec(`\n135:       CREATE TABLE vec_cmd_768 (\n136:         command_id TEXT PRIMARY KEY,\n137:         embedding BLOB NOT NULL,\n138:         model_id TEXT NOT NULL,\n139:         content_hash TEXT NOT NULL,\n140:         updated_at TEXT DEFAULT (datetime('now'))\n141:       );\n142:     `);\n143:     const insert = database.prepare(`\n144:       INSERT INTO vec_cmd_768 (command_id, embedding, model_id, content_hash)\n145:       VALUES (?, ?, ?, ?)\n146:     `);\n147:     for (let index = 0; index < rows; index += 1) {\n148:       insert.run(`command-${index}`, Buffer.from([1, 2, 3]), 'nomic-embed-text-v1.5', `hash-${index}`);\n149:     }\n150:   } finally {\n151:     database.close();\n152:   }\n153: }\n154: \n155: function writeDimMismatchHealthDb(root: string): void {\n156:   const database = new Database(join(root, ADVISOR_DB_RELATIVE_PATH));\n157:   try {\n158:     database.exec(`\n159:       CREATE TABLE skill_nodes (id TEXT PRIMARY KEY, embedding BLOB);\n160:       CREATE TABLE vec_metadata (key TEXT PRIMARY KEY, value TEXT NOT NULL);\n161:       CREATE TABLE vec_123 (\n162:         skill_id TEXT PRIMARY KEY,\n163:         embedding BLOB NOT NULL,\n164:         model_id TEXT NOT NULL,\n165:         content_hash TEXT NOT NULL,\n166:         updated_at TEXT DEFAULT (datetime('now'))\n167:       );\n168:     `);\n169:     database.prepare('INSERT INTO skill_nodes (id) VALUES (?)').run('alpha');\n170:     database.prepare('INSERT INTO vec_metadata (key, value) VALUES (?, ?)').run('active_embedder_name', 'nomic-embed-text-v1.5');\n171:     database.prepare('INSERT INTO vec_metadata (key, value) VALUES (?, ?)').run('active_embedder_dim', '123');\n172:   } finally {\n173:     database.close();\n174:   }\n175: }\n176: \n177: describe('advisor_status handler', () => {\n178:   beforeEach(() => {\n179:     ollamaMocks.probeOllamaModel.mockReset();\n180:     ollamaMocks.resolveOllamaBaseUrl.mockReset();\n181:     ollamaMocks.resolveOllamaBaseUrl.mockReturnValue('http://127.0.0.1:11434');\n182:   });\n183: \n184:   it('includes a private skill linked from inside the skills root in the source signature', () => {\n185:     const root = workspace('linked');\n186:     const skills = join(root, '.skilled', 'skills');\n187:     mkdirSync(join(skills, '.private', 'private-beta'), { recursive: true });\n188:     writeFileSync(join(skills, '.private', 'private-beta', 'SKILL.md'), 'first\\n');\n189:     writeFileSync(join(skills, '.private', 'private-beta', 'graph-metadata.json'), '{\"skill_id\":\"local-beta\"}\\n');\n190:     symlinkSync(join(skills, '.private', 'private-beta'), join(skills, 'local-beta'));\n191:     const before = computeAdvisorSourceSignature(root);\n192:     writeFileSync(join(skills, '.private', 'private-beta', 'SKILL.md'), 'second\\n');\n193:     expect(computeAdvisorSourceSignature(root)).not.toBe(before);\n194:   });\n195: \n196:   it('ignores a private skill linked from outside every trusted root', () => {\n197:     const root = workspace('outside');\n198:     const skills = join(root, '.skilled', 'skills');\n199:     const outside = join(root, 'outside-beta');\n200:     mkdirSync(outside, { recursive: true });\n201:     writeFileSync(join(outside, 'SKILL.md'), 'first\\n');\n202:     writeFileSync(join(outside, 'graph-metadata.json'), '{\"skill_id\":\"local-beta\"}\\n');\n203:     symlinkSync(outside, join(skills, 'local-beta'));\n204:     const before = computeAdvisorSourceSignature(root);\n205:     writeFileSync(join(outside, 'SKILL.md'), 'second\\n');\n206:     expect(computeAdvisorSourceSignature(root)).toBe(before);\n207:   });\n208: \n209:   it('includes a private skill linked into a declared external root', () => {\n210:     const root = workspace('declared');\n211:     const skills = join(root, '.skilled', 'skills');\n212:     const external = join(root, 'private-repos');\n213:     const target = join(external, 'sk-code-webflow');\n214:     mkdirSync(target, { recursive: true });\n215:     writeFileSync(join(target, 'SKILL.md'), 'first\\n');\n216:     writeFileSync(join(target, 'graph-metadata.json'), '{\"skill_id\":\"local-webflow\"}\\n');\n217:     symlinkSync(target, join(skills, 'local-webflow'));\n218:     process.env.SPECKIT_PRIVATE_SKILL_ROOTS = external;\n219:     try {\n220:       const before = computeAdvisorSourceSignature(root);\n221:       writeFileSync(join(target, 'SKILL.md'), 'second\\n');\n222:       expect(computeAdvisorSourceSignature(root)).not.toBe(before);\n223:     } finally {\n224:       delete process.env.SPECKIT_PRIVATE_SKILL_ROOTS;\n225:     }\n226:   });\n227: \n228:   // drift: verified against shipped behavior during Unit H\n229:   it('reports live freshness', () => {\n230:     const root = workspace('live');\n231:     writeDb(root);\n232:     writeGeneration(root, 'live', 3);\n233: \n234:     const status = readAdvisorStatus({ workspaceRoot: root });\n235: \n236:     expect(status.freshness).toBe('live');\n237:     expect(status.trustState.state).toBe('live');\n238:     expect(status.generation).toBe(3);\n239:     expect(status.trustState.lastLiveAt).toBe('2026-04-20T00:00:00.000Z');\n240:     expect(status.lastScanAt).toBe('2026-04-20T00:00:00.000Z');\n241:     expect(status.skillCount).toBe(1);\n242:     expect(status.laneWeights.explicit_author).toBe(0.42);\n243:     expect(status.semanticLaneHealth).toBeUndefined();\n244:   });\n245: \n246:   it('reports fresh index hashes without changing a live generation', () => {\n247:     const root = workspace('index-fresh');\n248:     const metadataPath = join(root, '.skilled', 'skills', 'alpha', 'graph-metadata.json');\n249:     const contentHash = computeSkillMetadataContentHash(readFileSync(metadataPath, 'utf8'));\n250:     writeIndexDb(root, contentHash);\n251:     writeGeneration(root, 'live', 3, computeAdvisorSourceSignature(root));\n252: \n253:     const status = readAdvisorStatus({ workspaceRoot: root });\n254: \n255:     expect(status.freshness).toBe('live');\n256:     expect(status.indexStaleness).toEqual({\n257:       state: 'fresh',\n258:       reason: null,\n259:       trackedSkills: 1,\n260:       freshSourceFiles: 1,\n261:       changedSourceFiles: 0,\n262:       missingSourceFiles: 0,\n263:       staleSkillIds: [],\n264:     });\n265:   });\n266: \n267:   it('marks live generations stale when index hashes differ from disk', () => {\n268:     const root = workspace('index-stale');\n269:     writeIndexDb(root, 'outdated-hash');\n270:     writeGeneration(root, 'live', 4, computeAdvisorSourceSignature(root));\n271: \n272:     const status = readAdvisorStatus({ workspaceRoot: root });\n273: \n274:     expect(status.freshness).toBe('stale');\n275:     expect(status.trustState.state).toBe('stale');\n276:     expect(status.indexStaleness).toEqual(expect.objectContaining({\n277:       state: 'stale',\n278:       reason: 'source_hash_mismatch',\n279:       changedSourceFiles: 1,\n280:     }));\n281:     expect(status.errors).toContain(\n282:       'advisor_status index content hashes differ from disk for 1 skill; run advisor_rebuild',\n283:     );\n284:   });\n285: \n286:   it('reports unavailable index staleness when the database is absent', () => {\n287:     const root = workspace('index-absent');\n288:     writeGeneration(root, 'live', 5, computeAdvisorSourceSignature(root));\n289: \n290:     const status = readAdvisorStatus({ workspaceRoot: root });\n291: \n292:     expect(status.indexStaleness).toEqual(expect.objectContaining({\n293:       state: 'unavailable',\n294:       reason: 'database_absent',\n295:     }));\n296:   });\n297: \n298:   it('reports semantic-lane health only when requested', () => {\n299:     const root = workspace('semantic-health');\n300:     writeHealthDb(root);\n301:     writeGeneration(root, 'live', 8);\n302: \n303:     const compact = readAdvisorStatus({ workspaceRoot: root });\n304:     const detailed = readAdvisorStatus({ workspaceRoot: root, includeSemanticHealth: true });\n305: \n306:     expect(compact.semanticLaneHealth).toBeUndefined();\n307:     expect(detailed.semanticLaneHealth).toEqual(expect.objectContaining({\n308:       activeEmbedder: expect.objectContaining({\n309:         name: 'nomic-embed-text-v1.5',\n310:         dim: 768,\n311:         adapterDim: 768,\n312:       }),\n313:       vectorCoverage: {\n314:         embedded: 1,\n315:         total: 2,\n316:         ratio: 0.5,\n317:       },\n318:       dimMismatch: false,\n319:       lastRefresh: '2026-04-20T00:00:00.000Z',\n320:       disabledReason: null,\n321:       laneEnabled: true,\n322:     }));\n323:   });\n324: \n325:   it('surfaces semantic-lane dim mismatch as a disabled reason', () => {\n326:     const root = workspace('semantic-dim-mismatch');\n327:     writeDimMismatchHealthDb(root);\n328:     writeGeneration(root, 'live', 9);\n329: \n330:     const status = readAdvisorStatus({ workspaceRoot: root, includeSemanticHealth: true });\n331: \n332:     expect(status.semanticLaneHealth).toEqual(expect.objectContaining({\n333:       activeEmbedder: expect.objectContaining({\n334:         name: 'nomic-embed-text-v1.5',\n335:         dim: 123,\n336:         adapterDim: 768,\n337:       }),\n338:       dimMismatch: true,\n339:       disabledReason: 'dim_mismatch',\n340:       laneEnabled: false,\n341:     }));\n342:   });\n343: \n344:   it('reports zero command-vector coverage when no command table exists', () => {\n345:     const root = workspace('command-coverage-absent');\n346:     writeHealthDb(root);\n347:     writeGeneration(root, 'live', 10);\n348: \n349:     const status = readAdvisorStatus({ workspaceRoot: root, includeSemanticHealth: true });\n350:     const sourceTotal = readCommandEmbeddingSources()?.length ?? 0;\n351: \n352:     expect(status.semanticLaneHealth?.commandVectorCoverage).toEqual({\n353:       embedded: 0,\n354:       total: sourceTotal,\n355:     });\n356:   });\n357: \n358:   it('counts command-vector rows when the command table exists', () => {\n359:     const root = workspace('command-coverage-present');\n360:     writeHealthDb(root);\n361:     writeCommandVectorTable(root, 3);\n362:     writeGeneration(root, 'live', 10);\n363: \n364:     const status = readAdvisorStatus({ workspaceRoot: root, includeSemanticHealth: true });\n365:     const sourceTotal = readCommandEmbeddingSources()?.length ?? 0;\n366: \n367:     expect(status.semanticLaneHealth?.commandVectorCoverage).toEqual({\n368:       embedded: 3,\n369:       total: sourceTotal,\n370:     });\n371:   });\n372: \n373:   it('reports a reachable backend when the model is loaded', async () => {\n374:     const root = workspace('backend-reachable');\n375:     writeHealthDb(root);\n376:     writeGeneration(root, 'live', 14);\n377:     ollamaMocks.probeOllamaModel.mockResolvedValue({ available: true });\n378: \n379:     const response = await handleAdvisorStatus({ workspaceRoot: root, includeSemanticHealth: true });\n380:     const envelope = JSON.parse(response.content[0].text) as { data: unknown };\n381:     const status = AdvisorStatusOutputSchema.parse(envelope.data);\n382: \n383:     expect(ollamaMocks.probeOllamaModel).toHaveBeenCalledWith(\n384:       'http://127.0.0.1:11434',\n385:       'nomic-embed-text:v1.5',\n386:       500,\n387:     );\n388:     expect(status.semanticLaneHealth?.backend).toEqual({ state: 'reachable', reason: null });\n389:     expect(status.semanticLaneHealth?.laneEnabled).toBe(true);\n390:   });\n391: \n392:   it('reports an unreachable backend when the probe cannot connect', async () => {\n393:     const root = workspace('backend-unreachable');\n394:     writeHealthDb(root);\n395:     writeGeneration(root, 'live', 14);\n396:     const reason = 'Ollama backend unreachable at http://127.0.0.1:11434: fetch failed';\n397:     ollamaMocks.probeOllamaModel.mockResolvedValue({ available: false, reason });\n398: \n399:     const response = await handleAdvisorStatus({ workspaceRoot: root, includeSemanticHealth: true });\n400:     const envelope = JSON.parse(response.content[0].text) as { data: unknown };\n401:     const status = AdvisorStatusOutputSchema.parse(envelope.data);\n402: \n403:     expect(status.semanticLaneHealth?.backend).toEqual({ state: 'unreachable', reason });\n404:     expect(status.semanticLaneHealth?.laneEnabled).toBe(false);\n405:   });\n406: \n407:   it('reports a missing model when the server answers without it', async () => {\n408:     const root = workspace('backend-model-missing');\n409:     writeHealthDb(root);\n410:     writeGeneration(root, 'live', 14);\n411:     const reason = 'Ollama model is not loaded: nomic-embed-text:v1.5';\n412:     ollamaMocks.probeOllamaModel.mockResolvedValue({ available: false, reason });\n413: \n414:     const response = await handleAdvisorStatus({ workspaceRoot: root, includeSemanticHealth: true });\n415:     const envelope = JSON.parse(response.content[0].text) as { data: unknown };\n416:     const status = AdvisorStatusOutputSchema.parse(envelope.data);\n417: \n418:     expect(status.semanticLaneHealth?.backend).toEqual({ state: 'model_missing', reason });\n419:     expect(status.semanticLaneHealth?.laneEnabled).toBe(false);\n420:   });\n421: \n422:   // drift: verified against shipped behavior during Unit H\n423:   it('keeps signed generations live when source mtimes exceed skipped SQLite writes', () => {\n424:     const root = workspace('signed-live');\n425:     writeDb(root);\n426:     const dbPath = join(root, ADVISOR_DB_RELATIVE_PATH);\n427:     const metadataPath = join(root, '.skilled', 'skills', 'alpha', 'graph-metadata.json');\n428:     utimesSync(dbPath, new Date('2026-04-19T00:00:00.000Z'), new Date('2026-04-19T00:00:00.000Z'));\n429:     utimesSync(metadataPath, new Date('2026-04-21T00:00:00.000Z'), new Date('2026-04-21T00:00:00.000Z'));\n430:     const sourceSignature = computeAdvisorSourceSignature(root);\n431:     writeFileSync(join(root, '.skilled', 'skills', '.state', 'advisor', 'skill-graph-generation.json'), `${JSON.stringify({\n432:       generation: 9,\n433:       updatedAt: '2026-04-22T00:00:00.000Z',\n434:       sourceSignature,\n435:       reason: 'advisor_rebuild',\n436:       state: 'live',\n437:     })}\\n`, 'utf8');\n438: \n439:     const status = readAdvisorStatus({ workspaceRoot: root });\n440: \n441:     expect(status.freshness).toBe('live');\n442:     expect(status.trustState.state).toBe('live');\n443:   });\n444: \n445:   // drift: verified against shipped behavior during Unit H\n446:   it('marks live generations stale when nested graph metadata is newer than the database', () => {\n447:     const root = workspace('nested-mtime');\n448:     writeDb(root);\n449:     writeGeneration(root, 'live', 6);\n450:     const dbPath = join(root, ADVISOR_DB_RELATIVE_PATH);\n451:     const metadataPath = join(root, '.skilled', 'skills', 'alpha', 'graph-metadata.json');\n452:     utimesSync(dbPath, new Date('2026-04-19T00:00:00.000Z'), new Date('2026-04-19T00:00:00.000Z'));\n453:     utimesSync(metadataPath, new Date('2026-04-21T00:00:00.000Z'), new Date('2026-04-21T00:00:00.000Z'));\n454: \n455:     const status = readAdvisorStatus({ workspaceRoot: root });\n456: \n457:     expect(status.freshness).toBe('stale');\n458:     expect(status.trustState.lastLiveAt).toBe('2026-04-20T00:00:00.000Z');\n459:   });\n460: \n461:   // drift: verified against shipped behavior during Unit H\n462:   it('reports stale freshness', () => {\n463:     const root = workspace('stale');\n464:     writeDb(root);\n465:     writeGeneration(root, 'stale', 4);\n466: \n467:     const status = readAdvisorStatus({ workspaceRoot: root });\n468: \n469:     expect(status.freshness).toBe('stale');\n470:     expect(status.trustState.reason).toBe('STALE_FIXTURE');\n471:   });\n472: \n473:   it('reports absent freshness when no artifact exists', () => {\n474:     const root = workspace('absent');\n475:     writeGeneration(root, 'absent', 0);\n476: \n477:     const status = readAdvisorStatus({ workspaceRoot: root });\n478: \n479:     expect(status.freshness).toBe('absent');\n480:   });\n481: \n482:   // drift: verified against shipped behavior during Unit H\n483:   it('reports unavailable for corrupt generation metadata', () => {\n484:     const root = workspace('unavailable');\n485:     writeFileSync(join(root, '.skilled', 'skills', '.state', 'advisor', 'skill-graph-generation.json'), '{', 'utf8');\n486: \n487:     const status = readAdvisorStatus({ workspaceRoot: root });\n488: \n489:     expect(status.freshness).toBe('unavailable');\n490:     expect(status.errors?.length).toBeGreaterThan(0);\n491:   });\n492: \n493:   it('does not leak prompt content in status output', async () => {\n494:     const root = workspace('privacy');\n495:     writeDb(root);\n496:     writeGeneration(root, 'live', 5);\n497: \n498:     const raw = (await handleAdvisorStatus({ workspaceRoot: root })).content[0].text;\n499: \n500:     expect(raw).not.toContain('prompt');\n501:     expect(raw).not.toContain('secret@example.com');\n502:   });\n503: \n504:   it('omits embeddings health when the option is absent', async () => {\n505:     const root = workspace('embeddings-health-omitted');\n506:     const response = await handleAdvisorStatus({ workspaceRoot: root });\n507:     const envelope = JSON.parse(response.content[0].text) as { data: unknown };\n508:     const status = AdvisorStatusOutputSchema.parse(envelope.data);\n509: \n510:     expect(status).not.toHaveProperty('embeddingsHealth');\n511:   });\n512: \n513:   it('reports hook health from durable diagnostic records', async () => {\n514:     const root = workspace('hook-health');\n515:     const previousDebug = process.env.SKILL_ADVISOR_DEBUG;\n516:     process.env.SKILL_ADVISOR_DEBUG = '1';\n517:     try {\n518:       for (const durationMs of [10, 30]) {\n519:         await persistAdvisorHookDiagnosticRecord(root, createAdvisorHookDiagnosticRecord({\n520:           runtime: 'claude',\n521:           status: 'ok',\n522:           freshness: 'live',\n523:           durationMs,\n524:           cacheHit: true,\n525:         }));\n526:       }\n527: \n528:       const status = readAdvisorStatus({ workspaceRoot: root });\n529: \n530:       expect(status.hookHealth?.invocations).toBe(2);\n531:     } finally {\n532:       if (previousDebug === undefined) delete process.env.SKILL_ADVISOR_DEBUG;\n533:       else process.env.SKILL_ADVISOR_DEBUG = previousDebug;\n534:     }\n535:   });\n536: \n537:   it('writes a health record without the debug variable and keeps the skill label out', async () => {\n538:     const root = workspace('hook-health-default');\n539:     const previousDebug = process.env.SKILL_ADVISOR_DEBUG;\n540:     delete process.env.SKILL_ADVISOR_DEBUG;\n541:     try {\n542:       await persistAdvisorHookDiagnosticRecord(root, createAdvisorHookDiagnosticRecord({\n543:         runtime: 'claude',\n544:         status: 'ok',\n545:         freshness: 'live',\n546:         durationMs: 12,\n547:         cacheHit: true,\n548:         skillLabel: 'sk-doc',\n549:         errorDetails: 'probe detail',\n550:         degraded: true,\n551:       }));\n552: \n553:       const lines = readFileSync(advisorHookDiagnosticsPath(root), 'utf8').trimEnd().split('\\n');\n554:       expect(lines).toHaveLength(1);\n555:       const record = JSON.parse(lines[0] ?? '{}') as Record<string, unknown>;\n556:       expect(record).not.toHaveProperty('skillLabel');\n557:       expect(record).not.toHaveProperty('errorDetails');\n558:       expect(record.degraded).toBe(true);\n559:       expect(readAdvisorStatus({ workspaceRoot: root }).hookHealth?.invocations).toBe(1);\n560:     } finally {\n561:       if (previousDebug === undefined) delete process.env.SKILL_ADVISOR_DEBUG;\n562:       else process.env.SKILL_ADVISOR_DEBUG = previousDebug;\n563:     }\n564:   });\n565: \n566:   it('trims the default health log to 200 records', async () => {\n567:     const root = workspace('hook-health-trim');\n568:     const previousDebug = process.env.SKILL_ADVISOR_DEBUG;\n569:     delete process.env.SKILL_ADVISOR_DEBUG;\n570:     try {\n571:       for (let index = 0; index < 301; index += 1) {\n572:         await persistAdvisorHookDiagnosticRecord(root, createAdvisorHookDiagnosticRecord({\n573:           runtime: 'claude',\n574:           status: 'ok',\n575:           freshness: 'live',\n576:           durationMs: index,\n577:           cacheHit: true,\n578:         }));\n579:       }\n580: \n581:       const lines = readFileSync(advisorHookDiagnosticsPath(root), 'utf8').trimEnd().split('\\n');\n582:       expect(lines).toHaveLength(200);\n583:     } finally {\n584:       if (previousDebug === undefined) delete process.env.SKILL_ADVISOR_DEBUG;\n585:       else process.env.SKILL_ADVISOR_DEBUG = previousDebug;\n586:     }\n587:   });\n588: \n589:   it('reports the newest record time and the degraded share', async () => {\n590:     const root = workspace('hook-health-degraded');\n591:     await persistAdvisorHookDiagnosticRecord(root, createAdvisorHookDiagnosticRecord({\n592:       runtime: 'claude',\n593:       status: 'ok',\n594:       freshness: 'live',\n595:       durationMs: 10,\n596:       cacheHit: true,\n597:       timestamp: '2026-11-13T08:00:00.000Z',\n598:       degraded: true,\n599:     }));\n600:     await persistAdvisorHookDiagnosticRecord(root, createAdvisorHookDiagnosticRecord({\n601:       runtime: 'claude',\n602:       status: 'ok',\n603:       freshness: 'live',\n604:       durationMs: 30,\n605:       cacheHit: true,\n606:       timestamp: '2026-11-13T08:00:05.000Z',\n607:     }));\n608: \n609:     const status = readAdvisorStatus({ workspaceRoot: root });\n610:     const parsed = AdvisorStatusOutputSchema.parse(status);\n611: \n612:     expect(parsed.hookHealth?.invocations).toBe(2);\n613:     expect(parsed.hookHealth?.lastRecordAt).toBe('2026-11-13T08:00:05.000Z');\n614:     expect(parsed.hookHealth?.rollingDegradedRate).toBe(0.5);\n615:   });\n616: \n617:   it('omits hook health when no diagnostic records exist', () => {\n618:     const root = workspace('hook-health-absent');\n619: \n620:     const status = readAdvisorStatus({ workspaceRoot: root });\n621: \n622:     expect(status).not.toHaveProperty('hookHealth');\n623:   });\n624: \n625:   it('returns a schema-valid unavailable model-server state when requested', async () => {\n626:     const root = workspace('embeddings-health-unavailable');\n627:     const originalServerUrl = process.env.HF_EMBED_SERVER_URL;\n628: \n629:     try {\n630:       process.env.HF_EMBED_SERVER_URL = join(root, 'missing-hf-embed.sock');\n631:       const response = await handleAdvisorStatus({\n632:         workspaceRoot: root,\n633:         includeEmbeddingsHealth: true,\n634:       });\n635:       const envelope = JSON.parse(response.content[0].text) as { data: unknown };\n636:       const status = AdvisorStatusOutputSchema.parse(envelope.data);\n637: \n638:       expect(status.embeddingsHealth?.modelServer.state).toBe('unavailable');\n639:     } finally {\n640:       if (originalServerUrl === undefined) delete process.env.HF_EMBED_SERVER_URL;\n641:       else process.env.HF_EMBED_SERVER_URL = originalServerUrl;\n642:     }\n643:   });\n644: \n645:   // drift: verified against shipped behavior during Unit H\n646:   it('caps metadata scanning when requested to avoid unbounded status walks', () => {\n647:     const root = workspace('scan-cap');\n648:     writeDb(root);\n649:     writeGeneration(root, 'live', 7);\n650:     mkdirSync(join(root, '.skilled', 'skills', 'beta'), { recursive: true });\n651:     writeFileSync(join(root, '.skilled', 'skills', 'beta', 'graph-metadata.json'), '{\"skill_id\":\"beta\"}\\n', 'utf8');\n652: \n653:     const status = readAdvisorStatus({ workspaceRoot: root, maxMetadataFiles: 1 });\n654: \n655:     expect(status.skillCount).toBe(1);\n656:     expect(status.errors).toEqual([\n657:       expect.stringContaining('metadata scan capped at 1 files'),\n658:     ]);\n659:   });\n660: \n661:   it('counts only depth-one skill roots with graph metadata', () => {\n662:     const root = workspace('root-only-scan');\n663:     writeDb(root);\n664:     writeGeneration(root, 'live', 7);\n665:     mkdirSync(join(root, '.skilled', 'skills', 'beta'), { recursive: true });\n666:     writeFileSync(join(root, '.skilled', 'skills', 'beta', 'graph-metadata.json'), '{\"skill_id\":\"beta\"}\\n', 'utf8');\n667:     mkdirSync(join(root, '.skilled', 'skills', 'alpha', 'nested'), { recursive: true });\n668:     writeFileSync(join(root, '.skilled', 'skills', 'alpha', 'nested', 'graph-metadata.json'), '{\"skill_id\":\"nested\"}\\n', 'utf8');\n669: \n670:     const status = readAdvisorStatus({ workspaceRoot: root });\n671: \n672:     expect(status.skillCount).toBe(2);\n673:   });\n674: \n675:   it('counts a private skill linked from inside the skills root and not one linked from outside', () => {\n676:     const root = workspace('private-link-scan');\n677:     writeDb(root);\n678:     writeGeneration(root, 'live', 7);\n679:     const skills = join(root, '.skilled', 'skills');\n680:     const inside = join(skills, '.private', 'private-beta');\n681:     const outside = join(root, 'outside', 'private-evil');\n682:     for (const dir of [inside, outside]) {\n683:       mkdirSync(dir, { recursive: true });\n684:       writeFileSync(join(dir, 'graph-metadata.json'), '{\"skill_id\":\"local-x\"}\\n', 'utf8');\n685:     }\n686:     symlinkSync(inside, join(skills, 'local-beta'));\n687:     symlinkSync(outside, join(skills, 'local-evil'));\n688: \n689:     const status = readAdvisorStatus({ workspaceRoot: root });\n690: \n691:     // The fixture's own skill plus the trusted link; the outside link is not counted.\n692:     expect(status.skillCount).toBe(2);\n693:   });\n694: \n695:   it('probes the env-override artifact path the writer uses, read live', () => {\n696:     // The probe must target the file the writing daemon actually opens. With an\n697:     // env override set, the writer resolves there; the probe must too, even\n698:     // when called with an unrelated workspaceRoot. A healthy DB under the\n699:     // workspace would mask a corrupt override DB if the probe used the wrong\n700:     // base.\n701:     const workspaceRootDir = workspace('override-probe-workspace');\n702:     writeDb(workspaceRootDir);\n703:     writeGeneration(workspaceRootDir, 'live', 11);\n704: \n705:     const overrideDir = mkdtempSync(join(tmpdir(), 'advisor-status-override-'));\n706:     writeFileSync(join(overrideDir, 'skill-graph.sqlite'), 'not-a-sqlite-database-file-at-all-this-is-corrupt', 'utf8');\n707:     // The generation counter follows the DB dir override, so the live\n708:     // generation the writing daemon published sits beside its database.\n709:     writeFileSync(join(overrideDir, 'skill-graph-generation.json'), `${JSON.stringify({\n710:       generation: 11,\n711:       updatedAt: '2026-04-20T00:00:00.000Z',\n712:       sourceSignature: null,\n713:       reason: 'LIVE_FIXTURE',\n714:       state: 'live',\n715:     })}\\n`, 'utf8');\n716: \n717:     const previous = process.env.SYSTEM_SKILL_ADVISOR_DB_DIR;\n718:     process.env.SYSTEM_SKILL_ADVISOR_DB_DIR = overrideDir;\n719:     try {\n720:       const status = readAdvisorStatus({ workspaceRoot: workspaceRootDir, checkArtifactIntegrity: true });\n721:       // Corruption is read from the OVERRIDE artifact, not the healthy\n722:       // workspace-relative DB, so freshness downgrades to stale.\n723:       expect(status.freshness).toBe('stale');\n724:       expect(status.errors?.some((message) => message.includes('integrity check failed'))).toBe(true);\n725:     } finally {\n726:       if (previous === undefined) {\n727:         delete process.env.SYSTEM_SKILL_ADVISOR_DB_DIR;\n728:       } else {\n729:         process.env.SYSTEM_SKILL_ADVISOR_DB_DIR = previous;\n730:       }\n731:     }\n732:   });\n733: \n734:   it('downgrades a corrupt artifact from live to stale only when integrity is checked', () => {\n735:     const root = workspace('corrupt-artifact');\n736:     writeFileSync(join(root, ADVISOR_DB_RELATIVE_PATH), 'definitely-not-a-valid-sqlite-database-header', 'utf8');\n737:     writeGeneration(root, 'live', 12);\n738: \n739:     // Without the integrity opt-in the generation counters alone report live.\n740:     const optimistic = readAdvisorStatus({ workspaceRoot: root });\n741:     expect(optimistic.freshness).toBe('live');\n742: \n743:     // The recommend path opts in, so the same corrupt artifact reads stale.\n744:     const guarded = readAdvisorStatus({ workspaceRoot: root, checkArtifactIntegrity: true });\n745:     expect(guarded.freshness).toBe('stale');\n746:     expect(guarded.errors?.some((message) => message.includes('integrity check failed'))).toBe(true);\n747:   });\n748: });"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\": \".skilled/skills/system-skill-advisor/runtime/tests/handlers/advisor-status.vitest.ts\"}"},"time":{"start":1794570810115,"end":1794570810326}}}}
{"type":"step_finish","timestamp":1794570812132,"sessionID":"ses_e2b4a23c4ffeXM7ei3r7kNeMRl","part":{"id":"prt_1d4c17ae4001WhaAkHSfA0S0V4","sessionID":"ses_e2b4a23c4ffeXM7ei3r7kNeMRl","messageID":"msg_1d4c1432e001ykAQ0SCjhEBqzm","type":"step-finish","reason":"tool-calls","snapshot":"64b35544cf118283cae47b34d4c42d5e0841bcb4","cost":0,"tokens":{"input":313,"output":62,"reasoning":902,"cache":{"read":147328,"write":0}}}}
{"type":"step_start","timestamp":1794570816287,"sessionID":"ses_e2b4a23c4ffeXM7ei3r7kNeMRl","part":{"id":"prt_1d4c18b1f001zTm046xzTMpqJ6","sessionID":"ses_e2b4a23c4ffeXM7ei3r7kNeMRl","messageID":"msg_1d4c17aed001zEATshOlGpA6Ww","type":"step-start","snapshot":"64b35544cf118283cae47b34d4c42d5e0841bcb4"}}
{"type":"tool_use","timestamp":1794570856931,"sessionID":"ses_e2b4a23c4ffeXM7ei3r7kNeMRl","part":{"partID":"prt_1d4c1b6700020pW36IEviFIdKn","sessionID":"ses_e2b4a23c4ffeXM7ei3r7kNeMRl","messageID":"msg_1d4c17aed001zEATshOlGpA6Ww","type":"tool","id":"chatcmpl-tool-8ec114f8506a05d3","tool":"write","state":{"status":"completed","input":{"content":"# Review Iteration 002\n\n## Dispatcher\n\n- Run: `fanout-scorer-attach-2-1794570021136-noekp0` (lineage `scorer-attach-2`, pass two, area `scorer-attach`)\n- Mode: review; executor: in-process (no nested dispatch)\n- Dimension: security\n- Review focus addressed: the operator focus names \"safety of offering a mutating command\" and \"holdout hygiene, so no tune, fix or report path reads or leaks holdout rows\". This iteration re-proves the mutating-command invariant against the changed tables (pass one's claim was \"no `run` row writes\"), then re-reads the two changed files that could carry a leak: the status handler and its test.\n- Budget profile: `verify` (11-13 calls), used 11.\n\n## Files Reviewed\n\n- `.skilled/skills/system-skill-advisor/runtime/lib/command-attach.ts:257-349` (gate, pattern, attach path)\n- `.skilled/skills/system-skill-advisor/runtime/lib/scorer/fusion.ts:675-680` (the same pattern in the scorer path, and its base revision)\n- `.skilled/skills/system-skill-advisor/runtime/handlers/advisor-status.ts:1-567` (whole file, changed)\n- `.skilled/skills/system-skill-advisor/runtime/tests/handlers/advisor-status.vitest.ts:1-748` (whole file, changed)\n- Executed whole-table invariants over the live module (below).\n\n## Findings - New\n\n### P0 Findings\n\nNone.\n\n### P1 Findings\n\nNone.\n\n### P2 Findings\n\n1. **The no-edit gate does not fire on \"don't change\" or \"no changes\", so a writing command is still offered** -- `.skilled/skills/system-skill-advisor/runtime/lib/command-attach.ts:289` -- `NO_EDIT_REQUEST` covers `do not (change|edit|modify|touch)` but not the contracted forms `don't change`, nor the noun form `no changes`. The pass-one fix (`command-attach.ts:329`) now applies the pattern to every hub, so the gap reaches every attached command rather than the deep-loop one. This is not a re-report of `R2-P2-001` — that fix holds; the pattern it reads is narrower than the wording it names.\n   Finding class: security_policy_vocabulary_gap\n   Scope proof: `NO_EDIT_REQUEST` is declared and exported in `runtime/lib/command-attach.ts` (scorer-attach scope) and consumed by the attach path at `:329` and by `fusion.ts:677`, `:881`.\n   Affected surface hints: hub command attachment for every hub; scorer read-only lift; hook briefs that surface the command.\n   Case: `attachCommand('sk-doc', { action: 'route', selectionKind: 'single', targets: [{ workflowMode: 'sk-create-skill' }] }, \"create a skill called invoice-parser, don't change anything yet\")` returns `/create:skill` with tracked policy `start`; the same prompt with \"no changes yet\" also returns `/create:skill`. Executed against the live module, both reported `noEdit: false`.\n   Claim: the gate withholds a command on \"do not change anything yet\" but not on the two most common paraphrases of the same instruction.\n   Evidence refs: `command-attach.ts:289`, `command-attach.ts:329`, `fusion.ts:677`\n   Counterevidence sought: checked whether the pattern was widened in the reviewed range (it was copied unchanged from the base `fusion.ts:675` inline regex), and whether `start` makes the offer harmless (it asks before writing, and `AGENTS.md:68` says an explicit instruction outranks the policy).\n   Alternative explanation: the vocabulary is deliberately narrow to avoid withholding a command on a sentence that asks for a change while mentioning a restriction elsewhere.\n   Final severity: P2 (the offered policy is `start`, which asks before writing; no silent write path)\n   Confidence: high\n   Downgrade trigger: withdraw if `NO_EDIT_REQUEST` is widened by another change in this range, or if a caller starts treating a `start` offer as authority to run without asking.\n\n2. **The privacy guard at `advisor-status.vitest.ts:493` cannot fail because the fixture never stores anything private** -- `.skilled/skills/system-skill-advisor/runtime/tests/handlers/advisor-status.vitest.ts:493` -- The test named \"does not leak prompt content in status output\" builds `workspace('privacy')`, writes an empty DB file and a generation record, then asserts the serialized output contains neither `prompt` nor `secret@example.com`. No diagnostic record, prompt or secret is ever written, so the assertion is true for an empty status and would stay green if the handler later echoed a stored prompt. Holdout hygiene is the one operator check that depends on a test like this actually exercising the read path.\n   Finding class: vacuous_privacy_assertion\n   Scope proof: the test lives in `runtime/tests/handlers/advisor-status.vitest.ts` (scorer-attach scope) and its subject `readAdvisorHookHealthSection` is reached from `advisor-status.ts:487`, which this iteration read.\n   Affected surface hints: `advisor_status` output; hook diagnostic record read path; holdout/privacy assurance for the status surface.\n   Case: the fixture at `:494-496` writes only `skill-graph.sqlite` (empty) and `skill-graph-generation.json`; then `handleAdvisorStatus({ workspaceRoot: root })` is serialized and searched. There is no record containing `secret@example.com` for the assertion to exclude, so the case passes identically before and after any leak is introduced.\n   Finding class (second line retained for the reducer): privacy_test_gap\n   Claim: the assertion does not exercise the path that could leak.\n   Evidence refs: `tests/handlers/advisor-status.vitest.ts:493-502`, `handlers/advisor-status.ts:487-512`\n   Counterevidence sought: the neighbouring test at `:537-564` proves the writer strips `errorDetails` and `skillLabel`, so the write path is covered; what is uncovered is the *read* path echoing a record that already contains such text.\n   Alternative explanation: the test may be a smoke check that the schema has no prompt-shaped field, which it does prove for the empty case.\n   Final severity: P2 (assurance gap, no reachable leak shown)\n   Confidence: medium\n   Downgrade trigger: withdraw if a fixture elsewhere in the suite persists a prompt-bearing record and asserts its absence from `advisor_status` output.\n\n## Security Checks (executed)\n\n- **Mutating-command invariant.** Loaded `command-attach.ts` through `node --experimental-strip-types` and enumerated the live tables: 56 `COMMAND_ROWS`, 19 with `policy: 'run'`, 0 of those carrying `mutating: 'mutates'`, and 0 rows with no class at all. Pass one's \"no `run` row writes\" claim holds on the current table. The two `run` + `add-only` rows (`/doctor:deep-loop`, `/doctor:speckit`) are the deferred decision in pass-one section 8 and are not re-reported here.\n- **Policy/owner parity.** For the 63 `TRACKED_COMMANDS` entries, every command that also has a `COMMAND_ROWS` row agrees on `policy` and `ownerSkillId` (0 mismatches). The 11 commands without a row (`/create:benchmark`, `/create:command`, `/create:diff`, `/create:goal`, `/create:repo-rule`, `/create:skill-parent`, `/create:with-human-voice`, `/deep:ai-council`, `/design:chart`, `/design:diagram`, `/design:extract`) are exactly the set pass one named; they take their policy from `TRACKED_COMMANDS` at `advisor-recommend.ts:483`, so deleting the old table did not strip it.\n- **Holdout hygiene on this surface.** `advisor-status.ts` reads no prompt fixture; the only prompt-shaped strings in its output are schema keys and redacted diagnostics (`:519` uses `redactDiagnosticText`). `derive-command-bridges.cjs` reads no prompt fixture either (searched for `prompts`, `jsonl`, `holdout`: no hits). No holdout prompt text was read or printed in this iteration; no holdout counts were needed.\n\n## Traceability Checks\n\n- `spec_code` — partial. The `run` policy means \"safe to start without asking\" and the table honours it; the no-edit wording is narrower than the packet's stated intent, recorded as `SA2-P2-002`.\n- `checklist_evidence` — pending. No checklist claim in focus.\n- `feature_catalog_code` — pending; `command-meaning-matching.md` and the command-bridges README are the traceability iteration's job.\n- `skill_agent`, `agent_cross_runtime`, `playbook_capability` — pending / notApplicable.\n\n## Integration Evidence\n\n- `.skilled/skills/system-skill-advisor/runtime/handlers/advisor-recommend.ts:478-485` is the only production path that turns an attached command into a `policy`; it reads `TRACKED_COMMANDS` (`:483`), not `COMMAND_ROWS`, which is why the 11 row-less commands still carry a policy.\n- `.skilled/skills/system-skill-advisor/runtime/lib/scorer/fusion.ts:20` imports `NO_EDIT_REQUEST` from the same module, so a widening of the pattern changes the scorer's read-only lift and the attach gate together — the single-vocabulary property the pass-one comment claims.\n- `.skilled/skills/system-skill-advisor/runtime/handlers/advisor-status.ts:554-560` keeps the async backend probe on the command path only, so the synchronous recommend reader never performs a network call.\n\n## Edge Cases\n\n- **Pattern copied, not widened.** The current `NO_EDIT_REQUEST` is byte-identical to the base `fusion.ts:675` inline regex (`git show 35c3188681:…/fusion.ts`). Recorded so the vocabulary finding is read as pre-existing wording that the new gate now exposes, not as a regression the fix introduced.\n- **`start` vs `run`.** Every command the no-edit gap would attach is `start` or `ask`; the only `run` rows are read-only or add-only. That is what keeps `SA2-P2-002` at P2 instead of P1.\n- **Row-less commands.** Eleven tracked commands have no `COMMAND_ROWS` entry, so their `mutating` class is not recorded anywhere on the attach path. Read as out of reach for this iteration: those commands are all `start` or `ask`, so the missing class cannot turn into a `run` offer.\n\n## Confirmed-Clean Surfaces\n\n- `command-attach.ts:289` — pattern is a stateless, non-global regex, so repeated `.test()` calls cannot alternate.\n- `command-attach.ts:329` — the gate sits before any table lookup and returns `undefined`, so no command and no policy are produced.\n- `advisor-status.ts:224-231`, `:318-326` — database handles close on every path, including the error path; a failed close is reported as `unavailable`, not swallowed.\n- `advisor-status.ts:424-434` — the integrity probe is opt-in on the sync reader and default-on in `handleAdvisorStatus` (`:553`), and a transient lock/IO reason does not force a rebuild.\n- `derive-command-bridges.cjs:1121-1143` — a runnable with no policy record throws at generation time rather than defaulting to a permissive class.\n\n## Ruled Out\n\n- **A `run` row that mutates.** Ruled out by executed enumeration: 19 run rows, 0 `mutates`.\n- **The `COMMAND_POLICIES` deletion removing policy from row-less commands.** Ruled out: policy travels in `TRACKED_COMMANDS`, 0 mismatches against rows for the 52 commands that have both.\n- **`advisor_status` leaking holdout prompt text.** No prompt source is read on this surface; the residual is that the privacy test cannot prove it (`SA2-P2-003`).\n- **Path traversal through `skill_nodes.source_path` in `readIndexStaleness`.** Read as not a leak: the file is read only to hash it, the hash is compared with a hash from the same database, and no content or path is returned to the caller. A writer of that row already controls the artifact.\n\n## Next Focus\n\n- Dimension: traceability\n- Focus area: the changed docs in this area — `feature-catalog/scorer-fusion/command-meaning-matching.md` and `runtime/scripts/command-bridges/README.md` — against the code they describe (`fusion.ts` command-meaning gate, `derive-command-bridges.cjs`), plus the pass-one `R4-P2-001` prose claim that `COMMAND_POLICIES` is gone.\n- Reason: two changed docs describe generated tables and a meaning gate; pass one found three doc/code drifts in this area, so the same surface needs a re-read after the fixes.\n- Rotation status: correctness and security complete (both PASS); traceability next.\n- Blocked/productive carry-forward: security was productive (two P2); no blocked approach.\n- Required evidence: the documented numbers against the generated JSON, and the doc's policy-source claim against `advisor-recommend.ts:483`.\n\nReview verdict: PASS\n","path":"specs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/review/lineages/scorer-attach-2/iterations/iteration-002.md"},"output":"Created file successfully: specs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/review/lineages/scorer-attach-2/iterations/iteration-002.md","title":"write","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Created file successfully: specs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/review/lineages/scorer-attach-2/iterations/iteration-002.md"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"content\": \"# Review Iteration 002\\n\\n## Dispatcher\\n\\n- Run: `fanout-scorer-attach-2-1794570021136-noekp0` (lineage `scorer-attach-2`, pass two, area `scorer-attach`)\\n- Mode: review; executor: in-process (no nested dispatch)\\n- Dimension: security\\n- Review focus addressed: the operator focus names \\\"safety of offering a mutating command\\\" and \\\"holdout hygiene, so no tune, fix or report path reads or leaks holdout rows\\\". This iteration re-proves the mutating-command invariant against the changed tables (pass one's claim was \\\"no `run` row writes\\\"), then re-reads the two changed files that could carry a leak: the status handler and its test.\\n- Budget profile: `verify` (11-13 calls), used 11.\\n\\n## Files Reviewed\\n\\n- `.skilled/skills/system-skill-advisor/runtime/lib/command-attach.ts:257-349` (gate, pattern, attach path)\\n- `.skilled/skills/system-skill-advisor/runtime/lib/scorer/fusion.ts:675-680` (the same pattern in the scorer path, and its base revision)\\n- `.skilled/skills/system-skill-advisor/runtime/handlers/advisor-status.ts:1-567` (whole file, changed)\\n- `.skilled/skills/system-skill-advisor/runtime/tests/handlers/advisor-status.vitest.ts:1-748` (whole file, changed)\\n- Executed whole-table invariants over the live module (below).\\n\\n## Findings - New\\n\\n### P0 Findings\\n\\nNone.\\n\\n### P1 Findings\\n\\nNone.\\n\\n### P2 Findings\\n\\n1. **The no-edit gate does not fire on \\\"don't change\\\" or \\\"no changes\\\", so a writing command is still offered** -- `.skilled/skills/system-skill-advisor/runtime/lib/command-attach.ts:289` -- `NO_EDIT_REQUEST` covers `do not (change|edit|modify|touch)` but not the contracted forms `don't change`, nor the noun form `no changes`. The pass-one fix (`command-attach.ts:329`) now applies the pattern to every hub, so the gap reaches every attached command rather than the deep-loop one. This is not a re-report of `R2-P2-001` — that fix holds; the pattern it reads is narrower than the wording it names.\\n   Finding class: security_policy_vocabulary_gap\\n   Scope proof: `NO_EDIT_REQUEST` is declared and exported in `runtime/lib/command-attach.ts` (scorer-attach scope) and consumed by the attach path at `:329` and by `fusion.ts:677`, `:881`.\\n   Affected surface hints: hub command attachment for every hub; scorer read-only lift; hook briefs that surface the command.\\n   Case: `attachCommand('sk-doc', { action: 'route', selectionKind: 'single', targets: [{ workflowMode: 'sk-create-skill' }] }, \\\"create a skill called invoice-parser, don't change anything yet\\\")` returns `/create:skill` with tracked policy `start`; the same prompt with \\\"no changes yet\\\" also returns `/create:skill`. Executed against the live module, both reported `noEdit: false`.\\n   Claim: the gate withholds a command on \\\"do not change anything yet\\\" but not on the two most common paraphrases of the same instruction.\\n   Evidence refs: `command-attach.ts:289`, `command-attach.ts:329`, `fusion.ts:677`\\n   Counterevidence sought: checked whether the pattern was widened in the reviewed range (it was copied unchanged from the base `fusion.ts:675` inline regex), and whether `start` makes the offer harmless (it asks before writing, and `AGENTS.md:68` says an explicit instruction outranks the policy).\\n   Alternative explanation: the vocabulary is deliberately narrow to avoid withholding a command on a sentence that asks for a change while mentioning a restriction elsewhere.\\n   Final severity: P2 (the offered policy is `start`, which asks before writing; no silent write path)\\n   Confidence: high\\n   Downgrade trigger: withdraw if `NO_EDIT_REQUEST` is widened by another change in this range, or if a caller starts treating a `start` offer as authority to run without asking.\\n\\n2. **The privacy guard at `advisor-status.vitest.ts:493` cannot fail because the fixture never stores anything private** -- `.skilled/skills/system-skill-advisor/runtime/tests/handlers/advisor-status.vitest.ts:493` -- The test named \\\"does not leak prompt content in status output\\\" builds `workspace('privacy')`, writes an empty DB file and a generation record, then asserts the serialized output contains neither `prompt` nor `secret@example.com`. No diagnostic record, prompt or secret is ever written, so the assertion is true for an empty status and would stay green if the handler later echoed a stored prompt. Holdout hygiene is the one operator check that depends on a test like this actually exercising the read path.\\n   Finding class: vacuous_privacy_assertion\\n   Scope proof: the test lives in `runtime/tests/handlers/advisor-status.vitest.ts` (scorer-attach scope) and its subject `readAdvisorHookHealthSection` is reached from `advisor-status.ts:487`, which this iteration read.\\n   Affected surface hints: `advisor_status` output; hook diagnostic record read path; holdout/privacy assurance for the status surface.\\n   Case: the fixture at `:494-496` writes only `skill-graph.sqlite` (empty) and `skill-graph-generation.json`; then `handleAdvisorStatus({ workspaceRoot: root })` is serialized and searched. There is no record containing `secret@example.com` for the assertion to exclude, so the case passes identically before and after any leak is introduced.\\n   Finding class (second line retained for the reducer): privacy_test_gap\\n   Claim: the assertion does not exercise the path that could leak.\\n   Evidence refs: `tests/handlers/advisor-status.vitest.ts:493-502`, `handlers/advisor-status.ts:487-512`\\n   Counterevidence sought: the neighbouring test at `:537-564` proves the writer strips `errorDetails` and `skillLabel`, so the write path is covered; what is uncovered is the *read* path echoing a record that already contains such text.\\n   Alternative explanation: the test may be a smoke check that the schema has no prompt-shaped field, which it does prove for the empty case.\\n   Final severity: P2 (assurance gap, no reachable leak shown)\\n   Confidence: medium\\n   Downgrade trigger: withdraw if a fixture elsewhere in the suite persists a prompt-bearing record and asserts its absence from `advisor_status` output.\\n\\n## Security Checks (executed)\\n\\n- **Mutating-command invariant.** Loaded `command-attach.ts` through `node --experimental-strip-types` and enumerated the live tables: 56 `COMMAND_ROWS`, 19 with `policy: 'run'`, 0 of those carrying `mutating: 'mutates'`, and 0 rows with no class at all. Pass one's \\\"no `run` row writes\\\" claim holds on the current table. The two `run` + `add-only` rows (`/doctor:deep-loop`, `/doctor:speckit`) are the deferred decision in pass-one section 8 and are not re-reported here.\\n- **Policy/owner parity.** For the 63 `TRACKED_COMMANDS` entries, every command that also has a `COMMAND_ROWS` row agrees on `policy` and `ownerSkillId` (0 mismatches). The 11 commands without a row (`/create:benchmark`, `/create:command`, `/create:diff`, `/create:goal`, `/create:repo-rule`, `/create:skill-parent`, `/create:with-human-voice`, `/deep:ai-council`, `/design:chart`, `/design:diagram`, `/design:extract`) are exactly the set pass one named; they take their policy from `TRACKED_COMMANDS` at `advisor-recommend.ts:483`, so deleting the old table did not strip it.\\n- **Holdout hygiene on this surface.** `advisor-status.ts` reads no prompt fixture; the only prompt-shaped strings in its output are schema keys and redacted diagnostics (`:519` uses `redactDiagnosticText`). `derive-command-bridges.cjs` reads no prompt fixture either (searched for `prompts`, `jsonl`, `holdout`: no hits). No holdout prompt text was read or printed in this iteration; no holdout counts were needed.\\n\\n## Traceability Checks\\n\\n- `spec_code` — partial. The `run` policy means \\\"safe to start without asking\\\" and the table honours it; the no-edit wording is narrower than the packet's stated intent, recorded as `SA2-P2-002`.\\n- `checklist_evidence` — pending. No checklist claim in focus.\\n- `feature_catalog_code` — pending; `command-meaning-matching.md` and the command-bridges README are the traceability iteration's job.\\n- `skill_agent`, `agent_cross_runtime`, `playbook_capability` — pending / notApplicable.\\n\\n## Integration Evidence\\n\\n- `.skilled/skills/system-skill-advisor/runtime/handlers/advisor-recommend.ts:478-485` is the only production path that turns an attached command into a `policy`; it reads `TRACKED_COMMANDS` (`:483`), not `COMMAND_ROWS`, which is why the 11 row-less commands still carry a policy.\\n- `.skilled/skills/system-skill-advisor/runtime/lib/scorer/fusion.ts:20` imports `NO_EDIT_REQUEST` from the same module, so a widening of the pattern changes the scorer's read-only lift and the attach gate together — the single-vocabulary property the pass-one comment claims.\\n- `.skilled/skills/system-skill-advisor/runtime/handlers/advisor-status.ts:554-560` keeps the async backend probe on the command path only, so the synchronous recommend reader never performs a network call.\\n\\n## Edge Cases\\n\\n- **Pattern copied, not widened.** The current `NO_EDIT_REQUEST` is byte-identical to the base `fusion.ts:675` inline regex (`git show 35c3188681:…/fusion.ts`). Recorded so the vocabulary finding is read as pre-existing wording that the new gate now exposes, not as a regression the fix introduced.\\n- **`start` vs `run`.** Every command the no-edit gap would attach is `start` or `ask`; the only `run` rows are read-only or add-only. That is what keeps `SA2-P2-002` at P2 instead of P1.\\n- **Row-less commands.** Eleven tracked commands have no `COMMAND_ROWS` entry, so their `mutating` class is not recorded anywhere on the attach path. Read as out of reach for this iteration: those commands are all `start` or `ask`, so the missing class cannot turn into a `run` offer.\\n\\n## Confirmed-Clean Surfaces\\n\\n- `command-attach.ts:289` — pattern is a stateless, non-global regex, so repeated `.test()` calls cannot alternate.\\n- `command-attach.ts:329` — the gate sits before any table lookup and returns `undefined`, so no command and no policy are produced.\\n- `advisor-status.ts:224-231`, `:318-326` — database handles close on every path, including the error path; a failed close is reported as `unavailable`, not swallowed.\\n- `advisor-status.ts:424-434` — the integrity probe is opt-in on the sync reader and default-on in `handleAdvisorStatus` (`:553`), and a transient lock/IO reason does not force a rebuild.\\n- `derive-command-bridges.cjs:1121-1143` — a runnable with no policy record throws at generation time rather than defaulting to a permissive class.\\n\\n## Ruled Out\\n\\n- **A `run` row that mutates.** Ruled out by executed enumeration: 19 run rows, 0 `mutates`.\\n- **The `COMMAND_POLICIES` deletion removing policy from row-less commands.** Ruled out: policy travels in `TRACKED_COMMANDS`, 0 mismatches against rows for the 52 commands that have both.\\n- **`advisor_status` leaking holdout prompt text.** No prompt source is read on this surface; the residual is that the privacy test cannot prove it (`SA2-P2-003`).\\n- **Path traversal through `skill_nodes.source_path` in `readIndexStaleness`.** Read as not a leak: the file is read only to hash it, the hash is compared with a hash from the same database, and no content or path is returned to the caller. A writer of that row already controls the artifact.\\n\\n## Next Focus\\n\\n- Dimension: traceability\\n- Focus area: the changed docs in this area — `feature-catalog/scorer-fusion/command-meaning-matching.md` and `runtime/scripts/command-bridges/README.md` — against the code they describe (`fusion.ts` command-meaning gate, `derive-command-bridges.cjs`), plus the pass-one `R4-P2-001` prose claim that `COMMAND_POLICIES` is gone.\\n- Reason: two changed docs describe generated tables and a meaning gate; pass one found three doc/code drifts in this area, so the same surface needs a re-read after the fixes.\\n- Rotation status: correctness and security complete (both PASS); traceability next.\\n- Blocked/productive carry-forward: security was productive (two P2); no blocked approach.\\n- Required evidence: the documented numbers against the generated JSON, and the doc's policy-source claim against `advisor-recommend.ts:483`.\\n\\nReview verdict: PASS\\n\", \"path\": \"specs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/review/lineages/scorer-attach-2/iterations/iteration-002.md\"}"},"time":{"start":1794570827376,"end":1794570856931}}}}
