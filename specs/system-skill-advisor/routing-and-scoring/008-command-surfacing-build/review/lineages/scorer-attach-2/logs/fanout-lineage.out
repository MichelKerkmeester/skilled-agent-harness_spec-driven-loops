{"type":"tool_use","timestamp":1794570780069,"sessionID":"ses_e2b4a23c4ffeXM7ei3r7kNeMRl","part":{"partID":"prt_1d4c0fc3b002um0KuHTMwsl5Ni","sessionID":"ses_e2b4a23c4ffeXM7ei3r7kNeMRl","messageID":"msg_1d4c0f057001fV93dxVGrbYahB","type":"tool","id":"chatcmpl-tool-932b3531301a1c55","tool":"read","state":{"status":"completed","input":{"limit":130,"offset":440,"path":".skilled/skills/system-skill-advisor/runtime/handlers/advisor-status.ts"},"output":"Read file .skilled/skills/system-skill-advisor/runtime/handlers/advisor-status.ts, lines 440-567\n440:     if (indexStaleness.state === 'stale') {\n441:       const staleSkillCount = indexStaleness.changedSourceFiles + indexStaleness.missingSourceFiles;\n442:       errors.push(\n443:         `advisor_status index content hashes differ from disk for ${staleSkillCount} skill${staleSkillCount === 1 ? '' : 's'}; run advisor_rebuild`,\n444:       );\n445:     }\n446:     const sourceChanged = generation.state === 'stale'\n447:       || indexStaleness.state === 'stale'\n448:       || (\n449:         generation.sourceSignature\n450:           ? computeAdvisorSourceSignature(workspaceRoot) !== generation.sourceSignature\n451:           : hasArtifact && hasSources && sourceScan.maxMtimeMs > fileMtimeMs(dbPath)\n452:       );\n453:     const daemonPid = parseDaemonPid();\n454:     const daemonAvailable = daemonPid === undefined ? true : hasRunningDaemon(daemonPid);\n455:     // Only flag a daemon-evidence divergence when a PID file exists but the\n456:     // process is gone. Missing PID file = daemon never started, not a\n457:     // divergence between freshness artifacts and live process evidence.\n458:     if (daemonPid !== undefined && !daemonAvailable && generation.state !== 'unavailable') {\n459:       errors.push('advisor_status found freshness artifacts, but no live daemon PID/process evidence');\n460:     }\n461:     const state = isFreshness(generation.state) ? generation.state : 'unavailable';\n462:     // Data is stale when sources are physically newer than the\n463:     // artifact, regardless of stored sourceSignature semantics. This is the\n464:     // stronger physical-evidence signal vs. signature mismatch which can\n465:     // arise from benign workspace differences.\n466:     const sourcesNewerThanArtifact = hasArtifact && hasSources\n467:       && sourceScan.maxMtimeMs > fileMtimeMs(dbPath);\n468:     const trustState = createTrustState({\n469:       hasSources,\n470:       hasArtifact,\n471:       sourceChanged,\n472:       daemonAvailable,\n473:       generation: generation.generation,\n474:       reason: generation.reason,\n475:       lastLiveAt: state === 'live' ? generation.updatedAt : null,\n476:     });\n477:     // `freshness` describes data/artifact state (live/stale/absent/\n478:     // unavailable from the generation file), while `trustState.state` is the\n479:     // daemon-gated caller-trust axis. Keep them decoupled so callers reading\n480:     // `freshness` see artifact health independent of daemon availability.\n481:     // When physical evidence shows sources are newer than the DB, downgrade\n482:     // a 'live' generation to 'stale' regardless of signature noise.\n483:     const freshnessOutput: AdvisorFreshness = state === 'live'\n484:       && (sourceChanged || artifactCorrupt || (!generation.sourceSignature && sourcesNewerThanArtifact))\n485:       ? 'stale'\n486:       : state;\n487:     const hookHealthSection = readAdvisorHookHealthSection(workspaceRoot);\n488:     const output: AdvisorStatusOutput = {\n489:       freshness: freshnessOutput,\n490:       generation: generation.generation,\n491:       trustState,\n492:       lastGenerationBump: generation.updatedAt === new Date(0).toISOString() ? null : generation.updatedAt,\n493:       lastScanAt: generation.updatedAt === new Date(0).toISOString() ? null : generation.updatedAt,\n494:       skillCount: sourceScan.count,\n495:       indexStaleness,\n496:       laneWeights: DEFAULT_SCORER_WEIGHTS,\n497:       // The p95 counts cache-hit invocations only, because a miss pays the\n498:       // child-process cost that the alert thresholds are not set against.\n499:       // A timestamp exists exactly when a record does, which is the condition\n500:       // that decides whether the hook has reported anything yet.\n501:       ...(hookHealthSection.lastRecordAt !== null\n502:         ? {\n503:             hookHealth: {\n504:               invocations: hookHealthSection.lastInvocations.length,\n505:               rollingP95Ms: hookHealthSection.rollingP95Ms,\n506:               rollingFailOpenRate: hookHealthSection.rollingFailOpenRate,\n507:               rollingCacheHitRate: hookHealthSection.rollingCacheHitRate,\n508:               rollingDegradedRate: hookHealthSection.rollingDegradedRate,\n509:               lastRecordAt: hookHealthSection.lastRecordAt,\n510:             },\n511:           }\n512:         : {}),\n513:       ...((args.includeSemanticHealth || args.debug) ? { semanticLaneHealth: readSemanticLaneHealth(dbPath) } : {}),\n514:       ...(daemonPid ? { daemonPid } : {}),\n515:       ...(errors.length > 0 ? { errors } : {}),\n516:     };\n517:     return AdvisorStatusOutputSchema.parse(output);\n518:   } catch (error: unknown) {\n519:     const message = redactDiagnosticText(errorMessage(error));\n520:     const sourceScan = scanSkillMetadataFiles(skillRoot, args.maxMetadataFiles ?? DEFAULT_MAX_METADATA_FILES);\n521:     const trustState = createTrustState({\n522:       hasSources: existsSync(skillRoot),\n523:       hasArtifact: existsSync(dbPath),\n524:       sourceChanged: false,\n525:       daemonAvailable: false,\n526:       generation: 0,\n527:       reason: 'ADVISOR_STATUS_UNAVAILABLE',\n528:     });\n529:     const output: AdvisorStatusOutput = {\n530:       freshness: 'unavailable',\n531:       generation: 0,\n532:       trustState,\n533:       lastGenerationBump: null,\n534:       lastScanAt: null,\n535:       skillCount: sourceScan.count,\n536:       laneWeights: DEFAULT_SCORER_WEIGHTS,\n537:       ...((args.includeSemanticHealth || args.debug) ? { semanticLaneHealth: readSemanticLaneHealth(dbPath) } : {}),\n538:       errors: [message],\n539:     };\n540:     return AdvisorStatusOutputSchema.parse(output);\n541:   }\n542: }\n543: \n544: // ───────────────────────────────────────────────────────────────────\n545: // 5. EXPORTS\n546: // ───────────────────────────────────────────────────────────────────\n547: \n548: /** Handle the advisor_status command request. */\n549: export async function handleAdvisorStatus(args: unknown): Promise<HandlerResponse> {\n550:   // The diagnostic surface opts into the artifact integrity probe by default\n551:   // so operators see on-disk corruption; explicit input can still override it.\n552:   const parsed = AdvisorStatusInputSchema.parse(args);\n553:   const status = readAdvisorStatus({ ...parsed, checkArtifactIntegrity: parsed.checkArtifactIntegrity ?? true });\n554:   const withBackend = parsed.includeSemanticHealth === true && status.semanticLaneHealth\n555:     ? { ...status, semanticLaneHealth: await probeSemanticLaneBackend(status.semanticLaneHealth) }\n556:     : status;\n557:   // Keep the bounded probe on this async command path, away from the synchronous recommend reader.\n558:   const data = parsed.includeEmbeddingsHealth === true\n559:     ? AdvisorStatusOutputSchema.parse({ ...withBackend, embeddingsHealth: await readEmbeddingsHealth() })\n560:     : withBackend;\n561:   return {\n562:     content: [{\n563:       type: 'text',\n564:       text: JSON.stringify({ status: 'ok', data }, null, 2),\n565:     }],\n566:   };\n567: }","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file .skilled/skills/system-skill-advisor/runtime/handlers/advisor-status.ts, lines 440-567\n440:     if (indexStaleness.state === 'stale') {\n441:       const staleSkillCount = indexStaleness.changedSourceFiles + indexStaleness.missingSou