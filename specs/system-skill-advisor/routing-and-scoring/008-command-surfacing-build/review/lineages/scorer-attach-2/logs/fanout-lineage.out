index, entry] of metadata.entries()) {\n145:       if (!entry || typeof entry !== 'object') {\n146:         throw new Error(`[command-bridges] ${sourcePath(filePath)}[${index}] must be an object`);\n147:       }\n148:       const { command, ownerMode } = entry;\n149:       if (typeof command !== 'string' || typeof ownerMode !== 'string' || !ownerMode) {\n150:         throw new Error(\n151:           `[command-bridges] ${sourcePath(filePath)}[${index}] requires string command and ownerMode`,\n152:         );\n153:       }\n154:       const description = entry.description === undefined ? '' : entry.description;\n155:       if (typeof description !== 'string') {\n156:         throw new Error(\n157:           `[command-bridges] ${sourcePath(filePath)}[${index}] description must be a string`,\n158:         );\n159:       }\n160:       // The phrases a person types instead of the command are declared once, in\n161:       // the metadata, so the bridge reads them here instead of restating them.\n162:       const ownedSignals = entry.userIntent && entry.userIntent.ownedSignals !== undefined\n163:         ? stringArray(\n164:           entry.userIntent.ownedSignals,\n165:           `${sourcePath(filePath)}[${index}].userIntent.ownedSignals`,\n166:         )\n167:         : [];\n168:       // The job is prose about the outcome a person wants, so it describes the\n169:       // command in words none of the identifiers do. An absent job is a record\n170:       // that says less, not a broken one.\n171:       const job = entry.userIntent && typeof entry.userIntent.job === 'string'\n172:         ? entry.userIntent.job\n173:         : '';\n174:       METADATA_MEANING.set(command, { description, job, ownedSignals });\n175:       entries.push({\n176:         id: bridgeId(command),\n177:         command,\n178:         skillId,\n179:         ownerMode,\n180:         description,\n181:         ownedSignals: [...ownedSignals],\n182:         standalone,\n183:         mutating: entry.mutating,\n184:         source: sourcePath(filePath),\n185:       });\n186:     }\n187:   }\n188:   return entries;\n189: }\n190: \n191: function doctorSkillAgent(name) {\n192:   const routerPath = join(DOCTOR_COMMANDS_DIR, `${name}.md`);\n193:   const tag = existsSync(routerPath)\n194:     ? /<!--\\s*skill_agent:\\s*([a-z0-9-]+)\\s*-->/.exec(readFileSync(routerPath, 'utf8'))\n195:     : null;\n196:   if (!tag) {\n197:     throw new Error(\n198:       `[command-bridges] ${sourcePath(routerPath)} has no skill_agent tag; `\n199:         + 'a doctor bridge needs its owning skill',\n200:     );\n201:   }\n202:   return tag[1];\n203: }\n204: \n205: // A router names its own purpose in the frontmatter sentence a person reads\n206: // before anything else, so the bridge embeds that sentence rather than a second\n207: // copy written for the scorer to drift from.\n208: function doctorCommandDescription(name) {\n209:   const routerPath = join(DOCTOR_COMMANDS_DIR, `${name}.md`);\n210:   const match = existsSync(routerPath)\n211:     ? /^---\\r?\\n([\\s\\S]*?)\\r?\\n---/.exec(readFileSync(routerPath, 'utf8'))\n212:     : null;\n213:   // Required lazily for the same reason as the route manifest: an\n214:   // argument-rejecting run must exit before this module needs a YAML parser.\n215:   const YAML = require('yaml');\n216:   let frontmatter = null;\n217:   if (match) {\n218:     try {\n219:       frontmatter = YAML.parse(match[1]);\n220:     } catch (error) {\n221:       throw new Error(\n222:         `[command-bridges] Failed to read the frontmatter of ${sourcePath(routerPath)}: ${error.message}`,\n223:       );\n224:     }\n225:   }\n226:   const description = frontmatter && frontmatter.description;\n227:   if (typeof description !== 'string' || !description.trim()) {\n228:     throw new Error(\n229:       `[command-bridges] ${sourcePath(routerPath)} has no frontmatter description; `\n230:         + 'a doctor bridge needs the sentence it embeds',\n231:     );\n232:   }\n233:   return description.trim();\n234: }\n235: \n236: function doctorCommandName(command, label) {\n237:   const match = /^\\/doctor:([a-z0-9-]+)$/.exec(command);\n238:   if (!match) {\n239:     throw new Error(`[command-bridges] ${label} has invalid doctor command ${command}`);\n[Output truncated. Continue reading with offset: 240]"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"limit\": 180, \"offset\": 60, \"path\": \".skilled/skills/system-skill-advisor/runtime/scripts/command-bridges/derive-command-bridges.cjs\"}"},"time":{"start":1794571208578,"end":1794571208918}}}}
