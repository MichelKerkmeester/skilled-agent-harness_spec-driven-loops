ch && awk '/^  phase_synthesis:/{f=1} f&&/^      step_[a-z_]+:/{print NR\\\": \\\"$0} f&&/^  phase_[a-z_]+:/&&!/phase_synthesis/{if(NR>1&&$0!~/phase_synthesis/)exit}' .skilled/commands/deep/assets/deep-review-auto.yaml | head -20\"}"},"time":{"start":1794571397613,"end":1794571398328}}}}
