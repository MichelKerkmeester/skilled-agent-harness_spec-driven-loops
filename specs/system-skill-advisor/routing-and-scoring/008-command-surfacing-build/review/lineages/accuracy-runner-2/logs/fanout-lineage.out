12; score-command-transcripts.mjs:92-95,1433-1455,885-901\\\",\\\"result\\\":\\\"flag parsed then ignored; scoreSession never reads options.rowId\\\",\\\"evidenceRefs\\\":[\\\"README.md:112\\\",\\\"score-command-transcripts.mjs:1455\\\"]}],\\\"disposition\\\":\\\"finding\\\",\\\"rationale\\\":\\\"The flag is silently accepted where it cannot narrow anything.\\\",\\\"linkedFindingId\\\":\\\"iter4-P2-row-id-session-mode\\\"},{\\\"id\\\":\\\"SL-306\\\",\\\"dimension\\\":\\\"traceability\\\",\\\"targetRefs\\\":[\\\"manual-testing-playbook/native-cli-tools/hub-command-attachment.md\\\"],\\\"bugClass\\\":\\\"documentation_drift\\\",\\\"hypothesis\\\":\\\"NC-011's deep-loop gate is stale after the pass-one attach fix.\\\",\\\"searchActions\\\":[{\\\"method\\\":\\\"direct_read\\\",\\\"queryOrPath\\\":\\\"hub-command-attachment.md:60-90; command-attach.ts:356-366\\\",\\\"result\\\":\\\"topic prompt no command, depth prompt command; triage symbols resolve\\\",\\\"evidenceRefs\\\":[\\\"hub-command-attachment.md:78-90\\\"]}],\\\"disposition\\\":\\\"ruled_out\\\",\\\"rationale\\\":\\\"Expected signals still match the fixed gate.\\\",\\\"ruledOutReason\\\":\\\"chapter holds\\\"},{\\\"id\\\":\\\"SL-307\\\",\\\"dimension\\\":\\\"traceability\\\",\\\"targetRefs\\\":[\\\"runtime/scripts/routing-accuracy/labeled-prompts.jsonl\\\",\\\"runtime/scripts/routing-accuracy/holdout-prompts.jsonl\\\"],\\\"bugClass\\\":\\\"corpus_integrity\\\",\\\"hypothesis\\\":\\\"A corpus grew duplicates or changed size under its gate.\\\",\\\"searchActions\\\":[{\\\"method\\\":\\\"corpus_count_tally\\\",\\\"queryOrPath\\\":\\\"id uniqueness and row counts for the four corpora\\\",\\\"result\\\":\\\"195/66/24/78 rows, all ids unique\\\",\\\"evidenceRefs\\\":[\\\"labeled-prompts.jsonl\\\",\\\"holdout-prompts.jsonl\\\",\\\"ambiguity-prompts.jsonl\\\",\\\"doctor-prompts.jsonl\\\"]}],\\\"disposition\\\":\\\"ruled_out\\\",\\\"rationale\\\":\\\"Counts and ids are intact.\\\",\\\"ruledOutReason\\\":\\\"no duplicate or missing id\\\"}],\\\"graphEvents\\\":[]}\\n\",\"path\":\"specs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/review/lineages/accuracy-runner-2/prompts/iter-004.record.json\"}"},"time":{"start":1794571857598,"end":1794571879266}}}}
