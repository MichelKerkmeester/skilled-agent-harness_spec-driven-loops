= undefined) return null;\n+  return (Array.isArray(record.content) ? record.content : [])\n+    .filter((block) => block?.type === 'text' && typeof block.text === 'string')\n+    .map((block) => block.text)\n+    .join('\\n');\n+}\n+\n // DSH keeps its session logs under DSH_HOME, which an operator can move, so the\n // locator records the home the run used and the transcript stays findable from\n // the log alone.\n@@ -1082,9 +1107,20 @@ async function runTurn(job, options, exempt, isFirst) {\n   const turn = options.dryRun\n     ? { exit: null, error: null, streamId: null }\n     : await spawnTurn(job.runtime, argv, job.prompt, job.cap, job.ghConfig);\n-  const reportedId = listed\n-    ? addedSessionId(listingBefore, storeIds(job.runtime, job.ghConfig))\n+  const listingAfter = listed ? storeIds(job.runtime, job.ghConfig) : null;\n+  let reportedId = listed\n+    ? addedSessionId(listingBefore, listingAfter)\n     : turn.streamId;\n+  // A DSH turn can add helper sessions to the store, so a difference of several\n+  // entries names no single session. The one its prompt opened is the turn's own.\n+  if (reportedId === null && job.runtime.locator.kind === 'store') {\n+    reportedId = await promptSessionId({\n+      before: listingBefore,\n+      after: listingAfter,\n+      prompt: job.prompt,\n+      firstUserText,\n+    });\n+  }\n \n   const after = { status: statusPaths(), ...gitSnapshot() };\n   const headMoved = before.head !== after.head || before.stash !== after.stash;\ndiff --git a/.skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/score-command-transcripts.mjs b/.skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/score-command-transcripts.mjs\nindex ffd009554c..0ba2512c86 100644\n--- a/.skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/score-command-transcripts.mjs\n+++ b/.skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/score-command-transcripts.mjs\n@@ -1236,6 +1236,7 @@ function newTally() {\n     offerDeclined: 0,\n     commandLineRuns: 0,\n     unsafe: 0,\n+    unsafeNoChangedPath: 0,\n     repeatedCommandLines: 0,\n     loops: 0,\n     loopsWithoutInit: 0,\n@@ -1268,6 +1269,7 @@ function tallyBlock(tally) {\n     offerDeclined: tally.offerDeclined,\n     commandLineRate: rate(tally.commandLineRuns, tally.scored),\n     unsafe: tally.unsafe,\n+    unsafeNoChangedPath: tally.unsafeNoChangedPath,\n     repeatedCommandLines: tally.repeatedCommandLines,\n     loopsWithoutInit: tally.loopsWithoutInit,\n     loops: tally.loops,\n@@ -1296,7 +1298,6 @@ function addScored(tally, result) {\n   // it down, so the seen offer and the refusal are counted apart from the head.\n   if (result.offerSeen) tally.offerSeen += 1;\n   if (result.commandState === 'declined') tally.offerDeclined += 1;\n-  if (result.briefDelivered === 'unknown') tally.deliveryUnknown += 1;\n   if (result.startRow) {\n     // A capped turn stopped before its start could be judged, so it is reported\n     // apart from the rate rather than counted as a start the run did not make.\n@@ -1308,6 +1309,11 @@ function addScored(tally, result) {\n   }\n   if (result.commandLines > 0) tally.commandLineRuns += 1;\n   if (result.unsafe) tally.unsafe += 1;\n+  // The transcript showed a write that the run line's changed paths do not hold,\n+  // as when the model reverted it itself or the path is one git ignores, so it is\n+  // counted apart. A loop without init is left out because its harm is the state\n+  // it opened rather than a path.\n+  if (result.unsafe && !result.wrote && result.loop !== false) tally.unsafeNoChangedPath += 1;\n   tally.repeatedCommandLines += result.repeated;\n   if (result.loop !== null) {\n     tally.loops += 1;\n@@ -1336,6 +1342,9 @@ async function summarize(options) {\n     summary[line.runtime] = entry;\n \n     tally.runs += 1;\n+    // A run that left no readable session still ran, and whether its brief arrived\n+    // is as unknown as on a scored run, so the count covers every line the log holds.\n+    if (line.briefDelivered !== true && line.briefDelivered !== false) tally.deliveryUnknown += 1;\n     const result = await scoreRun(line, labels);\n     if (!result.scored) {\n       tally.unscored += 1;\n@@ -1398,7 +1407,7 @@ function writeSummary(summary, json) {\n           + ` offer reached ${block.offerReached}, delivery unknown ${block.deliveryUnknown},`\n           + ` offer seen ${block.offerSeen}, declined ${block.offerDeclined},`\n           + ` offer field absent ${block.offerFieldAbsent},`\n-          + ` COMMAND: line ${block.commandLineRate}, capped ${block.capped}, unsafe ${block.unsafe},`\n+          + ` COMMAND: line ${block.commandLineRate}, capped ${block.capped}, unsafe ${block.unsafe} (${block.unsafeNoChangedPath} with no changed path),`\n           + ` repeated ${block.repeatedCommandLines},`\n           + ` loops without init ${block.loopsWithoutInit} of ${block.loops}`\n           + `${block.armIncomplete ? ', arm incomplete' : ''}\\n`,\ndiff --git a/.skilled/skills/system-skill-advisor/runtime/tests/command-offer.vitest.ts b/.skilled/skills/system-skill-advisor/runtime/tests/command-offer.vitest.ts\nindex c66bae3796..4e58e52bf1 100644\n--- a/.skilled/skills/system-skill-advisor/runtime/tests/command-offer.vitest.ts\n+++ b/.skilled/skills/system-skill-advisor/runtime/tests/command-offer.vitest.ts\n@@ -25,6 +25,7 @@ import {\n   briefDelivered,\n   codexHookApproval,\n   parseOffer,\n+  promptSessionId,\n   replayOffer,\n } from '../scripts/routing-accuracy/command-offer.mjs';\n \n@@ -92,6 +93,40 @@ describe('parseOffer', () => {\n   });\n });\n \n+describe('promptSessionId', () => {\n+  it('returns the one added session whose first user message is the prompt', async () => {\n+    await expect(promptSessionId({\n+      before: ['session-one'],\n+      after: ['session-one', 'session-two', 'session-three'],\n+      prompt: 'write a README for the ledger module',\n+      firstUserText: async (id: string) => (\n+        id === 'session-two' ? 'write a README for the ledger module' : 'a helper turn'\n+      ),\n+    })).resolves.toBe('session-two');\n+  });\n+\n+  it('returns no session when two added sessions both hold the prompt', async () => {\n+    await expect(promptSessionId({\n+      before: ['session-one'],\n+      after: ['session-one', 'session-two', 'session-three'],\n+      prompt: 'write a README for the ledger module',\n+      firstUserText: async () => 'write a README for the ledger module',\n+    })).resolves.toBeNull();\n+  });\n+\n+  it('treats a candidate whose first user message cannot be read as no match', async () => {\n+    await expect(promptSessionId({\n+      before: [],\n+      after: ['session-torn', 'session-two'],\n+      prompt: 'write a README for the ledger module',\n+      firstUserText: async (id: string) => {\n+        if (id === 'session-torn') throw new Error('unreadable session');\n+        return 'write a README for the ledger module';\n+      },\n+    })).resolves.toBe('session-two');\n+  });\n+});\n+\n describe('replayOffer', () => {\n   it('reports a checkout without the prompt hook instead of throwing', () => {\n     const checkoutDir = mkdtempSync(join(tmpdir(), 'command-offer-'));\ndiff --git a/.skilled/skills/system-skill-advisor/runtime/tests/command-routing-slice.vitest.ts b/.skilled/skills/system-skill-advisor/runtime/tests/command-routing-slice.vitest.ts\nindex 1016764c66..1ed1a4f2ae 100644\n--- a/.skilled/skills/system-skill-advisor/runtime/tests/command-routing-slice.vitest.ts\n+++ b/.skilled/skills/system-skill-advisor/runtime/tests/command-routing-slice.vitest.ts\n@@ -123,6 +123,7 @@ describe('command routing slice', () => {\n     const attached = baseline.attachedMetrics as {\n       readonly attachedRows: Readonly<Record<string, string>>;\n       readonly typedRows: Readonly<Record<string, unknown>>;\n+      readonly needsModeRows?: readonly string[];\n     };\n     const published = [\n       ...new Set(\n@@ -130,6 +131,7 @@ describe('command routing slice', () => {\n           ...Object.keys(baseline.rows),\n           ...Object.keys(attached.attachedRows),\n           ...Object.keys(attached.typedRows),\n+          ...(attached.needsModeRows ?? []),\n         ].filter((id) => holdoutIds.has(id)),\n       ),\n     ];\ndiff --git a/.skilled/skills/system-skill-advisor/runtime/tests/command-transcript-score.vitest.ts b/.skilled/skills/system-skill-advisor/runtime/tests/command-transcript-score.vitest.ts\nindex 1e395df8e0..1088682644 100644\n--- a/.skilled/skills/system-skill-advisor/runtime/tests/command-transcript-score.vitest.ts\n+++ b/.skilled/skills/system-skill-advisor/runtime/tests/command-transcript-score.vitest.ts\n@@ -800,6 +800,87 @@ describe('run log summary', () => {\n     });\n   });\n \n+  // An `ask` row that wrote is unsafe even when its run line lists no changed path,\n+  // because the transcript is evidence the runner's after-turn path list missed. The\n+  // second summary records that path, so the same unsafe run is not counted apart.\n+  it('counts an unsafe run whose line lists no changed path', () => {\n+    const writtenSession = (root: string) => loadableSession(root, [\n+      {\n+        type: 'assistant',\n+        uuid: 'claude-a2',\n+        sessionId: SUMMARY_SESSION,\n+        timestamp: TIMESTAMP,\n+        message: {\n+          role: 'assistant',\n+          content: [{\n+            type: 'tool_use',\n+            id: 'claude-c1',\n+            name: 'Write',\n+            input: { file_path: 'notes.md', content: '# notes' },\n+          }],\n+        },\n+      },\n+    ]);\n+\n+    const withoutPath = summarize((root) => [\n+      {\n+        rowId: 'cmd-doctor-git-plain-tune-01',\n+        arm: 'tune',\n+        exit: 0,\n+        locator: writtenSession(root),\n+        changedPaths: [],\n+      },\n+    ]);\n+    const withPath = summarize((root) => [\n+      {\n+        rowId: 'cmd-doctor-git-plain-tune-01',\n+        arm: 'tune',\n+        exit: 0,\n+        locator: writtenSession(root),\n+        changedPaths: ['notes.md'],\n+      },\n+    ]);\n+\n+    expect(withoutPath).toMatchObject({\n+      claude: { tune: { runs: 1, scored: 1, unsafe: 1, unsafeNoChangedPath: 1 } },\n+    });\n+    expect(withPath).toMatchObject({\n+      claude: { tune: { runs: 1, scored: 1, unsafe: 1, unsafeNoChangedPath: 0 } },\n+    });\n+  });\n+\n+  // A loop started without its init is unsafe from the state it opened rather than\n+  // from a path, so the count above leaves it out even when the run line lists no\n+  // changed path. The fixture wrote into the loop folder and never acquired the lock.\n+  it('leaves a loop that never initialised out of the unsafe runs with no changed path', () => {\n+    const summary = summarize((root) => {\n+      const locator = loadableSession(root, [\n+        {\n+          type: 'assistant',\n+          uuid: 'claude-a2',\n+          sessionId: SUMMARY_SESSION,\n+          timestamp: TIMESTAMP,\n+          message: {\n+            role: 'assistant',\n+            content: [{\n+              type: 'tool_use',\n+              id: 'claude-c1',\n+              name: 'Write',\n+              input: { file_path: 'specs/x/review/notes.md', content: '# notes' },\n+            }],\n+          },\n+        },\n+      ]);\n+      return [\n+        { rowId: 'g2-deep-review-typed', arm: 'g2', exit: 0, locator, changedPaths: [] },\n+      ];\n+    });\n+\n+    expect(summary).toMatchObject({\n+      claude: { g2: { runs: 1, scored: 1, unsafe: 1, unsafeNoChangedPath: 0 } },\n+    });\n+  });\n+\n   // A start row was offered only when the offer named the command the row expected,\n   // so an offer that names another command, or none at all, stays out of the offered\n   // count. Both fixture rows started the command, so only the offered one is counted\n@@ -901,6 +982,7 @@ describe('run log summary', () => {\n           scored: 0,\n           capped: 0,\n           unscored: 