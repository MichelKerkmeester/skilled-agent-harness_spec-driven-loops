NoChangedPath += 1;\n   tally.repeatedCommandLines += result.repeated;\n   if (result.loop !== null) {\n     tally.loops += 1;\n@@ -1336,6 +1342,9 @@ async function summarize(options) {\n     summary[line.runtime] = entry;\n \n     tally.runs += 1;\n+    // A run that left no readable session still ran, and whether its brief arrived\n+    // is as unknown as on a scored run, so the count covers every line the log holds.\n+    if (line.briefDelivered !== true && line.briefDelivered !== false) tally.deliveryUnknown += 1;\n     const result = await scoreRun(line, labels);\n     if (!result.scored) {\n       tally.unscored += 1;\n@@ -1398,7 +1407,7 @@ function writeSummary(summary, json) {\n           + ` offer reached ${block.offerReached}, delivery unknown ${block.deliveryUnknown},`\n           + ` offer seen ${block.offerSeen}, declined ${block.offerDeclined},`\n           + ` offer field absent ${block.offerFieldAbsent},`\n-          + ` COMMAND: line ${block.commandLineRate}, capped ${block.capped}, unsafe ${block.unsafe},`\n+          + ` COMMAND: line ${block.commandLineRate}, capped ${block.capped}, unsafe ${block.unsafe} (${block.unsafeNoChangedPath} with no changed path),`\n           + ` repeated ${block.repeatedCommandLines},`\n           + ` loops without init ${block.loopsWithoutInit} of ${block.loops}`\n           + `${block.armIncomplete ? ', arm incomplete' : ''}\\n`,\ndiff --git a/.skilled/skills/system-skill-advisor/runtime/tests/command-offer.vitest.ts b/.skilled/skills/system-skill-advisor/runtime/tests/command-offer.vitest.ts\nindex c66bae3796..4e58e52bf1 100644\n--- a/.skilled/skills/system-skill-advisor/runtime/tests/command-offer.vitest.ts\n+++ b/.skilled/skills/system-skill-advisor/runtime/tests/command-offer.vitest.ts\n@@ -25,6 +25,7 @@ import {\n   briefDelivered,\n   codexHookApproval,\n   parseOffer,\n+  promptSessionId,\n   replayOffer,\n } from '../scripts/routing-accuracy/command-offer.mjs';\n \n@@ -92,6 +93,40 @@ describe('parseOffer', () => {\n   });\n });\n \n+describe('promptSessionId', () => {\n+  it('returns the one added session whose first user message is the prompt', async () => {\n+    await expect(promptSessionId({\n+      before: ['session-one'],\n+      after: ['session-one', 'session-two', 'session-three'],\n+      prompt: 'write a README for the ledger module',\n+      firstUserText: async (id: string) => (\n+        id === 'session-two' ? 'write a README for the ledger module' : 'a helper turn'\n+      ),\n+    })).resolves.toBe('session-two');\n+  });\n+\n+  it('returns no session when two added sessions both hold the prompt', async () => {\n+    await expect(promptSessionId({\n+      before: ['session-one'],\n+      after: ['session-one', 'session-two', 'session-three'],\n+      prompt: 'write a README for the ledger module',\n+      firstUserText: async () => 'write a README for the ledger module',\n+    })).resolves.toBeNull();\n+  });\n+\n+  it('treats a candidate whose first user message cannot be read as no match', async () => {\n+    await expect(promptSessionId({\n+      before: [],\n+      after: ['session-torn', 'session-two'],\n+      prompt: 'write a README for the ledger module',\n+      firstUserText: async (id: string) => {\n+        if (id === 'session-torn') throw new Error('unreadable session');\n+        return 'write a README for the ledger module';\n+      },\n+    })).resolves.toBe('session-two');\n+  });\n+});\n+\n describe('replayOffer', () => {\n   it('reports a checkout without the prompt hook instead of throwing', () => {\n     const checkoutDir = mkdtempSync(join(tmpdir(), 'command-offer-'));\ndiff --git a/.skilled/skills/system-skill-advisor/runtime/tests/command-routing-slice.vitest.ts b/.skilled/skills/system-skill-advisor/runtime/tests/command-routing-slice.vitest.ts\nindex 1016764c66..1ed1a4f2ae 100644\n--- a/.skilled/skills/system-skill-advisor/runtime/tests/command-routing-slice.vitest.ts\n+++ b/.skilled/skills/system-skill-advisor/runtime/tests/command-routing-slice.vitest.ts\n@@ -123,6 +123,7 @@ describe('command routing slice', () => {\n     const attached = baseline.attachedMetrics as {\n       readonly attachedRows: Readonly<Record<string, string>>;\n       readonly typedRows: Readonly<Record<string, unknown>>;\n+      readonly needsModeRows?: readonly string[];\n     };\n     const published = [\n       ...new Set(\n@@ -130,6 +131,7 @@ describe('command routing slice', () => {\n           ...Object.keys(baseline.rows),\n           ...Object.keys(attached.attachedRows),\n           ...Object.keys(attached.typedRows),\n+          ...(attached.needsModeRows ?? []),\n         ].filter((id) => holdoutIds.has(id)),\n       ),\n     ];\ndiff --git a/.skilled/skills/system-skill-advisor/runtime/tests/command-transcript-score.vitest.ts b/.skilled/skills/system-skill-advisor/runtime/tests/command-transcript-score.vitest.ts\nindex 1e395df8e0..1088682644 100644\n--- a/.skilled/skills/system-skill-advisor/runtime/tests/command-transcript-score.vitest.ts\n+++ b/.skilled/skills/system-skill-advisor/runtime/tests/command-transcript-score.vitest.ts\n@@ -800,6 +800,87 @@ describe('run log summary', () => {\n     });\n   });\n \n+  // An `ask` row that wrote is unsafe even when its run line lists no changed path,\n+  // because the transcript is evidence the runner's after-turn path list missed. The\n+  // second summary records that path, so the same unsafe run is not counted apart.\n+  it('counts an unsafe run whose line lists no changed path', () => {\n+    const writtenSession = (root: string) => loadableSession(root, [\n+      {\n+        type: 'assistant',\n+        uuid: 'claude-a2',\n+        sessionId: SUMMARY_SESSION,\n+        timestamp: TIMESTAMP,\n+        message: {\n+          role: 'assistant',\n+          content: [{\n+            type: 'tool_use',\n+            id: 'claude-c1',\n+            name: 'Write',\n+            input: { file_path: 'notes.md', content: '# notes' },\n+          }],\n+        },\n+      },\n+    ]);\n+\n+    const withoutPath = summarize((root) => [\n+      {\n+        rowId: 'cmd-doctor-git-plain-tune-01',\n+        arm: 'tune',\n+        exit: 0,\n+        locator: writtenSession(root),\n+        changedPaths: [],\n+      },\n+    ]);\n+    const withPath = summarize((root) => [\n+      {\n+        rowId: 'cmd-doctor-git-plain-tune-01',\n+        arm: 'tune',\n+        exit: 0,\n+        locator: writtenSession(root),\n+        changedPaths: ['notes.md'],\n+      },\n+    ]);\n+\n+    expect(withoutPath).toMatchObject({\n+      claude: { tune: { runs: 1, scored: 1, unsafe: 1, unsafeNoChangedPath: 1 } },\n+    });\n+    expect(withPath).toMatchObject({\n+      claude: { tune: { runs: 1, scored: 1, unsafe: 1, unsafeNoChangedPath: 0 } },\n+    });\n+  });\n+\n+  // A loop started without its init is unsafe from the state it opened rather than\n+  // from a path, so the count above leaves it out even when the run line lists no\n+  // changed path. The fixture wrote into the loop folder and never acquired the lock.\n+  it('leaves a loop that never initialised out of the unsafe runs with no changed path', () => {\n+    const summary = summarize((root) => {\n+      const locator = loadableSession(root, [\n+        {\n+          type: 'assistant',\n+          uuid: 'claude-a2',\n+          sessionId: SUMMARY_SESSION,\n+          timestamp: TIMESTAMP,\n+          message: {\n+            role: 'assistant',\n+            content: [{\n+              type: 'tool_use',\n+              id: 'claude-c1',\n+              name: 'Write',\n+              input: { file_path: 'specs/x/review/notes.md', content: '# notes' },\n+            }],\n+          },\n+        },\n+      ]);\n+      return [\n+        { rowId: 'g2-deep-review-typed', arm: 'g2', exit: 0, locator, changedPaths: [] },\n+      ];\n+    });\n+\n+    expect(summary).toMatchObject({\n+      claude: { g2: { runs: 1, scored: 1, unsafe: 1, unsafeNoChangedPath: 0 } },\n+    });\n+  });\n+\n   // A start row was offered only when the offer named the command the row expected,\n   // so an offer that names another command, or none at all, stays out of the offered\n   // count. Both fixture rows started the command, so only the offered one is counted\n@@ -901,6 +982,7 @@ describe('run log summary', () => {\n           scored: 0,\n           capped: 0,\n           unscored: 1,\n+          deliveryUnknown: 1,\n           unscoredRuns: [{ rowId: SUMMARY_ROW, reason: 'locator_unavailable' }],\n         },\n       },\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"commit 3b48f0e5f1d0b362e147dfc3b419094f757ea698\nAuthor: Michel Kerkmeester <82775228+MichelKerkmeester@users.noreply.github.com>\nDate:   Fri Nov 13 12:39:24 2026 +0100\n\n    feat(system-skill-advisor): record hook health by default and tighten the brief\n    \n    The prompt hook now writes a health record on every prompt without the\n    debug variable. The record holds status, freshness, duration and a\n    degraded flag, and no prompt text or skill label. Advisor status reports\n    the degraded share and the time of the newest record, so a runtime with\n    no writer shows its age instead of a silent green.\n    \n    The (needs a mode) label shows only when the prompt names the hub. A hub\n    that tops the answer carries its command when the same command sits only\n    on a row the brief does not render. The OpenCode plugin stops pushing a\n    compiled-routing line the head already states.\n    \n    The brief-cost script reads live heads only and refuses an arm with\n    none. The transcript scorer counts every run line whose brief state is\n    unknown and reports unsafe runs that changed no path apart. The DSH\n    arm finds its session by the prompt it sent. The routing baseline lists\n    which rows would read (needs a mode) and names no holdout row.\n    \n    Floors held: typed recall 24/44, false offers 0/35, scorer eval\n    [160,50,21,5]. Suite: 183 files, 1,755 passed. Doctor tests 1,188,\n    0 failed.\n    \n    Spec: system-skill-advisor/routing-and-scoring/008-command-surfacing-build/015-health-default-and-brief-refinements\n    Commit-Id: 0013843\n\n=== diff my area ===\ncommit 3b48f0e5f1d0b362e147dfc3b419094f757ea698\nAuthor: Michel Kerkmeester <82775228+MichelKerkmeester@users.noreply.github.com>\nDate:   Fri Nov 13 12:39:24 2026 +0100\n\n    feat(system-skill-advisor): record hook health by default and tighten the brief\n    \n    The prompt hook now writes a health record on every prompt without the\n    debug variable. The record holds status, freshness, duration and a\n    degraded flag, and no prompt text or skill label. Advisor status reports\n    the degraded share and the time of the newest record, so a runtime with\n    no writer shows its age instead of a silent green.\n    \n    The (needs a mode) label shows only when the prompt names the hub. A hub\n    that tops the answer carries its command when the same command sits only\n    on a row the brief does not render. The OpenCode plugin stops pushing a\n    compiled-routing line the head already states.\n    \n    The brief-cost script reads live heads only and refuses an arm with\n    none. The transcript scorer counts every run line whose brief state is\n    unknown and reports unsafe runs that changed no path apart. The DSH\n    arm finds its session by the prompt it sent. The routing baseline lists\n    which rows would read (needs a mode) and names no holdout row.\n    \n    Floors held: typed recall 24/44, false offers 0/35, scorer eval\n    [160,50,21,5]. Suite: 183 files, 1,755 passed. Doctor tests 1,188,\n    0 failed.\n    \n    Spec: system-skill-advisor/routing-and-scoring/008-command-surfacing-build/015-health-default-and-brief-refinements\n    Commit-Id: 0013843\n\ndiff --git a/.skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/README.md b/.skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/README.md\nindex c98db0579c..f4cd607e96 100644\n--- a/.skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/README.md\n+++ b/.skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/README.md\n@@ -95,7 +95,8 @@ A typed command travels on its owner. It is delivered only when the leading reco\n `.skilled/skills/system-skill-advisor/runtime/scripts/measure-brief-cost.mjs` reports what the Claude prompt hook actually sends the model for a typed row.\n \n - Flags: `node measure-brief-cost.mjs [--rows <id,id>] [--root <dir>]` keeps every typed row on the `none` split, `--rows` narrows the run to named corpus ids and `--root` names the checkout the corpus and hook are read from, defaulting to the current directory. A holdout or unknown id exits 2 before anything is spawned, and no prompt is ever printed.\n-- Output keys: one JSON object holds `rows`, then `totalBytes`, `medianBytes` and `maxBytes`. Each entry of `rows` carries `id`, `bytes` and `estimatedTokens`, where bytes are the UTF-8 length of `hookSpecificOutput.additionalContext` and tokens divide that by four, the renderer's own characters per token.\n+- Output keys: one JSON object holds `rows`, then `liveRows`, `totalBytes`, `medianBytes`, `maxBytes`, `medianHeadBytes` and `maxHeadBytes`. Each entry of `rows` carries `id`, `bytes`, `headBytes`, `estimatedTokens` and `live`, where bytes are the UTF-8 length of `hookSpecificOutput.additionalContext`, headBytes is the UTF-8 length of its first line, live says whether that first line starts `Advisor: live`, and tokens divide the context bytes by four, the renderer's own characters per token. Every byte statistic is taken over live rows only.\n+- Refusal: a run with no live head prints `{\"error\":\"degraded_brief\",...}` and exits 2, which happens when the sandboxed hook cannot reach a live advisor.\n - Sandbox: the run makes one `ssa-cost-` directory under the OS temp dir and sets `SPECKIT_IPC_SOCKET_DIR` to it for every hook process, so the operator's warm daemon is never reached. At the end it stops only a process whose command line names that directory and removes it.\n \n ---\n@@ -107,8 +108,8 @@ A typed command travels on its owner. It is delivered only when the leading reco\n | `gate3-corpus-runner.mjs` | MJS source file in this folder. |\n | `score-routing-corpus.py` | PY source file in this folder. |\n | `command-prompts.jsonl` | Prompt corpus with a gold slash command per row, covering every tracked command. |\n-| `capture-command-routing-baseline.mjs` | Scores `command-prompts.jsonl` under the pinned regime and prints or writes the baseline. Its `attachedMetrics` key holds own-row, attached and combined plain reach per split and per command family, attached false offers, the typed rows where a command and its owner skill read as ambiguous, and the command attached to each published row. An attached hit counts only on a row the ranked bridge did not already land. Its `rows`, `attachedRows` and `typedRows` maps leave out every holdout row, so only holdout counts are published. The optional `--real-embedding` flag scores the same corpus against this machine's own skill graph database and live embedder in place of the fixture vectors and word overlap the default run substitutes, so its numbers describe an environment rather than a reproducible projection. It refuses `--write` because the committed baseline comes only from the fixture regime. Before scoring it proves two things, that a live embedder answers and serves the `nomic-embed-text` model family the stored vectors were built with, and that the skill graph database holds a populated `vec_cmd_*` command vector table. A missing piece exits 2 with a message that names it. Each row in its `rows` output also carries `offered`, which is true when any of the top three recommendations maps to a command bridge, so it measures reach rather than whether a brief head offered the command. |\n-| `score-command-transcripts.mjs` | Scores captured sessions through the shared session readers. `--summary <run-log> [<run-log>...]` scores every row one or more run logs list, per runtime and arm, and `--runtime <name> --locator '<json>'` scores the one session a locator names. `--row-id <id>` narrows either mode to one row and `--json` prints machine-readable output. Each per-arm block reports `startRate`, `cappedStartRows`, `offered`, `cappedOfferRows`, `startedOfOffered`, `offerReached`, `deliveryUnknown`, `offerSeen`, `offerDeclined`, `offerFieldAbsent`, `unsafe`, `armIncomplete` and `byPolicy`, where `byPolicy` holds a `run`, `start` and `ask` tally of rows, capped rows, started rows and rows that wrote. `cappedOfferRows` counts offers whose turn hit its cap, `offerReached` counts offers whose brief was not shown missing, so a row whose brief state is unknown counts, `deliveryUnknown` counts rows whose brief state is `unknown`, `offerSeen` and `offerDeclined` read the session's `COMMAND:` lines, and `offerFieldAbsent` counts rows that carry no offer field. `unsafe` also counts a workflow loop that started without its init, and a Claude turn that keeps only the `<command-name>` tag of a typed command counts as a start because Claude Code expands that command before the model sees it. The text output prints one `policy` line per policy under each arm. Exit 2 means nothing was scored: bad flags, a missing or malformed run log (`run_log_missing`, `run_log_malformed`), or a reader refusal printed with its own code such as `capability_gated` or `locator_unavailable`. |\n+| `capture-command-routing-baseline.mjs` | Scores `command-prompts.jsonl` under the pinned regime and prints or writes the baseline. Its `attachedMetrics` key holds own-row, attached and combined plain reach per split and per command family, attached false offers, the typed rows where a command and its owner skill read as ambiguous, and the command attached to each published row. An attached hit counts only on a row the ranked bridge did not already land. Its `rows`, `attachedRows` and `typedRows` maps leave out every holdout row, so only holdout counts are published. The optional `--real-embedding` flag scores the same corpus against this machine's own skill graph database and live embedder in place of the fixture vectors and word overlap the default run substitutes, so its numbers describe an environment rather than a reproducible projection. It refuses `--write` because the committed baseline comes only from the fixture regime. Before scoring it proves two things, that a live embedder answers and serves the `nomic-embed-text` model family the stored vectors were built with, and that the skill graph database holds a populated `vec_cmd_*` command vector table. A missing piece exits 2 with a message that names it. Each row in its `rows` output also carries `offered`, which is true when any of the top three recommendations maps to a command bridge, so it measures reach rather than whether a brief head offered the command. Its `attachedMetrics.needs_mode_floor` counts the silent rows whose head would read `(needs a mode)`, and `needsModeRows` lists every row id whose head would, which happens only when the prompt names the hub that tops it. |\n+| `score-command-transcripts.mjs` | Scores captured sessions through the shared session readers. `--summary <run-log> [<run-log>...]` scores every row one or more run logs list, per runtime and arm, and `--runtime <name> --locator '<json>'` scores the one session a locator names. `--row-id <id>` narrows either mode to one row and `--json` prints machine-readable output. Each per-arm block reports `startRate`, `cappedStartRows`, `offered`, `cappedOfferRows`, `startedOfOffered`, `offerReached`, `deliveryUnknown`, `offerSeen`, `offerDeclined`, `offerFieldAbsent`, `unsafe`, `unsafeNoChangedPath`, `armIncomplete` and `byPolicy`, where `byPolicy` holds a `run`, `start` and `ask` tally of rows, capped rows, started rows and rows that wrote. `cappedOfferRows` counts offers whose turn hit its cap, `offerReached` counts offers whose brief was not shown missing, so a row whose brief state is unknown counts, `deliveryUnknown` counts every run line whose brief state is `unknown`, scored or not, `offerSeen` and `offerDeclined` read the session's `COMMAND:` lines, and `offerFieldAbsent` counts rows that carry no offer field. `unsafe` also counts a workflow loop that started without its init, `unsafeNoChangedPath` counts the unsafe runs whose run line lists no changed path, apart from a loop without init, and a Claude turn that keeps only the `<command-name>` tag of a typed command counts as a start because Claude Code expands that command before the model sees it. A write to a git-ignored path or one the model reverted itself also leaves no changed path. The text output prints one `policy` line per policy under each arm. Exit 2 means nothing was scored: bad flags, a missing or malformed run log (`run_log_missing`, `run_log_malformed`), or a reader refusal printed with its own code such as `capability_gated` or `locator_unavailable`. |\n | `command-offer.mjs` | Recovers the attribution fields for a run line. `parseOffer` reads the command and policy out of one head, `replayOffer` replays a checkout's Claude prompt hook after the turn, `briefDelivered` reads the session record, and `backfillRunLog` writes the fields onto a finished log with a refusal code for a holdout, unknown or same-path input. |\n | `run-command-behaviour.mjs` | Runs one live turn per row and records the locator, exit and changed paths. `--print-argv <runtime>` prints a runtime's argv, `--list <set>` prints a set's row ids, and a run takes `--runtime` with `--set` or repeated `--row-id`, `--out <run-log>`, optional `--arm`, `--fixture` and `--dry-run`. `--backfill <run-log> --out <new-log> [--brief-only]` rewrites a finished log with `offeredCommand`, `offeredPolicy` and `briefDelivered` instead of running a turn, and prints a JSON refusal with `same_path`, `holdout_row` or `unknown_row` when it cannot. After each turn it restores the checkout to HEAD and reports any `leftoverPaths` whose status still differs from the snapshot taken before the turn. Exit 3 (`head_moved`) ends the arm without that restore, because a commit or a stash made during the turn is not the runner's to discard, so the line records `restored: false` and the changed paths stay listed. A live turn gets only the allowlisted environment, the shell basics, the locale and XDG prefixes, each runtime's own prefixes and the Skilled switch prefixes, plus the GitHub and git overrides, so no GitHub token or git credential helper from the operator's shell reaches it. Exit 2 refuses instead of running: bad flags, an unknown runtime or set, a holdout or unknown row, a set with fewer rows than it needs (`set_short`), a dirty worktree outside the run log's folder (`worktree_dirty`), a checkout with a git remote (`remote_present`), a checkout without the arena builder's marker (`arena_unprepared`), or a Codex arm whose project hook is unapproved (`codex-hooks-unapproved`). |\n | `command-routing-baseline.json` | Captured command routing numbers that `tests/command-routing-slice.vitest.ts` holds the scorer to. |\ndiff --git a/.skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/capture-command-routing-baseline.mjs b/.skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/capture-command-routing-baseline.mjs\nindex aba01f7013..3fd59002ab 100644\n--- a/.skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/capture-command-routing-baseline.mjs\n+++ b/.skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/capture-command-routing-baseline.mjs\n@@ -63,6 +63,7 @@ const DIST = resolve(HERE, '../../dist/runtime');\n const FUSION_MODULE = resolve(DIST, 'lib/scorer/fusion.js');\n const WORKSPACE_ROOT_MODULE = resolve(DIST, 'lib/utils/workspace-root.js');\n const COMMAND_ATTACH_MODULE = resolve(DIST, 'lib/command-attach.js');\n+const PROMPT_POLICY_MODULE = resolve(DIST, 'lib/prompt-policy.js');\n const COMPILED_ROUTING_FLAG_MODULE = resolve(DIST, 'lib/compiled-routing-flag.js');\n const SEMANTIC_SHADOW_MODULE = resolve(DIST, 'lib/scorer/lanes/semantic-shadow.js');\n const SKILL_GRAPH_DB_MODULE = resolve(DIST, 'lib/skill-graph/skill-graph-db.js');\n@@ -392,7 +393,7 @@ export async function scoreCommandCorpus(options = {}) {\n     if (!existsSync(FUSION_MODULE)) {\n       throw new Error(`built scorer file missing: ${FUSION_MODULE}`);\n     }\n-    for (const modulePath of [COMMAND_ATTACH_MODULE, COMPILED_ROUTING_FLAG_MODULE]) {\n+    for (const modulePath of [COMMAND_ATTACH_MODULE, COMPILED_ROUTING_FLAG_MODULE, PROMPT_POLICY_MODULE]) {\n       if (!existsSync(modulePath)) {\n         throw new Error(`built command-attach file missing: ${modulePath}`);\n       }\n@@ -403,7 +404,8 @@ export async function scoreCommandCorpus(options = {}) {\n     // build is reported as such rather than as a module-resolution failure.\n     const { scoreAdvisorPrompt } = await import(pathToFileURL(FUSION_MODULE).href);\n     const { findAdvisorWorkspaceRoot } = await import(pathToFileURL(WORKSPACE_ROOT_MODULE).href);\n-    const { attachCommand, typedCommandForTop, TRACKED_COMMANDS } = await import(pathToFileURL(COMMAND_ATTACH_MODULE).href);\n+    const { attachCommand, typedCommandForTop, TRACKED_COMMANDS, routeNeedsMode } = await import(pathToFileURL(COMMAND_ATTACH_MODULE).href);\n+    const { extractMetalinguisticSkillMentions } = await import(pathToFileURL(PROMPT_POLICY_MODULE).href);\n     const { COMPILED_ROUTING_HUBS } = await import(pathToFileURL(COMPILED_ROUTING_FLAG_MODULE).href);\n     const workspaceRoot = findAdvisorWorkspaceRoot(HERE, { maxDepth: 14, sentinel: SENTINEL });\n \n@@ -474,6 +476,8 @@ export async function scoreCommandCorpus(options = {}) {\n     const plainAttachedByFamily = new Map();\n     const sameOwnerAmbiguous = [];\n     let falseOfferAttached = 0;\n+    const needsModeRows = [];\n+    let needsModeFloor = 0;\n \n     for (const row of corpus) {\n       // The recommend path supplies the semantic lane's prompt vector through this\n@@ -499,13 +503,21 @@ export async function scoreCommandCorpus(options = {}) {\n       // A hub can name the slash command its route would take, which is reach a\n       // reader otherwise gets only by translating the workflow mode by hand.\n       const topId = ids[0];\n-      const attached = topId !== undefined && COMPILED_ROUTING_HUBS.has(topId)\n-        ? attachCommand(topId, readCompiledRoute(workspaceRoot, topId, row.prompt), row.prompt)\n+      const route = topId !== undefined && COMPILED_ROUTING_HUBS.has(topId)\n+        ? readCompiledRoute(workspaceRoot, topId, row.prompt)\n         : undefined;\n+      const attached = route !== undefined ? attachCommand(topId, route, row.prompt) : undefined;\n       const attachedHit = attached !== undefined && attached === expected && !top1Hit;\n       // A typed command is the reader's own wording, so it outranks the hub's\n       // route in the delivered command, the same precedence the handler applies.\n       const delivered = typedCommandForTop(topId, row.prompt)?.command ?? attached;\n+      // A head shows that label only when nothing else names a command, so a row\n+      // counts only when neither the typed command nor the route delivered one. A\n+      // silent row that carries it shows a label nobody asked for.\n+      const needsMode = route !== undefined && delivered === undefined && routeNeedsMode(topId, route, extractMetalinguisticSkillMentions(row.prompt));\n+      // The list names rows with their outcome, so a holdout row stays out of it\n+      // as it stays out of the row maps.\n+      if (needsMode && publishRow) needsModeRows.push(row.id);\n       const deliveredPolicy = delivered === undefined ? null : TRACKED_COMMANDS[delivered]?.policy ?? null;\n       const deliveredHit = !top1Hit && delivered === expected && deliveredPolicy !== null;\n \n@@ -553,6 +565,7 @@ export async function scoreCommandCorpus(options = {}) {\n         falseOfferTotal += 1;\n         if (offered) falseOfferCount += 1;\n         if (attached !== undefined) falseOfferAttached += 1;\n+        if (needsMode) needsModeFloor += 1;\n       }\n \n       if (isSlashVariant) {\n@@ -642,6 +655,8 @@ export async function scoreCommandCorpus(options = {}) {\n         typedRows,\n         typed_same_owner_ambiguous: sameOwnerAmbiguous.sort(),\n         attachedRows,\n+        needs_mode_floor: { count: needsModeFloor, total: falseOfferTotal },\n+        needsModeRows: needsModeRows.sort(),\n       },\n     };\n   } finally {\ndiff --git a/.skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/command-offer.mjs b/.skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/command-offer.mjs\nindex 20fc5fcb4d..3bae01bc4f 100644\n--- a/.skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/command-offer.mjs\n+++ b/.skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/command-offer.mjs\n@@ -283,6 +283,44 @@ export async function briefDelivered({ runtime, locator, loadSession, codexConfi\n   return 'unknown';\n }\n \n+/**\n+ * Pick the session a DSH prompt opened among the sessions a turn added.\n+ *\n+ * A DSH turn can add helper sessions beside its own, and only the session the\n+ * prompt opened holds that prompt as its first user message, so the prompt\n+ * decides between them and a tie names none.\n+ *\n+ * @param {object} options\n+ * @param {string[]} options.before - Session ids the store held before the turn.\n+ * @param {string[]} options.after - Session ids the store held after the turn.\n+ * @param {string} options.prompt - The prompt the turn ran.\n+ * @param {(id: string) => Promise<string | null>} options.firstUserText - Reads a\n+ *   session's first user message.\n+ * @returns {Promise<string | null>} The session the prompt opened, or null.\n+ */\n+export async function promptSessionId({ before, after, prompt, firstUserText }) {\n+  if (!Array.isArray(before) || !Array.isArray(after)) return null;\n+  if (typeof prompt !== 'string' || prompt.length === 0) return null;\n+\n+  const known = new Set(before);\n+  const added = [...new Set(after)].filter((id) => !known.has(id));\n+  const wanted = prompt.trim();\n+  const matched = [];\n+\n+  for (const id of added) {\n+    let text;\n+    try {\n+      text = await firstUserText(id);\n+    } catch {\n+      continue;\n+    }\n+    if (typeof text !== 'string') continue;\n+    if (text.trim() === wanted) matched.push(id);\n+  }\n+\n+  return matched.length === 1 ? matched[0] : null;\n+}\n+\n // ───────────────────────────────────────────────────────────────\n // Run-log backfill\n // ───────────────────────────────────────────────────────────────\ndiff --git a/.skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/command-routing-baseline.json b/.skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/command-routing-baseline.json\nindex eec4bce796..9778e3c992 100644\n--- a/.skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/command-routing-baseline.json\n+++ b/.skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/command-routing-baseline.json\n@@ -1,7 +1,7 @@\n {\n   \"schemaVersion\": 1,\n   \"capturedAt\": \"2026-10-11\",\n-  \"capturedAtSha\": \"320e7b64d4\",\n+  \"capturedAtSha\": \"2549786f28\",\n   \"corpusSha256\": \"sha256:698da57b02159a756dbba5d6a2c9a3c6d14588d07e96be268567835cf36448b8\",\n   \"bridgeCounts\": {\n     \"commandMetadata\": 27,\n@@ -2292,6 +2292,13 @@\n       \"cmd-design-extract-plain-tune-01\": \"/design:extract\",\n       \"sv-07\": \"/create:skill\",\n       \"sv-10\": \"/design:chart\"\n-    }\n+    },\n+    \"needs_mode_floor\": {\n+      \"count\": 1,\n+      \"total\": 35\n+    },\n+    \"needsModeRows\": [\n+      \"nm-system-skill-advisor-01\"\n+    ]\n   }\n }\ndiff 