-supervision.cjs:551:      throw codedError('ESOCKETDIRSYMLINK', `Refusing to use symlinked SPECKIT_IPC_SOCKET_DIR for hf-model-server socket: ${socketDir}`);\n.skilled/bin/lib/model-server-supervision.cjs:865:  // SPECKIT_IPC_SOCKET_DIR (e.g. worktree env). Optional + additive: leases without it fall back\n.skilled/bin/lib/model-server-supervision.cjs:1336:    // Keep SPECKIT_IPC_SOCKET_DIR fail-closed: never mkdir/unlink through a symlinked or foreign-owned perimeter.\n.skilled/bin/lib/launcher-ipc-bridge.cjs:103:function shouldScopeIpcSocket(serviceName, socketDir = process.env.SPECKIT_IPC_SOCKET_DIR, env = process.env) {\n.skilled/bin/lib/launcher-ipc-bridge.cjs:141:  const rawSocketDir = env.SPECKIT_IPC_SOCKET_DIR\n.skilled/bin/lib/launcher-ipc-bridge.cjs:163:  if (process.env.SPECKIT_IPC_SOCKET_DIR?.startsWith('tcp://')) {\n.skilled/bin/lib/launcher-ipc-bridge.cjs:164:    return process.env.SPECKIT_IPC_SOCKET_DIR;\n.skilled/bin/lib/launcher-ipc-bridge.cjs:498:  // divergent SPECKIT_IPC_SOCKET_DIR (e.g. a secondary launcher in a different worktree env), the\n.skilled/bin/lib/launcher-ipc-bridge.cjs:505:  const socketDir = process.env.SPECKIT_IPC_SOCKET_DIR ?? DEFAULT_SKILL_ADVISOR_SOCKET_DIR;\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":".skilled/bin/skill-advisor.cjs:86:  if (!process.env.SPECKIT_IPC_SOCKET_DIR) {\n.skilled/bin/skill-advisor.cjs:87:    process.env.SPECKIT_IPC_SOCKET_DIR = defaultSocketDir;\n.skilled/bin/skill-advisor.cjs:89:  const socketDir = process.env.SPECKIT_IPC_SOCKET_DIR;\n.skilled/bin/skill-advisor.cjs:94:    fail(`skill-advisor socket path exceeds the Darwin sun_path limit: ${socketPath}. Set SPECKIT_IPC_SOCKET_DIR to a shorter directory or a tcp:// endpoint.`);\n.skilled/bin/cli-exit-taxonomy-smoke.cjs:94:        SPECKIT_IPC_SOCKET_DIR: socketDir,\n.skilled/bin/lib/model-server-supervision.cjs:41:// SPECKIT_IPC_SOCKET_DIR set) — the same directory both op