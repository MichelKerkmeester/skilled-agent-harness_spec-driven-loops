:       return await backfillLog(options);\n1244:     }\n1245:     // An unapproved project hook makes a Codex arm produce zeros that read like\n1246:     // refusals, so that arm is not measurable. No turn decides this answer, so a\n1247:     // dry run is refused here too and nothing writes the approval.\n1248:     if (\n1249:       options.runtime === 'codex'\n1250:       && codexHookApproval({ projectDir: PROJECT_DIR }) === 'unapproved'\n1251:     ) {\n1252:       writeJson({\n1253:         ok: false,\n1254:         code: 'codex-hooks-unapproved',\n1255:         runtime: 'codex',\n1256:         measurable: false,\n1257:         repair: `open /hooks in a Codex session at ${PROJECT_DIR} and approve each entry`,\n1258:       });\n1259:       return EXIT_REFUSED;\n1260:     }\n1261:     return await runArm(options, rowIds);\n1262:   } catch (error) {\n1263:     if (error instanceof UsageError) {\n1264:       process.stderr.write(`${SCRIPT_NAME}: ${error.message}\\n${USAGE}\\n`);\n1265:       return EXIT_REFUSED;\n1266:     }\n1267:     if (error instanceof Refusal) {\n1268:       writeJson({ ok: false, code: error.code, detail: error.message });\n1269:       return EXIT_REFUSED;\n1270:     }\n1271:     throw error;\n1272:   }\n1273: }\n1274: \n1275: // The runner's tables are exported for direct tests, so the CLI runs only when\n1276: // this file is the entry point. An imported module that parsed the host's argv\n1277: // would refuse on flags it never received. The entry path is compared after\n1278: // resolving links, because Node names a linked entry by its real path.\n1279: const invokedDirectly = (() => {\n1280:   if (typeof process.argv[1] !== 'string') return false;\n1281:   try {\n1282:     return realpathSync(process.argv[1]) === realpathSync(fileURLToPath(import.meta.url));\n1283:   } catch {\n1284:     return false;\n1285:   }\n1286: })();\n1287: \n1288: if (invokedDirectly) {\n1289:   try {\n1290:     process.exitCode = await main(process.argv.slice(2));\n1291:   } catch (error) {\n1292:     if (error instanceof UsageError) {\n1293:       process.stderr.write(`${SCRIPT_NAME}: ${error.message}\\n`);\n1294:       process.exitCode = EXIT_REFUSED;\n1295:     } else {\n1296:       throw error;\n1297:     }\n1298:   }\n1299: }","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file .skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/run-command-behaviour.mjs, lines 1210-1299\n1210: // A finished log is rewritten from its recorded lines alone, and the fixture folder\n1211: // still sits beside the log the arm wrote. The corpus lookup runs before the first\n1212: // line is written, so a row the dataset guard refuses leaves no output file behind.\n1213: async function backfillLog(options) {\n1214:   const fixture = resolve(dirname(options.backfill), G2_FIXTURE_DIRNAME);\n1215:   const result = await backfillRunLog({\n1216:     inPath: options.backfill,\n1217:     outPath: options.out,\n1218:     promptFor: (rowId) => promptFor(rowId, fixture),\n1219:     briefOnly: options.briefOnly,\n1220:   });\n1221:   writeJson(result);\n1222:   return result.ok ? 0 : EXIT_REFUSED;\n1223: }\n1224: \n1225: async function main(argv) {\n1226:   try {\n1227:     const options = parseOptions(argv);\n1228:     // Selection runs before the mode check, so an id the dataset guard refuses is\n1229:     // answered by that guard rather than by whichever usage check would run first.\n1230:     const rowIds = selectedRowIds(options);\n1231:     const mode = selectMode(options);\n1232:     options.arm = armFor(options);\n1233: \n1234:     if (mode === 'print-argv') {\n1235:       writeArgv(options.printArgv);\n1236:       return 0;\n1237:     }\n1238:     if (mode === 'list') {\n1239:       writeRowIds(rowIds);\n1240:       return 0;\n1241:     }\n1242:     if (mode === 'backfill') {\n1243:       return await backfillLog(options);\n1244:     }\n1245:     // An unapproved project hook makes a Codex arm produce zeros that read like\n1246:     // refusals, so that arm is not measurable. No turn decides this answer, so a\n1247:     // dry run is refused here too and nothing writes the approval.\n1248:     if (\n1249:       options.runtime === 'codex'\n1250:       && codexHookApproval({ projectDir: PROJECT_DIR }) === 'unapproved'\n1251:     ) {\n1252:       writeJson({\n1253:         ok: false,\n1254:         code: 'codex-hooks-unapproved',\n1255:         runtime: 'codex',\n1256:         measurable: false,\n1257:         repair: `open /hooks in a Codex session at ${PROJECT_DIR} and approve each entry`,\n1258:       });\n1259:       return EXIT_REFUSED;\n1260:     }\n1261:     return await runArm(options, rowIds);\n1262:   } catch (error) {\n1263:     if (error instanceof UsageError) {\n1264:       process.stderr.write(`${SCRIPT_NAME}: ${error.message}\\n${USAGE}\\n`);\n1265:       return EXIT_REFUSED;\n1266:     }\n1267:     if (error instanceof Refusal) {\n1268:       writeJson({ ok: false, code: error.code, detail: error.message });\n1269:       return EXIT_REFUSED;\n1270:     }\n1271:     throw error;\n1272:   }\n1273: }\n1274: \n1275: // The runner's tables are exported for direct tests, so the CLI runs only when\n1276: // this file is the entry point. An imported module that parsed the host's argv\n1277: // would refuse on flags it never received. The entry path is compared after\n1278: // resolving links, because Node names a linked entry by its real path.\n1279: const invokedDirectly = (() => {\n1280:   if (typeof process.argv[1] !== 'string') return false;\n1281:   try {\n1282:     return realpathSync(process.argv[1]) === realpathSync(fileURLToPath(import.meta.url));\n1283:   } catch {\n1284:     return false;\n1285:   }\n1286: })();\n1287: \n1288: if (invokedDirectly) {\n1289:   try {\n1290:     process.exitCode = await main(process.argv.slice(2));\n1291:   } catch (error) {\n1292:     if (error instanceof UsageError) {\n1293:       process.stderr.write(`${SCRIPT_NAME}: ${error.message}\\n`);\n1294:       process.exitCode = EXIT_REFUSED;\n1295:     } else {\n1296:       throw error;\n1297:     }\n1298:   }\n1299: }"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"offset\":1210,\"path\":\".skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/run-command-behaviour.mjs\"}"},"time":{"start":1794570393375,"end":1794570393443}}}}
