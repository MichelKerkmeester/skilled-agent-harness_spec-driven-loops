g_code\":{\"status\":\"pass\",\"notes\":\"Carried from iteration 4.\"},\"playbook_capability\":{\"status\":\"partial\",\"notes\":\"Root playbook statements carry iteration 4 findings; NC-011 holds.\"}},\"newFindingsRatio\":1.0,\"noveltyJustification\":\"First maintainability pass; the quoted-path defect and the header drift are both new and were not reached by the earlier dimensions.\",\"sessionId\":\"fanout-accuracy-runner-2-1794570021136-noekp0\",\"generation\":1,\"lineageMode\":\"new\",\"timestamp\":\"2026-11-13T12:13:00Z\",\"durationMs\":360000,\"reviewDepthSchemaVersion\":2,\"reviewDepthApplicability\":{\"scopeClass\":\"standard\",\"enforcement\":\"strict\",\"reason\":\"Maintainability pass over restore and scorer contracts with a local quoting probe; standard scope.\",\"evidenceRefs\":[\"review-scope-2.txt:103-205\"]},\"targetSelection\":{\"selectedTargets\":[\"worktree-restore.mjs\",\"run-command-behaviour.mjs\",\"score-command-transcripts.mjs\",\"tests/worktree-restore.vitest.ts\",\"README.md\",\"legacy parity and observability tests\",\"measure-embedder-cost.mjs\"],\"selectionReason\":\"Files not yet read at maintainability depth plus the pass-one clean surface whose contract the new dimensions touch.\",\"discoveryMethods\":[\"direct_read\",\"local_git_probe\",\"single_file_test_inspection\"],\"omittedHighRiskTargets\":[\"live behaviour arms (worktree dirty)\"],\"graphStatus\":\"unavailable\",\"semanticSearchStatus\":\"unavailable\",\"evidenceRefs\":[\"review-scope-2.txt:103-205\"]},\"searchCoverage\":{\"requiredBugClasses\":[\"restore_completeness\",\"path_quoting\",\"documentation_drift\",\"test_coverage_gap\"],\"covered\":[\"restore_completeness\",\"path_quoting\",\"documentation_drift\",\"test_coverage_gap\"],\"ruledOut\":[\"restore_completeness\",\"test_coverage_gap\"],\"deferred\":[],\"blocked\":[],\"graphCoverageMode\":\"graphless_fallback\"},\"searchLedger\":[{\"id\":\"SL-401\",\"dimension\":\"maintainability\",\"targetRefs\":[\"runtime/scripts/routing-accuracy/worktree-restore.mjs\"],\"bugClass\":\"path_quoting\",\"hypothesis\":\"A porcelain-quoted path cannot be restored.\",\"searchActions\":[{\"method\":\"direct_read\",\"queryOrPath\":\"worktree-restore.mjs:46-84\",\"result\":\"paths are keyed from line.slice(3) with no quote decoding\",\"evidenceRefs\":[\"worktree-restore.mjs:54\",\"worktree-restore.mjs:79\"]},{\"method\":\"local_git_probe\",\"queryOrPath\":\"git init in the lineage logs folder, then create 'a b.txt'\",\"result\":\"git status --porcelain prints ?? \\\"a b.txt\\\"\",\"evidenceRefs\":[\"logs/quotepath-probe\"]}],\"disposition\":\"finding\",\"rationale\":\"The restore cannot name a quoted path to git or to rmSync, so the file stays and the arm fails.\",\"linkedFindingId\":\"iter5-P2-quoted-path-restore\"},{\"id\":\"SL-402\",\"dimension\":\"maintainability\",\"targetRefs\":[\"runtime/scripts/routing-accuracy/score-command-transcripts.mjs\"],\"bugClass\":\"documentation_drift\",\"hypothesis\":\"The module header promises an output the CLI does not have.\",\"searchActions\":[{\"method\":\"direct_read\",\"queryOrPath\":\"score-command-transcripts.mjs:1-9,885-901,1392-1427\",\"result\":\"header names an ordered read/write report; both modes print counts\",\"evidenceRefs\":[\"score-command-transcripts.mjs:5\",\"score-command-transcripts.mjs:1398-1426\"]}],\"disposition\":\"finding\",\"rationale\":\"A maintainer looking for the stream finds no output path.\",\"linkedFindingId\":\"iter5-P2-scorer-header-ordered-report\"},{\"id\":\"SL-403\",\"dimension\":\"maintainability\",\"targetRefs\":[\"runtime/tests/worktree-restore.vitest.ts\"],\"bugClass\":\"test_coverage_gap\",\"hypothesis\":\"The restore tests omit a path with a space or quote.\",\"searchActions\":[{\"method\":\"negative_test_inspection\",\"queryOrPath\":\"tests/worktree-restore.vitest.ts:1-122\",\"result\":\"staged, deleted and inherited cases only; no quoted name\",\"evidenceRefs\":[\"tests/worktree-restore.vitest.ts:1-122\"]}],\"dispositi