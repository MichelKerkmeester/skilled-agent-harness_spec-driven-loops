ll":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"cd /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research; grep -rn \\\"SPECKIT_IPC_SOCKET_DIR\\\" --include=*.ts --include=*.mjs --include=*.cjs --include=*.js .skilled | grep -v node_modules | head -20\"}"},"time":{"start":1794570491795,"end":1794570510071}}}}
