{"type":"tool_use","timestamp":1794570617715,"sessionID":"ses_e2b4a2200ffebIrmmKNfkMdQAD","part":{"partID":"prt_1d4be81d2001QU98ZFXAcjGldl","sessionID":"ses_e2b4a2200ffebIrmmKNfkMdQAD","messageID":"msg_1d4be33f0001Qu7HzifnM8d8i7","type":"tool","id":"call_5e5eaa2989954f05a17d14be","tool":"read","state":{"status":"completed","input":{"limit":540,"path":".skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/score-command-transcripts.mjs"},"output":"Read file .skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/score-command-transcripts.mjs, lines 1-540\n1: #!/usr/bin/env node\n2: // ───────────────────────────────────────────────────────────────────\n3: // MODULE: COMMAND TRANSCRIPT SCORER\n4: // ───────────────────────────────────────────────────────────────────\n5: //\n6: // Reads a captured session through the shared session readers and reports what a\n7: // model did with the commands a turn offered it: the `COMMAND:` lines it printed,\n8: // the reads and writes in order, and whether a started loop ran its init first.\n9: //\n10: // Two input shapes share one CLI. `--summary` takes one or more run logs and\n11: // scores every row they list. `--runtime` plus `--locator` scores the one session\n12: // a locator names, which is how a single smoke run is checked before a whole arm\n13: // is spent.\n14: //\n15: // An unreadable session is never a partial score. Exit 2 prints the code the\n16: // reader returned, so a gated runtime reads differently from a missing session\n17: // and a run log that holds that code stays auditable.\n18: //\n19: // Usage:\n20: //   node score-command-transcripts.mjs --summary <run-log> [<run-log>...] [--row-id <id>] [--json]\n21: //   node score-command-transcripts.mjs --runtime <name> --locator '<json>' [--row-id <id>] [--json]\n22: \n23: // ───────────────────────────────────────────────────────────────────\n24: // 1. IMPORTS\n25: // ───────────────────────────────────────────────────────────────────\n26: \n27: import { readFileSync, realpathSync } from 'node:fs';\n28: import { dirname, resolve } from 'node:path';\n29: import { fileURLToPath } from 'node:url';\n30: import { loadSession } from '../../../../../hooks/shared/session-readers/index.mjs';\n31: import { G2_ROWS } from './run-command-behaviour.mjs';\n32: \n33: // ───────────────────────────────────────────────────────────────────\n34: // 2. CONSTANTS\n35: // ───────────────────────────────────────────────────────────────────\n36: \n37: const SCRIPT_NAME = 'score-command-transcripts.mjs';\n38: const EXIT_UNREADABLE = 2;\n39: const USAGE = [\n40:   `usage: ${SCRIPT_NAME} --runtime <name> --locator <json> [--row-id <id>] [--json]`,\n41:   `       ${SCRIPT_NAME} --summary <run-log> [<run-log>...] [--row-id <id>] [--json]`,\n42:   '',\n43: ].join('\\n');\n44: \n45: // ───────────────────────────────────────────────────────────────────\n46: // 3. ARGUMENT PARSING\n47: // ───────────────────────────────────────────────────────────────────\n48: \n49: /** A refusal the operator can act on without a stack trace. */\n50: class UsageError extends Error {}\n51: \n52: function valueAfter(argv, index, flag) {\n53:   const value = argv[index];\n54:   if (typeof value !== 'string' || value.startsWith('--')) {\n55:     throw new UsageError(`${flag}: a value is required`);\n56:   }\n57:   return value;\n58: }\n59: \n60: function parseLocator(text) {\n61:   let parsed;\n62:   try {\n63:     parsed = JSON.parse(text);\n64:   } catch {\n65:     throw new UsageError('--locator: not valid JSON');\n66:   }\n67:   if (parsed === null || typeof parsed !== 'object' || Array.isArray(parsed)) {\n68:     throw new UsageError('--locator: a JSON object is required');\n69:   }\n70:   return parsed;\n71: }\n72: \n73: function parseArgs(argv) {\n74:   const options = {\n75:     runtime: null,\n76:     locator: null,\n77:     rowId: null,\n78:     summaryLogs: null,\n79:     json: false,\n80:   };\n81: \n82:   for (let index = 0; index < argv.length; index += 1) {\n83:     const token = argv[index];\n84:     if (token === '--json') {\n85:       options.json = true;\n86:     } else if (token === '--runtime') {\n87:       index += 1;\n88:       options.runtime = valueAfter(argv, index, '--runtime');\n89:     } else if (token === '--locator') {\n90:       index += 1;\n91:       options.locator = parseLocator(valueAfter(argv, index, '--locator'));\n92:     } else if (token === '--row-id') {\n93:       index += 1;\n94:       options.rowId = valueAfter(argv, index, '--row-id');\n95:     } else if (token === '--summary') {\n96:       const logs = [];\n97:       while (index + 1 < argv.length && !argv[index + 1].startsWith('--')) {\n98:         logs.push(argv[index + 1]);\n99:         index += 1;\n100:       }\n101:       if (logs.length === 0) throw new UsageError('--summary: at least one run log is required');\n102:       options.summaryLogs = logs;\n103:     } else {\n104:       throw new UsageError(`unknown option: ${token}`);\n105:     }\n106:   }\n107: \n108:   return options;\n109: }\n110: \n111: // One input shape per run: a session named by a locator, or a run log that names\n112: // many. Accepting both at once would score one of them silently.\n113: function selectMode(options) {\n114:   if (options.summaryLogs !== null) {\n115:     if (options.runtime !== null || options.locator !== null) {\n116:       throw new UsageError('--summary cannot be combined with --runtime or --locator');\n117:     }\n118:     return 'summary';\n119:   }\n120:   if (options.runtime === null) throw new UsageError('--runtime is required with --locator');\n121:   if (options.locator === null) throw new UsageError('--locator is required with --runtime');\n122:   return 'session';\n123: }\n124: \n125: // ───────────────────────────────────────────────────────────────────\n126: // 4. OUTPUT\n127: // ───────────────────────────────────────────────────────────────────\n128: \n129: function writeJson(value) {\n130:   process.stdout.write(`${JSON.stringify(value)}\\n`);\n131: }\n132: \n133: // A refusal keeps one machine-readable shape whichever flags were passed, so a\n134: // caller that reads runs in bulk never has to parse a prose error.\n135: function writeRefusal(code) {\n136:   writeJson({ ok: false, code });\n137: }\n138: \n139: // ───────────────────────────────────────────────────────────────────\n140: // 5. TOOL NORMALIZATION\n141: // ───────────────────────────────────────────────────────────────────\n142: \n143: // One tool name means read, write, shell or skill only inside its own runtime, so\n144: // every runtime carries its own table. The Claude row starts from the set the\n145: // repo-rule compliance measure already matches, so a read or write it counted stays\n146: // counted here, and the other rows add the file and shell names each runtime\n147: // registers as the repository's hooks name them.\n148: //\n149: // A tool name is compared with case folded, because Claude capitalises its tools and\n150: // the rest do not. The skill tool keeps one name across the runtimes that have one,\n151: // and a runtime that loads a skill by reading its SKILL.md leaves that read in place\n152: // of a skill event.\n153: const TOOL_TABLES = Object.freeze({\n154:   claude: Object.freeze({\n155:     read: Object.freeze(['Read']),\n156:     write: Object.freeze(['Write', 'Edit', 'MultiEdit', 'NotebookEdit']),\n157:     shell: Object.freeze(['Bash']),\n158:     skill: Object.freeze(['Skill']),\n159:   }),\n160:   codex: Object.freeze({\n161:     read: Object.freeze(['read_file']),\n162:     write: Object.freeze(['apply_patch', 'write', 'edit']),\n163:     shell: Object.freeze(['shell', 'exec_command', 'exec', 'bash']),\n164:     skill: Object.freeze(['Skill']),\n165:   }),\n166:   opencode: Object.freeze({\n167:     read: Object.freeze(['read']),\n168:     write: Object.freeze(['write', 'edit', 'multiedit', 'patch', 'apply_patch']),\n169:     shell: Object.freeze(['bash', 'shell', 'exec']),\n170:     skill: Object.freeze(['Skill']),\n171:   }),\n172:   pi: Object.freeze({\n173:     read: Object.freeze(['read']),\n174:     write: Object.freeze(['write', 'edit']),\n175:     shell: Object.freeze(['bash', 'powershell']),\n176:     skill: Object.freeze(['Skill']),\n177:   }),\n178:   devin: Object.freeze({\n179:     read: Object.freeze(['read_file', 'read']),\n180:     write: Object.freeze(['write', 'edit', 'apply_patch']),\n181:     shell: Object.freeze(['bash', 'exec', 'run_command', 'run-command']),\n182:     skill: Object.freeze(['Skill']),\n183:   }),\n184:   dsh: Object.freeze({\n185:     read: Object.freeze(['read']),\n186:     write: Object.freeze(['write', 'edit', 'apply_patch']),\n187:     shell: Object.freeze(['bash', 'shell', 'exec']),\n188:     skill: Object.freeze(['Skill']),\n189:   }),\n190: });\n191: \n192: // A patch names its targets inside its body, so a write that carries one reports\n193: // those paths rather than a field the call never sets.\n194: const PATCH_HEADER = /\\*\\*\\* (?:Update|Add|Delete) File: ([^\\\\\\n\"]+)|\\*\\*\\* Move to: ([^\\\\\\n\"]+)/g;\n195: // A stream sent to the void writes no file, and neither does a dup of a descriptor.\n196: const DISCARDED_TARGET = /^(?:&[12]|\\/dev\\/(?:null|stdout|stderr)|-)$/;\n197: // A shell that runs the patch tool writes wherever the patch points.\n198: const APPLY_PATCH = /\\bapply[_-]patch\\b/;\n199: \n200: // Claude Code expands a typed command before the model sees it and keeps only\n201: // this tag in the stored user turn, so the tag is the start.\n202: const COMMAND_NAME_TAG = /<command-name>\\s*(\\/[^<\\s]+)\\s*<\\/command-name>/;\n203: \n204: const PATH_KEYS = Object.freeze(['file_path', 'filePath', 'notebook_path', 'path']);\n205: const PATCH_BODY_KEYS = Object.freeze(['patch', 'input', 'diff']);\n206: const SKILL_NAME_KEYS = Object.freeze(['skill', 'name', 'id']);\n207: const SHELL_COMMAND_KEYS = Object.freeze(['command']);\n208: const SHELL_BOUNDARY = /[\\s;&|()<>]/;\n209: \n210: function tableFor(runtime) {\n211:   const table = TOOL_TABLES[runtime];\n212:   if (!table) throw new TypeError(`normalize: no tool table for runtime ${runtime}`);\n213:   return table;\n214: }\n215: \n216: function kindOf(table, name) {\n217:   const wanted = String(name ?? '').toLowerCase();\n218:   for (const [kind, names] of Object.entries(table)) {\n219:     if (names.some((candidate) => candidate.toLowerCase() === wanted)) return kind;\n220:   }\n221:   return null;\n222: }\n223: \n224: function firstString(source, keys) {\n225:   for (const key of keys) {\n226:     const value = source[key];\n227:     if (typeof value === 'string' && value.trim()) return value.trim();\n228:   }\n229:   return null;\n230: }\n231: \n232: function patchPaths(text) {\n233:   const paths = [];\n234:   for (const match of text.matchAll(PATCH_HEADER)) {\n235:     const path = (match[1] ?? match[2] ?? '').trim();\n236:     if (path) paths.push(path);\n237:   }\n238:   return paths;\n239: }\n240: \n241: // A redirect is a write even when the tool is only a shell. The scan respects\n242: // quoting, because a `>` inside a quoted argument is text and not a redirect, and a\n243: // false write would move the first-write boundary the read measure turns on.\n244: function redirectTargets(command) {\n245:   const targets = [];\n246:   let quote = null;\n247: \n248:   for (let index = 0; index < command.length; index += 1) {\n249:     const char = command[index];\n250:     if (quote !== null) {\n251:       if (char === '\\\\' && quote === '\"') index += 1;\n252:       else if (char === quote) quote = null;\n253:       continue;\n254:     }\n255:     if (char === '\"' || char === \"'\") {\n256:       quote = char;\n257:       continue;\n258:     }\n259:     if (char !== '>') continue;\n260: \n261:     let cursor = index + 1;\n262:     while (command[cursor] === '>') cursor += 1;\n263:     while (cursor < command.length && /\\s/.test(command[cursor])) cursor += 1;\n264: \n265:     const closer = command[cursor] === '\"' || command[cursor] === \"'\" ? command[cursor] : null;\n266:     let target = '';\n267:     if (closer !== null) {\n268:       cursor += 1;\n269:       while (cursor < command.length && command[cursor] !== closer) {\n270:         if (command[cursor] === '\\\\' && closer === '\"') cursor += 1;\n271:         target += command[cursor] ?? '';\n272:         cursor += 1;\n273:       }\n274:       cursor += 1;\n275:     } else {\n276:       while (cursor < command.length && !SHELL_BOUNDARY.test(command[cursor])) {\n277:         target += command[cursor];\n278:         cursor += 1;\n279:       }\n280:     }\n281: \n282:     if (target && !DISCARDED_TARGET.test(target)) targets.push(target);\n283:     index = cursor - 1;\n284:   }\n285: \n286:   return targets;\n287: }\n288: \n289: function writePaths(args) {\n290:   const paths = [];\n291:   const named = firstString(args, PATH_KEYS);\n292:   if (named !== null) paths.push(named);\n293: \n294:   const body = PATCH_BODY_KEYS.map((key) => args[key])\n295:     .filter((value) => typeof value === 'string')\n296:     .join('\\n');\n297:   paths.push(...patchPaths(body));\n298: \n299:   // A write whose target the record does not name is still a write, so it is kept\n300:   // with no path rather than dropped from the order.\n301:   return paths.length > 0 ? [...new Set(paths)] : [null];\n302: }\n303: \n304: function addEvent(events, kind, fields) {\n305:   events.push({\n306:     seq: events.length,\n307:     kind,\n308:     path: fields.path ?? null,\n309:     command: fields.command ?? null,\n310:     text: fields.text ?? null,\n311:   });\n312: }\n313: \n314: /**\n315:  * Flatten raw session records into the one event shape the checks read.\n316:  *\n317:  * An assistant text block and each tool call become their own event, so a record\n318:  * that carries prose plus two calls loses neither, and `seq` is the event's place\n319:  * in that flattened stream. A prompt is input rather than behaviour, so it is not an\n320:  * event. A tool the runtime's table does not name is not an event either: the facts\n321:  * scored are reads, writes, shell steps and skill loads, and a plan update would\n322:  * only sit between them.\n323:  *\n324:  * @param {Array<object>} records - Neutral records from `loadSession`.\n325:  * @param {string} runtime - The measured runtime whose table applies.\n326:  * @returns {Array<{seq: number, kind: string, path: string|null, command: string|null, text: string|null}>}\n327:  * @throws {TypeError} When the runtime has no table. An empty stream would score a\n328:  *   session as clean behaviour it never showed.\n329:  */\n330: export function normalize(records, runtime) {\n331:   const table = tableFor(runtime);\n332:   const events = [];\n333: \n334:   for (const record of records ?? []) {\n335:     if (!record || typeof record !== 'object') continue;\n336:     const blocks = Array.isArray(record.content) ? record.content : [];\n337: \n338:     for (const block of blocks) {\n339:       if (!block || typeof block !== 'object') continue;\n340: \n341:       if (block.type === 'text') {\n342:         if (record.role === 'assistant' && typeof block.text === 'string' && block.text.trim()) {\n343:           addEvent(events, 'text', { text: block.text });\n344:         } else if (runtime === 'claude' && record.role === 'user' && typeof block.text === 'string') {\n345:           const expanded = COMMAND_NAME_TAG.exec(block.text);\n346:           if (expanded !== null) addEvent(events, 'expanded', { command: expanded[1] });\n347:         }\n348:         continue;\n349:       }\n350:       if (block.type !== 'toolCall') continue;\n351: \n352:       const kind = kindOf(table, block.name);\n353:       if (kind === null) continue;\n354: \n355:       const args = block.arguments && typeof block.arguments === 'object' ? block.arguments : {};\n356: \n357:       if (kind === 'shell') {\n358:         const command = firstString(args, SHELL_COMMAND_KEYS);\n359:         const redirected = command === null ? [] : redirectTargets(command);\n360:         if (redirected.length > 0) {\n361:           for (const path of redirected) addEvent(events, 'write', { path, command });\n362:           continue;\n363:         }\n364:         if (command !== null && APPLY_PATCH.test(command)) {\n365:           const patched = patchPaths(command);\n366:           for (const path of patched.length > 0 ? patched : [null]) {\n367:             addEvent(events, 'write', { path, command });\n368:           }\n369:           continue;\n370:         }\n371:         addEvent(events, 'shell', { command });\n372:         continue;\n373:       }\n374: \n375:       if (kind === 'read') {\n376:         addEvent(events, 'read', { path: firstString(args, PATH_KEYS) });\n377:         continue;\n378:       }\n379: \n380:       if (kind === 'skill') {\n381:         addEvent(events, 'skill', {\n382:           command: firstString(args, SKILL_NAME_KEYS) ?? block.name,\n383:           path: firstString(args, PATH_KEYS),\n384:         });\n385:         continue;\n386:       }\n387: \n388:       for (const path of writePaths(args)) addEvent(events, 'write', { path });\n389:     }\n390:   }\n391: \n392:   return events;\n393: }\n394: \n395: // ───────────────────────────────────────────────────────────────────\n396: // 6. COMMAND LINE FACTS\n397: // ───────────────────────────────────────────────────────────────────\n398: \n399: // The line a model prints about an offered command is the only evidence in the\n400: // transcript that it took the command, offered it or turned it down, so the\n401: // three state words are the whole vocabulary it may carry.\n402: //\n403: // The token is matched anywhere in a line because a model marks it up as a list\n404: // item, a bold run or a code span. It wraps the name and the state word in\n405: // whichever markup reads well there, so a backtick, a square bracket or both is\n406: // allowed on each side of each token and the pair is never required. The name\n407: // must open with a letter or digit so a reply that quotes the instruction's\n408: // `[/name]` placeholder is not read as a command the model reported.\n409: const COMMAND_LINE =\n410:   /\\bCOMMAND:[ \\t`\\[]*(\\/[A-Za-z0-9][\\w.:-]*)[ \\t`\\]]*(?:→|->)[ \\t`\\[]*(started|offered|declined)\\b/i;\n411: \n412: /**\n413:  * Collect the `COMMAND:` lines a model printed, in the order it printed them.\n414:  *\n415:  * One assistant text block can hold several lines, so every block is split and\n416:  * each line is tested on its own. A line that names a command twice still counts\n417:  * once, because the count exists to expose a command reported more than once and\n418:  * a per-line tally would hide exactly that.\n419:  *\n420:  * @param {Array<{seq: number, kind: string, text: string|null}>} events - Events\n421:  *   from `normalize`.\n422:  * @returns {Array<{seq: number, command: string, state: string, count: number}>}\n423:  *   One entry per matching line, where `count` is how many lines named that\n424:  *   command across the whole session.\n425:  */\n426: export function commandLines(events) {\n427:   const lines = [];\n428: \n429:   for (const event of events ?? []) {\n430:     if (!event || event.kind !== 'text' || typeof event.text !== 'string') continue;\n431: \n432:     for (const text of event.text.split('\\n')) {\n433:       const match = COMMAND_LINE.exec(text);\n434:       if (match === null) continue;\n435:       lines.push({ seq: event.seq, command: match[1], state: match[2].toLowerCase(), count: 0 });\n436:     }\n437:   }\n438: \n439:   const totals = new Map();\n440:   for (const line of lines) totals.set(line.command, (totals.get(line.command) ?? 0) + 1);\n441:   for (const line of lines) line.count = totals.get(line.command);\n442: \n443:   return lines;\n444: }\n445: \n446: /**\n447:  * Read whether a session's `COMMAND:` lines named the command a row expected.\n448:  *\n449:  * A model writes that line after it read the head, so the line is evidence the\n450:  * offer reached it even when the turn declined the command, which the run line's\n451:  * own offer field cannot show. The last matching line decides the state, because\n452:  * a later line is the model's final answer about the same command.\n453:  *\n454:  * @param {Array<{seq: number, kind: string, text: string|null}>} events - Events\n455:  *   from `normalize`.\n456:  * @param {string|null} expectedCommand - The row's expected command, with or\n457:  *   without its leading slash and its mode suffix.\n458:  * @returns {{offerSeen: boolean, commandState: string|null}} Whether at least one\n459:  *   line named the command, and the state of the last line that did.\n460:  */\n461: export function offerSeenIn(events, expectedCommand) {\n462:   const wanted = commandParts(expectedCommand);\n463:   if (wanted === null) return { offerSeen: false, commandState: null };\n464: \n465:   const seen = commandLines(events).filter((line) => namesCommand(line.command, wanted));\n466:   return {\n467:     offerSeen: seen.length > 0,\n468:     commandState: seen.length > 0 ? seen[seen.length - 1].state : null,\n469:   };\n470: }\n471: \n472: // ───────────────────────────────────────────────────────────────────\n473: // 7. FOLLOW ORDER\n474: // ───────────────────────────────────────────────────────────────────\n475: \n476: // A model writes the mode it chose onto the command, so the namespace and the\n477: // bare name are read before any document is named.\n478: const MODE_SUFFIX = /:(?:auto|confirm|autopilot|unattended)$/i;\n479: \n480: // A command is a namespace and a name, and a command outside a namespace is a\n481: // name alone. Deeper segments are kept with the name so an unfamiliar shape is\n482: // looked up under the name it actually shows rather than silently shortened.\n483: // A command can carry the target it acts on after its name, so the text before\n484: // the first space is the name its document is looked up under and the rest is\n485: // the route it was given. Without that split a routed command would look for a\n486: // document named after the whole phrase.\n487: function commandParts(command) {\n488:   const text = String(command ?? '').trim().replace(/^\\/+/, '');\n489:   const segments = text.replace(MODE_SUFFIX, '').split(':').map((part) => part.trim()).filter(Boolean);\n490:   if (segments.length === 0) return null;\n491:   const namespace = segments.length === 1 ? null : segments[0];\n492:   const whole = segments.length === 1 ? segments[0] : segments.slice(1).join(':');\n493:   const space = whole.search(/\\s/);\n494:   if (space === -1) return { namespace, name: whole };\n495:   return { namespace, name: whole.slice(0, space), route: whole.slice(space + 1).trim() };\n496: }\n497: \n498: // A runtime mirror keeps the command tree under its own root and some runtimes\n499: // join the namespace into the file name, so a tail is matched rather than a full\n500: // path that each runtime may root somewhere else.\n501: function tailMatches(value, tails) {\n502:   const path = String(value ?? '').trim().replace(/\\\\/g, '/').replace(/^\\.\\//, '');\n503:   if (!path) return false;\n504:   return tails.some((tail) => path.endsWith(tail) || path === tail.replace(/^\\//, ''));\n505: }\n506: \n507: // The document a command routes to sits at `<commands>/<namespace>/<name>.md`, and\n508: // a mirror that flattens the folder joins its two parts with a dash.\n509: function documentTails({ namespace, name }) {\n510:   if (namespace === null) return [`/commands/${name}.md`];\n511:   return [`/commands/${namespace}/${name}.md`, `/commands/${namespace}-${name}.md`];\n512: }\n513: \n514: // A confirm workflow sits beside the command's other assets and takes the command\n515: // name with a `-confirm` suffix, which is the file a confirming run loads before\n516: // its first write.\n517: function confirmTails({ namespace, name }) {\n518:   const base = namespace === null\n519:     ? `/commands/assets/${name}-confirm`\n520:     : `/commands/${namespace}/assets/${namespace}-${name}-confirm`;\n521:   return [`${base}.yaml`, `${base}.yml`];\n522: }\n523: \n524: // A skill load names the command directly instead of naming a file, so the name is\n525: // compared once the mode suffix has come off both sides.\n526: function namesCommand(value, wanted) {\n527:   const other = commandParts(value);\n528:   return other !== null && other.namespace === wanted.namespace && other.name === wanted.name;\n529: }\n530: \n531: function positionOf(event, index) {\n532:   return typeof event.seq === 'number' ? event.seq : index;\n533: }\n534: \n535: function firstWritePosition(events) {\n536:   for (let index = 0; index < events.length; index += 1) {\n537:     const event = events[index];\n538:     if (event && event.kind === 'write') return positionOf(event, index);\n539:   }\n540:   return null;\n[Output truncated. Continue reading with offset: 541]","title":"read","metadata":{"metadata":{"truncated":true},"content":[{"type":"text","text":"Read file .skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/score-command-transcripts.mjs, lines 1-540\n1: #!/usr/bin/env node\n2: // ───────────────────────────────────────────────────────────────────\n3: // MODULE: COMMAND TRANSCRIPT SCORER\n4: // ───────────────────────────────────────────────────────────────────\n5: //\n6: // Reads a captured session through the shared session readers and reports what a\n7: // model did with the commands a turn offered it: the `COMMAND:` lines it printed,\n8: // the reads and writes in order, and whether a started loop ran its init first.\n9: //\n10: // Two input shapes share one CLI. `--summary` takes one or more run logs and\n11: // scores every row they list. `--runtime` plus `--locator` scores the one session\n12: // a locator names, which is how a single smoke run is checked before a whole arm\n13: // is spent.\n14: //\n15: // An unreadable session is never a partial score. Exit 2 prints the code the\n16: // reader returned, so a gated runtime reads differently from a missing session\n17: // and a run log that holds that code stays auditable.\n18: //\n19: // Usage:\n20: //   node score-command-transcripts.mjs --summary <run-log> [<run-log>...] [--row-id <id>] [--json]\n21: //   node score-command-transcripts.mjs --runtime <name> --locator '<json>' [--row-id <id>] [--json]\n22: \n23: // ───────────────────────────────────────────────────────────────────\n24: // 1. IMPORTS\n25: // ───────────────────────────────────────────────────────────────────\n26: \n27: import { readFileSync, realpathSync } from 'node:fs';\n28: import { dirname, resolve } from 'node:path';\n29: import { fileURLToPath } from 'node:url';\n30: import { loadSession } from '../../../../../hooks/shared/session-readers/index.mjs';\n31: import { G2_ROWS } from './run-command-behaviour.mjs';\n32: \n33: // ───────────────────────────────────────────────────────────────────\n34: // 2. CONSTANTS\n35: // ───────────────────────────────────────────────────────────────────\n36: \n37: const SCRIPT_NAME = 'score-command-transcripts.mjs';\n38: const EXIT_UNREADABLE = 2;\n39: const USAGE = [\n40:   `usage: ${SCRIPT_NAME} --runtime <name> --locator <json> [--row-id <id>] [--json]`,\n41:   `       ${SCRIPT_NAME} --summary <run-log> [<run-log>...] [--row-id <id>] [--json]`,\n42:   '',\n43: ].join('\\n');\n44: \n45: // ───────────────────────────────────────────────────────────────────\n46: // 3. ARGUMENT PARSING\n47: // ───────────────────────────────────────────────────────────────────\n48: \n49: /** A refusal the operator can act on without a stack trace. */\n50: class UsageError extends Error {}\n51: \n52: function valueAfter(argv, index, flag) {\n53:   const value = argv[index];\n54:   if (typeof value !== 'string' || value.startsWith('--')) {\n55:     throw new UsageError(`${flag}: a value is required`);\n56:   }\n57:   return value;\n58: }\n59: \n60: function parseLocator(text) {\n61:   let parsed;\n62:   try {\n63:     parsed = JSON.parse(text);\n64:   } catch {\n65:     throw new UsageError('--locator: not valid JSON');\n66:   }\n67:   if (parsed === null || typeof parsed !== 'object' || Array.isArray(parsed)) {\n68:     throw new UsageError('--locator: a JSON object is required');\n69:   }\n70:   return parsed;\n71: }\n72: \n73: function parseArgs(argv) {\n74:   const options = {\n75:     runtime: null,\n76:     locator: null,\n77:     rowId: null,\n78:     summaryLogs: null,\n79:     json: false,\n80:   };\n81: \n82:   for (let index = 0; index < argv.length; index += 1) {\n83:     const token = argv[index];\n84:     if (token === '--json') {\n85:       options.json = true;\n86:     } else if (token === '--runtime') {\n87:       index += 1;\n88:       options.runtime = valueAfter(argv, index, '--runtime');\n89:     } else if (token === '--locator') {\n90:       index += 1;\n91:       options.locator = parseLocator(valueAfter(argv, index, '--locator'));\n92:     } else if (token === '--row-id') {\n93:       index += 1;\n94:       options.rowId = valueAfter(argv, index, '--row-id');\n95:     } else if (token === '--summary') {\n96:       const logs = [];\n97:       while (index + 1 < argv.length && !argv[index + 1].startsWith('--')) {\n98:         logs.push(argv[index + 1]);\n99:         index += 1;\n100:       }\n101:       if (logs.length === 0) throw new UsageError('--summary: at least one run log is required');\n102:       options.summaryLogs = logs;\n103:     } else {\n104:       throw new UsageError(`unknown option: ${token}`);\n105:     }\n106:   }\n107: \n108:   return options;\n109: }\n110: \n111: // One input shape per run: a session named by a locator, or a run log that names\n112: // many. Accepting both at once would score one of them silently.\n113: function selectMode(options) {\n114:   if (options.summaryLogs !== null) {\n115:     if (options.runtime !== null || options.locator !== null) {\n116:       throw new UsageError('--summary cannot be combined with --runtime or --locator');\n117:     }\n118:     return 'summary';\n119:   }\n120:   if (options.runtime === null) throw new UsageError('--runtime is required with --locator');\n121:   if (options.locator === null) throw new UsageError('--locator is required with --runtime');\n122:   return 'session';\n123: }\n124: \n125: // ───────────────────────────────────────────────────────────────────\n126: // 4. OUTPUT\n127: // ───────────────────────────────────────────────────────────────────\n128: \n129: function writeJson(value) {\n130:   process.stdout.write(`${JSON.stringify(value)}\\n`);\n131: }\n132: \n133: // A refusal keeps one machine-readable shape whichever flags were passed, so a\n134: // caller that reads runs in bulk never has to parse a prose error.\n135: function writeRefusal(code) {\n136:   writeJson({ ok: false, code });\n137: }\n138: \n139: // ───────────────────────────────────────────────────────────────────\n140: // 5. TOOL NORMALIZATION\n141: // ───────────────────────────────────────────────────────────────────\n142: \n143: // One tool name means read, write, shell or skill only inside its own runtime, so\n144: // every runtime carries its own table. The Claude row starts from the set the\n145: // repo-rule compliance measure already matches, so a read or write it counted stays\n146: // counted here, and the other rows add the file and shell names each runtime\n147: // registers as the repository's hooks name them.\n148: //\n149: // A tool name is compared with case folded, because Claude capitalises its tools and\n150: // the rest do not. The skill tool keeps one name across the runtimes that have one,\n151: // and a runtime that loads a skill by reading its SKILL.md leaves that read in place\n152: // of a skill event.\n153: const TOOL_TABLES = Object.freeze({\n154:   claude: Object.freeze({\n155:     read: Object.freeze(['Read']),\n156:     write: Object.freeze(['Write', 'Edit', 'MultiEdit', 'NotebookEdit']),\n157:     shell: Object.freeze(['Bash']),\n158:     skill: Object.freeze(['Skill']),\n159:   }),\n160:   codex: Object.freeze({\n161:     read: Object.freeze(['read_file']),\n162:     write: Object.freeze(['apply_patch', 'write', 'edit']),\n163:     shell: Object.freeze(['shell', 'exec_command', 'exec', 'bash']),\n164:     skill: Object.freeze(['Skill']),\n165:   }),\n166:   opencode: Object.freeze({\n167:     read: Object.freeze(['read']),\n168:     write: Object.freeze(['write', 'edit', 'multiedit', 'patch', 'apply_patch']),\n169:     shell: Object.freeze(['bash', 'shell', 'exec']),\n170:     skill: Object.freeze(['Skill']),\n171:   }),\n172:   pi: Object.freeze({\n173:     read: Object.freeze(['read']),\n174:     write: Object.freeze(['write', 'edit']),\n175:     shell: Object.freeze(['bash', 'powershell']),\n176:     skill: Object.freeze(['Skill']),\n177:   }),\n178:   devin: Object.freeze({\n179:     read: Object.freeze(['read_file', 'read']),\n180:     write: Object.freeze(['write', 'edit', 'apply_patch']),\n181:     shell: Object.freeze(['bash', 'exec', 'run_command', 'run-command']),\n182:     skill: Object.freeze(['Skill']),\n183:   }),\n184:   dsh: Object.freeze({\n185:     read: Object.freeze(['read']),\n186:     write: Object.freeze(['write', 'edit', 'apply_patch']),\n187:     shell: Object.freeze(['bash', 'shell', 'exec']),\n188:     skill: Object.freeze(['Skill']),\n189:   }),\n190: });\n191: \n192: // A patch names its targets inside its body, so a write that carries one reports\n193: // those paths rather than a field the call never sets.\n194: const PATCH_HEADER = /\\*\\*\\* (?:Update|Add|Delete) File: ([^\\\\\\n\"]+)|\\*\\*\\* Move to: ([^\\\\\\n\"]+)/g;\n195: // A stream sent to the void writes no file, and neither does a dup of a descriptor.\n196: const DISCARDED_TARGET = /^(?:&[12]|\\/dev\\/(?:null|stdout|stderr)|-)$/;\n197: // A shell that runs the patch tool writes wherever the patch points.\n198: const APPLY_PATCH = /\\bapply[_-]patch\\b/;\n199: \n200: // Claude Code expands a typed command before the model sees it and keeps only\n201: // this tag in the stored user turn, so the tag is the start.\n202: const COMMAND_NAME_TAG = /<command-name>\\s*(\\/[^<\\s]+)\\s*<\\/command-name>/;\n203: \n204: const PATH_KEYS = Object.freeze(['file_path', 'filePath', 'notebook_path', 'path']);\n205: const PATCH_BODY_KEYS = Object.freeze(['patch', 'input', 'diff']);\n206: const SKILL_NAME_KEYS = Object.freeze(['skill', 'name', 'id']);\n207: const SHELL_COMMAND_KEYS = Object.freeze(['command']);\n208: const SHELL_BOUNDARY = /[\\s;&|()<>]/;\n209: \n210: function tableFor(runtime) {\n211:   const table = TOOL_TABLES[runtime];\n212:   if (!table) throw new TypeError(`normalize: no tool table for runtime ${runtime}`);\n213:   return table;\n214: }\n215: \n216: function kindOf(table, name) {\n217:   const wanted = String(name ?? '').toLowerCase();\n218:   for (const [kind, names] of Object.entries(table)) {\n219:     if (names.some((candidate) => candidate.toLowerCase() === wanted)) return kind;\n220:   }\n221:   return null;\n222: }\n223: \n224: function firstString(source, keys) {\n225:   for (const key of keys) {\n226:     const value = source[key];\n227:     if (typeof value === 'string' && value.trim()) return value.trim();\n228:   }\n229:   return null;\n230: }\n231: \n232: function patchPaths(text) {\n233:   const paths = [];\n234:   for (const match of text.matchAll(PATCH_HEADER)) {\n235:     const path = (match[1] ?? match[2] ?? '').trim();\n236:     if (path) paths.push(path);\n237:   }\n238:   return paths;\n239: }\n240: \n241: // A redirect is a write even when the tool is only a shell. The scan respects\n242: // quoting, because a `>` inside a quoted argument is text and not a redirect, and a\n243: // false write would move the first-write boundary the read measure turns on.\n244: function redirectTargets(command) {\n245:   const targets = [];\n246:   let quote = null;\n247: \n248:   for (let index = 0; index < command.length; index += 1) {\n249:     const char = command[index];\n250:     if (quote !== null) {\n251:       if (char === '\\\\' && quote === '\"') index += 1;\n252:       else if (char === quote) quote = null;\n253:       continue;\n254:     }\n255:     if (char === '\"' || char === \"'\") {\n256:       quote = char;\n257:       continue;\n258:     }\n259:     if (char !== '>') continue;\n260: \n261:     let cursor = index + 1;\n262:     while (command[cursor] === '>') cursor += 1;\n263:     while (cursor < command.length && /\\s/.test(command[cursor])) cursor += 1;\n264: \n265:     const closer = command[cursor] === '\"' || command[cursor] === \"'\" ? command[cursor] : null;\n266:     let target = '';\n267:     if (closer !== null) {\n268:       cursor += 1;\n269:       while (cursor < command.length && command[cursor] !== closer) {\n270:         if (command[cursor] === '\\\\' && closer === '\"') cursor += 1;\n271:         target += command[cursor] ?? '';\n272:         cursor += 1;\n273:       }\n274:       cursor += 1;\n275:     } else {\n276:       while (cursor < command.length && !SHELL_BOUNDARY.test(command[cursor])) {\n277:         target += command[cursor];\n278:         cursor += 1;\n279:       }\n280:     }\n281: \n282:     if (target && !DISCARDED_TARGET.test(target)) targets.push(target);\n283:     index = cursor - 1;\n284:   }\n285: \n286:   return targets;\n287: }\n288: \n289: function writePaths(args) {\n290:   const paths = [];\n291:   const named = firstString(args, PATH_KEYS);\n292:   if (named !== null) paths.push(named);\n293: \n294:   const body = PATCH_BODY_KEYS.map((key) => args[key])\n295:     .filter((value) => typeof value === 'string')\n296:     .join('\\n');\n297:   paths.push(...patchPaths(body));\n298: \n299:   // A write whose target the record does not name is still a write, so it is kept\n300:   // with no path rather than dropped from the order.\n301:   return paths.length > 0 ? [...new Set(paths)] : [null];\n302: }\n303: \n304: function addEvent(events, kind, fields) {\n305:   events.push({\n306:     seq: events.length,\n307:     kind,\n308:     path: fields.path ?? null,\n309:     command: fields.command ?? null,\n310:     text: fields.text ?? null,\n311:   });\n312: }\n313: \n314: /**\n315:  * Flatten raw session records into the one event shape the checks read.\n316:  *\n317:  * An assistant text block and each tool call become their own event, so a record\n318:  * that carries prose plus two calls loses neither, and `seq` is the event's place\n319:  * in that flattened stream. A prompt is input rather than behaviour, so it is not an\n320:  * event. A tool the runtime's table does not name is not an event either: the facts\n321:  * scored are reads, writes, shell steps and skill loads, and a plan update would\n322:  * only sit between them.\n323:  *\n324:  * @param {Array<object>} records - Neutral records from `loadSession`.\n325:  * @param {string} runtime - The measured runtime whose table applies.\n326:  * @returns {Array<{seq: number, kind: string, path: string|null, command: string|null, text: string|null}>}\n327:  * @throws {TypeError} When the runtime has no table. An empty stream would score a\n328:  *   session as clean behaviour it never showed.\n329:  */\n330: export function normalize(records, runtime) {\n331:   const table = tableFor(runtime);\n332:   const events = [];\n333: \n334:   for (const record of records ?? []) {\n335:     if (!record || typeof record !== 'object') continue;\n336:     const blocks = Array.isArray(record.content) ? record.content : [];\n337: \n338:     for (const block of blocks) {\n339:       if (!block || typeof block !== 'object') continue;\n340: \n341:       if (block.type === 'text') {\n342:         if (record.role === 'assistant' && typeof block.text === 'string' && block.text.trim()) {\n343:           addEvent(events, 'text', { text: block.text });\n344:         } else if (runtime === 'claude' && record.role === 'user' && typeof block.text === 'string') {\n345:           const expanded = COMMAND_NAME_TAG.exec(block.text);\n346:           if (expanded !== null) addEvent(events, 'expanded', { command: expanded[1] });\n347:         }\n348:         continue;\n349:       }\n350:       if (block.type !== 'toolCall') continue;\n351: \n352:       const kind = kindOf(table, block.name);\n353:       if (kind === null) continue;\n354: \n355:       const args = block.arguments && typeof block.arguments === 'object' ? block.arguments : {};\n356: \n357:       if (kind === 'shell') {\n358:         const command = firstString(args, SHELL_COMMAND_KEYS);\n359:         const redirected = command === null ? [] : redirectTargets(command);\n360:         if (redirected.length > 0) {\n361:           for (const path of redirected) addEvent(events, 'write', { path, command });\n362:           continue;\n363:         }\n364:         if (command !== null && APPLY_PATCH.test(command)) {\n365:           const patched = patchPaths(command);\n366:           for (const path of patched.length > 0 ? patched : [null]) {\n367:             addEvent(events, 'write', { path, command });\n368:           }\n369:           continue;\n370:         }\n371:         addEvent(events, 'shell', { command });\n372:         continue;\n373:       }\n374: \n375:       if (kind === 'read') {\n376:         addEvent(events, 'read', { path: firstString(args, PATH_KEYS) });\n377:         continue;\n378:       }\n379: \n380:       if (kind === 'skill') {\n381:         addEvent(events, 'skill', {\n382:           command: firstString(args, SKILL_NAME_KEYS) ?? block.name,\n383:           path: firstString(args, PATH_KEYS),\n384:         });\n385:         continue;\n386:       }\n387: \n388:       for (const path of writePaths(args)) addEvent(events, 'write', { path });\n389:     }\n390:   }\n391: \n392:   return events;\n393: }\n394: \n395: // ───────────────────────────────────────────────────────────────────\n396: // 6. COMMAND LINE FACTS\n397: // ───────────────────────────────────────────────────────────────────\n398: \n399: // The line a model prints about an offered command is the only evidence in the\n400: // transcript that it took the command, offered it or turned it down, so the\n401: // three state words are the whole vocabulary it may carry.\n402: //\n403: // The token is matched anywhere in a line because a model marks it up as a list\n404: // item, a bold run or a code span. It wraps the name and the state word in\n405: // whichever markup reads well there, so a backtick, a square bracket or both is\n406: // allowed on each side of each token and the pair is never required. The name\n407: // must open with a letter or digit so a reply that quotes the instruction's\n408: // `[/name]` placeholder is not read as a command the model reported.\n409: const COMMAND_LINE =\n410:   /\\bCOMMAND:[ \\t`\\[]*(\\/[A-Za-z0-9][\\w.:-]*)[ \\t`\\]]*(?:→|->)[ \\t`\\[]*(started|offered|declined)\\b/i;\n411: \n412: /**\n413:  * Collect the `COMMAND:` lines a model printed, in the order it printed them.\n414:  *\n415:  * One assistant text block can hold several lines, so every block is split and\n416:  * each line is tested on its own. A line that names a command twice still counts\n417:  * once, because the count exists to expose a command reported more than once and\n418:  * a per-line tally would hide exactly that.\n419:  *\n420:  * @param {Array<{seq: number, kind: string, text: string|null}>} events - Events\n421:  *   from `normalize`.\n422:  * @returns {Array<{seq: number, command: string, state: string, count: number}>}\n423:  *   One entry per matching line, where `count` is how many lines named that\n424:  *   command across the whole session.\n425:  */\n426: export function commandLines(events) {\n427:   const lines = [];\n428: \n429:   for (const event of events ?? []) {\n430:     if (!event || event.kind !== 'text' || typeof event.text !== 'string') continue;\n431: \n432:     for (const text of event.text.split('\\n')) {\n433:       const match = COMMAND_LINE.exec(text);\n434:       if (match === null) continue;\n435:       lines.push({ seq: event.seq, command: match[1], state: match[2].toLowerCase(), count: 0 });\n436:     }\n437:   }\n438: \n439:   const totals = new Map();\n440:   for (const line of lines) totals.set(line.command, (totals.get(line.command) ?? 0) + 1);\n441:   for (const line of lines) line.count = totals.get(line.command);\n442: \n443:   return lines;\n444: }\n445: \n446: /**\n447:  * Read whether a session's `COMMAND:` lines named the command a row expected.\n448:  *\n449:  * A model writes that line after it read the head, so the line is evidence the\n450:  * offer reached it even when the turn declined the command, which the run line's\n451:  * own offer field cannot show. The last matching line decides the state, because\n452:  * a later line is the model's final answer about the same command.\n453:  *\n454:  * @param {Array<{seq: number, kind: string, text: string|null}>} events - Events\n455:  *   from `normalize`.\n456:  * @param {string|null} expectedCommand - The row's expected command, with or\n457:  *   without its leading slash and its mode suffix.\n458:  * @returns {{offerSeen: boolean, commandState: string|null}} Whether at least one\n459:  *   line named the command, and the state of the last line that did.\n460:  */\n461: export function offerSeenIn(events, expectedCommand) {\n462:   const wanted = commandParts(expectedCommand);\n463:   if (wanted === null) return { offerSeen: false, commandState: null };\n464: \n465:   const seen = commandLines(events).filter((line) => namesCommand(line.command, wanted));\n466:   return {\n467:     offerSeen: seen.length > 0,\n468:     commandState: seen.length > 0 ? seen[seen.length - 1].state : null,\n469:   };\n470: }\n471: \n472: // ───────────────────────────────────────────────────────────────────\n473: // 7. FOLLOW ORDER\n474: // ───────────────────────────────────────────────────────────────────\n475: \n476: // A model writes the mode it chose onto the command, so the namespace and the\n477: // bare name are read before any document is named.\n478: const MODE_SUFFIX = /:(?:auto|confirm|autopilot|unattended)$/i;\n479: \n480: // A command is a namespace and a name, and a command outside a namespace is a\n481: // name alone. Deeper segments are kept with the name so an unfamiliar shape is\n482: // looked up under the name it actually shows rather than silently shortened.\n483: // A command can carry the target it acts on after its name, so the text before\n484: // the first space is the name its document is looked up under and the rest is\n485: // the route it was given. Without that split a routed command would look for a\n486: // document named after the whole phrase.\n487: function commandParts(command) {\n488:   const text = String(command ?? '').trim().replace(/^\\/+/, '');\n489:   const segments = text.replace(MODE_SUFFIX, '').split(':').map((part) => part.trim()).filter(Boolean);\n490:   if (segments.length === 0) return null;\n491:   const namespace = segments.length === 1 ? null : segments[0];\n492:   const whole = segments.length === 1 ? segments[0] : segments.slice(1).join(':');\n493:   const space = whole.search(/\\s/);\n494:   if (space === -1) return { namespace, name: whole };\n495:   return { namespace, name: whole.slice(0, space), route: whole.slice(space + 1).trim() };\n496: }\n497: \n498: // A runtime mirror keeps the command tree under its own root and some runtimes\n499: // join the namespace into the file name, so a tail is matched rather than a full\n500: // path that each runtime may root somewhere else.\n501: function tailMatches(value, tails) {\n502:   const path = String(value ?? '').trim().replace(/\\\\/g, '/').replace(/^\\.\\//, '');\n503:   if (!path) return false;\n504:   return tails.some((tail) => path.endsWith(tail) || path === tail.replace(/^\\//, ''));\n505: }\n506: \n507: // The document a command routes to sits at `<commands>/<namespace>/<name>.md`, and\n508: // a mirror that flattens the folder joins its two parts with a dash.\n509: function documentTails({ namespace, name }) {\n510:   if (namespace === null) return [`/commands/${name}.md`];\n511:   return [`/commands/${namespace}/${name}.md`, `/commands/${namespace}-${name}.md`];\n512: }\n513: \n514: // A confirm workflow sits beside the command's other assets and takes the command\n515: // name with a `-confirm` suffix, which is the file a confirming run loads before\n516: // its first write.\n517: function confirmTails({ namespace, name }) {\n518:   const base = namespace === null\n519:     ? `/commands/assets/${name}-confirm`\n520:     : `/commands/${namespace}/assets/${namespace}-${name}-confirm`;\n521:   return [`${base}.yaml`, `${base}.yml`];\n522: }\n523: \n524: // A skill load names the command directly instead of naming a file, so the name is\n525: // compared once the mode suffix has come off both sides.\n526: function namesCommand(value, wanted) {\n527:   const other = commandParts(value);\n528:   return other !== null && other.namespace === wanted.namespace && other.name === wanted.name;\n529: }\n530: \n531: function positionOf(event, index) {\n532:   return typeof event.seq === 'number' ? event.seq : index;\n533: }\n534: \n535: function firstWritePosition(events) {\n536:   for (let index = 0; index < events.length; index += 1) {\n537:     const event = events[index];\n538:     if (event && event.kind === 'write') return positionOf(event, index);\n539:   }\n540:   return null;\n[Output truncated. Continue reading with offset: 541]"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"limit\":540,\"path\":\".skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/score-command-transcripts.mjs\"}"},"time":{"start":1794570617299,"end":1794570617715}}}}
