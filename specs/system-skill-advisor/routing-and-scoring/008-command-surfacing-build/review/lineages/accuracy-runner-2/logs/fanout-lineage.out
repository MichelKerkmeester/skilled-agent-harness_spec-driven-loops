/352-command-surfacing-research/specs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/review/lineages/accuracy-runner-2/deep-review-findings-registry.json\",\n  \"dashboardPath\": \"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/specs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/review/lineages/accuracy-runner-2/deep-review-dashboard.md\",\n  \"strategyPath\": \"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/specs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/review/lineages/accuracy-runner-2/deep-review-strategy.md\",\n  \"openFindingsCount\": 1,\n  \"resolvedFindingsCount\": 0,\n  \"convergenceScore\": 0,\n  \"graphConvergenceScore\": 0,\n  \"searchDebtCount\": 0,\n  \"corruptionCount\": 0,\n  \"strategyWarning\": null,\n  \"resourceMapPath\": null,\n  \"resourceMapSkipped\": null,\n  \"resourceMapSkipReason\": null\n}\nEXIT:0\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"cd /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research\\nnode .skilled/skills/system-deep-loop/runtime/scripts/reduce-state.cjs specs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build --artifact-dir specs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/review/lineages/accuracy-runner-2 --create-missing-anchors 2>&1 | tail -25\\necho \\\"EXIT:$?\\\"\",\"timeout\":180000}"},"time":{"start":1794571383576,"end":1794571384734}}}}
