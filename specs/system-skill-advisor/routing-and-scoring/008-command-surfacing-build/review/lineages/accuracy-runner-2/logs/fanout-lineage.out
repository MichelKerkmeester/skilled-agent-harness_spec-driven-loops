{"type":"tool_use","timestamp":1794571791960,"sessionID":"ses_e2b4a2200ffebIrmmKNfkMdQAD","part":{"partID":"prt_1d4d06cbe001tlgtngQ5Mq5KKi","sessionID":"ses_e2b4a2200ffebIrmmKNfkMdQAD","messageID":"msg_1d4d05856001p7B2s0RagtUQnb","type":"tool","id":"call_3b8e53f626574489ba11f9cb","tool":"read","state":{"status":"completed","input":{"limit":200,"path":".skilled/skills/system-skill-advisor/runtime/tests/legacy/advisor-corpus-parity.vitest.ts"},"output":"Read file .skilled/skills/system-skill-advisor/runtime/tests/legacy/advisor-corpus-parity.vitest.ts, lines 1-198\n1: // ───────────────────────────────────────────────────────────────\n2: // MODULE: Advisor Corpus Parity Tests\n3: // ───────────────────────────────────────────────────────────────\n4: \n5: import { execFileSync } from 'node:child_process';\n6: import {\n7:   readFileSync,\n8: } from 'node:fs';\n9: import { join, resolve } from 'node:path';\n10: import { describe, expect, it } from 'vitest';\n11: import { scoreAdvisorPrompt } from '../../lib/scorer/fusion.js';\n12: import { findAdvisorWorkspaceRoot } from '../../lib/utils/workspace-root.js';\n13: \n14: interface CorpusRow {\n15:   readonly id: string;\n16:   readonly prompt: string;\n17:   readonly skill_top_1: string;\n18: }\n19: \n20: interface ParityRegression {\n21:   readonly id: string;\n22:   readonly prompt: string;\n23:   readonly expected_top_1: string | null;\n24:   readonly cli_top_1: string | null;\n25:   readonly hook_top_1: string | null;\n26: }\n27: \n28: // Reviewed-accepted top-1 divergence: a row the Python reference gets right but\n29: // the native scorer does not, ordered as it occurs in the corpus. What remains is\n30: // fusion-level or labeling-edge loss that single-lane explicit calibration does\n31: // not cleanly resolve. This list must stay identical to the one in\n32: // tests/parity/python-ts-parity.vitest.ts — both gates read the same corpus and\n33: // the same two scorers. Prune entries here as targeted cross-lane work resolves\n34: // them; rr-iter3-093, rr-iter3-145 and rr-iter3-146 each left the list that way.\n35: const ACCEPTED_PARITY_REGRESSION_IDS: string[] = [\n36:   // A documentation-consistency audit of packet docs: gold and the Python\n37:   // scorer say sk-code, the native scorer reads \"documented across packet\n38:   // docs\" as documentation work and routes sk-doc. Reviewed 2026-09-07 and\n39:   // accepted as a divergence, not a regression to fix; the ledger carries it.\n40:   'rr-iter2-020',\n41:   'rr-iter3-092',\n42:   'rr-iter3-097',\n43:   'rr-iter3-099',\n44:   // rr-hub6-204 and rr-hub6-207 left this list once the native scorer\n45:   // answered both Python-correctly again, so neither is a regression now.\n46:   // Re-add an id only after checking it against gold.\n47:   //\n48:   // rr-iter3-105 typed \"/memory:save\" outright and carries the save gold. The\n49:   // Python reference answers it; the native scorer gives the packet vocabulary\n50:   // enough weight to hand the row to system-spec-kit (0.625) ahead of the save\n51:   // command (0.56). Recorded as a divergence, not accepted as correct: a named\n52:   // command must outrank the hub that owns its topic.\n53:   'rr-iter3-105',\n54: ];\n55: \n56: const workspaceRoot = findAdvisorWorkspaceRoot(import.meta.dirname);\n57: const corpusPath = join(\n58:   workspaceRoot,\n59:   '.skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/labeled-prompts.jsonl',\n60: );\n61: function loadCorpus(): CorpusRow[] {\n62:   return readFileSync(corpusPath, 'utf8')\n63:     .trim()\n64:     .split('\\n')\n65:     .map((line) => JSON.parse(line) as CorpusRow);\n66: }\n67: \n68: function directPythonTopSkills(rows: readonly CorpusRow[]): Array<string | null> {\n69:   const script = `\n70: import importlib.util, json, os, sys\n71: workspace = sys.argv[1]\n72: path = os.path.join(workspace, '.skilled/skills/system-skill-advisor/runtime/scripts/skill_advisor.py')\n73: spec = importlib.util.spec_from_file_location('skill_advisor', path)\n74: mod = importlib.util.module_from_spec(spec)\n75: spec.loader.exec_module(mod)\n76: prompts = json.loads(sys.stdin.read())\n77: out = []\n78: for prompt in prompts:\n79:     recs = mod.analyze_prompt(prompt=prompt, confidence_threshold=0.8, uncertainty_threshold=0.35, confidence_only=False, show_rejections=False)\n80:     out.append(recs[0]['skill'] if recs else None)\n81: print(json.dumps(out))\n82: `;\n83:   const output = execFileSync('python3', ['-c', script, workspaceRoot], {\n84:     input: JSON.stringify(rows.map((row) => row.prompt)),\n85:     cwd: workspaceRoot,\n86:     env: {\n87:       ...process.env,\n88:       SKILL_ADVISOR_DISABLE_BUILTIN_SEMANTIC: '1',\n89:     },\n90:     encoding: 'utf8',\n91:     stdio: ['pipe', 'pipe', 'ignore'],\n92:     timeout: 120_000,\n93:   });\n94:   return JSON.parse(output) as Array<string | null>;\n95: }\n96: \n97: function goldSkill(row: CorpusRow): string | null {\n98:   return row.skill_top_1 === 'none' ? null : row.skill_top_1;\n99: }\n100: \n101: describe('advisor 195-prompt corpus regression-protection parity', () => {\n102:   it('preserves Python-correct top-1 decisions while allowing native improvements', async () => {\n103:     const previousSemantic = process.env.SKILL_ADVISOR_DISABLE_BUILTIN_SEMANTIC;\n104:     process.env.SKILL_ADVISOR_DISABLE_BUILTIN_SEMANTIC = '1';\n105:     // Private `local-*` skills linked in from outside the checkout are not part of\n106:     // the corpus regime the pinned counts were measured in.\n107:     const previousPrivateRoots = process.env.SPECKIT_PRIVATE_SKILL_ROOTS;\n108:     delete process.env.SPECKIT_PRIVATE_SKILL_ROOTS;\n109: \n110:     try {\n111:       const rows = loadCorpus();\n112:       // The current labeled corpus retains the seven hub-routing rows added\n113:       // for the mcp-tooling hub projection, so the authoritative size is 195.\n114:       expect(rows).toHaveLength(195);\n115:       const pythonTopSkills = directPythonTopSkills(rows);\n116:       expect(pythonTopSkills).toHaveLength(rows.length);\n117: \n118:       const regressions: ParityRegression[] = [];\n119:       let pythonCorrect = 0;\n120:       let hookPreservedPythonCorrect = 0;\n121:       let pythonGoldNoneFalseFire = 0;\n122:       let hookGoldNoneFalseFire = 0;\n123:       for (let index = 0; index < rows.length; index += 1) {\n124:         const row = rows[index];\n125:         const expected = goldSkill(row);\n126:         const cliTopSkill = pythonTopSkills[index] ?? null;\n127:         const hookTopSkill = scoreAdvisorPrompt(row.prompt, { workspaceRoot }).topSkill;\n128:         if (expected === null && cliTopSkill !== null) {\n129:           pythonGoldNoneFalseFire += 1;\n130:         }\n131:         if (expected === null && hookTopSkill !== null) {\n132:           hookGoldNoneFalseFire += 1;\n133:         }\n134:         if (cliTopSkill === expected) {\n135:           pythonCorrect += 1;\n136:           if (hookTopSkill === expected) {\n137:             hookPreservedPythonCorrect += 1;\n138:           } else {\n139:             regressions.push({\n140:               id: row.id,\n141:               prompt: row.prompt,\n142:               expected_top_1: expected,\n143:               cli_top_1: cliTopSkill,\n144:               hook_top_1: hookTopSkill,\n145:             });\n146:           }\n147:         }\n148:       }\n149: \n150:       // On the current 195-row corpus the Python reference scorer (built-in\n151:       // semantic disabled for determinism) makes 117 gold-correct top-1 calls;\n152:       // the native/hook scorer preserves 112 of them (re-baselined 2026-09-07\n153:       // after the deep-loop and design consolidations moved both numbers up). The remaining\n154:       // Python-correct rows the native scorer diverges on are enumerated and\n155:       // reviewed-accepted above.\n156:       //\n157:       // Both numbers measure the reference, not a target: they move with the\n158:       // labeled corpus, the Python scoring tables, and the compiled skill graph,\n159:       // and the graph is a locally built artifact that can shift them with no\n160:       // diff to show for it. Re-baseline only after checking the move is an\n161:       // improvement — a pythonCorrect drop, or an id appearing in the regression\n162:       // list that is not accepted above, is a regression to fix, not to record.\n163:       // 112 -> 113 and 108 -> 109: the sk-code description now names its\n164:       // languages (TypeScript, Python, shell, JSON), which restores a JSON-edit\n165:       // prompt the shorter wording lost, and the native scorer keeps it too.\n166:       // The accepted regression list is unchanged.\n167:       // 113 -> 114 and 109 -> 110: the sk-prompt description no longer claims\n168:       // scoring, so a duplicated-intent scoring prompt reaches its sk-code gold\n169:       // in the Python reference, and the native scorer keeps it. The accepted\n170:       // regression list was unchanged at that step.\n171:       // 114 -> 116 and 110 -> 111: the retired command bridges collapsed into one\n172:       // save id and one prompt-improve id, and a typed /speckit:plan or\n173:       // /speckit:resume now resolves to its own command id instead of an umbrella.\n174:       // Seventeen gold labels moved to the surviving names and the Python\n175:       // reference follows them, so it answers two more prompts correctly and the\n176:       // native scorer keeps one of them; rr-iter3-105 is the row it loses.\n177:       // The Python fallback now also answers rr-iter3-076 correctly.\n178:       expect(pythonCorrect).toBe(117);\n179:       expect(hookPreservedPythonCorrect).toBe(112);\n180:       expect(hookGoldNoneFalseFire).toBeLessThanOrEqual(pythonGoldNoneFalseFire);\n181:       expect(\n182:         regressions.map((regression) => regression.id),\n183:         JSON.stringify(regressions.slice(0, 10), null, 2),\n184:       ).toEqual(ACCEPTED_PARITY_REGRESSION_IDS);\n185:     } finally {\n186:       if (previousSemantic === undefined) {\n187:         delete process.env.SKILL_ADVISOR_DISABLE_BUILTIN_SEMANTIC;\n188:       } else {\n189:         process.env.SKILL_ADVISOR_DISABLE_BUILTIN_SEMANTIC = previousSemantic;\n190:       }\n191:       if (previousPrivateRoots === undefined) {\n192:         delete process.env.SPECKIT_PRIVATE_SKILL_ROOTS;\n193:       } else {\n194:         process.env.SPECKIT_PRIVATE_SKILL_ROOTS = previousPrivateRoots;\n195:       }\n196:     }\n197:   }, 240_000);\n198: });","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file .skilled/skills/system-skill-advisor/runtime/tests/legacy/advisor-corpus-parity.vitest.ts, lines 1-198\n1: // ───────────────────────────────────────────────────────────────\n2: // MODULE: Advisor Corpus Parity Tests\n3: // ───────────────────────────────────────────────────────────────\n4: \n5: import { execFileSync } from 'node:child_process';\n6: import {\n7:   readFileSync,\n8: } from 'node:fs';\n9: import { join, resolve } from 'node:path';\n10: import { describe, expect, it } from 'vitest';\n11: import { scoreAdvisorPrompt } from '../../lib/scorer/fusion.js';\n12: import { findAdvisorWorkspaceRoot } from '../../lib/utils/workspace-root.js';\n13: \n14: interface CorpusRow {\n15:   readonly id: string;\n16:   readonly prompt: string;\n17:   readonly skill_top_1: string;\n18: }\n19: \n20: interface ParityRegression {\n21:   readonly id: string;\n22:   readonly prompt: string;\n23:   readonly expected_top_1: string | null;\n24:   readonly cli_top_1: string | null;\n25:   readonly hook_top_1: string | null;\n26: }\n27: \n28: // Reviewed-accepted top-1 divergence: a row the Python reference gets right but\n29: // the native scorer does not, ordered as it occurs in the corpus. What remains is\n30: // fusion-level or labeling-edge loss that single-lane explicit calibration does\n31: // not cleanly resolve. This list must stay identical to the one in\n32: // tests/parity/python-ts-parity.vitest.ts — both gates read the same corpus and\n33: // the same two scorers. Prune entries here as targeted cross-lane work resolves\n34: // them; rr-iter3-093, rr-iter3-145 and rr-iter3-146 each left the list that way.\n35: const ACCEPTED_PARITY_REGRESSION_IDS: string[] = [\n36:   // A documentation-consistency audit of packet docs: gold and the Python\n37:   // scorer say sk-code, the native scorer reads \"documented across packet\n38:   // docs\" as documentation work and routes sk-doc. Reviewed 2026-09-07 and\n39:   // accepted as a divergence, not a regression to fix; the ledger carries it.\n40:   'rr-iter2-020',\n41:   'rr-iter3-092',\n42:   'rr-iter3-097',\n43:   'rr-iter3-099',\n44:   // rr-hub6-204 and rr-hub6-207 left this list once the native scorer\n45:   // answered both Python-correctly again, so neither is a regression now.\n46:   // Re-add an id only after checking it against gold.\n47:   //\n48:   // rr-iter3-105 typed \"/memory:save\" outright and carries the save gold. The\n49:   // Python reference answers it; the native scorer gives the packet vocabulary\n50:   // enough weight to hand the row to system-spec-kit (0.625) ahead of the save\n51:   // command (0.56). Recorded as a divergence, not accepted as correct: a named\n52:   // command must outrank the hub that owns its topic.\n53:   'rr-iter3-105',\n54: ];\n55: \n56: const workspaceRoot = findAdvisorWorkspaceRoot(import.meta.dirname);\n57: const corpusPath = join(\n58:   workspaceRoot,\n59:   '.skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/labeled-prompts.jsonl',\n60: );\n61: function loadCorpus(): CorpusRow[] {\n62:   return readFileSync(corpusPath, 'utf8')\n63:     .trim()\n64:     .split('\\n')\n65:     .map((line) => JSON.parse(line) as CorpusRow);\n66: }\n67: \n68: function directPythonTopSkills(rows: readonly CorpusRow[]): Array<string | null> {\n69:   const script = `\n70: import importlib.util, json, os, sys\n71: workspace = sys.argv[1]\n72: path = os.path.join(workspace, '.skilled/skills/system-skill-advisor/runtime/scripts/skill_advisor.py')\n73: spec = importlib.util.spec_from_file_location('skill_advisor', path)\n74: mod = importlib.util.module_from_spec(spec)\n75: spec.loader.exec_module(mod)\n76: prompts = json.loads(sys.stdin.read())\n77: out = []\n78: for prompt in prompts:\n79:     recs = mod.analyze_prompt(prompt=prompt, confidence_threshold=0.8, uncertainty_threshold=0.35, confidence_only=False, show_rejections=False)\n80:     out.append(recs[0]['skill'] if recs else None)\n81: print(json.dumps(out))\n82: `;\n83:   const output = execFileSync('python3', ['-c', script, workspaceRoot], {\n84:     input: JSON.stringify(rows.map((row) => row.prompt)),\n85:     cwd: workspaceRoot,\n86:     env: {\n87:       ...process.env,\n88:       SKILL_ADVISOR_DISABLE_BUILTIN_SEMANTIC: '1',\n89:     },\n90:     encoding: 'utf8',\n91:     stdio: ['pipe', 'pipe', 'ignore'],\n92:     timeout: 120_000,\n93:   });\n94:   return JSON.parse(output) as Array<string | null>;\n95: }\n96: \n97: function goldSkill(row: CorpusRow): string | null {\n98:   return row.skill_top_1 === 'none' ? null : row.skill_top_1;\n99: }\n100: \n101: describe('advisor 195-prompt corpus regression-protection parity', () => {\n102:   it('preserves Python-correct top-1 decisions while allowing native improvements', async () => {\n103:     const previousSemantic = process.env.SKILL_ADVISOR_DISABLE_BUILTIN_SEMANTIC;\n104:     process.env.SKILL_ADVISOR_DISABLE_BUILTIN_SEMANTIC = '1';\n105:     // Private `local-*` skills linked in from outside the checkout are not part of\n106:     // the corpus regime the pinned counts were measured in.\n107:     const previousPrivateRoots = process.env.SPECKIT_PRIVATE_SKILL_ROOTS;\n108:     delete process.env.SPECKIT_PRIVATE_SKILL_ROOTS;\n109: \n110:     try {\n111:       const rows = loadCorpus();\n112:       // The current labeled corpus retains the seven hub-routing rows added\n113:       // for the mcp-tooling hub projection, so the authoritative size is 195.\n114:       expect(rows).toHaveLength(195);\n115:       const pythonTopSkills = directPythonTopSkills(rows);\n116:       expect(pythonTopSkills).toHaveLength(rows.length);\n117: \n118:       const regressions: ParityRegression[] = [];\n119:       let pythonCorrect = 0;\n120:       let hookPreservedPythonCorrect = 0;\n121:       let pythonGoldNoneFalseFire = 0;\n122:       let hookGoldNoneFalseFire = 0;\n123:       for (let index = 0; index < rows.length; index += 1) {\n124:         const row = rows[index];\n125:         const expected = goldSkill(row);\n126:         const cliTopSkill = pythonTopSkills[index] ?? null;\n127:         const hookTopSkill = scoreAdvisorPrompt(row.prompt, { workspaceRoot }).topSkill;\n128:         if (expected === null && cliTopSkill !== null) {\n129:           pythonGoldNoneFalseFire += 1;\n130:         }\n131:         if (expected === null && hookTopSkill !== null) {\n132:           hookGoldNoneFalseFire += 1;\n133:         }\n134:         if (cliTopSkill === expected) {\n135:           pythonCorrect += 1;\n136:           if (hookTopSkill === expected) {\n137:             hookPreservedPythonCorrect += 1;\n138:           } else {\n139:             regressions.push({\n140:               id: row.id,\n141:               prompt: row.prompt,\n142:               expected_top_1: expected,\n143:               cli_top_1: cliTopSkill,\n144:               hook_top_1: hookTopSkill,\n145:             });\n146:           }\n147:         }\n148:       }\n149: \n150:       // On the current 195-row corpus the Python reference scorer (built-in\n151:       // semantic disabled for determinism) makes 117 gold-correct top-1 calls;\n152:       // the native/hook scorer preserves 112 of them (re-baselined 2026-09-07\n153:       // after the deep-loop and design consolidations moved both numbers up). The remaining\n154:       // Python-correct rows the native scorer diverges on are enumerated and\n155:       // reviewed-accepted above.\n156:       //\n157:       // Both numbers measure the reference, not a target: they move with the\n158:       // labeled corpus, the Python scoring tables, and the compiled skill graph,\n159:       // and the graph is a locally built artifact that can shift them with no\n160:       // diff to show for it. Re-baseline only after checking the move is an\n161:       // improvement — a pythonCorrect drop, or an id appearing in the regression\n162:       // list that is not accepted above, is a regression to fix, not to record.\n163:       // 112 -> 113 and 108 -> 109: the sk-code description now names its\n164:       // languages (TypeScript, Python, shell, JSON), which restores a JSON-edit\n165:       // prompt the shorter wording lost, and the native scorer keeps it too.\n166:       // The accepted regression list is unchanged.\n167:       // 113 -> 114 and 109 -> 110: the sk-prompt description no longer claims\n168:       // scoring, so a duplicated-intent scoring prompt reaches its sk-code gold\n169:       // in the Python reference, and the native scorer keeps it. The accepted\n170:       // regression list was unchanged at that step.\n171:       // 114 -> 116 and 110 -> 111: the retired command bridges collapsed into one\n172:       // save id and one prompt-improve id, and a typed /speckit:plan or\n173:       // /speckit:resume now resolves to its own command id instead of an umbrella.\n174:       // Seventeen gold labels moved to the surviving names and the Python\n175:       // reference follows them, so it answers two more prompts correctly and the\n176:       // native scorer keeps one of them; rr-iter3-105 is the row it loses.\n177:       // The Python fallback now also answers rr-iter3-076 correctly.\n178:       expect(pythonCorrect).toBe(117);\n179:       expect(hookPreservedPythonCorrect).toBe(112);\n180:       expect(hookGoldNoneFalseFire).toBeLessThanOrEqual(pythonGoldNoneFalseFire);\n181:       expect(\n182:         regressions.map((regression) => regression.id),\n183:         JSON.stringify(regressions.slice(0, 10), null, 2),\n184:       ).toEqual(ACCEPTED_PARITY_REGRESSION_IDS);\n185:     } finally {\n186:       if (previousSemantic === undefined) {\n187:         delete process.env.SKILL_ADVISOR_DISABLE_BUILTIN_SEMANTIC;\n188:       } else {\n189:         process.env.SKILL_ADVISOR_DISABLE_BUILTIN_SEMANTIC = previousSemantic;\n190:       }\n191:       if (previousPrivateRoots === undefined) {\n192:         delete process.env.SPECKIT_PRIVATE_SKILL_ROOTS;\n193:       } else {\n194:         process.env.SPECKIT_PRIVATE_SKILL_ROOTS = previousPrivateRoots;\n195:       }\n196:     }\n197:   }, 240_000);\n198: });"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"limit\":200,\"path\":\".skilled/skills/system-skill-advisor/runtime/tests/legacy/advisor-corpus-parity.vitest.ts\"}"},"time":{"start":1794571791550,"end":1794571791960}}}}
