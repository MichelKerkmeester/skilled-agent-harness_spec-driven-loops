_top,expected_second,wave\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"cd /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy\\nnode -e 'const fs=require(\\\"fs\\\");for(const f of [\\\"labeled-prompts.jsonl\\\",\\\"holdout-prompts.jsonl\\\",\\\"ambiguity-prompts.jsonl\\\",\\\"doctor-prompts.jsonl\\\"]){const rows=fs.readFileSync(f,\\\"utf8\\\").trim().split(\\\"\\\\n\\\").map(JSON.parse);const ids=new Set();let dup=0;for(const r of rows){if(ids.has(r.id))dup++;ids.add(r.id)}console.log(f,\\\"rows\\\",rows.length,\\\"unique\\\",ids.size,\\\"dups\\\",dup,\\\"keys\\\",Object.keys(rows[0]).join(\\\",\\\"))}'\"}"},"time":{"start":1794571803548,"end":1794571804980}}}}
