{"type":"tool_use","timestamp":1794571050303,"sessionID":"ses_e2b4a2200ffebIrmmKNfkMdQAD","part":{"partID":"prt_1d4c51b2c001bc4FF4lie5oxr2","sessionID":"ses_e2b4a2200ffebIrmmKNfkMdQAD","messageID":"msg_1d4c50468001x2iP8eAoGwCDAc","type":"tool","id":"call_739e44b1d4b846e1b26db9ed","tool":"read","state":{"status":"completed","input":{"limit":200,"offset":1,"path":".skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/capture-command-routing-baseline.mjs"},"output":"Read file .skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/capture-command-routing-baseline.mjs, lines 1-200\n1: // ───────────────────────────────────────────────────────────────────\n2: // MODULE: COMMAND ROUTING BASELINE CAPTURE\n3: // ───────────────────────────────────────────────────────────────────\n4: //\n5: // Captures how the built scorer routes the command-prompt corpus under the\n6: // reproducible filesystem projection (empty SYSTEM_SKILL_ADVISOR_DB_DIR →\n7: // SQLite loader returns null → projection built purely from committed graph\n8: // metadata). It answers the questions command surfacing has to hold to: a\n9: // prompt that names a slash command reaches that command's bridge, a prompt\n10: // that must stay quiet offers no command at all, a partial slash mention is\n11: // not routed as if it were complete, and a bridge ranked below the top skill\n12: // is owned by that skill.\n13: //\n14: // It also measures what the compiled route adds on top of that: a hub can name\n15: // the slash command its own routing would take, which reaches a reader who never\n16: // types a slash command. That reach is reported under its own key so every\n17: // existing number keeps the value and the comparability it had before.\n18: //\n19: // The result is the ratchet baseline: the gate re-scores live under the same\n20: // environment and holds every count to it, so any scoring or bridge-metadata\n21: // change that moves a number forces a conscious re-capture rather than\n22: // drifting silently. `corpusSha256` pins the baseline to the exact corpus it\n23: // was captured against, so a corpus edit changes the hash and forces\n24: // re-baselining.\n25: //\n26: // The same corpus can also be scored against the operator's own skill graph and\n27: // embedder under `--real-embedding`, which is a live probe of this machine rather\n28: // than a reproducible projection. Its numbers describe an environment, so it never\n29: // writes the baseline and never runs under the fixture regime the ratchet replays.\n30: //\n31: // Setup runs on call, never on import: the environment projection, the clock\n32: // pin and the scorer import all live inside scoreCommandCorpus(), so a harness\n33: // may import this module and score in-process without inheriting either.\n34: //\n35: // Usage:\n36: //   node capture-command-routing-baseline.mjs            # print JSON to stdout\n37: //   node capture-command-routing-baseline.mjs --write    # also write the baseline\n38: //   node capture-command-routing-baseline.mjs --real-embedding   # score live vectors\n39: \n40: // ───────────────────────────────────────────────────────────────────\n41: // 1. IMPORTS\n42: // ───────────────────────────────────────────────────────────────────\n43: \n44: import { execFileSync, spawnSync } from 'node:child_process';\n45: import { createHash } from 'node:crypto';\n46: import { existsSync, mkdtempSync, readdirSync, readFileSync, rmSync, writeFileSync } from 'node:fs';\n47: import { createRequire } from 'node:module';\n48: import { tmpdir } from 'node:os';\n49: import { dirname, join, resolve } from 'node:path';\n50: import { fileURLToPath, pathToFileURL } from 'node:url';\n51: import { rejectUnknownOptions } from './reject-unknown-options.mjs';\n52: \n53: // ───────────────────────────────────────────────────────────────────\n54: // 2. CONSTANTS\n55: // ───────────────────────────────────────────────────────────────────\n56: \n57: const HERE = dirname(fileURLToPath(import.meta.url));\n58: const CORPUS_JSONL = resolve(HERE, 'command-prompts.jsonl');\n59: const BRIDGES_JSON = resolve(HERE, '../command-bridges/command-bridges.generated.json');\n60: const SCORER_EVAL_BASELINE_JSON = resolve(HERE, 'scorer-eval-baseline.json');\n61: const OUTPUT_JSON = resolve(HERE, 'command-routing-baseline.json');\n62: const DIST = resolve(HERE, '../../dist/runtime');\n63: const FUSION_MODULE = resolve(DIST, 'lib/scorer/fusion.js');\n64: const WORKSPACE_ROOT_MODULE = resolve(DIST, 'lib/utils/workspace-root.js');\n65: const COMMAND_ATTACH_MODULE = resolve(DIST, 'lib/command-attach.js');\n66: const PROMPT_POLICY_MODULE = resolve(DIST, 'lib/prompt-policy.js');\n67: const COMPILED_ROUTING_FLAG_MODULE = resolve(DIST, 'lib/compiled-routing-flag.js');\n68: const SEMANTIC_SHADOW_MODULE = resolve(DIST, 'lib/scorer/lanes/semantic-shadow.js');\n69: const SKILL_GRAPH_DB_MODULE = resolve(DIST, 'lib/skill-graph/skill-graph-db.js');\n70: const DIST_FRESHNESS_MODULE = resolve(HERE, '../../../../system-spec-kit/runtime/cli/lib/dist-freshness.cjs');\n71: \n72: const SENTINEL = '.skilled/skills/system-spec-kit/SKILL.md';\n73: const COMMANDS_DIR = '.skilled/commands';\n74: // Only the folder-level README is a document; a lowercase `readme.md` shipped\n75: // beside the commands is itself a command, so the skip is case-sensitive.\n76: const COMMAND_DOC_SKIP = 'README.md';\n77: const COMMAND_DOC_SUFFIX = '.md';\n78: // The compiled route is asked for through the public front door a hub's SKILL.md\n79: // calls, so this measures the decision the runtime actually serves rather than a\n80: // second derivation of it that could disagree with the first.\n81: const COMPILED_ROUTE_CLI = '.skilled/bin/compiled-route.cjs';\n82: const COMPILED_ROUTE_TIMEOUT_MS = 5000;\n83: \n84: // A real capture talks to the same embedder the recommend path does, so the probe\n85: // asks that daemon directly and names the model family the routing vectors come\n86: // from. The command vectors sit beside the skill vectors in the skill graph, in a\n87: // table whose name carries the embedder dimension.\n88: const EMBEDDER_TAGS_URL = 'http://localhost:11434/api/tags';\n89: const EMBEDDER_MODEL_PREFIX = 'nomic-embed-text';\n90: const EMBEDDER_PROBE_TIMEOUT_MS = 5000;\n91: const COMMAND_VECTOR_TABLE_PREFIX = 'vec_cmd_';\n92: \n93: // ───────────────────────────────────────────────────────────────────\n94: // 3. RUNTIME SETUP\n95: // ───────────────────────────────────────────────────────────────────\n96: //\n97: // Only the value lookups live here; the mutations themselves are deferred into\n98: // scoreCommandCorpus() so importing this module has no side effects.\n99: \n100: function isCalendarDate(value) {\n101:   if (!/^\\d{4}-\\d{2}-\\d{2}$/.test(value)) return false;\n102:   const parsed = new Date(`${value}T00:00:00Z`);\n103:   return !Number.isNaN(parsed.getTime()) && parsed.toISOString().slice(0, 10) === value;\n104: }\n105: \n106: // The derived lane halves each skill's score every 90 days of age, measured\n107: // from its derived.generated_at to the scoring clock (floored at 0.1), so\n108: // scores move with the calendar. The scoring date is therefore inherited from\n109: // the scorer-eval baseline and pinned, never read from the wall clock: a\n110: // recapture on any day replays the recorded date and reproduces the same\n111: // numbers, which keeps the two baselines directly comparable.\n112: function readPinnedScoringDate() {\n113:   let recorded;\n114:   try {\n115:     recorded = JSON.parse(readFileSync(SCORER_EVAL_BASELINE_JSON, 'utf8')).capturedAt;\n116:   } catch {\n117:     recorded = undefined;\n118:   }\n119:   if (typeof recorded !== 'string' || !isCalendarDate(recorded)) {\n120:     throw new Error(`scorer-eval baseline has no pinned scoring date (capturedAt): ${SCORER_EVAL_BASELINE_JSON}`);\n121:   }\n122:   return recorded;\n123: }\n124: \n125: // ───────────────────────────────────────────────────────────────────\n126: // 4. REAL EMBEDDING PREFLIGHT\n127: // ───────────────────────────────────────────────────────────────────\n128: //\n129: // A real capture scores whatever this machine's cosine lane can see, so both\n130: // halves of that lane are proved before a single row is scored: an embedder that\n131: // answers and a populated command vector table. Each half is named as itself when\n132: // it is missing, because a silent cosine lane reads exactly like a scoring change.\n133: \n134: async function assertEmbedderAnswers() {\n135:   const listed = [];\n136:   try {\n137:     const response = await fetch(EMBEDDER_TAGS_URL, { signal: AbortSignal.timeout(EMBEDDER_PROBE_TIMEOUT_MS) });\n138:     if (!response.ok) throw new Error(`HTTP ${response.status}`);\n139:     const payload = await response.json();\n140:     for (const model of Array.isArray(payload?.models) ? payload.models : []) {\n141:       if (typeof model?.name === 'string') listed.push(model.name);\n142:     }\n143:   } catch (error) {\n144:     const message = error instanceof Error ? error.message : String(error);\n145:     throw new Error(`real embedding needs a live embedder: GET ${EMBEDDER_TAGS_URL} failed (${message})`);\n146:   }\n147:   // The stored vectors were built with this model family, so a daemon serving some\n148:   // other model cannot answer them no matter how well the dimensions line up.\n149:   if (!listed.some((name) => name.startsWith(EMBEDDER_MODEL_PREFIX))) {\n150:     throw new Error(`real embedding needs an embedder serving ${EMBEDDER_MODEL_PREFIX}*: GET ${EMBEDDER_TAGS_URL} lists ${listed.length > 0 ? listed.join(', ') : 'no models'}`);\n151:   }\n152: }\n153: \n154: function assertCommandVectorsPresent(database, databasePath) {\n155:   if (!database) {\n156:     throw new Error(`real embedding needs command vectors: the skill graph database is absent (${databasePath})`);\n157:   }\n158:   // GLOB keeps the trailing underscore of the prefix literal, so the match is the\n159:   // `vec_cmd_<dim>` family alone rather than any name shaped like it.\n160:   const tables = database\n161:     .prepare(\"SELECT name FROM sqlite_master WHERE type = 'table' AND name GLOB ?\")\n162:     .all(`${COMMAND_VECTOR_TABLE_PREFIX}*`)\n163:     .map((table) => table.name);\n164:   if (tables.length === 0) {\n165:     throw new Error(`real embedding needs command vectors: no ${COMMAND_VECTOR_TABLE_PREFIX}* table in ${databasePath}`);\n166:   }\n167:   const populated = tables.filter((name) => database.prepare(`SELECT COUNT(*) AS rowCount FROM \"${name}\"`).get().rowCount > 0);\n168:   if (populated.length === 0) {\n169:     throw new Error(`real embedding needs command vectors: ${tables.join(', ')} has no rows in ${databasePath}`);\n170:   }\n171: }\n172: \n173: // The wrapper, the embedder and the command vectors are resolved together because\n174: // a real capture needs all three or it measures nothing worth reporting.\n175: async function prepareRealEmbeddingScoring() {\n176:   if (!existsSync(SEMANTIC_SHADOW_MODULE)) {\n177:     throw new Error(`built semantic-shadow file missing: ${SEMANTIC_SHADOW_MODULE}`);\n178:   }\n179:   const { withSemanticShadowPromptEmbedding } = await import(pathToFileURL(SEMANTIC_SHADOW_MODULE).href);\n180:   const { getDbReadOnly, getSkillGraphDbPath } = await import(pathToFileURL(SKILL_GRAPH_DB_MODULE).href);\n181:   await assertEmbedderAnswers();\n182:   assertCommandVectorsPresent(getDbReadOnly(), getSkillGraphDbPath());\n183:   return withSemanticShadowPromptEmbedding;\n184: }\n185: \n186: // ───────────────────────────────────────────────────────────────────\n187: // 5. HELPERS\n188: // ───────────────────────────────────────────────────────────────────\n189: \n190: function sha256File(path) {\n191:   return `sha256:${createHash('sha256').update(readFileSync(path)).digest('hex')}`;\n192: }\n193: \n194: // Line numbers are reported as the physical line a bad row sits on, so a\n195: // parse failure points at the line to repair rather than at a row ordinal.\n196: function readCorpus(path) {\n197:   if (!existsSync(path)) throw new Error(`corpus file missing: ${path}`);\n198:   const lines = readFileSync(path, 'utf8').split('\\n');\n199:   const rows = [];\n200:   for (let index = 0; index < lines.length; index += 1) {\n[Output truncated. Continue reading with offset: 201]","title":"read","metadata":{"metadata":{"truncated":true},"content":[{"type":"text","text":"Read file .skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/capture-command-routing-baseline.mjs, lines 1-200\n1: // ───────────────────────────────────────────────────────────────────\n2: // MODULE: COMMAND ROUTING BASELINE CAPTURE\n3: // ───────────────────────────────────────────────────────────────────\n4: //\n5: // Captures how the built scorer routes the command-prompt corpus under the\n6: // reproducible filesystem projection (empty SYSTEM_SKILL_ADVISOR_DB_DIR →\n7: // SQLite loader returns null → projection built purely from committed graph\n8: // metadata). It answers the questions command surfacing has to hold to: a\n9: // prompt that names a slash command reaches that command's bridge, a prompt\n10: // that must stay quiet offers no command at all, a partial slash mention is\n11: // not routed as if it were complete, and a bridge ranked below the top skill\n12: // is owned by that skill.\n13: //\n14: // It also measures what the compiled route adds on top of that: a hub can name\n15: // the slash command its own routing would take, which reaches a reader who never\n16: // types a slash command. That reach is reported under its own key so every\n17: // existing number keeps the value and the comparability it had before.\n18: //\n19: // The result is the ratchet baseline: the gate re-scores live under the same\n20: // environment and holds every count to it, so any scoring or bridge-metadata\n21: // change that moves a number forces a conscious re-capture rather than\n22: // drifting silently. `corpusSha256` pins the baseline to the exact corpus it\n23: // was captured against, so a corpus edit changes the hash and forces\n24: // re-baselining.\n25: //\n26: // The same corpus can also be scored against the operator's own skill graph and\n27: // embedder under `--real-embedding`, which is a live probe of this machine rather\n28: // than a reproducible projection. Its numbers describe an environment, so it never\n29: // writes the baseline and never runs under the fixture regime the ratchet replays.\n30: //\n31: // Setup runs on call, never on import: the environment projection, the clock\n32: // pin and the scorer import all live inside scoreCommandCorpus(), so a harness\n33: // may import this module and score in-process without inheriting either.\n34: //\n35: // Usage:\n36: //   node capture-command-routing-baseline.mjs            # print JSON to stdout\n37: //   node capture-command-routing-baseline.mjs --write    # also write the baseline\n38: //   node capture-command-routing-baseline.mjs --real-embedding   # score live vectors\n39: \n40: // ───────────────────────────────────────────────────────────────────\n41: // 1. IMPORTS\n42: // ───────────────────────────────────────────────────────────────────\n43: \n44: import { execFileSync, spawnSync } from 'node:child_process';\n45: import { createHash } from 'node:crypto';\n46: import { existsSync, mkdtempSync, readdirSync, readFileSync, rmSync, writeFileSync } from 'node:fs';\n47: import { createRequire } from 'node:module';\n48: import { tmpdir } from 'node:os';\n49: import { dirname, join, resolve } from 'node:path';\n50: import { fileURLToPath, pathToFileURL } from 'node:url';\n51: import { rejectUnknownOptions } from './reject-unknown-options.mjs';\n52: \n53: // ───────────────────────────────────────────────────────────────────\n54: // 2. CONSTANTS\n55: // ───────────────────────────────────────────────────────────────────\n56: \n57: const HERE = dirname(fileURLToPath(import.meta.url));\n58: const CORPUS_JSONL = resolve(HERE, 'command-prompts.jsonl');\n59: const BRIDGES_JSON = resolve(HERE, '../command-bridges/command-bridges.generated.json');\n60: const SCORER_EVAL_BASELINE_JSON = resolve(HERE, 'scorer-eval-baseline.json');\n61: const OUTPUT_JSON = resolve(HERE, 'command-routing-baseline.json');\n62: const DIST = resolve(HERE, '../../dist/runtime');\n63: const FUSION_MODULE = resolve(DIST, 'lib/scorer/fusion.js');\n64: const WORKSPACE_ROOT_MODULE = resolve(DIST, 'lib/utils/workspace-root.js');\n65: const COMMAND_ATTACH_MODULE = resolve(DIST, 'lib/command-attach.js');\n66: const PROMPT_POLICY_MODULE = resolve(DIST, 'lib/prompt-policy.js');\n67: const COMPILED_ROUTING_FLAG_MODULE = resolve(DIST, 'lib/compiled-routing-flag.js');\n68: const SEMANTIC_SHADOW_MODULE = resolve(DIST, 'lib/scorer/lanes/semantic-shadow.js');\n69: const SKILL_GRAPH_DB_MODULE = resolve(DIST, 'lib/skill-graph/skill-graph-db.js');\n70: const DIST_FRESHNESS_MODULE = resolve(HERE, '../../../../system-spec-kit/runtime/cli/lib/dist-freshness.cjs');\n71: \n72: const SENTINEL = '.skilled/skills/system-spec-kit/SKILL.md';\n73: const COMMANDS_DIR = '.skilled/commands';\n74: // Only the folder-level README is a document; a lowercase `readme.md` shipped\n75: // beside the commands is itself a command, so the skip is case-sensitive.\n76: const COMMAND_DOC_SKIP = 'README.md';\n77: const COMMAND_DOC_SUFFIX = '.md';\n78: // The compiled route is asked for through the public front door a hub's SKILL.md\n79: // calls, so this measures the decision the runtime actually serves rather than a\n80: // second derivation of it that could disagree with the first.\n81: const COMPILED_ROUTE_CLI = '.skilled/bin/compiled-route.cjs';\n82: const COMPILED_ROUTE_TIMEOUT_MS = 5000;\n83: \n84: // A real capture talks to the same embedder the recommend path does, so the probe\n85: // asks that daemon directly and names the model family the routing vectors come\n86: // from. The command vectors sit beside the skill vectors in the skill graph, in a\n87: // table whose name carries the embedder dimension.\n88: const EMBEDDER_TAGS_URL = 'http://localhost:11434/api/tags';\n89: const EMBEDDER_MODEL_PREFIX = 'nomic-embed-text';\n90: const EMBEDDER_PROBE_TIMEOUT_MS = 5000;\n91: const COMMAND_VECTOR_TABLE_PREFIX = 'vec_cmd_';\n92: \n93: // ───────────────────────────────────────────────────────────────────\n94: // 3. RUNTIME SETUP\n95: // ───────────────────────────────────────────────────────────────────\n96: //\n97: // Only the value lookups live here; the mutations themselves are deferred into\n98: // scoreCommandCorpus() so importing this module has no side effects.\n99: \n100: function isCalendarDate(value) {\n101:   if (!/^\\d{4}-\\d{2}-\\d{2}$/.test(value)) return false;\n102:   const parsed = new Date(`${value}T00:00:00Z`);\n103:   return !Number.isNaN(parsed.getTime()) && parsed.toISOString().slice(0, 10) === value;\n104: }\n105: \n106: // The derived lane halves each skill's score every 90 days of age, measured\n107: // from its derived.generated_at to the scoring clock (floored at 0.1), so\n108: // scores move with the calendar. The scoring date is therefore inherited from\n109: // the scorer-eval baseline and pinned, never read from the wall clock: a\n110: // recapture on any day replays the recorded date and reproduces the same\n111: // numbers, which keeps the two baselines directly comparable.\n112: function readPinnedScoringDate() {\n113:   let recorded;\n114:   try {\n115:     recorded = JSON.parse(readFileSync(SCORER_EVAL_BASELINE_JSON, 'utf8')).capturedAt;\n116:   } catch {\n117:     recorded = undefined;\n118:   }\n119:   if (typeof recorded !== 'string' || !isCalendarDate(recorded)) {\n120:     throw new Error(`scorer-eval baseline has no pinned scoring date (capturedAt): ${SCORER_EVAL_BASELINE_JSON}`);\n121:   }\n122:   return recorded;\n123: }\n124: \n125: // ───────────────────────────────────────────────────────────────────\n126: // 4. REAL EMBEDDING PREFLIGHT\n127: // ─────────────────────