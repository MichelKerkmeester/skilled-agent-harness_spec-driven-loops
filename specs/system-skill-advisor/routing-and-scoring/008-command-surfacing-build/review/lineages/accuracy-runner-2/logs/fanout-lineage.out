{"type":"tool_use","timestamp":1794570291027,"sessionID":"ses_e2b4a2200ffebIrmmKNfkMdQAD","part":{"partID":"prt_1d4b9861d001CM8apmcm4TFc2c","sessionID":"ses_e2b4a2200ffebIrmmKNfkMdQAD","messageID":"msg_1d4b978f8001vIRTEMYBFLQFfs","type":"tool","id":"call_c03e31aacb7f4daaaa279bfd","tool":"read","state":{"status":"completed","input":{"path":".skilled/skills/system-deep-loop/runtime/scripts/append-mode-event.cjs"},"output":"Read file .skilled/skills/system-deep-loop/runtime/scripts/append-mode-event.cjs, lines 1-532\n1: #!/usr/bin/env node\n2: \n3: // ───────────────────────────────────────────────────────────────────\n4: // MODULE: Mode Event Append CLI\n5: // ───────────────────────────────────────────────────────────────────\n6: \n7: 'use strict';\n8: \n9: // ─────────────────────────────────────────────────────────────────────────────\n10: // 1. TSX BOOTSTRAP\n11: // ─────────────────────────────────────────────────────────────────────────────\n12: \n13: const TSX_LOADER = require.resolve('tsx');\n14: const isTsxLoaded = process.env.DEEP_LOOP_TSX_LOADED === '1';\n15: \n16: function runTsxBootstrap() {\n17:   const { spawn } = require('node:child_process');\n18:   const child = spawn(\n19:     process.execPath,\n20:     ['--import', TSX_LOADER, __filename, ...process.argv.slice(2)],\n21:     {\n22:       cwd: process.cwd(),\n23:       env: require('./runtime-bootstrap.cjs').tsxChildEnv({ DEEP_LOOP_TSX_LOADED: '1' }),\n24:       stdio: [process.stdin.isTTY ? 'ignore' : 'pipe', 'pipe', 'pipe'],\n25:     },\n26:   );\n27: \n28:   if (!process.stdin.isTTY && child.stdin) {\n29:     child.stdin.on('error', () => {});\n30:     process.stdin.pipe(child.stdin);\n31:   }\n32: \n33:   child.stdout?.pipe(process.stdout);\n34:   child.stderr?.pipe(process.stderr);\n35: \n36:   for (const signal of ['SIGINT', 'SIGTERM']) {\n37:     process.once(signal, () => {\n38:       child.kill(signal);\n39:     });\n40:   }\n41: \n42:   child.on('close', (status, signal) => {\n43:     if (status !== null) {\n44:       process.exit(status);\n45:     }\n46:     process.exit(signal === 'SIGINT' ? 130 : signal === 'SIGTERM' ? 143 : 1);\n47:   });\n48: }\n49: \n50: if (require.main === module && !isTsxLoaded) {\n51:   runTsxBootstrap();\n52: }\n53: \n54: // ─────────────────────────────────────────────────────────────────────────────\n55: // 2. MAIN IMPLEMENTATION (under tsx)\n56: // ─────────────────────────────────────────────────────────────────────────────\n57: \n58: function parseArgs(argv = process.argv.slice(2)) {\n59:   const knownFlags = ['mode', 'runDirectory', 'runDir', 'specFolder', 'eventJson', 'eventJsonPath', 'policyId'];\n60:   const args = {};\n61:   for (let i = 0; i < argv.length; i += 1) {\n62:     const token = argv[i];\n63:     if (!token.startsWith('--')) {\n64:       throw new Error(`Unexpected positional argument: ${token}`);\n65:     }\n66:     const key = token.slice(2).replace(/-([a-z])/g, (_, c) => c.toUpperCase());\n67:     if (!knownFlags.includes(key)) {\n68:       const error = new Error(`Unknown option: --${token.slice(2)}`);\n69:       error.code = 'INPUT_VALIDATION';\n70:       throw error;\n71:     }\n72:     const next = argv[i + 1];\n73:     if (next === undefined || next.startsWith('--')) {\n74:       args[key] = true;\n75:     } else {\n76:       args[key] = next;\n77:       i += 1;\n78:     }\n79:   }\n80:   return args;\n81: }\n82: \n83: function requireString(args, ...keys) {\n84:   for (const key of keys) {\n85:     if (args[key] && typeof args[key] === 'string') {\n86:       return args[key];\n87:     }\n88:   }\n89:   throw new Error(`${keys[0]} is required`);\n90: }\n91: \n92: // Key order carries no meaning in an event the caller hands over, so the\n93: // digest sorts keys before hashing.\n94: function stableJson(value) {\n95:   if (Array.isArray(value)) return `[${value.map(stableJson).join(',')}]`;\n96:   if (value !== null && typeof value === 'object') {\n97:     return `{${Object.keys(value).sort()\n98:       .map((key) => `${JSON.stringify(key)}:${stableJson(value[key])}`)\n99:       .join(',')}}`;\n100:   }\n101:   return JSON.stringify(value);\n102: }\n103: \n104: function jsonOut(payload) {\n105:   process.stdout.write(`${JSON.stringify(payload)}\\n`);\n106: }\n107: \n108: function normalizeMode(mode) {\n109:   if (!mode || typeof mode !== 'string') return '';\n110:   const trimmed = mode.trim();\n111:   if (trimmed === 'research' || trimmed === 'deep-research') return 'deep-research';\n112:   if (trimmed === 'review' || trimmed === 'deep-review') return 'deep-review';\n113:   if (trimmed === 'ai-council' || trimmed === 'council' || trimmed === 'deep-ai-council' || trimmed === 'deep-council') return 'deep-ai-council';\n114:   return trimmed;\n115: }\n116: \n117: async function resolveModeAdapter(mode) {\n118:   const normalized = normalizeMode(mode);\n119:   switch (normalized) {\n120:     case 'deep-research': {\n121:       const mod = await import('../lib/deep-research-ledger-schema/index.ts');\n122:       return {\n123:         normalizedMode: 'deep-research',\n124:         createRegistry: mod.createDeepResearchEventRegistry,\n125:         prepareEvent: mod.prepareDeepResearchEvent,\n126:         isEventStem: mod.isDeepResearchEventStem,\n127:       };\n128:     }\n129:     case 'deep-review': {\n130:       const mod = await import('../lib/deep-review-ledger-schema/index.ts');\n131:       return {\n132:         normalizedMode: 'deep-review',\n133:         createRegistry: mod.createDeepReviewEventRegistry,\n134:         prepareEvent: mod.prepareDeepReviewEvent,\n135:         isEventStem: mod.isDeepReviewEventStem,\n136:       };\n137:     }\n138:     case 'deep-ai-council': {\n139:       const mod = await import('../lib/deep-ai-council-ledger-schema/index.ts');\n140:       return {\n141:         normalizedMode: 'deep-ai-council',\n142:         createRegistry: mod.createDeepAiCouncilEventRegistry,\n143:         prepareEvent: mod.prepareDeepAiCouncilEvent,\n144:         isEventStem: mod.isDeepAiCouncilEventStem,\n145:       };\n146:     }\n147:     default:\n148:       throw new Error(`Unsupported mode: ${mode}`);\n149:   }\n150: }\n151: \n152: async function main() {\n153:   const fs = require('node:fs');\n154:   const path = require('node:path');\n155:   const crypto = require('node:crypto');\n156: \n157:   const args = parseArgs();\n158: \n159:   const modeRaw = requireString(args, 'mode');\n160:   const runDirectory = requireString(args, 'runDirectory', 'runDir', 'specFolder');\n161:   const eventJsonPath = requireString(args, 'eventJson', 'eventJsonPath');\n162: \n163:   let rawEvent;\n164:   try {\n165:     const raw = fs.readFileSync(eventJsonPath, 'utf8');\n166:     rawEvent = JSON.parse(raw);\n167:   } catch (error) {\n168:     jsonOut({\n169:       ok: false,\n170:       phase: 'input',\n171:       reason: `Failed to read event JSON: ${error.message}`,\n172:       code: 'INPUT_ERROR',\n173:     });\n174:     process.exit(1);\n175:   }\n176: \n177:   const { appendModeEvent } = await import('../lib/mode-append-gateway/index.ts');\n178:   const {\n179:     AppendOnlyLedger,\n180:     TransitionAuthorizationGateway,\n181:     TransitionPolicyRegistry,\n182:     AuthorizationVerdicts,\n183:     AuthorizationReasonCodes,\n184:   } = await import('../lib/authorized-ledger/index.ts');\n185:   const { prepareEventWrite } = await import('../lib/event-envelope/index.ts');\n186:   const { resolveCutoverBinding } = await import('../lib/mode-append-gateway/index.ts');\n187:   const { resolveAuthorityRoot } = await import('../lib/authority-root/index.ts');\n188:   const { admitCanonicalWrite } = await import('../lib/deep-research-authority/index.ts');\n189:   const { AUTHORITY_FLIP_MODE_ORDER } = await import('../lib/per-mode-authority-flip/index.ts');\n190:   const { upcastLegacyDeepResearchRecord } = await import('../lib/deep-research-ledger-schema/index.ts');\n191: \n192:   const adapter = await resolveModeAdapter(modeRaw);\n193:   const normalizedMode = adapter.normalizedMode;\n194:   const registry = adapter.createRegistry();\n195: \n196:   // Read the durable authority record before anything is constructed. A CLI\n197:   // that asserts its own authority is exactly the private write path the\n198:   // gateway exists to remove, so a refusal here must happen before a ledger,\n199:   // a policy registry, or a run directory is touched.\n200:   const authorityRoot = resolveAuthorityRoot();\n201:   // A mode outside the frozen flip order has no authority record to read, and\n202:   // the selector reports that as a malformed record. Naming the real cause here\n203:   // keeps an operator from hunting a corrupt file that does not exist.\n204:   if (!AUTHORITY_FLIP_MODE_ORDER.includes(normalizedMode)) {\n205:     jsonOut({\n206:       ok: false,\n207:       phase: 'authority',\n208:       reason: `Mode '${normalizedMode}' is not in the frozen authority order: ${AUTHORITY_FLIP_MODE_ORDER.join(', ')}`,\n209:       code: 'AUTHORITY_DENIED',\n210:     });\n211:     process.exit(2);\n212:   }\n213:   let admission;\n214:   try {\n215:     admission = admitCanonicalWrite(normalizedMode, { authorityRoot });\n216:   } catch (error) {\n217:     jsonOut({\n218:       ok: false,\n219:       phase: 'authority',\n220:       reason: error instanceof Error ? error.message : String(error),\n221:       code: 'AUTHORITY_DENIED',\n222:     });\n223:     process.exit(2);\n224:   }\n225:   if (admission.outcome === 'denied') {\n226:     jsonOut({\n227:       ok: false,\n228:       phase: 'authority',\n229:       reason: `Authority admission denied: ${admission.reasonCode}`,\n230:       code: 'AUTHORITY_DENIED',\n231:     });\n232:     process.exit(2);\n233:   }\n234:   if (admission.admissionOpen === false) {\n235:     jsonOut({ ok: false, phase: 'authority', reason: 'Authority admission closed', code: 'AUTHORITY_DENIED' });\n236:     process.exit(2);\n237:   }\n238:   const authority = { state: admission.state, epoch: admission.epoch };\n239:   const policyId = typeof args.policyId === 'string' ? args.policyId : `${normalizedMode}-append-policy`;\n240:   const policyVersion = 1;\n241:   const ruleId = 'mode-event-append';\n242: \n243:   const policyRegistry = new TransitionPolicyRegistry([{\n244:     policyId,\n245:     policyVersion,\n246:     evaluatorVersion: '1',\n247:     ruleIds: [ruleId],\n248:     capturedAuthorizationState: { state: authority.state, epoch: authority.epoch },\n249:     evaluate: () => ({\n250:       verdict: AuthorizationVerdicts.ALLOW,\n251:       reasonCode: AuthorizationReasonCodes.ALLOWED,\n252:       matchedRuleIds: [ruleId],\n253:     }),\n254:   }]);\n255: \n256:   const resolvedPolicy = policyRegistry.resolve(policyId, policyVersion);\n257: \n258:   const ledgerId = `${normalizedMode}-ledger`;\n259:   const auditLedgerId = `${normalizedMode}-audit-ledger`;\n260: \n261:   const ledger = new AppendOnlyLedger({\n262:     rootDirectory: runDirectory,\n263:     ledgerId,\n264:     auditLedgerId,\n265:     authorityProvider: () => authority,\n266:   }, registry);\n267: \n268:   const authorizationGateway = new TransitionAuthorizationGateway({\n269:     rootDirectory: runDirectory,\n270:     auditLedgerId,\n271:     authorityProvider: () => authority,\n272:     identityResolver: (context) => ({\n273:       actorId: context.evaluationInput.actorId,\n274:       capabilityId: context.evaluationInput.capabilityId,\n275:       evidenceDigest: context.evaluationInput.evidenceDigest,\n276:     }),\n277:   }, ledger, policyRegistry);\n278: \n279:   let binding;\n280:   try {\n281:     binding = resolveCutoverBinding({\n282:       mode: normalizedMode,\n283:       repositoryRoot: runDirectory,\n284:     });\n285:   } catch (primaryError) {\n286:     try {\n287:       binding = resolveCutoverBinding({\n288:         mode: normalizedMode,\n289:         repositoryRoot: process.cwd(),\n290:       });\n291:     } catch (fallbackError) {\n292:       // An unattributable flip is worse than a blocked one: fabricating a\n293:       // zero-SHA identity here would let the ledger carry a transition\n294:       // nobody can be held to. Refuse instead of defaulting.\n295:       const primaryMessage = primaryError instanceof Error ? primaryError.message : String(primaryError);\n296:       const fallbackMessage = fallbackError instanceof Error ? fallbackError.message : String(fallbackError);\n297:       jsonOut({\n298:         ok: false,\n299:         phase: 'binding',\n300:         reason: `Cannot bind an authority flip: cutover binding could not be resolved from the run directory (${primaryMessage}) or the working directory (${fallbackMessage}).`,\n301:         code: 'BINDING_FAILED',\n302:       });\n303:       process.exit(2);\n304:     }\n305:   }\n306: \n307:   const currentHead = await ledger.getVerifiedHead();\n308:   const nowIso = new Date().toISOString();\n309:   // A retry hands over the same event again, but everything this CLI mints for\n310:   // it (event id, timestamps, chain position) changes between calls. The event\n311:   // as the caller handed it over is what stays fixed, so a caller that names no\n312:   // idempotency key gets one derived from it, and the gateway stores a retried\n313:   // event once.\n314:   const defaultIdempotencyKey = `${normalizedMode}:input:${crypto\n315:     .createHash('sha256')\n316:     .update(stableJson(rawEvent))\n317:     .digest('hex')}`;\n318: \n319:   // Shared builder for the envelope-metadata + payload-core input that\n320:   // adapter.prepareEvent consumes. Both the explicit-stem path and the legacy\n321:   // upcast path funnel through here so the envelope shape is defined once.\n322:   function buildPreparedInput(core, meta) {\n323:     return {\n324:       stem: core.stem,\n325:       scope: core.scope,\n326:       data: core.data,\n327:       prevEventHash: core.prevEventHash,\n328:       replay: core.replay,\n329:       eventId: meta.eventId || meta.event_id || `event-${crypto.randomUUID()}`,\n330:       streamId: meta.streamId || meta.stream_id || ledgerId,\n331:       streamSequence: meta.streamSequence ?? meta.stream_sequence ?? (currentHead.sequence + 1),\n332:       occurredAt: meta.occurredAt || meta.occurred_at || nowIso,\n333:       recordedAt: meta.recordedAt || meta.recorded_at || nowIso,\n334:       producer: meta.producer || { name: 'deep-loop-cli', version: '1.0.0' },\n335:       authorityEpoch: meta.authorityEpoch ?? meta.authority_epoch ?? authority.epoch,\n336:       correlationId: meta.correlationId || meta.correlation_id || crypto.randomUUID(),\n337:       causationId: meta.causationId !== undefined\n338:         ? meta.causationId\n339:         : (meta.causation_id !== undefined ? meta.causation_id : null),\n340:       idempotencyKey: meta.idempotencyKey || meta.idempotency_key || defaultIdempotencyKey,\n341:     };\n342:   }\n343: \n344:   const defaultReplay = {\n345:     fingerprint_version: 1,\n346:     final_digest: '0'.repeat(64),\n347:     replay_input_digests: {},\n348:   };\n349: \n350:   let eventRecord;\n351:   let legacyWarnings;\n352:   if (\n353:     rawEvent\n354:     && typeof rawEvent === 'object'\n355:     && rawEvent.canonicalDigest\n356:     && rawEvent.canonicalBytes\n357:     && rawEvent.identity\n358:     && rawEvent.envelope\n359:   ) {\n360:     eventRecord = rawEvent;\n361:   } else if (rawEvent && typeof rawEvent === 'object' && rawEvent.stem) {\n362:     const preparedInput = buildPreparedInput({\n363:       stem: rawEvent.stem,\n364:       scope: rawEvent.scope || { runId: 'run-cli', lineageId: 'lineage-cli' },\n365:       data: rawEvent.data || {},\n366:       prevEventHash: rawEvent.prevEventHash || rawEvent.prev_event_hash || currentHead.recordHash,\n367:       replay: rawEvent.replay || defaultReplay,\n368:     }, rawEvent);\n369:     eventRecord = adapter.prepareEvent(preparedInput, registry);\n370:   } else if (rawEvent && typeof rawEvent === 'object' && (rawEvent.event_type || rawEvent.eventType)) {\n371:     const envelope = {\n372:       envelope_version: rawEvent.envelope_version ?? rawEvent.envelopeVersion ?? 1,\n373:       event_id: rawEvent.event_id || rawEvent.eventId || `event-${crypto.randomUUID()}`,\n374:       event_type: rawEvent.event_type || rawEvent.eventType,\n375:       event_version: rawEvent.event_version ?? rawEvent.eventVersion ?? 1,\n376:       stream_id: rawEvent.stream_id || rawEvent.streamId || ledgerId,\n377:       stream_sequence: rawEvent.stream_sequence ?? rawEvent.streamSequence ?? (currentHead.sequence + 1),\n378:       occurred_at: rawEvent.occurred_at || rawEvent.occurredAt || nowIso,\n379:       recorded_at: rawEvent.recorded_at || rawEvent.recordedAt || nowIso,\n380:       producer: rawEvent.producer || { name: 'deep-loop-cli', version: '1.0.0' },\n381:       authority_epoch: rawEvent.authority_epoch ?? rawEvent.authorityEpoch ?? authority.epoch,\n382:       correlation_id: rawEvent.correlation_id || rawEvent.correlationId || crypto.randomUUID(),\n383:       causation_id: rawEvent.causation_id !== undefined\n384:         ? rawEvent.causation_id\n385:         : (rawEvent.causationId !== undefined ? rawEvent.causationId : null),\n386:       idempotency_key: rawEvent.idempotency_key || rawEvent.idempotencyKey || defaultIdempotencyKey,\n387:       payload: rawEvent.payload || {},\n388:     };\n389:     eventRecord = prepareEventWrite(envelope, registry);\n390:   } else if (\n391:     normalizedMode === 'deep-research'\n392:     && rawEvent\n393:     && typeof rawEvent === 'object'\n394:   ) {\n395:     // Legacy deep-research rows predate the canonical envelope and carry no\n396:     // stem or event_type the current registry recognizes. This branch is tried\n397:     // last so canonical envelopes and explicit stem/event_type rows keep their\n398:     // fast paths untouched; only rows that would otherwise hit the final throw\n399:     // reach the upcaster. Non-research modes never enter here, so they keep\n400:     // the original unrecognized-format rejection.\n401:     const legacyRunId = rawEvent.runId || rawEvent.sessionId || 'run-cli';\n402:     const legacyLineageId = rawEvent.lineageId\n403:       || rawEvent.parentSessionId\n404:       || rawEvent.sessionId\n405:       || 'lineage-cli';\n406:     const legacyScope = { runId: legacyRunId, lineageId: legacyLineageId };\n407:     const legacyIteration = rawEvent.iteration ?? rawEvent.run;\n408:     if (Number.isSafeInteger(legacyIteration) && legacyIteration > 0) {\n409:       legacyScope.iteration = legacyIteration;\n410:     }\n411:     const legacyContext = {\n412:       scope: legacyScope,\n413:       prevEventHash: currentHead.recordHash,\n414:       replay: defaultReplay,\n415:     };\n416:     const upcast = upcastLegacyDeepResearchRecord(rawEvent, legacyContext);\n417:     if (upcast.status === 'refused') {\n418:       // A bare \"refused\" tells the operator nothing actionable. Carrying the\n419:       // decision's own reasonCode lets them see whether the row was blocked,\n420:       // pinned to the old runtime, or simply unrecognized, so they can fix the\n421:       // input rather than guess. Nothing is written: this throws before any\n422:       // append is attempted.\n423:       throw new Error(\n424:         `Legacy deep-research record refused: ${upcast.decision.reasonCode}`,\n425:       );\n426:     }\n427:     // A row the projection writes back with its own timestamp hands that time\n428:     // over as the event's occurrence time, so the row keeps it.\n429:     const preparedInput = buildPreparedInput({\n430:       stem: upcast.targetStem,\n431:       scope: upcast.scope,\n432:       data: upcast.data,\n433:       prevEventHash: upcast.prevEventHash,\n434:       replay: upcast.replay,\n435:     }, upcast.occurredAt ? { occurredAt: upcast.occurredAt, ...rawEvent } : rawEvent);\n436:     eventRecord = adapter.prepareEvent(preparedInput, registry);\n437:     legacyWarnings = upcast.warnings;\n438:   } else if (\n439:     normalizedMode === 'deep-review'\n440:     && rawEvent\n441:     && typeof rawEvent === 'object'\n442:     && !Array.isArray(rawEvent)\n443:     && rawEvent.type === 'iteration'\n444:   ) {\n445:     // The review agent, its iteration prompt and its workflow all hand the gateway the canonical\n446:     // iteration record itself. Its optional fields vary with review depth and executor, so it\n447:     // travels whole under one stem, and the state projection writes it back as the same row.\n448:     const sessionId = typeof rawEvent.sessionId === 'string' && rawEvent.sessionId\n449:       ? rawEvent.sessionId\n450:       : 'run-cli';\n451:     const preparedInput = buildPreparedInput({\n452:       stem: 'deep_review.iteration_recorded',\n453:       scope: { runId: sessionId, sessionId },\n454:       data: { record: rawEvent },\n455:       prevEventHash: currentHead.recordHash,\n456:       replay: defaultReplay,\n457:     }, rawEvent);\n458:     eventRecord = adapter.prepareEvent(preparedInput, registry);\n459:   } else {\n460:     throw new Error('Unrecognized event format: expected object with stem or event_type');\n461:   }\n462: \n463:   const outcome = await appendModeEvent({\n464:     mode: normalizedMode,\n465:     runDirectory,\n466:     eventRecord,\n467:     authorityRoot,\n468:     policy: {\n469:       policyId: resolvedPolicy.policyId,\n470:       policyVersion: resolvedPolicy.policyVersion,\n471:       policyDigest: resolvedPolicy.digest,\n472:     },\n473:     policyRegistry,\n474:     authorizationGateway,\n475:     ledger,\n476:     eventRegistry: registry,\n477:     binding,\n478:   });\n479: \n480:   // Both phases leave the state log out of step with the ledger, so the runner\n481:   // reads either one back to name why a lineage recorded nothing.\n482:   if (outcome && outcome.ok === false && (outcome.phase === 'projection' || outcome.phase === 'provenance')) {\n483:     const eventStem = eventRecord?.envelope?.payload?.stem;\n484:     const refusalRecord = {\n485:       at: new Date().toISOString(),\n486:       mode: normalizedMode,\n487:       phase: outcome.phase,\n488:       code: outcome.code,\n489:       reason: outcome.reason,\n490:       ...(typeof eventStem === 'string' && eventStem ? { stem: eventStem } : {}),\n491:     };\n492:     try {\n493:       fs.appendFileSync(\n494:         path.join(runDirectory, 'gateway-refusals.jsonl'),\n495:         `${JSON.stringify(refusalRecord)}\\n`,\n496:         'utf8',\n497:       );\n498:     } catch {\n499:       // The refusal record is best-effort and must not change the CLI result.\n500:     }\n501:   }\n502: \n503:   // Surface a lossy legacy migration instead of letting it pass silently. Only\n504:   // the legacy upcast path sets legacyWarnings, so canonical/stem/event_type\n505:   // outputs stay byte-identical to before.\n506:   if (legacyWarnings && legacyWarnings.length > 0) {\n507:     jsonOut({ ...outcome, warnings: [...legacyWarnings] });\n508:   } else {\n509:     jsonOut(outcome);\n510:   }\n511:   process.exit(outcome.ok ? 0 : 2);\n512: }\n513: \n514: if (require.main === module && isTsxLoaded) {\n515:   main().catch((error) => {\n516:     jsonOut({\n517:       ok: false,\n518:       phase: 'runtime',\n519:       reason: error instanceof Error ? error.message : String(error),\n520:       code: error && error.code === 'INPUT_VALIDATION' ? 'INPUT_VALIDATION' : 'RUNTIME_ERROR',\n521:     });\n522:     process.exit(error && error.code === 'INPUT_VALIDATION' ? 3 : 1);\n523:   });\n524: }\n525: \n526: module.exports = {\n527:   stableJson,\n528:   parseArgs,\n529:   normalizeMode,\n530:   resolveModeAdapter,\n531:   main,\n532: };","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file .skilled/skills/system-deep-loop/runtime/scripts/append-mode-event.cjs, lines 1-532\n1: #!/usr/bin/env node\n2: \n3: // ───────────────────────────────────────────────────────────────────\n4: // MODULE: Mode Event Append CLI\n5: // ───────────────────────────────────────────────────────────────────\n6: \n7: 'use strict';\n8: \n9: // ─────────────────────────────────────────────────────────────────────────────\n10: // 1. TSX BOOTSTRAP\n11: // ─────────────────────────────────────────────────────────────────────────────\n12: \n13: const TSX_LOADER = require.resolve('tsx');\n14: const isTsxLoaded = process.env.DEEP_LOOP_TSX_LOADED === '1';\n15: \n16: function runTsxBootstrap() {\n17:   const { spawn } = require('node:child_process');\n18:   const child = spawn(\n19:     process.execPath,\n20:     ['--import', TSX_LOADER, __filename, ...process.argv.slice(2)],\n21:     {\n22:       cwd: process.cwd(),\n23:       env: require('./runtime-bootstrap.cjs').tsxChildEnv({ DEEP_LOOP_TSX_LOADED: '1' }),\n24:       stdio: [process.stdin.isTTY ? 'ignore' : 'pipe', 'pipe', 'pipe'],\n25:     },\n26:   );\n27: \n28:   if (!process.stdin.isTTY && child.stdin) {\n29:     child.stdin.on('error', () => {});\n30:     process.stdin.pipe(child.stdin);\n31:   }\n32: \n33:   child.stdout?.pipe(process.stdout);\n34:   child.stderr?.pipe(process.stderr);\n35: \n36:   for (const signal of ['SIGINT', 'SIGTERM']) {\n37:     process.once(signal, () => {\n38:       child.kill(signal);\n39:     });\n40:   }\n41: \n42:   child.on('close', (status, signal) => {\n43:     if (status !== null) {\n44:       process.exit(status);\n45:     }\n46:     process.exit(signal === 'SIGINT' ? 130 : signal === 'SIGTERM' ? 143 : 1);\n47:   });\n48: }\n49: \n50: if (require.main === module && !isTsxLoaded) {\n51:   runTsxBootstrap();\n52: }\n53: \n54: // ─────────────────────────────────────────────────────────────────────────────\n55: // 2. MAIN IMPLEMENTATION (under tsx)\n56: // ─────────────────────────────────────────────────────────────────────────────\n57: \n58: function parseArgs(argv = process.argv.slice(2)) {\n59:   const knownFlags = ['mode', 'runDirectory', 'runDir', 'specFolder', 'eventJson', 'eventJsonPath', 'policyId'];\n60:   const args = {};\n61:   for (let i = 0; i < argv.length; i += 1) {\n62:     const token = argv[i];\n63:     if (!token.startsWith('--')) {\n64:       throw new Error(`Unexpected positional argument: ${token}`);\n65:     }\n66:     const key = token.slice(2).replace(/-([a-z])/g, (_, c) => c.toUpperCase());\n67:     if (!knownFlags.includes(key)) {\n68:       const error = new Error(`Unknown option: --${token.slice(2)}`);\n69:       error.code = 'INPUT_VALIDATION';\n70:       throw error;\n71:     }\n72:     const next = argv[i + 1];\n73:     if (next === undefined || next.startsWith('--')) {\n74:       args[key] = true;\n75:     } else {\n76:       args[key] = next;\n77:       i += 1;\n78:     }\n79:   }\n80:   return args;\n81: }\n82: \n83: function requireString(args, ...keys) {\n84:   for (const key of keys) {\n85:     if (args[key] && typeof args[key] === 'string') {\n86:       return args[key];\n87:     }\n88:   }\n89:   throw new Error(`${keys[0]} is required`);\n90: }\n91: \n92: // Key order carries no meaning in an event the caller hands over, so the\n93: // digest sorts keys before hashing.\n94: function stableJson(value) {\n95:   if (Array.isArray(value)) return `[${value.map(stableJson).join(',')}]`;\n96:   if (value !== null && typeof value === 'object') {\n97:     return `{${Object.keys(value).sort()\n98:       .map((key) => `${JSON.stringify(key)}:${stableJson(value[key])}`)\n99:       .join(',')}}`;\n100:   }\n101:   return JSON.stringify(value);\n102: }\n103: \n104: function jsonOut(payload) {\n105:   process.stdout.write(`${JSON.stringify(payload)}\\n`);\n106: }\n107: \n108: function normalizeMode(mode) {\n109:   if (!mode || typeof mode !== 'string') return '';\n110:   const trimmed = mode.trim();\n111:   if (trimmed === 'research' || trimmed === 'deep-research') return 'deep-research';\n112:   if (trimmed === 'review' || trimmed === 'deep-review') return 'deep-review';\n113:   if (trimmed === 'ai-council' || trimmed === 'council' || trimmed === 'deep-ai-council' || trimmed === 'deep-council') return 'deep-ai-council';\n114:   return trimmed;\n115: }\n116: \n117: async function resolveModeAdapter(mode) {\n118:   const normalized = normalizeMode(mode);\n119:   switch (normalized) {\n120:     case 'deep-research': {\n121:       const mod = await import('../lib/deep-research-ledger-schema/index.ts');\n122:       return {\n123:         normalizedMode: 'deep-research',\n124:         createRegistry: mod.createDeepResearchEventRegistry,\n125:         prepareEvent: mod.prepareDeepResearchEvent,\n126:         isEventStem: mod.isDeepResearchEventStem,\n127:       };\n128:     }\n129:     case 'deep-review': {\n130:       const mod = await import('../lib/deep-review-ledger-schema/index.ts');\n131:       return {\n132:         normalizedMode: 'deep-review',\n133:         createRegistry: mod.createDeepReviewEventRegistry,\n134:         prepareEvent: mod.prepareDeepReviewEvent,\n135:         isEventStem: mod.isDeepReviewEventStem,\n136:       };\n137:     }\n138:     case 'deep-ai-council': {\n139:       const mod = await import('../lib/deep-ai-council-ledger-schema/index.ts');\n140:       return {\n141:         normalizedMode: 'deep-ai-council',\n142:         createRegistry: mod.createDeepAiCouncilEventRegistry,\n143:         prepareEvent: mod.prepareDeepAiCouncilEvent,\n144:         isEventStem: mod.isDeepAiCouncilEventStem,\n145:       };\n146:     }\n147:     default:\n148:       throw new Error(`Unsupported mode: ${mode}`);\n149:   }\n150: }\n151: \n152: async function main() {\n153:   const fs = require('node:fs');\n154:   const path = require('node:path');\n155:   const crypto = require('node:crypto');\n156: \n157:   const args = parseArgs();\n158: \n159:   const modeRaw = requireString(args, 'mode');\n160:   const runDirectory = requireString(args, 'runDirectory', 'runDir', 'specFolder');\n161:   const eventJsonPath = requireString(args, 'eventJson', 'eventJsonPath');\n162: \n163:   let rawEvent;\n164:   try {\n165:     const raw = fs.readFileSync(eventJsonPath, 'utf8');\n166:     rawEvent = JSON.parse(raw);\n167:   } catch (error) {\n168:     jsonOut({\n169:       ok: false,\n170:       phase: 'input',\n171:       reason: `Failed to read event JSON: ${error.message}`,\n172:       code: 'INPUT_ERROR',\n173:     });\n174:     process.exit(1);\n175:   }\n176: \n177:   const { appendModeEvent } = await import('../lib/mode-append-gateway/index.ts');\n178:   const {\n179:     AppendOnlyLedger,\n180:     TransitionAuthorizationGateway,\n181:     TransitionPolicyRegistry,\n182:     AuthorizationVerdicts,\n183:     AuthorizationReasonCodes,\n184:   } = await import('../lib/authorized-ledger/index.ts');\n185:   const { prepareEventWrite } = await import('../lib/event-envelope/index.ts');\n186:   const { resolveCutoverBinding } = await import('../lib/mode-append-gateway/index.ts');\n187:   const { resolveAuthorityRoot } = await import('../lib/authority-root/index.ts');\n188:   const { admitCanonicalWrite } = await import('../lib/deep-research-authority/index.ts');\n189:   const { AUTHORITY_FLIP_MODE_ORDER } = await import('../lib/per-mode-authority-flip/index.ts');\n190:   const { upcastLegacyDeepResearchRecord } = await import('../lib/deep-research-ledger-schema/index.ts');\n191: \n192:   const adapter = await resolveModeAdapter(modeRaw);\n193:   const normalizedMode = adapter.normalizedMode;\n194:   const registry = adapter.createRegistry();\n195: \n196:   // Read the durable authority record before anything is constructed. A CLI\n197:   // that asserts its own authority is exactly the private write path the\n198:   // gateway exists to remove, so a refusal here must happen before a ledger,\n199:   // a policy registry, or a run directory is touched.\n200:   const authorityRoot = resolveAuthorityRoot();\n201:   // A mode outside the frozen flip order has no authority record to read, and\n202:   // the selector reports that as a malformed record. Naming the real cause here\n203:   // keeps an operator from hunting a corrupt file that does not exist.\n204:   if (!AUTHORITY_FLIP_MODE_ORDER.includes(normalizedMode)) {\n205:     jsonOut({\n206:       ok: false,\n207:       phase: 'authority',\n208:       reason: `Mode '${normalizedMode}' is not in the frozen authority order: ${AUTHORITY_FLIP_MODE_ORDER.join(', ')}`,\n209:       code: 'AUTHORITY_DENIED',\n210:     });\n211:     process.exit(2);\n212:   }\n213:   let admission;\n214:   try {\n215:     admission = admitCanonicalWrite(normalizedMode, { authorityRoot });\n216:   } catch (error) {\n217:     jsonOut({\n218:       ok: false,\n219:       phase: 'authority',\n220:       reason: error instanceof Error ? error.message : String(error),\n221:       code: 'AUTHORITY_DENIED',\n222:     });\n223:     process.exit(2);\n224:   }\n225:   if (admission.outcome === 'denied') {\n226:     jsonOut({\n227:       ok: false,\n228:       phase: 'authority',\n229:       reason: `Authority admission denied: ${admission.reasonCode}`,\n230:       code: 'AUTHORITY_DENIED',\n231:     });\n232:     process.exit(2);\n233:   }\n234:   if (admission.admissionOpen === false) {\n235:     jsonOut({ ok: false, phase: 'authority', reason: 'Authority admission closed', code: 'AUTHORITY_DENIED' });\n236:     process.exit(2);\n237:   }\n238:   const authority = { state: admission.state, epoch: admission.epoch };\n239:   const policyId = typeof args.policyId === 'string' ? args.policyId : `${normalizedMode}-append-policy`;\n240:   const policyVersion = 1;\n241:   const ruleId = 'mode-event-append';\n242: \n243:   const policyRegistry = new TransitionPolicyRegistry([{\n244:     policyId,\n245:     policyVersion,\n246:     evaluatorVersion: '1',\n247:     ruleIds: [ruleId],\n248:     capturedAuthorizationState: { state: authority.state, epoch: authority.epoch },\n249:     evaluate: () => ({\n250:       verdict: AuthorizationVerdicts.ALLOW,\n251:       reasonCode: AuthorizationReasonCodes.ALLOWED,\n252:       matchedRuleIds: [ruleId],\n253:     }),\n254:   }]);\n255: \n256:   const resolvedPolicy = policyRegistry.resolve(policyId, policyVersion);\n257: \n258:   const ledgerId = `${normalizedMode}-ledger`;\n259:   const auditLedgerId = `${normalizedMode}-audit-ledger`;\n260: \n261:   const ledger = new AppendOnlyLedger({\n262:     rootDirectory: runDirectory,\n263:     ledgerId,\n264:     auditLedgerId,\n265:     authorityProvider: () => authority,\n266:   }, registry);\n267: \n268:   const authorizationGateway = new TransitionAuthorizationGateway({\n269:     rootDirectory: runDirectory,\n270:     auditLedgerId,\n271:     authorityProvider: () => authority,\n272:     identityResolver: (context) => ({\n273:       actorId: context.evaluationInput.actorId,\n274:       capabilityId: context.evaluationInput.capabilityId,\n275:       evidenceDigest: context.evaluationInput.evidenceDigest,\n276:     }),\n277:   }, ledger, policyRegistry);\n278: \n279:   let binding;\n280:   try {\n281:     binding = resolveCutoverBinding({\n282:       mode: normalizedMode,\n283:       repositoryRoot: runDirectory,\n284:     });\n285:   } catch (primaryError) {\n286:     try {\n287:       binding = resolveCutoverBinding({\n288:         mode: normalizedMode,\n289:         repositoryRoot: process.cwd(),\n290:       });\n291:     } catch (fallbackError) {\n292:       // An unattributable flip is worse than a blocked one: fabricating a\n293:       // zero-SHA identity here would let the ledger carry a transition\n294:       // nobody can be held to. Refuse instead of defaulting.\n295:       const primaryMessage = primaryError instanceof Error ? primaryError.message : String(primaryError);\n296:       const fallbackMessage = fallbackError instanceof Error ? fallbackError.message : String(fallbackError);\n297:       jsonOut({\n298:         ok: false,\n299:         phase: 'binding',\n300:         reason: `Cannot bind an authority flip: cutover binding could not be resolved from the run directory (${primaryMessage}) or the working directory (${fallbackMessage}).`,\n301:         code: 'BINDING_FAILED',\n302:       });\n303:       process.exit(2);\n304:     }\n305:   }\n306: \n307:   const currentHead = await ledger.getVerifiedHead();\n308:   const nowIso = new Date().toISOString();\n309:   // A retry hands over the same event again, but everything this CLI mints for\n310:   // it (event id, timestamps, chain position) changes between calls. The event\n311:   // as the caller handed it over is what stays fixed, so a caller that names no\n312:   // idempotency key gets one derived from it, and the gateway stores a retried\n313:   // event once.\n314:   const defaultIdempotencyKey = `${normalizedMode}:input:${crypto\n315:     .createHash('sha256')\n316:     .update(stableJson(rawEvent))\n317:     .digest('hex')}`;\n318: \n319:   // Shared builder for the envelope-metadata + payload-core input that\n320:   // adapter.prepareEvent consumes. Both the explicit-stem path and the legacy\n321:   // upcast path funnel through here so the envelope shape is defined once.\n322:   function buildPreparedInput(core, meta) {\n323:     return {\n324:       stem: core.stem,\n325:       scope: core.scope,\n326:       data: core.data,\n327:       prevEventHash: core.prevEventHash,\n328:       replay: core.replay,\n329:       eventId: meta.eventId || meta.event_id || `event-${crypto.randomUUID()}`,\n330:       streamId: meta.streamId || meta.stream_id || ledgerId,\n331:       streamSequence: meta.streamSequence ?? meta.stream_sequence ?? (currentHead.sequence + 1),\n332:       occurredAt: meta.occurredAt || meta.occurred_at || nowIso,\n333:       recordedAt: meta.recordedAt || meta.recorded_at || nowIso,\n334:       producer: meta.producer || { name: 'deep-loop-cli', version: '1.0.0' },\n335:       authorityEpoch: meta.authorityEpoch ?? meta.authority_epoch ?? authority.epoch,\n336:       correlationId: meta.correlationId || meta.correlation_id || crypto.randomUUID(),\n337:       causationId: meta.causationId !== undefined\n338:         ? meta.causationId\n339:         : (meta.causation_id !== undefined ? meta.causation_id : null),\n340:       idempotencyKey: meta.idempotencyKey || meta.idempotency_key || defaultIdempotencyKey,\n341:     };\n342:   }\n343: \n344:   const defaultReplay = {\n345:     fingerprint_version: 1,\n346:     final_digest: '0'.repeat(64),\n347:     replay_input_digests: {},\n348:   };\n349: \n350:   let eventRecord;\n351:   let legacyWarnings;\n352:   if (\n353:     rawEvent\n354:     && typeof rawEvent === 'object'\n355:     && rawEvent.canonicalDigest\n356:     && rawEvent.canonicalBytes\n357:     && rawEvent.identity\n358:     && rawEvent.envelope\n359:   ) {\n360:     eventRecord = rawEvent;\n361:   } else if (rawEvent && typeof rawEvent === 'object' && rawEvent.stem) {\n362:     const preparedInput = buildPreparedInput({\n363:       stem: rawEvent.stem,\n364:       scope: rawEvent.scope || { runId: 'run-cli', lineageId: 'lineage-cli' },\n365:       data: rawEvent.data || {},\n366:       prevEventHash: rawEvent.prevEventHash || rawEvent.prev_event_hash || currentHead.recordHash,\n367:       replay: rawEvent.replay || defaultReplay,\n368:     }, rawEvent);\n369:     eventRecord = adapter.prepareEvent(preparedInput, registry);\n370:   } else if (rawEvent && typeof rawEvent === 'object' && (rawEvent.event_type || rawEvent.eventType)) {\n371:     const envelope = {\n372:       envelope_version: rawEvent.envelope_version ?? rawEvent.envelopeVersion ?? 1,\n373:       event_id: rawEvent.event_id || rawEvent.eventId || `event-${crypto.randomUUID()}`,\n374:       event_type: rawEvent.event_type || rawEvent.eventType,\n375:       event_version: rawEvent.event_version ?? rawEvent.eventVersion ?? 1,\n376:       stream_id: rawEvent.stream_id || rawEvent.streamId || ledgerId,\n377:       stream_sequence: rawEvent.stream_sequence ?? rawEvent.streamSequence ?? (currentHead.sequence + 1),\n378:       occurred_at: rawEvent.occurred_at || rawEvent.occurredAt || nowIso,\n379:       recorded_at: rawEvent.recorded_at || rawEvent.recordedAt || nowIso,\n380:       producer: rawEvent.producer || { name: 'deep-loop-cli', version: '1.0.0' },\n381:       authority_epoch: rawEvent.authority_epoch ?? rawEvent.authorityEpoch ?? authority.epoch,\n382:       correlation_id: rawEvent.correlation_id || rawEvent.correlationId || crypto.randomUUID(),\n383:       causation_id: rawEvent.causation_id !== undefined\n384:         ? rawEvent.causation_id\n385:         : (rawEvent.causationId !== undefined ? rawEvent.causationId : null),\n386:       idempotency_key: rawEvent.idempotency_key || rawEvent.idempotencyKey || defaultIdempotencyKey,\n387:       payload: rawEvent.payload || {},\n388:     };\n389:     eventRecord = prepareEventWrite(envelope, registry);\n390:   } else if (\n391:     normalizedMode === 'deep-research'\n392:     && rawEvent\n393:     && typeof rawEvent === 'object'\n394:   ) {\n395:     // Legacy deep-research rows predate the canonical envelope and carry no\n396:     // stem or event_type the current registry recognizes. This branch is tried\n397:     // last so canonical envelopes and explicit stem/event_type rows keep their\n398:     // fast paths untouched; only rows that would otherwise hit the final throw\n399:     // reach the upcaster. Non-research modes never enter here, so they keep\n400:     // the original unrecognized-format rejection.\n401:     const legacyRunId = rawEvent.runId || rawEvent.sessionId || 'run-cli';\n402:     const legacyLineageId = rawEvent.lineageId\n403:       || rawEvent.parentSessionId\n404:       || rawEvent.sessionId\n405:       || 'lineage-cli';\n406:     const legacyScope = { runId: legacyRunId, lineageId: legacyLineageId };\n407:     const legacyIteration = rawEvent.iteration ?? rawEvent.run;\n408:     if (Number.isSafeInteger(legacyIteration) && legacyIteration > 0) {\n409:       legacyScope.iteration = legacyIteration;\n410:     }\n411:     const legacyContext = {\n412:       scope: legacyScope,\n413:       prevEventHash: currentHead.recordHash,\n414:       replay: defaultReplay,\n415:     };\n416:     const upcast = upcastLegacyDeepResearchRecord(rawEvent, legacyContext);\n417:     if (upcast.status === 'refused') {\n418:       // A bare \"refused\" tells the operator nothing actionable. Carrying the\n419:       // decision's own reasonCode lets them see whether the row was blocked,\n420:       // pinned to the old runtime, or simply unrecognized, so they can fix the\n421:       // input rather than guess. Nothing is written: this throws before any\n422:       // append is attempted.\n423:       throw new Error(\n424:         `Legacy deep-research record refused: ${upcast.decision.reasonCode}`,\n425:       );\n426:     }\n427:     // A row the projection writes back with its own timestamp hands that time\n428:     // over as the event's occurrence time, so the row keeps it.\n429:     const preparedInput = buildPreparedInput({\n430:       stem: upcast.targetStem,\n431:       scope: upcast.scope,\n432:       data: upcast.data,\n433:       prevEventHash: upcast.prevEventHash,\n434:       replay: upcast.replay,\n435:     }, upcast.occurredAt ? { occurredAt: upcast.occurredAt, ...rawEvent } : rawEvent);\n436:     eventRecord = adapter.prepareEvent(preparedInput, registry);\n437:     legacyWarnings = upcast.warnings;\n438:   } else if (\n439:     normalizedMode === 'deep-review'\n440:     && rawEvent\n441:     && typeof rawEvent === 'object'\n442:     && !Array.isArray(rawEvent)\n443:     && rawEvent.type === 'iteration'\n444:   ) {\n445:     // The review agent, its iteration prompt and its workflow all hand the gateway the canonical\n446:     // iteration record itself. Its optional fields vary with review depth and executor, so it\n447:     // travels whole under one stem, and the state projection writes it back as the same row.\n448:     const sessionId = typeof rawEvent.sessionId === 'string' && rawEvent.sessionId\n449:       ? rawEvent.sessionId\n450:       : 'run-cli';\n451:     const preparedInput = buildPreparedInput({\n452:       stem: 'deep_review.iteration_recorded',\n453:       scope: { runId: sessionId, sessionId },\n454:       data: { record: rawEvent },\n455:       prevEventHash: currentHead.recordHash,\n456:       replay: defaultReplay,\n457:     }, rawEvent);\n458:     eventRecord = adapter.prepareEvent(preparedInput, registry);\n459:   } else {\n460:     throw new Error('Unrecognized event format: expected object with stem or event_type');\n461:   }\n462: \n463:   const outcome = await appendModeEvent({\n464:     mode: normalizedMode,\n465:     runDirectory,\n466:     eventRecord,\n467:     authorityRoot,\n468:     policy: {\n469:       policyId: resolvedPolicy.policyId,\n470:       policyVersion: resolvedPolicy.policyVersion,\n471:       policyDigest: resolvedPolicy.digest,\n472:     },\n473:     policyRegistry,\n474:     authorizationGateway,\n475:     ledger,\n476:     eventRegistry: registry,\n477:     binding,\n478:   });\n479: \n480:   // Both phases leave the state log out of step with the ledger, so the runner\n481:   // reads either one back to name why a lineage recorded nothing.\n482:   if (outcome && outcome.ok === false && (outcome.phase === 'projection' || outcome.phase === 'provenance')) {\n483:     const eventStem = eventRecord?.envelope?.payload?.stem;\n484:     const refusalRecord = {\n485:       at: new Date().toISOString(),\n486:       mode: normalizedMode,\n487:       phase: outcome.phase,\n488:       code: outcome.code,\n489:       reason: outcome.reason,\n490:       ...(typeof eventStem === 'string' && eventStem ? { stem: eventStem } : {}),\n491:     };\n492:     try {\n493:       fs.appendFileSync(\n494:         path.join(runDirectory, 'gateway-refusals.jsonl'),\n495:         `${JSON.stringify(refusalRecord)}\\n`,\n496:         'utf8',\n497:       );\n498:     } catch {\n499:       // The refusal record is best-effort and must not change the CLI result.\n500:     }\n501:   }\n502: \n503:   // Surface a lossy legacy migration instead of letting it pass silently. Only\n504:   // the legacy upcast path sets legacyWarnings, so canonical/stem/event_type\n505:   // outputs stay byte-identical to before.\n506:   if (legacyWarnings && legacyWarnings.length > 0) {\n507:     jsonOut({ ...outcome, warnings: [...legacyWarnings] });\n508:   } else {\n509:     jsonOut(outcome);\n510:   }\n511:   process.exit(outcome.ok ? 0 : 2);\n512: }\n513: \n514: if (require.main === module && isTsxLoaded) {\n515:   main().catch((error) => {\n516:     jsonOut({\n517:       ok: false,\n518:       phase: 'runtime',\n519:       reason: error instanceof Error ? error.message : String(error),\n520:       code: error && error.code === 'INPUT_VALIDATION' ? 'INPUT_VALIDATION' : 'RUNTIME_ERROR',\n521:     });\n522:     process.exit(error && error.code === 'INPUT_VALIDATION' ? 3 : 1);\n523:   });\n524: }\n525: \n526: module.exports = {\n527:   stableJson,\n528:   parseArgs,\n529:   normalizeMode,\n530:   resolveModeAdapter,\n531:   main,\n532: };"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\".skilled/skills/system-deep-loop/runtime/scripts/append-mode-event.cjs\"}"},"time":{"start":1794570290717,"end":1794570291027}}}}
