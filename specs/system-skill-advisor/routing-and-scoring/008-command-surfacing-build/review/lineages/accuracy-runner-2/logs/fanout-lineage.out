{"type":"tool_use","timestamp":1794572088743,"sessionID":"ses_e2b4a2200ffebIrmmKNfkMdQAD","part":{"partID":"prt_1d4d4f1cf001zwagsASwlXgmFd","sessionID":"ses_e2b4a2200ffebIrmmKNfkMdQAD","messageID":"msg_1d4d4d949001m7DxGicnJBytBw","type":"tool","id":"call_2703b8def8b54efa92a8bd02","tool":"shell","state":{"status":"completed","input":{"command":"cd /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime; sed -n '1,122p' tests/worktree-restore.vitest.ts; echo \"=== legacy small ===\"; sed -n '1,70p' tests/legacy/advisor-graph-health.vitest.ts; echo \"=== runtime-label-removal head ===\"; sed -n '1,60p' tests/legacy/runtime-label-removal.vitest.ts"},"output":"// ───────────────────────────────────────────────────────────────\n// MODULE: Worktree restore\n// ───────────────────────────────────────────────────────────────\n\n// A turn hands its checkout back to whatever runs next, so these cases pin the\n// three shapes a turn leaves behind: a staged edit, a staged new file and an\n// untracked folder that all have to go back to HEAD, a path that was already\n// dirty before the snapshot and must survive the restore, and a turn that changed\n// nothing at all. The dirty-before case decides whether a restore can run beside\n// another worker's edit, so it is the one that must never regress.\n\nimport { execFileSync } from 'node:child_process';\nimport { existsSync, mkdirSync, mkdtempSync, readFileSync, rmSync, writeFileSync } from 'node:fs';\nimport { tmpdir } from 'node:os';\nimport { join } from 'node:path';\n\nimport { describe, expect, it } from 'vitest';\n\nimport { restoreTurn, statusSnapshot } from '../scripts/routing-accuracy/worktree-restore.mjs';\n\nfunction git(cwd: string, args: string[]): string {\n  return execFileSync('git', ['-c', 'core.fsmonitor=false', ...args], { cwd, encoding: 'utf8' });\n}\n\nfunction makeRepository(): string {\n  const root = mkdtempSync(join(tmpdir(), 'worktree-restore-'));\n  git(root, ['init', '--quiet']);\n  writeFileSync(join(root, 'kept.txt'), 'committed text\\n');\n  git(root, ['add', 'kept.txt']);\n  git(root, [\n    '-c',\n    'user.name=fixture',\n    '-c',\n    'user.email=fixture@example.invalid',\n    'commit',\n    '--quiet',\n    '-m',\n    'fixture',\n  ]);\n  return root;\n}\n\ndescribe('restoreTurn', () => {\n  it('restores a staged edit, a staged new file and an untracked folder to HEAD', () => {\n    const root = makeRepository();\n    try {\n      const before = statusSnapshot(root);\n      writeFileSync(join(root, 'new.txt'), 'new\\n');\n      writeFileSync(join(root, 'kept.txt'), 'turn edit\\n');\n      mkdirSync(join(root, 'out'), { recursive: true });\n      writeFileSync(join(root, 'out/a.txt'), 'out\\n');\n      git(root, ['add', 'new.txt', 'kept.txt']);\n\n      const result = restoreTurn({ cwd: root, before });\n\n      expect(result).toEqual({ restored: true, leftoverPaths: [], failures: [] });\n      expect(statusSnapshot(root).size).toBe(0);\n      expect(readFileSync(join(root, 'kept.txt'), 'utf8')).toBe('committed text\\n');\n      expect(existsSync(join(root, 'new.txt'))).toBe(false);\n      expect(existsSync(join(root, 'out'))).toBe(false);\n    } finally {\n      rmSync(root, { recursive: true, force: true });\n    }\n  });\n\n  it('removes a file the turn created and never staged', () => {\n    const root = makeRepository();\n    try {\n      const before = statusSnapshot(root);\n      writeFileSync(join(root, 'stray.txt'), 'stray\\n');\n\n      const result = restoreTurn({ cwd: root, before });\n\n      expect(result).toEqual({ restored: true, leftoverPaths: [], failures: [] });\n      expect(existsSync(join(root, 'stray.txt'))).toBe(false);\n      expect(statusSnapshot(root).size).toBe(0);\n    } finally {\n      rmSync(root, { recursive: true, force: true });\n    }\n  });\n\n  it('leaves a path that was already dirty before the snapshot in place', () => {\n    const root = makeRepository();\n    try {\n      writeFileSync(join(root, 'note.txt'), 'note\\n');\n      const before = statusSnapshot(root);\n      git(root, ['add', 'note.txt']);\n\n      const result = restoreTurn({ cwd: root, before });\n\n      expect(result.restored).toBe(false);\n      expect(result.leftoverPaths).toEqual(['note.txt']);\n      expect(result.failures).toEqual([]);\n      expect(existsSync(join(root, 'note.txt'))).toBe(true);\n    } finally {\n      rmSync(root, { recursive: true, force: true });\n    }\n  });\n\n  it('reports a turn that changed nothing as restored', () => {\n    const root = makeRepository();\n    try {\n      const before = statusSnapshot(root);\n\n      expect(restoreTurn({ cwd: root, before })).toEqual({\n        restored: true,\n        leftoverPaths: [],\n        failures: [],\n      });\n    } finally {\n      rmSync(root, { recursive: true, force: true });\n    }\n  });\n});\n=== legacy small ===\n// ───────────────────────────────────────────────────────────────\n// MODULE: Advisor Graph Health Tests\n// ───────────────────────────────────────────────────────────────\n\nimport { spawnSync } from 'node:child_process';\nimport { dirname, resolve } from 'node:path';\nimport { fileURLToPath } from 'node:url';\nimport { describe, expect, it } from 'vitest';\nimport { findAdvisorWorkspaceRoot } from '../../lib/utils/workspace-root.js';\n\nconst here = dirname(fileURLToPath(import.meta.url));\nconst repoRoot = findAdvisorWorkspaceRoot(here);\nconst compilerPath = resolve(\n  repoRoot,\n  '.skilled/skills/system-skill-advisor/runtime/scripts/skill_graph_compiler.py',\n);\nconst advisorPath = resolve(\n  repoRoot,\n  '.skilled/skills/system-skill-advisor/runtime/scripts/skill_advisor.py',\n);\n\ndescribe('advisor graph health', () => {\n  it('validates graph metadata without orphan skills', () => {\n    const result = spawnSync('python3', [compilerPath, '--validate-only'], {\n      cwd: repoRoot,\n      encoding: 'utf8',\n    });\n\n    expect(result.status, `${result.stdout}\\n${result.stderr}`).toBe(0);\n    expect(`${result.stdout}\\n${result.stderr}`).not.toContain('ZERO-EDGE WARNINGS');\n    expect(result.stdout).toContain('VALIDATION PASSED');\n  });\n\n  it('keeps health ok when skill-advisor is the only graph-only node', () => {\n    const result = spawnSync('python3', [advisorPath, '--health'], {\n      cwd: repoRoot,\n      encoding: 'utf8',\n      env: {\n        ...process.env,\n        SKILL_ADVISOR_DISABLE_BUILTIN_SEMANTIC: '1',\n      },\n    });\n\n    expect(result.status, `${result.stdout}\\n${result.stderr}`).toBe(0);\n    const jsonStart = result.stdout.indexOf('{');\n    expect(jsonStart).toBeGreaterThanOrEqual(0);\n    const payload = JSON.parse(result.stdout.slice(jsonStart)) as {\n      status: string;\n      inventory_parity: {\n        in_sync: boolean;\n        missing_in_discovery: string[];\n        missing_in_graph: string[];\n        graph_only?: string[];\n        graphless_inline?: string[];\n      };\n    };\n\n    expect(payload.status).toBe('ok');\n    expect(payload.inventory_parity.in_sync).toBe(true);\n    expect(payload.inventory_parity.missing_in_discovery).toEqual([]);\n    expect(payload.inventory_parity.missing_in_graph).toEqual([]);\n    expect(payload.inventory_parity.graph_only).toEqual([]);\n    expect(payload.inventory_parity.graphless_inline).toEqual(['command-speckit-save', 'create:agent', 'create:manual-testing-playbook']);\n  });\n});\n=== runtime-label-removal head ===\n// ───────────────────────────────────────────────────────────────\n// MODULE: Advisor Runtime Label Removal Tests\n// ───────────────────────────────────────────────────────────────\n// A stored record or a tool input that still carries a retired runtime label is\n// dropped by the readers and rejected by the writers, so the label can never be\n// surfaced as a live runtime again.\n\nimport { mkdirSync, mkdtempSync, rmSync, writeFileSync } from 'node:fs';\nimport { tmpdir } from 'node:os';\nimport { dirname, join } from 'node:path';\n\nimport { describe, expect, it } from 'vitest';\n\nimport {\n  advisorHookDiagnosticsPath,\n  advisorHookOutcomesPath,\n  readAdvisorHookDiagnosticRecords,\n  readAdvisorHookOutcomeRecords,\n  serializeAdvisorHookDiagnosticRecord,\n  validateSkillExecutionOutcomeRecord,\n} from '../../lib/metrics.js';\nimport type { AdvisorHookDiagnosticRecord } from '../../lib/metrics.js';\nimport { AdvisorValidateInputSchema } from '../../schemas/advisor-tool-schemas.js';\n\nfunction writeJsonl(path: string, records: readonly unknown[]): void {\n  mkdirSync(dirname(path), { recursive: true });\n  writeFileSync(path, `${records.map((record) => JSON.stringify(record)).join('\\n')}\\n`, 'utf8');\n}\n\nfunction removeMetricsFiles(workspaceRoot: string): void {\n  rmSync(advisorHookDiagnosticsPath(workspaceRoot), { force: true });\n  rmSync(advisorHookOutcomesPath(workspaceRoot), { force: true });\n  rmSync(workspaceRoot, { recursive: true, force: true });\n}\n\ndescribe('advisor runtime label removal', () => {\n  it('drops a stored diagnostic record carrying a retired runtime label', () => {\n    const workspaceRoot = mkdtempSync(join(tmpdir(), 'advisor-runtime-label-'));\n\n    try {\n      writeJsonl(advisorHookDiagnosticsPath(workspaceRoot), [\n        {\n          timestamp: '2026-04-19T10:00:00.000Z',\n          runtime: 'claude',\n          status: 'ok',\n          freshness: 'live',\n          durationMs: 12,\n          cacheHit: true,\n        },\n        {\n          timestamp: '2026-04-19T10:00:01.000Z',\n          runtime: 'copilot',\n          status: 'ok',\n          freshness: 'live',\n          durationMs: 13,\n          cacheHit: false,\n        },\n      ]);\n\n      const records = readAdvisorHookDiagnosticRecords(workspaceRoot);\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"// ───────────────────────────────────────────────────────────────\n// MODULE: Worktree restore\n// ───────────────────────────────────────────────────────────────\n\n// A turn hands its checkout back to whatever runs next, so these cases pin the\n// three shapes a turn leaves behind: a staged edit, a staged new file and an\n// untracked folder that all have to go back to HEAD, a path that was already\n// dirty before the snapshot and must survive the restore, and a turn that changed\n// nothing at all. The dirty-before case decides whether a restore can run beside\n// another worker's edit, so it is the one that must never regress.\n\nimport { execFileSync } from 'node:child_process';\nimport { existsSync, mkdirSync, mkdtempSync, readFileSync, rmSync, writeFileSync } from 'node:fs';\nimport { tmpdir } from 'node:os';\nimport { join } from 'node:path';\n\nimport { describe, expect, it } from 'vitest';\n\nimport { restoreTurn, statusSnapshot } from '../scripts/routing-accuracy/worktree-restore.mjs';\n\nfunction git(cwd: string, args: string[]): string {\n  return execFileSync('git', ['-c', 'core.fsmonitor=false', ...args], { cwd, encoding: 'utf8' });\n}\n\nfunction makeRepository(): string {\n  const root = mkdtempSync(join(tmpdir(), 'worktree-restore-'));\n  git(root, ['init', '--quiet']);\n  writeFileSync(join(root, 'kept.txt'), 'committed text\\n');\n  git(root, ['add', 'kept.txt']);\n  git(root, [\n    '-c',\n    'user.name=fixture',\n    '-c',\n    'user.email=fixture@example.invalid',\n    'commit',\n    '--quiet',\n    '-m',\n    'fixture',\n  ]);\n  return root;\n}\n\ndescribe('restoreTurn', () => {\n  it('restores a staged edit, a staged new file and an untracked folder to HEAD', () => {\n    const root = makeRepository();\n    try {\n      const before = statusSnapshot(root);\n      writeFileSync(join(root, 'new.txt'), 'new\\n');\n      writeFileSync(join(root, 'kept.txt'), 'turn edit\\n');\n      mkdirSync(join(root, 'out'), { recursive: true });\n      writeFileSync(join(root, 'out/a.txt'), 'out\\n');\n      git(root, ['add', 'new.txt', 'kept.txt']);\n\n      const result = restoreTurn({ cwd: root, before });\n\n      expect(result).toEqual({ restored: true, leftoverPaths: [], failures: [] });\n      expect(statusSnapshot(root).size).toBe(0);\n      expect(readFileSync(join(root, 'kept.txt'), 'utf8')).toBe('committed text\\n');\n      expect(existsSync(join(root, 'new.txt'))).toBe(false);\n      expect(existsSync(join(root, 'out'))).toBe(false);\n    } finally {\n      rmSync(root, { recursive: true, force: true });\n    }\n  });\n\n  it('removes a file the turn created and never staged', () => {\n    const root = makeRepository();\n    try {\n      const before = statusSnapshot(root);\n      writeFileSync(join(root, 'stray.txt'), 'stray\\n');\n\n      const result = restoreTurn({ cwd: root, before });\n\n      expect(result).toEqual({ restored: true, leftoverPaths: [], failures: [] });\n      expect(existsSync(join(root, 'stray.txt'))).toBe(false);\n      expect(statusSnapshot(root).size).toBe(0);\n    } finally {\n      rmSync(root, { recursive: true, force: true });\n    }\n  });\n\n  it('leaves a path that was already dirty before the snapshot in place', () => {\n    const root = makeRepository();\n    try {\n      writeFileSync(join(root, 'note.txt'), 'note\\n');\n      const before = statusSnapshot(root);\n      git(root, ['add', 'note.txt']);\n\n      const result = restoreTurn({ cwd: root, before });\n\n      expect(result.restored).toBe(false);\n      expect(result.leftoverPaths).toEqual(['note.txt']);\n      expect(result.failures).toEqual([]);\n      expect(existsSync(join(root, 'note.txt'))).toBe(true);\n    } finally {\n      rmSync(root, { recursive: true, force: true });\n    }\n  });\n\n  it('reports a turn that changed nothing as restored', () => {\n    const root = makeRepository();\n    try {\n      const before = statusSnapshot(root);\n\n      expect(restoreTurn({ cwd: root, before })).toEqual({\n        restored: true,\n        leftoverPaths: [],\n        failures: [],\n      });\n    } finally {\n      rmSync(root, { recursive: true, force: true });\n    }\n  });\n});\n=== legacy small ===\n// ───────────────────────────────────────────────────────────────\n// MODULE: Advisor Graph Health Tests\n// ───────────────────────────────────────────────────────────────\n\nimport { spawnSync } from 'node:child_process';\nimport { dirname, resolve } from 'node:path';\nimport { fileURLToPath } from 'node:url';\nimport { describe, expect, it } from 'vitest';\nimport { findAdvisorWorkspaceRoot } from '../../lib/utils/workspace-root.js';\n\nconst here = dirname(fileURLToPath(import.meta.url));\nconst repoRoot = findAdvisorWorkspaceRoot(here);\nconst compilerPath = resolve(\n  repoRoot,\n  '.skilled/skills/system-skill-advisor/runtime/scripts/skill_graph_compiler.py',\n);\nconst advisorPath = resolve(\n  repoRoot,\n  '.skilled/skills/system-skill-advisor/runtime/scripts/skill_advisor.py',\n);\n\ndescribe('advisor graph health', () => {\n  it('validates graph metadata without orphan skills', () => {\n    const result = spawnSync('python3', [compilerPath, '--validate-only'], {\n      cwd: repoRoot,\n      encoding: 'utf8',\n    });\n\n    expect(result.status, `${result.stdout}\\n${result.stderr}`).toBe(0);\n    expect(`${result.stdout}\\n${result.stderr}`).not.toContain('ZERO-EDGE WARNINGS');\n    expect(result.stdout).toContain('VALIDATION PASSED');\n  });\n\n  it('keeps health ok when skill-advisor is the only graph-only node', () => {\n    const result = spawnSync('python3', [advisorPath, '--health'], {\n      cwd: repoRoot,\n      encoding: 'utf8',\n      env: {\n        ...process.env,\n        SKILL_ADVISOR_DISABLE_BUILTIN_SEMANTIC: '1',\n      },\n    });\n\n    expect(result.status, `${result.stdout}\\n${result.stderr}`).toBe(0);\n    const jsonStart = result.stdout.indexOf('{');\n    expect(jsonStart).toBeGreaterThanOrEqual(0);\n    const payload = JSON.parse(result.stdout.slice(jsonStart)) as {\n      status: string;\n      inventory_parity: {\n        in_sync: boolean;\n        missing_in_discovery: string[];\n        missing_in_graph: string[];\n        graph_only?: string[];\n        graphless_inline?: string[];\n      };\n    };\n\n    expect(payload.status).toBe('ok');\n    expect(payload.inventory_parity.in_sync).toBe(true);\n    expect(payload.inventory_parity.missing_in_discovery).toEqual([]);\n    expect(payload.inventory_parity.missing_in_graph).toEqual([]);\n    expect(payload.inventory_parity.graph_only).toEqual([]);\n    expect(payload.inventory_parity.graphless_inline).toEqual(['command-speckit-save', 'create:agent', 'create:manual-testing-playbook']);\n  });\n});\n=== runtime-label-removal head ===\n// ───────────────────────────────────────────────────────────────\n// MODULE: Advisor Runtime Label Removal Tests\n// ───────────────────────────────────────────────────────────────\n// A stored record or a tool input that still carries a retired runtime label is\n// dropped by the readers and rejected by the writers, so the label can never be\n// surfaced as a live runtime again.\n\nimport { mkdirSync, mkdtempSync, rmSync, writeFileSync } from 'node:fs';\nimport { tmpdir } from 'node:os';\nimport { dirname, join } from 'node:path';\n\nimport { describe, expect, it } from 'vitest';\n\nimport {\n  advisorHookDiagnosticsPath,\n  advisorHookOutcomesPath,\n  readAdvisorHookDiagnosticRecords,\n  readAdvisorHookOutcomeRecords,\n  serializeAdvisorHookDiagnosticRecord,\n  validateSkillExecutionOutcomeRecord,\n} from '../../lib/metrics.js';\nimport type { AdvisorHookDiagnosticRecord } from '../../lib/metrics.js';\nimport { AdvisorValidateInputSchema } from '../../schemas/advisor-tool-schemas.js';\n\nfunction writeJsonl(path: string, records: readonly unknown[]): void {\n  mkdirSync(dirname(path), { recursive: true });\n  writeFileSync(path, `${records.map((record) => JSON.stringify(record)).join('\\n')}\\n`, 'utf8');\n}\n\nfunction removeMetricsFiles(workspaceRoot: string): void {\n  rmSync(advisorHookDiagnosticsPath(workspaceRoot), { force: true });\n  rmSync(advisorHookOutcomesPath(workspaceRoot), { force: true });\n  rmSync(workspaceRoot, { recursive: true, force: true });\n}\n\ndescribe('advisor runtime label removal', () => {\n  it('drops a stored diagnostic record carrying a retired runtime label', () => {\n    const workspaceRoot = mkdtempSync(join(tmpdir(), 'advisor-runtime-label-'));\n\n    try {\n      writeJsonl(advisorHookDiagnosticsPath(workspaceRoot), [\n        {\n          timestamp: '2026-04-19T10:00:00.000Z',\n          runtime: 'claude',\n          status: 'ok',\n          freshness: 'live',\n          durationMs: 12,\n          cacheHit: true,\n        },\n        {\n          timestamp: '2026-04-19T10:00:01.000Z',\n          runtime: 'copilot',\n          status: 'ok',\n          freshness: 'live',\n          durationMs: 13,\n          cacheHit: false,\n        },\n      ]);\n\n      const records = readAdvisorHookDiagnosticRecords(workspaceRoot);\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"cd /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime; sed -n '1,122p' tests/worktree-restore.vitest.ts; echo \\\"=== legacy small ===\\\"; sed -n '1,70p' tests/legacy/advisor-graph-health.vitest.ts; echo \\\"=== runtime-label-removal head ===\\\"; sed -n '1,60p' tests/legacy/runtime-label-removal.vitest.ts\"}"},"time":{"start":1794572087759,"end":1794572088743}}}}
{"type":"step_finish","timestamp":1794572089989,"sessionID":"ses_e2b4a2200ffebIrmmKNfkMdQAD","part":{"id":"prt_1d4d4fa85001jZ5EbDo2SNmGTB","sessionID":"ses_e2b4a2200ffebIrmmKNfkMdQAD","messageID":"msg_1d4d4d949001m7DxGicnJBytBw","type":"step-finish","reason":"tool-calls","cost":0,"tokens":{"input":381,"output":158,"reasoning":433,"cache":{"read":343040,"write":0}}}}
{"type":"step_start","timestamp":1794572094057,"sessionID":"ses_e2b4a2200ffebIrmmKNfkMdQAD","part":{"id":"prt_1d4d50a690016PPkGjPT2EvUsY","sessionID":"ses_e2b4a2200ffebIrmmKNfkMdQAD","messageID":"msg_1d4d4fa8f001zOnPcvyKbeb7SI","type":"step-start"}}
{"type":"tool_use","timestamp":1794572096969,"sessionID":"ses_e2b4a2200ffebIrmmKNfkMdQAD","part":{"partID":"prt_1d4d5102b001VTzMI0Z7YYxXtq","sessionID":"ses_e2b4a2200ffebIrmmKNfkMdQAD","messageID":"msg_1d4d4fa8f001zOnPcvyKbeb7SI","type":"tool","id":"call_f033d983ccf142369cd026ec","tool":"shell","state":{"status":"completed","input":{"command":"cd /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime; sed -n '1,69p' tests/legacy/advisor-prompt-policy.vitest.ts; echo \"=== fixtures counts ===\"; node -e 'const fs=require(\"fs\");for(const f of [\"scripts/fixtures/gate2-golden-prompts.jsonl\",\"scripts/fixtures/skill-advisor-regression-cases.jsonl\"]){const rows=fs.readFileSync(f,\"utf8\").trim().split(\"\\n\").map(JSON.parse);const ids=new Set();let d=0;for(const r of rows){if(ids.has(r.id))d++;ids.add(r.id)}console.log(f,rows.length,\"unique\",ids.size,\"dups\",d,\"keys\",Object.keys(rows[0]).join(\",\"))}'"},"output":"// ───────────────────────────────────────────────────────────────\n// MODULE: Advisor Prompt Policy Tests\n// ───────────────────────────────────────────────────────────────\n\nimport { describe, expect, it } from 'vitest';\nimport {\n  extractMetalinguisticSkillMentions,\n  shouldFireAdvisor,\n} from '../../lib/prompt-policy.js';\n\ndescribe('skill advisor prompt policy', () => {\n  it('skips empty, whitespace, and exact navigation commands', () => {\n    expect(shouldFireAdvisor('').fire).toBe(false);\n    expect(shouldFireAdvisor('   ').reason).toBe('empty_prompt');\n    expect(shouldFireAdvisor('/help').reason).toBe('skip_command');\n    expect(shouldFireAdvisor(' /CLEAR ').reason).toBe('skip_command');\n  });\n\n  it('skips short casual acknowledgements with no work intent', () => {\n    expect(shouldFireAdvisor('ok')).toMatchObject({\n      fire: false,\n      reason: 'short_casual_acknowledgement',\n    });\n    expect(shouldFireAdvisor('thanks').fire).toBe(false);\n    expect(shouldFireAdvisor('hi').fire).toBe(false);\n  });\n\n  it('fires for explicit skill, command, and governance markers', () => {\n    expect(shouldFireAdvisor('use sk-code here')).toMatchObject({\n      fire: true,\n      reason: 'explicit_skill_or_governance_marker',\n    });\n    // A skill outside the sk- family is named just as explicitly, and a short prompt must not skip it.\n    for (const name of ['system-deep-loop', 'cli-orca', 'mcp-tooling']) {\n      expect(shouldFireAdvisor(`use the ${name} skill`)).toMatchObject({\n        fire: true,\n        reason: 'explicit_skill_or_governance_marker',\n        metalinguisticMentions: [name],\n      });\n    }\n    // A bare family word without a name after the hyphen is not a skill mention.\n    expect(shouldFireAdvisor('fix the system').fire).toBe(false);\n    expect(shouldFireAdvisor('/speckit:resume now').fire).toBe(true);\n    expect(shouldFireAdvisor('spec kit packet alignment').fire).toBe(true);\n  });\n\n  it('fires for work-intent verbs with at least three meaningful tokens', () => {\n    expect(shouldFireAdvisor('implement feature X')).toMatchObject({\n      fire: true,\n      reason: 'work_intent_with_meaningful_tokens',\n    });\n  });\n\n  it('fires for length plus meaningful-token thresholds', () => {\n    expect(shouldFireAdvisor('please examine routing behavior today').reason).toBe('length_and_token_threshold');\n    expect(shouldFireAdvisor('This prompt has enough visible detail to deserve advisor routing even without a leading verb.').fire)\n      .toBe(true);\n  });\n\n  it('canonical-folds Unicode before classification and extracts metalinguistic skill names', () => {\n    const prompt = 'explain sk-git skill with hidden\\u200bspace';\n    const result = shouldFireAdvisor(prompt);\n\n    expect(result.fire).toBe(true);\n    expect(result.canonicalPrompt).not.toContain('\\u200b');\n    expect(result.metalinguisticMentions).toEqual(['sk-git']);\n    expect(extractMetalinguisticSkillMentions(prompt)).toEqual(['sk-git']);\n  });\n});\n=== fixtures counts ===\nscripts/fixtures/gate2-golden-prompts.jsonl 37 unique 37 dups 0 keys _schema\nscripts/fixtures/skill-advisor-regression-cases.jsonl 42 unique 42 dups 0 keys id,priority,prompt,confidence_only,expect_result,expected_top_any,expect_kind,allow_command_bridge\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"// ───────────────────────────────────────────────────────────────\n// MODULE: Advisor Prompt Policy Tests\n// ───────────────────────────────────────────────────────────────\n\nimport { describe, expect, it } from 'vitest';\nimport {\n  extractMetalinguisticSkillMentions,\n  shouldFireAdvisor,\n} from '../../lib/prompt-policy.js';\n\ndescribe('skill advisor prompt policy', () => {\n  it('skips empty, whitespace, and exact navigation commands', () => {\n    expect(shouldFireAdvisor('').fire).toBe(false);\n    expect(shouldFireAdvisor('   ').reason).toBe('empty_prompt');\n    expect(shouldFireAdvisor('/help').reason).toBe('skip_command');\n    expect(shouldFireAdvisor(' /CLEAR ').reason).toBe('skip_command');\n  });\n\n  it('skips short casual acknowledgements with no work intent', () => {\n    expect(shouldFireAdvisor('ok')).toMatchObject({\n      fire: false,\n      reason: 'short_casual_acknowledgement',\n    });\n    expect(shouldFireAdvisor('thanks').fire).toBe(false);\n    expect(shouldFireAdvisor('hi').fire).toBe(false);\n  });\n\n  it('fires for explicit skill, command, and governance markers', () => {\n    expect(shouldFireAdvisor('use sk-code here')).toMatchObject({\n      fire: true,\n      reason: 'explicit_skill_or_governance_marker',\n    });\n    // A skill outside the sk- family is named just as explicitly, and a short prompt must not skip it.\n    for (const name of ['system-deep-loop', 'cli-orca', 'mcp-tooling']) {\n      expect(shouldFireAdvisor(`use the ${name} skill`)).toMatchObject({\n        fire: true,\n        reason: 'explicit_skill_or_governance_marker',\n        metalinguisticMentions: [name],\n      });\n    }\n    // A bare family word without a name after the hyphen is not a skill mention.\n    expect(shouldFireAdvisor('fix the system').fire).toBe(false);\n    expect(shouldFireAdvisor('/speckit:resume now').fire).toBe(true);\n    expect(shouldFireAdvisor('spec kit packet alignment').fire).toBe(true);\n  });\n\n  it('fires for work-intent verbs with at least three meaningful tokens', () => {\n    expect(shouldFireAdvisor('implement feature X')).toMatchObject({\n      fire: true,\n      reason: 'work_intent_with_meaningful_tokens',\n    });\n  });\n\n  it('fires for length plus meaningful-token thresholds', () => {\n    expect(shouldFireAdvisor('please examine routing behavior today').reason).toBe('length_and_token_threshold');\n    expect(shouldFireAdvisor('This prompt has enough visible detail to deserve advisor routing even without a leading verb.').fire)\n      .toBe(true);\n  });\n\n  it('canonical-folds Unicode before classification and extracts metalinguistic skill names', () => {\n    const prompt = 'explain sk-git skill with hidden\\u200bspace';\n    const result = shouldFireAdvisor(prompt);\n\n    expect(result.fire).toBe(true);\n    expect(result.canonicalPrompt).not.toContain('\\u200b');\n    expect(result.metalinguisticMentions).toEqual(['sk-git']);\n    expect(extractMetalinguisticSkillMentions(prompt)).toEqual(['sk-git']);\n  });\n});\n=== fixtures counts ===\nscripts/fixtures/gate2-golden-prompts.jsonl 37 unique 37 dups 0 keys _schema\nscripts/fixtures/skill-advisor-regression-cases.jsonl 42 unique 42 dups 0 keys id,priority,prompt,confidence_only,expect_result,expected_top_any,expect_kind,allow_command_bridge\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"cd /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime; sed -n '1,69p' tests/legacy/advisor-prompt-policy.vitest.ts; echo \\\"=== fixtures counts ===\\\"; node -e 'const fs=require(\\\"fs\\\");for(const f of [\\\"scripts/fixtures/gate2-golden-prompts.jsonl\\\",\\\"scripts/fixtures/skill-advisor-regression-cases.jsonl\\\"]){const rows=fs.readFileSync(f,\\\"utf8\\\").trim().split(\\\"\\\\n\\\").map(JSON.parse);const ids=new Set();let d=0;for(const r of rows){if(ids.has(r.id))d++;ids.add(r.id)}console.log(f,rows.length,\\\"unique\\\",ids.size,\\\"dups\\\",d,\\\"keys\\\",Object.keys(rows[0]).join(\\\",\\\"))}'\"}"},"time":{"start":1794572095531,"end":1794572096969}}}}
