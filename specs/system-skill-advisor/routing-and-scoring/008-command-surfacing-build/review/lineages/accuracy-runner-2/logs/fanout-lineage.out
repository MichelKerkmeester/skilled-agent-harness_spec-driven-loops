{"type":"tool_use","timestamp":1794570654022,"sessionID":"ses_e2b4a2200ffebIrmmKNfkMdQAD","part":{"partID":"prt_1d4bf0fb8001Wubv87vOed9AaJ","sessionID":"ses_e2b4a2200ffebIrmmKNfkMdQAD","messageID":"msg_1d4bef356001p7uX51nPd001B4","type":"tool","id":"call_63f0fd9ba9044f91af94757d","tool":"read","state":{"status":"completed","input":{"limit":345,"path":".skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/prepare-behaviour-arena.mjs"},"output":"Read file .skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/prepare-behaviour-arena.mjs, lines 1-343\n1: // ───────────────────────────────────────────────────────────────\n2: // MODULE: Behaviour Arena Builder\n3: // ───────────────────────────────────────────────────────────────\n4: //\n5: // A live turn has to run where it cannot reach anything outside its own\n6: // checkout, and where the advisor it measures is built the way a user gets it.\n7: // A clone of the branch tip in a directory git does not own gives both. The\n8: // clone has no remote to push to and no outer repository whose hooks or\n9: // credentials it could borrow, and its tracked tree is exactly the commit under\n10: // test, so a per-turn restore has a clean baseline to put back.\n11: //\n12: // A clone also leaves out every ignored build output. The advisor under test\n13: // runs from compiled JavaScript and its SQLite skill graph, so those trees are\n14: // copied in afterwards. Building them inside the clone instead would measure a\n15: // bundle nobody reviewed, and would need the network while an arena is meant to\n16: // be offline.\n17: //\n18: // A copy also has to look like a build. The freshness guard each CLI shim runs\n19: // falls back to comparing the newest watched source against the build's own\n20: // timestamp, and a checkout stamps every source with the clone time while the\n21: // copied build keeps the moment it was compiled. Left alone, that order says\n22: // every copied package is stale and every shim exits before running. The copied\n23: // build is the same commit's build, so its timestamp is set to the copy time,\n24: // which is what a build in this checkout would carry.\n25: //\n26: // Nothing is copied before the destination is checked. A destination inside a\n27: // repository would inherit that repository's hooks and ignore rules, and a\n28: // destination that already exists may hold another arm's log, so both are\n29: // refused rather than merged into.\n30: //\n31: // The copy reads the source worktree, so the one thing it must never carry\n32: // across is a dotenv file. A model reads and writes an arena, so a secret that\n33: // followed the build output in would sit where a run can print it. Every file\n34: // whose name begins with `.env` is skipped while copying, at every depth.\n35: //\n36: // Usage:\n37: //   node prepare-behaviour-arena.mjs --source <repo root> --dest <dir>\n38: \n39: // ───────────────────────────────────────────────────────────────\n40: // 1. IMPORTS\n41: // ───────────────────────────────────────────────────────────────\n42: \n43: import { existsSync, lstatSync, lutimesSync, mkdirSync, readdirSync, rmSync, utimesSync, writeFileSync } from 'node:fs';\n44: import { spawnSync } from 'node:child_process';\n45: import { basename, dirname, join, resolve } from 'node:path';\n46: import { fileURLToPath } from 'node:url';\n47: \n48: // ───────────────────────────────────────────────────────────────\n49: // 2. CONSTANTS\n50: // ───────────────────────────────────────────────────────────────\n51: \n52: const SCRIPT_NAME = basename(fileURLToPath(import.meta.url));\n53: const EXIT_REFUSED = 2;\n54: \n55: const USAGE = `usage: node ${SCRIPT_NAME} --source <repo root> --dest <dir>`;\n56: \n57: // A filesystem monitor that decides a path is unchanged makes the clone and the\n58: // clean-tree check disagree about what the checkout holds.\n59: const GIT_PREFIX = ['-c', 'core.fsmonitor=false'];\n60: \n61: const MARK = 'skilled-behaviour-arena';\n62: \n63: // The two ignored trees a build writes and a clone never carries.\n64: const BUILD_DIR_NAMES = new Set(['dist', 'node_modules']);\n65: \n66: const SQLITE_SUFFIX = '.sqlite';\n67: const SKILLED_PREFIX = '.skilled/';\n68: const DOTENV_PATTERN = /^\\.env/;\n69: \n70: // ───────────────────────────────────────────────────────────────\n71: // 3. FAILURE SHAPES\n72: // ───────────────────────────────────────────────────────────────\n73: \n74: // A refusal is a precondition the caller can act on, so it carries a code on\n75: // stdout. A step failure leaves no usable arena behind, so it reports the code\n76: // and the failing command on stderr instead.\n77: class StepFailure extends Error {\n78:   constructor(code, detail) {\n79:     super(detail === '' ? code : `${code}: ${detail}`);\n80:     this.code = code;\n81:   }\n82: }\n83: \n84: function writeJson(value) {\n85:   process.stdout.write(`${JSON.stringify(value)}\\n`);\n86: }\n87: \n88: function refuse(code, extra = {}) {\n89:   writeJson({ ok: false, code, ...extra });\n90:   process.exit(EXIT_REFUSED);\n91: }\n92: \n93: function abort(code, detail = '') {\n94:   process.stderr.write(`${SCRIPT_NAME}: ${detail === '' ? code : `${code}: ${detail}`}\\n`);\n95:   writeJson({ ok: false, code });\n96:   process.exit(1);\n97: }\n98: \n99: // ───────────────────────────────────────────────────────────────\n100: // 4. ARGUMENT PARSING\n101: // ───────────────────────────────────────────────────────────────\n102: \n103: function valueAfter(argv, index, flag) {\n104:   const value = argv[index];\n105:   if (value === undefined || value.startsWith('--')) {\n106:     process.stderr.write(`${SCRIPT_NAME}: ${flag} needs a value\\n${USAGE}\\n`);\n107:     process.exit(EXIT_REFUSED);\n108:   }\n109:   return value;\n110: }\n111: \n112: function parseOptions(argv) {\n113:   const options = { source: null, dest: null };\n114:   for (let index = 0; index < argv.length; index += 1) {\n115:     const token = argv[index];\n116:     if (token === '--source') {\n117:       index += 1;\n118:       options.source = valueAfter(argv, index, '--source');\n119:     } else if (token === '--dest') {\n120:       index += 1;\n121:       options.dest = valueAfter(argv, index, '--dest');\n122:     } else {\n123:       process.stderr.write(`${SCRIPT_NAME}: unknown option: ${token}\\n${USAGE}\\n`);\n124:       process.exit(EXIT_REFUSED);\n125:     }\n126:   }\n127:   if (options.source === null || options.dest === null) {\n128:     process.stderr.write(`${SCRIPT_NAME}: --source and --dest are required\\n${USAGE}\\n`);\n129:     process.exit(EXIT_REFUSED);\n130:   }\n131:   return options;\n132: }\n133: \n134: // ───────────────────────────────────────────────────────────────\n135: // 5. GIT HELPERS\n136: // ───────────────────────────────────────────────────────────────\n137: \n138: function git(args, cwd) {\n139:   const result = spawnSync('git', [...GIT_PREFIX, ...args], { cwd, encoding: 'utf8' });\n140:   if (result.error) throw new StepFailure('spawn_failed', result.error.message);\n141:   return result;\n142: }\n143: \n144: function gitText(args, cwd, code) {\n145:   const result = git(args, cwd);\n146:   if (result.status !== 0) throw new StepFailure(code, (result.stderr ?? '').trim());\n147:   return result.stdout;\n148: }\n149: \n150: function headOf(cwd, code) {\n151:   const head = gitText(['rev-parse', 'HEAD'], cwd, code).trim();\n152:   if (head === '') throw new StepFailure(code, `no HEAD in ${cwd}`);\n153:   return head;\n154: }\n155: \n156: // Whether git would leave a path out of a checkout decides whether a clone\n157: // already holds it, so ignore rules are asked rather than guessed from a name.\n158: function isIgnored(cwd, relPath) {\n159:   return git(['check-ignore', '-q', '--', relPath], cwd).status === 0;\n160: }\n161: \n162: // ───────────────────────────────────────────────────────────────\n163: // 6. DESTINATION CHECKS\n164: // ───────────────────────────────────────────────────────────────\n165: \n166: function pathExists(path) {\n167:   try {\n168:     lstatSync(path);\n169:     return true;\n170:   } catch {\n171:     return false;\n172:   }\n173: }\n174: \n175: function nearestExistingAncestor(path) {\n176:   let current = path;\n177:   while (!existsSync(current) && dirname(current) !== current) current = dirname(current);\n178:   return current;\n179: }\n180: \n181: function isInsideRepository(path) {\n182:   return git(['rev-parse', '--show-toplevel'], path).status === 0;\n183: }\n184: \n185: // ───────────────────────────────────────────────────────────────\n186: // 7. COPY PLAN\n187: // ───────────────────────────────────────────────────────────────\n188: \n189: // One walk of the source decides what a clone is missing. A build directory is\n190: // recorded and not descended into, so anything inside it travels with the tree.\n191: // The SQLite files searched for sit under the tooling root only, because that is\n192: // where the advisor keeps its graph.\n193: function copyPlan(source) {\n194:   const trees = [];\n195:   const sqlite = [];\n196:   const walk = (relPath) => {\n197:     const absPath = relPath === '' ? source : join(source, relPath);\n198:     for (const entry of readdirSync(absPath, { withFileTypes: true })) {\n199:       if (entry.name === '.git') continue;\n200:       const childRel = relPath === '' ? entry.name : `${relPath}/${entry.name}`;\n201:       if (entry.isDirectory()) {\n202:         if (BUILD_DIR_NAMES.has(entry.name)) {\n203:           trees.push(childRel);\n204:           continue;\n205:         }\n206:         walk(childRel);\n207:         continue;\n208:       }\n209:       if (entry.isFile() && entry.name.endsWith(SQLITE_SUFFIX) && childRel.startsWith(SKILLED_PREFIX)) {\n210:         sqlite.push(childRel);\n211:       }\n212:     }\n213:   };\n214:   walk('');\n215:   return [...trees, ...sqlite].filter((relPath) => isIgnored(source, relPath)).sort();\n216: }\n217: \n218: function holdsDotenv(dirPath) {\n219:   for (const entry of readdirSync(dirPath, { withFileTypes: true })) {\n220:     if (DOTENV_PATTERN.test(entry.name)) return true;\n221:     if (entry.isDirectory() && holdsDotenv(join(dirPath, entry.name))) return true;\n222:   }\n223:   return false;\n224: }\n225: \n226: function runCp(sourcePath, destParent) {\n227:   const result = spawnSync('cp', ['-Rc', sourcePath, destParent], { encoding: 'utf8' });\n228:   if (result.error) throw new StepFailure('copy_failed', `${sourcePath}: ${result.error.message}`);\n229:   if (result.status !== 0) throw new StepFailure('copy_failed', `${sourcePath}: ${(result.stderr ?? '').trim()}`);\n230: }\n231: \n232: // A symlink is stamped through the link itself, because its target may live\n233: // outside the arena and is not this copy's to change.\n234: function stampPath(path, time) {\n235:   if (lstatSync(path).isSymbolicLink()) {\n236:     lutimesSync(path, time, time);\n237:     return;\n238:   }\n239:   utimesSync(path, time, time);\n240: }\n241: \n242: // Only a build tree is stamped. The guard reads the timestamp of a dist entry,\n243: // and neither a dependency tree nor a database file is watched.\n244: function stampBuildTree(path) {\n245:   const time = new Date();\n246:   for (const entry of readdirSync(path, { withFileTypes: true })) {\n247:     const child = join(path, entry.name);\n248:     if (entry.isDirectory()) stampBuildTree(child);\n249:     else stampPath(child, time);\n250:   }\n251:   stampPath(path, time);\n252: }\n253: \n254: // The clonefile flag keeps the copy cheap on the same volume, and the walk only\n255: // happens where a dotenv file is actually present, so the common tree is one\n256: // `cp` call rather than one call per file.\n257: function copyPath(sourcePath, destPath) {\n258:   const isDirectory = lstatSync(sourcePath).isDirectory();\n259:   if (!isDirectory || !holdsDotenv(sourcePath)) {\n260:     mkdirSync(dirname(destPath), { recursive: true });\n261:     runCp(sourcePath, dirname(destPath));\n262:     return;\n263:   }\n264:   mkdirSync(destPath, { recursive: true });\n265:   for (const entry of readdirSync(sourcePath, { withFileTypes: true })) {\n266:     if (DOTENV_PATTERN.test(entry.name)) continue;\n267:     copyPath(join(sourcePath, entry.name), join(destPath, entry.name));\n268:   }\n269: }\n270: \n271: // ───────────────────────────────────────────────────────────────\n272: // 8. ARENA BUILD\n273: // ───────────────────────────────────────────────────────────────\n274: \n275: function cloneInto(source, dest) {\n276:   const result = git(['clone', '--no-hardlinks', source, dest], process.cwd());\n277:   if (result.status !== 0) throw new StepFailure('clone_failed', (result.stderr ?? '').trim());\n278: }\n279: \n280: function checkoutDetached(dest, head) {\n281:   const result = git(['checkout', '--quiet', '--detach', head], dest);\n282:   if (result.status !== 0) throw new StepFailure('checkout_failed', (result.stderr ?? '').trim());\n283: }\n284: \n285: // A remote is the one piece of git state a turn could use to reach outside the\n286: // checkout, so every one the clone inherits is removed rather than left dormant.\n287: function removeRemotes(dest) {\n288:   const names = gitText(['remote'], dest, 'remote_unreadable')\n289:     .split('\\n')\n290:     .map((name) => name.trim())\n291:     .filter((name) => name !== '');\n292:   for (const name of names) gitText(['remote', 'remove', name], dest, 'remote_unreadable');\n293: }\n294: \n295: function assertHead(dest, head) {\n296:   const cloned = gitText(['rev-parse', 'HEAD'], dest, 'head_unreadable').trim();\n297:   if (cloned !== head) throw new StepFailure('head_mismatch', `expected ${head}, got ${cloned}`);\n298: }\n299: \n300: function buildArena(source, dest, head) {\n301:   cloneInto(source, dest);\n302:   checkoutDetached(dest, head);\n303:   removeRemotes(dest);\n304:   const copied = copyPlan(source);\n305:   for (const relPath of copied) {\n306:     const destPath = join(dest, relPath);\n307:     copyPath(join(source, relPath), destPath);\n308:     if (basename(relPath) === 'dist') stampBuildTree(destPath);\n309:   }\n310:   assertHead(dest, head);\n311:   // The runner refuses a live arm in a checkout without this file, because only a\n312:   // checkout built here has no remote, no outer repository and no dotenv file in\n313:   // its copied build trees.\n314:   writeFileSync(join(dest, '.git', MARK), `${head}\\n`);\n315:   return copied;\n316: }\n317: \n318: // ───────────────────────────────────────────────────────────────\n319: // 9. ENTRY POINT\n320: // ───────────────────────────────────────────────────────────────\n321: \n322: function main(argv) {\n323:   const options = parseOptions(argv);\n324:   const source = resolve(options.source);\n325:   const dest = resolve(options.dest);\n326:   const head = headOf(source, 'source_not_repo');\n327: \n328:   if (pathExists(dest)) refuse('dest_exists', { dest });\n329:   if (isInsideRepository(nearestExistingAncestor(dirname(dest)))) refuse('dest_in_repo', { dest });\n330: \n331:   mkdirSync(dirname(dest), { recursive: true });\n332:   try {\n333:     const copied = buildArena(source, dest, head);\n334:     writeJson({ ok: true, dest, head, copied });\n335:   } catch (error) {\n336:     // A half-built arena would answer the next call with `dest_exists` while\n337:     // holding a checkout nobody finished, so the failed attempt removes itself.\n338:     rmSync(dest, { recursive: true, force: true });\n339:     abort(error.code ?? 'arena_failed', error.message);\n340:   }\n341: }\n342: \n343: main(process.argv.slice(2));","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file .skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/prepare-behaviour-arena.mjs, lines 1-343\n1: // ───────────────────────────────────────────────────────────────\n2: // MODULE: Behaviour Arena Builder\n3: // ───────────────────────────────────────────────────────────────\n4: //\n5: // A live turn has to run where it cannot reach anything outside its own\n6: // checkout, and where the advisor it measures is built the way a user gets it.\n7: // A clone of the branch tip in a directory git does not own gives both. The\n8: // clone has no remote to push to and no outer repository whose hooks or\n9: // credentials it could borrow, and its tracked tree is exactly the commit under\n10: // test, so a per-turn restore has a clean baseline to put back.\n11: //\n12: // A clone also leaves out every ignored build output. The advisor under test\n13: // runs from compiled JavaScript and its SQLite skill graph, so those trees are\n14: // copied in afterwards. Building them inside the clone instead would measure a\n15: // bundle nobody reviewed, and would need the network while an arena is meant to\n16: // be offline.\n17: //\n18: // A copy also has to look like a build. The freshness guard each CLI shim runs\n19: // falls back to comparing the newest watched source against the build's own\n20: // timestamp, and a checkout stamps every source with the clone time while the\n21: // copied build keeps the moment it was compiled. Left alone, that order says\n22: // every copied package is stale and every shim exits before running. The copied\n23: // build is the same commit's build, so its timestamp is set to the copy time,\n24: // which is what a build in this checkout would carry.\n25: //\n26: // Nothing is copied before the destination is checked. A destination inside a\n27: // repository would inherit that repository's hooks and ignore rules, and a\n28: // destination that already exists may hold another arm's log, so both are\n29: // refused rather than merged into.\n30: //\n31: // The copy reads the source worktree, so the one thing it must never carry\n32: // across is a dotenv file. A model reads and writes an arena, so a secret that\n33: // followed the build output in would sit where a run can print it. Every file\n34: // whose name begins with `.env` is skipped while copying, at every depth.\n35: //\n36: // Usage:\n37: //   node prepare-behaviour-arena.mjs --source <repo root> --dest <dir>\n38: \n39: // ───────────────────────────────────────────────────────────────\n40: // 1. IMPORTS\n41: // ───────────────────────────────────────────────────────────────\n42: \n43: import { existsSync, lstatSync, lutimesSync, mkdirSync, readdirSync, rmSync, utimesSync, writeFileSync } from 'node:fs';\n44: import { spawnSync } from 'node:child_process';\n45: import { basename, dirname, join, resolve } from 'node:path';\n46: import { fileURLToPath } from 'node:url';\n47: \n48: // ───────────────────────────────────────────────────────────────\n49: // 2. CONSTANTS\n50: // ───────────────────────────────────────────────────────────────\n51: \n52: const SCRIPT_NAME = basename(fileURLToPath(import.meta.url));\n53: const EXIT_REFUSED = 2;\n54: \n55: const USAGE = `usage: node ${SCRIPT_NAME} --source <repo root> --dest <dir>`;\n56: \n57: // A filesystem monitor that decides a path is unchanged makes the clone and the\n58: // clean-tree check disagree about what the checkout holds.\n59: const GIT_PREFIX = ['-c', 'core.fsmonitor=false'];\n60: \n61: const MARK = 'skilled-behaviour-arena';\n62: \n63: // The two ignored trees a build writes and a clone never carries.\n64: const BUILD_DIR_NAMES = new Set(['dist', 'node_modules']);\n65: \n66: const SQLITE_SUFFIX = '.sqlite';\n67: const SKILLED_PREFIX = '.skilled/';\n68: const DOTENV_PATTERN = /^\\.env/;\n69: \n70: // ───────────────────────────────────────────────────────────────\n71: // 3. FAILURE SHAPES\n72: // ───────────────────────────────────────────────────────────────\n73: \n74: // A refusal is a precondition the caller can act on, so it carries a code on\n75: // stdout. A step failure leaves no usable arena behind, so it reports the code\n76: // and the failing command on stderr instead.\n77: class StepFailure extends Error {\n78:   constructor(code, detail) {\n79:     super(detail === '' ? code : `${code}: ${detail}`);\n80:     this.code = code;\n81:   }\n82: }\n83: \n84: function writeJson(value) {\n85:   process.stdout.write(`${JSON.stringify(value)}\\n`);\n86: }\n87: \n88: function refuse(code, extra = {}) {\n89:   writeJson({ ok: false, code, ...extra });\n90:   process.exit(EXIT_REFUSED);\n91: }\n92: \n93: function abort(code, detail = '') {\n94:   process.stderr.write(`${SCRIPT_NAME}: ${detail === '' ? code : `${code}: ${detail}`}\\n`);\n95:   writeJson({ ok: false, code });\n96:   process.exit(1);\n97: }\n98: \n99: // ───────────────────────────────────────────────────────────────\n100: // 4. ARGUMENT PARSING\n101: // ───────────────────────────────────────────────────────────────\n102: \n103: function valueAfter(argv, index, flag) {\n104:   const value = argv[index];\n105:   if (value === undefined || value.startsWith('--')) {\n106:     process.stderr.write(`${SCRIPT_NAME}: ${flag} needs a value\\n${USAGE}\\n`);\n107:     process.exit(EXIT_REFUSED);\n108:   }\n109:   return value;\n110: }\n111: \n112: function parseOptions(argv) {\n113:   const options = { source: null, dest: null };\n114:   for (let index = 0; index < argv.length; index += 1) {\n115:     const token = argv[index];\n116:     if (token === '--source') {\n117:       index += 1;\n118:       options.source = valueAfter(argv, index, '--source');\n119:     } else if (token === '--dest') {\n120:       index += 1;\n121:       options.dest = valueAfter(argv, index, '--dest');\n122:     } else {\n123:       process.stderr.write(`${SCRIPT_NAME}: unknown option: ${token}\\n${USAGE}\\n`);\n124:       process.exit(EXIT_REFUSED);\n125:     }\n126:   }\n127:   if (options.source === null || options.dest === null) {\n128:     process.stderr.write(`${SCRIPT_NAME}: --source and --dest are required\\n${USAGE}\\n`);\n129:     process.exit(EXIT_REFUSED);\n130:   }\n131:   return options;\n132: }\n133: \n134: // ───────────────────────────────────────────────────────────────\n135: // 5. GIT HELPERS\n136: // ───────────────────────────────────────────────────────────────\n137: \n138: function git(args, cwd) {\n139:   const result = spawnSync('git', [...GIT_PREFIX, ...args], { cwd, encoding: 'utf8' });\n140:   if (result.error) throw new StepFailure('spawn_failed', result.error.message);\n141:   return result;\n142: }\n143: \n144: function gitText(args, cwd, code) {\n145:   const result = git(args, cwd);\n146:   if (result.status !== 0) throw new StepFailure(code, (result.stderr ?? '').trim());\n147:   return result.stdout;\n148: }\n149: \n150: function headOf(cwd, code) {\n151:   const head = gitText(['rev-parse', 'HEAD'], cwd, code).trim();\n152:   if (head === '') throw new StepFailure(code, `no HEAD in ${cwd}`);\n153:   return head;\n154: }\n155: \n156: // Whether git would leave a path out of a checkout decides whether a clone\n157: // already holds it, so ignore rules are asked rather than guessed from a name.\n158: function isIgnored(cwd, relPath) {\n159:   return git(['check-ignore', '-q', '--', relPath], cwd).status === 0;\n160: }\n161: \n162: // ───────────────────────────────────────────────────────────────\n163: // 6. DESTINATION CHECKS\n164: // ───────────────────────────────────────────────────────────────\n165: \n166: function pathExists(path) {\n167:   try {\n168:     lstatSync(path);\n169:     return true;\n170:   } catch {\n171:     return false;\n172:   }\n173: }\n174: \n175: function nearestExistingAncestor(path) {\n176:   let current = path;\n177:   while (!existsSync(current) && dirname(current) !== current) current = dirname(current);\n178:   return current;\n179: }\n180: \n181: function isInsideRepository(path) {\n182:   return git(['rev-parse', '--show-toplevel'], path).status === 0;\n183: }\n184: \n185: // ───────────────────────────────────────────────────────────────\n186: // 7. COPY PLAN\n187: // ───────────────────────────────────────────────────────────────\n188: \n189: // One walk of the source decides what a clone is missing. A build directory is\n190: // recorded and not descended into, so anything inside it travels with the tree.\n191: // The SQLite files searched for sit under the tooling root only, because that is\n192: // where the advisor keeps its graph.\n193: function copyPlan(source) {\n194:   const trees = [];\n195:   const sqlite = [];\n196:   const walk = (relPath) => {\n197:     const absPath = relPath === '' ? source : join(source, relPath);\n198:     for (const entry of readdirSync(absPath, { withFileTypes: true })) {\n199:       if (entry.name === '.git') continue;\n200:       const childRel = relPath === '' ? entry.name : `${relPath}/${entry.name}`;\n201:       if (entry.isDirectory()) {\n202:         if (BUILD_DIR_NAMES.has(entry.name)) {\n203:           trees.push(childRel);\n204:           continue;\n205:         }\n206:         walk(childRel);\n207:         continue;\n208:       }\n209:       if (entry.isFile() && entry.name.endsWith(SQLITE_SUFFIX) && childRel.startsWith(SKILLED_PREFIX)) {\n210:         sqlite.push(childRel);\n211:       }\n212:     }\n213:   };\n214:   walk('');\n215:   return [...trees, ...sqlite].filter((relPath) => isIgnored(source, relPath)).sort();\n216: }\n217: \n218: function holdsDotenv(dirPath) {\n219:   for (const entry of readdirSync(dirPath, { withFileTypes: true })) {\n220:     if (DOTENV_PATTERN.test(entry.name)) return true;\n221:     if (entry.isDirectory() && holdsDotenv(join(dirPath, entry.name))) return true;\n222:   }\n223:   return false;\n224: }\n225: \n226: function runCp(sourcePath, destParent) {\n227:   const result = spawnSync('cp', ['-Rc', sourcePath, destParent], { encoding: 'utf8' });\n228:   if (result.error) throw new StepFailure('copy_failed', `${sourcePath}: ${result.error.message}`);\n229:   if (result.status !== 0) throw new StepFailure('copy_failed', `${sourcePath}: ${(result.stderr ?? '').trim()}`);\n230: }\n231: \n232: // A symlink is stamped through the link itself, because its target may live\n233: // outside the arena and is not this copy's to change.\n234: function stampPath(path, time) {\n235:   if (lstatSync(path).isSymbolicLink()) {\n236:     lutimesSync(path, time, time);\n237:     return;\n238:   }\n239:   utimesSync(path, time, time);\n240: }\n241: \n242: // Only a build tree is stamped. The guard reads the timestamp of a dist entry,\n243: // and neither a dependency tree nor a database file is watched.\n244: function stampBuildTree(path) {\n245:   const time = new Date();\n246:   for (const entry of readdirSync(path, { withFileTypes: true })) {\n247:     const child = join(path, entry.name);\n248:     if (entry.isDirectory()) stampBuildTree(child);\n249:     else stampPath(child, time);\n250:   }\n251:   stampPath(path, time);\n252: }\n253: \n254: // The clonefile flag keeps the copy cheap on the same volume, and the walk only\n255: // happens where a dotenv file is actually present, so the common tree is one\n256: // `cp` call rather than one call per file.\n257: function copyPath(sourcePath, destPath) {\n258:   const isDirectory = lstatSync(sourcePath).isDirectory();\n259:   if (!isDirectory || !holdsDotenv(sourcePath)) {\n260:     mkdirSync(dirname(destPath), { recursive: true });\n261:     runCp(sourcePath, dirname(destPath));\n262:     return;\n263:   }\n264:   mkdirSync(destPath, { recursive: true });\n265:   for (const entry of readdirSync(sourcePath, { withFileTypes: true })) {\n266:     if (DOTENV_PATTERN.test(entry.name)) continue;\n267:     copyPath(join(sourcePath, entry.name), join(destPath, entry.name));\n268:   }\n269: }\n270: \n271: // ───────────────────────────────────────────────────────────────\n272: // 8. ARENA BUILD\n273: // ───────────────────────────────────────────────────────────────\n274: \n275: function cloneInto(source, dest) {\n276:   const result = git(['clone', '--no-hardlinks', source, dest], process.cwd());\n277:   if (result.status !== 0) throw new StepFailure('clone_failed', (result.stderr ?? '').trim());\n278: }\n279: \n280: function checkoutDetached(dest, head) {\n281:   const result = git(['checkout', '--quiet', '--detach', head], dest);\n282:   if (result.status !== 0) throw new StepFailure('checkout_failed', (result.stderr ?? '').trim());\n283: }\n284: \n285: // A remote is the one piece of git state a turn could use to reach outside the\n286: // checkout, so every one the clone inherits is removed rather than left dormant.\n287: function removeRemotes(dest) {\n288:   const names = gitText(['remote'], dest, 'remote_unreadable')\n289:     .split('\\n')\n290:     .map((name) => name.trim())\n291:     .filter((name) => name !== '');\n292:   for (const name of names) gitText(['remote', 'remove', name], dest, 'remote_unreadable');\n293: }\n294: \n295: function assertHead(dest, head) {\n296:   const cloned = gitText(['rev-parse', 'HEAD'], dest, 'head_unreadable').trim();\n297:   if (cloned !== head) throw new StepFailure('head_mismatch', `expected ${head}, got ${cloned}`);\n298: }\n299: \n300: function buildArena(source, dest, head) {\n301:   cloneInto(source, dest);\n302:   checkoutDetached(dest, head);\n303:   removeRemotes(dest);\n304:   const copied = copyPlan(source);\n305:   for (const relPath of copied) {\n306:     const destPath = join(dest, relPath);\n307:     copyPath(join(source, relPath), destPath);\n308:     if (basename(relPath) === 'dist') stampBuildTree(destPath);\n309:   }\n310:   assertHead(dest, head);\n311:   // The runner refuses a live arm in a checkout without this file, because only a\n312:   // checkout built here has no remote, no outer repository and no dotenv file in\n313:   // its copied build trees.\n314:   writeFileSync(join(dest, '.git', MARK), `${head}\\n`);\n315:   return copied;\n316: }\n317: \n318: // ───────────────────────────────────────────────────────────────\n319: // 9. ENTRY POINT\n320: // ───────────────────────────────────────────────────────────────\n321: \n322: function main(argv) {\n323:   const options = parseOptions(argv);\n324:   const source = resolve(options.source);\n325:   const dest = resolve(options.dest);\n326:   const head = headOf(source, 'source_not_repo');\n327: \n328:   if (pathExists(dest)) refuse('dest_exists', { dest });\n329:   if (isInsideRepository(nearestExistingAncestor(dirname(dest)))) refuse('dest_in_repo', { dest });\n330: \n331:   mkdirSync(dirname(dest), { recursive: true });\n332:   try {\n333:     const copied = buildArena(source, dest, head);\n334:     writeJson({ ok: true, dest, head, copied });\n335:   } catch (error) {\n336:     // A half-built arena would answer the next call with `dest_exists` while\n337:     // holding a checkout nobody finished, so the failed attempt removes itself.\n338:     rmSync(dest, { recursive: true, force: true });\n339:     abort(error.code ?? 'arena_failed', error.message);\n340:   }\n341: }\n342: \n343: main(process.argv.slice(2));"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"limit\":345,\"path\":\".skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/prepare-behaviour-arena.mjs\"}"},"time":{"start":1794570653624,"end":1794570654022}}}}
{"type":"step_finish","timestamp":1794570655987,"sessionID":"ses_e2b4a2200ffebIrmmKNfkMdQAD","part":{"id":"prt_1d4bf18f30013uraAlpfR2dJUf","sessionID":"ses_e2b4a2200ffebIrmmKNfkMdQAD","messageID":"msg_1d4bef356001p7uX51nPd001B4","type":"step-finish","reason":"tool-calls","snapshot":"a308f4dd7da48a46ee958702b0ca6d7e5940ef89","cost":0,"tokens":{"input":2542,"output":80,"reasoning":167,"cache":{"read":187008,"write":0}}}}
{"type":"step_start","timestamp":1794570659221,"sessionID":"ses_e2b4a2200ffebIrmmKNfkMdQAD","part":{"id":"prt_1d4bf2595001YBYeqiPC18EE1K","sessionID":"ses_e2b4a2200ffebIrmmKNfkMdQAD","messageID":"msg_1d4bf18fd001xUvbCwUBov0QoV","type":"step-start","snapshot":"a308f4dd7da48a46ee958702b0ca6d7e5940ef89"}}
{"type":"tool_use","timestamp":1794570668227,"sessionID":"ses_e2b4a2200ffebIrmmKNfkMdQAD","part":{"partID":"prt_1d4bf4776002hKZran08JqDGqc","sessionID":"ses_e2b4a2200ffebIrmmKNfkMdQAD","messageID":"msg_1d4bf18fd001xUvbCwUBov0QoV","type":"tool","id":"call_8fa61f09fb0a4e97a0e7bf62","tool":"read","state":{"status":"completed","input":{"path":".skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/worktree-restore.mjs"},"output":"Read file .skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/worktree-restore.mjs, lines 1-122\n1: // ───────────────────────────────────────────────────────────────\n2: // MODULE: Worktree restore\n3: // ───────────────────────────────────────────────────────────────\n4: //\n5: // A measured turn runs inside a checkout someone else may be working in, so the\n6: // runner has to put back exactly what the turn changed and nothing else. The\n7: // snapshot is the baseline: any path that was already dirty when the turn began\n8: // belongs to an earlier edit and is never touched, even when the turn adds that\n9: // path to the index on top of the edit.\n10: //\n11: // Restoring from the index is not enough. A staged new file is in the index, so\n12: // restoring from the index keeps it, while only HEAD is the state the turn\n13: // started from. A path HEAD knows is checked out from HEAD, and a path HEAD does\n14: // not know is dropped from the index and deleted from the worktree. A second\n15: // snapshot after the restore reports what is still different, so the caller can\n16: // fail the run instead of claiming a clean worktree.\n17: \n18: import { spawnSync } from 'node:child_process';\n19: import { rmSync } from 'node:fs';\n20: import { resolve } from 'node:path';\n21: \n22: // A filesystem monitor that decides a path is unchanged makes a status snapshot\n23: // lie, and the restore trusts that snapshot.\n24: const GIT_PREFIX = ['-c', 'core.fsmonitor=false'];\n25: \n26: function git(cwd, args) {\n27:   const result = spawnSync('git', [...GIT_PREFIX, ...args], { cwd, encoding: 'utf8' });\n28:   if (result.error) throw result.error;\n29:   return result;\n30: }\n31: \n32: function trimTrailingSlash(path) {\n33:   return path.endsWith('/') ? path.slice(0, -1) : path;\n34: }\n35: \n36: /**\n37:  * Read the working tree state of one checkout.\n38:  *\n39:  * Porcelain names each path relative to the checkout, and a rename names both\n40:  * the old and the new path. Both sides are separate keys because both have to\n41:  * be restored.\n42:  *\n43:  * @param {string} cwd - Root of the checkout to read.\n44:  * @returns {Map<string, string>} Path to its two-letter status code.\n45:  */\n46: export function statusSnapshot(cwd) {\n47:   const result = git(cwd, ['status', '--porcelain']);\n48:   if (result.status !== 0) {\n49:     throw new Error(`git status --porcelain failed: ${(result.stderr ?? '').trim()}`);\n50:   }\n51:   const paths = new Map();\n52:   for (const line of result.stdout.split('\\n')) {\n53:     if (line.length < 4) continue;\n54:     for (const path of line.slice(3).split(' -> ')) {\n55:       paths.set(path, line.slice(0, 2));\n56:     }\n57:   }\n58:   return paths;\n59: }\n60: \n61: // A staged new file is in the index, so restoring from the index would keep it.\n62: // Only HEAD is the state the turn started from, so a path without a HEAD entry\n63: // loses its index entry as well as its file.\n64: function restorePath(cwd, path) {\n65:   const failures = [];\n66:   const inHead = git(cwd, ['cat-file', '-e', `HEAD:${path}`]);\n67:   if (inHead.status === 0) {\n68:     const checkout = git(cwd, ['checkout', 'HEAD', '--', path]);\n69:     if (checkout.status !== 0) {\n70:       failures.push(`checkout ${path}: ${(checkout.stderr ?? '').trim()}`);\n71:     }\n72:     return failures;\n73:   }\n74:   const dropped = git(cwd, ['rm', '-r', '-q', '--cached', '--ignore-unmatch', '--', path]);\n75:   if (dropped.status !== 0) {\n76:     failures.push(`rm --cached ${path}: ${(dropped.stderr ?? '').trim()}`);\n77:   }\n78:   try {\n79:     rmSync(resolve(cwd, path), { recursive: true, force: true });\n80:   } catch (error) {\n81:     failures.push(`delete ${path}: ${error.message}`);\n82:   }\n83:   return failures;\n84: }\n85: \n86: /**\n87:  * Put every path the turn changed back to the state its HEAD held.\n88:  *\n89:  * A path that was already present before the turn is never passed to git or\n90:  * deleted, because the turn did not put it there.\n91:  *\n92:  * @param {object} options\n93:  * @param {string} options.cwd - Root of the checkout to restore.\n94:  * @param {Map<string, string>} options.before - Snapshot taken before the turn.\n95:  * @returns {{ restored: boolean, leftoverPaths: string[], failures: string[] }}\n96:  */\n97: export function restoreTurn({ cwd, before }) {\n98:   const after = statusSnapshot(cwd);\n99:   const changed = [...after.keys()]\n100:     .filter((path) => after.get(path) !== before.get(path) && !before.has(path))\n101:     .sort();\n102:   const failures = [];\n103:   for (const raw of changed) {\n104:     const path = trimTrailingSlash(raw);\n105:     // A path the turn inherited is not the turn's to restore.\n106:     if (before.has(path)) continue;\n107:     try {\n108:       failures.push(...restorePath(cwd, path));\n109:     } catch (error) {\n110:       failures.push(`restore ${path}: ${error.message}`);\n111:     }\n112:   }\n113:   const final = statusSnapshot(cwd);\n114:   const leftoverPaths = [...new Set([...before.keys(), ...final.keys()])]\n115:     .filter((path) => final.get(path) !== before.get(path))\n116:     .sort();\n117:   return {\n118:     restored: leftoverPaths.length === 0 && failures.length === 0,\n119:     leftoverPaths,\n120:     failures,\n121:   };\n122: }","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file .skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/worktree-restore.mjs, lines 1-122\n1: // ───────────────────────────────────────────────────────────────\n2: // MODULE: Worktree restore\n3: // ───────────────────────────────────────────────────────────────\n4: //\n5: // A measured turn runs inside a checkout someone else may be working in, so the\n6: // runner has to put back exactly what the turn changed and nothing else. The\n7: // snapshot is the baseline: any path that was already dirty when the turn began\n8: // belongs to an earlier edit and is never touched, even when the turn adds that\n9: // path to the index on top of the edit.\n10: //\n11: // Restoring from the index is not enough. A staged new file is in the index, so\n12: // restoring from the index keeps it, while only HEAD is the state the turn\n13: // started from. A path HEAD knows is checked out from HEAD, and a path HEAD does\n14: // not know is dropped from the index and deleted from the worktree. A second\n15: // snapshot after the restore reports what is still different, so the caller can\n16: // fail the run instead of claiming a clean worktree.\n17: \n18: import { spawnSync } from 'node:child_process';\n19: import { rmSync } from 'node:fs';\n20: import { resolve } from 'node:path';\n21: \n22: // A filesystem monitor that decides a path is unchanged makes a status snapshot\n23: // lie, and the restore trusts that snapshot.\n24: const GIT_PREFIX = ['-c', 'core.fsmonitor=false'];\n25: \n26: function git(cwd, args) {\n27:   const result = spawnSync('git', [...GIT_PREFIX, ...args], { cwd, encoding: 'utf8' });\n28:   if (result.error) throw result.error;\n29:   return result;\n30: }\n31: \n32: function trimTrailingSlash(path) {\n33:   return path.endsWith('/') ? path.slice(0, -1) : path;\n34: }\n35: \n36: /**\n37:  * Read the working tree state of one checkout.\n38:  *\n39:  * Porcelain names each path relative to the checkout, and a rename names both\n40:  * the old and the new path. Both sides are separate keys because both have to\n41:  * be restored.\n42:  *\n43:  * @param {string} cwd - Root of the checkout to read.\n44:  * @returns {Map<string, string>} Path to its two-letter status code.\n45:  */\n46: export function statusSnapshot(cwd) {\n47:   const result = git(cwd, ['status', '--porcelain']);\n48:   if (result.status !== 0) {\n49:     throw new Error(`git status --porcelain failed: ${(result.stderr ?? '').trim()}`);\n50:   }\n51:   const paths = new Map();\n52:   for (const line of result.stdout.split('\\n')) {\n53:     if (line.length < 4) continue;\n54:     for (const path of line.slice(3).split(' -> ')) {\n55:       paths.set(path, line.slice(0, 2));\n56:     }\n57:   }\n58:   return paths;\n59: }\n60: \n61: // A staged new file is in the index, so restoring from the index would keep it.\n62: // Only HEAD is the state the turn started from, so a path without a HEAD entry\n63: // loses its index entry as well as its file.\n64: function restorePath(cwd, path) {\n65:   const failures = [];\n66:   const inHead = git(cwd, ['cat-file', '-e', `HEAD:${path}`]);\n67:   if (inHead.status === 0) {\n68:     const checkout = git(cwd, ['checkout', 'HEAD', '--', path]);\n69:     if (checkout.status !== 0) {\n70:       failures.push(`checkout ${path}: ${(checkout.stderr ?? '').trim()}`);\n71:     }\n72:     return failures;\n73:   }\n74:   const dropped = git(cwd, ['rm', '-r', '-q', '--cached', '--ignore-unmatch', '--', path]);\n75:   if (dropped.status !== 0) {\n76:     failures.push(`rm --cached ${path}: ${(dropped.stderr ?? '').trim()}`);\n77:   }\n78:   try {\n79:     rmSync(resolve(cwd, path), { recursive: true, force: true });\n80:   } catch (error) {\n81:     failures.push(`delete ${path}: ${error.message}`);\n82:   }\n83:   return failures;\n84: }\n85: \n86: /**\n87:  * Put every path the turn changed back to the state its HEAD held.\n88:  *\n89:  * A path that was already present before the turn is never passed to git or\n90:  * deleted, because the turn did not put it there.\n91:  *\n92:  * @param {object} options\n93:  * @param {string} options.cwd - Root of the checkout to restore.\n94:  * @param {Map<string, string>} options.before - Snapshot taken before the turn.\n95:  * @returns {{ restored: boolean, leftoverPaths: string[], failures: string[] }}\n96:  */\n97: export function restoreTurn({ cwd, before }) {\n98:   const after = statusSnapshot(cwd);\n99:   const changed = [...after.keys()]\n100:     .filter((path) => after.get(path) !== before.get(path) && !before.has(path))\n101:     .sort();\n102:   const failures = [];\n103:   for (const raw of changed) {\n104:     const path = trimTrailingSlash(raw);\n105:     // A path the turn inherited is not the turn's to restore.\n106:     if (before.has(path)) continue;\n107:     try {\n108:       failures.push(...restorePath(cwd, path));\n109:     } catch (error) {\n110:       failures.push(`restore ${path}: ${error.message}`);\n111:     }\n112:   }\n113:   const final = statusSnapshot(cwd);\n114:   const leftoverPaths = [...new Set([...before.keys(), ...final.keys()])]\n115:     .filter((path) => final.get(path) !== before.get(path))\n116:     .sort();\n117:   return {\n118:     restored: leftoverPaths.length === 0 && failures.length === 0,\n119:     leftoverPaths,\n120:     failures,\n121:   };\n122: }"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\".skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/worktree-restore.mjs\"}"},"time":{"start":1794570667895,"end":1794570668227}}}}
