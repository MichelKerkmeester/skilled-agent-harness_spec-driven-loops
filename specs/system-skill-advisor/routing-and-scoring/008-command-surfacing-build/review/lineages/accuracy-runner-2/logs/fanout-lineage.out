\n354:   const dbDir = realEmbedding ? null : mkdtempSync(join(tmpdir(), 'advisor-command-routing-'));\n355:   try {\n356:     // Environment projection. That empty directory makes the SQLite loader\n357:     // return null, so the projection is built from committed metadata alone,\n358:     // which is the only state a clean checkout can reproduce. A real capture reads\n359:     // the operator's own skill graph and embedder instead, so the three variables\n360:     // that select the projection are exactly the three it leaves unset.\n361:     if (!realEmbedding) {\n362:       process.env.SYSTEM_SKILL_ADVISOR_DB_DIR = dbDir;\n363:       process.env.SKILL_ADVISOR_DISABLE_BUILTIN_SEMANTIC = '1';\n364:       // Match the test-harness regime: the semantic-shadow lane substitutes\n365:       // deterministic fixture vectors under the harness flag (real embeddings are\n366:       // not reproducible in CI), so every scorer gate runs this way. The baseline\n367:       // must be captured under the same regime the ratchet re-scores it in.\n368:       process.env.VITEST = 'true';\n369:     }\n370:     process.env.SPECKIT_SKILL_ADVISOR_FORCE_LOCAL = '1';\n371:     process.env.PYTHONDONTWRITEBYTECODE = '1';\n372:     delete process.env.SPECKIT_ADVISOR_LANE_WEIGHTS_JSON;\n373:     delete process.env.SPECKIT_ADVISOR_LANE_SHADOW_WEIGHTS_JSON;\n374:     delete process.env.SPECKIT_ADVISOR_BM25_LEXICAL_SHADOW;\n375:     // Private `local-*` skills linked in through this variable live outside the\n376:     // checkout, so a baseline measured on a clean checkout must not see them.\n377:     delete process.env.SPECKIT_PRIVATE_SKILL_ROOTS;\n378: \n379:     // Pin the scoring clock to midnight UTC on the inherited scoring date.\n380:     const capturedAt = readPinnedScoringDate();\n381:     const scoringInstant = Date.parse(`${capturedAt}T00:00:00Z`);\n382:     globalThis.Date = class extends RealDate {\n383:       constructor(...args) {\n384:         if (args.length === 0) super(scoringInstant);\n385:         else super(...args);\n386:       }\n387: \n388:       static now() {\n389:         return scoringInstant;\n390:       }\n391:     };\n392: \n393:     if (!existsSync(FUSION_MODULE)) {\n394:       throw new Error(`built scorer file missing: ${FUSION_MODULE}`);\n395:     }\n396:     for (const modulePath of [COMMAND_ATTACH_MODULE, COMPILED_ROUTING_FLAG_MODULE, PROMPT_POLICY_MODULE]) {\n397:       if (!existsSync(modulePath)) {\n398:         throw new Error(`built command-attach file missing: ${modulePath}`);\n399:       }\n400:     }\n401: \n402:     // Imported after the clock is pinned so the compiled scorer initializes\n403:     // against the pinned date, and only after it is known to exist so a missing\n404:     // build is reported as such rather than as a module-resolution failure.\n405:     const { scoreAdvisorPrompt } = await import(pathToFileURL(FUSION_MODULE).href);\n406:     const { findAdvisorWorkspaceRoot } = await import(pathToFileURL(WORKSPACE_ROOT_MODULE).href);\n407:     const { attachCommand, typedCommandForTop, TRACKED_COMMANDS, routeNeedsMode } = await import(pathToFileURL(COMMAND_ATTACH_MODULE).href);\n408:     const { extractMetalinguisticSkillMentions } = await import(pathToFileURL(PROMPT_POLICY_MODULE).href);\n409:     const { COMPILED_ROUTING_HUBS } = await import(pathToFileURL(COMPILED_ROUTING_FLAG_MODULE).href);\n410:     const workspaceRoot = findAdvisorWorkspaceRoot(HERE, { maxDepth: 14, sentinel: SENTINEL });\n411: \n412:     // A missing front door would make every spawn fail and report the same zero\n413:     // as a hub with nothing to attach, so it fails the capture instead.\n414:     if (!existsSync(resolve(workspaceRoot, COMPILED_ROUTE_CLI))) {\n[Output truncated. Continue reading with offset: 415]"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"limit\":115,\"offset\":300,\"path\":\".skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/capture-command-