  },\n292:     value() {\n293:       if (captured === null && pending !== '') captured = readId(pending, field);\n294:       return captured;\n295:     },\n296:   };\n297: }\n298: \n299: // A line that is not a JSON object is ordinary chatter, so a parse failure says\n300: // this line holds no locator rather than that the run failed.\n301: function readId(line, field) {\n302:   let event;\n303:   try {\n304:     event = JSON.parse(line);\n305:   } catch {\n306:     return null;\n307:   }\n308:   const id = event?.[field];\n309:   return typeof id === 'string' && id !== '' ? id : null;\n310: }\n311: \n312: // A runtime that keeps its sessions in a store its output never names still lists\n313: // them for the directory the turn ran in, so two listings taken around a turn\n314: // reduce the store to a set difference. The listing runs in the child's\n315: // environment, because that is the store the turn itself wrote to.\n316: const LISTING_CAP_MS = 60_000;\n317: \n318: function listingIds(runtime, ghConfig) {\n319:   const source = runtime.locator;\n320:   if (source.kind !== 'listing') return null;\n321:   const result = spawnSync(runtime.command, source.args, {\n322:     cwd: REPO_ROOT,\n323:     env: childEnv(ghConfig),\n324:     encoding: 'utf8',\n325:     timeout: LISTING_CAP_MS,\n326:   });\n327:   if (result.error) return null;\n328:   return result.status === 0 ? listedSessionIds(result.stdout) : null;\n329: }\n330: \n331: // A runtime that names its session only in a store it owns is bracketed by two\n332: // readings of that store, and the entry the turn added is the session it wrote.\n333: function listsStore(runtime) {\n334:   return runtime.locator.kind === 'listing' || runtime.locator.kind === 'store';\n335: }\n336: \n337: // Only the reading differs between the store-backed forms: one CLI answers with\n338: // its own index and the other keeps one folder per session. Any other kind\n339: // names its session in the turn's output instead.\n340: function storeIds(runtime, ghConfig) {\n341:   return runtime.locator.kind === 'store'\n342:     ? runtime.locator.list()\n343:     : listingIds(runtime, ghConfig);\n344: }\n345: \n346: // The listing is a JSON array of session objects whose `id` field is the value\n347: // the CLI's own resume takes, so that field is the one that leads back to a\n348: // transcript. Any other shape names no session, which the caller reads as no id\n349: // rather than as a failed run.\n350: function listedSessionIds(text) {\n351:   let entries;\n352:   try {\n353:     entries = JSON.parse(text);\n354:   } catch {\n355:     return null;\n356:   }\n357:   if (!Array.isArray(entries)) return null;\n358:   return entries\n359:     .map((entry) => (entry !== null && typeof entry === 'object' ? entry.id : null))\n360:     .filter((id) => typeof id === 'string' && id !== '');\n361: }\n362: \n363: // A session another operator opened while the turn ran is not this turn's, and a\n364: // listing that reports none or several added entries has no id it can name with\n365: // confidence, so only a single added entry becomes the locator.\n366: function addedSessionId(before, after) {\n367:   if (before === null || after === null) return null;\n368:   const known = new Set(before);\n369:   const added = [...new Set(after.filter((id) => !known.has(id)))];\n370:   return added.length === 1 ? added[0] : null;\n371: }\n372: \n373: // A DSH turn can add helper sessions beside its own, so a difference of several\n374: // entries names no single session. Only the session the prompt opened holds that\n375: // prompt as its first user message, so the prompt decides between them, and a\n376: // session the reader cannot open names no match rather than failing the turn.\n377: async function firstUserText(sessionId) {\n378:   let loaded;\n379:   try {\n380:     loaded = await loadSharedSession({\n381:       runtime: 'dsh',\n382:       sessionId,\n383:       dshHome: dshHome(),\n384:       projectDir: PROJECT_DIR,\n385:     });\n386:   } catch {\n387:     return null;\n388:   }\n389:   if (!loaded?.ok || !Array.isArray(loaded.records)) return null;\n390:   const record = loaded.records.find((entry) => entry?.role === 'user');\n391:   if (record === undefined) return null;\n392:   return (Array.isArray(record.content) ? record.content : [])\n393:     .filter((block) => block?.type === 'text' && typeof block.text === 'string')\n394:     .map((block) => block.text)\n395:     .join('\\n');\n396: }\n397: \n398: // DSH keeps its session logs under DSH_HOME, which an operator can move, so the\n399: // locator records the home the run used and the transcript stays findable from\n400: // the log alone.\n401: function dshHome() {\n402:   return process.env.DSH_HOME || join(homedir(), '.dsh');\n403: }\n404: \n405: // A DSH session is a folder named after its id under one folder per project the\n406: // harness keyed from the directory the turn ran in, and the turn's own output\n407: // never names that id. The store root comes from the reader so the folder listed\n408: // here is the folder the reader will search. A store the harness has not created\n409: // yet lists nothing, which is the same answer as a turn that wrote no session.\n410: function dshSessionIds() {\n411:   const store = join(dshStoreRoot(), dshProjectKey(PROJECT_DIR));\n412:   try {\n413:     return readdirSync(store, { withFileTypes: true })\n414:       .filter((entry) => entry.isDirectory())\n415:       .map((entry) => entry.name);\n416:   } catch {\n417:     return [];\n418:   }\n419: }\n420: \n421: // A store folder is the CLI's to lay out, so the walk follows the folders it\n422: // creates and matches on the file name instead of predicting a path. A store that\n423: // is missing or unreadable names no transcript, which is the same answer as a turn\n424: // that wrote none rather than a reason to fail the run.\n425: function findTranscriptFiles(dir, matches, depth) {\n426:   let entries;\n427:   try {\n428:     entries = readdirSync(dir, { withFileTypes: true });\n429:   } catch {\n430:     return [];\n431:   }\n432:   const found = [];\n433:   for (const entry of entries) {\n434:     if (entry.isFile() && matches(entry.name)) {\n435:       found.push(join(dir, entry.name));\n436:     } else if (entry.isDirectory() && depth > 0) {\n437:       found.push(...findTranscriptFiles(join(dir, entry.name), matches, depth - 1));\n438:     }\n439:   }\n440:   return found;\n441: }\n442: \n443: // One match is the turn's own transcript, while two leave the locator without a\n444: // path because choosing between them could score a neighbouring turn under this\n445: // row. The path is resolved so a log written from another checkout still opens.\n446: function storedTranscriptPath(root, matches, depth = Infinity) {\n447:   const found = findTranscriptFiles(root, matches, depth);\n448:   return found.length === 1 ? resolve(found[0]) : null;\n449: }\n450: \n451: // Claude Code keeps one folder per working directory and writes each transcript\n452: // directly inside it, so one level below the store is the whole of the search. A\n453: // helper transcript sits deeper inside `subagents/`, which belongs to another turn\n454: // and which the reader refuses.\n455: function claudeTranscriptPath(sessionId) {\n456:   const store = join(process.env.CLAUDE_CONFIG_DIR || join(homedir(), '.claude'), 'projects');\n457:   return storedTranscriptPath(store, (name) => name === `${sessionId}.jsonl`, 1);\n458: }\n459: \n460: // A Codex rollout file is named after its start time and ends with the thread id,\n461: // and it sits under a date folder whose depth is the CLI's to choose, so the whole\n462: // store is searched and the id is a suffix of the name.\n463: function codexTranscriptPath(sessionId) {\n464:   const store = join(process.env.CODEX_HOME || join(homedir(), '.codex'), 'sessions');\n465:   return storedTranscriptPath(store, (name) => name.endsWith(`-${sessionId}.jsonl`));\n466: }\n467: \n468: // A store listing that added no single entry leaves the id out rather than\n469: // naming a guess that would score a neighbouring turn under this row. The home\n470: // stays on the record so the store the run wrote to is findable from the log\n471: // alone.\n472: function storeLocator(reportedId) {\n473:   const store = { dshHome: dshHome(), projectDir: PROJECT_DIR };\n474:   return reportedId === null ? store : { sessionId: reportedId, ...store };\n475: }\n476: \n477: function locatorFor(runtime, sessionId, reportedId) {\n478:   const source = runtime.locator;\n479:   // The id the runner handed the CLI is the one the store keys its log by, and\n480:   // the directory the turn ran in is what a reader matches the log's header\n481:   // against, so both travel with every record.\n482:   if (source.kind === 'runner') return { sessionId, projectDir: PROJECT_DIR };\n483:   if (source.kind === 'store') return storeLocator(reportedId);\n484:   // A runtime that reported no id records none, which keeps a scorer from opening\n485:   // a neighbouring transcript that happens to be newer.\n486:   if (reportedId === null) return null;\n487:   const locator = { sessionId: reportedId, projectDir: PROJECT_DIR };\n488:   // A reader needs the file the turn wrote as well as its id, so a store-based\n489:   // runtime resolves the id to a path once the turn has closed. A turn that left\n490:   // no single match keeps the field out rather than naming a guess.\n491:   const transcriptPath = typeof runtime.findTranscript === 'function'\n492:     ? runtime.findTranscript(reportedId)\n493:     : null;\n494:   if (transcriptPath !== null) locator.transcriptPath = transcriptPath;\n495:   return locator;\n496: }\n497: \n498: // ───────────────────────────────────────────────────────────────\n499: // Worktree guards\n500: // ───────────────────────────────────────────────────────────────\n501: //\n502: // Every live turn runs in this worktree, so the runner cleans up after itself and\n503: // refuses to start when the worktree already holds work that is not its own. The\n504: // order matters: the remote check runs before the dirty check, so a live refusal\n505: // names the one condition an arm can never repair, and the dirty check runs before\n506: // the first prompt, so a restore can never discard an edit another worker has not\n507: // committed yet, and the head check runs around every prompt, so a commit or a\n508: // stash taken mid-turn stops the arm before the next model call rather than after\n509: // the damage.\n510: \n511: // A filesystem monitor that decides a path is unchanged makes a status snapshot\n512: // lie, and the restore step trusts that snapshot.\n513: const GIT_PREFIX = ['-c', 'core.fsmonitor=false'];\n514: \n515: // The arena builder writes this file into the checkout it made. Its absence is the\n516: // proof that a root is an operator's working tree rather than a disposable arena.\n517: const MARK = 'skilled-behaviour-arena';\n518: \n519: function git(args) {\n520:   const result = spawnSync('git', [...GIT_PREFIX, ...args], {\n521:     cwd: REPO_ROOT,\n522:     encoding: 'utf8',\n523:   });\n524:   if (result.error) throw result.error;\n525:   return result;\n526: }\n527: \n528: function gitText(args) {\n529:   const result = git(args);\n530:   if (result.status !== 0) {\n531:     throw new Error(`git ${args.join(' ')} failed: ${(result.stderr ?? '').trim()}`);\n532:   }\n533:   return result.stdout;\n534: }\n535: \n536: function statusPaths() {\n537:   return statusSnapshot(REPO_ROOT);\n538: }\n539: \n540: // The out folder is this arm's own output area. Git is asked for that folder's path\n[Output truncated. Continue reading with offset: 541]"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"limit\":330,\"offset\":211,\"path\":\".skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/run-command-behaviour.mjs\"}"},"time":{"start":1794570359145,"end":1794570359