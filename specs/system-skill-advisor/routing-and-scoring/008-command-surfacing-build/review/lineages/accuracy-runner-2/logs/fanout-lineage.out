{"type":"tool_use","timestamp":1794570476622,"sessionID":"ses_e2b4a2200ffebIrmmKNfkMdQAD","part":{"partID":"prt_1d4bc5ad5001rJneoNdDxUhO5V","sessionID":"ses_e2b4a2200ffebIrmmKNfkMdQAD","messageID":"msg_1d4bc263a001oU4fCmmtSdaNuj","type":"tool","id":"call_30cdc2db8e24475187cccf6e","tool":"read","state":{"status":"completed","input":{"path":".skilled/skills/system-skill-advisor/runtime/scripts/measure-brief-cost.mjs"},"output":"Read file .skilled/skills/system-skill-advisor/runtime/scripts/measure-brief-cost.mjs, lines 1-279\n1: // ───────────────────────────────────────────────────────────────────\n2: // MODULE: BRIEF COST MEASUREMENT\n3: // ───────────────────────────────────────────────────────────────────\n4: //\n5: // Measures what the Claude prompt hook actually sends the model for one typed\n6: // command prompt. Each row is piped through the installed hook, and the\n7: // `additionalContext` string it emits is counted in UTF-8 bytes, with an\n8: // estimated token count at the renderer's own four characters per token.\n9: //\n10: // The run keeps its IPC socket in a fresh directory so it never reaches the\n11: // operator's warm daemon. The directory is the only thing that ties the hook\n12: // processes together, and it is removed once every row has been measured.\n13: //\n14: // Usage:\n15: //   node measure-brief-cost.mjs [--rows <id,id>] [--root <dir>]\n16: //\n17: // `--root` names a checkout the corpus and hook are read from, and defaults to\n18: // the current directory. `--rows` narrows the run to named corpus ids.\n19: //\n20: // A run with no live head is refused with `{\"error\":\"degraded_brief\",...}` and\n21: // exits 2, because a head that is not the live line is the fallback or outage\n22: // text and its bytes do not measure what a working install sends.\n23: //\n24: // A holdout row is refused before anything is spawned, and its prompt is never\n25: // printed. That keeps the held-out half of the corpus out of a measurement that\n26: // could otherwise leak it into a bug report.\n27: \n28: // ───────────────────────────────────────────────────────────────────\n29: // 1. IMPORTS\n30: // ───────────────────────────────────────────────────────────────────\n31: \n32: import { execFileSync, spawnSync } from 'node:child_process';\n33: import { existsSync, mkdtempSync, readFileSync, rmSync } from 'node:fs';\n34: import { tmpdir } from 'node:os';\n35: import { join, resolve } from 'node:path';\n36: \n37: // ───────────────────────────────────────────────────────────────────\n38: // 2. CONSTANTS\n39: // ───────────────────────────────────────────────────────────────────\n40: \n41: const CORPUS_REL = '.skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/command-prompts.jsonl';\n42: const HOOK_REL = '.skilled/skills/system-spec-kit/runtime/dist/hooks/claude/user-prompt-submit.js';\n43: const SANDBOX_PREFIX = 'ssa-cost-';\n44: const HOOK_TIMEOUT_MS = 30000;\n45: const MAX_STDOUT_BYTES = 8 * 1024 * 1024;\n46: // The renderer budgets in tokens at four characters per token, so the byte\n47: // count is converted with the same divisor rather than a model-specific one.\n48: const BYTES_PER_TOKEN = 4;\n49: const LIVE_HEAD = 'Advisor: live';\n50: \n51: // ───────────────────────────────────────────────────────────────────\n52: // 3. ARGUMENT PARSING\n53: // ───────────────────────────────────────────────────────────────────\n54: \n55: function usageError(message) {\n56:   process.stderr.write(`measure-brief-cost.mjs: ${message}\\n`);\n57:   process.stderr.write('usage: measure-brief-cost.mjs [--rows <id,id>] [--root <dir>]\\n');\n58:   process.exit(2);\n59: }\n60: \n61: function parseArgs(argv) {\n62:   const options = { rows: null, root: process.cwd() };\n63:   for (let index = 0; index < argv.length; index += 1) {\n64:     const token = argv[index];\n65:     if (token !== '--rows' && token !== '--root') usageError(`unknown option: ${token}`);\n66:     const value = argv[index + 1];\n67:     if (value === undefined || value.startsWith('--')) usageError(`${token} needs a value`);\n68:     if (token === '--rows') {\n69:       const ids = value.split(',').map((id) => id.trim()).filter((id) => id.length > 0);\n70:       if (ids.length === 0) usageError('--rows needs at least one id');\n71:       options.rows = ids;\n72:     } else {\n73:       options.root = resolve(value);\n74:     }\n75:     index += 1;\n76:   }\n77:   return options;\n78: }\n79: \n80: // ───────────────────────────────────────────────────────────────────\n81: // 4. CORPUS SELECTION\n82: // ───────────────────────────────────────────────────────────────────\n83: \n84: function readCorpus(path) {\n85:   if (!existsSync(path)) {\n86:     process.stderr.write(`measure-brief-cost.mjs: corpus file missing: ${path}\\n`);\n87:     process.exit(2);\n88:   }\n89:   const rows = [];\n90:   const lines = readFileSync(path, 'utf8').split('\\n');\n91:   for (let index = 0; index < lines.length; index += 1) {\n92:     const line = lines[index].trim();\n93:     if (line === '') continue;\n94:     try {\n95:       rows.push(JSON.parse(line));\n96:     } catch (error) {\n97:       process.stderr.write(`measure-brief-cost.mjs: invalid JSON on corpus line ${index + 1}: ${error.message}\\n`);\n98:       process.exit(2);\n99:     }\n100:   }\n101:   return rows;\n102: }\n103: \n104: function refuseRow(error, id) {\n105:   process.stdout.write(`${JSON.stringify({ error, id })}\\n`);\n106:   process.exit(2);\n107: }\n108: \n109: // The selected set is always the measured half of the corpus. A named id is\n110: // checked against every row first, so a holdout id is refused as holdout rather\n111: // than reported as missing, and no prompt reaches a process argument or a log.\n112: function selectRows(rows, requested) {\n113:   const typed = rows.filter((row) => row.row_type === 'typed' && row.split === 'none');\n114:   if (requested === null) return typed;\n115: \n116:   const byId = new Map();\n117:   for (const row of rows) {\n118:     if (!byId.has(row.id)) byId.set(row.id, row);\n119:   }\n120:   const byIdTyped = new Map(typed.map((row) => [row.id, row]));\n121:   for (const id of requested) {\n122:     const row = byId.get(id);\n123:     if (row === undefined) refuseRow('unknown_row', id);\n124:     if (row.split === 'holdout') refuseRow('holdout_row', id);\n125:     if (!byIdTyped.has(id)) refuseRow('unknown_row', id);\n126:   }\n127: \n128:   const wanted = new Set(requested);\n129:   const seen = new Set();\n130:   const selected = [];\n131:   for (const row of typed) {\n132:     if (!wanted.has(row.id) || seen.has(row.id)) continue;\n133:     seen.add(row.id);\n134:     selected.push(row);\n135:   }\n136:   return selected;\n137: }\n138: \n139: // ───────────────────────────────────────────────────────────────────\n140: // 5. HOOK MEASUREMENT\n141: // ───────────────────────────────────────────────────────────────────\n142: \n143: // The hook fails open with a directive block, so a missing context field is an\n144: // empty measurement rather than an error. Stdout is parsed whole because the\n145: // shim prints exactly one JSON envelope.\n146: function additionalContextFrom(stdout) {\n147:   if (typeof stdout !== 'string' || stdout.trim() === '') return '';\n148:   try {\n149:     const value = JSON.parse(stdout)?.hookSpecificOutput?.additionalContext;\n150:     return typeof value === 'string' ? value : '';\n151:   } catch {\n152:     return '';\n153:   }\n154: }\n155: \n156: function measureRow(row, root, socketDir, hookPath) {\n157:   const payload = JSON.stringify({\n158:     prompt: row.prompt,\n159:     cwd: root,\n160:     hook_event_name: 'UserPromptSubmit',\n161:     session_id: `cost-${row.id}`,\n162:   });\n163:   const result = spawnSync(process.execPath, [hookPath], {\n164:     cwd: root,\n165:     input: payload,\n166:     encoding: 'utf8',\n167:     env: { ...process.env, SPECKIT_IPC_SOCKET_DIR: socketDir },\n168:     timeout: HOOK_TIMEOUT_MS,\n169:     maxBuffer: MAX_STDOUT_BYTES,\n170:   });\n171:   const context = additionalContextFrom(result.stdout);\n172:   const head = context.split('\\n')[0];\n173:   const bytes = Buffer.byteLength(context, 'utf8');\n174:   const headBytes = Buffer.byteLength(head, 'utf8');\n175:   return {\n176:     id: row.id,\n177:     bytes,\n178:     estimatedTokens: Math.ceil(bytes / BYTES_PER_TOKEN),\n179:     headBytes,\n180:     live: head.startsWith(LIVE_HEAD),\n181:   };\n182: }\n183: \n184: // ───────────────────────────────────────────────────────────────────\n185: // 6. SANDBOX CLEANUP\n186: // ───────────────────────────────────────────────────────────────────\n187: \n188: function processRows() {\n189:   const output = execFileSync('ps', ['-axo', 'pid=,command='], {\n190:     encoding: 'utf8',\n191:     stdio: ['ignore', 'pipe', 'ignore'],\n192:   });\n193:   const rows = [];\n194:   for (const line of output.split('\\n')) {\n195:     const match = /^\\s*(\\d+)\\s+(.*)$/.exec(line);\n196:     if (match === null) continue;\n197:     rows.push({ pid: Number(match[1]), command: match[2] });\n198:   }\n199:   return rows;\n200: }\n201: \n202: // A sandbox process is identified by the directory on its own command line, so\n203: // no pid is signalled on trust alone and an unrelated daemon is never touched.\n204: function stopSandboxProcesses(socketDir) {\n205:   for (const row of processRows()) {\n206:     if (row.pid === process.pid || !row.command.includes(socketDir)) continue;\n207:     try {\n208:       process.kill(row.pid, 'SIGTERM');\n209:     } catch (error) {\n210:       if (error?.code !== 'ESRCH') throw error;\n211:     }\n212:   }\n213: }\n214: \n215: // ───────────────────────────────────────────────────────────────────\n216: // 7. SUMMARY\n217: // ───────────────────────────────────────────────────────────────────\n218: \n219: // The nearest-rank definition matches the runtime metrics, so a median here\n220: // counts the same way as a percentile in a routing capture.\n221: function median(values) {\n222:   if (values.length === 0) return 0;\n223:   const sorted = [...values].sort((a, b) => a - b);\n224:   const rank = Math.min(sorted.length - 1, Math.ceil(0.5 * sorted.length) - 1);\n225:   return sorted[rank];\n226: }\n227: \n228: // A head that is not live is the fallback or outage line, whose bytes are not\n229: // what a working install sends, so the cost is read from live heads alone and a\n230: // run with none says so.\n231: function summarise(rows) {\n232:   const live = rows.filter((row) => row.live);\n233:   const values = live.map((row) => row.bytes);\n234:   const headValues = live.map((row) => row.headBytes);\n235:   return {\n236:     rows,\n237:     liveRows: live.length,\n238:     totalBytes: values.reduce((sum, value) => sum + value, 0),\n239:     medianBytes: median(values),\n240:     maxBytes: values.length === 0 ? 0 : Math.max(...values),\n241:     medianHeadBytes: median(headValues),\n242:     maxHeadBytes: headValues.length === 0 ? 0 : Math.max(...headValues),\n243:   };\n244: }\n245: \n246: // ───────────────────────────────────────────────────────────────────\n247: // 8. ENTRY\n248: // ───────────────────────────────────────────────────────────────────\n249: \n250: function main() {\n251:   const options = parseArgs(process.argv.slice(2));\n252:   const corpusPath = join(options.root, CORPUS_REL);\n253:   const hookPath = join(options.root, HOOK_REL);\n254:   const selected = selectRows(readCorpus(corpusPath), options.rows);\n255:   if (!existsSync(hookPath)) {\n256:     process.stderr.write(`measure-brief-cost.mjs: hook file missing: ${hookPath}\\n`);\n257:     process.exit(2);\n258:   }\n259: \n260:   const socketDir = mkdtempSync(join(tmpdir(), SANDBOX_PREFIX));\n261:   try {\n262:     const rows = [];\n263:     for (const row of selected) rows.push(measureRow(row, options.root, socketDir, hookPath));\n264:     const summary = summarise(rows);\n265:     if (summary.liveRows === 0) {\n266:       process.stdout.write(\n267:         `${JSON.stringify({ error: 'degraded_brief', rows: summary.rows.length, liveRows: 0 })}\\n`,\n268:       );\n269:       process.exitCode = 2;\n270:     } else {\n271:       process.stdout.write(`${JSON.stringify(summary)}\\n`);\n272:     }\n273:   } finally {\n274:     stopSandboxProcesses(socketDir);\n275:     rmSync(socketDir, { recursive: true, force: true });\n276:   }\n277: }\n278: \n279: main();","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file .skilled/skills/system-skill-advisor/runtime/scripts/measure-brief-cost.mjs, lines 1-279\n1: // ───────────────────────────────────────────────────────────────────\n2: // MODULE: BRIEF COST MEASUREMENT\n3: // ───────────────────────────────────────────────────────────────────\n4: //\n5: // Measures what the Claude prompt hook actually sends the model for one typed\n6: // command prompt. Each row is piped through the installed hook, and the\n7: // `additionalContext` string it emits is counted in UTF-8 bytes, with an\n8: // estimated token count at the renderer's own four characters per token.\n9: //\n10: // The run keeps its IPC socket in a fresh directory so it never reaches the\n11: // operator's warm daemon. The directory is the only thing that ties the hook\n12: // processes together, and it is removed once every row has been measured.\n13: //\n14: // Usage:\n15: //   node measure-brief-cost.mjs [--rows <id,id>] [--root <dir>]\n16: //\n17: // `--root` names a checkout the corpus and hook are read from, and defaults to\n18: // the current directory. `--rows` narrows the run to named corpus ids.\n19: //\n20: // A run with no live head is refused with `{\"error\":\"degraded_brief\",...}` and\n21: // exits 2, because a head that is not the live line is the fallback or outage\n22: // text and its bytes do not measure what a working install sends.\n23: //\n24: // A holdout row is refused before anything is spawned, and its prompt is never\n25: // printed. That keeps the held-out half of the corpus out of a measurement that\n26: // could otherwise leak it into a bug report.\n27: \n28: // ───────────────────────────────────────────────────────────────────\n29: // 1. IMPORTS\n30: // ───────────────────────────────────────────────────────────────────\n31: \n32: import { execFileSync, spawnSync } from 'node:child_process';\n33: import { existsSync, mkdtempSync, readFileSync, rmSync } from 'node:fs';\n34: import { tmpdir } from 'node:os';\n35: import { join, resolve } from 'node:path';\n36: \n37: // ───────────────────────────────────────────────────────────────────\n38: // 2. CONSTANTS\n39: // ───────────────────────────────────────────────────────────────────\n40: \n41: const CORPUS_REL = '.skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/command-prompts.jsonl';\n42: const HOOK_REL = '.skilled/skills/system-spec-kit/runtime/dist/hooks/claude/user-prompt-submit.js';\n43: const SANDBOX_PREFIX = 'ssa-cost-';\n44: const HOOK_TIMEOUT_MS = 30000;\n45: const MAX_STDOUT_BYTES = 8 * 1024 * 1024;\n46: // The renderer budgets in tokens at four characters per token, so the byte\n47: // count is converted with the same divisor rather than a model-specific one.\n48: const BYTES_PER_TOKEN = 4;\n49: const LIVE_HEAD = 'Advisor: live';\n50: \n51: // ───────────────────────────────────────────────────────────────────\n52: // 3. ARGUMENT PARSING\n53: // ───────────────────────────────────────────────────────────────────\n54: \n55: function usageError(message) {\n56:   process.stderr.write(`measure-brief-cost.mjs: ${message}\\n`);\n57:   process.stderr.write('usage: measure-brief-cost.mjs [--rows <id,id>] [--root <dir>]\\n');\n58:   process.exit(2);\n59: }\n60: \n61: function parseArgs(argv) {\n62:   const options = { rows: null, root: process.cwd() };\n63:   for (let index = 0; index < argv.length; index += 1) {\n64:     const token = argv[index];\n65:     if (token !== '--rows' && token !== '--root') usageError(`unknown option: ${token}`);\n66:     const value = argv[index + 1];\n67:     if (value === undefined || value.startsWith('--')) usageError(`${token} needs a value`);\n68:     if (token === '--rows') {\n69:       const ids = value.split(',').map((id) => id.trim()).filter((id) => id.length > 0);\n70:       if (ids.length === 0) usageError('--rows needs at least one id');\n71:       options.rows = ids;\n72:     } else {\n73:       options.root = resolve(value);\n74:     }\n75:     index += 1;\n76:   }\n77:   return options;\n78: }\n79: \n80: // ───────────────────────────────────────────────────────────────────\n81: // 4. CORPUS SELECTION\n82: // ───────────────────────────────────────────────────────────────────\n83: \n84: function readCorpus(path) {\n85:   if (!existsSync(path)) {\n86:     process.stderr.write(`measure-brief-cost.mjs: corpus file missing: ${path}\\n`);\n87:     process.exit(2);\n88:   }\n89:   const rows = [];\n90:   const lines = readFileSync(path, 'utf8').split('\\n');\n91:   for (let index = 0; index < lines.length; index += 1) {\n92:     const line = lines[index].trim();\n93:     if (line === '') continue;\n94:     try {\n95:       rows.push(JSON.parse(line));\n96:     } catch (error) {\n97:       process.stderr.write(`measure-brief-cost.mjs: invalid JSON on corpus line ${index + 1}: ${error.message}\\n`);\n98:       process.exit(2);\n99:     }\n100:   }\n101:   return rows;\n102: }\n103: \n104: function refuseRow(error, id) {\n105:   process.stdout.write(`${JSON.stringify({ error, id })}\\n`);\n106:   process.exit(2);\n107: }\n108: \n109: // The selected set is always the measured half of the corpus. A named id is\n110: // checked against every row first, so a holdout id is refused as holdout rather\n111: // than reported as missing, and no prompt reaches a process argument or a log.\n112: function selectRows(rows, requested) {\n113:   const typed = rows.filter((row) => row.row_type === 'typed' && row.split === 'none');\n114:   if (requested