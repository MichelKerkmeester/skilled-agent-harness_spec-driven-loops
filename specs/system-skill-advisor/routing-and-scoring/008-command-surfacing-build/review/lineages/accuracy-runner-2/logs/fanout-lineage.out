cmd-doctor-git-plain-tune-01\\\",\\\"cmd-create-skill-typed-01\\\"]){const r=rows.find(x=>x.id===id);console.log(id,JSON.stringify({split:r.split,row_type:r.row_type,expected_command:r.expected_command,expected_policy:r.expected_policy}))}'\"}"},"time":{"start":1794571782954,"end":1794571784402}}}}
