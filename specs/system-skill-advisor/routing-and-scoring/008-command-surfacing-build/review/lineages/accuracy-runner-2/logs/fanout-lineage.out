and capturedAt 2026-10-11 sha 2549786f28\neval capturedAt 2026-10-11 sha 731967bc25\ntyped {\"correct\":24,\"total\":44} reach {\"correct\":27,\"total\":44}\ntyped attached {\"own\":24,\"attached\":20,\"combined\":44,\"total\":44}\nplain attached {\"tune\":{\"own\":8,\"attached\":15,\"combined\":23,\"total\":45},\"holdout\":{\"own\":1,\"attached\":0,\"combined\":1,\"total\":44}}\nplain recall {\"tune\":{\"correct\":8,\"total\":45},\"holdout\":{\"correct\":1,\"total\":44}}\nfalse offer {\"count\":0,\"total\":35}\ncommand count 44\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"cd /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy\\nnode -e '\\nconst fs=require(\\\"fs\\\");\\nconst b=JSON.parse(fs.readFileSync(\\\"command-routing-baseline.json\\\",\\\"utf8\\\"));\\nconst e=JSON.parse(fs.readFileSync(\\\"scorer-eval-baseline.json\\\",\\\"utf8\\\"));\\nconsole.log(\\\"command capturedAt\\\",b.capturedAt,\\\"sha\\\",b.capturedAtSha);\\nconsole.log(\\\"eval capturedAt\\\",e.capturedAt,\\\"sha\\\",e.capturedAtSha);\\nconsole.log(\\\"typed\\\",JSON.stringify(b.metrics.typed_recall_at_1),\\\"reach\\\",JSON.stringify(b.metrics.typed_reach_top3));\\nconsole.log(\\\"typed attached\\\",JSON.stringify(b.attachedMetrics.typed));\\nconsole.log(\\\"plain attached\\\",JSON.stringify(b.attachedMetrics.plain));\\nconsole.log(\\\"plain recall\\\",JSON.stringify(b.metrics.plain_recall_at_1));\\nconsole.log(\\\"false offer\\\",JSON.stringify(b.metrics.false_offer));\\nconsole.log(\\\"command count\\\",Object.keys(b.commands).length);\\n'\"}"},"time":{"start":1794571705490,"end":1794571707420}}}}
