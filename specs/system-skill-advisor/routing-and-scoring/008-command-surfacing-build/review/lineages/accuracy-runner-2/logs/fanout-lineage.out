xpect(env.GH_TOKEN).toBeUndefined();\n33:     expect(env.AI_SESSION_CHILD).toBeUndefined();\n34:     expect(env.ANTHROPIC_API_KEY).toBe('sk-ant-example');\n35:     expect(env.PATH).toBe(process.env.PATH);\n36:     expect(env.HOME).toBe(process.env.HOME);\n37:     expect(env.GH_CONFIG_DIR).toBe('/tmp/gh-empty');\n38:     expect(env.GIT_TERMINAL_PROMPT).toBe('0');\n39:     expect(env.GIT_CONFIG_KEY_0).toBe('credential.helper');\n40:   });\n41: });\n42: \n43: describe('startedLabel', () => {\n44:   it('labels a row from its own command and variant', () => {\n45:     const label = startedLabel('g2-x-custom', [\n46:       { id: 'g2-x-custom', command: '/speckit:plan', variant: 'typed', prompt: 'p' },\n47:     ]);\n48: \n49:     expect(label?.expected_command).toBe('/speckit:plan');\n50:     expect(label?.expected_policy).toBe('start');\n51:     expect(label?.prompt).toBe(':auto');\n52:   });\n53: \n54:   it('returns no label for an id no row carries', () => {\n55:     expect(startedLabel('g2-nope')).toBeNull();\n56:   });\n57: \n58:   it('labels every runner row with its command and only a typed row with :auto', () => {\n59:     for (const row of G2_ROWS) {\n60:       const label = startedLabel(row.id);\n61: \n62:       expect(['/deep:research', '/deep:review', '/speckit:complete']).toContain(label?.expected_command);\n63:       expect(label?.expected_command).toBe(row.command);\n64:       expect(label?.prompt).toBe(row.variant === 'typed' ? ':auto' : '');\n65:     }\n66:   });\n67: });\n68: \n69: describe('liveArmRefusal', () => {\n70:   const dirs: string[] = [];\n71: \n72:   afterEach(() => {\n73:     for (const dir of dirs.splice(0)) rmSync(dir, { recursive: true, force: true });\n74:   });\n75: \n76:   it('refuses a live arm outside a marked arena', () => {\n77:     const dir = mkdtempSync(join(tmpdir(), 'skilled-behaviour-guard-'));\n78:     dirs.push(dir);\n79:     const runGit = (args: string[]) => spawnSync('git', args, { cwd: dir, encoding: 'utf8' });\n80:     expect(runGit(['init', '-q']).status).toBe(0);\n81: \n82:     expect(liveArmRefusal(dir)?.code).toBe('arena_unprepared');\n83: \n84:     writeFileSync(join(dir, '.git', 'skilled-behaviour-arena'), 'arena\\n');\n85:     expect(liveArmRefusal(dir)).toBeNull();\n86: \n87:     expect(runGit(['remote', 'add', 'origin', 'https://example.invalid/x.git']).status).toBe(0);\n88:     expect(liveArmRefusal(dir)).toEqual({ ok: false, code: 'remote_present', remotes: ['origin'] });\n89:   });\n90: });\n91: \n92: describe('entry guard', () => {\n93:   it('runs the CLI when it is launched through a symlink', () => {\n94:     const dir = mkdtempSync(join(tmpdir(), 'skilled-behaviour-entry-'));\n95:     try {\n96:       const runnerLink = join(dir, 'runner.mjs');\n97:       const scorerLink = join(dir, 'scorer.mjs');\n98:       symlinkSync(\n99:         fileURLToPath(new URL('../scripts/routing-accuracy/run-command-behaviour.mjs', import.meta.url)),\n100:         runnerLink,\n101:       );\n102:       symlinkSync(\n103:         fileURLToPath(new URL('../scripts/routing-accuracy/score-command-transcripts.mjs', import.meta.url)),\n104:         scorerLink,\n105:       );\n106: \n107:       const listed = spawnSync(process.execPath, [runnerLink, '--list', 'g2'], { encoding: 'utf8' });\n108:       expect(listed.status).toBe(0);\n109:       expect(listed.stdout.split('\\n')[0]).toBe('g2-deep-research-ask');\n110: \n111:       const refused = spawnSync(process.execPath, [scorerLink], { encoding: 'utf8' });\n112:       expect(refused.status).toBe(2);\n113:       expect(refused.stderr).toContain('--runtime is required with --locator');\n114:     } finally {\n115:       rmSync(dir, { recursive: true, force: true });\n116:     }\n117:   });\n118: });","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file .skilled/skills/system-skill-advisor/runtime/tests/command-behaviour-guards.vitest.ts, lines 1-118\n1: // ───────────────────────────────────────────────────────────────\n2: // MODULE: Behaviour Runner Guard Tests\n3: // ───────────────────────────────────────────────────────────────\n4: \n5: import { mkdtempSync, rmSync, symlinkSync, writeFileSync } from 'node:fs';\n6: import { tmpdir } from 'node:os';\n7: import { join } from 'node:path';\n8: import { fileURLToPath } from 'node:url';\n9: import { spawnSync } from 'node:child_process';\n10: import { afterEach, describe, expect, it, vi } from 'vitest';\n11: import { G2_ROWS, childEnv, liveArmRefusal } from '../scripts/routing-accuracy/run-command-behaviour.mjs';\n12: import { startedLabel } from '../scripts/routing-accuracy/score-command-transcripts.mjs';\n13: \n14: describe('childEnv', () => {\n15:   afterEach(() => {\n16:     vi.unstubAllEnvs();\n17:   });\n18: \n19:   it('passes only the allowlisted environment to a turn', () => {\n20:     vi.stubEnv('SSH_AUTH_SOCK', '/tmp/ssh-agent.sock');\n21:     vi.stubEnv('AWS_ACCESS_KEY_ID', 'AKIAIOSFODNN7EXAMPLE');\n22:     vi.stubEnv('NPM_TOKEN', 'npm-token');\n23:     vi.stubEnv('GH_TOKEN', 'gh-token');\n24:     vi.stubEnv('AI_SESSION_CHILD', '1');\n25:     vi.stubEnv('ANTHROPIC_API_KEY', 'sk-ant-example');\n26: \n27:     const env = childEnv('/tmp/gh-empty');\n28: \n29:     expect(env.SSH_AUTH_SOCK).toBeUndefined();\n30:     expect(env.AWS_ACCESS_KEY_ID).toBeUndefined();\n31:     expect(env.NPM_TOKEN).toBeUndefined();\n32:     expect(env.GH_TOKEN).toBeUndefined();\n33:     expect(env.AI_SESSION_CHILD).toBeUndefined();\n34:     expect(env.ANTHROPIC_API_KEY).toBe('sk-ant-example');\n35:     expect(env.PATH).toBe(process.env.PATH);\n36:     expect(env.HOME).toBe(process.env.HOME);\n37:     expect(env.GH_CONFIG_DIR).toBe('/tmp/gh-empty');\n38:     expect(env.GIT_TERMINAL_PROMPT).toBe('0');\n39:     expect(env.GIT_CONFIG_KEY_0).toBe('credential.helper');\n40:   });\n41: });\n42: \n43: describe('startedLabel', () => {\n44:   it('labels a row from its own command and variant', () => {\n45:     const label = startedLabel('g2-x-custom', [\n46:       { id: 'g2-x-custom', command: '/speckit:plan', variant: 'typed', prompt: 'p' },\n47:     ]);\n48: \n49:     expect(label?.expected_command).toBe('/speckit:plan');\n50:     expect(label?.expected_policy).toBe('start');\n51:     expect(label?.prompt).toBe(':auto');\n52:   });\n53: \n54:   it('returns no label for an id no row carries', () => {\n55:     expect(startedLabel('g2-nope')).toBeNull();\n56:   });\n57: \n58:   it('labels every runner row with its command and only a typed row with :auto', () => {\n59:     for (const row of G2_ROWS) {\n60:       const label = startedLabel(row.id);\n61: \n62:       expect(['/deep:research', '/deep:review', '/speckit:complete']).toContain(label?.expected_command);\n63:       expect(label?.expected_command).toBe(row.command);\n64:       expect(label?.prompt).toBe(row.variant === 'typed' ? ':auto' : '');\n65:     }\n66:   });\n67: });\n68: \n69: describe('liveArmRefusal', () => {\n70:   const dirs: string[] = [];\n71: \n72:   afterEach(() => {\n73:     for (const dir of dirs.splice(0)) rmSync(dir, { recursive: true, force: true });\n74:   });\n75: \n76:   it('refuses a live arm outside a marked arena', () => {\n77:     const dir = mkdtempSync(join(tmpdir(), 'skilled-behaviour-guard-'));\n78:     dirs.push(dir);\n79:     const runGit = (args: string[]) => spawnSync('git', args, { cwd: dir, encoding: 'utf8' });\n80:     expect(runGit(['init', '-q']).status).toBe(0);\n81: \n82:     expect(liveArmRefusal(dir)?.code).toBe('arena_unprepared');\n83: \n84:     writeFileSync(join(dir, '.git', 'skilled-behaviour-arena'), 'arena\\n');\n85:     expect(liveArmRefusal(dir)).toBeNull();\n86: \n87:     expect(runGit(['remote', 'add', 'origin', 'https://example.invalid/x.git']).status).toBe(0);\n88:     expect(liveArmRefusal(dir)).toEqual({ ok: false, code: 'remote_present', remotes: ['origin'] });\n89:   });\n90: });\n91: \n92: describe('entry guard', () => {\n93:   it('runs the CLI when it is launched through a symlink', () => {\n94:     const dir = mkdtempSync(join(tmpdir(), 'skilled-behaviour-entry-'));\n95:     try {\n96:       const runnerLink = join(dir, 'runner.mjs');\n97:       const scorerLink = join(dir, 'scorer.mjs');\n98:       symlinkSync(\n99:         fileURLToPath(new URL('../scripts/routing-accuracy/run-command-behaviour.mjs', import.meta.url)),\n100:         runnerLink,\n101:       );\n102:       symlinkSync(\n103:         fileURLToPath(new URL('../scripts/routing-accuracy/score-command-transcripts.mjs', import.meta.url)),\n104:         scorerLink,\n105:       );\n106: \n107:       const listed = spawnSync(process.execPath, [runnerLink, '--list', 'g2'], { encoding: 'utf8' });\n108:       expect(listed.status).toBe(0);\n109:       expect(listed.stdout.split('\\n')[0]).toBe('g2-deep-research-ask');\n110: \n111:       const refused = spawnSync(process.execPath, [scorerLink], { encoding: 'utf8' });\n112:       expect(refused.status).toBe(2);\n113:       expect(refused.stderr).toContain('--runtime is required with --locator');\n114:     } finally {\n115:       rmSync(dir, { recursive: true, force: true });\n116:     }\n117:   });\n118: });"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\".skilled/skills/system-skill-advisor/runtime/tests/command-behaviour-guards.vitest.ts\"}"},"time":{"start":1794570643328,"end":1794570643641}}}}
