    ));\n     if (led) return true;\n-    const bareLead = new RegExp(`(?:^|[^a-z0-9_/])${COMMAND_BARE_ASK_LEAD}${name}$`).test(before);\n+    const bareLead = new RegExp(`(?:^|[^a-z0-9_/])${COMMAND_BARE_ASK_LEAD}${COMMAND_OR_LIST}${name}$`).test(before);\n     if (!bareLead) return false;\n     const sentenceEnd = tail.search(/[.!\\n]/);\n     const sentence = sentenceEnd === -1 ? tail : tail.slice(0, sentenceEnd);\n     // A chat question often leaves the question mark off, so a bare ask word that\n     // opens a sentence still asks about the command.\n     return sentence.includes('?')\n-      || new RegExp(`(?:^|[.!?\\\\n] *)${COMMAND_BARE_ASK_LEAD}${name}$`).test(before);\n+      || new RegExp(`(?:^|[.!?\\\\n] *)${COMMAND_BARE_ASK_LEAD}${COMMAND_OR_LIST}${name}$`).test(before);\n   });\n }\n \ndiff --git a/.skilled/skills/system-skill-advisor/runtime/tests/command-attach-guards.vitest.ts b/.skilled/skills/system-skill-advisor/runtime/tests/command-attach-guards.vitest.ts\nindex b49892cb43..d6372a4fd7 100644\n--- a/.skilled/skills/system-skill-advisor/runtime/tests/command-attach-guards.vitest.ts\n+++ b/.skilled/skills/system-skill-advisor/runtime/tests/command-attach-guards.vitest.ts\n@@ -158,6 +158,10 @@ describe('a command the prompt only mentions', () => {\n     ['do not run /deep:review, or /deep:research', '/deep:research'],\n     ['skip /create:agent or /create:readme', '/create:readme'],\n     ['do not run /speckit:plan or /speckit:implement or /speckit:complete', '/speckit:complete'],\n+    ['do not run /create:agent or the /create:readme command', '/create:readme'],\n+    ['do not run /create:agent, or the /create:readme command', '/create:readme'],\n+    ['skip /create:agent or the /create:readme command', '/create:readme'],\n+    ['never use the /create:readme command or the /create:feature-catalog command', '/create:feature-catalog'],\n   ])('reads %s as a refusal of %s through an or-list', (prompt, command) => {\n     expect(commandOnlyMentioned(p