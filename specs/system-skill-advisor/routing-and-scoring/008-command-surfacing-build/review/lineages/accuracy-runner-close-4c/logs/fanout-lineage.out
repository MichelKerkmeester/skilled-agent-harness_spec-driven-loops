ree exact edits are present and match the writers.\\\",\\n      \\\"searchActions\\\": [\\n        {\\n          \\\"method\\\": \\\"exact_grep\\\",\\n          \\\"queryOrPath\\\": \\\"README.md for three fields, carries none of the four and the four-field backfill list\\\",\\n          \\\"result\\\": \\\"three fields has no match; carries none of the four has one at :70; the four-field list has one at :125.\\\",\\n          \\\"evidenceRefs\\\": [\\n            \\\"README.md:70\\\",\\n            \\\"README.md:76\\\",\\n            \\\"README.md:125\\\"\\n          ]\\n        },\\n        {\\n          \\\"method\\\": \\\"direct_read\\\",\\n          \\\"queryOrPath\\\": \\\"run-command-behaviour.mjs:1180-1205\\\",\\n          \\\"result\\\": \\\"The head-moved branch appends before the replay and carries none of the four; the normal append carries all four.\\\",\\n          \\\"evidenceRefs\\\": [\\n            \\\"run-command-behaviour.mjs:1180-1184\\\",\\n            \\\"run-command-behaviour.mjs:1201-1205\\\"\\n          ]\\n        }\\n      ],\\n      \\\"disposition\\\": \\\"ruled_out\\\",\\n      \\\"ruledOutReason\\\": \\\"AR4B-P2-001 and AR4B-P2-002 are fixed by the T030 edits; no third list or exception is missing.\\\",\\n      \\\"rationale\\\": \\\"The two 4b accuracy-runner findings are confirmed fixed.\\\"\\n    },\\n    {\\n      \\\"id\\\": \\\"ARC4C-SL-009\\\",\\n      \\\"dimension\\\": \\\"maintainability\\\",\\n      \\\"targetRefs\\\": [\\n        \\\"specs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/review/verify-4/report.md\\\"\\n      ],\\n      \\\"bugClass\\\": \\\"deferred_scope\\\",\\n      \\\"hypothesis\\\": \\\"The pair-doc, paired-arm and unscoredOnly findings are still open.\\\",\\n      \\\"searchActions\\\": [\\n        {\\n          \\\"method\\\": \\\"direct_read\\\",\\n          \\\"queryOrPath\\\": \\\"027-review-pass-four-remediation/spec.md:204-238\\\",\\n          \\\"result\\\": \\\"The spec defers the pair README sentence, the reserved paired arm name and the dead unscoredOnly count to phase 026.\\\",\\n          \\\"evidenceRefs\\\": [\\n            \\\"027-review-pass-four-remediation/spec.md:214\\\"\\n          ]\\n        }\\n      ],\\n      \\\"disposition\\\": \\\"deferred\\\",\\n      \\\"deferredReason\\\": \\\"The 027 remediation spec assigns these three items to phase 026; re-reporting them here would duplicate a deferred workstream.\\\",\\n      \\\"rationale\\\": \\\"The closing round records them as deferred, not as new findings.\\\"\\n    }\\n  ],\\n  \\\"graphEvents\\\": []\\n}\\n\",\"path\":\"specs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/review/lineages/accuracy-runner-close-4c/logs/iter-002-record.json\"}"},"time":{"start":1794683953327,"end":1794683981211}}}}
