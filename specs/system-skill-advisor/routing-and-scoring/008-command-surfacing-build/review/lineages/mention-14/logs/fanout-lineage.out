    \"blocked\": false,\n    \"iterations\": [\n     1\n    ]\n   },\n   \"typed_command_boundary\": {\n    \"covered\": false,\n    \"ruledOut\": true,\n    \"deferred\": false,\n    \"blocked\": false,\n    \"iterations\": [\n     1\n    ]\n   },\n   \"regex_injection\": {\n    \"covered\": false,\n    \"ruledOut\": true,\n    \"deferred\": false,\n    \"blocked\": false,\n    \"iterations\": [\n     2\n    ]\n   },\n   \"backtracking_dos\": {\n    \"covered\": false,\n    \"ruledOut\": true,\n    \"deferred\": false,\n    \"blocked\": false,\n    \"iterations\": [\n     2\n    ]\n   },\n   \"markup_fold_consent\": {\n    \"covered\": false,\n    \"ruledOut\": true,\n    \"deferred\": false,\n    \"blocked\": false,\n    \"iterations\": [\n     2\n    ]\n   },\n   \"command_name_escaping\": {\n    \"covered\": false,\n    \"ruledOut\": true,\n    \"deferred\": false,\n    \"blocked\": false,\n    \"iterations\": [\n     2\n    ]\n   }\n  }\n },\n \"searchDebt\": [],\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"cd /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research && node -e '\\nconst r=require(\\\"./specs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/review/lineages/mention-14/deep-review-findings-registry.json\\\");\\nconsole.log(JSON.stringify({searchCoverage:r.searchCoverage,candidateCoverage:r.candidateCoverage,searchDebt:r.searchDebt,ruledOutCandidates:r.ruledOutCandidates,cleanSearchProof:r.cleanSearchProof,status:r.status,terminal:r.terminalGates,divergence:r.divergence},null,1));\\n' | head -100\"}"},"time":{"start":1794870087151,"end":1794870088444}}}}
