{"type":"tool_use","timestamp":1794868296738,"sessionID":"ses_e1984dae6ffeaD8lGAJ4oqvNMo","part":{"partID":"prt_1e67cbab6002AchAaflzMyNRLr","sessionID":"ses_e1984dae6ffeaD8lGAJ4oqvNMo","messageID":"msg_1e67caf06001xLoJqOMvzN8msg","type":"tool","id":"call_bb0d9af4ca184a2b82efd44d","tool":"read","state":{"status":"completed","input":{"path":".skilled/skills/system-skill-advisor/runtime/tests/command-attach-guards.vitest.ts"},"output":"Read file .skilled/skills/system-skill-advisor/runtime/tests/command-attach-guards.vitest.ts, lines 1-621\n1: // ───────────────────────────────────────────────────────────────\n2: // MODULE: Command attach guards\n3: // ───────────────────────────────────────────────────────────────\n4: \n5: // A hub route names the command that acts on the mode it picked, so it has to\n6: // honour the same no-edit wording the scorer honours. A reader who rules out a\n7: // change must not be handed a command that changes files.\n8: \n9: import { readFileSync } from 'node:fs';\n10: import { join } from 'node:path';\n11: \n12: import { describe, expect, it } from 'vitest';\n13: \n14: import {\n15:   attachCommand,\n16:   commandOnlyMentioned,\n17:   isNoEditRequest,\n18:   MODE_COMMANDS,\n19:   NO_EDIT_REQUEST,\n20:   typedCommandForTop,\n21:   typedCommandIn,\n22: } from '../lib/command-attach.js';\n23: \n24: // The only route shape that names a command unambiguously: one decision and one\n25: // selected target.\n26: function SINGLE(workflowMode: string): Record<string, unknown> {\n27:   return { action: 'route', selectionKind: 'single', targets: [{ workflowMode }] };\n28: }\n29: \n30: // The endings a reader uses to rule out a change. One writes the contraction\n31: // with a curly apostrophe, which is the form many keyboards produce.\n32: const NOEDIT4 = [\n33:   \"don't change anything yet\",\n34:   'no changes yet',\n35:   'don\\u2019t touch any files',\n36:   'make no changes',\n37: ];\n38: \n39: // The prompts that name a command to refuse it or ask about it, the prompts that\n40: // ask for the command, and the prompts that hold a refusal or question word and\n41: // still ask for the command.\n42: const REFUSE8: ReadonlyArray<readonly [string, string]> = [\n43:   ['do not run /speckit:complete yet, just explain what it does', '/speckit:complete'],\n44:   ['I never want to use /create:agent again, delete the agent file', '/create:agent'],\n45:   ['someone ran /speckit:save by accident, how do I undo what it wrote', '/speckit:save'],\n46:   ['please do not start /deep:research, I only want a two line summary of the readme', '/deep:research'],\n47:   ['what does /create:readme do?', '/create:readme'],\n48:   ['do not run it, just tell me what /doctor:update would change', '/doctor:update'],\n49:   ['explain /deep:review to me', '/deep:review'],\n50:   ['skip /create:readme, just append one line to the existing README', '/create:readme'],\n51: ];\n52: \n53: const QUESTION2: ReadonlyArray<readonly [string, string]> = [\n54:   ['is /speckit:complete overkill for a two line fix?', '/speckit:complete'],\n55:   ['should I use /deep:research for this or just read the two files myself?', '/deep:research'],\n56: ];\n57: \n58: const REQUEST6: ReadonlyArray<readonly [string, string]> = [\n59:   ['run /speckit:complete for the rate limiter', '/speckit:complete'],\n60:   ['/create:agent security-reviewer', '/create:agent'],\n61:   [\"don't forget to run /speckit:save\", '/speckit:save'],\n62:   ['explain the diff then run /speckit:save', '/speckit:save'],\n63:   ['use /speckit:plan, not /speckit:complete', '/speckit:plan'],\n64:   ['I ran /speckit:plan yesterday, now run /speckit:implement', '/speckit:implement'],\n65: ];\n66: \n67: const CONTROL5: ReadonlyArray<readonly [string, string]> = [\n68:   ['dont guess, run /speckit:plan', '/speckit:plan'],\n69:   ['never mind just run /speckit:save', '/speckit:save'],\n70:   ['not sure, use /create:readme', '/create:readme'],\n71:   ['without asking, run /speckit:complete', '/speckit:complete'],\n72:   ['can you run /speckit:plan?', '/speckit:plan'],\n73: ];\n74: \n75: describe('command attach on a no-edit prompt', () => {\n76:   it('offers no hub command when the prompt rules out a change', () => {\n77:     const prompt = 'use sk-doc to create a skill called invoice-parser, do not change anything yet';\n78:     expect(attachCommand('sk-doc', SINGLE('sk-create-skill'), prompt)).toBeUndefined();\n79:   });\n80: \n81:   it('offers the command when the same prompt asks for the change', () => {\n82:     const prompt = 'use sk-doc to create a skill called invoice-parser';\n83:     expect(attachCommand('sk-doc', SINGLE('sk-create-skill'), prompt)).toBe('/create:sk-skill');\n84:   });\n85: \n86:   it('reads the shared no-edit wording', () => {\n87:     expect(NO_EDIT_REQUEST.test('just show me the plan')).toBe(true);\n88:   });\n89: \n90:   it.each(NOEDIT4)('offers no hub command when the prompt ends %s', (ending) => {\n91:     const prompt = 'use sk-doc to create an agent called invoice-parser, ' + ending;\n92:     expect(attachCommand('sk-doc', SINGLE('sk-create-agent'), prompt)).toBeUndefined();\n93:   });\n94: \n95:   it('offers the agent command when the prompt asks for the change', () => {\n96:     const prompt = 'use sk-doc to create an agent called invoice-parser';\n97:     expect(attachCommand('sk-doc', SINGLE('sk-create-agent'), prompt)).toBe('/create:agent');\n98:   });\n99: \n100:   it('reads a curly apostrophe as a straight one', () => {\n101:     expect(isNoEditRequest('Don\\u2019t touch any files')).toBe(true);\n102:     expect(isNoEditRequest('touch the files')).toBe(false);\n103:   });\n104: \n105:   // A change request can say what must stay the same, and that is still a\n106:   // request for the change.\n107:   it.each([\n108:     'refactor the parser so there are no changes to its public api',\n109:     'fix the flaky test and make sure there are no changes in behaviour',\n110:     'create an agent called invoice-parser with no changes to existing agents',\n111:     \"create an agent called invoice-parser, don't add tools\",\n112:     \"refactor the parser, don't delete the old tests\",\n113:   ])('keeps a change request that limits its scope: %s', (prompt) => {\n114:     expect(isNoEditRequest(prompt)).toBe(false);\n115:   });\n116: \n117:   // The phrase reads as no change whatever follows it. The first row is a real\n118:   // no-edit request. The second is a change request that pays for the safe\n119:   // reading by losing its command.\n120:   it.each([\n121:     \"show me the plan, don't make any changes\",\n122:     'walk me through the fix, do not make changes',\n123:     'list the stale docs, dont change anything',\n124:     'use sk-doc to create an agent called invoice-parser, dont create it yet',\n125:     \"outline the readme, don't write anything\",\n126:   ])('reads a refusal to make changes as ruling out a change: %s', (prompt) => {\n127:     expect(isNoEditRequest(prompt)).toBe(true);\n128:   });\n129: \n130:   it.each([\n131:     'show me the plan and make no changes to the files',\n132:     'refactor the parser and make no changes to its public api',\n133:   ])('reads make no changes as ruling out a change: %s', (prompt) => {\n134:     expect(isNoEditRequest(prompt)).toBe(true);\n135:   });\n136: });\n137: \n138: describe('a command the prompt only mentions', () => {\n139:   it.each(REFUSE8)('reads %s as a mention of %s', (prompt, command) => {\n140:     expect(commandOnlyMentioned(prompt, command)).toBe(true);\n141:   });\n142: \n143:   it.each(QUESTION2)('reads the question %s as a mention of %s', (prompt, command) => {\n144:     expect(commandOnlyMentioned(prompt, command)).toBe(true);\n145:   });\n146: \n147:   it.each(REQUEST6)('reads %s as a request for %s', (prompt, command) => {\n148:     expect(commandOnlyMentioned(prompt, command)).toBe(false);\n149:   });\n150: \n151:   it.each(CONTROL5)('reads %s as a request for %s beside a refusal word', (prompt, command) => {\n152:     expect(commandOnlyMentioned(prompt, command)).toBe(false);\n153:   });\n154: \n155:   it.each([\n156:     ['do not run /create:agent or /create:readme', '/create:readme'],\n157:     ['never use /create:readme or /create:feature-catalog', '/create:feature-catalog'],\n158:     ['do not run /deep:review, or /deep:research', '/deep:research'],\n159:     ['skip /create:agent or /create:readme', '/create:readme'],\n160:     ['do not run /speckit:plan or /speckit:implement or /speckit:complete', '/speckit:complete'],\n161:     ['do not run /create:agent or the /create:readme command', '/create:readme'],\n162:     ['do not run /create:agent, or the /create:readme command', '/create:readme'],\n163:     ['skip /create:agent or the /create:readme command', '/create:readme'],\n164:     ['never use the /create:readme command or the /create:feature-catalog command', '/create:feature-catalog'],\n165:     ['do not run /doctor:ci report or /create:readme', '/create:readme'],\n166:     ['do not run /doctor:ci report or /doctor:ci scaffold', '/doctor:ci scaffold'],\n167:     ['never use /doctor:git hooks or /doctor:skill-advisor tune', '/doctor:skill-advisor tune'],\n168:   ])('reads %s as a refusal of %s through an or-list', (prompt, command) => {\n169:     expect(commandOnlyMentioned(prompt, command)).toBe(true);\n170:   });\n171: \n172:   // Chat wraps a command name in code, quote or bold marks, and a renamed command\n173:   // is still typed under its old name. Neither may change what the naming reads\n174:   // as, so every fixture must read the same wrapped or retired as it does plain.\n175:   const WRAPPERS: ReadonlyArray<readonly [string, string]> = [\n176:     ['`', '`'], [\"'\", \"'\"], ['\"', '\"'], ['\\u201c', '\\u201d'], ['\\u2018', '\\u2019'], ['**', '**'],\n177:     ['[', ']'], ['(', ')'], ['~~', '~~'], ['<code>', '</code>'], ['\\u00ab', '\\u00bb'], ['\\u2032', '\\u2032'],\n178:   ];\n179:   const PLAIN_ROWS = [...REFUSE8, ...QUESTION2, ...REQUEST6, ...CONTROL5,\n180:     ['do not run /create:agent or /create:readme', '/create:readme'],\n181:     ['skip /create:agent or the /create:readme command', '/create:readme'],\n182:   ] as const;\n183: \n184:   it.each(WRAPPERS)('reads every fixture wrapped in %s the same as plain', (open, close) => {\n185:     for (const [prompt, command] of PLAIN_ROWS) {\n186:       const wrapped = prompt.replace(/\\/[a-z][a-z-]*:[a-z][a-z-]*/g, (name) => `${open}${name}${close}`);\n187:       expect(commandOnlyMentioned(wrapped, command), wrapped).toBe(commandOnlyMentioned(prompt, command));\n188:     }\n189:   });\n190: \n191:   it('reads every fixture under the retired name the same as under the current one', () => {\n192:     for (const [prompt, command] of PLAIN_ROWS) {\n193:       const plain = prompt.split(command).join('/create:sk-skill');\n194:       const retired = prompt.split(command).join('/create:skill');\n195:       expect(commandOnlyMentioned(retired, '/create:sk-skill'), retired)\n196:         .toBe(commandOnlyMentioned(plain, '/create:sk-skill'));\n197:     }\n198:   });\n199: \n200:   // A refusal can follow the name it refuses, so the words after a naming are\n201:   // read for a refusal of \"it\" as well as for a request.\n202:   it.each([\n203:     ['/create:readme is not what I want, do not run it', '/create:readme'],\n204:     ['run /doctor:git setup but do not actually run it', '/doctor:git setup'],\n205:     [\"/speckit:complete came up, but please don't start it\", '/speckit:complete'],\n206:   ])('reads the later refusal in %s as a mention of %s', (prompt, command) => {\n207:     expect(commandOnlyMentioned(prompt, command)).toBe(true);\n208:   });\n209: \n210:   it.each([\n211:     [\"run /speckit:save and don't skip it\", '/speckit:save'],\n212:     [\"run /speckit:save and don't run it twice\", '/speckit:save'],\n213:     ['run /deep:review but never run it without a budget', '/deep:review'],\n214:     ['open the /deep:review command file, then run it', '/deep:review'],\n215:     ['read the /deep:review docs, then do a thorough review of this diff', '/deep:review'],\n216:   ])('still reads %s as a request for %s', (prompt, command) => {\n217:     expect(commandOnlyMentioned(prompt, command)).toBe(false);\n218:   });\n219: \n220:   // A command named as a document is being read about, not run.\n221:   it.each([\n222:     ['read the /create:readme document and tell me what it does', '/create:readme'],\n223:     ['open the /deep:review command file and summarize it', '/deep:review'],\n224:   ])('reads %s as a mention of %s', (prompt, command) => {\n225:     expect(commandOnlyMentioned(prompt, command)).toBe(true);\n226:   });\n227: \n228:   it('still reads a typed command whose argument is a file as a request', () => {\n229:     expect(commandOnlyMentioned('/create:diff file a.md b.md', '/create:diff')).toBe(false);\n230:   });\n231: \n232:   // A doc path that holds the name is a file, not a naming, so it cannot undo the\n233:   // refusal of the command itself.\n234:   it('reads a led refusal beside a doc path of the same command as a mention', () => {\n235:     expect(commandOnlyMentioned('do not run /create:readme, read /create:readme.md', '/create:readme')).toBe(true);\n236:   });\n237: \n238:   // Markup around the name must not hide the lead before it.\n239:   it.each([\n240:     ['do not run `/create:readme`, just tell me what it covers', '/create:readme'],\n241:     ['what does `/create:readme` do?', '/create:readme'],\n242:     ['never use **/deep:review** here', '/deep:review'],\n243:     ['do not run \"/create:readme\" yet', '/create:readme'],\n244:     [\"do not run '/create:readme' yet\", '/create:readme'],\n245:     [\"what's '/create:readme' for?\", '/create:readme'],\n246:     ['never use ‘/deep:review’ here', '/deep:review'],\n247:     ['do not run “/create:readme” yet', '/create:readme'],\n248:   ])('reads the marked-up %s as a mention of %s', (prompt, command) => {\n249:     expect(commandOnlyMentioned(prompt, command)).toBe(true);\n250:   });\n251: \n252:   it('still reads a marked-up request as a request', () => {\n253:     expect(commandOnlyMentioned('run `/create:readme` for the advisor skill', '/create:readme')).toBe(false);\n254:     expect(commandOnlyMentioned(\"run '/create:readme' for the advisor skill\", '/create:readme')).toBe(false);\n255:     expect(commandOnlyMentioned(\"don't skip '/create:readme', run it\", '/create:readme')).toBe(false);\n256:   });\n257: \n258:   it.each([\n259:     [\"do not run '/create:agent' or '/create:readme'\", '/create:readme'],\n260:     [\"do not run '/doctor:ci report' or '/create:readme'\", '/create:readme'],\n261:   ])('reads the quoted or-list %s as a refusal of %s', (prompt, command) => {\n262:     expect(commandOnlyMentioned(prompt, command)).toBe(true);\n263:   });\n264: \n265:   // A retired name maps to the command that replaced it, so refusing the old\n266:   // spelling refuses the new command too.\n267:   it('reads a refusal of a retired name as a refusal of its replacement', () => {\n268:     expect(commandOnlyMentioned('do not run /create:skill', '/create:sk-skill')).toBe(true);\n269:     expect(commandOnlyMentioned('what does /create:skill do?', '/create:sk-skill')).toBe(true);\n270:     expect(commandOnlyMentioned('run /create:skill for my new helper', '/create:sk-skill')).toBe(false);\n271:   });\n272: \n273:   it.each([\n274:     ['use /create:agent or /create:readme', '/create:agent'],\n275:     ['use /create:agent or /create:readme', '/create:readme'],\n276:     ['use /speckit:plan, not /speckit:complete', '/speckit:plan'],\n277:     ['do not run /speckit:complete, run /speckit:plan or /speckit:implement', '/speckit:plan'],\n278:     ['do not run /speckit:complete, run /speckit:plan or /speckit:implement', '/speckit:implement'],\n279:     ['do not run /speckit:complete or run /speckit:plan', '/speckit:plan'],\n280:     ['use /create:agent or the /create:readme command', '/create:readme'],\n281:     ['the next step is /create:agent or /create:readme', '/create:readme'],\n282:     ['use /doctor:ci report or /create:readme', '/create:readme'],\n283:   ])('still reads %s as a request for %s beside an or-list', (prompt, command) => {\n284:     expect(commandOnlyMentioned(prompt, command)).toBe(false);\n285:   });\n286: \n287:   // A bare lead opens a statement as often as a question, so it marks a mention\n288:   // only before a question. One led occurrence does not make a request either\n289:   // when a later occurrence of the same command is not led.\n290:   it.each([\n291:     ['the next step is /speckit:implement', '/speckit:implement'],\n292:     ['the next step is the /speckit:implement command', '/speckit:implement'],\n293:     ['is this right? run /speckit:plan', '/speckit:plan'],\n294:     ['the next step is /speckit:implement\\nany questions?', '/speckit:implement'],\n295:     ['what does /speckit:save do? ok now run /speckit:save', '/speckit:save'],\n296:     ['the plan is /speckit:plan then tests', '/speckit:plan'],\n297:   ])('reads %s as a request for %s', (prompt, command) => {\n298:     expect(commandOnlyMentioned(prompt, command)).toBe(false);\n299:   });\n300: \n301:   // A chat question often leaves the question mark off, so a bare ask word that\n302:   // opens a sentence still marks the command as the subject.\n303:   it.each([\n304:     ['is /speckit:resume safe to run twice', '/speckit:resume'],\n305:     ['does /doctor:git change files or just report problems', '/doctor:git'],\n306:     ['can /prompt:improve make a vague request easier to follow', '/prompt:improve'],\n307:     ['ok. is /speckit:plan enough here', '/speckit:plan'],\n308:     ['quick question? is /speckit:resume safe to run twice', '/speckit:resume'],\n309:     ['Is the /doctor:update command safe?', '/doctor:update'],\n310:   ])('reads %s as a question about %s', (prompt, command) => {\n311:     expect(commandOnlyMentioned(prompt, command)).toBe(true);\n312:   });\n313: \n314:   it.each([\n315:     ['should I run /create:agent or /create:readme?', '/create:readme'],\n316:     ['is /create:agent or /create:readme better?', '/create:readme'],\n317:     ['what does /create:agent or /create:readme do?', '/create:readme'],\n318:   ])('reads %s as a question about %s through an or-list', (prompt, command) => {\n319:     expect(commandOnlyMentioned(prompt, command)).toBe(true);\n320:   });\n321: \n322:   it('reads each command of a two-command prompt on its own', () => {\n323:     expect(commandOnlyMentioned('use /speckit:plan, not /speckit:complete', '/speckit:complete')).toBe(true);\n324:   });\n325: \n326:   it('reads a curly apostrophe as a straight one', () => {\n327:     expect(commandOnlyMentioned('don\\u2019t run /speckit:save', '/speckit:save')).toBe(true);\n328:   });\n329: \n330:   it('reads no need to run as a refusal of the command', () => {\n331:     expect(commandOnlyMentioned('no need to run /doctor:setup, the hooks are fine', '/doctor:setup')).toBe(true);\n332:   });\n333: \n334:   it('still reads a request after no need to ask', () => {\n335:     expect(commandOnlyMentioned('no need to ask, run /speckit:save', '/speckit:save')).toBe(false);\n336:   });\n337: \n338:   it('reads stop using as a refusal of the command', () => {\n339:     expect(commandOnlyMentioned('stop using /create:changelog for this, write the changelog entry by hand', '/create:changelog')).toBe(true);\n340:   });\n341: \n342:   it('still reads a request after stop and', () => {\n343:     expect(commandOnlyMentioned('stop and run /speckit:plan', '/speckit:plan')).toBe(false);\n344:   });\n345: \n346:   it('reads why not use as a request for the command', () => {\n347:     expect(commandOnlyMentioned('why not use /create:agent for this? go ahead and make a security reviewer agent', '/create:agent')).toBe(false);\n348:   });\n349: \n350:   it.each([\n351:     ['I have not run /speckit:plan yet, please start it for the login feature', '/speckit:plan'],\n352:     ['I already ran /create:readme but the output was wrong, run it again for the hooks folder', '/create:readme'],\n353:     ['not run /speckit:plan yet, write notes to /tmp/notes.md, then run it', '/speckit:plan'],\n354:     ['not run /speckit:plan yet, read https://example.com/spec first, then run it', '/speckit:plan'],\n355:   ])('reads %s as a request for %s made by a later clause', (prompt, command) => {\n356:     expect(commandOnlyMentioned(prompt, command)).toBe(false);\n357:   });\n358: \n359:   it.each([\n360:     ['do not run /speckit:complete, I will run it myself later', '/speckit:complete'],\n361:     ['do not use /create:agent, use that other one', '/create:agent'],\n362:     ['do not run /speckit:complete, run /speckit:plan for the rate limiter instead', '/speckit:complete'],\n363:     ['do not run /speckit:complete, run /speckit:plan, then run it for the auth module', '/speckit:complete'],\n364:   ])('still reads %s as a mention of %s', (prompt, command) => {\n365:     expect(commandOnlyMentioned(prompt, command)).toBe(true);\n366:   });\n367: \n368:   it('does not read a longer command name as the shorter one', () => {\n369:     expect(commandOnlyMentioned('do not run /create:sk-skill-parent', '/create:sk-skill')).toBe(false);\n370:   });\n371: \n372:   it.each([\n373:     'what does /create:readme do?',\n374:     'skip /create:readme, just append one line to the existing README',\n375:     'do not run /create:agent or /create:readme',\n376:   ])('offers no hub command for %s', (prompt) => {\n377:     expect(attachCommand('sk-doc', SINGLE('sk-create-readme'), prompt)).toBeUndefined();\n378:   });\n379: \n380:   it('offers no deep-loop command the prompt refuses', () => {\n381:     const deepLoopModes = MODE_COMMANDS['system-deep-loop'];\n382:     const mode = Object.keys(deepLoopModes).find((key) => deepLoopModes[key] === '/deep:research');\n383:     expect(mode, 'the generated table names the research mode').toBeDefined();\n384:     expect(attachCommand('system-deep-loop', SINGLE(mode!), 'please do not start /deep:research, I only want a two line summary of the readme')).toBeUndefined();\n385:   });\n386: \n387:   it('still offers the hub command a plain request routes to', () => {\n388:     expect(attachCommand('sk-doc', SINGLE('sk-create-readme'), 'write a readme for the doctor scripts folder')).toBe('/create:readme');\n389:   });\n390: });\n391: \n392: describe('command attach on a small edit', () => {\n393:   it.each([\n394:     'update the README typo in line 3',\n395:     'fix the typo in the README',\n396:     'correct the spelling in the hooks readme',\n397:     'fix the broken link in the install guide readme',\n398:   ])('offers no creation command for %s', (prompt) => {\n399:     expect(attachCommand('sk-doc', SINGLE('sk-create-readme'), prompt)).toBeUndefined();\n400:   });\n401: \n402:   it.each([\n403:     'write a readme for the doctor scripts folder',\n404:     'create a readme for the payments module, check it for typos when done',\n405:   ])('still offers the creation command for %s', (prompt) => {\n406:     expect(attachCommand('sk-doc', SINGLE('sk-create-readme'), prompt)).toBe('/create:readme');\n407:   });\n408: \n409:   it.each([\n410:     ['sk-doc', 'sk-create-agent', 'build an agent that fixes typos in our docs'],\n411:     ['sk-doc', 'sk-create-readme', 'writing a readme for the grammar module'],\n412:     ['sk-doc', 'sk-create-readme', 'add a readme for the spelling package'],\n413:     ['sk-doc', 'sk-create-changelog', 'add a changelog entry for the typo fixes in the cli help'],\n414:   ])('still offers the creation command on %s %s for %s', (skill, mode, prompt) => {\n415:     expect(attachCommand(skill, SINGLE(mode), prompt)).toBe(MODE_COMMANDS[skill][mode]);\n416:   });\n417: \n418:   it('leaves the wording commands outside the gate', () => {\n419:     const docModes = MODE_COMMANDS['sk-doc'];\n420:     const mode = Object.keys(docModes).find((key) => docModes[key] === '/create:with-human-voice');\n421:     expect(mode, 'the generated table names the human voice mode').toBeDefined();\n422:     expect(attachCommand('sk-doc', SINGLE(mode!), 'humanize the wording in the onboarding guide')).toBe('/create:with-human-voice');\n423:   });\n424: \n425:   it.each([\n426:     ['sk-create-changelog', 'changelog for v2.1, it fixes the broken link checker and spelling errors'],\n427:     ['sk-create-changelog', 'log the spelling fixes in the changelog'],\n428:     ['sk-create-readme', 'document the cli in a readme, each flag gets a one line description'],\n429:     ['sk-create-readme', 'readme for the spelling package'],\n430:     ['sk-create-agent', 'an agent that fixes typos'],\n431:   ])('keeps the creation command for %s on %s', (mode, prompt) => {\n432:     expect(attachCommand('sk-doc', SINGLE(mode), prompt)).toBe(MODE_COMMANDS['sk-doc'][mode]);\n433:   });\n434: \n435:   it('keeps the goal command when the goal is about fixes', () => {\n436:     const docModes = MODE_COMMANDS['sk-doc'];\n437:     const mode = Object.keys(docModes).find((key) => docModes[key] === '/create:goal');\n438:     expect(mode, 'the generated table names the goal mode').toBeDefined();\n439:     expect(attachCommand('sk-doc', SINGLE(mode!), 'set a goal to fix all the typos in the docs')).toBe('/create:goal');\n440:   });\n441: \n442:   it.each([\n443:     'fix the broken links in the install guide readme',\n444:     'fix the dead links in the hooks readme',\n445:   ])('offers no creation command for %s', (prompt) => {\n446:     expect(attachCommand('sk-doc', SINGLE('sk-create-readme'), prompt)).toBeUndefined();\n447:   });\n448: \n449:   it('leaves a command outside the create namespace alone', () => {\n450:     const deepLoopModes = MODE_COMMANDS['system-deep-loop'];\n451:     const mode = Object.keys(deepLoopModes).find((key) => deepLoopModes[key] === '/deep:review');\n452:     expect(mode, 'the generated table names the review mode').toBeDefined();\n453:     expect(attachCommand('system-deep-loop', SINGLE(mode!), 'do a thorough deep review of the typo handling')).toBe('/deep:review');\n454:   });\n455: \n456:   it.each([\n457:     ['sk-create-agent', 'an agent to fix typos'],\n458:     ['sk-create-agent', 'give me an agent to fix broken links in the docs'],\n459:     ['sk-create-agent', 'I want an agent to correct spelling in pull requests'],\n460:   ])('keeps the creation command for %s on %s', (mode, prompt) => {\n461:     expect(attachCommand('sk-doc', SINGLE(mode), prompt)).toBe(MODE_COMMANDS['sk-doc'][mode]);\n462:   });\n463: \n464:   // A skill or a command names its own purpose, so a correction word inside that\n465:   // purpose is the reason the artifact exists and not a request to edit one.\n466:   it.each([\n467:     ['/create:sk-skill', 'a skill to correct spelling in markdown'],\n468:     ['/create:command', \"I'd like a command to fix dead links\"],\n469:   ])('keeps the command %s on %s', (command, prompt) => {\n470:     const docModes = MODE_COMMANDS['sk-doc'];\n471:     const mode = Object.keys(docModes).find((key) => docModes[key] === command);\n472:     expect(mode, 'the generated table names the ' + command + ' mode').toBeDefined();\n473:     expect(attachCommand('sk-doc', SINGLE(mode!), prompt)).toBe(command);\n474:   });\n475: \n476:   // A repo rule or a benchmark also names its purpose the way an agent does, so\n477:   // the correction word belongs to what the artifact is for rather than to an\n478:   // edit of a document that already exists.\n479:   it.each([\n480:     'I want a repo rule that says fix typos in the same commit',\n481:     'repo rule: always fix typos in the same commit',\n482:   ])('keeps the repo-rule command on %s', (prompt) => {\n483:     const docModes = MODE_COMMANDS['sk-doc'];\n484:     const mode = Object.keys(docModes).find((key) => docModes[key] === '/create:repo-rule');\n485:     expect(mode, 'the generated table names the repo rule mode').toBeDefined();\n486:     expect(attachCommand('sk-doc', SINGLE(mode!), prompt)).toBe('/create:repo-rule');\n487:   });\n488: \n489:   it('keeps the benchmark command on benchmark how fast we fix typos', () => {\n490:     const docModes = MODE_COMMANDS['sk-doc'];\n491:     const mode = Object.keys(docModes).find((key) => docModes[key] === '/create:benchmark');\n492:     expect(mode, 'the generated table names the benchmark mode').toBeDefined();\n493:     expect(attachCommand('sk-doc', SINGLE(mode!), 'benchmark how fast we fix typos')).toBe('/create:benchmark');\n494:   });\n495: });\n496: \n497: describe('command attach on a deep-loop prompt', () => {\n498:   it('withholds the review command when another deep-loop command is named', () => {\n499:     expect(attachCommand('system-deep-loop', SINGLE('review'), 'what did /deep:ai-council decide')).toBeUndefined();\n500:   });\n501: \n502:   it('withholds the review command when an unknown deep-loop command is named', () => {\n503:     expect(attachCommand('system-deep-loop', SINGLE('review'), 'what did /deep:reviw decide')).toBeUndefined();\n504:   });\n505: \n506:   it('offers the review command when it is the command typed', () => {\n507:     expect(attachCommand('system-deep-loop', SINGLE('review'), 'run /deep:review now')).toBe('/deep:review');\n508:   });\n509: \n510:   it('offers the review command when the prompt asks for depth', () => {\n511:     expect(attachCommand('system-deep-loop', SINGLE('review'), 'review the parser in depth')).toBe('/deep:review');\n512:   });\n513: });\n514: \n515: describe('typed command boundaries', () => {\n516:   it('does not read a file name with an extension as a typed command', () => {\n517:     expect(typedCommandIn('see /create:sk-skill.md for details')).toBeUndefined();\n518:   });\n519: \n520:   it('does not read a path segment as a typed command', () => {\n521:     expect(typedCommandIn('open /create:readme/notes.txt')).toBeUndefined();\n522:   });\n523: \n524:   it.each([\n525:     ['run **/deep:review** now', '/deep:review'],\n526:     ['run [/deep:review] now', '/deep:review'],\n527:     ['run \\u201c/deep:review\\u201d now', '/deep:review'],\n528:     ['run <code>/deep:review</code> now', '/deep:review'],\n529:   ])('finds the command wrapped in %s', (prompt, command) => {\n530:     expect(typedCommandIn(prompt)).toBe(command);\n531:   });\n532: \n533:   it('reads a command that ends a sentence', () => {\n534:     expect(typedCommandIn('run /create:sk-skill.')).toBe('/create:sk-skill');\n535:   });\n536: \n537:   it('reads a command followed by a comma', () => {\n538:     expect(typedCommandIn('run /create:sk-skill, then stop')).toBe('/create:sk-skill');\n539:   });\n540: \n541:   it('reads the longest command when a prefix also matches', () => {\n542:     expect(typedCommandIn('/create:skill-parent now')).toBe('/create:skill-parent');\n543:   });\n544: \n545:   it('reads a command typed with its mode suffix', () => {\n546:     expect(typedCommandIn('/deep:review:auto review the diff')).toBe('/deep:review');\n547:     expect(typedCommandIn('/speckit:plan:confirm add a login page')).toBe('/speckit:plan');\n548:     expect(typedCommandIn('/speckit:implement:autopilot')).toBe('/speckit:implement');\n549:     expect(typedCommandIn('/speckit:implement:unattended the login spec')).toBe('/speckit:implement');\n550:   });\n551: \n552:   it('reads a command typed with a with-modifier or a chain of suffixes', () => {\n553:     expect(typedCommandIn('/speckit:complete:with-research the login spec')).toBe('/speckit:complete');\n554:     expect(typedCommandIn('/speckit:complete:with-context the login spec')).toBe('/speckit:complete');\n555:     expect(typedCommandIn('/speckit:complete:auto:with-research the login spec')).toBe('/speckit:complete');\n556:     expect(typedCommandIn('/speckit:plan:with-phases a login page')).toBe('/speckit:plan');\n557:   });\n558: \n559:   // The suffix rule is shared by every tracked command, so a modifier typed on a\n560:   // command whose hint does not list it still names that command.\n561:   it('reads a with-modifier on a command whose hint does not list it as that command', () => {\n562:     expect(typedCommandIn('/deep:review:with-research the diff')).toBe('/deep:review');\n563:   });\n564: \n565:   it('does not read a command followed by an unknown suffix', () => {\n566:     expect(typedCommandIn('/deep:review:automation notes')).toBeUndefined();\n567:     expect(typedCommandIn('/create:readme:draft')).toBeUndefined();\n568:     expect(typedCommandIn('/speckit:complete:with-everything now')).toBeUndefined();\n569:     expect(typedCommandIn('/speckit:complete:auto:draft now')).toBeUndefined();\n570:     // The chain must abut the name, so a known suffix after an unknown one is refused.\n571:     expect(typedCommandIn('/speckit:complete:draft:auto now')).toBeUndefined();\n572:   });\n573: \n574:   it('attaches the deep-loop command typed with its mode suffix', () => {\n575:     expect(attachCommand('system-deep-loop', SINGLE('review'), '/deep:review:auto review the diff')).toBe('/deep:review');\n576:   });\n577: \n578:   it('reads a retired command name as the command that replaced it', () => {\n579:     expect(typedCommandIn('/create:skill')).toBe('/create:sk-skill');\n580:     expect(typedCommandIn('/create:skill make a linting skill')).toBe('/create:sk-skill');\n581:     expect(typedCommandForTop('sk-doc', '/create:skill')).toEqual({\n582:       command: '/create:sk-skill',\n583:       policy: 'start',\n584:       ownerSkillId: 'sk-doc',\n585:     });\n586:   });\n587: \n588:   it('does not read a retired name inside a path', () => {\n589:     expect(typedCommandIn('open docs/create:skill.md')).toBeUndefined();\n590:   });\n591: \n592:   it('carries no command when the prompt only names a file', () => {\n593:     expect(typedCommandForTop('sk-doc', 'open /create:readme.md and summarise it')).toBeUndefined();\n594:   });\n595: \n596:   it('delivers no typed command the prompt refuses', () => {\n597:     expect(typedCommandForTop('system-spec-kit', 'do not run /speckit:complete yet, just explain what it does')).toBeUndefined();\n598:   });\n599: \n600:   it('still delivers a typed command the prompt asks for', () => {\n601:     expect(typedCommandForTop('system-spec-kit', 'run /speckit:complete for the rate limiter')?.command).toBe('/speckit:complete');\n602:   });\n603: });\n604: \n605: describe('generated command table', () => {\n606:   it('holds no separate policy table', async () => {\n607:     expect('COMMAND_POLICIES' in await import('../lib/command-attach.js')).toBe(false);\n608:   });\n609: \n610:   it('the command-bridges README names every command row field', () => {\n611:     const source = readFileSync(join(import.meta.dirname, '../lib/command-attach.ts'), 'utf8');\n612:     const readme = readFileSync(join(import.meta.dirname, '../scripts/command-bridges/README.md'), 'utf8');\n613:     const interfaceBlock = /export interface CommandRow \\{([\\s\\S]*?)\\n\\}/.exec(source)?.[1] ?? '';\n614:     const fields = [...interfaceBlock.matchAll(/readonly (\\w+)\\??:/g)].map((match) => match[1]);\n615:     expect(fields).toEqual(['command', 'policy', 'mutating', 'ownerSkillId']);\n616:     const sentence = /Each row carries [^\\n]*/.exec(readme)?.[0] ?? '';\n617:     for (const field of fields) {\n618:       expect(sentence).toContain('`' + field + '`');\n619:     }\n620:   });\n621: });","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file .skilled/skills/system-skill-advisor/runtime/tests/command-attach-guards.vitest.ts, lines 1-621\n1: // ───────────────────────────────────────────────────────────────\n2: // MODULE: Command attach guards\n3: // ───────────────────────────────────────────────────────────────\n4: \n5: // A hub route names the command that acts on the mode it picked, so it has to\n6: // honour the same no-edit wording the scorer honours. A reader who rules out a\n7: // change must not be handed a command that changes files.\n8: \n9: import { readFileSync } from 'node:fs';\n10: import { join } from 'node:path';\n11: \n12: import { describe, expect, it } from 'vitest';\n13: \n14: import {\n15:   attachCommand,\n16:   commandOnlyMentioned,\n17:   isNoEditRequest,\n18:   MODE_COMMANDS,\n19:   NO_EDIT_REQUEST,\n20:   typedCommandForTop,\n21:   typedCommandIn,\n22: } from '../lib/command-attach.js';\n23: \n24: // The only route shape that names a command unambiguously: one decision and one\n25: // selected target.\n26: function SINGLE(workflowMode: string): Record<string, unknown> {\n27:   return { action: 'route', selectionKind: 'single', targets: [{ workflowMode }] };\n28: }\n29: \n30: // The endings a reader uses to rule out a change. One writes the contraction\n31: // with a curly apostrophe, which is the form many keyboards produce.\n32: const NOEDIT4 = [\n33:   \"don't change anything yet\",\n34:   'no changes yet',\n35:   'don\\u2019t touch any files',\n36:   'make no changes',\n37: ];\n38: \n39: // The prompts that name a command to refuse it or ask about it, the prompts that\n40: // ask for the command, and the prompts that hold a refusal or question word and\n41: // still ask for the command.\n42: const REFUSE8: ReadonlyArray<readonly [string, string]> = [\n43:   ['do not run /speckit:complete yet, just explain what it does', '/speckit:complete'],\n44:   ['I never want to use /create:agent again, delete the agent file', '/create:agent'],\n45:   ['someone ran /speckit:save by accident, how do I undo what it wrote', '/speckit:save'],\n46:   ['please do not start /deep:research, I only want a two line summary of the readme', '/deep:research'],\n47:   ['what does /create:readme do?', '/create:readme'],\n48:   ['do not run it, just tell me what /doctor:update would change', '/doctor:update'],\n49:   ['explain /deep:review to me', '/deep:review'],\n50:   ['skip /create:readme, just append one line to the existing README', '/create:readme'],\n51: ];\n52: \n53: const QUESTION2: ReadonlyArray<readonly [string, string]> = [\n54:   ['is /speckit:complete overkill for a two line fix?', '/speckit:complete'],\n55:   ['should I use /deep:research for this or just read the two files myself?', '/deep:research'],\n56: ];\n57: \n58: const REQUEST6: ReadonlyArray<readonly [string, string]> = [\n59:   ['run /speckit:complete for the rate limiter', '/speckit:complete'],\n60:   ['/create:agent security-reviewer', '/create:agent'],\n61:   [\"don't forget to run /speckit:save\", '/speckit:save'],\n62:   ['explain the diff then run /speckit:save', '/speckit:save'],\n63:   ['use /speckit:plan, not /speckit:complete', '/speckit:plan'],\n64:   ['I ran /speckit:plan yesterday, now run /speckit:implement', '/speckit:implement'],\n65: ];\n66: \n67: const CONTROL5: ReadonlyArray<readonly [string, string]> = [\n68:   ['dont guess, run /speckit:plan', '/speckit:plan'],\n69:   ['never mind just run /speckit:save', '/speckit:save'],\n70:   ['not sure, use /create:readme', '/create:readme'],\n71:   ['without asking, run /speckit:complete', '/speckit:complete'],\n72:   ['can you run /speckit:plan?', '/speckit:plan'],\n73: ];\n74: \n75: describe('command attach on a no-edit prompt', () => {\n76:   it('offers no hub command when the prompt rules out a change', () => {\n77:     const prompt = 'use sk-doc to create a skill called invoice-parser, do not change anything yet';\n78:     expect(attachCommand('sk-doc', SINGLE('sk-create-skill'), prompt)).toBeUndefined();\n79:   });\n80: \n81:   it('offers the command when the same prompt asks for the change', () => {\n82:     const prompt = 'use sk-doc to create a skill called invoice-parser';\n83:     expect(attachCommand('sk-doc', SINGLE('sk-create-skill'), prompt)).toBe('/create:sk-skill');\n84:   });\n85: \n86:   it('reads the shared no-edit wording', () => {\n87:     expect(NO_EDIT_REQUEST.test('just show me the plan')).toBe(true);\n88:   });\n89: \n90:   it.each(NOEDIT4)('offers no hub command when the prompt ends %s', (ending) => {\n91:     const prompt = 'use sk-doc to create an agent called invoice-parser, ' + ending;\n92:     expect(attachCommand('sk-doc', SINGLE('sk-create-agent'), prompt)).toBeUndefined();\n93:   });\n94: \n95:   it('offers the agent command when the prompt asks for the change', () => {\n96:     const prompt = 'use sk-doc to create an agent called invoice-parser';\n97:     expect(attachCommand('sk-doc', SINGLE('sk-create-agent'), prompt)).toBe('/create:agent');\n98:   });\n99: \n100:   it('reads a curly apostrophe as a straight one', () => {\n101:     expect(isNoEditRequest('Don\\u2019t touch any files')).toBe(true);\n102:     expect(isNoEditRequest('touch the files')).toBe(false);\n103:   });\n104: \n105:   // A change request can say what must stay the same, and that is still a\n106:   // request for the change.\n107:   it.each([\n108:     'refactor the parser so there are no changes to its public api',\n109:     'fix the flaky test and make sure there are no changes in behaviour',\n110:     'create an agent called invoice-parser with no changes to existing agents',\n111:     \"create an agent called invoice-parser, don't add tools\",\n112:     \"refactor the parser, don't delete the old tests\",\n113:   ])('keeps a change request that limits its scope: %s', (prompt) => {\n114:     expect(isNoEditRequest(prompt)).toBe(false);\n115:   });\n116: \n117:   // The phrase reads as no change whatever follows it. The first row is a real\n118:   // no-edit request. The second is a change request that pays for the safe\n119:   // reading by losing its command.\n120:   it.each([\n121:     \"show me the plan, don't make any changes\",\n122:     'walk me through the fix, do not make changes',\n123:     'list the stale docs, dont change anything',\n124:     'use sk-doc to create an agent called invoice-parser, dont create it yet',\n125:     \"outline the readme, don't write anything\",\n126:   ])('reads a refusal to make changes as ruling out a change: %s', (prompt) => {\n127:     expect(isNoEditRequest(prompt)).toBe(true);\n128:   });\n129: \n130:   it.each([\n131:     'show me the plan and make no changes to the files',\n132:     'refactor the parser and make no changes to its public api',\n133:   ])('reads make no changes as ruling out a change: %s', (prompt) => {\n134:     expect(isNoEditRequest(prompt)).toBe(true);\n135:   });\n136: });\n137: \n138: describe('a command the prompt only mentions', () => {\n139:   it.each(REFUSE8)('reads %s as a mention of %s', (prompt, command) => {\n140:     expect(commandOnlyMentioned(prompt, command)).toBe(true);\n141:   });\n142: \n143:   it.each(QUESTION2)('reads the question %s as a mention of %s', (prompt, command) => {\n144:     expect(commandOnlyMentioned(prompt, command)).toBe(true);\n145:   });\n146: \n147:   it.each(REQUEST6)('reads %s as a request for %s', (prompt, command) => {\n148:     expect(commandOnlyMentioned(prompt, command)).toBe(false);\n149:   });\n150: \n151:   it.each(CONTROL5)('reads %s as a request for %s beside a refusal word', (prompt, command) => {\n152:     expect(commandOnlyMentioned(prompt, command)).toBe(false);\n153:   });\n154: \n155:   it.each([\n156:     ['do not run /create:agent or /create:readme', '/create:readme'],\n157:     ['never use /create:readme or /create:feature-catalog', '/create:feature-catalog'],\n158:     ['do not run /deep:review, or /deep:research', '/deep:research'],\n159:     ['skip /create:agent or /create:readme', '/create:readme'],\n160:     ['do not run /speckit:plan or /speckit:implement or /speckit:complete', '/speckit:complete'],\n161:     ['do not run /create:agent or the /create:readme command', '/create:readme'],\n162:     ['do not run /create:agent, or the /create:readme command', '/create:readme'],\n163:     ['skip /create:agent or the /create:readme command', '/create:readme'],\n164:     ['never use the /create:readme command or the /create:feature-catalog command', '/create:feature-catalog'],\n165:     ['do not run /doctor:ci report or /create:readme', '/create:readme'],\n166:     ['do not run /doctor:ci report or /doctor:ci scaffold', '/doctor:ci scaffold'],\n167:     ['never use /doctor:git hooks or /doctor:skill-advisor tune', '/doctor:skill-advisor tune'],\n168:   ])('reads %s as a refusal of %s through an or-list', (prompt, command) => {\n169:     expect(commandOnlyMentioned(prompt, command)).toBe(true);\n170:   });\n171: \n172:   // Chat wraps a command name in code, quote or bold marks, and a renamed command\n173:   // is still typed under its old name. Neither may change what the naming reads\n174:   // as, so every fixture must read the same wrapped or retired as it does plain.\n175:   const WRAPPERS: ReadonlyArray<readonly [string, string]> = [\n176:     ['`', '`'], [\"'\", \"'\"], ['\"', '\"'], ['\\u201c', '\\u201d'], ['\\u2018', '\\u2019'], ['**', '**'],\n177:     ['[', ']'], ['(', ')'], ['~~', '~~'], ['<code>', '</code>'], ['\\u00ab', '\\u00bb'], ['\\u2032', '\\u2032'],\n178:   ];\n179:   const PLAIN_ROWS = [...REFUSE8, ...QUESTION2, ...REQUEST6, ...CONTROL5,\n180:     ['do not run /create:agent or /create:readme', '/create:readme'],\n181:     ['skip /create:agent or the /create:readme command', '/create:readme'],\n182:   ] as const;\n183: \n184:   it.each(WRAPPERS)('reads every fixture wrapped in %s the same as plain', (open, close) => {\n185:     for (const [prompt, command] of PLAIN_ROWS) {\n186:       const wrapped = prompt.replace(/\\/[a-z][a-z-]*:[a-z][a-z-]*/g, (name) => `${open}${name}${close}`);\n187:       expect(commandOnlyMentioned(wrapped, command), wrapped).toBe(commandOnlyMentioned(prompt, command));\n188:     }\n189:   });\n190: \n191:   it('reads every fixture under the retired name the same as under the current one', () => {\n192:     for (const [prompt, command] of PLAIN_ROWS) {\n193:       const plain = prompt.split(command).join('/create:sk-skill');\n194:       const retired = prompt.split(command).join('/create:skill');\n195:       expect(commandOnlyMentioned(retired, '/create:sk-skill'), retired)\n196:         .toBe(commandOnlyMentioned(plain, '/create:sk-skill'));\n197:     }\n198:   });\n199: \n200:   // A refusal can follow the name it refuses, so the words after a naming are\n201:   // read for a refusal of \"it\" as well as for a request.\n202:   it.each([\n203:     ['/create:readme is not what I want, do not run it', '/create:readme'],\n204:     ['run /doctor:git setup but do not actually run it', '/doctor:git setup'],\n205:     [\"/speckit:complete came up, but please don't start it\", '/speckit:complete'],\n206:   ])('reads the later refusal in %s as a mention of %s', (prompt, command) => {\n207:     expect(commandOnlyMentioned(prompt, command)).toBe(true);\n208:   });\n209: \n210:   it.each([\n211:     [\"run /speckit:save and don't skip it\", '/speckit:save'],\n212:     [\"run /speckit:save and don't run it twice\", '/speckit:save'],\n213:     ['run /deep:review but never run it without a budget', '/deep:review'],\n214:     ['open the /deep:review command file, then run it', '/deep:review'],\n215:     ['read the /deep:review docs, then do a thorough review of this diff', '/deep:review'],\n216:   ])('still reads %s as a request for %s', (prompt, command) => {\n217:     expect(commandOnlyMentioned(prompt, command)).toBe(false);\n218:   });\n219: \n220:   // A command named as a document is being read about, not run.\n221:   it.each([\n222:     ['read the /create:readme document and tell me what it does', '/create:readme'],\n223:     ['open the /deep:review command file and summarize it', '/deep:review'],\n224:   ])('reads %s as a mention of %s', (prompt, command) => {\n225:     expect(commandOnlyMentioned(prompt, command)).toBe(true);\n226:   });\n227: \n228:   it('still reads a typed command whose argument is a file as a request', () => {\n229:     expect(commandOnlyMentioned('/create:diff file a.md b.md', '/create:diff')).toBe(false);\n230:   });\n231: \n232:   // A doc path that holds the name is a file, not a naming, so it cannot undo the\n233:   // refusal of the command itself.\n234:   it('reads a led refusal beside a doc path of the same command as a mention', () => {\n235:     expect(commandOnlyMentioned('do not run /create:readme, read /create:readme.md', '/create:readme')).toBe(true);\n236:   });\n237: \n238:   // Markup around the name must not hide the lead before it.\n239:   it.each([\n240:     ['do not run `/create:readme`, just tell me what it covers', '/create:readme'],\n241:     ['what does `/create:readme` do?', '/create:readme'],\n242:     ['never use **/deep:review** here', '/deep:review'],\n243:     ['do not run \"/create:readme\" yet', '/create:readme'],\n244:     [\"do not run '/create:readme' yet\", '/create:readme'],\n245:     [\"what's '/create:readme' for?\", '/create:readme'],\n246:     ['never use ‘/deep:review’ here', '/deep:review'],\n247:     ['do not run “/create:readme” yet', '/create:readme'],\n248:   ])('reads the marked-up %s as a mention of %s', (prompt, command) => {\n249:     expect(commandOnlyMentioned(prompt, command)).toBe(true);\n250:   });\n251: \n252:   it('still reads a marked-up request as a request', () => {\n253:     expect(commandOnlyMentioned('run `/create:readme` for the advisor skill', '/create:readme')).toBe(false);\n254:     expect(commandOnlyMentioned(\"run '/create:readme' for the advisor skill\", '/create:readme')).toBe(false);\n255:     expect(commandOnlyMentioned(\"don't skip '/create:readme', run it\", '/create:readme')).toBe(false);\n256:   });\n257: \n258:   it.each([\n259:     [\"do not run '/create:agent' or '/create:readme'\", '/create:readme'],\n260:     [\"do not run '/doctor:ci report' or '/create:readme'\", '/create:readme'],\n261:   ])('reads the quoted or-list %s as a refusal of %s', (prompt, command) => {\n262:     expect(commandOnlyMentioned(prompt, command)).toBe(true);\n263:   });\n264: \n265:   // A retired name maps to the command that replaced it, so refusing the old\n266:   // spelling refuses the new command too.\n267:   it('reads a refusal of a retired name as a refusal of its replacement', () => {\n268:     expect(commandOnlyMentioned('do not run /create:skill', '/create:sk-skill')).toBe(true);\n269:     expect(commandOnlyMentioned('what does /create:skill do?', '/create:sk-skill')).toBe(true);\n270:     expect(commandOnlyMentioned('run /create:skill for my new helper', '/create:sk-skill')).toBe(false);\n271:   });\n272: \n273:   it.each([\n274:     ['use /create:agent or /create:readme', '/create:agent'],\n275:     ['use /create:agent or /create:readme', '/create:readme'],\n276:     ['use /speckit:plan, not /speckit:complete', '/speckit:plan'],\n277:     ['do not run /speckit:complete, run /speckit:plan or /speckit:implement', '/speckit:plan'],\n278:     ['do not run /speckit:complete, run /speckit:plan or /speckit:implement', '/speckit:implement'],\n279:     ['do not run /speckit:complete or run /speckit:plan', '/speckit:plan'],\n280:     ['use /create:agent or the /create:readme command', '/create:readme'],\n281:     ['the next step is /create:agent or /create:readme', '/create:readme'],\n282:     ['use /doctor:ci report or /create:readme', '/create:readme'],\n283:   ])('still reads %s as a request for %s beside an or-list', (prompt, command) => {\n284:     expect(commandOnlyMentioned(prompt, command)).toBe(false);\n285:   });\n286: \n287:   // A bare lead opens a statement as often as a question, so it marks a mention\n288:   // only before a question. One led occurrence does not make a request either\n289:   // when a later occurrence of the same command is not led.\n290:   it.each([\n291:     ['the next step is /speckit:implement', '/speckit:implement'],\n292:     ['the next step is the /speckit:implement command', '/speckit:implement'],\n293:     ['is this right? run /speckit:plan', '/speckit:plan'],\n294:     ['the next step is /speckit:implement\\nany questions?', '/speckit:implement'],\n295:     ['what does /speckit:save do? ok now run /speckit:save', '/speckit:save'],\n296:     ['the plan is /speckit:plan then tests', '/speckit:plan'],\n297:   ])('reads %s as a request for %s', (prompt, command) => {\n298:     expect(commandOnlyMentioned(prompt, command)).toBe(false);\n299:   });\n300: \n301:   // A chat question often leaves the question mark off, so a bare ask word that\n302:   // opens a sentence still marks the command as the subject.\n303:   it.each([\n304:     ['is /speckit:resume safe to run twice', '/speckit:resume'],\n305:     ['does /doctor:git change files or just report problems', '/doctor:git'],\n306:     ['can /prompt:improve make a vague request easier to follow', '/prompt:improve'],\n307:     ['ok. is /speckit:plan enough here', '/speckit:plan'],\n308:     ['quick question? is /speckit:resume safe to run twice', '/speckit:resume'],\n309:     ['Is the /doctor:update command safe?', '/doctor:update'],\n310:   ])('reads %s as a question about %s', (prompt, command) => {\n311:     expect(commandOnlyMentioned(prompt, command)).toBe(true);\n312:   });\n313: \n314:   it.each([\n315:     ['should I run /create:agent or /create:readme?', '/create:readme'],\n316:     ['is /create:agent or /create:readme better?', '/create:readme'],\n317:     ['what does /create:agent or /create:readme do?', '/create:readme'],\n318:   ])('reads %s as a question about %s through an or-list', (prompt, command) => {\n319:     expect(commandOnlyMentioned(prompt, command)).toBe(true);\n320:   });\n321: \n322:   it('reads each command of a two-command prompt on its own', () => {\n323:     expect(commandOnlyMentioned('use /speckit:plan, not /speckit:complete', '/speckit:complete')).toBe(true);\n324:   });\n325: \n326:   it('reads a curly apostrophe as a straight one', () => {\n327:     expect(commandOnlyMentioned('don\\u2019t run /speckit:save', '/speckit:save')).toBe(true);\n328:   });\n329: \n330:   it('reads no need to run as a refusal of the command', () => {\n331:     expect(commandOnlyMentioned('no need to run /doctor:setup, the hooks are fine', '/doctor:setup')).toBe(true);\n332:   });\n333: \n334:   it('still reads a request after no need to ask', () => {\n335:     expect(commandOnlyMentioned('no need to ask, run /speckit:save', '/speckit:save')).toBe(false);\n336:   });\n337: \n338:   it('reads stop using as a refusal of the command', () => {\n339:     expect(commandOnlyMentioned('stop using /create:changelog for this, write the changelog entry by hand', '/create:changelog')).toBe(true);\n340:   });\n341: \n342:   it('still reads a request after stop and', () => {\n343:     expect(commandOnlyMentioned('stop and run /speckit:plan', '/speckit:plan')).toBe(false);\n344:   });\n345: \n346:   it('reads why not use as a request for the command', () => {\n347:     expect(commandOnlyMentioned('why not use /create:agent for this? go ahead and make a security reviewer agent', '/create:agent')).toBe(false);\n348:   });\n349: \n350:   it.each([\n351:     ['I have not run /speckit:plan yet, please start it for the login feature', '/speckit:plan'],\n352:     ['I already ran /create:readme but the output was wrong, run it again for the hooks folder', '/create:readme'],\n353:     ['not run /speckit:plan yet, write notes to /tmp/notes.md, then run it', '/speckit:plan'],\n354:     ['not run /speckit:plan yet, read https://example.com/spec first, then run it', '/speckit:plan'],\n355:   ])('reads %s as a request for %s made by a later clause', (prompt, command) => {\n356:     expect(commandOnlyMentioned(prompt, command)).toBe(false);\n357:   });\n358: \n359:   it.each([\n360:     ['do not run /speckit:complete, I will run it myself later', '/speckit:complete'],\n361:     ['do not use /create:agent, use that other one', '/create:agent'],\n362:     ['do not run /speckit:complete, run /speckit:plan for the rate limiter instead', '/speckit:complete'],\n363:     ['do not run /speckit:complete, run /speckit:plan, then run it for the auth module', '/speckit:complete'],\n364:   ])('still reads %s as a mention of %s', (prompt, command) => {\n365:     expect(commandOnlyMentioned(prompt, command)).toBe(true);\n366:   });\n367: \n368:   it('does not read a longer command name as the shorter one', () => {\n369:     expect(commandOnlyMentioned('do not run /create:sk-skill-parent', '/create:sk-skill')).toBe(false);\n370:   });\n371: \n372:   it.each([\n373:     'what does /create:readme do?',\n374:     'skip /create:readme, just append one line to the existing README',\n375:     'do not run /create:agent or /create:readme',\n376:   ])('offers no hub command for %s', (prompt) => {\n377:     expect(attachCommand('sk-doc', SINGLE('sk-create-readme'), prompt)).toBeUndefined();\n378:   });\n379: \n380:   it('offers no deep-loop command the prompt refuses', () => {\n381:     const deepLoopModes = MODE_COMMANDS['system-deep-loop'];\n382:     const mode = Object.keys(deepLoopModes).find((key) => deepLoopModes[key] === '/deep:research');\n383:     expect(mode, 'the generated table names the research mode').toBeDefined();\n384:     expect(attachCommand('system-deep-loop', SINGLE(mode!), 'please do not start /deep:research, I only want a two line summary of the readme')).toBeUndefined();\n385:   });\n386: \n387:   it('still offers the hub command a plain request routes to', () => {\n388:     expect(attachCommand('sk-doc', SINGLE('sk-create-readme'), 'write a readme for the doctor scripts folder')).toBe('/create:readme');\n389:   });\n390: });\n391: \n392: describe('command attach on a small edit', () => {\n393:   it.each([\n394:     'update the README typo in line 3',\n395:     'fix the typo in the README',\n396:     'correct the spelling in the hooks readme',\n397:     'fix the broken link in the install guide readme',\n398:   ])('offers no creation command for %s', (prompt) => {\n399:     expect(attachCommand('sk-doc', SINGLE('sk-create-readme'), prompt)).toBeUndefined();\n400:   });\n401: \n402:   it.each([\n403:     'write a readme for the doctor scripts folder',\n404:     'create a readme for the payments module, check it for typos when done',\n405:   ])('still offers the creation command for %s', (prompt) => {\n406:     expect(attachCommand('sk-doc', SINGLE('sk-create-readme'), prompt)).toBe('/create:readme');\n407:   });\n408: \n409:   it.each([\n410:     ['sk-doc', 'sk-create-agent', 'build an agent that fixes typos in our docs'],\n411:     ['sk-doc', 'sk-create-readme', 'writing a readme for the grammar module'],\n412:     ['sk-doc', 'sk-create-readme', 'add a readme for the spelling package'],\n413:     ['sk-doc', 'sk-create-changelog', 'add a changelog entry for the typo fixes in the cli help'],\n414:   ])('still offers the creation command on %s %s for %s', (skill, mode, prompt) => {\n415:     expect(attachCommand(skill, SINGLE(mode), prompt)).toBe(MODE_COMMANDS[skill][mode]);\n416:   });\n417: \n418:   it('leaves the wording commands outside the gate', () => {\n419:     const docModes = MODE_COMMANDS['sk-doc'];\n420:     const mode = Object.keys(docModes).find((key) => docModes[key] === '/create:with-human-voice');\n421:     expect(mode, 'the generated table names the human voice mode').toBeDefined();\n422:     expect(attachCommand('sk-doc', SINGLE(mode!), 'humanize the wording in the onboarding guide')).toBe('/create:with-human-voice');\n423:   });\n424: \n425:   it.each([\n426:     ['sk-create-changelog', 'changelog for v2.1, it fixes the broken link checker and spelling errors'],\n427:     ['sk-create-changelog', 'log the spelling fixes in the changelog'],\n428:     ['sk-create-readme', 'document the cli in a readme, each flag gets a one line description'],\n429:     ['sk-create-readme', 'readme for the spelling package'],\n430:     ['sk-create-agent', 'an agent that fixes typos'],\n431:   ])('keeps the creation command for %s on %s', (mode, prompt) => {\n432:     expect(attachCommand('sk-doc', SINGLE(mode), prompt)).toBe(MODE_COMMANDS['sk-doc'][mode]);\n433:   });\n434: \n435:   it('keeps the goal command when the goal is about fixes', () => {\n436:     const docModes = MODE_COMMANDS['sk-doc'];\n437:     const mode = Object.keys(docModes).find((key) => docModes[key] === '/create:goal');\n438:     expect(mode, 'the generated table names the goal mode').toBeDefined();\n439:     expect(attachCommand('sk-doc', SINGLE(mode!), 'set a goal to fix all the typos in the docs')).toBe('/create:goal');\n440:   });\n441: \n442:   it.each([\n443:     'fix the broken links in the install guide readme',\n444:     'fix the dead links in the hooks readme',\n445:   ])('offers no creation command for %s', (prompt) => {\n446:     expect(attachCommand('sk-doc', SINGLE('sk-create-readme'), prompt)).toBeUndefined();\n447:   });\n448: \n449:   it('leaves a command outside the create namespace alone', () => {\n450:     const deepLoopModes = MODE_COMMANDS['system-deep-loop'];\n451:     const mode = Object.keys(deepLoopModes).find((key) => deepLoopModes[key] === '/deep:review');\n452:     expect(mode, 'the generated table names the review mode').toBeDefined();\n453:     expect(attachCommand('system-deep-loop', SINGLE(mode!), 'do a thorough deep review of the typo handling')).toBe('/deep:review');\n454:   });\n455: \n456:   it.each([\n457:     ['sk-create-agent', 'an agent to fix typos'],\n458:     ['sk-create-agent', 'give me an agent to fix broken links in the docs'],\n459:     ['sk-create-agent', 'I want an agent to correct spelling in pull requests'],\n460:   ])('keeps the creation command for %s on %s', (mode, prompt) => {\n461:     expect(attachCommand('sk-doc', SINGLE(mode), prompt)).toBe(MODE_COMMANDS['sk-doc'][mode]);\n462:   });\n463: \n464:   // A skill or a command names its own purpose, so a correction word inside that\n465:   // purpose is the reason the artifact exists and not a request to edit one.\n466:   it.each([\n467:     ['/create:sk-skill', 'a skill to correct spelling in markdown'],\n468:     ['/create:command', \"I'd like a command to fix dead links\"],\n469:   ])('keeps the command %s on %s', (command, prompt) => {\n470:     const docModes = MODE_COMMANDS['sk-doc'];\n471:     const mode = Object.keys(docModes).find((key) => docModes[key] === command);\n472:     expect(mode, 'the generated table names the ' + command + ' mode').toBeDefined();\n473:     expect(attachCommand('sk-doc', SINGLE(mode!), prompt)).toBe(command);\n474:   });\n475: \n476:   // A repo rule or a benchmark also names its purpose the way an agent does, so\n477:   // the correction word belongs to what the artifact is for rather than to an\n478:   // edit of a document that already exists.\n479:   it.each([\n480:     'I want a repo rule that says fix typos in the same commit',\n481:     'repo rule: always fix typos in the same commit',\n482:   ])('keeps the repo-rule command on %s', (prompt) => {\n483:     const docModes = MODE_COMMANDS['sk-doc'];\n484:     const mode = Object.keys(docModes).find((key) => docModes[key] === '/create:repo-rule');\n485:     expect(mode, 'the generated table names the repo rule mode').toBeDefined();\n486:     expect(attachCommand('sk-doc', SINGLE(mode!), prompt)).toBe('/create:repo-rule');\n487:   });\n488: \n489:   it('keeps the benchmark command on benchmark how fast we fix typos', () => {\n490:     const docModes = MODE_COMMANDS['sk-doc'];\n491:     const mode = Object.keys(docModes).find((key) => docModes[key] === '/create:benchmark');\n492:     expect(mode, 'the generated table names the benchmark mode').toBeDefined();\n493:     expect(attachCommand('sk-doc', SINGLE(mode!), 'benchmark how fast we fix typos')).toBe('/create:benchmark');\n494:   });\n495: });\n496: \n497: describe('command attach on a deep-loop prompt', () => {\n498:   it('withholds the review command when another deep-loop command is named', () => {\n499:     expect(attachCommand('system-deep-loop', SINGLE('review'), 'what did /deep:ai-council decide')).toBeUndefined();\n500:   });\n501: \n502:   it('withholds the review command when an unknown deep-loop command is named', () => {\n503:     expect(attachCommand('system-deep-loop', SINGLE('review'), 'what did /deep:reviw decide')).toBeUndefined();\n504:   });\n505: \n506:   it('offers the review command when it is the command typed', () => {\n507:     expect(attachCommand('system-deep-loop', SINGLE('review'), 'run /deep:review now')).toBe('/deep:review');\n508:   });\n509: \n510:   it('offers the review command when the prompt asks for depth', () => {\n511:     expect(attachCommand('system-deep-loop', SINGLE('review'), 'review the parser in depth')).toBe('/deep:review');\n512:   });\n513: });\n514: \n515: describe('typed command boundaries', () => {\n516:   it('does not read a file name with an extension as a typed command', () => {\n517:     expect(typedCommandIn('see /create:sk-skill.md for details')).toBeUndefined();\n518:   });\n519: \n520:   it('does not read a path segment as a typed command', () => {\n521:     expect(typedCommandIn('open /create:readme/notes.txt')).toBeUndefined();\n522:   });\n523: \n524:   it.each([\n525:     ['run **/deep:review** now', '/deep:review'],\n526:     ['run [/deep:review] now', '/deep:review'],\n527:     ['run \\u201c/deep:review\\u201d now', '/deep:review'],\n528:     ['run <code>/deep:review</code> now', '/deep:review'],\n529:   ])('finds the command wrapped in %s', (prompt, command) => {\n530:     expect(typedCommandIn(prompt)).toBe(command);\n531:   });\n532: \n533:   it('reads a command that ends a sentence', () => {\n534:     expect(typedCommandIn('run /create:sk-skill.')).toBe('/create:sk-skill');\n535:   });\n536: \n537:   it('reads a command followed by a comma', () => {\n538:     expect(typedCommandIn('run /create:sk-skill, then stop')).toBe('/create:sk-skill');\n539:   });\n540: \n541:   it('reads the longest command when a prefix also matches', () => {\n542:     expect(typedCommandIn('/create:skill-parent now')).toBe('/create:skill-parent');\n543:   });\n544: \n545:   it('reads a command typed with its mode suffix', () => {\n546:     expect(typedCommandIn('/deep:review:auto review the diff')).toBe('/deep:review');\n547:     expect(typedCommandIn('/speckit:plan:confirm add a login page')).toBe('/speckit:plan');\n548:     expect(typedCommandIn('/speckit:implement:autopilot')).toBe('/speckit:implement');\n549:     expect(typedCommandIn('/speckit:implement:unattended the login spec')).toBe('/speckit:implement');\n550:   });\n551: \n552:   it('reads a command typed with a with-modifier or a chain of suffixes', () => {\n553:     expect(typedCommandIn('/speckit:complete:with-research the login spec')).toBe('/speckit:complete');\n554:     expect(typedCommandIn('/speckit:complete:with-context the login spec')).toBe('/speckit:complete');\n555:     expect(typedCommandIn('/speckit:complete:auto:with-research the login spec')).toBe('/speckit:complete');\n556:     expect(typedCommandIn('/speckit:plan:with-phases a login page')).toBe('/speckit:plan');\n557:   });\n558: \n559:   // The suffix rule is shared by every tracked command, so a modifier typed on a\n560:   // command whose hint does not list it still names that command.\n561:   it('reads a with-modifier on a command whose hint does not list it as that command', () => {\n562:     expect(typedCommandIn('/deep:review:with-research the diff')).toBe('/deep:review');\n563:   });\n564: \n565:   it('does not read a command followed by an unknown suffix', () => {\n566:     expect(typedCommandIn('/deep:review:automation notes')).toBeUndefined();\n567:     expect(typedCommandIn('/create:readme:draft')).toBeUndefined();\n568:     expect(typedCommandIn('/speckit:complete:with-everything now')).toBeUndefined();\n569:     expect(typedCommandIn('/speckit:complete:auto:draft now')).toBeUndefined();\n570:     // The chain must abut the name, so a known suffix after an unknown one is refused.\n571:     expect(typedCommandIn('/speckit:complete:draft:auto now')).toBeUndefined();\n572:   });\n573: \n574:   it('attaches the deep-loop command typed with its mode suffix', () => {\n575:     expect(attachCommand('system-deep-loop', SINGLE('review'), '/deep:review:auto review the diff')).toBe('/deep:review');\n576:   });\n577: \n578:   it('reads a retired command name as the command that replaced it', () => {\n579:     expect(typedCommandIn('/create:skill')).toBe('/create:sk-skill');\n580:     expect(typedCommandIn('/create:skill make a linting skill')).toBe('/create:sk-skill');\n581:     expect(typedCommandForTop('sk-doc', '/create:skill')).toEqual({\n582:       command: '/create:sk-skill',\n583:       policy: 'start',\n584:       ownerSkillId: 'sk-doc',\n585:     });\n586:   });\n587: \n588:   it('does not read a retired name inside a path', () => {\n589:     expect(typedCommandIn('open docs/create:skill.md')).toBeUndefined();\n590:   });\n591: \n592:   it('carries no command when the prompt only names a file', () => {\n593:     expect(typedCommandForTop('sk-doc', 'open /create:readme.md and summarise it')).toBeUndefined();\n594:   });\n595: \n596:   it('delivers no typed command the prompt refuses', () => {\n597:     expect(typedCommandForTop('system-spec-kit', 'do not run /speckit:complete yet, just explain what it does')).toBeUndefined();\n598:   });\n599: \n600:   it('still delivers a typed command the prompt asks for', () => {\n601:     expect(typedCommandForTop('system-spec-kit', 'run /speckit:complete for the rate limiter')?.command).toBe('/speckit:complete');\n602:   });\n603: });\n604: \n605: describe('generated command table', () => {\n606:   it('holds no separate policy table', async () => {\n607:     expect('COMMAND_POLICIES' in await import('../lib/command-attach.js')).toBe(false);\n608:   });\n609: \n610:   it('the command-bridges README names every command row field', () => {\n611:     const source = readFileSync(join(import.meta.dirname, '../lib/command-attach.ts'), 'utf8');\n612:     const readme = readFileSync(join(import.meta.dirname, '../scripts/command-bridges/README.md'), 'utf8');\n613:     const interfaceBlock = /export interface CommandRow \\{([\\s\\S]*?)\\n\\}/.exec(source)?.[1] ?? '';\n614:     const fields = [...interfaceBlock.matchAll(/readonly (\\w+)\\??:/g)].map((match) => match[1]);\n615:     expect(fields).toEqual(['command', 'policy', 'mutating', 'ownerSkillId']);\n616:     const sentence = /Each row carries [^\\n]*/.exec(readme)?.[0] ?? '';\n617:     for (const field of fields) {\n618:       expect(sentence).toContain('`' + field + '`');\n619:     }\n620:   });\n621: });"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\".skilled/skills/system-skill-advisor/runtime/tests/command-attach-guards.vitest.ts\"}"},"time":{"start":1794868296374,"end":1794868296738}}}}
{"type":"step_finish","timestamp":1794868297975,"sessionID":"ses_e1984dae6ffeaD8lGAJ4oqvNMo","part":{"id":"prt_1e67cc0f7001QPHNicBeq9VQa5","sessionID":"ses_e1984dae6ffeaD8lGAJ4oqvNMo","messageID":"msg_1e67caf06001xLoJqOMvzN8msg","type":"step-finish","reason":"tool-calls","snapshot":"b2f089deb3c786d07d5cd3f50dfbcb6f9bae8b24","cost":0,"tokens":{"input":12195,"output":62,"reasoning":5,"cache":{"read":64000,"write":0}}}}
