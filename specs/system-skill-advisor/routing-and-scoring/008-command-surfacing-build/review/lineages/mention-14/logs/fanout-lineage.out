reduce-state.cjs {spec_folder} {reducer_artifact_arg} --create-missing-anchors\n2031:        command: \"node .skilled/skills/system-deep-loop/runtime/scripts/reduce-state.cjs {spec_folder} {reducer_artifact_arg} --create-missing-anchors --emit-resource-map\"\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"grep -n \\\"step_reduce_state\\\\|reduce-state.cjs\\\" .skilled/commands/deep/assets/deep-review.yaml | head -20\"}"},"time":{"start":1794868247242,"end":1794868248202}}}}
