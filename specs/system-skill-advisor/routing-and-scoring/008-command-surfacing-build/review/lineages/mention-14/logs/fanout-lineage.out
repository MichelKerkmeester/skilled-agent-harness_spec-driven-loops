queryOrPath:\\\"escapePhrase and its two consumers\\\",result:\\\"both RegExp sites consume the escaped name\\\",evidenceRefs:[\\\".skilled/skills/system-skill-advisor/runtime/lib/command-attach.ts:455\\\",\\\".skilled/skills/system-skill-advisor/runtime/lib/command-attach.ts:466\\\"]}],disposition:\\\"ruled_out\\\",ruledOutReason:\\\"escaping covers the whole name before either pattern is built\\\",rationale:\\\"no untrusted name is accepted anyway; the table is generated\\\"}\\n  ],\\n  graphEvents:[\\n    {type:\\\"node\\\",id:\\\"dimension:security\\\",kind:\\\"DIMENSION\\\",label:\\\"security\\\"},\\n    {type:\\\"node\\\",id:\\\"file:command-attach-ts\\\",kind:\\\"FILE\\\",label:\\\".skilled/skills/system-skill-advisor/runtime/lib/command-attach.ts\\\"},\\n    {type:\\\"node\\\",id:\\\"file:command-attach-guards-vitest-ts\\\",kind:\\\"FILE\\\",label:\\\".skilled/skills/system-skill-advisor/runtime/tests/command-attach-guards.vitest.ts\\\"},\\n    {type:\\\"node\\\",id:\\\"file:review-brief-14-txt\\\",kind:\\\"FILE\\\",label:\\\"specs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/review/review-brief-14.txt\\\"},\\n    {type:\\\"node\\\",id:\\\"file:review-scope-14-txt\\\",kind:\\\"FILE\\\",label:\\\"specs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/review/review-scope-14.txt\\\"},\\n    {type:\\\"edge\\\",id:\\\"covers:security:command-attach-ts\\\",relation:\\\"COVERS\\\",source:\\\"dimension:security\\\",target:\\\"file:command-attach-ts\\\"},\\n    {type:\\\"edge\\\",id:\\\"covers:security:guards\\\",relation:\\\"COVERS\\\",source:\\\"dimension:security\\\",target:\\\"file:command-attach-guards-vitest-ts\\\"},\\n    {type:\\\"edge\\\",id:\\\"covers:security:brief\\\",relation:\\\"COVERS\\\",source:\\\"dimension:security\\\",target:\\\"file:review-brief-14-txt\\\"},\\n    {type:\\\"edge\\\",id:\\\"covers:security:scope\\\",relation:\\\"COVERS\\\",source:\\\"dimension:security\\\",target:\\\"file:review-scope-14-