/system-skill-advisor/runtime/lib/command-attach.ts\\\"],\\n      \\\"bugClass\\\": \\\"typed_command_boundary\\\",\\n      \\\"hypothesis\\\": \\\"The occurrence boundary may read a doc path or a longer name as a naming.\\\",\\n      \\\"searchActions\\\": [\\n        {\\n          \\\"method\\\": \\\"direct_read\\\",\\n          \\\"queryOrPath\\\": \\\".skilled/skills/system-skill-advisor/runtime/lib/command-attach.ts:456\\\",\\n          \\\"result\\\": \\\"The lookahead rejects a path or extension continuation and the suite pins both cases.\\\",\\n          \\\"evidenceRefs\\\": [\\\".skilled/skills/system-skill-advisor/runtime/lib/command-attach.ts:456\\\"]\\n        }\\n      ],\\n      \\\"disposition\\\": \\\"ruled_out\\\",\\n      \\\"ruledOutReason\\\": \\\"The boundary and its tests already reject the doc path and the longer command name; no new input was found.\\\",\\n      \\\"rationale\\\": \\\"Existing coverage is adequate for this class.\\\"\\n    }\\n  ],\\n  \\\"graphEvents\\\": [\\n    { \\\"type\\\": \\\"node\\\", \\\"id\\\": \\\"dimension:correctness\\\", \\\"kind\\\": \\\"DIMENSION\\\", \\\"label\\\": \\\"correctness\\\" },\\n    { \\\"type\\\": \\\"node\\\", \\\"id\\\": \\\"file:command-attach-ts\\\", \\\"kind\\\": \\\"FILE\\\", \\\"label\\\": \\\".skilled/skills/system-skill-advisor/runtime/lib/command-attach.ts\\\" },\\n    { \\\"type\\\": \\\"node\\\", \\\"id\\\": \\\"file:command-attach-guards-vitest-ts\\\", \\\"kind\\\": \\\"FILE\\\", \\\"label\\\": \\\".skilled/skills/system-skill-advisor/runtime/tests/command-attach-guards.vitest.ts\\\" },\\n    { \\\"type\\\": \\\"node\\\", \\\"id\\\": \\\"file:review-brief-14-txt\\\", \\\"kind\\\": \\\"FILE\\\", \\\"label\\\": \\\"specs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/review/review-brief-14.txt\\\" },\\n    { \\\"type\\\": \\\"node\\\", \\\"id\\\": \\\"file:review-scope-14-txt\\\", \\\"kind\\\": \\\"FILE\\\", \\\"label\\\": \\\"specs/system-skill-advisor/routing-a