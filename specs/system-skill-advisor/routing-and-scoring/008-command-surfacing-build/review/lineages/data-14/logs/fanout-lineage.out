xt (split holdout in command-prompts.jsonl, or holdout-prompts.jsonl): counts only. The reviewer changes no code and writes only inside its lineage folder.\",\n  \"resource_map_present\": false,\n  \"resource_map\": {\n    \"emit\": true\n  },\n  \"severityThreshold\": \"P2\",\n  \"crossReference\": {\n    \"core\": [\n      \"spec_code\",\n      \"checklist_evidence\"\n    ],\n    \"overlay\": [\n      \"skill_agent\",\n      \"agent_cross_runtime\",\n      \"feature_catalog_code\",\n      \"playbook_capability\"\n    ]\n  },\n  \"qualityGateThreshold\": true,\n  \"runtimeCapabilityResolver\": \".skilled/skills/system-deep-loop/deep-review/scripts/runtime-capabilities.cjs\",\n  \"reducerScriptPath\": \".skilled/skills/system-deep-loop/runtime/scripts/reduce-state.cjs\",\n  \"fileProtection\": {\n    \"deep-review-config.json\": \"immutable\",\n    \"deep-review-state.jsonl\": \"append-only\",\n    \"deep-review-findings-registry.json\": \"auto-generated\",\n    \"deep-review-strategy.md\": \"mutable\",\n    \"deep-review-dashboard.md\": \"auto-generated\",\n    \".deep-review-pause\": \"operator-controlled\",\n    \"review-report.md\": \"mutable\",\n    \"review-report-v*.md\": \"write-once\",\n    \"iteration-*.md\": \"write-once\"\n  },\n  \"reducer\": {\n    \"enabled\": true,\n    \"inputs\": [\n      \"latestJSONLDelta\",\n      \"newIterationFile\",\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"total 5864\ndrwxr-xr-x@ 85 michelkerkmeester  staff     2720 Nov 16 23:29 .\ndrwxr-xr-x@ 49 michelkerkmeester  staff     1568 Nov 16 23:29 ..\n-rw-r--r--@  1 michelkerkmeester  staff     5057 Nov 13 20:41 deep-review-config.json\n-rw-r--r--@  1 michelkerkmeester  staff      441 Nov 16 17:12 deep-review-fanout-config-pass-10.json\n-rw-r--r--@  1 michelkerkmeester  staff      430 Nov 16 18:52 deep-review-fanout-config-pass-11.json\n-rw-r--r--@  1 michelkerkmeester  staff      431 Nov 16 20:22