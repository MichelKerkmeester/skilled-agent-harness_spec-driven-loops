ext","text":"2085:  const pattern = new RegExp(`<!-- ANCHOR:${anchorId} -->[\\\\s\\\\S]*?<!-- \\\\/ANCHOR:${anchorId} -->`, 'm');\n2087:    `<!-- ANCHOR:${anchorId} -->`,\n2091:    `<!-- /ANCHOR:${anchorId} -->`,\n2118:  error.code = 'MISSING_ANCHOR';\n2148:    error.code = 'MISSING_ANCHOR';\n2320:    '<!-- ANCHOR:overview -->',\n2325:    '<!-- /ANCHOR:overview -->',\n2326:    '<!-- ANCHOR:status -->',\n2343:    '<!-- /ANCHOR:status -->',\n2344:    '<!-- ANCHOR:dimension-expansion -->',\n2359:    '<!-- /ANCHOR:dimension-expansion -->',\n2360:    '<!-- ANCHOR:findings-summary -->',\n2370:    '<!-- /ANCHOR:findings-summary -->',\n2371:    '<!-- ANCHOR:progress -->',\n2378:    '<!-- /ANCHOR:progress -->',\n2379:    '<!-- ANCHOR:dimension-coverage -->',\n2386:    '<!-- /ANCHOR:dimension-coverage -->',\n2387:    '<!-- ANCHOR:blocked-stops -->',\n2409:    '<!-- /ANCHOR:blocked-stops -->',\n2410:    '<!-- ANCHOR:graph-convergence -->',\n2418:    '<!-- /ANCHOR:graph-convergence -->',\n2419:    '<!-- ANCHOR:trend -->',\n2428:    '<!-- /ANCHOR:trend -->',\n2429:    '<!-- ANCHOR:corruption-warnings -->',\n2435:    '<!-- /ANCHOR:corruption-warnings -->',\n2436:    '<!-- ANCHOR:search-debt -->',\n2440:    '<!-- /ANCHOR:search-debt -->',\n2441:    '<!-- ANCHOR:next-focus -->',\n2445:    '<!-- /ANCHOR:next-focus -->',\n2446:    '<!-- ANCHOR:active-risks -->',\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"cd /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research && grep -n \\\"ANCHOR\\\" .skilled/skills/system-deep-loop/runtime/scripts/reduce-state.cjs | head -30\"}"},"time":{"start":1794868597450,"end":1794868598040}}}}
