outing-and-scoring/008-command-surfacing-build/040-final-alignment-loop/decision-record.md:37',\n  evidence: 'ADR-001 names the arena, clean, arm and briefs words and the five-prompt transcript, but not the remaining generic signals that still route ordinary prompts (F001); declared-phrase-specificity.vitest.ts pins fixture phrases only, so no test catches the residual or a later generic addition.',\n  recommendation: 'Add one row or sentence to the decision record naming the remaining generic signals and the four reproducing prompts, and pin them as ordinary-sense fixtures.',\n  disposition: 'active',\n  findingClass: 'matrix/evidence',\n  scopeProof: 'Read ADR-001 and the transcript it cites; scored the four ordinary prompts with the committed projection and dropped each matching signal to prove causation. The test file names no real advisor signal.',\n  affectedSurfaceHints: [\n    'specs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/040-final-alignment-loop/decision-record.md',\n    'specs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/040-final-alignment-loop/tasks.md',\n    '.skilled/skills/system-skill-advisor/runtime/tests/scorer/declared-phrase-specificity.vitest.ts',\n  ],\n};\n\nconst traceabilityChecks = {\n  summary: { required: 2, executed: 2, pass: 0, partial: 0, fail: 0, blocked: 0, notApplicable: 2, gatingFailures: 0 },\n  results: [\n    {\n      protocolId: 'feature_catalog_code', status: 'notApplicable', gateClass: 'soft', applicable: false,\n      counts: { pass: 0, partial: 0, fail: 0 }, evidence: [], findingRefs: [],\n      summary: 'This area changes no feature catalog row; it is skill metadata and a packet decision record.',\n    },\n    {\n      protocolId: 'playbook_capability', status: 'notApplicable', gateClass: 'soft', applicable: false,\n      counts: { pass: 0, partial: 0, fail: 0 }, evidence: [], findingRefs: [],\n      summary: 'No manual-testing playbook source is in this area; the prior