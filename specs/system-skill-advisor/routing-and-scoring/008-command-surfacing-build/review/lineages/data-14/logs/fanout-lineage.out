Seconds\": 900\n  },\n  \"mode\": \"review\",\n  \"reviewTarget\": \"specs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build\",\n  \"reviewTargetType\": \"spec-folder\",\n  \"reviewDimensions\": [\n    \"correctness\",\n    \"security\",\n    \"traceability\",\n    \"maintainability\"\n  ],\n  \"reviewFocus\": \"Code review of command surfacing. Scope: specs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/review/review-scope.txt lists the changed files, one per line as area TAB path. Review the files whose area equals your lineage label (last folder of config.fanout_lineage_artifact_dir), plus shared docs that describe them. Every finding is P0, P1 or P2 with file:line. Check: behaviour on claude, codex, opencode, pi, devin and dsh; safety of offering a mutating command; holdout hygiene, so no tune, fix or report path reads or leaks holdout rows; docs that disagree with code. Never read or print holdout prompt text (split holdout in command-prompts.jsonl, or holdout-prompts.jsonl): counts only. The reviewer changes no code and writes only inside its lineage folder.\",\n  \"resource_map_present\": false,\n  \"resource_map\": {\n    \"emit\": true\n  },\n  \"severityThreshold\": \"P2\",\n  \"crossReference\": {\n    \"core\": [\n      \"spec_code\",\n      \"checklist_evidence\"\n    ],\n    \"overlay\": [\n      \"skill_agent\",\n      \"agent_cross_runtime\",\n      \"feature_catalog_code\",\n      \"playbook_capability\"\n    ]\n  },\n  \"qualityGateThreshold\": true,\n  \"runtimeCapabilityResolver\": \".skilled/skills/system-deep-loop/deep-review/scripts/runtime-capabilities.cjs\",\n  \"reducerScriptPath\": \".skilled/skills/system-deep-loop/runtime/scripts/reduce-state.cjs\",\n  \"fileProtection\": {\n    \"deep-review-config.json\": \"immutable\",\n    \"deep-review-state.jsonl\": \"append-only\",\n    \"deep-review-findings-registry.json\": \"auto-generated\",\n    \"deep-review-strategy.md\": \"mutable\",\n    \"deep-review-dashboard.md\": \"auto-generated\",\n    \".deep-review-pause\": \"operator-controlled\",\n    \"review-report.md\": \"mutable\",\n    \"review-report-v*.md\": \"write-once\",\n    \"iteration-*.md\": \"write-once\"\n  },\n  \"reducer\": {\n    \"enabled\": true,\n    \"inputs\": [\n      \"latestJSONLDelta\",\n      \"newIterationFile\",\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"cd specs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/review && ls -la | head -60; echo \\\"---CONFIG---\\\"; cat deep-review-config.json 2>/dev/null | head -80\"}"},"time":{"start":1794868213925,"end":1794868214495}}}}
