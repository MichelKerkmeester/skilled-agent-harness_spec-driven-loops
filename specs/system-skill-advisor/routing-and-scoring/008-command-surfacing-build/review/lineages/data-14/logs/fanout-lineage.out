.skilled/skills/system-skill-advisor/runtime/lib/scorer/fusion.ts:1263:export function scoreAdvisorPrompt(prompt: string, options: AdvisorScoringOptions): AdvisorScoringResult {\n.skilled/skills/system-skill-advisor/runtime/dist/runtime/lib/scorer/fusion.js:1076:export function scoreAdvisorPrompt(prompt, options) {\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"cd /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research && ls .skilled/skills/system-skill-advisor/runtime/dist/runtime/lib/scorer 2>/dev/null | head -20; echo \\\"---\\\"; grep -rn \\\"export function scoreAdvisorPrompt\\\\|export const scoreAdvisorPrompt\\\" .skilled/skills/system-skill-advisor/runtime/lib .skilled/skills/system-skill-advisor/runtime/dist/runtime/lib 2>/dev/null | head\"}"},"time":{"start":1794868313498,"end":1794868315646}}}}
