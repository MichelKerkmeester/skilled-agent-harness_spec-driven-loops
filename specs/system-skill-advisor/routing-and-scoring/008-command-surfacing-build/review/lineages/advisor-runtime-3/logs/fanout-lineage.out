piled-route.cjs';\n const COMPILED_ROUTE_TIMEOUT_MS = 5000;\n \n+// The reproducible projection writes or deletes exactly these names. They are\n+// saved and restored around a score because a harness imports this module and\n+// scores in process, so a projection left behind would change the caller.\n+const PROJECTED_ENV_NAMES = [\n+  'SYSTEM_SKILL_ADVISOR_DB_DIR',\n+  'SKILL_ADVISOR_DISABLE_BUILTIN_SEMANTIC',\n+  'VITEST',\n+  'SPECKIT_SKILL_ADVISOR_FORCE_LOCAL',\n+  'PYTHONDONTWRITEBYTECODE',\n+  'SPECKIT_ADVISOR_LANE_WEIGHTS_JSON',\n+  'SPECKIT_ADVISOR_LANE_SHADOW_WEIGHTS_JSON',\n+  'SPECKIT_ADVISOR_BM25_LEXICAL_SHADOW',\n+  'SPECKIT_PRIVATE_SKILL_ROOTS',\n+];\n+\n // A real capture talks to the same embedder the recommend path does, so the probe\n // asks that daemon directly and names the model family the routing vectors come\n // from. The command vectors sit beside the skill vectors in the skill graph, in a\n@@ -346,6 +361,10 @@ function readHeadSha(workspaceRoot) {\n export async function scoreCommandCorpus(options = {}) {\n   const realEmbedding = options.realEmbedding === true;\n   const RealDate = Date;\n+  // A harness imports this module and scores in process, so the projection must\n+  // not outlive the call: every name it writes or deletes is saved here and put\n+  // back in the `finally`, with an absent name deleted again.\n+  const savedEnv = new Map(PROJECTED_ENV_NAMES.map((name) => [name, process.env[name]]));\n   // The projection needs an existing, empty cache directory, and that directory\n   // is scratch space this run owns. It is created before the `try` so a failure\n   // to create it has nothing left to remove, and removed in the `finally` so\n@@ -661,6 +680,10 @@ export async function scoreCommandCorpus(options = {}) {\n     };\n   } finally {\n     globalThis.Date = RealDate;\n+    for (const [name, value] of savedEnv) {\n+      if (value === undefined) delete process.env[name];\n+      else process.env[name] = value;\n+    }\n     // Removal comes last, after every read that needs the directory has\n     // finished; `force` keeps an already-swept directory from turning a\n     // completed capture into a failure.\ndiff --git a/.skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/run-command-behaviour.mjs b/.skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/run-command-behaviour.mjs\nindex b6f52511a1..e277ce6e70 100644\n--- a/.skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/run-command-behaviour.mjs\n+++ b/.skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/run-command-behaviour.mjs\n@@ -794,6 +794,19 @@ function fixtureDir(options) {\n   return options.fixture ?? resolve(dirname(options.out), G2_FIXTURE_DIRNAME);\n }\n \n+// A finished log records the folder its turn measured, so a backfill replays the\n+// prompt the turn actually saw rather than the folder this invocation defaults to.\n+/**\n+ * Read the fixture folder a run line recorded.\n+ *\n+ * @param {object} line - One run-log line.\n+ * @param {string} fallback - Folder a line without a recorded fixture replays.\n+ * @returns {string} The fixture folder the line's prompt named.\n+ */\n+export function lineFixture(line, fallback) {\n+  return typeof line?.fixture === 'string' && line.fixture !== '' ? line.fixture : fallback;\n+}\n+\n // A placeholder keeps the fixed prompts free of a path that only exists on the\n // machine the arm runs on.\n function promptFor(rowId, fixture) {\n@@ -969,11 +982,19 @@ function valueAfter(argv, index, flag) {\n   return value;\n }\n \n-// A set that has its own arm names it, so a started-command run cannot join the\n-// change comparison because nobody passed `--arm`.\n-function armFor(options) {\n+// A started-command row joins its own comparison whichever flag picked it, so the\n+// arm follows the rows rather than the invocation. A selection that mixes the two\n+// kinds of row has no single honest arm, so it stops instead of recording half its\n+// work under the wrong label.\n+export function armFor(options, rowIds) {\n   if (options.arm !== null) return options.arm;\n-  return options.set === G2_SET ? G2_SET : DEFAULT_ARM;\n+  const started = rowIds.filter((rowId) => G2_PROMPTS.has(rowId));\n+  if (started.length === 0) return DEFAULT_ARM;\n+  if (started.length === rowIds.length) return G2_SET;\n+  throw new Refusal(\n+    'mixed_row_arms',\n+    `started-command rows ${started.join(', ')} cannot share an arm with another row`,\n+  );\n }\n \n function parseOptions(argv) {\n@@ -1133,6 +1154,7 @@ async function runTurn(job, options, exempt, isFirst) {\n     rowId: job.rowId,\n     arm: options.arm,\n     locator,\n+    ...(job.fixture === undefined ? {} : { fixture: job.fixture }),\n     exit: turn.exit,\n     changedPaths: changed,\n   };\n@@ -1199,7 +1221,15 @@ async function runArm(options, rowIds) {\n   for (let index = 0; index < rowIds.length; index += 1) {\n     const rowId = rowIds[index];\n     const prompt = promptFor(rowId, fixture);\n-    const job = { runtime, runtimeName: options.runtime, rowId, prompt, cap: capForRow(rowId), ghConfig };\n+    const job = {\n+      runtime,\n+      runtimeName: options.runtime,\n+      rowId,\n+      prompt,\n+      cap: capForRow(rowId),\n+      ghConfig,\n+      ...(G2_PROMPTS.has(rowId) ? { fixture } : {}),\n+    };\n     const result = await runTurn(job, options, exempt, index === 0);\n     if (result.refusal !== null) writeJson(result.refusal);\n     if (result.status !== 0) return result.status;\n@@ -1215,7 +1245,7 @@ async function backfillLog(options) {\n   const result = await backfillRunLog({\n     inPath: options.backfill,\n     outPath: options.out,\n-    promptFor: (rowId) => promptFor(rowId, fixture),\n+    promptFor: (rowId, line) => promptFor(rowId, lineFixture(line, fixture)),\n     briefOnly: options.briefOnly,\n   });\n   writeJson(result);\n@@ -1229,7 +1259,7 @@ async function main(argv) {\n     // answered by that guard rather than by whichever usage check would run first.\n     const rowIds = selectedRowIds(options);\n     const mode = selectMode(options);\n-    options.arm = armFor(options);\n+    options.arm = armFor(options, rowIds);\n \n     if (mode === 'print-argv') {\n       writeArgv(options.printArgv);\ndiff --git a/.skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/score-command-transcripts.mjs b/.skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/score-command-transcripts.mjs\nindex 0ba2512c86..7136243997 100644\n--- a/.skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/score-command-transcripts.mjs\n+++ b/.skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/score-command-transcripts.mjs\n@@ -3,9 +3,9 @@\n // MODULE: COMMAND TRANSCRIPT SCORER\n // ───────────────────────────────────────────────────────────────────\n //\n-// Reads a captured session through the shared session readers and reports what a\n-// model did with the commands a turn offered it: the `COMMAND:` lines it printed,\n-// the reads and writes in order, and whether a started loop ran its init first.\n+// Reads captured sessions through the shared session readers and prints counts\n+// and verdicts per runtime and arm: how often an offered command was started,\n+// seen or declined, which runs were unsafe and which started loops skipped their init.\n //\n // Two input shapes share one CLI. `--summary` takes one or more run logs and\n // scores every row they list. `--runtime` plus `--locator` scores the one session\n@@ -18,7 +18,7 @@\n //\n // Usage:\n //   node score-command-transcripts.mjs --summary <run-log> [<run-log>...] [--row-id <id>] [--json]\n-//   node score-command-transcripts.mjs --runtime <name> --locator '<json>' [--row-id <id>] [--json]\n+//   node score-command-transcripts.mjs --runtime <name> --locator '<json>' [--json]\n \n // ───────────────────────────────────────────────────────────────────\n // 1. IMPORTS\n@@ -37,7 +37,7 @@ import { G2_ROWS } from './run-command-behaviour.mjs';\n const SCRIPT_NAME = 'score-command-transcripts.mjs';\n const EXIT_UNREADABLE = 2;\n const USAGE = [\n-  `usage: ${SCRIPT_NAME} --runtime <name> --locator <json> [--row-id <id>] [--json]`,\n+  `usage: ${SCRIPT_NAME} --runtime <name> --locator <json> [--json]`,\n   `       ${SCRIPT_NAME} --summary <run-log> [<run-log>...] [--row-id <id>] [--json]`,\n   '',\n ].join('\\n');\n@@ -109,7 +109,8 @@ function parseArgs(argv) {\n }\n \n // One input shape per run: a session named by a locator, or a run log that names\n-// many. Accepting both at once would score one of them silently.\n+// many. Accepting both at once would score one of them silently. A row id narrows\n+// a run log, so the session form has no row it could pick.\n function selectMode(options) {\n   if (options.summaryLogs !== null) {\n     if (options.runtime !== null || options.locator !== null) {\n@@ -119,6 +120,7 @@ function selectMode(options) {\n   }\n   if (options.runtime === null) throw new UsageError('--runtime is required with --locator');\n   if (options.locator === null) throw new UsageError('--locator is required with --runtime');\n+  if (options.rowId !== null) throw new UsageError('--row-id narrows --summary only');\n   return 'session';\n }\n \n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"diff --git a/.skilled/skills/system-skill-advisor/runtime/scripts/command-bridges/derive-command-bridges.cjs b/.skilled/skills/system-skill-advisor/runtime/scripts/command-bridges/derive-command-bridges.cjs\nindex e9010b37dd..d2807c5696 100644\n--- a/.skilled/skills/system-skill-advisor/runtime/scripts/command-bridges/derive-command-bridges.cjs\n+++ b/.skilled/skills/system-skill-advisor/runtime/scripts/command-bridges/derive-command-bridges.cjs\n@@ -955,7 +955,14 @@ function runtimeCompatibility(entries, metadata) {\n }\n \n function tsString(value) {\n- 