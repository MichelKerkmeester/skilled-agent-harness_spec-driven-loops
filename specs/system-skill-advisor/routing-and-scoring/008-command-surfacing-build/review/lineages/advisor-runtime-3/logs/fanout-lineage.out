{"type":"tool_use","timestamp":1794594167638,"sessionID":"ses_e29e5c0baffeXQQt48JD3haI5K","part":{"partID":"prt_1d625d9d1002F0IGtEuSrYzFZS","sessionID":"ses_e29e5c0baffeXQQt48JD3haI5K","messageID":"msg_1d625c34a0011BuBd4JHj7pSgi","type":"tool","id":"call_f79083cb72a64d73b999fb27","tool":"shell","state":{"status":"completed","input":{"command":"sed -n '60,120p' .skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/command-offer.mjs"},"output":"    return { offeredCommand: null, offeredPolicy: null };\n  }\n  const policy = text.slice(match.index + match[0].length).match(POLICY_PATTERN);\n  return {\n    offeredCommand: match[0],\n    offeredPolicy: policy ? policy[1] : null,\n  };\n}\n\n/**\n * Replay the Claude prompt hook for one prompt and parse the offer it prints.\n *\n * The hook is resolved from the checkout rather than from this module, so a\n * backfill records what that checkout's advisor would have offered at the time\n * of the run, not what the current working copy happens to say.\n *\n * @param {object} options\n * @param {string} options.checkoutDir - Root of the checkout whose hook runs.\n * @param {string} options.prompt - The prompt to replay.\n * @param {string} options.sessionId - Session id for the hook payload.\n * @param {number} [options.timeoutMs] - Hook timeout before the replay fails.\n * @returns {{ offeredCommand: string | null, offeredPolicy: string | null, offerError: string | null }}\n */\nexport function replayOffer({ checkoutDir, prompt, sessionId, timeoutMs = DEFAULT_TIMEOUT_MS }) {\n  const hookPath = join(checkoutDir, HOOK_RELATIVE);\n  if (!existsSync(hookPath)) {\n    return failedOffer('hook_missing');\n  }\n\n  const payload = {\n    prompt,\n    cwd: checkoutDir,\n    hook_event_name: 'UserPromptSubmit',\n    session_id: sessionId,\n  };\n\n  let result;\n  try {\n    result = spawnSync('node', [hookPath], {\n      cwd: checkoutDir,\n      input: JSON.stringify(payload),\n      encoding: 'utf8',\n      timeout: timeoutMs,\n      maxBuffer: MAX_OUTPUT_BYTES,\n    });\n  } catch {\n    return failedOffer('hook_failed');\n  }\n\n  if (result.error || result.status !== 0 || typeof result.stdout !== 'string') {\n    return failedOffer('hook_failed');\n  }\n\n  let output;\n  try {\n    output = JSON.parse(result.stdout);\n  } catch {\n    return failedOffer('hook_failed');\n  }\n\n  const context = output?.hookSpecificOutput?.additionalContext;\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"    return { offeredCommand: null, offeredPolicy: null };\n  }\n  const policy = text.slice(match.index + match[0].length).match(POLICY_PATTERN);\n  return {\n    offeredCommand: match[0],\n    offeredPolicy: policy ? policy[1] : null,\n  };\n}\n\n/**\n * Replay the Claude prompt hook for one prompt and parse the offer it prints.\n *\n * The hook is resolved from the checkout rather than from this module, so a\n * backfill records what that checkout's advisor would have offered at the time\n * of the run, not what the current working copy happens to say.\n *\n * @param {object} options\n * @param {string} options.checkoutDir - Root of the checkout whose hook runs.\n * @param {string} options.prompt - The prompt to replay.\n * @param {string} options.sessionId - Session id for the hook payload.\n * @param {number} [options.timeoutMs] - Hook timeout before the replay fails.\n * @returns {{ offeredCommand: string | null, offeredPolicy: string | null, offerError: string | null }}\n */\nexport function replayOffer({ checkoutDir, prompt, sessionId, timeoutMs = DEFAULT_TIMEOUT_MS }) {\n  const hookPath = join(checkoutDir, HOOK_RELATIVE);\n  if (!existsSync(hookPath)) {\n    return failedOffer('hook_missing');\n  }\n\n  const payload = {\n    prompt,\n    cwd: checkoutDir,\n    hook_event_name: 'UserPromptSubmit',\n    session_id: sessionId,\n  };\n\n  let result;\n  try {\n    result = spawnSync('node', [hookPath], {\n      cwd: checkoutDir,\n      input: JSON.stringify(payload),\n      encoding: 'utf8',\n      timeout: timeoutMs,\n      maxBuffer: MAX_OUTPUT_BYTES,\n    });\n  } catch {\n    return failedOffer('hook_failed');\n  }\n\n  if (result.error || result.status !== 0 || typeof result.stdout !== 'string') {\n    return failedOffer('hook_failed');\n  }\n\n  let output;\n  try {\n    output = JSON.parse(result.stdout);\n  } catch {\n    return failedOffer('hook_failed');\n  }\n\n  const context = output?.hookSpecificOutput?.additionalContext;\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"sed -n '60,120p' .skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/command-offer.mjs\"}"},"time":{"start":1794594167249,"end":1794594167638}}}}
