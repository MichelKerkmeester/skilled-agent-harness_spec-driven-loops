dated JSON from a separate process, so the\n // shape is narrowed here rather than trusted. Arrays count as objects in\n@@ -326,7 +332,7 @@ export function attachCommand(\n \n   // A reader who rules out a change gets no command from either path, so the hub\n   // route never offers what the scorer already withholds.\n-  if (NO_EDIT_REQUEST.test(prompt.toLowerCase())) return undefined;\n+  if (isNoEditRequest(prompt)) return undefined;\n \n   // Own-key lookup on both levels: the table is data read from a generated\n   // object, so an inherited name such as `constructor` must not resolve to a\ndiff --git a/.skilled/skills/system-skill-advisor/runtime/lib/scorer/fusion.ts b/.skilled/skills/system-skill-advisor/runtime/lib/scorer/fusion.ts\nindex 0b4144a4df..fa4af6d450 100644\n--- a/.skilled/skills/system-skill-advisor/runtime/lib/scorer/fusion.ts\n+++ b/.skilled/skills/system-skill-advisor/runtime/lib/scorer/fusion.ts\n@@ -17,7 +17,7 @@ import {\n   speckitMetrics,\n } from '../metrics.js';\n import { normalize } from '../affordance-normalizer.js';\n-import { COMMAND_ROWS, NO_EDIT_REQUEST, TRACKED_COMMANDS, typedCommandIn } from '../command-attach.js';\n+import { COMMAND_ROWS, isNoEditRequest, TRACKED_COMMANDS, typedCommandIn } from '../command-attach.js';\n import { scoreDerivedLane } from './lanes/derived.js';\n import { scoreExplicitLane } from './lanes/explicit.js';\n import { scoreGraphCausalLaneSplit } from './lanes/graph-causal.js';\n@@ -674,7 +674,7 @@ function hasExplicitWorkflowSignal(contributions: readonly LaneContribution[], s\n \n export function readOnlyRouteAllowed(promptLower: string, skill: SkillProjection): boolean {\n   const skillId = skill.id;\n-  if (NO_EDIT_REQUEST.test(promptLower)) {\n+  if (isNoEditRequest(promptLower)) {\n     return false;\n   }\n   // The explainer floor exists to stop an ambiguous read-only question from\n@@ -878,7 +878,7 @@ export function commandMeaningEligible(\n   readOnlyExplainer: boolean,\n   skill: SkillProjection | undefined,\n ): boolean {\n-  if (NO_EDIT_REQUEST.test(promptLower)) return false;\n+  if (isNoEditRequest(promptLower)) return false;\n   if (!readOnlyExplainer) return true;\n   return skill !== undefined && skill.kind === 'command' && 'readOnly' in skill && skill.readOnly === true;\n }\ndiff --git a/.skilled/skills/system-skill-advisor/runtime/lib/scorer/text.ts b/.skilled/skills/system-skill-advisor/runtime/lib/scorer/text.ts\nindex 502bbf2111..8157197018 100644\n--- a/.skilled/skills/system-skill-advisor/runtime/lib/scorer/text.ts\n+++ b/.skilled/skills/system-skill-advisor/runtime/lib/scorer/text.ts\n@@ -2,6 +2,8 @@\n // MODULE: Advisor Scorer Text Utilities\n // ───────────────────────────────────────────────────────────────\n \n+import { isNoEditRequest } from '../command-attach.js';\n+\n const STOP_WORDS = new Set([\n   'a', 'about', 'able', 'actually', 'agent', 'all', 'also', 'an', 'and', 'any',\n   'are', 'as', 'at', 'be', 'been', 'being', 'but', 'by', 'can', 'could', 'did',\n@@ -145,7 +147,7 @@ export function scoreTokenOverlap(\n export function isReadOnlyExplainer(promptLower: string): boolean {\n   const readOnly = /\\b(analyze|explain|inspect|summarize|list|show|tell|compare|decompose)\\b/.test(promptLower);\n   const skillSurface = /\\b(review|audit|deep[- ]research|deep[- ]review|semantic search|figma|clickup|chrome devtools|git worktree|prompt)\\b/.test(promptLower);\n-  const explicitNoWrite = /\\b(no edits?|without making changes|do not (change|edit|modify|touch)|read-only only|no edits yet|only; do not|just show|just list)\\b/.test(promptLower);\n+  const explicitNoWrite = isNoEditRequest(promptLower);\n   if (skillSurface) return false;\n   if (readOnly && explicitNoWrite) return true;\n   if (/^\\s*(analyze|explain|inspect|summarize|list|show|tell|compare|decompose)\\b/.test(promptLower)\ndiff --git a/.skilled/skills/system-skill-advisor/runtime/lib/subprocess.ts b/.skilled/skills/system-skill-advisor/runtime/lib/subprocess.ts\nindex 98