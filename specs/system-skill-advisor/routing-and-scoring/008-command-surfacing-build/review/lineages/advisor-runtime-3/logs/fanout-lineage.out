{"type":"tool_use","timestamp":1794594124409,"sessionID":"ses_e29e5c0baffeXQQt48JD3haI5K","part":{"partID":"prt_1d6252dac001D5UXkf4yVKFaNG","sessionID":"ses_e29e5c0baffeXQQt48JD3haI5K","messageID":"msg_1d624c2d4001z4jtGjP235BZYn","type":"tool","id":"call_1c374e6bd62147f7bb5cd5d3","tool":"shell","state":{"status":"completed","input":{"command":"git -c core.fsmonitor=false diff ec1869dae8..HEAD -- .opencode/plugins/system-skill-advisor.js .opencode/plugins/tests/system-skill-advisor.test.cjs"},"output":"diff --git a/.opencode/plugins/system-skill-advisor.js b/.opencode/plugins/system-skill-advisor.js\nindex c07a378b82..0a68910fdc 100644\n--- a/.opencode/plugins/system-skill-advisor.js\n+++ b/.opencode/plugins/system-skill-advisor.js\n@@ -585,24 +585,6 @@ function cliRecommendations(data, options) {\n     });\n }\n \n-// Compact the served compiled decision the advisor attached to a recommendation.\n-// Returns null when no recommendation carried a route, which keeps the injected\n-// context byte-identical to the legacy brief.\n-function compiledRouteSummary(data) {\n-  if (!Array.isArray(data?.recommendations)) return null;\n-  for (const recommendation of data.recommendations) {\n-    const route = recommendation?.compiledRoute;\n-    if (!route || typeof route !== 'object' || typeof route.action !== 'string') continue;\n-    return {\n-      outcome: route.action,\n-      hubId: typeof route.hubId === 'string' ? route.hubId : null,\n-      targets: Array.isArray(route.targets) ? route.targets.filter((target) => typeof target === 'string') : [],\n-      servingAuthority: 'compiled',\n-    };\n-  }\n-  return null;\n-}\n-\n /**\n  * Parse the advisor CLI's stdout and render its brief.\n  *\n@@ -654,7 +636,6 @@ async function parseCliResponse(stdout, options) {\n     })\n     : null;\n   const brief = typeof rendered === 'string' && rendered.trim() ? rendered : null;\n-  const routeSummary = compiledRouteSummary(data);\n \n   return {\n     brief,\n@@ -666,7 +647,6 @@ async function parseCliResponse(stdout, options) {\n       tokenCap,\n       skillLabel: top?.skill ?? null,\n       cacheHit: Boolean(data.cache?.hit),\n-      ...(routeSummary ? { compiledRouteSummary: routeSummary } : {}),\n     },\n   };\n }\n@@ -1077,7 +1057,7 @@ function deliverTransformContribution(decision, deliver) {\n  * @param {number} [rawOptions.maxPromptBytes] - Maximum UTF-8 bytes of the stdin request sent to the advisor CLI, prompt included\n  * @param {number} [rawOptions.maxBriefChars] - Maximum injected advisor brief characters\n  * @param {number} [rawOptions.maxCacheEntries] - Maximum advisor cache entries\n- * @param {boolean} [rawOptions.boundedCompiledRouteSummary] - Bound long compiled-route target lists\n+ * @param {boolean} [rawOptions.boundedCompiledRouteSummary] - Reported as the bounded_compiled_route_summary status field. The brief carries no compiled-route line, so it bounds nothing\n  * @param {boolean} [rawOptions.deduplicateTransforms] - Suppress duplicate same-message system blocks\n  * @param {string} [rawOptions.sourceSignatureOverride] - Test override for advisor source signature\n  * @returns {Promise<Object>} Hooks with `event`, `experimental.chat.system.transform`, and `tool`\ndiff --git a/.opencode/plugins/tests/system-skill-advisor.test.cjs b/.opencode/plugins/tests/system-skill-advisor.test.cjs\nindex de5d05d19b..ab0d2180ff 100644\n--- a/.opencode/plugins/tests/system-skill-advisor.test.cjs\n+++ b/.opencode/plugins/tests/system-skill-advisor.test.cjs\n@@ -481,6 +481,41 @@ test('no-brief turns render the no-match head and hygiene context', async () =>\n   assert.deepEqual(calls[0].options.stdio, ['pipe', 'pipe', 'ignore']);\n });\n \n+test('renders the command, its policy and its owner from the advisor row', async () => {\n+  const previousChildSession = process.env.AI_SESSION_CHILD;\n+  // A dispatched child renders a start policy as parent-named, so read the row as\n+  // the operator's own session does.\n+  delete process.env.AI_SESSION_CHILD;\n+  try {\n+    const hooks = await makePlugin({\n+      spawnOverride: spawnSequence([fakeChild({\n+        stdout: cliEnvelope({\n+          freshness: 'live',\n+          recommendations: [{\n+            // The owner differs from the skill, so a dropped owner changes the label.\n+            skillId: 'system-spec-kit',\n+            score: 0.9,\n+            confidence: 0.95,\n+            uncertainty: 0.12,\n+            command: '/create:agent',\n+            policy: 'start',\n+            ownerSkillId: 'sk-doc',\n+          }],\n+        }),\n+      })]),\n+    });\n+    const output = await runPrompt(hooks);\n+\n+    assert.ok(output.system[0].includes('sk-doc → /create:agent (start)'));\n+  } finally {\n+    if (previousChildSession === undefined) {\n+      delete process.env.AI_SESSION_CHILD;\n+    } else {\n+      process.env.AI_SESSION_CHILD = previousChildSession;\n+    }\n+  }\n+});\n+\n test('the stdin request stays inside the byte budget when the prompt needs escaping', async () => {\n   const child = fakeChild({ stdout: cliEnvelope({ freshness: 'live', recommendations: [] }) });\n   const hooks = await makePlugin({ maxPromptBytes: 600, spawnOverride: spawnSequence([child]) });\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"diff --git a/.opencode/plugins/system-skill-advisor.js b/.opencode/plugins/system-skill-advisor.js\nindex c07a378b82..0a68910fdc 100644\n--- a/.opencode/plugins/system-skill-advisor.js\n+++ b/.opencode/plugins/system-skill-advisor.js\n@@ -585,24 +585,6 @@ function cliRecommendations(data, options) {\n     });\n }\n \n-// Compact the served compiled decision the advisor attached to a recommendation.\n-// Returns null when no recommendation carried a route, which keeps the injected\n-// context byte-identical to the legacy brief.\n-function compiledRouteSummary(data) {\n-  if (!Array.isArray(data?.recommendations)) return null;\n