",\n  \"firstSeen\": 1,\n  \"lastSeen\": 1,\n  \"status\": \"active\",\n  \"transitions\": [\n   {\n    \"iteration\": 1,\n    \"from\": null,\n    \"to\": \"P2\",\n    \"reason\": \"Initial discovery (delta)\"\n   }\n  ],\n  \"dimensions\": [\n   \"correctness\"\n  ],\n  \"mergedFindingIds\": []\n }\n]\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"cd specs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/review/lineages/advisor-runtime-3 && python3 -c \\\"\\nimport json\\nd=json.load(open('deep-review-findings-registry.json'))\\nprint(json.dumps(d.get('openFindings',[])[:1], indent=1)[:2000])\\n\\\"\"}"},"time":{"start":1794594425562,"end":1794594426194}}}}
