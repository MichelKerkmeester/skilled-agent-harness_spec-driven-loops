t [configPath,workflowPath,outPath]=process.argv.slice(1);\\nconst sha=(b)=>crypto.createHash(\\\"sha256\\\").update(b).digest(\\\"hex\\\");\\nconst raw=fs.readFileSync(configPath); const config=JSON.parse(raw);\\nconst targetTypes={files:\\\"file\\\",file:\\\"file\\\",directory:\\\"directory\\\",\\\"spec-folder\\\":\\\"directory\\\",track:\\\"directory\\\",repository:\\\"repository\\\"};\\nconst lineageModes={new:\\\"fresh\\\",fresh:\\\"fresh\\\",restart:\\\"restart\\\",resume:\\\"resume\\\"};\\nconst topic=typeof config.topic===\\\"string\\\"&&config.topic.trim()!==\\\"\\\"&&config.topic.length<=4096?config.topic:null;\\nfs.writeFileSync(outPath,JSON.stringify({stem:\\\"deep_review.run_initialized\\\",scope:{runId:config.sessionId,sessionId:config.sessionId,generation:Number(config.generation)||1},data:{target:{targetId:\\\"review-target\\\",targetType:targetTypes[config.reviewTargetType]||\\\"artifact\\\",artifactRef:\\\"deep-review-config.json#reviewTarget\\\",sourceDigest:sha(String(config.reviewTarget)),contentDigest:sha(raw)},lineageMode:lineageModes[config.lineageMode]||\\\"fresh\\\",maxIterations:Number(config.maxIterations),convergencePolicyVersion:\\\"convergence-policy@\\\"+((config.antiConvergence&&config.antiConvergence.convergenceMode)||\\\"default\\\"),reviewModeContractDigest:sha(fs.readFileSync(workflowPath)),initialReleaseReadinessState:\\\"not-assessed\\\",...(topic===null?{}:{topic})}}));\\n' specs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/review/lineages/advisor-runtime-3/deep-review-config.json .skilled/commands/deep/assets/deep-review-auto.yaml specs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/review/lineages/advisor-runtime-3/logs/run-open-event.json && node .skilled/skills/system-deep-loop/runtime/scripts/append-mode-event.cjs --mode review --run-directory specs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/review/lineages/advisor-runtime-3 --event-json specs/system-