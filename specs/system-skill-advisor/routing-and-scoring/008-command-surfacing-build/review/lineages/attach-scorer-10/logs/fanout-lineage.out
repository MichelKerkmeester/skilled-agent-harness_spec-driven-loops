th(value.slice(0, midpoint), 'utf8') <= MAX_PROMPT_BYTES) {\n.skilled/skills/system-skill-advisor/runtime/lib/skill-graph/bfs-traversal.ts:54:  readonly truncated: boolean;\n.skilled/skills/system-skill-advisor/runtime/lib/skill-graph/bfs-traversal.ts:83:  let truncated = false;\n.skilled/skills/system-skill-advisor/runtime/lib/skill-graph/bfs-traversal.ts:91:      truncated = true;\n.skilled/skills/system-skill-advisor/runtime/lib/skill-graph/bfs-traversal.ts:112:        return { match: nextState, visited, truncated };\n.skilled/skills/system-skill-advisor/runtime/lib/skill-graph/bfs-traversal.ts:120:  return { match: null, visited, truncated };\n.skilled/skills/system-skill-advisor/runtime/lib/shared/shared-payload.ts:899:function truncateInline(text: string, maxChars: number = SUMMARY_MAX_CHARS): string {\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"rg -n \\\"function escapePhrase\\\" -A 6 .skilled/skills/system-skill-advisor/runtime/lib/command-attach.ts; echo \\\"---PROMPT CAP---\\\"; rg -n \\\"MAX_PROMPT|maxPrompt|prompt\\\\.slice|prompt\\\\.length|truncate\\\" .skilled/skills/system-skill-advisor/runtime/lib .skilled/skills/system-skill-advisor/runtime/handlers .skilled/skills/system-skill-advisor/hooks --glob '!**/node_modules/**' | head -20\",\"workdir\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research\"}"},"time":{"start":1794848348010,"end":1794848350572}}}}
