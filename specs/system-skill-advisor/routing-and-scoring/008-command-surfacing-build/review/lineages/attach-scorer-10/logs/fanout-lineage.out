command: 'speckit:complete:auto:with-research:with-context:with-phases' },\n1555:    const events = [{ seq: 0, kind: 'skill', path: null, command: 'speckit:complete:auto:with-research', text: null }];\n1564:    const events = [{ seq: 0, kind: 'skill', path: null, command: 'speckit:complete:auto:with-research', text: null }];\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"11:import { ADVISOR_RUNTIME_VALUES } from './advisor-runtime-values.js';\n12-\n13-import type {\n14-  AdvisorHookFreshness,\n15-  AdvisorHookStatus,\n16-  AdvisorRuntime,\n17-} from './skill-advisor-brief.js';\n18-\n19-// ───────────────────────────────────────────────────────────────\n20-// 1. TYPES\n21-// ───────────────────────────────────────────────────────────────\n22-\n23:export { ADVISOR_RUNTIME_VALUES } from './advisor-runtime-values.js';\n24-export const ADVISOR_HOOK_STATUS_VALUES = ['ok', 'skipped', 'stale', 'degraded', 'fail_open'] as const;\n25-export const ADVISOR_HOOK_FRESHNESS_VALUES = ['live', 'stale', 'absent', 'unavailable'] as const;\n26-export const ADVISOR_ERROR_CODE_VALUES = [\n27-  'TIMEOUT',\n28-  'SCRIPT_MISSING',\n29-  'SQLITE_BUSY',\n30-  'PARSE_FAIL',\n31-  'SIGNAL_KILLED',\n32-  'GENERATION_COUNTER_CORRUPT',\n33-  'PYTHON_MISSING',\n34-  'NONZERO_EXIT',\n35-  'SQLITE_BUSY_EXHAUSTED',\n--\n424:    && enumIncludes(ADVISOR_RUNTIME_VALUES, record.runtime)\n425-    && enumIncludes(ADVISOR_HOOK_STATUS_VALUES, record.status)\n426-    && enumIncludes(ADVISOR_HOOK_FRESHNESS_VALUES, record.freshness)\n427-    && typeof record.durationMs === 'number'\n---TESTS ON GRAMMAR---\n1544:    { name: 'the longest advertised chain', command: 'speckit:complete:auto:with-research:with-context:with-phases' },\n1555:    const events = [{ seq: 0, kind: 'skill', path: null, command: 'speckit:complete:auto:with-research', text: null }];\n1564:    const events = [{ seq: 0, kind: 'skill', path: null, command: 'speckit:com