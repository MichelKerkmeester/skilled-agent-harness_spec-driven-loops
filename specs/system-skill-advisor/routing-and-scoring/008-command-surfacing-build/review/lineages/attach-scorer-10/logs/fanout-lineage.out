  return emit(\n    combined.decision,\n    combined.stopReason,\n    combined.reasonDetail,\n    evaluated,\n    combined.blockedBy,\n  );\n}\n\n// The stop decision reads loop state from files, so these helpers stay\n// independent of the coverage graph and remain usable when the graph fails.\nfunction isPlainObject(value) {\n  return Boolean(value) && typeof value === 'object' && !Array.isArray(value);\n}\n---GATES---\n894:function evaluateReviewLegalStopGates(review, options = {}) {\n895-  const settings = options && typeof options === 'object' ? options : {};\n896-  const facts = review && typeof review === 'object' ? review : {};\n897-  const missingDimensions = Array.isArray(facts.missingDimensions) ? facts.missingDimensions : [];\n898-  const searchDebt = Array.isArray(facts.searchDebt) ? facts.searchDebt : [];\n899-  const candidateCovered = Array.isArray(facts.candidateCovered) ? facts.candidateCovered : [];\n900-  const requiredBugClasses = Array.isArray(facts.requiredBugClasses) ? facts.requiredBugClasses : [];\n901-  const fallbackCovered = Array.isArray(facts.fallbackCoveredBugClasses)\n902-    ? facts.fallbackCoveredBugClasses\n903-    : [];\n904-  const activeP0 = typeof facts.activeP0 === 'number' ? facts.activeP0 : 0;\n905-  const activeP1 = typeof facts.activeP1 === 'number' ? facts.activeP1 : 0;\n906-  const score = typeof settings.weightedStopScore === 'number'\n907-    && Number.isFinite(settings.weightedStopScore)\n908-    ? settings.weightedStopScore\n909-    : 0;\n910-\n911-  const gates = {\n912-    convergenceGate: {\n913-      pass: settings.hardStop === true || score >= 0.60,\n914-      skipped: false,\n915-      score,\n916-      hardStop: settings.hardStop === true,\n917-    },\n918-    dimensionCoverageGate: {\n919-      pass: missingDimensions.length === 0\n920-        && facts.traceabilityCovered === true\n921-        && facts.coverageAge >= 1,\n922-      skipped: false,\n923-      missing: missingDimensions,\n924-    },\n925-    p0