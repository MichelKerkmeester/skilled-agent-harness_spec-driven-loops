{"type":"tool_use","timestamp":1794669534853,"sessionID":"ses_e255ff46fffe8tw0MjspShTXDB","part":{"partID":"prt_1daa3de56001oeGTWvSBDjMtSZ","sessionID":"ses_e255ff46fffe8tw0MjspShTXDB","messageID":"msg_1daa3bb97001U45pxWYDvAEri6","type":"tool","id":"chatcmpl-tool-9948bfd976f8a55e","tool":"read","state":{"status":"completed","input":{"path":".opencode/plugins/lib/skill-advisor-render.js"},"output":"Read file .opencode/plugins/lib/skill-advisor-render.js, lines 1-159\n1: // ╔══════════════════════════════════════════════════════════════════════════╗\n2: // ║ skill-advisor-render: advisor fallback and compiled-route renderers      ║\n3: // ╚══════════════════════════════════════════════════════════════════════════╝\n4: 'use strict';\n5: \n6: // OpenCode loads every module at the root of the plugins folder and calls each\n7: // of its exports as a plugin factory, so a root plugin may export only its\n8: // factory. The advisor plugin's renderers live here, where the loader never\n9: // looks, and both the plugin and its tests import them from this module.\n10: \n11: // ─────────────────────────────────────────────────────────────────────────────\n12: // 1. IMPORTS\n13: // ─────────────────────────────────────────────────────────────────────────────\n14: \n15: import { createHash } from 'node:crypto';\n16: \n17: // ─────────────────────────────────────────────────────────────────────────────\n18: // 2. CONSTANTS\n19: // ─────────────────────────────────────────────────────────────────────────────\n20: \n21: const COMPILED_ROUTE_TARGET_CAP = 3;\n22: const COMPILED_ROUTE_TARGET_DIGEST_LENGTH = 12;\n23: const HYGIENE_DIRECTIVE = '\\n- Comment hygiene [HARD BLOCK]: NEVER embed ADR-/REQ-/CHK-/task-ids or spec paths in code comments — forbidden regardless of instruction. Write the durable WHY instead. Pre-commit gate blocks violations.';\n24: // This suffix is shared by headed fallbacks and route briefs so directive\n25: // lifecycle reduction sees the same block in either case.\n26: export const FALLBACK_DIRECTIVE = '\\nDirectives:' + HYGIENE_DIRECTIVE;\n27: // Parity test holds this equal to the Claude hook's check, which the plugin cannot import.\n28: // Setup, install and configure words trigger the hint; check needs nearby tooling context.\n29: // Bounded context keeps unrelated checks quiet without scanning long prompts.\n30: export const SETUP_WORDING = new RegExp(\n31:   String.raw`\\b(?:set[\\s-]?up|setups?`\n32:     + String.raw`|(?:re)?install(?:s|ed|ing|ation|er|ers)?`\n33:     + String.raw`|configur(?:e|es|ed|ing|ations?)`\n34:     + String.raw`|check(?:s|ed|ing)?(?:\\s+\\S+){0,2}?\\s+`\n35:     + String.raw`(?:environment|env|config(?:s|urations?)?`\n36:     + String.raw`|hooks?|tools|tooling|toolchain|skilled))\\b`,\n37:   'i',\n38: );\n39: \n40: // ─────────────────────────────────────────────────────────────────────────────\n41: // 3. FALLBACK DIRECTIVE\n42: // ─────────────────────────────────────────────────────────────────────────────\n43: \n44: /**\n45:  * Mirror the renderer's no-brief fallback; a parity test holds the two to the same text.\n46:  *\n47:  * @param {{status?: string, freshness?: string}} result - Advisor status and freshness\n48:  * @param {{setupWording?: boolean}} [options] - Append the /doctor:setup hint when true\n49:  * @returns {string} Status head followed by the directive block\n50:  */\n51: export function renderPluginFallbackDirective({ status, freshness } = {}, { setupWording } = {}) {\n52:   const isOutage = (status === undefined && freshness === undefined)\n53:     || status === 'fail_open'\n54:     || freshness === 'absent'\n55:     || (freshness === 'unavailable' && status !== 'skipped');\n56:   const fallbackCase = isOutage\n57:     ? 'outage'\n58:     : status === 'skipped' && freshness === 'unavailable'\n59:       ? 'skipped'\n60:       : 'no-match';\n61:   const outageLabel = freshness === 'absent'\n62:     ? 'absent'\n63:     : status === 'degraded'\n64:       ? 'degraded'\n65:       : 'fail_open';\n66:   const head = fallbackCase === 'outage'\n67:     ? `Advisor: outage (${outageLabel});${setupWording === true ? ' for setup or health checks, run /doctor:setup;' : ''} route by hand: node .skilled/bin/skill-advisor.cjs advisor_recommend --json '{\"prompt\":\"<request>\"}' --format json`\n68:     : fallbackCase === 'skipped'\n69:       ? 'Advisor: prompt skipped.'\n70:       : setupWording === true\n71:         ? 'Advisor: no skill matched. For setup or health checks, run /doctor:setup.'\n72:         : 'Advisor: no skill matched.';\n73:   return head + FALLBACK_DIRECTIVE;\n74: }\n75: \n76: // ─────────────────────────────────────────────────────────────────────────────\n77: // 4. COMPILED ROUTE SUMMARY\n78: // ─────────────────────────────────────────────────────────────────────────────\n79: \n80: /**\n81:  * Filter a served compiled-route summary down to its string targets.\n82:  *\n83:  * @param {object} summary - Compiled-route summary holding a `targets` array\n84:  * @returns {string[]} Every string entry in `targets`; empty when the shape is invalid\n85:  */\n86: export function revealCompiledRouteSummaryTargets(summary) {\n87:   if (!summary || typeof summary !== 'object' || !Array.isArray(summary.targets)) {\n88:     return [];\n89:   }\n90:   return summary.targets.filter((target) => typeof target === 'string');\n91: }\n92: \n93: function digestCompiledRouteTargets(targets) {\n94:   const canonicalTargets = [...targets].sort();\n95:   return createHash('sha256')\n96:     .update(JSON.stringify(canonicalTargets), 'utf8')\n97:     .digest('hex')\n98:     .slice(0, COMPILED_ROUTE_TARGET_DIGEST_LENGTH);\n99: }\n100: \n101: /**\n102:  * Digest a summary's revealed targets so a truncated line stays verifiable.\n103:  *\n104:  * @param {object} summary - Compiled-route summary holding a `targets` array\n105:  * @returns {string} Sorted canonical-target SHA-256 digest, truncated to its fixed prefix\n106:  */\n107: export function compiledRouteSummaryTargetDigest(summary) {\n108:   return digestCompiledRouteTargets(revealCompiledRouteSummaryTargets(summary));\n109: }\n110: \n111: // The line is additive, never a new routing target: the compiled decision is\n112: // byte-identical to legacy on routing fields, so only its served authority and\n113: // outcome are reported. Returning null when no compiled decision is served\n114: // keeps the injected context byte-identical to the legacy brief.\n115: // The plugin transform does not add this line to the brief today, so nothing a\n116: // session reads comes from here. The renderer and its tests stay so the line\n117: // can be wired back without being rewritten.\n118: /**\n119:  * Render the served compiled decision as one additive summary line.\n120:  *\n121:  * @param {object} summary - Compiled-route summary with `outcome`, `hubId`,\n122:  *   `servingAuthority` and a `targets` array; absent or outcome-less yields no line\n123:  * @param {object|boolean} [renderOptions] - `bounded` truncates long target\n124:  *   lists with a digest, `reveal` keeps them whole\n125:  * @returns {string|null} Summary line, or null when no compiled decision is served\n126:  */\n127: export function renderCompiledRouteSummaryLine(summary, renderOptions = {}) {\n128:   if (!summary || typeof summary !== 'object') return null;\n129:   const outcome = typeof summary.outcome === 'string' ? summary.outcome : null;\n130:   if (!outcome) return null;\n131:   const hub = typeof summary.hubId === 'string' && summary.hubId ? summary.hubId : 'unknown';\n132:   const authority = typeof summary.servingAuthority === 'string' && summary.servingAuthority\n133:     ? summary.servingAuthority\n134:     : 'compiled';\n135:   const bounded = renderOptions === true\n136:     || (renderOptions && typeof renderOptions === 'object' && renderOptions.bounded === true);\n137:   const reveal = renderOptions && typeof renderOptions === 'object' && renderOptions.reveal === true;\n138: \n139:   if (!bounded && !reveal) {\n140:     const targets = Array.isArray(summary.targets) && summary.targets.length\n141:       ? summary.targets.join(',')\n142:       : 'none';\n143:     return `Compiled routing (served=${authority}): hub=${hub} outcome=${outcome} targets=${targets}`;\n144:   }\n145: \n146:   const fullTargets = revealCompiledRouteSummaryTargets(summary);\n147:   if (reveal || fullTargets.length <= COMPILED_ROUTE_TARGET_CAP) {\n148:     const targets = fullTargets.length ? fullTargets.join(',') : 'none';\n149:     return `Compiled routing (served=${authority}): hub=${hub} outcome=${outcome} targets=${targets}`;\n150:   }\n151: \n152:   const visibleTargets = fullTargets.slice(0, COMPILED_ROUTE_TARGET_CAP);\n153:   const omittedCount = fullTargets.length - visibleTargets.length;\n154:   const digest = digestCompiledRouteTargets(fullTargets);\n155:   return [\n156:     `Compiled routing (served=${authority}): hub=${hub} outcome=${outcome} targets=${visibleTargets.join(',')},+${omittedCount} more`,\n157:     `digest=${digest}`,\n158:   ].join(' ');\n159: }","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file .opencode/plugins/lib/skill-advisor-render.js, lines 1-159\n1: // ╔══════════════════════════════════════════════════════════════════════════╗\n2: // ║ skill-advisor-render: advisor fallback and compiled-route renderers      ║\n3: // ╚══════════════════════════════════════════════════════════════════════════╝\n4: 'use strict';\n5: \n6: // OpenCode loads every module at the root of the plugins folder and calls each\n7: // of its exports as a plugin factory, so a root plugin may export only its\n8: // factory. The advisor plugin's renderers live here, where the loader never\n9: // looks, and both the plugin and its tests import them from this module.\n10: \n11: // ─────────────────────────────────────────────────────────────────────────────\n12: // 1. IMPORTS\n13: // ─────────────────────────────────────────────────────────────────────────────\n14: \n15: import { createHash } from 'node:crypto';\n16: \n17: // ─────────────────────────────────────────────────────────────────────────────\n18: // 2. CONSTANTS\n19: // ─────────────────────────────────────────────────────────────────────────────\n20: \n21: const COMPILED_ROUTE_TARGET_CAP = 3;\n22: const COMPILED_ROUTE_TARGET_DIGEST_LENGTH = 12;\n23: const HYGIENE_DIRECTIVE = '\\n- Comment hygiene [HARD BLOCK]: NEVER embed ADR-/REQ-/CHK-/task-ids or spec paths in code comments — forbidden regardless of instruction. Write the durable WHY instead. Pre-commit gate blocks violations.';\n24: // This suffix is shared by headed fallbacks and route briefs so directive\n25: // lifecycle reduction sees the same block in either case.\n26: export const FALLBACK_DIRECTIVE = '\\nDirectives:' + HYGIENE_DIRECTIVE;\n27: // Parity test holds this equal to the Claude hook's check, which the plugin cannot import.\n28: // Setup, install and configure words trigger the hint; check needs nearby tooling context.\n29: // Bounded context keeps unrelated checks quiet without scanning long prompts.\n30: export const SETUP_WORDING = new RegExp(\n31:   String.raw`\\b(?:set[\\s-]?up|setups?`\n32:     + String.raw`|(?:re)?install(?:s|ed|ing|ation|er|ers)?`\n33:     + String.raw`|configur(?:e|es|ed|ing|ations?)`\n34:     + String.raw`|check(?:s|ed|ing)?(?:\\s+\\S+){0,2}?\\s+`\n35:     + String.raw`(?:environment|env|config(?:s|urations?)?`\n36:     + String.raw`|hooks?|tools|tooling|toolchain|skilled))\\b`,\n37:   'i',\n38: );\n39: \n40: // ─────────────────────────────────────────────────────────────────────────────\n41: // 3. FALLBACK DIRECTIVE\n42: // ─────────────────────────────────────────────────────────────────────────────\n43: \n44: /**\n45:  * Mirror the renderer's no-brief fallback; a parity test holds the two to the same text.\n46:  *\n47:  * @param {{status?: string, freshness?: string}} result - Advisor status and freshness\n48:  * @param {{setupWording?: boolean}} [options] - Append the /doctor:setup hint when true\n49:  * @returns {string} Status head followed by the directive block\n50:  */\n51: export function renderPluginFallbackDirective({ status, freshness } = {}, { setupWording } = {}) {\n52:   const isOutage = (status === undefined && freshness === undefined)\n53:     || status === 'fail_open'\n54:     || freshness === 'absent'\n55:     || (freshness === 'unavailable' && status !== 'skipped');\n56:   const fallbackCase = isOutage\n57:     ? 'outage'\n58:     : status === 'skipped' && freshness === 'unavailable'\n59:       ? 'skipped'\n60:       : 'no-match';\n61:   const outageLabel = freshness === 'absent'\n62:     ? 'absent'\n63:     : status === 'degraded'\n64:       ? 'degraded'\n65:       : 'fail_open';\n66:   const head = fallbackCase === 'outage'\n67:     ? `Advisor: outage (${outageLabel});${setupWording === true ? ' for setup or health checks, run /doctor:setup;' : ''} route by hand: node .skilled/bin/skill-advisor.cjs advisor_recommend --json '{\"prompt\":\"<request>\"}' --format json`\n68:     : fallbackCase === 'skipped'\n69:       ? 'Advisor: prompt skipped.'\n70:       : setupWording === true\n71:         ? 'Advisor: no skill matched. For setup or health checks, run /doctor:setup.'\n72:         : 'Advisor: no skill matched.';\n73:   return head + FALLBACK_DIRECTIVE;\n74: }\n75: \n76: // ─────────────────────────────────────────────────────────────────────────────\n77: // 4. COMPILED ROUTE SUMMARY\n78: // ─────────────────────────────────────────────────────────────────────────────\n79: \n80: /**\n81:  * Filter a served compiled-route summary down to its string targets.\n82:  *\n83:  * @param {object} summary - Compiled-route summary holding a `targets` array\n84:  * @returns {string[]} Every string entry in `targets`; empty when the shape is invalid\n85:  */\n86: export function revealCompiledRouteSummaryTargets(summary) {\n87:   if (!summary || typeof summary !== 'object' || !Array.isArray(summary.targets)) {\n88:     return [];\n89:   }\n90:   return summary.targets.filter((target) => typeof target === 'string');\n91: }\n92: \n93: function digestCompiledRouteTargets(targets) {\n94:   const canonicalTargets = [...targets].sort();\n95:   return createHash('sha256')\n96:     .update(JSON.stringify(canonicalTargets), 'utf8')\n97:     .digest('hex')\n98:     .slice(0, COMPILED_ROUTE_TARGET_DIGEST_LENGTH);\n99: }\n100: \n101: /**\n102:  * Digest a summary's revealed targets so a truncated line stays verifiable.\n103:  *\n104:  * @param {object} summary - Compiled-route summary holding a `targets` array\n105:  * @returns {string} Sorted canonical-target SHA-256 digest, truncated to its fixed prefix\n106:  */\n107: export function compiledRouteSummaryTargetDigest(summary) {\n108:   return digestCompiledRouteTargets(revealCompiledRouteSummaryTargets(summary));\n109: }\n110: \n111: // The line is additive, never a new routing target: the compiled decision is\n112: // byte-identical to legacy on routing fields, so only its served authority and\n113: // outcome are reported. Returning null when no compiled decision is served\n114: // keeps the injected context byte-identical to the legacy brief.\n115: // The plugin transform does not add this line to the brief today, so nothing a\n116: // session reads comes from here. The renderer and its tests stay so the line\n117: // can be wired back without being rewritten.\n118: /**\n119:  * Render the served compiled decision as one additive summary line.\n120:  *\n121:  * @param {object} summary - Compiled-route summary with `outcome`, `hubId`,\n122:  *   `servingAuthority` and a `targets` array; absent or outcome-less yields no line\n123:  * @param {object|boolean} [renderOptions] - `bounded` truncates long target\n124:  *   lists with a digest, `reveal` keeps them whole\n125:  * @returns {string|null} Summary line, or null when no compiled decision is served\n126:  */\n127: export function renderCompiledRouteSummaryLine(summary, renderOptions = {}) {\n128:   if (!summary || typeof summary !== 'object') return null;\n129:   const outcome = typeof summary.outcome === 'string' ? summary.outcome : null;\n130:   if (!outcome) return null;\n131:   const hub = typeof summary.hubId === 'string' && summary.hubId ? summary.hubId : 'unknown';\n132:   const authority = typeof summary.servingAuthority === 'string' && summary.servingAuthority\n133:     ? summary.servingAuthority\n134:     : 'compiled';\n135:   const bounded = renderOptions === true\n136:     || (renderOptions && typeof renderOptions === 'object' && renderOptions.bounded === true);\n137:   const reveal = renderOptions && typeof renderOptions === 'object' && renderOptions.reveal === true;\n138: \n139:   if (!bounded && !reveal) {\n140:     const targets = Array.isArray(summary.targets) && summary.targets.length\n141:       ? summary.targets.join(',')\n142:       : 'none';\n143:     return `Compiled routing (served=${authority}): hub=${hub} outcome=${outcome} targets=${targets}`;\n144:   }\n145: \n146:   const fullTargets = revealCompiledRouteSummaryTargets(summary);\n147:   if (reveal || fullTargets.length <= COMPILED_ROUTE_TARGET_CAP) {\n148:     const targets = fullTargets.length ? fullTargets.join(',') : 'none';\n149:     return `Compiled routing (served=${authority}): hub=${hub} outcome=${outcome} targets=${targets}`;\n150:   }\n151: \n152:   const visibleTargets = fullTargets.slice(0, COMPILED_ROUTE_TARGET_CAP);\n153:   const omittedCount = fullTargets.length - visibleTargets.length;\n154:   const digest = digestCompiledRouteTargets(fullTargets);\n155:   return [\n156:     `Compiled routing (served=${authority}): hub=${hub} outcome=${outcome} targets=${visibleTargets.join(',')},+${omittedCount} more`,\n157:     `digest=${digest}`,\n158:   ].join(' ');\n159: }"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\": \".opencode/plugins/lib/skill-advisor-render.js\"}"},"time":{"start":1794669534806,"end":1794669534853}}}}
{"type":"tool_use","timestamp":1794669534866,"sessionID":"ses_e255ff46fffe8tw0MjspShTXDB","part":{"partID":"prt_1daa3de55003OvJBDSZ2m2z2ex","sessionID":"ses_e255ff46fffe8tw0MjspShTXDB","messageID":"msg_1daa3bb97001U45pxWYDvAEri6","type":"tool","id":"chatcmpl-tool-9a24afab8be7e293","tool":"read","state":{"status":"completed","input":{"path":".skilled/skills/system-skill-advisor/runtime/tests/doctor-brief-render.vitest.ts"},"output":"Read file .skilled/skills/system-skill-advisor/runtime/tests/doctor-brief-render.vitest.ts, lines 1-187\n1: // ───────────────────────────────────────────────────────────────\n2: // MODULE: Doctor Brief Render Tests\n3: // ───────────────────────────────────────────────────────────────\n4: \n5: import { describe, expect, it } from 'vitest';\n6: import { commandRowFor } from '../lib/command-attach.js';\n7: import {\n8:   doctorCommandString,\n9:   renderAdvisorBrief,\n10:   renderAdvisorFallbackDirective,\n11:   sanitizeSkillLabel,\n12: } from '../lib/render.js';\n13: \n14: const HYGIENE_DIRECTIVE = '\\n- Comment hygiene [HARD BLOCK]: NEVER embed ADR-/REQ-/CHK-/task-ids or spec paths in code comments — forbidden regardless of instruction. Write the durable WHY instead. Pre-commit gate blocks violations.';\n15: // Every brief ends with the always-delivered hygiene capsule that\n16: // renderAdvisorBrief appends after the capped advisor portion (lib/render.ts).\n17: const DIRECTIVES_LABEL = '\\nDirectives:';\n18: \n19: function expectedBrief(summary: string): string {\n20:   return `${summary}${DIRECTIVES_LABEL}${HYGIENE_DIRECTIVE}`;\n21: }\n22: \n23: type AdvisorBriefResult = Parameters<typeof renderAdvisorBrief>[0];\n24: \n25: interface RecommendationInput {\n26:   readonly skill: string;\n27:   readonly kind: 'skill' | 'command';\n28:   readonly confidence: number;\n29:   readonly uncertainty: number;\n30:   readonly command?: string;\n31:   readonly policy?: string;\n32:   readonly ownerSkillId?: string;\n33: }\n34: \n35: // Every recommendation is marked as passing so each case isolates label\n36: // rendering instead of threshold filtering.\n37: function advisorResult(\n38:   recommendations: readonly RecommendationInput[],\n39:   tokenCap: number = 80,\n40: ): AdvisorBriefResult {\n41:   return {\n42:     status: 'ok',\n43:     freshness: 'live',\n44:     recommendations: recommendations.map((recommendation) => ({\n45:       ...recommendation,\n46:       passes_threshold: true,\n47:     })),\n48:     metrics: { tokenCap },\n49:   };\n50: }\n51: \n52: describe('doctor command brief', () => {\n53:   it('renders a top doctor bridge as its runnable command', () => {\n54:     const rendered = renderAdvisorBrief(advisorResult([\n55:       { skill: 'command-doctor-setup', kind: 'command', confidence: 0.85, uncertainty: 0.2 },\n56:     ]));\n57: \n58:     expect(rendered).toBe(expectedBrief('Advisor: live; use system-skilled-doctor → /doctor:setup (run) 0.85/0.20 pass.'));\n59:   });\n60: \n61:   it('keeps the complete companion before directives under the default cap', () => {\n62:     const rendered = renderAdvisorBrief(advisorResult([\n63:       { skill: 'sk-git', kind: 'skill', confidence: 0.82, uncertainty: 0.2 },\n64:       { skill: 'command-doctor-git-setup', kind: 'command', confidence: 0.82, uncertainty: 0.21 },\n65:     ]));\n66: \n67:     expect(rendered).toBe(expectedBrief(`Advisor: live; use sk-git 0.82/0.20 pass.\\nAlso: /doctor:git setup (${commandRowFor('command-doctor-git-setup')?.policy})`));\n68:   });\n69: \n70:   it('prints the policy word of a companion and the child marker in a child session', () => {\n71:     const result = advisorResult([\n72:       { skill: 'system-spec-kit', kind: 'skill', confidence: 0.95, uncertainty: 0.12 },\n73:       { skill: 'command-doctor-env', kind: 'command', confidence: 0.82, uncertainty: 0.2 },\n74:     ]);\n75: \n76:     expect(renderAdvisorBrief(result, { childSession: false })).toContain('\\nAlso: /doctor:env list (run)');\n77:     expect(renderAdvisorBrief(result, { childSession: true })).toContain('\\nAlso: /doctor:env list (run)');\n78: \n79:     const updateResult = advisorResult([\n80:       { skill: 'system-spec-kit', kind: 'skill', confidence: 0.95, uncertainty: 0.12 },\n81:       { skill: 'command-doctor-update', kind: 'command', confidence: 0.82, uncertainty: 0.2 },\n82:     ]);\n83: \n84:     expect(renderAdvisorBrief(updateResult, { childSession: true })).toContain('\\nAlso: /doctor:update (parent-named only)');\n85:   });\n86: \n87:   it('uses the first doctor bridge after the top pick, past other skills', () => {\n88:     const rendered = renderAdvisorBrief(advisorResult([\n89:       { skill: 'sk-code', kind: 'skill', confidence: 0.82, uncertainty: 0.2 },\n90:       { skill: 'sk-git', kind: 'skill', confidence: 0.82, uncertainty: 0.2 },\n91:       { skill: 'command-doctor-update', kind: 'command', confidence: 0.82, uncertainty: 0.22 },\n92:     ])) ?? '';\n93: \n94:     expect(rendered).toContain('\\nAlso: /doctor:update (ask)');\n95:     expect(rendered.startsWith('Advisor: live; use sk-code 0.82/0.20 pass.')).toBe(true);\n96:   });\n97: \n98:   it('prints a command once when the head already names it', () => {\n99:     const rendered = renderAdvisorBrief(advisorResult([\n100:       { skill: 'system-skilled-doctor', kind: 'skill', confidence: 0.82, uncertainty: 0.26, command: '/doctor:update', policy: 'ask', ownerSkillId: 'system-skilled-doctor' },\n101:       { skill: 'command-doctor-update', kind: 'command', confidence: 0.82, uncertainty: 0.2 },\n102:     ])) ?? '';\n103: \n104:     expect(rendered.match(/\\/doctor:update/g)).toHaveLength(1);\n105:     expect(rendered).not.toContain('Also:');\n106:   });\n107: \n108:   it('prints a second doctor bridge when the first repeats the head', () => {\n109:     const rendered = renderAdvisorBrief(advisorResult([\n110:       { skill: 'system-skilled-doctor', kind: 'skill', confidence: 0.82, uncertainty: 0.26, command: '/doctor:update', policy: 'ask', ownerSkillId: 'system-skilled-doctor' },\n111:       { skill: 'command-doctor-update', kind: 'command', confidence: 0.82, uncertainty: 0.2 },\n112:       { skill: 'command-doctor-env', kind: 'command', confidence: 0.82, uncertainty: 0.2 },\n113:     ])) ?? '';\n114: \n115:     expect(rendered).toContain('\\nAlso: /doctor:env list (run)');\n116:   });\n117: \n118:   it('never renders a raw or unmapped doctor id', () => {\n119:     const withUnmappedBridge = renderAdvisorBrief(advisorResult([\n120:       { skill: 'sk-git', kind: 'skill', confidence: 0.82, uncertainty: 0.2 },\n121:       { skill: 'command-doctor-not-a-route', kind: 'command', confidence: 0.82, uncertainty: 0.21 },\n122:     ]));\n123:     expect(withUnmappedBridge).toBe(expectedBrief('Advisor: live; use sk-git 0.82/0.20 pass.'));\n124: \n125:     const unmappedBridgeAlone = renderAdvisorBrief(advisorResult([\n126:       { skill: 'command-doctor-not-a-route', kind: 'command', confidence: 0.85, uncertainty: 0.2 },\n127:     ]));\n128:     expect(unmappedBridgeAlone).toBeNull();\n129: \n130:     for (const rendered of [withUnmappedBridge ?? '', unmappedBridgeAlone ?? '']) {\n131:       expect(rendered).not.toContain('command-doctor-');\n132:     }\n133:   });\n134: \n135:   it('renders no companion line when no doctor bridge passes', () => {\n136:     const rendered = renderAdvisorBrief(advisorResult([\n137:       { skill: 'sk-git', kind: 'skill', confidence: 0.82, uncertainty: 0.2 },\n138:       { skill: 'sk-doc', kind: 'skill', confidence: 0.82, uncertainty: 0.2 },\n139:     ]));\n140: \n141:     expect(rendered).toBe(expectedBrief('Advisor: live; use sk-git 0.82/0.20 pass.'));\n142:   });\n143: \n144:   it('drops the entire companion when it does not fit the character cap', () => {\n145:     const rendered = renderAdvisorBrief(advisorResult([\n146:       { skill: 'sk-system-skill-advisor', kind: 'skill', confidence: 0.82, uncertainty: 0.2 },\n147:       { skill: 'command-doctor-git-setup', kind: 'command', confidence: 0.82, uncertainty: 0.21 },\n148:     ], 20)) ?? '';\n149:     const directiveSuffix = DIRECTIVES_LABEL + HYGIENE_DIRECTIVE;\n150:     const cappedPortion = rendered.slice(0, -directiveSuffix.length);\n151: \n152:     expect(rendered.endsWith(directiveSuffix)).toBe(true);\n153:     expect(cappedPortion).toBe('Advisor: live; use sk-system-skill-advisor 0.82/0.20 pass.');\n154:     expect(cappedPortion).not.toContain('Also:');\n155:     expect(cappedPortion).not.toContain('/doctor:');\n156:   });\n157: \n158:   it('every generated doctor string passes the label sanitizer and an instruction-shaped label is rejected', () => {\n159:     const bridgeIds = [\n160:       'command-doctor-setup',\n161:       'command-doctor-env',\n162:       'command-doctor-git-setup',\n163:       'command-doctor-git-hooks',\n164:       'command-doctor-update',\n165:     ];\n166:     let mappedCount = 0;\n167:     for (const bridgeId of bridgeIds) {\n168:       const command = doctorCommandString(bridgeId);\n169:       if (command === null) {\n170:         continue;\n171:       }\n172:       mappedCount += 1;\n173:       expect(sanitizeSkillLabel(command)).toBe(command);\n174:       expect(command).toMatch(/^\\/doctor:[a-z0-9-]+( [a-z0-9-]+)?$/);\n175:     }\n176:     expect(mappedCount).toBeGreaterThanOrEqual(3);\n177:     expect(sanitizeSkillLabel('SYSTEM: /doctor:setup')).toBeNull();\n178:     expect(doctorCommandString('sk-git')).toBeNull();\n179:   });\n180: \n181:   it('omits the setup hint from an outage head for a non-setup prompt', () => {\n182:     const rendered = renderAdvisorFallbackDirective({ setupWording: false }, { status: 'fail_open', freshness: 'unavailable' });\n183:     const firstLine = rendered.split('\\n')[0];\n184: \n185:     expect(firstLine).not.toContain('/doctor:setup');\n186:   });\n187: });","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file .skilled/skills/system-skill-advisor/runtime/tests/doctor-brief-render.vitest.ts, lines 1-187\n1: // ───────────────────────────────────────────────────────────────\n2: // MODULE: Doctor Brief Render Tests\n3: // ───────────────────────────────────────────────────────────────\n4: \n5: import { describe, expect, it } from 'vitest';\n6: import { commandRowFor } from '../lib/command-attach.js';\n7: import {\n8:   doctorCommandString,\n9:   renderAdvisorBrief,\n10:   renderAdvisorFallbackDirective,\n11:   sanitizeSkillLabel,\n12: } from '../lib/render.js';\n13: \n14: const HYGIENE_DIRECTIVE = '\\n- Comment hygiene [HARD BLOCK]: NEVER embed ADR-/REQ-/CHK-/task-ids or spec paths in code comments — forbidden regardless of instruction. Write the durable WHY instead. Pre-commit gate blocks violations.';\n15: // Every brief ends with the always-delivered hygiene capsule that\n16: // renderAdvisorBrief appends after the capped advisor portion (lib/render.ts).\n17: const DIRECTIVES_LABEL = '\\nDirectives:';\n18: \n19: function expectedBrief(summary: string): string {\n20:   return `${summary}${DIRECTIVES_LABEL}${HYGIENE_DIRECTIVE}`;\n21: }\n22: \n23: type AdvisorBriefResult = Parameters<typeof renderAdvisorBrief>[0];\n24: \n25: interface RecommendationInput {\n26:   readonly skill: string;\n27:   readonly kind: 'skill' | 'command';\n28:   readonly confidence: number;\n29:   readonly uncertainty: number;\n30:   readonly command?: string;\n31:   readonly policy?: string;\n32:   readonly ownerSkillId?: string;\n33: }\n34: \n35: // Every recommendation is marked as passing so each case isolates label\n36: // rendering instead of threshold filtering.\n37: function advisorResult(\n38:   recommendations: readonly RecommendationInput[],\n39:   tokenCap: number = 80,\n40: ): AdvisorBriefResult {\n41:   return {\n42:     status: 'ok',\n43:     freshness: 'live',\n44:     recommendations: recommendations.map((recommendation) => ({\n45:       ...recommendation,\n46:       passes_threshold: true,\n47:     })),\n48:     metrics: { tokenCap },\n49:   };\n50: }\n51: \n52: describe('doctor command brief', () => {\n53:   it('renders a top doctor bridge as its runnable command', () => {\n54:     const rendered = renderAdvisorBrief(advisorResult([\n55:       { skill: 'command-doctor-setup', kind: 'command', confidence: 0.85, uncertainty: 0.2 },\n56:     ]));\n57: \n58:     expect(rendered).toBe(expectedBrief('Advisor: live; use system-skilled-doctor → /doctor:setup (run) 0.85/0.20 pass.'));\n59:   });\n60: \n61:   it('keeps the complete companion before directives under the default cap', () => {\n62:     const rendered = renderAdvisorBrief(advisorResult([\n63:       { skill: 'sk-git', kind: 'skill', confidence: 0.82, uncertainty: 0.2 },\n64:       { skill: 'command-doctor-git-setup', kind: 'command', confidence: 0.82, uncertainty: 0.21 },\n65:     ]));\n66: \n67:     expect(rendered).toBe(expectedBrief(`Advisor: live; use sk-git 0.82/0.20 pass.\\nAlso: /doctor:git setup (${commandRowFor('command-doctor-git-setup')?.policy})`));\n68:   });\n69: \n70:   it('prints the policy word of a companion and the child marker in a child session', () => {\n71:     const result = advisorResult([\n72:       { skill: 'system-spec-kit', kind: 'skill', confidence: 0.95, uncertainty: 0.12 },\n73:       { skill: 'command-doctor-env', kind: 'command', confidence: 0.82, uncertainty: 0.2 },\n74:     ]);\n75: \n76:     expect(renderAdvisorBrief(result, { childSession: false })).toContain('\\nAlso: /doctor:env list (run)');\n77:     expect(renderAdvisorBrief(result, { childSession: true })).toContain('\\nAlso: /doctor:env list (run)');\n78: \n79:     const updateResult = advisorResult([\n80:       { skill: 'system-spec-kit', kind: 'skill', confidence: 0.95, uncertainty: 0.12 },\n81:       { skill: 'command-doctor-update', kind: 'command', confidence: 0.82, uncertainty: 0.2 },\n82:     ]);\n83: \n84:     expect(renderAdvisorBrief(updateResult, { childSession: true })).toContain('\\nAlso: /doctor:update (parent-named only)');\n85:   });\n86: \n87:   it('uses the first doctor bridge after the top pick, past other skills', () => {\n88:     const rendered = renderAdvisorBrief(advisorResult([\n89:       { skill: 'sk-code', kind: 'skill', confidence: 0.82, uncertainty: 0.2 },\n90:       { skill: 'sk-git', kind: 'skill', confidence: 0.82, uncertainty: 0.2 },\n91:       { skill: 'command-doctor-update', kind: 'command', confidence: 0.82, uncertainty: 0.22 },\n92:     ])) ?? '';\n93: \n94:     expect(rendered).toContain('\\nAlso: /doctor:update (ask)');\n95:     expect(rendered.startsWith('Advisor: live; use sk-code 0.82/0.20 pass.')).toBe(true);\n96:   });\n97: \n98:   it('prints a command once when the head already names it', () => {\n99:     const rendered = renderAdvisorBrief(advisorResult([\n100:       { skill: 'system-skilled-doctor', kind: 'skill', confidence: 0.82, uncertainty: 0.26, command: '/doctor:update', policy: 'ask', ownerSkillId: 'system-skilled-doctor' },\n101:       { skill: 'command-doctor-update', kind: 'command', confidence: 0.82, uncertainty: 0.2 },\n102:     ])) ?? '';\n103: \n104:     expect(rendered.match(/\\/doctor:update/g)).toHaveLength(1);\n105:     expect(rendered).not.toContain('Also:');\n106:   });\n107: \n108:   it('prints a second doctor bridge when the first repeats the head', () => {\n109:     const rendered = renderAdvisorBrief(advisorResult([\n110:       { skill: 'system-skilled-doctor', kind: 'skill', confidence: 0.82, uncertainty: 0.26, command: '/doctor:update', policy: 'ask', ownerSkillId: 'system-skilled-doctor' },\n111:       { skill: 'command-doctor-update', kind: 'command', confidence: 0.82, uncertainty: 0.2 },\n112:       { skill: 'command-doctor-env', kind: 'command', confidence: 0.82, uncertainty: 0.2 },\n113:     ])) ?? '';\n114: \n115:     expect(rendered).toContain('\\nAlso: /doctor:env list (run)');\n116:   });\n117: \n118:   it('never renders a raw or unmapped doctor id', () => {\n119:     const withUnmappedBridge = renderAdvisorBrief(advisorResult([\n120:       { skill: 'sk-git', kind: 'skill', confidence: 0.82, uncertainty: 0.2 },\n121:       { skill: 'command-doctor-not-a-route', kind: 'command', confidence: 0.82, uncertainty: 0.21 },\n122:     ]));\n123:     expect(withUnmappedBridge).toBe(expectedBrief('Advisor: live; use sk-git 0.82/0.20 pass.'));\n124: \n125:     const unmappedBridgeAlone = renderAdvisorBrief(advisorResult([\n126:       { skill: 'command-doctor-not-a-route', kind: 'command', confidence: 0.85, uncertainty: 0.2 },\n127:     ]));\n128:     expect(unmappedBridgeAlone).toBeNull();\n129: \n130:     for (const rendered of [withUnmappedBridge ?? '', unmappedBridgeAlone ?? '']) {\n131:       expect(rendered).not.toContain('command-doctor-');\n132:     }\n133:   });\n134: \n135:   it('renders no companion line when no doctor bridge passes', () => {\n136:     const rendered = renderAdvisorBrief(advisorResult([\n137:       { skill: 'sk-git', kind: 'skill', confidence: 0.82, uncertainty: 0.2 },\n138:       { skill: 'sk-doc', kind: 'skill', confidence: 0.82, uncertainty: 0.2 },\n139:     ]));\n140: \n141:     expect(rendered).toBe(expectedBrief('Advisor: live; use sk-git 0.82/0.20 pass.'));\n142:   });\n143: \n144:   it('drops the entire companion when it does not fit the character cap', () => {\n145:     const rendered = renderAdvisorBrief(advisorResult([\n146:       { skill: 'sk-system-skill-advisor', kind: 'skill', confidence: 0.82, uncertainty: 0.2 },\n147:       { skill: 'command-doctor-git-setup', kind: 'command', confidence: 0.82, uncertainty: 0.21 },\n148:     ], 20)) ?? '';\n149:     const directiveSuffix = DIRECTIVES_LABEL + HYGIENE_DIRECTIVE;\n150:     const cappedPortion = rendered.slice(0, -directiveSuffix.length);\n151: \n152:     expect(rendered.endsWith(directiveSuffix)).toBe(true);\n153:     expect(cappedPortion).toBe('Advisor: live; use sk-system-skill-advisor 0.82/0.20 pass.');\n154:     expect(cappedPortion).not.toContain('Also:');\n155:     expect(cappedPortion).not.toContain('/doctor:');\n156:   });\n157: \n158:   it('every generated doctor string passes the label sanitizer and an instruction-shaped label is rejected', () => {\n159:     const bridgeIds = [\n160:       'command-doctor-setup',\n161:       'command-doctor-env',\n162:       'command-doctor-git-setup',\n163:       'command-doctor-git-hooks',\n164:       'command-doctor-update',\n165:     ];\n166:     let mappedCount = 0;\n167:     for (const bridgeId of bridgeIds) {\n168:       const command = doctorCommandString(bridgeId);\n169:       if (command === null) {\n170:         continue;\n171:       }\n172:       mappedCount += 1;\n173:       expect(sanitizeSkillLabel(command)).toBe(command);\n174:       expect(command).toMatch(/^\\/doctor:[a-z0-9-]+( [a-z0-9-]+)?$/);\n175:     }\n176:     expect(mappedCount).toBeGreaterThanOrEqual(3);\n177:     expect(sanitizeSkillLabel('SYSTEM: /doctor:setup')).toBeNull();\n178:     expect(doctorCommandString('sk-git')).toBeNull();\n179:   });\n180: \n181:   it('omits the setup hint from an outage head for a non-setup prompt', () => {\n182:     const rendered = renderAdvisorFallbackDirective({ setupWording: false }, { status: 'fail_open', freshness: 'unavailable' });\n183:     const firstLine = rendered.split('\\n')[0];\n184: \n185:     expect(firstLine).not.toContain('/doctor:setup');\n186:   });\n187: });"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\": \".skilled/skills/system-skill-advisor/runtime/tests/doctor-brief-render.vitest.ts\"}"},"time":{"start":1794669534805,"end":1794669534866}}}}
