Call":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\": \"git diff --stat 0cdc9fa3ef..HEAD -- .opencode/plugins/lib/skill-advisor-render.js .opencode/plugins/system-skill-advisor.js .opencode/plugins/tests/system-skill-advisor.test.cjs .skilled/hooks/shared/session-readers/codex.mjs .skilled/hooks/shared/tests/session-readers/codex.test.mjs .skilled/skills/system-skill-advisor/runtime/lib/render.ts .skilled/skills/system-skill-advisor/runtime/tests/doctor-brief-render.vitest.ts\"}"},"time":{"start":1794669551308,"end":1794669551438}}}}
