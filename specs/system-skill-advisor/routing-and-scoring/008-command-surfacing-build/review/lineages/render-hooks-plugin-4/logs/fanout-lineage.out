outed through the SAME sessionIdFrom() helper the classify\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"93: * Cross-runtime convention for an orchestrated child/dispatched sub-session\n94: * (see worktree-session.sh's own child-detection branch and the cli-external-orchestration\n97: * environment -- only the exact value '1' reads as a child; every other\n101:export const CHILD_SESSION_ENV = 'AI_SESSION_CHILD';\n103:/** True only when CHILD_SESSION_ENV is exactly '1'; every other value is interactive. */\n104:export function isChildSession(env) {\n106:  return environment[CHILD_SESSION_ENV] === '1';\n154:export const GATE_3_CHOICE_RELATED = 'Use a related folder, phase child, new or existing sub-track, or a series parent for a different change to the same artifact as an existing packet in the same track';\n161:  'C) Use a related spec folder, phase child or sub-track (new or existing), or a series parent for a different change to the same artifact as an existing packet in the same track (reply with its path, e.g. specs/<track>/<NNN-name> or specs/<parent>/<NNN-phase>)',\n175:  'C) A related folder, a phase child, a new or existing sub-track, or a series parent for a different change to the same artifact as an existing packet in the same track - reply with its path',\n418:    if (gate3EmissionBlocked(environment) || isChildSession(environment)) return { deliver: false };\n443:    if (gate3EmissionBlocked(environment) || isChildSession(environment)) return false;\n466:    if (gate3EmissionBlocked(environment) || isChildSession(environment)) return false;\n492:    if (isChildSession(environment)) return reject('child_session');\n595:      || isChildSession(environment)\n675:    const childSession = isChildSession(environment);\n687:    if (shadowEnabled && !childSession && question === GATE_3_QUESTION) {\n698:    if (safeRequest.emitted === true && !childSession && question === GATE_3_QUES