{"type":"tool_use","timestamp":1794669515991,"sessionID":"ses_e255ff46fffe8tw0MjspShTXDB","part":{"partID":"prt_1daa393d6002Vw3Un82QlmaD8u","sessionID":"ses_e255ff46fffe8tw0MjspShTXDB","messageID":"msg_1daa36faf001d3xUdAbrVEWtw5","type":"tool","id":"chatcmpl-tool-8baa9197eaffac33","tool":"read","state":{"status":"completed","input":{"path":".skilled/skills/system-skill-advisor/runtime/lib/render.ts"},"output":"Read file .skilled/skills/system-skill-advisor/runtime/lib/render.ts, lines 1-676\n1: // ───────────────────────────────────────────────────────────────\n2: // MODULE: Skill Advisor Brief Renderer\n3: // ───────────────────────────────────────────────────────────────\n4: \n5: import { canonicalFold } from './shared/unicode-normalization.js';\n6: import { resolvedConfidenceThreshold, resolvedUncertaintyThreshold } from './compat/contract.js';\n7: import {\n8:   buildAdvisorRenderPlan,\n9:   evaluateDeliveryState,\n10:   isObservedDeliveryReceipt,\n11:   observeRenderedAdvisorPolicy,\n12:   POLICY_COMMENT_HYGIENE_ID,\n13:   recordObservedPolicyDelivery,\n14:   ROUTE_ADVISOR_ID,\n15:   SHADOW_DELIVERY_STATE_MACHINE,\n16:   type DeliveryStateMachine,\n17:   type DeliveryStateReceipt,\n18:   type DeliveryStateName,\n19:   type DeliveryStateSignals,\n20: } from './policy-plan.js';\n21: import { COMMAND_ROWS, commandRowFor } from './command-attach.js';\n22: import { isAmbiguousTopTwo } from './scorer/ambiguity.js';\n23: import type { AdvisorRecommendation } from './subprocess.js';\n24: import type { AdvisorScoredRecommendation } from './scorer/types.js';\n25: import type { AdvisorHookResult } from './skill-advisor-brief.js';\n26: \n27: // ───────────────────────────────────────────────────────────────\n28: // 1. TYPES\n29: // ───────────────────────────────────────────────────────────────\n30: \n31: export interface AdvisorBriefRenderOptions {\n32:   readonly tokenCap?: number;\n33:   readonly thresholdConfig?: {\n34:     readonly confidenceThreshold?: number;\n35:     readonly uncertaintyThreshold?: number;\n36:     readonly confidenceOnly?: boolean;\n37:   };\n38:   readonly deliveryState?: ShadowDeliveryRenderOptions;\n39:   /**\n40:    * True when prompts use set up, set-up or setup wording, install or reinstall wording\n41:    * including installation and installer, configure or configuration wording or `check`\n42:    * followed within three words by environment, env, config, hooks, tools, tooling,\n43:    * toolchain or skilled. The renderer never reads prompt text.\n44:    */\n45:   readonly setupWording?: boolean;\n46:   /**\n47:    * True when a dispatched child renders the brief. A child keeps the skill line\n48:    * but a command it must not start alone renders as parent-named only. Defaults\n49:    * to `AI_SESSION_CHILD === '1'`.\n50:    */\n51:   readonly childSession?: boolean;\n52: }\n53: \n54: export interface ShadowDeliveryRenderOptions extends DeliveryStateSignals {\n55:   readonly runtime?: string;\n56:   readonly candidate?: string | null;\n57:   readonly stateMachine?: DeliveryStateMachine;\n58:   readonly deliveryConfirmed?: boolean;\n59:   readonly receipt?: DeliveryStateReceipt;\n60:   readonly transformMessageIdentity?: string | null;\n61:   readonly onShadowLog?: (record: ShadowRouteOnlyLogRecord) => void;\n62: }\n63: \n64: export interface ShadowRouteOnlyLogRecord {\n65:   readonly shadowId: string;\n66:   readonly sessionKnown: boolean;\n67:   readonly epoch: number;\n68:   readonly policySetHash: string;\n69:   readonly routeState: DeliveryStateName | null;\n70:   readonly emittedByteCount: number;\n71:   readonly routeOnlyByteCount: number;\n72:   readonly savedBytes: number;\n73: }\n74: \n75: export interface AdvisorBriefRenderableResult {\n76:   readonly status: 'ok' | 'stale' | 'skipped' | 'degraded' | 'fail_open';\n77:   readonly freshness: 'live' | 'stale' | 'absent' | 'unavailable';\n78:   readonly recommendations: readonly AdvisorRecommendation[];\n79:   readonly ambiguous?: boolean;\n80:   readonly metrics?: {\n81:     readonly tokenCap?: number;\n82:   } | null;\n83:   readonly sharedPayload?: {\n84:     readonly metadata?: {\n85:       readonly skillLabel?: string | null;\n86:     } | null;\n87:   } | null;\n88: }\n89: \n90: export type AdvisorFallbackCase = 'outage' | 'no-match' | 'skipped';\n91: export type AdvisorFallbackClassification =\n92:   | {\n93:     readonly fallbackCase: 'outage';\n94:     readonly outageLabel: 'absent' | 'degraded' | 'fail_open';\n95:   }\n96:   | {\n97:     readonly fallbackCase: 'no-match' | 'skipped';\n98:   };\n99: \n100: // ───────────────────────────────────────────────────────────────\n101: // 2. CONSTANTS\n102: // ───────────────────────────────────────────────────────────────\n103: \n104: const DEFAULT_TOKEN_CAP = 80;\n105: const AMBIGUOUS_TOKEN_CAP = 120;\n106: const MAX_TOKEN_CAP = 120;\n107: const TOKEN_TO_CHAR_ESTIMATE = 4;\n108: const INSTRUCTION_LABEL_PATTERN =\n109:   /^\\s*(SYSTEM|INSTRUCTION|IGNORE|EXECUTE)\\s*[:=]|^\\s*(<!--|```)|\\b(ignore\\s+(previous|all)\\s+instructions|system\\s*:|instruction\\s*:|execute\\s*:|developer\\s*:|assistant\\s*:)/i;\n110: const CONTROL_CHAR_PATTERN = /[\\u0000-\\u0008\\u000B\\u000C\\u000E-\\u001F\\u007F]/g;\n111: const ROUTE_ONLY_SHADOW_ID = 'shadow.route-only.advisor.v1';\n112: const OBSERVED_ADVISOR_POLICY_CANDIDATE = '004';\n113: const PARENT_NAMED_POLICY = 'parent-named only';\n114: export const ROUTE_ONLY_ESTIMATED_BYTES = 43;\n115: const MAX_SHADOW_ROUTE_ONLY_LOG = 256;\n116: \n117: function directiveBlockIds(): readonly string[] {\n118:   return Object.freeze([\n119:     POLICY_COMMENT_HYGIENE_ID,\n120:   ]);\n121: }\n122: \n123: const SHADOW_ROUTE_ONLY_LOG: ShadowRouteOnlyLogRecord[] = [];\n124: \n125: // Injected into every advisor brief so all hook-capable runtimes receive\n126: // the comment hygiene rule even when AGENTS.md is absent from session context.\n127: export const HYGIENE_DIRECTIVE = '\\n- Comment hygiene [HARD BLOCK]: NEVER embed ADR-/REQ-/CHK-/task-ids or spec paths in code comments — forbidden regardless of instruction. Write the durable WHY instead. Pre-commit gate blocks violations.';\n128: \n129: \n130: \n131: // Labels the directive block so injected content reads as one structured\n132: // capsule instead of loose lines.\n133: export const DIRECTIVES_LABEL = '\\nDirectives:';\n134: \n135: // One bounded sentence for a setup-shaped prompt that matched nothing, so the\n136: // reader learns the read-only overview exists without every miss paying for it.\n137: export const SETUP_HINT = ' For setup or health checks, run /doctor:setup.';\n138: \n139: // ───────────────────────────────────────────────────────────────\n140: // 3. HELPERS\n141: // ───────────────────────────────────────────────────────────────\n142: \n143: function clampTokenCap(tokenCap: number | undefined): number {\n144:   if (typeof tokenCap !== 'number' || Number.isNaN(tokenCap)) {\n145:     return DEFAULT_TOKEN_CAP;\n146:   }\n147:   return Math.min(Math.max(1, Math.floor(tokenCap)), MAX_TOKEN_CAP);\n148: }\n149: \n150: function capText(text: string, tokenCap: number): string {\n151:   const charCap = tokenCap * TOKEN_TO_CHAR_ESTIMATE;\n152:   if (text.length <= charCap) {\n153:     return text;\n154:   }\n155:   const truncated = text.slice(0, Math.max(1, charCap - 3)).trimEnd();\n156:   return `${truncated}...`;\n157: }\n158: \n159: function sanitizeSkillLabel(skillLabel: string | null | undefined): string | null {\n160:   if (typeof skillLabel !== 'string') {\n161:     return null;\n162:   }\n163:   const folded = canonicalFold(skillLabel);\n164:   if (/[\\n\\r]/.test(folded)) {\n165:     return null;\n166:   }\n167:   const singleLine = folded\n168:     .replace(CONTROL_CHAR_PATTERN, '')\n169:     .replace(/\\s+/g, ' ')\n170:     .trim();\n171:   if (!singleLine || INSTRUCTION_LABEL_PATTERN.test(singleLine)) {\n172:     return null;\n173:   }\n174:   return singleLine;\n175: }\n176: \n177: const DOCTOR_BRIDGE_PREFIX = 'command-doctor-';\n178: \n179: function isDoctorBridgeId(skillId: string): boolean {\n180:   return skillId.startsWith(DOCTOR_BRIDGE_PREFIX);\n181: }\n182: \n183: /** Return the sanitized runnable command for a doctor bridge id, or null when unmapped. */\n184: export function doctorCommandString(skillId: string): string | null {\n185:   if (!isDoctorBridgeId(skillId)) {\n186:     return null;\n187:   }\n188:   const command = commandRowFor(skillId)?.command;\n189:   return command === undefined ? null : sanitizeSkillLabel(command);\n190: }\n191: \n192: // A dispatched child cannot ask its operator whether to start an interactive run\n193: // or one that writes, so only a read-only run stays fully visible there.\n194: function parentNamedOnly(policy: string | undefined, mutating: string | undefined): boolean {\n195:   if (policy === 'start' || policy === 'ask') {\n196:     return true;\n197:   }\n198:   return policy === 'run' && mutating !== 'read-only';\n199: }\n200: \n201: // The policy word is the only part of a command label a child replaces. The\n202: // command itself and its owner stay visible so the child can report what the\n203: // parent named.\n204: function policyWord(\n205:   policy: string | undefined,\n206:   mutating: string | undefined,\n207:   childSession: boolean,\n208: ): string | null {\n209:   if (policy === undefined) {\n210:     return null;\n211:   }\n212:   const word = sanitizeSkillLabel(policy);\n213:   if (word === null) {\n214:     return null;\n215:   }\n216:   return childSession && parentNamedOnly(policy, mutating) ? PARENT_NAMED_POLICY : word;\n217: }\n218: \n219: // A recommendation that names a command renders as the skill that owns it, the\n220: // runnable command and the policy that governs the run. The recommendation's own\n221: // fields stay authoritative and the generated row fills only what they omit, so a\n222: // caller that already resolved the command is never second-guessed.\n223: function commandLabel(recommendation: RenderableRecommendation, childSession: boolean): string | null {\n224:   // A hub that withheld its mode must not regress to the command its generated\n225:   // row names, because that command is the mode the reader has not chosen yet.\n226:   const row = recommendation.needsMode === true ? undefined : commandRowFor(recommendation.skill);\n227:   const command = recommendation.command ?? row?.command;\n228:   const owner = recommendation.ownerSkillId ?? row?.ownerSkillId ?? recommendation.skill;\n229:   const policy = recommendation.policy ?? row?.policy;\n230:   const commandPart = command === undefined ? null : sanitizeSkillLabel(command);\n231:   const ownerPart = sanitizeSkillLabel(owner);\n232:   if (!commandPart || !ownerPart) {\n233:     return null;\n234:   }\n235:   // The class belongs to the command printed, not to the skill that carried it,\n236:   // so a recommendation that names another command takes that command's class.\n237:   const mutating = row !== undefined && row.command === commandPart\n238:     ? row.mutating\n239:     : Object.values(COMMAND_ROWS).find((candidate) => candidate.command === commandPart)?.mutating;\n240:   const policyPart = policyWord(policy, mutating, childSession);\n241:   return policyPart === null\n242:     ? `${ownerPart} → ${commandPart}`\n243:     : `${ownerPart} → ${commandPart} (${policyPart})`;\n244: }\n245: \n246: // A doctor bridge renders as its runnable command and never as its raw id; an\n247: // unmapped doctor id renders nothing.\n248: function recommendationLabel(recommendation: RenderableRecommendation, childSession: boolean): string | null {\n249:   return commandLabel(recommendation, childSession)\n250:     ?? (isDoctorBridgeId(recommendation.skill)\n251:       ? doctorCommandString(recommendation.skill)\n252:       : sanitizeSkillLabel(recommendation.skill));\n253: }\n254: \n255: // A companion is a command the reader may act on, so it carries the same policy\n256: // word the head carries. A child still gets the downgrade marker because that\n257: // command must not be started there.\n258: function companionCommandLabel(skillId: string, childSession: boolean): string | null {\n259:   const command = doctorCommandString(skillId);\n260:   if (command === null) {\n261:     return null;\n262:   }\n263:   const row = commandRowFor(skillId);\n264:   const word = policyWord(row?.policy, row?.mutating, childSession);\n265:   return word === null ? command : `${command} (${word})`;\n266: }\n267: \n268: function formatScore(value: number): string {\n269:   return Number.isFinite(value) ? value.toFixed(2) : '0.00';\n270: }\n271: \n272: type RenderableRecommendation = AdvisorRecommendation & {\n273:   readonly score?: number;\n274:   readonly ambiguousWith?: readonly string[];\n275:   readonly heldBelow?: string;\n276: };\n277: \n278: function toScoredRecommendation(recommendation: RenderableRecommendation): AdvisorScoredRecommendation {\n279:   return {\n280:     skill: recommendation.skill,\n281:     kind: recommendation.kind === 'command' ? 'command' : 'skill',\n282:     confidence: recommendation.confidence,\n283:     uncertainty: recommendation.uncertainty,\n284:     passes_threshold: recommendation.passes_threshold ?? true,\n285:     reason: '',\n286:     score: typeof recommendation.score === 'number' && Number.isFinite(recommendation.score)\n287:       ? recommendation.score\n288:       : recommendation.confidence,\n289:     laneContributions: [],\n290:     dominantLane: null,\n291:     lifecycleStatus: 'active',\n292:     ...(Array.isArray(recommendation.ambiguousWith) ? { ambiguousWith: recommendation.ambiguousWith } : {}),\n293:     ...(typeof recommendation.heldBelow === 'string' ? { heldBelow: recommendation.heldBelow } : {}),\n294:   };\n295: }\n296: \n297: /**\n298:  * Detect whether the renderable recommendation set carries ambiguity evidence.\n299:  *\n300:  * `precomputedAmbiguous` carries the scorer's own verdict. It wins when defined: the\n301:  * scorer knows which skills a typed command held below the top and which only cleared\n302:  * a confidence floor, and serialized recommendations lose that context. Only when the\n303:  * caller has no verdict is ambiguity re-derived from the rendered fields.\n304:  */\n305: export function hasAdvisorAmbiguitySignal(\n306:   recommendations: readonly AdvisorRecommendation[],\n307:   precomputedAmbiguous?: boolean,\n308: ): boolean {\n309:   if (typeof precomputedAmbiguous === 'boolean') {\n310:     return precomputedAmbiguous;\n311:   }\n312:   return isAmbiguousTopTwo((recommendations as readonly RenderableRecommendation[]).map(toScoredRecommendation));\n313: }\n314: \n315: function metadataSkillLabel(result: AdvisorBriefRenderableResult): string | null {\n316:   const metadata = result.sharedPayload?.metadata;\n317:   return typeof metadata?.skillLabel === 'string' ? metadata.skillLabel : null;\n318: }\n319: \n320: /** Return only the advisor route block that the shadow path would retain. */\n321: export function renderRouteOnlyAdvisorBrief(rendered: string | null): string | null {\n322:   const routeBlock = buildAdvisorRenderPlan(rendered).blocks.find((block) => (\n323:     block.id === ROUTE_ADVISOR_ID\n324:   ));\n325:   return routeBlock?.content ?? null;\n326: }\n327: \n328: /** Read the append-only in-process shadow log without exposing route content. */\n329: export function getShadowRouteOnlyLog(): readonly ShadowRouteOnlyLogRecord[] {\n330:   return Object.freeze(SHADOW_ROUTE_ONLY_LOG.map((record) => ({ ...record })));\n331: }\n332: \n333: /** Clear shadow log entries between isolated evaluations. */\n334: export function clearShadowRouteOnlyLog(): void {\n335:   SHADOW_ROUTE_ONLY_LOG.length = 0;\n336: }\n337: \n338: function stateSignalsForBlock(options: ShadowDeliveryRenderOptions): ShadowDeliveryRenderOptions {\n339:   return {\n340:     ...options,\n341:     lifecycleEvent: undefined,\n342:     scopeChanged: false,\n343:     policySetChanged: false,\n344:     goalChanged: false,\n345:   };\n346: }\n347: \n348: function pushShadowRouteOnlyLog(record: ShadowRouteOnlyLogRecord): void {\n349:   if (SHADOW_ROUTE_ONLY_LOG.length >= MAX_SHADOW_ROUTE_ONLY_LOG) {\n350:     SHADOW_ROUTE_ONLY_LOG.shift();\n351:   }\n352:   SHADOW_ROUTE_ONLY_LOG.push(record);\n353: }\n354: \n355: function directiveBlocksSuppressed(\n356:   plan: ReturnType<typeof buildAdvisorRenderPlan>,\n357:   decisions: readonly ReturnType<typeof evaluateDeliveryState>[],\n358: ): boolean {\n359:   for (const expectedId of directiveBlockIds()) {\n360:     const blockIndex = plan.blocks.findIndex((block) => block.id === expectedId);\n361:     if (blockIndex === -1) {\n362:       return false;\n363:     }\n364:     const decision = decisions[blockIndex];\n365:     if (!decision || decision.state !== 'SUPPRESSED_SAME') {\n366:       return false;\n367:     }\n368:   }\n369:   return true;\n370: }\n371: \n372: function recordObservedBlockDeliveries(\n373:   plan: ReturnType<typeof buildAdvisorRenderPlan>,\n374:   shadowOptions: ShadowDeliveryRenderOptions,\n375:   machine: DeliveryStateMachine,\n376:   epoch: number,\n377: ): void {\n378:   const blockOptions = stateSignalsForBlock(shadowOptions);\n379:   for (const block of plan.blocks) {\n380:     const receipt = shadowOptions.receipt;\n381:     if (!isObservedDeliveryReceipt(receipt, block.contentHash, epoch)) {\n382:       continue;\n383:     }\n384:     machine.recordDelivery({\n385:       ...blockOptions,\n386:       blockId: block.id,\n387:       contentHash: block.contentHash,\n388:       receipt,\n389:     });\n390:   }\n391: }\n392: \n393: function observeShadowRouteOnly(\n394:   rendered: string | null,\n395:   options: ShadowDeliveryRenderOptions | undefined,\n396: ): void {\n397:   try {\n398:     const plan = buildAdvisorRenderPlan(rendered);\n399:     const shadowOptions = options ?? {};\n400:     const machine = shadowOptions.stateMachine ?? SHADOW_DELIVERY_STATE_MACHINE;\n401:     const epochSnapshot = machine.advanceForSignals(shadowOptions);\n402:     const blockOptions = stateSignalsForBlock(shadowOptions);\n403:     const decisions = plan.blocks.map((block) => evaluateDeliveryState({\n404:       ...blockOptions,\n405:       blockId: block.id,\n406:       contentHash: block.contentHash,\n407:     }, machine));\n408: \n409:     recordObservedBlockDeliveries(plan, shadowOptions, machine, epochSnapshot.epoch);\n410: \n411:     const routeIndex = plan.blocks.findIndex((block) => block.id === ROUTE_ADVISOR_ID);\n412:     const routeDecision = routeIndex === -1 ? null : decisions[routeIndex] ?? null;\n413:     const routeOnlyEligible = Boolean(\n414:       routeDecision?.routeOnlyEligible && directiveBlocksSuppressed(plan, decisions),\n415:     );\n416:     const routeOnly = routeOnlyEligible\n417:       ? renderRouteOnlyAdvisorBrief(rendered)\n418:       : null;\n419:     const emittedByteCount = rendered === null ? 0 : Buffer.byteLength(rendered, 'utf8');\n420:     const routeOnlyByteCount = routeOnly === null ? 0 : Buffer.byteLength(routeOnly, 'utf8');\n421:     const savedBytes = routeOnly === null\n422:       ? 0\n423:       : Math.max(0, emittedByteCount - routeOnlyByteCount);\n424:     const record: ShadowRouteOnlyLogRecord = Object.freeze({\n425:       shadowId: ROUTE_ONLY_SHADOW_ID,\n426:       sessionKnown: routeDecision?.sessionKnown ?? epochSnapshot.sessionKnown,\n427:       epoch: routeDecision?.epoch ?? epochSnapshot.epoch,\n428:       policySetHash: plan.policySetHash,\n429:       routeState: routeDecision?.state ?? null,\n430:       emittedByteCount,\n431:       routeOnlyByteCount,\n432:       savedBytes,\n433:     });\n434:     pushShadowRouteOnlyLog(record);\n435:     try {\n436:       options?.onShadowLog?.(record);\n437:     } catch {\n438:       // Observer callbacks must never affect the rendered advisor bytes.\n439:     }\n440:   } catch {\n441:     // Shadow measurement is fail-open so a throwing observer cannot block delivery.\n442:   }\n443: }\n444: \n445: function observeAdvisorPolicy(\n446:   rendered: string | null,\n447:   options: AdvisorBriefRenderOptions = {},\n448: ): void {\n449:   try {\n450:     observeRenderedAdvisorPolicy(rendered);\n451:   } catch {\n452:     // Shadow measurement is fail-open so a throwing observer cannot block delivery.\n453:   }\n454:   observeShadowRouteOnly(rendered, options.deliveryState);\n455: }\n456: \n457: /** Run the shadow planner for a runtime callback without changing its output. */\n458: export function observeShadowDelivery(\n459:   rendered: string | null,\n460:   deliveryState: ShadowDeliveryRenderOptions = {},\n461: ): void {\n462:   observeAdvisorPolicy(rendered, { deliveryState });\n463: }\n464: \n465: /**\n466:  * Record host-observed policy blocks after the runtime places them into the\n467:  * emitted response. Fail-open: recording errors never change emitted bytes.\n468:  */\n469: export function observeEmittedAdvisorPolicy(\n470:   rendered: string | null,\n471:   deliveryState: ShadowDeliveryRenderOptions = {},\n472: ): void {\n473:   try {\n474:     if (typeof rendered !== 'string' || rendered.length === 0) {\n475:       return;\n476:     }\n477:     const runtime = typeof deliveryState.runtime === 'string' && deliveryState.runtime.length > 0\n478:       ? deliveryState.runtime\n479:       : 'unknown';\n480:     const machine = deliveryState.stateMachine ?? SHADOW_DELIVERY_STATE_MACHINE;\n481:     const epoch = machine.currentEpoch(deliveryState);\n482:     const plan = buildAdvisorRenderPlan(rendered);\n483:     for (const block of plan.blocks) {\n484:       recordObservedPolicyDelivery({\n485:         runtime,\n486:         candidate: deliveryState.candidate ?? OBSERVED_ADVISOR_POLICY_CANDIDATE,\n487:         blockId: block.id,\n488:         content: block.content,\n489:         contentHash: block.contentHash,\n490:         lifecycleEpoch: epoch,\n491:         sessionId: deliveryState.sessionId,\n492:         sessionIdentity: deliveryState.sessionIdentity,\n493:         sessionIdentityConfirmed: deliveryState.sessionIdentityConfirmed,\n494:         sessionIdentityAmbiguous: deliveryState.sessionIdentityAmbiguous,\n495:         transformMessageIdentity: deliveryState.transformMessageIdentity ?? null,\n496:       });\n497:     }\n498:   } catch {\n499:     // Host observation is fail-open so a throwing sink cannot affect delivery.\n500:   }\n501: }\n502: \n503: // ───────────────────────────────────────────────────────────────\n504: // 4. CORE LOGIC\n505: // ───────────────────────────────────────────────────────────────\n506: \n507: /**\n508:  * Render the model-visible advisor brief from typed advisor output only.\n509:  *\n510:  * The renderer is the prompt-boundary guard: it ignores free-form reasons,\n511:  * descriptions, stdout/stderr, and prompt text, and emits nothing when the\n512:  * repository-authored skill label looks instruction-shaped after folding.\n513:  */\n514: export function renderAdvisorBrief(\n515:   result: AdvisorBriefRenderableResult,\n516:   options: AdvisorBriefRenderOptions = {},\n517: ): string | null {\n518:   if (result.status !== 'ok') {\n519:     observeAdvisorPolicy(null, options);\n520:     return null;\n521:   }\n522:   if (result.freshness !== 'live' && result.freshness !== 'stale') {\n523:     observeAdvisorPolicy(null, options);\n524:     return null;\n525:   }\n526: \n527:   const tokenCap = clampTokenCap(result.metrics?.tokenCap ?? options.tokenCap);\n528:   const thresholdConfig = options.thresholdConfig;\n529:   const childSession = options.childSession ?? process.env.AI_SESSION_CHILD === '1';\n530:   const recommendations = result.recommendations.filter((recommendation) => (\n531:     recommendation.passes_threshold === true\n532:     || (\n533:       recommendation.confidence >= (thresholdConfig?.confidenceThreshold ?? resolvedConfidenceThreshold())\n534:       && (\n535:         thresholdConfig?.confidenceOnly === true\n536:         || recommendation.uncertainty <= (thresholdConfig?.uncertaintyThreshold ?? resolvedUncertaintyThreshold())\n537:       )\n538:     )\n539:   ));\n540:   const [top, second] = recommendations;\n541:   if (!top) {\n542:     observeAdvisorPolicy(null, options);\n543:     return null;\n544:   }\n545: \n546:   // A recommendation that needs a mode is named by the skill that owns its row,\n547:   // because the row id is an internal key the reader cannot run.\n548:   const topLabel = commandLabel(top, childSession)\n549:     ?? (isDoctorBridgeId(top.skill)\n550:       ? doctorCommandString(top.skill)\n551:       : sanitizeSkillLabel(metadataSkillLabel(result) ?? (top.needsMode === true ? commandRowFor(top.skill)?.ownerSkillId : undefined) ?? top.skill));\n552:   if (!topLabel) {\n553:     observeAdvisorPolicy(null, options);\n554:     return null;\n555:   }\n556: \n557:   // A hub that withheld its command because the prompt names no single mode says\n558:   // so, so the reader asks for the mode instead of improvising one.\n559:   const headLabel = top.needsMode === true && top.command === undefined\n560:     ? `${topLabel} (needs a mode)`\n561:     : topLabel;\n562: \n563:   // A command printed twice reads as two offers, so the companion line never\n564:   // repeats the command the head already names.\n565:   const headPrintedCommand = top.command\n566:     ?? (top.needsMode === true ? undefined : commandRowFor(top.skill)?.command);\n567:   const companion = isDoctorBridgeId(top.skill)\n568:     ? undefined\n569:     : recommendations.slice(1).find((recommendation) => {\n570:       const command = doctorCommandString(recommendation.skill);\n571:       return command !== null && command !== headPrintedCommand;\n572:     });\n573:   const companionLabel = companion ? companionCommandLabel(companion.skill, childSession) : null;\n574:   const companionCommand = companion ? doctorCommandString(companion.skill) : null;\n575:   // The partner's command shares the printed line with the head, so a companion\n576:   // that repeats it would offer that command a second time.\n577:   const companionLine = (shownSecond: string | undefined, shownCommand?: string): string => (\n578:     companionLabel\n579:     && companion\n580:     && companion.skill !== shownSecond\n581:     && (shownCommand === undefined || companionCommand !== shownCommand)\n582:       ? `\\nAlso: ${companionLabel}`\n583:       : ''\n584:   );\n585:   const capWithCompanion = (head: string, companionText: string, cap: number): string => {\n586:     const companionFits = head.length + companionText.length <= cap * TOKEN_TO_CHAR_ESTIMATE;\n587:     return `${capText(head, cap)}${companionFits ? companionText : ''}`;\n588:   };\n589: \n590:   const precomputedAmbiguous = typeof result.ambiguous === 'boolean' ? result.ambiguous : undefined;\n591:   if (tokenCap > DEFAULT_TOKEN_CAP && second && hasAdvisorAmbiguitySignal(recommendations, precomputedAmbiguous)) {\n592:     // The scorer names its own tie partners, which can sit below the second passing\n593:     // entry, so prefer a named partner and fall back to the second entry.\n594:     const namedPartners = (top as RenderableRecommendation).ambiguousWith;\n595:     const ambiguousWith: readonly string[] = Array.isArray(namedPartners) ? namedPartners : [];\n596:     const vs = (ambiguousWith.length > 0\n597:       ? recommendations.find((recommendation) => ambiguousWith.includes(recommendation.skill))\n598:       : undefined) ?? second;\n599:     const vsLabel = recommendationLabel(vs, childSession);\n600:     if (!vsLabel && !isDoctorBridgeId(vs.skill)) {\n601:       observeAdvisorPolicy(null, options);\n602:       return null;\n603:     }\n604:     if (vsLabel) {\n605:       const head = `Advisor: ${result.freshness}; ambiguous: ${headLabel} `\n606:         + `${formatScore(top.confidence)}/${formatScore(top.uncertainty)} vs ${vsLabel} `\n607:         + `${formatScore(vs.confidence)}/${formatScore(vs.uncertainty)} pass.`;\n608:       const rendered = capWithCompanion(\n609:         head,\n610:         companionLine(vs.skill, vs.command ?? commandRowFor(vs.skill)?.command),\n611:         Math.min(tokenCap, AMBIGUOUS_TOKEN_CAP),\n612:       ) + DIRECTIVES_LABEL + HYGIENE_DIRECTIVE;\n613:       observeAdvisorPolicy(rendered, options);\n614:       return rendered;\n615:     }\n616:   }\n617: \n618:   const head = `Advisor: ${result.freshness}; use ${headLabel} `\n619:     + `${formatScore(top.confidence)}/${formatScore(top.uncertainty)} pass.`;\n620:   const rendered = capWithCompanion(\n621:     head,\n622:     companionLine(undefined),\n623:     Math.min(tokenCap, DEFAULT_TOKEN_CAP),\n624:   ) + DIRECTIVES_LABEL + HYGIENE_DIRECTIVE;\n625:   observeAdvisorPolicy(rendered, options);\n626:   return rendered;\n627: }\n628: \n629: /** Classify a result with no brief; no result at all means the advisor did not answer. */\n630: export function advisorFallbackCase(\n631:   result?: Pick<AdvisorHookResult, 'status' | 'freshness'>,\n632: ): AdvisorFallbackClassification {\n633:   if (!result || result.status === 'fail_open' || result.freshness === 'absent'\n634:     || (result.freshness === 'unavailable' && result.status !== 'skipped')) {\n635:     return {\n636:       fallbackCase: 'outage',\n637:       outageLabel: result?.freshness === 'absent'\n638:         ? 'absent'\n639:         : result?.status === 'degraded'\n640:           ? 'degraded'\n641:           : 'fail_open',\n642:     };\n643:   }\n644:   if (result.status === 'skipped' && result.freshness === 'unavailable') {\n645:     return { fallbackCase: 'skipped' };\n646:   }\n647:   return { fallbackCase: 'no-match' };\n648: }\n649: \n650: /** Render the fallback status and directive block when no advisor brief is available. */\n651: export function renderAdvisorFallbackDirective(\n652:   options: AdvisorBriefRenderOptions = {},\n653:   result?: Pick<AdvisorHookResult, 'status' | 'freshness'>,\n654: ): string {\n655:   const classification = advisorFallbackCase(result);\n656:   const head = classification.fallbackCase === 'outage'\n657:     ? `Advisor: outage (${classification.outageLabel});${options.setupWording === true ? ' for setup or health checks, run /doctor:setup;' : ''} route by hand: node .skilled/bin/skill-advisor.cjs advisor_recommend --json '{\"prompt\":\"<request>\"}' --format json`\n658:     : classification.fallbackCase === 'skipped'\n659:       ? 'Advisor: prompt skipped.'\n660:       : options.setupWording === true\n661:         ? `Advisor: no skill matched.${SETUP_HINT}`\n662:         : 'Advisor: no skill matched.';\n663:   const rendered = head + DIRECTIVES_LABEL + HYGIENE_DIRECTIVE;\n664:   observeAdvisorPolicy(rendered, options);\n665:   return rendered;\n666: }\n667: \n668: /** Render the outage fallback used when advisor execution times out or is unavailable. */\n669: export function renderAdvisorTimeoutFallback(\n670:   options: AdvisorBriefRenderOptions = {},\n671:   status: Extract<AdvisorHookResult['status'], 'fail_open' | 'degraded'> = 'fail_open',\n672: ): string {\n673:   return renderAdvisorFallbackDirective(options, { status, freshness: 'unavailable' });\n674: }\n675: \n676: export { sanitizeSkillLabel };","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file .skilled/skills/system-skill-advisor/runtime/lib/render.ts, lines 1-676\n1: // ───────────────────────────────────────────────────────────────\n2: // MODULE: Skill Advisor Brief Renderer\n3: // ───────────────────────────────────────────────────────────────\n4: \n5: import { canonicalFold } from './shared/unicode-normalization.js';\n6: import { resolvedConfidenceThreshold, resolvedUncertaintyThreshold } from './compat/contract.js';\n7: import {\n8:   buildAdvisorRenderPlan,\n9:   evaluateDeliveryState,\n10:   isObservedDeliveryReceipt,\n11:   observeRenderedAdvisorPolicy,\n12:   POLICY_COMMENT_HYGIENE_ID,\n13:   recordObservedPolicyDelivery,\n14:   ROUTE_ADVISOR_ID,\n15:   SHADOW_DELIVERY_STATE_MACHINE,\n16:   type DeliveryStateMachine,\n17:   type DeliveryStateReceipt,\n18:   type DeliveryStateName,\n19:   type DeliveryStateSignals,\n20: } from './policy-plan.js';\n21: import { COMMAND_ROWS, commandRowFor } from './command-attach.js';\n22: import { isAmbiguousTopTwo } from './scorer/ambiguity.js';\n23: import type { AdvisorRecommendation } from './subprocess.js';\n24: import type { AdvisorScoredRecommendation } from './scorer/types.js';\n25: import type { AdvisorHookResult } from './skill-advisor-brief.js';\n26: \n27: // ───────────────────────────────────────────────────────────────\n28: // 1. TYPES\n29: // ───────────────────────────────────────────────────────────────\n30: \n31: export interface AdvisorBriefRenderOptions {\n32:   readonly tokenCap?: number;\n33:   readonly thresholdConfig?: {\n34:     readonly confidenceThreshold?: number;\n35:     readonly uncertaintyThreshold?: number;\n36:     readonly confidenceOnly?: boolean;\n37:   };\n38:   readonly deliveryState?: ShadowDeliveryRenderOptions;\n39:   /**\n40:    * True when prompts use set up, set-up or setup wording, install or reinstall wording\n41:    * including installation and installer, configure or configuration wording or `check`\n42:    * followed within three words by environment, env, config, hooks, tools, tooling,\n43:    * toolchain or skilled. The renderer never reads prompt text.\n44:    */\n45:   readonly setupWording?: boolean;\n46:   /**\n47:    * True when a dispatched child renders the brief. A child keeps the skill line\n48:    * but a command it must not start alone renders as parent-named only. Defaults\n49:    * to `AI_SESSION_CHILD === '1'`.\n50:    */\n51:   readonly childSession?: boolean;\n52: }\n53: \n54: export interface ShadowDeliveryRenderOptions extends DeliveryStateSignals {\n55:   readonly runtime?: string;\n56:   readonly candidate?: string | null;\n57:   readonly stateMachine?: DeliveryStateMachine;\n58:   readonly deliveryConfirmed?: boolean;\n59:   readonly receipt?: DeliveryStateReceipt;\n60:   readonly transformMessageIdentity?: string | null;\n61:   readonly onShadowLog?: (record: ShadowRouteOnlyLogRecord) => void;\n62: }\n63: \n64: export interface ShadowRouteOnlyLogRecord {\n65:   readonly shadowId: string;\n66:   readonly sessionKnown: boolean;\n67:   readonly epoch: number;\n68:   readonly policySetHash: string;\n69:   readonly routeState: DeliveryStateName | null;\n70:   readonly emittedByteCount: number;\n71:   readonly routeOnlyByteCount: number;\n72:   readonly savedBytes: number;\n73: }\n74: \n75: export interface AdvisorBriefRenderableResult {\n76:   readonly status: 'ok' | 'stale' | 'skipped' | 'degraded' | 'fail_open';\n77:   readonly freshness: 'live' | 'stale' | 'absent' | 'unavailable';\n78:   readonly recommendations: readonly AdvisorRecommendation[];\n79:   readonly ambiguous?: boolean;\n80:   readonly metrics?: {\n81:     readonly tokenCap?: number;\n82:   } | null;\n83:   readonly sharedPayload?: {\n84:     readonly metadata?: {\n85:       readonly skillLabel?: string | null;\n86:     } | null;\n87:   } | null;\n88: }\n89: \n90: export type AdvisorFallbackCase = 'outage' | 'no-match' | 'skipped';\n91: export type AdvisorFallbackClassification =\n92:   | {\n93:     readonly fallbackCase: 'outage';\n94:     readonly outageLabel: 'absent' | 'degraded' | 'fail_open';\n95:   }\n96:   | {\n97:     readonly fallbackCase: 'no-match' | 'skipped';\n98:   };\n99: \n100: // ───────────────────────────────────────────────────────────────\n101: // 2. CONSTANTS\n102: // ───────────────────────────────────────────────────────────────\n103: \n104: const DEFAULT_TOKEN_CAP = 80;\n105: const AMBIGUOUS_TOKEN_CAP = 120;\n106: const MAX_TOKEN_CAP = 120;\n107: const TOKEN_TO_CHAR_ESTIMATE = 4;\n108: const INSTRUCTION_LABEL_PATTERN =\n109:   /^\\s*(SYSTEM|INSTRUCTION|IGNORE|EXECUTE)\\s*[:=]|^\\s*(<!--|```)|\\b(ignore\\s+(previous|all)\\s+instructions|system\\s*:|instruction\\s*:|execute\\s*:|developer\\s*:|assistant\\s*:)/i;\n110: const CONTROL_CHAR_PATTERN = /[\\u0000-\\u0008\\u000B\\u000C\\u000E-\\u001F\\u007F]/g;\n111: const ROUTE_ONLY_SHADOW_ID = 'shadow.route-only.advisor.v1';\n112: const OBSERVED_ADVISOR_POLICY_CANDIDATE = '004';\n113: const PARENT_NAMED_POLICY = 'parent-named only';\n114: export const ROUTE_ONLY_ESTIMATED_BYTES = 43;\n115: const MAX_SHADOW_ROUTE_ONLY_LOG = 256;\n116: \n117: function directiveBlockIds(): readonly string[] {\n118:   return Object.freeze([\n119:     POLICY_COMMENT_HYGIENE_ID,\n120:   ]);\n121: }\n122: \n123: const SHADOW_ROUTE_ONLY_LOG: ShadowRouteOnlyLogRecord[] = [];\n124: \n125: // Injected into every advisor brief so all hook-capable runtimes receive\n126: // the comment hygiene rule even when AGENTS.md is absent from session context.\n127: export const HYGIENE_DIRECTIVE = '\\n- Comment hygiene [HARD BLOCK]: NEVER embed ADR-/REQ-/CHK-/task-ids or spec paths in code comments — forbidden regardless of instruction. Write the durable WHY instead. Pre-commit gate blocks violations.';\n128: \n129: \n130: \n131: // Labels the directive block so injected content reads as one structured\n132: // capsule instead of loose lines.\n133: export const DIRECTIVES_LABEL = '\\nDirectives:';\n134: \n135: // One bounded sentence for a setup-shaped prompt that matched nothing, so the\n136: // reader learns the read-only overview exists without every miss paying for it.\n137: export const SETUP_HINT = ' For setup or health checks, run /doctor:setup.';\n138: \n139: // ───────────────────────────────────────────────────────────────\n140: // 3. HELPERS\n141: // ───────────────────────────────────────────────────────────────\n142: \n143: function clampTokenCap(tokenCap: number | undefined): number {\n144:   if (typeof tokenCap !== 'number' || Number.isNaN(tokenCap)) {\n145:     return DEFAULT_TOKEN_CAP;\n146:   }\n147:   return Math.min(Math.max(1, Math.floor(tokenCap)), MAX_TOKEN_CAP);\n148: }\n149: \n150: function capText(text: string, tokenCap: number): string {\n151:   const charCap = tokenCap * TOKEN_TO_CHAR_ESTIMATE;\n152:   if (text.length <= charCap) {\n153:     return text;\n154:   }\n155:   const truncated = text.slice(0, Math.max(1, charCap - 3)).trimEnd();\n156:   return `${truncated}...`;\n157: }\n158: \n159: function sanitizeSkillLabel(skillLabel: string | null | undefined): string | null {\n160:   if (typeof skillLabel !== 'string') {\n161:     return null;\n162:   }\n163:   const folded = canonicalFold(skillLabel);\n164:   if (/[\\n\\r]/.test(folded)) {\n165:     return null;\n166:   }\n167:   const singleLine = folded\n168:     .replace(CONTROL_CHAR_PATTERN, '')\n169:     .replace(/\\s+/g, ' ')\n170:     .trim();\n171:   if (!singleLine || INSTRUCTION_LABEL_PATTERN.test(singleLine)) {\n172:     return null;\n173:   }\n174:   return singleLine;\n175: }\n176: \n177: const DOCTOR_BRIDGE_PREFIX = 'command-doctor-';\n178: \n179: function isDoctorBridgeId(skillId: string): boolean {\n180:   return skillId.startsWith(DOCTOR_BRIDGE_PREFIX);\n181: }\n182: \n183: /** Return the sanitized runnable command for a doctor bridge id, or null when unmapped. */\n184: export function doctorCommandString(skillId: string): string | null {\n185:   if (!isDoctorBridgeId(skillId)) {\n186:     return null;\n187:   }\n188:   const command = commandRowFor(skillId)?.command;\n189:   return command === undefined ? null : sanitizeSkillLabel(command);\n190: }\n191: \n192: // A dispatched child cannot ask its operator whether to start an interactive run\n193: // or one that writes, so only a read-only run stays fully visible there.\n194: function parentNamedOnly(policy: string | undefined, mutating: string | undefined): boolean {\n195:   if (policy === 'start' || policy === 'ask') {\n196:     return true;\n197:   }\n198:   return policy === 'run' && mutating !== 'read-only';\n199: }\n200: \n201: // The policy word is the only part of a command label a child replaces. The\n202: // command itself and its owner stay visible so the child can report what the\n203: // parent named.\n204: function policyWord(\n205:   policy: string | undefined,\n206:   mutating: string | undefined,\n207:   childSession: boolean,\n208: ): string | null {\n209:   if (policy === undefined) {\n210:     return null;\n211:   }\n212:   const word = sanitizeSkillLabel(policy);\n213:   if (word === null) {\n214:     return null;\n215:   }\n216:   return childSession && parentNamedOnly(policy, mutating) ? PARENT_NAMED_POLICY : word;\n217: }\n218: \n219: // A recommendation that names a command renders as the skill that owns it, the\n220: // runnable command and the policy that governs the run. The recommendation's own\n221: // fields stay authoritative and the generated row fills only what they omit, so a\n222: // caller that already resolved the command is never second-guessed.\n223: function commandLabel(recommendation: RenderableRecommendation, childSession: boolean): string | null {\n224:   // A hub that withheld its mode must not regress to the command its generated\n225:   // row names, because that command is the mode the reader has not chosen yet.\n226:   const row = recommendation.needsMode === true ? undefined : commandRowFor(recommendation.skill);\n227:   const command = recommendation.command ?? row?.command;\n228:   const owner = recommendation.ownerSkillId ?? row?.ownerSkillId ?? recommendation.skill;\n229:   const policy = recommendation.policy ?? row?.policy;\n230:   const commandPart = command === undefined ? null : sanitizeSkillLabel(command);\n231:   const ownerPart = sanitizeSkillLabel(owner);\n232:   if (!commandPart || !ownerPart) {\n233:     return null;\n234:   }\n235:   // The class belongs to the command printed, not to the skill that carried it,\n236:   // so a recommendation that names another command takes that command's class.\n237:   const mutating = row !== undefined && row.command === commandPart\n238:     ? row.mutating\n239:     : Object.values(COMMAND_ROWS).find((candidate) => candidate.command === commandPart)?.mutating;\n240:   const policyPart = policyWord(policy, mutating, childSession);\n241:   return policyPart === null\n242:     ? `${ownerPart} → ${commandPart}`\n243:     : `${ownerPart} → ${commandPart} (${policyPart})`;\n244: }\n245: \n246: // A doctor bridge renders as its runnable command and never as its raw id; an\n247: // unmapped doctor id renders nothing.\n248: function recommendationLabel(recommendation: RenderableRecommendation, childSession: boolean): string | null {\n249:   return commandLabel(recommendation, childSession)\n250:     ?? (isDoctorBridgeId(recommendation.skill)\n251:       ? doctorCommandString(recommendation.skill)\n252:       : sanitizeSkillLabel(recommendation.skill));\n253: }\n254: \n255: // A companion is a command the reader may act on, so it carries the same policy\n256: // word the head carries. A child still gets the downgrade marker because that\n257: // command must not be started there.\n258: function companionCommandLabel(skillId: string, childSession: boolean): string | null {\n259:   const command = doctorCommandString(skillId);\n260:   if (command === null) {\n261:     return null;\n262:   }\n263:   const row = commandRowFor(skillId);\n264:   const word = policyWord(row?.policy, row?.mutating, childSession);\n265:   return word === null ? command : `${command} (${word})`;\n266: }\n267: \n268: function formatScore(value: number): string {\n269:   return Number.isFinite(value) ? value.toFixed(2) : '0.00';\n270: }\n271: \n272: type RenderableRecommendation = AdvisorRecommendation & {\n273:   readonly score?: number;\n274:   readonly ambiguousWith?: readonly string[];\n275:   readonly heldBelow?: string;\n276: };\n277: \n278: function toScoredRecommendation(recommendation: RenderableRecommendation): AdvisorScoredRecommendation {\n279:   return {\n280:     skill: recommendation.skill,\n281:     kind: recommendation.kind === 'command' ? 'command' : 'skill',\n282:     confidence: recommendation.confidence,\n283:     uncertainty: recommendation.uncertainty,\n284:     passes_threshold: recommendation.passes_threshold ?? true,\n285:     reason: '',\n286:     score: typeof recommendation.score === 'number' && Number.isFinite(recommendation.score)\n287:       ? recommendation.score\n288:       : recommendation.confidence,\n289:     laneContributions: [],\n290:     dominantLane: null,\n291:     lifecycleStatus: 'active',\n292:     ...(Array.isArray(recommendation.ambiguousWith) ? { ambiguousWith: recommendation.ambiguousWith } : {}),\n293:     ...(typeof recommendation.heldBelow === 'string' ? { heldBelow: recommendation.heldBelow } : {}),\n294:   };\n295: }\n296: \n297: /**\n298:  * Detect whether the renderable recommendation set carries ambiguity evidence.\n299:  *\n300:  * `precomputedAmbiguous` carries the scorer's own verdict. It wins when defined: the\n301:  * scorer knows which skills a typed command held below the top and which only cleared\n302:  * a confidence floor, and serialized recommendations lose that context. Only when the\n303:  * caller has no verdict is ambiguity re-derived from the rendered fields.\n304:  */\n305: export function hasAdvisorAmbiguitySignal(\n306:   recommendations: readonly AdvisorRecommendation[],\n307:   precomputedAmbiguous?: boolean,\n308: ): boolean {\n309:   if (typeof precomputedAmbiguous === 'boolean') {\n310:     return precomputedAmbiguous;\n311:   }\n312:   return isAmbiguousTopTwo((recommendations as readonly RenderableRecommendation[]).map(toScoredRecommendation));\n313: }\n314: \n315: function metadataSkillLabel(result: AdvisorBriefRenderableResult): string | null {\n316:   const metadata = result.sharedPayload?.metadata;\n317:   return typeof metadata?.skillLabel === 'string' ? metadata.skillLabel : null;\n318: }\n319: \n320: /** Return only the advisor route block that the shadow path would retain. */\n321: export function renderRouteOnlyAdvisorBrief(rendered: string | null): string | null {\n322:   const routeBlock = buildAdvisorRenderPlan(rendered).blocks.find((block) => (\n323:     block.id === ROUTE_ADVISOR_ID\n324:   ));\n325:   return routeBlock?.content ?? null;\n326: }\n327: \n328: /** Read the append-only in-process shadow log without exposing route content. */\n329: export function getShadowRouteOnlyLog(): readonly ShadowRouteOnlyLogRecord[] {\n330:   return Object.freeze(SHADOW_ROUTE_ONLY_LOG.map((record) => ({ ...record })));\n331: }\n332: \n333: /** Clear shadow log entries between isolated evaluations. */\n334: export function clearShadowRouteOnlyLog(): void {\n335:   SHADOW_ROUTE_ONLY_LOG.length = 0;\n336: }\n337: \n338: function stateSignalsForBlock(options: ShadowDeliveryRenderOptions): ShadowDeliveryRenderOptions {\n339:   return {\n340:     ...options,\n341:     lifecycleEvent: undefined,\n342:     scopeChanged: false,\n343:     policySetChanged: false,\n344:     goalChanged: false,\n345:   };\n346: }\n347: \n348: function pushShadowRouteOnlyLog(record: ShadowRouteOnlyLogRecord): void {\n349:   if (SHADOW_ROUTE_ONLY_LOG.length >= MAX_SHADOW_ROUTE_ONLY_LOG) {\n350:     SHADOW_ROUTE_ONLY_LOG.shift();\n351:   }\n352:   SHADOW_ROUTE_ONLY_LOG.push(record);\n353: }\n354: \n355: function directiveBlocksSuppressed(\n356:   plan: ReturnType<typeof buildAdvisorRenderPlan>,\n357:   decisions: readonly ReturnType<typeof evaluateDeliveryState>[],\n358: ): boolean {\n359:   for (const expectedId of directiveBlockIds()) {\n360:     const blockIndex = plan.blocks.findIndex((block) => block.id === expectedId);\n361:     if (blockIndex === -1) {\n362:       return false;\n363:     }\n364:     const decision = decisions[blockIndex];\n365:     if (!decision || decision.state !== 'SUPPRESSED_SAME') {\n366:       return false;\n367:     }\n368:   }\n369:   return true;\n370: }\n371: \n372: function recordObservedBlockDeliveries(\n373:   plan: ReturnType<typeof buildAdvisorRenderPlan>,\n374:   shadowOptions: ShadowDeliveryRenderOptions,\n375:   machine: DeliveryStateMachine,\n376:   epoch: number,\n377: ): void {\n378:   const blockOptions = stateSignalsForBlock(shadowOptions);\n379:   for (const block of plan.blocks) {\n380:     const receipt = shadowOptions.receipt;\n381:     if (!isObservedDeliveryReceipt(receipt, block.contentHash, epoch)) {\n382:       continue;\n383:     }\n384:     machine.recordDelivery({\n385:       ...blockOptions,\n386:       blockId: block.id,\n387:       contentHash: block.contentHash,\n388:       receipt,\n389:     });\n390:   }\n391: }\n392: \n393: function observeShadowRouteOnly(\n394:   rendered: string | null,\n395:   options: ShadowDeliveryRenderOptions | undefined,\n396: ): void {\n397:   try {\n398:     const plan = buildAdvisorRenderPlan(rendered);\n399:     const shadowOptions = options ?? {};\n400:     const machine = shadowOptions.stateMachine ?? SHADOW_DELIVERY_STATE_MACHINE;\n401:     const epochSnapshot = machine.advanceForSignals(shadowOptions);\n402:     const blockOptions = stateSignalsForBlock(shadowOptions);\n403:     const decisions = plan.blocks.map((block) => evaluateDeliveryState({\n404:       ...blockOptions,\n405:       blockId: block.id,\n406:       contentHash: block.contentHash,\n407:     }, machine));\n408: \n409:     recordObservedBlockDeliveries(plan, shadowOptions, machine, epochSnapshot.epoch);\n410: \n411:     const routeIndex = plan.blocks.findIndex((block) => block.id === ROUTE_ADVISOR_ID);\n412:     const routeDecision = routeIndex === -1 ? null : decisions[routeIndex] ?? null;\n413:     const routeOnlyEligible = Boolean(\n414:       routeDecision?.routeOnlyEligible && directiveBlocksSuppressed(plan, decisions),\n415:     );\n416:     const routeOnly = routeOnlyEligible\n417:       ? renderRouteOnlyAdvisorBrief(rendered)\n418:       : null;\n419:     const emittedByteCount = rendered === null ? 0 : Buffer.byteLength(rendered, 'utf8');\n420:     const routeOnlyByteCount = routeOnly === null ? 0 : Buffer.byteLength(routeOnly, 'utf8');\n421:     const savedBytes = routeOnly === null\n422:       ? 0\n423:       : Math.max(0, emittedByteCount - routeOnlyByteCount);\n424:     const record: ShadowRouteOnlyLogRecord = Object.freeze({\n425:       shadowId: ROUTE_ONLY_SHADOW_ID,\n426:       sessionKnown: routeDecision?.sessionKnown ?? epochSnapshot.sessionKnown,\n427:       epoch: routeDecision?.epoch ?? epochSnapshot.epoch,\n428:       policySetHash: plan.policySetHash,\n429:       routeState: routeDecision?.state ?? null,\n430:       emittedByteCount,\n431:       routeOnlyByteCount,\n432:       savedBytes,\n433:     });\n434:     pushShadowRouteOnlyLog(record);\n435:     try {\n436:       options?.onShadowLog?.(record);\n437:     } catch {\n438:       // Observer callbacks must never affect the rendered advisor bytes.\n439:     }\n440:   } catch {\n441:     // Shadow measurement is fail-open so a throwing observer cannot block delivery.\n442:   }\n443: }\n444: \n445: function observeAdvisorPolicy(\n446:   rendered: string | null,\n447:   options: AdvisorBriefRenderOptions = {},\n448: ): void {\n449:   try {\n450:     observeRenderedAdvisorPolicy(rendered);\n451:   } catch {\n452:     // Shadow measurement is fail-open so a throwing observer cannot block delivery.\n453:   }\n454:   observeShadowRouteOnly(rendered, options.deliveryState);\n455: }\n456: \n457: /** Run the shadow planner for a runtime callback without changing its output. */\n458: export function observeShadowDelivery(\n459:   rendered: string | null,\n460:   deliveryState: ShadowDeliveryRenderOptions = {},\n461: ): void {\n462:   observeAdvisorPolicy(rendered, { deliveryState });\n463: }\n464: \n465: /**\n466:  * Record host-observed policy blocks after the runtime places them into the\n467:  * emitted response. Fail-open: recording errors never change emitted bytes.\n468:  */\n469: export function observeEmittedAdvisorPolicy(\n470:   rendered: string | null,\n471:   deliveryState: ShadowDeliveryRenderOptions = {},\n472: ): void {\n473:   try {\n474:     if (typeof rendered !== 'string' || rendered.length === 0) {\n475:       return;\n476:     }\n477:     const runtime = typeof deliveryState.runtime === 'string' && deliveryState.runtime.length > 0\n478:       ? deliveryState.runtime\n479:       : 'unknown';\n480:     const machine = deliveryState.stateMachine ?? SHADOW_DELIVERY_STATE_MACHINE;\n481:     const epoch = machine.currentEpoch(deliveryState);\n482:     const plan = buildAdvisorRenderPlan(rendered);\n483:     for (const block of plan.blocks) {\n484:       recordObservedPolicyDelivery({\n485:         runtime,\n486:         candidate: deliveryState.candidate ?? OBSERVED_ADVISOR_POLICY_CANDIDATE,\n487:         blockId: block.id,\n488:         content: block.content,\n489:         contentHash: block.contentHash,\n490:         lifecycleEpoch: epoch,\n491:         sessionId: deliveryState.sessionId,\n492:         sessionIdentity: deliveryState.sessionIdentity,\n493:         sessionIdentityConfirmed: deliveryState.sessionIdentityConfirmed,\n494:         sessionIdentityAmbiguous: deliveryState.sessionIdentityAmbiguous,\n495:         transformMessageIdentity: deliveryState.transformMessageIdentity ?? null,\n496:       });\n497:     }\n498:   } catch {\n499:     // Host observation is fail-open so a throwing sink cannot affect delivery.\n500:   }\n501: }\n502: \n503: // ───────────────────────────────────────────────────────────────\n504: // 4. CORE LOGIC\n505: // ───────────────────────────────────────────────────────────────\n506: \n507: /**\n508:  * Render the model-visible advisor brief from typed advisor output only.\n509:  *\n510:  * The renderer is the prompt-boundary guard: it ignores free-form reasons,\n511:  * descriptions, stdout/stderr, and prompt text, and emits nothing when the\n512:  * repository-authored skill label looks instruction-shaped after folding.\n513:  */\n514: export function renderAdvisorBrief(\n515:   result: AdvisorBriefRenderableResult,\n516:   options: AdvisorBriefRenderOptions = {},\n517: ): string | null {\n518:   if (result.status !== 'ok') {\n519:     observeAdvisorPolicy(null, options);\n520:     return null;\n521:   }\n522:   if (result.freshness !== 'live' && result.freshness !== 'stale') {\n523:     observeAdvisorPolicy(null, options);\n524:     return null;\n525:   }\n526: \n527:   const tokenCap = clampTokenCap(result.metrics?.tokenCap ?? options.tokenCap);\n528:   const thresholdConfig = options.thresholdConfig;\n529:   const childSession = options.childSession ?? process.env.AI_SESSION_CHILD === '1';\n530:   const recommendations = result.recommendations.filter((recommendation) => (\n531:     recommendation.passes_threshold === true\n532:     || (\n533:       recommendation.confidence >= (thresholdConfig?.confidenceThreshold ?? resolvedConfidenceThreshold())\n534:       && (\n535:         thresholdConfig?.confidenceOnly === true\n536:         || recommendation.uncertainty <= (thresholdConfig?.uncertaintyThreshold ?? resolvedUncertaintyThreshold())\n537:       )\n538:     )\n539:   ));\n540:   const [top, second] = recommendations;\n541:   if (!top) {\n542:     observeAdvisorPolicy(null, options);\n543:     return null;\n544:   }\n545: \n546:   // A recommendation that needs a mode is named by the skill that owns its row,\n547:   // because the row id is an internal key the reader cannot run.\n548:   const topLabel = commandLabel(top, childSession)\n549:     ?? (isDoctorBridgeId(top.skill)\n550:       ? doctorCommandString(top.skill)\n551:       : sanitizeSkillLabel(metadataSkillLabel(result) ?? (top.needsMode === true ? commandRowFor(top.skill)?.ownerSkillId : undefined) ?? top.skill));\n552:   if (!topLabel) {\n553:     observeAdvisorPolicy(null, options);\n554:     return null;\n555:   }\n556: \n557:   // A hub that withheld its command because the prompt names no single mode says\n558:   // so, so the reader asks for the mode instead of improvising one.\n559:   const headLabel = top.needsMode === true && top.command === undefined\n560:     ? `${topLabel} (needs a mode)`\n561:     : topLabel;\n562: \n563:   // A command printed twice reads as two offers, so the companion line never\n564:   // repeats the command the head already names.\n565:   const headPrintedCommand = top.command\n566:     ?? (top.needsMode === true ? undefined : commandRowFor(top.skill)?.command);\n567:   const companion = isDoctorBridgeId(top.skill)\n568:     ? undefined\n569:     : recommendations.slice(1).find((recommendation) => {\n570:       const command = doctorCommandString(recommendation.skill);\n571:       return command !== null && command !== headPrintedCommand;\n572:     });\n573:   const companionLabel = companion ? companionCommandLabel(companion.skill, childSession) : null;\n574:   const companionCommand = companion ? doctorCommandString(companion.skill) : null;\n575:   // The partner's command shares the printed line with the head, so a companion\n576:   // that repeats it would offer that command a second time.\n577:   const companionLine = (shownSecond: string | undefined, shownCommand?: string): string => (\n578:     companionLabel\n579:     && companion\n580:     && companion.skill !== shownSecond\n581:     && (shownCommand === undefined || companionCommand !== shownCommand)\n582:       ? `\\nAlso: ${companionLabel}`\n583:       : ''\n584:   );\n585:   const capWithCompanion = (head: string, companionText: string, cap: number): string => {\n586:     const companionFits = head.length + companionText.length <= cap * TOKEN_TO_CHAR_ESTIMATE;\n587:     return `${capText(head, cap)}${companionFits ? companionText : ''}`;\n588:   };\n589: \n590:   const precomputedAmbiguous = typeof result.ambiguous === 'boolean' ? result.ambiguous : undefined;\n591:   if (tokenCap > DEFAULT_TOKEN_CAP && second && hasAdvisorAmbiguitySignal(recommendations, precomputedAmbiguous)) {\n592:     // The scorer names its own tie partners, which can sit below the second passing\n593:     // entry, so prefer a named partner and fall back to the second entry.\n594:     const namedPartners = (top as RenderableRecommendation).ambiguousWith;\n595:     const ambiguousWith: readonly string[] = Array.isArray(namedPartners) ? namedPartners : [];\n596:     const vs = (ambiguousWith.length > 0\n597:       ? recommendations.find((recommendation) => ambiguousWith.includes(recommendation.skill))\n598:       : undefined) ?? second;\n599:     const vsLabel = recommendationLabel(vs, childSession);\n600:     if (!vsLabel && !isDoctorBridgeId(vs.skill)) {\n601:       observeAdvisorPolicy(null, options);\n602:       return null;\n603:     }\n604:     if (vsLabel) {\n605:       const head = `Advisor: ${result.freshness}; ambiguous: ${headLabel} `\n606:         + `${formatScore(top.confidence)}/${formatScore(top.uncertainty)} vs ${vsLabel} `\n607:         + `${formatScore(vs.confidence)}/${formatScore(vs.uncertainty)} pass.`;\n608:       const rendered = capWithCompanion(\n609:         head,\n610:         companionLine(vs.skill, vs.command ?? commandRowFor(vs.skill)?.command),\n611:         Math.min(tokenCap, AMBIGUOUS_TOKEN_CAP),\n612:       ) + DIRECTIVES_LABEL + HYGIENE_DIRECTIVE;\n613:       observeAdvisorPolicy(rendered, options);\n614:       return rendered;\n615:     }\n616:   }\n617: \n618:   const head = `Advisor: ${result.freshness}; use ${headLabel} `\n619:     + `${formatScore(top.confidence)}/${formatScore(top.uncertainty)} pass.`;\n620:   const rendered = capWithCompanion(\n621:     head,\n622:     companionLine(undefined),\n623:     Math.min(tokenCap, DEFAULT_TOKEN_CAP),\n624:   ) + DIRECTIVES_LABEL + HYGIENE_DIRECTIVE;\n625:   observeAdvisorPolicy(rendered, options);\n626:   return rendered;\n627: }\n628: \n629: /** Classify a result with no brief; no result at all means the advisor did not answer. */\n630: export function advisorFallbackCase(\n631:   result?: Pick<AdvisorHookResult, 'status' | 'freshness'>,\n632: ): AdvisorFallbackClassification {\n633:   if (!result || result.status === 'fail_open' || result.freshness === 'absent'\n634:     || (result.freshness === 'unavailable' && result.status !== 'skipped')) {\n635:     return {\n636:       fallbackCase: 'outage',\n637:       outageLabel: result?.freshness === 'absent'\n638:         ? 'absent'\n639:         : result?.status === 'degraded'\n640:           ? 'degraded'\n641:           : 'fail_open',\n642:     };\n643:   }\n644:   if (result.status === 'skipped' && result.freshness === 'unavailable') {\n645:     return { fallbackCase: 'skipped' };\n646:   }\n647:   return { fallbackCase: 'no-match' };\n648: }\n649: \n650: /** Render the fallback status and directive block when no advisor brief is available. */\n651: export function renderAdvisorFallbackDirective(\n652:   options: AdvisorBriefRenderOptions = {},\n653:   result?: Pick<AdvisorHookResult, 'status' | 'freshness'>,\n654: ): string {\n655:   const classification = advisorFallbackCase(result);\n656:   const head = classification.fallbackCase === 'outage'\n657:     ? `Advisor: outage (${classification.outageLabel});${options.setupWording === true ? ' for setup or health checks, run /doctor:setup;' : ''} route by hand: node .skilled/bin/skill-advisor.cjs advisor_recommend --json '{\"prompt\":\"<request>\"}' --format json`\n658:     : classification.fallbackCase === 'skipped'\n659:       ? 'Advisor: prompt skipped.'\n660:       : options.setupWording === true\n661:         ? `Advisor: no skill matched.${SETUP_HINT}`\n662:         : 'Advisor: no skill matched.';\n663:   const rendered = head + DIRECTIVES_LABEL + HYGIENE_DIRECTIVE;\n664:   observeAdvisorPolicy(rendered, options);\n665:   return rendered;\n666: }\n667: \n668: /** Render the outage fallback used when advisor execution times out or is unavailable. */\n669: export function renderAdvisorTimeoutFallback(\n670:   options: AdvisorBriefRenderOptions = {},\n671:   status: Extract<AdvisorHookResult['status'], 'fail_open' | 'degraded'> = 'fail_open',\n672: ): string {\n673:   return renderAdvisorFallbackDirective(options, { status, freshness: 'unavailable' });\n674: }\n675: \n676: export { sanitizeSkillLabel };"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\": \".skilled/skills/system-skill-advisor/runtime/lib/render.ts\"}"},"time":{"start":1794669515734,"end":1794669515991}}}}
