{"type":"tool_use","timestamp":1794669700776,"sessionID":"ses_e255ff46fffe8tw0MjspShTXDB","part":{"partID":"prt_1daa665ed0010JxZ1Tf6NzxaX9","sessionID":"ses_e255ff46fffe8tw0MjspShTXDB","messageID":"msg_1daa64d4e0014vGrEDwr1urHQY","type":"tool","id":"chatcmpl-tool-8e4d3a8079f0a2b8","tool":"read","state":{"status":"completed","input":{"path":".skilled/hooks/shared/session-readers/identity.mjs"},"output":"Read file .skilled/hooks/shared/session-readers/identity.mjs, lines 1-138\n1: // ───────────────────────────────────────────────────────────────────\n2: // MODULE: Session Reader Identity Guard\n3: // ───────────────────────────────────────────────────────────────────\n4: // A caller supplies the session it wants, so a reader must never accept a\n5: // path that resolves outside the runtime-owned store or a file whose own\n6: // identity disagrees with the request. Every rejection is a value, never an\n7: // exception, because the dispatcher owns the single failure envelope.\n8: \n9: // ─────────────────────────────────────────────────────────────────────────────\n10: // 1. IMPORTS\n11: // ─────────────────────────────────────────────────────────────────────────────\n12: \n13: import { realpathSync } from 'node:fs';\n14: import { homedir } from 'node:os';\n15: import { isAbsolute, relative, sep } from 'node:path';\n16: import process from 'node:process';\n17: \n18: // ─────────────────────────────────────────────────────────────────────────────\n19: // 2. INJECTABLE ENVIRONMENT\n20: // ─────────────────────────────────────────────────────────────────────────────\n21: \n22: const PROCESS_HOME = homedir();\n23: \n24: export function envOf(options = {}) {\n25:   return options.env ?? process.env;\n26: }\n27: \n28: export function homeDir(options = {}) {\n29:   return options.home ?? envOf(options).HOME ?? PROCESS_HOME;\n30: }\n31: \n32: // ─────────────────────────────────────────────────────────────────────────────\n33: // 3. SESSION-ID SHAPE\n34: // ─────────────────────────────────────────────────────────────────────────────\n35: \n36: // A session id is a single path segment and a single store key. A separator,\n37: // a NUL, or a dot-only segment cannot name a stored session, so it is rejected\n38: // before it becomes a path component.\n39: export function isSafeSessionId(sessionId) {\n40:   return typeof sessionId === 'string'\n41:     && sessionId.length > 0\n42:     && sessionId !== '.'\n43:     && sessionId !== '..'\n44:     && !sessionId.includes('/')\n45:     && !sessionId.includes('\\\\')\n46:     && !sessionId.includes('\\0');\n47: }\n48: \n49: // ─────────────────────────────────────────────────────────────────────────────\n50: // 4. PATH COMPARISON\n51: // ─────────────────────────────────────────────────────────────────────────────\n52: \n53: export function samePath(left, right) {\n54:   if (typeof left !== 'string' || typeof right !== 'string') return false;\n55:   if (!left || !right) return false;\n56:   if (left === right) return true;\n57:   try {\n58:     return realpathSync(left) === realpathSync(right);\n59:   } catch {\n60:     return false;\n61:   }\n62: }\n63: \n64: // ─────────────────────────────────────────────────────────────────────────────\n65: // 5. CONTAINMENT\n66: // ─────────────────────────────────────────────────────────────────────────────\n67: \n68: function inside(root, candidate) {\n69:   const rel = relative(root, candidate);\n70:   return rel !== ''\n71:     && rel !== '..'\n72:     && !rel.startsWith('..' + sep)\n73:     && !isAbsolute(rel);\n74: }\n75: \n76: /**\n77:  * Whether `child` is `parent` or a folder below it, compared by real path. A\n78:  * runtime that hands its hooks the project root while recording the session's\n79:  * own subfolder still proves the session belongs to that checkout.\n80:  */\n81: export function atOrBelow(child, parent) {\n82:   if (samePath(child, parent)) return true;\n83:   if (typeof child !== 'string' || typeof parent !== 'string' || !child || !parent) return false;\n84:   try {\n85:     return inside(realpathSync(parent), realpathSync(child));\n86:   } catch {\n87:     return false;\n88:   }\n89: }\n90: \n91: // Resolve both spellings first, because a symlink inside the store can point\n92: // at a file outside it and a textual prefix check would accept it.\n93: export function resolveInside({ path, root }) {\n94:   if (typeof path !== 'string' || !path.trim()) {\n95:     return { ok: false, code: 'locator_unavailable' };\n96:   }\n97:   if (typeof root !== 'string' || !root.trim()) {\n98:     return { ok: false, code: 'store_unreadable' };\n99:   }\n100:   if (path.split(/[\\\\/]+/).includes('..')) {\n101:     return { ok: false, code: 'session_mismatch' };\n102:   }\n103: \n104:   let realRoot;\n105:   let realPath;\n106:   try {\n107:     realRoot = realpathSync(root);\n108:     realPath = realpathSync(path);\n109:   } catch {\n110:     return { ok: false, code: 'store_unreadable' };\n111:   }\n112: \n113:   if (!inside(realRoot, realPath)) {\n114:     return { ok: false, code: 'session_mismatch' };\n115:   }\n116:   return { ok: true, path: realPath };\n117: }\n118: \n119: // ─────────────────────────────────────────────────────────────────────────────\n120: // 6. FULL GUARD\n121: // ─────────────────────────────────────────────────────────────────────────────\n122: \n123: export function guardSessionPath({ path, root, sessionId, recordedId } = {}) {\n124:   if (typeof sessionId !== 'string' || !sessionId.trim()) {\n125:     return { ok: false, code: 'locator_unavailable' };\n126:   }\n127:   if (!isSafeSessionId(sessionId)) {\n128:     return { ok: false, code: 'session_mismatch' };\n129:   }\n130: \n131:   const contained = resolveInside({ path, root });\n132:   if (!contained.ok) return contained;\n133: \n134:   if (recordedId !== sessionId) {\n135:     return { ok: false, code: 'session_mismatch' };\n136:   }\n137:   return contained;\n138: }","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file .skilled/hooks/shared/session-readers/identity.mjs, lines 1-138\n1: // ───────────────────────────────────────────────────────────────────\n2: // MODULE: Session Reader Identity Guard\n3: // ───────────────────────────────────────────────────────────────────\n4: // A caller supplies the session it wants, so a reader must never accept a\n5: // path that resolves outside the runtime-owned store or a file whose own\n6: // identity disagrees with the request. Every rejection is a value, never an\n7: // exception, because the dispatcher owns the single failure envelope.\n8: \n9: // ─────────────────────────────────────────────────────────────────────────────\n10: // 1. IMPORTS\n11: // ─────────────────────────────────────────────────────────────────────────────\n12: \n13: import { realpathSync } from 'node:fs';\n14: import { homedir } from 'node:os';\n15: import { isAbsolute, relative, sep } from 'node:path';\n16: import process from 'node:process';\n17: \n18: // ─────────────────────────────────────────────────────────────────────────────\n19: // 2. INJECTABLE ENVIRONMENT\n20: // ─────────────────────────────────────────────────────────────────────────────\n21: \n22: const PROCESS_HOME = homedir();\n23: \n24: export function envOf(options = {}) {\n25:   return options.env ?? process.env;\n26: }\n27: \n28: export function homeDir(options = {}) {\n29:   return options.home ?? envOf(options).HOME ?? PROCESS_HOME;\n30: }\n31: \n32: // ─────────────────────────────────────────────────────────────────────────────\n33: // 3. SESSION-ID SHAPE\n34: // ─────────────────────────────────────────────────────────────────────────────\n35: \n36: // A session id is a single path segment and a single store key. A separator,\n37: // a NUL, or a dot-only segment cannot name a stored session, so it is rejected\n38: // before it becomes a path component.\n39: export function isSafeSessionId(sessionId) {\n40:   return typeof sessionId === 'string'\n41:     && sessionId.length > 0\n42:     && sessionId !== '.'\n43:     && sessionId !== '..'\n44:     && !sessionId.includes('/')\n45:     && !sessionId.includes('\\\\')\n46:     && !sessionId.includes('\\0');\n47: }\n48: \n49: // ─────────────────────────────────────────────────────────────────────────────\n50: // 4. PATH COMPARISON\n51: // ─────────────────────────────────────────────────────────────────────────────\n52: \n53: export function samePath(left, right) {\n54:   if (typeof left !== 'string' || typeof right !== 'string') return false;\n55:   if (!left || !right) return false;\n56:   if (left === right) return true;\n57:   try {\n58:     return realpathSync(left) === realpathSync(right);\n59:   } catch {\n60:     return false;\n61:   }\n62: }\n63: \n64: // ─────────────────────────────────────────────────────────────────────────────\n65: // 5. CONTAINMENT\n66: // ─────────────────────────────────────────────────────────────────────────────\n67: \n68: function inside(root, candidate) {\n69:   const rel = relative(root, candidate);\n70:   return rel !== ''\n71:     && rel !== '..'\n72:     && !rel.startsWith('..' + sep)\n73:     && !isAbsolute(rel);\n74: }\n75: \n76: /**\n77:  * Whether `child` is `parent` or a folder below it, compared by real path. A\n78:  * runtime that hands its hooks the project root while recording the session's\n79:  * own subfolder still proves the session belongs to that checkout.\n80:  */\n81: export function atOrBelow(child, parent) {\n82:   if (samePath(child, parent)) return true;\n83:   if (typeof child !== 'string' || typeof parent !== 'string' || !child || !parent) return false;\n84:   try {\n85:     return inside(realpathSync(parent), realpathSync(child));\n86:   } catch {\n87:     return false;\n88:   }\n89: }\n90: \n91: // Resolve both spellings first, because a symlink inside the store can point\n92: // at a file outside it and a textual prefix check would accept it.\n93: export function resolveInside({ path, root }) {\n94:   if (typeof path !== 'string' || !path.trim()) {\n95:     return { ok: false, code: 'locator_unavailable' };\n96:   }\n97:   if (typeof root !== 'string' || !root.trim()) {\n98:     return { ok: false, code: 'store_unreadable' };\n99:   }\n100:   if (path.split(/[\\\\/]+/).includes('..')) {\n101:     return { ok: false, code: 'session_mismatch' };\n102:   }\n103: \n104:   let realRoot;\n105:   let realPath;\n106:   try {\n107:     realRoot = realpathSync(root);\n108:     realPath = realpathSync(path);\n109:   } catch {\n110:     return { ok: false, code: 'store_unreadable' };\n111:   }\n112: \n113:   if (!inside(realRoot, realPath)) {\n114:     return { ok: false, code: 'session_mismatch' };\n115:   }\n116:   return { ok: true, path: realPath };\n117: }\n118: \n119: // ─────────────────────────────────────────────────────────────────────────────\n120: // 6. FULL GUARD\n121: // ─────────────────────────────────────────────────────────────────────────────\n122: \n123: export function guardSessionPath({ path, root, sessionId, recordedId } = {}) {\n124:   if (typeof sessionId !== 'string' || !sessionId.trim()) {\n125:     return { ok: false, code: 'locator_unavailable' };\n126:   }\n127:   if (!isSafeSessionId(sessionId)) {\n128:     return { ok: false, code: 'session_mismatch' };\n129:   }\n130: \n131:   const contained = resolveInside({ path, root });\n132:   if (!contained.ok) return contained;\n133: \n134:   if (recordedId !== sessionId) {\n135:     return { ok: false, code: 'session_mismatch' };\n136:   }\n137:   return contained;\n138: }"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\": \".skilled/hooks/shared/session-readers/identity.mjs\"}"},"time":{"start":1794669700589,"end":1794669700776}}}}
