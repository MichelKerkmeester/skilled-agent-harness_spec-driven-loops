  let surface = null;\n  try {\n    const real = realpathSync(projectDir);\n    const hubRoot = resolveHubSkilledRoot();\n    const insideHub = Boolean(hubRoot) && (real === hubRoot || real.startsWith(`${hubRoot}${sep}`));\n    const match = hubRoot\n      ? declaredSurfaces(hubRoot).find((entry) => (\n        entry.role === 'fallback' ? insideHub : workspaceHasMarker(real, entry)\n      ))\n      : null;\n    surface = match ? match.label : null;\n  } catch {\n    surface = null;\n  }\n  workspaceSurfaceCache.set(projectDir, surface);\n  return surface;\n}\n\nfunction advisorCliRequest({ prompt, options, surfaceHint = null }) {\n  const requestOptions = {\n    // Three recommendations keep the two-target ambiguity line available without\n    // asking the advisor for a longer list than the brief can use.\n    topK: 3,\n    includeAttribution: false,\n    includeAbstainReasons: true,\n    // The brief prints the head and at most one partner, and every hook asks for\n    // the route of the top pick alone, so a partner that carried a command here\n    // and none there would give two runtimes two heads for one request.\n    compiledRouteTopOnly: true,\n    confidenceThreshold: options.thresholdConfidence,\n    uncertaintyThreshold: DEFAULT_THRESHOLD_UNCERTAINTY,\n    ...(surfaceHint ? { surfaceHint } : {}),\n  };\n  const request = (text) => JSON.stringify({ prompt: text, options: requestOptions });\n  let remaining = options.maxPromptBytes - Buffer.byteLength(request(''), 'utf8');\n  let end = 0;\n  for (const char of prompt.slice(0, ADVISOR_PROMPT_MAX_CHARS)) {\n    remaining -= Buffer.byteLength(JSON.stringify(char), 'utf8') - 2;\n    if (remaining < 0) break;\n    end += char.length;\n  }\n  return end > 0 ? request(prompt.slice(0, end)) : null;\n}\n\n// ─────────────────────────────────────────────────────────────────────────────\n// 5. EVENT HELPERS\n// ─────────────────────────────────────────────────────────────────────────────\n\nfunction eventPayloadFrom(event) {\n  if (event?.payload && typeof event.payload === 'object') {\n    return event.payload;\n  }\n  return event;\n}\n\nfunction eventTypeFrom(event) {\n  const payload = eventPayloadFrom(event);\n  return typeof payload?.type === 'string' ? payload.type : null;\n}\n\nfunction lifecycleEventFrom(input, eventType = null) {\n  const candidates = [\n    input?.lifecycleEvent,\n    input?.lifecycle_event,\n    input?.lifecycleSource,\n    input?.lifecycle_source,\n    input?.source,\n    input?.properties?.source,\n  ];\n  for (const candidate of candidates) {\n    if (candidate === 'startup' || candidate === 'resume' || candidate === 'compact') {\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"    ...hub.filter((entry) => entry.role === 'specific'),\n    ...outside,\n    ...hub.filter((entry) => entry.role === 'fallback'),\n  ];\n}\n\n// A specific surface matches when the resolved workspace holds one of its path or\n// file markers, or sits inside a folder a path marker names. Extension and content\n// markers need the files a task touches, which a workspace check does not have.\nfunction workspaceHasMarker(real, entry) {\n  return entry.markers.some((marker) => {\n    if (EXTENSION_MARKER.test(marker)) return false;\n    const rel = marker.replace(/\\/+$/, '');\n    if (!rel) return false;\n    return existsSync(join(real, rel)) || `${real}${sep}`.includes(`${sep}${rel.split('/').join(sep)}${sep}`);\n  });\n}\n\n// The sk-code surface a session works in, read from its workspace. A specific\n// surface whose markers the workspace holds wins, so a surface another repository\n// adds always leads the hub's own. The fallback holds only when the resolved\n// workspace lies inside the hub's own .skilled directory, so a symlinked local\n// skill or a .skilled folder in another repository is never read as hub code. Any\n// other workspace sends no hint, so the compiled tie-break order applies. The\n// result is cached per workspace because the check runs before every uncached\n// advisor call.\nconst workspaceSurfaceCache = new Map();\nfunction detectWorkspaceSurface(projectDir) {\n  if (typeof projectDir !== 'string' || projectDir.length === 0) return null;\n  if (workspaceSurfaceCache.has(projectDir)) return workspaceSurfaceCache.get(projectDir);\n  let surface = null;\n  try {\n    const real = realpathSync(projectDir);\n    const hubRoot = resolveHubSkilledRoot();\n    const insideHub = Boolean(hubRoot) && (real === hubRoot || real.startsWith(`${hubRoot}${sep}`));\n    const match = hubRoot\n      ? declaredSurfaces(hubRoot).find((entry) => (\n        entry.role === 'fallback' ? insideHub : workspaceHasMarker(real, entry)\n      ))\n      : null;\n    surface = match ? match.label : null;\n  } catch {\n    surface = null;\n  }\n  workspaceSurfaceCache.set(projectDir, surface);\n  return surface;\n}\n\nfunction advisorCliRequest({ prompt, options, surfaceHint = null }) {\n  const requestOptions = {\n    // Three recommendations keep the two-target ambiguity line available without\n    // asking the advisor for a longer list than the brief can use.\n    topK: 3,\n    includeAttribution: false,\n    includeAbstainReasons: true,\n    // The brief prints the head and at most one partner, and every hook asks for\n    // the route of the top pick alone, so a partner that carried a command here\n    // and none there would give two runtimes two heads for one request.\n    compiledRouteTopOnly: true,\n    confidenceThreshold: options.thresholdConfidence,\n    uncertaintyThreshold: DEFAULT_THRESHOLD_UNCERTAINTY,\n    ...(surfaceHint ? { surfaceHint } : {}),\n  };\n  const request = (text) => JSON.stringify({ prompt: text, options: requestOptions });\n  let remaining = options.maxPromptBytes - Buffer.byteLength(request(''), 'utf8');\n  let end = 0;\n  for (const char of prompt.slice(0, ADVISOR_PROMPT_MAX_CHARS)) {\n    remaining -= Buffer.byteLength(JSON.stringify(char), 'utf8') - 2;\n    if (remaining < 0) break;\n    end += char.length;\n  }\n  return end > 0 ? request(prompt.slice(0, end)) : null;\n}\n\n// ─────────────────────────────────────────────────────────────────────────────\n// 5. EVENT HELPERS\n// ─────────────────────────────────────────────────────────────────────────────\n\nfunction eventPayloadFrom(event) {\n  if (event?.payload && typeof event.payload === 'object') {\n    return event.payload;\n  }\n  return event;\n}\n\nfunction eventTypeFrom(event) {\n  const payload = eventPayloadFrom(event);\n  return typeof payload?.type === 'string' ? payload.type : null;\n}\n\nfunction lifecycleEventFrom(input, eventType = null) {\n  const candidates = [\n    input?.lifecycleEvent,\n    input?.lifecycle_event,\n    input?.lifecycleSource,\n    input?.lifecycle_source,\n    input?.source,\n    input?.properties?.source,\n  ];\n  for (const candidate of candidates) {\n    if (candidate === 'startup' || candidate === 'resume' || candidate === 'compact') {\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\": \"sed -n '800,900p' .opencode/plugins/system-skill-advisor.js\"}"},"time":{"start":1794670001156,"end":1794670001544}}}}
