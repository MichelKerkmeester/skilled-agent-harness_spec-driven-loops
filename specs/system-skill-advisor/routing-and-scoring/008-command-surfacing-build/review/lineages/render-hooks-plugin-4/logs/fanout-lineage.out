{"type":"tool_use","timestamp":1794669573385,"sessionID":"ses_e255ff46fffe8tw0MjspShTXDB","part":{"partID":"prt_1daa4687e001sb9T0x55SpGd8o","sessionID":"ses_e255ff46fffe8tw0MjspShTXDB","messageID":"msg_1daa430b3001grVh6u3yAoUAEe","type":"tool","id":"chatcmpl-tool-b99c830483f7ac76","tool":"shell","state":{"status":"completed","input":{"command":"git diff 0cdc9fa3ef..HEAD -- .skilled/skills/system-skill-advisor/runtime/lib/render.ts .skilled/skills/system-skill-advisor/runtime/tests/doctor-brief-render.vitest.ts"},"output":"diff --git a/.skilled/skills/system-skill-advisor/runtime/lib/render.ts b/.skilled/skills/system-skill-advisor/runtime/lib/render.ts\nindex 84ae4cb058..b1018b07c8 100644\n--- a/.skilled/skills/system-skill-advisor/runtime/lib/render.ts\n+++ b/.skilled/skills/system-skill-advisor/runtime/lib/render.ts\n@@ -252,17 +252,17 @@ function recommendationLabel(recommendation: RenderableRecommendation, childSess\n       : sanitizeSkillLabel(recommendation.skill));\n }\n \n-// The companion line normally shows only the runnable command. A child gets the\n-// downgrade marker appended because that command must not be started there.\n+// A companion is a command the reader may act on, so it carries the same policy\n+// word the head carries. A child still gets the downgrade marker because that\n+// command must not be started there.\n function companionCommandLabel(skillId: string, childSession: boolean): string | null {\n   const command = doctorCommandString(skillId);\n   if (command === null) {\n     return null;\n   }\n   const row = commandRowFor(skillId);\n-  return childSession && parentNamedOnly(row?.policy, row?.mutating)\n-    ? `${command} (${PARENT_NAMED_POLICY})`\n-    : command;\n+  const word = policyWord(row?.policy, row?.mutating, childSession);\n+  return word === null ? command : `${command} (${word})`;\n }\n \n function formatScore(value: number): string {\n@@ -560,12 +560,27 @@ export function renderAdvisorBrief(\n     ? `${topLabel} (needs a mode)`\n     : topLabel;\n \n+  // A command printed twice reads as two offers, so the companion line never\n+  // repeats the command the head already names.\n+  const headPrintedCommand = top.command\n+    ?? (top.needsMode === true ? undefined : commandRowFor(top.skill)?.command);\n   const companion = isDoctorBridgeId(top.skill)\n     ? undefined\n-    : recommendations.slice(1).find((recommendation) => doctorCommandString(recommendation.skill) !== null);\n+    : recommendations.slice(1).find((recommendation) => {\n+      const command = doctorCommandString(recommendation.skill);\n+      return command !== null && command !== headPrintedCommand;\n+    });\n   const companionLabel = companion ? companionCommandLabel(companion.skill, childSession) : null;\n-  const companionLine = (shownSecond: string | undefined): string => (\n-    companionLabel && companion && companion.skill !== shownSecond ? `\\nAlso: ${companionLabel}` : ''\n+  const companionCommand = companion ? doctorCommandString(companion.skill) : null;\n+  // The partner's command shares the printed line with the head, so a companion\n+  // that repeats it would offer that command a second time.\n+  const companionLine = (shownSecond: string | undefined, shownCommand?: string): string => (\n+    companionLabel\n+    && companion\n+    && companion.skill !== shownSecond\n+    && (shownCommand === undefined || companionCommand !== shownCommand)\n+      ? `\\nAlso: ${companionLabel}`\n+      : ''\n   );\n   const capWithCompanion = (head: string, companionText: string, cap: number): string => {\n     const companionFits = head.length + companionText.length <= cap * TOKEN_TO_CHAR_ESTIMATE;\n@@ -592,7 +607,7 @@ export function renderAdvisorBrief(\n         + `${formatScore(vs.confidence)}/${formatScore(vs.uncertainty)} pass.`;\n       const rendered = capWithCompanion(\n         head,\n-        companionLine(vs.skill),\n+        companionLine(vs.skill, vs.command ?? commandRowFor(vs.skill)?.command),\n         Math.min(tokenCap, AMBIGUOUS_TOKEN_CAP),\n       ) + DIRECTIVES_LABEL + HYGIENE_DIRECTIVE;\n       observeAdvisorPolicy(rendered, options);\ndiff --git a/.skilled/skills/system-skill-advisor/runtime/tests/doctor-brief-render.vitest.ts b/.skilled/skills/system-skill-advisor/runtime/tests/doctor-brief-render.vitest.ts\nindex 656cbedd20..39f1586604 100644\n--- a/.skilled/skills/system-skill-advisor/runtime/tests/doctor-brief-render.vitest.ts\n+++ b/.skilled/skills/system-skill-advisor/runtime/tests/doctor-brief-render.vitest.ts\n@@ -3,6 +3,7 @@\n // ───────────────────────────────────────────────────────────────\n \n import { describe, expect, it } from 'vitest';\n+import { commandRowFor } from '../lib/command-attach.js';\n import {\n   doctorCommandString,\n   renderAdvisorBrief,\n@@ -26,6 +27,9 @@ interface RecommendationInput {\n   readonly kind: 'skill' | 'command';\n   readonly confidence: number;\n   readonly uncertainty: number;\n+  readonly command?: string;\n+  readonly policy?: string;\n+  readonly ownerSkillId?: string;\n }\n \n // Every recommendation is marked as passing so each case isolates label\n@@ -60,7 +64,24 @@ describe('doctor command brief', () => {\n       { skill: 'command-doctor-git-setup', kind: 'command', confidence: 0.82, uncertainty: 0.21 },\n     ]));\n \n-    expect(rendered).toBe(expectedBrief('Advisor: live; use sk-git 0.82/0.20 pass.\\nAlso: /doctor:git setup'));\n+    expect(rendered).toBe(expectedBrief(`Advisor: live; use sk-git 0.82/0.20 pass.\\nAlso: /doctor:git setup (${commandRowFor('command-doctor-git-setup')?.policy})`));\n+  });\n+\n+  it('prints the policy word of a companion and the child marker in a child session', () => {\n+    const result = advisorResult([\n+      { skill: 'system-spec-kit', kind: 'skill', confidence: 0.95, uncertainty: 0.12 },\n+      { skill: 'command-doctor-env', kind: 'command', confidence: 0.82, uncertainty: 0.2 },\n+    ]);\n+\n+    expect(renderAdvisorBrief(result, { childSession: false })).toContain('\\nAlso: /doctor:env list (run)');\n+    expect(renderAdvisorBrief(result, { childSession: true })).toContain('\\nAlso: /doctor:env list (run)');\n+\n+    const updateResult = advisorResult([\n+      { skill: 'system-spec-kit', kind: 'skill', confidence: 0.95, uncertainty: 0.12 },\n+      { skill: 'command-doctor-update', kind: 'command', confidence: 0.82, uncertainty: 0.2 },\n+    ]);\n+\n+    expect(renderAdvisorBrief(updateResult, { childSession: true })).toContain('\\nAlso: /doctor:update (parent-named only)');\n   });\n \n   it('uses the first doctor bridge after the top pick, past other skills', () => {\n@@ -70,10 +91,30 @@ describe('doctor command brief', () => {\n       { skill: 'command-doctor-update', kind: 'command', confidence: 0.82, uncertainty: 0.22 },\n     ])) ?? '';\n \n-    expect(rendered).toContain('\\nAlso: /doctor:update');\n+    expect(rendered).toContain('\\nAlso: /doctor:update (ask)');\n     expect(rendered.startsWith('Advisor: live; use sk-code 0.82/0.20 pass.')).toBe(true);\n   });\n \n+  it('prints a command once when the head already names it', () => {\n+    const rendered = renderAdvisorBrief(advisorResult([\n+      { skill: 'system-skilled-doctor', kind: 'skill', confidence: 0.82, uncertainty: 0.26, command: '/doctor:update', policy: 'ask', ownerSkillId: 'system-skilled-doctor' },\n+      { skill: 'command-doctor-update', kind: 'command', confidence: 0.82, uncertainty: 0.2 },\n+    ])) ?? '';\n+\n+    expect(rendered.match(/\\/doctor:update/g)).toHaveLength(1);\n+    expect(rendered).not.toContain('Also:');\n+  });\n+\n+  it('prints a second doctor bridge when the first repeats the head', () => {\n+    const rendered = renderAdvisorBrief(advisorResult([\n+      { skill: 'system-skilled-doctor', kind: 'skill', confidence: 0.82, uncertainty: 0.26, command: '/doctor:update', policy: 'ask', ownerSkillId: 'system-skilled-doctor' },\n+      { skill: 'command-doctor-update', kind: 'command', confidence: 0.82, uncertainty: 0.2 },\n+      { skill: 'command-doctor-env', kind: 'command', confidence: 0.82, uncertainty: 0.2 },\n+    ])) ?? '';\n+\n+    expect(rendered).toContain('\\nAlso: /doctor:env list (run)');\n+  });\n+\n   it('never renders a raw or unmapped doctor id', () => {\n     const withUnmappedBridge = renderAdvisorBrief(advisorResult([\n       { skill: 'sk-git', kind: 'skill', confidence: 0.82, uncertainty: 0.2 },\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"diff --git a/.skilled/skills/system-skill-advisor/runtime/lib/render.ts b/.skilled/skills/system-skill-advisor/runtime/lib/render.ts\nindex 84ae4cb058..b1018b07c8 100644\n--- a/.skilled/skills/system-skill-advisor/runtime/lib/render.ts\n+++ b/.skilled/skills/system-skill-advisor/runtime/lib/render.ts\n@@ -252,17 +252,17 @@ function recommendationLabel(recommendation: RenderableRecommendation, childSess\n       : sanitizeSkillLabel(recommendation.skill));\n }\n \n-// The companion line normally shows only the runnable command. A child gets the\n-// downgrade marker appended because that command must not be started there.\n+// A companion is a command the reader may act on, so it carries the same policy\n+// word the head carries. A child still gets the downgrade marker because that\n+// command must not be started there.\n function companionCommandLabel(skillId: string, childSession: boolean): string | null {\n   const command = doctorCommandString(skillId);\n   if (command === null) {\n     return null;\n   }\n   const row = commandRowFor(skillId);\n-  return childSession && parentNamedOnly(row?.policy, row?.mutating)\n-    ? `${command} (${PARENT_NAMED_POLICY})`\n-    : command;\n+  const word = policyWord(row?.policy, row?.mutating, childSession);\n+  return word === null ? command : `${command} (${word})`;\n }\n \n function formatScore(value: number): string {\n@@ -560,12 +560,27 @@ export function renderAdvisorBrief(\n     ? `${topLabel} (needs