ingFindings, anchorOptions);\n\n  Line 1979:     anchorOptions,\n\n  Line 2004:     anchorOptions,\n\n  Line 2006:   updated = replaceAnchorSection(updated, 'next-focus', '11. NEXT FOCUS', nextFocus, anchorOptions);\n\n  Line 2340:       // A missing machine-owned anchor is a warning-class input problem, not\n\n  Line 2425:   const cliArgs = process.argv.slice(2);\n\n  Line 2453:       'Usage: node .skilled/skills/system-deep-loop/runtime/scripts/reduce-state.cjs <spec-folder> [--artifact-dir <path>] [--lenient] [--create-missing-anchors] [--emit-resource-map]\\n',\n","title":"grep","metadata":{"metadata":{"matches":19,"truncated":false},"content":[{"type":"text","text":"Found 19 matches\n/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-deep-loop/runtime/scripts/reduce-state.cjs:\n  Line 1837: function replaceAnchorSection(content, anchorId, heading, body, options = {}) {\n\n  Line 1838:   const pattern = new RegExp(`<!-- ANCHOR:${anchorId} -->[\\\\s\\\\S]*?<!-- \\\\/ANCHOR:${anchorId} -->`, 'm');\n\n  Line 1840:     `<!-- ANCHOR:${anchorId} -->`,\n\n  Line 1844:     `<!-- /ANCHOR:${anchorId} -->`,\n\n  Line 1854:   // by anchor id. Fall back to matching the heading itself so a freshly\n\n  Line 1868:     `Missing machine-owned anchor \"${anchorId}\" in deep-review strategy file. `\n\n  Line 1869:     + 'Pass createMissing:true (or the reducer CLI flag --create-missing-anchors) to bootstrap.',\n\n  Line 1893:     // same create-missing bootstrap the anchor sections already honor, append instead\n\n  Line 1910:   // cannot contain the machine-owned anchors and replaceAnchorSection would\n\n  Line 1917:   const anchorOptions = { createMissing: Boolean(options.createMissingAnchors) };\n\n  Line 1971:   updated = replaceAnchorSection(updated, 'review-dimensions', '3. REVIEW DIMENSIONS (remaining)', remainingDimensions, anchorOptions);\n\n  Line 1972:   updated = replaceAnchorSection(updated, 'completed-dimensions', '4. COMPLETED DIMENSIONS', completedDimensions, anchorOptions);\n\n  Line 1973:   updated = replaceAnchorSection(updated, 'running-findings', '5. RUNNING FINDINGS', runningFindings, anchorOptions);\n\n  Line 1979:     anchorOptions,\n\n  Line 2004:     anchorOptions,\n\n  Line 2006:   updated = replaceAnchorSection(updated, 'next-focus', '11. NEXT FOCUS', nextFocus, anchorOptions);\n\n  Line 2340:       // A missing machine-owned anchor is a warning-class input problem, not\n\n  Line 2425:   const cliArgs = process.argv.slice(2);\n\n  Line 2453:       'Usage: node .skilled/skills/system-deep-loop/runtime/scripts/reduce-state.cjs <spec-folder> [--artifact-dir <path>] [--lenient] [--create-missing-anchors] [--emit-resource-map]\\n',\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"pattern\": \"create-missing-anchors|artifact-dir|function main|process.argv|strategyUpdates|anchor\", \"path\": \".skilled/skills/system-deep-loop/runtime/scripts/reduce-state.cjs\"}"},"time":{"start":1794669462067,"end":1794669462152}}}}
