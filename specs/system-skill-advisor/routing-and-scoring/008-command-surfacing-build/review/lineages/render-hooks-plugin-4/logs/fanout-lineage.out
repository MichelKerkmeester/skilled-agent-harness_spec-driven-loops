ummaryLine(summary), baseline);\n.opencode/plugins/tests/system-skill-advisor.test.cjs:398:  assert.equal(renderHelpers.renderCompiledRouteSummaryLine(summary, { bounded: false }), baseline);\n.opencode/plugins/tests/system-skill-advisor.test.cjs:443:  const digest = renderHelpers.compiledRouteSummaryTargetDigest(summary);\n.opencode/plugins/tests/system-skill-advisor.test.cjs:444:  assert.equal(renderHelpers.compiledRouteSummaryTargetDigest(reordered), digest);\n.opencode/plugins/tests/system-skill-advisor.test.cjs:445:  assert.notEqual(renderHelpers.compiledRouteSummaryTargetDigest(changedOmitted), digest);\n.opencode/plugins/tests/system-skill-advisor.test.cjs:447:    renderHelpers.renderCompiledRouteSummaryLine(summary, { bounded: true }),\n.opencode/plugins/tests/system-skill-advisor.test.cjs:455:  const exactLine = renderHelpers.renderCompiledRouteSummaryLine(\n.opencode/plugins/tests/system-skill-advisor.test.cjs:462:    renderHelpers.renderCompiledRouteSummaryLine(compiledRouteSummary([]), { bounded: true }),\n.opencode/plugins/tests/system-skill-advisor.test.cjs:465:  assert.equal(renderHelpers.renderCompiledRouteSummaryLine(null, { bounded: true }), null);\n.opencode/plugins/tests/system-skill-advisor.test.cjs:466:  assert.deepEqual(renderHelpers.revealCompiledRouteSummaryTargets({ targets: ['alpha', 42] }), ['alpha']);\n.opencode/plugins/lib/skill-advisor-render.js:86:export function revealCompiledRouteSummaryTargets(summary) {\n.opencode/plugins/lib/skill-advisor-render.js:107:export function compiledRouteSummaryTargetDigest(summary) {\n.opencode/plugins/lib/skill-advisor-render.js:108:  return digestCompiledRouteTargets(revealCompiledRouteSummaryTargets(summary));\n.opencode/plugins/lib/skill-advisor-render.js:127:export function renderCompiledRouteSummaryLine(summary, renderOptions = {}) {\n.opencode/plugins/lib/skill-advisor-render.js:146:  const fullTargets = revealCompiledRouteSummaryTargets(summary);\n"}],"providerCall":{"executed":false},"provider