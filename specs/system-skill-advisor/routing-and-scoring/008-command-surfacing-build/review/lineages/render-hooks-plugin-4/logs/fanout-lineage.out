.thresholdConfidence] - Minimum advisor confidence threshold\n1685:            `threshold_confidence=${options.thresholdConfidence}`,\n===\n364:function normalizeOptions(rawOptions) {\n365-  const options = rawOptions && typeof rawOptions === 'object' ? rawOptions : {};\n366-  const configuredTtl = options.cacheTTLMs ?? options.cacheTtlMs;\n367-  const enabled = options.enabled !== false && !envDisablesPlugin();\n368-  const configuredTransformDedup = typeof options.deduplicateTransforms === 'boolean'\n369-    ? options.deduplicateTransforms\n370-    : undefined;\n371-\n372-  const envCacheTTLMs = Number(process.env.SYSTEM_SKILL_ADVISOR_CACHE_TTL_MS);\n373-  const envThreshold = Number(process.env.SYSTEM_SKILL_ADVISOR_THRESHOLD_CONFIDENCE);\n374-  const envMaxTokens = Number(process.env.SYSTEM_SKILL_ADVISOR_MAX_TOKENS);\n375-  const envBridgeTimeoutMs = Number(process.env.SYSTEM_SKILL_ADVISOR_BRIDGE_TIMEOUT_MS);\n376-  const envMaxPromptBytes = Number(process.env.SYSTEM_SKILL_ADVISOR_MAX_PROMPT_BYTES);\n--\n386:    thresholdConfidence: normalizeThreshold(options.thresholdConfidence ?? (Number.isFinite(envThreshold) ? envThreshold : undefined)),\n387-    maxTokens: normalizePositiveInt(options.maxTokens, normalizePositiveInt(envMaxTokens, DEFAULT_MAX_TOKENS)),\n388-    nodeBinary: typeof options.nodeBinaryOverride === 'string' && options.nodeBinaryOverride.trim()\n389-      ? options.nodeBinaryOverride.trim()\n390-      : (process.env.SYSTEM_SKILL_ADVISOR_NODE_BINARY || process.env.SPEC_KIT_PLUGIN_NODE_BINARY || DEFAULT_NODE_BINARY),\n391-    bridgeTimeoutMs: normalizePositiveInt(options.bridgeTimeoutMs, normalizePositiveInt(envBridgeTimeoutMs, DEFAULT_BRIDGE_TIMEOUT_MS)),\n392-    maxPromptBytes: normalizePositiveInt(options.maxPromptBytes, normalizePositiveInt(envMaxPromptBytes, DEFAULT_MAX_PROMPT_BYTES)),\n393-    maxBriefChars: normalizePositiveInt(options.maxBriefChars, normalizePositiveInt(envMaxBriefChars, DEFAULT_MAX_BRIEF_CHARS)),\n394-    maxCacheEntries: n