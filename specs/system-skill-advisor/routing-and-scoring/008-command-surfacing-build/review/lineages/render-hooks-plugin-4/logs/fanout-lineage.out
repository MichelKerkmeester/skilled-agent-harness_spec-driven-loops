ids, but a reader can only act on a command they\\n// typed or on the skill that owns it. A row whose bare slash command appears in\\n// the prompt keeps its command fields, and every other row collapses to its owner\\n// skill so the degraded brief names a skill that exists instead of a raw row id.\\nexport function degradedRecommendations(\\n  entries: readonly AdvisorRecommendation[],\\n  prompt: string,\\n): Array<Record<string, unknown>> {\\n  const offeredSkills = new Set<string>();\\n  const recommendations: Array<Record<string, unknown>> = [];\\n\\n  for (const entry of entries) {\\n    if (entry.passes_threshold !== true) continue;\\n    const base = {\\n      confidence: entry.confidence,\\n      uncertainty: entry.uncertainty,\\n      reason: entry.reason ?? '',\\n    };\\n    const row = commandRowFor(entry.skill);\\n\\n    if (row && prompt.includes(row.command.split(' ')[0])) {\\n      recommendations.push({\\n        skillId: entry.skill,\\n        kind: 'command',\\n        command: row.command,\\n        ...(row.policy ? { policy: row.policy } : {}),\\n        ownerSkillId: row.ownerSkil...\n  Line 69: {\"type\":\"tool_use\",\"timestamp\":1794527453996,\"sessionID\":\"ses_e2dd8cae6ffeV3iKQc8fxV7h6K\",\"part\":{\"partID\":\"prt_1d22be0de002kn7bR0ouzUy0Ms\",\"sessionID\":\"ses_e2dd8cae6ffeV3iKQc8fxV7h6K\",\"messageID\":\"msg_1d22ba8aa001yZAnQ4neYpVFTX\",\"type\":\"tool\",\"id\":\"call_a4128feae7c14382843b5e4e\",\"tool\":\"read\",\"state\":{\"status\":\"completed\",\"input\":{\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/skill-advisor-cli.ts\",\"offset\":1470,\"limit\":65},\"output\":\"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/skill-advisor-cli.ts, lines 1470-1534\\n1470:       delete process.env[forceLocalEnv];\\n1471:     } else {\\n1472:       process.env[forceLocalEnv] = previous;\\