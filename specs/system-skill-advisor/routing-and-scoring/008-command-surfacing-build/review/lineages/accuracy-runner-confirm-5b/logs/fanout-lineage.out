only in its own store is bracketed by a\n1313:   // listing, and the entry the turn added is the session it wrote. A dry run\n1314:   // starts no CLI, so it has nothing to list.\n1315:   const listed = !options.dryRun && listsStore(job.runtime);\n1316:   const listingBefore = listed ? storeIds(job.runtime, job.ghConfig) : null;\n1317:   // The pointer is excluded from git, so the restore below never sees a turn that\n1318:   // changed or deleted it.\n1319:   const pointerPath = join(REPO_ROOT, 'CLAUDE.md');\n1320:   const pointerBefore = existsSync(pointerPath) ? readFileSync(pointerPath, 'utf8') : null;\n1321:   const turn = options.dryRun\n1322:     ? { exit: null, error: null, streamId: null }\n1323:     : await spawnTurn(job.runtime, argv, job.prompt, job.cap, job.ghConfig, options.arm);\n1324:   const listingAfter = listed ? storeIds(job.runtime, job.ghConfig) : null;\n1325:   let reportedId = listed\n1326:     ? addedSessionId(listingBefore, listingAfter)\n1327:     : turn.streamId;\n1328:   // A DSH turn can add helper sessions to the store, so a difference of several\n1329:   // entries names no single session. The one its prompt opened is the turn's own.\n1330:   if (reportedId === null && job.runtime.locator.kind === 'store') {\n1331:     reportedId = await promptSessionId({\n1332:       before: listingBefore,\n1333:       after: listingAfter,\n1334:       prompt: job.prompt,\n1335:       firstUserText,\n1336:     });\n1337:   }\n1338: \n1339:   const after = { status: statusPaths(), ...gitSnapshot() };\n1340:   const headMoved = before.head !== after.head || before.stash !== after.stash;\n1341:   const changed = changedPaths(before.status, after.status);\n1342:   // The locator is kept in hand because the brief reader opens the same session\n1343:   // the line records, and resolving it twice could name a different file.\n1344:   const locator = locatorFor(job.runtime, sessionId, reportedId);\n1345:   const line = {\n1346:     runtime: job.runtimeName,\n1347:     rowId: job.rowId,\n1348:     arm: options.arm,\n1349:     ...(options.run === null ? {} : { run: options.run }),\n1350:     locator,\n1351:     ...(job.fixture === undefined ? {} : { fixture: job.fixture }),\n1352:     exit: turn.exit,\n1353:     changedPaths: changed,\n1354:   };\n1355: \n1356:   if (headMoved) {\n1357:     // The worktree the restore was written for is gone. Restoring now could discard\n1358:     // whatever the commit or stash brought in, so the paths stay listed instead.\n1359:     appendRunLine(options.out, { ...line, restored: false, headMoved: true });\n1360:     return { status: EXIT_HEAD_MOVED, refusal: { ok: false, code: 'head_moved', rowId: job.rowId } };\n[Output truncated. Continue reading with offset: 1361]","title":"read","metadata":{"metadata":{"truncated":true},"content":[{"type":"text","text":"Read file .skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/run-command-behaviour.mjs, lines 1286-1360\n1286: // fires, so a broken precondition never spends another model call.\n1287: async function runTurn(job, options, exempt, isFirst) {\n1288:   const before = { status: statusPaths(), ...gitSnapshot() };\n1289:   // A live turn can push, so it may only start in the arena the builder made: no\n1290:   // remote it could push to by name and the builder's marker in place. The push\n1291:   // boundary is childEnv's empty credential helper, empty GH_CONFIG_DIR,\n1292:   // GIT_TERMINAL_PROMPT=0 and GIT_ALLOW_PROTOCOL=file, because a push to an explicit\n1293:   // URL needs no remote and the protocol setting keeps SSH and HTTPS out of reach\n1294:   // whatever keys HOME holds. A dry run spawns nothing and keeps running in this\n1295:   // checkout.\n1296:   const refusal = turnRefusal(REPO_ROOT, { dryRun: options.dryRun });\n1297:   if (refusal !== null) {\n1298:     return { status: EXIT_REFUSED, refusal };\n1299:   }\n1300:   if (isFirst) {\n1301:     const dirty = dirtyPaths(before.status, exempt);\n1302:   