..body.matchAll(EXEC_STRING_LITERAL)].map((match) => decodeLiteral(match[0]));\n352:   const lines = found.map((value) => value.trim()).filter(Boolean);\n353:   return lines.length > 0 ? lines.join('\\n') : null;\n354: }\n355: \n356: /**\n357:  * Flatten raw session records into the one event shape the checks read.\n358:  *\n359:  * An assistant text block and each tool call become their own event, so a record\n360:  * that carries prose plus two calls loses neither, and `seq` is the event's place\n361:  * in that flattened stream. A prompt is input rather than behaviour, so it is not an\n362:  * event. A tool the runtime's table does not name is not an event either: the facts\n363:  * scored are reads, writes, shell steps and skill loads, and a plan update would\n364:  * only sit between them.\n365:  *\n366:  * @param {Array<object>} records - Neutral records from `loadSession`.\n367:  * @param {string} runtime - The measured runtime whose table applies.\n368:  * @returns {Array<{seq: number, kind: string, path: string|null, command: string|null, text: string|null}>}\n369:  * @throws {TypeError} When the runtime has no table. An empty stream would score a\n370:  *   session as clean behaviour it never showed.\n371:  */\n372: export function normalize(records, runtime) {\n373:   const table = tableFor(runtime);\n374:   const events = [];\n375: \n376:   for (const record of records ?? []) {\n377:     if (!record || typeof record !== 'object') continue;\n378:     const blocks = Array.isArray(record.content) ? record.content : [];\n379: \n380:     for (const block of blocks) {\n381:       if (!block || typeof block !== 'object') continue;\n382: \n383:       if (block.type === 'text') {\n384:         if (record.role === 'assistant' && typeof block.text === 'string' && block.text.trim()) {\n385:           addEvent(events, 'text', { text: block.text });\n386:         } else if (runtime === 'claude' && record.role === 'user' && typeof block.text === 'string') {\n[Output tr