nsions\": [\n    \"correctness\",\n    \"security\",\n    \"traceability\",\n    \"maintainability\"\n  ],\n  \"reviewFocus\": \"Confirming round 5b of code review pass five of command surfacing. Read review/review-brief-5b.txt first and follow it. Review the files in review/review-scope-5b.txt whose area is accuracy-runner, plus docs that describe them. Each finding is P0, P1 or P2 with file:line and a concrete input. Check that the shell write reader misses no in-place edit, the COMMAND reader reads only a line the model printed as its own, the arena builder refuses a dirty source, a stale build, an escaping or absolute link and answers a failed check with a JSON line, a live turn checks for a remote every turn and has no network push, the kill-switch names agree in code and docs, and docs agree with code. Never open command-prompts.jsonl, holdout-prompts.jsonl or behaviour-fresh-prompts.jsonl except through jq del(.prompt). Change no code and write only inside the lineage folder.\",\n  \"reviewScopeFiles\": [\n    \".skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/README.md\",\n    \".skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/command-offer.mjs\",\n    \".skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/prepare-behaviour-arena.mjs\",\n    \".skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/run-command-behaviour.mjs\",\n    \".skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/score-command-transcripts.mjs\",\n    \".skilled/skills/system-skill-advisor/runtime/tests/command-behaviour-guards.vitest.ts\",\n    \".skilled/skills/system-skill-advisor/runtime/tests/command-offer.vitest.ts\",\n    \".skilled/skills/system-skill-advisor/runtime/tests/command-transcript-score.vitest.ts\"\n  ],\n  \"resource_map_present\": false,\n  \"resource_map\": {\n    \"emit\": true\n  },\n  \"severityThreshold\": \"P2\",\n  \"crossReference\": {\n    \"core\": [\n      \"spec_cod