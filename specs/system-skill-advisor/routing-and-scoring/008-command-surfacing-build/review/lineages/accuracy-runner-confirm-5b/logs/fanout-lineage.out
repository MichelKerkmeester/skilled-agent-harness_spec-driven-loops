ery\n433: // `cp` accepts the flag.\n434: export function copyArgs(platform) {\n435:   return platform === 'darwin' ? ['-Rc'] : ['-R'];\n436: }\n437: \n438: function runCp(sourcePath, destParent) {\n439:   const result = spawnSync('cp', [...copyArgs(process.platform), sourcePath, destParent], { encoding: 'utf8' });\n440:   if (result.error) throw new StepFailure('copy_failed', `${sourcePath}: ${result.error.message}`);\n441:   if (result.status !== 0) throw new StepFailure('copy_failed', `${sourcePath}: ${(result.stderr ?? '').trim()}`);\n442: }\n443: \n444: // A symlink is stamped through the link itself, because its target may live\n445: // outside the arena and is not this copy's to change.\n446: function stampPath(path, time) {\n447:   if (lstatSync(path).isSymbolicLink()) {\n448:     lutimesSync(path, time, time);\n449:     return;\n450:   }\n451:   utimesSync(path, time, time);\n452: }\n453: \n454: // Only a build tree is stamped. The guard reads the timestamp of a dist entry,\n455: // and neither a dependency tree nor a database file is watched.\n456: function stampBuildTree(path) {\n457:   const time = new Date();\n458:   for (const entry of readdirSync(path, { withFileTypes: true })) {\n459:     const child = join(path, entry.name);\n460:     if (entry.isDirectory()) stampBuildTree(child);\n461:     else stampPath(child, time);\n462:   }\n463:   stampPath(path, time);\n464: }\n465: \n466: // The clonefile flag is macOS only, and on the same volume it keeps the copy\n467: // cheap. The walk only happens where a dotenv file is actually present, so the\n468: // common tree is one `cp` call rather than one call per file.\n469: function copyPath(sourcePath, destPath) {\n470:   const isDirectory = lstatSync(sourcePath).isDirectory();\n471:   if (!isDirectory || !holdsDotenv(sourcePath)) {\n472:     mkdirSync(dirname(destPath), { recursive: true });\n473:     runCp(sourcePath, dirname(destPath));\n474:     return;\n475:   }\n476:   mkdirSync(destPath, { recursive: