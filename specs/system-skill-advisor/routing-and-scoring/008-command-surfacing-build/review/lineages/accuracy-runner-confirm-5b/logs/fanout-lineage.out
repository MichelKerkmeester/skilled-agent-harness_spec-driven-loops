ctive = (detail.disposition || detail.status || 'active') === 'active';\n1080:        status: isActive ? 'active' : 'resolved',\n1374:    jsonOut({ status: 'ok', message: 'no lineages directory — nothing to merge', merged: 0 });\n1390:    jsonOut({ status: 'ok', message: 'no lineage subdirs found', merged: 0 });\n1562:    status: 'ok',\n1573:      ? { merged_verdict: mergedRegistry.mergedVerdict, active_p0: mergedRegistry.activeP0, active_p1: mergedRegistry.activeP1, failed_required_gate_ids: mergedRegistry.failedRequiredGateIds }\n1585:      status: 'error',\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"cd /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research && sed -n '1400,1450p' .skilled/skills/system-deep-loop/runtime/scripts/fanout-merge.cjs; echo ===; grep -n \\\"function lineageVerdict\\\\|activeP0\\\\|terminalStop\\\\|status\\\" .skilled/skills/system-deep-loop/runtime/scripts/fanout-merge.cjs | sed -n '1,25p'\"}"},"time":{"start":1794782007886,"end":1794782008932}}}}
