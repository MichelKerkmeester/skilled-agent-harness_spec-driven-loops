34:   }\n135:   return options;\n136: }\n137: \n138: // ───────────────────────────────────────────────────────────────\n139: // 5. GIT HELPERS\n140: // ───────────────────────────────────────────────────────────────\n141: \n142: function git(args, cwd) {\n143:   const result = spawnSync('git', [...GIT_PREFIX, ...args], { cwd, encoding: 'utf8' });\n144:   if (result.error) throw new StepFailure('spawn_failed', result.error.message);\n145:   return result;\n146: }\n147: \n148: function gitText(args, cwd, code) {\n149:   const result = git(args, cwd);\n150:   if (result.status !== 0) throw new StepFailure(code, (result.stderr ?? '').trim());\n151:   return result.stdout;\n152: }\n153: \n154: function headOf(cwd, code) {\n155:   const head = gitText(['rev-parse', 'HEAD'], cwd, code).trim();\n156:   if (head === '') throw new StepFailure(code, `no HEAD in ${cwd}`);\n157:   return head;\n158: }\n159: \n160: // Whether git would leave a path out of a checkout decides whether a clone\n161: // already holds it, so ignore rules are asked rather than guessed from a name.\n162: function isIgnored(cwd, relPath) {\n163:   return git(['check-ignore', '-q', '--', relPath], cwd).status === 0;\n164: }\n165: \n166: // ───────────────────────────────────────────────────────────────\n167: // 6. DESTINATION CHECKS\n168: // ───────────────────────────────────────────────────────────────\n169: \n170: function pathExists(path) {\n171:   try {\n172:     lstatSync(path);\n173:     return true;\n174:   } catch {\n175:     return false;\n176:   }\n177: }\n178: \n179: function nearestExistingAncestor(path) {\n180:   let current = path;\n181:   while (!existsSync(current) && dirname(current) !== current) current = dirname(current);\n182:   return current;\n183: }\n184: \n185: function isInsideRepository(path) {\n186:   return git(['rev-parse', '--show-toplevel'], path).status === 0;\n187: }\n188: \n189: // ───────────────────────────────────────────────────────────────\n190: // 7. SOURCE CHECKS\