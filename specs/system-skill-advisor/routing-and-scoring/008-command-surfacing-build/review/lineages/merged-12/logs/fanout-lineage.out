/doctor/scripts/tests/doctor-install-contract.test.cjs\",\n   \"type\": \"node\"\n  },\n  {\n   \"id\": \"finding:FIX11-P1-001\",\n   \"kind\": \"FINDING\",\n   \"label\": \"A quoted command in an \n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"ration\":1,\"timestamp\":\"2026-11-16T17:58:44.253Z\"}\n{\n \"agent_definition_loaded\": true,\n \"dimensions\": [\n  \"correctness\"\n ],\n \"durationMs\": 540000,\n \"filesReviewed\": [\n  \".skilled/skills/system-skill-advisor/runtime/lib/command-attach.ts:427\",\n  \".skilled/skills/system-skill-advisor/runtime/tests/command-attach-guards.vitest.ts:156\",\n  \".skilled/commands/doctor/assets/doctor-install-presentation.txt:78\",\n  \".skilled/commands/doctor/assets/doctor-install.yaml:58\",\n  \".skilled/commands/doctor/scripts/tests/doctor-install-contract.test.cjs:241\"\n ],\n \"findingDetails\": [\n  {\n   \"affectedSurfaceHints\": [\n    \"MODE_COMMANDS[sk-doc][sk-create-readme]\",\n    \".skilled/skills/system-skill-advisor/runtime/lib/command-attach.ts:259\",\n    \".skilled/skills/system-skill-advisor/runtime/lib/command-attach.ts:504\"\n   ],\n   \"case\": \"Prompt do not run '/create:agent' or '/create:readme', just explain them; commandOnlyMentioned returns false for /create:readme and attachCommand returns /create:readme.\",\n   \"dimension\": \"correctness\",\n   \"file\": \".skilled/skills/system-skill-advisor/runtime/lib/command-attach.ts:427\",\n   \"findingClass\": \"correctness: incomplete single-quote normalization in the shared mention guard\",\n   \"id\": \"FIX11-P1-001\",\n   \"scopeProof\": \"The fold at :427, the or-list grammar at :385, the lead match at :438-442, both offer call sites at :259 and :504, and the quote test table at tests/command-attach-guards.vitest.ts:172-184 are this area own changed surface.\",\n   \"severity\": \"P1\",\n   \"title\": \"A quoted command in an or-list hides the refusal for every later command\"\n  }\n ],\n \"findingsCount\": 1,\n \"findingsNew\": [\n  \"FIX11-P1-001\"\n ],\n \"findingsSummary\": {\n  \"P0\": 0,\n  \"P1\": 1,\n  \"P2\": 0\n },\n \"focus\": \"correctness\",\n \"generation\": 1,\n \"graphEvents\": [\n  {\n   \"id\": \"dimension:correctness\",\n   \"kind\": \"DIMENSION\",\n   \"label\": \"correctness\",\n   \"type\": \"node\"\n  },\n  {\n   \"id\": \"file:.skilled/skills/system-skill-advisor/runtime/lib/command-attach.ts\",\n   \"kind\": \"FILE\",\n   \"label\": \".skilled/skills/system-skill-advisor/runtime/lib/command-attach.ts\",\n   \"type\": \"node\"\n  },\n  {\n   \"id\": \"file:.skilled/skills/system-skill-advisor/runtime/tests/command-attach-guards.vitest.ts\",\n   \"kind\": \"FILE\",\n   \"label\": \".skilled/skills/system-skill-advisor/runtime/tests/command-attach-guards.vitest.ts\",\n   \"type\": \"node\"\n  },\n  {\n   \"id\": \"file:.skilled/commands/doctor/assets/doctor-install-presentation.txt\",\n   \"kind\": \"FILE\",\n   \"label\": \".skilled/commands/doctor/assets/doctor-install-presentation.txt\",\n   \"type\": \"node\"\n  },\n  {\n   \"id\": \"file:.skilled/commands/doctor/assets/doctor-install.yaml\",\n   \"kind\": \"FILE\",\n   \"label\": \".skilled/commands/doctor/assets/doctor-install.yaml\",\n   \"type\": \"node\"\n  },\n  {\n   \"id\": \"file:.skilled/commands/doctor/scripts/tests/doctor-install-contract.test.cjs\",\n   \"kind\": \"FILE\",\n   \"label\": \".skilled/commands/doctor/scripts/tests/doctor-install-contract.test.cjs\",\n   \"type\": \"node\"\n  },\n  {\n   \"id\": \"finding:FIX11-P1-001\",\n   \"kind\": \"FINDING\",\n   \"label\": \"A quoted command in an \n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"cd /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research && head -1 specs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/review/lineages/fixes-11/deep-review-state.jsonl | tail -c 50; sed -n '2p' specs/sy