     initialReleaseReadinessState: \"not-assessed\",\n      ...(topic === null ? {} : { topic }),\n    },\n  }));\n' \"specs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/review/lineages/attach-config-7/deep-review-config.json\" \".skilled/commands/deep/assets/deep-review.yaml\" > \"$EVENT_FILE\"\nnode \"$GATEWAY\" --mode review --run-directory \"specs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/review/lineages/attach-config-7\" --event-json \"$EVENT_FILE\"\nSTATUS=$?\nrm -f \"$EVENT_FILE\"\necho \"GATEWAY_EXIT=$STATUS\"\nexit \"$STATUS\""},"output":"{\"ok\":true,\"receipt\":{\"ledger_id\":\"deep-review-ledger\",\"sequence\":1,\"event_id\":\"event-b380eb70-2bfa-4f92-aaf5-3d8ffdd8a4f2\",\"event_type\":\"deep-review.ledger.run-initialized\",\"event_version\":1,\"stream_id\":\"deep-review-ledger\",\"stream_sequence\":1,\"committed_at\":\"2026-11-16T12:05:49.810Z\",\"canonicalEventHash\":\"c85cc2eb82940971122fad66d989dcf28346a22fab3e6036903938017a8c4f01\",\"recordHash\":\"4adca1d9ccd5607b62583acb81b1e32d506aadc163cebdb7d806e28b3f136e65\",\"authorizationRef\":{\"audit_ledger_id\":\"deep-review-audit-ledger\",\"audit_sequence\":2,\"audit_record_hash\":\"c08141951dc75b9059e8a83b45147b5ec8bf216a6dce06a993137b0b407f1de7\",\"decision_id\":\"decision-167f680c-1fd3-432d-b583-e9013d4275bb\",\"decision_digest\":\"42ac7b14fbb6fa7478ffe6621821fe3b0153e1a453f8bfecd97ccd9d3c12f461\",\"request_digest\":\"227f648c43710d0246bc163810f8118bf6f52fe3fb5552e64723f4d268e7bc16\",\"policy_digest\":\"883e5d03486b26c23ecdb48a893d8b0db0d8e2e7125e0847705bfd4a2b1a4500\",\"authority_epoch\":1,\"fence_token\":1},\"ledgerId\":\"deep-review-ledger\",\"eventId\":\"event-b380eb70-2bfa-4f92-aaf5-3d8ffdd8a4f2\",\"eventType\":\"deep-review.ledger.run-initialized\",\"eventVersion\":1,\"streamId\":\"deep-review-ledger\",\"streamSequence\":1,\"committedAt\":\"2026-11-16T12:05:49.810Z\"},\"projectionRefreshed\":true,\"projectionError\":null}\nGATEWAY_EXIT=0\n","tit