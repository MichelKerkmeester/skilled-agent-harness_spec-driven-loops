;\n.skilled/skills/system-deep-loop/runtime/scripts/verify-iteration.cjs:377:  if (config && (isNonEmptyString(config.fanout_lineage_artifact_dir)\n.skilled/skills/system-deep-loop/runtime/scripts/fanout-run.cjs:1546: * with config.fanout_lineage_artifact_dir overriding step_resolve_artifact_root.\n.skilled/skills/system-deep-loop/runtime/scripts/fanout-run.cjs:1660:    `  config.fanout_lineage_artifact_dir: ${lineageDir}`,\n.skilled/skills/system-deep-loop/runtime/scripts/fanout-run.cjs:1718:    `config.fanout_lineage_artifact_dir override — do NOT run the resolveArtifactRoot node`,\n.skilled/skills/system-deep-loop/runtime/scripts/fanout-run.cjs:1799:    `config.fanout_lineage_artifact_dir: ${lineageDir}`,\n.skilled/skills/system-deep-loop/runtime/scripts/compile-command-contracts.cjs:102:        'config.fanout_lineage_artifact_dir',\n---\n.skilled/skills/system-deep-loop/runtime/tests/unit/verify-iteration.vitest.ts:837:    fs.writeFileSync(path.join(dir, 'invocation-metadata.json'), `${JSON.stringify({ effectiveConfig, invocationFingerprint: 'inv:test' })}\\n`);\n.skilled/skills/system-deep-loop/runtime/tests/unit/verify-iteration.vitest.ts:856:    expect(missing.detail).toContain('invocation-metadata.json');\n.skilled/skills/system-deep-loop/runtime/tests/unit/verify-iteration.vitest.ts:861:    fs.writeFileSync(path.join(dir, 'invocation-metadata.json'), '{not json\\n');\n.skilled/skills/system-deep-loop/runtime/tests/unit/fanout-run.vitest.ts:3692:      readFileSync(join(baseDir, 'lineages', 'default-sandbox', 'invocation-metadata.json'), 'utf8'),\n.skilled/skills/system-deep-loop/runtime/tests/unit/fanout-merge.vitest.ts:1873:  it('reads kind and model from invocation-metadata.json for attribution and lineageExecutors', async () => {\n.skilled/skills/system-deep-loop/runtime/tests/unit/fanout-merge.vitest.ts:1887:      join(lineageDir, 'invocation-metadata.json'),\n.skilled/skills/system-deep-loop/runtime/tests/unit/fanout-merge.vitest.ts:1912:  it('degrades 