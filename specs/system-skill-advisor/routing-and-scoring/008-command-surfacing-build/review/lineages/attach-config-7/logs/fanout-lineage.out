x', () => {\n     expect(typedCommandIn('/deep:review:automation notes')).toBeUndefined();\n     expect(typedCommandIn('/create:readme:draft')).toBeUndefined();\n+    expect(typedCommandIn('/speckit:complete:with-everything now')).toBeUndefined();\n+    expect(typedCommandIn('/speckit:complete:auto:draft now')).toBeUndefined();\n   });\n \n   it('attaches the deep-loop command typed with its mode suffix', () => {\ndiff --git a/.skilled/skills/system-skill-advisor/runtime/tests/command-behaviour-guards.vitest.ts b/.skilled/skills/system-skill-advisor/runtime/tests/command-behaviour-guards.vitest.ts\nindex ecaea14d10a..bd7bc7471c3 100644\n--- a/.skilled/skills/system-skill-advisor/runtime/tests/command-behaviour-guards.vitest.ts\n+++ b/.skilled/skills/system-skill-advisor/runtime/tests/command-behaviour-guards.vitest.ts\n@@ -779,6 +779,11 @@ describe('arena builder', () => {\n         'init',\n       ]);\n       expect(committed.status).toBe(0);\n+      // The fixture only guards the overflow while its listing passes the buffer a\n+      // spawnSync call starts with, so the premise is checked, not assumed.\n+      const listing = spawnSync('git', ['ls-files', '-z'], { cwd: source, maxBuffer: 64 * 1024 * 1024 });\n+      expect(listing.status).toBe(0);\n+      expect(listing.stdout.length).toBeGreaterThan(1024 * 1024);\n       mkdirSync(join(source, 'dist'));\n       writeFileSync(join(source, 'dist', 'out.js'), 'built from v1\\n');\n       const arena = join(root, 'arena');\ndiff --git a/.skilled/skills/system-skill-advisor/runtime/tests/doctor-brief-render.vitest.ts b/.skilled/skills/system-skill-advisor/runtime/tests/doctor-brief-render.vitest.ts\nindex 39f1586604f..628a71c3fab 100644\n--- a/.skilled/skills/system-skill-advisor/runtime/tests/doctor-brief-render.vitest.ts\n+++ b/.skilled/skills/system-skill-advisor/runtime/tests/doctor-brief-render.vitest.ts\n@@ -89,7 +89,7 @@ describe('doctor command brief', () => {\n       { skill: 'sk-code', kind: 'skill', confidence: 0.82, uncertainty: 0.2 },\n       { skill: 'sk-git', kind: 'skill', confidence: 0.82, uncertainty: 0.2 },\n       { skill: 'command-doctor-update', kind: 'command', confidence: 0.82, uncertainty: 0.22 },\n-    ])) ?? '';\n+    ]), { childSession: false }) ?? '';\n \n     expect(rendered).toContain('\\nAlso: /doctor:update (ask)');\n     expect(rendered.startsWith('Advisor: live; use sk-code 0.82/0.20 pass.')).toBe(true);\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"diff --git a/.skilled/skills/system-skill-advisor/runtime/tests/command-attach-guards.vitest.ts b/.skilled/skills/system-skill-advisor/runtime/tests/command-attach-guards.vitest.ts\nindex 962c1eb7b8c..15d0f9f4c12 100644\n--- a/.skilled/skills/system-skill-advisor/runtime/tests/command-attach-guards.vitest.ts\n+++ b/.skilled/skills/system-skill-advisor/runtime/tests/command-attach-guards.vitest.ts\n@@ -436,11 +436,20 @@ describe('typed command boundaries', () => {\n     expect(typedCommandIn('/deep:review:auto review the diff')).toBe('/deep:review');\n     expect(typedCommandIn('/speckit:plan:confirm add a login page')).toBe('/speckit:plan');\n     expect(typedCommandIn('/speckit:implement:autopilot')).toBe('/speckit:implement');\n+    expect(typedCommandIn('/speckit:implement:unattended the login spec')).toBe('/speckit:implement');\n+  });\n+\n+  it('reads a command typed with a with-modifier or a chain of suffixes', () => {\n+    expect(typedCommandIn('/speckit:complete:with-research the login spec')).toBe('/speckit:complete');\n+    expect(typedCommandIn('/speckit:complete:with-context the login spec')).toBe('/speckit:complete');\n+    expect(typedCommandIn('/speckit:complete:auto:with-research the login spec')).toBe('/speckit:complete');\n   });\n \n   it('does not read a command followed by an unknown suffix', () => {\n     expect(typedCommandIn('/deep:review:automation notes')).toBeUndefined();\n     expect(typedCommandIn('/create:readme:draft')).toBeUndefined();\n+    expect(typedCommandIn('/speckit:complete:with-everything now')).toBeUndefined();\n+    expect(typedCommandIn('/speckit:complete:auto:draft now')).toBeUndefined();\n   });\n \n   it('attaches the deep-loop command typed with its mode suffix', () => {\ndiff --git a/.skilled/skills/system-skill-advisor/runtime/tests/command-behaviour-guards.vitest.ts b/.skilled/skills/system-skill-advisor/runtime/tests/command-behaviour-guards.vitest.ts\nindex ecaea14d10a..bd7bc7471c3 100644\n--- a/.skilled/skills/system-skill-advisor/runtime/tests/command-behaviour-guards.vitest.ts\n+++ b/.skilled/skills/system-skill-advisor/runtime/tests/command-behaviour-guards.vitest.ts\n@@ -779,6 +779,11 @@ describe('arena builder', () => {\n         'init',\n       ]);\n       expect(committed.status).toBe(0);\n+      // The fixture only guards the overflow while its listing passes the buffer a\n+      // spawnSync call starts with, so the premise is checked, not assumed.\n+      const listing = spawnSync('git', ['ls-files', '-z'], { cwd: source, maxBuffer: 64 * 1024 * 1024 });\n+      expect(listing.status).toBe(0);\n+      expect(listing.stdout.length).toBeGreaterThan(1024 * 1024);\n       mkdirSync(join(source, 'dist'));\n       writeFileSync(join(source, 'dist', 'out.js'), 'built from v1\\n');\n       const arena = join(root, 'arena');\ndiff --git a/.skilled/skills/system-skill-advisor/runtime/tests/doctor-brief-render.vitest.ts b/.skilled/skills/system-skill-advisor/runtime/tests/doctor-brief-render.vitest.ts\nindex 39f1586604f..628a71c3fab 100644\n--- a/.skilled/skills/system-skill-advisor/runtime/tests/doctor-brief-render.vitest.ts\n+++ b/.skilled/skills/system-skill-advisor/runtime/tests/doctor-brief-render.vitest.ts\n@@ -89,7 +89,7 @@ describe('doctor command brief', () => {\n       { skill: 'sk-code', kind: 'skill', confidence: 0.82, uncertainty: 0.2 },\n       { skill: 'sk-git', kind: 'skill', confidence: 0.82, uncertainty: 0.2 },