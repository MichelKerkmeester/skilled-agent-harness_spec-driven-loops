\":{\\\"runId\\\":\\\"fanout-attach-config-7-1794829999759-g4q8yp\\\",\\\"sessionId\\\":\\\"fanout-attach-config-7-1794829999759-g4q8yp\\\",\\\"generation\\\":1,\\\"iterationId\\\":\\\"iteration-3\\\"},\\\"data\\\":{\\\"stopReason\\\":\\\"maxIterationsReached\\\",\\\"gateResults\\\":[{\\\"gateId\\\":\\\"evidence\\\",\\\"status\\\":\\\"pass\\\",\\\"reasonCode\\\":\\\"all-findings-cited\\\",\\\"evidenceDigest\\\":\\\"063c8560c2f52340d92731e17ad2567e9e50ec2a90efa1dbf029a9470e817626\\\"},{\\\"gateId\\\":\\\"scope\\\",\\\"status\\\":\\\"pass\\\",\\\"reasonCode\\\":\\\"all-findings-in-scope\\\",\\\"evidenceDigest\\\":\\\"99c08270da525834b9b6c04064022208559447cdad61c4618e1557c78e3ab48c\\\"},{\\\"gateId\\\":\\\"coverage\\\",\\\"status\\\":\\\"fail\\\",\\\"reasonCode\\\":\\\"coverage-too-young\\\",\\\"evidenceDigest\\\":\\\"e36fde0a81d620a773639d76778ef0e4057e657817fb65cac5c4c04e22f76aac\\\"}],\\\"failedRequiredGateIds\\\":[\\\"coverage\\\"],\\\"appendPosition\\\":3}}\\n\",\"path\":\"specs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/review/lineages/attach-config-7/prompts/synthesis-terminal-gates.json\"}"},"time":{"start":1794831481625,"end":1794831483842}}}}
