 Record<string, string> = {},\n69: ): ReturnType<typeof spawnSync> {\n70:   return spawnSync(process.execPath, [SCRIPT, ...args], {\n71:     encoding: 'utf8',\n72:     timeout: 20_000,\n73:     env: { ...process.env, ...env },\n74:   });\n75: }\n76: \n77: describe('brief cost measurement', () => {\n78:   it('measures the live rows and leaves the stale row out of the summary', () => {\n79:     const root = makeRoot();\n80:     try {\n81:       const result = runScript(['--root', root]);\n82: \n83:       expect(result.status).toBe(0);\n84:       const summary = JSON.parse(String(result.stdout));\n85:       expect(summary.liveRows).toBe(1);\n86:       expect(summary.rows).toHaveLength(2);\n87:       const stale = summary.rows.find((row: { id: string }) => row.id === 'cost-stale');\n88:       expect(stale.live).toBe(false);\n89:       expect(summary.medianHeadBytes).toBe(Buffer.byteLength(LIVE_HEAD, 'utf8'));\n90:       expect(summary.medianBytes).toBe(Buffer.byteLength(LIVE_CONTEXT, 'utf8'));\n91:     } finally {\n92:       rmSync(root, { recursive: true, force: true });\n93:     }\n94:   });\n95: \n96:   it('refuses a selection whose only row is stale', () => {\n97:     const root = makeRoot();\n98:     try {\n99:       const result = runScript(['--root', root, '--rows', 'cost-stale']);\n[Output truncated. Continue reading with offset: 100]"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"limit\":70,\"offset\":30,\"path\":\".skilled/skills/system-skill-advisor/runtime/tests/measure-brief-cost.vitest.ts\"}"},"time":{"start":1794830406806,"end":1794830407782}}}}
