tem-deep-loop/runtime/scripts/verify-iteration.cjs:372:// the per-iteration dispatch steps, the pre-dispatch executor audit among them, as\n.skilled/skills/system-deep-loop/runtime/scripts/verify-iteration.cjs:373:// already satisfied. No executor row is written there, so a lineage is checked\n.skilled/skills/system-deep-loop/runtime/scripts/verify-iteration.cjs:386:  return Boolean(record) && typeof record.executor === 'object' && record.executor !== null && !Array.isArray(record.executor);\n.skilled/skills/system-deep-loop/runtime/scripts/verify-iteration.cjs:390:// of the lineage, and its effectiveConfig.kind is the executor it launched. Null\n.skilled/skills/system-deep-loop/runtime/scripts/verify-iteration.cjs:402:// The pre-dispatch audit records a non-native executor before the leaf runs. On a\n.skilled/skills/system-deep-loop/runtime/scripts/verify-iteration.cjs:415:      ? `lineage iteration ${iteration} ran under executor kind '${kind}' but ${INVOCATION_METADATA} names '${launched}'`\n.skilled/skills/system-deep-loop/runtime/scripts/verify-iteration.cjs:416:      : `lineage iteration ${iteration} ran under executor kind '${kind}' but ${INVOCATION_METADATA} in ${artifactDir} is missing or names no executor`;\n.skilled/skills/system-deep-loop/runtime/scripts/verify-iteration.cjs:424:  return `iteration ${iteration} ran under executor kind '${kind}' but neither its iteration record nor its iteration_start row in ${STATE_LOG_BY_LOOP[loopType]} names an executor`;\n.skilled/skills/system-deep-loop/runtime/scripts/verify-iteration.cjs:435:// The audited dispatch wrapper returns 0 for every executor outcome and records\n.skilled/skills/system-deep-loop/runtime/scripts/verify-iteration.cjs:439:// for that iteration says whether the executor failed, and how.\n.skilled/skills/system-deep-loop/runtime/scripts/verify-iteration.cjs:454:  const { exitStatus, signal, executor } = latest.receipt.facts;\n.skilled/skills/system-deep-loop/runtime/scripts/verify-iteration.cjs