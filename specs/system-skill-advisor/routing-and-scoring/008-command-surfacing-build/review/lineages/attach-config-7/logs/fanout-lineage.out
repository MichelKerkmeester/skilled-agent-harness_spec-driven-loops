gitRun(['add', '-A']).status).toBe(0);\n770:       const committed = gitRun([\n771:         '-c',\n772:         'user.name=t',\n773:         '-c',\n774:         'user.email=t@example.invalid',\n775:         '-c',\n776:         'core.hooksPath=/dev/null',\n777:         'commit',\n778:         '-qm',\n779:         'init',\n780:       ]);\n781:       expect(committed.status).toBe(0);\n782:       // The fixture only guards the overflow while its listing passes the buffer a\n783:       // spawnSync call starts with, so the premise is checked, not assumed.\n784:       const listing = spawnSync('git', ['ls-files', '-z'], { cwd: source, maxBuffer: 64 * 1024 * 1024 });\n785:       expect(listing.status).toBe(0);\n786:       expect(listing.stdout.length).toBeGreaterThan(1024 * 1024);\n787:       mkdirSync(join(source, 'dist'));\n788:       writeFileSync(join(source, 'dist', 'out.js'), 'built from v1\\n');\n789:       const arena = join(root, 'arena');\n790: \n791:       const built = build(source, arena);\n792: \n793:       expect(built.status).toBe(0);\n794:       expect(JSON.parse(built.stdout).ok).toBe(true);\n795:     } finally {\n796:       rmSync(root, { recursive: true, force: true });\n797:     }\n798:   });\n799: \n800:   // A build compiles sources that sit outside the folder holding its output, and the\n801:   // tsconfig beside the build is what names them. A committed edit there leaves the\n802:   // build stale while every tracked file in its own folder still predates it.\n803:   const makeReachingSource = (root: string) => {\n804:     const source = join(root, 'source');\n805:     mkdirSync(join(source, 'skill', 'runtime'), { recursive: true });\n806:     mkdirSync(join(source, 'skill', 'hooks', 'claude'), { recursive: true });\n807:     const gitRun = (args: string[]) => spawnSync('git', args, { cwd: source, encoding: 'utf8' });\n808:     const identity = [\n809:       '-c',\n810:       'user.name=t',\n811:       '-c',\n812:       'user.email=t@example.invalid