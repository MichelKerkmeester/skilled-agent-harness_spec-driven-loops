rage\"],\"gateResults\":[{\"evidenceDigest\":\"063c8560c2f52340d92731e17ad2567e9e50ec2a90efa1dbf029a9470e817626\",\"gateId\":\"evidence\",\"reasonCode\":\"all-findings-cited\",\"status\":\"pass\"},{\"evidenceDigest\":\"99c08270da525834b9b6c04064022208559447cdad61c4618e1557c78e3ab4\n{\"status\":\"ok\",\"verdict\":\"FAIL\",\"has_advisories\":false,\"active_p0\":0,\"active_p1\":0,\"active_p2\":2,\"search_debt\":0,\"failed_required_gate_ids\":[\"coverage\"]}\nVERDICT_EXIT=0\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"grep -c '' specs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/review/lineages/attach-config-7/deep-review-state.jsonl; tail -1 specs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/review/lineages/attach-config-7/deep-review-state.jsonl | head -c 400; echo; node .skilled/skills/system-deep-loop/runtime/scripts/review-verdict.cjs --registry-path \\\"specs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/review/lineages/attach-config-7/deep-review-findings-registry.json\\\" --state-log \\\"specs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/review/lineages/attach-config-7/deep-review-state.jsonl\\\"; echo \\\"VERDICT_EXIT=$?\\\"\"}"},"time":{"start":1794831497199,"end":1794831498658}}}}
