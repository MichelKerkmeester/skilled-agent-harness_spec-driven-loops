kit:plan': { policy: 'start', ownerSkillId: 'system-spec-kit', scorerRow: true },\n184:   '/speckit:resume': { policy: 'start', ownerSkillId: 'system-spec-kit', scorerRow: true },\n185:   '/speckit:save': { policy: 'start', ownerSkillId: 'system-spec-kit', scorerRow: true },\n186:   '/speckit:search': { policy: 'run', ownerSkillId: 'system-spec-kit', scorerRow: true },\n187: };\n188: // END GENERATED COMMAND ROWS\n189: \n190: // The row for an id a recommendation carries, or undefined when that id names no\n191: // command. Own-key lookup because the table is generated data, so an inherited\n192: // name such as `constructor` must not resolve to a row nobody declared.\n193: export function commandRowFor(id: string): CommandRow | undefined {\n194:   return Object.hasOwn(COMMAND_ROWS, id) ? COMMAND_ROWS[id] : undefined;\n195: }\n196: \n197: // A typed command is the reader's own wording, so it counts only where a command\n198: // can start and where it ends on a boundary. That keeps a path such as\n199: // `docs/create:goal.md` and a prefix such as `/create:sk` from reading as a\n200: // command, and the longest key wins so `/group:name-parent` is never reduced to\n201: // its `/group:name` prefix. A dot or a slash followed by a word character\n202: // continues a file name or a path, while a sentence-ending period does not.\n203: // A mode suffix and a `:with-*` modifier are how the command documents say to\n204: // type a command, so they end the command name the way a space does. The\n205: // argument hints chain them, as in `:auto:with-research`, so a run of them\n206: // counts as one suffix.\n207: const COMMAND_START_BOUNDARY = /[\\s`'\"(]/;\n208: const COMMAND_CONTINUATION = /[a-z0-9_:-]/;\n209: const WORD_CHARACTER = /[a-z0-9_]/;\n210: const MODE_SUFFIX = /^(?::(?:auto|confirm|autopilot|unattended|with-(?:context|phases|research)))+(?![a-z0-9_:-])/;\n211: \n212: // A command that was renamed is still typed from habit. Its old name reads as\n213: // the command that replaced it, so the reader lands on the live workflow and\n214: // not on whatever skill the leftover words happen to score for. The old name\n215: // gets no command file of its own: this table is the only place it lives.\n216: const RETIRED_COMMANDS: Readonly<Record<string, string>> = {\n217:   '/create:skill': '/create:sk-skill',\n218: };\n219: \n220: export function typedCommandIn(prompt: string): string | undefined {\n221:   const lowered = prompt.toLowerCase();\n222:   let found: string | undefined;\n223:   for (const key of [...Object.keys(TRACKED_COMMANDS), ...Object.keys(RETIRED_COMMANDS)]) {\n224:     let index = lowered.indexOf(key);\n225:     while (index !== -1) {\n226:       const before = index === 0 ? '' : lowered[index - 1];\n227:       const after = lowered[index + key.length] ?? '';\n228:       const next = lowered[index + key.length + 1] ?? '';\n229:       const startsAtBoundary = before === '' || COMMAND_START_BOUNDARY.test(before);\n230:       const hasModeSuffix = MODE_SUFFIX.test(lowered.slice(index + key.length));\n231:       const continuesName =\n232:         !hasModeSuffix\n233:         && (COMMAND_CONTINUATION.test(after) || ((after === '/' || after === '.') && WORD_CHARACTER.test(next)));\n234:       const endsAtBoundary = after === '' || !continuesName;\n235:       if (startsAtBoundary && endsAtBoundary) {\n236:         if (found === undefined || key.length > found.length) found = key;\n237:         break;\n238:       }\n239:       index = lowered.indexOf(key, index + 1);\n240:     }\n241:   }\n242:   if (found !== undefined && Object.hasOwn(RETIRED_COMMANDS, found)) return RETIRED_COMMANDS[found];\n243:   return found;\n244: }\n245: \n246: // A typed command travels on the recommendation that leads, so it is delivered\n247: // only when the leading skill owns the command or carries the same command row.\n248: // A leading skill unrelated to the command must not carry it.\n249: export interface TypedCommand {\n250:   readonly command: string;\n251:   readonly policy: 'run' | 'start' | 'ask';\n252:   readonly ownerSkillId: string;\n253: }\n254: \n255: export function typedCommandForTop(topSkillId: string, prompt: string): TypedCommand | undefined {\n256:   const command = typedCommandIn(prompt);\n257:   if (command === undefined || !Object.hasOwn(TRACKED_COMMANDS, command)) return undefined;\n258:   if (commandOnlyMentioned(prompt, command)) return undefined;\n259:   const row = TRACKED_COMMANDS[command];\n260:   const sameCommandRow = commandRowFor(topSkillId)?.command === command;\n261:   if (topSkillId !== row.ownerSkillId && !sameCommandRow) return undefined;\n262:   return { command, policy: row.policy, ownerSkillId: row.ownerSkillId };\n263: }\n264: \n265: // Deep-loop commands open a long, multi-pass run, so one attached to a prompt\n266: // that merely mentions the topic spends the reader's budget on work they never\n267: // asked for. The list below is the vocabulary that counts as asking for it, and\n268: // it holds only effort wording: a bare topic word such as `research`, `review`\n269: // or `council` says what to look at, never how far to go, so it never qualifies\n270: // on its own.\n271: //\n272: // The phrases live in a data list, one per line, so the vocabulary a reviewer\n273: // has to judge stays visible and cheap to correct.\n274: export const DEPTH_WORDING: readonly string[] = [\n275:   'in depth',\n276:   'deep dive',\n277:   'deep research',\n278:   'deep review',\n279:   'thorough',\n280:   'thoroughly',\n281:   'exhaustive',\n282:   'iteratively',\n283:   'multiple passes',\n284:   'many passes',\n285:   'several passes',\n286:   'ask the council',\n287:   'convene',\n288:   'several models',\n289:   'final verdict',\n290:   'everything you can',\n291: ];\n292: \n293: // A creation workflow scaffolds, reviews and validates a whole document, which is\n294: // the wrong size for a correction inside one. The list below is the vocabulary\n295: // that marks that correction, and a line number points at one the same way.\n296: export const SMALL_EDIT_WORDING: readonly string[] = [\n297:   'typo',\n298:   'typos',\n299:   'spelling',\n300:   'misspelled',\n301:   'misspelling',\n302:   'grammar',\n303:   'punctuation',\n304:   'wording',\n305:   'broken link',\n306:   'broken links',\n307:   'dead link',\n308:   'dead links',\n309:   'one line',\n310:   'single line',\n311: ];\n312: \n313: // A phrase may carry punctuation a regex would read as a metacharacter, so it is\n314: // escaped before it is trusted as a pattern.\n315: function escapePhrase(phrase: string): string {\n316:   return phrase.replace(/[.*+?^${}()|[\\]\\\\]/g, '\\\\$&');\n317: }\n318: \n319: // One alternation over the list keeps the gate a single test per prompt, and the\n320: // boundary markers keep `thorough` from firing inside a longer word while a\n321: // multi-word phrase still has to match as a whole.\n322: const DEPTH_REQUEST = new RegExp(`\\\\b(?:${DEPTH_WORDING.map(escapePhrase).join('|')})\\\\b`);\n323: \n324: // The line alternative is a pattern rather than a phrase, so it is appended raw\n325: // beside the escaped vocabulary instead of being escaped with it.\n326: const SMALL_EDIT_REQUEST = new RegExp(\n327:   `\\\\b(?:${SMALL_EDIT_WORDING.map(escapePhrase).join('|')}|line \\\\d+)\\\\b`,\n328: );\n329: \n[Output truncated. Continue reading with offset: 330]","title":"read","metadata":{"metadata":{"truncated":true},"content":[{"type":"text","text":"Read file .skilled/skills/system-skill-advisor/runtime/lib/command-attach.ts, lines 150-329\n150:   '/doctor:git hooks': { policy: 'ask', ownerSkillId: 'sk-git', scorerRow: true },\n151:   '/doctor:git setup': { policy: 'run', ownerSkillId: 'sk-git', scorerRow: true },\n152:   '/doctor:git standards': { policy: 'ask', ownerSkillId: 'sk-git', scorerRow: true },\n153:   '/doctor:helper': { policy: 'run', ownerSkillId: 'system-skilled-doctor', scorerRow: true },\n154:   '/doctor:install': { policy: 'run', 