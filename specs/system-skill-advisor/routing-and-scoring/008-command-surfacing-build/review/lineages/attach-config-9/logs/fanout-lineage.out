:    '<!-- ANCHOR:graph-convergence -->',\n2418:    '<!-- /ANCHOR:graph-convergence -->',\n2419:    '<!-- ANCHOR:trend -->',\n2428:    '<!-- /ANCHOR:trend -->',\n2429:    '<!-- ANCHOR:corruption-warnings -->',\n2435:    '<!-- /ANCHOR:corruption-warnings -->',\n2436:    '<!-- ANCHOR:search-debt -->',\n2440:    '<!-- /ANCHOR:search-debt -->',\n2441:    '<!-- ANCHOR:next-focus -->',\n2445:    '<!-- /ANCHOR:next-focus -->',\n2446:    '<!-- ANCHOR:active-risks -->',\n2498:    '<!-- /ANCHOR:active-risks -->',\n2516:  const createMissingAnchors = Boolean(options.createMissingAnchors);\n2590:    strategy = updateStrategyContent(strategyContent, registry, iterationFiles, { createMissingAnchors }, records);\n2592:    if (error && error.code === 'MISSING_ANCHOR') {\n2674:  const booleanFlags = new Set(['lenient', 'createMissingAnchors', 'emitResourceMap']);\n2706:      'Usage: node .skilled/skills/system-deep-loop/runtime/scripts/reduce-state.cjs <spec-folder> [--artifact-dir <path>] [--lenient] [--create-missing-anchors] [--emit-resource-map]\\n',\n2716:      createMissingAnchors: Boolean(parsedArgs.createMissingAnchors),\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\": \"cd /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research && grep -n \\\"ANCHOR\\\\|createMissingAnchors\\\\|create-missing-anchors\\\" .skilled/skills/system-deep-loop/runtime/scripts/reduce-state.cjs | head -40\"}"},"time":{"start":1794836563508,"end":1794836563938}}}}
