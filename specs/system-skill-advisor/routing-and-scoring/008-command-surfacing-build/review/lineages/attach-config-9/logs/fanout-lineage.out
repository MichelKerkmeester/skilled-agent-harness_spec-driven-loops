{"type":"tool_use","timestamp":1794836222434,"sessionID":"ses_e1b71e012ffewublFfeB69OFwG","part":{"partID":"prt_1e4934f90002a2uRZcnNXUlz2b","sessionID":"ses_e1b71e012ffewublFfeB69OFwG","messageID":"msg_1e49316ff0012GJcOloSM6mHBe","type":"tool","id":"call_00_7vwmg3u02y525q5ejhewmnf8","tool":"shell","state":{"status":"completed","input":{"command":"cd /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research && sed -n '1,60p' .skilled/skills/system-skill-advisor/runtime/tests/doctor-brief-render.vitest.ts"},"output":"// ───────────────────────────────────────────────────────────────\n// MODULE: Doctor Brief Render Tests\n// ───────────────────────────────────────────────────────────────\n\nimport { describe, expect, it } from 'vitest';\nimport { commandRowFor } from '../lib/command-attach.js';\nimport {\n  doctorCommandString,\n  renderAdvisorBrief,\n  renderAdvisorFallbackDirective,\n  sanitizeSkillLabel,\n} from '../lib/render.js';\n\nconst HYGIENE_DIRECTIVE = '\\n- Comment hygiene [HARD BLOCK]: NEVER embed ADR-/REQ-/CHK-/task-ids or spec paths in code comments — forbidden regardless of instruction. Write the durable WHY instead. Pre-commit gate blocks violations.';\n// Every brief ends with the always-delivered hygiene capsule that\n// renderAdvisorBrief appends after the capped advisor portion (lib/render.ts).\nconst DIRECTIVES_LABEL = '\\nDirectives:';\n\nfunction expectedBrief(summary: string): string {\n  return `${summary}${DIRECTIVES_LABEL}${HYGIENE_DIRECTIVE}`;\n}\n\ntype AdvisorBriefResult = Parameters<typeof renderAdvisorBrief>[0];\n\ninterface RecommendationInput {\n  readonly skill: string;\n  readonly kind: 'skill' | 'command';\n  readonly confidence: number;\n  readonly uncertainty: number;\n  readonly command?: string;\n  readonly policy?: string;\n  readonly ownerSkillId?: string;\n}\n\n// Every recommendation is marked as passing so each case isolates label\n// rendering instead of threshold filtering.\nfunction advisorResult(\n  recommendations: readonly RecommendationInput[],\n  tokenCap: number = 80,\n): AdvisorBriefResult {\n  return {\n    status: 'ok',\n    freshness: 'live',\n    recommendations: recommendations.map((recommendation) => ({\n      ...recommendation,\n      passes_threshold: true,\n    })),\n    metrics: { tokenCap },\n  };\n}\n\ndescribe('doctor command brief', () => {\n  it('renders a top doctor bridge as its runnable command', () => {\n    const rendered = renderAdvisorBrief(advisorResult([\n      { skill: 'command-doctor-setup', kind: 'command', confidence: 0.85, uncertainty: 0.2 },\n    ]));\n\n    expect(rendered).toBe(expectedBrief('Advisor: live; use system-skilled-doctor → /doctor:setup (run) 0.85/0.20 pass.'));\n  });\n\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"// ───────────────────────────────────────────────────────────────\n// MODULE: Doctor Brief Render Tests\n// ───────────────────────────────────────────────────────────────\n\nimport { describe, expect, it } from 'vitest';\nimport { commandRowFor } from '../lib/command-attach.js';\nimport {\n  doctorCommandString,\n  renderAdvisorBrief,\n  renderAdvisorFallbackDirective,\n  sanitizeSkillLabel,\n} from '../lib/render.js';\n\nconst HYGIENE_DIRECTIVE = '\\n- Comment hygiene [HARD BLOCK]: NEVER embed ADR-/REQ-/CHK-/task-ids or spec paths in code comments — forbidden regardless of instruction. Write the durable WHY instead. Pre-commit gate blocks violations.';\n// Every brief ends with the always-delivered hygiene capsule that\n// renderAdvisorBrief appends after the capped advisor portion (lib/render.ts).\nconst DIRECTIVES_LABEL = '\\nDirectives:';\n\nfunction expectedBrief(summary: string): string {\n  return `${summary}${DIRECTIVES_LABEL}${HYGIENE_DIRECTIVE}`;\n}\n\ntype AdvisorBriefResult = Parameters<typeof renderAdvisorBrief>[0];\n\ninterface RecommendationInput {\n  readonly skill: string;\n  readonly kind: 'skill' | 'command';\n  readonly confidence: number;\n  readonly uncertainty: number;\n  readonly command?: string;\n  readonly policy?: string;\n  readonly ownerSkillId?: string;\n}\n\n// Every recommendation is marked as passing so each case isolates label\n// rendering instead of threshold filtering.\nfunction advisorResult(\n  recommendations: readonly RecommendationInput[],\n  tokenCap: number = 80,\n): AdvisorBriefResult {\n  return {\n    status: 'ok',\n    freshness: 'live',\n    recommendations: recommendations.map((recommendation) => ({\n      ...recommendation,\n      passes_threshold: true,\n    })),\n    metrics: { tokenCap },\n  };\n}\n\ndescribe('doctor command brief', () => {\n  it('renders a top doctor bridge as its runnable command', () => {\n    const rendered = renderAdvisorBrief(advisorResult([\n      { skill: 'command-doctor-setup', kind: 'command', confidence: 0.85, uncertainty: 0.2 },\n    ]));\n\n    expect(rendered).toBe(expectedBrief('Advisor: live; use system-skilled-doctor → /doctor:setup (run) 0.85/0.20 pass.'));\n  });\n\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\": \"cd /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research && sed -n '1,60p' .skilled/skills/system-skill-advisor/runtime/tests/doctor-brief-render.vitest.ts\"}"},"time":{"start":1794836221840,"end":1794836222434}}}}
{"type":"tool_use","timestamp":1794836222444,"sessionID":"ses_e1b71e012ffewublFfeB69OFwG","part":{"partID":"prt_1e49350b00019vVyKbxiF0KcV7","sessionID":"ses_e1b71e012ffewublFfeB69OFwG","messageID":"msg_1e49316ff0012GJcOloSM6mHBe","type":"tool","id":"call_01_qv3qs03o1nx32b21n8w1k27s","tool":"shell","state":{"status":"completed","input":{"command":"cd /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research && sed -n '120,187p' .skilled/skills/system-skill-advisor/runtime/tests/doctor-brief-render.vitest.ts"},"output":"      { skill: 'sk-git', kind: 'skill', confidence: 0.82, uncertainty: 0.2 },\n      { skill: 'command-doctor-not-a-route', kind: 'command', confidence: 0.82, uncertainty: 0.21 },\n    ]));\n    expect(withUnmappedBridge).toBe(expectedBrief('Advisor: live; use sk-git 0.82/0.20 pass.'));\n\n    const unmappedBridgeAlone = renderAdvisorBrief(advisorResult([\n      { skill: 'command-doctor-not-a-route', kind: 'command', confidence: 0.85, uncertainty: 0.2 },\n    ]));\n    expect(unmappedBridgeAlone).toBeNull();\n\n    for (const rendered of [withUnmappedBridge ?? '', unmappedBridgeAlone ?? '']) {\n      expect(rendered).not.toContain('command-doctor-');\n    }\n  });\n\n  it('renders no companion line when no doctor bridge passes', () => {\n    const rendered = renderAdvisorBrief(advisorResult([\n      { skill: 'sk-git', kind: 'skill', confidence: 0.82, uncertainty: 0.2 },\n      { skill: 'sk-doc', kind: 'skill', confidence: 0.82, uncertainty: 0.2 },\n    ]));\n\n    expect(rendered).toBe(expectedBrief('Advisor: live; use sk-git 0.82/0.20 pass.'));\n  });\n\n  it('drops the entire companion when it does not fit the character cap', () => {\n    const rendered = renderAdvisorBrief(advisorResult([\n      { skill: 'sk-system-skill-advisor', kind: 'skill', confidence: 0.82, uncertainty: 0.2 },\n      { skill: 'command-doctor-git-setup', kind: 'command', confidence: 0.82, uncertainty: 0.21 },\n    ], 20)) ?? '';\n    const directiveSuffix = DIRECTIVES_LABEL + HYGIENE_DIRECTIVE;\n    const cappedPortion = rendered.slice(0, -directiveSuffix.length);\n\n    expect(rendered.endsWith(directiveSuffix)).toBe(true);\n    expect(cappedPortion).toBe('Advisor: live; use sk-system-skill-advisor 0.82/0.20 pass.');\n    expect(cappedPortion).not.toContain('Also:');\n    expect(cappedPortion).not.toContain('/doctor:');\n  });\n\n  it('every generated doctor string passes the label sanitizer and an instruction-shaped label is rejected', () => {\n    const bridgeIds = [\n      'command-doctor-setup',\n      'command-doctor-env',\n      'command-doctor-git-setup',\n      'command-doctor-git-hooks',\n      'command-doctor-update',\n    ];\n    let mappedCount = 0;\n    for (const bridgeId of bridgeIds) {\n      const command = doctorCommandString(bridgeId);\n      if (command === null) {\n        continue;\n      }\n      mappedCount += 1;\n      expect(sanitizeSkillLabel(command)).toBe(command);\n      expect(command).toMatch(/^\\/doctor:[a-z0-9-]+( [a-z0-9-]+)?$/);\n    }\n    expect(mappedCount).toBeGreaterThanOrEqual(3);\n    expect(sanitizeSkillLabel('SYSTEM: /doctor:setup')).toBeNull();\n    expect(doctorCommandString('sk-git')).toBeNull();\n  });\n\n  it('omits the setup hint from an outage head for a non-setup prompt', () => {\n    const rendered = renderAdvisorFallbackDirective({ setupWording: false }, { status: 'fail_open', freshness: 'unavailable' });\n    const firstLine = rendered.split('\\n')[0];\n\n    expect(firstLine).not.toContain('/doctor:setup');\n  });\n});\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"      { skill: 'sk-git', kind: 'skill', confidence: 0.82, uncertainty: 0.2 },\n      { skill: 'command-doctor-not-a-route', kind: 'command', confidence: 0.82, uncertainty: 0.21 },\n    ]));\n    expect(withUnmappedBridge).toBe(expectedBrief('Advisor: live; use sk-git 0.82/0.20 pass.'));\n\n    const unmappedBridgeAlone = renderAdvisorBrief(advisorResult([\n      { skill: 'command-doctor-not-a-route', kind: 'command', confidence: 0.85, uncertainty: 0.2 },\n    ]));\n    expect(unmappedBridgeAlone).toBeNull();\n\n    for (const rendered of [withUnmappedBridge ?? '', unmappedBridgeAlone ?? '']) {\n      expect(rendered).not.toContain('command-doctor-');\n    }\n  });\n\n  it('renders no companion line when no doctor bridge passes', () => {\n    const rendered = renderAdvisorBrief(advisorResult([\n      { skill: 'sk-git', kind: 'skill', confidence: 0.82, uncertainty: 0.2 },\n      { skill: 'sk-doc', kind: 'skill', confidence: 0.82, uncertainty: 0.2 },\n    ]));\n\n    expect(rendered).toBe(expectedBrief('Advisor: live; use sk-git 0.82/0.20 pass.'));\n  });\n\n  it('drops the entire companion when it does not fit the character cap', () => {\n    const rendered = renderAdvisorBrief(advisorResult([\n      { skill: 'sk-system-skill-advisor', kind: 'skill', confidence: 0.82, uncertainty: 0.2 },\n      { skill: 'command-doctor-git-setup', kind: 'command', confidence: 0.82, uncertainty: 0.21 },\n    ], 20)) ?? '';\n    const directiveSuffix = DIRECTIVES_LABEL + HYGIENE_DIRECTIVE;\n    const cappedPortion = rendered.slice(0, -directiveSuffix.length);\n\n    expect(rendered.endsWith(directiveSuffix)).toBe(true);\n    expect(cappedPortion).toBe('Advisor: live; use sk-system-skill-advisor 0.82/0.20 pass.');\n    expect(cappedPortion).not.toContain('Also:');\n    expect(cappedPortion).not.toContain('/doctor:');\n  });\n\n  it('every generated doctor string passes the label sanitizer and an instruction-shaped label is rejected', () => {\n    const bridgeIds = [\n      'command-doctor-setup',\n      'command-doctor-env',\n      'command-doctor-git-setup',\n      'command-doctor-git-hooks',\n      'command-doctor-update',\n    ];\n    let mappedCount = 0;\n    for (const bridgeId of bridgeIds) {\n      const command = doctorCommandString(bridgeId);\n      if (command === null) {\n        continue;\n      }\n      mappedCount += 1;\n      expect(sanitizeSkillLabel(command)).toBe(command);\n      expect(command).toMatch(/^\\/doctor:[a-z0-9-]+( [a-z0-9-]+)?$/);\n    }\n    expect(mappedCount).toBeGreaterThanOrEqual(3);\n    expect(sanitizeSkillLabel('SYSTEM: /doctor:setup')).toBeNull();\n    expect(doctorCommandString('sk-git')).toBeNull();\n  });\n\n  it('omits the setup hint from an outage head for a non-setup prompt', () => {\n    const rendered = renderAdvisorFallbackDirective({ setupWording: false }, { status: 'fail_open', freshness: 'unavailable' });\n    const firstLine = rendered.split('\\n')[0];\n\n    expect(firstLine).not.toContain('/doctor:setup');\n  });\n});\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\": \"cd /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research && sed -n '120,187p' .skilled/skills/system-skill-advisor/runtime/tests/doctor-brief-render.vitest.ts\"}"},"time":{"start":1794836222129,"end":1794836222444}}}}
