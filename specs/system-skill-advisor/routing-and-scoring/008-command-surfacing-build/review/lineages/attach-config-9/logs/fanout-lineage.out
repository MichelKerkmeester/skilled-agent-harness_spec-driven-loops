Object.keys(TRACKED_COMMANDS).filter((k) => !Object.hasOwn(COMMAND_ROWS, k));\\nconsole.log('tracked without command row:', rowsMissing.length, rowsMissing.slice(0,10));\\nconst orphanRows = Object.keys(COMMAND_ROWS).filter((k) => !Object.hasOwn(TRACKED_COMMANDS, k));\\nconsole.log('rows without tracked entry:', orphanRows.length, orphanRows.slice(0,10));\\nconst scorerMismatch = Object.entries(COMMAND_ROWS).filter(([k, v]) => Boolean(v.scorerRow) !== Boolean(TRACKED_COMMANDS[k]?.scorerRow ?? false));\\nconsole.log('scorerRow flag mismatches:', scorerMismatch.length, scorerMismatch.slice(0,5));\\nconst counts = {};\\nfor (const v of Object.values(TRACKED_COMMANDS)) counts[v.policy] = (counts[v.policy] ?? 0) + 1;\\nconsole.log('policies:', counts);\\n\\\" 2>&1\"}"},"time":{"start":1794836285195,"end":1794836286643}}}}
