test(next)));\n256:export function typedCommandForTop(topSkillId: string, prompt: string): TypedCommand | undefined {\n417:export function commandOnlyMentioned(prompt: string, command: string): boolean {\n465:export function attachCommand(\n514:    const typesThisCommand = typedCommandIn(prompt) === commands[workflowMode];\n515:    if (!typesThisCommand && !DEPTH_REQUEST.test(prompt.toLowerCase())) return undefined;\n===\n414:describe('typed command boundaries', () => {\n415:  it('does not read a file name with an extension as a typed command', () => {\n435:  it('reads a command typed with its mode suffix', () => {\n442:  it('reads a command typed with a with-modifier or a chain of suffixes', () => {\n455:  it('does not read a command followed by an unknown suffix', () => {\n===\n16:const RUN_TMPDIR = mkdtempSync(path.join(tmpdir(), 'sav-'));\n17:process.env.TMPDIR = RUN_TMPDIR;\n18:process.env.TEMP = RUN_TMPDIR;\n19:process.env.TMP = RUN_TMPDIR;\n20:process.on('exit', () => {\n21:  rmSync(RUN_TMPDIR, { recursive: true, force: true });\n24:// A dispatched worker carries AI_SESSION_CHILD=1, and the brief renderer reads it\n27:delete process.env.AI_SESSION_CHILD;\n===\n76:    expect(renderAdvisorBrief(result, { childSession: false })).toContain('\\nAlso: /doctor:env list (run)');\n77:    expect(renderAdvisorBrief(result, { childSession: true })).toContain('\\nAlso: /doctor:env list (run)');\n84:    expect(renderAdvisorBrief(updateResult, { childSession: true })).toContain('\\nAlso: /doctor:update (parent-named only)');\n92:    ]), { childSession: false }) ?? '';\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"208:const COMMAND_START_BOUNDARY = /[\\s`'\"(]/;\n209:const COMMAND_CONTINUATION = /[a-z0-9_:-]/;\n211:const MODE_SUFFIX = /^(?::(?:auto|confirm|autopilot|unattended|with-(?:context|phases|research)))+(?![a-z0-9_:-])/;\n221:export function typedCommandIn(prompt: string): string | undefined {\n230:      const startsAtBoundary = before === '' || COMMAND_START_BOUNDARY.test(before);\n231:      const hasModeSuffix = MODE_SUFFIX.test(lowered.slice(index + key.length));\n233:        !hasModeSuffix\n234:        && (COMMAND_CONTINUATION.test(after) || ((after === '/' || after === '.') && WORD_CHARACTER.test(next)));\n256:export function typedCommandForTop(topSkillId: string, prompt: string): TypedCommand | undefined {\n417:export function commandOnlyMentioned(prompt: string, command: string): boolean {\n465:export function attachCommand(\n514:    const typesThisCommand = typedCommandIn(prompt) === commands[workflowMode];\n515:    if (!typesThisCommand && !DEPTH_REQUEST.test(prompt.toLowerCase())) return undefined;\n===\n414:describe('typed command boundaries', () => {\n415:  it('does not read a file name with an extension as a typed command', () => {\n435:  it('reads a command typed with its mode suffix', () => {\n442:  it('reads a command typed with a with-modifier or a chain of suffixes', () => {\n455:  it('does not read a command followed by an unknown suffix', () => {\n===\n16:const RUN_TMPDIR = mkdtempSync(path.join(tmpdir(), 'sav-'));\n17:process.env.TMPDIR = RUN_TMPDIR;\n18:process.env.TEMP = RUN_TMPDIR;\n19:process.env.TMP = RUN_TMPDIR;\n20:process.on('exit', () => {\n21:  rmSync(RUN_TMPDIR, { recursive: true, force: true });\n24:// A dispatched worker carries AI_SESSION_CHILD=1, and the brief renderer reads it\n27:delete process.env.AI_SESSION_CHILD;\n===\n76:    expect(renderAdvisorBrief(result, { childSession: false })).toContain('\\nAlso: /doctor:env list (run)');\n77:    expect(renderAdvisorBrief(result, { childSession: true })).toContain('\\nAlso: /doctor:env list (run)');\n84:    expect(renderAdvisorBrief(updateResult, { childSession: true })).toContain('\\nAlso: /doctor:update (parent-named only)');\n92:    ]), { childSession: false }) ?? '';\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\": \"cd /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research && git show 05f776202e0:.skilled/skills/system-skill-advisor/runtime/lib/command-attach.ts | grep -n \\\"MODE_SUFFIX\\\\|COMMAND_START_BOUNDARY\\\\|COMMAND_CONTINUATION\\\\|export function typedCommandIn\\\\|hasModeSuffix\\\\|export function typedCommandForTop\\\\|export function commandOnlyMentioned\\\\|export function attachCommand\\\\|typesThisCommand\\\" ; echo ===; git show 05f776202e0:.skilled/skills/system-skill-advisor/runtime/tests/command-attach-guards.vitest.ts | grep -n \\\"does not read a file name\\\\|reads a command typed with its mode suffix\\\\|with-modifier or a chain\\\\|does not read a command followed by an unknown suffix\\\\|describe('typed command boundaries'\\\"; echo ===; git show 05f776202e0:.skilled/skills/system-skill-advisor/runtime/vitest.config.ts | grep -n \\\"RUN_TMPDIR\\\\|AI_SESSION_CHILD\\\\|process.on('exit'\\\"; echo ===; git show 05f776202e0:.skilled/skills/system-skill-advisor/runtime/tests/doctor-brief-render.vitest.ts | grep -n \\\"childSession\\\"\"}"},"time":{"start":1794836672643,"end":1794836674080}}}}
