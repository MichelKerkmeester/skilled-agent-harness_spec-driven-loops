{"type":"tool_use","timestamp":1794596854423,"sessionID":"ses_e29b1d959ffeIRu3GDOv5mxZKO","part":{"partID":"prt_1d64ed5d2001tW717Eb5INIMXd","sessionID":"ses_e29b1d959ffeIRu3GDOv5mxZKO","messageID":"msg_1d64ec1c2001xYIy2qrm3d3oH0","type":"tool","id":"call_58846d11433543e6bf735842","tool":"read","state":{"status":"completed","input":{"path":".skilled/skills/system-skill-advisor/runtime/tests/command-attach-guards.vitest.ts"},"output":"Read file .skilled/skills/system-skill-advisor/runtime/tests/command-attach-guards.vitest.ts, lines 1-148\n1: // ───────────────────────────────────────────────────────────────\n2: // MODULE: Command attach guards\n3: // ───────────────────────────────────────────────────────────────\n4: \n5: // A hub route names the command that acts on the mode it picked, so it has to\n6: // honour the same no-edit wording the scorer honours. A reader who rules out a\n7: // change must not be handed a command that changes files.\n8: \n9: import { readFileSync } from 'node:fs';\n10: import { join } from 'node:path';\n11: \n12: import { describe, expect, it } from 'vitest';\n13: \n14: import {\n15:   attachCommand,\n16:   isNoEditRequest,\n17:   NO_EDIT_REQUEST,\n18:   typedCommandForTop,\n19:   typedCommandIn,\n20: } from '../lib/command-attach.js';\n21: \n22: // The only route shape that names a command unambiguously: one decision and one\n23: // selected target.\n24: function SINGLE(workflowMode: string): Record<string, unknown> {\n25:   return { action: 'route', selectionKind: 'single', targets: [{ workflowMode }] };\n26: }\n27: \n28: // The endings a reader uses to rule out a change. One writes the contraction\n29: // with a curly apostrophe, which is the form many keyboards produce.\n30: const NOEDIT4 = [\n31:   \"don't change anything yet\",\n32:   'no changes yet',\n33:   'don\\u2019t touch any files',\n34:   'make no changes',\n35: ];\n36: \n37: describe('command attach on a no-edit prompt', () => {\n38:   it('offers no hub command when the prompt rules out a change', () => {\n39:     const prompt = 'use sk-doc to create a skill called invoice-parser, do not change anything yet';\n40:     expect(attachCommand('sk-doc', SINGLE('sk-create-skill'), prompt)).toBeUndefined();\n41:   });\n42: \n43:   it('offers the command when the same prompt asks for the change', () => {\n44:     const prompt = 'use sk-doc to create a skill called invoice-parser';\n45:     expect(attachCommand('sk-doc', SINGLE('sk-create-skill'), prompt)).toBe('/create:sk-skill');\n46:   });\n47: \n48:   it('reads the shared no-edit wording', () => {\n49:     expect(NO_EDIT_REQUEST.test('just show me the plan')).toBe(true);\n50:   });\n51: \n52:   it.each(NOEDIT4)('offers no hub command when the prompt ends %s', (ending) => {\n53:     const prompt = 'use sk-doc to create an agent called invoice-parser, ' + ending;\n54:     expect(attachCommand('sk-doc', SINGLE('sk-create-agent'), prompt)).toBeUndefined();\n55:   });\n56: \n57:   it('offers the agent command when the prompt asks for the change', () => {\n58:     const prompt = 'use sk-doc to create an agent called invoice-parser';\n59:     expect(attachCommand('sk-doc', SINGLE('sk-create-agent'), prompt)).toBe('/create:agent');\n60:   });\n61: \n62:   it('reads a curly apostrophe as a straight one', () => {\n63:     expect(isNoEditRequest('Don\\u2019t touch any files')).toBe(true);\n64:     expect(isNoEditRequest('touch the files')).toBe(false);\n65:   });\n66: \n67:   // A change request can say what must stay the same, and that is still a\n68:   // request for the change.\n69:   it.each([\n70:     'refactor the parser so there are no changes to its public api',\n71:     'fix the flaky test and make sure there are no changes in behaviour',\n72:     'create an agent called invoice-parser with no changes to existing agents',\n73:   ])('keeps a change request that limits its scope: %s', (prompt) => {\n74:     expect(isNoEditRequest(prompt)).toBe(false);\n75:   });\n76: \n77:   // The phrase reads as no change whatever follows it. The first row is a real\n78:   // no-edit request. The second is a change request that pays for the safe\n79:   // reading by losing its command.\n80:   it.each([\n81:     'show me the plan and make no changes to the files',\n82:     'refactor the parser and make no changes to its public api',\n83:   ])('reads make no changes as ruling out a change: %s', (prompt) => {\n84:     expect(isNoEditRequest(prompt)).toBe(true);\n85:   });\n86: });\n87: \n88: describe('command attach on a deep-loop prompt', () => {\n89:   it('withholds the review command when another deep-loop command is named', () => {\n90:     expect(attachCommand('system-deep-loop', SINGLE('review'), 'what did /deep:ai-council decide')).toBeUndefined();\n91:   });\n92: \n93:   it('withholds the review command when an unknown deep-loop command is named', () => {\n94:     expect(attachCommand('system-deep-loop', SINGLE('review'), 'what did /deep:reviw decide')).toBeUndefined();\n95:   });\n96: \n97:   it('offers the review command when it is the command typed', () => {\n98:     expect(attachCommand('system-deep-loop', SINGLE('review'), 'run /deep:review now')).toBe('/deep:review');\n99:   });\n100: \n101:   it('offers the review command when the prompt asks for depth', () => {\n102:     expect(attachCommand('system-deep-loop', SINGLE('review'), 'review the parser in depth')).toBe('/deep:review');\n103:   });\n104: });\n105: \n106: describe('typed command boundaries', () => {\n107:   it('does not read a file name with an extension as a typed command', () => {\n108:     expect(typedCommandIn('see /create:sk-skill.md for details')).toBeUndefined();\n109:   });\n110: \n111:   it('does not read a path segment as a typed command', () => {\n112:     expect(typedCommandIn('open /create:readme/notes.txt')).toBeUndefined();\n113:   });\n114: \n115:   it('reads a command that ends a sentence', () => {\n116:     expect(typedCommandIn('run /create:sk-skill.')).toBe('/create:sk-skill');\n117:   });\n118: \n119:   it('reads a command followed by a comma', () => {\n120:     expect(typedCommandIn('run /create:sk-skill, then stop')).toBe('/create:sk-skill');\n121:   });\n122: \n123:   it('reads the longest command when a prefix also matches', () => {\n124:     expect(typedCommandIn('/create:skill-parent now')).toBe('/create:skill-parent');\n125:   });\n126: \n127:   it('carries no command when the prompt only names a file', () => {\n128:     expect(typedCommandForTop('sk-doc', 'open /create:readme.md and summarise it')).toBeUndefined();\n129:   });\n130: });\n131: \n132: describe('generated command table', () => {\n133:   it('holds no separate policy table', async () => {\n134:     expect('COMMAND_POLICIES' in await import('../lib/command-attach.js')).toBe(false);\n135:   });\n136: \n137:   it('the command-bridges README names every command row field', () => {\n138:     const source = readFileSync(join(import.meta.dirname, '../lib/command-attach.ts'), 'utf8');\n139:     const readme = readFileSync(join(import.meta.dirname, '../scripts/command-bridges/README.md'), 'utf8');\n140:     const interfaceBlock = /export interface CommandRow \\{([\\s\\S]*?)\\n\\}/.exec(source)?.[1] ?? '';\n141:     const fields = [...interfaceBlock.matchAll(/readonly (\\w+)\\??:/g)].map((match) => match[1]);\n142:     expect(fields).toEqual(['command', 'policy', 'mutating', 'ownerSkillId']);\n143:     const sentence = /Each row carries [^\\n]*/.exec(readme)?.[0] ?? '';\n144:     for (const field of fields) {\n145:       expect(sentence).toContain('`' + field + '`');\n146:     }\n147:   });\n148: });","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file .skilled/skills/system-skill-advisor/runtime/tests/command-attach-guards.vitest.ts, lines 1-148\n1: // ───────────────────────────────────────────────────────────────\n2: // MODULE: Command attach guards\n3: // ───────────────────────────────────────────────────────────────\n4: \n5: // A hub route names the command that acts on the mode it picked, so it has to\n6: // honour the same no-edit wording the scorer honours. A reader who rules out a\n7: // change must not be handed a command that changes files.\n8: \n9: import { readFileSync } from 'node:fs';\n10: import { join } from 'node:path';\n11: \n12: import { describe, expect, it } from 'vitest';\n13: \n14: import {\n15:   attachCommand,\n16:   isNoEditRequest,\n17:   NO_EDIT_REQUEST,\n18:   typedCommandForTop,\n19:   typedCommandIn,\n20: } from '../lib/command-attach.js';\n21: \n22: // The only route shape that names a command unambiguously: one decision and one\n23: // selected target.\n24: function SINGLE(workflowMode: string): Record<string, unknown> {\n25:   return { action: 'route', selectionKind: 'single', targets: [{ workflowMode }] };\n26: }\n27: \n28: // The endings a reader uses to rule out a change. One writes the contraction\n29: // with a curly apostrophe, which is the form many keyboards produce.\n30: const NOEDIT4 = [\n31:   \"don't change anything yet\",\n32:   'no changes yet',\n33:   'don\\u2019t touch any files',\n34:   'make no changes',\n35: ];\n36: \n37: describe('command attach on a no-edit prompt', () => {\n38:   it('offers no hub command when the prompt rules out a change', () => {\n39:     const prompt = 'use sk-doc to create a skill called invoice-parser, do not change anything yet';\n40:     expect(attachCommand('sk-doc', SINGLE('sk-create-skill'), prompt)).toBeUndefined();\n41:   });\n42: \n43:   it('offers the command when the same prompt asks for the change', () => {\n44:     const prompt = 'use sk-doc to create a skill called invoice-parser';\n45:     expect(attachCommand('sk-doc', SINGLE('sk-create-skill'), prompt)).toBe('/create:sk-skill');\n46:   });\n47: \n48:   it('reads the shared no-edit wording', () => {\n49:     expect(NO_EDIT_REQUEST.test('just show me the plan')).toBe(true);\n50:   });\n51: \n52:   it.each(NOEDIT4)('offers no hub command when the prompt ends %s', (ending) => {\n53:     const prompt = 'use sk-doc to create an agent called invoice-parser, ' + ending;\n54:     expect(attachCommand('sk-doc', SINGLE('sk-create-agent'), prompt)).toBeUndefined();\n55:   });\n56: \n57:   it('offers the agent command when the prompt asks for the change', () => {\n58:     const prompt = 'use sk-doc to create an agent called invoice-parser';\n59:     expect(attachCommand('sk-doc', SINGLE('sk-create-agent'), prompt)).toBe('/create:agent');\n60:   });\n61: \n62:   it('reads a curly apostrophe as a straight one', () => {\n63:     expect(isNoEditRequest('Don\\u2019t touch any files')).toBe(true);\n64:     expect(isNoEditRequest('touch the files')).toBe(false);\n65:   });\n66: \n67:   // A change request can say what must stay the same, and that is still a\n68:   // request for the change.\n69:   it.each([\n70:     'refactor the parser so there are no changes to its public api',\n71:     'fix the flaky test and make sure there are no changes in behaviour',\n72:     'create an agent called invoice-parser with no changes to existing agents',\n73:   ])('keeps a change request that limits its scope: %s', (prompt) => {\n74:     expect(isNoEditRequest(prompt)).toBe(false);\n75:   });\n76: \n77:   // The phrase reads as no change whatever follows it. The first row is a real\n78:   // no-edit request. The second is a change request that pays for the safe\n79:   // reading by losing its command.\n80:   it.each([\n81:     'show me the plan and make no changes to the files',\n82:     'refactor the parser and make no changes to its public api',\n83:   ])('reads make no changes as ruling out a change: %s', (prompt) => {\n84:     expect(isNoEditRequest(prompt)).toBe(true);\n85:   });\n86: });\n87: \n88: describe('command attach on a deep-loop prompt', () => {\n89:   it('withholds the review command when another deep-loop command is named', () => {\n90:     expect(attachCommand('system-deep-loop', SINGLE('review'), 'what did /deep:ai-council decide')).toBeUndefined();\n91:   });\n92: \n93:   it('withholds the review command when an unknown deep-loop command is named', () => {\n94:     expect(attachCommand('system-deep-loop', SINGLE('review'), 'what did /deep:reviw decide')).toBeUndefined();\n95:   });\n96: \n97:   it('offers the review command when it is the command typed', () => {\n98:     expect(attachCommand('system-deep-loop', SINGLE('review'), 'run /deep:review now')).toBe('/deep:review');\n99:   });\n100: \n101:   it('offers the review command when the prompt asks for depth', () => {\n102:     expect(attachCommand('system-deep-loop', SINGLE('review'), 'review the parser in depth')).toBe('/deep:review');\n103:   });\n104: });\n105: \n106: describe('typed command boundaries', () => {\n107:   it('does not read a file name with an extension as a typed command', () => {\n108:     expect(typedCommandIn('see /create:sk-skill.md for details')).toBeUndefined();\n109:   });\n110: \n111:   it('does not read a path segment as a typed command', () => {\n112:     expect(typedCommandIn('open /create:readme/notes.txt')).toBeUndefined();\n113:   });\n114: \n115:   it('reads a command that ends a sentence', () => {\n116:     expect(typedCommandIn('run /create:sk-skill.')).toBe('/create:sk-skill');\n117:   });\n118: \n119:   it('reads a command followed by a comma', () => {\n120:     expect(typedCommandIn('run /create:sk-skill, then stop')).toBe('/create:sk-skill');\n121:   });\n122: \n123:   it('reads the longest command when a prefix also matches', () => {\n124:     expect(typedCommandIn('/create:skill-parent now')).toBe('/create:skill-parent');\n125:   });\n126: \n127:   it('carries no command when the prompt only names a file', () => {\n128:     expect(typedCommandForTop('sk-doc', 'open /create:readme.md and summarise it')).toBeUndefined();\n129:   });\n130: });\n131: \n132: describe('generated command table', () => {\n133:   it('holds no separate policy table', async () => {\n134:     expect('COMMAND_POLICIES' in await import('../lib/command-attach.js')).toBe(false);\n135:   });\n136: \n137:   it('the command-bridges README names every command row field', () => {\n138:     const source = readFileSync(join(import.meta.dirname, '../lib/command-attach.ts'), 'utf8');\n139:     const readme = readFileSync(join(import.meta.dirname, '../scripts/command-bridges/README.md'), 'utf8');\n140:     const interfaceBlock = /export interface CommandRow \\{([\\s\\S]*?)\\n\\}/.exec(source)?.[1] ?? '';\n141:     const fields = [...interfaceBlock.matchAll(/readonly (\\w+)\\??:/g)].map((match) => match[1]);\n142:     expect(fields).toEqual(['command', 'policy', 'mutating', 'ownerSkillId']);\n143:     const sentence = /Each row carries [^\\n]*/.exec(readme)?.[0] ?? '';\n144:     for (const field of fields) {\n145:       expect(sentence).toContain('`' + field + '`');\n146:     }\n147:   });\n148: });"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\".skilled/skills/system-skill-advisor/runtime/tests/command-attach-guards.vitest.ts\"}"},"time":{"start":1794596853202,"end":1794596854423}}}}
{"type":"tool_use","timestamp":1794596854435,"sessionID":"ses_e29b1d959ffeIRu3GDOv5mxZKO","part":{"partID":"prt_1d64ed700001rEV7XfdyKgAf9N","sessionID":"ses_e29b1d959ffeIRu3GDOv5mxZKO","messageID":"msg_1d64ec1c2001xYIy2qrm3d3oH0","type":"tool","id":"call_2e62d4fbb0064d7cb726b1bb","tool":"shell","state":{"status":"completed","input":{"command":"cd /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research && sed -n '640,720p' .skilled/skills/system-skill-advisor/runtime/lib/scorer/fusion.ts; echo \"=== 860-900\"; sed -n '860,900p' .skilled/skills/system-skill-advisor/runtime/lib/scorer/fusion.ts; echo \"=== text.ts 130-175\"; sed -n '130,175p' .skilled/skills/system-skill-advisor/runtime/lib/scorer/text.ts"},"output":"    if (!moved) break;\n  }\n  // Only a target the cap really lowered is marked, and only against the seed\n  // whose ceiling set its final score: a seed that merely could have held it\n  // ranked nothing, so the pair keeps its ordinary ambiguity check.\n  for (const [targetId, holders] of holdersByTarget) {\n    const final = bounded.get(targetId) ?? 0;\n    if (final >= (scores.get(targetId) ?? 0)) continue;\n    let binding: string | null = null;\n    let lowestSeed = Number.POSITIVE_INFINITY;\n    for (const seedId of holders) {\n      const seedScore = bounded.get(seedId) ?? 0;\n      if (seedScore < lowestSeed) {\n        lowestSeed = seedScore;\n        binding = seedId;\n      }\n    }\n    if (binding) heldBelow.set(targetId, binding);\n  }\n  return { scores: bounded, heldBelow };\n}\n\nfunction hasExplicitWorkflowSignal(contributions: readonly LaneContribution[], skillId: string): boolean {\n  const explicit = contributions.find((contribution) => contribution.lane === 'explicit_author');\n  if (!explicit || explicit.rawScore < EXPLICIT_WORKFLOW_SIGNAL_FLOOR) return false;\n  return explicit.evidence.some((entry) => (\n    entry.startsWith('phrase:')\n    || entry.startsWith('explicit:')\n    || entry.startsWith('author:')\n    || entry.includes(skillId)\n    || entry.includes('loop')\n    || entry.includes('write-')\n  ));\n}\n\nexport function readOnlyRouteAllowed(promptLower: string, skill: SkillProjection): boolean {\n  const skillId = skill.id;\n  if (isNoEditRequest(promptLower)) {\n    return false;\n  }\n  // The explainer floor exists to stop an ambiguous read-only question from\n  // routing anywhere. Naming the skill removes the ambiguity: the caller has\n  // already chosen, and a read-only verb does not undo that choice. Without\n  // this, an explicit request is answered with an abstention while the same\n  // sentence phrased with a write verb routes fine.\n  if (promptMentionsSkill(promptLower, skill)) {\n    return true;\n  }\n  // A command whose route only reads (a report, a status check) is the answer\n  // to a list or show question, so its own trigger phrase lifts it off the\n  // floor. A mutating command never carries the flag and stays gated.\n  if (skill.kind === 'command' && 'readOnly' in skill && skill.readOnly === true\n    && skill.keywords.some((phrase) => matchesPhraseBoundary(promptLower, phrase.toLowerCase()))) {\n    return true;\n  }\n  if (skillId === 'sk-code' && /\\b(compare|audit|review)\\b/.test(promptLower)\n    && /\\b(classifier|vocabulary|prose|implementation|agents\\.md|drift|mismatch)\\b/.test(promptLower)) {\n    return true;\n  }\n  if (skillId === 'system-spec-kit' && /\\b(memory_save|resume_write|routing taxonomy|corpus|source-type|routing bucket)\\b/.test(promptLower)) {\n    return true;\n  }\n  if (skillId === 'system-spec-kit' && /\\b(packet|spec folder|save memory|phase|continuation prompts|resume handling)\\b/.test(promptLower)) {\n    return true;\n  }\n  // Captured operator answers wait in a queue that spec-kit's save step owns, so a show or list\n  // question about that queue, its chat candidates or the decision record is answered there.\n  // Only a read-only question is lifted: a lift applies to any prompt, and a request to research,\n  // dispatch or build something about decisions belongs to another skill.\n  if (skillId === 'system-spec-kit' && isReadOnlyExplainer(promptLower)\n    && /\\b(decision capture|decision record|chat candidates?|operator decisions?|recorded as decisions?)\\b/.test(promptLower)) {\n    return true;\n  }\n  // The trigger index is spec-kit's own lookup surface, so a question about what a lookup\n  // returned, counted or left out is answered there. Without the lift no skill passes on such a\n  // question, and the doctor hand-off claims it on the index noun alone. Drift is the doctor's\n  // own diagnosis, so a drift question stays with the hand-off.\n  if (skillId === 'system-spec-kit' && isReadOnlyExplainer(promptLower)\n    && /\\btrigger[- ]index\\b/.test(promptLower) && !/\\bdrift\\b/.test(promptLower)) {\n    return true;\n  }\n=== 860-900\n\n// A command bridge passes on its own wording: one of its authored phrases or its\n// runnable slash string, which the explicit-author lane reports. A bridge that\n// passed on shared single tokens alone stays scored but stops passing, because\n// its phrases are everyday words and a command must not be offered for a prompt\n// that merely shares some of them. A paraphrase shares no words at all, so the\n// second way in is meaning: a real prompt embedding that clears both bars above.\n// Meaning-passed ids are collected so a later ordering step can tell them apart,\n// and a doctor problem in other words reaches /doctor:helper through\n// applyDoctorHelperHandoff instead.\n// A question that only wants an answer must not be handed a command that\n// changes things, however close the meaning. Phrase matches are already held to\n// this by the read-only confidence floor, and a meaning match lifts confidence\n// past that floor, so it has to ask the same question itself. A command whose\n// route only reads stays eligible for a plain explainer, because running it is\n// the answer. An explicit no-edit request rules out every command.\nexport function commandMeaningEligible(\n  promptLower: string,\n  readOnlyExplainer: boolean,\n  skill: SkillProjection | undefined,\n): boolean {\n  if (isNoEditRequest(promptLower)) return false;\n  if (!readOnlyExplainer) return true;\n  return skill !== undefined && skill.kind === 'command' && 'readOnly' in skill && skill.readOnly === true;\n}\n\nexport function requireCommandPhraseAnchor(\n  ranked: readonly AdvisorScoredRecommendation[],\n  confidenceThreshold: number = DEFAULT_CONFIDENCE_THRESHOLD,\n  meaningPassed: Set<string> = new Set(),\n  meaningEligible: (skillId: string) => boolean = () => true,\n): AdvisorScoredRecommendation[] {\n  const cosineByCommandId = new Map<string, number>();\n  for (const recommendation of ranked) {\n    if (recommendation.kind !== 'command') continue;\n    const cosine = commandMeaningCosine(\n      recommendation.laneContributions.find((contribution) => contribution.lane === 'semantic_shadow'),\n    );\n    if (cosine !== null) cosineByCommandId.set(recommendation.skill, cosine);\n  }\n  // A command row with no cosine counts as 0, so the bar is the strongest other\n=== text.ts 130-175\n    if (candidateTokens.has(token)) {\n      hits += 1;\n      continue;\n    }\n    for (const candidate of candidateTokens) {\n      // A short prompt word inside or at the end of \"allowlist\" (\"list\") names a different concept.\n      // A prompt extension (\"regressions\") or a skill word that adds a suffix (\"plan\" -> \"planning\")\n      // stays related; one that adds a second word (\"auto\" -> \"autoreap\") does not.\n      if (token.length >= 4 && candidate.length >= 4 && (token.includes(candidate) || extendsBySuffix(token, candidate))) {\n        hits += 0.45;\n        break;\n      }\n    }\n  }\n  return Math.min(hits / Math.max(3, denominatorBasis), 1);\n}\n\nexport function isReadOnlyExplainer(promptLower: string): boolean {\n  const readOnly = /\\b(analyze|explain|inspect|summarize|list|show|tell|compare|decompose)\\b/.test(promptLower);\n  const skillSurface = /\\b(review|audit|deep[- ]research|deep[- ]review|semantic search|figma|clickup|chrome devtools|git worktree|prompt)\\b/.test(promptLower);\n  const explicitNoWrite = isNoEditRequest(promptLower);\n  if (skillSurface) return false;\n  if (readOnly && explicitNoWrite) return true;\n  if (/^\\s*(analyze|explain|inspect|summarize|list|show|tell|compare|decompose)\\b/.test(promptLower)\n    && !/\\b(then|and)\\s+(add|build|change|configure|create|edit|fix|generate|implement|modify|move|patch|refactor|rename|replace|run|save|start|update|write)\\b/.test(promptLower)) {\n    return true;\n  }\n  const write = /\\b(add|build|change|configure|create|disable[sd]?|edit|enable[sd]?|execute|fix|generate|implement|modify|patch|refactor|rename|re-?run|run|save|switch (?:on|off)|turn (?:on|off)|update|write)\\b/.test(promptLower);\n  return readOnly && !write && !skillSurface;\n}\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"    if (!moved) break;\n  }\n  // Only a target the cap really lowered is marked, and only against the seed\n  // whose ceiling set its final score: a seed that merely could have held it\n  // ranked nothing, so the pair keeps its ordinary ambiguity check.\n  for (const [targetId, holders] of holdersByTarget) {\n    const final = bounded.get(targetId) ?? 0;\n    if (final >= (scores.get(targetId) ?? 0)) continue;\n    let binding: string | null = null;\n    let lowestSeed = Number.POSITIVE_INFINITY;\n    for (const seedId of holders) {\n      const seedScore = bounded.get(seedId) ?? 0;\n      if (seedScore < lowestSeed) {\n        lowestSeed = seedScore;\n        binding = seedId;\n      }\n    }\n    if (binding) heldBelow.set(targetId, binding);\n  }\n  return { scores: bounded, heldBelow };\n}\n\nfunction hasExplicitWorkflowSignal(contributions: readonly LaneContribution[], skillId: string): boolean {\n  const explicit = contributions.find((contribution) => contribution.lane === 'explicit_author');\n  if (!explicit || explicit.rawScore < EXPLICIT_WORKFLOW_SIGNAL_FLOOR) return false;\n  return explicit.evidence.some((entry) => (\n    entry.startsWith('phrase:')\n    || entry.startsWith('explicit:')\n    || entry.startsWith('author:')\n    || entry.includes(skillId)\n    || entry.includes('loop')\n    || entry.includes('write-')\n  ));\n}\n\nexport function readOnlyRouteAllowed(promptLower: string, skill: SkillProjection): boolean {\n  const skillId = skill.id;\n  if (isNoEditRequest(promptLower)) {\n    return false;\n  }\n  // The explainer floor exists to stop an ambiguous read-only question from\n  // routing anywhere. Naming the skill removes the ambiguity: the caller has\n  // already chosen, and a read-only verb does not undo that choice. Without\n  // this, an explicit request is answered with an abstention while the same\n  // sentence phrased with a write verb routes fine.\n  if (promptMentionsSkill(promptLower, skill)) {\n    return true;\n  }\n  // A command whose route only reads (a report, a status check) is the answer\n  // to a list or show question, so its own trigger phrase lifts it off the\n  // floor. A mutating command never carries the flag and stays gated.\n  if (skill.kind === 'command' && 'readOnly' in skill && skill.readOnly === true\n    && skill.keywords.some((phrase) => matchesPhraseBoundary(promptLower, phrase.toLowerCase()))) {\n    return true;\n  }\n  if (skillId === 'sk-code' && /\\b(compare|audit|review)\\b/.test(promptLower)\n    && /\\b(classifier|vocabulary|prose|implementation|agents\\.md|drift|mismatch)\\b/.test(promptLower)) {\n    return true;\n  }\n  if (skillId === 'system-spec-kit' && /\\b(memory_save|resume_write|routing taxonomy|corpus|source-type|routing bucket)\\b/.test(promptLower)) {\n    return true;\n  }\n  if (skillId === 'system-spec-kit' && /\\b(packet|spec folder|save memory|phase|continuation prompts|resume handling)\\b/.test(promptLower)) {\n    return true;\n  }\n  // Captured operator answers wait in a queue that spec-kit's save step owns, so a show or list\n  // question about that queue, its chat candidates or the decision record is answered there.\n  // Only a read-only question is lifted: a lift applies to any prompt, and a request to research,\n  // dispatch or build something about decisions belongs to another skill.\n  if (skillId === 'system-spec-kit' && isReadOnlyExplainer(promptLower)\n    && /\\b(decision capture|decision record|chat candidates?|operator decisions?|recorded as decisions?)\\b/.test(promptLower)) {\n    return true;\n  }\n  // The trigger index is spec-kit's own lookup surface, so a question about what a lookup\n  // returned, counted or left out is answered there. Without the lift no skill passes on such a\n  // question, and the doctor hand-off claims it on the index noun alone. Drift is the doctor's\n  // own diagnosis, so a drift question stays with the hand-off.\n  if (skillId === 'system-spec-kit' && isReadOnlyExplainer(promptLower)\n    && /\\btrigger[- ]index\\b/.test(promptLower) && !/\\bdrift\\b/.test(promptLower)) {\n    return true;\n  }\n=== 860-900\n\n// A command bridge passes on its own wording: one of its authored phrases or its\n// runnable slash string, which the explicit-author lane reports. A bridge that\n// passed on shared single tokens alone stays scored but stops passing, because\n// its phrases are everyday words and a command must not be offered for a prompt\n// that merely shares some of them. A paraphrase shares no words at all, so the\n// second way in is meaning: a real prompt embedding that clears both bars above.\n// Meaning-passed ids are collected so a later ordering step can tell them apart,\n// and a doctor problem in other words reaches /doctor:helper through\n// applyDoctorHelperHandoff instead.\n// A question that only wants an answer must not be handed a command that\n// changes things, however close the meaning. Phrase matches are already held to\n// this by the read-only confidence floor, and a meaning match lifts confidence\n// past that floor, so it has to ask the same question itself. A command whose\n// route only reads stays eligible for a plain explainer, because running it is\n// the answer. An explicit no-edit request rules out every command.\nexport function commandMeaningEligible(\n  promptLower: string,\n  readOnlyExplainer: boolean,\n  skill: SkillProjection | undefined,\n): boolean {\n  if (isNoEditRequest(promptLower)) return false;\n  if (!readOnlyExplainer) return true;\n  return skill !== undefined && skill.kind === 'command' && 'readOnly' in skill && skill.readOnly === true;\n}\n\nexport function requireCommandPhraseAnchor(\n  ranked: readonly AdvisorScoredRecommendation[],\n  confidenceThreshold: number = DEFAULT_CONFIDENCE_THRESHOLD,\n  meaningPassed: Set<string> = new Set(),\n  meaningEligible: (skillId: string) => boolean = () => true,\n): AdvisorScoredRecommendation[] {\n  const cosineByCommandId = new Map<string, number>();\n  for (const recommendation of ranked) {\n    if (recommendation.kind !== 'command') continue;\n    const cosine = commandMeaningCosine(\n      recommendation.laneContributions.find((contribution) => contribution.lane === 'semantic_shadow'),\n    );\n    if (cosine !== null) cosineByCommandId.set(recommendation.skill, cosine);\n  }\n  // A command row with no cosine counts as 0, so the bar is the strongest other\n=== text.ts 130-175\n    if (candidateTokens.has(token)) {\n      hits += 1;\n      continue;\n    }\n    for (const candidate of candidateTokens) {\n      // A short prompt word inside or at the end of \"allowlist\" (\"list\") names a different concept.\n      // A prompt extension (\"regressions\") or a skill word that adds a suffix (\"plan\" -> \"planning\")\n      // stays related; one that adds a second word (\"auto\" -> \"autoreap\") does not.\n      if (token.length >= 4 && candidate.length >= 4 && (token.includes(candidate) || extendsBySuffix(token, candidate))) {\n        hits += 0.45;\n        break;\n      }\n    }\n  }\n  return Math.min(hits / Math.max(3, denominatorBasis), 1);\n}\n\nexport function isReadOnlyExplainer(promptLower: string): boolean {\n  const readOnly = /\\b(analyze|explain|inspect|summarize|list|show|tell|compare|decompose)\\b/.test(promptLower);\n  const skillSurface = /\\b(review|audit|deep[- ]research|deep[- ]review|semantic search|figma|clickup|chrome devtools|git worktree|prompt)\\b/.test(promptLower);\n  const explicitNoWrite = isNoEditRequest(promptLower);\n  if (skillSurface) return false;\n  if (readOnly && explicitNoWrite) return true;\n  if (/^\\s*(analyze|explain|inspect|summarize|list|show|tell|compare|decompose)\\b/.test(promptLower)\n    && !/\\b(then|and)\\s+(add|build|change|configure|create|edit|fix|generate|implement|modify|move|patch|refactor|rename|replace|run|save|start|update|write)\\b/.test(promptLower)) {\n    return true;\n  }\n  const write = /\\b(add|build|change|configure|create|disable[sd]?|edit|enable[sd]?|execute|fix|generate|implement|modify|patch|refactor|rename|re-?run|run|save|switch (?:on|off)|turn (?:on|off)|update|write)\\b/.test(promptLower);\n  return readOnly && !write && !skillSurface;\n}\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"cd /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research && sed -n '640,720p' .skilled/skills/system-skill-advisor/runtime/lib/scorer/fusion.ts; echo \\\"=== 860-900\\\"; sed -n '860,900p' .skilled/skills/system-skill-advisor/runtime/lib/scorer/fusion.ts; echo \\\"=== text.ts 130-175\\\"; sed -n '130,175p' .skilled/skills/system-skill-advisor/runtime/lib/scorer/text.ts\"}"},"time":{"start":1794596853504,"end":1794596854435}}}}
