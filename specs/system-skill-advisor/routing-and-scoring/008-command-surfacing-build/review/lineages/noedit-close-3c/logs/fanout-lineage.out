o-edit: to any files', 'make no changes to any files, just tell me why the advisor ranks code above docs'],\n  ['no-edit: to the repo', 'make no changes to the repo, only report the riskiest file'],\n  ['no-edit: in the source', 'make no changes in the source, just explain the ranking'],\n  ['no-edit: to it', 'make no changes to it and just list the callers'],\n  // Controls that must keep working.\n  ['control: yet', 'make no changes yet, just show the plan'],\n  ['control: change request', 'add a flag and do not change the output'],\n  ['control: bare', 'make no changes'],\n];\n\nfor (const [label, prompt] of probes) {\n  process.stdout.write(`${JSON.stringify({ label, prompt, noEdit: isNoEditRequest(prompt) })}\\n`);\n}\n\nconst route = { action: 'route', selectionKind: 'single', targets: [{ workflowMode: 'sk-create-agent' }] };\nfor (const [, prompt] of probes) {\n  process.stdout.write(`${JSON.stringify({ prompt, attached: attachCommand('sk-doc', route, prompt) })}\\n`);\n}\n\n===\n@huggingface\n@img\n@isaacs\n@jridgewell\n@oxc-project\n@protobufjs\n@rolldown\n@spec-kit\n@standard-schema\n@types\n===\nv26.13.0\n===\n{\n  \"name\": \"@spec-kit/system-skill-advisor\",\n  \"private\": true,\n  \"type\": \"module\",\n  \"main\": \"./dist/runtime/advisor-server.js\",\n  \"engines\": {\n    \"node\": \"^22.23.4 || ^24.22.1 || >=26.12.1\"\n  },\n  \"scripts\": {\n    \"clean\": \"rm -rf dist\",\n    \"prebuild\": \"node ../../system-spec-kit/runtime/cli/lib/dist-freshness.cjs prepare-build --package system-skill-advisor/runtime --entry default && node ../../system-spec-kit/runtime/cli/lib/dist-freshness.cjs prepare-build --package system-skill-advisor/runtime --entry skill-advisor-cli\",\n    \"build\": \"npm --prefix ../../system-spec-kit/shared run build && ../../system-spec-kit/node_modules/.bin/tsc -p tsconfig.build.json\",\n    \"postbuild\": \"mkdir -p dist/runtime/data && cp data/*.json dist/runtime/data/ && (node ../../system-spec-kit/runtime/cli/lib/dist-freshness.cjs record-build --package system-skill-advisor/runtime --entry default || node -e \\\"const r=require('../../system-spec-kit/runtime/cli/lib/dist-freshness.cjs').writePackageSourceHashCache('system-skill-advisor/runtime',{entry:'default'});if(r.status!=='cached')throw new Error(r.message)\\\") && (node ../../system-spec-kit/runtime/cli/lib/dist-freshness.cjs record-build --package system-skill-advisor/runtime --entry skill-advisor-cli || node -e \\\"const r=require('../../system-spec-kit/runtime/cli/lib/dist-freshness.cjs').writePackageSourceHashCache('system-skill-advisor/runtime',{entry:'skill-advisor-cli'});if(r.status!=='cached')throw new Error(r.message)\\\")\",\n    \"typecheck\": \"../../system-spec-kit/node_modules/.bin/tsc --noEmit --composite false -p tsconfig.build.json\",\n    \"test\": \"vitest run\",\n    \"test:stress\": \"SPECKIT_RUN_STRESS=true vitest run\"\n  },\n  \"dependencies\": {\n    \"@huggingface/transformers\": \"^3.8.1\",\n    \"@spec-kit/shared\": \"file:../../system-spec-kit/shared\",\n    \"better-sqlite3\": \"^12.11.1\",\n    \"chokidar\": \"^4.0.3\",\n    \"zod\": \"^4.6.7\"\n  },\n  \"overrides\": {\n    \"@hono/node-server\": \"^2.0.5\",\n    \"fast-uri\": \"^3.1.5\",\n    \"hono\": \"^4.12.34\",\n    \"ip-address\": \"^10.3.1\",\n    \"nanoid\": \"3.3.20\",\n    \"postcss\": \"^8.5.23\",\n    \"vite\": \"^8.1.2\",\n    \"protobufjs\": \"^7.6.4\",\n    \"tar\": \"^7.5.19\",\n    \"sharp\": \"^0.35.4\"\n  },\n  \"devDependencies\": {\n    \"vitest\": \"^4.1.12\"\n  }\n}\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"cd /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research && head -30 specs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/review/lineages/noedit-confirm-3b/probe-noedit.mjs; echo ===; ls .skilled/skills/system-skill-advisor/runtime/node_modules 2>/dev/null | head; echo ===; node -v; echo ===; cat .skilled/skills/system-skill-advisor/runtime/package.json | head -40\"}"},"time":{"start":1794597178168,"end":1794597179485}}}}
