r/spec-gate-prebind.mjs || { printf \\\"%s\\\\n\\\" \\\"mk-hook-drift host=cursor event=sessionStart adapter=spec-gate-prebind.mjs\\\" >&2; printf %s '{\\\"permission\\\":\\\"allow\\\",\\\"agent_message\\\":\\\"mk cursor hook could not resolve; rebuild the spec-kit runtime or restore the missing adapter\\\",\\\"mkHookDrift\\\":true}'; }\",\n    \"type\": \"command\",\n    \"timeout\": 10\n   },\n   {\n    \"command\": \"bash .skilled/bin/worktree-guard.sh || { printf \\\"%s\\\\n\\\" \\\"mk-hook-drift host=cursor event=sessionStart adapter=worktree-guard.sh\\\" >&2; printf %s '{\\\"permission\\\":\\\"allow\\\",\\\"agent_message\\\":\\\"mk cursor hook could not resolve; rebuild the spec-kit runtime or rest\n.devin/hooks.v1.json {\n \"SessionStart\": [\n  {\n   \"matcher\": \"\",\n   \"hooks\": [\n    {\n     \"type\": \"command\",\n     \"command\": \"bash -c 'cd \\\"${DEVIN_PROJECT_DIR:-$PWD}\\\" && node .skilled/skills/system-spec-kit/runtime/dist/hooks/devin/session-start.js || { printf \\\"%s\\\\n\\\" \\\"mk-hook-drift host=devin event=SessionStart adapter=session-start.js\\\" >&2; printf %s \\\"{\\\\\\\"hookSpecificOutput\\\\\\\":{\\\\\\\"hookEventName\\\\\\\":\\\\\\\"SessionStart\\\\\\\",\\\\\\\"additionalContext\\\\\\\":\\\\\\\"mk devin hook could not resolve; run npm run build in the spec-kit runtime package\\\\\\\",\\\\\\\"mkHookDrift\\\\\\\":true}}\\\"; }'\",\n     \"timeout\": 10\n    },\n    {\n     \"type\": \"command\",\n     \"command\": \"bash -c 'cd \\\"${DEVIN_PROJECT_DIR:-$PWD}\\\" && bash .skilled/bin/worktree-guard.sh'\",\n     \"timeout\": 3\n    },\n    {\n     \"type\": \"command\",\n     \"command\": \"bash -c 'cd \\\"${DEVIN_PROJECT_DIR:-$PWD}\\\" && bash .skilled/bin/check-git-hooks.sh'\",\n     \"timeout\": 3\n    },\n    {\n     \"type\": \"command\",\n     \"command\": \"bash -c 'cd \\\"${DEVIN_PROJECT_DIR:-$PWD}\\\" && python3 .skilled/skills/sk-code/sk-code-quality/scripts/check-dist-staleness.sh --all'\",\n     \"timeout\": 5\n    },\n