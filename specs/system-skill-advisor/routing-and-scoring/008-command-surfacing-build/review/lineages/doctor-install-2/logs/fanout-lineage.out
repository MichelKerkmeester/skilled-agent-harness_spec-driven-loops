{"type":"tool_use","timestamp":1794570692839,"sessionID":"ses_e2b4a18a6ffeJYEGLs0dTSiOZ0","part":{"partID":"prt_1d4bfa754002IR7bsstM4lyCaU","sessionID":"ses_e2b4a18a6ffeJYEGLs0dTSiOZ0","messageID":"msg_1d4bf85df001U9TichQdVKg6aP","type":"tool","id":"call_d7895cff9925406a924ddcf2","tool":"read","state":{"status":"completed","input":{"limit":200,"offset":1010,"path":".skilled/commands/doctor/scripts/agents-md-embed.cjs"},"output":"Read file .skilled/commands/doctor/scripts/agents-md-embed.cjs, lines 1010-1209\n1010: function missingParents(root, relative) {\n1011:   const missing = [];\n1012:   let dir = path.posix.dirname(relative);\n1013:   while (dir !== '.' && dir !== '' && !fs.existsSync(path.join(root, dir))) {\n1014:     missing.push(dir);\n1015:     dir = path.posix.dirname(dir);\n1016:   }\n1017:   return missing;\n1018: }\n1019: \n1020: // A record is data, so a recorded folder counts only while it is a proper ancestor of the\n1021: // entry's own allowlisted path; the list stops at the first one that is not.\n1022: function recordedCreatedDirs(entry) {\n1023:   const dirs = [];\n1024:   if (entry.existed || !Array.isArray(entry.createdDirs)) return dirs;\n1025:   for (const dir of entry.createdDirs) {\n1026:     if (typeof dir !== 'string' || dir === '' || dir.split('/').includes('..') || !entry.path.startsWith(`${dir}/`)) break;\n1027:     dirs.push(dir);\n1028:   }\n1029:   return dirs;\n1030: }\n1031: \n1032: // Runs after every file is back, because two new files can share one new folder. Only the\n1033: // folders above a file this restore just deleted are considered, and only an empty one is\n1034: // removed, so a hand-edited record can at most take away an empty folder on the path to a\n1035: // file the run created.\n1036: function removeCreatedDirs(root, entries, deleted) {\n1037:   const removed = [];\n1038:   for (const entry of entries) {\n1039:     if (!deleted.has(entry.path)) continue;\n1040:     for (const dir of recordedCreatedDirs(entry)) {\n1041:       const absolute = path.join(root, dir);\n1042:       let names;\n1043:       try { names = fs.readdirSync(absolute); } catch { continue; }\n1044:       if (names.length > 0) break;\n1045:       fs.rmdirSync(absolute);\n1046:       removed.push(dir);\n1047:     }\n1048:   }\n1049:   return removed;\n1050: }\n1051: \n1052: // What one path looked like before the run, kept beside a copy of it so a restore is a\n1053: // copy rather than a reconstruction.\n1054: function backupEntry(root, file) {\n1055:   const absolute = path.join(root, file.path);\n1056:   const exists = fs.existsSync(absolute);\n1057:   const entry = { path: file.path, action: file.action, existed: exists, sha256: null, backup: null, mode: null, symlink: false };\n1058:   if (!exists) {\n1059:     entry.createdDirs = missingParents(root, file.path);\n1060:     return entry;\n1061:   }\n1062:   const stats = fs.lstatSync(absolute);\n1063:   entry.mode = stats.mode.toString(8).slice(-4);\n1064:   entry.symlink = stats.isSymbolicLink();\n1065:   const bytes = fs.readFileSync(absolute);\n1066:   entry.sha256 = sha256(bytes.toString('utf8'));\n1067:   entry.backup = path.posix.join('files', file.path);\n1068:   return entry;\n1069: }\n1070: \n1071: function writeBackup({ root, manifest, composition, plan }) {\n1072:   // The plan chose a directory nothing owned, so a directory here is somebody else's run\n1073:   // finishing first: writing beside its record would make the undo ambiguous.\n1074:   if (fs.existsSync(plan.dir)) {\n1075:     throw new PreconditionError(`the backup directory ${plan.dir} already exists; nothing was written`);\n1076:   }\n1077:   fs.mkdirSync(plan.dir, { recursive: true });\n1078: \n1079:   const entries = [];\n1080:   for (const file of composition.writes) entries.push(backupEntry(root, file));\n1081:   // The pointer block is regenerated by its own tool, so it is backed up whenever the run\n1082:   // would touch it, even though this engine composes nothing for it.\n1083:   const pointerAbsolute = path.join(root, POINTER_FILE);\n1084:   if (composition.writes.some((file) => file.path === manifest.root_file) && fs.existsSync(pointerAbsolute) && !isSymlink(pointerAbsolute)) {\n1085:     entries.push(backupEntry(root, { path: POINTER_FILE, action: 'regenerated' }));\n1086:   }\n1087: \n1088:   // The backup and its record are written by plain fs, never by the caller's write hook:\n1089:   // the rollback must not share a path with the writer it exists to undo.\n1090:   for (const entry of entries) {\n1091:     if (!entry.existed) continue;\n1092:     const destination = path.join(plan.dir, entry.backup);\n1093:     fs.mkdirSync(path.dirname(destination), { recursive: true });\n1094:     fs.copyFileSync(path.join(root, entry.path), destination);\n1095:   }\n1096: \n1097:   const record = {\n1098:     schema: 1,\n1099:     root,\n1100:     created_at: utcStamp(),\n1101:     plan_digest: plan.digest,\n1102:     paths: entries,\n1103:   };\n1104:   fs.writeFileSync(path.join(plan.dir, 'manifest.json'), `${JSON.stringify(record, null, 2)}\\n`, 'utf8');\n1105:   return record;\n1106: }\n1107: \n1108: // ─────────────────────────────────────────────────────────────────────────────\n1109: // 13. THE DIFF\n1110: // ─────────────────────────────────────────────────────────────────────────────\n1111: \n1112: function diffLines(text) {\n1113:   if (text === null) return [];\n1114:   const lines = String(text).split('\\n');\n1115:   if (lines.length > 0 && lines[lines.length - 1] === '') lines.pop();\n1116:   return lines;\n1117: }\n1118: \n1119: function diffOps(left, right) {\n1120:   const rows = left.length + 1;\n1121:   const columns = right.length + 1;\n1122:   const table = Array.from({ length: rows }, () => new Uint32Array(columns));\n1123:   for (let i = left.length - 1; i >= 0; i -= 1) {\n1124:     for (let j = right.length - 1; j >= 0; j -= 1) {\n1125:       table[i][j] = left[i] === right[j]\n1126:         ? table[i + 1][j + 1] + 1\n1127:         : Math.max(table[i + 1][j], table[i][j + 1]);\n1128:     }\n1129:   }\n1130:   const ops = [];\n1131:   let i = 0;\n1132:   let j = 0;\n1133:   while (i < left.length && j < right.length) {\n1134:     if (left[i] === right[j]) {\n1135:       ops.push({ kind: ' ', text: left[i] });\n1136:       i += 1;\n1137:       j += 1;\n1138:     } else if (table[i + 1][j] >= table[i][j + 1]) {\n1139:       ops.push({ kind: '-', text: left[i] });\n1140:       i += 1;\n1141:     } else {\n1142:       ops.push({ kind: '+', text: right[j] });\n1143:       j += 1;\n1144:     }\n1145:   }\n1146:   while (i < left.length) {\n1147:     ops.push({ kind: '-', text: left[i] });\n1148:     i += 1;\n1149:   }\n1150:   while (j < right.length) {\n1151:     ops.push({ kind: '+', text: right[j] });\n1152:     j += 1;\n1153:   }\n1154:   return ops;\n1155: }\n1156: \n1157: /**\n1158:  * A unified diff with three lines of context, which is what makes a plan reviewable.\n1159:  *\n1160:  * @param {string|null} beforeText\n1161:  * @param {string|null} afterText\n1162:  * @param {string} relative\n1163:  * @returns {string[]}\n1164:  */\n1165: function unifiedDiff(beforeText, afterText, relative) {\n1166:   const left = diffLines(beforeText);\n1167:   const right = diffLines(afterText);\n1168:   const ops = diffOps(left, right);\n1169:   if (!ops.some((op) => op.kind !== ' ')) return [];\n1170: \n1171:   const changed = ops.map((op, index) => (op.kind === ' ' ? -1 : index)).filter((index) => index !== -1);\n1172:   const hunks = [];\n1173:   for (const index of changed) {\n1174:     const start = Math.max(0, index - 3);\n1175:     const end = Math.min(ops.length, index + 4);\n1176:     const last = hunks[hunks.length - 1];\n1177:     if (last && start <= last.end) last.end = Math.max(last.end, end);\n1178:     else hunks.push({ start, end });\n1179:   }\n1180: \n1181:   const output = [`--- ${beforeText === null ? '/dev/null' : `a/${relative}`}`, `+++ ${afterText === null ? '/dev/null' : `b/${relative}`}`];\n1182:   let consumed = 0;\n1183:   for (const hunk of hunks) {\n1184:     // A create has no left side and a removal has no right side, so their cursors start at\n1185:     // zero rather than at the first line of a file that is not there.\n1186:     let leftCursor = beforeText === null ? 0 : 1;\n1187:     let rightCursor = afterText === null ? 0 : 1;\n1188:     for (let index = 0; index < hunk.start; index += 1) {\n1189:       if (ops[index].kind !== '+') leftCursor += 1;\n1190:       if (ops[index].kind !== '-') rightCursor += 1;\n1191:     }\n1192:     const slice = ops.slice(hunk.start, hunk.end);\n1193:     const leftCount = slice.filter((op) => op.kind !== '+').length;\n1194:     const rightCount = slice.filter((op) => op.kind !== '-').length;\n1195:     output.push(`@@ -${leftCursor},${leftCount} +${rightCursor},${rightCount} @@`);\n1196:     for (const op of slice) output.push(`${op.kind}${op.text}`);\n1197:     consumed += slice.length;\n1198:   }\n1199:   return consumed === 0 ? [] : output;\n1200: }\n1201: \n1202: // ─────────────────────────────────────────────────────────────────────────────\n1203: // 14. THE PLAN\n1204: // ─────────────────────────────────────────────────────────────────────────────\n1205: \n1206: function renderTargets(composition) {\n1207:   return composition.files.map((file) => `target ${file.path}: ${file.action}`);\n1208: }\n1209: \n[Output truncated. Continue reading with offset: 1210]","title":"read","metadata":{"metadata":{"truncated":true},"content":[{"type":"text","text":"Read file .skilled/commands/doctor/scripts/agents-md-embed.cjs, lines 1010-1209\n1010: function missingParents(root, relative) {\n1011:   const missing = [];\n1012:   let dir = path.posix.dirname(relative);\n1013:   while (dir !== '.' && dir !== '' && !fs.existsSync(path.join(root, dir))) {\n1014:     missing.push(dir);\n1015:     dir = path.posix.dirname(dir);\n1016:   }\n1017:   return missing;\n1018: }\n1019: \n1020: // A