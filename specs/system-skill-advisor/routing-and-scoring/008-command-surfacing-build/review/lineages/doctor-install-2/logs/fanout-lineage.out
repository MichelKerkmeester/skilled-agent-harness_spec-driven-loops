 { state: PASS, kind: 'absent', detail: 'absent, which the checklist allows' };\n711:   }\n712: \n713:   if (isSymlink(target)) {\n714:     const link = fs.readlinkSync(target);\n715:     // A path the checklist expects to be absent is one no runtime should load, and a link\n716:     // there loads the root document under that name just as a copy would.\n717:     if (expectsAbsent) {\n718:       return { state: FINDING, kind: 'symlink where none belongs', detail: `links to ${link}, where the checklist expects no file` };\n719:     }\n720:     const pointsAtRoot = path.basename(link) === manifest.root_file;\n721:     if (pointsAtRoot) return { state: PASS, kind: 'symlink', detail: `links to ${link}` };\n722:     return { state: FINDING, kind: 'symlink elsewhere', detail: `links to ${link} instead of ${manifest.root_file}` };\n723:   }\n724: \n725:   const content = fs.readFileSync(target, 'utf8');\n726:   if (!context.exists) {\n727:     return { state: FINDING, kind: 'sole instruction file', detail: `there is no ${manifest.root_file} for it to point at` };\n728:   }\n729:   if (content === context.text) {\n730:     return { state: FINDING, kind: 'identical copy', detail: `byte-identical to ${manifest.root_file}, so the two will drift` };\n731:   }\n732: \n733:   const unique = localLinesOf(content, context.text);\n734:   const rootLines = trimmedLines(context.text);\n735:   const sharesShippedLine = [...trimmedLines(content)].some((line) => rootLines.has(line));\n736:   const namesRoot = [...trimmedLines(content)].some((line) => line.includes(manifest.root_file));\n737:   // A pointer is a file that carries no shipped line and names the root document. Anything\n738:   // else is either a copy or a copy plus local lines, and both drift: the second also\n739:   // loses text when it is replaced, so the lines only it carries are listed.\n740:   if (!sharesShippedLine && namesRoot) {\n741:     return { state: PASS, kind: 'pointer', detail: `names ${manifest.root_file} and carries no shipped line` };\n742:   }\n743:   return { state: FINDING, kind: 'divergent copy', detail: `${unique.length} line(s) only this file carries`, lines: unique };\n744: }\n745: \n746: function isSymlink(target) {\n747:   try {\n748:     return fs.lstatSync(target).isSymbolicLink();\n749:   } catch {\n[Output truncated. Continue reading with offset: 750]"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"limit\":80,\"offset\":670,\"path\":\".skilled/commands/doctor/scripts/agents-md-check.cjs\"}"},"time":{"start":1794570369079,"end":1794570369986}}}}
