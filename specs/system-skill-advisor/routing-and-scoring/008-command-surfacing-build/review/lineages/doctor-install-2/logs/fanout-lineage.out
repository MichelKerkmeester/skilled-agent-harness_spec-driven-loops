ized)) {\n910:     throw new AllowlistError(`${relative} is not on the write allowlist (${ALLOWLIST.join(', ')})`);\n911:   }\n912:   // Every path a run reaches must sit inside the root where the root really is, not only\n913:   // under its name: a link inside the tree can aim a legal-looking path at a file outside it.\n914:   const realBase = fs.realpathSync(base);\n915:   const realTarget = resolveThroughLinks(absolute);\n916:   if (realTarget !== realBase && !realTarget.startsWith(realBase + path.sep)) {\n917:     throw new AllowlistError(`${relative} resolves outside the target root ${realBase} through a link`);\n918:   }\n919:   return absolute;\n920: }\n921: \n922: // The real path of a path that may not exist yet: the nearest existing ancestor is resolved\n923: // and the rest of the name is appended to it.\n924: function resolveThroughLinks(absolute) {\n925:   try {\n926:     return fs.realpathSync(absolute);\n927:   } catch {\n928:     const parent = path.dirname(absolute);\n929:     if (parent === absolute) return absolute;\n930:     return path.join(resolveThroughLinks(parent), path.basename(absolute));\n931:   }\n932: }\n933: \n934: // ─────────────────────────────────────────────────────────────────────────────\n935: // 12. BACKUPS\n936: // ─────────────────────────────────────────────────────────────────────────────\n937: \n938: function utcStamp(date = new Date()) {\n939:   return date.toISOString().replace(/[-:]/gu, '').replace(/\\.\\d+Z$/u, 'Z');\n940: }\n941: \n942: /**\n943:  * The directory a plan's backup sits in, named after the plan digest.\n944:  *\n945:  * Named by the digest rather than by a clock reading because apply has to land exactly\n946:  * where the plan pointed and the digest is the only thing the operator carries across. The\n947:  * consequence is that a directory is a plan's own: a second plan of the same work finds it\n948:  * taken and moves to the next ordinal instead of writing beside it.\n949:  *\n950:  * @param {string} base\n951:  * @param {string} digest\n952:  * @returns {string}\n953:  */\n954: function backupDirectoryOf(base, digest) {\n955:   return path.join(base, digest.slice(0, BACKUP_NAME_CHARS));\n956: }\n957: \n958: /**\n959:  * Where a run's backup goes, without creating anything.\n960:  *\n961:  * The output directory is used only when git ignores it, because a backup inside a tracked\n962:  * path is a backup the next commit publishes. Everything else leaves the repository.\n963:  *\n964:  * @param {{root: string}} input\n965:  * @returns {{dir: string, fallback: boolean, reason: string}}\n966:  */\n967: function backupBase({ root }) {\n968:   const candidate = path.join(root, BACKUP_DIR);\n969:   // The question is the one the run depends on: would a plan directory under this one be\n970:   // published by the next commit? Asking about the base alone would miss a rule written as\n971:   // `.skilled/output/*`, which ignores the per-plan directories and not their parent, so\n972:   // the probe is a path of the same shape as the one the plan takes.\n973:   const probe = path.join(candidate, 'probe');\n974:   const ignored = spawnSync('git', ['-C', root, '-c', 'core.fsmonitor=false', 'check-ignore', '-q', probe], {\n975:     encoding: 'utf8',\n976:     timeout: TOOL_TIMEOUT_MS,\n977:   });\n978:   if (ignored.status === 0) return { dir: candidate, fallback: false, reason: '' };\n979:   const reason = ignored.status === 1\n980:     ? `git does not ignore ${BACKUP_DIR} under ${root}`\n981:     : `git cannot answer whether ${BACKUP_DIR} is ignored under ${root} (exit ${ignored.status})`;\n982:   return { dir: path.join(os.tmpdir(), BACKUP_FALLBACK_DIR), fallback: true, reason };\n983: }\n984: \n985: /**\n986:  * The plan a run stands on: the composition, plus where its backup goes and the digest\n987:  * that says both.\n988:  *\n989:  * The loop is what makes a re-plan honest. A directory an earlier run already holds is not\n990:  * suffixed into a second name, because the printed undo command would then point at that\n991:  * run's bytes; the next ordinal is a different plan with a different digest and a\n992:  * directory of its own.\n993:  *\n994:  * @param {Object} composition\n995:  * @returns {{dir: string, fallback: boolean, reason: string, digest: string, ordinal: number, base: string}}\n996:  */\n997: function planFor(composition) {\n998:   const base = backupBase({ root: composition.root });\n999:   for (let ordinal = 0; ordinal < BACKUP_ATTEMPTS; ordinal += 1) {\n1000:     const digest = planDigest(composition, { ordinal, base: base.dir });\n1001:     const dir = backupDirectoryOf(base.dir, digest);\n1002:     if (!fs.existsSync(dir)) return { dir, fallback: base.fallback, reason: base.reason, digest, ordinal, base: base.dir };\n1003:   }\n1004:   throw new PreconditionError(`every backup directory for this composition under ${base.dir} is taken, so nothing was written`);\n1005: }\n1006: \n1007: // The folders a new file needs that do not exist yet, deepest first. A restore removes\n1008: // only these, so on a record the run wrote, a folder that was there before the run is never\n1009: // taken away with it.\n[Output truncated. Continue reading with offset: 1010]"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"limit\":340,\"offset\":670,\"path\":\".skilled/commands/doctor/scripts/agents-md-embed.cjs\"}"},"time":{"start":1794570315449,"end":1794570315763}}}}
