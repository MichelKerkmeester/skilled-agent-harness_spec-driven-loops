{"type":"tool_use","timestamp":1794570344185,"sessionID":"ses_e2b4a18a6ffeJYEGLs0dTSiOZ0","part":{"partID":"prt_1d4ba5535001WbQGl0ITrSlj4H","sessionID":"ses_e2b4a18a6ffeJYEGLs0dTSiOZ0","messageID":"msg_1d4ba37f7001q66GmsD4XewfF0","type":"tool","id":"call_ee16082a2ebb45be91a8c95f","tool":"shell","state":{"status":"completed","input":{"command":"git diff 320e7b64d4..HEAD -- .skilled/commands/doctor/scripts/codex-hook-approval-check.cjs .skilled/commands/doctor/scripts/hook-wiring-check.cjs"},"output":"diff --git a/.skilled/commands/doctor/scripts/codex-hook-approval-check.cjs b/.skilled/commands/doctor/scripts/codex-hook-approval-check.cjs\nindex a1baf05d30..23bf7341c8 100644\n--- a/.skilled/commands/doctor/scripts/codex-hook-approval-check.cjs\n+++ b/.skilled/commands/doctor/scripts/codex-hook-approval-check.cjs\n@@ -45,7 +45,9 @@ const USAGE = 'Usage: codex-hook-approval-check.cjs [--root <dir>] [--config <pa\n // 3. HELPERS\n // ─────────────────────────────────────────────────────────────────────────────\n \n-// A misspelled or value-less flag must fail loudly rather than read another root.\n+// A misspelled or value-less flag must fail loudly rather than read another root,\n+// and a value that is itself a flag means the value was left out, so taking it\n+// would swallow the next option and read a root nobody named.\n function parseArgs(argv) {\n   const options = { root: process.cwd(), config: null, json: false };\n   for (let index = 0; index < argv.length; index += 1) {\n@@ -56,7 +58,7 @@ function parseArgs(argv) {\n     }\n     if (arg === '--root' || arg === '--config') {\n       const value = argv[index + 1];\n-      if (value === undefined || value === '') return null;\n+      if (value === undefined || value === '' || value.startsWith('-')) return null;\n       options[arg.slice(2)] = value;\n       index += 1;\n       continue;\n@@ -169,12 +171,16 @@ function main(argv) {\n   }\n \n   if (entry.kind === 'absent') {\n+    // An absent entry has no approval to offer yet, so the repair starts with the\n+    // copy that creates it and ends with the approval that lets it run.\n+    const repair = `repair: copy the advisor UserPromptSubmit entry from the Skilled checkout's .codex/hooks.json into ${hooksFile}, then approve it with /hooks in a Codex session`;\n     report(options, {\n       status: 'warn',\n       code: 'codex-advisor-hook-absent',\n       root,\n       hooksFile,\n-    }, ['WARN codex-advisor-hook-absent']);\n+      repair,\n+    }, ['WARN codex-advisor-hook-absent', repair]);\n     return 1;\n   }\n \ndiff --git a/.skilled/commands/doctor/scripts/hook-wiring-check.cjs b/.skilled/commands/doctor/scripts/hook-wiring-check.cjs\nindex ab63923ef3..7e7b29fa3f 100644\n--- a/.skilled/commands/doctor/scripts/hook-wiring-check.cjs\n+++ b/.skilled/commands/doctor/scripts/hook-wiring-check.cjs\n@@ -100,8 +100,9 @@ function parseArgs(argv) {\n \n // Hook files either wrap their events in a `hooks` object or place them at the\n // top level, and the cursor file omits the nested hook array the others carry.\n-// Searching the event payload's JSON text covers all three shapes without\n-// teaching this check each dialect.\n+// A mention is not a wired hook, so only a command that runs the script counts:\n+// the event's entries and their nested hooks arrays are walked for command\n+// entries, and a runtime is wired when one starts node on the marker path.\n function eventPayload(document, event) {\n   if (!document || typeof document !== 'object') return undefined;\n   if (document.hooks && typeof document.hooks === 'object' && event in document.hooks) {\n@@ -111,6 +112,42 @@ function eventPayload(document, event) {\n   return undefined;\n }\n \n+function stripQuotes(token) {\n+  return token.replace(/^['\"]+|['\"]+$/g, '');\n+}\n+\n+function collectCommands(node, commands) {\n+  if (Array.isArray(node)) {\n+    for (const entry of node) collectCommands(entry, commands);\n+  } else if (node && typeof node === 'object') {\n+    if (node.type === 'command' && typeof node.command === 'string') commands.push(node.command);\n+    if (Array.isArray(node.hooks)) collectCommands(node.hooks, commands);\n+  }\n+  return commands;\n+}\n+\n+function isNodeExecutable(token) {\n+  return token === 'node' || token.endsWith('/node');\n+}\n+\n+function startsCommand(tokens, index) {\n+  if (index === 0) return true;\n+  const previous = tokens[index - 1];\n+  if (previous === '&&' || previous === '||' || previous === ';' || previous === '|') return true;\n+  return previous === '-c'\n+    && index >= 2\n+    && (tokens[index - 2] === 'bash' || tokens[index - 2] === 'sh');\n+}\n+\n+// An argument that only names node, as `echo node <script>` does, runs\n+// nothing, so node must stand where a shell starts a command.\n+function runsMarker(command, marker) {\n+  const tokens = command.split(/\\s+/).filter(Boolean).map(stripQuotes);\n+  return tokens.some((token, index) => isNodeExecutable(token)\n+    && startsCommand(tokens, index)\n+    && (tokens[index + 1] || '').endsWith(marker));\n+}\n+\n function inspect(runtime, root) {\n   const file = path.join(root, runtime.file);\n   let document;\n@@ -120,7 +157,7 @@ function inspect(runtime, root) {\n     return { runtime: runtime.id, file: runtime.file, status: 'hook-missing' };\n   }\n   const payload = eventPayload(document, runtime.event);\n-  const wired = payload !== undefined && JSON.stringify(payload).includes(runtime.marker);\n+  const wired = collectCommands(payload, []).some((command) => runsMarker(command, runtime.marker));\n   return { runtime: runtime.id, file: runtime.file, status: wired ? 'ok' : 'hook-missing' };\n }\n \n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"diff --git a/.skilled/commands/doctor/scripts/codex-hook-approval-check.cjs b/.skilled/commands/doctor/scripts/codex-hook-approval-check.cjs\nindex a1baf05d30..23bf7341c8 100644\n--- a/.skilled/commands/doctor/scripts/codex-hook-approval-check.cjs\n+++ b/.skilled/commands/doctor/scripts/codex-hook-approval-check.cjs\n@@ -45,7 +45,9 @@ const USAGE = 'Usage: codex-hook-approval-check.cjs [--root <dir>] [--config <pa\n // 3. HELPERS\n // ─────────────────────────────────────────────────────────────────────────────\n \n-// A misspelled or value-less flag must fail loudly rather than read another root.\n+// A misspelled or value-less flag must fail loudly rather than read another root,\n+// and a value that is itself a flag means the value was left out, so taking it\n+// would swallow the next option and read a root nobody named.\n function parseArgs(argv) {\n   const options = { root: process.cwd(), config: null, json: false };\n   for (let index = 0; index < argv.length; index += 1) {\n@@ -56,7 +58,7 @@ function parseArgs(argv) {\n     }\n     if (arg === '--root' || arg === '--config') {\n       const value = argv[index + 1];\n-      if (value === undefined || value === '') return null;\n+      if (value === undefined || value === '' || value.startsWith('-')) return null;\n       options[arg.slice(2)] = value;\n       index += 1;\n       continue;\n@@ -169,12 +171,16 @@ function main(argv) {\n   }\n \n   if (entry.kind === 'absent') {\n+    // An absent entry has no approval to offer yet, so the repair starts with the\n+    // copy that creates it and ends with the approval that lets it run.\n+    const repair = `repair: copy the advisor UserPromptSubmit entry from the Skilled checkout's .codex/hooks.json into ${hooksFile}, then approve it with /hooks in a Codex session`;\n     report(options, {\n       status: 'warn',\n       code: 'codex-advisor-hook-absent',\n       root,\n       hooksFile,\n-    }, ['WARN codex-advisor-hook-absent']);\n+      repair,\n+    }, ['WARN codex-advisor-hook-absent', repair]);\n     return 1;\n   }\n \ndiff --git a/.skilled/commands/doctor/scripts/hook-wiring-check.cjs b/.skilled/commands/doctor/scripts/hook-wiring-check.cjs\nindex ab63923ef3..7e7b29fa3f 100644\n--- a/.skilled/commands/doctor/scripts/hook-wiring-check.cjs\n+++ b/.skilled/commands/doctor/scripts/hook-wiring-check.cjs\n@@ -100,8 +100,9 @@ function parseArgs(argv) {\n \n // Hook files either wrap their events in a `hooks` object or place them at the\n // top level, and the cursor file omits the nested hook array the others carry.\n-// Searching the event payload's JSON text covers all three shapes without\n-// teaching this check each dialect.\n+// A mention is not a wired hook, so only a command that runs the script counts:\n+// the event's entries and their nested hooks arrays are walked for command\n+// entries, and a runtime is wired when one starts node on the marker path.\n function eventPayload(document, event) {\n   if (!document || typeof document !== 'object') return undefined;\n   if (document.hooks && typeof document.hooks === 'object' && event in document.hooks) {\n@@ -111,6 +112,42 @@ function eventPayload(document, event) {\n   return undefined;\n }\n \n+function stripQuotes(token) {\n+  return token.replace(/^['\"]+|['\"]+$/g, '');\n+}\n+\n+function collectCommands(node, commands) {\n+  if (Array.isArray(node)) {\n+    for (const entry of node) collectCommands(entry, commands);\n+  } else if (node && typeof node === 'object') {\n+    if (node.type === 'command' && typeof node.command === 'string') commands.push(node.command);\n+    if (Array.isArray(node.hooks)) collectCommands(node.hooks, commands);\n+  }\n+  return commands;\n+}\n+\n+function isNodeExecutable(token) {\n+  return token === 'node' || token.endsWith('/node');\n+}\n+\n+function startsCommand(tokens, index) {\n+  if (index === 0) return true;\n+  const previous = tokens[index - 1];\n+  if (previous === '&&' || previous === '||' || previous === ';' || previous === '|') return true;\n+  return previous === '-c'\n+    && index >= 2\n+    && (tokens[index - 2] === 'bash' || tokens[index - 2] === 'sh');\n+}\n+\n+// An argument that only names node, as `echo node <script>` does, runs\n+// nothing, so node must stand where a shell starts a command.\n+function runsMarker(command, marker) {\n+  const tokens = command.split(/\\s+/).filter(Boolean).map(stripQuotes);\n+  return tokens.some((token, index) => isNodeExecutable(token)\n+    && startsCommand(tokens, index)\n+    && (tokens[index + 1] || '').endsWith(marker));\n+}\n+\n function inspect(runtime, root) {\n   const file = path.join(root, runtime.file);\n   let document;\n@@ -120,7 +157,7 @@ function inspect(runtime, root) {\n     return { runtime: runtime.id, file: runtime.file, status: 'hook-missing' };\n   }\n   const payload = eventPayload(document, runtime.event);\n-  const wired = payload !== undefined && JSON.stringify(payload).includes(runtime.marker);\n+  const wired = collectCommands(payload, []).some((command) => runsMarker(command, runtime.marker));\n   return { runtime: runtime.id, file: runtime.file, status: wired ? 'ok' : 'hook-missing' };\n }\n \n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"git diff 320e7b64d4..HEAD -- .skilled/commands/doctor/scripts/codex-hook-approval-check.cjs .skilled/commands/doctor/scripts/hook-wiring-check.cjs\"}"},"time":{"start":1794570343733,"end":1794570344185}}}}
{"type":"tool_use","timestamp":1794570344193,"sessionID":"ses_e2b4a18a6ffeJYEGLs0dTSiOZ0","part":{"partID":"prt_1d4ba5406002SoC4Vz1pcChHfy","sessionID":"ses_e2b4a18a6ffeJYEGLs0dTSiOZ0","messageID":"msg_1d4ba37f7001q66GmsD4XewfF0","type":"tool","id":"call_9129b1ec9a3a4d2c85fd23fe","tool":"shell","state":{"status":"completed","input":{"command":"git diff 320e7b64d4..HEAD -- .skilled/commands/doctor/scripts/agents-md-check.cjs .skilled/commands/doctor/scripts/README.markdown"},"output":"diff --git a/.skilled/commands/doctor/scripts/README.markdown b/.skilled/commands/doctor/scripts/README.markdown\nindex a64b7e6748..c52af5910d 100644\n--- a/.skilled/commands/doctor/scripts/README.markdown\n+++ b/.skilled/commands/doctor/scripts/README.markdown\n@@ -99,8 +99,8 @@ The scripts validate route manifests, inspect MCP installations, audit parent sk\n | `sk-code-quality-config.cjs` | The quality config doctor's entry, kept thin: the arguments, the run context, the one call that starts the runner, the mode table and the exit status are here, and each mode sits in the quality modules under `lib/`. It reports which quality config the sk-code quality gate reads, whether each tool it names is on PATH, and the trust state the runner applies to that config: `trusted`, `untrusted` or `none`. `status` and `check` both print it, and when the config is untrusted they print `git config --local skilled.trustRepoChecks true` as the repair. It prints the hygiene layers, a `Hygiene:` line naming the core rules `commentHygiene.disableRules` switches off and an applied-rules block built by calling `quality-gate.cjs --explain` over a sample of one file per first three folders and extension: each checklist with its seat, its override rows or the reasons its section was refused, each same-level conflict and a `Hygiene rules:` line for the rules in force. A refused section, an unknown rule id or a missing checklist fails the status with `CONFIG_INVALID` or `CHECKLIST_MISSING`, and a conflict is listed without failing it. It validates that config and creates `.skilled/skills/sk-code/sk-code-quality/repository/quality.json` once from the shipped template for `/doctor:sk-code quality`, and in a repository with no `specs/` folder its plan suggests the spec-kit hygiene rules without writing them. It never runs a command the config names. It exits 0 on success, 1 on an invalid or missing config, a refused checklist section or a refused init and 2 on a usage error or outside a git repository. |\n | `audit_descriptions.py` | Audits description lengths across skills, commands and agents. |\n | `agent-roster-mirror-check.cjs` | Verifies every canonical agent reaches all five runtime surfaces, and that mirror surfaces stay symlinked rather than forked. `--check` is accepted and ignored, because it is read-only either way. |\n-| `agents-md-check.cjs` | The read-only AGENTS.md check: twelve rows reporting the install state, the sections lost or reordered, the currency of each body, every pin, the delivery budget, the shape of the repository block, the repository's own content and its local edits, each runtime copy, the `REPO RULES.md` router and the source template's purity. Three of them run their owner as a child instead of re-deriving it, carrying the rule-copy canary's budget lines, the gate 1 pointer sync's Cursor block and the repo-rules checker's summary. `--root <dir>` classifies another repository and `--json` prints the same report for a machine. A row it cannot prove reads `UNKNOWN` rather than `PASS`, so it exits 0 on no finding, 1 on a finding or an unproven row and 2 on a failed precondition. |\n-| `agents-md-embed.cjs` | The writing half of `/doctor:agents-md`, in three subcommands. `plan` composes every target in memory and prints the targets, the diffs, the new block, the byte budget, the preservation ledger, the backup folder and the plan digest, and writes nothing. `apply --plan-digest <digest>` recomposes, refuses a digest the tree no longer produces, backs up every path it will touch, writes only inside the allowlist it checks in code and then proves the composition against the bytes on disk, restoring from the backup and ending `STATUS=FAIL` when one line went missing. `restore --run=<dir>` puts back exactly the paths that run's `manifest.json` records, removes the files, and the empty folders, that run created, and keeps the backup. It exits 0 when there was nothing to do or the work finished, 1 on a failed proof or a declined run and 2 on a failed precondition or a path outside the allowlist. |\n+| `agents-md-check.cjs` | The read-only AGENTS.md check: twelve rows reporting the install state, the sections lost or reordered, the currency of each body, every pin, the delivery budget, the shape of the repository block, the repository's own content and its local edits, each runtime copy, the `REPO RULES.md` router and the source template's purity. Four of them run their owner as a child instead of re-deriving it, carrying the rule-copy canary's budget lines, the gate 1 pointer sync's Cursor block, the repo-rules checker's summary and the manifest generator's check of the source template's purity. `--root <dir>` classifies another repository and `--json` prints the same report for a machine. A row it cannot prove reads `UNKNOWN` rather than `PASS`, so it exits 0 on no finding, 1 on a finding or an unproven row and 2 on a failed precondition. |\n+| `agents-md-embed.cjs` | The writing half of `/doctor:agents-md`, in three subcommands. `plan` composes every target in memory and prints the targets, the diffs, the new block, the byte budget, the preservation ledger, the backup folder and the plan digest, and writes nothing. `apply --plan-digest <digest>` recomposes, refuses a digest the tree no longer produces, backs up every path it will touch, writes only inside the allowlist it checks in code and then proves the composition against the bytes on disk, restoring from the backup and ending `STATUS=FAIL` when one line went missing or one appeared outside the block that no shipped section carries. It refuses a symlinked `REPO RULES.md` or Cursor mirror it would write, because a write through the link would change a file the repository does not own. `restore --run=<dir>` puts back exactly the paths that run's `manifest.json` records, removes the files, and the empty folders, that run created, and keeps the backup. It exits 0 when there was nothing to do or the work finished, 1 on a failed proof or a declined run and 2 on a failed precondition or a path outside the allowlist. It exits 3 when a write fails after the backup, having restored from it or said why not. |\n | `agents-md-manifest.cjs` | Generates and gates the shipped manifest's `derived` key: a copy of every shipped body, its hash and the router rows, taken from the root documents. `--write` refreshes it and `--check` is the freshness gate, so a body that drifted from the template fails here instead of surfacing as a check finding. It refuses a heading no authored entry matches, an authored entry that matches nothing, and text above the first heading, and `--write` runs only in the repository that ships the template. Each of the three engines has its own suite: `agents-md-check.test.cjs`, `agents-md-embed.test.cjs` and `agents-md-manifest.test.cjs`, driven from the recipe folders under `tests/fixtures/agents-md/`. |\n | `git-hook-gates.cjs` | Lists the shipped hook gates from `scripts/git-hooks/lib/gates.tsv` with their saved `speckit.hooks.<key>` values, and sets or unsets one in local or global git config for `/doctor:git hooks`. Refuses the per-push approvals. |\n | `git-standards.cjs` | Shows where a repository's commit, PR and branch rules come from, copies the shipped sk-git templates into `.sk-git/`, and changes a rules block setting or removes a kind's rules section in those copies for `/doctor:git standards`, re-validating each change with sk-git's own contract check. |\ndiff --git a/.skilled/commands/doctor/scripts/agents-md-check.cjs b/.skilled/commands/doctor/scripts/agents-md-check.cjs\nindex c2e4f5f357..94d9578369 100644\n--- a/.skilled/commands/doctor/scripts/agents-md-check.cjs\n+++ b/.skilled/commands/doctor/scripts/agents-md-check.cjs\n@@ -12,9 +12,10 @@\n // from one that would drop a line somebody wrote. So this engine reports, per row and\n // without writing a byte, what the repository holds against the manifest.\n //\n-// Three of the twelve rows are answers this engine must not invent. The delivery budget\n+// Four of the twelve rows are answers this engine must not invent. The delivery budget\n // and its anchors belong to the rule-copy canary, the Cursor pointer block belongs to\n-// the gate 1 sync, and the router belongs to the repo-rules checker. Each already has\n+// the gate 1 sync, the router belongs to the repo-rules checker and the source\n+// template's purity belongs to the manifest generator's check. Each already has\n // tests and an owner, so each is run as a child process and its own lines are carried\n // into the report; re-deriving any of them here would be a second opinion that drifts\n // from the first. The rest are pure classifiers over one read of the target tree.\n@@ -635,7 +636,7 @@ function rowRuntimeCopies(context, manifest, tools) {\n \n   for (const expected of manifest.runtime_copies || []) {\n     const verdict = copyVerdict(expected, context, manifest, tools);\n-    entries.push({ path: expected.path, kind: verdict.kind, state: verdict.state, lines: verdict.lines || [] });\n+    entries.push({ path: expected.path, kind: verdict.kind, state: verdict.state, detail: verdict.detail, lines: verdict.lines || [] });\n     // A copy nobody could measure is printed like a finding: a pass line with no detail\n     // reads as a copy that was checked and found right.\n     if (verdict.state === FINDING || verdict.state === UNKNOWN || verdict.kind === 'pointer missing') {\n@@ -645,8 +646,11 @@ function rowRuntimeCopies(context, manifest, tools) {\n \n   const failed = entries.filter((entry) => entry.state === FINDING);\n   const unmeasured = entries.filter((entry) => entry.state === UNKNOWN);\n+  // A missing pointer is a route the runtime does not have, not a copy that was checked.\n+  const pointerMissing = entries.filter((entry) => entry.kind === 'pointer missing');\n+  const expected = entries.length - failed.length - unmeasured.length - pointerMissing.length;\n   const state = failed.length > 0 ? FINDING : (unmeasured.length > 0 ? UNKNOWN : PASS);\n-  const detail = `${entries.length - failed.length - unmeasured.length}/${entries.length} copies as expected${unmeasured.length > 0 ? `, ${unmeasured.length} unmeasured` : ''}`;\n+  const detail = `${expected}/${entries.length} copies as expected${unmeasured.length > 0 ? `, ${unmeasured.length} unmeasured` : ''}${pointerMissing.length > 0 ? `, ${pointerMissing.length} pointer missing` : ''}`;\n   return row('A10', 'runtime copies', state, detail, { lines, entries });\n }\n \n@@ -708,6 +712,11 @@ function copyVerdict(expected, context, manifest, tools) {\n \n   if (isSymlink(target)) {\n     const link = fs.readlinkSync(target);\n+    // A path the checklist expects to be absent is one no runtime should load, and a link\n+    // there loads the root document under that name just as a copy would.\n+    if (expectsAbsent) {\n+      return { state: FINDING, kind: 'symlink where none belongs', detail: `links to ${link}, where the checklist expects no file` };\n+    }\n     const pointsAtRoot = path.basename(link) === manifest.root_file;\n     if (pointsAtRoot) return { state: PASS, kind: 'symlink', detail: `links to ${link}` };\n     return { state: FINDING, kind: 'symlink elsewhere', detail: `links to ${link} instead of ${manifest.root_file}` };\n@@ -729,7 +738,7 @@ function copyVerdict(expected, context, manifest, tools) {\n   // else is either a copy or a copy plus local lines, and both drift: the second also\n   // loses text when it is replaced, so the lines only it carries are listed.\n   if (!sharesShippedLine && namesRoot) {\n-    return { state: PASS, kind: 'pointer', detail: `every line names ${manifest.root_file}` };\n+    return { state: PASS, kind: 'pointer', detail: `names ${manifest.root_file} and carries no shipped line` };\n   }\n   return { state: FINDING, kind: 'divergent copy', detail: `${unique.length} line(s) only this file carries`, lines: unique };\n }\n@@ -753,12 +762,19 @@ function rowRouter(context, manifest, tools) {\n \n   const text = fs.readFileSync(routerPath, 'utf8');\n   const shipped = (manifest.derived && manifest.derived.repo_rules) || { trigger_rows: [], index_rows: [] };\n-  const lines = [];\n-  const missing = [\n-    ...missingRows(shipped.trigger_rows, parseTableRows(text, 'TRIGGER TABLE'), 'trigger'),\n-    ...missingRows(shipped.index_rows, parseTableRows(text, 'INDEX'), 'index'),\n+  const tables = [\n+    { kind: 'trigger', rows: parseTableRows(text, 'TRIGGER TABLE'), shipped: shipped.trigger_rows },\n+    { kind: 'index', rows: parseTableRows(text, 'INDEX'), shipped: shipped.index_rows },\n   ];\n+  const lines = [];\n+  const missing = tables.flatMap((table) => missingRows(table.shipped, table.rows, table.kind));\n   for (const entry of missing) lines.push(`missing ${entry.kind} row for ${entry.rule}`);\n+  for (const table of tables) {\n+    for (const entry of table.rows) {\n+      if (!entry.malformed) continue;\n+      lines.push(`malformed ${table.kind} row at line ${entry.line}: ${entry.cells.length} cells where the header has ${entry.width}`);\n+    }\n+  }\n \n   if (typeof tools.repoRules !== 'string' || !fs.existsSync(tools.repoRules)) {\n     return row('A11', 'REPO RULES.md', UNKNOWN, 'present; the repo-rules checker is not installed',\n@@ -785,7 +801,9 @@ function rowRouter(context, manifest, tools) {\n }\n \n // The router's own table, read the same way the manifest's rows were derived. Comparing\n-// shipped rows to the file is the only way to say which of them a consumer dropped.\n+// shipped rows to the file is the only way to say which of them a consumer dropped, and a\n+// row of another width is kept so the report can name the defect instead of the rule it\n+// would otherwise read as missing.\n function parseTableRows(text, anchor) {\n   const lines = text.split('\\n');\n   const start = lines.findIndex((line) => line.startsWith('#') && line.includes(anchor));\n@@ -806,8 +824,7 @@ function parseTableRows(text, anchor) {\n       width = cells.length;\n       continue;\n     }\n-    if (cells.length !== width) continue;\n-    rows.push(cells);\n+    rows.push({ cells, line: index + 1, width, malformed: cells.length !== width });\n   }\n   return rows;\n }\n@@ -823,7 +840,7 @@ function rulePathOf(cells) {\n }\n \n function missingRows(shipped, present, kind) {\n-  const found = new Set(present.map((cells) => rulePathOf(cells) || cells.join(' | ')));\n+  const found = new Set(present.map((entry) => rulePathOf(entry.cells) || entry.cells.join(' | ')));\n   const missing = [];\n   for (const cells of shipped) {\n     const rule = rulePathOf(cells) || cells.join(' | ');\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"diff --git a/.skilled/commands/doctor/scripts/README.markdown b/.skilled/commands/doctor/scripts/README.markdown\nindex a64b7e6748..c52af5910d 100644\n--- a/.skilled/commands/doctor/scripts/README.markdown\n+++ b/.skilled/commands/doctor/scripts/README.markdown\n@@ -99,8 +99,8 @@ The scripts validate route manifests, inspect MCP installations, audit parent sk\n | `sk-code-quality-config.cjs` | The quality config doctor's entry, kept thin: the arguments, the run context, the one call that starts the runner, the mode table and the exit status are here, and each mode sits in the quality modules under `lib/`. It reports which quality config the sk-code quality gate reads, whether each tool it names is on PATH, and the trust state the runner applies to that config: `trusted`, `untrusted` or `none`. `status` and `check` both print it, and when the config is untrusted they print `git config --local skilled.trustRepoChecks true` as the repair. It prints the hygiene layers, a `Hygiene:` line naming the core rules `commentHygiene.disableRules` switches off and an applied-rules block built by calling `quality-gate.cjs --explain` over a sample of one file per first three folders and extension: each checklist with its seat, its override rows or the reasons its section was refused, each same-level conflict and a `Hygiene rules:` line for the rules in force. A refused section, an unknown rule id or a missing checklist fails the status with `CONFIG_INVALID` or `CHECKLIST_MISSING`, and a conflict is listed without failing it. It validates that config and creates `.skilled/skills/sk-code/sk-code-quality/repository/quality.json` once from the shipped template for `/doctor:sk-code quality`, and in a repository with no `specs/` folder its plan suggests the spec-kit hygiene rules without writing them. It never runs a command the config names. It exits 0 on success, 1 on an invalid or missing config, a refused checklist section or a refused init and 2 on a usage error or outside a git repository. |\n | `audit_descriptions.py` | Audits description lengths across skills, commands and agents. |\n | `agent-roster-mirror-check.cjs` | Verifies every canonical agent reaches all five runtime surfaces, and that mirror surfaces stay symlinked rather than forked. `--check` is accepted and ignored, because it is read-only either way. |\n-| `agents-md-check.cjs` | The read-only AGENTS.md check: twelve rows reporting the install state, the sections lost or reordered, the currency of each body, every pin, the delivery budget, the shape of the repository block, the repository's own content and its local edits, each runtime copy, the `REPO RULES.md` router and the source template's purity. Three of them run their owner as a child instead of re-deriving it, carrying the rule-copy canary's budget lines, the gate 1 pointer sync's Cursor block and the repo-rules checker's summary. `--root <dir>` classifies another repository and `--json` prints the same report for a machine. A row it cannot prove reads `UNKNOWN` rather than `PASS`, so it exits 0 on no finding, 1 on a finding or an unproven row and 2 on a failed precondition. |\n-| `agents-md-embed.cjs` | The writing half of `/doctor:agents-md`, in three subcommands. `plan` composes every target in memory and prints the targets, the diffs, the new block, the byte budget, the preservation ledger, the backup folder and the plan digest, and writes nothing. `apply --plan-digest <digest>` recomposes, refuses a digest the tree no longer produces, backs up every path it will touch, writes only inside the allowlist it checks in code and then proves the composition against the bytes on disk, restoring from the backup and ending `STATUS=FAIL` when one line went missing. `restore --run=<dir>` puts back exactly the paths that run's `manifest.json` records, removes the files, and the empty folders, that run created, and keeps the backup. It exits 0 when there was nothing to do or the work finished, 1 on a failed proof or a declined run and 2 on a failed precondition or a path outside the allowlist. |\n+| `agents-md-check.cjs` | The read-only AGENTS.md check: twelve rows reporting the install state, the sections lost or reordered, the currency of each body, every pin, the delivery budget, the shape of the repository block, the repository's own content and its local edits, each runtime copy, the `REPO RULES.md` router and the source template's purity. Four of them run their owner as a child instead of re-deriving it, carrying the rule-copy canary's budget lines, the gate 1 pointer sync's Cursor block, the repo-rules checker's summary and the manifest generator's check of the source template's purity. `--root <dir>` classifies another repository and `--json` prints the same report for a machine. A row it cannot prove reads `UNKNOWN` rather than `PASS`, so it exits 0 on no finding, 1 on a finding or an unproven row and 2 on a failed precondition. |\n+| `agents-md-embed.cjs` | The writing half of `/doctor:agents-md`, in three subcommands. `plan` composes every target in memory and prints the targets, the diffs, the new block, the byte budget, the preservation ledger, the backup folder and the plan digest, and writes nothing. `apply --plan-digest <digest>` recomposes, refuses a digest the tree no longer produces, backs up every path it will touch, writes only inside the allowlist it checks in code and then proves the composition against the bytes on disk, restoring from the backup and ending `STATUS=FAIL` when one line went missing or one appeared outside the block that no shipped section carries. It refuses a symlinked `REPO RULES.md` or Cursor mirror it would write, because a write through the link would change a file the repository does not own. `restore --run=<dir>` puts back exactly the paths that run's `manifest.json` records, removes the files, and the empty folders, that run created, and keeps the backup. It exits 0 when there was nothing to do or the work finished, 1 on a failed proof or a declined run and 2 on a failed precondition or a path outside the allowlist. It exits 3 when a write fails after the backup, having restored from it or said why not. |\n | `agents-md-manifest.cjs` | Generates and gates the shipped manifest's `derived` key: a copy of every shipped body, its hash and the router rows, taken from the root documents. `--write` refreshes it and `--check` is the freshness gate, so a body that drifted from the template fails here instead of surfacing as a check finding. It refuses a heading no authored entry matches, an authored entry that matches nothing, and text above the first heading, and `--write` runs only in the repository that ships the template. Each of the three engines has its own suite: `agents-md-check.test.cjs`, `agents-md-embed.test.cjs` and `agents-md-manifest.test.cjs`, driven from the recipe folders under `tests/fixtures/agents-md/`. |\n | `git-hook-gates.cjs` | Lists the shipped hook gates from `scripts/git-hooks/lib/gates.tsv` with their saved `speckit.hooks.<key>` values, and sets or unsets one in local or global git config for `/doctor:git hooks`. Refuses the per-push approvals. |\n | `git-standards.cjs` | Shows where a repository's commit, PR and branch rules come from, copies the shipped sk-git templates into `.sk-git/`, and changes a rules block setting or removes a kind's rules section in those copies for `/doctor:git standards`, re-validating each change with sk-git's own contract check. |\ndiff --git a/.skilled/commands/doctor/scripts/agents-md-check.cjs b/.skilled/commands/doctor/scripts/agents-md-check.cjs\nindex c2e4f5f357..94d9578369 100644\n--- a/.skilled/commands/doctor/scripts/agents-md-check.cjs\n+++ b/.skilled/commands/doctor/scripts/agents-md-check.cjs\n@@ -12,9 +12,10 @@\n // from one that would drop a line somebody wrote. So this engine reports, per row and\n // without writing a byte, what the repository holds against the manifest.\n //\n-// Three of the twelve rows are answers this engine must not invent. The delivery budget\n+// Four of the twelve rows are answers this engine must not invent. The delivery budget\n // and its anchors belong to the rule-copy canary, the Cursor pointer block belongs to\n-// the gate 1 sync, and the router belongs to the repo-rules checker. Each already has\n+// the gate 1 sync, the router belongs to the repo-rules checker and the source\n+// template's purity belongs to the manifest generator's check. Each already has\n // tests and an owner, so each is run as a child process and its own lines are carried\n // into the report; re-deriving any of them here would be a second opinion that drifts\n // from the first. The rest are pure classifiers over one read of the target tree.\n@@ -635,7 +6