deep-research-ledger-schema/index.ts');\n191: \n192:   const adapter = await resolveModeAdapter(modeRaw);\n193:   const normalizedMode = adapter.normalizedMode;\n194:   const registry = adapter.createRegistry();\n195: \n196:   // Read the durable authority record before anything is constructed. A CLI\n197:   // that asserts its own authority is exactly the private write path the\n198:   // gateway exists to remove, so a refusal here must happen before a ledger,\n199:   // a policy registry, or a run directory is touched.\n200:   const authorityRoot = resolveAuthorityRoot();\n201:   // A mode outside the frozen flip order has no authority record to read, and\n202:   // the selector reports that as a malformed record. Naming the real cause here\n203:   // keeps an operator from hunting a corrupt file that does not exist.\n204:   if (!AUTHORITY_FLIP_MODE_ORDER.includes(normalizedMode)) {\n205:     jsonOut({\n206:       ok: false,\n207:       phase: 'authority',\n208:       reason: `Mode '${normalizedMode}' is not in the frozen authority order: ${AUTHORITY_FLIP_MODE_ORDER.join(', ')}`,\n209:       code: 'AUTHORITY_DENIED',\n210:     });\n211:     process.exit(2);\n212:   }\n213:   let admission;\n214:   try {\n215:     admission = admitCanonicalWrite(normalizedMode, { authorityRoot });\n216:   } catch (error) {\n217:     jsonOut({\n218:       ok: false,\n219:       phase: 'authority',\n220:       reason: error instanceof Error ? error.message : String(error),\n221:       code: 'AUTHORITY_DENIED',\n222:     });\n223:     process.exit(2);\n224:   }\n225:   if (admission.outcome === 'denied') {\n226:     jsonOut({\n227:       ok: false,\n228:       phase: 'authority',\n229:       reason: `Authority admission denied: ${admission.reasonCode}`,\n230:       code: 'AUTHORITY_DENIED',\n231:     });\n232:     process.exit(2);\n233:   }\n234:   if (admission.admissionOpen === false) {\n235:     jsonOut({ ok: false, phase: 'authority', reason: 'Authority admission closed', code: 'AUTHORITY_DENIED' });\n236:     process.exit(2);\n237:   }\n238:   const authority = { state: admission.state, epoch: admission.epoch };\n239:   const policyId = typeof args.policyId === 'string' ? args.policyId : `${normalizedMode}-append-policy`;\n240:   const policyVersion = 1;\n241:   const ruleId = 'mode-event-append';\n242: \n243:   const policyRegistry = new TransitionPolicyRegistry([{\n244:     policyId,\n245:     policyVersion,\n246:     evaluatorVersion: '1',\n247:     ruleIds: [ruleId],\n248:     capturedAuthorizationState: { state: authority.state, epoch: authority.epoch },\n249:     evaluate: () => ({\n250:       verdict: AuthorizationVerdicts.ALLOW,\n251:       reasonCode: AuthorizationReasonCodes.ALLOWED,\n252:       matchedRuleIds: [ruleId],\n253:     }),\n254:   }]);\n255: \n256:   const resolvedPolicy = policyRegistry.resolve(policyId, policyVersion);\n257: \n258:   const ledgerId = `${normalizedMode}-ledger`;\n259:   const auditLedgerId = `${normalizedMode}-audit-ledger`;\n260: \n261:   const ledger = new AppendOnlyLedger({\n262:     rootDirectory: runDirectory,\n263:     ledgerId,\n264:     auditLedgerId,\n265:     authorityProvider: () => authority,\n266:   }, registry);\n267: \n268:   const authorizationGateway = new TransitionAuthorizationGateway({\n269:     rootDirectory: runDirectory,\n270:     auditLedgerId,\n271:     authorityProvider: () => authority,\n272:     identityResolver: (context) => ({\n273:       actorId: context.evaluationInput.actorId,\n274:       capabilityId: context.evaluationInput.capabilityId,\n275:       evidenceDigest: context.evaluationInput.evidenceDigest,\n276:     }),\n277:   }, ledger, policyRegistry);\n278: \n279:   let binding;\n280:   try {\n281:     binding = resolveCutoverBinding({\n282:       mode: normalizedMode,\n283:       repositoryRoot: runDirectory,\n284:     });\n285:   } catch (primaryError) {\n286:     try {\n287:       binding = resolveCutoverBinding({\n288:         mode: normalizedMode,\n289:         repositoryRoot: process.cwd(),\n290:       });\n291:     } catch (fallbackError) {\n292:       // An unattributable flip is worse than a blocked one: fabricating a\n293:       // zero-SHA identity here would let the ledger carry a transition\n294:       // nobody can be held to. Refuse instead of defaulting.\n295:       const primaryMessage = primaryError instanceof Error ? primaryError.message : String(primaryError);\n296:       const fallbackMessage = fallbackError instanceof Error ? fallbackError.message : String(fallbackError);\n297:       jsonOut({\n298:         ok: false,\n299:         phase: 'binding',\n300:         reason: `Cannot bind an authority flip: cutover binding could not be resolved from the run directory (${primaryMessage}) or the working directory (${fallbackMessage}).`,\n301:         code: 'BINDING_FAILED',\n302:       });\n303:       process.exit(2);\n304:     }\n305:   }\n306: \n307:   const currentHead = await ledger.getVerifiedHead();\n308:   const nowIso = new Date().toISOString();\n309:   // A retry hands over the same event again, but everything this CLI mints for\n310:   // it (event id, timestamps, chain position) changes between calls. The event\n311:   // as the caller handed it over is what stays fixed, so a caller that names no\n312:   // idempotency key gets one derived from it, and the gateway stores a retried\n313:   // event once.\n314:   const defaultIdempotencyKey = `${normalizedMode}:input:${crypto\n315:     .createHash('sha256')\n316:     .update(stableJson(rawEvent))\n317:     .digest('hex')}`;\n318: \n319:   // Shared builder for the envelope-metadata + payload-core input that\n320:   // adapter.prepareEvent consumes. Both the explicit-stem path and the legacy\n321:   // upcast path funnel through here so the envelope shape is defined once.\n322:   function buildPreparedInput(core, meta) {\n323:     return {\n324:       stem: core.stem,\n325:       scope: core.scope,\n326:       data: core.data,\n327:       prevEventHash: core.prevEventHash,\n328:       replay: core.replay,\n329:       eventId: meta.eventId || meta.event_id || `event-${crypto.randomUUID()}`,\n330:       streamId: meta.streamId || meta.stream_id || ledgerId,\n331:       streamSequence: meta.streamSequence ?? meta.stream_sequence ?? (currentHead.sequence + 1),\n332:       occurredAt: meta.occurredAt || meta.occurred_at || nowIso,\n333:       recordedAt: meta.recordedAt || meta.recorded_at || nowIso,\n334:       producer: meta.producer || { name: 'deep-loop-cli', version: '1.0.0' },\n335:       authorityEpoch: meta.authorityEpoch ?? meta.authority_epoch ?? authority.epoch,\n336:       correlationId: meta.correlationId || meta.correlation_id || crypto.randomUUID(),\n337:       causationId: meta.causationId !== undefined\n338:         ? meta.causationId\n339:         : (meta.causation_id !== undefined ? meta.causation_id : null),\n340:       idempotencyKey: meta.idempotencyKey || meta.idempotency_key || defaultIdempotencyKey,\n341:     };\n342:   }\n343: \n344:   const defaultReplay = {\n345:     fingerprint_version: 1,\n346:     final_digest: '0'.repeat(64),\n347:     replay_input_digests: {},\n348:   };\n349: \n350:   let eventRecord;\n351:   let legacyWarnings;\n352:   if (\n353:     rawEvent\n354:     && typeof rawEvent === 'object'\n355:     && rawEvent.canonicalDigest\n356:     && rawEvent.canonicalBytes\n357:     && rawEvent.identity\n358:     && rawEvent.envelope\n359:   ) {\n360:     eventRecord = rawEvent;\n361:   } else if (rawEvent && typeof rawEvent === 'object' && rawEvent.stem) {\n362:     const preparedInput = buildPreparedInput({\n363:       stem: rawEvent.stem,\n364:       scope: rawEvent.scope || { runId: 'run-cli', lineageId: 'lineage-cli' },\n365:       data: rawEvent.data || {},\n366:       prevEventHash: rawEvent.prevEventHash || rawEvent.prev_event_hash || currentHead.recordHash,\n367:       replay: rawEvent.replay || defaultReplay,\n368:     }, rawEvent);\n369:     eventRecord = adapter.prepareEvent(preparedInput, registry);\n370:   } else if (rawEvent && typeof rawEvent === 'object' && (rawEvent.event_type || rawEvent.eventType)) {\n371:     const envelope = {\n372:       envelope_version: rawEvent.envelope_version ?? rawEvent.envelopeVersion ?? 1,\n373:       event_id: rawEvent.event_id || rawEvent.eventId || `event-${crypto.randomUUID()}`,\n374:       event_type: rawEvent.event_type || rawEvent.eventType,\n375:       event_version: rawEvent.event_version ?? rawEvent.eventVersion ?? 1,\n376:       stream_id: rawEvent.stream_id || rawEvent.streamId || ledgerId,\n377:       stream_sequence: rawEvent.stream_sequence ?? rawEvent.streamSequence ?? (currentHead.sequence + 1),\n378:       occurred_at: rawEvent.occurred_at || rawEvent.occurredAt || nowIso,\n379:       recorded_at: rawEvent.recorded_at || rawEvent.recordedAt || nowIso,\n[Output truncated. Continue reading with offset: 380]","title":"read","metadata":{"metadata":{"truncated":true},"content":[{"type":"text","text":"Read file .skilled/skills/system-deep-loop/runtime/scripts/append-mode-event.cjs, lines 160-379\n160:   const runDirectory = requireString(args, 'runDirectory', 'runDir', 'specFolder');\n161:   const eventJsonPath = requireString(args, 'eventJson', 'eventJsonPath');\n162: \n163:   let rawEvent;\n164:   try {\n165:     const raw = fs.readFileSync(eventJsonPath, 'utf8');\n166:     rawEvent = JSON.parse(raw);\n167:   } catch (error) {\n168:     jsonOut({\n169:       ok: false,\n170:       phase: 'input',\n171:       reason: `Failed to read event JSON: ${error.message}`,\n172:       code: 'INPUT_ERROR',\n173:     });\n174:     process.exit(1);\n175:   }\n176: \n177:   const { appendModeEvent } = await import('../lib/mode-append-gateway/index.ts');\n178:   const {\n179:     AppendOnlyLedger,\n180:     TransitionAuthorizationGateway,\n181:     TransitionPolicyRegistry,\n182:     AuthorizationVerdicts,\n183:     AuthorizationReasonCodes,\n184:   } = await import('../lib/authorized-ledger/index.ts');\n185:   const { prepareEventWrite } = await import('../lib/event-envelope/index.ts');\n186:   const { resolveCutoverBinding } = await import('../lib/mode-append-gateway/index.ts');\n187:   const { resolveAuthorityRoot } = await import('../lib/authority-root/index.ts');\n188:   const { admitCanonicalWrite } = await import('../lib/deep-research-authority/index.ts');\n189:   const { AUTHORITY_FLIP_MODE_ORDER } = await import('../lib/per-mode-authority-flip/index.ts');\n190:   const { upcastLegacyDeepResearchRecord } = await import('../lib/deep-research-ledger-schema/index.ts');\n191: \n192:   const adapter = await resolveModeAdapter(modeRaw);\n193:   const normalizedMode = adapter.normalizedMode;\n194:   const registry = adapter.createRegistry();\n195: \n196:   // Read the durable authority record before anything is constructed. A CLI\n197:   // that asserts its own authority is exactly the private write path the\n198:   // gateway exists to remove, so a refusal here must happen before a ledger,\n199:   // a policy registry, or a run directory is touched.\n200:   const authorityRoot = resolveAuthorityRoot();\n201:   // A mode outside the frozen flip order has no authority record to read, and\n202:   // the selector reports that as a malformed record. Naming the real cause here\n203:   // keeps an operator from hunting a corrupt file that does not exist.\n204:   if (!AUTHORITY_FLIP_MODE_ORDER.includes(normalizedMode)) {\n205:     jsonOut({\n206:       ok: false,\n207:       phase: 'authority',\n208:       reason: `Mode '${normalizedMode}' is not in the frozen authority order: ${AUTHORITY_FLIP_MODE_ORDER.join(', ')}`,\n209:       code: 'AUTHORITY_DENIED',\n210:     });\n211:     process.exit(2);\n212:   }\n213:   let admission;\n214:   try {\n215:     admission = admitCanonicalWrite(normalizedMode, { authorityRoot });\n216:   } catch (error) {\n217:     jsonOut({\n218:       ok: false,\n219:       phase: 'authority',\n220:       reason: error instanceof Error ? error.message : String(error),\n221:       code: 'AUTHORITY_DENIED',\n222:     });\n223:     process.exit(2);\n224:   }\n225:   if (admission.outcome === 'denied') {\n226:     jsonOut({\n227:       ok: false,\n228:       phase: 'authority',\n229:       reason: `Authority admission denied: ${admission.reasonCode}`,\n230:       code: 'AUTHORITY_DENIED',\n231:     });\n232:     process.exit(2);\n233:   }\n234:   if (admission.admissionOpen === false) {\n235:     jsonOut({ ok: false, phase: 'authority', reason: 'Authority admission closed', code: 'AUTHORITY_DENIED' });\n236:     process.exit(2);\n237:   }\n238:   const authority = { state: admission.state, epoch: admission.epoch };\n239:   const policyId = typeof args.policyId === 'string' ? args.policyId : `${normalizedMode}-append-policy`;\n240:   const policyVersion = 1;\n241:   const ruleId = 'mode-event-append';\n242: \n243:   const policyRegistry = new TransitionPolicyRegistry([{\n244:     policyId,\n245:     policyVersion,\n246:     evaluatorVersion: '1',\n247:     ruleIds: [ruleId],\n248:     capturedAuthorizationState: { state: authority.state, epoch: authority.epoch },\n249:     evaluate: () => ({\n250:       verdict: AuthorizationVerdicts.ALLOW,\n251:       reasonCode: AuthorizationReasonCodes.ALLOWED,\n252:       matchedRuleIds: [ruleId],\n253:     }),\n254:   }]);\n255: \n256:   const resolvedPolicy = policyRegistry.resolve(policyId, policyVersion);\n257: \n258:   const ledgerId = `${normalizedMode}-ledger`;\n259:   const auditLedgerId = `${normalizedMode}-audit-ledger`;\n260: \n261:   const ledger = new AppendOnlyLedger({\n262:     rootDirectory: runDirectory,\n263:     ledgerId,\n264:     auditLedgerId,\n265:     authorityProvider: () => authority,\n266:   }, registry);\n267: \n268:   const authorizationGateway = new TransitionAuthorizationGateway({\n269:     rootDirectory: runDirectory,\n270:     auditLedgerId,\n271:     authorityProvider: () => authority,\n272:     identityResolver: (context) => ({\n273:       actorId: context.evaluationInput.actorId,\n274:       capabilityId: context.evaluationInput.capabilityId,\n275:       evidenceDigest: context.evaluationInput.evidenceDigest,\n276:     }),\n277:   }, ledger, policyRegistry);\n278: \n279:   let binding;\n280:   try {\n281:     binding = resolveCutoverBinding({\n282:       mode: normalizedMode,\n283:       repositoryRoot: runDirectory,\n284:     });\n285:   } catch (primaryError) {\n286:     try {\n287:       binding = resolveCutoverBinding({\n288:         mode: normalizedMode,\n289:         repositoryRoot: process.cwd(),\n290:       });\n291:     } catch (fallbackError) {\n292:       // An unattributable flip is worse than a blocked one: fabricating a\n293:       // zero-SHA identity here would let the ledger carry a transition\n294:       // nobody can be held to. Refuse instead of defaulting.\n295:       const primaryMessage = primaryError instanceof Error ? primaryError.message : String(primaryError);\n296:       const fallbackMessage = fallbackError instanceof Error ? fallbackError.message : String(fallbackError);\n297:       jsonOut({\n298:         ok: false,\n299:         phase: 'binding',\n300:         reason: `Cannot bind an authority flip: cutover binding could not be resolved from the run directory (${primaryMessage}) or the working directory (${fallbackMessage}).`,\n301:         code: 'BINDING_FAILED',\n302:       });\n303:       process.exit(2);\n304:     }\n305:   }\n306: \n307:   const currentHead = await ledger.getVerifiedHead();\n308:   const nowIso = new Date().toISOString();\n309:   // A retry hands over the same event again, but everything this CLI mints for\n310:   // it (event id, timestamps, chain position) changes between calls. The event\n311:   // as the caller handed it over is what stays fixed, so a caller that names no\n312:   // idempotency key gets one derived from it, and the gateway stores a retried\n313:   // event once.\n314:   const defaultIdempotencyKey = `${normalizedMode}:inpu