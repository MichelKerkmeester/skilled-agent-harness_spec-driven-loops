mmand === 'plan') return commandPlan(options, output, hooks);\n1641:     if (options.command === 'apply') return commandApply(options, output, hooks);\n1642:     return commandRestore(options, output, hooks);\n1643:   } catch (error) {\n1644:     if (error instanceof AllowlistError) {\n1645:       output.warn(`${TAG} ERROR: ${error.message}; nothing was written`);\n1646:       return 2;\n1647:     }\n1648:     if (error instanceof PreconditionError || error instanceof UsageError) {\n1649:       output.warn(`${TAG} ERROR: ${error.message}`);\n1650:       if (error instanceof UsageError) output.warn(USAGE);\n1651:       return 2;\n1652:     }\n1653:     throw error;\n1654:   }\n1655: }\n1656: \n1657: if (require.main === module) {\n1658:   try {\n1659:     process.exitCode = main(process.argv.slice(2));\n1660:   } catch (error) {\n1661:     console.error(`${TAG} ERROR: ${error.message}`);\n1662:     process.exitCode = 2;\n1663:   }\n1664: }\n1665: \n1666: module.exports = {\n1667:   ALLOWLIST,\n1668:   MANIFEST_PATH,\n1669:   addRouterRows,\n1670:   assertWritable,\n1671:   backupBase,\n1672:   compose,\n1673:   main,\n1674:   planDigest,\n1675:   planFor,\n1676:   preservationCheck,\n1677:   renderBlock,\n1678:   renderMirror,\n1679:   renderRouter,\n1680: };","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file .skilled/commands/doctor/scripts/agents-md-embed.cjs, lines 1600-1680\n1600:   }\n1601: \n1602:   output.log(`restore: ${touched} path(s) put back, the backup at ${options.run} is kept`);\n1603:   output.log('STATUS=OK');\n1604:   return 0;\n1605: }\n1606: \n1607: // ─────────────────────────────────────────────────────────────────────────────\n1608: // 18. MAIN\n1609: // ─────────────────────────────────────────────────────────────────────────────\n1610: \n1611: function outputOf(hooks) {\n1612:   return {\n1613:     log: typeof hooks.log === 'function' ? hooks.log : (line) => console.log(line),\n1614:     warn: typeof hooks.warn === 'function' ? hooks.warn : (line) => console.error(line),\n1615:   };\n1616: }\n1617: \n1618: /**\n1619:  * @param {string[]} argv\n1620:  * @param {{log?: Function, warn?: Function, write?: Function}} [hooks]\n1621:  * @returns {number} the process exit code\n1622:  */\n1623: function main(argv, hooks = {}) {\n1624:   const options = parseArgs(argv);\n1625:   const output = outputOf(hooks);\n1626:   if (options.help) {\n1627:     output.log(USAGE);\n1628:     return 0;\n1629:   }\n1630:   if (options.command === null) {\n1631:     output.warn(`${TAG} ERROR: one of plan, apply or restore is required\\n${USAGE}`);\n1632:     return 2;\n1633:   }\n1634:   if (!fs.existsSync(options.root) || !fs.statSync(options.root).isDirectory()) {\n1635:     output.warn(`${TAG} ERROR: the target root is not a directory: ${options.root}`);\n1636:     return 2;\n1637:   }\n1638: \n1639:   try {\n1640:     if (options.command === 'plan') return commandPlan(options, output, hooks);\n1641:     if (options.command === 'apply') return commandApply(options, output, hooks);\n1642:     return commandRestore(options, output, hooks);\n1643:   } catch (error) {\n1644:     if (error instanceof AllowlistError) {\n1645:       output.warn(`${TAG} ERROR: ${error.message}; nothing was written`);\n1646:       return 2;\n1647:     }\n1648:     if (error instanceof PreconditionError || error instanceof UsageError) {\n1649:       output.warn(`${TAG} ERROR: ${error.message}`);\n1650:       if (error instanceof UsageError) output.warn(USAGE);\n1651:       return 2;\n1652:     }\n1653:     throw error;\n1654:   }\n1655: }\n1656: \n1657: if (require.main === module) {\n1658:   try {\n1659:     process.exitCode = main(process.argv.slice(2));\n1660:   } catch (error) {\n1661:     console.error(`${TAG} ERROR: ${error.message}`);\n1662:     process.exitCode = 2;\n1663:   }\n1664: }\n1665: \n1666: module.exports = {\n1667:   ALLOWLIST,\n1668:   MANIFEST_PATH,\n1669:   addRouterRows,\n1670:   assertWritable,\n1671:   backupBase,\n1672:   compose,\n1673:   main,\n1674:   planDigest,\n1675:   planFor,\n1676:   preservationCheck,\n1677:   renderBlock,\n1678:   renderMirror,\n1679:   renderRouter,\n1680: };"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"limit\":180,\"offset\":1600,\"path\":\".skilled/commands/doctor/scripts/agents-md-embed.cjs\"}"},"time":{"start":1794570322607,"end":1794570323012}}}}
