──────────────────────────────────────────────────────────────\n30: \n31: function readUtf8(filePath) {\n32:   return fs.readFileSync(filePath, 'utf8');\n33: }\n34: \n35: function writeUtf8(filePath, content) {\n36:   fs.mkdirSync(path.dirname(filePath), { recursive: true });\n37:   fs.writeFileSync(filePath, content, 'utf8');\n38: }\n39: \n40: function readJson(filePath) {\n41:   return JSON.parse(readUtf8(filePath));\n42: }\n43: \n44: function getResourceMapEmitSetting(config) {\n45:   const nested = config && typeof config === 'object'\n46:     ? (config.resource_map || config.resourceMap || null)\n47:     : null;\n48:   if (nested && typeof nested === 'object' && typeof nested.emit === 'boolean') {\n49:     return nested.emit;\n50:   }\n51:   return true;\n52: }\n53: \n54: function slugify(value) {\n55:   return value\n56:     .toLowerCase()\n57:     .replace(/[^a-z0-9]+/g, '-')\n58:     .replace(/^-+|-+$/g, '')\n59:     .slice(0, 80) || 'entry';\n60: }\n61: \n62: function normalizeText(value) {\n63:   if (value === null || value === undefined) return '';\n64:   if (typeof value !== 'string') {\n65:     try { return String(value).replace(/\\s+/g, ' ').trim(); }\n66:     catch { return ''; }\n67:   }\n68:   return value.replace(/\\s+/g, ' ').trim();\n69: }\n70: \n71: function escapeRegExp(value) {\n72:   return value.replace(/[.*+?^${}()|[\\]\\\\]/g, '\\\\$&');\n73: }\n74: \n75: function zeroSeverityMap() {\n76:   return { P0: 0, P1: 0, P2: 0 };\n77: }\n78: \n79: function isFiniteNumber(value) {\n80:   return typeof value === 'number' && Number.isFinite(value);\n81: }\n82: \n83: // Severities already reported as outside the scale, so a registry that repeats one\n84: // across many findings produces one line per distinct value rather than per finding.\n85: const reportedUnrankedSeverities = new Set();\n86: \n87: /**\n88:  * Maps a severity onto the three-tier scale, and says so when it cannot.\n89:  *\n90:  * Callers drop a finding whose severity does not normalize, which is the right\n91:  * handling -- the reducer has no tier to file it under and inventing one would\n92:  * guess. What it must not do is drop it quietly: a finding that vanishes between\n93:  * the lane that wrote it and the report that reads it is indistinguishable from a\n94:  * finding nobody wrote, and only the producer can fix the word it stamped. An\n95:  * absent severity is a different defect that the record-shape warnings cover, so\n96:  * only a present-but-unrecognised value is reported here.\n97:  */\n98: function normalizeSeverity(value) {\n99:   if (SEVERITY_KEYS.includes(value)) return value;\n100:   if (typeof value === 'string' && value.trim() !== '' && !reportedUnrankedSeverities.has(value)) {\n101:     reportedUnrankedSeverities.add(value);\n102:     process.stderr.write(\n103:       `[deep-review] warning: severity \"${value}\" is outside the ${SEVERITY_KEYS.join('/')} scale; `\n104:       + 'findings carrying it are dropped from the reduced state\\n',\n105:     );\n106:   }\n107:   return null;\n108: }\n109: \n110: function normalizeLineageMode(value) {\n111:   const normalized = normalizeText(value).toLowerCase();\n112:   return LIVE_LINEAGE_MODES.has(normalized) ? normalized : null;\n113: }\n114: \n115: function getNestedField(record, fieldName) {\n116:   if (!record || typeof record !== 'object') {\n117:     return undefined;\n118:   }\n119:   if (record[fieldName] !== undefined) {\n120:     return record[fieldName];\n[Output truncated. Continue reading with offset: 121]","title":"read","metadata":{"metadata":{"truncated":true},"content":[{"type":"text","text":"Read file .skilled/skills/system-deep-loop/runtime/scripts/reduce-state.cjs, lines 1-120\n1: // ───────────────────────────────────────────────────────────────────\n2: // MODULE: Deep Review State Reducer\n3: // ───────────────────────────────────────────────────────────────────\n4: \n5: 'use strict';\n6: \n7: // ─────────────────────────────────────────────────────────────────