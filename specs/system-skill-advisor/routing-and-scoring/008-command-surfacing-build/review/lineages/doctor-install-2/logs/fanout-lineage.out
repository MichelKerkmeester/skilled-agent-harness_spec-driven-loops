{"type":"step_start","timestamp":1794570174348,"sessionID":"ses_e2b4a18a6ffeJYEGLs0dTSiOZ0","part":{"id":"prt_1d4b7bf8c001WHiWa3WV78e4jm","sessionID":"ses_e2b4a18a6ffeJYEGLs0dTSiOZ0","messageID":"msg_1d4b7b49f001BlRwUHv5UAjp01","type":"step-start","snapshot":"7e3a9c0bd81c344414f3331d0c066a594eb0e905"}}
{"type":"tool_use","timestamp":1794570174368,"sessionID":"ses_e2b4a18a6ffeJYEGLs0dTSiOZ0","part":{"partID":"prt_1d4b7bf91002H72ybKQ6SO8bZn","sessionID":"ses_e2b4a18a6ffeJYEGLs0dTSiOZ0","messageID":"msg_1d4b7b49f001BlRwUHv5UAjp01","type":"tool","id":"call_fe6e5f9dd08044928beda936","tool":"read","state":{"status":"completed","input":{"limit":540,"offset":660,"path":".skilled/commands/deep/assets/deep-review-auto.yaml"},"output":"Read file .skilled/commands/deep/assets/deep-review-auto.yaml, lines 660-1199\n660:   phase_loop:\n661:     purpose: Dispatch review agent iterations until convergence\n662:     repeat: true\n663:     max_repeats: \"{max_iterations}\"\n664:     steps:\n665: \n666:       step_refresh_lock:\n667:         action: \"Refresh the packet lock heartbeat before the iteration begins\"\n668:         command: \"node .skilled/skills/system-deep-loop/runtime/scripts/loop-lock.cjs refresh --lock-path {state_paths.lock_file} --owner-pid {captured_owner_pid} --nonce {captured_acquire_nonce}\"\n669:         on_refresh: \"If the refresh output has refreshed:false, fail closed: lost the packet lock. This run no longer holds the packet and must stop rather than iterate without it.\"\n670: \n671:       step_record_artifact_migration:\n672:         action: \"Record the legacy review state move once per session, after the run is open\"\n673:         skip_when: \"legacy_migration_detected != true or migration_recorded == true\"\n674:         append_jsonl: '{\"stem\":\"deep_review.migration\",\"scope\":{\"runId\":\"{session_id}\",\"sessionId\":\"{session_id}\"},\"data\":{\"mode\":\"review\",\"legacyArtifacts\":[\"deep-research-config.json\",\"deep-research-state.jsonl\",\".deep-research-pause\"],\"canonicalArtifacts\":[\"deep-review-config.json\",\"deep-review-state.jsonl\",\".deep-review-pause\"]}}'\n675:         set: { migration_recorded: true }\n676: \n677:       step_read_state:\n678:         action: \"Read current state from JSONL, strategy, and config\"\n679:         read:\n680:           - \"{state_paths.state_log}\"\n681:           - \"{state_paths.findings_registry}\"\n682:           - \"{state_paths.strategy}\"\n683:           - \"{state_paths.config}\"\n684:         extract:\n685:           - iteration_count: \"Count distinct run values (the integer iteration, else a numeric run) across lines where type === 'iteration'; a redispatched run counts once\"\n686:           - highest_run: \"Highest run value (the integer iteration, else a numeric run) across lines where type === 'iteration', else 0\"\n687:           - current_iteration: \"max(highest_run, iteration_count) + 1\"\n688:           - last_newFindingsRatio: \"Extract newFindingsRatio from last iteration record\"\n689:           - last_focus: \"Extract focus/dimension from latest iteration record, else 'none yet'\"\n690:           - ratio_prev: \"Extract newFindingsRatio from second-latest iteration record, else 'N/A'\"\n691:           - ratio_latest: \"Extract newFindingsRatio from latest iteration record, else 'N/A'\"\n692:           - next_dimension: \"Next uncovered dimension from dimension_queue in strategy.md\"\n693:           - dimensions_covered: \"List of dimensions already reviewed\"\n694:           - dimensions_remaining: \"List of dimensions not yet reviewed\"\n695:           - dimension_coverage: \"covered / total dimensions\"\n696:           - coverage_age: \"Iterations since dimension coverage last changed; require >= 1 before STOP\"\n697:           - p0_count: \"Count P0 findings across all iterations\"\n698:           - p1_count: \"Count P1 findings across all iterations\"\n699:           - p2_count: \"Count P2 findings across all iterations\"\n700:           - resource_map_present: \"Extract boolean from deep-review-config.json, default false\"\n701:           - resource_map_prompt_line: \"If resource_map_present is true, return 'Resource Map Coverage: cross-check target_files from {spec_folder}/applied/T-*.md against {spec_folder}/resource-map.md and classify only missed coverage as gaps.' Else return 'Resource Map Coverage: resource-map.md not present; skipping coverage gate.'\"\n702:           - session_id: \"Extract sessionId from deep-review-config.json\"\n703:           - generation: \"Extract generation from deep-review-config.json, else 1\"\n704:           - last_3_summaries: \"Summarize the latest 3 iteration records as 'run N: dimension (ratio, P0/P1/P2)'\"\n705:           - latest_status: \"Extract status from latest iteration record, else 'none yet'\"\n706:           - last_claim_adjudication_passed: \"Scan state.jsonl for the most recent `claim_adjudication` event; use its `passed` boolean. Default true when no event exists or when activeP0 + activeP1 == 0 (gate is vacuous without adjudicable findings).\"\n707:           - claim_adjudication_active_count: \"Count of active P0/P1 findings at the time of the last claim_adjudication event; 0 when none exist\"\n708:           - security_sensitive_fix_scope: \"Boolean true when the current review is a rerun after fixes involving security, path disclosure, auth/authz, sandboxing, env precedence, public schemas, persistence, or user-visible error payloads; derive from the latest review report, remediation notes, or planning packet when present, else false.\"\n709:           - fix_completeness_replay_required_rows: \"Count prior active or remediated P0/P1 findings, plus any prior security/path P2 findings, that require closed-gate replay before STOP.\"\n710:           - fix_completeness_replay_passing_rows: \"Count required replay rows marked PASS with file:line or command evidence and producer/consumer/matrix coverage.\"\n711:           - stop_policy: \"Extract stopPolicy from deep-review-config.json, default 'convergence'. Valid values: convergence, max-iterations.\"\n712:           - convergence_mode: \"Extract antiConvergence.convergenceMode when it is one of 'default', 'off', 'sliding-window', or 'divergent'; default to 'default'\"\n713:           - convergence_mode_warning: \"Boolean true when antiConvergence.convergenceMode is present with an unsupported value; use 'default'\"\n714:           - pivot_lineage: \"Summarize registry.divergence.completed and registry.divergence.overrides with pivot ids, source iterations, and selected review direction; else 'none yet'\"\n715:           - saturated_directions: \"List registry.divergence.saturatedDirections; else 'none yet'\"\n716:           - review_focus_block: \"When deep-review-config.json reviewFocus is a non-empty string, return 'Operator review focus (cover it in addition to the dimension of this iteration, and say in the narrative how you addressed it): <reviewFocus>'. Else return an empty string.\"\n717: \n718:       step_check_pause_sentinel:\n719:         action: \"Check for pause sentinel file\"\n720:         check: \"Does {state_paths.pause_sentinel} exist?\"\n721:         if_exists:\n722:           set:\n723:             pending_stop_event: \"paused\"\n724:             pending_stop_reason: \"userPaused\"\n725:             pending_stop_detail: \"sentinel file detected\"\n726:           skip_to: step_normalize_pause_events\n727:         if_not_exists:\n728:           proceed: true\n729: \n730:       step_validate_convergence_config:\n731:         action: \"Validate convergence mode when loading config\"\n732:         if_convergence_mode_invalid:\n733:           bookkeeping_log: '{\"type\":\"event\",\"event\":\"config_warning\",\"mode\":\"review\",\"field\":\"antiConvergence.convergenceMode\",\"fallback\":\"default\",\"message\":\"Unsupported convergenceMode; using default convergence behavior.\",\"timestamp\":\"{ISO_8601_NOW}\",\"sessionId\":\"{session_id}\",\"generation\":{generation}}'\n734:           log: \"Unsupported convergenceMode; using default convergence behavior.\"\n735: \n736:       step_graph_convergence:\n737:         action: \"Evaluate coverage-graph convergence before the inline review convergence vote\"\n738:         inspect:\n739:           - \"{state_paths.state_log}\"\n740:           - \"{state_paths.findings_registry}\"\n741:         transform: |\n742:           1. Call graph convergence on the current review lineage before the inline 3-signal vote.\n743:           2. Record the decision as one of CONTINUE, STOP_ALLOWED, STOP_BLOCKED.\n744:           3. Preserve raw graph signals and blockers for reducer rollup and blocked-stop evidence.\n745:           4. Normalize blockers to both JSON array and CSV forms for downstream stop handling.\n746:           5. Set graph_stop_blocked = true only when graph_decision == \"STOP_BLOCKED\".\n747:         bash: 'node .skilled/skills/system-deep-loop/runtime/scripts/convergence.cjs --spec-folder \"{spec_folder}\" --loop-type \"review\" --session-id \"{session_id}\" --convergence-mode \"{convergence_mode}\"'\n748:         note: \"Invoke the runtime script directly. Review-side graph convergence must run before the inline review stop vote.\"\n749:         append_jsonl: '{\"stem\":\"deep_review.graph_convergence_evaluated\",\"scope\":{\"runId\":\"{session_id}\",\"sessionId\":\"{session_id}\",\"generation\":{generation},\"iterationId\":\"iteration-{current_iteration}\"},\"data\":{\"rawSignals\":{graph_raw_signals_json},\"weightedSignals\":{graph_raw_signals_json},\"dimensionCoverageDigest\":\"{dimension_coverage_digest}\",\"protocolCoverageDigest\":\"{protocol_coverage_digest}\",\"findingStability\":\"{finding_stability}\",\"p0p1ResolutionState\":\"{p0p1_resolution_state}\",\"evidenceDensity\":{evidence_density},\"hotspotSaturation\":{hotspot_saturation},\"decision\":\"{graph_decision_code}\",\"policyFingerprint\":\"{policy_fingerprint}\",\"blockerIds\":{graph_blocker_ids_json},\"stopCandidate\":{stop_candidate},\"graphDecision\":\"{graph_decision_code}\",\"graphDigest\":\"{graph_digest}\",\"signals\":{graph_signals_json},\"blockers\":{graph_blockers_json}},\"eventId\":\"graph-{session_id}-g{generation}-i{current_iteration}\"}'\n750:         outputs:\n751:           - graph_decision: \"CONTINUE | STOP_ALLOWED | STOP_BLOCKED\"\n752:           - graph_decision_code: \"CONTINUE maps to continue, STOP_ALLOWED to converged, STOP_BLOCKED to blocked\"\n753:           - graph_signals_json: \"JSON object returned by convergence.cjs\"\n754:           - graph_raw_signals_json: \"Exact-field convergence-signals JSON built from the convergence.cjs signals; observationDigest is the sha256 of graph_signals_json\"\n755:           - graph_blockers_json: \"JSON array of graph blockers when present, else []\"\n756:           - graph_blocker_ids_json: \"JSON array of blocker type values; use [\\\"graph_blocker\\\"] when the decision is blocked and the list is empty\"\n757:           - graph_blockers_csv: \"Comma-separated blocker summary when graph blocks STOP, else empty string\"\n758:           - graph_stop_blocked: \"Boolean true when graph_decision == STOP_BLOCKED\"\n759:           - dimension_coverage_digest: \"sha256 (64 lowercase hex) of the canonical JSON of the registry dimensionCoverage map\"\n760:           - protocol_coverage_digest: \"sha256 (64 lowercase hex) of the canonical JSON of the protocol coverage object in graph_signals_json, or of {} when absent\"\n761:           - finding_stability: \"stable when findingStabilityRatio >= convergenceThreshold, unstable when below, unknown when the signal is missing\"\n762:           - p0p1_resolution_state: \"resolved when active P0 + P1 findings are 0, blocked when above 0, unknown when counts are unavailable\"\n763:           - evidence_density: \"evidenceDensityRatio from graph_signals_json, capped at 1\"\n764:           - hotspot_saturation: \"hotspotSaturationRatio from graph_signals_json, between 0 and 1\"\n765:           - policy_fingerprint: \"sha256 (64 lowercase hex) of the canonical JSON {convergenceThreshold, stopPolicy, convergenceMode} from the review config\"\n766:           - stop_candidate: \"true when graph_decision == STOP_ALLOWED, else false\"\n767:           - graph_digest: \"sha256 (64 lowercase hex) of graph_signals_json\"\n768: \n769:       step_check_convergence:\n770:         action: \"Evaluate graph-assisted review stop conditions and the legal-stop decision tree\"\n771:         algorithm: |\n772:           0. CLAIM-ADJUDICATION PRE-CHECK (universal STOP veto; runs before hard stops and composite convergence):\n773:              claim_adjudication_gate_pass = (last_claim_adjudication_passed != false) OR (p0_count + p1_count == 0)\n774:              If claim_adjudication_gate_pass == false:\n775:                candidate_decision = \"BLOCKED\"\n776:                stop_blocked = true\n777:                stopReason = \"blockedStop\"\n778:                blocked_gates = [\"claimAdjudicationGate\"]\n779:                recovery_strategy = \"Reviewer must add typed claim-adjudication packets (claim, evidenceRefs, counterevidenceSought, alternativeExplanation, finalSeverity, confidence, downgradeTrigger) for every active P0/P1 finding before STOP is allowed.\"\n780:                Skip hard stops (1) and composite convergence (4); proceed directly to step 5 legal-stop decision-tree assembly so blocked_by_json, gate outputs, and the blocked_stop event still populate consistently.\n781:           1. HARD STOPS:\n782:              a) if iteration_count >= max_iterations: set decision = \"STOP\", stopReason = \"maxIterationsReached\", hard_stop_reason = \"max_iterations_reached\", preserve any failed legal-stop gates as terminal evidence, and proceed to synthesis without legal-stop veto\n783:              b) if stop_policy == \"max-iterations\" AND iteration_count < max_iterations: do not allow all-dimensions-clean or composite convergence to stop; treat convergence signals as telemetry, set decision = \"CONTINUE\", and broaden the next review angle.\n784:              c) if all dimensions clean AND required traceability protocols are covered AND p0_count == 0 AND p1_count == 0 AND coverage_age >= 1 AND all quality gates pass (evidence: every P0/P1 has file:line; scope: all findings within target; coverage: all dimensions reviewed): mark hard_stop_reason = \"all_dimensions_clean\" and promote to STOP candidate\n785:              Operator stop reasons (`maxIterationsReached`, `manualStop`, `userPaused`, unrecoverable `error`) are terminal ceilings. They do not hide failed gates; they record them in synthesis and stop dispatch.\n786:           2. STUCK DETECTION (threshold 2):\n787:              if stuck_count >= 2: STUCK_RECOVERY\n788:           3. GRAPH CONVERGENCE PREREQUISITE:\n789:                graph_decision, graph_signals_json, and graph_blockers_json are already populated by step_graph_convergence.\n790:                Final STOP is never legal unless the inline review vote says STOP AND graph_decision == \"STOP_ALLOWED\".\n791:                If graph_decision == \"STOP_BLOCKED\", set stop_blocked = true and route through blocked_stop emission instead of stopping.\n792:           4. COMPOSITE CONVERGENCE (3-signal weighted vote with split thresholds):\n793:                signals = []\n794:                a) Rolling average (w=0.30, window=2, needs 2+ iterations):\n795:                   avg = mean(last 2 newFindingsRatios)\n796:                   stop if avg <= 0.08\n797:                b) MAD noise floor (w=0.25, needs 3+ iterations):\n798:                   noiseFloor = MAD(all ratios) * 1.4826\n799:                   stop if latest ratio <= noiseFloor\n800:                c) Dimension coverage (w=0.45):\n801:                   coverage = dimensions_covered / total_dimensions\n802:                   stop if coverage >= 1.0 AND required traceability protocols are covered AND coverage_age >= 1\n803:                Redistribute weights for unavailable signals.\n804:                if latest ratio <= 0.05: mark no_progress_threshold_reached\n805:                if stop_policy == \"max-iterations\" AND iteration_count < max_iterations: convergence votes are telemetry only; set weighted_stop_score for diagnostics, keep decision = \"CONTINUE\", and choose a broader next focus.\n806:                else if weighted_stop_score >= 0.60: inline STOP becomes a candidate and binary gates must run\n807:           5. LEGAL-STOP DECISION TREE (review-specific gates; runs whenever step 0, all-dimensions-clean, or the composite vote promotes STOP to a candidate; terminal max-iteration/manual/error stops bypass veto and record failed gates as evidence):\n808:                a) convergenceGate: pass when a hard-stop condition is met OR weighted_stop_score >= 0.60; record score\n809:                b) dimensionCoverageGate: pass when configured dimensions and required traceability coverage are complete and coverage_age >= 1; record covered and missing dimensions\n810:                c) p0ResolutionGate: pass when activeP0 == 0; record activeP0\n811:                d) evidenceDensityGate: pass when every active P0/P1 has concrete file:line evidence and no active P0/P1 relies only on inference; record avgEvidencePerFinding\n812:                e) hotspotSaturationGate: pass when review hotspots have been revisited enough times to satisfy the saturation heuristic\n813:                f) claimAdjudicationGate: pass when claim_adjudication_gate_pass == true (i.e. last_claim_adjudication_passed != false OR there are no active P0/P1 findings to adjudicate); record last_claim_adjudication_passed and claim_adjudication_active_count\n814:                g) fixCompletenessReplayGate: pass when security_sensitive_fix_scope == false OR every required closed-gate replay row passes with file:line or command evidence and producer/consumer/matrix coverage; record security_sensitive_fix_scope, fix_completeness_replay_required_rows, and fix_completeness_replay_passing_rows\n815:                h) candidateCoverageGate: skip entirely when `reviewDepthSchemaVersion` is not 2 on the latest iteration. Otherwise pass when the current iteration's `reviewDepthApplicability.scopeClass` is `trivial` with `enforcement: \"skip\"` AND `reviewDepthApplicability.evidenceRefs` is non-empty, OR when the reducer registry's `searchDebt` is empty AND `candidateCoverage.covered` is a superset of `searchCoverage.requiredBugClasses` for the lineage. Otherwise pass = false; record `searchDebt` items as blocked-stop evidence; blocker name = \"candidateCoverageGate\"; recovery_strategy = \"Resolve deferred/blocked obligations in next iteration or downgrade scope explicitly to trivial with cited evidence.\"\n816:                i) graphlessFallbackGate: skip when `reviewDepthSchemaVersion` is not 2 OR the reducer registry's last-iteration `searchCoverage.graphCoverageMode` is `graph`. Applies when graphCoverageMode is `graphless_fallback` or `unavailable_blocked`. Pass when graphCoverageMode is `graphless_fallback` AND at least one `searchLedger` row exists for each entry in `searchCoverage.requiredBugClasses` with `searchActions[].method` in {\"direct_read\",\"exact_grep\",\"semantic_search\",\"producer_consumer_trace\",\"negative_test_inspection\"} AND non-empty `evidenceRefs`. Fail automatically when graphCoverageMode is `unavailable_blocked`; record the explicit unavailability reason. Otherwise pass = false; blocker name = \"graphlessFallbackGate\"; recovery_strategy = \"Add cited fallback ledger rows (direct read, exact search, producer/consumer trace, negative-test inspection) or set graphCoverageMode to 'graph' once graph data is available.\"\n817:              if STOP is a candidate and any gate fails:\n818:                decision = \"BLOCKED\"\n819:                stop_blocked = true\n820:                stopReason = \"blockedStop\"\n821:                blocked_by_json = JSON array of failing gate names (always include \"claimAdjudicationGate\" when claim_adjudication_gate_pass == false, \"fixCompletenessReplayGate\" when fix_completeness_replay_gate_pass == false, \"candidateCoverageGate\" when candidate_coverage_gate_pass == false, and \"graphlessFallbackGate\" when graphless_fallback_gate_pass == false)\n822:                blocked_by_csv = comma-separated list of failing gate names\n823:                convergence_gate_pass = boolean\n824:                convergence_gate_score = numeric convergence score\n825:                dimension_coverage_gate_pass = boolean\n826:                dimension_coverage_gate_covered_json = JSON array of covered review dimensions\n827:                dimension_coverage_gate_missing_json = JSON array of missing review dimensions\n828:                p0_resolution_gate_pass = boolean\n829:                active_p0_count = number of active P0 findings\n830:                evidence_density_gate_pass = boolean\n831:                avg_evidence_per_finding = numeric evidence density\n832:                hotspot_saturation_gate_pass = boolean\n833:                claim_adjudication_gate_pass = boolean\n834:                claim_adjudication_active_count = numeric count of active P0/P1 at the gate\n835:                fix_completeness_replay_gate_pass = boolean\n836:                security_sensitive_fix_scope = boolean\n837:                fix_completeness_replay_required_rows = numeric count of closed-gate replay rows required for security-sensitive fix reruns\n838:                fix_completeness_replay_passing_rows = numeric count of required closed-gate replay rows marked PASS with evidence\n839:                candidate_coverage_gate_pass = boolean\n840:                candidate_coverage_search_debt_json = JSON array of reducer-owned searchDebt obligations blocking STOP, else []\n841:                candidate_coverage_missing_json = JSON array of required bug classes not present in candidateCoverage.covered, else []\n842:                graphless_fallback_gate_pass = boolean\n843:                graphless_fallback_mode = latest reducer-owned searchCoverage.graphCoverageMode value\n844:                graphless_fallback_missing_json = JSON array of required bug classes without cited fallback ledger rows, else []\n845:                graphless_fallback_unavailability_reason = explicit reason when graphCoverageMode == \"unavailable_blocked\", else empty string\n846:                recovery_strategy = one-line hint describing the next review action needed to satisfy the failed gates; combine candidateCoverageGate and graphlessFallbackGate recovery guidance when both fail (when claimAdjudicationGate is the failing gate, prefer the step-0 recovery_strategy already set)\n847:           6. COMBINED STOP RULE:\n848:                a) if STOP is legal AND graph_decision == \"STOP_ALLOWED\": decision = \"STOP\"\n849:                b) if STOP is legal AND graph_decision == \"STOP_BLOCKED\":\n850:                     decision = \"BLOCKED\"\n851:                     stop_blocked = true\n852:                     stopReason = \"blockedStop\"\n853:                     # Blocked-stop closure: blockedBy must be string[] per the\n854:                     # published review blocked-stop contract. Extract the `.type`\n855:                     # field from each structured graph blocker; preserve the full\n856:                     # objects in graph_blocker_detail_json for operator inspection.\n857:                     blocked_by_json = JSON.stringify(graph_blockers_json.map(b => typeof b === \"string\" ? b : (b && b.type) || \"graph_blocker\"))\n858:                     blocked_by_csv = graph_blockers_csv\n859:                     graph_blocker_detail_json = graph_blockers_json\n860:                     recovery_strategy = \"Resolve review coverage-graph blockers before stopping.\"\n861:                c) if STOP is legal AND graph_decision == \"CONTINUE\":\n862:                     decision = \"CONTINUE\"\n863:                     stop_blocked = false\n864:                     reason = \"graph_convergence_continue\"\n865:                d) else keep the existing STUCK_RECOVERY or CONTINUE outcome\n866:         outputs:\n867:           - decision: \"STOP | BLOCKED | STUCK_RECOVERY | CONTINUE\"\n868:           - reason: \"Human-readable stop reason\"\n869:           - stop_blocked: \"Boolean true when STOP is vetoed by inline legal-stop gates or graph_decision == STOP_BLOCKED\"\n870:           - blocked_by_json: \"JSON array of failed legal-stop gates when decision == BLOCKED\"\n871:           - blocked_by_csv: \"Comma-separated list of failed legal-stop gates when decision == BLOCKED\"\n872:           - convergence_gate_pass: \"Boolean pass/fail for convergenceGate\"\n873:           - convergence_gate_score: \"Numeric score recorded for convergenceGate\"\n874:           - dimension_coverage_gate_pass: \"Boolean pass/fail for dimensionCoverageGate\"\n875:           - dimension_coverage_gate_covered_json: \"JSON array of covered review dimensions\"\n876:           - dimension_coverage_gate_missing_json: \"JSON array of missing review dimensions\"\n877:           - p0_resolution_gate_pass: \"Boolean pass/fail for p0ResolutionGate\"\n878:           - active_p0_count: \"Active P0 finding count at stop-check time\"\n879:           - evidence_density_gate_pass: \"Boolean pass/fail for evidenceDensityGate\"\n880:           - avg_evidence_per_finding: \"Numeric evidence density for active findings\"\n881:           - hotspot_saturation_gate_pass: \"Boolean pass/fail for hotspotSaturationGate\"\n882:           - claim_adjudication_gate_pass: \"Boolean pass/fail for claimAdjudicationGate (false vetoes STOP)\"\n883:           - claim_adjudication_active_count: \"Count of active P0/P1 findings evaluated by claimAdjudicationGate\"\n884:           - fix_completeness_replay_gate_pass: \"Boolean pass/fail for fixCompletenessReplayGate (false vetoes STOP on security-sensitive fix reruns)\"\n885:           - security_sensitive_fix_scope: \"Boolean true when the review is a security-sensitive fix rerun\"\n886:           - fix_completeness_replay_required_rows: \"Count of closed-gate replay rows required before STOP\"\n887:           - fix_completeness_replay_passing_rows: \"Count of required closed-gate replay rows that passed with evidence\"\n888:           - candidate_coverage_gate_pass: \"Boolean pass/fail for candidateCoverageGate (false vetoes STOP for unresolved reducer-owned search debt or uncovered required bug classes)\"\n889:           - candidate_coverage_search_debt_json: \"JSON array of reducer-owned searchDebt obligations used as blocked-stop evidence\"\n890:           - candidate_coverage_missing_json: \"JSON array of required bug classes missing from candidateCoverage.covered\"\n891:           - graphless_fallback_gate_pass: \"Boolean pass/fail for graphlessFallbackGate (false vetoes STOP when graphless fallback evidence is absent or unavailable_blocked)\"\n892:           - graphless_fallback_mode: \"Latest reducer-owned searchCoverage.graphCoverageMode value\"\n893:           - graphless_fallback_missing_json: \"JSON array of required bug classes missing cited fallback ledger rows\"\n894:           - graphless_fallback_unavailability_reason: \"Explicit unavailability reason when graphCoverageMode == unavailable_blocked\"\n895:           - graph_decision: \"CONTINUE | STOP_ALLOWED | STOP_BLOCKED from step_graph_convergence\"\n896:           - graph_signals_json: \"JSON object returned by graph convergence\"\n897:           - graph_blockers_json: \"JSON array of graph blockers\"\n898:           - graph_blockers_csv: \"Comma-separated graph blocker summary\"\n899:           - recovery_strategy: \"One-line hint describing the next review action when decision == BLOCKED or STUCK_RECOVERY\"\n900:           - recovery_strategy_code: \"Slug form of recovery_strategy for the ledger code fields\"\n901:           - gate_results_array_json: \"One {gateId,status,reasonCode,evidenceDigest} row per legal-stop gate (convergenceGate, dimensionCoverageGate, evidenceDensityGate, hotspotSaturationGate, claimAdjudicationGate, fixCompletenessReplayGate, candidateCoverageGate, graphlessFallbackGate), with at least one fail row when decision == BLOCKED\"\n902:           - active_total_count: \"p0_count + p1_count + p2_count, the active findings total\"\n903: \n904:       step_emit_blocked_stop:\n905:         action: \"Persist blocked-stop evidence whenever the review legal-stop decision tree vetoes STOP\"\n906:         if_blocked:\n907:           append_jsonl: '{\"stem\":\"deep_review.blocked_stop_recorded\",\"scope\":{\"runId\":\"{session_id}\",\"sessionId\":\"{session_id}\",\"generation\":{generation},\"iterationId\":\"iteration-{current_iteration}\"},\"data\":{\"blockedGateIds\":{blocked_by_json},\"gateResults\":{gate_results_array_json},\"activeFindingCounts\":{\"candidates\":{active_total_count},\"adjudicated\":{active_total_count},\"p0\":{p0_count},\"p1\":{p1_count},\"p2\":{p2_count}},\"recoveryStrategy\":\"{recovery_strategy_code}\",\"targetDimensionId\":\"{next_dimension}\",\"originatingConvergenceEventId\":\"graph-{session_id}-g{generation}-i{current_iteration}\",\"appendPosition\":{current_iteration},\"gateDetail\":{gate_results_array_json},\"graphBlockerDetail\":{graph_blockers_json},\"recoveryHint\":\"{recovery_strategy}\"}}'\n908:           log: \"Blocked STOP persisted for review loop. Failed gates: {blocked_by_csv}. Recovery strategy: {recovery_strategy}\"\n909:         if_not_blocked:\n910:           proceed: true\n911: \n912:       step_handle_convergence:\n913:         action: \"Act on convergence decision\"\n914:         if_stop:\n915:           branch_on: \"convergence_mode == 'divergent' AND reason == 'all_dimensions_clean'\"\n916:           if_divergent_eligible:\n917:             eligibility_contract:\n918:               required_decision: \"STOP\"\n919:               eligible_reasons: [all_dimensions_clean]\n920:               excluded_reasons: [maxIterationsReached, blockedStop, stuckRecovery, error, manualStop, userPaused]\n921:               fail_closed: \"Any missing or ambiguous reason uses if_existing_terminal_path without preparing a pivot. The nine legal-stop gates have already run and remain unchanged.\"\n922:             steps:\n923:               step_prepare_divergent_pivot:\n924:                 action: \"Generate state-grounded read-only review candidates and prepare or resume the pivot transaction\"\n925:                 command: |\n926:                   node --import \"$(node -p \"require.resolve('tsx', { paths: ['.skilled/skills/system-deep-loop/runtime'] })\")\" --input-type=module <<'EOF'\n927:                   import {\n928:                     buildReviewPivotPreparationInput,\n929:                     renderReviewPivotSeatPrompt,\n930:                   } from './.skilled/skills/system-deep-loop/deep-review/scripts/divergent-review-pivot.ts';\n931:                   import {\n932:                     preparePivotTransaction,\n933:                   } from './.skilled/skills/system-deep-loop/runtime/lib/deep-loop/divergent-pivot.ts';\n934: \n935:                   const input = buildReviewPivotPreparationInput({\n936:                     artifactRoot: '{state_paths.packet_dir}',\n937:                     configPath: '{state_paths.config}',\n938:                     stateLogPath: '{state_paths.state_log}',\n939:                     strategyPath: '{state_paths.strategy}',\n940:                     registryPath: '{state_paths.findings_registry}',\n941:                     currentIteration: Number('{current_iteration}'),\n942:                     maxIterations: Number('{max_iterations}'),\n943:                     triggerReason: '{reason}',\n944:                   });\n945:                   const prepared = await preparePivotTransaction(input);\n946:                   const seatPrompts = prepared.status === 'pending'\n947:                     ? Object.fromEntries(prepared.missingSeats.map((seat) => [\n948:                         seat.id,\n949:                         renderReviewPivotSeatPrompt(seat, prepared.dispatchContext),\n950:                       ]))\n951:                     : {};\n952:                   process.stdout.write(`${JSON.stringify({\n953:                     ...prepared,\n954:                     seatPrompts,\n955:                     boundaryRejections: input.boundaryRejections,\n956:                   })}\\n`);\n957:                   EOF\n958:                 working_directory: \"{repo_root}\"\n959:                 outputs:\n960:                   - pivot_prepare_json: \"The complete parsed JSON result\"\n961:                   - pivot_prepare_status: \"status from the prepare result\"\n962:                   - pivot_id: \"pivotId from the prepare result\"\n963:                   - pivot_paths_json: \"paths from the prepare result as JSON\"\n964:                   - pivot_resumed: \"resumed from the prepare result\"\n965:                   - pivot_missing_seat_ids: \"missingSeats ids from a pending result\"\n966:                   - pivot_seat_001_json: \"The seat-001 mandate object from missingSeats\"\n967:                   - pivot_seat_002_json: \"The seat-002 mandate object from missingSeats\"\n968:                   - pivot_seat_003_json: \"The seat-003 mandate object from missingSeats\"\n969:                   - pivot_seat_001_prompt: \"seatPrompts['seat-001']\"\n970:                   - pivot_seat_002_prompt: \"seatPrompts['seat-002']\"\n971:                   - pivot_seat_003_prompt: \"seatPrompts['seat-003']\"\n972:                   - pivot_dispatch_context_json: \"dispatchContext from a pending result as JSON\"\n973:                 short_circuit: \"When status is completed or failed, skip all dispatch and record steps and bind this result as pivot_result.\"\n974: \n975:               step_dispatch_pivot_seat_001:\n976:                 action: \"Natively dispatch the analytical read-only review direction-selection seat\"\n977:                 skip_when: \"pivot_prepare_status != 'pending' or pivot_missing_seat_ids does not contain 'seat-001'\"\n978:                 capture_timing: true\n979:                 if_native:\n980:                   dispatch:\n981:                     agent: deep-review\n982:                     model: opus\n983:                     context_source: \"pivot_seat_001_prompt\"\n984:                   wait_for_completion: true\n985:                 failure_contract: \"A native dispatch failure binds status=rejected, a {name,message} error, and the measured timestamps/duration, then proceeds to step_record_pivot_seat_001.\"\n986:                 outputs:\n987:                   - pivot_seat_001_dispatch_status: \"fulfilled or rejected\"\n988:                   - pivot_seat_001_output_json: \"Raw native return serialized as JSON when fulfilled\"\n989:                   - pivot_seat_001_error_json: \"{name,message} when rejected\"\n990:                   - pivot_seat_001_started_at_iso: \"Dispatch start timestamp\"\n991:                   - pivot_seat_001_completed_at_iso: \"Dispatch completion timestamp\"\n992:                   - pivot_seat_001_duration_ms: \"Dispatch duration in milliseconds\"\n993: \n994:               step_record_pivot_seat_001:\n995:                 action: \"Durably record the seat-001 native dispatch outcome\"\n996:                 skip_when: \"pivot_prepare_status != 'pending' or pivot_missing_seat_ids does not contain 'seat-001'\"\n997:                 command: |\n998:                   node --import \"$(node -p \"require.resolve('tsx', { paths: ['.skilled/skills/system-deep-loop/runtime'] })\")\" --input-type=module <<'EOF'\n999:                   import { recordPivotSeatResult } from './.skilled/skills/system-deep-loop/runtime/lib/deep-loop/divergent-pivot.ts';\n1000:                   const status = '{pivot_seat_001_dispatch_status}';\n1001:                   const outcome = status === 'fulfilled'\n1002:                     ? { status, output: {pivot_seat_001_output_json}, startedAtIso: '{pivot_seat_001_started_at_iso}', completedAtIso: '{pivot_seat_001_completed_at_iso}', durationMs: Number('{pivot_seat_001_duration_ms}') }\n1003:                     : { status: 'rejected', error: {pivot_seat_001_error_json}, startedAtIso: '{pivot_seat_001_started_at_iso}', completedAtIso: '{pivot_seat_001_completed_at_iso}', durationMs: Number('{pivot_seat_001_duration_ms}') };\n1004:                   process.stdout.write(`${JSON.stringify(recordPivotSeatResult({ paths: {pivot_paths_json}, pivotId: '{pivot_id}', seat: {pivot_seat_001_json}, outcome }))}\\n`);\n1005:                   EOF\n1006:                 working_directory: \"{repo_root}\"\n1007: \n1008:               step_dispatch_pivot_seat_002:\n1009:                 action: \"Natively dispatch the critical read-only review direction-selection seat\"\n1010:                 skip_when: \"pivot_prepare_status != 'pending' or pivot_missing_seat_ids does not contain 'seat-002'\"\n1011:                 capture_timing: true\n1012:                 if_native:\n1013:                   dispatch:\n1014:                     agent: deep-review\n1015:                     model: opus\n1016:                     context_source: \"pivot_seat_002_prompt\"\n1017:                   wait_for_completion: true\n1018:                 failure_contract: \"A native dispatch failure binds status=rejected, a {name,message} error, and the measured timestamps/duration, then proceeds to step_record_pivot_seat_002.\"\n1019:                 outputs:\n1020:                   - pivot_seat_002_dispatch_status: \"fulfilled or rejected\"\n1021:                   - pivot_seat_002_output_json: \"Raw native return serialized as JSON when fulfilled\"\n1022:                   - pivot_seat_002_error_json: \"{name,message} when rejected\"\n1023:                   - pivot_seat_002_started_at_iso: \"Dispatch start timestamp\"\n1024:                   - pivot_seat_002_completed_at_iso: \"Dispatch completion timestamp\"\n1025:                   - pivot_seat_002_duration_ms: \"Dispatch duration in milliseconds\"\n1026: \n1027:               step_record_pivot_seat_002:\n1028:                 action: \"Durably record the seat-002 native dispatch outcome\"\n1029:                 skip_when: \"pivot_prepare_status != 'pending' or pivot_missing_seat_ids does not contain 'seat-002'\"\n1030:                 command: |\n1031:                   node --import \"$(node -p \"require.resolve('tsx', { paths: ['.skilled/skills/system-deep-loop/runtime'] })\")\" --input-type=module <<'EOF'\n1032:                   import { recordPivotSeatResult } from './.skilled/skills/system-deep-loop/runtime/lib/deep-loop/divergent-pivot.ts';\n1033:                   const status = '{pivot_seat_002_dispatch_status}';\n1034:                   const outcome = status === 'fulfilled'\n1035:                     ? { status, output: {pivot_seat_002_output_json}, startedAtIso: '{pivot_seat_002_started_at_iso}', completedAtIso: '{pivot_seat_002_completed_at_iso}', durationMs: Number('{pivot_seat_002_duration_ms}') }\n1036:                     : { status: 'rejected', error: {pivot_seat_002_error_json}, startedAtIso: '{pivot_seat_002_started_at_iso}', completedAtIso: '{pivot_seat_002_completed_at_iso}', durationMs: Number('{pivot_seat_002_duration_ms}') };\n1037:                   process.stdout.write(`${JSON.stringify(recordPivotSeatResult({ paths: {pivot_paths_json}, pivotId: '{pivot_id}', seat: {pivot_seat_002_json}, outcome }))}\\n`);\n1038:                   EOF\n1039:                 working_directory: \"{repo_root}\"\n1040: \n1041:               step_dispatch_pivot_seat_003:\n1042:                 action: \"Natively dispatch the pragmatic read-only review direction-selection seat\"\n1043:                 skip_when: \"pivot_prepare_status != 'pending' or pivot_missing_seat_ids does not contain 'seat-003'\"\n1044:                 capture_timing: true\n1045:                 if_native:\n1046:                   dispatch:\n1047:                     agent: deep-review\n1048:                     model: opus\n1049:                     context_source: \"pivot_seat_003_prompt\"\n1050:                   wait_for_completion: true\n1051:                 failure_contract: \"A native dispatch failure binds status=rejected, a {name,message} error, and the measured timestamps/duration, then proceeds to step_record_pivot_seat_003.\"\n1052:                 outputs:\n1053:                   - pivot_seat_003_dispatch_status: \"fulfilled or rejected\"\n1054:                   - pivot_seat_003_output_json: \"Raw native return serialized as JSON when fulfilled\"\n1055:                   - pivot_seat_003_error_json: \"{name,message} when rejected\"\n1056:                   - pivot_seat_003_started_at_iso: \"Dispatch start timestamp\"\n1057:                   - pivot_seat_003_completed_at_iso: \"Dispatch completion timestamp\"\n1058:                   - pivot_seat_003_duration_ms: \"Dispatch duration in milliseconds\"\n1059: \n1060:               step_record_pivot_seat_003:\n1061:                 action: \"Durably record the seat-003 native dispatch outcome\"\n1062:                 skip_when: \"pivot_prepare_status != 'pending' or pivot_missing_seat_ids does not contain 'seat-003'\"\n1063:                 command: |\n1064:                   node --import \"$(node -p \"require.resolve('tsx', { paths: ['.skilled/skills/system-deep-loop/runtime'] })\")\" --input-type=module <<'EOF'\n1065:                   import { recordPivotSeatResult } from './.skilled/skills/system-deep-loop/runtime/lib/deep-loop/divergent-pivot.ts';\n1066:                   const status = '{pivot_seat_003_dispatch_status}';\n1067:                   const outcome = status === 'fulfilled'\n1068:                     ? { status, output: {pivot_seat_003_output_json}, startedAtIso: '{pivot_seat_003_started_at_iso}', completedAtIso: '{pivot_seat_003_completed_at_iso}', durationMs: Number('{pivot_seat_003_duration_ms}') }\n1069:                     : { status: 'rejected', error: {pivot_seat_003_error_json}, startedAtIso: '{pivot_seat_003_started_at_iso}', completedAtIso: '{pivot_seat_003_completed_at_iso}', durationMs: Number('{pivot_seat_003_duration_ms}') };\n1070:                   process.stdout.write(`${JSON.stringify(recordPivotSeatResult({ paths: {pivot_paths_json}, pivotId: '{pivot_id}', seat: {pivot_seat_003_json}, outcome }))}\\n`);\n1071:                   EOF\n1072:                 working_directory: \"{repo_root}\"\n1073: \n1074:               step_finalize_divergent_pivot:\n1075:                 action: \"Finalize the prepared pivot after all missing native seats are durable\"\n1076:                 skip_when: \"pivot_prepare_status != 'pending'\"\n1077:                 command: |\n1078:                   node --import \"$(node -p \"require.resolve('tsx', { paths: ['.skilled/skills/system-deep-loop/runtime'] })\")\" --input-type=module <<'EOF'\n1079:                   import { finalizePivotTransaction } from './.skilled/skills/system-deep-loop/runtime/lib/deep-loop/divergent-pivot.ts';\n1080:                   process.stdout.write(`${JSON.stringify(finalizePivotTransaction({ paths: {pivot_paths_json}, pivotId: '{pivot_id}', resumed: {pivot_resumed} }))}\\n`);\n1081:                   EOF\n1082:                 working_directory: \"{repo_root}\"\n1083:                 outputs:\n1084:                   - pivot_finalize_json: \"The complete parsed final result\"\n1085: \n1086:               step_resolve_divergent_pivot_result:\n1087:                 action: \"Use prepare's terminal result on resume/short-circuit, otherwise use finalize's result\"\n1088:                 branch_on: \"pivot_prepare_status\"\n1089:                 if_pending: { bind: { pivot_result: \"{pivot_finalize_json}\" } }\n1090:                 if_completed_or_failed: { bind: { pivot_result: \"{pivot_prepare_json}\" } }\n1091: \n1092:               step_apply_divergent_pivot_result:\n1093:                 action: \"Adopt a successful read-only review direction or fail closed to the existing synthesis path\"\n1094:                 branch_on: \"pivot_result.status\"\n1095:                 if_completed:\n1096:                   set:\n1097:                     next_dimension: \"{pivot_result.restoredFocus}\"\n1098:                     pivot_lineage: \"Pivot {pivot_result.pivotId} selected {pivot_result.selectedCandidate.id} from source iteration {current_iteration}.\"\n1099:                     saturated_directions: \"{pivot_result.completedEvent.saturatedDirections}\"\n1100:                   command: \"node .skilled/skills/system-deep-loop/runtime/scripts/reduce-state.cjs {spec_folder} {reducer_artifact_arg} --create-missing-anchors\"\n1101:                   log: \"Divergent review pivot {pivot_result.pivotId} restored focus to {pivot_result.restoredFocus}; continuing iteration {current_iteration}.\"\n1102:                   proceed_to: step_normalize_pause_events\n1103:                 if_failed:\n1104:                   log: \"Divergent review pivot {pivot_result.pivotId} failed closed ({pivot_result.failureReason}); proceeding to synthesis.\"\n1105:                   skip_to: phase_synthesis\n1106:             on_error:\n1107:               log: \"Divergent review pivot integration error; failing closed to the existing synthesis path.\"\n1108:               skip_to: phase_synthesis\n1109:           if_existing_terminal_path:\n1110:             log: \"Loop stopping. Reason: {reason}\"\n1111:             skip_to: phase_synthesis\n1112:         if_blocked:\n1113:           log: \"Legal-stop gates blocked STOP. Failed gates: {blocked_by_csv}. Continuing review.\"\n1114:         if_stuck_recovery:\n1115:           log: \"Stuck detected ({stuck_count} consecutive no-progress). Entering recovery.\"\n1116:           recovery_strategies:\n1117:             - \"Change granularity: file-level → function-level → line-level review\"\n1118:             - \"Traceability protocol replay: re-run unresolved core or overlay checks\"\n1119:             - \"Escalate severity review: re-examine P2 findings for potential P1 upgrades\"\n1120:           pivot_target: \"Pivot to the least-covered dimension (the review dimension with the fewest iteration passes and lowest coverage ratio).\"\n1121:           set:\n1122:             next_dimension: \"RECOVERY: {recovery_strategy}. Least-covered dimension: {least_explored}\"\n1123:             pending_stop_event: \"stuck_recovery\"\n1124:             pending_stop_reason: \"stuckRecovery\"\n1125:             pending_stop_detail: \"Recovery path activated after repeated no-progress iterations\"\n1126:           reset: { stuck_count: 0 }\n1127:         if_continue:\n1128:           log: \"Iteration {current_iteration}: Continuing. Dimension: {next_dimension}\"\n1129: \n1130:       step_normalize_pause_events:\n1131:         action: \"Rewrite raw pause and recovery events to the frozen STOP_REASONS enum at emission time: converged, maxIterationsReached, blockedStop, stuckRecovery, error, manualStop, userPaused\"\n1132:         if_pending_pause_event:\n1133:           append_jsonl: '{\"stem\":\"deep_review.pause_recorded\",\"scope\":{\"runId\":\"{session_id}\",\"sessionId\":\"{session_id}\",\"generation\":{generation},\"iterationId\":\"iteration-{current_iteration}\"},\"data\":{\"normalizedStopReason\":\"userPaused\",\"sentinelCause\":\"sentinel-file-detected\",\"fromIterationId\":\"iteration-{current_iteration}\",\"strategy\":\"await-operator-resume\",\"targetDimensionId\":\"{next_dimension}\",\"outcome\":\"paused\",\"lineageRef\":\"{session_id}\",\"priorTailDigest\":\"{prior_tail_digest}\"}}'\n1134:           message: \"Review paused. Delete review/.deep-review-pause to resume.\"\n1135:           reset:\n1136:             pending_stop_event: null\n1137:             pending_stop_reason: null\n1138:             pending_stop_detail: null\n1139:           halt: true\n1140:         if_pending_stuck_recovery:\n1141:           append_jsonl: '{\"stem\":\"deep_review.recovery_started\",\"scope\":{\"runId\":\"{session_id}\",\"sessionId\":\"{session_id}\",\"generation\":{generation},\"iterationId\":\"iteration-{current_iteration}\",\"dimensionId\":\"{least_explored}\"},\"data\":{\"normalizedStopReason\":\"stuckRecovery\",\"recoveryCause\":\"repeated-no-progress\",\"fromIterationId\":\"iteration-{current_iteration}\",\"strategy\":\"{recovery_strategy_code}\",\"targetDimensionId\":\"{least_explored}\",\"outcome\":\"recovery-started\",\"lineageRef\":\"{session_id}\",\"priorTailDigest\":\"{prior_tail_digest}\",\"originatingPauseEventId\":\"none\"}}'\n1142:           reset:\n1143:             pending_stop_event: null\n1144:             pending_stop_reason: null\n1145:             pending_stop_detail: null\n1146:         if_no_pending_event:\n1147:           proceed: true\n1148:         outputs:\n1149:           - prior_tail_digest: \"sha256 (64 lowercase hex) of the state log bytes at the moment the pause or recovery row is emitted\"\n1150: \n1151:       step_generate_state_summary:\n1152:         action: \"Generate compact state summary for dispatch context (~200 tokens)\"\n1153:         generate: |\n1154:           STATE SUMMARY (auto-generated):\n1155:           Iteration: {current_iteration} of {max_iterations}\n1156:           Dimension: {next_dimension}\n1157:           Prior Findings: P0={p0_count} P1={p1_count} P2={p2_count}\n1158:           Dimension Coverage: {dimensions_covered_list} ({dimension_coverage})\n1159:           Traceability: core={core_protocol_status} overlay={overlay_protocol_status}\n1160:           {resource_map_prompt_line}\n1161:           Coverage Age: {coverage_age}\n1162:           Last 2 ratios: {ratio_prev} -> {ratio_latest}\n1163:           Stuck count: {stuck_count}\n1164:           Provisional Verdict: {PASS|CONDITIONAL|FAIL|PENDING} hasAdvisories={has_advisories}\n1165: \n1166:       step_marker_scan:\n1167:         action: \"H-2 loop-prevention guard: scan previous iteration's rendered prompt for nested review marker\"\n1168:         canonical_header: \"DEEP-REVIEW\"\n1169:         nested_marker_pattern: \"^(DEEP-RESEARCH|CODE-REVIEW)$\"\n1170:         algorithm: |\n1171:           if current_iteration > 1:\n1172:             PREV_PROMPT_PATH = \"{state_paths.prompt_dir}/iteration-{previous_iteration}.md\"\n1173:             if file_exists(PREV_PROMPT_PATH):\n1174:               PREV_PROMPT_FIRST_LINE = head -1 of PREV_PROMPT_PATH\n1175:               if PREV_PROMPT_FIRST_LINE matches nested_marker_pattern:\n1176:                 log \"ERROR: nested review loop detected (foreign deep-loop marker found in previous iteration prompt). Aborting.\"\n1177:                 halt with exit code 2\n1178:         note: |\n1179:           False-positive prevention: a review prompt that starts with its own canonical\n1180:           header is this loop's own iteration output, never a nested dispatch; only a\n1181:           foreign marker (DEEP-RESEARCH or CODE-REVIEW) is, so the guard matches\n1182:           nested_marker_pattern rather than the canonical header. Markers appearing in\n1183:           comments or body text are ignored. True-positive triggers only when a previous\n1184:           iteration's rendered prompt literally starts with a foreign deep-loop marker,\n1185:           indicating a nested review dispatch.\n1186: \n1187:       step_dispatch_iteration:\n1188:         action: \"Dispatch @deep-review agent for one review iteration\"\n1189:         resolve_executor:\n1190:           source: \"config.executor\"\n1191:           loader: \".skilled/skills/system-deep-loop/runtime/lib/deep-loop/executor-config.ts#parseExecutorConfig\"\n1192:         pre_dispatch:\n1193:           generate_summary: |\n1194:             STATE SUMMARY (auto-generated):\n1195:             Iteration: {current_iteration} of {max_iterations}\n1196:             Dimension: {next_dimension}\n1197:             Prior Findings: P0={p0_count} P1={p1_count} P2={p2_count}\n1198:             Dimension Coverage: {dimensions_covered_list} ({dimension_coverage})\n1199:             Traceability: core={core_protocol_status} overlay={overlay_protocol_status}\n[Output truncated. Continue reading with offset: 1200]","title":"read","metadata":{"metadata":{"truncated":true},"content":[{"type":"text","text":"Read file .skilled/commands/deep/assets/deep-review-auto.yaml, lines 660-1199\n660:   phase_loop:\n661:     purpose: Dispatch review agent iterations until convergence\n662:     repeat: true\n663:     max_repeats: \"{max_iterations}\"\n664:     steps:\n665: \n666:       step_refresh_lock:\n667:         action: \"Refresh the packet lock heartbeat before the iteration begins\"\n668:         command: \"node .skilled/skills/system-deep-loop/runtime/scripts/loop-lock.cjs refresh --lock-path {state_paths.lock_file} --owner-pid {captured_owner_pid} --nonce {captured_acquire_nonce}\"\n669:         on_refresh: \"If the refresh output has refreshed:false, fail closed: lost the packet lock. This run no longer holds the packet and must stop rather than iterate without it.\"\n670: \n671:       step_record_artifact_migration:\n672:         action: \"Record the legacy review state move once per session, after the run is open\"\n673:         skip_when: \"legacy_migration_detected != true or migration_recorded == true\"\n674:         append_jsonl: '{\"stem\":\"deep_review.migration\",\"scope\":{\"runId\":\"{session_id}\",\"sessionId\":\"{session_id}\"},\"data\":{\"mode\":\"review\",\"legacyArtifacts\":[\"deep-research-config.json\",\"deep-research-state.jsonl\",\".deep-research-pause\"],\"canonicalArtifacts\":[\"deep-review-config.json\",\"deep-review-state.jsonl\",\".deep-review-pause\"]}}'\n675:         set: { migration_recorded: true }\n676: \n677:       step_read_state:\n678:         action: \"Read current state from JSONL, strategy, and config\"\n679:         read:\n680:           - \"{state_paths.state_log}\"\n681:           - \"{state_paths.findings_registry}\"\n682:           - \"{state_paths.strategy}\"\n683:           - \"{state_paths.config}\"\n684:         extract:\n685:           - iteration_count: \"Count distinct run values (the integer iteration, else a numeric run) across lines where type === 'iteration'; a redispatched run counts once\"\n686:           - highest_run: \"Highest run value (the integer iteration, else a numeric run) across lines where type === 'iteration', else 0\"\n687:           - current_iteration: \"max(highest_run, iteration_count) + 1\"\n688:           - last_newFindingsRatio: \"Extract newFindingsRatio from last iteration record\"\n689:           - last_focus: \"Extract focus/dimension from latest iteration record, else 'none yet'\"\n690:           - ratio_prev: \"Extract newFindingsRatio from second-latest iteration record, else 'N/A'\"\n691:           - ratio_latest: \"Extract newFindingsRatio from latest iteration record, else 'N/A'\"\n692:           - next_dimension: \"Next uncovered dimension from dimension_queue in strategy.md\"\n693:           - dimensions_covered: \"List of dimensions already reviewed\"\n694:           - dimensions_remaining: \"List of dimensions not yet reviewed\"\n695:           - dimension_coverage: \"covered / total dimensions\"\n696:           - coverage_age: \"Iterations since dimension coverage last changed; require >= 1 before STOP\"\n697:           - p0_count: \"Count P0 findings across all iterations\"\n698:           - p1_count: \"Count P1 findings across all iterations\"\n699:           - p2_count: \"Count P2 findings across all iterations\"\n700:           - resource_map_present: \"Extract boolean from deep-review-config.json, default false\"\n701:           - resource_map_prompt_line: \"If resource_map_present is true, return 'Resource Map Coverage: cross-check target_files from {spec_folder}/applied/T-*.md against {spec_folder}/resource-map.md and classify only missed coverage as gaps.' Else return 'Resource Map Coverage: resource-map.md not present; skipping coverage gate.'\"\n702:           - session_id: \"Extract sessionId from deep-review-config.json\"\n703:           - generation: \"Extract generation from deep-review-config.json, else 1\"\n704:           - last_3_summaries: \"Summarize the latest 3 iteration records as 'run N: dimension (ratio, P0/P1/P2)'\"\n705:           - latest_status: \"Extract status from latest iteration record, else 'none yet'\"\n706:           - last_claim_adjudication_passed: \"Scan state.jsonl for the most recent `claim_adjudication` event; use its `passed` boolean. Default true when no event exists or when activeP0 + activeP1 == 0 (gate is vacuous without adjudicable findings).\"\n707:           - claim_adjudication_active_count: \"Count of active P0/P1 findings at the time of the last claim_adjudication event; 0 when none exist\"\n708:           - security_sensitive_fix_scope: \"Boolean true when the current review is a rerun after fixes involving security, path disclosure, auth/authz, sandboxing, env precedence, public schemas, persistence, or user-visible error payloads; derive from the latest review report, remediation notes, or planning packet when present, else false.\"\n709:           - fix_completeness_replay_required_rows: \"Count prior active or remediated P0/P1 findings, plus any prior security/path P2 findings, that require closed-gate replay before STOP.\"\n710:           - fix_completeness_replay_passing_rows: \"Count required replay rows marked PASS with file:line or command evidence and producer/consumer/matrix coverage.\"\n711:           - stop_policy: \"Extract stopPolicy from deep-review-config.json, default 'convergence'. Valid values: convergence, max-iterations.\"\n712:           - convergence_mode: \"Extract antiConvergence.convergenceMode when it is one of 'default', 'off', 'sliding-window', or 'divergent'; default to 'default'\"\n713:           - convergence_mode_warning: \"Boolean true when antiConvergence.convergenceMode is present with an unsupported value; use 'default'\"\n714:           - pivot_lineage: \"Summarize registry.divergence.completed and registry.divergence.overrides with pivot ids, source iterations, and selected review direction; else 'none yet'\"\n715:           - saturated_directions: \"List registry.divergence.saturatedDirections; else 'none yet'\"\n716:           - review_focus_block: \"When deep-review-config.json reviewFocus is a non-empty string, return 'Operator review focus (cover it in addition to the dimension of this iteration, and say in the narrative how you addressed it): <reviewFocus>'. Else return an empty string.\"\n717: \n718:       step_check_pause_sentinel:\n719:         action: \"Check for pause sentinel file\"\n720:         check: \"Does {state_paths.pause_sentinel} exist?\"\n721:         if_exists:\n722:           set:\n723:             pending_stop_event: \"paused\"\n724:             pending_stop_reason: \"userPaused\"\n725:             pending_stop_detail: \"sentinel file detected\"\n726:           skip_to: step_normalize_pause_events\n727:         if_not_exists:\n728:           proceed: true\n729: \n730:       step_validate_convergence_config:\n731:         action: \"Validate convergence mode when loading config\"\n732:         if_convergence_mode_invalid:\n733:           bookkeeping_log: '{\"type\":\"event\",\"event\":\"config_warning\",\"mode\":\"review\",\"field\":\"antiConvergence.convergenceMode\",\"fallback\":\"default\",\"message\":\"Unsupported convergenceMode; using default convergence behavior.\",\"timestamp\":\"{ISO_8601_NOW}\",\"sessionId\":\"{session_id}\",\"generation\":{generation}}'\n734:           log: \"Unsupported convergenceMode; using default convergence behavior.\"\n735: \n736:       step_graph_convergence:\n737:         action: \"Evaluate coverage-graph convergence before the inline review convergence vote\"\n738:         inspect:\n739:           - \"{state_paths.state_log}\"\n740:           - \"{state_paths.findings_registry}\"\n741:         transform: |\n742:           1. Call graph convergence on the current review lineage before the inline 3-signal vote.\n743:           2. Record the decision as one of CONTINUE, STOP_ALLOWED, STOP_BLOCKED.\n744:           3. Preserve raw graph signals and blockers for reducer rollup and blocked-stop evidence.\n745:           4. Normalize blockers to both JSON array and CSV forms for downstream stop handling.\n746:           5. Set graph_stop_blocked = true only when graph_decision == \"STOP_BLOCKED\".\n747:         bash: 'node .skilled/skills/system-deep-loop/runtime/scripts/convergence.cjs --spec-folder \"{spec_folder}\" --loop-type \"review\" --session-id \"{session_id}\" --convergence-mode \"{convergence_mode}\"'\n748:         note: \"Invoke the runtime script directly. Review-side graph convergence must run before the inline review stop vote.\"\n749:         append_jsonl: '{\"stem\":\"deep_review.graph_convergence_evaluated\",\"scope\":{\"runId\":\"{session_id}\",\"sessionId\":\"{session_id}\",\"generation\":{generation},\"iterationId\":\"iteration-{current_iteration}\"},\"data\":{\"rawSignals\":{graph_raw_signals_json},\"weightedSignals\":{graph_raw_signals_json},\"dimensionCoverageDigest\":\"{dimension_coverage_digest}\",\"protocolCoverageDigest\":\"{protocol_coverage_digest}\",\"findingStability\":\"{finding_stability}\",\"p0p1ResolutionState\":\"{p0p1_resolution_state}\",\"evidenceDensity\":{evidence_density},\"hotspotSaturation\":{hotspot_saturation},\"decision\":\"{graph_decision_code}\",\"policyFingerprint\":\"{policy_fingerprint}\",\"blockerIds\":{graph_blocker_ids_json},\"stopCandidate\":{stop_candidate},\"graphDecision\":\"{graph_decision_code}\",\"graphDigest\":\"{graph_digest}\",\"signals\":{graph_signals_json},\"blockers\":{graph_blockers_json}},\"eventId\":\"graph-{session_id}-g{generation}-i{current_iteration}\"}'\n750:         outputs:\n751:           - graph_decision: \"CONTINUE | STOP_ALLOWED | STOP_BLOCKED\"\n752:           - graph_decision_code: \"CONTINUE maps to continue, STOP_ALLOWED to converged, STOP_BLOCKED to blocked\"\n753:           - graph_signals_json: \"JSON object returned by convergence.cjs\"\n754:           - graph_raw_signals_json: \"Exact-field convergence-signals JSON built from the convergence.cjs signals; observationDigest is the sha256 of graph_signals_json\"\n755:           - graph_blockers_json: \"JSON array of graph blockers when present, else []\"\n756:           - graph_blocker_ids_json: \"JSON array of blocker type values; use [\\\"graph_blocker\\\"] when the decision is blocked and the list is empty\"\n757:           - graph_blockers_csv: \"Comma-separated blocker summary when graph blocks STOP, else empty string\"\n758:           - graph_stop_blocked: \"Boolean true when graph_decision == STOP_BLOCKED\"\n759:           - dimension_coverage_digest: \"sha256 (64 lowercase hex) of the canonical JSON of the registry dimensionCoverage map\"\n760:           - protocol_coverage_digest: \"sha256 (64 lowercase hex) of the canonical JSON of the protocol coverage object in graph_signals_json, or of {} when absent\"\n761:           - finding_stability: \"stable when findingStabilityRatio >= convergenceThreshold, unstable when below, unknown when the signal is missing\"\n762:           - p0p1_resolution_state: \"resolved when active P0 + P1 findings are 0, blocked when above 0, unknown when counts are unavailable\"\n763:           - evidence_density: \"evidenceDensityRatio from graph_signals_json, capped at 1\"\n764:           - hotspot_saturation: \"hotspotSaturationRatio from graph_signals_json, between 0 and 1\"\n765:           - policy_fingerprint: \"sha256 (64 lowercase hex) of the canonical JSON {convergenceThreshold, stopPolicy, convergenceMode} from the review config\"\n766:           - stop_candidate: \"true when graph_decision == STOP_ALLOWED, else false\"\n767:           - graph_digest: \"sha256 (64 lowercase hex) of graph_signals_json\"\n768: \n769:       step_check_convergence:\n770:         action: \"Evaluate graph-assisted review stop conditions and the legal-stop decision tree\"\n771:         algorithm: |\n772:           0. CLAIM-ADJUDICATION PRE-CHECK (universal STOP veto; runs before hard stops and composite convergence):\n773:              claim_adjudication_gate_pass = (last_claim_adjudication_passed != false) OR (p0_count + p1_count == 0)\n774:              If claim_adjudication_gate_pass == false:\n775:                candidate_decision = \"BLOCKED\"\n776:                stop_blocked = true\n777:                stopReason = \"blockedStop\"\n778:                blocked_gates = [\"claimAdjudicationGate\"]\n779:                recovery_strategy = \"Reviewer must add typed claim-adjudication packets (claim, evidenceRefs, counterevidenceSought, alternativeExplanation, finalSeverity, confidence, downgradeTrigger) for every active P0/P1 finding before STOP is allowed.\"\n780:                Skip hard stops (1) and composite convergence (4); proceed directly to step 5 legal-stop decision-tree assembly so blocked_by_json, gate outputs, and the blocked_stop event still populate consistently.\n781:           1. HARD STOPS:\n782:              a) if iteration_count >= max_iterations: set decision = \"STOP\", stopReason = \"maxIterationsReached\", hard_stop_reason = \"max_iterations_reached\", preserve any failed legal-stop gates as terminal evidence, and proceed to synthesis without legal-stop veto\n783:              b) if stop_policy == \"max-iterations\" AND iteration_count < max_iterations: do not allow all-dimensions-clean or composite convergence to stop; treat convergence signals as telemetry, set decision = \"CONTINUE\", and broaden the next review angle.\n784:              c) if all dimensions clean AND required traceability protocols are covered AND p0_count == 0 AND p1_count == 0 AND coverage_age >= 1 AND all quality gates pass (evidence: every P0/P1 has file:line; scope: all findings within target; coverage: all dimensions reviewed): mark hard_stop_reason = \"all_dimensions_clean\" and promote to STOP candidate\n785:              Operator stop reasons (`maxIterationsReached`, `manualStop`, `userPaused`, unrecoverable `error`) are terminal ceilings. They do not hide failed gates; they record them in synthesis and stop dispatch.\n786:           2. STUCK DETECTION (threshold 2):\n787:              if stuck_count >= 2: STUCK_RECOVERY\n788:           3. GRAPH CONVERGENCE PREREQUISITE:\n789:                graph_decision, graph_signals_json, and graph_blockers_json are already populated by step_graph_convergence.\n790:                Final STOP is never legal unless the inline review vote says STOP AND graph_decision == \"STOP_ALLOWED\".\n791:                If graph_decision == \"STOP_BLOCKED\", set stop_blocked = true and route through blocked_stop emission instead of stopping.\n792:           4. COMPOSITE CONVERGENCE (3-signal weighted vote with split thresholds):\n793:                signals = []\n794:                a) Rolling average (w=0.30, window=2, needs 2+ iterations):\n795:                   avg = mean(last 2 newFindingsRatios)\n796:                   stop if avg <= 0.08\n797:                b) MAD noise floor (w=0.25, needs 3+ iterations):\n798:                   noiseFloor = MAD(all ratios) * 1.4826\n799:                   stop if latest ratio <= noiseFloor\n800:                c) Dimension coverage (w=0.45):\n801:                   coverage = dimensions_covered / total_dimensions\n802:                   stop if coverage >= 1.0 AND required traceability protocols are covered AND coverage_age >= 1\n803:                Redistribute weights for unavailable signals.\n804:                if latest ratio <= 0.05: mark no_progress_threshold_reached\n805:                if stop_policy == \"max-iterations\" AND iteration_count < max_iterations: convergence votes are telemetry only; set weighted_stop_score for diagnostics, keep decision = \"CONTINUE\", and choose a broader next focus.\n806:                else if weighted_stop_score >= 0.60: inline STOP becomes a candidate and binary gates must run\n807:           5. LEGAL-STOP DECISION TREE (review-specific gates; runs whenever step 0, all-dimensions-clean, or the composite vote promotes STOP to a candidate; terminal max-iteration/manual/error stops bypass veto and record failed gates as evidence):\n808:                a) convergenceGate: pass when a hard-stop condition is met OR weighted_stop_score >= 0.60; record score\n809:                b) dimensionCoverageGate: pass when configured dimensions and required traceability coverage are complete and coverage_age >= 1; record covered and missing dimensions\n810:                c) p0ResolutionGate: pass when activeP0 == 0; record activeP0\n811:                d) evidenceDensityGate: pass when every active P0/P1 has concrete file:line evidence and no active P0/P1 relies only on inference; record avgEvidencePerFinding\n812:                e) hotspotSaturationGate: pass when review hotspots have been revisited enough times to satisfy the saturation heuristic\n813:                f) claimAdjudicationGate: pass when claim_adjudication_gate_pass == true (i.e. last_claim_adjudication_passed != false OR there are no active P0/P1 findings to adjudicate); record last_claim_adjudication_passed and claim_adjudication_active_count\n814:                g) fixCompletenessReplayGate: pass when security_sensitive_fix_scope == false OR every required closed-gate replay row passes with file:line or command evidence and producer/consumer/matrix coverage; record security_sensitive_fix_scope, fix_completeness_replay_required_rows, and fix_completeness_replay_passing_rows\n815:                h) candidateCoverageGate: skip entirely when `reviewDepthSchemaVersion` is not 2 on the latest iteration. Otherwise pass when the current iteration's `reviewDepthApplicability.scopeClass` is `trivial` with `enforcement: \"skip\"` AND `reviewDepthApplicability.evidenceRefs` is non-empty, OR when the reducer registry's `searchDebt` is empty AND `candidateCoverage.covered` is a superset of `searchCoverage.requiredBugClasses` for the lineage. Otherwise pass = false; record `searchDebt` items as blocked-stop evidence; blocker name = \"candidateCoverageGate\"; recovery_strategy = \"Resolve deferred/blocked obligations in next iteration or downgrade scope explicitly to trivial with cited evidence.\"\n816:                i) graphlessFallbackGate: skip when `reviewDepthSchemaVersion` is not 2 OR the reducer registry's last-iteration `searchCoverage.graphCoverageMode` is `graph`. Applies when graphCoverageMode is `graphless_fallback` or `unavailable_blocked`. Pass when graphCoverageMode is `graphless_fallback` AND at least one `searchLedger` row exists for each entry in `searchCoverage.requiredBugClasses` with `searchActions[].method` in {\"direct_read\",\"exact_grep\",\"semantic_search\",\"producer_consumer_trace\",\"negative_test_inspection\"} AND non-empty `evidenceRefs`. Fail automatically when graphCoverageMode is `unavailable_blocked`; record the explicit unavailability reason. Otherwise pass = false; blocker name = \"graphlessFallbackGate\"; recovery_strategy = \"Add cited fallback ledger rows (direct read, exact search, producer/consumer trace, negative-test inspection) or set graphCoverageMode to 'graph' once graph data is available.\"\n817:              if STOP is a candidate and any gate fails:\n818:                decision = \"BLOCKED\"\n819:                stop_blocked = true\n820:                stopReason = \"blockedStop\"\n821:                blocked_by_json = JSON array of failing gate names (always include \"claimAdjudicationGate\" when claim_adjudication_gate_pass == false, \"fixCompletenessReplayGate\" when fix_completeness_replay_gate_pass == false, \"candidateCoverageGate\" when candidate_coverage_gate_pass == false, and \"graphlessFallbackGate\" when graphless_fallback_gate_pass == false)\n822:                blocked_by_csv = comma-separated list of failing gate names\n823:                convergence_gate_pass = boolean\n824:                convergence_gate_score = numeric convergence score\n825:                dimension_coverage_gate_pass = boolean\n826:                dimension_coverage_gate_covered_json = JSON array of covered review dimensions\n827:                dimension_coverage_gate_missing_json = JSON array of missing review dimensions\n828:                p0_resolution_gate_pass = boolean\n829:                active_p0_count = number of active P0 findings\n830:                evidence_density_gate_pass = boolean\n831:                avg_evidence_per_finding = numeric evidence density\n832:                hotspot_saturation_gate_pass = boolean\n833:                claim_adjudication_gate_pass = boolean\n834:                claim_adjudication_active_count = numeric count of active P0/P1 at the gate\n835:                fix_completeness_replay_gate_pass = boolean\n836:                security_sensitive_fix_scope = boolean\n837:                fix_completeness_replay_required_rows = numeric count of closed-gate replay rows required for security-sensitive fix reruns\n838:                fix_completeness_replay_passing_rows = numeric count of required closed-gate replay rows marked PASS with evidence\n839:                candidate_coverage_gate_pass = boolean\n840:                candidate_coverage_search_debt_json = JSON array of reducer-owned searchDebt obligations blocking STOP, else []\n841:                candidate_coverage_missing_json = JSON array of required bug classes not present in candidateCoverage.covered, else []\n842:                graphless_fallback_gate_pass = boolean\n843:                graphless_fallback_mode = latest reducer-owned searchCoverage.graphCoverageMode value\n844:                graphless_fallback_missing_json = JSON array of required bug classes without cited fallback ledger rows, else []\n845:                graphless_fallback_unavailability_reason = explicit reason when graphCoverageMode == \"unavailable_blocked\", else empty string\n846:                recovery_strategy = one-line hint describing the next review action needed to satisfy the failed gates; combine candidateCoverageGate and graphlessFallbackGate recovery guidance when both fail (when claimAdjudicationGate is the failing gate, prefer the step-0 recovery_strategy already set)\n847:           6. COMBINED STOP RULE:\n848:                a) if STOP is legal AND graph_decision == \"STOP_ALLOWED\": decision = \"STOP\"\n849:                b) if STOP is legal AND graph_decision == \"STOP_BLOCKED\":\n850:                     decision = \"BLOCKED\"\n851:                     stop_blocked = true\n852:                     stopReason = \"blockedStop\"\n853:                     # Blocked-stop closure: blockedBy must be string[] per the\n854:                     # published review blocked-stop contract. Extract the `.type`\n855:                     # field from each structured graph blocker; preserve the full\n856:                     # objects in graph_blocker_detail_json for operator inspection.\n857:                     blocked_by_json = JSON.stringify(graph_blockers_json.map(b => typeof b === \"string\" ? b : (b && b.type) || \"graph_blocker\"))\n858:                     blocked_by_csv = graph_blockers_csv\n859:                     graph_blocker_detail_json = graph_blockers_json\n860:                     recovery_strategy = \"Resolve review coverage-graph blockers before stopping.\"\n861:                c) if STOP is legal AND graph_decision == \"CONTINUE\":\n862:                     decision = \"CONTINUE\"\n863:                     stop_blocked = false\n864:                     reason = \"graph_convergence_continue\"\n865:                d) else keep the existing STUCK_RECOVERY or CONTINUE outcome\n866:         outputs:\n867:           - decision: \"STOP | BLOCKED | STUCK_RECOVERY | CONTINUE\"\n868:           - reason: \"Human-readable stop reason\"\n869:           - stop_blocked: \"Boolean true when STOP is vetoed by inline legal-stop gates or graph_decision == STOP_BLOCKED\"\n870:           - blocked_by_json: \"JSON array of failed legal-stop gates when decision == BLOCKED\"\n871:           - blocked_by_csv: \"Comma-separated list of failed legal-stop gates when decision == BLOCKED\"\n872:           - convergence_gate_pass: \"Boolean pass/fail for convergenceGate\"\n873:           - convergence_gate_score: \"Numeric score recorded for convergenceGate\"\n874:           - dimension_coverage_gate_pass: \"Boolean pass/fail for dimensionCoverageGate\"\n875:           - dimension_coverage_gate_covered_json: \"JSON array of covered review dimensions\"\n876:           - dimension_coverage_gate_missing_json: \"JSON array of missing review dimensions\"\n877:           - p0_resolution_gate_pass: \"Boolean pass/fail for p0ResolutionGate\"\n878:           - active_p0_count: \"Active P0 finding count at stop-check time\"\n879:           - evidence_density_gate_pass: \"Boolean pass/fail for evidenceDensityGate\"\n880:           - avg_evidence_per_finding: \"Numeric evidence density for active findings\"\n881:           - hotspot_saturation_gate_pass: \"Boolean pass/fail for hotspotSaturationGate\"\n882:           - claim_adjudication_gate_pass: \"Boolean pass/fail for claimAdjudicationGate (false vetoes STOP)\"\n883:           - claim_adjudication_active_count: \"Count of active P0/P1 findings evaluated by claimAdjudicationGate\"\n884:           - fix_completeness_replay_gate_pass: \"Boolean pass/fail for fixCompletenessReplayGate (false vetoes STOP on security-sensitive fix reruns)\"\n885:           - security_sensitive_fix_scope: \"Boolean true when the review is a security-sensitive fix rerun\"\n886:           - fix_completeness_replay_required_rows: \"Count of closed-gate replay rows required before STOP\"\n887:           - fix_completeness_replay_passing_rows: \"Count of required closed-gate replay rows that passed with evidence\"\n888:           - candidate_coverage_gate_pass: \"Boolean pass/fail for candidateCoverageGate (false vetoes STOP for unresolved reducer-owned search debt or uncovered required bug classes)\"\n889:           - candidate_coverage_search_debt_json: \"JSON array of reducer-owned searchDebt obligations used as blocked-stop evidence\"\n890:           - candidate_coverage_missing_json: \"JSON array of required bug classes missing from candidateCoverage.covered\"\n891:           - graphless_fallback_gate_pass: \"Boolean pass/fail for graphlessFallbackGate (false vetoes STOP when graphless fallback evidence is absent or unavailable_blocked)\"\n892:           - graphless_fallback_mode: \"Latest reducer-owned searchCoverage.graphCoverageMode value\"\n893:           - graphless_fallback_missing_json: \"JSON array of required bug classes missing cited fallback ledger rows\"\n894:           - graphless_fallback_unavailability_reason: \"Explicit unavailability reason when graphCoverageMode == unavailable_blocked\"\n895:           - graph_decision: \"CONTINUE | STOP_ALLOWED | STOP_BLOCKED from step_graph_convergence\"\n896:           - graph_signals_json: \"JSON object returned by graph convergence\"\n897:           - graph_blockers_json: \"JSON array of graph blockers\"\n898:           - graph_blockers_csv: \"Comma-separated graph blocker summary\"\n899:           - recovery_strategy: \"One-line hint describing the next review action when decision == BLOCKED or STUCK_RECOVERY\"\n900:           - recovery_strategy_code: \"Slug form of recovery_strategy for the ledger code fields\"\n901:           - gate_results_array_json: \"One {gateId,status,reasonCode,evidenceDigest} row per legal-stop gate (convergenceGate, dimensionCoverageGate, evidenceDensityGate, hotspotSaturationGate, claimAdjudicationGate, fixCompletenessReplayGate, candidateCoverageGate, graphlessFallbackGate), with at least one fail row when decision == BLOCKED\"\n902:           - active_total_count: \"p0_count + p1_count + p2_count, the active findings total\"\n903: \n904:       step_emit_blocked_stop:\n905:         action: \"Persist blocked-stop evidence whenever the review legal-stop decision tree vetoes STOP\"\n906:         if_blocked:\n907:           append_jsonl: '{\"stem\":\"deep_review.blocked_stop_recorded\",\"scope\":{\"runId\":\"{session_id}\",\"sessionId\":\"{session_id}\",\"generation\":{generation},\"iterationId\":\"iteration-{current_iteration}\"},\"data\":{\"blockedGateIds\":{blocked_by_json},\"gateResults\":{gate_results_array_json},\"activeFindingCounts\":{\"candidates\":{active_total_count},\"adjudicated\":{active_total_count},\"p0\":{p0_count},\"p1\":{p1_count},\"p2\":{p2_count}},\"recoveryStrategy\":\"{recovery_strategy_code}\",\"targetDimensionId\":\"{next_dimension}\",\"originatingConvergenceEventId\":\"graph-{session_id}-g{generation}-i{current_iteration}\",\"appendPosition\":{current_iteration},\"gateDetail\":{gate_results_array_json},\"graphBlockerDetail\":{graph_blockers_json},\"recoveryHint\":\"{recovery_strategy}\"}}'\n908:           log: \"Blocked STOP persisted for review loop. Failed gates: {blocked_by_csv}. Recovery strategy: {recovery_strategy}\"\n909:         if_not_blocked:\n910:           proceed: true\n911: \n912:       step_handle_convergence:\n913:         action: \"Act on convergence decision\"\n914:         if_stop:\n915:           branch_on: \"convergence_mode == 'divergent' AND reason == 'all_dimensions_clean'\"\n916:           if_divergent_eligible:\n917:             eligibility_contract:\n918:               required_decision: \"STOP\"\n919:               eligible_reasons: [all_dimensions_clean]\n920:               excluded_reasons: [maxIterationsReached, blockedStop, stuckRecovery, error, manualStop, userPaused]\n921:               fail_closed: \"Any missing or ambiguous reason uses if_existing_terminal_path without preparing a pivot. The nine legal-stop gates have already run and remain unchanged.\"\n922:             steps:\n923:               step_prepare_divergent_pivot:\n924:                 action: \"Generate state-grounded read-only review candidates and prepare or resume the pivot transaction\"\n925:                 command: |\n926:                   node --import \"$(node -p \"require.resolve('tsx', { paths: ['.skilled/skills/system-deep-loop/runtime'] })\")\" --input-type=module <<'EOF'\n927:                   import {\n928:                     buildReviewPivotPreparationInput,\n929:                     renderReviewPivotSeatPrompt,\n930:                   } from './.skilled/skills/system-deep-loop/deep-review/scripts/divergent-review-pivot.ts';\n931:                   import {\n932:                     preparePivotTransaction,\n933:                   } from './.skilled/skills/system-deep-loop/runtime/lib/deep-loop/divergent-pivot.ts';\n934: \n935:                   const input = buildReviewPivotPreparationInput({\n936:                     artifactRoot: '{state_paths.packet_dir}',\n937:                     configPath: '{state_paths.config}',\n938:                     stateLogPath: '{state_paths.state_log}',\n939:                     strategyPath: '{state_paths.strategy}',\n940:                     registryPath: '{state_paths.findings_registry}',\n941:                     currentIteration: Number('{current_iteration}'),\n942:                     maxIterations: Number('{max_iterations}'),\n943:                     triggerReason: '{reason}',\n944:                   });\n945:                   const prepared = await preparePivotTransaction(input);\n946:                   const seatPrompts = prepared.status === 'pending'\n947:                     ? Object.fromEntries(prepared.missingSeats.map((seat) => [\n948:                         seat.id,\n949:                         renderReviewPivotSeatPrompt(seat, prepared.dispatchContext),\n950:                       ]))\n951:                     : {};\n952:                   process.stdout.write(`${JSON.stringify({\n953:                     ...prepared,\n954:                     seatPrompts,\n955:                     boundaryRejections: input.boundaryRejections,\n956:                   })}\\n`);\n957:                   EOF\n958:                 working_directory: \"{repo_root}\"\n959:                 outputs:\n960:                   - pivot_prepare_json: \"The complete parsed JSON result\"\n961:                   - pivot_prepare_status: \"status from the prepare result\"\n962:                   - pivot_id: \"pivotId from the prepare result\"\n963:                   - pivot_paths_json: \"paths from the prepare result as JSON\"\n964:                   - pivot_resumed: \"resumed from the prepare result\"\n965:                   - pivot_missing_seat_ids: \"missingSeats ids from a pending result\"\n966:                   - pivot_seat_001_json: \"The seat-001 mandate object from missingSeats\"\n967:                   - pivot_seat_002_json: \"The seat-002 mandate object from missingSeats\"\n968:                   - pivot_seat_003_json: \"The seat-003 mandate object from missingSeats\"\n969:                   - pivot_seat_001_prompt: \"seatPrompts['seat-001']\"\n970:                   - pivot_seat_002_prompt: \"seatPrompts['seat-002']\"\n971:                   - pivot_seat_003_prompt: \"seatPrompts['seat-003']\"\n972:                   - pivot_dispatch_context_json: \"dispatchContext from a pending result as JSON\"\n973:                 short_circuit: \"When status is completed or failed, skip all dispatch and record steps and bind this result as pivot_result.\"\n974: \n975:               step_dispatch_pivot_seat_001:\n976:                 action: \"Natively dispatch the analytical read-only review direction-selection seat\"\n977:                 skip_when: \"pivot_prepare_status != 'pending' or pivot_missing_seat_ids does not contain 'seat-001'\"\n978:                 capture_timing: true\n979:                 if_native:\n980:                   dispatch:\n981:                     agent: deep-review\n982:                     model: opus\n983:                     context_source: \"pivot_seat_001_prompt\"\n984:                   wait_for_completion: true\n985:                 failure_contract: \"A native dispatch failure binds status=rejected, a {name,message} error, and the measured timestamps/duration, then proceeds to step_record_pivot_seat_001.\"\n986:                 outputs:\n987:                   - pivot_seat_001_dispatch_status: \"fulfilled or rejected\"\n988:                   - pivot_seat_001_output_json: \"Raw native return serialized as JSON when fulfilled\"\n989:                   - pivot_seat_001_error_json: \"{name,message} when rejected\"\n990:                   - pivot_seat_001_started_at_iso: \"Dispatch start timestamp\"\n991:                   - pivot_seat_001_completed_at_iso: \"Dispatch completion timestamp\"\n992:                   - pivot_seat_001_duration_ms: \"Dispatch duration in milliseconds\"\n993: \n994:               step_record_pivot_seat_001:\n995:                 action: \"Durably record the seat-001 native dispatch outcome\"\n996:                 skip_when: \"pivot_prepare_status != 'pending' or pivot_missing_seat_ids does not contain 'seat-001'\"\n997:                 command: |\n998:                   node --import \"$(node -p \"require.resolve('tsx', { paths: ['.skilled/skills/system-deep-loop/runtime'] })\")\" --input-type=module <<'EOF'\n999:                   import { recordPivotSeatResult } from './.skilled/skills/system-deep-loop/runtime/lib/deep-loop/divergent-pivot.ts';\n1000:                   const status = '{pivot_seat_001_dispatch_status}';\n1001:                   const outcome = status === 'fulfilled'\n1002:                     ? { status, output: {pivot_seat_001_output_json}, startedAtIso: '{pivot_seat_001_started_at_iso}', completedAtIso: '{pivot_seat_001_completed_at_iso}', durationMs: Number('{pivot_seat_001_duration_ms}') }\n1003:                     : { status: 'rejected', error: {pivot_seat_001_error_json}, startedAtIso: '{pivot_seat_001_started_at_iso}', completedAtIso: '{pivot_seat_001_completed_at_iso}', durationMs: Number('{pivot_seat_001_duration_ms}') };\n1004:                   process.stdout.write(`${JSON.stringify(recordPivotSeatResult({ paths: {pivot_paths_json}, pivotId: '{pivot_id}', seat: {pivot_seat_001_json}, outcome }))}\\n`);\n1005:                   EOF\n1006:                 working_directory: \"{repo_root}\"\n1007: \n1008:               step_dispatch_pivot_seat_002:\n1009:                 action: \"Natively dispatch the critical read-only review direction-selection seat\"\n1010:                 skip_when: \"pivot_prepare_status != 'pending' or pivot_missing_seat_ids does not contain 'seat-002'\"\n1011:                 capture_timing: true\n1012:                 if_native:\n1013:                   dispatch:\n1014:                     agent: deep-review\n1015:                     model: opus\n1016:                     context_source: \"pivot_seat_002_prompt\"\n1017:                   wait_for_completion: true\n1018:                 failure_contract: \"A native dispatch failure binds status=rejected, a {name,message} error, and the measured timestamps/duration, then proceeds to step_record_pivot_seat_002.\"\n1019:                 outputs:\n1020:                   - pivot_seat_002_dispatch_status: \"fulfilled or rejected\"\n1021:                   - pivot_seat_002_output_json: \"Raw native return serialized as JSON when fulfilled\"\n1022:                   - pivot_seat_002_error_json: \"{name,message} when rejected\"\n1023:                   - pivot_seat_002_started_at_iso: \"Dispatch start timestamp\"\n1024:                   - pivot_seat_002_completed_at_iso: \"Dispatch completion timestamp\"\n1025:                   - pivot_seat_002_duration_ms: \"Dispatch duration in milliseconds\"\n1026: \n1027:               step_record_pivot_seat_002:\n1028:                 action: \"Durably record the seat-002 native dispatch outcome\"\n1029:                 skip_when: \"pivot_prepare_status != 'pending' or pivot_missing_seat_ids does not contain 'seat-002'\"\n1030:                 command: |\n1031:                   node --import