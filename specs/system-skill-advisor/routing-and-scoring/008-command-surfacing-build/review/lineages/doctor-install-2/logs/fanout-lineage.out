{"type":"tool_use","timestamp":1794570890279,"sessionID":"ses_e2b4a18a6ffeJYEGLs0dTSiOZ0","part":{"partID":"prt_1d4c2aac50020cBxy7ujqiMTrn","sessionID":"ses_e2b4a18a6ffeJYEGLs0dTSiOZ0","messageID":"msg_1d4c25b61001kdO2lxdulfJtU4","type":"tool","id":"call_8bdbcb9751784d02a1f4950f","tool":"shell","state":{"status":"completed","input":{"command":"sed -n '120,210p' .skilled/commands/doctor/scripts/codex-hook-approval-check.cjs"},"output":"  return { kind: 'absent' };\n}\n\n// The approval block ends at the next TOML header, so a trusted_hash recorded\n// under a different hooks.state key must not count for this entry.\nfunction approvalFound(configFile, keys) {\n  let text;\n  try {\n    text = fs.readFileSync(configFile, 'utf8');\n  } catch {\n    return false;\n  }\n  const lines = text.split(/\\r?\\n/);\n  const headers = new Set(keys.map((key) => `[hooks.state.\"${key}\"]`));\n  for (let index = 0; index < lines.length; index += 1) {\n    if (!headers.has(lines[index].trim())) continue;\n    for (let cursor = index + 1; cursor < lines.length; cursor += 1) {\n      const line = lines[cursor].trim();\n      if (line.startsWith('[')) break;\n      if (/^trusted_hash\\s*=/.test(line)) return true;\n    }\n  }\n  return false;\n}\n\nfunction report(options, verdict, lines) {\n  if (options.json) {\n    process.stdout.write(`${JSON.stringify(verdict, null, 2)}\\n`);\n    return;\n  }\n  for (const line of lines) process.stdout.write(`${line}\\n`);\n}\n\n// ─────────────────────────────────────────────────────────────────────────────\n// 4. CORE LOGIC\n// ─────────────────────────────────────────────────────────────────────────────\n\nfunction main(argv) {\n  const options = parseArgs(argv);\n  if (options === null) {\n    process.stderr.write(USAGE);\n    return 2;\n  }\n\n  const root = options.root;\n  const hooksFile = path.join(root, '.codex', 'hooks.json');\n  const entry = findAdvisorEntry(hooksFile);\n\n  if (entry.kind === 'skip') {\n    report(options, { status: 'skip', code: 'no-codex-hooks', root }, ['SKIP no-codex-hooks']);\n    return 0;\n  }\n\n  if (entry.kind === 'absent') {\n    // An absent entry has no approval to offer yet, so the repair starts with the\n    // copy that creates it and ends with the approval that lets it run.\n    const repair = `repair: copy the advisor UserPromptSubmit entry from the Skilled checkout's .codex/hooks.json into ${hooksFile}, then approve it with /hooks in a Codex session`;\n    report(options, {\n      status: 'warn',\n      code: 'codex-advisor-hook-absent',\n      root,\n      hooksFile,\n      repair,\n    }, ['WARN codex-advisor-hook-absent', repair]);\n    return 1;\n  }\n\n  const configFile = options.config || defaultConfigFile();\n  const keys = hookStateKeys(root, entry.group, entry.index);\n  if (approvalFound(configFile, keys)) {\n    report(options, {\n      status: 'pass',\n      code: 'codex-hooks-approved',\n      root,\n      group: entry.group,\n      index: entry.index,\n      config: configFile,\n    }, ['PASS codex-hooks-approved']);\n    return 0;\n  }\n\n  const repair = `repair: open /hooks in a Codex session at ${root} and approve each entry`;\n  report(options, {\n    status: 'warn',\n    code: 'codex-hooks-unapproved',\n    root,\n    group: entry.group,\n    index: entry.index,\n    config: configFile,\n    repair,\n  }, [`WARN codex-hooks-unapproved ${root}`, repair]);\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"  return { kind: 'absent' };\n}\n\n// The approval block ends at the next TOML header, so a trusted_hash recorded\n// under a different hooks.state key must not count for this entry.\nfunction approvalFound(configFile, keys) {\n  let text;\n  try {\n    text = fs.readFileSync(configFile, 'utf8');\n  } catch {\n    return false;\n  }\n  const lines = text.split(/\\r?\\n/);\n  const headers = new Set(keys.map((key) => `[hooks.state.\"${key}\"]`));\n  for (let index = 0; index < lines.length; index += 1) {\n    if (!headers.has(lines[index].trim())) continue;\n    for (let cursor = index + 1; cursor < lines.length; cursor += 1) {\n      const line = lines[cursor].trim();\n      if (line.startsWith('[')) break;\n      if (/^trusted_hash\\s*=/.test(line)) return true;\n    }\n  }\n  return false;\n}\n\nfunction report(options, verdict, lines) {\n  if (options.json) {\n    process.stdout.write(`${JSON.stringify(verdict, null, 2)}\\n`);\n    return;\n  }\n  for (const line of lines) process.stdout.write(`${line}\\n`);\n}\n\n// ─────────────────────────────────────────────────────────────────────────────\n// 4. CORE LOGIC\n// ─────────────────────────────────────────────────────────────────────────────\n\nfunction main(argv) {\n  const options = parseArgs(argv);\n  if (options === null) {\n    process.stderr.write(USAGE);\n    return 2;\n  }\n\n  const root = options.root;\n  const hooksFile = path.join(root, '.codex', 'hooks.json');\n  const entry = findAdvisorEntry(hooksFile);\n\n  if (entry.kind === 'skip') {\n    report(options, { status: 'skip', code: 'no-codex-hooks', root }, ['SKIP no-codex-hooks']);\n    return 0;\n  }\n\n  if (entry.kind === 'absent') {\n    // An absent entry has no approval to offer yet, so the repair starts with the\n    // copy that creates it and ends with the approval that lets it run.\n    const repair = `repair: copy the advisor UserPromptSubmit entry from the Skilled checkout's .codex/hooks.json into ${hooksFile}, then approve it with /hooks in a Codex session`;\n    report(options, {\n      status: 'warn',\n      code: 'codex-advisor-hook-absent',\n      root,\n      hooksFile,\n      repair,\n    }, ['WARN codex-advisor-hook-absent', repair]);\n    return 1;\n  }\n\n  const configFile = options.config || defaultConfigFile();\n  const keys = hookStateKeys(root, entry.group, entry.index);\n  if (approvalFound(configFile, keys)) {\n    report(options, {\n      status: 'pass',\n      code: 'codex-hooks-approved',\n      root,\n      group: entry.group,\n      index: entry.index,\n      config: configFile,\n    }, ['PASS codex-hooks-approved']);\n    return 0;\n  }\n\n  const repair = `repair: open /hooks in a Codex session at ${root} and approve each entry`;\n  report(options, {\n    status: 'warn',\n    code: 'codex-hooks-unapproved',\n    root,\n    group: entry.group,\n    index: entry.index,\n    config: configFile,\n    repair,\n  }, [`WARN codex-hooks-unapproved ${root}`, repair]);\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"sed -n '120,210p' .skilled/commands/doctor/scripts/codex-hook-approval-check.cjs\"}"},"time":{"start":1794570889925,"end":1794570890279}}}}
