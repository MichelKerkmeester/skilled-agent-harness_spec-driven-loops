":true}}\\\"; }'\",\n          \"timeout\": 10\n        },\n        {\n          \"type\": \"command\",\n          \"command\": \"bash -c 'cd \\\"${DEVIN_PROJECT_DIR:-$PWD}\\\" && bash .skilled/bin/worktree-guard.sh'\",\n          \"timeout\": 3\n        },\n        {\n          \"type\": \"command\",\n          \"command\": \"bash -c 'cd \\\"${DEVIN_PROJECT_DIR:-$PWD}\\\" && bash .skilled/bin/check-git-hooks.sh'\",\n          \"timeout\": 3\n        },\n        {\n          \"type\": \"command\",\n          \"command\": \"bash -c 'cd \\\"${DEVIN_PROJECT_DIR:-$PWD}\\\" && python3 .skilled/skills/sk-code/sk-code-quality/scripts/check-dist-staleness.sh --all'\",\n          \"timeout\": 5\n        },\n        {\n          \"type\": \"command\",\n          \"command\": \"bash -c 'cd \\\"${DEVIN_PROJECT_DIR:-$PWD}\\\" && node .skilled/bin/install-codex-hooks.mjs --check >/dev/null 2>&1 || echo \\\"[codex-hooks] drift detected - run: node .skilled/bin/install-codex-hooks.mjs --check\\\"'\",\n          \"timeout\": 5\n        },\n        {\n          \"type\": \"command\",\n          \"command\": \"bash -c 'cd \\\"${DEVIN_PROJECT_DIR:-$PWD}\\\" && node .skilled/hooks/goal/devin/goal-inject.mjs || { printf \\\"%s\\\\n\\\" \\\"mk-hook-drift host=devin event=SessionStart adapter=goal-inject.mjs\\\" >&2; printf %s \\\"{\\\\\\\"hookSpecificOutput\\\\\\\":{\\\\\\\"hookEventName\\\\\\\":\\\\\\\"SessionStart\\\\\\\",\\\\\\\"additionalContext\\\\\\\":\\\\\\\"mk devin hook could not resolve; run npm run build in the spec-kit runtime package\\\\\\\",\\\\\\\"mkHookDrift\\\\\\\":true}}\\\"; }'\",\n          \"timeout\": 10\n        },\n        {\n          \"type\": \"command\",\n          \"command\": \"bash -c 'cd \\\"${DEVIN_PROJECT_DIR:-$PWD}\\\" && bash .skilled/bin/git-primary-reconcile.sh >/dev/null 2>&1 &'\",\n          \"timeout\": 3\n        },\n        {\n          \"type\": \"command\",\n          \"command\": \"bash -c 'cd \\\"${DEVIN_PROJECT_DIR:-$PWD}\\\" && bash .skilled/bin/git-live-follow.sh --start'\",\n          \"timeout\": 3\n        }\n      ]\n    }\n  ],\n  \"UserPromptSubmit\": [\n    {\n      \"matcher\": \"\",\n      \"hooks\": [\n        {\n          \"type\": \"command\",\n          \"command\": \"bash -c 'cd \\\"${DEVIN_PROJECT_DIR:-$PWD}\\\" && node .skilled/skills/system-spec-kit/runtime/dist/hooks/devin/user-prompt-submit.js || { printf \\\"%s\\\\n\\\" \\\"mk-hook-drift host=devin event=UserPromptSubmit adapter=user-prompt-submit.js\\\" >&2; printf %s \\\"{\\\\\\\"hookSpecificOutput\\\\\\\":{\\\\\\\"hookEventName\\\\\\\":\\\\\\\"UserPromptSubmit\\\\\\\",\\\\\\\"additionalContext\\\\\\\":\\\\\\\"mk devin hook could not resolve; run npm run build in the spec-kit runtime package\\\\\\\",\\\\\\\"mkHookDrift\\\\\\\":true}}\\\"; }'\",\n          \"timeout\": 10\n        },\n        {\n          \"type\": \"command\",\n          \"command\": \"bash -c 'cd \\\"${DEVIN_PROJECT_DIR:-$PWD}\\\" && node .skilled/skills/system-spec-kit/runtime/hooks/devin/spec-gate-classify.mjs'\",\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"#!/usr/bin/env node\n// ───────────────────────────────────────────────────────────────────\n// MODULE: Hook Wiring Check\n// ───────────────────────────────────────────────────────────────────\n'use strict';\n\n// Read-only /doctor diagnostic for the prompt hook entry each runtime loads.\n//\n// WHY THIS EXISTS: the skill advisor reaches a first prompt only through the hook\n// entry a runtime fires before the model sees that prompt. A runtime folder can be\n// installed while its hook file is missing, its JSON is unreadable, or the entry\n// was never added, and then the advisor is silent with no error at session start.\n// This check names the runtime and the file to repair.\n//\n// Never writes. Exit 0 when every installed runtime carries its entry, 1 when one\n// is missing, 2 on a bad argument or a missing root.\n\n// ─────────────────────────────────────────────────────────────────────────────\n// 1. IMPORTS\n// ─────────────────────────────────────────────────────────────────────────────\n\nconst fs = require('node:fs');\nconst path = require('node:path');\n\n// ─────────────────────────────────────────────────────────────────────────────\n// 2. CONSTANTS\n// ─────────────────────────────────────────────────────────────────────────────\n\nconst USAGE = [\n  'Usage: hook-wiring-check.cjs --root <dir> [--json]',\n  '  --root  check the checkout under <dir>.',\n  '  --json  print one JSON object instead of one line per runtime.',\n].join('\\n');\n\n// Each entry names the runtime folder that decides whether the check applies,\n// the hook file inside it, the event that carries the prompt entry, and the path\n// fragment whose presence proves the entry is wired. A runtime folder that is\n// absent is skipped, because that runtime was never installed in this checkout.\nconst RUNTIMES = [\n  {\n    id: 'claude',\n    dir: '.claude',\n    file: '.claude/settings.json',\n    event: 'UserPromptSubmit',\n    marker: 'hooks/claude/user-prompt-submit.js',\n  },\n  {\n    id: 'codex',\n    dir: '.codex',\n    file: '.codex/hooks.json',\n    event: 'UserPromptSubmit',\n    marker: 'hooks/codex/user-prompt-submit.js',\n  },\n  {\n    id: 'cursor',\n    dir: '.cursor',\n    file: '.cursor/hooks.json',\n    event: 'beforeSubmitPrompt',\n    marker: 'hooks/cursor/user-prompt-submit.js',\n  },\n  {\n    id: 'devin',\n    dir: '.devin',\n    file: '.devin/hooks.v1.json',\n    event: 'UserPromptSubmit',\n    marker: 'hooks/devin/user-prompt-submit.js',\n  },\n];\n\n// ─────────────────────────────────────────────────────────────────────────────\n// 3. HELPERS\n// ─────────────────────────────────────────────────────────────────────────────\n\nfunction fail(message) {\n  process.stderr.write(`hook-wiring-check: ${message}\\n`);\n  process.exit(2);\n}\n\nfunction parseArgs(argv) {\n  const opts = { root: null, json: false };\n  for (let i = 0; i < argv.length; i += 1) {\n    const arg = argv[i];\n    if (arg === '--json') {\n      opts.json = true;\n    } else if (arg === '--root') {\n      const value = argv[i + 1];\n      if (!value || value.startsWith('-')) fail(`--root needs a directory\\n${USAGE}`);\n      opts.root = path.resolve(value);\n      i += 1;\n    } else {\n      fail(`unknown argument: ${arg}\\n${USAGE}`);\n    }\n  }\n  if (!opts.root) fail(`--root is required\\n${USAGE}`);\n  if (!fs.existsSync(opts.root) || !fs.statSync(opts.root).isDirectory()) {\n    fail(`root not found: ${opts.root}`);\n  }\n  return opts;\n}\n\n// Hook files either wrap their events in a `hooks` object or place them at the\n// top level, and the cursor file omits the nested hook array the others carry.\n// A mention is not a wired hook, so only a command that runs the script counts:\n// the event's entries and their nested hooks arrays are walked for command\n// entries, and a runtime is wired when one starts node on the marker path.\nfunction eventPayload(document, event) {\n  if (!document || typeof document !== 'object') return undefined;\n  if (document.hooks && typeof document.hooks === 'object' && event in document.hooks) {\n    return document.hooks[event];\n  }\n  if (event in document) return document[event];\n  return undefined;\n}\n\nfunction stripQuotes(token) {\n  return token.replace(/^['\"]+|['\"]+$/g, '');\n}\n\nfunction collectCommands(node, commands) {\n  if (Array.isArray(node)) {\n--- .claude/settings.json\n{\n  \"$schema\": \"https://json.schemastore.org/claude-code-settings.json\",\n  \"permissions\": {\n    \"allow\": [],\n    \"deny\": [\n      \"Read(.env)\",\n      \"Read(.env.*)\",\n      \"Read(!.env.example)\",\n      \"Edit(.env)\",\n      \"Edit(.env.*)\",\n      \"Edit(!.env.example)\"\n    ],\n    \"defaultMode\": \"bypassPermissions\"\n  },\n  \"skipDangerousModePermissionPrompt\": true,\n  \"skipWorkflowUsageWarning\": true,\n  \"effortLevel\": \"medium\",\n  \"modelSettings\": {\n    \"claude-fable-5-2\": {\n      \"effortLevel\": \"medium\"\n    },\n    \"claude-opus-5-5\": {\n      \"effortLevel\": \"medium\"\n    },\n    \"claude-sonnet-5-5\": {\n      \"effortLevel\": \"medium\"\n    },\n    \"claude-haiku-5-5\": {\n      \"effortLevel\": \"xhigh\"\n    }\n  },\n  \"autoCompactEnabled\": true,\n  \"autoCompactWindow\": 500000,\n  \"skillListingBudgetFraction\": 0.02,\n  \"promptSuggestionEnabled\": false,\n  \"crossSessionInbound\": \"accept\",\n  \"agentPushNotifEnabled\": true,\n  \"theme\": \"dark\",\n  \"tui\": \"fullscreen\",\n  \"enabledPlugins\": {\n    \"cache-tax@claude-code-mods\": true\n  },\n  \"env\": {\n    \"ENABLE_PROMPT_CACHING_1H\": \"true\",\n    \"ENABLE_TOOL_SEARCH\": \"true\",\n    \"MAX_THINKING_TOKENS\": \"999999\",\n    \"SYSTEM_SPEC_GATE_ENFORCE\": \"0\",\n    \"CLAUDE_CODE_ENABLE_FUNCTION_HOOKS\": \"1\"\n  },\n  \"hooks\": {\n    \"PreToolUse\": [\n      {\n        \"matcher\": \"Bash\",\n        \"hooks\": [\n          {\n            \"type\": \"command\",\n            \"command\": \"bash -c 'cd \\\"${CLAUDE_PROJECT_DIR:-$PWD}\\\" && node .skilled/hooks/dispatch/claude/dispatch-preflight-lint.mjs || { printf \\\"%s\\\\n\\\" \\\"mk-hook-drift host=claude event=PreToolUse adapter=dispatch-preflight-lint.mjs\\\" >&2; printf %s \\\"{\\\\\\\"hookSpecificOutput\\\\\\\":{\\\\\\\"hookEventName\\\\\\\":\\\\\\\"PreToolUse\\\\\\\",\\\\\\\"additionalContext\\\\\\\":\\\\\\\"mk claude hook could not resolve; rebuild the spec-kit runtime or restore the missing adapter\\\\\\\",\\\\\\\"mkHookDrift\\\\\\\":true}}\\\"; }'\",\n            \"timeout\": 5\n          },\n          {\n--- .codex/hooks.json\n{\n  \"hooks\": {\n    \"SessionStart\": [\n      {\n        \"hooks\": [\n          {\n            \"type\": \"command\",\n            \"command\": \"bash -c 'cd \\\"${CODEX_PROJECT_DIR:-$PWD}\\\" && node .skilled/skills/system-spec-kit/runtime/dist/hooks/codex/session-start.js || { printf \\\"%s\\\\n\\\" \\\"mk-hook-drift host=codex event=SessionStart adapter=session-start.js\\\" >&2; printf %s \\\"{\\\\\\\"hookSpecificOutput\\\\\\\":{\\\\\\\"hookEventName\\\\\\\":\\\\\\\"SessionStart\\\\\\\",\\\\\\\"additionalContext\\\\\\\":\\\\\\\"mk codex hook could not resolve; build the spec-kit runtime (npm --prefix .skilled/skills/system-spec-kit run build) or restore the missing adapter\\\\\\\"}}\\\"; }'\",\n            \"timeout\": 3\n          },\n          {\n            \"type\": \"command\",\n            \"command\": \"bash -c 'cd \\\"${CODEX_PROJECT_DIR:-$PWD}\\\" && bash .skilled/bin/worktree-guard.sh || { printf \\\"%s\\\\n\\\" \\\"mk-hook-drift host=codex event=SessionStart adapter=worktree-guard.sh\\\" >&2; printf %s \\\"{\\\\\\\"hookSpecificOutput\\\\\\\":{\\\\\\\"hookEventName\\\\\\\":\\\\\\\"SessionStart\\\\\\\",\\\\\\\"additionalContext\\\\\\\":\\\\\\\"mk codex hook could not resolve; build the spec-kit runtime (npm --prefix .skilled/skills/system-spec-kit run build) or restore the missing adapter\\\\\\\"}}\\\"; }'\",\n            \"timeout\": 3\n          },\n          {\n            \"type\": \"command\",\n            \"command\": \"bash -c 'cd \\\"${CODEX_PROJECT_DIR:-$PWD}\\\" && bash .skilled/bin/check-git-hooks.sh || { printf \\\"%s\\\\n\\\" \\\"mk-hook-drift host=codex event=SessionStart adapter=check-git-hooks.sh\\\" >&2; printf %s \\\"{\\\\\\\"hookSpecificOutput\\\\\\\":{\\\\\\\"hookEventName\\\\\\\":\\\\\\\"SessionStart\\\\\\\",\\\\\\\"additionalContext\\\\\\\":\\\\\\\"mk codex hook could not resolve; build the spec-kit runtime (npm --prefix .skilled/skills/system-spec-kit run build) or restore the missing adapter\\\\\\\"}}\\\"; }'\",\n            \"timeout\": 3\n          },\n          {\n            \"type\": \"command\",\n            \"command\": \"bash -c 'cd \\\"${CODEX_PROJECT_DIR:-$PWD}\\\" && bash .skilled/bin/git-primary-reconcile.sh >/dev/null 2>&1 &'\",\n            \"timeout\": 3\n          },\n          {\n         