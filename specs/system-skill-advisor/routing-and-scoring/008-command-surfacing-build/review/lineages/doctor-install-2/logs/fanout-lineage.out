{"type":"tool_use","timestamp":1794570358702,"sessionID":"ses_e2b4a18a6ffeJYEGLs0dTSiOZ0","part":{"partID":"prt_1d4ba8d97001KDqc1sgS0W5R0Y","sessionID":"ses_e2b4a18a6ffeJYEGLs0dTSiOZ0","messageID":"msg_1d4ba5c7b0019w156leoFEVmrh","type":"tool","id":"call_d67ed5a6dfce40f6a6bcc68c","tool":"shell","state":{"status":"completed","input":{"command":"grep -n \"parseTableRows\\|pointer missing\\|parseTableRows(\" .skilled/commands/doctor/scripts/agents-md-check.cjs; sed -n '760,830p' .skilled/commands/doctor/scripts/agents-md-check.cjs"},"output":"642:    if (verdict.state === FINDING || verdict.state === UNKNOWN || verdict.kind === 'pointer missing') {\n650:  const pointerMissing = entries.filter((entry) => entry.kind === 'pointer missing');\n653:  const detail = `${expected}/${entries.length} copies as expected${unmeasured.length > 0 ? `, ${unmeasured.length} unmeasured` : ''}${pointerMissing.length > 0 ? `, ${pointerMissing.length} pointer missing` : ''}`;\n702:      kind: 'pointer missing',\n766:    { kind: 'trigger', rows: parseTableRows(text, 'TRIGGER TABLE'), shipped: shipped.trigger_rows },\n767:    { kind: 'index', rows: parseTableRows(text, 'INDEX'), shipped: shipped.index_rows },\n807:function parseTableRows(text, anchor) {\n      { lines: [`no ${manifest.router_file}: no repository rule can load`], entries: [{ path: manifest.router_file, present: false }] });\n  }\n\n  const text = fs.readFileSync(routerPath, 'utf8');\n  const shipped = (manifest.derived && manifest.derived.repo_rules) || { trigger_rows: [], index_rows: [] };\n  const tables = [\n    { kind: 'trigger', rows: parseTableRows(text, 'TRIGGER TABLE'), shipped: shipped.trigger_rows },\n    { kind: 'index', rows: parseTableRows(text, 'INDEX'), shipped: shipped.index_rows },\n  ];\n  const lines = [];\n  const missing = tables.flatMap((table) => missingRows(table.shipped, table.rows, table.kind));\n  for (const entry of missing) lines.push(`missing ${entry.kind} row for ${entry.rule}`);\n  for (const table of tables) {\n    for (const entry of table.rows) {\n      if (!entry.malformed) continue;\n      lines.push(`malformed ${table.kind} row at line ${entry.line}: ${entry.cells.length} cells where the header has ${entry.width}`);\n    }\n  }\n\n  if (typeof tools.repoRules !== 'string' || !fs.existsSync(tools.repoRules)) {\n    return row('A11', 'REPO RULES.md', UNKNOWN, 'present; the repo-rules checker is not installed',\n      { lines: [...lines, `the checker is not installed at ${tools.repoRules || '(no path)'}`] });\n  }\n\n  const run = spawnSync(process.execPath, [tools.repoRules, '--root', context.root], {\n    encoding: 'utf8',\n    timeout: TOOL_TIMEOUT_MS,\n  });\n  const output = `${run.stdout || ''}\\n${run.stderr || ''}`.split('\\n').map((line) => line.trim()).filter((line) => line !== '');\n  const summary = output.find((line) => line.includes(REPO_RULES_TAG) && line.includes('RESULT:'));\n\n  if (run.status === 2 || !summary) {\n    return row('A11', 'REPO RULES.md', UNKNOWN, 'the repo-rules checker could not run',\n      { lines: [...lines, ...output.filter((line) => line.includes(REPO_RULES_TAG))] });\n  }\n  if (run.status !== 0) {\n    return row('A11', 'REPO RULES.md', FINDING, `${missing.length} shipped row(s) missing; the checker fails`,\n      { lines: [...lines, summary] });\n  }\n  return row('A11', 'REPO RULES.md', lines.length === 0 ? PASS : FINDING,\n    `${missing.length} shipped row(s) missing; ${summary}`, { lines: [...lines, summary] });\n}\n\n// The router's own table, read the same way the manifest's rows were derived. Comparing\n// shipped rows to the file is the only way to say which of them a consumer dropped, and a\n// row of another width is kept so the report can name the defect instead of the rule it\n// would otherwise read as missing.\nfunction parseTableRows(text, anchor) {\n  const lines = text.split('\\n');\n  const start = lines.findIndex((line) => line.startsWith('#') && line.includes(anchor));\n  if (start === -1) return [];\n\n  const rows = [];\n  let width = 0;\n  for (let index = start + 1; index < lines.length; index += 1) {\n    const line = lines[index].trim();\n    if (line.startsWith('#')) break;\n    if (!line.startsWith('|')) {\n      if (rows.length > 0 && line === '') break;\n      continue;\n    }\n    const cells = line.replace(/^\\|/u, '').replace(/\\|$/u, '').split('|').map((cell) => cell.trim());\n    if (cells.every((cell) => /^:?-+:?$/u.test(cell) || cell === '')) continue;\n    if (width === 0) {\n      width = cells.length;\n      continue;\n    }\n    rows.push({ cells, line: index + 1, width, malformed: cells.length !== width });\n  }\n  return rows;\n}\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"642:    if (verdict.state === FINDING || verdict.state === UNKNOWN || verdict.kind === 'pointer missing') {\n650:  const pointerMissing = entries.filter((entry) => entry.kind === 'pointer missing');\n653:  const detail = `${expected}/${entries.length} copies as expected${unmeasured.length > 0 ? `, ${unmeasured.length} unmeasured` : ''}${pointerMissing.length > 0 ? `, ${pointerMissing.length} pointer missing` : ''}`;\n702:      kind: 'pointer missing',\n766:    { kind: 'trigger', rows: parseTableRows(text, 'TRIGGER TABLE'), shipped: shipped.trigger_rows },\n767:    { kind: 'index', rows: parseTableRows(text, 'INDEX'), shipped: shipped.index_rows },\n807:function parseTableRows(text, anchor) {\n      { lines: [`no ${manifest.router_file}: no repository rule can load`], entries: [{ path: manifest.router_file, present: false }] });\n  }\n\n  const text = fs.readFileSync(routerPath, 'utf8');\n  const shipped = (manifest.derived && manifest.derived.repo_rules) || { trigger_rows: [], index_rows: [] };\n  const tables = [\n    { kind: 'trigger', rows: parseTableRows(text, 'TRIGGER TABLE'), shipped: shipped.trigger_rows },\n    { kind: 'index', rows: parseTableRows(text, 'INDEX'), shipped: shipped.index_rows },\n  ];\n  const lines = [];\n  const missing = tables.flatMap((table) => missingRows(table.shipped, table.rows, table.kind));\n  for (const entry of missing) lines.push(`missing ${entry.kind} row for ${entry.rule}`);\n  for (const table of tables) {\n    for (const entry of table.rows) {\n      if (!entry.malformed) continue;\n      lines.push(`malformed ${table.kind} row at line ${entry.line}: ${entry.cells.length} cells where the header has ${entry.width}`);\n    }\n  }\n\n  if (typeof tools.repoRules !== 'string' || !fs.existsSync(tools.repoRules)) {\n    return row('A11', 'REPO RULES.md', UNKNOWN, 'present; the repo-rules checker is not installed',\n      { lines: [...lines, `the checker is not installed at ${tools.repoRules || '(no path)'}`] });\n  }\n\n  const run = spawnSync(process.execPath, [tools.repoRules, '--root', context.root], {\n    encoding: 'utf8',\n    timeout: TOOL_TIMEOUT_MS,\n  });\n  const output = `${run.stdout || ''}\\n${run.stderr || ''}`.split('\\n').map((line) => line.trim()).filter((line) => line !== '');\n  const summary = output.find((line) => line.includes(REPO_RULES_TAG) && line.includes('RESULT:'));\n\n  if (run.status === 2 || !summary) {\n    return row('A11', 'REPO RULES.md', UNKNOWN, 'the repo-rules checker could not run',\n      { lines: [...lines, ...output.filter((line) => line.includes(REPO_RULES_TAG))] });\n  }\n  if (run.status !== 0) {\n    return row('A11', 'REPO RULES.md', FINDING, `${missing.length} shipped row(s) missing; the checker fails`,\n      { lines: [...lines, summary] });\n  }\n  return row('A11', 'REPO RULES.md', lines.length === 0 ? PASS : FINDING,\n    `${missing.length} shipped row(s) missing; ${summary}`, { lines: [...lines, summary] });\n}\n\n// The router's own table, read the same way the manifest's rows were derived. Comparing\n// shipped rows to the file is the only way to say which of them a consumer dropped, and a\n// row of another width is kept so the report can name the defect instead of the rule it\n// would otherwise read as missing.\nfunction parseTableRows(text, anchor) {\n  const lines = text.split('\\n');\n  const start = lines.findIndex((line) => line.startsWith('#') && line.includes(anchor));\n  if (start === -1) return [];\n\n  const rows = [];\n  let width = 0;\n  for (let index = start + 1; index < lines.length; index += 1) {\n    const line = lines[index].trim();\n    if (line.startsWith('#')) break;\n    if (!line.startsWith('|')) {\n      if (rows.length > 0 && line === '') break;\n      continue;\n    }\n    const cells = line.replace(/^\\|/u, '').replace(/\\|$/u, '').split('|').map((cell) => cell.trim());\n    if (cells.every((cell) => /^:?-+:?$/u.test(cell) || cell === '')) continue;\n    if (width === 0) {\n      width = cells.length;\n      continue;\n    }\n    rows.push({ cells, line: index + 1, width, malformed: cells.length !== width });\n  }\n  return rows;\n}\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"grep -n \\\"parseTableRows\\\\|pointer missing\\\\|parseTableRows(\\\" .skilled/commands/doctor/scripts/agents-md-check.cjs; sed -n '760,830p' .skilled/commands/doctor/scripts/agents-md-check.cjs\"}"},"time":{"start":1794570358167,"end":1794570358702}}}}
{"type":"tool_use","timestamp":1794570358739,"sessionID":"ses_e2b4a18a6ffeJYEGLs0dTSiOZ0","part":{"partID":"prt_1d4ba8b8a001K444tbhQpr0Fdg","sessionID":"ses_e2b4a18a6ffeJYEGLs0dTSiOZ0","messageID":"msg_1d4ba5c7b0019w156leoFEVmrh","type":"tool","id":"call_b12714cddbbf4094ae0e0f04","tool":"shell","state":{"status":"completed","input":{"command":"sed -n '1,120p' .skilled/commands/doctor/scripts/hook-wiring-check.cjs; for f in .claude/settings.json .codex/hooks.json .cursor/hooks.json .devin/hooks.v1.json; do echo \"--- $f\"; [ -f \"$f\" ] && head -60 \"$f\"; done"},"output":"#!/usr/bin/env node\n// ───────────────────────────────────────────────────────────────────\n// MODULE: Hook Wiring Check\n// ───────────────────────────────────────────────────────────────────\n'use strict';\n\n// Read-only /doctor diagnostic for the prompt hook entry each runtime loads.\n//\n// WHY THIS EXISTS: the skill advisor reaches a first prompt only through the hook\n// entry a runtime fires before the model sees that prompt. A runtime folder can be\n// installed while its hook file is missing, its JSON is unreadable, or the entry\n// was never added, and then the advisor is silent with no error at session start.\n// This check names the runtime and the file to repair.\n//\n// Never writes. Exit 0 when every installed runtime carries its entry, 1 when one\n// is missing, 2 on a bad argument or a missing root.\n\n// ─────────────────────────────────────────────────────────────────────────────\n// 1. IMPORTS\n// ─────────────────────────────────────────────────────────────────────────────\n\nconst fs = require('node:fs');\nconst path = require('node:path');\n\n// ─────────────────────────────────────────────────────────────────────────────\n// 2. CONSTANTS\n// ─────────────────────────────────────────────────────────────────────────────\n\nconst USAGE = [\n  'Usage: hook-wiring-check.cjs --root <dir> [--json]',\n  '  --root  check the checkout under <dir>.',\n  '  --json  print one JSON object instead of one line per runtime.',\n].join('\\n');\n\n// Each entry names the runtime folder that decides whether the check applies,\n// the hook file inside it, the event that carries the prompt entry, and the path\n// fragment whose presence proves the entry is wired. A runtime folder that is\n// absent is skipped, because that runtime was never installed in this checkout.\nconst RUNTIMES = [\n  {\n    id: 'claude',\n    dir: '.claude',\n    file: '.claude/settings.json',\n    event: 'UserPromptSubmit',\n    marker: 'hooks/claude/user-prompt-submit.js',\n  },\n  {\n    id: 'codex',\n    dir: '.codex',\n    file: '.codex/hooks.json',\n    event: 'UserPromptSubmit',\n    marker: 'hooks/codex/user-prompt-submit.js',\n  },\n  {\n    id: 'cursor',\n    dir: '.cursor',\n    file: '.cursor/hooks.json',\n    event: 'beforeSubmitPrompt',\n    marker: 'hooks/cursor/user-prompt-submit.js',\n  },\n  {\n    id: 'devin',\n    dir: '.devin',\n    file: '.devin/hooks.v1.json',\n    event: 'UserPromptSubmit',\n    marker: 'hooks/devin/user-prompt-submit.js',\n  },\n];\n\n// ─────────────────────────────────────────────────────────────────────────────\n// 3. HELPERS\n// ─────────────────────────────────────────────────────────────────────────────\n\nfunction fail(message) {\n  process.stderr.write(`hook-wiring-check: ${message}\\n`);\n  process.exit(2);\n}\n\nfunction parseArgs(argv) {\n  const opts = { root: null, json: false };\n  for (let i = 0; i < argv.length; i += 1) {\n    const arg = argv[i];\n    if (arg === '--json') {\n      opts.json = true;\n    } else if (arg === '--root') {\n      const value = argv[i + 1];\n      if (!value || value.startsWith('-')) fail(`--root needs a directory\\n${USAGE}`);\n      opts.root = path.resolve(value);\n      i += 1;\n    } else {\n      fail(`unknown argument: ${arg}\\n${USAGE}`);\n    }\n  }\n  if (!opts.root) fail(`--root is required\\n${USAGE}`);\n  if (!fs.existsSync(opts.root) || !fs.statSync(opts.root).isDirectory()) {\n    fail(`root not found: ${opts.root}`);\n  }\n  return opts;\n}\n\n// Hook files either wrap their events in a `hooks` object or place them at the\n// top level, and the cursor file omits the nested hook array the others carry.\n// A mention is not a wired hook, so only a command that runs the script counts:\n// the event's entries and their nested hooks arrays are walked for command\n// entries, and a runtime is wired when one starts node on the marker path.\nfunction eventPayload(document, event) {\n  if (!document || typeof document !== 'object') return undefined;\n  if (document.hooks && typeof document.hooks === 'object' && event in document.hooks) {\n    return document.hooks[event];\n  }\n  if (event in document) return document[event];\n  return undefined;\n}\n\nfunction stripQuotes(token) {\n  return token.replace(/^['\"]+|['\"]+$/g, '');\n}\n\nfunction collectCommands(node, commands) {\n  if (Array.isArray(node)) {\n--- .claude/settings.json\n{\n  \"$schema\": \"https://json.schemastore.org/claude-code-settings.json\",\n  \"permissions\": {\n    \"allow\": [],\n    \"deny\": [\n      \"Read(.env)\",\n      \"Read(.env.*)\",\n      \"Read(!.env.example)\",\n      \"Edit(.env)\",\n      \"Edit(.env.*)\",\n      \"Edit(!.env.example)\"\n    ],\n    \"defaultMode\": \"bypassPermissions\"\n  },\n  \"skipDangerousModePermissionPrompt\": true,\n  \"skipWorkflowUsageWarning\": true,\n  \"effortLevel\": \"medium\",\n  \"modelSettings\": {\n    \"claude-fable-5-2\": {\n      \"effortLevel\": \"medium\"\n    },\n    \"claude-opus-5-5\": {\n      \"effortLevel\": \"medium\"\n    },\n    \"claude-sonnet-5-5\": {\n      \"effortLevel\": \"medium\"\n    },\n    \"claude-haiku-5-5\": {\n      \"effortLevel\": \"xhigh\"\n    }\n  },\n  \"autoCompactEnabled\": true,\n  \"autoCompactWindow\": 500000,\n  \"skillListingBudgetFraction\": 0.02,\n  \"promptSuggestionEnabled\": false,\n  \"crossSessionInbound\": \"accept\",\n  \"agentPushNotifEnabled\": true,\n  \"theme\": \"dark\",\n  \"tui\": \"fullscreen\",\n  \"enabledPlugins\": {\n    \"cache-tax@claude-code-mods\": true\n  },\n  \"env\": {\n    \"ENABLE_PROMPT_CACHING_1H\": \"true\",\n    \"ENABLE_TOOL_SEARCH\": \"true\",\n    \"MAX_THINKING_TOKENS\": \"999999\",\n    \"SYSTEM_SPEC_GATE_ENFORCE\": \"0\",\n    \"CLAUDE_CODE_ENABLE_FUNCTION_HOOKS\": \"1\"\n  },\n  \"hooks\": {\n    \"PreToolUse\": [\n      {\n        \"matcher\": \"Bash\",\n        \"hooks\": [\n          {\n            \"type\": \"command\",\n            \"command\": \"bash -c 'cd \\\"${CLAUDE_PROJECT_DIR:-$PWD}\\\" && node .skilled/hooks/dispatch/claude/dispatch-preflight-lint.mjs || { printf \\\"%s\\\\n\\\" \\\"mk-hook-drift host=claude event=PreToolUse adapter=dispatch-preflight-lint.mjs\\\" >&2; printf %s \\\"{\\\\\\\"hookSpecificOutput\\\\\\\":{\\\\\\\"hookEventName\\\\\\\":\\\\\\\"PreToolUse\\\\\\\",\\\\\\\"additionalContext\\\\\\\":\\\\\\\"mk claude hook could not resolve; rebuild the spec-kit runtime or restore the missing adapter\\\\\\\",\\\\\\\"mkHookDrift\\\\\\\":true}}\\\"; }'\",\n            \"timeout\": 5\n          },\n          {\n--- .codex/hooks.json\n{\n  \"hooks\": {\n    \"SessionStart\": [\n      {\n        \"hooks\": [\n          {\n            \"type\": \"command\",\n            \"command\": \"bash -c 'cd \\\"${CODEX_PROJECT_DIR:-$PWD}\\\" && node .skilled/skills/system-spec-kit/runtime/dist/hooks/codex/session-start.js || { printf \\\"%s\\\\n\\\" \\\"mk-hook-drift host=codex event=SessionStart adapter=session-start.js\\\" >&2; printf %s \\\"{\\\\\\\"hookSpecificOutput\\\\\\\":{\\\\\\\"hookEventName\\\\\\\":\\\\\\\"SessionStart\\\\\\\",\\\\\\\"additionalContext\\\\\\\":\\\\\\\"mk codex hook could not resolve; build the spec-kit runtime (npm --prefix .skilled/skills/system-spec-kit run build) or restore the missing adapter\\\\\\\"}}\\\"; }'\",\n            \"timeout\": 3\n          },\n          {\n            \"type\": \"command\",\n            \"command\": \"bash -c 'cd \\\"${CODEX_PROJECT_DIR:-$PWD}\\\" && bash .skilled/bin/worktree-guard.sh || { printf \\\"%s\\\\n\\\" \\\"mk-hook-drift host=codex event=SessionStart adapter=worktree-guard.sh\\\" >&2; printf %s \\\"{\\\\\\\"hookSpecificOutput\\\\\\\":{\\\\\\\"hookEventName\\\\\\\":\\\\\\\"SessionStart\\\\\\\",\\\\\\\"additionalContext\\\\\\\":\\\\\\\"mk codex hook could not resolve; build the spec-kit runtime (npm --prefix .skilled/skills/system-spec-kit run build) or restore the missing adapter\\\\\\\"}}\\\"; }'\",\n            \"timeout\": 3\n          },\n          {\n            \"type\": \"command\",\n            \"command\": \"bash -c 'cd \\\"${CODEX_PROJECT_DIR:-$PWD}\\\" && bash .skilled/bin/check-git-hooks.sh || { printf \\\"%s\\\\n\\\" \\\"mk-hook-drift host=codex event=SessionStart adapter=check-git-hooks.sh\\\" >&2; printf %s \\\"{\\\\\\\"hookSpecificOutput\\\\\\\":{\\\\\\\"hookEventName\\\\\\\":\\\\\\\"SessionStart\\\\\\\",\\\\\\\"additionalContext\\\\\\\":\\\\\\\"mk codex hook could not resolve; build the spec-kit runtime (npm --prefix .skilled/skills/system-spec-kit run build) or restore the missing adapter\\\\\\\"}}\\\"; }'\",\n            \"timeout\": 3\n          },\n          {\n            \"type\": \"command\",\n            \"command\": \"bash -c 'cd \\\"${CODEX_PROJECT_DIR:-$PWD}\\\" && bash .skilled/bin/git-primary-reconcile.sh >/dev/null 2>&1 &'\",\n            \"timeout\": 3\n          },\n          {\n            \"type\": \"command\",\n            \"command\": \"bash -c 'cd \\\"${CODEX_PROJECT_DIR:-$PWD}\\\" && bash .skilled/bin/git-live-follow.sh --start || { printf \\\"%s\\\\n\\\" \\\"mk-hook-drift host=codex event=SessionStart adapter=git-live-follow.sh\\\" >&2; printf %s \\\"{\\\\\\\"hookSpecificOutput\\\\\\\":{\\\\\\\"hookEventName\\\\\\\":\\\\\\\"SessionStart\\\\\\\",\\\\\\\"additionalContext\\\\\\\":\\\\\\\"mk codex hook could not resolve; build the spec-kit runtime (npm --prefix .skilled/skills/system-spec-kit run build) or restore the missing adapter\\\\\\\"}}\\\"; }'\",\n            \"timeout\": 3\n          }\n        ]\n      },\n      {\n        \"hooks\": [\n          {\n            \"type\": \"command\",\n            \"command\": \"bash -c 'cd \\\"${CODEX_PROJECT_DIR:-$PWD}\\\" && python3 .skilled/skills/sk-code/sk-code-quality/scripts/check-dist-staleness.sh --all || { printf \\\"%s\\\\n\\\" \\\"mk-hook-drift host=codex event=SessionStart adapter=check-dist-staleness.sh\\\" >&2; printf %s \\\"{\\\\\\\"hookSpecificOutput\\\\\\\":{\\\\\\\"hookEventName\\\\\\\":\\\\\\\"SessionStart\\\\\\\",\\\\\\\"additionalContext\\\\\\\":\\\\\\\"mk codex hook could not resolve; build the spec-kit runtime (npm --prefix .skilled/skills/system-spec-kit run build) or restore the missing adapter\\\\\\\"}}\\\"; }'\",\n            \"timeout\": 5\n          }\n        ]\n      }\n    ],\n    \"UserPromptSubmit\": [\n      {\n        \"hooks\": [\n          {\n            \"type\": \"command\",\n            \"command\": \"bash -c 'cd \\\"${CODEX_PROJECT_DIR:-$PWD}\\\" && node .skilled/skills/system-spec-kit/runtime/dist/hooks/codex/user-prompt-submit.js || { printf \\\"%s\\\\n\\\" \\\"mk-hook-drift host=codex event=UserPromptSubmit adapter=user-prompt-submit.js\\\" >&2; printf %s \\\"{\\\\\\\"hookSpecificOutput\\\\\\\":{\\\\\\\"hookEventName\\\\\\\":\\\\\\\"UserPromptSubmit\\\\\\\",\\\\\\\"additionalContext\\\\\\\":\\\\\\\"mk codex hook could not resolve; build the spec-kit runtime (npm --prefix .skilled/skills/system-spec-kit run build) or restore the missing adapter\\\\\\\"}}\\\"; }'\",\n            \"timeout\": 3\n          }\n        ]\n      },\n      {\n        \"hooks\": [\n          {\n            \"type\": \"command\",\n            \"command\": \"bash -c 'cd \\\"${CODEX_PROJECT_DIR:-$PWD}\\\" && node .skilled/skills/system-spec-kit/runtime/hooks/codex/spec-gate-classify.mjs || { printf \\\"%s\\\\n\\\" \\\"mk-hook-drift host=codex event=UserPromptSubmit adapter=spec-gate-classify.mjs\\\" >&2; printf %s \\\"{\\\\\\\"hookSpecificOutput\\\\\\\":{\\\\\\\"hookEventName\\\\\\\":\\\\\\\"UserPromptSubmit\\\\\\\",\\\\\\\"additionalContext\\\\\\\":\\\\\\\"mk codex hook could not resolve; build the spec-kit runtime (npm --prefix .skilled/skills/system-spec-kit run build) or restore the missing adapter\\\\\\\"}}\\\"; }'\",\n            \"timeout\": 3\n          }\n        ]\n--- .cursor/hooks.json\n{\n  \"version\": 1,\n  \"hooks\": {\n    \"sessionStart\": [\n      {\n        \"command\": \"node .skilled/skills/system-spec-kit/runtime/dist/hooks/cursor/session-start.js || { printf \\\"%s\\\\n\\\" \\\"mk-hook-drift host=cursor event=sessionStart adapter=session-start.js\\\" >&2; printf %s '{\\\"permission\\\":\\\"allow\\\",\\\"agent_message\\\":\\\"mk cursor hook could not resolve; rebuild the spec-kit runtime or restore the missing adapter\\\",\\\"mkHookDrift\\\":true}'; }\",\n        \"type\": \"command\",\n        \"timeout\": 10\n      },\n      {\n        \"command\": \"node .skilled/skills/system-spec-kit/runtime/hooks/cursor/spec-gate-prebind.mjs || { printf \\\"%s\\\\n\\\" \\\"mk-hook-drift host=cursor event=sessionStart adapter=spec-gate-prebind.mjs\\\" >&2; printf %s '{\\\"permission\\\":\\\"allow\\\",\\\"agent_message\\\":\\\"mk cursor hook could not resolve; rebuild the spec-kit runtime or restore the missing adapter\\\",\\\"mkHookDrift\\\":true}'; }\",\n        \"type\": \"command\",\n        \"timeout\": 10\n      },\n      {\n        \"command\": \"bash .skilled/bin/worktree-guard.sh || { printf \\\"%s\\\\n\\\" \\\"mk-hook-drift host=cursor event=sessionStart adapter=worktree-guard.sh\\\" >&2; printf %s '{\\\"permission\\\":\\\"allow\\\",\\\"agent_message\\\":\\\"mk cursor hook could not resolve; rebuild the spec-kit runtime or restore the missing adapter\\\",\\\"mkHookDrift\\\":true}'; }\",\n        \"type\": \"command\",\n        \"timeout\": 10\n      },\n      {\n        \"command\": \"bash .skilled/bin/check-git-hooks.sh || { printf \\\"%s\\\\n\\\" \\\"mk-hook-drift host=cursor event=sessionStart adapter=check-git-hooks.sh\\\" >&2; printf %s '{\\\"permission\\\":\\\"allow\\\",\\\"agent_message\\\":\\\"mk cursor hook could not resolve; rebuild the spec-kit runtime or restore the missing adapter\\\",\\\"mkHookDrift\\\":true}'; }\",\n        \"type\": \"command\",\n        \"timeout\": 10\n      },\n      {\n        \"command\": \"python3 .skilled/skills/sk-code/sk-code-quality/scripts/check-dist-staleness.sh --all || { printf \\\"%s\\\\n\\\" \\\"mk-hook-drift host=cursor event=sessionStart adapter=check-dist-staleness.sh\\\" >&2; printf %s '{\\\"permission\\\":\\\"allow\\\",\\\"agent_message\\\":\\\"mk cursor hook could not resolve; rebuild the spec-kit runtime or restore the missing adapter\\\",\\\"mkHookDrift\\\":true}'; }\",\n        \"type\": \"command\",\n        \"timeout\": 10\n      },\n      {\n        \"command\": \"node .skilled/bin/install-codex-hooks.mjs --check || { printf \\\"%s\\\\n\\\" \\\"mk-hook-drift host=cursor event=sessionStart adapter=install-codex-hooks.mjs\\\" >&2; printf %s '{\\\"permission\\\":\\\"allow\\\",\\\"agent_message\\\":\\\"[codex-hooks] drift detected - run: node .skilled/bin/install-codex-hooks.mjs --check\\\",\\\"mkHookDrift\\\":true}'; }\",\n        \"type\": \"command\",\n        \"timeout\": 10\n      },\n      {\n        \"command\": \"node .skilled/hooks/goal/cursor/goal-inject.mjs || { printf \\\"%s\\\\n\\\" \\\"mk-hook-drift host=cursor event=sessionStart adapter=goal-inject.mjs\\\" >&2; printf %s '{\\\"permission\\\":\\\"allow\\\",\\\"agent_message\\\":\\\"mk cursor hook could not resolve; rebuild the spec-kit runtime or restore the missing adapter\\\",\\\"mkHookDrift\\\":true}'; }\",\n        \"type\": \"command\",\n        \"timeout\": 10\n      },\n      {\n        \"command\": \"bash .skilled/bin/git-primary-reconcile.sh >/dev/null 2>&1 &\",\n        \"type\": \"command\",\n        \"timeout\": 10\n      },\n      {\n        \"command\": \"bash .skilled/bin/git-live-follow.sh --start || { printf \\\"%s\\\\n\\\"