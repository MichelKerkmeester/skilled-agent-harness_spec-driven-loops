s-registry.json');\n2273:   const dashboardPath = path.join(reviewDir, 'deep-review-dashboard.md');\n2274:   const resourceMapPath = path.join(reviewDir, 'resource-map.md');\n2275:   const iterationDir = path.join(reviewDir, 'iterations');\n2276:   const deltaDir = path.join(reviewDir, 'deltas');\n2277: \n2278:   // Older and per-lineage review folders keep a state log without a config file. Treat\n2279:   // the missing file like a corrupt line: reduce on defaults, and let the strict path\n2280:   // below fail loudly with the file named rather than a bare ENOENT.\n2281:   const configWarnings = [];\n2282:   let config = {};\n2283:   if (fs.existsSync(configPath)) {\n2284:     config = readJson(configPath);\n2285:   } else {\n2286:     configWarnings.push({ file: 'deep-review-config.json', error: 'config file is missing; reduced on default settings' });\n2287:   }\n2288:   const { records: allRecords, corruptionWarnings: logWarnings } = parseJsonlDetailed(readUtf8(stateLogPath));\n2289:   const corruptionWarnings = configWarnings.concat(logWarnings);\n2290:   // Allowlist: only iteration + event types bear completion semantics. Progress\n2291:   // records (type:'progress') are additive liveness signals — they reset the\n2292:   // no-progress watchdog but MUST NOT count as iterations or completion events.\n2293:   const records = filterCompletionBearingRecords(allRecords);\n2294:   const terminalStop = buildTerminalStopState(records);\n2295:   const lineage = buildLineageState(config, records, terminalStop);\n2296:   config.sessionId = lineage.sessionId || config.sessionId || '';\n2297:   config.parentSessionId = lineage.parentSessionId;\n2298:   config.lineageMode = lineage.lineageMode;\n2299:   config.generation = lineage.generation;\n2300:   config.continuedFromRun = lineage.continuedFromRun;\n2301:   if (terminalStop?.stopReason) {\n2302:     config.stopReason = terminalStop.stopReason;\n2303:   }\n2304:   const strategyContent = fs.existsSync(strategyPath) ? readUtf8(strategyPath) : '';\n2305:   const strategyDimensions = parseStrategyDimensions(strategyContent);\n2306:   const iterationFiles = fs.existsSync(iterationDir)\n2307:     ? fs.readdirSync(iterationDir)\n2308:         .filter((fileName) => /^iteration-\\d+\\.md$/.test(fileName))\n2309:         .sort()\n2310:         .map((fileName) => parseIterationFile(path.join(iterationDir, fileName)))\n2311:     : [];\n2312: \n2313:   // Load delta payloads up-front so the finding registry can use structured\n2314:   // rows first while the resource-map emit path reuses the same parsed data.\n2315:   const deltaLoad = fs.existsSync(deltaDir)\n2316:     ? loadDeltaPayloads(deltaDir)\n2317:     : { payloads: [], corruptionWarnings: [] };\n2318:   const deltaPayloads = deltaLoad.payloads;\n2319:   const allCorruptionWarnings = corruptionWarnings.concat(deltaLoad.corruptionWarnings);\n2320:   const flattenedDeltaRecords = deltaPayloads\n2321:     .flat()\n2322:     .filter((record) => record !== null && record !== undefined);\n2323: \n2324:   const pivotEvents = loadPivotEventRecords(reviewDir);\n2325:   const registry = buildRegistry(\n2326:     strategyDimensions,\n2327:     iterationFiles,\n2328:     records,\n2329:     config,\n2330:     allCorruptionWarnings,\n2331:     flattenedDeltaRecords,\n2332:     records.concat(pivotEvents),\n2333:   );\n2334:   let strategy = strategyContent;\n2335:   let strategyWarning = null;\n2336:   try {\n2337:     strategy = updateStrategyContent(strategyContent, registry, iterationFiles, { createMissingAnchors }, records);\n2338:   } catch (error) {\n2339:     if (error && error.code === 'MISSING_ANCHOR') {\n2340:       // A missing machine-owned anchor is a warning-class input problem, not\n2341:       // a reason to withhold the registry/dashboard the reducer already\n2342:       // computed successfully. Leave the strategy file as-is and surface the\n2343:       // gap instead of aborting before anything is written.\n2344:       strategyWarning = error.message;\n2345:     } else {\n2346:       throw error;\n2347:     }\n2348:   }\n2349:   const dashboard = renderDashboard(config, registry, records, iterationFiles);\n2350:   let resourceMap = null;\n2351:   let resourceMapSkipped = true;\n2352:   let resourceMapSkipReason = null;\n2353: \n2354:   if (emitResourceMapOutput) {\n2355:     if (getResourceMapEmitSetting(config) === false) {\n2356:       resourceMapSkipReason = 'config.resource_map.emit=false';\n2357:     } else {\n2358:       // Reuse the deltaPayloads already loaded above to avoid re-reading.\n2359:       if (!deltaPayloads.length) {\n2360:         resourceMapSkipReason = 'no delta files found';\n2361:       } else {\n2362:         resourceMap = emitResourceMap({\n2363:           shape: 'review',\n2364:           deltas: deltaPayloads,\n2365:           packet: {\n2366:             title: config.reviewTarget || path.basename(resolvedSpecFolder),\n2367:             specFolder: resolvedSpecFolder,\n2368:           },\n2369:           scope: `review convergence output for ${path.basename(resolvedSpecFolder)}`,\n2370:           createdAt: new Date().toISOString(),\n2371:         });\n2372:         resourceMapSkipped = false;\n2373:       }\n2374:     }\n2375:   }\n2376: \n2377:   if (write) {\n2378:     writeUtf8(registryPath, `${JSON.stringify(registry, null, 2)}\\n`);\n2379:     if (strategyContent) {\n2380:       writeUtf8(strategyPath, strategy.endsWith('\\n') ? strategy : `${strategy}\\n`);\n2381:     }\n2382:     writeUtf8(dashboardPath, dashboard);\n2383:     if (emitResourceMapOutput && resourceMap) {\n2384:       writeUtf8(resourceMapPath, resourceMap);\n2385:     }\n2386:   }\n2387: \n2388:   // Corruption is still reported loudly (thrown here, non-zero CLI exit) but\n2389:   // only after the registry/dashboard/strategy the reducer successfully\n2390:   // derived from the valid records have been written -- corrupted input must\n2391:   // not withhold output that was already computed.\n2392:   if (allCorruptionWarnings.length > 0 && !lenient) {\n2393:     throw createCorruptionError(path.join(reviewDir, 'deep-review-state-and-deltas'), allCorruptionWarnings);\n2394:   }\n2395: \n2396:   return {\n2397:     configPath,\n2398:     stateLogPath,\n2399:     strategyPath,\n2400:     registryPath,\n2401:     dashboardPath,\n2402:     resourceMapPath,\n2403:     registry,\n2404:     strategy,\n2405:     strategyWarning,\n2406:     dashboard,\n2407:     resourceMap,\n2408:     resourceMapSkipped,\n2409:     resourceMapSkipReason,\n2410:     corruptionWarnings: allCorruptionWarnings,\n2411:     hasCorruption: allCorruptionWarnings.length > 0,\n2412:   };\n2413: }\n2414: \n2415: // ─────────────────────────────────────────────────────────────────────────────\n2416: // 6. CLI ENTRY POINT\n2417: // ─────────────────────────────────────────────────────────────────────────────\n2418: \n2419: if (require.main === module) {\n2420:   const inputError = (message) => Object.assign(new Error(message), { code: 'INPUT_VALIDATION' });\n2421:   const booleanFlags = new Set(['lenient', 'createMissingAnchors', 'emitResourceMap']);\n2422:   const valueFlags = new Set(['artifactDir']);\n2423:   const parsedArgs = {};\n2424:   let specFolder;\n2425:   const cliArgs = process.argv.slice(2);\n2426:   try {\n2427:     for (let index = 0; index < cliArgs.length; index += 1) {\n2428:       const token = cliArgs[index];\n2429:       if (!token.startsWith('--')) {\n2430:         if (specFolder !== undefined) throw inputError(`Unexpected positional argument: ${token}`);\n[Output truncated. Continue reading with offset: 2431]","title":"read","metadata":{"metadata":{"truncated":true},"content":[{"type":"text","text":"Read file .skilled/skills/system-deep-loop/runtime/scripts/reduce-state.cjs, lines 2251-2430\n2251:  * Reduce JSONL state, iteration files, and strategy into synchronized registry,\n2252:  * strategy, and dashboard outputs. Idempotent: repeated calls produce identi