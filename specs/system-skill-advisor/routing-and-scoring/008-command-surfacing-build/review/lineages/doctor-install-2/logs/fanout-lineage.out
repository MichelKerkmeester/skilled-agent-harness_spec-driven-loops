{"type":"tool_use","timestamp":1794570521685,"sessionID":"ses_e2b4a18a6ffeJYEGLs0dTSiOZ0","part":{"partID":"prt_1d4bd0742001fSR8X2lx0Rr3j3","sessionID":"ses_e2b4a18a6ffeJYEGLs0dTSiOZ0","messageID":"msg_1d4bcfd2100103Ut6OavFusA60","type":"tool","id":"call_97f17dfab5db4d058bcfbf08","tool":"shell","state":{"status":"completed","input":{"command":"git diff 320e7b64d4..HEAD -- .skilled/commands/doctor/scripts/tests/doctor-install-contract.test.cjs .skilled/commands/doctor/scripts/tests/doctor-setup-contract.test.cjs .skilled/commands/doctor/scripts/tests/skill-advisor-route-contract.test.cjs"},"output":"diff --git a/.skilled/commands/doctor/scripts/tests/doctor-install-contract.test.cjs b/.skilled/commands/doctor/scripts/tests/doctor-install-contract.test.cjs\nindex 6d6f3700de..2035026ffe 100644\n--- a/.skilled/commands/doctor/scripts/tests/doctor-install-contract.test.cjs\n+++ b/.skilled/commands/doctor/scripts/tests/doctor-install-contract.test.cjs\n@@ -230,6 +230,13 @@ test('the presentation prints writing commands for the operator and closes on th\n   assert.ok(PRESENTATION.includes(`\\n${SAVE_CAVEAT}\\n`), SAVE_CAVEAT);\n });\n \n+test('the presentation and the workflow name the accepted runtimes instead of a count', () => {\n+  assert.doesNotMatch(PRESENTATION, /outside the seven/);\n+  assert.ok(PRESENTATION.includes('outside claude, opencode, codex, cursor, devin and pi or the ones already there'));\n+  assert.ok(PRESENTATION.includes('DSH is not offered, because the link manifest has no DSH row.'));\n+  assert.match(WORKFLOW.inputs.runtimes, /DSH is not offered/);\n+});\n+\n // ─────────────────────────────────────────────────────────────────────────────\n // 4. THE READ-ONLY WORKFLOW\n // ─────────────────────────────────────────────────────────────────────────────\ndiff --git a/.skilled/commands/doctor/scripts/tests/doctor-setup-contract.test.cjs b/.skilled/commands/doctor/scripts/tests/doctor-setup-contract.test.cjs\nnew file mode 100644\nindex 0000000000..2991d06a60\n--- /dev/null\n+++ b/.skilled/commands/doctor/scripts/tests/doctor-setup-contract.test.cjs\n@@ -0,0 +1,85 @@\n+#!/usr/bin/env node\n+// ───────────────────────────────────────────────────────────────────\n+// MODULE: Doctor Setup Contract Tests\n+// ───────────────────────────────────────────────────────────────────\n+'use strict';\n+\n+// ─────────────────────────────────────────────────────────────────────────────\n+// 1. IMPORTS AND FIXTURES\n+// ─────────────────────────────────────────────────────────────────────────────\n+\n+const assert = require('node:assert/strict');\n+const fs = require('node:fs');\n+const path = require('node:path');\n+const test = require('node:test');\n+const { parse: parseYaml } = require('yaml');\n+\n+const DOCTOR = path.resolve(__dirname, '..', '..');\n+const ASSETS = path.join(DOCTOR, 'assets');\n+const read = (file) => fs.readFileSync(file, 'utf8');\n+\n+const SETUP_WORKFLOW = parseYaml(read(path.join(ASSETS, 'doctor-setup.yaml')));\n+const SETUP_ROUTER = read(path.join(DOCTOR, 'setup.md'));\n+const SETUP_PRESENTATION = read(path.join(ASSETS, 'doctor-setup-presentation.txt'));\n+const SYMLINK_CHECK = parseYaml(read(path.join(ASSETS, 'doctor-symlink-check.yaml')));\n+\n+const stepNamed = (workflow, prefix) => {\n+  const step = workflow.execution.steps.find((entry) => entry.startsWith(prefix));\n+  assert.ok(step, 'no workflow step starts with ' + prefix);\n+  return step;\n+};\n+\n+const deliveryStep = stepNamed(SETUP_WORKFLOW, 'Leg delivery:');\n+const advisorStep = stepNamed(SETUP_WORKFLOW, 'Leg advisor:');\n+\n+// ─────────────────────────────────────────────────────────────────────────────\n+// 2. CONTRACT TESTS\n+// ─────────────────────────────────────────────────────────────────────────────\n+\n+test('the delivery step hands the absent Codex entry to the repair line the check printed', () => {\n+  assert.match(\n+    deliveryStep,\n+    /WARN codex-advisor-hook-absent is DEGRADED, with the repair line the check printed\\./,\n+  );\n+  assert.doesNotMatch(\n+    deliveryStep,\n+    /codex-advisor-hook-absent[^.]*\\/doctor:runtime-mirrors/,\n+  );\n+\n+  const deliveryRow = SETUP_PRESENTATION\n+    .split('\\n')\n+    .find((line) => line.startsWith('| delivery |'));\n+  assert.ok(deliveryRow, 'the presentation has no delivery repair row');\n+  assert.match(deliveryRow, /Absent Codex advisor entry: the repair line the check prints/);\n+});\n+\n+test('the symlink output block maps the hook-wiring check exits to WARN and FAIL', () => {\n+  assert.match(\n+    SYMLINK_CHECK.output,\n+    /STATUS=WARN when the engine exits 0 and the hook-wiring check exits 1\\./,\n+  );\n+  assert.match(\n+    SYMLINK_CHECK.output,\n+    /STATUS=FAIL when the hook-wiring check exits 2\\./,\n+  );\n+  assert.match(\n+    SYMLINK_CHECK.output,\n+    /When the engine and the hook-wiring check end on different statuses, the worse one wins: FAIL over WARN over OK\\./,\n+  );\n+});\n+\n+test('the setup mutation boundary names the socket directory outside the repository', () => {\n+  assert.match(\n+    SETUP_WORKFLOW.mutation_boundaries.invariant,\n+    /\\/tmp\\/system-skill-advisor/,\n+  );\n+});\n+\n+test('the setup workflow and router both name the unrecorded hook health state', () => {\n+  assert.match(advisorStep, /hook health not recorded/);\n+  assert.match(\n+    advisorStep,\n+    /When data\\.hookHealth is absent, show hook health not recorded under the leg, because no prompt hook has written a record for this checkout yet: OpenCode has no prompt hook that writes one and an unapproved Codex hook never runs\\./,\n+  );\n+  assert.match(SETUP_ROUTER, /hook health not recorded/);\n+});\ndiff --git a/.skilled/commands/doctor/scripts/tests/skill-advisor-route-contract.test.cjs b/.skilled/commands/doctor/scripts/tests/skill-advisor-route-contract.test.cjs\nindex ab6543e981..8adb4fa1a8 100644\n--- a/.skilled/commands/doctor/scripts/tests/skill-advisor-route-contract.test.cjs\n+++ b/.skilled/commands/doctor/scripts/tests/skill-advisor-route-contract.test.cjs\n@@ -409,6 +409,41 @@ test('the embedder workflow stops at one approval before any pull, server start\n   assert.match(approval, /STATUS=CANCELLED/u);\n });\n \n+test('the embedder start and pull steps bind the resolved host and refuse a remote one', () => {\n+  const activities = embedderWorkflow()\n+    .workflow.phase_4_approved_steps.activities\n+    .map(String);\n+\n+  // The probe resolves the URL from OLLAMA_BASE_URL, so the approved mutations\n+  // must reach that same server. A host that is not loopback is the operator's\n+  // own server, and pulling a model into it is not this route's to do.\n+  const refusalIndex = activities.findIndex(\n+    (activity) => /the resolved URL's host is not 127\\.0\\.0\\.1, localhost or ::1/u.test(activity),\n+  );\n+  assert.notStrictEqual(\n+    refusalIndex,\n+    -1,\n+    'the approved steps must refuse a resolved URL whose host is not local',\n+  );\n+  assert.match(activities[refusalIndex], /start and pull nothing/u);\n+  assert.match(activities[refusalIndex], /STATUS=FAIL naming the URL/u);\n+\n+  for (const command of ['ollama serve', 'ollama pull nomic-embed-text:v1.5']) {\n+    const commandIndex = activities.findIndex((activity) => activity.includes(command));\n+    assert.notStrictEqual(commandIndex, -1, `${command} must run in the approved steps`);\n+    assert.ok(\n+      commandIndex > refusalIndex,\n+      `the non-local refusal must come before ${command}`,\n+    );\n+    assert.match(activities[commandIndex], /OLLAMA_HOST=/u, `${command} must bind OLLAMA_HOST`);\n+    assert.match(\n+      activities[commandIndex],\n+      /resolved URL/u,\n+      `${command} must take its host from the resolved URL`,\n+    );\n+  }\n+});\n+\n test('a dry run stops after the plan with STATUS=OK and changes nothing', () => {\n   const workflow = embedderWorkflow();\n   assert.equal(workflow.operating_mode.dry_run, 'print_the_plan_then_status_ok');\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"diff --git a/.skilled/commands/doctor/scripts/tests/doctor-install-contract.test.cjs b/.skilled/commands/doctor/scripts/tests/doctor-install-contract.test.cjs\nindex 6d6f3700de..2035026ffe 100644\n--- a/.skilled/commands/doctor/scripts/tests/doctor-install-contract.test.cjs\n+++ b/.skilled/commands/doctor/scripts/tests/doctor-install-contract.test.cjs\n@@ -230,6 +230,13 @@ test('the presentation prints writing commands for the operator and closes on th\n   assert.ok(PRESENTATION.includes(`\\n${SAVE_CAVEAT}\\n`), SAVE_CAVEAT);\n });\n \n+test('the presentation and the workflow name the accepted runtimes instead of a count', () => {\n+  assert.doesNotMatch(PRESENTATION, /outside the seven/);\n+  assert.ok(PRESENTATION.includes('outside claude, opencode, codex, cursor, devin and pi or the ones already there'));\n+  assert.ok(PRESENTATION.includes('DSH is not offered, because the link manifest has no DSH row.'));\n+  assert.match(WORKFLOW.inputs.runtimes, /DSH is not offered/);\n+});\n+\n // ─────────────────────────────────────────────────────────────────────────────\n // 4. THE READ-ONLY WORKFLOW\n // ─────────────────────────────────────────────────────────────────────────────\ndiff --git a/.skilled/commands/doctor/scripts/tests/doctor-setup-contract.test.cjs b/.skilled/commands/doctor/scripts/tests/doctor-setup-contract.test.cjs\nnew file mode 100644\nindex 0000000000..2991d06a60\n--- /dev/null\n+++ b/.skilled/commands/doctor/scripts/tests/doctor-setup-contract.test.cjs\n@@ -0,0 +1,85 @@\n+#!/usr/bin/env node\n+// ───────────────────────────────────────────────────────────────────\n+// MODULE: Doctor Setup Contract Tests\n+// ───────────────────────────────────────────────────────────────────\n+'use strict';\n+\n+// ─────────────────────────────────────────────────────────────────────────────\n+// 1. IMPORTS AND FIXTURES\n+// ─────────────────────────────────────────────────────────────────────────────\n+\n+const assert = require('node:assert/strict');\n+const fs = require('node:fs');\n+const path = require('node:path');\n+const test = require('node:test');\n+const { parse: parseYaml } = require('yaml');\n+\n+const DOCTOR = path.resolve(__dirname, '..', '..');\n+const ASSETS = path.join(DOCTOR, 'assets');\n+const read = (file) => fs.readFileSync(file, 'utf8');\n+\n+const SETUP_WORKFLOW = parseYaml(read(path.join(ASSETS, 'doctor-setup.yaml')));\n+const SETUP_ROUTER = read(path.join(DOCTOR, 'setup.md'));\n+const SETUP_PRESENTATION = read(path.join(ASSETS, 'doctor-setup-presentation.txt'));\n+const SYMLINK_CHECK = parseYaml(read(path.join(ASSETS, 'doctor-symlink-check.yaml')));\n+\n+const stepNamed = (workflow, prefix) => {\n+  const step = workflow.execution.steps.find((entry) => entry.startsWith(prefix));\n+  assert.ok(step, 'no workflow step starts with ' + prefix);\n+  return step;\n+};\n+\n+const deliveryStep = stepNamed(SETUP_WORKFLOW, 'Leg delivery:');\n+const advisorStep = stepNamed(SETUP_WORKFLOW, 'Leg advisor:');\n+\n+// ─────────────────────────────────────────────────────────────────────────────\n+// 2. CONTRACT TESTS\n+// ─────────────────────────────────────────────────────────────────────────────\n+\n+test('the delivery step hands the absent Codex entry to the repair line the check printed', () => {\n+  assert.match(\n+    deliveryStep,\n+    /WARN codex-advisor-hook-absent is DEGRADED, with the repair line the check printed\\./,\n+  );\n+  assert.doesNotMatch(\n+    deliveryStep,\n+    /codex-advisor-hook-absent[^.]*\\/doctor:runtime-mirrors/,\n+  );\n+\n+  const deliveryRow = SETUP_PRESENTATION\n+    .split('\\n')\n+    .find((line) => line.startsWith('| delivery |'));\n+  assert.ok(deliveryRow, 'the presentation has no delivery repair row');\n+  assert.match(deliveryRow, /Absent Codex advisor entry: the repair line the check prints/);\n+});\n+\n+test('the symlink output block maps the hook-wiring check exits to WARN and FAIL', () => {\n+  assert.match(\n+    SYMLINK_CHECK.output,\n+    /STATUS=WARN when the engine exits 0 and the hook-wiring check exits 1\\./,\n+  );\n+  assert.match(\n+    SYMLINK_CHECK.output,\n+    /STATUS=FAIL when the hook-wiring check exits 2\\./,\n+  );\n+  assert.match(\n+    SYMLINK_CHECK.output,\n+    /When the engine and the hook-wiring check end on different statuses, the worse one wins: FAIL over WARN over OK\\./,\n+  );\n+});\n+\n+test('the setup mutation boundary names the socket directory outside the repository', () => {\n+  assert.match(\n+    SETUP_WORKFLOW.mutation_boundaries.invariant,\n+    /\\/tmp\\/system-skill-advisor/,\n+  );\n+});\n+\n+test('the setup workflow and router both name the unrecorded hook health state', () => {\n+  assert.match(advisorStep, /hook health not recorded/);\n+  assert.match(\n+    advisorStep,\n+    /When data\\.hookHealth is absent, show hook health not recorded under the leg, because no prompt hook has written a record for this checkout yet: OpenCode has no prompt hook that writes one and an unapproved Codex hook never runs\\./,\n+  );\n+  assert.match(SETUP_ROUTER, /hook health not recorded/);\n+});\ndiff --git a/.skilled/commands/doctor/scripts/tests/skill-advisor-route-contract.test.cjs b/.skilled/commands/doctor/scripts/tests/skill-advisor-route-contract.test.cjs\nindex ab6543e981..8adb4fa1a8 100644\n--- a/.skilled/commands/doctor/scripts/tests/skill-advisor-route-contract.test.cjs\n+++ b/.skilled/commands/doctor/scripts/tests/skill-advisor-route-contract.test.cjs\n@@ -409,6 +409,41 @@ test('the embedder workflow stops at one approval before any pull, server start\n   assert.match(approval, /STATUS=CANCELLED/u);\n });\n \n+test('the embedder start and pull steps bind the resolved host and refuse a remote one', () => {\n+  const activities = embedderWorkflow()\n+    .workflow.phase_4_approved_steps.activities\n+    .map(String);\n+\n+  // The probe resolves the URL from OLLAMA_BASE_URL, so the approved mutations\n+  // must reach that same server. A host that is not loopback is the operator's\n+  // own server, and pulling a model into it is not this route's to do.\n+  const refusalIndex = activities.findIndex(\n+    (activity) => /the resolved URL's host is not 127\\.0\\.0\\.1, localhost or ::1/u.test(activity),\n+  );\n+  assert.notStrictEqual(\n+    refusalIndex,\n+    -1,\n+    'the approved steps must refuse a resolved URL whose host is not local',\n+  );\n+  assert.match(activities[refusalIndex], /start and pull nothing/u);\n+  assert.match(activities[refusalIndex], /STATUS=FAIL naming the URL/u);\n+\n+  for (const command of ['ollama serve', 'ollama pull nomic-embed-text:v1.5']) {\n+    const commandIndex = activities.findIndex((activity) => activity.includes(command));\n+    assert.notStrictEqual(commandIndex, -1, `${command} must run in the approved steps`);\n+    assert.ok(\n+      commandIndex > refusalIndex,\n+      `the non-local refusal must come before ${command}`,\n+    );\n+    assert.match(activities[commandIndex], /OLLAMA_HOST=/u, `${command} must bind OLLAMA_HOST`);\n+    assert.match(\n+      activities[commandIndex],\n+      /resolved URL/u,\n+      `${command} must take its host from the resolved URL`,\n+    );\n+  }\n+});\n+\n test('a dry run stops after the plan with STATUS=OK and changes nothing', () => {\n   const workflow = embedderWorkflow();\n   assert.equal(workflow.operating_mode.dry_run, 'print_the_plan_then_status_ok');\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"git diff 320e7b64d4..HEAD -- .skilled/commands/doctor/scripts/tests/doctor-install-contract.test.cjs .skilled/commands/doctor/scripts/tests/doctor-setup-contract.test.cjs .skilled/commands/doctor/scripts/tests/skill-advisor-route-contract.test.cjs\"}"},"time":{"start":1794570520386,"end":1794570521685}}}}
