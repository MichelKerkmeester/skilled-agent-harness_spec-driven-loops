{"type":"step_start","timestamp":1794570395181,"sessionID":"ses_e2b4a18a6ffeJYEGLs0dTSiOZ0","part":{"id":"prt_1d4bb1e2d001L1iVPnlzeJS4yZ","sessionID":"ses_e2b4a18a6ffeJYEGLs0dTSiOZ0","messageID":"msg_1d4bb0495001703K1QjnZBGe5L","type":"step-start","snapshot":"dd0cbac5fe6ef4fa3aaca1afede0ed850248e7ac"}}
{"type":"tool_use","timestamp":1794570395749,"sessionID":"ses_e2b4a18a6ffeJYEGLs0dTSiOZ0","part":{"partID":"prt_1d4bb1e3a002m0KhJEMJe6oRMh","sessionID":"ses_e2b4a18a6ffeJYEGLs0dTSiOZ0","messageID":"msg_1d4bb0495001703K1QjnZBGe5L","type":"tool","id":"call_fc0e60826f37492b9ac65eda","tool":"shell","state":{"status":"completed","input":{"command":"git diff 320e7b64d4..HEAD -- .skilled/commands/doctor/scripts/tests/agents-md-check.test.cjs | head -180"},"output":"diff --git a/.skilled/commands/doctor/scripts/tests/agents-md-check.test.cjs b/.skilled/commands/doctor/scripts/tests/agents-md-check.test.cjs\nindex 46d73c4459..c102f5f92f 100644\n--- a/.skilled/commands/doctor/scripts/tests/agents-md-check.test.cjs\n+++ b/.skilled/commands/doctor/scripts/tests/agents-md-check.test.cjs\n@@ -140,6 +140,55 @@ function writeManifest(t, patch) {\n   return target;\n }\n \n+// The router a fixture case reads, built from the rows the manifest ships so the case\n+// stays a statement about the template and not a copy of it. A router whose trigger row\n+// or index row is absent would make A11 report a missing row rather than the shape a\n+// case plants, which is the one thing every router case below needs to keep apart.\n+function routerRow(cells) {\n+  return `| ${cells.join(' | ')} |`;\n+}\n+\n+function completeRouter() {\n+  const shipped = (manifest.derived && manifest.derived.repo_rules) || { trigger_rows: [], index_rows: [] };\n+  return [\n+    '# REPO RULES',\n+    '',\n+    '---',\n+    '',\n+    '## 1. HOW TO USE THIS',\n+    '',\n+    'Read the rule the action fires.',\n+    '',\n+    '---',\n+    '',\n+    '## 2. TRIGGER TABLE',\n+    '',\n+    routerRow(['You are about to…', 'Load', 'It settles']),\n+    '|---|---|---|',\n+    ...shipped.trigger_rows.map(routerRow),\n+    '',\n+    '---',\n+    '',\n+    '## 3. INDEX',\n+    '',\n+    routerRow(['Rule', 'Summary']),\n+    '|---|---|',\n+    ...shipped.index_rows.map(routerRow),\n+    '',\n+  ].join('\\n');\n+}\n+\n+// A checker stand-in that prints the one line A11 carries through. The cases below ask\n+// what the row says about the document it read, and a stub keeps the answer from\n+// depending on a rule corpus the fixture does not carry.\n+function writeRouterChecker(t) {\n+  const dir = fs.mkdtempSync(path.join(os.tmpdir(), 'agents-md-check-router-tool-'));\n+  t.after(() => fs.rmSync(dir, { recursive: true, force: true }));\n+  const target = path.join(dir, 'check-repo-rules.cjs');\n+  fs.writeFileSync(target, \"console.log('[repo-rules-check] RESULT: PASSED (11/11 checks)');\\n\", 'utf8');\n+  return target;\n+}\n+\n function treeDigest(dir) {\n   const hash = crypto.createHash('sha256');\n   for (const file of listFiles(dir).sort()) {\n@@ -475,6 +524,39 @@ test('A10 reports a pointer-only CLAUDE.md and an absent .codex/AGENTS.md withou\n   assert.equal(codex.state, 'PASS');\n });\n \n+// A pointer names the root document on one line and carries no shipped line of its own.\n+// Its other lines are prose the author wrote, so a verdict claiming every line names the\n+// root would describe a shape the file never had to hold.\n+test('A10 describes a pointer by what it does, not by what every line holds', (t) => {\n+  const fixture = buildFixture(t, 'pure');\n+  fs.writeFileSync(\n+    path.join(fixture.dir, 'CLAUDE.md'),\n+    '@AGENTS.md\\n\\nUse the house style.\\n',\n+    'utf8',\n+  );\n+  const report = buildReport({ root: fixture.dir });\n+\n+  const copies = report.rows.find((row) => row.id === 'A10');\n+  const claude = copies.entries.find((entry) => entry.path === 'CLAUDE.md');\n+  assert.equal(claude.kind, 'pointer');\n+  assert.equal(claude.detail, 'names AGENTS.md and carries no shipped line');\n+});\n+\n+// A path the checklist expects to be absent is one no runtime should load. A symlink is\n+// still a file at that path, so the root document reaches the runtime a second time under\n+// a name the checklist says nothing belongs at, which reads the same as a hand-kept copy.\n+test('a symlinked copy where the checklist expects no file is a finding', (t) => {\n+  const fixture = buildFixture(t, 'pure');\n+  fs.mkdirSync(path.join(fixture.dir, '.codex'));\n+  fs.symlinkSync('../AGENTS.md', path.join(fixture.dir, '.codex/AGENTS.md'));\n+\n+  const report = buildReport({ root: fixture.dir });\n+  const copies = report.rows.find((row) => row.id === 'A10');\n+  const codex = copies.entries.find((entry) => entry.path === '.codex/AGENTS.md');\n+  assert.equal(codex.state, 'FINDING', 'a link at an absent-only path is not a pass');\n+  assert.equal(codex.kind, 'symlink where none belongs');\n+});\n+\n // Claude Code reads only CLAUDE.md, so a tree without one leaves Claude with no route to\n // the root document. That is a missing route, not a copy that is wrong, so the row stays a\n // pass and the line still prints what Claude never loads.\n@@ -494,6 +576,23 @@ test('a pure tree with no CLAUDE.md reports a missing pointer and keeps A10 a pa\n     `the missing pointer is printed, not only recorded: ${JSON.stringify(copies.lines)}`);\n });\n \n+// A missing pointer is a route the runtime does not have, not a copy that was checked.\n+// Counting it among the copies as expected reports a full set from a tree that leaves\n+// Claude with no route to the root document, so the count leaves it out and names it after.\n+test('A10 leaves a missing pointer out of the count and names it after the copies', (t) => {\n+  const fixture = buildFixture(t, 'pure');\n+  assert.equal(fs.existsSync(path.join(fixture.dir, 'CLAUDE.md')), false, 'the composed template carries no CLAUDE.md');\n+  const mirrors = spawnSync(process.execPath, [POINTER_SYNC, '--root', fixture.dir], { encoding: 'utf8' });\n+  assert.equal(mirrors.status, 0, `the pointer sync completes the fixture's mirrors: ${mirrors.stderr}`);\n+\n+  const report = buildReport({ root: fixture.dir });\n+  const copies = report.rows.find((row) => row.id === 'A10');\n+  assert.ok(copies.detail.endsWith(', 1 pointer missing'),\n+    `the detail names the missing pointer after the count: ${copies.detail}`);\n+  assert.match(copies.detail, /^5\\/6 copies as expected/u,\n+    `the count leaves the CLAUDE.md entry out: ${copies.detail}`);\n+});\n+\n // A copy whose own tool is missing was not checked. Recorded only in the JSON entries, it\n // prints as a pass line with no detail and leaves the run reporting unknown=0.\n test('an unmeasured runtime copy makes A10 UNKNOWN and is counted in unknown=', (t) => {\n@@ -637,6 +736,32 @@ test('A11 embeds the repo-rules checker\\'s own summary line instead of re-derivi\n   assert.match(row.detail, /\\[repo-rules-check\\] RESULT: PASSED \\(\\d+\\/\\d+ checks\\)/);\n });\n \n+// A table row of another width is a defect in the document a reader has to be sent to,\n+// and the rule it names still arrives as a row. Dropping it above the row comparison\n+// reports the one thing the document does not have, a missing row, and hides the reason.\n+test('A11 reports a router row of the wrong width as malformed', (t) => {\n+  const fixture = buildFixture(t, 'pure');\n+  const router = completeRouter();\n+  const rows = router.split('\\n');\n+  const at = rows.findIndex((line) => line.startsWith('| Add a file, module, class'));\n+  assert.notEqual(at, -1, 'the shipped prevent-overengineering row is in the trigger table');\n+  const cells = rows[at].replace(/^\\|/u, '').replace(/\\|$/u, '').split('|').map((cell) => cell.trim());\n+  rows[at] = `| ${cells.slice(0, -1).join(' | ')} | a | b |`;\n+  fs.writeFileSync(path.join(fixture.dir, 'REPO RULES.md'), rows.join('\\n'), 'utf8');\n+\n+  const report = buildReport({\n+    root: fixture.dir,\n+    tools: { repoRules: writeRouterChecker(t) },\n+  });\n+  const routerRow = report.rows.find((entry) => entry.id === 'A11');\n+  assert.equal(routerRow.state, 'FINDING', `a malformed row is a finding: ${JSON.stringify(routerRow.lines)}`);\n+  const malformed = routerRow.lines.find((line) => line.startsWith('malformed trigger row at line '));\n+  assert.ok(malformed, `A11 names the malformed row: ${JSON.stringify(routerRow.lines)}`);\n+  assert.match(malformed, new RegExp(`^malformed trigger row at line ${at + 1}: 4 cells where the header has 3$`, 'u'));\n+  assert.ok(!routerRow.lines.some((line) => line.includes('missing trigger row for prevent-overengineering.md')),\n+    'the row still names its rule, so it is not reported missing');\n+});\n+\n test('A12 reports INFO outside the source repository and runs inside it', (t) => {\n   const fixture = buildFixture(t, 'pure');\n   const outside = buildReport({ root: fixture.dir });\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"diff --git a/.skilled/commands/doctor/scripts/tests/agents-md-check.test.cjs b/.skilled/commands/doctor/scripts/tests/agents-md-check.test.cjs\nindex 46d73c4459..c102f5f92f 100644\n--- a/.skilled/commands/doctor/scripts/tests/agents-md-check.test.cjs\n+++ b/.skilled/commands/doctor/scripts/tests/agents-md-check.test.cjs\n@@ -140,6 +140,55 @@ function writeManifest(t, patch) {\n   return target;\n }\n \n+// The router a fixture case reads, built from the rows the manifest ships so the case\n+// stays a statement about the template and not a copy of it. A router whose trigger row\n+// or index row is absent would make A11 report a missing row rather than the shape a\n+// case plants, which is the one thing every router case below needs to keep apart.\n+function routerRow(cells) {\n+  return `| ${cells.join(' | ')} |`;\n+}\n+\n+function completeRouter() {\n+  const shipped = (manifest.derived && manifest.derived.repo_rules) || { trigger_rows: [], index_rows: [] };\n+  return [\n+    '# REPO RULES',\n+    '',\n+    '---',\n+    '',\n+    '## 1. HOW TO USE THIS',\n+    '',\n+    'Read the rule the action fires.',\n+    '',\n+    '---',\n+    '',\n+    '## 2. TRIGGER TABLE',\n+    '',\n+    routerRow(['You are about to…', 'Load', 'It settles']),\n+    '|---|---|---|',\n+    ...shipped.trigger_rows.map(routerRow),\n+    '',\n+    '---',\n+    '',\n+    '## 3. INDEX',\n+    '',\n+    routerRow(['Rule', 'Summary']),\n+    '|---|---|',\n+    ...shipped.index_rows.map(routerRow),\n+    '',\n+  ].join('\\n');\n+}\n+\n+// A checker stand-in that prints the one line A11 carries through. The cases below ask\n+// what the row says about the document it read, and a stub keeps the answer from\n+// depending on a rule corpus the fixture does not carry.\n+function writeRouterChecker(t) {\n+  const dir = fs.mkdtempSync(path.join(os.tmpdir(), 'agents-md-check-router-tool-'));\n+  t.after(() => fs.rmSync(dir, { recursive: true, force: true }));\n+  const target = path.join(dir, 'check-repo-rules.cjs');\n+  fs.writeFileSync(target, \"console.log('[repo-rules-check] RESULT: PASSED (11/11 checks)');\\n\", 'utf8');\n+  return target;\n+}\n+\n function treeDigest(dir) {\n   const hash = crypto.createHash('sha256');\n   for (const file of listFiles(dir).sort()) {\n@@ -475,6 +524,39 @@ test('A10 reports a pointer-only CLAUDE.md and an absent .codex/AGENTS.md withou\n   assert.equal(codex.state, 'PASS');\n });\n \n+// A pointer names the root document on one line and carries no shipped line of its own.\n+// Its other lines are prose the author wrote, so a verdict claiming every line names the\n+// root would describe a shape the file never had to hold.\n+test('A10 describes a pointer by what it does, not by what every line holds', (t) => {\n+  const fixture = buildFixture(t, 'pure');\n+  fs.writeFileSync(\n+    path.join(fixture.dir, 'CLAUDE.md'),\n+    '@AGENTS.md\\n\\nUse the house style.\\n',\n+    'utf8',\n+  );\n+  const report = buildReport({ root: fixture.dir });\n+\n+  const copies = report.rows.find((row) => row.id === 'A10');\n+  const claude = copies.entries.find((entry) => entry.path === 'CLAUDE.md');\n+  assert.equal(claude.kind, 'pointer');\n+  assert.equal(claude.detail, 'names AGENTS.md and carries no shipped line');\n+});\n+\n+// A path the checklist expects to be absent is one no runtime should load. A symlink is\n+// still a file at that path, so the root document reaches the runtime a second time under\n+// a name the checklist says nothing belongs at, which reads the same as a hand-kept copy.\n+test('a symlinked copy where the checklist expects no file is a finding', (t) => {\n+  const fixture = buildFixture(t, 'pure');\n+  fs.mkdirSync(path.join(fixture.dir, '.codex'));\n+  fs.symlinkSync('../AGENTS.md', path.join(fixture.dir, '.codex/AGENTS.md'));\n+\n+  const report = buildReport({ root: fixture.dir });\n+  const copies = report.rows.find((row) => row.id === 'A10');\n+  const codex = copies.entries.find((entry) => entry.path === '.codex/AGENTS.md');\n+  assert.equal(codex.state, 'FINDING', 'a link at an absent-only path is not a pass');\n+  assert.equal(codex.kind, 'symlink where none belongs');\n+});\n+\n // Claude Code reads only CLAUDE.md, so a tree without one leaves Claude with no route to\n // the root document. That is a missing route, not a copy that is wrong, so the row stays a\n // pass and the line still prints what Claude never loads.\n@@ -494,6 +576,23 @@ test('a pure tree with no CLAUDE.md reports a missing pointer and keeps A10 a pa\n     `the missing pointer is printed, not only recorded: ${JSON.stringify(copies.lines)}`);\n });\n \n+// A missing pointer is a route the runtime does not have, not a copy that was checked.\n+// Counting it among the copies as expected reports a full set from a tree that leaves\n+// Claude with no route to the root document, so the count leaves it out and names it after.\n+test('A10 leaves a missing pointer out of the count and names it after the copies', (t) => {\n+  const fixture = buildFixture(t, 'pure');\n+  assert.equal(fs.existsSync(path.join(fixture.dir, 'CLAUDE.md')), false, 'the composed template carries no CLAUDE.md');\n+  const mirrors = spawnSync(process.execPath, [POINTER_SYNC, '--root', fixture.dir], { encoding: 'utf8' });\n+  assert.equal(mirrors.status, 0, `the pointer sync completes the fixture's mirrors: ${mirrors.stderr}`);\n+\n+  const report = buildReport({ root: fixture.dir });\n+  const copies = report.rows.find((row) => row.id === 'A10');\n+  assert.ok(copies.detail.endsWith(', 1 pointer missing'),\n+    `the detail names the missing pointer after the count: ${copies.detail}`);\n+  assert.match(copies.detail, /^5\\/6 copies as expected/u,\n+    `the count leaves the CLAUDE.md entry out: ${copies.detail}`);\n+});\n+\n // A copy whose own tool is missing was not checked. Recorded only in the JSON entries, it\n // prints as a pass line with no detail and leaves the run reporting unknown=0.\n test('an unmeasured runtime copy makes A10 UNKNOWN and is counted in unknown=', (t) => {\n@@ -637,6 +736,32 @@ test('A11 embeds the repo-rules checker\\'s own summary line instead of re-derivi\n   assert.match(row.detail, /\\[repo-rules-check\\] RESULT: PASSED \\(\\d+\\/\\d+ checks\\)/);\n });\n \n+// A table row of another width is a defect in the document a reader has to be sent to,\n+// and the rule it names still arrives as a row. Dropping it above the row comparison\n+// reports the one thing the document does not have, a missing row, and hides the reason.\n+test('A11 reports a router row of the wrong width as malformed', (t) => {\n+  const fixture = buildFixture(t, 'pure');\n+  const router = completeRouter();\n+  const rows = router.split('\\n');\n+  const at = rows.findIndex((line) => line.startsWith('| Add a file, module, class'));\n+  assert.notEqual(at, -1, 'the shipped prevent-overengineering row is in the trigger table');\n+  const cells = rows[at].replace(/^\\|/u, '').replace(/\\|$/u, '').split('|').map((cell) => cell.trim());\n+  rows[at] = `| ${cells.slice(0, -1).join(' | ')} | a | b |`;\n+  fs.writeFileSync(path.join(fixture.dir, 'REPO RULES.md'), rows.join('\\n'), 'utf8');\n+\n+  const report = buildReport({\n+    root: fixture.dir,\n+    tools: { repoRules: writeRouterChecker(t) },\n+  });\n+  const routerRow = report.rows.find((entry) => entry.id === 'A11');\n+  assert.equal(routerRow.state, 'FINDING', `a malformed row is a finding: ${JSON.stringify(routerRow.lines)}`);\n+  const malformed = routerRow.lines.find((line) => line.startsWith('malformed trigger row at line '));\n+  assert.ok(malformed, `A11 names the malformed row: ${JSON.stringify(routerRow.lines)}`);\n+  assert.match(malformed, new RegExp(`^malformed trigger row at line ${at + 1}: 4 cells where the header has 3$`, 'u'));\n+  assert.ok(!routerRow.lines.some((line) => line.includes('missing trigger row for prevent-overengineering.md')),\n+    'the row still names its rule, so it is not reported missing');\n+});\n+\n test('A12 reports INFO outside the source repository and runs inside it', (t) => {\n   const fixture = buildFixture(t, 'pure');\n   const outside = buildReport({ root: fixture.dir });\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"git diff 320e7b64d4..HEAD -- .skilled/commands/doctor/scripts/tests/agents-md-check.test.cjs | head -180\"}"},"time":{"start":1794570395194,"end":1794570395749}}}}
{"type":"tool_use","timestamp":1794570395790,"sessionID":"ses_e2b4a18a6ffeJYEGLs0dTSiOZ0","part":{"partID":"prt_1d4bb1e3c001IFmW9J0FU1mlB7","sessionID":"ses_e2b4a18a6ffeJYEGLs0dTSiOZ0","messageID":"msg_1d4bb0495001703K1QjnZBGe5L","type":"tool","id":"call_9cbdf098b07d42e9b40c8601","tool":"shell","state":{"status":"completed","input":{"command":"git diff 320e7b64d4..HEAD -- .skilled/commands/doctor/scripts/tests/hook-wiring-check.test.cjs .skilled/commands/doctor/scripts/tests/codex-hook-approval-check.test.cjs | head -220"},"output":"diff --git a/.skilled/commands/doctor/scripts/tests/codex-hook-approval-check.test.cjs b/.skilled/commands/doctor/scripts/tests/codex-hook-approval-check.test.cjs\nindex 97ef9dded8..0cadeb8b93 100644\n--- a/.skilled/commands/doctor/scripts/tests/codex-hook-approval-check.test.cjs\n+++ b/.skilled/commands/doctor/scripts/tests/codex-hook-approval-check.test.cjs\n@@ -108,9 +108,39 @@ test('an entry with no approval warns and names the repair', (t) => {\n   assert.doesNotMatch(result.stdout, /sha256/);\n });\n \n+// An absent entry has no hash to approve, so the repair has to be the copy that\n+// creates the entry and the approval that lets it run, not the approval alone.\n+test('an absent advisor entry prints the repair that creates it', (t) => {\n+  const root = fixture(t);\n+  writeFile(path.join(root, HOOKS_FILE), JSON.stringify({\n+    hooks: {\n+      UserPromptSubmit: [\n+        { hooks: [{ type: 'command', command: 'node other-prompt-hook.js' }] },\n+      ],\n+    },\n+  }));\n+  const repair = `repair: copy the advisor UserPromptSubmit entry from the Skilled checkout's .codex/hooks.json into ${path.join(root, HOOKS_FILE)}, then approve it with /hooks in a Codex session`;\n+\n+  const text = run(root, path.join(root, CONFIG_FILE));\n+  assert.equal(text.status, 1, text.stderr);\n+  assert.equal(text.stdout, `WARN codex-advisor-hook-absent\\n${repair}\\n`);\n+\n+  const json = spawnSync(process.execPath, [SCRIPT, '--root', root, '--json'], { encoding: 'utf8' });\n+  assert.equal(json.status, 1, json.stderr);\n+  assert.equal(JSON.parse(json.stdout).repair, repair);\n+});\n+\n test('a project without .codex is skipped', (t) => {\n   const root = fixture(t);\n   const result = run(root, path.join(root, CONFIG_FILE));\n   assert.equal(result.status, 0, result.stderr);\n   assert.equal(result.stdout, 'SKIP no-codex-hooks\\n');\n });\n+\n+// A flag standing where a value belongs leaves the option without a value. The run\n+// must refuse the arguments rather than read a root the operator never named.\n+test('a flag standing where a value belongs is refused', () => {\n+  const result = spawnSync(process.execPath, [SCRIPT, '--root', '--json'], { encoding: 'utf8' });\n+  assert.equal(result.status, 2, result.stderr);\n+  assert.match(result.stderr, /Usage: codex-hook-approval-check\\.cjs/);\n+});\ndiff --git a/.skilled/commands/doctor/scripts/tests/hook-wiring-check.test.cjs b/.skilled/commands/doctor/scripts/tests/hook-wiring-check.test.cjs\nindex 13bb2db895..f6242ec853 100644\n--- a/.skilled/commands/doctor/scripts/tests/hook-wiring-check.test.cjs\n+++ b/.skilled/commands/doctor/scripts/tests/hook-wiring-check.test.cjs\n@@ -57,7 +57,7 @@ test('passes a runtime whose prompt entry is wired', (t) => {\n   const f = fixture(t);\n   writeClaudeSettings(f.root, {\n     UserPromptSubmit: [{\n-      hooks: [{ type: 'command', command: `node ${CLAUDE_MARKER}` }],\n+      hooks: [{ type: 'command', command: `bash -c 'cd \"$PWD\" && node ${CLAUDE_MARKER}'` }],\n     }],\n   });\n   const text = f.run();\n@@ -68,6 +68,70 @@ test('passes a runtime whose prompt entry is wired', (t) => {\n   assert.equal(JSON.parse(json.out).checks.find((check) => check.runtime === 'claude').status, 'ok');\n });\n \n+test('passes a prompt entry that starts node on the script path', (t) => {\n+  const f = fixture(t);\n+  writeClaudeSettings(f.root, {\n+    UserPromptSubmit: [{\n+      hooks: [{ type: 'command', command: `node ${CLAUDE_MARKER}` }],\n+    }],\n+  });\n+  const text = f.run();\n+  assert.equal(text.code, 0);\n+  assert.equal(text.out.trim(), 'ok claude');\n+});\n+\n+test('passes a prompt entry that starts node by its absolute path', (t) => {\n+  const f = fixture(t);\n+  writeClaudeSettings(f.root, {\n+    UserPromptSubmit: [{\n+      hooks: [{ type: 'command', command: `/opt/homebrew/bin/node ${CLAUDE_MARKER}` }],\n+    }],\n+  });\n+  const text = f.run();\n+  assert.equal(text.code, 0);\n+  assert.equal(text.out.trim(), 'ok claude');\n+});\n+\n+test('names a runtime whose entry only names node as an argument', (t) => {\n+  const f = fixture(t);\n+  writeClaudeSettings(f.root, {\n+    UserPromptSubmit: [{\n+      hooks: [{ type: 'command', command: `echo node ${CLAUDE_MARKER}` }],\n+    }],\n+  });\n+  const result = f.run();\n+  assert.equal(result.code, 1);\n+  assert.match(result.out, /^hook-missing claude \\.claude\\/settings\\.json$/m);\n+});\n+\n+test('names a runtime whose entry only echoes the script path', (t) => {\n+  const f = fixture(t);\n+  writeClaudeSettings(f.root, {\n+    UserPromptSubmit: [{\n+      hooks: [{ type: 'command', command: 'echo hooks/claude/user-prompt-submit.js' }],\n+    }],\n+  });\n+  const result = f.run();\n+  assert.equal(result.code, 1);\n+  assert.match(result.out, /^hook-missing claude \\.claude\\/settings\\.json$/m);\n+});\n+\n+test('names a runtime whose entry only describes the script', (t) => {\n+  const f = fixture(t);\n+  writeClaudeSettings(f.root, {\n+    UserPromptSubmit: [{\n+      hooks: [{\n+        type: 'command',\n+        command: 'node some-other-hook.js',\n+        description: 'hooks/claude/user-prompt-submit.js',\n+      }],\n+    }],\n+  });\n+  const result = f.run();\n+  assert.equal(result.code, 1);\n+  assert.match(result.out, /^hook-missing claude \\.claude\\/settings\\.json$/m);\n+});\n+\n test('skips a runtime whose folder is absent', (t) => {\n   const f = fixture(t);\n   const text = f.run();\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"diff --git a/.skilled/commands/doctor/scripts/tests/codex-hook-approval-check.test.cjs b/.skilled/commands/doctor/scripts/tests/codex-hook-approval-check.test.cjs\nindex 97ef9dded8..0cadeb8b93 100644\n--- a/.skilled/commands/doctor/scripts/tests/codex-hook-approval-check.test.cjs\n+++ b/.skilled/commands/doctor/scripts/tests/codex-hook-approval-check.test.cjs\n@@ -108,9 +108,39 @@ test('an entry with no approval warns and names the repair', (t) => {\n   assert.doesNotMatch(result.stdout, /sha256/);\n });\n \n+// An absent entry has no hash to approve, so the repair has to be the copy that\n+// creates the entry and the approval that lets it run, not the approval alone.\n+test('an absent advisor entry prints the repair that creates it', (t) => {\n+  const root = fixture(t);\n+  writeFile(path.join(root, HOOKS_FILE), JSON.stringify({\n+    hooks: {\n+      UserPromptSubmit: [\n+        { hooks: [{ type: 'command', command: 'node other-prompt-hook.js' }] },\n+      ],\n+    },\n+  }));\n+  const repair = `repair: copy the advisor UserPromptSubmit entry from the Skilled checkout's .codex/hooks.json into ${path.join(root, HOOKS_FILE)}, then approve it with /hooks in a Codex session`;\n+\n+  const text = run(root, path.join(root, CONFIG_FILE));\n+  assert.equal(text.status, 1, text.stderr);\n+  assert.equal(text.stdout, `WARN codex-advisor-hook-absent\\n${repair}\\n`);\n+\n+  const json = spawnSync(process.execPath, [SCRIPT, '--root', root, '--json'], { encoding: 'utf8' });\n+  assert.equal(json.status, 1, json.stderr);\n+  assert.equal(JSON.parse(json.stdout).repair, repair);\n+});\n+\n test('a project without .codex is skipped', (t) => {\n   const root = fixture(t);\n   const result = run(root, path.join(root, CONFIG_FILE));\n   assert.equal(result.status, 0, result.stderr);\n   assert.equal(result.stdout, 'SKIP no-codex-hooks\\n');\n });\n+\n+// A flag standing where a value belongs leaves the option without a value. The run\n+// must refuse the arguments rather than read a root the operator never named.\n+test('a flag standing where a value belongs is refused', () => {\n+  const result = spawnSync(process.execPath, [SCRIPT, '--root', '--json'], { encoding: 'utf8' });\n+  assert.equal(result.status, 2, result.stderr);\n+  assert.match(result.stderr, /Usage: codex-hook-approval-check\\.cjs/);\n+});\ndiff --git a/.skilled/commands/doctor/scripts/tests/hook-wiring-check.test.cjs b/.skilled/commands/doctor/scripts/tests/hook-wiring-check.test.cjs\nindex 13bb2db895..f6242ec853 100644\n--- a/.skilled/commands/doctor/scripts/tests/hook-wiring-check.test.cjs\n+++ b/.skilled/commands/doctor/scripts/tests/hook-wiring-check.test.cjs\n@@ -57,7 +57,7 @@ test('passes a runtime whose prompt entry is wired', (t) => {\n   const f = fixture(t);\n   writeClaudeSettings(f.root, {\n     UserPromptSubmit: [{\n-      hooks: [{ type: 'command', command: `node ${CLAUDE_MARKER}` }],\n+      hooks: [{ type: 'command', command: `bash -c 'cd \"$PWD\" && node ${CLAUDE_MARKER}'` }],\n     }],\n   });\n   const text = f.run();\n@@ -68,6 +68,70 @@ test('passes a runtime whose prompt entry is wired', (t) => {\n   assert.equal(JSON.parse(json.out).checks.find((check) => check.runtime === 'claude').status, 'ok');\n });\n \n+test('passes a prompt entry that starts node on the script path', (t) => {\n+  const f = fixture(t);\n+  writeClaudeSettings(f.root, {\n+    UserPromptSubmit: [{\n+      hooks: [{ type: 'command', command: `node ${CLAUDE_MARKER}` }],\n+    }],\n+  });\n+  const text = f.run();\n+  assert.equal(text.code, 0);\n+  assert.equal(text.out.trim(), 'ok claude');\n+});\n+\n+test('passes a prompt entry that starts node by its absolute path', (t) => {\n+  const f = fixture(t);\n+  writeClaudeSettings(f.root, {\n+    UserPromptSubmit: [{\n+      hooks: [{ type: 'command', command: `/opt/homebrew/bin/node ${CLAUDE_MARKER}` }],\n+    }],\n+  });\n+  const text = f.run();\n+  assert.equal(text.code, 0);\n+  assert.equal(text.out.trim(), 'ok claude');\n+});\n+\n+test('names a runtime whose entry only names node as an argument', (t) => {\n+  const f = fixture(t);\n+  writeClaudeSettings(f.root, {\n+    UserPromptSubmit: [{\n+      hooks: [{ type: 'command', command: `echo node ${CLAUDE_MARKER}` }],\n+    }],\n+  });\n+  const result = f.run();\n+  assert.equal(result.code, 1);\n+  assert.match(result.out, /^hook-missing claude \\.claude\\/settings\\.json$/m);\n+});\n+\n+test('names a runtime whose entry only echoes the script path', (t) => {\n+  const f = fixture(t);\n+  writeClaudeSettings(f.root, {\n+    UserPromptSubmit: [{\n+      hooks: [{ type: 'command', command: 'echo hooks/claude/user-prompt-submit.js' }],\n+    }],\n+  });\n+  const result = f.run();\n+  assert.equal(result.code, 1);\n+  assert.match(result.out, /^hook-missing claude \\.claude\\/settings\\.json$/m);\n+});\n+\n+test('names a runtime whose entry only describes the script', (t) => {\n+  const f = fixture(t);\n+  writeClaudeSettings(f.root, {\n+    UserPromptSubmit: [{\n+      hooks: [{\n+        type: 'command',\n+        command: 'node some-other-hook.js',\n+        description: 'hooks/claude/user-prompt-submit.js',\n+      }],\n+    }],\n+  });\n+  const result = f.run();\n+  assert.equal(result.code, 1);\n+  assert.match(result.out, /^hook-missing claude \\.claude\\/settings\\.json$/m);\n+});\n+\n test('skips a runtime whose folder is absent', (t) => {\n   const f = fixture(t);\n   const text = f.run();\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"git diff 320e7b64d4..HEAD -- .skilled/commands/doctor/scripts/tests/hook-wiring-check.test.cjs .skilled/commands/doctor/scripts/tests/codex-hook-approval-check.test.cjs | head -220\"}"},"time":{"start":1794570395196,"end":1794570395790}}}}
