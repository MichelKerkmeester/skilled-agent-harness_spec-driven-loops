y) => entry.heading !== null)\n698:     .sort((left, right) => left.byte_start - right.byte_start);\n699:   for (const entry of unmarked) {\n700:     const text = chunkText(oldBuffer.subarray(entry.byte_start, entry.byte_end).toString('utf8'));\n701:     if (text === '') continue;\n702:     chunks.push({ kind: 'unmarked', id: entry.heading, text, lines: lineCount(text) });\n703:   }\n704: \n705:   // (c) The local lines of a section somebody edited, each under its own id.\n706:   const edited = rowOf(report, 'A4').entries.filter((entry) => entry.state === 'edited' || entry.state === 'unknown-base');\n707:   for (const entry of edited) {\n708:     const section = oldSections.find((candidate) => candidate.id === entry.id);\n709:     if (!section) continue;\n710:     const shippedBody = manifest.derived.sections[entry.id] ? manifest.derived.sections[entry.id].body : '';\n711:     const lines = localLinesOf(section.body, shippedBody);\n712:     if (lines.length === 0) continue;\n713:     chunks.push({\n714:       kind: 'edited',\n715:       id: entry.id,\n716:       lines: lines.length,\n717:       text: [`### Carried from ${entry.id}`, ...lines].join('\\n'),\n718:     });\n719: \n720:     // A clean merge would leave the section edited forever, so it is offered as a reading\n721:     // of the same bytes and never as the default.\n722:     const base = historyBodyOf(manifest, entry.base);\n723:     if (base !== null) {\n724:       const merged = classifyFile(fileState(base), fileState(section.body), fileState(shippedBody));\n725:       if (merged.conflictKind === 'mergeable') {\n726:         notes.push(`merge: ${entry.id} could be merged in place against its released body; adopt-and-carry is still the default, because a merged section stays edited for every later release`);\n727:       }\n728:     }\n729:   }\n730: \n731:   // (d) The unique lines of a runtime copy that is folded away.\n732:   const copies = rowOf(report, 'A10').entries.filter((entry) => FOLDED_COPIES.includes(entry.path));\n733:   const removedCopies = [];\n734:   for (const copy of copies) {\n735:     const absolute = path.join(root, copy.path);\n736:     if (!fs.existsSync(absolute) || isSymlink(absolute)) continue;\n737:     if (copy.state !== 'FINDING') continue;\n738:     const content = fs.readFileSync(absolute, 'utf8');\n739:     // With no root document every line of the copy is its own, and the count has to survive:\n740:     // the proof compares occurrences, not membership, so a repeated line stays repeated.\n741:     const lines = localLinesOf(content, oldText === null ? '' : oldText);\n742:     if (lines.length > 0) {\n743:       chunks.push({\n744:         kind: 'copy',\n745:         path: copy.path,\n746:         lines: lines.length,\n747:         text: [`### Carried from ${copy.path}`, ...lines].join('\\n'),\n748:       });\n749:     }\n750:     removedCopies.push({ path: copy.path, content });\n751:     if (copy.path === 'CLAUDE.md' && keepClaudeMd) {\n752:       removedCopies.pop();\n753:       if (lines.length > 0) {\n754:         notes.push(`claude: ${copy.path} carries lines no other file has; they moved into the block and the file stays because --keep-claude-md was given`);\n755:       }\n756:     }\n757:   }\n758: \n759:   const blockText = chunks.map((chunk) => chunkText(chunk.text)).filter((text) => text !== '').join('\\n\\n');\n760:   const composed = `${shipped}${renderBlock(markers, blockText)}`;\n761: \n762:   // The template with nothing of the repository's own in it gains nothing from the two\n763:   // marker lines, so that difference alone is not a reason to write: the markers appear\n764:   // with the first line worth keeping.\n765:   const templateOnly = oldText !== null && block === null && blockText === '' && oldText === shipped;\n766:   if (templateOnly) {\n767:     notes.push(`block: the template is already current and this repository carries nothing of its own, so no empty block is written`);\n768:   }\n769: \n770:   const files = [];\n771:   if (templateOnly || oldText === composed) {\n772:     files.push({ path: rootFile, action: 'unchanged', content: null, before: oldText });\n773:   } else {\n774:     files.push({\n775:       path: rootFile,\n776:       action: oldText === null ? 'create' : 'replace',\n777:       content: composed,\n778:       before: oldText,\n779:     });\n780:   }\n781: \n782:   // The router gains the shipped rows it is missing, or is created from them when asked.\n783:   const routerPath = path.join(root, manifest.router_file);\n784:   let routerAction = 'unchanged';\n785:   let routerText = null;\n786:   if (fs.existsSync(routerPath)) {\n787:     const current = fs.readFileSync(routerPath, 'utf8');\n788:     const result = addRouterRows(current, manifest);\n789:     notes.push(...result.notes);\n790:     if (result.text !== current) {\n791:       routerText = result.text;\n792:       routerAction = 'replace';\n793:       if (result.added.trigger > 0 || result.added.index > 0) {\n794:         notes.push(`router: ${result.added.trigger} trigger row(s) and ${result.added.index} index row(s) added; no other row was touched`);\n795:       }\n796:     }\n797:   } else if (createRouter) {\n798:     routerText = renderRouter(manifest);\n799:     routerAction = 'create';\n800:   } else {\n801:     routerAction = 'absent';\n802:     notes.push(`router: no ${manifest.router_file}, so no repository rule can load; pass --create-router to create one from the shipped rows`);\n803:   }\n804:   files.push({ path: manifest.router_file, action: routerAction, content: routerText, before: fs.existsSync(routerPath) ? fs.readFileSync(routerPath, 'utf8') : null });\n805: \n806:   // The Cursor mirror exists exactly when the block carries something, because an empty\n807:   // block has nothing a runtime that cannot read past the prefix would miss.\n808:   const mirrorPath = path.join(root, MIRROR_FILE);\n809:   const mirrorExists = fs.existsSync(mirrorPath);\n810:   let mirrorAction = 'unchanged';\n811:   let mirrorText = null;\n812:   if (blockText !== '') {\n813:     mirrorText = renderMirror(markers, blockText);\n814:     if (!mirrorExists) mirrorAction = 'create';\n815:     else if (fs.readFileSync(mirrorPath, 'utf8') !== mirrorText) mirrorAction = 'replace';\n816:   } else if (mirrorExists) {\n817:     mirrorAction = 'remove';\n818:   }\n819:   // The router and the mirror are both decided by now, so the same refusal covers the two\n820:   // paths the root-document check above could not see yet.\n821:   for (const target of [\n822:     { path: manifest.router_file, action: routerAction },\n823:     { path: MIRROR_FILE, action: mirrorAction },\n824:   ]) {\n825:     if (!['create', 'replace', 'remove'].includes(target.action)) continue;\n826:     const absolute = path.join(root, target.path);\n827:     if (!isSymlink(absolute)) continue;\n828:     throw new PreconditionError(`${target.path} is a symlink to ${fs.readlinkSync(absolute)}, and writing through it would change the file it points at`);\n829:   }\n830:   if (mirrorAction !== 'unchanged') {\n831:     files.push({\n832:       path: MIRROR_FILE,\n833:       action: mirrorAction,\n834:       content: mirrorText,\n835:       before: mirrorExists ? fs.readFileSync(mirrorPath, 'utf8') : null,\n836:     });\n837:   }\n838: \n839:   for (const copy of removedCopies) {\n840:     if (copy.path === CLAUDE_POINTER_PATH) {\n841:       files.push({ path: copy.path, action: 'replace', content: claudePointer, before: copy.content });\n842:       continue;\n843:     }\n844:     files.push({ path: copy.path, action: 'remove', content: null, before: copy.content });\n845:   }\n846: \n847:   // Claude Code reads only CLAUDE.md, so the pointer is its one route to the root document.\n848:   const claudePath = path.join(root, CLAUDE_POINTER_PATH);\n849:   if (\n850:     files.some((file) => ['create', 'replace', 'remove'].includes(file.action))\n851:     && !fs.existsSync(claudePath)\n852:     && !isSymlink(claudePath)\n853:   ) {\n854:     files.push({ path: CLAUDE_POINTER_PATH, action: 'create', content: claudePointer, before: null });\n855:   }\n856: \n857:   const composition = {\n858:     root,\n859:     state: report.state,\n860:     report,\n861:     markers,\n862:     rootFile,\n863:     oldText,\n864:     composed,\n865:     block: { text: renderBlock(markers, blockText), body: blockText },\n866:     chunks,\n867:     removedCopies,\n868:     notes,\n869:     files,\n870:     budget: {\n871:       before: { prefix: prefixEndOf(oldText, manifest), total: oldText === null ? 0 : Buffer.byteLength(oldText, 'utf8') },\n872:       after: { prefix: prefixEndOf(composed, manifest), total: Buffer.byteLength(composed, 'utf8') },\n873:       limits: { prefix: manifest.budget.prefix_bytes, total: manifest.budget.max_bytes },\n874:     },\n875:     ledger: {\n876:       kept: chunks.filter((chunk) => ['block', 'preamble', 'unmarked', 'edited'].includes(chunk.kind)).reduce((sum, chunk) => sum + chunk.lines, 0),\n877:       carried: chunks.filter((chunk) => chunk.kind === 'copy').reduce((sum, chunk) => sum + chunk.lines, 0),\n878:       shippedReplaced: manifest.sections.length,\n879:       dropped: 0,\n880:     },\n881:   };\n882: \n883:   // What the run would put on disk, which is exactly the three actions a target can take.\n884:   composition.writes = composition.files.filter((file) => ['create', 'replace', 'remove'].includes(file.action));\n885:   return composition;\n886: }\n887: \n888: // ─────────────────────────────────────────────────────────────────────────────\n889: // 11. THE WRITE ALLOWLIST\n890: // ─────────────────────────────────────────────────────────────────────────────\n891: \n892: /**\n893:  * Resolve one path a run wants to touch, or refuse it.\n894:  *\n895:  * Containment is checked before membership, so a path that climbs out of the root is\n896:  * reported as what it is rather than as a missing allowlist entry.\n897:  *\n898:  * @param {string} root\n899:  * @param {string} relative\n900:  * @returns {string} the absolute path\n901:  */\n902: function assertWritable(root, relative) {\n903:   const base = path.resolve(root);\n904:   const normalized = String(relative).split(path.sep).join('/');\n905:   const absolute = path.resolve(base, normalized);\n906:   if (absolute !== path.join(base, normalized) || !absolute.startsWith(base + path.sep)) {\n907:     throw new AllowlistError(`${relative} resolves outside the target root ${base}`);\n908:   }\n909:   if (!ALLOWLIST.includes(normalized)) {\n910:     throw new AllowlistError(`${relative} is not on the write allowlist (${ALLOWLIST.join(', ')})`);\n911:   }\n912:   // Every path a run reaches must sit inside the root where the root really is, not only\n913:   // under its name: a link inside the tree can aim a legal-looking path at a file outside it.\n914:   const realBase = fs.realpathSync(base);\n915:   const realTarget = resolveThroughLinks(absolute);\n916:   if (realTarget !== realBase && !realTarget.startsWith(realBase + path.sep)) {\n917:     throw new AllowlistError(`${relative} resolves outside the target root ${realBase} through a link`);\n918:   }\n919:   return absolute;\n920: }\n921: \n922: // The real path of a path that may not exist yet: the nearest existing ancestor is resolved\n923: // and the rest of the name is appended to it.\n924: function resolveThroughLinks(absolute) {\n925:   try {\n926:     return fs.realpathSync(absolute);\n927:   } catch {\n928:     const parent = path.dirname(absolute);\n929:     if (parent === absolute) return absolute;\n930:     return path.join(resolveThroughLinks(parent), path.basename(absolute));\n931:   }\n932: }\n933: \n934: // ─────────────────────────────────────────────────────────────────────────────\n935: // 12. BACKUPS\n936: // ─────────────────────────────────────────────────────────────────────────────\n937: \n938: function utcStamp(date = new Date()) {\n939:   return date.toISOString().replace(/[-:]/gu, '').replace(/\\.\\d+Z$/u, 'Z');\n940: }\n941: \n942: /**\n943:  * The directory a plan's backup sits in, named after the plan digest.\n944:  *\n945:  * Named by the digest rather than by a clock reading because apply has to land exactly\n946:  * where the plan pointed and the digest is the only thing the operator carries across. The\n947:  * consequence is that a directory is a plan's own: a second plan of the same work finds it\n948:  * taken and moves to the next ordinal instead of writing beside it.\n949:  *\n950:  * @param {string} base\n951:  * @param {string} digest\n952:  * @returns {string}\n953:  */\n954: function backupDirectoryOf(base, digest) {\n955:   return path.join(base, digest.slice(0, BACKUP_NAME_CHARS));\n956: }\n957: \n958: /**\n959:  * Where a run's backup goes, without creating anything.\n960:  *\n961:  * The output directory is used only when git ignores it, because a backup inside a tracked\n962:  * path is a backup the next commit publishes. Everything else leaves the repository.\n963:  *\n964:  * @param {{root: string}} input\n965:  * @returns {{dir: string, fallback: boolean, reason: string}}\n966:  */\n967: function backupBase({ root }) {\n968:   const candidate = path.join(root, BACKUP_DIR);\n969:   // The question is the one the run depends on: would a plan directory under this one be\n970:   // published by the next commit? Asking about the base alone would miss a rule written as\n971:   // `.skilled/output/*`, which ignores the per-plan directories and not their parent, so\n972:   // the probe is a path of the same shape as the one the plan takes.\n973:   const probe = path.join(candidate, 'probe');\n974:   const ignored = spawnSync('git', ['-C', root, '-c', 'core.fsmonitor=false', 'check-ignore', '-q', probe], {\n975:     encoding: 'utf8',\n976:     timeout: TOOL_TIMEOUT_MS,\n977:   });\n978:   if (ignored.status === 0) return { dir: candidate, fallback: false, reason: '' };\n979:   const reason = ignored.status === 1\n980:     ? `git does not ignore ${BACKUP_DIR} under ${root}`\n981:     : `git cannot answer whether ${BACKUP_DIR} is ignored under ${root} (exit ${ignored.status})`;\n982:   return { dir: path.join(os.tmpdir(), BACKUP_FALLBACK_DIR), fallback: true, reason };\n983: }\n984: \n985: /**\n986:  * The plan a run stands on: the composition, plus where its backup goes and the digest\n987:  * that says both.\n988:  *\n989:  * The loop is what makes a re-plan honest. A directory an earlier run already holds is not\n990:  * suffixed into a second name, because the printed undo command would then point at that\n991:  * run's bytes; the next ordinal is a different plan with a different digest and a\n992:  * directory of its own.\n993:  *\n994:  * @param {Object} composition\n995:  * @returns {{dir: string, fallback: boolean, reason: string, digest: string, ordinal: number, base: string}}\n996:  */\n997: function planFor(composition) {\n998:   const base = backupBase({ root: composition.root });\n999:   for (let ordinal = 0; ordinal < BACKUP_ATTEMPTS; ordinal += 1) {\n1000:     const digest = planDigest(composition, { ordinal, base: base.dir });\n1001:     const dir = backupDirectoryOf(base.dir, digest);\n1002:     if (!fs.existsSync(dir)) return { dir, fallback: base.fallback, reason: base.reason, digest, ordinal, base: base.dir };\n1003:   }\n1004:   throw new PreconditionError(`every backup directory for this composition under ${base.dir} is taken, so nothing was written`);\n1005: }\n1006: \n1007: // The folders a new file needs that do not exist yet, deepest first. A restore removes\n1008: // only these, so on a record the run wrote, a folder that was there before the run is never\n1009: // taken away with it.\n[Output truncated. Continue reading with offset: 1010]","title":"read","metadata":{"metadata":{"truncated":true},"content":[{"type":"text","text":"Read file .skilled/commands/doctor/scripts/agents-md-embed.cjs, lines 670-1009\n670:     : segment(oldText, markers, manife