/agents-md-check.cjs:676-713\",\"result\":\"symlink branch returns PASS before expectsAbsent is read\"}],\"targetRefs\":[\".skilled/commands/doctor/scripts/agents-md-check.cjs\"]},{\"bugClass\":\"misleading_evidence\",\"dimension\":\"correctness\",\"disposition\":\"finding\",\"hypothesis\":\"a printed detail claims more than the condition proves\",\"id\":\"SL-003\",\"linkedFindingId\":\"DR1-P2-002\",\"rationale\":\"operator-facing evidence overstates the check\",\"searchActions\":[{\"evidenceRefs\":[\".skilled/commands/doctor/scripts/agents-md-check.cjs:731\"],\"method\":\"direct_read\",\"queryOrPath\":\".skilled/commands/doctor/scripts/agents-md-check.cjs:727-733\",\"result\":\"namesRoot uses some, detail says every line\"}],\"targetRefs\":[\".skilled/commands/doctor/scripts/agents-md-check.cjs\"]},{\"bugClass\":\"partial_write\",\"dimension\":\"correctness\",\"disposition\":\"finding\",\"hypothesis\":\"a mutating run can stop between targets without restoring\",\"id\":\"SL-004\",\"linkedFindingId\":\"DR1-P1-001\",\"rationale\":\"half-applied instruction files with no printed undo\",\"searchActions\":[{\"evidenceRefs\":[\".skilled/commands/doctor/scripts/agents-md-embed.cjs:1395\"],\"method\":\"direct_read\",\"queryOrPath\":\".skilled/commands/doctor/scripts/agents-md-embed.cjs:1364-1413\",\"result\":\"rollback is reachable only after the whole write loop returns\"}],\"targetRefs\":[\".skilled/commands/doctor/scripts/agents-md-embed.cjs\"]},{\"bugClass\":\"proof_contract\",\"dimension\":\"correctness\",\"disposition\":\"finding\",\"hypothesis\":\"a proof output is computed but never consumed\",\"id\":\"SL-005\",\"linkedFindingId\":\"DR1-P2-003\",\"rationale\":\"the documented fourth claim cannot fail a run\",\"searchActions\":[{\"evidenceRefs\":[\".skilled/commands/doctor/scripts/agents-md-embed.cjs:598\"],\"method\":\"direct_read\",\"queryOrPath\":\".skilled/commands/doctor/scripts/agents-md-embed.cjs:598-1401\",\"result\":\"foreign is returned and never read by p