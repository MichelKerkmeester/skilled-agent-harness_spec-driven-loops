s:\n1053:                   - pivot_seat_003_dispatch_status: \"fulfilled or rejected\"\n1054:                   - pivot_seat_003_output_json: \"Raw native return serialized as JSON when fulfilled\"\n1055:                   - pivot_seat_003_error_json: \"{name,message} when rejected\"\n1056:                   - pivot_seat_003_started_at_iso: \"Dispatch start timestamp\"\n1057:                   - pivot_seat_003_completed_at_iso: \"Dispatch completion timestamp\"\n1058:                   - pivot_seat_003_duration_ms: \"Dispatch duration in milliseconds\"\n1059: \n1060:               step_record_pivot_seat_003:\n1061:                 action: \"Durably record the seat-003 native dispatch outcome\"\n1062:                 skip_when: \"pivot_prepare_status != 'pending' or pivot_missing_seat_ids does not contain 'seat-003'\"\n1063:                 command: |\n1064:                   node --import \"$(node -p \"require.resolve('tsx', { paths: ['.skilled/skills/system-deep-loop/runtime'] })\")\" --input-type=module <<'EOF'\n1065:                   import { recordPivotSeatResult } from './.skilled/skills/system-deep-loop/runtime/lib/deep-loop/divergent-pivot.ts';\n1066:                   const status = '{pivot_seat_003_dispatch_status}';\n1067:                   const outcome = status === 'fulfilled'\n1068:                     ? { status, output: {pivot_seat_003_output_json}, startedAtIso: '{pivot_seat_003_started_at_iso}', completedAtIso: '{pivot_seat_003_completed_at_iso}', durationMs: Number('{pivot_seat_003_duration_ms}') }\n1069:                     : { status: 'rejected', error: {pivot_seat_003_error_json}, startedAtIso: '{pivot_seat_003_started_at_iso}', completedAtIso: '{pivot_seat_003_completed_at_iso}', durationMs: Number('{pivot_seat_003_duration_ms}') };\n1070:                   process.stdout.write(`${JSON.stringify(recordPivotSeatResult({ paths: {pivot_paths_json}, pivotId: '{pivot_id}', seat: {pivot_seat_003_json}, outcome }))}\\n`);\n1071:                   EOF\n1072:                 working_directory: \"{repo_root}\"\n1073: \n1074:               step_finalize_divergent_pivot:\n1075:                 action: \"Finalize the prepared pivot after all missing native seats are durable\"\n1076:                 skip_when: \"pivot_prepare_status != 'pending'\"\n1077:                 command: |\n1078:                   node --import \"$(node -p \"require.resolve('tsx', { paths: ['.skilled/skills/system-deep-loop/runtime'] })\")\" --input-type=module <<'EOF'\n1079:                   import { finalizePivotTransaction } from './.skilled/skills/system-deep-loop/runtime/lib/deep-loop/divergent-pivot.ts';\n1080:                   process.stdout.write(`${JSON.stringify(finalizePivotTransaction({ paths: {pivot_paths_json}, pivotId: '{pivot_id}', resumed: {pivot_resumed} }))}\\n`);\n1081:                   EOF\n1082:                 working_directory: \"{repo_root}\"\n1083:                 outputs:\n1084:                   - pivot_finalize_json: \"The complete parsed final result\"\n1085: \n1086:               step_resolve_divergent_pivot_result:\n1087:                 action: \"Use prepare's terminal result on resume/short-circuit, otherwise use finalize's result\"\n1088:                 branch_on: \"pivot_prepare_status\"\n1089:                 if_pending: { bind: { pivot_result: \"{pivot_finalize_json}\" } }\n1090:                 if_completed_or_failed: { bind: { pivot_result: \"{pivot_prepare_json}\" } }\n1091: \n1092:               step_apply_divergent_pivot_result:\n1093:                 action: \"Adopt a successful read-only review direction or fail closed to the existing synthesis path\"\n1094:                 branch_on: \"pivot_result.status\"\n1095:                 if_completed:\n1096:                   set:\n1097:                     next_dimension: \"{pivot_result.restoredFocus}\"\n1098:                     pivot_lineage: \"Pivot {pivot_result.pivotId} selected {pivot_result.selectedCandidate.id} from source iteration {current_iteration}.\"\n1099:                     saturated_directions: \"{pivot_result.completedEvent.saturatedDirections}\"\n1100:                   command: \"node .skilled/skills/system-deep-loop/runtime/scripts/reduce-state.cjs {spec_folder} {reducer_artifact_arg} --create-missing-anchors\"\n1101:                   log: \"Divergent review pivot {pivot_result.pivotId} restored focus to {pivot_result.restoredFocus}; continuing iteration {current_iteration}.\"\n1102:                   proceed_to: step_normalize_pause_events\n1103:                 if_failed:\n1104:                   log: \"Divergent review pivot {pivot_result.pivotId} failed closed ({pivot_result.failureReason}); proceeding to synthesis.\"\n1105:                   skip_to: phase_synthesis\n1106:             on_error:\n1107:               log: \"Divergent review pivot integration error; failing closed to the existing synthesis path.\"\n1108:               skip_to: phase_synthesis\n1109:           if_existing_terminal_path:\n1110:             log: \"Loop stopping. Reason: {reason}\"\n1111:             skip_to: phase_synthesis\n1112:         if_blocked:\n1113:           log: \"Legal-stop gates blocked STOP. Failed gates: {blocked_by_csv}. Continuing review.\"\n1114:         if_stuck_recovery:\n1115:           log: \"Stuck detected ({stuck_count} consecutive no-progress). Entering recovery.\"\n1116:           recovery_strategies:\n1117:             - \"Change granularity: file-level → function-level → line-level review\"\n1118:             - \"Traceability protocol replay: re-run unresolved core or overlay checks\"\n1119:             - \"Escalate severity review: re-examine P2 findings for potential P1 upgrades\"\n1120:           pivot_target: \"Pivot to the least-covered dimension (the review dimension with the fewest iteration passes and lowest coverage ratio).\"\n1121:           set:\n1122:             next_dimension: \"RECOVERY: {recovery_strategy}. Least-covered dimension: {least_explored}\"\n1123:             pending_stop_event: \"stuck_recovery\"\n1124:             pending_stop_reason: \"stuckRecovery\"\n1125:             pending_stop_detail: \"Recovery path activated after repeated no-progress iterations\"\n1126:           reset: { stuck_count: 0 }\n1127:         if_continue:\n1128:           log: \"Iteration {current_iteration}: Continuing. Dimension: {next_dimension}\"\n1129: \n1130:       step_normalize_pause_events:\n1131:         action: \"Rewrite raw pause and recovery events to the frozen STOP_REASONS enum at emission time: converged, maxIterationsReached, blockedStop, stuckRecovery, error, manualStop, userPaused\"\n1132:         if_pending_pause_event:\n1133:           append_jsonl: '{\"stem\":\"deep_review.pause_recorded\",\"scope\":{\"runId\":\"{session_id}\",\"sessionId\":\"{session_id}\",\"generation\":{generation},\"iterationId\":\"iteration-{current_iteration}\"},\"data\":{\"normalizedStopReason\":\"userPaused\",\"sentinelCause\":\"sentinel-file-detected\",\"fromIterationId\":\"iteration-{current_iteration}\",\"strategy\":\"await-operator-resume\",\"targetDimensionId\":\"{next_dimension}\",\"outcome\":\"paused\",\"lineageRef\":\"{session_id}\",\"priorTailDigest\":\"{prior_tail_digest}\"}}'\n1134:           message: \"Review paused. Delete review/.deep-review-pause to resume.\"\n1135:           reset:\n1136:             pending_stop_event: null\n1137:             pending_stop_reason: null\n1138:             pending_stop_detail: null\n1139:           halt: true\n1140:         if_pending_stuck_recovery:\n1141:           append_jsonl: '{\"stem\":\"deep_review.recovery_started\",\"scope\":{\"runId\":\"{session_id}\",\"sessionId\":\"{session_id}\",\"generation\":{generation},\"iterationId\":\"iteration-{current_iteration}\",\"dimensionId\":\"{least_explored}\"},\"data\":{\"normalizedStopReason\":\"stuckRecovery\",\"recoveryCause\":\"repeated-no-progress\",\"fromIterationId\":\"iteration-{current_iteration}\",\"strategy\":\"{recovery_strategy_code}\",\"targetDimensionId\":\"{least_explored}\",\"outcome\":\"recovery-started\",\"lineageRef\":\"{session_id}\",\"priorTailDigest\":\"{prior_tail_digest}\",\"originatingPauseEventId\":\"none\"}}'\n1142:           reset:\n1143:             pending_stop_event: null\n1144:             pending_stop_reason: null\n1145:             pending_stop_detail: null\n1146:         if_no_pending_event:\n1147:           proceed: true\n1148:         outputs:\n1149:           - prior_tail_digest: \"sha256 (64 lowercase hex) of the state log bytes at the moment the pause or recovery row is emitted\"\n1150: \n1151:       step_generate_state_summary:\n1152:         action: \"Generate compact state summary for dispatch context (~200 tokens)\"\n1153:         generate: |\n1154:           STATE SUMMARY (auto-generated):\n1155:           Iteration: {current_iteration} of {max_iterations}\n1156:           Dimension: {next_dimension}\n1157:           Prior Findings: P0={p0_count} P1={p1_count} P2={p2_count}\n1158:           Dimension Coverage: {dimensions_covered_list} ({dimension_coverage})\n1159:           Traceability: core={core_protocol_status} overlay={overlay_protocol_status}\n1160:           {resource_map_prompt_line}\n1161:           Coverage Age: {coverage_age}\n1162:           Last 2 ratios: {ratio_prev} -> {ratio_latest}\n1163:           Stuck count: {stuck_count}\n1164:           Provisional Verdict: {PASS|CONDITIONAL|FAIL|PENDING} hasAdvisories={has_advisories}\n1165: \n1166:       step_marker_scan:\n1167:         action: \"H-2 loop-prevention guard: scan previous iteration's rendered prompt for nested review marker\"\n1168:         canonical_header: \"DEEP-REVIEW\"\n1169:         nested_marker_pattern: \"^(DEEP-RESEARCH|CODE-REVIEW)$\"\n1170:         algorithm: |\n1171:           if current_iteration > 1:\n1172:             PREV_PROMPT_PATH = \"{state_paths.prompt_dir}/iteration-{previous_iteration}.md\"\n1173:             if file_exists(PREV_PROMPT_PATH):\n1174:               PREV_PROMPT_FIRST_LINE = head -1 of PREV_PROMPT_PATH\n1175:               if PREV_PROMPT_FIRST_LINE matches nested_marker_pattern:\n1176:                 log \"ERROR: nested review loop detected (foreign deep-loop marker found in previous iteration prompt). Aborting.\"\n1177:                 halt with exit code 2\n1178:         note: |\n1179:           False-positive prevention: a review prompt that starts with its own canonical\n1180:           header is this loop's own iteration output, never a nested dispatch; only a\n1181:           foreign marker (DEEP-RESEARCH or CODE-REVIEW) is, so the guard matches\n1182:           nested_marker_pattern rather than the canonical header. Markers appearing in\n1183:           comments or body text are ignored. True-positive triggers only when a previous\n1184:           iteration's rendered prompt literally starts with a foreign deep-loop marker,\n1185:           indicating a nested review dispatch.\n1186: \n1187:       step_dispatch_iteration:\n1188:         action: \"Dispatch @deep-review agent for one review iteration\"\n1189:         resolve_executor:\n1190:           source: \"config.executor\"\n1191:           loader: \".skilled/skills/system-deep-loop/runtime/lib/deep-loop/executor-config.ts#parseExecutorConfig\"\n1192:         pre_dispatch:\n1193:           generate_summary: |\n1194:             STATE SUMMARY (auto-generated):\n1195:             Iteration: {current_iteration} of {max_iterations}\n1196:             Dimension: {next_dimension}\n1197:             Prior Findings: P0={p0_count} P1={p1_count} P2={p2_count}\n1198:             Dimension Coverage: {dimensions_covered_list} ({dimension_coverage})\n1199:             Traceability: core={core_protocol_status} overlay={overlay_protocol_status}\n[Output truncated. Continue reading with offset: 1200]"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"limit\":540,\"offset\":660,\"path\":\".skilled/commands/deep/assets/deep-review-auto.yaml\"}"