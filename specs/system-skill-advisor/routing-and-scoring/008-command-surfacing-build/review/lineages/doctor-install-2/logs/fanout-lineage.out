\\"command\\\":\\\"bash -lc \\\\\\\"node .claude/hooks/claude/user-prompt-submit.js\\\\\\\"\\\"}]}]}}' > \\\"$TMP/.claude/settings.json\\\"; node .skilled/commands/doctor/scripts/hook-wiring-check.cjs --root \\\"$TMP\\\"; echo \\\"exit=$?\\\"; rm -rf \\\"$TMP\\\"\"}"},"time":{"start":1794570838972,"end":1794570840662}}}}
