{"type":"tool_use","timestamp":1794570576254,"sessionID":"ses_e2b4a18a6ffeJYEGLs0dTSiOZ0","part":{"partID":"prt_1d4bddefc001ol9rGP3AWooiPH","sessionID":"ses_e2b4a18a6ffeJYEGLs0dTSiOZ0","messageID":"msg_1d4bd8149001Lb5Q1111lsF3rO","type":"tool","id":"call_2b9cffcec84542e092dcd976","tool":"read","state":{"status":"completed","input":{"path":".skilled/commands/doctor/assets/doctor-symlink-check.yaml"},"output":"Read file .skilled/commands/doctor/assets/doctor-symlink-check.yaml, lines 1-72\n1: # ─────────────────────────────────────────────────────────────────\n2: # DOCTOR: SYMLINK CHECK (READ-ONLY DIAGNOSTIC)\n3: # ─────────────────────────────────────────────────────────────────\n4: role: Diagnostic Operator reporting the link state of one target repository against the Skilled manifest\n5: purpose: Report the status of the core link, selected runtimes and extras by running the check engine once, then render its report through the presentation contract\n6: action: Run the check engine once -> render its report through the presentation contract\n7: skill_owner: \".skilled/skills/system-skilled-doctor/\"\n8: \n9: # ─────────────────────────────────────────────────────────────────\n10: # OPERATING MODE\n11: # ─────────────────────────────────────────────────────────────────\n12: operating_mode:\n13:   workflow: single_step_check\n14:   compliance: MANDATORY\n15:   execution: read_only\n16:   approvals: none\n17:   tracking: single_run\n18:   validation: read_only_assertion\n19: \n20: # ─────────────────────────────────────────────────────────────────\n21: # MUTATION BOUNDARIES (READ-ONLY)\n22: # ─────────────────────────────────────────────────────────────────\n23: mutation_boundaries:\n24:   read_only: true\n25:   allowed_targets: []\n26:   forbidden_targets:\n27:     - \"**/*\"\n28:   invariant: \"This route runs the check subcommand only. It never runs plan, apply or unlink, and it never writes a link, directory, ignore line or run record. Findings describe the target repository and do not change its state. The route also runs the read-only hook-wiring check, which reads each installed runtime's prompt hook entry and never writes.\"\n29: \n30: # ─────────────────────────────────────────────────────────────────\n31: # UPSTREAM ASSETS\n32: # ─────────────────────────────────────────────────────────────────\n33: upstream_assets:\n34:   engine: \".skilled/commands/doctor/scripts/symlink-engine.cjs\"\n35:   manifest: \".skilled/commands/doctor/assets/symlink-manifest.json\"\n36:   presentation: \".skilled/commands/doctor/assets/doctor-symlink-presentation.txt\"\n37:   hook_wiring: \".skilled/commands/doctor/scripts/hook-wiring-check.cjs\"\n38: \n39: # ─────────────────────────────────────────────────────────────────\n40: # INPUTS\n41: # ─────────────────────────────────────────────────────────────────\n42: inputs:\n43:   execution_mode: \"INTERACTIVE\"\n44:   root: \"Required target project repository, passed as --root <dir>. The engine requires it to exist and be a directory.\"\n45:   runtimes: \"Optional comma-separated runtime names, passed as --runtimes <list> when supplied: claude,opencode,codex,cursor,devin,pi. When omitted, the engine selects runtimes whose primary entry already exists in the target root. The core entry is always included.\"\n46:   include: \"Optional comma-separated extras, passed as --include <list> when supplied: repo-rules,github,utcp,env.\"\n47:   link_instructions: \"When true, pass --link-instructions to include AGENTS.md, CLAUDE.md and REPO RULES.md.\"\n48:   json_output: \"When true, pass --json and show only the engine's JSON object. The default is false.\"\n49:   target: \"The route accepts the check action. A missing --root value or any unsupported flag is refused by the engine.\"\n50: \n51: # ─────────────────────────────────────────────────────────────────\n52: # EXECUTION\n53: # ─────────────────────────────────────────────────────────────────\n54: execution:\n55:   steps:\n56:     - \"Check that .skilled/commands/doctor/scripts/symlink-engine.cjs, .skilled/commands/doctor/assets/symlink-manifest.json and .skilled/commands/doctor/assets/doctor-symlink-presentation.txt exist. If one is missing, report its path and stop with STATUS=FAIL. Do not create the presentation file here.\"\n57:     - 'Run node .skilled/commands/doctor/scripts/symlink-engine.cjs check --root \"{root}\", adding --runtimes \"{runtimes}\" when supplied, --include \"{include}\" when supplied, --link-instructions when requested and --json when requested.'\n58:     - \"The engine reports one status for each selected manifest entry, with detail lines for missing children, broken links and local conflicts. It also reports detected runtimes, tracked absolute links, Git state and applicable warnings.\"\n59:     - \"Exit 0 means no drift was found. Exit 1 means drift was found: broken links, foreign links, broken links inside merged folders, a missing source, or tracked absolute links. Missing children in a partial merge do not count as drift. Show the report and end with STATUS=WARN. Exit 2 means the invocation or target root was refused. Quote the engine message and end with STATUS=FAIL.\"\n60:     - 'After the engine report, run node .skilled/commands/doctor/scripts/hook-wiring-check.cjs --root \"{root}\" to read the prompt hook entry each installed runtime loads. It skips a runtime whose folder is absent. Show every hook-missing <runtime> line as printed. Exit 0 leaves the status unchanged. Exit 1 ends the run with STATUS=WARN and names the repair: copy the prompt hook entry from the matching file in the Skilled checkout into the target file for that runtime. Exit 2 means the check was refused: quote its message and end with STATUS=FAIL.'\n61:     - \"Render the engine output through .skilled/commands/doctor/assets/doctor-symlink-presentation.txt. When --json was requested, print the engine's JSON object alone.\"\n62: \n63: # ─────────────────────────────────────────────────────────────────\n64: # OUTPUT\n65: # ─────────────────────────────────────────────────────────────────\n66: output: |\n67:   STATUS=OK when the engine exits 0. Show the check report through the presentation contract.\n68:   STATUS=WARN when the engine exits 1. Show the check report through the presentation contract.\n69:   STATUS=WARN when the engine exits 0 and the hook-wiring check exits 1. Show each hook-missing line and the repair the step names.\n70:   STATUS=FAIL when the engine exits 2 or cannot run. Name the accepted invocation (/doctor:symlink check --root <dir> [flags]) and quote the engine message.\n71:   STATUS=FAIL when the hook-wiring check exits 2. Quote its message.\n72:   When the engine and the hook-wiring check end on different statuses, the worse one wins: FAIL over WARN over OK.","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file .skilled/commands/doctor/assets/doctor-symlink-check.yaml, lines 1-72\n1: # ─────────────────────────────────────────────────────────────────\n2: # DOCTOR: SYMLINK CHECK (READ-ONLY DIAGNOSTIC)\n3: # ─────────────────────────────────────────────────────────────────\n4: role: Diagnostic Operator reporting the link state of one target repository against the Skilled manifest\n5: purpose: Report the status of the core link, selected runtimes and extras by running the check engine once, then render its report through the presentation contract\n6: action: Run the check engine once -> render its report through the presentation contract\n7: skill_owner: \".skilled/skills/system-skilled-doctor/\"\n8: \n9: # ─────────────────────────────────────────────────────────────────\n10: # OPERATING MODE\n11: # ─────────────────────────────────────────────────────────────────\n12: operating_mode:\n13:   workflow: single_step_check\n14:   compliance: MANDATORY\n15:   execution: read_only\n16:   approvals: none\n17:   tracking: single_run\n18:   validation: read_only_assertion\n19: \n20: # ─────────────────────────────────────────────────────────────────\n21: # MUTATION BOUNDARIES (READ-ONLY)\n22: # ─────────────────────────────────────────────────────────────────\n23: mutation_boundaries:\n24:   read_only: true\n25:   allowed_targets: []\n26:   forbidden_targets:\n27:     - \"**/*\"\n28:   invariant: \"This route runs the check subcommand only. It never runs plan, apply or unlink, and it never writes a link, directory, ignore line or run record. Findings describe the target repository and do not change its state. The route also runs the read-only hook-wiring check, which reads each installed runtime's prompt hook entry and never writes.\"\n29: \n30: # ─────────────────────────────────────────────────────────────────\n31: # UPSTREAM ASSETS\n32: # ─────────────────────────────────────────────────────────────────\n33: upstream_assets:\n34:   engine: \".skilled/commands/doctor/scripts/symlink-engine.cjs\"\n35:   manifest: \".skilled/commands/doctor/assets/symlink-manifest.json\"\n36:   presentation: \".skilled/commands/doctor/assets/doctor-symlink-presentation.txt\"\n37:   hook_wiring: \".skilled/commands/doctor/scripts/hook-wiring-check.cjs\"\n38: \n39: # ─────────────────────────────────────────────────────────────────\n40: # INPUTS\n41: # ─────────────────────────────────────────────────────────────────\n42: inputs:\n43:   execution_mode: \"INTERACTIVE\"\n44:   root: \"Required target project repository, passed as --root <dir>. The engine requires it to exist and be a directory.\"\n45:   runtimes: \"Optional comma-separated runtime names, passed as --runtimes <list> when supplied: claude,opencode,codex,cursor,devin,pi. When omitted, the engine selects runtimes whose primary entry already exists in the target root. The core entry is always included.\"\n46:   include: \"Optional comma-separated extras, passed as --include <list> when supplied: repo-rules,github,utcp,env.\"\n47:   link_instructions: \"When true, pass --link-instructions to include AGENTS.md, CLAUDE.md and REPO RULES.md.\"\n48:   json_output: \"When true, pass --json and show only the engine's JSON object. The default is false.\"\n49:   target: \"The route accepts the check action. A missing --root value or any unsupported flag is refused by the engine.\"\n50: \n51: # ─────────────────────────────────────────────────────────────────\n52: # EXECUTION\n53: # ─────────────────────────────────────────────────────────────────\n54: execution:\n55:   steps:\n56:     - \"Check that .skilled/commands/doctor/scripts/symlink-engine.cjs, .skilled/commands/doctor/assets/symlink-manifest.json and .skilled/commands/doctor/assets/doctor-symlink-presentation.txt exist. If one is missing, report its path and stop with STATUS=FAIL. Do not create the presentation file here.\"\n57:     - 'Run node .skilled/commands/doctor/scripts/symlink-engine.cjs check --root \"{root}\", adding --runtimes \"{runtimes}\" when supplied, --include \"{include}\" when supplied, --link-instructions when requested and --json when requested.'\n58:     - \"The engine reports one status for each selected manifest entry, with detail lines for missing children, broken links and local conflicts. It also reports detected runtimes, tracked absolute links, Git state and applicable warnings.\"\n59:     - \"Exit 0 means no drift was found. Exit 1 means drift was found: broken links, foreign links, broken links inside merged folders, a missing source, or tracked absolute links. Missing children in a partial merge do not count as drift. Show the report and end with STATUS=WARN. Exit 2 means the invocation or target root was refused. Quote the engine message and end with STATUS=FAIL.\"\n60:     - 'After the engine report, run node .skilled/commands/doctor/scripts/hook-wiring-check.cjs --root \"{root}\" to read the prompt hook entry each installed runtime loads. It skips a runtime whose folder is absent. Show every hook-missing <runtime> line as printed. Exit 0 leaves the status unchanged. Exit 1 ends the run with STATUS=WARN and names the repair: copy the prompt hook entry from the matching file in the Skilled checkout into the target file for that runtime. Exit 2 means the check was refused: quote its message and end with STATUS=FAIL.'\n61:     - \"Render the engine output through .skilled/commands/doctor/assets/doctor-symlink-presentation.txt. When --json was requested, print the engine's JSON object alone.\"\n62: \n63: # ─────────────────────────────────────────────────────────────────\n64: # OUTPUT\n65: # ─────────────────────────────────────────────────────────────────\n66: output: |\n67:   STATUS=OK when the engine exits 0. Show the check report through the presentation contract.\n68:   STATUS=WARN when the engine exits 1. Show the check report through the presentation contract.\n69:   STATUS=WARN when the engine exits 0 and the hook-wiring check exits 1. Show each hook-missing line and the repair the step names.\n70:   STATUS=FAIL when the engine exits 2 or cannot run. Name the accepted invocation (/doctor:symlink check --root <dir> [flags]) and quote the engine message.\n71:   STATUS=FAIL when the hook-wiring check exits 2. Quote its message.\n72:   When the engine and the hook-wiring check end on different statuses, the worse one wins: FAIL over WARN over OK."}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\".skilled/commands/doctor/assets/doctor-symlink-check.yaml\"}"},"time":{"start":1794570575612,"end":1794570576254}}}}
{"type":"tool_use","timestamp":1794570576270,"sessionID":"ses_e2b4a18a6ffeJYEGLs0dTSiOZ0","part":{"partID":"prt_1d4bddfdf001vaL1O5atpgb4ie","sessionID":"ses_e2b4a18a6ffeJYEGLs0dTSiOZ0","messageID":"msg_1d4bd8149001Lb5Q1111lsF3rO","type":"tool","id":"call_d93582364db24c248d8d20dc","tool":"shell","state":{"status":"completed","input":{"command":"sed -n '150,180p' .skilled/commands/doctor/assets/doctor-runtime-mirrors.yaml; sed -n '45,75p' .skilled/commands/doctor/assets/doctor-setup.yaml"},"output":"    - 'Run upstream_assets.codex_hook_approval with --root \"$PWD\". Covers the Codex approval that lets the project advisor hook run at all, since Codex skips an unapproved entry without a warning. PASS = in sync. WARN sets STATUS to WARN and shows the repair line it prints without counting as drift. SKIP leaves STATUS unchanged. Exit 0 = approved or no Codex hooks file, 1 = absent or unapproved, 2 = checker error.'\n    - \"Run upstream_assets.pi_agents with --check. Covers the generated .pi/agents/*.md. Exit 0 = in sync, 1 = drift.\"\n    - \"Run upstream_assets.pi_prompts with --check. Covers the generated .pi/prompts/*.md stubs. Exit 0 = in sync, 1 = drift.\"\n    - \"Run upstream_assets.dsh_skills, the command node .skilled/skills/system-spec-kit/runtime/cli/dsh/sync-skills-dsh.cjs --check. Covers the generated .dsh/skills/ links. When .dsh/ is absent, report the row as n/a (no .dsh/ tree) without running the check; an n/a row leaves STATUS unchanged, and this run never creates that directory. Exit 0 = in sync, 1 = drift.\"\n    - \"Run upstream_assets.dsh_prompts, the command node .skilled/skills/system-spec-kit/runtime/cli/dsh/sync-prompts-dsh.cjs --check. Covers the generated .dsh/prompts/*.md files. When .dsh/ is absent, report the row as n/a (no .dsh/ tree) without running the check; an n/a row leaves STATUS unchanged, and this run never creates that directory. Exit 0 = in sync, 1 = drift.\"\n    - \"Run upstream_assets.dsh_agents, the command node .skilled/skills/system-spec-kit/runtime/cli/dsh/sync-agents-dsh.cjs --check. Covers the generated .dsh/agents/*.patch.yml files. When .dsh/ is absent, report the row as n/a (no .dsh/ tree) without running the check; an n/a row leaves STATUS unchanged, and this run never creates that directory. Exit 0 = in sync, 1 = drift.\"\n    - \"For each row in hook_adapter_fallback_health_checks, run its file_exists check (a plain path-existence read, no execution of the adapter or the shell command that wraps it). Collect every row whose path does not resolve as a degraded hook adapter, keyed by host:event:path.\"\n    - \"Aggregate: report each surface with its own verdict rather than a single pass/fail, so the operator learns which mirror moved.\"\n\n# ─────────────────────────────────────────────────────────────────\n# OUTPUT\n# ─────────────────────────────────────────────────────────────────\noutput: |\n  STATUS=OK when every checker reports in sync, or n/a for a DSH row while its runtime tree is absent, and the\n  Codex hook approval check reports in sync or skip.\n  STATUS=WARN when the Codex hook approval check reports an unapproved or absent advisor entry and no checker\n  reports drift: show its lines, including the repair line it prints, without adding a drift surface.\n  STATUS=DRIFT when any checker reports drift, listing each drifting surface and the repair command for it:\n    runtime mirrors  -> node .skilled/skills/system-spec-kit/runtime/cli/runtime-mirrors/sync-runtime-mirrors.cjs\n    codex agents     -> node .skilled/skills/system-spec-kit/runtime/cli/codex/sync-agents.cjs\n    codex prompts    -> node .skilled/skills/system-spec-kit/runtime/cli/codex/sync-prompts.cjs\n    codex hooks      -> node .skilled/bin/install-codex-hooks.mjs\n    agent body parity (.skilled/bin/check-agent-mirror-sync.cjs) -> .claude/agents is a hand-maintained real-file mirror; update both its .skilled source and Claude twin, then run node .skilled/skills/system-spec-kit/runtime/cli/codex/sync-agents.cjs for .codex/agents, node .skilled/skills/system-spec-kit/runtime/cli/pi/sync-agents-pi.cjs for .pi/agents, and node .skilled/skills/system-spec-kit/runtime/cli/runtime-mirrors/sync-runtime-mirrors.cjs for the .cursor and .devin links\n    pi agents        -> node .skilled/skills/system-spec-kit/runtime/cli/pi/sync-agents-pi.cjs\n    pi prompts       -> node .skilled/skills/system-spec-kit/runtime/cli/pi/sync-prompts-pi.cjs\n    dsh skills       -> node .skilled/skills/system-spec-kit/runtime/cli/dsh/sync-skills-dsh.cjs\n    dsh prompts      -> node .skilled/skills/system-spec-kit/runtime/cli/dsh/sync-prompts-dsh.cjs\n    dsh agents       -> node .skilled/skills/system-spec-kit/runtime/cli/dsh/sync-agents-dsh.cjs\n    command catalog  -> update the root and family indexes, group counts, and hub metadata from command frontmatter\n  While .dsh/ is absent the three DSH rows read n/a (no .dsh/ tree), never in sync, and leave\n  STATUS unchanged: the mirror does not exist yet, and this run never creates it. Their repair lines are the generators without --check, run once the tree exists.\n# ─────────────────────────────────────────────────────────────────\ninputs:\n  target: \"The command takes no positional target and no flag. /doctor:setup alone runs it; anything else fails before this YAML loads.\"\n\n# ─────────────────────────────────────────────────────────────────\n# EXECUTION\n# ─────────────────────────────────────────────────────────────────\nexecution:\n  steps:\n    - \"Read .skilled/commands/doctor/_routes.yaml and print the doctor target list through the presentation contract. The presentation table owns the rows and their wording. It shows /doctor:ci as one row for its report target. That row names the scaffold and toggle routes. Each row carries the one-line description of what it checks.\"\n    - \"Leg sk-code: run node .skilled/commands/doctor/scripts/sk-code-setup-check.cjs. Exit 0 passes. Any other exit fails, with repair /doctor:sk-code setup.\"\n    - \"Leg sk-git: run node .skilled/commands/doctor/scripts/git-setup-check.cjs --tool=<name>, where <name> is the AI tool executing this command: claude, codex, devin, cursor, opencode, pi or dsh. On any other runtime, run it without --tool, because the battery accepts no other name. Exit 0 passes. Exit 3 is DEGRADED, not a failure: no check failed, but one is UNKNOWN or DEGRADED, so the row names /doctor:git setup to show which. Exit 2 is a usage error or a crash and is ERROR. Any other exit fails, with repair /doctor:git setup.\"\n    - \"Leg trigger-index: run node .skilled/skills/system-spec-kit/runtime/cli/retrieval/generate-trigger-index.mjs --check --json. Exit 0 passes. Exit 1 (stale documents) or 2 and higher (unreadable index) fails, with repair /doctor:speckit.\"\n    - \"Leg runtime-mirrors: run node .skilled/skills/system-spec-kit/runtime/cli/runtime-mirrors/sync-runtime-mirrors.cjs --check. Exit 0 passes. Any other exit fails, with repair /doctor:runtime-mirrors.\"\n    - \"Leg advisor: run node .skilled/bin/skill-advisor.cjs advisor_status --workspace-root \\\"$PWD\\\" --format json --timeout-ms 500 --warm-only. Exit 0 with data.freshness set to live is PASS. Exit 0 with any other freshness is DEGRADED, with repair /doctor:skill-advisor rebuild. Exit 75 with a staleDistWarning field in stderr JSON is FAIL, with repair npm --prefix .skilled/skills/system-skill-advisor/runtime run build. Exit 75 without that field is SKIP because the daemon is not running. Any other exit is FAIL, with repair /doctor:skill-advisor rebuild. When data.hookHealth is present, show hook p95 <rollingP95Ms> ms over <invocations> prompts, fail-open <rollingFailOpenRate as a percent>, degraded <rollingDegradedRate as a percent> and last record <lastRecordAt> under the leg. It never changes the leg's status. When data.hookHealth is absent, show hook health not recorded under the leg, because no prompt hook has written a record for this checkout yet: OpenCode has no prompt hook that writes one and an unapproved Codex hook never runs. It never changes the leg's status.\"\n    - \"Leg embedder: run node .skilled/bin/skill-advisor.cjs advisor_status --workspace-root \\\"$PWD\\\" --include-semantic-health true --format json --timeout-ms 1500 --warm-only. Exit 75 is SKIP, as for the advisor leg, because the daemon is not running. Exit 0 with data.semanticLaneHealth.laneEnabled true and data.semanticLaneHealth.commandVectorCoverage.embedded above 0 is PASS. Any other result is DEGRADED, never FAIL, with repair /doctor:skill-advisor embedder.\"\n    - \"Leg delivery: run node .skilled/commands/doctor/scripts/hook-wiring-check.cjs --root \\\"$PWD\\\" and node .skilled/commands/doctor/scripts/codex-hook-approval-check.cjs --root \\\"$PWD\\\", and show each line they print under the leg. Both exit 0 is PASS. A hook-missing line is DEGRADED, with repair /doctor:runtime-mirrors in a Skilled checkout or /doctor:symlink check in a linked project. WARN codex-hooks-unapproved is DEGRADED, with the repair line the check printed. WARN codex-advisor-hook-absent is DEGRADED, with the repair line the check printed. Exit 2 from either check is ERROR. This leg is never FAIL, because a hook that is not wired or not approved stops the brief, not the install.\"\n    - \"Last session hop (informational, not a leg): run node .skilled/hooks/session-relaunch/bin/session-relaunch.cjs history --last 1 and show its first output line under the result as the last session hop, plus its open notes line when it prints one. Its exit and output never change the status.\"\n    - \"Claude context window (informational, not a leg): run node .skilled/hooks/session-relaunch/bin/session-relaunch.cjs window and show its line. Its exit and output never change the status.\"\n    - \"Orphan processes (informational, not a leg): run node .skilled/commands/doctor/scripts/orphan-process-check.cjs --summary and show its line. Its exit and output never change the status.\"\n    - \"Run every leg even when an earlier one fails, then render the per-leg table, the DOCTOR DIAGNOSTIC RESULT summary and the troubleshooting table through .skilled/commands/doctor/assets/doctor-setup-presentation.txt.\"\n\n# ─────────────────────────────────────────────────────────────────\n# OUTPUT\n# ─────────────────────────────────────────────────────────────────\noutput: |\n  STATUS=OK when no leg fails: each leg passes, is skipped or is degraded. List each degraded leg with the command that shows why.\n  STATUS=FAIL when any leg fails; list each failing leg with its repair command.\n  STATUS=ERROR when a leg crashes or its output cannot be read; report the message and the accepted invocation (/doctor:setup).\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"    - 'Run upstream_assets.codex_hook_approval with --root \"$PWD\". Covers the Codex approval that lets the project advisor hook run at all, since Codex skips an unapproved entry without a warning. PASS = in sync. WARN sets STATUS to WARN and shows the repair line it prints without counting as drift. SKIP leaves STATUS unchanged. Exit 0 = approved or no Codex hooks file, 1 = absent or unapproved, 2 = checker error.'\n    - \"Run upstream_assets.pi_agents with --check. Covers the generated .pi/agents/*.md. Exit 0 = in sync, 1 = drift.\"\n    - \"Run upstream_assets.pi_prompts with --check. Covers the generated .pi/prompts/*.md stubs. Exit 0 = in sync, 1 = drift.\"\n    - \"Run upstream_assets.dsh_skills, the command node .skilled/skills/system-spec-kit/runtime/cli/dsh/sync-skills-dsh.cjs --check. Covers the generated .dsh/skills/ links. When .dsh/ is absent, report the row as n/a (no .dsh/ tree) without running the check; an n/a row leaves STATUS unchanged, and this run never creates that directory. Exit 0 = in sync, 1 = drift.\"\n    - \"Run upstream_assets.dsh_prompts, the command node .skilled/skills/system-spec-kit/runtime/cli/dsh/sync-prompts-dsh.cjs --check. Covers the generated .dsh/prompts/*.md files. When .dsh/ is absent, report the row as n/a (no .dsh/ tree) without running the check; an n/a row leaves STATUS unchanged, and this run never creates that directory. Exit 0 = in sync, 1 = drift.\"\n    - \"Run upstream_assets.dsh_agents, the command node .skilled/skills/system-spec-kit/runtime/cli/dsh/sync-agents-dsh.cjs --check. Covers the generated .dsh/agents/*.patch.yml files. When .dsh/ is absent, report the row as n/a (no .dsh/ tree) without running the check; an n/a row leaves STATUS unchanged, and this run never creates that directory. Exit 0 = in sync, 1 = drift.\"\n    - \"For each row in hook_adapter_fallback_health_checks, run its file_exists check (a plain path-existence read, no execution of the adapter or the shell command that wraps it). Collect every row whose path does not resolve as a degraded hook adapter, keyed by host:event:path.\"\n    - \"Aggregate: report each surface with its own verdict rather than a single pass/fail, so the operator learns which mirror moved.\"\n\n# ─────────────────────────────────────────────────────────────────\n# OUTPUT\n# ─────────────────────────────────────────────────────────────────\noutput: |\n  STATUS=OK when every checker reports in sync, or n/a for a DSH row while its runtime tree is absent, and the\n  Codex hook approval check reports in sync or skip.\n  STATUS=WARN when the Codex hook approval check reports an unapproved or absent advisor entry and no checker\n  reports drift: show its lines, including the repair line it prints, without adding a drift surface.\n  STATUS=DRIFT when any checker reports drift, listing each drifting surface and the repair command for it:\n    runtime mirrors  -> node .skilled/skills/system-spec-kit/runtime/cli/runtime-mirrors/sync-runtime-mirrors.cjs\n    codex agents     -> node .skilled/skills/system-spec-kit/runtime/cli/codex/sync-agents.cjs\n    codex prompts    -> node .skilled/skills/system-spec-kit/runtime/cli/codex/sync-prompts.cjs\n    codex hooks      -> node .skilled/bin/install-codex-hooks.mjs\n    agent body parity (.skilled/bin/check-agent-mirror-sync.cjs) -> .claude/agents is a hand-maintained real-file mirror; update both its .skilled source and Claude twin, then run node .skilled/skills/system-spec-kit/runtime/cli/codex/sync-agents.cjs for .codex/agents, node .skilled/skills/system-spec-kit/runtime/cli/pi/sync-agents-pi.cjs for .pi/agents, and node .skilled/skills/system-spec-kit/runtime/cli/runtime-mirrors/sync-runtime-mirrors.cjs for the .cursor and .devin links\n    pi agents        -> node .skilled/skills/system-spec-kit/runtime/cli/pi/sync-agents-pi.cjs\n    pi prompts       -> node .skilled/skills/system-spec-kit/runtime/cli/pi/sync-prompts-pi.cjs\n    dsh skills       -> node .skilled/skills/system-spec-kit/runtime/cli/dsh/sync-skills-dsh.cjs\n    dsh prompts      -> node .skilled/skills/system-spec-kit/runtime/cli/dsh/sync-prompts-dsh.cjs\n    dsh agents       -> node .skilled/skills/system-spec-kit/runtime/cli/dsh/sync-agents-dsh.cjs\n    command catalog  -> update the root and family indexes, group counts, and hub metadata from command frontmatter\n  While .dsh/ is absent the three DSH rows read n/a (no .dsh/ tree), never in sync, and leave\n  STATUS unchanged: the mirror does not exist yet, and this run never creates it. Their repair lines are the generators without --check, run once the tree exists.\n# ─────────────────────────────────────────────────────────────────\ninputs:\n  target: \"The command takes no positional target and no flag. /doctor:setup alone runs it; anything else fails before this YAML loads.\"\n\n# ─────────────────────────────────────────────────────────────────\n# EXECUTION\n# ─────────────────────────────────────────────────────────────────\nexecution:\n  steps:\n    - \"Read .skilled/commands/doctor/_routes.yaml and print the doctor target list through the presentation contract. The presentation table owns the rows and their wording. It shows /doctor:ci as one row for its report target. That row names the scaffold and toggle routes. Each row carries the one-line description of what it checks.\"\n    - \"Leg sk-code: run node .skilled/commands/doctor/scripts/sk-code-setup-check.cjs. Exit 0 passes. Any other exit fails, with repair /doctor:sk-code setup.\"\n    - \"Leg sk-git: run node .skilled/commands/doctor/scripts/git-setup-check.cjs --tool=<name>, where <name> is the AI tool executing this command: claude, codex, devin, cursor, opencode, pi or dsh. On any other runtime, run it without --tool, because the battery accepts no other name. Exit 0 passes. Exit 3 is DEGRADED, not a failure: no check failed, but one is UNKNOWN or DEGRADED, so the row names /doctor:git setup to show which. Exit 2 is a usage error or a crash and is ERROR. Any other exit fails, with repair /doctor:git setup.\"\n    - \"Leg trigger-index: run node .skilled/skills/system-spec-kit/runtime/cli/retrieval/generate-trigger-index.mjs --check --json. Exit 0 passes. Exit 1 (stale documents) or 2 and higher (unreadable index) fails, with repair /doctor:speckit.\"\n    - \"Leg runtime-mirrors: run node .skilled/skills/system-spec-kit/runtime/cli/runtime-mirrors/sync-runtime-mirrors.cjs --check. Exit 0 passes. Any other exit fails, with repair /doctor:runtime-mirrors.\"\n    - \"Leg advisor: run node .skilled/bin/skill-advisor.cjs advisor_status --workspace-root \\\"$PWD\\\" --format json --timeout-ms 500 --warm-only. Exit 0 with data.freshness set to live is PASS. Exit 0 with any other freshness is DEGRADED, with repair /doctor:skill-advisor rebuild. Exit 75 with a staleDistWarning field in stderr JSON is FAIL, with repair npm --prefix .skilled/skills/system-skill-advisor/runtime run build. Exit 75 without that field is SKIP because the daemon is not running. Any other exit is FAIL, with repair /doctor:skill-advisor rebuild. When data.hookHealth is present, show hook p95 <rollingP95Ms> ms over <invocations> prompts, fail-open <rollingFailOpenRate as a percent>, degraded <rollingDegradedRate as a percent> and last record <lastRecordAt> under the leg. It never changes the leg's status. When data.hookHealth is absent, show hook health not recorded under the leg, because no prompt hook has written a record for this checkout yet: OpenCode has no prompt hook that writes one and an unapproved Codex hook never runs. It never changes the leg's status.\"\n    - \"Leg embedder: run node .skilled/bin/skill-advisor.cjs advisor_status --workspace-root \\\"$PWD\\\" --include-semantic-health true --format json --timeout-ms 1500 --warm-only. Exit 75 is SKIP, as for the advisor leg, because the daemon is not running. Exit 0 with data.semanticLaneHealth.laneEnabled true and data.semanticLaneHealth.commandVectorCoverage.embedded above 0 is PASS. Any other result is DEGRADED, never FAIL, with repair /doctor:skill-advisor embedder.\"\n    - \"Leg delivery: run node .skilled/commands/doctor/scripts/hook-wiring-check.cjs --root \\\"$PWD\\\" and node .skilled/commands/doctor/scripts/codex-hook-approval-check.cjs --root \\\"$PWD\\\", and show each line they print under the leg. Both exit 0 is PASS. A hook-missing line is DEGRADED, with repair /doctor:runtime-mirrors in a Skilled checkout or /doctor:symlink check in a linked project. WARN codex-hooks-unapproved is DEGRADED, with the repair line the check printed. WARN codex-advisor-hook-absent is DEGRADED, with the repair line the check printed. Exit 2 from either check is ERROR. This leg is never FAIL, because a hook that is not wired or not approved stops the brief, not the install.\"\n    - \"Last session hop (informational, not a leg): run node .skilled/hooks/session-relaunch/bin/session-relaunch.cjs history --last 1 and show its first output line under the result as the last session hop, plus its open notes line when it prints one. Its exit and output never change the status.\"\n    - \"Claude context window (informational, not a leg): run node .skilled/hooks/session-relaunch/bin/session-relaunch.cjs window and show its line. Its exit and output never change the status.\"\n    - \"Orphan processes (informational, not a leg): run node .skilled/commands/doctor/scripts/orphan-process-check.cjs --summary and show its line. Its exit and output never change the status.\"\n    - \"Run every leg even when an earlier one fails, then render the per-leg table, the DOCTOR DIAGNOSTIC RESULT summary and the troubleshooting table through .skilled/commands/doctor/assets/doctor-setup-presentation.txt.\"\n\n# ─────────────────────────────────────────────────────────────────\n# OUTPUT\n# ─────────────────────────────────────────────────────────────────\noutput: |\n  STATUS=OK when no leg fails: each leg passes, is skipped or is degraded. List each degraded leg with the command that shows why.\n  STATUS=FAIL when any leg fails; list each failing leg with its repair command.\n  STATUS=ERROR when a leg crashes or its output cannot be read; report the message and the accepted invocation (/doctor:setup).\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"sed -n '150,180p' .skilled/commands/doctor/assets/doctor-runtime-mirrors.yaml; sed -n '45,75p' .skilled/commands/doctor/assets/doctor-setup.yaml\"}"},"time":{"start":1794570575839,"end":1794570576270}}}}
{"type":"step_finish","timestamp":1794570577907,"sessionID":"ses_e2b4a18a6ffeJYEGLs0dTSiOZ0","part":{"id":"prt_1d4bde7f3001rrtTOyC4s4e1sa","sessionID":"ses_e2b4a18a6ffeJYEGLs0dTSiOZ0","messageID":"msg_1d4bd8149001Lb5Q1111lsF3rO","type":"step-finish","reason":"tool-calls","snapshot":"b48eb6dbe42714f0a005b7ca14230235fcf2f57c","cost":0,"tokens":{"input":207,"output":126,"reasoning":2357,"cache":{"read":196096,"write":0}}}}
{"type":"step_start","timestamp":1794570579696,"sessionID":"ses_e2b4a18a6ffeJYEGLs0dTSiOZ0","part":{"id":"prt_1d4bdeef0001iUH43MjtmUDFNg","sessionID":"ses_e2b4a18a6ffeJYEGLs0dTSiOZ0","messageID":"msg_1d4bde7fb001qrzMoA1DWqp8MG","type":"step-start","snapshot":"b48eb6dbe42714f0a005b7ca14230235fcf2f57c"}}
{"type":"tool_use","timestamp":1794570593466,"sessionID":"ses_e2b4a18a6ffeJYEGLs0dTSiOZ0","part":{"partID":"prt_1d4be21c9001a2HaAkhshuD1C9","sessionID":"ses_e2b4a18a6ffeJYEGLs0dTSiOZ0","messageID":"msg_1d4bde7fb001qrzMoA1DWqp8MG","type":"tool","id":"call_435a4e97d9864342a34be9bc","tool":"shell","state":{"status":"completed","input":{"command":"sed -n '60,120p' .skilled/commands/doctor/scripts/hook-wiring-check.cjs; sed -n '150,220p' .skilled/commands/doctor/scripts/hook-wiring-check.cjs"},"output":"  },\n  {\n    id: 'devin',\n    dir: '.devin',\n    file: '.devin/hooks.v1.json',\n    event: 'UserPromptSubmit',\n    marker: 'hooks/devin/user-prompt-submit.js',\n  },\n];\n\n// ─────────────────────────────────────────────────────────────────────────────\n// 3. HELPERS\n// ─────────────────────────────────────────────────────────────────────────────\n\nfunction fail(message) {\n  process.stderr.write(`hook-wiring-check: ${message}\\n`);\n  process.exit(2);\n}\n\nfunction parseArgs(argv) {\n  const opts = { root: null, json: false };\n  for (let i = 0; i < argv.length; i += 1) {\n    const arg = argv[i];\n    if (arg === '--json') {\n      opts.json = true;\n    } else if (arg === '--root') {\n      const value = argv[i + 1];\n      if (!value || value.startsWith('-')) fail(`--root needs a directory\\n${USAGE}`);\n      opts.root = path.resolve(value);\n      i += 1;\n    } else {\n      fail(`unknown argument: ${arg}\\n${USAGE}`);\n    }\n  }\n  if (!opts.root) fail(`--root is required\\n${USAGE}`);\n  if (!fs.existsSync(opts.root) || !fs.statSync(opts.root).isDirectory()) {\n    fail(`root not found: ${opts.root}`);\n  }\n  return opts;\n}\n\n// Hook files either wrap their events in a `hooks` object or place them at the\n// top level, and the cursor file omits the nested hook array the others carry.\n// A mention is not a wired hook, so only a command that runs the script counts:\n// the event's entries and their nested hooks arrays are walked for command\n// entries, and a runtime is wired when one starts node on the marker path.\nfunction eventPayload(document, event) {\n  if (!document || typeof document !== 'object') return undefined;\n  if (document.hooks && typeof document.hooks === 'object' && event in document.hooks) {\n    return document.hooks[event];\n  }\n  if (event in document) return document[event];\n  return undefined;\n}\n\nfunction stripQuotes(token) {\n  return token.replace(/^['\"]+|['\"]+$/g, '');\n}\n\nfunction collectCommands(node, commands) {\n  if (Array.isArray(node)) {\n\nfunction inspect(runtime, root) {\n  const file = path.join(root, runtime.file);\n  let document;\n  try {\n    document = JSON.parse(fs.readFileSync(file, 'utf8'));\n  } catch {\n    return { runtime: runtime.id, file: runtime.file, status: 'hook-missing' };\n  }\n  const payload = eventPayload(document, runtime.event);\n  const wired = collectCommands(payload, []).some((command) => runsMarker(command, runtime.marker));\n  return { runtime: runtime.id, file: runtime.file, status: wired ? 'ok' : 'hook-missing' };\n}\n\n// ─────────────────────────────────────────────────────────────────────────────\n// 4. MAIN\n// ─────────────────────────────────────────────────────────────────────────────\n\nfunction main(argv) {\n  const opts = parseArgs(argv);\n  const checks = RUNTIMES.map((runtime) => {\n    if (!fs.existsSync(path.join(opts.root, runtime.dir))) {\n      return { runtime: runtime.id, file: runtime.file, status: 'skipped' };\n    }\n    return inspect(runtime, opts.root);\n  });\n\n  if (opts.json) {\n    process.stdout.write(`${JSON.stringify({ root: opts.root, checks }, null, 2)}\\n`);\n  } else {\n    for (const check of checks) {\n      if (check.status === 'ok') process.stdout.write(`ok ${check.runtime}\\n`);\n      else if (check.status === 'hook-missing') process.stdout.write(`hook-missing ${check.runtime} ${check.file}\\n`);\n    }\n  }\n\n  return checks.some((check) => check.status === 'hook-missing') ? 1 : 0;\n}\n\nif (require.main === module) {\n  try {\n    process.exitCode = main(process.argv.slice(2));\n  } catch (err) {\n    process.stderr.write(`hook-wiring-check: ${err && err.message ? err.message : String(err)}\\n`);\n    process.exitCode = 2;\n  }\n}\n\nmodule.exports = { main, eventPayload };\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"  },\n  {\n    id: 'devin',\n    dir: '.devin',\n    file: '.devin/hooks.v1.json',\n    event: 'UserPromptSubmit',\n    marker: 'hooks/devin/user-prompt-submit.js',\n  },\n];\n\n// ─────────────────────────────────────────────────────────────────────────────\n// 3. HELPERS\n// ─────────────────────────────────────────────────────────────────────────────\n\nfunction fail(message) {\n  process.stderr.write(`hook-wiring-check: ${message}\\n`);\n  process.exit(2);\n}\n\nfunction parseArgs(argv) {\n  const opts = { root: null, json: false };\n  for (let i = 0; i < argv.length; i += 1) {\n    const arg = argv[i];\n    if (arg === '--json') {\n      opts.json = true;\n    } else if (arg === '--root') {\n      const value = argv[i + 1];\n      if (!value || value.startsWith('-')) fail(`--root needs a directory\\n${USAGE}`);\n      opts.root = path.resolve(value);\n      i += 1;\n    } else {\n      fail(`unknown argument: ${arg}\\n${USAGE}`);\n    }\n  }\n  if (!opts.root) fail(`--root is required\\n${USAGE}`);\n  if (!fs.existsSync(opts.root) || !fs.statSync(opts.root).isDirectory()) {\n    fail(`root not found: ${opts.root}`);\n  }\n  return opts;\n}\n\n// Hook files either wrap their events in a `hooks` object or place them at the\n// top level, and the cursor file omits the nested hook array the others carry.\n// A mention is not a wired hook, so only a command that runs the script counts:\n// the event's entries and their nested hooks arrays are walked for command\n// entries, and a runtime is wired when one starts node on the marker path.\nfunction eventPayload(document, event) {\n  if (!document || typeof document !== 'object') return undefined;\n  if (document.hooks && typeof document.hooks === 'object' && event in document.hooks) {\n    return document.hooks[event];\n  }\n  if (event in document) return document[event];\n  return undefined;\n}\n\nfunction stripQuotes(token) {\n  return token.replace(/^['\"]+|['\"]+$/g, '');\n}\n\nfunction collectCommands(node, commands) {\n  if (Array.isArray(node)) {\n\nfunction inspect(runtime, root) {\n  const file = path.join(root, runtime.file);\n  let document;\n  try {\n    document = JSON.parse(fs.readFileSync(file, 'utf8'));\n  } catch {\n    return { runtime: runtime.id, file: runtime.file, status: 'hook-missing' };\n  }\n  const payload = eventPayload(document, runtime.event);\n  const wired = collectCommands(payload, []).some((command) => runsMarker(command, runtime.marker));\n  return { runtime: runtime.id, file: runtime.file, status: wired ? 'ok' : 'hook-missing' };\n}\n\n// ─────────────────────────────────────────────────────────────────────────────\n// 4. MAIN\n// ─────────────────────────────────────────────────────────────────────────────\n\nfunction main(argv) {\n  const opts = parseArgs(argv);\n  const checks = RUNTIMES.map((runtime) => {\n    if (!fs.existsSync(path.join(opts.root, runtime.dir))) {\n      return { runtime: runtime.id, file: runtime.file, status: 'skipped' };\n    }\n    return inspect(runtime, opts.root);\n  });\n\n  if (opts.json) {\n    process.stdout.write(`${JSON.stringify({ root: opts.root, checks }, null, 2)}\\n`);\n  } else {\n    for (const check of checks) {\n      if (check.status === 'ok') process.stdout.write(`ok ${check.runtime}\\n`);\n      else if (check.status === 'hook-missing') process.stdout.write(`hook-missing ${check.runtime} ${check.file}\\n`);\n    }\n  }\n\n  return checks.some((check) => check.status === 'hook-missing') ? 1 : 0;\n}\n\nif (require.main === module) {\n  try {\n    process.exitCode = main(process.argv.slice(2));\n  } catch (err) {\n    process.stderr.write(`hook-wiring-check: ${err && err.message ? err.message : String(err)}\\n`);\n    process.exitCode = 2;\n  }\n}\n\nmodule.exports = { main, eventPayload };\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"sed -n '60,120p' .skilled/commands/doctor/scripts/hook-wiring-check.cjs; sed -n '150,220p' .skilled/commands/doctor/scripts/hook-wiring-check.cjs\"}"},"time":{"start":1794570592713,"end":1794570593466}}}}
