{"type":"tool_use","timestamp":1794760894915,"sessionID":"ses_e1feefdd9ffeEQ4EaGVDFSUKgQ","part":{"partID":"prt_1e015e83e001iajhlm0ixNqlbU","sessionID":"ses_e1feefdd9ffeEQ4EaGVDFSUKgQ","messageID":"msg_1e015db30001VU90oiB9RLBYyt","type":"tool","id":"call_0d5be408786b45189b2ce0a7","tool":"read","state":{"status":"completed","input":{"path":".skilled/skills/system-skill-advisor/runtime/tests/command-behaviour-guards.vitest.ts"},"output":"Read file .skilled/skills/system-skill-advisor/runtime/tests/command-behaviour-guards.vitest.ts, lines 1-468\n1: // ───────────────────────────────────────────────────────────────\n2: // MODULE: Behaviour Runner Guard Tests\n3: // ───────────────────────────────────────────────────────────────\n4: \n5: import { mkdirSync, mkdtempSync, readFileSync, readdirSync, rmSync, symlinkSync, writeFileSync } from 'node:fs';\n6: import { tmpdir } from 'node:os';\n7: import { join } from 'node:path';\n8: import { fileURLToPath } from 'node:url';\n9: import { spawnSync } from 'node:child_process';\n10: import { afterEach, describe, expect, it, vi } from 'vitest';\n11: import { G2_ROWS, armFor, assertFreshRun, assertFreshRowsUnique, childEnv, freshRowsFrom, lineFixture, liveArmRefusal, offerLineFields, restorePointer } from '../scripts/routing-accuracy/run-command-behaviour.mjs';\n12: import { startedLabel } from '../scripts/routing-accuracy/score-command-transcripts.mjs';\n13: \n14: describe('childEnv', () => {\n15:   afterEach(() => {\n16:     vi.unstubAllEnvs();\n17:   });\n18: \n19:   it('passes only the allowlisted environment to a turn', () => {\n20:     vi.stubEnv('SSH_AUTH_SOCK', '/tmp/ssh-agent.sock');\n21:     vi.stubEnv('AWS_ACCESS_KEY_ID', 'AKIAIOSFODNN7EXAMPLE');\n22:     vi.stubEnv('NPM_TOKEN', 'npm-token');\n23:     vi.stubEnv('GH_TOKEN', 'gh-token');\n24:     vi.stubEnv('AI_SESSION_CHILD', '1');\n25:     vi.stubEnv('ANTHROPIC_API_KEY', 'sk-ant-example');\n26: \n27:     const env = childEnv('/tmp/gh-empty');\n28: \n29:     expect(env.SSH_AUTH_SOCK).toBeUndefined();\n30:     expect(env.AWS_ACCESS_KEY_ID).toBeUndefined();\n31:     expect(env.NPM_TOKEN).toBeUndefined();\n32:     expect(env.GH_TOKEN).toBeUndefined();\n33:     expect(env.AI_SESSION_CHILD).toBeUndefined();\n34:     expect(env.ANTHROPIC_API_KEY).toBe('sk-ant-example');\n35:     expect(env.PATH).toBe(process.env.PATH);\n36:     expect(env.HOME).toBe(process.env.HOME);\n37:     expect(env.GH_CONFIG_DIR).toBe('/tmp/gh-empty');\n38:     expect(env.GIT_TERMINAL_PROMPT).toBe('0');\n39:     expect(env.GIT_CONFIG_KEY_0).toBe('credential.helper');\n40:   });\n41: \n42:   it('switches the advisor off and on by arm', () => {\n43:     vi.stubEnv('SPECKIT_SKILL_ADVISOR_HOOK_DISABLED', '1');\n44:     vi.stubEnv('MK_SKILL_ADVISOR_PLUGIN_DISABLED', '1');\n45:     vi.stubEnv('MK_HOOKS_DISABLED', '1');\n46: \n47:     const on = childEnv('/tmp/gh-empty', 'on');\n48:     expect(on.SPECKIT_SKILL_ADVISOR_HOOK_DISABLED).toBeUndefined();\n49:     expect(on.MK_SKILL_ADVISOR_PLUGIN_DISABLED).toBeUndefined();\n50:     expect(on.MK_HOOKS_DISABLED).toBeUndefined();\n51:     expect(on.SYSTEM_SKILL_ADVISOR_HOOK_DISABLED).toBeUndefined();\n52: \n53:     const off = childEnv('/tmp/gh-empty', 'off');\n54:     expect(off.SYSTEM_SKILL_ADVISOR_HOOK_DISABLED).toBe('1');\n55:     expect(off.SYSTEM_SKILL_ADVISOR_PLUGIN_DISABLED).toBe('1');\n56:     expect(off.SPECKIT_SKILL_ADVISOR_HOOK_DISABLED).toBeUndefined();\n57:     expect(off.MK_SKILL_ADVISOR_PLUGIN_DISABLED).toBeUndefined();\n58:     expect(off.MK_HOOKS_DISABLED).toBeUndefined();\n59: \n60:     expect(childEnv('/tmp/gh-empty', 'pre')).toEqual(childEnv('/tmp/gh-empty'));\n61:   });\n62: });\n63: \n64: describe('startedLabel', () => {\n65:   it('labels a row from its own command and variant', () => {\n66:     const label = startedLabel('g2-x-custom', [\n67:       { id: 'g2-x-custom', command: '/speckit:plan', variant: 'typed', prompt: 'p' },\n68:     ]);\n69: \n70:     expect(label?.expected_command).toBe('/speckit:plan');\n71:     expect(label?.expected_policy).toBe('start');\n72:     expect(label?.prompt).toBe(':auto');\n73:   });\n74: \n75:   it('returns no label for an id no row carries', () => {\n76:     expect(startedLabel('g2-nope')).toBeNull();\n77:   });\n78: \n79:   it('labels every runner row with its command and only a typed row with :auto', () => {\n80:     for (const row of G2_ROWS) {\n81:       const label = startedLabel(row.id);\n82: \n83:       expect(['/deep:research', '/deep:review', '/speckit:complete']).toContain(label?.expected_command);\n84:       expect(label?.expected_command).toBe(row.command);\n85:       expect(label?.prompt).toBe(row.variant === 'typed' ? ':auto' : '');\n86:     }\n87:   });\n88: });\n89: \n90: describe('armFor', () => {\n91:   it('runs a started-command row picked by id under arm g2', () => {\n92:     expect(armFor({ arm: null, set: null }, ['g2-deep-review-ask'])).toBe('g2');\n93:   });\n94: \n95:   it('runs a whole started-command selection under arm g2', () => {\n96:     expect(armFor({ arm: null, set: 'g2' }, G2_ROWS.map((row) => row.id))).toBe('g2');\n97:   });\n98: \n99:   it('keeps an explicit arm over the rows it runs', () => {\n100:     expect(armFor({ arm: 'post', set: null }, ['g2-deep-review-ask'])).toBe('post');\n101:   });\n102: \n103:   it('runs a selection with no started-command row under the default arm', () => {\n104:     expect(armFor({ arm: null, set: null }, ['cmd-x'])).toBe('pre');\n105:     expect(armFor({ arm: null, set: null }, [])).toBe('pre');\n106:   });\n107: \n108:   it('refuses a selection that mixes a started-command row with another row', () => {\n109:     let refusal: { code?: string } | null = null;\n110:     try {\n111:       armFor({ arm: null, set: null }, ['g2-deep-review-ask', 'cmd-x']);\n112:     } catch (error) {\n113:       refusal = error as { code?: string };\n114:     }\n115: \n116:     expect(refusal?.code).toBe('mixed_row_arms');\n117:   });\n118: });\n119: \n120: describe('lineFixture', () => {\n121:   it('keeps the fixture a run line recorded', () => {\n122:     expect(lineFixture({ fixture: '/custom/fixture' }, '/runs/arm/g2-fixture')).toBe('/custom/fixture');\n123:   });\n124: \n125:   it('falls back to the arm folder for a line that records no fixture', () => {\n126:     expect(lineFixture({}, '/runs/arm/g2-fixture')).toBe('/runs/arm/g2-fixture');\n127:     expect(lineFixture({ fixture: '' }, '/runs/arm/g2-fixture')).toBe('/runs/arm/g2-fixture');\n128:   });\n129: });\n130: \n131: describe('offerLineFields', () => {\n132:   it('copies the offered command, its policy and where it sat', () => {\n133:     expect(\n134:       offerLineFields({\n135:         offeredCommand: '/create:readme',\n136:         offeredPolicy: 'start',\n137:         offeredAs: 'partner',\n138:         offerError: null,\n139:       }),\n140:     ).toEqual({ offeredCommand: '/create:readme', offeredPolicy: 'start', offeredAs: 'partner' });\n141:   });\n142: \n143:   it('writes null where the replay found no offer', () => {\n144:     expect(\n145:       offerLineFields({ offeredCommand: null, offeredPolicy: null, offerError: 'no_head' }),\n146:     ).toEqual({ offeredCommand: null, offeredPolicy: null, offeredAs: null });\n147:   });\n148: });\n149: \n150: describe('freshRowsFrom', () => {\n151:   const freshLine = (index: number, overrides: Record<string, unknown> = {}) => JSON.stringify({\n152:     id: `fresh-fit-${String(index).padStart(2, '0')}`,\n153:     row_type: 'plain',\n154:     split: 'fresh',\n155:     prompt: `made up request ${index}`,\n156:     ...overrides,\n157:   });\n158:   const freshText = (count: number) =>\n159:     Array.from({ length: count }, (_, offset) => freshLine(offset + 1)).join('\\n');\n160:   const refusalOf = (text: string) => {\n161:     try {\n162:       freshRowsFrom(text);\n163:       return null;\n164:     } catch (error) {\n165:       return error as { code?: string; message?: string };\n166:     }\n167:   };\n168: \n169:   it('reads 36 fresh rows from their text', () => {\n170:     const rows = freshRowsFrom(freshText(36));\n171: \n172:     expect(rows).toHaveLength(36);\n173:     expect(rows[0].id).toBe('fresh-fit-01');\n174:     expect(rows[35].id).toBe('fresh-fit-36');\n175:   });\n176: \n177:   it('refuses a set of 35 rows', () => {\n178:     expect(refusalOf(freshText(35))?.code).toBe('set_short');\n179:   });\n180: \n181:   it('refuses a holdout row by its id', () => {\n182:     const refusal = refusalOf(`${freshText(35)}\\n${freshLine(36, { split: 'holdout' })}`);\n183: \n184:     expect(refusal?.code).toBe('holdout_row');\n185:     expect(refusal?.message).toContain('fresh-fit-36');\n186:   });\n187: \n188:   it('refuses a row whose split is not fresh', () => {\n189:     const refusal = refusalOf(`${freshText(35)}\\n${freshLine(36, { split: 'tune' })}`);\n190: \n191:     expect(refusal?.code).toBe('fresh_split');\n192:     expect(refusal?.message).toContain('fresh-fit-36');\n193:   });\n194: \n195:   it('refuses a row whose id is not a fresh id', () => {\n196:     const refusal = refusalOf(`${freshText(35)}\\n${freshLine(36, { id: 'made-up-01' })}`);\n197: \n198:     expect(refusal?.code).toBe('fresh_id');\n199:     expect(refusal?.message).toContain('made-up-01');\n200:   });\n201: });\n202: \n203: describe('assertFreshRowsUnique', () => {\n204:   const refusalOf = (call: () => void) => {\n205:     try {\n206:       call();\n207:       return null;\n208:     } catch (error) {\n209:       return error as { code?: string; message?: string };\n210:     }\n211:   };\n212: \n213:   it('refuses a fresh row that repeats another row', () => {\n214:     const otherRows = [{ id: 'made-up-92', prompt: 'draft the release notes' }];\n215:     const repeated = refusalOf(() =>\n216:       assertFreshRowsUnique([{ id: 'fresh-fit-91', prompt: 'Draft  the Release notes' }], otherRows),\n217:     );\n218: \n219:     expect(repeated?.code).toBe('repeated_row');\n220:     expect(repeated?.message).toBe('fresh row fresh-fit-91 repeats row made-up-92');\n221: \n222:     const doubled = refusalOf(() =>\n223:       assertFreshRowsUnique(\n224:         [\n225:           { id: 'fresh-fit-91', prompt: 'draft the release notes' },\n226:           { id: 'fresh-fit-92', prompt: 'Draft the   release notes' },\n227:         ],\n228:         [],\n229:       ),\n230:     );\n231: \n232:     expect(doubled?.code).toBe('repeated_row');\n233:     expect(doubled?.message).toContain('fresh-fit-91');\n234:     expect(doubled?.message).toContain('fresh-fit-92');\n235: \n236:     expect(\n237:       refusalOf(() =>\n238:         assertFreshRowsUnique([{ id: 'fresh-fit-91', prompt: 'rename the other function' }], otherRows),\n239:       ),\n240:     ).toBeNull();\n241:   });\n242: });\n243: \n244: describe('assertFreshRun', () => {\n245:   const refusalOf = (options: { arm: string; run: number | null }, rowIds: string[]) => {\n246:     try {\n247:       assertFreshRun(options, rowIds);\n248:       return null;\n249:     } catch (error) {\n250:       return error as { code?: string; message?: string };\n251:     }\n252:   };\n253: \n254:   it('refuses a fresh row outside the off and on arms', () => {\n255:     expect(refusalOf({ arm: 'pre', run: 1 }, ['fresh-fit-01'])?.code).toBe('fresh_arm');\n256:   });\n257: \n258:   it('refuses a fresh row without a run number', () => {\n259:     expect(refusalOf({ arm: 'on', run: null }, ['fresh-fit-01'])?.code).toBe('fresh_run');\n260:   });\n261: \n262:   it('accepts a fresh row under an arm and a run number', () => {\n263:     expect(refusalOf({ arm: 'on', run: 2 }, ['fresh-fit-01'])).toBeNull();\n264:   });\n265: \n266:   it('accepts a corpus row with neither an arm nor a run number', () => {\n267:     expect(refusalOf({ arm: 'pre', run: null }, ['cmd-create-readme-plain-tune-01'])).toBeNull();\n268:   });\n269: });\n270: \n271: describe('liveArmRefusal', () => {\n272:   const dirs: string[] = [];\n273: \n274:   afterEach(() => {\n275:     for (const dir of dirs.splice(0)) rmSync(dir, { recursive: true, force: true });\n276:   });\n277: \n278:   it('refuses a live arm outside a marked arena', () => {\n279:     const dir = mkdtempSync(join(tmpdir(), 'skilled-behaviour-guard-'));\n280:     dirs.push(dir);\n281:     const runGit = (args: string[]) => spawnSync('git', args, { cwd: dir, encoding: 'utf8' });\n282:     expect(runGit(['init', '-q']).status).toBe(0);\n283: \n284:     expect(liveArmRefusal(dir)?.code).toBe('arena_unprepared');\n285: \n286:     writeFileSync(join(dir, '.git', 'skilled-behaviour-arena'), 'arena\\n');\n287:     expect(liveArmRefusal(dir)).toBeNull();\n288: \n289:     expect(runGit(['remote', 'add', 'origin', 'https://example.invalid/x.git']).status).toBe(0);\n290:     expect(liveArmRefusal(dir)).toEqual({ ok: false, code: 'remote_present', remotes: ['origin'] });\n291:   });\n292: });\n293: \n294: describe('restorePointer', () => {\n295:   const dirs: string[] = [];\n296: \n297:   afterEach(() => {\n298:     for (const dir of dirs.splice(0)) rmSync(dir, { recursive: true, force: true });\n299:   });\n300: \n301:   const arenaDir = () => {\n302:     const dir = mkdtempSync(join(tmpdir(), 'skilled-behaviour-pointer-'));\n303:     dirs.push(dir);\n304:     return dir;\n305:   };\n306: \n307:   it('writes back a pointer a turn edited', () => {\n308:     const dir = arenaDir();\n309:     writeFileSync(join(dir, 'CLAUDE.md'), 'rewritten rules\\n');\n310: \n311:     expect(restorePointer(dir, '@AGENTS.md\\n')).toBe(true);\n312:     expect(readFileSync(join(dir, 'CLAUDE.md'), 'utf8')).toBe('@AGENTS.md\\n');\n313:   });\n314: \n315:   it('writes back a pointer a turn deleted', () => {\n316:     const dir = arenaDir();\n317: \n318:     expect(restorePointer(dir, '@AGENTS.md\\n')).toBe(true);\n319:     expect(readFileSync(join(dir, 'CLAUDE.md'), 'utf8')).toBe('@AGENTS.md\\n');\n320:   });\n321: \n322:   it('leaves an unchanged pointer or an absent one alone', () => {\n323:     const unchanged = arenaDir();\n324:     writeFileSync(join(unchanged, 'CLAUDE.md'), '@AGENTS.md\\n');\n325: \n326:     expect(restorePointer(unchanged, '@AGENTS.md\\n')).toBe(false);\n327:     expect(readFileSync(join(unchanged, 'CLAUDE.md'), 'utf8')).toBe('@AGENTS.md\\n');\n328: \n329:     const absent = arenaDir();\n330:     expect(restorePointer(absent, null)).toBe(false);\n331:     expect(readdirSync(absent)).toEqual([]);\n332:   });\n333: });\n334: \n335: describe('entry guard', () => {\n336:   it('runs the CLI when it is launched through a symlink', () => {\n337:     const dir = mkdtempSync(join(tmpdir(), 'skilled-behaviour-entry-'));\n338:     try {\n339:       const runnerLink = join(dir, 'runner.mjs');\n340:       const scorerLink = join(dir, 'scorer.mjs');\n341:       symlinkSync(\n342:         fileURLToPath(new URL('../scripts/routing-accuracy/run-command-behaviour.mjs', import.meta.url)),\n343:         runnerLink,\n344:       );\n345:       symlinkSync(\n346:         fileURLToPath(new URL('../scripts/routing-accuracy/score-command-transcripts.mjs', import.meta.url)),\n347:         scorerLink,\n348:       );\n349: \n350:       const listed = spawnSync(process.execPath, [runnerLink, '--list', 'g2'], { encoding: 'utf8' });\n351:       expect(listed.status).toBe(0);\n352:       expect(listed.stdout.split('\\n')[0]).toBe('g2-deep-research-ask');\n353: \n354:       const refused = spawnSync(process.execPath, [scorerLink], { encoding: 'utf8' });\n355:       expect(refused.status).toBe(2);\n356:       expect(refused.stderr).toContain('--runtime is required with --locator');\n357:     } finally {\n358:       rmSync(dir, { recursive: true, force: true });\n359:     }\n360:   });\n361: \n362:   it('accepts the off and on arms', () => {\n363:     const runnerPath = fileURLToPath(\n364:       new URL('../scripts/routing-accuracy/run-command-behaviour.mjs', import.meta.url),\n365:     );\n366:     const off = spawnSync(process.execPath, [runnerPath, '--print-argv', 'claude', '--arm', 'off'], {\n367:       encoding: 'utf8',\n368:     });\n369:     const on = spawnSync(process.execPath, [runnerPath, '--print-argv', 'claude', '--arm', 'on'], {\n370:       encoding: 'utf8',\n371:     });\n372: \n373:     expect(off.status).toBe(0);\n374:     expect(on.status).toBe(0);\n375:   });\n376: \n377:   it('reads a run number', () => {\n378:     const runnerPath = fileURLToPath(\n379:       new URL('../scripts/routing-accuracy/run-command-behaviour.mjs', import.meta.url),\n380:     );\n381:     const accepted = spawnSync(process.execPath, [runnerPath, '--print-argv', 'claude', '--run', '2'], {\n382:       encoding: 'utf8',\n383:     });\n384:     const refused = spawnSync(process.execPath, [runnerPath, '--print-argv', 'claude', '--run', '0'], {\n385:       encoding: 'utf8',\n386:     });\n387: \n388:     expect(accepted.status).toBe(0);\n389:     expect(refused.status).toBe(2);\n390:     expect(refused.stderr).toContain('--run: a whole number from 1 is required');\n391:   });\n392: \n393:   it('names Vibe as not measured rather than unknown', () => {\n394:     const runnerPath = fileURLToPath(\n395:       new URL('../scripts/routing-accuracy/run-command-behaviour.mjs', import.meta.url),\n396:     );\n397:     const refused = spawnSync(process.execPath, [runnerPath, '--print-argv', 'vibe'], {\n398:       encoding: 'utf8',\n399:     });\n400: \n401:     expect(refused.status).toBe(2);\n402:     expect(refused.stderr).toContain('runtime vibe is not measured: ');\n403:     expect(refused.stderr).not.toContain('unknown runtime');\n404:   });\n405: });\n406: \n407: describe('arena builder', () => {\n408:   const builderPath = fileURLToPath(\n409:     new URL('../scripts/routing-accuracy/prepare-behaviour-arena.mjs', import.meta.url),\n410:   );\n411: \n412:   const makeSource = (root: string, files: Record<string, string>) => {\n413:     const source = join(root, 'source');\n414:     mkdirSync(source);\n415:     const gitRun = (args: string[]) => spawnSync('git', args, { cwd: source, encoding: 'utf8' });\n416:     expect(gitRun(['init', '-q']).status).toBe(0);\n417:     for (const [name, text] of Object.entries(files)) writeFileSync(join(source, name), text);\n418:     expect(gitRun(['add', '.']).status).toBe(0);\n419:     const committed = gitRun([\n420:       '-c',\n421:       'user.name=t',\n422:       '-c',\n423:       'user.email=t@example.invalid',\n424:       '-c',\n425:       'core.hooksPath=/dev/null',\n426:       'commit',\n427:       '-qm',\n428:       'init',\n429:     ]);\n430:     expect(committed.status).toBe(0);\n431:     return source;\n432:   };\n433: \n434:   const build = (source: string, arena: string) =>\n435:     spawnSync(process.execPath, [builderPath, '--source', source, '--dest', arena], { encoding: 'utf8' });\n436: \n437:   it('leaves a CLAUDE.md pointer git status does not list', () => {\n438:     const root = mkdtempSync(join(tmpdir(), 'skilled-behaviour-arena-'));\n439:     try {\n440:       const source = makeSource(root, { 'AGENTS.md': '# rules\\n' });\n441:       const arena = join(root, 'arena');\n442: \n443:       const built = build(source, arena);\n444: \n445:       expect(built.status).toBe(0);\n446:       expect(readFileSync(join(arena, 'CLAUDE.md'), 'utf8')).toBe('@AGENTS.md\\n');\n447:       const status = spawnSync('git', ['-C', arena, 'status', '--porcelain'], { encoding: 'utf8' });\n448:       expect(status.stdout).toBe('');\n449:     } finally {\n450:       rmSync(root, { recursive: true, force: true });\n451:     }\n452:   });\n453: \n454:   it('keeps a CLAUDE.md the source already commits', () => {\n455:     const root = mkdtempSync(join(tmpdir(), 'skilled-behaviour-arena-'));\n456:     try {\n457:       const source = makeSource(root, { 'AGENTS.md': '# rules\\n', 'CLAUDE.md': 'keep me' });\n458:       const arena = join(root, 'arena');\n459: \n460:       const built = build(source, arena);\n461: \n462:       expect(built.status).toBe(0);\n463:       expect(readFileSync(join(arena, 'CLAUDE.md'), 'utf8')).toBe('keep me');\n464:     } finally {\n465:       rmSync(root, { recursive: true, force: true });\n466:     }\n467:   });\n468: });","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file .skilled/skills/system-skill-advisor/runtime/tests/command-behaviour-guards.vitest.ts, lines 1-468\n1: // ───────────────────────────────────────────────────────────────\n2: // MODULE: Behaviour Runner Guard Tests\n3: // ───────────────────────────────────────────────────────────────\n4: \n5: import { mkdirSync, mkdtempSync, readFileSync, readdirSync, rmSync, symlinkSync, writeFileSync } from 'node:fs';\n6: import { tmpdir } from 'node:os';\n7: import { join } from 'node:path';\n8: import { fileURLToPath } from 'node:url';\n9: import { spawnSync } from 'node:child_process';\n10: import { afterEach, describe, expect, it, vi } from 'vitest';\n11: import { G2_ROWS, armFor, assertFreshRun, assertFreshRowsUnique, childEnv, freshRowsFrom, lineFixture, liveArmRefusal, offerLineFields, restorePointer } from '../scripts/routing-accuracy/run-command-behaviour.mjs';\n12: import { startedLabel } from '../scripts/routing-accuracy/score-command-transcripts.mjs';\n13: \n14: describe('childEnv', () => {\n15:   afterEach(() => {\n16:     vi.unstubAllEnvs();\n17:   });\n18: \n19:   it('passes only the allowlisted environment to a turn', () => {\n20:     vi.stubEnv('SSH_AUTH_SOCK', '/tmp/ssh-agent.sock');\n21:     vi.stubEnv('AWS_ACCESS_KEY_ID', 'AKIAIOSFODNN7EXAMPLE');\n22:     vi.stubEnv('NPM_TOKEN', 'npm-token');\n23:     vi.stubEnv('GH_TOKEN', 'gh-token');\n24:     vi.stubEnv('AI_SESSION_CHILD', '1');\n25:     vi.stubEnv('ANTHROPIC_API_KEY', 'sk-ant-example');\n26: \n27:     const env = childEnv('/tmp/gh-empty');\n28: \n29:     expect(env.SSH_AUTH_SOCK).toBeUndefined();\n30:     expect(env.AWS_ACCESS_KEY_ID).toBeUndefined();\n31:     expect(env.NPM_TOKEN).toBeUndefined();\n32:     expect(env.GH_TOKEN).toBeUndefined();\n33:     expect(env.AI_SESSION_CHILD).toBeUndefined();\n34:     expect(env.ANTHROPIC_API_KEY).toBe('sk-ant-example');\n35:     expect(env.PATH).toBe(process.env.PATH);\n36:     expect(env.HOME).toBe(process.env.HOME);\n37:     expect(env.GH_CONFIG_DIR).toBe('/tmp/gh-empty');\n38:     expect(env.GIT_TERMINAL_PROMPT).toBe('0');\n39:     expect(env.GIT_CONFIG_KEY_0).toBe('credential.helper');\n40:   });\n41: \n42:   it('switches the advisor off and on by arm', () => {\n43:     vi.stubEnv('SPECKIT_SKILL_ADVISOR_HOOK_DISABLED', '1');\n44:     vi.stubEnv('MK_SKILL_ADVISOR_PLUGIN_DISABLED', '1');\n45:     vi.stubEnv('MK_HOOKS_DISABLED', '1');\n46: \n47:     const on = childEnv('/tmp/gh-empty', 'on');\n48:     expect(on.SPECKIT_SKILL_ADVISOR_HOOK_DISABLED).toBeUndefined();\n49:     expect(on.MK_SKILL_ADVISOR_PLUGIN_DISABLED).toBeUndefined();\n50:     expect(on.MK_HOOKS_DISABLED).toBeUndefined();\n51:     expect(on.SYSTEM_SKILL_ADVISOR_HOOK_DISABLED).toBeUndefined();\n52: \n53:     const off = childEnv('/tmp/gh-empty', 'off');\n54:     expect(off.SYSTEM_SKILL_ADVISOR_HOOK_DISABLED).toBe('1');\n55:     expect(off.SYSTEM_SKILL_ADVISOR_PLUGIN_DISABLED).toBe('1');\n56:     expect(off.SPECKIT_SKILL_ADVISOR_HOOK_DISABLED).toBeUndefined();\n57:     expect(off.MK_SKILL_ADVISOR_PLUGIN_DISABLED).toBeUndefined();\n58:     expect(off.MK_HOOKS_DISABLED).toBeUndefined();\n59: \n60:     expect(childEnv('/tmp/gh-empty', 'pre')).toEqual(childEnv('/tmp/gh-empty'));\n61:   });\n62: });\n63: \n64: describe('startedLabel', () => {\n65:   it('labels a row from its own command and variant', () => {\n66:     const label = startedLabel('g2-x-custom', [\n67:       { id: 'g2-x-custom', command: '/speckit:plan', variant: 'typed', prompt: 'p' },\n68:     ]);\n69: \n70:     expect(label?.expected_command).toBe('/speckit:plan');\n71:     expect(label?.expected_policy).toBe('start');\n72:     expect(label?.prompt).toBe(':auto');\n73:   });\n74: \n75:   it('returns no label for an id no row carries', () => {\n76:     expect(startedLabel('g2-nope')).toBeNull();\n77:   });\n78: \n79:   it('labels every runner row with its command and only a typed row with :auto', () => {\n80:     for (const row of G2_ROWS) {\n81:       const label = startedLabel(row.id);\n82: \n83:       expect(['/deep:research', '/deep:review', '/speckit:complete']).toContain(label?.expected_command);\n84:       expect(label?.expected_command).toBe(row.command);\n85:       expect(label?.prompt).toBe(row.variant === 'typed' ? ':auto' : '');\n86:     }\n87:   });\n88: });\n89: \n90: describe('armFor', () => {\n91:   it('runs a started-command row picked by id under arm g2', () => {\n92:     expect(armFor({ arm: null, set: null }, ['g2-deep-review-ask'])).toBe('g2');\n93:   });\n94: \n95:   it('runs a whole started-command selection under arm g2', () => {\n96:     expect(armFor({ arm: null, set: 'g2' }, G2_ROWS.map((row) => row.id))).toBe('g2');\n97:   });\n98: \n99:   it('keeps an explicit arm over the rows it runs', () => {\n100:     expect(armFor({ arm: 'post', set: null }, ['g2-deep-review-ask'])).toBe('post');\n101:   });\n102: \n103:   it('runs a selection with no started-command row under the default arm', () => {\n104:     expect(armFor({ arm: null, set: null }, ['cmd-x'])).toBe('pre');\n105:     expect(armFor({ arm: null, set: null }, [])).toBe('pre');\n106:   });\n107: \n108:   it('refuses a selection that mixes a started-command row with another row', () => {\n109:     let refusal: { code?: string } | null = null;\n110:     try {\n111:       armFor({ arm: null, set: null }, ['g2-deep-review-ask', 'cmd-x']);\n112:     } catch (error) {\n113:       refusal = error as { code?: string };\n114:     }\n115: \n116:     expect(refusal?.code).toBe('mixed_row_arms');\n117:   });\n118: });\n119: \n120: describe('lineFixture', () => {\n121:   it('keeps the fixture a run line recorded', () => {\n122:     expect(lineFixture({ fixture: '/custom/fixture' }, '/runs/arm/g2-fixture')).toBe('/custom/fixture');\n123:   });\n124: \n125:   it('falls back to the arm folder for a line that records no fixture', () => {\n126:     expect(lineFixture({}, '/runs/arm/g2-fixture')).toBe('/runs/arm/g2-fixture');\n127:     expect(lineFixture({ fixture: '' }, '/runs/arm/g2-fixture')).toBe('/runs/arm/g2-fixture');\n128:   });\n129: });\n130: \n131: describe('offerLineFields', () => {\n132:   it('copies the offered command, its policy and where it sat', () => {\n133:     expect(\n134:       offerLineFields({\n135:         offeredCommand: '/create:readme',\n136:         offeredPolicy: 'start',\n137:         offeredAs: 'partner',\n138:         offerError: null,\n139:       }),\n140:     ).toEqual({ offeredCommand: '/create:readme', offeredPolicy: 'start', offeredAs: 'partner' });\n141:   });\n142: \n143:   it('writes null where the replay found no offer', () => {\n144:     expect(\n145:       offerLineFields({ offeredCommand: null, offeredPolicy: null, offerError: 'no_head' }),\n146:     ).toEqual({ offeredCommand: null, offeredPolicy: null, offeredAs: null });\n147:   });\n148: });\n149: \n150: describe('freshRowsFrom', () => {\n151:   const freshLine = (index: number, overrides: Record<string, unknown> = {}) => JSON.stringify({\n152:     id: `fresh-fit-${String(index).padStart(2, '0')}`,\n153:     row_type: 'plain',\n154:     split: 'fresh',\n155:     prompt: `made up request ${index}`,\n156:     ...overrides,\n157:   });\n158:   const freshText = (count: number) =>\n159:     Array.from({ length: count }, (_, offset) => freshLine(offset + 1)).join('\\n');\n160:   const refusalOf = (text: string) => {\n161:     try {\n162:       freshRowsFrom(text);\n163:       return null;\n164:     } catch (error) {\n165:       return error as { code?: string; message?: string };\n166:     }\n167:   };\n168: \n169:   it('reads 36 fresh rows from their text', () => {\n170:     const rows = freshRowsFrom(freshText(36));\n171: \n172:     expect(rows).toHaveLength(36);\n173:     expect(rows[0].id).toBe('fresh-fit-01');\n174:     expect(rows[35].id).toBe('fresh-fit-36');\n175:   });\n176: \n177:   it('refuses a set of 35 rows', () => {\n178:     expect(refusalOf(freshText(35))?.code).toBe('set_short');\n179:   });\n180: \n181:   it('refuses a holdout row by its id', () => {\n182:     const refusal = refusalOf(`${freshText(35)}\\n${freshLine(36, { split: 'holdout' })}`);\n183: \n184:     expect(refusal?.code).toBe('holdout_row');\n185:     expect(refusal?.message).toContain('fresh-fit-36');\n186:   });\n187: \n188:   it('refuses a row whose split is not fresh', () => {\n189:     const refusal = refusalOf(`${freshText(35)}\\n${freshLine(36, { split: 'tune' })}`);\n190: \n191:     expect(refusal?.code).toBe('fresh_split');\n192:     expect(refusal?.message).toContain('fresh-fit-36');\n193:   });\n194: \n195:   it('refuses a row whose id is not a fresh id', () => {\n196:     const refusal = refusalOf(`${freshText(35)}\\n${freshLine(36, { id: 'made-up-01' })}`);\n197: \n198:     expect(refusal?.code).toBe('fresh_id');\n199:     expect(refusal?.message).toContain('made-up-01');\n200:   });\n201: });\n202: \n203: describe('assertFreshRowsUnique', () => {\n204:   const refusalOf = (call: () => void) => {\n205:     try {\n206:       call();\n207:       return null;\n208:     } catch (error) {\n209:       return error as { code?: string; message?: string };\n210:     }\n211:   };\n212: \n213:   it('refuses a fresh row that repeats another row', () => {\n214:     const otherRows = [{ id: 'made-up-92', prompt: 'draft the release notes' }];\n215:     const repeated = refusalOf(() =>\n216:       assertFreshRowsUnique([{ id: 'fresh-fit-91', prompt: 'Draft  the Release notes' }], otherRows),\n217:     );\n218: \n219:     expect(repeated?.code).toBe('repeated_row');\n220:     expect(repeated?.message).toBe('fresh row fresh-fit-91 repeats row made-up-92');\n221: \n222:     const doubled = refusalOf(() =>\n223:       assertFreshRowsUnique(\n224:         [\n225:           { id: 'fresh-fit-91', prompt: 'draft the release notes' },\n226:           { id: 'fresh-fit-92', prompt: 'Draft the   release notes' },\n227:         ],\n228:         [],\n229:       ),\n230:     );\n231: \n232:     expect(doubled?.code).toBe('repeated_row');\n233:     expect(doubled?.message).toContain('fresh-fit-91');\n234:     expect(doubled?.message).toContain('fresh-fit-92');\n235: \n236:     expect(\n237:       refusalOf(() =>\n238:         assertFreshRowsUnique([{ id: 'fresh-fit-91', prompt: 'rename the other function' }], otherRows),\n239:       ),\n240:     ).toBeNull();\n241:   });\n242: });\n243: \n244: describe('assertFreshRun', () => {\n245:   const refusalOf = (options: { arm: string; run: number | null }, rowIds: string[]) => {\n246:     try {\n247:       assertFreshRun(options, rowIds);\n248:       return null;\n249:     } catch (error) {\n250:       return error as { code?: string; message?: string };\n251:     }\n252:   };\n253: \n254:   it('refuses a fresh row outside the off and on arms', () => {\n255:     expect(refusalOf({ arm: 'pre', run: 1 }, ['fresh-fit-01'])?.code).toBe('fresh_arm');\n256:   });\n257: \n258:   it('refuses a fresh row without a run number', () => {\n259:     expect(refusalOf({ arm: 'on', run: null }, ['fresh-fit-01'])?.code).toBe('fresh_run');\n260:   });\n261: \n262:   it('accepts a fresh row under an arm and a run number', () => {\n263:     expect(refusalOf({ arm: 'on', run: 2 }, ['fresh-fit-01'])).toBeNull();\n264:   });\n265: \n266:   it('accepts a corpus row with neither an arm nor a run number', () => {\n267:     expect(refusalOf({ arm: 'pre', run: null }, ['cmd-create-readme-plain-tune-01'])).toBeNull();\n268:   });\n269: });\n270: \n271: describe('liveArmRefusal', () => {\n272:   const dirs: string[] = [];\n273: \n274:   afterEach(() => {\n275:     for (const dir of dirs.splice(0)) rmSync(dir, { recursive: true, force: true });\n276:   });\n277: \n278:   it('refuses a live arm outside a marked arena', () => {\n279:     const dir = mkdtempSync(join(tmpdir(), 'skilled-behaviour-guard-'));\n280:     dirs.push(dir);\n281:     const runGit = (args: string[]) => spawnSync('git', args, { cwd: dir, encoding: 'utf8' });\n282:     expect(runGit(['init', '-q']).status).toBe(0);\n283: \n284:     expect(liveArmRefusal(dir)?.code).toBe('arena_unprepared');\n285: \n286:     writeFileSync(join(dir, '.git', 'skilled-behaviour-arena'), 'arena\\n');\n287:     expect(liveArmRefusal(dir)).toBeNull();\n288: \n289:     expect(runGit(['remote', 'add', 'origin', 'https://example.invalid/x.git']).status).toBe(0);\n290:     expect(liveArmRefusal(dir)).toEqual({ ok: false, code: 'remote_present', remotes: ['origin'] });\n291:   });\n292: });\n293: \n294: describe('restorePointer', () => {\n295:   const dirs: string[] = [];\n296: \n297:   afterEach(() => {\n298:     for (const dir of dirs.splice(0)) rmSync(dir, { recursive: true, force: true });\n299:   });\n300: \n301:   const arenaDir = () => {\n302:     const dir = mkdtempSync(join(tmpdir(), 'skilled-behaviour-pointer-'));\n303:     dirs.push(dir);\n304:     return dir;\n305:   };\n306: \n307:   it('writes back a pointer a turn edited', () => {\n308:     const dir = arenaDir();\n309:     writeFileSync(join(dir, 'CLAUDE.md'), 'rewritten rules\\n');\n310: \n311:     expect(restorePointer(dir, '@AGENTS.md\\n')).toBe(true);\n312:     expect(readFileSync(join(dir, 'CLAUDE.md'), 'utf8')).toBe('@AGENTS.md\\n');\n313:   });\n314: \n315:   it('writes back a pointer a turn deleted', () => {\n316:     const dir = arenaDir();\n317: \n318:     expect(restorePointer(dir, '@AGENTS.md\\n')).toBe(true);\n319:     expect(readFileSync(join(dir, 'CLAUDE.md'), 'utf8')).toBe('@AGENTS.md\\n');\n320:   });\n321: \n322:   it('leaves an unchanged pointer or an absent one alone', () => {\n323:     const unchanged = arenaDir();\n324:     writeFileSync(join(unchanged, 'CLAUDE.md'), '@AGENTS.md\\n');\n325: \n326:     expect(restorePointer(unchanged, '@AGENTS.md\\n')).toBe(false);\n327:     expect(readFileSync(join(unchanged, 'CLAUDE.md'), 'utf8')).toBe('@AGENTS.md\\n');\n328: \n329:     const absent = arenaDir();\n330:     expect(restorePointer(absent, null)).toBe(false);\n331:     expect(readdirSync(absent)).toEqual([]);\n332:   });\n333: });\n334: \n335: describe('entry guard', () => {\n336:   it('runs the CLI when it is launched through a symlink', () => {\n337:     const dir = mkdtempSync(join(tmpdir(), 'skilled-behaviour-entry-'));\n338:     try {\n339:       const runnerLink = join(dir, 'runner.mjs');\n340:       const scorerLink = join(dir, 'scorer.mjs');\n341:       symlinkSync(\n342:         fileURLToPath(new URL('../scripts/routing-accuracy/run-command-behaviour.mjs', import.meta.url)),\n343:         runnerLink,\n344:       );\n345:       symlinkSync(\n346:         fileURLToPath(new URL('../scripts/routing-accuracy/score-command-transcripts.mjs', import.meta.url)),\n347:         scorerLink,\n348:       );\n349: \n350:       const listed = spawnSync(process.execPath, [runnerLink, '--list', 'g2'], { encoding: 'utf8' });\n351:       expect(listed.status).toBe(0);\n352:       expect(listed.stdout.split('\\n')[0]).toBe('g2-deep-research-ask');\n353: \n354:       const refused = spawnSync(process.execPath, [scorerLink], { encoding: 'utf8' });\n355:       expect(refused.status).toBe(2);\n356:       expect(refused.stderr).toContain('--runtime is required with --locator');\n357:     } finally {\n358:       rmSync(dir, { recursive: true, force: true });\n359:     }\n360:   });\n361: \n362:   it('accepts the off and on arms', () => {\n363:     const runnerPath = fileURLToPath(\n364:       new URL('../scripts/routing-accuracy/run-command-behaviour.mjs', import.meta.url),\n365:     );\n366:     const off = spawnSync(process.execPath, [runnerPath, '--print-argv', 'claude', '--arm', 'off'], {\n367:       encoding: 'utf8',\n368:     });\n369:     const on = spawnSync(process.execPath, [runnerPath, '--print-argv', 'claude', '--arm', 'on'], {\n370:       encoding: 'utf8',\n371:     });\n372: \n373:     expect(off.status).toBe(0);\n374:     expect(on.status).toBe(0);\n375:   });\n376: \n377:   it('reads a run number', () => {\n378:     const runnerPath = fileURLToPath(\n379:       new URL('../scripts/routing-accuracy/run-command-behaviour.mjs', import.meta.url),\n380:     );\n381:     const accepted = spawnSync(process.execPath, [runnerPath, '--print-argv', 'claude', '--run', '2'], {\n382:       encoding: 'utf8',\n383:     });\n384:     const refused = spawnSync(process.execPath, [runnerPath, '--print-argv', 'claude', '--run', '0'], {\n385:       encoding: 'utf8',\n386:     });\n387: \n388:     expect(accepted.status).toBe(0);\n389:     expect(refused.status).toBe(2);\n390:     expect(refused.stderr).toContain('--run: a whole number from 1 is required');\n391:   });\n392: \n393:   it('names Vibe as not measured rather than unknown', () => {\n394:     const runnerPath = fileURLToPath(\n395:       new URL('../scripts/routing-accuracy/run-command-behaviour.mjs', import.meta.url),\n396:     );\n397:     const refused = spawnSync(process.execPath, [runnerPath, '--print-argv', 'vibe'], {\n398:       encoding: 'utf8',\n399:     });\n400: \n401:     expect(refused.status).toBe(2);\n402:     expect(refused.stderr).toContain('runtime vibe is not measured: ');\n403:     expect(refused.stderr).not.toContain('unknown runtime');\n404:   });\n405: });\n406: \n407: describe('arena builder', () => {\n408:   const builderPath = fileURLToPath(\n409:     new URL('../scripts/routing-accuracy/prepare-behaviour-arena.mjs', import.meta.url),\n410:   );\n411: \n412:   const makeSource = (root: string, files: Record<string, string>) => {\n413:     const source = join(root, 'source');\n414:     mkdirSync(source);\n415:     const gitRun = (args: string[]) => spawnSync('git', args, { cwd: source, encoding: 'utf8' });\n416:     expect(gitRun(['init', '-q']).status).toBe(0);\n417:     for (const [name, text] of Object.entries(files)) writeFileSync(join(source, name), text);\n418:     expect(gitRun(['add', '.']).status).toBe(0);\n419:     const committed = gitRun([\n420:       '-c',\n421:       'user.name=t',\n422:       '-c',\n423:       'user.email=t@example.invalid',\n424:       '-c',\n425:       'core.hooksPath=/dev/null',\n426:       'commit',\n427:       '-qm',\n428:       'init',\n429:     ]);\n430:     expect(committed.status).toBe(0);\n431:     return source;\n432:   };\n433: \n434:   const build = (source: string, arena: string) =>\n435:     spawnSync(process.execPath, [builderPath, '--source', source, '--dest', arena], { encoding: 'utf8' });\n436: \n437:   it('leaves a CLAUDE.md pointer git status does not list', () => {\n438:     const root = mkdtempSync(join(tmpdir(), 'skilled-behaviour-arena-'));\n439:     try {\n440:       const source = makeSource(root, { 'AGENTS.md': '# rules\\n' });\n441:       const arena = join(root, 'arena');\n442: \n443:       const built = build(source, arena);\n444: \n445:       expect(built.status).toBe(0);\n446:       expect(readFileSync(join(arena, 'CLAUDE.md'), 'utf8')).toBe('@AGENTS.md\\n');\n447:       const status = spawnSync('git', ['-C', arena, 'status', '--porcelain'], { encoding: 'utf8' });\n448:       expect(status.stdout).toBe('');\n449:     } finally {\n450:       rmSync(root, { recursive: true, force: true });\n451:     }\n452:   });\n453: \n454:   it('keeps a CLAUDE.md the source already commits', () => {\n455:     const root = mkdtempSync(join(tmpdir(), 'skilled-behaviour-arena-'));\n456:     try {\n457:       const source = makeSource(root, { 'AGENTS.md': '# rules\\n', 'CLAUDE.md': 'keep me' });\n458:       const arena = join(root, 'arena');\n459: \n460:       const built = build(source, arena);\n461: \n462:       expect(built.status).toBe(0);\n463:       expect(readFileSync(join(arena, 'CLAUDE.md'), 'utf8')).toBe('keep me');\n464:     } finally {\n465:       rmSync(root, { recursive: true, force: true });\n466:     }\n467:   });\n468: });"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\".skilled/skills/system-skill-advisor/runtime/tests/command-behaviour-guards.vitest.ts\"}"},"time":{"start":1794760894526,"end":1794760894915}}}}
