sor/runtime/tests/command-transcript-score.vitest.ts:1181:    expect(summary).toMatchObject({ vibe: { pre: { scored: 1, unscoredRuns: [] } } });\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":".skilled/skills/system-skill-advisor/runtime/tests/command-transcript-score.vitest.ts:24:import { loadVibeSession } from '../../../../hooks/shared/session-readers/vibe.mjs';\n.skilled/skills/system-skill-advisor/runtime/tests/command-transcript-score.vitest.ts:45:const VIBE_FIXTURE = resolve(HERE, '../../../../hooks/shared/tests/session-readers/fixtures/vibe/scratch-cwd');\n.skilled/skills/system-skill-advisor/runtime/tests/command-transcript-score.vitest.ts:209:      'vibe',\n.skilled/skills/system-skill-advisor/runtime/tests/command-transcript-score.vitest.ts:308:describe('vibeRecords', () => {\n.skilled/skills/system-skill-advisor/runtime/tests/command-transcript-score.vitest.ts:311:      scorer.vibeRecords(loadVibeSession({ transcriptPath: VIBE_FIXTURE }).entries),\n.skilled/skills/system-skill-advisor/runtime/tests/command-transcript-score.vitest.ts:312:      'vibe',\n.skilled/skills/system-skill-advisor/runtime/tests/command-transcript-score.vitest.ts:316:    expect(events[0].path).toBe('/tmp/vibe-fixture-project/proof.txt');\n.skilled/skills/system-skill-advisor/runtime/tests/command-transcript-score.vitest.ts:360:        detail: { kind: 'tool', toolName: 'vibe.todo', input: { items: [] } },\n.skilled/skills/system-skill-advisor/runtime/tests/command-transcript-score.vitest.ts:365:    const events = normalize(scorer.vibeRecords(entries), 'vibe');\n.skilled/skills/system-skill-advisor/runtime/tests/command-transcript-score.vitest.ts:1173:        runtime: 'vibe',\n.skilled/skills/system-skill-advisor/runtime/tests/command-transcript-score.vitest.ts:1181:    expect(summary).toMatchObject({ vibe: { pre: { scored: 1, unscoredRuns: [] } } });\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"grep -rn \\\"vibe\\\" .skilled/skills/system-skill-advisor/runtime/tests/command-transcript-score.vitest.ts | head -40\"}"},"time":{"start":1794760914941,"end":1794760915422}}}}
