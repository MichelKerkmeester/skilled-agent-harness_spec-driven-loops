r rather than that the run failed.\n325:  const source = runtime.locator;\n340:  return runtime.locator.kind === 'listing' || runtime.locator.kind === 'store';\n347:  return runtime.locator.kind === 'store'\n348:    ? runtime.locator.list()\n371:// confidence, so only a single added entry becomes the locator.\n383:async function firstUserText(sessionId) {\n388:      sessionId,\n405:// locator records the home the run used and the transcript stays findable from\n449:// One match is the turn's own transcript, while two leave the locator without a\n461:function claudeTranscriptPath(sessionId) {\n463:  return storedTranscriptPath(store, (name) => name === `${sessionId}.jsonl`, 1);\n469:function codexTranscriptPath(sessionId) {\n471:  return storedTranscriptPath(store, (name) => name.endsWith(`-${sessionId}.jsonl`));\n480:  return reportedId === null ? store : { sessionId: reportedId, ...store };\n483:function locatorFor(runtime, sessionId, reportedId) {\n484:  const source = runtime.locator;\n488:  if (source.kind === 'runner') return { sessionId, projectDir: PROJECT_DIR };\n493:  const locator = { sessionId: reportedId, projectDir: PROJECT_DIR };\n500:  if (transcriptPath !== null) locator.transcriptPath = transcriptPath;\n501:  return locator;\n1062:    const locator = streamLocator(runtime.locator.field ?? null);\n1063:    // The turn's own output is still shown, and the locator is read out of the\n1067:      locator.push(chunk);\n1071:    child.on('close', (exit) => settle({ exit, error: null, streamId: locator.value() }));\n1254:  const argv = runtime.buildArgv({ prompt: SAMPLE_PROMPT, sessionId: SAMPLE_SESSION_ID });\n1285:  const sessionId = randomUUID();\n1286:  const argv = job.runtime.buildArgv({ prompt: job.prompt, sessionId });\n1305:  if (reportedId === null && job.runtime.locator.kind === 'store') {\n1317:  // The locator is kept in hand because the brief reader opens the same session\n1319:  const locator = locatorFor(job.runtime, sessionId, reportedId);\n1325:    locator,\n1347:  const offer = replayOffer({ checkoutDir: PROJECT_DIR, prompt: job.prompt, sessionId });\n1352:    : await briefDelivered({ runtime: job.runtimeName, locator, loadSession: loadSharedSession });\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"grep -n \\\"locator\\\\|sessionId\\\\|session_id\\\\|--resume\\\\|--continue\\\" .skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/run-command-behaviour.mjs | head -60\"}"},"time":{"start":1794760889647,"end":1794760890278}}}}
