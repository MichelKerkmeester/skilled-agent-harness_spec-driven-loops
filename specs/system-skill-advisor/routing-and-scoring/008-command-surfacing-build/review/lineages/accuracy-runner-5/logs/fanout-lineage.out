/review-brief-5.txt in the packet first and follow it. Review the files in review/review-scope-5.txt whose area equals your lineage label without its -5 suffix, plus docs that describe them. Each finding is P0, P1 or P2 with file:line and a concrete input. Check the kill switch and direct-call switch paths, command offers on refusal, question, history or mention, Vibe journal scoring, the doctor hooks-file reading, docs against code, and holdout hygiene. Never open command-prompts.jsonl, holdout-prompts.jsonl or behaviour-fresh-prompts.jsonl except through jq del(.prompt), and print counts only. Change no code and write only inside your lineage folder.\\\",\\n  \\\"reviewScopeFiles\\\": [\\n    \\\".skilled/skills/system-skill-advisor/runtime/scripts/command-bridges/README.md\\\",\\n    \\\".skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/prepare-behaviour-arena.mjs\\\",\\n    \\\".skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/README.md\\\",\\n    \\\".skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/run-command-behaviour.mjs\\\",\\n    \\\".skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/score-command-transcripts.mjs\\\",\\n    \\\".skilled/skills/system-skill-advisor/runtime/tests/command-behaviour-guards.vitest.ts\\\",\\n    \\\".skilled/skills/system-skill-advisor/runtime/tests/command-transcript-score.vitest.ts\\\"\\n  ],\\n  \\\"severityThreshold\\\": \\\"P2\\\",\\n  \\\"crossReference\\\": {\\n    \\\"core\\\": [\\n      \\\"spec_code\\\",\\n      \\\"checklist_evidence\\\"\\n    ],\\n    \\\"overlay\\\": [\\n      \\\"skill_agent\\\",\\n      \\\"agent_cross_runtime\\\",\\n      \\\"feature_catalog_code\\\",\\n      \\\"playbook_capability\\\"\\n    ]\\n  },\\n  \\\"qualityGateThreshold\\\": true,\\n  \\\"runtimeCapabilityResolver\\\": \\\".skilled/skills/system-deep-loop/deep-review/scripts/runtime-capabilities.cjs\\\",\\n  \\\"reducerScriptPath\\\": \\\".skilled/skills/system-deep-loop/runtime/scripts/reduce-state.cjs\\\",\\n  \\\"fanout_lineage_artifact_dir\\\": \\\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/specs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/review/lineages/accuracy-runner-5\\\",\\n  \\\"fanoutLineageLabel\\\": \\\"accuracy-runner-5\\\",\\n  \\\"resource_map_present\\\": false,\\n  \\\"resource_map\\\": {\\n    \\\"emit\\\": true\\n  },\\n  \\\"fileProtection\\\": {\\n    \\\"deep-review-config.json\\\": \\\"immutable\\\",\\n    \\\"deep-review-state.jsonl\\\": \\\"append-only\\\",\\n    \\\"deep-review-findings-registry.json\\\": \\\"auto-generated\\\",\\n    \\\"deep-review-strategy.md\\\": \\\"mutable\\\",\\n    \\\"deep-review-dashboard.md\\\": \\\"auto-generated\\\",\\n    \\\".deep-review-pause\\\": \\\"operator-controlled\\\",\\n    \\\"review-report.md\\\": \\\"mutable\\\",\\n    \\\"review-report-v*.md\\\": \\\"write-once\\\",\\n    \\\"iteration-*.md\\\": \\\"write-once\\\"\\n  },\\n  \\\"reducer\\\": {\\n    \\\"enabled\\\": true,\\n    \\\"inputs\\\": [\\n      \\\"latestJSONLDelta\\\",\\n      \\\"newIterationFile\\\",\\n      \\\"priorReducedState\\\"\\n    ],\\n    \\\"outputs\\\": [\\n      \\\"findingsRegistry\\\",\\n      \\\"dashboardMetrics\\\",\\n      \\\"strategyUpdates\\\"\\n    ],\\n    \\\"metrics\\\": [\\n      \\\"dimensionsCovered\\\",\\n      \\\"findingsBySeverity\\\",\\n      \\\"openFindings\\\",\\n      \\\"resolvedFindings\\\",\\n      \\\"convergenceScore\\\"\\n    ]\\n  }\\n}\\n\"}"},"time":{"start":1794761127018,"end":1794761137607}}}}
