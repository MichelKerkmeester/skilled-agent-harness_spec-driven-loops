());\n    if (!knownFlags.includes(key)) {\n      const error = new Error(`Unknown option: --${token.slice(2)}`);\n      error.code = 'INPUT_VALIDATION';\n      throw error;\n    }\n    const next = argv[i + 1];\n    if (next === undefined || next.startsWith('--')) {\n      args[key] = true;\n    } else {\n      args[key] = next;\n      i += 1;\n    }\n  }\n  return args;\n=== usage/help ===\n44:      process.exit(status);\n46:    process.exit(signal === 'SIGINT' ? 130 : signal === 'SIGTERM' ? 143 : 1);\n164:    process.exit(1);\n201:    process.exit(2);\n213:    process.exit(2);\n222:    process.exit(2);\n226:    process.exit(2);\n293:      process.exit(2);\n512:  process.exit(outcome.ok ? 0 : 2);\n523:    process.exit(error && error.code === 'INPUT_VALIDATION' ? 3 : 1);\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"cd /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research && sed -n 1,80p .skilled/skills/system-deep-loop/runtime/scripts/append-mode-event.cjs && echo \\\"=== usage/help ===\\\" && grep -n \\\"usage\\\\|Usage\\\\|--mode\\\\|--run-directory\\\\|--event-json\\\\|exit(\\\" .skilled/skills/system-deep-loop/runtime/scripts/append-mode-event.cjs | head -60\"}"},"time":{"start":1794760631817,"end":1794760633660}}}}
