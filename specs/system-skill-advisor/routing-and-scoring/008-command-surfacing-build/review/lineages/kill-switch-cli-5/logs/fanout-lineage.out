{"type":"tool_use","timestamp":1794760700367,"sessionID":"ses_e1feefdd5ffeS4J0KdMtC6TlEK","part":{"partID":"prt_1e012f05a001kcdwMo0UQEl33i","sessionID":"ses_e1feefdd5ffeS4J0KdMtC6TlEK","messageID":"msg_1e012dcd10017Ms7oMlyo1f8Fr","type":"tool","id":"call_bdae58a21bdd4b79bfed55a2","tool":"read","state":{"status":"completed","input":{"path":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/bin/system-skill-advisor-launcher.cjs"},"output":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/bin/system-skill-advisor-launcher.cjs, lines 1-1152\n1: #!/usr/bin/env node\n2: // ╔══════════════════════════════════════════════════════════════════════════╗\n3: // ║ COMPONENT: system-skill-advisor Launcher                                     ║\n4: // ╠══════════════════════════════════════════════════════════════════════════╣\n5: // ║ PURPOSE: Prepares advisor state and launches the resident daemon child.  ║\n6: // ╚══════════════════════════════════════════════════════════════════════════╝\n7: 'use strict';\n8: \n9: // ─────────────────────────────────────────────────────────────────────────────\n10: // 1. IMPORTS\n11: // ─────────────────────────────────────────────────────────────────────────────\n12: \n13: const fs = require('fs');\n14: const path = require('path');\n15: const { spawn, spawnSync } = require('child_process');\n16: \n17: // ─────────────────────────────────────────────────────────────────────────────\n18: // 2. CONSTANTS\n19: // ─────────────────────────────────────────────────────────────────────────────\n20: \n21: const mss = loadModelServerSupervisionModule();\n22: \n23: const root = path.resolve(__dirname, '..', '..');\n24: const opencodeDir = path.join(root, '.skilled');\n25: \n26: // ─────────────────────────────────────────────────────────────────────────────\n27: // 3. ENV BOOTSTRAP HELPERS\n28: // ─────────────────────────────────────────────────────────────────────────────\n29: \n30: function loadModelServerSupervisionModule() {\n31:   try {\n32:     return require('./lib/model-server-supervision.cjs');\n33:   } catch (error) {\n34:     if (error.code !== 'MODULE_NOT_FOUND') throw error;\n35:     return null;\n36:   }\n37: }\n38: \n39: // Load project-local env overrides BEFORE spawning the daemon child. .env.local wins over\n40: // .env, both are gitignored. Existing process.env wins over file values (do not override).\n41: // Minimal parser — no external dependency.\n42: function loadEnvFile(filePath) {\n43:   if (!fs.existsSync(filePath)) return 0;\n44:   let count = 0;\n45:   const raw = fs.readFileSync(filePath, 'utf8');\n46:   for (const line of raw.split('\\n')) {\n47:     const trimmed = line.trim();\n48:     if (!trimmed || trimmed.startsWith('#')) continue;\n49:     const m = trimmed.match(/^([A-Za-z_][A-Za-z0-9_]*)\\s*=\\s*(.*)$/);\n50:     if (!m) continue;\n51:     const key = m[1];\n52:     let val = m[2];\n53:     // Strip matching outer quotes (single or double)\n54:     if ((val.startsWith('\"') && val.endsWith('\"')) || (val.startsWith(\"'\") && val.endsWith(\"'\"))) {\n55:       val = val.slice(1, -1);\n56:     }\n57:     if (!(key in process.env)) {\n58:       process.env[key] = val;\n59:       count++;\n60:     }\n61:   }\n62:   return count;\n63: }\n64: \n65: function isStrictModeDisabled(value) {\n66:   if (value === undefined || value === null) return false;\n67:   const v = String(value).trim().toLowerCase();\n68:   return v === '0' || v === 'false' || v === 'no' || v === 'off' || v === '';\n69: }\n70: for (const fname of ['.env.local', '.env']) {\n71:   const p = path.join(root, fname);\n72:   if (fs.existsSync(p)) {\n73:     const n = loadEnvFile(p);\n74:     if (n > 0) process.stderr.write(`[system-skill-advisor-launcher] loaded ${n} env(s) from ${fname}\\n`);\n75:   }\n76: }\n77: \n78: // Repo policy defaults, applied only when the environment stays silent. These\n79: // are repo policy, not code policy: the advisor's code defaults are deliberately\n80: // the safer behavior (doc-frontmatter harvest off, mutation callers fail closed),\n81: // and the repository opts into its own values here. A live environment value or\n82: // a .env entry still wins, so an operator can override or disable either one.\n83: const REPO_ENV_DEFAULTS = {\n84:   SPECKIT_ADVISOR_DOC_TRIGGERS: 'true',\n85:   SYSTEM_SKILL_ADVISOR_TRUST_DEFAULT: 'trusted',\n86: };\n87: for (const [key, value] of Object.entries(REPO_ENV_DEFAULTS)) {\n88:   if (!(key in process.env)) {\n89:     process.env[key] = value;\n90:   }\n91: }\n92: \n93: // ─────────────────────────────────────────────────────────────────────────────\n94: // 4. MODULE STATE\n95: // ─────────────────────────────────────────────────────────────────────────────\n96: \n97: let skillsDir = path.join(opencodeDir, 'skills');\n98: let kitDir = path.join(skillsDir, 'system-skill-advisor');\n99: let runtimeDir = path.join(kitDir, 'runtime');\n100: let dbDir = path.join(runtimeDir, 'database');\n101: let lockDir = path.join(dbDir, '.system-skill-advisor-launcher.lockdir');\n102: const PID_FILE_NAME = '.system-skill-advisor-launcher.json';\n103: const OWNER_LEASE_FILE_NAME = '.skill-advisor-owner.json';\n104: // Lease field telling the embedding client whether this launcher arms the shared\n105: // model server. MUST stay byte-identical to ADVISOR_LEASE_SUPERVISION_FIELD in\n106: // .skilled/skills/system-spec-kit/shared/embeddings/providers/hf-local.ts.\n107: const OWNER_LEASE_SUPERVISION_FIELD = 'supervisesModelServer';\n108: let stateFile = path.join(dbDir, PID_FILE_NAME);\n109: // Files the model server shares with its clients (pid, respawn lock, give-up marker)\n110: // live beside its socket in the short default directory the embedding client also\n111: // uses. They used to sit in the memory server's database directory, which no\n112: // longer exists and, inside a worktree, exceeds the Unix socket path limit.\n113: let modelServerFilesDir = mss ? mss.DEFAULT_MODEL_SERVER_SOCKET_DIR : '/tmp/system-hf-embed';\n114: \n115: const rel = (p) => path.relative(root, p) || '.';\n116: const sleep = (ms) => new Promise((resolve) => setTimeout(resolve, ms));\n117: const now = () => new Date().toISOString();\n118: const BOOTSTRAP_LOCK_TIMEOUT_MS = 120000;\n119: const BOOTSTRAP_LOCK_STALE_MS = 300000;\n120: const RESPAWN_REAP_GRACE_MS = 7000;\n121: // A lost owner-lease claim re-reads the winner. Running out of attempts means the\n122: // lease keeps vanishing between claim and read, which only constant churn causes.\n123: const OWNER_LEASE_CLAIM_ATTEMPTS = 3;\n124: // A new owner has no socket until its daemon finishes starting. A second launcher\n125: // waits this long from the owner lease's start for that socket before it treats the\n126: // missing socket as a dead holder. SPECKIT_LEASE_STARTUP_GRACE_MS overrides it,\n127: // clamped to the ceiling so a typo cannot stall a client for minutes.\n128: const LEASE_STARTUP_GRACE_MAX_MS = 30000;\n129: const LEASE_STARTUP_POLL_MS = 50;\n130: const SOURCE_DIRS = ['handlers', 'lib', 'schemas', 'tools'];\n131: const CHILD_ENV_ALLOWLIST = new Set([\n132:   'PATH',\n133:   'HOME',\n134:   'USER',\n135:   'LOGNAME',\n136:   'SHELL',\n137:   'TMPDIR',\n138:   'TEMP',\n139:   'TMP',\n140:   'LANG',\n141:   'LC_ALL',\n142:   'CI',\n143:   'VITEST',\n144:   'SYSTEM_SKILL_ADVISOR_DB_DIR',\n145:   'SYSTEM_SKILL_ADVISOR_TRUST_DEFAULT',\n146:   'SPECKIT_RUNTIME',\n147:   // Compiled-routing runtime flag. Without this literal key the operator's .env\n148:   // value is stripped at the process boundary and never reaches the spawned\n149:   // advisor daemon child, so the advisor can never see it to attach a compiled\n150:   // decision. One exact key, no prefix widening.\n151:   'SPECKIT_COMPILED_ROUTING',\n152:   'SPECKIT_ADVISOR_FRESHNESS',\n153:   'SPECKIT_ADVISOR_DOC_TRIGGERS',\n154:   // Trusted roots for private `local-*` skill links. The daemon resolves each\n155:   // link against these roots, so without the key it indexes no private skill.\n156:   'SPECKIT_PRIVATE_SKILL_ROOTS',\n157:   'SPECKIT_ADVISOR_BM25_LEXICAL_SHADOW',\n158:   'SPECKIT_ADVISOR_FEEDBACK_CALIBRATION_SHADOW',\n159:   // The disable switch is read by each caller in its own process and never by the\n160:   // shared daemon, so a flagged call cannot silence every later caller.\n161:   'SPECKIT_SKILL_ADVISOR_FORCE_LOCAL',\n162:   'SPECKIT_CODEX_HOOK_TIMEOUT_MS',\n163:   'SKILL_ADVISOR_DISABLE_BUILTIN_SEMANTIC',\n164:   'SPECKIT_ADVISOR_WORKSPACE_ALLOWLIST',\n165:   'SPECKIT_ADVISOR_SHADOW_DELTA_PATH',\n166:   'SPECKIT_ADVISOR_SHADOW_DELTA_ENABLED',\n167:   // Documented lane-weight tuning overrides; without these allowlist entries\n168:   // the scorer's env reader never sees them under normal daemon supervision\n169:   // and the advertised tuning path is silently dead. Both the live and the\n170:   // shadow lane-weight overrides are read by lane-registry.\n171:   'SPECKIT_ADVISOR_LANE_WEIGHTS_JSON',\n172:   'SPECKIT_ADVISOR_LANE_SHADOW_WEIGHTS_JSON',\n173:   'SPECKIT_METRICS_ENABLED',\n174:   'SPECKIT_ADVISOR_HOOK_CACHE_HIT_P95_WARN_MS',\n175:   'SPECKIT_IPC_SOCKET_DIR',\n176:   'SPECKIT_SKILL_ADVISOR_MODEL_SERVER_ENABLED',\n177:   'SPECKIT_HF_MODEL_SERVER_IDLE_TIMEOUT_MIN',\n178:   'HF_EMBEDDINGS_MODEL',\n179:   'HF_EMBED_SERVER_URL',\n180:   'SPECKIT_LAUNCHER_BRIDGE_DISABLED',\n181:   'SPECKIT_LAUNCHER_IDLE_TIMEOUT_MIN',\n182:   'SPECKIT_MAX_SECONDARY_CLIENTS',\n183:   // Dedicated skill-advisor-namespaced override for the child's MEMORY_DB_PATH\n184:   // pointer; see createChildEnv() for why the bare MEMORY_DB_PATH name is\n185:   // deliberately NOT in this allowlist (it is an ambient repo-wide name that no\n186:   // single component owns, so blindly forwarding it would silently reopen the\n187:   // cross-database path leak createChildEnv() closes).\n188:   'SYSTEM_SKILL_ADVISOR_MEMORY_DB_PATH',\n189: ]);\n190: let childProcess = null;\n191: let leaseStartedAt = null;\n192: let ownerLeasePid = null;\n193: let ownerLeaseHeartbeatTimer = null;\n194: let ownerLeaseRequired = true;\n195: let launcherShutdownInProgress = false;\n196: let pendingBootstrapReapPid = null;\n197: \n198: // ─────────────────────────────────────────────────────────────────────────────\n199: // 5. LOGGING & IPC BRIDGE HELPERS\n200: // ─────────────────────────────────────────────────────────────────────────────\n201: \n202: function log(message) {\n203:   process.stderr.write(`[system-skill-advisor-launcher] ${message}\\n`);\n204: }\n205: \n206: function loadBridgeModule() {\n207:   try {\n208:     return require('./lib/launcher-ipc-bridge.cjs');\n209:   } catch (error) {\n210:     if (error.code !== 'MODULE_NOT_FOUND') throw error;\n211:     return {\n212:       getIpcSocketPath(_serviceName, options = {}) {\n213:         if (process.env.SPECKIT_IPC_SOCKET_DIR?.startsWith('tcp://')) {\n214:           return process.env.SPECKIT_IPC_SOCKET_DIR;\n215:         }\n216:         const socketDir = process.env.SPECKIT_IPC_SOCKET_DIR\n217:           ? path.resolve(process.env.SPECKIT_IPC_SOCKET_DIR)\n218:           : path.resolve(options.dbDir ?? resolvedAdvisorDbDir());\n219:         return path.join(socketDir, 'daemon-ipc.sock');\n220:       },\n221:       resolveIpcSocketDir(_serviceName, options = {}) {\n222:         const socketDir = process.env.SPECKIT_IPC_SOCKET_DIR\n223:           ? path.resolve(process.env.SPECKIT_IPC_SOCKET_DIR)\n224:           : path.resolve(options.dbDir ?? resolvedAdvisorDbDir());\n225:         return socketDir;\n226:       },\n227:       async maybeBridgeLeaseHolder({ leaseResult, legacyReport }) {\n228:         if (process.env.SPECKIT_LAUNCHER_BRIDGE_DISABLED === '1' && legacyReport) {\n229:           legacyReport(leaseResult);\n230:           return { action: 'report', reason: 'bridge-disabled' };\n231:         }\n232:         const startedAt = leaseResult.startedAt ?? new Date(0).toISOString();\n233:         const legacyMarker = leaseResult.legacyPath ? ' (legacy path)' : '';\n234:         process.stdout.write(`LEASE_HELD_BY:${leaseResult.ownerPid} startedAt=${startedAt}${legacyMarker} (no-bridge-socket)\\n`);\n235:         return { action: 'report', reason: 'bridge-module-missing' };\n236:       },\n237:     };\n238:   }\n239: }\n240: \n241: let sessionProxyModule = null;\n242: let skillAdvisorFrameClassifier = null;\n243: \n244: function loadSessionProxyModule() {\n245:   if (sessionProxyModule) return sessionProxyModule;\n246:   try {\n247:     sessionProxyModule = require('./lib/launcher-session-proxy.cjs');\n248:     return sessionProxyModule;\n249:   } catch (error) {\n250:     if (error.code !== 'MODULE_NOT_FOUND') throw error;\n251:     return null;\n252:   }\n253: }\n254: \n255: const SKILL_ADVISOR_REPLAYABLE_TOOL_NAMES = new Set([\n256:   'advisor_recommend',\n257:   'advisor_status',\n258:   'skill_graph_query',\n259:   'skill_graph_status',\n260:   'skill_graph_validate',\n261: ]);\n262: const SKILL_ADVISOR_UNSAFE_TOOL_NAMES = new Set([\n263:   // advisor_validate can persist outcome records when outcomeEvents is present, so it\n264:   // must not replay across reconnect. advisor_recommend stays replayable; one duplicate\n265:   // shadow delta is acceptable to keep routing available during backend recycle.\n266:   'advisor_validate',\n267:   'advisor_rebuild',\n268:   'skill_graph_scan',\n269:   'skill_graph_propagate_enhances',\n270: ]);\n271: \n272: function classifySkillAdvisorFrame(frame) {\n273:   const proxyModule = loadSessionProxyModule();\n274:   if (!proxyModule || typeof proxyModule.createClassifyFrame !== 'function') return false;\n275:   if (!skillAdvisorFrameClassifier) {\n276:     skillAdvisorFrameClassifier = proxyModule.createClassifyFrame({\n277:       replayableToolNames: SKILL_ADVISOR_REPLAYABLE_TOOL_NAMES,\n278:       unsafeToolNames: SKILL_ADVISOR_UNSAFE_TOOL_NAMES,\n279:     });\n280:   }\n281:   return skillAdvisorFrameClassifier(frame);\n282: }\n283: \n284: function bridgeStdioThroughSessionProxy(socketPath, options = {}) {\n285:   const proxyModule = loadSessionProxyModule();\n286:   if (!proxyModule || typeof proxyModule.createSessionProxy !== 'function') {\n287:     throw new Error('launcher-session-proxy.cjs is unavailable');\n288:   }\n289:   const createProxy = options.createProxy ?? proxyModule.createSessionProxy;\n290:   const sessionProxy = createProxy({\n291:     socketPath,\n292:     stdin: options.stdin ?? process.stdin,\n293:     stdout: options.stdout ?? process.stdout,\n294:     log,\n295:     classify: classifySkillAdvisorFrame,\n296:   });\n297:   return sessionProxy.start();\n298: }\n299: \n300: // Gate verbose error/path logging behind SYSTEM_SKILL_ADVISOR_DEBUG.\n301: // Operationally-important events keep using log(); error stacks + DB-path traces use debug().\n302: function debug(message) {\n303:   if (process.env.SYSTEM_SKILL_ADVISOR_DEBUG === '1') {\n304:     process.stderr.write(`[system-skill-advisor-launcher] [debug] ${message}\\n`);\n305:   }\n306: }\n307: \n308: // ─────────────────────────────────────────────────────────────────────────────\n309: // 6. PATH & LEASE FILE HELPERS\n310: // ─────────────────────────────────────────────────────────────────────────────\n311: \n312: function createChildEnv(sourceEnv = process.env) {\n313:   const filtered = Object.fromEntries(\n314:     Object.entries(sourceEnv).filter(([key, value]) => CHILD_ENV_ALLOWLIST.has(key) && typeof value === 'string'),\n315:   );\n316:   // Without an explicit MEMORY_DB_PATH, shared/embeddings/factory.ts's\n317:   // resolveConfiguredDatabaseCandidates() falls back to walking up from its own\n318:   // on-disk realpath, which resolves through the @spec-kit/shared symlink to that\n319:   // package's root — not this advisor's own database. Compute the child's\n320:   // MEMORY_DB_PATH explicitly from the dedicated skill-advisor override var\n321:   // (never from a blindly-forwarded ambient MEMORY_DB_PATH — that name belongs to\n322:   // no single component, so treating it as \"already configured for skill-advisor\"\n323:   // would silently reopen the exact leak this pointer exists to prevent).\n324:   const explicitOverride = typeof sourceEnv.SYSTEM_SKILL_ADVISOR_MEMORY_DB_PATH === 'string'\n325:     && sourceEnv.SYSTEM_SKILL_ADVISOR_MEMORY_DB_PATH.length > 0\n326:     ? sourceEnv.SYSTEM_SKILL_ADVISOR_MEMORY_DB_PATH\n327:     : undefined;\n328:   filtered.MEMORY_DB_PATH = explicitOverride ?? advisorDbPath();\n329:   // The child's socket directory is scoped to its database, the model server is not,\n330:   // and the child must reach the server the launcher arms.\n331:   if (mss && filtered.HF_EMBED_SERVER_URL === undefined) {\n332:     filtered.HF_EMBED_SERVER_URL = mss.resolveModelServerSocketPath(sourceEnv, { dbDir: modelServerFilesDir });\n333:   }\n334:   const bridge = loadBridgeModule();\n335:   if (typeof bridge.resolveIpcSocketDir === 'function') {\n336:     filtered.SPECKIT_IPC_SOCKET_DIR = bridge.resolveIpcSocketDir(\n337:       'system-skill-advisor',\n338:       { dbDir: resolvedAdvisorDbDir(), env: sourceEnv },\n339:     );\n340:   }\n341:   return filtered;\n342: }\n343: \n344: function refreshPaths() {\n345:   skillsDir = path.join(opencodeDir, 'skills');\n346:   kitDir = path.join(skillsDir, 'system-skill-advisor');\n347:   runtimeDir = path.join(kitDir, 'runtime');\n348:   // The state file and bootstrap lock sit beside the database this launcher\n349:   // serves. The state file shares its name with the lease file, so a launcher\n350:   // pointed at its own database would otherwise overwrite the workspace\n351:   // launcher's lease and contend for its bootstrap lock.\n352:   dbDir = process.env.SYSTEM_SKILL_ADVISOR_DB_DIR\n353:     ? path.resolve(process.env.SYSTEM_SKILL_ADVISOR_DB_DIR)\n354:     : path.join(runtimeDir, 'database');\n355:   lockDir = path.join(dbDir, '.system-skill-advisor-launcher.lockdir');\n356:   stateFile = path.join(dbDir, PID_FILE_NAME);\n357:   modelServerFilesDir = mss ? mss.DEFAULT_MODEL_SERVER_SOCKET_DIR : '/tmp/system-hf-embed';\n358: }\n359: \n360: function exists(p) {\n361:   return fs.existsSync(p);\n362: }\n363: \n364: function canonicalizePath(pathValue) {\n365:   const resolvedPath = path.resolve(pathValue);\n366:   try {\n367:     return fs.realpathSync.native(resolvedPath);\n368:   } catch (error) {\n369:     if (error.code === 'ENOENT') return resolvedPath;\n370:     throw error;\n371:   }\n372: }\n373: \n374: function ensureCanonicalDir(dirPath) {\n375:   fs.mkdirSync(canonicalizePath(dirPath), { recursive: true, mode: 0o700 });\n376:   return canonicalizePath(dirPath);\n377: }\n378: \n379: function advisorDbPath() {\n380:   return path.join(resolvedAdvisorDbDir(), 'skill-graph.sqlite');\n381: }\n382: \n383: function resolvedAdvisorDbDir() {\n384:   const overrideDbDir = process.env.SYSTEM_SKILL_ADVISOR_DB_DIR;\n385:   return overrideDbDir\n386:     ? canonicalizePath(overrideDbDir)\n387:     : canonicalizePath(dbDir);\n388: }\n389: \n390: function writeState(payload) {\n391:   ensureCanonicalDir(dbDir);\n392:   fs.writeFileSync(stateFile, `${JSON.stringify(payload, null, 2)}\\n`);\n393: }\n394: \n395: function leasePath() {\n396:   return path.join(resolvedAdvisorDbDir(), PID_FILE_NAME);\n397: }\n398: \n399: function ownerLeasePath() {\n400:   return path.join(resolvedAdvisorDbDir(), OWNER_LEASE_FILE_NAME);\n401: }\n402: \n403: function readLeaseFile(filePath = leasePath()) {\n404:   try {\n405:     const parsed = JSON.parse(fs.readFileSync(filePath, 'utf8'));\n406:     if (typeof parsed.pid === 'number') return parsed;\n407:   } catch {\n408:     // Missing or corrupt launcher lease files are treated as already clear.\n409:   }\n410:   return null;\n411: }\n412: \n413: function leaseHeldFromFile(filePath = leasePath(), legacyPath = null) {\n414:   const lease = readLeaseFile(filePath);\n415:   if (!lease) return { held: false, ownerPid: null, staleReclaimable: false, startedAt: null, legacyPath, socketPath: null };\n416:   const startedAt = lease.startedAt ?? new Date(0).toISOString();\n417:   const socketPath = typeof lease.socketPath === 'string' && lease.socketPath.length > 0 ? lease.socketPath : null;\n418:   try {\n419:     process.kill(lease.pid, 0);\n420:     return { held: true, ownerPid: lease.pid, staleReclaimable: false, startedAt, legacyPath, socketPath };\n421:   } catch (error) {\n422:     if (error.code === 'ESRCH') return { held: false, ownerPid: lease.pid, staleReclaimable: true, startedAt, legacyPath, socketPath };\n423:     if (error.code === 'EPERM') return { held: true, ownerPid: lease.pid, staleReclaimable: false, startedAt, legacyPath, socketPath };\n424:     throw error;\n425:   }\n426: }\n427: \n428: function readOwnerLeaseFile(filePath = ownerLeasePath()) {\n429:   try {\n430:     return parseOwnerLease(fs.readFileSync(filePath, 'utf8'));\n431:   } catch {\n432:     // A missing owner lease is treated as no active owner.\n433:   }\n434:   return null;\n435: }\n436: \n437: function parseOwnerLease(text) {\n438:   try {\n439:     const parsed = JSON.parse(text);\n440:     if (\n441:       Number.isInteger(parsed.ownerPid) &&\n442:       Number.isInteger(parsed.ppid) &&\n443:       typeof parsed.executablePath === 'string' &&\n444:       typeof parsed.startedAtIso === 'string' &&\n445:       typeof parsed.lastHeartbeatIso === 'string' &&\n446:       Number.isInteger(parsed.ttlMs) &&\n447:       typeof parsed.canonicalDbDir === 'string'\n448:     ) {\n449:       return parsed;\n450:     }\n451:   } catch {\n452:     // A corrupt owner lease names no owner.\n453:   }\n454:   return null;\n455: }\n456: \n457: function writeOwnerLeaseFile(lease) {\n458:   const currentLeasePath = path.join(ensureCanonicalDir(path.dirname(ownerLeasePath())), OWNER_LEASE_FILE_NAME);\n459:   const tmp = `${currentLeasePath}.tmp.${process.pid}.${Date.now()}.${Math.random().toString(36).slice(2)}`;\n460:   let fd;\n461:   try {\n462:     fd = fs.openSync(tmp, 'wx', 0o600);\n463:     fs.writeFileSync(fd, `${JSON.stringify(lease, null, 2)}\\n`, 'utf8');\n464:     fs.fsyncSync(fd);\n465:   } finally {\n466:     if (typeof fd === 'number') fs.closeSync(fd);\n467:   }\n468:   fs.renameSync(tmp, currentLeasePath);\n469: }\n470: \n471: // The lease is written to a private temp file and published with one hard link,\n472: // so the owner path is only ever absent or complete. Opening the final path with\n473: // O_EXCL and writing into it left an empty file there for the length of the write,\n474: // and a launcher racing the claim read that as a lease with no owner. link() keeps\n475: // the exclusivity O_EXCL gave: it fails with EEXIST when a holder already exists.\n476: function writeOwnerLeaseFileExclusive(lease) {\n477:   const currentLeasePath = path.join(ensureCanonicalDir(path.dirname(ownerLeasePath())), OWNER_LEASE_FILE_NAME);\n478:   const tmp = `${currentLeasePath}.tmp.${process.pid}.${Date.now()}.${Math.random().toString(36).slice(2)}`;\n479:   let fd;\n480:   try {\n481:     fd = fs.openSync(tmp, 'wx', 0o600);\n482:     fs.writeFileSync(fd, `${JSON.stringify(lease, null, 2)}\\n`, 'utf8');\n483:     fs.fsyncSync(fd);\n484:     fs.closeSync(fd);\n485:     fd = undefined;\n486:     fs.linkSync(tmp, currentLeasePath);\n487:     return true;\n488:   } catch (error) {\n489:     if (error.code === 'EEXIST') return false;\n490:     throw error;\n491:   } finally {\n492:     if (typeof fd === 'number') fs.closeSync(fd);\n493:     try {\n494:       fs.unlinkSync(tmp);\n495:     } catch {\n496:       // The temp file was never created, or is already gone.\n497:     }\n498:   }\n499: }\n500: \n501: function buildOwnerLease(ownerPid = process.pid) {\n502:   return {\n503:     ownerPid,\n504:     ppid: process.ppid,\n505:     executablePath: process.execPath,\n506:     startedAtIso: new Date().toISOString(),\n507:     lastHeartbeatIso: new Date().toISOString(),\n508:     ttlMs: 60000,\n509:     canonicalDbDir: resolvedAdvisorDbDir(),\n510:     // The client cannot see this process's environment, so the lease carries the\n511:     // answer: a launcher that will not start a server is no reason to wait for one.\n512:     // That covers the flag being off and the supervision library being absent.\n513:     [OWNER_LEASE_SUPERVISION_FIELD]: isModelServerEnabled() && Boolean(hfControl),\n514:   };\n515: }\n516: \n517: // ─────────────────────────────────────────────────────────────────────────────\n518: // 7. PROCESS LIVENESS & REAP HELPERS\n519: // ─────────────────────────────────────────────────────────────────────────────\n520: \n521: function processLiveness(pid) {\n522:   if (!Number.isInteger(pid) || pid <= 0) return 'dead';\n523:   try {\n524:     process.kill(pid, 0);\n525:     return 'alive';\n526:   } catch (error) {\n527:     if (error.code === 'ESRCH') return 'dead';\n528:     if (error.code === 'EPERM') return 'unknown-eperm';\n529:     return 'alive';\n530:   }\n531: }\n532: \n533: async function waitForPidExit(pid, timeoutMs) {\n534:   const deadline = Date.now() + timeoutMs;\n535:   while (Date.now() <= deadline) {\n536:     if (processLiveness(pid) === 'dead') return true;\n537:     await sleep(100);\n538:   }\n539:   return processLiveness(pid) === 'dead';\n540: }\n541: \n542: // Best-effort read of a live process's executable basename (comm). Returns null\n543: // when it cannot be determined (no ps, permission error, or the pid is gone), so\n544: // callers treat \"cannot prove it is the wrong process\" as \"do not skip the reap\".\n545: function readProcessExecutableBasename(pid) {\n546:   if (!Number.isInteger(pid) || pid <= 0) return null;\n547:   try {\n548:     const result = spawnSync('ps', ['-p', String(pid), '-o', 'comm='], {\n549:       encoding: 'utf8',\n550:       stdio: ['ignore', 'pipe', 'pipe'],\n551:     });\n552:     if (result.error || result.status !== 0) return null;\n553:     const comm = String(result.stdout || '').trim();\n554:     if (!comm) return null;\n555:     return path.basename(comm);\n556:   } catch {\n557:     return null;\n558:   }\n559: }\n560: \n561: async function reapOwnerBeforeRespawn(ownerPid, expectedExecutablePath = null) {\n562:   const liveness = processLiveness(ownerPid);\n563:   if (liveness === 'unknown-eperm') {\n564:     return { allowed: false, reason: 'owner-liveness-unknown-eperm' };\n565:   }\n566:   if (liveness === 'dead') {\n567:     return { allowed: true, reason: 'owner-already-dead' };\n568:   }\n569: \n570:   // Guard against PID reuse: if the recorded lease carried an executablePath and\n571:   // the live pid's executable basename provably differs, the OS recycled the pid\n572:   // to an unrelated process. Treat it as already-dead rather than SIGKILLing an\n573:   // innocent process. An indeterminate read (null) does not skip the reap.\n574:   if (typeof expectedExecutablePath === 'string' && expectedExecutablePath.length > 0) {\n575:     const expectedBasename = path.basename(expectedExecutablePath);\n576:     const actualBasename = readProcessExecutableBasename(ownerPid);\n577:     if (actualBasename !== null && actualBasename !== expectedBasename) {\n578:       log(`skill-advisor reap skipped; pid ${ownerPid} executable '${actualBasename}' != recorded '${expectedBasename}' (pid reused)`);\n579:       return { allowed: true, reason: 'owner-pid-reused' };\n580:     }\n581:   }\n582: \n583:   log(`reaping recorded skill-advisor daemon pid ${ownerPid} before respawn`);\n584:   try {\n585:     process.kill(ownerPid, 'SIGTERM');\n586:   } catch (error) {\n587:     if (error.code !== 'ESRCH') throw error;\n588:   }\n589:   const exitedAfterTerm = await waitForPidExit(ownerPid, RESPAWN_REAP_GRACE_MS);\n590:   if (!exitedAfterTerm) {\n591:     log(`skill-advisor daemon pid ${ownerPid} exceeded ${RESPAWN_REAP_GRACE_MS}ms reap grace; sending SIGKILL`);\n592:     try {\n593:       process.kill(ownerPid, 'SIGKILL');\n594:     } catch (error) {\n595:       if (error.code !== 'ESRCH') throw error;\n596:     }\n597:     await waitForPidExit(ownerPid, 1000);\n598:     if (processLiveness(ownerPid) !== 'dead') {\n599:       return { allowed: false, reason: 'owner-reap-timeout' };\n600:     }\n601:   }\n602:   return { allowed: true, reason: 'owner-reaped' };\n603: }\n604: \n605: // ─────────────────────────────────────────────────────────────────────────────\n606: // 8. OWNER LEASE LIFECYCLE HELPERS\n607: // ─────────────────────────────────────────────────────────────────────────────\n608: \n609: // The CLI starts launchers detached, so a parent pid of 1 is the normal state\n610: // of a healthy owner. Only a dead pid or a stale heartbeat makes a lease reclaimable.\n611: function classifyOwnerLease(lease) {\n612:   const liveness = processLiveness(lease.ownerPid);\n613:   if (liveness === 'dead') return 'stale-pid';\n614:   if (liveness === 'unknown-eperm') return 'unknown-eperm';\n615: \n616:   const heartbeatMs = Date.parse(lease.lastHeartbeatIso);\n617:   const ttlMs = Number.isFinite(lease.ttlMs) ? lease.ttlMs : 0;\n618:   if (!Number.isFinite(heartbeatMs) || Date.now() - heartbeatMs > ttlMs * 2) {\n619:     return 'stale-heartbeat-reclaim';\n620:   }\n621: \n622:   return 'live-owner';\n623: }\n624: \n625: // Move the lease this launcher judged reclaimable out of the way, and only if it\n626: // is still that lease. Deleting by path would also delete a live lease a peer\n627: // published after the read, leaving two launchers that each think they own it.\n628: // Returns true when the observed lease is gone and a fresh claim may proceed, and\n629: // false when the path changed, so the caller reads and classifies it again.\n630: function setAsideOwnerLease(leasePathValue, observedText) {\n631:   const claimPath = `${leasePathValue}.reclaiming.${process.pid}.${Math.random().toString(36).slice(2)}`;\n632:   try {\n633:     fs.renameSync(leasePathValue, claimPath);\n634:   } catch (error) {\n635:     if (error.code === 'ENOENT') return false;\n636:     throw error;\n637:   }\n638:   let movedText = null;\n639:   try {\n640:     movedText = fs.readFileSync(claimPath, 'utf8');\n641:   } catch {\n642:     // An unreadable moved file is handed back below, never deleted unseen.\n643:   }\n644:   if (movedText === observedText) {\n645:     fs.rmSync(claimPath, { force: true });\n646:     return true;\n647:   }\n648:   // The move took a lease published after the read. Put it back without\n649:   // replacing anything newer: link() fails with EEXIST when a third launcher\n650:   // already claimed the path, and that claim then stands.\n651:   try {\n652:     fs.linkSync(claimPath, leasePathValue);\n653:   } catch (error) {\n654:     if (error.code !== 'EEXIST') throw error;\n655:   }\n656:   fs.rmSync(claimPath, { force: true });\n657:   return false;\n658: }\n659: \n660: function acquireOwnerLeaseFile() {\n661:   const currentOwnerLeasePath = ownerLeasePath();\n662: \n663:   for (let attempt = 1; attempt <= OWNER_LEASE_CLAIM_ATTEMPTS; attempt += 1) {\n664:     // One read decides between absent and unparseable, so a lease published\n665:     // between two separate checks is never mistaken for a corrupt one.\n666:     let existingText = null;\n667:     try {\n668:       existingText = fs.readFileSync(currentOwnerLeasePath, 'utf8');\n669:     } catch (error) {\n670:       if (error.code !== 'ENOENT') throw error;\n671:     }\n672:     const existing = existingText === null ? null : parseOwnerLease(existingText);\n673:     let reclaim = false;\n674: \n675:     if (existing) {\n676:       const classification = classifyOwnerLease(existing);\n677:       if (classification === 'live-owner' || classification === 'unknown-eperm') {\n678:         return { acquired: false, holder: existing, classification };\n679:       }\n680:       log(`ownerLeaseReclaimed: ${classification} ownerPid=${existing.ownerPid}`);\n681:       reclaim = true;\n682:     } else if (existingText !== null) {\n683:       // A lease that exists but does not parse names no owner. Leases are published\n684:       // complete, so this is a damaged file, such as the empty one a writer that\n685:       // died mid-write used to leave, and it would otherwise block every exclusive\n686:       // claim with nobody to defer to.\n687:       log('ownerLeaseReclaimed: unreadable');\n688:       reclaim = true;\n689:     }\n690: \n691:     // Reclaim a stale lease by moving it aside first, then claim exclusively. This\n692:     // collapses the fresh-acquire and stale-reclaim paths into a single CAS so\n693:     // only one racer can win: the loser's exclusive create hits EEXIST instead of\n694:     // last-writer-wins overwriting the winner's lease.\n695:     if (reclaim && !setAsideOwnerLease(currentOwnerLeasePath, existingText)) continue;\n696:     const lease = buildOwnerLease(process.pid);\n697:     if (writeOwnerLeaseFileExclusive(lease)) {\n698:       ownerLeasePid = process.pid;\n699:       return { acquired: true, lease, reclaimed: existing };\n700:     }\n701:     // Lost the create. The next pass reads and classifies the winner's lease. It\n702:     // must never stand in this launcher's own lease for the holder: a launcher\n703:     // that takes itself for the live owner goes on to reap itself.\n704:   }\n705:   throw new Error(`skill-advisor owner lease stayed contended after ${OWNER_LEASE_CLAIM_ATTEMPTS} claim attempts`);\n706: }\n707: \n708: function refreshOwnerLeaseFile(ownerPid, patch = {}) {\n709:   const lease = readOwnerLeaseFile();\n710:   if (!lease || lease.ownerPid !== ownerPid) return false;\n711:   const nextOwnerPid = patch.ownerPid ?? ownerPid;\n712:   writeOwnerLeaseFile({\n713:     ...lease,\n714:     ...patch,\n715:     lastHeartbeatIso: new Date().toISOString(),\n716:   });\n717:   const reread = readOwnerLeaseFile();\n718:   if (!reread || reread.ownerPid !== nextOwnerPid) return false;\n719:   ownerLeasePid = nextOwnerPid;\n720:   return true;\n721: }\n722: \n723: function clearOwnerLeaseHeartbeat() {\n724:   if (ownerLeaseHeartbeatTimer) {\n725:     clearInterval(ownerLeaseHeartbeatTimer);\n726:     ownerLeaseHeartbeatTimer = null;\n727:   }\n728: }\n729: \n730: function startOwnerLeaseHeartbeat(ownerPid = process.pid) {\n731:   clearOwnerLeaseHeartbeat();\n732:   const lease = readOwnerLeaseFile();\n733:   const ttlMs = Number.isFinite(lease?.ttlMs) && lease.ttlMs > 0 ? lease.ttlMs : 60000;\n734:   const intervalMs = Math.max(1000, Math.floor(ttlMs / 2));\n735:   ownerLeaseHeartbeatTimer = setInterval(() => {\n736:     if (refreshOwnerLeaseFile(ownerPid)) return;\n737:     log('owner lease heartbeat refresh failed; shutting down launcher to preserve single ownership');\n738:     clearOwnerLeaseHeartbeat();\n739:     void (async () => {\n740:       // Escalate to SIGKILL if the child does not exit within the grace window —\n741:       // matching the signal-handler path. A child that hangs in async teardown would\n742:       // otherwise be orphaned alongside the successor launcher's fresh child, which is\n743:       // the exact double-ownership this branch exists to prevent.\n744:       if (isChildRunning(childProcess)) {\n745:         childProcess.kill('SIGTERM');\n746:         const exited = await waitForChildExit(childProcess, 5000);\n747:         if (!exited && isChildRunning(childProcess)) childProcess.kill('SIGKILL');\n748:       }\n749:       clearAllLeaseFiles();\n750:       process.exit(128);\n751:     })().catch(() => {\n752:       clearAllLeaseFiles();\n753:       process.exit(128);\n754:     });\n755:   }, intervalMs);\n756:   ownerLeaseHeartbeatTimer.unref?.();\n757: }\n758: \n759: function ownsOwnerLeaseFile(ownerPid = process.pid) {\n760:   const lease = readOwnerLeaseFile();\n761:   return lease?.ownerPid === ownerPid;\n762: }\n763: \n764: function clearOwnerLeaseFile() {\n765:   if (!Number.isInteger(ownerLeasePid)) return;\n766:   try {\n767:     const lease = readOwnerLeaseFile();\n768:     if (lease && lease.ownerPid === ownerLeasePid\n769:         && readOwnerLeaseFile()?.ownerPid === ownerLeasePid) {\n770:       fs.unlinkSync(ownerLeasePath());\n771:     }\n772:   } catch {\n773:     // Idempotent cleanup.\n774:   } finally {\n775:     clearOwnerLeaseHeartbeat();\n776:     ownerLeasePid = null;\n777:   }\n778: }\n779: \n780: function clearOwnerLeaseFileIfOwner(ownerPid) {\n781:   try {\n782:     const lease = readOwnerLeaseFile();\n783:     if (lease && lease.ownerPid === ownerPid\n784:         && readOwnerLeaseFile()?.ownerPid === ownerPid) {\n785:       fs.unlinkSync(ownerLeasePath());\n786:     }\n787:   } catch {\n788:     // Idempotent cleanup.\n789:   }\n790: }\n791: \n792: // ─────────────────────────────────────────────────────────────────────────────\n793: // 9. LEASE REPORTING & RESPAWN HELPERS\n794: // ─────────────────────────────────────────────────────────────────────────────\n795: \n796: function reportLeaseHeld(leaseResult) {\n797:   const startedAt = leaseResult.startedAt ?? new Date(0).toISOString();\n798:   const legacyMarker = leaseResult.legacyPath ? ' (legacy path)' : '';\n799:   process.stdout.write(`LEASE_HELD_BY:${leaseResult.ownerPid} startedAt=${startedAt}${legacyMarker}\\n`);\n800: }\n801: \n802: function writeLeaseHeldDiagnosticLine(leaseResult, suffix = '') {\n803:   const startedAt = leaseResult.startedAt ?? new Date(0).toISOString();\n804:   const legacyMarker = leaseResult.legacyPath ? ' (legacy path)' : '';\n805:   process.stdout.write(`LEASE_HELD_BY:${leaseResult.ownerPid} startedAt=${startedAt}${legacyMarker}${suffix}\\n`);\n806: }\n807: \n808: function resolveRespawnTargetPid(leaseResult) {\n809:   const lease = readLeaseFile(leaseResult.legacyPath || leasePath());\n810:   if (Number.isInteger(lease?.childPid) && lease.childPid > 0) return lease.childPid;\n811:   return Number.isInteger(leaseResult.ownerPid) && leaseResult.ownerPid > 0 ? leaseResult.ownerPid : null;\n812: }\n813: \n814: function socketPathUsable(socketPath) {\n815:   return typeof socketPath === 'string'\n816:     && socketPath.length > 0\n817:     && (socketPath.startsWith('tcp://') || fs.existsSync(socketPath));\n818: }\n819: \n820: function scheduleBootstrapReap(pid) {\n821:   if (Number.isInteger(pid) && pid > 0) {\n822:     pendingBootstrapReapPid = pid;\n823:   }\n824: }\n825: \n826: // A daemon loads its code once at launch, so a build that lands afterwards leaves\n827: // it serving the old code to every session that bridges to it until it restarts.\n828: // Only a launched daemon counts: its lease carries a childPid and a startedAt\n829: // stamped after the launcher's own build, so a launcher still bootstrapping is\n830: // never mistaken for a stale one.\n831: function launchedDaemonPredatesBuild(leaseResult) {\n832:   const lease = readLeaseFile(leaseResult.legacyPath || leasePath());\n833:   if (!lease || !Number.isInteger(lease.childPid) || lease.childPid <= 0) return false;\n834:   const launchedAtMs = Date.parse(lease.startedAt ?? '');\n835:   if (!Number.isFinite(launchedAtMs)) return false;\n836:   try {\n837:     return fs.statSync(serverEntrypoint()).mtimeMs > launchedAtMs;\n838:   } catch {\n839:     return false;\n840:   }\n841: }\n842: \n843: // The stale-build recycle runs ahead of a bridge to a live daemon, so it passes\n844: // diagnostics: false. A skipped recycle then falls back to that bridge, and a\n845: // LEASE_HELD_BY line on stdout would corrupt the session stream it carries.\n846: async function respawnAfterDeadSocket(leaseResult, decision, { diagnostics = true } = {}) {\n847:   const writeLeaseHeldDiagnostic = diagnostics ? writeLeaseHeldDiagnosticLine : () => {};\n848:   if (process.env.SPECKIT_BRIDGE_RESPAWN_DISABLED === '1') {\n849:     writeLeaseHeldDiagnostic(leaseResult, ' (dead-socket-respawn-disabled)');\n850:     return { action: 'report', reason: 'respawn-disabled', socketPath: decision.socketPath };\n851:   }\n852: \n853:   const targetPid = resolveRespawnTargetPid(leaseResult);\n854:   if (!Number.isInteger(targetPid) || targetPid <= 0) {\n855:     log('confirmed-dead socket but no recorded skill-advisor daemon pid is available; respawn inert');\n856:     writeLeaseHeldDiagnostic(leaseResult, ' (dead-socket-no-daemon-pid)');\n857:     return { action: 'report', reason: 'missing-daemon-pid', socketPath: decision.socketPath };\n858:   }\n859: \n860:   let bootstrapLockHeld = false;\n861:   try {\n862:     bootstrapLockHeld = await acquireBootstrapLock();\n863:     const currentLease = readLeaseFile(leaseResult.legacyPath || leasePath());\n864:     const currentTargetPid = Number.isInteger(currentLease?.childPid) && currentLease.childPid > 0\n865:       ? currentLease.childPid\n866:       : leaseResult.ownerPid;\n867:     if (Number.isInteger(currentTargetPid) && currentTargetPid > 0 && currentTargetPid !== targetPid) {\n868:       log('dead-socket respawn skipped; skill-advisor launcher lease changed while waiting for bootstrap lock');\n869:       writeLeaseHeldDiagnostic(leaseResult, ' (dead-socket-respawn-superseded)');\n870:       return { action: 'report', reason: 'respawn-superseded', socketPath: decision.socketPath };\n871:     }\n872: \n873:     const previousOwner = readOwnerLeaseFile();\n874:     const expectedExecutablePath = previousOwner?.ownerPid === targetPid ? previousOwner.executablePath : null;\n875:     const reapResult = await reapOwnerBeforeRespawn(targetPid, expectedExecutablePath);\n876:     if (!reapResult.allowed) {\n877:       log(`dead-socket respawn skipped; ${reapResult.reason} for daemonPid=${targetPid}`);\n878:       writeLeaseHeldDiagnostic(leaseResult, ` (dead-socket-${reapResult.reason})`);\n879:       return { action: 'report', reason: reapResult.reason, socketPath: decision.socketPath };\n880:     }\n881: \n882:     if (previousOwner?.ownerPid && previousOwner.ownerPid !== process.pid) {\n883:       await waitForPidExit(previousOwner.ownerPid, RESPAWN_REAP_GRACE_MS + 1000);\n884:       if (processLiveness(previousOwner.ownerPid) === 'dead') {\n885:         clearOwnerLeaseFileIfOwner(previousOwner.ownerPid);\n886:       }\n887:     }\n888:     clearOwnerLeaseFileIfOwner(targetPid);\n889:     if (ownsOwnerLeaseFile(process.pid)) {\n890:       clearOwnerLeaseFile();\n891:     }\n892: \n893:     const ownerLease = buildOwnerLease(process.pid);\n894:     if (!writeOwnerLeaseFileExclusive(ownerLease)) {\n895:       const holder = readOwnerLeaseFile();\n896:       log(`dead-socket respawn skipped; another launcher owns skill-advisor owner lease pid=${holder?.ownerPid ?? 'unknown'}`);\n897:       writeLeaseHeldDiagnostic(leaseResult, ' (dead-socket-respawn-owned)');\n898:       return { action: 'report', reason: 'respawn-lock-held', socketPath: decision.socketPath };\n899:     }\n900:     ownerLeasePid = process.pid;\n901:     startOwnerLeaseHeartbeat(process.pid);\n902: \n903:     buildIfNeeded([]);\n904:     leaseStartedAt = new Date().toISOString();\n905:     writeLeaseFile();\n906:     const launched = launchServer();\n907:     return launched\n908:       ? { action: 'respawn', reason: 'spawned', socketPath: decision.socketPath }\n909:       : { action: 'report', reason: 'launch-skipped', socketPath: decision.socketPath };\n910:   } finally {\n911:     if (bootstrapLockHeld) {\n912:       fs.rmSync(lockDir, { recursive: true, force: true });\n913:     }\n914:   }\n915: }\n916: \n917: function leaseResultForOwnerLease(ownerLease) {\n918:   const launcherLease = leaseHeldFromFile();\n919:   if (launcherLease.held && launcherLease.ownerPid === ownerLease.ownerPid) {\n920:     return launcherLease;\n921:   }\n922:   return {\n923:     held: true,\n924:     ownerPid: ownerLease.ownerPid,\n925:     staleReclaimable: false,\n926:     startedAt: ownerLease.startedAtIso,\n927:     legacyPath: null,\n928:     socketPath: null,\n929:   };\n930: }\n931: \n932: function leaseStartupGraceMs(env = process.env) {\n933:   const raw = Number.parseInt(env.SPECKIT_LEASE_STARTUP_GRACE_MS ?? '', 10);\n934:   if (!Number.isInteger(raw) || raw < 0) return RESPAWN_REAP_GRACE_MS;\n935:   return Math.min(raw, LEASE_STARTUP_GRACE_MAX_MS);\n936: }\n937: \n938: // Hold off the missing-socket respawn while the holder is a live owner that is\n939: // still inside its startup grace, so a second client bridges to a daemon that is\n940: // coming up instead of reaping it. Returns once the socket exists, the grace ends\n941: // or the owner dies, and the bridge decision that follows sees the result.\n942: async function waitForStartingHolderSocket(leaseResult) {\n943:   // With the bridge disabled the decision only reports the holder and never reads\n944:   // the socket, so waiting for one would only delay that report.\n945:   if (process.env.SPECKIT_LAUNCHER_BRIDGE_DISABLED === '1') return;\n946:   const ownerLease = readOwnerLeaseFile();\n947:   if (!ownerLease || ownerLease.ownerPid === process.pid || ownerLease.ownerPid !== leaseResult.ownerPid) return;\n948:   if (classifyOwnerLease(ownerLease) !== 'live-owner') return;\n949:   const startedAtMs = Date.parse(ownerLease.startedAtIso);\n950:   if (!Number.isFinite(startedAtMs)) return;\n951:   const deadline = startedAtMs + leaseStartupGraceMs();\n952:   const socketReady = () => socketPathUsable(leaseResult.socketPath) || socketPathUsable(resolveSessionProxySocketPath());\n953:   if (socketReady() || Date.now() >= deadline) return;\n954:   log(`lease holder pid=${ownerLease.ownerPid} is still starting; waiting up to ${deadline - Date.now()}ms for its socket`);\n955:   while (Date.now() < deadline) {\n956:     await sleep(LEASE_STARTUP_POLL_MS);\n957:     if (socketReady() || processLiveness(ownerLease.ownerPid) === 'dead') return;\n958:   }\n959: }\n960: \n961: async function bridgeOrReportLeaseHeld(leaseResult) {\n962:   if (process.env.SPECKIT_BRIDGE_RESPAWN_DISABLED !== '1' && launchedDaemonPredatesBuild(leaseResult)) {\n963:     log(`skill-advisor daemon for owner pid ${leaseResult.ownerPid} was launched before the current build; recycling it`);\n964:     const recycled = await respawnAfterDeadSocket(\n965:       leaseResult,\n966:       { action: 'respawn', reason: 'stale-build', socketPath: leaseResult.socketPath },\n967:       { diagnostics: false },\n968:     );\n969:     if (recycled.action === 'respawn') return recycled;\n970:     log(`stale-build recycle skipped (${recycled.reason}); bridging to the running daemon`);\n971:   }\n972:   await waitForStartingHolderSocket(leaseResult);\n973:   const { maybeBridgeLeaseHolder } = loadBridgeModule();\n974:   const decision = await maybeBridgeLeaseHolder({\n975:     serviceName: 'system-skill-advisor',\n976:     leaseResult,\n977:     loggerPrefix: 'system-skill-advisor-launcher',\n978:     dbDir: resolvedAdvisorDbDir(),\n979:     bridge: bridgeStdioThroughSessionProxy,\n980:     legacyReport: reportLeaseHeld,\n981:     respawnOnMissingSocket: true,\n982:   });\n983:   if (decision && decision.action === 'respawn') {\n984:     return await respawnAfterDeadSocket(leaseResult, decision);\n985:   }\n986:   return decision;\n987: }\n988: \n989: async function checkStrictSingleWriter() {\n990:   const ownerLeaseResult = acquireOwnerLeaseFile();\n991:   if (!ownerLeaseResult.acquired) {\n992:     log(`liveOwnerDetected: ownerPid=${ownerLeaseResult.holder.ownerPid} classification=${ownerLeaseResult.classification}`);\n993:     await bridgeOrReportLeaseHeld(leaseResultForOwnerLease(ownerLeaseResult.holder));\n994:     return true;\n995:   }\n996:   startOwnerLeaseHeartbeat(process.pid);\n997: \n998:   const launcherLease = leaseHeldFromFile();\n999:   if (launcherLease.held && !launcherLease.staleReclaimable) {\n1000:     clearOwnerLeaseFile();\n1001:     await bridgeOrReportLeaseHeld(launcherLease);\n1002:     return true;\n1003:   }\n1004:   if (launcherLease.staleReclaimable) {\n1005:     log('staleReclaimed: true');\n1006:     const staleLease = readLeaseFile();\n1007:     const staleChildPid = Number.isInteger(staleLease?.childPid) && staleLease.childPid > 0\n1008:       ? staleLease.childPid\n1009:       : null;\n1010:     if (staleChildPid && processLiveness(staleChildPid) !== 'dead') {\n1011:       const staleChildLeaseResult = {\n1012:         held: true,\n1013:         ownerPid: staleChildPid,\n1014:         staleReclaimable: false,\n1015:         startedAt: staleLease.startedAt ?? new Date(0).toISOString(),\n1016:         legacyPath: null,\n1017:         socketPath: typeof staleLease.socketPath === 'string' ? staleLease.socketPath : null,\n1018:       };\n1019:       if (socketPathUsable(staleChildLeaseResult.socketPath)) {\n1020:         const decision = await bridgeOrReportLeaseHeld(staleChildLeaseResult);\n1021:         if (decision?.action === 'bridge' || decision?.action === 'respawn') {\n1022:           return true;\n1023:         }\n1024:         if (decision?.reason !== 'no-bridge-socket') {\n1025:           clearOwnerLeaseFile();\n1026:           return true;\n1027:         }\n1028:       }\n1029:       scheduleBootstrapReap(staleChildPid);\n1030:       log(`stale launcher lease recorded live childPid=${staleChildPid}; deferring reap until bootstrap lock is held`);\n1031:     } else if (staleChildPid) {\n1032:       scheduleBootstrapReap(staleChildPid);\n1033:     }\n1034:   }\n1035: \n1036:   try {\n1037:     const daemonLeasePath = path.join(runtimeDir, 'dist', 'runtime', 'lib', 'daemon', 'lease.js');\n1038:     const leaseModule = require(daemonLeasePath);\n1039:     const leaseResult = leaseModule.isLeaseHeld(root);\n1040:     const legacyMarker = leaseResult.legacyPath ? ' (legacy path)' : '';\n1041:     if (leaseResult.held && !leaseResult.staleReclaimable) {\n1042:       clearOwnerLeaseFile();\n1043:       await bridgeOrReportLeaseHeld(leaseResult);\n1044:       return true;\n1045:     }\n1046:     if (leaseResult.staleReclaimable) {\n1047:       log(`staleReclaimed: true${legacyMarker ? ' (legacy path)' : ''}`);\n1048:     }\n1049:   } catch (error) {\n1050:     if (error.code !== 'MODULE_NOT_FOUND') {\n1051:       log(`daemon lease check failed: ${error.message}`);\n1052:     }\n1053:   }\n1054: \n1055:   return false;\n1056: }\n1057: \n1058: function resolveSessionProxySocketPath() {\n1059:   const { getIpcSocketPath } = loadBridgeModule();\n1060:   return getIpcSocketPath('system-skill-advisor', { dbDir: resolvedAdvisorDbDir() });\n1061: }\n1062: \n1063: // ─────────────────────────────────────────────────────────────────────────────\n1064: // 10. LAUNCHER LEASE FILE WRITE & CLEAR HELPERS\n1065: // ─────────────────────────────────────────────────────────────────────────────\n1066: \n1067: function writeLeaseFile(childPid = childProcess?.pid ?? null) {\n1068:   const currentLeasePath = path.join(ensureCanonicalDir(path.dirname(leasePath())), path.basename(leasePath()));\n1069:   const tmp = `${currentLeasePath}.tmp.${process.pid}`;\n1070:   if (!leaseStartedAt) leaseStartedAt = new Date().toISOString();\n1071:   const payload = {\n1072:     pid: process.pid,\n1073:     ownerPid: process.pid,\n1074:     startedAt: leaseStartedAt,\n1075:     socketPath: resolveSessionProxySocketPath(),\n1076:   };\n1077:   if (Number.isInteger(childPid) && childPid > 0) payload.childPid = childPid;\n1078:   fs.writeFileSync(tmp, JSON.stringify(payload, null, 2), { mode: 0o600 });\n1079:   fs.renameSync(tmp, currentLeasePath);\n1080: }\n1081: \n1082: function clearLeaseFile() {\n1083:   try {\n1084:     const lease = readLeaseFile();\n1085:     if (lease && (lease.pid === process.pid || lease.pid === childProcess?.pid)) {\n1086:       fs.unlinkSync(leasePath());\n1087:     }\n1088:   } catch {\n1089:     // Idempotent cleanup.\n1090:   }\n1091: }\n1092: \n1093: function clearAllLeaseFiles() {\n1094:   clearLeaseFile();\n1095:   clearOwnerLeaseFile();\n1096: }\n1097: \n1098: // ─────────────────────────────────────────────────────────────────────────────\n1099: // 11. MODEL SERVER CONTROL\n1100: // ─────────────────────────────────────────────────────────────────────────────\n1101: \n1102: // The spawn defaults to on: since the memory launcher went away this launcher is\n1103: // the only process that can arm the shared model server, so an unset flag arms\n1104: // it. An explicit 0 (or any value other than 1) turns the spawner off. An\n1105: // explicit 1 also makes a missing supervision library fatal, where the default\n1106: // leaves embedding to the other providers (Ollama first) and says so in the log.\n1107: function modelServerSetting() {\n1108:   const raw = (process.env.SPECKIT_SKILL_ADVISOR_MODEL_SERVER_ENABLED ?? '').trim();\n1109:   if (raw === '') return 'default-on';\n1110:   if (raw === '1') return 'explicit-on';\n1111:   return 'off';\n1112: }\n1113: \n1114: function isModelServerEnabled() {\n1115:   return modelServerSetting() !== 'off';\n1116: }\n1117: \n1118: function modelServerSupervisionAvailable(context) {\n1119:   if (hfControl) return true;\n1120:   if (modelServerSetting() === 'explicit-on') {\n1121:     throw new Error('SPECKIT_SKILL_ADVISOR_MODEL_SERVER_ENABLED=1 but model-server supervision lib is unavailable');\n1122:   }\n1123:   log(`model server spawn skipped (${context}): supervision lib unavailable, embeddings use the other providers`);\n1124:   return false;\n1125: }\n1126: \n1127: function requireModelServerSupervision() {\n1128:   if (!mss) {\n1129:     throw new Error('model-server-supervision.cjs is unavailable');\n1130:   }\n1131:   return mss;\n1132: }\n1133: \n1134: function resolveModelServerSocketPath(env = process.env, options = {}) {\n1135:   // No unconditional dbDir default here: when a caller doesn't supply one AND\n1136:   // neither HF_EMBED_SERVER_URL nor SPECKIT_IPC_SOCKET_DIR are set in env (the\n1137:   // exact condition reachable through the plugin bridge's filtered child env),\n1138:   // fall through to mss's own canonical short default instead of reconstructing\n1139:   // the long system-spec-kit database path, which overflows macOS's sun_path\n1140:   // limit. An explicit options.dbDir is still honored when a caller provides one.\n1141:   return requireModelServerSupervision().resolveModelServerSocketPath(env, options);\n1142: }\n1143: \n1144: // A launcher pointed at its own advisor database also gets its own model\n1145: // server. Otherwise the demand listener, pid file, respawn lock and give-up\n1146: // marker resolve from the shared socket directory, and a sandboxed launcher's\n1147: // shutdown reads the shared pid file and signals the model server that the\n1148: // workspace launcher serves. The address travels in HF_EMBED_SERVER_URL\n1149: // because this launcher, the model server it spawns and the daemon child's\n1150: // embedding client all honour it, and the daemon socket keeps its own scoping.\n1151: function pinModelServerToAdvisorDatabase(env = process.env) {\n1152:   const overrideDbDir = env.SYSTEM_SKILL_ADVISOR_DB_DIR;\n[Output truncated. Continue reading with offset: 1153]","title":"read","metadata":{"metadata":{"truncated":true},"content":[{"type":"text","text":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/bin/system-skill-advisor-launcher.cjs, lines 1-1152\n1: #!/usr/bin/env node\n2: // ╔══════════════════════════════════════════════════════════════════════════╗\n3: // ║ COMPONENT: system-skill-advisor Launcher                                     ║\n4: // ╠══════════════════════════════════════════════════════════════════════════╣\n5: // ║ PURPOSE: Prepares advisor state and launches the resident daemon child.  ║\n6: // ╚══════════════════════════════════════════════════════════════════════════╝\n7: 'use strict';\n8: \n9: // ─────────────────────────────────────────────────────────────────────────────\n10: // 1. IMPORTS\n11: // ─────────────────────────────────────────────────────────────────────────────\n12: \n13: const fs = require('fs');\n14: const path = require('path');\n15: const { spawn, spawnSync } = require('child_process');\n16: \n17: // ─────────────────────────────────────────────────────────────────────────────\n18: // 2. CONSTANTS\n19: // ─────────────────────────────────────────────────────────────────────────────\n20: \n21: const mss = loadModelServerSupervisionModule();\n22: \n23: const root = path.resolve(__dirname, '..', '..');\n24: const opencodeDir = path.join(root, '.skilled');\n25: \n26: // ─────────────────────────────────────────────────────────────────────────────\n27: // 3. ENV BOOTSTRAP HELPERS\n28: // ─────────────────────────────────────────────────────────────────────────────\n29: \n30: function loadModelServerSupervisionModule() {\n31:   try {\n32:     return require('./lib/model-server-supervision.cjs');\n33:   } catch (error) {\n34:     if (error.code !== 'MODULE_NOT_FOUND') throw error;\n35:     return null;\n36:   }\n37: }\n38: \n39: // Load project-local env overrides BEFORE spawning the daemon child. .env.local wins over\n40: // .env, both are gitignored. Existing process.env wins over file values (do not override).\n41: // Minimal parser — no external dependency.\n42: function loadEnvFile(filePath) {\n43:   if (!fs.existsSync(filePath)) return 0;\n44:   let count = 0;\n45:   const raw = fs.readFileSync(filePath, 'utf8');\n46:   for (const line of raw.split('\\n')) {\n47:     const trimmed = line.trim();\n48:     if (!trimmed || trimmed.startsWith('#')) continue;\n49:     const m = trimmed.match(/^([A-Za-z_][A-Za-z0-9_]*)\\s*=\\s*(.*)$/);\n50:     if (!m) continue;\n51:     const key = m[1];\n52:     let val = m[2];\n53:     // Strip matching outer quotes (single or double)\n54:     if ((val.startsWith('\"') && val.endsWith('\"')) || (val.startsWith(\"'\") && val.endsWith(\"'\"))) {\n55:       val = val.slice(1, -1);\n56:     }\n57:     if (!(key in process.env)) {\n58:       process.env[key] = val;\n59:       count++;\n60:     }\n61:   }\n62:   return count;\n63: }\n64: \n65: function isStrictModeDisabled(value) {\n66:   if (value === undefined || value === null) return false;\n67:   const v = String(value).trim().toLowerCase();\n68:   return v === '0' || v === 'false' || v === 'no' || v === 'off' || v === '';\n69: }\n70: for (const fname of ['.env.local', '.env']) {\n71:   const p = path.join(root, fname);\n72:   if (fs.existsSync(p)) {\n73:     const n = loadEnvFile(p);\n74:     if (n > 0) process.stderr.write(`[system-skill-advisor-launcher] loaded ${n} env(s) from ${fname}\\n`);\n75:   }\n76: }\n77: \n78: // Repo policy defaults, applied only when the environment stays silent. These\n79: // are repo policy, not code policy: the advisor's code defaults are deliberately\n80: // the safer behavior (doc-frontmatter harvest off, mutation callers fail closed),\n81: // and the repository opts into its own values here. A live environment value or\n82: // a .env entry still wins, so an operator can override or disable either one.\n83: const REPO_ENV_DEFAULTS = {\n84:   SPECKIT_ADVISOR_DOC_TRIGGERS: 'true',\n85:   SYSTEM_SKILL_ADVISOR_TRUST_DEFAULT: 'trusted',\n86: };\n87: for (const [key, value] of Object.entries(REPO_ENV_DEFAULTS)) {\n88:   if (!(key in process.env)) {\n89:     process.env[key] = value;\n90:   }\n91: }\n92: \n93: // ─────────────────────────────────────────────────────────────────────────────\n94: // 4. MODULE STATE\n95: // ─────────────────────────────────────────────────────────────────────────────\n96: \n97: let skillsDir = path.join(opencodeDir, 'skills');\n98: let kitDir = path.join(skillsDir, 'system-skill-advisor');\n99: let runtimeDir = path.join(kitDir, 'runtime');\n100: let dbDir = path.join(runtimeDir, 'database');\n101: let lockDir = path.join(dbDir, '.system-skill-advisor-launcher.lockdir');\n102: const PID_FILE_NAME = '.system-skill-advisor-launcher.json';\n103: const OWNER_LEASE_FILE_NAME = '.skill-advisor-owner.json';\n104: // Lease field telling the embedding client whether this launcher arms the shared\n105: // model server. MUST stay byte-identical to ADVISOR_LEASE_SUPERVISION_FIELD in\n106: // .skilled/skills/system-spec-kit/shared/embeddings/providers/hf-local.ts.\n107: const OWNER_LEASE_SUPERVISION_FIELD = 'supervisesModelServer';\n108: let stateFile = path.join(dbDir, PID_FILE_NAME);\n109: // Files the model server shares with its clients (pid, respawn lock, give-up marker)\n110: // live beside its socket in the short default directory the embedding client also\n111: // uses. They used to sit in the memory server's database directory, which no\n112: // longer exists and, inside a worktree, exceeds the Unix socket path limit.\n113: let modelServerFilesDir = mss ? mss.DEFAULT_MODEL_SERVER_SOCKET_DIR : '/tmp/system-hf-embed';\n114: \n115: const rel = (p) => path.relative(root, p) || '.';\n116: const sleep = (ms) => new Promise((resolve) => setTimeout(resolve, ms));\n117: const now = () => new Date().toISOString();\n118: const BOOTSTRAP_LOCK_TIMEOUT_MS = 120000;\n119: const BOOTSTRAP_LOCK_STALE_MS = 300000;\n120: const RESPAWN_REAP_GRACE_MS = 7000;\n121: // A lost owner-lease claim re-reads the winner. Running out of attempts means the\n122: // lease keeps vanishing between claim and read, which only constant churn causes.\n123: const OWNER_LEASE_CLAIM_ATTEMPTS = 3;\n124: // A new owner has no socket until its daemon finishes starting. A second launcher\n125: // waits this long from the owner lease's start for that socket before it treats the\n126: // missing socket as a dead holder. SPECKIT_LEASE_STARTUP_GRACE_MS overrides it,\n127: // clamped to the ceiling so a typo cannot stall a client for minutes.\n128: const LEASE_STARTUP_GRACE_MAX_MS = 30000;\n129: const LEASE_STARTUP_POLL_MS = 50;\n130: const SOURCE_DIRS = ['handlers', 'lib', 'schemas', 'tools'];\n131: const CHILD_ENV_ALLOWLIST = new Set([\n132:   'PATH',\n133:   'HOME',\n134:   'USER',\n135:   'LOGNAME',\n136:   'SHELL',\n137:   'TMPDIR',\n138:   'TEMP',\n139:   'TMP',\n140:   'LANG',\n141:   'LC_ALL',\n142:   'CI',\n143:   'VITEST',\n144:   'SYSTEM_SKILL_ADVISOR_DB_DIR',\n145:   'SYSTEM_SKILL_ADVISOR_TRUST_DEFAULT',\n146:   'SPECKIT_RUNTIME',\n147:   // Compiled-routing runtime flag. Without this literal key the operator's .env\n148:   // value is stripped at the process boundary and never reaches the spawned\n149:   // advisor daemon child, so the advisor can never see it to attach a compiled\n150:   // decision. One exact key, no prefix widening.\n151:   'SPECKIT_COMPILED_ROUTING',\n152:   'SPECKIT_ADVISOR_FRESHNESS',\n153:   'SPECKIT_ADVISOR_DOC_TRIGGERS',\n154:   // Trusted roots for private `local-*` skill links. The daemon resolves each\n155:   // link against these roots, so without the key it indexes no private skill.\n156:   'SPECKIT_PRIVATE_SKILL_ROOTS',\n157:   'SPECKIT_ADVISOR_BM25_LEXICAL_SHADOW',\n158:   'SPECKIT_ADVISOR_FEEDBACK_CALIBRATION_SHADOW',\n159:   // The disable switch is read by each caller in its own process and never by the\n160:   // shared daemon, so a flagged call cannot silence every later caller.\n161:   'SPECKIT_SKILL_ADVISOR_FORCE_LOCAL',\n162:   'SPECKIT_CODEX_HOOK_TIMEOUT_MS',\n163:   'SKILL_ADVISOR_DISABLE_BUILTIN_SEMANTIC',\n164:   'SPECKIT_ADVISOR_WORKSPACE_ALLOWLIST',\n165:   'SPECKIT_ADVISOR_SHADOW_DELTA_PATH',\n166:   'SPECKIT_ADVISOR_SHADOW_DELTA_ENABLED',\n167:   // Documented lane-weight tuning overrides; without these allowlist entries\n168:   // the scorer's env reader never sees them under normal daemon supervision\n169:   // and the advertised tuning path is silently dead. Both the live and the\n170:   // shadow lane-weight overrides are read by lane-registry.\n171:   'SPECKIT_ADVISOR_LANE_WEIGHTS_JSON',\n172:   'SPECKIT_ADVISOR_LANE_SHADOW_WEIGHTS_JSON',\n173:   'SPECKIT_METRICS_ENABLED',\n174:   'SPECKIT_ADVISOR_HOOK_CACHE_HIT_P95_WARN_MS',\n175:   'SPECKIT_IPC_SOCKET_DIR',\n176:   'SPECKIT_SKILL_ADVISOR_MODEL_SERVER_ENABLED',\n177:   'SPECKIT_HF_MODEL_SERVER_IDLE_TIMEOUT_MIN',\n178:   'HF_EMBEDDINGS_MODEL',\n179:   'HF_EMBED_SERVER_URL',\n180:   'SPECKIT_LAUNCHER_BRIDGE_DISABLED',\n181:   'SPECKIT_LAUNCHER_IDLE_TIMEOUT_MIN',\n182:   'SPECKIT_MAX_SECONDARY_CLIENTS',\n183:   // Dedicated skill-advisor-namespaced override for the child's MEMORY_DB_PATH\n184:   // pointer; see createChildEnv() for why the bare MEMORY_DB_PATH name is\n185:   // deliberately NOT in this allowlist (it is an ambient repo-wide name that no\n186:   // single component owns, so blindly forwarding it would silently reopen the\n187:   // cross-database path leak createChildEnv() closes).\n188:   'SYSTEM_SKILL_ADVISOR_MEMORY_DB_PATH',\n189: ]);\n190: let childProcess = null;\n191: let leaseStartedAt = null;\n192: let ownerLeasePid = null;\n193: let ownerLeaseHeartbeatTimer = null;\n194: let ownerLeaseRequired = true;\n195: let launcherShutdownInProgress = false;\n196: let pendingBootstrapReapPid = null;\n197: \n198: // ─────────────────────────────────────────────────────────────────────────────\n199: // 5. LOGGING & IPC BRIDGE HELPERS\n200: // ─────────────────────────────────────────────────────────────────────────────\n201: \n202: function log(message) {\n203:   process.stderr.write(`[system-skill-advisor-launcher] ${message}\\n`);\n204: }\n205: \n206: function loadBridgeModule() {\n207:   try {\n208:     return require('./lib/launcher-ipc-bridge.cjs');\n209:   } catch (error) {\n210:     if (error.code !== 'MODULE_NOT_FOUND') throw error;\n211:     return {\n212:       getIpcSocketPath(_serviceName, options = {}) {\n213:         if (process.env.SPECKIT_IPC_SOCKET_DIR?.startsWith('tcp://')) {\n214:           return process.env.SPECKIT_IPC_SOCKET_DIR;\n215:         }\n216:         const socketDir = process.env.SPECKIT_IPC_SOCKET_DIR\n217:           ? path.resolve(process.env.SPECKIT_IPC_SOCKET_DIR)\n218:           : path.resolve(options.dbDir ?? resolvedAdvisorDbDir());\n219:         return path.join(socketDir, 'daemon-ipc.sock');\n220:       },\n221:       resolveIpcSocketDir(_serviceName, options = {}) {\n222:         const socketDir = process.env.SPECKIT_IPC_SOCKET_DIR\n223:           ? path.resolve(process.env.SPECKIT_IPC_SOCKET_DIR)\n224:           : path.resolve(options.dbDir ?? resolvedAdvisorDbDir());\n225:         return socketDir;\n226:       },\n227:       async maybeBridgeLeaseHolder({ leaseResult, legacyReport }) {\n228:         if (process.env.SPECKIT_LAUNCHER_BRIDGE_DISABLED === '1' && legacyReport) {\n229:           legacyReport(leaseResult);\n230:           return { action: 'report', reason: 'bridge-disabled' };\n231:         }\n232:         const startedAt = leaseResult.startedAt ?? new Date(0).toISOString();\n233:         const legacyMarker = leaseResult.legacyPath ? ' (legacy path)' : '';\n234:         process.stdout.write(`LEASE_HELD_BY:${leaseResult.ownerPid} startedAt=${startedAt}${legacyMarker} (no-bridge-socket)\\n`);\n235:         return { action: 'report', reason: 'bridge-module-missing' };\n236:       },\n237:     };\n238:   }\n239: }\n240: \n241: let sessionProxyModule = null;\n242: let skillAdvisorFrameClassifier = null;\n243: \n244: function loadSessionProxyModule() {\n245:   if (sessionProxyModule) return sessionProxyModule;\n246:   try {\n247:     sessionProxyModule = require('./lib/launcher-session-proxy.cjs');\n248:     return sessionProxyModule;\n249:   } catch (error) {\n250:     if (error.code !== 'MODULE_NOT_FOUND') throw error;\n251:     return null;\n252:   }\n253: }\n254: \n255: const SKILL_ADVISOR_REPLAYABLE_TOOL_NAMES = new Set([\n256:   'advisor_recommend',\n257:   'advisor_status',\n258:   'skill_graph_query',\n259:   'skill_graph_status',\n260:   'skill_graph_validate',\n261: ]);\n262: const SKILL_ADVISOR_UNSAFE_TOOL_NAMES = new Set([\n263:   // advisor_validate can persist outcome records when outcomeEvents is present, so it\n264:   // must not replay across reconnect. advisor_recommend stays replayable; one duplicate\n265:   // shadow delta is acceptable to keep routing available during backend recycle.\n266:   'advisor_validate',\n267:   'advisor_rebuild',\n268:   'skill_graph_scan',\n269:   'skill_graph_propagate_enhances',\n270: ]);\n271: \n272: function classifySkillAdvisorFrame(frame) {\n273:   const proxyModule = loadSessionProxyModule();\n274:   if (!proxyModule || typeof proxyModule.createClassifyFrame !== 'function') return false;\n275:   if (!skillAdvisorFrameClassifier) {\n276:     skillAdvisorFrameClassifier = proxyModule.createClassifyFrame({\n277:       replayableToolNames: SKILL_ADVISOR_REPLAYABLE_TOOL_NAMES,\n278:       unsafeToolNames: SKILL_ADVISOR_UNSAFE_TOOL_NAMES,\n279:     });\n280:   }\n281:   return skillAdvisorFrameClassifier(frame);\n282: }\n283: \n284: function bridgeStdioThroughSessionProxy(socketPath, options = {}) {\n285:   const proxyModule = loadSessionProxyModule();\n286:   if (!proxyModule || typeof proxyModule.createSessionProxy !== 'function') {\n287:     throw new Error('launcher-session-proxy.cjs is unavailable');\n288:   }\n289:   const createProxy = options.createProxy ?? proxyModule.createSessionProxy;\n290:   const sessionProxy = createProxy({\n291:     socketPath,\n292:     stdin: options.stdin ?? process.stdin,\n293:     stdout: options.stdout ?? process.stdout,\n294:     log,\n295:     classify: classifySkillAdvisorFrame,\n296:   });\n297:   return sessionProxy.start();\n298: }\n299: \n300: // Gate verbose error/path logging behind SYSTEM_SKILL_ADVISOR_DEBUG.\n301: // Operationally-important events keep using log(); error stacks + DB-path traces use debug().\n302: function debug(message) {\n303:   if (process.env.SYSTEM_SKILL_ADVISOR_DEBUG === '1') {\n304:     process.stderr.write(`[system-skill-advisor-launcher] [debug] ${message}\\n`);\n305:   }\n306: }\n307: \n308: // ─────────────────────────────────────────────────────────────────────────────\n309: // 6. PATH & LEASE FILE HELPERS\n310: // ─────────────────────────────────────────────────────────────────────────────\n311: \n312: function createChildEnv(sourceEnv = process.env) {\n313:   const filtered = Object.fromEntries(\n314:     Object.entries(sourceEnv).filter(([key, value]) => CHILD_ENV_ALLOWLIST.has(key) && typeof value === 'string'),\n315:   );\n316:   // Without an explicit MEMORY_DB_PATH, shared/embeddings/factory.ts's\n317:   // resolveConfiguredDatabaseCandidates() falls back to walking up from its own\n318:   // on-disk realpath, which resolves through the @spec-kit/shared symlink to that\n319:   // package's root — not this advisor's own database. Compute the child's\n320:   // MEMORY_DB_PATH explicitly from the dedicated skill-advisor override var\n321:   // (never from a blindly-forwarded ambient MEMORY_DB_PATH — that name belongs to\n322:   // no single component, so treating it as \"already configured for skill-advisor\"\n323:   // would silently reopen the exact leak this pointer exists to prevent).\n324:   const explicitOverride = typeof sourceEnv.SYSTEM_SKILL_ADVISOR_MEMORY_DB_PATH === 'string'\n325:     && sourceEnv.SYSTEM_SKILL_ADVISOR_MEMORY_DB_PATH.length > 0\n326:     ? sourceEnv.SYSTEM_SKILL_ADVISOR_MEMORY_DB_PATH\n327:     : undefined;\n328:   filtered.MEMORY_DB_PATH = explicitOverride ?? advisorDbPath();\n329:   // The child's socket directory is scoped to its database, the model server is not,\n330:   // and the child must reach the server the launcher arms.\n331:   if (mss && filtered.HF_EMBED_SERVER_URL === undefined) {\n332:     filtered.HF_EMBED_SERVER_URL = mss.resolveModelServerSocketPath(sourceEnv, { dbDir: modelServerFilesDir });\n333:   }\n334:   const bridge = loadBridgeModule();\n335:   if (typeof bridge.resolveIpcSocketDir === 'function') {\n336:     filtered.SPECKIT_IPC_SOCKET_DIR = bridge.resolveIpcSocketDir(\n337:       'system-skill-advisor',\n338:       { dbDir: resolvedAdvisorDbDir(), env: sourceEnv },\n339:     );\n340:   }\n341:   return filtered;\n342: }\n343: \n344: function refreshPaths() {\n345:   skillsDir = path.join(opencodeDir, 'skills');\n346:   kitDir = path.join(skillsDir, 'system-skill-advisor');\n347:   runtimeDir = path.join(kitDir, 'runtime');\n348:   // The state file and bootstrap lock sit beside the database this launcher\n349:   // serves. The state file shares its name with the lease file, so a launcher\n350:   // pointed at its own database would otherwise overwrite the workspace\n351:   // launcher's lease and contend for its bootstrap lock.\n352:   dbDir = process.env.SYSTEM_SKILL_ADVISOR_DB_DIR\n353:     ? path.resolve(process.env.SYSTEM_SKILL_ADVISOR_DB_DIR)\n354:     : path.join(runtimeDir, 'database');\n355:   lockDir = path.join(dbDir, '.system-skill-advisor-launcher.lockdir');\n356:   stateFile = path.join(dbDir, PID_FILE_NAME);\n357:   modelServerFilesDir = mss ? mss.DEFAULT_MODEL_SERVER_SOCKET_DIR : '/tmp/system-hf-embed';\n358: }\n359: \n360: function exists(p) {\n361:   return fs.existsSync(p);\n362: }\n363: \n364: function canonicalizePath(pathValue) {\n365:   const resolvedPath = path.resolve(pathValue);\n366:   try {\n367:     return fs.realpathSync.native(resolvedPath);\n368:   } catch (error) {\n369:     if (error.code === 'ENOENT') return resolvedPath;\n370:     throw error;\n371:   }\n372: }\n373: \n374: function ensureCanonicalDir(dirPath) {\n375:   fs.mkdirSync(canonicalizePath(dirPath), { recursive: true, mode: 0o700 });\n376:   return canonicalizePath(dirPath);\n377: }\n378: \n379: function advisorDbPath() {\n380:   return path.join(resolvedAdvisorDbDir(), 'skill-graph.sqlite');\n381: }\n382: \n383: function resolvedAdvisorDbDir() {\n384:   const overrideDbDir = process.env.SYSTEM_SKILL_ADVISOR_DB_DIR;\n385:   return overrideDbDir\n386:     ? canonicalizePath(overrideDbDir)\n387:     : canonicalizePath(dbDir);\n388: }\n389: \n390: function writeState(payload) {\n391:   ensureCanonicalDir(dbDir);\n392:   fs.writeFileSync(stateFile, `${JSON.stringify(payload, null, 2)}\\n`);\n393: }\n394: \n395: function leasePath() {\n396:   return path.join(resolvedAdvisorDbDir(), PID_FILE_NAME);\n397: }\n398: \n399: function ownerLeasePath() {\n400:   return path.join(resolvedAdvisorDbDir(), OWNER_LEASE_FILE_NAME);\n401: }\n402: \n403: function readLeaseFile(filePath = leasePath()) {\n404:   try {\n405:     const parsed = JSON.parse(fs.readFileSync(filePath, 'utf8'));\n406:     if (typeof parsed.pid === 'number') return parsed;\n407:   } catch {\n408:     // Missing or corrupt launcher lease files are treated as already clear.\n409:   }\n410:   return null;\n411: }\n412: \n413: function leaseHeldFromFile(filePath = leasePath(), legacyPath = null) {\n414:   const lease = readLeaseFile(filePath);\n415:   if (!lease) return { held: false, ownerPid: null, staleReclaimable: false, startedAt: null, legacyPath, socketPath: null };\n416:   const startedAt = lease.startedAt ?? new Date(0).toISOString();\n417:   const socketPath = typeof lease.socketPath === 'string' && lease.socketPath.length > 0 ? lease.socketPath : null;\n418:   try {\n419:     process.kill(lease.pid, 0);\n420:     return { held: true, ownerPid: lease.pid, staleReclaimable: false, startedAt, legacyPath, socketPath };\n421:   } catch (error) {\n422:     if (error.code === 'ESRCH') return { held: false, ownerPid: lease.pid, staleReclaimable: true, startedAt, legacyPath, socketPath };\n423:     if (error.code === 'EPERM') return { held: true, ownerPid: lease.pid, staleReclaimable: false, startedAt, legacyPath, socketPath };\n424:     throw error;\n425:   }\n426: }\n427: \n428: function readOwnerLeaseFile(filePath = ownerLeasePath()) {\n429:   try {\n430:     return parseOwnerLease(fs.readFileSync(filePath, 'utf8'));\n431:   } catch {\n432:     // A missing owner lease is treated as no active owner.\n433:   }\n434:   return null;\n435: }\n436: \n437: function parseOwnerLease(text) {\n438:   try {\n439:     const parsed = JSON.parse(text);\n440:     if (\n441:       Number.isInteger(parsed.ownerPid) &&\n442:       Number.isInteger(parsed.ppid) &&\n443:       typeof parsed.executablePath === 'string' &&\n444:       typeof parsed.startedAtIso === 'string' &&\n445:       typeof parsed.lastHeartbeatIso === 'string' &&\n446:       Number.isInteger(parsed.ttlMs) &&\n447:       typeof parsed.canonicalDbDir === 'string'\n448:     ) {\n449:       return parsed;\n450:     }\n451:   } catch {\n452:     // A corrupt owner lease names no owner.\n453:   }\n454:   return null;\n455: }\n456: \n457: function writeOwnerLeaseFile(lease) {\n458:   const currentLeasePath = path.join(ensureCanonicalDir(path.dirname(ownerLeasePath())), OWNER_LEASE_FILE_NAME);\n459:   const tmp = `${currentLeasePath}.tmp.${process.pid}.${Date.now()}.${Math.random().toString(36).slice(2)}`;\n460:   let fd;\n461:   try {\n462:     fd = fs.openSync(tmp, 'wx', 0o600);\n463:     fs.writeFileSync(fd, `${JSON.stringify(lease, null, 2)}\\n`, 'utf8');\n464:     fs.fsyncSync(fd);\n465:   } finally {\n466:     if (typeof fd === 'number') fs.closeSync(fd);\n467:   }\n468:   fs.renameSync(tmp, currentLeasePath);\n469: }\n470: \n471: // The lease is written to a private temp file and published with one hard link,\n472: // so the owner path is only ever absent or complete. Opening the final path with\n473: // O_EXCL and writing into it left an empty file there for the length of the write,\n474: // and a launcher racing the claim read that as a lease with no owner. link() keeps\n475: // the exclusivity O_EXCL gave: it fails with EEXIST when a holder already exists.\n476: function writeOwnerLeaseFileExclusive(lease) {\n477:   const currentLeasePath = path.join(ensureCanonicalDir(path.dirname(ownerLeasePath())), OWNER_LEASE_FILE_NAME);\n478:   const tmp = `${currentLeasePath}.tmp.${process.pid}.${Date.now()}.${Math.random().toString(36).slice(2)}`;\n479:   let fd;\n480:   try {\n481:     fd = fs.openSync(tmp, 'wx', 0o600);\n482:     fs.writeFileSync(fd, `${JSON.stringify(lease, null, 2)}\\n`, 'utf8');\n483:     fs.fsyncSync(fd);\n484:     fs.closeSync(fd);\n485:     fd = undefined;\n486:     fs.linkSync(tmp, currentLeasePath);\n487:     return true;\n488:   } catch (error) {\n489:     if (error.code === 'EEXIST') return false;\n490:     throw error;\n491:   } finally {\n492:     if (typeof fd === 'number') fs.closeSync(fd);\n493:     try {\n494:       fs.unlinkSync(tmp);\n495:     } catch {\n496:       // The temp file was never created, or is already gone.\n497:     }\n498:   }\n499: }\n500: \n501: function buildOwnerLease(ownerPid = process.pid) {\n502:   return {\n503:     ownerPid,\n504:     ppid: process.ppid,\n505:     executablePath: process.execPath,\n506:     startedAtIso: new Date().toISOString(),\n507:     lastHeartbeatIso: new Date().toISOString(),\n508:     ttlMs: 60000,\n509:     canonicalDbDir: resolvedAdvisorDbDir(),\n510:     // The client cannot see this process's environment, so the lease carries the\n511:     // answer: a launcher that will not start a server is no reason to wait for one.\n512:     // That covers the flag being off and the supervision library being absent.\n513:     [OWNER_LEASE_SUPERVISION_FIELD]: isModelServerEnabled() && Boolean(hfControl),\n514:   };\n515: }\n516: \n517: // ─────────────────────────────────────────────────────────────────────────────\n518: // 7. PROCESS LIVENESS & REAP HELPERS\n519: // ─────────────────────────────────────────────────────────────────────────────\n520: \n521: function processLiveness(pid) {\n522:   if (!Number.isInteger(pid) || pid <= 0) return 'dead';\n523:   try {\n524:     process.kill(pid, 0);\n525:     return 'alive';\n526:   } catch (error) {\n527:     if (error.code === 'ESRCH') return 'dead';\n528:     if (error.code === 'EPERM') return 'unknown-eperm';\n529:     return 'alive';\n530:   }\n531: }\n532: \n533: async function waitForPidExit(pid, timeoutMs) {\n534:   const deadline = Date.now() + timeoutMs;\n535:   while (Date.now() <= deadline) {\n536:     if (processLiveness(pid) === 'dead') return true;\n537:     await sleep(100);\n538:   }\n539:   return processLiveness(pid) === 'dead';\n540: }\n541: \n542: // Best-effort read of a live process's executable basename (comm). Returns null\n543: // when it cannot be determined (no ps, permission error, or the pid is gone), so\n544: // callers treat \"cannot prove it is the wrong process\" as \"do not skip the reap\".\n545: function readProcessExecutableBasename(pid) {\n546:   if (!Number.isInteger(pid) || pid <= 0) return null;\n547:   try {\n548:     const result = spawnSync('ps', ['-p', String(pid), '-o', 'comm='], {\n549:       encoding: 'utf8',\n550:       stdio: ['ignore', 'pipe', 'pipe'],\n551:     });\n552:     if (result.error || result.status !== 0) return null;\n553:     const comm = String(result.stdout || '').trim();\n554:     if (!comm) return null;\n555:     return path.basename(comm);\n556:   } catch {\n557:     return null;\n558:   }\n559: }\n560: \n561: async function reapOwnerBeforeRespawn(ownerPid, expectedExecutablePath = null) {\n562:   const liveness = processLiveness(ownerPid);\n563:   if (liveness === 'unknown-eperm') {\n564:     return { allowed: false, reason: 'owner-liveness-unknown-eperm' };\n565:   }\n566:   if (liveness === 'dead') {\n567:     return { allowed: true, reason: 'owner-already-dead' };\n568:   }\n569: \n570:   // Guard against PID reuse: if the recorded lease carried an executablePath and\n571:   // the live pid's executable basename provably differs, the OS recycled the pid\n572:   // to an unrelated process. Treat it as already-dead rather than SIGKILLing an\n573:   // innocent process. An indeterminate read (null) does not skip the reap.\n574:   if (typeof expectedExecutablePath === 'string' && expectedExecutablePath.length > 0) {\n575:     const expectedBasename = path.basename(expectedExecutablePath);\n576:     const actualBasename = readProcessExecutableBasename(ownerPid);\n577:     if (actualBasename !== null && actualBasename !== expectedBasename) {\n578:       log(`skill-advisor reap skipped; pid ${ownerPid} executable '${actualBasename}' != recorded '${expectedBasename}' (pid reused)`);\n579:       return { allowed: true, reason: 'owner-pid-reused' };\n580:     }\n581:   }\n582: \n583:   log(`reaping recorded skill-advisor daemon pid ${ownerPid} before respawn`);\n584:   try {\n585:     process.kill(ownerPid, 'SIGTERM');\n586:   } catch (error) {\n587:     if (error.code !== 'ESRCH') throw error;\n588:   }\n589:   const exitedAfterTerm = await waitForPidExit(ownerPid, RESPAWN_REAP_GRACE_MS);\n590:   if (!exitedAfterTerm) {\n591:     log(`skill-advisor daemon pid ${ownerPid} exceeded ${RESPAWN_REAP_GRACE_MS}ms reap grace; sending SIGKILL`);\n592:     try {\n593:       process.kill(ownerPid, 'SIGKILL');\n594:     } catch (error) {\n595:       if (error.code !== 'ESRCH') throw error;\n596:     }\n597:     await waitForPidExit(ownerPid, 1000);\n598:     if (processLiveness(ownerPid) !== 'dead') {\n599:       return { allowed: false, reason: 'owner-reap-timeout' };\n600:     }\n601:   }\n602:   return { allowed: true, reason: 'owner-reaped' };\n603: }\n604: \n605: // ─────────────────────────────────────────────────────────────────────────────\n606: // 8. OWNER LEASE LIFECYCLE HELPERS\n607: // ─────────────────────────────────────────────────────────────────────────────\n608: \n609: // The CLI starts launchers detached, so a parent pid of 1 is the normal state\n610: // of a healthy owner. Only a dead pid or a stale heartbeat makes a lease reclaimable.\n611: function classifyOwnerLease(lease) {\n612:   const liveness = processLiveness(lease.ownerPid);\n613:   if (liveness === 'dead') return 'stale-pid';\n614:   if (liveness === 'unknown-eperm') return 'unknown-eperm';\n615: \n616:   const heartbeatMs = Date.parse(lease.lastHeartbeatIso);\n617:   const ttlMs = Number.isFinite(lease.ttlMs) ? lease.ttlMs : 0;\n618:   if (!Number.isFinite(heartbeatMs) || Date.now() - heartbeatMs > ttlMs * 2) {\n619:     return 'stale-heartbeat-reclaim';\n620:   }\n621: \n622:   return 'live-owner';\n623: }\n624: \n625: // Move the lease this launcher judged reclaimable out of the way, and only if it\n626: // is still that lease. Deleting by path would also delete a live lease a peer\n627: // published after the read, leaving two launchers that each think they own it.\n628: // Returns true when the observed lease is gone and a fresh claim may proceed, and\n629: // false when the path changed, so the caller reads and classifies it again.\n630: function setAsideOwnerLease(leasePathValue, observedText) {\n631:   const claimPath = `${leasePathValue}.reclaiming.${process.pid}.${Math.random().toString(36).slice(2)}`;\n632:   try {\n633:     fs.renameSync(leasePathValue, claimPath);\n634:   } catch (error) {\n635:     if (error.code === 'ENOENT') return false;\n636:     throw error;\n637:   }\n638:   let movedText = null;\n639:   try {\n640:     movedText = fs.readFileSync(claimPath, 'utf8');\n641:   } catch {\n642:     // An unreadable moved file is handed back below, never deleted unseen.\n643:   }\n644:   if (movedText === observedText) {\n645:     fs.rmSync(claimPath, { force: true });\n646:     return true;\n647:   }\n648:   // The move took a lease published after the read. Put it back without\n649:   // replacing anything newer: link() fails with EEXIST when a third launcher\n650:   // already claimed the path, and that claim then stands.\n651:   try {\n652:     fs.linkSync(claimPath, leasePathValue);\n653:   } catch (error) {\n654:     if (error.code !== 'EEXIST') throw error;\n655:   }\n656:   fs.rmSync(claimPath, { force: true });\n657:   return false;\n658: }\n659: \n660: function acquireOwnerLeaseFile() {\n661:   const currentOwnerLeasePath = ownerLeasePath();\n662: \n663:   for (let attempt = 1; attempt <= OWNER_LEASE_CLAIM_ATTEMPTS; attempt += 1) {\n664:     // One read decides between absent and unparseable, so a lease published\n665:     // between two separate checks is never mistaken for a corrupt one.\n666:     let existingText = null;\n667:     try {\n668:       existingText = fs.readFileSync(currentOwnerLeasePath, 'utf8');\n669:     } catch (error) {\n670:       if (error.code !== 'ENOENT') throw error;\n671:     }\n672:     const existing = existingText === null ? null : parseOwnerLease(existingText);\n673:     let reclaim = false;\n674: \n675:     if (existing) {\n676:       const classification = classifyOwnerLease(existing);\n677:       if (classification === 'live-owner' || classification === 'unknown-eperm') {\n678:         return { acquired: false, holder: existing, classification };\n679:       }\n680:       log(`ownerLeaseReclaimed: ${classification} ownerPid=${existing.ownerPid}`);\n681:       reclaim = true;\n682:     } else if (existingText !== null) {\n683:       // A lease that exists but does not parse names no owner. Leases are published\n684:       // complete, so this is a damaged file, such as the empty one a writer that\n685:       // died mid-write used to leave, and it would otherwise block every exclusive\n686:       // claim with nobody to defer to.\n687:       log('ownerLeaseReclaimed: unreadable');\n688:       reclaim = true;\n689:     }\n690: \n691:     // Reclaim a stale lease by moving it aside first, then claim exclusively. This\n692:     // collapses the fresh-acquire and stale-reclaim paths into a single CAS so\n693:     // only one racer can win: the loser's exclusive create hits EEXIST instead of\n694:     // last-writer-wins overwriting the winner's lease.\n695:     if (reclaim && !setAsideOwnerLease(currentOwnerLeasePath, existingText)) continue;\n696:     const lease = buildOwnerLease(process.pid);\n697:     if (writeOwnerLeaseFileExclusive(lease)) {\n698:       ownerLeasePid = process.pid;\n699:       return { acquired: true, lease, reclaimed: existing };\n700:     }\n701:     // Lost the create. The next pass reads and classifies the winner's lease. It\n702:     // must never stand in this launcher's own lease for the holder: a launcher\n703:     // that takes itself for the live owner goes on to reap itself.\n704:   }\n705:   throw new Error(`skill-advisor owner lease stayed contended after ${OWNER_LEASE_CLAIM_ATTEMPTS} claim attempts`);\n706: }\n707: \n708: function refreshOwnerLeaseFile(ownerPid, patch = {}) {\n709:   const lease = readOwnerLeaseFile();\n710:   if (!lease || lease.ownerPid !== ownerPid) return false;\n711:   const nextOwnerPid = patch.ownerPid ?? ownerPid;\n712:   writeOwnerLeaseFile({\n713:     ...lease,\n714:     ...patch,\n715:     lastHeartbeatIso: new Date().toISOString(),\n716:   });\n717:   const reread = readOwnerLeaseFile();\n718:   if (!reread || reread.ownerPid !== nextOwnerPid) return false;\n719:   ownerLeasePid = nextOwnerPid;\n720:   return true;\n721: }\n722: \n723: function clearOwnerLeaseHeartbeat() {\n724:   if (ownerLeaseHeartbeatTimer) {\n725:     clearInterval(ownerLeaseHeartbeatTimer);\n726:     ownerLeaseHeartbeatTimer = null;\n727:   }\n728: }\n729: \n730: function startOwnerLeaseHeartbeat(ownerPid = process.pid) {\n731:   clearOwnerLeaseHeartbeat();\n732:   const lease = readOwnerLeaseFile();\n733:   const ttlMs = Number.isFinite(lease?.ttlMs) && lease.ttlMs > 0 ? lease.ttlMs : 60000;\n734:   const intervalMs = Math.max(1000, Math.floor(ttlMs / 2));\n735:   ownerLeaseHeartbeatTimer = setInterval(() => {\n736:     if (refreshOwnerLeaseFile(ownerPid)) return;\n737:     log('owner lease heartbeat refresh failed; shutting down launcher to preserve single ownership');\n738:     clearOwnerLeaseHeartbeat();\n739:     void (async () => {\n740:       // Escalate to SIGKILL if the child does not exit within the grace window —\n741:       // matching the signal-handler path. A child that hangs in async teardown would\n742:       // otherwise be orphaned alongside the successor launcher's fresh child, which is\n743:       // the exact double-ownership this branch exists to prevent.\n744:       if (isChildRunning(childProcess)) {\n745:         childProcess.kill('SIGTERM');\n746:         const exited = await waitForChildExit(childProcess, 5000);\n747:         if (!exited && isChildRunning(childProcess)) childProcess.kill('SIGKILL');\n748:       }\n749:       clearAllLeaseFiles();\n750:       process.exit(128);\n751:     })().catch(() => {\n752:       clearAllLeaseFiles();\n753:       process.exit(128);\n754:     });\n755:   }, intervalMs);\n756:   ownerLeaseHeartbeatTimer.unref?.();\n757: }\n758: \n759: function ownsOwnerLeaseFile(ownerPid = process.pid) {\n760:   const lease = readOwnerLeaseFile();\n761:   return lease?.ownerPid === ownerPid;\n762: }\n763: \n764: function clearOwnerLeaseFile() {\n765:   if (!Number.isInteger(ownerLeasePid)) return;\n766:   try {\n767:     const lease = readOwnerLeaseFile();\n768:     if (lease && lease.ownerPid === ownerLeasePid\n769:         && readOwnerLeaseFile()?.ownerPid === ownerLeasePid) {\n770:       fs.unlinkSync(ownerLeasePath());\n771:     }\n772:   } catch {\n773:     // Idempotent cleanup.\n774:   } finally {\n775:     clearOwnerLeaseHeartbeat();\n776:     ownerLeasePid = null;\n777:   }\n778: }\n779: \n780: function clearOwnerLeaseFileIfOwner(ownerPid) {\n781:   try {\n782:     const lease = readOwnerLeaseFile();\n783:     if (lease && lease.ownerPid === ownerPid\n784:         && readOwnerLeaseFile()?.ownerPid === ownerPid) {\n785:       fs.unlinkSync(ownerLeasePath());\n786:     }\n787:   } catch {\n788:     // Idempotent cleanup.\n789:   }\n790: }\n791: \n792: // ─────────────────────────────────────────────────────────────────────────────\n793: // 9. LEASE REPORTING & RESPAWN HELPERS\n794: // ─────────────────────────────────────────────────────────────────────────────\n795: \n796: function reportLeaseHeld(leaseResult) {\n797:   const startedAt = leaseResult.startedAt ?? new Date(0).toISOString();\n798:   const legacyMarker = leaseResult.legacyPath ? ' (legacy path)' : '';\n799:   process.stdout.write(`LEASE_HELD_BY:${leaseResult.ownerPid} startedAt=${startedAt}${legacyMarker}\\n`);\n800: }\n801: \n802: function writeLeaseHeldDiagnosticLine(leaseResult, suffix = '') {\n803:   const startedAt = leaseResult.startedAt ?? new Date(0).toISOString();\n804:   const legacyMarker = leaseResult.legacyPath ? ' (legacy path)' : '';\n805:   process.stdout.write(`LEASE_HELD_BY:${leaseResult.ownerPid} startedAt=${startedAt}${legacyMarker}${suffix}\\n`);\n806: }\n807: \n808: function resolveRespawnTargetPid(leaseResult) {\n809:   const lease = readLeaseFile(leaseResult.legacyPath || leasePath());\n810:   if (Number.isInteger(lease?.childPid) && lease.childPid > 0) return lease.childPid;\n811:   return Number.isInteger(leaseResult.ownerPid) && leaseResult.ownerPid > 0 ? leaseResult.ownerPid : null;\n812: }\n813: \n814: function socketPathUsable(socketPath) {\n815:   return typeof socketPath === 'string'\n816:     && socketPath.length > 0\n817:     && (socketPath.startsWith('tcp://') || fs.existsSync(socketPath));\n818: }\n819: \n820: function scheduleBootstrapReap(pid) {\n821:   if (Number.isInteger(pid) && pid > 0) {\n822:     pendingBootstrapReapPid = pid;\n823:   }\n824: }\n825: \n826: // A daemon loads its code once at launch, so a build that lands afterwards leaves\n827: // it serving the old code to every session that bridges to it until it restarts.\n828: // Only a launched daemon counts: its lease carries a childPid and a startedAt\n829: // stamped after the launcher's own build, so a launcher still bootstrapping is\n830: // never mistaken for a stale one.\n831: function launchedDaemonPredatesBuild(leaseResult) {\n832:   const lease = readLeaseFile(leaseResult.legacyPath || leasePath());\n833:   if (!lease || !Number.isInteger(lease.childPid) || lease.childPid <= 0) return false;\n834:   const launchedAtMs = Date.parse(lease.startedAt ?? '');\n835:   if (!Number.isFinite(launchedAtMs)) return false;\n836:   try {\n837:     return fs.statSync(serverEntrypoint()).mtimeMs > launchedAtMs;\n838:   } catch {\n839:     return false;\n840:   }\n841: }\n842: \n843: // The stale-build recycle runs ahead of a bridge to a live daemon, so it passes\n844: // diagnostics: false. A skipped recycle then falls back to that bridge, and a\n845: // LEASE_HELD_BY line on stdout would corrupt the session stream it carries.\n846: async function respawnAfterDeadSocket(leaseResult, decision, { diagnostics = true } = {}) {\n847:   const writeLeaseHeldDiagnostic = diagnostics ? writeLeaseHeldDiagnosticLine : () => {};\n848:   if (process.env.SPECKIT_BRIDGE_RESPAWN_DISABLED === '1') {\n849:     writeLeaseHeldDiagnostic(leaseResult, ' (dead-socket-respawn-disabled)');\n850:     return { action: 'report', reason: 'respawn-disabled', socketPath: decision.socketPath };\n851:   }\n852: \n853:   const targetPid = resolveRespawnTargetPid(leaseResult);\n854:   if (!Number.isInteger(targetPid) || targetPid <= 0) {\n855:     log('confirmed-dead socket but no recorded skill-advisor daemon pid is available; respawn inert');\n856:     writeLeaseHeldDiagnostic(leaseResult, ' (dead-socket-no-daemon-pid)');\n857:     return { action: 'report', reason: 'missing-daemon-pid', socketPath: decision.socketPath };\n858:   }\n859: \n860:   let bootstrapLockHeld = false;\n861:   try {\n862:     bootstrapLockHeld = await acquireBootstrapLock();\n863:     const currentLease = readLeaseFile(leaseResult.legacyPath || leasePath());\n864:     const currentTargetPid = Number.isInteger(currentLease?.childPid) && currentLease.childPid > 0\n865:       ? currentLease.childPid\n866:       : leaseResult.ownerPid;\n867:     if (Number.isInteger(currentTargetPid) && currentTargetPid > 0 && currentTargetPid !== targetPid) {\n868:       log('dead-socket respawn skipped; skill-advisor launcher lease changed while waiting for bootstrap lock');\n869:       writeLeaseHeldDiagnostic(leaseResult, ' (dead-socket-respawn-superseded)');\n870:       return { action: 'report', reason: 'respawn-superseded', socketPath: decision.socketPath };\n871:     }\n872: \n873:     const previousOwner = readOwnerLeaseFile();\n874:     const expectedExecutablePath = previousOwner?.ownerPid === targetPid ? previousOwner.executablePath : null;\n875:     const reapResult = await reapOwnerBeforeRespawn(targetPid, expectedExecutablePath);\n876:     if (!reapResult.allowed) {\n877:       log(`dead-socket respawn skipped; ${reapResult.reason} for daemonPid=${targetPid}`);\n878:       writeLeaseHeldDiagnostic(leaseResult, ` (dead-socket-${reapResult.reason})`);\n879:       return { action: 'report', reason: reapResult.reason, socketPath: decision.socketPath };\n880:     }\n881: \n882:     if (previousOwner?.ownerPid && previousOwner.ownerPid !== process.pid) {\n883:       await waitForPidExit(previousOwner.ownerPid, RESPAWN_REAP_GRACE_MS + 1000);\n884:       if (processLiveness(previousOwner.ownerPid) === 'dead') {\n885:         clearOwnerLeaseFileIfOwner(previousOwner.ownerPid);\n886:       }\n887:     }\n888:     clearOwnerLeaseFileIfOwner(targetPid);\n889:     if (ownsOwnerLeaseFile(process.pid)) {\n890:       clearOwnerLeaseFile();\n891:     }\n892: \n893:     const ownerLease = buildOwnerLease(process.pid);\n894:     if (!writeOwnerLeaseFileExclusive(ownerLease)) {\n895:       const holder = readOwnerLeaseFile();\n896:       log(`dead-socket respawn skipped; another launcher owns skill-advisor owner lease pid=${holder?.ownerPid ?? 'unknown'}`);\n897:       writeLeaseHeldDiagnostic(leaseResult, ' (dead-socket-respawn-owned)');\n898:       return { action: 'report', reason: 'respawn-lock-held', socketPath: decision.socketPath };\n899:     }\n900:     ownerLeasePid = process.pid;\n901:     startOwnerLeaseHeartbeat(process.pid);\n902: \n903:     buildIfNeeded([]);\n904:     leaseStartedAt = new Date().toISOString();\n905:     writeLeaseFile();\n906:     const launched = launchServer();\n907:     return launched\n908:       ? { action: 'respawn', reason: 'spawned', socketPath: decision.socketPath }\n909:       : { action: 'report', reason: 'launch-skipped', socketPath: decision.socketPath };\n910:   } finally {\n911:     if (bootstrapLockHeld) {\n912:       fs.rmSync(lockDir, { recursive: true, force: true });\n913:     }\n914:   }\n915: }\n916: \n917: function leaseResultForOwnerLease(ownerLease) {\n918:   const launcherLease = leaseHeldFromFile();\n919:   if (launcherLease.held && launcherLease.ownerPid === ownerLease.ownerPid) {\n920:     return launcherLease;\n921:   }\n922:   return {\n923:     held: true,\n924:     ownerPid: ownerLease.ownerPid,\n925:     staleReclaimable: false,\n926:     startedAt: ownerLease.startedAtIso,\n927:     legacyPath: null,\n928:     socketPath: null,\n929:   };\n930: }\n931: \n932: function leaseStartupGraceMs(env = process.env) {\n933:   const raw = Number.parseInt(env.SPECKIT_LEASE_STARTUP_GRACE_MS ?? '', 10);\n934:   if (!Number.isInteger(raw) || raw < 0) return RESPAWN_REAP_GRACE_MS;\n935:   return Math.min(raw, LEASE_STARTUP_GRACE_MAX_MS);\n936: }\n937: \n938: // Hold off the missing-socket respawn while the holder is a live owner that is\n939: // still inside its startup grace, so a second client bridges to a daemon that is\n940: // coming up instead of reaping it. Returns once the socket exists, the grace ends\n941: // or the owner dies, and the bridge decision that follows sees the result.\n942: async function waitForStartingHolderSocket(leaseResult) {\n943:   // With the bridge disabled the decision only reports the holder and never reads\n944:   // the socket, so waiting for one would only delay that report.\n945:   if (process.env.SPECKIT_LAUNCHER_BRIDGE_DISABLED === '1') return;\n946:   const ownerLease = readOwnerLeaseFile();\n947:   if (!ownerLease || ownerLease.ownerPid === process.pid || ownerLease.ownerPid !== leaseResult.ownerPid) return;\n948:   if (classifyOwnerLease(ownerLease) !== 'live-owner') return;\n949:   const startedAtMs = Date.parse(ownerLease.startedAtIso);\n950:   if (!Number.isFinite(startedAtMs)) return;\n951:   const deadline = startedAtMs + leaseStartupGraceMs();\n952:   const socketReady = () => socketPathUsable(leaseResult.socketPath) || socketPathUsable(resolveSessionProxySocketPath());\n953:   if (socketReady() || Date.now() >= deadline) return;\n954:   log(`lease holder pid=${ownerLease.ownerPid} is still starting; waiting up to ${deadline - Date.now()}ms for its socket`);\n955:   while (Date.now() < deadline) {\n956:     await sleep(LEASE_STARTUP_POLL_MS);\n957:     if (socketReady() || processLiveness(ownerLease.ownerPid) === 'dead') return;\n958:   }\n959: }\n960: \n961: async function bridgeOrReportLeaseHeld(leaseResult) {\n962:   if (process.env.SPECKIT_BRIDGE_RESPAWN_DISABLED !== '1' && launchedDaemonPredatesBuild(leaseResult)) {\n963:     log(`skill-advisor daemon for owner pid ${leaseResult.ownerPid} was launched before the current build; recycling it`);\n964:     const recycled = await respawnAfterDeadSocket(\n965:       leaseResult,\n966:       { action: 'respawn', reason: 'stale-build', socketPath: leaseResult.socketPath },\n967:       { diagnostics: false },\n968:     );\n969:     if (recycled.action === 'respawn') return recycled;\n970:     log(`stale-build recycle skipped (${recycled.reason}); bridging to the running daemon`);\n971:   }\n972:   await waitForStartingHolderSocket(leaseResult);\n973:   const { maybeBridgeLeaseHolder } = loadBridgeModule();\n974:   const decision = await maybeBridgeLeaseHolder({\n975:     serviceName: 'system-skill-advisor',\n976:     leaseResult,\n977:     loggerPrefix: 'system-skill-advisor-launcher',\n978:     dbDir: resolvedAdvisorDbDir(),\n979:     bridge: bridgeStdioThroughSessionProxy,\n980:     legacyReport: reportLeaseHeld,\n981:     respawnOnMissingSocket: true,\n982:   });\n983:   if (decision && decision.action === 'respawn') {\n984:     return await respawnAfterDeadSocket(leaseResult, decision);\n985:   }\n986:   return decision;\n987: }\n988: \n989: async function checkStrictSingleWriter() {\n990:   const ownerLeaseResult = acquireOwnerLeaseFile();\n991:   if (!ownerLeaseResult.acquired) {\n992:     log(`liveOwnerDetected: ownerPid=${ownerLeaseResult.holder.ownerPid} classification=${ownerLeaseResult.classification}`);\n993:     await bridgeOrReportLeaseHeld(leaseResultForOwnerLease(ownerLeaseResult.holder));\n994:     return true;\n995:   }\n996:   startOwnerLeaseHeartbeat(process.pid);\n997: \n998:   const launcherLease = leaseHeldFromFile();\n999:   if (launcherLease.held && !launcherLease.staleReclaimable) {\n1000:     clearOwnerLeaseFile();\n1001:     await bridgeOrReportLeaseHeld(launcherLease);\n1002:     return true;\n1003:   }\n1004:   if (launcherLease.staleReclaimable) {\n1005:     log('staleReclaimed: true');\n1006:     const staleLease = readLeaseFile();\n1007:     const staleChildPid = Number.isInteger(staleLease?.childPid) && staleLease.childPid > 0\n1008:       ? staleLease.childPid\n1009:       : null;\n1010:     if (staleChildPid && processLiveness(staleChildPid) !== 'dead') {\n1011:       const staleChildLeaseResult = {\n1012:         held: true,\n1013:         ownerPid: staleChildPid,\n1014:         staleReclaimable: false,\n1015:         startedAt: staleLease.startedAt ?? new Date(0).toISOString(),\n1016:         legacyPath: null,\n1017:         socketPath: typeof staleLease.socketPath === 'string' ? staleLease.socketPath : null,\n1018:       };\n1019:       if (socketPathUsable(staleChildLeaseResult.socketPath)) {\n1020:         const decision = await bridgeOrReportLeaseHeld(staleChildLeaseResult);\n1021:         if (decision?.action === 'bridge' || decision?.action === 'respawn') {\n1022:           return true;\n1023:         }\n1024:         if (decision?.reason !== 'no-bridge-socket') {\n1025:           clearOwnerLeaseFile();\n1026:           return true;\n1027:         }\n1028:       }\n1029:       scheduleBootstrapReap(staleChildPid);\n1030:       log(`stale launcher lease recorded live childPid=${staleChildPid}; deferring reap until bootstrap lock is held`);\n1031:     } else if (staleChildPid) {\n1032:       scheduleBootstrapReap(staleChildPid);\n1033:     }\n1034:   }\n1035: \n1036:   try {\n1037:     const daemonLeasePath = path.join(runtimeDir, 'dist', 'runtime', 'lib', 'daemon', 'lease.js');\n1038:     const leaseModule = require(daemonLeasePath);\n1039:     const leaseResult = leaseModule.isLeaseHeld(root);\n1040:     const legacyMarker = leaseResult.legacyPath ? ' (legacy path)' : '';\n1041:     if (leaseResult.held && !leaseResult.staleReclaimable) {\n1042:       clearOwnerLeaseFile();\n1043:       await bridgeOrReportLeaseHeld(leaseResult);\n1044:       return true;\n1045:     }\n1046:     if (leaseResult.staleReclaimable) {\n1047:       log(`staleReclaimed: true${legacyMarker ? ' (legacy path)' : ''}`);\n1048:     }\n1049:   } catch (error) {\n1050:     if (error.code !== 'MODULE_NOT_FOUND') {\n1051:       log(`daemon lease check failed: ${error.message}`);\n1052:     }\n1053:   }\n1054: \n1055:   return false;\n1056: }\n1057: \n1058: function resolveSessionProxySocketPath() {\n1059:   const { getIpcSocketPath } = loadBridgeModule();\n1060:   return getIpcSocketPath('system-skill-advisor', { dbDir: resolvedAdvisorDbDir() });\n1061: }\n1062: \n1063: // ─────────────────────────────────────────────────────────────────────────────\n1064: // 10. LAUNCHER LEASE FILE WRITE & CLEAR HELPERS\n1065: // ─────────────────────────────────────────────────────────────────────────────\n1066: \n1067: function writeLeaseFile(childPid = childProcess?.pid ?? null) {\n1068:   const currentLeasePath = path.join(ensureCanonicalDir(path.dirname(leasePath())), path.basename(leasePath()));\n1069:   const tmp = `${currentLeasePath}.tmp.${process.pid}`;\n1070:   if (!leaseStartedAt) leaseStartedAt = new Date().toISOString();\n1071:   const payload = {\n1072:     pid: process.pid,\n1073:     ownerPid: process.pid,\n1074:     startedAt: leaseStartedAt,\n1075:     socketPath: resolveSessionProxySocketPath(),\n1076:   };\n1077:   if (Number.isInteger(childPid) && childPid > 0) payload.childPid = childPid;\n1078:   fs.writeFileSync(tmp, JSON.stringify(payload, null, 2), { mode: 0o600 });\n1079:   fs.renameSync(tmp, currentLeasePath);\n1080: }\n1081: \n1082: function clearLeaseFile() {\n1083:   try {\n1084:     const lease = readLeaseFile();\n1085:     if (lease && (lease.pid === process.pid || lease.pid === childProcess?.pid)) {\n1086:       fs.unlinkSync(leasePath());\n1087:     }\n1088:   } catch {\n1089:     // Idempotent cleanup.\n1090:   }\n1091: }\n1092: \n1093: function clearAllLeaseFiles() {\n1094:   clearLeaseFile();\n1095:   clearOwnerLeaseFile();\n1096: }\n1097: \n1098: // ─────────────────────────────────────────────────────────────────────────────\n1099: // 11. MODEL SERVER CONTROL\n1100: // ─────────────────────────────────────────────────────────────────────────────\n1101: \n1102: // The spawn defaults to on: since the memory launcher went away this launcher is\n1103: // the only process that can arm the shared model server, so an unset flag arms\n1104: // it. An explicit 0 (or any value other than 1) turns the spawner off. An\n1105: // explicit 1 also makes a missing supervision library fatal, where the default\n1106: // leaves embedding to the other providers (Ollama first) and says so in the log.\n1107: function modelServerSetting() {\n1108:   const raw = (process.env.SPECKIT_SKILL_ADVISOR_MODEL_SERVER_ENABLED ?? '').trim();\n1109:   if (raw === '') return 'default-on';\n1110:   if (raw === '1') return 'explicit-on';\n1111:   return 'off';\n1112: }\n1113: \n1114: function isModelServerEnabled() {\n1115:   return modelServerSetting() !== 'off';\n1116: }\n1117: \n1118: function modelServerSupervisionAvailable(context) {\n1119:   if (hfControl) return true;\n1120:   if (modelServerSetting() === 'explicit-on') {\n1121:     throw new Error('SPECKIT_SKILL_ADVISOR_MODEL_SERVER_ENABLED=1 but model-server supervision lib is unavailable');\n1122:   }\n1123:   log(`model server spawn skipped (${context}): supervision lib unavailable, embeddings use the other providers`);\n1124:   return false;\n1125: }\n1126: \n1127: function requireModelServerSupervision() {\n1128:   if (!mss) {\n1129:     throw new Error('model-server-supervision.cjs is unavailable');\n1130:   }\n1131:   return mss;\n1132: }\n1133: \n1134: function resolveModelServerSocketPath(env = process.env, options = {}) {\n1135:   // No unconditional dbDir default here: when a caller doesn't supply one AND\n1136:   // neither HF_EMBED_SERVER_URL nor SPECKIT_IPC_SOCKET_DIR are set in env (the\n1137:   // exact condition reachable through the plugin bridge's filtered child env),\n1138:   // fall through to mss's own canonical short default instead of reconstructing\n1139:   // the long system-spec-kit database path, which overflows macOS's sun_path\n1140:   // limit. An explicit options.dbDir is still honored when a caller provides one.\n1141:   return requireModelServerSupervision().resolveModelServerSocketPath(env, options);\n1142: }\n1143: \n1144: // A launcher pointed at its own advisor database also gets its own model\n1145: // server. Otherwise the demand listener, pid file, respawn lock and give-up\n1146: // marker resolve from the shared socket directory, and a sandboxed launcher's\n1147: // shutdown reads the shared pid file and signals the model server that the\n1148: // workspace launcher serves. The address travels in HF_EMBED_SERVER_URL\n1149: // because this launcher, the model server it spawns and the daemon child's\n1150: // embedding client all honour it, and the daemon socket keeps its own scoping.\n1151: function pinModelServerToAdvisorDatabase(env = process.env) {\n1152:   const overrideDbDir = env.SYSTEM_SKILL_ADVISOR_DB_DIR;\n[Output truncated. Continue reading with offset: 1153]"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/bin/system-skill-advisor-launcher.cjs\"}"},"time":{"start":1794760699994,"end":1794760700367}}}}
{"type":"step_finish","timestamp":1794760702045,"sessionID":"ses_e1feefdd5ffeS4J0KdMtC6TlEK","part":{"id":"prt_1e012f85d001PV8Mv8TFalB0Pm","sessionID":"ses_e1feefdd5ffeS4J0KdMtC6TlEK","messageID":"msg_1e012dcd10017Ms7oMlyo1f8Fr","type":"step-finish","reason":"tool-calls","snapshot":"1d5c0b3db4f83f4b439a003e0c9a0c89bd82e5ee","cost":0,"tokens":{"input":2244,"output":71,"reasoning":21,"cache":{"read":96128,"write":0}}}}
{"type":"step_start","timestamp":1794760707998,"sessionID":"ses_e1feefdd5ffeS4J0KdMtC6TlEK","part":{"id":"prt_1e0130f9e001qMMSzj6vE6OJ7G","sessionID":"ses_e1feefdd5ffeS4J0KdMtC6TlEK","messageID":"msg_1e012f861001CZ8hBLi8aMY08S","type":"step-start","snapshot":"1d5c0b3db4f83f4b439a003e0c9a0c89bd82e5ee"}}
{"type":"tool_use","timestamp":1794760722785,"sessionID":"ses_e1feefdd5ffeS4J0KdMtC6TlEK","part":{"partID":"prt_1e0134659001qeamPvuwTq4T19","sessionID":"ses_e1feefdd5ffeS4J0KdMtC6TlEK","messageID":"msg_1e012f861001CZ8hBLi8aMY08S","type":"tool","id":"call_ee8a3ef1b1ff452a83541e78","tool":"read","state":{"status":"completed","input":{"path":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/hooks/hook-flags.env.example"},"output":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/hooks/hook-flags.env.example, lines 1-90\n1: # Hook switch config: copy to hook-flags.env and uncomment what you want to change.\n2: #\n3: #   cp .skilled/hooks/hook-flags.env.example .skilled/hooks/hook-flags.env\n4: #\n5: # Every hook is ON by default except session handover, which ships OFF on every runtime\n6: # but Claude Code (see its block below). Setting a flag to a truthy value (1 / true / yes / on, case-insensitive)\n7: # disables that hook. hook-flags.env is gitignored, so your\n8: # choices stay local. A real environment variable overrides the file, so you can\n9: # re-enable a file-disabled hook for one session with e.g. SYSTEM_SKILL_ADVISOR_DISABLED=0.\n10: # A comment may follow a value after a space or tab, as on the lines below.\n11: #\n12: # Read by .skilled/hooks/shared/hook-flags.{cjs,mjs,ts,sh}. The canonical index of\n13: # every concern and flag lives in .skilled/hooks/README.md. Every other setting, with\n14: # its default, is in the root .env.example; set those with an export in your shell\n15: # profile. /doctor:env shows where each one is set and saves a change after your yes.\n16: \n17: # ── Master switch — disables ALL repo-authored hooks at once ──\n18: # SYSTEM_HOOKS_DISABLED=1\n19: \n20: # ── Per-concern switches (alphabetical) ──\n21: # CODEX_WATCHDOG_DISABLED=1               # codex hooks watchdog\n22: # MCP_ROUTE_GUARD_DISABLED=1              # MCP route guard\n23: # OPENCODE_GOAL_DISABLED=1                # session goal tracking\n24: # SK_CODE_POST_EDIT_QUALITY_DISABLED=1    # post-edit quality checks on writes\n25: # SK_GIT_PREFLIGHT_DISABLED=1             # git preflight advisory\n26: # SYSTEM_ASK_SURFACE_DISABLED=1           # ask-surface guard (prose option menus sent back to the question tool)\n27: # SYSTEM_COMPLETION_DISABLED=1            # completion-evidence checks + sentinel\n28: # SYSTEM_DECISION_CAPTURE_DISABLED=1      # operator decision capture (answer queue and save nudge)\n29: # SYSTEM_DIRECTIVE_LIFECYCLE_DISABLED=1   # directive lifecycle boundary\n30: # SYSTEM_DISPATCH_DISABLED=1              # CLI dispatch preflight guard + audit trail\n31: # SYSTEM_DISPATCH_GUARD_DISABLED=1        # CLI dispatch preflight guard only\n32: # SYSTEM_DIST_FRESHNESS_DISABLED=1        # compiled dist staleness check\n33: # SYSTEM_ENV_SECRET_GUARD_DISABLED=1      # dotenv guard: NOT read from this file. Export it in the shell that starts the runtime\n34: # SYSTEM_GIT_COMMIT_HOOKS_DISABLED=1      # pre-commit chain EMERGENCY off (also bypasses mass-deletion guard + comment-hygiene)\n35: # SYSTEM_GIT_HOOKS_CHECK_DISABLED=1       # git hook symlink validity check\n36: # SYSTEM_GIT_WORKTREE_GUARD_DISABLED=1    # shared-checkout worktree warning (pre-rename alias: SYSTEM_WORKTREE_GUARD_DISABLED)\n37: # SYSTEM_HOOK_INSTALL_DISABLED=1          # codex hook installer\n38: # SYSTEM_INJECTION_SCREEN_DISABLED=1      # WebFetch injection screen (also off with JEV_FEATURE_INJECTION_SCREEN=0)\n39: # SYSTEM_LIVE_FOLLOW_DISABLED=1           # live-sync IDE follower auto-start\n40: # SYSTEM_LIVE_SYNC_DISABLED=1             # whole live-sync loop (publish + auto-follow + self-heal install)\n41: # SYSTEM_OVERLAY_GUARD_DISABLED=1         # vendored-overlay edit guard\n42: # SYSTEM_PERMISSION_POLICY_DISABLED=1     # devin permission-request policy\n43: # SYSTEM_PRIMARY_RECONCILE_DISABLED=1     # primary checkout reconcile (git-primary-reconcile.sh)\n44: # SYSTEM_SESSION_CLEANUP_DISABLED=1       # stop-hook orphan/session cleanup\n45: # SYSTEM_SESSION_LIFECYCLE_DISABLED=1     # session start/stop/compact lifecycle hooks\n46: # SYSTEM_SESSION_HANDOVER_DISABLED=1      # session-handover loop (context nudge, stop arm, compact pointer), wins over every enable flag\n47: # SYSTEM_SKILL_ADVISOR_DISABLED=1         # skill-advisor brief on your prompts and the Gate 2 advisor_recommend direct call\n48: # SYSTEM_SPEC_GATE_DISABLED=1             # spec-folder Gate-3 prompt (deny is a separate opt-in, read from the process environment, not this file)\n49: # SYSTEM_TASK_DISPATCH_DISABLED=1         # deep-loop / task dispatch guard\n50: \n51: # ── Session handover enable switches (on for Claude Code, off elsewhere, by default) ──\n52: # With no enable flag set, Claude Code hands over and every other runtime stays silent.\n53: # Auto-compaction is the fallback while a runtime is off. A per-runtime flag with a value\n54: # (1 on, 0 off) beats the global flag for that runtime, and empty or unset falls back to it.\n55: # A set global flag decides for every runtime without its own value, Claude Code included.\n56: # Both SYSTEM_SESSION_HANDOVER_DISABLED=1 above and SYSTEM_HOOKS_DISABLED=1 still beat every enable flag.\n57: # SYSTEM_SESSION_HANDOVER_ENABLED=1       # turn on session handover (context nudge, stop arm, compact pointer)\n58: # SYSTEM_SESSION_HANDOVER_CLAUDE_ENABLED=0    # example: turn Claude Code's default handover off\n59: # SYSTEM_SESSION_HANDOVER_CODEX_ENABLED=\n60: # SYSTEM_SESSION_HANDOVER_PI_ENABLED=\n61: # SYSTEM_SESSION_HANDOVER_OPENCODE_ENABLED=\n62: # SYSTEM_SESSION_HANDOVER_CURSOR_ENABLED=\n63: # SYSTEM_SESSION_HANDOVER_DEVIN_ENABLED=\n64: # SYSTEM_SESSION_HANDOVER_VIBE_ENABLED=\n65: \n66: # ── Session handover notice (off by default) ──\n67: # SESSION_HANDOVER_NOTIFY_HOPS=1          # macOS notice each time a session hands over\n68: \n69: # ── Session handover goal carry-over (on by default) ──\n70: # On by default. Set 0 to stop the hand-over carrying the sender's goal packet.\n71: # SESSION_HANDOVER_GOAL=0                 # stop carrying the sender's goal packet\n72: \n73: # ── Session handover tuning override (process environment only, this file is not read for it) ──\n74: # The relaunch code reads this value from the environment. Export it in the shell that\n75: # starts the runtime instead of uncommenting it here.\n76: #   export SESSION_HANDOVER_REPO_ROOT=/absolute/path/to/repo   # repo root for planned handoff notes\n77: \n78: # ── Validation off-switches (not hook concerns, same file and precedence) ──\n79: # For people who do not care whether their docs drift from the expected formats.\n80: # CI never reads this file, so the repository's own checks stay on there.\n81: # SPECKIT_SKIP_VALIDATION=1               # spec folder validation (validate.sh)\n82: # SKDOC_SKIP_VALIDATION=1                 # every sk-doc validator's check path\n83: \n84: # ── Jev classifier feature switches (not hook concerns, same file and precedence) ──\n85: # Every Jev feature runs by default once `jev auth status --provider <JEV_PROVIDER>`\n86: # passes (the provider defaults to official). These run the other way\n87: # round from the hook switches above: set 0 (or false/no/off) to turn one OFF.\n88: # JEV_FEATURES=0                          # every Jev feature at once\n89: # JEV_FEATURE_CITE_DRIFT=0                # citation drift advisory in validate_document.py (older name: SKDOC_CITE_DRIFT_CHECK)\n90: # JEV_FEATURE_INJECTION_SCREEN=0          # fetched-web-text injection screen (Claude Code, Devin, OpenCode, Pi, DSH)","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/hooks/hook-flags.env.example, lines 1-90\n1: # Hook switch config: copy to hook-flags.env and uncomment what you want to change.\n2: #\n3: #   cp .skilled/hooks/hook-flags.env.example .skilled/hooks/hook-flags.env\n4: #\n5: # Every hook is ON by default except session handover, which ships OFF on every runtime\n6: # but Claude Code (see its block below). Setting a flag to a truthy value (1 / true / yes / on, case-insensitive)\n7: # disables that hook. hook-flags.env is gitignored, so your\n8: # choices stay local. A real environment variable overrides the file, so you can\n9: # re-enable a file-disabled hook for one session with e.g. SYSTEM_SKILL_ADVISOR_DISABLED=0.\n10: # A comment may follow a value after a space or tab, as on the lines below.\n11: #\n12: # Read by .skilled/hooks/shared/hook-flags.{cjs,mjs,ts,sh}. The canonical index of\n13: # every concern and flag lives in .skilled/hooks/README.md. Every other setting, with\n14: # its default, is in the root .env.example; set those with an export in your shell\n15: # profile. /doctor:env shows where each one is set and saves a change after your yes.\n16: \n17: # ── Master switch — disables ALL repo-authored hooks at once ──\n18: # SYSTEM_HOOKS_DISABLED=1\n19: \n20: # ── Per-concern switches (alphabetical) ──\n21: # CODEX_WATCHDOG_DISABLED=1               # codex hooks watchdog\n22: # MCP_ROUTE_GUARD_DISABLED=1              # MCP route guard\n23: # OPENCODE_GOAL_DISABLED=1                # session goal tracking\n24: # SK_CODE_POST_EDIT_QUALITY_DISABLED=1    # post-edit quality checks on writes\n25: # SK_GIT_PREFLIGHT_DISABLED=1             # git preflight advisory\n26: # SYSTEM_ASK_SURFACE_DISABLED=1           # ask-surface guard (prose option menus sent back to the question tool)\n27: # SYSTEM_COMPLETION_DISABLED=1            # completion-evidence checks + sentinel\n28: # SYSTEM_DECISION_CAPTURE_DISABLED=1      # operator decision capture (answer queue and save nudge)\n29: # SYSTEM_DIRECTIVE_LIFECYCLE_DISABLED=1   # directive lifecycle boundary\n30: # SYSTEM_DISPATCH_DISABLED=1              # CLI dispatch preflight guard + audit trail\n31: # SYSTEM_DISPATCH_GUARD_DISABLED=1        # CLI dispatch preflight guard only\n32: # SYSTEM_DIST_FRESHNESS_DISABLED=1        # compiled dist staleness check\n33: # SYSTEM_ENV_SECRET_GUARD_DISABLED=1      # dotenv guard: NOT read from this file. Export it in the shell that starts the runtime\n34: # SYSTEM_GIT_COMMIT_HOOKS_DISABLED=1      # pre-commit chain EMERGENCY off (also bypasses mass-deletion guard + comment-hygiene)\n35: # SYSTEM_GIT_HOOKS_CHECK_DISABLED=1       # git hook symlink validity check\n36: # SYSTEM_GIT_WORKTREE_GUARD_DISABLED=1    # shared-checkout worktree warning (pre-rename alias: SYSTEM_WORKTREE_GUARD_DISABLED)\n37: # SYSTEM_HOOK_INSTALL_DISABLED=1          # codex hook installer\n38: # SYSTEM_INJECTION_SCREEN_DISABLED=1      # WebFetch injection screen (also off with JEV_FEATURE_INJECTION_SCREEN=0)\n39: # SYSTEM_LIVE_FOLLOW_DISABLED=1           # live-sync IDE follower auto-start\n40: # SYSTEM_LIVE_SYNC_DISABLED=1             # whole live-sync loop (publish + auto-follow + self-heal install)\n41: # SYSTEM_OVERLAY_GUARD_DISABLED=1         # vendored-overlay edit guard\n42: # SYSTEM_PERMISSION_POLICY_DISABLED=1     # devin permission-request policy\n43: # SYSTEM_PRIMARY_RECONCILE_DISABLED=1     # primary checkout reconcile (git-primary-reconcile.sh)\n44: # SYSTEM_SESSION_CLEANUP_DISABLED=1       # stop-hook orphan/session cleanup\n45: # SYSTEM_SESSION_LIFECYCLE_DISABLED=1     # session start/stop/compact lifecycle hooks\n46: # SYSTEM_SESSION_HANDOVER_DISABLED=1      # session-handover loop (context nudge, stop arm, compact pointer), wins over every enable flag\n47: # SYSTEM_SKILL_ADVISOR_DISABLED=1         # skill-advisor brief on your prompts and the Gate 2 advisor_recommend direct call\n48: # SYSTEM_SPEC_GATE_DISABLED=1             # spec-folder Gate-3 prompt (deny is a separate opt-in, read from the process environment, not this file)\n49: # SYSTEM_TASK_DISPATCH_DISABLED=1         # deep-loop / task dispatch guard\n50: \n51: # ── Session handover enable switches (on for Claude Code, off elsewhere, by default) ──\n52: # With no enable flag set, Claude Code hands over and every other runtime stays silent.\n53: # Auto-compaction is the fallback while a runtime is off. A per-runtime flag with a value\n54: # (1 on, 0 off) beats the global flag for that runtime, and empty or unset falls back to it.\n55: # A set global flag decides for every runtime without its own value, Claude Code included.\n56: # Both SYSTEM_SESSION_HANDOVER_DISABLED=1 above and SYSTEM_HOOKS_DISABLED=1 still beat every enable flag.\n57: # SYSTEM_SESSION_HANDOVER_ENABLED=1       # turn on session handover (context nudge, stop arm, compact pointer)\n58: # SYSTEM_SESSION_HANDOVER_CLAUDE_ENABLED=0    # example: turn Claude Code's default handover off\n59: # SYSTEM_SESSION_HANDOVER_CODEX_ENABLED=\n60: # SYSTEM_SESSION_HANDOVER_PI_ENABLED=\n61: # SYSTEM_SESSION_HANDOVER_OPENCODE_ENABLED=\n62: # SYSTEM_SESSION_HANDOVER_CURSOR_ENABLED=\n63: # SYSTEM_SESSION_HANDOVER_DEVIN_ENABLED=\n64: # SYSTEM_SESSION_HANDOVER_VIBE_ENABLED=\n65: \n66: # ── Session handover notice (off by default) ──\n67: # SESSION_HANDOVER_NOTIFY_HOPS=1          # macOS notice each time a session hands over\n68: \n69: # ── Session handover goal carry-over (on by default) ──\n70: # On by default. Set 0 to stop the hand-over carrying the sender's goal packet.\n71: # SESSION_HANDOVER_GOAL=0                 # stop carrying the sender's goal packet\n72: \n73: # ── Session handover tuning override (process environment only, this file is not read for it) ──\n74: # The relaunch code reads this value from the environment. Export it in the shell that\n75: # starts the runtime instead of uncommenting it here.\n76: #   export SESSION_HANDOVER_REPO_ROOT=/absolute/path/to/repo   # repo root for planned handoff notes\n77: \n78: # ── Validation off-switches (not hook concerns, same file and precedence) ──\n79: # For people who do not care whether their docs drift from the expected formats.\n80: # CI never reads this file, so the repository's own checks stay on there.\n81: # SPECKIT_SKIP_VALIDATION=1               # spec folder validation (validate.sh)\n82: # SKDOC_SKIP_VALIDATION=1                 # every sk-doc validator's check path\n83: \n84: # ── Jev classifier feature switches (not hook concerns, same file and precedence) ──\n85: # Every Jev feature runs by default once `jev auth status --provider <JEV_PROVIDER>`\n86: # passes (the provider defaults to official). These run the other way\n87: # round from the hook switches above: set 0 (or false/no/off) to turn one OFF.\n88: # JEV_FEATURES=0                          # every Jev feature at once\n89: # JEV_FEATURE_CITE_DRIFT=0                # citation drift advisory in validate_document.py (older name: SKDOC_CITE_DRIFT_CHECK)\n90: # JEV_FEATURE_INJECTION_SCREEN=0          # fetched-web-text injection screen (Claude Code, Devin, OpenCode, Pi, DSH)"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/hooks/hook-flags.env.example\"}"},"time":{"start":1794760722010,"end":1794760722785}}}}
{"type":"tool_use","timestamp":1794760722793,"sessionID":"ses_e1feefdd5ffeS4J0KdMtC6TlEK","part":{"partID":"prt_1e01347aa001ew2ZQELwTLaAkh","sessionID":"ses_e1feefdd5ffeS4J0KdMtC6TlEK","messageID":"msg_1e012f861001CZ8hBLi8aMY08S","type":"tool","id":"call_c14cc8177b9e45ac8bf68e46","tool":"read","state":{"status":"completed","input":{"path":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/lib/README.md"},"output":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/lib/README.md, lines 1-203\n1: ---\n2: title: \"Skill Advisor Library: Runtime, Scoring And Metadata Helpers\"\n3: description: \"TypeScript library modules for skill-advisor routing, scoring, daemon freshness, lifecycle metadata, compatibility and prompt-safe rendering.\"\n4: trigger_phrases:\n5:   - \"skill advisor library\"\n6:   - \"advisor runtime modules\"\n7:   - \"skill advisor scoring\"\n8: ---\n9: \n10: # Skill Advisor Library: Runtime, Scoring And Metadata Helpers\n11: \n12: ---\n13: \n14: ## 1. OVERVIEW\n15: \n16: `runtime/lib/` owns the TypeScript helper layer behind advisor recommendation, prompt-safe rendering, daemon freshness checks, lifecycle metadata, compatibility probes and scorer behavior. Handlers import `../lib/...` modules, and scripts call these modules instead of duplicating advisor logic.\n17: \n18: Current state:\n19: \n20: - Centralizes prompt policy, normalization, scoring and render helpers.\n21: - Groups compatibility, daemon, derived metadata, freshness, lifecycle, scorer, shadow and utility modules in focused subfolders.\n22: - Keeps subprocess and source-cache behavior close to the advisor runtime path.\n23: \n24: ---\n25: \n26: ## 2. ARCHITECTURE\n27: \n28: ```text\n29: ╭──────────────────────────────────────────────────────────────────╮\n30: │                      SKILL ADVISOR LIBRARY                       │\n31: ╰──────────────────────────────────────────────────────────────────╯\n32: \n33: ┌──────────────┐      ┌────────────────┐      ┌──────────────────┐\n34: │ Handlers     │ ───▶ │ Runtime values │ ───▶ │ Scorer / policy  │\n35: │ scripts      │      │ render helpers │      │ normalization    │\n36: └──────┬───────┘      └───────┬────────┘      └────────┬─────────┘\n37:        │                      │                        │\n38:        │                      ▼                        ▼\n39:        │              ┌───────────────┐        ┌────────────────┐\n40:        └───────────▶  │ Freshness     │ ───▶   │ Compatibility  │\n41:                       │ daemon        │        │ lifecycle      │\n42:                       └───────┬───────┘        └────────────────┘\n43:                               │\n44:                               ▼\n45:                       ┌───────────────┐\n46:                       │ Shadow data   │\n47:                       └───────────────┘\n48: \n49: Dependency direction: handlers/scripts -> lib -> schemas and shared helpers\n50: ```\n51: \n52: ---\n53: \n54: ## 3. PACKAGE TOPOLOGY\n55: \n56: ```text\n57: lib/\n58: +-- auth/                       # Trusted caller checks\n59: +-- compat/                     # Compatibility and daemon probes\n60: +-- cross-skill-edges/          # Inbound enhances edge detection/apply helpers\n61: +-- daemon/                     # Advisor daemon helpers\n62: +-- derived/                    # Derived metadata helpers\n63: +-- embedders/                  # Advisor embedder schema and shared registry shims\n64: +-- freshness/                  # Freshness and cache state helpers\n65: +-- ipc/                        # Launcher IPC bridge and idle-timeout helpers\n66: +-- lifecycle/                  # Skill lifecycle metadata helpers\n67: +-- scorer/                     # Advisor scorer implementation\n68: +-- shadow/                     # Shadow-mode telemetry helpers\n69: +-- shared/                     # Small advisor-local shared helpers\n70: +-- utils/                      # Small utility functions\n71: +-- advisor-runtime-values.ts   # Runtime defaults and constants\n72: +-- policy-plan.ts              # Advisor policy delivery-state machine + observed-receipt confirmation (epoch>=1 floor)\n73: +-- prompt-policy.ts            # Prompt handling policy\n74: +-- render.ts                   # Prompt-safe output rendering\n75: +-- subprocess.ts               # Child-process wrapper helpers\n76: `-- README.md\n77: ```\n78: \n79: Allowed direction:\n80: \n81: ```text\n82: handlers -> lib modules\n83: scripts -> lib modules\n84: lib modules -> schemas and shared utilities\n85: ```\n86: \n87: Disallowed direction:\n88: \n89: ```text\n90: lib modules -> tool registration\n91: lib modules -> test fixtures\n92: subfolders -> handlers for runtime behavior\n93: ```\n94: \n95: ---\n96: \n97: ## 4. DIRECTORY TREE\n98: \n99: ```text\n100: lib/\n101: +-- advisor-runtime-values.ts\n102: +-- affordance-normalizer.ts\n103: +-- command-attach.ts\n104: +-- error-diagnostics.ts\n105: +-- freshness.ts\n106: +-- generation.ts\n107: +-- metrics.ts\n108: +-- normalize-adapter-output.ts\n109: +-- policy-plan.ts\n110: +-- prompt-cache.ts\n111: +-- prompt-policy.ts\n112: +-- render.ts\n113: +-- skill-advisor-brief.ts\n114: +-- source-cache.ts\n115: +-- subprocess.ts\n116: +-- cross-skill-edges/\n117: +-- embedders/\n118: +-- ipc/\n119: +-- scorer/\n120: +-- shared/\n121: `-- README.md\n122: ```\n123: \n124: ---\n125: \n126: ## 5. KEY FILES\n127: \n128: | File | Responsibility |\n129: |---|---|\n130: | `advisor-runtime-values.ts` | Runtime constants and defaults used by advisor paths. |\n131: | `affordance-normalizer.ts` | Normalizes prompt affordance signals before scoring. |\n132: | `command-attach.ts` | `attachCommand()` names the slash command for a hub recommendation whose compiled route picks one `workflowMode`. It reads the `MODE_COMMANDS` table that `derive-command-bridges.cjs` generates from each hub's `mode-registry.json`. A `system-deep-loop` command needs the same command typed in the prompt or a `DEPTH_WORDING` phrase, and a prompt that matches `NO_EDIT_REQUEST` gets no command. `commandOnlyMentioned()` reads how the prompt names a command, and a command the prompt refuses or asks about is not offered unless a later clause asks for it. A correction inside an existing document carries no `/create:readme`, `/create:feature-catalog` or `/create:manual-testing-playbook`. The module has no imports. |\n133: | `prompt-policy.ts` | Applies prompt-safe routing and rendering policy. |\n134: | `render.ts` | Renders advisor results into prompt-safe output. |\n135: | `skill-advisor-brief.ts` | Builds concise advisor recommendation briefs. |\n136: | `normalize-adapter-output.ts` | Normalizes adapter result shapes. |\n137: | `subprocess.ts` | Wraps external process execution for advisor scripts or probes. |\n138: | `df-idf.ts` | Computes DF/IDF statistics over the active corpus, excluding archived and future skills through `lifecycle/archive-handling`, with a cached variant and a debounced updater. Only tests and the stress suite import it today. |\n139: | `route-exclusions.ts` | Loads the operator denylist of skill ids the advisor never routes: `config/route-exclusions.json`, fully replaced by a gitignored `route-exclusions.local.json` when present, or the directory in `SPECKIT_ADVISOR_ROUTE_EXCLUSIONS_DIR`. A missing or malformed file yields an empty set and never throws. |\n140: | `caller-context.ts` | Holds the per-request caller context (session id, transport, caller pid, `trusted` flag) in `AsyncLocalStorage`, read by the trusted-caller gate. |\n141: | `cross-skill-edges/` | Detects and optionally applies inbound `enhances` graph edges. |\n142: | `embedders/` | Owns advisor vector schema helpers and shared embedder shims. It names and creates both the skill vector table and the `vec_cmd_<dim>` command vector table, which has no foreign key into `skill_nodes`. |\n143: | `ipc/` | Owns launcher socket bridge and idle-timeout helpers. |\n144: | `shared/` | Keeps advisor-local shared helpers and compatibility shims. |\n145: \n146: ---\n147: \n148: ## 6. BOUNDARIES AND FLOW\n149: \n150: | Boundary | Rule |\n151: |---|---|\n152: | Imports | May import advisor schemas, shared helpers and focused local submodules. |\n153: | Exports | Export reusable advisor runtime helpers, not tool registration. |\n154: | Ownership | Keep advisor computation and metadata helpers here. Put tool handlers in `../handlers/` and CLI wrappers in `../scripts/`. |\n155: \n156: Main flow:\n157: \n158: ```text\n159: prompt or status request\n160:   -> handler or script entrypoint\n161:   -> lib policy, scorer, freshness or compatibility helper\n162:   -> prompt-safe advisor result or diagnostic payload\n163: ```\n164: \n165: ---\n166: \n167: ## 7. ENTRYPOINTS\n168: \n169: | Entrypoint | Type | Purpose |\n170: |---|---|---|\n171: | `render.ts` | Module | Formats advisor output for callers. |\n172: | `prompt-policy.ts` | Module | Applies prompt-safety and routing policy. |\n173: | `scorer/` | Folder | Native scoring implementation. |\n174: | `compat/` | Folder | Compatibility and daemon probe helpers. |\n175: | `cross-skill-edges/` | Folder | Inbound enhances edge propagation helpers. |\n176: | `embedders/` | Folder | Active embedder schema and shared registry shims. |\n177: | `freshness/` | Folder | Freshness state helpers. |\n178: | `ipc/` | Folder | Launcher IPC helpers. |\n179: | `shared/` | Folder | Shared local helper modules. |\n180: \n181: ---\n182: \n183: ## 8. VALIDATION\n184: \n185: Run from the repository root.\n186: \n187: ```bash\n188: python3 .skilled/skills/sk-doc/scripts/validate_document.py .skilled/skills/system-skill-advisor/runtime/lib/README.md\n189: ```\n190: \n191: Expected result: exit code `0`.\n192: \n193: ---\n194: \n195: ## 9. RELATED\n196: \n197: - [`../README.md`](../README.md)\n198: - [`../handlers/README.md`](../handlers/README.md)\n199: - [`../scripts/README.md`](../scripts/README.md)\n200: - [`cross-skill-edges/README.md`](cross-skill-edges/README.md)\n201: - [`embedders/README.md`](embedders/README.md)\n202: - [`ipc/README.md`](ipc/README.md)\n203: - [`shared/README.md`](shared/README.md)","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/lib/README.md, lines 1-203\n1: ---\n2: title: \"Skill Advisor Library: Runtime, Scoring And Metadata Helpers\"\n3: description: \"TypeScript library modules for skill-advisor routing, scoring, daemon freshness, lifecycle metadata, compatibility and prompt-safe rendering.\"\n4: trigger_phrases:\n5:   - \"skill advisor library\"\n6:   - \"advisor runtime modules\"\n7:   - \"skill advisor scoring\"\n8: ---\n9: \n10: # Skill Advisor Library: Runtime, Scoring And Metadata Helpers\n11: \n12: ---\n13: \n14: ## 1. OVERVIEW\n15: \n16: `runtime/lib/` owns the TypeScript helper layer behind advisor recommendation, prompt-safe rendering, daemon freshness checks, lifecycle metadata, compatibility probes and scorer behavior. Handlers import `../lib/...` modules, and scripts call these modules instead of duplicating advisor logic.\n17: \n18: Current state:\n19: \n20: - Centralizes prompt policy, normalization, scoring and render helpers.\n21: - Groups compatibility, daemon, derived metadata, freshness, lifecycle, scorer, shadow and utility modules in focused subfolders.\n22: - Keeps subprocess and source-cache behavior close to the advisor runtime path.\n23: \n24: ---\n25: \n26: ## 2. ARCHITECTURE\n27: \n28: ```text\n29: ╭──────────────────────────────────────────────────────────────────╮\n30: │                      SKILL ADVISOR LIBRARY                       │\n31: ╰──────────────────────────────────────────────────────────────────╯\n32: \n33: ┌──────────────┐      ┌────────────────┐      ┌──────────────────┐\n34: │ Handlers     │ ───▶ │ Runtime values │ ───▶ │ Scorer / policy  │\n35: │ scripts      │      │ render helpers │      │ normalization    │\n36: └──────┬───────┘      └───────┬────────┘      └────────┬─────────┘\n37:        │                      │                        │\n38:        │                      ▼                        ▼\n39:        │              ┌───────────────┐        ┌────────────────┐\n40:        └───────────▶  │ Freshness     │ ───▶   │ Compatibility  │\n41:                       │ daemon        │        │ lifecycle      │\n42:                       └───────┬───────┘        └────────────────┘\n43:                               │\n44:                               ▼\n45:                       ┌───────────────┐\n46:                       │ Shadow data   │\n47:                       └───────────────┘\n48: \n49: Dependency direction: handlers/scripts -> lib -> schemas and shared helpers\n50: ```\n51: \n52: ---\n53: \n54: ## 3. PACKAGE TOPOLOGY\n55: \n56: ```text\n57: lib/\n58: +-- auth/                       # Trusted caller checks\n59: +-- compat/                     # Compatibility and daemon probes\n60: +-- cross-skill-edges/          # Inbound enhances edge detection/apply helpers\n61: +-- daemon/                     # Advisor daemon helpers\n62: +-- derived/                    # Derived metadata helpers\n63: +-- embedders/                  # Advisor embedder schema and shared registry shims\n64: +-- freshness/                  # Freshness and cache state helpers\n65: +-- ipc/                        # Launcher IPC bridge and idle-timeout helpers\n66: +-- lifecycle/                  # Skill lifecycle metadata helpers\n67: +-- scorer/                     # Advisor scorer implementation\n68: +-- shadow/                     # Shadow-mode telemetry helpers\n69: +-- shared/                     # Small advisor-local shared helpers\n70: +-- utils/                      # Small utility functions\n71: +-- advisor-runtime-values.ts   # Runtime defaults and constants\n72: +-- policy-plan.ts              # Advisor policy delivery-state machine + observed-receipt confirmation (epoch>=1 floor)\n73: +-- prompt-policy.ts            # Prompt handling policy\n74: +-- render.ts                   # Prompt-safe output rendering\n75: +-- subprocess.ts               # Child-process wrapper helpers\n76: `-- README.md\n77: ```\n78: \n79: Allowed direction:\n80: \n81: ```text\n82: handlers -> lib modules\n83: scripts -> lib modules\n84: lib modules -> schemas and shared utilities\n85: ```\n86: \n87: Disallowed direction:\n88: \n89: ```text\n90: lib modules -> tool registration\n91: lib modules -> test fixtures\n92: subfolders -> handlers for runtime behavior\n93: ```\n94: \n95: ---\n96: \n97: ## 4. DIRECTORY TREE\n98: \n99: ```text\n100: lib/\n101: +-- advisor-runtime-values.ts\n102: +-- affordance-normalizer.ts\n103: +-- command-attach.ts\n104: +-- error-diagnostics.ts\n105: +-- freshness.ts\n106: +-- generation.ts\n107: +-- metrics.ts\n108: +-- normalize-adapter-output.ts\n109: +-- policy-plan.ts\n110: +-- prompt-cache.ts\n111: +-- prompt-policy.ts\n112: +-- render.ts\n113: +-- skill-advisor-brief.ts\n114: +-- source-cache.ts\n115: +-- subprocess.ts\n116: +-- cross-skill-edges/\n117: +-- embedders/\n118: +-- ipc/\n119: +-- scorer/\n120: +-- shared/\n121: `-- README.md\n122: ```\n123: \n124: ---\n125: \n126: ## 5. KEY FILES\n127: \n128: | File | Responsibility |\n129: |---|---|\n130: | `advisor-runtime-values.ts` | Runtime constants and defaults used by advisor paths. |\n131: | `affordance-normalizer.ts` | Normalizes prompt affordance signals before scoring. |\n132: | `command-attach.ts` | `attachCommand()` names the slash command for a hub recommendation whose compiled route picks one `workflowMode`. It reads the `MODE_COMMANDS` table that `derive-command-bridges.cjs` generates from each hub's `mode-registry.json`. A `system-deep-loop` command needs the same command typed in the prompt or a `DEPTH_WORDING` phrase, and a prompt that matches `NO_EDIT_REQUEST` gets no command. `commandOnlyMentioned()` reads how the prompt names a command, and a command the prompt refuses or asks about is not offered unless a later clause asks for it. A correction inside an existing document carries no `/create:readme`, `/create:feature-catalog` or `/create:manual-testing-playbook`. The module has no imports. |\n133: | `prompt-policy.ts` | Applies prompt-safe routing and rendering policy. |\n134: | `render.ts` | Renders advisor results into prompt-safe output. |\n135: | `skill-advisor-brief.ts` | Builds concise advisor recommendation briefs. |\n136: | `normalize-adapter-output.ts` | Normalizes adapter result shapes. |\n137: | `subprocess.ts` | Wraps external process execution for advisor scripts or probes. |\n138: | `df-idf.ts` | Computes DF/IDF statistics over the active corpus, excluding archived and future skills through `lifecycle/archive-handling`, with a cached variant and a debounced updater. Only tests and the stress suite import it today. |\n139: | `route-exclusions.ts` | Loads the operator denylist of skill ids the advisor never routes: `config/route-exclusions.json`, fully replaced by a gitignored `route-exclusions.local.json` when present, or the directory in `SPECKIT_ADVISOR_ROUTE_EXCLUSIONS_DIR`. A missing or malformed file yields an empty set and never throws. |\n140: | `caller-context.ts` | Holds the per-request caller context (session id, transport, caller pid, `trusted` flag) in `AsyncLocalStorage`, read by the trusted-caller gate. |\n141: | `cross-skill-edges/` | Detects and optionally applies inbound `enhances` graph edges. |\n142: | `embedders/` | Owns advisor vector schema helpers and shared embedder shims. It names and creates both the skill vector table and the `vec_cmd_<dim>` command vector table, which has no foreign key into `skill_nodes`. |\n143: | `ipc/` | Owns launcher socket bridge and idle-timeout helpers. |\n144: | `shared/` | Keeps advisor-local shared helpers and compatibility shims. |\n145: \n146: ---\n147: \n148: ## 6. BOUNDARIES AND FLOW\n149: \n150: | Boundary | Rule |\n151: |---|---|\n152: | Imports | May import advisor schemas, shared helpers and focused local submodules. |\n153: | Exports | Export reusable advisor runtime helpers, not tool registration. |\n154: | Ownership | Keep advisor computation and metadata helpers here. Put tool handlers in `../handlers/` and CLI wrappers in `../scripts/`. |\n155: \n156: Main flow:\n157: \n158: ```text\n159: prompt or status request\n160:   -> handler or script entrypoint\n161:   -> lib policy, scorer, freshness or compatibility helper\n162:   -> prompt-safe advisor result or diagnostic payload\n163: ```\n164: \n165: ---\n166: \n167: ## 7. ENTRYPOINTS\n168: \n169: | Entrypoint | Type | Purpose |\n170: |---|---|---|\n171: | `render.ts` | Module | Formats advisor output for callers. |\n172: | `prompt-policy.ts` | Module | Applies prompt-safety and routing policy. |\n173: | `scorer/` | Folder | Native scoring implementation. |\n174: | `compat/` | Folder | Compatibility and daemon probe helpers. |\n175: | `cross-skill-edges/` | Folder | Inbound enhances edge propagation helpers. |\n176: | `embedders/` | Folder | Active embedder schema and shared registry shims. |\n177: | `freshness/` | Folder | Freshness state helpers. |\n178: | `ipc/` | Folder | Launcher IPC helpers. |\n179: | `shared/` | Folder | Shared local helper modules. |\n180: \n181: ---\n182: \n183: ## 8. VALIDATION\n184: \n185: Run from the repository root.\n186: \n187: ```bash\n188: python3 .skilled/skills/sk-doc/scripts/validate_document.py .skilled/skills/system-skill-advisor/runtime/lib/README.md\n189: ```\n190: \n191: Expected result: exit code `0`.\n192: \n193: ---\n194: \n195: ## 9. RELATED\n196: \n197: - [`../README.md`](../README.md)\n198: - [`../handlers/README.md`](../handlers/README.md)\n199: - [`../scripts/README.md`](../scripts/README.md)\n200: - [`cross-skill-edges/README.md`](cross-skill-edges/README.md)\n201: - [`embedders/README.md`](embedders/README.md)\n202: - [`ipc/README.md`](ipc/README.md)\n203: - [`shared/README.md`](shared/README.md)"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/lib/README.md\"}"},"time":{"start":1794760722346,"end":1794760722793}}}}
{"type":"step_finish","timestamp":1794760723917,"sessionID":"ses_e1feefdd5ffeS4J0KdMtC6TlEK","part":{"id":"prt_1e0134dcd001tNPVUo2m8eJQ7M","sessionID":"ses_e1feefdd5ffeS4J0KdMtC6TlEK","messageID":"msg_1e012f861001CZ8hBLi8aMY08S","type":"step-finish","reason":"tool-calls","snapshot":"1d5c0b3db4f83f4b439a003e0c9a0c89bd82e5ee","cost":0,"tokens":{"input":15578,"output":133,"reasoning":1447,"cache":{"read":98304,"write":0}}}}
{"type":"step_start","timestamp":1794760728252,"sessionID":"ses_e1feefdd5ffeS4J0KdMtC6TlEK","part":{"id":"prt_1e0135ebc001gTWGfNHMQszKF3","sessionID":"ses_e1feefdd5ffeS4J0KdMtC6TlEK","messageID":"msg_1e0134dd4001CMTuRWIjVvBaZM","type":"step-start","snapshot":"1d5c0b3db4f83f4b439a003e0c9a0c89bd82e5ee"}}
{"type":"tool_use","timestamp":1794760736003,"sessionID":"ses_e1feefdd5ffeS4J0KdMtC6TlEK","part":{"partID":"prt_1e013798f001IgjthFUpOXlAyk","sessionID":"ses_e1feefdd5ffeS4J0KdMtC6TlEK","messageID":"msg_1e0134dd4001CMTuRWIjVvBaZM","type":"tool","id":"call_99087d28e57f4c82957820f4","tool":"shell","state":{"status":"completed","input":{"command":"cd /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research && sed -n 1,120p .skilled/skills/system-skill-advisor/changelog/v1.1.0.0.md && echo \"=== ENV ref ===\" && grep -n \"SKILL_ADVISOR\\|HOOK_FLAGS\\|SYSTEM_HOOKS_DISABLED\" .skilled/skills/system-spec-kit/runtime/ENV-REFERENCE.md | head -40"},"output":"---\ntitle: \"system-skill-advisor v1.1.0.0, hook health without the debug flag\"\ndescription: \"v1.1.0.0 writes a prompt-free hook health record on every prompt, offers a command less often where it does not belong and renames the create-skill command row.\"\ntrigger_phrases:\n  - \"system-skill-advisor v1.1.0.0\"\n  - \"system-skill-advisor 1.1.0.0\"\n  - \"hook health by default\"\n  - \"no-edit prompt gets no command\"\nimportance_tier: \"normal\"\ncontextType: \"general\"\nversion: 1.1.0.0\n---\n\n# v1.1.0.0, Hook Health Without the Debug Flag\n\nThe prompt hook now writes a health record on every prompt. So `/doctor:setup` shows hook health with no setup. The record holds no prompt text.\n\nThe brief also offers commands with more care. A prompt that rules out a change gets no command from a hub. A deep-loop command needs its own name or a request for depth.\n\nOne command row also has a new id. That change breaks a caller that matches on the old id. Renamed Command below says what to change.\n\n> Spec folder: `specs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build`\n\n&nbsp;\n\n## Why This Release\n\nThe v1.0.0.0 hook wrote health records only with `SKILL_ADVISOR_DEBUG` set. Most machines never set it. So `advisor_status` had no hook health to report.\n\nSome briefs also offered the wrong command. A hub could offer a writing command to a prompt that asked for no edits. A mention of `/deep:review` opened the gate for `/deep:research`. A file name could read as a typed command.\n\nThis release also stops offering a command where none fits the request. It adds a measure of which workflow a run opened.\n\n&nbsp;\n\n## What's New at a Glance\n\n- **Every prompt writes a health record.** It carries no prompt, skill label or error text. <!-- section: Hook Health -->\n- **`hookHealth` shows answers from the local scorer.** It also gives the time of the newest record. <!-- section: Hook Health -->\n- **A hub says `(needs a mode)` only when you named it.** A hub the scorer guessed shows no label. <!-- section: Brief Commands -->\n- **The top hub keeps its command in the hook.** A row the brief never shows can no longer take it. <!-- section: Brief Commands -->\n- **A tool that does not show up reaches the doctor helper.** The brief names `/doctor:helper` beside the skills. <!-- section: Brief Commands -->\n- **A bare problem word can now lead with a doctor command.** It needs a skill that matched on shared words only. <!-- section: Brief Commands -->\n- **A no-edit prompt gets no command on any path.** More wordings now count as no-edit. <!-- section: No-Edit Prompts -->\n- **A refusal or a question is not a request.** A command the prompt refuses or asks about is not offered. A command named with no such lead is, when its owner and route gates pass. <!-- section: Command Fit -->\n- **A refusal covers a whole or-list.** `no need to run` counts, and a question mark ends the sentence before it. <!-- section: Command Fit -->\n- **Every runtime leads with the same head.** The head row keeps its command under every request shape. <!-- section: One Head on Every Runtime -->\n- **The summary says which workflow a run opened.** It sorts each run into one path, such as a command document or the owning skill. <!-- section: Workflow Measure -->\n- **A load now counts in more shapes.** A shell read and a prompt mirror each count, and a search does not. <!-- section: Workflow Measure -->\n- **The create-skill command row has a new id.** It is now `command-create-sk-skill`. <!-- section: Renamed Command -->\n- **The OpenCode brief drops a repeated route line.** The head already names the hub and its command. <!-- section: OpenCode Plugin -->\n\n&nbsp;\n\n## Hook Health\n\n#### A Record on Every Prompt\n\nThe Claude, Codex, Cursor, Devin, Pi and DSH hooks share one handler. That handler now appends a health record on every prompt. Before, it wrote one only with `SKILL_ADVISOR_DEBUG` set. A record holds the runtime, the status, the freshness, the duration and the cache hit. A disabled hook writes one too:\n\n```json\n{\"timestamp\":\"2026-11-13T20:30:20.999Z\",\"runtime\":\"claude\",\"status\":\"skipped\",\"freshness\":\"unavailable\",\"durationMs\":1,\"cacheHit\":false}\n```\n\n`SKILL_ADVISOR_DEBUG=1` now only adds the skill label and the error text. The log trims back to the newest 200 records once it passes 300. The OpenCode plugin writes no record.\n\n#### Health Shows Degraded Answers\n\n`advisor_status` carries `hookHealth` once any hook has written a record. It still summarizes the newest 30 records. Two fields are new. `rollingDegradedRate` is the share of answers from the CLI's local scorer. `lastRecordAt` is the time of the newest record. A runtime that stopped writing now shows its age.\n\n#### The Direct Call Reads the Switch\n\nA direct `advisor_recommend` call now abstains whenever the skill-advisor hooks are off. It decides in the caller's own process, under `SYSTEM_SKILL_ADVISOR_DISABLED`, its aliases, the master switch or the flags file. That happens before any daemon starts or the scorer runs. The launcher passes no switch name to a daemon it starts.\n\n#### Smaller Fixes\n\n- **A runaway Python scorer child can no longer fill memory.** The brief builder keeps at most 1 MiB of each output stream.\n- **A busy database still gets its one retry.** The busy marker counts even past that cap or split across two writes.\n\n&nbsp;\n\n## Brief Commands\n\n#### The Mode Label Needs Your Words\n\nA hub that cannot pick one mode says `(needs a mode)`. It now says so only when the prompt names that hub. A hub the scorer guessed shows no label. The label used to point at modes you never asked about. The head now names the hub, never a raw command row id.\n\n#### The Top Hub Keeps Its Command\n\nThe hook asks for the top pick's route only. A hub used to drop its command when a lower row carried the same one. That row never reached the brief. So the command was lost. The top hub now keeps it.\n\n#### Deep-Loop Commands Need Their Own Name\n\nA deep-loop command still waits for a request for depth. Typing that same command also counts. Typing any other `/deep:` command no longer does. So a mention of `/deep:review` no longer offers `/deep:research`.\n\n#### File Names Are Not Commands\n\nA typed command must end on a word boundary. A dot or slash before more letters now continues a file name. So `/create:sk-skill.md` is no longer read as a typed command.\n\n#### A Mode Suffix Still Counts\n\nA command typed with its mode suffix reads as that command. So `/deep:review:auto` attaches `/deep:review`. The suffixes are `:auto`, `:confirm` and `:autopilot`. Any other suffix reads as no command.\n\n#### The Retired Create-Skill Name Still Reads\n\nA typed `/create:skill` now reads as `/create:sk-skill`. So a prompt that types the old name gets `sk-doc` with `/create:sk-skill (start)`. No command file answers to the old name. The retired name lives only in the `RETIRED_COMMANDS` table in `runtime/lib/command-attach.ts`. `runtime/tests/command-attach-guards.vitest.ts` covers it. A path such as `docs/create:skill.md` still reads as no command.\n\n#### The Doctor Helper for Missing Tools\n\nA prompt that says a tool does not show up now counts as a strong problem cue. The same holds when a tool does not appear. The brief then adds `/doctor:helper` beside the skills. \"Appear to\" and \"up-to-date\" stay out of the cue. A contraction typed with a curly apostrophe counts like a straight one.\n\n#### A Weak Cue Beside a Words-Only Skill\n\nA passing skill used to block the doctor hand-off unless the prompt carried a strong cue. Now a weak cue such as \"missing\" or \"drifted\" is enough when every passing skill matched on shared single words alone. The doctor ranker must still score the prompt at 10 or more. So \"the agents md file is missing the gate sections\" leads with `/doctor:agents-md check` and keeps `sk-doc` after it. A skill named by one of its own phrases still gets no doctor command on a weak cue.\n\n&nbsp;\n\n## No-Edit Prompts\n\n#### No Command When You Rule Out a Change\n=== ENV ref ===\n68:Flags can be set as environment variables **or** in a config file: copy `.skilled/hooks/hook-flags.env.example` to `.skilled/hooks/hook-flags.env` (gitignored) and set the same `KEY=value` names there. A real environment variable always overrides the file, so a persisted default can be flipped back for one session. `HOOK_FLAGS_CONFIG` overrides the config file path.\n74:| `SYSTEM_HOOKS_DISABLED` | unset (enabled) | truthy disable flag | Master switch for every concern below. No aliases. | `.skilled/hooks/shared/hook-flags.{cjs,mjs,ts,sh}` |\n75:| `SYSTEM_SKILL_ADVISOR_DISABLED` | unset (enabled) | truthy disable flag | Disables skill-advisor injection and makes the `advisor_recommend` direct call abstain. Aliases: `SYSTEM_SKILL_ADVISOR_HOOK_DISABLED`, `SYSTEM_SKILL_ADVISOR_PLUGIN_DISABLED`, `SPECKIT_SKILL_ADVISOR_HOOK_DISABLED`, `SPECKIT_SKILL_ADVISOR_PLUGIN_DISABLED`. | `system-skill-advisor/hooks/claude/user-prompt-submit.ts`, `.opencode/plugins/system-skill-advisor.js` |\n299:`SPECKIT_SKILL_ADVISOR_MODEL_SERVER_ENABLED` and the cascade-probe rows are shared by the HF model\n319:| `SPECKIT_SKILL_ADVISOR_MODEL_SERVER_ENABLED` | (unset → on) | string (`\"1\"` or `\"0\"`) | Whether the **skill-advisor** launcher arms the shared model-server spawn. Unset arms it, because since the memory decommission this launcher is the only surface that can start the model server. The spawn is lazy: the launcher binds a demand listener and the model process starts on the first embed request, or attaches to a resident that already listens. `0` (or any value other than `1`) turns the spawner off. Embedding then relies on the other providers, Ollama first, since hf-local is the local fallback behind Ollama in auto mode. An explicit `1` also makes a missing supervision library fatal. The default logs and degrades instead. | `.skilled/bin/system-skill-advisor-launcher.cjs` |\n325:**What changed is who starts it.** The spec-memory launcher used to spawn it lazily on first embed demand, with skill-advisor as the fallback winner of the socket-keyed lock. That launcher is gone, so the skill-advisor launcher is the only remaining spawner and it arms the spawn by default. `SPECKIT_SKILL_ADVISOR_MODEL_SERVER_ENABLED=0` is the kill switch. With it set there is no spawner at all.\n335:| Not started | `hf-local` health probe connect-refused, no `hf-embed.sock` | Normal before first demand. If it persists, confirm `SPECKIT_SKILL_ADVISOR_MODEL_SERVER_ENABLED` is not set to `0` (the advisor launcher arms the spawn by default and is the only spawner since the memory decommission), then check the advisor launcher's stderr for `demand listener` errors or a `spawn skipped` line. |\n428:| `SYSTEM_SKILL_ADVISOR_CLI_WARM_ONLY` | unset (off) | flag | Default the skill-advisor CLI to warm-only. Alias: `SPECKIT_SKILL_ADVISOR_CLI_WARM_ONLY`. | `.skilled/skills/system-skill-advisor/runtime/skill-advisor-cli.ts` |\n429:| `SYSTEM_SKILL_ADVISOR_CLI_PROMPT_TIME` | unset (off) | flag | Marks the skill-advisor CLI invocation as prompt-time, which implies warm-only. Alias: `SPECKIT_SKILL_ADVISOR_CLI_PROMPT_TIME`. | `.skilled/skills/system-skill-advisor/runtime/skill-advisor-cli.ts` |\n432:| `SYSTEM_SKILL_ADVISOR_CLI_DEV_ALLOW_STALE` | unset (off) | boolean (`\"1\"`) | Dev override for the skill-advisor shim's dist-freshness guard (skips the exit-`69` stale check). Alias: `SPECKIT_SKILL_ADVISOR_CLI_DEV_ALLOW_STALE`. | `.skilled/bin/skill-advisor.cjs` |\n433:| `SYSTEM_SKILL_ADVISOR_CLI_TRUSTED` | unset (untrusted) | boolean (`\"1\"`) | Send skill-advisor CLI calls as trusted (equivalent to `--trusted`), required for the mutation tools `advisor_rebuild`, `skill_graph_scan` and apply-mode `skill_graph_propagate_enhances`. Alias: `SPECKIT_SKILL_ADVISOR_CLI_TRUSTED`. | `.skilled/skills/system-skill-advisor/runtime/skill-advisor-cli.ts` |\n434:| `SYSTEM_SKILL_ADVISOR_TRUST_DEFAULT` | unset (fail-closed untrusted) | string (`\"trusted\"`) | **Daemon-side** trust default. The advisor daemon fails closed (untrusted) when a caller's transport `_meta` is absent. Setting `trusted` in the daemon's own environment restores default-trusted behavior for native MCP surfaces whose clients send no `_meta`. Set in the advisor launcher's repo defaults, and callers cannot forge it. | `.skilled/skills/system-skill-advisor/runtime/advisor-server.ts` |\n588:# export SPECKIT_SKILL_ADVISOR_MODEL_SERVER_ENABLED=0\n601:export SYSTEM_SKILL_ADVISOR_DISABLED=1\n602:export SYSTEM_HOOKS_DISABLED=1\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"---\ntitle: \"system-skill-advisor v1.1.0.0, hook health without the debug flag\"\ndescription: \"v1.1.0.0 writes a prompt-free hook health record on every prompt, offers a command less often where it does not belong and renames the create-skill command row.\"\ntrigger_phrases:\n  - \"system-skill-advisor v1.1.0.0\"\n  - \"system-skill-advisor 1.1.0.0\"\n  - \"hook health by default\"\n  - \"no-edit prompt gets no command\"\nimportance_tier: \"normal\"\ncontextType: \"general\"\nversion: 1.1.0.0\n---\n\n# v1.1.0.0, Hook Health Without the Debug Flag\n\nThe prompt hook now writes a health record on every prompt. So `/doctor:setup` shows hook health with no setup. The record holds no prompt text.\n\nThe brief also offers commands with more care. A prompt that rules out a change gets no command from a hub. A deep-loop command needs its own name or a request for depth.\n\nOne command row also has a new id. That change breaks a caller that matches on the old id. Renamed Command below says what to change.\n\n> Spec folder: `specs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build`\n\n&nbsp;\n\n## Why This Release\n\nThe v1.0.0.0 hook wrote health records only with `SKILL_ADVISOR_DEBUG` set. Most machines never set it. So `advisor_status` had no hook health to report.\n\nSome briefs also offered the wrong command. A hub could offer a writing command to a prompt that asked for no edits. A mention of `/deep:review` opened the gate for `/deep:research`. A file name could read as a typed command.\n\nThis release also stops offering a command where none fits the request. It adds a measure of which workflow a run opened.\n\n&nbsp;\n\n## What's New at a Glance\n\n- **Every prompt writes a health record.** It carries no prompt, skill label or error text. <!-- section: Hook Health -->\n- **`hookHealth` shows answers from the local scorer.** It also gives the time of the newest record. <!-- section: Hook Health -->\n- **A hub says `(needs a mode)` only when you named it.** A hub the scorer guessed shows no label. <!-- section: Brief Commands -->\n- **The top hub keeps its command in the hook.** A row the brief never shows can no longer take it. <!-- section: Brief Commands -->\n- **A tool that does not show up reaches the doctor helper.** The brief names `/doctor:helper` beside the skills. <!-- section: Brief Commands -->\n- **A bare problem word can now lead with a doctor command.** It needs a skill that matched on shared words only. <!-- section: Brief Commands -->\n- **A no-edit prompt gets no command on any path.** More wordings now count as no-edit. <!-- section: No-Edit Prompts -->\n- **A refusal or a question is not a request.** A command the prompt refuses or asks about is not offered. A command named with no such lead is, when its owner and route gates pass. <!-- section: Command Fit -->\n- **A refusal covers a whole or-list.** `no need to run` counts, and a question mark ends the sentence before it. <!-- section: Command Fit -->\n- **Every runtime leads with the same head.** The head row keeps its command under every request shape. <!-- section: One Head on Every Runtime -->\n- **The summary says which workflow a run opened.** It sorts each run into one path, such as a command document or the owning skill. <!-- section: Workflow Measure -->\n- **A load now counts in more shapes.** A shell read and a prompt mirror each count, and a search does not. <!-- section: Workflow Measure -->\n- **The create-skill command row has a new id.** It is now `command-create-sk-skill`. <!-- section: Renamed Command -->\n- **The OpenCode brief drops a repeated route line.** The head already names the hub and its command. <!-- section: OpenCode Plugin -->\n\n&nbsp;\n\n## Hook Health\n\n#### A Record on Every Prompt\n\nThe Claude, Codex, Cursor, Devin, Pi and DSH hooks share one handler. That handler now appends a health record on every prompt. Before, it wrote one only with `SKILL_ADVISOR_DEBUG` set. A record holds the runtime, the status, the freshness, the duration and the cache hit. A disabled hook writes one too:\n\n```json\n{\"timestamp\":\"2026-11-13T20:30:20.999Z\",\"runtime\":\"claude\",\"status\":\"skipped\",\"freshness\":\"unavailable\",\"durationMs\":1,\"cacheHit\":false}\n```\n\n`SKILL_ADVISOR_DEBUG=1` now only adds the skill label and the error text. The log trims back to the newest 200 records once it passes 300. The OpenCode plugin writes no record.\n\n#### Health Shows Degraded Answers\n\n`advisor_status` carries `hookHealth` once any hook has written a record. It still summarizes the newest 30 records. Two fields are new. `rollingDegradedRate` is the share of answers from the CLI's local scorer. `lastRecordAt` is the time of the newest record. A runtime that stopped writing now shows its age.\n\n#### The Direct Call Reads the Switch\n\nA direct `advisor_recommend` call now abstains whenever the skill-advisor hooks are off. It decides in the caller's own process, under `SYSTEM_SKILL_ADVISOR_DISABLED`, its aliases, the master switch or the flags file. That happens before any daemon starts or the scorer runs. The launcher passes no switch name to a daemon it starts.\n\n#### Smaller Fixes\n\n- **A runaway Python scorer child can no longer fill memory.** The brief builder keeps at most 1 MiB of each output stream.\n- **A busy database still gets its one retry.** The busy marker counts even past that cap or split across two writes.\n\n&nbsp;\n\n## Brief Commands\n\n#### The Mode Label Needs Your Words\n\nA hub that cannot pick one mode says `(needs a mode)`. It now says so only when the prompt names that hub. A hub the scorer guessed shows no label. The label used to point at modes you never asked about. The head now names the hub, never a raw command row id.\n\n#### The Top Hub Keeps Its Command\n\nThe hook asks for the top pick's route only. A hub used to drop its command when a lower row carried the same one. That row never reached the brief. So the command was lost. The top hub now keeps it.\n\n#### Deep-Loop Commands Need Their Own Name\n\nA deep-loop command still waits for a request for depth. Typing that same command also counts. Typing any other `/deep:` command no longer does. So a mention of `/deep:review` no longer offers `/deep:research`.\n\n#### File Names Are Not Commands\n\nA typed command must end on a word boundary. A dot or slash before more letters now continues a file name. So `/create:sk-skill.md` is no longer read as a typed command.\n\n#### A Mode Suffix Still Counts\n\nA command typed with its mode suffix reads as that command. So `/deep:review:auto` attaches `/deep:review`. The suffixes are `:auto`, `:confirm` and `:autopilot`. Any other suffix reads as no command.\n\n#### The Retired Create-Skill Name Still Reads\n\nA typed `/create:skill` now reads as `/create:sk-skill`. So a prompt that types the old name gets `sk-doc` with `/create:sk-skill (start)`. No command file answers to the old name. The retired name lives only in the `RETIRED_COMMANDS` table in `runtime/lib/command-attach.ts`. `runtime/tests/command-attach-guards.vitest.ts` covers it. A path such as `docs/create:skill.md` still reads as no command.\n\n#### The Doctor Helper for Missing Tools\n\nA prompt that says a tool does not show up now counts as a strong problem cue. The same holds when a tool does not appear. The brief then adds `/doctor:helper` beside the skills. \"Appear to\" and \"up-to-date\" stay out of the cue. A contraction typed with a curly apostrophe counts like a straight one.\n\n#### A Weak Cue Beside a Words-Only Skill\n\nA passing skill used to block the doctor hand-off unless the prompt carried a strong cue. Now a weak cue such as \"missing\" or \"drifted\" is enough when every passing skill matched on shared single words alone. The doctor ranker must still score the prompt at 10 or more. So \"the agents md file is missing the gate sections\" leads with `/doctor:agents-md check` and keeps `sk-doc` after it. A skill named by one of its own phrases still gets no doctor command on a weak cue.\n\n&nbsp;\n\n## No-Edit Prompts\n\n#### No Command When You Rule Out a Change\n=== ENV ref ===\n68:Flags can be set as environment variables **or** in a config file: copy `.skilled/hooks/hook-flags.env.example` to `.skilled/hooks/hook-flags.env` (gitignored) and set the same `KEY=value` names there. A real environment variable always overrides the file, so a persisted default can be flipped back for one session. `HOOK_FLAGS_CONFIG` overrides the config file path.\n74:| `SYSTEM_HOOKS_DISABLED` | unset (enabled) | truthy disable flag | Master switch for every concern below. No aliases. | `.skilled/hooks/shared/hook-flags.{cjs,mjs,ts,sh}` |\n75:| `SYSTEM_SKILL_ADVISOR_DISABLED` | unset (enabled) | truthy disable flag | Disables skill-advisor injection and makes the `advisor_recommend` direct call abstain. Aliases: `SYSTEM_SKILL_ADVISOR_HOOK_DISABLED`, `SYSTEM_SKILL_ADVISOR_PLUGIN_DISABLED`, `SPECKIT_SKILL_ADVISOR_HOOK_DISABLED`, `SPECKIT_SKILL_ADVISOR_PLUGIN_DISABLED`. | `system-skill-advisor/hooks/claude/user-prompt-submit.ts`, `.opencode/plugins/system-skill-advisor.js` |\n299:`SPECKIT_SKILL_ADVISOR_MODEL_SERVER_ENABLED` and the cascade-probe rows are shared by the HF model\n319:| `SPECKIT_SKILL_ADVISOR_MODEL_SERVER_ENABLED` | (unset → on) | string (`\"1\"` or `\"0\"`) | Whether the **skill-advisor** launcher arms the shared model-server spawn. Unset arms it, because since the memory decommission this launcher is the only surface that can start the model server. The spawn is lazy: the launcher binds a demand listener and the model process starts on the first embed request, or attaches to a resident that already listens. `0` (or any value other than `1`) turns the spawner off. Embedding then relies on the other providers, Ollama first, since hf-local is the local fallback behind Ollama in auto mode. An explicit `1` also makes a missing supervision library fatal. The default logs and degrades instead. | `.skilled/bin/system-skill-advisor-launcher.cjs` |\n325:**What changed is who starts it.** The spec-memory launcher used to spawn it lazily on first embed demand, with skill-advisor as the fallback winner of the socket-keyed lock. That launcher is gone, so the skill-advisor launcher is the only remaining spawner and it arms the spawn by default. `SPECKIT_SKILL_ADVISOR_MODEL_SERVER_ENABLED=0` is the kill switch. With it set there is no spawner at all.\n335:| Not started | `hf-local` health probe connect-refused, no `hf-embed.sock` | Normal before first demand. If it persists, confirm `SPECKIT_SKILL_ADVISOR_MODEL_SERVER_ENABLED` is not set to `0` (the advisor launcher arms the spawn by default and is the only spawner since the memory decommission), then check the advisor launcher's stderr for `demand listener` errors or a `spawn skipped` line. |\n428:| `SYSTEM_SKILL_ADVISOR_CLI_WARM_ONLY` | unset (off) | flag | Default the skill-advisor CLI to warm-only. Alias: `SPECKIT_SKILL_ADVISOR_CLI_WARM_ONLY`. | `.skilled/skills/system-skill-advisor/runtime/skill-advisor-cli.ts` |\n429:| `SYSTEM_SKILL_ADVISOR_CLI_PROMPT_TIME` | unset (off) | flag | Marks the skill-advisor CLI invocation as prompt-time, which implies warm-only. Alias: `SPECKIT_SKILL_ADVISOR_CLI_PROMPT_TIME`. | `.skilled/skills/system-skill-advisor/runtime/skill-advisor-cli.ts` |\n432:| `SYSTEM_SKILL_ADVISOR_CLI_DEV_ALLOW_STALE` | unset (off) | boolean (`\"1\"`) | Dev override for the skill-advisor shim's dist-freshness guard (skips the exit-`69` stale check). Alias: `SPECKIT_SKILL_ADVISOR_CLI_DEV_ALLOW_STALE`. | `.skilled/bin/skill-advisor.cjs` |\n433:| `SYSTEM_SKILL_ADVISOR_CLI_TRUSTED` | unset (untrusted) | boolean (`\"1\"`) | Send skill-advisor CLI calls as trusted (equivalent to `--trusted`), required for the mutation tools `advisor_rebuild`, `skill_graph_scan` and apply-mode `skill_graph_propagate_enhances`. Alias: `SPECKIT_SKILL_ADVISOR_CLI_TRUSTED`. | `.skilled/skills/system-skill-advisor/runtime/skill-advisor-cli.ts` |\n434:| `SYSTEM_SKILL_ADVISOR_TRUST_DEFAULT` | unset (fail-closed untrusted) | string (`\"trusted\"`) | **Daemon-side** trust default. The advisor daemon fails closed (untrusted) when a caller's transport `_meta` is absent. Setting `trusted` in the daemon's own environment restores default-trusted behavior for native MCP surfaces whose clients send no `_meta`. Set in the advisor launcher's repo defaults, and callers cannot forge it. | `.skilled/skills/system-skill-advisor/runtime/advisor-server.ts` |\n588:# export SPECKIT_SKILL_ADVISOR_MODEL_SERVER_ENABLED=0\n601:export SYSTEM_SKILL_ADVISOR_DISABLED=1\n602:export SYSTEM_HOOKS_DISABLED=1\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"cd /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research && sed -n 1,120p .skilled/skills/system-skill-advisor/changelog/v1.1.0.0.md && echo \\\"=== ENV ref ===\\\" && grep -n \\\"SKILL_ADVISOR\\\\|HOOK_FLAGS\\\\|SYSTEM_HOOKS_DISABLED\\\" .skilled/skills/system-spec-kit/runtime/ENV-REFERENCE.md | head -40\"}"},"time":{"start":1794760735119,"end":1794760736003}}}}
