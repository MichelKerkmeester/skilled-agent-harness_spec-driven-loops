make every\n68:     // isolated call abstain, so the scope names one that does not exist.\n69:     HOOK_FLAGS_CONFIG: join(rootDir, 'no-such-hook-flags.env'),\n70:     SPECKIT_IPC_SOCKET_DIR: socketDir,\n71:     SPECKIT_DAEMON_REELECTION: 'on',\n72:     SPECKIT_LEASE_PROBE_RETRIES: '1',\n73:     SPECKIT_PROBE_TIMEOUT_MS: '500',\n74:     SPECKIT_LEASE_PROBE_RETRY_TIMEOUT_MS: '200',\n75:     SPECKIT_LEASE_PROBE_RETRY_BACKOFF_MS: '10',\n76:     SYSTEM_SKILL_ADVISOR_DB_DIR: skillAdvisorDbDir,\n77:     MEMORY_DB_PATH: memoryDbPath,\n78:     SPECKIT_ADVISOR_SHADOW_DELTA_PATH: shadowDeltaPath,\n79:     SPECKIT_SKILL_ADVISOR_MODEL_SERVER_ENABLED: '0',\n80:     SKILL_ADVISOR_DISABLE_BUILTIN_SEMANTIC: '1',\n81:   };\n82:   // A switch exported in the shell would make every isolated call abstain.\n83:   for (const flag of ADVISOR_DISABLED_FLAGS) delete env[flag];\n84: \n85:   return {\n86:     rootDir,\n87:     inWorktreeDir,\n88:     socketDir,\n89:     socketPath: join(socketDir, 'daemon-ipc.sock'),\n90:     skillAdvisorDbDir,\n91:     memoryDbPath,\n92:     codeGraphDbDir,\n93:     shadowDeltaPath,\n94:     env,\n95:   };\n96: }\n97: \n98: export function runSkillAdvisorShim(\n99:   args: readonly string[],\n100:   env: NodeJS.ProcessEnv,\n101:   options: { readonly timeoutMs?: number; readonly input?: string } = {},\n102: ): CliRunResult {\n103:   const startedAt = Date.now();\n104:   const result = spawnSync(process.execPath, [skillAdvisorShim, ...args], {\n105:     cwd: repoRoot,\n106:     env,\n107:     input: options.input,\n108:     encoding: 'utf8',\n109:     maxBuffer: 1024 * 1024 * 20,\n110:     stdio: ['pipe', 'pipe', 'pipe'],\n111:     timeout: options.timeoutMs ?? 120_000,\n112:   }) as SpawnSyncReturns<string>;\n113:   return {\n114:     exitCode: result.status ?? (result.signal ? 128 : 1),\n115:     stdout: result.stdout ?? '',\n116:     stderr: result.stderr ?? '',\n117:     durationMs: Date.now() - startedAt,\n118:     signal: result.signal,\n119:   };\n120: }\n121: \n122: export async function runSkillAdvisorShimAsync(\n123:   args: readonly string[],\n124:   env: NodeJS.ProcessEnv,\n125:   options: { readonly timeoutMs?: number; readonly input?: string } = {},\n126: ): Promise<CliRunResult> {\n127:   const startedAt = Date.now();\n128:   const child = spawn(process.execPath, [skillAdvisorShim, ...args], {\n129:     cwd: repoRoot,\n130:     env,\n131:     stdio: ['pipe', 'pipe', 'pipe'],\n132:   });\n133: \n134:   let stdout = '';\n135:   let stderr = '';\n136:   child.stdout.setEncoding('utf8');\n137:   child.stderr.setEncoding('utf8');\n138:   child.stdout.on('data', (chunk) => {\n139:     stdout += chunk;\n140:   });\n141:   child.stderr.on('data', (chunk) => {\n142:     stderr += chunk;\n143:   });\n144: \n145:   return await new Promise<CliRunResult>((resolve) => {\n146:     let settled = false;\n147:     const finish = (exitCode: number, signal: NodeJS.Signals | null, extraStderr = ''): void => {\n148:       if (settled) return;\n149:       settled = true;\n150:       clearTimeout(timer);\n151:       resolve({\n152:         exitCode,\n153:         stdout,\n154:         stderr: `${stderr}${extraStderr}`,\n155:         durationMs: Date.now() - startedAt,\n156:         signal,\n157:       });\n158:     };\n159:     const timer = setTimeout(() => {\n160:       void terminatePidTree(child.pid).catch((error: unknown) => {\n161:         stderr += `${error instanceof Error ? error.message : String(error)}\\n`;\n162:       });\n163:     }, options.timeoutMs ?? 120_000);\n164: \n165:     child.once('error', (error) => {\n166:       finish(1, null, `${error.message}\\n`);\n167:     });\n168:     child.once('close', (code, signal) => {\n169:       finish(code ?? (signal ? 128 : 1), signal);\n170:     });\n171:     if (child.exitCode !== null || child.signalCode !== null) {\n172:       finish(child.exitCode ?? (child.signalCode ? 128 : 1), child.signalCode);\n173:       return;\n174:     }\n175:     if (options.input !== undefined) {\n176:       child.stdin.end(options.input);\n177:     } else {\n178:       child.stdin.end();\n179:     }\n180:   });\n181: }\n182: \n183: export function parseJsonOutput<T = Record<string, unknown>>(run: Pick<CliRunResult, 'stdout' | 'stderr'>): T {\n184:   const raw = run.stdout.trim() || run.stderr.trim();\n185:   if (!raw) throw new Error('CLI produced no JSON output');\n186:   return JSON.parse(raw) as T;\n187: }\n188: \n189: export function readJsonFile<T = Record<string, unknown>>(filePath: string): T | null {\n190:   try {\n191:     return JSON.parse(readFileSync(filePath, 'utf8')) as T;\n192:   } catch {\n193:     return null;\n194:   }\n195: }\n196: \n197: export function skillAdvisorLauncherLeasePath(dbDir: string): string {\n198:   return join(dbDir, '.system-skill-advisor-launcher.json');\n199: }\n200: \n201: export function readSkillAdvisorLauncherPid(dbDir: string): number | null {\n202:   const lease = readJsonFile<{ readonly pid?: unknown }>(skillAdvisorLauncherLeasePath(dbDir));\n203:   return typeof lease?.pid === 'number' ? lease.pid : null;\n204: }\n205: \n206: export function processLive(pid: number | null | undefined): boolean {\n207:   if (!Number.isInteger(pid) || (pid ?? 0) <= 0) return false;\n208:   try {\n209:     process.kill(pid as number, 0);\n210:     return true;\n211:   } catch (error: unknown) {\n212:     return (error as NodeJS.ErrnoException).code === 'EPERM';\n213:   }\n214: }\n215: \n216: export async function waitFor(\n217:   predicate: () => boolean,\n218:   timeoutMs: number,\n219:   label: string,\n220:   intervalMs = 25,\n221: ): Promise<void> {\n222:   const deadline = Date.now() + timeoutMs;\n223:   while (Date.now() <= deadline) {\n224:     if (predicate()) return;\n225:     await new Promise((resolve) => setTimeout(resolve, intervalMs));\n226:   }\n227:   throw new Error(`Timed out waiting for ${label}`);\n228: }\n229: \n230: export async function waitForPidExit(pid: number, timeoutMs: number): Promise<void> {\n231:   await waitFor(() => !processLive(pid), timeoutMs, `pid ${pid} to exit`, 50);\n232: }\n233: \n234: function processRows(): ProcessRow[] {\n235:   const result = spawnSync('ps', ['-A', '-o', 'pid=', '-o', 'ppid=', '-o', 'command='], {\n236:     encoding: 'utf8',\n237:     stdio: ['ignore', 'pipe', 'ignore'],\n238:   }) as SpawnSyncReturns<string>;\n239:   if (result.status !== 0 || result.error) return [];\n240:   return (result.stdout ?? '')\n241:     .split('\\n')\n242:     .map((line) => line.trim())\n243:     .filter(Boolean)\n244:     .map((line) => {\n245:       const match = line.match(/^(\\d+)\\s+(\\d+)\\s+(.*)$/);\n246:       if (!match) return null;\n247:       return {\n248:         pid: Number.parseInt(match[1], 10),\n249:         ppid: Number.parseInt(match[2], 10),\n250:         command: match[3],\n251:       };\n252:     })\n253:     .filter((row): row is ProcessRow => row !== null);\n254: }\n255: \n256: export function countProcessesMatching(needle: string): number {\n257:   return processRows().filter((row) => row.command.includes(needle)).length;\n258: }\n259: \n260: export function descendantPids(rootPid: number): number[] {\n261:   const rows = processRows();\n262:   const byParent = new Map<number, number[]>();\n263:   for (const row of rows) {\n264:     byParent.set(row.ppid, [...(byParent.get(row.ppid) ?? []), row.pid]);\n265:   }\n266:   const pending = [...(byParent.get(rootPid) ?? [])];\n267:   const descendants: number[] = [];\n268:   while (pending.length > 0) {\n269:     const pid = pending.pop();\n270:     if (!pid || descendants.includes(pid)) continue;\n271:     descendants.push(pid);\n272:     pending.push(...(byParent.get(pid) ?? []));\n273:   }\n274:   return descendants;\n275: }\n276: \n277: export async function terminatePidTree(pid: number | null | undefined, timeoutMs = 5000): Promise<void> {\n278:   if (!Number.isInteger(pid) || (pid ?? 0) <= 0) return;\n279:   const targets = [...descendantPids(pid as number).reverse(), pid as number];\n280:   for (const target of targets) {\n281:     try {\n282:       process.kill(target, 'SIGTERM');\n283:     } catch (error: unknown) {\n284:       if ((error as NodeJS.ErrnoException).code !== 'ESRCH') throw error;\n285:     }\n286:   }\n287:   const deadline = Date.now() + timeoutMs;\n288:   for (const target of targets) {\n289:     const remaining = Math.max(1, deadline - Date.now());\n290:     try {\n291:       await waitForPidExit(target, remaining);\n292:     } catch {\n293:       try {\n294:         process.kill(target, 'SIGKILL');\n295:       } catch (error: unknown) {\n296:         if ((error as NodeJS.ErrnoException).code !== 'ESRCH') throw error;\n297:       }\n298:     }\n299:   }\n300: }\n301: \n302: export async function cleanupSkillAdvisorScope(scope: IsolatedCliScope): Promise<void> {\n303:   await terminatePidTree(readSkillAdvisorLauncherPid(scope.skillAdvisorDbDir));\n304:   rmSync(scope.rootDir, { recursive: true, force: true });\n305:   rmSync(scope.inWorktreeDir, { recursive: true, force: true });\n306: }\n307: \n308: export function removeIfExists(pathValue: string): void {\n309:   if (existsSync(pathValue)) rmSync(pathValue, { recursive: true, force: true });\n310: }"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/tests/skill-advisor-cli-test-utils.ts\"}"},"time":{"start":1794760892193,"end":1794760893500}}}}
{"type":"tool_use","timestamp":1794760893535,"sessionID":"ses_e1feefdd5ffeS4J0KdMtC6TlEK","part":{"partID":"prt_1e015e0c7001H3lDkNY6qeo96M","sessionID":"ses_e1feefdd5ffeS4J0KdMtC6TlEK","messageID":"msg_1e014fd5a001tjY3nh8Ck11VhD","type":"tool","id":"call_6492132179ad4bdeab8de5c6","tool":"shell","state":{"status":"completed","input":{"command":"cd /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research && ls .skilled/skills/system-skill-advisor/runtime/lib/*.ts | sed 's|.*/||' && echo \"=== test utils top ===\" && sed -n 1,120p .skilled/skills/system-skill-advisor/runtime/tests/skill-advisor-cli-stale-daemon-retry.vitest.ts"},"output":"advisor-disabled.ts\nadvisor-runtime-values.ts\naffordance-normalizer.ts\ncaller-context.ts\ncommand-attach.ts\ncompiled-routing-flag.ts\ndf-idf.ts\nerror-diagnostics.ts\nfreshness.ts\ngeneration.ts\nmetrics.ts\nnormalize-adapter-output.ts\npolicy-plan.ts\nprivate-skill-target.ts\nprompt-cache.ts\nprompt-policy.ts\nrender.ts\nroute-exclusions.ts\nskill-advisor-brief.ts\nsource-cache.ts\nsubprocess.ts\n=== test utils top ===\n// ───────────────────────────────────────────────────────────────\n// MODULE: Skill Advisor CLI Stale-Daemon Retry Tests\n// ───────────────────────────────────────────────────────────────\n\nimport { existsSync, mkdirSync, writeFileSync } from 'node:fs';\nimport net from 'node:net';\nimport { join } from 'node:path';\nimport { StringDecoder } from 'node:string_decoder';\n\nimport { afterEach, describe, expect, it } from 'vitest';\n\nimport {\n  cleanupSkillAdvisorScope,\n  createIsolatedCliScope,\n  parseJsonOutput,\n  readSkillAdvisorLauncherPid,\n  type IsolatedCliScope,\n} from './skill-advisor-cli-test-utils.js';\n\nimport { ADVISOR_DISABLED_FLAGS } from '../lib/advisor-disabled.js';\nimport { runSkillAdvisorCli } from '../skill-advisor-cli.js';\n\ninterface FakeDaemon {\n  readonly calls: Array<Record<string, unknown>>;\n}\n\ninterface CliPayload {\n  readonly status?: string;\n  readonly data?: {\n    readonly recommendations?: ReadonlyArray<{ readonly skillId?: string }>;\n    readonly abstainReasons?: ReadonlyArray<string>;\n    readonly warnings?: ReadonlyArray<string>;\n    readonly freshness?: string;\n  };\n  readonly error?: string;\n  readonly exitCode?: number;\n}\n\ntype FakeDaemonBehavior = 'answer' | 'reject-compiled-route-option' | 'reject-unrelated-option';\n\nconst scopes: IsolatedCliScope[] = [];\nconst servers: net.Server[] = [];\nconst sockets: net.Socket[] = [];\n\nasync function startFakeAdvisorDaemon(socketPath: string, behavior: FakeDaemonBehavior): Promise<FakeDaemon> {\n  mkdirSync(socketPath.slice(0, socketPath.lastIndexOf('/')), { recursive: true, mode: 0o700 });\n  const calls: Array<Record<string, unknown>> = [];\n  const server = net.createServer((socket) => {\n    sockets.push(socket);\n    socket.once('close', () => {\n      const index = sockets.indexOf(socket);\n      if (index !== -1) sockets.splice(index, 1);\n    });\n    const decoder = new StringDecoder('utf8');\n    let buffer = '';\n    socket.on('data', (chunk) => {\n      buffer += Buffer.isBuffer(chunk) ? decoder.write(chunk) : String(chunk ?? '');\n      let newlineIndex = buffer.indexOf('\\n');\n      while (newlineIndex !== -1) {\n        const line = buffer.slice(0, newlineIndex).trim();\n        buffer = buffer.slice(newlineIndex + 1);\n        newlineIndex = buffer.indexOf('\\n');\n        if (!line) continue;\n        const request = JSON.parse(line) as Record<string, unknown>;\n        if (!Object.prototype.hasOwnProperty.call(request, 'id')) continue;\n        if (request.method === 'initialize') {\n          socket.write(`${JSON.stringify({\n            jsonrpc: '2.0',\n            id: request.id,\n            result: { advisorProtocol: '1' },\n          })}\\n`);\n          continue;\n        }\n        if (request.method !== 'advisor.call') continue;\n\n        const params = request.params as { readonly args?: Record<string, unknown> } | undefined;\n        const args = params?.args ?? {};\n        calls.push(args);\n        const options = args.options;\n        const hasCompiledRouteOption = typeof options === 'object'\n          && options !== null\n          && Object.prototype.hasOwnProperty.call(options, 'includeCompiledRoute');\n        const errorMessage = behavior === 'answer'\n          ? null\n          : behavior === 'reject-unrelated-option'\n            ? 'Unrecognized key in options: unsupportedOption'\n            : hasCompiledRouteOption\n              ? 'Unrecognized key in options: includeCompiledRoute'\n              : null;\n\n        const response: Record<string, unknown> = errorMessage\n          ? {\n            jsonrpc: '2.0',\n            id: request.id,\n            error: { code: -32602, message: errorMessage },\n          }\n          : {\n            jsonrpc: '2.0',\n            id: request.id,\n            result: {\n              status: 'ok',\n              data: {\n                recommendations: [{ skillId: 'sk-code', confidence: 0.91, uncertainty: 0.12 }],\n                freshness: 'live',\n              },\n            },\n          };\n        socket.write(`${JSON.stringify(response)}\\n`);\n      }\n    });\n  });\n\n  await new Promise<void>((resolve, reject) => {\n    server.once('error', reject);\n    server.listen(socketPath, () => {\n      server.off('error', reject);\n      resolve();\n    });\n  });\n  servers.push(server);\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"advisor-disabled.ts\nadvisor-runtime-values.ts\naffordance-normalizer.ts\ncaller-context.ts\ncommand-attach.ts\ncompiled-routing-flag.ts\ndf-idf.ts\nerror-diagnostics.ts\nfreshness.ts\ngeneration.ts\nmetrics.ts\nnormalize-adapter-output.ts\npolicy-plan.ts\nprivate-skill-target.ts\nprompt-cache.ts\nprompt-policy.ts\nrender.ts\nroute-exclusions.ts\nskill-advisor-brief.ts\nsource-cache.ts\nsubprocess.ts\n=== test utils top ===\n// ───────────────────────────────────────────────────────────────\n// MODULE: Skill Advisor CLI Stale-Daemon Retry Tests\n// ───────────────────────────────────────────────────────────────\n\nimport { existsSync, mkdirSync, writeFileSync } from 'node:fs';\nimport net from 'node:net';\nimport { join } from 'node:path';\nimport { StringDecoder } from 'node:string_decoder';\n\nimport { afterEach, describe, expect, it } from 'vitest';\n\nimport {\n  cleanupSkillAdvisorScope,\n  createIsolatedCliScope,\n  parseJsonOutput,\n  readSkillAdvisorLauncherPid,\n  type IsolatedCliScope,\n} from './skill-advisor-cli-test-utils.js';\n\nimport { ADVISOR_DISABLED_FLAGS } from '../lib/advisor-disabled.js';\nimport { runSkillAdvisorCli } from '../skill-advisor-cli.js';\n\ninterface FakeDaemon {\n  readonly calls: Array<Record<string, unknown>>;\n}\n\ninterface CliPayload {\n  readonly status?: string;\n  readonly data?: {\n    readonly recommendations?: ReadonlyArray<{ readonly skillId?: string }>;\n    readonly abstainReasons?: ReadonlyArray<string>;\n    readonly warnings?: ReadonlyArray<string>;\n    readonly freshness?: string;\n  };\n  readonly error?: string;\n  readonly exitCode?: number;\n}\n\ntype FakeDaemonBehavior = 'answer' | 'reject-compiled-route-option' | 'reject-unrelated-option';\n\nconst scopes: IsolatedCliScope[] = [];\nconst servers: net.Server[] = [];\nconst sockets: net.Socket[] = [];\n\nasync function startFakeAdvisorDaemon(socketPath: string, behavior: FakeDaemonBehavior): Promise<FakeDaemon> {\n  mkdirSync(socketPath.slice(0, socketPath.lastIndexOf('/')), { recursive: true, mode: 0o700 });\n  const calls: Array<Record<string, unknown>> = [];\n  const server = net.createServer((socket) => {\n    sockets.push(socket);\n    socket.once('close', () => {\n      const index = sockets.indexOf(socket);\n      if (index !== -1) sockets.splice(index, 1);\n    });\n    const decoder = new StringDecoder('utf8');\n    let buffer = '';\n    socket.on('data', (chunk) => {\n      buffer += Buffer.isBuffer(chunk) ? decoder.write(chunk) : String(chunk ?? '');\n      let newlineIndex = buffer.indexOf('\\n');\n      while (newlineIndex !== -1) {\n        const line = buffer.slice(0, newlineIndex).trim();\n        buffer = buffer.slice(newlineIndex + 1);\n        newlineIndex = buffer.indexOf('\\n');\n        if (!line) continue;\n        const request = JSON.parse(line) as Record<string, unknown>;\n        if (!Object.prototype.hasOwnProperty.call(request, 'id')) continue;\n        if (request.method === 'initialize') {\n          socket.write(`${JSON.stringify({\n            jsonrpc: '2.0',\n            id: request.id,\n            result: { advisorProtocol: '1' },\n          })}\\n`);\n          continue;\n        }\n        if (request.method !== 'advisor.call') continue;\n\n        const params = request.params as { readonly args?: Record<string, unknown> } | undefined;\n        const args = params?.args ?? {};\n        calls.push(args);\n        const options = args.options;\n        const hasCompiledRouteOption = typeof options === 'object'\n          && options !== null\n          && Object.prototype.hasOwnProperty.call(options, 'includeCompiledRoute');\n        const errorMessage = behavior === 'answer'\n          ? null\n          : behavior === 'reject-unrelated-option'\n            ? 'Unrecognized key in options: unsupportedOption'\n            : hasCompiledRouteOption\n              ? 'Unrecognized key in options: includeCompiledRoute'\n              : null;\n\n        const response: Record<string, unknown> = errorMessage\n          ? {\n            jsonrpc: '2.0',\n            id: request.id,\n            error: { code: -32602, message: errorMessage },\n          }\n          : {\n            jsonrpc: '2.0',\n            id: request.id,\n            result: {\n              status: 'ok',\n              data: {\n                recommendations: [{ skillId: 'sk-code', confidence: 0.91, uncertainty: 0.12 }],\n                freshness: 'live',\n              },\n            },\n          };\n        socket.write(`${JSON.stringify(response)}\\n`);\n      }\n    });\n  });\n\n  await new Promise<void>((resolve, reject) => {\n    server.once('error', reject);\n    server.listen(socketPath, () => {\n      server.off('error', reject);\n      resolve();\n    });\n  });\n  servers.push(server);\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"cd /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research && ls .skilled/skills/system-skill-advisor/runtime/lib/*.ts | sed 's|.*/||' && echo \\\"=== test utils top ===\\\" && sed -n 1,120p .skilled/skills/system-skill-advisor/runtime/tests/skill-advisor-cli-stale-daemon-retry.vitest.ts\"}"},"time":{"start":1794760892615,"end":1794760893535}}}}
