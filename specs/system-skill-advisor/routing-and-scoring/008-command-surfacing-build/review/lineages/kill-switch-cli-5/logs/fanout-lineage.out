1).optional(),\n295-    includeCompiledRoute: z.boolean().optional(),\n296-    // Limits the per-hub route lookup to the first recommendation, for a caller\n297-    // on a tight time budget that acts on the top pick alone.\n298-    compiledRouteTopOnly: z.boolean().optional(),\n299-    // Forwarded to the compiled-route front door as --surface-hint; a value\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"762:function validateCommand(parsed: ParsedCommand): { readonly tool: SkillAdvisorCliToolDefinition; readonly args: Record<string, unknown> } | null {\n763-  if (RESERVED_COMMANDS.has(parsed.command)) return null;\n764-  const tool = getToolDefinition(parsed.command);\n765-  if (!tool) {\n766-    throw new CliUsageError(`Unknown command: ${parsed.command}`);\n767-  }\n768-\n769-  const args = { ...parsed.args };\n770-  const properties = new Set(inputPropertyNames(tool));\n771-  if (parsed.sessionId && !Object.prototype.hasOwnProperty.call(args, 'sessionId') && properties.has('sessionId')) {\n772-    args.sessionId = parsed.sessionId;\n773-  } else if (parsed.sessionId && !Object.prototype.hasOwnProperty.call(args, 'session_id') && properties.has('session_id')) {\n774-    args.session_id = parsed.sessionId;\n775-  }\n776-\n777-  const validated = validateToolArgs(tool, args);\n778-  assertTrustedForMutation(tool.name, validated, parsed.trusted, parsed.promptTime);\n779-  return { tool, args: validated };\n780-}\n781-\n782-function renderJson(value: unknown, format: OutputFormat): string {\n783-  if (format === 'jsonl') return JSON.stringify(value);\n784-  return JSON.stringify(value, null, 2);\n785-}\n786-\n787-function usageText(command?: string): string {\n788-  const tool = command ? getToolDefinition(command) : null;\n789-  if (tool) {\n790-    return `skill-advisor ${tool.command}\n791-\n792-Description:\n793-  ${tool.description}\n794-\n795-Aliases:\n796-  ${tool.aliases.join(', ')}\n797-\n798-Input schema:\n799-${JSON.stringify(tool.inputSchema, null, 2)}`;\n800-  }\n801-\n802-  const commands = SKILL_ADVISOR_CLI_TOOL_MANIFEST\n=== BoundedWorkspaceRootSchema ===\n207:const BoundedWorkspaceRootSchema = z\n208-  .string()\n209-  .min(1)\n210-  .refine(isAllowedWorkspaceRoot, {\n211-    message:\n212-      'workspaceRoot must resolve under the repo root, os.tmpdir(), an explicit SPECKIT_ADVISOR_WORKSPACE_ALLOWLIST entry, or a project whose .skilled links to this source tree',\n213-  });\n214-\n215-const laneBreakdownSchema = z.object({\n216-  lane: AdvisorLaneSchema,\n217-  rawScore: z.number().min(0),\n218-  weightedScore: z.number().min(0),\n219-  weight: z.number().min(0),\n220-  shadowOnly: z.boolean(),\n221-}).strict();\n222-\n223-const whyRecommendedLaneSchema = laneBreakdownSchema.extend({\n224-  evidenceTypes: z.array(z.string().min(1)),\n225-  evidenceCount: z.number().int().nonnegative(),\n226-}).strict();\n227-\n228-const whyRecommendedSchema = z.object({\n229-  reason: z.string().min(1),\n230-  dominantLane: AdvisorLaneSchema.nullable(),\n231-  topLanes: z.array(whyRecommendedLaneSchema),\n232-  matchedSkillFeatures: z.array(z.object({\n233-    lane: AdvisorLaneSchema,\n234-    feature: z.string().min(1),\n235-  }).strict()),\n236-}).strict();\n237-\n--\n287:  workspaceRoot: BoundedWorkspaceRootSchema.optional(),\n288-  prompt: z.string().min(1).max(ADVISOR_PROMPT_MAX_CHARS),\n289-  options: z.object({\n290-    topK: z.number().int().min(1).max(10).optional(),\n291-    includeAttribution: z.boolean().optional(),\n292-    includeAbstainReasons: z.boolean().optional(),\n293-    confidenceThreshold: z.number().min(0).max(1).optional(),\n294-    uncertaintyThreshold: z.number().min(0).max(1).optional(),\n295-    includeCompiledRoute: z.boolean().optional(),\n296-    // Limits the per-hub route lookup to the first recommendation, for a caller\n297-    // on a tight time budget that acts on the top pick alone.\n298-    compiledRouteTopOnly: z.boolean().optional(),\n299-    // Forwarded to the compiled-route front door as --surface-hint; a value\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"cd /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research && grep -n -A 40 \\\"function validateCommand\\\" .skilled/skills/system-skill-advisor/runtime/skill-advisor-cli.ts | head -60 && echo \\\"=== BoundedWorkspaceRootSchema ===\\\" && grep -n -A 30 \\\"BoundedWorkspaceRootSchema\\\" .skilled/skills/system-skill-advisor/runtime/schemas/advisor-tool-schemas.ts | head -45\"}"},"time":{"start":1794761066257,"end":1794761067498}}}}
