ceability',\n    findingClass: 'cross-consumer',\n    case: 'A maintainer who changes where the direct call reads the switch greps the two listed sources, edits the hook and the plugin, and leaves the CLI and daemon readers on the old behavior.',\n    scopeProof: 'rg -n \"disabledRecommendOutput|advisorDisabledBy\" .skilled/skills/system-skill-advisor/runtime finds exactly the CLI and daemon readers plus the shared builder; none is named in the row Source column.',\n    affectedSurfaceHints: ['ENV-REFERENCE hook kill-switches table', 'runtime/lib/advisor-disabled.ts', 'runtime/skill-advisor-cli.ts', 'runtime/handlers/advisor-recommend.ts'],\n    evidenceRefs: ['.skilled/skills/system-spec-kit/runtime/ENV-REFERENCE.md:71', '.skilled/skills/system-spec-kit/runtime/ENV-REFERENCE.md:75', '.skilled/skills/system-skill-advisor/runtime/lib/advisor-disabled.ts:70-93', '.skilled/skills/system-skill-advisor/runtime/skill-advisor-cli.ts:1540', '.skilled/skills/system-skill-advisor/runtime/handlers/advisor-recommend.ts:646']\n  },\n  {\n    id: 'iter2-P2-cp003-control-aliases',\n    severity: 'P2',\n    title: 'CP-003 control call can abstain under a switch alias it never unsets',\n    file: '.skilled/skills/system-skill-advisor/manual-testing-playbook/compat-and-disable/global-disable-flag.md:49',\n    dimension: 'traceability',\n    findingClass: 'class-of-bug',\n    case: 'An operator whose shell exports SYSTEM_SKILL_ADVISOR_PLUGIN_DISABLED=1 runs CP-003 as written; the control call also abstains, so the operator reads it as the switch reaching the daemon and blocks a release.',\n    scopeProof: 'The resolver honors ten skill-advisor switch names; the control command unsets four. Observed read-only on the built CLI under SYSTEM_SKILL_ADVISOR_PLUGIN_DISABLED=1: recommendations [], abstain Skill advisor disabled by SYSTEM_SKILL_ADVISOR_PLUGIN_DISABLED.',\n    affectedSurfaceHints: ['CP-003 step 1 control command', 'hook-flags resolver LEGACY_ALIASES', 'cli client disabled check'],\n    evidenceRefs: ['.skilled/skills/system-skill-advisor/manual-testing-playbook/compat-and-disable/global-disable-flag.md:49', '.skilled/skills/system-skill-advisor/manual-testing-playbook/compat-and-disable/global-disable-flag.md:80', '.skilled/hooks/shared/hook-flags.cjs:41', '.skilled/hooks/shared/hook-flags.cjs:70-78', '.skilled/skills/system-skill-advisor/runtime/lib/advisor-disabled.ts:70-93']\n  }\n];\nconst findingDetails = findings.map((f) => ({\n  id: f.id,\n  findingId: f.id,\n  severity: f.severity,\n  title: f.title,\n  file: f.file,\n  dimension: f.dimension,\n  findingClass: f.findingClass,\n  case: f.case,\n  scopeProof: f.scopeProof,\n  affectedSurfaceHints: f.affectedSurfaceHints,\n  evidenceRefs: f.evidenceRefs\n}));\nconst record = {\n  type: 'iteration',\n  iteration: 2,\n  mode: 'review',\n  target_agent: 'deep-review',\n  agent_definition_loaded: true,\n  resolved_route: 'Resolved route: mode=review target_agent=deep-review',\n  run: sessionId,\n  status: 'complete',\n  focus: 'traceability-docs-and-scenario',\n  dimensions: ['traceability'],\n  filesReviewed: [\n    '.skilled/skills/system-spec-kit/runtime/ENV-REFERENCE.md:60-90,590-610',\n    '.skilled/hooks/hook-flags.env.example:1-90',\n    '.skilled/hooks/README.md:40-50,78-82',\n    '.skilled/skills/system-skill-advisor/manual-testing-playbook/compat-and-disable/global-disable-flag.md:30-104',\n    '.skilled/skills/system-skill-advisor/INSTALL-GUIDE.md:160-200',\n    '.skilled/skills/system-skill-advisor/feature-catalog/cli-surface/advisor-recommend.md:23',\n    '.skilled/skills/system-skill-advisor/changelog/v1.1.0.0.md:60-80',\n    '.skilled/hooks/shared/hook-flags.cjs:38-41,234-285',\n    '.skilled/hooks/shared/env-aliases.cjs:20-49',\n    '.skilled/skills/system-skill-advisor/runtime/lib/advisor-disabled.ts:70-93',\n    '.skilled/skills/system-skill-advisor/runtime/skill-advisor-cli.ts:1540',\n    '.skilled/skills/system-skill-advisor/runtime/handlers/advisor-recommend.ts:646'\n  ],\n  findingsCount: findings.length,\n  findingsSummary: { P0: 0, P1: 0, P2: findings.length },\n  findingsNew: findings.map((f) => f.id),\n  findingDetails,\n  traceabilityChecks: {\n    spec_code: { status: 'pass', notes: 'Every doc claim read against the resolver constant or the reader line.' },\n    checklist_evidence: { status: 'partial', notes: 'Switch paths and docs/scenario claims covered; holdout hygiene checked by not opening any prompt file.' },\n    skill_agent: { status: 'notApplicable', notes: 'No agent definition changed in this area.' },\n    agent_cross_runtime: { status: 'notApplicable', notes: 'No runtime mirror changed in this area.' },\n    feature_catalog_code: { status: 'pass', notes: 'The advisor-recommend feature row matches the CLI/file and daemon/own-env split.' },\n    playbook_capability: { status: 'fail', notes: 'CP-003 control command does not unset the full alias set the resolver honors.' }\n  },\n  newFindingsRatio: 1,\n  noveltyJustification: 'First traceability pass over the switch docs; all three P2s are new and none repeats a pass-four finding, which covered offer attribution, heredocs, holdout rows and scorer counters.',\n  sessionId,\n  generation: 1,\n  lineageMode: 'new',\n  timestamp: now,\n  durationMs: 480000,\n  reviewDepthSchemaVersion: 2,\n  reviewDepthApplicability: {\n    scopeClass: 'standard',\n    enforcement: 'strict',\n    reason: 'Shared env index, a manual scenario, two feature docs and the resolver/readers; not trivial.',\n    evidenceRefs: ['review-scope-5.txt:34-48', 'review-brief-5.txt:1']\n  },\n  targetSelection: {\n    selectedTargets: [\n      'ENV-REFERENCE.md',\n      'hook-flags.env.example',\n      'hooks/README.md',\n      'global-disable-flag.md',\n      'INSTALL-GUIDE.md',\n      'feature-catalog/cli-surface/advisor-recommend.md',\n      'changelog/v1.1.0.0.md'\n    ],\n    selectionReason: 'These are the docs that describe the pass-five kill-switch-cli files; the resolver and reader lines are the code side of every doc claim.',\n    discoveryMethods: ['direct_read', 'exact_search'],\n    omittedHighRiskTargets: ['prompt and holdout files (counts only)', 'command-attach.ts (out of pass-five scope)'],\n    graphStatus: 'unavailable',\n    semanticSearchStatus: 'unavailable',\n    evidenceRefs: ['review-scope-5.txt:11,24,27-29,36-37,40,43,46-48']\n  },\n  searchCoverage: {\n    requiredBugClasses: ['alias_table_drift', 'source_column_missing_reader', 'scenario_alias_isolation'],\n    covered: ['alias_table_drift', 'source_column_missing_reader', 'scenario_alias_isolation'],\n    ruledOut: [],\n    deferred: [],\n    blocked: [],\n    graphCoverageMode: 'graphless_fallback'\n  },\n  searchLedger: [\n    {\n      id: 'SL-205',\n      dimension: 'traceability',\n      targetRefs: ['ENV-REFERENCE.md', 'hooks/README.md', 'hook-flags.cjs'],\n      bugClass: 'alias_table_drift',\n      hypothesis: 'The env index alias columns omit names the resolver honors.',\n      searchActions: [\n        { method: 'direct_read', queryOrPath: 'ENV-REFERENCE.md:74-75; hook-flags.cjs:38-41,70-78; hooks/README.md:44', result: 'the master row says No aliases; the resolver has MK_HOOKS_DISABLED and the skill-advisor row omits the MK_ names', evidenceRefs: ['ENV-REFERENCE.md:74', 'hook-flags.cjs:41', 'hook-flags.cjs:70-78'] },\n        { method: 'runtime_probe', queryOrPath: 'MK_HOOKS_DISABLED=1 built CLI advisor_recommend', result: 'abstains with SYSTEM_HOOKS_DISABLED', evidenceRefs: ['ENV-REFERENCE.md:74'] }\n      ],\n      disposition: 'finding',\n      linkedFindingId: 'iter2-P2-env-alias-column',\n      rationale: 'The table is the canonical index and its alias column contradicts the resolver.'\n    },\n    {\n      id: 'SL-206',\n      dimension: 'traceability',\n      targetRefs: ['ENV-REFERENCE.md', 'advisor-disabled.ts', 'skill-advisor-cli.ts', 'advisor-recommend.ts'],\n      bugClass: 'source_column_missing_reader',\n      hypothesis: 'The row claims a direct-call absta