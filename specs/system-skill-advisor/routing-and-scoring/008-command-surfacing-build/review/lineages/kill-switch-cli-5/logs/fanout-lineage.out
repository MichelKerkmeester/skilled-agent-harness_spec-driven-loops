ion: 'security',\\n      targetRefs: ['command-prompts.jsonl', 'holdout-prompts.jsonl', 'behaviour-fresh-prompts.jsonl'],\\n      bugClass: 'holdout_hygiene',\\n      hypothesis: 'A reviewed doc or test path reads or prints a holdout prompt row.',\\n      searchActions: [\\n        { method: 'holdout_count_probe', queryOrPath: \\\"jq -c 'del(.prompt)' <file> | wc -l\\\", result: '224 / 63 / 36 rows; no prompt text printed', evidenceRefs: ['review-brief-5.txt:1'] }\\n      ],\\n      disposition: 'ruled_out',\\n      rationale: 'No prompt row was opened, printed or used; only counts were produced.',\\n      ruledOutReason: 'Counts-only probe; no prompt text in any artifact.'\\n    }\\n  ],\\n  graphEvents: [\\n    { type: 'node', id: 'dim:stabilization', kind: 'DIMENSION', label: 'Stabilization' },\\n    { type: 'node', id: 'ev:active-finding-replay', kind: 'EVIDENCE', label: 'Six active P2 replay' },\\n    { type: 'node', id: 'ev:holdout-counts', kind: 'EVIDENCE', label: 'Holdout counts 224/63/36' },\\n    { type: 'node', id: 'inv:no-prompt-text', kind: 'INVARIANT', label: 'No holdout prompt text leaves the files' },\\n    { type: 'node', id: 'find:iter2-P2-env-alias-column', kind: 'FINDING', label: 'Master alias column drift' },\\n    { type: 'node', id: 'find:iter2-P2-env-source-column', kind: 'FINDING', label: 'Direct-call source column omission' },\\n    { type: 'node', id: 'find:iter2-P2-cp003-control-aliases', kind: 'FINDING', label: 'CP-003 control alias leakage' },\\n    { type: 'node', id: 'find:iter3-P2-launcher-switch-fixture', kind: 'FINDING', label: 'Launcher fixture gap' },\\n    { type: 'node', id: 'find:iter3-P2-cli-mk-alias-filter', kind: 'FINDING', label: 'MK_ alias filter gap' },\\n    { type: 'node', id: 'find:iter3-P2-lib-readme-tree', kind: 'FINDING', label: 'Lib tree drift' },\\n    { type: 'edge', id: 'e:ev-active-replay-confirms-alias', source: 'ev:active-finding-replay', target: 'find:iter2-P2-env-alias-column', relation: 'CONFIRMS' },\\n    { type: 'edge', id: 'e:ev-active-replay-confirms-source', source: 'ev:active-finding-replay', target: 'find:iter2-P2-env-source-column', relation: 'CONFIRMS' },\\n    { type: 'edge', id: 'e:ev-active-replay-confirms-cp003', source: 'ev:active-finding-replay', target: 'find:iter2-P2-cp003-control-aliases', relation: 'CONFIRMS' },\\n    { type: 'edge', id: 'e:ev-active-replay-confirms-launcher', source: 'ev:active-finding-replay', target: 'find:iter3-P2-launcher-switch-fixture', relation: 'CONFIRMS' },\\n    { type: 'edge', id: 'e:ev-active-replay-confirms-mk', source: 'ev:active-finding-replay', target: 'find:iter3-P2-cli-mk-alias-filter', relation: 'CONFIRMS' },\\n    { type: 'edge', id: 'e:ev-active-replay-confirms-lib', source: 'ev:active-finding-replay', target: 'find:iter3-P2-lib-readme-tree', relation: 'CONFIRMS' },\\n    { type: 'edge', id: 'e:inv-no-prompt-holds-evidence', source: 'inv:no-prompt-text', target: 'ev:holdout-counts', relation: 'CONFIRMS' },\\n    { type: 'edge', id: 'e:dim-stabilization-covers-replay', source: 'dim:stabilization', target: 'ev:active-finding-replay', relation: 'COVERS' }\\n  ]\\n};\\nfs.writeFileSync(dir + '/iter-004.record.json', JSON.stringify(record));\\nconst delta = [\\n  record,\\n  { type: 'classification', detail: 'Stabilization: six active P2s re-read and confirmed; no new finding; holdout counts 224/63/36 with no prompt text.', iteration: 4 },\\n  { type: 'ruled_out', direction: 'missed switch path in advisor_status or graph tools', reason: 'the docs claim prompt injection and the advisor_recommend direct call only', iteration: 4 },\\n  { type: 'ruled_out', direction: 'plugin reason label is a behavior gap', reason: 'the plugin is disabled through isHookEnabled; only the diagnostic string falls back', iteration: 4 },\\n  { type: 'ruled_out', direction: 'Python shim canonical-name handling', reason: 'CP-003 uses the SPECKIT_ name the shim honors; the shim is out of pass-five scope', iteration: 4 },\\n  { type: 'ruled_o