test.ts:22:const ORIGINAL_HOOK_DISABLED = process.env.SPECKIT_SKILL_ADVISOR_HOOK_DISABLED;\n.skilled/skills/system-skill-advisor/runtime/tests/hooks/doctor-setup-hint.vitest.ts:76:  if (ORIGINAL_HOOK_DISABLED === undefined) delete process.env.SPECKIT_SKILL_ADVISOR_HOOK_DISABLED;\n.skilled/skills/system-skill-advisor/runtime/tests/hooks/doctor-setup-hint.vitest.ts:77:  else process.env.SPECKIT_SKILL_ADVISOR_HOOK_DISABLED = ORIGINAL_HOOK_DISABLED;\n.skilled/skills/system-skill-advisor/runtime/tests/compiled-routing-consumption.vitest.ts:82:    delete process.env.SPECKIT_SKILL_ADVISOR_HOOK_DISABLED;\n.skilled/skills/system-skill-advisor/runtime/tests/handlers/advisor-recommend.vitest.ts:10:import { ADVISOR_DISABLED_FLAGS } from '../../lib/advisor-disabled.js';\n.skilled/skills/system-skill-advisor/runtime/tests/handlers/advisor-recommend.vitest.ts:109:  for (const name of ADVISOR_DISABLED_FLAGS) delete process.env[name];\n.skilled/skills/system-skill-advisor/runtime/tests/handlers/advisor-recommend.vitest.ts:119:  for (const name of ADVISOR_DISABLED_FLAGS) delete process.env[name];\n.skilled/skills/system-skill-advisor/runtime/tests/handlers/advisor-recommend.vitest.ts:385:    process.env.SPECKIT_SKILL_ADVISOR_HOOK_DISABLED = '1';\n.skilled/skills/system-skill-advisor/runtime/tests/handlers/advisor-recommend.vitest.ts:391:    expect(response.data.warnings).toEqual(['ADVISOR_DISABLED']);\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":".skilled/skills/system-skill-advisor/INSTALL-GUIDE.md:52:- `SPECKIT_SKILL_ADVISOR_HOOK_DISABLED` is unset unless you are intentionally testing rollback.\n.skilled/skills/system-skill-advisor/INSTALL-GUIDE.md:174:| `SPECKIT_SKILL_ADVISOR_HOOK_DISABLED=1` | Disables prompt-time advisor briefs and makes the CLI and the scorer skip advisor work. |\n.skilled/skills/system-skill-advisor/INSTALL-GUIDE.md:181:export SPECKIT_SKILL_ADVISOR_HOOK_DISABLED=1\n.skilled/skills/system-skill-advisor/INSTALL-GUIDE.md:193:unset SPECKIT_SKILL_ADVISOR_HOOK_DISABLED\n.skilled/skills/system-skill-advisor/feature-catalog/hooks-and-plugin/claude-hook.md:24:`hooks/claude/user-prompt-submit.ts` reads the prompt from stdin, calls the native advisor and returns a JSON envelope with `hookSpecificOutput.additionalContext`. The hook honors `SPECKIT_SKILL_ADVISOR_HOOK_DISABLED=1` and fails open on any daemon-level failure. As a default-off, fail-open shadow it also records post-emission advisor-policy delivery (`observeEmittedAdvisorPolicy`), an observed receipt with `lifecycleEpoch >= 1`, as the final step before returning, leaving the emitted envelope byte-identical. Freshness vocabulary is `live / stale / absent / unavailable`. Status vocabulary is `ok / skipped / degraded / fail_open`.\n.skilled/skills/system-skill-advisor/feature-catalog/hooks-and-plugin/opencode-plugin-bridge.md:24:`.opencode/plugins/system-skill-advisor.js` exports the plugin. It spawns `.skilled/bin/skill-advisor.cjs` for each advisor call, bounded at a 64 KiB stdin request, a 256 KiB stdout cap and a 2 KiB brief cap. The request carries at most the first 10,000 prompt characters, the most `advisor_recommend` accepts. A budget too small for any prompt spawns nothing. Cache TTL is 5 minutes. The live threshold pair is `confidenceThreshold: 0.8` and `uncertaintyThreshold: 0.35`. The CLI call times out after 2500 ms with SIGKILL escalation. Opt-out via `SYSTEM_SKILL_ADVISOR_HOOK_DISABLED=1` or `SYSTEM_SKILL_ADVISOR_PLUGIN_DISABLED=1` (with legacy `SPECKIT_SKILL_ADVISOR_HOOK_DISABLED=1` and `SPECKIT_SKILL_ADVISOR_PLUGIN_DISABLED=1` aliases) or `enabled: false` in plugin config. The plugin renders through the shared `renderAdvisorBrief` contract loaded from the compiled package instead of pinning private handler paths. A degraded CLI answer, returned when the daemon is unreachable, is labeled `route: \"cli-local-scorer\"` and otherwise renders like any other recommendation.\n.skilled/skills/system-skill-advisor/feature-catalog/cli-surface/advisor-recommend.md:23:`handlers/advisor-recommend.ts` implements the command. Input is validated by `schemas/advisor-tool-schemas.ts` (Zod strict). The public response always includes the resolved `workspaceRoot` plus `effectiveThresholds`, where `effectiveThresholds` publishes the active `confidenceThreshold`, `uncertaintyThreshold` and `confidenceOnly` mode after request overrides are merged with defaults. Output also carries prompt-safe `recommendations[]`, optional `laneBreakdown[]` when `includeAttribution: true`, lifecycle redirect metadata (`redirectFrom`, `redirectTo`, `status`), `freshness`, `trustState`, `generatedAt`, `cache`, optional `warnings` and optional `abstainReasons`. Fail-open states such as disabled or absent freshness still preserve `workspaceRoot` and `effectiveThresholds` in the envelope so callers can inspect the resolved repository scope and active routing thresholds even when no recommendations are returned. The disabled envelope is built by `lib/advisor-disabled.ts`, which the handler and the CLI client both call. The client calls it first, in the caller's own process, so the direct call abstains whenever the skill-advisor hooks are off, by the same rule the adapters use: the canonical `SYSTEM_SKILL_ADVISOR_DISABLED`, its aliases such as `SYSTEM_SKILL_ADVISOR_HOOK_DISABLED` and `SPECKIT_SKILL_ADVISOR_HOOK_DISABLED`, the master switch `SYSTEM_HOOKS_DISABLED`, any truthy value or a line in the flags file. It abstains before it reaches a daemon and before the local scorer runs. A daemon that does answer reads only its own environment. The handler enforces sanitization at the envelope boundary (see `lib/derived/sanitizer.ts`) and never echoes prompt text into response metadata. Cache behavior is tied to generation (see [`daemon-and-freshness/cache-invalidation.md`](../../feature-catalog/daemon-and-freshness/cache-invalidation.md)).\n.skilled/skills/system-skill-advisor/feature-catalog/python-compat/cli-shim.md:30:| `SPECKIT_SKILL_ADVISOR_HOOK_DISABLED=1` | Disable advisor invocation entirely. |\n.skilled/skills/system-skill-advisor/changelog/v1.1.0.0.md:73:A direct `advisor_recommend` call now abstains whenever the skill-advisor hooks are off. It decides in the caller's own process, under `SYSTEM_SKILL_ADVISOR_DISABLED`, its aliases, the master switch or the flags file. That happens before any daemon starts or the scorer runs. The launcher passes no switch name to a daemon it starts.\n.skilled/skills/system-skill-advisor/references/decisions/deferred-decisions.md:81:- The disable-flag interaction (per `INSTALL-GUIDE.md` §8): Devin hook checks `SYSTEM_SKILL_ADVISOR_HOOK_DISABLED` first plus falls back to `SPECKIT_SKILL_ADVISOR_HOOK_DISABLED`. Migration does not change this contract.\n.skilled/skills/system-skill-advisor/runtime/stress-test/skill-advisor/python-compat-stress.vitest.ts:95:        SPECKIT_SKILL_ADVISOR_HOOK_DISABLED: '1',\n.skilled/skills/system-skill-advisor/runtime/stress-test/skill-advisor/python-compat-stress.vitest.ts:104:        SPECKIT_SKILL_ADVISOR_HOOK_DISABLED: '1',\n.skilled/skills/system-skill-advisor/runtime/stress-test/skill-advisor/python-compat-stress.vitest.ts:113:      reason: 'ADVISOR_DISABLED',\n.skilled/skills/system-skill-advisor/runtime/stress-test/skill-advisor/opencode-plugin-bridge-stress.vitest.ts:82:      'SPECKIT_SKILL_ADVISOR_HOOK_DISABLED',\n.skilled/skills/system-skill-advisor/runtime/stress-test/skill-advisor/opencode-plugin-bridge-stress.vitest.ts:87:    delete process.env.SPECKIT_SKILL_ADVISOR_HOOK_DISABLED;\n.skilled/skills/system-skill-advisor/runtime/dist/runtime/skill-advisor-cli.js:16:import { disabledRecommendOutput } from './lib/advisor-disabled.js';\n.skilled/skills/system-skill-advisor/runtime/dist/runtime/skill-advisor-cli.js:1375:    const disabled = disabledRecommendOutput(args);\n.skilled/skills/system-skill-advisor/runtime/dist/runtime/lib/advisor-disabled.js:44:export const ADVISOR_DISABLED_FLAGS = hookFlags === null\n.skilled/skills/system-skill-advisor/runtime/dist/runtime/lib/advisor-disabled.js:54:export function advisorDisabledBy(env = process.env, config) {\n.skilled/skills/system-skill-advisor/runtime/dist/runtime/lib/advisor-disabled.js:106:export function disabledRecommendOutput(input, env = process.env, config) {\n.skilled/skills/system-skill-advisor/runtime/dist/runtime/lib/advisor-disabled.js:107:    const disabledBy = advisorDisabledBy(env, config);\n.skilled/skills/system-skill-advisor/runtime/dist/runtime/lib/advisor-disabled.js:126:        trustState: unavailableTrustState('ADVISOR_DISABLED'),\n.skilled/skills/system-skill-advisor/runtime/dist/runtime/lib/advisor-disabled.js:127:        warnings: ['ADVISOR_DISABLED'],\n.skilled/skills/system-skill-advisor/runtime/dist/runtime/lib/compat/daemon-probe.js:26:    if (process.env.SPECKIT_SKILL_ADVISOR_HOOK_DISABLED === '1') {\n.skilled/skills/system-skill-advisor/runtime/dist/runtime/lib/compat/daemon-probe.js:27:        return unavailable('ADVISOR_DISABLED');\n.skilled/skills/system-skill-advisor/runtime/dist/runtime/lib/compat/contract.js:6:    disabledEnv: 'SPECKIT_SKILL_ADVISOR_HOOK_DISABLED',\n.skilled/skills/system-skill-advisor/runtime/dist/runtime/handlers/advisor-recommend.js:10:import { disabledRecommendOutput, emptyOutput, requestWorkspaceRoot } from '../lib/advisor-disabled.js';\n.skilled/skills/system-skill-advisor/runtime/dist/runtime/handlers/advisor-recommend.js:542:    const data = disabledRecommendOutput(input, process.env, {}) ?? await computeRecommendationOutput(input);\n.skilled/skills/system-skill-advisor/runtime/dist/hooks/claude/user-prompt-submit.js:188:        if (!skillAdvisorHookEnabled() || process.env.SPECKIT_SKILL_ADVISOR_HOOK_DISABLED === '1') {\n.skilled/skills/system-skill-advisor/runtime/tests/skill-advisor-cli-test-utils.ts:10:import { ADVISOR_DISABLED_FLAGS } from '../lib/advisor-disabled.js';\n.skilled/skills/system-skill-advisor/runtime/tests/skil