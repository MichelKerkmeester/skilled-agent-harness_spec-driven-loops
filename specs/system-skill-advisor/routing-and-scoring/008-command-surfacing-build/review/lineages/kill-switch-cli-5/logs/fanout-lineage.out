.dumps({\n                \"error\": \"Native advisor unavailable\",\n                \"reason\": \"ADVISOR_DISABLED\",\n                \"freshness\": \"native-unavailable\",\n            }, indent=2))\n            return 2\n        print(json.dumps([]))\n        return 0\n\n    should_try_native = not args.force_local\n\n    if should_try_native:\n        probe = probe_native_advisor()\n        if probe.get(\"available\"):\n            native_results = recommend_with_native_advisor(\n                args.prompt,\n                confidence_threshold=args.threshold,\n                uncertainty_threshold=args.uncertainty,\n                confidence_only=args.confidence_only,\n            )\n            if native_results is not None:\n                print(json.dumps(native_results, indent=2))\n                return 0\n        elif args.force_native:\n            print(json.dumps({\n                \"error\": \"Native advisor unavailable\",\n                \"reason\": probe.get(\"reason\", \"UNKNOWN\"),\n                \"freshness\": probe.get(\"freshness\", \"unavailable\"),\n            }, indent=2))\n            return 2\n        else:\n            _warn_native_fallback(probe)\n\n    if args.force_native:\n        # Every force-native unavailable envelope carries freshness, so a caller can read\n        # one field on every branch instead of discovering that this one path omits it.\n        print(json.dumps({\n            \"error\": \"Native advisor unavailable\",\n=== grep DISABLE_ADVISOR_ENV uses ===\n46:DISABLE_ADVISOR_ENV = \"SPECKIT_SKILL_ADVISOR_HOOK_DISABLED\"\n210:DISABLE_ADVISOR_ENV = COMPAT_CONTRACT[\"disabledEnv\"]\n5491:    if os.environ.get(DISABLE_ADVISOR_ENV) == \"1\":\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"cd /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research && sed -n 5470,5530p .skilled/skills/system-skill-advisor/runtime/scripts/skill_advisor.py && echo \\\