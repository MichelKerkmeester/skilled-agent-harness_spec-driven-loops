Class: 'cross-consumer',\\n    case: 'An operator with MK_HOOKS_DISABLED=1 exported reads the table, believes the name is inert, and expects hooks to run; the resolver disables every concern and names SYSTEM_HOOKS_DISABLED in the reason.',\\n    scopeProof: 'rg -n \\\"MASTER_ALIASES|MK_HOOKS_DISABLED\\\" .skilled/hooks finds the constant, the master loop and the env bridge; the same alias-column drift is in ENV-REFERENCE.md:75 and .skilled/hooks/README.md:44.',\\n    affectedSurfaceHints: ['ENV-REFERENCE hook kill-switches table', 'hooks README concern table', 'hook-flags resolver MASTER_ALIASES/LEGACY_ALIASES'],\\n    evidenceRefs: ['.skilled/skills/system-spec-kit/runtime/ENV-REFERENCE.md:74', '.skilled/hooks/shared/hook-flags.cjs:38-41', '.skilled/hooks/shared/hook-flags.cjs:256-258', '.skilled/hooks/shared/env-aliases.cjs:20-33']\\n  },\\n  {\\n    id: 'iter2-P2-env-source-column',\\n    severity: 'P2',\\n    title: 'The advisor switch row Source column omits the direct-call readers it claims',\\n    file: '.skilled/skills/system-spec-kit/runtime/ENV-REFERENCE.md:75',\\n    dimension: 'traceability',\\n    findingClass: 'cross-consumer',\\n    case: 'A maintainer who changes where the direct call reads the switch greps the two listed sources, edits the hook and the plugin, and leaves the CLI and daemon readers on the old behavior.',\\n    scopeProof: 'rg -n \\\"disabledRecommendOutput|advisorDisabledBy\\\" .skilled/skills/system-skill-advisor/runtime finds exactly the CLI and daemon readers plus the shared builder; none is named in the row Source column.',\\n    affectedSurfaceHints: ['ENV-REFERENCE hook kill-switches table', 'runtime/lib/advisor-disabled.ts', 'runtime/skill-advisor-cli.ts', 'runtime/handlers/advisor-recommend.ts'],\\n    evidenceRefs: ['.skilled/skills/system-spec-kit/runtime/ENV-REFERENCE.md:71', '.skilled/skills/system-spec-kit/runtime/ENV-REFERENCE.md:75', '.skilled/skills/system-skill-advisor/runtime/lib/advisor-disabled.ts:70-93', '.skille