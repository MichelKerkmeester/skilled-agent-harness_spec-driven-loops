{"type":"tool_use","timestamp":1794760759855,"sessionID":"ses_e1feefdd5ffeS4J0KdMtC6TlEK","part":{"partID":"prt_1e013d6a0002veP7F2BRgfqMsv","sessionID":"ses_e1feefdd5ffeS4J0KdMtC6TlEK","messageID":"msg_1e013bc310014y0qZUWqMwxURL","type":"tool","id":"call_c74bd646c9644edebd3e6b6a","tool":"read","state":{"status":"completed","input":{"path":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/tests/advisor-disabled.vitest.ts"},"output":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/tests/advisor-disabled.vitest.ts, lines 1-115\n1: // ───────────────────────────────────────────────────────────────\n2: // MODULE: Advisor Disabled Switch Tests\n3: // ───────────────────────────────────────────────────────────────\n4: \n5: // The switch is read by two callers in two processes, the daemon handler and the\n6: // CLI client, so the resolution it borrows from the hooks and the envelope it builds are pinned here\n7: // once rather than twice through each caller.\n8: \n9: import { mkdtempSync, realpathSync, rmSync, writeFileSync } from 'node:fs';\n10: import { tmpdir } from 'node:os';\n11: import { join } from 'node:path';\n12: \n13: import { afterAll, describe, expect, it } from 'vitest';\n14: \n15: import { ADVISOR_DISABLED_FLAGS, advisorDisabledBy, disabledRecommendOutput } from '../lib/advisor-disabled.js';\n16: import { resolvedUncertaintyThreshold } from '../lib/compat/contract.js';\n17: \n18: describe('advisorDisabledBy', () => {\n19:   it('returns null when no switch is set', () => {\n20:     expect(advisorDisabledBy({}, {})).toBeNull();\n21:   });\n22: \n23:   it.each([\n24:     ['SYSTEM_SKILL_ADVISOR_HOOK_DISABLED'],\n25:     ['SPECKIT_SKILL_ADVISOR_HOOK_DISABLED'],\n26:   ])('names %s when it is set to 1', (flag) => {\n27:     expect(advisorDisabledBy({ [flag]: '1' }, {})).toBe(flag);\n28:   });\n29: \n30:   it('names the canonical switch when both are set', () => {\n31:     expect(advisorDisabledBy({\n32:       SYSTEM_SKILL_ADVISOR_HOOK_DISABLED: '1',\n33:       SPECKIT_SKILL_ADVISOR_HOOK_DISABLED: '1',\n34:     }, {})).toBe('SYSTEM_SKILL_ADVISOR_HOOK_DISABLED');\n35:   });\n36: \n37:   it.each([\n38:     [{ SYSTEM_SKILL_ADVISOR_HOOK_DISABLED: '0' }],\n39:     [{ SYSTEM_SKILL_ADVISOR_DISABLED: '' }],\n40:   ])('ignores %o, as the hooks do', (env) => {\n41:     expect(advisorDisabledBy(env, {})).toBeNull();\n42:   });\n43: \n44:   it.each([\n45:     [{ SYSTEM_SKILL_ADVISOR_HOOK_DISABLED: 'true' }, 'SYSTEM_SKILL_ADVISOR_HOOK_DISABLED'],\n46:     [{ SYSTEM_SKILL_ADVISOR_DISABLED: '1' }, 'SYSTEM_SKILL_ADVISOR_DISABLED'],\n47:     [{ SYSTEM_SKILL_ADVISOR_DISABLED: 'ON' }, 'SYSTEM_SKILL_ADVISOR_DISABLED'],\n48:     [{ SYSTEM_HOOKS_DISABLED: '1' }, 'SYSTEM_HOOKS_DISABLED'],\n49:   ])('names the switch for %o, as the hooks do', (env, flag) => {\n50:     expect(advisorDisabledBy(env, {})).toBe(flag);\n51:   });\n52: \n53:   it('takes its names from the hooks resolver', () => {\n54:     expect(ADVISOR_DISABLED_FLAGS).toEqual(expect.arrayContaining([\n55:       'SYSTEM_HOOKS_DISABLED',\n56:       'SYSTEM_SKILL_ADVISOR_DISABLED',\n57:       'SYSTEM_SKILL_ADVISOR_HOOK_DISABLED',\n58:       'SPECKIT_SKILL_ADVISOR_HOOK_DISABLED',\n59:     ]));\n60:   });\n61: });\n62: \n63: describe('advisorDisabledBy with a flags file', () => {\n64:   const folder = mkdtempSync(join(tmpdir(), 'adv-flags-'));\n65:   const flagsFile = join(folder, 'hook-flags.env');\n66:   writeFileSync(flagsFile, 'SYSTEM_SKILL_ADVISOR_DISABLED=1\\n');\n67: \n68:   afterAll(() => {\n69:     rmSync(folder, { recursive: true, force: true });\n70:   });\n71: \n72:   it('reads the file when the environment names no config', () => {\n73:     expect(advisorDisabledBy({ HOOK_FLAGS_CONFIG: flagsFile })).toBe('SYSTEM_SKILL_ADVISOR_DISABLED');\n74:   });\n75: \n76:   it('lets an environment value of 0 win over the file', () => {\n77:     expect(advisorDisabledBy({ HOOK_FLAGS_CONFIG: flagsFile, SYSTEM_SKILL_ADVISOR_DISABLED: '0' })).toBeNull();\n78:   });\n79: \n80:   it('reads no file when the caller passes an explicit config', () => {\n81:     expect(advisorDisabledBy({ HOOK_FLAGS_CONFIG: flagsFile }, {})).toBeNull();\n82:   });\n83: });\n84: \n85: describe('disabledRecommendOutput', () => {\n86:   it('returns null when no switch is set', () => {\n87:     expect(disabledRecommendOutput({ prompt: 'x' }, {}, {})).toBeNull();\n88:   });\n89: \n90:   it('builds the empty envelope that names the switch', () => {\n91:     const workspaceRoot = mkdtempSync(join(tmpdir(), 'adv-off-'));\n92:     try {\n93:       const output = disabledRecommendOutput(\n94:         { prompt: 'x', workspaceRoot, options: { confidenceThreshold: 0.7 } },\n95:         { SPECKIT_SKILL_ADVISOR_HOOK_DISABLED: '1' },\n96:         {},\n97:       );\n98:       expect(output).toMatchObject({\n99:         workspaceRoot: realpathSync.native(workspaceRoot),\n100:         recommendations: [],\n101:         freshness: 'unavailable',\n102:         warnings: ['ADVISOR_DISABLED'],\n103:         abstainReasons: ['Skill advisor disabled by SPECKIT_SKILL_ADVISOR_HOOK_DISABLED.'],\n104:         effectiveThresholds: {\n105:           confidenceThreshold: 0.7,\n106:           uncertaintyThreshold: resolvedUncertaintyThreshold(),\n107:           confidenceOnly: false,\n108:         },\n109:         trustState: { state: 'unavailable', reason: 'ADVISOR_DISABLED' },\n110:       });\n111:     } finally {\n112:       rmSync(workspaceRoot, { recursive: true, force: true });\n113:     }\n114:   });\n115: });","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/tests/advisor-disabled.vitest.ts, lines 1-115\n1: // ───────────────────────────────────────────────────────────────\n2: // MODULE: Advisor Disabled Switch Tests\n3: // ───────────────────────────────────────────────────────────────\n4: \n5: // The switch is read by two callers in two processes, the daemon handler and the\n6: // CLI client, so the resolution it borrows from the hooks and the envelope it builds are pinned here\n7: // once rather than twice through each caller.\n8: \n9: import { mkdtempSync, realpathSync, rmSync, writeFileSync } from 'node:fs';\n10: import { tmpdir } from 'node:os';\n11: import { join } from 'node:path';\n12: \n13: import { afterAll, describe, expect, it } from 'vitest';\n14: \n15: import { ADVISOR_DISABLED_FLAGS, advisorDisabledBy, disabledRecommendOutput } from '../lib/advisor-disabled.js';\n16: import { resolvedUncertaintyThreshold } from '../lib/compat/contract.js';\n17: \n18: describe('advisorDisabledBy', () => {\n19:   it('returns null when no switch is set', () => {\n20:     expect(advisorDisabledBy({}, {})).toBeNull();\n21:   });\n22: \n23:   it.each([\n24:     ['SYSTEM_SKILL_ADVISOR_HOOK_DISABLED'],\n25:     ['SPECKIT_SKILL_ADVISOR_HOOK_DISABLED'],\n26:   ])('names %s when it is set to 1', (flag) => {\n27:     expect(advisorDisabledBy({ [flag]: '1' }, {})).toBe(flag);\n28:   });\n29: \n30:   it('names the canonical switch when both are set', () => {\n31:     expect(advisorDisabledBy({\n32:       SYSTEM_SKILL_ADVISOR_HOOK_DISABLED: '1',\n33:       SPECKIT_SKILL_ADVISOR_HOOK_DISABLED: '1',\n34:     }, {})).toBe('SYSTEM_SKILL_ADVISOR_HOOK_DISABLED');\n35:   });\n36: \n37:   it.each([\n38:     [{ SYSTEM_SKILL_ADVISOR_HOOK_DISABLED: '0' }],\n39:     [{ SYSTEM_SKILL_ADVISOR_DISABLED: '' }],\n40:   ])('ignores %o, as the hooks do', (env) => {\n41:     expect(advisorDisabledBy(env, {})).toBeNull();\n42:   });\n43: \n44:   it.each([\n45:     [{ SYSTEM_SKILL_ADVISOR_HOOK_DISABLED: 'true' }, 'SYSTEM_SKILL_ADVISOR_HOOK_DISABLED'],\n46:     [{ SYSTEM_SKILL_ADVISOR_DISABLED: '1' }, 'SYSTEM_SKILL_ADVISOR_DISABLED'],\n47:     [{ SYSTEM_SKILL_ADVISOR_DISABLED: 'ON' }, 'SYSTEM_SKILL_ADVISOR_DISABLED'],\n48:     [{ SYSTEM_HOOKS_DISABLED: '1' }, 'SYSTEM_HOOKS_DISABLED'],\n49:   ])('names the switch for %o, as the hooks do', (env, flag) => {\n50:     expect(advisorDisabledBy(env, {})).toBe(flag);\n51:   });\n52: \n53:   it('takes its names from the hooks resolver', () => {\n54:     expect(ADVISOR_DISABLED_FLAGS).toEqual(expect.arrayContaining([\n55:       'SYSTEM_HOOKS_DISABLED',\n56:       'SYSTEM_SKILL_ADVISOR_DISABLED',\n57:       'SYSTEM_SKILL_ADVISOR_HOOK_DISABLED',\n58:       'SPECKIT_SKILL_ADVISOR_HOOK_DISABLED',\n59:     ]));\n60:   });\n61: });\n62: \n63: describe('advisorDisabledBy with a flags file', () => {\n64:   const folder = mkdtempSync(join(tmpdir(), 'adv-flags-'));\n65:   const flagsFile = join(folder, 'hook-flags.env');\n66:   writeFileSync(flagsFile, 'SYSTEM_SKILL_ADVISOR_DISABLED=1\\n');\n67: \n68:   afterAll(() => {\n69:     rmSync(folder, { recursive: true, force: true });\n70:   });\n71: \n72:   it('reads the file when the environment names no config', () => {\n73:     expect(advisorDisabledBy({ HOOK_FLAGS_CONFIG: flagsFile })).toBe('SYSTEM_SKILL_ADVISOR_DISABLED');\n74:   });\n75: \n76:   it('lets an environment value of 0 win over the file', () => {\n77:     expect(advisorDisabledBy({ HOOK_FLAGS_CONFIG: flagsFile, SYSTEM_SKILL_ADVISOR_DISABLED: '0' })).toBeNull();\n78:   });\n79: \n80:   it('reads no file when the caller passes an explicit config', () => {\n81:     expect(advisorDisabledBy({ HOOK_FLAGS_CONFIG: flagsFile }, {})).toBeNull();\n82:   });\n83: });\n84: \n85: describe('disabledRecommendOutput', () => {\n86:   it('returns null when no switch is set', () => {\n87:     expect(disabledRecommendOutput({ prompt: 'x' }, {}, {})).toBeNull();\n88:   });\n89: \n90:   it('builds the empty envelope that names the switch', () => {\n91:     const workspaceRoot = mkdtempSync(join(tmpdir(), 'adv-off-'));\n92:     try {\n93:       const output = disabledRecommendOutput(\n94:         { prompt: 'x', workspaceRoot, options: { confidenceThreshold: 0.7 } },\n95:         { SPECKIT_SKILL_ADVISOR_HOOK_DISABLED: '1' },\n96:         {},\n97:       );\n98:       expect(output).toMatchObject({\n99:         workspaceRoot: realpathSync.native(workspaceRoot),\n100:         recommendations: [],\n101:         freshness: 'unavailable',\n102:         warnings: ['ADVISOR_DISABLED'],\n103:         abstainReasons: ['Skill advisor disabled by SPECKIT_SKILL_ADVISOR_HOOK_DISABLED.'],\n104:         effectiveThresholds: {\n105:           confidenceThreshold: 0.7,\n106:           uncertaintyThreshold: resolvedUncertaintyThreshold(),\n107:           confidenceOnly: false,\n108:         },\n109:         trustState: { state: 'unavailable', reason: 'ADVISOR_DISABLED' },\n110:       });\n111:     } finally {\n112:       rmSync(workspaceRoot, { recursive: true, force: true });\n113:     }\n114:   });\n115: });"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/tests/advisor-disabled.vitest.ts\"}"},"time":{"start":1794760758944,"end":1794760759855}}}}
{"type":"tool_use","timestamp":1794760759876,"sessionID":"ses_e1feefdd5ffeS4J0KdMtC6TlEK","part":{"partID":"prt_1e013d8570019tultS22msVzc5","sessionID":"ses_e1feefdd5ffeS4J0KdMtC6TlEK","messageID":"msg_1e013bc310014y0qZUWqMwxURL","type":"tool","id":"call_aee3071c3ecc478ea4795fea","tool":"shell","state":{"status":"completed","input":{"command":"cd /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research && sed -n 120,330p .skilled/skills/system-skill-advisor/runtime/tests/skill-advisor-cli-stale-daemon-retry.vitest.ts"},"output":"  servers.push(server);\n  return { calls };\n}\n\nasync function runRecommend(scope: IsolatedCliScope, env: NodeJS.ProcessEnv = scope.env) {\n  const originalEnv = { ...process.env };\n  const stdout: string[] = [];\n  const stderr: string[] = [];\n  for (const key of Object.keys(process.env)) delete process.env[key];\n  Object.assign(process.env, env);\n  let exitCode: number;\n  try {\n    exitCode = await runSkillAdvisorCli([\n      'advisor_recommend',\n      '--json',\n      JSON.stringify({ prompt: 'Recommend a skill.', options: { includeCompiledRoute: false, compiledRouteTopOnly: true } }),\n      '--format',\n      'json',\n      '--timeout-ms',\n      '1000',\n    ], {\n      stdout: { write: (value: string) => { stdout.push(value); return true; } },\n      stderr: { write: (value: string) => { stderr.push(value); return true; } },\n    });\n  } finally {\n    for (const key of Object.keys(process.env)) delete process.env[key];\n    Object.assign(process.env, originalEnv);\n  }\n  return { exitCode, stdout: stdout.join(''), stderr: stderr.join('') };\n}\n\nfunction switchEnv(scope: IsolatedCliScope, flag?: string): NodeJS.ProcessEnv {\n  const env = { ...scope.env };\n  for (const name of ADVISOR_DISABLED_FLAGS) delete env[name];\n  if (flag) env[flag] = '1';\n  return env;\n}\n\nfunction flagsFile(scope: IsolatedCliScope): string {\n  const filePath = join(scope.rootDir, 'hook-flags.env');\n  writeFileSync(filePath, 'SYSTEM_SKILL_ADVISOR_DISABLED=1\\n');\n  return filePath;\n}\n\nasync function cleanup(): Promise<void> {\n  while (sockets.length > 0) {\n    sockets.pop()?.destroy();\n  }\n  while (servers.length > 0) {\n    const server = servers.pop();\n    if (!server) continue;\n    await new Promise<void>((resolve) => server.close(() => resolve()));\n  }\n  while (scopes.length > 0) {\n    const scope = scopes.pop();\n    if (scope) await cleanupSkillAdvisorScope(scope);\n  }\n}\n\nafterEach(async () => {\n  await cleanup();\n});\n\ndescribe('skill-advisor CLI stale-daemon retry', () => {\n  it('retries once without includeCompiledRoute when a stale daemon rejects that option', async () => {\n    const scope = createIsolatedCliScope('stale-daemon-retry');\n    scopes.push(scope);\n    const daemon = await startFakeAdvisorDaemon(scope.socketPath, 'reject-compiled-route-option');\n\n    const run = await runRecommend(scope);\n    const payload = parseJsonOutput<CliPayload>(run);\n\n    expect(run.exitCode, run.stderr).toBe(0);\n    expect(payload.status).toBe('ok');\n    expect(payload.data?.recommendations?.[0]?.skillId).toBe('sk-code');\n    expect(daemon.calls).toHaveLength(2);\n    expect((daemon.calls[0]?.options as Record<string, unknown>)?.includeCompiledRoute).toBe(false);\n    expect(Object.prototype.hasOwnProperty.call(daemon.calls[1]?.options ?? {}, 'includeCompiledRoute')).toBe(false);\n    // A daemon that old knows neither option, so the retry carries neither.\n    expect(Object.prototype.hasOwnProperty.call(daemon.calls[1]?.options ?? {}, 'compiledRouteTopOnly')).toBe(false);\n  });\n\n  it('does not retry unrelated invalid-parameter errors', async () => {\n    const scope = createIsolatedCliScope('unrelated-invalid-parameter');\n    scopes.push(scope);\n    const daemon = await startFakeAdvisorDaemon(scope.socketPath, 'reject-unrelated-option');\n\n    const run = await runRecommend(scope);\n    const payload = parseJsonOutput<CliPayload>(run);\n\n    expect(run.exitCode, run.stderr).toBe(64);\n    expect(payload.status).toBe('error');\n    expect(payload.exitCode).toBe(64);\n    expect(payload.error).toContain('unsupportedOption');\n    expect(daemon.calls).toHaveLength(1);\n  });\n});\n\ndescribe('skill-advisor CLI disable switch', () => {\n  // The resolver copies an MK_ value onto its new name when it loads, so the\n  // reason an MK_ name gets depends on load order. The loop leaves those out.\n  it.each(ADVISOR_DISABLED_FLAGS.filter((flag) => !flag.startsWith('MK_')).map((flag) => [flag]))('abstains under %s before it asks a warm daemon', async (flag) => {\n    const scope = createIsolatedCliScope('disable-switch-warm');\n    scopes.push(scope);\n    const daemon = await startFakeAdvisorDaemon(scope.socketPath, 'answer');\n\n    const run = await runRecommend(scope, switchEnv(scope, flag));\n    const payload = parseJsonOutput<CliPayload>(run);\n\n    expect(run.exitCode, run.stderr).toBe(0);\n    expect(payload.status).toBe('ok');\n    expect(payload.data?.recommendations).toEqual([]);\n    expect(payload.data?.abstainReasons).toEqual([`Skill advisor disabled by ${flag}.`]);\n    expect(payload.data?.warnings).toEqual(['ADVISOR_DISABLED']);\n    expect(payload.data?.freshness).toBe('unavailable');\n    expect(daemon.calls).toHaveLength(0);\n  });\n\n  it('still asks a warm daemon when no switch is set', async () => {\n    const scope = createIsolatedCliScope('disable-switch-control');\n    scopes.push(scope);\n    const daemon = await startFakeAdvisorDaemon(scope.socketPath, 'answer');\n\n    const run = await runRecommend(scope, switchEnv(scope));\n    const payload = parseJsonOutput<CliPayload>(run);\n\n    expect(run.exitCode, run.stderr).toBe(0);\n    expect(payload.data?.recommendations?.[0]?.skillId).toBe('sk-code');\n    expect(daemon.calls).toHaveLength(1);\n  });\n\n  it('abstains with no daemon and starts no launcher', async () => {\n    const scope = createIsolatedCliScope('disable-switch-no-daemon');\n    scopes.push(scope);\n\n    const run = await runRecommend(scope, switchEnv(scope, 'SYSTEM_SKILL_ADVISOR_HOOK_DISABLED'));\n    const payload = parseJsonOutput<CliPayload>(run);\n\n    expect(run.exitCode, run.stderr).toBe(0);\n    expect(payload.data?.recommendations).toEqual([]);\n    expect(payload.data?.abstainReasons).toEqual(['Skill advisor disabled by SYSTEM_SKILL_ADVISOR_HOOK_DISABLED.']);\n    expect(readSkillAdvisorLauncherPid(scope.skillAdvisorDbDir)).toBeNull();\n    expect(existsSync(scope.socketPath)).toBe(false);\n  }, 30_000);\n});\n\ndescribe('skill-advisor CLI kill switch, as the hooks resolve it', () => {\n  it.each([\n    ['SYSTEM_SKILL_ADVISOR_DISABLED', '1'],\n    ['SYSTEM_SKILL_ADVISOR_DISABLED', 'true'],\n    ['SYSTEM_SKILL_ADVISOR_HOOK_DISABLED', 'yes'],\n    ['SYSTEM_HOOKS_DISABLED', '1'],\n  ])('abstains under %s=%s before it asks a warm daemon', async (name, value) => {\n    const scope = createIsolatedCliScope('kill-switch-name');\n    scopes.push(scope);\n    const daemon = await startFakeAdvisorDaemon(scope.socketPath, 'answer');\n\n    const run = await runRecommend(scope, { ...switchEnv(scope), [name]: value });\n    const payload = parseJsonOutput<CliPayload>(run);\n\n    expect(run.exitCode, run.stderr).toBe(0);\n    expect(payload.status).toBe('ok');\n    expect(payload.data?.recommendations).toEqual([]);\n    expect(payload.data?.abstainReasons).toEqual([`Skill advisor disabled by ${name}.`]);\n    expect(payload.data?.warnings).toEqual(['ADVISOR_DISABLED']);\n    expect(daemon.calls).toHaveLength(0);\n  });\n\n  it('abstains under a flags-file entry before it asks a warm daemon', async () => {\n    const scope = createIsolatedCliScope('kill-switch-flags-file');\n    scopes.push(scope);\n    const daemon = await startFakeAdvisorDaemon(scope.socketPath, 'answer');\n\n    const run = await runRecommend(scope, { ...switchEnv(scope), HOOK_FLAGS_CONFIG: flagsFile(scope) });\n    const payload = parseJsonOutput<CliPayload>(run);\n\n    expect(run.exitCode, run.stderr).toBe(0);\n    expect(payload.data?.recommendations).toEqual([]);\n    expect(payload.data?.abstainReasons).toEqual(['Skill advisor disabled by SYSTEM_SKILL_ADVISOR_DISABLED.']);\n    expect(daemon.calls).toHaveLength(0);\n  });\n\n  it('still asks a warm daemon when the environment sets the switch to 0 over the file', async () => {\n    const scope = createIsolatedCliScope('kill-switch-file-override');\n    scopes.push(scope);\n    const daemon = await startFakeAdvisorDaemon(scope.socketPath, 'answer');\n\n    const run = await runRecommend(scope, {\n      ...switchEnv(scope),\n      HOOK_FLAGS_CONFIG: flagsFile(scope),\n      SYSTEM_SKILL_ADVISOR_DISABLED: '0',\n    });\n    const payload = parseJsonOutput<CliPayload>(run);\n\n    expect(run.exitCode, run.stderr).toBe(0);\n    expect(payload.data?.recommendations?.[0]?.skillId).toBe('sk-code');\n    expect(daemon.calls).toHaveLength(1);\n  });\n});\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"  servers.push(server);\n  return { calls };\n}\n\nasync function runRecommend(scope: IsolatedCliScope, env: NodeJS.ProcessEnv = scope.env) {\n  const originalEnv = { ...process.env };\n  const stdout: string[] = [];\n  const stderr: string[] = [];\n  for (const key of Object.keys(process.env)) delete process.env[key];\n  Object.assign(process.env, env);\n  let exitCode: number;\n  try {\n    exitCode = await runSkillAdvisorCli([\n      'advisor_recommend',\n      '--json',\n      JSON.stringify({ prompt: 'Recommend a skill.', options: { includeCompiledRoute: false, compiledRouteTopOnly: true } }),\n      '--format',\n      'json',\n      '--timeout-ms',\n      '1000',\n    ], {\n      stdout: { write: (value: string) => { stdout.push(value); return true; } },\n      stderr: { write: (value: string) => { stderr.push(value); return true; } },\n    });\n  } finally {\n    for (const key of Object.keys(process.env)) delete process.env[key];\n    Object.assign(process.env, originalEnv);\n  }\n  return { exitCode, stdout: stdout.join(''), stderr: stderr.join('') };\n}\n\nfunction switchEnv(scope: IsolatedCliScope, flag?: string): NodeJS.ProcessEnv {\n  const env = { ...scope.env };\n  for (const name of ADVISOR_DISABLED_FLAGS) delete env[name];\n  if (flag) env[flag] = '1';\n  return env;\n}\n\nfunction flagsFile(scope: IsolatedCliScope): string {\n  const filePath = join(scope.rootDir, 'hook-flags.env');\n  writeFileSync(filePath, 'SYSTEM_SKILL_ADVISOR_DISABLED=1\\n');\n  return filePath;\n}\n\nasync function cleanup(): Promise<void> {\n  while (sockets.length > 0) {\n    sockets.pop()?.destroy();\n  }\n  while (servers.length > 0) {\n    const server = servers.pop();\n    if (!server) continue;\n    await new Promise<void>((resolve) => server.close(() => resolve()));\n  }\n  while (scopes.length > 0) {\n    const scope = scopes.pop();\n    if (scope) await cleanupSkillAdvisorScope(scope);\n  }\n}\n\nafterEach(async () => {\n  await cleanup();\n});\n\ndescribe('skill-advisor CLI stale-daemon retry', () => {\n  it('retries once without includeCompiledRoute when a stale daemon rejects that option', async () => {\n    const scope = createIsolatedCliScope('stale-daemon-retry');\n    scopes.push(scope);\n    const daemon = await startFakeAdvisorDaemon(scope.socketPath, 'reject-compiled-route-option');\n\n    const run = await runRecommend(scope);\n    const payload = parseJsonOutput<CliPayload>(run);\n\n    expect(run.exitCode, run.stderr).toBe(0);\n    expect(payload.status).toBe('ok');\n    expect(payload.data?.recommendations?.[0]?.skillId).toBe('sk-code');\n    expect(daemon.calls).toHaveLength(2);\n    expect((daemon.calls[0]?.options as Record<string, unknown>)?.includeCompiledRoute).toBe(false);\n    expect(Object.prototype.hasOwnProperty.call(daemon.calls[1]?.options ?? {}, 'includeCompiledRoute')).toBe(false);\n    // A daemon that old knows neither option, so the retry carries neither.\n    expect(Object.prototype.hasOwnProperty.call(daemon.calls[1]?.options ?? {}, 'compiledRouteTopOnly')).toBe(false);\n  });\n\n  it('does not retry unrelated invalid-parameter errors', async () => {\n    const scope = createIsolatedCliScope('unrelated-invalid-parameter');\n    scopes.push(scope);\n    const daemon = await startFakeAdvisorDaemon(scope.socketPath, 'reject-unrelated-option');\n\n    const run = await runRecommend(scope);\n    const payload = parseJsonOutput<CliPayload>(run);\n\n    expect(run.exitCode, run.stderr).toBe(64);\n    expect(payload.status).toBe('error');\n    expect(payload.exitCode).toBe(64);\n    expect(payload.error).toContain('unsupportedOption');\n    expect(daemon.calls).toHaveLength(1);\n  });\n});\n\ndescribe('skill-advisor CLI disable switch', () => {\n  // The resolver copies an MK_ value onto its new name when it loads, so the\n  // reason an MK_ name gets depends on load order. The loop leaves those out.\n  it.each(ADVISOR_DISABLED_FLAGS.filter((flag) => !flag.startsWith('MK_')).map((flag) => [flag]))('abstains under %s before it asks a warm daemon', async (flag) => {\n    const scope = createIsolatedCliScope('disable-switch-warm');\n    scopes.push(scope);\n    const daemon = await startFakeAdvisorDaemon(scope.socketPath, 'answer');\n\n    const run = await runRecommend(scope, switchEnv(scope, flag));\n    const payload = parseJsonOutput<CliPayload>(run);\n\n    expect(run.exitCode, run.stderr).toBe(0);\n    expect(payload.status).toBe('ok');\n    expect(payload.data?.recommendations).toEqual([]);\n    expect(payload.data?.abstainReasons).toEqual([`Skill advisor disabled by ${flag}.`]);\n    expect(payload.data?.warnings).toEqual(['ADVISOR_DISABLED']);\n    expect(payload.data?.freshness).toBe('unavailable');\n    expect(daemon.calls).toHaveLength(0);\n  });\n\n  it('still asks a warm daemon when no switch is set', async () => {\n    const scope = createIsolatedCliScope('disable-switch-control');\n    scopes.push(scope);\n    const daemon = await startFakeAdvisorDaemon(scope.socketPath, 'answer');\n\n    const run = await runRecommend(scope, switchEnv(scope));\n    const payload = parseJsonOutput<CliPayload>(run);\n\n    expect(run.exitCode, run.stderr).toBe(0);\n    expect(payload.data?.recommendations?.[0]?.skillId).toBe('sk-code');\n    expect(daemon.calls).toHaveLength(1);\n  });\n\n  it('abstains with no daemon and starts no launcher', async () => {\n    const scope = createIsolatedCliScope('disable-switch-no-daemon');\n    scopes.push(scope);\n\n    const run = await runRecommend(scope, switchEnv(scope, 'SYSTEM_SKILL_ADVISOR_HOOK_DISABLED'));\n    const payload = parseJsonOutput<CliPayload>(run);\n\n    expect(run.exitCode, run.stderr).toBe(0);\n    expect(payload.data?.recommendations).toEqual([]);\n    expect(payload.data?.abstainReasons).toEqual(['Skill advisor disabled by SYSTEM_SKILL_ADVISOR_HOOK_DISABLED.']);\n    expect(readSkillAdvisorLauncherPid(scope.skillAdvisorDbDir)).toBeNull();\n    expect(existsSync(scope.socketPath)).toBe(false);\n  }, 30_000);\n});\n\ndescribe('skill-advisor CLI kill switch, as the hooks resolve it', () => {\n  it.each([\n    ['SYSTEM_SKILL_ADVISOR_DISABLED', '1'],\n    ['SYSTEM_SKILL_ADVISOR_DISABLED', 'true'],\n    ['SYSTEM_SKILL_ADVISOR_HOOK_DISABLED', 'yes'],\n    ['SYSTEM_HOOKS_DISABLED', '1'],\n  ])('abstains under %s=%s before it asks a warm daemon', async (name, value) => {\n    const scope = createIsolatedCliScope('kill-switch-name');\n    scopes.push(scope);\n    const daemon = await startFakeAdvisorDaemon(scope.socketPath, 'answer');\n\n    const run = await runRecommend(scope, { ...switchEnv(scope), [name]: value });\n    const payload = parseJsonOutput<CliPayload>(run);\n\n    expect(run.exitCode, run.stderr).toBe(0);\n    expect(payload.status).toBe('ok');\n    expect(payload.data?.recommendations).toEqual([]);\n    expect(payload.data?.abstainReasons).toEqual([`Skill advisor disabled by ${name}.`]);\n    expect(payload.data?.warnings).toEqual(['ADVISOR_DISABLED']);\n    expect(daemon.calls).toHaveLength(0);\n  });\n\n  it('abstains under a flags-file entry before it asks a warm daemon', async () => {\n    const scope = createIsolatedCliScope('kill-switch-flags-file');\n    scopes.push(scope);\n    const daemon = await startFakeAdvisorDaemon(scope.socketPath, 'answer');\n\n    const run = await runRecommend(scope, { ...switchEnv(scope), HOOK_FLAGS_CONFIG: flagsFile(scope) });\n    const payload = parseJsonOutput<CliPayload>(run);\n\n    expect(run.exitCode, run.stderr).toBe(0);\n    expect(payload.data?.recommendations).toEqual([]);\n    expect(payload.data?.abstainReasons).toEqual(['Skill advisor disabled by SYSTEM_SKILL_ADVISOR_DISABLED.']);\n    expect(daemon.calls).toHaveLength(0);\n  });\n\n  it('still asks a warm daemon when the environment sets the switch to 0 over the file', async () => {\n    const scope = createIsolatedCliScope('kill-switch-file-override');\n    scopes.push(scope);\n    const daemon = await startFakeAdvisorDaemon(scope.socketPath, 'answer');\n\n    const run = await runRecommend(scope, {\n      ...switchEnv(scope),\n      HOOK_FLAGS_CONFIG: flagsFile(scope),\n      SYSTEM_SKILL_ADVISOR_DISABLED: '0',\n    });\n    const payload = parseJsonOutput<CliPayload>(run);\n\n    expect(run.exitCode, run.stderr).toBe(0);\n    expect(payload.data?.recommendations?.[0]?.skillId).toBe('sk-code');\n    expect(daemon.calls).toHaveLength(1);\n  });\n});\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"cd /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research && sed -n 120,330p .skilled/skills/system-skill-advisor/runtime/tests/skill-advisor-cli-stale-daemon-retry.vitest.ts\"}"},"time":{"start":1794760759383,"end":1794760759876}}}}
