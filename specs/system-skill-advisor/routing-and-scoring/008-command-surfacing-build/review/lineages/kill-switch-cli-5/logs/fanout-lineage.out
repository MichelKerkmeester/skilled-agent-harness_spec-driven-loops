{"type":"tool_use","timestamp":1794760657086,"sessionID":"ses_e1feefdd5ffeS4J0KdMtC6TlEK","part":{"partID":"prt_1e012458f001ds21R4HXiiQAhH","sessionID":"ses_e1feefdd5ffeS4J0KdMtC6TlEK","messageID":"msg_1e0122d99001SjNVlHJE96yP4U","type":"tool","id":"call_ffda6dbdbd1e423badd9bbbf","tool":"read","state":{"status":"completed","input":{"path":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/lib/advisor-disabled.ts"},"output":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/lib/advisor-disabled.ts, lines 1-179\n1: // ───────────────────────────────────────────────────────────────\n2: // MODULE: Advisor Disabled Switch\n3: // ───────────────────────────────────────────────────────────────\n4: // The switch belongs to whoever makes the request. The handler reads it in the\n5: // daemon and the CLI client reads it in the caller's own process before it\n6: // connects, so both build the same envelope here. The client cannot import the\n7: // handler because the handler loads the native database module and the scorer.\n8: // The rule itself is the hooks' resolver, so the direct call abstains exactly\n9: // when the prompt hooks do.\n10: \n11: // ───────────────────────────────────────────────────────────────────\n12: // 1. IMPORTS\n13: // ───────────────────────────────────────────────────────────────────\n14: \n15: import { existsSync, realpathSync } from 'node:fs';\n16: import { createRequire } from 'node:module';\n17: import { dirname, join, resolve } from 'node:path';\n18: import { fileURLToPath } from 'node:url';\n19: \n20: import {\n21:   AdvisorRecommendOutputSchema,\n22:   type AdvisorRecommendOutput,\n23: } from '../schemas/advisor-tool-schemas.js';\n24: import {\n25:   resolvedConfidenceThreshold,\n26:   resolvedUncertaintyThreshold,\n27: } from './compat/contract.js';\n28: import { findAdvisorWorkspaceRoot } from './utils/workspace-root.js';\n29: \n30: // ───────────────────────────────────────────────────────────────────\n31: // 2. HELPERS\n32: // ───────────────────────────────────────────────────────────────────\n33: \n34: type PublicThresholds = AdvisorRecommendOutput['effectiveThresholds'];\n35: \n36: interface HookFlagsResolver {\n37:   hookFlagDecision(\n38:     concern: string,\n39:     env?: NodeJS.ProcessEnv,\n40:     config?: Readonly<Record<string, string>>,\n41:   ): { enabled: boolean; key: string | null };\n42:   loadConfigFile(path: string): Record<string, string>;\n43:   configPath(): string;\n44:   concernFlag(concern: string): string | null;\n45:   MASTER_FLAG: string;\n46:   MASTER_ALIASES: readonly string[];\n47:   LEGACY_ALIASES: Readonly<Record<string, readonly string[]>>;\n48: }\n49: \n50: // The source and the built module sit at different depths below .skilled, so the\n51: // resolver is found by walking up rather than by counting parent hops. A missing\n52: // resolver answers as if no switch were set, as every adapter does.\n53: function loadHookFlags(): HookFlagsResolver | null {\n54:   let folder = dirname(fileURLToPath(import.meta.url));\n55:   while (true) {\n56:     const resolverPath = join(folder, 'hooks', 'shared', 'hook-flags.cjs');\n57:     if (existsSync(resolverPath)) {\n58:       try {\n59:         return createRequire(import.meta.url)(resolverPath) as HookFlagsResolver;\n60:       } catch {\n61:         return null;\n62:       }\n63:     }\n64:     const parent = dirname(folder);\n65:     if (parent === folder) return null;\n66:     folder = parent;\n67:   }\n68: }\n69: \n70: const hookFlags = loadHookFlags();\n71: const skillAdvisorFlag = hookFlags?.concernFlag('skill-advisor') ?? null;\n72: \n73: // Callers strip these names to isolate a scope from a switch set in the shell.\n74: export const ADVISOR_DISABLED_FLAGS: readonly string[] = hookFlags === null\n75:   ? []\n76:   : [\n77:       hookFlags.MASTER_FLAG,\n78:       ...hookFlags.MASTER_ALIASES,\n79:       ...(skillAdvisorFlag === null ? [] : [skillAdvisorFlag]),\n80:       ...(hookFlags.LEGACY_ALIASES['skill-advisor'] ?? []),\n81:     ];\n82: \n83: // Both arguments go in so an explicit environment never drops the file. The file\n84: // is read per call because each CLI call is its own process.\n85: export function advisorDisabledBy(\n86:   env: NodeJS.ProcessEnv = process.env,\n87:   config?: Readonly<Record<string, string>>,\n88: ): string | null {\n89:   if (hookFlags === null) return null;\n90:   const fileConfig = config ?? hookFlags.loadConfigFile(env.HOOK_FLAGS_CONFIG || hookFlags.configPath());\n91:   const decision = hookFlags.hookFlagDecision('skill-advisor', env, fileConfig);\n92:   return decision.enabled ? null : decision.key;\n93: }\n94: \n95: // Canonicalize a caller-supplied workspaceRoot via realpath.\n96: // The schema-level allowlist refinement runs against the same canonical\n97: // form, so a caller passing /tmp/symlink-to-repo gets the real path\n98: // post-symlink before downstream code uses it.\n99: export function requestWorkspaceRoot(workspaceRoot?: string): string {\n100:   if (!workspaceRoot) {\n101:     return findAdvisorWorkspaceRoot(process.cwd(), { maxDepth: 12 });\n102:   }\n103:   const resolved = resolve(workspaceRoot);\n104:   try {\n105:     return realpathSync.native(resolved);\n106:   } catch {\n107:     return resolved;\n108:   }\n109: }\n110: \n111: function unavailableTrustState(reason: string): AdvisorRecommendOutput['trustState'] {\n112:   return {\n113:     state: 'unavailable',\n114:     reason,\n115:     generation: 0,\n116:     checkedAt: new Date().toISOString(),\n117:     lastLiveAt: null,\n118:   };\n119: }\n120: \n121: // ───────────────────────────────────────────────────────────────────\n122: // 3. EXPORTS\n123: // ───────────────────────────────────────────────────────────────────\n124: \n125: export function emptyOutput(args: {\n126:   workspaceRoot: string;\n127:   effectiveThresholds: AdvisorRecommendOutput['effectiveThresholds'];\n128:   freshness: AdvisorRecommendOutput['freshness'];\n129:   trustState: AdvisorRecommendOutput['trustState'];\n130:   warnings?: readonly string[];\n131:   abstainReasons?: readonly string[];\n132: }): AdvisorRecommendOutput {\n133:   return AdvisorRecommendOutputSchema.parse({\n134:     workspaceRoot: args.workspaceRoot,\n135:     effectiveThresholds: args.effectiveThresholds,\n136:     recommendations: [],\n137:     ambiguous: false,\n138:     freshness: args.freshness,\n139:     trustState: args.trustState,\n140:     generatedAt: new Date().toISOString(),\n141:     cache: {\n142:       hit: false,\n143:       sourceSignaturePresent: false,\n144:     },\n145:     ...(args.warnings && args.warnings.length > 0 ? { warnings: [...args.warnings] } : {}),\n146:     ...(args.abstainReasons && args.abstainReasons.length > 0 ? { abstainReasons: [...args.abstainReasons] } : {}),\n147:   });\n148: }\n149: \n150: export function disabledRecommendOutput(\n151:   input: { readonly workspaceRoot?: unknown; readonly options?: unknown },\n152:   env: NodeJS.ProcessEnv = process.env,\n153:   config?: Readonly<Record<string, string>>,\n154: ): AdvisorRecommendOutput | null {\n155:   const disabledBy = advisorDisabledBy(env, config);\n156:   if (disabledBy === null) return null;\n157:   const options = typeof input.options === 'object' && input.options !== null\n158:     ? input.options as Record<string, unknown>\n159:     : {};\n160:   const effectiveThresholds: PublicThresholds = {\n161:     confidenceThreshold: typeof options.confidenceThreshold === 'number'\n162:       ? options.confidenceThreshold\n163:       : resolvedConfidenceThreshold(),\n164:     uncertaintyThreshold: typeof options.uncertaintyThreshold === 'number'\n165:       ? options.uncertaintyThreshold\n166:       : resolvedUncertaintyThreshold(),\n167:     confidenceOnly: false,\n168:   };\n169:   return emptyOutput({\n170:     workspaceRoot: requestWorkspaceRoot(\n171:       typeof input.workspaceRoot === 'string' ? input.workspaceRoot : undefined,\n172:     ),\n173:     effectiveThresholds,\n174:     freshness: 'unavailable',\n175:     trustState: unavailableTrustState('ADVISOR_DISABLED'),\n176:     warnings: ['ADVISOR_DISABLED'],\n177:     abstainReasons: [`Skill advisor disabled by ${disabledBy}.`],\n178:   });\n179: }","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/lib/advisor-disabled.ts, lines 1-179\n1: // ───────────────────────────────────────────────────────────────\n2: // MODULE: Advisor Disabled Switch\n3: // ───────────────────────────────────────────────────────────────\n4: // The switch belongs to whoever makes the request. The handler reads it in the\n5: // daemon and the CLI client reads it in the caller's own process before it\n6: // connects, so both build the same envelope here. The client cannot import the\n7: // handler because the handler loads the native database module and the scorer.\n8: // The rule itself is the hooks' resolver, so the direct call abstains exactly\n9: // when the prompt hooks do.\n10: \n11: // ───────────────────────────────────────────────────────────────────\n12: // 1. IMPORTS\n13: // ───────────────────────────────────────────────────────────────────\n14: \n15: import { existsSync, realpathSync } from 'node:fs';\n16: import { createRequire } from 'node:module';\n17: import { dirname, join, resolve } from 'node:path';\n18: import { fileURLToPath } from 'node:url';\n19: \n20: import {\n21:   AdvisorRecommendOutputSchema,\n22:   type AdvisorRecommendOutput,\n23: } from '../schemas/advisor-tool-schemas.js';\n24: import {\n25:   resolvedConfidenceThreshold,\n26:   resolvedUncertaintyThreshold,\n27: } from './compat/contract.js';\n28: import { findAdvisorWorkspaceRoot } from './utils/workspace-root.js';\n29: \n30: // ───────────────────────────────────────────────────────────────────\n31: // 2. HELPERS\n32: // ───────────────────────────────────────────────────────────────────\n33: \n34: type PublicThresholds = AdvisorRecommendOutput['effectiveThresholds'];\n35: \n36: interface HookFlagsResolver {\n37:   hookFlagDecision(\n38:     concern: string,\n39:     env?: NodeJS.ProcessEnv,\n40:     config?: Readonly<Record<string, string>>,\n41:   ): { enabled: boolean; key: string | null };\n42:   loadConfigFile(path: string): Record<string, string>;\n43:   configPath(): string;\n44:   concernFlag(concern: string): string | null;\n45:   MASTER_FLAG: string;\n46:   MASTER_ALIASES: readonly string[];\n47:   LEGACY_ALIASES: Readonly<Record<string, readonly string[]>>;\n48: }\n49: \n50: // The source and the built module sit at different depths below .skilled, so the\n51: // resolver is found by walking up rather than by counting parent hops. A missing\n52: // resolver answers as if no switch were set, as every adapter does.\n53: function loadHookFlags(): HookFlagsResolver | null {\n54:   let folder = dirname(fileURLToPath(import.meta.url));\n55:   while (true) {\n56:     const resolverPath = join(folder, 'hooks', 'shared', 'hook-flags.cjs');\n57:     if (existsSync(resolverPath)) {\n58:       try {\n59:         return createRequire(import.meta.url)(resolverPath) as HookFlagsResolver;\n60:       } catch {\n61:         return null;\n62:       }\n63:     }\n64:     const parent = dirname(folder);\n65:     if (parent === folder) return null;\n66:     folder = parent;\n67:   }\n68: }\n69: \n70: const hookFlags = loadHookFlags();\n71: const skillAdvisorFlag = hookFlags?.concernFlag('skill-advisor') ?? null;\n72: \n73: // Callers strip these names to isolate a scope from a switch set in the shell.\n74: export const ADVISOR_DISABLED_FLAGS: readonly string[] = hookFlags === null\n75:   ? []\n76:   : [\n77:       hookFlags.MASTER_FLAG,\n78:       ...hookFlags.MASTER_ALIASES,\n79:       ...(skillAdvisorFlag === null ? [] : [skillAdvisorFlag]),\n80:       ...(hookFlags.LEGACY_ALIASES['skill-advisor'] ?? []),\n81:     ];\n82: \n83: // Both arguments go in so an explicit environment never drops the file. The file\n84: // is read per call because each CLI call is its own process.\n85: export function advisorDisabledBy(\n86:   env: NodeJS.ProcessEnv = process.env,\n87:   config?: Readonly<Record<string, string>>,\n88: ): string | null {\n89:   if (hookFlags === null) return null;\n90:   const fileConfig = config ?? hookFlags.loadConfigFile(env.HOOK_FLAGS_CONFIG || hookFlags.configPath());\n91:   const decision = hookFlags.hookFlagDecision('skill-advisor', env, fileConfig);\n92:   return decision.enabled ? null : decision.key;\n93: }\n94: \n95: // Canonicalize a caller-supplied workspaceRoot via realpath.\n96: // The schema-level allowlist refinement runs against the same canonical\n97: // form, so a caller passing /tmp/symlink-to-repo gets the real path\n98: // post-symlink before downstream code uses it.\n99: export function requestWorkspaceRoot(workspaceRoot?: string): string {\n100:   if (!workspaceRoot) {\n101:     return findAdvisorWorkspaceRoot(process.cwd(), { maxDepth: 12 });\n102:   }\n103:   const resolved = resolve(workspaceRoot);\n104:   try {\n105:     return realpathSync.native(resolved);\n106:   } catch {\n107:     return resolved;\n108:   }\n109: }\n110: \n111: function unavailableTrustState(reason: string): AdvisorRecommendOutput['trustState'] {\n112:   return {\n113:     state: 'unavailable',\n114:     reason,\n115:     generation: 0,\n116:     checkedAt: new Date().toISOString(),\n117:     lastLiveAt: null,\n118:   };\n119: }\n120: \n121: // ───────────────────────────────────────────────────────────────────\n122: // 3. EXPORTS\n123: // ───────────────────────────────────────────────────────────────────\n124: \n125: export function emptyOutput(args: {\n126:   workspaceRoot: string;\n127:   effectiveThresholds: AdvisorRecommendOutput['effectiveThresholds'];\n128:   freshness: AdvisorRecommendOutput['freshness'];\n129:   trustState: AdvisorRecommendOutput['trustState'];\n130:   warnings?: readonly string[];\n131:   abstainReasons?: readonly string[];\n132: }): AdvisorRecommendOutput {\n133:   return AdvisorRecommendOutputSchema.parse({\n134:     workspaceRoot: args.workspaceRoot,\n135:     effectiveThresholds: args.effectiveThresholds,\n136:     recommendations: [],\n137:     ambiguous: false,\n138:     freshness: args.freshness,\n139:     trustState: args.trustState,\n140:     generatedAt: new Date().toISOString(),\n141:     cache: {\n142:       hit: false,\n143:       sourceSignaturePresent: false,\n144:     },\n145:     ...(args.warnings && args.warnings.length > 0 ? { warnings: [...args.warnings] } : {}),\n146:     ...(args.abstainReasons && args.abstainReasons.length > 0 ? { abstainReasons: [...args.abstainReasons] } : {}),\n147:   });\n148: }\n149: \n150: export function disabledRecommendOutput(\n151:   input: { readonly workspaceRoot?: unknown; readonly options?: unknown },\n152:   env: NodeJS.ProcessEnv = process.env,\n153:   config?: Readonly<Record<string, string>>,\n154: ): AdvisorRecommendOutput | null {\n155:   const disabledBy = advisorDisabledBy(env, config);\n156:   if (disabledBy === null) return null;\n157:   const options = typeof input.options === 'object' && input.options !== null\n158:     ? input.options as Record<string, unknown>\n159:     : {};\n160:   const effectiveThresholds: PublicThresholds = {\n161:     confidenceThreshold: typeof options.confidenceThreshold === 'number'\n162:       ? options.confidenceThreshold\n163:       : resolvedConfidenceThreshold(),\n164:     uncertaintyThreshold: typeof options.uncertaintyThreshold === 'number'\n165:       ? options.uncertaintyThreshold\n166:       : resolvedUncertaintyThreshold(),\n167:     confidenceOnly: false,\n168:   };\n169:   return emptyOutput({\n170:     workspaceRoot: requestWorkspaceRoot(\n171:       typeof input.workspaceRoot === 'string' ? input.workspaceRoot : undefined,\n172:     ),\n173:     effectiveThresholds,\n174:     freshness: 'unavailable',\n175:     trustState: unavailableTrustState('ADVISOR_DISABLED'),\n176:     warnings: ['ADVISOR_DISABLED'],\n177:     abstainReasons: [`Skill advisor disabled by ${disabledBy}.`],\n178:   });\n179: }"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/lib/advisor-disabled.ts\"}"},"time":{"start":1794760656271,"end":1794760657086}}}}
{"type":"tool_use","timestamp":1794760657089,"sessionID":"ses_e1feefdd5ffeS4J0KdMtC6TlEK","part":{"partID":"prt_1e0124714001PdcOOQpm7pY4n2","sessionID":"ses_e1feefdd5ffeS4J0KdMtC6TlEK","messageID":"msg_1e0122d99001SjNVlHJE96yP4U","type":"tool","id":"call_3a3709ca43534cd893700a40","tool":"read","state":{"status":"completed","input":{"path":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/manual-testing-playbook/compat-and-disable/global-disable-flag.md"},"output":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/manual-testing-playbook/compat-and-disable/global-disable-flag.md, lines 1-126\n1: ---\n2: title: \"CP-003 Global Disable Flag\"\n3: description: \"Manual validation that SPECKIT_SKILL_ADVISOR_HOOK_DISABLED disables all advisor prompt surfaces.\"\n4: trigger_phrases:\n5:   - \"cp-003\"\n6:   - \"global disable flag\"\n7:   - \"global disable\"\n8:   - \"global\"\n9: version: 0.8.6.0\n10: id: CP-003\n11: category: compat_and_disable\n12: stage: routing\n13: expected_workflow_mode: system-skill-advisor\n14: expected_leaf_resources: []\n15: ---\n16: \n17: # CP-003 Global Disable Flag\n18: \n19: Prompt: Manual validation that SPECKIT_SKILL_ADVISOR_HOOK_DISABLED disables all advisor prompt surfaces.\n20: \n21: \n22: ---\n23: \n24: ## 1. OVERVIEW\n25: \n26: Validate the common disable flag across the native CLI, Python shim, runtime hooks and OpenCode plugin.\n27: \n28: ---\n29: \n30: ## 2. SCENARIO CONTRACT\n31: \n32: - Repo root is the working directory.\n33: - Advisor runtime build is current.\n34: - Capture env and command output.\n35: - Never stop the live daemon. Step 1 reads the warm workspace daemon and sends it no signal.\n36: \n37: ---\n38: \n39: ## 3. TEST EXECUTION\n40: \n41: ### Commands\n42: \n43: 1. Native CLI against the warm workspace daemon, which runs without the switch. The client reads the switch in its own process before it connects, so each flagged call must abstain although the daemon would answer, the legacy name set to `1` and the canonical name set to `true`, and the unflagged call after them must still recommend. Each call names `/dev/null` as its flags file, so a switch saved in `.skilled/hooks/hook-flags.env` cannot decide it:\n44: \n45: ```bash\n46: node .skilled/bin/skill-advisor.cjs advisor_status --workspace-root \"$PWD\" --format json --no-warm-only > /dev/null\n47: HOOK_FLAGS_CONFIG=/dev/null SPECKIT_SKILL_ADVISOR_HOOK_DISABLED=1 node .skilled/bin/skill-advisor.cjs advisor_recommend --prompt \"help me commit my changes\" --options '{\"topK\":1,\"includeAbstainReasons\":true}' --format json --timeout-ms 30000\n48: HOOK_FLAGS_CONFIG=/dev/null SYSTEM_SKILL_ADVISOR_DISABLED=true node .skilled/bin/skill-advisor.cjs advisor_recommend --prompt \"help me commit my changes\" --options '{\"topK\":1,\"includeAbstainReasons\":true}' --format json --timeout-ms 30000\n49: HOOK_FLAGS_CONFIG=/dev/null env -u SPECKIT_SKILL_ADVISOR_HOOK_DISABLED -u SYSTEM_SKILL_ADVISOR_HOOK_DISABLED -u SYSTEM_SKILL_ADVISOR_DISABLED -u SYSTEM_HOOKS_DISABLED node .skilled/bin/skill-advisor.cjs advisor_recommend --prompt \"help me commit my changes\" --options '{\"topK\":1}' --format json --timeout-ms 30000\n50: ```\n51: \n52: 2. Python shim:\n53: \n54: ```bash\n55: SPECKIT_SKILL_ADVISOR_HOOK_DISABLED=1 python3 .skilled/skills/system-skill-advisor/runtime/scripts/skill_advisor.py \"help me commit my changes\"\n56: ```\n57: \n58: 3. OpenCode plugin:\n59: \n60: ```bash\n61: npm --prefix .skilled/skills/system-skill-advisor/runtime run test -- tests/system-skill-advisor-plugin.vitest.ts -t \"opt-out\"\n62: ```\n63: \n64: 4. One hook adapter. The spec-kit shim never forwards its child's stderr, so read the skipped record from the diagnostics JSONL. The hook appends that record on every run, disabled or not, and `SKILL_ADVISOR_DEBUG=1` adds nothing to a skipped record:\n65: \n66: ```bash\n67: DIAG=$(node --input-type=module -e \"const m = await import('./.skilled/skills/system-skill-advisor/runtime/dist/runtime/lib/metrics.js'); console.log(m.advisorHookDiagnosticsPath(process.cwd()))\")\n68: BEFORE=$(cat \"$DIAG\" 2>/dev/null | wc -l | tr -d ' ')\n69: printf '%s' '{\"prompt\":\"help me commit my changes\",\"cwd\":\"'\"$PWD\"'\",\"hook_event_name\":\"UserPromptSubmit\"}' \\\n70:   | SPECKIT_SKILL_ADVISOR_HOOK_DISABLED=1 SKILL_ADVISOR_DEBUG=1 node .skilled/skills/system-spec-kit/runtime/dist/hooks/claude/user-prompt-submit.js\n71: echo \"Exit: $?\"\n72: AFTER=$(cat \"$DIAG\" | wc -l | tr -d ' ')\n73: echo \"diagnostic lines: $BEFORE -> $AFTER\"\n74: tail -n 1 \"$DIAG\"\n75: ```\n76: \n77: ### Expected Signals\n78: \n79: - Step 1's two flagged calls each return `recommendations: []`, `freshness: \"unavailable\"` and `ADVISOR_DISABLED`, although the warm daemon would have answered, and the second names `SYSTEM_SKILL_ADVISOR_DISABLED` in its abstain reason.\n80: - Step 1's unflagged call that follows returns at least one recommendation, so the switch did not reach the daemon.\n81: - Python shim returns `[]` or prompt-safe disabled output without native scoring.\n82: - OpenCode plugin returns disabled/skipped output without invoking the advisor (covered by the plugin test's env opt-out case).\n83: - Hook adapter prints `{}` and exits `0`. The diagnostics JSONL gains one line, and that newest record has `status: \"skipped\"` and `freshness: \"unavailable\"`. If the file had passed 300 lines, the append trims it to the newest 200, so read the last line instead of the count.\n84: \n85: ### Failure Triage\n86: \n87: | Symptom | Detection | Action |\n88: | --- | --- | --- |\n89: | Any surface still recommends a skill | Non-empty recommendation under disabled env | Block release. |\n90: | Disabled response includes prompt text | Search captured output for prompt literal | Block release. |\n91: | Plugin only honors legacy env | New flag has no effect | Update the plugin after code approval. |\n92: \n93: ### Evidence\n94: \n95: - Capture each numbered step's output and exit status.\n96: - Record whether each flagged native response has empty recommendations, freshness unavailable and ADVISOR_DISABLED, which switch each abstain reason names, and whether the unflagged call that follows still recommends.\n97: - Record whether the Python shim returns an empty list or prompt-safe disabled output. Record whether the plugin returns disabled or skipped output without invoking the advisor.\n98: - Capture the hook output {}, exit status 0, diagnostic line counts and newest record values status skipped and freshness unavailable.\n99: - If the diagnostics file exceeds 300 lines, record that the append trims it to 200 and inspect the newest record.\n100: \n101: ### Pass / Fail\n102: \n103: - **Pass**: Every expected signal holds.\n104: - **Fail**: Any signal differs.\n105: \n106: ---\n107: \n108: ## 4. SOURCE FILES\n109: \n110: - Root playbook: [manual-testing-playbook.md](../manual-testing-playbook.md)\n111: - `.skilled/skills/system-skill-advisor/runtime/handlers/advisor-recommend.ts`\n112: - `.skilled/skills/system-skill-advisor/runtime/skill-advisor-cli.ts`\n113: - `.skilled/skills/system-skill-advisor/runtime/lib/advisor-disabled.ts`\n114: - `.skilled/hooks/shared/hook-flags.cjs`\n115: - `.skilled/skills/system-skill-advisor/runtime/scripts/skill_advisor.py`\n116: - `.opencode/plugins/system-skill-advisor.js`\n117: - `.skilled/skills/system-skill-advisor/hooks/claude/user-prompt-submit.ts`\n118: \n119: ---\n120: \n121: ## 5. SOURCE METADATA\n122: \n123: - Group: Compat And Disable\n124: - Playbook ID: CP-003\n125: - Canonical root source: manual-testing-playbook.md\n126: - Feature file path: compat-and-disable/global-disable-flag.md","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/manual-testing-playbook/compat-and-disable/global-disable-flag.md, lines 1-126\n1: ---\n2: title: \"CP-003 Global Disable Flag\"\n3: description: \"Manual validation that SPECKIT_SKILL_ADVISOR_HOOK_DISABLED disables all advisor prompt surfaces.\"\n4: trigger_phrases:\n5:   - \"cp-003\"\n6:   - \"global disable flag\"\n7:   - \"global disable\"\n8:   - \"global\"\n9: version: 0.8.6.0\n10: id: CP-003\n11: category: compat_and_disable\n12: stage: routing\n13: expected_workflow_mode: system-skill-advisor\n14: expected_leaf_resources: []\n15: ---\n16: \n17: # CP-003 Global Disable Flag\n18: \n19: Prompt: Manual validation that SPECKIT_SKILL_ADVISOR_HOOK_DISABLED disables all advisor prompt surfaces.\n20: \n21: \n22: ---\n23: \n24: ## 1. OVERVIEW\n25: \n26: Validate the common disable flag across the native CLI, Python shim, runtime hooks and OpenCode plugin.\n27: \n28: ---\n29: \n30: ## 2. SCENARIO CONTRACT\n31: \n32: - Repo root is the working directory.\n33: - Advisor runtime build is current.\n34: - Capture env and command output.\n35: - Never stop the live daemon. Step 1 reads the warm workspace daemon and sends it no signal.\n36: \n37: ---\n38: \n39: ## 3. TEST EXECUTION\n40: \n41: ### Commands\n42: \n43: 1. Native CLI against the warm workspace daemon, which runs without the switch. The client reads the switch in its own process before it connects, so each flagged call must abstain although the daemon would answer, the legacy name set to `1` and the canonical name set to `true`, and the unflagged call after them must still recommend. Each call names `/dev/null` as its flags file, so a switch saved in `.skilled/hooks/hook-flags.env` cannot decide it:\n44: \n45: ```bash\n46: node .skilled/bin/skill-advisor.cjs advisor_status --workspace-root \"$PWD\" --format json --no-warm-only > /dev/null\n47: HOOK_FLAGS_CONFIG=/dev/null SPECKIT_SKILL_ADVISOR_HOOK_DISABLED=1 node .skilled/bin/skill-advisor.cjs advisor_recommend --prompt \"help me commit my changes\" --options '{\"topK\":1,\"includeAbstainReasons\":true}' --format json --timeout-ms 30000\n48: HOOK_FLAGS_CONFIG=/dev/null SYSTEM_SKILL_ADVISOR_DISABLED=true node .skilled/bin/skill-advisor.cjs advisor_recommend --prompt \"help me commit my changes\" --options '{\"topK\":1,\"includeAbstainReasons\":true}' --format json --timeout-ms 30000\n49: HOOK_FLAGS_CONFIG=/dev/null env -u SPECKIT_SKILL_ADVISOR_HOOK_DISABLED -u SYSTEM_SKILL_ADVISOR_HOOK_DISABLED -u SYSTEM_SKILL_ADVISOR_DISABLED -u SYSTEM_HOOKS_DISABLED node .skilled/bin/skill-advisor.cjs advisor_recommend --prompt \"help me commit my changes\" --options '{\"topK\":1}' --format json --timeout-ms 30000\n50: ```\n51: \n52: 2. Python shim:\n53: \n54: ```bash\n55: SPECKIT_SKILL_ADVISOR_HOOK_DISABLED=1 python3 .skilled/skills/system-skill-advisor/runtime/scripts/skill_advisor.py \"help me commit my changes\"\n56: ```\n57: \n58: 3. OpenCode plugin:\n59: \n60: ```bash\n61: npm --prefix .skilled/skills/system-skill-advisor/runtime run test -- tests/system-skill-advisor-plugin.vitest.ts -t \"opt-out\"\n62: ```\n63: \n64: 4. One hook adapter. The spec-kit shim never forwards its child's stderr, so read the skipped record from the diagnostics JSONL. The hook appends that record on every run, disabled or not, and `SKILL_ADVISOR_DEBUG=1` adds nothing to a skipped record:\n65: \n66: ```bash\n67: DIAG=$(node --input-type=module -e \"const m = await import('./.skilled/skills/system-skill-advisor/runtime/dist/runtime/lib/metrics.js'); console.log(m.advisorHookDiagnosticsPath(process.cwd()))\")\n68: BEFORE=$(cat \"$DIAG\" 2>/dev/null | wc -l | tr -d ' ')\n69: printf '%s' '{\"prompt\":\"help me commit my changes\",\"cwd\":\"'\"$PWD\"'\",\"hook_event_name\":\"UserPromptSubmit\"}' \\\n70:   | SPECKIT_SKILL_ADVISOR_HOOK_DISABLED=1 SKILL_ADVISOR_DEBUG=1 node .skilled/skills/system-spec-kit/runtime/dist/hooks/claude/user-prompt-submit.js\n71: echo \"Exit: $?\"\n72: AFTER=$(cat \"$DIAG\" | wc -l | tr -d ' ')\n73: echo \"diagnostic lines: $BEFORE -> $AFTER\"\n74: tail -n 1 \"$DIAG\"\n75: ```\n76: \n77: ### Expected Signals\n78: \n79: - Step 1's two flagged calls each return `recommendations: []`, `freshness: \"unavailable\"` and `ADVISOR_DISABLED`, although the warm daemon would have answered, and the second names `SYSTEM_SKILL_ADVISOR_DISABLED` in its abstain reason.\n80: - Step 1's unflagged call that follows returns at least one recommendation, so the switch did not reach the daemon.\n81: - Python shim returns `[]` or prompt-safe disabled output without native scoring.\n82: - OpenCode plugin returns disabled/skipped output without invoking the advisor (covered by the plugin test's env opt-out case).\n83: - Hook adapter prints `{}` and exits `0`. The diagnostics JSONL gains one line, and that newest record has `status: \"skipped\"` and `freshness: \"unavailable\"`. If the file had passed 300 lines, the append trims it to the newest 200, so read the last line instead of the count.\n84: \n85: ### Failure Triage\n86: \n87: | Symptom | Detection | Action |\n88: | --- | --- | --- |\n89: | Any surface still recommends a skill | Non-empty recommendation under disabled env | Block release. |\n90: | Disabled response includes prompt text | Search captured output for prompt literal | Block release. |\n91: | Plugin only honors legacy env | New flag has no effect | Update the plugin after code approval. |\n92: \n93: ### Evidence\n94: \n95: - Capture each numbered step's output and exit status.\n96: - Record whether each flagged native response has empty recommendations, freshness unavailable and ADVISOR_DISABLED, which switch each abstain reason names, and whether the unflagged call that follows still recommends.\n97: - Record whether the Python shim returns an empty list or prompt-safe disabled output. Record whether the plugin returns disabled or skipped output without invoking the advisor.\n98: - Capture the hook output {}, exit status 0, diagnostic line counts and newest record values status skipped and freshness unavailable.\n99: - If the diagnostics file exceeds 300 lines, record that the append trims it to 200 and inspect the newest record.\n100: \n101: ### Pass / Fail\n102: \n103: - **Pass**: Every expected signal holds.\n104: - **Fail**: Any signal differs.\n105: \n106: ---\n107: \n108: ## 4. SOURCE FILES\n109: \n110: - Root playbook: [manual-testing-playbook.md](../manual-testing-playbook.md)\n111: - `.skilled/skills/system-skill-advisor/runtime/handlers/advisor-recommend.ts`\n112: - `.skilled/skills/system-skill-advisor/runtime/skill-advisor-cli.ts`\n113: - `.skilled/skills/system-skill-advisor/runtime/lib/advisor-disabled.ts`\n114: - `.skilled/hooks/shared/hook-flags.cjs`\n115: - `.skilled/skills/system-skill-advisor/runtime/scripts/skill_advisor.py`\n116: - `.opencode/plugins/system-skill-advisor.js`\n117: - `.skilled/skills/system-skill-advisor/hooks/claude/user-prompt-submit.ts`\n118: \n119: ---\n120: \n121: ## 5. SOURCE METADATA\n122: \n123: - Group: Compat And Disable\n124: - Playbook ID: CP-003\n125: - Canonical root source: manual-testing-playbook.md\n126: - Feature file path: compat-and-disable/global-disable-flag.md"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/manual-testing-playbook/compat-and-disable/global-disable-flag.md\"}"},"time":{"start":1794760656660,"end":1794760657089}}}}
