"strict\",\n \"reason\": \"Multi-file measurement harness with cross-runtime, holdout and documentation obligations; not trivial.\",\n \"evidenceRefs\": [\n  \"review-scope-4.txt:3-30\",\n  \"review-brief-4.txt:1\"\n ]\n}\n{\n \"requiredBugClasses\": [\n  \"attribution_field_drop\",\n  \"heredoc_parse\",\n  \"start_detection\",\n  \"codex_exec_string\"\n ],\n \"covered\": [\n  \"attribution_field_drop\",\n  \"heredoc_parse\",\n  \"start_detection\",\n  \"codex_exec_string\"\n ],\n \"ruledOut\": [\n  \"codex_exec_string\"\n ],\n \"deferred\": [],\n \"blocked\": [],\n \"graphCoverageMode\": \"graphless_fallback\"\n}\n{\n \"selectedTargets\": [\n  \"command-offer.mjs\",\n  \"run-command-behaviour.mjs\",\n  \"score-command-transcripts.mjs\",\n  \"README.md\",\n  \"command-offer.vitest.ts\",\n  \"command-transcript-score.vitest.ts\"\n ],\n \"selectionReason\": \"The pass-four area list names these producers and tests; the runner is read as the second producer of the offer fields.\",\n \"discoveryMethods\": [\n  \"direct_read\",\n  \"exact_search\",\n  \"git_log_range\"\n ],\n \"omittedHighRiskTargets\": [\n  \"live behaviour arms (worktree dirty)\",\n  \"holdout prompt text\"\n ],\n \"graphStatus\": \"unavailable\",\n \"semanticSearchStatus\": \"unavailable\",\n \"evide\n[\n {\n  \"id\": \"SL-101\",\n  \"dimension\": \"correctness\",\n  \"targetRefs\": [\n   \"runtime/scripts/routing-accuracy/command-offer.mjs\",\n   \"runtime/scripts/routing-accuracy/run-command-behaviour.mjs\"\n  ],\n  \"bugClass\": \"attribution_field_drop\",\n  \"hypothesis\": \"The partner-side marker is computed but not written to a run line.\",\n  \"searchActions\": [\n   {\n    \"method\": \"direct_read\",\n    \"queryOrPath\": \"command-offer.mjs:70-81,486-499; run-command-behaviour.mjs:1183-1187\",\n    \"result\": \"both writers select offeredCommand/offeredPolicy only\",\n    \"evidenceRefs\": [\n     \"command-offer.mjs:486\",\n     \"run-command-behaviour.mjs:1187\"\n    ]\n   },\n   {\n    \"method\": \"exact_search\",\n    \"queryOrPath\": \"rg -n offeredAs over runtime\",\n    \"result\": \"no producer writes it; only the scorer reads it\",\n    \"ev\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"cd /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research && python3 -c \\\"\\nimport json\\np='specs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/review/lineages/accuracy-runner-4/iter-001.record.json'\\nr=json.load(open(p))\\nprint(list(r.keys()))\\nprint(json.dumps(r.get('traceabilityChecks'), indent=1))\\nprint(json.dumps(r.get('reviewDepthApplicability'), indent=1)[:600])\\nprint(json.dumps(r.get('searchCoverage'), indent=1)[:600])\\nprint(json.dumps(r.get('targetSelection'), indent=1)[:600])\\nprint(json.dumps(r.get('searchLedger'), indent=1)[:800])\\n\\\"\"}"},"time":{"start":1794761321402,"end":1794761323196}}}}
