gence.convergenceMode) || \"default\"),\n      reviewModeContractDigest: sha(fs.readFileSync(workflowPath)),\n      initialReleaseReadinessState: \"not-assessed\",\n      ...(topic === null ? {} : { topic }),\n    },\n  }));\n' \"$ART/deep-review-config.json\" \".skilled/commands/deep/assets/deep-review.yaml\" > \"$ART/_events/run-open.json\"\nnode .skilled/skills/system-deep-loop/runtime/scripts/append-mode-event.cjs --mode review --run-directory \"$ART\" --event-json \"$ART/_events/run-open.json\"\necho \"GATEWAY_EXIT=$?\"\nls -la \"$ART\""},"output":"{\"ok\":true,\"receipt\":{\"ledger_id\":\"deep-review-ledger\",\"sequence\":1,\"event_id\":\"event-e60f7800-5d8e-44d5-9911-ace921b75dc1\",\"event_type\":\"deep-review.ledger.run-initialized\",\"event_version\":1,\"stream_id\":\"deep-review-ledger\",\"stream_sequence\":1,\"committed_at\":\"2026-11-15T16:46:25.578Z\",\"canonicalEventHash\":\"07b976610cfcef6d842fb77a6cb37060c55bbb2c167f393ee21b586e85051c67\",\"recordHash\":\"bdebdf69babad6716f57ae971d0aa27e4f9f21d5e54e796e5c03959791b885a5\",\"authorizationRef\":{\"audit_ledger_id\":\"deep-review-audit-ledger\",\"audit_sequence\":2,\"audit_record_hash\":\"77595faad8e8cf1dd3afefbe20ec6f8c9e21f2bd138f172d608683e0bf787797\",\"decision_id\":\"decision-6f3f2465-81ad-44b5-b8a1-ff7b85b19755\",\"decision_digest\":\"10bc07b3349f424938b5983d611b06f26d2bd8eac112981a35f81b8acb5082ce\",\"request_digest\":\"bd21fab2f25e8b0b55dc618b652625b6b177ac8cb0bc3d96c4be9443bb658ebe\",\"policy_digest\":\"883e5d03486b26c23ecdb48a893d8b0db0d8e2e7125e0847705bfd4a2b1a4500\",\"authority_epoch\":1,\"fence_token\":1},\"ledgerId\":\"deep-review-ledger\",\"eventId\":\"event-e60f7800-5d8e-44d5-9911-ace921b75dc1\",\"eventType\":\"deep-review.ledger.run-initialized\",\"eventVersion\":1,\"streamId\":\"deep-review-ledger\",\"streamSequence\":1,\"committedAt\":\"2026-11-15T16:46:25.578Z\"},\"projectionRefreshed\":true,\"projectionError\":null}\nGATEWAY_EXIT=0\ntotal 56\ndrwxr-xr-x@  3 michelkerkmeester  staff  