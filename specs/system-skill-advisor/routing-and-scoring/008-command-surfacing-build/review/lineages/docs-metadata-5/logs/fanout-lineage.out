":"{\"command\":\"cd /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research\\nnode -e '\\nconst fs=require(\\\"fs\\\"),path=require(\\\"path\\\");\\nconst files=[\\n\\\".skilled/skills/system-skill-advisor/manual-testing-playbook/manual-testing-playbook.md\\\",\\n\\\".skilled/skills/system-skill-advisor/manual-testing-playbook/native-cli-tools/command-offer-fit-gates.md\\\",\\n\\\".skilled/skills/system-skill-advisor/manual-testing-playbook/cli-hooks-and-plugin/brief-command-policy-word.md\\\",\\n\\\".skilled/skills/system-skill-advisor/manual-testing-playbook/cli-hooks-and-plugin/vibe-command-documents.md\\\",\\n\\\".skilled/skills/system-skill-advisor/feature-catalog/cli-surface/advisor-recommend.md\\\",\\n\\\".skilled/skills/system-skill-advisor/feature-catalog/scorer-fusion/command-meaning-matching.md\\\",\\n\\\".skilled/skills/system-skill-advisor/feature-catalog/scorer-fusion/doctor-command-routing.md\\\",\\n\\\".skilled/skills/system-skill-advisor/changelog/v1.1.0.0.md\\\",\\n\\\".skilled/skills/system-skill-advisor/runtime/tests/README.md\\\"\\n];\\nlet bad=0;\\nfor(const f of files){\\n  const txt=fs.readFileSync(f,\\\"utf8\\\");\\n  for(const m of txt.matchAll(/\\\\[[^\\\\]]*\\\\]\\\\(([^)#]+)(?:#[^)]*)?\\\\)/g)){\\n    const t=m[1];\\n    if(/^(https?:|mailto:)/.test(t)) continue;\\n    const p=path.resolve(path.dirname(f),t);\\n    if(!fs.existsSync(p)){bad++; console.log(\\\"BROKEN\\\",f,\\\"->\\\",t);}\\n  }\\n}\\nconsole.log(\\\"broken total\\\",bad);\\n'\\n\"}"},"time":{"start":1794760916646,"end":1794760921804}}}}
