n109:       \"mode\",\n110:       \"reviewDimensions\",\n111:       \"antiConvergence.convergenceMode\",\n112:       \"antiConvergence.stopPolicy\"\n113:     ],\n114:     \"promotionMode\": \"advisory-only\"\n115:   },\n116:   \"fanout\": {\n117:     \"executors\": [\n118:       {\n119:         \"kind\": \"cli-opencode\",\n120:         \"model\": \"opencode-go/deepseek-v4.1-flash\",\n121:         \"reasoningEffort\": \"max\",\n122:         \"iterations\": 5,\n123:         \"label\": \"scorer-attach\",\n124:         \"count\": 1\n125:       },\n126:       {\n127:         \"kind\": \"cli-opencode\",\n128:         \"model\": \"opencode-go/deepseek-v4.1-flash\",\n129:         \"reasoningEffort\": \"max\",\n130:         \"iterations\": 5,\n131:         \"label\": \"render-hooks-plugin\",\n132:         \"count\": 1\n133:       },\n134:       {\n135:         \"kind\": \"cli-opencode\",\n136:         \"model\": \"opencode-go/deepseek-v4.1-flash\",\n137:         \"reasoningEffort\": \"max\",\n138:         \"iterations\": 5,\n139:         \"label\": \"accuracy-runner\",\n140:         \"count\": 1\n141:       },\n142:       {\n143:         \"kind\": \"cli-opencode\",\n144:         \"model\": \"opencode-go/deepseek-v4.1-flash\",\n145:         \"reasoningEffort\": \"max\",\n146:         \"iterations\": 5,\n147:         \"label\": \"doctor-install\",\n148:         \"count\": 1\n149:       }\n150:     ],\n151:     \"concurrency\": 4\n152:   }\n153: }"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/specs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/review/deep-review-config.json\"}"},"time":{"start":1794760633490,"end":1794760634091}}}}
