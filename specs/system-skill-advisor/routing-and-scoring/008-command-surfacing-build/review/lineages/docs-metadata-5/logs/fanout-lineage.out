d-transcripts.mjs:914',\n    '.skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/score-command-transcripts.mjs:883',\n    '.skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/score-command-transcripts.mjs:1645',\n    '.skilled/skills/system-skill-advisor/hooks/vibe/prompt-advisor.mjs:184'\n  ],\n  findingsCount: 1,\n  findingsSummary: { P0: 0, P1: 0, P2: 1 },\n  findingsNew: { P0: 0, P1: 0, P2: 1 },\n  findingDetails: findings,\n  traceabilityChecks: {\n    summary: { required: 6, executed: 6, pass: 4, partial: 1, fail: 0, blocked: 0, notApplicable: 1, gatingFailures: 0 },\n    results: [\n      { protocol: 'spec_code', level: 'core', status: 'partial', evidence: 'phase children 019 and 022 own the measure intent; no top-level spec reference' },\n      { protocol: 'checklist_evidence', level: 'core', status: 'notApplicable', evidence: 'no top-level checklist.md' },\n      { protocol: 'skill_agent', level: 'overlay', status: 'pass', evidence: 'runtime list matches the handlers that write health records' },\n      { protocol: 'agent_cross_runtime', level: 'overlay', status: 'pass', evidence: 'Vibe journal loader and Vibe diagnostic writer read at their call sites' },\n      { protocol: 'feature_catalog_code', level: 'overlay', status: 'pass', evidence: 'no catalog claim changed' },\n      { protocol: 'playbook_capability', level: 'overlay', status: 'notApplicable', evidence: 'no playbook file changed' }\n    ]\n  },\n  newFindingsRatio: 0.13,\n  noveltyJustification: 'One new definition-gap finding (weight 1) against eight weighted findings on record; the rest of the workflow-measure section matched the scorer exactly.',\n  sessionId: 'fanout-docs-metadata-5-1794760565927-i99t40', generation: 1, lineageMode: 'new',\n  timestamp: new Date().toISOString(), durationMs: 120000,\n  reviewDepthSchemaVersion: 2,\n  reviewDepthApplicability: { scopeClass: 'standard', enforcement: 'strict', reason: 'correctness pass over the changelog workflow-measure section and the scorer expressions', evidenceRefs: ['specs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/review/lineages/docs-metadata-5/iterations/iteration-003.md:1'] },\n  targetSelection: {\n    selectedTargets: ['.skilled/skills/system-skill-advisor/changelog/v1.1.0.0.md','.skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/score-command-transcripts.mjs','.skilled/skills/system-skill-advisor/hooks/vibe/prompt-advisor.mjs'],\n    selectionReason: 'the workflow-measure section and the scorer it describes were the last unchecked formula surface',\n    discoveryMethods: ['direct_read','exact_search'],\n    omittedHighRiskTargets: ['stored arm transcripts (not opened)', 'holdout prompt corpora (not opened)'],\n    graphStatus: 'unavailable', semanticSearchStatus: 'unavailable',\n    evidenceRefs: ['.skilled/skills/system-skill-advisor/changelog/v1.1.0.0.md:176']\n  },\n  searchCoverage: {\n    requiredBugClasses: ['metric_formula_mismatch','offer_counted_without_offer','load_counted_without_load','journal_scoring_divergence'],\n    covered: ['metric_formula_mismatch'], ruledOut: ['offer_counted_without_offer','load_counted_without_load','journal_scoring_divergence'], deferred: [], blocked: [], graphCoverageMode: 'graphless_fallback'\n  },\n  searchLedger: [\n    { id: 'SL-014', dimension: 'correctness', targetRefs: ['.skilled/skills/system-skill-advisor/changelog/v1.1.0.0.md'], bugClass: 'metric_formula_mismatch', hypothesis: 'the load-rate sentence may describe a wider numerator than the scorer uses', searchActions: [{ method: 'direct_read', queryOrPath: 'changelog lines 174-176 and score-command-transcripts.mjs loadRate/followedRate', result: 'doc says loaded a workflow; code numerator is command + skill; otherMode and noOwner are published but not described', evidenceRefs: ['.skilled/skills/system-skill-advisor/changelog/v1.1.0.0.md:176','.skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/score-command-transcripts.mjs:1863'] }], disposition: 'finding', linkedFindingId: 'DM5-P2-008', rationale: 'the definition and the published tally disagree' },\n    { id: 'SL-015', dimension: 'correctness', targetRefs: ['.skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/score-command-transcripts.mjs'], bugClass: 'offer_counted_without_offer', hypothesis: 'an ask may be counted without an observed offer', searchActions: [{ method: 'direct_read', queryOrPath: 'askedAndWaited and workflowPath ask branch', result: 'branch requires ask policy, no write and an observed ask-and-wait event', evidenceRefs: ['.skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/score-command-transcripts.mjs:926'] }], disposition: 'ruled_out', ruledOutReason: 'the ask path requires an observed offer and wait' },\n    { id: 'SL-016', dimension: 'correctness', targetRefs: ['.skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/score-command-transcripts.mjs'], bugClass: 'load_counted_without_load', hypothesis: 'a non-load may enter the load-rate numerator', searchActions: [{ method: 'direct_read', queryOrPath: 'loadRate numerator', result: 'numerator is command + skill, both witnessed loads', evidenceRefs: ['.skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/score-command-transcripts.mjs:1863'] }], disposition: 'ruled_out', ruledOutReason: 'both numerator paths require a witnessed load' },\n    { id: 'SL-017', dimension: 'correctness', targetRefs: ['.skilled/skills/system-skill-advisor/hooks/vibe/prompt-advisor.mjs'], bugClass: 'journal_scoring_divergence', hypothesis: 'Vibe journals may be scored by a parallel path classifier', searchActions: [{ method: 'direct_read', queryOrPath: 'loadVibeSession and vibeRecords call sites', result: 'Vibe records feed the same workflowPath()', evidenceRefs: ['.skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/score-command-transcripts.mjs:1645'] }], disposition: 'ruled_out',