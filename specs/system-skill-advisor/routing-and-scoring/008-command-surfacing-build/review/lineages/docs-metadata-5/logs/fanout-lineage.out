to a program and not commands, so the pattern\n844:  let otherMode = false;\n866:      otherMode = true;\n877:  return otherMode ? 'otherMode' : null;\n906: * run that wrote without loading either is improvised, and a run that only talked\n914: * @returns {'command'|'skill'|'otherMode'|'asked'|'improvised'|'none'|'noOwner'} Which\n915: *   workflow the run loaded, `otherMode` when it loaded another mode of the owning\n916: *   hub, `asked` when an ask row offered its command and waited, `improvised` when\n934:  // asking is that policy's own step rather than a path the run improvised.\n940:  return wrote === true || firstWritePosition(stream, checkoutDir) !== null ? 'improvised' : 'none';\n978:// search, an in-place `sed` and a heredoc line are not.\n1110:const DEEP_LOOP_FOLDER = /(?:^|\\/)(?:research|review)\\//;\n1232:  return namespace === 'deep' && (name === 'research' || name === 'review');\n1539:const LOOP_COMMANDS = Object.freeze(['/deep:research', '/deep:review', '/speckit:complete']);\n1617: *      workflowPath: 'command'|'skill'|'improvised'|'none'|'noOwner'}>}\n1769:    workflow: { command: 0, skill: 0, asked: 0, askedActed: 0, otherMode: 0, improvised: 0, none: 0, noneActed: 0, noOwner: 0 },\n1854:      otherMode: tally.workflow.otherMode,\n1855:      improvised: tally.workflow.improvised,\n1863:      loadRate: rate(\n1865:        tally.workflow.command + tally.workflow.skill + tally.workflow.asked + tally.workflow.otherMode + tally.workflow.improvised + tally.workflow.none,\n1867:      followedRate: rate(\n1869:        tally.workflow.command + tally.workflow.skill + tally.workflow.asked + tally.workflow.otherMode + tally.workflow.improvised + tally.workflow.none,\n1884:        tally.workflow.command + tally.workflow.skill + tally.workflow.improvised,\n1890:        tally.workflow.command + tally.workflow.skill + tally.workflow.asked + tally.workflow.otherMode + tally.workflow.improvised + tally.workflow.none,\n1894:        tally.workflow.command + tally.workflow.skill + tally.workflow.asked + tally.workflow.otherMode + tally.workflow.improvised + tally.workflow.none,\n1921:  // policy still loaded a workflow or improvised one.\n2180:      // show that its runs improvised a workflow or that no run could be read for one.\n2183:          + ` improvised ${block.workflow.improvised}, none ${block.workflow.none},`\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"== README §3 subfolders\nOK cache\nOK compat\nOK fixtures\nOK helpers\nOK handlers\nOK hooks\nOK legacy\nOK parity\nOK python\nOK schemas\nOK scorer\nOK embedders\nOK skill-graph\n== README §4/§5 files\nOK affordance-normalizer.test.ts\nOK lane-attribution.test.ts\nOK routing-fixtures.affordance.test.ts\nOK shadow-sink.vitest.ts\nOK tsconfig.tests.json\n== central playbook root\n-rw-r--r--@ 1 michelkerkmeester  staff  29391 Nov 12 10:24 .skilled/manual-testing-playbook/manual-testing-playbook.md\n== changelog path/formula refs\n588:  const space = whole.search(/\\s/);\n704:// after a redirect operator names a file the command writes instead. A search prints\n708:// The lines of a heredoc are data handed to a program and not commands, so the pattern\n844:  let otherMode = false;\n866:      otherMode = true;\n877:  return otherMode ? 'otherMode' : null;\n906: * run that wrote without loading either is improvised, and a run that only talked\n914: * @returns {'command'|'skill'|'otherMode'|'asked'|'improvised'|'none'|'noOwner'} Which\n915: *   workflow the run loaded, `otherMode` when it loaded another mode of the owning\n916: *   hub, `asked` when an ask row offered its command and waited, `improvised` when\n934:  // asking is that policy's own step rather than a path the run improvised.\n940:  return wrote === true || firstWritePosition(stream, checkoutDir) !== null ? 'improvised' : 'none';\n978:// search, an in-place `sed` and a heredoc line are not.\n1110:const DEEP_LOOP_FOLDER = /(?:^|\\/)(?:research|review)\\//;\n1232:  return namespace === 'deep' && (name === 'research' || name === 'review');\n1539:const LOOP_COMMANDS = Object.freeze(['/deep:research', '/deep:review', '/speckit:complete']);\n1617: *      workflowPath: 'command'|'skill'|'improvised'|'none'|'noOwner'}>}\n1769:    workflow: { command: 0, skill: 0, asked: 0, askedActed: 0, otherMode: 0, improvised: 0, none: 0, noneActed: 0, noOwner: 0 },\n1854:      otherMode: tally.workflow.otherMode,\n1855:      improvised: tally.workflow.improvised,\n1863:      loadRate: rate(\n1865:        tally.workflow.command + tally.workflow.skill + tally.workflow.asked + tally.workflow.otherMode + tally.workflow.improvised + tally.workflow.none,\n1867:      followedRate: rate(\n1869:        tally.workflow.command + tally.workflow.skill + tally.workflow.asked + tally.workflow.otherMode + tally.workflow.improvised + tally.workflow.none,\n1884:        tally.workflow.command + tally.workflow.skill + tally.workflow.improvised,\n1890:        tally.workflow.command + tally.workflow.skill + tally.workflow.asked + tally.workflow.otherMode + tally.workflow.improvised + tally.workflow.none,\n1894:        tally.workflow.command + tally.workflow.skill + tally.workflow.asked + tally.workflow.otherMode + tally.workflow.improvised + tally.workflow.none,\n1921:  // policy still loaded a workflow or improvised one.\n2180:      // show that its runs improvised a workflow or that no run could be read for one.\n2183:          + ` improvised ${block.workflow.improvised}, none ${block.workflow.none},`\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"cd /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research\\nT=.skilled/skills/system-skill-advisor/runtime/tests\\necho \\\"== README §3 subfolders\\\"; for d in cache compat fixtures helpers handlers hooks legacy parity python schemas scorer embedders skill-graph; do [ -d \\\"$T/$d\\\" ] && echo \\\"OK $d\\\" || ec