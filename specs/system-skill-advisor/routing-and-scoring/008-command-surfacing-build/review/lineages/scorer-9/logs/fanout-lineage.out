\\\";process.stdin.on(\\\"data\\\",d=>s+=d).on(\\\"end\\\",()=>{const j=JSON.parse(s);const d=j.stop_decision;console.log(JSON.stringify({decision:d.decision,stopReason:d.stopReason,reasonDetail:d.reasonDetail,blockedBy:d.blockedBy,weighted:d.weightedStopScore,coverageAge:d.inputs.review.coverageAge,signals:d.signals,gates:Object.fromEntries(Object.entries(d.gates).map(([k,v])=>[k,v.pass]))}))})'\"}"},"time":{"start":1794837264645,"end":1794837267544}}}}
