ll, so each owned\n2225:     // run is counted again under the offer its own run line records.\n2226:     followedByOffer: {\n2227:       offered: { followed: 0, total: 0 },\n2228:       notOffered: { followed: 0, total: 0 },\n2229:       unknown: 0,\n2230:     },\n2231:     byPolicy: Object.fromEntries(POLICY_KEYS.map((key) => [key, newPolicyTally()])),\n2232:   };\n2233: }\n2234: \n2235: // A rate is printed as its two counts, because a percentage hides whether a clean\n2236: // arm scored nothing at all.\n2237: function rate(numerator, denominator) {\n2238:   return `${numerator} of ${denominator}`;\n2239: }\n2240: \n2241: // Two counts alone cannot say how much of the rate is the arm's size, so each rate\n2242: // carries the interval a 95 percent Wilson score puts around it. A rate whose arm\n2243: // scored nothing has no interval to carry.\n2244: export function wilsonRange(successes, total) {\n2245:   if (total === 0) return null;\n2246:   const z = 1.96;\n2247:   const observed = successes / total;\n2248:   const zSquared = z * z;\n2249:   const denominator = 1 + zSquared / total;\n2250:   const centre = (observed + zSquared / (2 * total)) / denominator;\n2251:   const spread = (z * Math.sqrt((observed * (1 - observed)) / total\n2252:     + zSquared / (4 * total * total))) / denominator;\n2253:   const bound = (value) => Math.min(1, Math.max(0, Math.round(value * 100) / 100));\n2254:   return { low: bound(centre - spread), high: bound(centre + spread) };\n2255: }\n2256: \n2257: // Two arms that differ only in the advisor can still split their wins by chance, so\n2258: // the pair counts are read against the exact one-sided tail of the sign test rather\n2259: // than a normal approximation. Integer arithmetic keeps the tail exact at the sizes\n2260: // an arm reports, and the result is rounded to the four decimals a printed p carries.\n2261: export function signTestP(gained, lost) {\n2262:   const pairs = gained + lost;\n2263:   if (pairs === 0) return null;\n2264:   let tail = 0n;\n2265:   let coefficient = 1n;\n2266:   for (let k = 0; k <= pairs; k += 1) {\n2267:     if (k >= gained) tail += coefficient;\n2268:     coefficient = (coefficient * BigInt(pairs - k)) / BigInt(k + 1);\n2269:   }\n2270:   const total = 2n ** BigInt(pairs);\n2271:   const tenThousandths = (tail * 10000n + total / 2n) / total;\n2272:   return Number(tenThousandths) / 10000;\n2273: }\n2274: \n2275: function tallyBlock(tally) {\n2276:   return {\n2277:     runs: tally.runs,\n2278:     scored: tally.scored,\n2279:     capped: tally.capped,\n2280:     unscored: tally.unscored,\n2281:     unscoredRuns: tally.unscoredRuns,\n2282:     startRate: rate(tally.started, tally.startRows),\n2283:     startShapes: { ...tally.startShapes },\n2284:     cappedStartRows: tally.cappedStartRows,\n2285:     offered: tally.offered,\n2286:     cappedOfferRows: tally.cappedOfferRows,\n2287:     startedOfOffered: tally.startedOfOffered,\n2288:     offerFieldAbsent: tally.offerFieldAbsent,\n2289:     offeredAsPartner: tally.offeredAsPartner,\n2290:     offerReached: tally.offerReached,\n2291:     deliveryUnknown: tally.deliveryUnknown,\n2292:     offerSeen: tally.offerSeen,\n2293:     offerDeclined: tally.offerDeclined,\n2294:     commandLineRate: rate(tally.commandLineRuns, tally.scored),\n2295:     unsafe: tally.unsafe,\n2296:     unsafeNoChangedPath: tally.unsafeNoChangedPath,\n2297:     repeatedCommandLines: tally.repeatedCommandLines,\n2298:     loopsWithoutInit: tally.loopsWithoutInit,\n2299:     loops: tally.loops,\n2300:     workflow: {\n2301:       command: tally.workflow.command,\n2302:       skill: tally.workflow.skill,\n2303:       asked: tally.workflow.asked,\n2304:       askedActed: tally.workflow.askedActed,\n2305:       otherMode: tally.workflow.otherMode,\n2306:       improvised: tally.workflow.improvised,\n2307:       none: tally.workflow.none,\n2308:       noneActed: tally.workflow.noneActed,\n2309:       noOwner: tally.workflow.noOwner,\n2310:       unscored: tally.unscored,\n2311:       // The load rate is the outcome reading: every owned run the arm scored is in\n2312:       // its denominator, so a run that skipped the workflow and wrote nothing cannot\n2313:       // leave the count the way it leaves the share.\n2314:       loadRate: rate(\n2315:         tally.workflow.command + tally.workflow.skill,\n2316:         tally.workflow.command + tally.workflow.skill + tally.workflow.asked + tally.workflow.otherMode + tally.workflow.improvised + tally.workflow.none,\n2317:       ),\n2318:       followedRate: rate(\n2319:         tally.workflow.command + tally.workflow.skill + tally.workflow.asked,\n[Output truncated. Continue reading with offset: 2320]","title":"read","metadata":{"metadata":{"truncated":true},"content":[{"type":"text","text":"Read file .skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/score-command-transcripts.mjs, lines 2190-2319\n2190:   return { rows: 0, capped: 0, started: 0, wrote: 0 };\n2191: }\n2192: \n2193: function newTally() {\n2194:   return {\n2195:     runs: 0,\n2196:     scored: 0,\n2197:     capped: 0,\n2198:     unscored: 0,\n2199:     unscoredRuns: [],\n2200:     started: 0,\n2201:     startRows: 0,\n2202:     startShapes: { skill: 0, reported: 0, expanded: 0, readWrite: 0, readOnly: 0 },\n2203:     cappedStartRows: 0,\n2204:     offered: 0,\n2205:     cappedOfferRows: 0,\n2206:     startedOfOffered: 0,\n2207:     offerFieldAbsent: 0,\n2208:     offeredAsPartner: 0,\n2209:     offerReached: 0,\n2210:     deliveryUnknown: 0,\n2211:     offerSeen: 0,\n2212:     offerDeclined: 0,\n2213:     commandLineRuns: 0,\n2214:     unsafe: 0,\n2215:     unsafeNoChangedPath: 0,\n2216:     repeatedCommandLines: 0,\n2217:     loops: 0,\n2218:     loopsWithoutInit: 0,\n2219:     workflow: { command: 0, skill: 0, asked: 0, askedActed: 0, otherMode: 0, improvised: 0, none: 0, noneActed: 0, noOwner: 0 },\n2220:     pairCounts: new Map(),\n2221:     // A decline row and a skill-only row are judged by whether the run began a tracked\n2222:     // command, so each run of either class is counted with the start it produced.\n2223:     commandStarts: { decline: { started: 0, runs: 0 }, skillOnly: { started: 0, runs: 0 }, runs: [] },\n2224:     // A followed rate hides whether the head named the command at all, so each owned\n2225:     // run is counted again under the offer its own run line records.\n2226:     followedByOffer: {\n2227:       offered: { followed: 0, total: 0 },\n2228:       notOffered: { followed: 0, total: 0 },\n2229:       unknown: 0,\n2230:     },\n2231:     byPolicy: Object.fromEntries(POLICY_KEYS.map((key) => [key, newPolicyTally()])),\n2232:   };\n2233: }\n2234: \n2235: // A rate is printed as its two counts, because a percentage hides whether a clean\n2236: // arm scored nothing at all.\n2237: function rate(numerator, denominator) {\n2238:   return `${numerator} of ${denominator}`;\n2239: }\n2240: \n2241: // Two counts alone cannot say how much of the rate is the arm's size, so each rate\n2242: // carries the interval a 95 percent Wilson score puts around it. A rate whose arm\n2243: // scored nothing has no interval to carry.\n2244: export function wilsonRange(successes, total) {\n2245:   if (total === 0) return null;\n2246:   const z = 1.96;\n2247:   const observed = successes / total;\n2248:   const zSquared = z * z;\n2249:   const denominator = 1 + zSquared / total;\n2250:   const centre = (observed + zSquared / (2 * total)) / denominator;\n2251:   const spread = (z * Math.sqrt((observed * (1 - observed)) / total\n2252:     + zSquared / (4 * total * total))) / denominator;\n2253:   const bound = (value) => Math.min(1, Math.max(0, Math.round(value * 100) / 100));\n2254:   return { low: bound(centre - spread), high: bound(centre + spread) };\n2255: }\n2256: \n2257: // Two arms that differ only in the advisor can still split their wins by chance, so\n2258: // the pair counts are read against the exact one-sided tail of the sign test rather\n2259: // than a normal approximation. Integer arithmetic keeps the tail exact at the sizes\n2260: // an arm reports, and the result is rounded to the four decimals a printed p carries.\n2261: export function signTestP(gained, lost) {\n2262:   const pairs = gained + lost;\n2263:   if (pairs === 0) return null;\n2264:   let tail = 0n;\n2265:   let coefficient = 1n;\n2266:   for (let k = 0; k <= pairs; k += 1) {\n2267:     if (k >= gained) tail += coefficient;\n2268:     coefficient = (coefficient * BigInt(pairs - k)) / BigInt(k + 1);\n2269:   }\n2270:   const total = 2n ** BigInt(pairs);\n2271:   const tenThousandths = (tail * 10000n + total / 2n) / total;\n2272:   return Number(tenThousandths) / 10000;\n2273: }\n2274: \n2275: function tallyBlock(tally) {\n2276:   return {\n2277:     runs: tally.runs,\n2278:     scored: tally.scored,\n2279:     capped: tally.capped,\n2280:     unscored: tally.unscored,\n2281:     unscoredRuns: tally.unscoredRuns,\n2282:     startRate: rate(tally.started, tally.startRows),\n2283:     startShapes: { ...tally.startShapes },\n2284:     cappedStartRows: tally.cappedStartRows,\n2285:     offered: tally.offered,\n2286:     cappedOfferRows: tally.cappedOfferRows,\n2287:     startedOfOffered: tally.startedOfOffered,\n2288:     offerFieldAbsent: tally.offerFieldAbsent,\n2289:     offeredAsPartner: tally.offeredAsPartner,\n2290:     offerReached: tally.offerReached,\n2291:     deliveryUnknown: tally.deliveryUnknown,\n2292:     offerSeen: tally.offerSeen,\n2293:     offerDeclined: tally.offerDeclined,\n2294:     commandLineRate: rate(tally.commandLineRuns, tally.scored),\n2295:     unsafe: tally.unsafe,\n2296:     unsafeNoChangedPath: tally.unsafeNoChangedPath,\n2297:     repeatedCommandLines: tally.repeatedCommandLines,\n2298:     loopsWithoutInit: tally.loopsWithoutInit,\n2299:     loops: tally.loops,\n2300:     workflow: {\n2301:       command: tally.workflow.command,\n2302:       skill: tally.workflow.skill,\n2303:       asked: tally.workflow.asked,\n2304:       askedActed: tally.workflow.askedActed,\n2305:       otherMode: tally.workflow.otherMode,\n2306:       improvised: tally.workflow.improvised,\n2307:       none: tally.workflow.none,\n2308:       noneActed: tally.workflow.noneActed,\n2309:       noOwner: tally.workflow.noOwner,\n2310:       unscored: tally.unscored,\n2311:       // The load rate is the outcome reading: every owned run the arm scored is in\n2312:       // its denominator, so a run that skipped the workflow and wrote nothing cannot\n2313:       // leave the count the way it leaves the share.\n2314:       loadRate: rate(\n2315:         tally.workflow.command + tally.workflow.skill,\n2316:         tally.workflow.command + tally.workflow.skill + tally.workflow.asked + tally.workflow.otherMode + tally.workflow.improvised + tally.workflow.none,\n2317:       ),\n2318:       followedRate: rate(\n2319:         tally.workflow.command + tally.workflow.skill + tally.workflow.asked,\n[Output truncated. Continue reading with offset: 2320]"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"limit\":130,\"offset\":2190,\"path\":\".skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/score-command-transcripts.mjs\"}"},"time":{"start":1794836315542,"end":1794836316039}}}}
