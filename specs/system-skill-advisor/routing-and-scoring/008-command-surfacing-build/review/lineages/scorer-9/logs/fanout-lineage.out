/skills/system-skill-advisor/runtime/scripts/routing-accuracy/README.md\n5: attach-config\t.skilled/skills/system-skill-advisor/runtime/lib/command-attach.ts\n6: attach-config\t.skilled/skills/system-skill-advisor/runtime/tests/command-attach-guards.vitest.ts\n7: attach-config\t.skilled/skills/system-skill-advisor/runtime/vitest.config.ts\n8: attach-config\t.skilled/skills/system-skill-advisor/runtime/tests/doctor-brief-render.vitest.ts"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\": \"specs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/review/review-scope-9.txt\"}"},"time":{"start":1794835892742,"end":1794835893096}}}}
