 line.count = totals.get(commandTallyKey(line.command));\n576: \n577:   return lines;\n578: }\n579: \n580: /**\n581:  * Read whether a session's `COMMAND:` lines named the command a row expected.\n582:  *\n583:  * A model writes that line after it read the head, so the line is evidence the\n584:  * offer reached it even when the turn declined the command, which the run line's\n585:  * own offer field cannot show. The last matching line decides the state, because\n586:  * a later line is the model's final answer about the same command.\n587:  *\n588:  * @param {Array<{seq: number, kind: string, text: string|null}>} events - Events\n589:  *   from `normalize`.\n590:  * @param {string|null} expectedCommand - The row's expected command, with or\n591:  *   without its leading slash and its mode suffix.\n592:  * @returns {{offerSeen: boolean, commandState: string|null}} Whether at least one\n593:  *   line named the command, and the state of the last line that did.\n594:  */\n595: export function offerSeenIn(events, expectedCommand) {\n596:   const wanted = commandParts(expectedCommand);\n597:   if (wanted === null) return { offerSeen: false, commandState: null };\n598: \n599:   const seen = commandLines(events).filter((line) => namesCommand(line.command, wanted));\n600:   return {\n601:     offerSeen: seen.length > 0,\n[Output truncated. Continue reading with offset: 602]"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"limit\":50,\"offset\":552,\"path\":\".skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/score-command-transcripts.mjs\"}"},"time":{"start":1794836233385,"end":1794836233890}}}}
