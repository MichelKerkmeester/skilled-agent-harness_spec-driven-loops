llow it, while a typed auto in the prompt still asked for it.\n+  it('reads a self-chosen auto followed by a with-modifier as the run\\'s own mode', () => {\n+    const events = [{ seq: 0, kind: 'skill', path: null, command: 'speckit:complete:auto:with-research', text: null }];\n+\n+    expect(startState(events, row({ expected_command: '/speckit:complete', expected_policy: 'start', prompt: 'complete the login spec' }), ARENA).selfAuto).toBe(true);\n+    expect(startState(events, row({ expected_command: '/speckit:complete', expected_policy: 'start', prompt: 'run /speckit:complete:auto on the login spec' }), ARENA).selfAuto).toBe(false);\n+  });\n+\n+  // A model can load a command with the modifiers its argument hint names, so a\n+  // chained mode and `:with-*` suffix still names the expected command.\n+  it('reads a skill load typed with a chained mode and with-modifier as the command', () => {\n+    const events = [{ seq: 0, kind: 'skill', path: null, command: 'speckit:complete:auto:with-research', text: null }];\n+    const state = startState(events, row({ expected_command: '/speckit:complete', expected_policy: 'start' }), ARENA);\n+\n+    expect(state.started).toBe(true);\n+    expect(state.shape).toBe('skill');\n+  });\n+\n   // Each start names the evidence that made it, so the rate shows what it rests on.\n   it.each([\n     { name: 'skill', records: () => oneTurn(toolCall('Skill', { skill: 'create:readme' })), shape: 'skill' },\n@@ -1563,8 +1621,9 @@ describe('startState', () => {\n   });\n \n   // A runtime may read the command's document through the shell, so a reader that\n-  // opens the document is the same start a read tool records. A search, an in-place\n-  // edit and a heredoc line name the document without opening it as a workflow.\n+  // opens the document is the same read a read tool records, and the table's write\n+  // inside the checkout makes that read a start. A search, an in-place edit and a\n+  // heredoc line name the document without opening it as a workflow.\n   it.each([\n     { command: 'cat .skilled/commands/create/readme.md', started: true },\n     { command: 'rg -n step .skilled/commands/create/readme.md', started: false },\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"cd /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research && git -c core.fsmonitor=false diff 85550ee946e 05f776202e0 -- .skilled/skills/system-skill-advisor/runtime/tests/command-transcript-score.vitest.ts\"}"},"time":{"start":1794836008160,"end":1794836009058}}}}
{"type":"step_finish","timestamp":1794836011074,"sessionID":"ses_e1b71e012ffe1Z7OkhaCysQjW9","part":{"id":"prt_1e4901842001usGI81ftPESZ7s","sessionID":"ses_e1b71e012ffe1Z7OkhaCysQjW9","messageID":"msg_1e48fbe390015jbEoxoUR5CgRb","type":"step-finish","reason":"tool-calls","snapshot":"eecb10cae8dcac70963f7b5a5c6c1d78ba402c62","cost":0,"tokens":{"input":1557,"output":108,"reasoning":1751,"cache":{"read":73088,"write":0}}}}
{"type":"step_start","timestamp":1794836013978,"sessionID":"ses_e1b71e012ffe1Z7OkhaCysQjW9","part":{"id":"prt_1e490239a001DqQZra3m4lGFv2","sessionID":"ses_e1b71e012ffe1Z7OkhaCysQjW9","messageID":"msg_1e4901848001V0Y90QBNoJAtEI","type":"step-start","snapshot":"eecb10cae8dcac70963f7b5a5c6c1d78ba402c62"}}
{"type":"tool_use","timestamp":1794836026352,"sessionID":"ses_e1b71e012ffe1Z7OkhaCysQjW9","part":{"partID":"prt_1e4904f80001iNNZRY7BMGZWJa","sessionID":"ses_e1b71e012ffe1Z7OkhaCysQjW9","messageID":"msg_1e4901848001V0Y90QBNoJAtEI","type":"tool","id":"call_580a4ec22695409482f2ec69","tool":"shell","state":{"status":"completed","input":{"command":"cd /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research && rg -n \"with-(context|phases|research)\" --glob '!**/command-prompts.jsonl' --glob '!**/holdout-prompts.jsonl' --glob '!**/behaviour-fresh-prompts.jsonl' -g '!**/node_modules/**' | head -40"},"output":"README.md:93:This creates a spec folder, plans the work, builds it and saves the session context as it goes. Add `:with-research` to research before planning. In a later session, `/speckit:resume` picks up where the last one stopped. The [Runtimes](#10--runtimes-and-cli-bridges) table shows how each runtime spells the command.\n.skilled/commands/README.txt:190:| Plan | `/speckit:plan <description> [--intake-only] [:with-phases]` | Planning workflow (spec through plan only). `--intake-only` publishes just `spec.md`, `description.json` and `graph-metadata.json`. `:with-phases` adds phase decomposition |\n.skilled/commands/README.txt:230:/speckit:complete \"New feature\" :with-research\n.skilled/commands/README.txt:251:- `:with-research` adds a research phase before planning\n.skilled/commands/speckit/assets/speckit-plan.yaml:269:      - { id: spec_path_valid, from: step_0.5_intake_branch, criteria: \"On the single-packet path the spec folder exists, because the intake Emit phase created it. Under :with-phases only a well-formed path is required, because P3 creates the folder after Step 1.\" }\n.skilled/commands/speckit/assets/speckit-plan.yaml:324:    with_phases_rule: \"Under :with-phases, skip the Emit phase of the intake contract. P3 of phase_decomposition creates the parent and child folders after Step 1, so intake binds its fields and writes no folder.\"\n.skilled/commands/speckit/assets/speckit-plan-presentation.txt:71:Feature flags: [with-context yes/no] [with-phases yes/no] [intake-only yes/no]\n.skilled/commands/speckit/assets/speckit-lifecycle-shared.yaml:117:    flag: \":with-phases\"\n.skilled/commands/speckit/assets/speckit-complete-presentation.txt:69:Feature flags: [with-research yes/no] [with-context yes/no] [with-phases yes/no]\n.skilled/commands/speckit/assets/speckit-complete.yaml:55:    - :with-research - Run research phase before planning\n.skilled/commands/speckit/assets/speckit-complete.yaml:110:      flag: \":with-research\"\n.skilled/commands/speckit/assets/speckit-complete.yaml:279:    available_at_step: \"Phase 3 (if :with-research OR confidence < 40%)\"\n.skilled/commands/speckit/assets/speckit-complete.yaml:280:    condition: \"ONLY dispatch when :with-research flag is set OR confidence < 40% during planning\"\n.skilled/commands/speckit/assets/speckit-complete.yaml:333:      - { id: spec_path_valid, from: step_0.5_intake_branch, criteria: \"On the single-packet path the spec folder exists, because the intake Emit phase created it. Under :with-phases only a well-formed path is required, because P3 creates the folder after Step 1.\" }\n.skilled/commands/speckit/assets/speckit-complete.yaml:459:    with_phases_rule: \"Under :with-phases, skip the Emit phase of the intake contract. P3 of phase_decomposition creates the parent and child folders after Step 1, so intake binds its fields and writes no folder.\"\n.skilled/commands/speckit/assets/speckit-complete.yaml:527:    - Verify the spec folder exists. The intake Emit phase creates it, or P3 does under :with-phases\n.skilled/commands/speckit/assets/speckit-complete.yaml:567:      IF \":with-research\" in command_flags:\n.skilled/commands/speckit/README.txt:82:| **plan** | `/speckit:plan <feature-description> [:auto\\|:confirm\\|:autopilot\\|:unattended\\|--unattended] [:with-context] [:with-phases] [--level=N]` | 7 | Create spec folder and plan without implementation. `:with-phases` adds phase decomposition pre-workflow |\n.skilled/commands/speckit/README.txt:88:| **complete** | `/speckit:complete <feature-description> [:auto\\|:confirm\\|:autopilot\\|:unattended\\|--unattended] [:with-research] [:with-context] [:with-phases]` | 13 | Full end-to-end workflow combining all phases. `:with-phases` adds phase decomposition pre-workflow |\n.skilled/commands/speckit/README.txt:250:| `:with-research` | Runs the research pass before planning |\n.skilled/commands/speckit/README.txt:251:| `:with-context` | Loads a context package before planning |\n.skilled/commands/speckit/README.txt:252:| `:with-phases` | Decomposes the packet into phase children and plans the first one |\n.skilled/commands/speckit/README.txt:282:/speckit:plan \"Build hybrid RAG search system\" :auto :with-phases --phases 3\n.skilled/commands/speckit/README.txt:300:/speckit:complete \"Add WebSocket support\" :auto :with-research\n.skilled/commands/speckit/README.txt:390:**Q: How does `:with-phases` relate to the parent spec folder?**\n.skilled/commands/speckit/README.txt:392:The `:with-phases` flag on `/speckit:plan` or `/speckit:complete` creates a parent spec folder and one or more child phase folders under it (e.g., `specs/015-feature/001-phase/`, `specs/015-feature/002-phase/`). Each phase is a self-contained spec folder with its own spec.md, plan.md and tasks.md. The parent folder holds the top-level spec.md and coordinates the phases. Use `:with-phases` for work that is too large for a single spec folder or that has clearly sequential milestones.\n.skilled/commands/speckit/plan.md:3:argument-hint: \"<feature-description> [:auto|:confirm|:autopilot|:unattended|--unattended] [:with-context] [:with-phases] [--level=N]\"\n.skilled/commands/speckit/plan.md:33:2. Treat `:with-context`, `:with-phases`, `--intake-only`, `--phases`, `--phase-names`, `--phase-folder`, `--spec-folder`, `--level`, `--start-state`, `--repair-mode`, and relationship flags as workflow inputs, not execution modes.\n.skilled/commands/speckit/plan.md:46:| `:with-context` | no value | Loads a context package before planning. |\n.skilled/commands/speckit/plan.md:47:| `:with-phases` | no value | Decomposes the packet into phase children and plans the first one. |\n.skilled/commands/speckit/complete.md:3:argument-hint: \"<feature-description> [:auto|:confirm|:autopilot|:unattended|--unattended] [:with-research] [:with-context] [:with-phases]\"\n.skilled/commands/speckit/complete.md:33:2. Treat `:with-research`, `:with-context`, `:with-phases`, `--phases`, `--phase-names`, and `--phase-folder` as workflow inputs, not execution modes.\n.skilled/commands/speckit/complete.md:46:| `:with-research` | no value | Runs the research pass before planning. |\n.skilled/commands/speckit/complete.md:47:| `:with-context` | no value | Loads a context package before planning. |\n.skilled/commands/speckit/complete.md:48:| `:with-phases` | no value | Decomposes the packet into phase children and plans the first one. |\nspecs/hooks-plugins-extensions/decision-capture/001-decision-capture/review/lineages/luna/logs/fanout-lineage.err:1327:    - Suggest `/speckit:plan :with-phases` only when phase complexity score >= 25 AND documentation level >= 3.\n.skilled/skills/system-spec-kit/SKILL.md:216:    - Suggest `/speckit:plan :with-phases` only when phase complexity score >= 25 AND documentation level >= 3.\n.skilled/skills/system-spec-kit/README.md:365:| `:with-phases` | phase decomposition mode on planning or completion flows |\n.skilled/skills/system-spec-kit/README.md:366:| `:with-research` | dispatch deep research before verification, `/speckit:complete` only |\n.skilled/skills/system-spec-kit/ROUTER.md:45:- **PHASE** — \"phase\", \"decompose\", \"split\", \"workstream\", \"multi-phase\", \"phased approach\", \"phased\" and \"multi-session\" requests, and the `/speckit:plan :with-phases` boost, load `references/structure/phase-definitions.md`, `references/structure/sub-folder-versioning.md`, `references/validation/phase-checklists.md` and `references/structure/phase-system.md`.\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"README.md:93:This creates a spec folder, plans the work, builds it and saves the session context as it goes. Add `:with-research` to research before planning. In a later session, `/speckit:resume` picks up where the last one stopped. The [Runtimes](#10--runtimes-and-cli-bridges) table shows how each runtime spells the command.\n.skilled/commands/README.txt:190:| Plan | `/speckit:plan <description> [--intake-only] [:with-phases]` | Planning workflow (spec through plan only). `--intake-only` publishes just `spec.md`, `description.json` and `graph-metadata.json`. `:with-phases` adds phase decomposition |\n.skilled/commands/README.txt:230:/speckit:complete \"New feature\" :with-research\n.skilled/commands/README.txt:251:- `:with-research` adds a research phase before planning\n.skilled/commands/speckit/assets/speckit-plan.yaml:269:      - { id: spec_path_valid, from: step_0.5_intake_branch, criteria: \"On the single-packet path the spec folder exists, because the intake Emit phase created it. Under :with-phases only a well-formed path is required, because P3 creates the folder after Step 1.\" }\n.skilled/commands/speckit/assets/speckit-plan.yaml:324:    with_phases_rule: \"Under :with-phases, skip the Emit phase of the intake contract. P3 of phase_decomposition creates the parent and child folders after Step 1, so intake binds its fields and writes no folder.\"\n.skilled/commands/speckit/assets/speckit-plan-presentation.txt:71:Feature flags: [with-context yes/no] [with-phases yes/no] [intake-only yes/no]\n.skilled/commands/speckit/assets/speckit-lifecycle-shared.yaml:117:    flag: \":with-phases\"\n.skilled/commands/speckit/assets/speckit-complete-presentation.txt:69:Feature flags: [with-research yes/no] [with-context yes/no] [with-phases yes/no]\n.skilled/commands/speckit/assets/speckit-complete.yaml:55:    - :with-research - Run research phase before planning\n.skilled/commands/speckit/assets/speckit-complete.yaml:110:      flag: \":with-research\"\n.skilled/commands/speckit/assets/speckit-complete.yaml:279:    available_at_step: \"Phase 3 (if :with-research OR confidence < 40%)\"\n.skilled/commands/speckit/assets/speckit-complete.yaml:280:    condition: \"ONLY dispatch when :with-research flag is set OR confidence < 40% during planning\"\n.skilled/commands/speckit/assets/speckit-complete.yaml:333:      - { id: spec_path_valid, from: step_0.5_intake_branch, criteria: \"On the single-packet path the spec folder exists, because the intake Emit phase created it. Under :with-phases only a well-formed path is required, because P3 creates the folder after Step 1.\" }\n.skilled/commands/speckit/assets/speckit-complete.yaml:459:    with_phases_rule: \"Under :with-phases, skip the Emit phase of the intake contract. P3 of phase_decomposition creates the parent and child folders after Step 1, so intake binds its fields and writes no folder.\"\n.skilled/commands/speckit/assets/speckit-complete.yaml:527:    - Verify the spec folder exists. The intake Emit phase creates it, or P3 does under :with-phases\n.skilled/commands/speckit/assets/speckit-complete.yaml:567:      IF \":with-research\" in command_flags:\n.skilled/commands/speckit/README.txt:82:| **plan** | `/speckit:plan <feature-description> [:auto\\|:confirm\\|:autopilot\\|:unattended\\|--unattended] [:with-context] [:with-phases] [--level=N]` | 7 | Create spec folder and plan without implementation. `:with-phases` adds phase decomposition pre-workflow |\n.skilled/commands/speckit/README.txt:88:| **complete** | `/speckit:complete <feature-description> [:auto\\|:confirm\\|:autopilot\\|:unattended\\|--unattended] [:with-research] [:with-context] [:with-phases]` | 13 | Full end-to-end workflow combining all phases. `:with-phases` adds phase decomposition pre-workflow |\n.skilled/commands/speckit/README.txt:250:| `:with-research` | Runs the research pass before planning |\n.skilled/commands/speckit/README.txt:251:| `:with-context` | Loads a context package before planning |\n.skilled/commands/speckit/README.txt:252:| `:with-phases` | Decomposes the packet into phase children and plans the first one |\n.skilled/commands/speckit/README.txt:282:/speckit:plan \"Build hybrid RAG search system\" :auto :with-phases --phases 3\n.skilled/commands/speckit/README.txt:300:/speckit:complete \"Add WebSocket support\" :auto :with-research\n.skilled/commands/speckit/README.txt:390:**Q: How does `:with-phases` relate to the parent spec folder?**\n.skilled/commands/speckit/README.txt:392:The `:with-phases` flag on `/speckit:plan` or `/speckit:complete` creates a parent spec folder and one or more child phase folders under it (e.g., `specs/015-feature/001-phase/`, `specs/015-feature/002-phase/`). Each phase is a self-contained spec folder with its own spec.md, plan.md and tasks.md. The parent folder holds the top-level spec.md and coordinates the phases. Use `:with-phases` for work that is too large for a single spec folder or that has clearly sequential milestones.\n.skilled/commands/speckit/plan.md:3:argument-hint: \"<feature-description> [:auto|:confirm|:autopilot|:unattended|--unattended] [:with-context] [:with-phases] [--level=N]\"\n.skilled/commands/speckit/plan.md:33:2. Treat `:with-context`, `:with-phases`, `--intake-only`, `--phases`, `--phase-names`, `--phase-folder`, `--spec-folder`, `--level`, `--start-state`, `--repair-mode`, and relationship flags as workflow inputs, not execution modes.\n.skilled/commands/speckit/plan.md:46:| `:with-context` | no value | Loads a context package before planning. |\n.skilled/commands/speckit/plan.md:47:| `:with-phases` | no value | Decomposes the packet into phase children and plans the first one. |\n.skilled/commands/speckit/complete.md:3:argument-hint: \"<feature-description> [:auto|:confirm|:autopilot|:unattended|--unattended] [:with-research] [:with-context] [:with-phases]\"\n.skilled/commands/speckit/complete.md:33:2. Treat `:with-research`, `:with-context`, `:with-phases`, `--phases`, `--phase-names`, and `--phase-folder` as workflow inputs, not execution modes.\n.skilled/commands/speckit/complete.md:46:| `:with-research` | no value | Runs the research pass before planning. |\n.skilled/commands/speckit/complete.md:47:| `:with-context` | no value | Loads a context package before planning. |\n.skilled/commands/speckit/complete.md:48:| `:with-phases` | no value | Decomposes the packet into phase children and plans the first one. |\nspecs/hooks-plugins-extensions/decision-capture/001-decision-capture/review/lineages/luna/logs/fanout-lineage.err:1327:    - Suggest `/speckit:plan :with-phases` only when phase complexity score >= 25 AND documentation level >= 3.\n.skilled/skills/system-spec-kit/SKILL.md:216:    - Suggest `/speckit:plan :with-phases` only when phase complexity score >= 25 AND documentation level >= 3.\n.skilled/skills/system-spec-kit/README.md:365:| `:with-phases` | phase decomposition mode on planning or completion flows |\n.skilled/skills/system-spec-kit/README.md:366:| `:with-research` | dispatch deep research before verification, `/speckit:complete` only |\n.skilled/skills/system-spec-kit/ROUTER.md:45:- **PHASE** — \"phase\", \"decompose\", \"split\", \"workstream\", \"multi-phase\", \"phased approach\", \"phased\" and \"multi-session\" requests, and the `/speckit:plan :with-phases` boost, load `references/structure/phase-definitions.md`, `references/structure/sub-folder-versioning.md`, `references/validation/phase-checklists.md` and `references/structure/phase-system.md`.\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"cd /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research && rg -n \\\"with-(context|phases|research)\\\" --glob '!**/command-prompts.jsonl' --glob '!**/holdout-prompts.jsonl' --glob '!**/behaviour-fresh-prompts.jsonl' -g '!**/node_modules/**' | head -40\"}"},"time":{"start":1794836025216,"end":1794836026352}}}}
