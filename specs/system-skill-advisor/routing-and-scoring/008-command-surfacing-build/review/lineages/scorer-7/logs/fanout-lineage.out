ADME.md:135\",\"finalSeverity\":\"P2\",\"findingClass\":\"traceability\",\"id\":\"iter2-P2-old-start-rule-still-stated\",\"scopeProof\":\"The README and the vitest file are both pass-six scoped scorer files, and the contradiction is inside the single README row.\",\"severity\":\"P2\",\"title\":\"The README and the shell-step test still say a bare document read is a start\"}],\"findingsCount\":1,\"findingsNew\":[\"iter2-P2-old-start-rule-still-stated\"],\"findingsSummary\":{\"P0\":0,\"P1\":0,\"P2\":1},\"focus\":\"security and traceability -- holdout hygiene and the docs that describe the start rule\",\"generation\":1,\"graphEvents\":[{\"id\":\"file-readme\",\"kind\":\"FILE\",\"label\":\"routing-accuracy README\",\"type\":\"node\"},{\"id\":\"invariant-one-start-rule\",\"kind\":\"INVARIANT\",\"label\":\"one start rule across printed numbers and docs\",\"type\":\"node\"},{\"id\":\"edge-3\",\"relation\":\"CONTRADICTS\",\"source\":\"file-readme\",\"target\":\"invariant-one-start-rule\",\"type\":\"edge\"}],\"iteration\":2,\"lineageMode\":\"new\",\"mode\":\"review\",\"newFindingsRatio\":0.3333,\"noveltyJustification\":\"Second iteration: one new P2 not present in the registry; weighted new 1 over weighted total 3.\",\"resolved_route\":\"Resolved route: mode=review target_agent=deep-review\",\"run\":\"fanout-scorer-6-1794815529929-dybl7p\",\"sessionId\":\"fanout-scorer-6-1794815529929-dybl7p\",\"status\":\"complete\",\"target_agent\":\"deep-review\",\"timestamp\":\"2026-11-16T08:12:32Z\",\"traceabilityChecks\":{\"results\":[{\"applicable\":true,\"evidence\":[\".skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/score-command-transcripts.mjs:1494-1518\"],\"gateClass\":\"hard\",\"protocolId\":\"spec_code\",\"status\":\"pass\",\"summary\":\"Phase 036 REQ-004 maps to the startState shape return and its cases; REQ-001 holds by construction.\"},{\"applicable\":true,\"evidence\":[\"specs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/036-star