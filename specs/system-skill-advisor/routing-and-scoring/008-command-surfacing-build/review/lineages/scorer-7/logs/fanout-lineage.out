":1},\"ledgerId\":\"deep-review-ledger\",\"eventId\":\"event-bd4220a1-2b56-466d-87e5-d2ae04a31923\",\"eventType\":\"deep-review.ledger.run-initialized\",\"eventVersion\":1,\"streamId\":\"deep-review-ledger\",\"streamSequence\":1,\"committedAt\":\"2026-11-16T12:03:10.523Z\"},\"projectionRefreshed\":true,\"projectionError\":null}\ngateway_exit=0\n       1 specs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/review/lineages/scorer-7/deep-review-state.jsonl\n{\"type\":\"config\",\"topic\":\"Command surfacing review pass seven - scorer lineage (guarded write unsafe verdict, checkout and scratch boundary)\",\"maxIterations\":3,\"generation\":1,\"timestamp\":\"2026-11-16T12:03:10.257Z\"}\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"{\"ok\":true,\"receipt\":{\"ledger_id\":\"deep-review-ledger\",\"sequence\":1,\"event_id\":\"event-bd4220a1-2b56-466d-87e5-d2ae04a31923\",\"event_type\":\"deep-review.ledger.run-initialized\",\"event_version\":1,\"stream_id\":\"deep-review-ledger\",\"stream_sequence\":1,\"committed_at\":\"2026-11-16T12:03:10.523Z\",\"canonicalEventHash\":\"6a988df6296aba26497260e209d5040e8c3113dd12bde9462e707499ff63fdf7\",\"recordHash\":\"0e5bd8c3c5f1f6663f374344ba0c27e7cb254bfcfc62ccb342c327b59421c84b\",\"authorizationRef\":{\"audit_ledger_id\":\"deep-review-audit-ledger\",\"audit_sequence\":2,\"audit_record_hash\":\"757840ceba10bff0a730c1bff899a1de66ede35f6c9d50a2f4df708b62cc7564\",\"decision_id\":\"decision-e7a28bfc-a664-40a2-90fc-62d7e50ace4d\",\"decision_digest\":\"b9fbc9518fbd74cd1752b3cac780c3dbbe070426e1227cf155b1b8dd3391195b\",\"request_digest\":\"8bac8514cb74c49c3e0cfe1d8fdda44ea313eb5cb304113eda2b59cf3a811bf0\",\"policy_digest\":\"883e5d03486b26c23ecdb48a893d8b0db0d8e2e7125e0847705bfd4a2b1a4500\",\"authority_epoch\":1,\"fence_token\":1},\"ledgerId\":\"deep-review-ledger\",\"eventId\":\"event-bd4220a1-2b56-466d-87e5-d2ae04a31923\",\"eventType\":\"deep