e\",\n      \"priorReducedState\"\n    ],\n    \"outputs\": [\n      \"findingsRegistry\",\n      \"dashboardMetrics\",\n      \"strategyUpdates\"\n    ],\n    \"metrics\": [\n      \"dimensionsCovered\",\n      \"findingsBySeverity\",\n      \"openFindings\",\n      \"resolvedFindings\",\n      \"convergenceScore\"\n    ]\n  }\n}\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"ls -R specs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/review/lineages/scorer-6 | head -40; echo '=== config'; cat specs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/review/lineages/scorer-6/deep-review-config.json\"}"},"time":{"start":1794830048012,"end":1794830049977}}}}
