'--output': 'output',\n  '--dashboard': 'dashboard',\n  '--stop-reason': 'stopReason',\n  '--answered-count': 'answeredCount',\n  '--total-questions': 'totalQuestions',\n  '--active-p0': 'activeP0',\n  '--active-p1': 'activeP1',\n  '--active-p2': 'activeP2',\n  '--dimension-coverage': 'dimensionCoverage',\n  '--verdict': 'verdict',\n  '--release-readiness-state': 'releaseReadinessState',\n});\n245:// A single-executor review reads one registry, so the counts it reports and the\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\": \"cd /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research && sed -n '1,60p' .skilled/skills/system-deep-loop/runtime/scripts/synthesis-closeout.cjs; grep -n \\\"review-report\\\\|report\\\" .skilled/skills/system-deep-loop/runtime/scripts/synthesis-closeout.cjs | head\"}"},"time":{"start":1794830882738,"end":1794830882867}}}}
