 to pass when the packet is validated at the merge.\n114-\n115-## 8. Deferred Items\n=== sections\n5:## 1. Executive Summary\n19:## 2. Planning Trigger\n54:## 3. Active Finding Registry\n65:## 4. Remediation Workstreams\n78:## 5. Spec Seed\n86:## 6. Plan Seed\n93:## 7. Traceability Status\n115:## 8. Deferred Items\n121:## Dimension Expansion Map\n130:## 9. Search Ledger\n142:## 10. Audit Appendix\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\": \"cd /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research && grep -n \\\"AC_COVERAGE\\\" -B2 -A4 specs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/review/lineages/scorer-6/review-report.md | head -30; echo '=== sections'; grep -n \\\"^## \\\" specs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/review/lineages/scorer-6/review-report.md\"}"},"time":{"start":1794830967377,"end":1794830967589}}}}
