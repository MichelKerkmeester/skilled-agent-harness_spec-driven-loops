\\"specs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/spec.md:120\\\",title:\\\"The packet phase map leaves the per-runtime behaviour proof open while marking later phases complete\\\",iteration:3});\\nrows.push({type:\\\"classification\\\",detail:\\\"D3 traceability: 2 P2 (README exit-3 gap, phase 007 open evidence). All four packet floors verified. No P1/P0 new.\\\",iteration:3});\\nrows.push({type:\\\"traceability_check\\\",protocol:\\\"spec_code\\\",status:\\\"pass\\\",iteration:3,detail:\\\"typed 44/44, plain tune 23/45, false offers 0/35, holdout 1/44\\\"});\\nrows.push({type:\\\"traceability_check\\\",protocol:\\\"checklist_evidence\\\",status:\\\"partial\\\",iteration:3,detail:\\\"owning phase 007 closing tasks open\\\"});\\nrows.push({type:\\\"traceability_check\\\",protocol:\\\"playbook_capability\\\",status:\\\"pass\\\",iteration:3,detail:\\\"NC-011 executable, triage symbols resolve\\\"});\\nfor (const ev of record.graphEvents) rows.push({...ev,iteration:3});\\nrows.push({type:\\\"ruled_out\\\",direction:\\\"packet numeric floor mismatch\\\",reason:\\\"all four floors recomputed from the committed baseline and met\\\",iteration:3});\\nrows.push({type:\\\"ruled_out\\\",direction:\\\"NC-011 stale triage symbols\\\",reason:\\\"MODE_COMMANDS, DEPTH_WORDING and the save owner row resolve\\\",iteration:3});\\nfs.writeFileSync(dir+\\\"/deltas/iter-003.jsonl\\\",rows.map(r=>JSON.stringify(r)).join(\\\"\\\\n\\\")+\\\"\\\\n\\\",\\\"utf8\\\");\\nconsole.log(\\\"rows\\\",rows.length);\\n' && node .skilled/skills/system-deep-loop/runtime/scripts/reduce-state.cjs specs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build --artifact-dir specs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/review/lineages/accuracy-runner --create-missing-anchors; echo \\\"EXIT=$?\\\"\"}"},"time":{"start":1794551542468,"end":1794551546981}}}}
