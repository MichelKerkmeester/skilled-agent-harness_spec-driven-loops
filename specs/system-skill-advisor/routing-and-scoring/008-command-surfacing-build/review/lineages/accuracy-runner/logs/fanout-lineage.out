{"type":"tool_use","timestamp":1794550713631,"sessionID":"ses_e2c799a7bffe903YpgFMcmoKDC","part":{"partID":"prt_1d38ec85d001lfVnoMAZCN6V1K","sessionID":"ses_e2c799a7bffe903YpgFMcmoKDC","messageID":"msg_1d38e96cf001eJ10jIerRpg3DO","type":"tool","id":"call_0b088068835745c0bead12ef","tool":"read","state":{"status":"completed","input":{"path":".skilled/skills/system-skill-advisor/runtime/tests/command-routing-slice.vitest.ts"},"output":"Read file .skilled/skills/system-skill-advisor/runtime/tests/command-routing-slice.vitest.ts, lines 1-141\n1: // ───────────────────────────────────────────────────────────────\n2: // MODULE: Command Routing Slice\n3: // ───────────────────────────────────────────────────────────────\n4: \n5: // Ratchets live command routing against the committed capture. An aggregate can\n6: // hold still while one row is gained and another lost, so the rows are compared\n7: // one by one and the corpus hash pins the prompts the capture was measured\n8: // against: a scoring change, a bridge-metadata change or a corpus edit has to\n9: // surface here instead of drifting in silently.\n10: \n11: import { readFileSync } from 'node:fs';\n12: import { dirname, join, resolve } from 'node:path';\n13: import { fileURLToPath } from 'node:url';\n14: \n15: import { beforeAll, describe, expect, it } from 'vitest';\n16: import { scoreCommandCorpus as captureCommandCorpus } from '../scripts/routing-accuracy/capture-command-routing-baseline.mjs';\n17: \n18: const HERE = dirname(fileURLToPath(import.meta.url));\n19: const ROUTING = resolve(HERE, '../scripts/routing-accuracy');\n20: const CORPUS_PATH = join(ROUTING, 'command-prompts.jsonl');\n21: const BASELINE_PATH = join(ROUTING, 'command-routing-baseline.json');\n22: const RECAPTURE = 'node scripts/routing-accuracy/capture-command-routing-baseline.mjs --write';\n23: \n24: interface CorpusRow {\n25:   readonly id: string;\n26:   readonly row_type: string;\n27:   readonly split: string;\n28: }\n29: \n30: interface SplitTally {\n31:   readonly rows: number;\n32:   readonly top1: number;\n33:   readonly top3: number;\n34: }\n35: \n36: interface CommandTally {\n37:   readonly typed: SplitTally;\n38:   readonly plain: { readonly tune: SplitTally; readonly holdout: SplitTally };\n39: }\n40: \n41: interface CommandRow {\n42:   readonly expected_command: string | null;\n43:   readonly top: string | null;\n44:   readonly top1: boolean;\n45:   readonly top3: boolean;\n46:   readonly offered: boolean;\n47: }\n48: \n49: interface CommandRoutingBaseline {\n50:   readonly schemaVersion: number;\n51:   readonly capturedAt: string;\n52:   readonly capturedAtSha: string;\n53:   readonly corpusSha256: string;\n54:   readonly bridgeCounts: Readonly<Record<string, number>>;\n55:   readonly metrics: Readonly<Record<string, unknown>>;\n56:   readonly unreachable: readonly string[];\n57:   readonly commands: Readonly<Record<string, CommandTally>>;\n58:   readonly rows: Readonly<Record<string, CommandRow>>;\n59:   readonly attachedMetrics: Readonly<Record<string, unknown>>;\n60: }\n61: \n62: // The capture script is plain JavaScript with no declaration file of its own, so\n63: // the shape it returns is declared here and the import is cast to that shape\n64: // rather than left implicitly `any` at every call site.\n65: const scoreCommandCorpus = captureCommandCorpus as unknown as () => Promise<CommandRoutingBaseline>;\n66: \n67: function readJsonl<T>(path: string): T[] {\n68:   return readFileSync(path, 'utf8').trim().split('\\n').filter(Boolean).map((line) => JSON.parse(line) as T);\n69: }\n70: \n71: // A row that vanished from one side has no JSON to print, and an absent row is\n72: // exactly the drift worth naming, so it is labelled instead of rendered empty.\n73: function rowJson(rows: Readonly<Record<string, CommandRow>>, id: string): string {\n74:   return Object.hasOwn(rows, id) ? JSON.stringify(rows[id]) : '<missing>';\n75: }\n76: \n77: let live: CommandRoutingBaseline;\n78: let baseline: CommandRoutingBaseline;\n79: let corpus: CorpusRow[] = [];\n80: \n81: describe('command routing slice', () => {\n82:   beforeAll(async () => {\n83:     baseline = JSON.parse(readFileSync(BASELINE_PATH, 'utf8')) as CommandRoutingBaseline;\n84:     corpus = readJsonl<CorpusRow>(CORPUS_PATH);\n85:     // The capture owns its own environment projection and scoring clock, so it\n86:     // re-scores under the same regime the baseline was recorded in. Doing that\n87:     // setup again here would double it and let the two drift apart.\n88:     live = await scoreCommandCorpus();\n89:   }, 120_000);\n90: \n91:   it('matches the captured baseline row by row', () => {\n92:     // Corpus ids come first because a prompt added to the corpus but never\n93:     // captured is absent from both sides and would be invisible to a comparison\n94:     // of the two row maps alone.\n95:     const ids = [\n96:       ...new Set([...corpus.map((row) => row.id), ...Object.keys(baseline.rows), ...Object.keys(live.rows)]),\n97:     ];\n98:     const drifted: string[] = [];\n99:     for (const id of ids) {\n100:       const baselineJson = rowJson(baseline.rows, id);\n101:       const liveJson = rowJson(live.rows, id);\n102:       if (baselineJson !== liveJson) drifted.push(`${id}: baseline ${baselineJson} live ${liveJson}`);\n103:     }\n104:     expect(\n105:       drifted,\n106:       `command routing rows drifted from the committed baseline; re-capture with \\`${RECAPTURE}\\` when the change is intended`,\n107:     ).toEqual([]);\n108:   });\n109: \n110:   it('matches the captured totals', () => {\n111:     expect(live.metrics).toEqual(baseline.metrics);\n112:     expect(live.unreachable).toEqual(baseline.unreachable);\n113:     // `capturedAtSha` is deliberately not compared: it names the commit of the\n114:     // checkout that ran the capture, not anything the scorer decided.\n115:     expect(live.commands).toEqual(baseline.commands);\n116:     // The attached keys sit outside `metrics` and `commands` by design: they\n117:     // measure what a hub's own compiled route adds on the same rows, kept apart\n118:     // so the bridge numbers above cannot absorb a row the route reached.\n119:     expect(\n120:       live.attachedMetrics,\n121:       `command routing attached reach drifted from the committed baseline; re-capture with \\`${RECAPTURE}\\` when the change is intended`,\n122:     ).toEqual(baseline.attachedMetrics);\n123:   });\n124: \n125:   it('pins the corpus the baseline was captured against', () => {\n126:     // Row comparison can only catch a prompt that stopped routing as expected.\n127:     // The corpus hash catches the other direction: an edited, added or removed\n128:     // prompt that leaves every surviving row untouched.\n129:     expect(live.corpusSha256).toBe(baseline.corpusSha256);\n130:   });\n131: \n132:   it('has a typed row and both plain splits for every command file', () => {\n133:     // A command with an empty split carries no evidence either way, so its\n134:     // recall reads as a pass while the corpus never exercised it.\n135:     const uncovered = Object.keys(live.commands).filter((command) => {\n136:       const tally = live.commands[command];\n137:       return tally.typed.rows < 1 || tally.plain.tune.rows < 1 || tally.plain.holdout.rows < 1;\n138:     });\n139:     expect(uncovered).toEqual([]);\n140:   });\n141: });","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file .skilled/skills/system-skill-advisor/runtime/tests/command-routing-slice.vitest.ts, lines 1-141\n1: // ───────────────────────────────────────────────────────────────\n2: // MODULE: Command Routing Slice\n3: // ───────────────────────────────────────────────────────────────\n4: \n5: // Ratchets live command routing against the committed capture. An aggregate can\n6: // hold still while one row is gained and another lost, so the rows are compared\n7: // one by one and the corpus hash pins the prompts the capture was measured\n8: // against: a scoring change, a bridge-metadata change or a corpus edit has to\n9: // surface here instead of drifting in silently.\n10: \n11: import { readFileSync } from 'node:fs';\n12: import { dirname, join, resolve } from 'node:path';\n13: import { fileURLToPath } from 'node:url';\n14: \n15: import { beforeAll, describe, expect, it } from 'vitest';\n16: import { scoreCommandCorpus as captureCommandCorpus } from '../scripts/routing-accuracy/capture-command-routing-baseline.mjs';\n17: \n18: const HERE = dirname(fileURLToPath(import.meta.url));\n19: const ROUTING = resolve(HERE, '../scripts/routing-accuracy');\n20: const CORPUS_PATH = join(ROUTING, 'command-prompts.jsonl');\n21: const BASELINE_PATH = join(ROUTING, 'command-routing-baseline.json');\n22: const RECAPTURE = 'node scripts/routing-accuracy/capture-command-routing-baseline.mjs --write';\n23: \n24: interface CorpusRow {\n25:   readonly id: string;\n26:   readonly row_type: string;\n27:   readonly split: string;\n28: }\n29: \n30: interface SplitTally {\n31:   readonly rows: number;\n32:   readonly top1: number;\n33:   readonly top3: number;\n34: }\n35: \n36: interface CommandTally {\n37:   readonly typed: SplitTally;\n38:   readonly plain: { readonly tune: SplitTally; readonly holdout: SplitTally };\n39: }\n40: \n41: interface CommandRow {\n42:   readonly expected_command: string | null;\n43:   readonly top: string | null;\n44:   readonly top1: boolean;\n45:   readonly top3: boolean;\n46:   readonly offered: boolean;\n47: }\n48: \n49: interface CommandRoutingBaseline {\n50:   readonly schemaVersion: number;\n51:   readonly capturedAt: string;\n52:   readonly capturedAtSha: string;\n53:   readonly corpusSha256: string;\n54:   readonly bridgeCounts: Readonly<Record<string, number>>;\n55:   readonly metrics: Readonly<Record<string, unknown>>;\n56:   readonly unreachable: readonly string[];\n57:   readonly commands: Readonly<Record<string, CommandTally>>;\n58:   readonly rows: Readonly<Record<string, CommandRow>>;\n59:   readonly attachedMetrics: Readonly<Record<string, unknown>>;\n60: }\n61: \n62: // The capture script is plain JavaScript with no declaration file of its own, so\n63: // the shape it returns is declared here and the import is cast to that shape\n64: // rather than left implicitly `any` at every call site.\n65: const scoreCommandCorpus = captureCommandCorpus as unknown as () => Promise<CommandRoutingBaseline>;\n66: \n67: function readJsonl<T>(path: string): T[] {\n68:   return readFileSync(path, 'utf8').trim().split('\\n').filter(Boolean).map((line) => JSON.parse(line) as T);\n69: }\n70: \n71: // A row that vanished from one side has no JSON to print, and an absent row is\n72: // exactly the drift worth naming, so it is labelled instead of rendered empty.\n73: function rowJson(rows: Readonly<Record<string, CommandRow>>, id: string): string {\n74:   return Object.hasOwn(rows, id) ? JSON.stringify(rows[id]) : '<missing>';\n75: }\n76: \n77: let live: CommandRoutingBaseline;\n78: let baseline: CommandRoutingBaseline;\n79: let corpus: CorpusRow[] = [];\n80: \n81: describe('command routing slice', () => {\n82:   beforeAll(async () => {\n83:     baseline = JSON.parse(readFileSync(BASELINE_PATH, 'utf8')) as CommandRoutingBaseline;\n84:     corpus = readJsonl<CorpusRow>(CORPUS_PATH);\n85:     // The capture owns its own environment projection and scoring clock, so it\n86:     // re-scores under the same regime the baseline was recorded in. Doing that\n87:     // setup again here would double it and let the two drift apart.\n88:     live = await scoreCommandCorpus();\n89:   }, 120_000);\n90: \n91:   it('matches the captured baseline row by row', () => {\n92:     // Corpus ids come first because a prompt added to the corpus but never\n93:     // captured is absent from both sides and would be invisible to a comparison\n94:     // of the two row maps alone.\n95:     const ids = [\n96:       ...new Set([...corpus.map((row) => row.id), ...Object.keys(baseline.rows), ...Object.keys(live.rows)]),\n97:     ];\n98:     const drifted: string[] = [];\n99:     for (const id of ids) {\n100:       const baselineJson = rowJson(baseline.rows, id);\n101:       const liveJson = rowJson(live.rows, id);\n102:       if (baselineJson !== liveJson) drifted.push(`${id}: baseline ${baselineJson} live ${liveJson}`);\n103:     }\n104:     expect(\n105:       drifted,\n106:       `command routing rows drifted from the committed baseline; re-capture with \\`${RECAPTURE}\\` when the change is intended`,\n107:     ).toEqual([]);\n108:   });\n109: \n110:   it('matches the captured totals', () => {\n111:     expect(live.metrics).toEqual(baseline.metrics);\n112:     expect(live.unreachable).toEqual(baseline.unreachable);\n113:     // `capturedAtSha` is deliberately not compared: it names the commit of the\n114:     // checkout that ran the capture, not anything the scorer decided.\n115:     expect(live.commands).toEqual(baseline.commands);\n116:     // The attached keys sit outside `metrics` and `commands` by design: they\n117:     // measure what a hub's own compiled route adds on the same rows, kept apart\n118:     // so the bridge numbers above cannot absorb a row the route reached.\n119:     expect(\n120:       live.attachedMetrics,\n121:       `command routing attached reach drifted from the committed baseline; re-capture with \\`${RECAPTURE}\\` when the change is intended`,\n122:     ).toEqual(baseline.attachedMetrics);\n123:   });\n124: \n125:   it('pins the corpus the baseline was captured against', () => {\n126:     // Row comparison can only catch a prompt that stopped routing as expected.\n127:     // The corpus hash catches the other direction: an edited, added or removed\n128:     // prompt that leaves every surviving row untouched.\n129:     expect(live.corpusSha256).toBe(baseline.corpusSha256);\n130:   });\n131: \n132:   it('has a typed row and both plain splits for every command file', () => {\n133:     // A command with an empty split carries no evidence either way, so its\n134:     // recall reads as a pass while the corpus never exercised it.\n135:     const uncovered = Object.keys(live.commands).filter((command) => {\n136:       const tally = live.commands[command];\n137:       return tally.typed.rows < 1 || tally.plain.tune.rows < 1 || tally.plain.holdout.rows < 1;\n138:     });\n139:     expect(uncovered).toEqual([]);\n140:   });\n141: });"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\".skilled/skills/system-skill-advisor/runtime/tests/command-routing-slice.vitest.ts\"}"},"time":{"start":1794550712413,"end":1794550713631}}}}
{"type":"step_finish","timestamp":1794550716649,"sessionID":"ses_e2c799a7bffe903YpgFMcmoKDC","part":{"id":"prt_1d38ed8e9001vPzkTpeuL1cv50","sessionID":"ses_e2c799a7bffe903YpgFMcmoKDC","messageID":"msg_1d38e96cf001eJ10jIerRpg3DO","type":"step-finish","reason":"tool-calls","snapshot":"0c448ee0d1169fcd316abb997b9781859cfc27a4","cost":0,"tokens":{"input":2819,"output":62,"reasoning":693,"cache":{"read":114816,"write":0}}}}
{"type":"step_start","timestamp":1794550719334,"sessionID":"ses_e2c799a7bffe903YpgFMcmoKDC","part":{"id":"prt_1d38ee366001Vj2Z6f4oEKvXZn","sessionID":"ses_e2c799a7bffe903YpgFMcmoKDC","messageID":"msg_1d38ed8f0001KrWbUQJ7bxm0G5","type":"step-start","snapshot":"0c448ee0d1169fcd316abb997b9781859cfc27a4"}}
{"type":"tool_use","timestamp":1794550723511,"sessionID":"ses_e2c799a7bffe903YpgFMcmoKDC","part":{"partID":"prt_1d38ef28d001JDVEDIK1tRxZkj","sessionID":"ses_e2c799a7bffe903YpgFMcmoKDC","messageID":"msg_1d38ed8f0001KrWbUQJ7bxm0G5","type":"tool","id":"call_f8357770aa3341bbb70be1b1","tool":"read","state":{"status":"completed","input":{"limit":120,"path":".skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/prepare-behaviour-arena.mjs"},"output":"Read file .skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/prepare-behaviour-arena.mjs, lines 1-120\n1: // ───────────────────────────────────────────────────────────────\n2: // MODULE: Behaviour Arena Builder\n3: // ───────────────────────────────────────────────────────────────\n4: //\n5: // A live turn has to run where it cannot reach anything outside its own\n6: // checkout, and where the advisor it measures is built the way a user gets it.\n7: // A clone of the branch tip in a directory git does not own gives both. The\n8: // clone has no remote to push to and no outer repository whose hooks or\n9: // credentials it could borrow, and its tracked tree is exactly the commit under\n10: // test, so a per-turn restore has a clean baseline to put back.\n11: //\n12: // A clone also leaves out every ignored build output. The advisor under test\n13: // runs from compiled JavaScript and its SQLite skill graph, so those trees are\n14: // copied in afterwards. Building them inside the clone instead would measure a\n15: // bundle nobody reviewed, and would need the network while an arena is meant to\n16: // be offline.\n17: //\n18: // A copy also has to look like a build. The freshness guard each CLI shim runs\n19: // falls back to comparing the newest watched source against the build's own\n20: // timestamp, and a checkout stamps every source with the clone time while the\n21: // copied build keeps the moment it was compiled. Left alone, that order says\n22: // every copied package is stale and every shim exits before running. The copied\n23: // build is the same commit's build, so its timestamp is set to the copy time,\n24: // which is what a build in this checkout would carry.\n25: //\n26: // Nothing is copied before the destination is checked. A destination inside a\n27: // repository would inherit that repository's hooks and ignore rules, and a\n28: // destination that already exists may hold another arm's log, so both are\n29: // refused rather than merged into.\n30: //\n31: // The copy reads the source worktree, so the one thing it must never carry\n32: // across is a dotenv file. A model reads and writes an arena, so a secret that\n33: // followed the build output in would sit where a run can print it. Every file\n34: // whose name begins with `.env` is skipped while copying, at every depth.\n35: //\n36: // Usage:\n37: //   node prepare-behaviour-arena.mjs --source <repo root> --dest <dir>\n38: \n39: // ───────────────────────────────────────────────────────────────\n40: // 1. IMPORTS\n41: // ───────────────────────────────────────────────────────────────\n42: \n43: import { existsSync, lstatSync, lutimesSync, mkdirSync, readdirSync, rmSync, utimesSync } from 'node:fs';\n44: import { spawnSync } from 'node:child_process';\n45: import { basename, dirname, join, resolve } from 'node:path';\n46: import { fileURLToPath } from 'node:url';\n47: \n48: // ───────────────────────────────────────────────────────────────\n49: // 2. CONSTANTS\n50: // ───────────────────────────────────────────────────────────────\n51: \n52: const SCRIPT_NAME = basename(fileURLToPath(import.meta.url));\n53: const EXIT_REFUSED = 2;\n54: \n55: const USAGE = `usage: node ${SCRIPT_NAME} --source <repo root> --dest <dir>`;\n56: \n57: // A filesystem monitor that decides a path is unchanged makes the clone and the\n58: // clean-tree check disagree about what the checkout holds.\n59: const GIT_PREFIX = ['-c', 'core.fsmonitor=false'];\n60: \n61: // The two ignored trees a build writes and a clone never carries.\n62: const BUILD_DIR_NAMES = new Set(['dist', 'node_modules']);\n63: \n64: const SQLITE_SUFFIX = '.sqlite';\n65: const SKILLED_PREFIX = '.skilled/';\n66: const DOTENV_PATTERN = /^\\.env/;\n67: \n68: // ───────────────────────────────────────────────────────────────\n69: // 3. FAILURE SHAPES\n70: // ───────────────────────────────────────────────────────────────\n71: \n72: // A refusal is a precondition the caller can act on, so it carries a code on\n73: // stdout. A step failure leaves no usable arena behind, so it reports the code\n74: // and the failing command on stderr instead.\n75: class StepFailure extends Error {\n76:   constructor(code, detail) {\n77:     super(detail === '' ? code : `${code}: ${detail}`);\n78:     this.code = code;\n79:   }\n80: }\n81: \n82: function writeJson(value) {\n83:   process.stdout.write(`${JSON.stringify(value)}\\n`);\n84: }\n85: \n86: function refuse(code, extra = {}) {\n87:   writeJson({ ok: false, code, ...extra });\n88:   process.exit(EXIT_REFUSED);\n89: }\n90: \n91: function abort(code, detail = '') {\n92:   process.stderr.write(`${SCRIPT_NAME}: ${detail === '' ? code : `${code}: ${detail}`}\\n`);\n93:   writeJson({ ok: false, code });\n94:   process.exit(1);\n95: }\n96: \n97: // ───────────────────────────────────────────────────────────────\n98: // 4. ARGUMENT PARSING\n99: // ───────────────────────────────────────────────────────────────\n100: \n101: function valueAfter(argv, index, flag) {\n102:   const value = argv[index];\n103:   if (value === undefined || value.startsWith('--')) {\n104:     process.stderr.write(`${SCRIPT_NAME}: ${flag} needs a value\\n${USAGE}\\n`);\n105:     process.exit(EXIT_REFUSED);\n106:   }\n107:   return value;\n108: }\n109: \n110: function parseOptions(argv) {\n111:   const options = { source: null, dest: null };\n112:   for (let index = 0; index < argv.length; index += 1) {\n113:     const token = argv[index];\n114:     if (token === '--source') {\n115:       index += 1;\n116:       options.source = valueAfter(argv, index, '--source');\n117:     } else if (token === '--dest') {\n118:       index += 1;\n119:       options.dest = valueAfter(argv, index, '--dest');\n120:     } else {\n[Output truncated. Continue reading with offset: 121]","title":"read","metadata":{"metadata":{"truncated":true},"content":[{"type":"text","text":"Read file .skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/prepare-behaviour-arena.mjs, lines 1-120\n1: // ───────────────────────────────────────────────────────────────\n2: // MODULE: Behaviour Arena Builder\n3: // ───────────────────────────────────────────────────────────────\n4: //\n5: // A live turn has to run where it cannot reach anything outside its own\n6: // checkout, and where the advisor it measures is built the way a user gets it.\n7: // A clone of the branch tip in a directory git does not own gives both. The\n8: // clone has no remote to push to and no outer repository whose hooks or\n9: // credentials it could borrow, and its tracked tree is exactly the commit under\n10: // test, so a per-turn restore has a clean baseline to put back.\n11: //\n12: // A clone also leaves out every ignored build output. The advisor under test\n13: // runs from compiled JavaScript and its SQLite skill graph, so those trees are\n14: // copied in afterwards. Building them inside the clone instead would measure a\n15: // bundle nobody reviewed, and would need the network while an arena is meant to\n16: // be offline.\n17: //\n18: // A copy also has to look like a build. The freshness guard each CLI shim runs\n19: // falls back to comparing the newest watched source against the build's own\n20: // timestamp, and a checkout stamps every source with the clone time while the\n21: // copied build keeps the moment it was compiled. Left alone, that order says\n22: // every copied package is stale and every shim exits before running. The copied\n23: // build is the same commit's build, so its timestamp is set to the copy time,\n24: // which is what a build in this checkout would carry.\n25: //\n26: // Nothing is copied before the destination is checked. A destination inside a\n27: // repository would inherit that repository's hooks and ignore rules, and a\n28: // destination that already exists may hold another arm's log, so both are\n29: // refused rather than merged into.\n30: //\n31: // The copy reads the source worktree, so the one thing it must never carry\n32: // across is a dotenv file. A model reads and writes an arena, so a secret that\n33: // followed the build output in would sit where a run can print it. Every file\n34: // whose name begins with `.env` is skipped while copying, at every depth.\n35: //\n36: // Usage:\n37: //   node prepare-behaviour-arena.mjs --source <repo root> --dest <dir>\n38: \n39: // ───────────────────────────────────────────────────────────────\n40: // 1. IMPORTS\n41: // ───────────────────────────────────────────────────────────────\n42: \n43: import { existsSync, lstatSync, lutimesSync, mkdirSync, readdirSync, rmSync, utimesSync } from 'node:fs';\n44: import { spawnSync } from 'node:child_process';\n45: import { basename, dirname, join, resolve } from 'node:path';\n46: import { fileURLToPath } from 'node:url';\n47: \n48: // ───────────────────────────────────────────────────────────────\n49: // 2. CONSTANTS\n50: // ───────────────────────────────────────────────────────────────\n51: \n52: const SCRIPT_NAME = basename(fileURLToPath(import.meta.url));\n53: const EXIT_REFUSED = 2;\n54: \n55: const USAGE = `usage: node ${SCRIPT_NAME} --source <repo root> --dest <dir>`;\n56: \n57: // A filesystem monitor that decides a path is unchanged makes the clone and the\n58: // clean-tree check disagree about what the checkout holds.\n59: const GIT_PREFIX = ['-c', 'core.fsmonitor=false'];\n60: \n61: // The two ignored trees a build writes and a clone never carries.\n62: const BUILD_DIR_NAMES = new Set(['dist', 'node_modules']);\n63: \n64: const SQLITE_SUFFIX = '.sqlite';\n65: const SKILLED_PREFIX = '.skilled/';\n66: const DOTENV_PATTERN = /^\\.env/;\n67: \n68: // ───────────────────────────────────────────────────────────────\n69: // 3. FAILURE SHAPES\n70: // ───────────────────────────────────────────────────────────────\n71: \n72: // A refusal is a precondition the caller can act on, so it carries a code on\n73: // stdout. A step failure leaves no usable arena behind, so it reports the code\n74: // and the failing command on stderr instead.\n75: class StepFailure extends Error {\n76:   constructor(code, detail) {\n77:     super(detail === '' ? code : `${code}: ${detail}`);\n78:     this.code = code;\n79:   }\n80: }\n81: \n82: function writeJson(value) {\n83:   process.stdout.write(`${JSON.stringify(value)}\\n`);\n84: }\n85: \n86: function refuse(code, extra = {}) {\n87:   writeJson({ ok: false, code, ...extra });\n88:   process.exit(EXIT_REFUSED);\n89: }\n90: \n91: function abort(code, detail = '') {\n92:   process.stderr.write(`${SCRIPT_NAME}: ${detail === '' ? code : `${code}: ${detail}`}\\n`);\n93:   writeJson({ ok: false, code });\n94:   process.exit(1);\n95: }\n96: \n97: // ───────────────────────────────────────────────────────────────\n98: // 4. ARGUMENT PARSING\n99: // ───────────────────────────────────────────────────────────────\n100: \n101: function valueAfter(argv, index, flag) {\n102:   const value = argv[index];\n103:   if (value === undefined || value.startsWith('--')) {\n104:     process.stderr.write(`${SCRIPT_NAME}: ${flag} needs a value\\n${USAGE}\\n`);\n105:     process.exit(EXIT_REFUSED);\n106:   }\n107:   return value;\n108: }\n109: \n110: function parseOptions(argv) {\n111:   const options = { source: null, dest: null };\n112:   for (let index = 0; index < argv.length; index += 1) {\n113:     const token = argv[index];\n114:     if (token === '--source') {\n115:       index += 1;\n116:       options.source = valueAfter(argv, index, '--source');\n117:     } else if (token === '-