nique per source (per-iteration counters, parallel\n956:     // dispatch) -- two genuinely distinct findings can reuse the same id.\n957:     // Merging on id alone would silently discard the second finding's own\n958:     // content, so only fold into `existing` when the content itself matches;\n959:     // otherwise keep it under a disambiguated key so both survive.\n960:     const isSameFinding = !existing || findingDedupKey(existing) === findingDedupKey(finding);\n961:     if (!isSameFinding || !existing) {\n962:       const storageKey = isSameFinding ? finding.findingId : `${finding.findingId}#${findingById.size}`;\n963:       findingById.set(storageKey, {\n964:         ...finding,\n965:         severity: canonicalSeverity,\n966:         dimension: deriveDimension(\n967:           { ...finding, severity: canonicalSeverity },\n968:           iteration,\n969:         ),\n970:         firstSeen: run,\n971:         lastSeen: run,\n972:         status: 'active',\n973:         transitions: mergeTransitions(\n974:           [{\n975:             iteration: run,\n976:             from: null,\n977:             to: canonicalSeverity,\n978:             reason: initialReason,\n979:           }],\n980:           claimAdjudication?.transitions,\n981:         ),\n982:       });\n983:       return;\n984:     }\n985:     existing.lastSeen = run;\n986:     if (existing.severity !== canonicalSeverity) {\n987:       existing.transitions.push({\n988:         iteration: run,\n989:         from: existing.severity,\n990:         to: canonicalSeverity,\n991:         reason: adjustmentReason,\n992:       });\n993:       existing.severity = canonicalSeverity;\n994:     }\n995:     if (claimAdjudication?.transitions?.length) {\n996:       existing.transitions = mergeTransitions(existing.transitions, claimAdjudication.transitions);\n997:     }\n998:   }\n999: \n1000:   // Structured finding rows are the primary source because they carry exact\n1001:   // severity, status, file evidence, and