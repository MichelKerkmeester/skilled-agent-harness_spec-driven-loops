y = record.finalSeverity || record.severity;\n645:   const severity = normalizeSeverity(rawSeverity);\n646:   if (!severity) {\n647:     return null;\n648:   }\n649:   // Description: claim is most informative; fall back to recommendation/evidence.\n650:   const description = normalizeText(\n651:     record.claim || record.recommendation || record.alternativeExplanation || '',\n652:   );\n653:   return {\n654:     findingId: id,\n655:     severity,\n656:     title: normalizeText(record.title || ''),\n657:     file: fileBase,\n658:     line: lineNumber,\n659:     description,\n660:     findingClass: record.findingClass || null,\n661:     deltaStatus: record.status || null,\n662:     // Preserve structured evidence fields so registry consumers do not need to\n663:     // re-open raw delta files for scope and surface hints.\n664:     scopeProof: typeof record.scopeProof === 'string' ? record.scopeProof : null,\n665:     affectedSurfaceHints: asStringList(record.affectedSurfaceHints),\n666:     // Content hashes let the registry collapse repeated findings across review\n667:     // dimensions; legacy records remain valid without one.\n668:     contentHash: typeof record.content_hash === 'string' && record.content_hash\n669:       ? record.content_hash\n670:       : (typeof record.contentHash === 'string' && record.contentHash ? record.contentHash : null),\n671:   };\n672: }\n673: \n674: function getIterationRun(record) {\n675:   if (!record || typeof record !== 'object') {\n676:     return null;\n677:   }\n678:   if (isFiniteNumber(record.iteration)) {\n679:     return record.iteration;\n680:   }\n681:   if (isFiniteNumber(record.run)) {\n682:     return record.run;\n683:   }\n684:   const runText = normalizeText(record.run || '');\n685:   const runMatch = runText.match(/(\\d+)$/);\n686:   return runMatch ? Number(runMatch[1]) : null;\n687: }\n688: \n689: function normalizeSummaryCounts(record) {\n690:   const summary = record && typeof record === 'object'\n691:     ? g