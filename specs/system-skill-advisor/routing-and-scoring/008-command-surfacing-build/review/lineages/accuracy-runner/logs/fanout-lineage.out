gedPaths.length > 0,\n1205:    unsafe: start.unsafe || loop === false,\n1217:  return { rows: 0, capped: 0, started: 0, wrote: 0 };\n1239:    unsafe: 0,\n1271:    unsafe: tally.unsafe,\n1311:  if (result.unsafe) tally.unsafe += 1;\n1317:  if (result.policy === null) return;\n1323:  if (result.wrote) policy.wrote += 1;\n1402:          + ` COMMAND: line ${block.commandLineRate}, capped ${block.capped}, unsafe ${block.unsafe},`\n1414:            + ` ${policy.started} started, ${policy.wrote} wrote\\n`,\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"cd /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research && grep -n \\\"unsafe\\\\|wrote\\\\|policy ===\\\\|expected_policy === 'run'\\\\|must-not-start\\\" .skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/score-command-transcripts.mjs | head -40\"}"},"time":{"start":1794550689654,"end":1794550690482}}}}
