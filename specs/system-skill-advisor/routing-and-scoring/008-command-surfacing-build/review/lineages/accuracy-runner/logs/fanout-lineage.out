{"type":"tool_use","timestamp":1794551566364,"sessionID":"ses_e2c799a7bffe903YpgFMcmoKDC","part":{"partID":"prt_1d39bcf26002bSrEkLHUgNkSOy","sessionID":"ses_e2c799a7bffe903YpgFMcmoKDC","messageID":"msg_1d39bb7c2001TzMe16C8k3uz29","type":"tool","id":"call_71384cd3255d4caaba8ce490","tool":"read","state":{"status":"completed","input":{"path":".skilled/skills/system-skill-advisor/runtime/tests/parity/holdout-independent.vitest.ts"},"output":"Read file .skilled/skills/system-skill-advisor/runtime/tests/parity/holdout-independent.vitest.ts, lines 1-470\n1: // ───────────────────────────────────────────────────────────────\n2: // MODULE: Independent Holdout Gate\n3: // ───────────────────────────────────────────────────────────────\n4: \n5: // Scores the frozen independent holdout and holds its top-1 accuracy at or\n6: // above the committed baseline. Unlike the every-Nth-row holdout carved from the\n7: // training corpus (retained elsewhere as a legacy secondary signal), this set is\n8: // assembled from three separately-authored, real-labeled fixtures, so it\n9: // measures generalization rather than memorization. No gold is invented: each\n10: // row's label comes from its source fixture, and provenance is asserted per row.\n11: //\n12: // Independence is checked against every surface that scores prompts, not only\n13: // the training corpus. Each surface declares the holdout source types it may\n14: // share prompts with, through which of its corpora, and why. An undeclared\n15: // overlap fails, a declared overlap that no longer exists fails, a declaration\n16: // that no file backs fails, and a runtime file that reads a scored corpus\n17: // without being declared here fails, so a new shared prompt or a new scoring\n18: // surface is recorded instead of silently eroding the holdout.\n19: \n20: import { existsSync, mkdtempSync, readdirSync, readFileSync } from 'node:fs';\n21: import { tmpdir } from 'node:os';\n22: import { dirname, join, relative, resolve } from 'node:path';\n23: import { fileURLToPath } from 'node:url';\n24: \n25: import { afterAll, beforeAll, describe, expect, it } from 'vitest';\n26: import type { AdvisorScoringOptions, AdvisorScoringResult } from '../../lib/scorer/types.js';\n27: import { HARDER_INTENT_PROMPT_CORPUS } from '../scorer/fixtures/harder-intent-prompt-corpus.js';\n28: import { INTENT_PROMPT_CORPUS } from '../scorer/fixtures/intent-prompt-corpus.js';\n29: \n30: // Independence floor: the honest holdout is meaningfully larger than a token\n31: // sample even after dedup and training-collision removal.\n32: const MIN_HOLDOUT_ROWS = 60;\n33: const SOURCE_TYPES = ['holdout-harder', 'holdout-regression', 'holdout-delegation'] as const;\n34: const VALID_SOURCE_TYPES = new Set<string>(SOURCE_TYPES);\n35: \n36: type SourceType = typeof SOURCE_TYPES[number];\n37: type CorpusId = 'labeled' | 'ambiguity' | 'intent' | 'harder' | 'golden' | 'regression' | 'delegation';\n38: \n39: interface HoldoutRow {\n40:   readonly id: string;\n41:   readonly prompt: string;\n42:   readonly skill_top_1: string;\n43:   readonly source_type: string;\n44:   readonly origin_fixture: string;\n45: }\n46: \n47: interface Baseline {\n48:   readonly metrics: { readonly holdout_top1: { readonly correct: number; readonly total: number } };\n49: }\n50: \n51: interface AllowedOverlap {\n52:   // The corpora of the surface through which the shared rows arrive.\n53:   readonly via: readonly CorpusId[];\n54:   readonly reason: string;\n55: }\n56: \n57: interface ScoringSurface {\n58:   readonly id: string;\n59:   // Runtime-relative files that score this surface's corpora.\n60:   readonly consumers: readonly string[];\n61:   readonly corpora: readonly CorpusId[];\n62:   // Holdout source types this surface may share prompts with, each with its reason.\n63:   readonly allowedOverlap: Readonly<Partial<Record<SourceType, AllowedOverlap>>>;\n64: }\n65: \n66: const HERE = dirname(fileURLToPath(import.meta.url));\n67: const RUNTIME_ROOT = resolve(HERE, '../..');\n68: const ROUTING = resolve(RUNTIME_ROOT, 'scripts/routing-accuracy');\n69: const BASELINE_PATH = join(ROUTING, 'scorer-eval-baseline.json');\n70: const HOLDOUT_PATH = join(ROUTING, 'holdout-prompts.jsonl');\n71: const SENTINEL = '.skilled/skills/system-spec-kit/SKILL.md';\n72: \n73: // The text that marks a file as reading each corpus. The intent pattern\n74: // excludes the harder corpus, whose name contains it.\n75: const CORPUS_REFERENCE: Readonly<Record<CorpusId, RegExp>> = {\n76:   labeled: /labeled-prompts/,\n77:   ambiguity: /ambiguity-prompts/,\n78:   intent: /(?<![-_A-Za-z])(?:intent-prompt-corpus|INTENT_PROMPT_CORPUS)/,\n79:   harder: /harder-intent-prompt-corpus|HARDER_INTENT_PROMPT_CORPUS/,\n80:   golden: /gate2-golden-prompts/,\n81:   regression: /skill-advisor-regression-cases/,\n82:   delegation: /executor-delegation-cases/,\n83: };\n84: \n85: const SCORING_SURFACES: readonly ScoringSurface[] = [\n86:   {\n87:     id: 'training-corpus',\n88:     consumers: [\n89:       'bench/scorer-calibration.bench.ts',\n90:       'scripts/routing-accuracy/gate3-corpus-runner.mjs',\n91:       'scripts/routing-accuracy/score-outcome-rerank.mjs',\n92:       'scripts/routing-accuracy/score-routing-corpus.py',\n93:       'tests/legacy/advisor-corpus-parity.vitest.ts',\n94:       'tests/parity/python-ts-parity.vitest.ts',\n95:       'tests/scorer/semantic-shadow-ablation.vitest.ts',\n96:     ],\n97:     corpora: ['labeled'],\n98:     allowedOverlap: {},\n99:   },\n100:   {\n101:     id: 'ambiguity-slice',\n102:     consumers: [\n103:       'scripts/routing-accuracy/derive-ambiguity-slice.mjs',\n104:       'tests/scorer/ambiguity-slice.vitest.ts',\n105:     ],\n106:     corpora: ['labeled', 'ambiguity'],\n107:     allowedOverlap: {},\n108:   },\n109:   {\n110:     id: 'scorer-eval-baseline',\n111:     consumers: [\n112:       'scripts/routing-accuracy/capture-scorer-eval-baseline.mjs',\n113:       'tests/parity/scorer-eval-baseline-ratchet.vitest.ts',\n114:     ],\n115:     corpora: ['labeled', 'ambiguity', 'delegation'],\n116:     allowedOverlap: {\n117:       'holdout-delegation': {\n118:         via: ['delegation'],\n119:         reason: 'its delegation bucket scores the fixture the holdout delegation rows come from',\n120:       },\n121:       'holdout-harder': {\n122:         via: ['delegation'],\n123:         reason: 'two delegation cases are also harder-corpus prompts, which the holdout files under holdout-harder',\n124:       },\n125:     },\n126:   },\n127:   {\n128:     id: 'local-native-divergence-ratchet',\n129:     consumers: [\n130:       'scripts/routing-accuracy/capture-local-native-divergence-ledger.mjs',\n131:       'tests/parity/local-native-divergence-ratchet.vitest.ts',\n132:     ],\n133:     corpora: ['labeled', 'harder'],\n134:     allowedOverlap: {\n135:       'holdout-harder': {\n136:         via: ['harder'],\n137:         reason: 'it compares the two scorers on the harder corpus; it tunes nothing',\n138:       },\n139:     },\n140:   },\n141:   {\n142:     id: 'lane-weight-sweep',\n143:     consumers: ['tests/scorer/lane-weight-sweep.vitest.ts'],\n144:     corpora: ['intent', 'harder'],\n145:     allowedOverlap: {\n146:       'holdout-harder': {\n147:         via: ['harder'],\n148:         reason: 'it reports lane-weight vectors over the harder corpus; no weight is chosen from it',\n149:       },\n150:       'holdout-delegation': {\n151:         via: ['intent'],\n152:         reason: 'two intent-corpus prompts are also executor-delegation cases',\n153:       },\n154:     },\n155:   },\n156:   {\n157:     id: 'bm25-lexical-shadow',\n158:     consumers: ['tests/scorer/bm25-lexical-shadow.vitest.ts'],\n159:     corpora: ['intent'],\n160:     allowedOverlap: {\n161:       'holdout-delegation': {\n162:         via: ['intent'],\n163:         reason: 'two intent-corpus prompts are also executor-delegation cases',\n164:       },\n165:     },\n166:   },\n167:   {\n168:     id: 'golden-prompts',\n169:     consumers: ['tests/routing-golden-prompts.vitest.ts'],\n170:     corpora: ['golden'],\n171:     allowedOverlap: {\n172:       'holdout-regression': {\n173:         via: ['golden'],\n174:         reason: 'golden cases are copied from regression cases, named by sourceCaseId',\n175:       },\n176:     },\n177:   },\n178:   {\n179:     id: 'prompt-policy-gold-replay',\n180:     consumers: ['tests/prompt-policy-gold-replay.vitest.ts'],\n181:     corpora: ['labeled', 'golden'],\n182:     allowedOverlap: {\n183:       'holdout-regression': {\n184:         via: ['golden'],\n185:         reason: 'golden cases are copied from regression cases, named by sourceCaseId',\n186:       },\n187:     },\n188:   },\n189:   {\n190:     id: 'regression-suite',\n191:     consumers: ['stress-test/skill-advisor/python-compat-stress.vitest.ts'],\n192:     corpora: ['regression'],\n193:     allowedOverlap: {\n194:       'holdout-regression': {\n195:         via: ['regression'],\n196:         reason: 'it replays the regression fixture the holdout regression rows come from',\n197:       },\n198:     },\n199:   },\n200:   {\n201:     id: 'advisor-validate',\n202:     consumers: ['handlers/advisor-validate.ts'],\n203:     corpora: ['labeled', 'regression', 'delegation'],\n204:     allowedOverlap: {\n205:       'holdout-regression': {\n206:         via: ['regression'],\n207:         reason: 'it reports accuracy on the regression fixture; it tunes nothing',\n208:       },\n209:       'holdout-delegation': {\n210:         via: ['delegation'],\n211:         reason: 'it reports accuracy on the delegation fixture; it tunes nothing',\n212:       },\n213:       'holdout-harder': {\n214:         via: ['delegation'],\n215:         reason: 'two delegation cases are also harder-corpus prompts, which the holdout files under holdout-harder',\n216:       },\n217:     },\n218:   },\n219:   {\n220:     id: 'executor-delegation-suite',\n221:     consumers: ['tests/scorer/executor-delegation.vitest.ts'],\n222:     corpora: ['delegation'],\n223:     allowedOverlap: {\n224:       'holdout-delegation': {\n225:         via: ['delegation'],\n226:         reason: 'it pins the delegation fixture the holdout delegation rows come from',\n227:       },\n228:       'holdout-harder': {\n229:         via: ['delegation'],\n230:         reason: 'two delegation cases are also harder-corpus prompts, which the holdout files under holdout-harder',\n231:       },\n232:     },\n233:   },\n234: ];\n235: \n236: // Runtime files that name a scored corpus without scoring it.\n237: const NON_SCORING_REFERENCES: Readonly<Record<string, string>> = {\n238:   'scripts/routing-accuracy/build-holdout.mjs': 'assembles the holdout from its source fixtures and scores nothing',\n239:   'tests/migration-lineage-identity.vitest.ts': 'checks that an archived corpus path still resolves and scores nothing',\n240:   'tests/parity/holdout-independent.vitest.ts': 'this gate',\n241:   'tests/scorer/fixtures/harder-intent-prompt-corpus.ts': 'defines the harder corpus',\n242:   'tests/scorer/fixtures/intent-prompt-corpus.ts': 'defines the intent corpus',\n243: };\n244: \n245: const SCANNED_EXTENSIONS = /\\.(?:ts|mts|cts|mjs|cjs|js|py)$/;\n246: const SKIPPED_DIRECTORIES = new Set(['node_modules', 'dist', 'coverage', '.vitest']);\n247: \n248: function normalizeFamily(prompt: string): string {\n249:   return prompt.toLowerCase().replace(/[^a-z0-9\\s]/g, ' ').replace(/\\s+/g, ' ').trim();\n250: }\n251: \n252: function readJsonl<T>(path: string): T[] {\n253:   return readFileSync(path, 'utf8').trim().split('\\n').filter(Boolean).map((line) => JSON.parse(line) as T);\n254: }\n255: \n256: function loadCorpusFamilies(): Record<CorpusId, Set<string>> {\n257:   const families = (prompts: readonly string[]): Set<string> => new Set(prompts.map(normalizeFamily));\n258:   const jsonlPrompts = (path: string): string[] => (\n259:     readJsonl<{ prompt?: unknown }>(path)\n260:       .map((row) => row.prompt)\n261:       .filter((prompt): prompt is string => typeof prompt === 'string')\n262:   );\n263:   const delegation = JSON.parse(\n264:     readFileSync(join(RUNTIME_ROOT, 'tests/parity/fixtures/executor-delegation-cases.json'), 'utf8'),\n265:   ) as { cases: { prompt: string }[] };\n266:   return {\n267:     labeled: families(jsonlPrompts(join(ROUTING, 'labeled-prompts.jsonl'))),\n268:     ambiguity: families(jsonlPrompts(join(ROUTING, 'ambiguity-prompts.jsonl'))),\n269:     intent: families(INTENT_PROMPT_CORPUS.map((item) => item.prompt)),\n270:     harder: families(HARDER_INTENT_PROMPT_CORPUS.map((item) => item.prompt)),\n271:     golden: families(jsonlPrompts(join(RUNTIME_ROOT, 'scripts/fixtures/gate2-golden-prompts.jsonl'))),\n272:     regression: families(jsonlPrompts(join(RUNTIME_ROOT, 'scripts/fixtures/skill-advisor-regression-cases.jsonl'))),\n273:     delegation: families(delegation.cases.map((testCase) => testCase.prompt)),\n274:   };\n275: }\n276: \n277: // Symbolic links are not followed: a linked directory belongs to another skill,\n278: // and following one could walk outside the runtime or loop.\n279: function listRuntimeSourceFiles(directory: string): string[] {\n280:   const files: string[] = [];\n281:   for (const entry of readdirSync(directory, { withFileTypes: true })) {\n282:     if (SKIPPED_DIRECTORIES.has(entry.name)) continue;\n283:     const path = join(directory, entry.name);\n284:     if (entry.isDirectory()) files.push(...listRuntimeSourceFiles(path));\n285:     else if (entry.isFile() && SCANNED_EXTENSIONS.test(entry.name)) files.push(path);\n286:   }\n287:   return files;\n288: }\n289: \n290: function readsCorpus(file: string, corpus: CorpusId): boolean {\n291:   return CORPUS_REFERENCE[corpus].test(readFileSync(join(RUNTIME_ROOT, file), 'utf8'));\n292: }\n293: \n294: // Private `local-*` skills linked in through this variable live outside the\n295: // checkout, so a pinned count measured on a clean checkout must not see them.\n296: const PRIVATE_SKILL_ROOTS_ENV = 'SPECKIT_PRIVATE_SKILL_ROOTS';\n297: const PREVIOUS_PRIVATE_SKILL_ROOTS = process.env[PRIVATE_SKILL_ROOTS_ENV];\n298: \n299: function restorePrivateSkillRoots(): void {\n300:   if (PREVIOUS_PRIVATE_SKILL_ROOTS === undefined) delete process.env[PRIVATE_SKILL_ROOTS_ENV];\n301:   else process.env[PRIVATE_SKILL_ROOTS_ENV] = PREVIOUS_PRIVATE_SKILL_ROOTS;\n302: }\n303: \n304: function freezeEvalEnv(): void {\n305:   process.env.SYSTEM_SKILL_ADVISOR_DB_DIR = mkdtempSync(join(tmpdir(), 'advisor-holdout-'));\n306:   process.env.SKILL_ADVISOR_DISABLE_BUILTIN_SEMANTIC = '1';\n307:   process.env.SPECKIT_SKILL_ADVISOR_FORCE_LOCAL = '1';\n308:   delete process.env.SPECKIT_ADVISOR_LANE_WEIGHTS_JSON;\n309:   delete process.env.SPECKIT_ADVISOR_LANE_SHADOW_WEIGHTS_JSON;\n310:   delete process.env.SPECKIT_ADVISOR_BM25_LEXICAL_SHADOW;\n311:   delete process.env[PRIVATE_SKILL_ROOTS_ENV];\n312: }\n313: \n314: let scoreAdvisorPrompt: (prompt: string, options: AdvisorScoringOptions) => AdvisorScoringResult;\n315: let mergedSkillForAlias: (skillId: string) => string;\n316: let skillMatchesAlias: (actual: string, expected: string) => boolean;\n317: let workspaceRoot = '';\n318: \n319: function isTop1Correct(top: string | null, goldRaw: string): boolean {\n320:   const gold = goldRaw === 'none' ? null : goldRaw;\n321:   const expected = gold === null ? null : mergedSkillForAlias(gold);\n322:   const actual = top === null ? null : mergedSkillForAlias(top);\n323:   return actual === expected\n324:     || (actual !== null && expected !== null && skillMatchesAlias(actual, expected));\n325: }\n326: \n327: let HOLDOUT: HoldoutRow[] = [];\n328: let CORPUS_FAMILIES: Record<CorpusId, Set<string>>;\n329: let BASELINE: Baseline;\n330: let HOLDOUT_CORRECT = 0;\n331: \n332: // Holdout rows each surface scores, keyed by source type and the corpus that carries them.\n333: function surfaceOverlap(surface: ScoringSurface): Map<string, { sourceType: SourceType; corpus: CorpusId; ids: string[] }> {\n334:   const overlap = new Map<string, { sourceType: SourceType; corpus: CorpusId; ids: string[] }>();\n335:   for (const row of HOLDOUT) {\n336:     const family = normalizeFamily(row.prompt);\n337:     const sourceType = row.source_type as SourceType;\n338:     for (const corpus of surface.corpora) {\n339:       if (!CORPUS_FAMILIES[corpus].has(family)) continue;\n340:       const key = `${sourceType}|${corpus}`;\n341:       const entry = overlap.get(key) ?? { sourceType, corpus, ids: [] };\n342:       entry.ids.push(row.id);\n343:       overlap.set(key, entry);\n344:     }\n345:   }\n346:   return overlap;\n347: }\n348: \n349: describe('independent holdout gate', () => {\n350:   afterAll(restorePrivateSkillRoots);\n351: \n352:   beforeAll(async () => {\n353:     freezeEvalEnv();\n354:     const fusion = await import('../../lib/scorer/fusion.js');\n355:     const aliases = await import('../../lib/scorer/aliases.js');\n356:     const workspace = await import('../../lib/utils/workspace-root.js');\n357:     scoreAdvisorPrompt = fusion.scoreAdvisorPrompt;\n358:     mergedSkillForAlias = aliases.mergedSkillForAlias;\n359:     skillMatchesAlias = aliases.skillMatchesAlias;\n360:     workspaceRoot = workspace.findAdvisorWorkspaceRoot(HERE, { maxDepth: 14, sentinel: SENTINEL });\n361: \n362:     HOLDOUT = readJsonl<HoldoutRow>(HOLDOUT_PATH);\n363:     CORPUS_FAMILIES = loadCorpusFamilies();\n364:     BASELINE = JSON.parse(readFileSync(BASELINE_PATH, 'utf8')) as Baseline;\n365: \n366:     HOLDOUT_CORRECT = HOLDOUT.filter((row) => (\n367:       isTop1Correct(scoreAdvisorPrompt(row.prompt, { workspaceRoot }).topSkill, row.skill_top_1)\n368:     )).length;\n369:   }, 120_000);\n370: \n371:   it('is a non-trivial, provenance-tagged set', () => {\n372:     expect(HOLDOUT.length).toBeGreaterThanOrEqual(MIN_HOLDOUT_ROWS);\n373:     for (const row of HOLDOUT) {\n374:       expect(VALID_SOURCE_TYPES.has(row.source_type), `unknown source_type: ${row.source_type}`).toBe(true);\n375:       expect(row.origin_fixture.length, `missing origin_fixture on ${row.id}`).toBeGreaterThan(0);\n376:     }\n377:   });\n378: \n379:   it('shares prompts with a scoring surface only where the overlap is declared', () => {\n380:     const undeclared: string[] = [];\n381:     for (const surface of SCORING_SURFACES) {\n382:       for (const { sourceType, corpus, ids } of surfaceOverlap(surface).values()) {\n383:         if (!surface.allowedOverlap[sourceType]?.via.includes(corpus)) {\n384:           undeclared.push(`${surface.id} scores ${sourceType} rows through ${corpus}: ${ids.join(', ')}`);\n385:         }\n386:       }\n387:     }\n388:     expect(\n389:       undeclared,\n390:       'Holdout rows scored by a surface that does not declare the overlap. Drop the rows from the '\n391:       + `holdout, or declare the overlap with its reason:\\n  ${undeclared.join('\\n  ')}`,\n392:     ).toEqual([]);\n393:   });\n394: \n395:   it('declares no overlap that no longer exists', () => {\n396:     const stale: string[] = [];\n397:     for (const surface of SCORING_SURFACES) {\n398:       const overlap = surfaceOverlap(surface);\n399:       for (const [sourceType, allowance] of Object.entries(surface.allowedOverlap) as [SourceType, AllowedOverlap][]) {\n400:         for (const corpus of allowance.via) {\n401:           if (!surface.corpora.includes(corpus) || !overlap.has(`${sourceType}|${corpus}`)) {\n402:             stale.push(`${surface.id} -> ${sourceType} through ${corpus}`);\n403:           }\n404:         }\n405:       }\n406:     }\n407:     expect(stale, `Declared overlaps with no shared holdout row (remove them):\\n  ${stale.join('\\n  ')}`).toEqual([]);\n408:   });\n409: \n410:   it('backs every declaration with a file that reads it', () => {\n411:     const unbacked: string[] = [];\n412:     for (const surface of SCORING_SURFACES) {\n413:       for (const consumer of surface.consumers) {\n414:         if (!existsSync(join(RUNTIME_ROOT, consumer))) continue;\n415:         if (!surface.corpora.some((corpus) => readsCorpus(consumer, corpus))) {\n416:           unbacked.push(`${surface.id}: ${consumer} reads none of ${surface.corpora.join(', ')}`);\n417:         }\n418:       }\n419:       for (const corpus of surface.corpora) {\n420:         const live = surface.consumers.filter((consumer) => existsSync(join(RUNTIME_ROOT, consumer)));\n421:         if (!live.some((consumer) => readsCorpus(consumer, corpus))) {\n422:           unbacked.push(`${surface.id}: no consumer reads ${corpus}`);\n423:         }\n424:       }\n425:     }\n426:     for (const file of Object.keys(NON_SCORING_REFERENCES)) {\n427:       const corpora = Object.keys(CORPUS_REFERENCE) as CorpusId[];\n428:       if (!existsSync(join(RUNTIME_ROOT, file)) || !corpora.some((corpus) => readsCorpus(file, corpus))) {\n429:         unbacked.push(`non-scoring exemption ${file} no longer names a scored corpus`);\n430:       }\n431:     }\n432:     expect(unbacked, `Declarations no file backs (correct or remove them):\\n  ${unbacked.join('\\n  ')}`).toEqual([]);\n433:   });\n434: \n435:   it('declares every runtime file that reads a scored corpus', () => {\n436:     const declared = new Map<string, Set<CorpusId>>();\n437:     for (const surface of SCORING_SURFACES) {\n438:       for (const consumer of surface.consumers) {\n439:         const corpora = declared.get(consumer) ?? new Set<CorpusId>();\n440:         for (const corpus of surface.corpora) corpora.add(corpus);\n441:         declared.set(consumer, corpora);\n442:       }\n443:     }\n444:     const missingConsumers = [...declared.keys()].filter((consumer) => !existsSync(join(RUNTIME_ROOT, consumer)));\n445:     expect(missingConsumers, `Declared consumers that no longer exist: ${missingConsumers.join(', ')}`).toEqual([]);\n446: \n447:     const undeclared: string[] = [];\n448:     for (const path of listRuntimeSourceFiles(RUNTIME_ROOT)) {\n449:       const file = relative(RUNTIME_ROOT, path).split('\\\\').join('/');\n450:       if (NON_SCORING_REFERENCES[file] !== undefined) continue;\n451:       const text = readFileSync(path, 'utf8');\n452:       for (const [corpus, pattern] of Object.entries(CORPUS_REFERENCE) as [CorpusId, RegExp][]) {\n453:         if (pattern.test(text) && !declared.get(file)?.has(corpus)) undeclared.push(`${file} reads ${corpus}`);\n454:       }\n455:     }\n456:     expect(\n457:       undeclared,\n458:       `Runtime files that read a scored corpus but are not declared as a scoring surface:\\n  ${undeclared.join('\\n  ')}`,\n459:     ).toEqual([]);\n460:   });\n461: \n462:   it('holds top-1 at or above the committed baseline', () => {\n463:     const baselineCorrect = BASELINE.metrics.holdout_top1.correct;\n464:     expect(\n465:       HOLDOUT_CORRECT,\n466:       `holdout top-1 regressed: live=${HOLDOUT_CORRECT}/${HOLDOUT.length} baseline=${baselineCorrect}. `\n467:       + 'A drop means a scorer or metadata change hurt generalization.',\n468:     ).toBeGreaterThanOrEqual(baselineCorrect);\n469:   });\n470: });","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file .skilled/skills/system-skill-advisor/runtime/tests/parity/holdout-independent.vitest.ts, lines 1-470\n1: // ───────────────────────────────────────────────────────────────\n2: // MODULE: Independent Holdout Gate\n3: // ───────────────────────────────────────────────────────────────\n4: \n5: // Scores the frozen independent holdout and holds its top-1 accuracy at or\n6: // above the committed baseline. Unlike the every-Nth-row holdout carved from the\n7: // training corpus (retained elsewhere as a legacy secondary signal), this set is\n8: // assembled from three separately-authored, real-labeled fixtures, so it\n9: // measures generalization rather than memorization. No gold is invented: each\n10: // row's label comes from its source fixture, and provenance is asserted per row.\n11: //\n12: // Independence is checked against every surface that scores prompts, not only\n13: // the training corpus. Each surface declares the holdout source types it may\n14: // share prompts with, through which of its corpora, and why. An undeclared\n15: // overlap fails, a declared overlap that no longer exists fails, a declaration\n16: // that no file backs fails, and a runtime file that reads a scored corpus\n17: // without being declared here fails, so a new shared prompt or a new scoring\n18: // surface is recorded instead of silently eroding the holdout.\n19: \n20: import { existsSync, mkdtempSync, readdirSync, readFileSync } from 'node:fs';\n21: import { tmpdir } from 'node:os';\n22: import { dirname, join, relative, resolve } from 'node:path';\n23: import { fileURLToPath } from 'node:url';\n24: \n25: import { afterAll, beforeAll, describe, expect, it } from 'vitest';\n26: import type { AdvisorScoringOptions, AdvisorScoringResult } from '../../lib/scorer/types.js';\n27: import { HARDER_INTENT_PROMPT_CORPUS } from '../scorer/fixtures/harder-intent-prompt-corpus.js';\n28: import { INTENT_PROMPT_CORPUS } from '../scorer/fixtures/intent-prompt-corpus.js';\n29: \n30: // Independence floor: the honest holdout is meaningfully larger than a token\n31: // sample even after dedup and training-collision removal.\n32: const MIN_HOLDOUT_ROWS = 60;\n33: const SOURCE_TYPES = ['holdout-harder', 'holdout-regression', 'holdout-delegation'] as const;\n34: const VALID_SOURCE_TYPES = new Set<string>(SOURCE_TYPES);\n35: \n36: type SourceType = typeof SOURCE_TYPES[number];\n37: type CorpusId = 'labeled' | 'ambiguity' | 'intent' | 'harder' | 'golden' | 'regression' | 'delegation';\n38: \n39: interface HoldoutRow {\n40:   readonly id: string;\n41:   readonly prompt: string;\n42:   readonly skill_top_1: string;\n43:   readonly source_type: string;\n44:   readonly origin_fixture: string;\n45: }\n46: \n47: interface Baseline {\n48:   readonly metrics: { readonly holdout_top1: { readonly correct: number; readonly total: number } };\n49: }\n50: \n51: interface AllowedOverlap {\n52:   // The corpora of the surface through which the shared rows arrive.\n53:   readonly via: readonly CorpusId[];\n54:   readonly reason: string;\n55: }\n56: \n57: interface ScoringSurface {\n58:   readonly id: string;\n59:   // Runtime-relative files that score this surface's corpora.\n60:   readonly consumers: readonly string[];\n61:   readonly corpora: readonly CorpusId[];\n62:   // Holdout source types this surface may share prompts with, each with its reason.\n63:   readonly allowedOverlap: Readonly<Partial<Record<SourceType, AllowedOverlap>>>;\n64: }\n65: \n66: const HERE = dirname(fileURLToPath(import.meta.url));\n67: const RUNTIME_ROOT = resolve(HERE, '../..');\n68: const ROUTING = resolve(RUNTIME_ROOT, 'scripts/routing-accuracy');\n69: const BASELINE_PATH = join(ROUTING, 'scorer-eval-baseline.json');\n70: const HOLDOUT_PATH = join(ROUTING, 'holdout-prompts.jsonl');\n71: const SENTINEL = '.skilled/skills/system-spec-kit/SKILL.md';\n72: \n73: // The text that marks a file as reading each corpus. The intent pattern\n74: // excludes the harder corpus, whose name contains it.\n75: const CORPUS_REFERENCE: Readonly<Record<CorpusId, RegExp>> = {\n76:   labeled: /labeled-prompts/,\n77:   ambiguity: /ambiguity-prompts/,\n78:   intent: /(?<![-_A-Za-z])(?:intent-prompt-corpus|INTENT_PROMPT_CORPUS)/,\n79:   harder: /harder-intent-prompt-corpus|HARDER_INTENT_PROMPT_CORPUS/,\n80:   golden: /gate2-golden-prompts/,\n81:   regression: /skill-advisor-regression-cases/,\n82:   delegation: /executor-delegation-cases/,\n83: };\n84: \n85: const SCORING_SURFACES: readonly ScoringSurface[] = [\n86:   {\n87:     id: 'training-corpus',\n88:     consumers: [\n89:       'bench/scorer-calibration.bench.ts',\n90:       'scripts/routing-accuracy/gate3-corpus-runner.mjs',\n91:       'scripts/routing-accuracy/score-outcome-rerank.mjs',\n92:       'scripts/routing-accuracy/score-routing-corpus.py',\n93:       'tests/legacy/advisor-corpus-parity.vitest.ts',\n94:       'tests/parity/python-ts-parity.vitest.ts',\n95:       'tests/scorer/semantic-shadow-ablation.vitest.ts',\n96:     ],\n97:     corpora: ['labeled'],\n98:     allowedOverlap: {},\n99:   },\n100:   {\n101:     id: 'ambiguity-slice',\n102:     consumers: [\n103:       'scripts/routing-accuracy/derive-ambiguity-slice.mjs',\n104:       'tests/scorer/ambiguity-slice.vitest.ts',\n105:     ],\n106:     corpora: ['labeled', 'ambiguity'],\n107:     allowedOverlap: {},\n108:   },\n109:   {\n110:     id: 'scorer-eval-baseline',\n111:     consumers: [\n112:       'scripts/routing-accuracy/capture-scorer-eval-baseline.mjs',\n113:       'tests/parity/scorer-eval-baseline-ratchet.vitest.ts',\n114:     ],\n115:     corpora: ['labeled', 'ambiguity', 'delegation'],\n116:     allowedOverlap: {\n117:       'holdout-delegation': {\n118:         via: ['delegation'],\n119:         reason: 'its delegation bucket scores the fixture the holdout delegation rows come from',\n120:       },\n121:       'holdout-harder': {\n122:         via: ['delegation'],\n123:         reason: 'two delegation cases are also harder-corpus prompts, which the holdout files under holdout-harder',\n124:       },\n125:     },\n126:   },\n127:   {\n128:     id: 'local-native-divergence-ratchet',\n129:     consumers: [\n130:       'scripts/routing-accuracy/capture-local-native-divergence-ledger.mjs',\n131:       'tests/parity/local-native-divergence-ratchet.vitest.ts',\n132:     ],\n133:     corpora: ['labeled', 'harder'],\n134:     allowedOverlap: {\n135:       'holdout-harder': {\n136:         via: ['harder'],\n137:         reason: 'it compares the two scorers on the harder corpus; it tunes nothing',\n138:       },\n139:     },\n140:   },\n141:   {\n142:     id: 'lane-weight-sweep',\n143:     consumers: ['tests/scorer/lane-weight-sweep.vitest.ts'],\n144:     corpora: ['intent', 'harder'],\n145:     allowedOverlap: {\n146:       'holdout-harder': {\n147:         via: ['harder'],\n148:         reason: 'it reports lane-weight vectors over the harder corpus; no weight is chosen from it',\n149:       },\n150:       'holdout-delegation': {\n151:         via: ['intent'],\n152:         reason: 'two intent-corpus prompts are also executor-delegation cases',\n153:       },\n154:     },\n155:   },\n156:   {\n157:     id: 'bm25-lexical-shadow',\n158:     consumers: ['tests/scorer/bm25-lexical-shadow.vitest.ts'],\n159:     corpora: ['intent'],\n160:     allowedOverlap: {\n161:       'holdout-delegation': {\n162:         via: ['intent'],\n163:         reason: 'two intent-corpus prompts are also executor-delegation cases',\n164:       },\n165:     },\n166:   },\n167:   {\n168:     id: 'golden-prompts',\n169:     consumers: ['tests/routing-golden-prompts.vitest.ts'],\n170:     corpora: ['golden'],\n171:     allowedOverlap: {\n172:       'holdout-regression': {\n173:         via: ['golden'],\n174:         reason: 'golden cases are copied from regression cases, named by sourceCaseId',\n175:       },\n176:     },\n177:   },\n178:   {\n179:     id: 'prompt-policy-gold-replay',\n180:     consumers: ['tests/prompt-policy-gold-replay.vitest.ts'],\n181:     corpora: ['labeled', 'golden'],\n182:     allowedOverlap: {\n183:       'holdout-regression': {\n184:         via: ['golden'],\n185:         reason: 'golden cases are copied from regression cases, named by sourceCaseId',\n186:       },\n187:     },\n188:   },\n189:   {\n190:     id: 'regression-suite',\n191:     consumers: ['stress-test/skill-advisor/python-compat-stress.vitest.ts'],\n192:     corpora: ['regression'],\n193:     allowedOverlap: {\n194:       'holdout-regression': {\n195:         via: ['regression'],\n196:         reason: 'it replays the regression fixture the holdout regression rows come from',\n197:       },\n198:     },\n199:   },\n200:   {\n201:     id: 'advisor-validate',\n202:     consumers: ['handlers/advisor-validate.ts'],\n203:     corpora: ['labeled', 'regression', 'delegation'],\n204:     allowedOverlap: {\n205:       'holdout-regression': {\n206:         via: ['regression'],\n207:         reason: 'it reports accuracy on the regression fixture; it tunes nothing',\n208:       },\n209:       'holdout-delegation': {\n210:         via: ['delegation'],\n211:         reason: 'it reports accuracy on the delegation fixture; it tunes nothing',\n212:       },\n213:       'holdout-harder': {\n214:         via: ['delegation'],\n215:         reason: 'two delegation cases are also harder-corpus prompts, which the holdout files under holdout-harder',\n216:       },\n217:     },\n218:   },\n219:   {\n220:     id: 'executor-delegation-suite',\n221:     consumers: ['tests/scorer/executor-delegation.vitest.ts'],\n222:     corpora: ['delegation'],\n223:     allowedOverlap: {\n224:       'holdout-delegation': {\n225:         via: ['delegation'],\n226:         reason: 'it pins the delegation fixture the holdout delegation rows come from',\n227:       },\n228:       'holdout-harder': {\n229:         via: ['delegation'],\n230:         reason: 'two delegation cases are also harder-corpus prompts, which the holdout files under holdout-harder',\n231:       },\n232:     },\n233:   },\n234: ];\n235: \n236: // Runtime files that name a scored corpus without scoring it.\n237: const NON_SCORING_REFERENCES: Readonly<Record<string, string>> = {\n238:   'scripts/routing-accuracy/build-holdout.mjs': 'assembles the holdout from its source fixtures and scores nothing',\n239:   'tests/migration-lineage-identity.vitest.ts': 'checks that an archived corpus path still resolves and scores nothing',\n240:   'tests/parity/holdout-independent.vitest.ts': 'this gate',\n241:   'tests/scorer/fixtures/harder-intent-prompt-corpus.ts': 'defines the harder corpus',\n242:   'tests/scorer/fixtures/intent-prompt-corpus.ts': 'defines the intent corpus',\n243: };\n244: \n245: const SCANNED_EXTENSIONS = /\\.(?:ts|mts|cts|mjs|cjs|js|py)$/;\n246: const SKIPPED_DIRECTORIES = new Set(['node_modules', 'dist', 'coverage', '.vitest']);\n247: \n248: function normalizeFamily(prompt: string): string {\n249:   return prompt.toLowerCase().replace(/[^a-z0-9\\s]/g, ' ').replace(/\\s+/g, ' ').trim();\n250: }\n251: \n252: function readJsonl<T>(path: string): T[] {\n253:   return readFileSync(path, 'utf8').trim().split('\\n').filter(Boolean).map((line) => JSON.parse(line) as T);\n254: }\n255: \n256: function loadCorpusFamilies(): Record<CorpusId, Set<string>> {\n257:   const families = (prompts: readonly string[]): Set<string> => new Set(prompts.map(normalizeFamily));\n258:   const jsonlPrompts = (path: string): string[] => (\n259:     readJsonl<{ prompt?: unknown }>(path)\n260:       .map((row) => row.prompt)\n261:       .filter((prompt): prompt is string => typeof prompt === 'string')\n262:   );\n263:   const delegation = JSON.parse(\n264:     readFileSync(join(RUNTIME_ROOT, 'tests/parity/fixtures/executor-delegation-cases.json'), 'utf8'),\n265:   ) as { cases: { prompt: string }[] };\n266:   return {\n267:     labeled: families(jsonlPrompts(join(ROUTING, 'labeled-prompts.jsonl'))),\n268:     ambiguity: families(jsonlPrompts(join(ROUTING, 'ambiguity-prompts.jsonl'))),\n269:     intent: families(INTENT_PROMPT_CORPUS.map((item) => item.prompt)),\n270:     harder: families(HARDER_INTENT_PROMPT_CORPUS.map((item) => item.prompt)),\n271:     golden: families(jsonlPrompts(join(RUNTIME_ROOT, 'scripts/fixtures/gate2-golden-prompts.jsonl'))),\n272:     regression: families(jsonlPrompts(join(RUNTIME_ROOT, 'scripts/fixtures/skill-advisor-regression-cases.jsonl'))),\n273:     delegation: families(delegation.cases.map((testCase) => testCase.prompt)),\n274:   };\n275: }\n276: \n277: // Symbolic links are not followed: a linked directory belongs to another skill,\n278: // and following one could walk outside the runtime or loop.\n279: function listRuntimeSourceFiles(directory: string): string[] {\n280:   const files: string[] = [];\n281:   for (const entry of readdirSync(directory, { withFileTypes: true })) {\n282:     if (SKIPPED_DIRECTORIES.has(entry.name)) continue;\n283:     const path = join(directory, entry.name);\n284:     if (entry.isDirectory()) files.push(...listRuntimeSourceFiles(path));\n285:     else if (entry.isFile() && SCANNED_EXTENSIONS.test(entry.name)) files.push(path);\n286:   }\n287:   return files;\n288: }\n289: \n290: function readsCorpus(file: string, corpus: CorpusId): boolean {\n291:   return CORPUS_REFERENCE[corpus].test(readFileSync(join(RUNTIME_ROOT, file), 'utf8'));\n292: }\n293: \n294: // Private `local-*` skills linked in through this variable live outside the\n295: // checkout, so a pinned count measured on a clean checkout must not see them.\n296: const PRIVATE_SKILL_ROOTS_ENV = 'SPECKIT_PRIVATE_SKILL_ROOTS';\n297: const PREVIOUS_PRIVATE_SKILL_ROOTS = process.env[PRIVATE_SKILL_ROOTS_ENV];\n298: \n299: function restorePrivateSkillRoots(): void {\n300:   if (PREVIOUS_PRIVATE_SKILL_ROOTS === undefined) delete process.env[PRIVATE_SKILL_ROOTS_ENV];\n301:   else process.env[PRIVATE_SKILL_ROOTS_ENV] = PREVIOUS_PRIVATE_SKILL_ROOTS;\n302: }\n303: \n304: function freezeEvalEnv(): void {\n305:   process.env.SYSTEM_SKILL_ADVISOR_DB_DIR = mkdtempSync(join(tmpdir(), 'advisor-holdout-'));\n306:   process.env.SKILL_ADVISOR_DISABLE_BUILTIN_SEMANTIC = '1';\n307:   process.env.SPECKIT_SKILL_ADVISOR_FORCE_LOCAL = '1';\n308:   delete process.env.SPECKIT_ADVISOR_LANE_WEIGHTS_JSON;\n309:   delete process.env.SPECKIT_ADVISOR_LANE_SHADOW_WEIGHTS_JSON;\n310:   delete process.env.SPECKIT_ADVISOR_BM25_LEXICAL_SHADOW;\n311:   delete process.env[PRIVATE_SKILL_ROOTS_ENV];\n312: }\n313: \n314: let scoreAdvisorPrompt: (prompt: string, options: AdvisorScoringOptions) => AdvisorScoringResult;\n315: let mergedSkillForAlias: (skillId: string) => string;\n316: let skillMatchesAlias: (actual: string, expected: string) => boolean;\n317: let workspaceRoot = '';\n318: \n319: function isTop1Correct(top: string | null, goldRaw: string): boolean {\n320:   const gold = goldRaw === 'none' ? null : goldRaw;\n321:   const expected = gold === null ? null : mergedSkillForAlias(gold);\n322:   const actual = top === null ? null : mergedSkillForAlias(top);\n323:   return actual === expected\n324:     || (actual !== null && expected !== null && skillMatchesAlias(actual, expected));\n325: }\n326: \n327: let HOLDOUT: HoldoutRow[] = [];\n328: let CORPUS_FAMILIES: Record<CorpusId, Set<string>>;\n329: let BASELINE: Baseline;\n330: let HOLDOUT_CORRECT = 0;\n331: \n332: // Holdout rows each surface scores, keyed by source type and the corpus that carries them.\n333: function surfaceOverlap(surface: ScoringSurface): Map<string, { sourceType: SourceType; corpus: CorpusId; ids: string[] }> {\n334:   const overlap = new Map<string, { sourceType: SourceType; corpus: CorpusId; ids: string[] }>();\n335:   for (const row of HOLDOUT) {\n336:     const family = normalizeFamily(row.prompt);\n337:     const sourceType = row.source_type as SourceType;\n338:     for (const corpus of surface.corpora) {\n339:       if (!CORPUS_FAMILIES[corpus].has(family)) continue;\n340:       const key = `${sourceType}|${corpus}`;\n341:       const entry = overlap.get(key) ?? { sourceType, corpus, ids: [] };\n342:       entry.ids.push(row.id);\n343:       overlap.set(key, entry);\n344:     }\n345:   }\n346:   return overlap;\n347: }\n348: \n349: describe('independent holdout gate', () => {\n350:   afterAll(restorePrivateSkillRoots);\n351: \n352:   beforeAll(async () => {\n353:     freezeEvalEnv();\n354:     const fusion = await import('../../lib/scorer/fusion.js');\n355:     const aliases = await import('../../lib/scorer/aliases.js');\n356:     const workspace = await import('../../lib/utils/workspace-root.js');\n357:     scoreAdvisorPrompt = fusion.scoreAdvisorPrompt;\n358:     mergedSkillForAlias = aliases.mergedSkillForAlias;\n359:     skillMatchesAlias = aliases.skillMatchesAlias;\n360:     workspaceRoot = workspace.findAdvisorWorkspaceRoot(HERE, { maxDepth: 14, sentinel: SENTINEL });\n361: \n362:     HOLDOUT = readJsonl<HoldoutRow>(HOLDOUT_PATH);\n363:     CORPUS_FAMILIES = loadCorpusFamilies();\n364:     BASELINE = JSON.parse(readFileSync(BASELINE_PATH, 'utf8')) as Baseline;\n365: \n366:     HOLDOUT_CORRECT = HOLDOUT.filter((row) => (\n367:       isTop1Correct(scoreAdvisorPrompt(row.prompt, { workspaceRoot }).topSkill, row.skill_top_1)\n368:     )).length;\n369:   }, 120_000);\n370: \n371:   it('is a non-trivial, provenance-tagged set', () => {\n372:     expect(HOLDOUT.length).toBeGreaterThanOrEqual(MIN_HOLDOUT_ROWS);\n373:     for (const row of HOLDOUT) {\n374:       expect(VALID_SOURCE_TYPES.has(row.source_type), `unknown source_type: ${row.source_type}`).toBe(true);\n375:       expect(row.origin_fixture.length, `missing origin_fixture on ${row.id}`).toBeGreaterThan(0);\n376:     }\n377:   });\n378: \n379:   it('shares prompts with a scoring surface only where the overlap is declared', () => {\n380:     const undeclared: string[] = [];\n381:     for (const surface of SCORING_SURFACES) {\n382:       for (const { sourceType, corpus, ids } of surfaceOverlap(surface).values()) {\n383:         if (!surface.allowedOverlap[sourceType]?.via.includes(corpus)) {\n384:           undeclared.push(`${surface.id} scores ${sourceType} rows through ${corpus}: ${ids.join(', ')}`);\n385:         }\n386:       }\n387:     }\n388:     expect(\n389:       undeclared,\n390:       'Holdout rows scored by a surface that does not declare the overlap. Drop the rows from the '\n391:       + `holdout, or declare the overlap with its reason:\\n  ${undeclared.join('\\n  ')}`,\n392:     ).toEqual([]);\n393:   });\n394: \n395:   it('declares no overlap that no longer exists', () => {\n396:     const stale: string[] = [];\n397:     for (const surface of SCORING_SURFACES) {\n398:       const overlap = surfaceOverlap(surface);\n399:       for (const [sourceType, allowance] of Object.entries(surface.allowedOverlap) as [SourceType, AllowedOverlap][]) {\n400:         for (const corpus of allowance.via) {\n401:           if (!surface.corpora.includes(corpus) || !overlap.has(`${sourceType}|${corpus}`)) {\n402:             stale.push(`${surface.id} -> ${sourceType} through ${corpus}`);\n403:           }\n404:         }\n405:       }\n406:     }\n407:     expect(stale, `Declared overlaps with no shared holdout row (remove them):\\n  ${stale.join('\\n  ')}`).toEqual([]);\n408:   });\n409: \n410:   it('backs every declaration with a file that reads it', () => {\n411:     const unbacked: string[] = [];\n412:     for (const surface of SCORING_SURFACES) {\n413:       for (const consumer of surface.consumers) {\n414:         if (!existsSync(join(RUNTIME_ROOT, consumer))) continue;\n415:         if (!surface.corpora.some((corpus) => readsCorpus(consumer, corpus))) {\n416:           unbacked.push(`${surface.id}: ${consumer} reads none of ${surface.corpora.join(', ')}`);\n417:         }\n418:       }\n419:       for (const corpus of surface.corpora) {\n420:         const live = surface.consumers.filter((consumer) => existsSync(join(RUNTIME_ROOT, consumer)));\n421:         if (!live.some((consumer) => readsCorpus(consumer, corpus))) {\n422:           unbacked.push(`${surface.id}: no consumer reads ${corpus}`);\n423:         }\n424:       }\n425:     }\n426:     for (const file of Object.keys(NON_SCORING_REFERENCES)) {\n427:       const corpora = Object.keys(CORPUS_REFERENCE) as CorpusId[];\n428:       if (!existsSync(join(RUNTIME_ROOT, file)) || !corpora.some((corpus) => readsCorpus(file, corpus))) {\n429:         unbacked.push(`non-scoring exemption ${file} no longer names a scored corpus`);\n430:       }\n431:     }\n432:     expect(unbacked, `Declarations no file backs (correct or remove them):\\n  ${unbacked.join('\\n  ')}`).toEqual([]);\n433:   });\n434: \n435:   it('declares every runtime file that reads a scored corpus', () => {\n436:     const declared = new Map<string, Set<CorpusId>>();\n437:     for (const surface of SCORING_SURFACES) {\n438:       for (const consumer of surface.consumers) {\n439:         const corpora = declared.get(consumer) ?? new Set<CorpusId>();\n440:         for (const corpus of surface.corpora) corpora.add(corpus);\n441:         declared.set(consumer, corpora);\n442:       }\n443:     }\n444:     const missingConsumers = [...declared.keys()].filter((consumer) => !existsSync(join(RUNTIME_ROOT, consumer)));\n445:     expect(missingConsumers, `Declared consumers that no longer exist: ${missingConsumers.join(', ')}`).toEqual([]);\n446: \n447:     const undeclared: string[] = [];\n448:     for (const path of listRuntimeSourceFiles(RUNTIME_ROOT)) {\n449:       const file = relative(RUNTIME_ROOT, path).split('\\\\').join('/');\n450:       if (NON_SCORING_REFERENCES[file] !== undefined) continue;\n451:       const text = readFileSync(path, 'utf8');\n452:       for (const [corpus, pattern] of Object.entries(CORPUS_REFERENCE) as [CorpusId, RegExp][]) {\n453:         if (pattern.test(text) && !declared.get(file)?.has(corpus)) undeclared.push(`${file} reads ${corpus}`);\n454:       }\n455:     }\n456:     expect(\n457:       undeclared,\n458:       `Runtime files that read a scored corpus but are not declared as a scoring surface:\\n  ${undeclared.join('\\n  ')}`,\n459:     ).toEqual([]);\n460:   });\n461: \n462:   it('holds top-1 at or above the committed baseline', () => {\n463:     const baselineCorrect = BASELINE.metrics.holdout_top1.correct;\n464:     expect(\n465:       HOLDOUT_CORRECT,\n466:       `holdout top-1 regressed: live=${HOLDOUT_CORRECT}/${HOLDOUT.length} baseline=${baselineCorrect}. `\n467:       + 'A drop means a scorer or metadata change hurt generalization.',\n468:     ).toBeGreaterThanOrEqual(baselineCorrect);\n469:   });\n470: });"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\".skilled/skills/system-skill-advisor/runtime/tests/parity/holdout-independent.vitest.ts\"}"},"time":{"start":1794551566118,"end":1794551566364}}}}
