lly(), holdout: emptyAttachedTally() });\n427:    // the flag nothing here runs and the prompt embedding is the direct call below.\n446:      perCommand.set(command, { typed: emptyTally(), plain: { tune: emptyTally(), holdout: emptyTally() } });\n450:    const plain = { tune: emptyTally(), holdout: emptyTally() };\n473:    const plainAttached = { tune: emptyAttachedTally(), holdout: emptyAttachedTally() };\n479:      // The recommend path supplies the semantic lane's prompt vector through this\n483:      const score = () => scoreAdvisorPrompt(row.prompt, { workspaceRoot });\n484:      const result = embedPrompt === null ? score() : await embedPrompt(row.prompt, score);\n494:      const isPlainSplit = row.row_type === 'plain' && (row.split === 'tune' || row.split === 'holdout');\n500:        ? attachCommand(topId, readCompiledRoute(workspaceRoot, topId, row.prompt), row.prompt)\n505:      const delivered = typedCommandForTop(topId, row.prompt)?.command ?? attached;\n540:      // Silence is the requirement for a near miss, a prompt that must not\n563:      // bridge displacing the skill the prompt actually asked for.\n594:        holdout: attachedTallyJson(family.holdout),\n609:          holdout: { correct: plain.holdout.top1, total: plain.holdout.rows },\n613:          holdout: { correct: plain.holdout.top3, total: plain.holdout.rows },\n630:          holdout: attachedTallyJson(plainAttached.holdout),\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"694:  const prompt = typeof entry.prompt === 'string' ? entry.prompt : '';\n937:    prompt: typeof row.prompt === 'string' ? row.prompt : '',\n966:    prompt: variant === 'typed' ? ':auto' : '',\n=== BASELINE READ ===\n5:// Captures how the built scorer routes the command-prompt corpus under the\n9:// prompt that names a slash command reaches that command's bridge, a prompt\n46:import { existsSync, mkdtempSync, readdirSync, readFileSync, rmSync, writeFileSync } from 'node:fs';\n58:const CORPUS_JSONL = resolve(HERE, 'command-prompts.jsonl');\n114:    recorded = JSON.parse(readFileSync(SCORER_EVAL_BASELINE_JSON, 'utf8')).capturedAt;\n190:  return `sha256:${createHash('sha256').update(readFileSync(path)).digest('hex')}`;\n197:  const lines = readFileSync(path, 'utf8').split('\\n');\n234:  const bridges = JSON.parse(readFileSync(path, 'utf8'));\n251:function readCompiledRoute(workspaceRoot, hubId, prompt) {\n253:    const stdout = execFileSync('node', [join(workspaceRoot, COMPILED_ROUTE_CLI), '--hub', hubId, '--prompt-stdin'], {\n255:      input: prompt,\n269:// bridge displacing the skill the prompt actually asked for. The order is\n331:    byFamily.set(namespace, { tune: emptyAttachedTally(), holdout: emptyAttachedTally() });\n427:    // the flag nothing here runs and the prompt embedding is the direct call below.\n446:      perCommand.set(command, { typed: emptyTally(), plain: { tune: emptyTally(), holdout: emptyTally() } });\n450:    const plain = { tune: emptyTally(), holdout: emptyTally() };\n473:    const plainAttached = { tune: emptyAttachedTally(), holdout: emptyAttachedTally() };\n479:      // The recommend path supplies the semantic lane's prompt vector through this\n483:      const score = () => scoreAdvisorPrompt(row.prompt, { workspaceRoot });\n484:      const result = embedPrompt === null ? score() : await embedPrompt(row.prompt, score);\n494:      const isPlainSplit = row.row_type === 'plain' && (row.split === 'tune' || row.split === 'holdout');\n500:        ? attachCommand(topId, readCompiledRoute(workspaceRoot, topId, row.prompt), row.prompt)\n505:      const delivered = typedCommandForTop(topId, row.prompt)?.command ?? attached;\n540:      // Silence is the requirement for a near miss, a prompt that must not\n563:      // bridge displacing the skill the prompt actually asked for.\n594:        holdout: attachedTallyJson(family.holdout),\n609:          holdout: { correct: plain.holdout.top1, total: plain.holdout.rows },\n613:          holdout: { correct: plain.holdout.top3, total: plain.holdout.rows },\n630:          holdout: attachedTallyJson(plainAttached.holdout),\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"cd /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research && grep -n \\\"\\\\.prompt\\\\|prompt:\\\" .skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/score-command-transcripts.mjs | head -40; echo \\\"=== BASELINE READ ===\\\"; grep -n \\\"readFileSync\\\\|PROMPTS\\\\|split ===\\\\|holdout\\\\|prompt\\\" .skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/capture-command-routing-baseline.mjs | head -50\"}"},"time":{"start":1794550450664,"end":1794550452944}}}}
