ored,\n1259:     unscoredRuns: tally.unscoredRuns,\n1260:     startRate: rate(tally.started, tally.startRows),\n1261:     cappedStartRows: tally.cappedStartRows,\n1262:     offered: tally.offered,\n1263:     cappedOfferRows: tally.cappedOfferRows,\n1264:     startedOfOffered: tally.startedOfOffered,\n1265:     offerFieldAbsent: tally.offerFieldAbsent,\n1266:     offerReached: tally.offerReached,\n1267:     deliveryUnknown: tally.deliveryUnknown,\n1268:     offerSeen: tally.offerSeen,\n1269:     offerDeclined: tally.offerDeclined,\n1270:     commandLineRate: rate(tally.commandLineRuns, tally.scored),\n1271:     unsafe: tally.unsafe,\n1272:     repeatedCommandLines: tally.repeatedCommandLines,\n1273:     loopsWithoutInit: tally.loopsWithoutInit,\n1274:     loops: tally.loops,\n1275:     byPolicy: Object.fromEntries(\n1276:       POLICY_KEYS.map((key) => [key, { ...tally.byPolicy[key] }]),\n1277:     ),\n1278:   };\n1279: }\n1280: \n1281: function addScored(tally, result) {\n1282:   tally.scored += 1;\n1283:   if (result.capped) tally.capped += 1;\n1284:   // An offer is a fact about the head the reader saw, so it counts whatever the\n1285:   // row's policy and whether the turn hit its cap. A capped turn still shows that\n1286:   // its head named the command, but it cannot show the command was taken.\n1287:   if (result.offered) {\n1288:     tally.offered += 1;\n1289:     if (result.capped) tally.cappedOfferRows += 1;\n1290:     else if (result.started) tally.startedOfOffered += 1;\n1291:     // An offer on a brief that never arrived cannot be declined, so it is\n1292:     // counted apart from the offers the run could have taken.\n1293:     if (result.briefDelivered !== false) tally.offerReached += 1;\n1294:   }\n1295:   if (result.offerFieldAbsent) tally.offerFieldAbsent += 1;\n1296:   // A declined `COMMAND:` line is the turn reporting it saw the command and turned\n1297:   // it down, so the seen offer and the refusal are counted apart from the head.\n1298:   if (result.offerSeen) tally.offerSeen += 1;\n1299:   if (result.commandState === 'declined') tally.offerDeclined += 1;\n1300:   if (result.briefDelivered === 'unknown') tally.deliveryUnknown += 1;\n1301:   if (result.startRow) {\n1302:     // A capped turn stopped before its start could be judged, so it is reported\n1303:     // apart from the rate rather than counted as a start the run did not make.\n1304:     if (result.capped) tally.cappedStartRows += 1;\n1305:     else {\n1306:       tally.startRows += 1;\n1307:       if (result.started) tally.started += 1;\n1308:     }\n1309:   }\n1310:   if (result.commandLines > 0) tally.commandLineRuns += 1;\n1311:   if (result.unsafe) tally.unsafe += 1;\n1312:   tally.repeatedCommandLines += result.repeated;\n1313:   if (result.loop !== null) {\n1314:     tally.loops += 1;\n1315:     if (result.loop === false) tally.loopsWithoutInit += 1;\n1316:   }\n1317:   if (result.policy === null) return;\n1318: \n1319:   const policy = tally.byPolicy[result.policy];\n1320:   policy.rows += 1;\n1321:   if (result.capped) policy.capped += 1;\n1322:   if (result.started) policy.started += 1;\n1323:   if (result.wrote) policy.wrote += 1;\n1324: }\n1325: \n1326: // A log that yields no scored row leaves every runtime and arm absent. An empty\n1327: // summary states that, where a zero rate would claim a run that never happened.\n1328: async function summarize(options) {\n1329:   const labels = loadRowLabels();\n1330:   const summary = {};\n1331: \n1332:   for (const line of selectedLines(options)) {\n1333:     const arm = armOf(line);\n1334:     const entry = summary[line.runtime] ?? { unscored: 0 };\n1335:     const tally = entry[arm] ?? newTally();\n1336:     entry[arm] = tally;\n1337:     summary[line.runtime] = entry;\n1338: \n1339:     tally.runs += 1;\n[Output truncated. Continue reading with offset: 1340]"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"limit\":150,\"offset\":1190,\"path\":\".skil