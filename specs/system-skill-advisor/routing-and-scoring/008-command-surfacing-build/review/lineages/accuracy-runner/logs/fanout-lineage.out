{"type":"tool_use","timestamp":1794551602206,"sessionID":"ses_e2c799a7bffe903YpgFMcmoKDC","part":{"partID":"prt_1d39c57b0001ORi43WC3NNpQLE","sessionID":"ses_e2c799a7bffe903YpgFMcmoKDC","messageID":"msg_1d39bd7b1001PoptB7tY4T7xIs","type":"tool","id":"call_f74d042b1ce842578ec07188","tool":"shell","state":{"status":"completed","input":{"command":"cd /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research && grep -n \"describe.skip\\|it.skip\\|xit(\\|TODO\\|FIXME\" .skilled/skills/system-skill-advisor/runtime/tests/legacy/*.vitest.ts .skilled/skills/system-skill-advisor/runtime/bench/hook-brief-signal-noise.bench.ts | head -20; echo \"=== legacy test titles ===\"; for f in .skilled/skills/system-skill-advisor/runtime/tests/legacy/*.vitest.ts; do echo \"-- $f\"; grep -n \"describe(\\|  it(\" \"$f\" | head -6; done"},"output":"=== legacy test titles ===\n-- .skilled/skills/system-skill-advisor/runtime/tests/legacy/advisor-brief-producer.vitest.ts\n90:describe('buildSkillAdvisorBrief', () => {\n91:  it('AS1 skips empty prompt', async () => {\n99:  it('AS2 skips /help', async () => {\n107:  it('AS3 fires on work-intent prompt and wraps advisor envelope', async () => {\n126:  it('routes a prompt longer than advisor_recommend accepts on its head', async () => {\n136:  it('uses the shared ambiguous renderer contract for payload and brief content', async () => {\n-- .skilled/skills/system-skill-advisor/runtime/tests/legacy/advisor-corpus-parity.vitest.ts\n101:describe('advisor 195-prompt corpus regression-protection parity', () => {\n102:  it('preserves Python-correct top-1 decisions while allowing native improvements', async () => {\n-- .skilled/skills/system-skill-advisor/runtime/tests/legacy/advisor-freshness.vitest.ts\n125:describe('getAdvisorFreshness', () => {\n127:  it('AS1 returns live state when all sources are present and fresh', () => {\n144:  it('AS2 returns stale when SKILL.md is newer than skill-graph.sqlite', () => {\n157:  it('AS3 returns absent when skill-graph.sqlite is missing and no JSON fallback exists', () => {\n171:  it('AS4 returns unavailable when the source probe fails', () => {\n186:  it('AS5 suppresses deleted skills instead of reusing stale fingerprints', () => {\n-- .skilled/skills/system-skill-advisor/runtime/tests/legacy/advisor-graph-evidence-calibration.vitest.ts\n18:describe('advisor graph evidence calibration', () => {\n19:  it('lowers uncertainty when graph evidence is the majority signal', () => {\n-- .skilled/skills/system-skill-advisor/runtime/tests/legacy/advisor-graph-health.vitest.ts\n22:describe('advisor graph health', () => {\n23:  it('validates graph metadata without orphan skills', () => {\n34:  it('keeps health ok when skill-advisor is the only graph-only node', () => {\n-- .skilled/skills/system-skill-advisor/runtime/tests/legacy/advisor-observability.vitest.ts\n35:describe('advisor observability contract', () => {\n36:  it('defines the speckit_advisor_hook metric namespace and closed labels', () => {\n82:  it('serializes AdvisorHookDiagnosticRecord JSONL without forbidden prompt-bearing fields', () => {\n107:  it('preserves runtime and delivery metadata in diagnostic serialization', () => {\n143:  it('rejects diagnostic records with forbidden fields', () => {\n157:  it('builds advisor-hook-health with last-N records, rolling cache hit rate, and p95', () => {\n-- .skilled/skills/system-skill-advisor/runtime/tests/legacy/advisor-privacy.vitest.ts\n81:describe('advisor privacy audit', () => {\n82:  it('keeps raw prompts out of envelope sources, metrics, stderr JSONL, health, and cache keys', async () => {\n-- .skilled/skills/system-skill-advisor/runtime/tests/legacy/advisor-prompt-cache.vitest.ts\n12:describe('skill advisor prompt cache', () => {\n13:  it('returns exact HMAC cache hits within the TTL', () => {\n34:  it('invalidates all prior entries when sourceSignature changes', () => {\n54:  it('uses opaque HMAC keys and never embeds raw prompt text', () => {\n68:  it('incl