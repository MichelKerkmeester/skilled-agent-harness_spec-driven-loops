skill-advisor/runtime/tests/scorer/declared-phrase-specificity.vitest.ts\n.skilled/skills/system-skill-advisor/runtime/tests/scorer/projection-fallback-049-005.vitest.ts\n.skilled/skills/system-skill-advisor/runtime/tests/scorer/native-scorer.vitest.ts\n.skilled/skills/system-skill-advisor/runtime/tests/daemon-watcher-new-root-ingestion.vitest.ts\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"grep -rn \\\"intent_signals\\\" .skilled/skills/system-skill-advisor --include=*.ts --include=*.cjs --include=*.mjs --include=*.js --include=*.md -l | head -30\",\"workdir\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research\"}"},"time":{"start":1794865390558,"end":1794865393412}}}}
