pt(prompt: string, options: AdvisorScoringOptions): AdvisorScoringResult {\n1264-  const projection = projectionWithUsableSkillIds(\n1265-    options.projection ?? loadAdvisorProjection(options.workspaceRoot),\n1266-  );\n1267-  const promptLower = prompt.toLowerCase();\n1268-  const queryClass = classifyAdvisorQuery(promptLower);\n1269-  const weights = effectiveScorerWeights(\n1270-    options.laneWeightsOverride,\n1271-    isAdvisorQueryClassRoutingEnabled() ? queryClass : 'unknown',\n1272-  );\n1273-  const disabled = new Set(options.disabledLanes ?? []);\n1274-  const affordances = normalize(options.affordances ?? []);\n1275-  const useRrfFusion = isAdvisorRrfFusionEnabled();\n1276-  const useExactSemanticRerank = useRrfFusion && isAdvisorExactSemanticRerankEnabled();\n1277-  const { laneScores, graphConflictMatches, graphSupportBySeed } = buildLaneScores(\n1278-    prompt,\n1279-    projection,\n1280-    disabled,\n1281-    affordances,\n1282-    useRrfFusion,\n1283-  );\n=== dist ===\n.skilled/skills/system-skill-advisor/runtime/dist/runtime/lib/scorer/fusion.js\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"grep -n \\\"export function scoreAdvisorPrompt\\\\|function scoreAdvisorPrompt\\\" -A 20 .skilled/skills/system-skill-advisor/runtime/lib/scorer/fusion.ts | head -40; echo \\\"=== dist ===\\\"; ls .skilled/skills/system-skill-advisor/runtime/dist/runtime/lib/scorer/fusion.js 2>&1\",\"workdir\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research\"}"},"time":{"start":1794865486159,"end":1794865488950}}}}
