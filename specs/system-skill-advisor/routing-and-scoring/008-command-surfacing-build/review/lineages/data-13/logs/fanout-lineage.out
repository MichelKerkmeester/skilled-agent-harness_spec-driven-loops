\",\\\"the advisor briefs me every morning\\\",\\\"the arena is clean now\\\",\\\"clean the routing table\\\",\\\"clean arena seating chart for the stadium\\\",\\\"check whether the skill graph is stale and show me how to rebuild it\\\",\\\"check for skilled updates\\\"];\\nfor (const prompt of cases) {\\n  const r = scoreAdvisorPrompt(prompt, { workspaceRoot: process.cwd(), projection: p });\\n  const recs = (r.recommendations||[]);\\n  console.log(JSON.stringify({ prompt, top: recs[0]?.skill ?? null, conf: recs[0]?.confidence ?? null, second: recs[1]?.skill ?? null, passes: recs[0]?.passes_threshold ?? null }));\\n}\\n' 2>&1 | tail -8\",\"workdir\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research\"}"},"time":{"start":1794866370759,"end":1794866375446}}}}
