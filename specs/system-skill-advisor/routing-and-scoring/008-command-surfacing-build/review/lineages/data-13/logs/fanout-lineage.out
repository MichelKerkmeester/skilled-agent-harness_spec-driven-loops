on.ts:94:    intentSignals: ['/create:agent', 'create new agent', 'create agent', 'new agent', 'make new agent'],\n.skilled/skills/system-skill-advisor/runtime/lib/scorer/projection.ts:112:    intentSignals: ['/create:manual-testing-playbook', 'create testing playbook', 'create test playbook', 'testing playbook'],\n.skilled/skills/system-skill-advisor/runtime/lib/scorer/projection.ts:130:    intentSignals: ['/doctor:setup'],\n.skilled/skills/system-skill-advisor/runtime/lib/scorer/projection.ts:149:    intentSignals: ['/doctor:env list'],\n.skilled/skills/system-skill-advisor/runtime/lib/scorer/projection.ts:168:    intentSignals: ['/doctor:git hooks'],\n.skilled/skills/system-skill-advisor/runtime/lib/scorer/projection.ts:187:    intentSignals: ['/doctor:runtime-mirrors'],\n.skilled/skills/system-skill-advisor/runtime/lib/scorer/projection.ts:206:    intentSignals: ['/doctor:skill-advisor skill-budget'],\n.skilled/skills/system-skill-advisor/runtime/lib/scorer/projection.ts:225:    intentSignals: ['/doctor:git setup'],\n.skilled/skills/system-skill-advisor/runtime/lib/scorer/projection.ts:244:    intentSignals: ['/doctor:git standards'],\n.skilled/skills/system-skill-advisor/runtime/lib/scorer/projection.ts:262:    intentSignals: ['/doctor:sk-code setup'],\n.skilled/skills/system-skill-advisor/runtime/lib/scorer/projection.ts:281:    intentSignals: ['/doctor:skill-advisor tune'],\n.skilled/skills/system-skill-advisor/runtime/lib/scorer/projection.ts:299:    intentSignals: ['/doctor:skill-advisor rebuild'],\n.skilled/skills/system-skill-advisor/runtime/lib/scorer/projection.ts:317:    intentSignals: ['/doctor:skill-advisor parent-skill'],\n.skilled/skills/system-skill-advisor/runtime/lib/scorer/projection.ts:336:    intentSignals: ['/doctor:skill-advisor skill-graph-freshness'],\n.skilled/skills/system-skill-advisor/runtime/lib/scorer/projection.ts:355:    intentSignals: ['/doctor:skill-advisor router-reach'],\n.skilled/skills/system-skill-advisor/runtime/lib/scorer