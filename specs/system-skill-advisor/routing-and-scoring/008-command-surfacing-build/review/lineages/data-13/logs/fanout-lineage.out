 64 Nov 16 22:41 pending\ndrwx------@ 2 michelkerkmeester  staff   64 Nov 16 22:41 quarantine\ndrwx------@ 2 michelkerkmeester  staff   64 Nov 16 22:41 recoveries\ndrwx------@ 2 michelkerkmeester  staff   64 Nov 16 22:41 stale-locks\n\nspecs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/review/lineages/data-13/deep-review-effect-ledger:\ntotal 0\ndrwx------@ 7 michelkerkmeester  staff  224 Nov 16 22:41 .\ndrwx------@ 7 michelkerkmeester  staff  224 Nov 16 22:41 ..\ndrwx------@ 3 michelkerkmeester  staff   96 Nov 16 22:41 frames\ndrwx------@ 2 michelkerkmeester  staff   64 Nov 16 22:41 pending\ndrwx------@ 2 michelkerkmeester  staff   64 Nov 16 22:41 quarantine\ndrwx------@ 2 michelkerkmeester  staff   64 Nov 16 22:41 recoveries\ndrwx------@ 2 michelkerkmeester  staff   64 Nov 16 22:41 stale-locks\n\nspecs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/review/lineages/data-13/locks-and-fencing-v1:\ntotal 0\ndrwxr-xr-x@ 3 michelkerkmeester  staff   96 Nov 16 22:41 .\ndrwx------@ 7 michelkerkmeester  staff  224 Nov 16 22:41 ..\ndrwxr-xr-x@ 4 michelkerkmeester  staff  128 Nov 16 22:41 2153efebfc6fc439b5f53412041541aeb7e0d32c56ab6e944a316000bf174704\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"cat specs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/review/lineages/data-13/invocation-metadata.json; echo \\\"---LEDGERS---\\\"; ls -la specs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/review/lineages/data-13/deep-review-audit-ledger specs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/review/lineages/data-13/deep-review-effect-ledger specs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/review/lineages/data-13/locks-and-fencing-v1\",\"workdir\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research\"}"},"time":{"start":1794865334781,"end":1794865336129}}}}
