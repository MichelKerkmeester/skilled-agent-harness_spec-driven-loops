52-command-surfacing-research"},"output":"  now:    system-skill-advisor:0.82, sk-code:0.82, system-spec-kit:0.82\n  before: system-spec-kit:0.82, sk-code:0.82, mcp-tooling:0.82\nthe routing arm of our proxy keeps dropping requests, debug it\n  now:    system-skill-advisor:0.82, sk-code:0.82\n  before: sk-code:0.82\nupdate the advisor briefs template to be clearer\n  now:    system-skill-advisor:0.82, sk-doc:0.82, sk-prompt:0.82\n  before: sk-doc:0.82, sk-prompt:0.82, system-skill-advisor:0.82\nthe advisor briefs the board every morning, summarise the format\n  now:    system-skill-advisor:0.82\n  before: none\nclean arena seating chart for the stadium\n  now:    system-skill-advisor:0.82, sk-design:0.82\n  before: sk-design:0.82\nwrite the behaviour arena results into the report\n  now:    system-skill-advisor:0.82, sk-doc:0.82, system-spec-kit:0.82\n  before: sk-doc:0.82, system-spec-kit:0.82, sk-design:0.82\ncheck whether the skill graph is stale and show me how to rebuild it\n  now:    command-doctor-helper:0.8\n  before: command-doctor-helper:0.8\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"  now:    system-skill-advisor:0.82, sk-code:0.82, system-spec-kit:0.82\n  before: system-spec-kit:0.82, sk-code:0.82, mcp-tooling:0.82\nthe routing arm of our proxy keeps dropping requests, debug it\n  now:    system-skill-advisor:0.82, sk-code:0.82\n  before: sk-code:0.82\nupdate the advisor briefs template to be clearer\n  now:    system-skill-advisor:0.82, sk-doc:0.82, sk-prompt:0.82\n  before: sk-doc:0.82, sk-prompt:0.82, system-skill-advisor:0.82\nthe advisor briefs the board every morning, summarise the format\n  now:    system-skill-advisor:0.82\n  before: none\nclean arena seating chart for the stadium\n  now:    system-skill-advisor:0.82, sk-design:0.82\n  before: sk-design:0.82\nwrite the behaviour arena results into the report\n  now:    system-skill-advisor:0.82, sk-doc:0.82, system-spec-kit:0.82\n  before: sk-doc:0.82, system-spec-kit:0.82, sk-design:0.82\ncheck whether the skill graph is stale and show me how to rebuild it\n  now:    command-doctor-helper:0.8\n  before: command-doctor-helper:0.8\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"node --input-type=module -e '\\nimport { scoreAdvisorPrompt } from \\\"./.skilled/skills/system-skill-advisor/runtime/dist/runtime/lib/scorer/fusion.js\\\";\\nimport { loadAdvisorProjection } from \\\"./.skilled/skills/system-skill-advisor/runtime/dist/runtime/lib/scorer/projection.js\\\";\\nconst p = loadAdvisorProjection(process.cwd());\\nconst NEW = [\\\"skill graph is stale\\\",\\\"rebuild the skill graph\\\",\\\"vibe prompt hook\\\",\\\"advisor briefs\\\",\\\"behaviour arena\\\",\\\"clean arena\\\",\\\"routing arm\\\"];\\nconst stripped = { ...p, skills: p.skills.map(s => s.id === \\\"system-skill-advisor\\\" ? { ...s, intentSignals: (s.intentSignals||[]).filter(x => !NEW.includes(x)) } : s) };\\nconst show = (r) => (r.recommendations||[]).slice(0,3).map(x=>`${x.skill}:${x.confidence}`).join(\\\", \\\") || \\\"none\\\";\\nconst prompts = [\\n  \\\"fix the routing arm in the nginx config\\\",\\n  \\\"the routing arm of our proxy keeps dropping requests, debug it\\\",\\n  \\\"update the advisor briefs template to be clearer\\\",\\n  \\\"the advisor briefs the board every morning, summarise the format\\\",\\n  \\\"clean arena seating chart for the stadium\\\",\\n  \\\"write the behaviour arena results into the report\\\",\\n  \\\"check whether the skill graph is stale and show me how to rebuild it\\\"\\n];\\nfor (const prompt of prompts) {\\n  const now = scoreAdvisorPrompt(prompt, { workspaceRoot: process.cwd(), projection: p });\\n  const before = scoreAdvisorPrompt(prompt, { workspaceRoot: process.cwd(), projection: stripped });\\n  console.log(prompt);\\n  console.log(\\\"  now:   \\\", show(now));\\n  console.log(\\\"  before:\\\", show(before));\\n}\\n' 2>&1 | tail -20\",\"workdir\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research\"}"},"time":{"start":1794865603852,"end":1794865610397}}}}
