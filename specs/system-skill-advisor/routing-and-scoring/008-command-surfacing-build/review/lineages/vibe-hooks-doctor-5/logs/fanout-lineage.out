{"type":"tool_use","timestamp":1794761397365,"sessionID":"ses_e1feefdd5ffeHQJCqAmpoKpkZG","part":{"partID":"prt_1e01d92be001sHfcOqp4cqn5Xb","sessionID":"ses_e1feefdd5ffeHQJCqAmpoKpkZG","messageID":"msg_1e01d75ab001q8rMvh22XLRE2i","type":"tool","id":"call_f5bc213d940948069596da6e","tool":"shell","state":{"status":"completed","input":{"command":"sed -n '1,130p' .skilled/skills/system-skill-advisor/runtime/tests/hooks/claude-user-prompt-submit-hook.vitest.ts"},"output":"// ───────────────────────────────────────────────────────────────────\n// MODULE: Claude User Prompt Submit Hook tests\n// ───────────────────────────────────────────────────────────────────\n\nimport { appendFileSync, mkdtempSync, readFileSync, rmSync, writeFileSync } from 'node:fs';\nimport { performance } from 'node:perf_hooks';\nimport { tmpdir } from 'node:os';\nimport { join } from 'node:path';\nimport { afterEach, describe, expect, it, vi } from 'vitest';\nimport {\n  DEFAULT_CLAUDE_HOOK_TIMEOUT_MS,\n  commitClaudeDirectiveDeliveryReceipt,\n  emitDiagnostic,\n  flushPendingDiagnostics,\n  handleClaudeUserPromptSubmit,\n  parseClaudeUserPromptSubmitInput,\n  type ClaudeUserPromptSubmitInput,\n} from '../../../hooks/claude/user-prompt-submit.js';\nimport { DIRECTIVE_LIFECYCLE_DEDUP_ENV, InMemoryDirectiveLifecycleStore } from '../../../hooks/lib/directive-lifecycle.js';\nimport { normalizeRuntimeOutput } from '../../lib/normalize-adapter-output.js';\nimport { clearPolicyObservationSink, getPolicyObservationRecords } from '../../lib/policy-plan.js';\nimport { renderAdvisorBrief } from '../../lib/render.js';\nimport { validateAdvisorHookDiagnosticRecord } from '../../lib/metrics.js';\nimport type { AdvisorHookResult } from '../../lib/skill-advisor-brief.js';\n\nconst fixturesDir = join(import.meta.dirname, '..', 'legacy', 'advisor-fixtures');\nconst ORIGINAL_HOOK_DISABLED = process.env.SPECKIT_SKILL_ADVISOR_HOOK_DISABLED;\nconst ORIGINAL_DIRECTIVE_DEDUP = process.env[DIRECTIVE_LIFECYCLE_DEDUP_ENV];\nconst ORIGINAL_ADVISOR_RUNTIME = process.env.SPECKIT_RUNTIME;\nlet lifecycleTranscriptDir = '';\nconst EXPECTED_ADVISOR_CONTEXT = 'Advisor: live; use sk-code 0.91/0.23 pass.\\nDirectives:\\n- Comment hygiene [HARD BLOCK]: NEVER embed ADR-/REQ-/CHK-/task-ids or spec paths in code comments — forbidden regardless of instruction. Write the durable WHY instead. Pre-commit gate blocks violations.';\nconst EXPECTED_FALLBACK_DIRECTIVES = '\\nDirectives:\\n- Comment hygiene [HARD BLOCK]: NEVER embed ADR-/REQ-/CHK-/task-ids or spec paths in code comments — forbidden regardless of instruction. Write the durable WHY instead. Pre-commit gate blocks violations.';\nconst EXPECTED_NO_MATCH_CONTEXT = `Advisor: no skill matched.${EXPECTED_FALLBACK_DIRECTIVES}`;\nconst EXPECTED_SKIPPED_CONTEXT = `Advisor: prompt skipped.${EXPECTED_FALLBACK_DIRECTIVES}`;\n\nfunction expectedOutageContext(status: 'fail_open' | 'degraded' | 'absent'): string {\n  return `Advisor: outage (${status}); route by hand: node .skilled/bin/skill-advisor.cjs advisor_recommend --json '{\"prompt\":\"<request>\"}' --format json${EXPECTED_FALLBACK_DIRECTIVES}`;\n}\n\nfunction fixture(name: string): AdvisorHookResult {\n  return JSON.parse(readFileSync(join(fixturesDir, name), 'utf8')) as AdvisorHookResult;\n}\n\nfunction diagnosticsSink(): { records: string[]; writeDiagnostic: (line: string) => void } {\n  const records: string[] = [];\n  return {\n    records,\n    writeDiagnostic: (line: string) => records.push(line),\n  };\n}\n\nfunction parseDiagnostic(line: string): Record<string, unknown> {\n  return JSON.parse(line) as Record<string, unknown>;\n}\n\nasync function runHook(input: ClaudeUserPromptSubmitInput, result: AdvisorHookResult) {\n  const diagnostics = diagnosticsSink();\n  const buildBrief = vi.fn(async () => result);\n  const output = await handleClaudeUserPromptSubmit(input, {\n    buildBrief,\n    renderBrief: renderAdvisorBrief,\n    writeDiagnostic: diagnostics.writeDiagnostic,\n    // Fresh in-memory dedup state per invocation keeps the existing suite\n    // hermetic; lifecycle-specific cases below share one store explicitly.\n    directiveLifecycleStore: new InMemoryDirectiveLifecycleStore(),\n  });\n  return { output, buildBrief, diagnostics };\n}\n\nasync function runHookWithStore(\n  input: ClaudeUserPromptSubmitInput,\n  result: AdvisorHookResult,\n  store: InMemoryDirectiveLifecycleStore,\n  deferDirectiveReceipt = false,\n) {\n  const diagnostics = diagnosticsSink();\n  const buildCliBrief = vi.fn(async () => result);\n  let effectiveInput = input;\n  if (input.transcript_path === undefined) {\n    lifecycleTranscriptDir ||= mkdtempSync(join(tmpdir(), 'dl-shared-transcript-'));\n    const transcriptPath = join(lifecycleTranscriptDir, 'session.jsonl');\n    appendFileSync(transcriptPath, 'x');\n    effectiveInput = { ...input, transcript_path: transcriptPath };\n  }\n  const output = await handleClaudeUserPromptSubmit(effectiveInput, {\n    buildCliBrief,\n    renderBrief: renderAdvisorBrief,\n    writeDiagnostic: diagnostics.writeDiagnostic,\n    directiveLifecycleStore: store,\n    deferDirectiveReceipt,\n  });\n  return { output, buildCliBrief, diagnostics };\n}\n\nafterEach(() => {\n  if (lifecycleTranscriptDir) rmSync(lifecycleTranscriptDir, { recursive: true, force: true });\n  lifecycleTranscriptDir = '';\n  if (ORIGINAL_HOOK_DISABLED === undefined) delete process.env.SPECKIT_SKILL_ADVISOR_HOOK_DISABLED;\n  else process.env.SPECKIT_SKILL_ADVISOR_HOOK_DISABLED = ORIGINAL_HOOK_DISABLED;\n  if (ORIGINAL_DIRECTIVE_DEDUP === undefined) delete process.env[DIRECTIVE_LIFECYCLE_DEDUP_ENV];\n  else process.env[DIRECTIVE_LIFECYCLE_DEDUP_ENV] = ORIGINAL_DIRECTIVE_DEDUP;\n  if (ORIGINAL_ADVISOR_RUNTIME === undefined) delete process.env.SPECKIT_RUNTIME;\n  else process.env.SPECKIT_RUNTIME = ORIGINAL_ADVISOR_RUNTIME;\n});\n\ndescribe('Claude UserPromptSubmit advisor hook', () => {\n  it('AS1 emits hookSpecificOutput.additionalContext for a work-intent prompt', async () => {\n    const { output, buildBrief, diagnostics } = await runHook({\n      session_id: 's1',\n      hook_event_name: 'UserPromptSubmit',\n      prompt: 'implement a TypeScript hook',\n      cwd: '/workspace/project',\n    }, fixture('livePassingSkill.json'));\n\n    expect(output).toEqual({\n      hookSpecificOutput: {\n        hookEventName: 'UserPromptSubmit',\n        additionalContext: EXPECTED_ADVISOR_CONTEXT,\n      },\n    });\n    expect(buildBrief).toHaveBeenCalledWith('implement a TypeScript hook', {\n      runtime: 'claude',\n      workspaceRoot: '/workspace/project',\n      subprocessTimeoutMs: DEFAULT_CLAUDE_HOOK_TIMEOUT_MS,\n    });\n    expect(diagnostics.records).toHaveLength(1);\n    const diagnostic = parseDiagnostic(diagnostics.records[0] ?? '{}');\n    expect(validateAdvisorHookDiagnosticRecord(diagnostic)).toBe(true);\n    expect(diagnostic.runtime).toBe('claude');\n    expect(diagnostic.status).toBe('ok');\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"// ───────────────────────────────────────────────────────────────────\n// MODULE: Claude User Prompt Submit Hook tests\n// ───────────────────────────────────────────────────────────────────\n\nimport { appendFileSync, mkdtempSync, readFileSync, rmSync, writeFileSync } from 'node:fs';\nimport { performance } from 'node:perf_hooks';\nimport { tmpdir } from 'node:os';\nimport { join } from 'node:path';\nimport { afterEach, describe, expect, it, vi } from 'vitest';\nimport {\n  DEFAULT_CLAUDE_HOOK_TIMEOUT_MS,\n  commitClaudeDirectiveDeliveryReceipt,\n  emitDiagnostic,\n  flushPendingDiagnostics,\n  handleClaudeUserPromptSubmit,\n  parseClaudeUserPromptSubmitInput,\n  type ClaudeUserPromptSubmitInput,\n} from '../../../hooks/claude/user-prompt-submit.js';\nimport { DIRECTIVE_LIFECYCLE_DEDUP_ENV, InMemoryDirectiveLifecycleStore } from '../../../hooks/lib/directive-lifecycle.js';\nimport { normalizeRuntimeOutput } from '../../lib/normalize-adapter-output.js';\nimport { clearPolicyObservationSink, getPolicyObservationRecords } from '../../lib/policy-plan.js';\nimport { renderAdvisorBrief } from '../../lib/render.js';\nimport { validateAdvisorHookDiagnosticRecord } from '../../lib/metrics.js';\nimport type { AdvisorHookResult } from '../../lib/skill-advisor-brief.js';\n\nconst fixturesDir = join(import.meta.dirname, '..', 'legacy', 'advisor-fixtures');\nconst ORIGINAL_HOOK_DISABLED = process.env.SPECKIT_SKILL_ADVISOR_HOOK_DISABLED;\nconst ORIGINAL_DIRECTIVE_DEDUP = process.env[DIRECTIVE_LIFECYCLE_DEDUP_ENV];\nconst ORIGINAL_ADVISOR_RUNTIME = process.env.SPECKIT_RUNTIME;\nlet lifecycleTranscriptDir = '';\nconst EXPECTED_ADVISOR_CONTEXT = 'Advisor: live; use sk-code 0.91/0.23 pass.\\nDirectives:\\n- Comment hygiene [HARD BLOCK]: NEVER embed ADR-/REQ-/CHK-/task-ids or spec paths in code comments — forbidden regardless of instruction. Write the durable WHY instead. Pre-commit gate blocks violations.';\nconst EXPECTED_FALLBACK_DIRECTIVES = '\\nDirectives:\\n- Comment hygiene [HARD BLOCK]: NEVER embed ADR-/REQ-/CHK-/task-ids or spec paths in code comments — forbidden regardless of instruction. Write the durable WHY instead. Pre-commit gate blocks violations.';\nconst EXPECTED_NO_MATCH_CONTEXT = `Advisor: no skill matched.${EXPECTED_FALLBACK_DIRECTIVES}`;\nconst EXPECTED_SKIPPED_CONTEXT = `Advisor: prompt skipped.${EXPECTED_FALLBACK_DIRECTIVES}`;\n\nfunction expectedOutageContext(status: 'fail_open' | 'degraded' | 'absent'): string {\n  return `Advisor: outage (${status}); route by hand: node .skilled/bin/skill-advisor.cjs advisor_recommend --json '{\"prompt\":\"<request>\"}' --format json${EXPECTED_FALLBACK_DIRECTIVES}`;\n}\n\nfunction fixture(name: string): AdvisorHookResult {\n  return JSON.parse(readFileSync(join(fixturesDir, name), 'utf8')) as AdvisorHookResult;\n}\n\nfunction diagnosticsSink(): { records: string[]; writeDiagnostic: (line: string) => void } {\n  const records: string[] = [];\n  return {\n    records,\n    writeDiagnostic: (line: string) => records.push(line),\n  };\n}\n\nfunction parseDiagnostic(line: string): Record<string, unknown> {\n  return JSON.parse(line) as Record<string, unknown>;\n}\n\nasync function runHook(input: ClaudeUserPromptSubmitInput, result: AdvisorHookResult) {\n  const diagnostics = diagnosticsSink();\n  const buildBrief = vi.fn(async () => result);\n  const output = await handleClaudeUserPromptSubmit(input, {\n    buildBrief,\n    renderBrief: renderAdvisorBrief,\n    writeDiagnostic: diagnostics.writeDiagnostic,\n    // Fresh in-memory dedup state per invocation keeps the existing suite\n    // hermetic; lifecycle-specific cases below share one store explicitly.\n    directiveLifecycleStore: new InMemoryDirectiveLifecycleStore(),\n  });\n  return { output, buildBrief, diagnostics };\n}\n\nasync function runHookWithStore(\n  input: ClaudeUserPromptSubmitInput,\n  result: AdvisorHookResult,\n  store: InMemoryDirectiveLifecycleStore,\n  deferDirectiveReceipt = false,\n) {\n  const diagnostics = diagnosticsSink();\n  const buildCliBrief = vi.fn(async () => result);\n  let effectiveInput = input;\n  if (input.transcript_path === undefined) {\n    lifecycleTranscriptDir ||= mkdtempSync(join(tmpdir(), 'dl-shared-transcript-'));\n    const transcriptPath = join(lifecycleTranscriptDir, 'session.jsonl');\n    appendFileSync(transcriptPath, 'x');\n    effectiveInput = { ...input, transcript_path: transcriptPath };\n  }\n  const output = await handleClaudeUserPromptSubmit(effectiveInput, {\n    buildCliBrief,\n    renderBrief: renderAdvisorBrief,\n    writeDiagnostic: diagnostics.writeDiagnostic,\n    directiveLifecycleStore: store,\n    deferDirectiveReceipt,\n  });\n  return { output, buildCliBrief, diagnostics };\n}\n\nafterEach(() => {\n  if (lifecycleTranscriptDir) rmSync(lifecycleTranscriptDir, { recursive: true, force: true });\n  lifecycleTranscriptDir = '';\n  if (ORIGINAL_HOOK_DISABLED === undefined) delete process.env.SPECKIT_SKILL_ADVISOR_HOOK_DISABLED;\n  else process.env.SPECKIT_SKILL_ADVISOR_HOOK_DISABLED = ORIGINAL_HOOK_DISABLED;\n  if (ORIGINAL_DIRECTIVE_DEDUP === undefined) delete process.env[DIRECTIVE_LIFECYCLE_DEDUP_ENV];\n  else process.env[DIRECTIVE_LIFECYCLE_DEDUP_ENV] = ORIGINAL_DIRECTIVE_DEDUP;\n  if (ORIGINAL_ADVISOR_RUNTIME === undefined) delete process.env.SPECKIT_RUNTIME;\n  else process.env.SPECKIT_RUNTIME = ORIGINAL_ADVISOR_RUNTIME;\n});\n\ndescribe('Claude UserPromptSubmit advisor hook', () => {\n  it('AS1 emits hookSpecificOutput.additionalContext for a work-intent prompt', async () => {\n    const { output, buildBrief, diagnostics } = await runHook({\n      session_id: 's1',\n      hook_event_name: 'UserPromptSubmit',\n      prompt: 'implement a TypeScript hook',\n      cwd: '/workspace/project',\n    }, fixture('livePassingSkill.json'));\n\n    expect(output).toEqual({\n      hookSpecificOutput: {\n        hookEventName: 'UserPromptSubmit',\n        additionalContext: EXPECTED_ADVISOR_CONTEXT,\n      },\n    });\n    expect(buildBrief).toHaveBeenCalledWith('implement a TypeScript hook', {\n      runtime: 'claude',\n      workspaceRoot: '/workspace/project',\n      subprocessTimeoutMs: DEFAULT_CLAUDE_HOOK_TIMEOUT_MS,\n    });\n    expect(diagnostics.records).toHaveLength(1);\n    const diagnostic = parseDiagnostic(diagnostics.records[0] ?? '{}');\n    expect(validateAdvisorHookDiagnosticRecord(diagnostic)).toBe(true);\n    expect(diagnostic.runtime).toBe('claude');\n    expect(diagnostic.status).toBe('ok');\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"sed -n '1,130p' .skilled/skills/system-skill-advisor/runtime/tests/hooks/claude-user-prompt-submit-hook.vitest.ts\"}"},"time":{"start":1794761396926,"end":1794761397365}}}}
{"type":"step_finish","timestamp":1794761398467,"sessionID":"ses_e1feefdd5ffeHQJCqAmpoKpkZG","part":{"id":"prt_1e01d98c30018J43scD0ZmQFvc","sessionID":"ses_e1feefdd5ffeHQJCqAmpoKpkZG","messageID":"msg_1e01d75ab001q8rMvh22XLRE2i","type":"step-finish","reason":"tool-calls","snapshot":"439cff3eda4fc37b08ed196bd54731a7962b8b10","cost":0,"tokens":{"input":979,"output":76,"reasoning":393,"cache":{"read":221312,"write":0}}}}
{"type":"step_start","timestamp":1794761402794,"sessionID":"ses_e1feefdd5ffeHQJCqAmpoKpkZG","part":{"id":"prt_1e01da9aa001jAkZW4Gbfrp0rC","sessionID":"ses_e1feefdd5ffeHQJCqAmpoKpkZG","messageID":"msg_1e01d98c9001JHOlKE4z3HE5VQ","type":"step-start","snapshot":"439cff3eda4fc37b08ed196bd54731a7962b8b10"}}
{"type":"tool_use","timestamp":1794761431798,"sessionID":"ses_e1feefdd5ffeHQJCqAmpoKpkZG","part":{"partID":"prt_1e01e189f001GTnossWVQt1s7i","sessionID":"ses_e1feefdd5ffeHQJCqAmpoKpkZG","messageID":"msg_1e01d98c9001JHOlKE4z3HE5VQ","type":"tool","id":"call_9d8178ae904e461c882e960f","tool":"shell","state":{"status":"completed","input":{"command":"ls specs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/ | head -40; echo \"=== 030 spec\"; sed -n '1,90p' specs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/030-vibe-runtime-parity/spec.md"},"output":"001-command-routing-baseline-corpus\n002-command-inventory-and-risk-metadata\n003-plain-chat-command-reach\n004-command-meaning-matching\n005-recommendation-contract-and-brief\n006-gate-2-binding-and-runtime-pointers\n007-per-runtime-behaviour-proof\n008-embedder-setup-and-cost\n009-ux-performance-cross-cli-research\n010-reachability-and-attribution\n011-typed-command-delivery-and-guards\n012-plain-offer-reach\n013-attribution-and-install-reach\n014-review-remediation\n015-health-default-and-brief-refinements\n016-claude-create-reach-and-doctor-default\n017-review-pass-two-remediation\n018-holdout-row-retirement\n019-workflow-outcome-measure\n020-command-offer-fit-guards\n021-brief-head-parity\n022-workflow-measure-soundness\n023-untuned-outcome-evidence\n024-fable-review-remediation\n025-release-notes-and-doc-sync\n026-untuned-behaviour-arm\n027-review-pass-four-remediation\n028-direct-call-off-switch\n029-direct-call-kill-switch\n030-vibe-runtime-parity\n031-alignment-findings-remediation\ndecision-record.md\ndescription.json\ngoal.md\ngraph-metadata.json\nreview\nscratch\nspec.md\n=== 030 spec\n---\ntitle: \"Feature Specification: Phase 30: vibe-runtime-parity\"\ndescription: \"Mistral Vibe came in from main with the advisor brief, the spec gate and the session hooks, but the command-surfacing packet's own surfaces still skip it: the transcript scorer cannot score a Vibe session, the behaviour runner calls it an unknown runtime, the doctor checks neither its prompt hook nor its mirrors, a Vibe model has no path from a brief's command to its document, and Vibe policy observations are labelled Claude Code. This phase gives each of those surfaces Vibe support and proves the real brief on Vibe with a test.\"\ntrigger_phrases:\n  - \"vibe runtime parity\"\n  - \"phase 30 vibe runtime parity\"\n  - \"mistral vibe chat automation\"\n  - \"vibe transcript scorer tool table\"\n  - \"vibe command document pointer\"\nimportance_tier: \"normal\"\ncontextType: \"general\"\n---\n<!-- SPECKIT_TEMPLATE_SOURCE: spec-core | v2.4 -->\n# Feature Specification: Phase 30: vibe-runtime-parity\n\n<!-- SPECKIT_LEVEL: 2 -->\n---\n\n<!-- ANCHOR:metadata -->\n## 1. METADATA\n<!-- FILL: Fill every row: level, priority, status, date and branch. Use the real branch name. GOOD: Priority P1. Status Draft. Branch `feat/rotate-logs-keep`. WEAK: Priority TBD. Status maybe. -->\n\n| Field | Value |\n|-------|-------|\n| **Level** | 2 |\n| **Priority** | P1 |\n| **Status** | Complete |\n| **Created** | 2026-11-15 |\n| **Branch** | `worktrees/352-command-surfacing-research` |\n| **Parent Spec** | ../spec.md |\n| **Phase** | 30 of 30 |\n| **Predecessor** | 029-direct-call-kill-switch |\n| **Successor** | None |\n| **Handoff Criteria** | Every task in `tasks.md` is `[x]`, every suite reports 0 failed, the floor and eval lines equal their before lines, `scratch/repro-after.txt` shows each gap line changed as SC-001 states, the fix is committed, the Opus review reports no open P0 or P1, `scratch/handback.md` lists every handed-back gap with its evidence and strict validation prints `RESULT: PASSED` |\n<!-- /ANCHOR:metadata -->\n\n---\n\n<!-- ANCHOR:phase-context -->\n## Phase Context\n\nThis is **Phase 30** of the build that makes the skill advisor surface every tracked slash command with a run, start or ask policy on every supported CLI (`../spec.md`). The catch-up merge `e58d450985c` brought in Mistral Vibe from main as a full runtime: a `.vibe/` tree, a turn-start hook that delivers the advisor brief, the spec gate, the session hooks and a session journal reader. On 2026-11-15 the operator asked to make all chat automation work on it and chose a new 008 phase for the work (`../decision-record.md`, Q066 and Q067). A read-only analysis listed twelve gaps. This phase builds the six that sit on this packet's own surfaces and hands the rest back.\n\n**Scope Boundary**: the transcript scorer, the behaviour runner, the doctor's hook-wiring check and runtime-mirrors route, the Vibe prompt-advisor hook, one line of the shared advisor handler, their tests, one new test file and three reference documents. The shared session readers, the Vibe hooks under `.skilled/hooks/`, `.vibe/`, the 004 Vibe packet, `AGENTS.md` and every committed baseline stay as they are. The goal's six-runtime behaviour criterion is unchanged: this phase adds tool support and a hook proof, not a Vibe start rate.\n\n**Dependencies**:\n- Phase 029 is Complete and committed, and the catch-up merge `e58d450985c` is in (T001 checks both).\n- No live model session runs: goal decision D5 keeps live runs in an arena with credentials off, and the operator stopped the behaviour arms.\n- Main keeps moving and a final catch-up merge follows, so the file set stays narrow and every handed-back gap is one main's own Vibe work owns.\n\n**Deliverables**:\n- A transcript scorer that scores a Vibe session from its recorded tool calls, tested against the committed Vibe reader fixture.\n- A behaviour runner that names Vibe as not measured, with its reason.\n- A doctor hook-wiring check with a Vibe row and a runtime-mirrors route with the three Vibe mirror checks.\n- A Vibe brief whose command lines carry the path of each command's document.\n- Policy observations labelled with the runtime that emitted them.\n- A test that runs the Vibe prompt-advisor hook with the real advisor and pins the command, the policy word, the `Also:` line and the document line.\n- `scratch/handback.md` for the five gaps this phase does not build.\n<!-- /ANCHOR:phase-context -->\n\n---\n\n<!-- ANCHOR:problem -->\n## 2. PROBLEM & PURPOSE\n<!-- FILL: State the problem in two sentences: what breaks, and for whom. GOOD: The rotate-logs script never deletes old archives, so a host that copies `logs/archive` fills its disk. WEAK: The script has issues with output. -->\n\n### Problem Statement\nA Vibe user already gets the advisor brief, but the measures and checks this packet built read Vibe as if it were not there. The scorer leaves every Vibe run unscored as `unscorable_runtime`, the runner refuses `vibe` as an unknown runtime, the doctor reports neither a missing Vibe prompt hook nor a stale Vibe mirror, a Vibe model that reads `/doctor:setup` in its brief finds only `.vibe/prompts/doctor-setup.md` headed `/doctor-setup` and has no loader to run it, and every Vibe, Pi and DSH policy observation is recorded under the label `Claude Code`.\n\n### Purpose\nEach of the packet's own surfaces treats Vibe as a runtime it knows: the scorer reads its tool calls, the runner names why it does not run it, the doctor checks its hook and its mirrors, its brief points at each command's document, and its observations carry its own label, all proven by tests that run the shipped code.\n<!-- /ANCHOR:problem -->\n\n<!-- ANCHOR:measured-behavior -->\n### Measured Behavior\n<!-- FILL: Run the command this change affects and paste the command and its verbatim output. Quote every number the spec states about current behavior from this block. Write `N/A:` and a reason when no command applies. GOOD: `bash scripts/rotate-logs.sh` with 10 archives, then `ls logs/archive | wc -l` prints 10. WEAK: The script deletes old logs. -->\n```text\n# 2026-11-15, worktree HEAD e58d450985c, run from the repository root. PH is this phase folder.\n# The matrix prints one line per gap this phase builds. The brief and label lines run under an\n# isolated advisor scope in a temporary folder under $TMPDIR, which the probe removes.\n\n$ zsh $PH/scratch/planning/vibe-parity-matrix.sh\nG1 scorer      {\"scored\":0,\"unscoredRuns\":[{\"rowId\":\"cmd-create-agent-plain-tune-01\",\"reason\":\"unscorable_runtime\"}]}\nG2 runner      exit=2 run-command-behaviour.mjs: unknown runtime: vibe\nG3 wiring      [\"claude:ok\",\"codex:ok\",\"cursor:ok\",\"devin:ok\"]\nG5 mirrors     workflow-lines=0 route-lines=0\nG6 brief 1     Advisor: live; use sk-doc → /create:readme (start) 0.94/0.12 pass.\nG6 brief 2     Advisor: live; use sk-git 0.82/0.16 pass.\nG6 brief 2     Also: /doctor:git setup (run)\nG6 brief 3     Advisor: no skill matched. For setup or health checks, run /doctor:setup.\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"001-command-routing-baseline-corpus\n002-command-inventory-and-risk-metadata\n003-plain-chat-command-reach\n004-command-meaning-matching\n005-recommendation-contract-and-brief\n006-gate-2-binding-and-runtime-pointers\n007-per-runtime-behaviour-proof\n008-embedder-setup-and-cost\n009-ux-performance-cross-cli-research\n010-reachability-and-attribution\n011-typed-command-delivery-and-guards\n012-plain-offer-reach\n013-attribution-and-install-reach\n014-review-remediation\n015-health-default-and-brief-refinements\n016-claude-create-reach-and-doctor-default\n017-review-pass-two-remediation\n018-holdout-row-retirement\n019-workflow-outcome-measure\n020-command-offer-fit-guards\n021-brief-head-parity\n022-workflow-measure-soundness\n023-untuned-outcome-evidence\n024-fable-review-remediation\n025-release-notes-and-doc-sync\n026-untuned-behaviour-arm\n027-review-pass-four-remediation\n028-direct-call-off-switch\n029-direct-call-kill-switch\n030-vibe-runtime-parity\n031-alignment-findings-remediation\ndecision-record.md\ndescription.json\ngoal.md\ngraph-metadata.json\nreview\nscratch\nspec.md\n=== 030 spec\n---\ntitle: \"Feature Specification: Phase 30: vibe-runtime-parity\"\ndescription: \"Mistral Vibe came in from main with the advisor brief, the spec gate and the session hooks, but the command-surfacing packet's own surfaces still skip it: the transcript scorer cannot score a Vibe session, the behaviour runner calls it an unknown runtime, the doctor checks neither its prompt hook nor its mirrors, a Vibe model has no path from a brief's command to its document, and Vibe policy observations are labelled Claude Code. This phase gives each of those surfaces Vibe support and proves the real brief on Vibe with a test.\"\ntrigger_phrases:\n  - \"vibe runtime parity\"\n  - \"phase 30 vibe runtime parity\"\n  - \"mistral vibe chat automation\"\n  - \"vibe transcript scorer tool table\"\n  - \"vibe command document pointer\"\nimportance_tier: \"normal\"\ncontextType: \"general\"\n---\n<!-- SPECKIT_TEMPLATE_SOURCE: spec-core | v2.4 -->\n# Feature Specification: Phase 30: vibe-runtime-parity\n\n<!-- SPECKIT_LEVEL: 2 -->\n---\n\n<!-- ANCHOR:metadata -->\n## 1. METADATA\n<!-- FILL: Fill every row: level, priority, status, date and branch. Use the real branch name. GOOD: Priority P1. Status Draft. Branch `feat/rotate-logs-keep`. WEAK: Priority TBD. Status maybe. -->\n\n| Field | Value |\n|-------|-------|\n| **Level** | 2 |\n| **Priority** | P1 |\n| **Status** | Complete |\n| **Created** | 2026-11-15 |\n| **Branch** | `worktrees/352-command-surfacing-research` |\n| **Parent Spec** | ../spec.md |\n| **Phase** | 30 of 30 |\n| **Predecessor** | 029-direct-call-kill-switch |\n| **Successor** | None |\n| **Handoff Criteria** | Every task in `tasks.md` is `[x]`, every suite reports 0 failed, the floor and eval lines equal their before lines, `scratch/repro-after.txt` shows each gap line changed as SC-001 states, the fix is committed, the Opus review reports no open P0 or P1, `scratch/handback.md` lists every handed-back gap with its evidence and strict validation prints `RESULT: PASSED` |\n<!-- /ANCHOR:metadata -->\n\n---\n\n<!-- ANCHOR:phase-context -->\n## Phase Context\n\nThis is **Phase 30** of the build that makes the skill advisor surface every tracked slash command with a run, start or ask policy on every supported CLI (`../spec.md`). The catch-up merge `e58d450985c` brought in Mistral Vibe from main as a full runtime: a `.vibe/` tree, a turn-start hook that delivers the advisor brief, the spec gate, the session hooks and a session journal reader. On 2026-11-15 the operator asked to make all chat automation work on it and chose a new 008 phase for the work (`../decision-record.md`, Q066 and Q067). A read-only analysis listed twelve gaps. This phase builds the six that sit on this packet's own surfaces and hands the rest back.\n\n**Scope Boundary**: the transcript scorer, the behaviour runner, the doctor's hook-wiring check and runtime-mirrors route, the Vibe prompt-advisor hook, one line of the shared advisor handler, their tests, one new test file and three reference documents. The shared session readers, the Vibe hooks under `.skilled/hooks/`, `.vibe/`, the 004 Vibe packet, `AGENTS.md` and every committed baseline stay as they are. The goal's six-runtime behaviour criterion is unchanged: this phase adds tool support and a hook proof, not a Vibe start rate.\n\n**Dependencies**:\n- Phase 029 is Complete and committed, and the catch-up merge `e58d450985c` is in (T001 checks both).\n- No live model session runs: goal decision D5 keeps live runs in an arena with credentials off, and the operator stopped the behaviour arms.\n- Main keeps moving and a final catch-up merge follows, so the file set stays narrow and every handed-back gap is one main's own Vibe work owns.\n\n**Deliverables**:\n- A transcript scorer that scores a Vibe session from its recorded tool calls, tested against the committed Vibe reader fixture.\n- A behaviour runner that names Vibe as not measured, with its reason.\n- A doctor hook-wiring check with a Vibe row and a runtime-mirrors route with the three Vibe mirror checks.\n- A Vibe brief whose command lines carry the path of each command's document.\n- Policy observations labelled with the runtime that emitted them.\n- A test that runs the Vibe prompt-advisor hook with the real advisor and pins the command, the policy word, the `Also:` line and the document line.\n- `scratch/handback.md` for the five gaps this phase does not build.\n<!-- /ANCHOR:phase-context -->\n\n---\n\n<!-- ANCHOR:problem -->\n## 2. PROBLEM & PURPOSE\n<!-- FILL: State the problem in two sentences: what breaks, and for whom. GOOD: The rotate-logs script never deletes old archives, so a host that copies `logs/archive` fills its disk. WEAK: The script has issues with output. -->\n\n### Problem Statement\nA Vibe user already gets the advisor brief, but the measures and checks this packet built read Vibe as if it were not there. The scorer leaves every Vibe run unscored as `unscorable_runtime`, the runner refuses `vibe` as an unknown runtime, the doctor reports neither a missing Vibe prompt hook nor a stale Vibe mirror, a Vibe model that reads `/doctor:setup` in its brief finds only `.vibe/prompts/doctor-setup.md` headed `/doctor-setup` and has no loader to run it, and every Vibe, Pi and DSH policy observation is recorded under the label `Claude Code`.\n\n### Purpose\nEach of the packet's own surfaces treats Vibe as a runtime it knows: the scorer reads its tool calls, the runner names why it does not run it, the doctor checks its hook and its mirrors, its brief points at each command's document, and its observations carry its own label, all proven by tests that run the shipped code.\n<!-- /ANCHOR:problem -->\n\n<!-- ANCHOR:measured-behavior -->\n### Measured Behavior\n<!-- FILL: Run the command this change affects and paste the command and its verbatim output. Quote every number the spec states about current behavior from this block. Write `N/A:` and a reason when no command applies. GOOD: `bash scripts/rotate-logs.sh` with 10 archives, then `ls logs/archive | wc -l` prints 10. WEAK: The script deletes old logs. -->\n```text\n# 2026-11-15, worktree HEAD e58d450985c, run from the repository root. PH is this phase folder.\n# The matrix prints one line per gap this phase builds. The brief and label lines run under an\n# isolated advisor scope in a temporary folder under $TMPDIR, which the probe removes.\n\n$ zsh $PH/scratch/planning/vibe-parity-matrix.sh\nG1 scorer      {\"scored\":0,\"unscoredRuns\":[{\"rowId\":\"cmd-create-agent-plain-tune-01\",\"reason\":\"unscorable_runtime\"}]}\nG2 runner      exit=2 run-command-behaviour.mjs: unknown runtime: vibe\nG3 wiring      [\"claude:ok\",\"codex:ok\",\"cursor:ok\",\"devin:ok\"]\nG5 mirrors     workflow-lines=0 route-lines=0\nG6 brief 1     Advisor: live; use sk-doc → /create:readme (start) 0.94/0.12 pass.\nG6 brief 2     Advisor: live; use sk-git 0.82/0.16 pass.\nG6 brief 2     Also: /doctor:git setup (run)\nG6 brief 3     Advisor: no skill matched. For setup or health checks, run /doctor:setup.\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"ls specs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/ | head -40; echo \\\"=== 030 spec\\\"; sed -n '1,90p' specs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/030-vibe-runtime-parity/spec.md\"}"},"time":{"start":1794761431200,"end":1794761431798}}}}
