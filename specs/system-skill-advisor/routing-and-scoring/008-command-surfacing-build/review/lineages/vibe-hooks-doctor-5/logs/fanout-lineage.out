ime: input.runtime,\n868:         candidate: input.candidate ?? null,\n869:         blockId: input.blockId,\n870:         contentHash: input.contentHash,\n871:         lifecycleEpoch: input.lifecycleEpoch,\n872:         sessionIdentity,\n873:       }),\n874:       hostReceiptStatus: 'observed' as const,\n875:     });\n876:     const record = Object.freeze({ receipt, binding });\n877:     if (POLICY_OBSERVATION_SINK.length >= MAX_POLICY_OBSERVATION_RECEIPTS) {\n878:       POLICY_OBSERVATION_SINK.shift();\n879:     }\n880:     POLICY_OBSERVATION_SINK.push(record);\n881:     return record;\n882:   } catch {\n883:     return null;\n884:   }\n885: }\n886: \n887: /** Return true when a recorded observation binds to the activation-matrix cell. */\n888: export function observationBindsToCell(\n889:   record: PolicyObservationRecord,\n[Output truncated. Continue reading with offset: 890]","title":"read","metadata":{"metadata":{"truncated":true},"content":[{"type":"text","text":"Read file .skilled/skills/system-skill-advisor/runtime/lib/policy-plan.ts, lines 830-889\n830: }\n831: \n832: /**\n833:  * Record an emission-boundary observed delivery with cell binding metadata.\n834:  * Requires a confirmed session identity and per-block content hash.\n835:  */\n836: export function recordObservedPolicyDelivery(\n837:   input: ObservedPolicyDeliveryInput,\n838: ): PolicyObservationRecord | null {\n839:   try {\n840:     const sessionIdentity = resolveConfirmedSessionId(input);\n841:     if (!sessionIdentity) {\n842:       return null;\n843:     }\n844:     if (!Number.isInteger(input.lifecycleEpoch) || input.lifecycleEpoch <= 0) {\n845:       return null;\n846:     }\n847:     const receipt = recordPolicyObservationReceipt({\n848:       shadowId: input.blockId,\n849:       plannedHash: input.contentHash,\n850:       emittedHash: input.contentHash,\n851:       byteCount: Buffer.byteLength(input.content, 'utf8'),\n852:       lifecycleEpoch: input.lifecycleEpoch,\n853:       transformMessageIdentity: input.transformMessageIdentity ?? null,\n854:       hostReceiptStatus: 'observed',\n855:     });\n856:     if (!receipt) {\n857:       return null;\n858:     }\n859:     const binding = Object.freeze({\n860:       runtime: input.runtime,\n861:       candidate: input.candidate ?? null,\n862:       blockId: input.blockId,\n863:       contentHash: input.contentHash,\n864:       lifecycleEpoch: input.lifecycleEpoch,\n865:       sessionIdentity,\n866:       artifactDigest: policyObservationArtifactDigest({\n867:         runtime: input.runtime,\n868:         candidate: input.candidate ?? null,\n869:         blockId: input.blockId,\n870:         contentHash: input.contentHash,\n871:         lifecycleEpoch: input.lifecycleEpoch,\n872:         sessionIdentity,\n873:       }),\n874:       hostReceiptStatus: 'observed' as const,\n875:     });\n876:     const record = Object.freeze({ receipt, binding });\n877:     if (POLICY_OBSERVATION_SINK.length >= MAX_POLICY_OBSERVATION_RECEIPTS) {\n878:       POLICY_OBSERVATION_SINK.shift();\n879:     }\n880:     POLICY_OBSERVATION_SINK.push(record);\n881:     return record;\n882:   } catch {\n883:     return null;\n884:   }\n885: }\n886: \n887: /** Return true when a recorded observation binds to the activation-matrix cell. */\n888: export function observationBindsToCell(\n889:   record: PolicyObservationRecord,\n[Output truncated. Continue reading with offset: 890]"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"limit\":60,\"offset\":830,\"path\":\".skilled/skills/system-skill-advisor/runtime/lib/policy-plan.ts\"}"},"time":{"start":1794760953201,"end":1794760953569}}}}
