{"type":"tool_use","timestamp":1794761011610,"sessionID":"ses_e1feefdd5ffeHQJCqAmpoKpkZG","part":{"partID":"prt_1e017ae5c0011IvOdnUUnnBOWy","sessionID":"ses_e1feefdd5ffeHQJCqAmpoKpkZG","messageID":"msg_1e0174cf30016RAVmrA1fIkIs0","type":"tool","id":"call_7a65e36eb8ad44fb988622c4","tool":"shell","state":{"status":"completed","input":{"command":"sed -n '1,120p' .skilled/skills/system-skill-advisor/runtime/lib/advisor-disabled.ts; echo \"=== launcher\"; grep -rn \"HOOK_FLAGS_CONFIG\\|SYSTEM_SKILL_ADVISOR\\|SPECKIT_SKILL_ADVISOR\" .skilled/bin/system-skill-advisor-launcher.cjs | head -20"},"output":"// ───────────────────────────────────────────────────────────────\n// MODULE: Advisor Disabled Switch\n// ───────────────────────────────────────────────────────────────\n// The switch belongs to whoever makes the request. The handler reads it in the\n// daemon and the CLI client reads it in the caller's own process before it\n// connects, so both build the same envelope here. The client cannot import the\n// handler because the handler loads the native database module and the scorer.\n// The rule itself is the hooks' resolver, so the direct call abstains exactly\n// when the prompt hooks do.\n\n// ───────────────────────────────────────────────────────────────────\n// 1. IMPORTS\n// ───────────────────────────────────────────────────────────────────\n\nimport { existsSync, realpathSync } from 'node:fs';\nimport { createRequire } from 'node:module';\nimport { dirname, join, resolve } from 'node:path';\nimport { fileURLToPath } from 'node:url';\n\nimport {\n  AdvisorRecommendOutputSchema,\n  type AdvisorRecommendOutput,\n} from '../schemas/advisor-tool-schemas.js';\nimport {\n  resolvedConfidenceThreshold,\n  resolvedUncertaintyThreshold,\n} from './compat/contract.js';\nimport { findAdvisorWorkspaceRoot } from './utils/workspace-root.js';\n\n// ───────────────────────────────────────────────────────────────────\n// 2. HELPERS\n// ───────────────────────────────────────────────────────────────────\n\ntype PublicThresholds = AdvisorRecommendOutput['effectiveThresholds'];\n\ninterface HookFlagsResolver {\n  hookFlagDecision(\n    concern: string,\n    env?: NodeJS.ProcessEnv,\n    config?: Readonly<Record<string, string>>,\n  ): { enabled: boolean; key: string | null };\n  loadConfigFile(path: string): Record<string, string>;\n  configPath(): string;\n  concernFlag(concern: string): string | null;\n  MASTER_FLAG: string;\n  MASTER_ALIASES: readonly string[];\n  LEGACY_ALIASES: Readonly<Record<string, readonly string[]>>;\n}\n\n// The source and the built module sit at different depths below .skilled, so the\n// resolver is found by walking up rather than by counting parent hops. A missing\n// resolver answers as if no switch were set, as every adapter does.\nfunction loadHookFlags(): HookFlagsResolver | null {\n  let folder = dirname(fileURLToPath(import.meta.url));\n  while (true) {\n    const resolverPath = join(folder, 'hooks', 'shared', 'hook-flags.cjs');\n    if (existsSync(resolverPath)) {\n      try {\n        return createRequire(import.meta.url)(resolverPath) as HookFlagsResolver;\n      } catch {\n        return null;\n      }\n    }\n    const parent = dirname(folder);\n    if (parent === folder) return null;\n    folder = parent;\n  }\n}\n\nconst hookFlags = loadHookFlags();\nconst skillAdvisorFlag = hookFlags?.concernFlag('skill-advisor') ?? null;\n\n// Callers strip these names to isolate a scope from a switch set in the shell.\nexport const ADVISOR_DISABLED_FLAGS: readonly string[] = hookFlags === null\n  ? []\n  : [\n      hookFlags.MASTER_FLAG,\n      ...hookFlags.MASTER_ALIASES,\n      ...(skillAdvisorFlag === null ? [] : [skillAdvisorFlag]),\n      ...(hookFlags.LEGACY_ALIASES['skill-advisor'] ?? []),\n    ];\n\n// Both arguments go in so an explicit environment never drops the file. The file\n// is read per call because each CLI call is its own process.\nexport function advisorDisabledBy(\n  env: NodeJS.ProcessEnv = process.env,\n  config?: Readonly<Record<string, string>>,\n): string | null {\n  if (hookFlags === null) return null;\n  const fileConfig = config ?? hookFlags.loadConfigFile(env.HOOK_FLAGS_CONFIG || hookFlags.configPath());\n  const decision = hookFlags.hookFlagDecision('skill-advisor', env, fileConfig);\n  return decision.enabled ? null : decision.key;\n}\n\n// Canonicalize a caller-supplied workspaceRoot via realpath.\n// The schema-level allowlist refinement runs against the same canonical\n// form, so a caller passing /tmp/symlink-to-repo gets the real path\n// post-symlink before downstream code uses it.\nexport function requestWorkspaceRoot(workspaceRoot?: string): string {\n  if (!workspaceRoot) {\n    return findAdvisorWorkspaceRoot(process.cwd(), { maxDepth: 12 });\n  }\n  const resolved = resolve(workspaceRoot);\n  try {\n    return realpathSync.native(resolved);\n  } catch {\n    return resolved;\n  }\n}\n\nfunction unavailableTrustState(reason: string): AdvisorRecommendOutput['trustState'] {\n  return {\n    state: 'unavailable',\n    reason,\n    generation: 0,\n    checkedAt: new Date().toISOString(),\n    lastLiveAt: null,\n  };\n}\n\n=== launcher\n.skilled/bin/system-skill-advisor-launcher.cjs:85:  SYSTEM_SKILL_ADVISOR_TRUST_DEFAULT: 'trusted',\n.skilled/bin/system-skill-advisor-launcher.cjs:144:  'SYSTEM_SKILL_ADVISOR_DB_DIR',\n.skilled/bin/system-skill-advisor-launcher.cjs:145:  'SYSTEM_SKILL_ADVISOR_TRUST_DEFAULT',\n.skilled/bin/system-skill-advisor-launcher.cjs:161:  'SPECKIT_SKILL_ADVISOR_FORCE_LOCAL',\n.skilled/bin/system-skill-advisor-launcher.cjs:176:  'SPECKIT_SKILL_ADVISOR_MODEL_SERVER_ENABLED',\n.skilled/bin/system-skill-advisor-launcher.cjs:188:  'SYSTEM_SKILL_ADVISOR_MEMORY_DB_PATH',\n.skilled/bin/system-skill-advisor-launcher.cjs:300:// Gate verbose error/path logging behind SYSTEM_SKILL_ADVISOR_DEBUG.\n.skilled/bin/system-skill-advisor-launcher.cjs:303:  if (process.env.SYSTEM_SKILL_ADVISOR_DEBUG === '1') {\n.skilled/bin/system-skill-advisor-launcher.cjs:324:  const explicitOverride = typeof sourceEnv.SYSTEM_SKILL_ADVISOR_MEMORY_DB_PATH === 'string'\n.skilled/bin/system-skill-advisor-launcher.cjs:325:    && sourceEnv.SYSTEM_SKILL_ADVISOR_MEMORY_DB_PATH.length > 0\n.skilled/bin/system-skill-advisor-launcher.cjs:326:    ? sourceEnv.SYSTEM_SKILL_ADVISOR_MEMORY_DB_PATH\n.skilled/bin/system-skill-advisor-launcher.cjs:352:  dbDir = process.env.SYSTEM_SKILL_ADVISOR_DB_DIR\n.skilled/bin/system-skill-advisor-launcher.cjs:353:    ? path.resolve(process.env.SYSTEM_SKILL_ADVISOR_DB_DIR)\n.skilled/bin/system-skill-advisor-launcher.cjs:384:  const overrideDbDir = process.env.SYSTEM_SKILL_ADVISOR_DB_DIR;\n.skilled/bin/system-skill-advisor-launcher.cjs:1108:  const raw = (process.env.SPECKIT_SKILL_ADVISOR_MODEL_SERVER_ENABLED ?? '').trim();\n.skilled/bin/system-skill-advisor-launcher.cjs:1121:    throw new Error('SPECKIT_SKILL_ADVISOR_MODEL_SERVER_ENABLED=1 but model-server supervision lib is unavailable');\n.skilled/bin/system-skill-advisor-launcher.cjs:1152:  const overrideDbDir = env.SYSTEM_SKILL_ADVISOR_DB_DIR;\n.skilled/bin/system-skill-advisor-launcher.cjs:1636:    const strictSingleWriter = !isStrictModeDisabled(process.env.SYSTEM_SKILL_ADVISOR_STRICT_SINGLE_WRITER);\n.skilled/bin/system-skill-advisor-launcher.cjs:1641:      log('SYSTEM_SKILL_ADVISOR_STRICT_SINGLE_WRITER is disabled; skipping lease check');\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"// ───────────────────────────────────────────────────────────────\n// MODULE: Advisor Disabled Switch\n// ───────────────────────────────────────────────────────────────\n// The switch belongs to whoever makes the request. The handler reads it in the\n// daemon and the CLI client reads it in the caller's own process before it\n// connects, so both build the same envelope here. The client cannot import the\n// handler because the handler loads the native database module and the scorer.\n// The rule itself is the hooks' resolver, so the direct call abstains exactly\n// when the prompt hooks do.\n\n// ───────────────────────────────────────────────────────────────────\n// 1. IMPORTS\n// ───────────────────────────────────────────────────────────────────\n\nimport { existsSync, realpathSync } from 'node:fs';\nimport { createRequire } from 'node:module';\nimport { dirname, join, resolve } from 'node:path';\nimport { fileURLToPath } from 'node:url';\n\nimport {\n  AdvisorRecommendOutputSchema,\n  type AdvisorRecommendOutput,\n} from '../schemas/advisor-tool-schemas.js';\nimport {\n  resolvedConfidenceThreshold,\n  resolvedUncertaintyThreshold,\n} from './compat/contract.js';\nimport { findAdvisorWorkspaceRoot } from './utils/workspace-root.js';\n\n// ───────────────────────────────────────────────────────────────────\n// 2. HELPERS\n// ───────────────────────────────────────────────────────────────────\n\ntype PublicThresholds = AdvisorRecommendOutput['effectiveThresholds'];\n\ninterface HookFlagsResolver {\n  hookFlagDecision(\n    concern: string,\n    env?: NodeJS.ProcessEnv,\n    config?: Readonly<Record<string, string>>,\n  ): { enabled: boolean; key: string | null };\n  loadConfigFile(path: string): Record<string, string>;\n  configPath(): string;\n  concernFlag(concern: string): string | null;\n  MASTER_FLAG: string;\n  MASTER_ALIASES: readonly string[];\n  LEGACY_ALIASES: Readonly<Record<string, readonly string[]>>;\n}\n\n// The source and the built module sit at different depths below .skilled, so the\n// resolver is found by walking up rather than by counting parent hops. A missing\n// resolver answers as if no switch were set, as every adapter does.\nfunction loadHookFlags(): HookFlagsResolver | null {\n  let folder = dirname(fileURLToPath(import.meta.url));\n  while (true) {\n    const resolverPath = join(folder, 'hooks', 'shared', 'hook-flags.cjs');\n    if (existsSync(resolverPath)) {\n      try {\n        return createRequire(import.meta.url)(resolverPath) as HookFlagsResolver;\n      } catch {\n        return null;\n      }\n    }\n    const parent = dirname(folder);\n    if (parent === folder) return null;\n    folder = parent;\n  }\n}\n\nconst hookFlags = loadHookFlags();\nconst skillAdvisorFlag = hookFlags?.concernFlag('skill-advisor') ?? null;\n\n// Callers strip these names to isolate a scope from a switch set in the shell.\nexport const ADVISOR_DISABLED_FLAGS: readonly string[] = hookFlags === null\n  ? []\n  : [\n      hookFlags.MASTER_FLAG,\n      ...hookFlags.MASTER_ALIASES,\n      ...(skillAdvisorFlag === null ? [] : [skillAdvisorFlag]),\n      ...(hookFlags.LEGACY_ALIASES['skill-advisor'] ?? []),\n    ];\n\n// Both arguments go in so an explicit environment never drops the file. The file\n// is read per call because each CLI call is its own process.\nexport function advisorDisabledBy(\n  env: NodeJS.ProcessEnv = process.env,\n  config?: Readonly<Record<string, string>>,\n): string | null {\n  if (hookFlags === null) return null;\n  const fileConfig = config ?? hookFlags.loadConfigFile(env.HOOK_FLAGS_CONFIG || hookFlags.configPath());\n  const decision = hookFlags.hookFlagDecision('skill-advisor', env, fileConfig);\n  return decision.enabled ? null : decision.key;\n}\n\n// Canonicalize a caller-supplied workspaceRoot via realpath.\n// The schema-level allowlist refinement runs against the same canonical\n// form, so a caller passing /tmp/symlink-to-repo gets the real path\n// post-symlink before downstream code uses it.\nexport function requestWorkspaceRoot(workspaceRoot?: string): string {\n  if (!workspaceRoot) {\n    return findAdvisorWorkspaceRoot(process.cwd(), { maxDepth: 12 });\n  }\n  const resolved = resolve(workspaceRoot);\n  try {\n    return realpathSync.native(resolved);\n  } catch {\n    return resolved;\n  }\n}\n\nfunction unavailableTrustState(reason: string): AdvisorRecommendOutput['trustState'] {\n  return {\n    state: 'unavailable',\n    reason,\n    generation: 0,\n    checkedAt: new Date().toISOString(),\n    lastLiveAt: null,\n  };\n}\n\n=== launcher\n.skilled/bin/system-skill-advisor-launcher.cjs:85:  SYSTEM_SKILL_ADVISOR_TRUST_DEFAULT: 'trusted',\n.skilled/bin/system-skill-advisor-launcher.cjs:144:  'SYSTEM_SKILL_ADVISOR_DB_DIR',\n.skilled/bin/system-skill-advisor-launcher.cjs:145:  'SYSTEM_SKILL_ADVISOR_TRUST_DEFAULT',\n.skilled/bin/system-skill-advisor-launcher.cjs:161:  'SPECKIT_SKILL_ADVISOR_FORCE_LOCAL',\n.skilled/bin/system-skill-advisor-launcher.cjs:176:  'SPECKIT_SKILL_ADVISOR_MODEL_SERVER_ENABLED',\n.skilled/bin/system-skill-advisor-launcher.cjs:188:  'SYSTEM_SKILL_ADVISOR_MEMORY_DB_PATH',\n.skilled/bin/system-skill-advisor-launcher.cjs:300:// Gate verbose error/path logging behind SYSTEM_SKILL_ADVISOR_DEBUG.\n.skilled/bin/system-skill-advisor-launcher.cjs:303:  if (process.env.SYSTEM_SKILL_ADVISOR_DEBUG === '1') {\n.skilled/bin/system-skill-advisor-launcher.cjs:324:  const explicitOverride = typeof sourceEnv.SYSTEM_SKILL_ADVISOR_MEMORY_DB_PATH === 'string'\n.skilled/bin/system-skill-advisor-launcher.cjs:325:    && sourceEnv.SYSTEM_SKILL_ADVISOR_MEMORY_DB_PATH.length > 0\n.skilled/bin/system-skill-advisor-launcher.cjs:326:    ? sourceEnv.SYSTEM_SKILL_ADVISOR_MEMORY_DB_PATH\n.skilled/bin/system-skill-advisor-launcher.cjs:352:  dbDir = process.env.SYSTEM_SKILL_ADVISOR_DB_DIR\n.skilled/bin/system-skill-advisor-launcher.cjs:353:    ? path.resolve(process.env.SYSTEM_SKILL_ADVISOR_DB_DIR)\n.skilled/bin/system-skill-advisor-launcher.cjs:384:  const overrideDbDir = process.env.SYSTEM_SKILL_ADVISOR_DB_DIR;\n.skilled/bin/system-skill-advisor-launcher.cjs:1108:  const raw = (process.env.SPECKIT_SKILL_ADVISOR_MODEL_SERVER_ENABLED ?? '').trim();\n.skilled/bin/system-skill-advisor-launcher.cjs:1121:    throw new Error('SPECKIT_SKILL_ADVISOR_MODEL_SERVER_ENABLED=1 but model-server supervision lib is unavailable');\n.skilled/bin/system-skill-advisor-launcher.cjs:1152:  const overrideDbDir = env.SYSTEM_SKILL_ADVISOR_DB_DIR