{"type":"tool_use","timestamp":1794760959047,"sessionID":"ses_e1feefdd5ffeHQJCqAmpoKpkZG","part":{"partID":"prt_1e016e318001mKDx8j2t376a3p","sessionID":"ses_e1feefdd5ffeHQJCqAmpoKpkZG","messageID":"msg_1e016d294001twgsAdLTPgyQ84","type":"tool","id":"call_f37bd521e5cf47b585f34de9","tool":"read","state":{"status":"completed","input":{"path":".skilled/skills/system-skill-advisor/runtime/tests/hooks/vibe-prompt-advisor.vitest.ts"},"output":"Read file .skilled/skills/system-skill-advisor/runtime/tests/hooks/vibe-prompt-advisor.vitest.ts, lines 1-210\n1: // ───────────────────────────────────────────────────────────────────\n2: // MODULE: Vibe Prompt Advisor Real-Brief Tests\n3: // ───────────────────────────────────────────────────────────────────\n4: // Runs the Vibe prompt-advisor part with the real advisor in an isolated scope,\n5: // because the turn-start suite stubs the advisor and so never proves the brief\n6: // Vibe actually delivers. Each case reads only the routing head, which carries\n7: // the command and its policy word, and pins neither the freshness word nor the\n8: // scores the advisor varies between runs.\n9: \n10: import { spawnSync } from 'node:child_process';\n11: import { mkdirSync, readFileSync } from 'node:fs';\n12: import { join } from 'node:path';\n13: import { pathToFileURL } from 'node:url';\n14: \n15: import { afterAll, beforeAll, describe, expect, it } from 'vitest';\n16: \n17: import * as vibeAdvisor from '../../../hooks/vibe/prompt-advisor.mjs';\n18: import {\n19:   cleanupSkillAdvisorScope,\n20:   createIsolatedCliScope,\n21:   repoRoot,\n22:   type IsolatedCliScope,\n23: } from '../skill-advisor-cli-test-utils.js';\n24: \n25: const ADVISOR_MODULE = join(\n26:   repoRoot,\n27:   '.skilled/skills/system-skill-advisor/hooks/vibe/prompt-advisor.mjs',\n28: );\n29: \n30: // The bridge table lists every command the advisor can name, so the loop below\n31: // proves each one resolves to a document path in this checkout.\n32: const COMMAND_BRIDGES = JSON.parse(\n33:   readFileSync(\n34:     join(\n35:       repoRoot,\n36:       '.skilled/skills/system-skill-advisor/runtime/scripts/command-bridges/command-bridges.generated.json',\n37:     ),\n38:     'utf8',\n39:   ),\n40: ) as { commandPolicies: Array<{ command: string }> };\n41: \n42: const LEAD = 'Command documents (read in full before taking one): ';\n43: \n44: // The child imports the hook module by file URL under the checkout the test\n45: // resolved, so the part and the advisor it loads share one repository root even\n46: // when the suite runs from a worktree.\n47: function childScript(): string {\n48:   return [\n49:     `const { buildAdvisorPart } = await import(${JSON.stringify(pathToFileURL(ADVISOR_MODULE).href)});`,\n50:     'const result = await buildAdvisorPart({',\n51:     \"  hook_event_name: 'pre_agent',\",\n52:     '  prompt: process.argv[1],',\n53:     '  session_id: process.argv[2],',\n54:     '});',\n55:     'process.stdout.write(JSON.stringify(result));',\n56:     'process.exit(0);',\n57:   ].join('\\n');\n58: }\n59: \n60: /**\n61:  * Builds one brief in a fresh process and returns its routing head.\n62:  *\n63:  * @param scope - The isolated scope the advisor runs inside.\n64:  * @param prompt - The prompt Vibe would carry on the turn.\n65:  * @param sessionId - The session id, which also keys the head receipt.\n66:  * @returns The delivered text up to the directive block.\n67:  */\n68: function vibeHead(scope: IsolatedCliScope, prompt: string, sessionId: string): string {\n69:   const env: NodeJS.ProcessEnv = {\n70:     ...scope.env,\n71:     // Both receipts must land inside the scope, or a rerun reads the previous\n72:     // turn's receipt and drops the head this case asserts on. The hook-health\n73:     // records live under the temporary folder, so a proof run must not add\n74:     // records to the checkout's real health file.\n75:     SPECKIT_DIRECTIVE_LIFECYCLE_STATE_DIR: join(scope.rootDir, 'directive-state'),\n76:     TMPDIR: join(scope.rootDir, 'tmp'),\n77:   };\n78:   // A child session receives no brief at all, so the proof run must not inherit\n79:   // the marker this test process may itself carry.\n80:   delete env.AI_SESSION_CHILD;\n81: \n82:   const run = spawnSync(\n83:     process.execPath,\n84:     ['--input-type=module', '-e', childScript(), prompt, sessionId],\n85:     { cwd: repoRoot, encoding: 'utf8', timeout: 120_000, env },\n86:   );\n87:   expect(run.status, run.stderr).toBe(0);\n88: \n89:   const text = JSON.parse(run.stdout) as string;\n90:   return text.split('\\nDirectives:')[0];\n91: }\n92: \n93: describe('Vibe prompt advisor with the real advisor', () => {\n94:   let scope: IsolatedCliScope;\n95: \n96:   beforeAll(() => {\n97:     scope = createIsolatedCliScope('vibe-prompt-advisor');\n98:     mkdirSync(join(scope.rootDir, 'tmp'), { recursive: true });\n99:   });\n100: \n101:   afterAll(async () => {\n102:     await cleanupSkillAdvisorScope(scope);\n103:   });\n104: \n105:   it('names the readme command for a documentation prompt', () => {\n106:     const head = vibeHead(scope, 'write a readme for the utils folder', 'vibe-head-readme');\n107: \n108:     expect(head.startsWith('Advisor:')).toBe(true);\n109:     expect(head).toMatch(/→ \\/create:readme \\(start\\)/);\n110:     expect(head).toContain(`${LEAD}/create:readme is .skilled/commands/create/readme.md.`);\n111:   }, 120_000);\n112: \n113:   it('names the git skill and its doctor follow-up for a hooks prompt', () => {\n114:     const head = vibeHead(scope, 'Check my git hooks setup', 'vibe-head-git-hooks');\n115: \n116:     expect(head.startsWith('Advisor:')).toBe(true);\n117:     expect(head).toMatch(/use sk-git/);\n118:     expect(head).toMatch(/\\nAlso: \\/doctor:git setup \\(run\\)/);\n119:     expect(head).toContain(`${LEAD}/doctor:git is .skilled/commands/doctor/git.md.`);\n120:   }, 120_000);\n121: \n122:   it('names the setup doctor for a health prompt', () => {\n123:     const head = vibeHead(scope, 'my skilled install is broken, check its health', 'vibe-head-health');\n124: \n125:     expect(head.startsWith('Advisor:')).toBe(true);\n126:     expect(head).toMatch(/run \\/doctor:setup\\./);\n127:     expect(head).toContain(`${LEAD}/doctor:setup is .skilled/commands/doctor/setup.md.`);\n128:   }, 120_000);\n129: });\n130: \n131: describe('withCommandDocuments', () => {\n132:   it('adds the document line at the end of the head', () => {\n133:     const head = 'Advisor: live; use sk-doc → /create:readme (start) 0.94/0.12 pass.';\n134:     const context = `${head}\\nDirectives:\\n- keep comments durable`;\n135: \n136:     expect(vibeAdvisor.withCommandDocuments(context, repoRoot)).toBe(\n137:       `${head}\\n${LEAD}/create:readme is .skilled/commands/create/readme.md.\\nDirectives:\\n- keep comments durable`,\n138:     );\n139:   });\n140: \n141:   it('appends the line when the head carries no directive block', () => {\n142:     const context = 'Advisor: live; use sk-git 0.82/0.16 pass.\\nAlso: /doctor:git setup (run)';\n143: \n144:     expect(vibeAdvisor.withCommandDocuments(context, repoRoot)).toBe(\n145:       `${context}\\n${LEAD}/doctor:git is .skilled/commands/doctor/git.md.`,\n146:     );\n147:   });\n148: \n149:   it('names the document a no-skill head offers as its follow-up', () => {\n150:     const context = 'Advisor: no skill matched. For setup or health checks, run /doctor:setup.';\n151: \n152:     expect(vibeAdvisor.withCommandDocuments(context, repoRoot)).toBe(\n153:       `${context}\\n${LEAD}/doctor:setup is .skilled/commands/doctor/setup.md.`,\n154:     );\n155:   });\n156: \n157:   it('drops a second colon part and lists each command once', () => {\n158:     const both = 'Advisor: live; use x → /deep:research:auto, /local-skilled-alignment (start) 0.9/0.1 pass.';\n159:     expect(vibeAdvisor.withCommandDocuments(both, repoRoot)).toBe(\n160:       `${both}\\n${LEAD}/deep:research is .skilled/commands/deep/research.md, /local-skilled-alignment is .skilled/commands/local-skilled-alignment.md.`,\n161:     );\n162: \n163:     const twice = 'Advisor: live; use sk-doc → /create:readme (start) 0.9/0.1 pass.\\nAlso: /create:readme (start)';\n164:     expect(vibeAdvisor.withCommandDocuments(twice, repoRoot)).toBe(\n165:       `${twice}\\n${LEAD}/create:readme is .skilled/commands/create/readme.md.`,\n166:     );\n167:   });\n168: \n169:   it('leaves a head unchanged when no command document resolves', () => {\n170:     const noCommand = 'Advisor: no skill matched. Nothing here names a command.';\n171:     expect(vibeAdvisor.withCommandDocuments(noCommand, repoRoot)).toBe(noCommand);\n172: \n173:     const unknown = 'Advisor: live; use x → /create:nope (start) 0.9/0.1 pass.';\n174:     expect(vibeAdvisor.withCommandDocuments(unknown, repoRoot)).toBe(unknown);\n175: \n176:     const head = 'Advisor: live; use sk-doc → /create:readme (start) 0.94/0.12 pass.';\n177:     expect(vibeAdvisor.withCommandDocuments(head, join(repoRoot, 'no-such-checkout'))).toBe(head);\n178:   });\n179: \n180:   it('names a document for every command the bridges list', () => {\n181:     for (const { command } of COMMAND_BRIDGES.commandPolicies) {\n182:       const head = `Advisor: live; use x → ${command} (start) 0.9/0.1 pass.`;\n183:       expect(vibeAdvisor.withCommandDocuments(head, repoRoot), command).toContain(LEAD);\n184:     }\n185:   });\n186: \n187:   it('drops a repeated head after adding the document line', async () => {\n188:     const head = 'Advisor: live; use sk-doc → /create:readme (start) 0.94/0.12 pass.';\n189:     const receipts = new Map<string, string>();\n190:     const dependencies = {\n191:       run: async () => ({ hookSpecificOutput: { additionalContext: head } }),\n192:       env: {},\n193:       isEnabled: () => true,\n194:       read: (sessionId: string) => receipts.get(sessionId) ?? '',\n195:       write: (sessionId: string, text: string) => {\n196:         receipts.set(sessionId, text);\n197:       },\n198:     };\n199:     const payload = {\n200:       hook_event_name: 'pre_agent',\n201:       prompt: 'write a readme for the utils folder',\n202:       session_id: 'vibe-command-documents-repeat',\n203:     };\n204: \n205:     await expect(vibeAdvisor.buildAdvisorPart(payload, dependencies)).resolves.toBe(\n206:       `${head}\\n${LEAD}/create:readme is .skilled/commands/create/readme.md.`,\n207:     );\n208:     await expect(vibeAdvisor.buildAdvisorPart(payload, dependencies)).resolves.toBe('');\n209:   });\n210: });","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file .skilled/skills/system-skill-advisor/runtime/tests/hooks/vibe-prompt-advisor.vitest.ts, lines 1-210\n1: // ───────────────────────────────────────────────────────────────────\n2: // MODULE: Vibe Prompt Advisor Real-Brief Tests\n3: // ───────────────────────────────────────────────────────────────────\n4: // Runs the Vibe prompt-advisor part with the real advisor in an isolated scope,\n5: // because the turn-start suite stubs the advisor and so never proves the brief\n6: // Vibe actually delivers. Each case reads only the routing head, which carries\n7: // the command and its policy word, and pins neither the freshness word nor the\n8: // scores the advisor varies between runs.\n9: \n10: import { spawnSync } from 'node:child_process';\n11: import { mkdirSync, readFileSync } from 'node:fs';\n12: import { join } from 'node:path';\n13: import { pathToFileURL } from 'node:url';\n14: \n15: import { afterAll, beforeAll, describe, expect, it } from 'vitest';\n16: \n17: import * as vibeAdvisor from '../../../hooks/vibe/prompt-advisor.mjs';\n18: import {\n19:   cleanupSkillAdvisorScope,\n20:   createIsolatedCliScope,\n21:   repoRoot,\n22:   type IsolatedCliScope,\n23: } from '../skill-advisor-cli-test-utils.js';\n24: \n25: const ADVISOR_MODULE = join(\n26:   repoRoot,\n27:   '.skilled/skills/system-skill-advisor/hooks/vibe/prompt-advisor.mjs',\n28: );\n29: \n30: // The bridge table lists every command the advisor can name, so the loop below\n31: // proves each one resolves to a document path in this checkout.\n32: const COMMAND_BRIDGES = JSON.parse(\n33:   readFileSync(\n34:     join(\n35:       repoRoot,\n36:       '.skilled/skills/system-skill-advisor/runtime/scripts/command-bridges/command-bridges.generated.json',\n37:     ),\n38:     'utf8',\n39:   ),\n40: ) as { commandPolicies: Array<{ command: string }> };\n41: \n42: const LEAD = 'Command documents (read in full before taking one): ';\n43: \n44: // The child imports the hook module by file URL under the checkout the test\n45: // resolved, so the part and the advisor it loads share one repository root even\n46: // when the suite runs from a worktree.\n47: function childScript(): string {\n48:   return [\n49:     `const { buildAdvisorPart } = await import(${JSON.stringify(pathToFileURL(ADVISOR_MODULE).href)});`,\n50:     'const result = await buildAdvisorPart({',\n51:     \"  hook_event_name: 'pre_agent',\",\n52:     '  prompt: process.argv[1],',\n53:     '  session_id: process.argv[2],',\n54:     '});',\n55:     'process.stdout.write(JSON.stringify(result));',\n56:     'process.exit(0);',\n57:   ].join('\\n');\n58: }\n59: \n60: /**\n61:  * Builds one brief in a fresh process and returns its routing head.\n62:  *\n63:  * @param scope - The isolated scope the advisor runs inside.\n64:  * @param prompt - The prompt Vibe would carry on the turn.\n65:  * @param sessionId - The session id, which also keys the head receipt.\n66:  * @returns The delivered text up to the directive block.\n67:  */\n68: function vibeHead(scope: IsolatedCliScope, prompt: string, sessionId: string): string {\n69:   const env: NodeJS.ProcessEnv = {\n70:     ...scope.env,\n71:     // Both receipts must land inside the scope, or a rerun reads the previous\n72:     // turn's receipt and drops the head this case asserts on. The hook-health\n73:     // records live under the temporary folder, so a proof run must not add\n74:     // records to the checkout's real health file.\n75:     SPECKIT_DIRECTIVE_LIFECYCLE_STATE_DIR: join(scope.rootDir, 'directive-state'),\n76:     TMPDIR: join(scope.rootDir, 'tmp'),\n77:   };\n78:   // A child session receives no brief at all, so the proof run must not inherit\n79:   // the marker this test process may itself carry.\n80:   delete env.AI_SESSION_CHILD;\n81: \n82:   const run = spawnSync(\n83:     process.execPath,\n84:     ['--input-type=module', '-e', childScript(), prompt, sessionId],\n85:     { cwd: repoRoot, encoding: 'utf8', timeout: 120_000, env },\n86:   );\n87:   expect(run.status, run.stderr).toBe(0);\n88: \n89:   const text = JSON.parse(run.stdout) as string;\n90:   return text.split('\\nDirectives:')[0];\n91: }\n92: \n93: describe('Vibe prompt advisor with the real advisor', () => {\n94:   let scope: IsolatedCliScope;\n95: \n96:   beforeAll(() => {\n97:     scope = createIsolatedCliScope('vibe-prompt-advisor');\n98:     mkdirSync(join(scope.rootDir, 'tmp'), { recursive: true });\n99:   });\n100: \n101:   afterAll(async () => {\n102:     await cleanupSkillAdvisorScope(scope);\n103:   });\n104: \n105:   it('names the readme command for a documentation prompt', () => {\n106:     const head = vibeHead(scope, 'write a readme for the utils folder', 'vibe-head-readme');\n107: \n108:     expect(head.startsWith('Advisor:')).toBe(true);\n109:     expect(head).toMatch(/→ \\/create:readme \\(start\\)/);\n110:     expect(head).toContain(`${LEAD}/create:readme is .skilled/commands/create/readme.md.`);\n111:   }, 120_000);\n112: \n113:   it('names the git skill and its doctor follow-up for a hooks prompt', () => {\n114:     const head = vibeHead(scope, 'Check my git hooks setup', 'vibe-head-git-hooks');\n115: \n116:     expect(head.startsWith('Advisor:')).toBe(true);\n117:     expect(head).toMatch(/use sk-git/);\n118:     expect(head).toMatch(/\\nAlso: \\/doctor:git setup \\(run\\)/);\n119:     expect(head).toContain(`${LEAD}/doctor:git is .skilled/commands/doctor/git.md.`);\n120:   }, 120_000);\n121: \n122:   it('names the setup doctor for a health prompt', () => {\n123:     const head = vibeHead(scope, 'my skilled install is broken, check its health', 'vibe-head-health');\n124: \n125:     expect(head.startsWith('Advisor:')).toBe(true);\n126:     expect(head).toMatch(/run \\/doctor:setup\\./);\n127:     expect(head).toContain(`${LEAD}/doctor:setup is .skilled/commands/doctor/setup.md.`);\n128:   }, 120_000);\n129: });\n130: \n131: describe('withCommandDocuments', () => {\n132:   it('adds the document line at the end of the head', () => {\n133:     const head = 'Advisor: live; use sk-doc → /create:readme (start) 0.94/0.12 pass.';\n134:     const context = `${head}\\nDirectives:\\n- keep comments durable`;\n135: \n136:     expect(vibeAdvisor.withCommandDocuments(context, repoRoot)).toBe(\n137:       `${head}\\n${LEAD}/create:readme is .skilled/commands/create/readme.md.\\nDirectives:\\n- keep comments durable`,\n138:     );\n139:   });\n140: \n141:   it('appends the line when the head carries no directive block', () => {\n142:     const context = 'Advisor: live; use sk-git 0.82/0.16 pass.\\nAlso: /doctor:git setup (run)';\n143: \n144:     expect(vibeAdvisor.withCommandDocuments(context, repoRoot)).toBe(\n145:       `${context}\\n${LEAD}/doctor:git is .skilled/commands/doctor/git.md.`,\n146:     );\n147:   });\n148: \n149:   it('names the document a no-skill head offers as its follow-up', () => {\n150:     const context = 'Advisor: no skill matched. For setup or health checks, run /doctor:setup.';\n151: \n152:     expect(vibeAdvisor.withCommandDocuments(context, repoRoot)).toBe(\n153:       `${context}\\n${LEAD}/doctor:setup is .skilled/commands/doctor/setup.md.`,\n154:     );\n155:   });\n156: \n157:   it('drops a second colon part and lists each command once', () => {\n158:     const both = 'Advisor: live; use x → /deep:research:auto, /local-skilled-alignment (start) 0.9/0.1 pass.';\n159:     expect(vibeAdvisor.withCommandDocuments(both, repoRoot)).toBe(\n160:       `${both}\\n${LEAD}/deep:research is .skilled/commands/deep/research.md, /local-skilled-alignment is .skilled/commands/local-skilled-alignment.md.`,\n161:     );\n162: \n163:     const twice = 'Advisor: live; use sk-doc → /create:readme (start) 0.9/0.1 pass.\\nAlso: /create:readme (start)';\n164:     expect(vibeAdvisor.withCommandDocuments(twice, repoRoot)).toBe(\n165:       `${twice}\\n${LEAD}/create:readme is .skilled/commands/create/readme.md.`,\n166:     );\n167:   });\n168: \n169:   it('leaves a head unchanged when no command document resolves', () => {\n170:     const noCommand = 'Advisor: no skill matched. Nothing here names a command.';\n171:     expect(vibeAdvisor.withCommandDocuments(noCommand, repoRoot)).toBe(noCommand);\n172: \n173:     const unknown = 'Advisor: live; use x → /create:nope (start) 0.9/0.1 pass.';\n174:     expect(vibeAdvisor.withCommandDocuments(unknown, repoRoot)).toBe(unknown);\n175: \n176:     const head = 'Advisor: live; use sk-doc → /create:readme (start) 0.94/0.12 pass.';\n177:     expect(vibeAdvisor.withCommandDocuments(head, join(repoRoot, 'no-such-checkout'))).toBe(head);\n178:   });\n179: \n180:   it('names a document for every command the bridges list', () => {\n181:     for (const { command } of COMMAND_BRIDGES.commandPolicies) {\n182:       const head = `Advisor: live; use x → ${command} (start) 0.9/0.1 pass.`;\n183:       expect(vibeAdvisor.withCommandDocuments(head, repoRoot), command).toContain(LEAD);\n184:     }\n185:   });\n186: \n187:   it('drops a repeated head after adding the document line', async () => {\n188:     const head = 'Advisor: live; use sk-doc → /create:readme (start) 0.94/0.12 pass.';\n189:     const receipts = new Map<string, string>();\n190:     const dependencies = {\n191:       run: async () => ({ hookSpecificOutput: { additionalContext: head } }),\n192:       env: {},\n193:       isEnabled: () => true,\n194:       read: (sessionId: string) => receipts.get(sessionId) ?? '',\n195:       write: (sessionId: string, text: string) => {\n196:         receipts.set(sessionId, text);\n197:       },\n198:     };\n199:     const payload = {\n200:       hook_event_name: 'pre_agent',\n201:       prompt: 'write a readme for the utils folder',\n202:       session_id: 'vibe-command-documents-repeat',\n203:     };\n204: \n205:     await expect(vibeAdvisor.buildAdvisorPart(payload, dependencies)).resolves.toBe(\n206:       `${head}\\n${LEAD}/create:readme is .skilled/commands/create/readme.md.`,\n207:     );\n208:     await expect(vibeAdvisor.buildAdvisorPart(payload, dependencies)).resolves.toBe('');\n209:   });\n210: });"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\".skilled/skills/system-skill-advisor/runtime/tests/hooks/vibe-prompt-advisor.vitest.ts\"}"},"time":{"start":1794760958744,"end":1794760959047}}}}
