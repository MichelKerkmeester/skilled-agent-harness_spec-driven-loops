eListener('data', onData);\n88:             stdin.removeListener('end', onEnd);\n89:             stdin.removeListener('error', onError);\n90:             stdin.pause();\n91:         };\n92:         function onEnd() {\n93:             if (settled)\n94:                 return;\n95:             settled = true;\n96:             release();\n97:             resolve(Buffer.concat(chunks, totalBytes));\n98:         }\n99:         function onError(error) {\n100:             if (settled)\n101:                 return;\n102:             settled = true;\n103:             release();\n104:             reject(error);\n105:         }\n106:         function onData(chunk) {\n107:             if (settled)\n108:                 return;\n109:             const buffer = Buffer.isBuffer(chunk) ? chunk : Buffer.from(chunk);\n110:             totalBytes += buffer.length;\n111:             if (totalBytes > MAX_STDIN_BYTES) {\n112:                 settled = true;\n113:                 release();\n114:                 stdin.destroy();\n115:                 reject(new Error('INPUT_OVERFLOW'));\n116:                 return;\n117:             }\n118:             chunks.push(buffer);\n119:         }\n120:         // Listeners go on before the timer, so a stdin that cannot take listeners\n121:         // rejects at once and leaves no timer behind.\n122:         stdin.on('data', onData);\n123:         stdin.on('end', onEnd);\n124:         stdin.on('error', onError);\n125:         const timer = setTimeout(onEnd, STDIN_DEADLINE_MS);\n126:     });\n127: }\n128: async function runShim() {\n129:     const target = resolveTarget();\n130:     if (!target) {\n131:         emitDiagnostic('TARGET_UNRESOLVED');\n132:         return '{}';\n133:     }\n134:     try {\n135:         const childEnv = { ...process.env };\n136:         // The advisor must finish before this shim kills it, or its fallback output is lost.\n137:         const childBudgetCeilingMs = CHILD_TIMEOUT_MS - CHILD_START_MARGIN_MS;\n138:         const operatorBudgetMs = Number.parseInt(process.env.SPECKIT_CLAUDE_HOOK_TIMEOUT_MS ?? '', 10);\n139:         childEnv.SPECKIT_CLAUDE_HOOK_TIMEOUT_MS = String(Number.isFinite(operatorBudgetMs) && operatorBudgetMs > 0\n140:             ? Math.min(operatorBudgetMs, childBudgetCeilingMs)\n141:             : childBudgetCeilingMs);\n142:         const input = await readBoundedStdin();\n143:         const result = spawnSync(process.execPath, [target, ...process.argv.slice(2)], {\n144:             cwd: process.cwd(),\n145:             input,\n146:             encoding: 'utf8',\n147:             env: childEnv,\n148:             timeout: CHILD_TIMEOUT_MS,\n149:             maxBuffer: MAX_STDIO_BYTES,\n150:             killSignal: 'SIGKILL',\n151:         });\n152:         if (result.error) {\n153:             const code = result.error.code;\n154:             emitDiagnostic(code === 'ETIMEDOUT' ? 'CHILD_TIMEOUT' : code === 'ENOBUFS' ? 'OUTPUT_OVERFLOW' : 'SPAWN_ERROR');\n155:             return '{}';\n156:         }\n157:         if (result.status !== 0) {\n158:             emitDiagnostic('NONZERO_EXIT');\n159:             return '{}';\n160:         }\n161:         const stdout = typeof result.stdout === 'string' ? result.stdout.trim() : '';\n162:         if (!stdout) {\n163:             emitDiagnostic('EMPTY_OUTPUT');\n164:             return '{}';\n165:         }\n166:         try {\n167:             JSON.parse(stdout);\n168:             return stdout;\n169:         }\n170:         catch {\n171:             emitDiagnostic('INVALID_JSON');\n172:             return '{}';\n173:         }\n174:     }\n175:     catch (error) {\n176:         emitDiagnostic(error instanceof Error && error.message === 'INPUT_OVERFLOW'\n177:             ? 'INPUT_OVERFLOW'\n178:             : 'STDIN_READ_ERROR');\n179:         return '{}';\n180:     }\n181: }\n182: // ───────────────────────────────────────────────────────────────────\n183: // 3. ENTRYPOINT\n184: // ───────────────────────────────────────────────────────────────────\n185: async function main() {\n186:     const advisorJson = await runShim();\n187:     process.stdout.write(`${advisorJson}\\n`);\n188:     process.exit(0);\n189: }\n190: void main();\n191: //# sourceMappingURL=user-prompt-submit.js.map"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\".skilled/skills/system-spec-kit/runtime/dist/hooks/claude/user-prompt-submit.js\"}"},"time":{"start":1794760828426,"end":1794760829447}}}}
