      {\n        \"command\": \"bash .skilled/bin/check-git-hooks.sh || { printf \\\"%s\\\\n\\\" \\\"mk-hook-drift host=cursor event=sessionStart adapter=check-git-hooks.sh\\\" >&2; printf %s '{\\\"permission\\\":\\\"allow\\\",\\\"agent_message\\\":\\\"mk cursor hook could not resolve; rebuild the spec-kit runtime or restore the missing adapter\\\",\\\"mkHookDrift\\\":true}'; }\",\n        \"type\": \"command\",\n        \"timeout\": 10\n      },\n      {\n        \"command\": \"python3 .skilled/skills/sk-code/sk-code-quality/scripts/check-dist-staleness.sh --all || { printf \\\"%s\\\\n\\\" \\\"mk-hook-drift host=cursor event=sessionStart adapter=check-dist-staleness.sh\\\" >&2; printf %s '{\\\"permission\\\":\\\"allow\\\",\\\"agent_message\\\":\\\"mk cursor hook could not resolve; rebuild the spec-kit runtime or restore the missing adapter\\\",\\\"mkHookDrift\\\":true}'; }\",\n        \"type\": \"command\",\n        \"timeout\": 10\n      },\n      {\n        \"command\": \"node .skilled/bin/install-codex-hooks.mjs --check || { printf \\\"%s\\\\n\\\" \\\"mk-hook-drift host=cursor event=sessionStart adapter=install-codex-hooks.mjs\\\" >&2; printf %s '{\\\"permission\\\":\\\"allow\\\",\\\"agent_message\\\":\\\"[codex-hooks] drift detected - run: node .skilled/bin/install-codex-hooks.mjs --check\\\",\\\"mkHookDrift\\\":true}'; }\",\n        \"type\": \"command\",\n        \"timeout\": 10\n      },\n      {\n        \"command\": \"node .skilled/hooks/goal/cursor/goal-inject.mjs || { printf \\\"%s\\\\n\\\" \\\"mk-hook-drift host=cursor event=sessionStart adapter=goal-inject.mjs\\\" >&2; printf %s '{\\\"permission\\\":\\\"allow\\\",\\\"agent_message\\\":\\\"mk cursor hook could not resolve; rebuild the spec-kit runtime or restore the missing adapter\\\",\\\"mkHookDrift\\\":true}'; }\",\n        \"type\": \"command\",\n        \"timeout\": 10\n      },\n      {\n        \"command\": \"bash .skilled/bin/git-primary-reconcile.sh >/dev/null 2>&1 &\",\n        \"type\": \"command\",\n        \"timeout\": 10\n      },\n      {\n        \"command\": \"bash .skilled/bin/git-live-follow.sh --start || { printf \\\"%s\\\\n\\\" \\\"mk-hook-drift host=cursor event=sessionStart adapter=git-live-follow.sh\\\" >&2; printf %s '{\\\"permission\\\":\\\"allow\\\",\\\"agent_message\\\":\\\"mk cursor hook could not resolve; rebuild the spec-kit runtime or restore the missing adapter\\\",\\\"mkHookDrift\\\":true}'; }\",\n        \"type\": \"command\",\n        \"timeout\": 10\n      }\n    ],\n== .devin/hooks.v1.json\n{\n  \"SessionStart\": [\n    {\n      \"matcher\": \"\",\n      \"hooks\": [\n        {\n          \"type\": \"command\",\n          \"command\": \"bash -c 'cd \\\"${DEVIN_PROJECT_DIR:-$PWD}\\\" && node .skilled/skills/system-spec-kit/runtime/dist/hooks/devin/session-start.js || { printf \\\"%s\\\\n\\\" \\\"mk-hook-drift host=devin event=SessionStart adapter=session-start.js\\\" >&2; printf %s \\\"{\\\\\\\"hookSpecificOutput\\\\\\\":{\\\\\\\"hookEventName\\\\\\\":\\\\\\\"SessionStart\\\\\\\",\\\\\\\"additionalContext\\\\\\\":\\\\\\\"mk devin hook could not resolve; run npm run build in the spec-kit runtime package\\\\\\\",\\\\\\\"mkHookDrift\\\\\\\":true}}\\\"; }'\",\n          \"timeout\": 10\n        },\n        {\n          \"type\": \"command\",\n          \"command\": \"bash -c 'cd \\\"${DEVIN_PROJECT_DIR:-$PWD}\\\" && bash .skilled/bin/worktree-guard.sh'\",\n          \"timeout\": 3\n        },\n        {\n          \"type\": \"command\",\n          \"command\": \"bash -c 'cd \\\"${DEVIN_PROJECT_DIR:-$PWD}\\\" && bash .skilled/bin/check-git-hooks.sh'\",\n          \"timeout\": 3\n        },\n        {\n          \"type\": \"command\",\n          \"command\": \"bash -c 'cd \\\"${DEVIN_PROJECT_DIR:-$PWD}\\\" && python3 .skilled/skills/sk-code/sk-code-quality/scripts/check-dist-staleness.sh --all'\",\n          \"timeout\": 5\n        },\n        {\n          \"type\": \"command\",\n          \"command\": \"bash -c 'cd \\\"${DEVIN_PROJECT_DIR:-$PWD}\\\" && node .skilled/bin/install-codex-hooks.mjs --check >/dev/null 2>&1 || echo \\\"[codex-hooks] drift detected - run: node .skilled/bin/install-codex-hooks.mjs --check\\\"'\",\n          \"timeout\": 5\n        },\n        {\n          \"type\": \"command\",\n          \"command\": \"bash -c 'cd \\\"${DEVIN_PROJECT_DIR:-$PWD}\\\" && node .skilled/hooks/goal/devin/goal-inject.mjs || { printf \\\"%s\\\\n\\\" \\\"mk-hook-drift host=devin event=SessionStart adapter=goal-inject.mjs\\\" >&2; printf %s \\\"{\\\\\\\"hookSpecificOutput\\\\\\\":{\\\\\\\"hookEventName\\\\\\\":\\\\\\\"SessionStart\\\\\\\",\\\\\\\"additionalContext\\\\\\\":\\\\\\\"mk devin hook could not resolve; run npm run build in the spec-kit runtime package\\\\\\\",\\\\\\\"mkHookDrift\\\\\\\":true}}\\\"; }'\",\n          \"timeout\": 10\n        },\n        {\n          \"type\": \"command\",\n          \"command\": \"bash -c 'cd \\\"${DEVIN_PROJECT_DIR:-$PWD}\\\" && bash .skilled/bin/git-primary-reconcile.sh >/dev/null 2>&1 &'\",\n          \"timeout\": 3\n        },\n        {\n          \"type\": \"command\",\n          \"command\": \"bash -c 'cd \\\"${DEVIN_PROJECT_DIR:-$PWD}\\\" && bash .skilled/bin/git-live-follow.sh --start'\",\n          \"timeout\": 3\n        }\n      ]\n    }\n  ],\n  \"UserPromptSubmit\": [\n    {\n== .vibe/hooks.toml\n# Repository guards for Mistral Vibe. Each entry runs a script under plugins/repo-guards/,\n# which imports its runtime-neutral core from .skilled/. The file loads only in a trusted checkout; a\n# scratch-cwd dispatch or a fan-out lineage gets a copy with absolute paths in its own VIBE_HOME,\n# written by plugins/repo-guards/render-home-hooks.cjs.\n\n# Classifies the operator prompt so the gate is open before the first mutation.\n[[hooks]]\nname = \"spec-gate-classify\"\ntype = \"pre_agent\"\ncommand = \"node \\\"$(git rev-parse --show-toplevel)/.vibe/plugins/repo-guards/spec-gate-classify.mjs\\\"\"\n\n# The only turn-start hook: composes the advisor brief and every later turn-start part\n# in one entry, so their order is fixed here rather than by hook registration order. It\n# stays separate from spec-gate-classify, so a composer failure cannot open the spec gate.\n[[hooks]]\nname = \"turn-start\"\ntype = \"pre_agent\"\nmatch = \"main\"\ntimeout = 20.0\ncommand = \"node \\\"$(git rev-parse --show-toplevel)/.skilled/hooks/session-lifecycle/vibe/turn-start.mjs\\\"\"\n\n# The only turn-end hook: records a completion advisory for the next turn, then sends\n# a prose option menu back once through the ask-surface reprompt. One entry, because\n# the first post_agent deny skips every later post_agent hook.\n[[hooks]]\nname = \"turn-end\"\ntype = \"post_agent\"\nmatch = \"main\"\ntimeout = 20.0\ncommand = \"node \\\"$(git rev-parse --show-toplevel)/.skilled/hooks/session-lifecycle/vibe/turn-end.mjs\\\"\"\n\n# Refuses a write or edit while the session's spec-folder gate is open and unanswered.\n[[hooks]]\nname = \"spec-gate\"\ntype = \"pre_tool\"\nstrict = true\nmatch = \"re:bash|process_start|write_file|edit\"\ncommand = \"node \\\"$(git rev-parse --show-toplevel)/.vibe/plugins/repo-guards/spec-gate.mjs\\\"\"\n\n# Refuses a tool call that would read or write a dotenv file.\n[[hooks]]\nname = \"env-secret-guard\"\ntype = \"pre_tool\"\nstrict = true\nmatch = \"re:bash|process_start|read_file|write_file|edit\"\ncommand = \"node \\\"$(git rev-parse --show-toplevel)/.vibe/plugins/repo-guards/env-secret-guard.mjs\\\"\"\n\n# Refuses a shell dispatch that breaks the target CLI skill's blocking hard rules.\n[[hooks]]\nname = \"dispatch-preflight\"\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":".claude\n.codex\n.cursor\n.devin\n.vibe\n---\n== .claude/settings.json\n{\n  \"$schema\": \"https://json.schemastore.org/claude-code-settings.json\",\n  \"permissions\": {\n    \"allow\": [],\n    \"deny\": [\n      \"Read(.env)\",\n      \"Read(.env.*)\",\n      \"Read(!.env.example)\",\n      \"Edit(.env)\",\n      \"Edit(.env.*)\",\n      \"Edit(!.env.example)\"\n    ],\n    \"defaultMode\": \"auto\"\n  },\n  \"skipDangerousModePermissionPrompt\": true,\n  \"skipWorkflowUsageWarning\": true,\n  \"effortLevel\": \"medium\",\n  \"modelSettings\": {\n    \"claude-fable-5-2\": {\n      \"effortLevel\": \"medium\"\n    },\n    \"claude-opus-5-5\": {\n      \"effortLevel\": \"medium\"\n    },\n    \"claude-sonnet-5-5\": {\n      \"effortLevel\": \"medium\"\n    },\n    \"claude-haiku-5-5\": {\n      \"effortLevel\": \"xhigh\"\n    }\n  },\n  \"autoCompactEnabled\": true,\n  \"autoCompactWindow\": 500000,\n  \"skillListingBudgetFraction\": 0.02,\n  \"promptSuggestionEnabled\": false,\n  \"crossSessionInbound\": \"accept\",\n  \"agentPushNotifEnabled\": true,\n  \"theme\": \"dark\",\n  \"tui\": \"fullscreen\",\n  \"enabledPlugins\": {\n    \"cache-tax@claude-code-mods\": true\n  },\n  \"env\": {\n    \"ENABLE_PROMPT_CACHING_1H\": \"true\",\n    \"ENABLE_TOOL_SEARCH\": \"true\",\n    \"MAX_THINKING_TOKENS\": \"999999\",\n    \"SYSTEM_SPEC_GATE_ENFORCE\": \"0\",\n    \"CLAUDE_CODE_ENABLE_FUNCTION_HOOKS\": \"1\"\n  },\n  \"hooks\": {\n== .codex/hooks.json\n{\n  \"hooks\": {\n    \"SessionStart\": [\n      {\n        \"hooks\": [\n          {\n            \"type\": \"command\",\n            \"command\": \"bash -c 'cd \\\"${CODEX_PROJECT_DIR:-$PWD}\\\" && node .skilled/skills/system-spec-kit/runtime/dist/hooks/codex/session-start.js || { printf \\\"%s\\\\n\\\" \\\"mk-hook-drift host=codex event=SessionStart adapter=session-start.js\\\" >&2; printf %s \\\"{\\\\\\\"hookSpecificOutput\\\\\\\":{\\\\\\\"hookEventName\\\\\\\":\\\\\\\"SessionStart\\\\\\\",\\\\\\\"additionalContext\\\\\\\":\\\\\\\"mk codex hook could not resolve; build the spec-kit runtime (npm --prefix .skilled/skills/system-spec-kit run build) or restore the missing adapter\\\\\\\"}}\\\"; }'\",\n            \"timeout\": 3\n          },\n          {\n            \"type\": \"command\",\n            \"command\": \"bash -c 'cd \\\"${CODEX_PROJECT_DIR:-$PWD}\\\" && bash .skilled/bin/worktree-guard.sh || { printf \\\"%s\\\\n\\\" \\\"mk-hook-drift host=codex event=SessionStart adapter=worktree-guard.sh\\\" >&2; printf %s \\\"{\\\\\\\"hookSpecificOutput\\\\\\\":{\\\\\\\"hookEventName\\\\\\\":\\\\\\\"SessionStart\\\\\\\",\\\\\\\"additionalContext\\\\\\\":\\\\\\\"mk codex hook could not resolve; build the spec-kit runtime (npm --prefix .skilled/skills/system-spec-kit run build) or restore the missing adapter\\\\\\\"}}\\\"; }'\",\n            \"timeout\": 3\n          },\n          {\n            \"type\": \"command\",\n            \"command\": \"bash -c 'cd \\\"${CODEX_PROJECT_DIR:-$PWD}\\\" && bash .skilled/bin/check-git-hooks.sh || { printf \\\"%s\\\\n\\\" \\\"mk-hook-drift host=codex event=SessionStart adapter=check-git-hooks.sh\\\" >&2; printf %s \\\"{\\\\\\\"hookSpecificOutput\\\\\\\":{\\\\\\\"hookEventName\\\\\\\":\\\\\\\"SessionStart\\\\\\\",\\\\\\\"additionalContext\\\\\\\":\\\\\\\"mk codex hook could not resolve; build the spec-kit runtime (npm --prefix .skilled/skills/system-spec-kit run build) or restore the missing adapter\\\\\\\"}}\\\"; }'\",\n            \"timeout\": 3\n          },\n          {\n            \"type\": \"command\",\n            \"command\": \"bash -c 'cd \\\"${CODEX_PROJECT_DIR:-$PWD}\\\" && bash .skilled/bin/git-primary-reconcile.sh >/dev/null 2>&1 &'\",\n            \"timeout\": 3\n          },\n          {\n            \"type\": \"command\",\n            \"command\": \"bash -c 'cd \\\"${CODEX_PROJECT_DIR:-$PWD}\\\" && bash .skilled/bin/git-live-follow.sh --start || { printf \\\"%s\\\\n\\\" \\\"mk-hook-drift host=codex event=SessionStart adapter=git-live-follow.sh\\\" >&2; printf %s \\\"{\\\\\\\"hookSpecificOutput\\\\\\\":{\\\\\\\"hookEventName\\\\\\\":\\\\\\\"SessionStart\\\\\\\",\\\\\\\"additionalContext\\\\\\\":\\\\\\\"mk codex hook could not resolve; build the spec-kit runtime (npm --prefix .skilled/skills/system-spec-kit run build) or restore the missing adapter\\\\\\\"}}\\\"; }'\",\n            \"timeout\": 3\n          },\n          {\n            \"type\": \"command\",\n            \"command\": \"bash -c 'cd \\\"${CODEX_PROJECT_DIR:-$PWD}\\\" && node .skilled/hooks/session-handover/codex/compact-pointer.mjs || { printf \\\"%s\\\\n\\\" \\\"mk-hook-drift host=codex event=SessionStart adapter=compact-pointer.mjs\\\" >&2; printf %s \\\"{\\\\\\\"hookSpecificOutput\\\\\\\":{\\\\\\\"hookEventName\\\\\\\":\\\\\\\"SessionStart\\\\\\\",\\\\\\\"additionalContext\\\\\\\":\\\\\\\"mk codex hook could not resolve; build the spec-kit runtime (npm --prefix .skilled/skills/system-spec-kit run build) or restore the missing adapter\\\\\\\"}}\\\"; }'\",\n            \"timeout\": 5\n          }\n        ]\n      },\n      {\n        \"hooks\": [\n          {\n            \"type\": \"command\",\n            \"command\": \"bash -c 'cd \\\"${CODEX_PROJECT_DIR:-$PWD}\\\" && python3 .skilled/skills/sk-code/sk-code-quality/scripts/check-dist-staleness.sh --all || { printf \\\"%s\\\\n\\\" \\\"mk-hook-drift host=codex event=SessionStart adapter=check-dist-staleness.sh\\\" >&2; printf %s \\\"{\\\\\\\"hookSpecificOutput\\\\\\\":{\\\\\\\"hookEventName\\\\\\\":\\\\\\\"SessionStart\\\\\\\",\\\\\\\"additionalContext\\\\\\\":\\\\\\\"mk codex hook could not resolve; build the spec-kit runtime (npm --prefix .skilled/skills/system-spec-kit run build) or restore the missing adapter\\\\\\\"}}\\\"; }'\",\n            \"timeout\": 5\n          }\n        ]\n      }\n    ],\n    \"UserPromptSubmit\": [\n      {\n        \"hooks\": [\n== .cursor/hooks.json\n{\n  \"version\": 1,\n  \"hooks\": {\n    \"sessionStart\": [\n      {\n        \"command\": \"node .skilled/skills/system-spec-kit/runtime/dist/hooks/cursor/session-start.js || { printf \\\"%s\\\\n\\\" \\\"mk-hook-drift host=cursor event=sessionStart adapter=session-start.js\\\" >&2; printf %s '{\\\"permission\\\":\\\"allow\\\",\\\"agent_message\\\":\\\"mk cursor hook could not resolve; rebuild the spec-kit runtime or restore the missing adapter\\\",\\\"mkHookDrift\\\":true}'; }\",\n        \"type\": \"command\",\n        \"timeout\": 10\n      },\n      {\n        \"command\": \"node .skilled/skills/system-spec-kit/runtime/hooks/cursor/spec-gate-prebind.mjs || { printf \\\"%s\\\\n\\\" \\\"mk-hook-drift host=cursor event=sessionStart adapter=spec-gate-prebind.mjs\\\" >&2; printf %s '{\\\"permission\\\":\\\"allow\\\",\\\"agent_message\\\":\\\"mk cursor hook could not resolve; rebuild the spec-kit runtime or restore the missing adapter\\\",\\\"mkHookDrift\\\":true}'; }\",\n        \"type\": \"command\",\n        \"timeout\": 10\n      },\n      {\n        \"command\": \"bash .skilled/bin/worktree-guard.sh || { printf \\\"%s\\\\n\\\" \\\"mk-hook-drift host=cursor event=sessionStart adapter=worktree-guard.sh\\\" >&2; printf %s '{\\\"permission\\\":\\\"allow\\\",\\\"agent_message\\\":\\\"mk cursor hook could not resolve; rebuild the spec-kit runtime or restore the missing adapter\\\",\\\"mkHookDrift\\\":true}'; }\",\n        \"type\": \"command\",\n        \"timeout\": 10\n      },\n      {\n        \"command\": \"bash .skilled/bin/check-git-hooks.sh || { printf \\\"%s\\\\n\\\" \\\"mk-hook-drift host=cursor event=sessionStart adapter=check-git-hooks.sh\\\" >&2; printf %s '{\\\"permission\\\":\\\"allow\\\",\\\"agent_message\\\":\\\"mk cursor hook could not resolve; rebuild the spec-kit runtime or restore the missing adapter\\\",\\\"mkHookDrift\\\":true}'; }\",\n        \"type\": \"command\",\n        \"timeout\": 10\n      },\n      {\n        \"command\": \"python3 .skilled/skills/sk-code/sk-code-quality/scripts/check-dist-staleness.sh --all || { printf \\\"%s\\\\n\\\" \\\"mk-hook-drift host=cursor event=sessionStart adapter=check-dist-staleness.sh\\\" >&2; printf %s '{\\\"permission\\\":\\\"allow\\\",\\\"agent_message\\\":\\\"mk cursor hook could not resolve; rebuild the spec-kit runtime or restore the missing adapter\\\",\\\"mkHookDrift\\\":true}'; }\",\n        \"type\": \"command\",\n        \"timeout\": 10\n      },\n      {\n        \"command\": \"node .skilled/bin/install-codex-hooks.mjs --check || { printf \\\"%s\\\\n\\\" \\\"mk-hook-drift host=cursor event=sessionStart adapter=install-codex-hooks.mjs\\\" >&2; printf %s '{\\\"permission\\\":\\\"allow\\\",\\\"agent_message\\\":\\\"[codex-hooks] drift detected - run: node .skilled/bin/install-codex-hooks.mjs --check\\\",\\\"mkHookDrift\\\":true}'; }\",\n        \"type\": \"command\",\n        \"timeout\": 10\n      },\n      {\n        \"command\": \"node .skilled/hooks/goal/cursor/goal-inject.mjs || { printf \\\"%s\\\\n\\\" \\\"mk-hook-drift host=cursor event=sessionStart adapter=goal-inject.mjs\\\" >&2; printf %s '{\\\"permission\\\":\\\"allow\\\",\\\"agent_message\\\":\\\"mk cursor hook could not resolve; rebuild the spec-kit runtime or restore the missing adapter\\\",\\\"mkHookDrift\\\":true}'; }\",\n        \"type\": \"command\",\n        \"timeout\": 10\n      },\n      {\n        \"command\": \"bash .skilled/bin/git-primary-reconcile.sh >/dev/null 2>&1 &\",\n        \"type\": \"command\",\n        \"timeout\": 10\n      },\n      {\n        \"command\": \"bash .skilled/bin/git-live-follow.sh --start || { printf \\\"%s\\\\n\\\" \\\"mk-hook-drift host=cursor event=sessionStart adapter=git-live-follow.sh\\\" >&2; printf %s '{\\\"permission\\\":\\\"allow\\\",\\\"agent_message\\\":\\\"mk cursor hook could not resolve; rebuild the spec-kit runtime or restore the missing adapter\\\",\\\"mkHookDrift\\\":true}'; }\",\n        \"type\": \"command\",\n        \"timeout\": 10\n      }\n    ],\n== .devin/hooks.v1.json\n{\n  \"SessionStart\": [\n    {\n      \"matcher\": \"\",\n      \"hooks\": [\n        {\n          \"type\": \"command\",\n          \"command\": \"bash -c 'cd \\\"${DEVIN_PROJECT_DIR:-$PWD}\\\" && node .skilled/skills/system-spec-kit/runtime/dist/hooks/devin/session-start.js || { printf \\\"%s\\\\n\\\" \\\"mk-hook-drift host=devin event=SessionStart adapter=session-start.js\\\" >&2; printf %s \\\"{\\\\\\\"hookSpecificOutput\\\\\\\":{\\\\\\\"hookEventName\\\\\\\":\\\\\\\"SessionStart\\\\\\\",\\\\\\\"additionalContext\\\\\\\":\\\\\\\"mk devin hook could not resolve; run npm run build in the spec-kit runtime package\\\\\\\",\\\\\\\"mkHookDrift\\\\\\\":true}}\\\"; }'\",\n          \"timeout\": 10\n        },\n        {\n          \"type\": \"command\",\n          \"command\": \"bash -c 'cd \\\"${DEVIN_PROJECT_DIR:-$PWD}\\\" && bash .skilled/bin/worktree-guard.sh'\",\n          \"timeout\": 3\n        },\n        {\n          \"type\": \"command\",\n          \"command\": \"bash -c 'cd \\\"${DEVIN_PROJECT_DIR:-$PWD}\\\" && bash .skilled/bin/check-git-hooks.sh'\",\n          \"timeout\": 3\n        },\n        {\n          \"type\": \"command\",\n          \"command\": \"bash -c 'cd \\\"${DEVIN_PROJECT_DIR:-$PWD}\\\" && python3 .skilled/skills/sk-code/sk-code-quality/scripts/check-dist-staleness.sh --all'\",\n          \"timeout\": 5\n        },\n        {\n          \"type\": \"command\",\n          \"command\": \"bash -c 'cd \\\"${DEVIN_PROJECT_DIR:-$PWD}\\\" && node .skilled/bin/install-codex-hooks.mjs --check >/dev/null 2>&1 || echo \\\"[codex-hooks] drift detected - run: node .skilled/bin/install-codex-hooks.mjs --check\\\"'\",\n          \"timeout\": 5\n        },\n        {\n          \"type\": \"command\",\n          \"command\": \"bash -c 'cd \\\"${DEVIN_PROJECT_DIR:-$PWD}\\\" && node .skilled/hooks/goal/devin/goal-inject.mjs || { printf \\\"%s\\\\n\\\" \\\"mk-hook-drift host=devin event=SessionStart adapter=goal-inject.mjs\\\" >&2; printf %s \\\"{\\\\\\\"hookSpecificOutput\\\\\\\":{\\\\\\\"hookEventName\\\\\\\":\\\\\\\"SessionStart\\\\\\\",\\\\\\\"additionalContext\\\\\\\":\\\\\\\"mk devin hook could not resolve; run npm run build in the spec-kit runtime package\\\\\\\",\\\\\\\"mkHookDrift\\\\\\\":true}}\\\"; }'\",\n          \"timeout\": 10\n        },\n        {\n          \"type\": \"command\",\n          \"command\": \"bash -c 'cd \\\"${DEVIN_PROJECT_DIR:-$PWD}\\\" && bash .skilled/bin/git-primary-reconcile.sh >/dev/null 2>&1 &'\",\n          \"timeout\": 3\n        },\n        {\n          \"type\": \"command\",\n          \"command\": \"bash -c 'cd \\\"${DEVIN_PROJECT_DIR:-$PWD}\\\" && bash .skilled/bin/git-live-follow.sh --start'\",\n          \"timeout\": 3\n        }\n      ]\n    }\n  ],\n  \"UserPromptSubmit\": [\n    {\n== .vibe/hooks.toml\n# Repository guards for Mistral Vibe. Each entry runs a script under plugins/repo-guards/,\n# which imports its runtime-neutral core from .skilled/. The file loads only in a trusted checkout; a\n# scratch-cwd dispatch or a fan-out lineage gets a copy with absolute paths in its own VIBE_HOME,\n# written by plugins/repo-guards/render-home-hooks.cjs.\n\n# Classifies the operator prompt so the gate is open before the first mutation.\n[[hooks]]\nname = \"spec-gate-classify\"\ntype = \"pre_agent\"\ncommand = \"node \\\"$(git rev-parse --show-toplevel)/.vibe/plugins/repo-guards/spec-gate-classify.mjs\\\"\"\n\n# The only turn-start hook: composes the advisor brief and every later turn-start part\n# in one entry, so their order is fixed here rather than by hook registration order. It\n# stays separate from spec-gate-classify, so a composer failure cannot open the spec gate.\n[[hooks]]\nname = \"turn-start\"\ntype = \"pre_agent\"\nmatch = \"main\"\ntimeout = 20.0\ncommand = \"node \\\"$(git rev-parse --show-toplevel)/.skilled/hooks/session-lifecycle/vibe/turn-start.mjs\\\"\"\n\n# The only turn-end hook: records a completion advisory for the next turn, then sends\n# a prose option menu back once through the ask-surface reprompt. One entry, because\n# the first post_agent deny skips every later post_agent hook.\n[[hooks]]\nname = \"turn-end\"\ntype = \"post_agent\"\nmatch = \"main\"\ntimeout = 20.0\ncommand = \"node \\\"$(git rev-parse --show-toplevel)/.skilled/hooks/session-lifecycle/vibe/turn-end.mjs\\\"\"\n\n# Refuses a write or edit while the session's spec-folder gate is open and unanswered.\n[[hooks]]\nname = \"spec-gate\"\ntype = \"pre_tool\"\nstrict = true\nmatch = \"re:bash|process_start|write_file|edit\"\ncommand = \"node \\\"$(git rev-parse --show-toplevel)/.vibe/plugins/repo-guards/spec-gate.mjs\\\"\"\n\n# Refuses a tool call that would read or write a dotenv file.\n[[hooks]]\nname = \"env-secret-guard\"\ntype = \"pre_tool\"\nstrict = true\nmatch = \"re:bash|process_start|read_file|write_file|edit\"\ncommand = \"node \\\"$(git rev-parse --show-toplevel)/.vibe/plugins/repo-guards/env-secret-guard.mjs\\\"\"\n\n# Refuses a shell dispatch that breaks the target CLI skill's blocking hard rules.\n[[hooks]]\nname = \"dispatch-preflight\"\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"ls -d .claude .codex .cursor .devin .vibe 2>/dev/null; echo \\\"---\\\"; for f in .claude/settings.json .codex/hooks.json .cursor/hooks.json .devin/hooks.v1.json .vibe/hooks.toml; do echo \\\"== $f\\\"; [ -f \\\"$f\\\" ] && head -50 \\\"$f\\\"; done\"}"},"time":{"start":1794760762226,"end":1794760762897}}}}
