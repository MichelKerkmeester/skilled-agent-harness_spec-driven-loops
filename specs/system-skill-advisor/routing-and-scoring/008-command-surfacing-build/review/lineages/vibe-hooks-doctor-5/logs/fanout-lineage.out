ll matched.\\nDirectives:\\n- When a save is due, run /speckit:save to record the session.\"\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"node --input-type=module -e '\\nconst { withCommandDocuments, reduceRepeatedHead } = await import(\\\"./.skilled/skills/system-skill-advisor/hooks/vibe/prompt-advisor.mjs\\\");\\nconst older = \\\"Directives:\\\\n- When a save is due, run /speckit:save to record the session.\\\";\\nconsole.log(\\\"withCommandDocuments:\\\", JSON.stringify(withCommandDocuments(older, process.cwd())));\\nconsole.log(\\\"reduceRepeatedHead:\\\", JSON.stringify(reduceRepeatedHead(older, \\\"s1\\\", { read: () => \\\"\\\", write: () => {} })));\\nconst current = \\\"Advisor: no skill matched.\\\\nDirectives:\\\\n- When a save is due, run /speckit:save to record the session.\\\";\\nconsole.log(\\\"current fallback:\\\", JSON.stringify(withCommandDocuments(current, process.cwd())));\\n'\"}"},"time":{"start":1794762462597,"end":1794762463920}}}}
