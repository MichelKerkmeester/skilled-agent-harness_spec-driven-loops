{"type":"tool_use","timestamp":1794760906352,"sessionID":"ses_e1feefdd5ffeHQJCqAmpoKpkZG","part":{"partID":"prt_1e0161549001A8opg4fVWkNqFb","sessionID":"ses_e1feefdd5ffeHQJCqAmpoKpkZG","messageID":"msg_1e015d2e4001UWSxaMbQzFuv6G","type":"tool","id":"call_685325bffc5a44bbbcd05ed7","tool":"read","state":{"status":"completed","input":{"path":".skilled/skills/system-skill-advisor/hooks/claude/user-prompt-submit.ts"},"output":"Read file .skilled/skills/system-skill-advisor/hooks/claude/user-prompt-submit.ts, lines 1-531\n1: #!/usr/bin/env node\n2: // ───────────────────────────────────────────────────────────────\n3: // MODULE: UserPromptSubmit Hook — Skill Advisor Brief\n4: // ───────────────────────────────────────────────────────────────\n5: // Runs on Claude Code UserPromptSubmit. Emits a JSON additionalContext\n6: // envelope for model-visible advisor guidance and fails open on all errors.\n7: \n8: // ───────────────────────────────────────────────────────────────\n9: // 1. IMPORTS\n10: // ───────────────────────────────────────────────────────────────\n11: \n12: import { statSync } from 'node:fs';\n13: import { createRequire } from 'node:module';\n14: import { performance } from 'node:perf_hooks';\n15: import { resolve } from 'node:path';\n16: import { fileURLToPath } from 'node:url';\n17: import { isAdvisorRuntime, type AdvisorRuntime } from '../../runtime/lib/advisor-runtime-values.js';\n18: import { findAdvisorWorkspaceRoot } from '../../runtime/lib/utils/workspace-root.js';\n19: import {\n20:   buildSkillAdvisorBrief,\n21:   skippedAdvisorResultFor,\n22:   type AdvisorHookResult,\n23:   type AdvisorHookStatus,\n24:   type AdvisorHookFreshness,\n25: } from '../../runtime/lib/skill-advisor-brief.js';\n26: import {\n27:   decideDirectiveLifecycleDelivery,\n28:   defaultDirectiveLifecycleStore,\n29:   isDirectiveLifecycleDedupEnabled,\n30:   type DirectiveLifecycleState,\n31: } from '../lib/directive-lifecycle.js';\n32: import {\n33:   renderAdvisorBrief,\n34:   renderAdvisorFallbackDirective,\n35:   observeEmittedAdvisorPolicy,\n36: } from '../../runtime/lib/render.js';\n37: import type { ShadowDeliveryRenderOptions } from '../../runtime/lib/render.js';\n38: import {\n39:   createAdvisorHookDiagnosticRecord,\n40:   persistAdvisorHookDiagnosticRecord,\n41:   serializeAdvisorHookDiagnosticRecord,\n42: } from '../../runtime/lib/metrics.js';\n43: import { buildSkillAdvisorBriefFromCli } from '../lib/skill-advisor-cli-fallback.js';\n44: \n45: export { renderAdvisorFallbackDirective };\n46: \n47: // ───────────────────────────────────────────────────────────────\n48: // 2. CONFIGURATION\n49: // ───────────────────────────────────────────────────────────────\n50: \n51: const IS_CLI_ENTRY = process.argv[1]\n52:   ? resolve(process.argv[1]) === fileURLToPath(import.meta.url)\n53:   : false;\n54: \n55: const requireFromAdvisor = createRequire(import.meta.url);\n56: \n57: // Setup, install and configure words trigger the hint; check needs nearby tooling context.\n58: // Bounded context keeps unrelated checks quiet without scanning long prompts.\n59: export const SETUP_WORDING = new RegExp(\n60:   String.raw`\\b(?:set[\\s-]?up|setups?`\n61:     + String.raw`|(?:re)?install(?:s|ed|ing|ation|er|ers)?`\n62:     + String.raw`|configur(?:e|es|ed|ing|ations?)`\n63:     + String.raw`|check(?:s|ed|ing)?(?:\\s+\\S+){0,2}?\\s+`\n64:     + String.raw`(?:environment|env|config(?:s|urations?)?`\n65:     + String.raw`|hooks?|tools|tooling|toolchain|skilled))\\b`,\n66:   'i',\n67: );\n68: function skillAdvisorHookEnabled(): boolean {\n69:   try {\n70:     const { isHookEnabled } = requireFromAdvisor(\n71:       fileURLToPath(new URL('../../../../../../hooks/shared/hook-flags.cjs', import.meta.url)),\n72:     ) as { isHookEnabled?: (concern: string) => boolean };\n73:     return typeof isHookEnabled !== 'function' || isHookEnabled('skill-advisor') !== false;\n74:   } catch {\n75:     return true;\n76:   }\n77: }\n78: \n79: // ───────────────────────────────────────────────────────────────\n80: // 3. TYPES\n81: // ───────────────────────────────────────────────────────────────\n82: \n83: export interface ClaudeUserPromptSubmitInput {\n84:   readonly session_id?: string;\n85:   readonly session_identity_confirmed?: boolean;\n86:   readonly session_identity_ambiguous?: boolean;\n87:   readonly hook_event_name?: string;\n88:   readonly lifecycle_event?: string;\n89:   readonly lifecycle_source?: string;\n90:   readonly source?: string;\n91:   readonly scope_changed?: boolean;\n92:   readonly policy_set_changed?: boolean;\n93:   readonly goal_changed?: boolean;\n94:   readonly delivery_receipt_status?: 'configured' | 'observed' | 'unobserved' | 'unknown';\n95:   readonly prompt?: string;\n96:   readonly cwd?: string;\n97:   readonly transcript_path?: string;\n98:   readonly [key: string]: unknown;\n99: }\n100: \n101: export interface ClaudeHookSpecificOutput {\n102:   readonly hookSpecificOutput: {\n103:     readonly hookEventName: 'UserPromptSubmit';\n104:     readonly additionalContext: string;\n105:   };\n106: }\n107: \n108: export type ClaudeUserPromptSubmitOutput = ClaudeHookSpecificOutput | Record<string, never>;\n109: \n110: export interface UserPromptSubmitDependencies {\n111:   /** In-process callers such as Pi pass their runtime directly. */\n112:   readonly runtime?: AdvisorRuntime;\n113:   readonly buildBrief?: typeof buildSkillAdvisorBrief;\n114:   readonly buildCliBrief?: typeof buildSkillAdvisorBriefFromCli;\n115:   readonly renderBrief?: typeof renderAdvisorBrief;\n116:   readonly now?: () => number;\n117:   readonly writeDiagnostic?: (line: string) => void;\n118:   /** Per-session directive-lifecycle dedup state; defaults to the durable file-backed store. */\n119:   readonly directiveLifecycleStore?: DirectiveLifecycleState;\n120:   /** Delay a full-delivery receipt until the process handoff acknowledges stdout. */\n121:   readonly deferDirectiveReceipt?: boolean;\n122: }\n123: \n124: interface HookDiagnosticInput {\n125:   readonly runtime?: AdvisorRuntime;\n126:   readonly workspaceRoot: string;\n127:   readonly status: AdvisorHookStatus;\n128:   readonly freshness: AdvisorHookFreshness;\n129:   readonly durationMs: number;\n130:   readonly cacheHit: boolean;\n131:   readonly errorCode?: unknown;\n132:   readonly errorDetails?: string;\n133:   readonly skillLabel?: string | null;\n134:   readonly degraded?: boolean;\n135:   readonly generation?: number;\n136:   readonly emittedBytes?: number;\n137:   readonly directivesSuppressed?: boolean;\n138: }\n139: \n140: // ───────────────────────────────────────────────────────────────\n141: // 4. CONSTANTS\n142: // ───────────────────────────────────────────────────────────────\n143: \n144: export const DEFAULT_CLAUDE_HOOK_TIMEOUT_MS = 2500;\n145: const MAX_PROMPT_BYTES = 64 * 1024;\n146: const OBSERVED_ADVISOR_POLICY_CANDIDATE = '004';\n147: const DIRECTIVE_RECEIPT_COMMIT = Symbol('directiveReceiptCommit');\n148: const pendingDiagnosticWrites = new Set<Promise<unknown>>();\n149: \n150: // ───────────────────────────────────────────────────────────────\n151: // 5. HELPERS\n152: // ───────────────────────────────────────────────────────────────\n153: \n154: function isRecord(value: unknown): value is Record<string, unknown> {\n155:   return typeof value === 'object' && value !== null && !Array.isArray(value);\n156: }\n157: \n158: function normalizePrompt(value: unknown): string | null {\n159:   if (typeof value !== 'string') {\n160:     return null;\n161:   }\n162:   if (Buffer.byteLength(value, 'utf8') <= MAX_PROMPT_BYTES) {\n163:     return value;\n164:   }\n165: \n166:   let low = 0;\n167:   let high = value.length;\n168:   while (low < high) {\n169:     const midpoint = Math.ceil((low + high) / 2);\n170:     if (Buffer.byteLength(value.slice(0, midpoint), 'utf8') <= MAX_PROMPT_BYTES) {\n171:       low = midpoint;\n172:     } else {\n173:       high = midpoint - 1;\n174:     }\n175:   }\n176:   return value.slice(0, low);\n177: }\n178: \n179: export function workspaceRootFor(input: ClaudeUserPromptSubmitInput): string {\n180:   const start =\n181:     typeof input.cwd === 'string' && input.cwd.trim().length > 0\n182:       ? input.cwd\n183:       : process.cwd();\n184:   // Anchor to the real repo root. A raw session cwd inside a specs/<packet>\n185:   // directory would otherwise become the \"workspace root\", and the advisor's\n186:   // state writers materialize a stray .state/advisor tree under it.\n187:   return findAdvisorWorkspaceRoot(start);\n188: }\n189: \n190: function skillLabelFor(result: AdvisorHookResult): string | null {\n191:   const metadataLabel = result.sharedPayload?.metadata?.skillLabel;\n192:   if (typeof metadataLabel === 'string') {\n193:     return metadataLabel;\n194:   }\n195:   return result.recommendations[0]?.skill ?? null;\n196: }\n197: \n198: function positiveIntFromEnv(value: string | undefined, fallback: number): number {\n199:   if (typeof value !== 'string' || value.trim().length === 0) {\n200:     return fallback;\n201:   }\n202:   const parsed = Number.parseInt(value, 10);\n203:   return Number.isFinite(parsed) && parsed > 0 ? parsed : fallback;\n204: }\n205: \n206: function claudeHookTimeoutMs(): number {\n207:   return positiveIntFromEnv(process.env.SPECKIT_CLAUDE_HOOK_TIMEOUT_MS, DEFAULT_CLAUDE_HOOK_TIMEOUT_MS);\n208: }\n209: \n210: function lifecycleEventFor(input: ClaudeUserPromptSubmitInput): string | undefined {\n211:   const explicit = input.lifecycle_event ?? input.lifecycle_source;\n212:   if (explicit === 'startup' || explicit === 'resume' || explicit === 'compact') {\n213:     return explicit;\n214:   }\n215:   if (input.hook_event_name === 'SessionStart'\n216:     && (input.source === 'startup' || input.source === 'resume' || input.source === 'compact')) {\n217:     return input.source;\n218:   }\n219:   return undefined;\n220: }\n221: \n222: /** Convert runtime-owned identity and lifecycle fields into shadow-only signals. */\n223: export function deliveryStateOptionsFor(\n224:   input: ClaudeUserPromptSubmitInput,\n225: ): ShadowDeliveryRenderOptions {\n226:   const hasSessionId = typeof input.session_id === 'string' && input.session_id.trim().length > 0;\n227:   return {\n228:     sessionId: input.session_id,\n229:     sessionIdentityConfirmed: input.session_identity_confirmed ?? hasSessionId,\n230:     sessionIdentityAmbiguous: input.session_identity_ambiguous === true,\n231:     lifecycleEvent: lifecycleEventFor(input),\n232:     scopeChanged: input.scope_changed === true,\n233:     policySetChanged: input.policy_set_changed === true,\n234:     goalChanged: input.goal_changed === true,\n235:     deliveryConfirmed: false,\n236:   };\n237: }\n238: \n239: export function emitDiagnostic(\n240:   record: HookDiagnosticInput,\n241:   writeDiagnostic: (line: string) => void = (line) => process.stderr.write(`${line}\\n`),\n242:   persistDiagnostic: typeof persistAdvisorHookDiagnosticRecord = persistAdvisorHookDiagnosticRecord,\n243: ): void {\n244:   try {\n245:     const diagnosticRecord = createAdvisorHookDiagnosticRecord({\n246:       runtime: 'claude',\n247:       ...record,\n248:     });\n249:     const line = serializeAdvisorHookDiagnosticRecord(diagnosticRecord);\n250:     writeDiagnostic(line);\n251:     const pendingWrite = persistDiagnostic(record.workspaceRoot, diagnosticRecord).catch(() => undefined);\n252:     pendingDiagnosticWrites.add(pendingWrite);\n253:     void pendingWrite.then(() => pendingDiagnosticWrites.delete(pendingWrite));\n254:   } catch {\n255:     // Diagnostics must never affect hook behavior.\n256:   }\n257: }\n258: \n259: export async function flushPendingDiagnostics(maxWaitMs = 100): Promise<void> {\n260:   let timeout: NodeJS.Timeout | undefined;\n261:   try {\n262:     if (pendingDiagnosticWrites.size === 0) return;\n263:     const pendingWrites = Promise.all([...pendingDiagnosticWrites]).then(() => undefined);\n264:     const timeoutElapsed = new Promise<void>((resolvePromise) => {\n265:       timeout = setTimeout(resolvePromise, maxWaitMs);\n266:       timeout.unref();\n267:     });\n268:     await Promise.race([pendingWrites, timeoutElapsed]);\n269:   } catch {\n270:     // Diagnostics must never affect hook behavior.\n271:   } finally {\n272:     if (timeout) clearTimeout(timeout);\n273:   }\n274: }\n275: \n276: export function parseClaudeUserPromptSubmitInput(raw: string): ClaudeUserPromptSubmitInput | null {\n277:   try {\n278:     const parsed = JSON.parse(raw) as unknown;\n279:     return isRecord(parsed) ? parsed : null;\n280:   } catch {\n281:     return null;\n282:   }\n283: }\n284: \n285: // ───────────────────────────────────────────────────────────────\n286: // 6. CORE LOGIC\n287: // ───────────────────────────────────────────────────────────────\n288: \n289: export async function handleClaudeUserPromptSubmit(\n290:   input: ClaudeUserPromptSubmitInput | null,\n291:   dependencies: UserPromptSubmitDependencies = {},\n292: ): Promise<ClaudeUserPromptSubmitOutput> {\n293:   const environmentRuntime = process.env.SPECKIT_RUNTIME;\n294:   const runtime = dependencies.runtime\n295:     ?? (isAdvisorRuntime(environmentRuntime) ? environmentRuntime : 'claude');\n296:   const startedAt = dependencies.now?.() ?? performance.now();\n297:   const elapsed = (): number => Number(((dependencies.now?.() ?? performance.now()) - startedAt).toFixed(3));\n298:   const writeDiagnostic = dependencies.writeDiagnostic;\n299: \n300:   try {\n301:     if (!skillAdvisorHookEnabled() || process.env.SPECKIT_SKILL_ADVISOR_HOOK_DISABLED === '1') {\n302:       emitDiagnostic({\n303:         runtime,\n304:         workspaceRoot: process.cwd(),\n305:         status: 'skipped',\n306:         freshness: 'unavailable',\n307:         durationMs: elapsed(),\n308:         cacheHit: false,\n309:       }, writeDiagnostic);\n310:       return {};\n311:     }\n312: \n313:     if (!input) {\n314:       emitDiagnostic({\n315:         runtime,\n316:         workspaceRoot: process.cwd(),\n317:         status: 'fail_open',\n318:         freshness: 'unavailable',\n319:         durationMs: elapsed(),\n320:         cacheHit: false,\n321:         errorCode: 'PARSE_FAIL',\n322:         errorDetails: 'Invalid UserPromptSubmit JSON payload',\n323:       }, writeDiagnostic);\n324:       return {};\n325:     }\n326: \n327:     const prompt = normalizePrompt(input.prompt);\n328:     const workspaceRoot = workspaceRootFor(input);\n329:     if (prompt === null) {\n330:       emitDiagnostic({\n331:         runtime,\n332:         workspaceRoot,\n333:         status: 'fail_open',\n334:         freshness: 'unavailable',\n335:         durationMs: elapsed(),\n336:         cacheHit: false,\n337:         errorCode: 'PARSE_FAIL',\n338:         errorDetails: 'Missing UserPromptSubmit prompt string',\n339:       }, writeDiagnostic);\n340:       return {};\n341:     }\n342: \n343:     const renderBrief = dependencies.renderBrief ?? renderAdvisorBrief;\n344:     // The CLI owns the warm-daemon probe and local-scorer fallback.\n345:     // The prompt-policy gate skips prompts that need no advisor before the\n346:     // CLI call; injected full producers stay ungated for producer-level tests.\n347:     const injectedBrief = dependencies.buildBrief;\n348:     const buildCliBrief = dependencies.buildCliBrief ?? buildSkillAdvisorBriefFromCli;\n349:     let result = injectedBrief\n350:       ? await injectedBrief(prompt, {\n351:         runtime,\n352:         workspaceRoot,\n353:         subprocessTimeoutMs: claudeHookTimeoutMs(),\n354:       })\n355:       : skippedAdvisorResultFor(prompt) ?? await buildCliBrief(prompt, {\n356:         runtime,\n357:         workspaceRoot,\n358:         timeoutMs: claudeHookTimeoutMs(),\n359:       }, {\n360:         now: dependencies.now,\n361:       });\n362: \n363:     result = {\n364:       ...result,\n365:       metrics: {\n366:         ...result.metrics,\n367:         durationMs: elapsed(),\n368:       },\n369:     };\n370:     const deliveryState = deliveryStateOptionsFor(input);\n371:     const brief = renderBrief(result, { deliveryState });\n372:     const renderOptions = { deliveryState, setupWording: !brief && SETUP_WORDING.test(prompt) };\n373:     const emitted = brief ?? renderAdvisorFallbackDirective(renderOptions, result);\n374:     // Directive-lifecycle dedup delivers the full brief on the first message\n375:     // and after lifecycle boundaries or transcript shrink. On proven repeats,\n376:     // it keeps the head and drops the constant directive block. A headed\n377:     // fallback reduces like a brief; unknown sessions, the kill switch, and\n378:     // thrown errors still get the full text.\n379:     let effectiveEmitted = emitted;\n380:     let commitFullReceipt: (() => boolean) | undefined;\n381:     try {\n382:       const sessionId = typeof input.session_id === 'string' && input.session_id.trim().length > 0\n383:         ? input.session_id\n384:         : undefined;\n385:       const sessionConfirmed = input.session_identity_confirmed\n386:         ?? (Boolean(sessionId) && input.session_identity_ambiguous !== true);\n387:       const transcriptPath = typeof input.transcript_path === 'string' && input.transcript_path.length > 0\n388:         ? input.transcript_path\n389:         : null;\n390:       let transcriptBytes: number | null = null;\n391:       if (transcriptPath) {\n392:         try {\n393:           transcriptBytes = statSync(transcriptPath).size;\n394:         } catch {\n395:           transcriptBytes = null;\n396:         }\n397:       }\n398:       const decision = decideDirectiveLifecycleDelivery(emitted, {\n399:         state: dependencies.directiveLifecycleStore ?? defaultDirectiveLifecycleStore(),\n400:         sessionId,\n401:         sessionConfirmed,\n402:         lifecycleEvent: lifecycleEventFor(input),\n403:         transcriptPath,\n404:         transcriptBytes,\n405:         enabled: isDirectiveLifecycleDedupEnabled(),\n406:         deferFullReceipt: dependencies.deferDirectiveReceipt === true,\n407:       });\n408:       commitFullReceipt = decision.commitFullReceipt;\n409:       if (decision.suppressed && decision.reducedContext) {\n410:         effectiveEmitted = decision.reducedContext;\n411:       }\n412:     } catch {\n413:       // Directive dedup is advisory; on any failure keep the full brief.\n414:       effectiveEmitted = emitted;\n415:     }\n416:     emitDiagnostic({\n417:       runtime,\n418:       workspaceRoot,\n419:       status: result.status,\n420:       freshness: result.freshness,\n421:       durationMs: result.metrics.durationMs,\n422:       cacheHit: result.metrics.cacheHit,\n423:       errorCode: result.diagnostics?.errorCode,\n424:       errorDetails: result.diagnostics?.errorMessage ?? result.diagnostics?.policyReason ?? result.diagnostics?.staleReason,\n425:       skillLabel: skillLabelFor(result),\n426:       degraded: result.metrics.degraded === true,\n427:       emittedBytes: Buffer.byteLength(effectiveEmitted, 'utf8'),\n428:       directivesSuppressed: effectiveEmitted !== emitted,\n429:     }, writeDiagnostic);\n430: \n431:     const output: ClaudeUserPromptSubmitOutput = {\n432:       hookSpecificOutput: {\n433:         hookEventName: 'UserPromptSubmit',\n434:         additionalContext: effectiveEmitted,\n435:       },\n436:     };\n437:     if (commitFullReceipt) {\n438:       Object.defineProperty(output, DIRECTIVE_RECEIPT_COMMIT, {\n439:         configurable: true,\n440:         enumerable: false,\n441:         value: commitFullReceipt,\n442:       });\n443:     }\n444:     observeEmittedAdvisorPolicy(effectiveEmitted, {\n445:       ...deliveryState,\n446:       // Claude keeps its display label and every other caller is recorded under\n447:       // the runtime it named, so no other runtime's delivery is counted as Claude's.\n448:       runtime: runtime === 'claude' ? 'Claude Code' : runtime,\n449:       candidate: OBSERVED_ADVISOR_POLICY_CANDIDATE,\n450:     });\n451:     return output;\n452:   } catch {\n453:     emitDiagnostic({\n454:       runtime,\n455:       workspaceRoot: input ? workspaceRootFor(input) : process.cwd(),\n456:       status: 'fail_open',\n457:       freshness: 'unavailable',\n458:       durationMs: elapsed(),\n459:       cacheHit: false,\n460:       errorCode: 'UNKNOWN',\n461:       errorDetails: 'Unhandled UserPromptSubmit hook exception',\n462:     }, writeDiagnostic);\n463:     return {};\n464:   }\n465: }\n466: \n467: // ───────────────────────────────────────────────────────────────\n468: // 7. OUTPUT DELIVERY\n469: // ───────────────────────────────────────────────────────────────\n470: \n471: async function readStdin(): Promise<string> {\n472:   const chunks: Buffer[] = [];\n473:   for await (const chunk of process.stdin) {\n474:     chunks.push(chunk as Buffer);\n475:   }\n476:   return Buffer.concat(chunks).toString('utf-8').trim();\n477: }\n478: \n479: export function commitClaudeDirectiveDeliveryReceipt(\n480:   output: ClaudeUserPromptSubmitOutput,\n481: ): boolean {\n482:   const record = output as ClaudeUserPromptSubmitOutput & {\n483:     [DIRECTIVE_RECEIPT_COMMIT]?: () => boolean;\n484:   };\n485:   const commit = record[DIRECTIVE_RECEIPT_COMMIT];\n486:   if (!commit) return true;\n487:   delete record[DIRECTIVE_RECEIPT_COMMIT];\n488:   return commit();\n489: }\n490: \n491: function writeHookOutput(output: ClaudeUserPromptSubmitOutput): Promise<void> {\n492:   return new Promise<void>((resolvePromise) => {\n493:     process.stdout.write(`${JSON.stringify(output)}\\n`, () => {\n494:       commitClaudeDirectiveDeliveryReceipt(output);\n495:       resolvePromise();\n496:     });\n497:   });\n498: }\n499: \n500: // ───────────────────────────────────────────────────────────────\n501: // 8. CLI ENTRY POINT\n502: // ───────────────────────────────────────────────────────────────\n503: \n504: async function main(): Promise<void> {\n505:   const rawInput = await readStdin();\n506:   const input = rawInput ? parseClaudeUserPromptSubmitInput(rawInput) : null;\n507:   const output = await handleClaudeUserPromptSubmit(input, {\n508:     writeDiagnostic: (line) => process.stderr.write(`${line}\\n`),\n509:     deferDirectiveReceipt: true,\n510:   });\n511:   await writeHookOutput(output);\n512: }\n513: \n514: if (IS_CLI_ENTRY) {\n515:   main().catch(async () => {\n516:     emitDiagnostic({\n517:       workspaceRoot: process.cwd(),\n518:       status: 'fail_open',\n519:       freshness: 'unavailable',\n520:       durationMs: 0,\n521:       cacheHit: false,\n522:       errorCode: 'UNKNOWN',\n523:       errorDetails: 'Unhandled UserPromptSubmit CLI exception',\n524:     });\n525:     await writeHookOutput({});\n526:   }).finally(async () => {\n527:     // The exit would otherwise drop diagnostic appends; the cap preserves the shim's kill margin.\n528:     await flushPendingDiagnostics();\n529:     process.exit(0);\n530:   });\n531: }","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file .skilled/skills/system-skill-advisor/hooks/claude/user-prompt-submit.ts, lines 1-531\n1: #!/usr/bin/env node\n2: // ───────────────────────────────────────────────────────────────\n3: // MODULE: UserPromptSubmit Hook — Skill Advisor Brief\n4: // ───────────────────────────────────────────────────────────────\n5: // Runs on Claude Code UserPromptSubmit. Emits a JSON additionalContext\n6: // envelope for model-visible advisor guidance and fails open on all errors.\n7: \n8: // ───────────────────────────────────────────────────────────────\n9: // 1. IMPORTS\n10: // ───────────────────────────────────────────────────────────────\n11: \n12: import { statSync } from 'node:fs';\n13: import { createRequire } from 'node:module';\n14: import { performance } from 'node:perf_hooks';\n15: import { resolve } from 'node:path';\n16: import { fileURLToPath } from 'node:url';\n17: import { isAdvisorRuntime, type AdvisorRuntime } from '../../runtime/lib/advisor-runtime-values.js';\n18: import { findAdvisorWorkspaceRoot } from '../../runtime/lib/utils/workspace-root.js';\n19: import {\n20:   buildSkillAdvisorBrief,\n21:   skippedAdvisorResultFor,\n22:   type AdvisorHookResult,\n23:   type AdvisorHookStatus,\n24:   type AdvisorHookFreshness,\n25: } from '../../runtime/lib/skill-advisor-brief.js';\n26: import {\n27:   decideDirectiveLifecycleDelivery,\n28:   defaultDirectiveLifecycleStore,\n29:   isDirectiveLifecycleDedupEnabled,\n30:   type DirectiveLifecycleState,\n31: } from '../lib/directive-lifecycle.js';\n32: import {\n33:   renderAdvisorBrief,\n34:   renderAdvisorFallbackDirective,\n35:   observeEmittedAdvisorPolicy,\n36: } from '../../runtime/lib/render.js';\n37: import type { ShadowDeliveryRenderOptions } from '../../runtime/lib/render.js';\n38: import {\n39:   createAdvisorHookDiagnosticRecord,\n40:   persistAdvisorHookDiagnosticRecord,\n41:   serializeAdvisorHookDiagnosticRecord,\n42: } from '../../runtime/lib/metrics.js';\n43: import { buildSkillAdvisorBriefFromCli } from '../lib/skill-advisor-cli-fallback.js';\n44: \n45: export { renderAdvisorFallbackDirective };\n46: \n47: // ───────────────────────────────────────────────────────────────\n48: // 2. CONFIGURATION\n49: // ───────────────────────────────────────────────────────────────\n50: \n51: const IS_CLI_ENTRY = process.argv[1]\n52:   ? resolve(process.argv[1]) === fileURLToPath(import.meta.url)\n53:   : false;\n54: \n55: const requireFromAdvisor = createRequire(import.meta.url);\n56: \n57: // Setup, install and configure words trigger the hint; check needs nearby tooling context.\n58: // Bounded context keeps unrelated checks quiet without scanning long prompts.\n59: export const SETUP_WORDING = new RegExp(\n60:   String.raw`\\b(?:set[\\s-]?up|setups?`\n61:     + String.raw`|(?:re)?install(?:s|ed|ing|ation|er|ers)?`\n62:     + String.raw`|configur(?:e|es|ed|ing|ations?)`\n63:     + String.raw`|check(?:s|ed|ing)?(?:\\s+\\S+){0,2}?\\s+`\n64:     + String.raw`(?:environment|env|config(?:s|urations?)?`\n65:     + String.raw`|hooks?|tools|tooling|toolchain|skilled))\\b`,\n66:   'i',\n67: );\n68: function skillAdvisorHookEnabled(): boolean {\n69:   try {\n70:     const { isHookEnabled } = requireFromAdvisor(\n71:       fileURLToPath(new URL('../../../../../../hooks/shared/hook-flags.cjs', import.meta.url)),\n72:     ) as { isHookEnabled?: (concern: string) => boolean };\n73:     return typeof isHookEnabled !== 'function' || isHookEnabled('skill-advisor') !== false;\n74:   } catch {\n75:     return true;\n76:   }\n77: }\n78: \n79: // ───────────────────────────────────────────────────────────────\n80: // 3. TYPES\n81: // ───────────────────────────────────────────────────────────────\n82: \n83: export interface ClaudeUserPromptSubmitInput {\n84:   readonly session_id?: string;\n85:   readonly session_identity_confirmed?: boolean;\n86:   readonly session_identity_ambiguous?: boolean;\n87:   readonly hook_event_name?: string;\n88:   readonly lifecycle_event?: string;\n89:   readonly lifecycle_source?: string;\n90:   readonly source?: string;\n91:   readonly scope_changed?: boolean;\n92:   readonly policy_set_changed?: boolean;\n93:   readonly goal_changed?: boolean;\n94:   readonly delivery_receipt_status?: 'configured' | 'observed' | 'unobserved' | 'unknown';\n95:   readonly prompt?: string;\n96:   readonly cwd?: string;\n97:   readonly transcript_path?: string;\n98:   readonly [key: string]: unknown;\n99: }\n100: \n101: export interface ClaudeHookSpecificOutput {\n102:   readonly hookSpecificOutput: {\n103:     readonly hookEventName: 'UserPromptSubmit';\n104:     readonly additionalContext: string;\n105:   };\n106: }\n107: \n108: export type ClaudeUserPromptSubmitOutput = ClaudeHookSpecificOutput | Record<string, never>;\n109: \n110: export interface UserPromptSubmitDependencies {\n111:   /** In-process callers such as Pi pass their runtime directly. */\n112:   readonly runtime?: AdvisorRuntime;\n113:   readonly buildBrief?: typeof buildSkillAdvisorBrief;\n114:   readonly buildCliBrief?: typeof buildSkillAdvisorBriefFromCli;\n115:   readonly renderBrief?: typeof renderAdvisorBrief;\n116:   readonly now?: () => number;\n117:   readonly writeDiagnostic?: (line: string) => void;\n118:   /** Per-session directive-lifecycle dedup state; defaults to the durable file-backed store. */\n119:   readonly directiveLifecycleStore?: DirectiveLifecycleState;\n120:   /** Delay a full-delivery receipt until the process handoff acknowledges stdout. */\n121:   readonly deferDirectiveReceipt?: boolean;\n122: }\n123: \n124: interface HookDiagnosticInput {\n125:   readonly runtime?: AdvisorRuntime;\n126:   readonly workspaceRoot: string;\n127:   readonly status: AdvisorHookStatus;\n128:   readonly freshness: AdvisorHookFreshness;\n129:   readonly durationMs: number;\n130:   readonly cacheHit: boolean;\n131:   readonly errorCode?: unknown;\n132:   readonly errorDetails?: string;\n133:   readonly skillLabel?: string | null;\n134:   readonly degraded?: boolean;\n135:   readonly generation?: number;\n136:   readonly emittedBytes?: number;\n137:   readonly directivesSuppressed?: boolean;\n138: }\n139: \n140: // ───────────────────────────────────────────────────────────────\n141: // 4. CONSTANTS\n142: // ───────────────────────────────────────────────────────────────\n143: \n144: export const DEFAULT_CLAUDE_HOOK_TIMEOUT_MS = 2500;\n145: const MAX_PROMPT_BYTES = 64 * 1024;\n146: const OBSERVED_ADVISOR_POLICY_CANDIDATE = '004';\n147: const DIRECTIVE_RECEIPT_COMMIT = Symbol('directiveReceiptCommit');\n148: const pendingDiagnosticWrites = new Set<Promise<unknown>>();\n149: \n150: // ───────────────────────────────────────────────────────────────\n151: // 5. HELPERS\n152: // ───────────────────────────────────────────────────────────────\n153: \n154: function isRecord(value: unknown): value is Record<string, unknown> {\n155:   return typeof value === 'object' && value !== null && !Array.isArray(value);\n156: }\n157: \n158: function normalizePrompt(value: unknown): string | null {\n159:   if (typeof value !== 'string') {\n160:     return null;\n161:   }\n162:   if (Buffer.byteLength(value, 'utf8') <= MAX_PROMPT_BYTES) {\n163:     return value;\n164:   }\n165: \n166:   let low = 0;\n167:   let high = value.length;\n168:   while (low < high) {\n169:     const midpoint = Math.ceil((low + high) / 2);\n170:     if (Buffer.byteLength(value.slice(0, midpoint), 'utf8') <= MAX_PROMPT_BYTES) {\n171:       low = midpoint;\n172:     } else {\n173:       high = midpoint - 1;\n174:     }\n175:   }\n176:   return value.slice(0, low);\n177: }\n178: \n179: export function workspaceRootFor(input: ClaudeUserPromptSubmitInput): string {\n180:   const start =\n181:     typeof input.cwd === 'string' && input.cwd.trim().length > 0\n182:       ? input.cwd\n183:       : process.cwd();\n184:   // Anchor to the real repo root. A raw session cwd inside a specs/<packet>\n185:   // directory would otherwise become the \"workspace root\", and the advisor's\n186:   // state writers materialize a stray .state/advisor tree under it.\n187:   return findAdvisorWorkspaceRoot(start);\n188: }\n189: \n190: function skillLabelFor(result: AdvisorHookResult): string | null {\n191:   const metadataLabel = result.sharedPayload?.metadata?.skillLabel;\n192:   if (typeof metadataLabel === 'string') {\n193:     return metadataLabel;\n194:   }\n195:   return result.recommendations[0]?.skill ?? null;\n196: }\n197: \n198: function positiveIntFromEnv(value: string | undefined, fallback: number): number {\n199:   if (typeof value !== 'string' || value.trim().length === 0) {\n200:     return fallback;\n201:   }\n202:   const parsed = Number.parseInt(value, 10);\n203:   return Number.isFinite(parsed) && parsed > 0 ? parsed : fallback;\n204: }\n205: \n206: function claudeHookTimeoutMs(): number {\n207:   return positiveIntFromEnv(process.env.SPECKIT_CLAUDE_HOOK_TIMEOUT_MS, DEFAULT_CLAUDE_HOOK_TIMEOUT_MS);\n208: }\n209: \n210: function lifecycleEventFor(input: ClaudeUserPromptSubmitInput): string | undefined {\n211:   const explicit = input.lifecycle_event ?? input.lifecycle_source;\n212:   if (explicit === 'startup' || explicit === 'resume' || explicit === 'compact') {\n213:     return explicit;\n214:   }\n215:   if (input.hook_event_name === 'SessionStart'\n216:     && (input.source === 'startup' || input.source === 'resume' || input.source === 'compact')) {\n217:     return input.source;\n218:   }\n219:   return undefined;\n220: }\n221: \n222: /** Convert runtime-owned identity and lifecycle fields into shadow-only signals. */\n223: export function deliveryStateOptionsFor(\n224:   input: ClaudeUserPromptSubmitInput,\n225: ): ShadowDeliveryRenderOptions {\n226:   const hasSessionId = typeof input.session_id === 'string' && input.session_id.trim().length > 0;\n227:   return {\n228:     sessionId: input.session_id,\n229:     sessionIdentityConfirmed: input.session_identity_confirmed ?? hasSessionId,\n230:     sessionIdentityAmbiguous: input.session_identity_ambiguous === true,\n231:     lifecycleEvent: lifecycleEventFor(input),\n232:     scopeChanged: input.scope_changed === true,\n233:     policySetChanged: input.policy_set_changed === true,\n234:     goalChanged: input.goal_changed === true,\n235:     deliveryConfirmed: false,\n236:   };\n237: }\n238: \n239: export function emitDiagnostic(\n240:   record: HookDiagnosticInput,\n241:   writeDiagnostic: (line: string) => void = (line) => process.stderr.write(`${line}\\n`),\n242:   persistDiagnostic: typeof persistAdvisorHookDiagnosticRecord = persistAdvisorHookDiagnosticRecord,\n243: ): void {\n244:   try {\n245:     const diagnosticRecord = createAdvisorHookDiagnosticRecord({\n246:       runtime: 'claude',\n247:       ...record,\n248:     });\n249:     const line = serializeAdvisorHookDiagnosticRecord(diagnosticRecord);\n250:     writeDiagnostic(line);\n251:     const pendingWrite = persistDiagnostic(record.workspaceRoot, diagnosticRecord).catch(() => undefined);\n252:     pendingDiagnosticWrites.add(pendingWrite);\n253:     void pendingWrite.then(() => pendingDiagnosticWrites.delete(pendingWrite));\n254:   } catch {\n255:     // Diagnostics must never affect hook behavior.\n256:   }\n257: }\n258: \n259: export async function flushPendingDiagnostics(maxWaitMs = 100): Promise<void> {\n260:   let timeout: NodeJS.Timeout | undefined;\n261:   try {\n262:     if (pendingDiagnosticWrites.size === 0) return;\n263:     const pendingWrites = Promise.all([...pendingDiagnosticWrites]).then(() => undefined);\n264:     const timeoutElapsed = new Promise<void>((resolvePromise) => {\n265:       timeout = setTimeout(resolvePromise, maxWaitMs);\n266:       timeout.unref();\n267:     });\n268:     await Promise.race([pendingWrites, timeoutElapsed]);\n269:   } catch {\n270:     // Diagnostics must never affect hook behavior.\n271:   } finally {\n272:     if (timeout) clearTimeout(timeout);\n273:   }\n274: }\n275: \n276: export function parseClaudeUserPromptSubmitInput(raw: string): ClaudeUserPromptSubmitInput | null {\n277:   try {\n278:     const parsed = JSON.parse(raw) as unknown;\n279:     return isRecord(parsed) ? parsed : null;\n280:   } catch {\n281:     return null;\n282:   }\n283: }\n284: \n285: // ───────────────────────────────────────────────────────────────\n286: // 6. CORE LOGIC\n287: // ───────────────────────────────────────────────────────────────\n288: \n289: export async function handleClaudeUserPromptSubmit(\n290:   input: ClaudeUserPromptSubmitInput | null,\n291:   dependencies: UserPromptSubmitDependencies = {},\n292: ): Promise<ClaudeUserPromptSubmitOutput> {\n293:   const environmentRuntime = process.env.SPECKIT_RUNTIME;\n294:   const runtime = dependencies.runtime\n295:     ?? (isAdvisorRuntime(environmentRuntime) ? environmentRuntime : 'claude');\n296:   const startedAt = dependencies.now?.() ?? performance.now();\n297:   const elapsed = (): number => Number(((dependencies.now?.() ?? performance.now()) - startedAt).toFixed(3));\n298:   const writeDiagnostic = dependencies.writeDiagnostic;\n299: \n300:   try {\n301:     if (!skillAdvisorHookEnabled() || process.env.SPECKIT_SKILL_ADVISOR_HOOK_DISABLED === '1') {\n302:       emitDiagnostic({\n303:         runtime,\n304:         workspaceRoot: process.cwd(),\n305:         status: 'skipped',\n306:         freshness: 'unavailable',\n307:         durationMs: elapsed(),\n308:         cacheHit: false,\n309:       }, writeDiagnostic);\n310:       return {};\n311:     }\n312: \n313:     if (!input) {\n314:       emitDiagnostic({\n315:         runtime,\n316:         workspaceRoot: process.cwd(),\n317:         status: 'fail_open',\n318:         freshness: 'unavailable',\n319:         durationMs: elapsed(),\n320:         cacheHit: false,\n321:         errorCode: 'PARSE_FAIL',\n322:         errorDetails: 'Invalid UserPromptSubmit JSON payload',\n323:       }, writeDiagnostic);\n324:       return {};\n325:     }\n326: \n327:     const prompt = normalizePrompt(input.prompt);\n328:     const workspaceRoot = workspaceRootFor(input);\n329:     if (prompt === null) {\n330:       emitDiagnostic({\n331:         runtime,\n332:         workspaceRoot,\n333:         status: 'fail_open',\n334:         freshness: 'unavailable',\n335:         durationMs: elapsed(),\n336:         cacheHit: false,\n337:         errorCode: 'PARSE_FAIL',\n338:         errorDetails: 'Missing UserPromptSubmit prompt string',\n339:       }, writeDiagnostic);\n340:       return {};\n341:     }\n342: \n343:     const renderBrief = dependencies.renderBrief ?? renderAdvisorBrief;\n344:     // The CLI owns the warm-daemon probe and local-scorer fallback.\n345:     // The prompt-policy gate skips prompts that need no advisor before the\n346:     // CLI call; injected full producers stay ungated for producer-level tests.\n347:     const injectedBrief = dependencies.buildBrief;\n348:     const buildCliBrief = dependencies.buildCliBrief ?? buildSkillAdvisorBriefFromCli;\n349:     let result = injectedBrief\n350:       ? await injectedBrief(prompt, {\n351:         runtime,\n352:         workspaceRoot,\n353:         subprocessTimeoutMs: claudeHookTimeoutMs(),\n354:       })\n355:       : skippedAdvisorResultFor(prompt) ?? await buildCliBrief(prompt, {\n356:         runtime,\n357:         workspaceRoot,\n358:         timeoutMs: claudeHookTimeoutMs(),\n359:       }, {\n360:         now: dependencies.now,\n361:       });\n362: \n363:     result = {\n364:       ...result,\n365:       metrics: {\n366:         ...result.metrics,\n367:         durationMs: elapsed(),\n368:       },\n369:     };\n370:     const deliveryState = deliveryStateOptionsFor(input);\n371:     const brief = renderBrief(result, { deliveryState });\n372:     const renderOptions = { deliveryState, setupWording: !brief && SETUP_WORDING.test(prompt) };\n373:     const emitted = brief ?? renderAdvisorFallbackDirective(renderOptions, result);\n374:     // Directive-lifecycle dedup delivers the full brief on the first message\n375:     // and after lifecycle boundaries or transcript shrink. On proven repeats,\n376:     // it keeps the head and drops the constant directive block. A headed\n377:     // fallback reduces like a brief; unknown sessions, the kill switch, and\n378:     // thrown errors still get the full text.\n379:     let effectiveEmitted = emitted;\n380:     let commitFullReceipt: (() => boolean) | undefined;\n381:     try {\n382:       const sessionId = typeof input.session_id === 'string' && input.session_id.trim().length > 0\n383:         ? input.session_id\n384:         : undefined;\n385:       const sessionConfirmed = input.session_identity_confirmed\n386:         ?? (Boolean(sessionId) && input.session_identity_ambiguous !== true);\n387:       const transcriptPath = typeof input.transcript_path === 'string' && input.transcript_path.length > 0\n388:         ? input.transcript_path\n389:         : null;\n390:       let transcriptBytes: number | null = null;\n391:       if (transcriptPath) {\n392:         try {\n393:           transcriptBytes = statSync(transcriptPath).size;\n394:         } catch {\n395:           transcriptBytes = null;\n396:         }\n397:       }\n398:       const decision = decideDirectiveLifecycleDelivery(emitted, {\n399:         state: dependencies.directiveLifecycleStore ?? defaultDirectiveLifecycleStore(),\n400:         sessionId,\n401:         sessionConfirmed,\n402:         lifecycleEvent: lifecycleEventFor(input),\n403:         transcriptPath,\n404:         transcriptBytes,\n405:         enabled: isDirectiveLifecycleDedupEnabled(),\n406:         deferFullReceipt: dependencies.deferDirectiveReceipt === true,\n407:       });\n408:       commitFullReceipt = decision.commitFullReceipt;\n409:       if (decision.suppressed && decision.reducedContext) {\n410:         effectiveEmitted = decision.reducedContext;\n411:       }\n412:     } catch {\n413:       // Directive dedup is advisory; on any failure keep the full brief.\n414:       effectiveEmitted = emitted;\n415:     }\n416:     emitDiagnostic({\n417:       runtime,\n418:       workspaceRoot,\n419:       status: result.status,\n420:       freshness: result.freshness,\n421:       durationMs: result.metrics.durationMs,\n422:       cacheHit: result.metrics.cacheHit,\n423:       errorCode: result.diagnostics?.errorCode,\n424:       errorDetails: result.diagnostics?.errorMessage ?? result.diagnostics?.policyReason ?? result.diagnostics?.staleReason,\n425:       skillLabel: skillLabelFor(result),\n426:       degraded: result.metrics.degraded === true,\n427:       emittedBytes: Buffer.byteLength(effectiveEmitted, 'utf8'),\n428:       directivesSuppressed: effectiveEmitted !== emitted,\n429:     }, writeDiagnostic);\n430: \n431:     const output: ClaudeUserPromptSubmitOutput = {\n432:       hookSpecificOutput: {\n433:         hookEventName: 'UserPromptSubmit',\n434:         additionalContext: effectiveEmitted,\n435:       },\n436:     };\n437:     if (commitFullReceipt) {\n438:       Object.defineProperty(output, DIRECTIVE_RECEIPT_COMMIT, {\n439:         configurable: true,\n440:         enumerable: false,\n441:         value: commitFullReceipt,\n442:       });\n443:     }\n444:     observeEmittedAdvisorPolicy(effectiveEmitted, {\n445:       ...deliveryState,\n446:       // Claude keeps its display label and every other caller is recorded under\n447:       // the runtime it named, so no other runtime's delivery is counted as Claude's.\n448:       runtime: runtime === 'claude' ? 'Claude Code' : runtime,\n449:       candidate: OBSERVED_ADVISOR_POLICY_CANDIDATE,\n450:     });\n451:     return output;\n452:   } catch {\n453:     emitDiagnostic({\n454:       runtime,\n455:       workspaceRoot: input ? workspaceRootFor(input) : process.cwd(),\n456:       status: 'fail_open',\n457:       freshness: 'unavailable',\n458:       durationMs: elapsed(),\n459:       cacheHit: false,\n460:       errorCode: 'UNKNOWN',\n461:       errorDetails: 'Unhandled UserPromptSubmit hook exception',\n462:     }, writeDiagnostic);\n463:     return {};\n464:   }\n465: }\n466: \n467: // ───────────────────────────────────────────────────────────────\n468: // 7. OUTPUT DELIVERY\n469: // ───────────────────────────────────────────────────────────────\n470: \n471: async function readStdin(): Promise<string> {\n472:   const chunks: Buffer[] = [];\n473:   for await (const chunk of process.stdin) {\n474:     chunks.push(chunk as Buffer);\n475:   }\n476:   return Buffer.concat(chunks).toString('utf-8').trim();\n477: }\n478: \n479: export function commitClaudeDirectiveDeliveryReceipt(\n480:   output: ClaudeUserPromptSubmitOutput,\n481: ): boolean {\n482:   const record = output as ClaudeUserPromptSubmitOutput & {\n483:     [DIRECTIVE_RECEIPT_COMMIT]?: () => boolean;\n484:   };\n485:   const commit = record[DIRECTIVE_RECEIPT_COMMIT];\n486:   if (!commit) return true;\n487:   delete record[DIRECTIVE_RECEIPT_COMMIT];\n488:   return commit();\n489: }\n490: \n491: function writeHookOutput(output: ClaudeUserPromptSubmitOutput): Promise<void> {\n492:   return new Promise<void>((resolvePromise) => {\n493:     process.stdout.write(`${JSON.stringify(output)}\\n`, () => {\n494:       commitClaudeDirectiveDeliveryReceipt(output);\n495:       resolvePromise();\n496:     });\n497:   });\n498: }\n499: \n500: // ───────────────────────────────────────────────────────────────\n501: // 8. CLI ENTRY POINT\n502: // ───────────────────────────────────────────────────────────────\n503: \n504: async function main(): Promise<void> {\n505:   const rawInput = await readStdin();\n506:   const input = rawInput ? parseClaudeUserPromptSubmitInput(rawInput) : null;\n507:   const output = await handleClaudeUserPromptSubmit(input, {\n508:     writeDiagnostic: (line) => process.stderr.write(`${line}\\n`),\n509:     deferDirectiveReceipt: true,\n510:   });\n511:   await writeHookOutput(output);\n512: }\n513: \n514: if (IS_CLI_ENTRY) {\n515:   main().catch(async () => {\n516:     emitDiagnostic({\n517:       workspaceRoot: process.cwd(),\n518:       status: 'fail_open',\n519:       freshness: 'unavailable',\n520:       durationMs: 0,\n521:       cacheHit: false,\n522:       errorCode: 'UNKNOWN',\n523:       errorDetails: 'Unhandled UserPromptSubmit CLI exception',\n524:     });\n525:     await writeHookOutput({});\n526:   }).finally(async () => {\n527:     // The exit would otherwise drop diagnostic appends; the cap preserves the shim's kill margin.\n528:     await flushPendingDiagnostics();\n529:     process.exit(0);\n530:   });\n531: }"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\".skilled/skills/system-skill-advisor/hooks/claude/user-prompt-submit.ts\"}"},"time":{"start":1794760906057,"end":1794760906352}}}}
