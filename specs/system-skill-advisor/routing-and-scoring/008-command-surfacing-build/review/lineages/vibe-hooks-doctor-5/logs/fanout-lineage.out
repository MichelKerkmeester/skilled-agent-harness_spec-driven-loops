{"type":"tool_use","timestamp":1794760808505,"sessionID":"ses_e1feefdd5ffeHQJCqAmpoKpkZG","part":{"partID":"prt_1e01497480021ttgVFF5iw3HIW","sessionID":"ses_e1feefdd5ffeHQJCqAmpoKpkZG","messageID":"msg_1e01460950015t2ra8J5EJQXKB","type":"tool","id":"call_572f0758df6f401cbe0a07b1","tool":"read","state":{"status":"completed","input":{"path":".skilled/commands/doctor/scripts/tests/hook-wiring-check.test.cjs"},"output":"Read file .skilled/commands/doctor/scripts/tests/hook-wiring-check.test.cjs, lines 1-371\n1: #!/usr/bin/env node\n2: // ───────────────────────────────────────────────────────────────────\n3: // MODULE: Hook Wiring Check Tests\n4: // ───────────────────────────────────────────────────────────────────\n5: 'use strict';\n6: \n7: // Drives the hook wiring check as a process against throwaway checkouts. The\n8: // cases pin both verdicts and the checkout that has no runtime folder at all.\n9: \n10: // ─────────────────────────────────────────────────────────────────────────────\n11: // 1. IMPORTS AND FIXTURES\n12: // ─────────────────────────────────────────────────────────────────────────────\n13: \n14: const assert = require('node:assert/strict');\n15: const { spawnSync } = require('node:child_process');\n16: const fs = require('node:fs');\n17: const os = require('node:os');\n18: const path = require('node:path');\n19: const test = require('node:test');\n20: \n21: const SCRIPT = path.resolve(__dirname, '..', 'hook-wiring-check.cjs');\n22: const CLAUDE_FILE = '.claude/settings.json';\n23: const CLAUDE_MARKER = '.skilled/skills/system-spec-kit/runtime/dist/hooks/claude/user-prompt-submit.js';\n24: const VIBE_FILE = '.vibe/hooks.toml';\n25: const VIBE_COMMAND = 'node \\\\\"$(git rev-parse --show-toplevel)/.skilled/hooks/session-lifecycle/vibe/turn-start.mjs\\\\\"';\n26: \n27: function fixture(t) {\n28:   const root = fs.mkdtempSync(path.join(os.tmpdir(), 'hook-wiring-check-'));\n29:   t.after(() => fs.rmSync(root, { recursive: true, force: true }));\n30:   const run = (...args) => {\n31:     const result = spawnSync(process.execPath, [SCRIPT, '--root', root, ...args], { encoding: 'utf8' });\n32:     return { code: result.status, out: result.stdout, err: result.stderr };\n33:   };\n34:   return { root, run };\n35: }\n36: \n37: function writeClaudeSettings(root, hooks) {\n38:   fs.mkdirSync(path.join(root, '.claude'), { recursive: true });\n39:   fs.writeFileSync(path.join(root, CLAUDE_FILE), JSON.stringify({ hooks }, null, 2));\n40: }\n41: \n42: function writeVibeHooks(root, text) {\n43:   fs.mkdirSync(path.join(root, '.vibe'), { recursive: true });\n44:   fs.writeFileSync(path.join(root, VIBE_FILE), text);\n45: }\n46: \n47: // The Vibe hook file is TOML, so one block is built as the lines the check reads.\n48: function vibeBlock(type, commandLine) {\n49:   return [\n50:     '[[hooks]]',\n51:     'name = \"turn-start\"',\n52:     `type = \"${type}\"`,\n53:     'match = \"main\"',\n54:     'timeout = 20.0',\n55:     commandLine,\n56:   ].join('\\n');\n57: }\n58: \n59: // ─────────────────────────────────────────────────────────────────────────────\n60: // 2. TESTS\n61: // ─────────────────────────────────────────────────────────────────────────────\n62: \n63: test('names a runtime whose prompt entry is absent', (t) => {\n64:   const f = fixture(t);\n65:   writeClaudeSettings(f.root, {\n66:     UserPromptSubmit: [{ hooks: [{ type: 'command', command: 'node some-other-hook.js' }] }],\n67:   });\n68:   const before = fs.readFileSync(path.join(f.root, CLAUDE_FILE), 'utf8');\n69:   const result = f.run();\n70:   assert.equal(result.code, 1);\n71:   assert.match(result.out, /^hook-missing claude \\.claude\\/settings\\.json$/m);\n72:   assert.equal(fs.readFileSync(path.join(f.root, CLAUDE_FILE), 'utf8'), before, 'check changed the hook file');\n73: });\n74: \n75: test('passes a runtime whose prompt entry is wired', (t) => {\n76:   const f = fixture(t);\n77:   writeClaudeSettings(f.root, {\n78:     UserPromptSubmit: [{\n79:       hooks: [{ type: 'command', command: `bash -c 'cd \"$PWD\" && node ${CLAUDE_MARKER}'` }],\n80:     }],\n81:   });\n82:   const text = f.run();\n83:   assert.equal(text.code, 0);\n84:   assert.equal(text.out.trim(), 'ok claude');\n85:   const json = f.run('--json');\n86:   assert.equal(json.code, 0);\n87:   assert.equal(JSON.parse(json.out).checks.find((check) => check.runtime === 'claude').status, 'ok');\n88: });\n89: \n90: test('passes a prompt entry that starts node on the script path', (t) => {\n91:   const f = fixture(t);\n92:   writeClaudeSettings(f.root, {\n93:     UserPromptSubmit: [{\n94:       hooks: [{ type: 'command', command: `node ${CLAUDE_MARKER}` }],\n95:     }],\n96:   });\n97:   const text = f.run();\n98:   assert.equal(text.code, 0);\n99:   assert.equal(text.out.trim(), 'ok claude');\n100: });\n101: \n102: test('passes a prompt entry that starts node by its absolute path', (t) => {\n103:   const f = fixture(t);\n104:   writeClaudeSettings(f.root, {\n105:     UserPromptSubmit: [{\n106:       hooks: [{ type: 'command', command: `/opt/homebrew/bin/node ${CLAUDE_MARKER}` }],\n107:     }],\n108:   });\n109:   const text = f.run();\n110:   assert.equal(text.code, 0);\n111:   assert.equal(text.out.trim(), 'ok claude');\n112: });\n113: \n114: test('names a runtime whose entry only names node as an argument', (t) => {\n115:   const f = fixture(t);\n116:   writeClaudeSettings(f.root, {\n117:     UserPromptSubmit: [{\n118:       hooks: [{ type: 'command', command: `echo node ${CLAUDE_MARKER}` }],\n119:     }],\n120:   });\n121:   const result = f.run();\n122:   assert.equal(result.code, 1);\n123:   assert.match(result.out, /^hook-missing claude \\.claude\\/settings\\.json$/m);\n124: });\n125: \n126: test('names a runtime whose entry only echoes the script path', (t) => {\n127:   const f = fixture(t);\n128:   writeClaudeSettings(f.root, {\n129:     UserPromptSubmit: [{\n130:       hooks: [{ type: 'command', command: 'echo hooks/claude/user-prompt-submit.js' }],\n131:     }],\n132:   });\n133:   const result = f.run();\n134:   assert.equal(result.code, 1);\n135:   assert.match(result.out, /^hook-missing claude \\.claude\\/settings\\.json$/m);\n136: });\n137: \n138: test('names a runtime whose entry only describes the script', (t) => {\n139:   const f = fixture(t);\n140:   writeClaudeSettings(f.root, {\n141:     UserPromptSubmit: [{\n142:       hooks: [{\n143:         type: 'command',\n144:         command: 'node some-other-hook.js',\n145:         description: 'hooks/claude/user-prompt-submit.js',\n146:       }],\n147:     }],\n148:   });\n149:   const result = f.run();\n150:   assert.equal(result.code, 1);\n151:   assert.match(result.out, /^hook-missing claude \\.claude\\/settings\\.json$/m);\n152: });\n153: \n154: test('passes a launch that starts node through env', (t) => {\n155:   const f = fixture(t);\n156:   writeClaudeSettings(f.root, {\n157:     UserPromptSubmit: [{ hooks: [{ type: 'command', command: `env node ${CLAUDE_MARKER}` }] }],\n158:   });\n159:   const text = f.run();\n160:   assert.equal(text.code, 0);\n161:   assert.equal(text.out.trim(), 'ok claude');\n162: });\n163: \n164: test('passes a launch that starts node through an absolute env', (t) => {\n165:   const f = fixture(t);\n166:   writeClaudeSettings(f.root, {\n167:     UserPromptSubmit: [{ hooks: [{ type: 'command', command: `/usr/bin/env node ${CLAUDE_MARKER}` }] }],\n168:   });\n169:   const text = f.run();\n170:   assert.equal(text.code, 0);\n171:   assert.equal(text.out.trim(), 'ok claude');\n172: });\n173: \n174: test('passes a launch that runs node inside a bash login command', (t) => {\n175:   const f = fixture(t);\n176:   writeClaudeSettings(f.root, {\n177:     UserPromptSubmit: [{ hooks: [{ type: 'command', command: `bash -lc \"node ${CLAUDE_MARKER}\"` }] }],\n178:   });\n179:   const text = f.run();\n180:   assert.equal(text.code, 0);\n181:   assert.equal(text.out.trim(), 'ok claude');\n182: });\n183: \n184: test('passes a launch that runs node inside a zsh command', (t) => {\n185:   const f = fixture(t);\n186:   writeClaudeSettings(f.root, {\n187:     UserPromptSubmit: [{ hooks: [{ type: 'command', command: `zsh -c 'node ${CLAUDE_MARKER}'` }] }],\n188:   });\n189:   const text = f.run();\n190:   assert.equal(text.code, 0);\n191:   assert.equal(text.out.trim(), 'ok claude');\n192: });\n193: \n194: test('passes a launch that gives node a flag', (t) => {\n195:   const f = fixture(t);\n196:   writeClaudeSettings(f.root, {\n197:     UserPromptSubmit: [{ hooks: [{ type: 'command', command: `node --no-warnings ${CLAUDE_MARKER}` }] }],\n198:   });\n199:   const text = f.run();\n200:   assert.equal(text.code, 0);\n201:   assert.equal(text.out.trim(), 'ok claude');\n202: });\n203: \n204: test('passes a launch whose separator sticks to the previous word', (t) => {\n205:   const f = fixture(t);\n206:   writeClaudeSettings(f.root, {\n207:     UserPromptSubmit: [{ hooks: [{ type: 'command', command: `cd \"\\$PWD\"&& node ${CLAUDE_MARKER}` }] }],\n208:   });\n209:   const text = f.run();\n210:   assert.equal(text.code, 0);\n211:   assert.equal(text.out.trim(), 'ok claude');\n212: });\n213: \n214: test('passes a launch whose semicolon sticks to the previous word', (t) => {\n215:   const f = fixture(t);\n216:   writeClaudeSettings(f.root, {\n217:     UserPromptSubmit: [{ hooks: [{ type: 'command', command: `cd /tmp; node ${CLAUDE_MARKER}` }] }],\n218:   });\n219:   const text = f.run();\n220:   assert.equal(text.code, 0);\n221:   assert.equal(text.out.trim(), 'ok claude');\n222: });\n223: \n224: test('names a runtime whose entry echoes a quoted command', (t) => {\n225:   const f = fixture(t);\n226:   writeClaudeSettings(f.root, {\n227:     UserPromptSubmit: [{ hooks: [{ type: 'command', command: `echo \"x && node ${CLAUDE_MARKER}\"` }] }],\n228:   });\n229:   const result = f.run();\n230:   assert.equal(result.code, 1);\n231:   assert.match(result.out, /^hook-missing claude \\.claude\\/settings\\.json$/m);\n232: });\n233: \n234: // Vibe keeps its hooks in TOML and only a `pre_agent` entry that starts node on\n235: // the turn-start script runs before the prompt, so each shape below must not count.\n236: test('passes the Vibe turn-start entry under pre_agent', (t) => {\n237:   const f = fixture(t);\n238:   writeVibeHooks(f.root, vibeBlock('pre_agent', 'command = \"' + VIBE_COMMAND + '\"'));\n239:   const text = f.run();\n240:   assert.equal(text.code, 0);\n241:   assert.equal(text.out.trim(), 'ok vibe');\n242: });\n243: \n244: test('names Vibe when its turn-start entry runs under post_agent', (t) => {\n245:   const f = fixture(t);\n246:   writeVibeHooks(f.root, vibeBlock('post_agent', 'command = \"' + VIBE_COMMAND + '\"'));\n247:   const result = f.run();\n248:   assert.equal(result.code, 1);\n249:   assert.match(result.out, /^hook-missing vibe \\.vibe\\/hooks\\.toml$/m);\n250: });\n251: \n252: test('names Vibe when its turn-start command is commented out', (t) => {\n253:   const f = fixture(t);\n254:   writeVibeHooks(f.root, vibeBlock(\n255:     'pre_agent',\n256:     '# command = \"' + VIBE_COMMAND + '\"\\ncommand = \"node other-hook.mjs\"',\n257:   ));\n258:   const result = f.run();\n259:   assert.equal(result.code, 1);\n260:   assert.match(result.out, /^hook-missing vibe /m);\n261: });\n262: \n263: test('names Vibe when only a name mentions the script', (t) => {\n264:   const f = fixture(t);\n265:   const block = vibeBlock('pre_agent', 'command = \"node other-hook.mjs\"')\n266:     .replace('name = \"turn-start\"', 'name = \"hooks/session-lifecycle/vibe/turn-start.mjs\"');\n267:   writeVibeHooks(f.root, block);\n268:   const result = f.run();\n269:   assert.equal(result.code, 1);\n270:   assert.match(result.out, /^hook-missing vibe /m);\n271: });\n272: \n273: test('names Vibe when its folder holds no hooks file', (t) => {\n274:   const f = fixture(t);\n275:   fs.mkdirSync(path.join(f.root, '.vibe'), { recursive: true });\n276:   const result = f.run();\n277:   assert.equal(result.code, 1);\n278:   assert.match(result.out, /^hook-missing vibe /m);\n279: });\n280: \n281: test('reads a commented hooks header as the start of the next block', (t) => {\n282:   const f = fixture(t);\n283:   writeVibeHooks(f.root, [\n284:     vibeBlock('pre_agent', 'command = \"' + VIBE_COMMAND + '\"'),\n285:     '[[hooks]]  # turn end',\n286:     'name = \"turn-end\"',\n287:     'type = \"post_agent\"',\n288:     'command = \"node other-hook.mjs\"',\n289:   ].join('\\n'));\n290:   const text = f.run();\n291:   assert.equal(text.code, 0);\n292:   assert.equal(text.out.trim(), 'ok vibe');\n293: });\n294: \n295: test(\"does not credit a later table's command to the hooks block before it\", (t) => {\n296:   const f = fixture(t);\n297:   writeVibeHooks(f.root, [\n298:     vibeBlock('pre_agent', 'command = \"node other-hook.mjs\"'),\n299:     '[[notes]]',\n300:     'command = \"' + VIBE_COMMAND + '\"',\n301:   ].join('\\n'));\n302:   const result = f.run();\n303:   assert.equal(result.code, 1);\n304:   assert.match(result.out, /^hook-missing vibe \\.vibe\\/hooks\\.toml$/m);\n305: });\n306: \n307: test('reads a spaced hooks header', (t) => {\n308:   const f = fixture(t);\n309:   writeVibeHooks(f.root, vibeBlock('pre_agent', 'command = \"' + VIBE_COMMAND + '\"')\n310:     .replace('[[hooks]]', '[[ hooks ]]'));\n311:   const text = f.run();\n312:   assert.equal(text.code, 0);\n313:   assert.equal(text.out.trim(), 'ok vibe');\n314: });\n315: \n316: test('skips a runtime whose folder is absent', (t) => {\n317:   const f = fixture(t);\n318:   const text = f.run();\n319:   assert.equal(text.code, 0);\n320:   assert.equal(text.out, '');\n321:   const json = f.run('--json');\n322:   assert.equal(json.code, 0);\n323:   assert.deepEqual(JSON.parse(json.out).checks.map((check) => check.status), ['skipped', 'skipped', 'skipped', 'skipped', 'skipped']);\n324: });\n325: \n326: // Launch shapes a shell runs, each with node standing where a command starts.\n327: for (const [label, build] of [\n328:   ['env unsets a variable first', (m) => `env -u AI_SESSION_CHILD node ${m}`],\n329:   ['node preloads a module', (m) => `node -r ./preload.cjs ${m}`],\n330:   ['node preloads a module attached to the flag', (m) => `node -r./preload.cjs ${m}`],\n331:   ['the command runs in a subshell', (m) => `(node ${m})`],\n332:   ['the command runs in a brace group', (m) => `{ node ${m}; }`],\n333:   ['exec replaces the shell', (m) => `exec node ${m}`],\n334:   ['the command builtin starts node', (m) => `command node ${m}`],\n335:   ['node runs in a conditional', (m) => `if true; then node ${m}; fi`],\n336:   ['nohup starts node', (m) => `nohup node ${m}`],\n337:   ['a background command comes first', (m) => `cd /tmp & node ${m}`],\n338:   ['a backslash continues the line', (m) => `node \\\\\\n${m}`],\n339: ]) {\n340:   test(`passes a launch where ${label}`, (t) => {\n341:     const f = fixture(t);\n342:     writeClaudeSettings(f.root, {\n343:       UserPromptSubmit: [{ hooks: [{ type: 'command', command: build(CLAUDE_MARKER) }] }],\n344:     });\n345:     const text = f.run();\n346:     assert.equal(text.code, 0);\n347:     assert.equal(text.out.trim(), 'ok claude');\n348:   });\n349: }\n350: \n351: // Text that names node and the script without a shell ever running it.\n352: for (const [label, build] of [\n353:   ['a quote never closes', (m) => `echo \"x; node ${m}`],\n354:   ['node only checks the syntax', (m) => `node --check ${m}`],\n355:   ['node evaluates inline code', (m) => `node -e \"1\" ${m}`],\n356:   ['node evaluates code attached to the flag', (m) => `node -e1 ${m}`],\n357:   ['node evaluates code given with an equals sign', (m) => `node --eval=1 ${m}`],\n358:   ['node prints an expression given with an equals sign', (m) => `node --print=1 ${m}`],\n359:   ['the launch sits in a comment', (m) => `true # ; node ${m}`],\n360:   ['a shell script takes its own -c argument', (m) => `bash ./x.sh -c \"node ${m}\"`],\n361: ]) {\n362:   test(`names a runtime when ${label}`, (t) => {\n363:     const f = fixture(t);\n364:     writeClaudeSettings(f.root, {\n365:       UserPromptSubmit: [{ hooks: [{ type: 'command', command: build(CLAUDE_MARKER) }] }],\n366:     });\n367:     const text = f.run();\n368:     assert.equal(text.code, 1);\n369:     assert.match(text.out, /^hook-missing claude \\.claude\\/settings\\.json$/m);\n370:   });\n371: }","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file .skilled/commands/doctor/scripts/tests/hook-wiring-check.test.cjs, lines 1-371\n1: #!/usr/bin/env node\n2: // ───────────────────────────────────────────────────────────────────\n3: // MODULE: Hook Wiring Check Tests\n4: // ───────────────────────────────────────────────────────────────────\n5: 'use strict';\n6: \n7: // Drives the hook wiring check as a process against throwaway checkouts. The\n8: // cases pin both verdicts and the checkout that has no runtime folder at all.\n9: \n10: // ─────────────────────────────────────────────────────────────────────────────\n11: // 1. IMPORTS AND FIXTURES\n12: // ─────────────────────────────────────────────────────────────────────────────\n13: \n14: const assert = require('node:assert/strict');\n15: const { spawnSync } = require('node:child_process');\n16: const fs = require('node:fs');\n17: const os = require('node:os');\n18: const path = require('node:path');\n19: const test = require('node:test');\n20: \n21: const SCRIPT = path.resolve(__dirname, '..', 'hook-wiring-check.cjs');\n22: const CLAUDE_FILE = '.claude/settings.json';\n23: const CLAUDE_MARKER = '.skilled/skills/system-spec-kit/runtime/dist/hooks/claude/user-prompt-submit.js';\n24: const VIBE_FILE = '.vibe/hooks.toml';\n25: const VIBE_COMMAND = 'node \\\\\"$(git rev-parse --show-toplevel)/.skilled/hooks/session-lifecycle/vibe/turn-start.mjs\\\\\"';\n26: \n27: function fixture(t) {\n28:   const root = fs.mkdtempSync(path.join(os.tmpdir(), 'hook-wiring-check-'));\n29:   t.after(() => fs.rmSync(root, { recursive: true, force: true }));\n30:   const run = (...args) => {\n31:     const result = spawnSync(process.execPath, [SCRIPT, '--root', root, ...args], { encoding: 'utf8' });\n32:     return { code: result.status, out: result.stdout, err: result.stderr };\n33:   };\n34:   return { root, run };\n35: }\n36: \n37: function writeClaudeSettings(root, hooks) {\n38:   fs.mkdirSync(path.join(root, '.claude'), { recursive: true });\n39:   fs.writeFileSync(path.join(root, CLAUDE_FILE), JSON.stringify({ hooks }, null, 2));\n40: }\n41: \n42: function writeVibeHooks(root, text) {\n43:   fs.mkdirSync(path.join(root, '.vibe'), { recursive: true });\n44:   fs.writeFileSync(path.join(root, VIBE_FILE), text);\n45: }\n46: \n47: // The Vibe hook file is TOML, so one block is built as the lines the check reads.\n48: function vibeBlock(type, commandLine) {\n49:   return [\n50:     '[[hooks]]',\n51:     'name = \"turn-start\"',\n52:     `type = \"${type}\"`,\n53:     'match = \"main\"',\n54:     'timeout = 20.0',\n55:     commandLine,\n56:   ].join('\\n');\n57: }\n58: \n59: // ─────────────────────────────────────────────────────────────────────────────\n60: // 2. TESTS\n61: // ─────────────────────────────────────────────────────────────────────────────\n62: \n63: test('names a runtime whose prompt entry is absent', (t) => {\n64:   const f = fixture(t);\n65:   writeClaudeSettings(f.root, {\n66:     UserPromptSubmit: [{ hooks: [{ type: 'command', command: 'node some-other-hook.js' }] }],\n67:   });\n68:   const before = fs.readFileSync(path.join(f.root, CLAUDE_FILE), 'utf8');\n69:   const result = f.run();\n70:   assert.equal(result.code, 1);\n71:   assert.match(result.out, /^hook-missing claude \\.claude\\/settings\\.json$/m);\n72:   assert.equal(fs.readFileSync(path.join(f.root, CLAUDE_FILE), 'utf8'), before, 'check changed the hook file');\n73: });\n74: \n75: test('passes a runtime whose prompt entry is wired', (t) => {\n76:   const f = fixture(t);\n77:   writeClaudeSettings(f.root, {\n78:     UserPromptSubmit: [{\n79:       hooks: [{ type: 'command', command: `bash -c 'cd \"$PWD\" && node ${CLAUDE_MARKER}'` }],\n80:     }],\n81:   });\n82:   const text = f.run();\n83:   assert.equal(text.code, 0);\n84:   assert.equal(text.out.trim(), 'ok claude');\n85:   const json = f.run('--json');\n86:   assert.equal(json.code, 0);\n87:   assert.equal(JSON.parse(json.out).checks.find((check) => check.runtime === 'claude').status, 'ok');\n88: });\n89: \n90: test('passes a prompt entry that starts node on the script path', (t) => {\n91:   const f = fixture(t);\n92:   writeClaudeSettings(f.root, {\n93:     UserPromptSubmit: [{\n94:       hooks: [{ type: 'command', command: `node ${CLAUDE_MARKER}` }],\n95:     }],\n96:   });\n97:   const text = f.run();\n98:   assert.equal(text.code, 0);\n99:   assert.equal(text.out.trim(), 'ok claude');\n100: });\n101: \n102: test('passes a prompt entry that starts node by its absolute path', (t) => {\n103:   const f = fixture(t);\n104:   writeClaudeSettings(f.root, {\n105:     UserPromptSubmit: [{\n106:       hooks: [{ type: 'command', command: `/opt/homebrew/bin/node ${CLAUDE_MARKER}` }],\n107:     }],\n108:   });\n109:   const text = f.run();\n110:   assert.equal(text.code, 0);\n111:   assert.equal(text.out.trim(), 'ok claude');\n112: });\n113: \n114: test('names a runtime whose entry only names node as an argument', (t) => {\n115:   const f = fixture(t);\n116:   writeClaudeSettings(f.root, {\n117:     UserPromptSubmit: [{\n118:       hooks: [{ type: 'command', command: `echo node ${CLAUDE_MARKER}` }],\n119:     }],\n120:   });\n121:   const result = f.run();\n122:   assert.equal(result.code, 1);\n123:   assert.match(result.out, /^hook-missing claude \\.claude\\/settings\\.json$/m);\n124: });\n125: \n126: test('names a runtime whose entry only echoes the script path', (t) => {\n127:   const f = fixture(t);\n128:   writeClaudeSettings(f.root, {\n129:     UserPromptSubmit: [{\n130:       hooks: [{ type: 'command', command: 'echo hooks/claude/user-prompt-submit.js' }],\n131:     }],\n132:   });\n133:   const result = f.run();\n134:   assert.equal(result.code, 1);\n135:   assert.match(result.out, /^hook-missing claude \\.claude\\/settings\\.json$/m);\n136: });\n137: \n138: test('names a runtime whose entry only describes the script', (t) => {\n139:   const f = fixture(t);\n140:   writeClaudeSettings(f.root, {\n141:     UserPromptSubmit: [{\n142:       hooks: [{\n143:         type: 'command',\n144:         command: 'node some-other-hook.js',\n145:         description: 'hooks/claude/user-prompt-submit.js',\n146:       }],\n147:     }],\n148:   });\n149:   const result = f.run();\n150:   assert.equal(result.code, 1);\n151:   assert.match(result.out, /^hook-missing claude \\.claude\\/settings\\.json$/m);\n152: });\n153: \n154: test('passes a launch that starts node through env', (t) => {\n155:   const f = fixture(t);\n156:   writeClaudeSettings(f.root, {\n157:     UserPromptSubmit: [{ hooks: [{ type: 'command', command: `env node ${CLAUDE_MARKER}` }] }],\n158:   });\n159:   const text = f.run();\n160:   assert.equal(text.code, 0);\n161:   assert.equal(text.out.trim(), 'ok claude');\n162: });\n163: \n164: test('passes a launch that starts node through an absolute env', (t) => {\n165:   const f = fixture(t);\n166:   writeClaudeSettings(f.root, {\n167:     UserPromptSubmit: [{ hooks: [{ type: 'command', command: `/usr/bin/env node ${CLAUDE_MARKER}` }] }],\n168:   });\n169:   const text = f.run();\n170:   assert.equal(text.code, 0);\n171:   assert.equal(text.out.trim(), 'ok claude');\n172: });\n173: \n174: test('passes a launch that runs node inside a bash login command', (t) => {\n175:   const f = fixture(t);\n176:   writeClaudeSettings(f.root, {\n177:     UserPromptSubmit: [{ hooks: [{ type: 'command', command: `bash -lc \"node ${CLAUDE_MARKER}\"` }] }],\n178:   });\n179:   const text = f.run();\n180:   assert.equal(text.code, 0);\n181:   assert.equal(text.out.trim(), 'ok claude');\n182: });\n183: \n184: test('passes a launch that runs node inside a zsh command', (t) => {\n185:   const f = fixture(t);\n186:   writeClaudeSettings(f.root, {\n187:     UserPromptSubmit: [{ hooks: [{ type: 'command', command: `zsh -c 'node ${CLAUDE_MARKER}'` }] }],\n188:   });\n189:   const text = f.run();\n190:   assert.equal(text.code, 0);\n191:   assert.equal(text.out.trim(), 'ok claude');\n192: });\n193: \n194: test('passes a launch that gives node a flag', (t) => {\n195:   const f = fixture(t);\n196:   writeClaudeSettings(f.root, {\n197:     UserPromptSubmit: [{ hooks: [{ type: 'command', command: `node --no-warnings ${CLAUDE_MARKER}` }] }],\n198:   });\n199:   const text = f.run();\n200:   assert.equal(text.code, 0);\n201:   assert.equal(text.out.trim(), 'ok claude');\n202: });\n203: \n204: test('passes a launch whose separator sticks to the previous word', (t) => {\n205:   const f = fixture(t);\n206:   writeClaudeSettings(f.root, {\n207:     UserPromptSubmit: [{ hooks: [{ type: 'command', command: `cd \"\\$PWD\"&& node ${CLAUDE_MARKER}` }] }],\n208:   });\n209:   const text = f.run();\n210:   assert.equal(text.code, 0);\n211:   assert.equal(text.out.trim(), 'ok claude');\n212: });\n213: \n214: test('passes a launch whose semicolon sticks to the previous word', (t) => {\n215:   const f = fixture(t);\n216:   writeClaudeSettings(f.root, {\n217:     UserPromptSubmit: [{ hooks: [{ type: 'command', command: `cd /tmp; node ${CLAUDE_MARKER}` }] }],\n218:   });\n219:   const text = f.run();\n220:   assert.equal(text.code, 0);\n221:   assert.equal(text.out.trim(), 'ok claude');\n222: });\n223: \n224: test('names a runtime whose entry echoes a quoted command', (t) => {\n225:   const f = fixture(t);\n226:   writeClaudeSettings(f.root, {\n227:     UserPromptSubmit: [{ hooks: [{ type: 'command', command: `echo \"x && node ${CLAUDE_MARKER}\"` }] }],\n228:   });\n229:   const result = f.run();\n230:   assert.equal(result.code, 1);\n231:   assert.match(result.out, /^hook-missing claude \\.claude\\/settings\\.json$/m);\n232: });\n233: \n234: // Vibe keeps its hooks in TOML and only a `pre_agent` entry that starts node on\n235: // the turn-start script runs before the prompt, so each shape below must not count.\n236: test('passes the Vibe turn-start entry under pre_agent', (t) => {\n237:   const f = fixture(t);\n238:   writeVibeHooks(f.root, vibeBlock('pre_agent', 'command = \"' + VIBE_COMMAND + '\"'));\n239:   const text = f.run();\n240:   assert.equal(text.code, 0);\n241:   assert.equal(text.out.trim(), 'ok vibe');\n242: });\n243: \n244: test('names Vibe when its turn-start entry runs under post_agent', (t) => {\n245:   const f = fixture(t);\n246:   writeVibeHooks(f.root, vibeBlock('post_agent', 'command = \"' + VIBE_COMMAND + '\"'));\n247:   const result = f.run();\n248:   assert.equal(result.code, 1);\n249:   assert.match(result.out, /^hook-missing vibe \\.vibe\\/hooks\\.toml$/m);\n250: });\n251: \n252: test('names Vibe when its turn-start command is commented out', (t) => {\n253:   const f = fixture(t);\n254:   writeVibeHooks(f.root, vibeBlock(\n255:     'pre_agent',\n256:     '# command = \"' + VIBE_COMMAND + '\"\\ncommand = \"node other-hook.mjs\"',\n257:   ));\n258:   const result = f.run();\n259:   assert.equal(result.code, 1);\n260:   assert.match(result.out, /^hook-missing vibe /m);\n261: });\n262: \n263: test('names Vibe when only a name mentions the script', (t) => {\n264:   const f = fixture(t);\n265:   const block = vibeBlock('pre_agent', 'command = \"node other-hook.mjs\"')\n266:     .replace('name = \"turn-start\"', 'name = \"hooks/session-lifecycle/vibe/turn-start.mjs\"');\n267:   writeVibeHooks(f.root, block);\n268:   const result = f.run();\n269:   assert.equal(result.code, 1);\n270:   assert.match(result.out, /^hook-missing vibe /m);\n271: });\n272: \n273: test('names Vibe when its folder holds no hooks file', (t) => {\n274:   const f = fixture(t);\n275:   fs.mkdirSync(path.join(f.root, '.vibe'), { recursive: true });\n276:   const result = f.run();\n277:   assert.equal(result.code, 1);\n278:   assert.match(result.out, /^hook-missing vibe /m);\n279: });\n280: \n281: test('reads a commented hooks header as the start of the next block', (t) => {\n282:   const f = fixture(t);\n283:   writeVibeHooks(f.root, [\n284:     vibeBlock('pre_agent', 'command = \"' + VIBE_COMMAND + '\"'),\n285:     '[[hooks]]  # turn end',\n286:     'name = \"turn-end\"',\n287:     'type = \"post_agent\"',\n288:     'command = \"node other-hook.mjs\"',\n289:   ].join('\\n'));\n290:   const text = f.run();\n291:   assert.equal(text.code, 0);\n292:   assert.equal(text.out.trim(), 'ok vibe');\n293: });\n294: \n295: test(\"does not credit a later table's command to the hooks block before it\", (t) => {\n296:   const f = fixture(t);\n297:   writeVibeHooks(f.root, [\n298:     vibeBlock('pre_agent', 'command = \"node other-hook.mjs\"'),\n299:     '[[notes]]',\n300:     'command = \"' + VIBE_COMMAND + '\"',\n301:   ].join('\\n'));\n302:   const result = f.run();\n303:   assert.equal(result.code, 1);\n304:   assert.match(result.out, /^hook-missing vibe \\.vibe\\/hooks\\.toml$/m);\n305: });\n306: \n307: test('reads a spaced hooks header', (t) => {\n308:   const f = fixture(t);\n309:   writeVibeHooks(f.root, vibeBlock('pre_agent', 'command = \"' + VIBE_COMMAND + '\"')\n310:     .replace('[[hooks]]', '[[ hooks ]]'));\n311:   const text = f.run();\n312:   assert.equal(text.code, 0);\n313:   assert.equal(text.out.trim(), 'ok vibe');\n314: });\n315: \n316: test('skips a runtime whose folder is absent', (t) => {\n317:   const f = fixture(t);\n318:   const text = f.run();\n319:   assert.equal(text.code, 0);\n320:   assert.equal(text.out, '');\n321:   const json = f.run('--json');\n322:   assert.equal(json.code, 0);\n323:   assert.deepEqual(JSON.parse(json.out).checks.map((check) => check.status), ['skipped', 'skipped', 'skipped', 'skipped', 'skipped']);\n324: });\n325: \n326: // Launch shapes a shell runs, each with node standing where a command starts.\n327: for (const [label, build] of [\n328:   ['env unsets a variable first', (m) => `env -u AI_SESSION_CHILD node ${m}`],\n329:   ['node preloads a module', (m) => `node -r ./preload.cjs ${m}`],\n330:   ['node preloads a module attached to the flag', (m) => `node -r./preload.cjs ${m}`],\n331:   ['the command runs in a subshell', (m) => `(node ${m})`],\n332:   ['the command runs in a brace group', (m) => `{ node ${m}; }`],\n333:   ['exec replaces the shell', (m) => `exec node ${m}`],\n334:   ['the command builtin starts node', (m) => `command node ${m}`],\n335:   ['node runs in a conditional', (m) => `if true; then node ${m}; fi`],\n336:   ['nohup starts node', (m) => `nohup node ${m}`],\n337:   ['a background command comes first', (m) => `cd /tmp & node ${m}`],\n338:   ['a backslash continues the line', (m) => `node \\\\\\n${m}`],\n339: ]) {\n340:   test(`passes a launch where ${label}`, (t) => {\n341:     const f = fixture(t);\n342:     writeClaudeSettings(f.root, {\n343:       UserPromptSubmit: [{ hooks: [{ type: 'command', command: build(CLAUDE_MARKER) }] }],\n344:     });\n345:     const text = f.run();\n346:     assert.equal(text.code, 0);\n347:     assert.equal(text.out.trim(), 'ok claude');\n348:   });\n349: }\n350: \n351: // Text that names node and the script without a shell ever running it.\n352: for (const [label, build] of [\n353:   ['a quote never closes', (m) => `echo \"x; node ${m}`],\n354:   ['node only checks the syntax', (m) => `node --check ${m}`],\n355:   ['node evaluates inline code', (m) => `node -e \"1\" ${m}`],\n356:   ['node evaluates code attached to the flag', (m) => `node -e1 ${m}`],\n357:   ['node evaluates code given with an equals sign', (m) => `node --eval=1 ${m}`],\n358:   ['node prints an expression given with an equals sign', (m) => `node --print=1 ${m}`],\n359:   ['the launch sits in a comment', (m) => `true # ; node ${m}`],\n360:   ['a shell script takes its own -c argument', (m) => `bash ./x.sh -c \"node ${m}\"`],\n361: ]) {\n362:   test(`names a runtime when ${label}`, (t) => {\n363:     const f = fixture(t);\n364:     writeClaudeSettings(f.root, {\n365:       UserPromptSubmit: [{ hooks: [{ type: 'command', command: build(CLAUDE_MARKER) }] }],\n366:     });\n367:     const text = f.run();\n368:     assert.equal(text.code, 1);\n369:     assert.match(text.out, /^hook-missing claude \\.claude\\/settings\\.json$/m);\n370:   });\n371: }"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\".skilled/commands/doctor/scripts/tests/hook-wiring-check.test.cjs\"}"},"time":{"start":1794760808264,"end":1794760808505}}}}
