{"type":"tool_use","timestamp":1794760879561,"sessionID":"ses_e1feefdd5ffeHQJCqAmpoKpkZG","part":{"partID":"prt_1e015a9d4001yvKUIIQxCP2va5","sessionID":"ses_e1feefdd5ffeHQJCqAmpoKpkZG","messageID":"msg_1e015983c001KLNAPxfpavaQIt","type":"tool","id":"call_f89d502dd1f54158841ddeb2","tool":"shell","state":{"status":"completed","input":{"command":"git diff db14c22bb0..HEAD -- .github/workflows/spec-kit-check.yml .skilled/commands/doctor/_routes.yaml .skilled/commands/doctor/scripts/hook-wiring-check.cjs .skilled/commands/doctor/scripts/README.markdown .skilled/commands/scripts/validate-command-references.cjs .skilled/skills/system-skill-advisor/hooks/claude/user-prompt-submit.ts .skilled/skills/system-skill-advisor/hooks/skill-advisor-hook.md"},"output":"diff --git a/.github/workflows/spec-kit-check.yml b/.github/workflows/spec-kit-check.yml\nindex 0a4b044dd82..5eaa6a7c891 100644\n--- a/.github/workflows/spec-kit-check.yml\n+++ b/.github/workflows/spec-kit-check.yml\n@@ -20,7 +20,9 @@ on:\n       # The mirror-parity job compares generated mirrors against their sources.\n       # Triggering on the spec-kit runtime alone let a mirror drift on a command\n       # or agent commit, ship unseen, and fail here later on whoever next touched\n-      # the runtime. Every mirror source and every mirror output triggers it now.\n+      # the runtime. Every command and agent mirror source and output triggers it now.\n+      # A Vibe-only or SKILL.md-only change runs the same Vibe checks in\n+      # command-tree-parity.yml, which filters on those paths.\n       - '.opencode/commands/**'\n       - '.skilled/commands/**'\n       - '.opencode/agents/**'\n@@ -61,7 +63,9 @@ on:\n       # The mirror-parity job compares generated mirrors against their sources.\n       # Triggering on the spec-kit runtime alone let a mirror drift on a command\n       # or agent commit, ship unseen, and fail here later on whoever next touched\n-      # the runtime. Every mirror source and every mirror output triggers it now.\n+      # the runtime. Every command and agent mirror source and output triggers it now.\n+      # A Vibe-only or SKILL.md-only change runs the same Vibe checks in\n+      # command-tree-parity.yml, which filters on those paths.\n       - '.opencode/commands/**'\n       - '.skilled/commands/**'\n       - '.opencode/agents/**'\n@@ -330,6 +334,9 @@ jobs:\n           node .opencode/commands/doctor/scripts/command-catalog-mirror-check.cjs\n           node .opencode/skills/system-spec-kit/runtime/cli/runtime-mirrors/sync-hook-registrations.cjs --check\n           node .opencode/skills/system-spec-kit/runtime/cli/runtime-mirrors/sync-gate1-pointers.cjs --check\n+          node .opencode/skills/system-spec-kit/runtime/cli/vibe/sync-skills-vibe.cjs --check\n+          node .opencode/skills/system-spec-kit/runtime/cli/vibe/sync-prompts-vibe.cjs --check\n+          node .opencode/skills/system-spec-kit/runtime/cli/vibe/sync-agents-vibe.cjs --check\n \n   doctor-scripts:\n     name: Doctor script test suites\ndiff --git a/.skilled/commands/doctor/_routes.yaml b/.skilled/commands/doctor/_routes.yaml\nindex 939d31acebe..28e9ef8ee60 100644\n--- a/.skilled/commands/doctor/_routes.yaml\n+++ b/.skilled/commands/doctor/_routes.yaml\n@@ -93,7 +93,7 @@ routes:\n     target: deep-loop\n     yaml: doctor-deep-loop.yaml\n     setup_vars: [execution_mode, intent, scope]\n-    allowed_flags: [\"--scope=research|review|council|both|all\"]\n+    allowed_flags: [\"--scope=research|review|both|all\"]\n     mutating: add-only\n     write_scope: spec-folder\n     gate3_location: \"<active-spec-folder>/scratch/doctor-deep-loop-state.<timestamp>.json\"\n@@ -265,6 +265,9 @@ routes:\n       - 'node .skilled/skills/system-spec-kit/runtime/cli/dsh/sync-skills-dsh.cjs --check  # n/a, not run, while .dsh/ is absent'\n       - 'node .skilled/skills/system-spec-kit/runtime/cli/dsh/sync-prompts-dsh.cjs --check  # n/a, not run, while .dsh/ is absent'\n       - 'node .skilled/skills/system-spec-kit/runtime/cli/dsh/sync-agents-dsh.cjs --check  # n/a, not run, while .dsh/ is absent'\n+      - 'node .skilled/skills/system-spec-kit/runtime/cli/vibe/sync-prompts-vibe.cjs --check  # n/a, not run, while .vibe/ is absent'\n+      - 'node .skilled/skills/system-spec-kit/runtime/cli/vibe/sync-agents-vibe.cjs --check  # n/a, not run, while .vibe/ is absent'\n+      - 'node .skilled/skills/system-spec-kit/runtime/cli/vibe/sync-skills-vibe.cjs --check  # n/a, not run, while .vibe/ is absent'\n       - 'node .skilled/commands/doctor/scripts/agent-roster-mirror-check.cjs'\n       - 'node .skilled/bin/check-agent-mirror-sync.cjs --all'\n       - 'node .skilled/commands/doctor/scripts/command-catalog-mirror-check.cjs'\ndiff --git a/.skilled/commands/doctor/scripts/README.markdown b/.skilled/commands/doctor/scripts/README.markdown\nindex 01abbcea72c..21c1c64cf3e 100644\n--- a/.skilled/commands/doctor/scripts/README.markdown\n+++ b/.skilled/commands/doctor/scripts/README.markdown\n@@ -109,7 +109,7 @@ The scripts validate route manifests, inspect MCP installations, audit parent sk\n | `doctor-helper-match.cjs` | Ranks the doctor commands of `_routes.yaml` against a problem stated in plain words for `/doctor:helper`: one entry per route, standalone command, standalone action and mcp sub-action, scored by inverse-document-frequency overlap over the manifest phrases plus a bonus for a fully covered phrase, with a preference for the mutation class the operator asked for. Each candidate carries the manifest phrase that best matched and the terms it matched, so the reason on every line is evidence. It skips its own route and every private name, reads one YAML file and writes nothing. It exits 0 on a match, 1 on no candidate above the floor and 2 on a bad argument, an unreadable manifest or a missing YAML parser. |\n | `doctor-phrase-reach.cjs` | Scores every activated doctor phrase and each runnable doctor command through the built advisor scorer, then keeps the three results the hooks show. It fails when a phrase reaches neither the top pick nor the second line. It also fails if a runnable command does not rank first or an activated phrase has fewer than three words. It exits 2 when the advisor build is missing or stale. |\n | `codex-hook-approval-check.cjs` | The read-only Codex approval check: it finds the advisor's `UserPromptSubmit` entry in `.codex/hooks.json` and reports whether the Codex config holds a `trusted_hash` for that exact group and index, because Codex skips an unapproved entry without a warning. `--root <dir>` reads another checkout, `--config <path>` reads another config and `--json` prints one object. It prints `SKIP no-codex-hooks`, `PASS codex-hooks-approved`, `WARN codex-advisor-hook-absent` or `WARN codex-hooks-unapproved <root>` with the `/hooks` repair line, and never prints a hash. It exits 0 on a skip or an approval, 1 on a missing or unapproved entry and 2 on a bad argument. |\n-| `hook-wiring-check.cjs` | The read-only hook-wiring check: it reads `.claude/settings.json`, `.codex/hooks.json`, `.cursor/hooks.json` and `.devin/hooks.v1.json`, and reports whether the prompt hook entry is wired for each runtime folder it finds. An entry counts as wired only when one of its commands, read the way a shell reads it, starts node on that runtime's hook script, so a script named in an `echo` or a comment does not count. `--root <dir>` is required and `--json` prints one object. It prints `ok <runtime>` or `hook-missing <runtime> <file>`, skips a runtime whose folder is absent and never writes. It exits 0 when every installed runtime is wired, 1 when one is missing and 2 on a bad argument or a missing root. |\n+| `hook-wiring-check.cjs` | The read-only hook-wiring check: it reads `.claude/settings.json`, `.codex/hooks.json`, `.cursor/hooks.json`, `.devin/hooks.v1.json` and `.vibe/hooks.toml`, and reports whether the prompt hook entry is wired for each runtime folder it finds. An entry counts as wired only when one of its commands, read the way a shell reads it, starts node on that runtime's hook script, so a script named in an `echo` or a comment does not count. It reads `.vibe/hooks.toml` line by line for a `pre_agent` entry that runs the Vibe turn-start hook, because the repository installs no TOML parser. Pi, DSH and OpenCode load their prompt hook through an extension or a plugin, so the check has no row for them. `--root <dir>` is required and `--json` prints one object. It prints `ok <runtime>` or `hook-missing <runtime> <file>`, skips a runtime whose folder is absent and never writes. It exits 0 when every installed runtime is wired, 1 when one is missing and 2 on a bad argument or a missing root. |\n | `opencode-version-battery.cjs` | Checks this repository's OpenCode plugins on OpenCode 1 and 2. On 1 it proves plugin discovery through `debug config` and plugin load through an import check. On 2 it starts and stops a private server with the v2 binary it selected (`$OPENCODE_BIN`, `opencode` or `opencode2`, whichever reports a v2 version) and reads plugin and skill state from it. It exits 0 when every requested leg passes, 1 on a failed leg, 2 on a usage error, a crash or an `--out` file it cannot write and 3 when a leg is degraded or skipped. |\n | `ci-report.cjs` | The `/doctor:ci report` entry, kept thin: the flags, the exit codes and every name `/doctor:ci toggle` reads live here, and the readings live in the `ci-report` modules under `lib/`. It reads every workflow under `.github/workflows/` and reports its switch state, triggers, path filters and drift flags for `/doctor:ci report`. A switch is any variable a job's `if:` compares against `off`, so the workflow file is its only copy, and a repository variable value is reduced to a state and never printed. The branch, the required switch, the exempt files, the README and the rebuild trailer come from the CI profile, and the JSON names the profile it read. It exits 0 on a printed report, 1 when a workflow fails to parse, 2 on a bad argument and 3 when the CI profile is missing or invalid. |\n | `ci-scaffold.cjs` | Renders the sk-code-ci workflow or job template from the CI profile for `/doctor:ci scaffold`, and with `--protected` prints the profile's protected workflow names. It writes nothing. |\n@@ -127,7 +127,7 @@ The scripts validate route manifests, inspect MCP installations, audit parent sk\n | `lib/quality-applied-rules.cjs` | Which checklists and hygiene rules the gate would apply to a repository and which override rows inside them it would honour, asked of the runner itself through `--explain` over a sampled file per folder group and extension, so the doctor keeps no second copy of checklist discovery or of the override grammar. |\n | `lib/sk-skill-surface.cjs` | The probes `/doctor:sk-skill` shares between its check engine and its converter: resolve a name or a path to a skill root, classify where that root sits (a direct child of `.skilled/skills`, outside it or nested in a hub), read the frontmatter fields, inspect name collisions against the reserved and persona prefixes, and wrap a spawned validator so its JSON, its exit status and its missing-tool cases read the same in both scripts. |\n | `lib/sk-skill-convert-transforms.cjs` | The pure text transforms the converter applies, kept free of the repository so they are unit-tested on strings: normalize the `version` and `allowed-tools` frontmatter, find the machine blocks a Smart Routing section still holds, move a legacy trailing machine router section into the sibling router template, and add the router link line. |\n-| `orphan-process-check.cjs` | Lists the helper processes and model servers this user started that were reparented to init and are older than a minimum age (60 minutes by default), classifying each as a node test, vitest, tail monitor, grep search, executor worker, session-relaunch test helper, model server or git-live-follow, and reports each one's age and memory with a total. `--reap` sends `SIGTERM` after re-checking each process's identity, `--yes` confirms it, and `--json` and `--summary` print machine-readable and one-line forms. It exits 0 on a printed report, 1 on an unexpected error and 2 on a bad argument. |\n+| `orphan-process-check.cjs` | Lists the helper processes and model servers this user started that were reparented to init and are older than a minimum age (60 minutes by default), classifying each as a node test, vitest, tail monitor, grep search, executor worker, session-handover test helper, model server or git-live-follow, and reports each one's age and memory with a total. `--reap` sends `SIGTERM` after re-checking each process's identity, `--yes` confirms it, and `--json` and `--summary` print machine-readable and one-line forms. It exits 0 on a printed report, 1 on an unexpected error and 2 on a bad argument. |\n \n ---\n \n@@ -232,7 +232,7 @@ On this repository all legs pass on OpenCode 1.19.3 and 2.0.32. OpenCode 1.19.3\n | `agents-md-embed.cjs` | `plan` is read-only. `apply` writes only the paths in its own allowlist, all of them under the target root, after backing each one up under `.skilled/output/doctor-agents-md/<digest>/` (or the OS temp folder when that path is not ignored), and restores from that backup itself when its post-write proof fails. `restore` writes only the paths the run's `manifest.json` records and keeps the backup folder. It never runs `git add`, `git commit` or `git stash`. |\n | `agents-md-manifest.cjs` | `--check` is read-only. `--write` rewrites the manifest's `derived` key and refuses to run outside the repository that ships the template. |\n | `codex-hook-approval-check.cjs` | Read-only over any root. It reads `.codex/hooks.json` and the Codex config, prints no hash and takes no write path. It exits 0 on a skip or an approval, 1 on a missing or unapproved entry and 2 on a bad argument. |\n-| `hook-wiring-check.cjs` | Read-only over any root. It writes no file and runs no installer, and its JSON form reports the same readings as its lines. It exits 0 when every installed runtime's entry runs its hook script, 1 when one is missing and 2 on a bad argument or a missing root. |\n+| `hook-wiring-check.cjs` | Read-only over any root. It writes no file and runs no installer, and its JSON form reports the same readings as its lines. It exits 0 when every installed runtime's entry runs its hook script, 1 when one is missing and 2 on a bad argument or a missing root. Its Vibe reading is line by line, so a `.vibe/hooks.toml` that Vibe cannot parse can still read `ok vibe`, and a value with a trailing comment or a single-quoted string reads `hook-missing`. |\n | `opencode-version-battery.cjs` | The battery itself writes only the `--out` file and temporary folders it removes when each step ends. The private server's folder is also removed on `SIGINT` and `SIGTERM`, and the server is stopped. The import check runs each plugin's v1 factory in a child process rooted at the repository, so anything a plugin does when it loads happens during the check. It never touches the shared v2 service and never prints the private server's password. OpenCode 1 writes into a temporary data folder, not the user's. |\n \n Do not invoke a mutating path from a route classified as read-only.\ndiff --git a/.skilled/commands/doctor/scripts/hook-wiring-check.cjs b/.skilled/commands/doctor/scripts/hook-wiring-check.cjs\nindex bca8083525e..0c11d12dfe9 100644\n--- a/.skilled/commands/doctor/scripts/hook-wiring-check.cjs\n+++ b/.skilled/commands/doctor/scripts/hook-wiring-check.cjs\n@@ -36,6 +36,7 @@ const USAGE = [\n // the hook file inside it, the event that carries the prompt entry, and the path\n // fragment whose presence proves the entry is wired. A runtime folder that is\n // absent is skipped, because that runtime was never installed in this checkout.\n+// A `toml` entry is read line by line, because the repository installs no TOML parser.\n const RUNTIMES = [\n   {\n     id: 'claude',\n@@ -65,6 +66,14 @@ const RUNTIMES = [\n     event: 'UserPromptSubmit',\n     marker: 'hooks/devin/user-prompt-submit.js',\n   },\n+  {\n+    id: 'vibe',\n+    dir: '.vibe',\n+    file: '.vibe/hooks.toml',\n+    event: 'pre_agent',\n+    marker: 'hooks/session-lifecycle/vibe/turn-start.mjs',\n+    format: 'toml',\n+  },\n ];\n \n // ─────────────────────────────────────────────────────────────────────────────\n@@ -215,6 +224,37 @@ function collectCommands(node, commands) {\n   return commands;\n }\n \n+// A TOML hook file groups its entries under `[[hooks]]` headers rather than a\n+// JSON key, and no TOML parser is installed here, so each block is read line by\n+// line. A commented line names nothing that runs, so it is skipped. A basic\n+// string value escapes the quote and backslash after it, so both are unescaped.\n+// A header ends the block before it, so a commented header or another table never\n+// lends its keys to a hooks block.\n+function tomlCommands(text, event) {\n+  const blocks = [];\n+  let current = null;\n+  for (const line of text.split('\\n')) {\n+    const trimmed = line.trim();\n+    if (trimmed.startsWith('[')) {\n+      const header = trimmed.replace(/#.*$/, '').replace(/\\s/g, '');\n+      if (header === '[[hooks]]') {\n+        current = {};\n+        blocks.push(current);\n+      } else {\n+        current = null;\n+      }\n+      continue;\n+    }\n+    if (current === null || trimmed.startsWith('#')) continue;\n+    const entry = /^(type|command)\\s*=\\s*\"(.*)\"$/.exec(trimmed);\n+    if (!entry) continue;\n+    current[entry[1]] = entry[2].replace(/\\\\([\"\\\\])/g, '$1');\n+  }\n+  return blocks\n+    .filter((block) => block.type === event && typeof block.command === 'string')\n+    .map((block) => block.command);\n+}\n+\n const ASSIGNMENT = /^[A-Za-z_][A-Za-z0-9_]*=/;\n \n // Flags whose next word is their own argument, so that word is not the command.\n@@ -309,6 +349,17 @@ function runsMarker(command, marker, depth = 0) {\n \n function inspect(runtime, root) {\n   const file = path.join(root, runtime.file);\n+  // A toml hook file is text rather than JSON, so the line reader reads it.\n+  if (runtime.format === 'toml') {\n+    let text;\n+    try {\n+      text = fs.readFileSync(file, 'utf8');\n+    } catch {\n+      return { runtime: runtime.id, file: runtime.file, status: 'hook-missing' };\n+    }\n+    const wired = tomlCommands(text, runtime.event).some((command) => runsMarker(command, runtime.marker));\n+    return { runtime: runtime.id, file: runtime.file, status: wired ? 'ok' : 'hook-missing' };\n+  }\n   let document;\n   try {\n     document = JSON.parse(fs.readFileSync(file, 'utf8'));\ndiff --git a/.skilled/commands/scripts/validate-command-references.cjs b/.skilled/commands/scripts/validate-command-references.cjs\nindex 8856428a800..232d467f45c 100755\n--- a/.skilled/commands/scripts/validate-command-references.cjs\n+++ b/.skilled/commands/scripts/validate-command-references.cjs\n@@ -43,7 +43,7 @@ const AGENT_DIRS = ['.skilled/agents', '.claude/agents', '.codex/agents'];\n // A runtime-directory reference is valid only if it names a runtime that actually\n // ships an agents tree. The point is to catch a phantom dir, not a runtime the repo\n // grew later, so this lists every runtime with agents/ on disk.\n-const RUNTIME_DIR_ALLOWLIST = new Set(['.skilled', '.opencode', '.claude', '.codex', '.cursor', '.devin', '.pi', '.dsh']);\n+const RUNTIME_DIR_ALLOWLIST = new Set(['.skilled', '.opencode', '.claude', '.codex', '.cursor', '.devin', '.pi', '.dsh', '.vibe']);\n const COMMAND_INVENTORY_EXCLUDES = new Set(['assets', 'scripts', 'fixtures']);\n \n // Command families are derived from the real command tree so a new family directory\ndiff --git a/.skilled/skills/system-skill-advisor/hooks/claude/user-prompt-submit.ts b/.skilled/skills/system-skill-advisor/hooks/claude/user-prompt-submit.ts\nindex db3c2f9bdb2..38201cb06d6 100644\n--- a/.skilled/skills/system-skill-advisor/hooks/claude/user-prompt-submit.ts\n+++ b/.skilled/skills/system-skill-advisor/hooks/claude/user-prompt-submit.ts\n@@ -443,7 +443,9 @@ export async function handleClaudeUserPromptSubmit(\n     }\n     observeEmittedAdvisorPolicy(effectiveEmitted, {\n       ...deliveryState,\n-      runtime: 'Claude Code',\n+      // Claude keeps its display label and every other caller is recorded under\n+      // the runtime it named, so no other runtime's delivery is counted as Claude's.\n+      runtime: runtime === 'claude' ? 'Claude Code' : runtime,\n       candidate: OBSERVED_ADVISOR_POLICY_CANDIDATE,\n     });\n     return output;\ndiff --git a/.skilled/skills/system-skill-advisor/hooks/skill-advisor-hook.md b/.skilled/skills/system-skill-advisor/hooks/skill-advisor-hook.md\nindex 78f598496ca..61b04f1dba9 100644\n--- a/.skilled/skills/system-skill-advisor/hooks/skill-advisor-hook.md\n+++ b/.skilled/skills/system-skill-advisor/hooks/skill-advisor-hook.md\n@@ -9,7 +9,7 @@ trigger_phrases:\n   - \"advisor hook smoke tests\"\n importance_tier: important\n contextType: implementation\n-version: 3.6.12.0\n+version: 3.6.18.0\n ---\n \n # Skill Advisor Hook Reference\n@@ -92,6 +92,7 @@ Every native runtime, Pi and DSH run the same hook handler, which gates the prom\n | **Pi** | `system-skill-advisor/hooks/pi/prompt-advisor.ts` (real file, re-exported by its one-line `.pi/extensions/` entry) | `user_input` / prompt event via `.pi/extensions/` | Imports the advisor module **in-process** (not a subprocess). Pi awaits input handlers before agent processing, so the old blocking-spawn bridge stalled every send. In-process calls remove the stall and let the module-level prompt cache work. Captures raw user text (bounded 32 KiB, 64-session LRU). The in-process call passes `runtime: 'pi'` and races a timer of the advisor budget plus 300 ms, delivering the fallback directives if the call hangs | Model-visible message. Delivery-state machine suppresses same-session re-delivery |\n | **OpenCode** | `.opencode/plugins/system-skill-advisor.js` | Plugin, loaded by OpenCode's flat glob over `.opencode/plugins/`. `experimental.chat.system.transform` per prompt, `event` for session lifecycle, `tool` for status | Shells out to the advisor CLI (bounded timeout, stdout cap 256 KiB, grace termination), TTL+LRU prompt cache with in-flight dedup, transform-dedup integration | Brief appended to `output.system`. `spec_kit_skill_advisor_status` tool returns a key=value report (no raw path leakage) |\n | **DSH** | `system-skill-advisor/hooks/dsh/prompt-advisor.mjs` (real file, reached through the `.dsh/plugins/repo-guards/adapters/prompt-advisor.mjs` symlink) | `agent/pre-step` through the `repo-guards` plugin, on unless the `promptAdvisor` row flag is `false` | Proxies the latest operator prompt through the compiled Claude advisor chain under the runtime label `dsh`. A fan-out leaf, marked by the lineage patch, gets no brief | Brief added to the step |\n+| **Vibe** | `system-skill-advisor/hooks/vibe/prompt-advisor.mjs`, called by `.skilled/hooks/session-lifecycle/vibe/turn-start.mjs` | `pre_agent` in `.vibe/hooks.toml` (`turn-start`, match `main`), rendered into a dispatch's `VIBE_HOME` | Proxies the operator prompt through the compiled Claude advisor chain under the runtime label `vibe`. A child dispatch and a subagent turn get no brief | `hook_specific_output.additional_context`; the routing head and directives repeat only when they change, because Vibe keeps added context in the conversation. A head that names a command gains one line naming each command's document under `.skilled/commands/`, because Vibe has no command loader and its prompt stubs name the dash form |\n \n OpenCode has no source-hook adapter in `system-spec-kit`. Its prompt-time integration is the committed plugin, which shells out to the advisor CLI and inherits the shared render contract. The hooks-tree index at `.skilled/hooks/skill-advisor/` mirrors the per-runtime shims and the OpenCode plugin via relative symlinks. This README is the symlink target.\n \n@@ -127,6 +128,8 @@ system-skill-advisor/hooks/\n +-- pi/\n |   +-- README.md\n |   `-- prompt-advisor.ts             # real Pi extension (.pi/extensions/ re-exports it)\n++-- vibe/\n+|   `-- prompt-advisor.mjs            # real Vibe part (the turn-start composer calls it)\n `-- lib/\n     +-- README.md\n     +-- directive-lifecycle.ts, directive-lifecycle-contract.ts, directive-lifecycle-file-store.ts\n@@ -166,13 +169,15 @@ The advisor is enabled by default. Truthy disable values are `1`, `true`, `yes`,\n \n | Variable | Effect |\n |---|---|\n-| `SYSTEM_SKILL_ADVISOR_DISABLED=1` | Canonical kill-switch. Every adapter checks `isHookEnabled('skill-advisor')` and returns empty/skipped prompt-safe output. |\n-| `SYSTEM_SKILL_ADVISOR_HOOK_DISABLED=1` | Alias. Disables the native adapters. |\n-| `SYSTEM_SKILL_ADVISOR_PLUGIN_DISABLED=1` | Alias. Disables the OpenCode plugin. |\n-| `SPECKIT_SKILL_ADVISOR_HOOK_DISABLED=1` | Legacy alias for the native adapters. The standalone Python CLI (`skill_advisor.py`) reads only this name, set to exactly `1`, from `runtime/schemas/compat-contract.json`. |\n-| `SPECKIT_SKILL_ADVISOR_PLUGIN_DISABLED=1` | Legacy alias for the OpenCode plugin. |\n+| `SYSTEM_SKILL_ADVISOR_DISABLED=1` | Canonical kill-switch. Every adapter checks `isHookEnabled('skill-advisor')` and returns empty/skipped prompt-safe output, and the `advisor_recommend` direct call abstains. |\n+| `SYSTEM_SKILL_ADVISOR_HOOK_DISABLED=1` | Alias. Disables the native adapters and makes the `advisor_recommend` direct call abstain. |\n+| `SYSTEM_SKILL_ADVISOR_PLUGIN_DISABLED=1` | Alias. Disables every adapter and makes the `advisor_recommend` direct call abstain. |\n+| `SPECKIT_SKILL_ADVISOR_HOOK_DISABLED=1` | Legacy alias for the native adapters and the `advisor_recommend` direct call. The standalone Python CLI (`skill_advisor.py`) reads only this name, set to exactly `1`, from `runtime/schemas/compat-contract.json`. |\n+| `SPECKIT_SKILL_ADVISOR_PLUGIN_DISABLED=1` | Legacy alias. Disables every adapter and makes the `advisor_recommend` direct call abstain. |\n | `SYSTEM_HOOKS_DISABLED=1` | Master switch that disables this concern along with every other repo hook. |\n \n+The direct call decides in the caller's own process, by the same resolution the adapters use. `node .skilled/bin/skill-advisor.cjs advisor_recommend` asks `hookFlagDecision('skill-advisor')` in `.skilled/hooks/shared/hook-flags.cjs`, with the caller's environment over `.skilled/hooks/hook-flags.env`, before it connects to a daemon or runs the local scorer. Whenever the adapters are off, under any name in this table or its older `MK_` form, any truthy value or a line in the flags file, it prints the empty envelope with `ADVISOR_DISABLED` and names the switch that decided. A daemon reads the same names from its own environment and never reads the flags file, and the launcher passes no switch name and no `HOOK_FLAGS_CONFIG` to a daemon it starts, so a flagged command that happens to start the daemon does not leave it abstaining for every later caller. The standalone Python CLI keeps its own rule: only `SPECKIT_SKILL_ADVISOR_HOOK_DISABLED`, set to exactly `1`.\n+\n Additional controls: `SPECKIT_SKILL_ADVISOR_FORCE_LOCAL=1` (force local Python fallback where supported) and `--force-native` / `--force-local` / `--threshold` / `--stdin` (Python shim flags, default threshold `0.8`). `SPECKIT_OPENCODE_HOOK_TIMEOUT_MS` (default 3000) is owned by the `system-skill-advisor` hub: its live consumers are `runtime/lib/subprocess.ts`, `skill-advisor-brief.ts`, the OpenCode bridge and `skill_advisor.py`. On timeout the OpenCode bridge serves prompt-safe stale context with a timeout marker. OpenCode tuning: `SYSTEM_SKILL_ADVISOR_CACHE_TTL_MS` (default 5 min), `SYSTEM_SKILL_ADVISOR_MAX_TOKENS` (default 80), `SYSTEM_SKILL_ADVISOR_MAX_BRIEF_CHARS` (default 2 KiB), `SYSTEM_SKILL_ADVISOR_MAX_PROMPT_BYTES` (default 64 KiB, measured on the whole stdin request after JSON escaping), `SYSTEM_SKILL_ADVISOR_COMPILED_ROUTE_BOUNDING` (kept for existing configs: the transform adds no compiled-route line, so it changes only the `bounded_compiled_route_summary` status field).\n \n Set a flag inline for one command, export it for a session, or persist it in `.skilled/hooks/hook-flags.env` (copied from `hook-flags.env.example`, gitignored). The environment always wins over the file, so a persisted default can be overridden for a single session.\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"diff --git a/.github/workflows/spec-kit-check.yml b/.github/workflows/spec-kit-check.yml\nindex 0a4b044dd82..5eaa6a7c891 100644\n--- a/.github/workflows/spec-kit-check.yml\n+++ b/.github/workflows/spec-kit-check.yml\n@@ -20,7 +20,9 @@ on:\n       # The mirror-parity job compares generated mirrors against their sources.\n       # Triggering on the spec-kit runtime alone let a mirror drift on a command\n       # or agent commit, ship unseen, and fail here later on whoever next touched\n-      # the runtime. Every mirror source and every mirror output triggers it now.\n+      # the runtime. Every command and agent mirror source and output triggers it now.\n+      # A Vibe-only or SKILL.md-only change runs the same Vibe checks in\n+      # command-tree-parity.yml, which filters on those paths.\n       - '.opencode/commands/**'\n       - '.skilled/commands/**'\n       - '.opencode/agents/**'\n@@ -61,7 +63,9 @@ on:\n       # The mirror-parity job compares generated mirrors against their sources.\n       # Triggering on the spec-kit runtime alone let a mirror drift on a command\n       # or agent commit, ship unseen, and fail here later on whoever next touched\n-      # the runtime. Every mirror source and every mirror output triggers it now.\n+      # the runtime. Every command and agent mirror source and output triggers it now.\n+      # A Vibe-only or SKILL.md-only change runs the same Vibe checks in\n+      # command-tree-parity.yml, which filters on those paths.\n       - '.opencode/commands/**'\n       - '.skilled/commands/**'\n       - '.opencode/agents/**'\n@@ -330,6 +334,9 @@ jobs:\n           node .opencode/commands/doctor/scripts/command-catalog-mirror-check.cjs\n           node .opencode/skills/system-spec-kit/runtime/cli/runtime-mirrors/sync-hook-registrations.cjs --check\n           node .opencode/skills/system-spec-kit/runtime/cli/runtime-mirrors/sync-gate1-pointers.cjs --check\n+          node .opencode/skills/system-spec-kit/runtime/cli/vibe/sync-skills-vibe.cjs --check\n+          node .opencode/skills/system-spec-kit/runtime/cli/vibe/sync-prompts-vibe.cjs --check\n+          node .opencode/skills/system-spec-kit/runtime/cli/vibe/sync-agents-vibe.cjs --check\n \n   doctor-scripts:\n     name: Doctor script test suites\ndiff --git a/.skilled/commands/doctor/_routes.yaml b/.skilled/commands/doctor/_routes.yaml\nindex 939d31acebe..28e9ef8ee60 100644\n--- a/.skilled/commands/doctor/_routes.yaml\n+++ b/.skilled/commands/doctor/_routes.yaml\n@@ -93,7 +93,7 @@ routes:\n     target: deep-loop\n     yaml: doctor-deep-loop.yaml\n     setup_vars: [execution_mode, intent, scope]\n-    allowed_flags: [\"--scope=research|review|council|both|all\"]\n+    allowed_flags: [\"--scope=research|review|both|all\"]\n     mutating: add-only\n     write_scope: spec-folder\n     gate3_location: \"<active-spec-folder>/scratch/doctor-deep-loop-state.<timestamp>.json\"\n@@ -265,6 +265,9 @@ routes:\n       - 'node .skilled/skills/system-spec-kit/runtime/cli/dsh/sync-skills-dsh.cjs --check  # n/a, not run, while .dsh/ is absent'\n       - 'node .skilled/skills/system-spec-kit/runtime/cli/dsh/sync-prompts-dsh.cjs --check  # n/a, not run, while .dsh/ is absent'\n       - 'node .skilled/skills/system-spec-kit/runtime/cli/dsh/sync-agents-dsh.cjs --check  # n/a, not run, while .dsh/ is absent'\n+      - 'node .skilled/skills/system-spec-kit/runtime/cli/vibe/sync-prompts-vibe.cjs --check  # n/a, not run, while .vibe/ is absent'\n+      - 'node .skilled/skills/system-spec-kit/runtime/cli/vibe/sync-agents-vibe.cjs --check  # n/a, not run, while .vibe/ is absent'\n+      - 'node .skilled/skills/system-spec-kit/runtime/cli/vibe/sync-skills-vibe.cjs --check  # n/a, not run, while .vibe/ is absent'\n       - 'node .skilled/commands/doctor/scripts/agent-roster-mirror-check.cjs'\n       - 'node .skilled/bin/check-agent-mirror-sync.cjs --all'\n       - 'node .skilled/commands/doctor/scripts/command-catalog-mirror-check.cjs'\ndiff --git a/.skilled/commands/doctor/scripts/README.markdown b/.skilled/commands/doctor/scripts/README.markdown\nindex 01abbcea72c..21c1c64cf3e 100644\n--- a/.skilled/commands/doctor/scripts/README.markdown\n+++ b/.skilled/commands/doctor/scripts/README.markdown\n@@ -109,7 +109,7 @@ The scripts validate route manifests, inspect MCP installations, audit parent sk\n | `doctor-helper-match.cjs` | Ranks the doctor commands of `_routes.yaml` against a problem stated in plain words for `/doctor:helper`: one entry per route, standalone command, standalone action and mcp sub-action, scored by inverse-document-frequency overlap over the manifest phrases plus a bonus for a fully covered phrase, with a preference for the mutation class the operator asked for. Each candidate carries the manifest phrase that best matched and the terms it matched, so the reason on every line is evidence. It skips its own route and every private name, reads one YAML file and writes nothing. It exits 0 on a match, 1 on no candidate above the floor and 2 on a bad argument, an unreadable manifest or a missing YAML parser. |\n | `doctor-phrase-reach.cjs` | Scores every activated doctor phrase and each runnable doctor command through the built advisor scorer, then keeps the three results the hooks show. It fails when a phrase reaches neither the top pick nor the second line. It also fails if a runnable command does not rank first or an activated phrase has fewer than three words. It exits 2 when the advisor build is missing or stale. |\n | `codex-hook-approval-check.cjs` | The read-only Codex approval check: it finds the advisor's `UserPromptSubmit` entry in `.codex/hooks.json` and reports whether the Codex config holds a `trusted_hash` for that exact group and index, because Codex skips an unapproved entry without a warning. `--root <dir>` reads another checkout, `--config <path>` reads another config and `--json` prints one object. It prints `SKIP no-codex-hooks`, `PASS codex-hooks-approved`, `WARN codex-advisor-hook-absent` or `WARN codex-hooks-unapproved <root>` with the `/hooks` repair line, and never prints a hash. It exits 0 on a skip or an approval, 1 on a missing or unapproved entry and 2 on a bad argument. |\n-| `hook-wiring-check.cjs` | The read-only hook-wiring check: it reads `.claude/settings.json`, `.codex/hooks.json`, `.cursor/hooks.json` and `.devin/hooks.v1.json`, and reports whether the prompt hook entry is wired for each runtime folder it finds. An entry counts as wired only when one of its commands, read the way a shell reads it, starts node on that runtime's hook script, so a script named in an `echo` or a comment does not count. `--root <dir>` is required and `--json` prints one object. It prints `ok <runtime>` or `hook-missing <runtime> <file>`, skips a runtime whose folder is absent and never writes. It exits 0 when every installed runtime is wired, 1 when one is missing and 2 on a bad argument or a missing root. |\n+| `hook-wiring-check.cjs` | The read-only hook-wiring check: it reads `.claude/settings.json`, `.codex/hooks.json`, `.cursor/hooks.json`, `.devin/hooks.v1.json` and `.vibe/hooks.toml`, and reports whether the prompt hook entry is wired for each runtime folder it finds. An entry counts as wired only when one of its commands, read the way a shell reads it, starts node on that runtime's hook script, so a script named in an `echo` or a comment does not count. It reads `.vibe/hooks.toml` line by line for a `pre_agent` entry that runs the Vibe turn-start hook, because the repository installs no TOML parser. Pi, DSH and OpenCode load their prompt hook through an extension or a plugin, so the check has no row for them. `--root <dir>` is required and `--json` prints one object. It prints `ok <runtime>` or `hook-missing <runtime> <file>`, skips a runtime whose folder is absent and never writes. It exits 0 when every installed runtime is wired, 1 when one is missing and 2 on a bad argument or a missing root. |\n | `opencode-version-battery.cjs` | Checks this repository's OpenCode plugins on OpenCode 1 and 2. On 1 it proves plugin discovery through `debug config` and plugin load through an import check. On 2 it starts and stops a private server with the v2 binary it selected (`$OPENCODE_BIN`, `opencode` or `opencode2`, whichever reports a v2 version) and reads plugin and skill state from it. It exits 0 when every requested leg passes, 1 on a failed leg, 2 on a usage error, a crash or an `--out` file it cannot write and 3 when a leg is degraded or skipped. |\n | `ci-report.cjs` | The `/doctor:ci report` entry, kept thin: the flags, the exit codes and every name `/doctor:ci toggle` reads live here, and the readings live in the `ci-report` modules under `lib/`. It reads every workflow under `.github/workflows/` and reports its switch state, triggers, path filters and drift flags for `/doctor:ci report`. A switch is any variable a job's `if:` compares against `off`, so the workflow file is its only copy, and a repository variable value is reduced to a state and never printed. The branch, the required switch, the exempt files, the README and the rebuild trailer come from the CI profile, and the JSON names the profile it read. It exits 0 on a printed report, 1 when a workflow fails to parse, 2 on a bad argument and 3 when the CI profile is missing or invalid. |\n | `ci-scaffold.cjs` | Renders the sk-code-ci workflow or job template from the CI profile for `/doctor:ci scaffold`, and with `--protected` prints the profile's protected workflow names. It writes nothing. |\n@@ -127,7 +127,7 @@ The scripts validate route manifests, inspect MCP installations, audit parent sk\n | `lib/quality-applied-rules.cjs` | Which checklists and hygiene rules the gate would apply to a repository and which override rows inside them it would honour, asked of the runner itself through `--explain` over a sampled file per folder group and extension, so the doctor keeps no second copy of checklist discovery or of the override grammar. |\n | `lib/sk-skill-surface.cjs` | The probes `/doctor:sk-skill` shares between its check engine and its converter: resolve a name or a path to a skill root, classify where that root sits (a direct child of `.skilled/skills`, outside it or nested in a hub), read the frontmatter fields, inspect name collisions against the reserved and persona prefixes, and wrap a spawned validator so its JSON, its exit status and its missing-tool cases read the same in both scripts. |\n | `lib/sk-skill-convert-transforms.cjs` | The pure text transforms the converter applies, kept free of the repository so they are unit-tested on strings: normalize the `version` and `allowed-tools` frontmatter, find the machine blocks a Smart Routing section still holds, move a legacy trailing machine router section into the sibling router template, and add the router link line. |\n-| `orphan-process-check.cjs` | Lists the helper processes and model servers this user started that were reparented to init and are older than a minimum age (60 minutes by default), classifying each as a node test, vitest, tail monitor, grep search, executor worker, session-relaunch test helper, model server or git-live-follow, and reports each one's age and memory with a total. `--reap` sends `SIGTERM` after re-checking each process's identity, `--yes` confirms it, and `--json` and `--summary` print machine-readable and one-line forms. It exits 0 on a printed report, 1 on an unexpected error and 2 on a bad argument. |\n+| `orphan-process-check.cjs` | Lists the helper processes and model servers this user started that were reparented to init and are older than a minimum age (60 minutes by default), classifying each as a node test, vitest, tail monitor, grep search, executor worker, session-handover test helper, model server or git-live-follow, and reports each one's age and memory with a total. `--reap` sends `SIGTERM` after re-checking each process's identity, `--yes` confirms it, and `--json` and `--summary` print machine-readable and one-line forms. It exits 0 on a printed report, 1 on an unexpected error and 2 on a bad argument. |\n \n ---\n \n@@ -232,7 +232,7 @@ On this repository all legs pass on OpenCode 1.19.3 and 2.0.32. OpenCode 1.19.3\n | `agents-md-embed.cjs` | `plan` is read-only. `apply` writes only the paths in its own allowlist, all of them under the target root, after backing each one up under `.skilled/output/doctor-agents-md/<digest>/` (or the OS temp folder when that path is not ignored), and restores from that backup itself when its post-write proof fails. `restore` writes only the paths the run's `manifest.json` records and keeps the backup folder. It never runs `git add`, `git commit` or `git stash`. |\n | `agents-md-manifest.cjs` | `--check` is read-only. `--write` rewrites the manifest's `derived` key and refuses to run outside the repository that ships the template. |\n | `codex-hook-approval-check.cjs` | Read-only over any root. It reads `.codex/hooks.json` and the Codex config, prints no hash and takes no write path. It exits 0 on a skip or an approval, 1 on a missing or unapproved entry and 2 on a bad argument. |\n-| `hook-wiring-check.cjs` | Read-only over any root. It writes no file and runs no installer, and its JSON form reports the same readings as its lines. It exits 0 when every installed runtime's entry runs its hook script, 1 when one is missing and 2 on a bad argument or a missing root. |\n+| `hook-wiring-check.cjs` | Read-only over any root. It writes no file and runs no installer, and its JSON form reports the same readings as its lines. It exits 0 when every installed runtime's entry runs its hook script, 1 when one is missing and 2 on a bad argument or a missing root. Its Vibe reading is line by line, so a `.vibe/hooks.toml` that Vibe cannot parse can still read `ok vibe`, and a value with a trailing comment or a single-quoted string reads `hook-missing`. |\n | `opencode-version-battery.cjs` | The battery itself writes only the `--out` file and temporary folders it removes when each step ends. The private server's folder is also removed on `SIGINT` and `SIGTERM`, and the server is stopped. The import check runs each plugin's v1 factory in a child process rooted at the repository, so anything a plugin does when it loads happens during the check. It never touches the shared v2 service and never prints the private server's password. OpenCode 1 writes into a temporary data folder, not the user's. |\n \n Do not invoke a mutating path from a route classified as read-only.\ndiff --git a/.skilled/commands/doctor/scripts/hook-wiring-check.cjs b/.skilled/commands/doctor/scripts/hook-wiring-check.cjs\nindex bca8083525e..0c11d12dfe9 100644\n--- a/.skilled/commands/doctor/scripts/hook-wiring-check.cjs\n+++ b/.skilled/commands/doctor/scripts/hook-wiring-check.cjs\n@@ -36,6 +36,7 @@ const USAGE = [\n // the hook file inside it, the event that carries the prompt entry, and the path\n // fragment whose presence proves the entry is wired. A runtime folder that is\n // absent is skipped, because that runtime was never installed in this checkout.\n+// A `toml` entry is read line by line, because the repository installs no TOML parser.\n const RUNTIMES = [\n   {\n     id: 'claude',\n@@ -65,6 +66,14 @@ const RUNTIMES = [\n     event: 'UserPromptSubmit',\n     marker: 'hooks/devin/user-prompt-submit.js',\n   },\n+  {\n+    id: 'vibe',\n+    dir: '.vibe',\n+    file: '.vibe/hooks.toml',\n+    event: 'pre_agent',\n+    marker: 'hooks/session-lifecycle/vibe/turn-start.mjs',\n+    format: 'toml',\n+  },\n ];\n \n // ─────────────────────────────────────────────────────────────────────────────\n@@ -215,6 +224,37 @@ function collectCommands(node, commands) {\n   return commands;\n }\n \n+// A TOML hook file groups its entries under `[[hooks]]` headers rather than a\n+// JSON key, and no TOML parser is installed here, so each block is read line by\n+// line. A commented line names nothing that runs, so it is skipped. A basic\n+// string value escapes the quote and backslash after it, so both are unescaped.\n+// A header ends the block before it, so a commented header or another table never\n+// lends its keys to a hooks block.\n+function tomlCommands(text, event) {\n+  const blocks = [];\n+  let current = null;\n+  for (const line of text.split('\\n')) {\n+    const trimmed = line.trim();\n+    if (trimmed.startsWith('[')) {\n+      const header = trimmed.replace(/#.*$/, '').replace(/\\s/g, '');\n+      if (header === '[[hooks]]') {\n+        current = {};\n+        blocks.push(current);\n+      } else {\n+        current = null;\n+      }\n+      continue;\n+    }\n+    if (current === null || trimmed.startsWith('#')) continue;\n+    const entry = /^(type|command)\\s*=\\s*\"(.*)\"$/.exec(trimmed);\n+    if (!entry) continue;\n+    current[entry[1]] = entry[2].replace(/\\\\([\"\\\\])/g, '$1');\n+  }\n+  return blocks\n+    .filter((block) => block.type === event && typeof block.command === 'string')\n+    .map((block) => block.command);\n+}\n+\n const ASSIGNMENT = /^[A-Za-z_][A-Za-z0-9_]*=/;\n \n // Flags whose next word is their own argument, so that word is not the command.\n@@ -309,6 +349,17 @@ function runsMarker(command, marker, depth = 0) {\n \n function inspect(runtime, root) {\n   const file = path.join(root, runtime.file);\n+  // A toml hook file is text rather than JSON, so the line reader reads it.\n+  if (runtime.format === 'toml') {\n+    let text;\n+    try {\n+      text = fs.readFileSync(file, 'utf8');\n+    } catch {\n+      return { runtime: runtime.id, file: runtime.file, status: 'hook-missing' };\n+    }\n+    const wired = tomlCommands(text, runtime.event).some((command) => runsMarker(command, runtime.marker));\n+    return { runtime: runtime.id, file: runtime.file, status: wired ? 'ok' : 'hook-missing' };\n+  }\n   let document;\n   try {\n     document = JSON.parse(fs.readFileSync(file, 'utf8'));\ndiff --git a/.skilled/commands/scripts/validate-command-references.cjs b/.skilled/commands/scripts/validate-command-references.cjs\nindex 8856428a800..232d467f45c 100755\n--- a/.skilled/commands/scripts/validate-command-references.cjs\n+++ b/.skilled/commands/scripts/validate-command-references.cjs\n@@ -43,7 +43,7 @@ const AGENT_DIRS = ['.skilled/agents', '.claude/agents', '.codex/agents'];\n // A runtime-directory reference is valid only if it names a runtime that actually\n // ships an agents tree. The point is to catch a phantom dir, not a runtime the repo\n // grew later, so this lists every runtime with agents/ on disk.\n-const RUNTIME_DIR_ALLOWLIST = new Set(['.skilled', '.opencode', '.claude', '.codex', '.cursor', '.devin', '.pi', '.dsh']);\n+const RUNTIME_DIR_ALLOWLIST = new Set(['.skilled', '.opencode', '.claude', '.codex', '.cursor', '.devin', '.pi', '.dsh', '.vibe']);\n const COMMAND_INVENTORY_EXCLUDES = new Set(['assets', 'scripts', 'fixtures']);\n \n // Command families are derived from the real command tree so a new family directory\ndiff --git a/.skilled/skills/system-skill-advisor/hooks/claude/user-prompt-submit.ts b/.skilled/skills/system-skill-advisor/hooks/claude/user-prompt-submit.ts\nindex db3c2f9bdb2..38201cb06d6 100644\n--- a/.skilled/skills/system-skill-advisor/hooks/claude/user-prompt-submit.ts\n+++ b/.skilled/skills/system-skill-advisor/hooks/claude/user-prompt-submit.ts\n@@ -443,7 +443,9 @@ export async function handleClaudeUserPromptSubmit(\n     }\n     observeEmittedAdvisorPolicy(effectiveEmitted, {\n       ...deliveryState,\n-      runtime: 'Claude Code',\n+      // Claude keeps its display label and every other caller is recorded under\n+      // the runtime it named, so no other runtime's delivery is counted as Claude's.\n+      runtime: runtime === 'claude' ? 'Claude Code' : runtime,\n       candidate: OBSERVED_ADVISOR_POLICY_CANDIDATE,\n     });\n     return output;\ndiff --git a/.skilled/skills/system-skill-advisor/hooks/skill-advisor-hook.md b/.skilled/skills/system-skill-advisor/hooks/skill-advisor-hook.md\nindex 78f598496ca..61b04f1dba9 100644\n--- a/.skilled/skills/system-skill-advisor/hooks/skill-advisor-hook.md\n+++ b/.skilled/skills/system-skill-advisor/hooks/skill-advisor-hook.md\n@@ -9,7 +9,7 @@ trigger_phrases:\n   - \"advisor hook smoke tests\"\n importance_tier: important\n contextType: implementation\n-version: 3.6.12.0\n+version: 3.6.18.0\n ---\n \n # Skill Advisor Hook Reference\n@@ -92,6 +92,7 @@ Every native runtime, Pi and DSH run the same hook handler, which gates the prom\n | **Pi** | `system-skill-advisor/hooks/pi/prompt-advisor.ts` (real file, re-exported by its one-line `.pi/extensions/` entry) | `user_input` / prompt event via `.pi/extensions/` | Imports the advisor module **in-process** (not a subprocess). Pi awaits input handlers before agent processing, so the old blocking-spawn bridge stalled every send. In-process calls remove the stall and let the module-level prompt cache work. Captures raw user text (bounded 32 KiB, 64-session LRU). The in-process call passes `runtime: 'pi'` and races a timer of the advisor budget plus 300 ms, delivering the fallback directives if the call hangs | Model-visible message. Delivery-state machine suppresses same-session re-delivery |\n | **OpenCode** | `.opencode/plugins/system-skill-advisor.js` | Plugin, loaded by OpenCode's flat glob over `.opencode/plugins/`. `experimental.chat.system.transform` per prompt, `event` for session lifecycle, `tool` for status | Shells out to the advisor CLI (bounded timeout, stdout cap 256 KiB, grace termination), TTL+LRU prompt cache with in-flight dedup, transform-dedup integration | Brief appended to `output.system`. `spec_kit_skill_advisor_status` tool returns a key=value report (no raw path leakage) |\n | **DSH** | `system-skill-advisor/hooks/dsh/prompt-advisor.mjs` (real file, reached through the `.dsh/plugins/repo-guards/adapters/prompt-advisor.mjs` symlink) | `agent/pre-step` through the `repo-guards` plugin, on unless the `promptAdvisor` row flag is `false` | Proxies the latest operator prompt through the compiled Claude advisor chain under the runtime label `dsh`. A fan-out leaf, marked by the lineage patch, gets no brief | Brief added to the step |\n+| **Vibe** | `system-skill-advisor/hooks/vibe/prompt-advisor.mjs`, called by `.skilled/hooks/session-lifecycle/vibe/turn-start.mjs` | `pre_agent` in `.vibe/hooks.toml` (`turn-start`, match `main`), rendered into a dispatch's `VIBE_HOME` | Proxies the operator prompt through the compiled Claude advisor chain under the runtime label `vibe`. A child dispatch and a subagent turn get no brief | `hook_specific_output.additional_context`; the routing head and directives repeat only when they change, because Vibe keeps added context in the conversation. A head that names a command gains one line naming each command's document under `.skilled/commands/`, because Vibe has no command loader and its prompt stubs name the dash form |\n \n OpenCode has no source-hook adapter in `system-spec-kit`. Its prompt-time integration is the committed plugin, which shells out to the advisor CLI and inherits the shared render contract. The hooks-tree index at `.skilled/hooks/skill-advisor/` mirrors the per-runtime shims and the OpenCode plugin via relative symlinks. This README is the symlink target.\n \n@@ -127,6 +128,8 @@ system-skill-advisor/hooks/\n +-- pi/\n |   +-- README.md\n |   `-- prompt-advisor.ts             # real Pi extension (.pi/extensions/ re-exports it)\n++-- vibe/\n+|   `-- prompt-advisor.mjs            # real Vibe part (the turn-start composer calls it)\n `-- lib/\n     +-- README.md\n     +-- directive-lifecycle.ts, directive-lifecycle-contract.ts, directive-lifecycle-file-store.ts\n@@ -166,13 +169,15 @@ The advisor is enabled by default. Truthy disable values are `1`, `true`, `yes`,\n \n | Variable | Effect |\n |---|---|\n-| `SYSTEM_SKILL_ADVISOR_DISABLED=1` | Canonical kill-switch. Every adapter checks `isHookEnabled('skill-advisor')` and returns empty/skipped prompt-safe output. |\n-| `SYSTEM_SKILL_ADVISOR_HOOK_DISABLED=1` | Alias. Disables the native adapters. |\n-| `SYSTEM_SKILL_ADVISOR_PLUGIN_DISABLED=1` | Alias. Disables the OpenCode plugin. |\n-| `SPECKIT_SKILL_ADVISOR_HOOK_DISABLED=1` | Legacy alias for the native adapters. The standalone Python CLI (`skill_advisor.py`) reads only this name, set to exactly `1`, from `runtime/schemas/compat-contract.json`. |\n-| `SPECKIT_SKILL_ADVISOR_PLUGIN_DISABLED=1` | Legacy alias for the OpenCode plugin. |\n+| `SYSTEM_SKILL_ADVISOR_DISABLED=1` | Canonical kill-switch. Every adapter checks `isHookEnabled('skill-advisor')` and returns empty/skipped prompt-safe output, and the `advisor_recommend` direct call abstains. |\n+| `SYSTEM_SKILL_ADVISOR_HOOK_DISABLED=1` | Alias. Disables the native adapters and makes the `advisor_recommend` direct call abstain. |\n+| `SYSTEM_SKILL_ADVISOR_PLUGIN_DISABLED=1` | Alias. Disables every adapter and makes the `advisor_recommend` direct call abstain. |\n+| `SPECKIT_SKILL_ADVISOR_HOOK_DISABLED=1` | Legacy alias for the native adapters and the `advisor_recommend` direct call. The standalone Python CLI (`skill_advisor.py`) reads only this name, set to exactly `1`, from `runtime/schemas/compat-contract.json`. |\n+| `SPECKIT_SKILL_ADVISOR_PLUGIN_DISABLED=1` | Legacy alias. Disables every adapter and makes the `advisor_recommend` direct call abstain. |\n | `SYSTEM_HOOKS_DISABLED=1` | Master switch that disables this concern along with every other repo hook. |\n \n+The direct call decides in the caller's own process, by the same resolution the adapters use. `node .skilled/bin/skill-advisor.cjs advisor_recommend` asks `hookFlagDecision('skill-advisor')` in `.skilled/hooks/shared/hook-flags.cjs`, with the caller's environment over `.skilled/hooks/hook-flags.env`, before it connects to a daemon or runs the local scorer. Whenever the adapters are off, under any name in this table or its older `MK_` form, any truthy value or a line in the flags file, it prints the empty envelope with `ADVISOR_DISABLED` and names the switch that decided. A daemon reads the same names from its own environment and never reads the flags file, and the launcher passes no switch name and no `HOOK_FLAGS_CONFIG` to a daemon it starts, so a flagged command that happens to start the daemon does not leave it abstaining for every later caller. The standalone Python CLI keeps its own rule: only `SPECKIT_SKILL_ADVISOR_HOOK_DISABLED`, set to exactly `1`.\n+\n Additional controls: `SPECKIT_SKILL_ADVISOR_FORCE_LOCAL=1` (force local Python fallback where supported) and `--force-native` / `--force-local` / `--threshold` / `--stdin` (Python shim flags, default threshold `0.8`). `SPECKIT_OPENCODE_HOOK_TIMEOUT_MS` (default 3000) is owned by the `system-skill-advisor` hub: its live consumers are `runtime/lib/subprocess.ts`, `skill-advisor-brief.ts`, the OpenCode bridge and `skill_advisor.py`. On timeout the OpenCode bridge serves prompt-safe stale context with a timeout marker. OpenCode tuning: `SYSTEM_SKILL_ADVISOR_CACHE_TTL_MS` (default 5 min), `SYSTEM_SKILL_ADVISOR_MAX_TOKENS` (default 80), `SYSTEM_SKILL_ADVISOR_MAX_BRIEF_CHARS` (default 2 KiB), `SYSTEM_SKILL_ADVISOR_MAX_PROMPT_BYTES` (default 64 KiB, measured on the whole stdin request after JSON escaping), `SYSTEM_SKILL_ADVISOR_COMPILED_ROUTE_BOUNDING` (kept for existing configs: the transform adds no compiled-route line, so it changes only the `bounded_compiled_route_summary` status field).\n \n Set a flag inline for one command, export it for a session, or persist it in `.skilled/hooks/hook-flags.env` (copied from `hook-flags.env.example`, gitignored). The environment always wins over the file, so a persisted default can be overridden for a single session.\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"git diff db14c22bb0..HEAD -- .github/workflows/spec-kit-check.yml .skilled/commands/doctor/_routes.yaml .skilled/commands/doctor/scripts/hook-wiring-check.cjs .skilled/commands/doctor/scripts/README.markdown .skilled/commands/scripts/validate-command-references.cjs .skilled/skills/system-skill-advisor/hooks/claude/user-prompt-submit.ts .skilled/skills/system-skill-advisor/hooks/skill-advisor-hook.md\"}"},"time":{"start":1794760878548,"end":1794760879561}}}}
{"type":"step_finish","timestamp":1794760880474,"sessionID":"ses_e1feefdd5ffeHQJCqAmpoKpkZG","part":{"id":"prt_1e015b15a001967iRKU7KCpl3C","sessionID":"ses_e1feefdd5ffeHQJCqAmpoKpkZG","messageID":"msg_1e015983c001KLNAPxfpavaQIt","type":"step-finish","reason":"tool-calls","snapshot":"a88e44b8963b86bfa54f304a61c9626b1ccf272d","cost":0,"tokens":{"input":700,"output":153,"reasoning":99,"cache":{"read":131584,"write":0}}}}
{"type":"step_start","timestamp":1794760882730,"sessionID":"ses_e1feefdd5ffeHQJCqAmpoKpkZG","part":{"id":"prt_1e015ba2a001zp7viYiwAaBm7q","sessionID":"ses_e1feefdd5ffeHQJCqAmpoKpkZG","messageID":"msg_1e015b15e001usr2L2z2mJLGlM","type":"step-start","snapshot":"a88e44b8963b86bfa54f304a61c9626b1ccf272d"}}
{"type":"tool_use","timestamp":1794760887244,"sessionID":"ses_e1feefdd5ffeHQJCqAmpoKpkZG","part":{"partID":"prt_1e015cac1001EG2dG1UvOXYlnu","sessionID":"ses_e1feefdd5ffeHQJCqAmpoKpkZG","messageID":"msg_1e015b15e001usr2L2z2mJLGlM","type":"tool","id":"call_45a7d294e8e84d7bba6eeb8f","tool":"read","state":{"status":"completed","input":{"path":".skilled/skills/system-skill-advisor/hooks/vibe/prompt-advisor.mjs"},"output":"Read file .skilled/skills/system-skill-advisor/hooks/vibe/prompt-advisor.mjs, lines 1-236\n1: // ───────────────────────────────────────────────────────────────────\n2: // MODULE: Vibe Prompt Advisor Part\n3: // ───────────────────────────────────────────────────────────────────\n4: // The turn-start composer's advisor part. Vibe runs a fresh hook process for\n5: // every turn, so the receipts that keep a brief from repeating have to survive\n6: // the process: the shared handler's own file-backed store drops the constant\n7: // directive block once it is proven delivered, and a per-session head receipt\n8: // drops the routing head while the route has not changed. A child session, a\n9: // subagent and a blank prompt get nothing. Every failure contributes no text,\n10: // so a slow or broken advisor never blocks the turn.\n11: \n12: // ─────────────────────────────────────────────────────────────────────────────\n13: // 1. IMPORTS\n14: // ─────────────────────────────────────────────────────────────────────────────\n15: \n16: import { createHash } from 'node:crypto';\n17: import { existsSync, mkdirSync, readFileSync, readdirSync, statSync, unlinkSync, writeFileSync } from 'node:fs';\n18: import { tmpdir } from 'node:os';\n19: import { dirname, join, resolve } from 'node:path';\n20: import { fileURLToPath } from 'node:url';\n21: \n22: import { isHookEnabled } from '../../../../hooks/shared/hook-flags.mjs';\n23: \n24: // ─────────────────────────────────────────────────────────────────────────────\n25: // 2. CONSTANTS\n26: // ─────────────────────────────────────────────────────────────────────────────\n27: \n28: // A Vibe session runs in a throwaway folder, so the checkout is located from\n29: // this file instead: vibe -> hooks -> system-skill-advisor -> skills -> .skilled -> root.\n30: const REPO_ROOT = resolve(dirname(fileURLToPath(import.meta.url)), '../../../../..');\n31: \n32: const ADVISOR_MODULE_URL = new URL(\n33:   '../../runtime/dist/hooks/claude/user-prompt-submit.js',\n34:   import.meta.url,\n35: ).href;\n36: \n37: // Mirrors the advisor renderer's directive label. A brief that drifts past it is\n38: // never split, so it is always delivered whole.\n39: const DIRECTIVE_SEPARATOR = '\\nDirectives:';\n40: const CHILD_SESSION_ENV = 'AI_SESSION_CHILD';\n41: // The directive store's own base directory, so one switch isolates both receipts\n42: // in a test or a scratch run.\n43: const STATE_DIR_ENV = 'SPECKIT_DIRECTIVE_LIFECYCLE_STATE_DIR';\n44: const HEAD_RECEIPT_SUBDIR = 'vibe-turn-start';\n45: const MAX_HEAD_RECEIPTS = 64;\n46: // Vibe has no command loader and its prompt stubs name the dash form, so a head\n47: // that names a command is the one place a model learns which document to read.\n48: const COMMAND_DOCUMENT_LABEL = 'Command documents (read in full before taking one): ';\n49: const COMMAND_TOKEN_PATTERN = /(?:^|[\\s(])\\/([a-z][a-z0-9-]*)(?::([a-z][a-z0-9-]*))?/g;\n50: \n51: export const ERROR_POLICY = 'fail-open';\n52: // The advisor keys its metrics and outcome records by runtime and drops a label it does not list.\n53: export const ADVISOR_RUNTIME = 'vibe';\n54: \n55: // ─────────────────────────────────────────────────────────────────────────────\n56: // 3. HELPERS\n57: // ─────────────────────────────────────────────────────────────────────────────\n58: \n59: // A dispatched child inherits AI_SESSION_CHILD=1, and a subagent Vibe spawned\n60: // itself carries a parent session id. Either marks a session whose prompt is a\n61: // fixed task, where a route suggestion is noise.\n62: function isChildSession(payload, env) {\n63:   if (String(env[CHILD_SESSION_ENV] ?? '').trim() === '1') return true;\n64:   const parent = payload?.parent_session_id;\n65:   return typeof parent === 'string' && parent.trim() !== '';\n66: }\n67: \n68: function headReceiptDir() {\n69:   const configured = process.env[STATE_DIR_ENV]?.trim();\n70:   const base = configured ? resolve(configured) : join(tmpdir(), 'speckit-advisor');\n71:   return join(base, HEAD_RECEIPT_SUBDIR);\n72: }\n73: \n74: function headReceiptPath(sessionId) {\n75:   const digest = createHash('sha256').update(sessionId).digest('hex').slice(0, 16);\n76:   return join(headReceiptDir(), `${digest}.head`);\n77: }\n78: \n79: function readHeadReceipt(sessionId) {\n80:   try {\n81:     return readFileSync(headReceiptPath(sessionId), 'utf8');\n82:   } catch {\n83:     return '';\n84:   }\n85: }\n86: \n87: // The folder is bounded the way the directive store bounds its sessions, so a\n88: // long-lived machine does not keep one file per session forever.\n89: function evictOldestReceipts(directory) {\n90:   const names = readdirSync(directory).filter((name) => name.endsWith('.head'));\n91:   if (names.length < MAX_HEAD_RECEIPTS) return;\n92:   const oldest = names\n93:     .map((name) => ({ name, mtime: statSync(join(directory, name)).mtimeMs }))\n94:     .sort((left, right) => left.mtime - right.mtime)\n95:     .slice(0, names.length - MAX_HEAD_RECEIPTS + 1);\n96:   for (const entry of oldest) unlinkSync(join(directory, entry.name));\n97: }\n98: \n99: function writeHeadReceipt(sessionId, head) {\n100:   try {\n101:     const directory = headReceiptDir();\n102:     mkdirSync(directory, { recursive: true, mode: 0o700 });\n103:     const target = headReceiptPath(sessionId);\n104:     if (!existsSync(target)) evictOldestReceipts(directory);\n105:     writeFileSync(target, head, { mode: 0o600 });\n106:   } catch {\n107:     // A receipt that cannot be written only costs a repeated head next turn.\n108:   }\n109: }\n110: \n111: /**\n112:  * Name the canonical document of each command the routing head mentions.\n113:  *\n114:  * Vibe has no command loader and its prompt stubs name the dash form, so the\n115:  * head is where each offered command's document has to be named. The line is\n116:  * added before the head receipt, so two equal heads stay equal and a repeated\n117:  * brief is still dropped.\n118:  *\n119:  * @param {string} context - The advisor's additional context.\n120:  * @param {string} [root] - The checkout the document paths resolve under.\n121:  * @returns {string} The context with one document line, or unchanged.\n122:  */\n123: export function withCommandDocuments(context, root = REPO_ROOT) {\n124:   try {\n125:     const separator = context.indexOf(DIRECTIVE_SEPARATOR);\n126:     const head = separator > 0 ? context.slice(0, separator) : context;\n127:     const rest = separator > 0 ? context.slice(separator) : '';\n128: \n129:     const documents = [];\n130:     for (const [, namespace, name] of head.matchAll(COMMAND_TOKEN_PATTERN)) {\n131:       const command = name ? `/${namespace}:${name}` : `/${namespace}`;\n132:       const relative = name\n133:         ? `.skilled/commands/${namespace}/${name}.md`\n134:         : `.skilled/commands/${namespace}.md`;\n135:       if (documents.some((document) => document.relative === relative)) continue;\n136:       if (!existsSync(join(root, relative))) continue;\n137:       documents.push({ command, relative });\n138:     }\n139:     if (documents.length === 0) return context;\n140: \n141:     const pairs = documents\n142:       .map((document) => `${document.command} is ${document.relative}`)\n143:       .join(', ');\n144:     return `${head}\\n${COMMAND_DOCUMENT_LABEL}${pairs}.${rest}`;\n145:   } catch {\n146:     return context;\n147:   }\n148: }\n149: \n150: /**\n151:  * Drop the routing head when this session already received it unchanged.\n152:  *\n153:  * A brief that still carries its directive block is delivered whole: the shared\n154:  * handler owns that block's lifecycle, and its presence means the block has not\n155:  * been proven delivered yet. A head-only brief is the handler's reduced repeat,\n156:  * so the head receipt decides whether even that text adds anything.\n157:  *\n158:  * @param {string} context - The advisor's additional context.\n159:  * @param {string} sessionId - The Vibe session id, the receipt key.\n160:  * @param {{read?: Function, write?: Function}} [receipts] - Injectable for tests.\n161:  * @returns {string} The text to deliver, or an empty string to deliver nothing.\n162:  */\n163: export function reduceRepeatedHead(context, sessionId, {\n164:   read = readHeadReceipt,\n165:   write = writeHeadReceipt,\n166: } = {}) {\n167:   if (typeof sessionId !== 'string' || !sessionId.trim()) return context;\n168: \n169:   const separator = context.indexOf(DIRECTIVE_SEPARATOR);\n170:   if (separator > 0) {\n171:     write(sessionId, context.slice(0, separator));\n172:     return context;\n173:   }\n174:   // An older build rendered the no-brief fallback as the directive block alone.\n175:   // Its block is the handler's to dedupe, and there is no head to compare.\n176:   const label = DIRECTIVE_SEPARATOR.slice(1);\n177:   if (context.startsWith(label)) return context;\n178: \n179:   if (read(sessionId) === context) return '';\n180:   write(sessionId, context);\n181:   return context;\n182: }\n183: \n184: async function runAdvisor(input) {\n185:   const advisor = await import(ADVISOR_MODULE_URL);\n186:   return advisor.handleClaudeUserPromptSubmit(input, {\n187:     runtime: ADVISOR_RUNTIME,\n188:     writeDiagnostic: () => {},\n189:   });\n190: }\n191: \n192: // ─────────────────────────────────────────────────────────────────────────────\n193: // 4. CORE LOGIC\n194: // ─────────────────────────────────────────────────────────────────────────────\n195: \n196: /**\n197:  * Build the advisor part of one turn-start context.\n198:  *\n199:  * @param {Object} payload - The Vibe pre_agent payload.\n200:  * @param {Object} [dependencies] - Injectable for deterministic tests.\n201:  * @returns {Promise<string>} The advisor brief, or an empty string.\n202:  */\n203: export async function buildAdvisorPart(payload, {\n204:   run = runAdvisor,\n205:   env = process.env,\n206:   isEnabled = isHookEnabled,\n207:   read = readHeadReceipt,\n208:   write = writeHeadReceipt,\n209: } = {}) {\n210:   try {\n211:     if (!payload || payload.hook_event_name !== 'pre_agent') return '';\n212:     if (isChildSession(payload, env)) return '';\n213: \n214:     const prompt = typeof payload.prompt === 'string' ? payload.prompt : '';\n215:     if (!prompt.trim()) return '';\n216:     if (isEnabled('skill-advisor') === false) return '';\n217: \n218:     const sessionId = typeof payload.session_id === 'string' ? payload.session_id : '';\n219:     const transcriptPath = typeof payload.transcript_path === 'string' && payload.transcript_path\n220:       ? payload.transcript_path\n221:       : undefined;\n222:     const output = await run({\n223:       prompt,\n224:       cwd: REPO_ROOT,\n225:       session_id: sessionId,\n226:       transcript_path: transcriptPath,\n227:       hook_event_name: 'UserPromptSubmit',\n228:     });\n229: \n230:     const context = output?.hookSpecificOutput?.additionalContext;\n231:     if (typeof context !== 'string' || !context.trim()) return '';\n232:     return reduceRepeatedHead(withCommandDocuments(context), sessionId, { read, write });\n233:   } catch {\n234:     return '';\n235:   }\n236: }","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file .skilled/skills/system-skill-advisor/hooks/vibe/prompt-advisor.mjs, lines 1-236\n1: // ───────────────────────────────────────────────────────────────────\n2: // MODULE: Vibe Prompt Advisor Part\n3: // ───────────────────────────────────────────────────────────────────\n4: // The turn-start composer's advisor part. Vibe runs a fresh hook process for\n5: // every turn, so the receipts that keep a brief from repeating have to survive\n6: // the process: the shared handler's own file-backed store drops the constant\n7: // directive block once it is proven delivered, and a per-session head receipt\n8: // drops the routing head while the route has not changed. A child session, a\n9: // subagent and a blank prompt get nothing. Every failure contributes no text,\n10: // so a slow or broken advisor never blocks the turn.\n11: \n12: // ─────────────────────────────────────────────────────────────────────────────\n13: // 1. IMPORTS\n14: // ─────────────────────────────────────────────────────────────────────────────\n15: \n16: import { createHash } from 'node:crypto';\n17: import { existsSync, mkdirSync, readFileSync, readdirSync, statSync, unlinkSync, writeFileSync } from 'node:fs';\n18: import { tmpdir } from 'node:os';\n19: import { dirname, join, resolve } from 'node:path';\n20: import { fileURLToPath } from 'node:url';\n21: \n22: import { isHookEnabled } from '../../../../hooks/shared/hook-flags.mjs';\n23: \n24: // ─────────────────────────────────────────────────────────────────────────────\n25: // 2. CONSTANTS\n26: // ─────────────────────────────────────────────────────────────────────────────\n27: \n28: // A Vibe session runs in a throwaway folder, so the checkout is located from\n29: // this file instead: vibe -> hooks -> system-skill-advisor -> skills -> .skilled -> root.\n30: const REPO_ROOT = resolve(dirname(fileURLToPath(import.meta.url)), '../../../../..');\n31: \n32: const ADVISOR_MODULE_URL = new URL(\n33:   '../../runtime/dist/hooks/claude/user-prompt-submit.js',\n34:   import.meta.url,\n35: ).href;\n36: \n37: // Mirrors the advisor renderer's directive label. A brief that drifts past it is\n38: // never split, so it is always delivered whole.\n39: const DIRECTIVE_SEPARATOR = '\\nDirectives:';\n40: const CHILD_SESSION_ENV = 'AI_SESSION_CHILD';\n41: // The directive store's own base directory, so one switch isolates both receipts\n42: // in a test or a scratch run.\n43: const STATE_DIR_ENV = 'SPECKIT_DIRECTIVE_LIFECYCLE_STATE_DIR';\n44: const HEAD_RECEIPT_SUBDIR = 'vibe-turn-start';\n45: const MAX_HEAD_RECEIPTS = 64;\n46: // Vibe has no command loader and its prompt stubs name the dash form, so a head\n47: // that names a command is the one place a model learns which document to read.\n48: const COMMAND_DOCUMENT_LABEL = 'Command documents (read in full before taking one): ';\n49: const COMMAND_TOKEN_PATTERN = /(?:^|[\\s(])\\/([a-z][a-z0-9-]*)(?::([a-z][a-z0-9-]*))?/g;\n50: \n51: export const ERROR_POLICY = 'fail-open';\n52: // The advisor keys its metrics and outcome records by runtime and drops a label it does not list.\n53: export const ADVISOR_RUNTIME = 'vibe';\n54: \n55: // ─────────────────────────────────────────────────────────────────────────────\n56: // 3. HELPERS\n57: // ─────────────────────────────────────────────────────────────────────────────\n58: \n59: // A dispatched child inherits AI_SESSION_CHILD=1, and a subagent Vibe spawned\n60: // itself carries a parent session id. Either marks a session whose prompt is a\n61: // fixed task, where a route suggestion is noise.\n62: function isChildSession(payload, env) {\n63:   if (String(env[CHILD_SESSION_ENV] ?? '').trim() === '1') return true;\n64:   const parent = payload?.parent_session_id;\n65:   return typeof parent === 'string' && parent.trim() !== '';\n66: }\n67: \n68: function headReceiptDir() {\n69:   const configured = process.env[STATE_DIR_ENV]?.trim();\n70:   const base = configured ? resolve(configured) : join(tmpdir(), 'speckit-advisor');\n71:   return join(base, HEAD_RECEIPT_SUBDIR);\n72: }\n73: \n74: function headReceiptPath(sessionId) {\n75:   const digest = createHash('sha256').update(sessionId).digest('hex').slice(0, 16);\n76:   return join(headReceiptDir(), `${digest}.head`);\n77: }\n78: \n79: function readHeadReceipt(sessionId) {\n80:   try {\n81:     return readFileSync(headReceiptPath(sessionId), 'utf8');\n82:   } catch {\n83:     return '';\n84:   }\n85: }\n86: \n87: // The folder is bounded the way the directive store bounds its sessions, so a\n88: // long-lived machine does not keep one file per session forever.\n89: function evictOldestReceipts(directory) {\n90:   const names = readdirSync(directory).filter((name) => name.endsWith('.head'));\n91:   if (names.length < MAX_HEAD_RECEIPTS) return;\n92:   const oldest = names\n93:     .map((name) => ({ name, mtime: statSync(join(directory, name)).mtimeMs }))\n94:     .sort((left, right) => left.mtime - right.mtime)\n95:     .slice(0, names.length - MAX_HEAD_RECEIPTS + 1);\n96:   for (const entry of oldest) unlinkSync(join(directory, entry.name));\n97: }\n98: \n99: function writeHeadReceipt(sessionId, head) {\n100:   try {\n101:     const directory = headReceiptDir();\n102:     mkdirSync(directory, { recursive: true, mode: 0o700 });\n103:     const target = headReceiptPath(sessionId);\n104:     if (!existsSync(target)) evictOldestReceipts(directory);\n105:     writeFileSync(target, head, { mode: 0o600 });\n106:   } catch {\n107:     // A receipt that cannot be written only costs a repeated head next turn.\n108:   }\n109: }\n110: \n111: /**\n112:  * Name the canonical document of each command the routing head mentions.\n113:  *\n114:  * Vibe has no command loader and its prompt stubs name the dash form, so the\n115:  * head is where each offered command's document has to be named. The line is\n116:  * added before the head receipt, so two equal heads stay equal and a repeated\n117:  * brief is still dropped.\n118:  *\n119:  * @param {string} context - The advisor's additional context.\n120:  * @param {string} [root] - The checkout the document paths resolve under.\n121:  * @returns {string} The context with one document line, or unchanged.\n122:  */\n123: export function withCommandDocuments(context, root = REPO_ROOT) {\n124:   try {\n125:     const separator = context.indexOf(DIRECTIVE_SEPARATOR);\n126:     const head = separator > 0 ? context.slice(0, separator) : context;\n127:     const rest = separator > 0 ? context.slice(separator) : '';\n128: \n129:     const documents = [];\n130:     for (const [, namespace, name] of head.matchAll(COMMAND_TOKEN_PATTERN)) {\n131:       const command = name ? `/${namespace}:${name}` : `/${namespace}`;\n132:       const relative = name\n133:         ? `.skilled/commands/${namespace}/${name}.md`\n134:         : `.skilled/commands/${namespace}.md`;\n135:       if (documents.some((document) => document.relative === relative)) continue;\n136:       if (!existsSync(join(root, relative))) continue;\n137:       documents.push({ command, relative });\n138:     }\n139:     if (documents.length === 0) return context;\n140: \n141:     const pairs = documents\n142:       .map((document) => `${document.command} is ${document.relative}`)\n143:       .join(', ');\n144:     return `${head}\\n${COMMAND_DOCUMENT_LABEL}${pairs}.${rest}`;\n145:   } catch {\n146:     return context;\n147:   }\n148: }\n149: \n150: /**\n151:  * Drop the routing head when this session already received it unchanged.\n152:  *\n153:  * A brief that still carries its directive block is delivered whole: the shared\n154:  * handler owns that block's lifecycle, and its presence means the block has not\n155:  * been proven delivered yet. A head-only brief is the handler's reduced repeat,\n156:  * so the head receipt decides whether even that text adds anything.\n157:  *\n158:  * @param {string} context - The advisor's additional context.\n159:  * @param {string} sessionId - The Vibe session id, the receipt key.\n160:  * @param {{read?: Function, write?: Function}} [receipts] - Injectable for tests.\n161:  * @returns {string} The text to deliver, or an empty string to deliver nothing.\n162:  */\n163: export function reduceRepeatedHead(context, sessionId, {\n164:   read = readHeadReceipt,\n165:   write = writeHeadReceipt,\n166: } = {}) {\n167:   if (typeof sessionId !== 'string' || !sessionId.trim()) return context;\n168: \n169:   const separator = context.indexOf(DIRECTIVE_SEPARATOR);\n170:   if (separator > 0) {\n171:     write(sessionId, context.slice(0, separator));\n172:     return context;\n173:   }\n174:   // An older build rendered the no-brief fallback as the directive block alone.\n175:   // Its block is the handler's to dedupe, and there is no head to compare.\n176:   const label = DIRECTIVE_SEPARATOR.slice(1);\n177:   if (context.startsWith(label)) return context;\n178: \n179:   if (read(sessionId) === context) return '';\n180:   write(sessionId, context);\n181:   return context;\n182: }\n183: \n184: async function runAdvisor(input) {\n185:   const advisor = await import(ADVISOR_MODULE_URL);\n186:   return advisor.handleClaudeUserPromptSubmit(input, {\n187:     runtime: ADVISOR_RUNTIME,\n188:     writeDiagnostic: () => {},\n189:   });\n190: }\n191: \n192: // ─────────────────────────────────────────────────────────────────────────────\n193: // 4. CORE LOGIC\n194: // ─────────────────────────────────────────────────────────────────────────────\n195: \n196: /**\n197:  * Build the advisor part of one turn-start context.\n198:  *\n199:  * @param {Object} payload - The Vibe pre_agent payload.\n200:  * @param {Object} [dependencies] - Injectable for deterministic tests.\n201:  * @returns {Promise<string>} The advisor brief, or an empty string.\n202:  */\n203: export async function buildAdvisorPart(payload, {\n204:   run = runAdvisor,\n205:   env = process.env,\n206:   isEnabled = isHookEnabled,\n207:   read = readHeadReceipt,\n208:   write = writeHeadReceipt,\n209: } = {}) {\n210:   try {\n211:     if (!payload || payload.hook_event_name !== 'pre_agent') return '';\n212:     if (isChildSession(payload, env)) return '';\n213: \n214:     const prompt = typeof payload.prompt === 'string' ? payload.prompt : '';\n215:     if (!prompt.trim()) return '';\n216:     if (isEnabled('skill-advisor') === false) return '';\n217: \n218:     const sessionId = typeof payload.session_id === 'string' ? payload.session_id : '';\n219:     const transcriptPath = typeof payload.transcript_path === 'string' && payload.transcript_path\n220:       ? payload.transcript_path\n221:       : undefined;\n222:     const output = await run({\n223:       prompt,\n224:       cwd: REPO_ROOT,\n225:       session_id: sessionId,\n226:       transcript_path: transcriptPath,\n227:       hook_event_name: 'UserPromptSubmit',\n228:     });\n229: \n230:     const context = output?.hookSpecificOutput?.additionalContext;\n231:     if (typeof context !== 'string' || !context.trim()) return '';\n232:     return reduceRepeatedHead(withCommandDocuments(context), sessionId, { read, write });\n233:   } catch {\n234:     return '';\n235:   }\n236: }"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\".skilled/skills/system-skill-advisor/hooks/vibe/prompt-advisor.mjs\"}"},"time":{"start":1794760886977,"end":1794760887244}}}}
