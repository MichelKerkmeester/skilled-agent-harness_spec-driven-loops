MK_SKILL_ADVISOR_HOOK_DISABLED\",\n75-    \"MK_SKILL_ADVISOR_PLUGIN_DISABLED\",\n76-    \"SPECKIT_SKILL_ADVISOR_HOOK_DISABLED\",\n--\n101:// end a running session and start a new one), except on a runtime DEFAULT_ON_RUNTIMES\n102-// names for it. The opt-in resolves like every other flag, environment over file,\n103-// and the master and kill switches still win over it.\n104-const DEFAULT_OFF = {\n105-  \"session-handover\": \"SYSTEM_SESSION_HANDOVER_ENABLED\",\n106-};\n107-\n108-// The CLI runtimes that can carry a default-off concern. An operator may want the\n109-// relaunch loop on in one runtime and off in another, so each runtime gets its own\n110-// enable switch, SYSTEM_SESSION_HANDOVER_<RUNTIME>_ENABLED, which answers before\n111-// the global one whenever it holds a value. A caller names its runtime explicitly;\n112-// the resolver never guesses it from the environment.\n113:const RUNTIMES = Object.freeze([\"claude\", \"codex\", \"pi\", \"opencode\", \"cursor\", \"devin\", \"vibe\"]);\n114-\n115-// concern -> the runtimes where a default-off concern is on when neither its runtime\n116-// switch nor its global switch holds a value. Claude Code's hand-over needs no extra\n117-// wiring beyond the hooks every install registers, so a project gets it without\n118-// finding the switch; the other runtimes still wait for their owner to opt in. A set\n119-// value, the master switch and the kill switches all answer before this default.\n120:const DEFAULT_ON_RUNTIMES = Object.freeze({\n121-  \"session-handover\": Object.freeze([\"claude\"]),\n122-});\n123-\n124-// Main switch prefix -> the second spelling also read for it. People call the hand-over\n125-// \"in-session handover\" too, so a switch written with that name works. The second\n126-// spelling answers only when the main switch is unset or blank, so the main name wins\n127-// whenever both hold a value.\n128-const SWITCH_ALIAS_PREFIXES = Object.freeze({\n129-  SYSTEM_SESSION_HANDOVER_: \"SYSTEM_IN_SESSION_HANDOVER_\",\n130-});\n131-\n132-// The second spelling of a switch, or null when the switch has none.\n--\n154:function isTruthy(value) {\n155-  if (typeof value !== \"string\") return false;\n156-  const v = value.trim().toLowerCase();\n157-  return v === \"1\" || v === \"true\" || v === \"yes\" || v === \"on\";\n158-}\n159-\n160-// Parse a KEY=value config file into a plain object. Blank lines and lines\n161-// beginning with '#' are ignored; a '#' after a space or tab ends the value, so\n162-// the example file's lines, which carry a trailing comment, still work once\n163-// uncommented; surrounding single/double quotes on the value are stripped. The\n164-// other readers of this file (hook-flags.sh, sk-doc's validation_switch.py and\n165-// sk-code's check-dist-staleness.sh) parse it the same way. Any read/parse\n166-// failure returns {} so a broken or absent file can never disable a hook the\n--\n220:// DEFAULT_ON_RUNTIMES is on and any other is off. The master and kill switches still\n221:// win over all of them. With no runtime, or one outside RUNTIMES, only the global applies.\n222:function isHookEnabled(concern, env, config, options) {\n223-  return hookFlagDecision(concern, env, config, options).enabled;\n224-}\n225-\n226-// The single decision behind isHookEnabled, with the switch that made it, so a caller\n227-// can tell the operator which flag to change. `key` is the switch that decided, or null\n228-// when nothing did and the concern is on by default. `reason` says which rung of the\n229-// precedence answered: \"master\" (the master switch or an alias), \"kill\" (the concern's\n230-// kill switch or a legacy alias), \"runtime\" (the runtime's enable switch, which held a\n231-// value), \"global\" (the global enable switch, unset or set) or \"default\" (a default-on\n232:// concern, or a default-off one on a runtime DEFAULT_ON_RUNTIMES names). Arguments are\n233-// those of isHookEnabled.\n234:function hookFlagDecision(concern, env, config, options) {\n235-  const hasEnv = env !== undefined && env !== null;\n236-  const source = hasEnv ? env : process.env;\n237-  const cfg =\n238-    config !== undefined && config !== null\n239-      ? config\n240-      : hasEnv\n241-        ? EMPTY_CONFIG\n242-        : fileConfig();\n243-  const resolve = (key) => {\n244-    const fromEnv = source[key];\n245-    return fromEnv !== undefined ? fromEnv : cfg[key];\n246-  };\n--\n256:  for (const key of [MASTER_FLAG].concat(MASTER_ALIASES)) {\n257-    if (isTruthy(resolve(key))) return { enabled: false, key, reason: \"master\" };\n258-  }\n259-  const flag = concernFlag(concern);\n260-  if (flag) {\n261-    const kill = resolveSwitch(flag);\n262-    if (isTruthy(kill.value)) return { enabled: false, key: kill.key, reason: \"kill\" };\n263-  }\n264:  for (const key of LEGACY_ALIASES[concern] || []) {\n265-    if (isTruthy(resolve(key))) return { enabled: false, key, reason: \"kill\" };\n266-  }\n267-  if (Object.prototype.hasOwnProperty.call(DEFAULT_OFF, concern)) {\n268-    const runtimeFlag = runtimeEnableFlag(concern, options && options.runtime);\n269-    if (runtimeFlag) {\n270-      const runtimeSwitch = resolveSwitch(runtimeFlag);\n271-      if (holds(runtimeSwitch.value)) {\n272-        return { enabled: isTruthy(runtimeSwitch.value), key: runtimeSwitch.key, reason: \"runtime\" };\n273-      }\n274-    }\n275-    const globalSwitch = resolveSwitch(DEFAULT_OFF[concern]);\n276-    if (!holds(globalSwitch.value)) {\n--\n278:      if ((DEFAULT_ON_RUNTIMES[concern] || []).includes(runtime)) {\n279-        return { enabled: true, key: null, reason: \"default\" };\n280-      }\n281-    }\n282-    return { enabled: isTruthy(globalSwitch.value), key: globalSwitch.key, reason: \"global\" };\n283-  }\n284-  return { enabled: true, key: null, reason: \"default\" };\n285-}\n286-\n287-// The per-runtime enable switch for a default-off concern, such as\n288-// SYSTEM_SESSION_HANDOVER_CLAUDE_ENABLED, or null when the concern has no enab