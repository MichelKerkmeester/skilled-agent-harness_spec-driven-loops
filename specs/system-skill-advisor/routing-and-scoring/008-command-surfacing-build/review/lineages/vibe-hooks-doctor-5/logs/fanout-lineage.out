{"type":"tool_use","timestamp":1794760747086,"sessionID":"ses_e1feefdd5ffeHQJCqAmpoKpkZG","part":{"partID":"prt_1e013a762001h1u2nxW2txc6Zc","sessionID":"ses_e1feefdd5ffeHQJCqAmpoKpkZG","messageID":"msg_1e01398f00013s8AUteCl1huC2","type":"tool","id":"call_b7f9a1335f614b8f97726a53","tool":"read","state":{"status":"completed","input":{"path":".skilled/commands/doctor/scripts/hook-wiring-check.cjs"},"output":"Read file .skilled/commands/doctor/scripts/hook-wiring-check.cjs, lines 1-408\n1: #!/usr/bin/env node\n2: // ───────────────────────────────────────────────────────────────────\n3: // MODULE: Hook Wiring Check\n4: // ───────────────────────────────────────────────────────────────────\n5: 'use strict';\n6: \n7: // Read-only /doctor diagnostic for the prompt hook entry each runtime loads.\n8: //\n9: // WHY THIS EXISTS: the skill advisor reaches a first prompt only through the hook\n10: // entry a runtime fires before the model sees that prompt. A runtime folder can be\n11: // installed while its hook file is missing, its JSON is unreadable, or the entry\n12: // was never added, and then the advisor is silent with no error at session start.\n13: // This check names the runtime and the file to repair.\n14: //\n15: // Never writes. Exit 0 when every installed runtime carries its entry, 1 when one\n16: // is missing, 2 on a bad argument or a missing root.\n17: \n18: // ─────────────────────────────────────────────────────────────────────────────\n19: // 1. IMPORTS\n20: // ─────────────────────────────────────────────────────────────────────────────\n21: \n22: const fs = require('node:fs');\n23: const path = require('node:path');\n24: \n25: // ─────────────────────────────────────────────────────────────────────────────\n26: // 2. CONSTANTS\n27: // ─────────────────────────────────────────────────────────────────────────────\n28: \n29: const USAGE = [\n30:   'Usage: hook-wiring-check.cjs --root <dir> [--json]',\n31:   '  --root  check the checkout under <dir>.',\n32:   '  --json  print one JSON object instead of one line per runtime.',\n33: ].join('\\n');\n34: \n35: // Each entry names the runtime folder that decides whether the check applies,\n36: // the hook file inside it, the event that carries the prompt entry, and the path\n37: // fragment whose presence proves the entry is wired. A runtime folder that is\n38: // absent is skipped, because that runtime was never installed in this checkout.\n39: // A `toml` entry is read line by line, because the repository installs no TOML parser.\n40: const RUNTIMES = [\n41:   {\n42:     id: 'claude',\n43:     dir: '.claude',\n44:     file: '.claude/settings.json',\n45:     event: 'UserPromptSubmit',\n46:     marker: 'hooks/claude/user-prompt-submit.js',\n47:   },\n48:   {\n49:     id: 'codex',\n50:     dir: '.codex',\n51:     file: '.codex/hooks.json',\n52:     event: 'UserPromptSubmit',\n53:     marker: 'hooks/codex/user-prompt-submit.js',\n54:   },\n55:   {\n56:     id: 'cursor',\n57:     dir: '.cursor',\n58:     file: '.cursor/hooks.json',\n59:     event: 'beforeSubmitPrompt',\n60:     marker: 'hooks/cursor/user-prompt-submit.js',\n61:   },\n62:   {\n63:     id: 'devin',\n64:     dir: '.devin',\n65:     file: '.devin/hooks.v1.json',\n66:     event: 'UserPromptSubmit',\n67:     marker: 'hooks/devin/user-prompt-submit.js',\n68:   },\n69:   {\n70:     id: 'vibe',\n71:     dir: '.vibe',\n72:     file: '.vibe/hooks.toml',\n73:     event: 'pre_agent',\n74:     marker: 'hooks/session-lifecycle/vibe/turn-start.mjs',\n75:     format: 'toml',\n76:   },\n77: ];\n78: \n79: // ─────────────────────────────────────────────────────────────────────────────\n80: // 3. HELPERS\n81: // ─────────────────────────────────────────────────────────────────────────────\n82: \n83: function fail(message) {\n84:   process.stderr.write(`hook-wiring-check: ${message}\\n`);\n85:   process.exit(2);\n86: }\n87: \n88: function parseArgs(argv) {\n89:   const opts = { root: null, json: false };\n90:   for (let i = 0; i < argv.length; i += 1) {\n91:     const arg = argv[i];\n92:     if (arg === '--json') {\n93:       opts.json = true;\n94:     } else if (arg === '--root') {\n95:       const value = argv[i + 1];\n96:       if (!value || value.startsWith('-')) fail(`--root needs a directory\\n${USAGE}`);\n97:       opts.root = path.resolve(value);\n98:       i += 1;\n99:     } else {\n100:       fail(`unknown argument: ${arg}\\n${USAGE}`);\n101:     }\n102:   }\n103:   if (!opts.root) fail(`--root is required\\n${USAGE}`);\n104:   if (!fs.existsSync(opts.root) || !fs.statSync(opts.root).isDirectory()) {\n105:     fail(`root not found: ${opts.root}`);\n106:   }\n107:   return opts;\n108: }\n109: \n110: // Hook files either wrap their events in a `hooks` object or place them at the\n111: // top level, and the cursor file omits the nested hook array the others carry.\n112: // A mention is not a wired hook, so only a command that runs the script counts:\n113: // the event's entries and their nested hooks arrays are walked for command\n114: // entries, and a runtime is wired when one starts node on the marker path.\n115: function eventPayload(document, event) {\n116:   if (!document || typeof document !== 'object') return undefined;\n117:   if (document.hooks && typeof document.hooks === 'object' && event in document.hooks) {\n118:     return document.hooks[event];\n119:   }\n120:   if (event in document) return document[event];\n121:   return undefined;\n122: }\n123: \n124: // A shell groups quoted text into one word and ends a simple command at an\n125: // operator that stands outside quotes, even one stuck to the word before it.\n126: // Reading the words first keeps an echo of a quoted script a mention, because a\n127: // quoted word is only an argument unless a shell is told to run it.\n128: function readWords(command) {\n129:   const words = [];\n130:   let text = '';\n131:   let started = false;\n132: \n133:   function flush() {\n134:     if (!started) return;\n135:     words.push({ text, separator: false });\n136:     text = '';\n137:     started = false;\n138:   }\n139: \n140:   for (let i = 0; i < command.length; i += 1) {\n141:     const char = command[i];\n142:     if (char === \"'\" || char === '\"') {\n143:       started = true;\n144:       i += 1;\n145:       // A shell refuses a line whose quote never closes, so nothing in it runs.\n146:       if (command.indexOf(char, i) === -1) return [];\n147:       while (i < command.length && command[i] !== char) {\n148:         if (char === '\"' && command[i] === '\\\\' && i + 1 < command.length) {\n149:           text += command[i + 1];\n150:           i += 2;\n151:         } else {\n152:           text += command[i];\n153:           i += 1;\n154:         }\n155:       }\n156:       continue;\n157:     }\n158:     if (char === '\\\\') {\n159:       // A backslash before a line break joins the two lines and adds nothing.\n160:       if (command[i + 1] === '\\n') {\n161:         i += 1;\n162:       } else if (i + 1 < command.length) {\n163:         text += command[i + 1];\n164:         started = true;\n165:         i += 1;\n166:       }\n167:       continue;\n168:     }\n169:     // A comment runs from an unquoted # at the start of a word to the line end.\n170:     if (char === '#' && !started) {\n171:       while (i + 1 < command.length && command[i + 1] !== '\\n') i += 1;\n172:       continue;\n173:     }\n174:     if (char === '\\n') {\n175:       flush();\n176:       words.push({ text: char, separator: true });\n177:       continue;\n178:     }\n179:     const pair = command.slice(i, i + 2);\n180:     if (pair === '&&' || pair === '||') {\n181:       flush();\n182:       words.push({ text: pair, separator: true });\n183:       i += 1;\n184:       continue;\n185:     }\n186:     if (char === ';' || char === '|' || char === '&' || char === '(' || char === ')') {\n187:       flush();\n188:       words.push({ text: char, separator: true });\n189:       continue;\n190:     }\n191:     if (/\\s/.test(char)) {\n192:       flush();\n193:       continue;\n194:     }\n195:     text += char;\n196:     started = true;\n197:   }\n198:   flush();\n199:   return words;\n200: }\n201: \n202: function simpleCommands(words) {\n203:   const commands = [];\n204:   let current = [];\n205:   for (const word of words) {\n206:     if (word.separator) {\n207:       if (current.length > 0) commands.push(current);\n208:       current = [];\n209:     } else {\n210:       current.push(word);\n211:     }\n212:   }\n213:   if (current.length > 0) commands.push(current);\n214:   return commands;\n215: }\n216: \n217: function collectCommands(node, commands) {\n218:   if (Array.isArray(node)) {\n219:     for (const entry of node) collectCommands(entry, commands);\n220:   } else if (node && typeof node === 'object') {\n221:     if (node.type === 'command' && typeof node.command === 'string') commands.push(node.command);\n222:     if (Array.isArray(node.hooks)) collectCommands(node.hooks, commands);\n223:   }\n224:   return commands;\n225: }\n226: \n227: // A TOML hook file groups its entries under `[[hooks]]` headers rather than a\n228: // JSON key, and no TOML parser is installed here, so each block is read line by\n229: // line. A commented line names nothing that runs, so it is skipped. A basic\n230: // string value escapes the quote and backslash after it, so both are unescaped.\n231: // A header ends the block before it, so a commented header or another table never\n232: // lends its keys to a hooks block.\n233: function tomlCommands(text, event) {\n234:   const blocks = [];\n235:   let current = null;\n236:   for (const line of text.split('\\n')) {\n237:     const trimmed = line.trim();\n238:     if (trimmed.startsWith('[')) {\n239:       const header = trimmed.replace(/#.*$/, '').replace(/\\s/g, '');\n240:       if (header === '[[hooks]]') {\n241:         current = {};\n242:         blocks.push(current);\n243:       } else {\n244:         current = null;\n245:       }\n246:       continue;\n247:     }\n248:     if (current === null || trimmed.startsWith('#')) continue;\n249:     const entry = /^(type|command)\\s*=\\s*\"(.*)\"$/.exec(trimmed);\n250:     if (!entry) continue;\n251:     current[entry[1]] = entry[2].replace(/\\\\([\"\\\\])/g, '$1');\n252:   }\n253:   return blocks\n254:     .filter((block) => block.type === event && typeof block.command === 'string')\n255:     .map((block) => block.command);\n256: }\n257: \n258: const ASSIGNMENT = /^[A-Za-z_][A-Za-z0-9_]*=/;\n259: \n260: // Flags whose next word is their own argument, so that word is not the command.\n261: const ENV_FLAGS_WITH_ARGUMENT = new Set(['-u', '--unset', '-C', '--chdir']);\n262: const NODE_FLAGS_WITH_ARGUMENT = new Set([\n263:   '-r', '--require', '--import', '--loader', '--experimental-loader', '-C', '--conditions',\n264: ]);\n265: // Flags that make node do something other than run the script it is given.\n266: const NODE_FLAGS_WITHOUT_RUN = new Set([\n267:   '-c', '--check', '-e', '--eval', '-p', '--print', '-v', '--version', '-h', '--help',\n268: ]);\n269: // A flag can carry its value in the same word, after an equals sign for a long\n270: // flag and directly after the letter for a short one, so the name is read first.\n271: function nodeFlagSkipsScript(flag) {\n272:   if (flag.startsWith('--')) return NODE_FLAGS_WITHOUT_RUN.has(flag.split('=')[0]);\n273:   if (NODE_FLAGS_WITHOUT_RUN.has(flag)) return true;\n274:   // A short preload flag takes the rest of its word as the module name.\n275:   if (/^-[rC]/.test(flag)) return false;\n276:   return /^-[a-zA-Z]*[cepvh]/.test(flag);\n277: }\n278: \n279: // Words that open a group or hand over the shell and leave the command after them.\n280: const COMMAND_PREFIXES = new Set(['{', 'exec', 'command', 'nohup', 'time', 'then', 'do', 'else']);\n281: \n282: function isNodeExecutable(token) {\n283:   return token === 'node' || token.endsWith('/node');\n284: }\n285: \n286: function isEnvExecutable(token) {\n287:   return token === 'env' || token.endsWith('/env');\n288: }\n289: \n290: function isShellExecutable(token) {\n291:   return ['bash', 'sh', 'zsh'].some((name) => token === name || token.endsWith(`/${name}`));\n292: }\n293: \n294: // env launches the command after its own assignments and flags, so those words\n295: // say nothing about what runs. The same holds for a leading assignment.\n296: function commandWords(words) {\n297:   let index = 0;\n298:   while (index < words.length && COMMAND_PREFIXES.has(words[index].text)) index += 1;\n299:   while (index < words.length && ASSIGNMENT.test(words[index].text)) index += 1;\n300:   if (index < words.length && isEnvExecutable(words[index].text)) {\n301:     index += 1;\n302:     while (index < words.length\n303:       && (ASSIGNMENT.test(words[index].text) || words[index].text.startsWith('-'))) {\n304:       index += ENV_FLAGS_WITH_ARGUMENT.has(words[index].text) ? 2 : 1;\n305:     }\n306:   }\n307:   return words.slice(index);\n308: }\n309: \n310: function runsNodeOnMarker(words, marker) {\n311:   const rest = commandWords(words);\n312:   if (rest.length === 0 || !isNodeExecutable(rest[0].text)) return false;\n313:   let index = 1;\n314:   while (index < rest.length && rest[index].text.startsWith('-')) {\n315:     const flag = rest[index].text;\n316:     if (nodeFlagSkipsScript(flag)) return false;\n317:     index += NODE_FLAGS_WITH_ARGUMENT.has(flag) ? 2 : 1;\n318:   }\n319:   return index < rest.length && rest[index].text.endsWith(marker);\n320: }\n321: \n322: // bash -c and its login, sh and zsh forms hand the next word to a shell as a\n323: // script, so that word is read again as commands. No other word is.\n324: function scriptWord(words) {\n325:   const rest = commandWords(words);\n326:   if (rest.length < 2 || !isShellExecutable(rest[0].text)) return null;\n327:   // The first word that is not a flag is a script file, and what follows it\n328:   // belongs to that script.\n329:   for (let index = 1; index < rest.length - 1; index += 1) {\n330:     const flag = rest[index].text;\n331:     if (!flag.startsWith('-')) return null;\n332:     if (!flag.startsWith('--') && flag.slice(1).includes('c')) {\n333:       return rest[index + 1];\n334:     }\n335:   }\n336:   return null;\n337: }\n338: \n339: // An argument that only names node, as `echo node <script>` does, runs\n340: // nothing, so node must stand where a shell starts a command.\n341: function runsMarker(command, marker, depth = 0) {\n342:   return simpleCommands(readWords(command)).some((words) => {\n343:     if (runsNodeOnMarker(words, marker)) return true;\n344:     if (depth >= 2) return false;\n345:     const script = scriptWord(words);\n346:     return script !== null && runsMarker(script.text, marker, depth + 1);\n347:   });\n348: }\n349: \n350: function inspect(runtime, root) {\n351:   const file = path.join(root, runtime.file);\n352:   // A toml hook file is text rather than JSON, so the line reader reads it.\n353:   if (runtime.format === 'toml') {\n354:     let text;\n355:     try {\n356:       text = fs.readFileSync(file, 'utf8');\n357:     } catch {\n358:       return { runtime: runtime.id, file: runtime.file, status: 'hook-missing' };\n359:     }\n360:     const wired = tomlCommands(text, runtime.event).some((command) => runsMarker(command, runtime.marker));\n361:     return { runtime: runtime.id, file: runtime.file, status: wired ? 'ok' : 'hook-missing' };\n362:   }\n363:   let document;\n364:   try {\n365:     document = JSON.parse(fs.readFileSync(file, 'utf8'));\n366:   } catch {\n367:     return { runtime: runtime.id, file: runtime.file, status: 'hook-missing' };\n368:   }\n369:   const payload = eventPayload(document, runtime.event);\n370:   const wired = collectCommands(payload, []).some((command) => runsMarker(command, runtime.marker));\n371:   return { runtime: runtime.id, file: runtime.file, status: wired ? 'ok' : 'hook-missing' };\n372: }\n373: \n374: // ─────────────────────────────────────────────────────────────────────────────\n375: // 4. MAIN\n376: // ─────────────────────────────────────────────────────────────────────────────\n377: \n378: function main(argv) {\n379:   const opts = parseArgs(argv);\n380:   const checks = RUNTIMES.map((runtime) => {\n381:     if (!fs.existsSync(path.join(opts.root, runtime.dir))) {\n382:       return { runtime: runtime.id, file: runtime.file, status: 'skipped' };\n383:     }\n384:     return inspect(runtime, opts.root);\n385:   });\n386: \n387:   if (opts.json) {\n388:     process.stdout.write(`${JSON.stringify({ root: opts.root, checks }, null, 2)}\\n`);\n389:   } else {\n390:     for (const check of checks) {\n391:       if (check.status === 'ok') process.stdout.write(`ok ${check.runtime}\\n`);\n392:       else if (check.status === 'hook-missing') process.stdout.write(`hook-missing ${check.runtime} ${check.file}\\n`);\n393:     }\n394:   }\n395: \n396:   return checks.some((check) => check.status === 'hook-missing') ? 1 : 0;\n397: }\n398: \n399: if (require.main === module) {\n400:   try {\n401:     process.exitCode = main(process.argv.slice(2));\n402:   } catch (err) {\n403:     process.stderr.write(`hook-wiring-check: ${err && err.message ? err.message : String(err)}\\n`);\n404:     process.exitCode = 2;\n405:   }\n406: }\n407: \n408: module.exports = { main, eventPayload };","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file .skilled/commands/doctor/scripts/hook-wiring-check.cjs, lines 1-408\n1: #!/usr/bin/env node\n2: // ───────────────────────────────────────────────────────────────────\n3: // MODULE: Hook Wiring Check\n4: // ───────────────────────────────────────────────────────────────────\n5: 'use strict';\n6: \n7: // Read-only /doctor diagnostic for the prompt hook entry each runtime loads.\n8: //\n9: // WHY THIS EXISTS: the skill advisor reaches a first prompt only through the hook\n10: // entry a runtime fires before the model sees that prompt. A runtime folder can be\n11: // installed while its hook file is missing, its JSON is unreadable, or the entry\n12: // was never added, and then the advisor is silent with no error at session start.\n13: // This check names the runtime and the file to repair.\n14: //\n15: // Never writes. Exit 0 when every installed runtime carries its entry, 1 when one\n16: // is missing, 2 on a bad argument or a missing root.\n17: \n18: // ─────────────────────────────────────────────────────────────────────────────\n19: // 1. IMPORTS\n20: // ─────────────────────────────────────────────────────────────────────────────\n21: \n22: const fs = require('node:fs');\n23: const path = require('node:path');\n24: \n25: // ─────────────────────────────────────────────────────────────────────────────\n26: // 2. CONSTANTS\n27: // ─────────────────────────────────────────────────────────────────────────────\n28: \n29: const USAGE = [\n30:   'Usage: hook-wiring-check.cjs --root <dir> [--json]',\n31:   '  --root  check the checkout under <dir>.',\n32:   '  --json  print one JSON object instead of one line per runtime.',\n33: ].join('\\n');\n34: \n35: // Each entry names the runtime folder that decides whether the check applies,\n36: // the hook file inside it, the event that carries the prompt entry, and the path\n37: // fragment whose presence proves the entry is wired. A runtime folder that is\n38: // absent is skipped, because that runtime was never installed in this checkout.\n39: // A `toml` entry is read line by line, because the repository installs no TOML parser.\n40: const RUNTIMES = [\n41:   {\n42:     id: 'claude',\n43:     dir: '.claude',\n44:     file: '.claude/settings.json',\n45:     event: 'UserPromptSubmit',\n46:     marker: 'hooks/claude/user-prompt-submit.js',\n47:   },\n48:   {\n49:     id: 'codex',\n50:     dir: '.codex',\n51:     file: '.codex/hooks.json',\n52:     event: 'UserPromptSubmit',\n53:     marker: 'hooks/codex/user-prompt-submit.js',\n54:   },\n55:   {\n56:     id: 'cursor',\n57:     dir: '.cursor',\n58:     file: '.cursor/hooks.json',\n59:     event: 'beforeSubmitPrompt',\n60:     marker: 'hooks/cursor/user-prompt-submit.js',\n61:   },\n62:   {\n63:     id: 'devin',\n64:     dir: '.devin',\n65:     file: '.devin/hooks.v1.json',\n66:     event: 'UserPromptSubmit',\n67:     marker: 'hooks/devin/user-prompt-submit.js',\n68:   },\n69:   {\n70:     id: 'vibe',\n71:     dir: '.vibe',\n72:     file: '.vibe/hooks.toml',\n73:     event: 'pre_agent',\n74:     marker: 'hooks/session-lifecycle/vibe/turn-start.mjs',\n75:     format: 'toml',\n76:   },\n77: ];\n78: \n79: // ─────────────────────────────────────────────────────────────────────────────\n80: // 3. HELPERS\n81: // ─────────────────────────────────────────────────────────────────────────────\n82: \n83: function fail(message) {\n84:   process.stderr.write(`hook-wiring-check: ${message}\\n`);\n85:   process.exit(2);\n86: }\n87: \n88: function parseArgs(argv) {\n89:   const opts = { root: null, json: false };\n90:   for (let i = 0; i < argv.length; i += 1) {\n91:     const arg = argv[i];\n92:     if (arg === '--json') {\n93:       opts.json = true;\n94:     } else if (arg === '--root') {\n95:       const value = argv[i + 1];\n96:       if (!value || value.startsWith('-')) fail(`--root needs a directory\\n${USAGE}`);\n97:       opts.root = path.resolve(value);\n98:       i += 1;\n99:     } else {\n100:       fail(`unknown argument: ${arg}\\n${USAGE}`);\n101:     }\n102:   }\n103:   if (!opts.root) fail(`--root is required\\n${USAGE}`);\n104:   if (!fs.existsSync(opts.root) || !fs.statSync(opts.root).isDirectory()) {\n105:     fail(`root not found: ${opts.root}`);\n106:   }\n107:   return opts;\n108: }\n109: \n110: // Hook files either wrap their events in a `hooks` object or place them at the\n111: // top level, and the cursor file omits the nested hook array the others carry.\n112: // A mention is not a wired hook, so only a command that runs the script counts:\n113: // the event's entries and their nested hooks arrays are walked for command\n114: // entries, and a runtime is wired when one starts node on the marker path.\n115: function eventPayload(document, event) {\n116:   if (!document || typeof document !== 'object') return undefined;\n117:   if (document.hooks && typeof document.hooks === 'object' && event in document.hooks) {\n118:     return document.hooks[event];\n119:   }\n120:   if (event in document) return document[event];\n121:   return undefined;\n122: }\n123: \n124: // A shell groups quoted text into one word and ends a simple command at an\n125: // operator that stands outside quotes, even one stuck to the word before it.\n126: // Reading the words first keeps an echo of a quoted script a mention, because a\n127: // quoted word is only an argument unless a shell is told to run it.\n128: function readWords(command) {\n129:   const words = [];\n130:   let text = '';\n131:   let started = false;\n132: \n133:   function flush() {\n134:     if (!started) return;\n135:     words.push({ text, separator: false });\n136:     text = '';\n137:     started = false;\n138:   }\n139: \n140:   for (let i = 0; i < command.length; i += 1) {\n141:     const char = command[i];\n142:     if (char === \"'\" || char === '\"') {\n143:       started = true;\n144:       i += 1;\n145:       // A shell refuses a line whose quote never closes, so nothing in it runs.\n146:       if (command.indexOf(char, i) === -1) return [];\n147:       while (i < command.length && command[i] !== char) {\n148:         if (char === '\"' && command[i] === '\\\\' && i + 1 < command.length) {\n149:           text += command[i + 1];\n150:           i += 2;\n151:         } else {\n152:           text += command[i];\n153:           i += 1;\n154:         }\n155:       }\n156:       continue;\n157:     }\n158:     if (char === '\\\\') {\n159:       // A backslash before a line break joins the two lines and adds nothing.\n160:       if (command[i + 1] === '\\n') {\n161:         i += 1;\n162:       } else if (i + 1 < command.length) {\n163:         text += command[i + 1];\n164:         started = true;\n165:         i += 1;\n166:       }\n167:       continue;\n168:     }\n169:     // A comment runs from an unquoted # at the start of a word to the line end.\n170:     if (char === '#' && !started) {\n171:       while (i + 1 < command.length && command[i + 1] !== '\\n') i += 1;\n172:       continue;\n173:     }\n174:     if (char === '\\n') {\n175:       flush();\n176:       words.push({ text: char, separator: true });\n177:       continue;\n178:     }\n179:     const pair = command.slice(i, i + 2);\n180:     if (pair === '&&' || pair === '||') {\n181:       flush();\n182:       words.push({ text: pair, separator: true });\n183:       i += 1;\n184:       continue;\n185:     }\n186:     if (char === ';' || char === '|' || char === '&' || char === '(' || char === ')') {\n187:       flush();\n188:       words.push({ text: char, separator: true });\n189:       continue;\n190:     }\n191:     if (/\\s/.test(char)) {\n192:       flush();\n193:       continue;\n194:     }\n195:     text += char;\n196:     started = true;\n197:   }\n198:   flush();\n199:   return words;\n200: }\n201: \n202: function simpleCommands(words) {\n203:   const commands = [];\n204:   let current = [];\n205:   for (const word of words) {\n206:     if (word.separator) {\n207:       if (current.length > 0) commands.push(current);\n208:       current = [];\n209:     } else {\n210:       current.push(word);\n211:     }\n212:   }\n213:   if (current.length > 0) commands.push(current);\n214:   return commands;\n215: }\n216: \n217: function collectCommands(node, commands) {\n218:   if (Array.isArray(node)) {\n219:     for (const entry of node) collectCommands(entry, commands);\n220:   } else if (node && typeof node === 'object') {\n221:     if (node.type === 'command' && typeof node.command === 'string') commands.push(node.command);\n222:     if (Array.isArray(node.hooks)) collectCommands(node.hooks, commands);\n223:   }\n224:   return commands;\n225: }\n226: \n227: // A TOML hook file groups its entries under `[[hooks]]` headers rather than a\n228: // JSON key, and no TOML parser is installed here, so each block is read line by\n229: // line. A commented line names nothing that runs, so it is skipped. A basic\n230: // string value escapes the quote and backslash after it, so both are unescaped.\n231: // A header ends the block before it, so a commented header or another table never\n232: // lends its keys to a hooks block.\n233: function tomlCommands(text, event) {\n234:   const blocks = [];\n235:   let current = null;\n236:   for (const line of text.split('\\n')) {\n237:     const trimmed = line.trim();\n238:     if (trimmed.startsWith('[')) {\n239:       const header = trimmed.replace(/#.*$/, '').replace(/\\s/g, '');\n240:       if (header === '[[hooks]]') {\n241:         current = {};\n242:         blocks.push(current);\n243:       } else {\n244:         current = null;\n245:       }\n246:       continue;\n247:     }\n248:     if (current === null || trimmed.startsWith('#')) continue;\n249:     const entry = /^(type|command)\\s*=\\s*\"(.*)\"$/.exec(trimmed);\n250:     if (!entry) continue;\n251:     current[entry[1]] = entry[2].replace(/\\\\([\"\\\\])/g, '$1');\n252:   }\n253:   return blocks\n254:     .filter((block) => block.type === event && typeof block.command === 'string')\n255:     .map((block) => block.command);\n256: }\n257: \n258: const ASSIGNMENT = /^[A-Za-z_][A-Za-z0-9_]*=/;\n259: \n260: // Flags whose next word is their own argument, so that word is not the command.\n261: const ENV_FLAGS_WITH_ARGUMENT = new Set(['-u', '--unset', '-C', '--chdir']);\n262: const NODE_FLAGS_WITH_ARGUMENT = new Set([\n263:   '-r', '--require', '--import', '--loader', '--experimental-loader', '-C', '--conditions',\n264: ]);\n265: // Flags that make node do something other than run the script it is given.\n266: const NODE_FLAGS_WITHOUT_RUN = new Set([\n267:   '-c', '--check', '-e', '--eval', '-p', '--print', '-v', '--version', '-h', '--help',\n268: ]);\n269: // A flag can carry its value in the same word, after an equals sign for a long\n270: // flag and directly after the letter for a short one, so the name is read first.\n271: function nodeFlagSkipsScript(flag) {\n272:   if (flag.startsWith('--')) return NODE_FLAGS_WITHOUT_RUN.has(flag.split('=')[0]);\n273:   if (NODE_FLAGS_WITHOUT_RUN.has(flag)) return true;\n274:   // A short preload flag takes the rest of its word as the module name.\n275:   if (/^-[rC]/.test(flag)) return false;\n276:   return /^-[a-zA-Z]*[cepvh]/.test(flag);\n277: }\n278: \n279: // Words that open a group or hand over the shell and leave the command after them.\n280: const COMMAND_PREFIXES = new Set(['{', 'exec', 'command', 'nohup', 'time', 'then', 'do', 'else']);\n281: \n282: function isNodeExecutable(token) {\n283:   return token === 'node' || token.endsWith('/node');\n284: }\n285: \n286: function isEnvExecutable(token) {\n287:   return token === 'env' || token.endsWith('/env');\n288: }\n289: \n290: function isShellExecutable(token) {\n291:   return ['bash', 'sh', 'zsh'].some((name) => token === name || token.endsWith(`/${name}`));\n292: }\n293: \n294: // env launches the command after its own assignments and flags, so those words\n295: // say nothing about what runs. The same holds for a leading assignment.\n296: function commandWords(words) {\n297:   let index = 0;\n298:   while (index < words.length && COMMAND_PREFIXES.has(words[index].text)) index += 1;\n299:   while (index < words.length && ASSIGNMENT.test(words[index].text)) index += 1;\n300:   if (index < words.length && isEnvExecutable(words[index].text)) {\n301:     index += 1;\n302:     while (index < words.length\n303:       && (ASSIGNMENT.test(words[index].text) || words[index].text.startsWith('-'))) {\n304:       index += ENV_FLAGS_WITH_ARGUMENT.has(words[index].text) ? 2 : 1;\n305:     }\n306:   }\n307:   return words.slice(index);\n308: }\n309: \n310: function runsNodeOnMarker(words, marker) {\n311:   const rest = commandWords(words);\n312:   if (rest.length === 0 || !isNodeExecutable(rest[0].text)) return false;\n313:   let index = 1;\n314:   while (index < rest.length && rest[index].text.startsWith('-')) {\n315:     const flag = rest[index].text;\n316:     if (nodeFlagSkipsScript(flag)) return false;\n317:     index += NODE_FLAGS_WITH_ARGUMENT.has(flag) ? 2 : 1;\n318:   }\n319:   return index < rest.length && rest[index].text.endsWith(marker);\n320: }\n321: \n322: // bash -c and its login, sh and zsh forms hand the next word to a shell as a\n323: // script, so that word is read again as commands. No other word is.\n324: function scriptWord(words) {\n325:   const rest = commandWords(words);\n326:   if (rest.length < 2 || !isShellExecutable(rest[0].text)) return null;\n327:   // The first word that is not a flag is a script file, and what follows it\n328:   // belongs to that script.\n329:   for (let index = 1; index < rest.length - 1; index += 1) {\n330:     const flag = rest[index].text;\n331:     if (!flag.startsWith('-')) return null;\n332:     if (!flag.startsWith('--') && flag.slice(1).includes('c')) {\n333:       return rest[index + 1];\n334:     }\n335:   }\n336:   return null;\n337: }\n338: \n339: // An argument that only names node, as `echo node <script>` does, runs\n340: // nothing, so node must stand where a shell starts a command.\n341: function runsMarker(command, marker, depth = 0) {\n342:   return simpleCommands(readWords(command)).some((words) => {\n343:     if (runsNodeOnMarker(words, marker)) return true;\n344:     if (depth >= 2) return false;\n345:     const script = scriptWord(words);\n346:     return script !== null && runsMarker(script.text, marker, depth + 1);\n347:   });\n348: }\n349: \n350: function inspect(runtime, root) {\n351:   const file = path.join(root, runtime.file);\n352:   // A toml hook file is text rather than JSON, so the line reader reads it.\n353:   if (runtime.format === 'toml') {\n354:     let text;\n355:     try {\n356:       text = fs.readFileSync(file, 'utf8');\n357:     } catch {\n358:       return { runtime: runtime.id, file: runtime.file, status: 'hook-missing' };\n359:     }\n360:     const wired = tomlCommands(text, runtime.event).some((command) => runsMarker(command, runtime.marker));\n361:     return { runtime: runtime.id, file: runtime.file, status: wired ? 'ok' : 'hook-missing' };\n362:   }\n363:   let document;\n364:   try {\n365:     document = JSON.parse(fs.readFileSync(file, 'utf8'));\n366:   } catch {\n367:     return { runtime: runtime.id, file: runtime.file, status: 'hook-missing' };\n368:   }\n369:   const payload = eventPayload(document, runtime.event);\n370:   const wired = collectCommands(payload, []).some((command) => runsMarker(command, runtime.marker));\n371:   return { runtime: runtime.id, file: runtime.file, status: wired ? 'ok' : 'hook-missing' };\n372: }\n373: \n374: // ─────────────────────────────────────────────────────────────────────────────\n375: // 4. MAIN\n376: // ─────────────────────────────────────────────────────────────────────────────\n377: \n378: function main(argv) {\n379:   const opts = parseArgs(argv);\n380:   const checks = RUNTIMES.map((runtime) => {\n381:     if (!fs.existsSync(path.join(opts.root, runtime.dir))) {\n382:       return { runtime: runtime.id, file: runtime.file, status: 'skipped' };\n383:     }\n384:     return inspect(runtime, opts.root);\n385:   });\n386: \n387:   if (opts.json) {\n388:     process.stdout.write(`${JSON.stringify({ root: opts.root, checks }, null, 2)}\\n`);\n389:   } else {\n390:     for (const check of checks) {\n391:       if (check.status === 'ok') process.stdout.write(`ok ${check.runtime}\\n`);\n392:       else if (check.status === 'hook-missing') process.stdout.write(`hook-missing ${check.runtime} ${check.file}\\n`);\n393:     }\n394:   }\n395: \n396:   return checks.some((check) => check.status === 'hook-missing') ? 1 : 0;\n397: }\n398: \n399: if (require.main === module) {\n400:   try {\n401:     process.exitCode = main(process.argv.slice(2));\n402:   } catch (err) {\n403:     process.stderr.write(`hook-wiring-check: ${err && err.message ? err.message : String(err)}\\n`);\n404:     process.exitCode = 2;\n405:   }\n406: }\n407: \n408: module.exports = { main, eventPayload };"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\".skilled/commands/doctor/scripts/hook-wiring-check.cjs\"}"},"time":{"start":1794760746850,"end":1794760747086}}}}
