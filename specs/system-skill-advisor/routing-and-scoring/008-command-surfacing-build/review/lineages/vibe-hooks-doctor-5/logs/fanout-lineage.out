{"type":"tool_use","timestamp":1794761058743,"sessionID":"ses_e1feefdd5ffeHQJCqAmpoKpkZG","part":{"partID":"prt_1e01867c6001q8pdv3cgaqHror","sessionID":"ses_e1feefdd5ffeHQJCqAmpoKpkZG","messageID":"msg_1e01857f1001Czkmh2t251T70n","type":"tool","id":"call_e6861f61f7f14f3a94b5d0f7","tool":"shell","state":{"status":"completed","input":{"command":"git diff db14c22bb0..HEAD -- .skilled/commands/doctor/scripts/tests/doctor-runtime-mirrors-contract.test.cjs .skilled/skills/system-skill-advisor/runtime/tests/hooks/claude-user-prompt-submit-hook.vitest.ts .skilled/commands/doctor/scripts/tests/hook-wiring-check.test.cjs"},"output":"diff --git a/.skilled/commands/doctor/scripts/tests/doctor-runtime-mirrors-contract.test.cjs b/.skilled/commands/doctor/scripts/tests/doctor-runtime-mirrors-contract.test.cjs\nindex 9b0f4f3e295..846cefe9125 100644\n--- a/.skilled/commands/doctor/scripts/tests/doctor-runtime-mirrors-contract.test.cjs\n+++ b/.skilled/commands/doctor/scripts/tests/doctor-runtime-mirrors-contract.test.cjs\n@@ -11,7 +11,7 @@\n  * omits is the failure mode worth a test, because a local run then reports in\n  * sync while the remote run fails on the same tree.\n  *\n- * DSH checks are asserted in the shape their neighbours use,\n+ * DSH and Vibe checks are asserted in the shape their neighbours use,\n  * including the n/a rule: an absent runtime tree is reported as n/a rather than\n  * created, so a read-only diagnostic never has a write side effect.\n  *\n@@ -65,7 +65,27 @@ const DSH_CHECKS = [\n     tree: '.dsh/',\n   },\n ];\n-const MIRROR_CHECKS = DSH_CHECKS;\n+const VIBE_CHECKS = [\n+  {\n+    key: 'vibe_prompts',\n+    script: '.skilled/skills/system-spec-kit/runtime/cli/vibe/sync-prompts-vibe.cjs',\n+    surface: '.vibe/prompts',\n+    tree: '.vibe/',\n+  },\n+  {\n+    key: 'vibe_agents',\n+    script: '.skilled/skills/system-spec-kit/runtime/cli/vibe/sync-agents-vibe.cjs',\n+    surface: '.vibe/agents',\n+    tree: '.vibe/',\n+  },\n+  {\n+    key: 'vibe_skills',\n+    script: '.skilled/skills/system-spec-kit/runtime/cli/vibe/sync-skills-vibe.cjs',\n+    surface: '.vibe/skills',\n+    tree: '.vibe/',\n+  },\n+];\n+const MIRROR_CHECKS = [...DSH_CHECKS, ...VIBE_CHECKS];\n \n // ─────────────────────────────────────────────────────────────────────────────\n // 2. READERS AND SMALL HELPERS\ndiff --git a/.skilled/commands/doctor/scripts/tests/hook-wiring-check.test.cjs b/.skilled/commands/doctor/scripts/tests/hook-wiring-check.test.cjs\nindex f40048275c2..ea8e27b0129 100644\n--- a/.skilled/commands/doctor/scripts/tests/hook-wiring-check.test.cjs\n+++ b/.skilled/commands/doctor/scripts/tests/hook-wiring-check.test.cjs\n@@ -21,6 +21,8 @@ const test = require('node:test');\n const SCRIPT = path.resolve(__dirname, '..', 'hook-wiring-check.cjs');\n const CLAUDE_FILE = '.claude/settings.json';\n const CLAUDE_MARKER = '.skilled/skills/system-spec-kit/runtime/dist/hooks/claude/user-prompt-submit.js';\n+const VIBE_FILE = '.vibe/hooks.toml';\n+const VIBE_COMMAND = 'node \\\\\"$(git rev-parse --show-toplevel)/.skilled/hooks/session-lifecycle/vibe/turn-start.mjs\\\\\"';\n \n function fixture(t) {\n   const root = fs.mkdtempSync(path.join(os.tmpdir(), 'hook-wiring-check-'));\n@@ -37,6 +39,23 @@ function writeClaudeSettings(root, hooks) {\n   fs.writeFileSync(path.join(root, CLAUDE_FILE), JSON.stringify({ hooks }, null, 2));\n }\n \n+function writeVibeHooks(root, text) {\n+  fs.mkdirSync(path.join(root, '.vibe'), { recursive: true });\n+  fs.writeFileSync(path.join(root, VIBE_FILE), text);\n+}\n+\n+// The Vibe hook file is TOML, so one block is built as the lines the check reads.\n+function vibeBlock(type, commandLine) {\n+  return [\n+    '[[hooks]]',\n+    'name = \"turn-start\"',\n+    `type = \"${type}\"`,\n+    'match = \"main\"',\n+    'timeout = 20.0',\n+    commandLine,\n+  ].join('\\n');\n+}\n+\n // ─────────────────────────────────────────────────────────────────────────────\n // 2. TESTS\n // ─────────────────────────────────────────────────────────────────────────────\n@@ -212,6 +231,88 @@ test('names a runtime whose entry echoes a quoted command', (t) => {\n   assert.match(result.out, /^hook-missing claude \\.claude\\/settings\\.json$/m);\n });\n \n+// Vibe keeps its hooks in TOML and only a `pre_agent` entry that starts node on\n+// the turn-start script runs before the prompt, so each shape below must not count.\n+test('passes the Vibe turn-start entry under pre_agent', (t) => {\n+  const f = fixture(t);\n+  writeVibeHooks(f.root, vibeBlock('pre_agent', 'command = \"' + VIBE_COMMAND + '\"'));\n+  const text = f.run();\n+  assert.equal(text.code, 0);\n+  assert.equal(text.out.trim(), 'ok vibe');\n+});\n+\n+test('names Vibe when its turn-start entry runs under post_agent', (t) => {\n+  const f = fixture(t);\n+  writeVibeHooks(f.root, vibeBlock('post_agent', 'command = \"' + VIBE_COMMAND + '\"'));\n+  const result = f.run();\n+  assert.equal(result.code, 1);\n+  assert.match(result.out, /^hook-missing vibe \\.vibe\\/hooks\\.toml$/m);\n+});\n+\n+test('names Vibe when its turn-start command is commented out', (t) => {\n+  const f = fixture(t);\n+  writeVibeHooks(f.root, vibeBlock(\n+    'pre_agent',\n+    '# command = \"' + VIBE_COMMAND + '\"\\ncommand = \"node other-hook.mjs\"',\n+  ));\n+  const result = f.run();\n+  assert.equal(result.code, 1);\n+  assert.match(result.out, /^hook-missing vibe /m);\n+});\n+\n+test('names Vibe when only a name mentions the script', (t) => {\n+  const f = fixture(t);\n+  const block = vibeBlock('pre_agent', 'command = \"node other-hook.mjs\"')\n+    .replace('name = \"turn-start\"', 'name = \"hooks/session-lifecycle/vibe/turn-start.mjs\"');\n+  writeVibeHooks(f.root, block);\n+  const result = f.run();\n+  assert.equal(result.code, 1);\n+  assert.match(result.out, /^hook-missing vibe /m);\n+});\n+\n+test('names Vibe when its folder holds no hooks file', (t) => {\n+  const f = fixture(t);\n+  fs.mkdirSync(path.join(f.root, '.vibe'), { recursive: true });\n+  const result = f.run();\n+  assert.equal(result.code, 1);\n+  assert.match(result.out, /^hook-missing vibe /m);\n+});\n+\n+test('reads a commented hooks header as the start of the next block', (t) => {\n+  const f = fixture(t);\n+  writeVibeHooks(f.root, [\n+    vibeBlock('pre_agent', 'command = \"' + VIBE_COMMAND + '\"'),\n+    '[[hooks]]  # turn end',\n+    'name = \"turn-end\"',\n+    'type = \"post_agent\"',\n+    'command = \"node other-hook.mjs\"',\n+  ].join('\\n'));\n+  const text = f.run();\n+  assert.equal(text.code, 0);\n+  assert.equal(text.out.trim(), 'ok vibe');\n+});\n+\n+test(\"does not credit a later table's command to the hooks block before it\", (t) => {\n+  const f = fixture(t);\n+  writeVibeHooks(f.root, [\n+    vibeBlock('pre_agent', 'command = \"node other-hook.mjs\"'),\n+    '[[notes]]',\n+    'command = \"' + VIBE_COMMAND + '\"',\n+  ].join('\\n'));\n+  const result = f.run();\n+  assert.equal(result.code, 1);\n+  assert.match(result.out, /^hook-missing vibe \\.vibe\\/hooks\\.toml$/m);\n+});\n+\n+test('reads a spaced hooks header', (t) => {\n+  const f = fixture(t);\n+  writeVibeHooks(f.root, vibeBlock('pre_agent', 'command = \"' + VIBE_COMMAND + '\"')\n+    .replace('[[hooks]]', '[[ hooks ]]'));\n+  const text = f.run();\n+  assert.equal(text.code, 0);\n+  assert.equal(text.out.trim(), 'ok vibe');\n+});\n+\n test('skips a runtime whose folder is absent', (t) => {\n   const f = fixture(t);\n   const text = f.run();\n@@ -219,7 +320,7 @@ test('skips a runtime whose folder is absent', (t) => {\n   assert.equal(text.out, '');\n   const json = f.run('--json');\n   assert.equal(json.code, 0);\n-  assert.deepEqual(JSON.parse(json.out).checks.map((check) => check.status), ['skipped', 'skipped', 'skipped', 'skipped']);\n+  assert.deepEqual(JSON.parse(json.out).checks.map((check) => check.status), ['skipped', 'skipped', 'skipped', 'skipped', 'skipped']);\n });\n \n // Launch shapes a shell runs, each with node standing where a command starts.\ndiff --git a/.skilled/skills/system-skill-advisor/runtime/tests/hooks/claude-user-prompt-submit-hook.vitest.ts b/.skilled/skills/system-skill-advisor/runtime/tests/hooks/claude-user-prompt-submit-hook.vitest.ts\nindex 1c9d4fb58c6..8d9cfea8291 100644\n--- a/.skilled/skills/system-skill-advisor/runtime/tests/hooks/claude-user-prompt-submit-hook.vitest.ts\n+++ b/.skilled/skills/system-skill-advisor/runtime/tests/hooks/claude-user-prompt-submit-hook.vitest.ts\n@@ -18,6 +18,7 @@ import {\n } from '../../../hooks/claude/user-prompt-submit.js';\n import { DIRECTIVE_LIFECYCLE_DEDUP_ENV, InMemoryDirectiveLifecycleStore } from '../../../hooks/lib/directive-lifecycle.js';\n import { normalizeRuntimeOutput } from '../../lib/normalize-adapter-output.js';\n+import { clearPolicyObservationSink, getPolicyObservationRecords } from '../../lib/policy-plan.js';\n import { renderAdvisorBrief } from '../../lib/render.js';\n import { validateAdvisorHookDiagnosticRecord } from '../../lib/metrics.js';\n import type { AdvisorHookResult } from '../../lib/skill-advisor-brief.js';\n@@ -208,6 +209,41 @@ describe('Claude UserPromptSubmit advisor hook', () => {\n     expect(diagnostic.emittedBytes).toBe(Buffer.byteLength(additionalContext, 'utf8'));\n   });\n \n+  it.each([\n+    { runtime: 'claude' as const, label: 'Claude Code' },\n+    { runtime: 'pi' as const, label: 'pi' },\n+    { runtime: 'dsh' as const, label: 'dsh' },\n+    { runtime: 'vibe' as const, label: 'vibe' },\n+    { environmentRuntime: 'codex', label: 'codex' },\n+  ])('labels a recorded policy observation for $label', async ({ label, runtime, environmentRuntime }) => {\n+    if (environmentRuntime === undefined) delete process.env.SPECKIT_RUNTIME;\n+    else process.env.SPECKIT_RUNTIME = environmentRuntime;\n+\n+    clearPolicyObservationSink();\n+    const diagnostics = diagnosticsSink();\n+    const buildBrief = vi.fn(async () => fixture('livePassingSkill.json'));\n+    const dependencies = {\n+      buildBrief,\n+      renderBrief: renderAdvisorBrief,\n+      writeDiagnostic: diagnostics.writeDiagnostic,\n+      directiveLifecycleStore: new InMemoryDirectiveLifecycleStore(),\n+      ...(runtime === undefined ? {} : { runtime }),\n+    };\n+    // A startup event gives the shadow session its epoch, without which the\n+    // sink holds no record to read a label from.\n+    await handleClaudeUserPromptSubmit({\n+      session_id: `policy-label-${label}`,\n+      hook_event_name: 'UserPromptSubmit',\n+      prompt: 'implement a TypeScript hook',\n+      cwd: '/workspace/project',\n+      lifecycle_event: 'startup',\n+    }, dependencies);\n+\n+    const records = getPolicyObservationRecords();\n+    expect(records.length).toBeGreaterThan(0);\n+    expect(records.every((record) => record.binding.runtime === label)).toBe(true);\n+  });\n+\n   it('AS2 emits the skipped fallback head for an empty prompt skipped by the producer', async () => {\n     const { output, buildBrief } = await runHook({\n       session_id: 's1',\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"diff --git a/.skilled/commands/doctor/scripts/tests/doctor-runtime-mirrors-contract.test.cjs b/.skilled/commands/doctor/scripts/tests/doctor-runtime-mirrors-contract.test.cjs\nindex 9b0f4f3e295..846cefe9125 100644\n--- a/.skilled/commands/doctor/scripts/tests/doctor-runtime-mirrors-contract.test.cjs\n+++ b/.skilled/commands/doctor/scripts/tests/doctor-runtime-mirrors-contract.test.cjs\n@@ -11,7 +11,7 @@\n  * omits is the failure mode worth a test, because a local run then reports in\n  * sync while the remote run fails on the same tree.\n  *\n- * DSH checks are asserted in the shape their neighbours use,\n+ * DSH and Vibe checks are asserted in the shape their neighbours use,\n  * including the n/a rule: an absent runtime tree is reported as n/a rather than\n  * created, so a read-only diagnostic never has a write side effect.\n  *\n@@ -65,7 +65,27 @@ const DS