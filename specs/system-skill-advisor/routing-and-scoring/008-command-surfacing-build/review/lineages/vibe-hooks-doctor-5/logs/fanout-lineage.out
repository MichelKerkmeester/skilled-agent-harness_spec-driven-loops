{"type":"tool_use","timestamp":1794760628443,"sessionID":"ses_e1feefdd5ffeHQJCqAmpoKpkZG","part":{"partID":"prt_1e011d247001Z0WtKy1T9A2R0L","sessionID":"ses_e1feefdd5ffeHQJCqAmpoKpkZG","messageID":"msg_1e011c891001vpMPpmrfMdPN6H","type":"tool","id":"call_3feee3f4e3bf420e86d16540","tool":"read","state":{"status":"completed","input":{"path":".skilled/commands/deep/assets/deep-review.yaml","offset":340,"limit":280},"output":"Read file .skilled/commands/deep/assets/deep-review.yaml, lines 340-619\n340:             --stop-policy {stop_policy} \\\n341:             --convergence-mode {convergence_mode}\n342:         working_directory: \"{repo_root}\"\n343:         wait_for_completion: true\n344:         optional_flags: \"When lineage_timeout_hours is bound, append `--lineage-timeout-hours {lineage_timeout_hours}` to the command. When it is unset, append nothing, which keeps the 4 hour ceiling.\"\n345: \n346:   # ════════\n347:   # PHASE 1: INITIALIZATION\n348:   # ════════\n349:   phase_init:\n350:     purpose: Create all state files for the review session and resolve review scope\n351:     steps:\n352: \n353:       step_preflight_contract:\n354:         action: \"Validate required setup bindings and executable workflow contract before any file writes\"\n355:         verify:\n356:           - required_values_present: [review_target, review_target_type, review_dimensions, spec_folder, lineage_mode, max_iterations, convergence_threshold, convergence_mode, stop_policy]\n357:           - dry_run_normalized: \"Boolean true or false before workflow loading; absent flag resolves to false.\"\n358:           - spec_folder_is_within: \"specs/ or .opencode/specs/ (canonicalize alias roots before validation)\"\n359:           - unresolved_placeholders: \"FAIL if any user-facing template references placeholders not produced by earlier steps\"\n360:           - tool_contract: \"FAIL if executable steps reference tools outside the command allowlist\"\n361:         on_fail: \"Halt with STATUS=FAIL and report the missing binding or unsupported contract reference\"\n362: \n363:       step_create_directories:\n364:         action: \"Create spec folder and canonical review packet directories if they don't exist\"\n365:         dry_run_boundary: \"state-mutation\"\n366:         command: \"mkdir -p {state_paths.prompt_dir} {state_paths.iteration_dir} {state_paths.delta_dir}\"\n367: \n368:       step_detect_resource_map:\n369:         action: \"Detect resource-map.md before config creation so init can persist coverage-gate state\"\n370:         inspect:\n371:           - \"{spec_folder}/resource-map.md\"\n372:         classify:\n373:           present: \"resource-map.md exists at init\"\n374:           absent: \"resource-map.md does not exist at init\"\n375:         outputs:\n376:           - resource_map_present: \"Boolean true when {spec_folder}/resource-map.md exists, else false\"\n377:           - resource_map_known_context: \"When present: concise resource-map snapshot for Known Context and charter framing. When absent: 'resource-map.md not present; skipping coverage gate'.\"\n378: \n379:       step_migrate_legacy_review_state:\n380:         action: \"Rehome legacy review artifacts into review/iterations before session classification\"\n381:         dry_run_boundary: \"state-mutation\"\n382:         detect:\n383:           canonical_review_state:\n384:             - \"{state_paths.config}\"\n385:             - \"{state_paths.state_log}\"\n386:             - \"{state_paths.findings_registry}\"\n387:             - \"{state_paths.strategy}\"\n388:           legacy_review_state:\n389:             - \"{spec_folder}/scratch/deep-research-config.json\"\n390:             - \"{spec_folder}/scratch/deep-research-state.jsonl\"\n391:             - \"{spec_folder}/scratch/deep-review-strategy.md\"\n392:             - \"{spec_folder}/scratch/deep-review-dashboard.md\"\n393:             - \"{spec_folder}/scratch/iteration-*.md\"\n394:             - \"{spec_folder}/scratch/.deep-research-pause\"\n395:             - \"{state_paths.local_packet_dir}/iteration-*.md\"\n396:             - \"{state_paths.legacy_root_report}\"\n397:           legacy_review_markers:\n398:             - \"scratch/deep-review-strategy.md exists\"\n399:             - \"scratch/deep-research-config.json declares mode == 'review' OR scratch/deep-research-state.jsonl contains mode == 'review'\"\n400:         migrate_only:\n401:           - \"{spec_folder}/scratch/deep-research-config.json -> {state_paths.config}\"\n402:           - \"{spec_folder}/scratch/deep-research-state.jsonl -> {state_paths.state_log}\"\n403:           - \"{spec_folder}/scratch/deep-review-strategy.md -> {state_paths.strategy}\"\n404:           - \"{spec_folder}/scratch/deep-review-dashboard.md -> {state_paths.dashboard}\"\n405:           - \"{spec_folder}/scratch/iteration-*.md -> {state_paths.iteration_dir}/\"\n406:           - \"{spec_folder}/scratch/.deep-research-pause -> {state_paths.pause_sentinel}\"\n407:           - \"{state_paths.local_packet_dir}/iteration-*.md -> {state_paths.iteration_dir}/\"\n408:           - \"{state_paths.legacy_root_report} -> {state_paths.review_output}\"\n409:         on_canonical_present: \"Leave canonical review/ state untouched and do not overwrite it with legacy scratch artifacts.\"\n410:         on_legacy_detected: \"Move only the review-specific whitelist, print LEGACY_REVIEW_STATE_MOVED and leave unrelated scratch files untouched. Nothing is appended here: an append before session classification would create the state log and turn a fresh packet into a partial one, and the moved state log was written without the ledger, so the gateway refuses every append to it until step_classify_session.on_moved_legacy_state adopts it.\"\n411:         on_conflict: \"If canonical review/ state and legacy scratch review state both exist but disagree, halt for operator repair instead of merging contradictory state.\"\n412:         outputs:\n413:           - legacy_migration_detected: \"true when the command printed LEGACY_REVIEW_STATE_MOVED, else false\"\n414:           - migration_recorded: \"false; step_record_artifact_migration sets it once the migration row is appended\"\n415:         command: |\n416:           mkdir -p {state_paths.iteration_dir}\n417:           if [ ! -e {state_paths.config} ] && [ ! -e {state_paths.state_log} ] && [ ! -e {state_paths.strategy} ] && [ -e {spec_folder}/scratch/deep-review-strategy.md ] && ( [ -e {spec_folder}/scratch/deep-research-config.json ] || [ -e {spec_folder}/scratch/deep-research-state.jsonl ] ); then\n418:             [ -e {spec_folder}/scratch/deep-research-config.json ] && mv {spec_folder}/scratch/deep-research-config.json {state_paths.config}\n419:             [ -e {spec_folder}/scratch/deep-research-state.jsonl ] && mv {spec_folder}/scratch/deep-research-state.jsonl {state_paths.state_log}\n420:             [ -e {spec_folder}/scratch/deep-review-strategy.md ] && mv {spec_folder}/scratch/deep-review-strategy.md {state_paths.strategy}\n421:             [ -e {spec_folder}/scratch/deep-review-dashboard.md ] && mv {spec_folder}/scratch/deep-review-dashboard.md {state_paths.dashboard}\n422:             find {spec_folder}/scratch -maxdepth 1 -name 'iteration-*.md' -exec mv {} {state_paths.iteration_dir}/ \\;\n423:             [ -e {spec_folder}/scratch/.deep-research-pause ] && mv {spec_folder}/scratch/.deep-research-pause {state_paths.pause_sentinel}\n424:             [ -e {state_paths.legacy_root_report} ] && mv {state_paths.legacy_root_report} {state_paths.review_output}\n425:             echo \"LEGACY_REVIEW_STATE_MOVED\"\n426:           fi\n427:           find {state_paths.local_packet_dir} -maxdepth 1 -name 'iteration-*.md' -exec mv {} {state_paths.iteration_dir}/ \\; 2>/dev/null || true\n428: \n429:       step_acquire_lock:\n430:         action: \"Acquire the single-writer advisory lock before session classification\"\n431:         dry_run_boundary: \"state-mutation\"\n432:         ttl_ms: \"lock_ttl_ms = max(1800000, executor_timeout * 1000). executor_timeout is the bound dispatch timeout in seconds, 900 when unset. The lock is stale after twice this value, so it outlives the longest allowed dispatch.\"\n433:         command: \"node .skilled/skills/system-deep-loop/runtime/scripts/loop-lock.cjs acquire --lock-path {state_paths.lock_file} --packet-id {spec_folder} --ttl-ms {lock_ttl_ms}\"\n434:         on_acquire: \"Capture lock.ownerPid as captured_owner_pid and lock.acquireNonce as captured_acquire_nonce from the JSON output, and reuse both for every release below. If acquired=false, fail closed — another deep-review run already holds this packet. Under confirm, mode_overrides.confirm.lock_not_acquired applies instead.\"\n435:         note: \"Uses the promoted runtime/ loop-lock CLI (single source of truth: stale-lock reclaim, clean owner-scoped release). macOS/BSD locking is advisory — best-effort single-writer, not a hard mutex across host calls. Acquire reclaims a stale lock itself and reports the old holder under `reclaimed`. A lock is stale when its heartbeat is older than twice its TTL, or when its owning process is known to be dead. No confirmation step exists in either mode: log a `reclaimed` holder and continue.\"\n436:         # Lock-cleanup contract: the lock file MUST be released on every terminal exit path that follows acquisition.\n437:         # Runtimes honoring step_acquire_lock are required to perform this cleanup before halting or pausing.\n438:         on_halt:\n439:           action: \"Every terminal halt after the acquire runs step_release_lock before it returns control\"\n440:           command: \"node .skilled/skills/system-deep-loop/runtime/scripts/loop-lock.cjs release --lock-path {state_paths.lock_file} --owner-pid {captured_owner_pid} --nonce {captured_acquire_nonce}; failures here are logged but do not block the halt\"\n441:         on_cancel:\n442:           action: \"Release the lock on user cancel or pause-sentinel detection before sentinel processing\"\n443:           command: \"node .skilled/skills/system-deep-loop/runtime/scripts/loop-lock.cjs release --lock-path {state_paths.lock_file} --owner-pid {captured_owner_pid} --nonce {captured_acquire_nonce}; cancel completes regardless of cleanup result\"\n444:         on_workflow_exit:\n445:           action: \"Release the lock as the final step of any workflow exit path (success or failure)\"\n446:           command: \"node .skilled/skills/system-deep-loop/runtime/scripts/loop-lock.cjs release --lock-path {state_paths.lock_file} --owner-pid {captured_owner_pid} --nonce {captured_acquire_nonce}; idempotent — safe to invoke when already released\"\n447: \n448:       step_classify_session:\n449:         action: \"Classify the session before writing files\"\n450:         inspect:\n451:           - \"{state_paths.config}\"\n452:           - \"{state_paths.state_log}\"\n453:           - \"{state_paths.findings_registry}\"\n454:           - \"{state_paths.strategy}\"\n455:         classify:\n456:           fresh: \"None of the three state artifacts exist\"\n457:           resume: \"Config, JSONL, and strategy all exist and config.mode == 'review' and agree on target/spec folder\"\n458:           completed-session: \"Resume artifacts exist and config.status == 'complete'\"\n459:           invalid-state: \"Any partial, missing, or contradictory combination\"\n460:         outputs:\n461:           - session_state: \"fresh | resume | completed-session | invalid-state\"\n462:           - prior_tail_digest: \"sha256 of the state log bytes when resuming or restarting an existing lineage\"\n463:         lifecycle_routing:\n464:           - \"If lineage_mode == restart, step_apply_lifecycle_request archived the packet before the lock was taken, so session_state is fresh and on_fresh runs.\"\n465:           - \"If lineage_mode == auto or lineage_mode == resume, preserve the existing resume/completed/fresh behavior.\"\n466:         on_resume:\n467:           before_append: \"Run on_moved_legacy_state first when it applies.\"\n468:           log: \"Auto-resume: state artifacts are complete and consistent. Continue the same lineage (sessionId unchanged, generation unchanged, no archive).\"\n469:           append_jsonl: '{\"stem\":\"deep_review.run_resumed\",\"scope\":{\"runId\":\"{session_id}\",\"sessionId\":\"{session_id}\",\"generation\":{generation}},\"data\":{\"priorTailDigest\":\"{prior_tail_digest}\",\"sourceSessionId\":\"{session_id}\",\"resumeReason\":\"Auto-resume: state artifacts are complete and consistent; continue the same lineage.\",\"continuedFromRunId\":\"{session_id}-i{iteration_count}\",\"compatibilityDecision\":\"exact\",\"recoveryReceiptRef\":\"none\"}}'\n470:           skip_to: phase_loop\n471:           confirm_choice:\n472:             applies_to: confirm\n473:             preempts: \"Under confirm this block runs in place of the sibling log, append_jsonl and skip_to keys of on_resume. Under auto it is skipped and those keys run.\"\n474:             show_dashboard: \"{state_paths.dashboard}\"\n475:             ask: \"Existing review session is consistent. Resume where it left off, or restart (archive the current review packet under the root-level review-archive/ tree and start a fresh session)?\"\n476:             after_gate_refresh_lock: gate_defaults.after_gate_refresh_lock\n477:             options: [resume, restart, cancel]\n478:             on_resume_choice:\n479:               dry_run_boundary: \"state-mutation\"\n480:               before_append: \"Run on_moved_legacy_state first when it applies.\"\n481:               set:\n482:                 lineage_mode: \"resume\"\n483:                 parent_session_id: \"{session_id}\"\n484:               append_jsonl: '{\"stem\":\"deep_review.run_resumed\",\"scope\":{\"runId\":\"{session_id}\",\"sessionId\":\"{session_id}\",\"generation\":{generation}},\"data\":{\"priorTailDigest\":\"{prior_tail_digest}\",\"sourceSessionId\":\"{session_id}\",\"resumeReason\":\"Auto-resume: state artifacts are complete and consistent; continue the same lineage.\",\"continuedFromRunId\":\"{session_id}-i{iteration_count}\",\"compatibilityDecision\":\"exact\",\"recoveryReceiptRef\":\"none\"}}'\n485:               skip_to: gate_init_approval\n486:             on_restart_choice:\n487:               dry_run_boundary: \"state-mutation\"\n488:               bind_prior_lineage:\n489:                 action: \"Read the session id and generation of the packet that is about to be archived\"\n490:                 command: |\n491:                   node -e '\n492:                     const fs = require(\"fs\");\n493:                     const crypto = require(\"crypto\");\n494:                     let priorSessionId = null;\n495:                     let priorGeneration = 0;\n496:                     try {\n497:                       const config = JSON.parse(fs.readFileSync(process.argv[1], \"utf8\"));\n498:                       const lineage = config.lineage || config;\n499:                       priorSessionId = typeof lineage.sessionId === \"string\" ? lineage.sessionId : null;\n500:                       priorGeneration = Number(lineage.generation) || 0;\n501:                     } catch (error) {\n502:                       if (error.code !== \"ENOENT\") {\n503:                         console.error(\"The old config cannot be read: \" + error.message);\n504:                         process.exit(1);\n505:                       }\n506:                     }\n507:                     let priorTailDigest = crypto.createHash(\"sha256\").update(\"\").digest(\"hex\");\n508:                     try {\n509:                       priorTailDigest = crypto.createHash(\"sha256\").update(fs.readFileSync(process.argv[2])).digest(\"hex\");\n510:                     } catch (error) {\n511:                       if (error.code !== \"ENOENT\") throw error;\n512:                     }\n513:                     console.log(JSON.stringify({ priorSessionId, priorGeneration, priorTailDigest }));\n514:                   ' \"{state_paths.config}\" \"{state_paths.state_log}\"\n515:                 outputs:\n516:                   - prior_session_id: \"priorSessionId from the JSON output, null when no old config exists\"\n517:                   - prior_generation: \"priorGeneration from the JSON output, 0 when no old config exists\"\n518:                   - prior_tail_digest: \"priorTailDigest from the JSON output: the sha256 of the old state log bytes, or of zero bytes when no old state log exists\"\n519:                 on_fail: \"Halt with STATUS=FAIL through step_release_lock. The old config is unreadable, so repair or archive the packet by hand.\"\n520:               command: |\n521:                 if [ -e \"{state_paths.archive_root}/{timestamp_slug}\" ]; then\n522:                   echo \"The archive folder {state_paths.archive_root}/{timestamp_slug} is already there.\" >&2\n523:                   exit 1\n524:                 fi\n525:                 mkdir -p \"{state_paths.archive_root}/{timestamp_slug}\" || exit 1\n526:                 find \"{state_paths.packet_dir}\" -mindepth 1 -maxdepth 1 ! -name \"$(basename \"{state_paths.lock_file}\")\" -exec mv {} \"{state_paths.archive_root}/{timestamp_slug}/\" \\; || exit 1\n527:                 mkdir -p \"{state_paths.prompt_dir}\" \"{state_paths.iteration_dir}\" \"{state_paths.delta_dir}\"\n528:               on_fail: \"Halt with STATUS=FAIL through step_release_lock. Never fall back to resume.\"\n529:               set:\n530:                 lineage_mode: \"restart\"\n531:               skip_to: step_create_config\n532:             on_cancel_choice:\n533:               halt: true\n534:               release_lock: step_release_lock\n535:               message: \"Review session preserved. Manually archive or edit review/ before re-running.\"\n536:         on_restart:\n537:           action: \"Nothing is archived here. step_apply_lifecycle_request archived the packet before the lock was taken, so a restart run reaches this step as fresh and continues as on_fresh.\"\n538:         note_deferred_branches: \"fork and completed-continue are deferred and no longer runtime-supported in this release. The reducer still reads `lineageMode` from config for dashboards and analysis, but only `new`, `resume`, and `restart` are live. See deep-review/references/protocol/loop-protocol.md §Lifecycle Branches for the one-session contract.\"\n539:         on_moved_legacy_state:\n540:           applies_when: \"legacy_migration_detected == true and the branch taken resumes the session or goes to synthesis; never on restart or cancel\"\n541:           order: \"Runs after classification and before that branch appends anything, the resume event included.\"\n542:           note: |\n543:             The state log moved out of scratch/ was written by hand before the ledger existed, so the\n544:             gateway refuses every append to it. Set it aside unchanged as deep-review-state.legacy.jsonl,\n545:             open the run from the moved config, then replay its iteration rows through the gateway,\n546:             which carries each one whole. Rows the gateway cannot carry stay only in the set-aside file,\n547:             and the replay reports how many. Exit 2 from any of the three is a halt.\n548:           set_aside_command: |\n549:             STATE_LOG=\"{state_paths.state_log}\"\n550:             LEGACY_LOG=\"$(dirname \"$STATE_LOG\")/deep-review-state.legacy.jsonl\"\n551:             if [ -e \"$LEGACY_LOG\" ]; then\n552:               echo \"A set-aside legacy state log already exists at $LEGACY_LOG. Repair the packet by hand.\" >&2\n553:               exit 1\n554:             fi\n555:             mv \"$STATE_LOG\" \"$LEGACY_LOG\"\n556:           open_run: \"Run step_create_state_log.command unchanged. With the hand-written log set aside, it opens the run from the moved config.\"\n557:           replay_command: |\n558:             GATEWAY=\".skilled/skills/system-deep-loop/runtime/scripts/append-mode-event.cjs\"\n559:             [ -f \"$GATEWAY\" ] || GATEWAY=\"scripts/append-mode-event.cjs\"\n560:             RUN_DIR=\"$(dirname \"{state_paths.state_log}\")\"\n561:             node -e '\n562:               const fs = require(\"fs\"), os = require(\"os\"), path = require(\"path\");\n563:               const { spawnSync } = require(\"child_process\");\n564:               const [gateway, legacyLog, runDir] = process.argv.slice(1);\n565:               let replayedIterations = 0;\n566:               let keptOnlyInLegacyLog = 0;\n567:               for (const line of fs.readFileSync(legacyLog, \"utf8\").split(\"\\n\")) {\n568:                 if (line.trim() === \"\") continue;\n569:                 let row;\n570:                 try { row = JSON.parse(line); } catch { keptOnlyInLegacyLog += 1; continue; }\n571:                 // The run open already replaced the config row.\n572:                 if (row && row.type === \"config\") continue;\n573:                 if (!row || row.type !== \"iteration\") { keptOnlyInLegacyLog += 1; continue; }\n574:                 const tempDir = fs.mkdtempSync(path.join(os.tmpdir(), \"deep-review-replay-\"));\n575:                 const eventFile = path.join(tempDir, \"row.json\");\n576:                 fs.writeFileSync(eventFile, JSON.stringify(row));\n577:                 const result = spawnSync(process.execPath, [gateway, \"--mode\", \"review\", \"--run-directory\", runDir, \"--event-json\", eventFile], { encoding: \"utf8\" });\n578:                 fs.rmSync(tempDir, { recursive: true, force: true });\n579:                 if (result.status === 2) { process.stdout.write(result.stdout || \"\"); process.exit(2); }\n580:                 if (result.status === 0) replayedIterations += 1; else keptOnlyInLegacyLog += 1;\n581:               }\n582:               process.stdout.write(JSON.stringify({ replayedIterations, keptOnlyInLegacyLog, legacyLog }) + \"\\n\");\n583:             ' \"$GATEWAY\" \"$RUN_DIR/deep-review-state.legacy.jsonl\" \"$RUN_DIR\"\n584:         on_completed_session:\n585:           before_append: \"Run on_moved_legacy_state first when it applies.\"\n586:           log: \"Prior session already completed. Either archive the completed review/ tree and start a fresh session, or jump straight to synthesis with the existing artifacts.\"\n587:           skip_to: phase_synthesis\n588:         on_invalid_state:\n589:           halt: true\n590:           release_lock: step_release_lock\n591:           message: \"Existing deep-review state in review/ is incomplete or contradictory. Repair or archive the invalid review packet before continuing.\"\n592:         on_fresh:\n593:           action: \"Proceed with a new session\"\n594: \n595:       step_scope_discovery:\n596:         action: \"Resolve review target to a concrete file list based on target type\"\n597:         resolve:\n598:           spec-folder: |\n599:             1. Inspect spec.md, plan.md, tasks.md, acceptance-criteria.md, implementation-summary.md, and goal-file-manifest.txt when present\n600:             2. If goal-file-manifest.txt exists, parse one repo-relative path per non-empty, non-comment line; reject absolute paths, traversal outside repo_root, duplicates, missing paths, and non-file entries\n601:             3. Fail before dispatch with line-numbered validation errors when any manifest entry is invalid; otherwise set scope = the validated manifest paths in declared order\n602:             4. When no manifest exists, discover implementation files referenced in the canonical spec artifacts\n603:             5. Discover test files associated with the implementation files\n604:             6. Set scope = all discovered implementation and test files\n605:           skill: |\n606:             1. Read SKILL.md from .skilled/skills/{skill_name}/\n607:             2. Discover references/, assets/, scripts/ contents\n608:             3. Find agent definitions referencing this skill across runtimes\n609:             4. Find command entry points referencing this skill\n610:             5. Set scope = all discovered files\n611:           agent: |\n612:             1. Find agent definition across repo-managed runtimes (.claude/agents/, .skilled/agents/)\n613:             2. Compare agent definitions for consistency\n614:             3. Set scope = all discovered agent files\n615:           track: |\n616:             1. List all child spec folders under specs/{track}/ or .opencode/specs/{track}/\n617:             2. For each: read spec.md + acceptance-criteria.md\n618:             3. Set scope = all child spec artifacts\n619:           files: |\n[Output truncated. Continue reading with offset: 620]","title":"read","metadata":{"metadata":{"truncated":true},"content":[{"type":"text","text":"Read file .skilled/commands/deep/assets/deep-review.yaml, lines 340-619\n340:             --stop-policy {stop_policy} \\\n341:             --convergence-mode {convergence_mode}\n342:         working_directory: \"{repo_root}\"\n343:         wait_for_completion: true\n344:         optional_flags: \"When lineage_timeout_hours is bound, append `--lineage-timeout-hours {lineage_timeout_hours}` to the command. When it is unset, append nothing, which keeps the 4 hour ceiling.\"\n345: \n346:   # ════════\n347:   # PHASE 1: INITIALIZATION\n348:   # ════════\n349:   phase_init:\n350:     purpose: Create all state files for the review session and resolve review scope\n351:     steps:\n352: \n353:       step_preflight_contract:\n354:         action: \"Validate required setup bindings and executable workflow contract before any file writes\"\n355:         verify:\n356:           - required_values_present: [review_target, review_target_type, review_dimensions, spec_folder, lineage_mode, max_iterations, convergence_threshold, convergence_mode, stop_policy]\n357:           - dry_run_normalized: \"Boolean true or false before workflow loading; absent flag resolves to false.\"\n358:           - spec_folder_is_within: \"specs/ or .opencode/specs/ (canonicalize alias roots before validation)\"\n359:           - unresolved_placeholders: \"FAIL if any user-facing template references placeholders not produced by earlier steps\"\n360:           - tool_contract: \"FAIL if executable steps reference tools outside the command allowlist\"\n361:         on_fail: \"Halt with STATUS=FAIL and report the missing binding or unsupported contract reference\"\n362: \n363:       step_create_directories:\n364:         action: \"Create spec folder and canonical review packet directories if they don't exist\"\n365:         dry_run_boundary: \"state-mutation\"\n366:         command: \"mkdir -p {state_paths.prompt_dir} {state_paths.iteration_dir} {state_paths.delta_dir}\"\n367: \n368:       step_detect_resource_map:\n369:         action: \"Detect resource-map.md before config creation so init can persist coverage-gate state\"\n370:         inspect:\n371:           - \"{spec_folder}/resource-map.md\"\n372:         classify:\n373:           present: \"resource-map.md exists at init\"\n374:           absent: \"resource-map.md does not exist at init\"\n375:         outputs:\n376:           - resource_map_present: \"Boolean true when {spec_folder}/resource-map.md exists, else false\"\n377:           - resource_map_known_context: \"When present: concise resource-map snapshot for Known Context and charter framing. When absent: 'resource-map.md not present; skipping coverage gate'.\"\n378: \n379:       step_migrate_legacy_review_state:\n380:         action: \"Rehome legacy review artifacts into review/iterations before session classification\"\n381:         dry_run_boundary: \"state-mutation\"\n382:         detect:\n383:           canonical_review_state:\n384:             - \"{state_paths.config}\"\n385:             - \"{state_paths.state_log}\"\n386:             - \"{state_paths.findings_registry}\"\n387:             - \"{state_paths.strategy}\"\n388:           legacy_review_state:\n389:             - \"{spec_folder}/scratch/deep-research-config.json\"\n390:             - \"{spec_folder}/scratch/deep-research-state.jsonl\"\n391:             - \"{spec_folder}/scratch/deep-review-strategy.md\"\n392:             - \"{spec_folder}/scratch/deep-review-dashboard.md\"\n393:             - \"{spec_folder}/scratch/iteration-*.md\"\n394:             - \"{spec_folder}/scratch/.deep-research-pause\"\n395:             - \"{state_paths.local_packet_dir}/iteration-*.md\"\n396:             - \"{state_paths.legacy_root_report}\"\n397:           legacy_review_markers:\n398:             - \"scratch/deep-review-strategy.md exists\"\n399:             - \"scratch/deep-research-config.json declares mode == 'review' OR scratch/deep-research-state.jsonl contains mode == 'review'\"\n400:         migrate_only:\n401:           - \"{spec_folder}/scratch/deep-research-config.json -> {state_paths.config}\"\n402:           - \"{spec_folder}/scratch/deep-research-state.jsonl -> {state_paths.state_log}\"\n403:           - \"{spec_folder}/scratch/deep-review-strategy.md -> {state_paths.strategy}\"\n404:           - \"{spec_folder}/scratch/deep-review-dashboard.md -> {state_paths.dashboard}\"\n405:           - \"{spec_folder}/scratch/iteration-*.md -> {state_paths.iteration_dir}/\"\n406:           - \"{spec_folder}/scratch/.deep-research-pause -> {state_paths.pause_sentinel}\"\n407:           - \"{state_paths.local_packet_dir}/iteration-*.md -> {state_paths.iteration_dir}/\"\n408:           - \"{state_paths.legacy_root_report} -> {state_paths.review_output}\"\n409:         on_canonical_present: \"Leave canonical review/ state untouched and do not overwrite it with legacy scratch artifacts.\"\n410:         on_legacy_detected: \"Move only the review-specific whitelist, print LEGACY_REVIEW_STATE_MOVED and leave unrelated scratch files untouched. Nothing is appended here: an append before session classification would create the state log and turn a fresh packet into a partial one, and the moved state log was written without the ledger, so the gateway refuses every append to it until step_classify_session.on_moved_legacy_state adopts it.\"\n411:         on_conflict: \"If canonical review/ state and legacy scratch review state both exist but disagree, halt for operator repair instead of merging contradictory state.\"\n412:         outputs:\n413:           - legacy_migration_detected: \"true when the command printed LEGACY_REVIEW_STATE_MOVED, else false\"\n414:           - migration_recorded: \"false; step_record_artifact_migration sets it once the migration row is appended\"\n415:         command: |\n416:           mkdir -p {state_paths.iteration_dir}\n417:           if [ ! -e {state_paths.config} ] && [ ! -e {state_paths.state_log} ] && [ ! -e {state_paths.strategy} ] && [ -e {spec_folder}/scratch/deep-review-strategy.md ] && ( [ -e {spec_folder}/scratch/deep-research-config.json ] || [ -e {spec_folder}/scratch/deep-research-state.jsonl ] ); then\n418:             [ -e {spec_folder}/scratch/deep-research-config.json ] && mv {spec_folder}/scratch/deep-research-config.json {state_paths.config}\n419:             [ -e {spec_folder}/scratch/deep-research-state.jsonl ] && mv {spec_folder}/scratch/deep-research-state.jsonl {state_paths.state_log}\n420:             [ -e {spec_folder}/scratch/deep-review-strategy.md ] && mv {spec_folder}/scratch/deep-review-strategy.md {state_paths.strategy}\n421:             [ -e {spec_folder}/scratch/deep-review-dashboard.md ] && mv {spec_folder}/scratch/deep-review-dashboard.md {state_paths.dashboard}\n422:             find {spec_folder}/scratch -maxdepth 1 -name 'iteration-*.md' -exec mv {} {state_paths.iteration_dir}/ \\;\n423:             [ -e {spec_folder}/scratch/.deep-research-pause ] && mv {spec_folder}/scratch/.deep-research-pause {state_paths.pause_sentinel}\n424:             [ -e {state_paths.legacy_root_report} ] && mv {state_paths.legacy_root_report} {state_paths.review_output}\n425:             echo \"LEGACY_REVIEW_STATE_MOVED\"\n426:           fi\n427:           find {state_paths.local_packet_dir} -maxdepth 1 -name 'iteration-*.md' -exec mv {} {state_paths.iteration_dir}/ \\; 2>/dev/null || true\n428: \n429:       step_acquire_lock:\n430:         action: \"Acquire the single-writer advisory lock before session classification\"\n431:         dry_run_boundary: \"state-mutation\"\n432:         ttl_ms: \"lock_ttl_ms = max(1800000, executor_timeout * 1000). executor_timeout is the bound dispatch timeout in seconds, 900 when unset. The lock is stale after twice this value, so it outlives the longest allowed dispatch.\"\n433:         command: \"node .skilled/skills/system-deep-loop/runtime/scripts/loop-lock.cjs acquire --lock-path {state_paths.lock_file} --packet-id {spec_folder} --ttl-ms {lock_ttl_ms}\"\n434:         on_acquire: \"Capture lock.ownerPid as captured_owner_pid and lock.acquireNonce as captured_acquire_nonce from the JSON output, and reuse both for every release below. If acquired=false, fail closed — another deep-review run already holds this packet. Under confirm, mode_overrides.confirm.lock_not_acquired applies instead.\"\n435:         note: \"Uses the promoted runtime/ loop-lock CLI (single source of truth: stale-lock reclaim, clean owner-scoped release). macOS/BSD locking is advisory — best-effort single-writer, not a hard mutex across host calls. Acquire reclaims a stale lock itself and reports the old holder under `reclaimed`. A lock is stale when its heartbeat is older than twice its TTL, or when its owning process is known to be dead. No confirmation step exists in either mode: log a `reclaimed` holder and continue.\"\n436:         # Lock-cleanup contract: the lock file MUST be released on every terminal exit path that follows acquisition.\n437:         # Runtimes honoring step_acquire_lock are required to perform this cleanup before halting or pausing.\n438:         on_halt:\n439:           action: \"Every terminal halt after the acquire runs step_release_lock before it returns control\"\n440:           command: \"node .skilled/skills/system-deep-loop/runtime/scripts/loop-lock.cjs release --lock-path {state_paths.lock_file} --owner-pid {captured_owner_pid} --nonce {captured_acquire_nonce}; failures here are logged but do not block the halt\"\n441:         on_cancel:\n442:           action: \"Release the lock on user cancel or pause-sentinel detection before sentinel processing\"\n443:           command: \"node .skilled/skills/system-deep-loop/runtime/scripts/loop-lock.cjs release --lock-path {state_paths.lock_file} --owner-pid {captured_owner_pid} --nonce {captured_acquire_nonce}; cancel completes regardless of cleanup result\"\n444:         on_workflow_exit:\n445:           action: \"Release the lock as the final step of any workflow exit path (success or failure)\"\n446:           command: \"node .skilled/skills/system-deep-loop/runtime/scripts/loop-lock.cjs release --lock-path {state_paths.lock_file} --owner-pid {captured_owner_pid} --nonce {captured_acquire_nonce}; idempotent — safe to invoke when already released\"\n447: \n448:       step_classify_session:\n449:         action: \"Classify the session before writing files\"\n450:         inspect:\n451:           - \"{state_paths.config}\"\n452:           - \"{state_paths.state_log}\"\n453:           - \"{state_paths.findings_registry}\"\n454:           - \"{state_paths.strategy}\"\n455:         classify:\n456:           fresh: \"None of the three state artifacts exist\"\n457:           resume: \"Config, JSONL, and strategy all exist and config.mode == 'review' and agree on target/spec folder\"\n458:           completed-session: \"Resume artifacts exist and config.status == 'complete'\"\n459:           invalid-state: \"Any partial, missing, or contradictory combination\"\n460:         outputs:\n461:           - session_state: \"fresh | resume | completed-session | invalid-state\"\n462:           - prior_tail_digest: \"sha256 of the state log bytes when resuming or restarting an existing lineage\"\n463:         lifecycle_routing:\n464:           - \"If lineage_mode == restart, step_apply_lifecycle_request archived the packet before the lock was taken, so session_state is fresh and on_fresh runs.\"\n465:           - \"If lineage_mode == auto or lineage_mode == resume, preserve the existing resume/completed/fresh behavior.\"\n466:         on_resume:\n467:           before_append: \"Run on_moved_legacy_state first when it applies.\"\n468:           log: \"Auto-resume: state artifacts are complete and consistent. Continue the same lineage (sessionId unchanged, generation unchanged, no archive).\"\n469:           append_jsonl: '{\"stem\":\"deep_review.run_resumed\",\"scope\":{\"runId\":\"{session_id}\",\"sessionId\":\"{session_id}\",\"generation\":{generation}},\"data\":{\"priorTailDigest\":\"{prior_tail_digest}\",\"sourceSessionId\":\"{session_id}\",\"resumeReason\":\"Auto-resume: state artifacts are complete and consistent; continue the same lineage.\",\"continuedFromRunId\":\"{session_id}-i{iteration_count}\",\"compatibilityDecision\":\"exact\",\"recoveryReceiptRef\":\"none\"}}'\n470:           skip_to: phase_loop\n471:           confirm_choice:\n472:             applies_to: confirm\n473:             preempts: \"Under confirm this block runs in place of the sibling log, append_jsonl and skip_to keys of on_resume. Under auto it is skipped and those keys run.\"\n474:             show_dashboard: \"{state_paths.dashboard}\"\n475:             ask: \"Existing review session is consistent. Resume where it left off, or restart (archive the current review packet under the root-level review-archive/ tree and start a fresh session)?\"\n476:             after_gate_refresh_lock: gate_defaults.after_gate_refresh_lock\n477:             options: [resume, restart, cancel]\n478:             on_resume_choice:\n479:               dry_run_boundary: \"state-mutation\"\n480:               before_append: \"Run on_moved_legacy_state first when it applies.\"\n481:               set:\n482:                 lineage_mode: \"resume\"\n483:                 parent_session_id: \"{session_id}\"\n484:               append_jsonl: '{\"stem\":\"deep_review.run_resumed\",\"scope\":{\"runId\":\"{session_id}\",\"sessionId\":\"{session_id}\",\"generation\":{generation}},\"data\":{\"priorTailDigest\":\"{prior_tail_digest}\",\"sourceSessionId\":\"{session_id}\",\"resumeReason\":\"Auto-resume: state artifacts are complete and consistent; continue the same lineage.\",\"continuedFromRunId\":\"{session_id}-i{iteration_count}\",\"compatibilityDecision\":\"exact\",\"recoveryReceiptRef\":\"none\"}}'\n485:               skip_to: gate_init_approval\n486:             on_restart_choice:\n487:               dry_run_boundary: \"state-mutation\"\n488:               bind_prior_lineage:\n489:                 action: \"Read the session id and generation of the packet that is about to be archived\"\n490:                 command: |\n491:                   node -e '\n492:                     const fs = require(\"fs\");\n493:                     const crypto = require(\"crypto\");\n494:                     let priorSessionId = null;\n495:                     let priorGeneration = 0;\n496:                     try {\n497:                       const config = JSON.parse(fs.readFileSync(process.argv[1], \"utf8\"));\n498:                       const lineage = config.lineage || config;\n499:                       priorSessionId = typeof lineage.sessionId === \"string\" ? lineage.sessionId : null;\n500:                       priorGeneration = Number(lineage.generation) || 0;\n501:                     } catch (error) {\n502:                       if (error.code !== \"ENOENT\") {\n503:                         console.error(\"The old config cannot be read: \" + error.message);\n504:                         process.exit(1);\n505:                       }\n506:                     }\n507:                     let priorTailDigest = crypto.createHash(\"sha256\").update(\"\").digest(\"hex\");\n508:                     try {\n509:                       priorTailDigest = crypto.createHash(\"sha256\").update(fs.readFileSync(process.argv[2])).digest(\"hex\");\n510:                     } catch (error) {\n511:                       if (error.code !== \"ENOENT\") throw error;\n512:                     }\n513:                     console.log(JSON.stringify({ priorSessionId, priorGeneration, priorTailDigest }));\n514:                   ' \"{state_paths.config}\" \"{state_paths.state_log}\"\n515:                 outputs:\n516:                   - prior_session_id: \"priorSessionId from the JSON output, null when no old config exists\"\n517:                   - prior_generation: \"priorGeneration from the JSON output, 0 when no old config exists\"\n518:                   - prior_tail_digest: \"priorTailDigest from the JSON output: the sha256 of the old state log bytes, or of zero bytes when no old state log exists\"\n519:                 on_fail: \"Halt with STATUS=FAIL through step_release_lock. The old config is unreadable, so repair or archive the packet by hand.\"\n520:               command: |\n521:                 if [ -e \"{state_paths.archive_root}/{timestamp_slug}\" ]; then\n522:                   echo \"The archive folder {state_paths.archive_root}/{timestamp_slug} is already there.\" >&2\n523:                   exit 1\n524:                 fi\n525:                 mkdir -p \"{state_paths.archive_root}/{timestamp_slug}\" || exit 1\n526:                 find \"{state_paths.packet_dir}\" -mindepth 1 -maxdepth 1 ! -name \"$(basename \"{state_paths.lock_file}\")\" -exec mv {} \"{state_paths.archive_root}/{timestamp_slug}/\" \\; || exit 1\n527:                 mkdir -p \"{state_paths.prompt_dir}\" \"{state_paths.iteration_dir}\" \"{state_paths.delta_dir}\"\n528:               on_fail: \"Halt with STATUS=FAIL through step_release_lock. Never fall back to resume.\"\n529:               set:\n530:                 lineage_mode: \"restart\"\n531:               skip_to: step_create_config\n532:             on_cancel_choice:\n533:               halt: true\n534:               release_lock: step_release_lock\n535:               message: \"Review session preserved. Manually archive or edit review/ before re-running.\"\n536:         on_restart:\n537:           action: \"Nothing is archived here. step_apply_lifecycle_request archived the packet before the lock was taken, so a restart run reaches this step as fresh and continues as on_fresh.\"\n538:         note_deferred_branches: \"fork and completed-continue are deferred and no longer runtime-supported in this release. The reducer still reads `lineageMode` from config for dashboards and analysis, but only `new`, `resume`, and `restart` are live. See deep-review/references/protocol/loop-protocol.md §Lifecycle Branches for the one-session contract.\"\n539:         on_moved_legacy_state:\n540:           applies_when: \"legacy_migration_detected == true and the branch taken resumes the session or goes to synthesis; never on restart or cancel\"\n541:           order: \"Runs after classification and before that branch appends anything, the resume event included.\"\n542:           note: |\n543:             The state log moved out of scratch/ was written by hand before the ledger existed, so the\n544:             gateway refuses every append to it. Set it aside unchanged as deep-review-state.legacy.jsonl,\n545:             open the run from the moved config, then replay its iteration rows through the gateway,\n546:             which carries each one whole. Rows the gateway cannot carry stay only in the set-aside file,\n547:             and the replay reports how many. Exit 2 from any of the three is a halt.\n548:           set_aside_command: |\n549:             STATE_LOG=\"{state_paths.state_log}\"\n550:             LEGACY_LOG=\"$(dirname \"$STATE_LOG\")/deep-review-state.legacy.jsonl\"\n551:             if [ -e \"$LEGACY_LOG\" ]; then\n552:               echo \"A set-aside legacy state log already exists at $LEGACY_LOG. Repair the packet by hand.\" >&2\n553:               exit 1\n554:             fi\n555:             mv \"$STATE_LOG\" \"$LEGACY_LOG\"\n556:           open_run: \"Run step_create_state_log.command unchanged. With the hand-written log set aside, it opens the run from the moved config.\"\n557:           replay_command: |\n558:             GATEWAY=\".skilled/skills/system-deep-loop/runtime/scripts/append-mode-event.cjs\"\n559:             [ -f \"$GATEWAY\" ] || GATEWAY=\"scripts/append-mode-event.cjs\"\n560:             RUN_DIR=\"$(dirname \"{state_paths.state_log}\")\"\n561:             node -e '\n562:               const fs = require(\"fs\"), os = require(\"os\"), path = require(\"path\");\n563:               const { spawnSync } = require(\"child_process\");\n564:               const [gateway, legacyLog, runDir] = process.argv.slice(1);\n565:               let replayedIterations = 0;\n566:               let keptOnlyInLegacyLog = 0;\n567:               for (const line of fs.readFileSync(legacyLog, \"utf8\").split(\"\\n\")) {\n568:                 if (line.trim() === \"\") continue;\n569:                 let row;\n570:                 try { row = JSON.parse(line); } catch { keptOnlyInLegacyLog += 1; continue; }\n571:                 // The run open already replaced the config row.\n572:                 if (row && row.type === \"config\") continue;\n573:                 if (!row || row.type !== \"iteration\") { keptOnlyInLegacyLog += 1; continue; }\n574:                 const tempDir = fs.mkdtempSync(path.join(os.tmpdir(), \"deep-review-replay-\"));\n575:                 const eventFile = path.join(tempDir, \"row.json\");\n576:                 fs.writeFileSync(eventFile, JSON.stringify(row));\n577:                 const result = spawnSync(process.execPath, [gateway, \"--mode\", \"review\", \"--run-directory\", runDir, \"--event-json\", eventFile], { encoding: \"utf8\" });\n578:                 fs.rmSync(tempDir, { recursive: true, force: true });\n579:                 if (result.status === 2) { process.stdout.write(result.stdout || \"\"); process.exit(2); }\n580:                 if (result.status === 0) replayedIterations += 1; else keptOnlyInLegacyLog += 1;\n581:               }\n582:               process.stdout.write(JSON.stringify({ replayedIterations, keptOnlyInLegacyLog, legacyLog }) + \"\\n\");\n583:             ' \"$GATEWAY\" \"$RUN_DIR/deep-review-state.legacy.jsonl\" \"$RUN_DIR\"\n584:         on_completed_session:\n585:           before_append: \"Run on_moved_legacy_state first when it applies.\"\n586:           log: \"Prior session already completed. Either archive the completed review/ tree and start a fresh session, or jump straight to synthesis with the existing artifacts.\"\n587:           skip_to: phase_synthesis\n588:         on_invalid_state:\n589:           halt: true\n590:           release_lock: step_release_lock\n591:           message: \"Existing deep-review state in review/ is incomplete or contradictory. Repair or archive the invalid review packet before continuing.\"\n592:         on_fresh:\n593:           action: \"Proceed with a new session\"\n594: \n595:       step_scope_discovery:\n596:         action: \"Resolve review target to a concrete file list based on target type\"\n597:         resolve:\n598:           spec-folder: |\n599:             1. Inspect spec.md, plan.md, tasks.md, acceptance-criteria.md, implementation-summary.md, and goal-file-manifest.txt when present\n600:             2. If goal-file-manifest.txt exists, parse one repo-relative path per non-empty, non-comment line; reject absolute paths, traversal outside repo_root, duplicates, missing paths, and non-file entries\n601:             3. Fail before dispatch with line-numbered validation errors when any manifest entry is invalid; otherwise set scope = the validated manifest paths in declared order\n602:             4. When no manifest exists, discover implementation files referenced in the canonical spec artifacts\n603:             5. Discover test files associated with the implementation files\n604:             6. Set scope = all discovered implementation and test files\n605:           skill: |\n606:             1. Read SKILL.md from .skilled/skills/{skill_name}/\n607:             2. Discover references/, assets/, scripts/ contents\n608:             3. Find agent definitions referencing this skill across runtimes\n609:             4. Find command entry points referencing this skill\n610:             5. Set scope = all discovered files\n611:           agent: |\n612:             1. Find agent definition across repo-managed runtimes (.claude/agents/, .skilled/agents/)\n613:             2. Compare agent definitions for consistency\n614:             3. Set scope = all discovered agent files\n615:           track: |\n616:             1. List all child spec folders under specs/{track}/ or .opencode/specs/{track}/\n617:             2. For each: read spec.md + acceptance-criteria.md\n618:             3. Set scope = all child spec artifacts\n619:           files: |\n[Output truncated. Continue reading with offset: 620]"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\".skilled/commands/deep/assets/deep-review.yaml\",\"offset\":340,\"limit\":280}"},"time":{"start":1794760626759,"end":1794760628443}}}}
