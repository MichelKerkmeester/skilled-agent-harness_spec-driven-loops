.filter(r=>r.type===\\\"iteration\\\");\\nlet ok=true;\\nfor(const it of iters){\\n  const delta=fs.readFileSync(d+`deltas/iter-00${it.iteration}.jsonl`,\\\"utf8\\\").split(\\\"\\\\n\\\").filter(Boolean).map(JSON.parse);\\n  const fr=delta.filter(r=>r.type===\\\"finding\\\");\\n  const ids=fr.map(r=>r.id);\\n  const missing=ids.filter(id=>!regIds.has(id));\\n  const summary=it.findingsSummary;\\n  console.log(`iter ${it.iteration}: deltaFindings=${fr.length} summary=${summary.P0}/${summary.P1}/${summary.P2} details=${it.findingDetails.length} missingFromRegistry=${missing.join(\\\",\\\")||\\\"none\\\"} v2=${it.reviewDepthSchemaVersion}`);\\n  if(fr.length!==summary.P0+summary.P1+summary.P2) ok=false;\\n  if(missing.length) ok=false;\\n  const first=delta[0];\\n  if(first.type!==\\\"iteration\\\"||first.iteration!==it.iteration) ok=false;\\n}\\nconst report=fs.readFileSync(d+\\\"review-report.md\\\",\\\"utf8\\\");\\nconst m=report.match(/```json Planning Packet\\\\n([\\\\s\\\\S]*?)```/);\\nif(!m){console.log(\\\"planning packet block missing\\\");ok=false;}\\nelse{try{const p=JSON.parse(m[1]);console.log(\\\"planning packet parsed, triggered=\\\",p.triggered,\\\"activeFindings=\\\",p.activeFindings.length);if(p.activeFindings.length!==8)ok=false;}catch(e){console.log(\\\"planning packet JSON invalid\\\",e.message);ok=false;}}\\nconsole.log(\\\"consistency\\\",ok?\\\"OK\\\":\\\"FAIL\\\");\\nNODE\\necho \\\"=== trailing spaces on verdict lines\\\"; grep -n \\\"Review verdict: PASS $\\\" specs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/review/lineages/vibe-hooks-doctor-5/iterations/*.md | head; echo \\\"none above means clean\\\"\"}"},"time":{"start":1794762348953,"end":1794762353246}}}}
