{"type":"tool_use","timestamp":1794760970321,"sessionID":"ses_e1feefdd5ffeHQJCqAmpoKpkZG","part":{"partID":"prt_1e0170f54002hg6IN36Ipc5Csa","sessionID":"ses_e1feefdd5ffeHQJCqAmpoKpkZG","messageID":"msg_1e016ffcf001z8pVp1Crz5cuik","type":"tool","id":"call_ace23110924a4d91af31800c","tool":"read","state":{"status":"completed","input":{"path":".skilled/hooks/session-lifecycle/vibe/turn-start.mjs"},"output":"Read file .skilled/hooks/session-lifecycle/vibe/turn-start.mjs, lines 1-162\n1: #!/usr/bin/env node\n2: // ───────────────────────────────────────────────────────────────────\n3: // MODULE: Vibe Turn Start Hook\n4: // ───────────────────────────────────────────────────────────────────\n5: // Vibe delivers one JSON payload on stdin at pre_agent and reads one optional\n6: // additional_context line back. This hook composes the turn-start parts in a\n7: // fixed order, each in its own try/catch, so one failing part contributes\n8: // nothing and the rest still land. The pending completion advisory is delivered\n9: // first, then the compaction context a new journal entry re-arms, then the\n10: // advisor brief, then the save reminder a new operator answer raises; later\n11: // turn-start concerns join this list rather than registering their own pre_agent\n12: // entry, which keeps the order fixed here instead of by hook registration order.\n13: // It never blocks and never exits\n14: // non-zero: malformed input or a failing part contributes nothing, and an\n15: // empty result prints nothing at all.\n16: \n17: // ─────────────────────────────────────────────────────────────────────────────\n18: // 1. IMPORTS\n19: // ─────────────────────────────────────────────────────────────────────────────\n20: \n21: import { readFileSync, unlinkSync } from 'node:fs';\n22: import { dirname, join, resolve } from 'node:path';\n23: import { fileURLToPath } from 'node:url';\n24: \n25: import { takeNudge } from '../../decision-capture/lib/capture-core.mjs';\n26: import { isHookEnabled } from '../../shared/hook-flags.mjs';\n27: import { buildAdvisorPart } from '../../../skills/system-skill-advisor/hooks/vibe/prompt-advisor.mjs';\n28: import { buildCompactionPart } from './compaction-context.mjs';\n29: \n30: // ─────────────────────────────────────────────────────────────────────────────\n31: // 2. CONSTANTS\n32: // ─────────────────────────────────────────────────────────────────────────────\n33: \n34: const IS_CLI_ENTRY = process.argv[1]\n35:   ? resolve(process.argv[1]) === fileURLToPath(import.meta.url)\n36:   : false;\n37: \n38: // The completion part runs at turn end and leaves its advisory here; this\n39: // composer consumes it on the next turn. Both resolve the file from the\n40: // session's own project root, so a scratch run cannot deliver another\n41: // session's advisory.\n42: const PENDING_ADVISORY_RELATIVE_PATH = '.skilled/skills/.state/completion-sentinel/vibe-pending-advisory.txt';\n43: const DEFAULT_PROJECT_DIR = resolve(dirname(fileURLToPath(import.meta.url)), '../../../..');\n44: const HANDOVER_PART_URL = new URL(\n45:   '../../session-handover/vibe/handover-parts.mjs',\n46:   import.meta.url,\n47: ).href;\n48: \n49: function pendingCompletionAdvisoryPart(payload) {\n50:   if (isHookEnabled('completion') === false) return '';\n51:   const projectDir = typeof payload.cwd === 'string' && payload.cwd ? payload.cwd : DEFAULT_PROJECT_DIR;\n52:   const target = join(projectDir, PENDING_ADVISORY_RELATIVE_PATH);\n53: \n54:   let detail;\n55:   try {\n56:     detail = readFileSync(target, 'utf8').trim();\n57:   } catch {\n58:     return '';\n59:   }\n60:   // The advisory is delivered once per file. A file that cannot be removed\n61:   // would ride every later turn, so it is dropped rather than repeated.\n62:   try {\n63:     unlinkSync(target);\n64:   } catch {\n65:     return '';\n66:   }\n67:   return detail ? `[completion-evidence] ${detail}` : '';\n68: }\n69: \n70: // An answer only reaches a decision record through a save, so a new pending\n71: // answer deserves one reminder rather than a silently growing backlog. The\n72: // counter reports a session's pending count once per rise, so the next turn at\n73: // the same count adds nothing and a save that drains the queue starts over.\n74: export function buildSaveNudgePart(payload, { core = { takeNudge } } = {}) {\n75:   if (isHookEnabled('decision-capture') === false) return '';\n76:   const sessionId = typeof payload.session_id === 'string' ? payload.session_id.trim() : '';\n77:   if (!sessionId) return '';\n78: \n79:   const projectDir = typeof payload.cwd === 'string' && payload.cwd ? payload.cwd : DEFAULT_PROJECT_DIR;\n80:   const count = core.takeNudge(projectDir, sessionId);\n81:   if (!Number.isInteger(count) || count <= 0) return '';\n82:   return `[decision-capture] ${count} operator answer(s) captured this session are not in a decision record yet. Run /speckit:save to record them.`;\n83: }\n84: \n85: // The hand-over module is imported when its part runs, so a load error costs that\n86: // one part and the parts before it still land.\n87: async function handoverPart(payload) {\n88:   const { buildHandoverContextPart } = await import(HANDOVER_PART_URL);\n89:   return buildHandoverContextPart(payload);\n90: }\n91: \n92: const PARTS = [\n93:   (payload) => pendingCompletionAdvisoryPart(payload),\n94:   // The compaction part runs before the advisor part, so the receipt it\n95:   // re-arms is already advanced when the advisor decides what to deliver.\n96:   (payload) => buildCompactionPart(payload),\n97:   (payload) => buildAdvisorPart(payload),\n98:   (payload) => buildSaveNudgePart(payload),\n99:   // The hand-over part runs last, so its claim or nudge text ends the context.\n100:   handoverPart,\n101: ];\n102: \n103: // ─────────────────────────────────────────────────────────────────────────────\n104: // 3. HELPERS\n105: // ─────────────────────────────────────────────────────────────────────────────\n106: \n107: async function readStdin() {\n108:   process.stdin.setEncoding('utf8');\n109:   let text = '';\n110:   for await (const chunk of process.stdin) text += chunk;\n111:   return text;\n112: }\n113: \n114: // ─────────────────────────────────────────────────────────────────────────────\n115: // 4. MAIN\n116: // ─────────────────────────────────────────────────────────────────────────────\n117: \n118: /**\n119:  * Compose the turn-start context for one pre_agent payload.\n120:  *\n121:  * @param {Object} payload - The parsed Vibe pre_agent payload.\n122:  * @param {{parts?: Array<Function>}} [options] - The part list, injectable for tests.\n123:  * @returns {Promise<string>} The joined parts, or an empty string.\n124:  */\n125: export async function composeTurnStart(payload, { parts = PARTS } = {}) {\n126:   if (!payload || typeof payload !== 'object' || Array.isArray(payload)) return '';\n127:   if (payload.hook_event_name !== 'pre_agent') return '';\n128: \n129:   const texts = [];\n130:   for (const build of parts) {\n131:     try {\n132:       const text = String(await build(payload) ?? '').trim();\n133:       if (text) texts.push(text);\n134:     } catch {\n135:       // A failing part contributes nothing; the other parts still land.\n136:     }\n137:   }\n138:   return texts.join('\\n\\n');\n139: }\n140: \n141: async function main() {\n142:   const stdinText = await readStdin();\n143: \n144:   let payload;\n145:   try {\n146:     payload = JSON.parse(stdinText);\n147:   } catch {\n148:     return;\n149:   }\n150: \n151:   const text = await composeTurnStart(payload);\n152:   if (!text) return;\n153: \n154:   process.exitCode = 0;\n155:   process.stdout.write(`${JSON.stringify({ hook_specific_output: { additional_context: text } })}\\n`);\n156: }\n157: \n158: if (IS_CLI_ENTRY) {\n159:   main().catch(() => {\n160:     process.exitCode = 0;\n161:   });\n162: }","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file .skilled/hooks/session-lifecycle/vibe/turn-start.mjs, lines 1-162\n1: #!/usr/bin/env node\n2: // ───────────────────────────────────────────────────────────────────\n3: // MODULE: Vibe Turn Start Hook\n4: // ───────────────────────────────────────────────────────────────────\n5: // Vibe delivers one JSON payload on stdin at pre_agent and reads one optional\n6: // additional_context line back. This hook composes the turn-start parts in a\n7: // fixed order, each in its own try/catch, so one failing part contributes\n8: // nothing and the rest still land. The pending completion advisory is delivered\n9: // first, then the compaction context a new journal entry re-arms, then the\n10: // advisor brief, then the save reminder a new operator answer raises; later\n11: // turn-start concerns join this list rather than registering their own pre_agent\n12: // entry, which keeps the order fixed here instead of by hook registration order.\n13: // It never blocks and never exits\n14: // non-zero: malformed input or a failing part contributes nothing, and an\n15: // empty result prints nothing at all.\n16: \n17: // ─────────────────────────────────────────────────────────────────────────────\n18: // 1. IMPORTS\n19: // ─────────────────────────────────────────────────────────────────────────────\n20: \n21: import { readFileSync, unlinkSync } from 'node:fs';\n22: import { dirname, join, resolve } from 'node:path';\n23: import { fileURLToPath } from 'node:url';\n24: \n25: import { takeNudge } from '../../decision-capture/lib/capture-core.mjs';\n26: import { isHookEnabled } from '../../shared/hook-flags.mjs';\n27: import { buildAdvisorPart } from '../../../skills/system-skill-advisor/hooks/vibe/prompt-advisor.mjs';\n28: import { buildCompactionPart } from './compaction-context.mjs';\n29: \n30: // ─────────────────────────────────────────────────────────────────────────────\n31: // 2. CONSTANTS\n32: // ─────────────────────────────────────────────────────────────────────────────\n33: \n34: const IS_CLI_ENTRY = process.argv[1]\n35:   ? resolve(process.argv[1]) === fileURLToPath(import.meta.url)\n36:   : false;\n37: \n38: // The completion part runs at turn end and leaves its advisory here; this\n39: // composer consumes it on the next turn. Both resolve the file from the\n40: // session's own project root, so a scratch run cannot deliver another\n41: // session's advisory.\n42: const PENDING_ADVISORY_RELATIVE_PATH = '.skilled/skills/.state/completion-sentinel/vibe-pending-advisory.txt';\n43: const DEFAULT_PROJECT_DIR = resolve(dirname(fileURLToPath(import.meta.url)), '../../../..');\n44: const HANDOVER_PART_URL = new URL(\n45:   '../../session-handover/vibe/handover-parts.mjs',\n46:   import.meta.url,\n47: ).href;\n48: \n49: function pendingCompletionAdvisoryPart(payload) {\n50:   if (isHookEnabled('completion') === false) return '';\n51:   const projectDir = typeof payload.cwd === 'string' && payload.cwd ? payload.cwd : DEFAULT_PROJECT_DIR;\n52:   const target = join(projectDir, PENDING_ADVISORY_RELATIVE_PATH);\n53: \n54:   let detail;\n55:   try {\n56:     detail = readFileSync(target, 'utf8').trim();\n57:   } catch {\n58:     return '';\n59:   }\n60:   // The advisory is delivered once per file. A file that cannot be removed\n61:   // would ride every later turn, so it is dropped rather than repeated.\n62:   try {\n63:     unlinkSync(target);\n64:   } catch {\n65:     return '';\n66:   }\n67:   return detail ? `[completion-evidence] ${detail}` : '';\n68: }\n69: \n70: // An answer only reaches a decision record through a save, so a new pending\n71: // answer deserves one reminder rather than a silently growing backlog. The\n72: // counter reports a session's pending count once per rise, so the next turn at\n73: // the same count adds nothing and a save that drains the queue starts over.\n74: export function buildSaveNudgePart(payload, { core = { takeNudge } } = {}) {\n75:   if (isHookEnabled('decision-capture') === false) return '';\n76:   const sessionId = typeof payload.session_id === 'string' ? payload.session_id.trim() : '';\n77:   if (!sessionId) return '';\n78: \n79:   const projectDir = typeof payload.cwd === 'string' && payload.cwd ? payload.cwd : DEFAULT_PROJECT_DIR;\n80:   const count = core.takeNudge(projectDir, sessionId);\n81:   if (!Number.isInteger(count) || count <= 0) return '';\n82:   return `[decision-capture] ${count} operator answer(s) captured this session are not in a decision record yet. Run /speckit:save to record them.`;\n83: }\n84: \n85: // The hand-over module is imported when its part runs, so a load error costs that\n86: // one part and the parts before it still land.\n87: async function handoverPart(payload) {\n88:   const { buildHandoverContextPart } = await import(HANDOVER_PART_URL);\n89:   return buildHandoverContextPart(payload);\n90: }\n91: \n92: const PARTS = [\n93:   (payload) => pendingCompletionAdvisoryPart(payload),\n94:   // The compaction part runs before the advisor part, so the receipt it\n95:   // re-arms is already advanced when the advisor decides what to deliver.\n96:   (payload) => buildCompactionPart(payload),\n97:   (payload) => buildAdvisorPart(payload),\n98:   (payload) => buildSaveNudgePart(payload),\n99:   // The hand-over part runs last, so its claim or nudge text ends the context.\n100:   handoverPart,\n101: ];\n102: \n103: // ─────────────────────────────────────────────────────────────────────────────\n104: // 3. HELPERS\n105: // ─────────────────────────────────────────────────────────────────────────────\n106: \n107: async function readStdin() {\n108:   process.stdin.setEncoding('utf8');\n109:   let text = '';\n110:   for await (const chunk of process.stdin) text += chunk;\n111:   return text;\n112: }\n113: \n114: // ─────────────────────────────────────────────────────────────────────────────\n115: // 4. MAIN\n116: // ─────────────────────────────────────────────────────────────────────────────\n117: \n118: /**\n119:  * Compose the turn-start context for one pre_agent payload.\n120:  *\n121:  * @param {Object} payload - The parsed Vibe pre_agent payload.\n122:  * @param {{parts?: Array<Function>}} [options] - The part list, injectable for tests.\n123:  * @returns {Promise<string>} The joined parts, or an empty string.\n124:  */\n125: export async function composeTurnStart(payload, { parts = PARTS } = {}) {\n126:   if (!payload || typeof payload !== 'object' || Array.isArray(payload)) return '';\n127:   if (payload.hook_event_name !== 'pre_agent') return '';\n128: \n129:   const texts = [];\n130:   for (const build of parts) {\n131:     try {\n132:       const text = String(await build(payload) ?? '').trim();\n133:       if (text) texts.push(text);\n134:     } catch {\n135:       // A failing part contributes nothing; the other parts still land.\n136:     }\n137:   }\n138:   return texts.join('\\n\\n');\n139: }\n140: \n141: async function main() {\n142:   const stdinText = await readStdin();\n143: \n144:   let payload;\n145:   try {\n146:     payload = JSON.parse(stdinText);\n147:   } catch {\n148:     return;\n149:   }\n150: \n151:   const text = await composeTurnStart(payload);\n152:   if (!text) return;\n153: \n154:   process.exitCode = 0;\n155:   process.stdout.write(`${JSON.stringify({ hook_specific_output: { additional_context: text } })}\\n`);\n156: }\n157: \n158: if (IS_CLI_ENTRY) {\n159:   main().catch(() => {\n160:     process.exitCode = 0;\n161:   });\n162: }"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\".skilled/hooks/session-lifecycle/vibe/turn-start.mjs\"}"},"time":{"start":1794760970068,"end":1794760970321}}}}
