{"type":"tool_use","timestamp":1794761131882,"sessionID":"ses_e1feefdd5ffeHQJCqAmpoKpkZG","part":{"partID":"prt_1e0198641002qsVatEy8tvrOt0","sessionID":"ses_e1feefdd5ffeHQJCqAmpoKpkZG","messageID":"msg_1e0191d2d001XESmhG1lK8sq66","type":"tool","id":"call_dba39c983af94ba9ae9271d2","tool":"read","state":{"status":"completed","input":{"path":".skilled/commands/doctor/scripts/tests/doctor-runtime-mirrors-contract.test.cjs"},"output":"Read file .skilled/commands/doctor/scripts/tests/doctor-runtime-mirrors-contract.test.cjs, lines 1-321\n1: #!/usr/bin/env node\n2: // ───────────────────────────────────────────────────────────────────\n3: // MODULE: Doctor Runtime Mirrors Contract Tests\n4: // ───────────────────────────────────────────────────────────────────\n5: 'use strict';\n6: \n7: /**\n8:  * The runtime-mirrors route and its workflow are two halves of one contract: the\n9:  * manifest declares which checkers run, and the workflow has to invoke each one\n10:  * in its check-only form. A mirror check the repository's CI runs but this pair\n11:  * omits is the failure mode worth a test, because a local run then reports in\n12:  * sync while the remote run fails on the same tree.\n13:  *\n14:  * DSH and Vibe checks are asserted in the shape their neighbours use,\n15:  * including the n/a rule: an absent runtime tree is reported as n/a rather than\n16:  * created, so a read-only diagnostic never has a write side effect.\n17:  *\n18:  * Both files resolve through an environment override so the removed-line case can\n19:  * be exercised against a copy in a scratch directory instead of by deleting a\n20:  * line from a tracked file.\n21:  */\n22: \n23: // ─────────────────────────────────────────────────────────────────────────────\n24: // 1. IMPORTS AND PATHS\n25: // ─────────────────────────────────────────────────────────────────────────────\n26: \n27: const assert = require('node:assert/strict');\n28: const fs = require('node:fs');\n29: const path = require('node:path');\n30: const test = require('node:test');\n31: const { parse: parseYaml } = require('yaml');\n32: \n33: const REPO_ROOT = path.resolve(__dirname, '..', '..', '..', '..', '..');\n34: const COMMANDS_DIR = path.join(REPO_ROOT, '.skilled', 'commands', 'doctor');\n35: const ASSETS_DIR = path.join(COMMANDS_DIR, 'assets');\n36: const ROUTES_PATH = process.env.DOCTOR_ROUTES_MANIFEST || path.join(COMMANDS_DIR, '_routes.yaml');\n37: const WORKFLOW_PATH =\n38:   process.env.DOCTOR_RUNTIME_MIRRORS_WORKFLOW || path.join(ASSETS_DIR, 'doctor-runtime-mirrors.yaml');\n39: \n40: const ROUTE_TARGET = 'runtime-mirrors';\n41: const AGENT_BODY_PARITY = {\n42:   key: 'agent_body_parity',\n43:   script: '.skilled/bin/check-agent-mirror-sync.cjs',\n44: };\n45: \n46: // Each mirror check names its surface, runtime tree and upstream_assets key. The\n47: // surface and tree are asserted so the diagnostic says what it checks and skips.\n48: const DSH_CHECKS = [\n49:   {\n50:     key: 'dsh_skills',\n51:     script: '.skilled/skills/system-spec-kit/runtime/cli/dsh/sync-skills-dsh.cjs',\n52:     surface: '.dsh/skills',\n53:     tree: '.dsh/',\n54:   },\n55:   {\n56:     key: 'dsh_prompts',\n57:     script: '.skilled/skills/system-spec-kit/runtime/cli/dsh/sync-prompts-dsh.cjs',\n58:     surface: '.dsh/prompts',\n59:     tree: '.dsh/',\n60:   },\n61:   {\n62:     key: 'dsh_agents',\n63:     script: '.skilled/skills/system-spec-kit/runtime/cli/dsh/sync-agents-dsh.cjs',\n64:     surface: '.dsh/agents',\n65:     tree: '.dsh/',\n66:   },\n67: ];\n68: const VIBE_CHECKS = [\n69:   {\n70:     key: 'vibe_prompts',\n71:     script: '.skilled/skills/system-spec-kit/runtime/cli/vibe/sync-prompts-vibe.cjs',\n72:     surface: '.vibe/prompts',\n73:     tree: '.vibe/',\n74:   },\n75:   {\n76:     key: 'vibe_agents',\n77:     script: '.skilled/skills/system-spec-kit/runtime/cli/vibe/sync-agents-vibe.cjs',\n78:     surface: '.vibe/agents',\n79:     tree: '.vibe/',\n80:   },\n81:   {\n82:     key: 'vibe_skills',\n83:     script: '.skilled/skills/system-spec-kit/runtime/cli/vibe/sync-skills-vibe.cjs',\n84:     surface: '.vibe/skills',\n85:     tree: '.vibe/',\n86:   },\n87: ];\n88: const MIRROR_CHECKS = [...DSH_CHECKS, ...VIBE_CHECKS];\n89: \n90: // ─────────────────────────────────────────────────────────────────────────────\n91: // 2. READERS AND SMALL HELPERS\n92: // ─────────────────────────────────────────────────────────────────────────────\n93: \n94: function read(absolutePath) {\n95:   return fs.readFileSync(absolutePath, 'utf8');\n96: }\n97: \n98: function tokens(entry) {\n99:   return String(entry).split(/\\s+/).filter(Boolean);\n100: }\n101: \n102: function deleteLines(source, predicate) {\n103:   return source.split('\\n').filter((line) => !predicate(line)).join('\\n');\n104: }\n105: \n106: function runtimeMirrorsRoute(manifestText) {\n107:   const manifest = parseYaml(manifestText);\n108:   const routes = manifest && Array.isArray(manifest.routes) ? manifest.routes : [];\n109:   const route = routes.find((entry) => entry && entry.target === ROUTE_TARGET);\n110:   assert.ok(route, `no route with target '${ROUTE_TARGET}' in ${ROUTES_PATH}`);\n111:   return route;\n112: }\n113: \n114: // ─────────────────────────────────────────────────────────────────────────────\n115: // 3. GAP DETECTION, PURE SO A REMOVED LINE IS OBSERVABLE\n116: // ─────────────────────────────────────────────────────────────────────────────\n117: \n118: /** Manifest gaps: a mirror check missing from script_invocations, or not check-only. */\n119: function routeGaps(manifestText) {\n120:   const route = runtimeMirrorsRoute(manifestText);\n121:   const invocations = Array.isArray(route.script_invocations) ? route.script_invocations : [];\n122:   const gaps = [];\n123:   for (const check of MIRROR_CHECKS) {\n124:     const entry = invocations.find((invocation) => tokens(invocation).includes(check.script));\n125:     if (!entry) {\n126:       gaps.push(`script_invocations never runs ${check.script}`);\n127:       continue;\n128:     }\n129:     if (tokens(entry)[0] !== 'node') {\n130:       gaps.push(`${check.script} is not invoked through node`);\n131:     }\n132:     if (!tokens(entry).includes('--check')) {\n133:       gaps.push(`${check.script} is not in its --check form`);\n134:     }\n135:   }\n136:   return gaps;\n137: }\n138: \n139: /** Workflow gaps: no upstream_assets entry, or no step with the surface and n/a rule. */\n140: function workflowGaps(workflowText) {\n141:   const document = parseYaml(workflowText);\n142:   const assets = (document && document.upstream_assets) || {};\n143:   const steps = document && document.execution && Array.isArray(document.execution.steps)\n144:     ? document.execution.steps\n145:     : [];\n146:   const gaps = [];\n147: \n148:   for (const check of MIRROR_CHECKS) {\n149:     if (assets[check.key] !== check.script) {\n150:       gaps.push(`upstream_assets.${check.key} does not name ${check.script}`);\n151:     }\n152: \n153:     const step = steps.find((entry) => typeof entry === 'string' && entry.includes(`upstream_assets.${check.key}`));\n154:     if (!step) {\n155:       gaps.push(`no execution step runs upstream_assets.${check.key}`);\n156:       continue;\n157:     }\n158:     if (!step.includes('--check')) {\n159:       gaps.push(`the ${check.key} step does not run the check-only form`);\n160:     }\n161:     if (!step.includes(check.surface)) {\n162:       gaps.push(`the ${check.key} step does not name the ${check.surface} surface it covers`);\n163:     }\n164:     if (!/\\bn\\/a\\b/.test(step)) {\n165:       gaps.push(`the ${check.key} step never reports n/a`);\n166:     }\n167:     if (!step.includes(check.tree)) {\n168:       gaps.push(`the ${check.key} step never names the ${check.tree} tree whose absence makes it n/a`);\n169:     }\n170:     if (!/never creates/i.test(step)) {\n171:       gaps.push(`the ${check.key} step does not say the run never creates ${check.tree}`);\n172:     }\n173:   }\n174:   return gaps;\n175: }\n176: \n177: /** Output gaps: no repair line, a repair line that is the check form, or an unrendered one. */\n178: function repairGaps(workflowText) {\n179:   const document = parseYaml(workflowText);\n180:   const outputLines = String((document && document.output) || '').split('\\n');\n181:   const gaps = [];\n182: \n183:   for (const check of MIRROR_CHECKS) {\n184:     const line = outputLines.find((candidate) => candidate.includes(check.script));\n185:     if (!line) {\n186:       gaps.push(`the output block carries no repair line for ${check.script}`);\n187:       continue;\n188:     }\n189:     if (line.includes('--check')) {\n190:       gaps.push(`the repair line for ${check.script} is the check form, not the generator`);\n191:     }\n192:     if (!line.includes('->')) {\n193:       gaps.push(`the repair line for ${check.script} is not rendered as \"<surface> -> <command>\"`);\n194:     }\n195:   }\n196:   return gaps;\n197: }\n198: \n199: // ─────────────────────────────────────────────────────────────────────────────\n200: // 4. THE MANIFEST AND WORKFLOW AS THEY SHIP\n201: // ─────────────────────────────────────────────────────────────────────────────\n202: \n203: test('the route declares all DSH checks in their check-only form', () => {\n204:   assert.deepEqual(routeGaps(read(ROUTES_PATH)), []);\n205: });\n206: \n207: test('the workflow names all mirror checks and reports n/a when a runtime tree is absent', () => {\n208:   assert.deepEqual(workflowGaps(read(WORKFLOW_PATH)), []);\n209: });\n210: \n211: test('agent body parity runs after the roster check and reports its comparison outcomes', () => {\n212:   const route = runtimeMirrorsRoute(read(ROUTES_PATH));\n213:   const invocation = (route.script_invocations || []).find((entry) => tokens(entry).includes(AGENT_BODY_PARITY.script));\n214:   assert.ok(invocation, `script_invocations never runs ${AGENT_BODY_PARITY.script}`);\n215:   assert.equal(tokens(invocation)[0], 'node');\n216:   assert.ok(tokens(invocation).includes('--all'));\n217: \n218:   const workflow = parseYaml(read(WORKFLOW_PATH));\n219:   assert.equal(workflow.upstream_assets[AGENT_BODY_PARITY.key], AGENT_BODY_PARITY.script);\n220:   const steps = workflow.execution.steps;\n221:   const rosterIndex = steps.findIndex((step) => step.includes('upstream_assets.agent_roster'));\n222:   const parityIndex = steps.findIndex((step) => step.includes(`upstream_assets.${AGENT_BODY_PARITY.key}`));\n223:   assert.ok(rosterIndex >= 0, 'the workflow has no agent roster step');\n224:   assert.equal(parityIndex, rosterIndex + 1, 'agent body parity follows the agent roster step');\n225: \n226:   const step = steps[parityIndex];\n227:   assert.match(step, /with --all/);\n228:   assert.match(step, /same-file mirrors and non-comparable formats are reported, not counted as matches/i);\n229:   assert.match(step, /Exit 0 = all comparable mirrors in sync/);\n230:   assert.match(step, /1 = drift or comparison failure/);\n231:   assert.match(step, /2 = checker invocation error \\(unknown option\\)/);\n232:   assert.match(step, /3 = not checkable \\(frontmatter parser unavailable\\)/);\n233: });\n234: \n235: test('the output block carries a generator repair line for every mirror check', () => {\n236:   assert.deepEqual(repairGaps(read(WORKFLOW_PATH)), []);\n237: });\n238: \n239: test('agent body parity output names the real-file and generated mirror repairs', () => {\n240:   const output = String(parseYaml(read(WORKFLOW_PATH)).output || '');\n241:   const repair = output.split('\\n').find((line) => line.includes(AGENT_BODY_PARITY.script));\n242:   assert.ok(repair, 'agent body parity has a repair line');\n243:   assert.match(repair, /\\.claude\\/agents is a hand-maintained real-file mirror/u);\n244:   assert.match(repair, /runtime\\/cli\\/codex\\/sync-agents\\.cjs/u);\n245:   assert.match(repair, /runtime\\/cli\\/pi\\/sync-agents-pi\\.cjs/u);\n246:   assert.match(repair, /runtime\\/cli\\/runtime-mirrors\\/sync-runtime-mirrors\\.cjs/u);\n247: });\n248: \n249: test('the route stays read-only and never runs a mirror generator in write mode', () => {\n250:   const route = runtimeMirrorsRoute(read(ROUTES_PATH));\n251:   assert.equal(route.mutating, 'read-only');\n252: \n253:   const writers = (route.script_invocations || []).filter((entry) => {\n254:     const parts = tokens(entry);\n255:     const namesGenerator = parts.some((token) => /(?:^|\\/)(?:sync-|install-)[\\w.-]+\\.(?:cjs|mjs)$/.test(token));\n256:     return namesGenerator && !parts.includes('--check');\n257:   });\n258:   assert.deepEqual(writers, [], 'every generator invocation must carry --check');\n259: \n260:   const boundaries = parseYaml(read(WORKFLOW_PATH)).mutation_boundaries || {};\n261:   assert.equal(boundaries.read_only, true);\n262:   assert.ok((boundaries.forbidden_targets || []).includes('**/*'));\n263: });\n264: \n265: // ─────────────────────────────────────────────────────────────────────────────\n266: // 5. THE CONTRACT FAILS WHEN EITHER LINE GOES MISSING\n267: // ─────────────────────────────────────────────────────────────────────────────\n268: \n269: test('the contract fails when a mirror line is removed from the route', () => {\n270:   const manifestText = read(ROUTES_PATH);\n271:   for (const check of MIRROR_CHECKS) {\n272:     const stripped = deleteLines(manifestText, (line) => line.includes(check.script));\n273:     const gaps = routeGaps(stripped);\n274:     assert.ok(\n275:       gaps.some((gap) => gap.includes(check.script)),\n276:       `removing ${check.script} from script_invocations went unnoticed`,\n277:     );\n278:   }\n279: });\n280: \n281: test('the contract fails when a mirror asset, step or repair line leaves the workflow', () => {\n282:   const workflowText = read(WORKFLOW_PATH);\n283:   for (const check of MIRROR_CHECKS) {\n284:     const withoutAsset = deleteLines(workflowText, (line) => line.includes(check.script));\n285:     assert.ok(\n286:       workflowGaps(withoutAsset).some((gap) => gap.includes(`upstream_assets.${check.key}`)),\n287:       `removing upstream_assets.${check.key} went unnoticed`,\n288:     );\n289: \n290:     const withoutStep = deleteLines(workflowText, (line) => line.includes(`upstream_assets.${check.key}`));\n291:     assert.ok(\n292:       workflowGaps(withoutStep).some((gap) => gap.includes(`no execution step runs upstream_assets.${check.key}`)),\n293:       `removing the ${check.key} step went unnoticed`,\n294:     );\n295: \n296:     const withoutRepair = deleteLines(\n297:       workflowText,\n298:       (line) => line.includes(check.script) && line.includes('->'),\n299:     );\n300:     assert.ok(\n301:       repairGaps(withoutRepair).some((gap) => gap.includes(check.script)),\n302:       `removing the ${check.script} repair line went unnoticed`,\n303:     );\n304:   }\n305: });\n306: \n307: test('the contract fails when a step loses its n/a rule or names no surface', () => {\n308:   const workflowText = read(WORKFLOW_PATH);\n309:   for (const check of MIRROR_CHECKS) {\n310:     const bareStep = workflowText\n311:       .split('\\n')\n312:       .map((line) => {\n313:         if (!line.includes(`upstream_assets.${check.key}`)) return line;\n314:         return line.replace(/\\bn\\/a\\b/g, 'nothing').replace(check.surface, 'the tree');\n315:       })\n316:       .join('\\n');\n317:     const gaps = workflowGaps(bareStep);\n318:     assert.ok(gaps.some((gap) => gap.includes(`the ${check.key} step never reports n/a`)));\n319:     assert.ok(gaps.some((gap) => gap.includes(`the ${check.key} step does not name the ${check.surface} surface`)));\n320:   }\n321: });","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file .skilled/commands/doctor/scripts/tests/doctor-runtime-mirrors-contract.test.cjs, lines 1-321\n1: #!/usr/bin/env node\n2: // ───────────────────────────────────────────────────────────────────\n3: // MODULE: Doctor Runtime Mirrors Contract Tests\n4: // ───────────────────────────────────────────────────────────────────\n5: 'use strict';\n6: \n7: /**\n8:  * The runtime-mirrors route and its workflow are two halves of one contract: the\n9:  * manifest declares which checkers run, and the workflow has to invoke each one\n10:  * in its check-only form. A mirror check the repository's CI runs but this pair\n11:  * omits is the failure mode worth a test, because a local run then reports in\n12:  * sync while the remote run fails on the same tree.\n13:  *\n14:  * DSH and Vibe checks are asserted in the shape their neighbours use,\n15:  * including the n/a rule: an absent runtime tree is reported as n/a rather than\n16:  * created, so a read-only diagnostic never has a write side effect.\n17:  *\n18:  * Both files resolve through an environment override so the removed-line case can\n19:  * be exercised against a copy in a scratch directory instead of by deleting a\n20:  * line from a tracked file.\n21:  */\n22: \n23: // ─────────────────────────────────────────────────────────────────────────────\n24: // 1. IMPORTS AND PATHS\n25: // ─────────────────────────────────────────────────────────────────────────────\n26: \n27: const assert = require('node:assert/strict');\n28: const fs = require('node:fs');\n29: const path = require('node:path');\n30: const test = require('node:test');\n31: const { parse: parseYaml } = require('yaml');\n32: \n33: const REPO_ROOT = path.resolve(__dirname, '..', '..', '..', '..', '..');\n34: const COMMANDS_DIR = path.join(REPO_ROOT, '.skilled', 'commands', 'doctor');\n35: const ASSETS_DIR = path.join(COMMANDS_DIR, 'assets');\n36: const ROUTES_PATH = process.env.DOCTOR_ROUTES_MANIFEST || path.join(COMMANDS_DIR, '_routes.yaml');\n37: const WORKFLOW_PATH =\n38:   process.env.DOCTOR_RUNTIME_MIRRORS_WORKFLOW || path.join(ASSETS_DIR, 'doctor-runtime-mirrors.yaml');\n39: \n40: const ROUTE_TARGET = 'runtime-mirrors';\n41: const AGENT_BODY_PARITY = {\n42:   key: 'agent_body_parity',\n43:   script: '.skilled/bin/check-agent-mirror-sync.cjs',\n44: };\n45: \n46: // Each mirror check names its surface, runtime tree and upstream_assets key. The\n47: // surface and tree are asserted so the diagnostic says what it checks and skips.\n48: const DSH_CHECKS = [\n49:   {\n50:     key: 'dsh_skills',\n51:     script: '.skilled/skills/system-spec-kit/runtime/cli/dsh/sync-skills-dsh.cjs',\n52:     surface: '.dsh/skills',\n53:     tree: '.dsh/',\n54:   },\n55:   {\n56:     key: 'dsh_prompts',\n57:     script: '.skilled/skills/system-spec-kit/runtime/cli/dsh/sync-prompts-dsh.cjs',\n58:     surface: '.dsh/prompts',\n59:     tree: '.dsh/',\n60:   },\n61:   {\n62:     key: 'dsh_agents',\n63:     script: '.skilled/skills/system-spec-kit/runtime/cli/dsh/sync-agents-dsh.cjs',\n64:     surface: '.dsh/agents',\n65:     tree: '.dsh/',\n66:   },\n67: ];\n68: const VIBE_CHECKS = [\n69:   {\n70:     key: 'vibe_prompts',\n71:     script: '.skilled/skills/system-spec-kit/runtime/cli/vibe/sync-prompts-vibe.cjs',\n72:     surface: '.vibe/prompts',\n73:     tree: '.vibe/',\n74:   },\n75:   {\n76:     key: 'vibe_agents',\n77:     script: '.skilled/skills/system-spec-kit/runtime/cli/vibe/sync-agents-vibe.cjs',\n78:     surface: '.vibe/agents',\n79:     tree: '.vibe/',\n80:   },\n81:   {\n82:     key: 'vibe_skills',\n83:     script: '.skilled/skills/system-spec-kit/runtime/cli/vibe/sync-skills-vibe.cjs',\n84:     surface: '.vibe/skills',\n85:     tree: '.vibe/',\n86:   },\n87: ];\n88: const MIRROR_CHECKS = [...DSH_CHECKS, ...VIBE_CHECKS];\n89: \n90: // ─────────────────────────────────────────────────────────────────────────────\n91: // 2. READERS AND SMALL HELPERS\n92: // ─────────────────────────────────────────────────────────────────────────────\n93: \n94: function read(absolutePath) {\n95:   return fs.readFileSync(absolutePath, 'utf8');\n96: }\n97: \n98: function tokens(entry) {\n99:   return String(entry).split(/\\s+/).filter(Boolean);\n100: }\n101: \n102: function deleteLines(source, predicate) {\n103:   return source.split('\\n').filter((line) => !predicate(line)).join('\\n');\n104: }\n105: \n106: function runtimeMirrorsRoute(manifestText) {\n107:   const manifest = parseYaml(manifestText);\n108:   const routes = manifest && Array.isArray(manifest.routes) ? manifest.routes : [];\n109:   const route = routes.find((entry) => entry && entry.target === ROUTE_TARGET);\n110:   assert.ok(route, `no route with target '${ROUTE_TARGET}' in ${ROUTES_PATH}`);\n111:   return route;\n112: }\n113: \n114: // ─────────────────────────────────────────────────────────────────────────────\n115: // 3. GAP DETECTION, PURE SO A REMOVED LINE IS OBSERVABLE\n116: // ─────────────────────────────────────────────────────────────────────────────\n117: \n118: /** Manifest gaps: a mirror check missing from script_invocations, or not check-only. */\n119: function routeGaps(manifestText) {\n120:   const route = runtimeMirrorsRoute(manifestText);\n121:   const invocations = Array.isArray(route.script_invocations) ? route.script_invocations : [];\n122:   const gaps = [];\n123:   for (const check of MIRROR_CHECKS) {\n124:     const entry = invocations.find((invocation) => tokens(invocation).includes(check.script));\n125:     if (!entry) {\n126:       gaps.push(`script_invocations never runs ${check.script}`);\n127:       continue;\n128:     }\n129:     if (tokens(entry)[0] !== 'node') {\n130:       gaps.push(`${check.script} is not invoked through node`);\n131:     }\n132:     if (!tokens(entry).includes('--check')) {\n133:       gaps.push(`${check.script} is not in its --check form`);\n134:     }\n135:   }\n136:   return gaps;\n137: }\n138: \n139: /** Workflow gaps: no upstream_assets entry, or no step with the surface and n/a rule. */\n140: function workflowGaps(workflowText) {\n141:   const document = parseYaml(workflowText);\n142:   const assets = (document && document.upstream_assets) || {};\n143:   const steps = document && document.execution && Array.isArray(document.execution.steps)\n144:     ? document.execution.steps\n145:     : [];\n146:   const gaps = [];\n147: \n148:   for (const check of MIRROR_CHECKS) {\n149:     if (assets[check.key] !== check.script) {\n150:       gaps.push(`upstream_assets.${check.key} does not name ${check.script}`);\n151:     }\n152: \n153:     const step = steps.find((entry) => typeof entry === 'string' && entry.includes(`upstream_assets.${check.key}`));\n154:     if (!step) {\n155:       gaps.push(`no execution step runs upstream_assets.${check.key}`);\n156:       continue;\n157:     }\n158:     if (!step.includes('--check')) {\n159:       gaps.push(`the ${check.key} step does not run the check-only form`);\n160:     }\n161:     if (!step.includes(check.surface)) {\n162:       gaps.push(`the ${check.key} step does not name the ${check.surface} surface it covers`);\n163:     }\n164:     if (!/\\bn\\/a\\b/.test(step)) {\n165:       gaps.push(`the ${check.key} step never reports n/a`);\n166:     }\n167:     if (!step.includes(check.tree)) {\n168:       gaps.push(`the ${check.key} step never names the ${check.tree} tree whose absence makes it n/a`);\n169:     }\n170:     if (!/never creates/i.test(step)) {\n171:       gaps.push(`the ${check.key} step does not say the run never creates ${check.tree}`);\n172:     }\n173:   }\n174:   return gaps;\n175: }\n176: \n177: /** Output gaps: no repair line, a repair line that is the check form, or an unrendered one. */\n178: function repairGaps(workflowText) {\n179:   const document = parseYaml(workflowText);\n180:   const outputLines = String((document && document.output) || '').split('\\n');\n181:   const gaps = [];\n182: \n183:   for (const check of MIRROR_CHECKS) {\n184:     const line = outputLines.find((candidate) => candidate.includes(check.script));\n185:     if (!line) {\n186:       gaps.push(`the output block carries no repair line for ${check.script}`);\n187:       continue;\n188:     }\n189:     if (line.includes('--check')) {\n190:       gaps.push(`the repair line for ${check.script} is the check form, not the generator`);\n191:     }\n192:     if (!line.includes('->')) {\n193:       gaps.push(`the repair line for ${check.script} is not rendered as \"<surface> -> <command>\"`);\n194:     }\n195:   }\n196:   return gaps;\n197: }\n198: \n199: // ─────────────────────────────────────────────────────────────────────────────\n200: // 4. THE MANIFEST AND WORKFLOW AS THEY SHIP\n201: // ─────────────────────────────────────────────────────────────────────────────\n202: \n203: test('the route declares all DSH checks in their check-only form', () => {\n204:   assert.deepEqual(routeGaps(read(ROUTES_PATH)), []);\n205: });\n206: \n207: test('the workflow names all mirror checks and reports n/a when a runtime tree is absent', () => {\n208:   assert.deepEqual(workflowGaps(read(WORKFLOW_PATH)), []);\n209: });\n210: \n211: test('agent body parity runs after the roster check and reports its comparison outcomes', () => {\n212:   const route = runtimeMirrorsRoute(read(ROUTES_PATH));\n213:   const invocation = (route.script_invocations || []).find((entry) => tokens(entry).includes(AGENT_BODY_PARITY.script));\n214:   assert.ok(invocation, `script_invocations never runs ${AGENT_BODY_PARITY.script}`);\n215:   assert.equal(tokens(invocation)[0], 'node');\n216:   assert.ok(tokens(invocation).includes('--all'));\n217: \n218:   const workflow = parseYaml(read(WORKFLOW_PATH));\n219:   assert.equal(workflow.upstream_assets[AGENT_BODY_PARITY.key], AGENT_BODY_PARITY.script);\n220:   const steps = workflow.execution.steps;\n221:   const rosterIndex = steps.findIndex((step) => step.includes('upstream_assets.agent_roster'));\n222:   const parityIndex = steps.findIndex((step) => step.includes(`upstream_assets.${AGENT_BODY_PARITY.key}`));\n223:   assert.ok(rosterIndex >= 0, 'the workflow has no agent roster step');\n224:   assert.equal(parityIndex, rosterIndex + 1, 'agent body parity follows the agent roster step');\n225: \n226:   const step = steps[parityIndex];\n227:   assert.match(step, /with --all/);\n228:   assert.match(step, /same-file mirrors and non-comparable formats are reported, not counted as matches/i);\n229:   assert.match(step, /Exit 0 = all comparable mirrors in sync/);\n230:   assert.match(step, /1 = drift or comparison failure/);\n231:   assert.match(step, /2 = checker invocation error \\(unknown option\\)/);\n232:   assert.match(step, /3 = not checkable \\(frontmatter parser unavailable\\)/);\n233: });\n234: \n235: test('the output block carries a generator repair line for every mirror check', () => {\n236:   assert.deepEqual(repairGaps(read(WORKFLOW_PATH)), []);\n237: });\n238: \n239: test('agent body parity output names the real-file and generated mirror repairs', () => {\n240:   const output = String(parseYaml(read(WORKFLOW_PATH)).output || '');\n241:   const repair = output.split('\\n').find((line) => line.includes(AGENT_BODY_PARITY.script));\n242:   assert.ok(repair, 'agent body parity has a repair line');\n243:   assert.match(repair, /\\.claude\\/agents is a hand-maintained real-file mirror/u);\n244:   assert.match(repair, /runtime\\/cli\\/codex\\/sync-agents\\.cjs/u);\n245:   assert.match(repair, /runtime\\/cli\\/pi\\/sync-agents-pi\\.cjs/u);\n246:   assert.match(repair, /runtime\\/cli\\/runtime-mirrors\\/sync-runtime-mirrors\\.cjs/u);\n247: });\n248: \n249: test('the route stays read-only and never runs a mirror generator in write mode', () => {\n250:   const route = runtimeMirrorsRoute(read(ROUTES_PATH));\n251:   assert.equal(route.mutating, 'read-only');\n252: \n253:   const writers = (route.script_invocations || []).filter((entry) => {\n254:     const parts = tokens(entry);\n255:     const namesGenerator = parts.some((token) => /(?:^|\\/)(?:sync-|install-)[\\w.-]+\\.(?:cjs|mjs)$/.test(token));\n256:     return namesGenerator && !parts.includes('--check');\n257:   });\n258:   assert.deepEqual(writers, [], 'every generator invocation must carry --check');\n259: \n260:   const boundaries = parseYaml(read(WORKFLOW_PATH)).mutation_boundaries || {};\n261:   assert.equal(boundaries.read_only, true);\n262:   assert.ok((boundaries.forbidden_targets || []).includes('**/*'));\n263: });\n264: \n265: // ─────────────────────────────────────────────────────────────────────────────\n266: // 5. THE CONTRACT FAILS WHEN EITHER LINE GOES MISSING\n267: // ─────────────────────────────────────────────────────────────────────────────\n268: \n269: test('the contract fails when a mirror line is removed from the route', () => {\n270:   const manifestText = read(ROUTES_PATH);\n271:   for (const check of MIRROR_CHECKS) {\n272:     const stripped = deleteLines(manifestText, (line) => line.includes(check.script));\n273:     const gaps = routeGaps(stripped);\n274:     assert.ok(\n275:       gaps.some((gap) => gap.includes(check.script)),\n276:       `removing ${check.script} from script_invocations went unnoticed`,\n277:     );\n278:   }\n279: });\n280: \n281: test('the contract fails when a mirror asset, step or repair line leaves the workflow', () => {\n282:   const workflowText = read(WORKFLOW_PATH);\n283:   for (const check of MIRROR_CHECKS) {\n284:     const withoutAsset = deleteLines(workflowText, (line) => line.includes(check.script));\n285:     assert.ok(\n286:       workflowGaps(withoutAsset).some((gap) => gap.includes(`upstream_assets.${check.key}`)),\n287:       `removing upstream_assets.${check.key} went unnoticed`,\n288:     );\n289: \n290:     const withoutStep = deleteLines(workflowText, (line) => line.includes(`upstream_assets.${check.key}`));\n291:     assert.ok(\n292:       workflowGaps(withoutStep).some((gap) => gap.includes(`no execution step runs upstream_assets.${check.key}`)),\n293:       `removing the ${check.key} step went unnoticed`,\n294:     );\n295: \n296:     const withoutRepair = deleteLines(\n297:       workflowText,\n298:       (line) => line.includes(check.script) && line.includes('->'),\n299:     );\n300:     assert.ok(\n301:       repairGaps(withoutRepair).some((gap) => gap.includes(check.script)),\n302:       `removing the ${check.script} repair line went unnoticed`,\n303:     );\n304:   }\n305: });\n306: \n307: test('the contract fails when a step loses its n/a rule or names no surface', () => {\n308:   const workflowText = read(WORKFLOW_PATH);\n309:   for (const check of MIRROR_CHECKS) {\n310:     const bareStep = workflowText\n311:       .split('\\n')\n312:       .map((line) => {\n313:         if (!line.includes(`upstream_assets.${check.key}`)) return line;\n314:         return line.replace(/\\bn\\/a\\b/g, 'nothing').replace(check.surface, 'the tree');\n315:       })\n316:       .join('\\n');\n317:     const gaps = workflowGaps(bareStep);\n318:     assert.ok(gaps.some((gap) => gap.includes(`the ${check.key} step never reports n/a`)));\n319:     assert.ok(gaps.some((gap) => gap.includes(`the ${check.key} step does not name the ${check.surface} surface`)));\n320:   }\n321: });"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\".skilled/commands/doctor/scripts/tests/doctor-runtime-mirrors-contract.test.cjs\"}"},"time":{"start":1794761131586,"end":1794761131882}}}}
