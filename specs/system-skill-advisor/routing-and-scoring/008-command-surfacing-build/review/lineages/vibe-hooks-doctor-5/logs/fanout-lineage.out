{"type":"tool_use","timestamp":1794761478238,"sessionID":"ses_e1feefdd5ffeHQJCqAmpoKpkZG","part":{"partID":"prt_1e01ecdd9001gLIsBgPlmzwitM","sessionID":"ses_e1feefdd5ffeHQJCqAmpoKpkZG","messageID":"msg_1e01eb6d6001YMfoe34pymr3lV","type":"tool","id":"call_0fe8f62c44844e1cb3957591","tool":"shell","state":{"status":"completed","input":{"command":"sed -n '190,275p' .opencode/plugins/system-skill-advisor.js; echo \"=== where used\"; grep -n \"isDisabled\\|disabledReason\\|DISABLED_ENV\" .opencode/plugins/system-skill-advisor.js | head -30"},"output":"// ─────────────────────────────────────────────────────────────────────────────\n// 3. PURE UTILITIES\n// ─────────────────────────────────────────────────────────────────────────────\n\nfunction normalizePositiveInt(value, fallback) {\n  return Number.isFinite(value) && value > 0 ? Math.trunc(value) : fallback;\n}\n\nfunction normalizeThreshold(value) {\n  if (!Number.isFinite(value)) {\n    return DEFAULT_THRESHOLD_CONFIDENCE;\n  }\n  return Math.min(1, Math.max(0, Number(value)));\n}\n\nfunction envDisablesPlugin() {\n  return !isHookEnabled('skill-advisor');\n}\n\nfunction isDirectiveLifecycleDedupEnabled() {\n  const value = process.env[DIRECTIVE_LIFECYCLE_DEDUP_ENV]?.trim().toLowerCase();\n  return value !== '0' && value !== 'false' && value !== 'off' && value !== 'no';\n}\n\nfunction splitDirectiveBrief(context) {\n  const index = context.indexOf(DIRECTIVE_SEPARATOR);\n  // index <= 0 means no directive block or no non-empty head before it.\n  if (index <= 0) return null;\n  return { head: context.slice(0, index), directives: context.slice(index) };\n}\n\n/** Reduce policy only for one primitive, non-conflicting session identity. */\nfunction decideOpenCodeDirectiveLifecycle(brief, identity, lifecycleEvent, state) {\n  if (!isDirectiveLifecycleDedupEnabled() || !identity.confirmed) {\n    return { suppressed: false, reduced: null };\n  }\n  const parts = splitDirectiveBrief(brief);\n  if (!parts?.head.trim()) return { suppressed: false, reduced: null };\n\n  const sessionID = identity.sessionID;\n  const generation = state.directiveGeneration;\n  const epoch = state.directiveEpochBySession.get(sessionID) ?? 0;\n  const boundary = lifecycleEvent === 'startup'\n    || lifecycleEvent === 'resume'\n    || lifecycleEvent === 'compact';\n  const last = state.directiveDedupBySession.get(sessionID);\n  if (boundary\n    || !last\n    || last.directives !== parts.directives\n    || last.generation !== generation\n    || last.epoch !== epoch) {\n    while (state.directiveDedupBySession.size >= MAX_DIRECTIVE_DEDUP_SESSIONS) {\n      const oldest = state.directiveDedupBySession.keys().next().value;\n      if (typeof oldest !== 'string') break;\n      state.directiveDedupBySession.delete(oldest);\n    }\n    state.directiveDedupBySession.set(sessionID, {\n      directives: parts.directives,\n      generation,\n      epoch,\n    });\n    return { suppressed: false, reduced: null };\n  }\n  return { suppressed: true, reduced: parts.head };\n}\n\nfunction disabledEnvName() {\n  if (process.env[DISABLED_ENV] === '1') {\n    return DISABLED_ENV;\n  }\n  if (process.env[DISABLED_ENV_PLUGIN] === '1') {\n    return DISABLED_ENV_PLUGIN;\n  }\n  if (process.env[LEGACY_HOOK_DISABLED_ENV] === '1') {\n    return LEGACY_HOOK_DISABLED_ENV;\n  }\n  if (process.env[LEGACY_PLUGIN_DISABLED_ENV] === '1') {\n    return LEGACY_PLUGIN_DISABLED_ENV;\n  }\n  return null;\n}\n\n// The signature runs on every advisor lookup, so the digest of a file whose\n// identity is unchanged is reused instead of read and hashed again. A difference\n// in mtimeMs, ctimeMs, size or ino falls back to the read, and a stat or read\n// failure stays missing.\n=== where used\n63:const DISABLED_ENV = 'SYSTEM_SKILL_ADVISOR_HOOK_DISABLED';\n64:const DISABLED_ENV_PLUGIN = 'SYSTEM_SKILL_ADVISOR_PLUGIN_DISABLED';\n65:const LEGACY_HOOK_DISABLED_ENV = 'SPECKIT_SKILL_ADVISOR_HOOK_DISABLED';\n66:const LEGACY_PLUGIN_DISABLED_ENV = 'SPECKIT_SKILL_ADVISOR_PLUGIN_DISABLED';\n257:  if (process.env[DISABLED_ENV] === '1') {\n258:    return DISABLED_ENV;\n260:  if (process.env[DISABLED_ENV_PLUGIN] === '1') {\n261:    return DISABLED_ENV_PLUGIN;\n263:  if (process.env[LEGACY_HOOK_DISABLED_ENV] === '1') {\n264:    return LEGACY_HOOK_DISABLED_ENV;\n266:  if (process.env[LEGACY_PLUGIN_DISABLED_ENV] === '1') {\n267:    return LEGACY_PLUGIN_DISABLED_ENV;\n1103:    disabledReason: !options.enabled\n1414:    state.disabledReason = !options.enabled\n1681:            `disabled_reason=${state.disabledReason ?? 'none'}`,\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"// ─────────────────────────────────────────────────────────────────────────────\n// 3. PURE UTILITIES\n// ─────────────────────────────────────────────────────────────────────────────\n\nfunction normalizePositiveInt(value, fallback) {\n  return Number.isFinite(value) && value > 0 ? Math.trunc(value) : fallback;\n}\n\nfunction normalizeThreshold(value) {\n  if (!Number.isFinite(value)) {\n    return DEFAULT_THRESHOLD_CONFIDENCE;\n  }\n  return Math.min(1, Math.max(0, Number(value)));\n}\n\nfunction envDisablesPlugin() {\n  return !isHookEnabled('skill-advisor');\n}\n\nfunction isDirectiveLifecycleDedupEnabled() {\n  const value = process.env[DIRECTIVE_LIFECYCLE_DEDUP_ENV]?.trim().toLowerCase();\n  return value !== '0' && value !== 'false' && value !== 'off' && value !== 'no';\n}\n\nfunction splitDirectiveBrief(context) {\n  const index = context.indexOf(DIRECTIVE_SEPARATOR);\n  // index <= 0 means no directive block or no non-empty head before it.\n  if (index <= 0) return null;\n  return { head: context.slice(0, index), directives: context.slice(index) };\n}\n\n/** Reduce policy only for one primitive, non-conflicting session identity. */\nfunction decideOpenCodeDirectiveLifecycle(brief, identity, lifecycleEvent, state) {\n  if (!isDirectiveLifecycleDedupEnabled() || !identity.confirmed) {\n    return { suppressed: false, reduced: null };\n  }\n  const parts = splitDirectiveBrief(brief);\n  if (!parts?.head.trim()) return { suppressed: false, reduced: null };\n\n  const sessionID = identity.sessionID;\n  const generation = state.directiveGeneration;\n  const epoch = state.directiveEpochBySession.get(sessionID) ?? 0;\n  const boundary = lifecycleEvent === 'startup'\n    || lifecycleEvent === 'resume'\n    || lifecycleEvent === 'compact';\n  const last = state.directiveDedupBySession.get(sessionID);\n  if (boundary\n    || !last\n    || last.directives !== parts.directives\n    || last.generation !== generation\n    || last.epoch !== epoch) {\n    while (state.directiveDedupBySession.size >= MAX_DIRECTIVE_DEDUP_SESSIONS) {\n      const oldest = state.directiveDedupBySession.keys().next().value;\n      if (typeof oldest !== 'string') break;\n      state.directiveDedupBySession.delete(oldest);\n    }\n    state.directiveDedupBySession.set(sessionID, {\n      directives: parts.directives,\n      generation,\n      epoch,\n    });\n    return { suppressed: false, reduced: null };\n  }\n  return { suppressed: true, reduced: parts.head };\n}\n\nfunction disabledEnvName() {\n  if (process.env[DISABLED_ENV] === '1') {\n    return DISABLED_ENV;\n  }\n  if (process.env[DISABLED_ENV_PLUGIN] === '1') {\n    return DISABLED_ENV_PLUGIN;\n  }\n  if (process.env[LEGACY_HOOK_DISABLED_ENV] === '1') {\n    return LEGACY_HOOK_DISABLED_ENV;\n  }\n  if (process.env[LEGACY_PLUGIN_DISABLED_ENV] === '1') {\n    return LEGACY_PLUGIN_DISABLED_ENV;\n  }\n  return null;\n}\n\n// The signature runs on every advisor lookup, so the digest of a file whose\n// identity is unchanged is reused instead of read and hashed again. A difference\n// in mtimeMs, ctimeMs, size or ino falls back to the read, and a stat or read\n// failure stays missing.\n=== where used\n63:const DISABLED_ENV = 'SYSTEM_SKILL_ADVISOR_HOOK_DISABLED';\n64:const DISABLED_ENV_PLUGIN = 'SYSTEM_SKILL_ADVISOR_PLUGIN_DISABLED';\n65:const LEGACY_HOOK_DISABLED_ENV = 'SPECKIT_SKILL_ADVISOR_HOOK_DISABLED';\n66:const LEGACY_PLUGIN_DISABLED_ENV = 'SPECKIT_SKILL_ADVISOR_PLUGIN_DISABLED';\n257:  if (process.env[DISABLED_ENV] === '1') {\n258:    return DISABLED_ENV;\n260:  if (process.env[DISABLED_ENV_PLUGIN] === '1') {\n261:    return DISABLED_ENV_PLUGIN;\n263:  if (process.env[LEGACY_HOOK_DISABLED_ENV] === '1') {\n264:    return LEGACY_HOOK_DISABLED_ENV;\n266:  if (process.env[LEGACY_PLUGIN_DISABLED_ENV] === '1') {\n267:    return LEGACY_PLUGIN_DISABLED_ENV;\n1103:    disabledReason: !options.enabled\n1414:    state.disabledReason = !options.enabled\n1681:            `disabled_reason=${state.disabledReason ?? 'none'}`,\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"sed -n '190,275p' .opencode/plugins/system-skill-advisor.js; echo \\\"=== where used\\\"; grep -n \\\"isDisabled\\\\|disabledReason\\\\|DISABLED_ENV\\\" .opencode/plugins/system-skill-advisor.js | head -30\"}"},"time":{"start":1794761477593,"end":1794761478238}}}}
