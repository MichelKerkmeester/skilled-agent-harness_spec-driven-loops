ENV-REFERENCE.md\", \".skilled/hooks/shared/hook-flags.cjs\"],\n      \"searchActions\": [\n        {\n          \"method\": \"read_only_probe\",\n          \"queryOrPath\": \"node -e hookFlagDecision('skill-advisor', {MK_*:'1'}, {})\",\n          \"result\": \"MK_HOOKS_DISABLED reason=master; MK_SKILL_ADVISOR_DISABLED, MK_SKILL_ADVISOR_HOOK_DISABLED and MK_SKILL_ADVISOR_PLUGIN_DISABLED reason=kill\",\n          \"evidenceRefs\": [\".skilled/hooks/shared/hook-flags.cjs:38-41\", \".skilled/hooks/shared/hook-flags.cjs:64-78\"]\n        },\n        {\n          \"method\": \"exact_search\",\n          \"queryOrPath\": \"rg -n \\\"MK_SKILL_ADVISOR|MK_HOOKS_DISABLED\\\" .skilled/hooks/README.md\",\n          \"result\": \"no hit: the four names appear nowhere in the file\",\n          \"evidenceRefs\": [\".skilled/hooks/README.md:36\", \".skilled/hooks/README.md:40\", \".skilled/hooks/README.md:44\"]\n        }\n      ]\n    },\n    {\n      \"id\": \"SL-502\",\n      \"bugClass\": \"module_map_drift\",\n      \"dimension\": \"correctness\",\n      \"hypothesis\": \"A module map section omits an entry that exists in the tree it describes.\",\n      \"disposition\": \"confirmed\",\n      \"rationale\": \"Section 3 lists thirteen of fourteen folders; skill-graph/ is in section 4 and on disk.\",\n      \"targetRefs\": [\".skilled/skills/system-skill-advisor/runtime/lib/README.md\"],\n      \"searchActions\": [\n        {\n          \"method\": \"git_diff_range\",\n          \"queryOrPath\": \"git ls-tree --name-only d21dbc1cafe .skilled/skills/system-skill-advisor/runtime/lib/\",\n          \"result\": \"fourteen folders and twenty-two flat modules; section 4 matches all of them, section 3 is one folder short\",\n          \"evidenceRefs\": [\".skilled/skills/system-skill-advisor/runtime/lib/README.md:57-76\", \".skilled/skills/system-skill-advisor/runtime/lib/README.md:98-136\"]\n        }\n      ]\n    },\n    {\n      \"id\": \"SL-503\",\n      \"bugClass\": \"switch_bypass\",\n      \"dimension\": \"security\",\n      \"hypothesis\": \"The widened fixtures or the widened doc claims leave a path that disables the advisor without being listed, or a listed path that fails to disable it.\",\n      \"disposition\": \"ruled_out\",\n      \"rationale\": \"DEFAULT_OFF carries only session-handover, so the ten env names are the complete switch set; the master and legacy loops cover all of them.\",\n      \"ruledOutReason\": \"No enable switch exists for the advisor and every listed name resolves to a disable decision.\",\n      \"targetRefs\": [\".skilled/hooks/shared/hook-flags.cjs\", \".skilled/skills/system-skill-advisor/runtime/lib/advisor-disabled.ts\"],\n      \"searchActions\": [\n        {\n          \"method\": \"direct_read\",\n          \"queryOrPath\": \".skilled/hooks/shared/hook-flags.cjs:104-106,230-285\",\n          \"result\": \"the decision reads master, canonical and legacy aliases only; DEFAULT_OFF has one entry and it is session-handover\",\n          \"evidenceRefs\": [\".skilled/hooks/shared/hook-flags.cjs:104-106\", \".skilled/hooks/shared/hook-flags.cjs:256-271\"]\n        }\n      ]\n    },\n    {\n      \"id\": \"SL-504\",\n      \"bugClass\": \"fixture_narrowing\",\n      \"dimension\": \"correctness\",\n      \"hypothesis\": \"The launcher fixture still sets fewer names than the constant it claims to cover, or passes vacuously when the constant is empty.\",\n      \"disposition\": \"ruled_out\",\n      \"rationale\": \"The fixture derives from ADVISOR_DISABLED_FLAGS and asserts ten entries before the env assertion, so an empty or short constant fails loudly.\",\n      \"ruledOutReason\": \"The size assertion runs first and the child env assertion is exact.\",\n      \"targetRefs\": [\".skilled/skills/system-skill-advisor/runtime/tests/launcher-bootstrap.vitest.ts\"],\n      \"searchActions\": [\n        {\n          \"method\": \"direct_read\",\n          \"queryOrPath\": \".skilled/skills/system-skill-advisor/