"reviewDepthSchemaVersion\\\": 2,\\n  \\\"reviewDepthApplicability\\\": {\\n    \\\"enforcement\\\": \\\"strict\\\",\\n    \\\"scopeClass\\\": \\\"standard\\\",\\n    \\\"reason\\\": \\\"Security half reads a trust boundary (env passed to a spawned daemon) and the test isolation that pins it; the fix files are unchanged since iteration 1.\\\",\\n    \\\"evidenceRefs\\\": [\\\"review-scope-5b.txt:14,16,28-29,30\\\", \\\"review-brief-5b.txt:1\\\", \\\"verify-5/report.md:20-27\\\"]\\n  },\\n  \\\"targetSelection\\\": {\\n    \\\"discoveryMethods\\\": [\\\"direct_read\\\", \\\"exact_search\\\"],\\n    \\\"evidenceRefs\\\": [\\\"review-scope-5b.txt:14,16,28-29,30\\\", \\\"review-brief-5b.txt:1\\\"],\\n    \\\"graphStatus\\\": \\\"unavailable\\\",\\n    \\\"semanticSearchStatus\\\": \\\"unavailable\\\",\\n    \\\"selectedTargets\\\": [\\n      \\\".skilled/bin/system-skill-advisor-launcher.cjs\\\",\\n      \\\".skilled/skills/system-skill-advisor/runtime/tests/skill-advisor-cli-test-utils.ts\\\",\\n      \\\".skilled/skills/system-skill-advisor/runtime/tests/launcher-bootstrap.vitest.ts\\\",\\n      \\\".skilled/skills/system-skill-advisor/runtime/tests/skill-advisor-cli-stale-daemon-retry.vitest.ts\\\",\\n      \\\".skilled/hooks/shared/hook-flags.cjs\\\"\\n    ],\\n    \\\"omittedHighRiskTargets\\\": [\\n      \\\"holdout prompt text (counted only, never opened)\\\",\\n      \\\"hooks/vibe/prompt-advisor.mjs (vibe-hooks-doctor area in the same round)\\\"\\n    ],\\n    \\\"selectionReason\\\": \\\"The security dimension needs the trust boundary the launcher owns and the isolation the tests rely on; both are named integration surfaces of the two test files in scope.\\\"\\n  },\\n  \\\"searchCoverage\\\": {\\n    \\\"graphCoverageMode\\\": \\\"graphless_fallback\\\",\\n    \\\"covered\\\": [\\\"switch_leak\\\", \\\"test_isolation\\\", \\\"prompt_leak\\\", \\\"duplicate_alias_list\\\"],\\n    \\\"requiredBugClasses\\\": [\\\"switch_leak\\\", \\\"test_isolation\\\", \\\"duplicate_alias_list\\\"],\\n    \\\"ruledOut\\\": [\\\"switch_leak\\\", \\\"test_isolation\\\", \\\"prompt_leak\\\", \\\"duplicate_alias_list\\\"],\\n    \\\"deferred\\\": [],\\n    \\\"blocked\\\": []\\n  },\\n  \\\"searchLedger\\\": [\\n    {\\n      \\\"id\\\": \\\"SL-505\\\",\\n      \\\"bugClass\\\": \\\"switch_leak\\\",\\n      \\\"dimension\\\": \\\"security\\\",\\n      \\\"hypothesis\\\": \\\"A caller's switch name reaches the shared daemon child env and silences later callers.\\\",\\n      \\\"disposition\\\": \\\"ruled_out\\\",\\n      \\\"rationale\\\": \\\"Child env membership is an exact set with no switch name in it, and the fixture asserts all ten are dropped.\\\",\\n      \\\"ruledOutReason\\\": \\\"Exact-set allowlist and an exact child-env assertion.\\\",\\n      \\\"targetRefs\\\": [\\\".skilled/bin/system-skill-advisor-launcher.cjs\\\", \\\".skilled/skills/system-skill-advisor/runtime/tests/launcher-bootstrap.vitest.ts\\\"],\\n      \\\"searchActions\\\": [\\n        {\\n          \\\"method\\\": \\\"direct_read\\\",\\n          \\\"queryOrPath\\\": \\\".skilled/bin/system-skill-advisor-launcher.cjs:131-180,312-315\\\",\\n          \\\"result\\\": \\\"CHILD_ENV_ALLOWLIST has no *_DISABLED key and the filter is Set membership\\\",\\n          \\\"evidenceRefs\\\": [\\\".skilled/bin/system-skill-advisor-launcher.cjs:131-180\\\", \\\".skilled/bin/system-skill-advisor-launcher.cjs:312-315\\\"]\\n        }\\n      ]\\n    },\\n    {\\n      \\\"id\\\": \\\"SL-506\\\",\\n      \\\"bugClass\\\": \\\"test_isolation\\\",\\n      \\\"dimension\\\": \\\"maintainability\\\",\\n      \\\"hypothesis\\\": \\\"The three added MK_ cases share a socket or inherit a developer flags file, so they pass or fail for the wrong reason.\\\",\\n      \\\"disposition\\\": \\\"ruled_out\\\",\\n      \\\"rationale\\\": \\\"Each scope gets its own mkdtemp root and names a HOOK_FLAGS_CONFIG that does not exist.\\\",\\n      \\\"ruledOutReason\\\": \\\"Per-case temp root and a mi