"graphless_fallback\",\n    \"requiredBugClasses\": [\n      \"switch_bypass\",\n      \"prompt_leak\",\n      \"daemon_environment_leak\",\n      \"workspace_root_bypass\"\n    ],\n    \"ruledOut\": [\n      \"switch_bypass\",\n      \"prompt_leak\",\n      \"daemon_environment_leak\",\n      \"workspace_root_bypass\"\n    ]\n  },\n  \"searchLedger\": [\n    {\n      \"bugClass\": \"switch_bypass\",\n      \"dimension\": \"correctness\",\n      \"disposition\": \"ruled_out\",\n      \"hypothesis\": \"A switch name or a CLI path can reach the daemon or the local scorer before the disabled decision runs.\",\n      \"id\": \"SL-201\",\n      \"rationale\": \"The switch decision runs before any daemon or scorer path, and the no-daemon test pins it.\",\n      \"ruledOutReason\": \"Both call sites check before the I/O path.\",\n      \"searchActions\": [\n        {\n          \"evidenceRefs\": [\n            \"advisor-disabled.ts:85\",\n            \"skill-advisor-cli.ts:1540\",\n            \"advisor-recommend.ts:646\"\n          ],\n          \"method\": \"direct_read\",\n          \"queryOrPath\": \"advisor-disabled.ts:85-93; skill-advisor-cli.ts:1535-1543; advisor-recommend.ts:643-646\",\n          \"result\": \"the CLI check is the first statement in invokeAdvisorRecommendPayload; the handler check precedes computeRecommendationOutput\"\n        },\n        {\n          \"evidenceRefs\": [\n            \"skill-advisor-cli-stale-daemon-retry.vitest.ts:303-317\"\n          ],\n          \"method\": \"direct_read\",\n          \"queryOrPath\": \"skill-advisor-cli-stale-daemon-retry.vitest.ts:303-317\",\n          \"result\": \"no launcher pid and no socket are created under a switch\"\n        }\n      ],\n      \"targetRefs\": [\n        \"runtime/lib/advisor-disabled.ts\",\n        \"runtime/skill-advisor-cli.ts\",\n        \"runtime/handlers/advisor-recommend.ts\"\n      ]\n    },\n    {\n      \"bugClass\": \"prompt_leak\",\n      \"dimension\": \"security\",\n    