{"type":"tool_use","timestamp":1794780711110,"sessionID":"ses_e1ebd75cbffeZfELy9ETJ0Z0Sg","part":{"partID":"prt_1e14446f6001UMoeC5AIhhZPKL","sessionID":"ses_e1ebd75cbffeZfELy9ETJ0Z0Sg","messageID":"msg_1e1440515001UP0oYT7bKzG5eJ","type":"tool","id":"call_4dc641a514584665aa121f37","tool":"shell","state":{"status":"completed","input":{"command":"cd /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research && sed -n '1,80p' .skilled/skills/system-skill-advisor/runtime/lib/advisor-disabled.ts"},"output":"// ───────────────────────────────────────────────────────────────\n// MODULE: Advisor Disabled Switch\n// ───────────────────────────────────────────────────────────────\n// The switch belongs to whoever makes the request. The handler reads it in the\n// daemon and the CLI client reads it in the caller's own process before it\n// connects, so both build the same envelope here. The client cannot import the\n// handler because the handler loads the native database module and the scorer.\n// The rule itself is the hooks' resolver, so the direct call abstains exactly\n// when the prompt hooks do.\n\n// ───────────────────────────────────────────────────────────────────\n// 1. IMPORTS\n// ───────────────────────────────────────────────────────────────────\n\nimport { existsSync, realpathSync } from 'node:fs';\nimport { createRequire } from 'node:module';\nimport { dirname, join, resolve } from 'node:path';\nimport { fileURLToPath } from 'node:url';\n\nimport {\n  AdvisorRecommendOutputSchema,\n  type AdvisorRecommendOutput,\n} from '../schemas/advisor-tool-schemas.js';\nimport {\n  resolvedConfidenceThreshold,\n  resolvedUncertaintyThreshold,\n} from './compat/contract.js';\nimport { findAdvisorWorkspaceRoot } from './utils/workspace-root.js';\n\n// ───────────────────────────────────────────────────────────────────\n// 2. HELPERS\n// ───────────────────────────────────────────────────────────────────\n\ntype PublicThresholds = AdvisorRecommendOutput['effectiveThresholds'];\n\ninterface HookFlagsResolver {\n  hookFlagDecision(\n    concern: string,\n    env?: NodeJS.ProcessEnv,\n    config?: Readonly<Record<string, string>>,\n  ): { enabled: boolean; key: string | null };\n  loadConfigFile(path: string): Record<string, string>;\n  configPath(): string;\n  concernFlag(concern: string): string | null;\n  MASTER_FLAG: string;\n  MASTER_ALIASES: readonly string[];\n  LEGACY_ALIASES: Readonly<Record<string, readonly string[]>>;\n}\n\n// The source and the built module sit at different depths below .skilled, so the\n// resolver is found by walking up rather than by counting parent hops. A missing\n// resolver answers as if no switch were set, as every adapter does.\nfunction loadHookFlags(): HookFlagsResolver | null {\n  let folder = dirname(fileURLToPath(import.meta.url));\n  while (true) {\n    const resolverPath = join(folder, 'hooks', 'shared', 'hook-flags.cjs');\n    if (existsSync(resolverPath)) {\n      try {\n        return createRequire(import.meta.url)(resolverPath) as HookFlagsResolver;\n      } catch {\n        return null;\n      }\n    }\n    const parent = dirname(folder);\n    if (parent === folder) return null;\n    folder = parent;\n  }\n}\n\nconst hookFlags = loadHookFlags();\nconst skillAdvisorFlag = hookFlags?.concernFlag('skill-advisor') ?? null;\n\n// Callers strip these names to isolate a scope from a switch set in the shell.\nexport const ADVISOR_DISABLED_FLAGS: readonly string[] = hookFlags === null\n  ? []\n  : [\n      hookFlags.MASTER_FLAG,\n      ...hookFlags.MASTER_ALIASES,\n      ...(skillAdvisorFlag === null ? [] : [skillAdvisorFlag]),\n      ...(hookFlags.LEGACY_ALIASES['skill-advisor'] ?? []),\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"// ───────────────────────────────────────────────────────────────\n// MODULE: Advisor Disabled Switch\n// ───────────────────────────────────────────────────────────────\n// The switch belongs to whoever makes the request. The handler reads it in the\n// daemon and the CLI client reads it in the caller's own process before it\n// connects, so both build the same envelope here. The client cannot import the\n// handler because the handler loads the native database module and the scorer.\n// The rule itself is the hooks' resolver, so the direct call abstains exactly\n// when the prompt hooks do.\n\n// ───────────────────────────────────────────────────────────────────\n// 1. IMPORTS\n// ───────────────────────────────────────────────────────────────────\n\nimport { existsSync, realpathSync } from 'node:fs';\nimport { createRequire } from 'node:module';\nimport { dirname, join, resolve } from 'node:path';\nimport { fileURLToPath } from 'node:url';\n\nimport {\n  AdvisorRecommendOutputSchema,\n  type AdvisorRecommendOutput,\n} from '../schemas/advisor-tool-schemas.js';\nimport {\n  resolvedConfidenceThreshold,\n  resolvedUncertaintyThreshold,\n} from './compat/contract.js';\nimport { findAdvisorWorkspaceRoot } from './utils/workspace-root.js';\n\n// ───────────────────────────────────────────────────────────────────\n// 2. HELPERS\n// ───────────────────────────────────────────────────────────────────\n\ntype PublicThresholds = AdvisorRecommendOutput['effectiveThresholds'];\n\ninterface HookFlagsResolver {\n  hookFlagDecision(\n    concern: string,\n    env?: NodeJS.ProcessEnv,\n    config?: Readonly<Record<string, string>>,\n  ): { enabled: boolean; key: string | null };\n  loadConfigFile(path: string): Record<string, string>;\n  configPath(): string;\n  concernFlag(concern: string): string | null;\n  MASTER_FLAG: string;\n  MASTER_ALIASES: readonly string[];\n  LEGACY_ALIASES: Readonly<Record<string, readonly string[]>>;\n}\n\n// The source and the built module sit at different depths below .skilled, so the\n// resolver is found by walking up rather than by counting parent hops. A missing\n// resolver answers as if no switch were set, as every adapter does.\nfunction loadHookFlags(): HookFlagsResolver | null {\n  let folder = dirname(fileURLToPath(import.meta.url));\n  while (true) {\n    const resolverPath = join(folder, 'hooks', 'shared', 'hook-flags.cjs');\n    if (existsSync(resolverPath)) {\n      try {\n        return createRequire(import.meta.url)(resolverPath) as HookFlagsResolver;\n      } catch {\n        return null;\n      }\n    }\n    const parent = dirname(folder);\n    if (parent === folder) return null;\n    folder = parent;\n  }\n}\n\nconst hookFlags = loadHookFlags();\nconst skillAdvisorFlag = hookFlags?.concernFlag('skill-advisor') ?? null;\n\n// Callers strip these names to isolate a scope from a switch set in the shell.\nexport const ADVISOR_DISABLED_FLAGS: readonly string[] = hookFlags === null\n  ? []\n  : [\n      hookFlags.MASTER_FLAG,\n      ...hookFlags.MASTER_ALIASES,\n      ...(skillAdvisorFlag === null ? [] : [skillAdvisorFlag]),\n      ...(hookFlags.LEGACY_ALIASES['skill-advisor'] ?? []),\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"cd /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research && sed -n '1,80p' .skilled/skills/system-skill-advisor/runtime/lib/advisor-disabled.ts\"}"},"time":{"start":1794780710646,"end":1794780711110}}}}
{"type":"tool_use","timestamp":1794780711117,"sessionID":"ses_e1ebd75cbffeZfELy9ETJ0Z0Sg","part":{"partID":"prt_1e14445090012N30Y2Hqq0odxD","sessionID":"ses_e1ebd75cbffeZfELy9ETJ0Z0Sg","messageID":"msg_1e1440515001UP0oYT7bKzG5eJ","type":"tool","id":"call_9aeb7418ce694b8f8f3c9529","tool":"shell","state":{"status":"completed","input":{"command":"cd /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research && sed -n '30,95p' .skilled/hooks/shared/hook-flags.cjs"},"output":"// the whole library from a single place; entry points with no flag dependency\n// (the standalone daemon launchers) call it themselves.\nrequire(\"./env-aliases.cjs\").applyEnvAliases();\n\n// ─────────────────────────────────────────────────────────────────────────────\n// 2. CONSTANTS\n// ─────────────────────────────────────────────────────────────────────────────\n\nconst MASTER_FLAG = \"SYSTEM_HOOKS_DISABLED\";\n// The master switch was renamed from its opaque prefix to a self-describing one.\n// The old name stays honored so any operator who exported it keeps their opt-out.\nconst MASTER_ALIASES = [\"MK_HOOKS_DISABLED\"];\n\n// Canonical per-concern kill-switch, where the new name does not follow the\n// default `SYSTEM_<CONCERN>_DISABLED` shape because the hook is owned by a named\n// skill or CLI surface rather than the framework core. Concerns not listed here\n// fall back to the default shape in concernFlag().\nconst CONCERN_CANONICAL = {\n  goal: \"OPENCODE_GOAL_DISABLED\",\n  dispatch: \"CLI_DISPATCH_AUDIT_DISABLED\",\n  \"mcp-route-guard\": \"MCP_ROUTE_GUARD_DISABLED\",\n  \"codex-watchdog\": \"CODEX_HOOKS_WATCHDOG_DISABLED\",\n  \"git-preflight\": \"SK_GIT_PREFLIGHT_DISABLED\",\n  \"post-edit-quality\": \"SK_CODE_POST_EDIT_QUALITY_DISABLED\",\n};\n\n// concern -> extra env vars that also disable it. Three generations coexist here\n// so operator config written against any of them keeps working: the still-older\n// MK_/SPECKIT_ aliases, and the self-describing variant names that a concern's\n// own plugin/config/docs use where they differ from concernFlag()'s canonical\n// (e.g. a plugin's *_PLUGIN_DISABLED / *_HOOK_DISABLED const, or a doc's shorter\n// spelling). concernFlag() supplies the one canonical name; everything a real\n// surface also documents or exports for the same concern is listed here so the\n// documented switch actually disables the hook.\nconst LEGACY_ALIASES = {\n  goal: [\"OPENCODE_GOAL_PLUGIN_DISABLED\", \"MK_GOAL_DISABLED\", \"MK_GOAL_PLUGIN_DISABLED\"],\n  dispatch: [\"SYSTEM_DISPATCH_DISABLED\", \"MK_DISPATCH_DISABLED\", \"MK_CLI_DISPATCH_AUDIT_DISABLED\"],\n  // The preflight guard split off from the audit log, but the whole-surface\n  // switch that predates the split still has to silence both halves.\n  \"dispatch-guard\": [\"SYSTEM_DISPATCH_DISABLED\", \"MK_DISPATCH_DISABLED\"],\n  \"skill-advisor\": [\n    \"SYSTEM_SKILL_ADVISOR_HOOK_DISABLED\",\n    \"SYSTEM_SKILL_ADVISOR_PLUGIN_DISABLED\",\n    \"MK_SKILL_ADVISOR_DISABLED\",\n    \"MK_SKILL_ADVISOR_HOOK_DISABLED\",\n    \"MK_SKILL_ADVISOR_PLUGIN_DISABLED\",\n    \"SPECKIT_SKILL_ADVISOR_HOOK_DISABLED\",\n    \"SPECKIT_SKILL_ADVISOR_PLUGIN_DISABLED\",\n  ],\n  completion: [\n    \"SYSTEM_SPECKIT_COMPLETION_DISABLED\",\n    \"SYSTEM_COMPLETION_SENTINEL_DISABLED\",\n    \"MK_COMPLETION_DISABLED\",\n    \"MK_COMPLETION_SENTINEL_DISABLED\",\n    \"MK_SPECKIT_COMPLETION_DISABLED\",\n  ],\n  \"spec-gate\": [\"MK_SPEC_GATE_DISABLED\", \"SPECKIT_SPEC_GATE_DISABLED\"],\n  \"mcp-route-guard\": [\"MK_MCP_ROUTE_GUARD_DISABLED\"],\n  \"codex-watchdog\": [\"CODEX_WATCHDOG_DISABLED\", \"MK_CODEX_WATCHDOG_DISABLED\", \"MK_CODEX_HOOKS_WATCHDOG_DISABLED\"],\n  \"dist-freshness\": [\"MK_DIST_FRESHNESS_DISABLED\", \"MK_DIST_FRESHNESS_GUARD_DISABLED\"],\n  \"git-preflight\": [\"MK_GIT_PREFLIGHT_DISABLED\"],\n  \"hook-install\": [\"MK_HOOK_INSTALL_DISABLED\"],\n  \"permission-policy\": [\"MK_PERMISSION_POLICY_DISABLED\"],\n  \"session-lifecycle\": [\"MK_SESSION_LIFECYCLE_DISABLED\"],\n  \"session-cleanup\": [\"MK_SESSION_CLEANUP_DISABLED\"],\n  \"task-dispatch\": [\"MK_TASK_DISPATCH_DISABLED\"],\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"// the whole library from a single place; entry points with no flag dependency\n// (the standalone daemon launchers) call it themselves.\nrequire(\"./env-aliases.cjs\").applyEnvAliases();\n\n// ─────────────────────────────────────────────────────────────────────────────\n// 2. CONSTANTS\n// ─────────────────────────────────────────────────────────────────────────────\n\nconst MASTER_FLAG = \"SYSTEM_HOOKS_DISABLED\";\n// The master switch was renamed from its opaque prefix to a self-describing one.\n// The old name stays honored so any operator who exported it keeps their opt-out.\nconst MASTER_ALIASES = [\"MK_HOOKS_DISABLED\"];\n\n// Canonical per-concern kill-switch, where the new name does not follow the\n// default `SYSTEM_<CONCERN>_DISABLED` shape because the hook is owned by a named\n// skill or CLI surface rather than the framework core. Concerns not listed here\n// fall back to the default shape in concernFlag().\nconst CONCERN_CANONICAL = {\n  goal: \"OPENCODE_GOAL_DISABLED\",\n  dispatch: \"CLI_DISPATCH_AUDIT_DISABLED\",\n  \"mcp-route-guard\": \"MCP_ROUTE_GUARD_DISABLED\",\n  \"codex-watchdog\": \"CODEX_HOOKS_WATCHDOG_DISABLED\",\n  \"git-preflight\": \"SK_GIT_PREFLIGHT_DISABLED\",\n  \"post-edit-quality\": \"SK_CODE_POST_EDIT_QUALITY_DISABLED\",\n};\n\n// concern -> extra env vars that also disable it. Three generations coexist here\n// so operator config written against any of them keeps working: the still-older\n// MK_/SPECKIT_ aliases, and the self-describing variant names that a concern's\n// own plugin/config/docs use where they differ from concernFlag()'s canonical\n// (e.g. a plugin's *_PLUGIN_DISABLED / *_HOOK_DISABLED const, or a doc's shorter\n// spelling). concernFlag() supplies the one canonical name; everything a real\n// surface also documents or exports for the same concern is listed here so the\n// documented switch actually disables the hook.\nconst LEGACY_ALIASES = {\n  goal: [\"OPENCODE_GOAL_PLUGIN_DISABLED\", \"MK_GOAL_DISABLED\", \"MK_GOAL_PLUGIN_DISABLED\"],\n  dispatch: [\"SYSTEM_DISPATCH_DISABLED\", \"MK_DISPATCH_DISABLED\", \"MK_CLI_DISPATCH_AUDIT_DISABLED\"],\n  // The preflight guard split off from the audit log, but the whole-surface\n  // switch that predates the split still has to silence both halves.\n  \"dispatch-guard\": [\"SYSTEM_DISPATCH_DISABLED\", \"MK_DISPATCH_DISABLED\"],\n  \"skill-advisor\": [\n    \"SYSTEM_SKILL_ADVISOR_HOOK_DISABLED\",\n    \"SYSTEM_SKILL_ADVISOR_PLUGIN_DISABLED\",\n    \"MK_SKILL_ADVISOR_DISABLED\",\n    \"MK_SKILL_ADVISOR_HOOK_DISABLED\",\n    \"MK_SKILL_ADVISOR_PLUGIN_DISABLED\",\n    \"SPECKIT_SKILL_ADVISOR_HOOK_DISABLED\",\n    \"SPECKIT_SKILL_ADVISOR_PLUGIN_DISABLED\",\n  ],\n  completion: [\n    \"SYSTEM_SPECKIT_COMPLETION_DISABLED\",\n    \"SYSTEM_COMPLETION_SENTINEL_DISABLED\",\n    \"MK_COMPLETION_DISABLED\",\n    \"MK_COMPLETION_SENTINEL_DISABLED\",\n    \"MK_SPECKIT_COMPLETION_DISABLED\",\n  ],\n  \"spec-gate\": [\"MK_SPEC_GATE_DISABLED\", \"SPECKIT_SPEC_GATE_DISABLED\"],\n  \"mcp-route-guard\": [\"MK_MCP_ROUTE_GUARD_DISABLED\"],\n  \"codex-watchdog\": [\"CODEX_WATCHDOG_DISABLED\", \"MK_CODEX_WATCHDOG_DISABLED\", \"MK_CODEX_HOOKS_WATCHDOG_DISABLED\"],\n  \"dist-freshness\": [\"MK_DIST_FRESHNESS_DISABLED\", \"MK_DIST_FRESHNESS_GUARD_DISABLED\"],\n  \"git-preflight\": [\"MK_GIT_PREFLIGHT_DISABLED\"],\n  \"hook-install\": [\"MK_HOOK_INSTALL_DISABLED\"],\n  \"permission-policy\": [\"MK_PERMISSION_POLICY_DISABLED\"],\n  \"session-lifecycle\": [\"MK_SESSION_LIFECYCLE_DISABLED\"],\n  \"session-cleanup\": [\"MK_SESSION_CLEANUP_DISABLED\"],\n  \"task-dispatch\": [\"MK_TASK_DISPATCH_DISABLED\"],\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"cd /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research && sed -n '30,95p' .skilled/hooks/shared/hook-flags.cjs\"}"},"time":{"start":1794780710153,"end":1794780711117}}}}
{"type":"step_finish","timestamp":1794780712098,"sessionID":"ses_e1ebd75cbffeZfELy9ETJ0Z0Sg","part":{"id":"prt_1e1444ca2001kwNNP07iz68jDK","sessionID":"ses_e1ebd75cbffeZfELy9ETJ0Z0Sg","messageID":"msg_1e1440515001UP0oYT7bKzG5eJ","type":"step-finish","reason":"tool-calls","snapshot":"23fdb2f4324e86228b479750e8866387f9b4e452","cost":0,"tokens":{"input":2868,"output":159,"reasoning":1598,"cache":{"read":78208,"write":0}}}}
{"type":"step_start","timestamp":1794780715799,"sessionID":"ses_e1ebd75cbffeZfELy9ETJ0Z0Sg","part":{"id":"prt_1e1445b17001V3Ke281kvl201x","sessionID":"ses_e1ebd75cbffeZfELy9ETJ0Z0Sg","messageID":"msg_1e1444ca7001KLQ4WRgMf5rbuk","type":"step-start","snapshot":"23fdb2f4324e86228b479750e8866387f9b4e452"}}
{"type":"tool_use","timestamp":1794780725259,"sessionID":"ses_e1ebd75cbffeZfELy9ETJ0Z0Sg","part":{"partID":"prt_1e1447ddb001x6MXocHuuOLItK","sessionID":"ses_e1ebd75cbffeZfELy9ETJ0Z0Sg","messageID":"msg_1e1444ca7001KLQ4WRgMf5rbuk","type":"tool","id":"call_8f77979de72d4524ac50d8aa","tool":"shell","state":{"status":"completed","input":{"command":"cd /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research && sed -n '200,265p' .skilled/skills/system-skill-advisor/runtime/tests/skill-advisor-cli-stale-daemon-retry.vitest.ts"},"output":"  });\n\n  it('does not retry unrelated invalid-parameter errors', async () => {\n    const scope = createIsolatedCliScope('unrelated-invalid-parameter');\n    scopes.push(scope);\n    const daemon = await startFakeAdvisorDaemon(scope.socketPath, 'reject-unrelated-option');\n\n    const run = await runRecommend(scope);\n    const payload = parseJsonOutput<CliPayload>(run);\n\n    expect(run.exitCode, run.stderr).toBe(64);\n    expect(payload.status).toBe('error');\n    expect(payload.exitCode).toBe(64);\n    expect(payload.error).toContain('unsupportedOption');\n    expect(daemon.calls).toHaveLength(1);\n  });\n});\n\ndescribe('skill-advisor CLI disable switch', () => {\n  it.each(ADVISOR_DISABLED_FLAGS.map((flag) => [flag]))('abstains under %s before it asks a warm daemon', async (flag) => {\n    const scope = createIsolatedCliScope('disable-switch-warm');\n    scopes.push(scope);\n    const daemon = await startFakeAdvisorDaemon(scope.socketPath, 'answer');\n\n    const run = await runRecommend(scope, switchEnv(scope, flag));\n    const payload = parseJsonOutput<CliPayload>(run);\n\n    expect(run.exitCode, run.stderr).toBe(0);\n    expect(payload.status).toBe('ok');\n    expect(payload.data?.recommendations).toEqual([]);\n    // A legacy name can reach the resolver as the canonical one it maps to, so the\n    // reported name is not fixed but the reason always names some switch.\n    const reasons = payload.data?.abstainReasons ?? [];\n    expect(reasons).toHaveLength(1);\n    expect(reasons[0]?.startsWith('Skill advisor disabled by ')).toBe(true);\n    if (!flag.startsWith('MK_')) expect(reasons).toEqual([`Skill advisor disabled by ${flag}.`]);\n    expect(payload.data?.warnings).toEqual(['ADVISOR_DISABLED']);\n    expect(payload.data?.freshness).toBe('unavailable');\n    expect(daemon.calls).toHaveLength(0);\n  });\n\n  it('still asks a warm daemon when no switch is set', async () => {\n    const scope = createIsolatedCliScope('disable-switch-control');\n    scopes.push(scope);\n    const daemon = await startFakeAdvisorDaemon(scope.socketPath, 'answer');\n\n    const run = await runRecommend(scope, switchEnv(scope));\n    const payload = parseJsonOutput<CliPayload>(run);\n\n    expect(run.exitCode, run.stderr).toBe(0);\n    expect(payload.data?.recommendations?.[0]?.skillId).toBe('sk-code');\n    expect(daemon.calls).toHaveLength(1);\n  });\n\n  it('abstains with no daemon and starts no launcher', async () => {\n    const scope = createIsolatedCliScope('disable-switch-no-daemon');\n    scopes.push(scope);\n\n    const run = await runRecommend(scope, switchEnv(scope, 'SYSTEM_SKILL_ADVISOR_HOOK_DISABLED'));\n    const payload = parseJsonOutput<CliPayload>(run);\n\n    expect(run.exitCode, run.stderr).toBe(0);\n    expect(payload.data?.recommendations).toEqual([]);\n    expect(payload.data?.abstainReasons).toEqual(['Skill advisor disabled by SYSTEM_SKILL_ADVISOR_HOOK_DISABLED.']);\n    expect(readSkillAdvisorLauncherPid(scope.skillAdvisorDbDir)).toBeNull();\n    expect(existsSync(scope.socketPath)).toBe(false);\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"  });\n\n  it('does not retry unrelated invalid-parameter errors', async () => {\n    const scope = createIsolatedCliScope('unrelated-invalid-parameter');\n    scopes.push(scope);\n    const daemon = await startFakeAdvisorDaemon(scope.socketPath, 'reject-unrelated-option');\n\n    const run = await runRecommend(scope);\n    const payload = parseJsonOutput<CliPayload>(run);\n\n    expect(run.exitCode, run.stderr).toBe(64);\n    expect(payload.status).toBe('error');\n    expect(payload.exitCode).toBe(64);\n    expect(payload.error).toContain('unsupportedOption');\n    expect(daemon.calls).toHaveLength(1);\n  });\n});\n\ndescribe('skill-advisor CLI disable switch', () => {\n  it.each(ADVISOR_DISABLED_FLAGS.map((flag) => [flag]))('abstains under %s before it asks a warm daemon', async (flag) => {\n    const scope = createIsolatedCliScope('disable-switch-warm');\n    scopes.push(scope);\n    const daemon = await startFakeAdvisorDaemon(scope.socketPath, 'answer');\n\n    const run = await runRecommend(scope, switchEnv(scope, flag));\n    const payload = parseJsonOutput<CliPayload>(run);\n\n    expect(run.exitCode, run.stderr).toBe(0);\n    expect(payload.status).toBe('ok');\n    expect(payload.data?.recommendations).toEqual([]);\n    // A legacy name can reach the resolver as the canonical one it maps to, so the\n    // reported name is not fixed but the reason always names some switch.\n    const reasons = payload.data?.abstainReasons ?? [];\n    expect(reasons).toHaveLength(1);\n    expect(reasons[0]?.startsWith('Skill advisor disabled by ')).toBe(true);\n    if (!flag.startsWith('MK_')) expect(reasons).toEqual([`Skill advisor disabled by ${flag}.`]);\n    expect(payload.data?.warnings).toEqual(['ADVISOR_DISABLED']);\n    expect(payload.data?.freshness).toBe('unavailable');\n    expect(daemon.calls).toHaveLength(0);\n  });\n\n  it('still asks a warm daemon when no switch is set', async () => {\n    const scope = createIsolatedCliScope('disable-switch-control');\n    scopes.push(scope);\n    const daemon = await startFakeAdvisorDaemon(scope.socketPath, 'answer');\n\n    const run = await runRecommend(scope, switchEnv(scope));\n    const payload = parseJsonOutput<CliPayload>(run);\n\n    expect(run.exitCode, run.stderr).toBe(0);\n    expect(payload.data?.recommendations?.[0]?.skillId).toBe('sk-code');\n    expect(daemon.calls).toHaveLength(1);\n  });\n\n  it('abstains with no daemon and starts no launcher', async () => {\n    const scope = createIsolatedCliScope('disable-switch-no-daemon');\n    scopes.push(scope);\n\n    const run = await runRecommend(scope, switchEnv(scope, 'SYSTEM_SKILL_ADVISOR_HOOK_DISABLED'));\n    const payload = parseJsonOutput<CliPayload>(run);\n\n    expect(run.exitCode, run.stderr).toBe(0);\n    expect(payload.data?.recommendations).toEqual([]);\n    expect(payload.data?.abstainReasons).toEqual(['Skill advisor disabled by SYSTEM_SKILL_ADVISOR_HOOK_DISABLED.']);\n    expect(readSkillAdvisorLauncherPid(scope.skillAdvisorDbDir)).toBeNull();\n    expect(existsSync(scope.socketPath)).toBe(false);\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"cd /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research && sed -n '200,265p' .skilled/skills/system-skill-advisor/runtime/tests/skill-advisor-cli-stale-daemon-retry.vitest.ts\"}"},"time":{"start":1794780724699,"end":1794780725259}}}}
{"type":"tool_use","timestamp":1794780725266,"sessionID":"ses_e1ebd75cbffeZfELy9ETJ0Z0Sg","part":{"partID":"prt_1e1447bbc001DisiTjUBsjip36","sessionID":"ses_e1ebd75cbffeZfELy9ETJ0Z0Sg","messageID":"msg_1e1444ca7001KLQ4WRgMf5rbuk","type":"tool","id":"call_2c4beb3fbf364d01843bc062","tool":"shell","state":{"status":"completed","input":{"command":"cd /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research && sed -n '100,175p' .skilled/skills/system-skill-advisor/runtime/tests/launcher-bootstrap.vitest.ts"},"output":"\n    expect(launcher.artifactsReady()).toBe(false);\n  });\n\n  it('filters parent environment before spawning npm or the advisor server', () => {\n    configureTempLauncher();\n    const memoryDbPath = launcher.advisorDbPath();\n    const socketDir = expectedChildSocketDir(memoryDbPath);\n    const sourceEnv = {\n      PATH: '/bin',\n      HOME: '/tmp/home',\n      SYSTEM_SKILL_ADVISOR_DB_DIR: '/tmp/db',\n      AWS_SECRET_ACCESS_KEY: 'should-not-leak',\n      RANDOM_PARENT_ENV: 'should-not-leak',\n    };\n    expect(launcher.createChildEnv(sourceEnv)).toEqual({\n      PATH: '/bin',\n      HOME: '/tmp/home',\n      SYSTEM_SKILL_ADVISOR_DB_DIR: '/tmp/db',\n      MEMORY_DB_PATH: memoryDbPath,\n      SPECKIT_IPC_SOCKET_DIR: socketDir,\n      HF_EMBED_SERVER_URL: expectedModelServerUrl(sourceEnv),\n    });\n  });\n\n  it('keeps the per-request advisor switch out of the daemon env', () => {\n    configureTempLauncher();\n    const memoryDbPath = launcher.advisorDbPath();\n    const socketDir = expectedChildSocketDir(memoryDbPath);\n    const sourceEnv: NodeJS.ProcessEnv = { PATH: '/bin' };\n    for (const name of ADVISOR_DISABLED_FLAGS) sourceEnv[name] = '1';\n    const switchNames = Object.keys(sourceEnv).filter((name) => name !== 'PATH');\n    // A short list would quietly narrow this case back to one concern, so the\n    // fixture's size is asserted before the env assertion below.\n    expect(switchNames).toHaveLength(10);\n    // Each caller reads the switch in its own process. A daemon that inherited it\n    // would abstain for every later caller in the checkout, so it stays out.\n    expect(launcher.createChildEnv(sourceEnv)).toEqual({\n      PATH: '/bin',\n      MEMORY_DB_PATH: memoryDbPath,\n      SPECKIT_IPC_SOCKET_DIR: socketDir,\n      HF_EMBED_SERVER_URL: expectedModelServerUrl(sourceEnv),\n    });\n  });\n\n  it('passes an explicit daemon trust default through to the advisor child env', () => {\n    configureTempLauncher();\n    const memoryDbPath = launcher.advisorDbPath();\n    const socketDir = expectedChildSocketDir(memoryDbPath);\n    const sourceEnv = {\n      SYSTEM_SKILL_ADVISOR_TRUST_DEFAULT: 'trusted',\n      AWS_SECRET_ACCESS_KEY: 'should-not-leak',\n    };\n\n    // The daemon reads the trust default from its own environment; this pins the\n    // child-env allowlist to that reader so the two cannot drift apart.\n    expect(sourceText('../advisor-server.ts')).toContain('process.env.SYSTEM_SKILL_ADVISOR_TRUST_DEFAULT');\n    expect(launcher.createChildEnv(sourceEnv)).toEqual({\n      SYSTEM_SKILL_ADVISOR_TRUST_DEFAULT: 'trusted',\n      MEMORY_DB_PATH: memoryDbPath,\n      SPECKIT_IPC_SOCKET_DIR: socketDir,\n      HF_EMBED_SERVER_URL: expectedModelServerUrl(sourceEnv),\n    });\n  });\n\n  it('passes advisor shadow feature flags through to the child env', () => {\n    configureTempLauncher();\n    const memoryDbPath = launcher.advisorDbPath();\n    const socketDir = expectedChildSocketDir(memoryDbPath);\n    const sourceEnv = {\n      SPECKIT_ADVISOR_BM25_LEXICAL_SHADOW: 'true',\n      SPECKIT_ADVISOR_FEEDBACK_CALIBRATION_SHADOW: 'true',\n      AWS_SECRET_ACCESS_KEY: 'should-not-leak',\n    };\n    expect(launcher.createChildEnv(sourceEnv)).toEqual({\n      SPECKIT_ADVISOR_BM25_LEXICAL_SHADOW: 'true',\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"\n    expect(launcher.artifactsReady()).toBe(false);\n  });\n\n  it('filters parent environment before spawning npm or the advisor server', () => {\n    configureTempLauncher();\n    const memoryDbPath = launcher.advisorDbPath();\n    const socketDir = expectedChildSocketDir(memoryDbPath);\n    const sourceEnv = {\n      PATH: '/bin',\n      HOME: '/tmp/home',\n      SYSTEM_SKILL_ADVISOR_DB_DIR: '/tmp/db',\n      AWS_SECRET_ACCESS_KEY: 'should-not-leak',\n      RANDOM_PARENT_ENV: 'should-not-leak',\n    };\n    expect(launcher.createChildEnv(sourceEnv)).toEqual({\n      PATH: '/bin',\n      HOME: '/tmp/home',\n      SYSTEM_SKILL_ADVISOR_DB_DIR: '/tmp/db',\n      MEMORY_DB_PATH: memoryDbPath,\n      SPECKIT_IPC_SOCKET_DIR: socketDir,\n      HF_EMBED_SERVER_URL: expectedModelServerUrl(sourceEnv),\n    });\n  });\n\n  it('keeps the per-request advisor switch out of the daemon env', () => {\n    configureTempLauncher();\n    const memoryDbPath = launcher.advisorDbPath();\n    const socketDir = expectedChildSocketDir(memoryDbPath);\n    const sourceEnv: NodeJS.ProcessEnv = { PATH: '/bin' };\n    for (const name of ADVISOR_DISABLED_FLAGS) sourceEnv[name] = '1';\n    const switchNames = Object.keys(sourceEnv).filter((name) => name !== 'PATH');\n    // A short list would quietly narrow this case back to one concern, so the\n    // fixture's size is asserted before the env assertion below.\n    expect(switchNames).toHaveLength(10);\n    // Each caller reads the switch in its own process. A daemon that inherited it\n    // would abstain for every later caller in the checkout, so it stays out.\n    expect(launcher.createChildEnv(sourceEnv)).toEqual({\n      PATH: '/bin',\n      MEMORY_DB_PATH: memoryDbPath,\n      SPECKIT_IPC_SOCKET_DIR: socketDir,\n      HF_EMBED_SERVER_URL: expectedModelServerUrl(sourceEnv),\n    });\n  });\n\n  it('passes an explicit daemon trust default through to the advisor child env', () => {\n    configureTempLauncher();\n    const memoryDbPath = launcher.advisorDbPath();\n    const socketDir = expectedChildSocketDir(memoryDbPath);\n    const sourceEnv = {\n      SYSTEM_SKILL_ADVISOR_TRUST_DEFAULT: 'trusted',\n      AWS_SECRET_ACCESS_KEY: 'should-not-leak',\n    };\n\n    // The daemon reads the trust default from its own environment; this pins the\n    // child-env allowlist to that reader so the two cannot drift apart.\n    expect(sourceText('../advisor-server.ts')).toContain('process.env.SYSTEM_SKILL_ADVISOR_TRUST_DEFAULT');\n    expect(launcher.createChildEnv(sourceEnv)).toEqual({\n      SYSTEM_SKILL_ADVISOR_TRUST_DEFAULT: 'trusted',\n      MEMORY_DB_PATH: memoryDbPath,\n      SPECKIT_IPC_SOCKET_DIR: socketDir,\n      HF_EMBED_SERVER_URL: expectedModelServerUrl(sourceEnv),\n    });\n  });\n\n  it('passes advisor shadow feature flags through to the child env', () => {\n    configureTempLauncher();\n    const memoryDbPath = launcher.advisorDbPath();\n    const socketDir = expectedChildSocketDir(memoryDbPath);\n    const sourceEnv = {\n      SPECKIT_ADVISOR_BM25_LEXICAL_SHADOW: 'true',\n      SPECKIT_ADVISOR_FEEDBACK_CALIBRATION_SHADOW: 'true',\n      AWS_SECRET_ACCESS_KEY: 'should-not-leak',\n    };\n    expect(launcher.createChildEnv(sourceEnv)).toEqual({\n      SPECKIT_ADVISOR_BM25_LEXICAL_SHADOW: 'true',\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"cd /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research && sed -n '100,175p' .skilled/skills/system-skill-advisor/runtime/tests/launcher-bootstrap.vitest.ts\"}"},"time":{"start":1794780724156,"end":1794780725266}}}}
