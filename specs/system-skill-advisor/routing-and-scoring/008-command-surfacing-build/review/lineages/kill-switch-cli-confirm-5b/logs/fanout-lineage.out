.ts\n++-- route-exclusions.ts\n +-- skill-advisor-brief.ts\n +-- source-cache.ts\n +-- subprocess.ts\n++-- auth/\n++-- compat/\n +-- cross-skill-edges/\n++-- daemon/\n++-- derived/\n +-- embedders/\n++-- freshness/\n +-- ipc/\n++-- lifecycle/\n +-- scorer/\n++-- shadow/\n +-- shared/\n++-- skill-graph/\n++-- utils/\n `-- README.md\n ```\n \ndiff --git a/.skilled/skills/system-skill-advisor/runtime/tests/launcher-bootstrap.vitest.ts b/.skilled/skills/system-skill-advisor/runtime/tests/launcher-bootstrap.vitest.ts\nindex 8cb529318b7..5194582d829 100644\n--- a/.skilled/skills/system-skill-advisor/runtime/tests/launcher-bootstrap.vitest.ts\n+++ b/.skilled/skills/system-skill-advisor/runtime/tests/launcher-bootstrap.vitest.ts\n@@ -9,6 +9,7 @@ import { dirname, join } from 'node:path';\n import { afterEach, describe, expect, it } from 'vitest';\n import { initDb, getDb, closeDb, resolveSkillGraphDbDir } from '../lib/skill-graph/skill-graph-db.js';\n import { isLeaseHeld, acquireSkillGraphLease, openLeaseDatabase } from '../lib/daemon/lease.js';\n+import { ADVISOR_DISABLED_FLAGS } from '../lib/advisor-disabled.js';\n import { rebuildAdvisorIndex } from '../handlers/advisor-rebuild.js';\n import type { AdvisorStatusOutput } from '../schemas/advisor-tool-schemas.js';\n import { resolveProvider } from '@spec-kit/shared/embeddings/factory.js';\n@@ -125,11 +126,12 @@ describe('system-skill-advisor launcher bootstrap', () => {\n     configureTempLauncher();\n     const memoryDbPath = launcher.advisorDbPath();\n     const socketDir = expectedChildSocketDir(memoryDbPath);\n-    const sourceEnv = {\n-      PATH: '/bin',\n-      SYSTEM_SKILL_ADVISOR_HOOK_DISABLED: '1',\n-      SPECKIT_SKILL_ADVISOR_HOOK_DISABLED: '1',\n-    };\n+    const sourceEnv: NodeJS.ProcessEnv = { PATH: '/bin' };\n+    for (const name of ADVISOR_DISABLED_FLAGS) sourceEnv[name] = '1';\n+    const switchNames = Object.keys(sourceEnv).filter((name) => name !== 'PATH');\n+    // A short list would quietly narrow this case back to one concern, so the\n+    // fixture's size is asserted before the env assertion below.\n+    expect(switchNames).toHaveLength(10);\n     // Each caller reads the switch in its own process. A daemon that inherited it\n     // would abstain for every later caller in the checkout, so it stays out.\n     expect(launcher.createChildEnv(sourceEnv)).toEqual({\ndiff --git a/.skilled/skills/system-skill-advisor/runtime/tests/skill-advisor-cli-stale-daemon-retry.vitest.ts b/.skilled/skills/system-skill-advisor/runtime/tests/skill-advisor-cli-stale-daemon-retry.vitest.ts\nindex 56d32077d35..894931f203b 100644\n--- a/.skilled/skills/system-skill-advisor/runtime/tests/skill-advisor-cli-stale-daemon-retry.vitest.ts\n+++ b/.skilled/skills/system-skill-advisor/runtime/tests/skill-advisor-cli-stale-daemon-retry.vitest.ts\n@@ -216,9 +216,7 @@ describe('skill-advisor CLI stale-daemon retry', () => {\n });\n \n describe('skill-advisor CLI disable switch', () => {\n-  // The resolver copies an MK_ value onto its new name when it loads, so the\n-  // reason an MK_ name gets depends on load order. The loop leaves those out.\n-  it.each(ADVISOR_DISABLED_FLAGS.filter((flag) => !flag.startsWith('MK_')).map((flag) => [flag]))('abstains under %s before it asks a warm daemon', async (flag) => {\n+  it.each(ADVISOR_DISABLED_FLAGS.map((flag) => [flag]))('abstains under %s before it asks a warm daemon', async (flag) => {\n     const scope = createIsolatedCliScope('disable-switch-warm');\n     scopes.push(scope);\n     const daemon = await startFakeAdvisorDaemon(scope.socketPath, 'answer');\n@@ -229,7 +227,12 @@ describe('skill-advisor CLI disable switch', () => {\n     expect(run.exitCode, run.stderr).toBe(0);\n     expect(payload.status).toBe('ok');\n     expect(payload.data?.recommendations).toEqual([]);\n-    expect(payload.data?.abstainReasons).toEqual([`Skill advisor disabled by ${flag}.`]);\n+    // A legacy name can reach the resolver as the canonical one it maps to, so the\n+    // reported name is not fixed but the reason always names some switch.\n+    const reasons = payload.data?.abstainReasons ?? [];\n+    expect(reasons).toHaveLength(1);\n+    expect(reasons[0]?.startsWith('Skill advisor disabled by ')).toBe(true);\n+    if (!flag.startsWith('MK_')) expect(reasons).toEqual([`Skill advisor disabled by ${flag}.`]);\n     expect(payload.data?.warnings).toEqual(['ADVISOR_DISABLED']);\n     expect(payload.data?.freshness).toBe('unavailable');\n     expect(daemon.calls).toHaveLength(0);\ndiff --git a/.skilled/skills/system-spec-kit/runtime/ENV-REFERENCE.md b/.skilled/skills/system-spec-kit/runtime/ENV-REFERENCE.md\nindex 1e292dc60a8..688262453e2 100644\n--- a/.skilled/skills/system-spec-kit/runtime/ENV-REFERENCE.md\n+++ b/.skilled/skills/system-spec-kit/runtime/ENV-REFERENCE.md\n@@ -71,8 +71,8 @@ Flags can be set as environment variables **or** in a config file: copy `.skille\n \n | Variable | Default | Type | Description | Source |\n |----------|---------|------|-------------|--------|\n-| `SYSTEM_HOOKS_DISABLED` | unset (enabled) | truthy disable flag | Master switch for every concern below. No aliases. | `.skilled/hooks/shared/hook-flags.{cjs,mjs,ts,sh}` |\n-| `SYSTEM_SKILL_ADVISOR_DISABLED` | unset (enabled) | truthy disable flag | Disables skill-advisor injection and makes the `advisor_recommend` direct call abstain. Aliases: `SYSTEM_SKILL_ADVISOR_HOOK_DISABLED`, `SYSTEM_SKILL_ADVISOR_PLUGIN_DISABLED`, `SPECKIT_SKILL_ADVISOR_HOOK_DISABLED`, `SPECKIT_SKILL_ADVISOR_PLUGIN_DISABLED`. | `system-skill-advisor/hooks/claude/user-prompt-submit.ts`, `.opencode/plugins/system-skill-advisor.js` |\n+| `SYSTEM_HOOKS_DISABLED` | unset (enabled) | truthy disable flag | Master switch for every concern below. Alias: `MK_HOOKS_DISABLED`. | `.skilled/hooks/shared/hook-flags.{cjs,mjs,ts,sh}` |\n+| `SYSTEM_SKILL_ADVISOR_DISABLED` | unset (enabled) | truthy disable flag | Disables skill-advisor injection and makes the `advisor_recommend` direct call abstain. Aliases: `SYSTEM_SKILL_ADVISOR_HOOK_DISABLED`, `SYSTEM_SKILL_ADVISOR_PLUGIN_DISABLED`, `SPECKIT_SKILL_ADVISOR_HOOK_DISABLED`, `SPECKIT_SKILL_ADVISOR_PLUGIN_DISABLED`, `MK_SKILL_ADVISOR_DISABLED`, `MK_SKILL_ADVISOR_HOOK_DISABLED`, `MK_SKILL_ADVISOR_PLUGIN_DISABLED`. | `system-skill-advisor/hooks/claude/user-prompt-submit.ts`, `.opencode/plugins/system-skill-advisor.js`, `system-skill-advisor/runtime/lib/advisor-disabled.ts`, `system-skill-advisor/runtime/skill-advisor-cli.ts`, `system-skill-advisor/runtime/handlers/advisor-recommend.ts` |\n | `SYSTEM_SPEC_GATE_DISABLED` | unset (enabled) | disable flag (1) | Disables Gate-3 delivery and enforcement. Alias: `SPECKIT_SPEC_GATE_DISABLED`. | `hooks/lib/spec-gate/spec-gate-core.mjs`, `.opencode/plugins/system-spec-gate.js` |\n | `SYSTEM_COMPLETION_DISABLED` | unset (enabled) | truthy disable flag | Disables completion-evidence warnings. Aliases: `SYSTEM_COMPLETION_SENTINEL_DISABLED`, `SYSTEM_SPECKIT_COMPLETION_DISABLED`. | `hooks/*/completion-evidence*`, `.opencode/plugins/system-completion-sentinel.js` |\n | `CODEX_WATCHDOG_DISABLED` | unset (enabled) | truthy disable flag | Disables Codex hook-drift warnings. No aliases. | `.opencode/plugins/codex-hooks-watchdog.js` |\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"diff --git a/.skilled/skills/system-skill-advisor/manual-testing-playbook/compat-and-disable/global-disable-flag.md b/.skilled/skills/system-skill-advisor/manual-testing-playbook/compat-and-disable/global-disable-flag.md\nindex 3b79e807a5f..75afdd03fff 100644\n--- a/.skilled/skills/system-skill-advisor/manual-testing-playbook/compat-and-disable/global-disable-flag.md\n+++ b/.skilled/skills/system-skill-advisor/manual-testing-playbook/compat-and-disable/global-disable-flag.md\n@@ -6,7 +6,7 @@ trigger_phrases:\n   - \"global disable flag\"\n   - \"global disable\"\n   - \"global\"\n-version: 0.8.6.0\n+version: 0.8.7.0\n id: