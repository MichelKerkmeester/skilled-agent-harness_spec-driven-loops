'edge', id: 'e5', source: 'ca-finding-2', target: 'spec-027', relation: 'IN_FILE' },\\n  ],\\n};\\n\\nfs.writeFileSync(`${root}/tmp/iter-002-event.json`, JSON.stringify(record));\\n\\nconst lines = [JSON.stringify(record)];\\nlines.push(JSON.stringify({\\n  type: 'finding',\\n  id: 'SAC4C-P2-001',\\n  severity: 'P2',\\n  cluster: 'spec-code drift',\\n  file: finding.file,\\n  title: finding.title,\\n  iteration: 2,\\n}));\\nlines.push(JSON.stringify({\\n  type: 'classification',\\n  detail: 'Skill docs and feature catalog are clean; the drift is confined to the remediation packet spec, which still records the question carry as out of scope and decline-only.',\\n  iteration: 2,\\n}));\\nfor (const [protocol, level, status, evidence] of [\\n  ['spec_code', 'core', 'partial', 'REQ-001 as written passes; the scope text and requirement lag T029.'],\\n  ['checklist_evidence', 'core', 'partial', 'T028/T029 checked with evidence; AC rows Unmet pending AC-011 closeout.'],\\n  ['feature_catalog_code', 'overlay', 'pass', 'advisor-recommend.md:33 accurate; no or-list claim.'],\\n]) {\\n  lines.push(JSON.stringify({ type: 'traceability', protocol, level, status, evidence, iteration: 2 }));\\n}\\nfor (const [direction, reason] of [\\n  ['A hub-level test row is missing for the article and question forms', 'attachCommand consults only the pinned predicate for a mention, so a hub row adds no distinct failure mode.'],\\n  ['A changelog entry is missing', 'T029 scope and the phase Out-of-Scope assign release notes to phase 025.'],\\n  ['The README four-field sentences are wrong', 'They match backfillRunLog and offerLineFields as read; the row belongs to the sibling lineage.'],\\n  ['The stale :405 pointer alone', 'Raised inside SAC4C-P2-001 rather than separately.'],\\n]) {\\n  lines.push(JSON.stringify({ type: 'ruled_out', direction, reason, iteration: 2 }));\\n}\\nfs.writeFileSync(`${root}/deltas/iter-002.jsonl`, `${lines.join('\\\\n')}\\\\n`);\\nconsole.log('wrote record + delta',