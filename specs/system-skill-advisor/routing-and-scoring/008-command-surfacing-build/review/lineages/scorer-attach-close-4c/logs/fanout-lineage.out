ation: 'First iteration of this lineage: one new P1 raised from a real-module and CLI probe, no refinement of prior state. The fixed single-word forms are confirmed rather than re-reported.',\\n  sessionId: 'fanout-scorer-attach-close-4c-1794682797954-pcdanq',\\n  generation: 1,\\n  lineageMode: 'new',\\n  timestamp,\\n  durationMs: Math.max(0, writtenAt - startedAt),\\n  graphEvents: [\\n    { type: 'node', id: 'ca-file', kind: 'FILE', label: 'command-attach.ts' },\\n    { type: 'node', id: 'ca-orlist-invariant', kind: 'INVARIANT', label: 'a refusal or question over an or-list carries no command' },\\n    { type: 'node', id: 'ca-finding-1', kind: 'FINDING', label: 'SAC4C-P1-001 two-word list item' },\\n    { type: 'node', id: 'ca-test-guards', kind: 'TEST', label: 'command-attach-guards.vitest.ts' },\\n    { type: 'edge', id: 'e1', source: 'ca-finding-1', target: 'ca-orlist-invariant', relation: 'CONTRADICTS' },\\n    { type: 'edge', id: 'e2', source: 'ca-test-guards', target: 'ca-orlist-invariant', relation: 'COVERS' },\\n    { type: 'edge', id: 'e3', source: 'ca-finding-1', target: 'ca-file', relation: 'IN_FILE' },\\n  ],\\n};\\n\\nfs.writeFileSync(`${root}/tmp/iter-001-event.json`, JSON.stringify(record));\\n\\nconst lines = [JSON.stringify(record)];\\nlines.push(JSON.stringify({\\n  type: 'finding',\\n  id: 'SAC4C-P1-001',\\n  severity: 'P1',\\n  cluster: 'or-list grammar reach',\\n  file: '.skilled/skills/system-skill-advisor/runtime/lib/command-attach.ts:380',\\n  title: finding.title,\\n  iteration: 1,\\n}));\\nlines.push(JSON.stringify({\\n  type: 'classification',\\n  detail: 'Fixed single-word refusal, article and question forms confirmed at the predicate, attachCommand and the advisor CLI; a non-final two-word /doctor item breaks the bridge and the refused command is published.',\\n  iteration: 1,\\n}));\\nlines.push(JSON.stringify({\\n  type: 'traceability',\\n  protocol: 'spec_code',\\n  level: 'core',\\n  status: 'partial',\\n  evidence: 'REQ-001 refusals pass; the generalized comment contract fails for two-word items.',\\n  iteration: 1,\\n}));\\nlines.push(JSON.stringify({\\n  type: 'traceability',\\n  protocol: 'checklist_evidence',\\n  level: 'core',\\n  status: 'partial',\\n  evidence: 'T028/T029 checked with evidence; AC-001/AC-006 Unmet pending closeout.',\\n  iteration: 1,\\n}));\\nfor (const [direction, reason] of [\\n  ['Fix over-suppresses requests', 'Seven probed request shapes with and without the article kept their command.'],\\n  ['Article allowance breaks existing question rows', 'Rows without an `or` match zero iterations of the added group; Is the /doctor:update command safe? still reads as a question.'],\\n  ['Added test count is short', 'Nine added rows equals T028 (4 refusal + 1 request) plus T029 (3 question + 1 request).'],\\n  ['Shipped build lacks the fix', 'runtime/dist/runtime/lib/command-attach.js holds the same constant and three insertions.'],\\n]) {\\n  lines.push(JSON.stringify({ type: 'ruled_out', direction, reason, iteration: 1 }));\\n}\\nfs.writeFileSync(`${root}/deltas/iter-001.jsonl`, `${lines.join('\\\\n')}\\\\n`);\\nconsole.log('wrote record + delta', record.timestamp, record.durationMs);\\n\",\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/specs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/review/lineages/scorer-attach-close-4c/tmp/build-iter-001.mjs\"}"},"time":{"start":1794683496900,"end":1794683514322}}}}
