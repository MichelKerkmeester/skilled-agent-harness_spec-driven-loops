bridges/command-bridges.generated.json\",\n    \".skilled/skills/system-spec-kit/references/structure/folder-structure.md:99-152\"\n  ],\n  \"findingsCount\": 1,\n  \"findingsSummary\": {\n    \"P0\": 0,\n    \"P1\": 0,\n    \"P2\": 1\n  },\n  \"findingsNew\": [\"DR4-P2-001\"],\n  \"findingDetails\": [\n    {\n      \"id\": \"DR4-P2-001\",\n      \"severity\": \"P2\",\n      \"title\": \"A11 malformed-row finding has no specific repair, while the A11 troubleshooting row points at a tool that cannot fix it\",\n      \"category\": \"maintainability\",\n      \"dimension\": \"correctness\",\n      \"file\": \".skilled/commands/doctor/assets/doctor-agents-md-presentation.txt:267\",\n      \"line\": 267,\n      \"case\": \"A consumer's REPO RULES.md trigger row has four cells where the header has three and still carries its rule path. A11 prints '0 shipped row(s) missing, 1 malformed row(s); [repo-rules summary] (FINDING)'; the A11 troubleshooting row says to run /doctor:agents-md embed; embed adds no row because nothing is missing and reports 'no other row was touched'; the malformed row remains and the rerun reports the same finding.\",\n      \"evidence\": \"The A11-specific troubleshooting row names missing rows only and points at embed (doctor-agents-md-presentation.txt:267). The embed engine's router repair only calls addRouterRows and prints 'no other row was touched' (agents-md-embed.cjs:782-794). The changed detail makes a malformed row a finding with zero missing rows (agents-md-check.cjs:798-809). The generic FINDING row at doctor-agents-md-presentation.txt:262 still says to read the detail and fix the requirement.\",\n      \"recommendation\": \"Extend the A11 row to name the malformed case and its actual repair (correct the row's cell count in REPO RULES.md), or state that embed only adds missing rows and cannot rewrite a malformed one.\",\n      \"findingClass\": \"class-of-bug\",\n      \"scopeProof\": \"rg -n 'A11|missing router rows|malformed' .skilled/commands/doctor/assets/doctor-agents-md-presentation.txt finds one A11-specific row at :267; the only other repair is the generic FINDING row at :262. agents-md-embed.cjs:782-804 shows the router repair only appends missing rows and never rewrites an existing row.\",\n      \"affectedSurfaceHints\": [\"A11 row\", \"doctor-agents-md troubleshooting table\", \"agents-md-embed addRouterRows\", \"manual-testing-playbook doctor-agents-md-check\"],\n      \"content_hash\": \"4b77fd7145c2434d112195d9e92f72e46aaa875c85febfab581f85eb9330de12\",\n      \"confidence\": 0.82,\n      \"downgradeTrigger\": \"If the generic FINDING row at doctor-agents-md-presentation.txt:262 is accepted as the named repair for every A11 cause, downgrade this to a documentation observation.\",\n      \"firstSeen\": 1,\n      \"lastSeen\": 1,\n      \"status\": \"active\"\n    }\n  ],\n  \"traceabilityChecks\": {\n    \"results\": [\n      {\n        \"protocolId\": \"spec_code\",\n        \"status\": \"pass\",\n        \"gateClass\": \"hard\",\n        \"applicable\": true,\n        \"counts\": {\"pass\": 3, \"partial\": 0, \"fail\": 0, \"skipped\": 0},\n        \"evidence\": [\"specs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/goal.md:216\", \"specs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/014-review-remediation/tasks.md:115\", \".skilled/commands/doctor/scripts/tests/agents-md-check.test.cjs:763-764\"],\n        \"findingRefs\": [],\n        \"summary\": \"The changed detail matches the A-2 alignment item and the T027 malformed-row contract; the new test pins it.\"\n      },\n      {\n        \"protocolId\": \"checklist_evidence\",\n        \"status\": \"partial\",\n        \"gateClass\": \"hard\",\n        \"applicable\": true,\n        \"counts\": {\"pass\": 1, \"partial\": 1, \"fail\": 0, \"skipped\": 0},\n        \"evidence\": [\"specs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/014-review-remediation/acceptance-criteria.md:72\", \".skilled/commands/doctor/assets/doctor-agents-md-presentation.txt:267\"],\n        \"findingRefs\": [\"DR4-P2-001\"],\n        \"summary\": \"AC-017 is met for the malformed line and the no-missing case; no checklist row requires a repair mapping for that case, so the gap is advisory.\"\n      },\n      {\n        \"protocolId\": \"skill_agent\",\n        \"status\": \"notApplicable\",\n        \"gateClass\": \"advisory\",\n        \"applicable\": false,\n        \"counts\": {\"pass\": 0, \"partial\": 0, \"fail\": 0, \"skipped\": 1},\n        \"evidence\": [],\n        \"findingRefs\": [],\n        \"summary\": \"The changed files are a doctor command, a route manifest and a create presentation; no skill/agent pair changed.\"\n      },\n      {\n        \"protocolId\": \"agent_cross_runtime\",\n        \"status\": \"pass\",\n        \"gateClass\": \"advisory\",\n        \"applicable\": true,\n        \"counts\": {\"pass\": 1, \"partial\": 0, \"fail\": 0, \"skipped\": 0},\n        \"evidence\": [\".skilled/commands/create/assets/create-skill-presentation.txt:89\", \".skilled/skills/system-skill-advisor/runtime/scripts/command-bridges/command-bridges.generated.json\"],\n        \"findingRefs\": [],\n        \"summary\": \"The presentation is plain text read by every runtime; the command routers are mirrored per runtime and none carries the presentation wording; the derived bridge data is in sync.\"\n      },\n      {\n        \"protocolId\": \"feature_catalog_code\",\n        \"status\": \"partial\",\n        \"gateClass\": \"advisory\",\n        \"applicable\": true,\n        \"counts\": {\"pass\": 0, \"partial\": 1, \"fail\": 0, \"skipped\": 0},\n        \"evidence\": [],\n        \"findingRefs\": [],\n        \"summary\": \"Deferred to the iteration-2 traceability pass; the doctor route and create command catalog descriptions are not yet cross-read.\"\n      },\n      {\n        \"protocolId\": \"playbook_capability\",\n        \"status\": \"partial\",\n        \"gateClass\": \"advisory\",\n        \"applicable\": true,\n        \"counts\": {\"pass\": 0, \"partial\": 1, \"fail\": 0, \"skipped\": 0},\n        \"evidence\": [\".skilled/manual-testing-playbook/doctor-commands/doctor-agents-md-check.md:30\", \".skilled/manual-testing-playbook/doctor-commands/doctor-agents-md-check.md:102\"],\n        \"findingRefs\": [\"DR4-P2-001\"],\n        \"summary\": \"The playbook requires a repair for each finding and treats a finding without its repair as a FAIL; the A11-specific row covers missing rows only, and the generic row covers the malformed case only by inference.\"\n      }\n    ]\n  },\n  \"newFindingsRatio\": 1.0,\n  \"sessionId\": \"fanout-doctor-docs-4-1794669272137-9v23rz\",\n  \"generation\": 1,\n  \"lineageMode\": \"new\",\n  \"timestamp\": \"2026-11-14T15:34:44Z\",\n  \"durationMs\": 300000,\n  \"reviewDepthSchemaVersion\": 2,\n  \"reviewDepthApplicability\": {\n    \"scopeClass\": \"standard\",\n    \"enforcement\": \"warn\",\n    \"reason\": \"Four changed files plus shared docs and cross-file repair contracts; the diff is small but the traceability surface spans the doctor presentation, the embed engine and the create command.\",\n    \"evidenceRefs\": [\".skilled/commands/doctor/scripts/agents-md-check.cjs:798-809\", \".skilled/commands/doctor/assets/doctor-agents-md-presentation.txt:267\", \".skilled/commands/create/assets/create-skill-presentation.txt:89\"]\n  },\n  \"targetSelection\": {\n    \"selectedTargets\": [\n      \".skilled/commands/doctor/scripts/agents-md-check.cjs\",\n      \".skilled/commands/doctor/scripts/tests/agents-md-check.test.cjs\",\n      \".skilled/commands/doctor/_routes.yaml\",\n      \".skilled/commands/create/assets/create-skill-presentation.txt\",\n      \".skilled/commands/doctor/assets/doctor-agents-md-presentation.txt\",\n      \".skilled/commands/doctor/scripts/agents-md-embed.cjs\",\n      \".skilled/commands/create/assets/create-skill-auto.yaml\"\n    ],\n    \"selectionReason\": \"The review-scope-4.txt area doctor-docs names the first four; the remaining three are the direct consumers and repair surfaces named by the changed code and its presentation.\",\n    \"discoveryMethods\": [\"direct_read\", \"exact_search\", \"git_diff_stat\"],\n    \"omittedHighRiskTargets\": [\"command-prompts.jsonl (holdout; not opened)\", \"holdout-prompts.jsonl (not opened)\"],\n    \"graphStatus\": \"unavailable\",\n    \"semanticSearchStatus\": \"unavailable\",\n    \"evidenceRefs\": [\"review-scope-4.txt:6-9\", \"review-brief-4.txt:1\"]\n  },\n  \"searchCoverage\": {\n    \"requiredBugClasses\": [\"behavioral_contract\", \"docs_code_divergence\", \"mutating_attachment\", \"cross_runtime_parity\", \"derived_data_sync\", \"holdout_leakage\"],\n    \"covered\": [\"behavioral_contract\", \"docs_code_divergence\", \"cross_runtime_parity\", \"derived_data_sync\", \"holdout_leakage\"],\n    \"ruledOut\": [\"cross_runtime_parity\", \"derived_data_sync\", \"holdout_leakage\"],\n    \"deferred\": [\"mutating_attachment\"],\n    \"blocked\": [],\n    \"graphCoverageMode\": \"graphless_fallback\"\n  },\n  \"searchLedger\": [\n    {\n      \"id\": \"SL-001\",\n      \"dimension\": \"correctness\",\n      \"targetRefs\": [\".skilled/commands/doctor/scripts/agents-md-check.cjs:798-809\"],\n      \"bugClass\": \"behavioral_contract\",\n      \"hypothesis\": \"The new malformed count can disagree with the rows the check actually prints.\",\n      \"searchActions\": [\n        {\"method\": \"direct_read\", \"queryOrPath\": \"agents-md-check.cjs:757-839\", \"result\": \"lines holds each missing entry once and each malformed row once; the subtraction is the malformed count for the tested case.\", \"evidenceRefs\": [\"agents-md-check.cjs:772-809\"]},\n        {\"method\": \"direct_read\", \"queryOrPath\": \"agents-md-check.test.cjs:742-765\", \"result\": \"the test keeps the rule path and asserts the new detail prefix.\", \"evidenceRefs\": [\"agents-md-check.t