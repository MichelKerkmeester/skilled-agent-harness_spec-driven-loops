tFocus, anchorOptions);\n2340:      // A missing machine-owned anchor is a warning-class input problem, not\n2453:      'Usage: node .skilled/skills/system-deep-loop/runtime/scripts/reduce-state.cjs <spec-folder> [--artifact-dir <path>] [--lenient] [--create-missing-anchors] [--emit-resource-map]\\n',\n2518:  replaceAnchorSection,\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\": \"rg -n \\\"replaceAnchorSection|anchor|MACHINE-OWNED|sectionId\\\" .skilled/skills/system-deep-loop/runtime/scripts/reduce-state.cjs | head -60\", \"workdir\": \"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research\"}"},"time":{"start":1794670040211,"end":1794670040280}}}}
