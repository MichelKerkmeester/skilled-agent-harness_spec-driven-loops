0:       compat:\n791:         yaml: doctor-update-compat-action.yaml\n792:         mutating: mutates\n793:         trigger_phrases:\n794:           - \"spec-kit version migration\"\n795:           - \"pre-v4 spec folder upgrade\"\n796:           - \"move .opencode/specs to specs\"\n797:     trigger_phrases:\n798:       - \"doctor update command\"\n799:       - \"update skills to latest release\"\n800:       - \"skilled release update\"\n801:       - \"update skilled to the latest release\"\n802:       - \"check for skilled updates\"\n803:       - \"is there a newer skilled release\"\n804:       - \"update my project to a newer skilled release\"\n805:       - \"move my project to the newer spec-kit release\"\n806:       - \"is there a newer release of the toolkit\"\n807: \n808:   - command: /doctor:env\n809:     file: .skilled/commands/doctor/env.md\n810:     yaml: doctor-env.yaml\n811:     mutating: mutates\n812:     actions:\n813:       list:\n814:         yaml: doctor-env.yaml\n815:         mutating: read-only\n816:       select:\n817:         yaml: doctor-env.yaml\n818:         mutating: mutates\n819:     # With no selector the router stops at a menu, so the runnable form names `list`.\n820:     runnable: /doctor:env list\n821:     trigger_phrases:\n822:       - \"check my environment variables\"\n823:       - \"which environment variable switches are set\"\n824:       - \"skilled environment switch values\"\n825:       - \"environment switch inventory\"\n826:       - \"which environment switches are set and where\"\n827:     lead_phrases:\n828:       - \"check my environment variables\"","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file .skilled/commands/doctor/_routes.yaml, lines 750-828\n750:       - \"install code mode in my project\"\n751: \n752:   - sub_action: debug\n753:     yaml: doctor-mcp-debug.yaml\n754:     allowed_flags: [\"--fix\"]\n755:     mutating: mutates\n756:     gate3_location: \"Code Mode