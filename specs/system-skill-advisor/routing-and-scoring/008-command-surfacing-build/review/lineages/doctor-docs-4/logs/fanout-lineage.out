:   it.each([\n251:     'update the README typo in line 3',\n252:     'fix the typo in the README',\n253:     'correct the spelling in the hooks readme',\n254:     'fix the broken link in the install guide readme',\n255:   ])('offers no creation command for %s', (prompt) => {\n256:     expect(attachCommand('sk-doc', SINGLE('sk-create-readme'), prompt)).toBeUndefined();\n257:   });\n258: \n259:   it.each([\n260:     'write a readme for the doctor scripts folder',\n261:     'create a readme for the payments module, check it for typos when done',\n262:   ])('still offers the creation command for %s', (prompt) => {\n263:     expect(attachCommand('sk-doc', SINGLE('sk-create-readme'), prompt)).toBe('/create:readme');\n264:   });\n265: \n266:   it.each([\n267:     ['sk-doc', 'sk-create-agent', 'build an agent that fixes typos in our docs'],\n268:     ['sk-doc', 'sk-create-readme', 'writing a readme for the grammar module'],\n269:     ['sk-doc', 'sk-create-readme', 'add a readme for the spelling package'],\n[Output truncated. Continue reading with offset: 270]"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"limit\": 150, \"offset\": 120, \"path\": \".skilled/skills/system-skill-advisor/runtime/tests/command-attach-guards.vitest.ts\"}"},"time":{"start":1794670712739,"end":1794670714637}}}}
