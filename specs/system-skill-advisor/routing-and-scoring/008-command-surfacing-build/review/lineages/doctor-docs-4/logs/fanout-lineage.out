ucturedFindingCount,\n431:       stateParseFailureCount,\n432:     });\n433:     // Review incompleteness is a warning the workflow still records.\n434:     return;\n435:   }\n436:   stage(args.eventDir, scopeRunId, mode, {\n437:     event: 'synthesis_complete',\n438:     mode: 'review',\n439:     totalIterations: counts.totalIterations,\n440:     activeP0,\n441:     activeP1,\n442:     activeP2,\n443:     dimensionCoverage,\n444:     verdict: args.verdict,\n445:     releaseReadinessState: args.releaseReadinessState,\n446:     stopReason: args.stopReason,\n447:   });\n448: }\n449: \n450: // ───────────────────────────────────────────────────────────────────\n451: // 5. CLI ENTRY\n452: // ───────────────────────────────────────────────────────────────────\n453: \n454: function main() {\n455:   try {\n456:     const args = parseArgs(process.argv.slice(2));\n457:     assertRequired(args);\n458:     closeOut(args);\n459:   } catch (error) {\n460:     const message = error instanceof Error ? error.message : String(error);\n461:     process.stderr.write(`${message}\\n`);\n462:     process.exit(1);\n463:   }\n464: }\n465: \n466: if (require.main === module) {\n467:   main();\n468: }"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"limit\": 180, \"offset\": 360, \"path\": \".skilled/skills/system-deep-loop/runtime/scripts/synthesis-closeout.cjs\"}"},"time":{"start":1794671457304,"end":1794671457682}}}}
