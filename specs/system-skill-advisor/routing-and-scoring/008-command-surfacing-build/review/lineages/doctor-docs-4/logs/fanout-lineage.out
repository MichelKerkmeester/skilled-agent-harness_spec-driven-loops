n    \"specs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/024-fable-review-remediation/spec.md:111-112\",\n    \"specs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/024-fable-review-remediation/implementation-summary.md:92\",\n    \".claude/commands/create/sk-skill.md\",\n    \".cursor/commands/create-sk-skill.md\",\n    \".codex/prompts/create-sk-skill.md\",\n    \".pi/prompts/create-sk-skill.md\",\n    \".dsh/prompts/create-sk-skill.md\",\n    \".devin/config.json\"\n  ],\n  \"findingsCount\": 1,\n  \"findingsSummary\": {\n    \"P0\": 0,\n    \"P1\": 0,\n    \"P2\": 1\n  },\n  \"findingsNew\": [],\n  \"findingDetails\": [\n    {\n      \"id\": \"DR4-P2-001\",\n      \"severity\": \"P2\",\n      \"title\": \"A11 malformed-row finding has no specific repair, while the A11 troubleshooting row points at a tool that cannot fix it\",\n      \"category\": \"maintainability\",\n      \"dimension\": \"traceability\",\n      \"file\": \".skilled/commands/doctor/assets/doctor-agents-md-presentation.txt:267\",\n      \"line\": 267,\n      \"claim\": \"The A11-specific repair row covers missing rows only, so a malformed-row finding has no specific repair and the embed tool it names cannot fix it.\",\n      \"case\": \"A consumer's REPO RULES.md trigger row has four cells where the header has three and still carries its rule path. A11 prints '0 shipped row(s) missing, 1 malformed row(s); [repo-rules summary] (FINDING)'; the A11 troubleshooting row says to run /doctor:agents-md embed; embed adds no row because nothing is missing and reports 'no other row was touched'; the malformed row remains and the rerun reports the same finding.\",\n      \"evidence\": \"The A11-specific troubleshooting row names missing rows only and points at embed (doctor-agents-md-presentation.txt:267). The embed engine's router repair only calls addRouterRows and prints 'no other row was touched' (agents-md-embed.cjs:782-794). The changed detail makes a malformed row a finding with zero missing rows (agents-md-check.cjs:798-809). The generic FINDING row at doctor-agents-md-presentation.txt:262 still says to read the detail and fix the requirement.\",\n      \"recommendation\": \"Extend the A11 row to name the malformed case and its actual repair (correct the row's cell count in REPO RULES.md), or state that embed only adds missing rows and cannot rewrite a malformed one.\",\n      \"findingClass\": \"class-of-bug\",\n      \"scopeProof\": \"rg -n 'A11|missing router rows|malformed' .skilled/commands/doctor/assets/doctor-agents-md-presentation.txt finds one A11-specific row at :267; the only other repair is the generic FINDING row at :262. agents-md-embed.cjs:782-804 shows the router repair only appends missing rows and never rewrites an existing row.\",\n      \"affectedSurfaceHints\": [\"A11 row\", \"doctor-agents-md troubleshooting table\", \"agents-md-embed addRouterRows\", \"manual-testing-playbook doctor-agents-md-check\"],\n      \"content_hash\": \"4b77fd7145c2434d112195d9e92f72e46aaa875c85febfab581f85eb9330de12\",\n      \"confidence\": 0.82,\n      \"downgradeTrigger\": \"If the generic FINDING row at doctor-agents-md-presentation.txt:262 is accepted as the named repair for every A11 cause, downgrade this to a documentation observation.\",\n      \"firstSeen\": 1,\n      \"lastSeen\": 2,\n      \"status\": \"active\"\n    }\n  ],\n  \"traceabilityChecks\": {\n    \"results\": [\n      {\n        \"protocolId\": \"spec_code\",\n        \"status\": \"pass\",\n        \"gateClass\": \"hard\",\n        \"applicable\": true,\n        \"counts\": {\"pass\": 3, \"partial\": 0, \"fail\": 0, \"skipped\": 0},\n        \"evidence\": [\"a494145dd0 commit body\", \"specs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/024-fable-review-remediation/spec.md:111-112\", \"specs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/016-claude-create-reach-and-doctor-default/spec.md:256\"],\n 