ite-containment sections');\n1369:             }\n1370: \n1371:             const repoRoot = realpathSync('{repo_root}');\n1372:             const artifactDir = resolve(repoRoot, '{state_paths.packet_dir}');\n1373:             const artifactRelative = relative(repoRoot, artifactDir);\n1374:             if (artifactRelative === '' || artifactRelative.startsWith('..') || isAbsolute(artifactRelative)) {\n1375:               throw new Error('Unsafe cli-opencode dispatch: artifact directory must be a strict descendant of the worktree root');\n1376:             }\n1377: \n1378:             const git = (args, cwd = repoRoot, trim = true) => {\n1379:               const output = execFileSync('git', args, { cwd, encoding: 'utf8' });\n1380:               return trim ? output.trim() : output;\n1381:             };\n1382:             const resolveGitPath = (candidate) => realpathSync(isAbsolute(candidate) ? candidate : resolve(repoRoot, candidate));\n1383:             const gitDir = resolveGitPath(git(['rev-parse', '--git-dir']));\n1384:             const commonGitDir = resolveGitPath(git(['rev-parse', '--git-common-dir']));\n1385:             if (gitDir === commonGitDir) {\n1386:               throw new Error('Unsafe cli-opencode dispatch: --dir must point at an isolated linked worktree');\n1387:             }\n1388: \n1389:             const primaryBlock = git(['worktree', 'list', '--porcelain'])\n1390:               .split(/\\n\\n+/)\n1391:               .find((block) => /^branch refs\\/heads\\/(?:main|master)$/m.test(block));\n1392:             const primaryLine = primaryBlock?.split('\\n').find((line) => line.startsWith('worktree '));\n1393:             if (!primaryLine) {\n1394:               throw new Error('Unsafe cli-opencode dispatch: primary main/master worktree could not be resolved');\n1395:             }\n1396:             const primaryRoot = realpathSync(primaryLine.slice('worktree '.length));\n1397:             const primaryStatus = git(['status', '--porcelain=v1', '--untracked-files=all'], primaryRoot);\n1398:             if (primaryStatus) {\n1399:               throw new Error('Unsafe cli-opencode dispatch: primary worktree must be clean before unrestricted execution');\n1400:             }\n1401: \n1402:             const dirtyPaths = [\n1403:               ...git(['diff', '--name-only', '-z', 'HEAD', '--'], repoRoot, false).split('\\0'),\n1404:               ...git(['ls-files', '--others', '--exclude-standard', '-z'], repoRoot, false).split('\\0'),\n1405:             ].filter(Boolean);\n1406:             const canonicalLocation = (absolutePath) => {\n1407:               try {\n1408:                 return realpathSync(absolutePath);\n1409:               } catch {\n1410:                 let parentReal;\n1411:                 try {\n1412:                   parentReal = realpathSync(dirname(absolutePath));\n1413:                 } catch {\n1414:                   return absolutePath;\n1415:                 }\n1416:                 const leaf = resolve(parentReal, basename(absolutePath));\n1417:                 try {\n1418:                   // A dangling link still names the location it points at, and becomes a live\n1419:                   // escape the moment that target is created.\n1420:                   const target = readlinkSync(leaf);\n1421:                   return isAbsolute(target) ? resolve(target) : resolve(parentReal, target);\n1422:                 } catch {\n1423:                   return leaf;\n1424:                 }\n1425:               }\n1426:             };\n1427:             const artifactDirReal = canonicalLocation(artifactDir);\n1428:             // git reports the path it walked, not where the bytes land: a symlink component\n1429:             // under the artifact dir leaves a path that looks contained while its real\n1430:             // location is wherever the link points. Containment has to hold both by name and\n1431:             // after every component is resolved, so resolution can only ever narrow scope.\n1432:             const escapesArtifactDir = (absolutePath) => {\n1433:               const lexical = relative(artifactDir, absolutePath);\n1434:               if (lexical.startsWith('..') || isAbsolute(lexical)) return true;\n1435:               const canonical = relative(artifactDirReal, canonicalLocation(absolutePath));\n1436:               return canonical.startsWith('..') || isAbsolute(canonical);\n1437:             };\n1438:             const outsideArtifactDir = dirtyPaths.filter((candidate) => escapesArtifactDir(resolve(repoRoot, candidate)));\n1439:             if (outsideArtifactDir.length > 0) {\n1440:               throw new Error(`Unsafe cli-opencode dispatch: worktree changes outside the artifact directory: ${outsideArtifactDir.join(', ')}`);\n1441:             }\n1442: \n1443:             const recoveryBaselineCommit = git(['rev-parse', '--verify', 'HEAD']);\n1444:             // The state log is a projection the gateway rebuilds from the ledger, so the\n1445:             // recovery baseline is staged as a canonical ledger event for the wrapper\n1446:             // below to append; a write beside the projection is dropped by the next refresh.\n1447:             writeFileSync(\n1448:               join(process.argv[2], '01-recovery_baseline.json'),\n1449:               JSON.stringify({\n1450:                 stem: 'deep_review.recovery_baseline',\n1451:                 scope: { runId: '{session_id}', sessionId: '{session_id}' },\n1452:                 data: {\n1453:                   mode: 'review',\n1454:                   iteration: Number('{current_iteration}'),\n1455:                   recoveryBaselineCommit,\n1456:                   worktree: repoRoot,\n1457:                 },\n1458:               }),\n1459:               'utf8',\n1460:             );\n1461:             const message = 'Resolved route: mode=review; target_agent=@deep-review; execution=single_review_iteration; state_source=externalized_files; do_not_switch_mode=true'\n1462:               + '\\n\\n'\n1463:               + promptBody;\n1464: \n1465:             const lineage = { kind: 'cli-opencode', model, reasoningEffort, sandboxMode };\n1466:             const resolvedPermission = resolveClaudePermissionMode(sandboxMode);\n1467:             const { command, args, input, cwd } = buildLineageCommand(\n1468:               lineage,\n1469:               message,\n1470:               sandboxMode,\n1471:               resolvedPermission,\n1472:               { env: process.env, cwd: repoRoot, directoryRoot: repoRoot },\n1473:             );\n1474: \n1475:             const dispatchFacts = {\n1476:               command: 'deep/review',\n1477:               mode: 'review',\n1478:               specFolder: '{spec_folder}',\n1479:               artifactDir: '{state_paths.packet_dir}',\n1480:               iteration: Number('{current_iteration}'),\n1481:               executorKind: '{config.executor.kind}',\n1482:               branchId: '{config.executor.kind}',\n1483:               sessionId: '{session_id}',\n1484:               generation: Number('{generation}'),\n1485:             };\n1486:             const dispatchId = 'review-i{current_iteration}-g{generation}';\n1487:             process.exit(\n1488:               runAuditedExecutorCommand({\n1489:                 command,\n1490:                 args,\n1491:                 cwd: cwd || repoRoot,\n1492:                 timeoutSeconds: executor.timeoutSeconds,\n1493:                 stateLogPath: '{state_paths.state_log}',\n1494:                 executor,\n1495:                 iteration: Number('{current_iteration}'),\n1496:                 // buildLineageCommand returns empty input, so stdin is closed for OpenCode.\n1497:                 input,\n1498:                 receiptDir: '{state_paths.packet_dir}/dispatch-receipts',\n1499:                 dispatchId,\n1500:               }),\n1501:             );\n1502:             EOF\n1503:             NODE_STATUS=$?\n1504:             for eventFile in \"$EVENT_DIR\"/*.json; do\n1505:               [ -e \"$eventFile\" ] || continue\n1506:               node \"$GATEWAY\" --mode review --run-directory \"$(dirname \"{state_paths.state_log}\")\" --event-json \"$eventFile\"\n1507:               GATEWAY_STATUS=$?\n1508:               if [ \"$GATEWAY_STATUS\" -ne 0 ]; then\n1509:                 rm -rf \"$EVENT_DIR\"\n1510:                 exit \"$GATEWAY_STATUS\"\n1511:               fi\n1512:             done\n1513:             rm -rf \"$EVENT_DIR\"\n1514:             exit \"$NODE_STATUS\"\n1515:           working_directory: \"{repo_root}\"\n1516:           timeout_seconds: \"{config.executor.timeoutSeconds}\"\n1517:           wait_for_completion: true\n1518:           notes:\n1519:             - \"Routed through runAuditedExecutorCommand so opencode produces INTENT + COMPLETION dispatch receipts; recursion guard + env allowlist enforced via buildExecutorDispatchEnv\"\n1520:             - \"Fail closed before dispatch unless the rendered containment sections exist, --dir is an isolated linked worktree, the primary worktree is clean, and current-worktree changes are confined to artifact_dir both by name and after every path component is resolved through symlinks; append the recovery-baseline commit to state_log\"\n1521:             - \"buildLineageCommand returns empty input, so stdin is closed (EOF), equivalent to </dev/null\"\n1522:             - \"buildLineageCommand receives the route-proof preamble + iteration body as its message\"\n1523:             - \"buildLineageCommand maps reasoningEffort to the installed OpenCode version's supported option\"\n1524:             - \"buildLineageCommand resolves the OpenCode binary and version-correct argv for the configured sandboxMode\"\n1525:             - \"cli-opencode self-invocation guard: this single-executor branch must only run from a non-OpenCode dispatch surface (Claude Code/raw shell). Explicit parallel-detached cli-opencode fan-out is handled by step_fanout_spawn_cli/fanout-run.cjs, not this branch. the `cli-external-orchestration/cli-opencode` mode's SKILL.md (`.skilled/skills/cli-external-orchestration/cli-opencode/SKILL.md`) §SELF-INVOCATION PROHIBITED contract is the authoritative gate\"\n1526:         if_cli_codex:\n1527:           command: |\n1528:             node --import \"$(node -p \"require.resolve('tsx', { paths: ['.skilled/skills/system-deep-loop/runtime'] })\")\" --input-type=module <<'EOF'\n1529:             import { readFileSync } from 'node:fs';\n1530:             import { execFileSync } from 'node:child_process';\n1531:             import { createRequire } from 'node:module';\n1532: \n1533:             import {\n1534:               RECURSION_GUARD_EXIT_CODE,\n1535:               formatRecursionGuardRefusal,\n1536:               runAuditedExecutorCommand,\n1537:               validateExecutorDispatchAllowed,\n1538:             } from './.skilled/skills/system-deep-loop/runtime/lib/deep-loop/executor-audit.ts';\n1539:             import {\n1540:               snapshotOutOfScopeDirtyPaths,\n1541:               enforceWriteContainment,\n1542:             } from './.skilled/skills/system-deep-loop/runtime/lib/deep-loop/write-containment.ts';\n1543: \n1544:             // Fail closed: a requested codex executor must dispatch codex or abort,\n1545:             // never silently degrade to another executor. Undetected absence is what\n1546:             // got Codex deprecated before, so the branch exits non-zero when the\n1547:             // binary is missing instead of falling through to a native/other path.\n1548:             let codexAvailable = false;\n1549:             try {\n1550:               execFileSync('/bin/sh', ['-c', 'command -v codex >/dev/null 2>&1'], { stdio: 'ignore' });\n1551:               codexAvailable = true;\n1552:             } catch {}\n1553:             if (!codexAvailable) {\n1554:               console.error('cli-codex executor unavailable: command -v codex failed');\n1555:               process.exit(1);\n1556:             }\n1557: \n1558:             const reasoningEffort = '{config.executor.reasoningEffort}' === 'null' ? null : '{config.executor.reasoningEffort}';\n1559:             const serviceTier = '{config.executor.serviceTier}' === 'null' ? null : '{config.executor.serviceTier}';\n1560:             const model = '{config.executor.model}' === 'null' ? null : '{config.executor.model}';\n1561:             const executor = {\n1562:               kind: 'cli-codex',\n1563:               model,\n1564:               configDir: null,\n1565:               reasoningEffort,\n1566:               serviceTier,\n1567:               sandboxMode: 'workspace-write',\n1568:               timeoutSeconds: Number('{config.executor.timeoutSeconds}'),\n1569:               governor: null,\n1570:             };\n1571: \n1572:             // Refuse before any spawn and before any receipt is written, so a refusal can\n1573:             // never be mistaken for a real attempt. A process that is already a CLI lineage\n1574:             // or a codex session must run the iteration itself, not delegate it onward.\n1575:             const guardVerdict = validateExecutorDispatchAllowed(executor, { env: process.env });\n1576:             if (!guardVerdict.allowed) {\n1577:               console.error(formatRecursionGuardRefusal(guardVerdict, executor));\n1578:               process.exit(RECURSION_GUARD_EXIT_CODE);\n1579:             }\n1580: \n1581:             const require = createRequire(import.meta.url);\n1582:             const { withAgentPersona } = require('./.skilled/skills/system-deep-loop/runtime/scripts/fanout-run.cjs');\n1583:             const promptBody = withAgentPersona('deep-review', readFileSync('{state_paths.prompt_dir}/iteration-{current_iteration}.md', 'utf8'), '{repo_root}');\n1584: \n1585:             // codex reads the iteration prompt from stdin via the trailing '-'. A review\n1586:             // iteration must WRITE its own iteration file, delta and state record, so the\n1587:             // sandbox is workspace-write — read-only would block those required writes.\n1588:             // approval_policy=never keeps the run non-interactive.\n1589:             const args = ['exec'];\n1590:             if (model) {\n1591:               args.push('--model', model);\n1592:             }\n1593:             args.push('-c', 'model_reasoning_effort=' + (reasoningEffort || 'medium'));\n1594:             if (serviceTier) {\n1595:               args.push('-c', 'service_tier=' + serviceTier);\n1596:             }\n1597:             args.push('-c', 'approval_policy=never', '--sandbox', executor.sandboxMode, '-');\n1598: \n1599:             const dispatchId = 'review-i{current_iteration}-g{generation}';\n1600:             const repoRoot = '{repo_root}';\n1601:             const artifactDir = '{artifact_dir}';\n1602:             const preDispatchDirtyPaths = snapshotOutOfScopeDirtyPaths({ repoRoot, artifactDir });\n1603:             const dispatchExit = runAuditedExecutorCommand({\n1604:               command: 'codex',\n1605:               args,\n1606:               cwd: repoRoot,\n1607:               timeoutSeconds: executor.timeoutSeconds,\n1608:               stateLogPath: '{state_paths.state_log}',\n1609:               executor,\n1610:               iteration: Number('{current_iteration}'),\n1611:               input: promptBody,\n1612:               receiptDir: '{state_paths.packet_dir}/dispatch-receipts',\n1613:               dispatchId,\n1614:             });\n1615:             // Structural write-containment: the artifact-dir boundary is prompt-only, so a\n1616:             // workspace-write leaf can write anywhere in the repo. The guard diffs the tree\n1617:             // after the dispatch and reports every NEW out-of-artifact-dir path. Its remedy\n1618:             // PRESERVES by default -- event recorded, copy quarantined, bytes left on disk --\n1619:             // because a path it cannot attribute may belong to a concurrent writer, so a\n[Output truncated. Continue reading with offset: 1620]"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"limit\":420,\"offset\":1200,\"path\":\".skilled/commands/deep/assets/deep-review-auto.yaml\"}"},"time":{"start":1794669383818,"end":1794669385033}}}}
{"type":"tool_use","timestamp":1794669385037,"sessionID":"ses_e255ff46effe7EWyuOLOEwVdy1","part":{"partID":"prt_1daa19334001ZzHb7YM8eZwxVi","sessionID":"ses_e255ff46effe7EWyuOLOEwVdy1","messageID":"msg_1daa10c04001S1AjiKlmp6djLY","type":"tool","id":"call_d54898d9fcbd4b379f184fc9","tool":"read","state":{"status":"completed","input":{"path":".skilled/skills/sk-code/sk-code-review/SKILL.md"},"output":"Read file .skilled/skills/sk-code/sk-code-review/SKILL.md, lines 1-421\n1: ---\n2: name: sk-code-review\n3: description: \"Stack-agnostic code-review for sk-code: findings-first severity, security/correctness minimums, and surface evidence.\"\n4: allowed-tools: [Read, Bash, Grep, Glob, Write]\n5: version: 1.9.16.0\n6: metadata:\n7:   family: sk-code\n8: ---\n9: \n10: # sk-code-review Mode - Stack-Agnostic Findings-First Review\n11: \n12: Universal findings-first review baseline paired with `sk-code` surface standards evidence for the detected code surface.\n13: \n14: ## 1. WHEN TO USE\n15: \n16: ### Activation Triggers\n17: \n18: Use the `sk-code-review` mode (of the sk-code family) when:\n19: - A user asks for code review, PR review, or merge readiness.\n20: - A workflow dispatches `@review` for pre-commit or gate validation.\n21: - A user requests security/correctness risk analysis before merge.\n22: - A user wants severity-ranked findings with file:line evidence.\n23: \n24: ### Keyword Triggers\n25: \n26: `review`, `code review`, `pr review`, `audit`, `security review`, `request changes`, `findings`, `blocking issues`, `merge readiness`\n27: \n28: ### Use Cases\n29: \n30: 1. Review-only pass: findings-first output with no code edits.\n31: 2. Gate validation: a pass or fail that follows severity for orchestrated workflows, with any score advisory only.\n32: 3. Focused risk pass: security, concurrency, correctness, or removal-focused review.\n33: \n34: ### When NOT to Use\n35: \n36: - Feature implementation without review intent; load the surface packet (`sk-code-skilled`) that carries the implement doctrine.\n37: - Pure documentation editing where code behavior is not being assessed.\n38: - Git-only workflow tasks (branching, rebasing, commit hygiene) without code quality evaluation intent.\n39: - Applying review fixes after findings are accepted; load the surface packet (`sk-code-skilled`) that carries the implement doctrine.\n40: - Author-side quality gates before review; use `sk-code-quality`.\n41: - Root-cause debugging; use the surface's `workflow-debug.md` doctrine.\n42: - Verification evidence collection; use the surface's `workflow-verify.md` doctrine.\n43: \n44: ---\n45: \n46: ## 2. SMART ROUTING\n47: \n48: The hub bundles this mode for a code review, a pull-request review, merge readiness or a security and correctness pass over a diff.\n49: Its vocabulary is `review`, `code review`, `pr review`, `audit`, `security review`, `request changes`, `findings`, `blocking issues` and `merge readiness`.\n50: The first resource it loads is `references/review-core.md`, the doctrine both `@review` and `@deep-review` read.\n51: \n52: Review keeps no detection of its own.\n53: The quality runner's explain entry is the one resolver, and it applies the shared detection contract, [`stack-detection.md`](../shared/references/stack-detection.md) section 2.\n54: A surface the hub's router bundles from request words is only a candidate: it applies to the files the resolver places in it.\n55: \n56: The rule-override algorithm it hands to the review lives in [`review-core.md`](./references/review-core.md) section 9.\n57: Read [`ROUTER.md`](./ROUTER.md) before selecting skill-local resources; open only the matched files.\n58: \n59: ---\n60: \n61: ## 3. HOW IT WORKS\n62: \n63: ### Phase 1: Scope and Baseline\n64: \n65: 1. Check the two efficiency gates in section 8 before scoping anything: M-1 skips a review whose pull request is unchanged since the last one, and M-2 skips a diff below its opt-in evidence threshold unless it touches a sensitive path. A skip ends the review there, with the status line alone.\n66: 2. Inspect the review target (`git diff`, staged diff, file list, or commit range).\n67: 3. Load baseline standards from the `sk-code-review` mode (of the sk-code family).\n68: 4. Resolve the rule sources for the reviewed files in one call, from the reviewed repository's root, where `<hub>` is the sk-code folder this mode was loaded from (`.skilled/skills/sk-code` in the repository that ships it):\n69: \n70:    ```bash\n71:    git diff --name-only --diff-filter=d <range>   # the reviewed paths that still exist\n72:    node <hub>/sk-code-quality/scripts/quality-gate.cjs --explain <file> [<file>...]\n73:    ```\n74: \n75:    Pass only paths that exist as regular files. One deleted or missing path makes the runner stop the whole call with `FILE_NOT_FOUND`, exit 3, which would drop every surface and override for the files that do exist.\n76: \n77:    - For a diff, `--diff-filter=d` leaves the deleted paths out.\n78:    - For a file list, drop any path that is not a regular file.\n79:    - List a deleted path on the `Not checked:` line when its removal matters to the review, such as a deleted test or a removed caller.\n80: \n81:    It prints one `code-quality-explain/v1` JSON document and always exits 2, because it runs nothing. Read each `files[]` entry's `surfaces`, `surface_skills` (the folder each surface loads from), `checklists` (each with its `source`, `sources` and parsed `overrides`) and the document's `config.hygiene.disabled`.\n82: \n83:    Exit 3 on that filtered list is a usage or root fault: name it on the `Not checked:` line and review those files against the baseline only. [`runner-contract.md`](../sk-code-quality/references/runner-contract.md) section 3 owns the fields.\n84: 5. Load `sk-code` surface standards evidence for the surfaces the resolver returned. A surface the hub's router bundled from request words is a candidate, and it applies only to the files the resolver places in it: the file's `surfaces` holds its label, or one of its checklists applies to the file. A candidate that holds no reviewed file is not loaded and not named in `Surface evidence used`.\n85: 6. With no file paths to review, nothing is resolved. The bundle keeps `sk-code-skilled` only when the working directory is inside the hub's own checkout, the same git common dir as the hub folder. Anywhere else it drops `sk-code-skilled`, because a word such as \"typescript\" says nothing about whose code it is.\n86: 7. Read the connected code: the callers of each changed function, the functions each changed function calls, the tests that cover it, and the README or docs that describe it. Anything you could not read goes on the `Not checked:` line.\n87: \n88: ### Phase 2: Surface Alignment\n89: \n90: 1. Load standards from `sk-code` for the resolved surfaces only, each for the files the resolver placed in it.\n91: 2. Apply precedence matrix:\n92:    - Baseline security/correctness minimums and the rest of the floor always apply.\n93:    - Apply the `## Rule overrides` rows of the checklists the resolver returned. Use the precedence and outcomes of [`review-core.md`](./references/review-core.md) section 8: the repository checklist, then a specific surface, then the SKILLED fallback, then the default lens.\n94:      A checklist whose `overrides.refused` is true contributes no row. A hygiene rule in `config.hygiene.disabled` counts as a `none` row from the repository config.\n95:    - Surface style/process/verification conventions win on conflicts.\n96: 3. If precedence cannot be resolved deterministically, escalate before scoring. Two rows at the same level that disagree apply the default, go under `Conflicts` and are named in Next Steps.\n97: \n98: ### Phase 3: Findings-First Analysis\n99: \n100: 1. Analyze for security and correctness first.\n101: 2. Analyze quality/performance, test adequacy, contract safety, and architecture concerns.\n102: 3. Analyze KISS/DRY and SOLID violations (SRP/OCP/LSP/ISP/DIP) with evidence.\n103: 4. Analyze removal opportunities with safe-now vs deferred classification.\n104: 5. Produce findings ordered by severity (`P0`, `P1`, `P2`), numbered once across all three groups so the first `P1` finding continues after the last `P0` finding. A finding with no case is not reported.\n105: 6. For every actionable finding, classify fix scope as `instance-only`, `class-of-bug`, `cross-consumer`, `algorithmic`, `matrix/evidence`, or `test-isolation`. If unknown, default to class/cross-consumer until a producer/consumer inventory proves instance-only.\n106: \n107: #### Reach Calibration\n108: \n109: A `P0` or `P1` finding names its reach in its `Case:` line: an input or call path that the code's stated contract allows, or a real caller that sends it.\n110: A failure that needs input outside that contract, such as `NaN` where the contract says a number, a wrong type, or an inverted range the code already rejects, is `P2` hardening, unless the code claims to validate that input.\n111: Data that crosses a trust boundary is always in reach.\n112: The low-confidence escalation rule raises a finding only when its reach is named.\n113: The full rule is [`review-core.md`](./references/review-core.md) section 2.\n114: \n115: #### Numeric Severity Calibration\n116: \n117: Use numeric calibration only as reviewer context, never as the gate.\n118: A finding may include an optional advisory `riskScore` to communicate relative risk, and reviewers may adjust that score by `+/-2` for local context such as exploitability, blast radius, user impact, confidence, or proven containment.\n119: The blocking decision still comes only from the `P0`/`P1`/`P2` severity contract.\n120: Do not introduce `score>=4` or any other numeric threshold as a blocker.\n121: \n122: #### Instance-Only Opt-Out\n123: \n124: A finding may use the narrow fix path only when all are true:\n125: \n126: - It is not P0/P1 security, path, auth/authz, sandboxing, env precedence, schema, persistence, or public-response behavior.\n127: - `rg` proves no same-class producer or consumer.\n128: - Verification is local and cheap: one focused test, one doc row, or one static audit command.\n129: - The fix response includes the exact command evidence for the opt-out.\n130: \n131: Otherwise, run the full fix completeness checklist.\n132: \n133: ### Phase 4: Output and Next Action\n134: \n135: Required output contract:\n136: \n137: ```markdown\n138: ## Code Review Summary\n139: \n140: **Files reviewed**: X files, Y lines changed\n141: **Overall assessment**: [APPROVED / REQUESTED_CHANGES / COMMENTED]\n142: **Baseline used**: [sk-code (`sk-code-review`)]\n143: **Surface evidence used**: [resolved surface labels in order, such as `<specific surface>, SKILLED` or `SKILLED` | UNKNOWN]\n144: **Quality gate evidence**: [present | absent]\n145: Rule sources: [checklist files]. Overrides: [rule id none|replace from checklist file, or none]. Refused: [checklist files, or none]. Ignored: [rule id from checklist file, or none]. Conflicts: [rule id and both checklist files, or none]\n146: \n147: ## Findings\n148: \n149: ### P0 - Critical\n150: 1. [path:line] Title\n151:    - Case: [the input or situation that produces the wrong result. A finding with no case is not reported]\n152:    - Risk (for a performance finding, name the workload it assumes, such as row count, request rate or payload size)\n153:    - User impact: what users or callers bear if this fix is deferred\n154:    - Finding class: [instance-only | class-of-bug | cross-consumer | algorithmic | matrix/evidence | test-isolation]\n155:    - Scope proof: [grep/test evidence proving class coverage or instance-only status]\n156:    - affectedSurfaceHints: [optional string array of short producer/consumer surface names; recommended for actionable findings, required for cross-consumer findings]\n157:    - riskScore: [optional advisory number only; never gating]\n158:    - Recommended fix\n159: \n160: ### P1 - High\n161: 2. [path:line] Title\n162:    ...\n163: \n164: ## Removal/Iteration Plan\n165: \n166: ## Next Steps\n167: \n168: Not checked: [one line naming what mattered but could not be checked, and why, or \"nothing material\"]\n169: ```\n170: \n171: The `Rule sources:` line is defined in [`review-core.md`](./references/review-core.md) section 8: the checklists the review read, then each override outcome group, with `none` for an empty group and `Rule sources: none` when no file was resolved.\n172: It never starts with `Review status:` or `Not checked:`, so the final-line checks read the rest of the report as before, and `scripts/check-review-final-line.js` checks the line's own format when it is present.\n173: \n174: `Quality gate evidence` reads `present` when a `sk-code-quality` run verdict was handed to the review as input, and `absent` otherwise. Either value leaves every baseline check in place. The verdict is input evidence only, so no check is skipped because the gate already ran it, and no gate count renumbers a finding.\n175: \n176: The `Overall assessment` value names the same status as the final `Review status:` line, and so does a `Recommendation` line, such as the one the review agent's PR shape carries.\n177: `scripts/check-review-final-line.js` fails a report whose values disagree, and `scripts/check-review-findings.js` fails a `Recommendation` or a final status that approves or comments over a P0 or P1 finding, or requests changes with none.\n178: \n179: After reporting findings, request explicit next action before any implementation follow-up.\n180: \n181: ### Final-line exact-string contract (MANDATORY)\n182: \n183: Every review MUST end with exactly one of the following plain-text lines as the **absolute final line** of the output (no trailing whitespace, no variation):\n184: \n185: ```\n186: Review status: APPROVED\n187: ```\n188: \n189: ```\n190: Review status: REQUESTED_CHANGES\n191: ```\n192: \n193: ```\n194: Review status: COMMENTED\n195: ```\n196: \n197: Directly above the status line, separated from it by one blank line, every full review carries one `Not checked:` line naming what mattered but could not be checked and why, or `Not checked: nothing material`.\n198: An optional `AGENT_IO_RESULT` block, when requested, goes above the `Not checked:` line and never below the status line.\n199: The M-1 and M-2 skip outputs (§8) are the status line alone and carry no `Not checked:` line.\n200: \n201: **Example output bottom:**\n202: \n203: ```\n204: ...\n205: ## Next Steps\n206: 1. Fix the null-deref at src/foo.ts:42\n207: 2. Add input validation for the `/api/bar` endpoint\n208: \n209: Not checked: behavior under concurrent writes to /api/bar; no test database was available\n210: \n211: Review status: REQUESTED_CHANGES\n212: ```\n213: \n214: Downstream automation parses this final line via exact string match.\n215: Do not vary the format, add trailing punctuation, or wrap in Markdown formatting.\n216: The sole exception is the documented M-1 / M-2 skip output (§8): those lines begin with the exact `Review status: COMMENTED` and append a parenthetical reason, so a leading-verdict (grep / `startsWith`) parse still yields `COMMENTED`.\n217: A normal review must still end with one of the three exact lines above.\n218: \n219: ---\n220: \n221: ## 4. RULES\n222: \n223: ### ✅ ALWAYS\n224: \n225: - Keep findings first; summaries follow findings.\n226: - Enforce baseline security/correctness minimums regardless of surface.\n227: - Include file:line evidence for actionable findings.\n228: - State assumptions when evidence is incomplete.\n229: - Identify `sk-code` surface evidence used for standards alignment.\n230: - Read each file's surfaces, checklists and overrides from the quality runner's `--explain` resolver, never from a detection of your own.\n231: - State the applied overrides on the one `Rule sources:` line, `none` included.\n232: \n233: ### ⛔ NEVER\n234: \n235: - Override surface-specific conventions with generic baseline style preferences.\n236: - Approve code with unaddressed P0 security/correctness defects.\n237: - Produce vague findings without concrete evidence.\n238: - Mix unrelated cleanup into targeted fix recommendations.\n239: - Let an override row drop or reword a floor rule, or apply a row from a checklist the resolver did not return.\n240: - Implement fixes during review. Report findings only; implementation is a separate follow-up step.\n241: \n242: ### ⚠️ ESCALATE IF\n243: \n244: - Surface detection is ambiguous and affects standards or verification commands.\n245: - Baseline and surface guidance conflict in a non-deterministic way.\n246: - Two override rows at the same precedence level disagree on one rule for one file.\n247: - Large diff size prevents reliable severity assignment without narrowed scope.\n248: - Requested remediation exceeds review scope and becomes architecture redesign.\n249: \n250: ### Extension Floors\n251: \n252: A repository, a surface packet or a mode a user adds to the hub may raise these floors or add checks beside them. None of them may lower, skip or reword one. `scripts/check-rule-copies.js` pins each line below, so a reword fails the canary.\n253: \n254: - Baseline security and correctness minimums apply to every review, and surface guidance never relaxes them.\n255: - No review is approved while a P0 finding is unaddressed.\n256: - P0 blocks merge, P1 must be fixed before merge, and P2 is advisory and never blocks.\n257: - A dispatcher adds the `CODE-REVIEW` marker line as the first line of the rendered review prompt.\n258: - Every review ends on exactly one of the three status lines in section 3.\n259: - The mode writes only its PR-state cache file in the reviewing user's cache directory, never into the reviewed repository.\n260: \n261: ---\n262: \n263: ## 5. REFERENCES\n264: \n265: ### Core References\n266: \n267: - [review-core.md](./references/review-core.md) - Shared review doctrine: severity model, evidence rules, precedence, finding schema, and the floor, default lens and `Rule sources:` line.\n268: - [rule-overrides.md](../shared/references/universal/rule-overrides.md) - The shared `## Rule overrides` format, rule ids, hard floor and precedence that review and quality both read.\n269: - [review-ux-single-pass.md](./references/review-ux-single-pass.md) - Interactive single-pass review flow, presentation modes, and PR/pre-commit behavior.\n270: - [quick-reference.md](./references/quick-reference.md) - Lightweight index for routing between shared doctrine and single-pass UX guidance.\n271: - [pr-state-dedup.md](./references/pr-state-dedup.md) - Content-hash deduplication for unchanged pull-request reviews.\n272: - [security-checklist.md](./assets/security-checklist.md) - Mandatory security and reliability checks.\n273: - [code-quality-checklist.md](./assets/code-quality-checklist.md) - Correctness, performance, KISS, and DRY checks.\n274: - [solid-checklist.md](./assets/solid-checklist.md) - SOLID (SRP/OCP/LSP/ISP/DIP) and architecture assessment prompts.\n275: - [removal-plan.md](./assets/removal-plan.md) - Safe-now vs deferred removal planning template.\n276: - [test-quality-checklist.md](./assets/test-quality-checklist.md) - Test quality, coverage, and anti-pattern detection.\n277: - [fix-completeness-checklist.md](./assets/fix-completeness-checklist.md) - Finding classes and the producer and consumer inventories a complete fix covers.\n278: \n279: ### Reference Loading Notes\n280: \n281: - Load only the references needed for the selected intents.\n282: - Routing authority: the hub's `SKILL.md` section 2 names `hub-router.json` as the mode vocabulary and `ROUTER.md` as the leaf-set router. This packet's `INTENT_SIGNALS`, `RESOURCE_MAP` and `DEFAULT_RESOURCES` live in its [`ROUTER.md`](./ROUTER.md) section 3.\n283: \n284: ---\n285: \n286: ## 6. SUCCESS CRITERIA\n287: \n288: - Review output is findings-first and severity-ordered.\n289: - `sk-code-review` mode baseline + `sk-code` surface evidence contract is explicit in report context.\n290: - Security/correctness minimums are always covered.\n291: - Recommended fixes are actionable and scope-proportional.\n292: \n293: ---\n294: \n295: ## 7. INTEGRATION POINTS\n296: \n297: - Primary review baseline for the runtime's review agent (`@review`), wherever that runtime keeps its agent definitions.\n298: - Dispatched as `@review` by `@orchestrate`, which adds the `CODE-REVIEW` marker. The `/speckit:implement` and `/speckit:complete` workflows name `@review` as the agent for their review step and state the marker for a step that dispatches it. The `/create:*` workflows do not dispatch a review.\n299: - Complements, but does not replace, sibling ownership: the surface packets (`sk-code-skilled`) carry the implement → debug → verify workflow doctrine the acting agent applies to fix accepted findings, and `sk-code-quality` owns author-side gates.\n300: \n301: ### User-Authored Modes\n302: \n303: A repository can add its own mode to the sk-code hub, such as a security surface for its auth code. This is the review side of that mode.\n304: \n305: **What a security surface supplies.** It registers as a surface packet (`packetKind: \"surface\"`, `backendKind: \"evidence-base\"`) with its own `surfaceDetection` block, router vocabulary and a tie-break slot ahead of the fallback surface.\n306: It supplies read-only evidence: the standards and checklists to load, the markers that place a path inside it, and the verification commands for the code it owns.\n307: It never supplies a severity table, a status value or findings of its own.\n308: \n309: **What a consuming workflow may rely on.** When a request scores both this mode and the surface, the hub returns a surface bundle with this mode first and the surface after it.\n310: That bundled surface is a candidate: it applies to the files the quality runner's resolver places in it.\n311: The review then:\n312: \n313: - Names the surface's label in `Surface evidence used`.\n314: - Applies the surface's style, process and verification guidance under the precedence matrix in section 2.\n315: - Honors the `## Rule overrides` rows of the checklists its `quality` block declares at the specific-surface level.\n316: - Keeps its own `P0`/`P1`/`P2` findings, report shape and final status line.\n317: \n318: A caller parses the report the same way whichever surface was loaded.\n319: \n320: **What it may not change.** The Extension Floors in section 4 bind every user mode. A surface may add checks beside a floor and may raise one, and it may never lower, skip or reword one.\n321: \n322: The playbook scenario `CR-028` replays a user security surface through both routing stages.\n323: \n324: ---\n325: \n326: ## 8. PR-STATE EFFICIENCY GATES\n327: \n328: ### 8.1 M-1: PR-State Content-Hash Dedup\n329: \n330: Prevents redundant re-reviews when a PR has not changed since the last review.\n331: \n332: **Signature computation:**\n333: ```\n334: diff_content_hash = sha256(git diff <base-ref>...HEAD)\n335: signature         = sha256(commit_subject + \"\\u001f\" + diff_content_hash)\n336: ```\n337: Where `commit_subject` is the first line of `git log <base-ref>...HEAD --format=%s` (latest commit subject).\n338: \n339: **Cache storage:**\n340: - Path: `${XDG_CACHE_HOME:-$HOME/.cache}/sk-code-review/<repo-ref>.jsonl`, in the reviewing user's cache directory. The gate never writes into the reviewed repository. Its one side effect is this file, and deleting it resets the gate.\n341: - `<repo-ref>` is computed as `sha256(<repo identity>).slice(0, 12)`, where `<repo identity>` is `git remote get-url origin`. A repository with no `origin` remote falls back to `git rev-parse --show-toplevel`, the repository root path, so a local-only repository still gets a stable key. A moved folder changes that key, and the worst case is one cache miss and a full review.\n342: - An optional pathspec scopes the gate to one monorepo package. The same pathspec goes to the `git diff` and `git log` calls above, and `<repo-ref>` becomes `sha256(<repo identity> + \"\\u001f\" + <pathspec>).slice(0, 12)`, so each package keeps its own signature and cache file.\n343:   With no pathspec the whole repository is one scope. [references/pr-state-dedup.md](./references/pr-state-dedup.md) holds the commands.\n344: - Each line is a JSON object: `{\"signature\": \"<sha256-hex>\", \"timestamp\": \"<ISO-8601>\", \"prev_sha\": \"<commit-sha>\"}`\n345: - Retention: keep last **100 entries** per repo-ref, prune older entries on write\n346: \n347: **Skip behavior:**\n348: When the current signature matches a prior cache entry, the review emits:\n349: ```\n350: Review status: COMMENTED (no changes since last review at <prev_sha>)\n351: ```\n352: No full review analysis runs. Automation may treat `COMMENTED` as a pass (no new findings).\n353: \n354: **Cache write:** After each full review completes, write the current signature + timestamp + HEAD SHA to the cache file.\n355: \n356: ### 8.2 M-2: Opt-In Minimum Evidence Gate\n357: \n358: Skips full review for trivially small diffs to save compute, with a conservative taxonomy that **never skips** high-risk changes.\n359: \n360: **Enable gate:**\n361: ```bash\n362: export SK_CODE_REVIEW_MIN_CHANGED_LINES=50  # >0 enables; default 0 = disabled\n363: ```\n364: \n365: **Changed-line counting command:**\n366: ```bash\n367: git diff --numstat <base-ref>...HEAD | awk '{added+=$1; removed+=$2} END {print added+removed}'\n368: ```\n369: \n370: **Conservative skip taxonomy. NEVER skip when diff touches:**\n371: \n372: | Risk Class | Path/File Patterns | Rationale |\n373: |---|---|---|\n374: | Security / Authentication / Authorization | `auth*`, `*-auth-*`, `*permission*`, `*credential*`, `*token*`, `*secret*`, `*oauth*`, `*sso*`, `*login*`, `*session*` | Compromised auth defeats everything |\n375: | Config files | `*.config.*`, `*config*.json`, `*config*.yaml`, `*config*.toml`, `*.env*`, `*.ini`, `*.cfg` | One-line config change can break production |\n376: | Persistence | `*.sql`, `*migration*`, `*schema*`, `*db*.ts`, `*repository*`, paths under `/db/` or `/migrations/` | Schema changes risk data loss |\n377: | Dependency manifests | `package.json`, `package-lock.json`, `Cargo.toml`, `Cargo.lock`, `pyproject.toml`, `poetry.lock`, `requirements.txt`, `*.lock`, `Gemfile`, `Gemfile.lock` | Transitive dependency changes are high-risk |\n378: | Sandboxing / Subprocess | `*sandbox*`, `*subprocess*`, `*exec*`, `*spawn*`, `*eval*` | Arbitrary code execution boundaries |\n379: | Public-facing responses | `*.handler.ts`, `*-api*`, `*-route*`, `*-controller*`, paths under `/handlers/`, `/routes/`, `/api/` | User-visible behavior changes |\n380: \n381: **Skip behavior:**\n382: When `SK_CODE_REVIEW_MIN_CHANGED_LINES > 0`, total changed lines < threshold, AND no sensitive paths are touched:\n383: ```\n384: Review status: COMMENTED (skipped: diff below evidence threshold of N lines, no sensitive paths touched)\n385: ```\n386: If sensitive paths ARE touched, the full review runs regardless of line count.\n387: \n388: **Gate is ALWAYS opt-in.** Without `SK_CODE_REVIEW_MIN_CHANGED_LINES` set, M-2 has zero effect: all diffs receive full reviews.\n389: \n390: ### 8.3 SK_CODE_REVIEW_DEPTH (opt-in depth alias)\n391: \n392: `SK_CODE_REVIEW_DEPTH=lite|full|ultra` is an optional environment variable the **reviewing agent honors** (resolved env > default), exactly like the §8.2 `SK_CODE_REVIEW_MIN_CHANGED_LINES` gate.\n393: Both are skill guidance the reviewer reads and applies in-loop, not a separate compiled dispatcher; this alias only NAMES and PERSISTS an already-existing routing behavior, adds no new tier, and relaxes no floor:\n394: \n395: - `full` (default / unset): the normal ALWAYS + CONDITIONAL + ON_DEMAND routing ([`ROUTER.md`](./ROUTER.md) §3).\n396: - `ultra`: bias intent selection toward the existing `ON_DEMAND` reference set (the deep-dive tier in [`ROUTER.md`](./ROUTER.md) §3) for the session, so a reviewer does not have to repeat \"comprehensive / full review\" each time.\n397: - `lite`: maps to the existing M-2 conservative skip (§8.2). It NEVER lowers the ALWAYS tier, the baseline security/correctness minimums, or the P0/P1/P2 contract. It cannot skip a review on a sensitive path (auth/config/persistence/deps/sandbox/public-response), exactly as M-2 already enforces.\n398: \n399: The depth alias is advisory routing only; it must never be read as permission to relax a floor.\n400: \n401: ---\n402: \n403: ## 9. RELATED RESOURCES\n404: \n405: Start with `references/quick-reference.md`, then load task-specific doctrine, assets, or scripts.\n406: \n407: ### Manual Testing Playbook\n408: \n409: Manual testing scenarios for the `sk-code-review` mode (of the sk-code family) live in `manual-testing-playbook/manual-testing-playbook.md`, the root index, plus per-feature sub-files under `manual-testing-playbook/<topic>/<scenario>.md`.\n410: Both the category folder and the scenario file use bare descriptive slugs, with no numeric prefix.\n411: \n412: Validate the root index with the sk-doc document validator in playbook mode:\n413: `validate_document.py --type playbook manual-testing-playbook/manual-testing-playbook.md`.\n414: The playbook path is relative to this packet, and the validator path is wherever sk-doc is installed.\n415: Playbook mode applies the playbook rule set.\n416: \n417: Execute scenarios in Claude Code or OpenCode sessions for behavioral verification.\n418: \n419: ---\n420: \n421: Related skills: `sk-doc` for skill authoring and packaging standards, `sk-code` for surface-aware standards, and `system-spec-kit` for packet-governed review workflows.","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file .skilled/skills/sk-code/sk-code-review/SKILL.md, lines 1-421\n1: ---\n2: name: sk-code-review\n3: description: \"Stack-agnostic code-review for sk-code: findings-first severity, security/correctness minimums, and surface evidence.\"\n4: allowed-tools: [Read, Bash, Grep, Glob, Write]\n5: version: 1.9.16.0\n6: metadata:\n7:   family: sk-code\n8: ---\n9: \n10: # sk-code-review Mode - Stack-Agnostic Findings-First Review\n11: \n12: Universal findings-first review baseline paired with `sk-code` surface standards evidence for the detected code surface.\n13: \n14: ## 1. WHEN TO USE\n15: \n16: ### Activation Triggers\n17: \n18: Use the `sk-code-review` mode (of the sk-code family) when:\n19: - A user asks for code review, PR review, or merge readiness.\n20: - A workflow dispatches `@review` for pre-commit or gate validation.\n21: - A user requests security/correctness risk analysis before merge.\n22: - A user wants severity-ranked findings with file:line evidence.\n23: \n24: ### Keyword Triggers\n25: \n26: `review`, `code review`, `pr review`, `audit`, `security review`, `request changes`, `findings`, `blocking issues`, `merge readiness`\n27: \n28: ### Use Cases\n29: \n30: 1. Review-only pass: findings-first output with no code edits.\n31: 2. Gate validation: a pass or fail that follows severity for orchestrated workflows, with any score advisory only.\n32: 3. Focused risk pass: security, concurrency, correctness, or removal-focused review.\n33: \n34: ### When NOT to Use\n35: \n36: - Feature implementation without review intent; load the surface packet (`sk-code-skilled`) that carries the implement doctrine.\n37: - Pure documentation editing where code behavior is not being assessed.\n38: - Git-only workflow tasks (branching, rebasing, commit hygiene) without code quality evaluation intent.\n39: - Applying review fixes after findings are accepted; load the surface packet (`sk-code-skilled`) that carries the implement doctrine.\n40: - Author-side quality gates before review; use `sk-code-quality`.\n41: - Root-cause debugging; use the surface's `workflow-debug.md` doctrine.\n42: - Verification evidence collection; use the surface's `workflow-verify.md` doctrine.\n43: \n44: ---\n45: \n46: ## 2. SMART ROUTING\n47: \n48: The hub bundles this mode for a code review, a pull-request review, merge readiness or a security and correctness pass over a diff.\n49: Its vocabulary is `review`, `code review`, `pr review`, `audit`, `security review`, `request changes`, `findings`, `blocking issues` and `merge readiness`.\n50: The first resource it loads is `references/review-core.md`, the doctrine both `@review` and `@deep-review` read.\n51: \n52: Review keeps no detection of its own.\n53: The quality runner's explain entry is the one resolver, and it applies the shared detection contract, [`stack-detection.md`](../shared/references/stack-detection.md) section 2.\n54: A surface the hub's router bundles from request words is only a candidate: it applies to the files the resolver places in it.\n55: \n56: The rule-override algorithm it hands to the review lives in [`review-core.md`](./references/review-core.md) section 9.\n57: Read [`ROUTER.md`](./ROUTER.md) before selecting skill-local resources; open only the matched files.\n58: \n59: ---\n60: \n61: ## 3. HOW IT WORKS\n62: \n63: ### Phase 1: Scope and Baseline\n64: \n65: 1. Check the two efficiency gates in section 8 before scoping anything: M-1 skips a review whose pull request is unchanged since the last one, and M-2 skips a diff below its opt-in evidence threshold unless it touches a sensitive path. A skip ends the review there, with the status line alone.\n66: 2. Inspect the review target (`git diff`, staged diff, file list, or commit range).\n67: 3. Load baseline standards from the `sk-code-review` mode (of the sk-code family).\n68: 4. Resolve the rule sources for the reviewed files in one call, from the reviewed repository's root, where `<hub>` is the sk-code folder this mode was loaded from (`.skilled/skills/sk-code` in the repository that ships it):\n69: \n70:    ```bash\n71:    git diff --name-only --diff-filter=d <range>   # the reviewed paths that still exist\n72:    node <hub>/sk-code-quality/scripts/quality-gate.cjs --explain <file> [<file>...]\n73:    ```\n74: \n75:    Pass only paths that exist as regular files. One deleted or missing path makes the runner stop the whole call with `FILE_NOT_FOUND`, exit 3, which would drop every surface and override for the files that do exist.\n76: \n77:    - For a diff, `--diff-filter=d` leaves the deleted paths out.\n78:    - For a file list, drop any path that is not a regular file.\n79:    - List a deleted path on the `Not checked:` line when its removal matters to the review, such as a deleted test or a removed caller.\n80: \n81:    It prints one `code-quality-explain/v1` JSON document and always exits 2, because it runs nothing. Read each `files[]` entry's `surfaces`, `surface_skills` (the folder each surface loads from), `checklists` (each with its `source`, `sources` and parsed `overrides`) and the document's `config.hygiene.disabled`.\n82: \n83:    Exit 3 on that filtered list is a usage or root fault: name it on the `Not checked:` line and review those files against the baseline only. [`runner-contract.md`](../sk-code-quality/references/runner-contract.md) section 3 owns the fields.\n84: 5. Load `sk-code` surface standards evidence for the surfaces the resolver returned. A surface the hub's router bundled from request words is a candidate, and it applies only to the files the resolver places in it: the file's `surfaces` holds its label, or one of its checklists applies to the file. A candidate that holds no reviewed file is not loaded and not named in `Surface evidence used`.\n85: 6. With no file paths to review, nothing is resolved. The bundle keeps `sk-code-skilled` only when the working directory is inside the hub's own checkout, the same git common dir as the hub folder. Anywhere else it drops `sk-code-skilled`, because a word such as \"typescript\" says nothing about whose code it is.\n86: 7. Read the connected code: the callers of each changed function, the functions each changed function calls, the tests that cover it, and the README or docs that describe it. Anything you could not read goes on the `Not checked:` line.\n87: \n88: ### Phase 2: Surface Alignment\n89: \n90: 1. Load standards from `sk-code` for the resolved surfaces only, each for the files the resolver placed in it.\n91: 2. Apply precedence matrix:\n92:    - Baseline security/correctness minimums and the rest of the floor always apply.\n93:    - Apply the `## Rule overrides` rows of the checklists the resolver returned. Use the precedence and outcomes of [`review-core.md`](./references/review-core.md) section 8: the repository checklist, then a specific surface, then the SKILLED fallback, then the default lens.\n94:      A checklist whose `overrides.refused` is true contributes no row. A hygiene rule in `config.hygiene.disabled` counts as a `none` row from the repository config.\n95:    - Surface style/process/verification conventions win on conflicts.\n96: 3. If precedence cannot be resolved deterministically, escalate before scoring. Two rows at the same level that disagree apply the default, go under `Conflicts` and are named in Next Steps.\n97: \n98: ### Phase 3: Findings-First Analysis\n99: \n100: 1. Analyze for security and correctness first.\n101: 2. Analyze quality/performance, test adequacy, contract safety, and architecture concerns.\n102: 3. Analyze KISS/DRY and SOLID violations (SRP/OCP/LSP/ISP/DIP) with evidence.\n103: 4. Analyze removal opportunities with safe-now vs deferred classification.\n104: 5. Produce findings ordered by severity (`P0`, `P1`, `P2`), numbered once across all three groups so the first `P1` finding continues after the last `P0` finding. A finding with no case is not reported.\n105: 6. For every actionable finding, classify fix scope as `instance-only`, `class-of-bug`, `cross-consumer`, `algorithmic`, `matrix/evidence`, or `test-isolation`. If unknown, default to class/cross-consumer until a producer/consumer inventory proves instance-only.\n106: \n107: #### Reach Calibration\n108: \n109: A `P0` or `P1` finding names its reach in its `Case:` line: an input or call path that the code's stated contract allows, or a real caller that sends it.\n110: A failure that needs input outside that contract, such as `NaN` where the contract says a number, a wrong type, or an inverted range the code already rejects, is `P2` hardening, unless the code claims to validate that input.\n111: Data that crosses a trust boundary is always in reach.\n112: The low-confidence escalation rule raises a finding only when its reach is named.\n113: The full rule is [`review-core.md`](./references/review-core.md) section 2.\n114: \n115: #### Numeric Severity Calibration\n116: \n117: Use numeric calibration only as reviewer context, never as the gate.\n118: A finding may include an optional advisory `riskScore` to communicate relative risk, and reviewers may adjust that score by `+/-2` for local context such as exploitability, blast radius, user impact, confidence, or proven containment.\n119: The blocking decision still comes only from the `P0`/`P1`/`P2` severity contract.\n120: Do not introduce `score>=4` or any other numeric threshold as a blocker.\n121: \n122: #### Instance-Only Opt-Out\n123: \n124: A finding may use the narrow fix path only when all are true:\n125: \n126: - It is not P0/P1 security, path, auth/authz, sandboxing, env precedence, schema, persistence, or public-response behavior.\n127: - `rg` proves no same-class producer or consumer.\n128: - Verification is local and cheap: one focused test, one doc row, or one static audit command.\n129: - The fix response includes the exact command evidence for the opt-out.\n130: \n131: Otherwise, run the full fix completeness checklist.\n132: \n133: ### Phase 4: Output and Next Action\n134: \n135: Required output contract:\n136: \n137: ```markdown\n138: ## Code Review Summary\n139: \n140: **Files reviewed**: X files, Y lines changed\n141: **Overall assessment**: [APPROVED / REQUESTED_CHANGES / COMMENTED]\n142: **Baseline used**: [sk-code (`sk-code-review`)]\n143: **Surface evidence used**: [resolved surface labels in order, such as `<specific surface>, SKILLED` or `SKILLED` | UNKNOWN]\n144: **Quality gate evidence**: [present | absent]\n145: Rule sources: [checklist files]. Overrides: [rule id none|replace from checklist file, or none]. Refused: [checklist files, or none]. Ignored: [rule id from checklist file, or none]. Conflicts: [rule id and both checklist files, or none]\n146: \n147: ## Findings\n148: \n149: ### P0 - Critical\n150: 1. [path:line] Title\n151:    - Case: [the input or situation that produces the wrong result. A finding with no case is not reported]\n152:    - Risk (for a performance finding, name the workload it assumes, such as row count, request rate or payload size)\n153:    - User impact: what users or callers bear if this fix is deferred\n154:    - Finding class: [instance-only | class-of-bug | cross-consumer | algorithmic | matrix/evidence | test-isolation]\n155:    - Scope proof: [grep/test evidence proving class coverage or instance-only status]\n156:    - affectedSurfaceHints: [optional string array of short producer/consumer surface names; recommended for actionable findings, required for cross-consumer findings]\n157:    - riskScore: [optional advisory number only; never gating]\n158:    - Recommended fix\n159: \n160: ### P1 - High\n161: 2. [path:line] Title\n162:    ...\n163: \n164: ## Removal/Iteration Plan\n165: \n166: ## Next Steps\n167: \n168: Not checked: [one line naming what mattered but could not be checked, and why, or \"nothing material\"]\n169: ```\n170: \n171: The `Rule sources:` line is defined in [`review-core.md`](./references/review-core.md) section 8: the checklists the review read, then each override outcome group, with `none` for an empty group and `Rule sources: none` when no file was resolved.\n172: It never starts with `Review status:` or `Not checked:`, so the final-line checks read the rest of the report as before, and `scripts/check-review-final-line.js` checks the line's own format when it is present.\n173: \n174: `Quality gate evidence` reads `present` when a `sk-code-quality` run verdict was handed to the review as input, and `absent` otherwise. Either value leaves every baseline check in place. The verdict is input evidence only, so no check is skipped because the gate already ran it, and no gate count renumbers a finding.\n175: \n176: The `Overall assessment` value names the same status as the final `Review status:` line, and so does a `Recommendation` line, such as the one the review agent's PR shape carries.\n177: `scripts/check-review-final-line.js` fails a report whose values disagree, and `scripts/check-review-findings.js` fails a `Recommendation` or a final status that approves or comments over a P0 or P1 finding, or requests changes with none.\n178: \n179: After reporting findings, request explicit next action before any implementation follow-up.\n180: \n181: ### Final-line exact-string contract (MANDATORY)\n182: \n183: Every review MUST end with exactly one of the following plain-text lines as the **absolute final line** of the output (no trailing whitespace, no variation):\n184: \n185: ```\n186: Review status: APPROVED\n187: ```\n188: \n189: ```\n190: Review status: REQUESTED_CHANGES\n191: ```\n192: \n193: ```\n194: Review status: COMMENTED\n195: ```\n196: \n197: Directly above the status line, separated from it by one blank line, every full review carries one `Not checked:` line naming what mattered but could not be checked and why, or `Not checked: nothing material`.\n198: An optional `AGENT_IO_RESULT` block, when requested, goes above the `Not checked:` line and never below the status line.\n199: The M-1 and M-2 skip outputs (§8) are the status line alone and carry no `Not checked:` line.\n200: \n201: **Example output bottom:**\n202: \n203: ```\n204: ...\n205: ## Next Steps\n206: 1. Fix the null-deref at src/foo.ts:42\n207: 2. Add input validation for the `/api/bar` endpoint\n208: \n209: Not checked: behavior under concurrent writes to /api/bar; no test database was available\n210: \n211: Review status: REQUESTED_CHANGES\n212: ```\n213: \n214: Downstream automation parses this final line via exact string match.\n215: Do not vary the format, add trailing punctuation, or wrap in Markdown formatting.\n216: The sole exception is the documented M-1 / M-2 skip output (§8): those lines begin with the exact `Review status: COMMENTED` and append a parenthetical reason, so a leading-verdict (grep / `startsWith`) parse still yields `COMMENTED`.\n217: A normal review must still end with one of the three exact lines above.\n218: \n219: ---\n220: \n221: ## 4. RULES\n222: \n223: ### ✅ ALWAYS\n224: \n225: - Keep findings first; summaries follow findings.\n226: - Enforce baseline security/correctness minimums regardless of surface.\n227: - Include file:line evidence for actionable findings.\n228: - State assumptions when evidence is incomplete.\n229: - Identify `sk-code` surface evidence used for standards alignment.\n230: - Read each file's surfaces, checklists and overrides from the quality runner's `--explain` resolver, never from a detection of your own.\n231: - State the applied overrides on the one `Rule sources:` line, `none` included.\n232: \n233: ### ⛔ NEVER\n234: \n235: - Override surface-specific conventions with generic baseline style preferences.\n236: - Approve code with unaddressed P0 security/correctness defects.\n237: - Produce vague findings without concrete evidence.\n238: - Mix unrelated cleanup into targeted fix recommendations.\n239: - Let an override row drop or reword a floor rule, or apply a row from a checklist the resolver did not return.\n240: - Implement fixes during review. Report findings only; implementation is a separate follow-up step.\n241: \n242: ### ⚠️ ESCALATE IF\n243: \n244: - Surface detection is ambiguous and affects standards or verification commands.\n245: - Baseline and surface guidance conflict in a non-deterministic way.\n246: - Two override rows at the same precedence level disagree on one rule for one file.\n247: - Large diff size prevents reliable severity assignment without narrowed scope.\n248: - Requested remediation exceeds review scope and becomes architecture redesign.\n249: \n250: ### Extension Floors\n251: \n252: A repository, a surface packet or a mode a user adds to the hub may raise these floors or add checks beside them. None of them may lower, skip or reword one. `scripts/check-rule-copies.js` pins each line below, so a reword fails the canary.\n253: \n254: - Baseline security and correctness minimums apply to every review, and surface guidance never relaxes them.\n255: - No review is approved while a P0 finding is unaddressed.\n256: - P0 blocks merge, P1 must be fixed before merge, and P2 is advisory and never blocks.\n257: - A dispatcher adds the `CODE-REVIEW` marker line as the first line of the rendered review prompt.\n258: - Every review ends on exactly one of the three status lines in section 3.\n259: - The mode writes only its PR-state cache file in the reviewing user's cache directory, never into the reviewed repository.\n260: \n261: ---\n262: \n263: ## 5. REFERENCES\n264: \n265: ### Core References\n266: \n267: - [review-core.md](./references/review-core.md) - Shared review doctrine: severity model, evidence rules, precedence, finding schema, and the floor, default lens and `Rule sources:` line.\n268: - [rule-overrides.md](../shared/references/universal/rule-overrides.md) - The shared `## Rule overrides` format, rule ids, hard floor and precedence that review and quality both read.\n269: - [review-ux-single-pass.md](./references/review-ux-single-pass.md) - Interactive single-pass review flow, presentation modes, and PR/pre-commit behavior.\n270: - [quick-reference.md](./references/quick-reference.md) - Lightweight index for routing between shared doctrine and single-pass UX guidance.\n271: - [pr-state-dedup.md](./references/pr-state-dedup.md) - Content-hash deduplication for unchanged pull-request reviews.\n272: - [security-checklist.md](./assets/security-checklist.md) - Mandatory security and reliability checks.\n273: - [code-quality-checklist.md](./assets/code-quality-checklist.md) - Correctness, performance, KISS, and DRY checks.\n274: - [solid-checklist.md](./assets/solid-checklist.md) - SOLID (SRP/OCP/LSP/ISP/DIP) and architecture assessment prompts.\n275: - [removal-plan.md](./assets/removal-plan.md) - Safe-now vs deferred removal planning template.\n276: - [test-quality-checklist.md](./assets/test-quality-checklist.md) - Test quality, coverage, and anti-pattern detection.\n277: - [fix-completeness-checklist.md](./assets/fix-completeness-checklist.md) - Finding classes and the producer and consumer inventories a complete fix covers.\n278: \n279: ### Reference Loading Notes\n280: \n281: - Load only the references needed for the selected intents.\n282: - Routing authority: the hub's `SKILL.md` section 2 names `hub-router.json` as the mode vocabulary and `ROUTER.md` as the leaf-set router. This packet's `INTENT_SIGNALS`, `RESOURCE_MAP` and `DEFAULT_RESOURCES` live in its [`ROUTER.md`](./ROUTER.md) section 3.\n283: \n284: ---\n285: \n286: ## 6. SUCCESS CRITERIA\n287: \n288: - Review output is findings-first and severity-ordered.\n289: - `sk-code-review` mode baseline + `sk-code` surface evidence contract is explicit in report context.\n290: - Security/correctness minimums are always covered.\n291: - Recommended fixes are actionable and scope-proportional.\n292: \n293: ---\n294: \n295: ## 7. INTEGRATION POINTS\n296: \n297: - Primary review baseline for the runtime's review agent (`@review`), wherever that runtime keeps its agent definitions.\n298: - Dispatched as `@review` by `@orchestrate`, which adds the `CODE-REVIEW` marker. The `/speckit:implement` and `/speckit:complete` workflows name `@review` as the agent for their review step and state the marker for a step that dispatches it. The `/create:*` workflows do not dispatch a review.\n299: - Complements, but does not replace, sibling ownership: the surface packets (`sk-code-skilled`) carry the implement → debug → verify workflow doctrine the acting agent applies to fix accepted findings, and `sk-code-quality` owns author-side gates.\n300: \n301: ### User-Authored Modes\n302: \n303: A repository can add its own mode to the sk-code hub, such as a security surface for its auth code. This is the review side of that mode.\n304: \n305: **What a security surface supplies.** It registers as a surface packet (`packetKind: \"surface\"`, `backendKind: \"evidence-base\"`) with its own `surfaceDetection` block, router vocabulary and a tie-break slot ahead of the fallback surface.\n306: It supplies read-only evidence: the standards and checklists to load, the markers that place a path inside it, and the verification commands for the code it owns.\n307: It never supplies a severity table, a status value or findings of its own.\n308: \n309: **What a consuming workflow may rely on.** When a request scores both this mode and the surface, the hub returns a surface bundle with this mode first and the surface after it.\n310: That bundled surface is a candidate: it applies to the files the quality runner's resolver places in it.\n311: The review then:\n312: \n313: - Names the surface's label in `Surface evidence used`.\n314: - Applies the surface's style, process and verification guidance under the precedence matrix in section 2.\n315: - Honors the `## Rule overrides` rows of the checklists its `quality` block declares at the specific-surface level.\n316: - Keeps its own `P0`/`P1`/`P2` findings, report shape and final status line.\n317: \n318: A caller parses the report the same way whichever surface was loaded.\n319: \n320: **What it may not change.** The Extension Floors in section 4 bind every user mode. A surface may add checks beside a floor and may raise one, and it may never lower, skip or reword one.\n321: \n322: The playbook scenario `CR-028` replays a user security surface through both routing stages.\n323: \n324: ---\n325: \n326: ## 8. PR-STATE EFFICIENCY GATES\n327: \n328: ### 8.1 M-1: PR-State Content-Hash Dedup\n329: \n330: Prevents redundant re-reviews when a PR has not changed since the last review.\n331: \n332: **Signature computation:**\n333: ```\n334: diff_content_hash = sha256(git diff <base-ref>...HEAD)\n335: signature         = sha256(commit_subject + \"\\u001f\" + diff_content_hash)\n336: ```\n337: Where `commit_subject` is the first line of `git log <base-ref>...HEAD --format=%s` (latest commit subject).\n338: \n339: **Cache storage:**\n340: - Path: `${XDG_CACHE_HOME:-$HOME/.cache}/sk-code-review/<repo-ref>.jsonl`, in the reviewing user's cache directory. The gate never writes into the reviewed repository. Its one side effect is this file, and deleting it resets the gate.\n341: - `<repo-ref>` is computed as `sha256(<repo identity>).slice(0, 12)`, where `<repo identity>` is `git remote get-url origin`. A repository with no `origin` remote falls back to `git rev-parse --show-toplevel`, the repository root path, so a local-only repository still gets a stable key. A moved folder changes that key, and the worst case is one cache miss and a full review.\n342: - An optional pathspec scopes the gate to one monorepo package. The same pathspec goes to the `git diff` and `git log` calls above, and `<repo-ref>` becomes `sha256(<repo identity> + \"\\u001f\" + <pathspec>).slice(0, 12)`, so each package keeps its own signature and cache file.\n343:   With no pathspec the whole repository is one scope. [references/pr-state-dedup.md](./references/pr-state-dedup.md) holds the commands.\n344: - Each line is a JSON object: `{\"signature\": \"<sha256-hex>\", \"timestamp\": \"<ISO-8601>\", \"prev_sha\": \"<commit-sha>\"}`\n345: - Retention: keep last **100 entries** per repo-ref, prune older entries on write\n346: \n347: **Skip behavior:**\n348: When the current signature matches a prior cache entry, the review emits:\n349: ```\n350: Review status: COMMENTED (no changes since last review at <prev_sha>)\n351: ```\n352: No full review analysis runs. Automation may treat `COMMENTED` as a pass (no new findings).\n353: \n354: **Cache write:** After each full review completes, write the current signature + timestamp + HEAD SHA to the cache file.\n355: \n356: ### 8.2 M-2: Opt-In Minimum Evidence Gate\n357: \n358: Skips full review for trivially small diffs to save compute, with a conservative taxonomy that **never skips** high-risk changes.\n359: \n360: **Enable gate:**\n361: ```bash\n362: export SK_CODE_REVIEW_MIN_CHANGED_LINES=50  # >0 enables; default 0 = disabled\n363: ```\n364: \n365: **Changed-line counting command:**\n366: ```bash\n367: git diff --numstat <base-ref>...HEAD | awk '{added+=$1; removed+=$2} END {print added+removed}'\n368: ```\n369: \n370: **Conservative skip taxonomy. NEVER skip when diff touches:**\n371: \n372: | Risk Class | Path/File Patterns | Rationale |\n373: |---|---|---|\n374: | Security / Authentication / Authorization | `auth*`, `*-auth-*`, `*permission*`, `*credential*`, `*token*`, `*secret*`, `*oauth*`, `*sso*`, `*login*`, `*session*` | Compromised auth defeats everything |\n375: | Config files | `*.config.*`, `*config*.json`, `*config*.yaml`, `*config*.toml`, `*.env*`, `*.ini`, `*.cfg` | One-line config change can break production |\n376: | Persistence | `*.sql`, `*migration*`, `*schema*`, `*db*.ts`, `*repository*`, paths under `/db/` or `/migrations/` | Schema changes risk data loss |\n377: | Dependency manifests | `package.json`, `package-lock.json`, `Cargo.toml`, `Cargo.lock`, `pyproject.toml`, `poetry.lock`, `requirements.txt`, `*.lock`, `Gemfile`, `Gemfile.lock` | Transitive dependency changes are high-risk |\n378: | Sandboxing / Subprocess | `*sandbox*`, `*subprocess*`, `*exec*`, `*spawn*`, `*eval*` | Arbitrary code execution boundaries |\n379: | Public-facing responses | `*.handler.ts`, `*-api*`, `*-route*`, `*-controller*`, paths under `/handlers/`, `/routes/`, `/api/` | User-visible behavior changes |\n380: \n381: **Skip behavior:**\n382: When `SK_CODE_REVIEW_MIN_CHANGED_LINES > 0`, total changed lines < threshold, AND no sensitive paths are touched:\n383: ```\n384: Review status: COMMENTED (skipped: diff below evidence threshold of N lines, no sensitive paths touched)\n385: ```\n386: If sensitive paths ARE touched, the full review runs regardless of line count.\n387: \n388: **Gate is ALWAYS opt-in.** Without `SK_CODE_REVIEW_MIN_CHANGED_LINES` set, M-2 has zero effect: all diffs receive full reviews.\n389: \n390: ### 8.3 SK_CODE_REVIEW_DEPTH (opt-in depth alias)\n391: \n392: `SK_CODE_REVIEW_DEPTH=lite|full|ultra` is an optional environment variable the **reviewing agent honors** (resolved env > default), exactly like the §8.2 `SK_CODE_REVIEW_MIN_CHANGED_LINES` gate.\n393: Both are skill guidance the reviewer reads and applies in-loop, not a separate compiled dispatcher; this alias only NAMES and PERSISTS an already-existing routing behavior, adds no new tier, and relaxes no floor:\n394: \n395: - `full` (default / unset): the normal ALWAYS + CONDITIONAL + ON_DEMAND routing ([`ROUTER.md`](./ROUTER.md) §3).\n396: - `ultra`: bias intent selection toward the existing `ON_DEMAND` reference set (the deep-dive tier in [`ROUTER.md`](./ROUTER.md) §3) for the session, so a reviewer does not have to repeat \"comprehensive / full review\" each time.\n397: - `lite`: maps to the existing M-2 conservative skip (§8.2). It NEVER lowers the ALWAYS tier, the baseline security/correctness minimums, or the P0/P1/P2 contract. It cannot skip a review on a sensitive path (auth/config/persistence/deps/sandbox/public-response), exactly as M-2 already enforces.\n398: \n399: The depth alias is advisory routing only; it must never be read as permission to relax a floor.\n400: \n401: ---\n402: \n403: ## 9. RELATED RESOURCES\n404: \n405: Start with `references/quick-reference.md`, then load task-specific doctrine, assets, or scripts.\n406: \n407: ### Manual Testing Playbook\n408: \n409: Manual testing scenarios for the `sk-code-review` mode (of the sk-code family) live in `manual-testing-playbook/manual-testing-playbook.md`, the root index, plus per-feature sub-files under `manual-testing-playbook/<topic>/<scenario>.md`.\n410: Both the category folder and the scenario file use bare descriptive slugs, with no numeric prefix.\n411: \n412: Validate the root index with the sk-doc document validator in playbook mode:\n413: `validate_document.py --type playbook manual-testing-playbook/manual-testing-playbook.md`.\n414: The playbook path is relative to this packet, and the validator path is wherever sk-doc is installed.\n415: Playbook mode applies the playbook rule set.\n416: \n417: Execute scenarios in Claude Code or OpenCode sessions for behavioral verification.\n418: \n419: ---\n420: \n421: Related skills: `sk-doc` for skill authoring and packaging standards, `sk-code` for surface-aware standards, and `system-spec-kit` for packet-governed review workflows."}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\".skilled/skills/sk-code/sk-code-review/SKILL.md\"}"},"time":{"start":1794669384500,"end":1794669385037}}}}
{"type":"step_finish","timestamp":1794669386613,"sessionID":"ses_e255ff46effe7EWyuOLOEwVdy1","part":{"id":"prt_1daa19b750019KDfM3Q1jllBGK","sessionID":"ses_e255ff46effe7EWyuOLOEwVdy1","messageID":"msg_1daa10c04001S1AjiKlmp6djLY","type":"step-finish","reason":"tool-calls","snapshot":"7421c6d895d96117ddd82deabfeace429e22018d","cost":0,"tokens":{"input":15671,"output":126,"reasoning":985,"cache":{"read":67200,"write":0}}}}
{"type":"step_start","timestamp":1794669390650,"sessionID":"ses_e255ff46effe7EWyuOLOEwVdy1","part":{"id":"prt_1daa1ab3a001Sh15n5xt1PFrTN","sessionID":"ses_e255ff46effe7EWyuOLOEwVdy1","messageID":"msg_1daa19b7a001ITH2mApLlWkbkI","type":"step-start","snapshot":"7421c6d895d96117ddd82deabfeace429e22018d"}}
{"type":"tool_use","timestamp":1794669394564,"sessionID":"ses_e255ff46effe7EWyuOLOEwVdy1","part":{"partID":"prt_1daa1b70b0014AaniBbfXqpicc","sessionID":"ses_e255ff46effe7EWyuOLOEwVdy1","messageID":"msg_1daa19b7a001ITH2mApLlWkbkI","type":"tool","id":"call_d243e76ce0a2483c814264ca","tool":"read","state":{"status":"completed","input":{"path":".skilled/skills/sk-code/sk-code-review/references/review-core.md"},"output":"Read file .skilled/skills/sk-code/sk-code-review/references/review-core.md, lines 1-423\n1: ---\n2: title: Review Core Doctrine\n3: description: Shared findings-first review doctrine for both single-pass and deep-review workflows.\n4: trigger_phrases:\n5:   - \"findings first severity ordering\"\n6:   - \"review finding schema\"\n7:   - \"severity contract for merge decisions\"\n8:   - \"evidence file line citation\"\n9:   - \"baseline surface precedence\"\n10:   - \"baseline check families\"\n11: importance_tier: important\n12: contextType: implementation\n13: version: 1.5.9.0\n14: ---\n15: \n16: # Review Core Doctrine\n17: \n18: Shared doctrine consumed by both `@review` and `@deep-review`.\n19: \n20: **Ownership.** This file owns the severity ids and their meanings (section 2), the evidence rules (section 3) and the finding schema (section 7). The deep-review contract, [`review-mode-contract.yaml`](../../../system-deep-loop/deep-review/assets/review-mode-contract.yaml), is an external consumer: it owns the deep-review loop (dimensions, verdicts, severity weights, convergence and quality gates) and reuses the severity ids defined here. When the two disagree on a severity id or its meaning, this file wins and the YAML is corrected by its owner, `deep-review`. The YAML may be stricter for its own loop, as when it requires `file:line` evidence on `P2`, but never looser.\n21: \n22: ---\n23: \n24: ## 1. OVERVIEW\n25: \n26: ### Purpose\n27: \n28: Shared findings-first review doctrine for both single-pass and deep-review workflows.\n29: \n30: ### When to Use\n31: \n32: - A `@review` or `@deep-review` pass that needs the severity contract, the evidence rules or the finding schema.\n33: - A review that must state its `Rule sources:` line, or apply a repository or surface override to a default-lens rule.\n34: \n35: Every rule in sections 2 to 7 is review floor, the part no repository or surface can change. Section 8 names the floor ids, the default lens that a repository may drop or replace, and how the review reads and reports those overrides.\n36: \n37: ---\n38: \n39: ## 2. SEVERITY DEFINITIONS\n40: \n41: | Level | Meaning | Handling |\n42: | --- | --- | --- |\n43: | P0 | Blocker: exploitable security issue, auth bypass, destructive data loss | Block merge |\n44: | P1 | Required: correctness bug, spec mismatch, must-fix gate issue | Fix before merge |\n45: | P2 | Suggestion: non-blocking improvement, documentation polish, style or maintainability follow-up | Optional or schedule follow-up |\n46: \n47: ### Reach Calibration\n48: \n49: A `P0` or `P1` finding names its reach: an input or call path that the code's stated contract allows, or a real caller that sends the failing input. The stated contract is what the code promises through its signature, types, doc comment, name and the checks it already makes.\n50: \n51: - A failure that needs input outside the stated contract, such as `NaN` where the contract says a number, a wrong type, or an inverted range the code already rejects, is `P2` hardening.\n52: - The exception is input the code claims to validate. When a guard, a thrown error or a doc line promises to reject an input class and the promise fails for an input in that class, the gap is a correctness finding and keeps `P1` or higher. A guard claims only the class it checks: an ordering check such as `min > max` does not claim that its operands are numbers.\n53: - At a trust boundary (user input, network, files, environment, another service), every value the outside can send is in reach. The stated contract of internal code never narrows a security finding on data that crosses that boundary.\n54: - A finding that cannot name its reach is `P2`, however severe the failure would be.\n55: \n56: Escalation rule: if confidence is low but impact is high, classify toward the higher severity and state the uncertainty explicitly. The confidence is confidence that the reach exists. The rule raises a finding whose reach is named but not proven, such as a caller that probably sends the input. It never raises a finding with no reach, so it cannot lift an out-of-contract failure above `P2`.\n57: \n58: ### Numeric Severity Calibration\n59: \n60: Numeric scores are advisory context, not the gate. A reviewer may add an optional `riskScore` to a finding and adjust it by `+/-2` for local context such as exploitability, blast radius, user impact, confidence, or proven containment. The merge/block decision remains the severity contract above: `P0` blocks, `P1` requires remediation, and `P2` is advisory. Do not adopt `score>=4` or any numeric threshold as a blocker.\n61: \n62: ---\n63: \n64: ## 3. EVIDENCE REQUIREMENTS\n65: \n66: - Every `P0` and `P1` finding must include a concrete `file:line` citation.\n67: - Evidence must tie the finding to observed code behavior, not just a general concern.\n68: - `P2` findings should still include specific evidence when available, even if impact is advisory.\n69: - If evidence is incomplete, state the assumption and why the risk still matters.\n70: \n71: ---\n72: \n73: ## 4. FINDINGS OUTPUT ORDERING\n74: \n75: - Present findings before summary or praise sections.\n76: - Order findings by severity first: `P0`, then `P1`, then `P2`.\n77: - Keep ordering stable within a severity bucket by impact and confidence.\n78: - Separate required fixes from optional suggestions so merge decisions stay clear.\n79: \n80: ---\n81: \n82: ## 5. BASELINE + SURFACE PRECEDENCE\n83: \n84: Apply this skill as the baseline first, then pair it with `sk-code` surface evidence when available:\n85: \n86: - Detected code surfaces -> the surfaces the quality runner's resolver places each reviewed file in, specific surfaces first and the `SKILLED` fallback last. Each one pairs with its `sk-code` evidence packet, such as `sk-code-skilled` for `SKILLED`. No match -> `UNKNOWN`. The resolver applies the shared detection contract, [`stack-detection.md`](../../shared/references/stack-detection.md) section 2, so the review keeps no detection of its own. Section 8 describes what it returns.\n87: - Unclear surfaces -> baseline-only plus explicit uncertainty\n88: \n89: Precedence rules:\n90: \n91: - Baseline security and correctness minimums are always enforced.\n92: - Surface style, process, build, and test conventions override generic baseline guidance.\n93: - A repository or surface changes one default-lens rule only through a `## Rule overrides` row, by the precedence in section 8.\n94: - Unclear conflicts must be escalated rather than guessed.\n95: \n96: ---\n97: \n98: ## 6. BASELINE CHECK FAMILIES\n99: \n100: Mandatory baseline families:\n101: \n102: - Correctness minimums: regression risk, contract safety, spec mismatch, destructive side effects, and boundary handling.\n103: - Security minimums: auth and authorization gaps, injection exposure, unsafe secrets handling, privilege misuse, and reliability risks with security impact.\n104: \n105: These minimums cannot be relaxed by surface guidance.\n106: \n107: ---\n108: \n109: ## 7. FINDING SCHEMA\n110: \n111: Each finding should provide:\n112: \n113: | Field | Requirement |\n114: | --- | --- |\n115: | `id` | The finding's number in the Findings list, counted once across severity groups, such as `2` |\n116: | `severity` | One of `P0`, `P1`, `P2` |\n117: | `title` | Short, risk-oriented summary |\n118: | `case` | The input or situation that produces the wrong result. A finding with no case is not reported |\n119: | `file` | Primary `path:line` location |\n120: | `evidence` | Plain-language explanation tied to observed code; for a performance finding, name the workload it assumes, such as row count, request rate or payload size |\n121: | `userImpact` | What users or callers bear if this fix is deferred |\n122: | `findingClass` | One of `instance-only`, `class-of-bug`, `cross-consumer`, `algorithmic`, `matrix/evidence`, or `test-isolation` |\n123: | `scopeProof` | Grep/test/audit evidence that the recommendation covers same-class sites and consumers, or proves the finding is instance-only |\n124: | `affectedSurfaceHints` | Optional string array of producer/consumer surfaces the fix should address; recommended for actionable findings, required for cross-consumer findings. Use free-form short strings, max about 5 entries. Optional for instance-only findings. |\n125: | `riskScore` | Optional advisory number for relative risk calibration; never gating and never a substitute for `severity` |\n126: | `recommendation` | Specific, scope-proportional fix or follow-up |\n127: \n128: Suggested shape:\n129: \n130: ```markdown\n131: ### 2 [P1] Missing authorization check\n132: - Case: a request with no session token reaches the write handler and changes a user record\n133: - File: path/to/file.ts:42\n134: - Evidence: Request handling reaches the write path before role validation.\n135: - User impact: Until this is fixed, any caller can write records without a role check.\n136: - Finding class: cross-consumer\n137: - Scope proof: `rg -n \"permission guard|write path\" path/to` shows the write handler is the only unchecked consumer.\n138: - Affected surface hints: [\"request handler\", \"write path\", \"permission guard\"]\n139: - riskScore: 6 (advisory only)\n140: - Recommendation: Enforce the existing permission guard before mutation.\n141: ```\n142: \n143: ---\n144: \n145: ## 8. FLOOR, DEFAULT LENS AND RULE OVERRIDES\n146: \n147: Review applies two kinds of rule.\n148: \n149: - **The floor** applies in every repository, and no source changes it.\n150: - **The default lens** is this mode's own view of maintainable code. It applies as written until a repository or a surface drops or replaces one of its rules through the shared [rule overrides contract](../../shared/references/universal/rule-overrides.md), which this section adopts for review.\n151: \n152: ### The Floor\n153: \n154: Sections 2 to 7 of this file are floor. The checklist sections the table names are floor too, and each one cites its id beside its heading.\n155: \n156: | Id | What it fixes | Where |\n157: | --- | --- | --- |\n158: | `review.severity` | The ids `P0`, `P1` and `P2` and what each one means | Section 2 |\n159: | `review.reach` | A `P0` or `P1` finding names an input or caller in reach | Section 2, Reach Calibration |\n160: | `review.security-minimums` | Auth and authorization gaps, injection exposure, unsafe secrets handling, privilege misuse and reliability risks with security impact | Sections 5 and 6. Security checklist sections 2 to 6 |\n161: | `review.correctness-minimums` | Regression risk, contract safety, spec mismatch, destructive side effects and boundary handling | Sections 5 and 6. Code quality checklist sections 2, 4 and 5. Security checklist sections 5 and 6. Test quality checklist sections 2 and 4, and the items that make a test unable to fail |\n162: \n163: A checklist item that enforces a rule of the universal standards, [`code-quality-standards.md`](../../shared/references/universal/code-quality-standards.md), carries that rule's `floor.*` id, never a `review.*` id. A `FIXED` id, such as `floor.silent-failures`, is floor here as it is in quality. An overridable one, such as `floor.error-messages`, applies as the standards ship it until a row changes it, for review exactly as for quality.\n164: \n165: An item in a lens section that is also an auth or authorization gap, injection exposure, unsafe secrets handling or privilege misuse is reported under `review.security-minimums`, so no row that drops the lens rule drops that finding.\n166: \n167: The fix completeness checklist and the removal plan are process guides for turning a finding into a fix. They carry no review rule, so no row reaches them.\n168: \n169: ### The Default Lens\n170: \n171: Each lens rule is a default that a repository may change. Its checklist item is worded as the default and names its id.\n172: \n173: | Id | Default rule | Checklist and section | Default severity |\n174: | --- | --- | --- | --- |\n175: | `review.performance` | No N+1 queries, unbatched per-item calls, uncached hot-loop work, blocking work on a request path or unbounded growth | Code quality, section 3 | P2. P1 when a named workload in reach fails |\n176: | `review.maintainability` | No repeated logic that behaves differently, hidden coupling through shared mutable state, or side effects the name does not imply | Code quality, section 6 | P2 |\n177: | `review.magic-literals` | A domain value is a named constant, not a bare literal | Code quality, section 6 | P2 |\n178: | `review.function-length` | A function stays at 20 lines or fewer unless its structure justifies more | Code quality, section 6 | P2 |\n179: | `review.nesting-depth` | Control flow nests fewer than 4 levels deep | Code quality, section 6 | P2 |\n180: | `review.law-of-demeter` | A call chain crosses at most two object boundaries | Code quality, section 6 | P2 |\n181: | `review.todo-tracking` | A TODO, FIXME or HACK on a production path says what is left and follows the repository's tracking convention | Code quality, section 6 | P2 |\n182: | `review.hardcoded-config` | Environment-specific values, such as URLs, ports and timeouts, are externalized | Code quality, section 6 | P2 |\n183: | `review.prefer-native` | No hand-rolled code or dependency where the language, runtime or platform already provides the behavior | Code quality, section 6 | P2 |\n184: | `review.kiss` | No abstraction, option or code path without a current requirement | Code quality, section 7 | P2. P1 when it adds attack surface, contract obligations or regression risk |\n185: | `review.dry` | No duplicated rules, copy-paste branches or repeated validation that should share one source | Code quality, section 7 | P2. P1 when the duplication carries behavior risk |\n186: | `review.rule-of-three` | Consolidate on the third instance of a shared concept, not the second | Code quality, section 7 | P2 |\n187: | `review.ceiling-marker` | A concrete `ceiling:` comment marks an intentional simplification and downgrades a KISS or YAGNI finding on it | Code quality, section 7 | Lowers a P2 only |\n188: | `review.solid` | The SOLID prompts and architecture smells | SOLID checklist, sections 2 to 4 | P2 |\n189: | `review.test-structure` | A test name states the scenario, and setup does not hide the behavior under test | Test quality, section 3 | P2 |\n190: | `review.test-aaa-layout` | A test separates Arrange, Act and Assert | Test quality, section 3 | P2 |\n191: | `review.test-magic-values` | A magic value in test data carries a comment that says why it matters | Test quality, section 3 | P2 |\n192: | `review.test-single-concern` | A test function holds one concern rather than several unrelated assertions | Test quality, section 3 | P2. P1 when an early failure masks a later one |\n193: | `review.test-smells` | Tests are not coupled to implementation detail, branched or copy-pasted | Test quality, section 5 | P2 |\n194: | `review.test-pyramid` | Each test sits at the level that fits what it checks | Test quality, section 6 | P2. P1 when the wrong level leaves a confidence gap |\n195: | `review.rate-limiting` | Code that serves HTTP limits authentication and expensive endpoints | Security, section 7 | P2. P1 when the abuse path is in reach |\n196: | `review.security-headers` | Code that serves HTTP sets CSP, the standard security headers, a narrow CORS policy and `SameSite` on sensitive cookies | Security, section 8 | P2 |\n197: | `review.supply-chain` | Dependencies are pinned, audited and from maintained sources, and the lock file is committed | Security, section 9 | P2. P1 for a known vulnerability in reach |\n198: | `review.audit-logging` | Security-sensitive actions leave an audit trail with enough context | Security, section 10 | P2 |\n199: | `review.data-privacy` | Personal data is collected, stored and moved only as far as its purpose needs | Security, section 11 | P2 |\n200: \n201: Every severity above still follows the reach rule in section 2, and a `replace:` row keeps the severity of the rule it replaces.\n202: \n203: ### Where the Rules for a File Come From\n204: \n205: The review reads the rules for each reviewed file from one resolver, the quality runner's explain entry ([`runner-contract.md`](../../sk-code-quality/references/runner-contract.md) section 3). [`SKILL.md`](../SKILL.md) section 3 holds the command.\n206: \n207: For each file the output names:\n208: \n209: - its surfaces, and the folder each surface loads from\n210: - every checklist that applies, with the seat that declared it\n211: - each checklist's `## Rule overrides` section, already read through the contract's linter\n212: \n213: Its `config.hygiene.disabled` lists the comment-hygiene rules the repository switched off.\n214: \n215: A surface the hub's router bundles from request words alone is a candidate. It applies only to the files the resolver places in it: the file's `surfaces` holds its label, or a checklist it declares applies to the file. With no file to review there is nothing to resolve, and [`SKILL.md`](../SKILL.md) section 3 says which evidence stays.\n216: \n217: ### Precedence\n218: \n219: The level of a checklist comes from its seat in the resolver's output. A checklist that several seats list takes the highest of them.\n220: \n221: | Seat in the resolver's `sources` | Level |\n222: | --- | --- |\n223: | None. The floor above | 1. The hard floor, which no source changes |\n224: | `repo-config` | 2. The repository checklist |\n225: | `hub-surface` outside the SKILLED packet, or `outside-skill` | 3. A specific surface |\n226: | `hub-surface` inside the SKILLED packet, `sk-code-skilled` | 4. The SKILLED fallback |\n227: | `default`, or no row at all | 5. The default lens, the rule as this mode ships it |\n228: \n229: For each rule and each file, the highest level that speaks to it wins. Two checklists at the same level that disagree on one rule for one file are a conflict: the review applies the default, lists the rule under `Conflicts` and names the conflict in its Next Steps for the repository to settle. Two rows that give the same action and the same text agree.\n230: \n231: ### Outcomes\n232: \n233: | The resolver shows | The review | `Rule sources` group |\n234: | --- | --- | --- |\n235: | A checklist with `overrides.refused` true, such as a row that names a floor id | Applies none of that checklist's rows | `Refused: <checklist file>` |\n236: | A valid row, the highest source for its rule | `none` drops the rule for the files the checklist covers. `replace: <text>` applies the text in its place | `Overrides: <rule id> <none\\|replace> from <checklist file>` |\n237: | A row whose id names no rule review applies: not a lens id above, not a `floor.*` id of the universal standards and not a `hygiene.*` id of the comment-hygiene checker | Ignores the row | `Ignored: <rule id> from <checklist file>` |\n238: | Two checklists at the same level that disagree | Applies the default | `Conflicts: <rule id> <checklist file> <checklist file>` |\n239: | A hygiene rule in `config.hygiene.disabled` | Treats it as a `none` row from the repository config | `Overrides: hygiene.<name> none from <config path>` |\n240: \n241: ### Hygiene Ids and the TODO Rule\n242: \n243: Quality's comment-hygiene checker flags artifact labels in comments, each under a `hygiene.*` id ([`runner-contract.md`](../../sk-code-quality/references/runner-contract.md) section 5). Six of them are tracker ids: `hygiene.issue`, `hygiene.task`, `hygiene.adr`, `hygiene.req`, `hygiene.rc` and `hygiene.chk`. Review maps its own judgments onto the same ids, so a rule a repository switches off in quality never comes back as a review finding.\n244: \n245: - When the repository switches a hygiene rule off, through `commentHygiene.disableRules` or a `none` row for its id, the review raises no finding for a label of that kind in a comment, at any severity. That covers `floor.ephemeral-pointers`, the judgment half of the same rules.\n246: - While a tracker-id rule is on, the review never asks a TODO to carry an id of that kind, because quality would block the comment that carries it. `review.todo-tracking` then asks only that the TODO says what is left and why.\n247: - A repository that wants a tracker reference on every TODO says so with a `replace:` row on `review.todo-tracking`, and switches off the hygiene rule for that id kind. A replacement that asks for an id a hygiene rule still flags is a conflict between two rules: the review applies the default and lists `review.todo-tracking` under `Conflicts`.\n248: \n249: ### The Rule Sources Line\n250: \n251: Every full review states the rules it applied in one `Rule sources:` line in its summary, directly under `Quality gate evidence`. It is the contract's format, section 7:\n252: \n253: ```text\n254: Rule sources: <checklist file>, <checklist file>. Overrides: <rule id> <none|replace> from <checklist file>. Refused: <checklist file>. Ignored: <rule id> from <checklist file>. Conflicts: <rule id> <checklist file> <checklist file>\n255: ```\n256: \n257: - List each checklist by its `file` value in the resolver's output, in the order the files first reach it, and separate entries within one group with `; `.\n258: - Write `none` for an empty group, and `Rule sources: none` when no file was resolved.\n259: - A path segment that starts with `local-` prints as `<LABEL>`, the label its private surface declares, or `<PRIVATE>`, the redaction the quality envelope applies, because a report may be pasted into a tracked file.\n260: - The line is plain text and never starts with `Review status:`, `Not checked:` or `Overall assessment`, so the two report checkers read the rest of the report as before. When the line is present, `scripts/check-review-final-line.js` fails a second `Rule sources:` line, a missing or reordered group and an entry whose shape does not match the format above. A report without the line still passes. The M-1 and M-2 skip outputs carry no `Rule sources:` line.\n261: \n262: ---\n263: \n264: ## 9. THE RESOLVER ALGORITHM\n265: \n266: The review reads the rules for a reviewed file from one resolver, the quality runner's explain entry, and this section is the algorithm that turns its output into the floor, the lens and the `Rule sources:` line. It is pseudocode: `ResolverError` is the caller's own error type, reported on the `Not checked:` line, and `load()` is the resource loader the router supplies. The block closes with the caller that composes the seven functions in order and the precedence mapping the route returns, which encodes the precedence table of section 8.\n267: \n268: ```python\n269: import json\n270: import subprocess\n271: \n272: # The quality runner's explain entry is the one resolver for which surfaces, skill\n273: # folders, checklists and rule overrides apply to a file. Review runs it and keeps no\n274: # surface markers of its own. HUB_ROOT is the sk-code folder this mode was loaded from.\n275: HUB_ROOT = SKILL_ROOT.parent\n276: QUALITY_RUNNER = HUB_ROOT / \"sk-code-quality\" / \"scripts\" / \"quality-gate.cjs\"\n277: SKILLED_PACKET = \"sk-code-skilled\"\n278: # bundled_surfaces holds the router's surface bundle, each with its label and packet.\n279: # known_rule_ids() reads the lens table of review-core.md section 8, the Id column of\n280: # the universal standards and the hygiene checker's rule names. redact_private()\n281: # prints a local-* path segment as its surface label, the envelope's redaction.\n282: \n283: def resolvable_files(files: list[str], cwd: str) -> tuple[list[str], list[str]]:\n284:     \"\"\"Split the reviewed paths into existing regular files and the rest.\n285: \n286:     A path the change deleted has nothing to resolve, and one missing path makes\n287:     --explain stop the whole call with FILE_NOT_FOUND, exit 3. So deleted paths never\n288:     reach it: the review lists them on its Not checked line where they matter.\n289:     \"\"\"\n290:     present = [f for f in files if (Path(cwd) / f).is_file()]\n291:     return present, [f for f in files if f not in present]\n292: \n293: def resolve_rule_sources(files: list[str], cwd: str) -> dict | None:\n294:     \"\"\"Return the code-quality-explain/v1 document for the reviewed files, or None.\n295: \n296:     --explain runs nothing, writes nothing and always exits 2. Only existing regular\n297:     files reach it, from resolvable_files. Exit 3 is then a usage or root fault: the\n298:     caller catches ResolverError, reports it on the Not checked line and reviews\n299:     those files against the baseline only.\n300:     \"\"\"\n301:     files, _deleted = resolvable_files(files, cwd)\n302:     if not files:\n303:         return None\n304:     run = subprocess.run([\"node\", str(QUALITY_RUNNER), \"--explain\", *files],\n305:                          cwd=cwd, capture_output=True, text=True)\n306:     if run.returncode != 2:\n307:         raise ResolverError(run.stderr.strip() or f\"--explain exited {run.returncode}\")\n308:     return json.loads(run.stdout)\n309: \n310: def inside_hub_checkout(cwd: str) -> bool:\n311:     \"\"\"True when the working directory shares the hub's git common dir.\"\"\"\n312:     def common_dir(where):\n313:         out = subprocess.run([\"git\", \"-c\", \"core.fsmonitor=false\", \"-C\", str(where),\n314:                               \"rev-parse\", \"--path-format=absolute\", \"--git-common-dir\"],\n315:                              capture_output=True, text=True)\n316:         return Path(out.stdout.strip()).resolve() if out.returncode == 0 else None\n317:     hub = common_dir(HUB_ROOT)\n318:     return hub is not None and common_dir(cwd) == hub\n319: \n320: def surface_evidence(explained, bundled_surfaces, cwd) -> list[str]:\n321:     \"\"\"Labels in the resolver's order. A router-bundled surface is only a candidate.\"\"\"\n322:     if explained is None:\n323:         # No files to resolve: keep the bundle, except that SKILLED stays only inside\n324:         # the hub's own checkout, because a word like \"typescript\" says nothing about\n325:         # whose code this is.\n326:         return [s.label for s in bundled_surfaces\n327:                 if s.packet != SKILLED_PACKET or inside_hub_checkout(cwd)] or [\"UNKNOWN\"]\n328:     labels = []\n329:     for entry in explained[\"files\"]:\n330:         placed = list(entry[\"surfaces\"]) + [\n331:             s.label for s in bundled_surfaces\n332:             if any(c[\"file\"].startswith(f\"hub:{HUB_ROOT.name}/{s.packet}/\") for c in entry[\"checklists\"])]\n333:         for label in placed:\n334:             if label != \"UNKNOWN\" and label not in labels:\n335:                 labels.append(label)\n336:     return labels or [\"UNKNOWN\"]\n337: \n338: def checklist_level(checklist) -> int:\n339:     \"\"\"2 repository, 3 specific surface, 4 SKILLED fallback, 5 shipped default.\"\"\"\n340:     def seat(source):\n341:         if source == \"repo-config\":\n342:             return 2\n343:         if source == \"outside-skill\":\n344:             return 3\n345:         if source == \"hub-surface\":\n346:             return 4 if checklist[\"file\"].startswith(f\"hub:{HUB_ROOT.name}/{SKILLED_PACKET}/\") else 3\n347:         return 5\n348:     return min(seat(source) for source in checklist[\"sources\"])\n349: \n350: def applied_overrides(explained, known_ids) -> dict:\n351:     \"\"\"The winning row per (file, rule id) and the groups of the Rule sources line.\n352: \n353:     known_ids holds the lens ids of review-core.md section 8, the floor.* ids of\n354:     the universal standards and the checker's hygiene.* ids. The linter already\n355:     refused every hard-floor row, so a refused checklist contributes nothing.\n356:     \"\"\"\n357:     groups = {\"sources\": [], \"overrides\": [], \"refused\": [], \"ignored\": [], \"conflicts\": []}\n358:     winners = {}\n359:     if explained is None:\n360:         return {\"winners\": winners, \"groups\": groups}\n361:     disabled = explained[\"config\"].get(\"hygiene\", {}).get(\"disabled\", [])\n362:     for entry in explained[\"files\"]:\n363:         candidates = {}\n364:         for rule_id in disabled:\n365:             candidates.setdefault(rule_id, []).append(\n366:                 (2, explained[\"config\"][\"path\"], {\"id\": rule_id, \"action\": \"none\", \"text\": None}))\n367:         for checklist in entry[\"checklists\"]:\n368:             if checklist[\"file\"] not in groups[\"sources\"]:\n369:                 groups[\"sources\"].append(checklist[\"file\"])\n370:             overrides = checklist.get(\"overrides\") or {}\n371:             if overrides.get(\"refused\"):\n372:                 groups[\"refused\"].append(checklist[\"file\"])\n373:                 continue\n374:             for row in overrides.get(\"rows\", []):\n375:                 if row[\"id\"] not in known_ids:\n376:                     groups[\"ignored\"].append(f'{row[\"id\"]} from {checklist[\"file\"]}')\n377:                     continue\n378:                 candidates.setdefault(row[\"id\"], []).append((checklist_level(checklist), checklist[\"file\"], row))\n379:         for rule_id, rows in candidates.items():\n380:             top = min(level for level, _, _ in rows)\n381:             best = [(f, r) for level, f, r in rows if level == top]\n382:             if len({(r[\"action\"], r[\"text\"]) for _, r in best}) > 1:\n383:                 groups[\"conflicts\"].append(f'{rule_id} {best[0][0]} {best[1][0]}')\n384:                 continue\n385:             winners[(entry[\"file\"], rule_id)] = best[0][1]\n386:             groups[\"overrides\"].append(f'{rule_id} {best[0][1][\"action\"]} from {best[0][0]}')\n387:     for name, values in groups.items():\n388:         groups[name] = list(dict.fromkeys(values))\n389:     return {\"winners\": winners, \"groups\": groups}\n390: \n391: def rule_sources_line(groups) -> str:\n392:     \"\"\"The one Rule sources line of review-core.md section 8, private names redacted.\"\"\"\n393:     def join(values):\n394:         return \"; \".join(redact_private(v) for v in values) if values else \"none\"\n395:     return (f'Rule sources: {\", \".join(redact_private(v) for v in groups[\"sources\"]) or \"none\"}. '\n396:             f'Overrides: {join(groups[\"overrides\"])}. Refused: {join(groups[\"refused\"])}. '\n397:             f'Ignored: {join(groups[\"ignored\"])}. Conflicts: {join(groups[\"conflicts\"])}')\n398: \n399: # The caller composes the steps in this order, each one feeding the next.\n400: explained = resolve_rule_sources(files or [], cwd)  # None when no file resolves\n401: surface_evidence_labels = surface_evidence(explained, bundled_surfaces, cwd)\n402: rule_sources = applied_overrides(explained, known_rule_ids())\n403: line = rule_sources_line(rule_sources[\"groups\"])\n404: \n405: # The precedence the route reports, the mapping of the precedence table in section 8.\n406: precedence = {\n407:     \"baseline_minimums\": [\"security\", \"correctness\"],\n408:     \"fixed\": \"the floor of review-core.md section 8\",\n409:     \"lens_overrides\": [\"repository\", \"specific_surface\", \"skilled_fallback\", \"default_lens\"],\n410:     \"surface_overrides\": [\"style\", \"build\", \"test_commands\", \"surface_process\"],\n411:     \"on_conflict\": \"escalate\",\n412: }\n413: ```\n414: \n415: ---\n416: \n417: ## 10. RELATED RESOURCES\n418: \n419: - [review-ux-single-pass.md](./review-ux-single-pass.md) - Interactive single-pass report flow and next-step prompts.\n420: - [quick-reference.md](./quick-reference.md) - Lightweight index across baseline review references.\n421: - [security-checklist.md](../assets/security-checklist.md) - Security and reliability checks.\n422: - [code-quality-checklist.md](../assets/code-quality-checklist.md) - Correctness, KISS, DRY, and maintainability checks.\n423: - [rule-overrides.md](../../shared/references/universal/rule-overrides.md) - The shared override format, ids, hard floor and precedence.","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file .skilled/skills/sk-code/sk-code-review/references/review-core.md, lines 1-423\n1: ---\n2: title: Review Core Doctrine\n3: description: Shared findings-first review doctrine for both single-pass and deep-review workflows.\n4: trigger_phrases:\n5:   - \"findings first severity ordering\"\n6:   - \"review finding schema\"\n7:   - \"severity contract for merge decisions\"\n8:   - \"evidence file line citation\"\n9:   - \"baseline surface precedence\"\n10:   - \"baseline check families\"\n11: importance_tier: important\n12: contextType: implementation\n13: version: 1.5.9.0\n14: ---\n15: \n16: # Review Core Doctrine\n17: \n18: Shared doctrine consumed by both `@review` and `@deep-review`.\n19: \n20: **Ownership.** This file owns the severity ids and their meanings (section 2), the evidence rules (section 3) and the finding schema (section 7). The deep-review contract, [`review-mode-contract.yaml`](../../../system-deep-loop/deep-review/assets/review-mode-contract.yaml), is an external consumer: it owns the deep-review loop (dimensions, verdicts, severity weights, convergence and quality gates) and reuses the severity ids defined here. When the two disagree on a severity id or its meaning, this file wins and the YAML is corrected by its owner, `deep-review`. The YAML may be stricter for its own loop, as when it requires `file:line` evidence on `P2`, but never looser.\n21: \n22: ---\n23: \n24: ## 1. OVERVIEW\n25: \n26: ### Purpose\n27: \n28: Shared findings-first review doctrine for both single-pass and deep-review workflows.\n29: \n30: ### When to Use\n31: \n32: - A `@review` or `@deep-review` pass that needs the severity contract, the evidence rules or the finding schema.\n33: - A review that must state its `Rule sources:` line, or apply a repository or surface override to a default-lens rule.\n34: \n35: Every rule in sections 2 to 7 is review floor, the part no repository or surface can change. Section 8 names the floor ids, the default lens that a repository may drop or replace, and how the review reads and reports those overrides.\n36: \n37: ---\n38: \n39: ## 2. SEVERITY DEFINITIONS\n40: \n41: | Level | Meaning | Handling |\n42: | --- | --- | --- |\n43: | P0 | Blocker: exploitable security issue, auth bypass, destructive data loss | Block merge |\n44: | P1 | Required: correctness bug, spec mismatch, must-fix gate issue | Fix before merge |\n45: | P2 | Suggestion: non-blocking improvement, documentation polish, style or maintainability follow-up | Optional or schedule follow-up |\n46: \n47: ### Reach Calibration\n48: \n49: A `P0` or `P1` finding names its reach: an input or call path that the code's stated contract allows, or a real caller that sends the failing input. The stated contract is what the code promises through its signature, types, doc comment, name and the checks it already makes.\n50: \n51: - A failure that needs input outside the stated contract, such as `NaN` where the contract says a number, a wrong type, or an inverted range the code already rejects, is `P2` hardening.\n52: - The exception is input the code claims to validate. When a guard, a thrown error or a doc line promises to reject an input class and the promise fails for an input in that class, the gap is a correctness finding and keeps `P1` or higher. A guard claims only the class it checks: an ordering check such as `min > max` does not claim that its operands are numbers.\n53: - At a trust boundary (user input, network, files, environment, another service), every value the outside can send is in reach. The stated contract of internal code never narrows a security finding on data that crosses that boundary.\n54: - A finding that cannot name its reach is `P2`, however severe the failure would be.\n55: \n56: Escalation rule: if confidence is low but impact is high, classify toward the higher severity and state the uncertainty explicitly. The confidence is confidence that the reach exists. The rule raises a finding whose reach is named but not proven, such as a caller that probably sends the input. It never raises a finding with no reach, so it cannot lift an out-of-contract failure above `P2`.\n57: \n58: ### Numeric Severity Calibration\n59: \n60: Numeric scores are advisory context, not the gate. A reviewer may add an optional `riskScore` to a finding and adjust it by `+/-2` for local context such as exploitability, blast radius, user impact, confidence, or proven containment. The merge/block decision remains the severity contract above: `P0` blocks, `P1` requires remediation, and `P2` is advisory. Do not adopt `score>=4` or any numeric threshold as a blocker.\n61: \n62: ---\n63: \n64: ## 3. EVIDENCE REQUIREMENTS\n65: \n66: - Every `P0` and `P1` finding must include a concrete `file:line` citation.\n67: - Evidence must tie the finding to observed code behavior, not just a general concern.\n68: - `P2` findings should still include specific evidence when available, even if impact is advisory.\n69: - If evidence is incomplete, state the assumption and why the risk still matters.\n70: \n71: ---\n72: \n73: ## 4. FINDINGS OUTPUT ORDERING\n74: \n75: - Present findings before summary or praise sections.\n76: - Order findings by severity first: `P0`, then `P1`, then `P2`.\n77: - Keep ordering stable within a severity bucket by impact and confidence.\n78: - Separate required fixes from optional suggestions so merge decisions stay clear.\n79: \n80: ---\n81: \n82: ## 5. BASELINE + SURFACE PRECEDENCE\n83: \n84: Apply this skill as the baseline first, then pair it with `sk-code` surface evidence when available:\n85: \n86: - Detected code surfaces -> the surfaces the quality runner's resolver places each reviewed file in, specific surfaces first and the `SKILLED` fallback last. Each one pairs with its `sk-code` evidence packet, such as `sk-code-skilled` for `SKILLED`. No match -> `UNKNOWN`. The resolver applies the shared detection contract, [`stack-detection.md`](../../shared/references/stack-detection.md) section 2, so the review keeps no detection of its own. Section 8 describes what it returns.\n87: - Unclear surfaces -> baseline-only plus explicit uncertainty\n88: \n89: Precedence rules:\n90: \n91: - Baseline security and correctness minimums are always enforced.\n92: - Surface style, process, build, and test conventions override generic baseline guidance.\n93: - A repository or surface changes one default-lens rule only through a `## Rule overrides` row, by the precedence in section 8.\n94: - Unclear conflicts must be escalated rather than guessed.\n95: \n96: ---\n97: \n98: ## 6. BASELINE CHECK FAMILIES\n99: \n100: Mandatory baseline families:\n101: \n102: - Correctness minimums: regression risk, contract safety, spec mismatch, destructive side effects, and boundary handling.\n103: - Security minimums: auth and authorization gaps, injection exposure, unsafe secrets handling, privilege misuse, and reliability risks with security impact.\n104: \n105: These minimums cannot be relaxed by surface guidance.\n106: \n107: ---\n108: \n109: ## 7. FINDING SCHEMA\n110: \n111: Each finding should provide:\n112: \n113: | Field | Requirement |\n114: | --- | --- |\n115: | `id` | The finding's number in the Findings list, counted once across severity groups, such as `2` |\n116: | `severity` | One of `P0`, `P1`, `P2` |\n117: | `title` | Short, risk-oriented summary |\n118: | `case` | The input or situation that produces the wrong result. A finding with no case is not reported |\n119: | `file` | Primary `path:line` location |\n120: | `evidence` | Plain-language explanation tied to observed code; for a performance finding, name the workload it assumes, such as row count, request rate or payload size |\n121: | `userImpact` | What users or callers bear if this fix is deferred |\n122: | `findingClass` | One of `instance-only`, `class-of-bug`, `cross-consumer`, `algorithmic`, `matrix/evidence`, or `test-isolation` |\n123: | `scopeProof` | Grep/test/audit evidence that the recommendation covers same-class sites and consumers, or proves the finding is instance-only |\n124: | `affectedSurfaceHints` | Optional string array of producer/consumer surfaces the fix should address; recommended for actionable findings, required for cross-consumer findings. Use free-form short strings, max about 5 entries. Optional for instance-only findings. |\n125: | `riskScore` | Optional advisory number for relative risk calibration; never gating and never a substitute for `severity` |\n126: | `recommendation` | Specific, scope-proportional fix or follow-up |\n127: \n128: Suggested shape:\n129: \n130: ```markdown\n131: ### 2 [P1] Missing authorization check\n132: - Case: a request with no session token reaches the write handler and changes a user record\n133: - File: path/to/file.ts:42\n134: - Evidence: Request handling reaches the write path before role validation.\n135: - User impact: Until this is fixed, any caller can write records without a role check.\n136: - Finding class: cross-consumer\n137: - Scope proof: `rg -n \"permission guard|write path\" path/to` shows the write handler is the only unchecked consumer.\n138: - Affected surface hints: [\"request handler\", \"write path\", \"permission guard\"]\n139: - riskScore: 6 (advisory only)\n140: - Recommendation: Enforce the existing permission guard before mutation.\n141: ```\n142: \n143: ---\n144: \n145: ## 8. FLOOR, DEFAULT LENS AND RULE OVERRIDES\n146: \n147: Review applies two kinds of rule.\n148: \n149: - **The floor** applies in every repository, and no source changes it.\n150: - **The default lens** is this mode's own view of maintainable code. It applies as written until a repository or a surface drops or replaces one of its rules through the shared [rule overrides contract](../../shared/references/universal/rule-overrides.md), which this section adopts for review.\n151: \n152: ### The Floor\n153: \n154: Sections 2 to 7 of this file are floor. The checklist sections the table names are floor too, and each one cites its id beside its heading.\n155: \n156: | Id | What it fixes | Where |\n157: | --- | --- | --- |\n158: | `review.severity` | The ids `P0`, `P1` and `P2` and what each one means | Section 2 |\n159: | `review.reach` | A `P0` or `P1` finding names an input or caller in reach | Section 2, Reach Calibration |\n160: | `review.security-minimums` | Auth and authorization gaps, injection exposure, unsafe secrets handling, privilege misuse and reliability risks with security impact | Sections 5 and 6. Security checklist sections 2 to 6 |\n161: | `review.correctness-minimums` | Regression risk, contract safety, spec mismatch, destructive side effects and boundary handling | Sections 5 and 6. Code quality checklist sections 2, 4 and 5. Security checklist sections 5 and 6. Test quality checklist sections 2 and 4, and the items that make a test unable to fail |\n162: \n163: A checklist item that enforces a rule of the universal standards, [`code-quality-standards.md`](../../shared/references/universal/code-quality-standards.md), carries that rule's `floor.*` id, never a `review.*` id. A `FIXED` id, such as `floor.silent-failures`, is floor here as it is in quality. An overridable one, such as `floor.error-messages`, applies as the standards ship it until a row changes it, for review exactly as for quality.\n164: \n165: An item in a lens section that is also an auth or authorization gap, injection exposure, unsafe secrets handling or privilege misuse is reported under `review.security-minimums`, so no row that drops the lens rule drops that finding.\n166: \n167: The fix completeness checklist and the removal plan are process guides for turning a finding into a fix. They carry no review rule, so no row reaches them.\n168: \n169: ### The Default Lens\n170: \n171: Each lens rule is a default that a repository may change. Its checklist item is worded as the default and names its id.\n172: \n173: | Id | Default rule | Checklist and section | Default severity |\n174: | --- | --- | --- | --- |\n175: | `review.performance` | No N+1 queries, unbatched per-item calls, uncached hot-loop work, blocking work on a request path or unbounded growth | Code quality, section 3 | P2. P1 when a named workload in reach fails |\n176: | `review.maintainability` | No repeated logic that behaves differently, hidden coupling through shared mutable state, or side effects the name does not imply | Code quality, section 6 | P2 |\n177: | `review.magic-literals` | A domain value is a named constant, not a bare literal | Code quality, section 6 | P2 |\n178: | `review.function-length` | A function stays at 20 lines or fewer unless its structure justifies more | Code quality, section 6 | P2 |\n179: | `review.nesting-depth` | Control flow nests fewer than 4 levels deep | Code quality, section 6 | P2 |\n180: | `review.law-of-demeter` | A call chain crosses at most two object boundaries | Code quality, section 6 | P2 |\n181: | `review.todo-tracking` | A TODO, FIXME or HACK on a production path says what is left and follows the repository's tracking convention | Code quality, section 6 | P2 |\n182: | `review.hardcoded-config` | Environment-specific values, such as URLs, ports and timeouts, are externalized | Code quality, section 6 | P2 |\n183: | `review.prefer-native` | No hand-rolled code or dependency where the language, runtime or platform already provides the behavior | Code quality, section 6 | P2 |\n184: | `review.kiss` | No abstraction, option or code path without a current requirement | Code quality, section 7 | P2. P1 when it adds attack surface, contract obligations or regression risk |\n185: | `review.dry` | No duplicated rules, copy-paste branches or repeated validation that should share one source | Code quality, section 7 | P2. P1 when the duplication carries behavior risk |\n186: | `review.rule-of-three` | Consolidate on the third instance of a shared concept, not the second | Code quality, section 7 | P2 |\n187: | `review.ceiling-marker` | A concrete `ceiling:` comment marks an intentional simplification and downgrades a KISS or YAGNI finding on it | Code quality, section 7 | Lowers a P2 only |\n188: | `review.solid` | The SOLID prompts and architecture smells | SOLID checklist, sections 2 to 4 | P2 |\n189: | `review.test-structure` | A test name states the scenario, and setup does not hide the behavior under test | Test quality, section 3 | P2 |\n190: | `review.test-aaa-layout` | A test separates Arrange, Act and Assert | Test quality, section 3 | P2 |\n191: | `review.test-magic-values` | A magic value in test data carries a comment that says why it matters | Test quality, section 3 | P2 |\n192: | `review.test-single-concern` | A test function holds one concern rather than several unrelated assertions | Test quality, section 3 | P2. P1 when an early failure masks a later one |\n193: | `review.test-smells` | Tests are not coupled to implementation detail, branched or copy-pasted | Test quality, section 5 | P2 |\n194: | `review.test-pyramid` | Each test sits at the level that fits what it checks | Test quality, section 6 | P2. P1 when the wrong level leaves a confidence gap |\n195: | `review.rate-limiting` | Code that serves HTTP limits authentication and expensive endpoints | Security, section 7 | P2. P1 when the abuse path is in reach |\n196: | `review.security-headers` | Code that serves HTTP sets CSP, the standard security headers, a narrow CORS policy and `SameSite` on sensitive cookies | Security, section 8 | P2 |\n197: | `review.supply-chain` | Dependencies are pinned, audited and from maintained sources, and the lock file is committed | Security, section 9 | P2. P1 for a known vulnerability in reach |\n198: | `review.audit-logging` | Security-sensitive actions leave an audit trail with enough context | Security, section 10 | P2 |\n199: | `review.data-privacy` | Personal data is collected, stored and moved only as far as its purpose needs | Security, section 11 | P2 |\n200: \n201: Every severity above still follows the reach rule in section 2, and a `replace:` row keeps the severity of the rule it replaces.\n202: \n203: ### Where the Rules for a File Come From\n204: \n205: The review reads the rules for each reviewed file from one resolver, the quality runner's explain entry ([`runner-contract.md`](../../sk-code-quality/references/runner-contract.md) section 3). [`SKILL.md`](../SKILL.md) section 3 holds the command.\n206: \n207: For each file the output names:\n208: \n209: - its surfaces, and the folder each surface loads from\n210: - every checklist that applies, with the seat that declared it\n211: - each checklist's `## Rule overrides` section, already read through the contract's linter\n212: \n213: Its `config.hygiene.disabled` lists the comment-hygiene rules the repository switched off.\n214: \n215: A surface the hub's router bundles from request words alone is a candidate. It applies only to the files the resolver places in it: the file's `surfaces` holds its label, or a checklist it declares applies to the file. With no file to review there is nothing to resolve, and [`SKILL.md`](../SKILL.md) section 3 says which evidence stays.\n216: \n217: ### Precedence\n218: \n219: The level of a checklist comes from its seat in the resolver's output. A checklist that several seats list takes the highest of them.\n220: \n221: | Seat in the resolver's `sources` | Level |\n222: | --- | --- |\n223: | None. The floor above | 1. The hard floor, which no source changes |\n224: | `repo-config` | 2. The repository checklist |\n225: | `hub-surface` outside the SKILLED packet, or `outside-skill` | 3. A specific surface |\n226: | `hub-surface` inside the SKILLED packet, `sk-code-skilled` | 4. The SKILLED fallback |\n227: | `default`, or no row at all | 5. The default lens, the rule as this mode ships it |\n228: \n229: For each rule and each file, the highest level that speaks to it wins. Two checklists at the same level that disagree on one rule for one file are a conflict: the review applies the default, lists the rule under `Conflicts` and names the conflict in its Next Steps for the repository to settle. Two rows that give the same action and the same text agree.\n230: \n231: ### Outcomes\n232: \n233: | The resolver shows | The review | `Rule sources` group |\n234: | --- | --- | --- |\n235: | A checklist with `overrides.refused` true, such as a row that names a floor id | Applies none of that checklist's rows | `Refused: <checklist file>` |\n236: | A valid row, the highest source for its rule | `none` drops the rule for the files the checklist covers. `replace: <text>` applies the text in its place | `Overrides: <rule id> <none\\|replace> from <checklist file>` |\n237: | A row whose id names no rule review applies: not a lens id above, not a `floor.*` id of the universal standards and not a `hygiene.*` id of the comment-hygiene checker | Ignores the row | `Ignored: <rule id> from <checklist file>` |\n238: | Two checklists at the same level that disagree | Applies the default | `Conflicts: <rule id> <checklist file> <checklist file>` |\n239: | A hygiene rule in `config.hygiene.disabled` | Treats it as a `none` row from the repository config | `Overrides: hygiene.<name> none from <config path>` |\n240: \n241: ### Hygiene Ids and the TODO Rule\n242: \n243: Quality's comment-hygiene checker flags artifact labels in comments, each under a `hygiene.*` id ([`runner-contract.md`](../../sk-code-quality/references/runner-contract.md) section 5). Six of them are tracker ids: `hygiene.issue`, `hygiene.task`, `hygiene.adr`, `hygiene.req`, `hygiene.rc` and `hygiene.chk`. Review maps its own judgments onto the same ids, so a rule a repository switches off in quality never comes back as a review finding.\n244: \n245: - When the repository switches a hygiene rule off, through `commentHygiene.disableRules` or a `none` row for its id, the review raises no finding for a label of that kind in a comment, at any severity. That covers `floor.ephemeral-pointers`, the judgment half of the same rules.\n246: - While a tracker-id rule is on, the review never asks a TODO to carry an id of that kind, because quality would block the comment that carries it. `review.todo-tracking` then asks only that the TODO says what is left and why.\n247: - A repository that wants a tracker reference on every TODO says so with a `replace:` row on `review.todo-tracking`, and switches off the hygiene rule for that id kind. A replacement that asks for an id a hygiene rule still flags is a conflict between two rules: the review applies the default and lists `review.todo-tracking` under `Conflicts`.\n248: \n249: ### The Rule Sources Line\n250: \n251: Every full review states the rules it applied in one `Rule sources:` line in its summary, directly under `Quality gate evidence`. It is the contract's format, section 7:\n252: \n253: ```text\n254: Rule sources: <checklist file>, <checklist file>. Overrides: <rule id> <none|replace> from <checklist file>. Refused: <checklist file>. Ignored: <rule id> from <checklist file>. Conflicts: <rule id> <checklist file> <checklist file>\n255: ```\n256: \n257: - List each checklist by its `file` value in the resolver's output, in the order the files first reach it, and separate entries within one group with `; `.\n258: - Write `none` for an empty group, and `Rule sources: none` when no file was resolved.\n259: - A path segment that starts with `local-` prints as `<LABEL>`, the label its private surface declares, or `<PRIVATE>`, the redaction the quality envelope applies, because a report may be pasted into a tracked file.\n260: - The line is plain text and never starts with `Review status:`, `Not checked:` or `Overall assessment`, so the two report checkers read the rest of the report as before. When the line is present, `scripts/check-review-final-line.js` fails a second `Rule sources:` line, a missing or reordered group and an entry whose shape does not match the format above. A report without the line still passes. The M-1 and M-2 skip outputs carry no `Rule sources:` line.\n261: \n262: ---\n263: \n264: ## 9. THE RESOLVER ALGORITHM\n265: \n266: The review reads the rules for a reviewed file from one resolver, the quality runner's explain entry, and this section is the algorithm that turns its output into the floor, the lens and the `Rule sources:` line. It is pseudocode: `ResolverError` is the caller's own error type, reported on the `Not checked:` line, and `load()` is the resource loader the router supplies. The block closes with the caller that composes the seven functions in order and the precedence mapping the route returns, which encodes the precedence table of section 8.\n267: \n268: ```python\n269: import json\n270: import subprocess\n271: \n272: # The quality runner's explain entry is the one resolver for which surfaces, skill\n273: # folders, checklists and rule overrides apply to a file. Review runs it and keeps no\n274: # surface markers of its own. HUB_ROOT is the sk-code folder this mode was loaded from.\n275: HUB_ROOT = SKILL_ROOT.parent\n276: QUALITY_RUNNER = HUB_ROOT / \"sk-code-quality\" / \"scripts\" / \"quality-gate.cjs\"\n277: SKILLED_PACKET = \"sk-code-skilled\"\n278: # bundled_surfaces holds the router's surface bundle, each with its label and packet.\n279: # known_rule_ids() reads the lens table of review-core.md section 8, the Id column of\n280: # the universal standards and the hygiene checker's rule names. redact_private()\n281: # prints a local-* path segment as its surface label, the envelope's redaction.\n282: \n283: def resolvable_files(files: list[str], cwd: str) -> tuple[list[str], list[str]]:\n284:     \"\"\"Split the reviewed paths into existing regular files and the rest.\n285: \n286:     A path the change deleted has nothing to resolve, and one missing path makes\n287:     --explain stop the whole call with FILE_NOT_FOUND, exit 3. So deleted paths never\n288:     reach it: the review lists them on its Not checked line where they matter.\n289:     \"\"\"\n290:     present = [f for f in files if (Path(cwd) / f).is_file()]\n291:     return present, [f for f in files if f not in present]\n292: \n293: def resolve_rule_sources(files: list[str], cwd: str) -> dict | None:\n294:     \"\"\"Return the code-quality-explain/v1 document for the reviewed files, or None.\n295: \n296:     --explain runs nothing, writes nothing and always exits 2. Only existing regular\n297:     files reach it, from resolvable_files. Exit 3 is then a usage or root fault: the\n298:     caller catches ResolverError, reports it on the Not checked line and reviews\n299:     those files against the baseline only.\n300:     \"\"\"\n301:     files, _deleted = resolvable_files(files, cwd)\n302:     if not files:\n303:         return None\n304:     run = subprocess.run([\"node\", str(QUALITY_RUNNER), \"--explain\", *files],\n305:                          cwd=cwd, capture_output=True, text=True)\n306:     if run.returncode != 2:\n307:         raise ResolverError(run.stderr.strip() or f\"--explain exited {run.returncode}\")\n308:     return json.loads(run.stdout)\n309: \n310: def inside_hub_checkout(cwd: str) -> bool:\n311:     \"\"\"True when the working directory shares the hub's git common dir.\"\"\"\n312:     def common_dir(where):\n313:         out = subprocess.run([\"git\", \"-c\", \"core.fsmonitor=false\", \"-C\", str(where),\n314:                               \"rev-parse\", \"--path-format=absolute\", \"--git-common-dir\"],\n315:                              capture_output=True, text=True)\n316:         return Path(out.stdout.strip()).resolve() if out.returncode == 0 else None\n317:     hub = common_dir(HUB_ROOT)\n318:     return hub is not None and common_dir(cwd) == hub\n319: \n320: def surface_evidence(explained, bundled_surfaces, cwd) -> list[str]:\n321:     \"\"\"Labels in the resolver's order. A router-bundled surface is only a candidate.\"\"\"\n322:     if explained is None:\n323:         # No files to resolve: keep the bundle, except that SKILLED stays only inside\n324:         # the hub's own checkout, because a word like \"typescript\" says nothing about\n325:         # whose code this is.\n326:         return [s.label for s in bundled_surfaces\n327:                 if s.packet != SKILLED_PACKET or inside_hub_checkout(cwd)] or [\"UNKNOWN\"]\n328:     labels = []\n329:     for entry in explained[\"files\"]:\n330:         placed = list(entry[\"surfaces\"]) + [\n331:             s.label for s in bundled_surfaces\n332:             if any(c[\"file\"].startswith(f\"hub:{HUB_ROOT.name}/{s.packet}/\") for c in entry[\"checklists\"])]\n333:         for label in placed:\n334:             if label != \"UNKNOWN\" and label not in labels:\n335:                 labels.append(label)\n336:     return labels or [\"UNKNOWN\"]\n337: \n338: def checklist_level(checklist) -> int:\n339:     \"\"\"2 repository, 3 specific surface, 4 SKILLED fallback, 5 shipped default.\"\"\"\n340:     def seat(source):\n341:         if source == \"repo-config\":\n342:             return 2\n343:         if source == \"outside-skill\":\n344:             return 3\n345:         if source == \"hub-surface\":\n346:             return 4 if checklist[\"file\"].startswith(f\"hub:{HUB_ROOT.name}/{SKILLED_PACKET}/\") else 3\n347:         return 5\n348:     return min(seat(source) for source in checklist[\"sources\"])\n349: \n350: def applied_overrides(explained, known_ids) -> dict:\n351:     \"\"\"The winning row per (file, rule id) and the groups of the Rule sources line.\n352: \n353:     known_ids holds the lens ids of review-core.md section 8, the floor.* ids of\n354:     the universal standards and the checker's hygiene.* ids. The linter already\n355:     refused every hard-floor row, so a refused checklist contributes nothing.\n356:     \"\"\"\n357:     groups = {\"sources\": [], \"overrides\": [], \"refused\": [], \"ignored\": [], \"conflicts\": []}\n358:     winners = {}\n359:     if explained is None:\n360:         return {\"winners\": winners, \"groups\": groups}\n361:     disabled = explained[\"config\"].get(\"hygiene\", {}).get(\"disabled\", [])\n362:     for entry in explained[\"files\"]:\n363:         candidates = {}\n364:         for rule_id in disabled:\n365:             candidates.setdefault(rule_id, []).append(\n366:                 (2, explained[\"config\"][\"path\"], {\"id\": rule_id, \"action\": \"none\", \"text\": None}))\n367:         for checklist in entry[\"checklists\"]:\n368:             if checklist[\"file\"] not in groups[\"sources\"]:\n369:                 groups[\"sources\"].append(checklist[\"file\"])\n370:             overrides = checklist.get(\"overrides\") or {}\n371:             if overrides.get(\"refused\"):\n372:                 groups[\"refused\"].append(checklist[\"file\"])\n373:                 continue\n374:             for row in overrides.get(\"rows\", []):\n375:                 if row[\"id\"] not in known_ids:\n376:                     groups[\"ignored\"].append(f'{row[\"id\"]} from {checklist[\"file\"]}')\n377:                     continue\n378:                 candidates.setdefault(row[\"id\"], []).append((checklist_level(checklist), checklist[\"file\"], row))\n379:         for rule_id, rows in candidates.items():\n380:             top = min(level for level, _, _ in rows)\n381:             best = [(f, r) for level, f, r in rows if level == top]\n382:             if len({(r[\"action\"], r[\"text\"]) for _, r in best}) > 1:\n383:                 groups[\"conflicts\"].append(f'{rule_id} {best[0][0]} {best[1][0]}')\n384:                 continue\n385:             winners[(entry[\"file\"], rule_id)] = best[0][1]\n386:             groups[\"overrides\"].append(f'{rule_id} {best[0][1][\"action\"]} from {best[0][0]}')\n387:     for name, values in groups.items():\n388:         groups[name] = list(dict.fromkeys(values))\n389:     return {\"winners\": winners, \"groups\": groups}\n390: \n391: def rule_sources_line(groups) -> str:\n392:     \"\"\"The one Rule sources line of review-core.md section 8, private names redacted.\"\"\"\n393:     def join(values):\n394:         return \"; \".join(redact_private(v) for v in values) if values else \"none\"\n395:     return (f'Rule sources: {\", \".join(redact_private(v) for v in groups[\"sources\"]) or \"none\"}. '\n396:             f'Overrides: {join(groups[\"overrides\"])}. Refused: {join(groups[\"refused\"])}. '\n397:             f'Ignored: {join(groups[\"ignored\"])}. Conflicts: {join(groups[\"conflicts\"])}')\n398: \n399: # The caller composes the steps in this order, each one feeding the next.\n400: explained = resolve_rule_sources(files or [], cwd)  # None when no file resolves\n401: surface_evidence_labels = surface_evidence(explained, bundled_surfaces, cwd)\n402: rule_sources = applied_overrides(explained, known_rule_ids())\n403: line = rule_sources_line(rule_sources[\"groups\"])\n404: \n405: # The precedence the route reports, the mapping of the precedence table in section 8.\n406: precedence = {\n407:     \"baseline_minimums\": [\"security\", \"correctness\"],\n408:     \"fixed\": \"the floor of review-core.md section 8\",\n409:     \"lens_overrides\": [\"repository\", \"specific_surface\", \"skilled_fallback\", \"default_lens\"],\n410:     \"surface_overrides\": [\"style\", \"build\", \"test_commands\", \"surface_process\"],\n411:     \"on_conflict\": \"escalate\",\n412: }\n413: ```\n414: \n415: ---\n416: \n417: ## 10. RELATED RESOURCES\n418: \n419: - [review-ux-single-pass.md](./review-ux-single-pass.md) - Interactive single-pass report flow and next-step prompts.\n420: - [quick-reference.md](./quick-reference.md) - Lightweight index across baseline review references.\n421: - [security-checklist.md](../assets/security-checklist.md) - Security and reliability checks.\n422: - [code-quality-checklist.md](../assets/code-quality-checklist.md) - Correctness, KISS, DRY, and maintainability checks.\n423: - [rule-overrides.md](../../shared/references/universal/rule-overrides.md) - The shared override format, ids, hard floor and precedence."}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\".skilled/skills/sk-code/sk-code-review/references/review-core.md\"}"},"time":{"start":1794669393675,"end":1794669394564}}}}
