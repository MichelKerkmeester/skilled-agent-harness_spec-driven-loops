d/skills/sk-doc/scripts/package_skill.py\n218:   validate_skill_package: .skilled/skills/sk-doc/scripts/validate_skill_package.py\n219: \n220: quality_standards:\n221:   template_first: required\n222:   sk_doc_alignment: required\n223:   section_boundary_rules:\n224:     when_to_use: \"activation and use-case logic only\"\n225:     smart_routing: \"8 to 12 lines of plain prose, and the machine router lives in the sibling ROUTER.md under a final '## MACHINE ROUTER' heading\"\n226:   validation_pipeline:\n227:     full_flows:\n228:     - \"python3 .skilled/skills/sk-doc/scripts/quick_validate.py [skill_path]/[skill_name] --json\"\n229:     - \"python3 .skilled/skills/sk-doc/scripts/validate_skill_package.py [skill_path]/[skill_name]\"\n230:     - \"python3 .skilled/skills/sk-doc/scripts/extract_structure.py [skill_path]/[skill_name]/SKILL.md\"\n231:     doc_only_flows:\n232:     - \"python3 .skilled/skills/sk-doc/scripts/validate_document.py [target_file]\"\n233:     - \"python3 .skilled/skills/sk-doc/scripts/extract_structure.py [target_file]\"\n234:   dqi_policy:\n235:     hard_minimum: 75\n236:     target_by_operation:\n237:       full-create: 90\n238:       full-update: 90\n239:       reference-only: 80\n[Output truncated. Continue reading with offset: 240]"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"limit\": 160, \"offset\": 80, \"path\": \".skilled/commands/create/assets/create-skill-auto.yaml\"}"},"time":{"start":1794669936573,"end":1794669937060}}}}
{"type":"tool_use","timestamp":1794669937163,"sessionID":"ses_e255ff46effe7EWyuOLOEwVdy1","part":{"partID":"prt_1daa9fa26002Opt05pt8ch1cSh","sessionID":"ses_e255ff46effe7EWyuOLOEwVdy1","messageID":"msg_1daa9973c001tgQ1Nb9aIcrFIP","type":"tool","id":"chatcmpl-tool-bd89c1b04f11037e","tool":"shell","state":{"status":"completed","input":{"command":"git show 74d3744e64 -- .skilled/commands/create/assets/create-skill-presentation.txt .skilled/commands/create/sk-skill.md","workdir":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research"},"output":"commit 74d3744e64164596fac74b0f82e33144b220a2e7\nAuthor: Michel Kerkmeester <<redacted>>\nDate:   Fri Nov 13 17:52:46 2026 +0100\n\n    feat(system-skill-advisor): rename the create skill command and offer the doctor helper\n    \n    The command /create:skill is now /create:sk-skill on every runtime, with\n    no alias. A command file named skill.md makes Claude Code read its\n    folder as one skill and hide the other commands in it, an open upstream\n    bug. With the new file name Claude Code lists all 44 tracked commands,\n    up from 32. The mirror check drops its allowlist and fails on a command\n    file named skill.md in any capitalisation. The sk-doc hub moves to\n    2.10.0.0 with a changelog entry that calls out the break.\n    \n    A doctor prompt that says a tool does not show up or appear now counts\n    as a strong problem cue, so the brief names /doctor:helper beside the\n    skills. The idioms \"appear to\" and \"up-to-date\" stay out of the cue.\n    \n    The Gate 2 direct call in AGENTS.md sends the request on stdin, so a\n    prompt never sits in the process table. Its manifest and the Cursor\n    rule carry the same line.\n    \n    Five commands gain intent phrases: four doctor routes and the spec\n    search. On the real embedder, plain holdout reach reads 5 of 44, up\n    from 3, with typed recall and false offers unchanged.\n    \n    A brief-cost run points each hook child's temp folder at its sandbox,\n    so it writes nothing into the shared health log.\n    \n    Floors held: typed recall 24/44, false offers 0/35, scorer eval\n    [160,50,21,5]. Suite: 183 files, 1,758 passed. Doctor tests 1,189,\n    0 failed.\n    \n    Spec: system-skill-advisor/routing-and-scoring/008-command-surfacing-build/016-claude-create-reach-and-doctor-default\n    Commit-Id: 0013878\n\ndiff --git a/.skilled/commands/create/assets/create-skill-presentation.txt b/.skilled/commands/create/assets/create-skill-presentation.txt\nindex 877fd153cd..80719e1174 100644\n--- a/.skilled/commands/create/assets/create-skill-presentation.txt\n+++ b/.skilled/commands/create/assets/create-skill-presentation.txt\n@@ -1,6 +1,6 @@\n-# /create:skill Presentation Contract\n+# /create:sk-skill Presentation Contract\n \n-This file is the single source of truth for user-facing presentation in `/create:skill`: startup questions, setup/status dashboards, operation display, and result templates. The command router owns asset routing only. The workflow YAML owns execution behavior.\n+This file is the single source of truth for user-facing presentation in `/create:sk-skill`: startup questions, setup/status dashboards, operation display, and result templates. The command router owns asset routing only. The workflow YAML owns execution behavior.\n \n ## 1. Phase 0 Verification Display\n \n@@ -25,7 +25,7 @@ Hard-block message:\n \n ```text\n This command requires @markdown for template-first generation and sk-doc validation.\n-Restart with: @markdown /create:skill <skill-name> [operation] [type]\n+Restart with: @markdown /create:sk-skill <skill-name> [operation] [type]\n \n STATUS=FAIL ERROR=\"Markdown agent required\"\n ```\ndiff --git a/.skilled/commands/create/sk-skill.md b/.skilled/commands/create/sk-skill.md\nnew file mode 100644\nindex 0000000000..afb8bcbdfa\n--- /dev/null\n+++ b/.skilled/commands/create/sk-skill.md\n@@ -0,0 +1,72 @@\n+---\n+description: Create or update OpenCode skills via one unified command with operation routing. :auto/:confirm.\n+argument-hint: \"<skill-name> [operation] [type] [--path <dir>] [--chained] [:auto|:confirm]\"\n+allowed-tools: Read, Write, Edit, Bash, Glob, Grep, TodoWrite\n+---\n+\n+# /create:sk-skill Router\n+\n+This command is a thin router. It separates execution routing from user-facing presentation.\n+\n+## 1. ROUTER CONTRACT\n+\n+Route /create:sk-skill to its presentation contract and workflow YAML for creating or updating OpenCode skills through the unified skill command.\n+\n+- Do not split behavior across legacy command definitions.\n+- Do not edit workflow YAML while executing this command.\n+\n+---\n+\n+## 2. OWNED ASSETS\n+\n+| Purpose | Asset |\n+|---------|-------|\n+| Presentation contract | `.skilled/commands/create/assets/create-skill-presentation.txt` |\n+| Auto workflow | `.skilled/commands/create/assets/create-skill-auto.yaml` |\n+| Confirm workflow | `.skilled/commands/create/assets/create-skill-confirm.yaml` |\n+\n+---\n+\n+## 3. MODE ROUTING\n+\n+- If any referenced asset is missing, stop and report the missing path.\n+- The YAML owns workflow behavior; the presentation Markdown owns user-visible wording and layout.\n+\n+1. Read `.skilled/commands/create/assets/create-skill-presentation.txt`.\n+2. Run the presentation contract's Phase 0 verification and setup resolution.\n+3. Resolve operation from setup: `full-create`, `full-update`, `reference-only`, or `asset-only`.\n+4. Resolve execution mode from `$ARGUMENTS` or the setup answer: `:auto` or `:confirm`.\n+5. Load the workflow YAML bound to the resolved mode from the EXECUTION TARGETS table below.\n+6. Execute the selected YAML step by step and route to the resolved operation branch.\n+7. Use the presentation contract, not this router, for user prompts, setup/status dashboards, and final result display.\n+\n+---\n+\n+## 4. EXECUTION TARGETS\n+\n+| Mode | Target |\n+|------|--------|\n+| `:auto` | `.skilled/commands/create/assets/create-skill-auto.yaml` |\n+| `:confirm` or omitted mode | `.skilled/commands/create/assets/create-skill-confirm.yaml` |\n+\n+---\n+\n+## 5. PRESENTATION BOUNDARY\n+\n+The following content lives only in `.skilled/commands/create/assets/create-skill-presentation.txt`:\n+\n+- Startup questions, Phase 0 verification, setup dashboard, operation display, status display, completion template, and next-step text.\n+\n+The router must not invent visible wording for those surfaces; it only resolves operation, execution mode, and workflow selection.\n+\n+---\n+\n+## 6. WORKFLOW SUMMARY\n+\n+The bound workflow YAML (`create-skill-auto.yaml` for `:auto`, `create-skill-confirm.yaml` for `:confirm` or an omitted mode) runs the unified skill workflow step by step after Phase 0 verification and setup resolution, then routes to the resolved `full-create`, `full-update`, `reference-only`, or `asset-only` operation branch to create or update OpenCode skills.\n+`:auto` executes autonomously.\n+`:confirm` runs the same steps as an interactive checkpointed workflow.\n+All user-facing prompts, setup/status dashboards, and result display come from the presentation contract, not this router.\n+\n+Generated routing follows the routing canon: `SMART ROUTING` is 8 to 12 lines of plain prose, every generated skill and mode packet owns a sibling `ROUTER.md` inside its own folder, and that file holds the machine router under a final `## MACHINE ROUTER` heading. The `SKILL.md` links to its sibling router in relative markdown and carries no `## MACHINE ROUTER` section itself. For a hub, that sibling file is the root `ROUTER.md`.\n+\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"commit 74d3744e64164596fac74b0f82e33144b220a2e7\nAuthor: Michel Kerkmeester <<redacted>>\nDate:   Fri Nov 13 17:52:46 2026 +0100\n\n    feat(system-skill-advisor): rename the create skill command and offer the doctor helper\n    \n    The command /create:skill is now /create:sk-skill on every runtime, with\n    no alias. A command file named skill.md makes Claude Code read its\n    folder as one skill and hide the other commands in it, an open upstream\n    bug. With the new file name Claude Code lists all 44 tracked commands,\n    up from 32. The mirror check drops its allowlist and fails on a command\n    file named skill.md in any capitalisation. The sk-doc hub moves to\n    2.10.0.0 with a changelog entry that calls out the break.\n    \n    A doctor prompt that says a tool does not show up or appear now counts\n    as a strong problem cue, so the brief names /doctor:helper beside the\n    skills. The idioms \"appear to\" and \"up-to-date\" stay out of the cue.\n    \n    The Gate 2 direct call in AGENTS.md sends the request on stdin, so a\n    prompt never sits in the process table. Its manifest and the Cursor\n    rule carry the same line.\n    \n    Five commands gain intent phrases: four doctor routes and the spec\n    search. On the real embedder, plain holdout reach reads 5 of 44, up\n    from 3, with typed recall and false offers unchanged.\n    \n    A brief-cost run points each hook child's temp folder at its sandbox,\n    so it writes nothing into the shared health log.\n    \n    Floors held: typed recall 24/44, false offers 0/35, scorer eval\n    [160,50,21,5]. Suite: 183 files, 1,758 passed. Doctor tests 1,189,\n    0 failed.\n    \n    Spec: system-skill-advisor/routing-and-scoring/008-command-surfacing-build/016-claude-create-reach-and-doctor-default\n    Commit-Id: 0013878\n\ndiff --git a/.skilled/commands/create/assets/create-skill-presentation.txt b/.skilled/commands/create/assets/create-skill-presentation.txt\nindex 877fd153cd..80719e1174 100644\n--- a/.skilled/commands/create/assets/create-skill-presentation.txt\n+++ b/.skilled/commands/create/assets/create-skill-presentation.txt\n@@ -1,6 +1,6 @@\n-# /create:skill Presentation Contract\n+# /create:sk-skill Presentation Contract\n \n-This file is the single source of truth for user-facing presentation in `/create:skill`: startup questions, setup/status dashboards, operation display, and result templates. The command router owns asset routing only. The workflow YAML owns execution behavior.\n+This file is the single source of truth for user-facing presentation in `/create:sk-skill`: startup questions, setup/status dashboards, operation display, and result templates. The command router owns asset routing only. The workflow YAML owns execution behavior.\n \n ## 1. Phase 0 Verification Display\n \n@@ -25,7 +25,7 @@ Hard-block message:\n \n ```text\n This command requires @markdown for template-first generation and sk-doc validation.\n-Restart with: @markdown /create:skill <skill-name> [operation] [type]\n+Restart with: @markdown /create:sk-skill <skill-name> [operation] [type]\n \n STATUS=FAIL ERROR=\"Markdown agent required\"\n ```\ndiff --git a/.skilled/commands/create/sk-skill.md b/.skilled/commands/create/sk-skill.md\nnew file mode 100644\nindex 0000000000..afb8bcbdfa\n--- /dev/null\n+++ b/.skilled/commands/create/sk-skill.md\n@@ -0,0 +1,72 @@\n+---\n+description: Create or update OpenCode skills via one unified command with operation routing. :auto/:confirm.\n+argument-hint: \"<skill-name> [operation] [type] [--path <dir>] [--chained] [:auto|:confirm]\"\n+allowed-tools: Read, Write, Edit, Bash, Glob, Grep, TodoWrite\n+---\n+\n+# /create:sk-skill Router\n+\n+This command is a thin router. It separates execution routing from user-facing presentation.\n+\n+## 1. ROUTER CONTRACT\n+\n+Route /create:sk-skill to its presentation contract and workflow YAML for creating or updating OpenCode skills through the unified skill command.\n+\n+- Do not split behavior across legacy command definitions.\n+- Do not edit workflow YAML while executing this command.\n+\n+---\n+\n+## 2. OWNED ASSETS\n+\n+| Purpose | Asset |\n+|---------|-------|\n+| Presentation contract | `.skilled/commands/create/assets/create-skill-presentation.txt` |\n+| Auto workflow | `.skilled/commands/create/assets/create-skill-auto.yaml` |\n+| Confirm workflow | `.skilled/commands/create/assets/create-skill-confirm.yaml` |\n+\n+---\n+\n+## 3. MODE ROUTING\n+\n+- If any referenced asset is missing, stop and report the missing path.\n+- The YAML owns workflow behavior; the presentation Markdown owns user-visible wording and layout.\n+\n+1. Read `.skilled/commands/create/assets/create-skill-presentation.txt`.\n+2. Run the presentation contract's Phase 0 verification and setup resolution.\n+3. Resolve operation from setup: `full-create`, `full-update`, `reference-only`, or `asset-only`.\n+4. Resolve execution mode from `$ARGUMENTS` or the setup answer: `:auto` or `:confirm`.\n+5. Load the workflow YAML bound to the resolved mode from the EXECUTION TARGETS table below.\n+6. Execute the selected YAML step by step and route to the resolved operation branch.\n+7. Use the presentation contract, not this router, for user prompts, setup/status dashboards, and final result display.\n+\n+---\n+\n+## 4. EXECUTION TARGETS\n+\n+| Mode | Target |\n+|------|--------|\n+| `:auto` | `.skilled/commands/create/assets/create-skill-auto.yaml` |\n+| `:confirm` or omitted mode | `.skilled/commands/create/assets/create-skill-confirm.yaml` |\n+\n+---\n+\n+## 5. PRESENTATION BOUNDARY\n+\n+The following content lives only in `.skilled/commands/create/assets/create-skill-presentation.txt`:\n+\n+- Startup questions, Phase 0 verification, setup dashboard, operation display, status display, completion template, and next-step text.\n+\n+The router must not invent visible wording for those surfaces; it only resolves operation, execution mode, and workflow selection.\n+\n+---\n+\n+## 6. WORKFLOW SUMMARY\n+\n+The bound workflow YAML (`create-skill-auto.yaml` for `:auto`, `create-skill-confirm.yaml` for `:confirm` or an omitted mode) runs the unified skill workflow step by step after Phase 0 verification and setup resolution, then routes to the resolved `full-create`, `full-update`, `reference-only`, or `asset-only` operation branch to create or update OpenCode skills.\n+`:auto` executes autonomously.\n+`:confirm` runs the same steps as an interactive checkpointed workflow.\n+All user-facing prompts, setup/status dashboards, and result display come from the presentation contract, not this router.\n+\n+Generated routing follows the routing canon: `SMART ROUTING` is 8 to 12 lines of plain prose, every generated skill and mode packet owns a sibling `ROUTER.md` inside its own folder, and that file holds the machine router under a final `## MACHINE ROUTER` heading. The `SKILL.md` links to its sibling router in relative markdown and carries no `## MACHINE ROUTER` section itself. For a hub, that sibling file is the root `ROUTER.md`.\n+\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\": \"git show 74d3744e64 -- .skilled/commands/create/assets/create-skill-presentation.txt .skilled/commands/create/sk-skill.md\", \"workdir\": \"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research\"}"},"time":{"start":1794669935142,"end":1794669937163}}}}
{"type":"tool_use","timestamp":1794669937284,"sessionID":"ses_e255ff46effe7EWyuOLOEwVdy1","part":{"partID":"prt_1daa9fd5e001p45VHFJrEEgrtC","sessionID":"ses_e255ff46effe7EWyuOLOEwVdy1","messageID":"msg_1daa9973c001tgQ1Nb9aIcrFIP","type":"tool","id":"chatcmpl-tool-b4314c3995a1dfdd","tool":"shell","state":{"status":"completed","input":{"command":"rg -n --hidden --glob '!**/node_modules/**' --glob '!**/.git/**' --glob '!specs/**' --glob '!**/changelog/**' --glob '!**/command-prompts.jsonl' --glob '!**/holdout-prompts.jsonl' '/create:skill\\b' . | head -40","workdir":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research"},"output":"./README.md:859:Use `@context` separately for one-shot retrieval. This parent-nested-skill pattern is the reusable standard behind `/create:skill-parent`.\n./README.md:1217:**`/create:skill-parent`** - parent skill with nested modes\n./README.md:1363:- `convert` prints a plan for a plain agent skill or an older Skilled one and writes only after your yes. It backs each file it overwrites up under `.skilled/skills/.state/doctor-sk-skill/<name>/` first, and stops when the parsed router would change. `--dry-run` ends after the plan. Three follow-ups are asked as their own question: a plain skill's intent phrases, at least eight of them, a description past 130 characters, and a skill with no `allowed-tools` field, whose question offers the list the plan proposes. A hub candidate is refused with `/create:skill-parent` named\n./README.md:1562:- **Add your own surface** with `/create:skill-parent update --surfaces <name>`, which scaffolds and registers it ahead of the Skilled surface\n./.pi/agents/markdown.md:51:- `/create:skill-parent`\n./.pi/agents/markdown.md:204:| `/create:skill-parent` | Parent skill with nested mode packets (hub + registry + N `deep-<mode>` packets + `shared/`, one hub `graph-metadata.json`, root `ROUTER.md` stage-two control document) | `.skilled/skills/sk-doc/sk-create-skill/SKILL.md` and that packet's `ROUTER.md`, which names the parent-skill hub, registry and root-router templates (root `ROUTER.md` two-state authoring) |\n./.pi/agents/markdown.md:296:| `.skilled/skills/sk-doc/sk-create-skill/SKILL.md` | Entry file for `/create:sk-skill` and `/create:skill-parent`; names the skill template and, through the packet's `ROUTER.md`, the root `ROUTER.md` stage-two authoring template |\n./.claude/agents/markdown.md:44:- `/create:skill-parent`\n./.claude/agents/markdown.md:197:| `/create:skill-parent` | Parent skill with nested mode packets (hub + registry + N `deep-<mode>` packets + `shared/`, one hub `graph-metadata.json`, root `ROUTER.md` stage-two control document) | `.skilled/skills/sk-doc/sk-create-skill/SKILL.md` and that packet's `ROUTER.md`, which names the parent-skill hub, registry and root-router templates (root `ROUTER.md` two-state authoring) |\n./.claude/agents/markdown.md:289:| `.skilled/skills/sk-doc/sk-create-skill/SKILL.md` | Entry file for `/create:sk-skill` and `/create:skill-parent`; names the skill template and, through the packet's `ROUTER.md`, the root `ROUTER.md` stage-two authoring template |\n./.skilled/commands/create/assets/create-skill-parent-auto.yaml:5:# Entrypoint: /create:skill-parent\n./.skilled/commands/create/assets/create-skill-parent-confirm.yaml:5:# Entrypoint: /create:skill-parent\n./CONTRIBUTING.md:198:| **Medium** | New skills | Scaffold with `/create:sk-skill`, or `/create:skill-parent` for a skill with nested modes |\n./.skilled/commands/doctor/assets/doctor-sk-skill-convert.yaml:98:    next: \"/create:skill-parent <the parent skill folder>\"\n./.skilled/commands/doctor/assets/doctor-sk-skill-convert.yaml:101:    next: \"/create:skill-parent <the parent skill folder>\"\n./.skilled/commands/doctor/assets/doctor-sk-skill-convert.yaml:104:    next: \"/create:skill-parent <the parent skill folder>\"\n./.skilled/commands/doctor/assets/doctor-sk-skill-convert.yaml:116:    next: \"Read the check input kind; a plain skill converts from an outside path, and a hub belongs to /create:skill-parent.\"\n./.skilled/commands/doctor/assets/doctor-sk-skill-convert.yaml:214:      - \"Exit 1 with any other code is a refusal: print REFUSE: with the reason the refusals list carries for that code, then STATUS=FAIL ERROR=\\\"<code>\\\", and stop. Do not offer to force, retry at another path, or edit the target by hand. A refusal whose next entry names /create:skill-parent also prints that line, because a hub belongs there. A code the list does not carry still prints the engine's own message and STATUS=FAIL ERROR=\\\"<code>\\\".\"\n./.skilled/commands/create/assets/create-skill-parent-presentation.txt:1:# /create:skill-parent Presentation Contract\n./.skilled/commands/create/assets/create-skill-parent-presentation.txt:3:This file is the single source of truth for user-facing presentation in `/create:skill-parent`: startup questions, setup/status dashboards, and result display. The command router owns asset routing only. The workflow YAML owns execution behavior.\n./.skilled/commands/create/assets/create-skill-parent-presentation.txt:30:Restart with: @markdown /create:skill-parent <skill-name> [create|update]\n./.codex/agents/markdown.toml:47:- `/create:skill-parent`\n./.codex/agents/markdown.toml:200:| `/create:skill-parent` | Parent skill with nested mode packets (hub + registry + N `deep-<mode>` packets + `shared/`, one hub `graph-metadata.json`, root `ROUTER.md` stage-two control document) | `.skilled/skills/sk-doc/sk-create-skill/SKILL.md` and that packet's `ROUTER.md`, which names the parent-skill hub, registry and root-router templates (root `ROUTER.md` two-state authoring) |\n./.codex/agents/markdown.toml:292:| `.skilled/skills/sk-doc/sk-create-skill/SKILL.md` | Entry file for `/create:sk-skill` and `/create:skill-parent`; names the skill template and, through the packet's `ROUTER.md`, the root `ROUTER.md` stage-two authoring template |\n./.skilled/commands/create/README.txt:58:| **skill-parent** | `/create:skill-parent <skill-name> [create\\|update] [--modes <m1,m2,...>] [--surfaces <s1,s2,...>] [--path <dir>] [:auto\\|:confirm]` | Scaffold a parent skill with nested mode packets (one hub identity, `mode-registry.json` source of truth, and a root `ROUTER.md` stage-two control document) |\n./.skilled/commands/create/README.txt:89:├── skill-parent.md               # /create:skill-parent command\n./.skilled/commands/create/README.txt:140:/create:skill-parent my-loop-workflows create --modes research,review,ai-council :confirm\n./.skilled/commands/create/skill-parent.md:7:# /create:skill-parent Router\n./.skilled/commands/create/skill-parent.md:13:Route /create:skill-parent to its presentation contract and workflow YAML for scaffolding or updating a parent skill with nested mode packets.\n./.skilled/commands/create/skill-parent.md:15:- This command is the canonical `/create:skill-parent` entrypoint.\n./.skilled/agents/markdown.md:58:- `/create:skill-parent`\n./.skilled/agents/markdown.md:211:| `/create:skill-parent` | Parent skill with nested mode packets (hub + registry + N `deep-<mode>` packets + `shared/`, one hub `graph-metadata.json`, root `ROUTER.md` stage-two control document) | `.skilled/skills/sk-doc/sk-create-skill/SKILL.md` and that packet's `ROUTER.md`, which names the parent-skill hub, registry and root-router templates (root `ROUTER.md` two-state authoring) |\n./.skilled/agents/markdown.md:303:| `.skilled/skills/sk-doc/sk-create-skill/SKILL.md` | Entry file for `/create:sk-skill` and `/create:skill-parent`; names the skill template and, through the packet's `ROUTER.md`, the root `ROUTER.md` stage-two authoring template |\n./.dsh/agents/markdown.patch.yml:42:      - `/create:skill-parent`\n./.dsh/agents/markdown.patch.yml:195:      | `/create:skill-parent` | Parent skill with nested mode packets (hub + registry + N `deep-<mode>` packets + `shared/`, one hub `graph-metadata.json`, root `ROUTER.md` stage-two control document) | `.skilled/skills/sk-doc/sk-creat