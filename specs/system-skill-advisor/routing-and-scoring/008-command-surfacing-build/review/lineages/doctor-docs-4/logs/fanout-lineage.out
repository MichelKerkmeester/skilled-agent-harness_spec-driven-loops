reate-sk-skill.md\\\", \\\".cursor/commands/create-sk-skill.md\\\", \\\".pi/prompts/create-sk-skill.md\\\", \\\".dsh/prompts/create-sk-skill.md\\\"],\\n      \\\"bugClass\\\": \\\"cross_runtime_parity\\\",\\n      \\\"hypothesis\\\": \\\"The create rename or the changed wording may diverge on one of the six runtimes.\\\",\\n      \\\"searchActions\\\": [\\n        {\\\"method\\\": \\\"direct_read\\\", \\\"queryOrPath\\\": \\\"ls -l of the five command mirrors and .devin listing\\\", \\\"result\\\": \\\"Claude and Cursor are symlinks to the canonical file; Codex, Pi and DSH are generated at the new name; Devin has no command mirror.\\\", \\\"evidenceRefs\\\": [\\\".claude/commands/create/sk-skill.md\\\", \\\".cursor/commands/create-sk-skill.md\\\", \\\".codex/prompts/create-sk-skill.md\\\", \\\".pi/prompts/create-sk-skill.md\\\", \\\".dsh/prompts/create-sk-skill.md\\\", \\\".devin/config.json\\\"]},\\n        {\\\"method\\\": \\\"exact_search\\\", \\\"queryOrPath\\\": \\\"rg --hidden -F 'create:skill' .claude .codex .cursor .pi .dsh .devin .opencode\\\", \\\"result\\\": \\\"only /create:skill-parent matches; no old command file remains.\\\", \\\"evidenceRefs\\\": [\\\".claude/agents/markdown.md\\\", \\\".codex/agents/markdown.toml\\\"]}\\n      ],\\n      \\\"disposition\\\": \\\"ruled_out\\\",\\n      \\\"ruledOutReason\\\": \\\"The renamed command is consistent on every runtime that carries commands, and the changed presentation is runtime-neutral.\\\",\\n      \\\"rationale\\\": \\\"No cross-runtime divergence.\\\"\\n    },\\n    {\\n      \\\"id\\\": \\\"SL-010\\\",\\n      \\\"dimension\\\": \\\"traceability\\\",\\n      \\\"targetRefs\\\": [\\\".skilled/commands/doctor/assets/doctor-agents-md-presentation.txt:267\\\"],\\n      \\\"bugClass\\\": \\\"docs_code_divergence\\\",\\n      \\\"hypothesis\\\": \\\"The A11 repair mapping still has no specific repair for a malformed-row finding.\\\",\\n      \\\"searchActions\\\": [\\n        {\\\"method\\\": \\\"direct_read\\\", \\\"queryOrPath\\\": \\\"doctor-agents-md-presentation.txt:258-283 and agents-md-embed.cjs:782-804\\\", \\\"result\\\": \\\"the A11 row covers missing rows only; embed only adds missing rows; the generic FINDING row is the fallback.\\\", \\\"evidenceRefs\\\": [\\\"doctor-agents-md-presentation.txt:262\\\", \\\"doctor-agents-md-presentation.txt:267\\\", \\\"agents-md-embed.cjs:794\\\"]},\\n        {\\\"method\\\": \\\"exact_search\\\", \\\"queryOrPath\\\": \\\"rg for malformed A11 repairs across the doctor docs and playbooks\\\", \\\"result\\\": \\\"no other document names a malformed-row repair.\\\", \\\"evidenceRefs\\\": [\\\".skilled/manual-testing-playbook/doctor-commands/doctor-agents-md-check.md:30\\\"]}\\n      ],\\n      \\\"disposition\\\": \\\"finding\\\",\\n      \\\"linkedFindingId\\\": \\\"DR4-P2-001\\\",\\n      \\\"rationale\\\": \\\"The carried advisory remains; no new severity.\\\"\\n    },\\n    {\\n      \\\"id\\\": \\\"SL-011\\\",\\n      \\\"dimension\\\": \\\"correctness\\\",\\n      \\\"targetRefs\\\": [\\\".skilled/commands/doctor/scripts/agents-md-check.cjs:798-809\\\"],\\n      \\\"bugClass\\\": \\\"behavioral_contract\\\",\\n      \\\"hypothesis\\\": \\\"The malformed count may be wrong after the security pass re-read.\\\",\\n      \\\"searchActions\\\": [\\n        {\\\"method\\\": \\\"direct_read\\\", \\\"queryOrPath\\\": \\\"agents-md-check.cjs:772-809\\\", \\\"result\\\": \\\"lines still holds each missing entry once and each malformed row once; the subtraction is unchanged.\\\", \\\"evidenceRefs\\\": [\\\"agents-md-check.cjs:798-809\\\"]}\\n      ],\\n      \\\"disposition\\\": \\\"ruled_out\\\",\\n      \\\"ruledOutReason\\\": \\\"The count arithmetic is unchanged and the malformed row keeps its rule path in the test.\\\",\\n      \\\"rationale\\\": \\\"No new behavioral-contract issue.\\\"\\n    },\\n    {\\n      \\\"id\\\": \\\"SL-012\\\",\\n      \\\"dimension\\\": \\\"security\\\",\\n      \\\"targetRefs\\\": [\\\".skilled/commands/doctor/_routes.yaml:396-406,797-806\\\"],\\n      \\\"bugClass\\\": \\\"holdout_leakage\\\",\\n      \\\"hypothesis\\\": \\\"The pass could read a holdout prompt while checking the phrase removal.\\\",\\n      \\\"searchActions\\\": [\\n        {\\\"method\\\": \\\"exact_search\\\", \\\"queryOrPath\\\": \\\"rg with both prompt corpora excluded\\\", \\\"result\\\": \\\"no prompt corpus opened; the commit body reports the holdout count only.\\\", \\\"evidenceRefs\\\": [\\\"a494145dd0 commit body\\\", \\\"review-brief-4.txt:1\\\"]}\\n      ],\\n      \\\"disposition\\\": \\\"ruled_out\\\",\\n      \\\"ruledOutReason\\\": \\\"No command-prompts.jsonl or holdout-prompts.jsonl read occurred.\\\",\\n      \\\"rationale\\\": \\\"Holdout hygiene held.\\\"\\n    },\\n    {\\n      \\\"id\\\": \\\"SL-013\\\",\\n      \\\"dimension\\\": \\\"traceability\\\",\\n      \\\"targetRefs\\\": [\\\".skilled/skills/system-skill-advisor/feature-catalog/scorer-fusion/doctor-command-routing.md:27-39\\\"],\\n      \\\"bugClass\\\": \\\"feature_catalog_drift\\\",\\n      \\\"hypothesis\\\": \\\"The catalog may claim a policy or reach rule the generated data no longer holds.\\\",\\n      \\\"searchActions\\\": [\\n        {\\\"method\\\": \\\"direct_read\\\", \\\"queryOrPath\\\": \\\"doctor-command-routing.md:27-39\\\", \\\"result\\\": \\\"the catalog's ask/run/readOnly and three-word reach claims match the deriver and generated data.\\\", \\\"evidenceRefs\\\": [\\\"doctor-command-routing.md:27-39\\\"]}\\n      ],\\n      \\\"disposition\\\": \\\"ruled_out\\\",\\n      \\\"ruledOutReason\\\": \\\"The catalog claims match the generated policy and reach-probe behavior.\\\",\\n      \\\"rationale\\\": \\\"No catalog drift.\\\"\\n    }\\n  ],\\n  \\\"graphEvents\\\": [\\n    {\\\"type\\\": \\\"node\\\", \\\"id\\\": \\\"file:doctor-routes\\\", \\\"kind\\\": \\\"FILE\\\", \\\"label\\\": \\\"doctor route manifest\\\"},\\n    {\\\"type\\\": \\\"node\\\", \\\"id\\\": \\\"file:command-attach\\\", \\\"kind\\\": \\\"FILE\\\", \\\"label\\\": \\\"command attach guard\\\"},\\n    {\\\"type\\\": \\\"node\\\", \\\"id\\\": \\\"evidence:doctor-policy-ask\\\", \\\"kind\\\": \\\"EVIDENCE\\\", \\\"label\\\": \\\"mutating doctor routes derive ask\\\"},\\n    {\\\"type\\\": \\\"node\\\", \\\"id\\\": \\\"evidence:refusal-question-guards\\\", \\\"kind\\\": \\\"EVIDENCE\\\", \\\"label\\\": \\\"refusal and question attach guards\\\"},\\n    {\\\"type\\\": \\\"edge\\\", \\\"id\\\": \\\"edge:policy-routes\\\", \\\"source\\\": \\\"evidence:doctor-policy-ask\\\", \\\"target\\\": \\\"file:doctor-routes\\\", \\\"relation\\\": \\\"EVIDENCE_FOR\\\"},\\n    {\\\"type\\\": \\\"edge\\\", \\\"id\\\": \\\"edge:guards-attach\\\", \\\"source\\\": \\\"evidence:refusal-question-guards\\\", \\\"target\\\": \\\"file:command-attach\\\", \\\"relation\\\": \\\"EVIDENCE_FOR\\\"}\\n  ]\\n}\\n\", \"path\": \"specs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/review/lineages/doctor-docs-4/prompts/iteration-002.record.json\"}"},"time":{"start":1794671146874,"end":1794671199096}}}}
