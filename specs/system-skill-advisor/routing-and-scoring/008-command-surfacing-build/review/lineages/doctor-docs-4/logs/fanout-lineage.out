{"type":"tool_use","timestamp":1794669637346,"sessionID":"ses_e255ff46effe7EWyuOLOEwVdy1","part":{"partID":"prt_1daa56e360017GvhM6pQgcnCUH","sessionID":"ses_e255ff46effe7EWyuOLOEwVdy1","messageID":"msg_1daa51fcd001ZB6DynV0P4Bzbr","type":"tool","id":"call_706cf7b0a2604997b7c0f93a","tool":"read","state":{"status":"completed","input":{"limit":270,"offset":480,"path":".skilled/commands/doctor/_routes.yaml"},"output":"Read file .skilled/commands/doctor/_routes.yaml, lines 480-749\n480: \n481:   - command: /doctor:helper\n482:     target: helper\n483:     yaml: doctor-helper.yaml\n484:     setup_vars: [execution_mode, problem_text, json_output, area, intent]\n485:     allowed_flags: [\"--json\"]\n486:     mutating: read-only\n487:     gate3_location: \"n/a (read-only matcher; it ranks the manifest, runs a read-only pick under that command's own router and prints a writing pick as one line for the operator)\"\n488:     mcp_tools: []   # no MCP calls and no background service; one script reads one YAML file\n489:     script_invocations:\n490:       - 'node .skilled/commands/doctor/scripts/doctor-helper-match.cjs --json -- \"<problem text>\"  # also --table and --areas; the matcher reads the manifest and writes nothing'\n491:     trigger_phrases:\n492:       - \"which doctor command should I run\"\n493:       - \"find the right doctor command\"\n494:       - \"what doctor command fixes this\"\n495:       - \"which doctor command fits my problem\"\n496: \n497:   - command: /doctor:sk-skill\n498:     target: convert\n499:     yaml: doctor-sk-skill-convert.yaml\n500:     setup_vars: [execution_mode, skill_target, dry_run, scratch_dir]\n501:     allowed_flags: [\"--dry-run\"]\n502:     mutating: mutates\n503:     gate3_location: \"the staged or converted skill folder .skilled/skills/<name>/ (its SKILL.md, ROUTER.md, graph-metadata.json, leaf-manifest.config.json, scaffold files and renamed resources, or an in-place SKILL.md rewrite beside a new sibling ROUTER.md and the approved edge in its own graph-metadata.json), its backups under .skilled/skills/.state/doctor-sk-skill/<name>/<timestamp>/, the one scratch root the plain-skill path uses beside them at .skilled/skills/.state/doctor-sk-skill/<name>/scratch/ and deletes, the skill's changelog folder with its .skilled/changelog/<name> link, and the integration targets the plan records: the advisor graph .skilled/skills/system-skill-advisor/runtime/database/skill-graph.sqlite, the compiled skill-graph.json and the advisor cases file\"\n504:     mcp_tools: []   # script-only; no MCP calls\n505:     script_invocations:\n506:       - 'node .skilled/commands/doctor/scripts/sk-skill-convert.cjs plan \"{skill_target}\"  # read-only: resolves the target, classifies the input and prints the plan, the follow-ups and the backup folder; a plain skill refuses here until its intent phrases are approved'\n507:       - 'node .skilled/commands/doctor/scripts/sk-skill-convert.cjs apply \"{skill_target}\" <the approved flags>  # the plan rerun: the same call without the write switch prints the plan and writes nothing, so the workflow reruns with repeated --approved-phrase, --description-trim, --allowed-tools, --edge and --agent-output and shows that plan'\n508:       - 'node .skilled/commands/doctor/scripts/sk-skill-convert.cjs preserve --snapshot \"{scratch_dir}/snapshot\" \"{scratch_dir}/staging\"  # read-only: proves the agent-produced prose kept every original body line before the format gate, from the one scratch root'\n509:       - 'node .skilled/commands/doctor/scripts/sk-skill-convert.cjs apply \"{skill_target}\" --apply  # the same plan, then the backup and the writes; the workflow adds the approved --approved-phrase, --description-trim, --allowed-tools, --edge and --agent-output flags and runs it only after an explicit yes'\n510:       - 'node .skilled/commands/doctor/scripts/sk-skill-check.cjs .skilled/skills/<name> --json  # the post-write re-read through the read-only check engine, at the converted root: the staged root for a plain skill, the skill folder for an in-place conversion'\n511:     trigger_phrases:\n512:       - \"convert a skill to the skilled format\"\n513:       - \"convert a plain agent skill\"\n514:       - \"turn my old skill into a skilled skill\"\n515:       - \"skill format conversion plan\"\n516:       - \"move the machine router out of a skill\"\n517:       - \"skill folder conversion with a backup\"\n518: \n519:   - command: /doctor:agents-md\n520:     target: check\n521:     default_target: true\n522:     yaml: doctor-agents-md-check.yaml\n523:     setup_vars: [execution_mode, root, json_output]\n524:     allowed_flags: [\"--json\", \"--root <dir>\"]\n525:     mutating: read-only\n526:     gate3_location: \"n/a (read-only diagnostic; the engine reads the root instruction file, its runtime copies and its REPO RULES.md and writes nothing)\"\n527:     mcp_tools: []   # script-only; no MCP calls\n528:     script_invocations:\n529:       - 'node .skilled/commands/doctor/scripts/agents-md-check.cjs  # the workflow adds --root <dir> and --json only when the operator passed them'\n530:     trigger_phrases:\n531:       - \"check the shipped agents instruction file\"\n532:       - \"agents md section check\"\n533:       - \"which agents md sections are stale\"\n534:       - \"agents md delivery budget report\"\n535:       - \"agents md template drift report\"\n536: \n537:   - command: /doctor:agents-md\n538:     target: embed\n539:     yaml: doctor-agents-md-embed.yaml\n540:     setup_vars: [execution_mode, root, dry_run, plan_digest, digest_confirmation, keep_claude_md, create_router]\n541:     allowed_flags: [\"--dry-run\", \"--root <dir>\", \"--plan-digest <digest>\", \"--keep-claude-md\", \"--remove-claude-md\", \"--create-router\"]\n542:     mutating: mutates\n543:     gate3_location: \"AGENTS.md (created when absent, replaced with the shipped sections plus the composed block), CLAUDE.md and .codex/AGENTS.md (folded into the block and removed, unless --keep-claude-md), .cursor/rules/repo-local.md (the generated mirror of a non-empty block) and REPO RULES.md (missing shipped rows appended, or the file created behind --create-router), with a copy of every touched path taken to the plan's backup folder, .skilled/output/doctor-agents-md/<first 16 characters of the plan digest>/ or the folder of that name under the operating system's temporary directory when git does not ignore that path, before the first byte, and .cursor/rules/skill-routing.md rewritten by the pointer generator the engine calls; the write runs only against the plan digest the operator approved\"\n544:     mcp_tools: []   # script-only; no MCP calls\n545:     script_invocations:\n546:       - 'node .skilled/commands/doctor/scripts/agents-md-embed.cjs plan  # read-only: composes every target in memory and prints the targets, the diffs, the block, the budget, the preservation ledger, the backup folder and the plan digest; the workflow adds --root <dir>, --keep-claude-md, --create-router and --dry-run only when the operator passed them'\n547:       - 'node .skilled/commands/doctor/scripts/agents-md-embed.cjs apply --plan-digest <digest>  # recomposes, refuses a digest that no longer matches, backs up, writes only inside its own allowlist and proves the composition against the bytes on disk; the workflow runs it only after the operator approves the plan that printed that digest'\n548:       - 'node .skilled/commands/doctor/scripts/agents-md-check.cjs  # the post-write re-read of the written repository; the workflow adds --root <dir> only when this run was pointed at another repository'\n549:     trigger_phrases:\n550:       - \"embed the shipped instructions into agents md\"\n551:       - \"add the agents md repository block\"\n552:       - \"fold claude md into agents md\"\n553:       - \"write the agents md repository block\"\n554:       - \"replace agents md with the shipped template\"\n555:       - \"update agents md from the shipped template\"\n556:       - \"embed the shipped agents md sections\"\n557:       - \"embed the shipped AGENTS.md sections\"\n558: \n559:   - command: /doctor:agents-md\n560:     target: restore\n561:     yaml: doctor-agents-md-restore.yaml\n562:     setup_vars: [execution_mode, run_dir, yes, dry_run]\n563:     allowed_flags: [\"--run <dir>\", \"--yes\", \"--dry-run\"]\n564:     mutating: mutates\n565:     gate3_location: \"the paths one run's own manifest.json under its backup directory records, each one re-checked against the engine's write allowlist before it is touched: a recorded file is copied back from its copy and a path the recorded run created (an AGENTS.md, CLAUDE.md, .codex/AGENTS.md, .cursor/rules/repo-local.md or REPO RULES.md it created) is removed along with each folder the run created for it that is empty again, and the backup directory itself is read and kept\"\n566:     mcp_tools: []   # script-only; no MCP calls\n567:     script_invocations:\n568:       - 'node .skilled/commands/doctor/scripts/agents-md-embed.cjs restore --run=<dir> --dry-run  # prints the restore plan the record and its copies describe and writes nothing'\n569:       - 'node .skilled/commands/doctor/scripts/agents-md-embed.cjs restore --run=<dir> --yes  # puts the recorded paths back and checks every restored file against its recorded hash; the workflow passes --yes only after its own yes'\n570:       - 'node .skilled/commands/doctor/scripts/agents-md-check.cjs  # the post-restore re-read of the restored repository, adding --root <the recorded root> when that root is not this repository'\n571:     trigger_phrases:\n572:       - \"undo an agents md embed run\"\n573:       - \"restore agents md from the backup\"\n574:       - \"roll back the agents md instruction file write\"\n575:       - \"revert agents md to the file before the embed\"\n576: \n577:   - command: /doctor:symlink\n578:     target: check\n579:     default_target: true\n580:     yaml: doctor-symlink-check.yaml\n581:     setup_vars: [execution_mode, root, runtimes, include, link_instructions, json_output]\n582:     allowed_flags: [\"--json\", \"--root <dir>\", \"--runtimes <list>\", \"--include <list>\", \"--link-instructions\"]\n583:     mutating: read-only\n584:     gate3_location: \"n/a (read-only diagnostic; the engine classifies every framework entry in the target repository and writes nothing)\"\n585:     mcp_tools: []   # script-only; no MCP calls\n586:     script_invocations:\n587:       - 'node .skilled/commands/doctor/scripts/symlink-engine.cjs check --root <dir>  # the workflow adds --runtimes, --include, --link-instructions and --json only when the operator passed them'\n588:     trigger_phrases:\n589:       - \"check skilled symlinks in a repo\"\n590:       - \"find broken skilled symlinks\"\n591:       - \"which runtime folders are linked\"\n592:       - \"is skilled linked into my project\"\n593:       - \"the skilled links are broken\"\n594:       - \"broken skilled links in my project\"\n595:       - \"skilled links in my project\"\n596: \n597:   - command: /doctor:symlink\n598:     target: link\n599:     yaml: doctor-symlink-link.yaml\n600:     setup_vars: [execution_mode, root, runtimes, mode, include, link_instructions, ignore, dry_run, plan_digest, digest_confirmation]\n601:     allowed_flags: [\"--root <dir>\", \"--runtimes <list>\", \"--mode <shape>\", \"--include <list>\", \"--link-instructions\", \"--ignore <where>\", \"--dry-run\", \"--plan-digest <digest>\"]\n602:     mutating: mutates\n603:     gate3_location: \"the target repository's framework links (whole-folder links, or real folders holding one link per entry), the broken links into the Skilled checkout that the plan replaces or removes, and the ignore lines in <git-dir>/info/exclude (or .gitignore behind --ignore gitignore), with the run record written to the checkout's .skilled/output/doctor-symlink/<first 16 hex of the digest>/manifest.json, or the next free <prefix>-2, <prefix>-3 folder when an earlier run holds it, before the first action; no real file or folder is ever overwritten, and the write runs only against the plan digest the operator approved\"\n604:     mcp_tools: []   # script-only; no MCP calls\n605:     script_invocations:\n606:       - 'node .skilled/commands/doctor/scripts/symlink-engine.cjs plan --root <dir>  # read-only: prints every action, every refusal and the plan digest; the workflow adds --runtimes, --mode, --include, --link-instructions and --ignore only when the operator passed them'\n607:       - 'node .skilled/commands/doctor/scripts/symlink-engine.cjs apply --root <dir> --plan-digest <digest>  # recomposes with the same flags, refuses a digest that no longer matches, records the run, applies the actions and reruns check; the workflow runs it only after the operator approves the plan that printed that digest'\n608:     trigger_phrases:\n609:       - \"symlink skilled into my project\"\n610:       - \"link the claude folder into my repo\"\n611:       - \"repair broken skilled symlinks\"\n612:       - \"create the skilled links in a repo\"\n613:       - \"link skilled into my repo\"\n614:       - \"link skilled into another project\"\n615:       - \"link my skilled checkout into another project\"\n616: \n617:   - command: /doctor:symlink\n618:     target: unlink\n619:     yaml: doctor-symlink-unlink.yaml\n620:     setup_vars: [execution_mode, run_dir, yes, dry_run]\n621:     allowed_flags: [\"--run <dir>\", \"--yes\", \"--dry-run\"]\n622:     mutating: mutates\n623:     gate3_location: \"only the links, the folders and the ignore lines one run's manifest.json records, each re-checked against the recorded state before it is touched; a path that changed since the apply is skipped and reported, and the run directory itself is read and kept\"\n624:     mcp_tools: []   # script-only; no MCP calls\n625:     script_invocations:\n626:       - 'node .skilled/commands/doctor/scripts/symlink-engine.cjs unlink --run <dir> --dry-run  # prints what the unlink would remove or restore and writes nothing'\n627:       - 'node .skilled/commands/doctor/scripts/symlink-engine.cjs unlink --run <dir> --yes  # removes the recorded links and empty folders and the recorded ignore lines; the workflow passes --yes only after its own yes'\n628:     trigger_phrases:\n629:       - \"undo a skilled symlink run\"\n630:       - \"remove the skilled symlinks again\"\n631:       - \"unlink skilled from my project\"\n632: \n633:   - command: /doctor:install\n634:     target: guide\n635:     yaml: doctor-install.yaml\n636:     setup_vars: [execution_mode, root, runtimes, json_output]\n637:     allowed_flags: [\"--json\", \"--root <dir>\", \"--runtimes <list>\"]\n638:     mutating: read-only\n639:     gate3_location: \"n/a (read-only guide; it checks the two builds, runs the symlink engine's check once and prints the ordered writing commands for the operator to run)\"\n640:     mcp_tools: []   # script-only; no MCP calls\n641:     script_invocations:\n642:       - 'test -d .skilled/skills/system-spec-kit/runtime/dist  # the spec-kit build the session hooks load'\n643:       - 'node .skilled/bin/skill-advisor.cjs list-tools --format json  # the advisor build; exit 0 means built'\n644:       - 'node .skilled/commands/doctor/scripts/symlink-engine.cjs check --root <dir>  # the workflow adds --runtimes and --link-instructions only when the operator chose them'\n645:     trigger_phrases:\n646:       - \"install skilled into my project\"\n647:       - \"set up skilled in another repo\"\n648:       - \"use skilled in my own project\"\n649:       - \"onboard a project repo to skilled\"\n650:       - \"guide me through installing skilled\"\n651:       - \"walk me through a first install of skilled\"\n652:       - \"first install of skilled in my project\"\n653:       - \"skilled in my other repository\"\n654:       - \"skilled in another repository\"\n655:       - \"walk me through adding this toolkit to my own project repository\"\n656:       - \"put this toolkit into my own project repository\"\n657:       - \"use this toolkit in my own project\"\n658:       - \"install this toolkit into another repository\"\n659:       - \"onboard this project repository\"\n660: \n661:   - command: /doctor:overlay\n662:     target: status\n663:     default_target: true\n664:     yaml: doctor-overlay-status.yaml\n665:     setup_vars: [execution_mode, root, json_output, audit_output]\n666:     allowed_flags: [\"--json\", \"--audit\", \"--root <dir>\"]\n667:     mutating: read-only\n668:     gate3_location: \"n/a (read-only diagnostic; the engine classifies every overlay destination in the vendored tree, runs the overlay manifest's read-only verify checks and writes nothing)\"\n669:     mcp_tools: []   # script-only; no MCP calls\n670:     script_invocations:\n671:       - 'node .skilled/commands/doctor/scripts/overlay-engine.cjs status  # exit 0 = in sync, 1 = something out of sync, 2 = a failed precondition; the workflow adds --root <dir>, --json and --audit only when the operator passed them, and --audit prints one AUDIT line per unowned path that differs from upstream at the pin, is missing from the tree or is tracked there and never upstream, then the audit count. A finding fails the status'\n672:     trigger_phrases:\n673:       - \"check my vendored skilled overlays\"\n674:       - \"are my skilled overlays in sync\"\n675:       - \"which overlay destinations are out of sync\"\n676:       - \"vendored skilled overlay status\"\n677:       - \"does my vendored skilled tree still carry its overlays\"\n678:       - \"vendored skilled overlays out of sync\"\n679:       - \"does my vendored skilled copy still carry its overlays\"\n680:       - \"adopt the skilled overlay engine in my project\"\n681:       - \"migrate my own overlay folder to doctor overlay\"\n682:       - \"check whether my overlay sources sit on their layout path\"\n683:       - \"audit my vendored skilled tree for unowned files\"\n684:       - \"which root files my overlays own drifted upstream at the pinned commit\"\n685:       - \"we copy skilled into our repo and lose our edits on update\"\n686:       - \"agents overlay stale after a re-pin\"\n687:       - \"which overlay do I rebase\"\n688:       - \"rebase the overlay\"\n689: \n690:   - command: /doctor:overlay\n691:     target: apply\n692:     yaml: doctor-overlay-apply.yaml\n693:     setup_vars: [execution_mode, root, capture_path, adopt_path, relayout]\n694:     allowed_flags: [\"--root <dir>\", \"--capture <path>\", \"--adopt <path>\", \"--relayout\"]\n695:     mutating: mutates\n696:     gate3_location: \"the overlay destinations and layout links the overlay manifest names inside the vendored tree, the outputs of the manifest's regenerate steps, and <overlay folder>/sync-state.json, all under the engine's own <overlay folder>/.build-lock; with --capture <path>, only the one overlay source that path maps to plus sync-state.json; with --adopt <path>, the copy of that vendored path in the overlay folder and one new entry in <overlay folder>/overlay-manifest.json, followed by the same apply; with --relayout, the overlay sources the manifest keeps off their layout paths, moved inside the overlay folder to the same path with the leading dot dropped, the layout-link targets that reach them, the source, fragment and base fields of <overlay folder>/overlay-manifest.json, and the backup in <overlay folder>/relayout-runs/<stamp>/, followed by the same apply; the write runs only after the operator approved the status report this run printed, or the LAYOUT lines in it when --relayout carries the run\"\n697:     mcp_tools: []   # script-only; no MCP calls\n698:     script_invocations:\n699:       - 'node .skilled/commands/doctor/scripts/overlay-engine.cjs status  # read-only: the report the run shows as its plan before the question, and the re-read after the write'\n700:       - 'node .skilled/commands/doctor/scripts/overlay-engine.cjs apply  # applies every overlay under the engine lock, then regenerates and verifies; writes nothing while a destination is live-edited, both-changed or upstream-moved; run only after the apply yes'\n701:       - 'node .skilled/commands/doctor/scripts/overlay-engine.cjs apply --capture <path>  # moves one live edit into its overlay source; run only after the capture yes'\n702:       - 'node .skilled/commands/doctor/scripts/overlay-engine.cjs apply --adopt <path>  # copies one unowned vendored path into the overlay folder, appends its manifest entry and applies; exit 0 = adopted and applied, 1 = the apply was blocked, 2 = a refusal with nothing written; run only after the adopt yes'\n703:       - 'node .skilled/commands/doctor/scripts/overlay-engine.cjs apply --relayout  # moves every off-layout copy onto its layout path under the engine lock, backs up what it leaves in relayout-runs/, points the manifest fields and layout links there, retargets each live link that named a moved copy with its relinked line, and prints one moved line per path, then names the apply that follows; exit 0 = done, 2 = a refusal with nothing written, such as a target that already exists; run only after the relayout yes, followed by apply'\n704:     trigger_phrases:\n705:       - \"apply the skilled overlays\"\n706:       - \"put my overlays back into vendored skilled\"\n707:       - \"capture a live edit into its overlay\"\n708:       - \"reapply overlays after copying skilled\"\n709:       - \"apply the overlays back onto the vendored copy\"\n710:       - \"put the overlays back on vendored skilled\"\n711:       - \"move my overlay sources onto the layout folder\"\n712:       - \"take over the overlay lock a dead run left behind\"\n713: \n714:   - command: /doctor:overlay\n715:     target: repin\n716:     yaml: doctor-overlay-repin.yaml\n717:     setup_vars: [execution_mode, root, upstream, to_commit, rollback_run_id]\n718:     allowed_flags: [\"--root <dir>\", \"--upstream <dir>\", \"--to <commit>\", \"--rollback <run-id>\"]\n719:     mutating: mutates\n720:     gate3_location: \"inside the vendored tree, the .skilled paths upstream added, changed or deleted between the pin the overlay manifest records and --to, plus each runtime folder whole, less the manifest's repin.exclude list and never a root file such as AGENTS.md; the manifest's pin, set to --to; the overlay destinations, layout links, regenerate outputs and <overlay folder>/sync-state.json the apply that follows writes; and the backup in <overlay folder>/repin-runs/<run-id>/, written before the first copy; all under the engine's own <overlay folder>/.build-lock; with --rollback <run-id>, only the paths that run's backup records, restored byte for byte, and the files that run created, removed; the --stage plan writes only a fresh temporary folder outside the tree, and the live write runs only after the operator approved the stage report this run printed\"\n721:     mcp_tools: []   # script-only; no MCP calls\n722:     script_invocations:\n723:       - 'node .skilled/commands/doctor/scripts/overlay-engine.cjs repin --upstream <dir> --to <commit> --stage <dir>  # the plan: the same steps on a copy in a fresh temporary folder, live tree untouched; exit 0 = RESULT: STAGED, 1 = blocked overlays or a failed check, 2 = a refusal before any write'\n724:       - 'node .skilled/commands/doctor/scripts/overlay-engine.cjs repin --upstream <dir> --to <commit>  # the live run under the engine lock: backs up every path it touches, copies, sets the pin, applies and checks; run only after the repin yes'\n725:       - 'node .skilled/commands/doctor/scripts/overlay-engine.cjs repin --rollback <run-id>  # restores the backup of one run byte for byte; run only after the rollback yes'\n726:       - 'node .skilled/commands/doctor/scripts/overlay-engine.cjs status  # read-only: the re-read after the re-pin or the rollback'\n727:     trigger_phrases:\n728:       - \"re-pin my vendored Skilled\"\n729:       - \"repin vendored skilled to a new commit\"\n730:       - \"move my vendored skilled copy to a newer upstream commit\"\n731:       - \"roll back a vendored skilled re-pin\"\n732: \n733: # ─────────────────────────────────────────────────────────────────\n734: # COMPANION COMMAND ROUTES (/doctor:mcp sub-actions)\n735: # ─────────────────────────────────────────────────────────────────\n736: # /doctor:mcp dispatches via its own command (.skilled/commands/doctor/mcp.md).\n737: # These rows are tracked here for advisor + CI visibility only — the mcp.md\n738: # command parses its own sub-action argv and dispatches to the right YAML.\n739: # ─────────────────────────────────────────────────────────────────\n740: mcp_subroutes:\n741:   - sub_action: install\n742:     yaml: doctor-mcp-install.yaml\n743:     allowed_flags: [\"--runtime <name>\"]\n744:     mutating: mutates\n745:     gate3_location: \"Code Mode build output, .utcp_config.json and the runtime MCP configs\"\n746:     trigger_phrases:\n747:       - \"install the MCP servers\"\n748:       - \"Code Mode fresh install\"\n749:       - \"reinstall Code Mode MCP\"\n[Output truncated. Continue reading with offset: 750]","title":"read","metadata":{"metadata":{"truncated":true},"content":[{"type":"text","text":"Read file .skilled/commands/doctor/_routes.yaml, lines 480-749\n480: \n481:   - command: /doctor:helper\n482:     target: helper\n483:     yaml: doctor-helper.yaml\n484:     setup_vars: [execution_mode, problem_text, json_output, area, intent]\n485:     allowed_flags: [\"--json\"]\n486:     mutating: read-only\n487:     gate3_location: \"n/a (read-only matcher; it ranks the manifest, runs a read-only pick under that command's own router and prints a writing pick as one line for the operator)\"\n488:     mcp_tools: []   # no MCP calls and no background service; one script reads one YAML file\n489:     script_invocations:\n490:       - 'node .skilled/commands/doctor/scripts/doctor-helper-match.cjs --json -- \"<problem text>\"  # also --table and --areas; the matcher reads the manifest and writes nothing'\n491:     trigger_phrases:\n492:       - \"which doctor command should I run\"\n493:       - \"find the right doctor command\"\n494:       - \"what doctor command fixes this\"\n495:       - \"which doctor command fits my problem\"\n496: \n497:   - command: /doctor:sk-skill\n498:     target: convert\n499:     yaml: doctor-sk-skill-convert.yaml\n500:     setup_vars: [execution_mode, skill_target, dry_run, scratch_dir]\n501:     allowed_flags: [\"--dry-run\"]\n502:     mutating: mutates\n503:     gate3_location: \"the staged or converted skill folder .skilled/skills/<name>/ (its SKILL.md, ROUTER.md, graph-metadata.json, leaf-manifest.config.json, scaffold files and renamed resources, or an in-place SKILL.md rewrite beside a new sibling ROUTER.md and the approved edge in its own graph-metadata.json), its backups under .skilled/skills/.state/doctor-sk-skill/<name>/<timestamp>/, the one scratch root the plain-skill path uses beside them at .skilled/skills/.state/doctor-sk-skill/<name>/scratch/ and deletes, the skill's changelog folder with its .skilled/changelog/<name> link, and the integration targets the plan records: the advisor graph .skilled/skills/system-skill-advisor/runtime/database/skill-graph.sqlite, the compiled skill-graph.json and the advisor cases file\"\n504:     mcp_tools: []   # script-only; no MCP calls\n505:     script_invocations:\n506:       - 'node .skilled/commands/doctor/scripts/sk-skill-convert.cjs plan \"{skill_target}\"  # read-only: resolves the target, classifies the input and prints the plan, the follow-ups and the backup folder; a plain skill refuses here until its intent phrases are approved'\n507:       - 'node .skilled/commands/doctor/scripts/sk-skill-convert.cjs apply \"{skill_target}\" <the approved flags>  # the plan rerun: the same call without the write switch prints the plan and writes nothing, so the workflow reruns with repeated --approved-phrase, --description-trim, --allowed-tools, --edge and --agent-output and shows that plan'\n508:       - 'node .skilled/commands/doctor/scripts/sk-skill-convert.cjs preserve --snapshot \"{scratch_dir}/snapshot\" \"{scratch_dir}/staging\"  # read-only: proves the agent-produced prose kept every original body line before the format gate, from the one scratch root'\n509:       - 'node .skilled/commands/doctor/scripts/sk-skill-convert.cjs apply \"{skill_target}\" --apply  # the same plan, then the backup and the writes; the workflow adds the approved --approved-phrase, --description-trim, --allowed-tools, --edge and --agent-output flags and runs it only after an explicit yes'\n510:       - 'node .skilled/commands/doctor/scripts/sk-skill-check.cjs .skilled/skills/<name> --json  # the post-write re-read through the read-only check engine, at the converted root: the staged root for a plain skill, the skill folder for an in-place conversion'\n511:     trigger_phrases:\n512:       - \"convert a skill to the skilled format\"\n513:       - \"convert a plain agent skill\"\n514:       - \"turn my old skill into a skilled skill\"\n515:       - \"skill format conversion plan\"\n516:       - \"move the machine router out of a skill\"\n517:       - \"skill folder conversion with a backup\"\n518: \n519:   - command: /doctor:agents-md\n520:     target: check\n521:     default_target: true\n522:     yaml: doctor-agents-md-check.yaml\n523:     setup_vars: [execution_mode, root, json_output]\n524:     allowed_flags: [\"--json\", \"--root <dir>\"]\n525:     mutating: read-only\n526:     gate3_location: \"n/a (read-only diagnostic; the engine reads the root instruction file, its runtime copies and its REPO RULES.md and writes nothing)\"\n527:     mcp_tools: []   # script-only; no MCP calls\n528:     script_invocations:\n529:       - 'node .skilled/commands/doctor/scripts/agents-md-check.cjs  # the workflow adds --root <dir> and --json only when the operator passed them'\n530:     trigger_phrases:\n531:       - \"check the shipped agents instruction file\"\n532:       - \"agents md section check\"\n533:       - \"which agents md sections are stale\"\n534:       - \"agents md delivery budget report\"\n535:       - \"agents md template drift report\"\n536: \n537:   - command: /doctor:agents-md\n538:     target: embed\n539:     yaml: doctor-agents-md-embed.yaml\n540:     setup_vars: [execution_mode, root, dry_run, plan_digest, digest_confirmation, keep_claude_md, create_router]\n541:     allowed_flags: [\"--dry-run\", \"--root <dir>\", \"--plan-digest <digest>\", \"--keep-claude-md\", \"--remove-claude-md\", \"--create-router\"]\n542:     mutating: mutates\n543:     gate3_location: \"AGENTS.md (created when absent, replaced with the shipped sections plus the composed block), CLAUDE.md and .codex/AGENTS.md (folded into the block and removed, unless --keep-claude-md), .cursor/rules/repo-local.md (the generated mirror of a non-empty block) and REPO RULES.md (missing shipped rows appended, or the file created behind --create-router), with a copy of every touched path taken to the plan's backup folder, .skilled/output/doctor-agents-md/<first 16 characters of the plan digest>/ or the folder of that name under the operating system's temporary directory when git does not ignore that path, before the first byte, and .cursor/rules/skill-routing.md rewritten by the pointer generator the engine calls; the write runs only against the plan digest the operator approved\"\n544:     mcp_tools: []   # script-only; no MCP calls\n545:     script_invocations:\n546:       - 'node .skilled/commands/doctor/scripts/agents-md-embed.cjs plan  # read-only: composes every target in memory and prints the targets, the diffs, the block, the budget, the preservation ledger, the backup folder and the plan digest; the workflow adds --root <dir>, --keep-claude-md, --create-router and --dry-run only when the operator passed them'\n547:       - 'node .skilled/commands/doctor/scripts/agents-md-embed.cjs apply --plan-digest <digest>  # recomposes, refuses a digest that no longer matches, backs up, writes only inside its own allowlist and proves the composition against the bytes on disk; the workflow runs it only after the operator approves the plan that printed that digest'\n548:       - 'node .skilled/commands/doctor/scripts/agents-md-check.cjs  # the post-write re-read of the written repository; the workflow adds --root <dir> only when this run was pointed at another repository'\n549:     trigger_phrases:\n550:       - \"embed the shipped instructions into agents md\"\n551:       - \"add the agents md repository block\"\n552:       - \"fold claude md into agents md\"\n553:       - \"write the agents md repository block\"\n554:       - \"replace agents md with the shipped template\"\n555:       - \"update agents md from the shipped template\"\n556:       - \"embed the shipped agents md sections\"\n557:       - \"embed the shipped AGENTS.md sections\"\n558: \n559:   - command: /doctor:agents-md\n560:     target: restore\n561:     yaml: doctor-agents-md-restore.yaml\n562:     setup_vars: [execution_mode, run_dir, yes, dry_run]\n563:     allowed_flags: [\"--run <dir>\", \"--yes\", \"--dry-run\"]\n564:     mutating: mutates\n565:     gate3_location: \"the paths one run's own manifest.json under its backup directory records, each one re-checked against the engine's write allowlist before it is touched: a recorded file is copied back from its copy and a path the recorded run created (an AGENTS.md, CLAUDE.md, .codex/AGENTS.md, .cursor/rules/repo-local.md or REPO RULES.md it created) is removed along with each folder the run created for it that is empty again, and the backup directory itself is read and kept\"\n566:     mcp_tools: []   # script-only; no MCP calls\n567:     script_invocations:\n568:       - 'node .skilled/commands/doctor/scripts/agents-md-embed.cjs restore --run=<dir> --dry-run  # prints the restore plan the record and its copies describe and writes nothing'\n569:       - 'node .skilled/commands/doctor/scripts/agents-md-embed.cjs restore --run=<dir> --yes  # puts the recorded paths back and checks every restored file against its recorded hash; the workflow passes --yes only after its own yes'\n570:       - 'node .skilled/commands/doctor/scripts/agents-md-check.cjs  # the post-restore re-read of the restored repository, adding --root <the recorded root> when that root is not this repository'\n571:     trigger_phrases:\n572:       - \"undo an agents md embed run\"\n573:       - \"restore agents md from the backup\"\n574:       - \"roll back the agents md instruction file write\"\n575:       - \"revert agents md to the file before the embed\"\n576: \n577:   - command: /doctor:symlink\n578:     target: check\n579:     default_target: true\n580:     yaml: doctor-symlink-check.yaml\n581:     setup_vars: [execution_mode, root, runtimes, include, link_instructions, json_output]\n582:     allowed_flags: [\"--json\", \"--root <dir>\", \"--runtimes <list>\", \"--include <list>\", \"--link-instructions\"]\n583:     mutating: read-only\n584:     gate3_location: \"n/a (read-only diagnostic; the engine classifies every framework entry in the target repository and writes nothing)\"\n585:     mcp_tools: []   # script-only; no MCP calls\n586:     script_invocations:\n587:       - 'node .skilled/commands/doctor/scripts/symlink-engine.cjs check --root <dir>  # the workflow adds --runtimes, --include, --link-instructions and --json only when the operator passed them'\n588:     trigger_phrases:\n589:       - \"check skilled symlinks in a repo\"\n590:       - \"find broken skilled symlinks\"\n591:       - \"which runtime folders are linked\"\n592:       - \"is skilled linked into my project\"\n593:       - \"the skilled links are broken\"\n594:       - \"broken skilled links in my project\"\n595:       - \"skilled links in my project\"\n596: \n597:   - command: /doctor:symlink\n598:     target: link\n599:     yaml: doctor-symlink-link.yaml\n600:     setup_vars: [execution_mode, root, runtimes, mode, include, link_instructions, ignore, dry_run, plan_digest, digest_confirmation]\n601:     allowed_flags: [\"--root <dir>\", \"--runtimes <list>\", \"--mode <shape>\", \"--include <list>\", \"--link-instructions\", \"--ignore <where>\", \"--dry-run\", \"--plan-digest <digest>\"]\n602:     mutating: mutates\n603:     gate3_location: \"the target repository's framework links (whole-folder links, or real folders holding one link per entry), the broken links into the Skilled checkout that the plan replaces or removes, and the ignore lines in <git-dir>/info/exclude (or .gitignore behind --ignore gitignore), with the run record written to the checkout's .skilled/output/doctor-symlink/<first 16 hex of the digest>/manifest.json, or the next free <prefix>-2, <prefix>-3 folder when an earlier run holds it, before the first action; no real file or folder is ever overwritten, and the write runs only against the plan digest the operator approved\"\n604:     mcp_tools: []   # script-only; no MCP calls\n605:     script_invocations:\n606:       - 'node .skilled/commands/doctor/scripts/symlink-engine.cjs plan --root <dir>  # read-only: prints every action, every refusal and the plan digest; the workflow adds --runtimes, --mode, --include, --link-instructions and --ignore only when the operator passed them'\n607:       - 'node .skilled/commands/doctor/scripts/symlink-engine.cjs apply --root <dir> --plan-digest <digest>  # recomposes with the same flags, refuses a digest that no longer matches, records the run, applies the actions and reruns check; the workflow runs it only after the operator approves the plan that printed that digest'\n608:     trigger_phrases:\n609:       - \"symlink skilled into my project\"\n610:       - \"link the claude folder into my repo\"\n611:       - \"repair broken skilled symlinks\"\n612:       - \"create the skilled links in a repo\"\n613:       - \"link skilled into my repo\"\n614:       - \"link skilled into another project\"\n615:       - \"link my skilled checkout into another project\"\n616: \n617:   - command: /doctor:symlink\n618:     target: unlink\n619:     yaml: doctor-symlink-unlink.yaml\n620:     setup_vars: [execution_mode, run_dir, yes, dry_run]\n621:     allowed_flags: [\"--run <dir>\", \"--yes\", \"--dry-run\"]\n622:     mutating: mutates\n623:     gate3_location: \"only the links, the folders and the ignore lines one run's manifest.json records, each re-checked against the recorded state before it is touched; a path that changed since the apply is skipped and reported, and the run directory itself is read and kept\"\n624:     mcp_tools: []   # script-only; no MCP calls\n625:     script_invocations:\n626:       - 'node .skilled/commands/doctor/scripts/symlink-engine.cjs unlink --run <dir> --dry-run  # prints what the unlink would remove or restore and writes nothing'\n627:       - 'node .skilled/commands/doctor/scripts/symlink-engine.cjs unlink --run <dir> --yes  # removes the recorded links and empty folders and the recorded ignore lines; the workflow passes --yes only after its own yes'\n628:     trigger_phrases:\n629:       - \"undo a skilled symlink run\"\n630:       - \"remove the skilled symlinks again\"\n631:       - \"unlink skilled from my project\"\n632: \n633:   - command: /doctor:install\n634:     target: guide\n635:     yaml: doctor-install.yaml\n636:     setup_vars: [execution_mode, root, runtimes, json_output]\n637:     allowed_flags: [\"--json\", \"--root <dir>\", \"--runtimes <list>\"]\n638:     mutating: read-only\n639:     gate3_location: \"n/a (read-only guide; it checks the two builds, runs the symlink engine's check once and prints the ordered writing commands for the operator to run)\"\n640:     mcp_tools: []   # script-only; no MCP calls\n641:     script_invocations:\n642:       - 'test -d .skilled/skills/system-spec-kit/runtime/dist  # the spec-kit build the session hooks load'\n643:       - 'node .skilled/bin/skill-advisor.cjs list-tools --format json  # the advisor build; exit 0 means built'\n644:       - 'node .skilled/commands/doctor/scripts/symlink-engine.cjs check --root <dir>  # the workflow adds --runtimes and --link-instructions only when the operator chose them'\n645:     trigger_phrases:\n646:       - \"install skilled into my project\"\n647:       - \"set up skilled in another repo\"\n648:       - \"use skilled in my own project\"\n649:       - \"onboard a project repo to skilled\"\n650:       - \"guide me through installing skilled\"\n651:       - \"walk me through a first install of skilled\"\n652:       - \"first install of skilled in my project\"\n653:       - \"skilled in my other repository\"\n654:       - \"skilled in another repository\"\n655:       - \"walk me through adding this toolkit to my own project repository\"\n656:       - \"put this toolkit into my own project repository\"\n657:       - \"use this toolkit in my own project\"\n658:       - \"install this toolkit into another repository\"\n659:       - \"onboard this project repository\"\n660: \n661:   - command: /doctor:overlay\n662:     target: status\n663:     default_target: true\n664:     yaml: doctor-overlay-status.yaml\n665:     setup_vars: [execution_mode, root, json_output, audit_output]\n666:     allowed_flags: [\"--json\", \"--audit\", \"--root <dir>\"]\n667:     mutating: read-only\n668:     gate3_location: \"n/a (read-only diagnostic; the engine classifies every overlay destination in the vendored tree, runs the overlay manifest's read-only verify checks and writes nothing)\"\n669:     mcp_tools: []   # script-only; no MCP calls\n670:     script_invocations:\n671:       - 'node .skilled/commands/doctor/scripts/overlay-engine.cjs status  # exit 0 = in sync, 1 = something out of sync, 2 = a failed precondition; the workflow adds --root <dir>, --json and --audit only when the operator passed them, and --audit prints one AUDIT line per unowned path that differs from upstream at the pin, is missing from the tree or is tracked there and never upstream, then the audit count. A finding fails the status'\n672:     trigger_phrases:\n673:       - \"check my vendored skilled overlays\"\n674:       - \"are my skilled overlays in sync\"\n675:       - \"which overlay destinations are out of sync\"\n676:       - \"vendored skilled overlay status\"\n677:       - \"does my vendored skilled tree still carry its overlays\"\n678:       - \"vendored skilled overlays out of sync\"\n679:       - \"does my vendored skilled copy still carry its overlays\"\n680:       - \"adopt the skilled overlay engine in my project\"\n681:       - \"migrate my own overlay folder to doctor overlay\"\n682:       - \"check whether my overlay sources sit on their layout path\"\n683:       - \"audit my vendored skilled tree for unowned files\"\n684:       - \"which root files my overlays own drifted upstream at the pinned commit\"\n685:       - \"we copy skilled into our repo and lose our edits on update\"\n686:       - \"agents overlay stale after a re-pin\"\n687:       - \"which overlay do I rebase\"\n688:       - \"rebase the overlay\"\n689: \n690:   - command: /doctor:overlay\n691:     target: apply\n692:     yaml: doctor-overlay-apply.yaml\n693:     setup_vars: [execution_mode, root, capture_path, adopt_path, relayout]\n694:     allowed_flags: [\"--root <dir>\", \"--capture <path>\", \"--adopt <path>\", \"--relayout\"]\n695:     mutating: mutates\n696:     gate3_location: \"the overlay destinations and layout links the overlay manifest names inside the vendored tree, the outputs of the manifest's regenerate steps, and <overlay folder>/sync-state.json, all under the engine's own <overlay folder>/.build-lock; with --capture <path>, only the one overlay source that path maps to plus sync-state.json; with --adopt <path>, the copy of that vendored path in the overlay folder and one new entry in <overlay folder>/overlay-manifest.json, followed by the same apply; with --relayout, the overlay sources the manifest keeps off their layout paths, moved inside the overlay folder to the same path with the leading dot dropped, the layout-link targets that reach them, the source, fragment and base fields of <overlay folder>/overlay-manifest.json, and the backup in <overlay folder>/relayout-runs/<stamp>/, followed by the same apply; the write runs only after the operator approved the status report this run printed, or the LAYOUT lines in it when --relayout carries the run\"\n697:     mcp_tools: []   # script-only; no MCP calls\n698:     script_invocations:\n699:       - 'node .skilled/commands/doctor/scripts/overlay-engine.cjs status  # read-only: the report the run shows as its plan before the question, and the re-read after the write'\n700:       - 'node .skilled/commands/doctor/scripts/overlay-engine.cjs apply  # applies every overlay under the engine lock, then regenerates and verifies; writes nothing while a destination is live-edited, both-changed or upstream-moved; run only after the apply yes'\n701:       - 'node .skilled/commands/doctor/scripts/overlay-engine.cjs apply --capture <path>  # moves one live edit into its overlay source; run only after the capture yes'\n702:       - 'node .skilled/commands/doctor/scripts/overlay-engine.cjs apply --adopt <path>  # copies one unowned vendored path into the overlay folder, appends its manifest entry and applies; exit 0 = adopted and applied, 1 = the apply was blocked, 2 = a refusal with nothing written; run only after the adopt yes'\n703:       - 'node .skilled/commands/doctor/scripts/overlay-engine.cjs apply --relayout  # moves every off-layout copy onto its layout path under the engine lock, backs up what it leaves in relayout-runs/, points the manifest fields and layout links there, retargets each live link that named a moved copy with its relinked line, and prints one moved line per path, then names the apply that follows; exit 0 = done, 2 = a refusal with nothing written, such as a target that already exists; run only after the relayout yes, followed by apply'\n704:     trigger_phrases:\n705:       - \"apply the skilled overlays\"\n706:       - \"put my overlays back into vendored skilled\"\n707:       - \"capture a live edit into its overlay\"\n708:       - \"reapply overlays after copying skilled\"\n709:       - \"apply the overlays back onto the vendored copy\"\n710:       - \"put the overlays back on vendored skilled\"\n711:       - \"move my overlay sources onto the layout folder\"\n712:       - \"take over the overlay lock a dead run left behind\"\n713: \n714:   - command: /doctor:overlay\n715:     target: repin\n716:     yaml: doctor-overlay-repin.yaml\n717:     setup_vars: [execution_mode, root, upstream, to_commit, rollback_run_id]\n718:     allowed_flags: [\"--root <dir>\", \"--upstream <dir>\", \"--to <commit>\", \"--rollback <run-id>\"]\n719:     mutating: mutates\n720:     gate3_location: \"inside the vendored tree, the .skilled paths upstream added, changed or deleted between the pin the overlay manifest records and --to, plus each runtime folder whole, less the manifest's repin.exclude list and never a root file such as AGENTS.md; the manifest's pin, set to --to; the overlay destinations, layout links, regenerate outputs and <overlay folder>/sync-state.json the apply that follows writes; and the backup in <overlay folder>/repin-runs/<run-id>/, written before the first copy; all under the engine's own <overlay folder>/.build-lock; with --rollback <run-id>, only the paths that run's backup records, restored byte for byte, and the files that run created, removed; the --stage plan writes only a fresh temporary folder outside the tree, and the live write runs only after the operator approved the stage report this run printed\"\n721:     mcp_tools: []   # script-only; no MCP calls\n722:     script_invocations:\n723:       - 'node .skilled/commands/doctor/scripts/overlay-engine.cjs repin --upstream <dir> --to <commit> --stage <dir>  # the plan: the same steps on a copy in a fresh temporary folder, live tree untouched; exit 0 = RESULT: STAGED, 1 = blocked overlays or a failed check, 2 = a refusal before any write'\n724:       - 'node .skilled/commands/doctor/scripts/overlay-engine.cjs repin --upstream <dir> --to <commit>  # the live run under the engine lock: backs up every path it touches, copies, sets the pin, applies and checks; run only after the repin yes'\n725:       - 'node .skilled/commands/doctor/scripts/overlay-engine.cjs repin --rollback <run-id>  # restores the backup of one run byte for byte; run only after the rollback yes'\n726:       - 'node .skilled/commands/doctor/scripts/overlay-engine.cjs status  # read-only: the re-read after the re-pin or the rollback'\n727:     trigger_phrases:\n728:       - \"re-pin my vendored Skilled\"\n729:       - \"repin vendored skilled to a new commit\"\n730:       - \"move my vendored skilled copy to a newer upstream commit\"\n731:       - \"roll back a vendored skilled re-pin\"\n732: \n733: # ─────────────────────────────────────────────────────────────────\n734: # COMPANION COMMAND ROUTES (/doctor:mcp sub-actions)\n735: # ─────────────────────────────────────────────────────────────────\n736: # /doctor:mcp dispatches via its own command (.skilled/commands/doctor/mcp.md).\n737: # These rows are tracked here for advisor + CI visibility only — the mcp.md\n738: # command parses its own sub-action argv and dispatches to the right YAML.\n739: # ─────────────────────────────────────────────────────────────────\n740: mcp_subroutes:\n741:   - sub_action: install\n742:     yaml: doctor-mcp-install.yaml\n743:     allowed_flags: [\"--runtime <name>\"]\n744:     mutating: mutates\n745:     gate3_location: \"Code Mode build output, .utcp_config.json and the runtime MCP configs\"\n746:     trigger_phrases:\n747:       - \"install the MCP servers\"\n748:       - \"Code Mode fresh install\"\n749:       - \"reinstall Code Mode MCP\"\n[Output truncated. Continue reading with offset: 750]"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"limit\":270,\"offset\":480,\"path\":\".skilled/commands/doctor/_routes.yaml\"}"},"time":{"start":1794669637174,"end":1794669637346}}}}
