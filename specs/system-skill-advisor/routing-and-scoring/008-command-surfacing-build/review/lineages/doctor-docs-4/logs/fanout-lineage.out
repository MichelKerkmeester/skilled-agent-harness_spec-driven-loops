{"type":"step_start","timestamp":1794669567948,"sessionID":"ses_e255ff46effe7EWyuOLOEwVdy1","part":{"id":"prt_1daa45fcc001PgwYgLeKAeQTNd","sessionID":"ses_e255ff46effe7EWyuOLOEwVdy1","messageID":"msg_1daa454a0001bbKcFWt3ii130l","type":"step-start","snapshot":"3958a7f5dab02ffa64823ba22373fedbabbac4ac"}}
{"type":"tool_use","timestamp":1794669574590,"sessionID":"ses_e255ff46effe7EWyuOLOEwVdy1","part":{"partID":"prt_1daa47460001enEsg6nExckbrn","sessionID":"ses_e255ff46effe7EWyuOLOEwVdy1","messageID":"msg_1daa454a0001bbKcFWt3ii130l","type":"tool","id":"call_e681617f8034455792a994d6","tool":"read","state":{"status":"completed","input":{"path":".skilled/skills/system-skill-advisor/runtime/lib/scorer/doctor-helper-handoff.ts"},"output":"Read file .skilled/skills/system-skill-advisor/runtime/lib/scorer/doctor-helper-handoff.ts, lines 1-188\n1: // ───────────────────────────────────────────────────────────────\n2: // MODULE: Doctor Helper Hand-off\n3: // ───────────────────────────────────────────────────────────────\n4: \n5: // A doctor bridge passes only on its own declared wording, so a doctor problem\n6: // described in other words reaches no doctor command at all. /doctor:helper\n7: // already ranks free-text problems against every doctor route by word overlap.\n8: // When no doctor bridge passes, this module asks that same ranker whether the\n9: // prompt describes a doctor problem, and if it does the advisor offers the command the ranker named, or\n10: // /doctor:helper when that command asks before it runs.\n11: //\n12: // Two durable design choices:\n13: //   1. The ranker is the helper's own script, loaded from the workspace at run\n14: //      time, so the advisor and /doctor:helper can never disagree about what\n15: //      counts as a doctor problem. Any failure to load or rank is a no-match.\n16: //   2. Word overlap alone also fires on ordinary requests that share doctor\n17: //      vocabulary (\"start a deep review loop\"), so a weak match also needs the\n18: //      prompt to name a problem. Beside a passing skill only a strong cue\n19: //      counts, because bare words such as \"missing\" or \"broken\" are common in\n20: //      ordinary work. A skill that passed with none of its own phrases in the\n21: //      prompt is the exception: there a bare word with a strong ranker match\n22: //      leads. With no skill passing, a weak cue or no cue needs a strong ranker match,\n23: //      and only a strong cue hands off on the lower score.\n24: \n25: // ───────────────────────────────────────────────────────────────────\n26: // 1. IMPORTS\n27: // ───────────────────────────────────────────────────────────────────\n28: \n29: import { existsSync, statSync } from 'node:fs';\n30: import { createRequire } from 'node:module';\n31: import { join } from 'node:path';\n32: \n33: // ───────────────────────────────────────────────────────────────────\n34: // 2. CONSTANTS\n35: // ───────────────────────────────────────────────────────────────────\n36: \n37: const HELPER_SCRIPT = join('.skilled', 'commands', 'doctor', 'scripts', 'doctor-helper-match.cjs');\n38: const ROUTE_MANIFEST = join('.skilled', 'commands', 'doctor', '_routes.yaml');\n39: \n40: /** The bridge id the hand-off surfaces. */\n41: export const DOCTOR_HELPER_BRIDGE_ID = 'command-doctor-helper';\n42: \n43: /** Lowest helper rank score that counts as a doctor problem. */\n44: export const DOCTOR_HELPER_MIN_SCORE = 6;\n45: \n46: /** Helper rank score that stands in for a cue when no skill passes. */\n47: export const DOCTOR_HELPER_UNCUED_MIN_SCORE = 10;\n48: \n49: /**\n50:  * Helper rank score a weak cue needs when no skill passes. A weak cue is a bare\n51:  * word ordinary work also uses, so it needs a stronger ranker match than a\n52:  * strong cue, though less than no cue.\n53:  */\n54: export const DOCTOR_HELPER_WEAK_CUE_MIN_SCORE = 9;\n55: \n56: // A strong cue says a state is wrong or asks for a health or switch change, so\n57: // it can surface the helper beside a passing skill. A tool or command that does\n58: // not show up or appear is that wrong state, like one that is not registered or\n59: // not found. \"appear to\" states an impression and \"up-to-date\" is a compound,\n60: // so neither says a tool is missing. A weak cue is a bare word that ordinary\n61: // work requests also use (\"fix the broken example\"), so it counts only when no\n62: // skill passes. Every hand-off needs at least one cue.\n63: const STRONG_PROBLEM_CUE = new RegExp([\n64:   \"\\\\b(?:not|isn'?t|aren'?t|doesn'?t|don'?t|won'?t|can'?t) (?:\\\\w+ )?(?:work|working|registered|found|load|loading|run|running|active|linked|fir(?:e|es|ing)|trigger(?:s|ing)?|converg\\\\w*|show(?:s|ing)? up(?![-\\\\w])|appear(?:s|ing)?(?! to\\\\b))\\\\b\",\n65:   '\\\\bnever (?:converg\\\\w*|finish\\\\w*|stops?|works?|loads?|runs?)\\\\b',\n66:   '\\\\bstopped converg\\\\w*\\\\b',\n67:   '\\\\breturns? nothing\\\\b',\n68:   '\\\\b(?:healthy|health|diagnos\\\\w*)\\\\b',\n69:   '\\\\bturn(?:ed)? (?:on|off)\\\\b',\n70:   '\\\\bswitch(?:ed)? (?:on|off)\\\\b',\n71: ].join('|'), 'i');\n72: \n73: const WEAK_PROBLEM_CUE = new RegExp([\n74:   '\\\\b(?:broken|breaks?|failing|fails?|failed|wrong|stale|missing|stuck|errors?|drift(?:ed|s|ing)?)\\\\b',\n75:   '\\\\bout of (?:date|sync)\\\\b',\n76: ].join('|'), 'i');\n77: \n78: // A request for a repair route that names no problem the ranker knows still\n79: // belongs to /doctor:helper, which lists the routes and their reasons. The two\n80: // phrases are exact, so ordinary work requests never carry them.\n81: const GENERIC_REPAIR_CUE = /\\b(?:repair path|i have a problem)\\b/i;\n82: \n83: // ───────────────────────────────────────────────────────────────────\n84: // 3. TYPES\n85: // ───────────────────────────────────────────────────────────────────\n86: \n87: interface HelperCandidate {\n88:   readonly command: string;\n89:   readonly runnable?: string;\n90:   readonly score: number;\n91: }\n92: \n93: interface HelperModule {\n94:   readonly loadEntries: (root: string) => { readonly entries: readonly unknown[] };\n95:   readonly rankProblem: (\n96:     entries: readonly unknown[],\n97:     text: string,\n98:     options: { readonly top: number },\n99:   ) => { readonly candidates?: readonly HelperCandidate[] };\n100: }\n101: \n102: interface LoadedHelper {\n103:   readonly manifestMtimeMs: number;\n104:   readonly module: HelperModule;\n105:   readonly entries: readonly unknown[];\n106: }\n107: \n108: /** The doctor command the helper ranked first, with its rank score. */\n109: export interface DoctorProblemMatch {\n110:   readonly command: string;\n111:   /** The command with its subcommand, such as `/doctor:agents-md check`. */\n112:   readonly runnable: string;\n113:   readonly score: number;\n114: }\n115: \n116: // ───────────────────────────────────────────────────────────────────\n117: // 4. HELPERS\n118: // ───────────────────────────────────────────────────────────────────\n119: \n120: const loadedByRoot = new Map<string, LoadedHelper | null>();\n121: \n122: function loadHelper(workspaceRoot: string): LoadedHelper | null {\n123:   const scriptPath = join(workspaceRoot, HELPER_SCRIPT);\n124:   const manifestPath = join(workspaceRoot, ROUTE_MANIFEST);\n125:   if (!existsSync(scriptPath) || !existsSync(manifestPath)) return null;\n126:   let manifestMtimeMs: number;\n127:   try {\n128:     manifestMtimeMs = statSync(manifestPath).mtimeMs;\n129:   } catch {\n130:     return null;\n131:   }\n132:   const cached = loadedByRoot.get(workspaceRoot);\n133:   if (cached && cached.manifestMtimeMs === manifestMtimeMs) return cached;\n134:   try {\n135:     const helper = createRequire(import.meta.url)(scriptPath) as HelperModule;\n136:     const loaded: LoadedHelper = {\n137:       manifestMtimeMs,\n138:       module: helper,\n139:       entries: helper.loadEntries(workspaceRoot).entries,\n140:     };\n141:     loadedByRoot.set(workspaceRoot, loaded);\n142:     return loaded;\n143:   } catch {\n144:     loadedByRoot.set(workspaceRoot, null);\n145:     return null;\n146:   }\n147: }\n148: \n149: // ───────────────────────────────────────────────────────────────────\n150: // 5. CORE LOGIC\n151: // ───────────────────────────────────────────────────────────────────\n152: \n153: /** The strongest problem cue the prompt carries. */\n154: export function doctorProblemCue(prompt: string): 'strong' | 'weak' | null {\n155:   // Many keyboards type a contraction with a curly apostrophe, and the cue\n156:   // patterns spell it straight.\n157:   const folded = prompt.replace(/[‘’]/g, \"'\");\n158:   if (STRONG_PROBLEM_CUE.test(folded)) return 'strong';\n159:   if (WEAK_PROBLEM_CUE.test(folded)) return 'weak';\n160:   return null;\n161: }\n162: \n163: /** True when the prompt asks for a repair route without naming the problem. */\n164: export function genericRepairCue(prompt: string): boolean {\n165:   return GENERIC_REPAIR_CUE.test(prompt);\n166: }\n167: \n168: /**\n169:  * Ranks the prompt with /doctor:helper's own matcher and returns its first\n170:  * candidate when that candidate reaches the hand-off score, or null.\n171:  */\n172: export function matchDoctorProblem(prompt: string, workspaceRoot: string): DoctorProblemMatch | null {\n173:   const loaded = loadHelper(workspaceRoot);\n174:   if (!loaded) return null;\n175:   try {\n176:     const first = loaded.module.rankProblem(loaded.entries, prompt, { top: 1 }).candidates?.[0];\n177:     if (!first || typeof first.command !== 'string' || typeof first.score !== 'number') return null;\n178:     return first.score >= DOCTOR_HELPER_MIN_SCORE\n179:       ? {\n180:           command: first.command,\n181:           runnable: typeof first.runnable === 'string' && first.runnable !== '' ? first.runnable : first.command,\n182:           score: first.score,\n183:         }\n184:       : null;\n185:   } catch {\n186:     return null;\n187:   }\n188: }","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file .skilled/skills/system-skill-advisor/runtime/lib/scorer/doctor-helper-handoff.ts, lines 1-188\n1: // ───────────────────────────────────────────────────────────────\n2: // MODULE: Doctor Helper Hand-off\n3: // ───────────────────────────────────────────────────────────────\n4: \n5: // A doctor bridge passes only on its own declared wording, so a doctor problem\n6: // described in other words reaches no doctor command at all. /doctor:helper\n7: // already ranks free-text problems against every doctor route by word overlap.\n8: // When no doctor bridge passes, this module asks that same ranker whether the\n9: // prompt describes a doctor problem, and if it does the advisor offers the command the ranker named, or\n10: // /doctor:helper when that command asks before it runs.\n11: //\n12: // Two durable design choices:\n13: //   1. The ranker is the helper's own script, loaded from the workspace at run\n14: //      time, so the advisor and /doctor:helper can never disagree about what\n15: //      counts as a doctor problem. Any failure to load or rank is a no-match.\n16: //   2. Word overlap alone also fires on ordinary requests that share doctor\n17: //      vocabulary (\"start a deep review loop\"), so a weak match also needs the\n18: //      prompt to name a problem. Beside a passing skill only a strong cue\n19: //      counts, because bare words such as \"missing\" or \"broken\" are common in\n20: //      ordinary work. A skill that passed with none of its own phrases in the\n21: //      prompt is the exception: there a bare word with a strong ranker match\n22: //      leads. With no skill passing, a weak cue or no cue needs a strong ranker match,\n23: //      and only a strong cue hands off on the lower score.\n24: \n25: // ───────────────────────────────────────────────────────────────────\n26: // 1. IMPORTS\n27: // ───────────────────────────────────────────────────────────────────\n28: \n29: import { existsSync, statSync } from 'node:fs';\n30: import { createRequire } from 'node:module';\n31: import { join } from 'node:path';\n32: \n33: // ───────────────────────────────────────────────────────────────────\n34: // 2. CONSTANTS\n35: // ───────────────────────────────────────────────────────────────────\n36: \n37: const HELPER_SCRIPT = join('.skilled', 'commands', 'doctor', 'scripts', 'doctor-helper-match.cjs');\n38: const ROUTE_MANIFEST = join('.skilled', 'commands', 'doctor', '_routes.yaml');\n39: \n40: /** The bridge id the hand-off surfaces. */\n41: export const DOCTOR_HELPER_BRIDGE_ID = 'command-doctor-helper';\n42: \n43: /** Lowest helper rank score that counts as a doctor problem. */\n44: export const DOCTOR_HELPER_MIN_SCORE = 6;\n45: \n46: /** Helper rank score that stands in for a cue when no skill passes. */\n47: export const DOCTOR_HELPER_UNCUED_MIN_SCORE = 10;\n48: \n49: /**\n50:  * Helper rank score a weak cue needs when no skill passes. A weak cue is a bare\n51:  * word ordinary work also uses, so it needs a stronger ranker match than a\n52:  * strong cue, though less than no cue.\n53:  */\n54: export const DOCTOR_HELPER_WEAK_CUE_MIN_SCORE = 9;\n55: \n56: // A strong cue says a state is wrong or asks for a health or switch change, so\n57: // it can surface the helper beside a passing skill. A tool or command that does\n58: // not show up or appear is that wrong state, like one that is not registered or\n59: // not found. \"appear to\" states an impression and \"up-to-date\" is a compound,\n60: // so neither says a tool is missing. A weak cue is a bare word that ordinary\n61: // work requests also use (\"fix the broken example\"), so it counts only when no\n62: // skill passes. Every hand-off needs at least one cue.\n63: const STRONG_PROBLEM_CUE = new RegExp([\n64:   \"\\\\b(?:not|isn'?t|aren'?t|doesn'?t|don'?t|won'?t|can'?t) (?:\\\\w+ )?(?:work|working|registered|found|load|loading|run|running|active|linked|fir(?:e|es|ing)|trigger(?:s|ing)?|converg\\\\w*|show(?:s|ing)? up(?![-\\\\w])|appear(?:s|ing)?(?! to\\\\b))\\\\b\",\n65:   '\\\\bnever (?:converg\\\\w*|finish\\\\w*|stops?|works?|loads?|runs?)\\\\b',\n66:   '\\\\bstopped converg\\\\w*\\\\b',\n67:   '\\\\breturns? nothing\\\\b',\n68:   '\\\\b(?:healthy|health|diagnos\\\\w*)\\\\b',\n69:   '\\\\bturn(?:ed)? (?:on|off)\\\\b',\n70:   '\\\\bswitch(?:ed)? (?:on|off)\\\\b',\n71: ].join('|'), 'i');\n72: \n73: const WEAK_PROBLEM_CUE = new RegExp([\n74:   '\\\\b(?:broken|breaks?|failing|fails?|failed|wrong|stale|missing|stuck|errors?|drift(?:ed|s|ing)?)\\\\b',\n75:   '\\\\bout of (?:date|sync)\\\\b',\n76: ].join('|'), 'i');\n77: \n78: // A request for a repair route that names no problem the ranker knows still\n79: // belongs to /doctor:helper, which lists the routes and their reasons. The two\n80: // phrases are exact, so ordinary work requests never carry them.\n81: const GENERIC_REPAIR_CUE = /\\b(?:repair path|i have a problem)\\b/i;\n82: \n83: // ───────────────────────────────────────────────────────────────────\n84: // 3. TYPES\n85: // ───────────────────────────────────────────────────────────────────\n86: \n87: interface HelperCandidate {\n88:   readonly command: string;\n89:   readonly runnable?: string;\n90:   readonly score: number;\n91: }\n92: \n93: interface HelperModule {\n94:   readonly loadEntries: (root: string) => { readonly entries: readonly unknown[] };\n95:   readonly rankProblem: (\n96:     entries: readonly unknown[],\n97:     text: string,\n98:     options: { readonly top: number },\n99:   ) => { readonly candidates?: readonly HelperCandidate[] };\n100: }\n101: \n102: interface LoadedHelper {\n103:   readonly manifestMtimeMs: number;\n104:   readonly module: HelperModule;\n105:   readonly entries: readonly unknown[];\n106: }\n107: \n108: /** The doctor command the helper ranked first, with its rank score. */\n109: export interface DoctorProblemMatch {\n110:   readonly command: string;\n111:   /** The command with its subcommand, such as `/doctor:agents-md check`. */\n112:   readonly runnable: string;\n113:   readonly score: number;\n114: }\n115: \n116: // ───────────────────────────────────────────────────────────────────\n117: // 4. HELPERS\n118: // ───────────────────────────────────────────────────────────────────\n119: \n120: const loadedByRoot = new Map<string, LoadedHelper | null>();\n121: \n122: function loadHelper(workspaceRoot: string): LoadedHelper | null {\n123:   const scriptPath = join(workspaceRoot, HELPER_SCRIPT);\n124:   const manifestPath = join(workspaceRoot, ROUTE_MANIFEST);\n125:   if (!existsSync(scriptPath) || !existsSync(manifestPath)) return null;\n126:   let manifestMtimeMs: number;\n127:   try {\n128:     manifestMtimeMs = statSync(manifestPath).mtimeMs;\n129:   } catch {\n130:     return null;\n131:   }\n132:   const cached = loadedByRoot.get(workspaceRoot);\n133:   if (cached && cached.manifestMtimeMs === manifestMtimeMs) return cached;\n134:   try {\n135:     const helper = createRequire(import.meta.url)(scriptPath) as HelperModule;\n136:     const loaded: LoadedHelper = {\n137:       manifestMtimeMs,\n138:       module: helper,\n139:       entries: helper.loadEntries(workspaceRoot).entries,\n140:     };\n141:     loadedByRoot.set(workspaceRoot, loaded);\n142:     return loaded;\n143:   } catch {\n144:     loadedByRoot.set(workspaceRoot, null);\n145:     return null;\n146:   }\n147: }\n148: \n149: // ───────────────────────────────────────────────────────────────────\n150: // 5. CORE LOGIC\n151: // ───────────────────────────────────────────────────────────────────\n152: \n153: /** The strongest problem cue the prompt carries. */\n154: export function doctorProblemCue(prompt: string): 'strong' | 'weak' | null {\n155:   // Many keyboards type a contraction with a curly apostrophe, and the cue\n156:   // patterns spell it straight.\n157:   const folded = prompt.replace(/[‘’]/g, \"'\");\n158:   if (STRONG_PROBLEM_CUE.test(folded)) return 'strong';\n159:   if (WEAK_PROBLEM_CUE.test(folded)) return 'weak';\n160:   return null;\n161: }\n162: \n163: /** True when the prompt asks for a repair route without naming the problem. */\n164: export function genericRepairCue(prompt: string): boolean {\n165:   return GENERIC_REPAIR_CUE.test(prompt);\n166: }\n167: \n168: /**\n169:  * Ranks the prompt with /doctor:helper's own matcher and returns its first\n170:  * candidate when that candidate reaches the hand-off score, or null.\n171:  */\n172: export function matchDoctorProblem(prompt: string, workspaceRoot: string): DoctorProblemMatch | null {\n173:   const loaded = loadHelper(workspaceRoot);\n174:   if (!loaded) return null;\n175:   try {\n176:     const first = loaded.module.rankProblem(loaded.entries, prompt, { top: 1 }).candidates?.[0];\n177:     if (!first || typeof first.command !== 'string' || typeof first.score !== 'number') return null;\n178:     return first.score >= DOCTOR_HELPER_MIN_SCORE\n179:       ? {\n180:           command: first.command,\n181:           runnable: typeof first.runnable === 'string' && first.runnable !== '' ? first.runnable : first.command,\n182:           score: first.score,\n183:         }\n184:       : null;\n185:   } catch {\n186:     return null;\n187:   }\n188: }"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\".skilled/skills/system-skill-advisor/runtime/lib/scorer/doctor-helper-handoff.ts\"}"},"time":{"start":1794669573216,"end":1794669574590}}}}
