{"type":"tool_use","timestamp":1794669323019,"sessionID":"ses_e255ff46effe7EWyuOLOEwVdy1","part":{"partID":"prt_1daa0a09f001P4E6gi6hG1cQAO","sessionID":"ses_e255ff46effe7EWyuOLOEwVdy1","messageID":"msg_1daa088ba00120lVhPTo4xJ0gn","type":"tool","id":"call_2630bb7143494dffa4244b9b","tool":"read","state":{"status":"completed","input":{"path":".skilled/commands/deep/assets/deep-review-auto.yaml"},"output":"Read file .skilled/commands/deep/assets/deep-review-auto.yaml, lines 1-699\n1: # ─────────────────────────────────────────────────────────────────\n2: # DEEP REVIEW: AUTONOMOUS DEEP REVIEW LOOP (AUTO MODE)\n3: # ─────────────────────────────────────────────────────────────────\n4: # DEEP REVIEW: AUTONOMOUS DEEP REVIEW LOOP (AUTO MODE)\n5: # ─────────────────────────────────────────────────────────────────\n6: role: Deep Review Loop Manager\n7: purpose: Iterative code/spec review with convergence detection across review dimensions\n8: action: Run deep-review loop from initialization through synthesis\n9: operating_mode:\n10:   workflow: iterative_loop\n11:   workflow_compliance: MANDATORY\n12:   workflow_execution: autonomous\n13:   approvals: none\n14:   tracking: progressive_review_state\n15:   validation: convergence_detection\n16: \n17: # ─────────────────────────────────────────────────────────────────\n18: # OPERATING PRINCIPLES\n19: # ─────────────────────────────────────────────────────────────────\n20: operating_principles:\n21:   core: \"Fresh context per iteration + externalized state = no context degradation\"\n22:   approach: \"Dispatch focused review agent per dimension, evaluate convergence, repeat or stop\"\n23:   mandate: \"Never hold findings in memory; write everything to files. Review target is READ-ONLY.\"\n24: \n25: # ─────────────────────────────────────────────────────────────────\n26: # USER INPUTS (from setup phase)\n27: # ─────────────────────────────────────────────────────────────────\n28: user_inputs:\n29:   review_target: \"[REVIEW_TARGET] - What to review. REQUIRED.\"\n30:   review_target_type: \"[spec-folder|skill|agent|track|files] - Target type for scope derivation. REQUIRED.\"\n31:   review_dimensions: \"[all|correctness,security,traceability,maintainability] - Dimensions to check. Default: all.\"\n32:   review_focus: \"[optional free text] - Operator review focus that every iteration covers in addition to its dimension. Default: empty, which leaves the prompt unchanged.\"\n33:   spec_folder: \"[SPEC_FOLDER] - Spec folder path for state files. REQUIRED.\"\n34:   session_id: \"[SESSION_ID] - Optional caller-supplied session id for fan-out lineages. Default: timestamp.\"\n35:   lineage_mode: \"[auto|resume|restart] - Session lifecycle intent. Default: auto. The runtime only persists lineage events for `resume` (same sessionId, no archive) and `restart` (new sessionId, generation+1, prior review/ archived). `fork` and `completed-continue` are deferred and no longer accepted — see deep-review/references/protocol/loop-protocol.md §Lifecycle Branches.\"\n36:   max_iterations: 7\n37:   convergence_threshold: 0.10\n38:   convergence_mode: \"[default|off|sliding-window|divergent] - Convergence policy modifier. Default: default.\"\n39:   stop_policy: \"[convergence|max-iterations] - Stop behavior. Default: convergence. max-iterations treats convergence as telemetry until the hard iteration ceiling.\"\n40:   config.fanout_lineage_artifact_dir: \"[optional internal path] - Fan-out lineage artifact override for command-owned single-lineage execution.\"\n41: \n42: # ─────────────────────────────────────────────────────────────────\n43: # CONTEXT LOADING\n44: # ─────────────────────────────────────────────────────────────────\n45: context_loading:\n46:   trigger: \"At workflow START, before phase_init\"\n47:   purpose: \"Load prior review context for the target and buffer it until strategy.md exists\"\n48:   retrieval:\n49:     mechanism: \"continuity-ladder-then-ripgrep\"\n50:     note: \"File reads only. Nothing here needs a running daemon, and every step is reproducible by hand.\"\n51:     ladder:\n52:       - \"{spec_folder}/handover.md when present\"\n53:       - \"the _memory.continuity frontmatter block in {spec_folder}/implementation-summary.md\"\n54:       - \"the packet's canonical spec docs, spec.md and decision-record.md, for what the first two steps leave open\"\n55:     free_text_recipe: \"rg --no-config --json --fixed-strings --ignore-case -C 2 --glob '*.md' --glob '!**/z_archive/**' --glob '!**/node_modules/**' -- '{review_target}' specs .skilled\"\n56:     recipe_contract: \".skilled/skills/system-spec-kit/references/retrieval/retrieval-conventions.md\"\n57:     exit_status: \"0 is a hit set, 1 is a clean no-hit, 2 or higher is a failure that must be surfaced instead of reported as no-hit\"\n58:     ranking: \"Ripgrep does not rank. Order the hits caller-side with the tuple in retrieval-conventions.md section 5.\"\n59:   when_to_skip: [\"User says 'skip context' or 'fresh start'\"]\n60:   behavior:\n61:     if_context_found: \"Store full results as prior_context plus a concise prior_context_summary; inject after strategy.md is created.\"\n62:     if_no_context: \"Set prior_context and prior_context_summary to 'None' and continue.\"\n63: \n64: # ─────────────────────────────────────────────────────────────────\n65: # SKILL REFERENCE\n66: # ─────────────────────────────────────────────────────────────────\n67: skill_reference:\n68:   skill: system-deep-loop\n69:   skill_md: .skilled/skills/system-deep-loop/deep-review/SKILL.md\n70:   references:\n71:     loop_protocol: .skilled/skills/system-deep-loop/deep-review/references/protocol/loop-protocol.md\n72:     state_format: .skilled/skills/system-deep-loop/deep-review/references/state/state-format.md\n73:     convergence: .skilled/skills/system-deep-loop/deep-review/references/convergence/convergence.md\n74:   templates:\n75:     config: .skilled/skills/system-deep-loop/deep-review/assets/deep-review-config.json\n76:     strategy: .skilled/skills/system-deep-loop/deep-review/assets/deep-review-strategy.md\n77: \n78: # ─────────────────────────────────────────────────────────────────\n79: # AGENT CONFIGURATION\n80: # ─────────────────────────────────────────────────────────────────\n81: agent_config:\n82:   agent: deep-review\n83:   agent_file: \".skilled/agents/deep-review.md\"\n84:   # Canonical path. Runtime-specific directories (e.g. .claude/agents/) reference this source.\n85:   mode: subagent\n86:   model: opus\n87:   leaf_only: true\n88:   tools: [Read, Write, Edit, Bash, Grep, Glob]\n89:   mcp_servers: []\n90:   tool_call_budget: { target: 9, soft_max: 12, hard_max: 13 }\n91: \n92: # ─────────────────────────────────────────────────────────────────\n93: # STATE FILE PATHS\n94: # ─────────────────────────────────────────────────────────────────\n95: # ─────────────────────────────────────────────────────────────────\n96: # CANONICAL STATE WRITE MECHANISM\n97: # ─────────────────────────────────────────────────────────────────\n98: state_write_protocol:\n99:   mechanism: \"append-gateway\"\n100:   command: \"node .skilled/skills/system-deep-loop/runtime/scripts/append-mode-event.cjs --mode review --run-directory {artifact_dir} --event-json <record file>\"\n101:   applies_to: \"every append_to_jsonl and append_jsonl directive in this workflow\"\n102:   refusal_handling: \"halt on exit 2; never fall back to a direct file write. Exit 1 on a row that is still routed through the gateway is a workflow defect and halts; the pinned_bookkeeping rows are recorded through bookkeeping_log and are never routed.\"\n103:   pinned_bookkeeping:\n104:     events: [config_warning, lock_released, pivot_confirm_accepted, manualStop, pivot_override_accepted]\n105:     directive: \"bookkeeping_log\"\n106:     handling: \"These rows are workflow bookkeeping that the review ledger schema pins to the legacy path: they have no lossless review-event target, so the gateway would refuse them with exit 1 and write nothing. They are never sent to the gateway. The step prints the row in its log line and continues; none of them is a halt condition.\"\n107:   contract: |\n108:     The directives below specify WHAT to record; this block specifies the mechanism. The gateway\n109:     authorizes the write against the mode's durable authority record, serialises it behind the\n110:     ledger fence, returns a receipt, and refreshes state_log from the ledger. Exit 0 means the\n111:     record is durable in the ledger and the refreshed state_log carries it. Exit 2 means it was\n112:     refused, and the refusal names the check that failed.\n113: \n114:     Writing state_log directly bypasses ordering, authorization, and the receipt. Two writers\n115:     can then interleave with no shared ordering, and a record nobody authorized carries no\n116:     receipt, so a later reader cannot tell an accepted record from an invented one. A refusal\n117:     is a halt, never a reason to write the file directly.\n118: \n119:     There is no direct-append exception. state_log is a projection the gateway rebuilds from\n120:     the ledger, so a row written beside it is dropped by the next refresh: the migration\n121:     marker, the recovery baseline, the iteration-error row and the claim-adjudication gate\n122:     row are canonical ledger events like every other record.\n123: \n124: state_paths:\n125:   # Template paths document the canonical packet layout. Runtime resolution happens via\n126:   # step_resolve_artifact_root plus the shared resolver, so root specs keep\n127:   # root-local review/ and child phases keep local review/ packet dirs.\n128:   # Canonical root-spec write targets remain review/deep-review-config.json,\n129:   # review/deep-review-state.jsonl, and review/deep-review-findings-registry.json.\n130:   packet_dir: \"{artifact_dir}\"\n131:   local_packet_dir: \"{spec_folder}/review\"\n132:   legacy_root_report: \"{spec_folder}/review-report.md\"\n133:   config: \"{artifact_dir}/deep-review-config.json\"\n134:   state_log: \"{artifact_dir}/deep-review-state.jsonl\"\n135:   findings_registry: \"{artifact_dir}/deep-review-findings-registry.json\"\n136:   strategy: \"{artifact_dir}/deep-review-strategy.md\"\n137:   dashboard: \"{artifact_dir}/deep-review-dashboard.md\"\n138:   pause_sentinel: \"{artifact_dir}/.deep-review-pause\"\n139:   lock_file: \"{artifact_dir}/.deep-review.lock\"\n140:   prompt_dir: \"{artifact_dir}/prompts\"\n141:   iteration_dir: \"{artifact_dir}/iterations\"\n142:   iteration_pattern: \"{artifact_dir}/iterations/iteration-{NNN}.md\"\n143:   # Per-iteration structured delta stream — complement to the canonical state_log\n144:   # append. MUST contain at least one record with `type === \"iteration\"`; variants\n145:   # like `\"iteration_delta\"` are silently dropped by the reducer.\n146:   delta_dir: \"{artifact_dir}/deltas\"\n147:   delta_pattern: \"{artifact_dir}/deltas/iter-{NNN}.jsonl\"\n148:   review_output: \"{artifact_dir}/review-report.md\"\n149:   resource_map_output: \"{artifact_dir}/resource-map.md\"\n150:   archive_root: \"{artifact_archive_root}\"\n151: \n152: # ─────────────────────────────────────────────────────────────────\n153: # WORKFLOW\n154: # ─────────────────────────────────────────────────────────────────\n155: workflow:\n156: \n157:   step_resolve_artifact_root:\n158:     description: \"Resolve artifact directory — use fan-out lineage override when provided, else resolve from spec_folder\"\n159:     note: \"Root specs keep review artifacts directly in {spec_folder}/review/. Child phases and sub-phases keep local packet directories in {spec_folder}/review/{packet}/, and archives stay local at {spec_folder}/review-archive/{packet}/.\"\n160:     branch_on: \"config.fanout_lineage_artifact_dir\"\n161:     if_present:\n162:       bind:\n163:         artifact_dir: \"{config.fanout_lineage_artifact_dir}\"\n164:         artifact_root_dir: \"{config.fanout_lineage_artifact_dir}\"\n165:         artifact_subfolder: null\n166:         artifact_archive_root: \"{config.fanout_lineage_artifact_dir}/_archive\"\n167:     if_absent:\n168:       command: \"node -e \\\"const { resolveArtifactRoot } = require('./.skilled/skills/system-spec-kit/shared/review-research-paths.cjs'); console.log(JSON.stringify(resolveArtifactRoot('{spec_folder}', 'review')));\\\"\"\n169:       outputs:\n170:         - artifact_root_dir: \"Resolved local review owner directory\"\n171:         - artifact_subfolder: \"Local packet subfolder ({ownerSlug}-pt-{NN}), else null\"\n172:         - artifact_dir: \"Resolved review packet directory for this target\"\n173:         - artifact_archive_root: \"Resolved local review archive directory for this target\"\n174: \n175:   step_bind_reducer_artifact_arg:\n176:     description: \"Keep the reducer on the lineage-owned artifact directory during fan-out\"\n177:     branch_on: \"config.fanout_lineage_artifact_dir\"\n178:     if_present:\n179:       bind:\n180:         reducer_artifact_arg: \"--artifact-dir {artifact_dir}\"\n181:     if_absent:\n182:       bind:\n183:         reducer_artifact_arg: \"\"\n184: \n185:   step_apply_lifecycle_request:\n186:     description: \"Honor explicit auto-mode restart before fan-out or normal initialization\"\n187:     skip_when: \"lineage_mode != 'restart'\"\n188:     instructions: |\n189:       This is the autonomous equivalent of the confirm-mode restart choice. Run it\n190:       immediately after artifact resolution and before fan-out so old packet files\n191:       cannot be merged with fresh lineage outputs. A restart request must never\n192:       fall back to auto-resume. In auto mode, the explicit restart flag is operator\n193:       authorization to archive the resolved review packet, so do not ask for a\n194:       second confirmation. Rollback is to move the timestamped archive back to\n195:       the packet directory.\n196:     command: \"if [ -d \\\"{state_paths.packet_dir}\\\" ]; then mkdir -p \\\"{state_paths.archive_root}\\\" && mv \\\"{state_paths.packet_dir}\\\" \\\"{state_paths.archive_root}/{timestamp_slug}\\\"; fi; mkdir -p \\\"{state_paths.packet_dir}\\\"\"\n197:     outputs:\n198:       - archived_path: \"{state_paths.archive_root}/{timestamp_slug} when a prior packet existed, else null\"\n199:       - lineage_mode: \"restart\"\n200:     on_fail: \"Halt with STATUS=FAIL; do not continue as resume or auto.\"\n201: \n202:   step_fanout_spawn:\n203:     description: \"Spawn fan-out lineages; skip and proceed to phase_init normally when single-executor\"\n204:     skip_when: \"config.fanout is absent\"\n205:     instructions: |\n206:       Fan-out mode is active. Spawn all lineages. Each lineage runs the full loop in its own\n207:       isolated sub-packet under {artifact_dir}/lineages/{label}/.\n208:       This step runs before phase_init, so pass the raw review_focus. fanout-run.cjs\n209:       normalizes it and hands every lineage the same single-line text. Escape any double\n210:       quote, backslash, dollar sign or backtick in it for the shell, and pass an empty\n211:       string when no focus was given.\n212:       A cli-opencode lineage inside this fan-out is an explicit parallel-detached OpenCode\n213:       session with a separate lineage directory and session id; it is not the single-executor\n214:       self-invocation path. fanout-run.cjs owns the stack-only recursion guard for that\n215:       first-level detached lineage and still blocks recursive same-kind dispatch from inside it.\n216:       fanout-run.cjs owns native and CLI lineage execution; native is run through the\n217:       deep/review command surface with config.fanout_lineage_artifact_dir so the LEAF\n218:       deep-review agent is used only for individual iterations, never as a full-loop\n219:       sub-agent or pasted phase-running prompt.\n220:       After all lineages complete, jump directly to phase_synthesis — skip phase_init and\n221:       phase_main_loop entirely (those are the single-executor path). The merge step in\n222:       phase_synthesis will consolidate results across all lineages.\n223:     sub_steps:\n224:       step_fanout_spawn_cli:\n225:         description: \"Spawn all native and CLI lineages in capped worker pool\"\n226:         skip_when: \"no entries in config.fanout.executors\"\n227:         command: |\n228:           node .skilled/skills/system-deep-loop/runtime/scripts/fanout-run.cjs \\\n229:             --spec-folder {spec_folder} \\\n230:             --loop-type review \\\n231:             --review-focus \"{review_focus}\" \\\n232:             --review-target \"{review_target}\" \\\n233:             --review-target-type {review_target_type} \\\n234:             --fanout-config-json '{config.fanout_json}' \\\n235:             --base-artifact-dir {artifact_dir} \\\n236:             --convergence-threshold {convergence_threshold} \\\n237:             --stop-policy {stop_policy} \\\n238:             --convergence-mode {convergence_mode}\n239:         working_directory: \"{repo_root}\"\n240:         wait_for_completion: true\n241: \n242:   # ═══════════════════════════════════════════════════════════════\n243:   # PHASE 1: INITIALIZATION\n244:   # ═══════════════════════════════════════════════════════════════\n245:   phase_init:\n246:     purpose: Create all state files for the review session and resolve review scope\n247:     steps:\n248: \n249:       step_preflight_contract:\n250:         action: \"Validate required setup bindings and executable workflow contract before any file writes\"\n251:         verify:\n252:           - required_values_present: [review_target, review_target_type, review_dimensions, spec_folder, lineage_mode, max_iterations, convergence_threshold, convergence_mode, stop_policy]\n253:           - spec_folder_is_within: \"specs/ or .opencode/specs/ (canonicalize alias roots before validation)\"\n254:           - unresolved_placeholders: \"FAIL if any user-facing template references placeholders not produced by earlier steps\"\n255:           - tool_contract: \"FAIL if executable steps reference tools outside the command allowlist\"\n256:         on_fail: \"Halt with STATUS=FAIL and report the missing binding or unsupported contract reference\"\n257: \n258:       step_create_directories:\n259:         action: \"Create spec folder and canonical review packet directories if they don't exist\"\n260:         command: \"mkdir -p {state_paths.prompt_dir} {state_paths.iteration_dir} {state_paths.delta_dir}\"\n261: \n262:       step_detect_resource_map:\n263:         action: \"Detect resource-map.md before config creation so init can persist coverage-gate state\"\n264:         inspect:\n265:           - \"{spec_folder}/resource-map.md\"\n266:         classify:\n267:           present: \"resource-map.md exists at init\"\n268:           absent: \"resource-map.md does not exist at init\"\n269:         outputs:\n270:           - resource_map_present: \"Boolean true when {spec_folder}/resource-map.md exists, else false\"\n271:           - resource_map_known_context: \"When present: concise resource-map snapshot for Known Context and charter framing. When absent: 'resource-map.md not present; skipping coverage gate'.\"\n272: \n273:       step_migrate_legacy_review_state:\n274:         action: \"Rehome legacy review artifacts into review/iterations before session classification\"\n275:         detect:\n276:           canonical_review_state:\n277:             - \"{state_paths.config}\"\n278:             - \"{state_paths.state_log}\"\n279:             - \"{state_paths.findings_registry}\"\n280:             - \"{state_paths.strategy}\"\n281:           legacy_review_state:\n282:             - \"{spec_folder}/scratch/deep-research-config.json\"\n283:             - \"{spec_folder}/scratch/deep-research-state.jsonl\"\n284:             - \"{spec_folder}/scratch/deep-review-strategy.md\"\n285:             - \"{spec_folder}/scratch/deep-review-dashboard.md\"\n286:             - \"{spec_folder}/scratch/iteration-*.md\"\n287:             - \"{spec_folder}/scratch/.deep-research-pause\"\n288:             - \"{state_paths.local_packet_dir}/iteration-*.md\"\n289:             - \"{state_paths.legacy_root_report}\"\n290:           legacy_review_markers:\n291:             - \"scratch/deep-review-strategy.md exists\"\n292:             - \"scratch/deep-research-config.json declares mode == 'review' OR scratch/deep-research-state.jsonl contains mode == 'review'\"\n293:         migrate_only:\n294:           - \"{spec_folder}/scratch/deep-research-config.json -> {state_paths.config}\"\n295:           - \"{spec_folder}/scratch/deep-research-state.jsonl -> {state_paths.state_log}\"\n296:           - \"{spec_folder}/scratch/deep-review-strategy.md -> {state_paths.strategy}\"\n297:           - \"{spec_folder}/scratch/deep-review-dashboard.md -> {state_paths.dashboard}\"\n298:           - \"{spec_folder}/scratch/iteration-*.md -> {state_paths.iteration_dir}/\"\n299:           - \"{spec_folder}/scratch/.deep-research-pause -> {state_paths.pause_sentinel}\"\n300:           - \"{state_paths.local_packet_dir}/iteration-*.md -> {state_paths.iteration_dir}/\"\n301:           - \"{state_paths.legacy_root_report} -> {state_paths.review_output}\"\n302:         on_canonical_present: \"Leave canonical review/ state untouched and do not overwrite it with legacy scratch artifacts.\"\n303:         on_legacy_detected: \"Move only the review-specific whitelist, print LEGACY_REVIEW_STATE_MOVED and leave unrelated scratch files untouched. Nothing is appended here: an append before session classification would create the state log and turn a fresh packet into a partial one, and the moved state log was written without the ledger, so the gateway refuses every append to it until step_classify_session.on_moved_legacy_state adopts it.\"\n304:         on_conflict: \"If canonical review/ state and legacy scratch review state both exist but disagree, halt for operator repair instead of merging contradictory state.\"\n305:         outputs:\n306:           - legacy_migration_detected: \"true when the command printed LEGACY_REVIEW_STATE_MOVED, else false\"\n307:           - migration_recorded: \"false; step_record_artifact_migration sets it once the migration row is appended\"\n308:         command: |\n309:           mkdir -p {state_paths.iteration_dir}\n310:           if [ ! -e {state_paths.config} ] && [ ! -e {state_paths.state_log} ] && [ ! -e {state_paths.strategy} ] && [ -e {spec_folder}/scratch/deep-review-strategy.md ] && ( [ -e {spec_folder}/scratch/deep-research-config.json ] || [ -e {spec_folder}/scratch/deep-research-state.jsonl ] ); then\n311:             [ -e {spec_folder}/scratch/deep-research-config.json ] && mv {spec_folder}/scratch/deep-research-config.json {state_paths.config}\n312:             [ -e {spec_folder}/scratch/deep-research-state.jsonl ] && mv {spec_folder}/scratch/deep-research-state.jsonl {state_paths.state_log}\n313:             [ -e {spec_folder}/scratch/deep-review-strategy.md ] && mv {spec_folder}/scratch/deep-review-strategy.md {state_paths.strategy}\n314:             [ -e {spec_folder}/scratch/deep-review-dashboard.md ] && mv {spec_folder}/scratch/deep-review-dashboard.md {state_paths.dashboard}\n315:             find {spec_folder}/scratch -maxdepth 1 -name 'iteration-*.md' -exec mv {} {state_paths.iteration_dir}/ \\;\n316:             [ -e {spec_folder}/scratch/.deep-research-pause ] && mv {spec_folder}/scratch/.deep-research-pause {state_paths.pause_sentinel}\n317:             [ -e {state_paths.legacy_root_report} ] && mv {state_paths.legacy_root_report} {state_paths.review_output}\n318:             echo \"LEGACY_REVIEW_STATE_MOVED\"\n319:           fi\n320:           find {state_paths.local_packet_dir} -maxdepth 1 -name 'iteration-*.md' -exec mv {} {state_paths.iteration_dir}/ \\; 2>/dev/null || true\n321: \n322:       step_acquire_lock:\n323:         action: \"Acquire the single-writer advisory lock before session classification\"\n324:         command: \"node .skilled/skills/system-deep-loop/runtime/scripts/loop-lock.cjs acquire --lock-path {state_paths.lock_file} --packet-id {spec_folder} --ttl-ms 1800000\"\n325:         on_acquire: \"Capture lock.ownerPid as captured_owner_pid and lock.acquireNonce as captured_acquire_nonce from the JSON output, and reuse both for every release below. If acquired=false, fail closed — another deep-review run already holds this packet.\"\n326:         note: \"Uses the promoted runtime/ loop-lock CLI (single source of truth: stale-lock reclaim, clean owner-scoped release). macOS/BSD locking is advisory — best-effort single-writer, not a hard mutex across host calls. Acquire reclaims a stale lock itself and reports the old holder under `reclaimed`. A lock is stale when its heartbeat is older than twice its TTL, or when its owning process is known to be dead. No confirmation step exists in either mode: log a `reclaimed` holder and continue.\"\n327:         # Lock-cleanup contract: the lock file MUST be released on every terminal exit path that follows acquisition.\n328:         # Runtimes honoring step_acquire_lock are required to perform this cleanup before halting or pausing.\n329:         on_halt:\n330:           action: \"Release the lock before any terminal halt branch returns control\"\n331:           applies_to: [\"step_classify_session.on_invalid_state\", \"step_classify_session.on_completed_session\"]\n332:           command: \"node .skilled/skills/system-deep-loop/runtime/scripts/loop-lock.cjs release --lock-path {state_paths.lock_file} --owner-pid {captured_owner_pid} --nonce {captured_acquire_nonce}; failures here are logged but do not block the halt\"\n333:         on_cancel:\n334:           action: \"Release the lock on user cancel or pause-sentinel detection before sentinel processing\"\n335:           command: \"node .skilled/skills/system-deep-loop/runtime/scripts/loop-lock.cjs release --lock-path {state_paths.lock_file} --owner-pid {captured_owner_pid} --nonce {captured_acquire_nonce}; cancel completes regardless of cleanup result\"\n336:         on_workflow_exit:\n337:           action: \"Release the lock as the final step of any workflow exit path (success or failure)\"\n338:           command: \"node .skilled/skills/system-deep-loop/runtime/scripts/loop-lock.cjs release --lock-path {state_paths.lock_file} --owner-pid {captured_owner_pid} --nonce {captured_acquire_nonce}; idempotent — safe to invoke when already released\"\n339: \n340:       step_classify_session:\n341:         action: \"Classify the session before writing files\"\n342:         inspect:\n343:           - \"{state_paths.config}\"\n344:           - \"{state_paths.state_log}\"\n345:           - \"{state_paths.findings_registry}\"\n346:           - \"{state_paths.strategy}\"\n347:         classify:\n348:           fresh: \"None of the three state artifacts exist\"\n349:           resume: \"Config, JSONL, and strategy all exist and config.mode == 'review' and agree on target/spec folder\"\n350:           completed-session: \"Resume artifacts exist and config.status == 'complete'\"\n351:           invalid-state: \"Any partial, missing, or contradictory combination\"\n352:         outputs:\n353:           - session_state: \"fresh | resume | completed-session | invalid-state\"\n354:           - prior_tail_digest: \"sha256 of the state log bytes when resuming or restarting an existing lineage\"\n355:         lifecycle_routing:\n356:           - \"If lineage_mode == restart and session_state is resume or completed-session, execute on_restart before on_resume or on_completed_session.\"\n357:           - \"If lineage_mode == auto or lineage_mode == resume, preserve the existing resume/completed/fresh behavior.\"\n358:         on_resume:\n359:           before_append: \"Run on_moved_legacy_state first when it applies.\"\n360:           log: \"Auto-resume: state artifacts are complete and consistent. Continue the same lineage (sessionId unchanged, generation unchanged, no archive).\"\n361:           append_jsonl: '{\"stem\":\"deep_review.run_resumed\",\"scope\":{\"runId\":\"{session_id}\",\"sessionId\":\"{session_id}\",\"generation\":{generation}},\"data\":{\"priorTailDigest\":\"{prior_tail_digest}\",\"sourceSessionId\":\"{session_id}\",\"resumeReason\":\"Auto-resume: state artifacts are complete and consistent; continue the same lineage.\",\"continuedFromRunId\":\"{session_id}-i{iteration_count}\",\"compatibilityDecision\":\"exact\",\"recoveryReceiptRef\":\"none\"}}'\n362:           skip_to: phase_loop\n363:         on_restart:\n364:           action: \"Archive the current review packet under the root-level review-archive/ tree and start a new lineage segment with a fresh sessionId and generation+1.\"\n365:           command: \"if [ -d {state_paths.packet_dir} ]; then mkdir -p {state_paths.archive_root} && mv {state_paths.packet_dir} {state_paths.archive_root}/{timestamp_slug}; fi\"\n366:           set:\n367:             lineage_mode: \"restart\"\n368:             parent_session_id: \"{prior_session_id}\"\n369:             generation: \"{prior_generation + 1}\"\n370:           skip_to: step_create_config\n371:         note_deferred_branches: \"fork and completed-continue are deferred and no longer runtime-supported in this release. The reducer still reads `lineageMode` from config for dashboards and analysis, but only `new`, `resume`, and `restart` are live. See deep-review/references/protocol/loop-protocol.md §Lifecycle Branches for the one-session contract.\"\n372:         on_moved_legacy_state:\n373:           applies_when: \"legacy_migration_detected == true and the branch taken resumes the session or goes to synthesis; never on restart or cancel\"\n374:           order: \"Runs after classification and before that branch appends anything, the resume event included.\"\n375:           note: |\n376:             The state log moved out of scratch/ was written by hand before the ledger existed, so the\n377:             gateway refuses every append to it. Set it aside unchanged as deep-review-state.legacy.jsonl,\n378:             open the run from the moved config, then replay its iteration rows through the gateway,\n379:             which carries each one whole. Rows the gateway cannot carry stay only in the set-aside file,\n380:             and the replay reports how many. Exit 2 from any of the three is a halt.\n381:           set_aside_command: |\n382:             STATE_LOG=\"{state_paths.state_log}\"\n383:             LEGACY_LOG=\"$(dirname \"$STATE_LOG\")/deep-review-state.legacy.jsonl\"\n384:             if [ -e \"$LEGACY_LOG\" ]; then\n385:               echo \"A set-aside legacy state log already exists at $LEGACY_LOG. Repair the packet by hand.\" >&2\n386:               exit 1\n387:             fi\n388:             mv \"$STATE_LOG\" \"$LEGACY_LOG\"\n389:           open_run: \"Run step_create_state_log.command unchanged. With the hand-written log set aside, it opens the run from the moved config.\"\n390:           replay_command: |\n391:             GATEWAY=\".skilled/skills/system-deep-loop/runtime/scripts/append-mode-event.cjs\"\n392:             [ -f \"$GATEWAY\" ] || GATEWAY=\"scripts/append-mode-event.cjs\"\n393:             RUN_DIR=\"$(dirname \"{state_paths.state_log}\")\"\n394:             node -e '\n395:               const fs = require(\"fs\"), os = require(\"os\"), path = require(\"path\");\n396:               const { spawnSync } = require(\"child_process\");\n397:               const [gateway, legacyLog, runDir] = process.argv.slice(1);\n398:               let replayedIterations = 0;\n399:               let keptOnlyInLegacyLog = 0;\n400:               for (const line of fs.readFileSync(legacyLog, \"utf8\").split(\"\\n\")) {\n401:                 if (line.trim() === \"\") continue;\n402:                 let row;\n403:                 try { row = JSON.parse(line); } catch { keptOnlyInLegacyLog += 1; continue; }\n404:                 // The run open already replaced the config row.\n405:                 if (row && row.type === \"config\") continue;\n406:                 if (!row || row.type !== \"iteration\") { keptOnlyInLegacyLog += 1; continue; }\n407:                 const tempDir = fs.mkdtempSync(path.join(os.tmpdir(), \"deep-review-replay-\"));\n408:                 const eventFile = path.join(tempDir, \"row.json\");\n409:                 fs.writeFileSync(eventFile, JSON.stringify(row));\n410:                 const result = spawnSync(process.execPath, [gateway, \"--mode\", \"review\", \"--run-directory\", runDir, \"--event-json\", eventFile], { encoding: \"utf8\" });\n411:                 fs.rmSync(tempDir, { recursive: true, force: true });\n412:                 if (result.status === 2) { process.stdout.write(result.stdout || \"\"); process.exit(2); }\n413:                 if (result.status === 0) replayedIterations += 1; else keptOnlyInLegacyLog += 1;\n414:               }\n415:               process.stdout.write(JSON.stringify({ replayedIterations, keptOnlyInLegacyLog, legacyLog }) + \"\\n\");\n416:             ' \"$GATEWAY\" \"$RUN_DIR/deep-review-state.legacy.jsonl\" \"$RUN_DIR\"\n417:         on_completed_session:\n418:           before_append: \"Run on_moved_legacy_state first when it applies.\"\n419:           log: \"Prior session already completed. Either archive the completed review/ tree and start a fresh session, or jump straight to synthesis with the existing artifacts.\"\n420:           skip_to: phase_synthesis\n421:         on_invalid_state:\n422:           halt: true\n423:           message: \"Existing deep-review state in review/ is incomplete or contradictory. Repair or archive the invalid review packet before continuing.\"\n424:         on_fresh:\n425:           action: \"Proceed with a new session\"\n426: \n427:       step_scope_discovery:\n428:         action: \"Resolve review target to a concrete file list based on target type\"\n429:         resolve:\n430:           spec-folder: |\n431:             1. Inspect spec.md, plan.md, tasks.md, acceptance-criteria.md, implementation-summary.md, and goal-file-manifest.txt when present\n432:             2. If goal-file-manifest.txt exists, parse one repo-relative path per non-empty, non-comment line; reject absolute paths, traversal outside repo_root, duplicates, missing paths, and non-file entries\n433:             3. Fail before dispatch with line-numbered validation errors when any manifest entry is invalid; otherwise set scope = the validated manifest paths in declared order\n434:             4. When no manifest exists, discover implementation files referenced in the canonical spec artifacts\n435:             5. Discover test files associated with the implementation files\n436:             6. Set scope = all discovered implementation and test files\n437:           skill: |\n438:             1. Read SKILL.md from .skilled/skills/{skill_name}/\n439:             2. Discover references/, assets/, scripts/ contents\n440:             3. Find agent definitions referencing this skill across runtimes\n441:             4. Find command entry points referencing this skill\n442:             5. Set scope = all discovered files\n443:           agent: |\n444:             1. Find agent definition across repo-managed runtimes (.claude/agents/, .skilled/agents/)\n445:             2. Compare agent definitions for consistency\n446:             3. Set scope = all discovered agent files\n447:           track: |\n448:             1. List all child spec folders under specs/{track}/ or .opencode/specs/{track}/\n449:             2. For each: read spec.md + acceptance-criteria.md\n450:             3. Set scope = all child spec artifacts\n451:           files: |\n452:             1. Expand glob patterns from review_target\n453:             2. Validate all files exist\n454:             3. Discover immediate cross-references (imports, links)\n455:             4. Set scope = expanded file list + cross-references\n456:         outputs:\n457:           - review_scope_files: \"List of all files in review scope\"\n458:           - cross_reference_targets: \"{ spec_paths: [...], code_paths: [...], test_paths: [...] }\"\n459: \n460:       step_order_dimensions:\n461:         action: \"Order review dimensions based on risk priority\"\n462:         algorithm: |\n463:           1. Iteration 0 (inventory pass): Build artifact map, identify file types, estimate complexity\n464:           2. Subsequent iterations follow risk-ordered deep passes:\n465:              correctness → security → traceability → maintainability\n466:           3. If review_dimensions != \"all\", filter to only requested dimensions\n467:           4. Derive traceability protocol plan:\n468:              - core: spec_code, checklist_evidence\n469:              - overlay: skill_agent, agent_cross_runtime, feature_catalog_code, playbook_capability\n470:           5. If resource_map_present, reserve at least one traceability-oriented pass to cross-check target_files from applied/T-*.md against resource-map.md and classify touched / expected-by-scope / gap / absent-from-map outcomes\n471:           6. Store ordered list as dimension_queue\n472:         outputs:\n473:           - dimension_queue: \"Ordered list of dimensions to review\"\n474:           - inventory_pass: true\n475: \n476:       step_normalize_review_dimensions:\n477:         action: \"Normalize reviewDimensions once during init for config + JSONL reuse\"\n478:         outputs:\n479:           - review_dimensions_normalized: \"Canonical string[] for deep-review-config.json\"\n480:           - review_dimensions_json: \"JSON.stringify(review_dimensions_normalized) for JSONL config record\"\n481:         normalize: |\n482:           Accept {review_dimensions} in any of these shapes and convert once:\n483:             - \"all\" → [\"correctness\",\"security\",\"traceability\",\"maintainability\"]\n484:             - \"correctness,security\" → [\"correctness\",\"security\"]\n485:             - [\"correctness\"] → [\"correctness\"]\n486:           Every element MUST be one of the four canonical dimension names.\n487: \n488:       step_normalize_review_focus:\n489:         action: \"Normalize the optional operator review focus once during init\"\n490:         outputs:\n491:           - review_focus_normalized: \"Single-line focus text, or empty string when no focus was given\"\n492:         normalize: |\n493:           Collapse every control character (C0, C1, DEL, U+2028, U+2029) and whitespace run to one space, trim, treat an empty result as absent, and fail setup when more than 1000 characters remain.\n494:           fanout-run.cjs applies the same rule in code, so a fan-out lineage receives the same text.\n495: \n496:       step_resolve_session_id:\n497:         action: \"Resolve init session id from caller when supplied, else preserve timestamp fallback\"\n498:         branch_on: \"session_id\"\n499:         if_present:\n500:           bind:\n501:             session_id_init: \"{session_id}\"\n502:         if_absent:\n503:           bind:\n504:             session_id_init: \"{ISO_8601_NOW}\"\n505: \n506:       step_create_config:\n507:         action: \"Create deep-review-config.json from template with review-specific fields\"\n508:         template: .skilled/skills/system-deep-loop/deep-review/assets/deep-review-config.json\n509:         populate:\n510:           topic: \"Review: {review_target}\"\n511:           mode: \"review\"\n512:           sessionId: \"{session_id_init}\"\n513:           parentSessionId: null\n514:           lineageMode: \"new\"\n515:           generation: 1\n516:           continuedFromRun: null\n517:           reviewTarget: \"{review_target}\"\n518:           reviewTargetType: \"{review_target_type}\"\n519:           # Reuse the single normalized init-time value from step_normalize_review_dimensions.\n520:           reviewDimensions: \"{review_dimensions_normalized}\"\n521:           # Null when review_focus_normalized is empty. The review report reads it back to show the focus.\n522:           reviewFocus: \"{review_focus_normalized}\"\n523:           resource_map_present: \"{resource_map_present}\"\n524:           reviewScopeFiles: \"{review_scope_files}\"\n525:           severityThreshold: \"P2\"\n526:           crossReference:\n527:             core: [\"spec_code\", \"checklist_evidence\"]\n528:             overlay: [\"skill_agent\", \"agent_cross_runtime\", \"feature_catalog_code\", \"playbook_capability\"]\n529:           maxIterations: \"{max_iterations}\"\n530:           # Semantic: weighted P0/P1/P2 severity ratio. See SKILL.md §\"Convergence Threshold Semantics\".\n531:           convergenceThreshold: \"{convergence_threshold}\"\n532:           antiConvergence.convergenceMode: \"{convergence_mode}\"\n533:           antiConvergence.divergent: {}\n534:           stopPolicy: \"{stop_policy}\"\n535:           stuckThreshold: 2\n536:           maxDurationMinutes: 120\n537:           specFolder: \"{spec_folder}\"\n538:           # Honor the parsed --no-resource-map flag from deep-review.md:71 (default true; false when flag is set).\n539:           # The markdown command parses $ARGUMENTS and binds {resource_map_emit} before this step runs.\n540:           resource_map.emit: \"{resource_map_emit}\"\n541:           createdAt: \"{ISO_8601_NOW}\"\n542:           status: \"initialized\"\n543:           releaseReadinessState: \"in-progress\"\n544:           executionMode: \"auto\"\n545:         output: \"{state_paths.config}\"\n546: \n547:       step_create_state_log:\n548:         action: \"Open the run in the ledger: record deep_review.run_initialized through the append gateway, which writes the state log's first row\"\n549:         note: |\n550:           The state log is a projection the gateway rebuilds from the ledger, so this step never writes\n551:           it directly. A config row written beside the ledger carries keys the projection cannot\n552:           rebuild, and the projection refuses to drop them, so every later append in the run would\n553:           commit to the ledger and then exit 2. Recording the run's opening as a ledger event makes\n554:           the projected config row the state log's first row from the start. The full config stays\n555:           in deep-review-config.json, which is what the reducer reads.\n556:         command: |\n557:           GATEWAY=\".skilled/skills/system-deep-loop/runtime/scripts/append-mode-event.cjs\"\n558:           [ -f \"$GATEWAY\" ] || GATEWAY=\"scripts/append-mode-event.cjs\"\n559:           EVENT_FILE=\"$(mktemp \"${TMPDIR:-/tmp}/deep-review-run-open.XXXXXX\")\"\n560:           node -e '\n561:             const fs = require(\"fs\"), crypto = require(\"crypto\");\n562:             const [configPath, workflowPath] = process.argv.slice(1);\n563:             const sha = (bytes) => crypto.createHash(\"sha256\").update(bytes).digest(\"hex\");\n564:             const raw = fs.readFileSync(configPath);\n565:             const config = JSON.parse(raw);\n566:             const targetTypes = { files: \"file\", file: \"file\", directory: \"directory\", \"spec-folder\": \"directory\", track: \"directory\", repository: \"repository\" };\n567:             const lineageModes = { new: \"fresh\", fresh: \"fresh\", restart: \"restart\", resume: \"resume\" };\n568:             // The projected config row shows this topic; one the schema cannot hold is left out,\n569:             // and the row falls back to the run id rather than the run failing to open.\n570:             const topic = typeof config.topic === \"string\" && config.topic.trim() !== \"\" && config.topic.length <= 4096\n571:               ? config.topic\n572:               : null;\n573:             process.stdout.write(JSON.stringify({\n574:               stem: \"deep_review.run_initialized\",\n575:               scope: { runId: config.sessionId, sessionId: config.sessionId, generation: Number(config.generation) || 1 },\n576:               data: {\n577:                 target: {\n578:                   targetId: \"review-target\",\n579:                   targetType: targetTypes[config.reviewTargetType] || \"artifact\",\n580:                   artifactRef: \"deep-review-config.json#reviewTarget\",\n581:                   sourceDigest: sha(String(config.reviewTarget)),\n582:                   contentDigest: sha(raw),\n583:                 },\n584:                 lineageMode: lineageModes[config.lineageMode] || \"fresh\",\n585:                 maxIterations: Number(config.maxIterations),\n586:                 convergencePolicyVersion: \"convergence-policy@\" + ((config.antiConvergence && config.antiConvergence.convergenceMode) || \"default\"),\n587:                 reviewModeContractDigest: sha(fs.readFileSync(workflowPath)),\n588:                 initialReleaseReadinessState: \"not-assessed\",\n589:                 ...(topic === null ? {} : { topic }),\n590:               },\n591:             }));\n592:           ' \"{state_paths.config}\" \".skilled/commands/deep/assets/deep-review-auto.yaml\" > \"$EVENT_FILE\" || { rm -f \"$EVENT_FILE\"; exit 1; }\n593:           node \"$GATEWAY\" --mode review --run-directory \"$(dirname \"{state_paths.state_log}\")\" --event-json \"$EVENT_FILE\"\n594:           STATUS=$?\n595:           rm -f \"$EVENT_FILE\"\n596:           exit \"$STATUS\"\n597:         output: \"{state_paths.state_log}\"\n598: \n599:       step_record_restarted_run:\n600:         skip_when: \"lineage_mode != 'restart'\"\n601:         action: \"Record the restarted lineage after the run-open row so the restart marker never precedes deep_review.run_initialized\"\n602:         append_jsonl: '{\"stem\":\"deep_review.run_restarted\",\"scope\":{\"runId\":\"{session_id}\",\"sessionId\":\"{session_id}\",\"generation\":{generation}},\"data\":{\"priorTailDigest\":\"{prior_tail_digest}\",\"archivedLineageId\":\"{prior_session_id}\",\"restartReason\":\"Restart requested: the prior review packet was archived and a new lineage segment opened.\",\"continuedFromRunId\":\"{prior_session_id}-i{iteration_count}\",\"compatibilityDecision\":\"exact\",\"recoveryReceiptRef\":\"none\"}}'\n603: \n604:       step_create_findings_registry:\n605:         action: \"Initialize reducer-owned review findings registry\"\n606:         content: '{\"sessionId\":\"{session_id_init}\",\"generation\":1,\"lineageMode\":\"new\",\"openFindings\":[],\"resolvedFindings\":[],\"repeatedFindings\":[],\"dimensionCoverage\":{\"correctness\":false,\"security\":false,\"traceability\":false,\"maintainability\":false},\"findingsBySeverity\":{\"P0\":0,\"P1\":0,\"P2\":0},\"openFindingsCount\":0,\"resolvedFindingsCount\":0,\"convergenceScore\":0.0}'\n607:         output: \"{state_paths.findings_registry}\"\n608: \n609:       step_create_strategy:\n610:         action: \"Create review strategy file from deep-review-strategy.md template\"\n611:         template: .skilled/skills/system-deep-loop/deep-review/assets/deep-review-strategy.md\n612:         populate:\n613:           review_target: \"{review_target}\"\n614:           review_target_type: \"{review_target_type}\"\n615:           dimensions: \"{dimension_queue}\"\n616:           scope_files: \"{review_scope_files}\"\n617:           cross_reference_targets: \"{cross_reference_targets}\"\n618:           max_iterations: \"{max_iterations}\"\n619:           convergence_threshold: \"{convergence_threshold}\"\n620:           stop_policy: \"{stop_policy}\"\n621:         output: \"{state_paths.strategy}\"\n622: \n623:       step_seed_coverage_graph:\n624:         action: \"Seed the review coverage graph before the first convergence check\"\n625:         transform: |\n626:           1. Convert review_scope_files into FILE nodes.\n627:           2. Convert review target groupings into coarse SLICE nodes only; do not expand SYMBOL\n628:              or DEPENDENCY nodes in review mode.\n629:           3. Emit COVERS edges from SLICE nodes to FILE nodes when the grouping is known.\n630:           4. Bind coverage_seed_source to \"scope_discovery\" and coverage_seed_confidence to 0.50.\n631:           5. When scope discovery yields no files, emit [] for both arrays; the upsert script\n632:              returns a warning and review continues with an empty graph.\n633:         bash: \"node .skilled/skills/system-deep-loop/runtime/scripts/upsert.cjs --spec-folder \\\"{spec_folder}\\\" --loop-type \\\"review\\\" --session-id \\\"{config.sessionId}\\\" --nodes '{coverage_seed_nodes_json}' --edges '{coverage_seed_edges_json}' --seed-source \\\"{coverage_seed_source}\\\" --seed-confidence \\\"{coverage_seed_confidence}\\\"\"\n634:         outputs:\n635:           - coverage_seed_nodes_json: \"Seed nodes for review SLICE and FILE kinds only\"\n636:           - coverage_seed_edges_json: \"Seed COVERS edges where review target groupings resolved\"\n637:           - coverage_seed_warning: \"Warning emitted when the seed batch inserts zero nodes, else empty\"\n638:         on_warning:\n639:           log: \"Coverage graph seed inserted zero nodes; continuing with an empty graph.\"\n640:           proceed: true\n641: \n642:       step_enrich_strategy_context:\n643:         action: \"Ensure Known Context is written only after strategy.md exists\"\n644:         condition: \"prior_context_found\"\n645:         edit: \"{state_paths.strategy}\"\n646:         note: \"Append or replace the Known Context section with prior_context_summary and retained detail from prior_context\"\n647: \n648:       step_enrich_strategy_resource_map:\n649:         action: \"Inject resource-map status into Known Context after strategy.md exists\"\n650:         edit: \"{state_paths.strategy}\"\n651:         note: \"When resource_map_present is true, append the resource_map_known_context snapshot and add Resource Map Coverage to the Review Charter. When false, append 'resource-map.md not present; skipping coverage gate'.\"\n652: \n653:       step_init_complete:\n654:         log: \"Initialization complete. Config, state, and strategy files created. Review scope: {review_scope_files_count} files, {dimension_queue_count} dimensions.\"\n655:         set: { current_iteration: 1, stuck_count: 0, p0_count: 0, p1_count: 0, p2_count: 0 }\n656: \n657:   # ═══════════════════════════════════════════════════════════════\n658:   # PHASE 2: ITERATION LOOP\n659:   # ═══════════════════════════════════════════════════════════════\n660:   phase_loop:\n661:     purpose: Dispatch review agent iterations until convergence\n662:     repeat: true\n663:     max_repeats: \"{max_iterations}\"\n664:     steps:\n665: \n666:       step_refresh_lock:\n667:         action: \"Refresh the packet lock heartbeat before the iteration begins\"\n668:         command: \"node .skilled/skills/system-deep-loop/runtime/scripts/loop-lock.cjs refresh --lock-path {state_paths.lock_file} --owner-pid {captured_owner_pid} --nonce {captured_acquire_nonce}\"\n669:         on_refresh: \"If the refresh output has refreshed:false, fail closed: lost the packet lock. This run no longer holds the packet and must stop rather than iterate without it.\"\n670: \n671:       step_record_artifact_migration:\n672:         action: \"Record the legacy review state move once per session, after the run is open\"\n673:         skip_when: \"legacy_migration_detected != true or migration_recorded == true\"\n674:         append_jsonl: '{\"stem\":\"deep_review.migration\",\"scope\":{\"runId\":\"{session_id}\",\"sessionId\":\"{session_id}\"},\"data\":{\"mode\":\"review\",\"legacyArtifacts\":[\"deep-research-config.json\",\"deep-research-state.jsonl\",\".deep-research-pause\"],\"canonicalArtifacts\":[\"deep-review-config.json\",\"deep-review-state.jsonl\",\".deep-review-pause\"]}}'\n675:         set: { migration_recorded: true }\n676: \n677:       step_read_state:\n678:         action: \"Read current state from JSONL, strategy, and config\"\n679:         read:\n680:           - \"{state_paths.state_log}\"\n681:           - \"{state_paths.findings_registry}\"\n682:           - \"{state_paths.strategy}\"\n683:           - \"{state_paths.config}\"\n684:         extract:\n685:           - iteration_count: \"Count distinct run values (the integer iteration, else a numeric run) across lines where type === 'iteration'; a redispatched run counts once\"\n686:           - highest_run: \"Highest run value (the integer iteration, else a numeric run) across lines where type === 'iteration', else 0\"\n687:           - current_iteration: \"max(highest_run, iteration_count) + 1\"\n688:           - last_newFindingsRatio: \"Extract newFindingsRatio from last iteration record\"\n689:           - last_focus: \"Extract focus/dimension from latest iteration record, else 'none yet'\"\n690:           - ratio_prev: \"Extract newFindingsRatio from second-latest iteration record, else 'N/A'\"\n691:           - ratio_latest: \"Extract newFindingsRatio from latest iteration record, else 'N/A'\"\n692:           - next_dimension: \"Next uncovered dimension from dimension_queue in strategy.md\"\n693:           - dimensions_covered: \"List of dimensions already reviewed\"\n694:           - dimensions_remaining: \"List of dimensions not yet reviewed\"\n695:           - dimension_coverage: \"covered / total dimensions\"\n696:           - coverage_age: \"Iterations since dimension coverage last changed; require >= 1 before STOP\"\n697:           - p0_count: \"Count P0 findings across all iterations\"\n698:           - p1_count: \"Count P1 findings across all iterations\"\n699:           - p2_count: \"Count P2 findings across all iterations\"\n[Output truncated. Continue reading with offset: 700]","title":"read","metadata":{"metadata":{"truncated":true},"content":[{"type":"text","text":"Read file .skilled/commands/deep/assets/deep-review-auto.yaml, lines 1-699\n1: # ─────────────────────────────────────────────────────────────────\n2: # DEEP REVIEW: AUTONOMOUS DEEP REVIEW LOOP (AUTO MODE)\n3: # ─────────────────────────────────────────────────────────────────\n4: # DEEP REVIEW: AUTONOMOUS DEEP REVIEW LOOP (AUTO MODE)\n5: # ─────────────────────────────────────────────────────────────────\n6: role: Deep Review Loop Manager\n7: purpose: Iterative code/spec review with convergence detection across review dimensions\n8: action: Run deep-review loop from initialization through synthesis\n9: operating_mode:\n10:   workflow: iterative_loop\n11:   workflow_compliance: MANDATORY\n12:   workflow_execution: autonomous\n13:   approvals: none\n14:   tracking: progressive_review_state\n15:   validation: convergence_detection\n16: \n17: # ─────────────────────────────────────────────────────────────────\n18: # OPERATING PRINCIPLES\n19: # ─────────────────────────────────────────────────────────────────\n20: operating_principles:\n21:   core: \"Fresh context per iteration + externalized state = no context degradation\"\n22:   approach: \"Dispatch focused review agent per dimension, evaluate convergence, repeat or stop\"\n23:   mandate: \"Never hold findings in memory; write everything to files. Review target is READ-ONLY.\"\n24: \n25: # ─────────────────────────────────────────────────────────────────\n26: # USER INPUTS (from setup phase)\n27: # ─────────────────────────────────────────────────────────────────\n28: user_inputs:\n29:   review_target: \"[REVIEW_TARGET] - What to review. REQUIRED.\"\n30:   review_target_type: \"[spec-folder|skill|agent|track|files] - Target type for scope derivation. REQUIRED.\"\n31:   review_dimensions: \"[all|correctness,security,traceability,maintainability] - Dimensions to check. Default: all.\"\n32:   review_focus: \"[optional free text] - Operator review focus that every iteration covers in addition to its dimension. Default: empty, which leaves the prompt unchanged.\"\n33:   spec_folder: \"[SPEC_FOLDER] - Spec folder path for state files. REQUIRED.\"\n34:   session_id: \"[SESSION_ID] - Optional caller-supplied session id for fan-out lineages. Default: timestamp.\"\n35:   lineage_mode: \"[auto|resume|restart] - Session lifecycle intent. Default: auto. The runtime only persists lineage events for `resume` (same sessionId, no archive) and `restart` (new sessionId, generation+1, prior review/ archived). `fork` and `completed-continue` are deferred and no longer accepted — see deep-review/references/protocol/loop-protocol.md §Lifecycle Branches.\"\n36:   max_iterations: 7\n37:   convergence_threshold: 0.10\n38:   convergence_mode: \"[default|off|sliding-window|divergent] - Convergence policy modifier. Default: default.\"\n39:   stop_policy: \"[convergence|max-iterations] - Stop behavior. Default: convergence. max-iterations treats convergence as telemetry until the hard iteration ceiling.\"\n40:   config.fanout_lineage_artifact_dir: \"[optional internal path] - Fan-out lineage artifact override for command-owned single-lineage execution.\"\n41: \n42: # ─────────────────────────────────────────────────────────────────\n43: # CONTEXT LOADING\n44: # ─────────────────────────────────────────────────────────────────\n45: context_loading:\n46:   trigger: \"At workflow START, before phase_init\"\n47:   purpose: \"Load prior review context for the target and buffer it until strategy.md exists\"\n48:   retrieval:\n49:     mechanism: \"continuity-ladder-then-ripgrep\"\n50:     note: \"File reads only. Nothing here needs a running daemon, and every step is reproducible by hand.\"\n51:     ladder:\n52:       - \"{spec_folder}/handover.md when present\"\n53:       - \"the _memory.continuity frontmatter block in {spec_folder}/implementation-summary.md\"\n54:       - \"the packet's canonical spec docs, spec.md and decision-record.md, for what the first two steps leave open\"\n55:     free_text_recipe: \"rg --no-config --json --fixed-strings --ignore-case -C 2 --glob '*.md' --glob '!**/z_archive/**' --glob '!**/node_modules/**' -- '{review_target}' specs .skilled\"\n56:     recipe_contract: \".skilled/skills/system-spec-kit/references/retrieval/retrieval-conventions.md\"\n57:     exit_status: \"0 is a hit set, 1 is a clean no-hit, 2 or higher is a failure that must be surfaced instead of reported as no-hit\"\n58:     ranking: \"Ripgrep does not rank. Order the hits caller-side with the tuple in retrieval-conventions.md section 5.\"\n59:   when_to_skip: [\"User says 'skip context' or 'fresh start'\"]\n60:   behavior:\n61:     if_context_found: \"Store full results as prior_context plus a concise prior_context_summary; inject after strategy.md is created.\"\n62:     if_no_context: \"Set prior_context and prior_context_summary to 'None' and continue.\"\n63: \n64: # ─────────────────────────────────────────────────────────────────\n65: # SKILL REFERENCE\n66: # ─────────────────────────────────────────────────────────────────\n67: skill_reference:\n68:   skill: system-deep-loop\n69:   skill_md: .skilled/skills/system-deep-loop/deep-review/SKILL.md\n70:   references:\n71:     loop_protocol: .skilled/skills/system-deep-loop/deep-review/references/protocol/loop-protocol.md\n72:     state_format: .skilled/skills/system-deep-loop/deep-review/references/state/state-format.md\n73:     convergence: .skilled/skills/system-deep-loop/deep-review/references/convergence/convergence.md\n74:   templates:\n75:     config: .skilled/skills/system-deep-loop/deep-review/assets/deep-review-config.json\n76:     strategy: .skilled/skills/system-deep-loop/deep-review/assets/deep-review-strategy.md\n77: \n78: # ─────────────────────────────────────────────────────────────────\n79: # AGENT CONFIGURATION\n80: # ─────────────────────────────────────────────────────────────────\n81: agent_config:\n82:   agent: deep-review\n83:   agent_file: \".skilled/agents/deep-review.md\"\n84:   # Canonical path. Runtime-specific directories (e.g. .claude/agents/) reference this source.\n85:   mode: subagent\n86:   model: opus\n87:   leaf_only: true\n88:   tools: [Read, Write, Edit, Bash, Grep, Glob]\n89:   mcp_servers: []\n90:   tool_call_budget: { target: 9, soft_max: 12, hard_max: 13 }\n91: \n92: # ─────────────────────────────────────────────────────────────────\n93: # STATE FILE PATHS\n94: # ─────────────────────────────────────────────────────────────────\n95: # ─────────────────────────────────────────────────────────────────\n96: # CANONICAL STATE WRITE MECHANISM\n97: # ─────────────────────────────────────────────────────────────────\n98: state_write_protocol:\n99:   mechanism: \"append-gateway\"\n100:   command: \"node .skilled/skills/system-deep-loop/runtime/scripts/append-mode-event.cjs --mode review --run-directory {artifact_dir} --event-json <record file>\"\n101:   applies_to: \"every append_to_jsonl and append_jsonl directive in this workflow\"\n102:   refusal_handling: \"halt on exit 2; never fall back to a direct file write. Exit 1 on a row that is still routed through the gateway is a workflow defect and halts; the pinned_bookkeeping rows are recorded through bookkeeping_log and are never routed.\"\n103:   pinned_bookkeeping:\n104:     events: [config_warning, lock_released, pivot_confirm_accepted, manualStop, pivot_override_accepted]\n105:     directive: \"bookkeeping_log\"\n106:     handling: \"These rows are workflow bookkeeping that the review ledger schema pins to the legacy path: they have no lossless review-event target, so the gateway would refuse them with exit 1 and write nothing. They are never sent to the gateway. The step prints the row in its log line and continues; none of them is a halt condition.\"\n107:   contract: |\n108:     The directives below specify WHAT to record; this block specifies the mechanism. The gateway\n109:     authorizes the write against the mode's durable authority record, serialises it behind the\n110:     ledger fence, returns a receipt, and refreshes state_log from the ledger. Exit 0 means the\n111:     record is durable in the ledger and the refreshed state_log carries it. Exit 2 means it was\n112:     refused, and the refusal names the check that failed.\n113: \n114:     Writing state_log directly bypasses ordering, authorization, and the receipt. Two writers\n115:     can then interleave with no shared ordering, and a record nobody authorized carries no\n116:     receipt, so a later reader cannot tell an accepted record from an invented one. A refusal\n117:     is a halt, never a reason to write the file directly.\n118: \n119:     There is no direct-append exception. state_log is a projection the gateway rebuilds from\n120:     the ledger, so a row written beside it is dropped by the next refresh: the migration\n121:     marker, the recovery baseline, the iteration-error row and the claim-adjudication gate\n122:     row are canonical ledger events like every other record.\n123: \n124: state_paths:\n125:   # Template paths document the canonical packet layout. Runtime resolution happens via\n126:   # step_resolve_artifact_root plus the shared resolver, so root specs keep\n127:   # root-local review/ and child phases keep local review/ packet dirs.\n128:   # Canonical root-spec write targets remain review/deep-review-config.json,\n129:   # review/deep-review-state.jsonl, and review/deep-review-findings-registry.json.\n130:   packet_dir: \"{artifact_dir}\"\n131:   local_packet_dir: \"{spec_folder}/review\"\n132:   legacy_root_report: \"{spec_folder}/review-report.md\"\n133:   config: \"{artifact_dir}/deep-review-config.json\"\n134:   state_log: \"{artifact_dir}/deep-review-state.jsonl\"\n135:   findings_registry: \"{artifact_dir}/deep-review-findings-registry.json\"\n136:   strategy: \"{artifact_dir}/deep-review-strategy.md\"\n137:   dashboard: \"{artifact_dir}/deep-review-dashboard.md\"\n138:   pause_sentinel: \"{artifact_dir}/.deep-review-pause\"\n139:   lock_file: \"{artifact_dir}/.deep-review.lock\"\n140:   prompt_dir: \"{artifact_dir}/prompts\"\n141:   iteration_dir: \"{artifact_dir}/iterations\"\n142:   iteration_pattern: \"{artifact_dir}/iterations/iteration-{NNN}.md\"\n143:   # Per-iteration structured delta stream — complement to the canonical state_log\n144:   # append. MUST contain at least one record with `type === \"iteration\"`; variants\n145:   # like `\"iteration_delta\"` are silently dropped by the reducer.\n146:   delta_dir: \"{artifact_dir}/deltas\"\n147:   delta_pattern: \"{artifact_dir}/deltas/iter-{NNN}.jsonl\"\n148:   review_output: \"{artifact_dir}/review-report.md\"\n149:   resource_map_output: \"{artifact_dir}/resource-map.md\"\n150:   archive_root: \"{artifact_archive_root}\"\n151: \n152: # ─────────────────────────────────────────────────────────────────\n153: # WORKFLOW\n154: # ─────────────────────────────────────────────────────────────────\n155: workflow:\n156: \n157:   step_resolve_artifact_root:\n158:     description: \"Resolve artifact directory — use fan-out lineage override when provided, else resolve from spec_folder\"\n159:     note: \"Root specs keep review artifacts directly in {spec_folder}/review/. Child phases and sub-phases keep local packet directories in {spec_folder}/review/{packet}/, and archives stay local at {spec_folder}/review-archive/{packet}/.\"\n160:     branch_on: \"config.fanout_lineage_artifact_dir\"\n161:     if_present:\n162:       bind:\n163:         artifact_dir: \"{config.fanout_lineage_artifact_dir}\"\n164:         artifact_root_dir: \"{config.fanout_lineage_artifact_dir}\"\n165:         artifact_subfolder: null\n166:         artifact_archive_root: \"{config.fanout_lineage_artifact_dir}/_archive\"\n167:     if_absent:\n168:       command: \"node -e \\\"const { resolveArtifactRoot } = require('./.skilled/skills/system-spec-kit/shared/review-research-paths.cjs'); console.log(JSON.stringify(resolveArtifactRoot('{spec_folder}', 'review')));\\\"\"\n169:       outputs:\n170:         - artifact_root_dir: \"Resolved local review owner directory\"\n171:         - artifact_subfolder: \"Local packet subfolder ({ownerSlug}-pt-{NN}), else null\"\n172:         - artifact_dir: \"Resolved review packet directory for this target\"\n173:         - artifact_archive_root: \"Resolved local review archive directory for this target\"\n174: \n175:   step_bind_reducer_artifact_arg:\n176:     description: \"Keep the reducer on the lineage-owned artifact directory during fan-out\"\n177:     branch_on: \"config.fanout_lineage_artifact_dir\"\n178:     if_present:\n179:       bind:\n180:         reducer_artifact_arg: \"--artifact-dir {artifact_dir}\"\n181:     if_absent:\n182:       bind:\n183:         reducer_artifact_arg: \"\"\n184: \n185:   step_apply_lifecycle_request:\n186:     description: \"Honor explicit auto-mode restart before fan-out or normal initialization\"\n187:     skip_when: \"lineage_mode != 'restart'\"\n188:     instructions: |\n189:       This is the autonomous equivalent of the confirm-mode restart choice. Run it\n190:       immediately after artifact resolution and before fan-out so old packet files\n191:       cannot be merged with fresh lineage outputs. A restart request must never\n192:       fall back to auto-resume. In auto mode, the explicit restart flag is operator\n193:       authorization to archive the resolved review packet, so do not ask for a\n194:       second confirmation. Rollback is to move the timestamped archive back to\n195:       the packet directory.\n196:     command: \"if [ -d \\\"{state_paths.packet_dir}\\\" ]; then mkdir -p \\\"{state_paths.archive_root}\\\" && mv \\\"{state_paths.packet_dir}\\\" \\\"{state_paths.archive_root}/{timestamp_slug}\\\"; fi; mkdir -p \\\"{state_paths.packet_dir}\\\"\"\n197:     outputs:\n198:       - archived_path: \"{state_paths.archive_root}/{timestamp_slug} when a prior packet existed, else null\"\n199:       - lineage_mode: \"restart\"\n200:     on_fail: \"Halt with STATUS=FAIL; do not continue as resume or auto.\"\n201: \n202:   step_fanout_spawn:\n203:     description: \"Spawn fan-out lineages; skip and proceed to phase_init normally when single-executor\"\n204:     skip_when: \"config.fanout is absent\"\n205:     instructions: |\n206:       Fan-out mode is active. Spawn all lineages. Each lineage runs the full loop in its own\n207:       isolated sub-packet under {artifact_dir}/lineages/{label}/.\n208:       This step runs before phase_init, so pass the raw review_focus. fanout-run.cjs\n209:       normalizes it and hands every lineage the same single-line text. Escape any double\n210:       quote, backslash, dollar sign or backtick in it for the shell, and pass an empty\n211:       string when no focus was given.\n212:       A cli-opencode lineage inside this fan-out is an explicit parallel-detached OpenCode\n213:       session with a separate lineage directory and session id; it is not the single-executor\n214:       self-invocation path. fanout-run.cjs owns the stack-only recursion guard for that\n215:       first-level detached lineage and still blocks recursive same-kind dispatch from inside it.\n216:       fanout-run.cjs owns native and CLI lineage execution; native is run through the\n217:       deep/review command surface with config.fanout_lineage_artifact_dir so the LEAF\n218:       deep-review agent is used only for individual iterations, never as a full-loop\n219:       sub-agent or pasted phase-running prompt.\n220:       After all lineages complete, jump directly to phase_synthesis — skip phase_init and\n221:       phase_main_loop entirely (those are the single-executor path). The merge step in\n222:       phase_synthesis will consolidate results across all lineages.\n223:     sub_steps:\n224:       step_fanout_spawn_cli:\n225:         description: \"Spawn all native and CLI lineages in capped worker pool\"\n226:         skip_when: \"no entries in config.fanout.executors\"\n227:         command: |\n228:           node .skilled/skills/system-deep-loop/runtime/scripts/fanout-run.cjs \\\n229:             --spec-folder {spec_folder} \\\n230:             --loop-type review \\\n231:             --review-focus \"{review_focus}\" \\\n232:             --review-target \"{review_target}\" \\\n233:             --review-target-type {review_target_type} \\\n234:             --fanout-config-json '{config.fanout_json}' \\\n235:             --base-artifact-dir {artifact_dir} \\\n236:             --convergence-threshold {convergence_threshold} \\\n237:             --stop-policy {stop_policy} \\\n238:             --convergence-mode {convergence_mode}\n239:         working_directory: \"{repo_root}\"\n240:         wait_for_completion: true\n241: \n242:   # ═══════════════════════════════════════════════════════════════\n243:   # PHASE 1: INITIALIZATION\n244:   # ═══════════════════════════════════════════════════════════════\n245:   phase_init:\n246:     purpose: Create all state files for the review session and resolve review scope\n247:     steps:\n248: \n249:       step_preflight_contract:\n250:         action: \"Validate required setup bindings and executable workflow contract before any file writes\"\n251:         verify:\n252:           - required_values_present: [review_target, review_target_type, review_dimensions, spec_folder, lineage_mode, max_iterations, convergence_threshold, convergence_mode, stop_policy]\n253:           - spec_folder_is_within: \"specs/ or .opencode/specs/ (canonicalize alias roots before validation)\"\n254:           - unresolved_placeholders: \"FAIL if any user-facing template references placeholders not produced by earlier steps\"\n255:           - tool_contract: \"FAIL if executable steps reference tools outside the command allowlist\"\n256:         on_fail: \"Halt with STATUS=FAIL and report the missing binding or unsupported contract reference\"\n257: \n258:       step_create_directories:\n259:         action: \"Create spec folder and canonical review packet directories if they don't exist\"\n260:         command: \"mkdir -p {state_paths.prompt_dir} {state_paths.iteration_dir} {state_paths.delta_dir}\"\n261: \n262:       step_detect_resource_map:\n263:         action: \"Detect resource-map.md before config creation so init can persist coverage-gate state\"\n264:         inspect:\n265:           - \"{spec_folder}/resource-map.md\"\n266:         classify:\n267:           present: \"resource-map.md exists at init\"\n268:           absent: \"resource-map.md does not exist at init\"\n269:         outputs:\n270:           - resource_map_present: \"Boolean true when {spec_folder}/resource-map.md exists, else false\"\n271:           - resource_map_known_context: \"When present: concise resource-map snapshot for Known Context and charter framing. When absent: 'resource-map.md not present; skipping coverage gate'.\"\n272: \n273:       step_migrate_legacy_review_state:\n274:         action: \"Rehome legacy review artifacts into review/iterations before session classification\"\n275:         detect:\n276:           canonical_review_state:\n277:             - \"{state_paths.config}\"\n278:             - \"{state_paths.state_log}\"\n279:             - \"{state_paths.findings_registry}\"\n280:             - \"{state_paths.strategy}\"\n281:           legacy_review_state:\n282:             - \"{spec_folder}/scratch/deep-research-config.json\"\n283:             - \"{spec_folder}/scratch/deep-research-state.jsonl\"\n284:             - \"{spec_folder}/scratch/deep-review-strategy.md\"\n285:             - \"{spec_folder}/scratch/deep-review-dashboard.md\"\n286:             - \"{spec_folder}/scratch/iteration-*.md\"\n287:             - \"{spec_folder}/scratch/.deep-research-pause\"\n288:             - \"{state_paths.local_packet_dir}/iteration-*.md\"\n289:             - \"{state_paths.legacy_root_report}\"\n290:           legacy_review_markers:\n291:             - \"scratch/deep-review-strategy.md exists\"\n292:             - \"scratch/deep-research-config.json declares mode == 'review' OR scratch/deep-research-state.jsonl contains mode == 'review'\"\n293:         migrate_only:\n294:           - \"{spec_folder}/scratch/deep-research-config.json -> {state_paths.config}\"\n295:           - \"{spec_folder}/scratch/deep-research-state.jsonl -> {state_paths.state_log}\"\n296:           - \"{spec_folder}/scratch/deep-review-strategy.md -> {state_paths.strategy}\"\n297:           - \"{spec_folder}/scratch/deep-review-dashboard.md -> {state_paths.dashboard}\"\n298:           - \"{spec_folder}/scratch/iteration-*.md -> {state_paths.iteration_dir}/\"\n299:           - \"{spec_folder}/scratch/.deep-research-pause -> {state_paths.pause_sentinel}\"\n300:           - \"{state_paths.local_packet_dir}/iteration-*.md -> {state_paths.iteration_dir}/\"\n301:           - \"{state_paths.legacy_root_report} -> {state_paths.review_output}\"\n302:         on_canonical_present: \"Leave canonical review/ state untouched and do not overwrite it with legacy scratch artifacts.\"\n303:         on_legacy_detected: \"Move only the review-specific whitelist, print LEGACY_REVIEW_STATE_MOVED and leave unrelated scratch files untouched. Nothing is appended here: an append before session classification would create the state log and turn a fresh packet into a partial one, and the moved state log was written without the ledger, so the gateway refuses every append to it until step_classify_session.on_moved_legacy_state adopts it.\"\n304:         on_conflict: \"If canonical review/ state and legacy scratch review state both exist but disagree, halt for operator repair instead of merging contradictory state.\"\n305:         outputs:\n306:           - legacy_migration_detected: \"true when the command printed LEGACY_REVIEW_STATE_MOVED, else false\"\n307:           - migration_recorded: \"false; step_record_artifact_migration sets it once the migration row is appended\"\n308:         command: |\n309:           mkdir -p {state_paths.iteration_dir}\n310:           if [ ! -e {state_paths.config} ] && [ ! -e {state_paths.state_log} ] && [ ! -e {state_paths.strategy} ] && [ -e {spec_folder}/scratch/deep-review-strategy.md ] && ( [ -e {spec_folder}/scratch/deep-research-config.json ] || [ -e {spec_folder}/scratch/deep-research-state.jsonl ] ); then\n311:             [ -e {spec_folder}/scratch/deep-research-config.json ] && mv {spec_folder}/scratch/deep-research-config.json {state_paths.config}\n312:             [ -e {spec_folder}/scratch/deep-research-state.jsonl ] && mv {spec_folder}/scratch/deep-research-state.jsonl {state_paths.state_log}\n313:             [ -e {spec_folder}/scratch/deep-review-strategy.md ] && mv {spec_folder}/scratch/deep-review-strategy.md {state_paths.strategy}\n314:             [ -e {spec_folder}/scratch/deep-review-dashboard.md ] && mv {spec_folder}/scratch/deep-review-dashboard.md {state_paths.dashboard}\n315:             find {spec_folder}/scratch -maxdepth 1 -name 'iteration-*.md' -exec mv {} {state_paths.iteration_dir}/ \\;\n316:             [ -e {spec_folder}/scratch/.deep-research-pause ] && mv {spec_folder}/scratch/.deep-research-pause {state_paths.pause_sentinel}\n317:             [ -e {state_paths.legacy_root_report} ] && mv {state_paths.legacy_root_report} {state_paths.review_output}\n318:             echo \"LEGACY_REVIEW_STATE_MOVED\"\n319:           fi\n320:           find {state_paths.local_packet_dir} -maxdepth 1 -name 'iteration-*.md' -exec mv {} {state_paths.iteration_dir}/ \\; 2>/dev/null || true\n321: \n322:       step_acquire_lock:\n323:         action: \"Acquire the single-writer advisory lock before session classification\"\n324:         command: \"node .skilled/skills/system-deep-loop/runtime/scripts/loop-lock.cjs acquire --lock-path {state_paths.lock_file} --packet-id {spec_folder} --ttl-ms 1800000\"\n325:         on_acquire: \"Capture lock.ownerPid as captured_owner_pid and lock.acquireNonce as captured_acquire_nonce from the JSON output, and reuse both for every release below. If acquired=false, fail closed — another deep-review run already holds this packet.\"\n326:         note: \"Uses the promoted runtime/ loop-lock CLI (single source of truth: stale-lock reclaim, clean owner-scoped release). macOS/BSD locking is advisory — best-effort single-writer, not a hard mutex across host calls. Acquire reclaims a stale lock itself and reports the old holder under `reclaimed`. A lock is stale when its heartbeat is older than twice its TTL, or when its owning process is known to be dead. No confirmation step exists in either mode: log a `reclaimed` holder and continue.\"\n327:         # Lock-cleanup contract: the lock file MUST be released on every terminal exit path that follows acquisition.\n328:         # Runtimes honoring step_acquire_lock are required to perform this cleanup before halting or pausing.\n329:         on_halt:\n330:           action: \"Release the lock before any terminal halt branch returns control\"\n331:           applies_to: [\"step_classify_session.on_invalid_state\", \"step_classify_session.on_completed_session\"]\n332:           command: \"node .skilled/skills/system-deep-loop/runtime/scripts/loop-lock.cjs release --lock-path {state_paths.lock_file} --owner-pid {captured_owner_pid} --nonce {captured_acquire_nonce}; failures here are logged but do not block the halt\"\n333:         on_cancel:\n334:           action: \"Release the lock on user cancel or pause-sentinel detection before sentinel processing\"\n335:           command: \"node .skilled/skills/system-deep-loop/runtime/scripts/loop-lock.cjs release --lock-path {state_paths.lock_file} --owner-pid {captured_owner_pid} --nonce {captured_acquire_nonce}; cancel completes regardless of cleanup result\"\n336:         on_workflow_exit:\n337:           action: \"Release the lock as the final step of any workflow exit path (success or failure)\"\n338:           command: \"node .skilled/skills/system-deep-loop/runtime/scripts/loop-lock.cjs release --lock-path {state_paths.lock_file} --owner-pid {captured_owner_pid} --nonce {captured_acquire_nonce}; idempotent — safe to invoke when already released\"\n339: \n340:       step_classify_session:\n341:         action: \"Classify the session before writing files\"\n342:         inspect:\n343:           - \"{state_paths.config}\"\n344:           - \"{state_paths.state_log}\"\n345:           - \"{state_paths.findings_registry}\"\n346:           - \"{state_paths.strategy}\"\n347:         classify:\n348:           fresh: \"None of the three state artifacts exist\"\n349:           resume: \"Config, JSONL, and strategy all exist and config.mode == 'review' and agree on target/spec folder\"\n350:           completed-session: \"Resume artifacts exist and config.status == 'complete'\"\n351:           invalid-state: \"Any partial, missing, or contradictory combination\"\n352:         outputs:\n353:           - session_state: \"fresh | resume | completed-session | invalid-state\"\n354:           - prior_tail_digest: \"sha256 of the state log bytes when resuming or restarting an existing lineage\"\n355:         lifecycle_routing:\n356:           - \"If lineage_mode == restart and session_state is resume or completed-session, execute on_restart before on_resume or on_completed_session.\"\n357:           - \"If lineage_mode == auto or lineage_mode == resume, preserve the existing resume/completed/fresh behavior.\"\n358:         on_resume:\n359:           before_append: \"Run on_moved_legacy_state first when it applies.\"\n360:           log: \"Auto-resume: state artifacts are complete and consistent. Continue the same lineage (sessionId unchanged, generation unchanged, no archive).\"\n361:           append_jsonl: '{\"stem\":\"deep_review.run_resumed\",\"scope\":{\"runId\":\"{session_id}\",\"sessionId\":\"{session_id}\",\"generation\":{generation}},\"data\":{\"priorTailDigest\":\"{prior_tail_digest}\",\"sourceSessionId\":\"{session_id}\",\"resumeReason\":\"Auto-resume: state artifacts are complete and consistent; continue the same lineage.\",\"continuedFromRunId\":\"{session_id}-i{iteration_count}\",\"compatibilityDecision\":\"exact\",\"recoveryReceiptRef\":\"none\"}}'\n362:           skip_to: phase_loop\n363:         on_restart:\n364:           action: \"Archive the current review packet under the root-level review-archive/ tree and start a new lineage segment with a fresh sessionId and generation+1.\"\n365:           command: \"if [ -d {state_paths.packet_dir} ]; then mkdir -p {state_paths.archive_root} && mv {state_paths.packet_dir} {state_paths.archive_root}/{timestamp_slug}; fi\"\n366:           set:\n367:             lineage_mode: \"restart\"\n368:             parent_session_id: \"{prior_session_id}\"\n369:             generation: \"{prior_generation + 1}\"\n370:           skip_to: step_create_config\n371:         note_deferred_branches: \"fork and completed-continue are deferred and no longer runtime-supported in this release. The reducer still reads `lineageMode` from config for dashboards and analysis, but only `new`, `resume`, and `restart` are live. See deep-review/references/protocol/loop-protocol.md §Lifecycle Branches for the one-session contract.\"\n372:         on_moved_legacy_state:\n373:           applies_when: \"legacy_migration_detected == true and the branch taken resumes the session or goes to synthesis; never on restart or cancel\"\n374:           order: \"Runs after classification and before that branch appends anything, the resume event included.\"\n375:           note: |\n376:             The state log moved out of scratch/ was written by hand before the ledger existed, so the\n377:             gateway refuses every append to it. Set it aside unchanged as deep-review-state.legacy.jsonl,\n378:             open the run from the moved config, then replay its iteration rows through the gateway,\n379:             which carries each one whole. Rows the gateway cannot carry stay only in the set-aside file,\n380:             and the replay reports how many. Exit 2 from any of the three is a halt.\n381:           set_aside_command: |\n382:             STATE_LOG=\"{state_paths.state_log}\"\n383:             LEGACY_LOG=\"$(dirname \"$STATE_LOG\")/deep-review-state.legacy.jsonl\"\n384:             if [ -e \"$LEGACY_LOG\" ]; then\n385:               echo \"A set-aside legacy state log already exists at $LEGACY_LOG. Repair the packet by hand.\" >&2\n386:               exit 1\n387:             fi\n388:             mv \"$STATE_LOG\" \"$LEGACY_LOG\"\n389:           open_run: \"Run step_create_state_log.command unchanged. With the hand-written log set aside, it opens the run from the moved config.\"\n390:           replay_command: |\n391:             GATEWAY=\".skilled/skills/system-deep-loop/runtime/scripts/append-mode-event.cjs\"\n392:             [ -f \"$GATEWAY\" ] || GATEWAY=\"scripts/append-mode-event.cjs\"\n393:             RUN_DIR=\"$(dirname \"{state_paths.state_log}\")\"\n394:             node -e '\n395:               const fs = require(\"fs\"), os = require(\"os\"), path = require(\"path\");\n396:               const { spawnSync } = require(\"child_process\");\n397:               const [gateway, legacyLog, runDir] = process.argv.slice(1);\n398:               let replayedIterations = 0;\n399:               let keptOnlyInLegacyLog = 0;\n400:               for (const line of fs.readFileSync(legacyLog, \"utf8\").split(\"\\n\")) {\n401:                 if (line.trim() === \"\") continue;\n402:                 let row;\n403:                 try { row = JSON.parse(line); } catch { keptOnlyInLegacyLog += 1; continue; }\n404:                 // The run open already replaced the config row.\n405:                 if (row && row.type === \"config\") continue;\n406:                 if (!row || row.type !== \"iteration\") { keptOnlyInLegacyLog += 1; continue; }\n407:                 const tempDir = fs.mkdtempSync(path.join(os.tmpdir(), \"deep-review-replay-\"));\n408:                 const eventFile = path.join(tempDir, \"row.json\");\n409:                 fs.writeFileSync(eventFile, JSON.stringify(row));\n410:                 const result = spawnSync(process.execPath, [gateway, \"--mode\", \"review\", \"--run-directory\", runDir, \"--event-json\", eventFile], { encoding: \"utf8\" });\n411:                 fs.rmSync(tempDir, { recursive: true, force: true });\n412:                 if (result.status === 2) { process.stdout.write(result.stdout || \"\"); process.exit(2); }\n413:                 if (result.status === 0) replayedIterations += 1; else keptOnlyInLegacyLog += 1;\n414:               }\n415:               process.stdout.write(JSON.stringify({ replayedIterations, keptOnlyInLegacyLog, legacyLog }) + \"\\n\");\n416:             ' \"$GATEWAY\" \"$RUN_DIR/deep-review-state.legacy.jsonl\" \"$RUN_DIR\"\n417:         on_completed_session:\n418:           before_append: \"Run on_moved_legacy_state first when it applies.\"\n419:           log: \"Prior session already completed. Either archive the completed review/ tree and start a fresh session, or jump straight to synthesis with the existing artifacts.\"\n420:           skip_to: phase_synthesis\n421:         on_invalid_state:\n422:           halt: true\n423:           message: \"Existing deep-review state in review/ is incomplete or contradictory. Repair or archive the invalid review packet before continuing.\"\n424:         on_fresh:\n425:           action: \"Proceed with a new session\"\n426: \n427:       step_scope_discovery:\n428:         action: \"Resolve review target to a concrete file list based on target type\"\n429:         resolve:\n430:           spec-folder: |\n431:             1. Inspect spec.md, plan.md, tasks.md, acceptance-criteria.md, implementation-summary.md, and goal-file-manifest.txt when present\n432:             2. If goal-file-manifest.txt exists, parse one repo-relative path per non-empty, non-comment line; reject absolute paths, traversal outside repo_root, duplicates, missing paths, and non-file entries\n433:             3. Fail before dispatch with line-numbered validation errors when any manifest entry is invalid; otherwise set scope = the validated manifest paths in declared order\n434:             4. When no manifest exists, discover implementation files referenced in the canonical spec artifacts\n435:             5. Discover test files associated with the implementation files\n436:             6. Set scope = all discovered implementation and test files\n437:           skill: |\n438:             1. Read SKILL.md from .skilled/skills/{skill_name}/\n439:             2. Discover references/, assets/, scripts/ contents\n440:             3. Find agent definitions referencing this skill across runtimes\n441:             4. Find command entry points referencing this skill\n442:             5. Set scope = all discovered files\n443:           agent: |\n444:             1. Find agent definition across repo-managed runtimes (.claude/agents/, .skilled/agents/)\n445:             2. Compare agent definitions for consistency\n446:             3. Set scope = all discovered agent files\n447:           track: |\n448:             1. List all child spec folders under specs/{track}/ or .opencode/specs/{track}/\n449:             2. For each: read spec.md + acceptance-criteria.md\n450:             3. Set scope = all child spec artifacts\n451:           files: |\n452:             1. Expand glob patterns from review_target\n453:             2. Validate all files exist\n454:             3. Discover immediate cross-references (imports, links)\n455:             4. Set scope = expanded file list + cross-references\n456:         outputs:\n457:           - review_scope_files: \"List of all files in review scope\"\n458:           - cross_reference_targets: \"{ spec_paths: [...], code_paths: [...], test_paths: [...] }\"\n459: \n460:       step_order_dimensions:\n461:         action: \"Order review dimensions based on risk priority\"\n462:         algorithm: |\n463:           1. Iteration 0 (inventory pass): Build artifact map, identify file types, estimate complexity\n464:           2. Subsequent iterations follow risk-ordered deep passes:\n465:              correctness → security → traceability → maintainability\n466:           3. If review_dimensions != \"all\", filter to only requested dimensions\n467:           4. Derive traceability protocol plan:\n468:              - core: spec_code, checklist_evidence\n469:              - overlay: skill_agent, agent_cross_runtime, feature_catalog_code, playbook_capability\n470:           5. If resource_map_present, reserve at least one traceability-oriented pass to cross-check target_files from applied/T-*.md against resource-map.md and classify touched / expected-by-scope / gap / absent-from-map outcomes\n471:           6. Store ordered list as dimension_queue\n472:         outputs:\n473:           - dimension_queue: \"Ordered list of dimensions to review\"\n474:           - inventory_pass: true\n475: \n476:       step_normalize_review_dimensions:\n477:         action: \"Normalize reviewDimensions once during init for config + JSONL reuse\"\n478:         outputs:\n479:           - review_dimensions_normalized: \"Canonical string[] for deep-review-config.json\"\n480:           - review_dimensions_json: \"JSON.stringify(review_dimensions_normalized) for JSONL config record\"\n481:         normalize: |\n482:           Accept {review_dimensions} in any of these shapes and convert once:\n483:             - \"all\" → [\"correctness\",\"security\",\"traceability\",\"maintainability\"]\n484:             - \"correctness,security\" → [\"correctness\",\"security\"]\n485:             - [\"correctness\"] → [\"correctness\"]\n486:           Every element MUST be one of the four canonical dimension names.\n487: \n488:       step_normalize_review_focus:\n489:         action: \"Normalize the optional operator review focus once during init\"\n490:         outputs:\n491:           - review_focus_normalized: \"Single-line focus text, or empty string when no focus was given\"\n492:         normalize: |\n493:           Collapse every control character (C0, C1, DEL, U+2028, U+2029) and whitespace run to one space, trim, treat an empty result as absent, and fail setup when more than 1000 characters remain.\n494:           fanout-run.cjs applies the same rule in code, so a fan-out lineage receives the same text.\n495: \n496:       step_resolve_session_id:\n497:         action: \"Resolve init session id from caller when supplied, else preserve timestamp fallback\"\n498:         branch_on: \"session_id\"\n499:         if_present:\n500:           bind:\n501:             session_id_init: \"{session_id}\"\n502:         if_absent:\n503:           bind:\n504:             session_id_init: \"{ISO_8601_NOW}\"\n505: \n506:       step_create_config:\n507:         action: \"Create deep-review-config.json from template with review-specific fields\"\n508:         template: .skilled/skills/system-deep-loop/deep-review/assets/deep-review-config.json\n509:         populate:\n510:           topic: \"Review: {review_target}\"\n511:           mode: \"review\"\n512:           sessionId: \"{session_id_init}\"\n513:           parentSessionId: null\n514:           lineageMode: \"new\"\n515:           generation: 1\n516:           continuedFromRun: null\n517:           reviewTarget: \"{review_target}\"\n518:           reviewTargetType: \"{review_target_type}\"\n519:           # Reuse the single normalized init-time value from step_normalize_review_dimensions.\n520:           reviewDimensions: \"{review_dimensions_normalized}\"\n521:           # Null when review_focus_normalized is empty. The review report reads it back to show the focus.\n522:           reviewFocus: \"{review_focus_normalized}\"\n523:           resource_map_present: \"{resource_map_present}\"\n524:           reviewScopeFiles: \"{review_scope_files}\"\n525:           severityThreshold: \"P2\"\n526:           crossReference:\n527:             core: [\"spec_code\", \"checklist_evidence\"]\n528:             overlay: [\"skill_agent\", \"agent_cross_runtime\", \"feature_catalog_code\", \"playbook_capability\"]\n529:           maxIterations: \"{max_iterations}\"\n530:           # Semantic: weighted P0/P1/P2 severity ratio. See SKILL.md §\"Convergence Threshold Semantics\".\n531:           convergenceThreshold: \"{convergence_threshold}\"\n532:           antiConvergence.convergenceMode: \"{convergence_mode}\"\n533:           antiConvergence.divergent: {}\n534:           stopPolicy: \"{stop_policy}\"\n535:           stuckThreshold: 2\n536:           maxDurationMinutes: 120\n537:           specFolder: \"{spec_folder}\"\n538:           # Honor the parsed --no-resource-map flag from deep-review.md:71 (default true; false when flag is set).\n539:           # The markdown command parses $ARGUMENTS and binds {resource_map_emit} before this step runs.\n540:           resource_map.emit: \"{resource_map_emit}\"\n541:           createdAt: \"{ISO_8601_NOW}\"\n542:           status: \"initialized\"\n543:           releaseReadinessState: \"in-progress\"\n544:           executionMode: \"auto\"\n545:         output: \"{state_paths.config}\"\n546: \n547:       step_create_state_log:\n548:         action: \"Open the run in the ledger: record deep_review.run_initialized through the append gateway, which writes the state log's first row\"\n549:         note: |\n550:           The state log is a projection the gateway rebuilds from the ledger, so this step never writes\n551:           it directly. A config row written beside the ledger carries keys the projection cannot\n552:           rebuild, and the projection refuses to drop them, so every later append in the run would\n553:           commit to the ledger and then exit 2. Recording the run's opening as a ledger event makes\n554:           the projected config row the state log's first row from the start. The full config stays\n555:           in deep-review-config.json, which is what the reducer reads.\n556:         command: |\n557:           GATEWAY=\".skilled/skills/system-deep-loop/runtime/scripts/append-mode-event.cjs\"\n558:           [ -f \"$GATEWAY\" ] || GATEWAY=\"scripts/append-mode-event.cjs\"\n559:           EVENT_FILE=\"$(mktemp \"${TMPDIR:-/tmp}/deep-review-run-open.XXXXXX\")\"\n560:           node -e '\n561:             const fs = require(\"fs\"), crypto = require(\"crypto\");\n562:             const [configPath, workflowPath] = process.argv.slice(1);\n563:             const sha = (bytes) => crypto.createHash(\"sha256\").update(bytes).digest(\"hex\");\n564:             const raw = fs.readFileSync(configPath);\n565:             const config = JSON.parse(raw);\n566:             const targetTypes = { files: \"file\", file: \"file\", directory: \"directory\", \"spec-folder\": \"directory\", track: \"directory\", repository: \"repository\" };\n567:             const lineageModes = { new: \"fresh\", fresh: \"fresh\", restart: \"restart\", resume: \"resume\" };\n568:             // The projected config row shows this topic; one the schema cannot hold is left out,\n569:             // and the row falls back to the run id rather than the run failing to open.\n570:             const topic = typeof config.topic === \"string\" && config.topic.trim() !== \"\" && config.topic.length <= 4096\n571:               ? config.topic\n572:               : null;\n573:             process.stdout.write(JSON.stringify({\n574:               stem: \"deep_review.run_initialized\",\n575:               scope: { runId: config.sessionId, sessionId: config.sessionId, generation: Number(config.generation) || 1 },\n576:               data: {\n577:                 target: {\n578:                   targetId: \"review-target\",\n579:                   targetType: targetTypes[config.reviewTargetType] || \"artifact\",\n580:                   artifactRef: \"deep-review-config.json#reviewTarget\",\n581:                   sourceDigest: sha(String(config.reviewTarget)),\n582:                   contentDigest: sha(raw),\n583:                 },\n584:                 lineageMode: lineageModes[config.lineageMode] || \"fresh\",\n585:                 maxIterations: Number(config.maxIterations),\n586:                 convergencePolicyVersion: \"convergence-policy@\" + ((config.antiConvergence && config.antiConvergence.convergenceMode) || \"default\"),\n587:                 reviewModeContractDigest: sha(fs.readFileSync(workflowPath)),\n588:                 initialReleaseReadinessState: \"not-assessed\",\n589:                 ...(topic === null ? {} : { topic }),\n590:               },\n591:             }));\n592:           ' \"{state_paths.config}\" \".skilled/commands/deep/assets/deep-review-auto.yaml\" > \"$EVENT_FILE\" || { rm -f \"$EVENT_FILE\"; exit 1; }\n593:           node \"$GATEWAY\" --mode review --run-directory \"$(dirname \"{state_paths.state_log}\")\" --event-json \"$EVENT_FILE\"\n594:           STATUS=$?\n595:           rm -f \"$EVENT_FILE\"\n596:           exit \"$STATUS\"\n597:         output: \"{state_paths.state_log}\"\n598: \n599:       step_record_restarted_run:\n600:         skip_when: \"lineage_mode != 'restart'\"\n601:         action: \"Record the restarted lineage after the run-open row so the restart marker never precedes deep_review.run_initialized\"\n602:         append_jsonl: '{\"stem\":\"deep_review.run_restarted\",\"scope\":{\"runId\":\"{session_id}\",\"sessionId\":\"{session_id}\",\"generation\":{generation}},\"data\":{\"priorTailDigest\":\"{prior_tail_digest}\",\"archivedLineageId\":\"{prior_session_id}\",\"restartReason\":\"Restart requested: the prior review packet was archived and a new lineage segment opened.\",\"continuedFromRunId\":\"{prior_session_id}-i{iteration_count}\",\"compatibilityDecision\":\"exact\",\"recoveryReceiptRef\":\"none\"}}'\n603: \n604:       step_create_findings_registry:\n605:         action: \"Initialize reducer-owned review findings registry\"\n606:         content: '{\"sessionId\":\"{session_id_init}\",\"generation\":1,\"lineageMode\":\"new\",\"openFindings\":[],\"resolvedFindings\":[],\"repeatedFindings\":[],\"dimensionCoverage\":{\"correctness\":false,\"security\":false,\"traceability\":false,\"maintainability\":false},\"findingsBySeverity\":{\"P0\":0,\"P1\":0,\"P2\":0},\"openFindingsCount\":0,\"resolvedFindingsCount\":0,\"convergenceScore\":0.0}'\n607:         output: \"{state_paths.findings_registry}\"\n608: \n609:       step_create_strategy:\n610:         action: \"Create review strategy file from deep-review-strategy.md template\"\n611:         template: .skilled/skills/system-deep-loop/deep-review/assets/deep-review-strategy.md\n612:         populate:\n613:           review_target: \"{review_target}\"\n614:           review_target_type: \"{review_target_type}\"\n615:           dimensions: \"{dimension_queue}\"\n616:           scope_files: \"{review_scope_files}\"\n617:           cross_reference_targets: \"{cross_reference_targets}\"\n618:           max_iterations: \"{max_iterations}\"\n619:           convergence_threshold: \"{convergence_threshold}\"\n620:           stop_policy: \"{stop_policy}\"\n621:         output: \"{state_paths.strategy}\"\n622: \n623:       step_seed_coverage_graph:\n624:         action: \"Seed the review coverage graph before the first convergence check\"\n625:         transform: |\n626:           1. Convert review_scope_files into FILE nodes.\n627:           2. Convert review target groupings into coarse SLICE nodes only; do not expand SYMBOL\n628:              or DEPENDENCY nodes in review mode.\n629:           3. Emit COVERS edges from SLICE nodes to FILE nodes when the grouping is known.\n630:           4. Bind coverage_seed_source to \"scope_discovery\" and coverage_seed_confidence to 0.50.\n631:           5. When scope discovery yields no files, emit [] for both arrays; the upsert script\n632:              returns a warning and review continues with an empty graph.\n633:         bash: \"node .skilled/skills/system-deep-loop/runtime/scripts/upsert.cjs --spec-folder \\\"{spec_folder}\\\" --loop-type \\\"review\\\" --session-id \\\"{config.sessionId}\\\" --nodes '{coverage_seed_nodes_json}' --edges '{coverage_seed_edges_json}' --seed-source \\\"{coverage_seed_source}\\\" --seed-confidence \\\"{coverage_seed_confidence}\\\"\"\n634:         outputs:\n635:           - coverage_seed_nodes_json: \"Seed nodes for review SLICE and FILE kinds only\"\n636:           - coverage_seed_edges_json: \"Seed COVERS edges where review target groupings resolved\"\n637:           - coverage_seed_warning: \"Warning emitted when the seed batch inserts zero nodes, else empty\"\n638:         on_warning:\n639:           log: \"Coverage graph seed inserted zero nodes; continuing with an empty graph.\"\n640:           proceed: true\n641: \n642:       step_enrich_strategy_context:\n643:         action: \"Ensure Known Context is written only after strategy.md exists\"\n644:         condition: \"prior_context_found\"\n645:         edit: \"{state_paths.strategy}\"\n646:         note: \"Append or replace the Known Context section with prior_context_summary and retained detail from prior_context\"\n647: \n648:       step_enrich_strategy_resource_map:\n649:         action: \"Inject resource-map status into Known Context after strategy.md exists\"\n650:         edit: \"{state_paths.strategy}\"\n651:         note: \"When resource_map_present is true, append the resource_map_known_context snapshot and add Resource Map Coverage to the Review Charter. When false, append 'resource-map.md not present; skipping coverage gate'.\"\n652: \n653:       step_init_complete:\n654:         log: \"Initialization complete. Config, state, and strategy files created. Review scope: {review_scope_files_count} files, {dimension_queue_count} dimensions.\"\n655:         set: { current_iteration: 1, stuck_count: 0, p0_count: 0, p1_count: 0, p2_count: 0 }\n656: \n657:   # ═══════════════════════════════════════════════════════════════\n658:   # PHASE 2: ITERATION LOOP\n659:   # ═══════════════════════════════════════════════════════════════\n660:   phase_loop:\n661:     purpose: Dispatch review agent iterations until convergence\n662:     repeat: true\n663:     max_repeats: \"{max_iterations}\"\n664:     steps:\n665: \n666:       step_refresh_lock:\n667:         action: \"Refresh the packet lock heartbeat before the iteration begins\"\n668:         command: \"node .skilled/skills/system-deep-loop/runtime/scripts/loop-lock.cjs refresh --lock-path {state_paths.lock_file} --owner-pid {captured_owner_pid} --nonce {captured_acquire_nonce}\"\n669:         on_refresh: \"If the refresh output has refreshed:false, fail closed: lost the packet lock. This run no longer holds the packet and must stop rather than iterate without it.\"\n670: \n671:       step_record_artifact_migration:\n672:         action: \"Record the legacy review state move once per session, after the run is open\"\n673:         skip_when: \"legacy_migration_detected != true or migration_recorded == true\"\n674:         append_jsonl: '{\"stem\":\"deep_review.migration\",\"scope\":{\"runId\":\"{session_id}\",\"sessionId\":\"{session_id}\"},\"data\":{\"mode\":\"review\",\"legacyArtifacts\":[\"deep-research-config.json\",\"deep-research-state.jsonl\",\".deep-research-pause\"],\"canonicalArtifacts\":[\"deep-review-config.json\",\"deep-review-state.jsonl\",\".deep-review-pause\"]}}'\n675:         set: { migration_recorded: true }\n676: \n677:       step_read_state:\n678:         action: \"Read current state from JSONL, strategy, and config\"\n679:         read:\n680:           - \"{state_paths.state_log}\"\n681:           - \"{state_paths.findings_registry}\"\n682:           - \"{state_paths.strategy}\"\n683:           - \"{state_paths.config}\"\n684:         extract:\n685:           - iteration_count: \"Count distinct run values (the integer iteration, else a numeric run) across lines where type === 'iteration'; a redispatched run counts once\"\n686:           - highest_run: \"Highest run value (the integer iteration, else a numeric run) across lines where type === 'iteration', else 0\"\n687:           - current_iteration: \"max(highest_run, iteration_count) + 1\"\n688:           - last_newFindingsRatio: \"Extract newFindingsRatio from last iteration record\"\n689:           - last_focus: \"Extract focus/dimension from latest iteration record, else 'none yet'\"\n690:           - ratio_prev: \"Extract newFindingsRatio from second-latest iteration record, else 'N/A'\"\n691:           - ratio_latest: \"Extract newFindingsRatio from latest iteration record, else 'N/A'\"\n692:           - next_dimension: \"Next uncovered dimension from dimension_queue in strategy.md\"\n693:           - dimensions_covered: \"List of dimensions already reviewed\"\n694:           - dimensions_remaining: \"List of dimensions not yet reviewed\"\n695:           - dimension_coverage: \"covered / total dimensions\"\n696:           - coverage_age: \"Iterations since dimension coverage last changed; require >= 1 before STOP\"\n697:           - p0_count: \"Count P0 findings across all iterations\"\n698:           - p1_count: \"Count P1 findings across all iterations\"\n699:           - p2_count: \"Count P2 findings across all iterations\"\n[Output truncated. Continue reading with offset: 700]"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\".skilled/commands/deep/assets/deep-review-auto.yaml\"}"},"time":{"start":1794669322399,"end":1794669323019}}}}
{"type":"tool_use","timestamp":1794669323027,"sessionID":"ses_e255ff46effe7EWyuOLOEwVdy1","part":{"partID":"prt_1daa0a1de001G5Z8v9iXH8e2nD","sessionID":"ses_e255ff46effe7EWyuOLOEwVdy1","messageID":"msg_1daa088ba00120lVhPTo4xJ0gn","type":"tool","id":"call_9e1498abde0e4cfe972a7dea","tool":"read","state":{"status":"completed","input":{"path":".skilled/skills/system-deep-loop/deep-review/references/protocol/loop-protocol.md"},"output":"Read file .skilled/skills/system-deep-loop/deep-review/references/protocol/loop-protocol.md, lines 1-777\n1: ---\n2: title: Deep Review Loop Protocol\n3: description: Complete lifecycle specification for the autonomous deep review loop, initialization, iteration, convergence, synthesis, and save phases.\n4: trigger_phrases:\n5:   - \"deep review loop protocol\"\n6:   - \"review iteration lifecycle\"\n7:   - \"review loop initialization\"\n8:   - \"review auto resume\"\n9:   - \"review synthesis phase\"\n10: importance_tier: important\n11: contextType: implementation\n12: version: 1.11.7.0\n13: ---\n14: \n15: # Deep Review Loop Protocol\n16: \n17: Complete lifecycle specification for the autonomous deep review loop.\n18: \n19: ---\n20: \n21: ## 1. OVERVIEW\n22: \n23: ### Purpose\n24: \n25: The deep review loop has 4 phases: initialization, iteration (repeated), synthesis, and save. The YAML workflow manages the lifecycle. The `@deep-review` agent (LEAF-only, no WebFetch) executes individual review iterations with fresh context each time.\n26: \n27: ### When to Use\n28: \n29: - Initiating a deep-review loop on a spec folder, skill, agent, or track.\n30: - Resuming a paused or interrupted review session from prior state.\n31: - Validating the 4-phase lifecycle and lineage protocol against current behavior.\n32: - Auditing iteration-dispatch, convergence, or save-phase contracts before changes.\n33: \n34: ```\n35: ┌──────────────┐     ┌───────────────────────────────┐     ┌───────────────┐     ┌──────────┐\n36: │  INIT        │────>│  LOOP                         │────>│  SYNTHESIS    │────>│  SAVE    │\n37: │              │     │  ┌─────────────────────────┐  │     │               │     │          │\n38: │ Scope        │     │  │ Read State              │  │     │ Finding       │     │ Memory   │\n39: │ Discovery    │     │  │ Check Convergence       │  │     │ Registry      │     │ Context  │\n40: │ Dimension    │     │  │ Check Pause Sentinel    │  │     │ Dedup         │     │ Save     │\n41: │ Ordering     │     │  │ Generate State Summary  │  │     │               │     │          │\n42: │ Traceability │     │  │ Dispatch @deep-review   │  │     │ Severity      │     │          │\n43: │ Planning     │     │  │ Evaluate Results        │  │     │ Reconcile     │     │          │\n44: │ State Files  │     │  │ Claim Adjudication      │  │     │               │     │          │\n45: │              │     │  │ Dashboard Generation    │  │     │ Replay        │     │          │\n46: │              │     │  │ Loop Decision           │  │     │ Validation    │     │          │\n47: │              │     │  └────────┬────────────────┘  │     │               │     │          │\n48: │              │     │           │ repeat            │     │ review-report │     │          │\n49: │              │     │           │                   │     │ (9 core +     │     │          │\n50: │              │     │           │                   │     │  resource-map)│     │          │\n51: └──────────────┘     └───────────────────────────────┘     └───────────────┘     └──────────┘\n52: ```\n53: \n54: ### Core Innovation\n55: \n56: Each agent dispatch gets a fresh context window. State continuity comes from files on disk, not in-context memory. This eliminates context degradation in long review sessions where accumulated findings would otherwise bias subsequent dimensions.\n57: \n58: ### Key References\n59: \n60: | Resource | Path | Purpose |\n61: |----------|------|---------|\n62: | Review contract | `assets/review-mode-contract.yaml` | Dimensions, verdicts, gates, protocols |\n63: | Auto workflow | `.skilled/commands/deep/assets/deep-review-auto.yaml` | Unattended review loop |\n64: | Confirm workflow | `.skilled/commands/deep/assets/deep-review-confirm.yaml` | Step-by-step review with approval gates |\n65: | Agent | `@deep-review` (LEAF) | Single iteration executor, no sub-agents, no WebFetch |\n66: | Memory save | `generate-context.js` | Context preservation script |\n67: \n68: ---\n69: \n70: ## 2. PHASE 1: INITIALIZATION\n71: \n72: ### Purpose\n73: \n74: Set up all state files for a new review session. Discover the scope, order dimensions by risk priority, establish the traceability protocol plan, and create the review state packet.\n75: \n76: ### Steps\n77: \n78: 1. **Classify session state before writing**:\n79:    - `fresh`: no config/state/strategy files exist\n80:    - `resume`: config + state + strategy all exist and agree\n81:    - `completed-session`: consistent prior state with `config.status == \"complete\"`\n82:    - `invalid-state`: partial or contradictory artifacts\n83:    - Review state still under `scratch/` is moved to the canonical names before this step, and nothing is appended then. The moved state log was written without the ledger, so a resume or synthesis sets it aside as `deep-review-state.legacy.jsonl`, opens the run from the moved config and replays its iteration rows through the append gateway. The `deep_review.migration` row is appended once, at the top of the first iteration.\n84: \n85: 2. **Resolve local artifact owner**: `artifact_dir = resolveArtifactRoot(specFolder, 'review').artifactDir`, then `mkdir -p {artifact_dir}/iterations`\n86: \n87: 3. **Scope discovery**: Resolve the review target into a concrete file list using one of 5 target types:\n88: \n89:    | Target Type | CLI Value | Resolution Strategy |\n90:    |-------------|-----------|---------------------|\n91:    | **Spec Folder** | `spec-folder` | Read `spec.md`, `plan.md`, implementation files listed in `tasks.md` |\n92:    | **Skill** | `skill` | Read `SKILL.md`, `references/`, `assets/`, `scripts/`, find agent definitions and command entry points |\n93:    | **Agent** | `agent` | Find agent definitions across all runtimes, compare for consistency |\n94:    | **Track** | `track` | List all child spec folders under the track, read `spec.md` + `checklist.md` for each |\n95:    | **Files** | `files` | Expand glob patterns, validate existence, discover cross-references |\n96: \n97:    Store the resolved file list in strategy.md \"Files Under Review\".\n98: \n99: 4. **Dimension ordering**: Order the 4 review dimensions for iteration based on risk priority:\n100: \n101:    | Priority | Dimension | Rationale |\n102:    |----------|-----------|-----------|\n103:    | 1 | Correctness | Logic errors have the highest blast radius |\n104:    | 2 | Security | Vulnerabilities require immediate attention |\n105:    | 3 | Traceability | Spec/code alignment ensures completeness |\n106:    | 4 | Maintainability | Patterns and documentation quality (lowest immediate risk) |\n107: \n108:    Default order: D1 Correctness, D2 Security, D3 Traceability, D4 Maintainability. This order is configurable but the default prioritizes highest-impact dimensions first.\n109: \n110: 5. **Traceability protocol planning**: Partition the 6 cross-reference protocols into core vs overlay, and schedule only applicable overlays for the target type:\n111: \n112:    | Level | Protocol | Applies To | Gate Class | Purpose |\n113:    |-------|----------|------------|------------|---------|\n114:    | Core | `spec_code` | all targets | hard | Verify normative claims resolve to shipped behavior |\n115:    | Core | `checklist_evidence` | all targets | hard | Verify checked completion claims have evidence |\n116:    | Overlay | `skill_agent` | skill | advisory | Verify SKILL.md and runtime agents agree |\n117:    | Overlay | `agent_cross_runtime` | agent | advisory | Verify runtime agent parity |\n118:    | Overlay | `feature_catalog_code` | skill, spec-folder, track, files | advisory | Verify catalog claims match capability |\n119:    | Overlay | `playbook_capability` | skill, agent, spec-folder | advisory | Verify playbook scenarios match executable reality |\n120: \n121:    Only schedule overlay protocols that apply to the resolved target type.\n122: \n123: 6. **Write config**: `{artifact_dir}/deep-review-config.json` with `mode: \"review\"`, lineage metadata (`sessionId`, `parentSessionId`, `lineageMode`, `generation`, `continuedFromRun`, `releaseReadinessState`), and review-specific fields including target, target type, dimensions, protocol plan, and release-readiness state.\n124: \n125: 7. **Initialize state log**: First line of `{artifact_dir}/deep-review-state.jsonl` with config record including `mode: \"review\"` and the lineage fields.\n126: \n127: 8. **Initialize reducer state**: Create `{artifact_dir}/deep-review-findings-registry.json` with empty `openFindings`, `resolvedFindings`, `repeatedFindings`, `dimensionCoverage`, `findingsBySeverity`, and `convergenceScore`.\n128: \n129: 9. **Initialize strategy**: `{artifact_dir}/deep-review-strategy.md` from review template with:\n130:    - Topic (review target description)\n131:    - Review Dimensions checklist\n132:    - Files Under Review table\n133:    - Cross-Reference Status table grouped by core vs overlay\n134:    - Known Context from the continuity ladder and ripgrep recipes (if any)\n135:    - Resource-map snapshot when `{spec_folder}/resource-map.md` exists at init\n136:    - `resource-map.md not present. Skipping coverage gate` when it does not\n137:    - Review Boundaries from config\n138: 9a. **Initialize resource-map coverage state**:\n139:    - If `{spec_folder}/resource-map.md` exists at init: set `resource_map_present = true`, add `Resource Map Coverage` to the Review Charter, and persist a concise map summary in `Known Context`\n140:    - If absent: set `resource_map_present = false`, record the skip note in `Known Context`, and continue without failing\n141: \n142: 10. **Validate review charter**:\n143:    - Verify strategy.md contains Non-Goals and Stop Conditions sections (may be empty but must exist)\n144:    - In **confirm mode**: present the charter (target, dimensions, scope, non-goals) for user review before proceeding\n145:    - In **auto mode**: accept automatically and continue\n146: \n147: 11. **Resume only if config, JSONL, strategy, and findings registry agree**. Otherwise halt for repair instead of guessing.\n148: \n149: ### Outputs\n150: \n151: | File | Location | Purpose |\n152: |------|----------|---------|\n153: | Config | `{artifact_dir}/deep-review-config.json` | Review parameters (immutable after init) |\n154: | State | `{artifact_dir}/deep-review-state.jsonl` | Iteration log (1 initial line) |\n155: | Registry | `{artifact_dir}/deep-review-findings-registry.json` | Reducer-owned findings state |\n156: | Strategy | `{artifact_dir}/deep-review-strategy.md` | Dimensions, findings, next focus |\n157: \n158: ---\n159: \n160: ## 3. PHASE 2: ITERATION LOOP\n161: \n162: ### Loop Steps (repeated until convergence)\n163: \n164: #### Step 1: Read State\n165: \n166: - Read `deep-review-state.jsonl` -- count iterations, extract `newFindingsRatio`, `findingsSummary`, `findingsNew`, `traceabilityChecks`, and lineage data\n167: - Read `deep-review-findings-registry.json` -- extract `dimensionsCovered`, `findingsBySeverity`, `openFindings`, `resolvedFindings`, and `convergenceScore`\n168: - Read `{artifact_dir}/deep-review-strategy.md` -- get next focus dimension/files, remaining dimensions, and protocol gaps\n169: \n170: Reducer contract for every loop refresh:\n171: \n172: | Reducer Part | Canonical Value | Notes |\n173: |--------------|-----------------|-------|\n174: | Inputs | `fullJSONLHistory`, `iterationFiles`, `priorReducedState` | Normal loop refresh is full-history: replay the persisted JSONL state and current iteration corpus each refresh so reducer output stays deterministic across restart, compaction, and synthesis audit paths. |\n175: | Outputs | `findingsRegistry`, `dashboardMetrics`, `strategyUpdates` | The same refresh pass updates the canonical registry, refreshes dashboard metrics, and applies strategy updates. |\n176: | Metrics | `dimensionsCovered`, `findingsBySeverity`, `openFindings`, `resolvedFindings`, `convergenceScore` | These metrics drive convergence decisions, dashboard summaries, and synthesis readiness. |\n177: \n178: #### Step 2: Check Convergence\n179: \n180: Run `shouldContinue_review()` (see `../deep-research/references/convergence/convergence.md` Section 10.3):\n181: \n182: - Max iterations reached? `STOP`\n183: - Stuck count `>= 2` using `noProgressThreshold = 0.05`? `STUCK_RECOVERY`\n184: - Composite convergence votes `STOP` only after:\n185:   - Rolling average uses `rollingStopThreshold = 0.08`\n186:   - Dimension coverage reaches 100% across the 4-dimension model\n187:   - Coverage has aged through `minStabilizationPasses >= 1`\n188:   - Required traceability protocols are covered\n189:   - Evidence, scope, and coverage gates pass\n190: - Otherwise: `CONTINUE`\n191: \n192: If convergence math or a hard-stop candidate points to STOP, the workflow must run the review legal-stop decision tree before actually stopping. That decision tree records nine review-specific gates: `convergenceGate`, `dimensionCoverageGate`, `p0ResolutionGate`, `evidenceDensityGate`, `hotspotSaturationGate`, `claimAdjudicationGate`, `fixCompletenessReplayGate`, `candidateCoverageGate`, and `graphlessFallbackGate` (see `../convergence/convergence.md` §1 blocked_stop event example for the authoritative shape). The Step 4a claim-adjudication path treats `claimAdjudicationGate` as a hard STOP gate, so the count covers both the convergence decision tree and the adjudication enforcement path. `candidateCoverageGate` and `graphlessFallbackGate` are v2-rollout gates that pass trivially when the review-depth-v2 search path is inactive. If any gate fails, the loop does **not** stop. Instead it emits a first-class `blocked_stop` JSONL event with:\n193: \n194: - `blockedBy`: array of the failed review gate names\n195: - `gateResults`: per-gate pass/fail payloads using the review gate names above\n196: - `recoveryStrategy`: one-line hint describing the next review action\n197: \n198: The blocked-stop event is append-only evidence that legal-stop blocked the run. The loop then continues with the recovery or next-focus path rather than synthesizing.\n199: \n200: Convergence signals and weights:\n201: \n202: | Signal | Weight | Description |\n203: |--------|--------|-------------|\n204: | Rolling Average | 0.30 | Last 2 severity-weighted `newFindingsRatio` values average below `rollingStopThreshold` |\n205: | MAD Noise Floor | 0.25 | Latest ratio within noise floor derived from historical ratios |\n206: | Dimension Coverage | 0.45 | All 4 dimensions plus required traceability protocols covered, with stabilization |\n207: \n208: **P0 override**: Any new P0 finding sets `newFindingsRatio >= 0.50`, blocking convergence regardless of composite score.\n209: \n210: #### Step 2a: Check Pause Sentinel\n211: \n212: Before dispatching, check for a pause sentinel file:\n213: \n214: 1. Check if `review/.deep-review-pause` exists (note: the file name uses the shared `-pause` suffix)\n215: 2. If present:\n216:    - Log event to JSONL: `{\"type\":\"event\",\"event\":\"userPaused\",\"mode\":\"review\",\"stopReason\":\"userPaused\",\"reason\":\"sentinel file detected\"}`\n217:    - Halt the loop with message:\n218:      ```\n219:      Review paused. Delete review/.deep-review-pause to resume.\n220:      Current state: Iteration {N}, {reviewed}/{total} dimensions complete, {P0}/{P1}/{P2} findings.\n221:      ```\n222:    - Do NOT exit to synthesis -- the loop is suspended, not stopped\n223: 3. On resume (file deleted and loop restarted):\n224:    - Log event: `{\"type\":\"event\",\"event\":\"resumed\",\"fromIteration\":N}`\n225:    - Continue from step_read_state\n226: \n227: **Use case**: In autonomous mode, this provides the only graceful intervention mechanism short of killing the process. Users can create the sentinel file at any time to pause review between iterations.\n228: \n229: Normalization rule: if the runtime first observes a raw `paused` condition or a raw `stuck_recovery` condition, it MUST rewrite the emitted JSONL event names to `userPaused` and `stuckRecovery` before appending them. Persisted review JSONL should never contain raw `paused` or raw `stuck_recovery` rows after emission.\n230: \n231: #### Step 2b: Generate State Summary\n232: \n233: Generate a compact state summary (~200 tokens) for injection into the dispatch prompt:\n234: \n235: ```\n236: STATE SUMMARY (auto-generated, review mode):\n237: Iteration: {N} of {max} | Mode: review\n238: Target: {config.reviewTarget} ({config.reviewTargetType})\n239: Dimensions: {reviewed}/{total} complete | Next: {nextDimension}\n240: Findings: P0:{count} P1:{count} P2:{count} active\n241: Traceability: core={core_status} overlay={overlay_status}\n242: Last 2 ratios: {ratio_N-1} -> {ratio_N} | Stuck count: {stuck_count}\n243: Provisional verdict: {PASS|CONDITIONAL|FAIL|PENDING} | hasAdvisories={hasAdvisories}\n244: Next focus: {strategy.nextFocus}\n245: ```\n246: \n247: This summary is prepended to the dispatch context (Step 3) to ensure the agent has baseline context even if detailed strategy.md reading fails or is incomplete.\n248: \n249: #### Step 3: Dispatch Agent\n250: \n251: Dispatch `@deep-review` with review-specific context:\n252: \n253: ```\n254: {state_summary}  // Auto-generated (Step 2b)\n255: \n256: Review Target: {config.reviewTarget}\n257: Review Mode: {config.reviewTargetType}\n258: Iteration: {N} of {maxIterations}\n259: Focus Dimension: {strategy.nextFocus.dimension}\n260: Focus Files: {strategy.nextFocus.files}\n261: Remaining Dimensions: {strategy.remainingDimensions}\n262: Traceability Protocols:\n263:   - Core: {core_protocols}\n264:   - Overlay: {overlay_protocols}\n265: Active Findings: {findingsSummary}\n266: State Files:\n267:   - Config: {artifact_dir}/deep-review-config.json\n268:   - State: {artifact_dir}/deep-review-state.jsonl\n269:   - Registry: {artifact_dir}/deep-review-findings-registry.json\n270:   - Strategy: {artifact_dir}/deep-review-strategy.md\n271: Output: Write findings to {artifact_dir}/iterations/iteration-{NNN}.md\n272: CONSTRAINT: LEAF agent -- do NOT dispatch sub-agents\n273: CONSTRAINT: Target files are READ-ONLY -- never modify code under review\n274: ```\n275: \n276: #### Executor Resolution\n277: \n278: Before dispatching, the YAML resolves the executor via `parseExecutorConfig` from `.skilled/skills/system-deep-loop/runtime/lib/deep-loop/executor-config.ts`. The resolved `config.executor.kind` selects the dispatch branch:\n279: \n280: - `native`: dispatch `@deep-review` agent with model Opus.\n281: - `cli-opencode`: pipe rendered prompt via stdin to `opencode run --model X --format json --dangerously-skip-permissions --pure --dir {repo_root} [--variant Y]`. **This grants full OS-level workspace write access.** There is no `--sandbox workspace-write` flag in the live command, and `sandboxMode='read-only'` is NOT currently honored/enforced by opencode (no opencode equivalent exists). The only real containment is (a) the prompt-level \"ALLOWED WRITE PATHS\" / \"BANNED OPERATIONS\" contract rendered into the iteration prompt (`assets/prompt-pack-iteration.md.tmpl`), which relies on the model obeying instructions rather than an OS-level sandbox, and (b) post-dispatch validation (`validateIterationOutputs`) catching some violations after the fact. Because review targets are arbitrary code/spec files, they MUST be treated as potentially adversarial content (untrusted) for prompt-injection purposes — the same containment posture as untrusted fetched content in deep-research.\n282: - `cli-claude-code`: `claude -p \"$(cat prompt)\" --model X --permission-mode acceptEdits --output-format text` with optional `--effort Y`. Default permission-mode is `plan` (read-only). We override to `acceptEdits` so iteration writes succeed. The inline workflow branches are not the complete schema: `cli-codex` is also an inline branch, while `cli-cursor`, `cli-devin`, `cli-pi` and `cli-deepseek-harness` (experimental) use the shared fan-out adapters; the executor-kind authority is `runtime/lib/deep-loop/executor-config.ts` (`EXECUTOR_KINDS`).\n283: \n284: All branches share:\n285: 1. Pre-dispatch prompt rendering via `renderPromptPack` (writes to `{artifact_dir}/prompts/iteration-{n}.md`).\n286: 2. Post-dispatch validation via `validateIterationOutputs` (asserts iteration file + JSONL delta + required fields).\n287: 3. Executor audit append via `appendExecutorAuditToLastRecord` (skipped when kind=='native').\n288: \n289: Per-kind flag-compatibility is enforced at config parse time by `EXECUTOR_KIND_FLAG_SUPPORT` in `executor-config.ts`. Setting a flag that the chosen kind does not support throws `ExecutorConfigError` before dispatch.\n290: \n291: Cross-CLI delegation (a running executor invoking other CLIs via its shell) is documented design intent. Runtime recursion detection is out of scope. See the SKILL.md Cross-CLI Delegation subsection.\n292: \n293: Two containment rules bind every CLI lineage (any `cli-*` executor kind):\n294: \n295: - **The lineage is the executor, so it works in-process.** A CLI lineage performs each iteration itself, with its own tools, inside the session the driver already started. The YAML's per-iteration executor dispatch steps are satisfied by the lineage. Spawning a second CLI process for the same iteration is a route violation, not an optimization, and on codex it also fails outright (see `cli-external-orchestration/cli-codex/SKILL.md` Rule 18).\n296: - **Write containment attributes every new dirty path outside the lineage directory to the lineage, and reports it rather than undoing it.**\n297:   - Attribution on a shared checkout is a guess: a tracked file changed anywhere in the same checkout during a lineage window looks identical whether the lineage, an operator, or another session wrote it.\n298:   - So the default remedy is preserve. The file is left byte-for-byte as it stands, the finding is recorded on the status ledger and the observability stream, and a lane that produced its review artifacts — its iteration records, and `review-report.md` where it reached synthesis — still settles as complete, carrying `completed_with_containment_advisory`.\n299:   - Restoring is opt-in and safe only on a checkout with a single writer; under it a path that was already dirty when the lineage started is put back to its pre-dispatch bytes, never to HEAD, and a path whose baseline could not be captured is preserved regardless. Untracked files are never deleted in either mode.\n300:   - A path that was already dirty when the lineage started and changed again during it is the one exception to attribution: it has a second writer on record, so under the default remedy it is reported as contested, as a `containment_contested` ledger event and a `containmentContested` field on the lineage output, with a note that the tree shows the bytes changed, not who wrote them. A single-lineage run reports the same path the same way, as a `containment_contested` event in its state log, and the dispatch step prints the paths and the note beside any violations. No quarantine copy, patch or revert is made for it, and its pre-dispatch bytes stay in the baseline capture.\n301:   - A path the lane itself quarantined on an earlier pass stays the lane's, restore keeps the single-owner reading, and a path that was clean at the baseline is still attributed.\n302:   - One exemption still applies to attribution: another run's lineage directory under the same top-level packet is treated as that run's own write surface while its loop lock is live, so two lineages can run in sibling phases of one packet at the same time; a directory with no lock, or a stale one, is still attributed here.\n303:   - The runtime records each finding's diff under the lineage directory at `containment/quarantine/<iteration>[-attempt-<n>]/`, in a `containment-out-of-scope/` subdirectory on the default preserve path and `containment-reverted/` only under restore, where bytes really were rolled back; each pass keeps its own directory so a retry never overwrites an earlier pass's evidence. The pre-dispatch baseline bytes go to `<lineage dir>/containment/baseline/`, so an out-of-scope change stays recoverable either way.\n304: \n305: Failure handling is unchanged: `schema_mismatch` → conflict event → 3 consecutive failures → `stuck_recovery`.\n306: \n307: **Agent constraints**:\n308: - `@deep-review` is LEAF-only: it cannot dispatch sub-agents\n309: - No WebFetch: review is code-only and read-only\n310: - Target 8-11 tool calls per iteration (max 12). Breadth over depth per cycle\n311: \n312: #### Step 3a: Cross-Reference Protocol Execution\n313: \n314: During iterations focused on the Traceability dimension, the agent executes applicable cross-reference protocols. Each protocol produces a structured result appended to the JSONL `traceabilityChecks.results[]` array.\n315: \n316: | Protocol | Execution | Expected Output |\n317: |----------|-----------|-----------------|\n318: | `spec_code` | Compare normative claims in spec.md against shipped implementation | Pass/partial/fail per claim with file:line evidence |\n319: | `checklist_evidence` | Verify every `[x]` mark in checklist.md has supporting evidence | Pass/partial/fail per checked item |\n320: | `skill_agent` | Compare SKILL.md contracts against runtime agent definitions | Agreement/drift/disagreement per capability |\n321: | `agent_cross_runtime` | Compare agent definitions across runtimes (.opencode, .claude, .opencode) | Parity/drift/divergence per runtime pair |\n322: | `feature_catalog_code` | Compare catalog claims against discoverable implementation | Match/stale/missing per feature |\n323: | `playbook_capability` | Validate playbook scenarios against executable reality | Executable/needs-update/impossible per scenario |\n324: \n325: Each protocol result includes:\n326: - `protocolId`: Protocol identifier\n327: - `status`: `pass`, `partial`, or `fail`\n328: - `gateClass`: `hard` or `advisory`\n329: - `applicable`: Whether the protocol applies to this target type\n330: - `counts`: `{ pass, partial, fail, skipped }`\n331: - `evidence`: Array of file:line citations\n332: - `findingRefs`: Array of finding IDs generated from this protocol\n333: - `summary`: Human-readable summary text\n334: \n335: #### Step 3b: Resource Map Coverage Audit\n336: \n337: When `config.resource_map_present == true`, at least one loop iteration MUST audit implementation-vs-resource-map coverage:\n338: \n339: 1. Read `{spec_folder}/resource-map.md`\n340: 2. Read applied reports under `{spec_folder}/applied/T-*.md`\n341: 3. Cross-check `target_files` from the applied reports against resource-map entries\n342: 4. Classify outcomes into:\n343:    - entries touched\n344:    - entries not touched (`expected-by-scope` vs `gap`)\n345:    - implementation paths absent from the map\n346: 5. Emit any resulting findings with category `resource-map-coverage`\n347: \n348: When `config.resource_map_present == false`, skip this audit and rely on the `Known Context` note: `resource-map.md not present. Skipping coverage gate`.\n349: \n350: #### Step 4: Evaluate Results\n351: \n352: After agent completes:\n353: \n354: 1. Verify `{artifact_dir}/iterations/iteration-{NNN}.md` was created\n355: 2. Verify JSONL was appended with review iteration fields:\n356:    - `dimensions` (array of dimensions covered)\n357:    - `filesReviewed` (array of file paths)\n358:    - `findingsSummary` (cumulative P0/P1/P2 counts)\n359:    - `findingsNew` (this iteration's new findings)\n360:    - `traceabilityChecks` (protocol results if applicable)\n361: 3. Verify strategy.md was updated (dimension progress, findings count, protocol status)\n362: 4. Extract `newFindingsRatio` from JSONL record\n363: 5. Update stuck tracking using `noProgressThreshold = 0.05`:\n364:    - Skip if `status == \"thought\"` (no change)\n365:    - Reset to 0 if `status == \"insight\"` (breakthrough counts as progress)\n366:    - Increment if `newFindingsRatio < noProgressThreshold`\n367:    - Reset otherwise\n368: \n369: #### Step 4a: Claim Adjudication\n370: \n371: Before the next convergence pass, the orchestrator adjudicates every new P0/P1 finding with a **typed claim-adjudication packet**. This step prevents false positives from inflating severity and distorting convergence, AND acts as a hard STOP gate: `step_post_iteration_claim_adjudication` appends a `claim_adjudication` event to `deep-review-state.jsonl`, and the next iteration's `step_check_convergence` legal-stop decision tree consults that event via `claimAdjudicationGate` (gate `f`). A missing or failing packet vetoes STOP even when every other gate passes.\n372: \n373: Each new P0/P1 must carry a typed packet with the following required fields (see `../state/state-format.md` §9 for the full schema and a worked example):\n374: \n375: | Field | Type | Description |\n376: |-------|------|-------------|\n377: | `findingId` | string | Matches the finding ID in the iteration body |\n378: | `claim` | string | The single assertion the finding makes |\n379: | `evidenceRefs` | string[] | `file:line` or `file:range` citations (≥ 1) |\n380: | `counterevidenceSought` | string | Where the orchestrator looked for contradicting evidence |\n381: | `alternativeExplanation` | string | An alternative explanation, even if rejected |\n382: | `finalSeverity` | `\"P0\"` \\| `\"P1\"` \\| `\"P2\"` | Severity after adjudication |\n383: | `confidence` | number `[0, 1]` | Orchestrator confidence in `finalSeverity` |\n384: | `downgradeTrigger` | string | Concrete condition that would cause a future downgrade |\n385: | `transitions` | object[] | Optional, required when `finalSeverity` differs from the originally asserted severity |\n386: \n387: **Protocol**:\n388: \n389: 1. Re-read the cited evidence at the referenced file:line locations.\n390: 2. Seek counterevidence in adjacent code, docs, or prior iteration history.\n391: 3. Record an alternative explanation even if it is rejected.\n392: 4. Confirm or downgrade severity before the finding becomes convergence-visible.\n393: 5. Emit the typed packet inside the iteration file so `step_post_iteration_claim_adjudication` can parse it.\n394: \n395: **Failure semantics**: when any new P0/P1 finding is missing a packet or a required field, the workflow records `{\"event\":\"claim_adjudication\",\"passed\":false,\"missingPackets\":[...]}` in `deep-review-state.jsonl`. On the next loop, `step_check_convergence` step 0 (universal pre-check) routes STOP to `BLOCKED` with `blockedBy: [\"claimAdjudicationGate\"]` until a follow-up iteration rewrites the packet. Downgraded findings have their `finalSeverity` updated. The original severity is preserved in the iteration file for audit trail.\n396: \n397: #### Step 4b: Generate Dashboard\n398: \n399: Generate `{artifact_dir}/deep-review-dashboard.md` with review-specific sections:\n400: \n401: | Section | Content |\n402: |---------|---------|\n403: | Status | Provisional verdict (`PASS`/`CONDITIONAL`/`FAIL`/`PENDING`) and `hasAdvisories` flag |\n404: | Findings Summary | P0/P1/P2 counts with deltas from previous iteration |\n405: | Progress Table | Iteration number, focus dimension, `newFindingsRatio`, findings count, status |\n406: | Coverage | Files reviewed, dimensions completed, traceability protocol status |\n407: | Trend | Last 3 `newFindingsRatio` values with direction indicator (ascending/descending/flat) |\n408: | Active Risks | Guard violations, stuck count, budget warnings |\n409: \n410: Dashboard behavior:\n411: - Auto-generated only -- never manually edited\n412: - Overwritten each iteration (not appended)\n413: - Non-blocking: if generation fails, log a warning and continue the loop\n414: - In **confirm mode**: displayed to the user at each iteration approval gate\n415: - In **auto mode**: written silently for post-hoc review\n416: \n417: #### Step 5: Loop Decision\n418: \n419: - If convergence check returns STOP: exit to synthesis\n420: - If STUCK_RECOVERY: apply review-specific recovery strategies (see Section 3a), reset stuck count, continue\n421: - Otherwise: increment iteration counter, go to Step 1\n422: \n423: ### Stuck Recovery (Review-Specific)\n424: \n425: **Threshold:** 2 consecutive no-progress iterations (`noProgressThreshold = 0.05`).\n426: \n427: | Failure Mode | Detection | Recovery Strategy |\n428: |-------------|-----------|-------------------|\n429: | Same dimension stuck | Last 2 iterations reviewed the same dimension with ratios `< 0.05` | **Change granularity**: if reviewing at file level, zoom into functions, if reviewing functions, zoom out to module level |\n430: | Traceability plateau | Required protocols remain partial while ratios stay `< 0.05` | **Protocol-first replay**: re-run the unresolved traceability protocol directly against the conflicting artifacts |\n431: | Low-value advisory churn | Last 2 iterations found only P2 work | **Escalate severity review**: explicitly search for P0/P1 patterns or downgrade unsupported severity claims |\n432: \n433: **Selection logic**:\n434: \n435: ```\n436: function selectReviewRecoveryStrategy(stuckIterations, state, config):\n437:   lastFocuses = [i.focus for i in stuckIterations[-2:]]\n438: \n439:   // Same dimension stuck? Change granularity\n440:   if len(set(lastFocuses)) <= 1:\n441:     return { strategy: \"change_granularity\", dimension: lastFocuses[0] }\n442: \n443:   // Required protocol plateau?\n444:   if hasRequiredProtocolPlateau(state.traceabilityChecks):\n445:     return { strategy: \"protocol_first_replay\" }\n446: \n447:   // Default: escalate severity\n448:   return { strategy: \"escalate_severity_review\" }\n449: ```\n450: \n451: **Recovery evaluation**:\n452: - If recovery iteration finds any new P0/P1 or materially advances required traceability coverage: recovery successful. Reset stuck count. Continue.\n453: - If recovery iteration finds only P2 or nothing: recovery failed. If all dimensions are already covered, exit to synthesis. Otherwise, move to the next unreviewed dimension.\n454: \n455: ---\n456: \n457: ## 4. PHASE 3: SYNTHESIS\n458: \n459: ### Purpose\n460: \n461: Compile all iteration findings into the final `{artifact_dir}/review-report.md`. The synthesis phase owns the canonical review report output.\n462: \n463: ### Steps\n464: \n465: #### Step 1: Finding Registry Deduplication\n466: \n467: Consolidate findings across all iterations:\n468: \n469: 1. Read all iteration files: `{artifact_dir}/iterations/iteration-*.md`\n470: 2. Group findings by file + line range + root cause\n471: 3. Merge duplicates, keeping the highest severity and all evidence\n472: 4. Assign final finding IDs: `F001`, `F002`, ...\n473: 5. Preserve the audit trail: note which iterations contributed to each merged finding\n474: \n475: #### Step 2: Severity Reconciliation\n476: \n477: Use adjudicated `finalSeverity` for any P0/P1 that was downgraded during claim adjudication (Step 4a of the iteration loop). The original severity from the iteration file is preserved in the audit appendix.\n478: \n479: #### Step 3: Replay Validation\n480: \n481: Recompute the convergence outcome from JSONL state before finalizing the report:\n482: \n483: 1. Read `deep-review-state.jsonl` and select review-mode iteration records in run order\n484: 2. Recompute `newFindingsRatio`, rolling-average votes, MAD votes, and coverage votes from stored JSONL fields only\n485: 3. Recompute `traceabilityChecks.summary` and confirm required protocol statuses match the recorded coverage vote\n486: 4. Re-run the evidence, scope, and coverage gates against stored findings and scope data\n487: 5. Compare the replayed decision and stop reason to the recorded synthesis event\n488: \n489: This synthesis-stage replay is a **full-history audit replay** over the stored JSONL state. It follows the same full-history replay discipline as the per-iteration reducer refresh above, but runs as an explicit pre-synthesis audit.\n490: \n491: Replay passes only when the recomputed decision, thresholds, and gate outcomes agree with the persisted result. If replay fails, log a warning in the audit appendix but proceed with synthesis.\n492: \n493: #### Step 4: Compile review-report.md\n494: \n495: Generate the 9 core review-report sections (defined in `review-mode-contract.yaml` under `outputs.reviewReport`) and insert `## Resource Map Coverage Gate` between `Traceability Status` and `Deferred Items` when `config.resource_map_present == true`:\n496: \n497: | # | Section | Purpose |\n498: |---|---------|---------|\n499: | 1 | Executive Summary | Verdict, active P0/P1/P2 counts, scope, `hasAdvisories` metadata |\n500: | 2 | Planning Trigger | Why the verdict routes to planning or changelog follow-up |\n501: | 3 | Active Finding Registry | Deduplicated active findings with evidence and final severity |\n502: | 4 | Remediation Workstreams | Grouped action lanes derived from active findings |\n503: | 5 | Spec Seed | Minimal spec delta derived from review results |\n504: | 6 | Plan Seed | Action-ready plan starter for remediation |\n505: | 7 | Traceability Status | Core vs overlay protocol status and unresolved gaps |\n506: | 8 | Resource Map Coverage Gate | Present only when `config.resource_map_present == true`, reports touched entries, untouched entries (`expected-by-scope` vs `gap`), and implementation paths absent from the map |\n507: | 9 | Deferred Items | P2 advisories, blocked checks, and follow-up items |\n508: | 10 | Audit Appendix | Coverage, replay validation, convergence evidence |\n509: \n510: #### Step 5: Verdict Determination\n511: \n512: Apply the verdict contract from `review-mode-contract.yaml`:\n513: \n514: | Verdict | Condition | Next Command |\n515: |---------|-----------|--------------|\n516: | **FAIL** | Active P0 remains OR any required binary gate fails | `/speckit:plan` for remediation |\n517: | **CONDITIONAL** | No active P0, but active P1 remains | `/speckit:plan` for fixes |\n518: | **PASS** | No active P0/P1 | `/create:changelog` |\n519: \n520: When `PASS` verdict is issued and active P2 findings remain, set `hasAdvisories = true` in the report metadata.\n521: \n522: #### Step 6: Finalize State\n523: \n524: 1. Update config status: Set `status: \"complete\"` in `deep-review-config.json`\n525: 2. Write final JSONL entry:\n526:    ```json\n527:    {\n528:      \"type\": \"event\",\n529:      \"event\": \"synthesis_complete\",\n530:      \"mode\": \"review\",\n531:      \"totalIterations\": N,\n532:      \"verdict\": \"PASS|CONDITIONAL|FAIL\",\n533:      \"activeP0\": N,\n534:      \"activeP1\": N,\n535:      \"activeP2\": N,\n536:      \"dimensionCoverage\": X,\n537:      \"stopReason\": \"...\",\n538:      \"timestamp\": \"...\"\n539:    }\n540:    ```\n541: \n542: ---\n543: \n544: ## 5. PHASE 4: SAVE\n545: \n546: ### Purpose\n547: \n548: Preserve review context to the memory system for future session recovery and cross-session continuity.\n549: \n550: ### Steps\n551: \n552: 1. **Compose context payload**: Create a structured JSON payload with the review summary, active findings, verdict, next action, and relevant artifacts. Use `specFolder` for the target packet and include curated `observations`, `recent_context`, `toolCalls`, and `exchanges` when available.\n553: \n554: 2. **Generate context**: Run the memory save script with structured JSON via `--stdin`, `--json`, or a session-scoped JSON file:\n555:    ```bash\n556:    node .skilled/skills/system-spec-kit/runtime/cli/dist/continuity/generate-context.js --json '{\"specFolder\":\"{spec_folder}\",\"sessionSummary\":\"Deep review completed; see review/review-report.md for verdict and findings.\"}' {spec_folder}\n557:    ```\n558: \n559: 3. **No extra indexing step in the live contract**: `generate-context.js` is the supported save boundary for this workflow.\n560: \n561: 4. **Verify**: Confirm the routed canonical spec document carries the review continuity update. Expected targets are `implementation-summary.md`, `decision-record.md`, or `handover.md`; standalone `memory/*.md` files are retired and should not be created.\n562: \n563: ### On Save Failure\n564: \n565: If memory save fails:\n566: - Preserve the current `review/` packet as backup (the disk state is the ground truth)\n567: - Log the error\n568: - The review results remain intact in `{artifact_dir}/review-report.md` regardless of memory save status\n569: \n570: ---\n571: \n572: ## 6. AUTO-RESUME PROTOCOL\n573: \n574: ### Purpose\n575: \n576: Enable review sessions to resume cleanly from prior state when interrupted by context compaction, process termination, or intentional pause.\n577: \n578: ### Resume Detection\n579: \n580: If state files already exist from a prior session:\n581: \n582: 1. **Verify agreement**: Confirm config, JSONL, findings registry, and strategy all exist and agree on target/spec folder\n583: 2. **Count progress**: Read JSONL, count iteration records, determine last completed iteration\n584: 3. **Read strategy**: Load current dimension progress, findings, and next focus from `deep-review-strategy.md`\n585: 4. **Set counter**: Set iteration counter to last completed + 1\n586: 5. **Log resume**: Append the canonical resume event to `deep-review-state.jsonl`. The reducer requires every field below:\n587:    ```json\n588:    {\"type\":\"event\",\"event\":\"resumed\",\"mode\":\"review\",\"sessionId\":\"rvw-2026-03-24T10-00-00Z\",\"parentSessionId\":\"rvw-2026-03-24T10-00-00Z\",\"lineageMode\":\"resume\",\"continuedFromRun\":4,\"generation\":1,\"archivedPath\":null,\"timestamp\":\"2026-03-24T14:05:00Z\"}\n589:    ```\n590: 6. **Continue**: Enter the iteration loop from step_read_state\n591: \n592: ### Lifecycle Branches (current release)\n593: \n594: The runtime supports three lineage modes today. `fork` and `completed-continue` were described in earlier drafts but have no workflow wiring in this release, so they MUST NOT be exposed to operators. If the long-form lineage feature is picked up later it will arrive with first-class event emission, reducer ancestry handling, and replay fixtures. Until then treat the contract below as canonical.\n595: \n596: | Mode | Session id | Generation | Archive | JSONL event | When to pick |\n597: |------|-----------|-----------|---------|-------------|--------------|\n598: | `new` | fresh | 1 | n/a | implicit (config record) | no existing state |\n599: | `resume` | same | same | none | `resumed` (see example above) | operator wants to continue the current lineage boundary |\n600: | `restart` | fresh | `prior + 1` | prior `review/` tree moved under `review-archive/{timestamp}/` | `restarted` (same field set plus non-null `archivedPath`) | operator wants to clear the workspace and replay with a new angle |\n601: \n602: **Contract for every persisted lifecycle event**:\n603: \n604: ```json\n605: {\n606:   \"type\": \"event\",\n607:   \"event\": \"resumed | restarted\",\n608:   \"mode\": \"review\",\n609:   \"sessionId\": \"<session id of the new or continuing lineage>\",\n610:   \"parentSessionId\": \"<session id of the prior lineage (equals sessionId on resume)>\",\n611:   \"lineageMode\": \"resume | restart\",\n612:   \"generation\": <number>,\n613:   \"continuedFromRun\": <number or null>,\n614:   \"archivedPath\": \"<path or null>\",\n615:   \"timestamp\": \"<ISO 8601>\"\n616: }\n617: ```\n618: \n619: Every field in the contract MUST be present on every persisted lifecycle event. `archivedPath` is null for `resumed` and set to the archive destination for `restarted`. `continuedFromRun` is the number of completed iteration records before the lifecycle boundary. Reducer parity tests ensure the dashboard `Lifecycle` section reads exactly those fields.\n620: \n621: ### State Validation on Resume\n622: \n623: | Condition | Classification | Action |\n624: |-----------|---------------|--------|\n625: | Config + JSONL + strategy all exist and agree | `resume` | Continue from last iteration + 1 |\n626: | All exist, config says `status: \"complete\"` | `completed-session` | Report completion, ask user if re-review desired |\n627: | Partial files or contradictions | `invalid-state` | Halt for repair, do not guess |\n628: | No files exist | `fresh` | Start new initialization |\n629: \n630: ### State Recovery Cascade\n631: \n632: When state files are missing or corrupted, apply this priority cascade:\n633: \n634: | Priority | Condition | Recovery Action |\n635: |----------|-----------|----------------|\n636: | 1 | JSONL exists and parseable | Normal operation |\n637: | 2 | JSONL exists, strategy.md missing | Reconstruct strategy from JSONL: extract dimensions, findings, coverage |\n638: | 3 | JSONL missing, iteration files exist | Scan `review/iterations/iteration-*.md`, reconstruct JSONL with `status: \"reconstructed\"` |\n639: | 4 | Only config.json remains | Restart from initialization phase |\n640: | 5 | Config.json also missing | Cannot recover. Report error and halt. |\n641: \n642: Each priority level is attempted in order. If a level fails, fall through to the next.\n643: \n644: ---\n645: \n646: ## 7. PAUSE/RESUME\n647: \n648: ### Pause Sentinel Behavior\n649: \n650: The pause sentinel provides graceful loop suspension in autonomous mode without killing the process.\n651: \n652: ### Creating a Pause\n653: \n654: Create the sentinel file at any time:\n655: \n656: ```bash\n657: touch {artifact_dir}/.deep-review-pause\n658: ```\n659: \n660: The orchestrator checks for this file between iterations (Step 2a). When detected:\n661: - The current iteration is allowed to complete\n662: - The loop halts before dispatching the next iteration\n663: - A paused event is logged to JSONL\n664: - The user is notified with current state (iteration count, dimensions covered, findings)\n665: \n666: ### Resuming After Pause\n667: \n668: Delete the sentinel file and restart the workflow:\n669: \n670: ```bash\n671: rm {artifact_dir}/.deep-review-pause\n672: ```\n673: \n674: On the next invocation:\n675: - The auto-resume protocol (Section 6) detects the existing state\n676: - A resumed event is logged to JSONL\n677: - The loop continues from the next iteration\n678: \n679: ### Confirm Mode Approval Gates\n680: \n681: In confirm mode (`deep-review-confirm.yaml`), the workflow adds explicit approval gates instead of relying on the pause sentinel:\n682: \n683: | Gate Location | Behavior |\n684: |---------------|----------|\n685: | After initialization | Show config, strategy, and scope. Wait for approval |\n686: | After each iteration | Show iteration findings, dashboard, and convergence status. Options: Continue, Adjust Focus, Stop |\n687: | Before synthesis | Show summary of all iterations. Wait for approval to synthesize |\n688: | After synthesis | Show final review-report.md summary. Approve or request revisions |\n689: \n690: ---\n691: \n692: ## 8. STATE TRANSITIONS, ERROR HANDLING, AND QUALITY GATES\n693: \n694: State-transition rules, error handling, and the review quality gates live in `loop-state-and-gates.md` for navigability.\n695: \n696: ---\n697: \n698: ## 9. EXECUTOR SELECTION CONTRACT\n699: \n700: Executor settings are owned by the YAML workflow and rendered prompt pack. Do not bypass the workflow by hand-dispatching review iterations; each iteration stays LEAF-only and produces the required markdown plus JSONL delta.\n701: \n702: ### Invariants\n703: \n704: Every executor path MUST satisfy:\n705: \n706: 1. Produce an iteration markdown file at `{state_paths.iteration_pattern}` (non-empty).\n707: 2. Append a JSONL delta record to `{state_paths.state_log}` with required fields: `type`, `iteration`, `dimensions`, `filesReviewed`, `findingsSummary`, `findingsNew`, `findingDetails`, `newFindingsRatio`.\n708: 3. Respect the LEAF-agent constraint: no sub-dispatch, no nested loops. Max 12 tool calls per iteration.\n709: \n710: ### Failure Modes\n711: \n712: - Missing iteration file: `iteration_file_missing` from `post-dispatch-validate.ts`, emits a `schema_mismatch` conflict event.\n713: - Empty iteration file: `iteration_file_empty`, same downstream.\n714: - JSONL not appended: `jsonl_not_appended`.\n715: - JSONL missing required fields: `jsonl_missing_fields`.\n716: - JSONL malformed: `jsonl_parse_error`.\n717: - 3 consecutive failures: existing `stuck_recovery` event (unchanged).\n718: \n719: ### JSONL Audit Field\n720: \n721: Non-native executor runs append an `executor` block with model and runtime settings to the iteration's JSONL record via `executor-audit.ts`. Native runs are recoverable from YAML alone.\n722: \n723: ### Template And Config Surface\n724: \n725: The executor-agnostic iteration prompt lives at `assets/prompt-pack-iteration.md.tmpl`, rendered by `prompt-pack.ts` before dispatch and either injected as the agent's context (native) or piped to `opencode run` stdin (cli-opencode). Config is in `assets/deep-review-config.json` under the `executor` key; schema in `runtime//lib/deep-loop/executor-config.ts`. CLI flag precedence: `--executor/--model/--reasoning-effort/--service-tier/--executor-timeout > config file > schema default`.\n726: \n727: ### What Never Changes Regardless Of Executor Route\n728: \n729: - YAML owns state (`deep-review-state.jsonl`, strategy.md, registry, dashboard).\n730: - `reduce-state.cjs` is the single state writer.\n731: - Convergence detection, lifecycle events (new/resume/restart), the review dimensions pass, and stuck_recovery stay YAML-driven.\n732: - The `@deep-review` LEAF agent definition is untouched: it is the native executor, not the only one.\n733: \n734: ### Code-Graph Readiness TrustState Surface\n735: \n736: On this skill surface, the live code-graph readiness contract only reaches four TrustState values: `live`, `stale`, `absent`, and `unavailable`. The values `cached`, `imported`, `rebuilt`, and `rehomed` remain declared in the shared TrustState type for compatibility and downstream schema stability, but the seven code-graph handlers and readiness helpers used here do not emit them today.\n737: \n738: ---\n739: \n740: ## 10. RELATED RESOURCES\n741: \n742: ### Shared Protocol Documentation\n743: \n744: Protocol documents from `deep-research` are cross-referenced, not duplicated:\n745: \n746: | Document | Path | Purpose |\n747: |----------|------|---------|\n748: | Loop Protocol (research) | `../deep-research/references/protocol/loop-protocol.md` | Research loop lifecycle (this file adapts Section 9) |\n749: | State Format | `../deep-research/references/state/state-format.md` | JSONL, strategy, and config schemas |\n750: | Convergence | `../deep-research/references/convergence/convergence.md` | `shouldContinue_review()` (Section 10), stuck recovery, quality guards |\n751: \n752: ### Review-Specific Resources\n753: \n754: | Resource | Path | Purpose |\n755: |----------|------|---------|\n756: | Review Contract | `assets/review-mode-contract.yaml` | Single source of truth for dimensions, verdicts, gates, protocols |\n757: | Quick Reference | `references/protocol/quick-reference.md` | One-page review cheat sheet |\n758: | Strategy Template | `assets/deep-review-strategy.md` | Template for review strategy files |\n759: | Config Template | `assets/deep-review-config.json` | Template for review config files |\n760: | Dashboard Template | `assets/deep-review-dashboard.md` | Template for auto-generated dashboard |\n761: \n762: ### Workflow Files\n763: \n764: | Mode | Path |\n765: |------|------|\n766: | Auto (unattended) | `.skilled/commands/deep/assets/deep-review-auto.yaml` |\n767: | Confirm (step-by-step) | `.skilled/commands/deep/assets/deep-review-confirm.yaml` |\n768: \n769: ### Agent\n770: \n771: | Agent | Path Pattern | Constraint |\n772: |-------|-------------|------------|\n773: | `@deep-review` | `{runtime_dir}/deep-review.{ext}` | LEAF-only, no sub-agents, no WebFetch, target files read-only |\n774: \n775: Runtime paths:\n776: - OpenCode / Copilot: `.opencode/agents/deep-review.md`\n777: - Claude: `.claude/agents/deep-review.md`","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file .skilled/skills/system-deep-loop/deep-review/references/protocol/loop-protocol.md, lines 1-777\n1: ---\n2: title: Deep Review Loop Protocol\n3: description: Complete lifecycle specification for the autonomous deep review loop, initialization, iteration, convergence, synthesis, and save phases.\n4: trigger_phrases:\n5:   - \"deep review loop protocol\"\n6:   - \"review iteration lifecycle\"\n7:   - \"review loop initialization\"\n8:   - \"review auto resume\"\n9:   - \"review synthesis phase\"\n10: importance_tier: important\n11: contextType: implementation\n12: version: 1.11.7.0\n13: ---\n14: \n15: # Deep Review Loop Protocol\n16: \n17: Complete lifecycle specification for the autonomous deep review loop.\n18: \n19: ---\n20: \n21: ## 1. OVERVIEW\n22: \n23: ### Purpose\n24: \n25: The deep review loop has 4 phases: initialization, iteration (repeated), synthesis, and save. The YAML workflow manages the lifecycle. The `@deep-review` agent (LEAF-only, no WebFetch) executes individual review iterations with fresh context each time.\n26: \n27: ### When to Use\n28: \n29: - Initiating a deep-review loop on a spec folder, skill, agent, or track.\n30: - Resuming a paused or interrupted review session from prior state.\n31: - Validating the 4-phase lifecycle and lineage protocol against current behavior.\n32: - Auditing iteration-dispatch, convergence, or save-phase contracts before changes.\n33: \n34: ```\n35: ┌──────────────┐     ┌───────────────────────────────┐     ┌───────────────┐     ┌──────────┐\n36: │  INIT        │────>│  LOOP                         │────>│  SYNTHESIS    │────>│  SAVE    │\n37: │              │     │  ┌─────────────────────────┐  │     │               │     │          │\n38: │ Scope        │     │  │ Read State              │  │     │ Finding       │     │ Memory   │\n39: │ Discovery    │     │  │ Check Convergence       │  │     │ Registry      │     │ Context  │\n40: │ Dimension    │     │  │ Check Pause Sentinel    │  │     │ Dedup         │     │ Save     │\n41: │ Ordering     │     │  │ Generate State Summary  │  │     │               │     │          │\n42: │ Traceability │     │  │ Dispatch @deep-review   │  │     │ Severity      │     │          │\n43: │ Planning     │     │  │ Evaluate Results        │  │     │ Reconcile     │     │          │\n44: │ State Files  │     │  │ Claim Adjudication      │  │     │               │     │          │\n45: │              │     │  │ Dashboard Generation    │  │     │ Replay        │     │          │\n46: │              │     │  │ Loop Decision           │  │     │ Validation    │     │          │\n47: │              │     │  └────────┬────────────────┘  │     │               │     │          │\n48: │              │     │           │ repeat            │     │ review-report │     │          │\n49: │              │     │           │                   │     │ (9 core +     │     │          │\n50: │              │     │           │                   │     │  resource-map)│     │          │\n51: └──────────────┘     └───────────────────────────────┘     └───────────────┘     └──────────┘\n52: ```\n53: \n54: ### Core Innovation\n55: \n56: Each agent dispatch gets a fresh context window. State continuity comes from files on disk, not in-context memory. This eliminates context degradation in long review sessions where accumulated findings would otherwise bias subsequent dimensions.\n57: \n58: ### Key References\n59: \n60: | Resource | Path | Purpose |\n61: |----------|------|---------|\n62: | Review contract | `assets/review-mode-contract.yaml` | Dimensions, verdicts, gates, protocols |\n63: | Auto workflow | `.skilled/commands/deep/assets/deep-review-auto.yaml` | Unattended review loop |\n64: | Confirm workflow | `.skilled/commands/deep/assets/deep-review-confirm.yaml` | Step-by-step review with approval gates |\n65: | Agent | `@deep-review` (LEAF) | Single iteration executor, no sub-agents, no WebFetch |\n66: | Memory save | `generate-context.js` | Context preservation script |\n67: \n68: ---\n69: \n70: ## 2. PHASE 1: INITIALIZATION\n71: \n72: ### Purpose\n73: \n74: Set up all state files for a new review session. Discover the scope, order dimensions by risk priority, establish the traceability protocol plan, and create the review state packet.\n75: \n76: ### Steps\n77: \n78: 1. **Classify session state before writing**:\n79:    - `fresh`: no config/state/strategy files exist\n80:    - `resume`: config + state + strategy all exist and agree\n81:    - `completed-session`: consistent prior state with `config.status == \"complete\"`\n82:    - `invalid-state`: partial or contradictory artifacts\n83:    - Review state still under `scratch/` is moved to the canonical names before this step, and nothing is appended then. The moved state log was written without the ledger, so a resume or synthesis sets it aside as `deep-review-state.legacy.jsonl`, opens the run from the moved config and replays its iteration rows through the append gateway. The `deep_review.migration` row is appended once, at the top of the first iteration.\n84: \n85: 2. **Resolve local artifact owner**: `artifact_dir = resolveArtifactRoot(specFolder, 'review').artifactDir`, then `mkdir -p {artifact_dir}/iterations`\n86: \n87: 3. **Scope discovery**: Resolve the review target into a concrete file list using one of 5 target types:\n88: \n89:    | Target Type | CLI Value | Resolution Strategy |\n90:    |-------------|-----------|---------------------|\n91:    | **Spec Folder** | `spec-folder` | Read `spec.md`, `plan.md`, implementation files listed in `tasks.md` |\n92:    | **Skill** | `skill` | Read `SKILL.md`, `references/`, `assets/`, `scripts/`, find agent definitions and command entry points |\n93:    | **Agent** | `agent` | Find agent definitions across all runtimes, compare for consistency |\n94:    | **Track** | `track` | List all child spec folders under the track, read `spec.md` + `checklist.md` for each |\n95:    | **Files** | `files` | Expand glob patterns, validate existence, discover cross-references |\n96: \n97:    Store the resolved file list in strategy.md \"Files Under Review\".\n98: \n99: 4. **Dimension ordering**: Order the 4 review dimensions for iteration based on risk priority:\n100: \n101:    | Priority | Dimension | Rationale |\n102:    |----------|-----------|-----------|\n103:    | 1 | Correctness | Logic errors have the highest blast radius |\n104:    | 2 | Security | Vulnerabilities require immediate attention |\n105:    | 3 | Traceability | Spec/code alignment ensures completeness |\n106:    | 4 | Maintainability | Patterns and documentation quality (lowest immediate risk) |\n107: \n108:    Default order: D1 Correctness, D2 Security, D3 Traceability, D4 Maintainability. This order is configurable but the default prioritizes highest-impact dimensions first.\n109: \n110: 5. **Traceability protocol planning**: Partition the 6 cross-reference protocols into core vs overlay, and schedule only applicable overlays for the target type:\n111: \n112:    | Level | Protocol | Applies To | Gate Class | Purpose |\n113:    |-------|----------|------------|------------|---------|\n114:    | Core | `spec_code` | all targets | hard | Verify normative claims resolve to shipped behavior |\n115:    | Core | `checklist_evidence` | all targets | hard | Verify checked completion claims have evidence |\n116:    | Overlay | `skill_agent` | skill | advisory | Verify SKILL.md and runtime agents agree |\n117:    | Overlay | `agent_cross_runtime` | agent | advisory | Verify runtime agent parity |\n118:    | Overlay | `feature_catalog_code` | skill, spec-folder, track, files | advisory | Verify catalog claims match capability |\n119:    | Overlay | `playbook_capability` | skill, agent, spec-folder | advisory | Verify playbook scenarios match executable reality |\n120: \n121:    Only schedule overlay protocols that apply to the resolved target type.\n122: \n123: 6. **Write config**: `{artifact_dir}/deep-review-config.json` with `mode: \"review\"`, lineage metadata (`sessionId`, `parentSessionId`, `lineageMode`, `generation`, `continuedFromRun`, `releaseReadinessState`), and review-specific fields including target, target type, dimensions, protocol plan, and release-readiness state.\n124: \n125: 7. **Initialize state log**: First line of `{artifact_dir}/deep-review-state.jsonl` with config record including `mode: \"review\"` and the lineage fields.\n126: \n127: 8. **Initialize reducer state**: Create `{artifact_dir}/deep-review-findings-registry.json` with empty `openFindings`, `resolvedFindings`, `repeatedFindings`, `dimensionCoverage`, `findingsBySeverity`, and `convergenceScore`.\n128: \n129: 9. **Initialize strategy**: `{artifact_dir}/deep-review-strategy.md` from review template with:\n130:    - Topic (review target description)\n131:    - Review Dimensions checklist\n132:    - Files Under Review table\n133:    - Cross-Reference Status table grouped by core vs overlay\n134:    - Known Context from the continuity ladder and ripgrep recipes (if any)\n135:    - Resource-map snapshot when `{spec_folder}/resource-map.md` exists at init\n136:    - `resource-map.md not present. Skipping coverage gate` when it does not\n137:    - Review Boundaries from config\n138: 9a. **Initialize resource-map coverage state**:\n139:    - If `{spec_folder}/resource-map.md` exists at init: set `resource_map_present = true`, add `Resource Map Coverage` to the Review Charter, and persist a concise map summary in `Known Context`\n140:    - If absent: set `resource_map_present = false`, record the skip note in `Known Context`, and continue without failing\n141: \n142: 10. **Validate review charter**:\n143:    - Verify strategy.md contains Non-Goals and Stop Conditions sections (may be empty but must exist)\n144:    - In **confirm mode**: present the charter (target, dimensions, scope, non-goals) for user review before proceeding\n145:    - In **auto mode**: accept automatically and continue\n146: \n147: 11. **Resume only if config, JSONL, strategy, and findings registry agree**. Otherwise halt for repair instead of guessing.\n148: \n149: ### Outputs\n150: \n151: | File | Location | Purpose |\n152: |------|----------|---------|\n153: | Config | `{artifact_dir}/deep-review-config.json` | Review parameters (immutable after init) |\n154: | State | `{artifact_dir}/deep-review-state.jsonl` | Iteration log (1 initial line) |\n155: | Registry | `{artifact_dir}/deep-review-findings-registry.json` | Reducer-owned findings state |\n156: | Strategy | `{artifact_dir}/deep-review-strategy.md` | Dimensions, findings, next focus |\n157: \n158: ---\n159: \n160: ## 3. PHASE 2: ITERATION LOOP\n161: \n162: ### Loop Steps (repeated until convergence)\n163: \n164: #### Step 1: Read State\n165: \n166: - Read `deep-review-state.jsonl` -- count iterations, extract `newFindingsRatio`, `findingsSummary`, `findingsNew`, `traceabilityChecks`, and lineage data\n167: - Read `deep-review-findings-registry.json` -- extract `dimensionsCovered`, `findingsBySeverity`, `openFindings`, `resolvedFindings`, and `convergenceScore`\n168: - Read `{artifact_dir}/deep-review-strategy.md` -- get next focus dimension/files, remaining dimensions, and protocol gaps\n169: \n170: Reducer contract for every loop refresh:\n171: \n172: | Reducer Part | Canonical Value | Notes |\n173: |--------------|-----------------|-------|\n174: | Inputs | `fullJSONLHistory`, `iterationFiles`, `priorReducedState` | Normal loop refresh is full-history: replay the persisted JSONL state and current iteration corpus each refresh so reducer output stays deterministic across restart, compaction, and synthesis audit paths. |\n175: | Outputs | `findingsRegistry`, `dashboardMetrics`, `strategyUpdates` | The same refresh pass updates the canonical registry, refreshes dashboard metrics, and applies strategy updates. |\n176: | Metrics | `dimensionsCovered`, `findingsBySeverity`, `openFindings`, `resolvedFindings`, `convergenceScore` | These metrics drive convergence decisions, dashboard summaries, and synthesis readiness. |\n177: \n178: #### Step 2: Check Convergence\n179: \n180: Run `shouldContinue_review()` (see `../deep-research/references/convergence/convergence.md` Section 10.3):\n181: \n182: - Max iterations reached? `STOP`\n183: - Stuck count `>= 2` using `noProgressThreshold = 0.05`? `STUCK_RECOVERY`\n184: - Composite convergence votes `STOP` only after:\n185:   - Rolling average uses `rollingStopThreshold = 0.08`\n186:   - Dimension coverage reaches 100% across the 4-dimension model\n187:   - Coverage has aged through `minStabilizationPasses >= 1`\n188:   - Required traceability protocols are covered\n189:   - Evidence, scope, and coverage gates pass\n190: - Otherwise: `CONTINUE`\n191: \n192: If convergence math or a hard-stop candidate points to STOP, the workflow must run the review legal-stop decision tree before actually stopping. That decision tree records nine review-specific gates: `convergenceGate`, `dimensionCoverageGate`, `p0ResolutionGate`, `evidenceDensityGate`, `hotspotSaturationGate`, `claimAdjudicationGate`, `fixCompletenessReplayGate`, `candidateCoverageGate`, and `graphlessFallbackGate` (see `../convergence/convergence.md` §1 blocked_stop event example for the authoritative shape). The Step 4a claim-adjudication path treats `claimAdjudicationGate` as a hard STOP gate, so the count covers both the convergence decision tree and the adjudication enforcement path. `candidateCoverageGate` and `graphlessFallbackGate` are v2-rollout gates that pass trivially when the review-depth-v2 search path is inactive. If any gate fails, the loop does **not** stop. Instead it emits a first-class `blocked_stop` JSONL event with:\n193: \n194: - `blockedBy`: array of the failed review gate names\n195: - `gateResults`: per-gate pass/fail payloads using the review gate names above\n196: - `recoveryStrategy`: one-line hint describing the next review action\n197: \n198: The blocked-stop event is append-only evidence that legal-stop blocked the run. The loop then continues with the recovery or next-focus path rather than synthesizing.\n199: \n200: Convergence signals and weights:\n201: \n202: | Signal | Weight | Description |\n203: |--------|--------|-------------|\n204: | Rolling Average | 0.30 | Last 2 severity-weighted `newFindingsRatio` values average below `rollingStopThreshold` |\n205: | MAD Noise Floor | 0.25 | Latest ratio within noise floor derived from historical ratios |\n206: | Dimension Coverage | 0.45 | All 4 dimensions plus required traceability protocols covered, with stabilization |\n207: \n208: **P0 override**: Any new P0 finding sets `newFindingsRatio >= 0.50`, blocking convergence regardless of composite score.\n209: \n210: #### Step 2a: Check Pause Sentinel\n211: \n212: Before dispatching, check for a pause sentinel file:\n213: \n214: 1. Check if `review/.deep-review-pause` exists (note: the file name uses the shared `-pause` suffix)\n215: 2. If present:\n216:    - Log event to JSONL: `{\"type\":\"event\",\"event\":\"userPaused\",\"mode\":\"review\",\"stopReason\":\"userPaused\",\"reason\":\"sentinel file detected\"}`\n217:    - Halt the loop with message:\n218:      ```\n219:      Review paused. Delete review/.deep-review-pause to resume.\n220:      Current state: Iteration {N}, {reviewed}/{total} dimensions complete, {P0}/{P1}/{P2} findings.\n221:      ```\n222:    - Do NOT exit to synthesis -- the loop is suspended, not stopped\n223: 3. On resume (file deleted and loop restarted):\n224:    - Log event: `{\"type\":\"event\",\"event\":\"resumed\",\"fromIteration\":N}`\n225:    - Continue from step_read_state\n226: \n227: **Use case**: In autonomous mode, this provides the only graceful intervention mechanism short of killing the process. Users can create the sentinel file at any time to pause review between iterations.\n228: \n229: Normalization rule: if the runtime first observes a raw `paused` condition or a raw `stuck_recovery` condition, it MUST rewrite the emitted JSONL event names to `userPaused` and `stuckRecovery` before appending them. Persisted review JSONL should never contain raw `paused` or raw `stuck_recovery` rows after emission.\n230: \n231: #### Step 2b: Generate State Summary\n232: \n233: Generate a compact state summary (~200 tokens) for injection into the dispatch prompt:\n234: \n235: ```\n236: STATE SUMMARY (auto-generated, review mode):\n237: Iteration: {N} of {max} | Mode: review\n238: Target: {config.reviewTarget} ({config.reviewTargetType})\n239: Dimensions: {reviewed}/{total} complete | Next: {nextDimension}\n240: Findings: P0:{count} P1:{count} P2:{count} active\n241: Traceability: core={core_status} overlay={overlay_status}\n242: Last 2 ratios: {ratio_N-1} -> {ratio_N} | Stuck count: {stuck_count}\n243: Provisional verdict: {PASS|CONDITIONAL|FAIL|PENDING} | hasAdvisories={hasAdvisories}\n244: Next focus: {strategy.nextFocus}\n245: ```\n246: \n247: This summary is prepended to the dispatch context (Step 3) to ensure the agent has baseline context even if detailed strategy.md reading fails or is incomplete.\n248: \n249: #### Step 3: Dispatch Agent\n250: \n251: Dispatch `@deep-review` with review-specific context:\n252: \n253: ```\n254: {state_summary}  // Auto-generated (Step 2b)\n255: \n256: Review Target: {config.reviewTarget}\n257: Review Mode: {config.reviewTargetType}\n258: Iteration: {N} of {maxIterations}\n259: Focus Dimension: {strategy.nextFocus.dimension}\n260: Focus Files: {strategy.nextFocus.files}\n261: Remaining Dimensions: {strategy.remainingDimensions}\n262: Traceability Protocols:\n263:   - Core: {core_protocols}\n264:   - Overlay: {overlay_protocols}\n265: Active Findings: {findingsSummary}\n266: State Files:\n267:   - Config: {artifact_dir}/deep-review-config.json\n268:   - State: {artifact_dir}/deep-review-state.jsonl\n269:   - Registry: {artifact_dir}/deep-review-findings-registry.json\n270:   - Strategy: {artifact_dir}/deep-review-strategy.md\n271: Output: Write findings to {artifact_dir}/iterations/iteration-{NNN}.md\n272: CONSTRAINT: LEAF agent -- do NOT dispatch sub-agents\n273: CONSTRAINT: Target files are READ-ONLY -- never modify code under review\n274: ```\n275: \n276: #### Executor Resolution\n277: \n278: Before dispatching, the YAML resolves the executor via `parseExecutorConfig` from `.skilled/skills/system-deep-loop/runtime/lib/deep-loop/executor-config.ts`. The resolved `config.executor.kind` selects the dispatch branch:\n279: \n280: - `native`: dispatch `@deep-review` agent with model Opus.\n281: - `cli-opencode`: pipe rendered prompt via stdin to `opencode run --model X --format json --dangerously-skip-permissions --pure --dir {repo_root} [--variant Y]`. **This grants full OS-level workspace write access.** There is no `--sandbox workspace-write` flag in the live command, and `sandboxMode='read-only'` is NOT currently honored/enforced by opencode (no opencode equivalent exists). The only real containment is (a) the prompt-level \"ALLOWED WRITE PATHS\" / \"BANNED OPERATIONS\" contract rendered into the iteration prompt (`assets/prompt-pack-iteration.md.tmpl`), which relies on the model obeying instructions rather than an OS-level sandbox, and (b) post-dispatch validation (`validateIterationOutputs`) catching some violations after the fact. Because review targets are arbitrary code/spec files, they MUST be treated as potentially adversarial content (untrusted) for prompt-injection purposes — the same containment posture as untrusted fetched content in deep-research.\n282: - `cli-claude-code`: `claude -p \"$(cat prompt)\" --model X --permission-mode acceptEdits --output-format text` with optional `--effort Y`. Default permission-mode is `plan` (read-only). We override to `acceptEdits` so iteration writes succeed. The inline workflow branches are not the complete schema: `cli-codex` is also an inline branch, while `cli-cursor`, `cli-devin`, `cli-pi` and `cli-deepseek-harness` (experimental) use the shared fan-out adapters; the executor-kind authority is `runtime/lib/deep-loop/executor-config.ts` (`EXECUTOR_KINDS`).\n283: \n284: All branches share:\n285: 1. Pre-dispatch prompt rendering via `renderPromptPack` (writes to `{artifact_dir}/prompts/iteration-{n}.md`).\n286: 2. Post-dispatch validation via `validateIterationOutputs` (asserts iteration file + JSONL delta + required fields).\n287: 3. Executor audit append via `appendExecutorAuditToLastRecord` (skipped when kind=='native').\n288: \n289: Per-kind flag-compatibility is enforced at config parse time by `EXECUTOR_KIND_FLAG_SUPPORT` in `executor-config.ts`. Setting a flag that the chosen kind does not support throws `ExecutorConfigError` before dispatch.\n290: \n291: Cross-CLI delegation (a running executor invoking other CLIs via its shell) is documented design intent. Runtime recursion detection is out of scope. See the SKILL.md Cross-CLI Delegation subsection.\n292: \n293: Two containment rules bind every CLI lineage (any `cli-*` executor kind):\n294: \n295: - **The lineage is the executor, so it works in-process.** A CLI lineage performs each iteration itself, with its own tools, inside the session the driver already started. The YAML's per-iteration executor dispatch steps are satisfied by the lineage. Spawning a second CLI process for the same iteration is a route violation, not an optimization, and on codex it also fails outright (see `cli-external-orchestration/cli-codex/SKILL.md` Rule 18).\n296: - **Write containment attributes every new dirty path outside the lineage directory to the lineage, and reports it rather than undoing it.**\n297:   - Attribution on a shared checkout is a guess: a tracked file changed anywhere in the same checkout during a lineage window looks identical whether the lineage, an operator, or another session wrote it.\n298:   - So the default remedy is preserve. The file is left byte-for-byte as it stands, the finding is recorded on the status ledger and the observability stream, and a lane that produced its review artifacts — its iteration records, and `review-report.md` where it reached synthesis — still settles as complete, carrying `completed_with_containment_advisory`.\n299:   - Restoring is opt-in and safe only on a checkout with a single writer; under it a path that was already dirty when the lineage started is put back to its pre-dispatch bytes, never to HEAD, and a path whose baseline could not be captured is preserved regardless. Untracked files are never deleted in either mode.\n300:   - A path that was already dirty when the lineage started and changed again during it is the one exception to attribution: it has a second writer on record, so under the default remedy it is reported as contested, as a `containment_contested` ledger event and a `containmentContested` field on the lineage output, with a note that the tree shows the bytes changed, not who wrote them. A single-lineage run reports the same path the same way, as a `containment_contested` event in its state log, and the dispatch step prints the paths and the note beside any violations. No quarantine copy, patch or revert is made for it, and its pre-dispatch bytes stay in the baseline capture.\n301:   - A path the lane itself quarantined on an earlier pass stays the lane's, restore keeps the single-owner reading, and a path that was clean at the baseline is still attributed.\n302:   - One exemption still applies to attribution: another run's lineage directory under the same top-level packet is treated as that run's own write surface while its loop lock is live, so two lineages can run in sibling phases of one packet at the same time; a directory with no lock, or a stale one, is still attributed here.\n303:   - The runtime records each finding's diff under the lineage directory at `containment/quarantine/<iteration>[-attempt-<n>]/`, in a `containment-out-of-scope/` subdirectory on the default preserve path and `containment-reverted/` only under restore, where bytes really were rolled back; each pass keeps its own directory so a retry never overwrites an earlier pass's evidence. The pre-dispatch baseline bytes go to `<lineage dir>/containment/baseline/`, so an out-of-scope change stays recoverable either way.\n304: \n305: Failure handling is unchanged: `schema_mismatch` → conflict event → 3 consecutive failures → `stuck_recovery`.\n306: \n307: **Agent constraints**:\n308: - `@deep-review` is LEAF-only: it cannot dispatch sub-agents\n309: - No WebFetch: review is code-only and read-only\n310: - Target 8-11 tool calls per iteration (max 12). Breadth over depth per cycle\n311: \n312: #### Step 3a: Cross-Reference Protocol Execution\n313: \n314: During iterations focused on the Traceability dimension, the agent executes applicable cross-reference protocols. Each protocol produces a structured result appended to the JSONL `traceabilityChecks.results[]` array.\n315: \n316: | Protocol | Execution | Expected Output |\n317: |----------|-----------|-----------------|\n318: | `spec_code` | Compare normative claims in spec.md against shipped implementation | Pass/partial/fail per claim with file:line evidence |\n319: | `checklist_evidence` | Verify every `[x]` mark in checklist.md has supporting evidence | Pass/partial/fail per checked item |\n320: | `skill_agent` | Compare SKILL.md contracts against runtime agent definitions | Agreement/drift/disagreement per capability |\n321: | `agent_cross_runtime` | Compare agent definitions across runtimes (.opencode, .claude, .opencode) | Parity/drift/divergence per runtime pair |\n322: | `feature_catalog_code` | Compare catalog claims against discoverable implementation | Match/stale/missing per feature |\n323: | `playbook_capability` | Validate playbook scenarios against executable reality | Executable/needs-update/impossible per scenario |\n324: \n325: Each protocol result includes:\n326: - `protocolId`: Protocol identifier\n327: - `status`: `pass`, `partial`, or `fail`\n328: - `gateClass`: `hard` or `advisory`\n329: - `applicable`: Whether the protocol applies to this target type\n330: - `counts`: `{ pass, partial, fail, skipped }`\n331: - `evidence`: Array of file:line citations\n332: - `findingRefs`: Array of finding IDs generated from this protocol\n333: - `summary`: Human-readable summary text\n334: \n335: #### Step 3b: Resource Map Coverage Audit\n336: \n337: When `config.resource_map_present == true`, at least one loop iteration MUST audit implementation-vs-resource-map coverage:\n338: \n339: 1. Read `{spec_folder}/resource-map.md`\n340: 2. Read applied reports under `{spec_folder}/applied/T-*.md`\n341: 3. Cross-check `target_files` from the applied reports against resource-map entries\n342: 4. Classify outcomes into:\n343:    - entries touched\n344:    - entries not touched (`expected-by-scope` vs `gap`)\n345:    - implementation paths absent from the map\n346: 5. Emit any resulting findings with category `resource-map-coverage`\n347: \n348: When `config.resource_map_present == false`, skip this audit and rely on the `Known Context` note: `resource-map.md not present. Skipping coverage gate`.\n349: \n350: #### Step 4: Evaluate Results\n351: \n352: After agent completes:\n353: \n354: 1. Verify `{artifact_dir}/iterations/iteration-{NNN}.md` was created\n355: 2. Verify JSONL was appended with review iteration fields:\n356:    - `dimensions` (array of dimensions covered)\n357:    - `filesReviewed` (array of file paths)\n358:    - `findingsSummary` (cumulative P0/P1/P2 counts)\n359:    - `findingsNew` (this iteration's new findings)\n360:    - `traceabilityChecks` (protocol results if applicable)\n361: 3. Verify strategy.md was updated (dimension progress, findings count, protocol status)\n362: 4. Extract `newFindingsRatio` from JSONL record\n363: 5. Update stuck tracking using `noProgressThreshold = 0.05`:\n364:    - Skip if `status == \"thought\"` (no change)\n365:    - Reset to 0 if `status == \"insight\"` (breakthrough counts as progress)\n366:    - Increment if `newFindingsRatio < noProgressThreshold`\n367:    - Reset otherwise\n368: \n369: #### Step 4a: Claim Adjudication\n370: \n371: Before the next convergence pass, the orchestrator adjudicates every new P0/P1 finding with a **typed claim-adjudication packet**. This step prevents false positives from inflating severity and distorting convergence, AND acts as a hard STOP gate: `step_post_iteration_claim_adjudication` appends a `claim_adjudication` event to `deep-review-state.jsonl`, and the next iteration's `step_check_convergence` legal-stop decision tree consults that event via `claimAdjudicationGate` (gate `f`). A missing or failing packet vetoes STOP even when every other gate passes.\n372: \n373: Each new P0/P1 must carry a typed packet with the following required fields (see `../state/state-format.md` §9 for the full schema and a worked example):\n374: \n375: | Field | Type | Description |\n376: |-------|------|-------------|\n377: | `findingId` | string | Matches the finding ID in the iteration body |\n378: | `claim` | string | The single assertion the finding makes |\n379: | `evidenceRefs` | string[] | `file:line` or `file:range` citations (≥ 1) |\n380: | `counterevidenceSought` | string | Where the orchestrator looked for contradicting evidence |\n381: | `alternativeExplanation` | string | An alternative explanation, even if rejected |\n382: | `finalSeverity` | `\"P0\"` \\| `\"P1\"` \\| `\"P2\"` | Severity after adjudication |\n383: | `confidence` | number `[0, 1]` | Orchestrator confidence in `finalSeverity` |\n384: | `downgradeTrigger` | string | Concrete condition that would cause a future downgrade |\n385: | `transitions` | object[] | Optional, required when `finalSeverity` differs from the originally asserted severity |\n386: \n387: **Protocol**:\n388: \n389: 1. Re-read the cited evidence at the referenced file:line locations.\n390: 2. Seek counterevidence in adjacent code, docs, or prior iteration history.\n391: 3. Record an alternative explanation even if it is rejected.\n392: 4. Confirm or downgrade severity before the finding becomes convergence-visible.\n393: 5. Emit the typed packet inside the iteration file so `step_post_iteration_claim_adjudication` can parse it.\n394: \n395: **Failure semantics**: when any new P0/P1 finding is missing a packet or a required field, the workflow records `{\"event\":\"claim_adjudication\",\"passed\":false,\"missingPackets\":[...]}` in `deep-review-state.jsonl`. On the next loop, `step_check_convergence` step 0 (universal pre-check) routes STOP to `BLOCKED` with `blockedBy: [\"claimAdjudicationGate\"]` until a follow-up iteration rewrites the packet. Downgraded findings have their `finalSeverity` updated. The original severity is preserved in the iteration file for audit trail.\n396: \n397: #### Step 4b: Generate Dashboard\n398: \n399: Generate `{artifact_dir}/deep-review-dashboard.md` with review-specific sections:\n400: \n401: | Section | Content |\n402: |---------|---------|\n403: | Status | Provisional verdict (`PASS`/`CONDITIONAL`/`FAIL`/`PENDING`) and `hasAdvisories` flag |\n404: | Findings Summary | P0/P1/P2 counts with deltas from previous iteration |\n405: | Progress Table | Iteration number, focus dimension, `newFindingsRatio`, findings count, status |\n406: | Coverage | Files reviewed, dimensions completed, traceability protocol status |\n407: | Trend | Last 3 `newFindingsRatio` values with direction indicator (ascending/descending/flat) |\n408: | Active Risks | Guard violations, stuck count, budget warnings |\n409: \n410: Dashboard behavior:\n411: - Auto-generated only -- never manually edited\n412: - Overwritten each iteration (not appended)\n413: - Non-blocking: if generation fails, log a warning and continue the loop\n414: - In **confirm mode**: displayed to the user at each iteration approval gate\n415: - In **auto mode**: written silently for post-hoc review\n416: \n417: #### Step 5: Loop Decision\n418: \n419: - If convergence check returns STOP: exit to synthesis\n420: - If STUCK_RECOVERY: apply review-specific recovery strategies (see Section 3a), reset stuck count, continue\n421: - Otherwise: increment iteration counter, go to Step 1\n422: \n423: ### Stuck Recovery (Review-Specific)\n424: \n425: **Threshold:** 2 consecutive no-progress iterations (`noProgressThreshold = 0.05`).\n426: \n427: | Failure Mode | Detection | Recovery Strategy |\n428: |-------------|-----------|-------------------|\n429: | Same dimension stuck | Last 2 iterations reviewed the same dimension with ratios `< 0.05` | **Change granularity**: if reviewing at file level, zoom into functions, if reviewing functions, zoom out to module level |\n430: | Traceability plateau | Required protocols remain partial while ratios stay `< 0.05` | **Protocol-first replay**: re-run the unresolved traceability protocol directly against the conflicting artifacts |\n431: | Low-value advisory churn | Last 2 iterations found only P2 work | **Escalate severity review**: explicitly search for P0/P1 patterns or downgrade unsupported severity claims |\n432: \n433: **Selection logic**:\n434: \n435: ```\n436: function selectReviewRecoveryStrategy(stuckIterations, state, config):\n437:   lastFocuses = [i.focus for i in stuckIterations[-2:]]\n438: \n439:   // Same dimension stuck? Change granularity\n440:   if len(set(lastFocuses)) <= 1:\n441:     return { strategy: \"change_granularity\", dimension: lastFocuses[0] }\n442: \n443:   // Required protocol plateau?\n444:   if hasRequiredProtocolPlateau(state.traceabilityChecks):\n445:     return { strategy: \"protocol_first_replay\" }\n446: \n447:   // Default: escalate severity\n448:   return { strategy: \"escalate_severity_review\" }\n449: ```\n450: \n451: **Recovery evaluation**:\n452: - If recovery iteration finds any new P0/P1 or materially advances required traceability coverage: recovery successful. Reset stuck count. Continue.\n453: - If recovery iteration finds only P2 or nothing: recovery failed. If all dimensions are already covered, exit to synthesis. Otherwise, move to the next unreviewed dimension.\n454: \n455: ---\n456: \n457: ## 4. PHASE 3: SYNTHESIS\n458: \n459: ### Purpose\n460: \n461: Compile all iteration findings into the final `{artifact_dir}/review-report.md`. The synthesis phase owns the canonical review report output.\n462: \n463: ### Steps\n464: \n465: #### Step 1: Finding Registry Deduplication\n466: \n467: Consolidate findings across all iterations:\n468: \n469: 1. Read all iteration files: `{artifact_dir}/iterations/iteration-*.md`\n470: 2. Group findings by file + line range + root cause\n471: 3. Merge duplicates, keeping the highest severity and all evidence\n472: 4. Assign final finding IDs: `F001`, `F002`, ...\n473: 5. Preserve the audit trail: note which iterations contributed to each merged finding\n474: \n475: #### Step 2: Severity Reconciliation\n476: \n477: Use adjudicated `finalSeverity` for any P0/P1 that was downgraded during claim adjudication (Step 4a of the iteration loop). The original severity from the iteration file is preserved in the audit appendix.\n478: \n479: #### Step 3: Replay Validation\n480: \n481: Recompute the convergence outcome from JSONL state before finalizing the report:\n482: \n483: 1. Read `deep-review-state.jsonl` and select review-mode iteration records in run order\n484: 2. Recompute `newFindingsRatio`, rolling-average votes, MAD votes, and coverage votes from stored JSONL fields only\n485: 3. Recompute `traceabilityChecks.summary` and confirm required protocol statuses match the recorded coverage vote\n486: 4. Re-run the evidence, scope, and coverage gates against stored findings and scope data\n487: 5. Compare the replayed decision and stop reason to the recorded synthesis event\n488: \n489: This synthesis-stage replay is a **full-history audit replay** over the stored JSONL state. It follows the same full-history replay discipline as the per-iteration reducer refresh above, but runs as an explicit pre-synthesis audit.\n490: \n491: Replay passes only when the recomputed decision, thresholds, and gate outcomes agree with the persisted result. If replay fails, log a warning in the audit appendix but proceed with synthesis.\n492: \n493: #### Step 4: Compile review-report.md\n494: \n495: Generate the 9 core review-report sections (defined in `review-mode-contract.yaml` under `outputs.reviewReport`) and insert `## Resource Map Coverage Gate` between `Traceability Status` and `Deferred Items` when `config.resource_map_present == true`:\n496: \n497: | # | Section | Purpose |\n498: |---|---------|---------|\n499: | 1 | Executive Summary | Verdict, active P0/P1/P2 counts, scope, `hasAdvisories` metadata |\n500: | 2 | Planning Trigger | Why the verdict routes to planning or changelog follow-up |\n501: | 3 | Active Finding Registry | Deduplicated active findings with evidence and final severity |\n502: | 4 | Remediation Workstreams | Grouped action lanes derived from active findings |\n503: | 5 | Spec Seed | Minimal spec delta derived from review results |\n504: | 6 | Plan Seed | Action-ready plan starter for remediation |\n505: | 7 | Traceability Status | Core vs overlay protocol status and unresolved gaps |\n506: | 8 | Resource Map Coverage Gate | Present only when `config.resource_map_present == true`, reports touched entries, untouched entries (`expected-by-scope` vs `gap`), and implementation paths absent from the map |\n507: | 9 | Deferred Items | P2 advisories, blocked checks, and follow-up items |\n508: | 10 | Audit Appendix | Coverage, replay validation, convergence evidence |\n509: \n510: #### Step 5: Verdict Determination\n511: \n512: Apply the verdict contract from `review-mode-contract.yaml`:\n513: \n514: | Verdict | Condition | Next Command |\n515: |---------|-----------|--------------|\n516: | **FAIL** | Active P0 remains OR any required binary gate fails | `/speckit:plan` for remediation |\n517: | **CONDITIONAL** | No active P0, but active P1 remains | `/speckit:plan` for fixes |\n518: | **PASS** | No active P0/P1 | `/create:changelog` |\n519: \n520: When `PASS` verdict is issued and active P2 findings remain, set `hasAdvisories = true` in the report metadata.\n521: \n522: #### Step 6: Finalize State\n523: \n524: 1. Update config status: Set `status: \"complete\"` in `deep-review-config.json`\n525: 2. Write final JSONL entry:\n526:    ```json\n527:    {\n528:      \"type\": \"event\",\n529:      \"event\": \"synthesis_complete\",\n530:      \"mode\": \"review\",\n531:      \"totalIterations\": N,\n532:      \"verdict\": \"PASS|CONDITIONAL|FAIL\",\n533:      \"activeP0\": N,\n534:      \"activeP1\": N,\n535:      \"activeP2\": N,\n536:      \"dimensionCoverage\": X,\n537:      \"stopReason\": \"...\",\n538:      \"timestamp\": \"...\"\n539:    }\n540:    ```\n541: \n542: ---\n543: \n544: ## 5. PHASE 4: SAVE\n545: \n546: ### Purpose\n547: \n548: Preserve review context to the memory system for future session recovery and cross-session continuity.\n549: \n550: ### Steps\n551: \n552: 1. **Compose context payload**: Create a structured JSON payload with the review summary, active findings, verdict, next action, and relevant artifacts. Use `specFolder` for the target packet and include curated `observations`, `recent_context`, `toolCalls`, and `exchanges` when available.\n553: \n554: 2. **Generate context**: Run the memory save script with structured JSON via `--stdin`, `--json`, or a session-scoped JSON file:\n555:    ```bash\n556:    node .skilled/skills/system-spec-kit/runtime/cli/dist/continuity/generate-context.js --json '{\"specFolder\":\"{spec_folder}\",\"sessionSummary\":\"Deep review completed; see review/review-report.md for verdict and findings.\"}' {spec_folder}\n557:    ```\n558: \n559: 3. **No extra indexing step in the live contract**: `generate-context.js` is the supported save boundary for this workflow.\n560: \n561: 4. **Verify**: Confirm the routed canonical spec document carries the review continuity update. Expected targets are `implementation-summary.md`, `decision-record.md`, or `handover.md`; standalone `memory/*.md` files are retired and should not be created.\n562: \n563: ### On Save Failure\n564: \n565: If memory save fails:\n566: - Preserve the current `review/` packet as backup (the disk state is the ground truth)\n567: - Log the error\n568: - The review results remain intact in `{artifact_dir}/review-report.md` regardless of memory save status\n569: \n570: ---\n571: \n572: ## 6. AUTO-RESUME PROTOCOL\n573: \n574: ### Purpose\n575: \n576: Enable review sessions to resume cleanly from prior state when interrupted by context compaction, process termination, or intentional pause.\n577: \n578: ### Resume Detection\n579: \n580: If state files already exist from a prior session:\n581: \n582: 1. **Verify agreement**: Confirm config, JSONL, findings registry, and strategy all exist and agree on target/spec folder\n583: 2. **Count progress**: Read JSONL, count iteration records, determine last completed iteration\n584: 3. **Read strategy**: Load current dimension progress, findings, and next focus from `deep-review-strategy.md`\n585: 4. **Set counter**: Set iteration counter to last completed + 1\n586: 5. **Log resume**: Append the canonical resume event to `deep-review-state.jsonl`. The reducer requires every field below:\n587:    ```json\n588:    {\"type\":\"event\",\"event\":\"resumed\",\"mode\":\"review\",\"sessionId\":\"rvw-2026-03-24T10-00-00Z\",\"parentSessionId\":\"rvw-2026-03-24T10-00-00Z\",\"lineageMode\":\"resume\",\"continuedFromRun\":4,\"generation\":1,\"archivedPath\":null,\"timestamp\":\"2026-03-24T14:05:00Z\"}\n589:    ```\n590: 6. **Continue**: Enter the iteration loop from step_read_state\n591: \n592: ### Lifecycle Branches (current release)\n593: \n594: The runtime supports three lineage modes today. `fork` and `completed-continue` were described in earlier drafts but have no workflow wiring in this release, so they MUST NOT be exposed to operators. If the long-form lineage feature is picked up later it will arrive with first-class event emission, reducer ancestry handling, and replay fixtures. Until then treat the contract below as canonical.\n595: \n596: | Mode | Session id | Generation | Archive | JSONL event | When to pick |\n597: |------|-----------|-----------|---------|-------------|--------------|\n598: | `new` | fresh | 1 | n/a | implicit (config record) | no existing state |\n599: | `resume` | same | same | none | `resumed` (see example above) | operator wants to continue the current lineage boundary |\n600: | `restart` | fresh | `prior + 1` | prior `review/` tree moved under `review-archive/{timestamp}/` | `restarted` (same field set plus non-null `archivedPath`) | operator wants to clear the workspace and replay with a new angle |\n601: \n602: **Contract for every persisted lifecycle event**:\n603: \n604: ```json\n605: {\n606:   \"type\": \"event\",\n607:   \"event\": \"resumed | restarted\",\n608:   \"mode\": \"review\",\n609:   \"sessionId\": \"<session id of the new or continuing lineage>\",\n610:   \"parentSessionId\": \"<session id of the prior lineage (equals sessionId on resume)>\",\n611:   \"lineageMode\": \"resume | restart\",\n612:   \"generation\": <number>,\n613:   \"continuedFromRun\": <number or null>,\n614:   \"archivedPath\": \"<path or null>\",\n615:   \"timestamp\": \"<ISO 8601>\"\n616: }\n617: ```\n618: \n619: Every field in the contract MUST be present on every persisted lifecycle event. `archivedPath` is null for `resumed` and set to the archive destination for `restarted`. `continuedFromRun` is the number of completed iteration records before the lifecycle boundary. Reducer parity tests ensure the dashboard `Lifecycle` section reads exactly those fields.\n620: \n621: ### State Validation on Resume\n622: \n623: | Condition | Classification | Action |\n624: |-----------|---------------|--------|\n625: | Config + JSONL + strategy all exist and agree | `resume` | Continue from last iteration + 1 |\n626: | All exist, config says `status: \"complete\"` | `completed-session` | Report completion, ask user if re-review desired |\n627: | Partial files or contradictions | `invalid-state` | Halt for repair, do not guess |\n628: | No files exist | `fresh` | Start new initialization |\n629: \n630: ### State Recovery Cascade\n631: \n632: When state files are missing or corrupted, apply this priority cascade:\n633: \n634: | Priority | Condition | Recovery Action |\n635: |----------|-----------|----------------|\n636: | 1 | JSONL exists and parseable | Normal operation |\n637: | 2 | JSONL exists, strategy.md missing | Reconstruct strategy from JSONL: extract dimensions, findings, coverage |\n638: | 3 | JSONL missing, iteration files exist | Scan `review/iterations/iteration-*.md`, reconstruct JSONL with `status: \"reconstructed\"` |\n639: | 4 | Only config.json remains | Restart from initialization phase |\n640: | 5 | Config.json also missing | Cannot recover. Report error and halt. |\n641: \n642: Each priority level is attempted in order. If a level fails, fall through to the next.\n643: \n644: ---\n645: \n646: ## 7. PAUSE/RESUME\n647: \n648: ### Pause Sentinel Behavior\n649: \n650: The pause sentinel provides graceful loop suspension in autonomous mode without killing the process.\n651: \n652: ### Creating a Pause\n653: \n654: Create the sentinel file at any time:\n655: \n656: ```bash\n657: touch {artifact_dir}/.deep-review-pause\n658: ```\n659: \n660: The orchestrator checks for this file between iterations (Step 2a). When detected:\n661: - The current iteration is allowed to complete\n662: - The loop halts before dispatching the next iteration\n663: - A paused event is logged to JSONL\n664: - The user is notified with current state (iteration count, dimensions covered, findings)\n665: \n666: ### Resuming After Pause\n667: \n668: Delete the sentinel file and restart the workflow:\n669: \n670: ```bash\n671: rm {artifact_dir}/.deep-review-pause\n672: ```\n673: \n674: On the next invocation:\n675: - The auto-resume protocol (Section 6) detects the existing state\n676: - A resumed event is logged to JSONL\n677: - The loop continues from the next iteration\n678: \n679: ### Confirm Mode Approval Gates\n680: \n681: In confirm mode (`deep-review-confirm.yaml`), the workflow adds explicit approval gates instead of relying on the pause sentinel:\n682: \n683: | Gate Location | Behavior |\n684: |---------------|----------|\n685: | After initialization | Show config, strategy, and scope. Wait for approval |\n686: | After each iteration | Show iteration findings, dashboard, and convergence status. Options: Continue, Adjust Focus, Stop |\n687: | Before synthesis | Show summary of all iterations. Wait for approval to synthesize |\n688: | After synthesis | Show final review-report.md summary. Approve or request revisions |\n689: \n690: ---\n691: \n692: ## 8. STATE TRANSITIONS, ERROR HANDLING, AND QUALITY GATES\n693: \n694: State-transition rules, error handling, and the review quality gates live in `loop-state-and-gates.md` for navigability.\n695: \n696: ---\n697: \n698: ## 9. EXECUTOR SELECTION CONTRACT\n699: \n700: Executor settings are owned by the YAML workflow and rendered prompt pack. Do not bypass the workflow by hand-dispatching review iterations; each iteration stays LEAF-only and produces the required markdown plus JSONL delta.\n701: \n702: ### Invariants\n703: \n704: Every executor path MUST satisfy:\n705: \n706: 1. Produce an iteration markdown file at `{state_paths.iteration_pattern}` (non-empty).\n707: 2. Append a JSONL delta record to `{state_paths.state_log}` with required fields: `type`, `iteration`, `dimensions`, `filesReviewed`, `findingsSummary`, `findingsNew`, `findingDetails`, `newFindingsRatio`.\n708: 3. Respect the LEAF-agent constraint: no sub-dispatch, no nested loops. Max 12 tool calls per iteration.\n709: \n710: ### Failure Modes\n711: \n712: - Missing iteration file: `iteration_file_missing` from `post-dispatch-validate.ts`, emits a `schema_mismatch` conflict event.\n713: - Empty iteration file: `iteration_file_empty`, same downstream.\n714: - JSONL not appended: `jsonl_not_appended`.\n715: - JSONL missing required fields: `jsonl_missing_fields`.\n716: - JSONL malformed: `jsonl_parse_error`.\n717: - 3 consecutive failures: existing `stuck_recovery` event (unchanged).\n718: \n719: ### JSONL Audit Field\n720: \n721: Non-native executor runs append an `executor` block with model and runtime settings to the iteration's JSONL record via `executor-audit.ts`. Native runs are recoverable from YAML alone.\n722: \n723: ### Template And Config Surface\n724: \n725: The executor-agnostic iteration prompt lives at `assets/prompt-pack-iteration.md.tmpl`, rendered by `prompt-pack.ts` before dispatch and either injected as the agent's context (native) or piped to `opencode run` stdin (cli-opencode). Config is in `assets/deep-review-config.json` under the `executor` key; schema in `runtime//lib/deep-loop/executor-config.ts`. CLI flag precedence: `--executor/--model/--reasoning-effort/--service-tier/--executor-timeout > config file > schema default`.\n726: \n727: ### What Never Changes Regardless Of Executor Route\n728: \n729: - YAML owns state (`deep-review-state.jsonl`, strategy.md, registry, dashboard).\n730: - `reduce-state.cjs` is the single state writer.\n731: - Convergence detection, lifecycle events (new/resume/restart), the review dimensions pass, and stuck_recovery stay YAML-driven.\n732: - The `@deep-review` LEAF agent definition is untouched: it is the native executor, not the only one.\n733: \n734: ### Code-Graph Readiness TrustState Surface\n735: \n736: On this skill surface, the live code-graph readiness contract only reaches four TrustState values: `live`, `stale`, `absent`, and `unavailable`. The values `cached`, `imported`, `rebuilt`, and `rehomed` remain declared in the shared TrustState type for compatibility and downstream schema stability, but the seven code-graph handlers and readiness helpers used here do not emit them today.\n737: \n738: ---\n739: \n740: ## 10. RELATED RESOURCES\n741: \n742: ### Shared Protocol Documentation\n743: \n744: Protocol documents from `deep-research` are cross-referenced, not duplicated:\n745: \n746: | Document | Path | Purpose |\n747: |----------|------|---------|\n748: | Loop Protocol (research) | `../deep-research/references/protocol/loop-protocol.md` | Research loop lifecycle (this file adapts Section 9) |\n749: | State Format | `../deep-research/references/state/state-format.md` | JSONL, strategy, and config schemas |\n750: | Convergence | `../deep-research/references/convergence/convergence.md` | `shouldContinue_review()` (Section 10), stuck recovery, quality guards |\n751: \n752: ### Review-Specific Resources\n753: \n754: | Resource | Path | Purpose |\n755: |----------|------|---------|\n756: | Review Contract | `assets/review-mode-contract.yaml` | Single source of truth for dimensions, verdicts, gates, protocols |\n757: | Quick Reference | `references/protocol/quick-reference.md` | One-page review cheat sheet |\n758: | Strategy Template | `assets/deep-review-strategy.md` | Template for review strategy files |\n759: | Config Template | `assets/deep-review-config.json` | Template for review config files |\n760: | Dashboard Template | `assets/deep-review-dashboard.md` | Template for auto-generated dashboard |\n761: \n762: ### Workflow Files\n763: \n764: | Mode | Path |\n765: |------|------|\n766: | Auto (unattended) | `.skilled/commands/deep/assets/deep-review-auto.yaml` |\n767: | Confirm (step-by-step) | `.skilled/commands/deep/assets/deep-review-confirm.yaml` |\n768: \n769: ### Agent\n770: \n771: | Agent | Path Pattern | Constraint |\n772: |-------|-------------|------------|\n773: | `@deep-review` | `{runtime_dir}/deep-review.{ext}` | LEAF-only, no sub-agents, no WebFetch, target files read-only |\n774: \n775: Runtime paths:\n776: - OpenCode / Copilot: `.opencode/agents/deep-review.md`\n777: - Claude: `.claude/agents/deep-review.md`"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\".skilled/skills/system-deep-loop/deep-review/references/protocol/loop-protocol.md\"}"},"time":{"start":1794669322718,"end":1794669323027}}}}
