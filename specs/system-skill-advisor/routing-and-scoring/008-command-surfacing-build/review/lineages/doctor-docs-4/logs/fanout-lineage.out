235:     });\n236:   }\n237: \n238:   const localEdits = context.currency.filter((entry) => entry.state === 'edited' || entry.state === 'unknown-base');\n239:   const behind = context.currency.filter((entry) => entry.state === 'stale-known');\n240:   // A local edit outranks a missed release in the reading order: it is the shape that\n241:   // loses text if somebody replaces the document, and staleness only loses a patch.\n242:   if (localEdits.length > 0 || context.unregistered.length > 0) {\n243:     const lines = [];\n244:     for (const entry of localEdits) lines.push(`${entry.id}: ${entry.state}`);\n245:     for (const entry of context.unregistered) {\n246:       lines.push(entry.heading === null\n247:         ? 'unmarked text before the first heading'\n248:         : `unmarked section ${JSON.stringify(entry.heading)}`);\n249:     }\n[Output truncated. Continue reading with offset: 250]","title":"read","metadata":{"metadata":{"truncated":true},"content":[{"type":"text","text":"Read file .skilled/commands/doctor/scripts/agents-md-check.cjs, lines 205-249\n205:   };\n206: }\n207: \n208: // ─────────────────────────────────────────────────────────────────────────────\n209: // 5. THE TWELVE ROWS\n210: // ─────────────────────────────────────────────────────────────────────────────\n211: \n212: function row(id, name, state, detail, extra = {}) {\n213:   return { id, name, state, detail, lines: extra.lines || [], entries: extra.entries || [] };\n214: }\n215: \n216: // A1. The one row an operator reads first: which of the seven shapes this repository is.\n217: function rowInstallState(context, manifest) {\n218:   const claudePath = path.join(context.root, 'CLAUDE.md');\n219:   if (!context.exists) {\n220:     if (fs.existsSync(claudePath)) {\n221:       return row('A1', 'install state', FINDING, 'claude-only',\n222:         { lines: [`no ${manifest.root_file}; CLAUDE.md is the only instruction file`] });\n223:     }\n224:     return row('A1', 'install state', FINDING