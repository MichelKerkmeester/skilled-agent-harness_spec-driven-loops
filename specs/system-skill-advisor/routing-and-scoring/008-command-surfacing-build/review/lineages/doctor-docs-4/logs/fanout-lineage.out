outesPath, 'utf8'));\n[Output truncated. Continue reading with offset: 540]","title":"read","metadata":{"metadata":{"truncated":true},"content":[{"type":"text","text":"Read file .skilled/skills/system-skill-advisor/runtime/scripts/command-bridges/derive-command-bridges.cjs, lines 470-539\n470:     }\n471:   }\n472:   if (record.write_scope !== undefined && !WRITE_SCOPES.includes(record.write_scope)) {\n473:     throw new Error(\n474:       `[command-bridges] ${label} has write_scope ${JSON.stringify(record.write_scope)}; `\n475:         + `expected one of ${WRITE_SCOPES.join(', ')}`,\n476:     );\n477:   }\n478:   if (requireTarget && (typeof record.gate3_location !== 'string' || !record.gate3_location)) {\n479:     throw new Error(\n480:       `[command-bridges] ${label} needs a non-empty string gate3_location naming what it writes`,\n481:     );\n482:   }\n483: }\n484: \n485: // One policy per command, decided from the risk keys alone so the answer never\n486: // depends on which scorer asks: an ask-first reason always wins, a doctor route\n487: // that mutates asks because its repair is the operator's call, and only a\n488: // read-only route or an add-only route confined to the spec folder may run\n489: // unprompted. Everything else starts as an ordinary task.\n490: function derivePolicy(record) {\n491:   if (Array.isArray(record.ask_first) && record.ask_first.length > 0) return 'ask';\n492:   if (record.doctor === true && record.mutating === 'mutates') return 'ask';\n493:   if (record.mutating === 'read-only') return 'run';\n494:   if (record.mutating === 'add-only' && record.write_scope === 'spec-folder') return 'run';\n495:   return 'start';\n496: }\n497: \n498: // The same skill folders as the bridge metadata, for the same reason: a private\n499: // skill is local to a checkout and a linked folder is not a skill source. A\n500: // metadata command is reachable by typing its name, so it must also name where\n501: // its writes land before its policy may be d