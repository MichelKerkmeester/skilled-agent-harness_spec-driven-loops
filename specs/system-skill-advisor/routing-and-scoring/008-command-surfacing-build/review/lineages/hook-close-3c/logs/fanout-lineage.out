{"type":"tool_use","timestamp":1794596854651,"sessionID":"ses_e29b1d95affeG1NNpWx5iqRIiD","part":{"partID":"prt_1d64ed967001ArhllmVd6UCzTe","sessionID":"ses_e29b1d95affeG1NNpWx5iqRIiD","messageID":"msg_1d64ec6dc001fU5MryGYa6sBwb","type":"tool","id":"call_ae8843f486b04b94a544c6a9","tool":"read","state":{"status":"completed","input":{"path":".skilled/commands/doctor/scripts/tests/hook-wiring-check.test.cjs"},"output":"Read file .skilled/commands/doctor/scripts/tests/hook-wiring-check.test.cjs, lines 1-267\n1: #!/usr/bin/env node\n2: // ───────────────────────────────────────────────────────────────────\n3: // MODULE: Hook Wiring Check Tests\n4: // ───────────────────────────────────────────────────────────────────\n5: 'use strict';\n6: \n7: // Drives the hook wiring check as a process against throwaway checkouts. The\n8: // cases pin both verdicts and the checkout that has no runtime folder at all.\n9: \n10: // ─────────────────────────────────────────────────────────────────────────────\n11: // 1. IMPORTS AND FIXTURES\n12: // ─────────────────────────────────────────────────────────────────────────────\n13: \n14: const assert = require('node:assert/strict');\n15: const { spawnSync } = require('node:child_process');\n16: const fs = require('node:fs');\n17: const os = require('node:os');\n18: const path = require('node:path');\n19: const test = require('node:test');\n20: \n21: const SCRIPT = path.resolve(__dirname, '..', 'hook-wiring-check.cjs');\n22: const CLAUDE_FILE = '.claude/settings.json';\n23: const CLAUDE_MARKER = '.skilled/skills/system-spec-kit/runtime/dist/hooks/claude/user-prompt-submit.js';\n24: \n25: function fixture(t) {\n26:   const root = fs.mkdtempSync(path.join(os.tmpdir(), 'hook-wiring-check-'));\n27:   t.after(() => fs.rmSync(root, { recursive: true, force: true }));\n28:   const run = (...args) => {\n29:     const result = spawnSync(process.execPath, [SCRIPT, '--root', root, ...args], { encoding: 'utf8' });\n30:     return { code: result.status, out: result.stdout, err: result.stderr };\n31:   };\n32:   return { root, run };\n33: }\n34: \n35: function writeClaudeSettings(root, hooks) {\n36:   fs.mkdirSync(path.join(root, '.claude'), { recursive: true });\n37:   fs.writeFileSync(path.join(root, CLAUDE_FILE), JSON.stringify({ hooks }, null, 2));\n38: }\n39: \n40: // ─────────────────────────────────────────────────────────────────────────────\n41: // 2. TESTS\n42: // ─────────────────────────────────────────────────────────────────────────────\n43: \n44: test('names a runtime whose prompt entry is absent', (t) => {\n45:   const f = fixture(t);\n46:   writeClaudeSettings(f.root, {\n47:     UserPromptSubmit: [{ hooks: [{ type: 'command', command: 'node some-other-hook.js' }] }],\n48:   });\n49:   const before = fs.readFileSync(path.join(f.root, CLAUDE_FILE), 'utf8');\n50:   const result = f.run();\n51:   assert.equal(result.code, 1);\n52:   assert.match(result.out, /^hook-missing claude \\.claude\\/settings\\.json$/m);\n53:   assert.equal(fs.readFileSync(path.join(f.root, CLAUDE_FILE), 'utf8'), before, 'check changed the hook file');\n54: });\n55: \n56: test('passes a runtime whose prompt entry is wired', (t) => {\n57:   const f = fixture(t);\n58:   writeClaudeSettings(f.root, {\n59:     UserPromptSubmit: [{\n60:       hooks: [{ type: 'command', command: `bash -c 'cd \"$PWD\" && node ${CLAUDE_MARKER}'` }],\n61:     }],\n62:   });\n63:   const text = f.run();\n64:   assert.equal(text.code, 0);\n65:   assert.equal(text.out.trim(), 'ok claude');\n66:   const json = f.run('--json');\n67:   assert.equal(json.code, 0);\n68:   assert.equal(JSON.parse(json.out).checks.find((check) => check.runtime === 'claude').status, 'ok');\n69: });\n70: \n71: test('passes a prompt entry that starts node on the script path', (t) => {\n72:   const f = fixture(t);\n73:   writeClaudeSettings(f.root, {\n74:     UserPromptSubmit: [{\n75:       hooks: [{ type: 'command', command: `node ${CLAUDE_MARKER}` }],\n76:     }],\n77:   });\n78:   const text = f.run();\n79:   assert.equal(text.code, 0);\n80:   assert.equal(text.out.trim(), 'ok claude');\n81: });\n82: \n83: test('passes a prompt entry that starts node by its absolute path', (t) => {\n84:   const f = fixture(t);\n85:   writeClaudeSettings(f.root, {\n86:     UserPromptSubmit: [{\n87:       hooks: [{ type: 'command', command: `/opt/homebrew/bin/node ${CLAUDE_MARKER}` }],\n88:     }],\n89:   });\n90:   const text = f.run();\n91:   assert.equal(text.code, 0);\n92:   assert.equal(text.out.trim(), 'ok claude');\n93: });\n94: \n95: test('names a runtime whose entry only names node as an argument', (t) => {\n96:   const f = fixture(t);\n97:   writeClaudeSettings(f.root, {\n98:     UserPromptSubmit: [{\n99:       hooks: [{ type: 'command', command: `echo node ${CLAUDE_MARKER}` }],\n100:     }],\n101:   });\n102:   const result = f.run();\n103:   assert.equal(result.code, 1);\n104:   assert.match(result.out, /^hook-missing claude \\.claude\\/settings\\.json$/m);\n105: });\n106: \n107: test('names a runtime whose entry only echoes the script path', (t) => {\n108:   const f = fixture(t);\n109:   writeClaudeSettings(f.root, {\n110:     UserPromptSubmit: [{\n111:       hooks: [{ type: 'command', command: 'echo hooks/claude/user-prompt-submit.js' }],\n112:     }],\n113:   });\n114:   const result = f.run();\n115:   assert.equal(result.code, 1);\n116:   assert.match(result.out, /^hook-missing claude \\.claude\\/settings\\.json$/m);\n117: });\n118: \n119: test('names a runtime whose entry only describes the script', (t) => {\n120:   const f = fixture(t);\n121:   writeClaudeSettings(f.root, {\n122:     UserPromptSubmit: [{\n123:       hooks: [{\n124:         type: 'command',\n125:         command: 'node some-other-hook.js',\n126:         description: 'hooks/claude/user-prompt-submit.js',\n127:       }],\n128:     }],\n129:   });\n130:   const result = f.run();\n131:   assert.equal(result.code, 1);\n132:   assert.match(result.out, /^hook-missing claude \\.claude\\/settings\\.json$/m);\n133: });\n134: \n135: test('passes a launch that starts node through env', (t) => {\n136:   const f = fixture(t);\n137:   writeClaudeSettings(f.root, {\n138:     UserPromptSubmit: [{ hooks: [{ type: 'command', command: `env node ${CLAUDE_MARKER}` }] }],\n139:   });\n140:   const text = f.run();\n141:   assert.equal(text.code, 0);\n142:   assert.equal(text.out.trim(), 'ok claude');\n143: });\n144: \n145: test('passes a launch that starts node through an absolute env', (t) => {\n146:   const f = fixture(t);\n147:   writeClaudeSettings(f.root, {\n148:     UserPromptSubmit: [{ hooks: [{ type: 'command', command: `/usr/bin/env node ${CLAUDE_MARKER}` }] }],\n149:   });\n150:   const text = f.run();\n151:   assert.equal(text.code, 0);\n152:   assert.equal(text.out.trim(), 'ok claude');\n153: });\n154: \n155: test('passes a launch that runs node inside a bash login command', (t) => {\n156:   const f = fixture(t);\n157:   writeClaudeSettings(f.root, {\n158:     UserPromptSubmit: [{ hooks: [{ type: 'command', command: `bash -lc \"node ${CLAUDE_MARKER}\"` }] }],\n159:   });\n160:   const text = f.run();\n161:   assert.equal(text.code, 0);\n162:   assert.equal(text.out.trim(), 'ok claude');\n163: });\n164: \n165: test('passes a launch that runs node inside a zsh command', (t) => {\n166:   const f = fixture(t);\n167:   writeClaudeSettings(f.root, {\n168:     UserPromptSubmit: [{ hooks: [{ type: 'command', command: `zsh -c 'node ${CLAUDE_MARKER}'` }] }],\n169:   });\n170:   const text = f.run();\n171:   assert.equal(text.code, 0);\n172:   assert.equal(text.out.trim(), 'ok claude');\n173: });\n174: \n175: test('passes a launch that gives node a flag', (t) => {\n176:   const f = fixture(t);\n177:   writeClaudeSettings(f.root, {\n178:     UserPromptSubmit: [{ hooks: [{ type: 'command', command: `node --no-warnings ${CLAUDE_MARKER}` }] }],\n179:   });\n180:   const text = f.run();\n181:   assert.equal(text.code, 0);\n182:   assert.equal(text.out.trim(), 'ok claude');\n183: });\n184: \n185: test('passes a launch whose separator sticks to the previous word', (t) => {\n186:   const f = fixture(t);\n187:   writeClaudeSettings(f.root, {\n188:     UserPromptSubmit: [{ hooks: [{ type: 'command', command: `cd \"\\$PWD\"&& node ${CLAUDE_MARKER}` }] }],\n189:   });\n190:   const text = f.run();\n191:   assert.equal(text.code, 0);\n192:   assert.equal(text.out.trim(), 'ok claude');\n193: });\n194: \n195: test('passes a launch whose semicolon sticks to the previous word', (t) => {\n196:   const f = fixture(t);\n197:   writeClaudeSettings(f.root, {\n198:     UserPromptSubmit: [{ hooks: [{ type: 'command', command: `cd /tmp; node ${CLAUDE_MARKER}` }] }],\n199:   });\n200:   const text = f.run();\n201:   assert.equal(text.code, 0);\n202:   assert.equal(text.out.trim(), 'ok claude');\n203: });\n204: \n205: test('names a runtime whose entry echoes a quoted command', (t) => {\n206:   const f = fixture(t);\n207:   writeClaudeSettings(f.root, {\n208:     UserPromptSubmit: [{ hooks: [{ type: 'command', command: `echo \"x && node ${CLAUDE_MARKER}\"` }] }],\n209:   });\n210:   const result = f.run();\n211:   assert.equal(result.code, 1);\n212:   assert.match(result.out, /^hook-missing claude \\.claude\\/settings\\.json$/m);\n213: });\n214: \n215: test('skips a runtime whose folder is absent', (t) => {\n216:   const f = fixture(t);\n217:   const text = f.run();\n218:   assert.equal(text.code, 0);\n219:   assert.equal(text.out, '');\n220:   const json = f.run('--json');\n221:   assert.equal(json.code, 0);\n222:   assert.deepEqual(JSON.parse(json.out).checks.map((check) => check.status), ['skipped', 'skipped', 'skipped', 'skipped']);\n223: });\n224: \n225: // Launch shapes a shell runs, each with node standing where a command starts.\n226: for (const [label, build] of [\n227:   ['env unsets a variable first', (m) => `env -u AI_SESSION_CHILD node ${m}`],\n228:   ['node preloads a module', (m) => `node -r ./preload.cjs ${m}`],\n229:   ['node preloads a module attached to the flag', (m) => `node -r./preload.cjs ${m}`],\n230:   ['the command runs in a subshell', (m) => `(node ${m})`],\n231:   ['the command runs in a brace group', (m) => `{ node ${m}; }`],\n232:   ['exec replaces the shell', (m) => `exec node ${m}`],\n233:   ['a background command comes first', (m) => `cd /tmp & node ${m}`],\n234:   ['a backslash continues the line', (m) => `node \\\\\\n${m}`],\n235: ]) {\n236:   test(`passes a launch where ${label}`, (t) => {\n237:     const f = fixture(t);\n238:     writeClaudeSettings(f.root, {\n239:       UserPromptSubmit: [{ hooks: [{ type: 'command', command: build(CLAUDE_MARKER) }] }],\n240:     });\n241:     const text = f.run();\n242:     assert.equal(text.code, 0);\n243:     assert.equal(text.out.trim(), 'ok claude');\n244:   });\n245: }\n246: \n247: // Text that names node and the script without a shell ever running it.\n248: for (const [label, build] of [\n249:   ['a quote never closes', (m) => `echo \"x; node ${m}`],\n250:   ['node only checks the syntax', (m) => `node --check ${m}`],\n251:   ['node evaluates inline code', (m) => `node -e \"1\" ${m}`],\n252:   ['node evaluates code attached to the flag', (m) => `node -e1 ${m}`],\n253:   ['node evaluates code given with an equals sign', (m) => `node --eval=1 ${m}`],\n254:   ['node prints an expression given with an equals sign', (m) => `node --print=1 ${m}`],\n255:   ['the launch sits in a comment', (m) => `true # ; node ${m}`],\n256:   ['a shell script takes its own -c argument', (m) => `bash ./x.sh -c \"node ${m}\"`],\n257: ]) {\n258:   test(`names a runtime when ${label}`, (t) => {\n259:     const f = fixture(t);\n260:     writeClaudeSettings(f.root, {\n261:       UserPromptSubmit: [{ hooks: [{ type: 'command', command: build(CLAUDE_MARKER) }] }],\n262:     });\n263:     const text = f.run();\n264:     assert.equal(text.code, 1);\n265:     assert.match(text.out, /^hook-missing claude \\.claude\\/settings\\.json$/m);\n266:   });\n267: }","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file .skilled/commands/doctor/scripts/tests/hook-wiring-check.test.cjs, lines 1-267\n1: #!/usr/bin/env node\n2: // ───────────────────────────────────────────────────────────────────\n3: // MODULE: Hook Wiring Check Tests\n4: // ───────────────────────────────────────────────────────────────────\n5: 'use strict';\n6: \n7: // Drives the hook wiring check as a process against throwaway checkouts. The\n8: // cases pin both verdicts and the checkout that has no runtime folder at all.\n9: \n10: // ─────────────────────────────────────────────────────────────────────────────\n11: // 1. IMPORTS AND FIXTURES\n12: // ─────────────────────────────────────────────────────────────────────────────\n13: \n14: const assert = require('node:assert/strict');\n15: const { spawnSync } = require('node:child_process');\n16: const fs = require('node:fs');\n17: const os = require('node:os');\n18: const path = require('node:path');\n19: const test = require('node:test');\n20: \n21: const SCRIPT = path.resolve(__dirname, '..', 'hook-wiring-check.cjs');\n22: const CLAUDE_FILE = '.claude/settings.json';\n23: const CLAUDE_MARKER = '.skilled/skills/system-spec-kit/runtime/dist/hooks/claude/user-prompt-submit.js';\n24: \n25: function fixture(t) {\n26:   const root = fs.mkdtempSync(path.join(os.tmpdir(), 'hook-wiring-check-'));\n27:   t.after(() => fs.rmSync(root, { recursive: true, force: true }));\n28:   const run = (...args) => {\n29:     const result = spawnSync(process.execPath, [SCRIPT, '--root', root, ...args], { encoding: 'utf8' });\n30:     return { code: result.status, out: result.stdout, err: result.stderr };\n31:   };\n32:   return { root, run };\n33: }\n34: \n35: function writeClaudeSettings(root, hooks) {\n36:   fs.mkdirSync(path.join(root, '.claude'), { recursive: true });\n37:   fs.writeFileSync(path.join(root, CLAUDE_FILE), JSON.stringify({ hooks }, null, 2));\n38: }\n39: \n40: // ─────────────────────────────────────────────────────────────────────────────\n41: // 2. TESTS\n42: // ─────────────────────────────────────────────────────────────────────────────\n43: \n44: test('names a runtime whose prompt entry is absent', (t) => {\n45:   const f = fixture(t);\n46:   writeClaudeSettings(f.root, {\n47:     UserPromptSubmit: [{ hooks: [{ type: 'command', command: 'node some-other-hook.js' }] }],\n48:   });\n49:   const before = fs.readFileSync(path.join(f.root, CLAUDE_FILE), 'utf8');\n50:   const result = f.run();\n51:   assert.equal(result.code, 1);\n52:   assert.match(result.out, /^hook-missing claude \\.claude\\/settings\\.json$/m);\n53:   assert.equal(fs.readFileSync(path.join(f.root, CLAUDE_FILE), 'utf8'), before, 'check changed the hook file');\n54: });\n55: \n56: test('passes a runtime whose prompt entry is wired', (t) => {\n57:   const f = fixture(t);\n58:   writeClaudeSettings(f.root, {\n59:     UserPromptSubmit: [{\n60:       hooks: [{ type: 'command', command: `bash -c 'cd \"$PWD\" && node ${CLAUDE_MARKER}'` }],\n61:     }],\n62:   });\n63:   const text = f.run();\n64:   assert.equal(text.code, 0);\n65:   assert.equal(text.out.trim(), 'ok claude');\n66:   const json = f.run('--json');\n67:   assert.equal(json.code, 0);\n68:   assert.equal(JSON.parse(json.out).checks.find((check) => check.runtime === 'claude').status, 'ok');\n69: });\n70: \n71: test('passes a prompt entry that starts node on the script path', (t) => {\n72:   const f = fixture(t);\n73:   writeClaudeSettings(f.root, {\n74:     UserPromptSubmit: [{\n75:       hooks: [{ type: 'command', command: `node ${CLAUDE_MARKER}` }],\n76:     }],\n77:   });\n78:   const text = f.run();\n79:   assert.equal(text.code, 0);\n80:   assert.equal(text.out.trim(), 'ok claude');\n81: });\n82: \n83: test('passes a prompt entry that starts node by its absolute path', (t) => {\n84:   const f = fixture(t);\n85:   writeClaudeSettings(f.root, {\n86:     UserPromptSubmit: [{\n87:       hooks: [{ type: 'command', command: `/opt/homebrew/bin/node ${CLAUDE_MARKER}` }],\n88:     }],\n89:   });\n90:   const text = f.run();\n91:   assert.equal(text.code, 0);\n92:   assert.equal(text.out.trim(), 'ok claude');\n93: });\n94: \n95: test('names a runtime whose entry only names node as an argument', (t) => {\n96:   const f = fixture(t);\n97:   writeClaudeSettings(f.root, {\n98:     UserPromptSubmit: [{\n99:       hooks: [{ type: 'command', command: `echo node ${CLAUDE_MARKER}` }],\n100:     }],\n101:   });\n102:   const result = f.run();\n103:   assert.equal(result.code, 1);\n104:   assert.match(result.out, /^hook-missing claude \\.claude\\/settings\\.json$/m);\n105: });\n106: \n107: test('names a runtime whose entry only echoes the script path', (t) => {\n108:   const f = fixture(t);\n109:   writeClaudeSettings(f.root, {\n110:     UserPromptSubmit: [{\n111:       hooks: [{ type: 'command', command: 'echo hooks/claude/user-prompt-submit.js' }],\n112:     }],\n113:   });\n114:   const result = f.run();\n115:   assert.equal(result.code, 1);\n116:   assert.match(result.out, /^hook-missing claude \\.claude\\/settings\\.json$/m);\n117: });\n118: \n119: test('names a runtime whose entry only describes the script', (t) => {\n120:   const f = fixture(t);\n121:   writeClaudeSettings(f.root, {\n122:     UserPromptSubmit: [{\n123:       hooks: [{\n124:         type: 'command',\n125:         command: 'node some-other-hook.js',\n126:         description: 'hooks/claude/user-prompt-submit.js',\n127:       }],\n128:     }],\n129:   });\n130:   const result = f.run();\n131:   assert.equal(result.code, 1);\n132:   assert.match(result.out, /^hook-missing claude \\.claude\\/settings\\.json$/m);\n133: });\n134: \n135: test('passes a launch that starts node through env', (t) => {\n136:   const f = fixture(t);\n137:   writeClaudeSettings(f.root, {\n138:     UserPromptSubmit: [{ hooks: [{ type: 'command', command: `env node ${CLAUDE_MARKER}` }] }],\n139:   });\n140:   const text = f.run();\n141:   assert.equal(text.code, 0);\n142:   assert.equal(text.out.trim(), 'ok claude');\n143: });\n144: \n145: test('passes a launch that starts node through an absolute env', (t) => {\n146:   const f = fixture(t);\n147:   writeClaudeSettings(f.root, {\n148:     UserPromptSubmit: [{ hooks: [{ type: 'command', command: `/usr/bin/env node ${CLAUDE_MARKER}` }] }],\n149:   });\n150:   const text = f.run();\n151:   assert.equal(text.code, 0);\n152:   assert.equal(text.out.trim(), 'ok claude');\n153: });\n154: \n155: test('passes a launch that runs node inside a bash login command', (t) => {\n156:   const f = fixture(t);\n157:   writeClaudeSettings(f.root, {\n158:     UserPromptSubmit: [{ hooks: [{ type: 'command', command: `bash -lc \"node ${CLAUDE_MARKER}\"` }] }],\n159:   });\n160:   const text = f.run();\n161:   assert.equal(text.code, 0);\n162:   assert.equal(text.out.trim(), 'ok claude');\n163: });\n164: \n165: test('passes a launch that runs node inside a zsh command', (t) => {\n166:   const f = fixture(t);\n167:   writeClaudeSettings(f.root, {\n168:     UserPromptSubmit: [{ hooks: [{ type: 'command', command: `zsh -c 'node ${CLAUDE_MARKER}'` }] }],\n169:   });\n170:   const text = f.run();\n171:   assert.equal(text.code, 0);\n172:   assert.equal(text.out.trim(), 'ok claude');\n173: });\n174: \n175: test('passes a launch that gives node a flag', (t) => {\n176:   const f = fixture(t);\n177:   writeClaudeSettings(f.root, {\n178:     UserPromptSubmit: [{ hooks: [{ type: 'command', command: `node --no-warnings ${CLAUDE_MARKER}` }] }],\n179:   });\n180:   const text = f.run();\n181:   assert.equal(text.code, 0);\n182:   assert.equal(text.out.trim(), 'ok claude');\n183: });\n184: \n185: test('passes a launch whose separator sticks to the previous word', (t) => {\n186:   const f = fixture(t);\n187:   writeClaudeSettings(f.root, {\n188:     UserPromptSubmit: [{ hooks: [{ type: 'command', command: `cd \"\\$PWD\"&& node ${CLAUDE_MARKER}` }] }],\n189:   });\n190:   const text = f.run();\n191:   assert.equal(text.code, 0);\n192:   assert.equal(text.out.trim(), 'ok claude');\n193: });\n194: \n195: test('passes a launch whose semicolon sticks to the previous word', (t) => {\n196:   const f = fixture(t);\n197:   writeClaudeSettings(f.root, {\n198:     UserPromptSubmit: [{ hooks: [{ type: 'command', command: `cd /tmp; node ${CLAUDE_MARKER}` }] }],\n199:   });\n200:   const text = f.run();\n201:   assert.equal(text.code, 0);\n202:   assert.equal(text.out.trim(), 'ok claude');\n203: });\n204: \n205: test('names a runtime whose entry echoes a quoted command', (t) => {\n206:   const f = fixture(t);\n207:   writeClaudeSettings(f.root, {\n208:     UserPromptSubmit: [{ hooks: [{ type: 'command', command: `echo \"x && node ${CLAUDE_MARKER}\"` }] }],\n209:   });\n210:   const result = f.run();\n211:   assert.equal(result.code, 1);\n212:   assert.match(result.out, /^hook-missing claude \\.claude\\/settings\\.json$/m);\n213: });\n214: \n215: test('skips a runtime whose folder is absent', (t) => {\n216:   const f = fixture(t);\n217:   const text = f.run();\n218:   assert.equal(text.code, 0);\n219:   assert.equal(text.out, '');\n220:   const json = f.run('--json');\n221:   assert.equal(json.code, 0);\n222:   assert.deepEqual(JSON.parse(json.out).checks.map((check) => check.status), ['skipped', 'skipped', 'skipped', 'skipped']);\n223: });\n224: \n225: // Launch shapes a shell runs, each with node standing where a command starts.\n226: for (const [label, build] of [\n227:   ['env unsets a variable first', (m) => `env -u AI_SESSION_CHILD node ${m}`],\n228:   ['node preloads a module', (m) => `node -r ./preload.cjs ${m}`],\n229:   ['node preloads a module attached to the flag', (m) => `node -r./preload.cjs ${m}`],\n230:   ['the command runs in a subshell', (m) => `(node ${m})`],\n231:   ['the command runs in a brace group', (m) => `{ node ${m}; }`],\n232:   ['exec replaces the shell', (m) => `exec node ${m}`],\n233:   ['a background command comes first', (m) => `cd /tmp & node ${m}`],\n234:   ['a backslash continues the line', (m) => `node \\\\\\n${m}`],\n235: ]) {\n236:   test(`passes a launch where ${label}`, (t) => {\n237:     const f = fixture(t);\n238:     writeClaudeSettings(f.root, {\n239:       UserPromptSubmit: [{ hooks: [{ type: 'command', command: build(CLAUDE_MARKER) }] }],\n240:     });\n241:     const text = f.run();\n242:     assert.equal(text.code, 0);\n243:     assert.equal(text.out.trim(), 'ok claude');\n244:   });\n245: }\n246: \n247: // Text that names node and the script without a shell ever running it.\n248: for (const [label, build] of [\n249:   ['a quote never closes', (m) => `echo \"x; node ${m}`],\n250:   ['node only checks the syntax', (m) => `node --check ${m}`],\n251:   ['node evaluates inline code', (m) => `node -e \"1\" ${m}`],\n252:   ['node evaluates code attached to the flag', (m) => `node -e1 ${m}`],\n253:   ['node evaluates code given with an equals sign', (m) => `node --eval=1 ${m}`],\n254:   ['node prints an expression given with an equals sign', (m) => `node --print=1 ${m}`],\n255:   ['the launch sits in a comment', (m) => `true # ; node ${m}`],\n256:   ['a shell script takes its own -c argument', (m) => `bash ./x.sh -c \"node ${m}\"`],\n257: ]) {\n258:   test(`names a runtime when ${label}`, (t) => {\n259:     const f = fixture(t);\n260:     writeClaudeSettings(f.root, {\n261:       UserPromptSubmit: [{ hooks: [{ type: 'command', command: build(CLAUDE_MARKER) }] }],\n262:     });\n263:     const text = f.run();\n264:     assert.equal(text.code, 1);\n265:     assert.match(text.out, /^hook-missing claude \\.claude\\/settings\\.json$/m);\n266:   });\n267: }"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\".skilled/commands/doctor/scripts/tests/hook-wiring-check.test.cjs\"}"},"time":{"start":1794596854119,"end":1794596854651}}}}
{"type":"tool_use","timestamp":1794596854654,"sessionID":"ses_e29b1d95affeG1NNpWx5iqRIiD","part":{"partID":"prt_1d64eda42001R3UT59oVuGkdGN","sessionID":"ses_e29b1d95affeG1NNpWx5iqRIiD","messageID":"msg_1d64ec6dc001fU5MryGYa6sBwb","type":"tool","id":"call_5a537fe8bede4114bcfad36d","tool":"read","state":{"status":"completed","input":{"path":".skilled/skills/system-skill-advisor/runtime/tests/command-attach-guards.vitest.ts"},"output":"Read file .skilled/skills/system-skill-advisor/runtime/tests/command-attach-guards.vitest.ts, lines 1-148\n1: // ───────────────────────────────────────────────────────────────\n2: // MODULE: Command attach guards\n3: // ───────────────────────────────────────────────────────────────\n4: \n5: // A hub route names the command that acts on the mode it picked, so it has to\n6: // honour the same no-edit wording the scorer honours. A reader who rules out a\n7: // change must not be handed a command that changes files.\n8: \n9: import { readFileSync } from 'node:fs';\n10: import { join } from 'node:path';\n11: \n12: import { describe, expect, it } from 'vitest';\n13: \n14: import {\n15:   attachCommand,\n16:   isNoEditRequest,\n17:   NO_EDIT_REQUEST,\n18:   typedCommandForTop,\n19:   typedCommandIn,\n20: } from '../lib/command-attach.js';\n21: \n22: // The only route shape that names a command unambiguously: one decision and one\n23: // selected target.\n24: function SINGLE(workflowMode: string): Record<string, unknown> {\n25:   return { action: 'route', selectionKind: 'single', targets: [{ workflowMode }] };\n26: }\n27: \n28: // The endings a reader uses to rule out a change. One writes the contraction\n29: // with a curly apostrophe, which is the form many keyboards produce.\n30: const NOEDIT4 = [\n31:   \"don't change anything yet\",\n32:   'no changes yet',\n33:   'don\\u2019t touch any files',\n34:   'make no changes',\n35: ];\n36: \n37: describe('command attach on a no-edit prompt', () => {\n38:   it('offers no hub command when the prompt rules out a change', () => {\n39:     const prompt = 'use sk-doc to create a skill called invoice-parser, do not change anything yet';\n40:     expect(attachCommand('sk-doc', SINGLE('sk-create-skill'), prompt)).toBeUndefined();\n41:   });\n42: \n43:   it('offers the command when the same prompt asks for the change', () => {\n44:     const prompt = 'use sk-doc to create a skill called invoice-parser';\n45:     expect(attachCommand('sk-doc', SINGLE('sk-create-skill'), prompt)).toBe('/create:sk-skill');\n46:   });\n47: \n48:   it('reads the shared no-edit wording', () => {\n49:     expect(NO_EDIT_REQUEST.test('just show me the plan')).toBe(true);\n50:   });\n51: \n52:   it.each(NOEDIT4)('offers no hub command when the prompt ends %s', (ending) => {\n53:     const prompt = 'use sk-doc to create an agent called invoice-parser, ' + ending;\n54:     expect(attachCommand('sk-doc', SINGLE('sk-create-agent'), prompt)).toBeUndefined();\n55:   });\n56: \n57:   it('offers the agent command when the prompt asks for the change', () => {\n58:     const prompt = 'use sk-doc to create an agent called invoice-parser';\n59:     expect(attachCommand('sk-doc', SINGLE('sk-create-agent'), prompt)).toBe('/create:agent');\n60:   });\n61: \n62:   it('reads a curly apostrophe as a straight one', () => {\n63:     expect(isNoEditRequest('Don\\u2019t touch any files')).toBe(true);\n64:     expect(isNoEditRequest('touch the files')).toBe(false);\n65:   });\n66: \n67:   // A change request can say what must stay the same, and that is still a\n68:   // request for the change.\n69:   it.each([\n70:     'refactor the parser so there are no changes to its public api',\n71:     'fix the flaky test and make sure there are no changes in behaviour',\n72:     'create an agent called invoice-parser with no changes to existing agents',\n73:   ])('keeps a change request that limits its scope: %s', (prompt) => {\n74:     expect(isNoEditRequest(prompt)).toBe(false);\n75:   });\n76: \n77:   // The phrase reads as no change whatever follows it. The first row is a real\n78:   // no-edit request. The second is a change request that pays for the safe\n79:   // reading by losing its command.\n80:   it.each([\n81:     'show me the plan and make no changes to the files',\n82:     'refactor the parser and make no changes to its public api',\n83:   ])('reads make no changes as ruling out a change: %s', (prompt) => {\n84:     expect(isNoEditRequest(prompt)).toBe(true);\n85:   });\n86: });\n87: \n88: describe('command attach on a deep-loop prompt', () => {\n89:   it('withholds the review command when another deep-loop command is named', () => {\n90:     expect(attachCommand('system-deep-loop', SINGLE('review'), 'what did /deep:ai-council decide')).toBeUndefined();\n91:   });\n92: \n93:   it('withholds the review command when an unknown deep-loop command is named', () => {\n94:     expect(attachCommand('system-deep-loop', SINGLE('review'), 'what did /deep:reviw decide')).toBeUndefined();\n95:   });\n96: \n97:   it('offers the review command when it is the command typed', () => {\n98:     expect(attachCommand('system-deep-loop', SINGLE('review'), 'run /deep:review now')).toBe('/deep:review');\n99:   });\n100: \n101:   it('offers the review command when the prompt asks for depth', () => {\n102:     expect(attachCommand('system-deep-loop', SINGLE('review'), 'review the parser in depth')).toBe('/deep:review');\n103:   });\n104: });\n105: \n106: describe('typed command boundaries', () => {\n107:   it('does not read a file name with an extension as a typed command', () => {\n108:     expect(typedCommandIn('see /create:sk-skill.md for details')).toBeUndefined();\n109:   });\n110: \n111:   it('does not read a path segment as a typed command', () => {\n112:     expect(typedCommandIn('open /create:readme/notes.txt')).toBeUndefined();\n113:   });\n114: \n115:   it('reads a command that ends a sentence', () => {\n116:     expect(typedCommandIn('run /create:sk-skill.')).toBe('/create:sk-skill');\n117:   });\n118: \n119:   it('reads a command followed by a comma', () => {\n120:     expect(typedCommandIn('run /create:sk-skill, then stop')).toBe('/create:sk-skill');\n121:   });\n122: \n123:   it('reads the longest command when a prefix also matches', () => {\n124:     expect(typedCommandIn('/create:skill-parent now')).toBe('/create:skill-parent');\n125:   });\n126: \n127:   it('carries no command when the prompt only names a file', () => {\n128:     expect(typedCommandForTop('sk-doc', 'open /create:readme.md and summarise it')).toBeUndefined();\n129:   });\n130: });\n131: \n132: describe('generated command table', () => {\n133:   it('holds no separate policy table', async () => {\n134:     expect('COMMAND_POLICIES' in await import('../lib/command-attach.js')).toBe(false);\n135:   });\n136: \n137:   it('the command-bridges README names every command row field', () => {\n138:     const source = readFileSync(join(import.meta.dirname, '../lib/command-attach.ts'), 'utf8');\n139:     const readme = readFileSync(join(import.meta.dirname, '../scripts/command-bridges/README.md'), 'utf8');\n140:     const interfaceBlock = /export interface CommandRow \\{([\\s\\S]*?)\\n\\}/.exec(source)?.[1] ?? '';\n141:     const fields = [...interfaceBlock.matchAll(/readonly (\\w+)\\??:/g)].map((match) => match[1]);\n142:     expect(fields).toEqual(['command', 'policy', 'mutating', 'ownerSkillId']);\n143:     const sentence = /Each row carries [^\\n]*/.exec(readme)?.[0] ?? '';\n144:     for (const field of fields) {\n145:       expect(sentence).toContain('`' + field + '`');\n146:     }\n147:   });\n148: });","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file .skilled/skills/system-skill-advisor/runtime/tests/command-attach-guards.vitest.ts, lines 1-148\n1: // ───────────────────────────────────────────────────────────────\n2: // MODULE: Command attach guards\n3: // ───────────────────────────────────────────────────────────────\n4: \n5: // A hub route names the command that acts on the mode it picked, so it has to\n6: // honour the same no-edit wording the scorer honours. A reader who rules out a\n7: // change must not be handed a command that changes files.\n8: \n9: import { readFileSync } from 'node:fs';\n10: import { join } from 'node:path';\n11: \n12: import { describe, expect, it } from 'vitest';\n13: \n14: import {\n15:   attachCommand,\n16:   isNoEditRequest,\n17:   NO_EDIT_REQUEST,\n18:   typedCommandForTop,\n19:   typedCommandIn,\n20: } from '../lib/command-attach.js';\n21: \n22: // The only route shape that names a command unambiguously: one decision and one\n23: // selected target.\n24: function SINGLE(workflowMode: string): Record<string, unknown> {\n25:   return { action: 'route', selectionKind: 'single', targets: [{ workflowMode }] };\n26: }\n27: \n28: // The endings a reader uses to rule out a change. One writes the contraction\n29: // with a curly apostrophe, which is the form many keyboards produce.\n30: const NOEDIT4 = [\n31:   \"don't change anything yet\",\n32:   'no changes yet',\n33:   'don\\u2019t touch any files',\n34:   'make no changes',\n35: ];\n36: \n37: describe('command attach on a no-edit prompt', () => {\n38:   it('offers no hub command when the prompt rules out a change', () => {\n39:     const prompt = 'use sk-doc to create a skill called invoice-parser, do not change anything yet';\n40:     expect(attachCommand('sk-doc', SINGLE('sk-create-skill'), prompt)).toBeUndefined();\n41:   });\n42: \n43:   it('offers the command when the same prompt asks for the change', () => {\n44:     const prompt = 'use sk-doc to create a skill called invoice-parser';\n45:     expect(attachCommand('sk-doc', SINGLE('sk-create-skill'), prompt)).toBe('/create:sk-skill');\n46:   });\n47: \n48:   it('reads the shared no-edit wording', () => {\n49:     expect(NO_EDIT_REQUEST.test('just show me the plan')).toBe(true);\n50:   });\n51: \n52:   it.each(NOEDIT4)('offers no hub command when the prompt ends %s', (ending) => {\n53:     const prompt = 'use sk-doc to create an agent called invoice-parser, ' + ending;\n54:     expect(attachCommand('sk-doc', SINGLE('sk-create-agent'), prompt)).toBeUndefined();\n55:   });\n56: \n57:   it('offers the agent command when the prompt asks for the change', () => {\n58:     const prompt = 'use sk-doc to create an agent called invoice-parser';\n59:     expect(attachCommand('sk-doc', SINGLE('sk-create-agent'), prompt)).toBe('/create:agent');\n60:   });\n61: \n62:   it('reads a curly apostrophe as a straight one', () => {\n63:     expect(isNoEditRequest('Don\\u2019t touch any files')).toBe(true);\n64:     expect(isNoEditRequest('touch the files')).toBe(false);\n65:   });\n66: \n67:   // A change request can say what must stay the same, and that is still a\n68:   // request for the change.\n69:   it.each([\n70:     'refactor the parser so there are no changes to its public api',\n71:     'fix the flaky test and make sure there are no changes in behaviour',\n72:     'create an agent called invoice-parser with no changes to existing agents',\n73:   ])('keeps a change request that limits its scope: %s', (prompt) => {\n74:     expect(isNoEditRequest(prompt)).toBe(false);\n75:   });\n76: \n77:   // The phrase reads as no change whatever follows it. The first row is a real\n78:   // no-edit request. The second is a change request that pays for the safe\n79:   // reading by losing its command.\n80:   it.each([\n81:     'show me the plan and make no changes to the files',\n82:     'refactor the parser and make no changes to its public api',\n83:   ])('reads make no changes as ruling out a change: %s', (prompt) => {\n84:     expect(isNoEditRequest(prompt)).toBe(true);\n85:   });\n86: });\n87: \n88: describe('command attach on a deep-loop prompt', () => {\n89:   it('withholds the review command when another deep-loop command is named', () => {\n90:     expect(attachCommand('system-deep-loop', SINGLE('review'), 'what did /deep:ai-council decide')).toBeUndefined();\n91:   });\n92: \n93:   it('withholds the review command when an unknown deep-loop command is named', () => {\n94:     expect(attachCommand('system-deep-loop', SINGLE('review'), 'what did /deep:reviw decide')).toBeUndefined();\n95:   });\n96: \n97:   it('offers the review command when it is the command typed', () => {\n98:     expect(attachCommand('system-deep-loop', SINGLE('review'), 'run /deep:review now')).toBe('/deep:review');\n99:   });\n100: \n101:   it('offers the review command when the prompt asks for depth', () => {\n102:     expect(attachCommand('system-deep-loop', SINGLE('review'), 'review the parser in depth')).toBe('/deep:review');\n103:   });\n104: });\n105: \n106: describe('typed command boundaries', () => {\n107:   it('does not read a file name with an extension as a typed command', () => {\n108:     expect(typedCommandIn('see /create:sk-skill.md for details')).toBeUndefined();\n109:   });\n110: \n111:   it('does not read a path segment as a typed command', () => {\n112:     expect(typedCommandIn('open /create:readme/notes.txt')).toBeUndefined();\n113:   });\n114: \n115:   it('reads a command that ends a sentence', () => {\n116:     expect(typedCommandIn('run /create:sk-skill.')).toBe('/create:sk-skill');\n117:   });\n118: \n119:   it('reads a command followed by a comma', () => {\n120:     expect(typedCommandIn('run /create:sk-skill, then stop')).toBe('/create:sk-skill');\n121:   });\n122: \n123:   it('reads the longest command when a prefix also matches', () => {\n124:     expect(typedCommandIn('/create:skill-parent now')).toBe('/create:skill-parent');\n125:   });\n126: \n127:   it('carries no command when the prompt only names a file', () => {\n128:     expect(typedCommandForTop('sk-doc', 'open /create:readme.md and summarise it')).toBeUndefined();\n129:   });\n130: });\n131: \n132: describe('generated command table', () => {\n133:   it('holds no separate policy table', async () => {\n134:     expect('COMMAND_POLICIES' in await import('../lib/command-attach.js')).toBe(false);\n135:   });\n136: \n137:   it('the command-bridges README names every command row field', () => {\n138:     const source = readFileSync(join(import.meta.dirname, '../lib/command-attach.ts'), 'utf8');\n139:     const readme = readFileSync(join(import.meta.dirname, '../scripts/command-bridges/README.md'), 'utf8');\n140:     const interfaceBlock = /export interface CommandRow \\{([\\s\\S]*?)\\n\\}/.exec(source)?.[1] ?? '';\n141:     const fields = [...interfaceBlock.matchAll(/readonly (\\w+)\\??:/g)].map((match) => match[1]);\n142:     expect(fields).toEqual(['command', 'policy', 'mutating', 'ownerSkillId']);\n143:     const sentence = /Each row carries [^\\n]*/.exec(readme)?.[0] ?? '';\n144:     for (const field of fields) {\n145:       expect(sentence).toContain('`' + field + '`');\n146:     }\n147:   });\n148: });"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\".skilled/skills/system-skill-advisor/runtime/tests/command-attach-guards.vitest.ts\"}"},"time":{"start":1794596854338,"end":1794596854654}}}}
