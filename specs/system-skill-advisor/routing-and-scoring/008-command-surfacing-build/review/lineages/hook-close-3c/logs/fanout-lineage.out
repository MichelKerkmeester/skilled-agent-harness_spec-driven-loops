17: // Reading the words first keeps an echo of a quoted script a mention, because a\n118: // quoted word is only an argument unless a shell is told to run it.\n119: function readWords(command) {\n120:   const words = [];\n121:   let text = '';\n122:   let started = false;\n123: \n124:   function flush() {\n125:     if (!started) return;\n126:     words.push({ text, separator: false });\n127:     text = '';\n128:     started = false;\n129:   }\n130: \n131:   for (let i = 0; i < command.length; i += 1) {\n132:     const char = command[i];\n133:     if (char === \"'\" || char === '\"') {\n134:       started = true;\n135:       i += 1;\n136:       // A shell refuses a line whose quote never closes, so nothing in it runs.\n137:       if (command.indexOf(char, i) === -1) return [];\n138:       while (i < command.length && command[i] !== char) {\n139:         if (char === '\"' && command[i] === '\\\\' && i + 1 < command.length) {\n140:           text += command[i + 1];\n141:           i += 2;\n142:         } else {\n143:           text += command[i];\n144:           i += 1;\n145:         }\n146:       }\n147:       continue;\n148:     }\n149:     if (char === '\\\\') {\n150:       // A backslash before a line break joins the two lines and adds nothing.\n151:       if (command[i + 1] === '\\n') {\n152:         i += 1;\n153:       } else if (i + 1 < command.length) {\n154:         text += command[i + 1];\n155:         started = true;\n156:         i += 1;\n157:       }\n158:       continue;\n159:     }\n160:     // A comment runs from an unquoted # at the start of a word to the line end.\n161:     if (char === '#' && !started) {\n162:       while (i + 1 < command.length && command[i + 1] !== '\\n') i += 1;\n163:       continue;\n164:     }\n165:     if (char === '\\n') {\n166:       flush();\n167:       words.push({ text: char, separator: true });\n168:       continue;\n169:     }\n170:     const pair = command.slice(i, i + 2);\n171:     if (pair === '&&' || pair === '||') {\n172:       flush();\n173:       words.push({ text: pair, separator: true });\n174:       i += 1;\n175:       continue;\n176:     }\n177:     if (char === ';' || char === '|' || char === '&' || char === '(' || char === ')') {\n178:       flush();\n179:       words.push({ text: char, separator: true });\n180:       continue;\n181:     }\n182:     if (/\\s/.test(char)) {\n183:       flush();\n184:       continue;\n185:     }\n186:     text += char;\n187:     started = true;\n188:   }\n189:   flush();\n190:   return words;\n191: }\n192: \n193: function simpleCommands(words) {\n194:   const commands = [];\n195:   let current = [];\n196:   for (const word of words) {\n197:     if (word.separator) {\n198:       if (current.length > 0) commands.push(current);\n199:       current = [];\n200:     } else {\n201:       current.push(word);\n202:     }\n203:   }\n204:   if (current.length > 0) commands.push(current);\n205:   return commands;\n206: }\n207: \n208: function collectCommands(node, commands) {\n209:   if (Array.isArray(node)) {\n210:     for (const entry of node) collectCommands(entry, commands);\n211:   } else if (node && typeof node === 'object') {\n212:     if (node.type === 'command' && typeof node.command === 'string') commands.push(node.command);\n213:     if (Array.isArray(node.hooks)) collectCommands(node.hooks, commands);\n214:   }\n215:   return commands;\n216: }\n217: \n218: const ASSIGNMENT = /^[A-Za-z_][A-Za-z0-9_]*=/;\n219: \n220: // Flags whose next word is their own argument, so that word is not the command.\n221: const ENV_FLAGS_WITH_ARGUMENT = new Set(['-u', '--unset', '-C', '--chdir']);\n222: const NODE_FLAGS_WITH_ARGUMENT = new Set([\n223:   '-r', '--require', '--import', '--loader', '--experimental-loader', '-C', '--conditions',\n224: ]);\n225: // Flags that make node do something other than run the script it is given.\n226: const NODE_FLAGS_WITHOUT_RUN = new Set([\n227:   '-c', '--check', '-e', '--eval', '-p', '--print', '-v', '--version', '-h', '--help',\n228: ]);\n229: // A flag can carry its value in the same word, after an equals sign for a long\n230: // flag and directly after the letter for a short one, so the name is read first.\n231: function nodeFlagSkipsScript(flag) {\n232:   if (flag.startsWith('--')) return NODE_FLAGS_WITHOUT_RUN.has(flag.split('=')[0]);\n233:   if (NODE_FLAGS_WITHOUT_RUN.has(flag)) return true;\n234:   // A short preload flag takes the rest of its word as the module name.\n235:   if (/^-[rC]/.test(flag)) return false;\n236:   return /^-[a-zA-Z]*[cepvh]/.test(flag);\n237: }\n238: \n239: // Words that open a group or hand over the shell and leave the command after them.\n240: const COMMAND_PREFIXES = new Set(['{', 'exec']);\n241: \n242: function isNodeExecutable(token) {\n243:   return token === 'node' || token.endsWith('/node');\n244: }\n245: \n246: function isEnvExecutable(token) {\n247:   return token === 'env' || token.endsWith('/env');\n248: }\n249: \n250: function isShellExecutable(token) {\n251:   return ['bash', 'sh', 'zsh'].some((name) => token === name || token.endsWith(`/${name}`));\n252: }\n253: \n254: // env launches the command after its own assignments and flags, so those words\n255: // say nothing about what runs. The same holds for a leading assignment.\n256: function commandWords(words) {\n257:   let index = 0;\n258:   while (index < words.length && COMMAND_PREFIXES.has(words[index].text)) index += 1;\n259:   while (index < words.length && ASSIGNMENT.test(words[index].text)) index += 1;\n260:   if (index < words.length && isEnvExecutable(words[index].text)) {\n261:     index += 1;\n262:     while (index < words.length\n263:       && (ASSIGNMENT.test(words[index].text) || words[index].text.startsWith('-'))) {\n264:       index += ENV_FLAGS_WITH_ARGUMENT.has(words[index].text) ? 2 : 1;\n265:     }\n266:   }\n267:   return words.slice(index);\n268: }\n269: \n270: function runsNodeOnMarker(words, marker) {\n271:   const rest = commandWords(words);\n272:   if (rest.length === 0 || !isNodeExecutable(rest[0].text)) return false;\n273:   let index = 1;\n274:   while (index < rest.length && rest[index].text.startsWith('-')) {\n275:     const flag = rest[index].text;\n276:     if (nodeFlagSkipsScript(flag)) return false;\n277:     index += NODE_FLAGS_WITH_ARGUMENT.has(flag) ? 2 : 1;\n278:   }\n279:   return index < rest.length && rest[index].text.endsWith(marker);\n280: }\n281: \n282: // bash -c and its login, sh and zsh forms hand the next word to a shell as a\n283: // script, so that word is read again as commands. No other word is.\n284: function scriptWord(words) {\n285:   const rest = commandWords(words);\n286:   if (rest.length < 2 || !isShellExecutable(rest[0].text)) return null;\n287:   // The first word that is not a flag is a script file, and what follows it\n288:   // belongs to that script.\n289:   for (let index = 1; index < rest.length - 1; index += 1) {\n290:     const flag = rest[index].text;\n291:     if (!flag.startsWith('-')) return null;\n292:     if (!flag.startsWith('--') && flag.slice(1).includes('c')) {\n293:       return rest[index + 1];\n294:     }\n295:   }\n296:   return null;\n297: }\n298: \n299: // An argument that only names node, as `echo node <script>` does, runs\n300: // nothing, so node must stand where a shell starts a command.\n301: function runsMarker(command, marker, depth = 0) {\n302:   return simpleCommands(readWords(command)).some((words) => {\n303:     if (runsNodeOnMarker(words, marker)) return true;\n304:     if (depth >= 2) return false;\n305:     const script = scriptWord(words);\n306:     return script !== null && runsMarker(script.text, marker, depth + 1);\n307:   });\n308: }\n309: \n310: function inspect(runtime, root) {\n311:   const file = path.join(root, runtime.file);\n312:   let document;\n313:   try {\n314:     document = JSON.parse(fs.readFileSync(file, 'utf8'));\n315:   } catch {\n316:     return { runtime: runtime.id, file: runtime.file, status: 'hook-missing' };\n317:   }\n318:   const payload = eventPayload(document, runtime.event);\n319:   const wired = collectCommands(payload, []).some((command) => runsMarker(command, runtime.marker));\n320:   return { runtime: runtime.id, file: runtime.file, status: wired ? 'ok' : 'hook-missing' };\n321: }\n322: \n323: // ─────────────────────────────────────────────────────────────────────────────\n324: // 4. MAIN\n325: // ─────────────────────────────────────────────────────────────────────────────\n326: \n327: function main(argv) {\n328:   const opts = parseArgs(argv);\n329:   const checks = RUNTIMES.map((runtime) => {\n330:     if (!fs.existsSync(path.join(opts.root, runtime.dir))) {\n331:       return { runtime: runtime.id, file: runtime.file, status: 'skipped' };\n332:     }\n333:     return inspect(runtime, opts.root);\n334:   });\n335: \n336:   if (opts.json) {\n337:     process.stdout.write(`${JSON.stringify({ root: opts.root, checks }, null, 2)}\\n`);\n338:   } else {\n339:     for (const check of checks) {\n340:       if (check.status === 'ok') process.stdout.write(`ok ${check.runtime}\\n`);\n341:       else if (check.status === 'hook-missing') process.stdout.write(`hook-missing ${check.runtime} ${check.file}\\n`);\n342:     }\n343:   }\n344: \n345:   return checks.some((check) => check.status === 'hook-missing') ? 1 : 0;\n346: }\n347: \n348: if (require.main === module) {\n349:   try {\n350:     process.exitCode = main(process.argv.slice(2));\n351:   } catch (err) {\n352:     process.stderr.write(`hook-wiring-check: ${err && err.message ? err.message : String(err)}\\n`);\n353:     process.exitCode = 2;\n354:   }\n355: }\n356: \n357: module.exports = { main, eventPayload };"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\".skilled/commands/doctor/scripts/hook-wiring-check.cjs\"}"},"time":{"start":1794596847843,"end":1794596848383}}}}
{"type":"tool_use","timestamp":1794596848386,"sessionID":"ses_e29b1d95affeG1NNpWx5iqRIiD","part":{"partID":"prt_1d64ec1d8001wex9K9eO9clS3g","sessionID":"ses_e29b1d95affeG1NNpWx5iqRIiD","messageID":"msg_1d64eae4f001rfOBUwlbuN5OEF","type":"tool","id":"call_5049040a80c0491cad953abc","tool":"read","state":{"status":"completed","input":{"path":".skilled/skills/system-skill-advisor/runtime/lib/command-attach.ts"},"output":"Read file .skilled/skills/system-skill-advisor/runtime/lib/command-attach.ts, lines 1-375\n1: // ───────────────────────────────────────────────────────────────\n2: // MODULE: Slash command attached to a hub's recommendation\n3: // ───────────────────────────────────────────────────────────────\n4: //\n5: // The advisor can name the workflow mode a hub would route a prompt to, but the\n6: // reader still has to translate that mode into the slash command that acts on\n7: // it. This module owns that translation and nothing else, kept free of imports\n8: // so the recommend path and a test read the same semantics.\n9: //\n10: // The mode-to-command table is generated rather than hand-maintained: each row is\n11: // derived from a hub's own command files, so a hub that adds or renames a mode\n12: // regenerates its row instead of drifting from a copy someone forgot to update.\n13: \n14: // BEGIN GENERATED MODE COMMANDS\n15: export const MODE_COMMANDS: Readonly<Record<string, Readonly<Record<string, string>>>> = {\n16:   'sk-design': {\n17:     'sk-design-chart': '/design:chart',\n18:     'sk-design-diagram': '/design:diagram',\n19:     'sk-design-md-generator': '/design:extract',\n20:   },\n21:   'sk-doc': {\n22:     'sk-create-agent': '/create:agent',\n23:     'sk-create-benchmark': '/create:benchmark',\n24:     'sk-create-changelog': '/create:changelog',\n25:     'sk-create-command': '/create:command',\n26:     'sk-create-diff': '/create:diff',\n27:     'sk-create-feature-catalog': '/create:feature-catalog',\n28:     'sk-create-goal': '/create:goal',\n29:     'sk-create-manual-testing-playbook': '/create:manual-testing-playbook',\n30:     'sk-create-readme': '/create:readme',\n31:     'sk-create-repo-rule': '/create:repo-rule',\n32:     'sk-create-skill': '/create:sk-skill',\n33:     'sk-create-skill-parent': '/create:skill-parent',\n34:     'sk-create-with-human-voice': '/create:with-human-voice',\n35:   },\n36:   'system-deep-loop': {\n37:     'ai-council': '/deep:ai-council',\n38:     'research': '/deep:research',\n39:     'review': '/deep:review',\n40:   },\n41: };\n42: // END GENERATED MODE COMMANDS\n43: \n44: // One row of the command table: the runnable slash command, the policy that says\n45: // whether it runs, asks or starts a session, the class that says what the run\n46: // writes, and the skill that owns it. The rows are generated, so only the shape\n47: // lives here.\n48: export interface CommandRow {\n49:   readonly command: string;\n50:   readonly policy?: 'run' | 'start' | 'ask';\n51:   readonly mutating?: 'read-only' | 'add-only' | 'mutates';\n52:   readonly ownerSkillId: string;\n53: }\n54: \n55: // The table below covers every tracked command, whether or not its bridge is\n56: // active, so a typed command always has a policy and an owner. `scorerRow` says\n57: // whether a scorer can also return the command on its own.\n58: export interface TrackedCommand {\n59:   readonly policy: 'run' | 'start' | 'ask';\n60:   readonly ownerSkillId: string;\n61:   readonly scorerRow: boolean;\n62: }\n63: \n64: // BEGIN GENERATED COMMAND ROWS\n65: export const COMMAND_ROWS: Readonly<Record<string, CommandRow>> = {\n66:   'command-create-agent': { command: '/create:agent', policy: 'start', mutating: 'mutates', ownerSkillId: 'sk-doc' },\n67:   'command-create-changelog': { command: '/create:changelog', policy: 'ask', mutating: 'mutates', ownerSkillId: 'sk-doc' },\n68:   'command-create-feature-catalog': { command: '/create:feature-catalog', policy: 'start', mutating: 'mutates', ownerSkillId: 'sk-doc' },\n69:   'command-create-manual-testing-playbook': { command: '/create:manual-testing-playbook', policy: 'start', mutating: 'mutates', ownerSkillId: 'sk-doc' },\n70:   'command-create-readme': { command: '/create:readme', policy: 'start', mutating: 'mutates', ownerSkillId: 'sk-doc' },\n71:   'command-create-sk-skill': { command: '/create:sk-skill', policy: 'start', mutating: 'mutates', ownerSkillId: 'sk-doc' },\n72:   'command-deep-research': { command: '/deep:research', policy: 'ask', mutating: 'mutates', ownerSkillId: 'system-deep-loop' },\n73:   'command-deep-review': { command: '/deep:review', policy: 'ask', mutating: 'mutates', ownerSkillId: 'system-deep-loop' },\n74:   'command-doctor-agents-md-check': { command: '/doctor:agents-md check', policy: 'run', mutating: 'read-only', ownerSkillId: 'system-skilled-doctor' },\n75:   'command-doctor-agents-md-embed': { command: '/doctor:agents-md embed', policy: 'ask', mutating: 'mutates', ownerSkillId: 'system-skilled-doctor' },\n76:   'command-doctor-agents-md-restore': { command: '/doctor:agents-md restore', policy: 'ask', mutating: 'mutates', ownerSkillId: 'system-skilled-doctor' },\n77:   'command-doctor-ci-report': { command: '/doctor:ci report', policy: 'run', mutating: 'read-only', ownerSkillId: 'sk-code' },\n78:   'command-doctor-ci-scaffold': { command: '/doctor:ci scaffold', policy: 'ask', mutating: 'mutates', ownerSkillId: 'sk-code' },\n79:   'command-doctor-ci-toggle': { command: '/doctor:ci toggle', policy: 'ask', mutating: 'mutates', ownerSkillId: 'sk-code' },\n80:   'command-doctor-deep-loop': { command: '/doctor:deep-loop', policy: 'run', mutating: 'add-only', ownerSkillId: 'system-deep-loop' },\n81:   'command-doctor-env': { command: '/doctor:env list', policy: 'run', mutating: 'read-only', ownerSkillId: 'system-skilled-doctor' },\n82:   'command-doctor-git-hooks': { command: '/doctor:git hooks', policy: 'ask', mutating: 'mutates', ownerSkillId: 'sk-git' },\n83:   'command-doctor-git-setup': { command: '/doctor:git setup', policy: 'run', mutating: 'read-only', ownerSkillId: 'sk-git' },\n84:   'command-doctor-git-standards': { command: '/doctor:git standards', policy: 'ask', mutating: 'mutates', ownerSkillId: 'sk-git' },\n85:   'command-doctor-helper': { command: '/doctor:helper', policy: 'run', mutating: 'read-only', ownerSkillId: 'system-skilled-doctor' },\n86:   'command-doctor-install': { command: '/doctor:install', policy: 'run', mutating: 'read-only', ownerSkillId: 'system-skilled-doctor' },\n87:   'command-doctor-mcp-debug': { command: '/doctor:mcp debug', policy: 'ask', mutating: 'mutates', ownerSkillId: 'system-skilled-doctor' },\n88:   'command-doctor-mcp-install': { command: '/doctor:mcp install', policy: 'ask', mutating: 'mutates', ownerSkillId: 'system-skilled-doctor' },\n89:   'command-doctor-overlay-apply': { command: '/doctor:overlay apply', policy: 'ask', mutating: 'mutates', ownerSkillId: 'system-skilled-doctor' },\n90:   'command-doctor-overlay-repin': { command: '/doctor:overlay repin', policy: 'ask', mutating: 'mutates', ownerSkillId: 'system-skilled-doctor' },\n91:   'command-doctor-overlay-status': { command: '/doctor:overlay status', policy: 'run', mutating: 'read-only', ownerSkillId: 'system-skilled-doctor' },\n92:   'command-doctor-runtime-mirrors': { command: '/doctor:runtime-mirrors', policy: 'run', mutating: 'read-only', ownerSkillId: 'system-skilled-doctor' },\n93:   'command-doctor-setup': { command: '/doctor:setup', policy: 'run', mutating: 'read-only', ownerSkillId: 'system-skilled-doctor' },\n94:   'command-doctor-sk-code-quality': { command: '/doctor:sk-code quality', policy: 'ask', mutating: 'mutates', ownerSkillId: 'sk-code' },\n95:   'command-doctor-sk-code-setup': { command: '/doctor:sk-code setup', policy: 'run', mutating: 'read-only', ownerSkillId: 'sk-code' },\n96:   'command-doctor-sk-skill-check': { command: '/doctor:sk-skill check', policy: 'run', mutating: 'read-only', ownerSkillId: 'sk-doc' },\n97:   'command-doctor-sk-skill-c