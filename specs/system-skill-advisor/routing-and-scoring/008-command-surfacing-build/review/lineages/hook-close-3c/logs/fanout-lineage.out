iberately NOT derived from\n91-   * `runDirectory`: that is a per-run path, and deriving the root from it\n92-   * would give every run its own authority record.\n93-   */\n94-  readonly authorityRoot?: string;\n95-  /** Transition policy to evaluate against. */\n96-  readonly policy: {\n97-    readonly policyId: string;\n98-    readonly policyVersion: number;\n99-    readonly policyDigest: string;\n100-  };\n101-  /** Policy registry for authorization evaluation. */\n102-  readonly policyRegistry: TransitionPolicyRegistry;\n103-  /** Authorization gateway instance. */\n104-  readonly authorizationGateway: TransitionAuthorizationGateway;\n105-  /** Ledger instance for the mode. */\n106-  readonly ledger: AppendOnlyLedger;\n107-  /** Optional event type registry for replay fingerprint derivation. */\n108-  readonly eventRegistry?: EventTypeRegistry;\n109-  /** Optional override for the projection refresh boundary. */\n110-  readonly projectionRefreshBoundary?: LegacyProjectionRefreshBoundary;\n111-  /** Optional projection contract for executing the projection refresh. */\n112-  readonly projectionContract?: LegacyProjectionContract<JsonObject>;\n113-  /** Optional projection engine instance. */\n114-  readonly projectionEngine?: LegacyProjectionEngine;\n115-  /** Optional pre-resolved binding (for tests, bypasses resolveCutoverBinding). */\n116-  readonly binding?: ResolvedCutoverBinding;\n117-  /** Optional override for the cutover binding environment (for tests). */\n118-  readonly bindingEnvironment?: CutoverBindingEnvironment;\n119-  /** Seam for tests; production reads the real environment. */\n120-  readonly now?: () => Date;\n121-}\n122-\n123-export interface ModeAppendReceipt extends DurableAppendReceipt {\n124-  readonly ledgerId: string;\n125-  readonly eventId: string;\n126-  readonly eventType: string;\n127-  readonly eventVersion: number;\n128-  readonly streamId: string;\n129-  readonly streamSequence: number;\n130-  readonly committedAt: string;\n131-