:    `- Completed pivots: ${registry.divergence.completed.length}`,\n1983:    `- Failed pivots: ${registry.divergence.failed.length}`,\n1984:    `- Audited overrides: ${registry.divergence.overrides.length}`,\n1985:    ...(registry.divergence.saturatedDirections.length\n1986:      ? registry.divergence.saturatedDirections.map((direction) => `- Swept: ${direction}`)\n1988:    ...(registry.divergence.completed.length\n1989:      ? registry.divergence.completed.map((pivot) =>\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"83:// Severities already reported as outside the scale, so a registry that repeats one\n381:function parseStrategyDimensions(strategyContent) {\n382:  const section = extractSection(strategyContent, '3. REVIEW DIMENSIONS (remaining)')\n383:    || extractSection(strategyContent, '3. KEY QUESTIONS (remaining)');\n556:  // dashboard reflects operator-visible lifecycle transitions, not only\n617: * used by the registry (matches parseFindingLine output shape).\n662:    // Preserve structured evidence fields so registry consumers do not need to\n666:    // Content hashes let the registry collapse repeated findings across review\n1146:function buildDimensionCoverage(iterationRecords, strategyDimensions) {\n1164:  for (const entry of strategyDimensions) {\n1369: * Aggregate the latest result for each traceability protocol into the registry.\n1406: * Defensively normalize each entry in `blockedBy` so the review dashboard\n1690:function buildRegistry(strategyDimensions, iterationFiles, iterationRecords, config, corruptionWarnings = [], deltaRecords = [], eventRecords = iterationRecords) {\n1694:  const dimensionCoverage = buildDimensionCoverage(iterationRecords, strategyDimensions);\n1774:function renderSearchDebtSection(registry) {\n1775:  const debt = Array.isArray(registry.searchDebt) ? registry.searchDebt : [];\n1776:  const ruledOut = Array.isArray(registry.ruledOutCandidates) ? registry.ruledOutCandidates : [];\n1777:  const cleanProof = Array.isArray(registry.cleanSearchProof) ? registry.cleanSearchProof : [];\n1778:  const coverage = registry.searchCoverage && typeof registry.searchCoverage === 'object'\n1779:    ? registry.searchCoverage\n1781:  const candidateCoverage = registry.candidateCoverage && typeof registry.candidateCoverage === 'object'\n1782:    ? registry.candidateCoverage\n1852:  // The strategy template wraps machine-managed sections in a different\n1868:    `Missing machine-owned anchor \"${anchorId}\" in deep-review strategy file. `\n1869:    + 'Pass createMissing:true (or the reducer CLI flag --create-missing-anchors) to bootstrap.',\n1892:    // Fail closed by default so a genuinely corrupt strategy file surfaces. Under the\n1894:    // of halting — this is what lets the reducer proceed on a freshly seeded strategy\n1900:    const error = new Error(`Missing insertion heading \"${beforeHeading}\" in deep-review strategy file.`);\n1908:function updateStrategyContent(strategyContent, registry, iterationFiles, options = {}, iterationRecords = []) {\n1909:  // Early return when there is no strategy file to update. Empty content\n1912:  // rather than throw so bootstrap flows (no strategy yet) still work.\n1913:  if (!strategyContent) {\n1914:    return strategyContent;\n1918:  const severity = registry.findingsBySeverity;\n1923:    `- Resolved: ${registry.resolvedFindingsCount}`,\n1927:    .filter((dimension) => registry.dimensionCoverage[dimension])\n1932:    .filter((dimension) => !registry.dimensionCoverage[dimension])\n1938:    || REQUIRED_DIMENSIONS.find((dimension) => !registry.dimensionCoverage[dimension])\n1940:  if (registry.divergence.currentFocus) {\n1941:    nextFocus = registry.divergence.currentFocus;\n1951:  const latestBlockedStop = registry.blockedStopHistory?.at(-1);\n1961:      const recovery = latestBlockedStop.recoveryStrategy || '[no recovery strategy provided]';\n1970:  let updated = strategyContent;