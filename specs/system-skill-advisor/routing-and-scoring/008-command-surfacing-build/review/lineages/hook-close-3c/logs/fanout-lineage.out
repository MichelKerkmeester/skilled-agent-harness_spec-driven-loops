d-only only|no edits yet|only; do not|just show|just list)\\b/;\n+export const NO_EDIT_REQUEST = /\\b(no edits?|make no changes(?! (?:to|in)\\b)|no changes yet|without making changes|(?:do not|don't) (change|edit|modify|touch)|read-only only|no edits yet|only; do not|just show|just list)\\b/;\n \n // Many keyboards type the contraction with a curly apostrophe, so the text is\n // folded to the straight form before the pattern reads it.\n=== DIFF 846 ===\ncommit 846eab66b8984c0e745a768fcc12f176ebdf1991\nAuthor: Michel Kerkmeester <<redacted>>\nDate:   Fri Nov 13 20:06:19 2026 +0100\n\n    fix(system-skill-advisor): read make no changes as ruling out a change\n    \n    The previous commit let a prompt that says to make no changes to something\n    keep its command, so that a change request limiting its scope was not\n    misread. A confirming review showed the cost: a real no-edit request that\n    names its object kept a mutating command offer.\n    \n    Words alone cannot tell the two readings apart, so the phrase rules out a\n    change whatever follows it. Losing an offer costs less than offering a\n    mutating command on a prompt that ruled one out. Tests pin both readings.\n    \n    Suite 184 files, 1798 passed, 0 failed. Floors and eval unchanged.\n    \n    Commit-Id: 0013899\n\ndiff --git a/.skilled/skills/system-skill-advisor/runtime/lib/command-attach.ts b/.skilled/skills/system-skill-advisor/runtime/lib/command-attach.ts\nindex 747b35f2ab..f6d13c19ff 100644\n--- a/.skilled/skills/system-skill-advisor/runtime/lib/command-attach.ts\n+++ b/.skilled/skills/system-skill-advisor/runtime/lib/command-attach.ts\n@@ -286,7 +286,10 @@ const DEPTH_REQUEST = new RegExp(`\\\\b(?:${DEPTH_WORDING.map(escapePhrase).join('\n \n // Wording that asks for an answer and rules out a change. One pattern serves\n // every gate that has to honour it, so a new gate cannot drift from the first.\n-export const NO_EDIT_REQUEST = /\\b(no edits?|make no changes(?! (?:to|in)\\b)|no changes yet|without making changes|(?:do not|don't) (change|edit|modify|touch)|read-only only|no edits yet|only; do not|just show|just list)\\b/;\n+// Words alone cannot tell \"make no changes to the files\" from a change request\n+// that says what to leave alone, so both read as no change: losing an offer\n+// costs less than offering a mutating command on a prompt that ruled one out.\n+export const NO_EDIT_REQUEST = /\\b(no edits?|make no changes|no changes yet|without making changes|(?:do not|don't) (change|edit|modify|touch)|read-only only|no edits yet|only; do not|just show|just list)\\b/;\n \n // Many keyboards type the contraction with a curly apostrophe, so the text is\n // folded to the straight form before the pattern reads it.\ndiff --git a/.skilled/skills/system-skill-advisor/runtime/tests/command-attach-guards.vitest.ts b/.skilled/skills/system-skill-advisor/runtime/tests/command-attach-guards.vitest.ts\nindex 2f4a049c44..bea3ccb47d 100644\n--- a/.skilled/skills/system-skill-advisor/runtime/tests/command-attach-guards.vitest.ts\n+++ b/.skilled/skills/system-skill-advisor/runtime/tests/command-attach-guards.vitest.ts\n@@ -70,11 +70,19 @@ describe('command attach on a no-edit prompt', () => {\n     'refactor the parser so there are no changes to its public api',\n     'fix the flaky test and make sure there are no changes in behaviour',\n     'create an agent called invoice-parser with no changes to existing agents',\n-    'refactor the parser and make no changes to its public api',\n-    'rename the helper but make no changes in the tests',\n   ])('keeps a change request that limits its scope: %s', (prompt) => {\n     expect(isNoEditRequest(prompt)).toBe(false);\n   });\n+\n+  // The phrase reads as no change whatever follows it. The first row is a real\n+  // no-edit request. The second is a change request that pays for the safe\n+  // reading by losing its command.\n+  it.each([\n+    'show me the plan and make no changes to the files',\n+    'refactor the parser and make no changes to its public api',\n+  ])('reads make no changes as ruling out a change: %s', (prompt) => {\n+    expect(isNoEditRequest(prompt)).toBe(true);\n+  });\n });\n \n describe('command attach on a deep-loop prompt', () => {\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"git -c core.fsmonitor=false log --oneline -8 -- .skilled/skills/system-skill-advisor/runtime/lib/command-attach.ts; echo \\\"=== DIFF 860 on command-attach ===\\\"; git -c core.fsmonitor=false show 860610d783 -- .skilled/skills/system-skill-advisor/runtime/lib/command-attach.ts; echo \\\"=== DIFF 846 ===\\\"; git -c core.fsmonitor=false show 846eab66b8 -- .skilled/skills/system-skill-advisor/runtime/lib/command-attach.ts .skilled/skills/system-skill-advisor/runtime/tests/command-attach-guards.vitest.ts\"}"},"time":{"start":1794597011304,"end":1794597012839}}}}
{"type":"step_finish","timestamp":1794597013705,"sessionID":"ses_e29b1d95affeG1NNpWx5iqRIiD","part":{"id":"prt_1d65148c9001c71r4SkFSQ2Rrc","sessionID":"ses_e29b1d95affeG1NNpWx5iqRIiD","messageID":"msg_1d650c64b001i3HBiwROVBajZ5","type":"step-finish","reason":"tool-calls","cost":0,"tokens":{"input":530,"output":284,"reasoning":2499,"cache":{"read":85888,"write":0}}}}
{"type":"step_start","timestamp":1794597017558,"sessionID":"ses_e29b1d95affeG1NNpWx5iqRIiD","part":{"id":"prt_1d65157d600164ZtTusgalkaD4","sessionID":"ses_e29b1d95affeG1NNpWx5iqRIiD","messageID":"msg_1d65148cd00124raUQl3VRNMH2","type":"step-start"}}
{"type":"tool_use","timestamp":1794597019461,"sessionID":"ses_e29b1d95affeG1NNpWx5iqRIiD","part":{"partID":"prt_1d6515d43001nEpbGBzKSD5foO","sessionID":"ses_e29b1d95affeG1NNpWx5iqRIiD","messageID":"msg_1d65148cd00124raUQl3VRNMH2","type":"tool","id":"call_f91d209a4a7c4c4088d119ec","tool":"shell","state":{"status":"completed","input":{"command":"sed -n '1,60p' specs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/review/lineages/hook-confirm-3b/iterations/iteration-002.md"},"output":"# Review Iteration 002 - hook-confirm-3b\n\n## Dispatcher\n\n- Lineage: `hook-confirm-3b`, session `fanout-hook-confirm-3b-1794595021404-69frey`, iteration 2 of 3.\n- Review focus (binding): the no-edit half of commit `860610d783` is checked once here; every finding needs file:line and a concrete input run.\n- How this iteration addressed the focus: it reads `NO_EDIT_REQUEST` and `isNoEditRequest` in full, reads all three callers, and runs the same prompts through the pre-commit module (`git show 860610d783^:...`) and the current module side by side, so the before/after delta is measured rather than asserted.\n\n## Dimension\n\nCorrectness.\n\n## Files Reviewed\n\n- `.skilled/skills/system-skill-advisor/runtime/lib/command-attach.ts:283-295` — `NO_EDIT_REQUEST`, `isNoEditRequest`.\n- `.skilled/skills/system-skill-advisor/runtime/lib/command-attach.ts:326-345` — `attachCommand` and its no-edit early return.\n- `.skilled/skills/system-skill-advisor/runtime/lib/scorer/fusion.ts:675-690` — `readOnlyRouteAllowed`.\n- `.skilled/skills/system-skill-advisor/runtime/lib/scorer/fusion.ts:877-886` — `commandMeaningEligible`.\n- `.skilled/skills/system-skill-advisor/runtime/lib/scorer/text.ts:147-160` — `isReadOnlyExplainer`.\n- `.skilled/skills/system-skill-advisor/runtime/tests/command-attach-guards.vitest.ts:30-77` — `NOEDIT4` and the scope-limit table.\n- Pre-commit module extracted with `git show 860610d783^:.skilled/skills/system-skill-advisor/runtime/lib/command-attach.ts` into `probes/command-attach-pre.ts` for the before/after comparison.\n\n## Findings by Severity\n\n### P0 Findings\n\nNone.\n\n### P1 Findings\n\n1. **The `make no changes` lookahead is over-broad: a genuine no-edit request that names its object loses the guard** -- `.skilled/skills/system-skill-advisor/runtime/lib/command-attach.ts:289` -- the added `(?! (?:to|in)\\b)` makes the shared no-edit predicate return `false` for every sentence of the form `make no changes to <object>`, including sentences that rule out all changes and merely say what the object is. The guard then stops withholding a mutating command, so a reader who explicitly ruled out a change is handed `/create:agent`.\n   Finding class: correctness (regression introduced by `860610d783`; the fix's own test table covers only the direction it fixed).\n   Scope proof: line 289 is the changed line in a declared-scope file; `attachCommand` at `command-attach.ts:335` and both scorer callers consume the same predicate, so the regression reaches every no-edit gate.\n   Affected surface hints: `attachCommand` hub-command gate, `readOnlyRouteAllowed` (`fusion.ts:677`), `commandMeaningEligible` (`fusion.ts:881`), `isReadOnlyExplainer` (`text.ts:150`).\n   Case: the prompt `make no changes to any file, just report what you find` is a plain no-edit request. Before the commit the predicate matched `make no changes` and `attachCommand` returned `undefined`; after the commit the predicate returns `false` and `attachCommand` returns `'/create:agent'` for a single-mode mutating route.\n\n   Concrete inputs run (current module vs pre-commit module, node v26.13.0):\n\n   ```\n   prompt: \"make no changes to any file, just report what you find\"\n     post-fix isNoEditRequest = false   attachCommand = \"/create:agent\"\n     pre-fix  isNoEditRequest = true    attachCommand = undefined\n   prompt: \"make no changes to the code, just analyze the parser\"\n     post-fix isNoEditRequest = false   attachCommand = \"/create:agent\"\n     pre-fix  isNoEditRequest = true    attachCommand = undefined\n   ```\n\n   Why P1: a prompt a person would plausibly type is misrouted, which is exactly the operator guide's P1 bar. The old wording (`make no changes` alone) is covered by `NOEDIT4` at `tests/command-attach-guards.vitest.ts:30-34`; the new exclusion removes the object-bearing form from the same class, and no replacement phrase (`just show`, `just list`, `do not change`) is required to be present. The suite still passes 26/26 because no test row exercises a genuine no-edit request that names its object.\n\n   Claim adjudication:\n\n   ```json\n   {\n     \"type\": \"correctness-regression\",\n     \"claim\": \"The added negative lookahead at command-attach.ts:289 disables the shared no-edit gate for genuine no-edit requests phrased as 'make no changes to <object>', so a mutating hub command is offered where it was withheld before the commit.\",\n     \"evidenceRefs\": [\"command-attach.ts:289\", \"command-attach.ts:335\", \"fusion.ts:677\", \"fusion.ts:881\", \"text.ts:150\", \"iterations/iteration-002.md probe output\"],\n     \"counterevidenceSought\": \"Checked every other alternative in NO_EDIT_REQUEST against the failing prompt ('no edits?', 'no changes yet', 'without making changes', 'do not change', 'read-only only', 'only; do not', 'just show', 'just list'); none matches, and no other caller re-checks a scope noun. Also ran the pre-commit module to confirm the guard fired before the change.\",\n     \"alternativeExplanation\": \"The change may be intended to treat every 'make no changes to X' as a scope limit. Rejected: the predicate's own contract is 'Wording that asks for an answer and rules out a change', and the existing NOEDIT4 table treats bare 'make no changes' as that wording. Only a change verb elsewhere in the prompt distinguishes the two readings, and the predicate cannot see one.\",\n     \"finalSeverity\": \"P1\",\n     \"confidence\": 0.9,\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"# Review Iteration 002 - hook-confirm-3b\n\n## Dispatcher\n\n- Lineage: `hook-confirm-3b`, session `fanout-hook-confirm-3b-1794595021404-69frey`, iteration 2 of 3.\n- Review focus (binding): the no-edit half of commit `860610d783` is checked once here; every finding needs file:line and a concrete input run.\n- How this iteration addressed the focus: it reads `NO_EDIT_REQUEST` and `isNoEditRequest` in full, reads all three callers, and runs the same prompts through the pre-commit module (`git show 860610d783^:...`) and the current module side by side, so the before/after delta is measured rather than asserted.\n\n## Dimension\n\nCorrectness.\n\n## Files Reviewed\n\n- `.skilled/skills/system-skill-advisor/runtime/lib/command-attach.ts:283-295` — `NO_EDIT_REQUEST`, `isNoEditRequest`.\n- `.skilled/skills/system-skill-advisor/runtime/lib/command-attach.ts:326-345` — `attachCommand` and its no-edit early return.\n- `.skilled/skills/system-skill-advisor/runtime/lib/scorer/fusion.ts:675-690` — `readOnlyRouteAllowed`.\n- `.skilled/skills/system-skill-advisor/runtime/lib/scorer/fusion.ts:877-886` — `commandMeaningEligible`.\n- `.skilled/skills/system-skill-advisor/runtime/lib/scorer/text.ts:147-160` — `isReadOnlyExplainer`.\n- `.skilled/skills/system-skill-advisor/runtime/tests/command-attach-guards.vitest.ts:30-77` — `NOEDIT4` and the scope-limit table.\n- Pre-commit module extracted with `git show 860610d783^:.skilled/skills/system-skill-advisor/runtime/lib/command-attach.ts` into `probes/command-attach-pre.ts` for the before/after comparison.\n\n## Findings by Severity\n\n### P0 Findings\n\nNone.\n\n### P1 Findings\n\n1. **The `make no changes` lookahead is over-broad: a genuine no-edit request that names its object loses the guard** -- `.skilled/skills/system-skill-advisor/runtime/lib/command-attach.ts:289` -- the added `(?! (?:to|in)\\b)` makes the shared no-edit predicate return `false` for every sentence of the form `make no changes to <object>`, including sentences that rule out all changes and merely say what the object is. The guard then stops withholding a mutating command, so a reader who explicitly ruled out a change is handed `/create:agent`.\n   Finding class: correctness (regression introduced by `860610d783`; the fix's own test table covers only the direction it fixed).\n   Scope proof: line 289 is the changed line in a declared-scope file; `attachCommand` at `command-attach.ts:335` and both scorer callers consume the same predicate, so the regression reaches every no-edit gate.\n   Affected surface hints: `attachCommand` hub-command gate, `readOnlyRouteAllowed` (`fusion.ts:677`), `commandMeaningEligible` (`fusion.ts:881`), `isReadOnlyExplainer` (`text.ts:150`).\n   Case: the prompt `make no changes to any file, just report what you find` is a plain no-edit request. Before the commit the predicate matched `make no changes` and `attachCommand` returned `undefined`; after the commit the predicate returns `false` and `attachCommand` returns `'/create:agent'` for a single-mode mutating route.\n\n   Concrete inputs run (current module vs pre-commit module, node v26.13.0):\n\n   ```\n   prompt: \"make no changes to any file, just report what you find\"\n     post-fix isNoEditRequest = false   attachCommand = \"/create:agent\"\n     pre-fix  isNoEditRequest = true    attachCommand = undefined\n   prompt: \"make no changes to the code, just analyze the parser\"\n     post-fix isNoEditRequest = false   attachCommand = \"/create:agent\"\n     pre-fix  isNoEditRequest = true    attachCommand = undefined\n   ```\n\n   Why P1: a prompt a person would plausibly type is misrouted, which is exactly the operator guide's P1 bar. The old wording (`make no changes` alone) is covered by `NOEDIT4` at `tests/command-attach-guards.vitest.ts:30-34`; the new exclusion removes the object-bearing form from the same class, and no replacement phrase (`just show`, `just list`, `do not change`) is required to be present. The suite still passes 26/26 because no test row exercises a genuine no-edit request that names its object.\n\n   Claim adjudication:\n\n   ```json\n   {\n     \"type\": \"correctness-regression\",\n     \"claim\": \"The added negative lookahead at command-attach.ts:289 disables the shared no-edit gate for genuine no-edit requests phrased as 'make no changes to <object>', so a mutating hub command is offered where it was withheld before the commit.\",\n     \"evidenceRefs\": [\"command-attach.ts:289\", \"command-attach.ts:335\", \"fusion.ts:677\", \"fusion.ts:881\", \"text.ts:150\", \"iterations/iteration-002.md probe output\"],\n     \"counterevidenceSought\": \"Checked every other alternative in NO_EDIT_REQUEST against the failing prompt ('no edits?', 'no changes yet', 'without making changes', 'do not change', 'read-only only', 'only; do not', 'just show', 'just list'); none matches, and no other caller re-checks a scope noun. Also ran the pre-commit module to confirm the guard fired before the change.\",\n     \"alternativeExplanation\": \"The change may be intended to treat every 'make no changes to X' as a scope limit. Rejected: the predicate's own contract is 'Wording that asks for an answer and rules out a change', and the existing NOEDIT4 table treats bare 'make no changes' as that wording. Only a change verb elsewhere in the prompt distinguishes the two readings, and the predicate cannot see one.\",\n     \"finalSeverity\": \"P1\",\n     \"confidence\": 0.9,\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"sed -n '1,60p' specs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/review/lineages/hook-confirm-3b/iterations/iteration-002.md\"}"},"time":{"start":1794597018947,"end":1794597019461}}}}
