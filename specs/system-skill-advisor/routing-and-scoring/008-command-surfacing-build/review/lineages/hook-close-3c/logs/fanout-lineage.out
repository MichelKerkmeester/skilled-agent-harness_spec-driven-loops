\":\"deep-review-config.json#reviewTarget\",\"sourceDigest\":\"0623a8099453f9ffa50493bb1c0a76088780758c1796701cf4d15bdcaed4c581\",\"contentDigest\":\"478e42405235aadf3876568f5ca658202da04d64ba011aafe3d797ebf66940ab\"},\"lineageMode\":\"fresh\",\"maxIterations\":4,\"convergencePolicyVersion\":\"convergence-policy@default\",\"reviewModeContractDigest\":\"a14de252dc32835e8236478e0599256975a59e2ae1b220d657ee3527b99ede56\",\"initialReleaseReadinessState\":\"not-assessed\",\"topic\":\"Command surfacing review pass three - advisor-runtime lineage (shared no-edit gate, scorer gates, subprocess busy scan, routing-accuracy runners, plugin, bridges)\"}}","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"{\"stem\":\"deep_review.run_initialized\",\"scope\":{\"runId\":\"fanout-noedit-close-3c-1794596804847-827gze\",\"sessionId\":\"fanout-noedit-close-3c-1794596804847-827gze\",\"generation\":1},\"data\":{\"target\":{\"targetId\":\"review-target\",\"targetType\":\"directory\",\"artifactRef\":\"deep-review-config.json#reviewTarget\",\"sourceDigest\":\"0623a8099453f9ffa50493bb1c0a76088780758c1796701cf4d15bdcaed4c581\",\"contentDigest\":\"08db358dbbdbadbab146b81bee92bd402436ec1c8395faf1be66f0dca4542dfb\"},\"lineageMode\":\"fresh\",\"maxIterations\":3,\"convergencePolicyVersion\":\"convergence-policy@default\",\"reviewModeContractDigest\":\"a14de252dc32835e8236478e0599256975a59e2ae1b220d657ee3527b99ede56\",\"initialReleaseReadinessState\":\"not-assessed\",\"topic\":\"Command surfacing review pass three closing round - noedit-close-3c lineage (no-edit gate first and deepest, doctor hook check once)\"}}\n=== advisor-runtime-3 run-open ===\n{\"stem\":\"deep_review.run_initialized\",\"scope\":{\"runId\":\"fanout-advisor-runtime-3-1794593402980-zhrui5\",\"sessionId\":\"fanout-advisor-runtime-3-1794593402980-zhrui5\",\"generation\":1},\"data\":{\"target\":{\"targetId\":\"review-target\",\"targetType\":\"directory\",\"artifactRef\":\"deep-review-config.json#reviewTarget\",\"sourceDigest\":\"0623a8099453f9ffa50493bb1c0a76088780758c1796701cf4d15bdcaed4c581\",\"contentDigest\":\"478e42405235aadf3876568f5ca658202da04d64ba011aafe3d797ebf66940ab\"},\"lineageMode\":\"fresh\",\"maxIterations\":4,\"convergencePolicyVersion\":\"convergence-policy@default\",\"reviewModeContractDigest\":\"a14de252dc32835e8236478e0599256975a59e2ae1b220d657ee3527b99ede56\",\"initialReleaseReadinessState\":\"not-assessed\",\"topic\":\"Command surfacing review pass three - advisor-runtime lineage (shared no-edit gate, scorer gates, subprocess busy scan, routing-accuracy runners, plugin, bridges)\"}}"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"cd /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research && cat specs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/review/lineages/noedit-close-3c/prompts/run-open.event.json; echo; echo \\\"=== advisor-runtime-3 run-open ===\\\"; cat specs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/review/lineages/advisor-runtime-3/logs/run-open-event.json\"}"},"time":{"start":1794597428961,"end":1794597430002}}}}
