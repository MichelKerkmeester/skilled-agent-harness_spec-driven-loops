94:   const scopeRunId = basename(dirname(args.stateLog)) || mode;\n295:   const registry = readJson(args.registry);\n296:   const evidence = registryEvidence(mode, registry);\n297:   const lineageLogs = lineageStateLogs(args.artifactDir, mode);\n298:   const parsedState = (lineageLogs.length > 0 ? lineageLogs : [args.stateLog])\n299:     .map(readJsonl)\n300:     .map((entry) => ({ ...entry, records: latestIterationRecords(entry.records) }));\n301:   const stateRecords = parsedState.flatMap((entry) => entry.records);\n302:   const stateParseFailureCount = parsedState.reduce((sum, entry) => sum + entry.parseFailures, 0);\n303:   const totalIterations = stateRecords.filter((record) => record && record.type === 'iteration').length;\n304:   const iterationFindingCount = stateRecords.reduce(\n305:     (sum, record) => sum + countIterationFindings(record, fields),\n306:     0,\n307:   );\n308:   const identifiableFindingGroups = stateRecords.flatMap(\n309:     (record) => collectIterationFindingGroups(record, fields),\n310:   );\n311:   const registryFindingKeys = new Set(evidence.keys);\n312:   const missingStructuredFindingGroups = identifiableFindingGroups\n313:     .filter((keys) => !keys.some((key) => registryFindingKeys.has(key)));\n314:   const missingStructuredFindingCount = countDistinctFindings(\n315:     missingStructuredFindingGroups.map((keys) => keys[0]),\n316:   );\n317:   const identifiableFindingCount = countDistinctFindings(\n318:     identifiableFindingGroups.map((keys) => keys[0]),\n319:   );\n320:   // The root dashboard is a single-executor artifact. Fan-out stores one\n321:   // beside each lineage, so it is required only when the close reads the root log.\n322:   const missingArtifacts = [\n323:     ['registry', args.registry],\n324:     [mode, args.output],\n325:     ...(lineageLogs.length > 0 ? [] : [['dashboard', args.dashboard]]),\n326:   ].filter(([, filePath]) => !hasFile(filePath)).map(([name, filePath]) => ({ name, path: filePath }));\n327: \n328:   const invariantFailures = [];\n329:   if (missingArtifacts.length > 0) invariantFailures.push('missing_synthesis_artifacts');\n330:   if (stateParseFailureCount > 0) invariantFailures.push('state_jsonl_parse_failure');\n331:   if (evidence.registryFindingCount === null) invariantFailures.push(evidence.missingCode);\n332:   if (iterationFindingCount > 0 && (evidence.registryFindingCount ?? 0) === 0) {\n333:     invariantFailures.push('state_findings_not_reflected_in_registry');\n334:   }\n335:   if (\n336:     identifiableFindingCount > 0\n337:     && evidence.registryFindingCount !== null\n338:     && evidence.registryFindingCount < identifiableFindingCount\n339:   ) {\n340:     invariantFailures.push('structured_state_findings_partially_reflected_in_registry');\n341:   }\n342:   if (missingStructuredFindingCount > 0) {\n343:     invariantFailures.push('structured_state_findings_missing_from_registry');\n344:   }\n[Output truncated. Continue reading with offset: 345]","title":"read","metadata":{"metadata":{"truncated":true},"content":[{"type":"text","text":"Read file .skilled/skills/system-deep-loop/runtime/scripts/synthesis-closeout.cjs, lines 255-344\n255: }\n256: \n257: // The artifact directory name is the run-stable token this step can derive\n258: // from the state-log path it was handed.\n259: function buildStem(mode, eventName, scopeRunId) {\n260:   const builders = {\n261:     research: (name) => ({\n262:       stem: `deep_research.${name}`,\n263:       scope: { runId: scopeRunId, lineageId: scopeRunId },\n264:     }),\n265:     review: (name) => ({\n266:       stem: `deep_review.${name}`,\n267:       scope: { runId: scopeRunId, sessionId: scopeRunId },\n268:     }),\n269:   };\n270:   return builders[mode](eventName);\n271: }\n272: \n273: // The state log is a projection the gateway rebuilds. The staged ledger event\n274: // is what survives the next refresh.\n275: function stage(eventDir, scopeRunId, mode, eventRecord) {\n276:   const eventName