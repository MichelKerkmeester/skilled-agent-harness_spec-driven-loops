ester/worktrees/public/352-command-surfacing-research && git -c core.fsmonitor=false show --numstat 860610d783 -- '*holdout-prompts.jsonl' '*command-prompts.jsonl'; echo \\\"NUMSTAT-EXIT=$?\\\"; git -c core.fsmonitor=false show --numstat --format=\\\"\\\" 860610d783 | head\"}"},"time":{"start":1794595749865,"end":1794595750721}}}}
