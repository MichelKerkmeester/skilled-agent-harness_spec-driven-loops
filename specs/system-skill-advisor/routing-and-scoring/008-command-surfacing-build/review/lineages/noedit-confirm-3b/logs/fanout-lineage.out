\"),\n    reviewModeContractDigest: sha(fs.readFileSync(workflowPath)),\n    initialReleaseReadinessState: \"not-assessed\",\n    ...(topic === null ? {} : { topic }),\n  },\n}));\n' \"$LINEAGE/deep-review-config.json\" \".skilled/commands/deep/assets/deep-review-auto.yaml\" > \"$EVENT\" && node .skilled/skills/system-deep-loop/runtime/scripts/append-mode-event.cjs --mode review --run-directory \"$LINEAGE\" --event-json \"$EVENT\"; echo \"EXIT=$?\"; rm -f \"$EVENT\"; echo \"---STATE---\"; cat \"$LINEAGE/deep-review-state.jsonl\""},"output":"{\"ok\":true,\"receipt\":{\"ledger_id\":\"deep-review-ledger\",\"sequence\":1,\"event_id\":\"event-cd0795c4-30bb-4256-a879-bf52dbd5f184\",\"event_type\":\"deep-review.ledger.run-initialized\",\"event_version\":1,\"stream_id\":\"deep-review-ledger\",\"stream_sequence\":1,\"committed_at\":\"2026-11-13T18:41:05.632Z\",\"canonicalEventHash\":\"bf27ac8e2b17c8780916c57b80d111b5aacc1f50eea9c0c716598a26735738a0\",\"recordHash\":\"a0f595a356c7bc0854bc3d33ae6aa238670dd9d3fad97431dbf5fb787d0c90c6\",\"authorizationRef\":{\"audit_ledger_id\":\"deep-review-audit-ledger\",\"audit_sequence\":4,\"audit_record_hash\":\"32e593a5c4ee1e041d11289e37d18a4845890b89b6a18c1069855805b5ebe0ab\",\"decision_id\":\"decision-441509cc-9df4-4877-bb69-989068310f01\",\"decision_digest\":\"a36f65c394e5d9953d54cb23a38dcdbdf5d63191bdcfd095d9ab9bfb71de6052\",\"request_digest\":\"9b10a3da0ef0fea2036e1fc852f172e435aa17ef856d0bf3837ee1b9df2f0477\",\"policy_digest\":\"883e5d03486b26c23ecdb48a893d8b0db0d8e2e7125e0847705bfd4a2b1a4500\",\"authority_epoch\":1,\"fence_token\":1},\"ledgerId\":\"deep-review-ledger\",\"eventId\":\"event-cd0795c4-30bb-4256-a879-bf52dbd5f184\",\"eventType\":\"deep-review.ledger.run-initialized\",\"eventVersion\":1,\"streamId\":\"deep-review-ledger\",\"streamSequence\":1,\"committedAt\":\"2026-11-13T18:41:05.632Z\"},\"projectionRefreshed\":true,\"projectionError\":null}\nEXIT=0\n---STATE---\n{\"type\":\"config\",\"topic\":\"Command surfacing review p