} : { topic }),\\n  },\\n}));\\n' \\\"$LINEAGE/deep-review-config.json\\\" \\\".skilled/commands/deep/assets/deep-review-auto.yaml\\\" > \\\"$EVENT\\\" && node .skilled/skills/system-deep-loop/runtime/scripts/append-mode-event.cjs --mode review --run-directory \\\"$LINEAGE\\\" --event-json \\\"$EVENT\\\"; echo \\\"EXIT=$?\\\"; rm -f \\\"$EVENT\\\"; echo \\\"---STATE---\\\"; cat \\\"$LINEAGE/deep-review-state.jsonl\\\"\"}"},"time":{"start":1794595261371,"end":1794595265942}}}}
