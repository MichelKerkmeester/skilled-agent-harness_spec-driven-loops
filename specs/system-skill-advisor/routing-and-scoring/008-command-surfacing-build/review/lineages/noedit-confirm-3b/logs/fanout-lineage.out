eFlagSkipsScript(flag)) return false;\n     index += NODE_FLAGS_WITH_ARGUMENT.has(flag) ? 2 : 1;\n   }\n   return index < rest.length && rest[index].text.endsWith(marker);\ndiff --git a/.skilled/commands/doctor/scripts/tests/hook-wiring-check.test.cjs b/.skilled/commands/doctor/scripts/tests/hook-wiring-check.test.cjs\nindex 23292abfdf..2df0a77739 100644\n--- a/.skilled/commands/doctor/scripts/tests/hook-wiring-check.test.cjs\n+++ b/.skilled/commands/doctor/scripts/tests/hook-wiring-check.test.cjs\n@@ -226,6 +226,7 @@ test('skips a runtime whose folder is absent', (t) => {\n for (const [label, build] of [\n   ['env unsets a variable first', (m) => `env -u AI_SESSION_CHILD node ${m}`],\n   ['node preloads a module', (m) => `node -r ./preload.cjs ${m}`],\n+  ['node preloads a module attached to the flag', (m) => `node -r./preload.cjs ${m}`],\n   ['the command runs in a subshell', (m) => `(node ${m})`],\n   ['the command runs in a brace group', (m) => `{ node ${m}; }`],\n   ['exec replaces the shell', (m) => `exec node ${m}`],\n@@ -248,6 +249,9 @@ for (const [label, build] of [\n   ['a quote never closes', (m) => `echo \"x; node ${m}`],\n   ['node only checks the syntax', (m) => `node --check ${m}`],\n   ['node evaluates inline code', (m) => `node -e \"1\" ${m}`],\n+  ['node evaluates code attached to the flag', (m) => `node -e1 ${m}`],\n+  ['node evaluates code given with an equals sign', (m) => `node --eval=1 ${m}`],\n+  ['node prints an expression given with an equals sign', (m) => `node --print=1 ${m}`],\n   ['the launch sits in a comment', (m) => `true # ; node ${m}`],\n   ['a shell script takes its own -c argument', (m) => `bash ./x.sh -c \"node ${m}\"`],\n ]) {\ndiff --git a/.skilled/skills/system-skill-advisor/runtime/lib/command-attach.ts b/.skilled/skills/system-skill-advisor/runtime/lib/command-attach.ts\nindex d4138fcbc2..747b35f2ab 100644\n--- a/.skilled/skills/system-skill-advisor/runtime/lib/command-attach.ts\n+++ b/.skilled/skills/system-skill-advisor/runtime/lib/command-attach.ts\n@@ -286,7 +286,7 @@ const DEPTH_REQUEST = new RegExp(`\\\\b(?:${DEPTH_WORDING.map(escapePhrase).join('\n \n // Wording that asks for an answer and rules out a change. One pattern serves\n // every gate that has to honour it, so a new gate cannot drift from the first.\n-export const NO_EDIT_REQUEST = /\\b(no edits?|make no changes|no changes yet|without making changes|(?:do not|don't) (change|edit|modify|touch)|read-only only|no edits yet|only; do not|just show|just list)\\b/;\n+export const NO_EDIT_REQUEST = /\\b(no edits?|make no changes(?! (?:to|in)\\b)|no changes yet|without making changes|(?:do not|don't) (change|edit|modify|touch)|read-only only|no edits yet|only; do not|just show|just list)\\b/;\n \n // Many keyboards type the contraction with a curly apostrophe, so the text is\n // folded to the straight form before the pattern reads it.\ndiff --git a/.skilled/skills/system-skill-advisor/runtime/tests/command-attach-guards.vitest.ts b/.skilled/skills/system-skill-advisor/runtime/tests/command-attach-guards.vitest.ts\nindex 66e305f486..2f4a049c44 100644\n--- a/.skilled/skills/system-skill-advisor/runtime/tests/command-attach-guards.vitest.ts\n+++ b/.skilled/skills/system-skill-advisor/runtime/tests/command-attach-guards.vitest.ts\n@@ -70,6 +70,8 @@ describe('command attach on a no-edit prompt', () => {\n     'refactor the parser so there are no changes to its public api',\n     'fix the flaky test and make sure there are no changes in behaviour',\n     'create an agent called invoice-parser with no changes to existing agents',\n+    'refactor the parser and make no changes to its public api',\n+    'rename the helper but make no changes in the tests',\n   ])('keeps a change request that limits its scope: %s', (prompt) => {\n     expect(isNoEditRequest(prompt)).toBe(false);\n   });\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"cd /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research && git -c core.fsmonitor=false show 860610d783 --stat && echo \\\"=====DIFF=====\\\" && git -c core.fsmonitor=false show 860610d783 -- .skilled\"}"},"time":{"start":1794595115511,"end":1794595116284}}}}
