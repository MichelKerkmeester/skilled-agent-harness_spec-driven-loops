((entry) => (\n    entry.startsWith('phrase:')\n    || entry.startsWith('explicit:')\n    || entry.startsWith('author:')\n    || entry.includes(skillId)\n    || entry.includes('loop')\n    || entry.includes('write-')\n  ));\n}\n\nexport function readOnlyRouteAllowed(promptLower: string, skill: SkillProjection): boolean {\n  const skillId = skill.id;\n  if (isNoEditRequest(promptLower)) {\n    return false;\n  }\n  // The explainer floor exists to stop an ambiguous read-only question from\n  // routing anywhere. Naming the skill removes the ambiguity: the caller has\n  // already chosen, and a read-only verb does not undo that choice. Without\n  // this, an explicit request is answered with an abstention while the same\n  // sentence phrased with a write verb routes fine.\n  if (promptMentionsSkill(promptLower, skill)) {\n    return true;\n  }\n  // A command whose route only reads (a report, a status check) is the answer\n  // to a list or show question, so its own trigger phrase lifts it off the\n  // floor. A mutating command never carries the flag and stays gated.\n  if (skill.kind === 'command' && 'readOnly' in skill && skill.readOnly === true\n    && skill.keywords.some((phrase) => matchesPhraseBoundary(promptLower, phrase.toLowerCase()))) {\n    return true;\n  }\n  if (skillId === 'sk-code' && /\\b(compare|audit|review)\\b/.test(promptLower)\n=== fusion 870-890 ===\n// A question that only wants an answer must not be handed a command that\n// changes things, however close the meaning. Phrase matches are already held to\n// this by the read-only confidence floor, and a meaning match lifts confidence\n// past that floor, so it has to ask the same question itself. A command whose\n// route only reads stays eligible for a plain explainer, because running it is\n// the answer. An explicit no-edit request rules out every command.\nexport function commandMeaningEligible(\n  promptLower: string,\n  readOnlyExplainer: boolean,\n  skill: SkillProjection | undefined,\n): boolean {\n  if (isNoEditRequest(promptLower)) return false;\n  if (!readOnlyExplainer) return true;\n  return skill !== undefined && skill.kind === 'command' && 'readOnly' in skill && skill.readOnly === true;\n}\n\nexport function requireCommandPhraseAnchor(\n  ranked: readonly AdvisorScoredRecommendation[],\n  confidenceThreshold: number = DEFAULT_CONFIDENCE_THRESHOLD,\n  meaningPassed: Set<string> = new Set(),\n  meaningEligible: (skillId: string) => boolean = () => true,\n): AdvisorScoredRecommendation[] {\n  const cosineByCommandId = new Map<string, number>();\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"        break;\n      }\n    }\n  }\n  return Math.min(hits / Math.max(3, denominatorBasis), 1);\n}\n\nexport function isReadOnlyExplainer(promptLower: string): boolean {\n  const readOnly = /\\b(analyze|explain|inspect|summarize|list|show|tell|compare|decompose)\\b/.test(promptLower);\n  const skillSurface = /\\b(review|audit|deep[- ]research|deep[- ]review|semantic search|figma|clickup|chrome devtools|git worktree|prompt)\\b/.test(promptLower);\n  const explicitNoWrite = isNoEditRequest(promptLower);\n  if (skillSurface) return false;\n  if (readOnly && explicitNoWrite) return true;\n  if (/^\\s*(analyze|explain|inspect|summarize|list|show|tell|compare|decompose)\\b/.test(promptLower)\n    && !/\\b(then|and)\\s+(add|build|change|configure|create|edit|fix|generate|implement|modify|move|patch|refactor|rename|replace|run|save|start|update|write)\\b/.test(promptLower)) {\n    return true;\n  }\n  const write = /\\b(add|build|change|configure|create|disable[sd]?|edit|enable[sd]?|execute|fix|generate|implement|modify|patch|refactor|rename|re-?run|run|save|switch (?:on|off)|turn (?:on|off)|update|write)\\b/.test(promptLower);\n  return readOnly && !write && !skillSurface;\n}\n=== fusion 665-690 ===\n  return explicit.evidence.some((entry) => (\n    entry.startsWith('phrase:')\n    || 