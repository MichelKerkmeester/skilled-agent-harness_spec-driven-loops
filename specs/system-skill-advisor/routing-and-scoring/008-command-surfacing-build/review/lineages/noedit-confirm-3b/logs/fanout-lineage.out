{"type":"tool_use","timestamp":1794595146373,"sessionID":"ses_e29ccdea6ffe1z7wL2sWcEOG4A","part":{"partID":"prt_1d634c8d9001NIm5tHqJnEqNQ9","sessionID":"ses_e29ccdea6ffe1z7wL2sWcEOG4A","messageID":"msg_1d6347327001WlYSl1NFNSV0jw","type":"tool","id":"call_e1f02cf1675e423f9ea1a59f","tool":"read","state":{"status":"completed","input":{"path":".skilled/commands/doctor/scripts/hook-wiring-check.cjs","offset":180,"limit":190},"output":"Read file .skilled/commands/doctor/scripts/hook-wiring-check.cjs, lines 180-357\n180:       continue;\n181:     }\n182:     if (/\\s/.test(char)) {\n183:       flush();\n184:       continue;\n185:     }\n186:     text += char;\n187:     started = true;\n188:   }\n189:   flush();\n190:   return words;\n191: }\n192: \n193: function simpleCommands(words) {\n194:   const commands = [];\n195:   let current = [];\n196:   for (const word of words) {\n197:     if (word.separator) {\n198:       if (current.length > 0) commands.push(current);\n199:       current = [];\n200:     } else {\n201:       current.push(word);\n202:     }\n203:   }\n204:   if (current.length > 0) commands.push(current);\n205:   return commands;\n206: }\n207: \n208: function collectCommands(node, commands) {\n209:   if (Array.isArray(node)) {\n210:     for (const entry of node) collectCommands(entry, commands);\n211:   } else if (node && typeof node === 'object') {\n212:     if (node.type === 'command' && typeof node.command === 'string') commands.push(node.command);\n213:     if (Array.isArray(node.hooks)) collectCommands(node.hooks, commands);\n214:   }\n215:   return commands;\n216: }\n217: \n218: const ASSIGNMENT = /^[A-Za-z_][A-Za-z0-9_]*=/;\n219: \n220: // Flags whose next word is their own argument, so that word is not the command.\n221: const ENV_FLAGS_WITH_ARGUMENT = new Set(['-u', '--unset', '-C', '--chdir']);\n222: const NODE_FLAGS_WITH_ARGUMENT = new Set([\n223:   '-r', '--require', '--import', '--loader', '--experimental-loader', '-C', '--conditions',\n224: ]);\n225: // Flags that make node do something other than run the script it is given.\n226: const NODE_FLAGS_WITHOUT_RUN = new Set([\n227:   '-c', '--check', '-e', '--eval', '-p', '--print', '-v', '--version', '-h', '--help',\n228: ]);\n229: // A flag can carry its value in the same word, after an equals sign for a long\n230: // flag and directly after the letter for a short one, so the name is read first.\n231: function nodeFlagSkipsScript(flag) {\n232:   if (flag.startsWith('--')) return NODE_FLAGS_WITHOUT_RUN.has(flag.split('=')[0]);\n233:   if (NODE_FLAGS_WITHOUT_RUN.has(flag)) return true;\n234:   // A short preload flag takes the rest of its word as the module name.\n235:   if (/^-[rC]/.test(flag)) return false;\n236:   return /^-[a-zA-Z]*[cepvh]/.test(flag);\n237: }\n238: \n239: // Words that open a group or hand over the shell and leave the command after them.\n240: const COMMAND_PREFIXES = new Set(['{', 'exec']);\n241: \n242: function isNodeExecutable(token) {\n243:   return token === 'node' || token.endsWith('/node');\n244: }\n245: \n246: function isEnvExecutable(token) {\n247:   return token === 'env' || token.endsWith('/env');\n248: }\n249: \n250: function isShellExecutable(token) {\n251:   return ['bash', 'sh', 'zsh'].some((name) => token === name || token.endsWith(`/${name}`));\n252: }\n253: \n254: // env launches the command after its own assignments and flags, so those words\n255: // say nothing about what runs. The same holds for a leading assignment.\n256: function commandWords(words) {\n257:   let index = 0;\n258:   while (index < words.length && COMMAND_PREFIXES.has(words[index].text)) index += 1;\n259:   while (index < words.length && ASSIGNMENT.test(words[index].text)) index += 1;\n260:   if (index < words.length && isEnvExecutable(words[index].text)) {\n261:     index += 1;\n262:     while (index < words.length\n263:       && (ASSIGNMENT.test(words[index].text) || words[index].text.startsWith('-'))) {\n264:       index += ENV_FLAGS_WITH_ARGUMENT.has(words[index].text) ? 2 : 1;\n265:     }\n266:   }\n267:   return words.slice(index);\n268: }\n269: \n270: function runsNodeOnMarker(words, marker) {\n271:   const rest = commandWords(words);\n272:   if (rest.length === 0 || !isNodeExecutable(rest[0].text)) return false;\n273:   let index = 1;\n274:   while (index < rest.length && rest[index].text.startsWith('-')) {\n275:     const flag = rest[index].text;\n276:     if (nodeFlagSkipsScript(flag)) return false;\n277:     index += NODE_FLAGS_WITH_ARGUMENT.has(flag) ? 2 : 1;\n278:   }\n279:   return index < rest.length && rest[index].text.endsWith(marker);\n280: }\n281: \n282: // bash -c and its login, sh and zsh forms hand the next word to a shell as a\n283: // script, so that word is read again as commands. No other word is.\n284: function scriptWord(words) {\n285:   const rest = commandWords(words);\n286:   if (rest.length < 2 || !isShellExecutable(rest[0].text)) return null;\n287:   // The first word that is not a flag is a script file, and what follows it\n288:   // belongs to that script.\n289:   for (let index = 1; index < rest.length - 1; index += 1) {\n290:     const flag = rest[index].text;\n291:     if (!flag.startsWith('-')) return null;\n292:     if (!flag.startsWith('--') && flag.slice(1).includes('c')) {\n293:       return rest[index + 1];\n294:     }\n295:   }\n296:   return null;\n297: }\n298: \n299: // An argument that only names node, as `echo node <script>` does, runs\n300: // nothing, so node must stand where a shell starts a command.\n301: function runsMarker(command, marker, depth = 0) {\n302:   return simpleCommands(readWords(command)).some((words) => {\n303:     if (runsNodeOnMarker(words, marker)) return true;\n304:     if (depth >= 2) return false;\n305:     const script = scriptWord(words);\n306:     return script !== null && runsMarker(script.text, marker, depth + 1);\n307:   });\n308: }\n309: \n310: function inspect(runtime, root) {\n311:   const file = path.join(root, runtime.file);\n312:   let document;\n313:   try {\n314:     document = JSON.parse(fs.readFileSync(file, 'utf8'));\n315:   } catch {\n316:     return { runtime: runtime.id, file: runtime.file, status: 'hook-missing' };\n317:   }\n318:   const payload = eventPayload(document, runtime.event);\n319:   const wired = collectCommands(payload, []).some((command) => runsMarker(command, runtime.marker));\n320:   return { runtime: runtime.id, file: runtime.file, status: wired ? 'ok' : 'hook-missing' };\n321: }\n322: \n323: // ─────────────────────────────────────────────────────────────────────────────\n324: // 4. MAIN\n325: // ─────────────────────────────────────────────────────────────────────────────\n326: \n327: function main(argv) {\n328:   const opts = parseArgs(argv);\n329:   const checks = RUNTIMES.map((runtime) => {\n330:     if (!fs.existsSync(path.join(opts.root, runtime.dir))) {\n331:       return { runtime: runtime.id, file: runtime.file, status: 'skipped' };\n332:     }\n333:     return inspect(runtime, opts.root);\n334:   });\n335: \n336:   if (opts.json) {\n337:     process.stdout.write(`${JSON.stringify({ root: opts.root, checks }, null, 2)}\\n`);\n338:   } else {\n339:     for (const check of checks) {\n340:       if (check.status === 'ok') process.stdout.write(`ok ${check.runtime}\\n`);\n341:       else if (check.status === 'hook-missing') process.stdout.write(`hook-missing ${check.runtime} ${check.file}\\n`);\n342:     }\n343:   }\n344: \n345:   return checks.some((check) => check.status === 'hook-missing') ? 1 : 0;\n346: }\n347: \n348: if (require.main === module) {\n349:   try {\n350:     process.exitCode = main(process.argv.slice(2));\n351:   } catch (err) {\n352:     process.stderr.write(`hook-wiring-check: ${err && err.message ? err.message : String(err)}\\n`);\n353:     process.exitCode = 2;\n354:   }\n355: }\n356: \n357: module.exports = { main, eventPayload };","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file .skilled/commands/doctor/scripts/hook-wiring-check.cjs, lines 180-357\n180:       continue;\n181:     }\n182:     if (/\\s/.test(char)) {\n183:       flush();\n184:       continue;\n185:     }\n186:     text += char;\n187:     started = true;\n188:   }\n189:   flush();\n190:   return words;\n191: }\n192: \n193: function simpleCommands(words) {\n194:   const commands = [];\n195:   let current = [];\n196:   for (const word of words) {\n197:     if (word.separator) {\n198:       if (current.length > 0) commands.push(current);\n199:       current = [];\n200:     } else {\n201:       current.push(word);\n202:     }\n203:   }\n204:   if (current.length > 0) commands.push(current);\n205:   return commands;\n206: }\n207: \n208: function collectCommands(node, commands) {\n209:   if (Array.isArray(node)) {\n210:     for (const entry of node) collectCommands(entry, commands);\n211:   } else if (node && typeof node === 'object') {\n212:     if (node.type === 'command' && typeof node.command === 'string') commands.push(node.command);\n213:     if (Array.isArray(node.hooks)) collectCommands(node.hooks, commands);\n214:   }\n215:   return commands;\n216: }\n217: \n218: const ASSIGNMENT = /^[A-Za-z_][A-Za-z0-9_]*=/;\n219: \n220: // Flags whose next word is their own argument, so that word is not the command.\n221: const ENV_FLAGS_WITH_ARGUMENT = new Set(['-u', '--unset', '-C', '--chdir']);\n222: const NODE_FLAGS_WITH_ARGUMENT = new Set([\n223:   '-r', '--require', '--import', '--loader', '--experimental-loader', '-C', '--conditions',\n224: ]);\n225: // Flags that make node do something other than run the script it is given.\n226: const NODE_FLAGS_WITHOUT_RUN = new Set([\n227:   '-c', '--check', '-e', '--eval', '-p', '--print', '-v', '--version', '-h', '--help',\n228: ]);\n229: // A flag can carry its value in the same word, after an equals sign for a long\n230: // flag and directly after the letter for a short one, so the name is read first.\n231: function nodeFlagSkipsScript(flag) {\n232:   if (flag.startsWith('--')) return NODE_FLAGS_WITHOUT_RUN.has(flag.split('=')[0]);\n233:   if (NODE_FLAGS_WITHOUT_RUN.has(flag)) return true;\n234:   // A short preload flag takes the rest of its word as the module name.\n235:   if (/^-[rC]/.test(flag)) return false;\n236:   return /^-[a-zA-Z]*[cepvh]/.test(flag);\n237: }\n238: \n239: // Words that open a group or hand over the shell and leave the command after them.\n240: const COMMAND_PREFIXES = new Set(['{', 'exec']);\n241: \n242: function isNodeExecutable(token) {\n243:   return token === 'node' || token.endsWith('/node');\n244: }\n245: \n246: function isEnvExecutable(token) {\n247:   return token === 'env' || token.endsWith('/env');\n248: }\n249: \n250: function isShellExecutable(token) {\n251:   return ['bash', 'sh', 'zsh'].some((name) => token === name || token.endsWith(`/${name}`));\n252: }\n253: \n254: // env launches the command after its own assignments and flags, so those words\n255: // say nothing about what runs. The same holds for a leading assignment.\n256: function commandWords(words) {\n257:   let index = 0;\n258:   while (index < words.length && COMMAND_PREFIXES.has(words[index].text)) index += 1;\n259:   while (index < words.length && ASSIGNMENT.test(words[index].text)) index += 1;\n260:   if (index < words.length && isEnvExecutable(words[index].text)) {\n261:     index += 1;\n262:     while (index < words.length\n263:       && (ASSIGNMENT.test(words[index].text) || words[index].text.startsWith('-'))) {\n264:       index += ENV_FLAGS_WITH_ARGUMENT.has(words[index].text) ? 2 : 1;\n265:     }\n266:   }\n267:   return words.slice(index);\n268: }\n269: \n270: function runsNodeOnMarker(words, marker) {\n271:   const rest = commandWords(words);\n272:   if (rest.length === 0 || !isNodeExecutable(rest[0].text)) return false;\n273:   let index = 1;\n274:   while (index < rest.length && rest[index].text.startsWith('-')) {\n275:     const flag = rest[index].text;\n276:     if (nodeFlagSkipsScript(flag)) return false;\n277:     index += NODE_FLAGS_WITH_ARGUMENT.has(flag) ? 2 : 1;\n278:   }\n279:   return index < rest.length && rest[index].text.endsWith(marker);\n280: }\n281: \n282: // bash -c and its login, sh and zsh forms hand the next word to a shell as a\n283: // script, so that word is read again as commands. No other word is.\n284: function scriptWord(words) {\n285:   const rest = commandWords(words);\n286:   if (rest.length < 2 || !isShellExecutable(rest[0].text)) return null;\n287:   // The first word that is not a flag is a script file, and what follows it\n288:   // belongs to that script.\n289:   for (let index = 1; index < rest.length - 1; index += 1) {\n290:     const flag = rest[index].text;\n291:     if (!flag.startsWith('-')) return null;\n292:     if (!flag.startsWith('--') && flag.slice(1).includes('c')) {\n293:       return rest[index + 1];\n294:     }\n295:   }\n296:   return null;\n297: }\n298: \n299: // An argument that only names node, as `echo node <script>` does, runs\n300: // nothing, so node must stand where a shell starts a command.\n301: function runsMarker(command, marker, depth = 0) {\n302:   return simpleCommands(readWords(command)).some((words) => {\n303:     if (runsNodeOnMarker(words, marker)) return true;\n304:     if (depth >= 2) return false;\n305:     const script = scriptWord(words);\n306:     return script !== null && runsMarker(script.text, marker, depth + 1);\n307:   });\n308: }\n309: \n310: function inspect(runtime, root) {\n311:   const file = path.join(root, runtime.file);\n312:   let document;\n313:   try {\n314:     document = JSON.parse(fs.readFileSync(file, 'utf8'));\n315:   } catch {\n316:     return { runtime: runtime.id, file: runtime.file, status: 'hook-missing' };\n317:   }\n318:   const payload = eventPayload(document, runtime.event);\n319:   const wired = collectCommands(payload, []).some((command) => runsMarker(command, runtime.marker));\n320:   return { runtime: runtime.id, file: runtime.file, status: wired ? 'ok' : 'hook-missing' };\n321: }\n322: \n323: // ─────────────────────────────────────────────────────────────────────────────\n324: // 4. MAIN\n325: // ─────────────────────────────────────────────────────────────────────────────\n326: \n327: function main(argv) {\n328:   const opts = parseArgs(argv);\n329:   const checks = RUNTIMES.map((runtime) => {\n330:     if (!fs.existsSync(path.join(opts.root, runtime.dir))) {\n331:       return { runtime: runtime.id, file: runtime.file, status: 'skipped' };\n332:     }\n333:     return inspect(runtime, opts.root);\n334:   });\n335: \n336:   if (opts.json) {\n337:     process.stdout.write(`${JSON.stringify({ root: opts.root, checks }, null, 2)}\\n`);\n338:   } else {\n339:     for (const check of checks) {\n340:       if (check.status === 'ok') process.stdout.write(`ok ${check.runtime}\\n`);\n341:       else if (check.status === 'hook-missing') process.stdout.write(`hook-missing ${check.runtime} ${check.file}\\n`);\n342:     }\n343:   }\n344: \n345:   return checks.some((check) => check.status === 'hook-missing') ? 1 : 0;\n346: }\n347: \n348: if (require.main === module) {\n349:   try {\n350:     process.exitCode = main(process.argv.slice(2));\n351:   } catch (err) {\n352:     process.stderr.write(`hook-wiring-check: ${err && err.message ? err.message : String(err)}\\n`);\n353:     process.exitCode = 2;\n354:   }\n355: }\n356: \n357: module.exports = { main, eventPayload };"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\".skilled/commands/doctor/scripts/hook-wiring-check.cjs\",\"offset\":180,\"limit\":190}"},"time":{"start":1794595145945,"end":1794595146373}}}}
