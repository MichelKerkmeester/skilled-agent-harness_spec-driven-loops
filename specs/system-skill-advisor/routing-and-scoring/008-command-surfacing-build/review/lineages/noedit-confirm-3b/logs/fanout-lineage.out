  \"reasoningEffort\": null,\n    \"serviceTier\": null,\n    \"sandboxMode\": null,\n    \"timeoutSeconds\": 900\n  },\n  \"mode\": \"review\",\n  \"reviewTarget\": \"specs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build\",\n  \"reviewTargetType\": \"spec-folder\",\n  \"reviewDimensions\": [\n    \"correctness\",\n    \"security\",\n    \"traceability\",\n    \"maintainability\"\n  ],\n  \"reviewFocus\": \"Code review of command surfacing. Scope: specs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/review/review-scope.txt lists the changed files, one per line as area TAB path. Review the files whose area equals your lineage label (last folder of config.fanout_lineage_artifact_dir), plus shared docs that describe them. Every finding is P0, P1 or P2 with file:line. Check: behaviour on claude, codex, opencode, pi, devin and dsh; safety of offering a mutating command; holdout hygiene, so no tune, fix or report path reads or leaks holdout rows; docs that disagree with code. Never read or print holdout prompt text (split holdout in command-prompts.jsonl, or holdout-prompts.jsonl): counts only. The reviewer changes no code and writes only inside its lineage folder.\",\n  \"resource_map_present\": false,\n  \"resource_map\": {\n    \"emit\": true\n  },\n  \"severityThreshold\": \"P2\",\n  \"crossReference\": {\n    \"core\": [\n      \"spec_code\",\n      \"checklist_evidence\"\n    ],\n    \"overlay\": [\n      \"skill_agent\",\n      \"agent_cross_runtime\",\n      \"feature_catalog_code\",\n      \"playbook_capability\"\n    ]\n  },\n  \"qualityGateThreshold\": true,\n  \"runtimeCapabilityResolver\": \".skilled/skills/system-deep-loop/deep-review/scripts/runtime-capabilities.cjs\",\n  \"reducerScriptPath\": \".skilled/skills/system-deep-loop/runtime/scripts/reduce-state.cjs\",\n  \"fileProtection\": {\n    \"deep-review-config.json\": \"immutable\",\n    \"deep-review-state.jsonl\": \"append-only\",\n    \"deep-review-findings-registry.json\": \"auto-generated\",\n    \"deep-review-strategy.md\": \"mutable\",\n    \"deep-review-dashboard.md\": \"auto-generated\",\n    \".deep-review-pause\": \"operator-controlled\",\n    \"review-report.md\": \"mutable\",\n    \"review-report-v*.md\": \"write-once\",\n    \"iteration-*.md\": \"write-once\"\n  },\n  \"reducer\": {\n    \"enabled\": true,\n    \"inputs\": [\n      \"latestJSONLDelta\",\n      \"newIterationFile\",\n      \"priorReducedState\"\n    ],\n    \"outputs\": [\n      \"findingsRegistry\",\n      \"dashboardMetrics\",\n      \"strategyUpdates\"\n    ],\n    \"metrics\": [\n      \"dimensionsCovered\",\n      \"findingsBySeverity\",\n      \"openFindings\",\n      \"resolvedFindings\",\n      \"convergenceScore\"\n    ]\n  },\n  \"_optimizerManaged\": {\n    \"description\": \"Fields managed by the offline loop optimizer (042.004). See optimizer-manifest.json for the canonical tunable/locked field registry.\",\n    \"manifestPath\": \".skilled/skills/system-spec-kit/runtime/cli/optimizer/optimizer-manifest.json\",\n    \"tunableFields\": [\n      \"convergenceThreshold\",\n      \"stuckThreshold\",\n      \"maxIterations\"\n    ],\n    \"lockedFields\": [\n      \"lineageMode\",\n      \"reducer\",\n      \"fileProtection\",\n      \"sessionId\",\n      \"mode\",\n      \"reviewDimensions\",\n      \"antiConvergence.convergenceMode\",\n      \"antiConvergence.stopPolicy\"\n    ],\n    \"promotionMode\": \"advisory-only\"\n  },\n  \"fanout\": {\n    \"executors\": [\n      {\n        \"kind\": \"cli-opencode\",\n        \"model\": \"opencode-go/deepseek-v4.1-flash\",\n        \"reasoningEffort\": \"max\",\n        \"iterations\": 5,\n        \"label\": \"scorer-attach\",\n        \"count\": 1\n      },\n      {\n        \"kind\": \"cli-opencode\",\n        \"model\": \"opencode-go/deepseek-v4.1-flash\",\n        \"reasoningEffort\": \"max\",\n        \"iterations\": 5,\n        \"label\": \"render-hooks-plugin\",\n        \"count\": 1\n      },\n      {\n        \"kind\": \"cli-opencode\",\n        \"model\": \"opencode-go/deepseek-v4.1-flash\",\n        \"reasoningEffort\": \"max\",\n        \"iterations\": 5,\n        \"label\": \"accuracy-runner\",\n        \"count\": 1\n      },\n      {\n        \"kind\": \"cli-opencode\",\n        \"model\": \"opencode-go/deepseek-v4.1-flash\",\n        \"reasoningEffort\": \"max\",\n        \"iterations\": 5,\n        \"label\": \"doctor-install\",\n        \"count\": 1\n      }\n    ],\n    \"concurrency\": 4\n  }\n}\n---SCOPE3B---\n# git diff --name-only 0a6638f2ab..HEAD -- .skilled .opencode ; HEAD 860610d783cb75e496eb97cd0808355512e547a2\n# area<TAB>path ; area = lineage label without its -3 suffix\ndoctor-docs\t.skilled/commands/doctor/scripts/hook-wiring-check.cjs\ndoctor-docs\t.skilled/commands/doctor/scripts/tests/hook-wiring-check.test.cjs\nadvisor-runtime\t.skilled/skills/system-skill-advisor/runtime/lib/command-attach.ts\nadvisor-runtime\t.skilled/skills/system-skill-advisor/runtime/tests/command-attach-guards.vitest.ts\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"{\"executors\":[{\"kind\":\"cli-opencode\",\"model\":\"opencode-go/deepseek-v4.1-flash\",\"reasoningEffort\":\"max\",\"iterations\":3,\"label\":\"hook-confirm-3b\",\"count\":1},{\"kind\":\"cli-opencode\",\"model\":\"opencode-go/deepseek-v4.1-flash\",\"reasoningEffort\":\"max\",\"iterations\":3,\"label\":\"noedit-confirm-3b\",\"count\":1}],\"concurrency\":2}\n---PARENT CONFIG---\n{\n  \"topic\": \"Review: specs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build\",\n  \"sessionId\": \"1794550137809-1ecgc7\",\n  \"parentSessionId\": null,\n  \"lineageMode\": \"new\",\n  \"generation\": 1,\n  \"continuedFromRun\": null,\n  \"migrationWindowEndsAt\": \"\",\n  \"maxIterations\": 5,\n  \"convergenceThreshold\": 0.1,\n  \"antiConvergence\": {\n    \"minIterations\": 2,\n    \"convergenceMode\": \"default\",\n    \"stopPolicy\": \"fail-closed\"\n  },\n  \"stopPolicy\": \"convergence\",\n  \"stuckThreshold\": 2,\n  \"maxDurationMinutes\": 120,\n  \"maxToolCallsPerIteration\": 12,\n  \"maxMinutesPerIteration\": 10,\n  \"progressiveSynthesis\": false,\n  \"specFolder\": \"specs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build\",\n  \"createdAt\": \"2026-11-13T06:08:57.809Z\",\n  \"status\": \"initialized\",\n  \"releaseReadinessState\": \"in-progress\",\n  \"executionMode\": \"auto\",\n  \"executor\": {\n    \"kind\": \"native\",\n    \"model\": null,\n    \"reasoningEffort\": null,\n    \"serviceTier\": null,\n    \"sandboxMode\": null,\n    \"timeoutSeconds\": 900\n  },\n  \"mode\": \"review\",\n  \"reviewTarget\": \"specs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build\",\n  \"reviewTargetType\": \"spec-folder\",\n  \"reviewDimensions\": [\n    \"correctness\",\n    \"security\",\n    \"traceability\",\n    \"maintainability\"\n  ],\n  \"reviewFocus\": \"Code review of command surfacing. Scope: specs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/review/review-scope.txt lists the changed files, one per line as area TAB path. Review the files whose area equals your lineage label (last folder of config.fanout_lineage_artifact_dir), plus shared docs that describe them. Every finding is P0, P1 or P2 with file:line. Check: behaviour on claude, codex, opencode, pi, devin and dsh; safety of offering a mutating command; holdout hygiene, so no tune, fix or report path reads or leaks holdout rows; docs that disagree with code. Never read or print holdout prompt text (split holdout in command-prompts.jsonl, or holdout-prompts.jsonl): counts only. The reviewer changes no code and writes only inside its lineage folder.\",\n  \"resource_map_present\": false,\n  \"resource_map\": {\n    \"emit\": true\n  },\n  \"severityThreshold\": \"P2\",\n  \"crossReference\": {\n    \"core\": [\n      \"spec_code\",\n    