ss, run /speckit:plan\", \"/speckit:plan\"],\n  [\"never mind just run /speckit:save\", \"/speckit:save\"],\n  [\"not sure, use /create:readme\", \"/create:readme\"],\n  [\"without asking, run /speckit:complete\", \"/speckit:complete\"],\n  [\"can you run /speckit:plan?\", \"/speckit:plan\"],\n];\nconst EXTRA = [\n  [\"do not run /create:agent or /create:readme\", \"/create:readme\"],\n  [\"skip /create:agent or the /create:readme command\", \"/create:readme\"],\n];\nconst PLAIN = [...REFUSE8, ...QUESTION2, ...REQUEST6, ...CONTROL5, ...EXTRA];\nconst NOT_IN_PLAIN = [\n  [\"should I run /create:agent or /create:readme?\", \"/create:readme\"],\n  [\"is /create:agent or /create:readme better?\", \"/create:readme\"],\n  [\"what does /create:agent or /create:readme do?\", \"/create:readme\"],\n  [\"is /speckit:resume safe to run twice\", \"/speckit:resume\"],\n  [\"Is the /doctor:update command safe?\", \"/doctor:update\"],\n  [\"stop using /create:changelog for this, write the changelog entry by hand\", \"/create:changelog\"],\n  [\"I have not run /speckit:plan yet, please start it for the login feature\", \"/speckit:plan\"],\n  [\"do not run /speckit:complete, run /speckit:plan, then run it for the auth module\", \"/speckit:complete\"],\n  [\"never use **/deep:review** here\", \"/deep:review\"],\n  [\"do not run /create:readme, the rules are in /create:readme.md\", \"/create:readme\"],\n  [\"do not run /create:readme, see /create:readme/notes.txt\", \"/create:readme\"],\n];\nconst WRAPPERS = [[\"`\",\"`\"],[\"'\\''\",\"'\\''\"],[\"\\\"\",\"\\\"\"],[\"\\u201c\",\"\\u201d\"],[\"\\u2018\",\"\\u2019\"],[\"**\",\"**\"]];\nconst OTHER = [[\"[\",\"]\"],[\"(\",\")\"],[\"~~\",\"~~\"],[\"<code>\",\"</code>\"],[\"\\u00ab\",\"\\u00bb\"],[\"\\u2032\",\"\\u2032\"]];\nconst cmdRe = /\\/[a-z][a-z-]*:[a-z][a-z-]*/g;\nfunction wrap(prompt, open, close, cmd) { return prompt.split(cmd).join(open + cmd + close); }\nlet coveredMismatch = 0, otherMismatch = 0, otherRefusalFlip = 0;\nfor (const [p, c] of PLAIN) {\n  const base = commandOnlyMentioned(p, c);\n  for (const [o, cl] of WRAPPERS) {\n    const w = wrap(p, o, cl, c);\n    const got = commandOnlyMentioned(w, c);\n    if (got !== base) { coveredMismatch++; console.log(\"COVERED-MISMATCH\", o, JSON.stringify(w), base, \"->\", got); }\n  }\n  for (const [o, cl] of OTHER) {\n    const w = wrap(p, o, cl, c);\n    const got = commandOnlyMentioned(w, c);\n    if (got !== base) { otherMismatch++; if (base === true && got === false) otherRefusalFlip++; }\n  }\n}\nconsole.log({coveredMismatch, otherMismatch, otherRefusalFlip, plainRows: PLAIN.length});\nfor (const [p, c] of NOT_IN_PLAIN) {\n  const base = commandOnlyMentioned(p, c);\n  const b = wrap(p, \"[\", \"]\", c);\n  console.log(\"uncovered-fixture\", base, \"->\", commandOnlyMentioned(b, c), JSON.stringify(b));\n}\n'"},"output":"{\n  coveredMismatch: 0,\n  otherMismatch: 72,\n  otherRefusalFlip: 72,\n  plainRows: 23\n}\nuncovered-fixture true -> false \"should I run /create:agent or [/create:readme]?\"\nuncovered-fixture true -> false \"is /create:agent or [/create:readme] better?\"\nuncovered-fixture true -> false \"what does /create:agent or [/create:readme] do?\"\nuncovered-fixture true -> false \"is [/speckit:resume] safe to run twice\"\nuncovered-fixture true -> false \"Is the [/doctor:update] command safe?\"\nuncovered-fixture true -> false \"stop using [/create:changelog] for this, write the changelog entry by hand\"\nuncovered-fixture false -> false \"I have not run [/speckit:plan] yet, please start it for the login feature\"\nuncovered-fixture true -> false \"do not run [/speckit:complete], run /speckit:plan, then run it for the auth module\"\nuncovered-fixture true -> false \"never use **[/deep:review]** here\"\nuncovered-fixture false -> false \"do not run [/create:readme], the rules are in [/create:readme].md\"\nuncovered-fixture false -> false \"do not run [/create:readme], see [/create:readme]/notes.txt\"\n","title":"shell","metadata