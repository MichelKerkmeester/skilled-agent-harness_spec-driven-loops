-build --package system-skill-advisor/runtime --entry skill-advisor-cli\",\n    \"build\": \"npm --prefix ../../system-spec-kit/shared run build && ../../system-spec-kit/node_modules/.bin/tsc -p tsconfig.build.json\",\n    \"postbuild\": \"mkdir -p dist/runtime/data && cp data/*.json dist/runtime/data/ && (node ../../system-spec-kit/runtime/cli/lib/dist-freshness.cjs record-build --package system-skill-advisor/runtime --entry default || node -e \\\"const r=require('../../system-spec-kit/runtime/cli/lib/dist-freshness.cjs').writePackageSourceHashCache('system-skill-advisor/runtime',{entry:'default'});if(r.status!=='cached')throw new Error(r.message)\\\") && (node ../../system-spec-kit/runtime/cli/lib/dist-freshness.cjs record-build --package system-skill-advisor/runtime --entry skill-advisor-cli || node -e \\\"const r=require('../../system-spec-kit/runtime/cli/lib/dist-freshness.cjs').writePackageSourceHashCache('system-skill-advisor/runtime',{entry:'skill-advisor-cli'});if(r.status!=='cached')throw new Error(r.message)\\\")\",\n    \"postinstall\": \"node -e \\\"require('fs').writeFileSync('node_modules/.advisor-node',JSON.stringify({execPath:process.execPath,modules:process.versions.modules})+'\\\\n')\\\"\",\n    \"typecheck\": \"../../system-spec-kit/node_modules/.bin/tsc --noEmit --composite false -p tsconfig.build.json\",\n    \"test\": \"vitest run\",\n    \"test:stress\": \"SPECKIT_RUN_STRESS=true vitest run\"\n  },\n  \"dependencies\": {\n    \"@huggingface/transformers\": \"^3.8.1\",\n    \"@spec-kit/shared\": \"file:../../system-spec-kit/shared\",\n    \"better-sqlite3\": \"^12.11.1\",\n    \"chokidar\": \"^4.0.3\",\n    \"zod\": \"^4.6.7\"\n  },\n  \"overrides\": {\n    \"@hono/node-server\": \"^2.0.5\",\n    \"fast-uri\": \"^3.1.5\",\n    \"hono\": \"^4.12.34\",\n    \"ip-address\": \"^10.3.1\",\n    \"nanoid\": \"3.3.20\",\n    \"postcss\": \"^8.5.23\",\n    \"vite\": \"^8.1.2\",\n    \"protobufjs\": \"^7.6.4\",\n    \"tar\": \"^7.5.19\",\n    \"sharp\": \"^0.35.4\"\n  },\n  \"devDependencies\": {\n    \"vitest\": \"^4.1.12\"\n  }\n}\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"node --version; ls .skilled/skills/system-skill-advisor/runtime/lib/command-attach.* 2>/dev/null; ls .skilled/skills/system-skill-advisor/runtime/dist/lib/command-attach* 2>/dev/null | head; cat .skilled/skills/system-skill-advisor/runtime/package.json 2>/dev/null | head -60\"}"},"time":{"start":1794857096425,"end":1794857097292}}}}
