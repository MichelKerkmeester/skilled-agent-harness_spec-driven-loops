ng-build/review/lineages/routing-11/deep-review-audit-ledger/frames/0000000000000010.frame\n---\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"find specs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/review/lineages/routing-11/deep-review-audit-ledger -type f | head -20; echo ---; python3 - <<'PY'\\nimport json,glob,os\\nroot=\\\"specs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/review/lineages/routing-11\\\"\\nfor p in glob.glob(root+\\\"/deep-review-audit-ledger/**/*.jsonl\\\", recursive=True):\\n    print(\\\"FILE\\\", p, os.path.getsize(p))\\nPY\"}"},"time":{"start":1794857378543,"end":1794857379768}}}}
