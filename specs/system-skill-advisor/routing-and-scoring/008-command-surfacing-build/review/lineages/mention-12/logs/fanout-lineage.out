got); }\n  }\n}\nconsole.log(\"covered mismatches on excluded rows:\", bad, \"of\", rows.length*W.length);\n'"},"output":"covered mismatches on excluded rows: 0 of 72\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"covered mismatches on excluded rows: 0 of 72\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"cd /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research && node --input-type=module -e '\\nimport { commandOnlyMentioned } from \\\"./.skilled/skills/system-skill-advisor/runtime/lib/command-attach.ts\\\";\\nconst rows = [\\n  [\\\"should I run /create:agent or /create:readme?\\\", \\\"/create:readme\\\"],\\n  [\\\"is /create:agent or /create:readme better?\\\", \\\"/create:readme\\\"],\\n  [\\\"what does /create:agent or /create:readme do?\\\", \\\"/create:readme\\\"],\\n  [\\\"is /speckit:resume safe to run twice\\\", \\\"/speckit:resume\\\"],\\n  [\\\"Is the /doctor:update command safe?\\\", \\\"/doctor:update\\\"],\\n  [\\\"stop using /create:changelog for this, write the changelog entry by hand\\\", \\\"/create:changelog\\\"],\\n  [\\\"I have not run /speckit:plan yet, please start it for the login feature\\\", \\\"/speckit:plan\\\"],\\n  [\\\"do not run /speckit:complete, run /speckit:plan, then run it for the auth module\\\", \\\"/speckit:complete\\\"],\\n  [\\\"never use **/deep:review** here\\\", \\\"/deep:review\\\"],\\n  [\\\"do not run /speckit:complete, I will run it myself later\\\", \\\"/speckit:complete\\\"],\\n  [\\\"the next step is /speckit:implement\\\", \\\"/speckit:implement\\\"],\\n  [\\\"do not run it, just tell me what /doctor:update would change\\\", \\\"/doctor:update\\\"],\\n];\\nconst W = [[\\\"`\\\",\\\"`\\\"],[\\\"'\\\\''\\\",\\\"'\\\\''\\\"],[\\\"\\\\\\\"\\\",\\\"\\\\\\\"\\\"],[\\\"\\\\u201c\\\",\\\"\\\\u201d\\\"],[\\\"\\\\u2018\\\",\\\"\\\\u2019\\\"],[\\\"**\\\",\\\"**\\\"]];\\nlet bad=0;\\nfor (const [p,c] of rows) {\\n  const base = commandOnlyMentioned(p,c);\\n  for (const [o,cl] of W) {\\n    const w = p.split(c).join(o+c+cl);\\n    const got = commandOnlyMentioned(w,c);\\n    if (got!==base) { bad++; console.log(\\\"MISMATCH\\\", JSON.stringify(w), base,\\\"->\\\",got); }\\n  }\\n}\\nconsole.log(\\\"covered mismatches on excluded rows:\\\", bad, \\\"of\\\", rows.length*W.length);\\n'\"}"},"time":{"start":1794857751071,"end":1794857754922}}}}
