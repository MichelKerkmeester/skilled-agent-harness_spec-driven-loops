e)\n685-    && value >= 0\n686-    && value <= 1;\n687-}\n688-\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"602-  'renameMapVersion',\n603-  'baselineState',\n604-] as const);\n605:const SIGNAL_FIELDS = Object.freeze([\n606-  'noveltyRatio',\n607-  'coverageRatio',\n608-  'findingStabilityRatio',\n609-  'evidenceDensityRatio',\n610-  'hotspotSaturationRatio',\n611-  'observationDigest',\n612-] as const);\n613-const FORBIDDEN_MUTABLE_FIELDS = new Set([\n614-  'body',\n615-  'code',\n616-  'content',\n617-  'evidenceBlob',\n618-  'rawBody',\n619-  'rawEvidence',\n620-  'rawOutput',\n--\n760-\n761-function isConvergenceSignals(value: unknown): boolean {\n762-  return isObject(value)\n763:    && hasExactFields(value, SIGNAL_FIELDS)\n764:    && SIGNAL_FIELDS.slice(0, 5).every((field) => isRatio(value[field]))\n765-    && isDigest(value.observationDigest);\n766-}\n767-\n768-function isFindingCounts(value: unknown): boolean {\n769-  return isObject(value)\n770-    && hasExactFields(value, ['candidates', 'adjudicated', 'p0', 'p1', 'p2'])\n771-    && Object.values(value).every(isUint32);\n772-}\n773-\n774-function isRunCompletionCounts(value: unknown): boolean {\n775-  return isObject(value)\n776-    && hasExactFields(\n777-      value,\n778-      ['dimensions', 'iterations', 'candidates', 'findings', 'evidence'],\n779-    )\n682:function isRatio(value: unknown): value is number {\n683-  return typeof value === 'number'\n684-    && Number.isFinite(value)\n685-    && value >= 0\n686-    && value <= 1;\n687-}\n688-\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"grep -n \\\"SIGNAL_FIELDS\\\" -B 3 -A 15 .skilled/skills/system-deep-loop/runtime/lib/deep-review-ledger-schema/deep-review-ledger-schema.ts | head -40; grep -n \\\"function isRatio\\\" -A 6 .skilled/skills/system-deep-loop/runtime/lib/deep-review-ledger-schema/deep-review-ledger-schema