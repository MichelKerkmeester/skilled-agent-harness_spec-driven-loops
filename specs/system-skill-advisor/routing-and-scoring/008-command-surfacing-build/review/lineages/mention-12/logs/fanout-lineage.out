sions\":4,\"traceabilityCovered\":true,\"unfinishedCoreProtocols\":[]},\"stuckCount\":0},\"reasonDetail\":\"noStopCandidate\",\"signals\":{\"dimensionCoverage\":{\"available\":true,\"stop\":false,\"value\":0.5,\"weight\":0.45},\"madNoiseFloor\":{\"available\":false,\"stop\":false,\"value\":null,\"weight\":0.25},\"rollingAverage\":{\"available\":false,\"stop\":false,\"value\":null,\"weight\":0.3}},\"stopReason\":null,\"weightedStopScore\":0},\"blockers\":[],\"timestamp\":\"2026-11-16T18:11:44.880Z\"}\n{\"agent_definition_loaded\":true,\"dimensions\":[\"security\",\"maintainability\"],\"durationMs\":420000,\"filesReviewed\":[\".skilled/skills/sk-doc/ROUTER.md:126-142\",\".skilled/skills/sk-doc/ROUTER.md:218-220\",\".skilled/skills/sk-doc/graph-metadata.json:340-395\",\".skilled/skills/system-skill-advisor/runtime/scripts/skill-graph.json:1\",\".skilled/skills/sk-doc/sk-create-skill/scripts/generate-router-intent-signals.cjs:12-122\",\".skilled/skills/system-skill-advisor/runtime/lib/scorer/text.ts:7-35\",\".skilled/skills/system-skill-advisor/runtime/lib/scorer/lanes/lexical.ts:60-105\",\".skilled/skills/system-skill-advisor/runtime/lib/scorer/lane-registry.ts:6-18\",\"specs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/039-main-sk-doc-routing-repair/scratch/readme-probes.txt:1-11\",\"specs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/039-main-sk-doc-routing-repair/spec.md:60-111\"],\"findingDetails\":[{\"affectedSurfaceHints\":[\".skilled/skills/sk-doc/ROUTER.md\",\".skilled/skills/sk-doc/graph-metadata.json\",\".skilled/skills/system-spec-kit/graph-metadata.json\",\".skilled/skills/cli-external-orchestration/graph-metadata.json\"],\"dimension\":\"security\",\"disposition\":\"active\",\"evidence\":\"The prose at ROUTER.md:136-137 says git-* and spec-gate are not named because their names carry git, hooks and gate. After the removal the bag has no git and no gate, but hooks remains via codex-global-hooks-check (graph-metadata.json:358-359), and the retained names still inject env, secret, session, handover, decision, capture, dispatch, subagent, advisor, freshness, overlay, completion and quality into sk-doc's bag. Probe line 8 shows git hooks still reaches sk-git, so no present misroute is proven.\",\"file\":\".skilled/skills/sk-doc/ROUTER.md:219\",\"findingClass\":\"class-of-bug\",\"id\":\"F004\",\"recommendation\":\"Reword the prose to the words actually removed, and either drop the remaining cross-domain names or restrict them to a full-phrase match that cannot fire on a bare hook-system prompt.\",\"scopeProof\":\"Tokenized all 345 committed signals with the scorer rule (text.ts:31-35); intersected the 39 tokens from the 44 hook phrases with the 13 other hubs' bags; collisions exist for nine hubs.\",\"severity\":\"P2\",\"title\":\"The narrowing removes the git and gate words but leaves the same cross-hub token class from the other named hooks\"},{\"affectedSurfaceHints\":[\".skilled/skills/sk-doc/sk-create-skill/scripts/generate-router-intent-signals.cjs\",\".skilled/skills/sk-doc/ROUTER.md\",\".skilled/skills/sk-doc/graph-metadata.json\"],\"dimension\":\"maintainability\",\"disposition\":\"active\",\"evidence\":\"declaredPhrases keeps only phrases containing a space, so security.md and sync.md are never candidates. --check reports missing=0 while SECURITY_POLICY declares security.md as its only keyword (ROUTER.md:218) and neither generated artifact contains it. The packet probe still shows a SECURITY.md request topping sk-doc, so reach holds but the gate cannot verify it.\",\"file\":\".skilled/skills/sk-doc/sk-create-skill/scripts/generate-router-intent-signals.cjs:57\",\"findingClass\":\"matrix/evidence\",\"id\":\"F005\",\"recommendation\":\"Teach the writer to carry dotted filename phrases, or add a gate case that flags an intent with zero carryable phrases; document the exclusion explicitly.\",\"scopeProof\":\"Computed declared vocabularies with and without the includes(' ') filter: 381 total, 328 multi-word; security.md and sync.md are excluded; ran --check --hub sk-doc and read missing=0.\",\"severity\":\"P2\",\"title\":\"The generator's carry rule and its --check gate share a blind spot for dotted phrases\"}],\"findingsCount\":5,\"findingsNew\":{\"P0\":0,\"P1\":0,\"P2\":2},\"findingsSummary\":{\"P0\":0,\"P1\":0,\"P2\":5},\"focus\":\"security and maintainability - retained cross-hub token footprint and the generation gate's dotted-phrase blind spot\",\"generation\":1,\"graphEvents\":[{\"id\":\"d-security\",\"kind\":\"DIMENSION\",\"label\":\"security\",\"type\":\"node\"},{\"id\":\"d-maintainability\",\"kind\":\"DIMENSION\",\"label\":\"maintainability\",\"type\":\"node\"},{\"id\":\"file-sk-doc-router\",\"kind\":\"FILE\",\"label\":\".skilled/skills/sk-doc/ROUTER.md\",\"type\":\"node\"},{\"id\":\"file-sk-doc-graph-metadata\",\"kind\":\"FILE\",\"label\":\".skilled/skills/sk-doc/graph-metadata.json\",\"type\":\"node\"},{\"id\":\"file-advisor-skill-graph\",\"kind\":\"FILE\",\"label\":\".skilled/skills/system-skill-advisor/runtime/scripts/skill-graph.json\",\"type\":\"node\"},{\"id\":\"file-generate-router-intent-signals\",\"kind\":\"FILE\",\"label\":\".skilled/skills/sk-doc/sk-create-skill/scripts/generate-router-intent-signals.cjs\",\"type\":\"node\"},{\"id\":\"file-scorer-text\",\"kind\":\"FILE\",\"label\":\".skilled/skills/system-skill-advisor/runtime/lib/scorer/text.ts\",\"type\":\"node\"},{\"id\":\"file-scorer-lexical\",\"kind\":\"FILE\",\"label\":\".skilled/skills/system-skill-advisor/runtime/lib/scorer/lanes/lexical.ts\",\"type\":\"node\"},{\"id\":\"file-scorer-lane-registry\",\"kind\":\"FILE\",\"label\":\".skilled/skills/system-skill-advisor/runtime/lib/scorer/lane-registry.ts\",\"type\":\"node\"},{\"id\":\"file-039-probes\",\"kind\":\"FILE\",\"label\":\"039-main-sk-doc-routing-repair/scratch/readme-probes.txt\",\"type\":\"node\"},{\"id\":\"f-004\",\"kind\":\"FINDING\",\"label\":\"Retained named hooks leave the cross-hub token class