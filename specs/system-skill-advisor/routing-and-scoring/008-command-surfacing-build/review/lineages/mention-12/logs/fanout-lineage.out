);\nconst p2 = \"do not run \" + \"/a or \".repeat(400) + \"/create:readme\";\nconst r2 = commandOnlyMentioned(p2, \"/create:readme\");\nconsole.log(\"alt list:\", r2, (Number(process.hrtime.bigint()-t1)/1e6).toFixed(1)+\"ms\", p2.length);\n'"},"output":"typedForTop bold: undefined\ntypedForTop plain: { command: '/create:readme', policy: 'start', ownerSkillId: 'sk-doc' }\ntypedForTop curly: undefined\nattach deep bold: undefined\nattach deep plain: /deep:review\nattach deep bold+thorough: /deep:review\nretired suffix typed: /create:sk-skill /create:sk-skill\npathological or-list: false 1.2ms 2025\nalt list: true 0.1ms 2425\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"typedForTop bold: undefined\ntypedForTop plain: { command: '/create:readme', policy: 'start', ownerSkillId: 'sk-doc' }\ntypedForTop curly: undefined\nattach deep bold: undefined\nattach deep plain: /deep:review\nattach deep bold+thorough: /deep:review\nretired suffix typed: /create:sk-skill /create:sk-skill\npathological or-list: false 1.2ms 2025\nalt list: true 0.1ms 2425\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"cd /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research && node --input-type=module -e '\\nimport { commandOnlyMentioned, attachCommand, typedCommandIn, typedCommandForTop } from \\\"./.skilled/skills/system-skill-advisor/runtime/lib/command-attach.ts\\\";\\nconst S = (m) => ({action:\\\"route\\\", selectionKind:\\\"single\\\", targets:[{workflowMode:m}]});\\nconsole.log(\\\"typedForTop bold:\\\", typedCommandForTop(\\\"sk-doc\\\", \\\"run **/create:readme** for the advisor skill\\\"));\\nconsole.log(\\\"typedForTop plain:\\\", typedCommandForTop(\\\"sk-doc\\\", \\\"run /create:readme for the advisor skill\\\"));\\nconsole.log(\\\"typedForTop curly:\\\", typedCommandForTop(\\\"sk-doc\\\", \\\"\\\\u201c/create:readme\\\\u201d for the ad