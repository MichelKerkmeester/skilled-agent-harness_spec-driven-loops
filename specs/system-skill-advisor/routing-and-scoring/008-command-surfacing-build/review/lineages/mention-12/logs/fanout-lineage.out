: merged\t.skilled/skills/sk-doc/SKILL.md\n6: merged\t.skilled/skills/sk-doc/graph-metadata.json\n7: merged\t.skilled/commands/doctor/scripts/tests/doctor-install-contract.test.cjs"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\"specs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/review/review-scope-12.txt\"}"},"time":{"start":1794856978885,"end":1794856979733}}}}
