omUUID()}`,\n364:       event_type: rawEvent.event_type || rawEvent.eventType,\n365:       event_version: rawEvent.event_version ?? rawEvent.eventVersion ?? 1,\n366:       stream_id: rawEvent.stream_id || rawEvent.streamId || ledgerId,\n367:       stream_sequence: rawEvent.stream_sequence ?? rawEvent.streamSequence ?? (currentHead.sequence + 1),\n368:       occurred_at: rawEvent.occurred_at || rawEvent.occurredAt || nowIso,\n369:       recorded_at: rawEvent.recorded_at || rawEvent.recordedAt || nowIso,\n370:       producer: rawEvent.producer || { name: 'deep-loop-cli', version: '1.0.0' },\n371:       authority_epoch: rawEvent.authority_epoch ?? rawEvent.authorityEpoch ?? authority.epoch,\n372:       correlation_id: rawEvent.correlation_id || rawEvent.correlationId || crypto.randomUUID(),\n373:       causation_id: rawEvent.causation_id !== undefined\n374:         ? rawEvent.causation_id\n375:         : (rawEvent.causationId !== undefined ? rawEvent.causationId : null),\n376:       idempotency_key: rawEvent.idempotency_key || rawEvent.idempotencyKey || defaultIdempotencyKey,\n377:       payload: rawEvent.payload || {},\n378:     };\n379:     eventRecord = prepareEventWrite(envelope, registry);\n380:   } else if (\n381:     normalizedMode === 'deep-research'\n382:     && rawEvent\n383:     && typeof rawEvent === 'object'\n384:   ) {\n385:     // Legacy deep-research rows predate the canonical envelope and carry no\n386:     // stem or event_type the current registry recognizes. This branch is tried\n387:     // last so canonical envelopes and explicit stem/event_type rows keep their\n388:     // fast paths untouched; only rows that would otherwise hit the final throw\n389:     // reach the upcaster. Non-research modes never enter here, so they keep\n390:     // the original unrecognized-format rejection.\n391:     const legacyRunId = rawEvent.runId || rawEvent.sessionId || 'run-cli';\n392:     const legacyLineageId = rawEvent.lineageId\n393:       || rawEvent.parentSessionId\n394:       || rawEvent.sessionId\n395:       || 'lineage-cli';\n396:     const legacyScope = { runId: legacyRunId, lineageId: legacyLineageId };\n397:     const legacyIteration = rawEvent.iteration ?? rawEvent.run;\n398:     if (Number.isSafeInteger(legacyIteration) && legacyIteration > 0) {\n399:       legacyScope.iteration = legacyIteration;\n400:     }\n401:     const legacyContext = {\n402:       scope: legacyScope,\n403:       prevEventHash: currentHead.recordHash,\n404:       replay: defaultReplay,\n405:     };\n406:     const upcast = upcastLegacyDeepResearchRecord(rawEvent, legacyContext);\n407:     if (upcast.status === 'refused') {\n408:       // A bare \"refused\" tells the operator nothing actionable. Carrying the\n409:       // decision's own reasonCode lets them see whether the row was blocked,\n410:       // pinned to the old runtime, or simply unrecognized, so they can fix the\n411:       // input rather than guess. Nothing is written: this throws before any\n412:       // append is attempted.\n413:       throw new Error(\n414:         `Legacy deep-research record refused: ${upcast.decision.reasonCode}`,\n415:       );\n416:     }\n417:     // A row the projection writes back with its own timestamp hands that time\n418:     // over as the event's occurrence time, so the row keeps it.\n419:     const preparedInput = buildPreparedInput({\n420:       stem: upcast.targetStem,\n421:       scope: upcast.scope,\n422:       data: upcast.data,\n423:       prevEventHash: upcast.prevEventHash,\n424:       replay: upcast.replay,\n425:     }, upcast.occurredAt ? { occurredAt: upcast.occurredAt, ...rawEvent } : rawEvent);\n426:     eventRecord = adapter.prepareEvent(preparedInput, registry);\n427:     legacyWarnings = upcast.warnings;\n428:   } else if (\n429:     normalizedMode === 'deep-review'\n430:     && rawEvent\n431:     && typeof rawEvent === 'object'\n432:     && !Array.isArray(rawEvent)\n433:     && (rawEvent.type === 'iteration' || rawEvent.type === 'iteration_start'\n434:       || (rawEvent.type === 'event'\n435:         && [\n436:           'dispatch_failure',\n437:           'dispatch_receipt_write_failed',\n438:           'verification_degraded',\n439:           'containment_violation',\n440:           'containment_contested',\n441:         ].includes(rawEvent.event)))\n442:   ) {\n443:     // The review agent, its iteration prompt and its workflow all hand the gateway the canonical\n444:     // iteration record itself, the pre-dispatch executor audit hands it the iteration's opening\n445:     // row, the audited executor runner hands it a dispatch's failure rows, the post-dispatch\n446:     // validator its verification_degraded row and the write-containment guard its findings.\n447:     // Their optional fields vary with review depth and executor, so each travels whole under one\n448:     // stem, and the state projection writes it back as the same row.\n449:     const sessionId = typeof rawEvent.sessionId === 'string' && rawEvent.sessionId\n450:       ? rawEvent.sessionId\n451:       : 'run-cli';\n452:     const preparedInput = buildPreparedInput({\n453:       stem: 'deep_review.iteration_recorded',\n454:       scope: { runId: sessionId, sessionId },\n455:       data: { record: rawEvent },\n456:       prevEventHash: currentHead.recordHash,\n457:       replay: defaultReplay,\n458:     }, rawEvent);\n459:     eventRecord = adapter.prepareEvent(preparedInput, registry);\n460:   } else {\n461:     throw new Error('Unrecognized event format: expected object with stem or event_type');\n462:   }\n463: \n464:   const outcome = await appendModeEvent({\n465:     mode: normalizedMode,\n466:     runDirectory,\n467:     eventRecord,\n468:     authorityRoot,\n469:     policy: {\n470:       policyId: resolvedPolicy.policyId,\n471:       policyVersion: resolvedPolicy.policyVersion,\n472:       policyDigest: resolvedPolicy.digest,\n473:     },\n474:     policyRegistry,\n475:     authorizationGateway,\n476:     ledger,\n477:     eventRegistry: registry,\n478:     binding,\n479:   });\n480: \n481:   // Both phases leave the state log out of step with the ledger, so the runner\n482:   // reads either one back to name why a lineage recorded nothing.\n483:   if (outcome && outcome.ok === false && (outcome.phase === 'projection' || outcome.phase === 'provenance')) {\n484:     const eventStem = eventRecord?.envelope?.payload?.stem;\n485:     const refusalRecord = {\n486:       at: new Date().toISOString(),\n487:       mode: normalizedMode,\n488:       phase: outcome.phase,\n489:       code: outcome.code,\n[Output truncated. Continue reading with offset: 490]","title":"read","metadata":{"metadata":{"truncated":true},"content":[{"type":"text","text":"Read file .skilled/skills/system-deep-loop/runtime/scripts/append-mode-event.cjs, lines 330-489\n330:       idempotencyKey: meta.idempotencyKey || meta.idempotency_key || defaultIdempotencyKey,\n331:     };\n332:   }\n333: \n334:   const defaultReplay = {\n335:     fingerprint_version: 1,\n336:     final_digest: '0'.repeat(64),\n337:     replay_input_digests: {},\n338:   };\n339: \n340:   let eventRecord;\n341:   let legacyWarnings;\n342:   if (\n343:     rawEvent\n344:     && typeof rawEvent === 'object'\n345:     && rawEvent.canonicalDigest\n346:     && rawEvent.canonicalBytes\n347:     && rawEvent.identity\n348:     && rawEvent.envelope\n349:   ) {\n350:     eventRecord = rawEvent;\n351:   } else if (rawEvent && typeof rawEvent === 'object' && rawEvent.stem) {\n352:     const preparedInput = buildPreparedInput({\n353:       stem: rawEvent.stem,\n354:       scope: rawEvent.scope || { runId: 'run-cli', lineageId: 'lineage-cli' },\n355:       data: rawEvent.data || {},\n356:       prevEventHash: rawEvent.prevEventHash || rawEvent.prev_event_hash || currentHead.recordHash,\n357:       replay: rawEvent.replay || defaultReplay,\n358:     }, rawEvent);\n359:     eventRecord = adapter.prepareEvent(preparedInput, registry);\n360:   } else if (rawEvent && typeof rawEvent === 'object' && (rawEvent.event_type || rawEvent.eventType)) {\n361:     const envelope = {\n362:       envelope_version: rawEvent.envelope_version ?? rawEvent.envelopeVersion ?? 1,\n363:       event_id: rawEvent.event_id || rawEvent.eventId || `event-${crypto.randomUUID()}`,\n364:       event_type: rawEvent.event_type || rawEvent.eventType,\n365:       event_version: rawEvent.event_version ?? rawEvent.eventVersion ?? 1,\n366:       stream_id: rawEvent.stream_id || rawEvent.streamId || ledgerId,\n367:       stream_sequence: rawEvent.stream_sequence ?? rawEvent.streamSequence ?? (currentHead.sequence + 1),\n368:       occurred_at: rawEvent.occurred_at || rawEvent.occurredAt || nowIso,\n369:       recorded_at: rawEvent.recorded_at || rawEvent.recordedAt || nowIso,\n370:       producer: rawEvent.producer || { name: 'deep-loop-cli', version: '1.0.0' },\n371:       authority_epoch: rawEvent.authority_epoch ?? rawEvent.authorityEpoch ?? authority.epoch,\n372:       correlation_id: rawEvent.correlation_id || rawEvent.correlationId || crypto.randomUUID(),\n373:       causation_id: rawEvent.causation_id !== undefined\n374:         ? rawEvent.causation_id\n375:         : (rawEvent.causationId !== undefined ? rawEvent.causationId : null),\n376:       idempotency_key: rawEvent.idempotency_key || rawEvent.idempotencyKey || defaultIdempotencyKey,\n377:       payload: rawEvent.payload || {},\n378:     };\n379:     eventRecord = prepareEventWrite(envelope, registry);\n380:   } else if (\n381:     normalizedMode === 'deep-research'\n382:     && rawEvent\n383:     && typeof rawEvent === 'object'\n384:   ) {\n385:     // Legacy deep-research rows predate the canonical envelope and carry no\n386:     // stem or event_type the current registry recognizes. This branch is tried\n387:     // last so canonical envelopes and explicit stem/event_type rows keep their\n388:     // fast paths untouched; only rows that would otherwise hit the final throw\n389:     // reach the upcaster. Non-research modes never enter here, so they keep\n390:     // the original unrecognized-format rejection.\n391:     const legacyRunId = rawEvent.runId || rawEvent.sessionId || 'run-cli';\n392:     const legacyLineageId = rawEvent.lineageId\n393:       || rawEvent.parentSessionId\n394:       || rawEvent.sessionId\n395:       || 'lineage-cli';\n396:     const legacyScope = { runId: legacyRunId, lineageId: legacyLineageId };\n397:     const legacyIteration = rawEvent.iteration ?? rawEvent.run;\n398:     if (Number.isSafeInteger(legacyIteration) && legacyIteration > 0) {\n399:       legacyScope.iteration = legacyIteration;\n400:     }\n401:     const legacyContext = {\n402:       scope: legacyScope,\n403:       prevEventHash: currentHead.recordHash,\n404:       replay: defaultReplay,\n405:     };\n406:     const upcast = upcastLegacyDeepResearchRecord(rawEvent, legacyContext);\n407:     if (upcast.status === 'refused') {\n408:       // A bare \"refused\" tells the operator nothing actionable. Carrying the\n409:       // decision's own reasonCode lets them see whether the row was blocked,\n410:       // pinned to the old runtime, or simply unrecognized, so they can fix the\n411:       // input rather than guess. Nothing is written: this throws before any\n412:       // append is attempted.\n413:       throw new Error(\n414:         `Legacy deep-research record refused: ${upcast.decision.reasonCode}`,\n415:       );\n416:     }\n417:     // A row the projection writes back with its own timestamp hands that time\n418:     // over as the event's occurrence time, so the row keeps it.\n419:     const preparedInput = buildPreparedInput({\n420:       stem: upcast.targetStem,\n421:       scope: upcast.scope,\n422:       data: upcast.data,\n423:       prevEventHash: upcast.prevEventHash,\n424:       replay: upcast.replay,\n425:     }, upcast.occurredAt ? { occurredAt: upcast.occurredAt, ...rawEvent } : rawEvent);\n426:     eventRecord = adapter.prepareEvent(preparedInput, registry);\n427:     legacyWarnings = upcast.warnings;\n428:   } else if (\n429:     normalizedMode === 'deep-review'\n430:     && rawEvent\n431:     && typeof rawEvent === 'object'\n432:     && !Array.isArray(rawEvent)\n433:     && (rawEvent.type === 'iteration' || rawEvent.type === 'iteration_start'\n434:       || (rawEvent.type === 'event'\n435:         && [\n436:           'dispatch_failure',\n437:           'dispatch_receipt_write_failed',\n438:           'verification_degraded',\n439:           'containment_violation',\n440:           'containment_contested',\n441:         ].includes(rawEvent.event)))\n442:   ) {\n443:     // The review agent, its iteration prompt and its workflow all hand the gateway the canonical\n444:     // iteration record itself, the pre-dispatch executor audit hands it the iteration's opening\n445:     // row, the audited executor runner hands it a dispatch's failure rows, the post-dispatch\n446:     // validator its verification_degraded row and the write-containment guard its findings.\n447:     // Their optional fields vary with review depth and executor, so each travels whole under one\n448:     // stem, and the state projection writes it back as the same row.\n449:     const sessionId = typeof rawEvent.sessionId === 'string' && rawEvent.sessionId\n450:       ? rawEvent.sessionId\n451:       : 'run-cli';\n452:     const preparedInput = buildPreparedInput({\n453:       stem: 'deep_review.iteration_recorded',\n454:       scope: { runId: sessionId, sessionId },\n455:       data: { record: rawEvent },\n456:       prevEventHash: currentHead.recordHash,\n457:       replay: defaultReplay,\n458:     }, rawEvent);\n459:     eventRecord = adapter.prepareEvent(preparedInput, registry);\n460:   } else {\n461:     throw new Error('Unrecognized event format: expected object with stem or event_type');\n462:   }\n463: \n464:   const outcome = await appendModeEvent({\n465:     mode: normalizedMode,\n466:     runDirectory,\n467:     eventRecord,\n468:     authorityRoot,\n469:     policy: {\n470:       policyId: resolvedPolicy.policyId,\n471:       policyVersion: resolvedPolicy.policyVersion,\n472:       policyDigest: resolvedPolicy.digest,\n473:     },\n474:     policyRegistry,\n475:     authorizationGateway,\n476:     ledger,\n477:     eventRegistry: registry,\n478:     binding,\n479:   });\n480: \n481:   // Both phases leave the state log out of step with the ledger, so the runner\n482:   // reads either one back to name why a lineage recorded nothing.\n483:   if (outcome && outcome.ok === false && (outcome.phase === 'projection' || outcome.phase === 'provenance')) {\n484:     const eventStem = eventRecord?.envelope?.payload?.stem;\n485:     const refusalRecord = {\n486:       at: new Date().toISOString(),\n487:       mode: normalizedMode,\n488:       phase: outcome.phase,\n489:       code: outcome.code,\n[Output truncated. Continue reading with offset: 490]"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"limit\":160,\"offset\":330,\"path\":\".skilled/skills/system-deep-loop/runtime/scripts/append-mode-event.cjs\"}"},"time":{"start":1794857350105,"end":1794857350617}}}}
