on-1\"},\n  data:{\n    rawSignals,\n    weightedSignals:rawSignals,\n    dimensionCoverageDigest,\n    protocolCoverageDigest,\n    findingStability:\"stable\",\n    p0p1ResolutionState:(activeP0+activeP1)>0?\"blocked\":\"resolved\",\n    evidenceDensity:1,\n    hotspotSaturation:1,\n    decision:stop.decision===\"STOP\"?\"converged\":stop.decision===\"BLOCKED\"?\"blocked\":stop.decision===\"STUCK_RECOVERY\"?\"continue\":\"continue\",\n    policyFingerprint:dig(canonical({convergenceThreshold:cfg.convergenceThreshold,stopPolicy:cfg.stopPolicy,convergenceMode:cfg.antiConvergence.convergenceMode})),\n    blockerIds:stop.blockedBy,\n    stopCandidate:stop.decision===\"STOP\",\n    graphDecision:graphMap[conv.graph_decision]||\"continue\",\n    graphDigest,\n    signals:stop,\n    blockers:conv.graph_blockers_json||[]\n  },\n  eventId:\"graph-\"+cfg.sessionId+\"-g\"+cfg.generation+\"-i1\"\n};\nfs.writeFileSync(dir+\"/iter-001.convergence-event.json\",JSON.stringify(event));\nconsole.log(\"built\", JSON.stringify({coverage:covered/total, decision:event.data.decision, graphDecision:event.data.graphDecision, stopReason:stop.stopReason, blockedBy:stop.blockedBy}));\n' && node .skilled/skills/system-deep-loop/runtime/scripts/append-mode-event.cjs --mode review --run-directory specs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/review/lineages/mention-12 --event-json specs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/review/lineages/mention-12/iter-001.convergence-event.json"},"output":"built {\"coverage\":0.5,\"decision\":\"continue\",\"graphDecision\":\"converged\",\"stopReason\":null,\"blockedBy\":[]}\n{\"ok\":true,\"receipt\":{\"ledger_id\":\"deep-review-ledger\",\"sequence\":3,\"event_id\":\"graph-fanout-mention-12-1794856957949-n58dw7-g1-i1\",\"event_type\":\"deep-review.ledger.graph-convergence-evaluated\",\"event_version\":1,\"stream_id\":\"deep-review-ledger\",\"stream_sequence\":3,\"committed_at\":\"2026-11-16T19:39:45