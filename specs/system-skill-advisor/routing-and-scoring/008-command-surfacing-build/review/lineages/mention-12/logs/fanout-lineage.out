eg.dimensionCoverage)),protocolCoverageDigest:dig(\"{}\"),findingStability:\"stable\",p0p1ResolutionState:(activeP0+activeP1)>0?\"blocked\":\"resolved\",evidenceDensity:1,hotspotSaturation:1,decision:stop.decision===\"STOP\"?\"converged\":stop.decision===\"BLOCKED\"?\"blocked\":\"continue\",policyFingerprint:dig(canonical({convergenceThreshold:cfg.convergenceThreshold,stopPolicy:cfg.stopPolicy,convergenceMode:cfg.antiConvergence.convergenceMode})),blockerIds:stop.blockedBy,stopCandidate:stop.decision===\"STOP\",graphDecision:graphMap[conv.graph_decision]||\"continue\",graphDigest,signals:stop,blockers:conv.graph_blockers_json||[]},eventId:\"graph-\"+cfg.sessionId+\"-g\"+cfg.generation+\"-i\"+iter};\nfs.writeFileSync(dir+\"/iter-00\"+iter+\".convergence-event.json\",JSON.stringify(event));\nconsole.log(JSON.stringify({coverage:covered/total,decision:event.data.decision,graphDecision:event.data.graphDecision,stopReason:stop.stopReason,blockedBy:stop.blockedBy}));\n' && node .skilled/skills/system-deep-loop/runtime/scripts/append-mode-event.cjs --mode review --run-directory specs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/review/lineages/mention-12 --event-json specs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/review/lineages/mention-12/iter-002.convergence-event.json | head -c 400"},"output":"{\"coverage\":1,\"decision\":\"continue\",\"graphDecision\":\"converged\",\"stopReason\":null,\"blockedBy\":[]}\n{\"ok\":true,\"receipt\":{\"ledger_id\":\"deep-review-ledger\",\"sequence\":5,\"event_id\":\"graph-fanout-mention-12-1794856957949-n58dw7-g1-i2\",\"event_type\":\"deep-review.ledger.graph-convergence-evaluated\",\"event_version\":1,\"stream_id\":\"deep-review-ledger\",\"stream_sequence\":5,\"committed_at\":\"2026-11-16T19:43:35.910Z\",\"canonicalEventHash\":\"7f903af68ff845a2886415dc9d94326606ac0906a6dffe2bfbfbc295ebbe7110\",\"reco","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0