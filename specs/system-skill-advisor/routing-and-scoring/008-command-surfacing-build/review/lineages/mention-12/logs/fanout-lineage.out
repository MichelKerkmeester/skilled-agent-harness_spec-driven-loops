nder-command-contract.cjs\nreview-verdict.cjs\nrun-now-sentinel.cjs\nruntime-bootstrap.cjs\nscore-fanout-pairs.cjs\nstatus.cjs\nsynthesis-closeout.cjs\nterminal-gates.cjs\nupsert.cjs\nverify-authority.cjs\nverify-iteration.cjs\n---\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"ls .skilled/skills/system-deep-loop/runtime/scripts/ | head -80; echo ---; grep -rln \\\"graph_convergence_evaluated\\\" .skilled/skills/system-deep-loop/runtime/scripts .skilled/bin 2>/dev/null | head\"}"},"time":{"start":1794857395265,"end":1794857395892}}}}
