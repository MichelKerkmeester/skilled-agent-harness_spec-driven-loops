// skill.\n1204: export function withholdMentionedCommands(\n1205:   ranked: readonly AdvisorScoredRecommendation[],\n1206:   prompt: string,\n1207: ): AdvisorScoredRecommendation[] {\n1208:   return ranked.map((recommendation) => {\n1209:     if (recommendation.kind !== 'command' || !recommendation.passes_threshold) return recommendation;\n1210:     // A row names a command with its subcommands, while a prompt names only the\n1211:     // base, so both sides are compared on the base alone.\n1212:     const command = commandRowFor(recommendation.skill)?.command.split(' ')[0];\n1213:     if (command === undefined || !commandOnlyMentioned(prompt, command)) return recommendation;\n1214:     return { ...recommendation, passes_threshold: false };\n1215:   });\n1216: }\n1217: \n1218: // A reader who ruled out a change must not be handed a command that writes,\n1219: // whichever path chose it. A command that only reads is still the answer.\n1220: export function withholdWritingCommandsOnNoEdit(\n1221:   ranked: readonly AdvisorScoredRecommendation[],\n1222:   promptLower: string,\n1223: ): AdvisorScoredRecommendation[] {\n1224:   if (!isNoEditRequest(promptLower)) return [...ranked];\n1225:   return ranked.map((recommendation) => {\n1226:     if (recommendation.kind !== 'command' || !recommendation.passes_threshold) return recommendation;\n1227:     if (commandRowFor(recommendation.skill)?.mutating === 'read-only') return recommendation;\n1228:     // A command the reader typed and asked for is the request, and the no-edit words limit its scope.\n1229:     const base = commandRowFor(recommendation.skill)?.command.split(' ')[0];\n1230:     if (base !== undefined\n1231:       && typedCommandIn(promptLower) === base\n1232:       && !commandOnlyMentioned(promptLower, base)) return recommendation;\n1233:     return { ...recommendation, passes_threshold: false };\n1234:   });\n1235: }\n1236: \n1237: // A typed command with no scorer row of its own can only reach the reader through\n1238: // its owner, so the owner must lead. With no row the scorer already orders the\n1239: // list, and a command that does have a row competes on its own evidence.\n1240: export function rankTypedCommandOwnerFirst(\n1241:   ranked: readonly AdvisorScoredRecommendation[],\n1242:   promptLower: string,\n1243: ): AdvisorScoredRecommendation[] {\n1244:   const command = typedCommandIn(promptLower);\n1245:   if (command === undefined || !Object.hasOwn(TRACKED_COMMANDS, command)) return [...ranked];\n1246:   // A command the reader refused must not pull its owner to the front, because\n1247:   // the ranking would then lead with the skill that offers it.\n1248:   if (commandOnlyMentioned(promptLower, command)) return [...ranked];\n1249:   const row = TRACKED_COMMANDS[command];\n1250:   if (row.scorerRow) return [...ranked];\n1251:   const ownerIndex = ranked.findIndex((recommendation) => (\n1252:     recommendation.skill === row.ownerSkillId && recommendation.passes_threshold\n1253:   ));\n1254:   const owner = ranked[ownerIndex];\n1255:   if (!owner || ownerIndex === 0) return [...ranked];\n1256:   return [\n1257:     owner,\n1258:     ...ranked.slice(0, ownerIndex),\n1259:     ...ranked.slice(ownerIndex + 1),\n1260:   ];\n1261: }\n1262: \n1263: export function scoreAdvisorPrompt(prompt: string, options: AdvisorScoringOptions): AdvisorScoringResult {\n1264:   const projection = projectionWithUsableSkillIds(\n1265:     options.projection ?? loadAdvisorProjection(options.workspaceRoot),\n1266:   );\n1267:   const promptLower = prompt.toLowerCase();\n1268:   const queryClass = classifyAdvisorQuery(promptLower);\n1269:   const weights = effectiveScorerWeights(\n[Output truncated. Continue reading with offset: 1270]","title":"read","metadata":{"metadata":{"truncated":true},"content":[{"type":"text","text":"Read file .skilled/skills/system-skill-advisor/runtime/lib/scorer/fusion.ts, lines 1180-1269\n1180:   const existing = ranked.find((recommendation) => recommendatio