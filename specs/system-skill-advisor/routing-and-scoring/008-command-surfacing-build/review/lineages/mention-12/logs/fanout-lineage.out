UTHORITY_DENIED' });\n226:     process.exit(2);\n227:   }\n228:   const authority = { state: admission.state, epoch: admission.epoch };\n229:   const policyId = typeof args.policyId === 'string' ? args.policyId : `${normalizedMode}-append-policy`;\n230:   const policyVersion = 1;\n231:   const ruleId = 'mode-event-append';\n232: \n233:   const policyRegistry = new TransitionPolicyRegistry([{\n234:     policyId,\n235:     policyVersion,\n236:     evaluatorVersion: '1',\n237:     ruleIds: [ruleId],\n238:     capturedAuthorizationState: { state: authority.state, epoch: authority.epoch },\n239:     evaluate: () => ({\n240:       verdict: AuthorizationVerdicts.ALLOW,\n241:       reasonCode: AuthorizationReasonCodes.ALLOWED,\n242:       matchedRuleIds: [ruleId],\n243:     }),\n244:   }]);\n245: \n246:   const resolvedPolicy = policyRegistry.resolve(policyId, policyVersion);\n247: \n248:   const ledgerId = `${normalizedMode}-ledger`;\n249:   const auditLedgerId = `${normalizedMode}-audit-ledger`;\n250: \n251:   const ledger = new AppendOnlyLedger({\n252:     rootDirectory: runDirectory,\n253:     ledgerId,\n254:     auditLedgerId,\n255:     authorityProvider: () => authority,\n256:   }, registry);\n257: \n258:   const authorizationGateway = new TransitionAuthorizationGateway({\n259:     rootDirectory: runDirectory,\n260:     auditLedgerId,\n261:     authorityProvider: () => authority,\n262:     identityResolver: (context) => ({\n263:       actorId: context.evaluationInput.actorId,\n264:       capabilityId: context.evaluationInput.capabilityId,\n265:       evidenceDigest: context.evaluationInput.evidenceDigest,\n266:     }),\n267:   }, ledger, policyRegistry);\n268: \n269:   let binding;\n270:   try {\n271:     binding = resolveCutoverBinding({\n272:       mode: normalizedMode,\n273:       repositoryRoot: runDirectory,\n274:     });\n275:   } catch (primaryError) {\n276:     try {\n277:       binding = resolveCutoverBinding({\n278:         mode: normalizedMode,\n279:       