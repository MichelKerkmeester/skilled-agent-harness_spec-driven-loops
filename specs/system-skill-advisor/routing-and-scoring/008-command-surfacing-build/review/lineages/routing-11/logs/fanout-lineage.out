nst detail of record.findingDetails) {\n          noteStructuredId(run, normalizeText(detail?.id || detail?.findingId || ''));\n        }\n      }\n    }\n=== findingDedupKey ===\n913:function findingDedupKey(finding) {\n914-  if (finding.contentHash) {\n915-    return `ch:${finding.contentHash}`;\n916-  }\n917-  const file = finding.file || '';\n918-  const line = isFiniteNumber(finding.line) ? finding.line : '';\n919-  const title = normalizeText(finding.title || '').toLowerCase().slice(0, 80);\n920-  return `fl:${file}:${line}|${title}`;\n921-}\n922-\n923-/**\n924- * Detect a re-verified finding whose line moved between iterations.\n925- *\n926- * A content hash settles identity when a producer writes one. Legacy records have none,\n927- * and a line-shifted fix then reads as a new finding. The same file and the same title\n928- * are the identity those records can prove, so the shift folds instead of doubting.\n929- */\n930-function sameFindingAtAnotherLine(existing, finding) {\n931-  if (!existing || existing.contentHash || finding.contentHash) return false;\n932-  if (!existing.file || !finding.file || existing.file !== finding.file) return false;\n933-  const title = (candidate) => normalizeText(candidate.title || '').toLowerCase().slice(0, 80);\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"cd /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research && sed -n '1050,1115p' .skilled/skills/system-deep-loop/runtime/scripts/reduce-state.cjs; echo \\\"=== findingDedupKey ===\\\"; rg -n \\\"function findingDedupKey\\\" -A 20 .skilled/skills/system-deep-loop/runtime/scripts/reduce-state.cjs\"}"},"time":{"start":1794853071535,"end":1794853072353}}}}
