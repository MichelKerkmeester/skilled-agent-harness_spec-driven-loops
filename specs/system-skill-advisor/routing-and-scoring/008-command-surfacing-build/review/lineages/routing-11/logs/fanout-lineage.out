.parse(fs.readFileSync(base+\\\"deep-review-findings-registry.json\\\",\\\"utf8\\\"));\\nconst cfg=JSON.parse(fs.readFileSync(base+\\\"deep-review-config.json\\\",\\\"utf8\\\"));\\nconst iter=JSON.parse(fs.readFileSync(base+\\\"iter-003.record.json\\\",\\\"utf8\\\"));\\nconst stable=v=>Array.isArray(v)?`[${v.map(stable).join(\\\",\\\")}]`:v!==null&&typeof v===\\\"object\\\"?`{${Object.keys(v).sort().map(k=>JSON.stringify(k)+\\\":\\\"+stable(v[k])).join(\\\",\\\")}}`:JSON.stringify(v);\\nconst sha=s=>crypto.createHash(\\\"sha256\\\").update(s).digest(\\\"hex\\\");\\nconst signals=conv.graph_signals_json;const observation=sha(stable(signals));\\nconst raw={noveltyRatio:0,coverageRatio:Number(signals.dimensionCoverage)||1,findingStabilityRatio:Number(signals.findingStability)||1,evidenceDensityRatio:Math.min(1,Number(signals.evidenceDensity)||1),hotspotSaturationRatio:Number(signals.hotspotSaturation)||1,observationDigest:observation};\\nconst event={stem:\\\"deep_review.graph_convergence_evaluated\\\",scope:{runId:cfg.sessionId,sessionId:cfg.sessionId,generation:cfg.generation,iterationId:\\\"iteration-3\\\"},data:{rawSignals:raw,weightedSignals:raw,dimensionCoverageDigest:sha(stable(reg.dimensionCoverage||{})),protocolCoverageDigest:sha(stable({})),findingStability:\\\"stable\\\",p0p1ResolutionState:\\\"resolved\\\",evidenceDensity:raw.evidenceDensityRatio,hotspotSaturation:raw.hotspotSaturationRatio,decision:\\\"converged\\\",policyFingerprint:sha(stable({convergenceThreshold:cfg.convergenceThreshold,stopPolicy:cfg.stopPolicy,convergenceMode:cfg.antiConvergence&&cfg.antiConvergence.convergenceMode||\\\"default\\\"})),blockerIds:[],stopCandidate:true,graphDecision:\\\"converged\\\",graphDigest:observation,signals:conv.stop_decision,blockers:[]},eventId:\\\"graph-\\\"+cfg.sessionId+\\\"-g\\\"+cfg.generation+\\\"-i3\\\"};\\nfs.writeFileSync(base+\\\"iter-003.convergence-event.json\\\",JSON.stringify(event));\\nconsole.log(\\\"event written\\\");\\n' && node .skilled/sk