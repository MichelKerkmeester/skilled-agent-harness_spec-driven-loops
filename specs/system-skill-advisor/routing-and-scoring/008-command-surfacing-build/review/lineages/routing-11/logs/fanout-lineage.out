ed by router (hand-curated or stale):\");console.log(diff(signals,D));\nconsole.log(\"\\nD. generated entries not declared (orphans):\");console.log(diff(generated,D));\nconsole.log(\"\\nE. skill-graph vs meta signals diff:\");console.log(\"graph-only:\",diff(skdoc,signals),\"meta-only:\",diff(signals,skdoc));\nconsole.log(\"\\nF. router phrases containing security/sync/hook/mirror/gate:\");console.log(D.filter(x=>/security|sync|hook|mirror|gate/.test(x)));\n'"},"output":"declared all= 381 multi= 328 meta signals= 345 generated= 327 skill-graph= 345\n\nA. declared multiword missing from meta.intent_signals:\n[]\n\nB. declared any phrase missing from meta.intent_signals (dotted/single):\n[\n  'dqi',\n  'flag',\n  'validate',\n  'score',\n  'harden',\n  'audit',\n  '/doc:quality',\n  'optimize',\n  'llms.txt',\n  'llmstxt',\n  'trim',\n  'sk-skill',\n  '/create:sk-skill',\n  'mode-registry.json',\n  'hub-router.json',\n  '/create:skill-parent',\n  'doc-rewrite-guard.py',\n  'render-known-debt.json',\n  '@analyze agent',\n  '/create:agent',\n  'argument-hint',\n  'allowed-tools',\n  '$arguments',\n  '/create:command',\n  'hvr',\n  '/create:manual-testing-playbook',\n  'run-conversation-scenario',\n  'capabilities',\n  '/create:feature-catalog',\n  'readme',\n  'readme.md',\n  '/create:readme',\n  'contributing.md',\n  'security.md',\n  'sync.md',\n  'changelog',\n  'vx.y.z.b',\n  '/create:changelog',\n  'benchmark-report.md',\n  'source.md',\n  'mcp-server/benchmarks',\n  'behavior-benchmark.md',\n  'claude-baseline',\n  'benchmark/readme.md',\n  'behavior_benchmark',\n  'repo-rules',\n  '/create:repo-rule',\n  '/create:goal'\n]\n\nC. meta signals not declared by router (hand-curated or stale):\n[\n  'create parent skill hub',\n  'create feature catalog',\n  'create manual testing playbook',\n  'add a project rule',\n  'write a repo rule',\n  'validate document',\n  'score document quality',\n  'dqi score',\n  'optimize documentation',\n  'scaffold a new skill',\n  'cr