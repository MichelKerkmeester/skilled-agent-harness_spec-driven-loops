-doc',\n.skilled/bin/lib/compiled-routing/009-parent-hub-rollout/007-sk-doc/lib/registry-compiler.cjs:137:      fail('PACKET_KIND_UNSUPPORTED', 'sk-doc modes must remain workflow packets');\n.skilled/bin/lib/compiled-routing/009-parent-hub-rollout/007-sk-doc/lib/registry-compiler.cjs:211:// the combinations the current sk-doc scenario corpus exercises means\n.skilled/bin/lib/compiled-routing/009-parent-hub-rollout/007-sk-doc/lib/registry-compiler.cjs:252:    `Choose one sk-doc workflow mode: ${registry.modes.map((mode) => mode.workflowMode).join(', ')}.`,\n.skilled/bin/lib/compiled-routing/009-parent-hub-rollout/007-sk-doc/lib/policy-card.cjs:9:const CARD_MARKER = 'sk-doc-policy-card-v1';\n.skilled/bin/lib/compiled-routing/009-parent-hub-rollout/007-sk-doc/lib/policy-card.cjs:52:      '# sk-doc Compiled Router Policy Card',\n.skilled/bin/lib/compiled-routing/009-parent-hub-rollout/007-sk-doc/lib/router.cjs:188:    || normalize(`sk-doc/${mode.workflowMode}`) === normalized\n.skilled/bin/lib/compiled-routing/009-parent-hub-rollout/007-sk-doc/harness/build-artifacts.cjs:42:const SKILL_ROOT = path.join(REPO_ROOT, '.opencode', 'skills', 'sk-doc');\n.skilled/bin/lib/compiled-routing/009-parent-hub-rollout/004-cli-external-orchestration/harness/build-artifacts.cjs:149:    source: { featureFile: 'cli-external-orchestration-canary', shape: 'sk-doc' },\n.skilled/bin/lib/compiled-routing/009-parent-hub-rollout/008-cli-classifier/harness/build-artifacts.cjs:111:    source: { featureFile: 'cli-classifier-canary', shape: 'sk-doc' },\n=== files ===\n.skilled/bin/lib/compiled-routing/013-live-activation/activation/cli-classifier/fence-state.json\n.skilled/bin/lib/compiled-routing/013-live-activation/activation/cli-classifier/manifest.json\n.skilled/bin/lib/compiled-routing/013-live-activation/activation/mcp-tooling/fence-state.json\n.skilled/bin/lib/compiled-routing/013-live-activation/activation/mcp-tooling/manifest.json\n.skilled/bin/lib/compiled-routing/013-live-activation/activ