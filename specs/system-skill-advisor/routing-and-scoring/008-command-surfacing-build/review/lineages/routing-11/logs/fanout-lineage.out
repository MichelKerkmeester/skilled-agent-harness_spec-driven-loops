,\\\")}]`:v!==null&&typeof v===\\\"object\\\"?`{${Object.keys(v).sort().map(k=>JSON.stringify(k)+\\\":\\\"+stable(v[k])).join(\\\",\\\")}}`:JSON.stringify(v);\\nconst sha=s=>crypto.createHash(\\\"sha256\\\").update(s).digest(\\\"hex\\\");\\nconst signals=conv.graph_signals_json;\\nconst observation=sha(stable(signals));\\nconst raw={noveltyRatio:iter.newFindingsRatio,coverageRatio:Number(signals.dimensionCoverage)||0,findingStabilityRatio:Number(signals.findingStability)||0,evidenceDensityRatio:Math.min(1,Number(signals.evidenceDensity)||0),hotspotSaturationRatio:Number(signals.hotspotSaturation)||0,observationDigest:observation};\\nconst dimDigest=sha(stable(reg.dimensionCoverage||{}));\\nconst protocolDigest=sha(stable({}));\\nconst policy=sha(stable({convergenceThreshold:cfg.convergenceThreshold,stopPolicy:cfg.stopPolicy,convergenceMode:cfg.antiConvergence&&cfg.antiConvergence.convergenceMode||\\\"default\\\"}));\\nconst sd=conv.stop_decision||{};\\nconst event={stem:\\\"deep_review.graph_convergence_evaluated\\\",scope:{runId:cfg.sessionId,sessionId:cfg.sessionId,generation:cfg.generation,iterationId:\\\"iteration-1\\\"},data:{rawSignals:raw,weightedSignals:raw,dimensionCoverageDigest:dimDigest,protocolCoverageDigest:protocolDigest,findingStability:(raw.findingStabilityRatio>=cfg.convergenceThreshold?\\\"stable\\\":\\\"unstable\\\"),p0p1ResolutionState:((reg.findingsBySeverity&&(reg.findingsBySeverity.P0||0)+(reg.findingsBySeverity.P1||0))>0?\\\"blocked\\\":\\\"resolved\\\"),evidenceDensity:raw.evidenceDensityRatio,hotspotSaturation:raw.hotspotSaturationRatio,decision:\\\"continue\\\",policyFingerprint:policy,blockerIds:[],stopCandidate:false,graphDecision:\\\"converged\\\",graphDigest:observation,signals:sd,blockers:[]},eventId:\\\"graph-\\\"+cfg.sessionId+\\\"-g\\\"+cfg.generation+\\\"-i1\\\"};\\nfs.writeFileSync(base+\\\"iter-001.convergence-event.json\\\",JSON.stringify(event));\\nconsole.log(JSON.stringify({dimDigest,protocolDigest,policy,observation,decisi