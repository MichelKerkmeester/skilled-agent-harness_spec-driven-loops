bin/lib/compiled-routing/013-live-activation/activation/sk-code/fence-state.json\n.skilled/bin/lib/compiled-routing/013-live-activation/activation/sk-code/manifest.json\n.skilled/bin/lib/compiled-routing/013-live-activation/activation/sk-design/fence-state.json\n.skilled/bin/lib/compiled-routing/013-live-activation/activation/sk-design/manifest.json\n.skilled/bin/lib/compiled-routing/013-live-activation/activation/sk-doc/fence-state.json\n.skilled/bin/lib/compiled-routing/013-live-activation/activation/sk-doc/manifest.json\n.skilled/bin/lib/compiled-routing/013-live-activation/activation/cli-external-orchestration/fence-state.json\n.skilled/bin/lib/compiled-routing/013-live-activation/activation/cli-external-orchestration/manifest.json\n.skilled/bin/lib/compiled-routing/serving-closure.manifest.json\n.skilled/bin/lib/compiled-routing/004-compiler-n1-shadow/harness/json-schema.cjs\n.skilled/bin/lib/compiled-routing/004-compiler-n1-shadow/compiler/compiler.cjs\n.skilled/bin/lib/compiled-routing/004-compiler-n1-shadow/compiler/errors.cjs\n.skilled/bin/lib/compiled-routing/004-compiler-n1-shadow/compiler/order.cjs\n.skilled/bin/lib/compiled-routing/014-runtime-engine/lib/resolve.cjs\n.skilled/bin/lib/compiled-routing/014-runtime-engine/lib/compiled-route.cjs\n.skilled/bin/lib/compiled-routing/009-parent-hub-rollout/002-system-deep-loop/harness/build-artifacts.cjs\n.skilled/bin/lib/compiled-routing/009-parent-hub-rollout/002-system-deep-loop/lib/canary-router.cjs\n.skilled/bin/lib/compiled-routing/009-parent-hub-rollout/002-system-deep-loop/lib/policy-card.cjs\n.skilled/bin/lib/compiled-routing/009-parent-hub-rollout/002-system-deep-loop/lib/registry-compiler.cjs\n.skilled/bin/lib/compiled-routing/009-parent-hub-rollout/002-system-deep-loop/fixtures/canary-cases.v1.json\n.skilled/bin/lib/compiled-routing/009-parent-hub-rollout/003-mcp-tooling/harness/build-artifacts.cjs\n.skilled/bin/lib/compiled-routing/009-parent-hub-rollout/003-mcp-tooling/lib/router.cjs\n.skilled/bin/lib/compiled-routing/009-parent-hub-rollout/003-mcp-tooling/lib/policy-card.cjs\n.skilled/bin/lib/compiled-routing/009-parent-hub-rollout/003-mcp-tooling/lib/registry-compiler.cjs\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"cd /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research && rg -n \\\"sk-doc\\\" .skilled/bin/lib/compiled-routing --glob '!**/*.map' | head -20; echo \\\"=== files ===\\\"; find .skilled/bin/lib/compiled-routing -type f | head -30\"}"},"time":{"start":1794851768358,"end":1794851769073}}}}
