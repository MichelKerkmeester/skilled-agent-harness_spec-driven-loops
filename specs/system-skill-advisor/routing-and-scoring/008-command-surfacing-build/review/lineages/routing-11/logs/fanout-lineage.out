al-testing-playbook/resource-loading/references-global-only.md\n.skilled/skills/sk-doc/manual-testing-playbook/resource-loading/mixed-references-assets.md\n.skilled/skills/sk-doc/manual-testing-playbook/token-cost-baseline/max-load.md\n.skilled/skills/sk-doc/changelog/v2.0.1.0.md\n.skilled/skills/sk-doc/manual-testing-playbook/token-cost-baseline/medium-load.md\n.skilled/skills/sk-doc/manual-testing-playbook/token-cost-baseline/minimal-load.md\n.skilled/skills/sk-doc/scripts/tests/test_routing_shape.py\n.skilled/skills/sk-doc/changelog/v2.3.9.0.md\n.skilled/skills/sk-doc/changelog/v2.3.28.0.md\n.skilled/skills/sk-doc/scripts/tests/skill-router/ROUTER.md\n.skilled/skills/sk-doc/manual-testing-playbook/cross-cli-dispatch/multi-step-dispatch.md\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":".skilled/skills/sk-doc/sk-create-manual-testing-playbook/scripts/run-conversation-scenario.cjs\n.skilled/skills/sk-doc/sk-create-readme/assets/hook-readme-template.md\n.skilled/skills/sk-doc/sk-create-benchmark/assets/shared/benchmark-report-template.md\n.skilled/skills/sk-doc/sk-create-benchmark/SKILL.md\n.skilled/skills/sk-doc/sk-create-benchmark/README.md\n.skilled/skills/sk-doc/sk-create-benchmark/manual-testing-playbook/family-routing/leave-in-flight-benchmark.md\n.skilled/skills/sk-doc/shared/scripts/cite-drift-scan.mjs\n.skilled/skills/sk-doc/sk-create-manual-testing-playbook/references/conversation-scenarios.md\n.skilled/skills/sk-doc/sk-create-benchmark/manual-testing-playbook/family-routing/promote-mcp-result.md\n.skilled/skills/sk-doc/sk-create-benchmark/manual-testing-playbook/manual-testing-playbook.md\n.skilled/skills/sk-doc/SKILL.md\n.skilled/skills/sk-doc/shared/scripts/cite-drift-labels.jsonl\n.skilled/skills/sk-doc/ROUTER.md\n.skilled/skills/sk-doc/feature-catalog/packet-authored-registry-routing/leaf-route-replay.md\n.skilled/skills/sk-doc/manual-testing-playbook/manual-testing-playbook