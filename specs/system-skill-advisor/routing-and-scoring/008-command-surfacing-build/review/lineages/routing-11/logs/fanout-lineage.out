.05, defaultShadowWeight: 0.05, live: true },\n] as const satisfies readonly {\n  readonly id: string;\n  readonly defaultWeight: number;\n  readonly defaultShadowWeight: number;\n  readonly live: boolean;\n}[];\n\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"126:- **root-guide leaves.** The install guide, contributing guide and security\n129:  contributing.md\" and \"security.md\" requests. A bare \"security policy\" phrase\n218:    \"SECURITY_POLICY\": {\"weight\": 4, \"keywords\": [\"security.md\"]},\n304:        \"sk-create-readme/assets/security-policy-template.md\"\n438:        \"sk-create-readme/assets/security-policy-template.md\",\n=== skill-graph size ===\n       1   30980 .skilled/skills/system-skill-advisor/runtime/scripts/skill-graph.json\n=== lane registry ===\n// ───────────────────────────────────────────────────────────────\n// MODULE: Advisor Scorer Lane Registry\n// ───────────────────────────────────────────────────────────────\n\nimport type { LaneDampingConfig } from './types.js';\nimport { ADVISOR_BM25_LEXICAL_SHADOW_LANE_ID } from './lanes/bm25.js';\n\nconst LANE_DEFINITIONS = [\n  { id: 'explicit_author', defaultWeight: 0.42, defaultShadowWeight: 0.40, live: true },\n  { id: 'lexical', defaultWeight: 0.28, defaultShadowWeight: 0.25, live: true },\n  { id: 'graph_causal', defaultWeight: 0.13, defaultShadowWeight: 0.20, live: true },\n  { id: 'derived_generated', defaultWeight: 0.12, defaultShadowWeight: 0.10, live: true },\n  { id: 'semantic_shadow', defaultWeight: 0.05, defaultShadowWeight: 0.05, live: true },\n] as const satisfies readonly {\n  readonly id: string;\n  readonly defaultWeight: number;\n  readonly defaultShadowWeight: number;\n  readonly live: boolean;\n}[];\n\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"cd /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research && grep -n '\