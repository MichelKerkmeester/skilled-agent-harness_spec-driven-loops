rs that expand the prompt (e.g. synonym injection)\n// normalize by the ORIGINAL prompt-token count, so adding synonyms can only help\n// recall and never dilutes a true match's score. Defaults to promptTokens.length\n// for callers that pass un-expanded tokens.\nexport function scoreTokenOverlap(\n  promptTokens: readonly string[],\n  candidateText: readonly string[],\n  denominatorBasis: number = promptTokens.length,\n): number {\n  const candidateTokens = new Set(candidateText.flatMap((entry) => tokenize(entry)));\n  if (candidateTokens.size === 0 || promptTokens.length === 0) return 0;\n  let hits = 0;\n  for (const token of promptTokens) {\n    if (candidateTokens.has(token)) {\n      hits += 1;\n      continue;\n    }\n    for (const candidate of candidateTokens) {\n      // A short prompt word inside or at the end of \"allowlist\" (\"list\") names a different concept.\n      // A prompt extension (\"regressions\") or a skill word that adds a suffix (\"plan\" -> \"planning\")\n      // stays related; one that adds a second word (\"auto\" -> \"autoreap\") does not.\n      if (token.length >= 4 && candidate.length >= 4 && (token.includes(candidate) || extendsBySuffix(token, candidate))) {\n        hits += 0.45;\n        break;\n      }\n    }\n  }\n  return Math.min(hits / Math.max(3, denominatorBasis), 1);\n}\n\nexport function isReadOnlyExplainer(promptLower: string): boolean {\n  const readOnly = /\\b(analyze|explain|inspect|summarize|list|show|tell|compare|decompose)\\b/.test(promptLower);\n  const skillSurface = /\\b(review|audit|deep[- ]research|deep[- ]review|semantic search|figma|clickup|chrome devtools|git worktree|prompt)\\b/.test(promptLower);\n  const explicitNoWrite = isNoEditRequest(promptLower);\n  if (skillSurface) return false;\n  if (readOnly && explicitNoWrite) return true;\n  if (/^\\s*(analyze|explain|inspect|summarize|list|show|tell|compare|decompose)\\b/.test(promptLower)\n    && !/\\b(then|and)\\s+(add|build|change|configure|create|edit|fix|generate|implement|modify|move|patch|refactor|rename|replace|run|save|start|update|write)\\b/.test(promptLower)) {\n    return true;\n  }\n  const write = /\\b(add|build|change|configure|create|disable[sd]?|edit|enable[sd]?|execute|fix|generate|implement|modify|patch|refactor|rename|re-?run|run|save|switch (?:on|off)|turn (?:on|off)|update|write)\\b/.test(promptLower);\n  return readOnly && !write && !skillSurface;\n}\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"  return new RegExp(`(?<!\\\\w)${escaped}(?!\\\\w)`).test(text);\n}\n\nexport function phraseSpecificity(phrase: string): number {\n  const count = Math.max(1, tokenize(phrase, true).length);\n  return Math.min(0.7 + 0.18 * (count - 1), 1);\n}\n\n// What a longer skill word may add to a prompt word and still name the same\n// concept: a suffix (\"plan\" -> \"planning\", \"deploy\" -> \"deployment\"). English\n// suffixes start with a vowel or are one of a few consonant-led endings, while a\n// second word added on (\"auto\" -> \"autoreap\", \"open\" -> \"opencode\", \"launch\" ->\n// \"launchpad\") usually starts with a consonant and names something else.\nconst VOWEL_LED_TAIL = /^[aeiouy]/;\nconst CONSONANT_LED_SUFFIX = /^(?:s|d|ly|ment|ments|ness|ful|less)$/;\n// A stem ending in \"e\" drops it before \"-ence\", \"-ent\", \"-er\": \"converge\" -> \"convergence\".\nconst AFTER_FINAL_E_SUFFIX = /^(?:s|d|r|rs|nce|ncy|nt|nts)$/;\n\nfunction extendsBySuffix(stem: string, word: string): boolean {\n  if (word.length <= stem.length || !word.startsWith(stem)) return false;\n  let tail = word.slice(stem.length);\n  if (stem.endsWith('e') && AFTER_FINAL_E_SUFFIX.test(tail)) return true;\n  // A doubled final consonant comes before the suffix: \"plan\" -> \"planning\".\n  if (tail[0] === stem[stem.length - 1] && !VOWEL_LED_TAIL.test(tail)) tail = tail.slice(1);\n  return VOWEL_LED_TAIL.test(tail) || CONSONANT_LED_SUFFIX.test(tail);\n}\n\n// denominatorBasis lets callers that expand the prompt (e.g. synonym injection)\n// normalize by the ORIGINAL prompt-token count, so adding synonyms can only help\n// recall and never dilutes a true match's score. Defaults to promptTokens.length\n// for callers that pass un-expanded tokens.\nexport function scoreTokenOverlap(\n  promptTokens: readonly string[],\n  candidateText: readonly string[],\n  denominatorBasis: number = promptTokens.length,\n): number {\n  const candidateTokens = new Set(candidateText.flatMap((entry) => tokenize(entry)));\n  if (candidateTokens.size === 0 || promptTokens.length === 0) return 0;\n  let hits = 0;\n  for (const token of promptTokens) {\n    if (candidateTokens.has(token)) {\n      hits += 1;\n      continue;\n    }\n    for (const candidate of candidateTokens) {\n      // A short prompt word inside or at the end of \"allowlist\" (\"list\") names a different concept.\n      // A prompt extension (\"regressions\") or a skill word that adds a suffix (\"plan\" -> \"planning\")\n      // stays related; one that adds a second word (\"auto\" -> \"autoreap\") does not.\n      if (token.length >= 4 && candidate.length >= 4 && (token.includes(candidate) || extendsBySuffix(token, candidate))) {\n        hits += 0.45;\n        break;\n      }\n    }\n  }\n  return Math.min(hits / Math.max(3, denominatorBasis), 1);\n}\n\nexport function isReadOnlyExplainer(promptLower: string): boolean {\n  const readOnly = /\\b(analyze|explain|inspect|summarize|list|show|tell|compare|decompose)\\b/.test(promptLower);\n  const skillSurface = /\\b(review|audit|deep[- ]research|deep[- ]review|semantic search|figma|clickup|chrome devtools|git worktree|prompt)\\b/.test(promptLower);\n  const explicitNoWrite = isNoEditRequest(promptLower);\n  if (skillSurface) return false;\n  if (readOnly && explicitNoWrite) return true;\n  if (/^\\s*(analyze|explain|inspect|summarize|list|show|tell|compare|decompose)\\b/.test(promptLower)\n    && !/\\b(then|and)\\s+(add|build|change|configure|create|edit|fix|generate|implement|modify|move|patch|refactor|rename|replace|run|save|start|update|write)\\b/.test(promptLower)) {\n    return true;\n  }\n  const write = /\\b(add|build|change|configure|create|disable[sd]?|edit|enable[sd]?|execute|fix|generate|implement|modify|patch|refactor|rename|re-?run|run|save|switch (?:on|off)|turn (?:on|off)|update|write)\\b/.test(promptLower);\n  return readOnly && !write && !skillSurface;\n}\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"cd /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research && sed -n '90,170p' .skilled/skills/system-skill-advisor/runtime/lib/scorer/text.ts\"}"},"time":{"start":1794852080144,"end":1794852080678}}}}
