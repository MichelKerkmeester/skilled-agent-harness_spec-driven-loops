kflows.md\",\n430:         \"sk-create-readme/assets/architecture-template.md\",\n431:         \"sk-create-readme/assets/contributing-template.md\",\n432:         \"sk-create-readme/assets/hook-readme-template.md\",\n433:         \"sk-create-readme/assets/install-template.md\",\n434:         \"sk-create-readme/assets/readme-code-template.md\",\n435:         \"sk-create-readme/assets/readme-template.md\",\n436:         \"sk-create-readme/assets/runtime-folder-template.md\",\n437:         \"sk-create-readme/assets/runtime-plugin-readme-template.md\",\n438:         \"sk-create-readme/assets/security-policy-template.md\",\n439:         \"sk-create-readme/assets/skill-readme-template.md\",\n440:         \"sk-create-readme/references/README.md\",\n441:         \"sk-create-readme/references/readme/quality-and-checklist.md\",\n442:         \"sk-create-readme/references/readme/types-and-voice.md\",\n443:         \"sk-create-readme/references/readme/writing-patterns.md\",\n444:         \"sk-create-repo-rule/assets/repo-rule-template.md\",\n445:         \"sk-create-repo-rule/assets/repo-rules-router-template.md\",\n446:         \"sk-create-repo-rule/references/README.md\",\n447:         \"sk-create-repo-rule/references/agents-md-integration.md\",\n448:         \"sk-create-repo-rule/references/creation-standards.md\",\n449:         \"sk-create-repo-rule/references/decision-tests.md\",\n450:         \"sk-create-repo-rule/references/rule-anatomy.md\",\n451:         \"sk-create-with-human-voice/assets/voice-report-template.md\",\n452:         \"sk-create-with-human-voice/references/README.md\",\n453:         \"sk-create-with-human-voice/references/hvr-rules.md\",\n454:         \"sk-create-with-human-voice/references/scope-and-exemptions.md\",\n455:         \"sk-create-with-human-voice/references/scoring-and-verification.md\",\n456:         \"sk-create-skill/assets/parent-skill/parent-skill-command-metadata-template.json\",\n457:         \"sk-create-skill/assets/parent-skill/parent-skill-description-template.json\",\n458:         \"sk-create-skill/assets/parent-skill/parent-skill-graph-metadata-template.json\",\n459:         \"sk-create-skill/assets/parent-skill/parent-skill-hub-router-template.json\",\n460:         \"sk-create-skill/assets/parent-skill/parent-skill-hub-template.md\",\n461:         \"sk-create-skill/assets/parent-skill/parent-skill-leaf-aliases-template.json\",\n462:         \"sk-create-skill/assets/parent-skill/parent-skill-readme-template.md\",\n463:         \"sk-create-skill/assets/parent-skill/parent-skill-registry-template.json\",\n464:         \"sk-create-skill/assets/parent-skill/parent-skill-root-router-template.md\",\n465:         \"sk-create-skill/assets/parent-skill/scaffold/hub-skill-scaffold.md\",\n466:         \"sk-create-skill/assets/parent-skill/scaffold/packet-skill-scaffold.md\",\n467:         \"sk-create-skill/assets/skill/skill-asset-template.md\",\n468:         \"sk-create-skill/assets/skill/skill-graph-metadata-template.json\",\n469:         \"sk-create-skill/assets/skill/skill-leaf-manifest-config-template.json\",\n470:         \"sk-create-skill/assets/skill/skill-md-template.md\",\n471:         \"sk-create-skill/assets/skill/skill-procedure-template.md\",\n472:         \"sk-create-skill/assets/skill/skill-reference-template.md\",\n473:         \"sk-create-skill/assets/skill/skill-scaffold-template.md\",\n474:         \"sk-create-skill/assets/skill/skill-smart-router.md\",\n475:         \"sk-create-skill/assets/skill/skill-sync-manifest-template.md\",\n476:         \"sk-create-skill/references/README.md\",\n477:         \"sk-create-skill/references/parent-skill/compiled-routing-architecture.md\",\n478:         \"sk-create-skill/references/parent-skill/compiled-routing-lockstep-surfaces.json\",\n479:         \"sk-create-skill/references/parent-skill/parent-hub-router-schema.md\",\n480:         \"sk-create-skill/references/parent-skill/parent-skills-nested-packets.md\",\n481:         \"sk-create-skill/references/shared/advisor-index-handoff.md\",\n482:         \"sk-create-skill/references/shared/common-pitfalls.md\",\n483:         \"sk-create-skill/references/shared/overview.md\",\n484:         \"sk-create-skill/references/shared/skill-root-metadata-contract.md\",\n485:         \"sk-create-skill/references/shared/validation-and-packaging.md\",\n486:         \"sk-create-skill/references/skill/creation-workflow.md\",\n487:         \"sk-create-skill/references/skill/examples-and-maintenance.md\",\n488:         \"sk-create-skill/references/skill/upgrading-a-skill-to-v4.md\"\n489:     ],\n490: }\n491: ```\n492: \n493: ---\n494: \n495: ## 4. HOW TO READ THIS\n496: \n497: - One dominant intent routes to one mode's leaf set.\n498: - Two near-tied intents (within the ambiguity delta) route to both leaf sets; the\n499:   union is deduped by canonical pair.\n500: - No keyword match is UNKNOWN_FALLBACK: confirm the target artifact and intent\n501:   before loading anything.\n502: - `FULL_INVENTORY` fires only on an explicit \"show the whole toolkit\" request.\n503: - A mode whose `mode-registry.json` row names a `command` has two whole entries: read that command's document in full and follow it under the policy the advisor names, or follow this mode's packet. Pick one and keep to it. A mode whose row has `command: null` has only its packet.\n504: \n505: ---\n506: \n507: ## 5. MACHINE ROUTER\n508: \n509: The hub's detailed routing prose, moved here from `SKILL.md` so the skill body keeps only a short routing summary and a pointer to this file. It sits last, after the stage-two map above, and it declares no map of its own: the `INTENT_SIGNALS` and `RESOURCE_MAP` block in section 3 stays the only replay source.\n510: \n511: > **Compiled routing (default-on, flag-gated, additive).** Resolve the mode via the compiled router contract first:\n512: > ```bash\n513: > node .skilled/bin/compiled-route.cjs --hub sk-doc --prompt \"<task>\"\n514: > ```\n515: > Follow the returned decision — `route` (use its `targets`), `clarify`/`defer` (disambiguate), `reject` (refuse). On a `{\"servingAuthority\":\"legacy\"}` sentinel or any error, use the routing below. The front door self-gates on serving-authority. Compiled routing is now the default for `sk-doc`; set `SPECKIT_COMPILED_ROUTING=0` to force legacy routing fleet-wide — the explicit kill-switch.\n516: \n517: ### Surface Router — per-intent leaf sets\n518: \n519: Stage 2 of routing lives in section 3 of this file.\n520: It defines three things:\n521: - The per-intent leaf model: document quality, optimization, skill creation, parent-hub creation, agent creation, command creation, the paired agent-plus-command lane, the human-voice pass, playbooks, playbook conversations, feature catalogs, READMEs, skill READMEs, root guides, hook and runtime folder READMEs, changelogs, benchmarks, diffs, frontmatter, packet goals, repo rules, and the explicit full-toolkit intent.\n522: - The machine-readable `INTENT_SIGNALS` / `RESOURCE_MAP` block that the deterministic router-replay and benchmarks parse.\n523: - The how-to-read rules: a dominant intent gives one leaf set, near-tied intents give a deduped union, and no keyword match gives the hub UNKNOWN fallback, never a silent default.\n524: \n525: Every `RESOURCE_MAP` path is packet-qualified or an authored shared-alias disk path, and each converts to the canonical `(workflowMode, leafResourceId)` pair at the one contract boundary.\n526: \n527: The reason this file stays a separate document from `SKILL.md` and from `hub-router.json` is in [the parent-skill reference](sk-create-skill/references/parent-skill/parent-skills-nested-packets.md#why-the-leaf-router-stays-in-routermd).\n528: \n529: ### The discriminator\n530: - **`workflowMode`** — the public packet key (e.g. `sk-create-skill`, `sk-create-quality-control`). `sk-create-skill-parent` is a second mode over the same `sk-create-skill` packet.\n531: - **`packetKind`** — `workflow` for every sk-doc packet (there is no surface axis; the sk-create-quality-control pipeline is universal doctrine in `shared/`, not orthogonal stack-evidence).\n532: - **`backendKind`** — `template-scaffold` for the create-* generators, `sk-create-quality-control` for the sk-create-quality-control mode.\n533: \n534: ### Routing rule\n535: ```\n536: SKILL_ROOT = path containing this ROUTER.md and its SKILL.md\n537: REGISTRY = SKILL_ROOT / \"mode-registry.json\"\n538: HUB_ROUTER = SKILL_ROOT / \"hub-router.json\"\n539: \n540: UNKNOWN_FALLBACK_CHECKLIST = [\n541:     \"Confirm whether this is sk-create-skill, sk-create-skill-parent, sk-create-readme, sk-create-agent, sk-create-command, sk-create-feature-catalog, sk-create-manual-testing-playbook, sk-create-benchmark, sk-create-changelog, sk-create-diff, sk-create-repo-rule, sk-create-frontmatter, sk-create-goal, sk-create-with-human-voice, or sk-create-quality-control work\",\n542:     \"Confirm the target document or component being authored, scaffolded, or reviewed\",\n543:     \"Provide the available inputs: existing doc, source material, or scaffold parameters\",\n544:     \"Confirm the validation expectations before completion (DQI/HVR scoring, validate.sh, or packet-specific checks)\",\n545: ]\n546: \n547: def _guard_in_skill(relative_path):\n548:   resolved = (SKILL_ROOT / relative_path).resolve()\n549:   resolved.relative_to(SKILL_ROOT)\n550:   if resolved.suffix.lower() not in {\".md\", \".json\"}:\n551:     raise ValueError(\"only skill-local markdown/json router resources are routable\")\n552:   return resolved.relative_to(SKILL_ROOT).as_posix()\n553: \n554: def load_if_available(relative_path, seen):\n555:   guarded = _guard_in_skill(relative_path)\n556:   if guarded not in seen and (SKILL_ROOT / guarded).exists():\n557:     load(guarded)\n558:     seen.add(guarded)\n559:     return True\n560:   return False\n561: \n562: seen = set()\n563: if not REGISTRY.exists() or not HUB_ROUTER.exists():\n564:   return defer(\"router metadata missing; inspect sk-doc/mode-registry.json and sk-doc/hub-router.json\")\n565: \n566: read mode-registry.json and hub-router.json\n567: classify the request to one or more workflowMode values using hub-router.json\n568:   (dominant authoring/quality intent; a command like /create:agent resolves directly)\n569: \n570: if confidence is low, intent is contradictory, or routerPolicy.defaultMode is null and no mode wins:\n571:   for resource in hub_router.routerPolicy.defaultResource:   # the ordered defer set, never hardcoded here\n572:     load_if_available(resource, seen)\n573:   return UNKNOWN_FALLBACK with disambiguation_checklist = UNKNOWN_FALLBACK_CHECKLIST\n574: \n575: for each resolved workflowMode:\n576:   entry = the matching mode-registry.json modes[] item\n577:   if entry is missing or entry.packetKind != \"workflow\":\n578:     return defer(\"unknown sk-doc workflowMode; extend mode-registry.json and create a packet first\")\n579:   if not load_if_available(f\"{entry.packet}/SKILL.md\", seen):\n580:     return defer(\"registered packet SKILL.md is missing; repair the packet before routing\")\n581: \n582: return single or orderedBundle according to hub-router.json routerPolicy.outcomes\n583: ```\n584: `routerPolicy.defaultMode` is `null`: an unclear documentation intent asks for disambiguation rather than forcing a stale default. `hub-router.json` carries the router signals, vocabulary classes, default fallback resource, and bundle rules. Outcomes are `single`, `orderedBundle`, or `defer` — there is no `surfaceBundle` (no surface axis).\n585: \n586: Per-packet behavior is **not flattened**: each packet keeps its own authoring contract, references, assets, scripts, and templates.\n587: \n588: This hub does **not** use keyed resource discovery (`references/<key>/` or `assets/<key>/`) at the hub root.\n589: There are no hub-root `references/` or `assets/` directories, and packet resources stay inside their owning packet or the shared backbone.\n590: If a future workflow needs keyed resource subdirectories, add that behavior inside the owning packet using guarded runtime discovery.\n591: Do not hardcode resource inventories in this hub."}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\".skilled/skills/sk-doc/ROUTER.md\"}"},"time":{"start":1794851671577,"end":1794851671822}}}}
