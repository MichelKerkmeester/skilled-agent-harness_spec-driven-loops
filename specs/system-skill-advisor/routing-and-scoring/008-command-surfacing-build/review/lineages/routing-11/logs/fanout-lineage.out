ok\", \"readme for this hook\", \"readme for my hook\", \"hook's readme\", \"readme for the ask-surface-guard hook\", \"ask-surface-guard hook readme\", \"readme for the classifier-injection-screen hook\", \"classifier-injection-screen hook readme\", \"readme for the cli-dispatch hook\", \"cli-dispatch hook readme\", \"readme for the codex-global-hooks-check hook\", \"codex-global-hooks-check hook readme\", \"readme for the completion-evidence hook\", \"completion-evidence hook readme\", \"readme for the decision-capture hook\", \"decision-capture hook readme\", \"readme for the directive-lifecycle hook\", \"directive-lifecycle hook readme\", \"readme for the dist-freshness hook\", \"dist-freshness hook readme\", \"readme for the env-secret-guard hook\", \"env-secret-guard hook readme\", \"readme for the git-hooks-check hook\", \"git-hooks-check hook readme\", \"readme for the git-live-follow hook\", \"git-live-follow hook readme\", \"readme for the git-message-gate hook\", \"git-message-gate hook readme\", \"readme for the git-preflight hook\", \"git-preflight hook readme\", \"readme for the git-primary-reconcile hook\", \"git-primary-reconcile hook readme\", \"readme for the git-worktree-guard hook\", \"git-worktree-guard hook readme\", \"readme for the goal hook\", \"goal hook readme\", \"readme for the mcp-route-guard hook\", \"mcp-route-guard hook readme\", \"readme for the overlay-guard hook\", \"overlay-guard hook readme\", \"readme for the permission-policy hook\", \"permission-policy hook readme\", \"readme for the post-edit-quality hook\", \"post-edit-quality hook readme\", \"readme for the session-cleanup hook\", \"session-cleanup hook readme\", \"readme for the session-handover hook\", \"session-handover hook readme\", \"readme for the session-lifecycle hook\", \"session-lifecycle hook readme\", \"readme for the skill-advisor hook\", \"skill-advisor hook readme\", \"readme for the spec-gate hook\", \"spec-gate hook readme\", \"readme for the subagent-dispatch-guard hook\", \"subagent-dispatch-guard hook readme\"]},\n-    \"RUNTIME_PLUGIN_README\": {\"weight\": 16, \"keywords\": [\"plugins folder readme\", \"extensions folder readme\", \"readme for the plugins folder\", \"readme for the extensions folder\", \"readme for a plugin folder\", \"readme for an extension folder\", \"hook mirror readme\"]},\n+    \"SECURITY_POLICY\": {\"weight\": 4, \"keywords\": [\"security.md\"]},\n+    \"HOOK_README\": {\"weight\": 16, \"keywords\": [\"readme for a new hook\", \"readme for a hook\", \"readme for the hook\", \"readme for this hook\", \"readme for my hook\", \"hook's readme\", \"readme for the ask-surface-guard hook\", \"ask-surface-guard hook readme\", \"readme for the classifier-injection-screen hook\", \"classifier-injection-screen hook readme\", \"readme for the cli-dispatch hook\", \"cli-dispatch hook readme\", \"readme for the codex-global-hooks-check hook\", \"codex-global-hooks-check hook readme\", \"readme for the completion-evidence hook\", \"completion-evidence hook readme\", \"readme for the decision-capture hook\", \"decision-capture hook readme\", \"readme for the directive-lifecycle hook\", \"directive-lifecycle hook readme\", \"readme for the dist-freshness hook\", \"dist-freshness hook readme\", \"readme for the env-secret-guard hook\", \"env-secret-guard hook readme\", \"readme for the goal hook\", \"goal hook readme\", \"readme for the mcp-route-guard hook\", \"mcp-route-guard hook readme\", \"readme for the overlay-guard hook\", \"overlay-guard hook readme\", \"readme for the permission-policy hook\", \"permission-policy hook readme\", \"readme for the post-edit-quality hook\", \"post-edit-quality hook readme\", \"readme for the session-cleanup hook\", \"session-cleanup hook readme\", \"readme for the session-handover hook\", \"session-handover hook readme\", \"readme for the session-lifecycle hook\", \"session-lifecycle hook readme\", \"readme for the skill-advisor hook\", \"skill-advisor hook readme\", \"readme for the subagent-dispatch-guard hook\", \"subagent-dispatch-guard hook readme\"]},\n+    \"RUNTIME_PLUGIN_README\": {\"weight\": 16, \"keywords\": [\"plugins folder readme\", \"extensions folder readme\", \"readme for the plugins folder\", \"readme for the extensions folder\", \"readme for a plugin folder\", \"readme for an extension folder\"]},\n     \"RUNTIME_FOLDER\": {\"weight\": 16, \"keywords\": [\"runtime folder readme\", \"readme for a runtime folder\", \"readme for the runtime folder\", \"sync.md\", \"sync doc for the\"]},\n     \"CHANGELOG\": {\"weight\": 4, \"keywords\": [\"changelog\", \"release notes\", \"version notes\", \"release summary\", \"what shipped\", \"since the last version\", \"changelog entry\", \"nested changelog\", \"packet changelog\", \"packet-local changelog\", \"create changelog\", \"global changelog\", \"vx.y.z.b\", \"/create:changelog\"]},\n     \"BENCHMARK\": {\"weight\": 4, \"keywords\": [\"create a benchmark\", \"author a benchmark\", \"benchmark suite\", \"benchmark authoring\", \"behavior benchmark\", \"benchmark-report.md\", \"source.md\", \"mcp-server/benchmarks\", \"behavior-benchmark.md\", \"scenario contract\", \"claude-baseline\", \"benchmark/readme.md\", \"run-label folder\", \"benchmark package\", \"benchmark fixture\", \"benchmark profile\", \"reviewer-prompt fixture\", \"agent quality dimensions\", \"new benchmark\", \"promote benchmark folder\", \"create benchmark\", \"behavior_benchmark\"]},\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"cd /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research && git -c core.fsmonitor=false diff 6d50afe6f39 2f3f893c153 -- .skilled/skills/sk-doc/ROUTER.md 2>&1 | head -200\"}"},"time":{"start":1794851662569,"end":1794851663382}}}}
{"type":"tool_use","timestamp":1794851663393,"sessionID":"ses_e1a82d916ffe3W1SLL4OkhFuu6","part":{"partID":"prt_1e57ee6c0001QW9IVHsS8dYjUj","sessionID":"ses_e1a82d916ffe3W1SLL4OkhFuu6","messageID":"msg_1e57eb2f10012NyWElrT2E7Bup","type":"tool","id":"call_4a8fed06fa97414fb177acae","tool":"shell","state":{"status":"completed","input":{"command":"cd /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research && git log --oneline -3 2>&1; echo \"---DIFF NAMES---\"; git -c core.fsmonitor=false diff --name-status 6d50afe6f39 2f3f893c153 -- .skilled/skills/sk-doc/ROUTER.md .skilled/skills/sk-doc/graph-metadata.json .skilled/skills/system-skill-advisor/runtime/scripts/skill-graph.json 2>&1"},"output":"bad3973440a docs(system-skill-advisor): set up review pass eleven\n2f3f893c153 fix(system-skill-advisor): read a quoted command refusal and fix the install runtime list\n2d36805ea61 fix(sk-doc): narrow the README intents that pulled git and mirror prompts\n---DIFF NAMES---\nM\t.skilled/skills/sk-doc/ROUTER.md\nM\t.skilled/skills/sk-doc/graph-metadata.json\nM\t.skilled/skills/system-skill-advisor/runtime/scripts/skill-graph.json\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"bad3973440a docs(system-skill-advisor): set up review pass eleven\n2f3f893c153 fix(system-skill-advisor): read a quoted command refusal and fix the install runtime list\n2d36805ea61 fix(sk-doc): narrow the README intents that pulled git and mirror prompts\n---DIFF NAMES---\nM\t.skilled/skills/sk-doc/ROUTER.md\nM\t.skilled/skills/sk-doc/graph-metadata.json\nM\t.skilled/skills/system-skill-advisor/runtime/scripts/skill-graph.json\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"cd /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research && git log --oneline -3 2>&1; echo \\\"---DIFF NAMES---\\\"; git -c core.fsmonitor=false diff --name-status 6d50afe6f39 2f3f893c153 -- .skilled/skills/sk-doc/ROUTER.md .skilled/skills/sk-doc/graph-metadata.json .skilled/skills/system-skill-advisor/runtime/scripts/skill-graph.json 2>&1\"}"},"time":{"start":1794851661504,"end":1794851663393}}}}
{"type":"step_finish","timestamp":1794851664490,"sessionID":"ses_e1a82d916ffe3W1SLL4OkhFuu6","part":{"id":"prt_1e57ef26a001ebLhtKojQlxtg0","sessionID":"ses_e1a82d916ffe3W1SLL4OkhFuu6","messageID":"msg_1e57eb2f10012NyWElrT2E7Bup","type":"step-finish","reason":"tool-calls","snapshot":"54ddf6a978af86fe5472976852d7ca646d55ac8a","cost":0,"tokens":{"input":4856,"output":264,"reasoning":1015,"cache":{"read":84480,"write":0}}}}
{"type":"step_start","timestamp":1794851667564,"sessionID":"ses_e1a82d916ffe3W1SLL4OkhFuu6","part":{"id":"prt_1e57efe6c001ldrqTAdEx5YqXC","sessionID":"ses_e1a82d916ffe3W1SLL4OkhFuu6","messageID":"msg_1e57ef2700015TyLGLqtsftFOX","type":"step-start","snapshot":"54ddf6a978af86fe5472976852d7ca646d55ac8a"}}
{"type":"tool_use","timestamp":1794851671822,"sessionID":"ses_e1a82d916ffe3W1SLL4OkhFuu6","part":{"partID":"prt_1e57f0e190020GLY1jZF4pk4M0","sessionID":"ses_e1a82d916ffe3W1SLL4OkhFuu6","messageID":"msg_1e57ef2700015TyLGLqtsftFOX","type":"tool","id":"call_ae05c385e73d423c9648d72b","tool":"read","state":{"status":"completed","input":{"path":".skilled/skills/sk-doc/ROUTER.md"},"output":"Read file .skilled/skills/sk-doc/ROUTER.md, lines 1-591\n1: ---\n2: title: sk-doc Surface Router — per-intent leaf sets\n3: description: First-class surface router document at the sk-doc hub root (ROUTER.md). hub-router.json selects the workflow mode; this doc maps a request's documentation/authoring intent to the exact packet-local leaf resources that mode should load, emitting canonical (workflowMode, leafResourceId) pairs. Relocated verbatim from shared/references/smart-routing.md (v1.0.0.0) as the ROUTER.md consolidation pattern.\n4: trigger_phrases:\n5:   - \"sk-doc surface router\"\n6:   - \"doc authoring resource map\"\n7:   - \"packet leaf resource routing\"\n8:   - \"surface router pattern\"\n9: importance_tier: important\n10: contextType: implementation\n11: version: 2.4.13.0\n12: router_state: active\n13: skill_pointer: SKILL.md\n14: ---\n15: \n16: # sk-doc Surface Router — per-intent leaf sets\n17: \n18: The machine router for [`SKILL.md`](./SKILL.md). `SKILL.md` keeps the short routing prose and the link that points here; this file holds the declaration a reader parses to decide what loads.\n19: \n20: ---\n21: \n22: ## 1. OVERVIEW\n23: \n24: This is sk-doc's second-layer (surface) router, first-class at the hub root as\n25: `ROUTER.md`. The hub selects a workflow mode in [`hub-router.json`](hub-router.json)\n26: (sk-create-skill, sk-create-skill-parent, sk-create-readme, sk-create-agent, sk-create-command,\n27: sk-create-feature-catalog, sk-create-manual-testing-playbook, sk-create-benchmark,\n28: sk-create-changelog, sk-create-diff, sk-create-repo-rule, sk-create-frontmatter,\n29: sk-create-goal, sk-create-with-human-voice, or sk-create-quality-control);\n30: this doc maps a request's documentation/authoring intent to the exact packet-local\n31: leaf resources that mode should load. Every path is either packet-qualified\n32: (`<packet>/references|assets/…`) or an authored shared-alias disk path (`shared/…`),\n33: and both convert to the canonical `(workflowMode, leafResourceId)` pair at the\n34: contract boundary (`sk-doc/sk-create-skill/scripts/lib/leaf-resource-contract.cjs`).\n35: `FULL_INVENTORY` is the single explicit full-toolkit intent — no other intent\n36: enumerates the whole hub.\n37: \n38: Routing is two stages: the hub picks the WORKFLOW mode (mode telemetry), this\n39: router picks the LEAVES within it. The two layers stay separate — the hub never\n40: emits leaf paths, and this router never re-decides the mode.\n41: \n42: ---\n43: \n44: ## 2. INTENT MODEL\n45: \n46: - **doc-quality leaves** — the validation rules, core standards, evergreen\n47:   packet-id rule, and the quality-control workflow a request to validate, audit,\n48:   or score documentation against sk-doc standards loads. Fired by \"documentation\n49:   quality / validate documentation / validate a document / score this document /\n50:   DQI / document audit / review the docs / document for clarity / audit the docs /\n51:   pass review\"\n52:   requests. The scoring phrases mirror `hub-router.json`, so a request that\n53:   reaches the quality mode at stage one also reaches its leaves at stage two.\n54: - **optimization leaves** — the optimization reference and the llms.txt templates\n55:   a request to compress, trim, or token-optimize a doc, or emit a machine-readable\n56:   index loads. Fired by \"optimize / token efficiency / llms.txt / reduce tokens /\n57:   slim down\" requests.\n58: - **skill-creation leaves** — the skill creation workflow and the skill.md and\n59:   reference templates a request to scaffold or author a new skill loads.\n60:   Fired by \"create a skill / skill.md scaffold / resource_map wiring / package a\n61:   capability\" requests. The skill README template is not in this set: the\n62:   `sk-create-readme` mode owns it, and skill creation hands its README step there.\n63: - **parent-hub leaves.** The nested-packet contract, the hub-router schema and\n64:   the four parent-hub templates a request to build or rewire a parent hub loads.\n65:   Fired by \"parent hub / parent skill / mode packet / nested workflow packet /\n66:   mode-registry.json / hub-router.json\" requests, the file names spelled in full\n67:   so a bare \"hub router\" in an unrelated sentence does not fire it. This is the leaf set for the\n68:   `sk-create-skill-parent` mode, which shares the `sk-create-skill` packet but\n69:   not its leaves: a plain skill request must not pull the hub templates.\n70: - **render-ledger leaves.** The validation reference that explains the render\n71:   ledger's debt, exempt and pinned records and the doc rewrite guard, and the\n72:   maintenance workflow that runs the guard before a rewrite is committed. Fired\n73:   by \"doc rewrite guard / render ledger / render-known-debt.json / exempt from\n74:   the render checks / kept every claim\" requests. It belongs to the\n75:   `sk-create-skill` mode, which owns the ledger.\n76: - **agent-creation leaves.** The agent README and agent template a request to\n77:   scaffold an OpenCode agent loads. Fired by \"create an agent / new agent /\n78:   agent frontmatter / permission object / @analyze agent\" requests.\n79: - **command-creation leaves.** The command README and command template a\n80:   request to scaffold a slash command loads. Fired by \"create a command / slash\n81:   command / argument-hint / allowed-tools / thin router\" requests.\n82: - **agent-command leaves.** Both packets' READMEs and templates a request to\n83:   author an agent together with its paired `/create` command loads. Fired only\n84:   by the two paired phrases, \"agent and paired\" and \"paired /create\", which no\n85:   single-artifact request carries. The paired intent stays separate rather than\n86:   being expressed as the union of the two above, because the router keeps only\n87:   intents within one point of the top score: a paired request that also names\n88:   the agent would otherwise drop the command half.\n89: - **diagram and chart leaves belong to the `sk-design` hub.** ASCII flowchart,\n90:   decision-tree and standalone HTML chart authoring is `sk-design-diagram` and\n91:   `sk-design-chart` work, and this router declares no intent for it: `/design:diagram`\n92:   and `/design:chart` are the entry points, so \"flowchart\", \"ascii\", \"process diagram\",\n93:   \"create a chart\" and \"plot the data\" reach no key in the two maps below.\n94: - **human-voice leaves** — the scope gate, the scoring method and the Human\n95:   Voice Rules standard a request to apply or score that standard loads. Fired\n96:   by \"hvr / human voice rules / apply human voice / rewrite in human voice /\n97:   make this sound human / sounds ai-generated / remove ai tells\" requests. The\n98:   scope gate is the always-loaded leaf, because deciding what a voice edit may\n99:   touch comes before deciding what to change.\n100: - **playbook leaves** — the manual-testing-playbook README a request to author a\n101:   manual testing playbook loads. Fired by \"playbook system / manual testing\n102:   playbook / testing playbook / playbook scenario / manual test\n103:   scenario\" requests.\n104: - **playbook-conversation leaves** — the conversation-scenario reference and the\n105:   conversation snippet template a request to write a multi-turn json conversation script for\n106:   a playbook scenario loads. Fired by \"playbook conversation / multi-turn\n107:   conversation script / json conversation / conversation runner\" requests. This\n108:   intent scores double. \"manual testing playbook\" also matches \"testing\n109:   playbook\", so that one phrase scores the playbook intent twice, and at equal\n110:   weight a request naming both a playbook and a conversation would load only the\n111:   playbook README. At double weight the two tie and both leaf sets load.\n112: - **feature-catalog leaves** — the feature-catalog README a request to inventory a\n113:   project's features / capabilities loads. Fired by \"feature catalog / feature\n114:   inventory / capabilities\" requests.\n115: - **readme-creation leaves** — the readme README and readme template a request to\n116:   author a project README / front-page overview loads. Fired by \"create a readme /\n117:   readme for / project overview / landing doc\" requests.\n118: - **skill-readme leaves.** The readme README and the skill README template a\n119:   request to write a skill package's README loads, including the README step a\n120:   new skill hands over. Fired by \"skill readme / readme for my new skill / readme\n121:   for this skill\" requests. This intent scores four times the base weight,\n122:   because every such request also says \"readme\", \"a readme\" and \"readme for\",\n123:   which score the readme-creation intent up to four times. At the base weight\n124:   the skill template would never load. At this weight the skill intent ties or\n125:   beats the readme-creation intent, so the skill template always loads.\n126: - **root-guide leaves.** The install guide, contributing guide and security\n127:   policy templates, one intent each, for the guides that sit beside a\n128:   repository's front page. Fired by \"install guide\", \"contributing guide /\n129:   contributing.md\" and \"security.md\" requests. A bare \"security policy\" phrase\n130:   is left out, because it pulled a request that was not a README into this\n131:   skill.\n132: - **hook-readme leaves.** The readme README and the hook folder template a\n133:   request to write the README of a shared hook folder loads. Fired by \"readme\n134:   for a new hook / readme for this hook\" requests and by the named shared\n135:   hooks. No phrase is a bare \"hook readme\", because \"webhook readme\" would\n136:   contain it. The `git-*` and `spec-gate` hooks are not named, because their\n137:   names carry \"git\", \"hooks\" and \"gate\", which belong to git and spec work.\n138: - **runtime-plugin-readme leaves.** The readme README and the runtime plugin\n139:   template a request to write the README of a plugin, extension or hook mirror\n140:   folder loads. Fired by \"plugins folder readme / readme for the extensions\n141:   folder\" requests. \"hook mirror readme\" is left out, because \"mirror\" belongs\n142:   to the runtime mirror doctor.\n143: - **runtime-folder leaves.** The readme README and the runtime folder template\n144:   a request to write a runtime folder's README or its `SYNC.md` loads. Fired by\n145:   \"runtime folder readme / sync.md / sync doc for the\"\n146:   requests. The three readme intents above score four times the base weight\n147:   for the reason the skill-readme intent does: their phrases also score the\n148:   readme-creation intent up to three times.\n149: - **changelog leaves** — the changelog template a request to author release notes\n150:   / version notes loads. Fired by \"changelog / release notes / what shipped /\n151:   since the last version\" requests.\n152: - **benchmark leaves** — the benchmark shared README, worked example, and report\n153:   template a request to author a behavior benchmark\n154:   loads. Fired by \"create a benchmark / benchmark suite / behavior benchmark\"\n155:   requests.\n156: - **diff leaves** — the diff README, workflow, and worked example a request to\n157:   produce a before/after document diff loads. Fired by \"document diff / before\n158:   and after diff / visual document diff\" requests.\n159: - **repo-rule leaves** — the four decision tests, the rule anatomy contract, the\n160:   creation standards, the wiring contract, the rule and router templates, and the\n161:   packet reference map a\n162:   request to add, change, or remove a repo-local rule loads. Fired by \"repo rule /\n163:   project rule / REPO RULES.md / trigger table / retire a repo rule\" requests. Most such\n164:   requests end in a refusal, so `decision-tests.md` is the always-loaded leaf.\n165: - **frontmatter leaves** — the field reference and the versioning standard a\n166:   request about a frontmatter block itself loads. Fired by \"yaml frontmatter /\n167:   frontmatter block / frontmatter field / description budget / 4-part version /\n168:   frontmatter versioning\" requests. The phrases are qualified rather than bare,\n169:   because `agent frontmatter` belongs to agent-creation and a bare \"frontmatter\"\n170:   would take that route away from it. The field reference is the always-loaded\n171:   leaf, because resolving the document class comes before any field rule.\n172: - **goal-authoring leaves** — the goal authoring standards, the goal exemplars,\n173:   the parent/nested goal workflows and the budget/handoff reference a request to\n174:   author or revise a packet's `goal.md` loads. Fired by \"packet goal / goal.md /\n175:   goal document / author goal.md / phase parent goal / goal criteria /\n176:   completion checks\" requests. The phrases are qualified rather than bare,\n177:   because a bare \"goal\" and the session verbs belong to session-goal management\n178:   (set, bind, update, resend), which the goal hooks and host commands own. The\n179:   authoring standards are the always-loaded leaf, because what a goal must state\n180:   comes before how one is phrased.\n181: - **full-inventory leaves** — the entire sk-doc toolkit. `FULL_INVENTORY` is the\n182:   single explicit full-toolkit intent; no other intent enumerates the whole hub.\n183:   Fired only by an explicit \"show the full sk-doc toolkit / everything sk-doc\n184:   offers\" request.\n185: \n186: A single dominant documentation axis routes to one mode's leaf set; two clearly\n187: separate axes route to both.\n188: \n189: ---\n190: \n191: ## 3. MACHINE-READABLE ROUTER (replay / benchmark source)\n192: \n193: The single machine-readable projection of the intent model above. The prose is the\n194: human-facing contract; this block is the byte-for-byte source the deterministic\n195: router-replay parses. Keep them in sync: when a map row changes above, update the\n196: matching `RESOURCE_MAP` entry here. Every `RESOURCE_MAP` path resolves on disk and\n197: dual-reads to a canonical typed pair through `leaf-manifest.json` or the hub's\n198: `leaf-aliases.json`.\n199: \n200: ```python\n201: INTENT_SIGNALS = {\n202:     \"DOC_QUALITY\": {\"weight\": 4, \"keywords\": [\"documentation quality\", \"doc quality\", \"validate documentation\", \"validate a document\", \"validate this document\", \"validate markdown\", \"validation rules\", \"score this document\", \"score this doc\", \"dqi\", \"document audit\", \"fail sk-doc standards\", \"review the docs\", \"review the documentation\", \"document for clarity\", \"check the docs\", \"check the documentation\", \"audit the docs\", \"documentation review bar\", \"quality bar\", \"flag\", \"meet our standards\", \"audit documentation quality\", \"ai-friendly documentation\", \"extract structure\", \"validate\", \"score\", \"harden\", \"audit\", \"/doc:quality\"]},\n203:     \"OPTIMIZATION\": {\"weight\": 4, \"keywords\": [\"optimize\", \"token efficiency\", \"llms.txt\", \"llmstxt\", \"reduce tokens\", \"fewer tokens\", \"trim\", \"compress the doc\", \"slim down\", \"model's budget\", \"machine-readable index\", \"optimize this doc\"]},\n204:     \"SKILL_CREATION\": {\"weight\": 4, \"keywords\": [\"sk-skill\", \"create a new sk\", \"create sk-\", \"skill.md scaffold\", \"skill.md and starter\", \"resource_map wiring\", \"new skill\", \"create a skill\", \"build a skill\", \"author a skill\", \"scaffold a skill\", \"reusable capability\", \"reusable helper\", \"starter reference docs\", \"new capability\", \"capability module\", \"package a capability\", \"create skill\", \"skill scaffold\", \"opencode skill\", \"package skill\", \"which json files does a skill need\", \"skill root metadata contract\", \"leaf-manifest config aliases required\", \"/create:sk-skill\"]},\n205:     \"PARENT_HUB\": {\"weight\": 4, \"keywords\": [\"parent hub\", \"parent skill\", \"mode packet\", \"mode packets\", \"nested packet\", \"nested workflow packet\", \"mode-registry.json\", \"hub-router.json\", \"hub versus standalone skill class\", \"skill hub\", \"/create:skill-parent\"]},\n206:     \"RENDER_LEDGER\": {\"weight\": 4, \"keywords\": [\"doc rewrite guard\", \"doc-rewrite-guard.py\", \"rewrite guard\", \"render ledger\", \"render-known-debt.json\", \"exempt from the render checks\", \"render exempt map\", \"kept every claim\", \"kept every original claim\"]},\n207:     \"AGENT_CREATION\": {\"weight\": 4, \"keywords\": [\"create an agent\", \"create agent\", \"new agent\", \"author an agent\", \"scaffold an agent\", \"agent file\", \"agent persona\", \"agent frontmatter\", \"agent template\", \"permission object\", \"authority boundary\", \"agent registry\", \"@analyze agent\", \"opencode agent\", \"claude code agent\", \"/create:agent\", \"new agent definition\", \"specialist persona file\"]},\n208:     \"COMMAND_CREATION\": {\"weight\": 4, \"keywords\": [\"create a command\", \"create command\", \"slash command\", \"new slash command\", \"author a command\", \"scaffold a command\", \"argument-hint\", \"allowed-tools\", \"command template\", \"router presentation split\", \"thin router\", \"presentation contract\", \"opencode command\", \"$arguments\", \"/create:command\", \"prompt shortcut\", \"reusable prompt shortcut\"]},\n209:     \"AGENT_COMMAND\": {\"weight\": 4, \"keywords\": [\"agent and paired\", \"paired /create\"]},\n210:     \"HVR\": {\"weight\": 4, \"keywords\": [\"hvr\", \"human voice rules\", \"apply human voice\", \"rewrite in human voice\", \"make this sound human\", \"sounds 