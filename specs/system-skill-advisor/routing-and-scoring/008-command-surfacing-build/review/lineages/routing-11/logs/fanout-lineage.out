,\n\"mirror the runtime folder\",\n\"gate the spec before merge\",\n\"run the spec gate\",\n\"documentation quality pass on the readme\"\n];\nfor(const p of prompts){const sc=score(p);const top=sc.length?sc[0].score:0;const kept=sc.filter(x=>top-x.score<=delta);console.log(\"\\nPROMPT: \"+p);console.log(\"  scores: \"+(sc.map(x=>x.intent+\"=\"+x.score).join(\", \")||\"(none)\"));console.log(\"  kept: \"+(kept.map(x=>x.intent).join(\", \")||\"UNKNOWN\"));}\n'"},"output":"<anonymous_script>:1\nINTENT_SIGNALS = {\n               ^\n\nTypeError: Assignment to constant variable.\n    at eval (eval at <anonymous> ([eval]:8:1), <anonymous>:1:16)\n    at [eval]:8:1\n    at runScriptInThisContext (node:internal/vm:219:10)\n    at node:internal/process/execution:485:12\n    at [eval]-wrapper:6:24\n    at runScriptInContext (node:internal/process/execution:483:60)\n    at evalFunction (node:internal/process/execution:317:30)\n    at evalTypeScript (node:internal/process/execution:329:3)\n    at node:internal/main/eval_string:71:3\n\nNode.js v26.13.0\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":1},"content":[{"type":"text","text":"<anonymous_script>:1\nINTENT_SIGNALS = {\n               ^\n\nTypeError: Assignment to constant variable.\n    at eval (eval at <anonymous> ([eval]:8:1), <anonymous>:1:16)\n    at [eval]:8:1\n    at runScriptInThisContext (node:internal/vm:219:10)\n    at node:internal/process/execution:485:12\n    at [eval]-wrapper:6:24\n    at runScriptInContext (node:internal/process/execution:483:60)\n    at evalFunction (node:internal/process/execution:317:30)\n    at evalTypeScript (node:internal/process/execution:329:3)\n    at node:internal/main/eval_string:71:3\n\nNode.js v26.13.0\n"},{"type":"text","text":"Exit code: 1"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"cd /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research && node -e '\\nconst fs