eferences/readme/writing-patterns.md\",\n444:         \"sk-create-repo-rule/assets/repo-rule-template.md\",\n445:         \"sk-create-repo-rule/assets/repo-rules-router-template.md\",\n446:         \"sk-create-repo-rule/references/README.md\",\n447:         \"sk-create-repo-rule/references/agents-md-integration.md\",\n448:         \"sk-create-repo-rule/references/creation-standards.md\",\n449:         \"sk-create-repo-rule/references/decision-tests.md\",\n450:         \"sk-create-repo-rule/references/rule-anatomy.md\",\n451:         \"sk-create-with-human-voice/assets/voice-report-template.md\",\n452:         \"sk-create-with-human-voice/references/README.md\",\n453:         \"sk-create-with-human-voice/references/hvr-rules.md\",\n454:         \"sk-create-with-human-voice/references/scope-and-exemptions.md\",\n455:         \"sk-create-with-human-voice/references/scoring-and-verification.md\",\n456:         \"sk-create-skill/assets/parent-skill/parent-skill-command-metadata-template.json\",\n457:         \"sk-create-skill/assets/parent-skill/parent-skill-description-template.json\",\n458:         \"sk-create-skill/assets/parent-skill/parent-skill-graph-metadata-template.json\",\n459:         \"sk-create-skill/assets/parent-skill/parent-skill-hub-router-template.json\",\n460:         \"sk-create-skill/assets/parent-skill/parent-skill-hub-template.md\",\n461:         \"sk-create-skill/assets/parent-skill/parent-skill-leaf-aliases-template.json\",\n462:         \"sk-create-skill/assets/parent-skill/parent-skill-readme-template.md\",\n463:         \"sk-create-skill/assets/parent-skill/parent-skill-registry-template.json\",\n464:         \"sk-create-skill/assets/parent-skill/parent-skill-root-router-template.md\",\n465:         \"sk-create-skill/assets/parent-skill/scaffold/hub-skill-scaffold.md\",\n466:         \"sk-create-skill/assets/parent-skill/scaffold/packet-skill-scaffold.md\",\n467:         \"sk-create-skill/assets/skill/skill-asset-template.md\",\n468:         \"sk-create-skill/assets/skill/skill-graph-metadata-template.json\",\n469:         \"sk-create-skill/assets/skill/skill-leaf-manifest-config-template.json\",\n470:         \"sk-create-skill/assets/skill/skill-md-template.md\",\n471:         \"sk-create-skill/assets/skill/skill-procedure-template.md\",\n472:         \"sk-create-skill/assets/skill/skill-reference-template.md\",\n473:         \"sk-create-skill/assets/skill/skill-scaffold-template.md\",\n474:         \"sk-create-skill/assets/skill/skill-smart-router.md\",\n475:         \"sk-create-skill/assets/skill/skill-sync-manifest-template.md\",\n476:         \"sk-create-skill/references/README.md\",\n477:         \"sk-create-skill/references/parent-skill/compiled-routing-architecture.md\",\n478:         \"sk-create-skill/references/parent-skill/compiled-routing-lockstep-surfaces.json\",\n479:         \"sk-create-skill/references/parent-skill/parent-hub-router-schema.md\",\n480:         \"sk-create-skill/references/parent-skill/parent-skills-nested-packets.md\",\n481:         \"sk-create-skill/references/shared/advisor-index-handoff.md\",\n482:         \"sk-create-skill/references/shared/common-pitfalls.md\",\n483:         \"sk-create-skill/references/shared/overview.md\",\n484:         \"sk-create-skill/references/shared/skill-root-metadata-contract.md\",\n485:         \"sk-create-skill/references/shared/validation-and-packaging.md\",\n486:         \"sk-create-skill/references/skill/creation-workflow.md\",\n487:         \"sk-create-skill/references/skill/examples-and-maintenance.md\",\n488:         \"sk-create-skill/references/skill/upgrading-a-skill-to-v4.md\"\n489:     ],\n490: }\n491: ```\n492: \n493: ---\n494: \n495: ## 4. HOW TO READ THIS\n496: \n497: - One dominant intent routes to one mode's leaf set.\n498: - Two near-tied intents (within the ambiguity delta) route to both leaf sets; the\n499:   union is deduped by canonical pair.\n500: - No keyword match is UNKNOWN_FALLBACK: confirm the target artifact and intent\n501:   before loading anything.\n502: - `FULL_INVENTORY` fires only on an explicit \"show the whole toolkit\" request.\n503: - A mode whose `mode-registry.json` row names a `command` has two whole entries: read that command's document in full and follow it under the policy the advisor names, or follow this mode's packet. Pick one and keep to it. A mode whose row has `command: null` has only its packet.\n504: \n505: ---\n506: \n507: ## 5. MACHINE ROUTER\n508: \n509: The hub's detailed routing prose, moved here from `SKILL.md` so the skill body keeps only a short routing summary and a pointer to this file. It sits last, after the stage-two map above, and it declares no map of its own: the `INTENT_SIGNALS` and `RESOURCE_MAP` block in section 3 stays the only replay source.\n510: \n511: > **Compiled routing (default-on, flag-gated, additive).** Resolve the mode via the compiled router contract first:\n512: > ```bash\n513: > node .skilled/bin/compiled-route.cjs --hub sk-doc --prompt \"<task>\"\n514: > ```\n515: > Follow the returned decision — `route` (use its `targets`), `clarify`/`defer` (disambiguate), `reject` (refuse). On a `{\"servingAuthority\":\"legacy\"}` sentinel or any error, use the routing below. The front door self-gates on serving-authority. Compiled routing is now the default for `sk-doc`; set `SPECKIT_COMPILED_ROUTING=0` to force legacy routing fleet-wide — the explicit kill-switch.\n516: \n517: ### Surface Router — per-intent leaf sets\n518: \n519: Stage 2 of routing lives in section 3 of this file.\n520: It defines three things:\n521: - The per-intent leaf model: document quality, optimization, skill creation, parent-hub creation, agent creation, command creation, the paired agent-plus-command lane, the human-voice pass, playbooks, playbook conversations, feature catalogs, READMEs, skill READMEs, root guides, hook and runtime folder READMEs, changelogs, benchmarks, diffs, frontmatter, packet goals, repo rules, and the explicit full-toolkit intent.\n522: - The machine-readable `INTENT_SIGNALS` / `RESOURCE_MAP` block that the deterministic router-replay and benchmarks parse.\n523: - The how-to-read rules: a dominant intent gives one leaf set, near-tied intents give a deduped union, and no keyword match gives the hub UNKNOWN fallback, never a silent default.\n524: \n525: Every `RESOURCE_MAP` path is packet-qualified or an authored shared-alias disk path, and each converts to the canonical `(workflowMode, leafResourceId)` pair at the one contract boundary.\n526: \n527: The reason this file stays a separate document from `SKILL.md` and from `hub-router.json` is in [the parent-skill reference](sk-create-skill/references/parent-skill/parent-skills-nested-packets.md#why-the-leaf-router-stays-in-routermd).\n528: \n529: ### The discriminator\n530: - **`workflowMode`** — the public packet key (e.g. `sk-create-skill`, `sk-create-quality-control`). `sk-create-skill-parent` is a second mode over the same `sk-create-skill` packet.\n531: - **`packetKind`** — `workflow` for every sk-doc packet (there is no surface axis; the sk-create-quality-control pipeline is universal doctrine in `shared/`, not orthogonal stack-evidence).\n532: - **`backendKind`** — `template-scaffold` for the create-* generators, `sk-create-quality-control` for the sk-create-quality-control mode.\n533: \n534: ### Routing rule\n535: ```\n536: SKILL_ROOT = path containing this ROUTER.md and its SKILL.md\n537: REGISTRY = SKILL_ROOT / \"mode-registry.json\"\n538: HUB_ROUTER = SKILL_ROOT / \"hub-router.json\"\n539: \n540: UNKNOWN_FALLBACK_CHECKLIST = [\n541:     \"Confirm whether this is sk-create-skill, sk-create-skill-parent, sk-create-readme, sk-create-agent, sk-create-command, sk-create-feature-catalog, sk-create-manual-testing-playbook, sk-create-benchmark, sk-create-changelog, sk-create-diff, sk-create-repo-rule, sk-create-frontmatter, sk-create-goal, sk-create-with-human-voice, or sk-create-quality-control work\",\n542:     \"Confirm the target document or component being authored, scaffolded, or reviewed\",\n543:     \"Provide the available inputs: existing doc, source material, or scaffold parameters\",\n544:     \"Confirm the validation expectations before completion (DQI/HVR scoring, validate.sh, or packet-specific checks)\",\n545: ]\n546: \n547: def _guard_in_skill(relative_path):\n548:   resolved = (SKILL_ROOT / relative_path).resolve()\n549:   resolved.relative_to(SKILL_ROOT)\n550:   if resolved.suffix.lower() not in {\".md\", \".json\"}:\n551:     raise ValueError(\"only skill-local markdown/json router resources are routable\")\n552:   return resolved.relative_to(SKILL_ROOT).as_posix()\n553: \n554: def load_if_available(relative_path, seen):\n555:   guarded = _guard_in_skill(relative_path)\n556:   if guarded not in seen and (SKILL_ROOT / guarded).exists():\n557:     load(guarded)\n558:     seen.add(guarded)\n559:     return True\n560:   return False\n561: \n562: seen = set()\n563: if not REGISTRY.exists() or not HUB_ROUTER.exists():\n564:   return defer(\"router metadata missing; inspect sk-doc/mode-registry.json and sk-doc/hub-router.json\")\n565: \n566: read mode-registry.json and hub-router.json\n567: classify the request to one or more workflowMode values using hub-router.json\n568:   (dominant authoring/quality intent; a command like /create:agent resolves directly)\n569: \n570: if confidence is low, intent is contradictory, or routerPolicy.defaultMode is null and no mode wins:\n571:   for resource in hub_router.routerPolicy.defaultResource:   # the ordered defer set, never hardcoded here\n572:     load_if_available(resource, seen)\n573:   return UNKNOWN_FALLBACK with disambiguation_checklist = UNKNOWN_FALLBACK_CHECKLIST\n574: \n575: for each resolved workflowMode:\n576:   entry = the matching mode-registry.json modes[] item\n577:   if entry is missing or entry.packetKind != \"workflow\":\n578:     return defer(\"unknown sk-doc workflowMode; extend mode-registry.json and create a packet first\")\n579:   if not load_if_available(f\"{entry.packet}/SKILL.md\", seen):\n580:     return defer(\"registered packet SKILL.md is missing; repair the packet before routing\")\n581: \n582: return single or orderedBundle according to hub-router.json routerPolicy.outcomes\n583: ```\n584: `routerPolicy.defaultMode` is `null`: an unclear documentation intent asks for disambiguation rather than forcing a stale default. `hub-router.json` carries the router signals, vocabulary classes, default fallback resource, and bundle rules. Outcomes are `single`, `orderedBundle`, or `defer` — there is no `surfaceBundle` (no surface axis).\n585: \n586: Per-packet behavior is **not flattened**: each packet keeps its own authoring contract, references, assets, scripts, and templates.\n587: \n588: This hub does **not** use keyed resource discovery (`references/<key>/` or `assets/<key>/`) at the hub root.\n589: There are no hub-root `references/` or `assets/` directories, and packet resources stay inside their owning packet or the shared backbone.\n590: If a future workflow needs keyed resource subdirectories, add that behavior inside the owning packet using guarded runtime discovery.\n591: Do not hardcode resource inventories in this hub.","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file .skilled/skills/sk-doc/ROUTER.md, lines 1-591\n1: ---\n2: title: sk-doc Surface Router — per-intent leaf sets\n3: description: First-class surface router document at the sk-doc hub root (ROUTER.md). hub-router.json selects the workflow mode; this doc maps a request's documentation/authoring intent to the exact packet-local leaf resources that mode should load, emitting canonical (workflowMode, leafResourceId) pairs. Relocated verbatim from shared/references/smart-routing.md (v1.0.0.0) as the ROUTER.md consolidation pattern.\n4: trigger_phrases:\n5:   - \"sk-doc surface router\"\n6:   - \"doc authoring resource map\"\n7:   - \"packet leaf resource routing\"\n8:   - \"surface router pattern\"\n9: importance_tier: important\n10: contextType: implementation\n11: version: 2.4.13.0\n12: router_state: active\n13: skill_pointer: SKILL.md\n14: ---\n15: \n16: # sk-doc Surface Router — per-intent leaf sets\n17: \n18: The machine router for [`SKILL.md`](./SKILL.md). `SKILL.md` keeps the short routing prose and the link that points here; this file holds the declaration a reader parses to decide what loads.\n19: \n20: ---\n21: \n22: ## 1. OVERVIEW\n23: \n24: This is sk-doc's second-layer (surface) router, first-class at the hub root as\n25: `ROUTER.md`. The hub selects a workflow mode in [`hub-router.json`](hub-router.json)\n26: (sk-create-skill, sk-create-skill-parent, sk-create-readme, sk-create-agent, sk-create-command,\n27: sk-create-feature-catalog, sk-create-manual-testing-playbook, sk-create-benchmark,\n28: sk-create-changelog, sk-create-diff, sk-create-repo-rule, sk-create-frontmatter,\n29: sk-create-goal, sk-create-with-human-voice, or sk-create-quality-control);\n30: this doc maps a request's documentation/authoring intent to the exact packet-local\n31: leaf resources that mode should load. Every path is either packet-qualified\n32: (`<packet>/references|assets/…`) or an authored shared-alias disk path (`shared/…`),\n33: and both convert to the canonical `(workflowMode, leafResourceId)` pair at the\n34: contract boundary (`sk-doc/sk-create-skill/scripts/lib/leaf-resource-contract.cjs`).\n35: `FULL_INVENTORY` is the single explicit full-toolkit intent — no other intent\n36: enumerates the whole hub.\n37: \n38: Routing is two stages: the hub picks the WORKFLOW mode (mode telemetry), this\n39: router picks the LEAVES within it. The two layers stay separate — the hub never\n40: emits leaf paths, and this router never re-decides the mode.\n41: \n42: ---\n43: \n44: ## 2. INTENT MODEL\n45: \n46: - **doc-quality leaves** — the validation rules, core standards, evergreen\n47:   packet-id rule, and the quality-control workflow a request to validate, audit,\n48:   or score documentation against sk-doc standards loads. Fired by \"documentation\n49:   quality / validate documentation / validate a document / score this document /\n50:   DQI / document audit / review the docs / document for clarity / audit the docs /\n51:   pass review\"\n52:   requests. The scoring phrases mirror `hub-router.json`, so a request that\n53:   reaches the quality mode at stage one also reaches its leaves at stage two.\n54: - **optimization leaves** — the optimization reference and the llms.txt templates\n55:   a request to compress, trim, or token-optimize a doc, or emit a machine-readable\n56:   index loads. Fired by \"optimize / token efficiency / llms.txt / reduce tokens /\n57:   slim down\" requests.\n58: - **skill-creation leaves** — the skill creation workflow and the skill.md and\n59:   reference templates a request to scaffold or author a new skill loads.\n60:   Fired by \"create a skill / skill.md scaffold / resource_map wiring / package a\n61:   capability\" requests. The skill README template is not in this set: the\n62:   `sk-create-readme` mode owns it, and skill creation hands its README step there.\n63: - **parent-hub leaves.** The nested-packet contract, the hub-router schema and\n64:   the four parent-hub templates a request to build or rewire a parent hub loads.\n65:   Fired by \"parent hub / parent skill / mode packet / nested workflow packet /\n66:   mode-registry.json / hub-router.json\" requests, the file names spelled in full\n67:   so a bare \"hub router\" in an unrelated sentence does not fire it. This is the leaf set for the\n68:   `sk-create-skill-parent` mode, which shares the `sk-create-skill` packet but\n69:   not its leaves: a plain skill request must not pull the hub templates.\n70: - **render-ledger leaves.** The validation reference that explains the render\n71:   ledger's debt, exempt and pinned records and the doc rewrite guard, and the\n72:   maintenance workflow that runs the guard before a rewrite is committed. Fired\n73:   by \"doc rewrite guard / render ledger / render-known-debt.json / exempt from\n74:   the render checks / kept every claim\" requests. It belongs to the\n75:   `sk-create-skill` mode, which owns the ledger.\n76: - **agent-creation leaves.** The agent README and agent template a request to\n77:   scaffold an OpenCode agent loads. Fired by \"create an agent / new agent /\n78:   agent frontmatter / permission object / @analyze agent\" requests.\n79: - **command-creation leaves.** The command README and command template a\n80:   request to scaffold a slash command loads. Fired by \"create a command / slash\n81:   command / argument-hint / allowed-tools / thin router\" requests.\n82: - **agent-command leaves.** Both packets' READMEs and templates a request to\n83:   author an agent together with its paired `/create` command loads. Fired only\n84:   by the two paired phrases, \"agent and paired\" and \"paired /create\", which no\n85:   single-artifact request carries. The paired intent stays separate rather than\n86:   being expressed as the union of the two above, because the router keeps only\n87:   intents within one point of the top score: a paired request that also names\n88:   the agent would otherwise drop the command half.\n89: - **diagram and chart leaves belong to the `sk-design` hub.** ASCII flowchart,\n90:   decision-tree and standalone HTML chart authoring is `sk-design-diagram` and\n91:   `sk-design-chart` work, and this router declares no intent for it: `/design:diagram`\n92:   and `/design:chart` are the entry points, so \"flowchart\", \"ascii\", \"process diagram\",\n93:   \"create a chart\" and \"plot the data\" reach no key in the two maps below.\n94: - **human-voice leaves** — the scope gate, the scoring method and the Human\n95:   Voice Rules standard a request to apply or score that standard loads. Fired\n96:   by \"hvr / human voice rules / apply human voice / rewrite in human voice /\n97:   make this sound human / sounds ai-generated / remove ai tells\" requests. The\n98:   scope gate is the always-loaded leaf, because deciding what a voice edit may\n99:   touch comes before deciding what to change.\n100: - **playbook leaves** — the manual-testing-playbook README a request to author a\n101:   manual testing playbook loads. Fired by \"playbook system / manual testing\n102:   playbook / testing playbook / playbook scenario / manual test\n103:   scenario\" requests.\n104: - **playbook-conversation leaves** — the conversation-scenario reference and the\n105:   conversation snippet template a request to write a multi-turn json conversation script for\n106:   a playbook scenario loads. Fired by \"playbook conversation / multi-turn\n107:   conversation script / json conversation / conversation runner\" requests. This\n108:   intent scores double. \"manual testing playbook\" also matches \"testing\n109:   playbook\", so that one phrase scores the playbook intent twice, and at equal\n110:   weight a request naming both a playbook and a conversation would load only the\n111:   playbook README. At double weight the two tie and both leaf sets load.\n112: - **feature-catalog leaves** — the feature-catalog README a request to inventory a\n113:   project's features / capabilities loads. Fired by \"feature catalog / feature\n114:   inventory / capabilities\" requests.\n115: - **readme-creation leaves** — the readme README and readme template a request to\n116:   author a project README / front-page overview loads. Fired by \"create a readme /\n117:   readme for / project overview / landing doc\" requests.\n118: - **skill-readme leaves.** The readme README and the skill README template a\n119:   request to write a skill package's README loads, including the README step a\n120:   new skill hands over. Fired by \"skill readme / readme for my new skill / readme\n121:   for this skill\" requests. This intent scores four times the base weight,\n122:   because every such request also says \"readme\", \"a readme\" and \"readme for\",\n123:   which score the readme-creation intent up to four times. At the base weight\n124:   the skill template would never load. At this weight the skill intent ties or\n125:   beats the readme-creation intent, so the skill template always loads.\n126: - **root-guide leaves.** The install guide, contributing guide and security\n127:   policy templates, one intent each, for the guides that sit beside a\n128:   repository's front page. Fired by \"install guide\", \"contributing guide /\n129:   contributing.md\" and \"security.md\" requests. A bare \"security policy\" phrase\n130:   is left out, because it pulled a request that was not a README into this\n131:   skill.\n132: - **hook-readme leaves.** The readme README and the hook folder template a\n133:   request to write the README of a shared hook folder loads. Fired by \"readme\n134:   for a new hook / readme for this hook\" requests and by the named shared\n135:   hooks. No phrase is a bare \"hook readme\", because \"webhook readme\" would\n136:   contain it. The `git-*` and `spec-gate` hooks are not named, because their\n137:   names carry \"git\", \"hooks\" and \"gate\", which belong to git and spec work.\n138: - **runtime-plugin-readme leaves.** The readme README and the runtime plugin\n139:   template a request to write the README of a plugin, extension or hook mirror\n140:   folder loads. Fired by \"plugins folder readme / readme for the extensions\n141:   folder\" requests. \"hook mirror readme\" is left out, because \"mirror\" belongs\n142:   to the runtime mirror doctor.\n143: - **runtime-folder leaves.** The readme README and the runtime folder template\n144:   a request to write a runtime folder's README or its `SYNC.md` loads. Fired by\n145:   \"runtime folder readme / sync.md / sync doc for the\"\n146:   requests. The three readme intents above score four times the base weight\n147:   for the reason the skill-readme intent does: their phrases also score the\n148:   readme-creation intent up to three times.\n149: - **changelog leaves** — the changelog template a request to author release notes\n150:   / version notes loads. Fired by \"changelog / release notes / what shipped /\n151:   since the last version\" requests.\n152: - **benchmark leaves** — the benchmark shared README, worked example, and report\n153:   template a request to author a behavior benchmark\n154:   loads. Fired by \"create a benchmark / benchmark suite / behavior benchmark\"\n155:   requests.\n156: - **diff leaves** — the diff README, workflow, and worked example a request to\n157:   produce a before/after document diff loads. Fired by \"document diff / before\n158:   and after diff / visual document diff\" requests.\n159: - **repo-rule leaves** — the four decision tests, the rule anatomy contract, the\n160:   creation standards, the wiring contract, the rule and router templates, and the\n161:   packet reference map a\n162:   request to add, change, or remove a repo-local rule loads. Fired by \"repo rule /\n163:   project rule / REPO RULES.md / trigger table / retire a repo rule\" requests. Most such\n164:   requests end in a refusal, so `decision-tests.md` is the always-loaded leaf.\n165: - **frontmatter leaves** — the field reference and the versioning standard a\n166:   request about a frontmatter block itself loads. Fired by \"yaml frontmatter /\n167:   frontmatter block / frontmatter field / description budget / 4-part version /\n168:   frontmatter versioning\" requests. The phrases are qualified rather than bare,\n169:   because `agent frontmatter` belongs to agent-creation and a bare \"frontmatter\"\n170:   would take that route away from it. The field reference is the always-loaded\n171:   leaf, because resolving the document class comes before any field rule.\n172: - **goal-authoring leaves** — the goal authoring standards, the goal exemplars,\n173:   the parent/nested goal workflows and the budget/handoff reference a request to\n174:   author or revise a packet's `goal.md` loads. Fired by \"packet goal / goal.md /\n175:   goal document / author goal.md / phase parent goal / goal criteria /\n176:   completion checks\" requests. The phrases are qualified rather than bare,\n177:   because a bare \"goal\" and the session verbs belong to session-goal management\n178:   (set, bind, update, resend), which the goal hooks and host commands own. The\n179:   authoring standards are the always-loaded leaf, because what a goal must state\n180:   comes before how one is phrased.\n181: - **full-inventory leaves** — the entire sk-doc toolkit. `FULL_INVENTORY` is the\n182:   single explicit full-toolkit intent; no other intent enumerates the whole hub.\n183:   Fired only by an explicit \"show the full sk-doc toolkit / everything sk-doc\n184:   offers\" request.\n185: \n186: A single dominant documentation axis routes to one mode's leaf set; two clearly\n187: separate axes route to both.\n188: \n189: ---\n190: \n191: ## 3. MACHINE-READABLE ROUTER (replay / benchmark source)\n192: \n193: The single machine-readable projection of the intent model above. The prose is the\n194: human-facing contract; this block is the byte-for-byte source the deterministic\n195: router-replay parses. Keep them in sync: when a map row changes above, update the\n196: matching `RESOURCE_MAP` entry here. Every `RESOURCE_MAP` path resolves on disk and\n197: dual-reads to a canonical typed pair through `leaf-manifest.json` or the hub's\n198: `leaf-aliases.json`.\n199: \n200: ```python\n201: INTENT_SIGNALS = {\n202:     \"DOC_QUALITY\": {\"weight\": 4, \"keywords\": [\"documentation quality\", \"doc quality\", \"validate documentation\", \"validate a document\", \"validate this document\", \"validate markdown\", \"validation rules\", \"score this document\", \"score this doc\", \"dqi\", \"document audit\", \"fail sk-doc standards\", \"review the docs\", \"review the documentation\", \"document for clarity\", \"check the docs\", \"check the documentation\", \"audit the docs\", \"documentation review bar\", \"quality bar\", \"flag\", \"meet our standards\", \"audit documentation quality\", \"ai-friendly documentation\", \"extract structure\", \"validate\", \"score\", \"harden\", \"audit\", \"/doc:quality\"]},\n203:     \"OPTIMIZATION\": {\"weight\": 4, \"keywords\": [\"optimize\", \"token efficiency\", \"llms.txt\", \"llmstxt\", \"reduce tokens\", \"fewer tokens\", \"trim\", \"compress the doc\", \"slim down\", \"model's budget\", \"machine-readable index\", \"optimize this doc\"]},\n204:     \"SKILL_CREATION\": {\"weight\": 4, \"keywords\": [\"sk-skill\", \"create a new sk\", \"create sk-\", \"skill.md scaffold\", \"skill.md and starter\", \"resource_map wiring\", \"new skill\", \"create a skill\", \"build a skill\", \"author a skill\", \"scaffold a skill\", \"reusable capability\", \"reusable helper\", \"starter reference docs\", \"new capability\", \"capability module\", \"package a capability\", \"create skill\", \"skill scaffold\", \"opencode skill\", \"package skill\", \"which json files does a skill need\", \"skill root metadata contract\", \"leaf-manifest config aliases required\", \"/create:sk-skill\"]},\n205:     \"PARENT_HUB\": {\"weight\": 4, \"keywords\": [\"parent hub\", \"parent skill\", \"mode packet\", \"mode packets\", \"nested packet\", \"nested workflow packet\", \"mode-registry.json\", \"hub-router.json\", \"hub versus standalone skill class\", \"skill hub\", \"/create:skill-parent\"]},\n206:     \"RENDER_LEDGER\": {\"weight\": 4, \"keywords\": [\"doc rewrite guard\", \"doc-rewrite-guard.py\", \"rewrite guard\", \"render ledger\", \"render-known-debt.json\", \"exempt from the render checks\", \"render exempt map\", \"kept every claim\", \"kept every original claim\"]},\n207:     \"AGENT_CREATION\": {\"weight\": 4, \"keywords\": [\"create an agent\", \"create agent\", \"new agent\", \"author an agent\", \"scaffold an agent\", \"agent file\", \"agent persona\", \"agent frontmatter\", \"agent template\", \"permission object\", \"authority boundary\", \"agent registry\", \"@analyze agent\", \"opencode agent\", \"claude code agent\", \"/create:agent\", \"new agent definition\", \"specialist persona file\"]},\n208:     \"COMMAND_CREATION\": {\"weight\": 4, \"keywords\": [\"create a command\", \"create command\", \"slash command\", \"new slash command\", \"author a command\", \"scaffold a command\", \"argument-hint\", \"allowed-tools\", \"command template\", \"router presentation split\", \"thin router\", \"presentation contract\", \"opencode command\", \"$arguments\", \"/create:command\", \"prompt shortcut\", \"reusable prompt shortcut\"]},\n209:     \"AGENT_COMMAND\": {\"weight\": 4, \"keywords\": [\"agent and paired\", \"paired /create\"]},\n210:     \"HVR\": {\"weight\": 4, \"keywords\": [\"hvr\", \"human voice rules\", \"apply human voice\", \"rewrite in human voice\", \"make this sound human\", \"sounds ai-generated\", \"reads like ai wrote it\", \"reads like a machine wrote it\", \"remove ai tells\", \"ai writing tells\", \"voice pass\", \"de-ai the writing\", \"banned word check\", \"human voice\"]},\n211:     \"PLAYBOOK\": {\"weight\": 4, \"keywords\": [\"playbook system\", \"manual testing playbook\", \"testing playbook\", \"deterministic scenario\", \"evidence collection\", \"operator validation\", \"multi-agent execution\", \"release readiness\", \"playbook scenario\", \"manual test scenario\", \"/create:manual-testing-playbook\"]},\n212:     \"PLAYBOOK_CONVERSATION\": {\"weight\": 8, \"keywords\": [\"playbook conversation\", \"multi-turn conversation script\", \"json conversation\", \"conversation runner\", \"run-conversation-scenario\"]},\n213:     \"FEATURE_CATALOG\": {\"weight\": 4, \"keywords\": [\"feature catalog\", \"feature inventory\", \"catalog of features\", \"features overview\", \"capabilities\", \"catalog package\", \"per-feature files\", \"source anchors\", \"root catalog\", \"capability inventory\", \"/create:feature-catalog\"]},\n214:     \"README_CREATION\": {\"weight\": 4, \"keywords\": [\"create a readme\", \"readme for\", \"a readme\", \"front-page overview\", \"project overview\", \"getting started doc\", \"intro doc\", \"overview doc\", \"landing doc\", \"create readme\", \"readme\", \"folder readme\", \"write readme\", \"readme.md\", \"code folder readme\", \"/create:readme\"]},\n215:     \"SKILL_README\": {\"weight\": 16, \"keywords\": [\"skill readme\", \"readme for my new skill\", \"readme for a new skill\", \"readme for my skill\", \"readme for a skill\", \"readme for the skill\", \"readme for this skill\", \"skill's readme\"]},\n216:     \"INSTALL_GUIDE\": {\"weight\": 4, \"keywords\": [\"install guide\"]},\n217:     \"CONTRIBUTING_GUIDE\": {\"weight\": 4, \"keywords\": [\"contributing guide\", \"contributing.md\"]},\n218:     \"SECURITY_POLICY\": {\"weight\": 4, \"keywords\": [\"security.md\"]},\n219:     \"HOOK_README\": {\"weight\": 16, \"keywords\": [\"readme for a new hook\", \"readme for a hook\", \"readme for the hook\", \"readme for this hook\", \"readme for my hook\", \"hook's readme\", \"readme for the ask-surface-guard hook\", \"ask-surface-guard hook readme\", \"readme for the classifier-injection-screen hook\", \"classifier-injection-screen hook readme\", \"readme for the cli-dispatch hook\", \"cli-dispatch hook readme\", \"readme for the codex-global-hooks-check hook\", \"codex-global-hooks-check hook readme\", \"readme for the completion-evidence hook\", \"completion-evidence hook readme\", \"readme for the decision-capture hook\", \"decision-capture hook readme\", \"readme for the directive-lifecycle hook\", \"directive-lifecycle hook readme\", \"readme for the dist-freshness hook\", \"dist-freshness hook readme\", \"readme for the env-secret-guard hook\", \"env-secret-guard hook readme\", \"readme for the goal hook\", \"goal hook readme\", \"readme for the mcp-route-guard hook\", \"mcp-route-guard hook readme\", \"readme for the overlay-guard hook\", \"overlay-guard hook readme\", \"readme for the permission-policy hook\", \"permission-policy hook readme\", \"readme for the post-edit-quality hook\", \"post-edit-quality hook readme\", \"readme for the session-cleanup hook\", \"session-cleanup hook readme\", \"readme for the session-handover hook\", \"session-handover hook readme\", \"readme for the session-lifecycle hook\", \"session-lifecycle hook readme\", \"readme for the skill-advisor hook\", \"skill-advisor hook readme\", \"readme for the subagent-dispatch-guard hook\", \"subagent-dispatch-guard hook readme\"]},\n220:     \"RUNTIME_PLUGIN_README\": {\"weight\": 16, \"keywords\": [\"plugins folder readme\", \"extensions folder readme\", \"readme for the plugins folder\", \"readme for the extensions folder\", \"readme for a plugin folder\", \"readme for an extension folder\"]},\n221:     \"RUNTIME_FOLDER\": {\"weight\": 16, \"keywords\": [\"runtime folder readme\", \"readme for a runtime folder\", \"readme for the runtime folder\", \"sync.md\", \"sync doc for the\"]},\n222:     \"CHANGELOG\": {\"weight\": 4, \"keywords\": [\"changelog\", \"release notes\", \"version notes\", \"release summary\", \"what shipped\", \"since the last version\", \"changelog entry\", \"nested changelog\", \"packet changelog\", \"packet-local changelog\", \"create changelog\", \"global changelog\", \"vx.y.z.b\", \"/create:changelog\"]},\n223:     \"BENCHMARK\": {\"weight\": 4, \"keywords\": [\"create a benchmark\", \"author a benchmark\", \"benchmark suite\", \"benchmark authoring\", \"behavior benchmark\", \"benchmark-report.md\", \"source.md\", \"mcp-server/benchmarks\", \"behavior-benchmark.md\", \"scenario contract\", \"claude-baseline\", \"benchmark/readme.md\", \"run-label folder\", \"benchmark package\", \"benchmark fixture\", \"benchmark profile\", \"reviewer-prompt fixture\", \"agent quality dimensions\", \"new benchmark\", \"promote benchmark folder\", \"create benchmark\", \"behavior_benchmark\"]},\n224:     \"DIFF\": {\"weight\": 4, \"keywords\": [\"document diff\", \"doc diff\", \"diff document\", \"before and after diff\", \"before/after diff\", \"visual document diff\", \"create diff report\", \"document before after review\", \"before after document diff\", \"document change report\", \"before and after document\", \"document before/after review\", \"before/after document diff\", \"review document edits\", \"docx diff\", \"pdf diff\", \"before and after my rewrite\"]},\n225:     \"REPO_RULE\": {\"weight\": 4, \"keywords\": [\"repo rule\", \"repo-rules\", \"repo rules\", \"project rule\", \"repo rule file\", \"REPO RULES.md\", \"trigger table\", \"rule router\", \"retire a rule\", \"retire a repo rule\", \"revise a rule\", \"revise a repo rule\", \"add a repo rule\", \"always-loaded rule\", \"rule that binds\", \"create repo rule\", \"new repo rule\", \"repo-local rule\", \"we should always\", \"stop doing\", \"add a rule\", \"/create:repo-rule\"]},\n226:     \"FRONTMATTER\": {\"weight\": 4, \"keywords\": [\"yaml frontmatter\", \"frontmatter block\", \"frontmatter template\", \"frontmatter field\", \"frontmatter fields\", \"trigger_phrases\", \"trigger phrases\", \"importance_tier\", \"contextType\", \"description budget\", \"4-part version\", \"X.Y.Z.W\", \"frontmatter versioning\", \"frontmatter version\", \"version field\", \"frontmatter validation\", \"missing frontmatter\", \"frontmatter contract\", \"yaml header\", \"goes at the top of the file\", \"version number at the top\", \"importance tier\", \"versioning pass\", \"stopped showing up in suggestions\", \"validator says my file is missing\", \"description too long\", \"edit count\", \"field the validator wants\"]},\n227:     \"GOAL_AUTHORING\": {\"weight\": 4, \"keywords\": [\"create packet goal\", \"packet goal\", \"goal.md\", \"author goal.md\", \"revise packet goal\", \"phase parent goal\", \"nested phase child goal\", \"nested goal\", \"add a goal file\", \"write a goal file\", \"draft a goal file\", \"goal file\", \"goal document\", \"goal criteria\", \"completion checks\", \"measurable criteria\", \"durable objective\", \"phase objective\", \"parent objective\", \"objective for a packet\", \"phase-child goal\", \"child-phase goal\", \"binding table\", \"goal chat slice\", \"/create:goal\", \"intent file\"]},\n228:     \"FULL_INVENTORY\": {\"weight\": 4, \"keywords\": [\"full sk-doc toolkit\", \"all templates\", \"entire toolkit\", \"everything sk-doc offers\"]},\n229: }\n230: \n231: RESOURCE_MAP = {\n232:     \"DOC_QUALITY\": [\n233:         \"shared/references/validation.md\",\n234:         \"sk-create-quality-control/references/workflows.md\",\n235:         \"shared/references/core-standards.md\",\n236:         \"shared/references/evergreen-packet-id-rule.md\"\n237:     ],\n238:     \"OPTIMIZATION\": [\n239:         \"sk-create-quality-control/references/optimization.md\",\n240:         \"shared/assets/llmstxt-templates.md\"\n241:     ],\n242:     \"SKILL_CREATION\": [\n243:         \"sk-create-skill/references/skill/creation-workflow.md\",\n244:         \"sk-create-skill/assets/skill/skill-md-template.md\",\n245:         \"sk-create-skill/assets/skill/skill-reference-template.md\"\n246:     ],\n247:     \"RENDER_LEDGER\": [\n248:         \"sk-create-skill/references/shared/validation-and-packaging.md\",\n249:         \"sk-create-skill/references/skill/examples-and-maintenance.md\"\n250:     ],\n251:     \"PARENT_HUB\": [\n252:         \"sk-create-skill/references/parent-skill/parent-skills-nested-packets.md\",\n253:         \"sk-create-skill/references/parent-skill/parent-hub-router-schema.md\",\n254:         \"sk-create-skill/assets/parent-skill/parent-skill-hub-template.md\",\n255:         \"sk-create-skill/assets/parent-skill/parent-skill-registry-template.json\",\n256:         \"sk-create-skill/assets/parent-skill/parent-skill-hub-router-template.json\",\n257:         \"sk-create-skill/assets/parent-skill/parent-skill-root-router-template.md\"\n258:     ],\n259:     \"AGENT_CREATION\": [\n260:         \"sk-create-agent/references/README.md\",\n261:         \"sk-create-agent/assets/agent-template.md\"\n262:     ],\n263:     \"COMMAND_CREATION\": [\n264:         \"sk-create-command/references/README.md\",\n265:         \"sk-create-command/assets/command-template.md\"\n266:     ],\n267:     \"AGENT_COMMAND\": [\n268:         \"sk-create-agent/references/README.md\",\n269:         \"sk-create-agent/assets/agent-template.md\",\n270:         \"sk-create-command/references/README.md\",\n271:         \"sk-create-command/assets/command-template.md\"\n272:     ],\n273:     \"HVR\": [\n274:         \"sk-create-with-human-voice/references/scope-and-exemptions.md\",\n275:         \"sk-create-with-human-voice/references/scoring-and-verification.md\",\n276:         \"sk-create-with-human-voice/assets/voice-report-template.md\",\n277:         \"sk-create-with-human-voice/references/hvr-rules.md\"\n278:     ],\n279:     \"PLAYBOOK\": [\n280:         \"sk-create-manual-testing-playbook/references/README.md\"\n281:     ],\n282:     \"PLAYBOOK_CONVERSATION\": [\n283:         \"sk-create-manual-testing-playbook/references/conversation-scenarios.md\",\n284:         \"sk-create-manual-testing-playbook/assets/manual-testing-playbook-conversation-snippet-template.md\"\n285:     ],\n286:     \"FEATURE_CATALOG\": [\n287:         \"sk-create-feature-catalog/references/README.md\"\n288:     ],\n289:     \"README_CREATION\": [\n290:         \"sk-create-readme/references/README.md\",\n291:         \"sk-create-readme/assets/readme-template.md\"\n292:     ],\n293:     \"SKILL_README\": [\n294:         \"sk-create-readme/references/README.md\",\n295:         \"sk-create-readme/assets/skill-readme-template.md\"\n296:     ],\n297:     \"INSTALL_GUIDE\": [\n298:         \"sk-create-readme/assets/install-template.md\"\n299:     ],\n300:     \"CONTRIBUTING_GUIDE\": [\n301:         \"sk-create-readme/assets/contributing-template.md\"\n302:     ],\n303:     \"SECURITY_POLICY\": [\n304:         \"sk-create-readme/assets/security-policy-template.md\"\n305:     ],\n306:     \"HOOK_README\": [\n307:         \"sk-create-readme/references/README.md\",\n308:         \"sk-create-readme/assets/hook-readme-template.md\"\n309:     ],\n310:     \"RUNTIME_PLUGIN_README\": [\n311:         \"sk-create-readme/references/README.md\",\n312:         \"sk-create-readme/assets/runtime-plugin-readme-template.md\"\n313:     ],\n314:     \"RUNTIME_FOLDER\": [\n315:         \"sk-create-readme/references/README.md\",\n316:         \"sk-create-readme/assets/runtime-folder-template.md\"\n317:     ],\n318:     \"CHANGELOG\": [\n319:         \"sk-create-changelog/assets/changelog-template.md\"\n320:     ],\n321:     \"BENCHMARK\": [\n322:         \"sk-create-benchmark/references/shared/README.md\",\n323:         \"sk-create-benchmark/references/shared/worked-example.md\",\n324:         \"sk-create-benchmark/assets/shared/benchmark-report-template.md\"\n325:     ],\n326:     \"DIFF\": [\n327:         \"sk-create-diff/references/README.md\",\n328:         \"sk-create-diff/references/workflow.md\",\n329:         \"sk-create-diff/references/worked-example.md\"\n330:     ],\n331:     \"REPO_RULE\": [\n332:         \"sk-create-repo-rule/references/decision-tests.md\",\n333:         \"sk-create-repo-rule/references/rule-anatomy.md\",\n334:         \"sk-create-repo-rule/references/creation-standards.md\",\n335:         \"sk-create-repo-rule/references/agents-md-integration.md\",\n336:         \"sk-create-repo-rule/assets/repo-rule-template.md\",\n337:         \"sk-create-repo-rule/assets/repo-rules-router-template.md\",\n338:         \"sk-create-repo-rule/references/README.md\"\n339:     ],\n340:     \"FRONTMATTER\": [\n341:         \"sk-create-frontmatter/assets/frontmatter-templates.md\",\n342:         \"sk-create-frontmatter/references/frontmatter-versioning.md\",\n343:         \"sk-create-frontmatter/references/README.md\"\n344:     ],\n345:     \"GOAL_AUTHORING\": [\n346:         \"sk-create-goal/references/authoring-standards.md\",\n347:         \"sk-create-goal/assets/goal-exemplars.md\",\n348:         \"sk-create-goal/references/parent-and-nested-goals.md\",\n349:         \"sk-create-goal/references/budget-and-handoff.md\",\n350:         \"sk-create-goal/assets/goal-top-level-template.md\",\n351:         \"sk-create-goal/assets/goal-phase-parent-template.md\",\n352:         \"sk-create-goal/assets/goal-phase-child-template.md\"\n353:     ],\n354:     \"FULL_INVENTORY\": [\n355:         \"sk-create-agent/assets/agent-template.md\",\n356:         \"sk-create-agent/references/README.md\",\n357:         \"sk-create-agent/references/agent-vs-skill-vs-command.md\",\n358:         \"sk-create-agent/references/common-pitfalls.md\",\n359:         \"sk-create-agent/references/permission-design.md\",\n360:         \"sk-create-frontmatter/assets/fixtures/README.md\",\n361:         \"sk-create-frontmatter/assets/fixtures/over-budget-description.md\",\n362:         \"sk-create-frontmatter/assets/fixtures/under-budget-trim-lost-tokens.md\",\n363:         \"sk-create-frontmatter/assets/frontmatter-templates.md\",\n364:         \"sk-create-frontmatter/references/README.md\",\n365:         \"sk-create-frontmatter/references/frontmatter-versioning.md\",\n366:         \"sk-create-goal/assets/goal-exemplars.md\",\n367:         \"sk-create-goal/assets/goal-phase-child-template.md\",\n368:         \"sk-create-goal/assets/goal-phase-parent-template.md\",\n369:         \"sk-create-goal/assets/goal-top-level-template.md\",\n370:         \"sk-create-goal/references/authoring-standards.md\",\n371:         \"sk-create-goal/references/budget-and-handoff.md\",\n372:         \"sk-create-goal/references/parent-and-nested-goals.md\",\n373:         \"sk-create-benchmark/assets/behavior-benchmark/behavior-benchmark-baseline-template.md\",\n374:         \"sk-create-benchmark/assets/behavior-benchmark/behavior-benchmark-index-template.md\",\n375:         \"sk-cre