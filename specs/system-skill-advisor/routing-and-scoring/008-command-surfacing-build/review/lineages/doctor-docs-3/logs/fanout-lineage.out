oks: [{ type: 'command', command: `/usr/bin/env node ${CLAUDE_MARKER}` }] }],\n158:    UserPromptSubmit: [{ hooks: [{ type: 'command', command: `bash -lc \"node ${CLAUDE_MARKER}\"` }] }],\n168:    UserPromptSubmit: [{ hooks: [{ type: 'command', command: `zsh -c 'node ${CLAUDE_MARKER}'` }] }],\n178:    UserPromptSubmit: [{ hooks: [{ type: 'command', command: `node --no-warnings ${CLAUDE_MARKER}` }] }],\n188:    UserPromptSubmit: [{ hooks: [{ type: 'command', command: `cd \"\\$PWD\"&& node ${CLAUDE_MARKER}` }] }],\n198:    UserPromptSubmit: [{ hooks: [{ type: 'command', command: `cd /tmp; node ${CLAUDE_MARKER}` }] }],\n208:    UserPromptSubmit: [{ hooks: [{ type: 'command', command: `echo \"x && node ${CLAUDE_MARKER}\"` }] }],\n212:  assert.match(result.out, /^hook-missing claude \\.claude\\/settings\\.json$/m);\n238:      UserPromptSubmit: [{ hooks: [{ type: 'command', command: build(CLAUDE_MARKER) }] }],\n===\n291:function runsMarker(command, marker, depth = 0) {\n296:    return script !== null && runsMarker(script.text, marker, depth + 1);\n300:function inspect(runtime, root) {\n309:  const wired = collectCommands(payload, []).some((command) => runsMarker(command, runtime.marker));\n323:    return inspect(runtime, opts.root);\n338:if (require.main === module) {\n347:module.exports = { main, eventPayload };\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"rg -n \\\"CLAUDE_MARKER|function fixture|const fixture|hook-missing\\\" .skilled/commands/doctor/scripts/tests/hook-wiring-check.test.cjs | head -20; echo ===; rg -n \\\"runsMarker|inspect\\\\(|module.exports|require.main\\\" .skilled/commands/doctor/scripts/hook-wiring-check.cjs\"}"},"time":{"start":1794593569493,"end":1794593570297}}}}
