{"type":"tool_use","timestamp":1794593586944,"sessionID":"ses_e29e5c0b9ffed1u4GCgcaPeWZq","part":{"partID":"prt_1d61cfa39001SFLMS1jKxLVQJQ","sessionID":"ses_e29e5c0b9ffed1u4GCgcaPeWZq","messageID":"msg_1d61cd0fb001WpVU2VOuszW0xc","type":"tool","id":"call_d7bb10a71b574c5cb4f30f4f","tool":"read","state":{"status":"completed","input":{"path":".skilled/commands/doctor/scripts/hook-wiring-check.cjs","offset":100,"limit":248},"output":"Read file .skilled/commands/doctor/scripts/hook-wiring-check.cjs, lines 100-347\n100: \n101: // Hook files either wrap their events in a `hooks` object or place them at the\n102: // top level, and the cursor file omits the nested hook array the others carry.\n103: // A mention is not a wired hook, so only a command that runs the script counts:\n104: // the event's entries and their nested hooks arrays are walked for command\n105: // entries, and a runtime is wired when one starts node on the marker path.\n106: function eventPayload(document, event) {\n107:   if (!document || typeof document !== 'object') return undefined;\n108:   if (document.hooks && typeof document.hooks === 'object' && event in document.hooks) {\n109:     return document.hooks[event];\n110:   }\n111:   if (event in document) return document[event];\n112:   return undefined;\n113: }\n114: \n115: // A shell groups quoted text into one word and ends a simple command at an\n116: // operator that stands outside quotes, even one stuck to the word before it.\n117: // Reading the words first keeps an echo of a quoted script a mention, because a\n118: // quoted word is only an argument unless a shell is told to run it.\n119: function readWords(command) {\n120:   const words = [];\n121:   let text = '';\n122:   let started = false;\n123: \n124:   function flush() {\n125:     if (!started) return;\n126:     words.push({ text, separator: false });\n127:     text = '';\n128:     started = false;\n129:   }\n130: \n131:   for (let i = 0; i < command.length; i += 1) {\n132:     const char = command[i];\n133:     if (char === \"'\" || char === '\"') {\n134:       started = true;\n135:       i += 1;\n136:       // A shell refuses a line whose quote never closes, so nothing in it runs.\n137:       if (command.indexOf(char, i) === -1) return [];\n138:       while (i < command.length && command[i] !== char) {\n139:         if (char === '\"' && command[i] === '\\\\' && i + 1 < command.length) {\n140:           text += command[i + 1];\n141:           i += 2;\n142:         } else {\n143:           text += command[i];\n144:           i += 1;\n145:         }\n146:       }\n147:       continue;\n148:     }\n149:     if (char === '\\\\') {\n150:       // A backslash before a line break joins the two lines and adds nothing.\n151:       if (command[i + 1] === '\\n') {\n152:         i += 1;\n153:       } else if (i + 1 < command.length) {\n154:         text += command[i + 1];\n155:         started = true;\n156:         i += 1;\n157:       }\n158:       continue;\n159:     }\n160:     // A comment runs from an unquoted # at the start of a word to the line end.\n161:     if (char === '#' && !started) {\n162:       while (i + 1 < command.length && command[i + 1] !== '\\n') i += 1;\n163:       continue;\n164:     }\n165:     if (char === '\\n') {\n166:       flush();\n167:       words.push({ text: char, separator: true });\n168:       continue;\n169:     }\n170:     const pair = command.slice(i, i + 2);\n171:     if (pair === '&&' || pair === '||') {\n172:       flush();\n173:       words.push({ text: pair, separator: true });\n174:       i += 1;\n175:       continue;\n176:     }\n177:     if (char === ';' || char === '|' || char === '&' || char === '(' || char === ')') {\n178:       flush();\n179:       words.push({ text: char, separator: true });\n180:       continue;\n181:     }\n182:     if (/\\s/.test(char)) {\n183:       flush();\n184:       continue;\n185:     }\n186:     text += char;\n187:     started = true;\n188:   }\n189:   flush();\n190:   return words;\n191: }\n192: \n193: function simpleCommands(words) {\n194:   const commands = [];\n195:   let current = [];\n196:   for (const word of words) {\n197:     if (word.separator) {\n198:       if (current.length > 0) commands.push(current);\n199:       current = [];\n200:     } else {\n201:       current.push(word);\n202:     }\n203:   }\n204:   if (current.length > 0) commands.push(current);\n205:   return commands;\n206: }\n207: \n208: function collectCommands(node, commands) {\n209:   if (Array.isArray(node)) {\n210:     for (const entry of node) collectCommands(entry, commands);\n211:   } else if (node && typeof node === 'object') {\n212:     if (node.type === 'command' && typeof node.command === 'string') commands.push(node.command);\n213:     if (Array.isArray(node.hooks)) collectCommands(node.hooks, commands);\n214:   }\n215:   return commands;\n216: }\n217: \n218: const ASSIGNMENT = /^[A-Za-z_][A-Za-z0-9_]*=/;\n219: \n220: // Flags whose next word is their own argument, so that word is not the command.\n221: const ENV_FLAGS_WITH_ARGUMENT = new Set(['-u', '--unset', '-C', '--chdir']);\n222: const NODE_FLAGS_WITH_ARGUMENT = new Set([\n223:   '-r', '--require', '--import', '--loader', '--experimental-loader', '-C', '--conditions',\n224: ]);\n225: // Flags that make node do something other than run the script it is given.\n226: const NODE_FLAGS_WITHOUT_RUN = new Set([\n227:   '-c', '--check', '-e', '--eval', '-p', '--print', '-v', '--version', '-h', '--help',\n228: ]);\n229: // Words that open a group or hand over the shell and leave the command after them.\n230: const COMMAND_PREFIXES = new Set(['{', 'exec']);\n231: \n232: function isNodeExecutable(token) {\n233:   return token === 'node' || token.endsWith('/node');\n234: }\n235: \n236: function isEnvExecutable(token) {\n237:   return token === 'env' || token.endsWith('/env');\n238: }\n239: \n240: function isShellExecutable(token) {\n241:   return ['bash', 'sh', 'zsh'].some((name) => token === name || token.endsWith(`/${name}`));\n242: }\n243: \n244: // env launches the command after its own assignments and flags, so those words\n245: // say nothing about what runs. The same holds for a leading assignment.\n246: function commandWords(words) {\n247:   let index = 0;\n248:   while (index < words.length && COMMAND_PREFIXES.has(words[index].text)) index += 1;\n249:   while (index < words.length && ASSIGNMENT.test(words[index].text)) index += 1;\n250:   if (index < words.length && isEnvExecutable(words[index].text)) {\n251:     index += 1;\n252:     while (index < words.length\n253:       && (ASSIGNMENT.test(words[index].text) || words[index].text.startsWith('-'))) {\n254:       index += ENV_FLAGS_WITH_ARGUMENT.has(words[index].text) ? 2 : 1;\n255:     }\n256:   }\n257:   return words.slice(index);\n258: }\n259: \n260: function runsNodeOnMarker(words, marker) {\n261:   const rest = commandWords(words);\n262:   if (rest.length === 0 || !isNodeExecutable(rest[0].text)) return false;\n263:   let index = 1;\n264:   while (index < rest.length && rest[index].text.startsWith('-')) {\n265:     const flag = rest[index].text;\n266:     if (NODE_FLAGS_WITHOUT_RUN.has(flag)) return false;\n267:     index += NODE_FLAGS_WITH_ARGUMENT.has(flag) ? 2 : 1;\n268:   }\n269:   return index < rest.length && rest[index].text.endsWith(marker);\n270: }\n271: \n272: // bash -c and its login, sh and zsh forms hand the next word to a shell as a\n273: // script, so that word is read again as commands. No other word is.\n274: function scriptWord(words) {\n275:   const rest = commandWords(words);\n276:   if (rest.length < 2 || !isShellExecutable(rest[0].text)) return null;\n277:   // The first word that is not a flag is a script file, and what follows it\n278:   // belongs to that script.\n279:   for (let index = 1; index < rest.length - 1; index += 1) {\n280:     const flag = rest[index].text;\n281:     if (!flag.startsWith('-')) return null;\n282:     if (!flag.startsWith('--') && flag.slice(1).includes('c')) {\n283:       return rest[index + 1];\n284:     }\n285:   }\n286:   return null;\n287: }\n288: \n289: // An argument that only names node, as `echo node <script>` does, runs\n290: // nothing, so node must stand where a shell starts a command.\n291: function runsMarker(command, marker, depth = 0) {\n292:   return simpleCommands(readWords(command)).some((words) => {\n293:     if (runsNodeOnMarker(words, marker)) return true;\n294:     if (depth >= 2) return false;\n295:     const script = scriptWord(words);\n296:     return script !== null && runsMarker(script.text, marker, depth + 1);\n297:   });\n298: }\n299: \n300: function inspect(runtime, root) {\n301:   const file = path.join(root, runtime.file);\n302:   let document;\n303:   try {\n304:     document = JSON.parse(fs.readFileSync(file, 'utf8'));\n305:   } catch {\n306:     return { runtime: runtime.id, file: runtime.file, status: 'hook-missing' };\n307:   }\n308:   const payload = eventPayload(document, runtime.event);\n309:   const wired = collectCommands(payload, []).some((command) => runsMarker(command, runtime.marker));\n310:   return { runtime: runtime.id, file: runtime.file, status: wired ? 'ok' : 'hook-missing' };\n311: }\n312: \n313: // ─────────────────────────────────────────────────────────────────────────────\n314: // 4. MAIN\n315: // ─────────────────────────────────────────────────────────────────────────────\n316: \n317: function main(argv) {\n318:   const opts = parseArgs(argv);\n319:   const checks = RUNTIMES.map((runtime) => {\n320:     if (!fs.existsSync(path.join(opts.root, runtime.dir))) {\n321:       return { runtime: runtime.id, file: runtime.file, status: 'skipped' };\n322:     }\n323:     return inspect(runtime, opts.root);\n324:   });\n325: \n326:   if (opts.json) {\n327:     process.stdout.write(`${JSON.stringify({ root: opts.root, checks }, null, 2)}\\n`);\n328:   } else {\n329:     for (const check of checks) {\n330:       if (check.status === 'ok') process.stdout.write(`ok ${check.runtime}\\n`);\n331:       else if (check.status === 'hook-missing') process.stdout.write(`hook-missing ${check.runtime} ${check.file}\\n`);\n332:     }\n333:   }\n334: \n335:   return checks.some((check) => check.status === 'hook-missing') ? 1 : 0;\n336: }\n337: \n338: if (require.main === module) {\n339:   try {\n340:     process.exitCode = main(process.argv.slice(2));\n341:   } catch (err) {\n342:     process.stderr.write(`hook-wiring-check: ${err && err.message ? err.message : String(err)}\\n`);\n343:     process.exitCode = 2;\n344:   }\n345: }\n346: \n347: module.exports = { main, eventPayload };","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file .skilled/commands/doctor/scripts/hook-wiring-check.cjs, lines 100-347\n100: \n101: // Hook files either wrap their events in a `hooks` object or place them at the\n102: // top level, and the cursor file omits the nested hook array the others carry.\n103: // A mention is not a wired hook, so only a command that runs the script counts:\n104: // the event's entries and their nested hooks arrays are walked for command\n105: // entries, and a runtime is wired when one starts node on the marker path.\n106: function eventPayload(document, event) {\n107:   if (!document || typeof document !== 'object') return undefined;\n108:   if (document.hooks && typeof document.hooks === 'object' && event in document.hooks) {\n109:     return document.hooks[event];\n110:   }\n111:   if (event in document) return document[event];\n112:   return undefined;\n113: }\n114: \n115: // A shell groups quoted text into one word and ends a simple command at an\n116: // operator that stands outside quotes, even one stuck to the word before it.\n117: // Reading the words first keeps an echo of a quoted script a mention, because a\n118: // quoted word is only an argument unless a shell is told to run it.\n119: function readWords(command) {\n120:   const words = [];\n121:   let text = '';\n122:   let st