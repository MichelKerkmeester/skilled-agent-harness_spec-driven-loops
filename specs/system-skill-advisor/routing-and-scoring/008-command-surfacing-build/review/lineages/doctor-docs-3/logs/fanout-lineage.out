{"type":"tool_use","timestamp":1794593552469,"sessionID":"ses_e29e5c0b9ffed1u4GCgcaPeWZq","part":{"partID":"prt_1d61c752e0012YyGYyD5dniyGk","sessionID":"ses_e29e5c0b9ffed1u4GCgcaPeWZq","messageID":"msg_1d61bfdd0001tXw9gWlpL7vdQE","type":"tool","id":"call_456a8f58abae47039208aef5","tool":"shell","state":{"status":"completed","input":{"command":"sed -n '1,80p' .skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/capture-scorer-eval-baseline.mjs; echo ...; rg -n \"capturedAt|capturedAtSha|holdoutSha256\" .skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/capture-scorer-eval-baseline.mjs | head -40"},"output":"// ───────────────────────────────────────────────────────────────────\n// MODULE: SCORER EVAL BASELINE CAPTURE\n// ───────────────────────────────────────────────────────────────────\n//\n// Captures the current scorer accuracy across the full corpus, the independent\n// holdout, the frozen ambiguity slice, and the named intent buckets, under the\n// reproducible filesystem projection (empty SYSTEM_SKILL_ADVISOR_DB_DIR → SQLite\n// loader returns null → projection built purely from committed graph metadata).\n// The result is the ratchet baseline: the ratchet gate re-scores live under the\n// same env and holds every metric to it, so any scoring or metadata change that\n// moves a number forces a conscious re-capture rather than drifting silently.\n//\n// The *Sha256 fields pin the baseline to the exact fixtures it was captured\n// against; a fixture edit changes a hash and forces re-baselining.\n//\n// Usage:\n//   node capture-scorer-eval-baseline.mjs            # print JSON to stdout\n//   node capture-scorer-eval-baseline.mjs --write     # also write the baseline\n//   node capture-scorer-eval-baseline.mjs --misses    # print each failing prompt, one JSON line each\n//   SPECKIT_EVAL_BASELINE_SCORING_DATE=YYYY-MM-DD node capture-scorer-eval-baseline.mjs --write\n//                                                     # move the pinned scoring date\n\n// ───────────────────────────────────────────────────────────────────\n// 1. IMPORTS\n// ───────────────────────────────────────────────────────────────────\n\nimport { spawnSync } from 'node:child_process';\nimport { createHash } from 'node:crypto';\nimport { mkdtempSync, readFileSync, writeFileSync } from 'node:fs';\nimport { tmpdir } from 'node:os';\nimport { dirname, join, resolve } from 'node:path';\nimport { fileURLToPath } from 'node:url';\nimport { rejectUnknownOptions } from './reject-unknown-options.mjs';\n\nrejectUnknownOptions(import.meta.url, ['--write', '--misses']);\n\n// ───────────────────────────────────────────────────────────────────\n// 2. CONSTANTS\n// ───────────────────────────────────────────────────────────────────\n\nconst HERE = dirname(fileURLToPath(import.meta.url));\nconst CORPUS_JSONL = resolve(HERE, 'labeled-prompts.jsonl');\nconst HOLDOUT_JSONL = resolve(HERE, 'holdout-prompts.jsonl');\nconst AMBIGUITY_JSONL = resolve(HERE, 'ambiguity-prompts.jsonl');\nconst DELEGATION_JSON = resolve(HERE, '../../tests/parity/fixtures/executor-delegation-cases.json');\nconst OUTPUT_JSON = resolve(HERE, 'scorer-eval-baseline.json');\nconst DIST = resolve(HERE, '../../dist/runtime');\n\n// ───────────────────────────────────────────────────────────────────\n// 3. RUNTIME SETUP\n// ───────────────────────────────────────────────────────────────────\n\nprocess.env.SYSTEM_SKILL_ADVISOR_DB_DIR = mkdtempSync(join(tmpdir(), 'advisor-eval-baseline-'));\nprocess.env.SKILL_ADVISOR_DISABLE_BUILTIN_SEMANTIC = '1';\nprocess.env.SPECKIT_SKILL_ADVISOR_FORCE_LOCAL = '1';\nprocess.env.PYTHONDONTWRITEBYTECODE = '1';\n// Match the test-harness regime: the semantic-shadow lane substitutes\n// deterministic fixture vectors under the harness flag (real embeddings are not\n// reproducible in CI), so every scorer gate runs this way. The baseline must be\n// captured under the same regime the ratchet re-scores it in.\nprocess.env.VITEST = 'true';\ndelete process.env.SPECKIT_ADVISOR_LANE_WEIGHTS_JSON;\ndelete process.env.SPECKIT_ADVISOR_LANE_SHADOW_WEIGHTS_JSON;\ndelete process.env.SPECKIT_ADVISOR_BM25_LEXICAL_SHADOW;\n// Private `local-*` skills linked in through this variable live outside the\n// checkout, so a baseline measured on a clean checkout must not see them.\ndelete process.env.SPECKIT_PRIVATE_SKILL_ROOTS;\n\n// The derived lane halves each skill's score every 90 days of age, measured from\n// its derived.generated_at to the scoring clock (floored at 0.1), so scores move\n// with the calendar. The scoring date is therefore pinned and recorded, never\n// read from the wall clock: a recapture on any day replays the recorded date and\n// reproduces the same numbers. Moving the pin is a deliberate act, made by\n// exporting SPECKIT_EVAL_BASELINE_SCORING_DATE=YYYY-MM-DD for the capture run.\n// The baseline's `capturedAt` field holds this pinned scoring date, which the\n// ratchet and the other baseline readers replay at midnight UTC.\nconst SCORING_DATE_ENV = 'SPECKIT_EVAL_BASELINE_SCORING_DATE';\n\nfunction isCalendarDate(value) {\n  if (!/^\\d{4}-\\d{2}-\\d{2}$/.test(value)) return false;\n...\n75:// The baseline's `capturedAt` field holds this pinned scoring date, which the\n96:    recorded = JSON.parse(readFileSync(OUTPUT_JSON, 'utf8')).capturedAt;\n218:  capturedAt: CAPTURED_AT,\n219:  capturedAtSha: headSha,\n221:  holdoutSha256: sha256File(HOLDOUT_JSONL),\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"// ───────────────────────────────────────────────────────────────────\n// MODULE: SCORER EVAL BASELINE CAPTURE\n// ───────────────────────────────────────────────────────────────────\n//\n// Captures the current scorer accuracy across the full corpus, the independent\n// holdout, the frozen ambiguity slice, and the named intent buckets, under the\n// reproducible filesystem projection (empty SYSTEM_SKILL_ADVISOR_DB_DIR → SQLite\n// loader returns null → projection built purely from committed graph metadata).\n// The result is the ratchet baseline: the ratchet gate re-scores live under the\n// same env and holds every metric to it, so any scoring or metadata change that\n// moves a number forces a conscious re-capture rather than drifting silently.\n//\n// The *Sha256 fields pin the baseline to the exact fixtures it was captured\n// against; a fixture edit changes a hash and forces re-baselining.\n//\n// Usage:\n//   node capture-scorer-eval-baseline.mjs            # print JSON to stdout\n//   node capture-scorer-eval-baseline.mjs --write     # also write the baseline\n//   node capture-scorer-eval-baseline.mjs --misses    # print each failing prompt, one JSON line each\n//   SPECKIT_EVAL_BASELINE_SCORING_DATE=YYYY-MM-DD node capture-scorer-eval-baseline.mjs --write\n//                                                     # move the pinned scoring date\n\n// ───────────────────────────────────────────────────────────────────\n// 1. IMPORTS\n// ───────────────────────────────────────────────────────────────────\n\nimport { spawnSync } from 'node:child_process';\nimport { createHash } from 'node:crypto';\nimport { mkdtempSync, readFileSync, writeFileSync } from 'node:fs';\nimport { tmpdir } from 'node:os';\nimport { dirname, join, resolve } from 'node:path';\nimport { fileURLToPath } from 'node:url';\nimport { rejectUnknownOptions } from './reject-unknown-options.mjs';\n\nrejectUnknownOptions(import.meta.url, ['--write', '--misses']);\n\n// ───────────────────────────────────────────────────────────────────\n// 2. CONSTANTS\n// ───────────────────────────────────────────────────────────────────\n\nconst HERE = dirname(fileURLToPath(import.meta.url));\nconst CORPUS_JSONL = resolve(HERE, 'labeled-prompts.jsonl');\nconst HOLDOUT_JSONL = resolve(HERE, 'holdout-prompts.jsonl');\nconst AMBIGUITY_JSONL = resolve(HERE, 'ambiguity-prompts.jsonl');\nconst DELEGATION_JSON = resolve(HERE, '../../tests/parity/fixtures/executor-delegation-cases.json');\nconst OUTPUT_JSON = resolve(HERE, 'scorer-eval-baseline.json');\nconst DIST = resolve(HERE, '../../dist/runtime');\n\n// ───────────────────────────────────────────────────────────────────\n// 3. RUNTIME SETUP\n// ───────────────────────────────────────────────────────────────────\n\nprocess.env.SYSTEM_SKILL_ADVISOR_DB_DIR = mkdtempSync(join(tmpdir(), 'advisor-eval-baseline-'));\nprocess.env.SKILL_ADVISOR_DISABLE_BUILTIN_SEMANTIC = '1';\nprocess.env.SPECKIT_SKILL_ADVISOR_FORCE_LOCAL = '1';\nprocess.env.PYTHONDONTWRITEBYTECODE = '1';\n// Match the test-harness regime: the semantic-shadow lane substitutes\n// deterministic fixture vectors under the harness flag (real embeddings are not\n// reproducible in CI), so every scorer gate runs this way. The baseline must be\n// captured under the same regime the ratchet re-scores it in.\nprocess.env.VITEST = 'true';\ndelete process.env.SPECKIT_ADVISOR_LANE_WEIGHTS_JSON;\ndelete process.env.SPECKIT_ADVISOR_LANE_SHADOW_WEIGHTS_JSON;\ndelete process.env.SPECKIT_ADVISOR_BM25_LEXICAL_SHADOW;\n// Private `local-*` skills linked in through this variable live outside the\n// checkout, so a baseline measured on a clean checkout must not see them.\ndelete process.env.SPECKIT_PRIVATE_SKILL_ROOTS;\n\n// The derived lane halves each skill's score every 90 days of age, measured from\n// its derived.generated_at to the scoring clock (floored at 0.1), so scores move\n// with the calendar. The scoring date is therefore pinned and recorded, never\n// read from the wall clock: a recapture on any day replays the recorded date and\n// reproduces the same numbers. Moving the pin is a deliberate act, made by\n// exporting SPECKIT_EVAL_BASELINE_SCORING_DATE=YYYY-MM-DD for the capture run.\n// The baseline's `capturedAt` field holds this pinned scoring date, which the\n// ratchet and the other baseline readers replay at midnight UTC.\nconst SCORING_DATE_ENV = 'SPECKIT_EVAL_BASELINE_SCORING_DATE';\n\nfunction isCalendarDate(value) {\n  if (!/^\\d{4}-\\d{2}-\\d{2}$/.test(value)) return false;\n...\n75:// The baseline's `capturedAt` field holds this pinned scoring date, which the\n96:    recorded = JSON.parse(readFileSync(OUTPUT_JSON, 'utf8')).capturedAt;\n218:  capturedAt: CAPTURED_AT,\n219:  capturedAtSha: headSha,\n221:  holdoutSha256: sha256File(HOLDOUT_JSONL),\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"sed -n '1,80p' .skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/capture-scorer-eval-baseline.mjs; echo ...; rg -n \\\"capturedAt|capturedAtSha|holdoutSha256\\\" .skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/capture-scorer-eval-baseline.mjs | head -40\"}"},"time":{"start":1794593551662,"end":1794593552469}}}}
{"type":"tool_use","timestamp":1794593552476,"sessionID":"ses_e29e5c0b9ffed1u4GCgcaPeWZq","part":{"partID":"prt_1d61c7294002t2eHIj4VHaZzo6","sessionID":"ses_e29e5c0b9ffed1u4GCgcaPeWZq","messageID":"msg_1d61bfdd0001tXw9gWlpL7vdQE","type":"tool","id":"call_bfdc91f7aed24be7af36d509","tool":"shell","state":{"status":"completed","input":{"command":"git -c core.fsmonitor=false diff ec1869dae8..HEAD -- .skilled/skills/system-skill-advisor/manual-testing-playbook/manual-testing-playbook.md .skilled/skills/system-skill-advisor/runtime/tests/manual-testing-playbook.vitest.ts .skilled/skills/system-skill-advisor/feature-catalog/cli-surface/advisor-recommend.md"},"output":"diff --git a/.skilled/skills/system-skill-advisor/feature-catalog/cli-surface/advisor-recommend.md b/.skilled/skills/system-skill-advisor/feature-catalog/cli-surface/advisor-recommend.md\nindex 22b508c123..86444447fd 100644\n--- a/.skilled/skills/system-skill-advisor/feature-catalog/cli-surface/advisor-recommend.md\n+++ b/.skilled/skills/system-skill-advisor/feature-catalog/cli-surface/advisor-recommend.md\n@@ -7,7 +7,7 @@ trigger_phrases:\n   - \"native recommend\"\n   - \"skill recommendation tool\"\n   - \"compiledRoute enrichment\"\n-version: 0.9.4.0\n+version: 0.9.5.0\n ---\n \n # advisor_recommend Command\n@@ -28,13 +28,13 @@ The caller-supplied `workspaceRoot` is bounded by `schemas/advisor-tool-schemas.\n \n ### Compiled-Routing Enrichment (`compiledRoute`)\n \n-Each recommendation carries an optional `compiledRoute` field (`schemas/advisor-tool-schemas.ts:308`, `z.record(z.string(), z.unknown()).optional()`). `handlers/advisor-recommend.ts`'s `enrichCompiledRoutes()` attaches it only when at least one recommended `skillId` is both in the fixed 7-hub `COMPILED_ROUTING_HUBS` set and currently permitted by the tri-state `SPECKIT_COMPILED_ROUTING` flag (`compiledRoutingEnabledForHub()`, from `../lib/compiled-routing-flag.ts`). Otherwise the schema re-parse is skipped entirely and the output returns unchanged. When enrichment runs, `compiledRouteForRecommendation()` shells out to `.skilled/bin/compiled-route.cjs --hub <skillId> --prompt-stdin`, writes the prompt to its stdin and attaches the parsed result. The one exception is a result whose `servingAuthority` is `\"legacy\"`: the field then stays absent, because a legacy sentinel is never surfaced as if it were a compiled decision. A subprocess failure is handled the same way: silently no `compiledRoute` field, with an optional debug-gated stderr breadcrumb via `SPECKIT_COMPILED_ROUTING_DEBUG`, so a probe failure degrades to exactly what an ineligible or flag-off recommendation already looks like. In short, `compiledRoute` is attached only for an eligible, flag-permitted hub that is genuinely serving compiled. It is intentionally absent for every other combination: flag off, hub not in `COMPILED_ROUTING_HUBS`, legacy sentinel or probe failure. See [`feature-flag-governance.md`](../../../system-spec-kit/feature-catalog/governance/feature-flag-governance.md) for the flag's phased-default and serving-status contract, and each eligible hub's own `compiled-routing-and-legacy-fallback.md` catalog leaf for the hub-side directive this enrichment mirrors. The front door runs from the request's `workspaceRoot`, and a caller may name another checkout there, such as a worktree under the repository root. So the handler first checks that the front door it would run reads `--prompt-stdin`. An older front door gets no call and the recommendation carries no `compiledRoute`, because it would route an empty prompt.\n+Each recommendation carries an optional `compiledRoute` field (the `compiledRoute` field of `AdvisorRecommendationSchema` in `schemas/advisor-tool-schemas.ts`, `z.record(z.string(), z.unknown()).optional()`). `handlers/advisor-recommend.ts`'s `enrichCompiledRoutes()` attaches it only when at least one recommended `skillId` is both in the fixed 7-hub `COMPILED_ROUTING_HUBS` set and currently permitted by the tri-state `SPECKIT_COMPILED_ROUTING` flag (`compiledRoutingEnabledForHub()`, from `../lib/compiled-routing-flag.ts`). Otherwise the schema re-parse is skipped entirely and the output returns unchanged. When enrichment runs, `compiledRouteForRecommendation()` shells out to `.skilled/bin/compiled-route.cjs --hub <skillId> --prompt-stdin`, writes the prompt to its stdin and attaches the parsed result. The one exception is a result whose `servingAuthority` is `\"legacy\"`: the field then stays absent, because a legacy sentinel is never surfaced as if it were a compiled decision. A subprocess failure is handled the same way: silently no `compiledRoute` field, with an optional debug-gated stderr breadcrumb via `SPECKIT_COMPILED_ROUTING_DEBUG`, so a probe failure degrades to exactly what an ineligible or flag-off recommendation already looks like. In short, `compiledRoute` is attached only for an eligible, flag-permitted hub that is genuinely serving compiled. It is intentionally absent for every other combination: flag off, hub not in `COMPILED_ROUTING_HUBS`, legacy sentinel or probe failure. See [`feature-flag-governance.md`](../../../system-spec-kit/feature-catalog/governance/feature-flag-governance.md) for the flag's phased-default and serving-status contract, and each eligible hub's own `compiled-routing-and-legacy-fallback.md` catalog leaf for the hub-side directive this enrichment mirrors. The front door runs from the request's `workspaceRoot`, and a caller may name another checkout there, such as a worktree under the repository root. So the handler first checks that the front door it would run reads `--prompt-stdin`. An older front door gets no call and the recommendation carries no `compiledRoute`, because it would route an empty prompt.\n \n-When a recommendation gets a `compiledRoute`, `enrichCompiledRoutes()` also asks `attachCommand()` in `lib/command-attach.ts` for a slash command and sets the optional `command` field when one comes back (`schemas/advisor-tool-schemas.ts:310`, `z.string().min(1).optional()`). `attachCommand()` names a command only for a `route` decision with `selectionKind: 'single'` and exactly one target, and only when the generated `MODE_COMMANDS` table maps that hub and `workflowMode` to a command. A bundle, a multi-target route or a mode with no command leaves `command` off. For `system-deep-loop` the prompt must type the same command or hold a phrase from `DEPTH_WORDING`, so a prompt that only names a topic such as research or review gets no deep-loop command. A prompt that matches `NO_EDIT_REQUEST` gets no command from any hub, because a reader who rules out a change is never handed work that writes.\n+When a recommendation gets a `compiledRoute`, `enrichCompiledRoutes()` also asks `attachCommand()` in `lib/command-attach.ts` for a slash command and sets the optional `command` field when one comes back (the `command` field of `AdvisorRecommendationSchema` in `schemas/advisor-tool-schemas.ts`, `z.string().min(1).optional()`). `attachCommand()` names a command only for a `route` decision with `selectionKind: 'single'` and exactly one target, and only when the generated `MODE_COMMANDS` table maps that hub and `workflowMode` to a command. A bundle, a multi-target route or a mode with no command leaves `command` off. For `system-deep-loop` the prompt must type the same command or hold a phrase from `DEPTH_WORDING`, so a prompt that only names a topic such as research or review gets no deep-loop command. A prompt that matches `NO_EDIT_REQUEST` gets no command from any hub, because a reader who rules out a change is never handed work that writes.\n \n-The request option `options.includeCompiledRoute` is an optional boolean that defaults to true. When a caller passes `false` the handler skips `enrichCompiledRoutes()` on both the fresh and the cached return (`handlers/advisor-recommend.ts:563-565`, `632-634`), so no `compiled-route.cjs` subprocess starts and no recommendation carries `compiledRoute` or `command`. The prompt hooks pass `true` (`hooks/lib/skill-advisor-cli-fallback.ts:238`), because the `command` field is derived from the compiled route. The OpenCode plugin does not pass the option and keeps receiving `compiledRoute`. The option is declared in the zod schema (`schemas/advisor-tool-schemas.ts:287`), the tool descriptor (`tools/advisor-recommend.ts:23`) and the CLI manifest (`skill-advisor-cli-manifest.ts:57`).\n+The request option `options.includeCompiledRoute` is an optional boolean that defaults to true. When a caller passes `false` the handler skips `enrichCompiledRoutes()` on both the fresh and the cached return (the two `input.options?.includeCompiledRoute === false` checks in `handlers/advisor-recommend.ts`), so no `compiled-route.cjs` subprocess starts and no recommendation carries `compiledRoute` or `command`. The prompt hooks pass `true` (`hooks/lib/skill-advisor-cli-fallback.ts:238`), because the `command` field is derived from the compiled route. The OpenCode plugin does not pass the option and keeps receiving `compiledRoute`. The option is declared in the zod schema (the `options` of `AdvisorRecommendInputSchema` in `schemas/advisor-tool-schemas.ts`), the tool descriptor (`tools/advisor-recommend.ts:23`) and the CLI manifest (`skill-advisor-cli-manifest.ts:57`).\n \n-The request option `options.compiledRouteTopOnly` is an optional boolean that defaults to false. When a caller passes `true`, `enrichCompiledRoutes()` runs the route lookup for the first recommendation only and returns every later one unchanged, so only the top pick can carry `compiledRoute` or `command`. Each lookup is a `compiled-route.cjs` subprocess, so this saves one subprocess for each further eligible hub. The prompt hooks pass `true` with `includeCompiledRoute: true`, because the brief leads with the top pick. The option is declared in the zod schema (`schemas/advisor-tool-schemas.ts:290`), the tool descriptor (`tools/advisor-recommend.ts:24`) and the CLI manifest (`skill-advisor-cli-manifest.ts:58`).\n+The request option `options.compiledRouteTopOnly` is an optional boolean that defaults to false. When a caller passes `true`, `enrichCompiledRoutes()` runs the route lookup for the first recommendation only and returns every later one unchanged, so only the top pick can carry `compiledRoute` or `command`. Each lookup is a `compiled-route.cjs` subprocess, so this saves one subprocess for each further eligible hub. The prompt hooks pass `true` with `includeCompiledRoute: true`, because the brief leads with the top pick. The option is declared in the zod schema (the `options` of `AdvisorRecommendInputSchema` in `schemas/advisor-tool-schemas.ts`), the tool descriptor (`tools/advisor-recommend.ts:24`) and the CLI manifest (`skill-advisor-cli-manifest.ts:58`).\n \n A hub also leaves `command` off when the same command already ranks in the result through its own command row. `enrichCompiledRoutes()` takes the `command` fields present in the result as the commands already offered, so one command never takes two slots.\n \ndiff --git a/.skilled/skills/system-skill-advisor/manual-testing-playbook/manual-testing-playbook.md b/.skilled/skills/system-skill-advisor/manual-testing-playbook/manual-testing-playbook.md\nindex ccf215f367..a4e6238b22 100644\n--- a/.skilled/skills/system-skill-advisor/manual-testing-playbook/manual-testing-playbook.md\n+++ b/.skilled/skills/system-skill-advisor/manual-testing-playbook/manual-testing-playbook.md\n@@ -1,7 +1,7 @@\n ---\n title: \"Skill Advisor: Manual Testing Playbook\"\n description: \"Canonical sk-doc manual testing playbook for the Skill Advisor manual scenario corpus across the native command surface, runtime hooks, compatibility, daemon state, indexing, lifecycle, scorer and Python compatibility workflows.\"\n-version: 0.8.10.0\n+version: 0.8.11.0\n ---\n \n # Skill Advisor: Manual Testing Playbook\n@@ -27,7 +27,7 @@ Canonical package artifacts:\n ### Result persistence\n \n <!-- MANUAL_PLAYBOOK_RESULT_PERSISTENCE_CONTRACT -->\n-A scenario run is complete only after its `PASS`, `FAIL`, or `SKIP` outcome and reason are recorded into `system-skill-advisor/benchmark/reports/<dated-run-label>/`. Generated report Markdown is renderer-owned and never hand-authored.\n+A scenario run is complete only after its `PASS`, `FAIL` or `SKIP` outcome, its reason and its evidence paths are recorded by hand in `.skilled/skills/system-skill-advisor/benchmark/reports/<dated-run-label>/`. The first recorded run creates that folder, because the wrapper that once wrote these records was retired and no renderer writes them now.\n \n ---\n \n@@ -37,7 +37,7 @@ This playbook provides 50 scenario files across 9 categories, one of them a live\n \n > **Numbering note (gap-09).** The directory layout skips slot `09--*` between `scorer-fusion` and `python-compat`. This mirrors the `feature-catalog/` 05-gap pattern and is an intentional historical reservation from initial scaffold design. The gap is preserved to keep spec-folder cross-reference stability across packets. Do not renumber.\n \n-Coverage note (2026-05-07): the prior operator scenario corpus now lives under `manual-testing-playbook/` as the canonical manual validation package. Former `SAD-NNN` IDs are deprecated plus mapped to current feature files in section 18. The source root index describes 42 scenarios, but the source category tree contains 41 `NNN-*.md` scenario files plus no `CL-002`. This root playbook reflects the live file inventory.\n+Coverage note (2026-05-07): the prior operator scenario corpus now lives under `manual-testing-playbook/` as the canonical manual validation package. Former `SAD-NNN` IDs are deprecated plus mapped to current feature files in section 18. The source root index describes 42 scenarios. The category tree holds 50 scenario files named by feature, none of them `NNN-*.md`, and still no `CL-002`. This root playbook reflects the live file inventory.\n \n ### Realistic Test Model\n \ndiff --git a/.skilled/skills/system-skill-advisor/runtime/tests/manual-testing-playbook.vitest.ts b/.skilled/skills/system-skill-advisor/runtime/tests/manual-testing-playbook.vitest.ts\nindex d7410a6569..c9a906693b 100644\n--- a/.skilled/skills/system-skill-advisor/runtime/tests/manual-testing-playbook.vitest.ts\n+++ b/.skilled/skills/system-skill-advisor/runtime/tests/manual-testing-playbook.vitest.ts\n@@ -53,6 +53,11 @@ describe('skill advisor manual testing playbook inventory', () => {\n     expect(rows).toHaveLength(50);\n     expect(new Set(rows.map((row) => row.id)).size).toBe(50);\n     expect(files).toHaveLength(50);\n+    expect(files.filter((file) => /\\/\\d{3}-[^/]*\\.md$/.test(file))).toHaveLength(0);\n+    expect(markdown).toContain(\n+      'The category tree holds 50 scenario files named by feature, none of them',\n+    );\n+    expect(markdown).not.toContain('scenario files plus no');\n \n     for (const row of rows) {\n       expect(existsSync(resolve(playbookRoot, row.relativePath))).toBe(true);\n@@ -60,4 +65,13 @@ describe('skill advisor manual testing playbook inventory', () => {\n \n     expect(rows.map((row) => row.relativePath).sort()).toEqual(files);\n   });\n+\n+  it('names the folder scenario results are recorded in by hand', () => {\n+    const markdown = readFileSync(rootPlaybook, 'utf8');\n+\n+    expect(markdown).toContain('<!-- MANUAL_PLAYBOOK_RESULT_PERSISTENCE_CONTRACT -->');\n+    expect(markdown).toContain('recorded by hand in');\n+    expect(markdown).toContain('system-skill-advisor/benchmark/reports/<dated-run-label>/');\n+    expect(markdown).not.toContain('renderer-owned');\n+  });\n });\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"diff --git a/.skilled/skills/system-skill-advisor/feature-catalog/cli-surface/advisor-recommend.md b/.skilled/skills/system-skill-advisor/feature-catalog/cli-surface/advisor-recommend.md\nindex 22b508c123..86444447fd 100644\n--- a/.skilled/skills/s