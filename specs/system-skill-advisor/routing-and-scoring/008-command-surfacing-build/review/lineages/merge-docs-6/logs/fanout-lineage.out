15:function historyBodyOf(manifest, hash) {\n617:  const entry = (manifest.derived.history || []).find((row) => row.sha256 === hash);\n621:function prefixEndOf(text, manifest) {\n623:  const { sections } = segment(text, manifest.markers, manifest.sections);\n627:  for (const pin of (manifest.pins || []).filter((entry) => entry.kind === 'delivery-anchor')) {\n641: * @param {{root: string, manifest: Object, keepClaudeMd?: boolean, createRouter?: boolean}} input\n644:function compose({ root, manifest, keepClaudeMd = false, createRouter = false }) {\n645:  const report = buildReport({ root, manifestPath: MANIFEST_PATH });\n646:  if (report === null) throw new PreconditionError(`cannot classify ${root}: the manifest at ${MANIFEST_PATH} produced no report`);\n648:  const markers = manifest.markers;\n649:  const rootFile = manifest.root_file;\n650:  const claudePointer = `@${manifest.root_file}\\n`;\n656:    throw new PreconditionError(`${rootFile} is a symlink to ${fs.readlinkSync(rootPath)}; writing through it would change a file outside this repository`);\n670:    : segment(oldText, markers, manifest.sections);\n672:  const shipped = manifest.sections.map((entry) => manifest.derived.sections[entry.id].body).join('');\n710:    const shippedBody = manifest.derived.sections[entry.id] ? manifest.derived.sections[entry.id].body : '';\n722:    const base = historyBodyOf(manifest, entry.base);\n783:  const routerPath = path.join(root, manifest.router_file);\n788:    const result = addRouterRows(current, manifest);\n798:    routerText = renderRouter(manifest);\n802:    notes.push(`router: no ${manifest.router_file}, so no repository rule can load; pass --create-router to create one from the shipped rows`);\n804:  files.push({ path: manifest.router_file, action: routerAction, content: routerText, before: fs.existsSync(routerPath) ? fs.readFileSync(routerPath, 'utf8') : null });\n822:    { path: manifest.router_file, action: routerAction },\n=== check children\n13:// without writing a byte, what the repository holds against the manifest.\n16:// and its anchors belong to the rule-copy canary, the Cursor pointer block belongs to\n17:// the gate 1 sync, the router belongs to the repo-rules checker and the source\n18:// template's purity belongs to the manifest generator's check. Each already has\n19:// tests and an owner, so each is run as a child process and its own lines are carried\n24:// the target root plus the manifest, and the three child tools it runs are read-only\n25:// modes. A repository that cannot be classified at all (no manifest, no target\n29:// Usage: agents-md-check.cjs [--root <dir>] [--manifest <path>] [--source] [--json]\n31://   --manifest <path> read this manifest instead of the shipped one\n41:const { spawnSync } = require('node:child_process');\n51:const { sourceStatus } = require('./agents-md-manifest.cjs');\n59:const MANIFEST_PATH = path.resolve(__dirname, '../assets/agents-md-manifest.json');\n60:const GENERATOR = path.resolve(__dirname, 'agents-md-manifest.cjs');\n61:// The router checker ships beside the skill that authors rules, and the manifest links\n65:  '.skilled/skills/sk-doc/sk-create-repo-rule/scripts/check-repo-rules.cjs',\n69:const REPO_RULES_TAG = '[repo-rules-check]';\n70:const USAGE = 'Usage: node .skilled/commands/doctor/scripts/agents-md-check.cjs [--root <dir>] [--manifest <path>] [--source] [--json]';\n90:  const options = { root: REPO_ROOT, manifest: MANIFEST_PATH, source: false, json: false, help: false };\n98:    } else if (argument === '--manifest') {\n100:      if (!value || value.startsWith('--')) throw new UsageError('--manifest needs a file path');\n101:      options.manifest = path.resolve(value);\n148:function knownBodies(manifest) {\n149:  const sections = manifest.derived && manifest.derived.sections ? manifest.derived.sections : {};\n152:    history: (manifest.derived && manifest.derived.history) || [],\n172: * @param {{root: string, manifest: Object}} input\n175:function readTarget({ root, manifest }) {\n178:  const rootPath = path.join(root, manifest.root_file);\n182:    ? segment(text, manifest.markers, manifest.sections)\n184:  const pairing = matchSections(segmentation.sections, manifest.sections, segmentation.prelude);\n202:      ...classifyBody(row.section.body, knownBodies(manifest)),\n204:    blockContent: blockHasContent(segmentation.block, manifest.markers),\n217:function rowInstallState(context, manifest) {\n222:        { lines: [`no ${manifest.root_file}; CLAUDE.md is the only instruction file`] });\n225:      { lines: [`no ${manifest.root_file} and no CLAUDE.md`] });\n228:  const share = manifest.sections.length === 0 ? 0 : context.matched.length / manifest.sections.length;\n232:        `${context.matched.length} of ${manifest.sections.length} shipped sections match, under the ${Math.round(FOREIGN_SHARE * 100)}% floor`,\n265:function rowSectionsPresent(context, manifest) {\n267:  const missing = manifest.sections.map((entry) => entry.id).filter((id) => !present.has(id));\n268:  const detail = `${present.size}/${manifest.sections.length} matched`;\n274:  return row('A2', 'sections present', FINDING, `${present.size}/${manifest.sections.length} matched, ${missing.length} missing`, {\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"65:const MANIFEST_PATH = path.resolve(__dirname, '../assets/agents-md-manifest.json');\n192:  if (!fs.existsSync(MANIFEST_PATH)) throw new PreconditionError(`the manifest is missing at ${MANIFEST_PATH}`);\n202:    return fs.lstatSync(target).isSymbolicLink();\n376: * @param {Object} manifest\n379:function addRouterRows(text, manifest) {\n380:  const shipped = (manifest.derived && manifest.derived.repo_rules) || { trigger_rows: [], index_rows: [] };\n395:      notes.push(`router: no ${table.anchor} table in ${manifest.router_file}, so its shipped ${table.kind} rows were not added`);\n412:function renderRouter(manifest) {\n413:  con