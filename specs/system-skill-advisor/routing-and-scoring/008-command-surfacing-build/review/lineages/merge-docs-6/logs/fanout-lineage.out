e break joins the two lines and adds nothing.\n160:       if (command[i + 1] === '\\n') {\n161:         i += 1;\n162:       } else if (i + 1 < command.length) {\n163:         text += command[i + 1];\n164:         started = true;\n165:         i += 1;\n166:       }\n167:       continue;\n168:     }\n169:     // A comment runs from an unquoted # at the start of a word to the line end.\n170:     if (char === '#' && !started) {\n171:       while (i + 1 < command.length && command[i + 1] !== '\\n') i += 1;\n172:       continue;\n173:     }\n174:     if (char === '\\n') {\n175:       flush();\n176:       words.push({ text: char, separator: true });\n177:       continue;\n178:     }\n179:     const pair = command.slice(i, i + 2);\n180:     if (pair === '&&' || pair === '||') {\n181:       flush();\n182:       words.push({ text: pair, separator: true });\n183:       i += 1;\n184:       continue;\n185:     }\n186:     if (char === ';' || char === '|' || char === '&' || char === '(' || char === ')') {\n187:       flush();\n188:       words.push({ text: char, separator: true });\n189:       continue;\n190:     }\n191:     if (/\\s/.test(char)) {\n192:       flush();\n193:       continue;\n194:     }\n195:     text += char;\n196:     started = true;\n197:   }\n198:   flush();\n199:   return words;\n200: }\n201: \n202: function simpleCommands(words) {\n203:   const commands = [];\n204:   let current = [];\n205:   for (const word of words) {\n206:     if (word.separator) {\n207:       if (current.length > 0) commands.push(current);\n208:       current = [];\n209:     } else {\n210:       current.push(word);\n211:     }\n212:   }\n213:   if (current.length > 0) commands.push(current);\n214:   return commands;\n215: }\n216: \n217: function collectCommands(node, commands) {\n218:   if (Array.isArray(node)) {\n219:     for (const entry of node) collectCommands(entry, commands);\n220:   } else if (node && typeof node === 'object') {\n221:     if (node.type === 'command' && typeof node.command === 'string') commands.push(node.command);\n222:     if (Array.isArray(node.hooks)) collectCommands(node.hooks, commands);\n223:   }\n224:   return commands;\n225: }\n226: \n227: // A TOML hook file groups its entries under `[[hooks]]` headers rather than a\n228: // JSON key, and no TOML parser is installed here, so each block is read line by\n229: // line. A commented line names nothing that runs, so it is skipped. A basic\n[Output truncated. Continue reading with offset: 230]","title":"read","metadata":{"metadata":{"truncated":true},"content":[{"type":"text","text":"Read file .skilled/commands/doctor/scripts/hook-wiring-check.cjs, lines 120-229\n120:   if (event in document) return document[event];\n121:   return undefined;\n122: }\n123: \n124: // A shell groups quoted text into one word and ends a simple command at an\n125: // operator that stands outside quotes, even one stuck to the word before it.\n126: // Reading the words first keeps an echo of a quoted script a mention, because a\n127: // quoted word is only an argument unless a shell is told to run it.\n128: function readWords(command) {\n129:   const words = [];\n130:   let text = '';\n131:   let started = false;\n132: \n133:   function flush() {\n134:     if (!started) return;\n135:     words.push({ text, separator: false });\n136:     text = '';\n137:     started = false;\n138:   }\n139: \n140:   for (let i = 0; i < command.length; i += 1) {\n141:     const char = command[i];\n142:     if (char === \"'\" || char === '\"') {\n143:       started = true;\n144:       i += 1;\n145:       // A shell refuses a line whose quote never closes, so nothing in it runs.\n146:       if (command.indexOf(char, i) === -1) return [];\n147:       while (i < command.length && command[i] !== char) {\n148:         if (char === '\"' && command[i] === '\\\\' && i + 1 < command.length) {\n149:           text += command[i + 1];\n150:           i += 2;\n151:         } else {\n152:           text += command[i];\n153:      