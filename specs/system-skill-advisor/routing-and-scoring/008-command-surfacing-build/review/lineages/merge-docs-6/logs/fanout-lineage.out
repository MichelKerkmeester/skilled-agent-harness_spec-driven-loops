{"type":"tool_use","timestamp":1794816056922,"sessionID":"ses_e1ca84ea9ffed5hOlqAimuHTWO","part":{"partID":"prt_1e35f9e2e001OL6EXwhpSg7rBM","sessionID":"ses_e1ca84ea9ffed5hOlqAimuHTWO","messageID":"msg_1e35f8f230017v9mTVtmyiecua","type":"tool","id":"chatcmpl-tool-87fabcdec1cb65ff","tool":"read","state":{"status":"completed","input":{"limit":120,"offset":300,"path":".skilled/skills/system-skill-advisor/hooks/claude/user-prompt-submit.ts"},"output":"Read file .skilled/skills/system-skill-advisor/hooks/claude/user-prompt-submit.ts, lines 300-419\n300: \n301: // ───────────────────────────────────────────────────────────────\n302: // 6. CORE LOGIC\n303: // ───────────────────────────────────────────────────────────────\n304: \n305: export async function handleClaudeUserPromptSubmit(\n306:   input: ClaudeUserPromptSubmitInput | null,\n307:   dependencies: UserPromptSubmitDependencies = {},\n308: ): Promise<ClaudeUserPromptSubmitOutput> {\n309:   const environmentRuntime = process.env.SPECKIT_RUNTIME;\n310:   const runtime = dependencies.runtime\n311:     ?? (isAdvisorRuntime(environmentRuntime) ? environmentRuntime : 'claude');\n312:   const startedAt = dependencies.now?.() ?? performance.now();\n313:   const elapsed = (): number => Number(((dependencies.now?.() ?? performance.now()) - startedAt).toFixed(3));\n314:   const writeDiagnostic = dependencies.writeDiagnostic;\n315: \n316:   try {\n317:     if (!skillAdvisorHookEnabled() || process.env.SPECKIT_SKILL_ADVISOR_HOOK_DISABLED === '1') {\n318:       emitDiagnostic({\n319:         runtime,\n320:         workspaceRoot: process.cwd(),\n321:         status: 'skipped',\n322:         freshness: 'unavailable',\n323:         durationMs: elapsed(),\n324:         cacheHit: false,\n325:       }, writeDiagnostic);\n326:       return {};\n327:     }\n328: \n329:     if (!input) {\n330:       emitDiagnostic({\n331:         runtime,\n332:         workspaceRoot: process.cwd(),\n333:         status: 'fail_open',\n334:         freshness: 'unavailable',\n335:         durationMs: elapsed(),\n336:         cacheHit: false,\n337:         errorCode: 'PARSE_FAIL',\n338:         errorDetails: 'Invalid UserPromptSubmit JSON payload',\n339:       }, writeDiagnostic);\n340:       return {};\n341:     }\n342: \n343:     const prompt = normalizePrompt(input.prompt);\n344:     const workspaceRoot = workspaceRootFor(input);\n345:     if (prompt === null) {\n346:       emitDiagnostic({\n347:         runtime,\n348:         workspaceRoot,\n349:         status: 'fail_open',\n350:         freshness: 'unavailable',\n351:         durationMs: elapsed(),\n352:         cacheHit: false,\n353:         errorCode: 'PARSE_FAIL',\n354:         errorDetails: 'Missing UserPromptSubmit prompt string',\n355:       }, writeDiagnostic);\n356:       return {};\n357:     }\n358: \n359:     const renderBrief = dependencies.renderBrief ?? renderAdvisorBrief;\n360:     // The CLI owns the warm-daemon probe and local-scorer fallback.\n361:     // The prompt-policy gate skips prompts that need no advisor before the\n362:     // CLI call; injected full producers stay ungated for producer-level tests.\n363:     const injectedBrief = dependencies.buildBrief;\n364:     const buildCliBrief = dependencies.buildCliBrief ?? buildSkillAdvisorBriefFromCli;\n365:     let result = injectedBrief\n366:       ? await injectedBrief(prompt, {\n367:         runtime,\n368:         workspaceRoot,\n369:         subprocessTimeoutMs: claudeHookTimeoutMs(),\n370:       })\n371:       : skippedAdvisorResultFor(prompt) ?? await buildCliBrief(prompt, {\n372:         runtime,\n373:         workspaceRoot,\n374:         timeoutMs: claudeHookTimeoutMs(),\n375:       }, {\n376:         now: dependencies.now,\n377:       });\n378: \n379:     result = {\n380:       ...result,\n381:       metrics: {\n382:         ...result.metrics,\n383:         durationMs: elapsed(),\n384:       },\n385:     };\n386:     const deliveryState = deliveryStateOptionsFor(input);\n387:     const brief = renderBrief(result, { deliveryState });\n388:     const renderOptions = { deliveryState, setupWording: !brief && SETUP_WORDING.test(prompt) };\n389:     const emitted = brief ?? renderAdvisorFallbackDirective(renderOptions, result);\n390:     // Directive-lifecycle dedup delivers the full brief on the first message\n391:     // and after lifecycle boundaries or transcript shrink. On proven repeats,\n392:     // it keeps the head and drops the constant directive block. A headed\n393:     // fallback reduces like a brief; unknown sessions, the kill switch, and\n394:     // thrown errors still get the full text.\n395:     let effectiveEmitted = emitted;\n396:     let commitFullReceipt: (() => boolean) | undefined;\n397:     try {\n398:       const sessionId = typeof input.session_id === 'string' && input.session_id.trim().length > 0\n399:         ? input.session_id\n400:         : undefined;\n401:       const sessionConfirmed = input.session_identity_confirmed\n402:         ?? (Boolean(sessionId) && input.session_identity_ambiguous !== true);\n403:       const transcriptPath = typeof input.transcript_path === 'string' && input.transcript_path.length > 0\n404:         ? input.transcript_path\n405:         : null;\n406:       let transcriptBytes: number | null = null;\n407:       if (transcriptPath) {\n408:         try {\n409:           transcriptBytes = statSync(transcriptPath).size;\n410:         } catch {\n411:           transcriptBytes = null;\n412:         }\n413:       }\n414:       const decision = decideDirectiveLifecycleDelivery(emitted, {\n415:         state: dependencies.directiveLifecycleStore ?? defaultDirectiveLifecycleStore(),\n416:         sessionId,\n417:         sessionConfirmed,\n418:         lifecycleEvent: lifecycleEventFor(input),\n419:         transcriptPath,\n[Output truncated. Continue reading with offset: 420]","title":"read","metadata":{"metadata":{"truncated":true},"content":[{"type":"text","text":"Read file .skilled/skills/system-sk