{"type":"tool_use","timestamp":1794815922140,"sessionID":"ses_e1ca84ea9ffed5hOlqAimuHTWO","part":{"partID":"prt_1e35d8e0600201EkLZ6RCWucfx","sessionID":"ses_e1ca84ea9ffed5hOlqAimuHTWO","messageID":"msg_1e35d7e24001wcEVSbD506emr2","type":"tool","id":"chatcmpl-tool-8a6e049dbebfab9f","tool":"read","state":{"status":"completed","input":{"limit":220,"offset":300,"path":".skilled/skills/system-skill-advisor/runtime/lib/metrics.ts"},"output":"Read file .skilled/skills/system-skill-advisor/runtime/lib/metrics.ts, lines 300-519\n300: \n301: function workspaceHash(workspaceRoot: string): string {\n302:   return createHash('sha256')\n303:     .update(resolve(workspaceRoot))\n304:     .digest('hex')\n305:     .slice(0, 16);\n306: }\n307: \n308: function durableMetricsPath(workspaceRoot: string, kind: 'diagnostics' | 'outcomes'): string {\n309:   return join(DURABLE_METRICS_ROOT, `${workspaceHash(workspaceRoot)}-${kind}.jsonl`);\n310: }\n311: \n312: function readJsonlLines(path: string): string[] {\n313:   if (!existsSync(path)) {\n314:     return [];\n315:   }\n316:   return readFileSync(path, 'utf8')\n317:     .split('\\n')\n318:     .map((line) => line.trim())\n319:     .filter((line) => line.length > 0);\n320: }\n321: \n322: async function writeBoundedJsonl(path: string, line: string, maxRecords: number, options: { requireDebug?: boolean } = {}): Promise<void> {\n323:   if (options.requireDebug !== false && !process.env.SKILL_ADVISOR_DEBUG) return;\n324:   const previous = writeQueues.get(path) ?? Promise.resolve();\n325:   const next = previous.then(async () => {\n326:     await ensureParentDir(path);\n327:     // O_APPEND of one sub-PIPE_BUF line is atomic, so the add never loses a record\n328:     // under concurrency. Bounding stays correct under the same per-path queue: trim\n329:     // only once the file drifts past 1.5x the cap, so the common path is a cheap\n330:     // append and the read-trim-rewrite amortizes to once per ~0.5*maxRecords writes.\n331:     await appendFile(path, `${line}\\n`, { encoding: 'utf8', mode: PRIVATE_FILE_MODE });\n332:     await securePrivateLog(path);\n333:     if (maxRecords > 0) {\n334:       const lines = readJsonlLines(path);\n335:       if (lines.length > Math.floor(maxRecords * 1.5)) {\n336:         const temporaryPath = `${path}.${process.pid}.${Date.now()}.tmp`;\n337:         // Rename swaps atomically, so a crash mid-trim leaves the old log instead of a truncated one.\n338:         await writeFile(temporaryPath, `${lines.slice(-maxRecords).join('\\n')}\\n`, { encoding: 'utf8', mode: PRIVATE_FILE_MODE });\n339:         try {\n340:           await rename(temporaryPath, path);\n341:         } catch (error) {\n342:           await unlink(temporaryPath);\n343:           throw error;\n344:         }\n345:       }\n346:     }\n347:   });\n348:   writeQueues.set(path, next.catch(() => undefined));\n349:   await next;\n350: }\n351: \n352: function tryParseJsonLine(line: string): unknown | null {\n353:   try {\n354:     return JSON.parse(line) as unknown;\n355:   } catch {\n356:     return null;\n357:   }\n358: }\n359: \n360: // ───────────────────────────────────────────────────────────────\n361: // 4. CORE LOGIC\n362: // ───────────────────────────────────────────────────────────────\n363: \n364: /** Return the stable metric definitions emitted by advisor hook diagnostics. */\n365: export function getAdvisorHookMetricDefinitions(): readonly AdvisorMetricDefinition[] {\n366:   return ADVISOR_HOOK_METRIC_DEFINITIONS;\n367: }\n368: \n369: /** Read alert thresholds from environment with conservative defaults. */\n370: export function getAdvisorHookAlertThresholds(): AdvisorHookAlertThresholds {\n371:   return {\n372:     failOpenWarnRate: envNumber('SPECKIT_ADVISOR_HOOK_FAILOPEN_WARN_RATE', DEFAULT_ALERT_THRESHOLDS.failOpenWarnRate),\n373:     failOpenPageRate: envNumber('SPECKIT_ADVISOR_HOOK_FAILOPEN_PAGE_RATE', DEFAULT_ALERT_THRESHOLDS.failOpenPageRate),\n374:     cacheHitP95WarnMs: envNumber('SPECKIT_ADVISOR_HOOK_CACHE_HIT_P95_WARN_MS', DEFAULT_ALERT_THRESHOLDS.cacheHitP95WarnMs),\n375:     cacheHitP95PageMs: envNumber('SPECKIT_ADVISOR_HOOK_CACHE_HIT_P95_PAGE_MS', DEFAULT_ALERT_THRESHOLDS.cacheHitP95PageMs),\n376:   };\n377: }\n378: \n379: /** Build a prompt-safe diagnostic record from hook execution metadata. */\n380: export function createAdvisorHookDiagnosticRecord(input: {\n381:   readonly runtime: AdvisorRuntime;\n382:   readonly status: AdvisorHookStatus;\n383:   readonly freshness: AdvisorHookFreshness;\n384:   readonly durationMs: number;\n385:   readonly cacheHit: boolean;\n386:   readonly errorCode?: unknown;\n387:   readonly errorDetails?: unknown;\n388:   readonly skillLabel?: string | null;\n389:   readonly generation?: number;\n390:   readonly emittedBytes?: number;\n391:   readonly directivesSuppressed?: boolean;\n392:   readonly degraded?: boolean;\n393:   readonly timestamp?: string;\n394: }): AdvisorHookDiagnosticRecord {\n395:   const errorCode = normalizeErrorCode(input.errorCode);\n396:   const errorDetails = sanitizeDiagnosticText(input.errorDetails);\n397:   return {\n398:     timestamp: input.timestamp ?? new Date().toISOString(),\n399:     runtime: input.runtime,\n400:     status: input.status,\n401:     freshness: input.freshness,\n402:     durationMs: Math.max(0, Math.round(input.durationMs)),\n403:     cacheHit: input.cacheHit,\n404:     ...(errorCode ? { errorCode } : {}),\n405:     ...(errorDetails ? { errorDetails } : {}),\n406:     ...(input.skillLabel ? { skillLabel: input.skillLabel } : {}),\n407:     ...(typeof input.generation === 'number' ? { generation: input.generation } : {}),\n408:     ...(typeof input.emittedBytes === 'number' ? { emittedBytes: input.emittedBytes } : {}),\n409:     ...(typeof input.directivesSuppressed === 'boolean' ? { directivesSuppressed: input.directivesSuppressed } : {}),\n410:     ...(input.degraded === true ? { degraded: true } : {}),\n411:   };\n412: }\n413: \n414: /** Validate that a diagnostic record matches the prompt-free closed schema. */\n415: export function validateAdvisorHookDiagnosticRecord(value: unknown): value is AdvisorHookDiagnosticRecord {\n416:   if (typeof value !== 'object' || value === null || Array.isArray(value)) {\n417:     return false;\n418:   }\n419:   const record = value as Record<string, unknown>;\n420:   if ([...FORBIDDEN_DIAGNOSTIC_FIELDS].some((field) => field in record)) {\n421:     return false;\n422:   }\n423:   return typeof record.timestamp === 'string'\n424:     && enumIncludes(ADVISOR_RUNTIME_VALUES, record.runtime)\n425:     && enumIncludes(ADVISOR_HOOK_STATUS_VALUES, record.status)\n426:     && enumIncludes(ADVISOR_HOOK_FRESHNESS_VALUES, record.freshness)\n427:     && typeof record.durationMs === 'number'\n428:     && typeof record.cacheHit === 'boolean'\n429:     && (record.errorCode === undefined || enumIncludes(ADVISOR_ERROR_CODE_VALUES, record.errorCode))\n430:     && (record.errorDetails === undefined || typeof record.errorDetails === 'string')\n431:     && (record.skillLabel === undefined || typeof record.skillLabel === 'string')\n432:     && (record.generation === undefined || typeof record.generation === 'number')\n433:     && (record.emittedBytes === undefined\n434:       || (typeof record.emittedBytes === 'number'\n435:         && Number.isInteger(record.emittedBytes)\n436:         && record.emittedBytes >= 0))\n437:     && (record.directivesSuppressed === undefined || typeof record.directivesSuppressed === 'boolean')\n438:     && (record.degraded === undefined || typeof record.degraded === 'boolean');\n439: }\n440: \n441: /** Serialize a validated diagnostic record for JSONL emission. */\n442: export function serializeAdvisorHookDiagnosticRecord(record: AdvisorHookDiagnosticRecord): string {\n443:   if (!validateAdvisorHookDiagnosticRecord(record)) {\n444:     throw new Error(\n445:       `AdvisorHookDiagnosticRecord: expected prompt-free closed-schema diagnostic record; actual ${typeof record}.`,\n446:     );\n447:   }\n448:   return JSON.stringify(record);\n449: }\n450: \n451: export async function persistAdvisorHookDiagnosticRecord(\n452:   workspaceRoot: string,\n453:   record: AdvisorHookDiagnosticRecord,\n454: ): Promise<string> {\n455:   const path = durableMetricsPath(workspaceRoot, 'diagnostics');\n456:   // A health record answers how the hook runs, which needs no prompt, skill or\n457:   // error text, so it is written on every prompt, and the debug variable adds the\n458:   // two fields that say what the prompt was about.\n459:   const { skillLabel: _skillLabel, errorDetails: _errorDetails, ...promptFreeRecord } = record;\n460:   const persisted = process.env.SKILL_ADVISOR_DEBUG ? record : promptFreeRecord;\n461:   await writeBoundedJsonl(path, serializeAdvisorHookDiagnosticRecord(persisted), MAX_DURABLE_DIAGNOSTIC_RECORDS, { requireDebug: false });\n462:   return path;\n463: }\n464: \n465: export function readAdvisorHookDiagnosticRecords(\n466:   workspaceRoot: string,\n467:   limit = MAX_DURABLE_DIAGNOSTIC_RECORDS,\n468: ): AdvisorHookDiagnosticRecord[] {\n469:   return readJsonlLines(durableMetricsPath(workspaceRoot, 'diagnostics'))\n470:     .slice(-limit)\n471:     .map((line) => JSON.parse(line) as unknown)\n472:     .filter(validateAdvisorHookDiagnosticRecord);\n473: }\n474: \n475: /** Build the rolling health section shown in advisor observability output. */\n476: export function buildAdvisorHookHealthSection(\n477:   records: readonly AdvisorHookDiagnosticRecord[],\n478: ): AdvisorHookHealthSection {\n479:   const lastInvocations = records.slice(-MAX_HEALTH_RECORDS);\n480:   const cacheHits = lastInvocations.filter((record) => record.cacheHit).length;\n481:   const failOpen = lastInvocations.filter((record) => record.status === 'fail_open').length;\n482:   const degraded = lastInvocations.filter((record) => record.degraded === true).length;\n483:   return {\n484:     key: 'advisor-hook-health',\n485:     lastInvocations,\n486:     rollingCacheHitRate: lastInvocations.length > 0 ? cacheHits / lastInvocations.length : 0,\n487:     rollingP95Ms: percentile(\n488:       lastInvocations.filter((record) => record.cacheHit).map((record) => record.durationMs),\n489:       95,\n490:     ),\n491:     rollingFailOpenRate: lastInvocations.length > 0 ? failOpen / lastInvocations.length : 0,\n492:     rollingDegradedRate: lastInvocations.length > 0 ? degraded / lastInvocations.length : 0,\n493:     lastRecordAt: lastInvocations[lastInvocations.length - 1]?.timestamp ?? null,\n494:   };\n495: }\n496: \n497: export function readAdvisorHookHealthSection(workspaceRoot: string): AdvisorHookHealthSection {\n498:   return buildAdvisorHookHealthSection(readAdvisorHookDiagnosticRecords(workspaceRoot));\n499: }\n500: \n501: export function advisorHookDiagnosticsPath(workspaceRoot: string): string {\n502:   return durableMetricsPath(workspaceRoot, 'diagnostics');\n503: }\n504: \n505: // Persists only sanitized skill labels + the accept/correct/ignore signal,\n506: // never the prompt or scenario — deliberate prompt-safety. Real misroutes\n507: // therefore cannot be reconstructed into gold cases from this telemetry; that\n508: // is an accepted capability tradeoff, not an omission to fix by capturing\n509: // prompts (which would breach the prompt-safety invariant).\n510: export function createAdvisorHookOutcomeRecord(input: {\n511:   readonly runtime: AdvisorRuntime;\n512:   readonly outcome: AdvisorOutcome;\n513:   readonly skillLabel: string;\n514:   readonly correctedSkillLabel?: string | null;\n515:   readonly timestamp?: string;\n516: }): AdvisorHookOutcomeRecord {\n517:   return {\n518:     timestamp: input.timestamp ?? new Date().toISOString(),\n519:     runtime: input.runtime,\n[Output truncated. Continue reading with offset: 520]","title":"read","metadata":{"metadata":{"truncated":true},"content":[{"type":"text","text":"Read file .skilled/skills/system-skill-advisor/runtime/lib/metrics.ts, lines 300-519\n300: \n301: function workspaceHash(workspaceRoot: string): string {\n302:   return createHash('sha256')\n303:     .update(resolve(workspaceRoot))\n304:     .digest('hex')\n305:     .slice(0, 16);\n306: }\n307: \n308: function durableMetricsPath(workspaceRoot: string, kind: 'diagnostics' | 'outcomes'): string {\n309:   return join(DURABLE_METRICS_ROOT, `${workspaceHash(workspaceRoot)}-${kind}.jsonl`);\n310: }\n311: \n312: function readJsonlLines(path: string): string[] {\n313:   if (!existsSync(path)) {\n314:     return [];\n315:   }\n316:   return readFileSync(path, 'utf8')\n317:     .split('\\n')\n318:     .map((line) => line.trim())\n319:     .filter((line) => line.length > 0);\n320: }\n321: \n322: async function writeBoundedJsonl(path: string, line: string, maxRecords: number, options: { requireDebug?: boolean } = {}): Promise<void> {\n323:   if (options.requireDebug !== false && !process.env.SKILL_ADVISOR_DEBUG) return;\n324:   const previous = writeQueues.get(path) ?? Promise.resolve();\n325:   const next = previous.then(async () => {\n326:     await ensureParentDir(path);\n327:     // O_APPEND of one sub-PIPE_BUF line is atomic, so the add never loses a record\n328:     // under concurrency. Bounding stays correct under the same per-path queue: trim\n329:     // only once the file drifts past 1.5x the cap, so the common path is a cheap\n330:     // append and the read-trim-rewrite amortizes to once per ~0.5*maxRecords writes.\n331:     await appendFile(path, `${line}\\n`, { encoding: 'utf8', mode: PRIVATE_FILE_MODE });\n332:     await securePrivateLog(path);\n333:     if (maxRecords > 0) {\n334:       const lines = readJsonlLines(path);\n335:       if (lines.length > Math.floor(maxRecords * 1.5)) {\n336:         const temporaryPath = `${path}.${process.pid}.${Date.now()}.tmp`;\n337:         // Rename swaps atomically, so a crash mid-trim leaves the old log instead of a truncated one.\n338:         await writeFile(temporaryPath, `${lines.slice(-maxRecords).join('\\n')}\\n`, { encoding: 'utf8', mode: PRIVATE_FILE_MODE });\n339:         try {\n340:           await rename(temporaryPath, path);\n341:         } catch (error) {\n342:           await unlink(temporaryPath);\n343:           throw error;\n344:         }\n345:       }\n346:     }\n347:   });\n348:   writeQueues.set(path, next.catch(() => undefined));\n349:   await next;\n350: }\n351: \n352: function tryParseJsonLine(line: string): unknown | null {\n353:   try {\n354:     return JSON.parse(line) as unknown;\n355:   } catch {\n356:     return null;\n357:   }\n358: }\n359: \n360: // ───────────────────────────────────────────────────────────────\n361: // 4. CORE LOGIC\n362: // ───────────────────────────────────────────────────────────────\n363: \n364: /** Return the stable metric definitions emitted by advisor hook diagnostics. */\n365: export function getAdvisorHookMetricDefinitions(): readonly AdvisorMetricDefinition[] {\n366:   return ADVISOR_HOOK_METRIC_DEFINITIONS;\n367: }\n368: \n369: /** Read alert thresholds from environment with conservative defaults. */\n370: export function getAdvisorHookAlertThresholds(): AdvisorHookAlertThresholds {\n371:   return {\n372:     failOpenWarnRate: envNumber('SPECKIT_ADVISOR_HOOK_FAILOPEN_WARN_RATE', DEFAULT_ALERT_THRESHOLDS.failOpenWarnRate),\n373:     failOpenPageRate: envNumber('SPECKIT_ADVISOR_HOOK_FAILOPEN_PAGE_RATE', DEFAULT_ALERT_THRESHOLDS.failOpenPageRate),\n374:     cacheHitP95WarnMs: envNumber('SPECKIT_ADVISOR_HOOK_CACHE_HIT_P95_WARN_MS', DEFAULT_ALERT_THRESHOLDS.cacheHitP95WarnMs),\n375:     cacheHitP95PageMs: envNumber('SPECKIT_ADVISOR_HOOK_CACHE_HIT_P95_PAGE_MS', DEFAULT_ALERT_THRESHOLDS.cacheHitP95PageMs),\n376:   };\n377: }\n378: \n379: /** Build a prompt-safe diagnostic record from hook execution metadata. */\n380: export function createAdvisorHookDiagnosticRecord(input: {\n381:   readonly runtime: AdvisorRuntime;\n382:   readonly status: AdvisorHookStatus;\n383:   readonly freshness: AdvisorHookFreshness;\n384:   readonly durationMs: number;\n385:   readonly cacheHit: boolean;\n386:   readonly errorCode?: unknown;\n387:   readonly errorDetails?: unknown;\n388:   readonly skillLabel?: string | null;\n389:   readonly generation?: number;\n390:   readonly emittedBytes?: number;\n391:   readonly directivesSuppressed?: boolean;\n392:   readonly degraded?: boolean;\n393:   readonly timestamp?: string;\n394: }): AdvisorHookDiagnosticRecord {\n395:   const errorCode = normalizeErrorCode(input.errorCode);\n396:   const errorDetails = sanitizeDiagnosticText(input.errorDetails);\n397:   return {\n398:     timestamp: input.timestamp ?? new Date().toISOString(),\n399:     runtime: input.runtime,\n400:     status: input.status,\n401:     freshness: input.freshness,\n402:     durationMs: Math.max(0, Math.round(input.durationMs)),\n403:     cacheHit: input.cacheHit,\n404:     ...(errorCode ? { errorCode } : {}),\n405:     ...(errorDetails ? { errorDetails } : {}),\n406:     ...(input.skillLabel ? { skillLabel: input.skillLabel } : {}),\n407:     ...(typeof input.generation === 'number' ? { generation: input.generation } : {}),\n408:     ...(typeof input.emittedBytes === 'number' ? { emittedBytes: input.emittedBytes } : {}),\n409:     ...(typeof input.directivesSuppressed === 'boolean' ? { directivesSuppressed: input.directivesSuppressed } : {}),\n410:     ...(input.degraded === true ? { degraded: true } : {}),\n411:   };\n412: }\n413: \n414: /** Validate that a diagnostic record matches the prompt-free closed schema. */\n415: export function validateAdvisorHookDiagnosticRecord(value: unknown): value is AdvisorHookDiagnosticRecord {\n416:   if (typeof value !== 'object' || value === null || Array.isArray(value)) {\n417:     return false;\n418:   }\n419:   const record = value as Record<string, unknown>;\n420:   if ([...FORBIDDEN_DIAGNOSTIC_FIELDS].some((field) => field in record)) {\n421:     return false;\n422:   }\n423:   return typeof record.timestamp === 'string'\n424:     && enumIncludes(ADVISOR_RUNTIME_VALUES, record.runtime)\n425:     && enumIncludes(ADVISOR_HOOK_STATUS_VALUES, record.status)\n426:     && enumIncludes(ADVISOR_HOOK_FRESHNESS_VALUES, record.freshness)\n427:     && typeof record.durationMs === 'number'\n428:     && typeof record.cacheHit === 'boolean'\n429:     && (record.errorCode === undefined || enumIncludes(ADVISOR_ERROR_CODE_VALUES, record.errorCode))\n430:     && (record.errorDetails === undefined || typeof record.errorDetails === 'string')\n431:     && (record.skillLabel === undefined || typeof record.skillLabel === 'string')\n432:     && (record.generation === undefined || typeof record.generation === 'number')\n433:     && (record.emittedBytes === undefined\n434:       || (typeof record.emittedBytes === 'number'\n435:         && Number.isInteger(record.emittedBytes)\n436:         && record.emittedBytes >= 0))\n437:     && (record.directivesSuppressed === undefined || typeof record.directivesSuppressed === 'boolean')\n438:     && (record.degraded === undefined || typeof record.degraded === 'boolean');\n439: }\n440: \n441: /** Serialize a validated diagnostic record for JSONL emission. */\n442: export function serializeAdvisorHookDiagnosticRecord(record: AdvisorHookDiagnosticRecord): string {\n443:   if (!validateAdvisorHookDiagnosticRecord(record)) {\n444:     throw new Error(\n445:       `AdvisorHookDiagnosticRecord: expected prompt-free closed-schema diagnostic record; actual ${typeof record}.`,\n446:     );\n447:   }\n448:   return JSON.stringify(record);\n449: }\n450: \n451: export async function persistAdvisorHookDiagnosticRecord(\n452:   workspaceRoot: string,\n453:   record: AdvisorHookDiagnosticRecord,\n454: ): Promise<string> {\n455:   const path = durableMetricsPath(workspaceRoot, 'diagnostics');\n456:   // A health record answers how the hook runs, which needs no prompt, skill or\n457:   // error text, so it is written on every prompt, and the debug variable adds the\n458:   // two fields that say what the prompt was about.\n459:   const { skillLabel: _skillLabel, errorDetails: _errorDetails, ...promptFreeRecord } = record;\n460:   const persisted = process.env.SKILL_ADVISOR_DEBUG ? record : promptFreeRecord;\n461:   await writeBoundedJsonl(path, serializeAdvisorHookDiagnosticRecord(persisted), MAX_DURABLE_DIAGNOSTIC_RECORDS, { requireDebug: false });\n462:   return path;\n463: }\n464: \n465: export function readAdvisorHookDiagnosticRecords(\n466:   workspaceRoot: string,\n467:   limit = MAX_DURABLE_DIAGNOSTIC_RECORDS,\n468: ): AdvisorHookDiagnosticRecord[] {\n469:   return readJsonlLines(durableMetricsPath(workspaceRoot, 'diagnostics'))\n470:     .slice(-limit)\n471:     .map((line) => JSON.parse(line) as unknown)\n472:     .filter(validateAdvisorHookDiagnosticRecord);\n473: }\n474: \n475: /** Build the rolling health section shown in advisor observability output. */\n476: export function buildAdvisorHookHealthSection(\n477:   records: readonly AdvisorHookDiagnosticRecord[],\n478: ): AdvisorHookHealthSection {\n479:   const lastInvocations = records.slice(-MAX_HEALTH_RECORDS);\n480:   const cacheHits = lastInvocations.filter((record) => record.cacheHit).length;\n481:   const failOpen = lastInvocations.filter((record) => record.status === 'fail_open').length;\n482:   const degraded = lastInvocations.filter((record) => record.degraded === true).length;\n483:   return {\n484:     key: 'advisor-hook-health',\n485:     lastInvocations,\n486:     rollingCacheHitRate: lastInvocations.length > 0 ? cacheHits / lastInvocations.length : 0,\n487:     rollingP95Ms: percentile(\n488:       lastInvocations.filter((record) => record.cacheHit).map((record) => record.durationMs),\n489:       95,\n490:     ),\n491:     rollingFailOpenRate: lastInvocations.length > 0 ? failOpen / lastInvocations.length : 0,\n492:     rollingDegradedRate: lastInvocations.length > 0 ? degraded / lastInvocations.length : 0,\n493:     lastRecordAt: lastInvocations[lastInvocations.length - 1]?.timestamp ?? null,\n494:   };\n495: }\n496: \n497: export function readAdvisorHookHealthSection(workspaceRoot: string): AdvisorHookHealthSection {\n498:   return buildAdvisorHookHealthSection(readAdvisorHookDiagnosticRecords(workspaceRoot));\n499: }\n500: \n501: export function advisorHookDiagnosticsPath(workspaceRoot: string): string {\n502:   return durableMetricsPath(workspaceRoot, 'diagnostics');\n503: }\n504: \n505: // Persists only sanitized skill labels + the accept/correct/ignore signal,\n506: // never the prompt or scenario — deliberate prompt-safety. Real misroutes\n507: // therefore cannot be reconstructed into gold cases from this telemetry; that\n508: // is an accepted capability tradeoff, not an omission to fix by capturing\n509: // prompts (which would breach the prompt-safety invariant).\n510: export function createAdvisorHookOutcomeRecord(input: {\n511:   readonly runtime: AdvisorRuntime;\n512:   readonly outcome: AdvisorOutcome;\n513:   readonly skillLabel: string;\n514:   readonly correctedSkillLabel?: string | null;\n515:   readonly timestamp?: string;\n516: }): AdvisorHookOutcomeRecord {\n517:   return {\n518:     timestamp: input.timestamp ?? new Date().toISOString(),\n519:     runtime: input.runtime,\n[Output truncated. Continue reading with offset: 520]"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"limit\": 220, \"offset\": 300, \"path\": \".skilled/skills/system-skill-advisor/runtime/lib/metrics.ts\"}"},"time":{"start":1794815921670,"end":1794815922140}}}}
