     ? {\n497:           // No error code or class: nothing failed, so naming a failure class\n498:           // here is what made this look like an outage in the first place.\n499:           reason: 'no_recommendation',\n500:           errorMessage: 'CLI_ADVISOR_NO_MATCH',\n501:         }\n502:         : {\n503:           errorCode: 'NON_ZERO_EXIT',\n504:           errorClass: 'unknown',\n505:           errorMessage: freshness === 'absent' ? 'CLI_ADVISOR_ABSENT' : 'CLI_ADVISOR_UNAVAILABLE',\n506:         },\n507:     metrics: {\n508:       durationMs: Number((args.now() - args.startedAt).toFixed(3)),\n509:       cacheHit: cacheHitFrom(args.data),\n510:       subprocessInvoked: true,\n511:       retriesAttempted: 0,\n512:       recommendationCount: recommendations.length,\n513:       tokenCap,\n514:       // The health record counts degraded answers, and only this step knows the\n515:       // answer came from the local scorer: freshness folds it into stale beside\n516:       // a stale graph, so the freshness field alone cannot carry the signal.\n517:       ...(degraded ? { degraded: true } : {}),\n518:     },\n519:     generatedAt: new Date().toISOString(),\n520:     sharedPayload: null,\n521:   };\n522:   return withCliFallbackEnvelope(hookResult, skillAdvisorCliFallbackEnvelope({ status, reason, exitCode: 0 }));\n523: }\n524: \n525: function parseCliPayload(stdout: string): CliRecommendData | null {\n526:   try {\n527:     const parsed = JSON.parse(stdout) as unknown;\n528:     if (!isRecord(parsed) || !isRecord(parsed.data)) {\n529:       return null;\n530:     }\n531:     // degraded and source sit on the envelope, not inside data; fold them in so the\n532:     // freshness decision downstream can still recognise the local-scorer answer.\n533:     return {\n534:       ...parsed.data,\n535:       degraded: parsed.degraded,\n536:       source: parsed.source,\n537:     } as CliRecommendData;\n538:   } catch {\n539:     return null;\n540:   }\n541: }\n542: \n543: 