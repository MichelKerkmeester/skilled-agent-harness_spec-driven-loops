de\",\n13:       \"model\": \"opencode-go/deepseek-v4.1-flash\",\n14:       \"reasoningEffort\": \"max\",\n15:       \"iterations\": 3,\n16:       \"label\": \"arena-config-6\",\n17:       \"count\": 1\n18:     },\n19:     {\n20:       \"kind\": \"cli-opencode\",\n21:       \"model\": \"opencode-go/deepseek-v4.1-flash\",\n22:       \"reasoningEffort\": \"max\",\n23:       \"iterations\": 3,\n24:       \"label\": \"merge-docs-6\",\n25:       \"count\": 1\n26:     }\n27:   ],\n28:   \"concurrency\": 3\n29: }"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\": \"specs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/review/deep-review-fanout-config-pass-6.json\"}"},"time":{"start":1794815561465,"end":1794815561813}}}}
