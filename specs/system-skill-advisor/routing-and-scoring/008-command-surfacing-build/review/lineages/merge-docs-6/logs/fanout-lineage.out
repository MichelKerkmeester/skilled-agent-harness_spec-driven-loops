ffectivePolicyHash: EMPTY_DIGEST,\n.skilled/bin/lib/compiled-routing/004-compiler-n1-shadow/compiler/compiler.cjs:768:    completePolicy.effectivePolicyHash = computeEffectivePolicyHash(completePolicy);\n.skilled/bin/lib/compiled-routing/014-runtime-engine/lib/resolve.cjs:11://   3. the routed snapshot's identity (effectivePolicyHash + generation) matches\n--- policy dir\nactivation\n--- 252cd hash refs\n./.skilled/bin/lib/compiled-routing/013-live-activation/activation/sk-doc/manifest.json\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\": \"cd /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research && grep -rn \\\"effectivePolicyHash\\\" .skilled/bin/lib/compiled-routing --include=*.json --include=*.cjs --include=*.mjs 2>/dev/null | head -10; echo \\\"--- policy dir\\\"; ls .skilled/bin/lib/compiled-routing/013-live-activation/ 2>/dev/null | head; echo \\\"--- 252cd hash refs\\\"; grep -rl \\\"252cd2b5c4a1afdb20bedefe96ecb671df9ac8b062ddac52fa5643da43c95f86\\\" . --exclude-dir=node_modules --exclude-dir=specs --exclude-dir=.git 2>/dev/null | head\"}"},"time":{"start":1794816937289,"end":1794816941553}}}}
