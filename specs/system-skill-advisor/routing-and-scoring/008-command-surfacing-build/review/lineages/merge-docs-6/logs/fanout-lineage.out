 find . -path ./specs -prune -o -path ./node_modules -prune -o -iname \\\"skill.md\\\" -print 2>/dev/null | grep -v \\\"/skills/\\\" | grep -v \\\"/specs/\\\" | head -20\"}"},"time":{"start":1794816684790,"end":1794816687854}}}}
