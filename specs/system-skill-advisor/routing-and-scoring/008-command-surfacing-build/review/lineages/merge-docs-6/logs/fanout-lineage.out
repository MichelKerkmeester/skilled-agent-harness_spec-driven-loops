9:   return simpleCommands(readWords(command)).some((words) => {\n360:     if (runsNodeOnMarker(words, marker)) return true;\n361:     if (depth >= 2) return false;\n362:     const script = scriptWord(words);\n363:     return script !== null && runsMarker(script.text, marker, depth + 1);\n364:   });\n365: }\n366: \n367: function inspect(runtime, root) {\n368:   const file = path.join(root, runtime.file);\n369:   // A toml hook file is text rather than JSON, so the line reader reads it.\n370:   if (runtime.format === 'toml') {\n371:     let text;\n372:     try {\n373:       text = fs.readFileSync(file, 'utf8');\n374:     } catch {\n375:       return { runtime: runtime.id, file: runtime.file, status: 'hook-missing' };\n376:     }\n377:     // The doctor cannot run Vibe's matcher, so only a block with no selector or\n378:     // the main agent's name proves the entry runs before the prompt it reports on.\n379:     const wired = tomlCommands(text, runtime.event)\n380:       .filter((block) => block.match === undefined || block.match === 'main')\n381:       .some((block) => runsMarker(block.command, runtime.marker));\n382:     return { runtime: runtime.id, file: runtime.file, status: wired ? 'ok' : 'hook-missing' };\n383:   }\n384:   let document;\n385:   try {\n386:     document = JSON.parse(fs.readFileSync(file, 'utf8'));\n387:   } catch {\n388:     return { runtime: runtime.id, file: runtime.file, status: 'hook-missing' };\n389:   }\n390:   const payload = eventPayload(document, runtime.event);\n391:   const wired = collectCommands(payload, []).some((command) => runsMarker(command, runtime.marker));\n392:   return { runtime: runtime.id, file: runtime.file, status: wired ? 'ok' : 'hook-missing' };\n393: }\n394: \n395: // ─────────────────────────────────────────────────────────────────────────────\n396: // 4. MAIN\n397: // ─────────────────────────────────────────────────────────────────────────────\n398: \n399: function main(argv) {\n400:   const opts = parseArgs(argv);\n401:   const checks = RUNTIMES.map((runtime) => {\n402:     if (!fs.existsSync(path.join(opts.root, runtime.dir))) {\n403:       return { runtime: runtime.id, file: runtime.file, status: 'skipped' };\n404:     }\n405:     return inspect(runtime, opts.root);\n406:   });\n[Output truncated. Continue reading with offset: 407]","title":"read","metadata":{"metadata":{"truncated":true},"content":[{"type":"text","text":"Read file .skilled/commands/doctor/scripts/hook-wiring-check.cjs, lines 327-406\n327: function runsNodeOnMarker(words, marker) {\n328:   const rest = commandWords(words);\n329:   if (rest.length === 0 || !isNodeExecutable(rest[0].text)) return false;\n330:   let index = 1;\n331:   while (index < rest.length && rest[index].text.startsWith('-')) {\n332:     const flag = rest[index].text;\n333:     if (nodeFlagSkipsScript(flag)) return false;\n334:     index += NODE_FLAGS_WITH_ARGUMENT.has(flag) ? 2 : 1;\n335:   }\n336:   return index < rest.length && rest[index].text.endsWith(marker);\n337: }\n338: \n339: // bash -c and its login, sh and zsh forms hand the next word to a shell as a\n340: // script, so that word is read again as commands. No other word is.\n341: function scriptWord(words) {\n342:   const rest = commandWords(words);\n343:   if (rest.length < 2 || !isShellExecutable(rest[0].text)) return null;\n344:   // The first word that is not a flag is a script file, and what follows it\n345:   // belongs to that script.\n346:   for (let index = 1; index < rest.length - 1; index += 1) {\n347:     const flag = rest[index].text;\n348:     if (!flag.startsWith('-')) return null;\n349:     if (!flag.startsWith('--') && flag.slice(1).includes('c')) {\n350:       return rest[index + 1];\n351:     }\n352:   }\n353:   return null;\n354: }\n355: \n356: // An argument that only names node, as `echo node <script>` does, runs\n357: // nothing, so node must stand where a shell starts a command.\n358: function runsMarker(command, marker, depth = 0) {\n359:   return s