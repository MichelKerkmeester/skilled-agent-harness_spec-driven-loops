o single mode says\n618:  const head = `Advisor: ${result.freshness}; use ${headLabel} `\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\": \"cd /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research && grep -n \\\"use \\\\|commandLabel(\\\" .skilled/skills/system-skill-advisor/runtime/lib/render.ts | head -20\"}"},"time":{"start":1794816454642,"end":1794816454858}}}}
