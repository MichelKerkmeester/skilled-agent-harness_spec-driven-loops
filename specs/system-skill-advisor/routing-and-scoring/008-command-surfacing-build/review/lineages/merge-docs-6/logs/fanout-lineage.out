{"type":"tool_use","timestamp":1794817246125,"sessionID":"ses_e1ca84ea9ffed5hOlqAimuHTWO","part":{"partID":"prt_1e371c23f001bxMwP6lS31C6tk","sessionID":"ses_e1ca84ea9ffed5hOlqAimuHTWO","messageID":"msg_1e37149f3001zIu3zfCjttlWtw","type":"tool","id":"chatcmpl-tool-883c766753cbadbb","tool":"read","state":{"status":"completed","input":{"limit":40,"offset":1,"path":".skilled/hooks/shared/session-readers/cursor.mjs"},"output":"Read file .skilled/hooks/shared/session-readers/cursor.mjs, lines 1-39\n1: // ───────────────────────────────────────────────────────────────────\n2: // MODULE: Cursor Capability Gate\n3: // ───────────────────────────────────────────────────────────────────\n4: // Cursor registers a preCompact hook but no forcing mechanism has been proven\n5: // to deliver it, so there is no trustworthy moment to capture or read a Cursor\n6: // session. The runtime stays behind one operator switch; while the switch is\n7: // off the reader returns before touching any file.\n8: \n9: // ─────────────────────────────────────────────────────────────────────────────\n10: // 1. IMPORTS\n11: // ─────────────────────────────────────────────────────────────────────────────\n12: \n13: import { createRequire } from 'node:module';\n14: \n15: const require = createRequire(import.meta.url);\n16: const hookFlags = require('../hook-flags.cjs');\n17: \n18: // ─────────────────────────────────────────────────────────────────────────────\n19: // 2. CONSTANTS\n20: // ─────────────────────────────────────────────────────────────────────────────\n21: \n22: const ENABLE_FLAG = 'SYSTEM_SESSION_READERS_CURSOR_ENABLED';\n23: \n24: // ─────────────────────────────────────────────────────────────────────────────\n25: // 3. GATE\n26: // ─────────────────────────────────────────────────────────────────────────────\n27: \n28: export function cursorEnabled({ env, config } = {}) {\n29:   return hookFlags.isFlagOn(ENABLE_FLAG, env, config);\n30: }\n31: \n32: export function loadCursorSession(options = {}) {\n33:   if (!cursorEnabled(options)) {\n34:     return { ok: false, code: 'capability_gated' };\n35:   }\n36:   // The switch allows a future reader, not an unproven one: until preCompact\n37:   // delivery is confirmed there is no store path to resolve.\n38:   return { ok: false, code: 'locator_unavailable' };\n39: }","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file .skilled/hooks/shared/session-readers/cursor.mjs, lines 1-39\n1: // ───────────────────────────────────────────────────────────────────\n2: // MODULE: Cursor Capability Gate\n3: // ───────────────────────────────────────────────────────────────────\n4: // Cursor registers a preCompact hook but no forcing mechanism has been proven\n5: // to deliver it, so there is no trustworthy moment to capture or read a Cursor\n6: // session. The runtime stays behind one operator switch; while the switch is\n7: // off the reader returns before touching any file.\n8: \n9: // ─────────────────────────────────────────────────────────────────────────────\n10: // 1. IMPORTS\n11: // ─────────────────────────────────────────────────────────────────────────────\n12: \n13: import { createRequire } from 'node:module';\n14: \n15: const require = createRequire(import.meta.url);\n16: const hookFlags = require('../hook-flags.cjs');\n17: \n18: // ─────────────────────────────────────────────────────────────────────────────\n19: // 2. CONSTANTS\n20: // ─────────────────────────────────────────────────────────────────────────────\n21: \n22: const ENABLE_FLAG = 'SYSTEM_SESSION_READERS_CURSOR_ENABLED';\n23: \n24: // ─────────────────────────────────────────────────────────────────────────────\n25: // 3. GATE\n26: // ─────────────────────────────────────────────────────────────────────────────\n27: \n28: export function cursorEnabled({ env, config } = {}) {\n29:   return hookFlags.isFlagOn(ENABLE_FLAG, env, config);\n30: }\n31: \n32: export function loadCursorSession(options = {}) {\n33:   if (!cursorEnabled(options)) {\n34:     return { ok: false, code: 'capability_gated' };\n35:   }\n36:   // The switch allows a future reader, not an unproven one: until preCompact\n37:   // delivery is confirmed there is no store path to resolve.\n38:   return { ok: false, code: 'locator_unavailable' };\n39: }"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"limit\": 40, \"offset\": 1, \"path\": \".skilled/hooks/shared/session-readers/cursor.mjs\"}"},"time":{"start":1794817245759,"end":1794817246125}}}}
