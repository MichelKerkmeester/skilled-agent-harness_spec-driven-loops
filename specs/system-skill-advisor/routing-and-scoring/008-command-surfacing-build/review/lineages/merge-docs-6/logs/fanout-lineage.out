{"type":"tool_use","timestamp":1794816966933,"sessionID":"ses_e1ca84ea9ffed5hOlqAimuHTWO","part":{"partID":"prt_1e36d7f76002TQ6DuV5TCs7qxD","sessionID":"ses_e1ca84ea9ffed5hOlqAimuHTWO","messageID":"msg_1e36d6e89001StoRIwy68pRcY0","type":"tool","id":"chatcmpl-tool-924855d5b99f576b","tool":"read","state":{"status":"completed","input":{"limit":110,"offset":60,"path":".skilled/bin/lib/compiled-routing/014-runtime-engine/lib/resolve.cjs"},"output":"Read file .skilled/bin/lib/compiled-routing/014-runtime-engine/lib/resolve.cjs, lines 60-155\n60: function parseFlagMode(raw) {\n61:   if (raw === undefined || raw === '') return 'default';\n62:   if (raw === '1') return 'force-on';\n63:   if (raw === '0' || raw === 'false' || raw === 'off') return 'force-legacy';\n64:   return 'invalid';\n65: }\n66: \n67: // Whether the flag permits compiled serving for this hub. The manifest\n68: // serving-authority gate in resolveRoute still applies on top of this, so a\n69: // permitted hub without a compiled manifest still routes legacy.\n70: function flagPermitsCompiled(hubId) {\n71:   const mode = parseFlagMode(process.env[FLAG]);\n72:   if (mode === 'force-on') return true;\n73:   if (mode === 'default') return DEFAULT_ON_HUBS.has(hubId);\n74:   if (mode === 'invalid') {\n75:     breadcrumb(`ignoring invalid ${FLAG}=${JSON.stringify(process.env[FLAG])}; serving legacy`);\n76:     return false;\n77:   }\n78:   return false; // force-legacy\n79: }\n80: \n81: // Retained export: true only when the operator forced the flag on, which is the\n82: // exact bi-state meaning callers of this predicate relied on before tri-state.\n83: function flagEnabled() {\n84:   return parseFlagMode(process.env[FLAG]) === 'force-on';\n85: }\n86: \n87: function readManifest(hubId) {\n88:   const manifest = path.join(ACTIVATION_ROOT, hubId, 'manifest.json');\n89:   if (!fs.existsSync(manifest)) return null;\n90:   try {\n91:     return JSON.parse(fs.readFileSync(manifest, 'utf8'));\n92:   } catch {\n93:     return null;\n94:   }\n95: }\n96: \n97: function servingAuthority(hubId) {\n98:   const manifest = readManifest(hubId);\n99:   return (manifest && manifest.servingAuthority) || 'legacy';\n100: }\n101: \n102: // Returns a normalized compiled decision when this hub is served by the compiled\n103: // contract and the flag is on; otherwise null (use legacy routing). Fails safe:\n104: // any error resolving the compiled route returns null rather than throwing into\n105: // a routing hot path. `options.surfaceHint` passes through to the engine, which\n106: // uses it only to reorder surfaces the prompt already matched.\n107: function resolveRoute(hubId, taskText, options = {}) {\n108:   if (!flagPermitsCompiled(hubId)) return null;\n109:   const manifest = readManifest(hubId);\n110:   if (!manifest || manifest.servingAuthority !== 'compiled') return null;\n111:   try {\n112:     const route = compiledRoute(hubId, taskText, options);\n113:     // Serve-time identity binding: the snapshot we routed through MUST be the\n114:     // exact generation the manifest selected. If a rollout artifact drifted after\n115:     // the flip, the identities diverge — fail safe to legacy rather than serve an\n116:     // unselected policy on the routing hot path.\n117:     const selected = manifest.selectedPolicy || {};\n118:     if (route.effectivePolicyHash !== selected.effectivePolicyHash\n119:       || route.generation !== selected.generation) {\n120:       return null;\n121:     }\n122:     return route;\n123:   } catch (err) {\n124:     breadcrumb(`resolveRoute fell back to legacy for hub=${hubId}: ${err && err.message}`);\n125:     return null;\n126:   }\n127: }\n128: \n129: module.exports = {\n130:   resolveRoute,\n131:   servingAuthority,\n132:   flagEnabled,\n133:   flagPermitsCompiled,\n134:   parseFlagMode,\n135:   DEFAULT_ON_HUBS,\n136:   FLAG,\n137:   DEBUG_FLAG,\n138:   ACTIVATION_ROOT,\n139: };\n140: \n141: // CLI front door: the invocable entry a compiled-serving hub's SKILL.md routing\n142: // directive calls. Prints the compiled decision when authoritative, else a\n143: // legacy sentinel so the caller falls back to the prose smart-router.\n144: if (require.main === module) {\n145:   const args = process.argv.slice(2);\n146:   const hub = args[args.indexOf('--hub') + 1];\n147:   const promptIdx = args.indexOf('--prompt');\n148:   const prompt = promptIdx >= 0 ? args[promptIdx + 1] : '';\n149:   if (!hub) {\n150:     process.stderr.write('usage: resolve.cjs --hub <hubId> --prompt <text>\\n');\n151:     process.exit(2);\n152:   }\n153:   const route = resolveRoute(hub, prompt);\n154:   process.stdout.write(`${JSON.stringify(route || { servingAuthority: 'legacy', hubId: hub })}\\n`);\n155: }","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file .skilled/bin/lib/compiled-routing/014-runtime-engine/lib/resolve.cjs, lines 60-155\n60: function parseFlagMode(raw) {\n61:   if (raw === undefined || raw === '') return 'default';\n62:   if (raw === '1') return 'force-on';\n63:   if (raw === '0' || raw === 'false' || raw === 'off') return 'force-legacy';\n64:   return 'invalid';\n65: }\n66: \n67: // Whether the flag permits compiled serving for this hub. The manifest\n68: // serving-authority gate in resolveRoute still applies on top of this, so a\n69: // permitted hub without a compiled manifest still routes legacy.\n70: function flagPermitsCompiled(hubId) {\n71:   const mode = parseFlagMode(process.env[FLAG]);\n72:   if (mode === 'force-on') return true;\n73:   if (mode === 'default') return DEFAULT_ON_HUBS.has(hubId);\n74:   if (mode === 'invalid') {\n75:     breadcrumb(`ignoring invalid ${FLAG}=${JSON.stringify(process.env[FLAG])}; serving legacy`);\n76:     return false;\n77:   }\n78:   return false; // force-legacy\n79: }\n80: \n81: // Retained export: true only when the operator forced the flag on, which is the\n82: // exact bi-state meaning callers of this predicate relied on before tri-state.\n83: function flagEnabled() {\n84:   return parseFlagMode(process.env[FLAG]) === 'force-on';\n85: }\n86: \n87: function readManifest(hubId) {\n88:   const manifest = path.join(ACTIVATION_ROOT, hubId, 'manifest.json');\n89:   if (!fs.existsSync(manifest)) return null;\n90:   try {\n91:     return JSON.parse(fs.readFileSync(manifest, 'utf8'));\n92:   } catch {\n93:     return null;\n94:   }\n95: }\n96: \n97: function servingAuthority(hubId) {\n98:   const manifest = readManifest(hubId);\n99:   return (manifest && manifest.servingAuthority) || 'legacy';\n100: }\n101: \n102: // Returns a normalized compiled decision when this hub is served by the compiled\n103: // contract and the flag is on; otherwise null (use legacy routing). Fails safe:\n104: // any error resolving the compiled route returns null rather than throwing into\n105: // a routing hot path. `options.surfaceHint` passes through to the engine, which\n106: // uses it only to reorder surfaces the prompt already matched.\n107: function resolveRoute(hubId, taskText, options = {}) {\n108:   if (!flagPermitsCompiled(hubId)) return null;\n109:   const manifest = readManifest(hubId);\n110:   if (!manifest || manifest.servingAuthority !== 'compiled') return null;\n111:   try {\n112:     const route = compiledRoute(hubId, taskText, options);\n113:     // Serve-time identity binding: the snapshot we routed through MUST be the\n114:     // exact generation the manifest selected. If a rollout artifact drifted after\n115:     // the flip, the identities diverge — fail safe to legacy rather than serve an\n116:     // unselected policy on the routing hot path.\n117:     const selected = manifest.selectedPolicy || {};\n118:     if (route.effectivePolicyHash !== selected.effectivePolicyHash\n119:       || route.generation !== selected.generation) {\n120:       return null;\n121:     }\n122:     return route;\n123:   } catch (err) {\n124:     breadcrumb(`resolveRoute fell back to legacy for hub=${hubId}: ${err && err.message}`);\n125:     return null;\n126:   }\n127: }\n128: \n129: module.exports = {\n130:   resolveRoute,\n131:   servingAuthority,\n132:   flagEnabled,\n133:   flagPermitsCompiled,\n134:   parseFlagMode,\n135:   DEFAULT_ON_HUBS,\n136:   FLAG,\n137:   DEBUG_FLAG,\n138:   ACTIVATION_ROOT,\n139: };\n140: \n141: // CLI front door: the invocable entry a compiled-serving hub's SKILL.md routing\n142: // directive calls. Prints the compiled decision when authoritative, else a\n143: // legacy sentinel so the caller falls back to the prose smart-router.\n144: if (require.main === module) {\n145:   const args = process.argv.slice(2);\n146:   const hub = args[args.indexOf('--hub') + 1];\n147:   const promptIdx = args.indexOf('--prompt');\n148:   const prompt = promptIdx >= 0 ? args[promptIdx + 1] : '';\n149:   if (!hub) {\n150:     process.stderr.write('usage: resolve.cjs --hub <hubId> --prompt <text>\\n');\n151:     process.exit(2);\n152:   }\n153:   const route = resolveRoute(hub, prompt);\n154:   process.stdout.write(`${JSON.stringify(route || { servingAuthority: 'legacy', hubId: hub })}\\n`);\n155: }"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"limit\": 110, \"offset\": 60, \"path\": \".skilled/bin/lib/compiled-routing/014-runtime-engine/lib/resolve.cjs\"}"},"time":{"start":1794816966518,"end":1794816966933}}}}
