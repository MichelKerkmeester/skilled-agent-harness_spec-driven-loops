{"type":"tool_use","timestamp":1794539630981,"sessionID":"ses_e2d1e00b7ffeXYNr5JwmmzZPgF","part":{"partID":"prt_1d2e5af38001tJ3GOoDCMX3I85","sessionID":"ses_e2d1e00b7ffeXYNr5JwmmzZPgF","messageID":"msg_1d2e5a259001iy9ey3RoFAmrpx","type":"tool","id":"call_7cc96798bb57495b8c392256","tool":"shell","state":{"status":"completed","input":{"command":"git -c core.fsmonitor=false diff -- .skilled/skills/system-spec-kit/runtime/cli/runtime-mirrors/sync-runtime-mirrors.cjs .skilled/skills/system-spec-kit/runtime/cli/tests/sync-runtime-mirrors.test.mjs","workdir":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research"},"output":"diff --git a/.skilled/skills/system-spec-kit/runtime/cli/runtime-mirrors/sync-runtime-mirrors.cjs b/.skilled/skills/system-spec-kit/runtime/cli/runtime-mirrors/sync-runtime-mirrors.cjs\nindex 10f9203f32..b8e6dd6df4 100644\n--- a/.skilled/skills/system-spec-kit/runtime/cli/runtime-mirrors/sync-runtime-mirrors.cjs\n+++ b/.skilled/skills/system-spec-kit/runtime/cli/runtime-mirrors/sync-runtime-mirrors.cjs\n@@ -33,6 +33,10 @@ const { isCanonicalMirrorExcluded, isRuntimeNativeCommand } = require('./command\n const { findRepoRoot } = require('@spec-kit/shared/workspace/repo-root.mjs');\n const REPO_ROOT = findRepoRoot(__dirname);\n const EXCLUDED_COMMAND_DIRS = new Set(['assets', 'scripts', 'fixtures']);\n+// Claude Code reads a command folder holding skill.md as one skill and hides\n+// its sibling commands. The existing case stays allowlisted until those\n+// commands are renamed.\n+const COLLAPSE_ALLOWLIST = new Set(['create/skill.md']);\n \n // Cursor and Devin parse the Claude agent dialect (`tools:`), not OpenCode's\n // `permission:` block, so agents deliberately source from .claude/agents.\n@@ -227,6 +231,51 @@ function expectedTarget(mirrorRelative, sourceRelative, repoRoot = REPO_ROOT) {\n   );\n }\n \n+/**\n+ * Count the commands each runtime actually shows. Claude Code resolves a folder\n+ * holding skill.md as one skill, so its siblings disappear. Cursor reads every\n+ * command under a flat name, so nothing is hidden there.\n+ */\n+function commandVisibility(expectedLinks) {\n+  const folders = new Map();\n+  for (const link of expectedLinks) {\n+    if (link.tree !== 'claude-commands') continue;\n+    const relativePath = link.mirror.slice(`${CLAUDE_COMMANDS}/`.length);\n+    const folder = path.posix.dirname(relativePath);\n+    // A command at the root belongs to no folder, so Claude Code cannot collapse it.\n+    if (folder === '.') continue;\n+    if (!folders.has(folder)) folders.set(folder, []);\n+    folders.get(folder).push(path.posix.basename(relativePath));\n+  }\n+  let visible = 0;\n+  let total = 0;\n+  for (const names of folders.values()) {\n+    total += names.length;\n+    visible += names.includes('skill.md') ? 1 : names.length;\n+  }\n+  return { claude: { visible, total }, cursor: { visible: total, total } };\n+}\n+\n+/** Folders where a skill.md hides the folder's other commands from Claude Code. */\n+function collapseDrift(expectedLinks) {\n+  const folders = new Map();\n+  for (const link of expectedLinks) {\n+    if (link.tree !== 'claude-commands') continue;\n+    const relativePath = link.mirror.slice(`${CLAUDE_COMMANDS}/`.length);\n+    const folder = path.posix.dirname(relativePath);\n+    if (folder === '.') continue;\n+    if (!folders.has(folder)) folders.set(folder, []);\n+    folders.get(folder).push(path.posix.basename(relativePath));\n+  }\n+  const drift = [];\n+  for (const [folder, names] of folders) {\n+    if (!names.includes('skill.md')) continue;\n+    if (COLLAPSE_ALLOWLIST.has(`${folder}/skill.md`)) continue;\n+    drift.push(`COLLAPSE ${folder}/skill.md hides ${names.length - 1} sibling commands on Claude Code`);\n+  }\n+  return drift;\n+}\n+\n /** Build output is regenerated, never committed, so its absence is not drift. */\n function isBuildArtifact(target) {\n   return target.split('/').includes('dist');\n@@ -332,6 +381,7 @@ function checkMirrors(expectedLinks, repoRoot = REPO_ROOT) {\n     else if (result.state === 'STALE') drift.push(`STALE ${link.mirror} — ${result.why}`);\n   }\n   for (const orphan of findOrphans(expectedLinks, repoRoot)) drift.push(`EXTRA ${orphan}`);\n+  for (const collapse of collapseDrift(expectedLinks)) drift.push(collapse);\n \n   if (drift.length > 0) {\n     console.error('[runtime-mirror-sync] Drift detected:');\n@@ -339,7 +389,9 @@ function checkMirrors(expectedLinks, repoRoot = REPO_ROOT) {\n     return false;\n   }\n \n+  const visibility = commandVisibility(expectedLinks);\n   const trees = new Set(expectedLinks.map((l) => l.tree));\n+  console.log(`[runtime-mirror-sync] visibility claude ${visibility.claude.visible}/${visibility.claude.total}, cursor ${visibility.cursor.visible}/${visibility.cursor.total}`);\n   console.log(`[runtime-mirror-sync] PASS: ${expectedLinks.length} mirrors across ${trees.size} trees are in sync.`);\n   return true;\n }\n@@ -410,4 +462,4 @@ if (require.main === module) {\n   }\n }\n \n-module.exports = { buildExpectedLinks, checkMirrors, dshAdapterLinks, findOrphans, writeMirrors };\n+module.exports = { buildExpectedLinks, checkMirrors, collapseDrift, commandVisibility, dshAdapterLinks, findOrphans, writeMirrors };\ndiff --git a/.skilled/skills/system-spec-kit/runtime/cli/tests/sync-runtime-mirrors.test.mjs b/.skilled/skills/system-spec-kit/runtime/cli/tests/sync-runtime-mirrors.test.mjs\nindex 78e90e41e5..78bc201cac 100644\n--- a/.skilled/skills/system-spec-kit/runtime/cli/tests/sync-runtime-mirrors.test.mjs\n+++ b/.skilled/skills/system-spec-kit/runtime/cli/tests/sync-runtime-mirrors.test.mjs\n@@ -29,6 +29,8 @@ const fixtureRoot = join(resolve(scratchRoot), 'sync-runtime-mirrors-fixtures');\n const {\n   buildExpectedLinks,\n   checkMirrors,\n+  collapseDrift,\n+  commandVisibility,\n   dshAdapterLinks,\n   findOrphans,\n   writeMirrors,\n@@ -258,3 +260,26 @@ test('derives each DSH adapter link from the hook library and flags a real file\n     rmSync(root, { recursive: true, force: true });\n   }\n });\n+\n+test('counts what each runtime shows and allows the known create collapse', () => {\n+  const expected = [\n+    { tree: 'claude-commands', mirror: '.claude/commands/create/skill.md', source: '.skilled/commands/create/skill.md' },\n+    { tree: 'claude-commands', mirror: '.claude/commands/create/readme.md', source: '.skilled/commands/create/readme.md' },\n+    { tree: 'claude-commands', mirror: '.claude/commands/deep/review.md', source: '.skilled/commands/deep/review.md' },\n+  ];\n+  assert.deepEqual(commandVisibility(expected), {\n+    claude: { visible: 2, total: 3 },\n+    cursor: { visible: 3, total: 3 },\n+  });\n+  assert.deepEqual(collapseDrift(expected), []);\n+});\n+\n+test('flags a command folder whose skill.md hides its siblings on Claude Code', () => {\n+  const expected = [\n+    { tree: 'claude-commands', mirror: '.claude/commands/design/skill.md', source: '.skilled/commands/design/skill.md' },\n+    { tree: 'claude-commands', mirror: '.claude/commands/design/chart.md', source: '.skilled/commands/design/chart.md' },\n+  ];\n+  assert.deepEqual(collapseDrift(expected), [\n+    'COLLAPSE design/skill.md hides 1 sibling commands on Claude Code',\n+  ]);\n+});\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"diff --git a/.skilled/skills/system-spec-kit/runtime/cli/runtime-mirrors/sync-runtime-mirrors.cjs b/.skilled/skills/system-spec-kit/runtime/cli/runtime-mirrors/sync-runtime-mirrors.cjs\nindex 10f9203f32..b8e6dd6df4 100644\n--- a/.skilled/skills/system-spec-kit/runtime/cli/runtime-mirrors/sync-runtime-mirrors.cjs\n+++ b/.skilled/skills/system-spec-kit/runtime/cli/runtime-mirrors/sync-runtime-mirrors.cjs\n@@ -33,6 +33,10 @@ const { isCanonicalMirrorExcluded, isRuntimeNativeCommand } = require('./command\n const { findRepoRoot } = require('@spec-kit/shared/workspace/repo-root.mjs');\n const REPO_ROOT = fin