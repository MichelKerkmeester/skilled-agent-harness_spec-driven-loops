Path));\\n  }\\n  const drift = [];\\n  for (const [folder, names] of folders) {\\n    if (!names.includes('skill.md')) continue;\\n    if (COLLAPSE_ALLOWLIST.has(`${folder}/skill.md`)) continue;\\n    drift.push(`COLLAPSE ${folder}/skill.md hides ${names.length - 1} sibling commands on Claude Code`);\\n  }\\n  return drift;\\n}\",\"oldString\":\"// Mirrors are relative symlinks so the tree stays valid when the repo moves.\\nfunction expectedTarget(mirrorRelative, sourceRelative, repoRoot = REPO_ROOT) {\\n  return path.relative(\\n    path.dirname(path.join(repoRoot, mirrorRelative)),\\n    path.join(repoRoot, sourceRelative),\\n  );\\n}\",\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-spec-kit/runtime/cli/runtime-mirrors/sync-runtime-mirrors.cjs\"}"},"time":{"start":1794539568804,"end":1794539573305}}}}
