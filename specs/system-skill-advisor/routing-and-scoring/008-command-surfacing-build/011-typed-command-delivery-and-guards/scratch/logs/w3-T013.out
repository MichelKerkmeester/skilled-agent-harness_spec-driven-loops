{"type":"tool_use","timestamp":1794540305317,"sessionID":"ses_e2d114b6fffeDMvOBXH8hRDbEL","part":{"partID":"prt_1d2eff831001JX96xkqHvFGWVW","sessionID":"ses_e2d114b6fffeDMvOBXH8hRDbEL","messageID":"msg_1d2efb613001cTNjhzolxTqc9z","type":"tool","id":"call_cac5d65fa7e2414b88b5c15e","tool":"read","state":{"status":"completed","input":{"path":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/schemas/advisor-tool-schemas.ts"},"output":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/schemas/advisor-tool-schemas.ts, lines 1-651\n1: // ───────────────────────────────────────────────────────────────\n2: // MODULE: Advisor Tool Schemas\n3: // ───────────────────────────────────────────────────────────────\n4: \n5: // ───────────────────────────────────────────────────────────────────\n6: // 1. IMPORTS\n7: // ───────────────────────────────────────────────────────────────────\n8: \n9: import { z } from 'zod';\n10: import { existsSync, realpathSync } from 'node:fs';\n11: import { resolve, sep } from 'node:path';\n12: import { tmpdir } from 'node:os';\n13: import { ADVISOR_RUNTIME_VALUES } from '../lib/advisor-runtime-values.js';\n14: import { SCORER_LANE_IDS } from '../lib/scorer/lane-registry.js';\n15: \n16: // ───────────────────────────────────────────────────────────────────\n17: // 2. CONSTANTS\n18: // ───────────────────────────────────────────────────────────────────\n19: \n20: export const AdvisorFreshnessSchema = z.enum(['live', 'stale', 'absent', 'unavailable']);\n21: export const AdvisorLaneSchema = z.enum(SCORER_LANE_IDS);\n22: \n23: // ───────────────────────────────────────────────────────────────────\n24: // 3. HELPERS\n25: // ───────────────────────────────────────────────────────────────────\n26: \n27: // Bound caller-supplied workspaceRoot inputs to a small\n28: // allowlist (repo root + os.tmpdir()) so handlers cannot be coerced into\n29: // resolving paths outside the workspace. resolve() canonicalizes the input\n30: // path; realpathSync follows symlinks; the prefix check rejects anything\n31: // that escapes the allowlist after canonicalization.\n32: //\n33: // Directory names the source tree may sit under. A checkout may link one to the\n34: // other, so both mark the same tree.\n35: const SOURCE_ROOT_NAMES: readonly string[] = ['.skilled', '.opencode'];\n36: \n37: // Repo root is detected by walking up from process.cwd() looking for the\n38: // system-spec-kit SKILL.md sentinel — same shape as findAdvisorWorkspaceRoot but\n39: // inlined here to avoid a circular import between schemas/ and lib/. The start\n40: // directory is a parameter so the lockstep test can feed both resolvers one tree.\n41: export function detectRepoRoot(start: string = process.cwd()): string {\n42:   // Use the same SKILL.md file sentinel as findAdvisorWorkspaceRoot so the schema\n43:   // and the handler agree on which directory is the workspace root. A bare\n44:   // directory sentinel would match the nested mock trees other workflows create.\n45:   // The source tree sits under `.skilled` or `.opencode`, so the sentinel is\n46:   // tested under both.\n47:   const sentinels = SOURCE_ROOT_NAMES.map((name) => `${name}/skills/system-spec-kit/SKILL.md`);\n48:   let current = resolve(start);\n49:   for (let index = 0; index < 14; index += 1) {\n50:     if (sentinels.some((sentinel) => existsSync(resolve(current, sentinel)))) return current;\n51:     const parent = resolve(current, '..');\n52:     if (parent === current) break;\n53:     current = parent;\n54:   }\n55:   // Lockstep with findAdvisorWorkspaceRoot: when the walk misses the sentinel,\n56:   // never anchor the allowlist on a directory inside a source tree. Take the start\n57:   // or the nearest source-root parent that holds the sentinel, else hoist above the\n58:   // outermost source-root segment, so caller-supplied workspaceRoots are bounded\n59:   // to the real root, not a nested subdir.\n60:   return nearestSentinelHolder(start, sentinels) ?? hoistAboveOpencodeTree(start) ?? resolve(start);\n61: }\n62: \n63: // Inlined twin of lib/utils/workspace-root.ts:nearestSentinelHolder, kept local for\n64: // the same reason as the hoist below. A capped walk misses the sentinel, yet the root\n65: // is still the start or the parent of one source-root segment in the start path, so\n66: // testing the start and then those parents nearest first keeps a repository that\n67: // sits under a directory named .skilled or .opencode.\n68: function nearestSentinelHolder(dir: string, sentinels: readonly string[]): string | null {\n69:   const holdsSentinel = (candidate: string): boolean => sentinels.some((sentinel) => existsSync(resolve(candidate, sentinel)));\n70:   if (holdsSentinel(dir)) return resolve(dir);\n71:   const parts = resolve(dir).split(sep);\n72:   for (let index = parts.length - 1; index >= 1; index -= 1) {\n73:     if (!SOURCE_ROOT_NAMES.includes(parts[index])) continue;\n74:     const parent = parts.slice(0, index).join(sep) || sep;\n75:     if (holdsSentinel(parent)) return parent;\n76:   }\n77:   return null;\n78: }\n79: \n80: // Inlined twin of lib/utils/workspace-root.ts:hoistAboveOpencodeTree. Kept local\n81: // to avoid a circular import between schemas/ and lib/ — the two must stay in\n82: // lockstep so the schema allowlist and the handler agree on the workspace root.\n83: // A `.skilled` or `.opencode` directory is by definition a child of the workspace\n84: // root, so hoisting above the OUTERMOST one yields the real root and can never\n85: // return a path inside a source tree (the earlier specs-only shape missed sibling\n86: // subtrees like skills/).\n87: function hoistAboveOpencodeTree(dir: string): string | null {\n88:   const parts = resolve(dir).split(sep);\n89:   for (let index = 1; index < parts.length; index += 1) {\n90:     if (SOURCE_ROOT_NAMES.includes(parts[index])) {\n91:       return parts.slice(0, index).join(sep) || sep;\n92:     }\n93:   }\n94:   return null;\n95: }\n96: \n97: function canonicalize(input: string): string {\n98:   const resolved = resolve(input);\n99:   try {\n100:     return realpathSync.native(resolved);\n101:   } catch {\n102:     // Path may not exist yet (test fixtures created lazily,\n103:     // tmpdir mkdtemp paths probed before mkdir). Walk up and realpath the\n104:     // first existing ancestor, then re-join the unresolved tail. This\n105:     // resolves macOS-style symlinks like /tmp → /private/tmp even when\n106:     // the leaf doesn't exist.\n107:     let probe = resolved;\n108:     let tail = '';\n109:     for (let depth = 0; depth < 32; depth += 1) {\n110:       const parent = resolve(probe, '..');\n111:       if (parent === probe) break;\n112:       try {\n113:         const realParent = realpathSync.native(parent);\n114:         return tail\n115:           ? resolve(realParent, probe.slice(parent.length + 1) + tail)\n116:           : resolve(realParent, probe.slice(parent.length + 1));\n117:       } catch {\n118:         // Parent doesn't exist either — keep walking up.\n119:         const segment = probe.slice(parent.length + 1);\n120:         tail = tail ? `${segment}/${tail}` : segment;\n121:         probe = parent;\n122:       }\n123:     }\n124:     return resolved;\n125:   }\n126: }\n127: \n128: const SOURCE_REPO_ROOT = canonicalize(detectRepoRoot());\n129: \n130: const ALLOWED_WORKSPACE_PREFIXES: readonly string[] = (() => {\n131:   const prefixes: string[] = [];\n132:   prefixes.push(SOURCE_REPO_ROOT);\n133:   prefixes.push(canonicalize(tmpdir()));\n134:   // Include the canonicalized /tmp prefix as well. On macOS\n135:   // os.tmpdir() returns the per-user temp dir under /var/folders/...; the\n136:   // /tmp symlink resolves to /private/tmp. Test fixtures and tools that\n137:   // hardcode /tmp/foo paths need both forms in the allowlist.\n138:   prefixes.push(canonicalize('/tmp'));\n139:   // Accept additional explicit allowlist via env (CI / test runners).\n140:   const envExtras = process.env.SPECKIT_ADVISOR_WORKSPACE_ALLOWLIST;\n141:   if (envExtras) {\n142:     for (const extra of envExtras.split(':')) {\n143:       const trimmed = extra.trim();\n144:       if (trimmed) prefixes.push(canonicalize(trimmed));\n145:     }\n146:   }\n147:   return Array.from(new Set(prefixes));\n148: })();\n149: \n150: /**\n151:  * Validate that a caller-supplied workspaceRoot resolves under\n152:  * the repo root, os.tmpdir(), or an explicit allowlist entry after\n153:  * realpath canonicalization.\n154:  *\n155:  * Exported so handlers can re-canonicalize at call time and reuse the\n156:  * same bounding logic the schema applies at parse time.\n157:  */\n158: export function isAllowedWorkspaceRoot(input: string): boolean {\n159:   if (!input || typeof input !== 'string') return false;\n160:   const canonical = canonicalize(input);\n161:   return ALLOWED_WORKSPACE_PREFIXES.some(\n162:     (prefix) => canonical === prefix || canonical.startsWith(`${prefix}/`),\n163:   ) || isWiredToSourceTree(canonical);\n164: }\n165: \n166: function realpathOrNull(path: string): string | null {\n167:   try {\n168:     return realpathSync.native(path);\n169:   } catch {\n170:     return null;\n171:   }\n172: }\n173: \n174: /**\n175:  * True when the input, or a directory above it, holds a source-root entry\n176:  * (`.skilled` or `.opencode`) whose realpath is the source tree's own entry.\n177:  *\n178:  * A project linked to a shared checkout holds `.skilled -> <source>/.skilled`\n179:  * while the daemon runs from the source tree, so the prefix allowlist alone\n180:  * refuses every linked project. Matching realpaths admits only a workspace that\n181:  * is actually wired to this source; a copied tree or a link to another source\n182:  * resolves elsewhere and stays refused.\n183:  */\n184: export function isWiredToSourceTree(input: string, sourceRoot: string = SOURCE_REPO_ROOT): boolean {\n185:   if (!input || typeof input !== 'string') return false;\n186:   const sourceEntries = SOURCE_ROOT_NAMES\n187:     .map((name) => realpathOrNull(resolve(sourceRoot, name)))\n188:     .filter((entry): entry is string => entry !== null);\n189:   if (sourceEntries.length === 0) return false;\n190:   let current = canonicalize(input);\n191:   for (let depth = 0; depth < 64; depth += 1) {\n192:     for (const name of SOURCE_ROOT_NAMES) {\n193:       const entry = realpathOrNull(resolve(current, name));\n194:       if (entry !== null && sourceEntries.includes(entry)) return true;\n195:     }\n196:     const parent = resolve(current, '..');\n197:     if (parent === current) break;\n198:     current = parent;\n199:   }\n200:   return false;\n201: }\n202: \n203: // ───────────────────────────────────────────────────────────────────\n204: // 4. SCHEMA DEFINITIONS\n205: // ───────────────────────────────────────────────────────────────────\n206: \n207: const BoundedWorkspaceRootSchema = z\n208:   .string()\n209:   .min(1)\n210:   .refine(isAllowedWorkspaceRoot, {\n211:     message:\n212:       'workspaceRoot must resolve under the repo root, os.tmpdir(), an explicit SPECKIT_ADVISOR_WORKSPACE_ALLOWLIST entry, or a project whose .skilled links to this source tree',\n213:   });\n214: \n215: const laneBreakdownSchema = z.object({\n216:   lane: AdvisorLaneSchema,\n217:   rawScore: z.number().min(0),\n218:   weightedScore: z.number().min(0),\n219:   weight: z.number().min(0),\n220:   shadowOnly: z.boolean(),\n221: }).strict();\n222: \n223: const whyRecommendedLaneSchema = laneBreakdownSchema.extend({\n224:   evidenceTypes: z.array(z.string().min(1)),\n225:   evidenceCount: z.number().int().nonnegative(),\n226: }).strict();\n227: \n228: const whyRecommendedSchema = z.object({\n229:   reason: z.string().min(1),\n230:   dominantLane: AdvisorLaneSchema.nullable(),\n231:   topLanes: z.array(whyRecommendedLaneSchema),\n232:   matchedSkillFeatures: z.array(z.object({\n233:     lane: AdvisorLaneSchema,\n234:     feature: z.string().min(1),\n235:   }).strict()),\n236: }).strict();\n237: \n238: const runtimeLaneHealthSchema = z.object({\n239:   liveLaneCount: z.number().int().nonnegative(),\n240:   degradedLanes: z.array(AdvisorLaneSchema),\n241: }).strict();\n242: \n243: const semanticLaneHealthSchema = z.object({\n244:   activeEmbedder: z.object({\n245:     name: z.string().min(1),\n246:     dim: z.number().int().nonnegative(),\n247:     adapterDim: z.number().int().positive().nullable(),\n248:   }).strict().nullable(),\n249:   vectorCoverage: z.object({\n250:     embedded: z.number().int().nonnegative(),\n251:     total: z.number().int().nonnegative(),\n252:     ratio: z.number().min(0).max(1),\n253:   }).strict(),\n254:   dimMismatch: z.boolean(),\n255:   lastRefresh: z.string().nullable(),\n256:   disabledReason: z.string().nullable(),\n257:   laneEnabled: z.boolean(),\n258:   backend: z.object({\n259:     state: z.enum(['reachable', 'unreachable', 'model_missing', 'probe_not_implemented']),\n260:     reason: z.string().nullable(),\n261:   }).strict().optional(),\n262:   commandVectorCoverage: z.object({\n263:     embedded: z.number().int().nonnegative(),\n264:     total: z.number().int().nonnegative(),\n265:   }).strict().optional(),\n266:   checkedAt: z.string().datetime(),\n267: }).strict();\n268: \n269: // NOTE (DEFER decision):\n270: // `AdvisorScoringOptions.affordances` (see `lib/scorer/types.ts:94`) is a\n271: // COMPILE-TIME-ONLY internal seam used by the scorer fusion path. Affordance\n272: // evidence is sourced from compiled skill graph metadata via\n273: // `skill_graph_compiler.py` (which emits sanitized `derived.affordances[]`\n274: // nodes), not from public command input. Exposing `affordances` through this\n275: // request schema would re-introduce the prompt-stuffing surface that\n276: // `affordance-normalizer.ts` specifically defends against (URLs, emails,\n277: // instruction-shaped strings, free-form `description` fields). The public\n278: // `advisor_recommend` tool intentionally does NOT accept `affordances`.\n279: // Internal callers that need request-local affordance scoring should invoke\n280: // `scoreAdvisorPrompt` directly with `AdvisorScoringOptions.affordances`.\n281: // advisor_recommend routes on at most this many prompt characters. A caller holding a\n282: // longer prompt sends its head, so a long prompt is routed rather than refused.\n283: export const ADVISOR_PROMPT_MAX_CHARS = 10_000;\n284: \n285: export const AdvisorRecommendInputSchema = z.object({\n286:   // workspaceRoot must resolve under the allowed prefix set.\n287:   workspaceRoot: BoundedWorkspaceRootSchema.optional(),\n288:   prompt: z.string().min(1).max(ADVISOR_PROMPT_MAX_CHARS),\n289:   options: z.object({\n290:     topK: z.number().int().min(1).max(10).optional(),\n291:     includeAttribution: z.boolean().optional(),\n292:     includeAbstainReasons: z.boolean().optional(),\n293:     confidenceThreshold: z.number().min(0).max(1).optional(),\n294:     uncertaintyThreshold: z.number().min(0).max(1).optional(),\n295:     includeCompiledRoute: z.boolean().optional(),\n296:     // Limits the per-hub route lookup to the first recommendation, for a caller\n297:     // on a tight time budget that acts on the top pick alone.\n298:     compiledRouteTopOnly: z.boolean().optional(),\n299:     // Forwarded to the compiled-route front door as --surface-hint; a value\n300:     // that names no known surface is ignored there.\n301:     surfaceHint: z.string().min(1).max(64).optional(),\n302:   }).strict().optional(),\n303: }).strict();\n304: \n305: export const AdvisorRecommendationSchema = z.object({\n306:   skillId: z.string().min(1),\n307:   score: z.number().min(0),\n308:   confidence: z.number().min(0).max(1),\n309:   uncertainty: z.number().min(0).max(1),\n310:   dominantLane: AdvisorLaneSchema.nullable(),\n311:   laneBreakdown: z.array(laneBreakdownSchema).optional(),\n312:   why_recommended: whyRecommendedSchema.optional(),\n313:   matchedDocs: z.array(z.string().min(1)).max(3).optional(),\n314:   redirectFrom: z.array(z.string().min(1)).optional(),\n315:   redirectTo: z.string().min(1).optional(),\n316:   heldBelow: z.string().min(1).optional(),\n317:   status: z.enum(['active', 'deprecated', 'archived', 'future']).optional(),\n318:   workflowMode: z.string().min(1).optional(),\n319:   compiledRoute: z.record(z.string(), z.unknown()).optional(),\n320:   // Names the slash command that runs the recommended skill's resolved mode.\n321:   command: z.string().min(1).optional(),\n322:   // A command-bearing recommendation also says which face it is (a skill or a\n323:   // command row), how a caller may run it, and which skill owns it. Each stays\n324:   // optional so output from a runtime that predates the fields still parses.\n325:   kind: z.enum(['skill', 'command']).optional(),\n326:   policy: z.enum(['run', 'start', 'ask']).optional(),\n327:   ownerSkillId: z.string().min(1).optional(),\n328: }).strict();\n329: \n330: export const AdvisorRecommendOutputSchema = z.object({\n331:   workspaceRoot: z.string().min(1),\n332:   effectiveThresholds: z.object({\n333:     confidenceThreshold: z.number().min(0).max(1),\n334:     uncertaintyThreshold: z.number().min(0).max(1),\n335:     confidenceOnly: z.boolean(),\n336:   }).strict(),\n337:   recommendations: z.array(AdvisorRecommendationSchema),\n338:   ambiguous: z.boolean().optional(),\n339:   freshness: AdvisorFreshnessSchema,\n340:   trustState: z.object({\n341:     state: AdvisorFreshnessSchema,\n342:     reason: z.string().nullable(),\n343:     generation: z.number().int().nonnegative(),\n344:     checkedAt: z.string().datetime(),\n345:     lastLiveAt: z.string().datetime().nullable(),\n346:   }).strict(),\n347:   generatedAt: z.string().datetime(),\n348:   cache: z.object({\n349:     hit: z.boolean(),\n350:     sourceSignaturePresent: z.boolean(),\n351:   }).strict(),\n352:   warnings: z.array(z.string()).optional(),\n353:   abstainReasons: z.array(z.string()).optional(),\n354:   runtimeLaneHealth: runtimeLaneHealthSchema.optional(),\n355:   _shadow: z.object({\n356:     model: z.literal('advisor-shadow-learned-weights-v1'),\n357:     liveWeightsFrozen: z.boolean(),\n358:     recommendations: z.array(z.object({\n359:       skillId: z.string().min(1),\n360:       liveScore: z.number().min(0),\n361:       shadowScore: z.number().min(0),\n362:       delta: z.number(),\n363:       dominantShadowLane: AdvisorLaneSchema.nullable(),\n364:     }).strict()),\n365:   }).strict().optional(),\n366: }).strict();\n367: \n368: export const AdvisorStatusInputSchema = z.object({\n369:   // Bound workspaceRoot to allowed prefix set.\n370:   workspaceRoot: BoundedWorkspaceRootSchema,\n371:   maxMetadataFiles: z.number().int().positive().max(10_000).optional(),\n372:   includeSemanticHealth: z.boolean().optional(),\n373:   includeEmbeddingsHealth: z.boolean().optional(),\n374:   // Run a read-only SQLite quick_check on the artifact so genuine corruption\n375:   // downgrades freshness to stale (and advisor_rebuild repairs it). Off by\n376:   // default so the read-style advisor_recommend path pays no per-call probe;\n377:   // the advisor_status diagnostic and advisor_rebuild pre-read opt in.\n378:   checkArtifactIntegrity: z.boolean().optional(),\n379:   debug: z.boolean().optional(),\n380: }).strict();\n381: \n382: const embeddingsHealthSchema = z.object({\n383:   checkedAt: z.string().datetime(),\n384:   provider: z.discriminatedUnion('state', [\n385:     z.object({\n386:       state: z.literal('resolved'),\n387:       requestedProvider: z.string(),\n388:       effectiveProvider: z.string(),\n389:       fallbackReason: z.string().nullable(),\n390:       dimensionChanged: z.boolean(),\n391:       reason: z.string(),\n392:     }).strict(),\n393:     z.object({\n394:       state: z.literal('unavailable'),\n395:       error: z.string().max(200),\n396:     }).strict(),\n397:   ]),\n398:   modelServer: z.discriminatedUnion('state', [\n399:     z.object({\n400:       state: z.literal('reachable'),\n401:       target: z.string().min(1),\n402:       serverState: z.string().nullable(),\n403:       model: z.string().nullable(),\n404:       dim: z.number().nullable(),\n405:       device: z.string().nullable(),\n406:       loadTimeMs: z.number().nullable(),\n407:       loadStartedAt: z.string().nullable(),\n408:       loadProgressAt: z.string().nullable(),\n409:       lastSuccessfulEmbedAt: z.string().nullable(),\n410:       inFlight: z.number().nullable(),\n411:       queueDepth: z.number().nullable(),\n412:       error: z.string().nullable(),\n413:     }).strict(),\n414:     z.object({\n415:       state: z.literal('unavailable'),\n416:       target: z.string().min(1),\n417:       errorClass: z.enum(['unreachable', 'timeout', 'bad_response', 'probe_failed']),\n418:       error: z.string(),\n419:     }).strict(),\n420:   ]),\n421: }).strict();\n422: \n423: export const AdvisorStatusOutputSchema = z.object({\n424:   freshness: AdvisorFreshnessSchema,\n425:   generation: z.number().int().nonnegative(),\n426:   trustState: z.object({\n427:     state: AdvisorFreshnessSchema,\n428:     reason: z.string().nullable(),\n429:     generation: z.number().int().nonnegative(),\n430:     checkedAt: z.string().datetime(),\n431:     lastLiveAt: z.string().datetime().nullable(),\n432:   }).strict(),\n433:   lastGenerationBump: z.string().datetime().nullable(),\n434:   lastScanAt: z.string().datetime().nullable(),\n435:   skillCount: z.number().int().nonnegative(),\n436:   indexStaleness: z.object({\n437:     state: z.enum(['fresh', 'stale', 'unavailable']),\n438:     reason: z.string().nullable(),\n439:     trackedSkills: z.number().int().nonnegative(),\n440:     freshSourceFiles: z.number().int().nonnegative(),\n441:     changedSourceFiles: z.number().int().nonnegative(),\n442:     missingSourceFiles: z.number().int().nonnegative(),\n443:     staleSkillIds: z.array(z.string()),\n444:   }).strict().optional(),\n445:   laneWeights: z.record(AdvisorLaneSchema, z.number().min(0)),\n446:   semanticLaneHealth: semanticLaneHealthSchema.optional(),\n447:   embeddingsHealth: embeddingsHealthSchema.optional(),\n448:   hookHealth: z.object({\n449:     invocations: z.number().int().positive(),\n450:     rollingP95Ms: z.number().nonnegative(),\n451:     rollingFailOpenRate: z.number().min(0).max(1),\n452:     rollingCacheHitRate: z.number().min(0).max(1),\n453:   }).strict().optional(),\n454:   daemonPid: z.number().int().positive().optional(),\n455:   errors: z.array(z.string()).optional(),\n456: }).strict();\n457: \n458: export const AdvisorRebuildInputSchema = z.object({\n459:   force: z.boolean().optional(),\n460:   // Bound workspaceRoot to allowed prefix set.\n461:   workspaceRoot: BoundedWorkspaceRootSchema.optional(),\n462: }).strict();\n463: \n464: export const AdvisorRebuildOutputSchema = z.object({\n465:   rebuilt: z.boolean(),\n466:   skipped: z.boolean(),\n467:   reason: z.enum(['status-live', 'stale', 'absent', 'unavailable', 'force']),\n468:   freshnessBefore: AdvisorFreshnessSchema,\n469:   freshnessAfter: AdvisorFreshnessSchema,\n470:   generationBefore: z.number().int().nonnegative(),\n471:   generationAfter: z.number().int().nonnegative(),\n472:   skillCount: z.number().int().nonnegative(),\n473:   summary: z.record(z.string(), z.unknown()).nullable(),\n474:   diagnostics: z.array(z.string()),\n475: }).strict();\n476: \n477: export const AdvisorValidateInputSchema = z.object({\n478:   confirmHeavyRun: z.literal(true),\n479:   // Bound workspaceRoot to allowed prefix set.\n480:   workspaceRoot: BoundedWorkspaceRootSchema.optional(),\n481:   skillSlug: z.string().min(1).nullable().optional(),\n482:   // Outcome events carry only skill ids + the accept/correct/ignore signal —\n483:   // never the prompt, scenario, or expected skill. This omission is deliberate\n484:   // prompt-safety: telemetry must not store routable prompt content. The\n485:   // consequence is that real misroutes cannot be harvested from telemetry into\n486:   // gold regression cases; gold cases are authored by hand, not reconstructed.\n487:   // Capturing prompts to close that gap would violate the prompt-safety\n488:   // invariant and is intentionally not supported.\n489:   outcomeEvents: z.array(z.object({\n490:     runtime: z.enum(ADVISOR_RUNTIME_VALUES),\n491:     outcome: z.enum(['accepted', 'corrected', 'ignored']),\n492:     skillId: z.string().min(1),\n493:     correctedSkillId: z.string().min(1).optional(),\n494:     timestamp: z.string().datetime().optional(),\n495:   }).strict()).optional(),\n496: }).strict();\n497: \n498: const validationSliceSchema = z.object({\n499:   percentage: z.number().min(0).max(1),\n500:   passed: z.boolean(),\n501:   threshold: z.number().min(0).max(1).optional(),\n502:   count: z.object({\n503:     passed: z.number().int().nonnegative(),\n504:     total: z.number().int().nonnegative(),\n505:   }).strict(),\n506: }).strict();\n507: \n508: // A named data-slice accuracy gate. Extends the generic validation slice with\n509: // `minN` (the minimum row count below which the slice is statistically\n510: // meaningless and fails, guarding against a corpus edit silently shrinking a\n511: // bucket) and `top1` (the strict top-1 accuracy for the slice, surfaced\n512: // explicitly so operators read the bucket's accuracy without recomputing it\n513: // from `count`).\n514: const bucketSliceSchema = validationSliceSchema.extend({\n515:   minN: z.number().int().positive(),\n516:   top1: z.number().min(0).max(1),\n517: }).strict();\n518: \n519: const advisorValidateAggregateValidationSchema = z.object({\n520:   fullCorpusTop1: z.number().min(0).max(1),\n521:   holdoutTop1: z.number().min(0).max(1),\n522:   perSkillTop1: z.number().min(0).max(1),\n523:   unknownCountTargetMax: z.number().int().nonnegative(),\n524: }).strict().describe('Release-gate thresholds for full corpus, holdout, per-skill accuracy, and UNKNOWN counts.');\n525: \n526: const advisorValidateRuntimeRoutingSchema = z.object({\n527:   confidenceThreshold: z.number().min(0).max(1),\n528:   uncertaintyThreshold: z.number().min(0).max(1),\n529:   confidenceOnly: z.boolean(),\n530: }).strict().describe('Live runtime routing thresholds surfaced by advisor_validate so manual checks can compare runtime semantics with release gates.');\n531: \n532: const advisorValidateTelemetryDiagnosticsSchema = z.object({\n533:   recordsPath: z.string().min(1),\n534:   recordsRetained: z.number().int().nonnegative(),\n535:   rollingCacheHitRate: z.number().min(0).max(1),\n536:   rollingP95Ms: z.number().min(0),\n537:   rollingFailOpenRate: z.number().min(0).max(1),\n538: }).strict().describe('Prompt-safe rolling diagnostics from retained advisor hook telemetry records.');\n539: \n540: const advisorValidateTelemetryScopeSchema = z.object({\n541:   kind: z.enum(['workspace', 'skill']),\n542:   skillSlug: z.string().min(1).nullable(),\n543: }).strict().describe('Whether recorded outcome totals are workspace-wide or scoped to the selected skillSlug.');\n544: \n545: const advisorValidateOutcomeTotalsSchema = z.object({\n546:   accepted: z.number().int().nonnegative(),\n547:   corrected: z.number().int().nonnegative(),\n548:   ignored: z.number().int().nonnegative(),\n549: }).strict().describe('Recorded outcome totals retained for the active workspace or skill scope.');\n550: \n551: const advisorValidateTelemetryOutcomesSchema = z.object({\n552:   recordsPath: z.string().min(1),\n553:   recordedThisRun: z.number().int().nonnegative(),\n554:   scope: advisorValidateTelemetryScopeSchema,\n555:   totals: advisorValidateOutcomeTotalsSchema,\n556: }).strict().describe('Outcome recording summary, including injected event count and retained accepted/corrected/ignored totals.');\n557: \n558: export const AdvisorValidateOutputSchema = z.object({\n559:   workspaceRoot: z.string().min(1),\n560:   skillSlug: z.string().nullable(),\n561:   thresholdSemantics: z.object({\n562:     aggregateValidation: advisorValidateAggregateValidationSchema,\n563:     runtimeRouting: advisorValidateRuntimeRoutingSchema,\n564:   }).strict().describe('Public threshold contract for advisor_validate, covering release-gate scoring and runtime-routing semantics.'),\n565:   overallAccuracy: z.number().min(0).max(1),\n566:   perSkill: z.array(z.object({\n567:     skillId: z.string().min(1),\n568:     status: z.enum(['pass', 'fail', 'skipped']),\n569:     matched: z.number().int().nonnegative(),\n570:     total: z.number().int().nonnegative(),\n571:   }).strict()),\n572:   slices: z.object({\n573:     corpus: z.object({\n574:       full_corpus_top1: validationSliceSchema,\n575:       unknown_count: z.object({\n576:         value: z.number().int().nonnegative(),\n577:         targetMax: z.number().int().nonnegative(),\n578:         passed: z.boolean(),\n579:       }).strict(),\n580:       gold_none_false_fire_count: z.object({\n581:         value: z.number().int().nonnegative(),\n582:         baselineDelta: z.number().int(),\n583:       }).strict(),\n584:     }).strict(),\n585:     holdout: z.object({\n586:       holdout_top1: validationSliceSchema,\n587:     }).strict(),\n588:     parity: z.object({\n589:       explicit_skill_top1_regression: z.object({\n590:         passed: z.boolean(),\n591:         regressions: z.array(z.string()),\n592:       }).strict(),\n593:       ambiguity_slice_stable: z.object({\n594:         passed: z.boolean(),\n595:         top2Within005: z.boolean(),\n596:       }).strict(),\n597:       derived_lane_attribution_complete: z.boolean(),\n598:     }).strict(),\n599:     safety: z.object({\n600:       adversarial_stuffing_blocked: z.object({\n601:         passed: z.boolean(),\n602:         fixtureCount: z.number().int().nonnegative(),\n603:       }).strict(),\n604:     }).strict(),\n605:     latency: z.object({\n606:       regression_suite_status: z.object({\n607:         p0PassRate: z.number().min(0).max(1),\n608:         failedCount: z.number().int().nonnegative(),\n609:         commandBridgeFalsePositiveRate: z.number().min(0).max(1),\n610:         cacheHitP95Ms: z.number().min(0),\n611:         uncachedP95Ms: z.number().min(0),\n612:       }).strict(),\n613:     }).strict(),\n614:     // Named per-intent accuracy buckets. review/memory_save are corpus rows\n615:     // grouped by their labeled bucket; delegation is the shared executor-routing\n616:     // fixture (the training corpus carries no honest executor-delegation signal).\n617:     // Each is a first-class accuracy gate so a regression confined to one intent\n618:     // class stays visible even when the aggregate corpus number holds.\n619:     buckets: z.object({\n620:       review: bucketSliceSchema,\n621:       memory_save: bucketSliceSchema,\n622:       delegation: bucketSliceSchema,\n623:     }).strict(),\n624:   }).strict(),\n625:   telemetry: z.object({\n626:     diagnostics: advisorValidateTelemetryDiagnosticsSchema,\n627:     outcomes: advisorValidateTelemetryOutcomesSchema,\n628:   }).strict().describe('Prompt-safe telemetry diagnostics and recorded outcome summaries exposed for operator validation.'),\n629:   generatedAt: z.string().datetime(),\n630: }).strict();\n631: \n632: // ───────────────────────────────────────────────────────────────────\n633: // 5. EXPORTS\n634: // ───────────────────────────────────────────────────────────────────\n635: \n636: export type AdvisorFreshness = z.infer<typeof AdvisorFreshnessSchema>;\n637: export type AdvisorRecommendInput = z.infer<typeof AdvisorRecommendInputSchema>;\n638: export type AdvisorRecommendOutput = z.infer<typeof AdvisorRecommendOutputSchema>;\n639: export type AdvisorRebuildInput = z.infer<typeof AdvisorRebuildInputSchema>;\n640: export type AdvisorRebuildOutput = z.infer<typeof AdvisorRebuildOutputSchema>;\n641: export type AdvisorStatusInput = z.infer<typeof AdvisorStatusInputSchema>;\n642: export type AdvisorStatusOutput = z.infer<typeof AdvisorStatusOutputSchema>;\n643: export type AdvisorValidateInput = z.infer<typeof AdvisorValidateInputSchema>;\n644: export type AdvisorValidateOutput = z.infer<typeof AdvisorValidateOutputSchema>;\n645: \n646: export const AdvisorToolInputSchemas = {\n647:   advisor_recommend: AdvisorRecommendInputSchema,\n648:   advisor_rebuild: AdvisorRebuildInputSchema,\n649:   advisor_status: AdvisorStatusInputSchema,\n650:   advisor_validate: AdvisorValidateInputSchema,\n651: } as const;","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/schemas/advisor-tool-schemas.ts, lines 1-651\n1: // ───────────────────────────────────────────────────────────────\n2: // MODULE: Advisor Tool Schemas\n3: // ───────────────────────────────────────────────────────────────\n4: \n5: // ───────────────────────────────────────────────────────────────────\n6: // 1. IMPORTS\n7: // ───────────────────────────────────────────────────────────────────\n8: \n9: import { z } from 'zod';\n10: import { existsSync, realpathSync } from 'node:fs';\n11: import { resolve, sep } from 'node:path';\n12: import { tmpdir } from 'node:os';\n13: import { ADVISOR_RUNTIME_VALUES } from '../lib/advisor-runtime-values.js';\n14: import { SCORER_LANE_IDS } from '../lib/scorer/lane-registry.js';\n15: \n16: // ───────────────────────────────────────────────────────────────────\n17: // 2. CONSTANTS\n18: // ───────────────────────────────────────────────────────────────────\n19: \n20: export const AdvisorFreshnessSchema = z.enum(['live', 'stale', 'absent', 'unavailable']);\n21: export const AdvisorLaneSchema = z.enum(SCORER_LANE_IDS);\n22: \n23: // ───────────────────────────────────────────────────────────────────\n24: // 3. HELPERS\n25: // ───────────────────────────────────────────────────────────────────\n26: \n27: // Bound caller-supplied workspaceRoot inputs to a small\n28: // allowlist (repo root + os.tmpdir()) so handlers cannot be coerced into\n29: // resolving paths outside the workspace. resolve() canonicalizes the input\n30: // path; realpathSync follows symlinks; the prefix check rejects anything\n31: // that escapes the allowlist after canonicalization.\n32: //\n33: // Directory names the source tree may sit under. A checkout may link one to the\n34: // other, so both mark the same tree.\n35: const SOURCE_ROOT_NAMES: readonly string[] = ['.skilled', '.opencode'];\n36: \n37: // Repo root is detected by walking up from process.cwd() looking for the\n38: // system-spec-kit SKILL.md sentinel — same shape as findAdvisorWorkspaceRoot but\n39: // inlined here to avoid a circular import between schemas/ and lib/. The start\n40: // directory is a parameter so the lockstep test can feed both resolvers one tree.\n41: export function detectRepoRoot(start: string = process.cwd()): string {\n42:   // Use the same SKILL.md file sentinel as findAdvisorWorkspaceRoot so the schema\n43:   // and the handler agree on which directory is the workspace root. A bare\n44:   // directory sentinel would match the nested mock trees other workflows create.\n45:   // The source tree sits under `.skilled` or `.opencode`, so the sentinel is\n46:   // tested under both.\n47:   const sentinels = SOURCE_ROOT_NAMES.map((name) => `${name}/skills/system-spec-kit/SKILL.md`);\n48:   let current = resolve(start);\n49:   for (let index = 0; index < 14; index += 1) {\n50:     if (sentinels.some((sentinel) => existsSync(resolve(current, sentinel)))) return current;\n51:     const parent = resolve(current, '..');\n52:     if (parent === current) break;\n53:     current = parent;\n54:   }\n55:   // Lockstep with findAdvisorWorkspaceRoot: when the walk misses the sentinel,\n56:   // never anchor the allowlist on a directory inside a source tree. Take the start\n57:   // or the nearest source-root parent that holds the sentinel, else hoist above the\n58:   // outermost source-root segment, so caller-supplied workspaceRoots are bounded\n59:   // to the real root, not a nested subdir.\n60:   return nearestSentinelHolder(start, sentinels) ?? hoistAboveOpencodeTree(start) ?? resolve(start);\n61: }\n62: \n63: // Inlined twin of lib/utils/workspace-root.ts:nearestSentinelHolder, kept local for\n64: // the same reason as the hoist below. A capped walk misses the sentinel, yet the root\n65: // is still the start or the parent of one source-root segment in the start path, so\n66: // testing the start and then those parents nearest first keeps a repository that\n67: // sits under a directory named .skilled or .opencode.\n68: function nearestSentinelHolder(dir: string, sentinels: readonly string[]): string | null {\n69:   const holdsSentinel = (candidate: string): boolean => sentinels.some((sentinel) => existsSync(resolve(candidate, sentinel)));\n70:   if (holdsSentinel(dir)) return resolve(dir);\n71:   const parts = resolve(dir).split(sep);\n72:   for (let index = parts.length - 1; index >= 1; index -= 1) {\n73:     if (!SOURCE_ROOT_NAMES.includes(parts[index])) continue;\n74:     const parent = parts.slice(0, index).join(sep) || sep;\n75:     if (holdsSentinel(parent)) return parent;\n76:   }\n77:   return null;\n78: }\n79: \n80: // Inlined twin of lib/utils/workspace-root.ts:hoistAboveOpencodeTree. Kept local\n81: // to avoid a circular import between schemas/ and lib/ — the two must stay in\n82: // lockstep so the schema allowlist and the handler agree on the workspace root.\n83: // A `.skilled` or `.opencode` directory is by definition a child of the workspace\n84: // root, so hoisting above the OUTERMOST one yields the real root and can never\n85: // return a path inside a source tree (the earlier specs-only shape missed sibling\n86: // subtrees like skills/).\n87: function hoistAboveOpencodeTree(dir: string): string | null {\n88:   const parts = resolve(dir).split(sep);\n89:   for (let index = 1; index < parts.length; index += 1) {\n90:     if (SOURCE_ROOT_NAMES.includes(parts[index])) {\n91:       return parts.slice(0, index).join(sep) || sep;\n92:     }\n93:   }\n94:   return null;\n95: }\n96: \n97: function canonicalize(input: string): string {\n98:   const resolved = resolve(input);\n99:   try {\n100:     return realpathSync.native(resolved);\n101:   } catch {\n102:     // Path may not exist yet (test fixtures created lazily,\n103:     // tmpdir mkdtemp paths probed before mkdir). Walk up and realpath the\n104:     // first existing ancestor, then re-join the unresolved tail. This\n105:     // resolves macOS-style symlinks like /tmp → /private/tmp even when\n106:     // the leaf doesn't exist.\n107:     let probe = resolved;\n108:     let tail = '';\n109:     for (let depth = 0; depth < 32; depth += 1) {\n110:       const parent = resolve(probe, '..');\n111:       if (parent === probe) break;\n112:       try {\n113:         const realParent = realpathSync.native(parent);\n114:         return tail\n115:           ? resolve(realParent, probe.slice(parent.length + 1) + tail)\n116:           : resolve(realParent, probe.slice(parent.length + 1));\n117:       } catch {\n118:         // Parent doesn't exist either — keep walking up.\n119:         const segment = probe.slice(parent.length + 1);\n120:         tail = tail ? `${segment}/${tail}` : segment;\n121:         probe = parent;\n122:       }\n123:     }\n124:     return resolved;\n125:   }\n126: }\n127: \n128: const SOURCE_REPO_ROOT = canonicalize(detectRepoRoot());\n129: \n130: const ALLOWED_WORKSPACE_PREFIXES: readonly string[] = (() => {\n131:   const prefixes: string[] = [];\n132:   prefixes.push(SOURCE_REPO_ROOT);\n133:   prefixes.push(canonicalize(tmpdir()));\n134:   // Include the canonicalized /tmp prefix as well. On macOS\n135:   // os.tmpdir() returns the per-user temp dir under /var/folders/...; the\n136:   // /tmp symlink resolves to /private/tmp. Test fixtures and tools that\n137:   // hardcode /tmp/foo paths need both forms in the allowlist.\n138:   prefixes.push(canonicalize('/tmp'));\n139:   // Accept additional explicit allowlist via env (CI / test runners).\n140:   const envExtras = process.env.SPECKIT_ADVISOR_WORKSPACE_ALLOWLIST;\n141:   if (envExtras) {\n142:     for (const extra of envExtras.split(':')) {\n143:       const trimmed = extra.trim();\n144:       if (trimmed) prefixes.push(canonicalize(trimmed));\n145:     }\n146:   }\n147:   return Array.from(new Set(prefixes));\n148: })();\n149: \n150: /**\n151:  * Validate that a caller-supplied workspaceRoot resolves under\n152:  * the repo root, os.tmpdir(), or an explicit allowlist entry after\n153:  * realpath canonicalization.\n154:  *\n155:  * Exported so handlers can re-canonicalize at call time and reuse the\n156:  * same bounding logic the schema applies at parse time.\n157:  */\n158: export function isAllowedWorkspaceRoot(input: string): boolean {\n159:   if (!input || typeof input !== 'string') return false;\n160:   const canonical = canonicalize(input);\n161:   return ALLOWED_WORKSPACE_PREFIXES.some(\n162:     (prefix) => canonical === prefix || canonical.startsWith(`${prefix}/`),\n163:   ) || isWiredToSourceTree(canonical);\n164: }\n165: \n166: function realpathOrNull(path: string): string | null {\n167:   try {\n168:     return realpathSync.native(path);\n169:   } catch {\n170:     return null;\n171:   }\n172: }\n173: \n174: /**\n175:  * True when the input, or a directory above it, holds a source-root entry\n176:  * (`.skilled` or `.opencode`) whose realpath is the source tree's own entry.\n177:  *\n178:  * A project linked to a shared checkout holds `.skilled -> <source>/.skilled`\n179:  * while the daemon runs from the source tree, so the prefix allowlist alone\n180:  * refuses every linked project. Matching realpaths admits only a workspace that\n181:  * is actually wired to this source; a copied tree or a link to another source\n182:  * resolves elsewhere and stays refused.\n183:  */\n184: export function isWiredToSourceTree(input: string, sourceRoot: string = SOURCE_REPO_ROOT): boolean {\n185:   if (!input || typeof input !== 'string') return false;\n186:   const sourceEntries = SOURCE_ROOT_NAMES\n187:     .map((name) => realpathOrNull(resolve(sourceRoot, name)))\n188:     .filter((entry): entry is string => entry !== null);\n189:   if (sourceEntries.length === 0) return false;\n190:   let current = canonicalize(input);\n191:   for (let depth = 0; depth < 64; depth += 1) {\n192:     for (const name of SOURCE_ROOT_NAMES) {\n193:       const entry = realpathOrNull(resolve(current, name));\n194:       if (entry !== null && sourceEntries.includes(entry)) return true;\n195:     }\n196:     const parent = resolve(current, '..');\n197:     if (parent === current) break;\n198:     current = parent;\n199:   }\n200:   return false;\n201: }\n202: \n203: // ───────────────────────────────────────────────────────────────────\n204: // 4. SCHEMA DEFINITIONS\n205: // ───────────────────────────────────────────────────────────────────\n206: \n207: const BoundedWorkspaceRootSchema = z\n208:   .string()\n209:   .min(1)\n210:   .refine(isAllowedWorkspaceRoot, {\n211:     message:\n212:       'workspaceRoot must resolve under the repo root, os.tmpdir(), an explicit SPECKIT_ADVISOR_WORKSPACE_ALLOWLIST entry, or a project whose .skilled links to this source tree',\n213:   });\n214: \n215: const laneBreakdownSchema = z.object({\n216:   lane: AdvisorLaneSchema,\n217:   rawScore: z.number().min(0),\n218:   weightedScore: z.number().min(0),\n219:   weight: z.number().min(0),\n220:   shadowOnly: z.boolean(),\n221: }).strict();\n222: \n223: const whyRecommendedLaneSchema = laneBreakdownSchema.extend({\n224:   evidenceTypes: z.array(z.string().min(1)),\n225:   evidenceCount: z.number().int().nonnegative(),\n226: }).strict();\n227: \n228: const whyRecommendedSchema = z.object({\n229:   reason: z.string().min(1),\n230:   dominantLane: AdvisorLaneSchema.nullable(),\n231:   topLanes: z.array(whyRecommendedLaneSchema),\n232:   matchedSkillFeatures: z.array(z.object({\n233:     lane: AdvisorLaneSchema,\n234:     feature: z.string().min(1),\n235:   }).strict()),\n236: }).strict();\n237: \n238: const runtimeLaneHealthSchema = z.object({\n239:   liveLaneCount: z.number().int().nonnegative(),\n240:   degradedLanes: z.array(AdvisorLaneSchema),\n241: }).strict();\n242: \n243: const semanticLaneHealthSchema = z.object({\n244:   activeEmbedder: z.object({\n245:     name: z.string().min(1),\n246:     dim: z.number().int().nonnegative(),\n247:     adapterDim: z.number().int().positive().nullable(),\n248:   }).strict().nullable(),\n249:   vectorCoverage: z.object({\n250:     embedded: z.number().int().nonnegative(),\n251:     total: z.number().int().nonnegative(),\n252:     ratio: z.number().min(0).max(1),\n253:   }).strict(),\n254:   dimMismatch: z.boolean(),\n255:   lastRefresh: z.string().nullable(),\n256:   disabledReason: z.string().nullable(),\n257:   laneEnabled: z.boolean(),\n258:   backend: z.object({\n259:     state: z.enum(['reachable', 'unreachable', 'model_missing', 'probe_not_implemented']),\n260:     reason: z.string().nullable(),\n261:   }).strict().optional(),\n262:   commandVectorCoverage: z.object({\n263:     embedded: z.number().int().nonnegative(),\n264:     total: z.number().int().nonnegative(),\n265:   }).strict().optional(),\n266:   checkedAt: z.string().datetime(),\n267: }).strict();\n268: \n269: // NOTE (DEFER decision):\n270: // `AdvisorScoringOptions.affordances` (see `lib/scorer/types.ts:94`) is a\n271: // COMPILE-TIME-ONLY internal seam used by the scorer fusion path. Affordance\n272: // evidence is sourced from compiled skill graph metadata via\n273: // `skill_graph_compiler.py` (which emits sanitized `derived.affordances[]`\n274: // nodes), not from public command input. Exposing `affordances` through this\n275: // request schema would re-introduce the prompt-stuffing surface that\n276: // `affordance-normalizer.ts` specifically defends against (URLs, emails,\n277: // instruction-shaped strings, free-form `description` fields). The public\n278: // `advisor_recommend` tool intentionally does NOT accept `affordances`.\n279: // Internal callers that need request-local affordance scoring should invoke\n280: // `scoreAdvisorPrompt` directly with `AdvisorScoringOptions.affordances`.\n281: // advisor_recommend routes on at most this many prompt characters. A caller holding a\n282: // longer prompt sends its head, so a long prompt is routed rather than refused.\n283: export const ADVISOR_PROMPT_MAX_CHARS = 10_000;\n284: \n285: export const AdvisorRecommendInputSchema = z.object({\n286:   // workspaceRoot must resolve under the allowed prefix set.\n287:   workspaceRoot: BoundedWorkspaceRootSchema.optional(),\n288:   prompt: z.string().min(1).max(ADVISOR_PROMPT_MAX_CHARS),\n289:   options: z.object({\n290:     topK: z.number().int().min(1).max(10).optional(),\n291:     includeAttribution: z.boolean().optional(),\n292:     includeAbstainReasons: z.boolean().optional(),\n293:     confidenceThreshold: z.number().min(0).max(1).optional(),\n294:     uncertaintyThreshold: z.number().min(0).max(1).optional(),\n295:     includeCompiledRoute: z.boolean().optional(),\n296:     // Limits the per-hub route lookup to the first recommendation, for a caller\n297:     // on a tight time budget that acts on the top pick alone.\n298:     compiledRouteTopOnly: z.boolean().optional(),\n299:     // Forwarded to the compiled-route front door as --surface-hint; a value\n300:     // that names no known surface is ignored there.\n301:     surfaceHint: z.string().min(1).max(64).optional(),\n302:   }).strict().optional(),\n303: }).strict();\n304: \n305: export const AdvisorRecommendationSchema = z.object({\n306:   skillId: z.string().min(1),\n307:   score: z.number().min(0),\n308:   confidence: z.number().min(0).max(1),\n309:   uncertainty: z.number().min(0).max(1),\n310:   dominantLane: AdvisorLaneSchema.nullable(),\n311:   laneBreakdown: z.array(laneBreakdownSchema).optional(),\n312:   why_recommended: whyRecommendedSchema.optional(),\n313:   matchedDocs: z.array(z.string().min(1)).max(3).optional(),\n314:   redirectFrom: z.array(z.string().min(1)).optional(),\n315:   redirectTo: z.string().min(1).optional(),\n316:   heldBelow: z.string().min(1).optional(),\n317:   status: z.enum(['active', 'deprecated', 'archived', 'future']).optional(),\n318:   workflowMode: z.string().min(1).optional(),\n319:   compiledRoute: z.record(z.string(), z.unknown()).optional(),\n320:   // Names the slash command that runs the recommended skill's resolved mode.\n321:   command: z.string().min(1).optional(),\n322:   // A command-bearing recommendation also says which face it is (a skill or a\n323:   // command row), how a caller may run it, and which skill owns it. Each stays\n324:   // optional so output from a runtime that predates the fields still parses.\n325:   kind: z.enum(['skill', 'command']).optional(),\n326:   policy: z.enum(['run', 'start', 'ask']).optional(),\n327:   ownerSkillId: z.string().min(1).optional(),\n328: }).strict();\n329: \n330: export const AdvisorRecommendOutputSchema = z.object({\n331:   workspaceRoot: z.string().min(1),\n332:   effectiveThresholds: z.object({\n333:     confidenceThreshold: z.number().min(0).max(1),\n334:     uncertaintyThreshold: z.number().min(0).max(1),\n335:     confidenceOnly: z.boolean(),\n336:   }).strict(),\n337:   recommendations: z.array(AdvisorRecommendationSchema),\n338:   ambiguous: z.boolean().optional(),\n339:   freshness: AdvisorFreshnessSchema,\n340:   trustState: z.object({\n341:     state: AdvisorFreshnessSchema,\n342:     reason: z.string().nullable(),\n343:     generation: z.number().int().nonnegative(),\n344:     checkedAt: z.string().datetime(),\n345:     lastLiveAt: z.string().datetime().nullable(),\n346:   }).strict(),\n347:   generatedAt: z.string().datetime(),\n348:   cache: z.object({\n349:     hit: z.boolean(),\n350:     sourceSignaturePresent: z.boolean(),\n351:   }).strict(),\n352:   warnings: z.array(z.string()).optional(),\n353:   abstainReasons: z.array(z.string()).optional(),\n354:   runtimeLaneHealth: runtimeLaneHealthSchema.optional(),\n355:   _shadow: z.object({\n356:     model: z.literal('advisor-shadow-learned-weights-v1'),\n357:     liveWeightsFrozen: z.boolean(),\n358:     recommendations: z.array(z.object({\n359:       skillId: z.string().min(1),\n360:       liveScore: z.number().min(0),\n361:       shadowScore: z.number().min(0),\n362:       delta: z.number(),\n363:       dominantShadowLane: AdvisorLaneSchema.nullable(),\n364:     }).strict()),\n365:   }).strict().optional(),\n366: }).strict();\n367: \n368: export const AdvisorStatusInputSchema = z.object({\n369:   // Bound workspaceRoot to allowed prefix set.\n370:   workspaceRoot: BoundedWorkspaceRootSchema,\n371:   maxMetadataFiles: z.number().int().positive().max(10_000).optional(),\n372:   includeSemanticHealth: z.boolean().optional(),\n373:   includeEmbeddingsHealth: z.boolean().optional(),\n374:   // Run a read-only SQLite quick_check on the artifact so genuine corruption\n375:   // downgrades freshness to stale (and advisor_rebuild repairs it). Off by\n376:   // default so the read-style advisor_recommend path pays no per-call probe;\n377:   // the advisor_status diagnostic and advisor_rebuild pre-read opt in.\n378:   checkArtifactIntegrity: z.boolean().optional(),\n379:   debug: z.boolean().optional(),\n380: }).strict();\n381: \n382: const embeddingsHealthSchema = z.object({\n383:   checkedAt: z.string().datetime(),\n384:   provider: z.discriminatedUnion('state', [\n385:     z.object({\n386:       state: z.literal('resolved'),\n387:       requestedProvider: z.string(),\n388:       effectiveProvider: z.string(),\n389:       fallbackReason: z.string().nullable(),\n390:       dimensionChanged: z.boolean(),\n391:       reason: z.string(),\n392:     }).strict(),\n393:     z.object({\n394:       state: z.literal('unavailable'),\n395:       error: z.string().max(200),\n396:     }).strict(),\n397:   ]),\n398:   modelServer: z.discriminatedUnion('state', [\n399:     z.object({\n400:       state: z.literal('reachable'),\n401:       target: z.string().min(1),\n402:       serverState: z.string().nullable(),\n403:       model: z.string().nullable(),\n404:       dim: z.number().nullable(),\n405:       device: z.string().nullable(),\n406:       loadTimeMs: z.number().nullable(),\n407:       loadStartedAt: z.string().nullable(),\n408:       loadProgressAt: z.string().nullable(),\n409:       lastSuccessfulEmbedAt: z.string().nullable(),\n410:       inFlight: z.number().nullable(),\n411:       queueDepth: z.number().nullable(),\n412:       error: z.string().nullable(),\n413:     }).strict(),\n414:     z.object({\n415:       state: z.literal('unavailable'),\n416:       target: z.string().min(1),\n417:       errorClass: z.enum(['unreachable', 'timeout', 'bad_response', 'probe_failed']),\n418:       error: z.string(),\n419:     }).strict(),\n420:   ]),\n421: }).strict();\n422: \n423: export const AdvisorStatusOutputSchema = z.object({\n424:   freshness: AdvisorFreshnessSchema,\n425:   generation: z.number().int().nonnegative(),\n426:   trustState: z.object({\n427:     state: AdvisorFreshnessSchema,\n428:     reason: z.string().nullable(),\n429:     generation: z.number().int().nonnegative(),\n430:     checkedAt: z.string().datetime(),\n431:     lastLiveAt: z.string().datetime().nullable(),\n432:   }).strict(),\n433:   lastGenerationBump: z.string().datetime().nullable(),\n434:   lastScanAt: z.string().datetime().nullable(),\n435:   skillCount: z.number().int().nonnegative(),\n436:   indexStaleness: z.object({\n437:     state: z.enum(['fresh', 'stale', 'unavailable']),\n438:     reason: z.string().nullable(),\n439:     trackedSkills: z.number().int().nonnegative(),\n440:     freshSourceFiles: z.number().int().nonnegative(),\n441:     changedSourceFiles: z.number().int().nonnegative(),\n442:     missingSourceFiles: z.number().int().nonnegative(),\n443:     staleSkillIds: z.array(z.string()),\n444:   }).strict().optional(),\n445:   laneWeights: z.record(AdvisorLaneSchema, z.number().min(0)),\n446:   semanticLaneHealth: semanticLaneHealthSchema.optional(),\n447:   embeddingsHealth: embeddingsHealthSchema.optional(),\n448:   hookHealth: z.object({\n449:     invocations: z.number().int().positive(),\n450:     rollingP95Ms: z.number().nonnegative(),\n451:     rollingFailOpenRate: z.number().min(0).max(1),\n452:     rollingCacheHitRate: z.number().min(0).max(1),\n453:   }).strict().optional(),\n454:   daemonPid: z.number().int().positive().optional(),\n455:   errors: z.array(z.string()).optional(),\n456: }).strict();\n457: \n458: export const AdvisorRebuildInputSchema = z.object({\n459:   force: z.boolean().optional(),\n460:   // Bound workspaceRoot to allowed prefix set.\n461:   workspaceRoot: BoundedWorkspaceRootSchema.optional(),\n462: }).strict();\n463: \n464: export const AdvisorRebuildOutputSchema = z.object({\n465:   rebuilt: z.boolean(),\n466:   skipped: z.boolean(),\n467:   reason: z.enum(['status-live', 'stale', 'absent', 'unavailable', 'force']),\n468:   freshnessBefore: AdvisorFreshnessSchema,\n469:   freshnessAfter: AdvisorFreshnessSchema,\n470:   generationBefore: z.number().int().nonnegative(),\n471:   generationAfter: z.number().int().nonnegative(),\n472:   skillCount: z.number().int().nonnegative(),\n473:   summary: z.record(z.string(), z.unknown()).nullable(),\n474:   diagnostics: z.array(z.string()),\n475: }).strict();\n476: \n477: export const AdvisorValidateInputSchema = z.object({\n478:   confirmHeavyRun: z.literal(true),\n479:   // Bound workspaceRoot to allowed prefix set.\n480:   workspaceRoot: BoundedWorkspaceRootSchema.optional(),\n481:   skillSlug: z.string().min(1).nullable().optional(),\n482:   // Outcome events carry only skill ids + the accept/correct/ignore signal —\n483:   // never the prompt, scenario, or expected skill. This omission is deliberate\n484:   // prompt-safety: telemetry must not store routable prompt content. The\n485:   // consequence is that real misroutes cannot be harvested from telemetry into\n486:   // gold regression cases; gold cases are authored by hand, not reconstructed.\n487:   // Capturing prompts to close that gap would violate the prompt-safety\n488:   // invariant and is intentionally not supported.\n489:   outcomeEvents: z.array(z.object({\n490:     runtime: z.enum(ADVISOR_RUNTIME_VALUES),\n491:     outcome: z.enum(['accepted', 'corrected', 'ignored']),\n492:     skillId: z.string().min(1),\n493:     correctedSkillId: z.string().min(1).optional(),\n494:     timestamp: z.string().datetime().optional(),\n495:   }).strict()).optional(),\n496: }).strict();\n497: \n498: const validationSliceSchema = z.object({\n499:   percentage: z.number().min(0).max(1),\n500:   passed: z.boolean(),\n501:   threshold: z.number().min(0).max(1).optional(),\n502:   count: z.object({\n503:     passed: z.number().int().nonnegative(),\n504:     total: z.number().int().nonnegative(),\n505:   }).strict(),\n506: }).strict();\n507: \n508: // A named data-slice accuracy gate. Extends the generic validation slice with\n509: // `minN` (the minimum row count below which the slice is statistically\n510: // meaningless and fails, guarding against a corpus edit silently shrinking a\n511: // bucket) and `top1` (the strict top-1 accuracy for the slice, surfaced\n512: // explicitly so operators read the bucket's accuracy without recomputing it\n513: // from `count`).\n514: const bucketSliceSchema = validationSliceSchema.extend({\n515:   minN: z.number().int().positive(),\n516:   top1: z.number().min(0).max(1),\n517: }).strict();\n518: \n519: const advisorValidateAggregateValidationSchema = z.object({\n520:   fullCorpusTop1: z.number().min(0).max(1),\n521:   holdoutTop1: z.number().min(0).max(1),\n522:   perSkillTop1: z.number().min(0).max(1),\n523:   unknownCountTargetMax: z.number().int().nonnegative(),\n524: }).strict().describe('Release-gate thresholds for full corpus, holdout, per-skill accuracy, and UNKNOWN counts.');\n525: \n526: const advisorValidateRuntimeRoutingSchema = z.object({\n527:   confidenceThreshold: z.number().min(0).max(1),\n528:   uncertaintyThreshold: z.number().min(0).max(1),\n529:   confidenceOnly: z.boolean(),\n530: }).strict().describe('Live runtime routing thresholds surfaced by advisor_validate so manual checks can compare runtime semantics with release gates.');\n531: \n532: const advisorValidateTelemetryDiagnosticsSchema = z.object({\n533:   recordsPath: z.string().min(1),\n534:   recordsRetained: z.number().int().nonnegative(),\n535:   rollingCacheHitRate: z.number().min(0).max(1),\n536:   rollingP95Ms: z.number().min(0),\n537:   rollingFailOpenRate: z.number().min(0).max(1),\n538: }).strict().describe('Prompt-safe rolling diagnostics from retained advisor hook telemetry records.');\n539: \n540: const advisorValidateTelemetryScopeSchema = z.object({\n541:   kind: z.enum(['workspace', 'skill']),\n542:   skillSlug: z.string().min(1).nullable(),\n543: }).strict().describe('Whether recorded outcome totals are workspace-wide or scoped to the selected skillSlug.');\n544: \n545: const advisorValidateOutcomeTotalsSchema = z.object({\n546:   accepted: z.number().int().nonnegative(),\n547:   corrected: z.number().int().nonnegative(),\n548:   ignored: z.number().int().nonnegative(),\n549: }).strict().describe('Recorded outcome totals retained for the active workspace or skill scope.');\n550: \n551: const advisorValidateTelemetryOutcomesSchema = z.object({\n552:   recordsPath: z.string().min(1),\n553:   recordedThisRun: z.number().int().nonnegative(),\n554:   scope: advisorValidateTelemetryScopeSchema,\n555:   totals: advisorValidateOutcomeTotalsSchema,\n556: }).strict().describe('Outcome recording summary, including injected event count and retained accepted/corrected/ignored totals.');\n557: \n558: export const AdvisorValidateOutputSchema = z.object({\n559:   workspaceRoot: z.string().min(1),\n560:   skillSlug: z.string().nullable(),\n561:   thresholdSemantics: z.object({\n562:     aggregateValidation: advisorValidateAggregateValidationSchema,\n563:     runtimeRouting: advisorValidateRuntimeRoutingSchema,\n564:   }).strict().describe('Public threshold contract for advisor_validate, covering release-gate scoring and runtime-routing semantics.'),\n565:   overallAccuracy: z.number().min(0).max(1),\n566:   perSkill: z.array(z.object({\n567:     skillId: z.string().min(1),\n568:     status: z.enum(['pass', 'fail', 'skipped']),\n569:     matched: z.number().int().nonnegative(),\n570:     total: z.number().int().nonnegative(),\n571:   }).strict()),\n572:   slices: z.object({\n573:     corpus: z.object({\n574:       full_corpus_top1: validationSliceSchema,\n575:       unknown_count: z.object({\n576:         value: z.number().int().nonnegative(),\n577:         targetMax: z.number().int().nonnegative(),\n578:         passed: z.boolean(),\n579:       }).strict(),\n580:       gold_none_false_fire_count: z.object({\n581:         value: z.number().int().nonnegative(),\n582:         baselineDelta: z.number().int(),\n583:       }).strict(),\n584:     }).strict(),\n585:     holdout: z.object({\n586:       holdout_top1: validationSliceSchema,\n587:     }).strict(),\n588:     parity: z.object({\n589:       explicit_skill_top1_regression: z.object({\n590:         passed: z.boolean(),\n591:         regressions: z.array(z.string()),\n592:       }).strict(),\n593:       ambiguity_slice_stable: z.object({\n594:         passed: z.boolean(),\n595:         top2Within005: z.boolean(),\n596:       }).strict(),\n597:       derived_lane_attribution_complete: z.boolean(),\n598:     }).strict(),\n599:     safety: z.object({\n600:       adversarial_stuffing_blocked: z.object({\n601:         passed: z.boolean(),\n602:         fixtureCount: z.number().int().nonnegative(),\n603:       }).strict(),\n604:     }).strict(),\n605:     latency: z.object({\n606:       regression_suite_status: z.object({\n607:         p0PassRate: z.number().min(0).max(1),\n608:         failedCount: z.number().int().nonnegative(),\n609:         commandBridgeFalsePositiveRate: z.number().min(0).max(1),\n610:         cacheHitP95Ms: z.number().min(0),\n611:         uncachedP95Ms: z.number().min(0),\n612:       }).strict(),\n613:     }).strict(),\n614:     // Named per-intent accuracy buckets. review/memory_save are corpus rows\n615:     // grouped by their labeled bucket; delegation is the shared executor-routing\n616:     // fixture (the training corpus carries no honest executor-delegation signal).\n617:     // Each is a first-class accuracy gate so a regression confined to one intent\n618:     // class stays visible even when the aggregate corpus number holds.\n619:     buckets: z.object({\n620:       review: bucketSliceSchema,\n621:       memory_save: bucketSliceSchema,\n622:       delegation: bucketSliceSchema,\n623:     }).strict(),\n624:   }).strict(),\n625:   telemetry: z.object({\n626:     diagnostics: advisorValidateTelemetryDiagnosticsSchema,\n627:     outcomes: advisorValidateTelemetryOutcomesSchema,\n628:   }).strict().describe('Prompt-safe telemetry diagnostics and recorded outcome summaries exposed for operator validation.'),\n629:   generatedAt: z.string().datetime(),\n630: }).strict();\n631: \n632: // ───────────────────────────────────────────────────────────────────\n633: // 5. EXPORTS\n634: // ───────────────────────────────────────────────────────────────────\n635: \n636: export type AdvisorFreshness = z.infer<typeof AdvisorFreshnessSchema>;\n637: export type AdvisorRecommendInput = z.infer<typeof AdvisorRecommendInputSchema>;\n638: export type AdvisorRecommendOutput = z.infer<typeof AdvisorRecommendOutputSchema>;\n639: export type AdvisorRebuildInput = z.infer<typeof AdvisorRebuildInputSchema>;\n640: export type AdvisorRebuildOutput = z.infer<typeof AdvisorRebuildOutputSchema>;\n641: export type AdvisorStatusInput = z.infer<typeof AdvisorStatusInputSchema>;\n642: export type AdvisorStatusOutput = z.infer<typeof AdvisorStatusOutputSchema>;\n643: export type AdvisorValidateInput = z.infer<typeof AdvisorValidateInputSchema>;\n644: export type AdvisorValidateOutput = z.infer<typeof AdvisorValidateOutputSchema>;\n645: \n646: export const AdvisorToolInputSchemas = {\n647:   advisor_recommend: AdvisorRecommendInputSchema,\n648:   advisor_rebuild: AdvisorRebuildInputSchema,\n649:   advisor_status: AdvisorStatusInputSchema,\n650:   advisor_validate: AdvisorValidateInputSchema,\n651: } as const;"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/schemas/advisor-tool-schemas.ts\"}"},"time":{"start":1794540304433,"end":1794540305317}}}}
