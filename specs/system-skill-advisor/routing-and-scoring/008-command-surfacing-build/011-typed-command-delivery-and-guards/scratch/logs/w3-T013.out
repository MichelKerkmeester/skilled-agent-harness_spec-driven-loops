{"type":"tool_use","timestamp":1794540314017,"sessionID":"ses_e2d114b6fffeDMvOBXH8hRDbEL","part":{"partID":"prt_1d2f01bf7001ss7QgHcrR92jmE","sessionID":"ses_e2d114b6fffeDMvOBXH8hRDbEL","messageID":"msg_1d2f0001c001HhfJ9QvquYMpr2","type":"tool","id":"call_f83006328b49437590a1613e","tool":"read","state":{"status":"completed","input":{"path":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/tests/handlers/advisor-recommend-unavailable.vitest.ts"},"output":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/tests/handlers/advisor-recommend-unavailable.vitest.ts, lines 1-157\n1: // ───────────────────────────────────────────────────────────────\n2: // MODULE: Advisor Recommend Unavailable Tests\n3: // ───────────────────────────────────────────────────────────────\n4: \n5: import { afterEach, describe, expect, it, vi } from 'vitest';\n6: \n7: const { mockScoreAdvisorPrompt, mockReadAdvisorStatus } = vi.hoisted(() => ({\n8:   mockScoreAdvisorPrompt: vi.fn(),\n9:   mockReadAdvisorStatus: vi.fn(),\n10: }));\n11: \n12: vi.mock('../../lib/scorer/fusion.js', () => ({\n13:   scoreAdvisorPrompt: mockScoreAdvisorPrompt,\n14: }));\n15: \n16: vi.mock('../../handlers/advisor-status.js', () => ({\n17:   readAdvisorStatus: mockReadAdvisorStatus,\n18: }));\n19: \n20: import { advisorPromptCache } from '../../lib/prompt-cache.js';\n21: import { handleAdvisorRecommend } from '../../handlers/advisor-recommend.js';\n22: \n23: type HandlerResponse = Awaited<ReturnType<typeof handleAdvisorRecommend>>;\n24: \n25: function parseResponse(response: HandlerResponse): { status: string; data: Record<string, unknown> } {\n26:   return JSON.parse(response.content[0].text) as { status: string; data: Record<string, unknown> };\n27: }\n28: \n29: afterEach(() => {\n30:   advisorPromptCache.clear();\n31:   vi.restoreAllMocks();\n32:   mockReadAdvisorStatus.mockReset();\n33:   mockScoreAdvisorPrompt.mockReset();\n34: });\n35: \n36: describe('advisor_recommend unavailable freshness fail-open', () => {\n37:   it('returns empty recommendations without scoring when advisor status is unavailable', async () => {\n38:     mockReadAdvisorStatus.mockReturnValue({\n39:       freshness: 'unavailable',\n40:       generation: 0,\n41:       trustState: {\n42:         state: 'unavailable',\n43:         reason: 'ADVISOR_STATUS_UNAVAILABLE',\n44:         generation: 0,\n45:         checkedAt: '2026-04-28T00:00:00.000Z',\n46:         lastLiveAt: null,\n47:       },\n48:       lastGenerationBump: null,\n49:       lastScanAt: null,\n50:       skillCount: 0,\n51:       laneWeights: {\n52:         explicit_author: 0.42,\n53:         lexical: 0.28,\n54:         graph_causal: 0.13,\n55:         derived_generated: 0.12,\n56:         semantic_shadow: 0.05,\n57:       },\n58:       errors: ['database disk image is malformed'],\n59:     });\n60:     mockScoreAdvisorPrompt.mockReturnValue({\n61:       recommendations: [{\n62:         skill: 'system-spec-kit',\n63:         score: 0.9,\n64:         confidence: 0.95,\n65:         uncertainty: 0.05,\n66:         dominantLane: 'explicit_author',\n67:         laneContributions: [],\n68:         lifecycleStatus: 'active',\n69:       }],\n70:       topSkill: 'system-spec-kit',\n71:       unknown: false,\n72:       ambiguous: false,\n73:       metrics: { candidateCount: 1, liveLaneCount: 5 },\n74:     });\n75: \n76:     const response = parseResponse(await handleAdvisorRecommend({\n77:       prompt: 'Implement a spec folder workflow',\n78:     }));\n79: \n80:     expect(response.status).toBe('ok');\n81:     expect(response.data.freshness).toBe('unavailable');\n82:     expect(response.data.recommendations).toEqual([]);\n83:     expect(response.data.trustState).toEqual(expect.objectContaining({\n84:       state: 'unavailable',\n85:       reason: 'advisor_unavailable',\n86:     }));\n87:     expect(response.data.warnings).toEqual([\n88:       'advisor_unavailable',\n89:       'database disk image is malformed',\n90:     ]);\n91:     expect(response.data.abstainReasons).toEqual([\n92:       'Skill advisor freshness is unavailable; returning fail-open empty recommendations.',\n93:     ]);\n94:     expect(mockScoreAdvisorPrompt).not.toHaveBeenCalled();\n95:   });\n96: \n97:   it('serves recommendations when unavailable status has usable stale trust state', async () => {\n98:     mockReadAdvisorStatus.mockReturnValue({\n99:       freshness: 'unavailable',\n100:       generation: 7,\n101:       trustState: {\n102:         state: 'stale',\n103:         reason: 'SIGTERM',\n104:         generation: 7,\n105:         checkedAt: '2026-04-28T00:00:00.000Z',\n106:         lastLiveAt: null,\n107:       },\n108:       lastGenerationBump: '2026-04-28T00:00:00.000Z',\n109:       lastScanAt: '2026-04-28T00:00:00.000Z',\n110:       skillCount: 42,\n111:       laneWeights: {\n112:         explicit_author: 0.42,\n113:         lexical: 0.28,\n114:         graph_causal: 0.13,\n115:         derived_generated: 0.12,\n116:         semantic_shadow: 0.05,\n117:       },\n118:     });\n119:     mockScoreAdvisorPrompt.mockReturnValue({\n120:       recommendations: [{\n121:         skill: 'system-spec-kit',\n122:         score: 0.9,\n123:         confidence: 0.95,\n124:         uncertainty: 0.05,\n125:         dominantLane: 'explicit_author',\n126:         laneContributions: [],\n127:         lifecycleStatus: 'active',\n128:       }],\n129:       topSkill: 'system-spec-kit',\n130:       unknown: false,\n131:       ambiguous: false,\n132:       metrics: { candidateCount: 1, liveLaneCount: 5 },\n133:     });\n134: \n135:     const response = parseResponse(await handleAdvisorRecommend({\n136:       prompt: 'Implement a spec folder workflow',\n137:     }));\n138: \n139:     expect(response.status).toBe('ok');\n140:     expect(response.data.freshness).toBe('stale');\n141:     expect(response.data.recommendations).toEqual([\n142:       expect.objectContaining({ skillId: 'system-spec-kit' }),\n143:     ]);\n144:     expect(response.data.warnings).toEqual(['SIGTERM']);\n145:     expect(mockScoreAdvisorPrompt).toHaveBeenCalledWith(\n146:       'Implement a spec folder workflow',\n147:       expect.objectContaining({\n148:         runtimeLaneHealth: {\n149:           graph_causal: {\n150:             status: 'runtime_degraded',\n151:             reason: 'SIGTERM',\n152:           },\n153:         },\n154:       }),\n155:     );\n156:   });\n157: });","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/tests/handlers/advisor-recommend-unavailable.vitest.ts, lines 1-157\n1: // ───────────────────────────────────────────────────────────────\n2: // MODULE: Advisor Recommend Unavailable Tests\n3: // ───────────────────────────────────────────────────────────────\n4: \n5: import { afterEach, describe, expect, it, vi } from 'vitest';\n6: \n7: const { mockScoreAdvisorPrompt, mockReadAdvisorStatus } = vi.hoisted(() => ({\n8:   mockScoreAdvisorPrompt: vi.fn(),\n9:   mockReadAdvisorStatus: vi.fn(),\n10: }));\n11: \n12: vi.mock('../../lib/scorer/fusion.js', () => ({\n13:   scoreAdvisorPrompt: mockScoreAdvisorPrompt,\n14: }));\n15: \n16: vi.mock('../../handlers/advisor-status.js', () => ({\n17:   readAdvisorStatus: mockReadAdvisorStatus,\n18: }));\n19: \n20: import { advisorPromptCache } from '../../lib/prompt-cache.js';\n21: import { handleAdvisorRecommend } from '../../handlers/advisor-recommend.js';\n22: \n23: type HandlerResponse = Awaited<ReturnType<typeof handleAdvisorRecommend>>;\n24: \n25: function parseResponse(response: HandlerResponse): { status: string; data: Record<string, unknown> } {\n26:   return JSON.parse(response.content[0].text) as { status: string; data: Record<string, unknown> };\n27: }\n28: \n29: afte