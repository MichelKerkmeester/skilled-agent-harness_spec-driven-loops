/speckit:search': 'run',\n176: };\n177: export const TRACKED_COMMANDS: Readonly<Record<string, TrackedCommand>> = {\n178:   '/create:agent': { policy: 'start', ownerSkillId: 'sk-doc', scorerRow: true },\n179:   '/create:benchmark': { policy: 'start', ownerSkillId: 'sk-doc', scorerRow: false },\n180:   '/create:changelog': { policy: 'ask', ownerSkillId: 'sk-doc', scorerRow: false },\n181:   '/create:command': { policy: 'start', ownerSkillId: 'sk-doc', scorerRow: false },\n182:   '/create:diff': { policy: 'start', ownerSkillId: 'sk-doc', scorerRow: false },\n183:   '/create:feature-catalog': { policy: 'start', ownerSkillId: 'sk-doc', scorerRow: false },\n184:   '/create:goal': { policy: 'start', ownerSkillId: 'sk-doc', scorerRow: false },\n185:   '/create:manual-testing-playbook': { policy: 'start', ownerSkillId: 'sk-doc', scorerRow: true },\n186:   '/create:readme': { policy: 'start', ownerSkillId: 'sk-doc', scorerRow: false },\n187:   '/create:repo-rule': { policy: 'start', ownerSkillId: 'sk-doc', scorerRow: false },\n188:   '/create:skill': { policy: 'start', ownerSkillId: 'sk-doc', scorerRow: false },\n189:   '/create:skill-parent': { policy: 'start', ownerSkillId: 'sk-doc', scorerRow: false },\n190:   '/create:with-human-voice': { policy: 'start', ownerSkillId: 'sk-doc', scorerRow: false },\n191:   '/deep:ai-council': { policy: 'ask', ownerSkillId: 'system-deep-loop', scorerRow: false },\n192:   '/deep:research': { policy: 'ask', ownerSkillId: 'system-deep-loop', scorerRow: false },\n193:   '/deep:review': { policy: 'ask', ownerSkillId: 'system-deep-loop', scorerRow: false },\n194:   '/design:chart': { policy: 'start', ownerSkillId: 'sk-design', scorerRow: false },\n195:   '/design:diagram': { policy: 'start', ownerSkillId: 'sk-design', scorerRow: false },\n196:   '/design:extract': { policy: 'ask', ownerSkillId: 'sk-design', scorerRow: false },\n197:   '/doctor:agents-md check': { policy: 'run', ownerSkillId: 'system-skilled-doctor', scorerRow: true },\n198:   '/doctor:agents-md embed': { policy: 'ask', ownerSkillId: 'system-skilled-doctor', scorerRow: true },\n199:   '/doctor:agents-md restore': { policy: 'ask', ownerSkillId: 'system-skilled-doctor', scorerRow: true },\n200:   '/doctor:ci report': { policy: 'run', ownerSkillId: 'sk-code', scorerRow: true },\n201:   '/doctor:ci scaffold': { policy: 'ask', ownerSkillId: 'sk-code', scorerRow: true },\n202:   '/doctor:ci toggle': { policy: 'ask', ownerSkillId: 'sk-code', scorerRow: true },\n203:   '/doctor:deep-loop': { policy: 'run', ownerSkillId: 'system-deep-loop', scorerRow: true },\n204:   '/doctor:env list': { policy: 'run', ownerSkillId: 'system-skilled-doctor', scorerRow: true },\n205:   '/doctor:git hooks': { policy: 'ask', ownerSkillId: 'sk-git', scorerRow: true },\n206:   '/doctor:git setup': { policy: 'run', ownerSkillId: 'sk-git', scorerRow: true },\n207:   '/doctor:git standards': { policy: 'ask', ownerSkillId: 'sk-git', scorerRow: true },\n208:   '/doctor:helper': { policy: 'run', ownerSkillId: 'system-skilled-doctor', scorerRow: true },\n209:   '/doctor:install': { policy: 'run', ownerSkillId: 'system-skilled-doctor', scorerRow: true },\n210:   '/doctor:mcp debug': { policy: 'ask', ownerSkillId: 'system-skilled-doctor', scorerRow: true },\n211:   '/doctor:mcp install': { policy: 'ask', ownerSkillId: 'system-skilled-doctor', scorerRow: true },\n212:   '/doctor:overlay apply': { policy: 'ask', ownerSkillId: 'system-skilled-doctor', scorerRow: true },\n213:   '/doctor:overlay repin': { policy: 'ask', ownerSkillId: 'system-skilled-doctor', scorerRow: true },\n214:   '/doctor:overlay status': { policy: 'run', ownerSkillId: 'system-skilled-doctor', scorerRow: true },\n215:   '/doctor:runtime-mirrors': { policy: 'run', ownerSkillId: 'system-skilled-doctor', scorerRow: true },\n216:   '/doctor:setup': { policy: 'run', ownerSkillId: 'system-skilled-doctor', scorerRow: true },\n217:   '/doctor:sk-code quality': { policy: 'ask', ownerSkillId: 'sk-code', scorerRow: true },\n218:   '/doctor:sk-code setup': { policy: 'run', ownerSkillId: 'sk-code', scorerRow: true },\n219:   '/doctor:sk-skill check': { policy: 'run', ownerSkillId: 'sk-doc', scorerRow: true },\n220:   '/doctor:sk-skill convert': { policy: 'ask', ownerSkillId: 'sk-doc', scorerRow: true },\n221:   '/doctor:skill-advisor embedder': { policy: 'ask', ownerSkillId: 'system-skill-advisor', scorerRow: true },\n222:   '/doctor:skill-advisor parent-skill': { policy: 'run', ownerSkillId: 'system-skill-advisor', scorerRow: true },\n223:   '/doctor:skill-advisor rebuild': { policy: 'ask', ownerSkillId: 'system-skill-advisor', scorerRow: true },\n224:   '/doctor:skill-advisor router-reach': { policy: 'run', ownerSkillId: 'system-skill-advisor', scorerRow: true },\n225:   '/doctor:skill-advisor skill-budget': { policy: 'run', ownerSkillId: 'system-skill-advisor', scorerRow: true },\n226:   '/doctor:skill-advisor skill-graph-freshness': { policy: 'run', ownerSkillId: 'system-skill-advisor', scorerRow: true },\n227:   '/doctor:skill-advisor tune': { policy: 'ask', ownerSkillId: 'system-skill-advisor', scorerRow: true },\n228:   '/doctor:speckit': { policy: 'run', ownerSkillId: 'system-skilled-doctor', scorerRow: true },\n229:   '/doctor:symlink check': { policy: 'run', ownerSkillId: 'system-skilled-doctor', scorerRow: true },\n230:   '/doctor:symlink link': { policy: 'ask', ownerSkillId: 'system-skilled-doctor', scorerRow: true },\n231:   '/doctor:symlink unlink': { policy: 'ask', ownerSkillId: 'system-skilled-doctor', scorerRow: true },\n232:   '/doctor:update': { policy: 'ask', ownerSkillId: 'system-skilled-doctor', scorerRow: true },\n233:   '/prompt:improve': { policy: 'start', ownerSkillId: 'sk-prompt', scorerRow: true },\n234:   '/speckit:complete': { policy: 'start', ownerSkillId: 'system-spec-kit', scorerRow: true },\n235:   '/speckit:handoff': { policy: 'ask', ownerSkillId: 'system-spec-kit', scorerRow: true },\n236:   '/speckit:implement': { policy: 'start', ownerSkillId: 'system-spec-kit', scorerRow: true },\n237:   '/speckit:plan': { policy: 'start', ownerSkillId: 'system-spec-kit', scorerRow: true },\n238:   '/speckit:resume': { policy: 'start', ownerSkillId: 'system-spec-kit', scorerRow: true },\n239:   '/speckit:save': { policy: 'start', ownerSkillId: 'system-spec-kit', scorerRow: true },\n240:   '/speckit:search': { policy: 'run', ownerSkillId: 'system-spec-kit', scorerRow: true },\n241: };\n242: // END GENERATED COMMAND ROWS\n243: \n244: // The row for an id a recommendation carries, or undefined when that id names no\n245: // command. Own-key lookup because the table is generated data, so an inherited\n246: // name such as `constructor` must not resolve to a row nobody declared.\n247: export function commandRowFor(id: string): CommandRow | undefined {\n248:   return Object.hasOwn(COMMAND_ROWS, id) ? COMMAND_ROWS[id] : undefined;\n249: }\n250: \n251: // A typed command is the reader's own wording, so it counts only where a command\n252: // can start and where it ends on a boundary. That keeps a path such as\n253: // `docs/create:goal.md` and a prefix such as `/create:sk` from reading as a\n254: // command, and the longest key wins so `/create:skill-parent` is never reduced to\n255: // its `/create:skill` prefix.\n256: const COMMAND_START_BOUNDARY = /[\\s`'\"(]/;\n257: const COMMAND_CONTINUATION = /[a-z0-9_:-]/;\n258: \n259: export function typedCommandIn(prompt: string): string | undefined {\n260:   const lowered = prompt.toLowerCase();\n261:   let found: string | undefined;\n262:   for (const key of Object.keys(TRACKED_COMMANDS)) {\n263:     let index = lowered.indexOf(key);\n264:     while (index !== -1) {\n265:       const before = index === 0 ? '' : lowered[index - 1];\n266:       const after = lowered[index + key.length] ?? '';\n267:       const startsAtBoundary = before === '' || COMMAND_START_BOUNDARY.test(before);\n268:       const endsAtBoundary = after === '' || !COMMAND_CONTINUATION.test(after);\n269:       if (startsAtBoundary && endsAtBoundary) {\n270:         if (found === undefined || key.length > found.length) found = key;\n271:         break;\n272:       }\n273:       index = lowered.indexOf(key, index + 1);\n274:     }\n275:   }\n276:   return found;\n277: }\n278: \n279: // A typed command travels on the recommendation that leads, so it is delivered\n280: // only when the leading skill owns the command or carries the same command row.\n281: // A leading skill unrelated to the command must not carry it.\n282: export interface TypedCommand {\n283:   readonly command: string;\n284:   readonly policy: 'run' | 'start' | 'ask';\n285:   readonly ownerSkillId: string;\n286: }\n287: \n288: export function typedCommandForTop(topSkillId: string, prompt: string): TypedCommand | undefined {\n289:   const command = typedCommandIn(prompt);\n290:   if (command === undefined || !Object.hasOwn(TRACKED_COMMANDS, command)) return undefined;\n291:   const row = TRACKED_COMMANDS[command];\n292:   const sameCommandRow = commandRowFor(topSkillId)?.command === command;\n293:   if (topSkillId !== row.ownerSkillId && !sameCommandRow) return undefined;\n294:   return { command, policy: row.policy, ownerSkillId: row.ownerSkillId };\n295: }\n296: \n297: // Deep-loop commands open a long, multi-pass run, so one attached to a prompt\n298: // that merely mentions the topic spends the reader's budget on work they never\n299: // asked for. The list below is the vocabulary that counts as asking for it, and\n300: // it holds only effort wording: a bare topic word such as `research`, `review`\n301: // or `council` says what to look at, never how far to go, so it never qualifies\n302: // on its own.\n303: //\n304: // The phrases live in a data list, one per line, so the vocabulary a reviewer\n305: // has to judge stays visible and cheap to correct.\n306: export const DEPTH_WORDING: readonly string[] = [\n307:   'in depth',\n308:   'deep dive',\n309:   'deep research',\n310:   'deep review',\n311:   'thorough',\n312:   'thoroughly',\n313:   'exhaustive',\n314:   'iteratively',\n315:   'multiple passes',\n316:   'many passes',\n317:   'several passes',\n318:   'ask the council',\n319:   'convene',\n320:   'several models',\n321:   'final verdict',\n322:   'everything you can',\n323: ];\n324: \n325: // A phrase may carry punctuation a regex would read as a metacharacter, so it is\n326: // escaped before it is trusted as a pattern.\n327: function escapePhrase(phrase: string): string {\n328:   return phrase.replace(/[.*+?^${}()|[\\]\\\\]/g, '\\\\$&');\n329: }\n330: \n331: // One alternation over the list keeps the gate a single test per prompt, and the\n332: // boundary markers keep `thorough` from firing inside a longer word while a\n333: // multi-word phrase still has to match as a whole.\n334: const DEPTH_REQUEST = new RegExp(`\\\\b(?:${DEPTH_WORDING.map(escapePhrase).join('|')})\\\\b`);\n335: \n336: // A compiled route arrives as unvalidated JSON from a separate process, so the\n337: // shape is narrowed here rather than trusted. Arrays count as objects in\n338: // JavaScript and would let `action` read off an unrelated field, so they are\n339: // excluded explicitly.\n340: function asRecord(value: unknown): Record<string, unknown> | undefined {\n341:   if (typeof value !== 'object' || value === null || Array.isArray(value)) return undefined;\n342:   return value as Record<string, unknown>;\n343: }\n344: \n345: // The command for a hub's recommendation, or undefined when the route does not\n346: // single out one mode. Only a single-mode route names a command unambiguously:\n347: // a bundle or a multi-target route has more than one answer, and asking the\n348: // reader to pick belongs to the recommend path, not here. Never throws, because\n349: // a missing command must degrade to \"no command offered\" rather than break\n350: // routing. The prompt decides whether a costly deep-loop command is offered at\n351: // all: a reader who only asks about the topic gets no command, rather than one\n352: // that would launch work they never requested.\n353: export function attachCommand(\n354:   skillId: string,\n355:   compiledRoute: unknown,\n356:   prompt: string,\n357:   modeCommands: Readonly<Record<string, Readonly<Record<string, string>>>> = MODE_COMMANDS,\n358: ): string | undefined {\n359:   const route = asRecord(compiledRoute);\n360:   if (!route) return undefined;\n361:   if (route.action !== 'route' || route.selectionKind !== 'single') return undefined;\n362: \n363:   const targets = route.targets;\n364:   if (!Array.isArray(targets) || targets.length !== 1) return undefined;\n365: \n366:   const onlyTarget = asRecord(targets[0]);\n367:   if (!onlyTarget) return undefined;\n368: \n369:   const workflowMode = onlyTarget.workflowMode;\n370:   if (typeof workflowMode !== 'string' || workflowMode === '') return undefined;\n371: \n372:   // Own-key lookup on both levels: the table is data read from a generated\n373:   // object, so an inherited name such as `constructor` must not resolve to a\n374:   // command the hub never declared.\n375:   if (!Object.prototype.hasOwnProperty.call(modeCommands, skillId)) return undefined;\n376:   const commands = modeCommands[skillId];\n377:   if (!Object.prototype.hasOwnProperty.call(commands, workflowMode)) return undefined;\n378: \n379:   // Deep-loop commands are the ones that commit the reader to a long, multi-pass\n380:   // run, so they are offered only when the prompt asks for that effort. Typing\n381:   // the slash command is itself the ask, and every other hub answers a short\n382:   // question with a short answer, so no other skill consults the wording list.\n383:   if (skillId === 'system-deep-loop') {\n384:     const lowered = prompt.toLowerCase();\n385:     if (!lowered.includes('/deep:') && !DEPTH_REQUEST.test(lowered)) return undefined;\n386:   }\n387: \n388:   return commands[workflowMode];\n389: }","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/lib/command-attach.ts, lines 1-389\n1: // ───────────────────────────────────────────────────────────────\n2: // MODULE: Slash command attached to a hub's recommendation\n3: // ───────────────────────────────────────────────────────────────\n4: //\n5: // The advisor can name the workflow mode a hub would route a prompt to, but the\n6: // reader still has to translate that mode into the slash command that acts on\n7: // it. This module owns that translation and nothing else, kept free of imports\n8: // so the recommend path and a test read the same semantics.\n9: //\n10: // The mode-to-command table is generated rather than hand-maintained: each row is\n11: // derived from a hub's own command files, so a hub that adds or renames a mode\n12: // regenerates its row instead of drifting from a copy someone forgot to update.\n13: \n14: // BEGIN GENERATED MODE COMMANDS\n15: export const MODE_COMMANDS: Readonly<Record<string, Readonly<Record<string, string>>>> = {\n16:   'sk-design': {\n17:     'sk-design-chart': '/design:chart',\n18:     'sk-design-diagram': '/design:diagram',\n19:     'sk-design-md-generator': '/design:extract',\n20:   },\n21:   'sk-doc': {\n22:     'sk-create-agent': '/create:agent',\n23:     'sk-create-benchmark': '/create:benchmark',\n24:     'sk-create-changelog': '/create:changelog',\n25:     'sk-create-command': '/create:command',\n26:     'sk-create-diff': '/create:diff',\n27:     'sk-create-feature-catalog': '/create:feature-catalog',\n28:     'sk-create-goal': '/create:goal',\n29:     'sk-create-manual-testing-playbook': '/create:manual-testing-playbook',\n30:     'sk-create-readme': '/create:readme',\n31:     'sk-create-repo-rule': '/create:repo-rule',\n32:     'sk-create-skill': '/create:skill',\n33:     'sk-create-skill-parent': '/create:skill-parent',\n34:     'sk-create-with-human-voice': '/create:with-human-voice',\n35:   },\n36:   'system-deep-loop': {\n37:     'ai-council': '/deep:ai-council',\n38:     'research': '/deep:research',\n39:     'review': '/deep:review',\n40:   },\n41: };\n42: // END GENERATED MODE COMMANDS\n43: \n44: // One row of the command table: the runnable slash command, the policy that says\n45: // whether it runs, asks or starts a session, the class that says what the run\n46: // writes, and the skill that owns it. The rows are generated, so only the shape\n47: // lives here.\n48: export interface CommandRow {\n49:   readonly command: string;\n50:   readonly policy?: 'run' | 'start' | 'ask';\n51:   readonly mutating?: 'read-only' | 'add-only' | 'mutates';\n52:   readonly ownerSkillId: string;\n53: }\n54: \n55: // The table below covers every tracked command, whether or not its bridge is\n56: // active, so a typed command always has a policy and an owner. `scorerRow` says\n57: // whether a scorer can also return the command on its own.\n58: export interface TrackedCommand {\n59:   readonly policy: 'run' | 'start' | 'ask';\n60:   readonly ownerSkillId: string;\n61:   readonly scorerRow: boolean;\n62: }\n63: \n64: // BEGIN GENERATED COMMAND ROWS\n65: export const COMMAND_ROWS: Readonly<Record<string, CommandRow>> = {\n66:   'command-create-agent': { command: '/create:agent', policy: 'start', mutating: 'mutates', ownerSkillId: 'sk-doc' },\n67:   'command-create-changelog': { command: '/create:changelog', policy: 'ask', mutating: 'mutates', ownerSkillId: 'sk-doc' },\n68:   'command-create-feature-catalog': { command: '/create:feature-catalog', policy: 'start', mutating: 'mutates', ownerSkillId: 'sk-doc' },\n69:   'command-create-manual-testing-playbook': { command: '/create:manual-testing-playbook', policy: 'start', mutating: 'mutates', ownerSkillId: 'sk-doc' },\n70:   'command-create-readme': { command: '/create:readme', policy: 'start', mutating: 'mutates', ownerSkillId: 'sk-doc' },\n71:   'command-create-skill': { command: '/create:skill', policy: 'start', mutating: 'mutates', ownerSkillId: 'sk-doc' },\n72:   'command-deep-research': { command: '/deep:research', policy: 'ask', mutating: 'mutates', ownerSkillId: 'system-deep-loop' },\n73:   'command-deep-review': { command: '/deep:review', policy: 'ask', mutating: 'mutates', ownerSkillId: 'system-deep-loop' },\n74:   'command-doctor-agents-md-check': { command: '/doctor:agents-md check', policy: 'run', mutating: 'read-only', ownerSkillId: 'system-skilled-doctor' },\n75:   'command-doctor-agents-md-embed': { command: '/doctor:agents-md embed', policy: 'ask', mutating: 'mutates', ownerSkillId: 'system-skilled-doctor' },\n76:   'command-doctor-agents-md-restore': { command: '/doctor:agents-md restore', policy: 'ask', mutating: 'mutates', ownerSkillId: 'system-skilled-doctor' },\n77:   'command-doctor-ci-report': { command: '/doctor:ci report', policy: 'run', mutating: 'read-only', ownerSkillId: 'sk-code' },\n78:   'command-doctor-ci-scaffold': { command: '/doctor:ci scaffold', policy: 'ask', mutating: 'mutates', ownerSkillId: 'sk-code' },\n79:   'command-doctor-ci-toggle': { command: '/doctor:ci toggle', policy: 'ask', mutating: 'mutates', ownerSkillId: 'sk-code' },\n80:   'command-doctor-deep-loop': { command: '/doctor:deep-loop', policy: 'run', mutating: 'add-only', ownerSkillId: 'system-deep-loop' },\n81:   'command-doctor-env': { command: '/doctor:env list', policy: 'run', mutating: 'read-only', ownerSkillId: 'system-skilled-doctor' },\n82:   'command-doctor-git-hooks': { command: '/doctor:git hooks', policy: 'ask', mutating: 'mutates', ownerSkillId: 'sk-git' },\n83:   'command-doctor-git-setup': { command: '/doctor:git setup', policy: 'run', mutating: 'read-only', ownerSkillId: 'sk-git' },\n84:   'command-doctor-git-standards': { command: '/doctor:git standards', policy: 'ask', mutating: 'mutates', ownerSkillId: 'sk-git' },\n85:   'command-doctor-helper': { command: '/doctor:helper', policy: 'run', mutating: 'read-only', ownerSkillId: 'system-skilled-doctor' },\n86:   'command-doctor-install': { command: '/doctor:install', policy: 'run', mutating: 'read-only', ownerSkillId: 'system-skilled-doctor' },\n87:   'command-doctor-mcp-debug': { command: '/doctor:mcp debug', policy: 'ask', mutating: 'mutates', ownerSkillId: 'system-skilled-doctor' },\n88:   'command-doctor-mcp-install': { command: '/doctor:mcp install', policy: 'ask', mutating: 'mutates', ownerSkillId: 'system-skilled-doctor' },\n89:   'command-doctor-overlay-apply': { command: '/doctor:overlay apply', policy: 'ask', mutating: 'mutates', ownerSkillId: 'system-skilled-doctor' },\n90:   'command-doctor-overlay-repin': { command: '/doctor:overlay repin', policy: 'ask', mutating: 'mutates', ownerSkillId: 'system-skilled-doctor' },\n91:   'command-doctor-overlay-status': { command: '/doctor:overlay status', policy: 'run', mutating: 'read-only', ownerSkillId: 'system-skilled-doctor' },\n92:   'command-doctor-runtime-mirrors': { command: '/doctor:runtime-mirrors', policy: 'run', mutating: 'read-only', ownerSkillId: 'system-skilled-doctor' },\n93:   'command-doctor-setup': { command: '/doctor:setup', policy: 'run', mutating: 'read-only', ownerSkillId: 'system-skilled-doctor' },\n94:   'command-doctor-sk-code-quality': { command: '/doctor:sk-code quality', policy: 'ask', mutating: 'mutates', ownerSkillId: 'sk-code' },\n95:   'command-doctor-sk-code-setup': { command: '/doctor:sk-code setup', policy: 'run', mutating: 'read-only', ownerSkillId: 'sk-code' },\n96:   'command-doctor-sk-skill-check': { command: '/doctor:sk-skill check', policy: 'run', mutating: 'read-only', ownerSkillId: 'sk-doc' },\n97:   'command-doctor-sk-skill-convert': { command: '/doctor:sk-skill convert', policy: 'ask', mutating: 'mutates', ownerSkillId: 'sk-doc' },\n98:   'command-doctor-skill-advisor-embedder': { command: '/doctor:skill-advisor embedder', policy: 'ask', mutating: 'mutates', ownerSkillId: 'system-skill-advisor' },\n99:   'command-doctor-skill-advisor-parent-skill': { command: '/doctor:skill-advisor parent-skill', policy: 'run', mutating: 'read-only', ownerSkillId: 'system-skill-advisor' },\n100:   'command-doctor-skill-advisor-rebuild': { command: '/doctor:skill-advisor rebuild', policy: 'ask', mutating: 'mutates', ownerSkillId: 'system-skill-advisor' },\n101:   'command-doctor-skill-advisor-router-reach': { command: '/doctor:skill-advisor router-reach', policy: 'run', mutating: 'read-only', ownerSkillId: 'system-skill-advisor' },\n102:   'command-doctor-skill-advisor-skill-budget': { command: '/doctor:skill-advisor skill-budget', policy: 'run', mutating: 'read-only', ownerSkillId: 'system-skill-advisor' },\n103:   'command-doctor-skill-advisor-skill-graph-freshness': { command: '/doctor:skill-advisor skill-graph-freshness', policy: 'run', mutating: 'read-only', ownerSkillId: 'system-skill-advisor' },\n104:   'command-doctor-skill-advisor-tune': { command: '/doctor:skill-advisor tune', policy: 'ask', mutating: 'mutates', ownerSkillId: 'system-skill-advisor' },\n105:   'command-doctor-speckit': { command: '/doctor:speckit', policy: 'run', mutating: 'add-only', ownerSkillId: 'system-skilled-doctor' },\n106:   'command-doctor-symlink-check': { command: '/doctor:symlink check', policy: 'run', mutating: 'read-only', ownerSkillId: 'system-skilled-doctor' },\n107:   'command-doctor-symlink-link': { command: '/doctor:symlink link', policy: 'ask', mutating: 'mutates', ownerSkillId: 'system-skilled-doctor' },\n108:   'command-doctor-symlink-unlink': { command: '/doctor:symlink unlink', policy: 'ask', mutating: 'mutates', ownerSkillId: 'system-skilled-doctor' },\n109:   'command-doctor-update': { command: '/doctor:update', policy: 'ask', mutating: 'mutates', ownerSkillId: 'system-skilled-doctor' },\n110:   'command-prompt-improve': { command: '/prompt:improve', policy: 'start', mutating: 'mutates', ownerSkillId: 'sk-prompt' },\n111:   'command-spec-kit-deep-research': { command: '/deep:research', policy: 'ask', mutating: 'mutates', ownerSkillId: 'system-deep-loop' },\n112:   'command-spec-kit-deep-review': { command: '/deep:review', policy: 'ask', mutating: 'mutates', ownerSkillId: 'system-deep-loop' },\n113:   'command-speckit-complete': { command: '/speckit:complete', policy: 'start', mutating: 'mutates', ownerSkillId: 'system-spec-kit' },\n114:   'command-speckit-handoff': { command: '/speckit:handoff', policy: 'ask', mutating: 'mutates', ownerSkillId: 'system-spec-kit' },\n115:   'command-speckit-implement': { command: '/speckit:implement', policy: 'start', mutating: 'mutates', ownerSkillId: 'system-spec-kit' },\n116:   'command-speckit-plan': { command: '/speckit:plan', policy: 'start', mutating: 'mutates', ownerSkillId: 'system-spec-kit' },\n117:   'command-speckit-resume': { command: '/speckit:resume', policy: 'start', mutating: 'mutates', ownerSkillId: 'system-spec-kit' },\n118:   'command-speckit-save': { command: '/speckit:save', policy: 'start', mutating: 'mutates', ownerSkillId: 'system-spec-kit' },\n119:   'command-speckit-search': { command: '/speckit:search', policy: 'run', mutating: 'read-only', ownerSkillId: 'system-spec-kit' },\n120:   'create:agent': { command: '/create:agent', policy: 'start', mutating: 'mutates', ownerSkillId: 'sk-doc' },\n121:   'create:manual-testing-playbook': { command: '/create:manual-testing-playbook', policy: 'start', mutating: 'mutates', ownerSkillId: 'sk-doc' },\n122: };\n123: export const COMMAND_POLICIES: Readonly<Record<string, 'run' | 'start' | 'ask'>> = {\n124:   '/create:agent': 'start',\n125:   '/create:changelog': 'ask',\n126:   '/create:feature-catalog': 'start',\n127:   '/create:manual-testing-playbook': 'start',\n128:   '/create:readme': 'start',\n129:   '/create:skill': 'start',\n130:   '/deep:research': 'ask',\n131:   '/deep:review': 'ask',\n132:   '/doctor:agents-md check': 'run',\n133:   '/doctor:agents-md embed': 'ask',\n134:   '/doctor:agents-md restore': 'ask',\n135:   '/doctor:ci report': 'run',\n136:   '/doctor:ci scaffold': 'ask',\n137:   '/doctor:ci toggle': 'ask',\n138:   '/doctor:deep-loop': 'run',\n139:   '/doctor:env list': 'run',\n140:   '/doctor:git hooks': 'ask',\n141:   '/doctor:git setup': 'run',\n142:   '/doctor:git standards': 'ask',\n143:   '/doctor:helper': 'run',\n144:   '/doctor:install': 'run',\n145:   '/doctor:mcp debug': 'ask',\n146:   '/doctor:mcp install': 'ask',\n147:   '/doctor:overlay apply': 'ask',\n148:   '/doctor:overlay repin': 'ask',\n149:   '/doctor:overlay status': 'run',\n150:   '/doctor:runtime-mirrors': 'run',\n151:   '/doctor:setup': 'run',\n152:   '/doctor:sk-code quality': 'ask',\n153:   '/doctor:sk-code setup': 'run',\n154:   '/doctor:sk-skill check': 'run',\n155:   '/doctor:sk-skill convert': 'ask',\n156:   '/doctor:skill-advisor embedder': 'ask',\n157:   '/doctor:skill-advisor parent-skill': 'run',\n158:   '/doctor:skill-advisor rebuild': 'ask',\n159:   '/doctor:skill-advisor router-reach': 'run',\n160:   '/doctor:skill-advisor skill-budget': 'run',\n161:   '/doctor:skill-advisor skill-graph-freshness': 'run',\n162:   '/doctor:skill-advisor tune': 'ask',\n163:   '/doctor:speckit': 'run',\n164:   '/doctor:symlink check': 'run',\n165:   '/doctor:symlink link': 'ask',\n166:   '/doctor:symlink unlink': 'ask',\n167:   '/doctor:update': 'ask',\n168:   '/prompt:improve': 'start',\n169:   '/speckit:complete': 'start',\n170:   '/speckit:handoff': 'ask',\n171:   '/speckit:implement': 'start',\n172:   '/speckit:plan': 'start',\n173:   '/speckit:resume': 'start',\n174:   '/speckit:save': 'start',\n175:   '/speckit:search': 'run',\n176: };\n177: export const TRACKED_COMMANDS: Readonly<Record<string, TrackedCommand>> = {\n178:   '/create:agent': { policy: 'start', ownerSkillId: 'sk-doc', scorerRow: true },\n179:   '/create:benchmark': { policy: 'start', ownerSkillId: 'sk-doc', scorerRow: false },\n180:   '/create:changelog': { policy: 'ask', ownerSkillId: 'sk-doc', scorerRow: false },\n181:   '/create:command': { policy: 'start', ownerSkillId: 'sk-doc', scorerRow: false },\n182:   '/create:diff': { policy: 'start', ownerSkillId: 'sk-doc', scorerRow: false },\n183:   '/create:feature-catalog': { policy: 'start', ownerSkillId: 'sk-doc', scorerRow: false },\n184:   '/create:goal': { policy: 'start', ownerSkillId: 'sk-doc', scorerRow: false },\n185:   '/create:manual-testing-playbook': { policy: 'start', ownerSkillId: 'sk-doc', scorerRow: true },\n186:   '/create:readme': { policy: 'start', ownerSkillId: 'sk-doc', scorerRow: false },\n187:   '/create:repo-rule': { policy: 'start', ownerSkillId: 'sk-doc', scorerRow: false },\n188:   '/create:skill': { policy: 'start', ownerSkillId: 'sk-doc', scorerRow: false },\n189:   '/create:skill-parent': { policy: 'start', ownerSkillId: 'sk-doc', scorerRow: false },\n190:   '/create:with-human-voice': { policy: 'start', ownerSkillId: 'sk-doc', scorerRow: false },\n191:   '/deep:ai-council': { policy: 'ask', ownerSkillId: 'system-deep-loop', scorerRow: false },\n192:   '/deep:research': { policy: 'ask', ownerSkillId: 'system-deep-loop', scorerRow: false },\n193:   '/deep:review': { policy: 'ask', ownerSkillId: 'system-deep-loop', scorerRow: false },\n194:   '/design:chart': { policy: 'start', ownerSkillId: 'sk-design', scorerRow: false },\n195:   '/design:diagram': { policy: 'start', ownerSkillId: 'sk-design', scorerRow: false },\n196:   '/design:extract': { policy: 'ask', ownerSkillId: 'sk-design', scorerRow: false },\n197:   '/doctor:agents-md check': { policy: 'run', ownerSkillId: 'system-skilled-doctor', scorerRow: true },\n198:   '/doctor:agents-md embed': { policy: 'ask', ownerSkillId: 'system-skilled-doctor', scorerRow: true },\n199:   '/doctor:agents-md restore': { policy: 'ask', ownerSkillId: 'system-skilled-doctor', scorerRow: true },\n200:   '/doctor:ci report': { policy: 'run', ownerSkillId: 'sk-code', scorerRow: true },\n201:   '/doctor:ci scaffold': { policy: 'ask', ownerSkillId: 'sk-code', scorerRow: true },\n202:   '/doctor:ci toggle': { policy: 'ask', ownerSkillId: 'sk-code', scorerRow: true },\n203:   '/doctor:deep-loop': { policy: 'run', ownerSkillId: 'system-deep-loop', scorerRow: true },\n204:   '/doctor:env list': { policy: 'run', ownerSkillId: 'system-skilled-doctor', scorerRow: true },\n205:   '/doctor:git hooks': { policy: 'ask', ownerSkillId: 'sk-git', scorerRow: true },\n206:   '/doctor:git setup': { policy: 'run', ownerSkillId: 'sk-git', scorerRow: true },\n207:   '/doctor:git standards': { policy: 'ask', ownerSkillId: 'sk-git', scorerRow: true },\n208:   '/doctor:helper': { policy: 'run', ownerSkillId: 'system-skilled-doctor', scorerRow: true },\n209:   '/doctor:install': { policy: 'run', ownerSkillId: 'system-skilled-doctor', scorerRow: true },\n210:   '/doctor:mcp debug': { policy: 'ask', ownerSkillId: 'system-skilled-doctor', scorerRow: true },\n211:   '/doctor:mcp install': { policy: 'ask', ownerSkillId: 'system-skilled-doctor', scorerRow: true },\n212:   '/doctor:overlay apply': { policy: 'ask', ownerSkillId: 'system-skilled-doctor', scorerRow: true },\n213:   '/doctor:overlay repin': { policy: 'ask', ownerSkillId: 'system-skilled-doctor', scorerRow: true },\n214:   '/doctor:overlay status': { policy: 'run', ownerSkillId: 'system-skilled-doctor', scorerRow: true },\n215:   '/doctor:runtime-mirrors': { policy: 'run', ownerSkillId: 'system-skilled-doctor', scorerRow: true },\n216:   '/doctor:setup': { policy: 'run', ownerSkillId: 'system-skilled-doctor', scorerRow: true },\n217:   '/doctor:sk-code quality': { policy: 'ask', ownerSkillId: 'sk-code', scorerRow: true },\n218:   '/doctor:sk-code setup': { policy: 'run', ownerSkillId: 'sk-code', scorerRow: true },\n219:   '/doctor:sk-skill check': { policy: 'run', ownerSkillId: 'sk-doc', scorerRow: true },\n220:   '/doctor:sk-skill convert': { policy: 'ask', ownerSkillId: 'sk-doc', scorerRow: true },\n221:   '/doctor:skill-advisor embedder': { policy: 'ask', ownerSkillId: 'system-skill-advisor', scorerRow: true },\n222:   '/doctor:skill-advisor parent-skill': { policy: 'run', ownerSkillId: 'system-skill-advisor', scorerRow: true },\n223:   '/doctor:skill-advisor rebuild': { policy: 'ask', ownerSkillId: 'system-skill-advisor', scorerRow: true },\n224:   '/doctor:skill-advisor router-reach': { policy: 'run', ownerSkillId: 'system-skill-advisor', scorerRow: true },\n225:   '/doctor:skill-advisor skill-budget': { policy: 'run', ownerSkillId: 'system-skill-advisor', scorerRow: true },\n226:   '/doctor:skill-advisor skill-graph-freshness': { policy: 'run', ownerSkillId: 'system-skill-advisor', scorerRow: true },\n227:   '/doctor:skill-advisor tune': { policy: 'ask', ownerSkillId: 'system-skill-advisor', scorerRow: true },\n228:   '/doctor:speckit': { policy: 'run', ownerSkillId: 'system-skilled-doctor', scorerRow: true },\n229:   '/doctor:symlink check': { policy: 'run', ownerSkillId: 'system-skilled-doctor', scorerRow: true },\n230:   '/doctor:symlink link': { policy: 'ask', ownerSkillId: 'system-skilled-doctor', scorerRow: true },\n231:   '/doctor:symlink unlink': { policy: 'ask', ownerSkillId: 'system-skilled-doctor', scorerRow: true },\n232:   '/doctor:update': { policy: 'ask', ownerSkillId: 'system-skilled-doctor', scorerRow: true },\n233:   '/prompt:improve': { policy: 'start', ownerSkillId: 'sk-prompt', scorerRow: true },\n234:   '/speckit:complete': { policy: 'start', ownerSkillId: 'system-spec-kit', scorerRow: true },\n235:   '/speckit:handoff': { policy: 'ask', ownerSkillId: 'system-spec-kit', scorerRow: true },\n236:   '/speckit:implement': { policy: 'start', ownerSkillId: 'system-spec-kit', scorerRow: true },\n237:   '/speckit:plan': { policy: 'start', ownerSkillId: 'system-spec-kit', scorerRow: true },\n238:   '/speckit:resume': { policy: 'start', ownerSkillId: 'system-spec-kit', scorerRow: true },\n239:   '/speckit:save': { policy: 'start', ownerSkillId: 'system-spec-kit', scorerRow: true },\n240:   '/speckit:search': { policy: 'run', ownerSkillId: 'system-spec-kit', scorerRow: true },\n241: };\n242: // END GENERATED COMMAND ROWS\n243: \n244: // The row for an id a recommendation carries, or undefined when that id names no\n245: // command. Own-key lookup because the table is generated data, so an inherited\n246: // name such as `constructor` must not resolve to a row nobody declared.\n247: export function commandRowFor(id: string): CommandRow | undefined {\n248:   return Object.hasOwn(COMMAND_ROWS, id) ? COMMAND_ROWS[id] : undefined;\n249: }\n250: \n251: // A typed command is the reader's own wording, so it counts only where a command\n252: // can start and where it ends on a boundary. That keeps a path such as\n253: // `docs/create:goal.md` and a prefix such as `/create:sk` from reading as a\n254: // command, and the longest key wins so `/create:skill-parent` is never reduced to\n255: // its `/create:skill` prefix.\n256: const COMMAND_START_BOUNDARY = /[\\s`'\"(]/;\n257: const COMMAND_CONTINUATION = /[a-z0-9_:-]/;\n258: \n259: export function typedCommandIn(prompt: string): string | undefined {\n260:   const lowered = prompt.toLowerCase();\n261:   let found: string | undefined;\n262:   for (const key of Object.keys(TRACKED_COMMANDS)) {\n263:     let index = lowered.indexOf(key);\n264:     while (index !== -1) {\n265:       const before = index === 0 ? '' : lowered[index - 1];\n266:       const after = lowered[index + key.length] ?? '';\n267:       const startsAtBoundary = before === '' || COMMAND_START_BOUNDARY.test(before);\n268:       const endsAtBoundary = after === '' || !COMMAND_CONTINUATION.test(after);\n269:       if (startsAtBoundary && endsAtBoundary) {\n270:         if (found === undefined || key.length > found.length) found = key;\n271:         break;\n272:       }\n273:       index = lowered.indexOf(key, index + 1);\n274:     }\n275:   }\n276:   return found;\n277: }\n278: \n279: // A typed command travels on the recommendation that leads, so it is delivered\n280: // only when the leading skill owns the command or carries the same command row.\n281: // A leading skill unrelated to the command must not carry it.\n282: export interface TypedCommand {\n283:   readonly command: string;\n284:   readonly policy: 'run' | 'start' | 'ask';\n285:   readonly ownerSkillId: string;\n286: }\n287: \n288: export function typedCommandForTop(topSkillId: string, prompt: string): TypedCommand | undefined {\n289:   const command = typedCommandIn(prompt);\n290:   if (command === undefined || !Object.hasOwn(TRACKED_COMMANDS, command)) return undefined;\n291:   const row = TRACKED_COMMANDS[command];\n292:   const sameCommandRow = commandRowFor(topSkillId)?.command === command;\n293:   if (topSkillId !== row.ownerSkillId && !sameCommandRow) return undefined;\n294:   return { command, policy: row.policy, ownerSkillId: row.ownerSkillId };\n295: }\n296: \n297: // Deep-loop commands open a long, multi-pass run, so one attached to a prompt\n298: // that merely mentions the topic spends the reader's budget on work they never\n299: // asked for. The list below is the vocabulary that counts as asking for it, and\n300: // it holds only effort wording: a bare topic word such as `research`, `review`\n301: // or `council` says what to look at, never how far to go, so it never qualifies\n302: // on its own.\n303: //\n304: // The phrases live in a data list, one per line, so the vocabulary a reviewer\n305: // has to judge stays visible and cheap to correct.\n306: export const DEPTH_WORDING: readonly string[] = [\n307:   'in depth',\n308:   'deep dive',\n309:   'deep research',\n310:   'deep review',\n311:   'thorough',\n312:   'thoroughly',\n313:   'exhaustive',\n314:   'iteratively',\n315:   'multiple passes',\n316:   'many passes',\n317:   'several passes',\n318:   'ask the council',\n319:   'convene',\n320:   'several models',\n321:   'final verdict',\n322:   'everything you can',\n323: ];\n324: \n325: // A phrase may carry punctuation a regex would read as a metacharacter, so it is\n326: // escaped before it is trusted as a pattern.\n327: function escapePhrase(phrase: string): string {\n328:   return phrase.replace(/[.*+?^${}()|[\\]\\\\]/g, '\\\\$&');\n329: }\n330: \n331: // One alternation over the list keeps the gate a single test per prompt, and the\n332: // boundary markers keep `thorough` from firing inside a longer word while a\n333: // multi-word phrase still has to match as a whole.\n334: const DEPTH_REQUEST = new RegExp(`\\\\b(?:${DEPTH_WORDING.map(escapePhrase).join('|')})\\\\b`);\n335: \n336: // A compiled route arrives as unvalidated JSON from a separate process, so the\n337: // shape is narrowed here rather than trusted. Arrays count as objects in\n338: // JavaScript and would let `action` read off an unrelated field, so they are\n339: // excluded explicitly.\n340: function asRecord(value: unknown): Record<string, unknown> | undefined {\n341:   if (typeof value !== 'object' || value === null || Array.isArray(value)) return undefined;\n342:   return value as Record<string, unknown>;\n343: }\n344: \n345: // The command for a hub's recommendation, or undefined when the route does not\n346: // single out one mode. Only a single-mode route names a command unambiguously:\n347: // a bundle or a multi-target route has more than one answer, and asking the\n348: // reader to pick belongs to the recommend path, not here. Never throws, because\n349: // a missing command must degrade to \"no command offered\" rather than break\n350: // routing. The prompt decides whether a costly deep-loop command is offered at\n351: // all: a reader who only asks about the topic gets no command, rather than one\n352: // that would launch work they never requested.\n353: export function attachCommand(\n354:   skillId: string,\n355:   compiledRoute: unknown,\n356:   prompt: string,\n357:   modeCommands: Readonly<Record<string, Readonly<Record<string, string>>>> = MODE_COMMANDS,\n358: ): string | undefined {\n359:   const route = asRecord(compiledRoute);\n360:   if (!route) return undefined;\n361:   if (route.action !== 'route' || route.selectionKind !== 'single') return undefined;\n362: \n363:   const targets = route.targets;\n364:   if (!Array.isArray(targets) || targets.length !== 1) return undefined;\n365: \n366:   const onlyTarget = asRecord(targets[0]);\n367:   if (!onlyTarget) return undefined;\n368: \n369:   const workflowMode = onlyTarget.workflowMode;\n370:   if (typeof workflowMode !== 'string' || workflowMode === '') return undefined;\n371: \n372:   // Own-key lookup on both levels: the table is data read from a generated\n373:   // object, so an inherited name such as `constructor` must not resolve to a\n374:   // command the hub never declared.\n375:   if (!Object.prototype.hasOwnProperty.call(modeCommands, skillId)) return undefined;\n376:   const commands = modeCommands[skillId];\n377:   if (!Object.prototype.hasOwnProperty.call(commands, workflowMode)) return undefined;\n378: \n379:   // Deep-loop commands are the ones that commit the reader to a long, multi-pass\n380:   // run, so they are offered only when the prompt asks for that effort. Typing\n381:   // the slash command is itself the ask, and every other hub answers a short\n382:   // question with a short answer, so no other skill consults the wording list.\n383:   if (skillId === 'system-deep-loop') {\n384:     const lowered = prompt.toLowerCase();\n385:     if (!lowered.includes('/deep:') && !DEPTH_REQUEST.test(lowered)) return undefined;\n386:   }\n387: \n388:   return commands[workflowMode];\n389: }"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/lib/command-attach.ts\"}"},"time":{"start":1794540286153,"end":1794540286527}}}}
