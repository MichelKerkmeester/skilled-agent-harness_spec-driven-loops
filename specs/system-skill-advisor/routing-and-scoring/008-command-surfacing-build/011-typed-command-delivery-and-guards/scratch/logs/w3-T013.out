{"type":"tool_use","timestamp":1794540381176,"sessionID":"ses_e2d114b6fffeDMvOBXH8hRDbEL","part":{"partID":"prt_1d2f111ee001C13f5Sx2k2YoFp","sessionID":"ses_e2d114b6fffeDMvOBXH8hRDbEL","messageID":"msg_1d2f0ea0f001EdQCQMGTn5KYE2","type":"tool","id":"call_b5675ef7654e4c9aacd94266","tool":"write","state":{"status":"completed","input":{"path":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/tests/handlers/advisor-recommend-typed-command.vitest.ts","content":"// ───────────────────────────────────────────────────────────────\n// MODULE: Advisor Recommend Typed Command Tests\n// ───────────────────────────────────────────────────────────────\n\nimport { describe, expect, it } from 'vitest';\n\nimport { attachTypedCommand } from '../../handlers/advisor-recommend.js';\nimport type { AdvisorRecommendOutput } from '../../schemas/advisor-tool-schemas.js';\n\ntype Recommendation = AdvisorRecommendOutput['recommendations'][number];\n\nfunction outputWith(recommendations: Recommendation[]): AdvisorRecommendOutput {\n  return {\n    workspaceRoot: '/workspace',\n    effectiveThresholds: {\n      confidenceThreshold: 0.5,\n      uncertaintyThreshold: 0.2,\n      confidenceOnly: false,\n    },\n    recommendations,\n    ambiguous: false,\n    freshness: 'live',\n    trustState: {\n      state: 'live',\n      reason: null,\n      generation: 1,\n      checkedAt: '2026-11-13T00:00:00.000Z',\n      lastLiveAt: '2026-11-13T00:00:00.000Z',\n    },\n    generatedAt: '2026-11-13T00:00:00.000Z',\n    cache: {\n      hit: false,\n      sourceSignaturePresent: true,\n    },\n  };\n}\n\nfunction recommendation(skillId: string, extra: Partial<Recommendation> = {}): Recommendation {\n  return {\n    skillId,\n    score: 0.9,\n    confidence: 0.95,\n    uncertainty: 0.05,\n    dominantLane: 'explicit_author',\n    ...extra,\n  };\n}\n\ndescribe('attachTypedCommand', () => {\n  it('carries a typed command on its owning top recommendation', () => {\n    const output = outputWith([recommendation('system-spec-kit')]);\n\n    const attached = attachTypedCommand(output, '/speckit:resume cache work');\n\n    expect(attached.recommendations[0]).toEqual(expect.objectContaining({\n      skillId: 'system-spec-kit',\n      command: '/speckit:resume',\n      policy: 'start',\n      ownerSkillId: 'system-spec-kit',\n    }));\n  });\n\n  it('replaces a compiled route command with the typed one', () => {\n    const output = outputWith([recommendation('sk-doc', {\n      command: '/create:readme',\n      policy: 'start',\n      ownerSkillId: 'sk-doc',\n    })]);\n\n    const attached = attachTypedCommand(output, '/create:goal retrofit');\n\n    expect(attached.recommendations[0]).toEqual(expect.objectContaining({\n      command: '/create:goal',\n      policy: 'start',\n      ownerSkillId: 'sk-doc',\n    }));\n  });\n\n  it('returns the same output when the top skill does not own the typed command', () => {\n    const output = outputWith([recommendation('mcp-tooling')]);\n\n    expect(attachTypedCommand(output, '/create:goal retrofit')).toBe(output);\n  });\n\n  it('returns the same output when the prompt carries no typed command', () => {\n    const output = outputWith([recommendation('system-spec-kit')]);\n\n    expect(attachTypedCommand(output, 'resume the cached work')).toBe(output);\n  });\n});\n"},"output":"Created file successfully: .skilled/skills/system-skill-advisor/runtime/tests/handlers/advisor-recommend-typed-command.vitest.ts","title":"write","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Created file successfully: .skilled/skills/system-skill-advisor/runtime/tests/handlers/advisor-recommend-typed-command.vitest.ts"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/tests/handlers/advisor-recommend-typed-command.vitest.ts\",\"content\":\"// ───────────────────────────────────────────────────────────────\\n// MODULE: Advisor Recommend Typed Command Tests\\n// ───────────────────────────────────────────────────────────────\\n\\nimport { describe, expect, it } from 'vitest';\\n\\nimport { attachTypedCommand } from '../../handlers/advisor-recommend.js';\\nimport type { AdvisorRecommendOutput } from '../../schemas/advisor-tool-schemas.js';\\n\\ntype Recommendation = AdvisorRecommendOutput['recommendations'][number];\\n\\nfunction outputWith(recommendations: Recommendation[]): AdvisorRecommendOutput {\\n  return {\\n    workspaceRoot: '/workspace',\\n    effectiveThresholds: {\\n      confidenceThreshold: 0.5,\\n      uncertaintyThreshold: 0.2,\\n      confidenceOnly: false,\\n    },\\n    recommendations,\\n    ambiguous: false,\\n    freshness: 'live',\\n    trustState: {\\n      state: 'live',\\n      reason: null,\\n      generation: 1,\\n      checkedAt: '2026-11-13T00:00:00.000Z',\\n      lastLiveAt: '2026-11-13T00:00:00.000Z',\\n    },\\n    generatedAt: '2026-11-13T00:00:00.000Z',\\n    cache: {\\n      hit: false,\\n      sourceSignaturePresent: true,\\n    },\\n  };\\n}\\n\\nfunction recommendation(skillId: string, extra: Partial<Recommendation> = {}): Recommendation {\\n  return {\\n    skillId,\\n    score: 0.9,\\n    confidence: 0.95,\\n    uncertainty: 0.05,\\n    dominantLane: 'explicit_author',\\n    ...extra,\\n  };\\n}\\n\\ndescribe('attachTypedCommand', () => {\\n  it('carries a typed command on its owning top recommendation', () => {\\n    const output = outputWith([recommendation('system-spec-kit')]);\\n\\n    const attached = attachTypedCommand(output, '/speckit:resume cache work');\\n\\n    expect(attached.recommendations[0]).toEqual(expect.objectContaining({\\n      skillId: 'system-spec-kit',\\n      command: '/speckit:resume',\\n      policy: 'start',\\n      ownerSkillId: 'system-spec-kit',\\n    }));\\n  });\\n\\n  it('replaces a compiled route command with the typed one', () => {\\n    const output = outputWith([recommendation('sk-doc', {\\n      command: '/create:readme',\\n      policy: 'start',\\n      ownerSkillId: 'sk-doc',\\n    })]);\\n\\n    const attached = attachTypedCommand(output, '/create:goal retrofit');\\n\\n    expect(attached.recommendations[0]).toEqual(expect.objectContaining({\\n      command: '/create:goal',\\n      policy: 'start',\\n      ownerSkillId: 'sk-doc',\\n    }));\\n  });\\n\\n  it('returns the same output when the top skill does not own the typed command', () => {\\n    const output = outputWith([recommendation('mcp-tooling')]);\\n\\n    expect(attachTypedCommand(output, '/create:goal retrofit')).toBe(output);\\n  });\\n\\n  it('returns the same output when the prompt carries no typed command', () => {\\n    const output = outputWith([recommendation('system-spec-kit')]);\\n\\n    expect(attachTypedCommand(output, 'resume the cached work')).toBe(output);\\n  });\\n});\\n\"}"},"time":{"start":1794540376558,"end":1794540381176}}}}
