   state: 'unavailable',\n85:       reason: 'advisor_unavailable',\n86:     }));\n87:     expect(response.data.warnings).toEqual([\n88:       'advisor_unavailable',\n89:       'database disk image is malformed',\n90:     ]);\n91:     expect(response.data.abstainReasons).toEqual([\n92:       'Skill advisor freshness is unavailable; returning fail-open empty recommendations.',\n93:     ]);\n94:     expect(mockScoreAdvisorPrompt).not.toHaveBeenCalled();\n95:   });\n96: \n97:   it('serves recommendations when unavailable status has usable stale trust state', async () => {\n98:     mockReadAdvisorStatus.mockReturnValue({\n99:       freshness: 'unavailable',\n100:       generation: 7,\n101:       trustState: {\n102:         state: 'stale',\n103:         reason: 'SIGTERM',\n104:         generation: 7,\n105:         checkedAt: '2026-04-28T00:00:00.000Z',\n106:         lastLiveAt: null,\n107:       },\n108:       lastGenerationBump: '2026-04-28T00:00:00.000Z',\n109:       lastScanAt: '2026-04-28T00:00:00.000Z',\n110:       skillCount: 42,\n111:       laneWeights: {\n112:         explicit_author: 0.42,\n113:         lexical: 0.28,\n114:         graph_causal: 0.13,\n115:         derived_generated: 0.12,\n116:         semantic_shadow: 0.05,\n117:       },\n118:     });\n119:     mockScoreAdvisorPrompt.mockReturnValue({\n120:       recommendations: [{\n121:         skill: 'system-spec-kit',\n122:         score: 0.9,\n123:         confidence: 0.95,\n124:         uncertainty: 0.05,\n125:         dominantLane: 'explicit_author',\n126:         laneContributions: [],\n127:         lifecycleStatus: 'active',\n128:       }],\n129:       topSkill: 'system-spec-kit',\n130:       unknown: false,\n131:       ambiguous: false,\n132:       metrics: { candidateCount: 1, liveLaneCount: 5 },\n133:     });\n134: \n135:     const response = parseResponse(await handleAdvisorRecommend({\n136:       prompt: 'Implement a spec folder workflow',\n137:     }));\n138: \n139:     expect(response.status).toBe('ok');\n140:     expect(response.data.freshness).toBe('stale');\n141:     expect(response.data.recommendations).toEqual([\n142:       expect.objectContaining({ skillId: 'system-spec-kit' }),\n143:     ]);\n144:     expect(response.data.warnings).toEqual(['SIGTERM']);\n145:     expect(mockScoreAdvisorPrompt).toHaveBeenCalledWith(\n146:       'Implement a spec folder workflow',\n147:       expect.objectContaining({\n148:         runtimeLaneHealth: {\n149:           graph_causal: {\n150:             status: 'runtime_degraded',\n151:             reason: 'SIGTERM',\n152:           },\n153:         },\n154:       }),\n155:     );\n156:   });\n157: });"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/tests/handlers/advisor-recommend-unavailable.vitest.ts\"}"},"time":{"start":1794540313591,"end":1794540314017}}}}
{"type":"tool_use","timestamp":1794540314026,"sessionID":"ses_e2d114b6fffeDMvOBXH8hRDbEL","part":{"partID":"prt_1d2f01a3d002Q5bYGccYILLk7b","sessionID":"ses_e2d114b6fffeDMvOBXH8hRDbEL","messageID":"msg_1d2f0001c001HhfJ9QvquYMpr2","type":"tool","id":"call_66e1cd7f4b3345a385e45d96","tool":"read","state":{"status":"completed","input":{"path":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/tests/handlers/advisor-recommend-compiled-route-option.vitest.ts"},"output":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/tests/handlers/advisor-recommend-compiled-route-option.vitest.ts, lines 1-166\n1: // ───────────────────────────────────────────────────────────────\n2: // MODULE: Advisor Recommend Compiled-Route Option Tests\n3: // ───────────────────────────────────────────────────────────────\n4: \n5: import { mkdtempSync, rmSync, writeFileSync } from 'node:fs';\n6: import { tmpdir } from 'node:os';\n7: import { join } from 'node:path';\n8: import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';\n9: \n10: const mockedChild = vi.hoisted(() => ({ execFileSync: vi.fn() }));\n11: vi.mock('node:child_process', () => ({ execFileSync: mockedChild.execFileSync }));\n12: \n13: import { frontDoorReadsPromptFromStdin, handleAdvisorRecommend } from '../../handlers/advisor-recommend.js';\n14: import { MODE_COMMANDS } from '../../lib/command-attach.js';\n15: \n16: const COMPILED_ROUTING_FLAG = 'SPECKIT_COMPILED_ROUTING';\n17: const prompt = 'Implement a TypeScript feature with focused tests.';\n18: \n19: type RecommendResponse = Awaited<ReturnType<typeof handleAdvisorRecommend>>;\n20: type ResponsePayload = {\n21:   data?: {\n22:     recommendations?: Array<{ skillId: string; command?: string }>;\n23:     cache?: { hit: boolean };\n24:   };\n25: };\n26: \n27: function responseData(response: RecommendResponse): ResponsePayload {\n28:   return JSON.parse(response.content[0]?.text ?? '{}') as ResponsePayload;\n29: }\n30: \n31: function compiledRouteCallCount(): number {\n32:   return mockedChild.execFileSync.mock.calls.filter(([, args]) => (\n33:     Array.isArray(args)\n34:       && args.some((argument) => (\n35:         typeof argument === 'string' && argument.endsWith('compiled-route.cjs')\n36:       ))\n37:   )).length;\n38: }\n39: \n40: function callsCompiledRoute(): boolean {\n41:   return compiledRouteCallCount() > 0;\n42: }\n43: \n44: describe('advisor_recommend compiled-route option', () => {\n45:   let previousCompiledRoutingFlag: string | undefined;\n46: \n47:   beforeEach(() => {\n48:     previousCompiledRoutingFlag = process.env[COMPILED_ROUTING_FLAG];\n49:     delete process.env[COMPILED_ROUTING_FLAG];\n50:     vi.clearAllMocks();\n51:     mockedChild.execFileSync.mockReturnValue(JSON.stringify({\n52:       action: 'route',\n53:       hubId: 'sk-code',\n54:       targets: ['quality'],\n55:       servingAuthority: 'compiled',\n56:       fingerprint: 'abc123',\n57:       generation: 3,\n58:     }));\n59:   });\n60: \n61:   afterEach(() => {\n62:     if (previousCompiledRoutingFlag === undefined) {\n63:       delete process.env[COMPILED_ROUTING_FLAG];\n64:     } else {\n65:       process.env[COMPILED_ROUTING_FLAG] = previousCompiledRoutingFlag;\n66:     }\n67:   });\n68: \n69:   it('skips compiled-route enrichment on fresh and cached results when requested', async () => {\n70:     const withoutOption = await handleAdvisorRecommend({\n71:       prompt,\n72:       options: { includeAttribution: true },\n73:     });\n74:     expect(responseData(withoutOption).data?.recommendations?.[0]?.skillId).toBe('sk-code');\n75:     expect(callsCompiledRoute()).toBe(true);\n76: \n77:     mockedChild.execFileSync.mockClear();\n78:     const withoutCompiledRoute = await handleAdvisorRecommend({\n79:       prompt,\n80:       options: { includeCompiledRoute: false },\n81:     });\n82:     expect(responseData(withoutCompiledRoute).data?.recommendations?.[0]?.skillId).toBe('sk-code');\n83:     expect(responseData(withoutCompiledRoute).data?.cache?.hit).toBe(false);\n84:     expect(callsCompiledRoute()).toBe(false);\n85: \n86:     const cachedWithoutCompiledRoute = await handleAdvisorRecommend({\n87:       prompt,\n88:       options: { includeCompiledRoute: false },\n89:     });\n90:     expect(responseData(cachedWithoutCompiledRoute).data?.recommendations?.[0]?.skillId).toBe('sk-code');\n91:     expect(responseData(cachedWithoutCompiledRoute).data?.cache?.hit).toBe(true);\n92:     expect(callsCompiledRoute()).toBe(false);\n93:   });\n94: \n95:   it('sends the prompt to the compiled-route front door on stdin, never in argv', async () => {\n96:     await handleAdvisorRecommend({ prompt, options: { includeAttribution: true } });\n97:     const call = mockedChild.execFileSync.mock.calls.find(([, args]) => (\n98:       Array.isArray(args) && args.some((argument) => typeof argument === 'string' && argument.endsWith('compiled-route.cjs'))\n99:     ));\n100:     expect(call).toBeDefined();\n101:     if (!call) return;\n102:     const [, args, options] = call as [string, string[], { input?: string }];\n103:     expect(args).toContain('--prompt-stdin');\n104:     expect(args).not.toContain(prompt);\n105:     expect(options.input).toBe(prompt);\n106:   });\n107: \n108:   it('looks up the route for the first recommendation alone when asked to', async () => {\n109:     const hubPrompt = 'create a new agent for code review';\n110:     await handleAdvisorRecommend({ prompt: hubPrompt, options: { includeCompiledRoute: true } });\n111:     const everyHub = compiledRouteCallCount();\n112:     expect(everyHub, 'the prompt ranks more than one hub').toBeGreaterThan(1);\n113: \n114:     mockedChild.execFileSync.mockClear();\n115:     const topOnly = responseData(await handleAdvisorRecommend({\n116:       prompt: hubPrompt,\n117:       options: { includeCompiledRoute: true, compiledRouteTopOnly: true },\n118:     })).data?.recommendations ?? [];\n119:     expect(compiledRouteCallCount()).toBeLessThanOrEqual(1);\n120:     expect(topOnly.slice(1).every((row) => !('compiledRoute' in row))).toBe(true);\n121:   });\n122: \n123:   it('never offers one command through both its own row and the owning hub', async () => {\n124:     const command = '/create:agent';\n125:     const mode = Object.entries(MODE_COMMANDS['sk-doc']).find(([, value]) => value === command)?.[0];\n126:     expect(mode, 'sk-doc declares a mode for /create:agent').toBeTruthy();\n127:     mockedChild.execFileSync.mockReturnValue(JSON.stringify({\n128:       action: 'route',\n129:       hubId: 'sk-doc',\n130:       selectionKind: 'single',\n131:       targets: [{ workflowMode: mode }],\n132:     }));\n133: \n134:     // The command row ranks beside the hub here, so the hub stays silent.\n135:     const both = responseData(await handleAdvisorRecommend({\n136:       prompt: 'create a new agent for code review',\n137:       options: { includeCompiledRoute: true },\n138:     })).data?.recommendations ?? [];\n139:     expect(both.map((row) => row.skillId)).toContain('create:agent');\n140:     const hubBesideRow = both.find((row) => row.skillId === 'sk-doc');\n141:     expect(hubBesideRow, 'the hub still ranks').toBeDefined();\n142:     expect(hubBesideRow?.command).toBeUndefined();\n143: \n144:     // With no command row in the result the same route does carry the command,\n145:     // which is what proves the silence above came from the collision.\n146:     const hubOnly = responseData(await handleAdvisorRecommend({\n147:       prompt: 'Write a README for the payments module',\n148:       options: { includeCompiledRoute: true },\n149:     })).data?.recommendations ?? [];\n150:     expect(hubOnly.map((row) => row.skillId)).not.toContain('create:agent');\n151:     expect(hubOnly.find((row) => row.skillId === 'sk-doc')?.command).toBe(command);\n152:   });\n153: \n154:   it('recognizes only a front door that reads the prompt from stdin', () => {\n155:     const dir = mkdtempSync(join(tmpdir(), 'front-door-'));\n156:     try {\n157:       writeFileSync(join(dir, 'current.cjs'), \"const promptFromStdin = args.includes('--prompt-stdin');\\n\");\n158:       writeFileSync(join(dir, 'older.cjs'), \"const promptIdx = args.indexOf('--prompt');\\n\");\n159:       expect(frontDoorReadsPromptFromStdin(join(dir, 'current.cjs'))).toBe(true);\n160:       expect(frontDoorReadsPromptFromStdin(join(dir, 'older.cjs'))).toBe(false);\n161:       expect(frontDoorReadsPromptFromStdin(join(dir, 'missing.cjs'))).toBe(false);\n162:     } finally {\n163:       rmSync(dir, { recursive: true, force: true });\n164:     }\n165:   });\n166: });","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/tests/handlers/advisor-recommend-compiled-route-option.vitest.ts, lines 1-166\n1: // ───────────────────────────────────────────────────────────────\n2: // MODULE: Advisor Recommend Compiled-Route Option Tests\n3: // ───────────────────────────────────────────────────────────────\n4: \n5: import { mkdtempSync, rmSync, writeFileSync } from 'node:fs';\n6: import { tmpdir } from 'node:os';\n7: import { join } from 'node:path';\n8: import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';\n9: \n10: const mockedChild = vi.hoisted(() => ({ execFileSync: vi.fn() }));\n11: vi.mock('node:child_process', () => ({ execFileSync: mockedChild.execFileSync }));\n12: \n13: import { frontDoorReadsPromptFromStdin, handleAdvisorRecommend } from '../../handlers/advisor-recommend.js';\n14: import { MODE_COMMANDS } from '../../lib/command-attach.js';\n15: \n16: const COMPILED_ROUTING_FLAG = 'SPECKIT_COMPILED_ROUTING';\n17: const prompt = 'Implement a TypeScript feature with focused tests.';\n18: \n19: type RecommendResponse = Awaited<ReturnType<typeof handleAdvisorRecommend>>;\n20: type ResponsePayload = {\n21:   data?: {\n22:     recommendations?: Array<{ skillId: string; command?: string }>;\n23:     cache?: { hit: boolean };\n24:   };\n25: };\n26: \n27: function responseData(response: RecommendResponse): ResponsePayload {\n28:   return JSON.parse(response.content[0]?.text ?? '{}') as ResponsePayload;\n29: }\n30: \n31: function compiledRouteCallCount(): number {\n32:   return mockedChild.execFileSync.mock.calls.filter(([, args]) => (\n33:     Array.isArray(args)\n34:       && args.some((argument) => (\n35:         typeof argument === 'string' && argument.endsWith('compiled-route.cjs')\n36:       ))\n37:   )).length;\n38: }\n39: \n40: function callsCompiledRoute(): boolean {\n41:   return compiledRouteCallCount() > 0;\n42: }\n43: \n44: describe('advisor_recommend compiled-route option', () => {\n45:   let previousCompiledRoutingFlag: string | undefined;\n46: \n47:   beforeEach(() => {\n48:     previousCompiledRoutingFlag = process.env[COMPILED_ROUTING_FLAG];\n49:     delete process.env[COMPILED_ROUTING_FLAG];\n50:     vi.clearAllMocks();\n51:     mockedChild.execFileSync.mockReturnValue(JSON.stringify({\n52:       action: 'route',\n53:       hubId: 'sk-code',\n54:       targets: ['quality'],\n55:       servingAuthority: 'compiled',\n56:       fingerprint: 'abc123',\n57:       generation: 3,\n58:     }));\n59:   });\n60: \n61:   afterEach(() => {\n62:     if (previousCompiledRoutingFlag === undefined) {\n63:       delete process.env[COMPILED_ROUTING_FLAG];\n64:     } else {\n65:       process.env[COMPILED_ROUTING_FLAG] = previousCompiledRoutingFlag;\n66:     }\n67:   });\n68: \n69:   it('skips compiled-route enrichment on fresh and cached results when requested', async () => {\n70:     const withoutOption = await handleAdvisorRecommend({\n71:       prompt,\n72:       options: { includeAttribution: true },\n73:     });\n74:     expect(responseData(withoutOption).data?.recommendations?.[0]?.skillId).toBe('sk-code');\n75:     expect(callsCompiledRoute()).toBe(true);\n76: \n77:     mockedChild.execFileSync.mockClear();\n78:     const withoutCompiledRoute = await handleAdvisorRecommend({\n79:       prompt,\n80:       options: { includeCompiledRoute: false },\n81:     });\n82:     expect(responseData(withoutCompiledRoute).data?.recommendations?.[0]?.skillId).toBe('sk-code');\n83:     expect(responseData(withoutCompiledRoute).data?.cache?.hit).toBe(false);\n84:     expect(callsCompiledRoute()).toBe(false);\n85: \n86:     const cachedWithoutCompiledRoute = await handleAdvisorRecommend({\n87:       prompt,\n88:       options: { includeCompiledRoute: false },\n89:     });\n90:     expect(responseData(cachedWithoutCompiledRoute).data?.recommendations?.[0]?.skillId).toBe('sk-code');\n91:     expect(responseData(cachedWithoutCompiledRoute).data?.cache?.hit).toBe(true);\n92:     expect(callsCompiledRoute()).toBe(false);\n93:   });\n94: \n95:   it('sends the prompt to the compiled-route front door on stdin, never in argv', async () => {\n96:     await handleAdvisorRecommend({ prompt, options: { includeAttribution: true } });\n97:     const call = mockedChild.execFileSync.mock.calls.find(([, args]) => (\n98:       Array.isArray(args) && args.some((argument) => typeof argument === 'string' && argument.endsWith('compiled-route.cjs'))\n99:     ));\n100:     expect(call).toBeDefined();\n101:     if (!call) return;\n102:     const [, args, options] = call as [string, string[], { input?: string }];\n103:     expect(args).toContain('--prompt-stdin');\n104:     expect(args).not.toContain(prompt);\n105:     expect(options.input).toBe(prompt);\n106:   });\n107: \n108:   it('looks up the route for the first recommendation alone when asked to', async () => {\n109:     const hubPrompt = 'create a new agent for code review';\n110:     await handleAdvisorRecommend({ prompt: hubPrompt, options: { includeCompiledRoute: true } });\n111:     const everyHub = compiledRouteCallCount();\n112:     expect(everyHub, 'the prompt ranks more than one hub').toBeGreaterThan(1);\n113: \n114:     mockedChild.execFileSync.mockClear();\n115:     const topOnly = responseData(await handleAdvisorRecommend({\n116:       prompt: hubPrompt,\n117:       options: { includeCompiledRoute: true, compiledRouteTopOnly: true },\n118:     })).data?.recommendations ?? [];\n119:     expect(compiledRouteCallCount()).toBeLessThanOrEqual(1);\n120:     expect(topOnly.slice(1).every((row) => !('compiledRoute' in row))).toBe(true);\n121:   });\n122: \n123:   it('never offers one command through both its own row and the owning hub', async () => {\n124:     const command = '/create:agent';\n125:     const mode = Object.entries(MODE_COMMANDS['sk-doc']).find(([, value]) => value === command)?.[0];\n126:     expect(mode, 'sk-doc declares a mode for /create:agent').toBeTruthy();\n127:     mockedChild.execFileSync.mockReturnValue(JSON.stringify({\n128:       action: 'route',\n129:       hubId: 'sk-doc',\n130:       selectionKind: 'single',\n131:       targets: [{ workflowMode: mode }],\n132:     }));\n133: \n134:     // The command row ranks beside the hub here, so the hub stays silent.\n135:     const both = responseData(await handleAdvisorRecommend({\n136:       prompt: 'create a new agent for code review',\n137:       options: { includeCompiledRoute: true },\n138:     })).data?.recommendations ?? [];\n139:     expect(both.map((row) => row.skillId)).toContain('create:agent');\n140:     const hubBesideRow = both.find((row) => row.skillId === 'sk-doc');\n141:     expect(hubBesideRow, 'the hub still ranks').toBeDefined();\n142:     expect(hubBesideRow?.command).toBeUndefined();\n143: \n144:     // With no command row in the result the same route does carry the command,\n145:     // which is what proves the silence above came from the collision.\n146:     const hubOnly = responseData(await handleAdvisorRecommend({\n147:       prompt: 'Write a README for the payments module',\n148:       options: { includeCompiledRoute: true },\n149:     })).data?.recommendations ?? [];\n150:     expect(hubOnly.map((row) => row.skillId)).not.toContain('create:agent');\n151:     expect(hubOnly.find((row) => row.skillId === 'sk-doc')?.command).toBe(command);\n152:   });\n153: \n154:   it('recognizes only a front door that reads the prompt from stdin', () => {\n155:     const dir = mkdtempSync(join(tmpdir(), 'front-door-'));\n156:     try {\n157:       writeFileSync(join(dir, 'current.cjs'), \"const promptFromStdin = args.includes('--prompt-stdin');\\n\");\n158:       writeFileSync(join(dir, 'older.cjs'), \"const promptIdx = args.indexOf('--prompt');\\n\");\n159:       expect(frontDoorReadsPromptFromStdin(join(dir, 'current.cjs'))).toBe(true);\n160:       expect(frontDoorReadsPromptFromStdin(join(dir, 'older.cjs'))).toBe(false);\n161:       expect(frontDoorReadsPromptFromStdin(join(dir, 'missing.cjs'))).toBe(false);\n162:     } finally {\n163:       rmSync(dir, { recursive: true, force: true });\n164:     }\n165:   });\n166: });"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/tests/handlers/advisor-recommend-compiled-route-option.vitest.ts\"}"},"time":{"start":1794540313149,"end":1794540314026}}}}
