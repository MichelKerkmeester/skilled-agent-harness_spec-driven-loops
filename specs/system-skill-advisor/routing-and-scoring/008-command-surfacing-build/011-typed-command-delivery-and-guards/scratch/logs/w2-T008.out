/doctor:agents-md embed': { policy: 'ask', ownerSkillId: 'system-skilled-doctor', scorerRow: true },\n199:   '/doctor:agents-md restore': { policy: 'ask', ownerSkillId: 'system-skilled-doctor', scorerRow: true },\n200:   '/doctor:ci report': { policy: 'run', ownerSkillId: 'sk-code', scorerRow: true },\n201:   '/doctor:ci scaffold': { policy: 'ask', ownerSkillId: 'sk-code', scorerRow: true },\n202:   '/doctor:ci toggle': { policy: 'ask', ownerSkillId: 'sk-code', scorerRow: true },\n203:   '/doctor:deep-loop': { policy: 'run', ownerSkillId: 'system-deep-loop', scorerRow: true },\n204:   '/doctor:env list': { policy: 'run', ownerSkillId: 'system-skilled-doctor', scorerRow: true },\n205:   '/doctor:git hooks': { policy: 'ask', ownerSkillId: 'sk-git', scorerRow: true },\n206:   '/doctor:git setup': { policy: 'run', ownerSkillId: 'sk-git', scorerRow: true },\n207:   '/doctor:git standards': { policy: 'ask', ownerSkillId: 'sk-git', scorerRow: true },\n208:   '/doctor:helper': { policy: 'run', ownerSkillId: 'system-skilled-doctor', scorerRow: true },\n209:   '/doctor:install': { policy: 'run', ownerSkillId: 'system-skilled-doctor', scorerRow: true },\n210:   '/doctor:mcp debug': { policy: 'ask', ownerSkillId: 'system-skilled-doctor', scorerRow: true },\n211:   '/doctor:mcp install': { policy: 'ask', ownerSkillId: 'system-skilled-doctor', scorerRow: true },\n212:   '/doctor:overlay apply': { policy: 'ask', ownerSkillId: 'system-skilled-doctor', scorerRow: true },\n213:   '/doctor:overlay repin': { policy: 'ask', ownerSkillId: 'system-skilled-doctor', scorerRow: true },\n214:   '/doctor:overlay status': { policy: 'run', ownerSkillId: 'system-skilled-doctor', scorerRow: true },\n215:   '/doctor:runtime-mirrors': { policy: 'run', ownerSkillId: 'system-skilled-doctor', scorerRow: true },\n216:   '/doctor:setup': { policy: 'run', ownerSkillId: 'system-skilled-doctor', scorerRow: true },\n217:   '/doctor:sk-code quality': { policy: 'ask', ownerSkillId: 'sk-code', scorerRow: true },\n218:   '/doctor:sk-code setup': { policy: 'run', ownerSkillId: 'sk-code', scorerRow: true },\n219:   '/doctor:sk-skill check': { policy: 'run', ownerSkillId: 'sk-doc', scorerRow: true },\n220:   '/doctor:sk-skill convert': { policy: 'ask', ownerSkillId: 'sk-doc', scorerRow: true },\n221:   '/doctor:skill-advisor embedder': { policy: 'ask', ownerSkillId: 'system-skill-advisor', scorerRow: true },\n222:   '/doctor:skill-advisor parent-skill': { policy: 'run', ownerSkillId: 'system-skill-advisor', scorerRow: true },\n223:   '/doctor:skill-advisor rebuild': { policy: 'ask', ownerSkillId: 'system-skill-advisor', scorerRow: true },\n224:   '/doctor:skill-advisor router-reach': { policy: 'run', ownerSkillId: 'system-skill-advisor', scorerRow: true },\n225:   '/doctor:skill-advisor skill-budget': { policy: 'run', ownerSkillId: 'system-skill-advisor', scorerRow: true },\n226:   '/doctor:skill-advisor skill-graph-freshness': { policy: 'run', ownerSkillId: 'system-skill-advisor', scorerRow: true },\n227:   '/doctor:skill-advisor tune': { policy: 'ask', ownerSkillId: 'system-skill-advisor', scorerRow: true },\n228:   '/doctor:speckit': { policy: 'run', ownerSkillId: 'system-skilled-doctor', scorerRow: true },\n229:   '/doctor:symlink check': { policy: 'run', ownerSkillId: 'system-skilled-doctor', scorerRow: true },\n230:   '/doctor:symlink link': { policy: 'ask', ownerSkillId: 'system-skilled-doctor', scorerRow: true },\n231:   '/doctor:symlink unlink': { policy: 'ask', ownerSkillId: 'system-skilled-doctor', scorerRow: true },\n232:   '/doctor:update': { policy: 'ask', ownerSkillId: 'system-skilled-doctor', scorerRow: true },\n233:   '/prompt:improve': { policy: 'start', ownerSkillId: 'sk-prompt', scorerRow: true },\n234:   '/speckit:complete': { policy: 'start', ownerSkillId: 'system-spec-kit', scorerRow: true },\n235:   '/speckit:handoff': { policy: 'ask', ownerSkillId: 'system-spec-kit', scorerRow: true },\n236:   '/speckit:implement': { policy: 'start', ownerSkillId: 'system-spec-kit', scorerRow: true },\n237:   '/speckit:plan': { policy: 'start', ownerSkillId: 'system-spec-kit', scorerRow: true },\n238:   '/speckit:resume': { policy: 'start', ownerSkillId: 'system-spec-kit', scorerRow: true },\n239:   '/speckit:save': { policy: 'start', ownerSkillId: 'system-spec-kit', scorerRow: true },\n240:   '/speckit:search': { policy: 'run', ownerSkillId: 'system-spec-kit', scorerRow: true },\n241: };\n242: // END GENERATED COMMAND ROWS\n243: \n244: // The row for an id a recommendation carries, or undefined when that id names no\n245: // command. Own-key lookup because the table is generated data, so an inherited\n246: // name such as `constructor` must not resolve to a row nobody declared.\n247: export function commandRowFor(id: string): CommandRow | undefined {\n248:   return Object.hasOwn(COMMAND_ROWS, id) ? COMMAND_ROWS[id] : undefined;\n249: }\n250: \n251: // Deep-loop commands open a long, multi-pass run, so one attached to a prompt\n252: // that merely mentions the topic spends the reader's budget on work they never\n253: // asked for. The list below is the vocabulary that counts as asking for it, and\n254: // it holds only effort wording: a bare topic word such as `research`, `review`\n255: // or `council` says what to look at, never how far to go, so it never qualifies\n256: // on its own.\n257: //\n258: // The phrases live in a data list, one per line, so the vocabulary a reviewer\n259: // has to judge stays visible and cheap to correct.\n260: export const DEPTH_WORDING: readonly string[] = [\n261:   'in depth',\n262:   'deep dive',\n263:   'deep research',\n264:   'deep review',\n265:   'thorough',\n266:   'thoroughly',\n267:   'exhaustive',\n268:   'iteratively',\n269:   'multiple passes',\n270:   'many passes',\n271:   'several passes',\n272:   'ask the council',\n273:   'convene',\n274:   'several models',\n275:   'final verdict',\n276:   'everything you can',\n277: ];\n278: \n279: // A phrase may carry punctuation a regex would read as a metacharacter, so it is\n280: // escaped before it is trusted as a pattern.\n281: function escapePhrase(phrase: string): string {\n282:   return phrase.replace(/[.*+?^${}()|[\\]\\\\]/g, '\\\\$&');\n283: }\n284: \n285: // One alternation over the list keeps the gate a single test per prompt, and the\n286: // boundary markers keep `thorough` from firing inside a longer word while a\n287: // multi-word phrase still has to match as a whole.\n288: const DEPTH_REQUEST = new RegExp(`\\\\b(?:${DEPTH_WORDING.map(escapePhrase).join('|')})\\\\b`);\n289: \n290: // A compiled route arrives as unvalidated JSON from a separate process, so the\n291: // shape is narrowed here rather than trusted. Arrays count as objects in\n292: // JavaScript and would let `action` read off an unrelated field, so they are\n293: // excluded explicitly.\n294: function asRecord(value: unknown): Record<string, unknown> | undefined {\n295:   if (typeof value !== 'object' || value === null || Array.isArray(value)) return undefined;\n296:   return value as Record<string, unknown>;\n297: }\n298: \n299: // The command for a hub's recommendation, or undefined when the route does not\n300: // single out one mode. Only a single-mode route names a command unambiguously:\n301: // a bundle or a multi-target route has more than one answer, and asking the\n302: // reader to pick belongs to the recommend path, not here. Never throws, because\n303: // a missing command must degrade to \"no command offered\" rather than break\n304: // routing. The prompt decides whether a costly deep-loop command is offered at\n305: // all: a reader who only asks about the topic gets no command, rather than one\n306: // that would launch work they never requested.\n307: export function attachCommand(\n308:   skillId: string,\n309:   compiledRoute: unknown,\n310:   prompt: string,\n311:   modeCommands: Readonly<Record<string, Readonly<Record<string, string>>>> = MODE_COMMANDS,\n312: ): string | undefined {\n313:   const route = asRecord(compiledRoute);\n314:   if (!route) return undefined;\n315:   if (route.action !== 'route' || route.selectionKind !== 'single') return undefined;\n316: \n317:   const targets = route.targets;\n318:   if (!Array.isArray(targets) || targets.length !== 1) return undefined;\n319: \n320:   const onlyTarget = asRecord(targets[0]);\n321:   if (!onlyTarget) return undefined;\n322: \n323:   const workflowMode = onlyTarget.workflowMode;\n324:   if (typeof workflowMode !== 'string' || workflowMode === '') return undefined;\n325: \n326:   // Own-key lookup on both levels: the table is data read from a generated\n327:   // object, so an inherited name such as `constructor` must not resolve to a\n328:   // command the hub never declared.\n329:   if (!Object.prototype.hasOwnProperty.call(modeCommands, skillId)) return undefined;\n330:   const commands = modeCommands[skillId];\n331:   if (!Object.prototype.hasOwnProperty.call(commands, workflowMode)) return undefined;\n332: \n333:   // Deep-loop commands are the ones that commit the reader to a long, multi-pass\n334:   // run, so they are offered only when the prompt asks for that effort. Typing\n335:   // the slash command is itself the ask, and every other hub answers a short\n336:   // question with a short answer, so no other skill consults the wording list.\n337:   if (skillId === 'system-deep-loop') {\n338:     const lowered = prompt.toLowerCase();\n339:     if (!lowered.includes('/deep:') && !DEPTH_REQUEST.test(lowered)) return undefined;\n340:   }\n341: \n342:   return commands[workflowMode];\n343: }","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/lib/command-attach.ts, lines 1-343\n1: // ───────────────────────────────────────────────────────────────\n2: // MODULE: Slash command attached to a hub's recommendation\n3: // ───────────────────────────────────────────────────────────────\n4: //\n5: // The advisor can name the workflow mode a hub would route a prompt to, but the\n6: // reader still has to translate that mode into the slash command that acts on\n7: // it. This module owns that translation and nothing else, kept free of imports\n8: // so the recommend path and a test read the same semantics.\n9: //\n10: // The mode-to-command table is generated rather than hand-maintained: each row is\n11: // derived from a hub's own command files, so a hub that adds or renames a mode\n12: // regenerates its row instead of drifting from a copy someone forgot to update.\n13: \n14: // BEGIN GENERATED MODE COMMANDS\n15: export const MODE_COMMANDS: Readonly<Record<string, Readonly<Record<string, string>>>> = {\n16:   'sk-design': {\n17:     'sk-design-chart': '/design:chart',\n18:     'sk-design-diagram': '/design:diagram',\n19:     'sk-design-md-generator': '/design:extract',\n20:   },\n21:   'sk-doc': {\n22:     'sk-create-agent': '/create:agent',\n23:     'sk-create-benchmark': '/create:benchmark',\n24:     'sk-create-changelog': '/create:changelog',\n25:     'sk-create-command': '/create:command',\n26:     'sk-create-diff': '/create:diff',\n27:     'sk-create-feature-catalog': '/create:feature-catalog',\n28:     'sk-create-goal': '/create:goal',\n29:     'sk-create-manual-testing-playbook': '/create:manual-testing-playbook',\n30:     'sk-create-readme': '/create:readme',\n31:     'sk-create-repo-rule': '/create:repo-rule',\n32:     'sk-create-skill': '/create:skill',\n33:     'sk-create-skill-parent': '/create:skill-parent',\n34:     'sk-create-with-human-voice': '/create:with-human-voice',\n35:   },\n36:   'system-deep-loop': {\n37:     'ai-council': '/deep:ai-council',\n38:     'research': '/deep:research',\n39:     'review': '/deep:review',\n40:   },\n41: };\n42: // END GENERATED MODE COMMANDS\n43: \n44: // One row of the command table: the runnable slash command, the policy that says\n45: // whether it runs, asks or starts a session, the class that says what the run\n46: // writes, and the skill that owns it. The rows are generated, so only the shape\n47: // lives here.\n48: export interface CommandRow {\n49:   readonly command: string;\n50:   readonly policy?: 'run' | 'start' | 'ask';\n51:   readonly mutating?: 'read-only' | 'add-only' | 'mutates';\n52:   readonly ownerSkillId: string;\n53: }\n54: \n55: // The table below covers every tracked command, whether or not its bridge is\n56: // active, so a typed command always has a policy and an owner. `scorerRow` says\n57: // whether a scorer can also return the command on its own.\n58: export interface TrackedCommand {\n59:   readonly policy: 'run' | 'start' | 'ask';\n60:   readonly ownerSkillId: string;\n61:   readonly scorerRow: boolean;\n62: }\n63: \n64: // BEGIN GENERATED COMMAND ROWS\n65: export const COMMAND_ROWS: Readonly<Record<string, CommandRow>> = {\n66:   'command-create-agent': { command: '/create:agent', policy: 'start', mutating: 'mutates', ownerSkillId: 'sk-doc' },\n67:   'command-create-changelog': { command: '/create:changelog', policy: 'ask', mutating: 'mutates', ownerSkillId: 'sk-doc' },\n68:   'command-create-feature-catalog': { command: '/create:feature-catalog', policy: 'start', mutating: 'mutates', ownerSkillId: 'sk-doc' },\n69:   'command-create-manual-testing-playbook': { command: '/create:manual-testing-playbook', policy: 'start', mutating: 'mutates', ownerSkillId: 'sk-doc' },\n70:   'command-create-readme': { command: '/create:readme', policy: 'start', mutating: 'mutates', ownerSkillId: 'sk-doc' },\n71:   'command-create-skill': { command: '/create:skill', policy: 'start', mutating: 'mutates', ownerSkillId: 'sk-doc' },\n72:   'command-deep-research': { command: '/deep:research', policy: 'ask', mutating: 'mutates', ownerSkillId: 'system-deep-loop' },\n73:   'command-deep-review': { command: '/deep:review', policy: 'ask', mutating: 'mutates', ownerSkillId: 'system-deep-loop' },\n74:   'command-doctor-agents-md-check': { command: '/doctor:agents-md check', policy: 'run', mutating: 'read-only', ownerSkillId: 'system-skilled-doctor' },\n75:   'command-doctor-agents-md-embed': { command: '/doctor:agents-md embed', policy: 'ask', mutating: 'mutates', ownerSkillId: 'system-skilled-doctor' },\n76:   'command-doctor-agents-md-restore': { command: '/doctor:agents-md restore', policy: 'ask', mutating: 'mutates', ownerSkillId: 'system-skilled-doctor' },\n77:   'command-doctor-ci-report': { command: '/doctor:ci report', policy: 'run', mutating: 'read-only', ownerSkillId: 'sk-code' },\n78:   'command-doctor-ci-scaffold': { command: '/doctor:ci scaffold', policy: 'ask', mutating: 'mutates', ownerSkillId: 'sk-code' },\n79:   'command-doctor-ci-toggle': { command: '/doctor:ci toggle', policy: 'ask', mutating: 'mutates', ownerSkillId: 'sk-code' },\n80:   'command-doctor-deep-loop': { command: '/doctor:deep-loop', policy: 'run', mutating: 'add-only', ownerSkillId: 'system-deep-loop' },\n81:   'command-doctor-env': { command: '/doctor:env list', policy: 'run', mutating: 'read-only', ownerSkillId: 'system-skilled-doctor' },\n82:   'command-doctor-git-hooks': { command: '/doctor:git hooks', policy: 'ask', mutating: 'mutates', ownerSkillId: 'sk-git' },\n83:   'command-doctor-git-setup': { command: '/doctor:git setup', policy: 'run', mutating: 'read-only', ownerSkillId: 'sk-git' },\n84:   'command-doctor-git-standards': { command: '/doctor:git standards', policy: 'ask', mutating: 'mutates', ownerSkillId: 'sk-git' },\n85:   'command-doctor-helper': { command: '/doctor:helper', policy: 'run', mutating: 'read-only', ownerSkillId: 'system-skilled-doctor' },\n86:   'command-doctor-install': { command: '/doctor:install', policy: 'run', mutating: 'read-only', ownerSkillId: 'system-skilled-doctor' },\n87:   'command-doctor-mcp-debug': { command: '/doctor:mcp debug', policy: 'ask', mutating: 'mutates', ownerSkillId: 'system-skilled-doctor' },\n88:   'command-doctor-mcp-install': { command: '/doctor:mcp install', policy: 'ask', mutating: 'mutates', ownerSkillId: 'system-skilled-doctor' },\n89:   'command-doctor-overlay-apply': { command: '/doctor:overlay apply', policy: 'ask', mutating: 'mutates', ownerSkillId: 'system-skilled-doctor' },\n90:   'command-doctor-overlay-repin': { command: '/doctor:overlay repin', policy: 'ask', mutating: 'mutates', ownerSkillId: 'system-skilled-doctor' },\n91:   'command-doctor-overlay-status': { command: '/doctor:overlay status', policy: 'run', mutating: 'read-only', ownerSkillId: 'system-skilled-doctor' },\n92:   'command-doctor-runtime-mirrors': { command: '/doctor:runtime-mirrors', policy: 'run', mutating: 'read-only', ownerSkillId: 'system-skilled-doctor' },\n93:   'command-doctor-setup': { command: '/doctor:setup', policy: 'run', mutating: 'read-only', ownerSkillId: 'system-skilled-doctor' },\n94:   'command-doctor-sk-code-quality': { command: '/doctor:sk-code quality', policy: 'ask', mutating: 'mutates', ownerSkillId: 'sk-code' },\n95:   'command-doctor-sk-code-setup': { command: '/doctor:sk-code setup', policy: 'run', mutating: 'read-only', ownerSkillId: 'sk-code' },\n96:   'command-doctor-sk-skill-check': { command: '/doctor:sk-skill check', policy: 'run', mutating: 'read-only', ownerSkillId: 'sk-doc' },\n97:   'command-doctor-sk-skill-convert': { command: '/doctor:sk-skill convert', policy: 'ask', mutating: 'mutates', ownerSkillId: 'sk-doc' },\n98:   'command-doctor-skill-advisor-embedder': { command: '/doctor:skill-advisor embedder', policy: 'ask', mutating: 'mutates', ownerSkillId: 'system-skill-advisor' },\n99:   'command-doctor-skill-advisor-parent-skill': { command: '/doctor:skill-advisor parent-skill', policy: 'run', mutating: 'read-only', ownerSkillId: 'system-skill-advisor' },\n100:   'command-doctor-skill-advisor-rebuild': { command: '/doctor:skill-advisor rebuild', policy: 'ask', mutating: 'mutates', ownerSkillId: 'system-skill-advisor' },\n101:   'command-doctor-skill-advisor-router-reach': { command: '/doctor:skill-advisor router-reach', policy: 'run', mutating: 'read-only', ownerSkillId: 'system-skill-advisor' },\n102:   'command-doctor-skill-advisor-skill-budget': { command: '/doctor:skill-advisor skill-budget', policy: 'run', mutating: 'read-only', ownerSkillId: 'system-skill-advisor' },\n103:   'command-doctor-skill-advisor-skill-graph-freshness': { command: '/doctor:skill-advisor skill-graph-freshness', policy: 'run', mutating: 'read-only', ownerSkillId: 'system-skill-advisor' },\n104:   'command-doctor-skill-advisor-tune': { command: '/doctor:skill-advisor tune', policy: 'ask', mutating: 'mutates', ownerSkillId: 'system-skill-advisor' },\n105:   'command-doctor-speckit': { command: '/doctor:speckit', policy: 'run', mutating: 'add-only', ownerSkillId: 'system-skilled-doctor' },\n106:   'command-doctor-symlink-check': { command: '/doctor:symlink check', policy: 'run', mutating: 'read-only', ownerSkillId: 'system-skilled-doctor' },\n107:   'command-doctor-symlink-link': { command: '/doctor:symlink link', policy: 'ask', mutating: 'mutates', ownerSkillId: 'system-skilled-doctor' },\n108:   'command-doctor-symlink-unlink': { command: '/doctor:symlink unlink', policy: 'ask', mutating: 'mutates', ownerSkillId: 'system-skilled-doctor' },\n109:   'command-doctor-update': { command: '/doctor:update', policy: 'ask', mutating: 'mutates', ownerSkillId: 'system-skilled-doctor' },\n110:   'command-prompt-improve': { command: '/prompt:improve', policy: 'start', mutating: 'mutates', ownerSkillId: 'sk-prompt' },\n111:   'command-spec-kit-deep-research': { command: '/deep:research', policy: 'ask', mutating: 'mutates', ownerSkillId: 'system-deep-loop' },\n112:   'command-spec-kit-deep-review': { command: '/deep:review', policy: 'ask', mutating: 'mutates', ownerSkillId: 'system-deep-loop' },\n113:   'command-speckit-complete': { command: '/speckit:complete', policy: 'start', mutating: 'mutates', ownerSkillId: 'system-spec-kit' },\n114:   'command-speckit-handoff': { command: '/speckit:handoff', policy: 'ask', mutating: 'mutates', ownerSkillId: 'system-spec-kit' },\n115:   'command-speckit-implement': { command: '/speckit:implement', policy: 'start', mutating: 'mutates', ownerSkillId: 'system-spec-kit' },\n116:   'command-speckit-plan': { command: '/speckit:plan', policy: 'start', mutating: 'mutates', ownerSkillId: 'system-spec-kit' },\n117:   'command-speckit-resume': { command: '/speckit:resume', policy: 'start', mutating: 'mutates', ownerSkillId: 'system-spec-kit' },\n118:   'command-speckit-save': { command: '/speckit:save', policy: 'start', mutating: 'mutates', ownerSkillId: 'system-spec-kit' },\n119:   'command-speckit-search': { command: '/speckit:search', policy: 'run', mutating: 'read-only', ownerSkillId: 'system-spec-kit' },\n120:   'create:agent': { command: '/create:agent', policy: 'start', mutating: 'mutates', ownerSkillId: 'sk-doc' },\n121:   'create:manual-testing-playbook': { command: '/create:manual-testing-playbook', policy: 'start', mutating: 'mutates', ownerSkillId: 'sk-doc' },\n122: };\n123: export const COMMAND_POLICIES: Readonly<Record<string, 'run' | 'start' | 'ask'>> = {\n124:   '/create:agent': 'start',\n125:   '/create:changelog': 'ask',\n126:   '/create:feature-catalog': 'start',\n127:   '/create:manual-testing-playbook': 'start',\n128:   '/create:readme': 'start',\n129:   '/create:skill': 'start',\n130:   '/deep:research': 'ask',\n131:   '/deep:review': 'ask',\n132:   '/doctor:agents-md check': 'run',\n133:   '/doctor:agents-md embed': 'ask',\n134:   '/doctor:agents-md restore': 'ask',\n135:   '/doctor:ci report': 'run',\n136:   '/doctor:ci scaffold': 'ask',\n137:   '/doctor:ci toggle': 'ask',\n138:   '/doctor:deep-loop': 'run',\n139:   '/doctor:env list': 'run',\n140:   '/doctor:git hooks': 'ask',\n141:   '/doctor:git setup': 'run',\n142:   '/doctor:git standards': 'ask',\n143:   '/doctor:helper': 'run',\n144:   '/doctor:install': 'run',\n145:   '/doctor:mcp debug': 'ask',\n146:   '/doctor:mcp install': 'ask',\n147:   '/doctor:overlay apply': 'ask',\n148:   '/doctor:overlay repin': 'ask',\n149:   '/doctor:overlay status': 'run',\n150:   '/doctor:runtime-mirrors': 'run',\n151:   '/doctor:setup': 'run',\n152:   '/doctor:sk-code quality': 'ask',\n153:   '/doctor:sk-code setup': 'run',\n154:   '/doctor:sk-skill check': 'run',\n155:   '/doctor:sk-skill convert': 'ask',\n156:   '/doctor:skill-advisor embedder': 'ask',\n157:   '/doctor:skill-advisor parent-skill': 'run',\n158:   '/doctor:skill-advisor rebuild': 'ask',\n159:   '/doctor:skill-advisor router-reach': 'run',\n160:   '/doctor:skill-advisor skill-budget': 'run',\n161:   '/doctor:skill-advisor skill-graph-freshness': 'run',\n162:   '/doctor:skill-advisor tune': 'ask',\n163:   '/doctor:speckit': 'run',\n164:   '/doctor:symlink check': 'run',\n165:   '/doctor:symlink link': 'ask',\n166:   '/doctor:symlink unlink': 'ask',\n167:   '/doctor:update': 'ask',\n168:   '/prompt:improve': 'start',\n169:   '/speckit:complete': 'start',\n170:   '/speckit:handoff': 'ask',\n171:   '/speckit:implement': 'start',\n172:   '/speckit:plan': 'start',\n173:   '/speckit:resume': 'start',\n174:   '/speckit:save': 'start',\n175:   '/speckit:search': 'run',\n176: };\n177: export const TRACKED_COMMANDS: Readonly<Record<string, TrackedCommand>> = {\n178:   '/create:agent': { policy: 'start', ownerSkillId: 'sk-doc', scorerRow: true },\n179:   '/create:benchmark': { policy: 'start', ownerSkillId: 'sk-doc', scorerRow: false },\n180:   '/create:changelog': { policy: 'ask', ownerSkillId: 'sk-doc', scorerRow: false },\n181:   '/create:command': { policy: 'start', ownerSkillId: 'sk-doc', scorerRow: false },\n182:   '/create:diff': { policy: 'start', ownerSkillId: 'sk-doc', scorerRow: false },\n183:   '/create:feature-catalog': { policy: 'start', ownerSkillId: 'sk-doc', scorerRow: false },\n184:   '/create:goal': { policy: 'start', ownerSkillId: 'sk-doc', scorerRow: false },\n185:   '/create:manual-testing-playbook': { policy: 'start', ownerSkillId: 'sk-doc', scorerRow: true },\n186:   '/create:readme': { policy: 'start', ownerSkillId: 'sk-doc', scorerRow: false },\n187:   '/create:repo-rule': { policy: 'start', ownerSkillId: 'sk-doc', scorerRow: false },\n188:   '/create:skill': { policy: 'start', ownerSkillId: 'sk-doc', scorerRow: false },\n189:   '/create:skill-parent': { policy: 'start', ownerSkillId: 'sk-doc', scorerRow: false },\n190:   '/create:with-human-voice': { policy: 'start', ownerSkillId: 'sk-doc', scorerRow: false },\n191:   '/deep:ai-council': { policy: 'ask', ownerSkillId: 'system-deep-loop', scorerRow: false },\n192:   '/deep:research': { policy: 'ask', ownerSkillId: 'system-deep-loop', scorerRow: false },\n193:   '/deep:review': { policy: 'ask', ownerSkillId: 'system-deep-loop', scorerRow: false },\n194:   '/design:chart': { policy: 'start', ownerSkillId: 'sk-design', scorerRow: false },\n195:   '/design:diagram': { policy: 'start', ownerSkillId: 'sk-design', scorerRow: false },\n196:   '/design:extract': { policy: 'ask', ownerSkillId: 'sk-design', scorerRow: false },\n197:   '/doctor:agents-md check': { policy: 'run', ownerSkillId: 'system-skilled-doctor', scorerRow: true },\n198:   '/doctor:agents-md embed': { policy: 'ask', ownerSkillId: 'system-skilled-doctor', scorerRow: true },\n199:   '/doctor:agents-md restore': { policy: 'ask', ownerSkillId: 'system-skilled-doctor', scorerRow: true },\n200:   '/doctor:ci report': { policy: 'run', ownerSkillId: 'sk-code', scorerRow: true },\n201:   '/doctor:ci scaffold': { policy: 'ask', ownerSkillId: 'sk-code', scorerRow: true },\n202:   '/doctor:ci toggle': { policy: 'ask', ownerSkillId: 'sk-code', scorerRow: true },\n203:   '/doctor:deep-loop': { policy: 'run', ownerSkillId: 'system-deep-loop', scorerRow: true },\n204:   '/doctor:env list': { policy: 'run', ownerSkillId: 'system-skilled-doctor', scorerRow: true },\n205:   '/doctor:git hooks': { policy: 'ask', ownerSkillId: 'sk-git', scorerRow: true },\n206:   '/doctor:git setup': { policy: 'run', ownerSkillId: 'sk-git', scorerRow: true },\n207:   '/doctor:git standards': { policy: 'ask', ownerSkillId: 'sk-git', scorerRow: true },\n208:   '/doctor:helper': { policy: 'run', ownerSkillId: 'system-skilled-doctor', scorerRow: true },\n209:   '/doctor:install': { policy: 'run', ownerSkillId: 'system-skilled-doctor', scorerRow: true },\n210:   '/doctor:mcp debug': { policy: 'ask', ownerSkillId: 'system-skilled-doctor', scorerRow: true },\n211:   '/doctor:mcp install': { policy: 'ask', ownerSkillId: 'system-skilled-doctor', scorerRow: true },\n212:   '/doctor:overlay apply': { policy: 'ask', ownerSkillId: 'system-skilled-doctor', scorerRow: true },\n213:   '/doctor:overlay repin': { policy: 'ask', ownerSkillId: 'system-skilled-doctor', scorerRow: true },\n214:   '/doctor:overlay status': { policy: 'run', ownerSkillId: 'system-skilled-doctor', scorerRow: true },\n215:   '/doctor:runtime-mirrors': { policy: 'run', ownerSkillId: 'system-skilled-doctor', scorerRow: true },\n216:   '/doctor:setup': { policy: 'run', ownerSkillId: 'system-skilled-doctor', scorerRow: true },\n217:   '/doctor:sk-code quality': { policy: 'ask', ownerSkillId: 'sk-code', scorerRow: true },\n218:   '/doctor:sk-code setup': { policy: 'run', ownerSkillId: 'sk-code', scorerRow: true },\n219:   '/doctor:sk-skill check': { policy: 'run', ownerSkillId: 'sk-doc', scorerRow: true },\n220:   '/doctor:sk-skill convert': { policy: 'ask', ownerSkillId: 'sk-doc', scorerRow: true },\n221:   '/doctor:skill-advisor embedder': { policy: 'ask', ownerSkillId: 'system-skill-advisor', scorerRow: true },\n222:   '/doctor:skill-advisor parent-skill': { policy: 'run', ownerSkillId: 'system-skill-advisor', scorerRow: true },\n223:   '/doctor:skill-advisor rebuild': { policy: 'ask', ownerSkillId: 'system-skill-advisor', scorerRow: true },\n224:   '/doctor:skill-advisor router-reach': { policy: 'run', ownerSkillId: 'system-skill-advisor', scorerRow: true },\n225:   '/doctor:skill-advisor skill-budget': { policy: 'run', ownerSkillId: 'system-skill-advisor', scorerRow: true },\n226:   '/doctor:skill-advisor skill-graph-freshness': { policy: 'run', ownerSkillId: 'system-skill-advisor', scorerRow: true },\n227:   '/doctor:skill-advisor tune': { policy: 'ask', ownerSkillId: 'system-skill-advisor', scorerRow: true },\n228:   '/doctor:speckit': { policy: 'run', ownerSkillId: 'system-skilled-doctor', scorerRow: true },\n229:   '/doctor:symlink check': { policy: 'run', ownerSkillId: 'system-skilled-doctor', scorerRow: true },\n230:   '/doctor:symlink link': { policy: 'ask', ownerSkillId: 'system-skilled-doctor', scorerRow: true },\n231:   '/doctor:symlink unlink': { policy: 'ask', ownerSkillId: 'system-skilled-doctor', scorerRow: true },\n232:   '/doctor:update': { policy: 'ask', ownerSkillId: 'system-skilled-doctor', scorerRow: true },\n233:   '/prompt:improve': { policy: 'start', ownerSkillId: 'sk-prompt', scorerRow: true },\n234:   '/speckit:complete': { policy: 'start', ownerSkillId: 'system-spec-kit', scorerRow: true },\n235:   '/speckit:handoff': { policy: 'ask', ownerSkillId: 'system-spec-kit', scorerRow: true },\n236:   '/speckit:implement': { policy: 'start', ownerSkillId: 'system-spec-kit', scorerRow: true },\n237:   '/speckit:plan': { policy: 'start', ownerSkillId: 'system-spec-kit', scorerRow: true },\n238:   '/speckit:resume': { policy: 'start', ownerSkillId: 'system-spec-kit', scorerRow: true },\n239:   '/speckit:save': { policy: 'start', ownerSkillId: 'system-spec-kit', scorerRow: true },\n240:   '/speckit:search': { policy: 'run', ownerSkillId: 'system-spec-kit', scorerRow: true },\n241: };\n242: // END GENERATED COMMAND ROWS\n243: \n244: // The row for an id a recommendation carries, or undefined when that id names no\n245: // command. Own-key lookup because the table is generated data, so an inherited\n246: // name such as `constructor` must not resolve to a row nobody declared.\n247: export function commandRowFor(id: string): CommandRow | undefined {\n248:   return Object.hasOwn(COMMAND_ROWS, id) ? COMMAND_ROWS[id] : undefined;\n249: }\n250: \n251: // Deep-loop commands open a long, multi-pass run, so one attached to a prompt\n252: // that merely mentions the topic spends the reader's budget on work they never\n253: // asked for. The list below is the vocabulary that counts as asking for it, and\n254: // it holds only effort wording: a bare topic word such as `research`, `review`\n255: // or `council` says what to look at, never how far to go, so it never qualifies\n256: // on its own.\n257: //\n258: // The phrases live in a data list, one per line, so the vocabulary a reviewer\n259: // has to judge stays visible and cheap to correct.\n260: export const DEPTH_WORDING: readonly string[] = [\n261:   'in depth',\n262:   'deep dive',\n263:   'deep research',\n264:   'deep review',\n265:   'thorough',\n266:   'thoroughly',\n267:   'exhaustive',\n268:   'iteratively',\n269:   'multiple passes',\n270:   'many passes',\n271:   'several passes',\n272:   'ask the council',\n273:   'convene',\n274:   'several models',\n275:   'final verdict',\n276:   'everything you can',\n277: ];\n278: \n279: // A phrase may carry punctuation a regex would read as a metacharacter, so it is\n280: // escaped before it is trusted as a pattern.\n281: function escapePhrase(phrase: string): string {\n282:   return phrase.replace(/[.*+?^${}()|[\\]\\\\]/g, '\\\\$&');\n283: }\n284: \n285: // One alternation over the list keeps the gate a single test per prompt, and the\n286: // boundary markers keep `thorough` from firing inside a longer word while a\n287: // multi-word phrase still has to match as a whole.\n288: const DEPTH_REQUEST = new RegExp(`\\\\b(?:${DEPTH_WORDING.map(escapePhrase).join('|')})\\\\b`);\n289: \n290: // A compiled route arrives as unvalidated JSON from a separate process, so the\n291: // shape is narrowed here rather than trusted. Arrays count as objects in\n292: // JavaScript and would let `action` read off an unrelated field, so they are\n293: // excluded explicitly.\n294: function asRecord(value: unknown): Record<string, unknown> | undefined {\n295:   if (typeof value !== 'object' || value === null || Array.isArray(value)) return undefined;\n296:   return value as Record<string, unknown>;\n297: }\n298: \n299: // The command for a hub's recommendation, or undefined when the route does not\n300: // single out one mode. Only a single-mode route names a command unambiguously:\n301: // a bundle or a multi-target route has more than one answer, and asking the\n302: // reader to pick belongs to the recommend path, not here. Never throws, because\n303: // a missing command must degrade to \"no command offered\" rather than break\n304: // routing. The prompt decides whether a costly deep-loop command is offered at\n305: // all: a reader who only asks about the topic gets no command, rather than one\n306: // that would launch work they never requested.\n307: export function attachCommand(\n308:   skillId: string,\n309:   compiledRoute: unknown,\n310:   prompt: string,\n311:   modeCommands: Readonly<Record<string, Readonly<Record<string, string>>>> = MODE_COMMANDS,\n312: ): string | undefined {\n313:   const route = asRecord(compiledRoute);\n314:   if (!route) return undefined;\n315:   if (route.action !== 'route' || route.selectionKind !== 'single') return undefined;\n316: \n317:   const targets = route.targets;\n318:   if (!Array.isArray(targets) || targets.length !== 1) return undefined;\n319: \n320:   const onlyTarget = asRecord(targets[0]);\n321:   if (!onlyTarget) return undefined;\n322: \n323:   const workflowMode = onlyTarget.workflowMode;\n324:   if (typeof workflowMode !== 'string' || workflowMode === '') return undefined;\n325: \n326:   // Own-key lookup on both levels: the table is data read from a generated\n327:   // object, so an inherited name such as `constructor` must not resolve to a\n328:   // command the hub never declared.\n329:   if (!Object.prototype.hasOwnProperty.call(modeCommands, skillId)) return undefined;\n330:   const commands = modeCommands[skillId];\n331:   if (!Object.prototype.hasOwnProperty.call(commands, workflowMode)) return undefined;\n332: \n333:   // Deep-loop commands are the ones that commit the reader to a long, multi-pass\n334:   // run, so they are offered only when the prompt asks for that effort. Typing\n335:   // the slash command is itself the ask, and every other hub answers a short\n336:   // question with a short answer, so no other skill consults the wording list.\n337:   if (skillId === 'system-deep-loop') {\n338:     const lowered = prompt.toLowerCase();\n339:     if (!lowered.includes('/deep:') && !DEPTH_REQUEST.test(lowered)) return undefined;\n340:   }\n341: \n342:   return commands[workflowMode];\n343: }"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/lib/command-attach.ts\"}"},"time":{"start":1794540045808,"end":1794540046613}}}}
{"type":"tool_use","timestamp":1794540046617,"sessionID":"ses_e2d1486c8ffeG6hsQuEtK6ngKc","part":{"partID":"prt_1d2ec07a5001sPOjBxUqSmpkMy","sessionID":"ses_e2d1486c8ffeG6hsQuEtK6ngKc","messageID":"msg_1d2ebe26c001RuxEB4MOIdq6wu","type":"tool","id":"call_6305910ee5e941d386572c22","tool":"read","state":{"status":"completed","input":{"path":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/tests/command-attach.vitest.ts"},"output":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/tests/command-attach.vitest.ts, lines 1-163\n1: // ───────────────────────────────────────────────────────────────\n2: // MODULE: Command attach for a hub recommendation\n3: // ───────────────────────────────────────────────────────────────\n4: \n5: // The advisor names the workflow mode a hub would route a prompt to, and\n6: // `attachCommand()` turns that mode into the slash command a reader can type.\n7: // The table it reads is generated from each hub's own command files, so these\n8: // tests assert the properties the generator has to keep — an own-key lookup on\n9: // both levels, and a real command file behind every row — rather than restating\n10: // today's rows, which would drift from the generator instead of catching it.\n11: //\n12: // The deep-loop gate is asserted on its own, because a command offered for a\n13: // prompt that never asked for that effort commits the reader to a long run they\n14: // did not request, and the prompt is the only thing that can tell the two apart.\n15: \n16: import { existsSync } from 'node:fs';\n17: import { join } from 'node:path';\n18: \n19: import { describe, expect, it } from 'vitest';\n20: \n21: import { attachCommand, DEPTH_WORDING, MODE_COMMANDS } from '../lib/command-attach.js';\n22: import { findAdvisorWorkspaceRoot } from '../lib/utils/workspace-root.js';\n23: import { AdvisorRecommendationSchema } from '../schemas/advisor-tool-schemas.js';\n24: \n25: type ModeCommands = Readonly<Record<string, Readonly<Record<string, string>>>>;\n26: \n27: const REPO_ROOT = findAdvisorWorkspaceRoot(import.meta.dirname);\n28: \n29: // A slash command spelling that also names the file behind it, so a generated row\n30: // can be checked against the command tree rather than against a second copy of\n31: // itself.\n32: const COMMAND_ID = /^\\/([a-z][a-z0-9-]*):([a-z0-9-]+)$/;\n33: \n34: // The only route shape that can name a command unambiguously: one decision, one\n35: // selected target, so the target's mode is the answer.\n36: function singleRoute(workflowMode: string, overrides: Record<string, unknown> = {}): Record<string, unknown> {\n37:   return { action: 'route', selectionKind: 'single', targets: [{ workflowMode }], ...overrides };\n38: }\n39: \n40: // Distinct from what the generated table holds for the same hub and mode, so a\n41: // passing assertion proves the injected table was read rather than the real one.\n42: const INJECTED_COMMAND = '/injected:readme';\n43: const INJECTED: ModeCommands = { 'sk-doc': { 'sk-create-readme': INJECTED_COMMAND } };\n44: const OTHER_HUB: ModeCommands = { 'made-up-hub': { 'made-up-mode': '/made-up:command' } };\n45: \n46: // Wording that names a topic without asking for effort: no phrase in the effort\n47: // vocabulary, and no typed slash command.\n48: const PLAIN_PROMPT = 'how does the routing table pick a skill';\n49: \n50: describe('command attach for a single routed mode', () => {\n51:   it('names the command the routed mode maps to', () => {\n52:     // Any generated hub except the gated one, read at test time so the case\n53:     // follows a regenerated table instead of pinning one of its rows.\n54:     const generated = Object.entries(MODE_COMMANDS).find(([hub]) => hub !== 'system-deep-loop');\n55:     expect(generated, 'the generated table names a hub outside the depth gate').toBeDefined();\n56:     const [hub, modes] = generated as [string, Readonly<Record<string, string>>];\n57:     const [mode, command] = Object.entries(modes)[0] as [string, string];\n58:     expect(command).toBeTypeOf('string');\n59: \n60:     expect(attachCommand(hub, singleRoute(mode), 'add a readme')).toBe(command);\n61: \n62:     expect(attachCommand('sk-doc', singleRoute('sk-create-readme'), 'anything', INJECTED)).toBe(INJECTED_COMMAND);\n63:     expect(attachCommand('made-up-hub', singleRoute('made-up-mode'), 'anything', OTHER_HUB)).toBe('/made-up:command');\n64:   });\n65: \n66:   it('offers no command unless the route names exactly one mode the table holds', () => {\n67:     const rows: Array<[string, string, unknown]> = [\n68:       ['a multi-selection route', 'sk-doc', {\n69:         action: 'route', selectionKind: 'multi', targets: [{ workflowMode: 'sk-create-readme' }],\n70:       }],\n71:       ['an ask decision', 'sk-doc', {\n72:         action: 'ask', selectionKind: 'single', targets: [{ workflowMode: 'sk-create-readme' }],\n73:       }],\n74:       ['a route with two targets', 'sk-doc', {\n75:         action: 'route',\n76:         selectionKind: 'single',\n77:         targets: [{ workflowMode: 'sk-create-readme' }, { workflowMode: 'sk-create-benchmark' }],\n78:       }],\n79:       ['a mode the table does not hold', 'sk-doc', singleRoute('sk-create-benchmark')],\n80:       ['a hub the table does not hold', 'sk-git', singleRoute('sk-create-readme')],\n81:       ['no route at all', 'sk-doc', null],\n82:       ['a route that is an array', 'sk-doc', [singleRoute('sk-create-readme')]],\n83:       // An inherited name such as `constructor` is never a command the hub\n84:       // declared, so the lookup must read own keys at both levels.\n85:       ['a mode named after an inherited key', 'sk-doc', singleRoute('constructor')],\n86:       ['a hub named after an inherited key', 'constructor', singleRoute('sk-create-readme')],\n87:     ];\n88: \n89:     for (const [label, skillId, compiledRoute] of rows) {\n90:       expect(attachCommand(skillId, compiledRoute, PLAIN_PROMPT, INJECTED), label).toBeUndefined();\n91:     }\n92:     expect(attachCommand('constructor', singleRoute('constructor'), PLAIN_PROMPT), 'both levels inherited').toBeUndefined();\n93:   });\n94: \n95:   it('offers a deep-loop command only when the prompt asks for that effort', () => {\n96:     const plainIsQuiet = DEPTH_WORDING.every((phrase) => !PLAIN_PROMPT.toLowerCase().includes(phrase));\n97:     expect(plainIsQuiet, 'the effort-free probe prompt mentions no effort wording').toBe(true);\n98: \n99:     const modes = Object.entries(MODE_COMMANDS['system-deep-loop']);\n100:     expect(modes.length).toBeGreaterThan(0);\n101:     const [effortPhrase] = DEPTH_WORDING;\n102:     expect(effortPhrase).toBeTruthy();\n103: \n104:     for (const [mode, command] of modes) {\n105:       const route = singleRoute(mode);\n106:       expect(attachCommand('system-deep-loop', route, PLAIN_PROMPT), mode).toBeUndefined();\n107:       expect(attachCommand('system-deep-loop', route, `explain the scorer ${effortPhrase}`), mode).toBe(command);\n108:       expect(attachCommand('system-deep-loop', route, `run ${command} for me`), mode).toBe(command);\n109:     }\n110: \n111:     // The gate belongs to the deep-loop hub alone: every other hub answers the\n112:     // same effort-free prompt with its command.\n113:     expect(attachCommand('sk-doc', singleRoute('sk-create-benchmark'), PLAIN_PROMPT, INJECTED)).toBeUndefined();\n114:     expect(attachCommand('sk-doc', singleRoute('sk-create-readme'), PLAIN_PROMPT, INJECTED)).toBe(INJECTED_COMMAND);\n115:   });\n116: \n117:   it('stays quiet when a prompt only names a deep-loop mode by its topic', () => {\n118:     const topicOnly: ReadonlyArray<readonly [string, string]> = [\n119:       ['ai-council', 'What does the AI council mode do?'],\n120:       ['research', 'what is research mode?'],\n121:       ['review', 'how does the review mode work?'],\n122:     ];\n123:     for (const [mode, prompt] of topicOnly) {\n124:       expect(MODE_COMMANDS['system-deep-loop'], mode).toHaveProperty(mode);\n125:       expect(attachCommand('system-deep-loop', singleRoute(mode), prompt), prompt).toBeUndefined();\n126:     }\n127:     expect(attachCommand('system-deep-loop', singleRoute('ai-council'), 'ask the council whether to split billing'))\n128:       .toBe(MODE_COMMANDS['system-deep-loop']['ai-council']);\n129:   });\n130: \n131:   it('names a real command file behind every generated row', () => {\n132:     const hubs = Object.keys(MODE_COMMANDS);\n133:     expect(hubs.length).toBeGreaterThan(0);\n134: \n135:     for (const hub of hubs) {\n136:       const modes = Object.entries(MODE_COMMANDS[hub]);\n137:       expect(modes.length, hub).toBeGreaterThan(0);\n138:       for (const [mode, command] of modes) {\n139:         const label = `${hub} ${mode}: ${command}`;\n140:         const match = command.match(COMMAND_ID);\n141:         expect(match, label).not.toBeNull();\n142:         const [, namespace, name] = match as RegExpMatchArray;\n143:         expect(existsSync(join(REPO_ROOT, '.skilled', 'commands', namespace, `${name}.md`)), label).toBe(true);\n144:       }\n145:     }\n146:   });\n147: \n148:   it('accepts a named command on a recommendation and refuses an empty one', () => {\n149:     // Only the schema's required keys, so the object proves the command field is\n150:     // the one under test rather than something an unrelated field satisfied.\n151:     const minimal = {\n152:       skillId: 'sk-create-readme',\n153:       score: 1,\n154:       confidence: 0.9,\n155:       uncertainty: 0.1,\n156:       dominantLane: null,\n157:     };\n158: \n159:     expect(AdvisorRecommendationSchema.safeParse(minimal).success).toBe(true);\n160:     expect(AdvisorRecommendationSchema.safeParse({ ...minimal, command: '/create:readme' }).success).toBe(true);\n161:     expect(AdvisorRecommendationSchema.safeParse({ ...minimal, command: '' }).success).toBe(false);\n162:   });\n163: });","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/tests/command-attach.vitest.ts, lines 1-163\n1: // ───────────────────────────────────────────────────────────────\n2: // MODULE: Command attach for a hub recommendation\n3: // ───────────────────────────────────────────────────────────────\n4: \n5: // The advisor names the workflow mode a hub would route a prompt to, and\n6: // `attachCommand()` turns that mode into the slash command a reader can type.\n7: // The table it reads is generated from each hub's own command files, so these\n8: // tests assert the properties the generator has to keep — an own-key lookup on\n9: // both levels, and a real command file behind every row — rather than restating\n10: // today's rows, which would drift from the generator instead of catching it.\n11: //\n12: // The deep-loop gate is asserted on its own, because a command offered for a\n13: // prompt that never asked for that effort commits the reader to a long run they\n14: // did not request, and the prompt is the only thing that can tell the two apart.\n15: \n16: import { existsSync } from 'node:fs';\n17: import { join } from 'node:path';\n18: \n19: import { describe, expect, it } from 'vitest';\n20: \n21: import { attachCommand, DEPTH_WORDING, MODE_COMMANDS } from '../lib/command-attach.js';\n22: import { findAdvisorWorkspaceRoot } from '../lib/utils/workspace-root.js';\n23: import { AdvisorRecommendationSchema } from '../schemas/advisor-tool-schemas.js';\n24: \n25: type ModeCommands = Readonly<Record<string, Readonly<Record<string, string>>>>;\n26: \n27: const REPO_ROOT = findAdvisorWorkspaceRoot(import.meta.dirname);\n28: \n29: // A slash command spelling that also names the file behind it, so a generated row\n30: // can be checked against the command tree rather than against a second copy of\n31: // itself.\n32: const COMMAND_ID = /^\\/([a-z][a-z0-9-]*):([a-z0-9-]+)$/;\n33: \n34: // The only route shape that can name a command unambiguously: one decision, one\n35: // selected target, so the target's mode is the answer.\n36: function singleRoute(workflowMode: string, overrides: Record<string, unknown> = {}): Record<string, unknown> {\n37:   return { action: 'route', selectionKind: 'single', targets: [{ workflowMode }], ...overrides };\n38: }\n39: \n40: // Distinct from what the generated table holds for the same hub and mode, so a\n41: // passing assertion proves the injected table was read rather than the real one.\n42: const INJECTED_COMMAND = '/injected:readme';\n43: const INJECTED: ModeCommands = { 'sk-doc': { 'sk-create-readme': INJECTED_COMMAND } };\n44: const OTHER_HUB: ModeCommands = { 'made-up-hub': { 'made-up-mode': '/made-up:command' } };\n45: \n46: // Wording that names a topic without asking for effort: no phrase in the effort\n47: // vocabulary, and no typed slash command.\n48: const PLAIN_PROMPT = 'how does the routing table pick a skill';\n49: \n50: describe('command attach for a single routed mode', () => {\n51:   it('names the command the routed mode maps to', () => {\n52:     // Any generated hub except the gated one, read at test time so the case\n53:     // follows a regenerated table instead of pinning one of its rows.\n54:     const generated = Object.entries(MODE_COMMANDS).find(([hub]) => hub !== 'system-deep-loop');\n55:     expect(generated, 'the generated table names a hub outside the depth gate').toBeDefined();\n56:     const [hub, modes] = generated as [string, Readonly<Record<string, string>>];\n57:     const [mode, command] = Object.entries(modes)[0] as [string, string];\n58:     expect(command).toBeTypeOf('string');\n59: \n60:     expect(attachCommand(hub, singleRoute(mode), 'add a readme')).toBe(command);\n61: \n62:     expect(attachCommand('sk-doc', singleRoute('sk-create-readme'), 'anything', INJECTED)).toBe(INJECTED_COMMAND);\n63:     expect(attachCommand('made-up-hub', singleRoute('made-up-mode'), 'anything', OTHER_HUB)).toBe('/made-up:command');\n64:   });\n65: \n66:   it('offers no command unless the route names exactly one mode the table holds', () => {\n67:     const rows: Array<[string, string, unknown]> = [\n68:       ['a multi-selection route', 'sk-doc', {\n69:         action: 'route', selectionKind: 'multi', targets: [{ workflowMode: 'sk-create-readme' }],\n70:       }],\n71:       ['an ask decision', 'sk-doc', {\n72:         action: 'ask', selectionKind: 'single', targets: [{ workflowMode: 'sk-create-readme' }],\n73:       }],\n74:       ['a route with two targets', 'sk-doc', {\n75:         action: 'route',\n76:         selectionKind: 'single',\n77:         targets: [{ workflowMode: 'sk-create-readme' }, { workflowMode: 'sk-create-benchmark' }],\n78:       }],\n79:       ['a mode the table does not hold', 'sk-doc', singleRoute('sk-create-benchmark')],\n80:       ['a hub the table does not hold', 'sk-git', singleRoute('sk-create-readme')],\n81:       ['no route at all', 'sk-doc', null],\n82:       ['a route that is an array', 'sk-doc', [singleRoute('sk-create-readme')]],\n83:       // An inherited name such as `constructor` is never a command the hub\n84:       // declared, so the lookup must read own keys at both levels.\n85:       ['a mode named after an inherited key', 'sk-doc', singleRoute('constructor')],\n86:       ['a hub named after an inherited key', 'constructor', singleRoute('sk-create-readme')],\n87:     ];\n88: \n89:     for (const [label, skillId, compiledRoute] of rows) {\n90:       expect(attachCommand(skillId, compiledRoute, PLAIN_PROMPT, INJECTED), label).toBeUndefined();\n91:     }\n92:     expect(attachCommand('constructor', singleRoute('constructor'), PLAIN_PROMPT), 'both levels inherited').toBeUndefined();\n93:   });\n94: \n95:   it('offers a deep-loop command only when the prompt asks for that effort', () => {\n96:     const plainIsQuiet = DEPTH_WORDING.every((phrase) => !PLAIN_PROMPT.toLowerCase().includes(phrase));\n97:     expect(plainIsQuiet, 'the effort-free probe prompt mentions no effort wording').toBe(true);\n98: \n99:     const modes = Object.entries(MODE_COMMANDS['system-deep-loop']);\n100:     expect(modes.length).toBeGreaterThan(0);\n101:     const [effortPhrase] = DEPTH_WORDING;\n102:     expect(effortPhrase).toBeTruthy();\n103: \n104:     for (const [mode, command] of modes) {\n105:       const route = singleRoute(mode);\n106:       expect(attachCommand('system-deep-loop', route, PLAIN_PROMPT), mode).toBeUndefined();\n107:       expect(attachCommand('system-deep-loop', route, `explain the scorer ${effortPhrase}`), mode).toBe(command);\n108:       expect(attachCommand('system-deep-loop', route, `run ${command} for me`), mode).toBe(command);\n109:     }\n110: \n111:     // The gate belongs to the deep-loop hub alone: every other hub answers the\n112:     // same effort-free prompt with its command.\n113:     expect(attachCommand('sk-doc', singleRoute('sk-create-benchmark'), PLAIN_PROMPT, INJECTED)).toBeUndefined();\n114:     expect(attachCommand('sk-doc', singleRoute('sk-create-readme'), PLAIN_PROMPT, INJECTED)).toBe(INJECTED_COMMAND);\n115:   });\n116: \n117:   it('stays quiet when a prompt only names a deep-loop mode by its topic', () => {\n118:     const topicOnly: ReadonlyArray<readonly [string, string]> = [\n119:       ['ai-council', 'What does the AI council mode do?'],\n120:       ['research', 'what is research mode?'],\n121:       ['review', 'how does the review mode work?'],\n122:     ];\n123:     for (const [mode, prompt] of topicOnly) {\n124:       expect(MODE_COMMANDS['system-deep-loop'], mode).toHaveProperty(mode);\n125:       expect(attachCommand('system-deep-loop', singleRoute(mode), prompt), prompt).toBeUndefined();\n126:     }\n127:     expect(attachCommand('system-deep-loop', singleRoute('ai-council'), 'ask the council whether to split billing'))\n128:       .toBe(MODE_COMMANDS['system-deep-loop']['ai-council']);\n129:   });\n130: \n131:   it('names a real command file behind every generated row', () => {\n132:     const hubs = Object.keys(MODE_COMMANDS);\n133:     expect(hubs.length).toBeGreaterThan(0);\n134: \n135:     for (const hub of hubs) {\n136:       const modes = Object.entries(MODE_COMMANDS[hub]);\n137:       expect(modes.length, hub).toBeGreaterThan(0);\n138:       for (const [mode, command] of modes) {\n139:         const label = `${hub} ${mode}: ${command}`;\n140:         const match = command.match(COMMAND_ID);\n141:         expect(match, label).not.toBeNull();\n142:         const [, namespace, name] = match as RegExpMatchArray;\n143:         expect(existsSync(join(REPO_ROOT, '.skilled', 'commands', namespace, `${name}.md`)), label).toBe(true);\n144:       }\n145:     }\n146:   });\n147: \n148:   it('accepts a named command on a recommendation and refuses an empty one', () => {\n149:     // Only the schema's required keys, so the object proves the command field is\n150:     // the one under test rather than something an unrelated field satisfied.\n151:     const minimal = {\n152:       skillId: 'sk-create-readme',\n153:       score: 1,\n154:       confidence: 0.9,\n155:       uncertainty: 0.1,\n156:       dominantLane: null,\n157:     };\n158: \n159:     expect(AdvisorRecommendationSchema.safeParse(minimal).success).toBe(true);\n160:     expect(AdvisorRecommendationSchema.safeParse({ ...minimal, command: '/create:readme' }).success).toBe(true);\n161:     expect(AdvisorRecommendationSchema.safeParse({ ...minimal, command: '' }).success).toBe(false);\n162:   });\n163: });"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/tests/command-attach.vitest.ts\"}"},"time":{"start":1794540046245,"end":1794540046617}}}}
