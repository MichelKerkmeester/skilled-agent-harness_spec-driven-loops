// The phrases live in a data list, one per line, so the vocabulary a reviewer\n305: // has to judge stays visible and cheap to correct.\n306: export const DEPTH_WORDING: readonly string[] = [\n307:   'in depth',\n308:   'deep dive',\n309:   'deep research',\n[Output truncated. Continue reading with offset: 310]"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/lib/command-attach.ts\",\"offset\":240,\"limit\":70}"},"time":{"start":1794540530387,"end":1794540531042}}}}
