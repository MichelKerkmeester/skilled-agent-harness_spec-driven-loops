{"type":"tool_use","timestamp":1794541474177,"sessionID":"ses_e2d068ceaffe9O3kC6bqSOeD4D","part":{"partID":"prt_1d301d003002O5fG4LMbaOtcIS","sessionID":"ses_e2d068ceaffe9O3kC6bqSOeD4D","messageID":"msg_1d301c770001bJtclXxTVTVACW","type":"tool","id":"call_d190d5771d14413f88a7e7a7","tool":"read","state":{"status":"completed","input":{"path":"specs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/011-typed-command-delivery-and-guards/scratch/typed-heads.mjs"},"output":"Read file specs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/011-typed-command-delivery-and-guards/scratch/typed-heads.mjs, lines 1-253\n1: // ───────────────────────────────────────────────────────────────────\n2: // MODULE: TYPED HEAD OFFERS\n3: // ───────────────────────────────────────────────────────────────────\n4: //\n5: // Checks what the Claude prompt hook really puts on the first line of the\n6: // advisor head for a typed command prompt. Every row runs through the installed\n7: // hook, and the recorded command and policy are read back with the same parser\n8: // the run log uses, so the measurement answers for the text a session receives\n9: // rather than for what the ranking was expected to say.\n10: //\n11: // The run keeps its IPC socket and its advisor database in one fresh directory\n12: // so it never reaches the operator's warm daemon. The directory is the only\n13: // thing that ties the hook processes together, and it is removed once every row\n14: // has run.\n15: //\n16: // Usage:\n17: //   node typed-heads.mjs [--root <dir>]\n18: //\n19: // `--root` names a checkout the corpus and hook are read from, and defaults to\n20: // the current directory. The result is written beside this script.\n21: //\n22: // A prompt is never printed, so a failure report carries row ids only.\n23: \n24: // ───────────────────────────────────────────────────────────────────\n25: // 1. IMPORTS\n26: // ───────────────────────────────────────────────────────────────────\n27: \n28: import { execFileSync, spawnSync } from 'node:child_process';\n29: import { existsSync, mkdtempSync, readFileSync, rmSync, writeFileSync } from 'node:fs';\n30: import { tmpdir } from 'node:os';\n31: import { dirname, join, resolve } from 'node:path';\n32: import { fileURLToPath, pathToFileURL } from 'node:url';\n33: \n34: // ───────────────────────────────────────────────────────────────────\n35: // 2. CONSTANTS\n36: // ───────────────────────────────────────────────────────────────────\n37: \n38: const HERE = dirname(fileURLToPath(import.meta.url));\n39: const OUTPUT_PATH = join(HERE, 'typed-heads.json');\n40: const CORPUS_REL = '.skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/command-prompts.jsonl';\n41: const OFFER_REL = '.skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/command-offer.mjs';\n42: const HOOK_REL = '.skilled/skills/system-spec-kit/runtime/dist/hooks/claude/user-prompt-submit.js';\n43: const SANDBOX_PREFIX = 'ssa-typed-';\n44: const SANDBOX_PROCESS_HINTS = ['advisor-server.js', 'system-skill-advisor-launcher.cjs'];\n45: const HOOK_TIMEOUT_MS = 30000;\n46: const MAX_STDOUT_BYTES = 8 * 1024 * 1024;\n47: const COMMAND_PATTERN = /^\\/[a-z][a-z-]*:[a-z][a-z-]*$/;\n48: const POLICIES = new Set(['run', 'start', 'ask']);\n49: \n50: // ───────────────────────────────────────────────────────────────────\n51: // 3. ARGUMENT PARSING\n52: // ───────────────────────────────────────────────────────────────────\n53: \n54: function usageError(message) {\n55:   process.stderr.write(`typed-heads.mjs: ${message}\\n`);\n56:   process.stderr.write('usage: typed-heads.mjs [--root <dir>]\\n');\n57:   process.exit(2);\n58: }\n59: \n60: function parseArgs(argv) {\n61:   const options = { root: process.cwd() };\n62:   for (let index = 0; index < argv.length; index += 1) {\n63:     const token = argv[index];\n64:     if (token !== '--root') usageError(`unknown option: ${token}`);\n65:     const value = argv[index + 1];\n66:     if (value === undefined || value.startsWith('--')) usageError(`${token} needs a value`);\n67:     options.root = resolve(value);\n68:     index += 1;\n69:   }\n70:   return options;\n71: }\n72: \n73: // ───────────────────────────────────────────────────────────────────\n74: // 4. CORPUS SELECTION\n75: // ───────────────────────────────────────────────────────────────────\n76: \n77: function readCorpus(path) {\n78:   if (!existsSync(path)) {\n79:     process.stderr.write(`typed-heads.mjs: corpus file missing: ${path}\\n`);\n80:     process.exit(2);\n81:   }\n82:   const rows = [];\n83:   const lines = readFileSync(path, 'utf8').split('\\n');\n84:   for (let index = 0; index < lines.length; index += 1) {\n85:     const line = lines[index].trim();\n86:     if (line === '') continue;\n87:     try {\n88:       rows.push(JSON.parse(line));\n89:     } catch (error) {\n90:       process.stderr.write(`typed-heads.mjs: invalid JSON on corpus line ${index + 1}: ${error.message}\\n`);\n91:       process.exit(2);\n92:     }\n93:   }\n94:   return rows;\n95: }\n96: \n97: // The measured half is the only half read here. A holdout row is skipped by the\n98: // split filter before any prompt is touched, so its text never reaches a process\n99: // argument and never appears in the output.\n100: function selectRows(rows) {\n101:   return rows.filter((row) => row.row_type === 'typed' && row.split === 'none');\n102: }\n103: \n104: // ───────────────────────────────────────────────────────────────────\n105: // 5. HEAD MEASUREMENT\n106: // ───────────────────────────────────────────────────────────────────\n107: \n108: // The hook fails open with a directive block, so a missing context field is a\n109: // missing head rather than an error. Stdout is parsed whole because the shim\n110: // prints exactly one JSON envelope.\n111: function firstHeadLine(stdout) {\n112:   if (typeof stdout !== 'string' || stdout.trim() === '') return '';\n113:   try {\n114:     const value = JSON.parse(stdout)?.hookSpecificOutput?.additionalContext;\n115:     if (typeof value !== 'string') return '';\n116:     const [firstLine = ''] = value.split(/\\r?\\n/);\n117:     return firstLine;\n118:   } catch {\n119:     return '';\n120:   }\n121: }\n122: \n123: // The offer may carry a trailing example argument. Only the command token is\n124: // compared, because the corpus records the command without an argument.\n125: function commandToken(offer) {\n126:   if (typeof offer !== 'string') return null;\n127:   const [token = ''] = offer.split(' ');\n128:   return COMMAND_PATTERN.test(token) ? token : null;\n129: }\n130: \n131: // A worker session renders start and ask offers as parent-named only, which\n132: // would measure the worker context instead of what a reader is shown.\n133: function hookEnv(sandboxDir) {\n134:   const env = {\n135:     ...process.env,\n136:     SPECKIT_IPC_SOCKET_DIR: sandboxDir,\n137:     SYSTEM_SKILL_ADVISOR_DB_DIR: join(sandboxDir, 'db'),\n138:   };\n139:   delete env.AI_SESSION_CHILD;\n140:   return env;\n141: }\n142: \n143: function measureRow(row, root, sandboxDir, hookPath, parseOffer) {\n144:   const payload = JSON.stringify({\n145:     prompt: row.prompt,\n146:     cwd: root,\n147:     hook_event_name: 'UserPromptSubmit',\n148:     session_id: `typed-${row.id}`,\n149:   });\n150:   const result = spawnSync(process.execPath, [hookPath], {\n151:     cwd: root,\n152:     input: payload,\n153:     encoding: 'utf8',\n154:     env: hookEnv(sandboxDir),\n155:     timeout: HOOK_TIMEOUT_MS,\n156:     maxBuffer: MAX_STDOUT_BYTES,\n157:   });\n158:   const { offeredCommand, offeredPolicy } = parseOffer(firstHeadLine(result.stdout));\n159:   const offeredToken = commandToken(offeredCommand);\n160:   return {\n161:     id: row.id,\n162:     offeredCommand,\n163:     offeredPolicy,\n164:     commandMatches: offeredToken !== null && offeredToken === row.expected_command,\n165:     policyPresent: typeof offeredPolicy === 'string' && POLICIES.has(offeredPolicy),\n166:     labelAgrees: offeredPolicy === row.expected_policy,\n167:   };\n168: }\n169: \n170: // ───────────────────────────────────────────────────────────────────\n171: // 6. SANDBOX CLEANUP\n172: // ───────────────────────────────────────────────────────────────────\n173: \n174: function processRows() {\n175:   const output = execFileSync('ps', ['-axo', 'pid=,command='], {\n176:     encoding: 'utf8',\n177:     stdio: ['ignore', 'pipe', 'ignore'],\n178:   });\n179:   const rows = [];\n180:   for (const line of output.split('\\n')) {\n181:     const match = /^\\s*(\\d+)\\s+(.*)$/.exec(line);\n182:     if (match === null) continue;\n183:     rows.push({ pid: Number(match[1]), command: match[2] });\n184:   }\n185:   return rows;\n186: }\n187: \n188: // A sandbox process is identified by the directory on its own command line or in\n189: // its own environment, because the daemon takes its paths from the environment\n190: // rather than from arguments. No pid is signalled on trust alone, so an\n191: // unrelated daemon is never touched.\n192: function processNamesSandbox(pid, command, sandboxDir) {\n193:   if (command.includes(sandboxDir)) return true;\n194:   if (!SANDBOX_PROCESS_HINTS.some((hint) => command.includes(hint))) return false;\n195:   try {\n196:     const environment = execFileSync('ps', ['-p', String(pid), '-E', '-o', 'command='], {\n197:       encoding: 'utf8',\n198:       stdio: ['ignore', 'pipe', 'ignore'],\n199:     });\n200:     return environment.includes(sandboxDir);\n201:   } catch {\n202:     return false;\n203:   }\n204: }\n205: \n206: function stopSandboxProcesses(sandboxDir) {\n207:   for (const row of processRows()) {\n208:     if (row.pid === process.pid || !processNamesSandbox(row.pid, row.command, sandboxDir)) continue;\n209:     try {\n210:       process.kill(row.pid, 'SIGTERM');\n211:     } catch (error) {\n212:       if (error?.code !== 'ESRCH') throw error;\n213:     }\n214:   }\n215: }\n216: \n217: // ───────────────────────────────────────────────────────────────────\n218: // 7. ENTRY\n219: // ───────────────────────────────────────────────────────────────────\n220: \n221: async function main() {\n222:   const options = parseArgs(process.argv.slice(2));\n223:   const corpusPath = join(options.root, CORPUS_REL);\n224:   const hookPath = join(options.root, HOOK_REL);\n225:   const offerModulePath = join(options.root, OFFER_REL);\n226:   if (!existsSync(hookPath)) {\n227:     process.stderr.write(`typed-heads.mjs: hook file missing: ${hookPath}\\n`);\n228:     process.exit(2);\n229:   }\n230:   if (!existsSync(offerModulePath)) {\n231:     process.stderr.write(`typed-heads.mjs: offer module missing: ${offerModulePath}\\n`);\n232:     process.exit(2);\n233:   }\n234:   const { parseOffer } = await import(pathToFileURL(offerModulePath).href);\n235:   const selected = selectRows(readCorpus(corpusPath));\n236: \n237:   const sandboxDir = mkdtempSync(join(tmpdir(), SANDBOX_PREFIX));\n238:   try {\n239:     const rows = [];\n240:     for (const row of selected) {\n241:       rows.push(measureRow(row, options.root, sandboxDir, hookPath, parseOffer));\n242:     }\n243:     // Id order keeps the artifact stable across corpus reorderings, so two runs\n244:     // of the same checkout produce the same file.\n245:     rows.sort((left, right) => (left.id < right.id ? -1 : left.id > right.id ? 1 : 0));\n246:     writeFileSync(OUTPUT_PATH, `${JSON.stringify(rows, null, 2)}\\n`, 'utf8');\n247:   } finally {\n248:     stopSandboxProcesses(sandboxDir);\n249:     rmSync(sandboxDir, { recursive: true, force: true });\n250:   }\n251: }\n252: \n253: await main();","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file specs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/011-typed-command-delivery-and-guards/scratch/typed-heads.mjs, lines 1-253\n1: // ───────────────────────────────────────────────────────────────────\n2: // MODULE: TYPED HEAD OFFERS\n3: // ───────────────────────────────────────────────────────────────────\n4: //\n5: // Checks what the Claude prompt hook really puts on the first line of the\n6: // advisor head for a typed command prompt. Every row runs through the installed\n7: // hook, and the recorded command and policy are read back with the same parser\n8: // the run log uses, so the measurement answers for the text a session receives\n9: // rather than for what the ranking was expected to say.\n10: //\n11: // The run keeps its IPC socket and its advisor database in one fresh directory\n12: // so it never reaches the operator's warm daemon. The directory is the only\n13: // thing that ties the hook processes together, and it is removed once every row\n14: // has run.\n15: //\n16: // Usage:\n17: //   node typed-heads.mjs [--root <dir>]\n18: //\n19: // `--root` names a checkout the corpus and hook are read from, and defaults to\n20: // the current directory. The result is written beside this script.\n21: //\n22: // A prompt is never printed, so a failure report carries row ids only.\n23: \n24: // ───────────────────────────────────────────────────────────────────\n25: // 1. IMPORTS\n26: // ───────────────────────────────────────────────────────────────────\n27: \n28: import { execFileSync, spawnSync } from 'node:child_process';\n29: import { existsSync, mkdtempSync, readFileSync, rmSync, writeFileSync } from 'node:fs';\n30: import { tmpdir } from 'node:os';\n31: import { dirname, join, resolve } from 'node:path';\n32: import { fileURLToPath, pathToFileURL } from 'node:url';\n33: \n34: // ───────────────────────────────────────────────────────────────────\n35: // 2. CONSTANTS\n36: // ───────────────────────────────────────────────────────────────────\n37: \n38: const HERE = dirname(fileURLToPath(import.meta.url));\n39: const OUTPUT_PATH = join(HERE, 'typed-heads.json');\n40: const CORPUS_REL = '.skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/command-prompts.jsonl';\n41: const OFFER_REL = '.skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/command-offer.mjs';\n42: const HOOK_REL = '.skilled/skills/system-spec-kit/runtime/dist/hooks/claude/user-prompt-submit.js';\n43: const SANDBOX_PREFIX = 'ssa-typed-';\n44: const SANDBOX_PROCESS_HINTS = ['advisor-server.js', 'system-skill-advisor-launcher.cjs'];\n45: const HOOK_TIMEOUT_MS = 30000;\n46: const MAX_STDOUT_BYTES = 8 * 1024 * 1024;\n47: const COMMAND_PATTERN = /^\\/[a-z][a-z-]*:[a-z][a-z-]*$/;\n48: const POLICIES = new Set(['run', 'start', 'ask']);\n49: \n50: // ───────────────────────────────────────────────────────────────────\n51: // 3. ARGUMENT PARSING\n52: // ───────────────────────────────────────────────────────────────────\n53: \n54: function usageError(message) {\n55:   process.stderr.write(`typed-heads.mjs: ${message}\\n`);\n56:   process.stderr.write('usage: typed-heads.mjs [--root <dir>]\\n');\n57:   process.exit(2);\n58: }\n59: \n60: function parseArgs(argv) {\n61:   const options = { root: process.cwd() };\n62:   for (let index = 0; index < argv.length; index += 1) {\n63:     const token = argv[index];\n64:     if (token !== '--root') usageError(`unknown option: ${token}`);\n65:     const value = argv[index + 1];\n66:     if (value === undefined || value.startsWith('--')) usageError(`${token} needs a value`);\n67:     options.root = resolve(value);\n68:     index += 1;\n69:   }\n70:   return options;\n71: }\n72: \n73: // ───────────────────────────────────────────────────────────────────\n74: // 4. CORPUS SELECTION\n75: // ───────────────────────────────────────────────────────────────────\n76: \n77: function readCorpus(path) {\n78:   if (!existsSync(path)) {\n79:     process.stderr.write(`typed-heads.mjs: corpus file missing: ${path}\\n`);\n80:     process.exit(2);\n81:   }\n82:   const rows = [];\n83:   const lines = readFileSync(path, 'utf8').split('\\n');\n84:   for (let index = 0; index < lines.length; index += 1) {\n85:     const line = lines[index].trim();\n86:     if (line === '') continue;\n87:     try {\n88:       rows.push(JSON.parse(line));\n89:     } catch (error) {\n90:       process.stderr.write(`typed-heads.mjs: invalid JSON on corpus line ${index + 1}: ${error.message}\\n`);\n91:       process.exit(2);\n92:     }\n93:   }\n94:   return rows;\n95: }\n96: \n97: // The measured half is the only half read here. A holdout row is skipped by the\n98: // split filter before any prompt is touched, so its text never reaches a process\n99: // argument and never appears in the output.\n100: function selectRows(rows) {\n101:   return rows.filter((row) => row.row_type === 'typed' && row.split === 'none');\n102: }\n103: \n104: // ───────────────────────────────────────────────────────────────────\n105: // 5. HEAD MEASUREMENT\n106: // ───────────────────────────────────────────────────────────────────\n107: \n108: // The hook fails open with a directive block, so a missing context field is a\n109: // missing head rather than an error. Stdout is parsed whole because the shim\n110: // prints exactly one JSON envelope.\n111: function firstHeadLine(stdout) {\n112:   if (typeof stdout !== 'string' || stdout.trim() === '') return '';\n113:   try {\n114:     const value = JSON.parse(stdout)?.hookSpecificOutput?.additionalContext;\n115:     if (typeof value !== 'string') return '';\n116:     const [firstLine = ''] = value.split(/\\r?\\n/);\n117:     return firstLine;\n118:   } catch {\n119:     return '';\n120:   }\n121: }\n122: \n123: // The offer may carry a trailing example argument. Only the command token is\n124: // compared, because the corpus records the command without an argument.\n125: function commandToken(offer) {\n126:   if (typeof offer !== 'string') return null;\n127:   const [token = ''] = offer.split(' ');\n128:   return COMMAND_PATTERN.test(token) ? token : null;\n129: }\n130: \n131: // A worker session renders start and ask offers as parent-named only, which\n132: // would measure the worker context instead of what a reader is shown.\n133: function hookEnv(sandboxDir) {\n134:   const env = {\n135:     ...process.env,\n136:     SPECKIT_IPC_SOCKET_DIR: sandboxDir,\n137:     SYSTEM_SKILL_ADVISOR_DB_DIR: join(sandboxDir, 'db'),\n138:   };\n139:   delete env.AI_SESSION_CHILD;\n140:   return env;\n141: }\n142: \n143: function measureRow(row, root, sandboxDir, hookPath, parseOffer) {\n144:   const payload = JSON.stringify({\n145:     prompt: row.prompt,\n146:     cwd: root,\n147:     hook_event_name: 'UserPromptSubmit',\n148:     session_id: `typed-${row.id}`,\n149:   });\n150:   const result = spawnSync(process.execPath, [hookPath], {\n151:     cwd: root,\n152:     input: payload,\n153:     encoding: 'utf8',\n154:     env: hookEnv(sandboxDir),\n155:     timeout: HOOK_TIMEOUT_MS,\n156:     maxBuffer: MAX_STDOUT_BYTES,\n157:   });\n158:   const { offeredCommand, offeredPolicy } = parseOffer(firstHeadLine(result.stdout));\n159:   const offeredToken = commandToken(offeredCommand);\n160:   return {\n161:     id: row.id,\n162:     offeredCommand,\n163:     offeredPolicy,\n164:     commandMatches: offeredToken !== null && offeredToken === row.expected_command,\n165:     policyPresent: typeof offeredPolicy === 'string' && POLICIES.has(offeredPolicy),\n166:     labelAgrees: offeredPolicy === row.expected_policy,\n167:   };\n168: }\n169: \n170: // ───────────────────────────────────────────────────────────────────\n171: // 6. SANDBOX CLEANUP\n172: // ───────────────────────────────────────────────────────────────────\n173: \n174: function processRows() {\n175:   const output = execFileSync('ps', ['-axo', 'pid=,command='], {\n176:     encoding: 'utf8',\n177:     stdio: ['ignore', 'pipe', 'ignore'],\n178:   });\n179:   const rows = [];\n180:   for (const line of output.split('\\n')) {\n181:     const match = /^\\s*(\\d+)\\s+(.*)$/.exec(line);\n182:     if (match === null) continue;\n183:     rows.push({ pid: Number(match[1]), command: match[2] });\n184:   }\n185:   return rows;\n186: }\n187: \n188: // A sandbox process is identified by the directory on its own command line or in\n189: // its own environment, because the daemon takes its paths from the environment\n190: // rather than from arguments. No pid is signalled on trust alone, so an\n191: // unrelated daemon is never touched.\n192: function processNamesSandbox(pid, command, sandboxDir) {\n193:   if (command.includes(sandboxDir)) return true;\n194:   if (!SANDBOX_PROCESS_HINTS.some((hint) => command.includes(hint))) return false;\n195:   try {\n196:     const environment = execFileSync('ps', ['-p', String(pid), '-E', '-o', 'command='], {\n197:       encoding: 'utf8',\n198:       stdio: ['ignore', 'pipe', 'ignore'],\n199:     });\n200:     return environment.includes(sandboxDir);\n201:   } catch {\n202:     return false;\n203:   }\n204: }\n205: \n206: function stopSandboxProcesses(sandboxDir) {\n207:   for (const row of processRows()) {\n208:     if (row.pid === process.pid || !processNamesSandbox(row.pid, row.command, sandboxDir)) continue;\n209:     try {\n210:       process.kill(row.pid, 'SIGTERM');\n211:     } catch (error) {\n212:       if (error?.code !== 'ESRCH') throw error;\n213:     }\n214:   }\n215: }\n216: \n217: // ───────────────────────────────────────────────────────────────────\n218: // 7. ENTRY\n219: // ───────────────────────────────────────────────────────────────────\n220: \n221: async function main() {\n222:   const options = parseArgs(process.argv.slice(2));\n223:   const corpusPath = join(options.root, CORPUS_REL);\n224:   const hookPath = join(options.root, HOOK_REL);\n225:   const offerModulePath = join(options.root, OFFER_REL);\n226:   if (!existsSync(hookPath)) {\n227:     process.stderr.write(`typed-heads.mjs: hook file missing: ${hookPath}\\n`);\n228:     process.exit(2);\n229:   }\n230:   if (!existsSync(offerModulePath)) {\n231:     process.stderr.write(`typed-heads.mjs: offer module missing: ${offerModulePath}\\n`);\n232:     process.exit(2);\n233:   }\n234:   const { parseOffer } = await import(pathToFileURL(offerModulePath).href);\n235:   const selected = selectRows(readCorpus(corpusPath));\n236: \n237:   const sandboxDir = mkdtempSync(join(tmpdir(), SANDBOX_PREFIX));\n238:   try {\n239:     const rows = [];\n240:     for (const row of selected) {\n241:       rows.push(measureRow(row, options.root, sandboxDir, hookPath, parseOffer));\n242:     }\n243:     // Id order keeps the artifact stable across corpus reorderings, so two runs\n244:     // of the same checkout produce the same file.\n245:     rows.sort((left, right) => (left.id < right.id ? -1 : left.id > right.id ? 1 : 0));\n246:     writeFileSync(OUTPUT_PATH, `${JSON.stringify(rows, null, 2)}\\n`, 'utf8');\n247:   } finally {\n248:     stopSandboxProcesses(sandboxDir);\n249:     rmSync(sandboxDir, { recursive: true, force: true });\n250:   }\n251: }\n252: \n253: await main();"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\"specs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/011-typed-command-delivery-and-guards/scratch/typed-heads.mjs\"}"},"time":{"start":1794541473795,"end":1794541474177}}}}
