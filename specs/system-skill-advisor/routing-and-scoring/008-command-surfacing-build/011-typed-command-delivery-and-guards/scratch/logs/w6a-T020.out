('connect', () => {\n281-      if (!deepProbe) {\n282-        finish('alive', 'connect-ok');\n283-        return;\n284-      }\n285-      socket.write(request);\n286-    });\n287-    socket.on('data', (chunk) => {\n288-      buffer += Buffer.isBuffer(chunk) ? decoder.write(chunk) : String(chunk ?? '');\n289-      let newlineIndex = buffer.indexOf('\\n');\n290-      while (newlineIndex !== -1) {\n291-        const line = buffer.slice(0, newlineIndex).trim();\n292-        buffer = buffer.slice(newlineIndex + 1);\n293-        newlineIndex = buffer.indexOf('\\n');\n294-        if (!line) continue;\n295-        try {\n296-          const parsed = JSON.parse(line);\n297-          if (\n298-            parsed &&\n299-            parsed.jsonrpc === '2.0' &&\n300-            parsed.id === id &&\n301-            (Object.prototype.hasOwnProperty.call(parsed, 'result') ||\n302-              Object.prototype.hasOwnProperty.call(parsed, 'error'))\n303-          ) {\n304-            finish('alive', 'json-rpc-reply');\n305-            return;\n306-          }\n307-        } catch {\n308-          // Ignore malformed or unrelated frames; the bounded probe decides liveness.\n309-        }\n310-      }\n311-    });\n312-    socket.once('error', (error) => {\n313-      finish('dead', error instanceof Error ? error.message : 'socket-error');\n314-    });\n315-    socket.once('close', () => {\n316-      finish('dead', 'closed-before-reply');\n317-    });\n318-  });\n319-}\n--\n469:async function maybeBridgeLeaseHolder(options) {\n470-  const {\n471-    serviceName,\n472-    leaseResult,\n473-    loggerPrefix,\n474-    dbDir,\n475-    legacyReport,\n476-    probeTimeoutMs,\n477-    connect,\n478-    bridge,\n479-    respawnOnMissingSocket = false,\n480-  } = options;\n481-  const startedAt = leaseResult.startedAt ?? new Date(0).toISOString();\n482-  const legacyMarker = leaseResult.legacyPath ? ' (legacy path)' : '';\n483-  const ownerPid = leaseResult.ownerPid;\n484-  const writeLeaseHeld = (suffix = '') => {\n485-    process.stdout.write(`LEASE_HELD_BY:${ownerPid} startedAt=${startedAt}${legacyMarker}${suffix}\\n`);\n486-  };\n487-\n488-  if (process.env.SPECKIT_LAUNCHER_BRIDGE_DISABLED === '1') {\n489-    if (legacyReport) {\n490-      legacyReport(leaseResult);\n491-      return { action: 'report', reason: 'bridge-disabled' };\n492-    }\n493-    writeLeaseHeld();\n494-    return { action: 'report', reason: 'bridge-disabled' };\n495-  }\n496-\n497-  // Prefer the path the lease owner actually recorded over recomputing one from env. Under a\n498-  // divergent SPECKIT_IPC_SOCKET_DIR (e.g. a secondary launcher in a different worktree env), the\n499-  // recomputed path can miss the live socket and false-report 'no-bridge-socket'. Only trust the\n500-  // stored path when it still exists on disk; tcp:// endpoints bypass the existence check. Fall back\n501-  // to recomputation for legacy leases that predate socketPath and for the other launchers whose\n502-  // leases never carry it.\n503-  const storedSocketPath = leaseResult.socketPath;\n504-  const recomputedSocketPath = getIpcSocketPath(serviceName, { dbDir });\n505-  const socketDir = process.env.SPECKIT_IPC_SOCKET_DIR ?? DEFAULT_SKILL_ADVISOR_SOCKET_DIR;\n506-  const scopedSocket = shouldScopeIpcSocket(serviceName, socketDir);\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"239:  // decision (which always passes deepProbe:true). See maybeBridgeLeaseHolder.\n240-  const deepProbe = options.deepProbe === true;\n241-  const id = nextProbeId++;\n242-  const request = `${JSON.stringify({\n243-    jsonrpc: '2.0',\n244-    id,\n245-    method: 'initialize',\n246-    params: {\n247-      protocolVersion: JSON_RPC_PROTOCOL_VERSION,\n248-      capabilities: {},\n249-      clientInfo: { name: 'liveness-probe', version: '0' },\n250-    },\n251-  })}\\n`;\n252-\n253-  return new Promise((resolve) => {\n254-    let socket;\n255-    let settled = false;\n256-    let buffer = '';\n257-    let timer;\n258-    // Hold a multibyte char split across chunk boundaries until complete, so a probe reply\n259-    // carrying CJK/emoji (e.g. serverInfo strings) is not corrupted to U+FFFD mid-parse.\n260-    const decoder = new StringDecoder('utf8');\n261-\n262-    const finish = (status, reason) => {\n263-      if (settled) return;\n264-      settled = true;\n265-      if (timer) clearTimeout(timer);\n266-      if (socket) socket.destroy();\n267-      resolve({ status, reason });\n268-    };\n269-\n270-    try {\n271-      socket = connect(toConnectionOptions(socketPath));\n272-    } catch (error) {\n273-      finish('dead', error instanceof Error ? error.message : 'connect-threw');\n274-      return;\n275-    }\n276-\n277-    timer = setTimeout(() => finish('dead', 'timeout'), timeoutMs);\n278-    timer.unref?.();\n279-\n280-    socket.once('connect', () => {\n281-      if (!deepProbe) {\n282-        finish('alive', 'connect-ok');\n283-        return;\n284-      }\n285-      socket.write(request);\n286-    });\n287-    socket.on('data', (chunk) => {\n288-      buffer += Buffer.isBuffer(chunk) ? decoder.write(chunk) : String(chunk ?? '');\n289-      let newlineIndex = buffer.indexOf('\\n');\n290-      while (newlineIndex !== -1) {\n291-        const line = buffer.slice(0, newlineIndex).trim();\n292-        buffer = buffer.slice(newlineIndex + 1);\n293-        newlineIndex = buffer.indexOf('\\n');\n294-        if (!line) continue;\n295-        try {\n296-          const parsed = JSON.parse(line);\n297-          if (\n298-            parsed &&\n299-            parsed.jsonrpc === '2.0' &&\n300-            parsed.id === id &&\n301-            (Object.prototype.hasOwnProperty.call(parsed, 'result') ||\n302-              Object.prototype.hasOwnProperty.call(parsed, 'error'))\n303-          ) {\n304-            finish('alive', 'json-rpc-reply');\n305-            return;\n306-          }\n307-        } catch {\n308-          // Ignore malformed or unrelated frames; the bounded probe decides liveness.\n309-        }\n310-      }\n311-    });\n312-    socket.once('error', (error) => {\n313-      finish('dead', error instanceof Error ? error.message : 'socket-error');\n314-    });\n315-    socket.once('close', () => {\n316-      finish('dead', 'closed-before-reply');\n317-    });\n318-  });\n319-}\n--\n469:async function maybeBridgeLeaseHolder(options) {\n470-  const {\n471-    serviceName,\n472-    leaseResult,\n473-    loggerPrefix,\n474-    dbDir,\n475-    legacyReport,\n476-    probeTimeoutMs,\n477-    connect,\n478-    bridge,\n479-    respawnOnMissingSocket = false,\n480-  } = options;\n481-  const startedAt = leaseResult.startedAt ?? new Date(0).toISOString();\n482-  const legacyMarker = leaseResult.legacyPath ? ' (legacy path)' : '';\n483-  const ownerPid = leaseResult.ownerPid;\n484-  const writeLeaseHeld = (suffix = '') => {\n485-    process.stdout.write(`LEASE_HELD_BY:${ownerPid} startedAt=${startedAt}${legacyMarker}${suffix}\\n`);\n486-  };\n487-\n488-  if (process.env.SPECKIT_LAUNCHER_BRIDGE_DISABLED === '1') {\n489-    if (legacyReport) {\n490-      legacyReport(leaseResult);\n491-      return { action: 'report', reason: 'bridge-disabled' };\n492-    }\n493-    writeLeaseHeld();\n494-    return { action: 'report', reason: 'bridge-disabled' };\n495-  }\n496-\n497-  // Prefer the path the lease owner actually recorded over recomputing one from env. Under a\n498-  // divergent SPECKIT_IPC_SOCKET_DIR (e.g. a secondary launcher in a different worktree env), the\n499-  // recomputed path can miss the live socket and false-report 'no-bridge-socket'. Only trust the\n500-  // stored path when it still exists on disk; tcp:// endpoints bypass the existence check. Fall back\n501-  // to recomputation for legacy leases that predate socketPath and for the other launchers whose\n502-  // leases never carry it.\n503-  const storedSocketPath = leaseResult.socketPath;\n504-  const recomputedSocketPath = getIpcSocketPath(serviceName, { dbDir });\n505-  const socketDir = process.env.SPECKIT_IPC_SOCKET_DIR ?? DEFAULT_SKILL_ADVISOR_SOCKET_DIR;\n506-  const scopedSocket = shouldScopeIpcSocket(serviceName, socketDir);\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"cd /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research && grep -n \\\"maybeBridgeLeaseHolder\\\" -A 80 .skilled/bin/lib/launcher-ipc-bridge.cjs | head -120\"}"},"time":{"start":1794541227205,"end":1794541227736}}}}
