onst SANDBOX_PROCESS_HINTS = ['advisor-server.js', 'system-skill-advisor-launcher.cjs'];\n const HOOK_TIMEOUT_MS = 30000;\n const MAX_STDOUT_BYTES = 8 * 1024 * 1024;\n const COMMAND_PATTERN = /^\\/[a-z][a-z-]*:[a-z][a-z-]*$/;\n const POLICIES = new Set(['run', 'start', 'ask']);\n","status":"modified","additions":1,"deletions":0}],"truncated":false},"content":[{"type":"text","text":"Edited specs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/011-typed-command-delivery-and-guards/scratch/typed-heads.mjs (1 replacement)"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\"specs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/011-typed-command-delivery-and-guards/scratch/typed-heads.mjs\",\"oldString\":\"const SANDBOX_PREFIX = 'ssa-typed-';\\nconst HOOK_TIMEOUT_MS = 30000;\",\"newString\":\"const SANDBOX_PREFIX = 'ssa-typed-';\\nconst SANDBOX_PROCESS_HINTS = ['advisor-server.js', 'system-skill-advisor-launcher.cjs'];\\nconst HOOK_TIMEOUT_MS = 30000;\"}"},"time":{"start":1794541384447,"end":1794541385549}}}}
