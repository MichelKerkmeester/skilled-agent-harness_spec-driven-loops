ped-command-delivery-and-guards/scratch/typed-heads.mjs\n@@ -239,8 +239,11 @@\n     const rows = [];\n     for (const row of selected) {\n       rows.push(measureRow(row, options.root, sandboxDir, hookPath, parseOffer));\n     }\n+    // Id order keeps the artifact stable across corpus reorderings, so two runs\n+    // of the same checkout produce the same file.\n+    rows.sort((left, right) => (left.id < right.id ? -1 : left.id > right.id ? 1 : 0));\n     writeFileSync(OUTPUT_PATH, `${JSON.stringify(rows, null, 2)}\\n`, 'utf8');\n   } finally {\n     stopSandboxProcesses(sandboxDir);\n     rmSync(sandboxDir, { recursive: true, force: true });\n","status":"modified","additions":3,"deletions":0}],"truncated":false},"content":[{"type":"text","text":"Edited specs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/011-typed-command-delivery-and-guards/scratch/typed-heads.mjs (1 replacement)"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\"specs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/011-typed-command-delivery-and-guards/scratch/typed-heads.mjs\",\"oldString\":\"    const rows = [];\\n    for (const row of selected) {\\n      rows.push(measureRow(row, options.root, sandboxDir, hookPath, parseOffer));\\n    }\\n    writeFileSync(OUTPUT_PATH, `${JSON.stringify(rows, null, 2)}\\\\n`, 'utf8');\",\"newString\":\"    const rows = [];\\n    for (const row of selected) {\\n      rows.push(measureRow(row, options.root, sandboxDir, hookPath, parseOffer));\\n    }\\n    // Id order keeps the artifact stable across corpus reorderings, so two runs\\n    // of the same checkout produce the same file.\\n    rows.sort((left, right) => (left.id < right.id ? -1 : left.id > right.id ? 1 : 0));\\n    writeFileSync(OUTPUT_PATH, `${JSON.stringify(rows, null, 2)}\\\\n`, 'utf8');\"}"},"time":{"start":1794541442552,"end":1794541444313}}}}
