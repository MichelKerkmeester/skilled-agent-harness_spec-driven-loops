{"type":"tool_use","timestamp":1794540991289,"sessionID":"ses_e2d068ceaffe9O3kC6bqSOeD4D","part":{"partID":"prt_1d2fa3a2f002Bq5q6YpMj2AavX","sessionID":"ses_e2d068ceaffe9O3kC6bqSOeD4D","messageID":"msg_1d2fa0649001V73Y42NgCWELGV","type":"tool","id":"call_cd3df076df824db68652d450","tool":"write","state":{"status":"completed","input":{"path":"specs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/011-typed-command-delivery-and-guards/scratch/typed-heads.mjs","content":"// ───────────────────────────────────────────────────────────────────\n// MODULE: TYPED HEAD OFFERS\n// ───────────────────────────────────────────────────────────────────\n//\n// Checks what the Claude prompt hook really puts on the first line of the\n// advisor head for a typed command prompt. Every row runs through the installed\n// hook, and the recorded command and policy are read back with the same parser\n// the run log uses, so the measurement answers for the text a session receives\n// rather than for what the ranking was expected to say.\n//\n// The run keeps its IPC socket in a fresh directory so it never reaches the\n// operator's warm daemon. The directory is the only thing that ties the hook\n// processes together, and it is removed once every row has run.\n//\n// Usage:\n//   node typed-heads.mjs [--root <dir>]\n//\n// `--root` names a checkout the corpus and hook are read from, and defaults to\n// the current directory. The result is written beside this script.\n//\n// A prompt is never printed, so a failure report carries row ids only.\n\n// ───────────────────────────────────────────────────────────────────\n// 1. IMPORTS\n// ───────────────────────────────────────────────────────────────────\n\nimport { execFileSync, spawnSync } from 'node:child_process';\nimport { existsSync, mkdtempSync, readFileSync, rmSync, writeFileSync } from 'node:fs';\nimport { tmpdir } from 'node:os';\nimport { dirname, join, resolve } from 'node:path';\nimport { fileURLToPath, pathToFileURL } from 'node:url';\n\n// ───────────────────────────────────────────────────────────────────\n// 2. CONSTANTS\n// ───────────────────────────────────────────────────────────────────\n\nconst HERE = dirname(fileURLToPath(import.meta.url));\nconst OUTPUT_PATH = join(HERE, 'typed-heads.json');\nconst CORPUS_REL = '.skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/command-prompts.jsonl';\nconst OFFER_REL = '.skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/command-offer.mjs';\nconst HOOK_REL = '.skilled/skills/system-spec-kit/runtime/dist/hooks/claude/user-prompt-submit.js';\nconst SANDBOX_PREFIX = 'ssa-typed-';\nconst HOOK_TIMEOUT_MS = 30000;\nconst MAX_STDOUT_BYTES = 8 * 1024 * 1024;\nconst COMMAND_PATTERN = /^\\/[a-z][a-z-]*:[a-z][a-z-]*$/;\nconst POLICIES = new Set(['run', 'start', 'ask']);\n\n// ───────────────────────────────────────────────────────────────────\n// 3. ARGUMENT PARSING\n// ───────────────────────────────────────────────────────────────────\n\nfunction usageError(message) {\n  process.stderr.write(`typed-heads.mjs: ${message}\\n`);\n  process.stderr.write('usage: typed-heads.mjs [--root <dir>]\\n');\n  process.exit(2);\n}\n\nfunction parseArgs(argv) {\n  const options = { root: process.cwd() };\n  for (let index = 0; index < argv.length; index += 1) {\n    const token = argv[index];\n    if (token !== '--root') usageError(`unknown option: ${token}`);\n    const value = argv[index + 1];\n    if (value === undefined || value.startsWith('--')) usageError(`${token} needs a value`);\n    options.root = resolve(value);\n    index += 1;\n  }\n  return options;\n}\n\n// ───────────────────────────────────────────────────────────────────\n// 4. CORPUS SELECTION\n// ───────────────────────────────────────────────────────────────────\n\nfunction readCorpus(path) {\n  if (!existsSync(path)) {\n    process.stderr.write(`typed-heads.mjs: corpus file missing: ${path}\\n`);\n    process.exit(2);\n  }\n  const rows = [];\n  const lines = readFileSync(path, 'utf8').split('\\n');\n  for (let index = 0; index < lines.length; index += 1) {\n    const line = lines[index].trim();\n    if (line === '') continue;\n    try {\n      rows.push(JSON.parse(line));\n    } catch (error) {\n      process.stderr.write(`typed-heads.mjs: invalid JSON on corpus line ${index + 1}: ${error.message}\\n`);\n      process.exit(2);\n    }\n  }\n  return rows;\n}\n\n// The measured half is the only half read here. A holdout row is skipped by the\n// split filter before any prompt is touched, so its text never reaches a process\n// argument and never appears in the output.\nfunction selectRows(rows) {\n  return rows.filter((row) => row.row_type === 'typed' && row.split === 'none');\n}\n\n// ───────────────────────────────────────────────────────────────────\n// 5. HEAD MEASUREMENT\n// ───────────────────────────────────────────────────────────────────\n\n// The hook fails open with a directive block, so a missing context field is a\n// missing head rather than an error. Stdout is parsed whole because the shim\n// prints exactly one JSON envelope.\nfunction firstHeadLine(stdout) {\n  if (typeof stdout !== 'string' || stdout.trim() === '') return '';\n  try {\n    const value = JSON.parse(stdout)?.hookSpecificOutput?.additionalContext;\n    if (typeof value !== 'string') return '';\n    const [firstLine = ''] = value.split(/\\r?\\n/);\n    return firstLine;\n  } catch {\n    return '';\n  }\n}\n\n// The offer may carry a trailing example argument. Only the command token is\n// compared, because the corpus records the command without an argument.\nfunction commandToken(offer) {\n  if (typeof offer !== 'string') return null;\n  const [token = ''] = offer.split(' ');\n  return COMMAND_PATTERN.test(token) ? token : null;\n}\n\nfunction measureRow(row, root, socketDir, hookPath, parseOffer) {\n  const payload = JSON.stringify({\n    prompt: row.prompt,\n    cwd: root,\n    hook_event_name: 'UserPromptSubmit',\n    session_id: `typed-${row.id}`,\n  });\n  const result = spawnSync(process.execPath, [hookPath], {\n    cwd: root,\n    input: payload,\n    encoding: 'utf8',\n    env: { ...process.env, SPECKIT_IPC_SOCKET_DIR: socketDir },\n    timeout: HOOK_TIMEOUT_MS,\n    maxBuffer: MAX_STDOUT_BYTES,\n  });\n  const { offeredCommand, offeredPolicy } = parseOffer(firstHeadLine(result.stdout));\n  const offeredToken = commandToken(offeredCommand);\n  return {\n    id: row.id,\n    offeredCommand,\n    offeredPolicy,\n    commandMatches: offeredToken !== null && offeredToken === row.expected_command,\n    policyPresent: typeof offeredPolicy === 'string' && POLICIES.has(offeredPolicy),\n    labelAgrees: offeredPolicy === row.expected_policy,\n  };\n}\n\n// ───────────────────────────────────────────────────────────────────\n// 6. SANDBOX CLEANUP\n// ───────────────────────────────────────────────────────────────────\n\nfunction processRows() {\n  const output = execFileSync('ps', ['-axo', 'pid=,command='], {\n    encoding: 'utf8',\n    stdio: ['ignore', 'pipe', 'ignore'],\n  });\n  const rows = [];\n  for (const line of output.split('\\n')) {\n    const match = /^\\s*(\\d+)\\s+(.*)$/.exec(line);\n    if (match === null) continue;\n    rows.push({ pid: Number(match[1]), command: match[2] });\n  }\n  return rows;\n}\n\n// A sandbox process is identified by the directory on its own command line, so\n// no pid is signalled on trust alone and an unrelated daemon is never touched.\nfunction stopSandboxProcesses(socketDir) {\n  for (const row of processRows()) {\n    if (row.pid === process.pid || !row.command.includes(socketDir)) continue;\n    try {\n      process.kill(row.pid, 'SIGTERM');\n    } catch (error) {\n      if (error?.code !== 'ESRCH') throw error;\n    }\n  }\n}\n\n// ───────────────────────────────────────────────────────────────────\n// 7. ENTRY\n// ───────────────────────────────────────────────────────────────────\n\nasync function main() {\n  const options = parseArgs(process.argv.slice(2));\n  const corpusPath = join(options.root, CORPUS_REL);\n  const hookPath = join(options.root, HOOK_REL);\n  const offerModulePath = join(options.root, OFFER_REL);\n  if (!existsSync(hookPath)) {\n    process.stderr.write(`typed-heads.mjs: hook file missing: ${hookPath}\\n`);\n    process.exit(2);\n  }\n  if (!existsSync(offerModulePath)) {\n    process.stderr.write(`typed-heads.mjs: offer module missing: ${offerModulePath}\\n`);\n    process.exit(2);\n  }\n  const { parseOffer } = await import(pathToFileURL(offerModulePath).href);\n  const selected = selectRows(readCorpus(corpusPath));\n\n  const socketDir = mkdtempSync(join(tmpdir(), SANDBOX_PREFIX));\n  try {\n    const rows = [];\n    for (const row of selected) {\n      rows.push(measureRow(row, options.root, socketDir, hookPath, parseOffer));\n    }\n    writeFileSync(OUTPUT_PATH, `${JSON.stringify(rows, null, 2)}\\n`, 'utf8');\n  } finally {\n    stopSandboxProcesses(socketDir);\n    rmSync(socketDir, { recursive: true, force: true });\n  }\n}\n\nawait main();\n"},"output":"Created file successfully: specs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/011-typed-command-delivery-and-guards/scratch/typed-heads.mjs","title":"write","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Created file successfully: specs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/011-typed-command-delivery-and-guards/scratch/typed-heads.mjs"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\"specs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/011-typed-command-delivery-and-guards/scratch/typed-heads.mjs\",\"content\":\"// ───────────────────────────────────────────────────────────────────\\n// MODULE: TYPED HEAD OFFERS\\n// ───────────────────────────────────────────────────────────────────\\n//\\n// Checks what the Claude prompt hook really puts on the first line of the\\n// advisor head for a typed command prompt. Every row runs through the installed\\n// hook, and the recorded command and policy are read back with the same parser\\n// the run log uses, so the measurement answers for the text a session receives\\n// rather than for what the ranking was expected to say.\\n//\\n// The run keeps its IPC socket in a fresh directory so it never reaches the\\n// operator's warm daemon. The directory is the only thing that ties the hook\\n// processes together, and it is removed once every row has run.\\n//\\n// Usage:\\n//   node typed-heads.mjs [--root <dir>]\\n//\\n// `--root` names a checkout the corpus and hook are read from, and defaults to\\n// the current directory. The result is written beside this script.\\n//\\n// A prompt is never printed, so a failure report carries row ids only.\\n\\n// ───────────────────────────────────────────────────────────────────\\n// 1. IMPORTS\\n// ───────────────────────────────────────────────────────────────────\\n\\nimport { execFileSync, spawnSync } from 'node:child_process';\\nimport { existsSync, mkdtempSync, readFileSync, rmSync, writeFileSync } from 'node:fs';\\nimport { tmpdir } from 'node:os';\\nimport { dirname, join, resolve } from 'node:path';\\nimport { fileURLToPath, pathToFileURL } from 'node:url';\\n\\n// ───────────────────────────────────────────────────────────────────\\n// 2. CONSTANTS\\n// ───────────────────────────────────────────────────────────────────\\n\\nconst HERE = dirname(fileURLToPath(import.meta.url));\\nconst OUTPUT_PATH = join(HERE, 'typed-heads.json');\\nconst CORPUS_REL = '.skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/command-prompts.jsonl';\\nconst OFFER_REL = '.skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/command-offer.mjs';\\nconst HOOK_REL = '.skilled/skills/system-spec-kit/runtime/dist/hooks/claude/user-prompt-submit.js';\\nconst SANDBOX_PREFIX = 'ssa-typed-';\\nconst HOOK_TIMEOUT_MS = 30000;\\nconst MAX_STDOUT_BYTES = 8 * 1024 * 1024;\\nconst COMMAND_PATTERN = /^\\\\/[a-z][a-z-]*:[a-z][a-z-]*$/;\\nconst POLICIES = new Set(['run', 'start', 'ask']);\\n\\n// ───────────────────────────────────────────────────────────────────\\n// 3. ARGUMENT PARSING\\n// ───────────────────────────────────────────────────────────────────\\n\\nfunction usageError(message) {\\n  process.stderr.write(`typed-heads.mjs: ${message}\\\\n`);\\n  process.stderr.write('usage: typed-heads.mjs [--root <dir>]\\\\n');\\n  process.exit(2);\\n}\\n\\nfunction parseArgs(argv) {\\n  const options = { root: process.cwd() };\\n  for (let index = 0; index < argv.length; index += 1) {\\n    const token = argv[index];\\n    if (token !== '--root') usageError(`unknown option: ${token}`);\\n    const value = argv[index + 1];\\n    if (value === undefined || value.startsWith('--')) usageError(`${token} needs a value`);\\n    options.root = resolve(value);\\n    index += 1;\\n  }\\n  return options;\\n}\\n\\n// ───────────────────────────────────────────────────────────────────\\n// 4. CORPUS SELECTION\\n// ───────────────────────────────────────────────────────────────────\\n\\nfunction readCorpus(path) {\\n  if (!existsSync(path)) {\\n    process.stderr.write(`typed-heads.mjs: corpus file missing: ${path}\\\\n`);\\n    process.exit(2);\\n  }\\n  const rows = [];\\n  const lines = readFileSync(path, 'utf8').split('\\\\n');\\n  for (let index = 0; index < lines.length; index += 1) {\\n    const line = lines[index].trim();\\n    if (line === '') continue;\\n    try {\\n      rows.push(JSON.parse(line));\\n    } catch (error) {\\n      process.stderr.write(`typed-heads.mjs: invalid JSON on corpus line ${index + 1}: ${error.message}\\\\n`);\\n      process.exit(2);\\n    }\\n  }\\n  return rows;\\n}\\n\\n// The measured half is the only half read here. A holdout row is skipped by the\\n// split filter before any prompt is touched, so its text never reaches a process\\n// argument and never appears in the output.\\nfunction selectRows(rows) {\\n  return rows.filter((row) => row.row_type === 'typed' && row.split === 'none');\\n}\\n\\n// ───────────────────────────────────────────────────────────────────\\n// 5. HEAD MEASUREMENT\\n// ───────────────────────────────────────────────────────────────────\\n\\n// The hook fails open with a directive block, so a missing context field is a\\n// missing head rather than an error. Stdout is parsed whole because the shim\\n// prints exactly one JSON envelope.\\nfunction firstHeadLine(stdout) {\\n  if (typeof stdout !== 'string' || stdout.trim() === '') return '';\\n  try {\\n    const value = JSON.parse(stdout)?.hookSpecificOutput?.additionalContext;\\n    if (typeof value !== 'string') return '';\\n    const [firstLine = ''] = value.split(/\\\\r?\\\\n/);\\n    return firstLine;\\n  } catch {\\n    return '';\\n  }\\n}\\n\\n// The offer may carry a trailing example argument. Only the command token is\\n// compared, because the corpus records the command without an argument.\\nfunction commandToken(offer) {\\n  if (typeof offer !== 'string') return null;\\n  const [token = ''] = offer.split(' ');\\n  return COMMAND_PATTERN.test(token) ? token : null;\\n}\\n\\nfunction measureRow(row, root, socketDir, hookPath, parseOffer) {\\n  const payload = JSON.stringify({\\n    prompt: row.prompt,\\n    cwd: root,\\n    hook_event_name: 'UserPromptSubmit',\\n    session_id: `typed-${row.id}`,\\n  });\\n  const result = spawnSync(process.execPath, [hookPath], {\\n    cwd: root,\\n    input: payload,\\n    encoding: 'utf8',\\n    env: { ...process.env, SPECKIT_IPC_SOCKET_DIR: socketDir },\\n    timeout: HOOK_TIMEOUT_MS,\\n    maxBuffer: MAX_STDOUT_BYTES,\\n  });\\n  const { offeredCommand, offeredPolicy } = parseOffer(firstHeadLine(result.stdout));\\n  const offeredToken = commandToken(offeredCommand);\\n  return {\\n    id: row.id,\\n    offeredCommand,\\n    offeredPolicy,\\n    commandMatches: offeredToken !== null && offeredToken === row.expected_command,\\n    policyPresent: typeof offeredPolicy === 'string' && POLICIES.has(offeredPolicy),\\n    labelAgrees: offeredPolicy === row.expected_policy,\\n  };\\n}\\n\\n// ───────────────────────────────────────────────────────────────────\\n// 6. SANDBOX CLEANUP\\n// ───────────────────────────────────────────────────────────────────\\n\\nfunction processRows() {\\n  const output = execFileSync('ps', ['-axo', 'pid=,command='], {\\n    encoding: 'utf8',\\n    stdio: ['ignore', 'pipe', 'ignore'],\\n  });\\n  const rows = [];\\n  for (const line of output.split('\\\\n')) {\\n    const match = /^\\\\s*(\\\\d+)\\\\s+(.*)$/.exec(line);\\n    if (match === null) continue;\\n    rows.push({ pid: Number(match[1]), command: match[2] });\\n  }\\n  return rows;\\n}\\n\\n// A sandbox process is identified by the directory on its own command line, so\\n// no pid is signalled on trust alone and an unrelated daemon is never touched.\\nfunction stopSandboxProcesses(socketDir) {\\n  for (const row of processRows()) {\\n    if (row.pid === process.pid || !row.command.includes(socketDir)) continue;\\n    try {\\n      process.kill(row.pid, 'SIGTERM');\\n    } catch (error) {\\n      if (error?.code !== 'ESRCH') throw error;\\n    }\\n  }\\n}\\n\\n// ───────────────────────────────────────────────────────────────────\\n// 7. ENTRY\\n// ───────────────────────────────────────────────────────────────────\\n\\nasync function main() {\\n  const options = parseArgs(process.argv.slice(2));\\n  const corpusPath = join(options.root, CORPUS_REL);\\n  const hookPath = join(options.root, HOOK_REL);\\n  const offerModulePath = join(options.root, OFFER_REL);\\n  if (!existsSync(hookPath)) {\\n    process.stderr.write(`typed-heads.mjs: hook file missing: ${hookPath}\\\\n`);\\n    process.exit(2);\\n  }\\n  if (!existsSync(offerModulePath)) {\\n    process.stderr.write(`typed-heads.mjs: offer module missing: ${offerModulePath}\\\\n`);\\n    process.exit(2);\\n  }\\n  const { parseOffer } = await import(pathToFileURL(offerModulePath).href);\\n  const selected = selectRows(readCorpus(corpusPath));\\n\\n  const socketDir = mkdtempSync(join(tmpdir(), SANDBOX_PREFIX));\\n  try {\\n    const rows = [];\\n    for (const row of selected) {\\n      rows.push(measureRow(row, options.root, socketDir, hookPath, parseOffer));\\n    }\\n    writeFileSync(OUTPUT_PATH, `${JSON.stringify(rows, null, 2)}\\\\n`, 'utf8');\\n  } finally {\\n    stopSandboxProcesses(socketDir);\\n    rmSync(socketDir, { recursive: true, force: true });\\n  }\\n}\\n\\nawait main();\\n\"}"},"time":{"start":1794540976687,"end":1794540991289}}}}
