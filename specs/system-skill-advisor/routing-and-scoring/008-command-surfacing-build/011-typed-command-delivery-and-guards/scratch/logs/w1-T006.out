{"type":"tool_use","timestamp":1794539718563,"sessionID":"ses_e2d1dfed7ffelzC6M9OLNWqvFE","part":{"partID":"prt_1d2e70577002qcmZf4vm6PIqdI","sessionID":"ses_e2d1dfed7ffelzC6M9OLNWqvFE","messageID":"msg_1d2e6c20d001dGSIJQeDsBNdqd","type":"tool","id":"call_6869267eddb94774bc5575c0","tool":"shell","state":{"status":"completed","input":{"command":"sed -n 1,120p .skilled/skills/system-skill-advisor/runtime/dist/hooks/claude/user-prompt-submit.js","workdir":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research"},"output":"#!/usr/bin/env node\n// ───────────────────────────────────────────────────────────────\n// MODULE: UserPromptSubmit Hook — Skill Advisor Brief\n// ───────────────────────────────────────────────────────────────\n// Runs on Claude Code UserPromptSubmit. Emits a JSON additionalContext\n// envelope for model-visible advisor guidance and fails open on all errors.\n// ───────────────────────────────────────────────────────────────\n// 1. IMPORTS\n// ───────────────────────────────────────────────────────────────\nimport { statSync } from 'node:fs';\nimport { createRequire } from 'node:module';\nimport { performance } from 'node:perf_hooks';\nimport { resolve } from 'node:path';\nimport { fileURLToPath } from 'node:url';\nimport { isAdvisorRuntime } from '../../runtime/lib/advisor-runtime-values.js';\nimport { findAdvisorWorkspaceRoot } from '../../runtime/lib/utils/workspace-root.js';\nimport { buildSkillAdvisorBrief, skippedAdvisorResultFor, } from '../../runtime/lib/skill-advisor-brief.js';\nimport { decideDirectiveLifecycleDelivery, defaultDirectiveLifecycleStore, isDirectiveLifecycleDedupEnabled, } from '../lib/directive-lifecycle.js';\nimport { renderAdvisorBrief, renderAdvisorFallbackDirective, observeEmittedAdvisorPolicy, } from '../../runtime/lib/render.js';\nimport { createAdvisorHookDiagnosticRecord, persistAdvisorHookDiagnosticRecord, serializeAdvisorHookDiagnosticRecord, } from '../../runtime/lib/metrics.js';\nimport { buildSkillAdvisorBriefFromCli } from '../lib/skill-advisor-cli-fallback.js';\nexport { renderAdvisorFallbackDirective };\n// ───────────────────────────────────────────────────────────────\n// 2. CONFIGURATION\n// ───────────────────────────────────────────────────────────────\nconst IS_CLI_ENTRY = process.argv[1]\n    ? resolve(process.argv[1]) === fileURLToPath(import.meta.url)\n    : false;\nconst requireFromAdvisor = createRequire(import.meta.url);\n// Setup, install and configure words trigger the hint; check needs nearby tooling context.\n// Bounded context keeps unrelated checks quiet without scanning long prompts.\nexport const SETUP_WORDING = new RegExp(String.raw `\\b(?:set[\\s-]?up|setups?`\n    + String.raw `|(?:re)?install(?:s|ed|ing|ation|er|ers)?`\n    + String.raw `|configur(?:e|es|ed|ing|ations?)`\n    + String.raw `|check(?:s|ed|ing)?(?:\\s+\\S+){0,2}?\\s+`\n    + String.raw `(?:environment|env|config(?:s|urations?)?`\n    + String.raw `|hooks?|tools|tooling|toolchain|skilled))\\b`, 'i');\nfunction skillAdvisorHookEnabled() {\n    try {\n        const { isHookEnabled } = requireFromAdvisor(fileURLToPath(new URL('../../../../../../hooks/shared/hook-flags.cjs', import.meta.url)));\n        return typeof isHookEnabled !== 'function' || isHookEnabled('skill-advisor') !== false;\n    }\n    catch {\n        return true;\n    }\n}\n// ───────────────────────────────────────────────────────────────\n// 4. CONSTANTS\n// ───────────────────────────────────────────────────────────────\nexport const DEFAULT_CLAUDE_HOOK_TIMEOUT_MS = 2500;\nconst MAX_PROMPT_BYTES = 64 * 1024;\nconst OBSERVED_ADVISOR_POLICY_CANDIDATE = '004';\nconst DIRECTIVE_RECEIPT_COMMIT = Symbol('directiveReceiptCommit');\nconst pendingDiagnosticWrites = new Set();\n// ───────────────────────────────────────────────────────────────\n// 5. HELPERS\n// ───────────────────────────────────────────────────────────────\nfunction isRecord(value) {\n    return typeof value === 'object' && value !== null && !Array.isArray(value);\n}\nfunction normalizePrompt(value) {\n    if (typeof value !== 'string') {\n        return null;\n    }\n    if (Buffer.byteLength(value, 'utf8') <= MAX_PROMPT_BYTES) {\n        return value;\n    }\n    let low = 0;\n    let high = value.length;\n    while (low < high) {\n        const midpoint = Math.ceil((low + high) / 2);\n        if (Buffer.byteLength(value.slice(0, midpoint), 'utf8') <= MAX_PROMPT_BYTES) {\n            low = midpoint;\n        }\n        else {\n            high = midpoint - 1;\n        }\n    }\n    return value.slice(0, low);\n}\nexport function workspaceRootFor(input) {\n    const start = typeof input.cwd === 'string' && input.cwd.trim().length > 0\n        ? input.cwd\n        : process.cwd();\n    // Anchor to the real repo root. A raw session cwd inside a specs/<packet>\n    // directory would otherwise become the \"workspace root\", and the advisor's\n    // state writers materialize a stray .state/advisor tree under it.\n    return findAdvisorWorkspaceRoot(start);\n}\nfunction skillLabelFor(result) {\n    const metadataLabel = result.sharedPayload?.metadata?.skillLabel;\n    if (typeof metadataLabel === 'string') {\n        return metadataLabel;\n    }\n    return result.recommendations[0]?.skill ?? null;\n}\nfunction positiveIntFromEnv(value, fallback) {\n    if (typeof value !== 'string' || value.trim().length === 0) {\n        return fallback;\n    }\n    const parsed = Number.parseInt(value, 10);\n    return Number.isFinite(parsed) && parsed > 0 ? parsed : fallback;\n}\nfunction claudeHookTimeoutMs() {\n    return positiveIntFromEnv(process.env.SPECKIT_CLAUDE_HOOK_TIMEOUT_MS, DEFAULT_CLAUDE_HOOK_TIMEOUT_MS);\n}\nfunction lifecycleEventFor(input) {\n    const explicit = input.lifecycle_event ?? input.lifecycle_source;\n    if (explicit === 'startup' || explicit === 'resume' || explicit === 'compact') {\n        return explicit;\n    }\n    if (input.hook_event_name === 'SessionStart'\n        && (input.source === 'startup' || input.source === 'resume' || input.source === 'compact')) {\n        return input.source;\n    }\n    return undefined;\n}\n/** Convert runtime-owned identity and lifecycle fields into shadow-only signals. */\nexport function deliveryStateOptionsFor(input) {\n    const hasSessionId = typeof input.session_id === 'string' && input.session_id.trim().length > 0;\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"#!/usr/bin/env node\n// ───────────────────────────────────────────────────────────────\n// MODULE: UserPromptSubmit Hook — Skill Advisor Brief\n// ───────────────────────────────────────────────────────────────\n// Runs on Claude Code UserPromptSubmit. Emits a JSON additionalContext\n// envelope for model-visible advisor guidance and fails open on all errors.\n// ───────────────────────────────────────────────────────────────\n// 1. IMPORTS\n// ───────────────────────────────────────────────────────────────\nimport { statSync } from 'node:fs';\nimport { createRequire } from 'node:module';\nimport { performance } from 'node:perf_hooks';\nimport { resolve } from 'node:path';\nimport { fileURLToPath } from 'node:url';\nimport { isAdvisorRuntime } from '../../runtime/lib/advisor-runtime-values.js';\nimport { findAdvisorWorkspaceRoot } from '../../runtime/lib/utils/workspace-root.js';\nimport { buildSkillAdvisorBrief, skippedAdvisorResultFor, } from '../../runtime/lib/skill-advisor-brief.js';\nimport { decideDirectiveLifecycleDelivery, defaultDirectiveLifecycleStore, isDirectiveLifecycleDedupEnabled, } from '../lib/directive-lifecycle.js';\nimport { renderAdvisorBrief, renderAdvisorFallbackDirective, observeEmittedAdvisorPolicy, } from '../../runtime/lib/render.js';\nimport { createAdvisorHookDiagnosticRecord, persistAdvisorHookDiagnosticRecord, serializeAdvisorHookDiagnosticRecord, } from '../../runtime/lib/metrics.js';\nimport { buildSkillAdvisorBriefFromCli } from '../lib/skill-advisor-cli-fallback.js';\nexport { renderAdvisorFallbackDirective };\n// ───────────────────────────────────────────────────────────────\n// 2. CONFIGURATION\n// ───────────────────────────────────────────────────────────────\nconst IS_CLI_ENTRY = process.argv[1]\n    ? resolve(process.argv[1]) === fileURLToPath(import.meta.url)\n    : false;\nconst requireFromAdvisor = createRequire(import.meta.url);\n// Setup, install and configure words trigger the hint; check needs nearby tooling context.\n// Bounded context keeps unrelated checks quiet without scanning long prompts.\nexport const SETUP_WORDING = new RegExp(String.raw `\\b(?:set[\\s-]?up|setups?`\n    + String.raw `|(?:re)?install(?:s|ed|ing|ation|er|ers)?`\n    + String.raw `|configur(?:e|es|ed|ing|ations?)`\n    + String.raw `|check(?:s|ed|ing)?(?:\\s+\\S+){0,2}?\\s+`\n    + String.raw `(?:environment|env|config(?:s|urations?)?`\n    + String.raw `|hooks?|tools|tooling|toolchain|skilled))\\b`, 'i');\nfunction skillAdvisorHookEnabled() {\n    try {\n        const { isHookEnabled } = requireFromAdvisor(fileURLToPath(new URL('../../../../../../hooks/shared/hook-flags.cjs', import.meta.url)));\n        return typeof isHookEnabled !== 'function' || isHookEnabled('skill-advisor') !== false;\n    }\n    catch {\n        return true;\n    }\n}\n// ───────────────────────────────────────────────────────────────\n// 4. CONSTANTS\n// ───────────────────────────────────────────────────────────────\nexport const DEFAULT_CLAUDE_HOOK_TIMEOUT_MS = 2500;\nconst MAX_PROMPT_BYTES = 64 * 1024;\nconst OBSERVED_ADVISOR_POLICY_CANDIDATE = '004';\nconst DIRECTIVE_RECEIPT_COMMIT = Symbol('directiveReceiptCommit');\nconst pendingDiagnosticWrites = new Set();\n// ───────────────────────────────────────────────────────────────\n// 5. HELPERS\n// ───────────────────────────────────────────────────────────────\nfunction isRecord(value) {\n    return typeof value === 'object' && value !== null && !Array.isArray(value);\n}\nfunction normalizePrompt(value) {\n    if (typeof value !== 'string') {\n        return null;\n    }\n    if (Buffer.byteLength(value, 'utf8') <= MAX_PROMPT_BYTES) {\n        return value;\n    }\n    let low = 0;\n    let high = value.length;\n    while (low < high) {\n        const midpoint = Math.ceil((low + high) / 2);\n        if (Buffer.byteLength(value.slice(0, midpoint), 'utf8') <= MAX_PROMPT_BYTES) {\n            low = midpoint;\n        }\n        else {\n            high = midpoint - 1;\n        }\n    }\n    return value.slice(0, low);\n}\nexport function workspaceRootFor(input) {\n    const start = typeof input.cwd === 'string' && input.cwd.trim().length > 0\n        ? input.cwd\n        : process.cwd();\n    // Anchor to the real repo root. A raw session cwd inside a specs/<packet>\n    // directory would otherwise become the \"workspace root\", and the advisor's\n    // state writers materialize a stray .state/advisor tree under it.\n    return findAdvisorWorkspaceRoot(start);\n}\nfunction skillLabelFor(result) {\n    const metadataLabel = result.sharedPayload?.metadata?.skillLabel;\n    if (typeof metadataLabel === 'string') {\n        return metadataLabel;\n    }\n    return result.recommendations[0]?.skill ?? null;\n}\nfunction positiveIntFromEnv(value, fallback) {\n    if (typeof value !== 'string' || value.trim().length === 0) {\n        return fallback;\n    }\n    const parsed = Number.parseInt(value, 10);\n    return Number.isFinite(parsed) && parsed > 0 ? parsed : fallback;\n}\nfunction claudeHookTimeoutMs() {\n    return positiveIntFromEnv(process.env.SPECKIT_CLAUDE_HOOK_TIMEOUT_MS, DEFAULT_CLAUDE_HOOK_TIMEOUT_MS);\n}\nfunction lifecycleEventFor(input) {\n    const explicit = input.lifecycle_event ?? input.lifecycle_source;\n    if (explicit === 'startup' || explicit === 'resume' || explicit === 'compact') {\n        return explicit;\n    }\n    if (input.hook_event_name === 'SessionStart'\n        && (input.source === 'startup' || input.source === 'resume' || input.source === 'compact')) {\n        return input.source;\n    }\n    return undefined;\n}\n/** Convert runtime-owned identity and lifecycle fields into shadow-only signals. */\nexport function deliveryStateOptionsFor(input) {\n    const hasSessionId = typeof input.session_id === 'string' && input.session_id.trim().length > 0;\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"sed -n 1,120p .skilled/skills/system-skill-advisor/runtime/dist/hooks/claude/user-prompt-submit.js\",\"workdir\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research\"}"},"time":{"start":1794539718007,"end":1794539718563}}}}
