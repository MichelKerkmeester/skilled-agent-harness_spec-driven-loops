probe = await probeLeaseHolderWithRetries(socketPath, {\n532-    firstTimeoutMs: probeTimeoutMs,\n533-    attempts: probeAttempts,\n534-    connect,\n535-    onRetry: (attempt, total, result) => process.stderr.write(\n536-      `[${loggerPrefix}] lease holder pid=${ownerPid} probe ${attempt}/${total} not alive (${result.reason}); retrying\\n`,\n537-    ),\n538-  });\n539-  if (probe.status !== 'alive') {\n540-    process.stderr.write(`[${loggerPrefix}] lease holder pid=${ownerPid} socket=${socketPath} failed ${probeAttempts} consecutive liveness probes: ${probe.reason}\\n`);\n541-    return { action: 'respawn', reason: probe.reason, socketPath };\n542-  }\n543-\n544-  process.stderr.write(`[${loggerPrefix}] bridging to lease holder pid=${ownerPid} socket=${socketPath}\\n`);\n545-  const bridgeToSocket = bridge ?? bridgeStdioToSocket;\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"469-async function maybeBridgeLeaseHolder(options) {\n470-  const {\n471-    serviceName,\n472-    leaseResult,\n473-    loggerPrefix,\n474-    dbDir,\n475-    legacyReport,\n476-    probeTimeoutMs,\n477-    connect,\n478-    bridge,\n479:    respawnOnMissingSocket = false,\n480-  } = options;\n481-  const startedAt = leaseResult.startedAt ?? new Date(0).toISOString();\n482-  const legacyMarker = leaseResult.legacyPath ? ' (legacy path)' : '';\n483-  const ownerPid = leaseResult.ownerPid;\n484-  const writeLeaseHeld = (suffix = '') => {\n485-    process.stdout.write(`LEASE_HELD_BY:${ownerPid} startedAt=${startedAt}${legacyMarker}${suffix}\\n`);\n486-  };\n487-\n488-  if (process.env.SPECKIT_LAUNCHER_BRIDGE_DISABLED === '1') {\n489-    if (legacyReport) {\n490-      legacyReport(leaseResult);\n491-      return { action: 'report', reason: 'bridge-disabled' };\n492-    }\n493-    writeLeaseHeld();\n494-    return { action: 'report', reason: 'bridge-disabled' };\n495-  }\n496-\n497-  // Prefer the path the lease owne