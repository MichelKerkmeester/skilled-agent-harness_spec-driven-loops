emon and\n526-  // hang it forever, never respawning. The raised probe timeout (default 5000ms, < the 7000ms launcher\n527-  // grace) already prevents false-reaping a busy-but-responsive daemon mid-FTS-merge, so deep probing\n528-  // does not regress that.\n529-  // Require N consecutive failures (not one transient miss) before reaping a sibling's owner.\n530-  const probeAttempts = resolveLeaseProbeAttempts();\n531-  const probe = await probeLeaseHolderWithRetries(socketPath, {\n532-    firstTimeoutMs: probeTimeoutMs,\n533-    attempts: probeAttempts,\n534-    connect,\n535-    onRetry: (attempt, total, result) => process.stderr.write(\n536-      `[${loggerPrefix}] lease holder pid=${ownerPid} probe ${attempt}/${total} not alive (${result.reason}); retrying\\n`,\n537-    ),\n538-  });\n539-  if (probe.status !== 'alive') {\n540-    process.stderr.write(`[${loggerPrefix}] lease holder pid=${ownerPid} socket=${socketPath} failed ${probeAttempts} consecutive liveness probes: ${probe.reason}\\n`);\n541-    return { action: 'respawn', reason: probe.reason, socketPath };\n542-  }\n543-\n544-  process.stderr.write(`[${loggerPrefix}] bridging to lease holder pid=${ownerPid} socket=${socketPath}\\n`);\n545-  const bridgeToSocket = bridge ?? bridgeStdioToSocket;\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"grep -n \\\"respawnOnMissingSocket\\\" -A 30 -B 10 .skilled/bin/lib/launcher-ipc-bridge.cjs | head -80\",\"workdir\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research\"}"},"time":{"start":1794539986872,"end":1794539987526}}}}
