─────────────────────────────────────────────────────────\n// 5. CORE LOGIC\n// ───────────────────────────────────────────────────────────────────\nfunction spawnLauncher(paths: RepoPaths): ChildProcess {\n  const child = spawn(process.execPath, [paths.launcherPath], {\n    cwd: paths.repoRoot,\n    env: process.env,\n    detached: true,\n    stdio: 'ignore',\n  });\n  child.unref();\n  // Handed back so the wait below can end the moment the launcher proves it cannot\n  // bring the socket up, instead of spending the rest of the budget on a dead process.\n  return child;\n}\n\nasync function waitForDaemon(\n  socketPath: string,\n  bridge: BridgeModule,\n  timeoutMs: number,\n  launcher?: ChildProcess,\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"  if (!best) return undefined;\n  const threshold = Math.max(2, Math.floor(normalizeName(command).length * 0.4));\n  return best.distance <= threshold ? best.command : undefined;\n}\n\nfunction unknownCommandContext(message: string): { readonly hint: string; readonly suggestion?: string } | null {\n  const match = message.match(/^Unknown command: (.+)$/);\n  if (!match) return null;\n  return {\n    hint: 'Try `list-tools` to see available commands.',\n    suggestion: closestCommand(match[1]),\n  };\n}\n\nfunction socketPathTooLong(socketPath: string): boolean {\n  if (socketPath.startsWith('tcp://')) return false;\n  return process.platform === 'darwin' && Buffer.byteLength(socketPath) > 103;\n}\n\nfunction ensureSocketEnvironment(): void {\n  if (!process.env.SPECKIT_IPC_SOCKET_DIR) {\n    process.env.SPECKIT_IPC_SOCKET_DIR = DEFAULT_SOCKET_DIR;\n  }\n  const socketDir = process.env.SPECKIT_IPC_SOCKET_DIR;\n  if (!socketDir || socketDir.startsWith('tcp://')) return;\n  mkdirSync(socketDir, { recursive: true, mode: 0o700 });\n  const stat = statSync(socketDir);\n  if ((stat.mode & 0o022) !== 0) {\n    throw new CliProtocolError(`IPC socket directory is group/world-writable: ${socketDir}`);\n  }\n}\n\nfunction sleep(ms: number): Promise<void> {\n  return new Promise((resolve) => setTimeout(resolve, ms));\n}\n\nfunction advisorValidateRetryDelayMs(attempt: number): number {\n  return ADVISOR_VALIDATE_RETRY_BASE_DELAY_MS * attempt;\n}\n\n// ───────────────────────────────────────────────────────────────────\n// 5. CORE LOGIC\n// ───────────────────────────────────────────────────────────────────\nfunction spawnLauncher(paths: RepoPaths): ChildProcess {\n  const child = spawn(process.execPath, [paths.launcherPath], {\n    cwd: paths.repoRoot,\n    env: process.env,\n    detached: true,\n    stdio: 'ignore',\n  });\n  child.unref();\n  // Handed back so the wait below can end the moment the launcher proves it cannot\n  // bring the socket up, instead of spending the rest of the budget on a dead process.\n  return child;\n}\n\nasync function waitForDaemon(\n  socketPath: string,\n  bridge: BridgeModule,\n  timeoutMs: number,\n  launcher?: ChildProcess,\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"sed -n 1070,1130p .skilled/skills/system-skill-advisor/runtime/skill-advisor-cli.ts\",\"workdir\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research\"}"},"time":{"start":1794539541433,"end":1794539542740}}}}
