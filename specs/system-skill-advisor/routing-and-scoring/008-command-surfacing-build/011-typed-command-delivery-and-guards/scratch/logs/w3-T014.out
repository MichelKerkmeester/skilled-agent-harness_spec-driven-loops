{"type":"tool_use","timestamp":1794540385472,"sessionID":"ses_e2d114b51ffeDlZ2G0EwOc9mR4","part":{"partID":"prt_1d2f12cf4002Ncm9aUYdTkORiv","sessionID":"ses_e2d114b51ffeDlZ2G0EwOc9mR4","messageID":"msg_1d2f11c6700109fpG25OvGri4a","type":"tool","id":"call_3317a92fdcc14d589d663284","tool":"shell","state":{"status":"completed","input":{"command":"ls .skilled/skills/system-skill-advisor/runtime | head -30; cat .skilled/skills/system-skill-advisor/runtime/vitest.config.ts 2>/dev/null || cat .skilled/skills/system-skill-advisor/runtime/vitest.config.mts 2>/dev/null","workdir":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research"},"output":"advisor-server.ts\nbench\ncompat\nconfig\ndata\ndatabase\ndist\nhandlers\nlib\nnode_modules\npackage-lock.json\npackage.json\nREADME.md\nschemas\nscripts\nskill-advisor-cli-manifest.ts\nskill-advisor-cli.ts\nstress-test\ntests\ntools\ntsconfig.build.json\ntsconfig.json\ntypes\nvitest.config.ts\nvitest.stress.config.ts\n// ───────────────────────────────────────────────────────────────\n// MODULE: System Skill Advisor Vitest Config\n// ───────────────────────────────────────────────────────────────\n\nimport path from 'node:path';\n\nconst TEST_TIMEOUT_MS = 30_000;\nconst TEARDOWN_TIMEOUT_MS = 1_000;\nconst INCLUDE_BENCHES = process.env.SPECKIT_RUN_BENCHES === 'true';\n// The stress suites are excluded from the default run because they are slow, not\n// because they are unwanted. Without a way to opt in they were unreachable: no\n// script and no pattern selected them, so 21 files sat in the tree running never.\n// Opting in REPLACES the default set rather than adding to it: these suites churn\n// the daemon, its socket and its lease, and running them beside the ordinary\n// suites fails a handful of those on shared state rather than on their own logic.\nconst INCLUDE_STRESS = process.env.SPECKIT_RUN_STRESS === 'true';\n\n// A plain object export instead of vitest's defineConfig wrapper: the config is\n// loaded by node's own module graph, where a bare `vitest` import resolves to\n// whatever node_modules sits next to this file. CI's routing job runs the suites\n// under a vitest pinned through npx, which can differ from the runtime's own\n// vitest range, so importing from the package here could load a second vitest\n// copy. defineConfig is an identity type-helper; dropping it changes nothing at\n// runtime.\nexport default ({\n  root: import.meta.dirname,\n  test: {\n    include: [\n      ...(INCLUDE_STRESS ? ['stress-test/**/*.vitest.ts'] : ['tests/**/*.vitest.ts']),\n      ...(INCLUDE_BENCHES ? ['bench/**/*.bench.ts'] : []),\n    ],\n    exclude: [\n      'node_modules',\n      'dist',\n      ...(INCLUDE_BENCHES ? [] : ['bench/**/*.bench.ts']),\n    ],\n    setupFiles: [\n      path.resolve(import.meta.dirname, '../../system-spec-kit/runtime/tests/_support/vitest-setup.ts'),\n    ],\n    fileParallelism: false,\n    globals: true,\n    environment: 'node',\n    testTimeout: TEST_TIMEOUT_MS,\n    teardownTimeout: TEARDOWN_TIMEOUT_MS,\n    alias: {\n      '@lib': path.resolve(import.meta.dirname, 'lib'),\n    },\n  },\n});\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"advisor-server.ts\nbench\ncompat\nconfig\ndata\ndatabase\ndist\nhandlers\nlib\nnode_modules\npackage-lock.json\npackage.json\nREADME.md\nschemas\nscripts\nskill-advisor-cli-manifest.ts\nskill-advisor-cli.ts\nstress-test\ntests\ntools\ntsconfig.build.json\ntsconfig.json\ntypes\nvitest.config.ts\nvitest.stress.config.ts\n// ───────────────────────────────────────────────────────────────\n// MODULE: System Skill Advisor Vitest Config\n// ───────────────────────────────────────────────────────────────\n\nimport path from 'node:path';\n\nconst TEST_TIMEOUT_MS = 30_000;\nconst TEARDOWN_TIMEOUT_MS = 1_000;\nconst INCLUDE_BENCHES = process.env.SPECKIT_RUN_BENCHES === 'true';\n// The stress suites are excluded from the default run because they are slow, not\n// because they are unwanted. Without a way to opt in they were unreachable: no\n// script and no pattern selected them, so 21 files sat in the tree running never.\n// Opting in REPLACES the default set rather than adding to it: these suites churn\n// the daemon, its socket and its lease, and running them beside the ordinary\n// suites fails a handful of those on shared state rather than on their own logic.\nconst INCLUDE_STRESS = process.env.SPECKIT_RUN_STRESS === 'true';\n\n// A plain object export instead of vitest's defineConfig wrapper: the config is\n// loaded by node's own module graph, where a bare `vitest` import resolves to\n// whatever node_modules sits next to this file. CI's routing job runs the suites\n// under a vitest pinned through npx, which can differ from the runtime's own\n// vitest range, so importing from the package here could load a second vitest\n// copy. defineConfig is an identity type-helper; dropping it changes nothing at\n// runtime.\nexport default ({\n  root: import.meta.dirname,\n  test: {\n    include: [\n      ...(INCLUDE_STRESS ? ['stress-test/**/*.vitest.ts'] : ['tests/**/*.vitest.ts']),\n      ...(INCLUDE_BENCHES ? ['bench/**/*.bench.ts'] : []),\n    ],\n    exclude: [\n      'node_modules',\n      'dist',\n      ...(INCLUDE_BENCHES ? [] : ['bench/**/*.bench.ts']),\n    ],\n    setupFiles: [\n      path.resolve(import.meta.dirname, '../../system-spec-kit/runtime/tests/_support/vitest-setup.ts'),\n    ],\n    fileParallelism: false,\n    globals: true,\n    environment: 'node',\n    testTimeout: TEST_TIMEOUT_MS,\n    teardownTimeout: TEARDOWN_TIMEOUT_MS,\n    alias: {\n      '@lib': path.resolve(import.meta.dirname, 'lib'),\n    },\n  },\n});\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"ls .skilled/skills/system-skill-advisor/runtime | head -30; cat .skilled/skills/system-skill-advisor/runtime/vitest.config.ts 2>/dev/null || cat .skilled/skills/system-skill-advisor/runtime/vitest.config.mts 2>/dev/null\",\"workdir\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research\"}"},"time":{"start":1794540383476,"end":1794540385472}}}}
