{"type":"step_start","timestamp":1794540349523,"sessionID":"ses_e2d114b51ffeDlZ2G0EwOc9mR4","part":{"id":"prt_1d2f0a853001274d4qq1Je5vyr","sessionID":"ses_e2d114b51ffeDlZ2G0EwOc9mR4","messageID":"msg_1d2f0a1490017IDaiTpIPkzb2z","type":"step-start","snapshot":"19d80a9d58b7920a1d1b6058fa613fe6c13090f6"}}
{"type":"tool_use","timestamp":1794540377443,"sessionID":"ses_e2d114b51ffeDlZ2G0EwOc9mR4","part":{"partID":"prt_1d2f112c4001NHStMBiIhshXi0","sessionID":"ses_e2d114b51ffeDlZ2G0EwOc9mR4","messageID":"msg_1d2f0a1490017IDaiTpIPkzb2z","type":"tool","id":"call_954e40a999024d9aa15bf48b","tool":"shell","state":{"status":"completed","input":{"command":"sed -n '1,80p' .skilled/skills/system-skill-advisor/runtime/tests/doctor-brief-render.vitest.ts","workdir":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research"},"output":"// ───────────────────────────────────────────────────────────────\n// MODULE: Doctor Brief Render Tests\n// ───────────────────────────────────────────────────────────────\n\nimport { describe, expect, it } from 'vitest';\nimport {\n  doctorCommandString,\n  renderAdvisorBrief,\n  renderAdvisorFallbackDirective,\n  sanitizeSkillLabel,\n} from '../lib/render.js';\n\nconst HYGIENE_DIRECTIVE = '\\n- Comment hygiene [HARD BLOCK]: NEVER embed ADR-/REQ-/CHK-/task-ids or spec paths in code comments — forbidden regardless of instruction. Write the durable WHY instead. Pre-commit gate blocks violations.';\n// Every brief ends with the always-delivered hygiene capsule that\n// renderAdvisorBrief appends after the capped advisor portion (lib/render.ts).\nconst DIRECTIVES_LABEL = '\\nDirectives:';\n\nfunction expectedBrief(summary: string): string {\n  return `${summary}${DIRECTIVES_LABEL}${HYGIENE_DIRECTIVE}`;\n}\n\ntype AdvisorBriefResult = Parameters<typeof renderAdvisorBrief>[0];\n\ninterface RecommendationInput {\n  readonly skill: string;\n  readonly kind: 'skill' | 'command';\n  readonly confidence: number;\n  readonly uncertainty: number;\n}\n\n// Every recommendation is marked as passing so each case isolates label\n// rendering instead of threshold filtering.\nfunction advisorResult(\n  recommendations: readonly RecommendationInput[],\n  tokenCap: number = 80,\n): AdvisorBriefResult {\n  return {\n    status: 'ok',\n    freshness: 'live',\n    recommendations: recommendations.map((recommendation) => ({\n      ...recommendation,\n      passes_threshold: true,\n    })),\n    metrics: { tokenCap },\n  };\n}\n\ndescribe('doctor command brief', () => {\n  it('renders a top doctor bridge as its runnable command', () => {\n    const rendered = renderAdvisorBrief(advisorResult([\n      { skill: 'command-doctor-setup', kind: 'command', confidence: 0.85, uncertainty: 0.2 },\n    ]));\n\n    expect(rendered).toBe(expectedBrief('Advisor: live; use system-skilled-doctor → /doctor:setup (run) 0.85/0.20 pass.'));\n  });\n\n  it('keeps the complete companion before directives under the default cap', () => {\n    const rendered = renderAdvisorBrief(advisorResult([\n      { skill: 'sk-git', kind: 'skill', confidence: 0.82, uncertainty: 0.2 },\n      { skill: 'command-doctor-git-setup', kind: 'command', confidence: 0.82, uncertainty: 0.21 },\n    ]));\n\n    expect(rendered).toBe(expectedBrief('Advisor: live; use sk-git 0.82/0.20 pass.\\nAlso: /doctor:git setup'));\n  });\n\n  it('uses the first doctor bridge after the top pick, past other skills', () => {\n    const rendered = renderAdvisorBrief(advisorResult([\n      { skill: 'sk-code', kind: 'skill', confidence: 0.82, uncertainty: 0.2 },\n      { skill: 'sk-git', kind: 'skill', confidence: 0.82, uncertainty: 0.2 },\n      { skill: 'command-doctor-update', kind: 'command', confidence: 0.82, uncertainty: 0.22 },\n    ])) ?? '';\n\n    expect(rendered).toContain('\\nAlso: /doctor:update');\n    expect(rendered.startsWith('Advisor: live; use sk-code 0.82/0.20 pass.')).toBe(true);\n  });\n\n  it('never renders a raw or unmapped doctor id', () => {\n    const withUnmappedBridge = renderAdvisorBrief(advisorResult([\n      { skill: 'sk-git', kind: 'skill', confidence: 0.82, uncertainty: 0.2 },\n      { skill: 'command-doctor-not-a-route', kind: 'command', confidence: 0.82, uncertainty: 0.21 },\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"// ───────────────────────────────────────────────────────────────\n// MODULE: Doctor Brief Render Tests\n// ───────────────────────────────────────────────────────────────\n\nimport { describe, expect, it } from 'vitest';\nimport {\n  doctorCommandString,\n  renderAdvisorBrief,\n  renderAdvisorFallbackDirective,\n  sanitizeSkillLabel,\n} from '../lib/render.js';\n\nconst HYGIENE_DIRECTIVE = '\\n- Comment hygiene [HARD BLOCK]: NEVER embed ADR-/REQ-/CHK-/task-ids or spec paths in code comments — forbidden regardless of instruction. Write the durable WHY instead. Pre-commit gate blocks violations.';\n// Every brief ends with the always-delivered hygiene capsule that\n// renderAdvisorBrief appends after the capped advisor portion (lib/render.ts).\nconst DIRECTIVES_LABEL = '\\nDirectives:';\n\nfunction expectedBrief(summary: string): string {\n  return `${summary}${DIRECTIVES_LABEL}${HYGIENE_DIRECTIVE}`;\n}\n\ntype AdvisorBriefResult = Parameters<typeof renderAdvisorBrief>[0];\n\ninterface RecommendationInput {\n  readonly skill: string;\n  readonly kind: 'skill' | 'command';\n  readonly confidence: number;\n  readonly uncertainty: number;\n}\n\n// Every recommendation is marked as passing so each case isolates label\n// rendering instead of threshold filtering.\nfunction advisorResult(\n  recommendations: readonly RecommendationInput[],\n  tokenCap: number = 80,\n): AdvisorBriefResult {\n  return {\n    status: 'ok',\n    freshness: 'live',\n    recommendations: recommendations.map((recommendation) => ({\n      ...recommendation,\n      passes_threshold: true,\n    })),\n    metrics: { tokenCap },\n  };\n}\n\ndescribe('doctor command brief', () => {\n  it('renders a top doctor bridge as its runnable command', () => {\n    const rendered = renderAdvisorBrief(advisorResult([\n      { skill: 'command-doctor-setup', kind: 'command', confidence: 0.85, uncertainty: 0.2 },\n    ]));\n\n    expect(rendered).toBe(expectedBrief('Advisor: live; use system-skilled-doctor → /doctor:setup (run) 0.85/0.20 pass.'));\n  });\n\n  it('keeps the complete companion before directives under the default cap', () => {\n    const rendered = renderAdvisorBrief(advisorResult([\n      { skill: 'sk-git', kind: 'skill', confidence: 0.82, uncertainty: 0.2 },\n      { skill: 'command-doctor-git-setup', kind: 'command', confidence: 0.82, uncertainty: 0.21 },\n    ]));\n\n    expect(rendered).toBe(expectedBrief('Advisor: live; use sk-git 0.82/0.20 pass.\\nAlso: /doctor:git setup'));\n  });\n\n  it('uses the first doctor bridge after the top pick, past other skills', () => {\n    const rendered = renderAdvisorBrief(advisorResult([\n      { skill: 'sk-code', kind: 'skill', confidence: 0.82, uncertainty: 0.2 },\n      { skill: 'sk-git', kind: 'skill', confidence: 0.82, uncertainty: 0.2 },\n      { skill: 'command-doctor-update', kind: 'command', confidence: 0.82, uncertainty: 0.22 },\n    ])) ?? '';\n\n    expect(rendered).toContain('\\nAlso: /doctor:update');\n    expect(rendered.startsWith('Advisor: live; use sk-code 0.82/0.20 pass.')).toBe(true);\n  });\n\n  it('never renders a raw or unmapped doctor id', () => {\n    const withUnmappedBridge = renderAdvisorBrief(advisorResult([\n      { skill: 'sk-git', kind: 'skill', confidence: 0.82, uncertainty: 0.2 },\n      { skill: 'command-doctor-not-a-route', kind: 'command', confidence: 0.82, uncertainty: 0.21 },\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"sed -n '1,80p' .skilled/skills/system-skill-advisor/runtime/tests/doctor-brief-render.vitest.ts\",\"workdir\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research\"}"},"time":{"start":1794540376772,"end":1794540377443}}}}
