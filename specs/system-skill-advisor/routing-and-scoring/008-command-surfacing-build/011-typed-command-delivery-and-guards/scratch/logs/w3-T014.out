[^']+)': \\\\{([^}]*)\\\\},$/gm)];\\nconst trackedLines=[...tracked.matchAll(/^  '([^']+)': \\\\{([^}]*)\\\\},$/gm)];\\nconsole.log('COMMAND_ROWS', rowLines.length);\\nconsole.log('TRACKED', trackedLines.length);\\nconsole.log('rows without policy', rowLines.filter(m=>!m[2].includes(\\\\\\\"policy:\\\\\\\")).map(m=>m[1]));\\nconsole.log('tracked keys sample', trackedLines.slice(0,3).map(m=>m[1]));\\n\\\"\",\"workdir\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research\"}"},"time":{"start":1794540337169,"end":1794540339209}}}}
