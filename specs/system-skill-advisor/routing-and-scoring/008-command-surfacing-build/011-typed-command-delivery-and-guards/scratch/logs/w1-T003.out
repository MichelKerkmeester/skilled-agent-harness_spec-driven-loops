nd, whether or not its bridge is\n+// active, so a typed command always has a policy and an owner. `scorerRow` says\n+// whether a scorer can also return the command on its own.\n export interface TrackedCommand {\n   readonly policy: 'run' | 'start' | 'ask';\n   readonly ownerSkillId: string;\n   readonly scorerRow: boolean;\n","status":"modified","additions":3,"deletions":4}],"truncated":false},"content":[{"type":"text","text":"Edited .skilled/skills/system-skill-advisor/runtime/lib/command-attach.ts (1 replacement)"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"newString\":\"// The table below covers every tracked command, whether or not its bridge is\\n// active, so a typed command always has a policy and an owner. `scorerRow` says\\n// whether a scorer can also return the command on its own.\\n\",\"oldString\":\"// Every tracked command needs a policy and an owner whether or not its bridge is\\n// active, so a typed command always resolves to both. A command with no active\\n// bridge still has a name someone can type, and `scorerRow` says whether a scorer\\n// can also return it on its own.\\n\",\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/lib/command-attach.ts\"}"},"time":{"start":1794539625276,"end":1794539626621}}}}
