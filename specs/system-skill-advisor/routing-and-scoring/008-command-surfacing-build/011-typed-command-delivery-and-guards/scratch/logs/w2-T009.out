{"type":"step_start","timestamp":1794540049007,"sessionID":"ses_e2d148875ffeU9dgsF1CpQl6Z6","part":{"id":"prt_1d2ec126f001E4JFk0fqrMZ8j6","sessionID":"ses_e2d148875ffeU9dgsF1CpQl6Z6","messageID":"msg_1d2ec003f001PtlePrgnCHO9cz","type":"step-start","snapshot":"ef04d1cf6a66daec7b2b54bcc49d66ec52b066da"}}
{"type":"tool_use","timestamp":1794540056555,"sessionID":"ses_e2d148875ffeU9dgsF1CpQl6Z6","part":{"partID":"prt_1d2ec1e560010m6L2odGL6Ie0t","sessionID":"ses_e2d148875ffeU9dgsF1CpQl6Z6","messageID":"msg_1d2ec003f001PtlePrgnCHO9cz","type":"tool","id":"chatcmpl-tool-bf193d19b075183c","tool":"read","state":{"status":"completed","input":{"path":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/tests/handlers/advisor-status.vitest.ts"},"output":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/tests/handlers/advisor-status.vitest.ts, lines 1-631\n1: // ───────────────────────────────────────────────────────────────\n2: // MODULE: Advisor Status Tests\n3: // ───────────────────────────────────────────────────────────────\n4: \n5: import { mkdtempSync, mkdirSync, readFileSync, symlinkSync, utimesSync, writeFileSync } from 'node:fs';\n6: import { join } from 'node:path';\n7: import { tmpdir } from 'node:os';\n8: import Database from 'better-sqlite3';\n9: \n10: import { beforeEach, describe, expect, it, vi } from 'vitest';\n11: \n12: const ollamaMocks = vi.hoisted(() => ({\n13:   probeOllamaModel: vi.fn(),\n14:   resolveOllamaBaseUrl: vi.fn(() => 'http://127.0.0.1:11434'),\n15: }));\n16: \n17: // The handler is the only caller that probes a backend, so the mock keeps\n18: // every other status case free of network access.\n19: vi.mock('../../lib/embedders/adapters/ollama.js', async (importOriginal) => {\n20:   const actual = await importOriginal<typeof import('../../lib/embedders/adapters/ollama.js')>();\n21:   return {\n22:     ...actual,\n23:     probeOllamaModel: ollamaMocks.probeOllamaModel,\n24:     resolveOllamaBaseUrl: ollamaMocks.resolveOllamaBaseUrl,\n25:   };\n26: });\n27: \n28: import { handleAdvisorStatus, readAdvisorStatus } from '../../handlers/advisor-status.js';\n29: import { computeAdvisorSourceSignature } from '../../lib/freshness.js';\n30: import {\n31:   computeSkillMetadataContentHash,\n32:   readCommandEmbeddingSources,\n33: } from '../../lib/skill-graph/skill-graph-db.js';\n34: import { AdvisorStatusOutputSchema } from '../../schemas/advisor-tool-schemas.js';\n35: \n36: const ADVISOR_DB_RELATIVE_PATH = join(\n37:   '.skilled',\n38:   'skills',\n39:   'system-skill-advisor',\n40:   'runtime',\n41:   'database',\n42:   'skill-graph.sqlite',\n43: );\n44: \n45: function workspace(name: string): string {\n46:   const root = mkdtempSync(join(tmpdir(), `advisor-status-${name}-`));\n47:   mkdirSync(join(root, '.skilled', 'skills', '.state', 'advisor'), { recursive: true });\n48:   mkdirSync(join(root, '.skilled', 'skills', 'system-skill-advisor', 'runtime', 'database'), { recursive: true });\n49:   mkdirSync(join(root, '.skilled', 'skills', 'alpha'), { recursive: true });\n50:   writeFileSync(join(root, '.skilled', 'skills', 'alpha', 'graph-metadata.json'), '{\"skill_id\":\"alpha\"}\\n', 'utf8');\n51:   return root;\n52: }\n53: \n54: function writeGeneration(\n55:   root: string,\n56:   state: 'live' | 'stale' | 'absent' | 'unavailable',\n57:   generation = 1,\n58:   sourceSignature: string | null = null,\n59: ): void {\n60:   writeFileSync(join(root, '.skilled', 'skills', '.state', 'advisor', 'skill-graph-generation.json'), `${JSON.stringify({\n61:     generation,\n62:     updatedAt: '2026-04-20T00:00:00.000Z',\n63:     sourceSignature,\n64:     reason: `${state.toUpperCase()}_FIXTURE`,\n65:     state,\n66:   })}\\n`, 'utf8');\n67: }\n68: \n69: function writeDb(root: string): void {\n70:   writeFileSync(join(root, ADVISOR_DB_RELATIVE_PATH), '', 'utf8');\n71: }\n72: \n73: function writeIndexDb(root: string, contentHash: string | null): void {\n74:   const database = new Database(join(root, ADVISOR_DB_RELATIVE_PATH));\n75:   try {\n76:     database.exec(`\n77:       CREATE TABLE skill_nodes (\n78:         id TEXT PRIMARY KEY,\n79:         source_path TEXT,\n80:         content_hash TEXT\n81:       );\n82:     `);\n83:     database.prepare(`\n84:       INSERT INTO skill_nodes (id, source_path, content_hash)\n85:       VALUES (?, ?, ?)\n86:     `).run(\n87:       'alpha',\n88:       join('.skilled', 'skills', 'alpha', 'graph-metadata.json'),\n89:       contentHash,\n90:     );\n91:   } finally {\n92:     database.close();\n93:   }\n94: }\n95: \n96: function writeHealthDb(root: string): void {\n97:   const database = new Database(join(root, ADVISOR_DB_RELATIVE_PATH));\n98:   try {\n99:     database.exec(`\n100:       CREATE TABLE skill_nodes (\n101:         id TEXT PRIMARY KEY,\n102:         embedding BLOB,\n103:         embedding_model_id TEXT,\n104:         embedding_content_hash TEXT\n105:       );\n106:       CREATE TABLE vec_metadata (key TEXT PRIMARY KEY, value TEXT NOT NULL);\n107:       CREATE TABLE vec_768 (\n108:         skill_id TEXT PRIMARY KEY,\n109:         embedding BLOB NOT NULL,\n110:         model_id TEXT NOT NULL,\n111:         content_hash TEXT NOT NULL,\n112:         updated_at TEXT DEFAULT (datetime('now'))\n113:       );\n114:     `);\n115:     database.prepare('INSERT INTO skill_nodes (id) VALUES (?)').run('alpha');\n116:     database.prepare('INSERT INTO skill_nodes (id) VALUES (?)').run('beta');\n117:     database.prepare('INSERT INTO vec_metadata (key, value) VALUES (?, ?)').run('active_embedder_name', 'nomic-embed-text-v1.5');\n118:     database.prepare('INSERT INTO vec_metadata (key, value) VALUES (?, ?)').run('active_embedder_dim', '768');\n119:     database.prepare('INSERT INTO vec_768 (skill_id, embedding, model_id, content_hash, updated_at) VALUES (?, ?, ?, ?, ?)')\n120:       .run('alpha', Buffer.from([1, 2, 3]), 'nomic-embed-text-v1.5', 'hash-alpha', '2026-04-20T00:00:00.000Z');\n121:   } finally {\n122:     database.close();\n123:   }\n124: }\n125: \n126: function writeCommandVectorTable(root: string, rows: number): void {\n127:   const database = new Database(join(root, ADVISOR_DB_RELATIVE_PATH));\n128:   try {\n129:     database.exec(`\n130:       CREATE TABLE vec_cmd_768 (\n131:         command_id TEXT PRIMARY KEY,\n132:         embedding BLOB NOT NULL,\n133:         model_id TEXT NOT NULL,\n134:         content_hash TEXT NOT NULL,\n135:         updated_at TEXT DEFAULT (datetime('now'))\n136:       );\n137:     `);\n138:     const insert = database.prepare(`\n139:       INSERT INTO vec_cmd_768 (command_id, embedding, model_id, content_hash)\n140:       VALUES (?, ?, ?, ?)\n141:     `);\n142:     for (let index = 0; index < rows; index += 1) {\n143:       insert.run(`command-${index}`, Buffer.from([1, 2, 3]), 'nomic-embed-text-v1.5', `hash-${index}`);\n144:     }\n145:   } finally {\n146:     database.close();\n147:   }\n148: }\n149: \n150: function writeDimMismatchHealthDb(root: string): void {\n151:   const database = new Database(join(root, ADVISOR_DB_RELATIVE_PATH));\n152:   try {\n153:     database.exec(`\n154:       CREATE TABLE skill_nodes (id TEXT PRIMARY KEY, embedding BLOB);\n155:       CREATE TABLE vec_metadata (key TEXT PRIMARY KEY, value TEXT NOT NULL);\n156:       CREATE TABLE vec_123 (\n157:         skill_id TEXT PRIMARY KEY,\n158:         embedding BLOB NOT NULL,\n159:         model_id TEXT NOT NULL,\n160:         content_hash TEXT NOT NULL,\n161:         updated_at TEXT DEFAULT (datetime('now'))\n162:       );\n163:     `);\n164:     database.prepare('INSERT INTO skill_nodes (id) VALUES (?)').run('alpha');\n165:     database.prepare('INSERT INTO vec_metadata (key, value) VALUES (?, ?)').run('active_embedder_name', 'nomic-embed-text-v1.5');\n166:     database.prepare('INSERT INTO vec_metadata (key, value) VALUES (?, ?)').run('active_embedder_dim', '123');\n167:   } finally {\n168:     database.close();\n169:   }\n170: }\n171: \n172: describe('advisor_status handler', () => {\n173:   beforeEach(() => {\n174:     ollamaMocks.probeOllamaModel.mockReset();\n175:     ollamaMocks.resolveOllamaBaseUrl.mockReset();\n176:     ollamaMocks.resolveOllamaBaseUrl.mockReturnValue('http://127.0.0.1:11434');\n177:   });\n178: \n179:   it('includes a private skill linked from inside the skills root in the source signature', () => {\n180:     const root = workspace('linked');\n181:     const skills = join(root, '.skilled', 'skills');\n182:     mkdirSync(join(skills, '.private', 'private-beta'), { recursive: true });\n183:     writeFileSync(join(skills, '.private', 'private-beta', 'SKILL.md'), 'first\\n');\n184:     writeFileSync(join(skills, '.private', 'private-beta', 'graph-metadata.json'), '{\"skill_id\":\"local-beta\"}\\n');\n185:     symlinkSync(join(skills, '.private', 'private-beta'), join(skills, 'local-beta'));\n186:     const before = computeAdvisorSourceSignature(root);\n187:     writeFileSync(join(skills, '.private', 'private-beta', 'SKILL.md'), 'second\\n');\n188:     expect(computeAdvisorSourceSignature(root)).not.toBe(before);\n189:   });\n190: \n191:   it('ignores a private skill linked from outside every trusted root', () => {\n192:     const root = workspace('outside');\n193:     const skills = join(root, '.skilled', 'skills');\n194:     const outside = join(root, 'outside-beta');\n195:     mkdirSync(outside, { recursive: true });\n196:     writeFileSync(join(outside, 'SKILL.md'), 'first\\n');\n197:     writeFileSync(join(outside, 'graph-metadata.json'), '{\"skill_id\":\"local-beta\"}\\n');\n198:     symlinkSync(outside, join(skills, 'local-beta'));\n199:     const before = computeAdvisorSourceSignature(root);\n200:     writeFileSync(join(outside, 'SKILL.md'), 'second\\n');\n201:     expect(computeAdvisorSourceSignature(root)).toBe(before);\n202:   });\n203: \n204:   it('includes a private skill linked into a declared external root', () => {\n205:     const root = workspace('declared');\n206:     const skills = join(root, '.skilled', 'skills');\n207:     const external = join(root, 'private-repos');\n208:     const target = join(external, 'sk-code-webflow');\n209:     mkdirSync(target, { recursive: true });\n210:     writeFileSync(join(target, 'SKILL.md'), 'first\\n');\n211:     writeFileSync(join(target, 'graph-metadata.json'), '{\"skill_id\":\"local-webflow\"}\\n');\n212:     symlinkSync(target, join(skills, 'local-webflow'));\n213:     process.env.SPECKIT_PRIVATE_SKILL_ROOTS = external;\n214:     try {\n215:       const before = computeAdvisorSourceSignature(root);\n216:       writeFileSync(join(target, 'SKILL.md'), 'second\\n');\n217:       expect(computeAdvisorSourceSignature(root)).not.toBe(before);\n218:     } finally {\n219:       delete process.env.SPECKIT_PRIVATE_SKILL_ROOTS;\n220:     }\n221:   });\n222: \n223:   // drift: verified against shipped behavior during Unit H\n224:   it('reports live freshness', () => {\n225:     const root = workspace('live');\n226:     writeDb(root);\n227:     writeGeneration(root, 'live', 3);\n228: \n229:     const status = readAdvisorStatus({ workspaceRoot: root });\n230: \n231:     expect(status.freshness).toBe('live');\n232:     expect(status.trustState.state).toBe('live');\n233:     expect(status.generation).toBe(3);\n234:     expect(status.trustState.lastLiveAt).toBe('2026-04-20T00:00:00.000Z');\n235:     expect(status.lastScanAt).toBe('2026-04-20T00:00:00.000Z');\n236:     expect(status.skillCount).toBe(1);\n237:     expect(status.laneWeights.explicit_author).toBe(0.42);\n238:     expect(status.semanticLaneHealth).toBeUndefined();\n239:   });\n240: \n241:   it('reports fresh index hashes without changing a live generation', () => {\n242:     const root = workspace('index-fresh');\n243:     const metadataPath = join(root, '.skilled', 'skills', 'alpha', 'graph-metadata.json');\n244:     const contentHash = computeSkillMetadataContentHash(readFileSync(metadataPath, 'utf8'));\n245:     writeIndexDb(root, contentHash);\n246:     writeGeneration(root, 'live', 3, computeAdvisorSourceSignature(root));\n247: \n248:     const status = readAdvisorStatus({ workspaceRoot: root });\n249: \n250:     expect(status.freshness).toBe('live');\n251:     expect(status.indexStaleness).toEqual({\n252:       state: 'fresh',\n253:       reason: null,\n254:       trackedSkills: 1,\n255:       freshSourceFiles: 1,\n256:       changedSourceFiles: 0,\n257:       missingSourceFiles: 0,\n258:       staleSkillIds: [],\n259:     });\n260:   });\n261: \n262:   it('marks live generations stale when index hashes differ from disk', () => {\n263:     const root = workspace('index-stale');\n264:     writeIndexDb(root, 'outdated-hash');\n265:     writeGeneration(root, 'live', 4, computeAdvisorSourceSignature(root));\n266: \n267:     const status = readAdvisorStatus({ workspaceRoot: root });\n268: \n269:     expect(status.freshness).toBe('stale');\n270:     expect(status.trustState.state).toBe('stale');\n271:     expect(status.indexStaleness).toEqual(expect.objectContaining({\n272:       state: 'stale',\n273:       reason: 'source_hash_mismatch',\n274:       changedSourceFiles: 1,\n275:     }));\n276:     expect(status.errors).toContain(\n277:       'advisor_status index content hashes differ from disk for 1 skill; run advisor_rebuild',\n278:     );\n279:   });\n280: \n281:   it('reports unavailable index staleness when the database is absent', () => {\n282:     const root = workspace('index-absent');\n283:     writeGeneration(root, 'live', 5, computeAdvisorSourceSignature(root));\n284: \n285:     const status = readAdvisorStatus({ workspaceRoot: root });\n286: \n287:     expect(status.indexStaleness).toEqual(expect.objectContaining({\n288:       state: 'unavailable',\n289:       reason: 'database_absent',\n290:     }));\n291:   });\n292: \n293:   it('reports semantic-lane health only when requested', () => {\n294:     const root = workspace('semantic-health');\n295:     writeHealthDb(root);\n296:     writeGeneration(root, 'live', 8);\n297: \n298:     const compact = readAdvisorStatus({ workspaceRoot: root });\n299:     const detailed = readAdvisorStatus({ workspaceRoot: root, includeSemanticHealth: true });\n300: \n301:     expect(compact.semanticLaneHealth).toBeUndefined();\n302:     expect(detailed.semanticLaneHealth).toEqual(expect.objectContaining({\n303:       activeEmbedder: expect.objectContaining({\n304:         name: 'nomic-embed-text-v1.5',\n305:         dim: 768,\n306:         adapterDim: 768,\n307:       }),\n308:       vectorCoverage: {\n309:         embedded: 1,\n310:         total: 2,\n311:         ratio: 0.5,\n312:       },\n313:       dimMismatch: false,\n314:       lastRefresh: '2026-04-20T00:00:00.000Z',\n315:       disabledReason: null,\n316:       laneEnabled: true,\n317:     }));\n318:   });\n319: \n320:   it('surfaces semantic-lane dim mismatch as a disabled reason', () => {\n321:     const root = workspace('semantic-dim-mismatch');\n322:     writeDimMismatchHealthDb(root);\n323:     writeGeneration(root, 'live', 9);\n324: \n325:     const status = readAdvisorStatus({ workspaceRoot: root, includeSemanticHealth: true });\n326: \n327:     expect(status.semanticLaneHealth).toEqual(expect.objectContaining({\n328:       activeEmbedder: expect.objectContaining({\n329:         name: 'nomic-embed-text-v1.5',\n330:         dim: 123,\n331:         adapterDim: 768,\n332:       }),\n333:       dimMismatch: true,\n334:       disabledReason: 'dim_mismatch',\n335:       laneEnabled: false,\n336:     }));\n337:   });\n338: \n339:   it('reports zero command-vector coverage when no command table exists', () => {\n340:     const root = workspace('command-coverage-absent');\n341:     writeHealthDb(root);\n342:     writeGeneration(root, 'live', 10);\n343: \n344:     const status = readAdvisorStatus({ workspaceRoot: root, includeSemanticHealth: true });\n345:     const sourceTotal = readCommandEmbeddingSources()?.length ?? 0;\n346: \n347:     expect(status.semanticLaneHealth?.commandVectorCoverage).toEqual({\n348:       embedded: 0,\n349:       total: sourceTotal,\n350:     });\n351:   });\n352: \n353:   it('counts command-vector rows when the command table exists', () => {\n354:     const root = workspace('command-coverage-present');\n355:     writeHealthDb(root);\n356:     writeCommandVectorTable(root, 3);\n357:     writeGeneration(root, 'live', 10);\n358: \n359:     const status = readAdvisorStatus({ workspaceRoot: root, includeSemanticHealth: true });\n360:     const sourceTotal = readCommandEmbeddingSources()?.length ?? 0;\n361: \n362:     expect(status.semanticLaneHealth?.commandVectorCoverage).toEqual({\n363:       embedded: 3,\n364:       total: sourceTotal,\n365:     });\n366:   });\n367: \n368:   it('reports a reachable backend when the model is loaded', async () => {\n369:     const root = workspace('backend-reachable');\n370:     writeHealthDb(root);\n371:     writeGeneration(root, 'live', 14);\n372:     ollamaMocks.probeOllamaModel.mockResolvedValue({ available: true });\n373: \n374:     const response = await handleAdvisorStatus({ workspaceRoot: root, includeSemanticHealth: true });\n375:     const envelope = JSON.parse(response.content[0].text) as { data: unknown };\n376:     const status = AdvisorStatusOutputSchema.parse(envelope.data);\n377: \n378:     expect(ollamaMocks.probeOllamaModel).toHaveBeenCalledWith(\n379:       'http://127.0.0.1:11434',\n380:       'nomic-embed-text:v1.5',\n381:       500,\n382:     );\n383:     expect(status.semanticLaneHealth?.backend).toEqual({ state: 'reachable', reason: null });\n384:     expect(status.semanticLaneHealth?.laneEnabled).toBe(true);\n385:   });\n386: \n387:   it('reports an unreachable backend when the probe cannot connect', async () => {\n388:     const root = workspace('backend-unreachable');\n389:     writeHealthDb(root);\n390:     writeGeneration(root, 'live', 14);\n391:     const reason = 'Ollama backend unreachable at http://127.0.0.1:11434: fetch failed';\n392:     ollamaMocks.probeOllamaModel.mockResolvedValue({ available: false, reason });\n393: \n394:     const response = await handleAdvisorStatus({ workspaceRoot: root, includeSemanticHealth: true });\n395:     const envelope = JSON.parse(response.content[0].text) as { data: unknown };\n396:     const status = AdvisorStatusOutputSchema.parse(envelope.data);\n397: \n398:     expect(status.semanticLaneHealth?.backend).toEqual({ state: 'unreachable', reason });\n399:     expect(status.semanticLaneHealth?.laneEnabled).toBe(false);\n400:   });\n401: \n402:   it('reports a missing model when the server answers without it', async () => {\n403:     const root = workspace('backend-model-missing');\n404:     writeHealthDb(root);\n405:     writeGeneration(root, 'live', 14);\n406:     const reason = 'Ollama model is not loaded: nomic-embed-text:v1.5';\n407:     ollamaMocks.probeOllamaModel.mockResolvedValue({ available: false, reason });\n408: \n409:     const response = await handleAdvisorStatus({ workspaceRoot: root, includeSemanticHealth: true });\n410:     const envelope = JSON.parse(response.content[0].text) as { data: unknown };\n411:     const status = AdvisorStatusOutputSchema.parse(envelope.data);\n412: \n413:     expect(status.semanticLaneHealth?.backend).toEqual({ state: 'model_missing', reason });\n414:     expect(status.semanticLaneHealth?.laneEnabled).toBe(false);\n415:   });\n416: \n417:   // drift: verified against shipped behavior during Unit H\n418:   it('keeps signed generations live when source mtimes exceed skipped SQLite writes', () => {\n419:     const root = workspace('signed-live');\n420:     writeDb(root);\n421:     const dbPath = join(root, ADVISOR_DB_RELATIVE_PATH);\n422:     const metadataPath = join(root, '.skilled', 'skills', 'alpha', 'graph-metadata.json');\n423:     utimesSync(dbPath, new Date('2026-04-19T00:00:00.000Z'), new Date('2026-04-19T00:00:00.000Z'));\n424:     utimesSync(metadataPath, new Date('2026-04-21T00:00:00.000Z'), new Date('2026-04-21T00:00:00.000Z'));\n425:     const sourceSignature = computeAdvisorSourceSignature(root);\n426:     writeFileSync(join(root, '.skilled', 'skills', '.state', 'advisor', 'skill-graph-generation.json'), `${JSON.stringify({\n427:       generation: 9,\n428:       updatedAt: '2026-04-22T00:00:00.000Z',\n429:       sourceSignature,\n430:       reason: 'advisor_rebuild',\n431:       state: 'live',\n432:     })}\\n`, 'utf8');\n433: \n434:     const status = readAdvisorStatus({ workspaceRoot: root });\n435: \n436:     expect(status.freshness).toBe('live');\n437:     expect(status.trustState.state).toBe('live');\n438:   });\n439: \n440:   // drift: verified against shipped behavior during Unit H\n441:   it('marks live generations stale when nested graph metadata is newer than the database', () => {\n442:     const root = workspace('nested-mtime');\n443:     writeDb(root);\n444:     writeGeneration(root, 'live', 6);\n445:     const dbPath = join(root, ADVISOR_DB_RELATIVE_PATH);\n446:     const metadataPath = join(root, '.skilled', 'skills', 'alpha', 'graph-metadata.json');\n447:     utimesSync(dbPath, new Date('2026-04-19T00:00:00.000Z'), new Date('2026-04-19T00:00:00.000Z'));\n448:     utimesSync(metadataPath, new Date('2026-04-21T00:00:00.000Z'), new Date('2026-04-21T00:00:00.000Z'));\n449: \n450:     const status = readAdvisorStatus({ workspaceRoot: root });\n451: \n452:     expect(status.freshness).toBe('stale');\n453:     expect(status.trustState.lastLiveAt).toBe('2026-04-20T00:00:00.000Z');\n454:   });\n455: \n456:   // drift: verified against shipped behavior during Unit H\n457:   it('reports stale freshness', () => {\n458:     const root = workspace('stale');\n459:     writeDb(root);\n460:     writeGeneration(root, 'stale', 4);\n461: \n462:     const status = readAdvisorStatus({ workspaceRoot: root });\n463: \n464:     expect(status.freshness).toBe('stale');\n465:     expect(status.trustState.reason).toBe('STALE_FIXTURE');\n466:   });\n467: \n468:   it('reports absent freshness when no artifact exists', () => {\n469:     const root = workspace('absent');\n470:     writeGeneration(root, 'absent', 0);\n471: \n472:     const status = readAdvisorStatus({ workspaceRoot: root });\n473: \n474:     expect(status.freshness).toBe('absent');\n475:   });\n476: \n477:   // drift: verified against shipped behavior during Unit H\n478:   it('reports unavailable for corrupt generation metadata', () => {\n479:     const root = workspace('unavailable');\n480:     writeFileSync(join(root, '.skilled', 'skills', '.state', 'advisor', 'skill-graph-generation.json'), '{', 'utf8');\n481: \n482:     const status = readAdvisorStatus({ workspaceRoot: root });\n483: \n484:     expect(status.freshness).toBe('unavailable');\n485:     expect(status.errors?.length).toBeGreaterThan(0);\n486:   });\n487: \n488:   it('does not leak prompt content in status output', async () => {\n489:     const root = workspace('privacy');\n490:     writeDb(root);\n491:     writeGeneration(root, 'live', 5);\n492: \n493:     const raw = (await handleAdvisorStatus({ workspaceRoot: root })).content[0].text;\n494: \n495:     expect(raw).not.toContain('prompt');\n496:     expect(raw).not.toContain('secret@example.com');\n497:   });\n498: \n499:   it('omits embeddings health when the option is absent', async () => {\n500:     const root = workspace('embeddings-health-omitted');\n501:     const response = await handleAdvisorStatus({ workspaceRoot: root });\n502:     const envelope = JSON.parse(response.content[0].text) as { data: unknown };\n503:     const status = AdvisorStatusOutputSchema.parse(envelope.data);\n504: \n505:     expect(status).not.toHaveProperty('embeddingsHealth');\n506:   });\n507: \n508:   it('returns a schema-valid unavailable model-server state when requested', async () => {\n509:     const root = workspace('embeddings-health-unavailable');\n510:     const originalServerUrl = process.env.HF_EMBED_SERVER_URL;\n511: \n512:     try {\n513:       process.env.HF_EMBED_SERVER_URL = join(root, 'missing-hf-embed.sock');\n514:       const response = await handleAdvisorStatus({\n515:         workspaceRoot: root,\n516:         includeEmbeddingsHealth: true,\n517:       });\n518:       const envelope = JSON.parse(response.content[0].text) as { data: unknown };\n519:       const status = AdvisorStatusOutputSchema.parse(envelope.data);\n520: \n521:       expect(status.embeddingsHealth?.modelServer.state).toBe('unavailable');\n522:     } finally {\n523:       if (originalServerUrl === undefined) delete process.env.HF_EMBED_SERVER_URL;\n524:       else process.env.HF_EMBED_SERVER_URL = originalServerUrl;\n525:     }\n526:   });\n527: \n528:   // drift: verified against shipped behavior during Unit H\n529:   it('caps metadata scanning when requested to avoid unbounded status walks', () => {\n530:     const root = workspace('scan-cap');\n531:     writeDb(root);\n532:     writeGeneration(root, 'live', 7);\n533:     mkdirSync(join(root, '.skilled', 'skills', 'beta'), { recursive: true });\n534:     writeFileSync(join(root, '.skilled', 'skills', 'beta', 'graph-metadata.json'), '{\"skill_id\":\"beta\"}\\n', 'utf8');\n535: \n536:     const status = readAdvisorStatus({ workspaceRoot: root, maxMetadataFiles: 1 });\n537: \n538:     expect(status.skillCount).toBe(1);\n539:     expect(status.errors).toEqual([\n540:       expect.stringContaining('metadata scan capped at 1 files'),\n541:     ]);\n542:   });\n543: \n544:   it('counts only depth-one skill roots with graph metadata', () => {\n545:     const root = workspace('root-only-scan');\n546:     writeDb(root);\n547:     writeGeneration(root, 'live', 7);\n548:     mkdirSync(join(root, '.skilled', 'skills', 'beta'), { recursive: true });\n549:     writeFileSync(join(root, '.skilled', 'skills', 'beta', 'graph-metadata.json'), '{\"skill_id\":\"beta\"}\\n', 'utf8');\n550:     mkdirSync(join(root, '.skilled', 'skills', 'alpha', 'nested'), { recursive: true });\n551:     writeFileSync(join(root, '.skilled', 'skills', 'alpha', 'nested', 'graph-metadata.json'), '{\"skill_id\":\"nested\"}\\n', 'utf8');\n552: \n553:     const status = readAdvisorStatus({ workspaceRoot: root });\n554: \n555:     expect(status.skillCount).toBe(2);\n556:   });\n557: \n558:   it('counts a private skill linked from inside the skills root and not one linked from outside', () => {\n559:     const root = workspace('private-link-scan');\n560:     writeDb(root);\n561:     writeGeneration(root, 'live', 7);\n562:     const skills = join(root, '.skilled', 'skills');\n563:     const inside = join(skills, '.private', 'private-beta');\n564:     const outside = join(root, 'outside', 'private-evil');\n565:     for (const dir of [inside, outside]) {\n566:       mkdirSync(dir, { recursive: true });\n567:       writeFileSync(join(dir, 'graph-metadata.json'), '{\"skill_id\":\"local-x\"}\\n', 'utf8');\n568:     }\n569:     symlinkSync(inside, join(skills, 'local-beta'));\n570:     symlinkSync(outside, join(skills, 'local-evil'));\n571: \n572:     const status = readAdvisorStatus({ workspaceRoot: root });\n573: \n574:     // The fixture's own skill plus the trusted link; the outside link is not counted.\n575:     expect(status.skillCount).toBe(2);\n576:   });\n577: \n578:   it('probes the env-override artifact path the writer uses, read live', () => {\n579:     // The probe must target the file the writing daemon actually opens. With an\n580:     // env override set, the writer resolves there; the probe must too, even\n581:     // when called with an unrelated workspaceRoot. A healthy DB under the\n582:     // workspace would mask a corrupt override DB if the probe used the wrong\n583:     // base.\n584:     const workspaceRootDir = workspace('override-probe-workspace');\n585:     writeDb(workspaceRootDir);\n586:     writeGeneration(workspaceRootDir, 'live', 11);\n587: \n588:     const overrideDir = mkdtempSync(join(tmpdir(), 'advisor-status-override-'));\n589:     writeFileSync(join(overrideDir, 'skill-graph.sqlite'), 'not-a-sqlite-database-file-at-all-this-is-corrupt', 'utf8');\n590:     // The generation counter follows the DB dir override, so the live\n591:     // generation the writing daemon published sits beside its database.\n592:     writeFileSync(join(overrideDir, 'skill-graph-generation.json'), `${JSON.stringify({\n593:       generation: 11,\n594:       updatedAt: '2026-04-20T00:00:00.000Z',\n595:       sourceSignature: null,\n596:       reason: 'LIVE_FIXTURE',\n597:       state: 'live',\n598:     })}\\n`, 'utf8');\n599: \n600:     const previous = process.env.SYSTEM_SKILL_ADVISOR_DB_DIR;\n601:     process.env.SYSTEM_SKILL_ADVISOR_DB_DIR = overrideDir;\n602:     try {\n603:       const status = readAdvisorStatus({ workspaceRoot: workspaceRootDir, checkArtifactIntegrity: true });\n604:       // Corruption is read from the OVERRIDE artifact, not the healthy\n605:       // workspace-relative DB, so freshness downgrades to stale.\n606:       expect(status.freshness).toBe('stale');\n607:       expect(status.errors?.some((message) => message.includes('integrity check failed'))).toBe(true);\n608:     } finally {\n609:       if (previous === undefined) {\n610:         delete process.env.SYSTEM_SKILL_ADVISOR_DB_DIR;\n611:       } else {\n612:         process.env.SYSTEM_SKILL_ADVISOR_DB_DIR = previous;\n613:       }\n614:     }\n615:   });\n616: \n617:   it('downgrades a corrupt artifact from live to stale only when integrity is checked', () => {\n618:     const root = workspace('corrupt-artifact');\n619:     writeFileSync(join(root, ADVISOR_DB_RELATIVE_PATH), 'definitely-not-a-valid-sqlite-database-header', 'utf8');\n620:     writeGeneration(root, 'live', 12);\n621: \n622:     // Without the integrity opt-in the generation counters alone report live.\n623:     const optimistic = readAdvisorStatus({ workspaceRoot: root });\n624:     expect(optimistic.freshness).toBe('live');\n625: \n626:     // The recommend path opts in, so the same corrupt artifact reads stale.\n627:     const guarded = readAdvisorStatus({ workspaceRoot: root, checkArtifactIntegrity: true });\n628:     expect(guarded.freshness).toBe('stale');\n629:     expect(guarded.errors?.some((message) => message.includes('integrity check failed'))).toBe(true);\n630:   });\n631: });","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/tests/handlers/advisor-status.vitest.ts, lines 1-631\n1: // ───────────────────────────────────────────────────────────────\n2: // MODULE: Advisor Status Tests\n3: // ───────────────────────────────────────────────────────────────\n4: \n5: import { mkdtempSync, mkdirSync, readFileSync, symlinkSync, utimesSync, writeFileSync } from 'node:fs';\n6: import { join } from 'node:path';\n7: import { tmpdir } from 'node:os';\n8: import Database from 'better-sqlite3';\n9: \n10: import { beforeEach, describe, expect, it, vi } from 'vitest';\n11: \n12: const ollamaMocks = vi.hoisted(() => ({\n13:   probeOllamaModel: vi.fn(),\n14:   resolveOllamaBaseUrl: vi.fn(() => 'http://127.0.0.1:11434'),\n15: }));\n16: \n17: // The handler is the only caller that probes a backend, so the mock keeps\n18: // every other status case free of network access.\n19: vi.mock('../../lib/embedders/adapters/ollama.js', async (importOriginal) => {\n20:   const actual = await importOriginal<typeof import('../../lib/embedders/adapters/ollama.js')>();\n21:   return {\n22:     ...actual,\n23:     probeOllamaModel: ollamaMocks.probeOllamaModel,\n24:     resolveOllamaBaseUrl: ollamaMocks.resolveOllamaBaseUrl,\n25:   };\n26: });\n27: \n28: import { handleAdvisorStatus, readAdvisorStatus } from '../../handlers/advisor-status.js';\n29: import { computeAdvisorSourceSignature } from '../../lib/freshness.js';\n30: import {\n31:   computeSkillMetadataContentHash,\n32:   readCommandEmbeddingSources,\n33: } from '../../lib/skill-graph/skill-graph-db.js';\n34: import { AdvisorStatusOutputSchema } from '../../schemas/advisor-tool-schemas.js';\n35: \n36: const ADVISOR_DB_RELATIVE_PATH = join(\n37:   '.skilled',\n38:   'skills',\n39:   'system-skill-advisor',\n40:   'runtime',\n41:   'database',\n42:   'skill-graph.sqlite',\n43: );\n44: \n45: function workspace(name: string): string {\n46:   const root = mkdtempSync(join(tmpdir(), `advisor-status-${name}-`));\n47:   mkdirSync(join(root, '.skilled', 'skills', '.state', 'advisor'), { recursive: true });\n48:   mkdirSync(join(root, '.skilled', 'skills', 'system-skill-advisor', 'runtime', 'database'), { recursive: true });\n49:   mkdirSync(join(root, '.skilled', 'skills', 'alpha'), { recursive: true });\n50:   writeFileSync(join(root, '.skilled', 'skills', 'alpha', 'graph-metadata.json'), '{\"skill_id\":\"alpha\"}\\n', 'utf8');\n51:   return root;\n52: }\n53: \n54: function writeGeneration(\n55:   root: string,\n56:   state: 'live' | 'stale' | 'absent' | 'unavailable',\n57:   generation = 1,\n58:   sourceSignature: string | null = null,\n59: ): void {\n60:   writeFileSync(join(root, '.skilled', 'skills', '.state', 'advisor', 'skill-graph-generation.json'), `${JSON.stringify({\n61:     generation,\n62:     updatedAt: '2026-04-20T00:00:00.000Z',\n63:     sourceSignature,\n64:     reason: `${state.toUpperCase()}_FIXTURE`,\n65:     state,\n66:   })}\\n`, 'utf8');\n67: }\n68: \n69: function writeDb(root: string): void {\n70:   writeFileSync(join(root, ADVISOR_DB_RELATIVE_PATH), '', 'utf8');\n71: }\n72: \n73: function writeIndexDb(root: string, contentHash: string | null): void {\n74:   const database = new Database(join(root, ADVISOR_DB_RELATIVE_PATH));\n75:   try {\n76:     database.exec(`\n77:       CREATE TABLE skill_nodes (\n78:         id TEXT PRIMARY KEY,\n79:         source_path TEXT,\n80:         content_hash TEXT\n81:       );\n82:     `);\n83:     database.prepare(`\n84:       INSERT INTO skill_nodes (id, source_path, content_hash)\n85:       VALUES (?, ?, ?)\n86:     `).run(\n87:       'alpha',\n88:       join('.skilled', 'skills', 'alpha', 'graph-metadata.json'),\n89:       contentHash,\n90:     );\n91:   } finally {\n92:     database.close();\n93:   }\n94: }\n95: \n96: function writeHealthDb(root: string): void {\n97:   const database = new Database(join(root, ADVISOR_DB_RELATIVE_PATH));\n98:   try {\n99:     database.exec(`\n100:       CREATE TABLE skill_nodes (\n101:         id TEXT PRIMARY KEY,\n102:         embedding BLOB,\n103:         embedding_model_id TEXT,\n104:         embedding_content_hash TEXT\n105:       );\n106:       CREATE TABLE vec_metadata (key TEXT PRIMARY KEY, value TEXT NOT NULL);\n107:       CREATE TABLE vec_768 (\n108:         skill_id TEXT PRIMARY KEY,\n109:         embedding BLOB NOT NULL,\n110:         model_id TEXT NOT NULL,\n111:         content_hash TEXT NOT NULL,\n112:         updated_at TEXT DEFAULT (datetime('now'))\n113:       );\n114:     `);\n115:     database.prepare('INSERT INTO skill_nodes (id) VALUES (?)').run('alpha');\n116:     database.prepare('INSERT INTO skill_nodes (id) VALUES (?)').run('beta');\n117:     database.prepare('INSERT INTO vec_metadata (key, value) VALUES (?, ?)').run('active_embedder_name', 'nomic-embed-text-v1.5');\n118:     database.prepare('INSERT INTO vec_metadata (key, value) VALUES (?, ?)').run('active_embedder_dim', '768');\n119:     database.prepare('INSERT INTO vec_768 (skill_id, embedding, model_id, content_hash, updated_at) VALUES (?, ?, ?, ?, ?)')\n120:       .run('alpha', Buffer.from([1, 2, 3]), 'nomic-embed-text-v1.5', 'hash-alpha', '2026-04-20T00:00:00.000Z');\n121:   } finally {\n122:     database.close();\n123:   }\n124: }\n125: \n126: function writeCommandVectorTable(root: string, rows: number): void {\n127:   const database = new Database(join(root, ADVISOR_DB_RELATIVE_PATH));\n128:   try {\n129:     database.exec(`\n130:       CREATE TABLE vec_cmd_768 (\n131:         command_id TEXT PRIMARY KEY,\n132:         embedding BLOB NOT NULL,\n133:         model_id TEXT NOT NULL,\n134:         content_hash TEXT NOT NULL,\n135:         updated_at TEXT DEFAULT (datetime('now'))\n136:       );\n137:     `);\n138:     const insert = database.prepare(`\n139:       INSERT INTO vec_cmd_768 (command_id, embedding, model_id, content_hash)\n140:       VALUES (?, ?, ?, ?)\n141:     `);\n142:     for (let index = 0; index < rows; index += 1) {\n143:       insert.run(`command-${index}`, Buffer.from([1, 2, 3]), 'nomic-embed-text-v1.5', `hash-${index}`);\n144:     }\n145:   } finally {\n146:     database.close();\n147:   }\n148: }\n149: \n150: function writeDimMismatchHealthDb(root: string): void {\n151:   const database = new Database(join(root, ADVISOR_DB_RELATIVE_PATH));\n152:   try {\n153:     database.exec(`\n154:       CREATE TABLE skill_nodes (id TEXT PRIMARY KEY, embedding BLOB);\n155:       CREATE TABLE vec_metadata (key TEXT PRIMARY KEY, value TEXT NOT NULL);\n156:       CREATE TABLE vec_123 (\n157:         skill_id TEXT PRIMARY KEY,\n158:         embedding BLOB NOT NULL,\n159:         model_id TEXT NOT NULL,\n160:         content_hash TEXT NOT NULL,\n161:         updated_at TEXT DEFAULT (datetime('now'))\n162:       );\n163:     `);\n164:     database.prepare('INSERT INTO skill_nodes (id) VALUES (?)').run('alpha');\n165:     database.prepare('INSERT INTO vec_metadata (key, value) VALUES (?, ?)').run('active_embedder_name', 'nomic-embed-text-v1.5');\n166:     database.prepare('INSERT INTO vec_metadata (key, value) VALUES (?, ?)').run('active_embedder_dim', '123');\n167:   } finally {\n168:     database.close();\n169:   }\n170: }\n171: \n172: describe('advisor_status handler', () => {\n173:   beforeEach(() => {\n174:     ollamaMocks.probeOllamaModel.mockReset();\n175:     ollamaMocks.resolveOllamaBaseUrl.mockReset();\n176:     ollamaMocks.resolveOllamaBaseUrl.mockReturnValue('http://127.0.0.1:11434');\n177:   });\n178: \n179:   it('includes a private skill linked from inside the skills root in the source signature', () => {\n180:     const root = workspace('linked');\n181:     const skills = join(root, '.skilled', 'skills');\n182:     mkdirSync(join(skills, '.private', 'private-beta'), { recursive: true });\n183:     writeFileSync(join(skills, '.private', 'private-beta', 'SKILL.md'), 'first\\n');\n184:     writeFileSync(join(skills, '.private', 'private-beta', 'graph-metadata.json'), '{\"skill_id\":\"local-beta\"}\\n');\n185:     symlinkSync(join(skills, '.private', 'private-beta'), join(skills, 'local-beta'));\n186:     const before = computeAdvisorSourceSignature(root);\n187:     writeFileSync(join(skills, '.private', 'private-beta', 'SKILL.md'), 'second\\n');\n188:     expect(computeAdvisorSourceSignature(root)).not.toBe(before);\n189:   });\n190: \n191:   it('ignores a private skill linked from outside every trusted root', () => {\n192:     const root = workspace('outside');\n193:     const skills = join(root, '.skilled', 'skills');\n194:     const outside = join(root, 'outside-beta');\n195:     mkdirSync(outside, { recursive: true });\n196:     writeFileSync(join(outside, 'SKILL.md'), 'first\\n');\n197:     writeFileSync(join(outside, 'graph-metadata.json'), '{\"skill_id\":\"local-beta\"}\\n');\n198:     symlinkSync(outside, join(skills, 'local-beta'));\n199:     const before = computeAdvisorSourceSignature(root);\n200:     writeFileSync(join(outside, 'SKILL.md'), 'second\\n');\n201:     expect(computeAdvisorSourceSignature(root)).toBe(before);\n202:   });\n203: \n204:   it('includes a private skill linked into a declared external root', () => {\n205:     const root = workspace('declared');\n206:     const skills = join(root, '.skilled', 'skills');\n207:     const external = join(root, 'private-repos');\n208:     const target = join(external, 'sk-code-webflow');\n209:     mkdirSync(target, { recursive: true });\n210:     writeFileSync(join(target, 'SKILL.md'), 'first\\n');\n211:     writeFileSync(join(target, 'graph-metadata.json'), '{\"skill_id\":\"local-webflow\"}\\n');\n212:     symlinkSync(target, join(skills, 'local-webflow'));\n213:     process.env.SPECKIT_PRIVATE_SKILL_ROOTS = external;\n214:     try {\n215:       const before = computeAdvisorSourceSignature(root);\n216:       writeFileSync(join(target, 'SKILL.md'), 'second\\n');\n217:       expect(computeAdvisorSourceSignature(root)).not.toBe(before);\n218:     } finally {\n219:       delete process.env.SPECKIT_PRIVATE_SKILL_ROOTS;\n220:     }\n221:   });\n222: \n223:   // drift: verified against shipped behavior during Unit H\n224:   it('reports live freshness', () => {\n225:     const root = workspace('live');\n226:     writeDb(root);\n227:     writeGeneration(root, 'live', 3);\n228: \n229:     const status = readAdvisorStatus({ workspaceRoot: root });\n230: \n231:     expect(status.freshness).toBe('live');\n232:     expect(status.trustState.state).toBe('live');\n233:     expect(status.generation).toBe(3);\n234:     expect(status.trustState.lastLiveAt).toBe('2026-04-20T00:00:00.000Z');\n235:     expect(status.lastScanAt).toBe('2026-04-20T00:00:00.000Z');\n236:     expect(status.skillCount).toBe(1);\n237:     expect(status.laneWeights.explicit_author).toBe(0.42);\n238:     expect(status.semanticLaneHealth).toBeUndefined();\n239:   });\n240: \n241:   it('reports fresh index hashes without changing a live generation', () => {\n242:     const root = workspace('index-fresh');\n243:     const metadataPath = join(root, '.skilled', 'skills', 'alpha', 'graph-metadata.json');\n244:     const contentHash = computeSkillMetadataContentHash(readFileSync(metadataPath, 'utf8'));\n245:     writeIndexDb(root, contentHash);\n246:     writeGeneration(root, 'live', 3, computeAdvisorSourceSignature(root));\n247: \n248:     const status = readAdvisorStatus({ workspaceRoot: root });\n249: \n250:     expect(status.freshness).toBe('live');\n251:     expect(status.indexStaleness).toEqual({\n252:       state: 'fresh',\n253:       reason: null,\n254:       trackedSkills: 1,\n255:       freshSourceFiles: 1,\n256:       changedSourceFiles: 0,\n257:       missingSourceFiles: 0,\n258:       staleSkillIds: [],\n259:     });\n260:   });\n261: \n262:   it('marks live generations stale when index hashes differ from disk', () => {\n263:     const root = workspace('index-stale');\n264:     writeIndexDb(root, 'outdated-hash');\n265:     writeGeneration(root, 'live', 4, computeAdvisorSourceSignature(root));\n266: \n267:     const status = readAdvisorStatus({ workspaceRoot: root });\n268: \n269:     expect(status.freshness).toBe('stale');\n270:     expect(status.trustState.state).toBe('stale');\n271:     expect(status.indexStaleness).toEqual(expect.objectContaining({\n272:       state: 'stale',\n273:       reason: 'source_hash_mismatch',\n274:       changedSourceFiles: 1,\n275:     }));\n276:     expect(status.errors).toContain(\n277:       'advisor_status index content hashes differ from disk for 1 skill; run advisor_rebuild',\n278:     );\n279:   });\n280: \n281:   it('reports unavailable index staleness when the database is absent', () => {\n282:     const root = workspace('index-absent');\n283:     writeGeneration(root, 'live', 5, computeAdvisorSourceSignature(root));\n284: \n285:     const status = readAdvisorStatus({ workspaceRoot: root });\n286: \n287:     expect(status.indexStaleness).toEqual(expect.objectContaining({\n288:       state: 'unavailable',\n289:       reason: 'database_absent',\n290:     }));\n291:   });\n292: \n293:   it('reports semantic-lane health only when requested', () => {\n294:     const root = workspace('semantic-health');\n295:     writeHealthDb(root);\n296:     writeGeneration(root, 'live', 8);\n297: \n298:     const compact = readAdvisorStatus({ workspaceRoot: root });\n299:     const detailed = readAdvisorStatus({ workspaceRoot: root, includeSemanticHealth: true });\n300: \n301:     expect(compact.semanticLaneHealth).toBeUndefined();\n302:     expect(detailed.semanticLaneHealth).toEqual(expect.objectContaining({\n303:       activeEmbedder: expect.objectContaining({\n304:         name: 'nomic-embed-text-v1.5',\n305:         dim: 768,\n306:         adapterDim: 768,\n307:       }),\n308:       vectorCoverage: {\n309:         embedded: 1,\n310:         total: 2,\n311:         ratio: 0.5,\n312:       },\n313:       dimMismatch: false,\n314:       lastRefresh: '2026-04-20T00:00:00.000Z',\n315:       disabledReason: null,\n316:       laneEnabled: true,\n317:     }));\n318:   });\n319: \n320:   it('surfaces semantic-lane dim mismatch as a disabled reason', () => {\n321:     const root = workspace('semantic-dim-mismatch');\n322:     writeDimMismatchHealthDb(root);\n323:     writeGeneration(root, 'live', 9);\n324: \n325:     const status = readAdvisorStatus({ workspaceRoot: root, includeSemanticHealth: true });\n326: \n327:     expect(status.semanticLaneHealth).toEqual(expect.objectContaining({\n328:       activeEmbedder: expect.objectContaining({\n329:         name: 'nomic-embed-text-v1.5',\n330:         dim: 123,\n331:         adapterDim: 768,\n332:       }),\n333:       dimMismatch: true,\n334:       disabledReason: 'dim_mismatch',\n335:       laneEnabled: false,\n336:     }));\n337:   });\n338: \n339:   it('reports zero command-vector coverage when no command table exists', () => {\n340:     const root = workspace('command-coverage-absent');\n341:     writeHealthDb(root);\n342:     writeGeneration(root, 'live', 10);\n343: \n344:     const status = readAdvisorStatus({ workspaceRoot: root, includeSemanticHealth: true });\n345:     const sourceTotal = readCommandEmbeddingSources()?.length ?? 0;\n346: \n347:     expect(status.semanticLaneHealth?.commandVectorCoverage).toEqual({\n348:       embedded: 0,\n349:       total: sourceTotal,\n350:     });\n351:   });\n352: \n353:   it('counts command-vector rows when the command table exists', () => {\n354:     const root = workspace('command-coverage-present');\n355:     writeHealthDb(root);\n356:     writeCommandVectorTable(root, 3);\n357:     writeGeneration(root, 'live', 10);\n358: \n359:     const status = readAdvisorStatus({ workspaceRoot: root, includeSemanticHealth: true });\n360:     const sourceTotal = readCommandEmbeddingSources()?.length ?? 0;\n361: \n362:     expect(status.semanticLaneHealth?.commandVectorCoverage).toEqual({\n363:       embedded: 3,\n364:       total: sourceTotal,\n365:     });\n366:   });\n367: \n368:   it('reports a reachable backend when the model is loaded', async () => {\n369:     const root = workspace('backend-reachable');\n370:     writeHealthDb(root);\n371:     writeGeneration(root, 'live', 14);\n372:     ollamaMocks.probeOllamaModel.mockResolvedValue({ available: true });\n373: \n374:     const response = await handleAdvisorStatus({ workspaceRoot: root, includeSemanticHealth: true });\n375:     const envelope = JSON.parse(response.content[0].text) as { data: unknown };\n376:     const status = AdvisorStatusOutputSchema.parse(envelope.data);\n377: \n378:     expect(ollamaMocks.probeOllamaModel).toHaveBeenCalledWith(\n379:       'http://127.0.0.1:11434',\n380:       'nomic-embed-text:v1.5',\n381:       500,\n382:     );\n383:     expect(status.semanticLaneHealth?.backend).toEqual({ state: 'reachable', reason: null });\n384:     expect(status.semanticLaneHealth?.laneEnabled).toBe(true);\n385:   });\n386: \n387:   it('reports an unreachable backend when the probe cannot connect', async () => {\n388:     const root = workspace('backend-unreachable');\n389:     writeHealthDb(root);\n390:     writeGeneration(root, 'live', 14);\n391:     const reason = 'Ollama backend unreachable at http://127.0.0.1:11434: fetch failed';\n392:     ollamaMocks.probeOllamaModel.mockResolvedValue({ available: false, reason });\n393: \n394:     const response = await handleAdvisorStatus({ workspaceRoot: root, includeSemanticHealth: true });\n395:     const envelope = JSON.parse(response.content[0].text) as { data: unknown };\n396:     const status = AdvisorStatusOutputSchema.parse(envelope.data);\n397: \n398:     expect(status.semanticLaneHealth?.backend).toEqual({ state: 'unreachable', reason });\n399:     expect(status.semanticLaneHealth?.laneEnabled).toBe(false);\n400:   });\n401: \n402:   it('reports a missing model when the server answers without it', async () => {\n403:     const root = workspace('backend-model-missing');\n404:     writeHealthDb(root);\n405:     writeGeneration(root, 'live', 14);\n406:     const reason = 'Ollama model is not loaded: nomic-embed-text:v1.5';\n407:     ollamaMocks.probeOllamaModel.mockResolvedValue({ available: false, reason });\n408: \n409:     const response = await handleAdvisorStatus({ workspaceRoot: root, includeSemanticHealth: true });\n410:     const envelope = JSON.parse(response.content[0].text) as { data: unknown };\n411:     const status = AdvisorStatusOutputSchema.parse(envelope.data);\n412: \n413:     expect(status.semanticLaneHealth?.backend).toEqual({ state: 'model_missing', reason });\n414:     expect(status.semanticLaneHealth?.laneEnabled).toBe(false);\n415:   });\n416: \n417:   // drift: verified against shipped behavior during Unit H\n418:   it('keeps signed generations live when source mtimes exceed skipped SQLite writes', () => {\n419:     const root = workspace('signed-live');\n420:     writeDb(root);\n421:     const dbPath = join(root, ADVISOR_DB_RELATIVE_PATH);\n422:     const metadataPath = join(root, '.skilled', 'skills', 'alpha', 'graph-metadata.json');\n423:     utimesSync(dbPath, new Date('2026-04-19T00:00:00.000Z'), new Date('2026-04-19T00:00:00.000Z'));\n424:     utimesSync(metadataPath, new Date('2026-04-21T00:00:00.000Z'), new Date('2026-04-21T00:00:00.000Z'));\n425:     const sourceSignature = computeAdvisorSourceSignature(root);\n426:     writeFileSync(join(root, '.skilled', 'skills', '.state', 'advisor', 'skill-graph-generation.json'), `${JSON.stringify({\n427:       generation: 9,\n428:       updatedAt: '2026-04-22T00:00:00.000Z',\n429:       sourceSignature,\n430:       reason: 'advisor_rebuild',\n431:       state: 'live',\n432:     })}\\n`, 'utf8');\n433: \n434:     const status = readAdvisorStatus({ workspaceRoot: root });\n435: \n436:     expect(status.freshness).toBe('live');\n437:     expect(status.trustState.state).toBe('live');\n438:   });\n439: \n440:   // drift: verified against shipped behavior during Unit H\n441:   it('marks live generations stale when nested graph metadata is newer than the database', () => {\n442:     const root = workspace('nested-mtime');\n443:     writeDb(root);\n444:     writeGeneration(root, 'live', 6);\n445:     const dbPath = join(root, ADVISOR_DB_RELATIVE_PATH);\n446:     const metadataPath = join(root, '.skilled', 'skills', 'alpha', 'graph-metadata.json');\n447:     utimesSync(dbPath, new Date('2026-04-19T00:00:00.000Z'), new Date('2026-04-19T00:00:00.000Z'));\n448:     utimesSync(metadataPath, new Date('2026-04-21T00:00:00.000Z'), new Date('2026-04-21T00:00:00.000Z'));\n449: \n450:     const status = readAdvisorStatus({ workspaceRoot: root });\n451: \n452:     expect(status.freshness).toBe('stale');\n453:     expect(status.trustState.lastLiveAt).toBe('2026-04-20T00:00:00.000Z');\n454:   });\n455: \n456:   // drift: verified against shipped behavior during Unit H\n457:   it('reports stale freshness', () => {\n458:     const root = workspace('stale');\n459:     writeDb(root);\n460:     writeGeneration(root, 'stale', 4);\n461: \n462:     const status = readAdvisorStatus({ workspaceRoot: root });\n463: \n464:     expect(status.freshness).toBe('stale');\n465:     expect(status.trustState.reason).toBe('STALE_FIXTURE');\n466:   });\n467: \n468:   it('reports absent freshness when no artifact exists', () => {\n469:     const root = workspace('absent');\n470:     writeGeneration(root, 'absent', 0);\n471: \n472:     const status = readAdvisorStatus({ workspaceRoot: root });\n473: \n474:     expect(status.freshness).toBe('absent');\n475:   });\n476: \n477:   // drift: verified against shipped behavior during Unit H\n478:   it('reports unavailable for corrupt generation metadata', () => {\n479:     const root = workspace('unavailable');\n480:     writeFileSync(join(root, '.skilled', 'skills', '.state', 'advisor', 'skill-graph-generation.json'), '{', 'utf8');\n481: \n482:     const status = readAdvisorStatus({ workspaceRoot: root });\n483: \n484:     expect(status.freshness).toBe('unavailable');\n485:     expect(status.errors?.length).toBeGreaterThan(0);\n486:   });\n487: \n488:   it('does not leak prompt content in status output', async () => {\n489:     const root = workspace('privacy');\n490:     writeDb(root);\n491:     writeGeneration(root, 'live', 5);\n492: \n493:     const raw = (await handleAdvisorStatus({ workspaceRoot: root })).content[0].text;\n494: \n495:     expect(raw).not.toContain('prompt');\n496:     expect(raw).not.toContain('secret@example.com');\n497:   });\n498: \n499:   it('omits embeddings health when the option is absent', async () => {\n500:     const root = workspace('embeddings-health-omitted');\n501:     const response = await handleAdvisorStatus({ workspaceRoot: root });\n502:     const envelope = JSON.parse(response.content[0].text) as { data: unknown };\n503:     const status = AdvisorStatusOutputSchema.parse(envelope.data);\n504: \n505:     expect(status).not.toHaveProperty('embeddingsHealth');\n506:   });\n507: \n508:   it('returns a schema-valid unavailable model-server state when requested', async () => {\n509:     const root = workspace('embeddings-health-unavailable');\n510:     const originalServerUrl = process.env.HF_EMBED_SERVER_URL;\n511: \n512:     try {\n513:       process.env.HF_EMBED_SERVER_URL = join(root, 'missing-hf-embed.sock');\n514:       const response = await handleAdvisorStatus({\n515:         workspaceRoot: root,\n516:         includeEmbeddingsHealth: true,\n517:       });\n518:       const envelope = JSON.parse(response.content[0].text) as { data: unknown };\n519:       const status = AdvisorStatusOutputSchema.parse(envelope.data);\n520: \n521:       expect(status.embeddingsHealth?.modelServer.state).toBe('unavailable');\n522:     } finally {\n523:       if (originalServerUrl === undefined) delete process.env.HF_EMBED_SERVER_URL;\n524:       else process.env.HF_EMBED_SERVER_URL = originalServerUrl;\n525:     }\n526:   });\n527: \n528:   // drift: verified against shipped behavior during Unit H\n529:   it('caps metadata scanning when requested to avoid unbounded status walks', () => {\n530:     const root = workspace('scan-cap');\n531:     writeDb(root);\n532:     writeGeneration(root, 'live', 7);\n533:     mkdirSync(join(root, '.skilled', 'skills', 'beta'), { recursive: true });\n534:     writeFileSync(join(root, '.skilled', 'skills', 'beta', 'graph-metadata.json'), '{\"skill_id\":\"beta\"}\\n', 'utf8');\n535: \n536:     const status = readAdvisorStatus({ workspaceRoot: root, maxMetadataFiles: 1 });\n537: \n538:     expect(status.skillCount).toBe(1);\n539:     expect(status.errors).toEqual([\n540:       expect.stringContaining('metadata scan capped at 1 files'),\n541:     ]);\n542:   });\n543: \n544:   it('counts only depth-one skill roots with graph metadata', () => {\n545:     const root = workspace('root-only-scan');\n546:     writeDb(root);\n547:     writeGeneration(root, 'live', 7);\n548:     mkdirSync(join(root, '.skilled', 'skills', 'beta'), { recursive: true });\n549:     writeFileSync(join(root, '.skilled', 'skills', 'beta', 'graph-metadata.json'), '{\"skill_id\":\"beta\"}\\n', 'utf8');\n550:     mkdirSync(join(root, '.skilled', 'skills', 'alpha', 'nested'), { recursive: true });\n551:     writeFileSync(join(root, '.skilled', 'skills', 'alpha', 'nested', 'graph-metadata.json'), '{\"skill_id\":\"nested\"}\\n', 'utf8');\n552: \n553:     const status = readAdvisorStatus({ workspaceRoot: root });\n554: \n555:     expect(status.skillCount).toBe(2);\n556:   });\n557: \n558:   it('counts a private skill linked from inside the skills root and not one linked from outside', () => {\n559:     const root = workspace('private-link-scan');\n560:     writeDb(root);\n561:     writeGeneration(root, 'live', 7);\n562:     const skills = join(root, '.skilled', 'skills');\n563:     const inside = join(skills, '.private', 'private-beta');\n564:     const outside = join(root, 'outside', 'private-evil');\n565:     for (const dir of [inside, outside]) {\n566:       mkdirSync(dir, { recursive: true });\n567:       writeFileSync(join(dir, 'graph-metadata.json'), '{\"skill_id\":\"local-x\"}\\n', 'utf8');\n568:     }\n569:     symlinkSync(inside, join(skills, 'local-beta'));\n570:     symlinkSync(outside, join(skills, 'local-evil'));\n571: \n572:     const status = readAdvisorStatus({ workspaceRoot: root });\n573: \n574:     // The fixture's own skill plus the trusted link; the outside link is not counted.\n575:     expect(status.skillCount).toBe(2);\n576:   });\n577: \n578:   it('probes the env-override artifact path the writer uses, read live', () => {\n579:     // The probe must target the file the writing daemon actually opens. With an\n580:     // env override set, the writer resolves there; the probe must too, even\n581:     // when called with an unrelated workspaceRoot. A healthy DB under the\n582:     // workspace would mask a corrupt override DB if the probe used the wrong\n583:     // base.\n584:     const workspaceRootDir = workspace('override-probe-workspace');\n585:     writeDb(workspaceRootDir);\n586:     writeGeneration(workspaceRootDir, 'live', 11);\n587: \n588:     const overrideDir = mkdtempSync(join(tmpdir(), 'advisor-status-override-'));\n589:     writeFileSync(join(overrideDir, 'skill-graph.sqlite'), 'not-a-sqlite-database-file-at-all-this-is-corrupt', 'utf8');\n590:     // The generation counter follows the DB dir override, so the live\n591:     // generation the writing daemon published sits beside its database.\n592:     writeFileSync(join(overrideDir, 'skill-graph-generation.json'), `${JSON.stringify({\n593:       generation: 11,\n594:       updatedAt: '2026-04-20T00:00:00.000Z',\n595:       sourceSignature: null,\n596:       reason: 'LIVE_FIXTURE',\n597:       state: 'live',\n598:     })}\\n`, 'utf8');\n599: \n600:     const previous = process.env.SYSTEM_SKILL_ADVISOR_DB_DIR;\n601:     process.env.SYSTEM_SKILL_ADVISOR_DB_DIR = overrideDir;\n602:     try {\n603:       const status = readAdvisorStatus({ workspaceRoot: workspaceRootDir, checkArtifactIntegrity: true });\n604:       // Corruption is read from the OVERRIDE artifact, not the healthy\n605:       // workspace-relative DB, so freshness downgrades to stale.\n606:       expect(status.freshness).toBe('stale');\n607:       expect(status.errors?.some((message) => message.includes('integrity check failed'))).toBe(true);\n608:     } finally {\n609:       if (previous === undefined) {\n610:         delete process.env.SYSTEM_SKILL_ADVISOR_DB_DIR;\n611:       } else {\n612:         process.env.SYSTEM_SKILL_ADVISOR_DB_DIR = previous;\n613:       }\n614:     }\n615:   });\n616: \n617:   it('downgrades a corrupt artifact from live to stale only when integrity is checked', () => {\n618:     const root = workspace('corrupt-artifact');\n619:     writeFileSync(join(root, ADVISOR_DB_RELATIVE_PATH), 'definitely-not-a-valid-sqlite-database-header', 'utf8');\n620:     writeGeneration(root, 'live', 12);\n621: \n622:     // Without the integrity opt-in the generation counters alone report live.\n623:     const optimistic = readAdvisorStatus({ workspaceRoot: root });\n624:     expect(optimistic.freshness).toBe('live');\n625: \n626:     // The recommend path opts in, so the same corrupt artifact reads stale.\n627:     const guarded = readAdvisorStatus({ workspaceRoot: root, checkArtifactIntegrity: true });\n628:     expect(guarded.freshness).toBe('stale');\n629:     expect(guarded.errors?.some((message) => message.includes('integrity check failed'))).toBe(true);\n630:   });\n631: });"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\": \"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/tests/handlers/advisor-status.vitest.ts\"}"},"time":{"start":1794540052054,"end":1794540056555}}}}
