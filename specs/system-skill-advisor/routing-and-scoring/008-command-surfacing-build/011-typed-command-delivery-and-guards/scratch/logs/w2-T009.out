{"type":"tool_use","timestamp":1794540042926,"sessionID":"ses_e2d148875ffeU9dgsF1CpQl6Z6","part":{"partID":"prt_1d2ebf71f001vpp5Vdci1RfWQj","sessionID":"ses_e2d148875ffeU9dgsF1CpQl6Z6","messageID":"msg_1d2ebd581001W0Ll8VrS8TvGsa","type":"tool","id":"call_bcf3552538174f578062d5ec","tool":"read","state":{"status":"completed","input":{"path":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/handlers/advisor-status.ts"},"output":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/handlers/advisor-status.ts, lines 1-549\n1: // ───────────────────────────────────────────────────────────────\n2: // MODULE: advisor_status Handler\n3: // ───────────────────────────────────────────────────────────────\n4: \n5: // ───────────────────────────────────────────────────────────────────\n6: // 1. IMPORTS\n7: // ───────────────────────────────────────────────────────────────────\n8: \n9: import { existsSync, readFileSync, readdirSync, statSync } from 'node:fs';\n10: import { join, resolve } from 'node:path';\n11: import Database from 'better-sqlite3';\n12: \n13: import { computeAdvisorSourceSignature } from '../lib/freshness.js';\n14: import { readSkillGraphGeneration } from '../lib/freshness/generation.js';\n15: import { checkSqliteIntegrity } from '../lib/freshness/sqlite-integrity.js';\n16: import { createPrivateSkillLinkCheck } from '../lib/private-skill-target.js';\n17: import {\n18:   computeSkillMetadataContentHash,\n19:   isGenuineCorruptionReason,\n20:   readCommandEmbeddingSources,\n21:   resolveSkillGraphDbDir,\n22:   DB_FILENAME,\n23: } from '../lib/skill-graph/skill-graph-db.js';\n24: import { createTrustState } from '../lib/freshness/trust-state.js';\n25: import { getAdapter, getManifest } from '../lib/embedders/registry.js';\n26: import { probeOllamaModel, resolveOllamaBaseUrl } from '../lib/embedders/adapters/ollama.js';\n27: import { commandVecTableNameForDim } from '../lib/embedders/schema.js';\n28: import { readEmbeddingsHealth } from '../lib/embedders/embeddings-health.js';\n29: import { getSemanticShadowRuntimeHealth } from '../lib/scorer/lanes/semantic-shadow.js';\n30: import { readAdvisorEmbeddingStaleness } from '../lib/scorer/projection.js';\n31: import { DEFAULT_SCORER_WEIGHTS } from '../lib/scorer/weights-config.js';\n32: import { errorMessage } from '../lib/utils/error-format.js';\n33: import { redactDiagnosticText } from './skill-graph/response-envelope.js';\n34: import {\n35:   AdvisorStatusInputSchema,\n36:   AdvisorStatusOutputSchema,\n37: } from '../schemas/advisor-tool-schemas.js';\n38: \n39: import type {\n40:   AdvisorFreshness,\n41:   AdvisorStatusInput,\n42:   AdvisorStatusOutput,\n43: } from '../schemas/advisor-tool-schemas.js';\n44: \n45: // ───────────────────────────────────────────────────────────────────\n46: // 2. TYPE DEFINITIONS AND CONSTANTS\n47: // ───────────────────────────────────────────────────────────────────\n48: \n49: type HandlerResponse = { content: Array<{ type: string; text: string }> };\n50: type IndexStaleness = NonNullable<AdvisorStatusOutput['indexStaleness']>;\n51: \n52: const SKILL_ROOT = join('.skilled', 'skills');\n53: const DEFAULT_MAX_METADATA_FILES = 5_000;\n54: type SemanticLaneHealth = NonNullable<AdvisorStatusOutput['semanticLaneHealth']>;\n55: \n56: // ───────────────────────────────────────────────────────────────────\n57: // 3. HELPERS\n58: // ───────────────────────────────────────────────────────────────────\n59: \n60: function isFreshness(value: string): value is AdvisorFreshness {\n61:   return value === 'live' || value === 'stale' || value === 'absent' || value === 'unavailable';\n62: }\n63: \n64: function parseDaemonPid(): number | undefined {\n65:   const raw = process.env.SPECKIT_SKILL_GRAPH_DAEMON_PID;\n66:   if (!raw) return undefined;\n67:   const parsed = Number(raw);\n68:   return Number.isSafeInteger(parsed) && parsed > 0 ? parsed : undefined;\n69: }\n70: \n71: function hasRunningDaemon(pid: number | undefined): boolean {\n72:   if (!pid) {\n73:     return false;\n74:   }\n75:   try {\n76:     process.kill(pid, 0);\n77:     return true;\n78:   } catch {\n79:     return false;\n80:   }\n81: }\n82: \n83: function fileMtimeMs(path: string): number {\n84:   if (!existsSync(path)) return 0;\n85:   const stat = statSync(path);\n86:   return stat.mtimeMs;\n87: }\n88: \n89: function resolveSkillGraphDbPath(workspaceRoot: string): string {\n90:   // Resolve through the writer's own resolver so the integrity probe always\n91:   // targets the exact file the daemon writes. An env override wins for both;\n92:   // otherwise the workspace root stands in for the writer's cwd, which match\n93:   // in the normal single-root deployment.\n94:   return join(resolveSkillGraphDbDir(workspaceRoot), DB_FILENAME);\n95: }\n96: \n97: // Per-(dbPath, generation, mtime) integrity verdict cache. A full quick_check\n98: // scans the artifact, which is too costly to run on the recommend hot path;\n99: // caching it lets recommend opt into corruption detection while paying the\n100: // scan at most once per generation. The only events that can change on-disk\n101: // integrity — a generation bump or an mtime change — invalidate the entry.\n102: const integrityVerdictCache = new Map<string, { ok: true } | { ok: false; reason: string }>();\n103: \n104: function checkSqliteIntegrityCached(\n105:   dbPath: string,\n106:   generation: number,\n107:   mtimeMs: number,\n108: ): { ok: true } | { ok: false; reason: string } {\n109:   const key = `${dbPath}::${generation}::${mtimeMs}`;\n110:   const cached = integrityVerdictCache.get(key);\n111:   if (cached) {\n112:     return cached;\n113:   }\n114:   const result = checkSqliteIntegrity(dbPath);\n115:   // Only the newest (path, generation, mtime) verdict is ever consulted, so a\n116:   // single-entry cache is sufficient and self-bounding.\n117:   integrityVerdictCache.clear();\n118:   integrityVerdictCache.set(key, result);\n119:   return result;\n120: }\n121: \n122: function tableExists(database: Database.Database, tableName: string): boolean {\n123:   const row = database.prepare(`\n124:     SELECT 1 AS present\n125:     FROM sqlite_master\n126:     WHERE type = 'table' AND name = ?\n127:     LIMIT 1\n128:   `).get(tableName) as { present: number } | undefined;\n129:   return Boolean(row);\n130: }\n131: \n132: function metadataValue(database: Database.Database, key: string): string | null {\n133:   if (!tableExists(database, 'vec_metadata')) return null;\n134:   const row = database.prepare('SELECT value FROM vec_metadata WHERE key = ?').get(key) as { value: string } | undefined;\n135:   return row?.value ?? null;\n136: }\n137: \n138: function countRows(database: Database.Database, sql: string): number {\n139:   const row = database.prepare(sql).get() as { c: number } | undefined;\n140:   return row?.c ?? 0;\n141: }\n142: \n143: function maxUpdatedAt(database: Database.Database, tableName: string): string | null {\n144:   const row = database.prepare(`SELECT MAX(updated_at) AS updatedAt FROM ${tableName}`).get() as { updatedAt: string | null } | undefined;\n145:   return row?.updatedAt ?? null;\n146: }\n147: \n148: function baseSemanticLaneHealth(disabledReason: string | null): SemanticLaneHealth {\n149:   return {\n150:     activeEmbedder: null,\n151:     vectorCoverage: { embedded: 0, total: 0, ratio: 0 },\n152:     dimMismatch: false,\n153:     lastRefresh: null,\n154:     disabledReason,\n155:     laneEnabled: false,\n156:     checkedAt: new Date().toISOString(),\n157:   };\n158: }\n159: \n160: function readSemanticLaneHealth(dbPath: string): SemanticLaneHealth {\n161:   const runtime = getSemanticShadowRuntimeHealth();\n162:   // The command projection's size does not depend on the database, so the\n163:   // denominator is known even when the artifact is missing or unreadable.\n164:   const commandTotal = readCommandEmbeddingSources()?.length ?? 0;\n165:   if (!existsSync(dbPath)) {\n166:     return {\n167:       ...baseSemanticLaneHealth(runtime.disabledReason ?? 'database_absent'),\n168:       commandVectorCoverage: { embedded: 0, total: commandTotal },\n169:     };\n170:   }\n171: \n172:   let database: Database.Database | null = null;\n173:   try {\n174:     database = new Database(dbPath, { readonly: true, fileMustExist: true });\n175:     const total = tableExists(database, 'skill_nodes')\n176:       ? countRows(database, 'SELECT COUNT(*) AS c FROM skill_nodes')\n177:       : 0;\n178:     const activeName = metadataValue(database, 'active_embedder_name');\n179:     const activeDimRaw = metadataValue(database, 'active_embedder_dim');\n180:     const activeDim = activeDimRaw ? Number.parseInt(activeDimRaw, 10) : 0;\n181:     const hasActive = Boolean(activeName) && Number.isInteger(activeDim) && activeDim > 0;\n182:     const adapter = activeName ? getAdapter(activeName) : undefined;\n183:     const activeEmbedder = activeName\n184:       ? { name: activeName, dim: Number.isInteger(activeDim) && activeDim > 0 ? activeDim : 0, adapterDim: adapter?.dim ?? null }\n185:       : null;\n186:     const tableName = hasActive ? `vec_${activeDim}` : null;\n187:     const hasVecTable = tableName ? tableExists(database, tableName) : false;\n188:     const embedded = hasVecTable\n189:       ? countRows(database, `SELECT COUNT(*) AS c FROM ${tableName} WHERE embedding IS NOT NULL`)\n190:       : (tableExists(database, 'skill_nodes') ? countRows(database, 'SELECT COUNT(*) AS c FROM skill_nodes WHERE embedding IS NOT NULL') : 0);\n191:     const lastRefresh = hasVecTable && tableName ? maxUpdatedAt(database, tableName) : null;\n192:     const commandTable = hasActive ? commandVecTableNameForDim(activeDim) : null;\n193:     const commandEmbedded = commandTable && tableExists(database, commandTable)\n194:       ? countRows(database, `SELECT COUNT(*) AS c FROM ${commandTable}`)\n195:       : 0;\n196:     const dimMismatch = Boolean(activeEmbedder && activeEmbedder.adapterDim !== null && activeEmbedder.dim !== activeEmbedder.adapterDim);\n197:     const staleness = readAdvisorEmbeddingStaleness(database);\n198:     const disabledReason = dimMismatch\n199:       ? 'dim_mismatch'\n200:       : (staleness.stale\n201:           ? 'projection_embedding_stale'\n202:           : (!hasActive\n203:               ? 'active_embedder_unset'\n204:               : (!adapter\n205:                   ? 'adapter_unavailable'\n206:                   : (!hasVecTable\n207:                       ? 'vector_table_missing'\n208:                       : (total > 0 && embedded === 0 ? 'no_skill_vectors' : runtime.disabledReason)))));\n209:     return {\n210:       activeEmbedder,\n211:       vectorCoverage: {\n212:         embedded,\n213:         total,\n214:         ratio: total > 0 ? Math.round((embedded / total) * 1_000_000) / 1_000_000 : 0,\n215:       },\n216:       commandVectorCoverage: { embedded: commandEmbedded, total: commandTotal },\n217:       dimMismatch,\n218:       lastRefresh,\n219:       disabledReason,\n220:       laneEnabled: Boolean(hasActive && adapter && !dimMismatch && !staleness.stale && hasVecTable && embedded > 0 && !disabledReason),\n221:       checkedAt: new Date().toISOString(),\n222:     };\n223:   } catch {\n224:     return {\n225:       ...baseSemanticLaneHealth(runtime.disabledReason ?? 'health_unavailable'),\n226:       commandVectorCoverage: { embedded: 0, total: commandTotal },\n227:     };\n228:   } finally {\n229:     database?.close();\n230:   }\n231: }\n232: \n233: function readIndexStaleness(dbPath: string, workspaceRoot: string): IndexStaleness {\n234:   const unavailable = (reason: string): IndexStaleness => ({\n235:     state: 'unavailable',\n236:     reason,\n237:     trackedSkills: 0,\n238:     freshSourceFiles: 0,\n239:     changedSourceFiles: 0,\n240:     missingSourceFiles: 0,\n241:     staleSkillIds: [],\n242:   });\n243:   if (!existsSync(dbPath)) return unavailable('database_absent');\n244: \n245:   let database: Database.Database | null = null;\n246:   let result = unavailable('index_read_failed');\n247:   try {\n248:     database = new Database(dbPath, { readonly: true, fileMustExist: true });\n249:     if (!tableExists(database, 'skill_nodes')) {\n250:       result = unavailable('index_rows_absent');\n251:     } else {\n252:       const columns = database.pragma('table_info(skill_nodes)') as Array<{ name: string }>;\n253:       const hasSourceColumns = columns.some((column) => column.name === 'source_path')\n254:         && columns.some((column) => column.name === 'content_hash');\n255:       if (!hasSourceColumns) {\n256:         result = unavailable('index_rows_absent');\n257:       } else {\n258:         const rows = database.prepare(`\n259:           SELECT id, source_path, content_hash\n260:           FROM skill_nodes\n261:           ORDER BY id\n262:         `).all() as Array<{\n263:           id: string;\n264:           source_path: string | null;\n265:           content_hash: string | null;\n266:         }>;\n267:         if (rows.length === 0) {\n268:           result = unavailable('index_rows_absent');\n269:         } else {\n270:           let freshSourceFiles = 0;\n271:           let changedSourceFiles = 0;\n272:           let missingSourceFiles = 0;\n273:           const staleSkillIds: string[] = [];\n274: \n275:           for (const row of rows) {\n276:             if (!row.source_path || row.source_path.trim().length === 0) {\n277:               missingSourceFiles++;\n278:               staleSkillIds.push(row.id);\n279:               continue;\n280:             }\n281: \n282:             let content: string;\n283:             try {\n284:               content = readFileSync(resolve(workspaceRoot, row.source_path), 'utf8');\n285:             } catch (error: unknown) {\n286:               if (error instanceof Error && 'code' in error && error.code === 'ENOENT') {\n287:                 missingSourceFiles++;\n288:                 staleSkillIds.push(row.id);\n289:                 continue;\n290:               }\n291:               throw error;\n292:             }\n293: \n294:             if (row.content_hash === null\n295:               || computeSkillMetadataContentHash(content) !== row.content_hash) {\n296:               changedSourceFiles++;\n297:               staleSkillIds.push(row.id);\n298:               continue;\n299:             }\n300: \n301:             freshSourceFiles++;\n302:           }\n303: \n304:           const stale = changedSourceFiles + missingSourceFiles > 0;\n305:           result = {\n306:             state: stale ? 'stale' : 'fresh',\n307:             reason: stale ? 'source_hash_mismatch' : null,\n308:             trackedSkills: rows.length,\n309:             freshSourceFiles,\n310:             changedSourceFiles,\n311:             missingSourceFiles,\n312:             staleSkillIds: staleSkillIds.slice(0, 25),\n313:           };\n314:         }\n315:       }\n316:     }\n317:   } catch {\n318:     result = unavailable('index_read_failed');\n319:   } finally {\n320:     try {\n321:       database?.close();\n322:     } catch {\n323:       result = unavailable('index_read_failed');\n324:     }\n325:   }\n326: \n327:   return result;\n328: }\n329: \n330: function scanSkillMetadataFiles(\n331:   skillRoot: string,\n332:   maxFiles = DEFAULT_MAX_METADATA_FILES,\n333: ): { count: number; maxMtimeMs: number; truncated: boolean } {\n334:   if (!existsSync(skillRoot)) return { count: 0, maxMtimeMs: 0, truncated: false };\n335:   const isTrustedLink = createPrivateSkillLinkCheck(skillRoot);\n336:   const skillRoots = readdirSync(skillRoot, { withFileTypes: true })\n337:     .filter((entry) => !entry.name.startsWith('.') && (entry.isDirectory()\n338:       || (entry.name.startsWith('local-')\n339:         && entry.isSymbolicLink()\n340:         && isTrustedLink(join(skillRoot, entry.name)))))\n341:     .sort((left, right) => left.name.localeCompare(right.name));\n342:   let count = 0;\n343:   let newest = 0;\n344:   let truncated = false;\n345:   for (const entry of skillRoots) {\n346:     const metadataPath = join(skillRoot, entry.name, 'graph-metadata.json');\n347:     if (!existsSync(metadataPath)) continue;\n348:     const metadataStat = statSync(metadataPath);\n349:     if (!metadataStat.isFile()) continue;\n350:     if (count >= maxFiles) {\n351:       truncated = true;\n352:       break;\n353:     }\n354:     count++;\n355:     newest = Math.max(newest, metadataStat.mtimeMs);\n356:   }\n357:   return { count, maxMtimeMs: newest, truncated };\n358: }\n359: \n360: // The status reader stays synchronous so the recommend path can call it, which\n361: // puts the only network probe here on the async command path. Reading /api/tags\n362: // is the only signal that separates a stopped server or a missing model from a\n363: // healthy lane: the pointer and the vectors survive both, so a lane that\n364: // reports enabled through an outage sends operators to rebuild a fine index\n365: // instead of starting the server.\n366: async function probeSemanticLaneBackend(health: SemanticLaneHealth): Promise<SemanticLaneHealth> {\n367:   const activeName = health.activeEmbedder?.name;\n368:   const manifest = activeName ? getManifest(activeName) : undefined;\n369:   if (!manifest) {\n370:     return health;\n371:   }\n372:   if (manifest.backend !== 'ollama') {\n373:     return {\n374:       ...health,\n375:       backend: { state: 'probe_not_implemented', reason: `no readiness probe for the ${manifest.backend} backend` },\n376:       laneEnabled: false,\n377:     };\n378:   }\n379:   const probe = await probeOllamaModel(\n380:     resolveOllamaBaseUrl(),\n381:     manifest.ollamaName ?? manifest.name,\n382:     500,\n383:   );\n384:   if (probe.available) {\n385:     return { ...health, backend: { state: 'reachable', reason: null } };\n386:   }\n387:   const reason = probe.reason ?? null;\n388:   return {\n389:     ...health,\n390:     backend: {\n391:       state: reason && /not loaded/i.test(reason) ? 'model_missing' : 'unreachable',\n392:       reason,\n393:     },\n394:     laneEnabled: false,\n395:   };\n396: }\n397: \n398: // ───────────────────────────────────────────────────────────────────\n399: // 4. CORE LOGIC\n400: // ───────────────────────────────────────────────────────────────────\n401: \n402: /** Read advisor freshness state.\n403:  *\n404:  * Diagnostic-only: this function reports stale, absent, or unavailable advisor\n405:  * state and does not rebuild it. Use `advisor_rebuild` to repair stale state.\n406:  */\n407: export function readAdvisorStatus(input: AdvisorStatusInput): AdvisorStatusOutput {\n408:   const args = AdvisorStatusInputSchema.parse(input);\n409:   const workspaceRoot = resolve(args.workspaceRoot);\n410:   const dbPath = resolveSkillGraphDbPath(workspaceRoot);\n411:   const skillRoot = join(workspaceRoot, SKILL_ROOT);\n412:   const errors: string[] = [];\n413: \n414:   try {\n415:     const generation = readSkillGraphGeneration(workspaceRoot);\n416:     const hasSources = existsSync(skillRoot);\n417:     const hasArtifact = existsSync(dbPath);\n418:     // Existence alone lets a corrupt-on-disk artifact report 'live' from the\n419:     // generation counters, which makes advisor_rebuild skip the repair it\n420:     // exists to perform. A read-only quick_check turns genuine corruption\n421:     // into a stale signal so rebuild runs. Transient lock/IO failures are\n422:     // excluded so contention never forces a spurious rebuild.\n423:     const integrity = (hasArtifact && args.checkArtifactIntegrity === true)\n424:       ? checkSqliteIntegrityCached(dbPath, generation.generation, fileMtimeMs(dbPath))\n425:       : null;\n426:     const artifactCorrupt = Boolean(\n427:       integrity && !integrity.ok\n428:         && integrity.reason !== 'SQLITE_ABSENT'\n429:         && isGenuineCorruptionReason(integrity.reason),\n430:     );\n431:     if (artifactCorrupt && integrity && !integrity.ok) {\n432:       errors.push(`advisor_status skill graph integrity check failed (${integrity.reason}); run advisor_rebuild`);\n433:     }\n434:     const sourceScan = scanSkillMetadataFiles(skillRoot, args.maxMetadataFiles ?? DEFAULT_MAX_METADATA_FILES);\n435:     if (sourceScan.truncated) {\n436:       errors.push(`advisor_status metadata scan capped at ${sourceScan.count} files`);\n437:     }\n438:     const indexStaleness = readIndexStaleness(dbPath, workspaceRoot);\n439:     if (indexStaleness.state === 'stale') {\n440:       const staleSkillCount = indexStaleness.changedSourceFiles + indexStaleness.missingSourceFiles;\n441:       errors.push(\n442:         `advisor_status index content hashes differ from disk for ${staleSkillCount} skill${staleSkillCount === 1 ? '' : 's'}; run advisor_rebuild`,\n443:       );\n444:     }\n445:     const sourceChanged = generation.state === 'stale'\n446:       || indexStaleness.state === 'stale'\n447:       || (\n448:         generation.sourceSignature\n449:           ? computeAdvisorSourceSignature(workspaceRoot) !== generation.sourceSignature\n450:           : hasArtifact && hasSources && sourceScan.maxMtimeMs > fileMtimeMs(dbPath)\n451:       );\n452:     const daemonPid = parseDaemonPid();\n453:     const daemonAvailable = daemonPid === undefined ? true : hasRunningDaemon(daemonPid);\n454:     // Only flag a daemon-evidence divergence when a PID file exists but the\n455:     // process is gone. Missing PID file = daemon never started, not a\n456:     // divergence between freshness artifacts and live process evidence.\n457:     if (daemonPid !== undefined && !daemonAvailable && generation.state !== 'unavailable') {\n458:       errors.push('advisor_status found freshness artifacts, but no live daemon PID/process evidence');\n459:     }\n460:     const state = isFreshness(generation.state) ? generation.state : 'unavailable';\n461:     // Data is stale when sources are physically newer than the\n462:     // artifact, regardless of stored sourceSignature semantics. This is the\n463:     // stronger physical-evidence signal vs. signature mismatch which can\n464:     // arise from benign workspace differences.\n465:     const sourcesNewerThanArtifact = hasArtifact && hasSources\n466:       && sourceScan.maxMtimeMs > fileMtimeMs(dbPath);\n467:     const trustState = createTrustState({\n468:       hasSources,\n469:       hasArtifact,\n470:       sourceChanged,\n471:       daemonAvailable,\n472:       generation: generation.generation,\n473:       reason: generation.reason,\n474:       lastLiveAt: state === 'live' ? generation.updatedAt : null,\n475:     });\n476:     // `freshness` describes data/artifact state (live/stale/absent/\n477:     // unavailable from the generation file), while `trustState.state` is the\n478:     // daemon-gated caller-trust axis. Keep them decoupled so callers reading\n479:     // `freshness` see artifact health independent of daemon availability.\n480:     // When physical evidence shows sources are newer than the DB, downgrade\n481:     // a 'live' generation to 'stale' regardless of signature noise.\n482:     const freshnessOutput: AdvisorFreshness = state === 'live'\n483:       && (sourceChanged || artifactCorrupt || (!generation.sourceSignature && sourcesNewerThanArtifact))\n484:       ? 'stale'\n485:       : state;\n486:     const output: AdvisorStatusOutput = {\n487:       freshness: freshnessOutput,\n488:       generation: generation.generation,\n489:       trustState,\n490:       lastGenerationBump: generation.updatedAt === new Date(0).toISOString() ? null : generation.updatedAt,\n491:       lastScanAt: generation.updatedAt === new Date(0).toISOString() ? null : generation.updatedAt,\n492:       skillCount: sourceScan.count,\n493:       indexStaleness,\n494:       laneWeights: DEFAULT_SCORER_WEIGHTS,\n495:       ...((args.includeSemanticHealth || args.debug) ? { semanticLaneHealth: readSemanticLaneHealth(dbPath) } : {}),\n496:       ...(daemonPid ? { daemonPid } : {}),\n497:       ...(errors.length > 0 ? { errors } : {}),\n498:     };\n499:     return AdvisorStatusOutputSchema.parse(output);\n500:   } catch (error: unknown) {\n501:     const message = redactDiagnosticText(errorMessage(error));\n502:     const sourceScan = scanSkillMetadataFiles(skillRoot, args.maxMetadataFiles ?? DEFAULT_MAX_METADATA_FILES);\n503:     const trustState = createTrustState({\n504:       hasSources: existsSync(skillRoot),\n505:       hasArtifact: existsSync(dbPath),\n506:       sourceChanged: false,\n507:       daemonAvailable: false,\n508:       generation: 0,\n509:       reason: 'ADVISOR_STATUS_UNAVAILABLE',\n510:     });\n511:     const output: AdvisorStatusOutput = {\n512:       freshness: 'unavailable',\n513:       generation: 0,\n514:       trustState,\n515:       lastGenerationBump: null,\n516:       lastScanAt: null,\n517:       skillCount: sourceScan.count,\n518:       laneWeights: DEFAULT_SCORER_WEIGHTS,\n519:       ...((args.includeSemanticHealth || args.debug) ? { semanticLaneHealth: readSemanticLaneHealth(dbPath) } : {}),\n520:       errors: [message],\n521:     };\n522:     return AdvisorStatusOutputSchema.parse(output);\n523:   }\n524: }\n525: \n526: // ───────────────────────────────────────────────────────────────────\n527: // 5. EXPORTS\n528: // ───────────────────────────────────────────────────────────────────\n529: \n530: /** Handle the advisor_status command request. */\n531: export async function handleAdvisorStatus(args: unknown): Promise<HandlerResponse> {\n532:   // The diagnostic surface opts into the artifact integrity probe by default\n533:   // so operators see on-disk corruption; explicit input can still override it.\n534:   const parsed = AdvisorStatusInputSchema.parse(args);\n535:   const status = readAdvisorStatus({ ...parsed, checkArtifactIntegrity: parsed.checkArtifactIntegrity ?? true });\n536:   const withBackend = parsed.includeSemanticHealth === true && status.semanticLaneHealth\n537:     ? { ...status, semanticLaneHealth: await probeSemanticLaneBackend(status.semanticLaneHealth) }\n538:     : status;\n539:   // Keep the bounded probe on this async command path, away from the synchronous recommend reader.\n540:   const data = parsed.includeEmbeddingsHealth === true\n541:     ? AdvisorStatusOutputSchema.parse({ ...withBackend, embeddingsHealth: await readEmbeddingsHealth() })\n542:     : withBackend;\n543:   return {\n544:     content: [{\n545:       type: 'text',\n546:       text: JSON.stringify({ status: 'ok', data }, null, 2),\n547:     }],\n548:   };\n549: }","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/handlers/advisor-status.ts, lines 1-549\n1: // ───────────────────────────────────────────────────────────────\n2: // MODULE: advisor_status Handler\n3: // ───────────────────────────────────────────────────────────────\n4: \n5: // ───────────────────────────────────────────────────────────────────\n6: // 1. IMPORTS\n7: // ───────────────────────────────────────────────────────────────────\n8: \n9: import { existsSync, readFileSync, readdirSync, statSync } from 'node:fs';\n10: import { join, resolve } from 'node:path';\n11: import Database from 'better-sqlite3';\n12: \n13: import { computeAdvisorSourceSignature } from '../lib/freshness.js';\n14: import { readSkillGraphGeneration } from '../lib/freshness/generation.js';\n15: import { checkSqliteIntegrity } from '../lib/freshness/sqlite-integrity.js';\n16: import { createPrivateSkillLinkCheck } from '../lib/private-skill-target.js';\n17: import {\n18:   computeSkillMetadataContentHash,\n19:   isGenuineCorruptionReason,\n20:   readCommandEmbeddingSources,\n21:   resolveSkillGraphDbDir,\n22:   DB_FILENAME,\n23: } from '../lib/skill-graph/skill-graph-db.js';\n24: import { createTrustState } from '../lib/freshness/trust-state.js';\n25: import { getAdapter, getManifest } from '../lib/embedders/registry.js';\n26: import { probeOllamaModel, resolveOllamaBaseUrl } from '../lib/embedders/adapters/ollama.js';\n27: import { commandVecTableNameForDim } from '../lib/embedders/schema.js';\n28: import { readEmbeddingsHealth } from '../lib/embedders/embeddings-health.js';\n29: import { getSemanticShadowRuntimeHealth } from '../lib/scorer/lanes/semantic-shadow.js';\n30: import { readAdvisorEmbeddingStaleness } from '../lib/scorer/projection.js';\n31: import { DEFAULT_SCORER_WEIGHTS } from '../lib/scorer/weights-config.js';\n32: import { errorMessage } from '../lib/utils/error-format.js';\n33: import { redactDiagnosticText } from './skill-graph/response-envelope.js';\n34: import {\n35:   AdvisorStatusInputSchema,\n36:   AdvisorStatusOutputSchema,\n37: } from '../schemas/advisor-tool-schemas.js';\n38: \n39: import type {\n40:   AdvisorFreshness,\n41:   AdvisorStatusInput,\n42:   AdvisorStatusOutput,\n43: } from '../schemas/advisor-tool-schemas.js';\n44: \n45: // ───────────────────────────────────────────────────────────────────\n46: // 2. TYPE DEFINITIONS AND CONSTANTS\n47: // ───────────────────────────────────────────────────────────────────\n48: \n49: type HandlerResponse = { content: Array<{ type: string; text: string }> };\n50: type IndexStaleness = NonNullable<AdvisorStatusOutput['indexStaleness']>;\n51: \n52: const SKILL_ROOT = join('.skilled', 'skills');\n53: const DEFAULT_MAX_METADATA_FILES = 5_000;\n54: type SemanticLaneHealth = NonNullable<AdvisorStatusOutput['semanticLaneHealth']>;\n55: \n56: // ───────────────────────────────────────────────────────────────────\n57: // 3. HELPERS\n58: // ───────────────────────────────────────────────────────────────────\n59: \n60: function isFreshness(value: string): value is AdvisorFreshness {\n61:   return value === 'live' || value === 'stale' || value === 'absent' || value === 'unavailable';\n62: }\n63: \n64: function parseDaemonPid(): number | undefined {\n65:   const raw = process.env.SPECKIT_SKILL_GRAPH_DAEMON_PID;\n66:   if (!raw) return undefined;\n67:   const parsed = Number(raw);\n68:   return Number.isSafeInteger(parsed) && parsed > 0 ? parsed : undefined;\n69: }\n70: \n71: function hasRunningDaemon(pid: number | undefined): boolean {\n72:   if (!pid) {\n73:     return false;\n74:   }\n75:   try {\n76:     process.kill(pid, 0);\n77:     return true;\n78:   } catch {\n79:     return false;\n80:   }\n81: }\n82: \n83: function fileMtimeMs(path: string): number {\n84:   if (!existsSync(path)) return 0;\n85:   const stat = statSync(path);\n86:   return stat.mtimeMs;\n87: }\n88: \n89: function resolveSkillGraphDbPath(workspaceRoot: string): string {\n90:   // Resolve through the writer's own resolver so the integrity probe always\n91:   // targets the exact file the daemon writes. An env override wins for both;\n92:   // otherwise the workspace root stands in for the writer's cwd, which match\n93:   // in the normal single-root deployment.\n94:   return join(resolveSkillGraphDbDir(workspaceRoot), DB_FILENAME);\n95: }\n96: \n97: // Per-(dbPath, generation, mtime) integrity verdict cache. A full quick_check\n98: // scans the artifact, which is too costly to run on the recommend hot path;\n99: // caching it lets recommend opt into corruption detection while paying the\n100: // scan at most once per generation. The only events that can change on-disk\n101: // integrity — a generation bump or an mtime change — invalidate the entry.\n102: const integrityVerdictCache = new Map<string, { ok: true } | { ok: false; reason: string }>();\n103: \n104: function checkSqliteIntegrityCached(\n105:   dbPath: string,\n106:   generation: number,\n107:   mtimeMs: number,\n108: ): { ok: true } | { ok: false; reason: string } {\n109:   const key = `${dbPath}::${generation}::${mtimeMs}`;\n110:   const cached = integrityVerdictCache.get(key);\n111:   if (cached) {\n112:     return cached;\n113:   }\n114:   const result = checkSqliteIntegrity(dbPath);\n115:   // Only the newest (path, generation, mtime) verdict is ever consulted, so a\n116:   // single-entry cache is sufficient and self-bounding.\n117:   integrityVerdictCache.clear();\n118:   integrityVerdictCache.set(key, result);\n119:   return result;\n120: }\n121: \n122: function tableExists(database: Database.Database, tableName: string): boolean {\n123:   const row = database.prepare(`\n124:     SELECT 1 AS present\n125:     FROM sqlite_master\n126:     WHERE type = 'table' AND name = ?\n127:     LIMIT 1\n128:   `).get(tableName) as { present: number } | undefined;\n129:   return Boolean(row);\n130: }\n131: \n132: function metadataValue(database: Database.Database, key: string): string | null {\n133:   if (!tableExists(database, 'vec_metadata')) return null;\n134:   const row = database.prepare('SELECT value FROM vec_metadata WHERE key = ?').get(key) as { value: string } | undefined;\n135:   return row?.value ?? null;\n136: }\n137: \n138: function countRows(database: Database.Database, sql: string): number {\n139:   const row = database.prepare(sql).get() as { c: number } | undefined;\n140:   return row?.c ?? 0;\n141: }\n142: \n143: function maxUpdatedAt(database: Database.Database, tableName: string): string | null {\n144:   const row = database.prepare(`SELECT MAX(updated_at) AS updatedAt FROM ${tableName}`).get() as { updatedAt: string | null } | undefined;\n145:   return row?.updatedAt ?? null;\n146: }\n147: \n148: function baseSemanticLaneHealth(disabledReason: string | null): SemanticLaneHealth {\n149:   return {\n150:     activeEmbedder: null,\n151:     vectorCoverage: { embedded: 0, total: 0, ratio: 0 },\n152:     dimMismatch: false,\n153:     lastRefresh: null,\n154:     disabledReason,\n155:     laneEnabled: false,\n156:     checkedAt: new Date().toISOString(),\n157:   };\n158: }\n159: \n160: function readSemanticLaneHealth(dbPath: string): SemanticLaneHealth {\n161:   const runtime = getSemanticShadowRuntimeHealth();\n162:   // The command projection's size does not depend on the database, so the\n163:   // denominator is known even when the artifact is missing or unreadable.\n164:   const commandTotal = readCommandEmbeddingSources()?.length ?? 0;\n165:   if (!existsSync(dbPath)) {\n166:     return {\n167:       ...baseSemanticLaneHealth(runtime.disabledReason ?? 'database_absent'),\n168:       commandVectorCoverage: { embedded: 0, total: commandTotal },\n169:     };\n170:   }\n171: \n172:   let database: Database.Database | null = null;\n173:   try {\n174:     database = new Database(dbPath, { readonly: true, fileMustExist: true });\n175:     const total = tableExists(database, 'skill_nodes')\n176:       ? countRows(database, 'SELECT COUNT(*) AS c FROM skill_nodes')\n177:       : 0;\n178:     const activeName = metadataValue(database, 'active_embedder_name');\n179:     const activeDimRaw = metadataValue(database, 'active_embedder_dim');\n180:     const activeDim = activeDimRaw ? Number.parseInt(activeDimRaw, 10) : 0;\n181:     const hasActive = Boolean(activeName) && Number.isInteger(activeDim) && activeDim > 0;\n182:     const adapter = activeName ? getAdapter(activeName) : undefined;\n183:     const activeEmbedder = activeName\n184:       ? { name: activeName, dim: Number.isInteger(activeDim) && activeDim > 0 ? activeDim : 0, adapterDim: adapter?.dim ?? null }\n185:       : null;\n186:     const tableName = hasActive ? `vec_${activeDim}` : null;\n187:     const hasVecTable = tableName ? tableExists(database, tableName) : false;\n188:     const embedded = hasVecTable\n189:       ? countRows(database, `SELECT COUNT(*) AS c FROM ${tableName} WHERE embedding IS NOT NULL`)\n190:       : (tableExists(database, 'skill_nodes') ? countRows(database, 'SELECT COUNT(*) AS c FROM skill_nodes WHERE embedding IS NOT NULL') : 0);\n191:     const lastRefresh = hasVecTable && tableName ? maxUpdatedAt(database, tableName) : null;\n192:     const commandTable = hasActive ? commandVecTableNameForDim(activeDim) : null;\n193:     const commandEmbedded = commandTable && tableExists(database, commandTable)\n194:       ? countRows(database, `SELECT COUNT(*) AS c FROM ${commandTable}`)\n195:       : 0;\n196:     const dimMismatch = Boolean(activeEmbedder && activeEmbedder.adapterDim !== null && activeEmbedder.dim !== activeEmbedder.adapterDim);\n197:     const staleness = readAdvisorEmbeddingStaleness(database);\n198:     const disabledReason = dimMismatch\n199:       ? 'dim_mismatch'\n200:       : (staleness.stale\n201:           ? 'projection_embedding_stale'\n202:           : (!hasActive\n203:               ? 'active_embedder_unset'\n204:               : (!adapter\n205:                   ? 'adapter_unavailable'\n206:                   : (!hasVecTable\n207:                       ? 'vector_table_missing'\n208:                       : (total > 0 && embedded === 0 ? 'no_skill_vectors' : runtime.disabledReason)))));\n209:     return {\n210:       activeEmbedder,\n211:       vectorCoverage: {\n212:         embedded,\n213:         total,\n214:         ratio: total > 0 ? Math.round((embedded / total) * 1_000_000) / 1_000_000 : 0,\n215:       },\n216:       commandVectorCoverage: { embedded: commandEmbedded, total: commandTotal },\n217:       dimMismatch,\n218:       lastRefresh,\n219:       disabledReason,\n220:       laneEnabled: Boolean(hasActive && adapter && !dimMismatch && !staleness.stale && hasVecTable && embedded > 0 && !disabledReason),\n221:       checkedAt: new Date().toISOString(),\n222:     };\n223:   } catch {\n224:     return {\n225:       ...baseSemanticLaneHealth(runtime.disabledReason ?? 'health_unavailable'),\n226:       commandVectorCoverage: { embedded: 0, total: commandTotal },\n227:     };\n228:   } finally {\n229:     database?.close();\n230:   }\n231: }\n232: \n233: function readIndexStaleness(dbPath: string, workspaceRoot: string): IndexStaleness {\n234:   const unavailable = (reason: string): IndexStaleness => ({\n235:     state: 'unavailable',\n236:     reason,\n237:     trackedSkills: 0,\n238:     freshSourceFiles: 0,\n239:     changedSourceFiles: 0,\n240:     missingSourceFiles: 0,\n241:     staleSkillIds: [],\n242:   });\n243:   if (!existsSync(dbPath)) return unavailable('database_absent');\n244: \n245:   let database: Database.Database | null = null;\n246:   let result = unavailable('index_read_failed');\n247:   try {\n248:     database = new Database(dbPath, { readonly: true, fileMustExist: true });\n249:     if (!tableExists(database, 'skill_nodes')) {\n250:       result = unavailable('index_rows_absent');\n251:     } else {\n252:       const columns = database.pragma('table_info(skill_nodes)') as Array<{ name: string }>;\n253:       const hasSourceColumns = columns.some((column) => column.name === 'source_path')\n254:         && columns.some((column) => column.name === 'content_hash');\n255:       if (!hasSourceColumns) {\n256:         result = unavailable('index_rows_absent');\n257:       } else {\n258:         const rows = database.prepare(`\n259:           SELECT id, source_path, content_hash\n260:           FROM skill_nodes\n261:           ORDER BY id\n262:         `).all() as Array<{\n263:           id: string;\n264:           source_path: string | null;\n265:           content_hash: string | null;\n266:         }>;\n267:         if (rows.length === 0) {\n268:           result = unavailable('index_rows_absent');\n269:         } else {\n270:           let freshSourceFiles = 0;\n271:           let changedSourceFiles = 0;\n272:           let missingSourceFiles = 0;\n273:           const staleSkillIds: string[] = [];\n274: \n275:           for (const row of rows) {\n276:             if (!row.source_path || row.source_path.trim().length === 0) {\n277:               missingSourceFiles++;\n278:               staleSkillIds.push(row.id);\n279:               continue;\n280:             }\n281: \n282:             let content: string;\n283:             try {\n284:               content = readFileSync(resolve(workspaceRoot, row.source_path), 'utf8');\n285:             } catch (error: unknown) {\n286:               if (error instanceof Error && 'code' in error && error.code === 'ENOENT') {\n287:                 missingSourceFiles++;\n288:                 staleSkillIds.push(row.id);\n289:                 continue;\n290:               }\n291:               throw error;\n292:             }\n293: \n294:             if (row.content_hash === null\n295:               || computeSkillMetadataContentHash(content) !== row.content_hash) {\n296:               changedSourceFiles++;\n297:               staleSkillIds.push(row.id);\n298:               continue;\n299:             }\n300: \n301:             freshSourceFiles++;\n302:           }\n303: \n304:           const stale = changedSourceFiles + missingSourceFiles > 0;\n305:           result = {\n306:             state: stale ? 'stale' : 'fresh',\n307:             reason: stale ? 'source_hash_mismatch' : null,\n308:             trackedSkills: rows.length,\n309:             freshSourceFiles,\n310:             changedSourceFiles,\n311:             missingSourceFiles,\n312:             staleSkillIds: staleSkillIds.slice(0, 25),\n313:           };\n314:         }\n315:       }\n316:     }\n317:   } catch {\n318:     result = unavailable('index_read_failed');\n319:   } finally {\n320:     try {\n321:       database?.close();\n322:     } catch {\n323:       result = unavailable('index_read_failed');\n324:     }\n325:   }\n326: \n327:   return result;\n328: }\n329: \n330: function scanSkillMetadataFiles(\n331:   skillRoot: string,\n332:   maxFiles = DEFAULT_MAX_METADATA_FILES,\n333: ): { count: number; maxMtimeMs: number; truncated: boolean } {\n334:   if (!existsSync(skillRoot)) return { count: 0, maxMtimeMs: 0, truncated: false };\n335:   const isTrustedLink = createPrivateSkillLinkCheck(skillRoot);\n336:   const skillRoots = readdirSync(skillRoot, { withFileTypes: true })\n337:     .filter((entry) => !entry.name.startsWith('.') && (entry.isDirectory()\n338:       || (entry.name.startsWith('local-')\n339:         && entry.isSymbolicLink()\n340:         && isTrustedLink(join(skillRoot, entry.name)))))\n341:     .sort((left, right) => left.name.localeCompare(right.name));\n342:   let count = 0;\n343:   let newest = 0;\n344:   let truncated = false;\n345:   for (const entry of skillRoots) {\n346:     const metadataPath = join(skillRoot, entry.name, 'graph-metadata.json');\n347:     if (!existsSync(metadataPath)) continue;\n348:     const metadataStat = statSync(metadataPath);\n349:     if (!metadataStat.isFile()) continue;\n350:     if (count >= maxFiles) {\n351:       truncated = true;\n352:       break;\n353:     }\n354:     count++;\n355:     newest = Math.max(newest, metadataStat.mtimeMs);\n356:   }\n357:   return { count, maxMtimeMs: newest, truncated };\n358: }\n359: \n360: // The status reader stays synchronous so the recommend path can call it, which\n361: // puts the only network probe here on the async command path. Reading /api/tags\n362: // is the only signal that separates a stopped server or a missing model from a\n363: // healthy lane: the pointer and the vectors survive both, so a lane that\n364: // reports enabled through an outage sends operators to rebuild a fine index\n365: // instead of starting the server.\n366: async function probeSemanticLaneBackend(health: SemanticLaneHealth): Promise<SemanticLaneHealth> {\n367:   const activeName = health.activeEmbedder?.name;\n368:   const manifest = activeName ? getManifest(activeName) : undefined;\n369:   if (!manifest) {\n370:     return health;\n371:   }\n372:   if (manifest.backend !== 'ollama') {\n373:     return {\n374:       ...health,\n375:       backend: { state: 'probe_not_implemented', reason: `no readiness probe for the ${manifest.backend} backend` },\n376:       laneEnabled: false,\n377:     };\n378:   }\n379:   const probe = await probeOllamaModel(\n380:     resolveOllamaBaseUrl(),\n381:     manifest.ollamaName ?? manifest.name,\n382:     500,\n383:   );\n384:   if (probe.available) {\n385:     return { ...health, backend: { state: 'reachable', reason: null } };\n386:   }\n387:   const reason = probe.reason ?? null;\n388:   return {\n389:     ...health,\n390:     backend: {\n391:       state: reason && /not loaded/i.test(reason) ? 'model_missing' : 'unreachable',\n392:       reason,\n393:     },\n394:     laneEnabled: false,\n395:   };\n396: }\n397: \n398: // ───────────────────────────────────────────────────────────────────\n399: // 4. CORE LOGIC\n400: // ───────────────────────────────────────────────────────────────────\n401: \n402: /** Read advisor freshness state.\n403:  *\n404:  * Diagnostic-only: this function reports stale, absent, or unavailable advisor\n405:  * state and does not rebuild it. Use `advisor_rebuild` to repair stale state.\n406:  */\n407: export function readAdvisorStatus(input: AdvisorStatusInput): AdvisorStatusOutput {\n408:   const args = AdvisorStatusInputSchema.parse(input);\n409:   const workspaceRoot = resolve(args.workspaceRoot);\n410:   const dbPath = resolveSkillGraphDbPath(workspaceRoot);\n411:   const skillRoot = join(workspaceRoot, SKILL_ROOT);\n412:   const errors: string[] = [];\n413: \n414:   try {\n415:     const generation = readSkillGraphGeneration(workspaceRoot);\n416:     const hasSources = existsSync(skillRoot);\n417:     const hasArtifact = existsSync(dbPath);\n418:     // Existence alone lets a corrupt-on-disk artifact report 'live' from the\n419:     // generation counters, which makes advisor_rebuild skip the repair it\n420:     // exists to perform. A read-only quick_check turns genuine corruption\n421:     // into a stale signal so rebuild runs. Transient lock/IO failures are\n422:     // excluded so contention never forces a spurious rebuild.\n423:     const integrity = (hasArtifact && args.checkArtifactIntegrity === true)\n424:       ? checkSqliteIntegrityCached(dbPath, generation.generation, fileMtimeMs(dbPath))\n425:       : null;\n426:     const artifactCorrupt = Boolean(\n427:       integrity && !integrity.ok\n428:         && integrity.reason !== 'SQLITE_ABSENT'\n429:         && isGenuineCorruptionReason(integrity.reason),\n430:     );\n431:     if (artifactCorrupt && integrity && !integrity.ok) {\n432:       errors.push(`advisor_status skill graph integrity check failed (${integrity.reason}); run advisor_rebuild`);\n433:     }\n434:     const sourceScan = scanSkillMetadataFiles(skillRoot, args.maxMetadataFiles ?? DEFAULT_MAX_METADATA_FILES);\n435:     if (sourceScan.truncated) {\n436:       errors.push(`advisor_status metadata scan capped at ${sourceScan.count} files`);\n437:     }\n438:     const indexStaleness = readIndexStaleness(dbPath, workspaceRoot);\n439:     if (indexStaleness.state === 'stale') {\n440:       const staleSkillCount = indexStaleness.changedSourceFiles + indexStaleness.missingSourceFiles;\n441:       errors.push(\n442:         `advisor_status index content hashes differ from disk for ${staleSkillCount} skill${staleSkillCount === 1 ? '' : 's'}; run advisor_rebuild`,\n443:       );\n444:     }\n445:     const sourceChanged = generation.state === 'stale'\n446:       || indexStaleness.state === 'stale'\n447:       || (\n448:         generation.sourceSignature\n449:           ? computeAdvisorSourceSignature(workspaceRoot) !== generation.sourceSignature\n450:           : hasArtifact && hasSources && sourceScan.maxMtimeMs > fileMtimeMs(dbPath)\n451:       );\n452:     const daemonPid = parseDaemonPid();\n453:     const daemonAvailable = daemonPid === undefined ? true : hasRunningDaemon(daemonPid);\n454:     // Only flag a daemon-evidence divergence when a PID file exists but the\n455:     // process is gone. Missing PID file = daemon never started, not a\n456:     // divergence between freshness artifacts and live process evidence.\n457:     if (daemonPid !== undefined && !daemonAvailable && generation.state !== 'unavailable') {\n458:       errors.push('advisor_status found freshness artifacts, but no live daemon PID/process evidence');\n459:     }\n460:     const state = isFreshness(generation.state) ? generation.state : 'unavailable';\n461:     // Data is stale when sources are physically newer than the\n462:     // artifact, regardless of stored sourceSignature semantics. This is the\n463:     // stronger physical-evidence signal vs. signature mismatch which can\n464:     // arise from benign workspace differences.\n465:     const sourcesNewerThanArtifact = hasArtifact && hasSources\n466:       && sourceScan.maxMtimeMs > fileMtimeMs(dbPath);\n467:     const trustState = createTrustState({\n468:       hasSources,\n469:       hasArtifact,\n470:       sourceChanged,\n471:       daemonAvailable,\n472:       generation: generation.generation,\n473:       reason: generation.reason,\n474:       lastLiveAt: state === 'live' ? generation.updatedAt : null,\n475:     });\n476:     // `freshness` describes data/artifact state (live/stale/absent/\n477:     // unavailable from the generation file), while `trustState.state` is the\n478:     // daemon-gated caller-trust axis. Keep them decoupled so callers reading\n479:     // `freshness` see artifact health independent of daemon availability.\n480:     // When physical evidence shows sources are newer than the DB, downgrade\n481:     // a 'live' generation to 'stale' regardless of signature noise.\n482:     const freshnessOutput: AdvisorFreshness = state === 'live'\n483:       && (sourceChanged || artifactCorrupt || (!generation.sourceSignature && sourcesNewerThanArtifact))\n484:       ? 'stale'\n485:       : state;\n486:     const output: AdvisorStatusOutput = {\n487:       freshness: freshnessOutput,\n488:       generation: generation.generation,\n489:       trustState,\n490:       lastGenerationBump: generation.updatedAt === new Date(0).toISOString() ? null : generation.updatedAt,\n491:       lastScanAt: generation.updatedAt === new Date(0).toISOString() ? null : generation.updatedAt,\n492:       skillCount: sourceScan.count,\n493:       indexStaleness,\n494:       laneWeights: DEFAULT_SCORER_WEIGHTS,\n495:       ...((args.includeSemanticHealth || args.debug) ? { semanticLaneHealth: readSemanticLaneHealth(dbPath) } : {}),\n496:       ...(daemonPid ? { daemonPid } : {}),\n497:       ...(errors.length > 0 ? { errors } : {}),\n498:     };\n499:     return AdvisorStatusOutputSchema.parse(output);\n500:   } catch (error: unknown) {\n501:     const message = redactDiagnosticText(errorMessage(error));\n502:     const sourceScan = scanSkillMetadataFiles(skillRoot, args.maxMetadataFiles ?? DEFAULT_MAX_METADATA_FILES);\n503:     const trustState = createTrustState({\n504:       hasSources: existsSync(skillRoot),\n505:       hasArtifact: existsSync(dbPath),\n506:       sourceChanged: false,\n507:       daemonAvailable: false,\n508:       generation: 0,\n509:       reason: 'ADVISOR_STATUS_UNAVAILABLE',\n510:     });\n511:     const output: AdvisorStatusOutput = {\n512:       freshness: 'unavailable',\n513:       generation: 0,\n514:       trustState,\n515:       lastGenerationBump: null,\n516:       lastScanAt: null,\n517:       skillCount: sourceScan.count,\n518:       laneWeights: DEFAULT_SCORER_WEIGHTS,\n519:       ...((args.includeSemanticHealth || args.debug) ? { semanticLaneHealth: readSemanticLaneHealth(dbPath) } : {}),\n520:       errors: [message],\n521:     };\n522:     return AdvisorStatusOutputSchema.parse(output);\n523:   }\n524: }\n525: \n526: // ───────────────────────────────────────────────────────────────────\n527: // 5. EXPORTS\n528: // ───────────────────────────────────────────────────────────────────\n529: \n530: /** Handle the advisor_status command request. */\n531: export async function handleAdvisorStatus(args: unknown): Promise<HandlerResponse> {\n532:   // The diagnostic surface opts into the artifact integrity probe by default\n533:   // so operators see on-disk corruption; explicit input can still override it.\n534:   const parsed = AdvisorStatusInputSchema.parse(args);\n535:   const status = readAdvisorStatus({ ...parsed, checkArtifactIntegrity: parsed.checkArtifactIntegrity ?? true });\n536:   const withBackend = parsed.includeSemanticHealth === true && status.semanticLaneHealth\n537:     ? { ...status, semanticLaneHealth: await probeSemanticLaneBackend(status.semanticLaneHealth) }\n538:     : status;\n539:   // Keep the bounded probe on this async command path, away from the synchronous recommend reader.\n540:   const data = parsed.includeEmbeddingsHealth === true\n541:     ? AdvisorStatusOutputSchema.parse({ ...withBackend, embeddingsHealth: await readEmbeddingsHealth() })\n542:     : withBackend;\n543:   return {\n544:     content: [{\n545:       type: 'text',\n546:       text: JSON.stringify({ status: 'ok', data }, null, 2),\n547:     }],\n548:   };\n549: }"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/handlers/advisor-status.ts\"}"},"time":{"start":1794540042015,"end":1794540042926}}}}
{"type":"tool_use","timestamp":1794540042930,"sessionID":"ses_e2d148875ffeU9dgsF1CpQl6Z6","part":{"partID":"prt_1d2ebf8f5001tPjSwqT51CV3V9","sessionID":"ses_e2d148875ffeU9dgsF1CpQl6Z6","messageID":"msg_1d2ebd581001W0Ll8VrS8TvGsa","type":"tool","id":"call_460db41d6050480a85e896b0","tool":"read","state":{"status":"completed","input":{"path":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/lib/metrics.ts"},"output":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/lib/metrics.ts, lines 1-834\n1: // ───────────────────────────────────────────────────────────────\n2: // MODULE: Advisor Hook Metrics Contract\n3: // ───────────────────────────────────────────────────────────────\n4: \n5: import { createHash } from 'node:crypto';\n6: import { existsSync, readFileSync } from 'node:fs';\n7: import { appendFile, chmod, mkdir, rename, unlink, writeFile } from 'node:fs/promises';\n8: import { tmpdir } from 'node:os';\n9: import { dirname, join, resolve } from 'node:path';\n10: \n11: import { ADVISOR_RUNTIME_VALUES } from './advisor-runtime-values.js';\n12: \n13: import type {\n14:   AdvisorHookFreshness,\n15:   AdvisorHookStatus,\n16:   AdvisorRuntime,\n17: } from './skill-advisor-brief.js';\n18: \n19: // ───────────────────────────────────────────────────────────────\n20: // 1. TYPES\n21: // ───────────────────────────────────────────────────────────────\n22: \n23: export { ADVISOR_RUNTIME_VALUES } from './advisor-runtime-values.js';\n24: export const ADVISOR_HOOK_STATUS_VALUES = ['ok', 'skipped', 'stale', 'degraded', 'fail_open'] as const;\n25: export const ADVISOR_HOOK_FRESHNESS_VALUES = ['live', 'stale', 'absent', 'unavailable'] as const;\n26: export const ADVISOR_ERROR_CODE_VALUES = [\n27:   'TIMEOUT',\n28:   'SCRIPT_MISSING',\n29:   'SQLITE_BUSY',\n30:   'PARSE_FAIL',\n31:   'SIGNAL_KILLED',\n32:   'GENERATION_COUNTER_CORRUPT',\n33:   'PYTHON_MISSING',\n34:   'NONZERO_EXIT',\n35:   'SQLITE_BUSY_EXHAUSTED',\n36:   'DELETED_SKILL',\n37:   'UNKNOWN',\n38: ] as const;\n39: \n40: export type AdvisorErrorCode = (typeof ADVISOR_ERROR_CODE_VALUES)[number];\n41: export type AdvisorMetricType = 'counter' | 'histogram' | 'gauge';\n42: export type AdvisorOutcome = 'accepted' | 'corrected' | 'ignored';\n43: \n44: export interface AdvisorMetricDefinition {\n45:   readonly name: string;\n46:   readonly type: AdvisorMetricType;\n47:   readonly labels: readonly string[];\n48: }\n49: \n50: export interface AdvisorHookDiagnosticRecord {\n51:   readonly timestamp: string;\n52:   readonly runtime: AdvisorRuntime;\n53:   readonly status: AdvisorHookStatus;\n54:   readonly freshness: AdvisorHookFreshness;\n55:   readonly durationMs: number;\n56:   readonly cacheHit: boolean;\n57:   readonly errorCode?: AdvisorErrorCode;\n58:   readonly errorDetails?: string;\n59:   readonly skillLabel?: string;\n60:   readonly generation?: number;\n61:   readonly emittedBytes?: number;\n62:   readonly directivesSuppressed?: boolean;\n63: }\n64: \n65: export interface AdvisorHookHealthSection {\n66:   readonly key: 'advisor-hook-health';\n67:   readonly lastInvocations: readonly AdvisorHookDiagnosticRecord[];\n68:   readonly rollingCacheHitRate: number;\n69:   readonly rollingP95Ms: number;\n70:   readonly rollingFailOpenRate: number;\n71: }\n72: \n73: export interface AdvisorHookAlertThresholds {\n74:   readonly failOpenWarnRate: number;\n75:   readonly failOpenPageRate: number;\n76:   readonly cacheHitP95WarnMs: number;\n77:   readonly cacheHitP95PageMs: number;\n78: }\n79: \n80: export interface AdvisorHookMetricSnapshot {\n81:   readonly definitions: readonly AdvisorMetricDefinition[];\n82:   readonly records: readonly AdvisorHookDiagnosticRecord[];\n83: }\n84: \n85: export interface AdvisorHookOutcomeRecord {\n86:   readonly timestamp: string;\n87:   readonly runtime: AdvisorRuntime;\n88:   readonly outcome: AdvisorOutcome;\n89:   readonly skillLabel: string;\n90:   readonly correctedSkillLabel?: string;\n91: }\n92: \n93: export interface AdvisorHookOutcomeSummary {\n94:   readonly records: readonly AdvisorHookOutcomeRecord[];\n95:   readonly totals: {\n96:     readonly accepted: number;\n97:     readonly corrected: number;\n98:     readonly ignored: number;\n99:   };\n100: }\n101: \n102: // Execution-success outcome — a different signal from AdvisorHookOutcomeRecord\n103: // above. That record captures whether a *recommendation* was accepted\n104: // (accepted/corrected/ignored); this one captures whether the recommended\n105: // skill's TASK actually succeeded or failed. Accepting a recommendation says\n106: // nothing about whether the skill then completed the task, so a\n107: // reliability-over-execution ranking needs this distinct signal. Kept\n108: // prompt-free for the same prompt-safety reason the acceptance record is: only\n109: // a sanitized skill id, a boolean outcome, an idempotency key, and optional\n110: // bounded context tags the caller has already deemed safe to persist.\n111: export interface SkillExecutionOutcomeRecord {\n112:   readonly timestamp: string;\n113:   readonly runtime: AdvisorRuntime;\n114:   readonly skillId: string;\n115:   readonly success: boolean;\n116:   // Idempotency key: a replayed or double-delivered event carrying the same id\n117:   // folds to the same counts (no double-count).\n118:   readonly eventId: string;\n119:   // Optional failure-mode tag for query-scored recall (\"how this skill tends\n120:   // to fail on inputs like yours\"). Advisory only — never a hard demotion.\n121:   readonly failureMode?: string;\n122:   // Optional bounded, caller-sanitized context tags scored against a query for\n123:   // failure-mode recall. The store never captures the raw prompt.\n124:   readonly contextTags?: readonly string[];\n125: }\n126: \n127: // ───────────────────────────────────────────────────────────────\n128: // 2. CONSTANTS\n129: // ───────────────────────────────────────────────────────────────\n130: \n131: export const ADVISOR_HOOK_METRIC_DEFINITIONS = [\n132:   {\n133:     name: 'speckit_advisor_hook_duration_ms',\n134:     type: 'histogram',\n135:     labels: ['runtime', 'status', 'freshness', 'cacheHit'],\n136:   },\n137:   {\n138:     name: 'speckit_advisor_hook_invocations_total',\n139:     type: 'counter',\n140:     labels: ['runtime', 'status'],\n141:   },\n142:   {\n143:     name: 'speckit_advisor_hook_cache_hits_total',\n144:     type: 'counter',\n145:     labels: ['runtime'],\n146:   },\n147:   {\n148:     name: 'speckit_advisor_hook_cache_misses_total',\n149:     type: 'counter',\n150:     labels: ['runtime'],\n151:   },\n152:   {\n153:     name: 'speckit_advisor_hook_fail_open_total',\n154:     type: 'counter',\n155:     labels: ['runtime', 'errorCode'],\n156:   },\n157:   {\n158:     name: 'speckit_advisor_hook_freshness_state',\n159:     type: 'gauge',\n160:     labels: ['runtime', 'state'],\n161:   },\n162: ] as const satisfies readonly AdvisorMetricDefinition[];\n163: \n164: const FORBIDDEN_DIAGNOSTIC_FIELDS = new Set([\n165:   'prompt',\n166:   'promptFingerprint',\n167:   'promptExcerpt',\n168:   'stdout',\n169:   'stderr',\n170: ]);\n171: \n172: const DEFAULT_ALERT_THRESHOLDS: AdvisorHookAlertThresholds = {\n173:   failOpenWarnRate: 0.02,\n174:   failOpenPageRate: 0.05,\n175:   cacheHitP95WarnMs: 75,\n176:   cacheHitP95PageMs: 150,\n177: };\n178: \n179: const MAX_HEALTH_RECORDS = 30;\n180: const MAX_DURABLE_DIAGNOSTIC_RECORDS = 200;\n181: const MAX_DURABLE_OUTCOME_RECORDS = 200;\n182: const DURABLE_METRICS_ROOT = join(tmpdir(), 'speckit-skill-advisor-metrics');\n183: // The logs record which skills a user works with, so only that user may read them.\n184: const PRIVATE_DIR_MODE = 0o700;\n185: const PRIVATE_FILE_MODE = 0o600;\n186: const securedLogPaths = new Set<string>();\n187: let dirReady = false;\n188: const writeQueues = new Map<string, Promise<void>>();\n189: \n190: // ───────────────────────────────────────────────────────────────\n191: // 3. HELPERS\n192: // ───────────────────────────────────────────────────────────────\n193: \n194: function enumIncludes<T extends readonly string[]>(values: T, value: unknown): value is T[number] {\n195:   return typeof value === 'string' && values.includes(value);\n196: }\n197: \n198: function normalizeErrorCode(value: unknown): AdvisorErrorCode | undefined {\n199:   if (value === undefined || value === null) {\n200:     return undefined;\n201:   }\n202:   if (enumIncludes(ADVISOR_ERROR_CODE_VALUES, value)) {\n203:     return value;\n204:   }\n205:   if (value === 'JSON_PARSE_FAILED' || value === 'INVALID_JSON_SHAPE') {\n206:     return 'PARSE_FAIL';\n207:   }\n208:   if (value === 'SQLITE_BUSY_EXHAUSTED') {\n209:     return 'SQLITE_BUSY_EXHAUSTED';\n210:   }\n211:   if (value === 'NON_ZERO_EXIT' || value === 'NONZERO_EXIT') {\n212:     return 'NONZERO_EXIT';\n213:   }\n214:   return 'UNKNOWN';\n215: }\n216: \n217: function sanitizeDiagnosticText(value: unknown): string | undefined {\n218:   if (typeof value !== 'string') {\n219:     return undefined;\n220:   }\n221:   const compact = value.replace(/[\\n\\r]/g, ' ').replace(/\\s+/g, ' ').trim();\n222:   return compact ? compact.slice(0, 240) : undefined;\n223: }\n224: \n225: function sanitizeSkillLabel(value: unknown): string | undefined {\n226:   if (typeof value !== 'string') {\n227:     return undefined;\n228:   }\n229:   const compact = value.replace(/[\\n\\r]/g, ' ').replace(/\\s+/g, ' ').trim();\n230:   const bounded = compact.slice(0, 160);\n231:   return /^[a-z0-9:_-]+$/.test(bounded) ? bounded : undefined;\n232: }\n233: \n234: const MAX_CONTEXT_TAGS = 16;\n235: \n236: // Context tags are the only free-form payload on a skill-execution outcome, so\n237: // they are bounded and sanitized hard: drop non-strings, normalize whitespace,\n238: // cap length, dedupe, and cap count. The caller owns prompt-safety. This only\n239: // guarantees the stored shape stays small and closed.\n240: function sanitizeContextTags(value: unknown): string[] {\n241:   if (!Array.isArray(value)) {\n242:     return [];\n243:   }\n244:   const seen = new Set<string>();\n245:   for (const entry of value) {\n246:     const tag = sanitizeSkillLabel(entry);\n247:     if (tag) {\n248:       seen.add(tag);\n249:     }\n250:     if (seen.size >= MAX_CONTEXT_TAGS) {\n251:       break;\n252:     }\n253:   }\n254:   return [...seen];\n255: }\n256: \n257: function percentile(values: readonly number[], percentileValue: number): number {\n258:   if (values.length === 0) {\n259:     return 0;\n260:   }\n261:   const sorted = [...values].sort((left, right) => left - right);\n262:   const index = Math.min(\n263:     sorted.length - 1,\n264:     Math.max(0, Math.ceil((percentileValue / 100) * sorted.length) - 1),\n265:   );\n266:   return Number(sorted[index]?.toFixed(3) ?? 0);\n267: }\n268: \n269: function envNumber(name: string, fallback: number): number {\n270:   const raw = process.env[name];\n271:   if (raw === undefined) {\n272:     return fallback;\n273:   }\n274:   const parsed = Number(raw);\n275:   return Number.isFinite(parsed) ? parsed : fallback;\n276: }\n277: \n278: async function ensureParentDir(path: string): Promise<void> {\n279:   if (!dirReady) {\n280:     const dir = dirname(path);\n281:     await mkdir(dir, { recursive: true, mode: PRIVATE_DIR_MODE });\n282:     // mkdir keeps an existing directory's mode, so tighten one an older writer created.\n283:     // Only a chmod that succeeded marks the directory ready, so a failed one is\n284:     // retried on the next write.\n285:     dirReady = await chmod(dir, PRIVATE_DIR_MODE).then(() => true, () => false);\n286:   }\n287: }\n288: \n289: // appendFile applies its mode only when it creates the file, so tighten an older log.\n290: // Only a chmod that succeeded is remembered, so a failed one is retried on the next write.\n291: async function securePrivateLog(path: string): Promise<void> {\n292:   if (securedLogPaths.has(path)) return;\n293:   if (await chmod(path, PRIVATE_FILE_MODE).then(() => true, () => false)) {\n294:     securedLogPaths.add(path);\n295:   }\n296: }\n297: \n298: function workspaceHash(workspaceRoot: string): string {\n299:   return createHash('sha256')\n300:     .update(resolve(workspaceRoot))\n301:     .digest('hex')\n302:     .slice(0, 16);\n303: }\n304: \n305: function durableMetricsPath(workspaceRoot: string, kind: 'diagnostics' | 'outcomes'): string {\n306:   return join(DURABLE_METRICS_ROOT, `${workspaceHash(workspaceRoot)}-${kind}.jsonl`);\n307: }\n308: \n309: function readJsonlLines(path: string): string[] {\n310:   if (!existsSync(path)) {\n311:     return [];\n312:   }\n313:   return readFileSync(path, 'utf8')\n314:     .split('\\n')\n315:     .map((line) => line.trim())\n316:     .filter((line) => line.length > 0);\n317: }\n318: \n319: async function writeBoundedJsonl(path: string, line: string, maxRecords: number, options: { requireDebug?: boolean } = {}): Promise<void> {\n320:   if (options.requireDebug !== false && !process.env.SKILL_ADVISOR_DEBUG) return;\n321:   const previous = writeQueues.get(path) ?? Promise.resolve();\n322:   const next = previous.then(async () => {\n323:     await ensureParentDir(path);\n324:     // O_APPEND of one sub-PIPE_BUF line is atomic, so the add never loses a record\n325:     // under concurrency. Bounding stays correct under the same per-path queue: trim\n326:     // only once the file drifts past 1.5x the cap, so the common path is a cheap\n327:     // append and the read-trim-rewrite amortizes to once per ~0.5*maxRecords writes.\n328:     await appendFile(path, `${line}\\n`, { encoding: 'utf8', mode: PRIVATE_FILE_MODE });\n329:     await securePrivateLog(path);\n330:     if (maxRecords > 0) {\n331:       const lines = readJsonlLines(path);\n332:       if (lines.length > Math.floor(maxRecords * 1.5)) {\n333:         const temporaryPath = `${path}.${process.pid}.${Date.now()}.tmp`;\n334:         // Rename swaps atomically, so a crash mid-trim leaves the old log instead of a truncated one.\n335:         await writeFile(temporaryPath, `${lines.slice(-maxRecords).join('\\n')}\\n`, { encoding: 'utf8', mode: PRIVATE_FILE_MODE });\n336:         try {\n337:           await rename(temporaryPath, path);\n338:         } catch (error) {\n339:           await unlink(temporaryPath);\n340:           throw error;\n341:         }\n342:       }\n343:     }\n344:   });\n345:   writeQueues.set(path, next.catch(() => undefined));\n346:   await next;\n347: }\n348: \n349: function tryParseJsonLine(line: string): unknown | null {\n350:   try {\n351:     return JSON.parse(line) as unknown;\n352:   } catch {\n353:     return null;\n354:   }\n355: }\n356: \n357: // ───────────────────────────────────────────────────────────────\n358: // 4. CORE LOGIC\n359: // ───────────────────────────────────────────────────────────────\n360: \n361: /** Return the stable metric definitions emitted by advisor hook diagnostics. */\n362: export function getAdvisorHookMetricDefinitions(): readonly AdvisorMetricDefinition[] {\n363:   return ADVISOR_HOOK_METRIC_DEFINITIONS;\n364: }\n365: \n366: /** Read alert thresholds from environment with conservative defaults. */\n367: export function getAdvisorHookAlertThresholds(): AdvisorHookAlertThresholds {\n368:   return {\n369:     failOpenWarnRate: envNumber('SPECKIT_ADVISOR_HOOK_FAILOPEN_WARN_RATE', DEFAULT_ALERT_THRESHOLDS.failOpenWarnRate),\n370:     failOpenPageRate: envNumber('SPECKIT_ADVISOR_HOOK_FAILOPEN_PAGE_RATE', DEFAULT_ALERT_THRESHOLDS.failOpenPageRate),\n371:     cacheHitP95WarnMs: envNumber('SPECKIT_ADVISOR_HOOK_CACHE_HIT_P95_WARN_MS', DEFAULT_ALERT_THRESHOLDS.cacheHitP95WarnMs),\n372:     cacheHitP95PageMs: envNumber('SPECKIT_ADVISOR_HOOK_CACHE_HIT_P95_PAGE_MS', DEFAULT_ALERT_THRESHOLDS.cacheHitP95PageMs),\n373:   };\n374: }\n375: \n376: /** Build a prompt-safe diagnostic record from hook execution metadata. */\n377: export function createAdvisorHookDiagnosticRecord(input: {\n378:   readonly runtime: AdvisorRuntime;\n379:   readonly status: AdvisorHookStatus;\n380:   readonly freshness: AdvisorHookFreshness;\n381:   readonly durationMs: number;\n382:   readonly cacheHit: boolean;\n383:   readonly errorCode?: unknown;\n384:   readonly errorDetails?: unknown;\n385:   readonly skillLabel?: string | null;\n386:   readonly generation?: number;\n387:   readonly emittedBytes?: number;\n388:   readonly directivesSuppressed?: boolean;\n389:   readonly timestamp?: string;\n390: }): AdvisorHookDiagnosticRecord {\n391:   const errorCode = normalizeErrorCode(input.errorCode);\n392:   const errorDetails = sanitizeDiagnosticText(input.errorDetails);\n393:   return {\n394:     timestamp: input.timestamp ?? new Date().toISOString(),\n395:     runtime: input.runtime,\n396:     status: input.status,\n397:     freshness: input.freshness,\n398:     durationMs: Math.max(0, Math.round(input.durationMs)),\n399:     cacheHit: input.cacheHit,\n400:     ...(errorCode ? { errorCode } : {}),\n401:     ...(errorDetails ? { errorDetails } : {}),\n402:     ...(input.skillLabel ? { skillLabel: input.skillLabel } : {}),\n403:     ...(typeof input.generation === 'number' ? { generation: input.generation } : {}),\n404:     ...(typeof input.emittedBytes === 'number' ? { emittedBytes: input.emittedBytes } : {}),\n405:     ...(typeof input.directivesSuppressed === 'boolean' ? { directivesSuppressed: input.directivesSuppressed } : {}),\n406:   };\n407: }\n408: \n409: /** Validate that a diagnostic record matches the prompt-free closed schema. */\n410: export function validateAdvisorHookDiagnosticRecord(value: unknown): value is AdvisorHookDiagnosticRecord {\n411:   if (typeof value !== 'object' || value === null || Array.isArray(value)) {\n412:     return false;\n413:   }\n414:   const record = value as Record<string, unknown>;\n415:   if ([...FORBIDDEN_DIAGNOSTIC_FIELDS].some((field) => field in record)) {\n416:     return false;\n417:   }\n418:   return typeof record.timestamp === 'string'\n419:     && enumIncludes(ADVISOR_RUNTIME_VALUES, record.runtime)\n420:     && enumIncludes(ADVISOR_HOOK_STATUS_VALUES, record.status)\n421:     && enumIncludes(ADVISOR_HOOK_FRESHNESS_VALUES, record.freshness)\n422:     && typeof record.durationMs === 'number'\n423:     && typeof record.cacheHit === 'boolean'\n424:     && (record.errorCode === undefined || enumIncludes(ADVISOR_ERROR_CODE_VALUES, record.errorCode))\n425:     && (record.errorDetails === undefined || typeof record.errorDetails === 'string')\n426:     && (record.skillLabel === undefined || typeof record.skillLabel === 'string')\n427:     && (record.generation === undefined || typeof record.generation === 'number')\n428:     && (record.emittedBytes === undefined\n429:       || (typeof record.emittedBytes === 'number'\n430:         && Number.isInteger(record.emittedBytes)\n431:         && record.emittedBytes >= 0))\n432:     && (record.directivesSuppressed === undefined || typeof record.directivesSuppressed === 'boolean');\n433: }\n434: \n435: /** Serialize a validated diagnostic record for JSONL emission. */\n436: export function serializeAdvisorHookDiagnosticRecord(record: AdvisorHookDiagnosticRecord): string {\n437:   if (!validateAdvisorHookDiagnosticRecord(record)) {\n438:     throw new Error(\n439:       `AdvisorHookDiagnosticRecord: expected prompt-free closed-schema diagnostic record; actual ${typeof record}.`,\n440:     );\n441:   }\n442:   return JSON.stringify(record);\n443: }\n444: \n445: export async function persistAdvisorHookDiagnosticRecord(\n446:   workspaceRoot: string,\n447:   record: AdvisorHookDiagnosticRecord,\n448: ): Promise<string> {\n449:   const path = durableMetricsPath(workspaceRoot, 'diagnostics');\n450:   await writeBoundedJsonl(path, serializeAdvisorHookDiagnosticRecord(record), MAX_DURABLE_DIAGNOSTIC_RECORDS);\n451:   return path;\n452: }\n453: \n454: export function readAdvisorHookDiagnosticRecords(\n455:   workspaceRoot: string,\n456:   limit = MAX_DURABLE_DIAGNOSTIC_RECORDS,\n457: ): AdvisorHookDiagnosticRecord[] {\n458:   return readJsonlLines(durableMetricsPath(workspaceRoot, 'diagnostics'))\n459:     .slice(-limit)\n460:     .map((line) => JSON.parse(line) as unknown)\n461:     .filter(validateAdvisorHookDiagnosticRecord);\n462: }\n463: \n464: /** Build the rolling health section shown in advisor observability output. */\n465: export function buildAdvisorHookHealthSection(\n466:   records: readonly AdvisorHookDiagnosticRecord[],\n467: ): AdvisorHookHealthSection {\n468:   const lastInvocations = records.slice(-MAX_HEALTH_RECORDS);\n469:   const cacheHits = lastInvocations.filter((record) => record.cacheHit).length;\n470:   const failOpen = lastInvocations.filter((record) => record.status === 'fail_open').length;\n471:   return {\n472:     key: 'advisor-hook-health',\n473:     lastInvocations,\n474:     rollingCacheHitRate: lastInvocations.length > 0 ? cacheHits / lastInvocations.length : 0,\n475:     rollingP95Ms: percentile(\n476:       lastInvocations.filter((record) => record.cacheHit).map((record) => record.durationMs),\n477:       95,\n478:     ),\n479:     rollingFailOpenRate: lastInvocations.length > 0 ? failOpen / lastInvocations.length : 0,\n480:   };\n481: }\n482: \n483: export function readAdvisorHookHealthSection(workspaceRoot: string): AdvisorHookHealthSection {\n484:   return buildAdvisorHookHealthSection(readAdvisorHookDiagnosticRecords(workspaceRoot));\n485: }\n486: \n487: export function advisorHookDiagnosticsPath(workspaceRoot: string): string {\n488:   return durableMetricsPath(workspaceRoot, 'diagnostics');\n489: }\n490: \n491: // Persists only sanitized skill labels + the accept/correct/ignore signal,\n492: // never the prompt or scenario — deliberate prompt-safety. Real misroutes\n493: // therefore cannot be reconstructed into gold cases from this telemetry; that\n494: // is an accepted capability tradeoff, not an omission to fix by capturing\n495: // prompts (which would breach the prompt-safety invariant).\n496: export function createAdvisorHookOutcomeRecord(input: {\n497:   readonly runtime: AdvisorRuntime;\n498:   readonly outcome: AdvisorOutcome;\n499:   readonly skillLabel: string;\n500:   readonly correctedSkillLabel?: string | null;\n501:   readonly timestamp?: string;\n502: }): AdvisorHookOutcomeRecord {\n503:   return {\n504:     timestamp: input.timestamp ?? new Date().toISOString(),\n505:     runtime: input.runtime,\n506:     outcome: input.outcome,\n507:     skillLabel: sanitizeSkillLabel(input.skillLabel) ?? 'unknown-skill',\n508:     ...(sanitizeSkillLabel(input.correctedSkillLabel) ? { correctedSkillLabel: sanitizeSkillLabel(input.correctedSkillLabel) } : {}),\n509:   };\n510: }\n511: \n512: export function validateAdvisorHookOutcomeRecord(value: unknown): value is AdvisorHookOutcomeRecord {\n513:   if (typeof value !== 'object' || value === null || Array.isArray(value)) {\n514:     return false;\n515:   }\n516:   const record = value as Record<string, unknown>;\n517:   return typeof record.timestamp === 'string'\n518:     && enumIncludes(ADVISOR_RUNTIME_VALUES, record.runtime)\n519:     && (record.outcome === 'accepted' || record.outcome === 'corrected' || record.outcome === 'ignored')\n520:     && typeof record.skillLabel === 'string'\n521:     && (record.correctedSkillLabel === undefined || typeof record.correctedSkillLabel === 'string');\n522: }\n523: \n524: export async function persistAdvisorHookOutcomeRecord(\n525:   workspaceRoot: string,\n526:   record: AdvisorHookOutcomeRecord,\n527: ): Promise<string> {\n528:   const path = durableMetricsPath(workspaceRoot, 'outcomes');\n529:   await writeBoundedJsonl(path, JSON.stringify(record), MAX_DURABLE_OUTCOME_RECORDS, { requireDebug: false });\n530:   return path;\n531: }\n532: \n533: export function readAdvisorHookOutcomeRecords(\n534:   workspaceRoot: string,\n535:   limit = MAX_DURABLE_OUTCOME_RECORDS,\n536: ): AdvisorHookOutcomeRecord[] {\n537:   return readJsonlLines(durableMetricsPath(workspaceRoot, 'outcomes'))\n538:     .slice(-limit)\n539:     .map((line) => tryParseJsonLine(line))\n540:     .filter(validateAdvisorHookOutcomeRecord);\n541: }\n542: \n543: export function summarizeAdvisorHookOutcomeRecords(\n544:   workspaceRoot: string,\n545: ): AdvisorHookOutcomeSummary {\n546:   const records = readAdvisorHookOutcomeRecords(workspaceRoot);\n547:   const totals = {\n548:     accepted: records.filter((record) => record.outcome === 'accepted').length,\n549:     corrected: records.filter((record) => record.outcome === 'corrected').length,\n550:     ignored: records.filter((record) => record.outcome === 'ignored').length,\n551:   };\n552:   return { records, totals };\n553: }\n554: \n555: export function advisorHookOutcomesPath(workspaceRoot: string): string {\n556:   return durableMetricsPath(workspaceRoot, 'outcomes');\n557: }\n558: \n559: // Mirrors createAdvisorHookOutcomeRecord but for execution success, not\n560: // recommendation acceptance. Persistence lives in the skill-outcome store, not\n561: // here, so the acceptance write-path (debug-gated, bounded) is left untouched.\n562: export function createSkillExecutionOutcomeRecord(input: {\n563:   readonly runtime: AdvisorRuntime;\n564:   readonly skillId: string;\n565:   readonly success: boolean;\n566:   readonly eventId: string;\n567:   readonly failureMode?: string | null;\n568:   readonly contextTags?: readonly string[] | null;\n569:   readonly timestamp?: string;\n570: }): SkillExecutionOutcomeRecord {\n571:   const timestamp = input.timestamp ?? new Date().toISOString();\n572:   const skillId = sanitizeSkillLabel(input.skillId) ?? 'unknown-skill';\n573:   const eventId = sanitizeSkillLabel(input.eventId) ?? `${skillId}:${timestamp}`;\n574:   const failureMode = sanitizeSkillLabel(input.failureMode);\n575:   const contextTags = sanitizeContextTags(input.contextTags);\n576:   return {\n577:     timestamp,\n578:     runtime: input.runtime,\n579:     skillId,\n580:     success: input.success === true,\n581:     eventId,\n582:     ...(failureMode ? { failureMode } : {}),\n583:     ...(contextTags.length > 0 ? { contextTags } : {}),\n584:   };\n585: }\n586: \n587: export function validateSkillExecutionOutcomeRecord(value: unknown): value is SkillExecutionOutcomeRecord {\n588:   if (typeof value !== 'object' || value === null || Array.isArray(value)) {\n589:     return false;\n590:   }\n591:   const record = value as Record<string, unknown>;\n592:   return typeof record.timestamp === 'string'\n593:     && enumIncludes(ADVISOR_RUNTIME_VALUES, record.runtime)\n594:     && typeof record.skillId === 'string'\n595:     && typeof record.success === 'boolean'\n596:     && typeof record.eventId === 'string'\n597:     && (record.failureMode === undefined || typeof record.failureMode === 'string')\n598:     && (record.contextTags === undefined\n599:       || (Array.isArray(record.contextTags) && record.contextTags.every((tag) => typeof tag === 'string')));\n600: }\n601: \n602: /** Small in-memory collector for advisor hook metrics and health snapshots. */\n603: export class AdvisorHookMetricsCollector {\n604:   private readonly records: AdvisorHookDiagnosticRecord[] = [];\n605: \n606:   record(record: AdvisorHookDiagnosticRecord): void {\n607:     if (!validateAdvisorHookDiagnosticRecord(record)) {\n608:       throw new Error(\n609:         `AdvisorHookDiagnosticRecord: expected prompt-free closed-schema diagnostic record; actual ${typeof record}.`,\n610:       );\n611:     }\n612:     this.records.push(record);\n613:   }\n614: \n615:   snapshot(): AdvisorHookMetricSnapshot {\n616:     return {\n617:       definitions: ADVISOR_HOOK_METRIC_DEFINITIONS,\n618:       records: [...this.records],\n619:     };\n620:   }\n621: \n622:   healthSection(): AdvisorHookHealthSection {\n623:     return buildAdvisorHookHealthSection(this.records);\n624:   }\n625: \n626:   reset(): void {\n627:     this.records.length = 0;\n628:   }\n629: }\n630: \n631: // ───────────────────────────────────────────────────────────────\n632: // 5. SPEC_KIT.* INSTRUMENTATION NAMESPACE\n633: // ───────────────────────────────────────────────────────────────\n634: // Adds 17 canonical `spec_kit.<group>.<metric_name>` metrics for code-graph,\n635: // scorer, freshness, and cross-cutting advisor surfaces. All emission paths\n636: // MUST be guarded by the SPECKIT_METRICS_ENABLED env var (default OFF).\n637: // Persistence is additive: definitions live alongside the existing\n638: // AdvisorHookMetricSnapshot, no rename or removal of existing fields.\n639: //\n640: // Lifecycle-promotion metrics are intentionally omitted because those fields\n641: // were removed upstream.\n642: \n643: export const SPECKIT_GRAPH_QUERY_MODES = ['outline', 'blast_radius', 'relationship'] as const;\n644: export const SPECKIT_GRAPH_OUTCOMES = ['success', 'error'] as const;\n645: export const SPECKIT_GRAPH_LANGUAGES = ['javascript', 'typescript', 'python', 'bash'] as const;\n646: export const SPECKIT_GRAPH_EDGE_TYPES = [\n647:   'CONTAINS', 'CALLS', 'IMPORTS', 'EXPORTS',\n648:   'EXTENDS', 'IMPLEMENTS', 'TESTED_BY',\n649:   'DECORATES', 'OVERRIDES', 'TYPE_OF',\n650: ] as const;\n651: export const SPECKIT_SCORER_LANES = [\n652:   'explicit_author', 'lexical', 'graph_causal', 'derived_generated', 'semantic_shadow',\n653: ] as const;\n654: export const SPECKIT_PROMPT_CACHE_LAYERS = ['exact', 'near_dup'] as const;\n655: export const SPECKIT_CONFIDENCE_BUCKETS = [0, 0.5, 0.7, 0.8, 0.9, 1.0] as const;\n656: \n657: export type SpeckitMetricName =\n658:   | 'spec_kit.graph.scan_duration_ms'\n659:   | 'spec_kit.graph.parse_duration_ms'\n660:   | 'spec_kit.graph.query_latency_ms'\n661:   | 'spec_kit.graph.query_cache_hits_total'\n662:   | 'spec_kit.graph.query_cache_misses_total'\n663:   | 'spec_kit.graph.edge_detection_total'\n664:   | 'spec_kit.graph.partial_persist_retries_total'\n665:   // Blast-radius compute / DB failure counter labelled with\n666:   // `code` (e.g. `compute_error`) so operators can distinguish failure\n667:   // modes in the failure-fallback path.\n668:   | 'spec_kit.graph.blast_radius_failure_total'\n669:   | 'spec_kit.scorer.lane_contribution'\n670:   | 'spec_kit.scorer.fusion_live_weight_share'\n671:   | 'spec_kit.scorer.primary_intent_bonus_applied_total'\n672:   | 'spec_kit.scorer.graph_conflict_demote_applied_total'\n673:   | 'spec_kit.scorer.confidence_brier_score'\n674:   | 'spec_kit.scorer.near_dup_cache_miss_total'\n675:   | 'spec_kit.freshness.state_transitions_total'\n676:   | 'spec_kit.freshness.source_signature_bumps_total'\n677:   | 'spec_kit.freshness.prompt_cache_hit_ratio'\n678:   | 'spec_kit.advisor.recommendation_emitted_total'\n679:   | 'spec_kit.advisor.recommendation_confidence_brackets';\n680: \n681: export const SPECKIT_METRIC_DEFINITIONS = [\n682:   // 6 code-graph metrics (#1-6)\n683:   { name: 'spec_kit.graph.scan_duration_ms', type: 'histogram', labels: ['outcome'] },\n684:   { name: 'spec_kit.graph.parse_duration_ms', type: 'histogram', labels: ['language', 'outcome'] },\n685:   { name: 'spec_kit.graph.query_latency_ms', type: 'histogram', labels: ['mode', 'freshness_state'] },\n686:   { name: 'spec_kit.graph.query_cache_hits_total', type: 'counter', labels: ['mode'] },\n687:   { name: 'spec_kit.graph.query_cache_misses_total', type: 'counter', labels: ['mode'] },\n688:   { name: 'spec_kit.graph.edge_detection_total', type: 'counter', labels: ['edge_type', 'runtime'] },\n689:   { name: 'spec_kit.graph.partial_persist_retries_total', type: 'counter', labels: [] },\n690:   // Blast-radius failure counter (compute_error / DB error /\n691:   // Etc.). Distinguishes a real compute failure from a legitimately empty\n692:   // Blast radius (which has no failureFallback at all).\n693:   { name: 'spec_kit.graph.blast_radius_failure_total', type: 'counter', labels: ['code'] },\n694:   // 5 scorer metrics (#7-11)\n695:   { name: 'spec_kit.scorer.lane_contribution', type: 'gauge', labels: ['lane', 'skill_id'] },\n696:   { name: 'spec_kit.scorer.fusion_live_weight_share', type: 'gauge', labels: ['lane'] },\n697:   { name: 'spec_kit.scorer.primary_intent_bonus_applied_total', type: 'counter', labels: ['skill_id'] },\n698:   { name: 'spec_kit.scorer.graph_conflict_demote_applied_total', type: 'counter', labels: ['skill_id'] },\n699:   { name: 'spec_kit.scorer.confidence_brier_score', type: 'histogram', labels: [] },\n700:   { name: 'spec_kit.scorer.near_dup_cache_miss_total', type: 'counter', labels: ['cache_layer'] },\n701:   // 3 freshness metrics (#12-14)\n702:   { name: 'spec_kit.freshness.state_transitions_total', type: 'counter', labels: ['from_state', 'to_state'] },\n703:   { name: 'spec_kit.freshness.source_signature_bumps_total', type: 'counter', labels: [] },\n704:   { name: 'spec_kit.freshness.prompt_cache_hit_ratio', type: 'gauge', labels: [] },\n705:   // 2 cross-cutting metrics (#15-16)\n706:   { name: 'spec_kit.advisor.recommendation_emitted_total', type: 'counter', labels: ['runtime', 'freshness_state'] },\n707:   { name: 'spec_kit.advisor.recommendation_confidence_brackets', type: 'histogram', labels: [] },\n708: ] as const satisfies readonly AdvisorMetricDefinition[];\n709: \n710: export interface SpeckitMetricSample {\n711:   readonly name: SpeckitMetricName;\n712:   readonly value: number;\n713:   readonly labels: Readonly<Record<string, string>>;\n714:   readonly timestamp: number;\n715: }\n716: \n717: /** Returns true iff SPECKIT_METRICS_ENABLED env var is set to 'true'. */\n718: export function isSpeckitMetricsEnabled(): boolean {\n719:   return process.env.SPECKIT_METRICS_ENABLED === 'true';\n720: }\n721: \n722: /** Stable ordered key for cardinality counting and gauge upserts. */\n723: function speckitSeriesKey(name: string, labels: Record<string, string>): string {\n724:   const ordered = Object.keys(labels).sort().map((key) => `${key}=${labels[key]}`).join(',');\n725:   return `${name}{${ordered}}`;\n726: }\n727: \n728: /**\n729:  * In-memory collector for the spec_kit.* metric namespace. Counters and\n730:  * gauges are keyed by stable label-set; histograms retain raw samples.\n731:  * Emission MUST be gated by isSpeckitMetricsEnabled() at the call site.\n732:  */\n733: export class SpeckitMetricsCollector {\n734:   private readonly counters = new Map<string, number>();\n735:   private readonly gauges = new Map<string, number>();\n736:   private readonly histograms = new Map<string, number[]>();\n737:   // Brier score accumulator: {sum, count} per series for the summary metric\n738:   private readonly brier = new Map<string, { sum: number; count: number }>();\n739:   // Prompt-cache hit-ratio accumulator (metric #14 derived from hits/misses)\n740:   private promptCacheHits = 0;\n741:   private promptCacheMisses = 0;\n742: \n743:   incrementCounter(name: SpeckitMetricName, labels: Record<string, string> = {}, by = 1): void {\n744:     const key = speckitSeriesKey(name, labels);\n745:     this.counters.set(key, (this.counters.get(key) ?? 0) + by);\n746:   }\n747: \n748:   setGauge(name: SpeckitMetricName, value: number, labels: Record<string, string> = {}): void {\n749:     const key = speckitSeriesKey(name, labels);\n750:     this.gauges.set(key, value);\n751:   }\n752: \n753:   recordHistogram(name: SpeckitMetricName, value: number, labels: Record<string, string> = {}): void {\n754:     const key = speckitSeriesKey(name, labels);\n755:     const bucket = this.histograms.get(key);\n756:     if (bucket) {\n757:       bucket.push(value);\n758:     } else {\n759:       this.histograms.set(key, [value]);\n760:     }\n761:   }\n762: \n763:   /** Record a single Brier-score observation; mean is exposed via snapshot. */\n764:   recordBrierScore(observation: number, labels: Record<string, string> = {}): void {\n765:     const key = speckitSeriesKey('spec_kit.scorer.confidence_brier_score', labels);\n766:     const acc = this.brier.get(key) ?? { sum: 0, count: 0 };\n767:     acc.sum += observation;\n768:     acc.count += 1;\n769:     this.brier.set(key, acc);\n770:     this.recordHistogram('spec_kit.scorer.confidence_brier_score', observation, labels);\n771:   }\n772: \n773:   /** Bump prompt-cache hit/miss tallies feeding metric #14. */\n774:   recordPromptCacheOutcome(outcome: 'hit' | 'miss'): void {\n775:     if (outcome === 'hit') {\n776:       this.promptCacheHits += 1;\n777:     } else {\n778:       this.promptCacheMisses += 1;\n779:     }\n780:     const total = this.promptCacheHits + this.promptCacheMisses;\n781:     const ratio = total > 0 ? this.promptCacheHits / total : 0;\n782:     this.setGauge('spec_kit.freshness.prompt_cache_hit_ratio', ratio);\n783:   }\n784: \n785:   /** Place a recommendation confidence in the closest fixed bucket boundary. */\n786:   recordConfidenceBracket(confidence: number): void {\n787:     const clamped = Math.max(0, Math.min(1, confidence));\n788:     this.recordHistogram('spec_kit.advisor.recommendation_confidence_brackets', clamped);\n789:   }\n790: \n791:   /** Returns the live unique-series count (cardinality meta-gauge). */\n792:   uniqueSeriesCount(): number {\n793:     return this.counters.size + this.gauges.size + this.histograms.size;\n794:   }\n795: \n796:   snapshot(): {\n797:     readonly definitions: readonly AdvisorMetricDefinition[];\n798:     readonly counters: ReadonlyMap<string, number>;\n799:     readonly gauges: ReadonlyMap<string, number>;\n800:     readonly histograms: ReadonlyMap<string, readonly number[]>;\n801:     readonly brierMean: ReadonlyMap<string, number>;\n802:     readonly metricsUniqueSeriesCount: number;\n803:   } {\n804:     const brierMean = new Map<string, number>();\n805:     for (const [key, acc] of this.brier) {\n806:       brierMean.set(key, acc.count > 0 ? acc.sum / acc.count : 0);\n807:     }\n808:     return {\n809:       definitions: SPECKIT_METRIC_DEFINITIONS,\n810:       counters: this.counters,\n811:       gauges: this.gauges,\n812:       histograms: this.histograms,\n813:       brierMean,\n814:       metricsUniqueSeriesCount: this.uniqueSeriesCount(),\n815:     };\n816:   }\n817: \n818:   reset(): void {\n819:     this.counters.clear();\n820:     this.gauges.clear();\n821:     this.histograms.clear();\n822:     this.brier.clear();\n823:     this.promptCacheHits = 0;\n824:     this.promptCacheMisses = 0;\n825:   }\n826: }\n827: \n828: /** Process-wide collector. Callers MUST gate emission with isSpeckitMetricsEnabled(). */\n829: export const speckitMetrics = new SpeckitMetricsCollector();\n830: \n831: /** Returns the static metric definitions for the spec_kit.* namespace. */\n832: export function getSpeckitMetricDefinitions(): readonly AdvisorMetricDefinition[] {\n833:   return SPECKIT_METRIC_DEFINITIONS;\n834: }","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/lib/metrics.ts, lines 1-834\n1: // ───────────────────────────────────────────────────────────────\n2: // MODULE: Advisor Hook Metrics Contract\n3: // ───────────────────────────────────────────────────────────────\n4: \n5: import { createHash } from 'node:crypto';\n6: import { existsSync, readFileSync } from 'node:fs';\n7: import { appendFile, chmod, mkdir, rename, unlink, writeFile } from 'node:fs/promises';\n8: import { tmpdir } from 'node:os';\n9: import { dirname, join, resolve } from 'node:path';\n10: \n11: import { ADVISOR_RUNTIME_VALUES } from './advisor-runtime-values.js';\n12: \n13: import type {\n14:   AdvisorHookFreshness,\n15:   AdvisorHookStatus,\n16:   AdvisorRuntime,\n17: } from './skill-advisor-brief.js';\n18: \n19: // ───────────────────────────────────────────────────────────────\n20: // 1. TYPES\n21: // ───────────────────────────────────────────────────────────────\n22: \n23: export { ADVISOR_RUNTIME_VALUES } from './advisor-runtime-values.js';\n24: export const ADVISOR_HOOK_STATUS_VALUES = ['ok', 'skipped', 'stale', 'degraded', 'fail_open'] as const;\n25: export const ADVISOR_HOOK_FRESHNESS_VALUES = ['live', 'stale', 'absent', 'unavailable'] as const;\n26: export const ADVISOR_ERROR_CODE_VALUES = [\n27:   'TIMEOUT',\n28:   'SCRIPT_MISSING',\n29:   'SQLITE_BUSY',\n30:   'PARSE_FAIL',\n31:   'SIGNAL_KILLED',\n32:   'GENERATION_COUNTER_CORRUPT',\n33:   'PYTHON_MISSING',\n34:   'NONZERO_EXIT',\n35:   'SQLITE_BUSY_EXHAUSTED',\n36:   'DELETED_SKILL',\n37:   'UNKNOWN',\n38: ] as const;\n39: \n40: export type AdvisorErrorCode = (typeof ADVISOR_ERROR_CODE_VALUES)[number];\n41: export type AdvisorMetricType = 'counter' | 'histogram' | 'gauge';\n42: export type AdvisorOutcome = 'accepted' | 'corrected' | 'ignored';\n43: \n44: export interface AdvisorMetricDefinition {\n45:   readonly name: string;\n46:   readonly type: AdvisorMetricType;\n47:   readonly labels: readonly string[];\n48: }\n49: \n50: export interface AdvisorHookDiagnosticRecord {\n51:   readonly timestamp: string;\n52:   readonly runtime: AdvisorRuntime;\n53:   readonly status: AdvisorHookStatus;\n54:   readonly freshness: AdvisorHookFreshness;\n55:   readonly durationMs: number;\n56:   readonly cacheHit: boolean;\n57:   readonly errorCode?: AdvisorErrorCode;\n58:   readonly errorDetails?: string;\n59:   readonly skillLabel?: string;\n60:   readonly generation?: number;\n61:   readonly emittedBytes?: number;\n62:   readonly directivesSuppressed?: boolean;\n63: }\n64: \n65: export interface AdvisorHookHealthSection {\n66:   readonly key: 'advisor-hook-health';\n67:   readonly lastInvocations: readonly AdvisorHookDiagnosticRecord[];\n68:   readonly rollingCacheHitRate: number;\n69:   readonly rollingP95Ms: number;\n70:   readonly rollingFailOpenRate: number;\n71: }\n72: \n73: export interface AdvisorHookAlertThresholds {\n74:   readonly failOpenWarnRate: number;\n75:   readonly failOpenPageRate: number;\n76:   readonly cacheHitP95WarnMs: number;\n77:   readonly cacheHitP95PageMs: number;\n78: }\n79: \n80: export interface AdvisorHookMetricSnapshot {\n81:   readonly definitions: readonly AdvisorMetricDefinition[];\n82:   readonly records: readonly AdvisorHookDiagnosticRecord[];\n83: }\n84: \n85: export interface AdvisorHookOutcomeRecord {\n86:   readonly timestamp: string;\n87:   readonly runtime: AdvisorRuntime;\n88:   readonly outcome: AdvisorOutcome;\n89:   readonly skillLabel: string;\n90:   readonly correctedSkillLabel?: string;\n91: }\n92: \n93: export interface AdvisorHookOutcomeSummary {\n94:   readonly records: readonly AdvisorHookOutcomeRecord[];\n95:   readonly totals: {\n96:     readonly accepted: number;\n97:     readonly corrected: number;\n98:     readonly ignored: number;\n99:   };\n100: }\n101: \n102: // Execution-success outcome — a different signal from AdvisorHookOutcomeRecord\n103: // above. That record captures whether a *recommendation* was accepted\n104: // (accepted/corrected/ignored); this one captures whether the recommended\n105: // skill's TASK actually succeeded or failed. Accepting a recommendation says\n106: // nothing about whether the skill then completed the task, so a\n107: // reliability-over-execution ranking needs this distinct signal. Kept\n108: // prompt-free for the same prompt-safety reason the acceptance record is: only\n109: // a sanitized skill id, a boolean outcome, an idempotency key, and optional\n110: // bounded context tags the caller has already deemed safe to persist.\n111: export interface SkillExecutionOutcomeRecord {\n112:   readonly timestamp: string;\n113:   readonly runtime: AdvisorRuntime;\n114:   readonly skillId: string;\n115:   readonly success: boolean;\n116:   // Idempotency key: a replayed or double-delivered event carrying the same id\n117:   // folds to the same counts (no double-count).\n118:   readonly eventId: string;\n119:   // Optional failure-mode tag for query-scored recall (\"how this skill tends\n120:   // to fail on inputs like yours\"). Advisory only — never a hard demotion.\n121:   readonly failureMode?: string;\n122:   // Optional bounded, caller-sanitized context tags scored against a query for\n123:   // failure-mode recall. The store never captures the raw prompt.\n124:   readonly contextTags?: readonly string[];\n125: }\n126: \n127: // ───────────────────────────────────────────────────────────────\n128: // 2. CONSTANTS\n129: // ───────────────────────────────────────────────────────────────\n130: \n131: export const ADVISOR_HOOK_METRIC_DEFINITIONS = [\n132:   {\n133:     name: 'speckit_advisor_hook_duration_ms',\n134:     type: 'histogram',\n135:     labels: ['runtime', 'status', 'freshness', 'cacheHit'],\n136:   },\n137:   {\n138:     name: 'speckit_advisor_hook_invocations_total',\n139:     type: 'counter',\n140:     labels: ['runtime', 'status'],\n141:   },\n142:   {\n143:     name: 'speckit_advisor_hook_cache_hits_total',\n144:     type: 'counter',\n145:     labels: ['runtime'],\n146:   },\n147:   {\n148:     name: 'speckit_advisor_hook_cache_misses_total',\n149:     type: 'counter',\n150:     labels: ['runtime'],\n151:   },\n152:   {\n153:     name: 'speckit_advisor_hook_fail_open_total',\n154:     type: 'counter',\n155:     labels: ['runtime', 'errorCode'],\n156:   },\n157:   {\n158:     name: 'speckit_advisor_hook_freshness_state',\n159:     type: 'gauge',\n160:     labels: ['runtime', 'state'],\n161:   },\n162: ] as const satisfies readonly AdvisorMetricDefinition[];\n163: \n164: const FORBIDDEN_DIAGNOSTIC_FIELDS = new Set([\n165:   'prompt',\n166:   'promptFingerprint',\n167:   'promptExcerpt',\n168:   'stdout',\n169:   'stderr',\n170: ]);\n171: \n172: const DEFAULT_ALERT_THRESHOLDS: AdvisorHookAlertThresholds = {\n173:   failOpenWarnRate: 0.02,\n174:   failOpenPageRate: 0.05,\n175:   cacheHitP95WarnMs: 75,\n176:   cacheHitP95PageMs: 150,\n177: };\n178: \n179: const MAX_HEALTH_RECORDS = 30;\n180: const MAX_DURABLE_DIAGNOSTIC_RECORDS = 200;\n181: const MAX_DURABLE_OUTCOME_RECORDS = 200;\n182: const DURABLE_METRICS_ROOT = join(tmpdir(), 'speckit-skill-advisor-metrics');\n183: // The logs record which skills a user works with, so only that user may read them.\n184: const PRIVATE_DIR_MODE = 0o700;\n185: const PRIVATE_FILE_MODE = 0o600;\n186: const securedLogPaths = new Set<string>();\n187: let dirReady = false;\n188: const writeQueues = new Map<string, Promise<void>>();\n189: \n190: // ───────────────────────────────────────────────────────────────\n191: // 3. HELPERS\n192: // ───────────────────────────────────────────────────────────────\n193: \n194: function enumIncludes<T extends readonly string[]>(values: T, value: unknown): value is T[number] {\n195:   return typeof value === 'string' && values.includes(value);\n196: }\n197: \n198: function normalizeErrorCode(value: unknown): AdvisorErrorCode | undefined {\n199:   if (value === undefined || value === null) {\n200:     return undefined;\n201:   }\n202:   if (enumIncludes(ADVISOR_ERROR_CODE_VALUES, value)) {\n203:     return value;\n204:   }\n205:   if (value === 'JSON_PARSE_FAILED' || value === 'INVALID_JSON_SHAPE') {\n206:     return 'PARSE_FAIL';\n207:   }\n208:   if (value === 'SQLITE_BUSY_EXHAUSTED') {\n209:     return 'SQLITE_BUSY_EXHAUSTED';\n210:   }\n211:   if (value === 'NON_ZERO_EXIT' || value === 'NONZERO_EXIT') {\n212:     return 'NONZERO_EXIT';\n213:   }\n214:   return 'UNKNOWN';\n215: }\n216: \n217: function sanitizeDiagnosticText(value: unknown): string | undefined {\n218:   if (typeof value !== 'string') {\n219:     return undefined;\n220:   }\n221:   const compact = value.replace(/[\\n\\r]/g, ' ').replace(/\\s+/g, ' ').trim();\n222:   return compact ? compact.slice(0, 240) : undefined;\n223: }\n224: \n225: function sanitizeSkillLabel(value: unknown): string | undefined {\n226:   if (typeof value !== 'string') {\n227:     return undefined;\n228:   }\n229:   const compact = value.replace(/[\\n\\r]/g, ' ').replace(/\\s+/g, ' ').trim();\n230:   const bounded = compact.slice(0, 160);\n231:   return /^[a-z0-9:_-]+$/.test(bounded) ? bounded : undefined;\n232: }\n233: \n234: const MAX_CONTEXT_TAGS = 16;\n235: \n236: // Context tags are the only free-form payload on a skill-execution outcome, so\n237: // they are bounded and sanitized hard: drop non-strings, normalize whitespace,\n238: // cap length, dedupe, and cap count. The caller owns prompt-safety. This only\n239: // guarantees the stored shape stays small and closed.\n240: function sanitizeContextTags(value: unknown): string[] {\n241:   if (!Array.isArray(value)) {\n242:     return [];\n243:   }\n244:   const seen = new Set<string>();\n245:   for (const entry of value) {\n246:     const tag = sanitizeSkillLabel(entry);\n247:     if (tag) {\n248:       seen.add(tag);\n249:     }\n250:     if (seen.size >= MAX_CONTEXT_TAGS) {\n251:       break;\n252:     }\n253:   }\n254:   return [...seen];\n255: }\n256: \n257: function percentile(values: readonly number[], percentileValue: number): number {\n258:   if (values.length === 0) {\n259:     return 0;\n260:   }\n261:   const sorted = [...values].sort((left, right) => left - right);\n262:   const index = Math.min(\n263:     sorted.length - 1,\n264:     Math.max(0, Math.ceil((percentileValue / 100) * sorted.length) - 1),\n265:   );\n266:   return Number(sorted[index]?.toFixed(3) ?? 0);\n267: }\n268: \n269: function envNumber(name: string, fallback: number): number {\n270:   const raw = process.env[name];\n271:   if (raw === undefined) {\n272:     return fallback;\n273:   }\n274:   const parsed = Number(raw);\n275:   return Number.isFinite(parsed) ? parsed : fallback;\n276: }\n277: \n278: async function ensureParentDir(path: string): Promise<void> {\n279:   if (!dirReady) {\n280:     const dir = dirname(path);\n281:     await mkdir(dir, { recursive: true, mode: PRIVATE_DIR_MODE });\n282:     // mkdir keeps an existing directory's mode, so tighten one an older writer created.\n283:     // Only a chmod that succeeded marks the directory ready, so a failed one is\n284:     // retried on the next write.\n285:     dirReady = await chmod(dir, PRIVATE_DIR_MODE).then(() => true, () => false);\n286:   }\n287: }\n288: \n289: // appendFile applies its mode only when it creates the file, so tighten an older log.\n290: // Only a chmod that succeeded is remembered, so a failed one is retried on the next write.\n291: async function securePrivateLog(path: string): Promise<void> {\n292:   if (securedLogPaths.has(path)) return;\n293:   if (await chmod(path, PRIVATE_FILE_MODE).then(() => true, () => false)) {\n294:     securedLogPaths.add(path);\n295:   }\n296: }\n297: \n298: function workspaceHash(workspaceRoot: string): string {\n299:   return createHash('sha256')\n300:     .update(resolve(workspaceRoot))\n301:     .digest('hex')\n302:     .slice(0, 16);\n303: }\n304: \n305: function durableMetricsPath(workspaceRoot: string, kind: 'diagnostics' | 'outcomes'): string {\n306:   return join(DURABLE_METRICS_ROOT, `${workspaceHash(workspaceRoot)}-${kind}.jsonl`);\n307: }\n308: \n309: function readJsonlLines(path: string): string[] {\n310:   if (!existsSync(path)) {\n311:     return [];\n312:   }\n313:   return readFileSync(path, 'utf8')\n314:     .split('\\n')\n315:     .map((line) => line.trim())\n316:     .filter((line) => line.length > 0);\n317: }\n318: \n319: async function writeBoundedJsonl(path: string, line: string, maxRecords: number, options: { requireDebug?: boolean } = {}): Promise<void> {\n320:   if (options.requireDebug !== false && !process.env.SKILL_ADVISOR_DEBUG) return;\n321:   const previous = writeQueues.get(path) ?? Promise.resolve();\n322:   const next = previous.then(async () => {\n323:     await ensureParentDir(path);\n324:     // O_APPEND of one sub-PIPE_BUF line is atomic, so the add never loses a record\n325:     // under concurrency. Bounding stays correct under the same per-path queue: trim\n326:     // only once the file drifts past 1.5x the cap, so the common path is a cheap\n327:     // append and the read-trim-rewrite amortizes to once per ~0.5*maxRecords writes.\n328:     await appendFile(path, `${line}\\n`, { encoding: 'utf8', mode: PRIVATE_FILE_MODE });\n329:     await securePrivateLog(path);\n330:     if (maxRecords > 0) {\n331:       const lines = readJsonlLines(path);\n332:       if (lines.length > Math.floor(maxRecords * 1.5)) {\n333:         const temporaryPath = `${path}.${process.pid}.${Date.now()}.tmp`;\n334:         // Rename swaps atomically, so a crash mid-trim leaves the old log instead of a truncated one.\n335:         await writeFile(temporaryPath, `${lines.slice(-maxRecords).join('\\n')}\\n`, { encoding: 'utf8', mode: PRIVATE_FILE_MODE });\n336:         try {\n337:           await rename(temporaryPath, path);\n338:         } catch (error) {\n339:           await unlink(temporaryPath);\n340:           throw error;\n341:         }\n342:       }\n343:     }\n344:   });\n345:   writeQueues.set(path, next.catch(() => undefined));\n346:   await next;\n347: }\n348: \n349: function tryParseJsonLine(line: string): unknown | null {\n350:   try {\n351:     return JSON.parse(line) as unknown;\n352:   } catch {\n353:     return null;\n354:   }\n355: }\n356: \n357: // ───────────────────────────────────────────────────────────────\n358: // 4. CORE LOGIC\n359: // ───────────────────────────────────────────────────────────────\n360: \n361: /** Return the stable metric definitions emitted by advisor hook diagnostics. */\n362: export function getAdvisorHookMetricDefinitions(): readonly AdvisorMetricDefinition[] {\n363:   return ADVISOR_HOOK_METRIC_DEFINITIONS;\n364: }\n365: \n366: /** Read alert thresholds from environment with conservative defaults. */\n367: export function getAdvisorHookAlertThresholds(): AdvisorHookAlertThresholds {\n368:   return {\n369:     failOpenWarnRate: envNumber('SPECKIT_ADVISOR_HOOK_FAILOPEN_WARN_RATE', DEFAULT_ALERT_THRESHOLDS.failOpenWarnRate),\n370:     failOpenPageRate: envNumber('SPECKIT_ADVISOR_HOOK_FAILOPEN_PAGE_RATE', DEFAULT_ALERT_THRESHOLDS.failOpenPageRate),\n371:     cacheHitP95WarnMs: envNumber('SPECKIT_ADVISOR_HOOK_CACHE_HIT_P95_WARN_MS', DEFAULT_ALERT_THRESHOLDS.cacheHitP95WarnMs),\n372:     cacheHitP95PageMs: envNumber('SPECKIT_ADVISOR_HOOK_CACHE_HIT_P95_PAGE_MS', DEFAULT_ALERT_THRESHOLDS.cacheHitP95PageMs),\n373:   };\n374: }\n375: \n376: /** Build a prompt-safe diagnostic record from hook execution metadata. */\n377: export function createAdvisorHookDiagnosticRecord(input: {\n378:   readonly runtime: AdvisorRuntime;\n379:   readonly status: AdvisorHookStatus;\n380:   readonly freshness: AdvisorHookFreshness;\n381:   readonly durationMs: number;\n382:   readonly cacheHit: boolean;\n383:   readonly errorCode?: unknown;\n384:   readonly errorDetails?: unknown;\n385:   readonly skillLabel?: string | null;\n386:   readonly generation?: number;\n387:   readonly emittedBytes?: number;\n388:   readonly directivesSuppressed?: boolean;\n389:   readonly timestamp?: string;\n390: }): AdvisorHookDiagnosticRecord {\n391:   const errorCode = normalizeErrorCode(input.errorCode);\n392:   const errorDetails = sanitizeDiagnosticText(input.errorDetails);\n393:   return {\n394:     timestamp: input.timestamp ?? new Date().toISOString(),\n395:     runtime: input.runtime,\n396:     status: input.status,\n397:     freshness: input.freshness,\n398:     durationMs: Math.max(0, Math.round(input.durationMs)),\n399:     cacheHit: input.cacheHit,\n400:     ...(errorCode ? { errorCode } : {}),\n401:     ...(errorDetails ? { errorDetails } : {}),\n402:     ...(input.skillLabel ? { skillLabel: input.skillLabel } : {}),\n403:     ...(typeof input.generation === 'number' ? { generation: input.generation } : {}),\n404:     ...(typeof input.emittedBytes === 'number' ? { emittedBytes: input.emittedBytes } : {}),\n405:     ...(typeof input.directivesSuppressed === 'boolean' ? { directivesSuppressed: input.directivesSuppressed } : {}),\n406:   };\n407: }\n408: \n409: /** Validate that a diagnostic record matches the prompt-free closed schema. */\n410: export function validateAdvisorHookDiagnosticRecord(value: unknown): value is AdvisorHookDiagnosticRecord {\n411:   if (typeof value !== 'object' || value === null || Array.isArray(value)) {\n412:     return false;\n413:   }\n414:   const record = value as Record<string, unknown>;\n415:   if ([...FORBIDDEN_DIAGNOSTIC_FIELDS].some((field) => field in record)) {\n416:     return false;\n417:   }\n418:   return typeof record.timestamp === 'string'\n419:     && enumIncludes(ADVISOR_RUNTIME_VALUES, record.runtime)\n420:     && enumIncludes(ADVISOR_HOOK_STATUS_VALUES, record.status)\n421:     && enumIncludes(ADVISOR_HOOK_FRESHNESS_VALUES, record.freshness)\n422:     && typeof record.durationMs === 'number'\n423:     && typeof record.cacheHit === 'boolean'\n424:     && (record.errorCode === undefined || enumIncludes(ADVISOR_ERROR_CODE_VALUES, record.errorCode))\n425:     && (record.errorDetails === undefined || typeof record.errorDetails === 'string')\n426:     && (record.skillLabel === undefined || typeof record.skillLabel === 'string')\n427:     && (record.generation === undefined || typeof record.generation === 'number')\n428:     && (record.emittedBytes === undefined\n429:       || (typeof record.emittedBytes === 'number'\n430:         && Number.isInteger(record.emittedBytes)\n431:         && record.emittedBytes >= 0))\n432:     && (record.directivesSuppressed === undefined || typeof record.directivesSuppressed === 'boolean');\n433: }\n434: \n435: /** Serialize a validated diagnostic record for JSONL emission. */\n436: export function serializeAdvisorHookDiagnosticRecord(record: AdvisorHookDiagnosticRecord): string {\n437:   if (!validateAdvisorHookDiagnosticRecord(record)) {\n438:     throw new Error(\n439:       `AdvisorHookDiagnosticRecord: expected prompt-free closed-schema diagnostic record; actual ${typeof record}.`,\n440:     );\n441:   }\n442:   return JSON.stringify(record);\n443: }\n444: \n445: export async function persistAdvisorHookDiagnosticRecord(\n446:   workspaceRoot: string,\n447:   record: AdvisorHookDiagnosticRecord,\n448: ): Promise<string> {\n449:   const path = durableMetricsPath(workspaceRoot, 'diagnostics');\n450:   await writeBoundedJsonl(path, serializeAdvisorHookDiagnosticRecord(record), MAX_DURABLE_DIAGNOSTIC_RECORDS);\n451:   return path;\n452: }\n453: \n454: export function readAdvisorHookDiagnosticRecords(\n455:   workspaceRoot: string,\n456:   limit = MAX_DURABLE_DIAGNOSTIC_RECORDS,\n457: ): AdvisorHookDiagnosticRecord[] {\n458:   return readJsonlLines(durableMetricsPath(workspaceRoot, 'diagnostics'))\n459:     .slice(-limit)\n460:     .map((line) => JSON.parse(line) as unknown)\n461:     .filter(validateAdvisorHookDiagnosticRecord);\n462: }\n463: \n464: /** Build the rolling health section shown in advisor observability output. */\n465: export function buildAdvisorHookHealthSection(\n466:   records: readonly AdvisorHookDiagnosticRecord[],\n467: ): AdvisorHookHealthSection {\n468:   const lastInvocations = records.slice(-MAX_HEALTH_RECORDS);\n469:   const cacheHits = lastInvocations.filter((record) => record.cacheHit).length;\n470:   const failOpen = lastInvocations.filter((record) => record.status === 'fail_open').length;\n471:   return {\n472:     key: 'advisor-hook-health',\n473:     lastInvocations,\n474:     rollingCacheHitRate: lastInvocations.length > 0 ? cacheHits / lastInvocations.length : 0,\n475:     rollingP95Ms: percentile(\n476:       lastInvocations.filter((record) => record.cacheHit).map((record) => record.durationMs),\n477:       95,\n478:     ),\n479:     rollingFailOpenRate: lastInvocations.length > 0 ? failOpen / lastInvocations.length : 0,\n480:   };\n481: }\n482: \n483: export function readAdvisorHookHealthSection(workspaceRoot: string): AdvisorHookHealthSection {\n484:   return buildAdvisorHookHealthSection(readAdvisorHookDiagnosticRecords(workspaceRoot));\n485: }\n486: \n487: export function advisorHookDiagnosticsPath(workspaceRoot: string): string {\n488:   return durableMetricsPath(workspaceRoot, 'diagnostics');\n489: }\n490: \n491: // Persists only sanitized skill labels + the accept/correct/ignore signal,\n492: // never the prompt or scenario — deliberate prompt-safety. Real misroutes\n493: // therefore cannot be reconstructed into gold cases from this telemetry; that\n494: // is an accepted capability tradeoff, not an omission to fix by capturing\n495: // prompts (which would breach the prompt-safety invariant).\n496: export function createAdvisorHookOutcomeRecord(input: {\n497:   readonly runtime: AdvisorRuntime;\n498:   readonly outcome: AdvisorOutcome;\n499:   readonly skillLabel: string;\n500:   readonly correctedSkillLabel?: string | null;\n501:   readonly timestamp?: string;\n502: }): AdvisorHookOutcomeRecord {\n503:   return {\n504:     timestamp: input.timestamp ?? new Date().toISOString(),\n505:     runtime: input.runtime,\n506:     outcome: input.outcome,\n507:     skillLabel: sanitizeSkillLabel(input.skillLabel) ?? 'unknown-skill',\n508:     ...(sanitizeSkillLabel(input.correctedSkillLabel) ? { correctedSkillLabel: sanitizeSkillLabel(input.correctedSkillLabel) } : {}),\n509:   };\n510: }\n511: \n512: export function validateAdvisorHookOutcomeRecord(value: unknown): value is AdvisorHookOutcomeRecord {\n513:   if (typeof value !== 'object' || value === null || Array.isArray(value)) {\n514:     return false;\n515:   }\n516:   const record = value as Record<string, unknown>;\n517:   return typeof record.timestamp === 'string'\n518:     && enumIncludes(ADVISOR_RUNTIME_VALUES, record.runtime)\n519:     && (record.outcome === 'accepted' || record.outcome === 'corrected' || record.outcome === 'ignored')\n520:     && typeof record.skillLabel === 'string'\n521:     && (record.correctedSkillLabel === undefined || typeof record.correctedSkillLabel === 'string');\n522: }\n523: \n524: export async function persistAdvisorHookOutcomeRecord(\n525:   workspaceRoot: string,\n526:   record: AdvisorHookOutcomeRecord,\n527: ): Promise<string> {\n528:   const path = durableMetricsPath(workspaceRoot, 'outcomes');\n529:   await writeBoundedJsonl(path, JSON.stringify(record), MAX_DURABLE_OUTCOME_RECORDS, { requireDebug: false });\n530:   return path;\n531: }\n532: \n533: export function readAdvisorHookOutcomeRecords(\n534:   workspaceRoot: string,\n535:   limit = MAX_DURABLE_OUTCOME_RECORDS,\n536: ): AdvisorHookOutcomeRecord[] {\n537:   return readJsonlLines(durableMetricsPath(workspaceRoot, 'outcomes'))\n538:     .slice(-limit)\n539:     .map((line) => tryParseJsonLine(line))\n540:     .filter(validateAdvisorHookOutcomeRecord);\n541: }\n542: \n543: export function summarizeAdvisorHookOutcomeRecords(\n544:   workspaceRoot: string,\n545: ): AdvisorHookOutcomeSummary {\n546:   const records = readAdvisorHookOutcomeRecords(workspaceRoot);\n547:   const totals = {\n548:     accepted: records.filter((record) => record.outcome === 'accepted').length,\n549:     corrected: records.filter((record) => record.outcome === 'corrected').length,\n550:     ignored: records.filter((record) => record.outcome === 'ignored').length,\n551:   };\n552:   return { records, totals };\n553: }\n554: \n555: export function advisorHookOutcomesPath(workspaceRoot: string): string {\n556:   return durableMetricsPath(workspaceRoot, 'outcomes');\n557: }\n558: \n559: // Mirrors createAdvisorHookOutcomeRecord but for execution success, not\n560: // recommendation acceptance. Persistence lives in the skill-outcome store, not\n561: // here, so the acceptance write-path (debug-gated, bounded) is left untouched.\n562: export function createSkillExecutionOutcomeRecord(input: {\n563:   readonly runtime: AdvisorRuntime;\n564:   readonly skillId: string;\n565:   readonly success: boolean;\n566:   readonly eventId: string;\n567:   readonly failureMode?: string | null;\n568:   readonly contextTags?: readonly string[] | null;\n569:   readonly timestamp?: string;\n570: }): SkillExecutionOutcomeRecord {\n571:   const timestamp = input.timestamp ?? new Date().toISOString();\n572:   const skillId = sanitizeSkillLabel(input.skillId) ?? 'unknown-skill';\n573:   const eventId = sanitizeSkillLabel(input.eventId) ?? `${skillId}:${timestamp}`;\n574:   const failureMode = sanitizeSkillLabel(input.failureMode);\n575:   const contextTags = sanitizeContextTags(input.contextTags);\n576:   return {\n577:     timestamp,\n578:     runtime: input.runtime,\n579:     skillId,\n580:     success: input.success === true,\n581:     eventId,\n582:     ...(failureMode ? { failureMode } : {}),\n583:     ...(contextTags.length > 0 ? { contextTags } : {}),\n584:   };\n585: }\n586: \n587: export function validateSkillExecutionOutcomeRecord(value: unknown): value is SkillExecutionOutcomeRecord {\n588:   if (typeof value !== 'object' || value === null || Array.isArray(value)) {\n589:     return false;\n590:   }\n591:   const record = value as Record<string, unknown>;\n592:   return typeof record.timestamp === 'string'\n593:     && enumIncludes(ADVISOR_RUNTIME_VALUES, record.runtime)\n594:     && typeof record.skillId === 'string'\n595:     && typeof record.success === 'boolean'\n596:     && typeof record.eventId === 'string'\n597:     && (record.failureMode === undefined || typeof record.failureMode === 'string')\n598:     && (record.contextTags === undefined\n599:       || (Array.isArray(record.contextTags) && record.contextTags.every((tag) => typeof tag === 'string')));\n600: }\n601: \n602: /** Small in-memory collector for advisor hook metrics and health snapshots. */\n603: export class AdvisorHookMetricsCollector {\n604:   private readonly records: AdvisorHookDiagnosticRecord[] = [];\n605: \n606:   record(record: AdvisorHookDiagnosticRecord): void {\n607:     if (!validateAdvisorHookDiagnosticRecord(record)) {\n608:       throw new Error(\n609:         `AdvisorHookDiagnosticRecord: expected prompt-free closed-schema diagnostic record; actual ${typeof record}.`,\n610:       );\n611:     }\n612:     this.records.push(record);\n613:   }\n614: \n615:   snapshot(): AdvisorHookMetricSnapshot {\n616:     return {\n617:       definitions: ADVISOR_HOOK_METRIC_DEFINITIONS,\n618:       records: [...this.records],\n619:     };\n620:   }\n621: \n622:   healthSection(): AdvisorHookHealthSection {\n623:     return buildAdvisorHookHealthSection(this.records);\n624:   }\n625: \n626:   reset(): void {\n627:     this.records.length = 0;\n628:   }\n629: }\n630: \n631: // ───────────────────────────────────────────────────────────────\n632: // 5. SPEC_KIT.* INSTRUMENTATION NAMESPACE\n633: // ───────────────────────────────────────────────────────────────\n634: // Adds 17 canonical `spec_kit.<group>.<metric_name>` metrics for code-graph,\n635: // scorer, freshness, and cross-cutting advisor surfaces. All emission paths\n636: // MUST be guarded by the SPECKIT_METRICS_ENABLED env var (default OFF).\n637: // Persistence is additive: definitions live alongside the existing\n638: // AdvisorHookMetricSnapshot, no rename or removal of existing fields.\n639: //\n640: // Lifecycle-promotion metrics are intentionally omitted because those fields\n641: // were removed upstream.\n642: \n643: export const SPECKIT_GRAPH_QUERY_MODES = ['outline', 'blast_radius', 'relationship'] as const;\n644: export const SPECKIT_GRAPH_OUTCOMES = ['success', 'error'] as const;\n645: export const SPECKIT_GRAPH_LANGUAGES = ['javascript', 'typescript', 'python', 'bash'] as const;\n646: export const SPECKIT_GRAPH_EDGE_TYPES = [\n647:   'CONTAINS', 'CALLS', 'IMPORTS', 'EXPORTS',\n648:   'EXTENDS', 'IMPLEMENTS', 'TESTED_BY',\n649:   'DECORATES', 'OVERRIDES', 'TYPE_OF',\n650: ] as const;\n651: export const SPECKIT_SCORER_LANES = [\n652:   'explicit_author', 'lexical', 'graph_causal', 'derived_generated', 'semantic_shadow',\n653: ] as const;\n654: export const SPECKIT_PROMPT_CACHE_LAYERS = ['exact', 'near_dup'] as const;\n655: export const SPECKIT_CONFIDENCE_BUCKETS = [0, 0.5, 0.7, 0.8, 0.9, 1.0] as const;\n656: \n657: export type SpeckitMetricName =\n658:   | 'spec_kit.graph.scan_duration_ms'\n659:   | 'spec_kit.graph.parse_duration_ms'\n660:   | 'spec_kit.graph.query_latency_ms'\n661:   | 'spec_kit.graph.query_cache_hits_total'\n662:   | 'spec_kit.graph.query_cache_misses_total'\n663:   | 'spec_kit.graph.edge_detection_total'\n664:   | 'spec_kit.graph.partial_persist_retries_total'\n665:   // Blast-radius compute / DB failure counter labelled with\n666:   // `code` (e.g. `compute_error`) so operators can distinguish failure\n667:   // modes in the failure-fallback path.\n668:   | 'spec_kit.graph.blast_radius_failure_total'\n669:   | 'spec_kit.scorer.lane_contribution'\n670:   | 'spec_kit.scorer.fusion_live_weight_share'\n671:   | 'spec_kit.scorer.primary_intent_bonus_applied_total'\n672:   | 'spec_kit.scorer.graph_conflict_demote_applied_total'\n673:   | 'spec_kit.scorer.confidence_brier_score'\n674:   | 'spec_kit.scorer.near_dup_cache_miss_total'\n675:   | 'spec_kit.freshness.state_transitions_total'\n676:   | 'spec_kit.freshness.source_signature_bumps_total'\n677:   | 'spec_kit.freshness.prompt_cache_hit_ratio'\n678:   | 'spec_kit.advisor.recommendation_emitted_total'\n679:   | 'spec_kit.advisor.recommendation_confidence_brackets';\n680: \n681: export const SPECKIT_METRIC_DEFINITIONS = [\n682:   // 6 code-graph metrics (#1-6)\n683:   { name: 'spec_kit.graph.scan_duration_ms', type: 'histogram', labels: ['outcome'] },\n684:   { name: 'spec_kit.graph.parse_duration_ms', type: 'histogram', labels: ['language', 'outcome'] },\n685:   { name: 'spec_kit.graph.query_latency_ms', type: 'histogram', labels: ['mode', 'freshness_state'] },\n686:   { name: 'spec_kit.graph.query_cache_hits_total', type: 'counter', labels: ['mode'] },\n687:   { name: 'spec_kit.graph.query_cache_misses_total', type: 'counter', labels: ['mode'] },\n688:   { name: 'spec_kit.graph.edge_detection_total', type: 'counter', labels: ['edge_type', 'runtime'] },\n689:   { name: 'spec_kit.graph.partial_persist_retries_total', type: 'counter', labels: [] },\n690:   // Blast-radius failure counter (compute_error / DB error /\n691:   // Etc.). Distinguishes a real compute failure from a legitimately empty\n692:   // Blast radius (which has no failureFallback at all).\n693:   { name: 'spec_kit.graph.blast_radius_failure_total', type: 'counter', labels: ['code'] },\n694:   // 5 scorer metrics (#7-11)\n695:   { name: 'spec_kit.scorer.lane_contribution', type: 'gauge', labels: ['lane', 'skill_id'] },\n696:   { name: 'spec_kit.scorer.fusion_live_weight_share', type: 'gauge', labels: ['lane'] },\n697:   { name: 'spec_kit.scorer.primary_intent_bonus_applied_total', type: 'counter', labels: ['skill_id'] },\n698:   { name: 'spec_kit.scorer.graph_conflict_demote_applied_total', type: 'counter', labels: ['skill_id'] },\n699:   { name: 'spec_kit.scorer.confidence_brier_score', type: 'histogram', labels: [] },\n700:   { name: 'spec_kit.scorer.near_dup_cache_miss_total', type: 'counter', labels: ['cache_layer'] },\n701:   // 3 freshness metrics (#12-14)\n702:   { name: 'spec_kit.freshness.state_transitions_total', type: 'counter', labels: ['from_state', 'to_state'] },\n703:   { name: 'spec_kit.freshness.source_signature_bumps_total', type: 'counter', labels: [] },\n704:   { name: 'spec_kit.freshness.prompt_cache_hit_ratio', type: 'gauge', labels: [] },\n705:   // 2 cross-cutting metrics (#15-16)\n706:   { name: 'spec_kit.advisor.recommendation_emitted_total', type: 'counter', labels: ['runtime', 'freshness_state'] },\n707:   { name: 'spec_kit.advisor.recommendation_confidence_brackets', type: 'histogram', labels: [] },\n708: ] as const satisfies readonly AdvisorMetricDefinition[];\n709: \n710: export interface SpeckitMetricSample {\n711:   readonly name: SpeckitMetricName;\n712:   readonly value: number;\n713:   readonly labels: Readonly<Record<string, string>>;\n714:   readonly timestamp: number;\n715: }\n716: \n717: /** Returns true iff SPECKIT_METRICS_ENABLED env var is set to 'true'. */\n718: export function isSpeckitMetricsEnabled(): boolean {\n719:   return process.env.SPECKIT_METRICS_ENABLED === 'true';\n720: }\n721: \n722: /** Stable ordered key for cardinality counting and gauge upserts. */\n723: function speckitSeriesKey(name: string, labels: Record<string, string>): string {\n724:   const ordered = Object.keys(labels).sort().map((key) => `${key}=${labels[key]}`).join(',');\n725:   return `${name}{${ordered}}`;\n726: }\n727: \n728: /**\n729:  * In-memory collector for the spec_kit.* metric namespace. Counters and\n730:  * gauges are keyed by stable label-set; histograms retain raw samples.\n731:  * Emission MUST be gated by isSpeckitMetricsEnabled() at the call site.\n732:  */\n733: export class SpeckitMetricsCollector {\n734:   private readonly counters = new Map<string, number>();\n735:   private readonly gauges = new Map<string, number>();\n736:   private readonly histograms = new Map<string, number[]>();\n737:   // Brier score accumulator: {sum, count} per series for the summary metric\n738:   private readonly brier = new Map<string, { sum: number; count: number }>();\n739:   // Prompt-cache hit-ratio accumulator (metric #14 derived from hits/misses)\n740:   private promptCacheHits = 0;\n741:   private promptCacheMisses = 0;\n742: \n743:   incrementCounter(name: SpeckitMetricName, labels: Record<string, string> = {}, by = 1): void {\n744:     const key = speckitSeriesKey(name, labels);\n745:     this.counters.set(key, (this.counters.get(key) ?? 0) + by);\n746:   }\n747: \n748:   setGauge(name: SpeckitMetricName, value: number, labels: Record<string, string> = {}): void {\n749:     const key = speckitSeriesKey(name, labels);\n750:     this.gauges.set(key, value);\n751:   }\n752: \n753:   recordHistogram(name: SpeckitMetricName, value: number, labels: Record<string, string> = {}): void {\n754:     const key = speckitSeriesKey(name, labels);\n755:     const bucket = this.histograms.get(key);\n756:     if (bucket) {\n757:       bucket.push(value);\n758:     } else {\n759:       this.histograms.set(key, [value]);\n760:     }\n761:   }\n762: \n763:   /** Record a single Brier-score observation; mean is exposed via snapshot. */\n764:   recordBrierScore(observation: number, labels: Record<string, string> = {}): void {\n765:     const key = speckitSeriesKey('spec_kit.scorer.confidence_brier_score', labels);\n766:     const acc = this.brier.get(key) ?? { sum: 0, count: 0 };\n767:     acc.sum += observation;\n768:     acc.count += 1;\n769:     this.brier.set(key, acc);\n770:     this.recordHistogram('spec_kit.scorer.confidence_brier_score', observation, labels);\n771:   }\n772: \n773:   /** Bump prompt-cache hit/miss tallies feeding metric #14. */\n774:   recordPromptCacheOutcome(outcome: 'hit' | 'miss'): void {\n775:     if (outcome === 'hit') {\n776:       this.promptCacheHits += 1;\n777:     } else {\n778:       this.promptCacheMisses += 1;\n779:     }\n780:     const total = this.promptCacheHits + this.promptCacheMisses;\n781:     const ratio = total > 0 ? this.promptCacheHits / total : 0;\n782:     this.setGauge('spec_kit.freshness.prompt_cache_hit_ratio', ratio);\n783:   }\n784: \n785:   /** Place a recommendation confidence in the closest fixed bucket boundary. */\n786:   recordConfidenceBracket(confidence: number): void {\n787:     const clamped = Math.max(0, Math.min(1, confidence));\n788:     this.recordHistogram('spec_kit.advisor.recommendation_confidence_brackets', clamped);\n789:   }\n790: \n791:   /** Returns the live unique-series count (cardinality meta-gauge). */\n792:   uniqueSeriesCount(): number {\n793:     return this.counters.size + this.gauges.size + this.histograms.size;\n794:   }\n795: \n796:   snapshot(): {\n797:     readonly definitions: readonly AdvisorMetricDefinition[];\n798:     readonly counters: ReadonlyMap<string, number>;\n799:     readonly gauges: ReadonlyMap<string, number>;\n800:     readonly histograms: ReadonlyMap<string, readonly number[]>;\n801:     readonly brierMean: ReadonlyMap<string, number>;\n802:     readonly metricsUniqueSeriesCount: number;\n803:   } {\n804:     const brierMean = new Map<string, number>();\n805:     for (const [key, acc] of this.brier) {\n806:       brierMean.set(key, acc.count > 0 ? acc.sum / acc.count : 0);\n807:     }\n808:     return {\n809:       definitions: SPECKIT_METRIC_DEFINITIONS,\n810:       counters: this.counters,\n811:       gauges: this.gauges,\n812:       histograms: this.histograms,\n813:       brierMean,\n814:       metricsUniqueSeriesCount: this.uniqueSeriesCount(),\n815:     };\n816:   }\n817: \n818:   reset(): void {\n819:     this.counters.clear();\n820:     this.gauges.clear();\n821:     this.histograms.clear();\n822:     this.brier.clear();\n823:     this.promptCacheHits = 0;\n824:     this.promptCacheMisses = 0;\n825:   }\n826: }\n827: \n828: /** Process-wide collector. Callers MUST gate emission with isSpeckitMetricsEnabled(). */\n829: export const speckitMetrics = new SpeckitMetricsCollector();\n830: \n831: /** Returns the static metric definitions for the spec_kit.* namespace. */\n832: export function getSpeckitMetricDefinitions(): readonly AdvisorMetricDefinition[] {\n833:   return SPECKIT_METRIC_DEFINITIONS;\n834: }"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/lib/metrics.ts\"}"},"time":{"start":1794540042485,"end":1794540042930}}}}
