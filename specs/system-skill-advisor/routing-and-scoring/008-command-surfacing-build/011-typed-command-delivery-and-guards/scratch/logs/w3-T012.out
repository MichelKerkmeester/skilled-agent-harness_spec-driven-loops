enceFloored?: boolean;\n175:   readonly redirectTo?: string;\n176:   readonly redirectFrom?: readonly string[];\n177:   readonly lifecycleStatus: SkillLifecycleStatus;\n178: }\n179: \n180: export interface AdvisorScoringOptions {\n181:   readonly workspaceRoot: string;\n182:   readonly projection?: AdvisorProjection;\n183:   readonly affordances?: readonly AffordanceInput[];\n184:   readonly confidenceThreshold?: number;\n185:   readonly uncertaintyThreshold?: number;\n186:   readonly includeAllCandidates?: boolean;\n187:   readonly disabledLanes?: readonly ScorerLane[];\n188:   readonly runtimeLaneHealth?: Partial<Record<ScorerLane, LaneRuntimeHealthSignal>>;\n189:   /**\n190:    * Optional scorer lane weights for one scoring call. Overrides are merged over\n191:    * the default vector without renormalizing; callers own sensible totals. The\n192:    * lane registry's `live` flag still gates contribution, so overriding a\n193:    * shadow-only lane's weight does not make it contribute.\n194:    */\n195:   readonly laneWeightsOverride?: Partial<Record<ScorerLane, number>>;\n196:   /**\n197:    * Optional per-call contribution damping. Overrides are merged over registry\n198:    * defaults. When a lane's raw score falls below `threshold`, fusion scales the\n199:    * lane's effective weight by `floor`.\n[Output truncated. Continue reading with offset: 200]","title":"read","metadata":{"metadata":{"truncated":true},"content":[{"type":"text","text":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/lib/scorer/types.ts, lines 140-199\n140: }\n141: \n142: export interface LaneDampingConfig {\n143:   readonly threshold: number;\n144:   readonly floor: number;\n145: }\n146: \n147: export interface LaneContribution {\n148:   readonly lane: ScorerLane;\n149:   readonly rawScore: number;\n150:   readonly weightedScore: number;\n151:   readonly weight: number;\n152:   readonly evidence: readonly strin