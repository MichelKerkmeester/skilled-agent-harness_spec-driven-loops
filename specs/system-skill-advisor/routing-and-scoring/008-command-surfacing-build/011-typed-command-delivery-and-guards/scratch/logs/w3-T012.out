{"type":"tool_use","timestamp":1794540306788,"sessionID":"ses_e2d114c1cffeCJAo2qUfV4UXZv","part":{"partID":"prt_1d2efffc2001PWoMwjyL9PqTHV","sessionID":"ses_e2d114c1cffeCJAo2qUfV4UXZv","messageID":"msg_1d2eff0c1001fwwufcZhbfkCxE","type":"tool","id":"call_1291c7eacdde4788922ad655","tool":"read","state":{"status":"completed","input":{"path":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/tests/scorer/typed-command-routing.vitest.ts"},"output":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/tests/scorer/typed-command-routing.vitest.ts, lines 1-145\n1: // ───────────────────────────────────────────────────────────────\n2: // MODULE: Typed Command Routing Tests\n3: // ───────────────────────────────────────────────────────────────\n4: // Two ways a typed slash command used to be turned against itself:\n5: // the graph lane lent the command's own match to a neighbour until the\n6: // neighbour outranked the command, and a mode suffix such as \":auto\" was read\n7: // as the content word \"auto\", matching any skill that mentions it.\n8: \n9: import { describe, expect, it } from 'vitest';\n10: import { boundGraphSupportBySeed, scoreAdvisorPrompt } from '../../lib/scorer/fusion.js';\n11: import { scoreLexicalLane } from '../../lib/scorer/lanes/lexical.js';\n12: import { createFixtureProjection } from '../../lib/scorer/projection.js';\n13: import { hasAdvisorAmbiguitySignal } from '../../lib/render.js';\n14: import { resultFromCliData } from '../../../hooks/lib/skill-advisor-cli-fallback.js';\n15: import type { SkillEdgeProjection, SkillProjection } from '../../lib/scorer/types.js';\n16: \n17: function skill(id: string, fields: Partial<SkillProjection> = {}): SkillProjection {\n18:   return {\n19:     id,\n20:     kind: 'skill',\n21:     family: 'system',\n22:     category: 'test',\n23:     name: id,\n24:     description: '',\n25:     keywords: [],\n26:     domains: [],\n27:     intentSignals: [],\n28:     derivedTriggers: [],\n29:     derivedKeywords: [],\n30:     sourcePath: `.skilled/skills/${id}/graph-metadata.json`,\n31:     lifecycleStatus: 'active',\n32:     ...fields,\n33:   };\n34: }\n35: \n36: // The dependency's own evidence is weaker than the seed's; the loan over these\n37: // two edges is what would carry it past the seed.\n38: const LOAN_EDGES: SkillEdgeProjection[] = [\n39:   { sourceId: 'loop-skill', targetId: 'dep-skill', edgeType: 'enhances', weight: 1 },\n40:   { sourceId: 'loop-skill', targetId: 'dep-skill', edgeType: 'depends_on', weight: 1 },\n41: ];\n42: \n43: function scoreFor(prompt: string, loopKeyword: string) {\n44:   const projection = createFixtureProjection([\n45:     skill('loop-skill', { keywords: [loopKeyword] }),\n46:     skill('dep-skill', { keywords: ['packet'], domains: ['routing'] }),\n47:   ], LOAN_EDGES);\n48:   return scoreAdvisorPrompt(prompt, {\n49:     workspaceRoot: process.cwd(),\n50:     projection,\n51:     includeAllCandidates: true,\n52:   });\n53: }\n54: \n55: function rankFor(prompt: string, loopKeyword: string): string[] {\n56:   return scoreFor(prompt, loopKeyword).recommendations.map((recommendation) => recommendation.skill);\n57: }\n58: \n59: describe('graph support lent by a typed slash command', () => {\n60:   it('cannot lift the dependency above the command that lent it', () => {\n61:     expect(rankFor('run /fixture:loop on the routing packet', '/fixture:loop').slice(0, 2))\n62:       .toEqual(['loop-skill', 'dep-skill']);\n63:   });\n64: \n65:   it('still lifts the dependency when the seed matched on plain words', () => {\n66:     expect(rankFor('run fixture loop on the routing packet', 'fixture loop').slice(0, 2))\n67:       .toEqual(['dep-skill', 'loop-skill']);\n68:   });\n69: \n70:   it('keeps a neighbour below a command that another command held down', () => {\n71:     // first lends to second, second lends to third; both commands were typed.\n72:     const bounded = boundGraphSupportBySeed(\n73:       new Map([['first', 0.7], ['second', 0.75], ['third', 0.8]]),\n74:       new Map([['second', 0.2], ['third', 0.3]]),\n75:       new Map([['second', new Map([['first', 0.2]])], ['third', new Map([['second', 0.3]])]]),\n76:       1,\n77:       new Set(['first', 'second']),\n78:     );\n79:     expect(bounded.get('second')).toBeLessThan(0.7);\n80:     expect(bounded.get('third')).toBeLessThan(bounded.get('second') ?? 0);\n81:   });\n82: });\n83: \n84: // The bound already ranked the pair from the user's own command, so the\n85: // one-millionth gap it leaves must not read as two skills tied on evidence.\n86: describe('a typed command is not ambiguous with the neighbour it held down', () => {\n87:   it('reports no ambiguity between the command and the dependency it bounded', () => {\n88:     const result = scoreFor('run /fixture:loop on the routing packet', '/fixture:loop');\n89:     const [top, second] = result.recommendations;\n90:     expect(top?.skill).toBe('loop-skill');\n91:     expect(second?.skill).toBe('dep-skill');\n92:     expect(second?.heldBelow).toBe('loop-skill');\n93:     expect(top?.ambiguousWith ?? []).not.toContain('dep-skill');\n94:     expect(result.ambiguous).toBe(false);\n95:   });\n96: \n97:   it('keeps the plain-word pair ambiguous, since no command ranked it', () => {\n98:     const result = scoreFor('run fixture loop on the routing packet', 'fixture loop');\n99:     expect(result.recommendations.some((recommendation) => recommendation.heldBelow)).toBe(false);\n100:     expect(result.ambiguous).toBe(true);\n101:   });\n102: \n103:   it('keeps the held-below mark through the serialized brief paths', () => {\n104:     const tied = [\n105:       { skill: 'loop-skill', confidence: 0.82, uncertainty: 0.2, passes_threshold: true, score: 0.4896 },\n106:       { skill: 'dep-skill', confidence: 0.82, uncertainty: 0.2, passes_threshold: true, score: 0.489599 },\n107:     ];\n108:     expect(hasAdvisorAmbiguitySignal(tied)).toBe(true);\n109:     const held = [tied[0]!, { ...tied[1]!, heldBelow: 'loop-skill' }];\n110:     expect(hasAdvisorAmbiguitySignal(held)).toBe(false);\n111: \n112:     const fromCli = resultFromCliData({\n113:       data: {\n114:         freshness: 'live',\n115:         ambiguous: false,\n116:         recommendations: [\n117:           { skillId: 'loop-skill', score: 0.4896, confidence: 0.82, uncertainty: 0.2 },\n118:           { skillId: 'dep-skill', score: 0.489599, confidence: 0.82, uncertainty: 0.2, heldBelow: 'loop-skill' },\n119:         ],\n120:       } as never,\n121:       options: { maxTokens: 80 } as never,\n122:       startedAt: 0,\n123:       now: () => 1,\n124:     });\n125:     expect(hasAdvisorAmbiguitySignal(fromCli.recommendations)).toBe(false);\n126:   });\n127: });\n128: \n129: describe('command mode suffixes are not prompt content', () => {\n130:   const projection = createFixtureProjection([\n131:     skill('loop-skill', { keywords: ['/fixture:loop'] }),\n132:     skill('repair-skill', { intentSignals: ['draft auto-repair'] }),\n133:   ], []);\n134:   const lexicalFor = (prompt: string) => scoreLexicalLane(prompt, projection)\n135:     .find((match) => match.skillId === 'repair-skill');\n136: \n137:   it('gives no lexical credit for a detached or attached mode suffix', () => {\n138:     expect(lexicalFor('/fixture:loop :auto on it')).toBeUndefined();\n139:     expect(lexicalFor('/fixture:loop:confirm on it')).toBeUndefined();\n140:   });\n141: \n142:   it('keeps \"auto\" as content when no command precedes it', () => {\n143:     expect(lexicalFor('the draft auto-repair rewrote my files')?.evidence).toContain('token:auto');\n144:   });\n145: });","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/tests/scorer/typed-command-routing.vitest.ts, lines 1-145\n1: // ───────────────────────────────────────────────────────────────\n2: // MODULE: Typed Command Routing Tests\n3: // ───────────────────────────────────────────────────────────────\n4: // Two ways a typed slash command used to be turned against itself:\n5: // the graph lane lent the command's own match to a neighbour until the\n6: // neighbour outranked the command, and a mode suffix such as \":auto\" was read\n7: // as the content word \"auto\", matching any skill that mentions it.\n8: \n9: import { describe, expect, it } from 'vitest';\n10: import { boundGraphSupportBySeed, scoreAdvisorPrompt } from '../../lib/scorer/fusion.js';\n11: import { scoreLexicalLane } from '../../lib/scorer/lanes/lexical.js';\n12: import { createFixtureProjection } from '../../lib/scorer/projection.js';\n13: import { hasAdvisorAmbiguitySignal } from '../../lib/render.js';\n14: import { resultFromCliData } from '../../../hooks/lib/skill-advisor-cli-fallback.js';\n15: import type { SkillEdgeProjection, SkillProjection } from '../../lib/scorer/types.js';\n16: \n17: function skill(id: string, fields: Partial<SkillProjection> = {}): SkillProjection {\n18:   return {\n19:     id,\n20:     kind: 'skill',\n21:     family: 'system',\n22:     category: 'test',\n23:     name: id,\n24:     description: '',\n25:     keywords: [],\n26:     domains: [],\n27:     intentSignals: [],\n28:     derivedTriggers: [],\n29:     derivedKeywords: [],\n30:     sourcePath: `.skilled/skills/${id}/graph-metadata.json`,\n31:     lifecycleStatus: 'active',\n32:     ...fields,\n33:   };\n34: }\n35: \n36: // The dependency's own evidence is weaker than the seed's; the loan over these\n37: // two edges is what would carry it past the seed.\n38: const LOAN_EDGES: SkillEdgeProjection[] = [\n39:   { sourceId: 'loop-skill', targetId: 'dep-skill', edgeType: 'enhances', weight: 1 },\n40:   { sourceId: 'loop-skill', targetId: 'dep-skill', edgeType: 'depends_on', weight: 1 },\n41: ];\n42: \n43: function scoreFor(prompt: string, loopKeyword: string) {\n44:   const projection = createFixtureProjection([\n45:     skill('loop-skill', { keywords: [loopKeyword] }),\n46:     skill('dep-skill', { keywords: ['packet'], domains: ['routing'] }),\n47:   ], LOAN_EDGES);\n48:   return scoreAdvisorPrompt(prompt, {\n49:     workspaceRoot: process.cwd(),\n50:     projection,\n51:     includeAllCandidates: true,\n52:   });\n53: }\n54: \n55: function rankFor(prompt: string, loopKeyword: string): string[] {\n56:   return scoreFor(prompt, loopKeyword).recommendations.map((recommendation) => recommendation.skill);\n57: }\n58: \n59: describe('graph support lent by a typed slash command', () => {\n60:   it('cannot lift the dependency above the command that lent it', () => {\n61:     expect(rankFor('run /fixture:loop on the routing packet', '/fixture:loop').slice(0, 2))\n62:       .toEqual(['loop-skill', 'dep-skill']);\n63:   });\n64: \n65:   it('still lifts the dependency when the seed matched on plain words', () => {\n66:     expect(rankFor('run fixture loop on the routing packet', 'fixture loop').slice(0, 2))\n67:       .toEqual(['dep-skill', 'loop-skill']);\n68:   });\n69: \n70:   it('keeps a neighbour below a command that another command held down', () => {\n71:     // first lends to second, second lends to third; both commands were typed.\n72:     const bounded = boundGraphSupportBySeed(\n73:       new Map([['first', 0.7], ['second', 0.75], ['third', 0.8]]),\n74:       new Map([['second', 0.2], ['third', 0.3]]),\n75:       new Map([['second', new Map([['first', 0.2]])], ['third', new Map([['second', 0.3]])]]),\n76:       1,\n77:       new Set(['first', 'second']),\n78:     );\n79:     expect(bounded.get('second')).toBeLessThan(0.7);\n80:     expect(bounded.get('third')).toBeLessThan(bounded.get('second') ?? 0);\n81:   });\n82: });\n83: \n84: // The bound already ranked the pair from the user's own command, so the\n85: // one-millionth gap it leaves must not read as two skills tied on evidence.\n86: describe('a typed command is not ambiguous with the neighbour it held down', () => {\n87:   it('reports no ambiguity between the command and the dependency it bounded', () => {\n88:     const result = scoreFor('run /fixture:loop on the routing packet', '/fixture:loop');\n89:     const [top, second] = result.recommendations;\n90:     expect(top?.skill).toBe('loop-skill');\n91:     expect(second?.skill).toBe('dep-skill');\n92:     expect(second?.heldBelow).toBe('loop-skill');\n93:     expect(top?.ambiguousWith ?? []).not.toContain('dep-skill');\n94:     expect(result.ambiguous).toBe(false);\n95:   });\n96: \n97:   it('keeps the plain-word pair ambiguous, since no command ranked it', () => {\n98:     const result = scoreFor('run fixture loop on the routing packet', 'fixture loop');\n99:     expect(result.recommendations.some((recommendation) => recommendation.heldBelow)).toBe(false);\n100:     expect(result.ambiguous).toBe(true);\n101:   });\n102: \n103:   it('keeps the held-below mark through the serialized brief paths', () => {\n104:     const tied = [\n105:       { skill: 'loop-skill', confidence: 0.82, uncertainty: 0.2, passes_threshold: true, score: 0.4896 },\n106:       { skill: 'dep-skill', confidence: 0.82, uncertainty: 0.2, passes_threshold: true, score: 0.489599 },\n107:     ];\n108:     expect(hasAdvisorAmbiguitySignal(tied)).toBe(true);\n109:     const held = [tied[0]!, { ...tied[1]!, heldBelow: 'loop-skill' }];\n110:     expect(hasAdvisorAmbiguitySignal(held)).toBe(false);\n111: \n112:     const fromCli = resultFromCliData({\n113:       data: {\n114:         freshness: 'live',\n115:         ambiguous: false,\n116:         recommendations: [\n117:           { skillId: 'loop-skill', score: 0.4896, confidence: 0.82, uncertainty: 0.2 },\n118:           { skillId: 'dep-skill', score: 0.489599, confidence: 0.82, uncertainty: 0.2, heldBelow: 'loop-skill' },\n119:         ],\n120:       } as never,\n121:       options: { maxTokens: 80 } as never,\n122:       startedAt: 0,\n123:       now: () => 1,\n124:     });\n125:     expect(hasAdvisorAmbiguitySignal(fromCli.recommendations)).toBe(false);\n126:   });\n127: });\n128: \n129: describe('command mode suffixes are not prompt content', () => {\n130:   const projection = createFixtureProjection([\n131:     skill('loop-skill', { keywords: ['/fixture:loop'] }),\n132:     skill('repair-skill', { intentSignals: ['draft auto-repair'] }),\n133:   ], []);\n134:   const lexicalFor = (prompt: string) => scoreLexicalLane(prompt, projection)\n135:     .find((match) => match.skillId === 'repair-skill');\n136: \n137:   it('gives no lexical credit for a detached or attached mode suffix', () => {\n138:     expect(lexicalFor('/fixture:loop :auto on it')).toBeUndefined();\n139:     expect(lexicalFor('/fixture:loop:confirm on it')).toBeUndefined();\n140:   });\n141: \n142:   it('keeps \"auto\" as content when no command precedes it', () => {\n143:     expect(lexicalFor('the draft auto-repair rewrote my files')?.evidence).toContain('token:auto');\n144:   });\n145: });"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/tests/scorer/typed-command-routing.vitest.ts\"}"},"time":{"start":1794540306370,"end":1794540306788}}}}
