ride?: Partial<Record<ScorerLane, number>>;\n196:   /**\n197:    * Optional per-call contribution damping. Overrides are merged over registry\n198:    * defaults. When a lane's raw score falls below `threshold`, fusion scales the\n199:    * lane's effective weight by `floor`.\n[Output truncated. Continue reading with offset: 200]"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"limit\":60,\"offset\":140,\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/lib/scorer/types.ts\"}"},"time":{"start":1794540310222,"end":1794540311594}}}}
