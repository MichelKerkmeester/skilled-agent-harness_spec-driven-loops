{"type":"tool_use","timestamp":1794540373973,"sessionID":"ses_e2d114c1cffeCJAo2qUfV4UXZv","part":{"partID":"prt_1d2f0f5ea002ZEmfZC0EmciOJB","sessionID":"ses_e2d114c1cffeCJAo2qUfV4UXZv","messageID":"msg_1d2f0bbad001J1803yhhTYDx86","type":"tool","id":"call_9b9973de5bc34108aa314e82","tool":"write","state":{"status":"completed","input":{"path":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/tests/scorer/typed-command-owner.vitest.ts","content":"// ───────────────────────────────────────────────────────────────\n// MODULE: Typed Command Owner Tests\n// ───────────────────────────────────────────────────────────────\n// A typed command that has no scorer row of its own is invisible to the scorer,\n// so the only path from the prompt to the command runs through the skill that\n// owns it. These cases pin that the owner leads, and that every other ordering\n// rule still decides the list.\n\nimport { describe, expect, it } from 'vitest';\nimport { rankTypedCommandOwnerFirst } from '../../lib/scorer/fusion.js';\nimport type { AdvisorScoredRecommendation } from '../../lib/scorer/types.js';\n\nfunction recommendation(\n  skill: string,\n  overrides: Partial<AdvisorScoredRecommendation> = {},\n): AdvisorScoredRecommendation {\n  return {\n    skill,\n    kind: 'skill',\n    confidence: 0.9,\n    uncertainty: 0.1,\n    passes_threshold: true,\n    reason: '',\n    score: 1,\n    laneContributions: [],\n    dominantLane: null,\n    lifecycleStatus: 'active',\n    ...overrides,\n  };\n}\n\nfunction rankedSkills(\n  ranked: readonly AdvisorScoredRecommendation[],\n  promptLower: string,\n): string[] {\n  return rankTypedCommandOwnerFirst(ranked, promptLower).map((entry) => entry.skill);\n}\n\ndescribe('a typed command without a scorer row leads through its owner', () => {\n  it('moves the passing owner to the front and keeps the rest in order', () => {\n    const ranked = [\n      recommendation('sk-code'),\n      recommendation('sk-doc'),\n      recommendation('sk-prompt'),\n    ];\n    expect(rankedSkills(ranked, '/create:goal x')).toEqual(['sk-doc', 'sk-code', 'sk-prompt']);\n  });\n\n  it('keeps the order when the owner does not pass the threshold', () => {\n    const ranked = [\n      recommendation('sk-code'),\n      recommendation('sk-doc', { passes_threshold: false }),\n    ];\n    expect(rankedSkills(ranked, '/create:goal x')).toEqual(['sk-code', 'sk-doc']);\n  });\n\n  it('keeps the order when the typed command has a scorer row', () => {\n    const ranked = [\n      recommendation('sk-code'),\n      recommendation('system-spec-kit'),\n    ];\n    expect(rankedSkills(ranked, '/speckit:save x')).toEqual(['sk-code', 'system-spec-kit']);\n  });\n\n  it('keeps the order when the prompt types no command', () => {\n    const ranked = [\n      recommendation('sk-code'),\n      recommendation('sk-doc'),\n    ];\n    expect(rankedSkills(ranked, 'create a goal for the utils folder')).toEqual(['sk-code', 'sk-doc']);\n  });\n});\n"},"output":"Created file successfully: .skilled/skills/system-skill-advisor/runtime/tests/scorer/typed-command-owner.vitest.ts","title":"write","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Created file successfully: .skilled/skills/system-skill-advisor/runtime/tests/scorer/typed-command-owner.vitest.ts"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/tests/scorer/typed-command-owner.vitest.ts\",\"content\":\"// ───────────────────────────────────────────────────────────────\\n// MODULE: Typed Command Owner Tests\\n// ───────────────────────────────────────────────────────────────\\n// A typed command that has no scorer row of its own is invisible to the scorer,\\n// so the only path from the prompt to the command runs through the skill that\\n// owns it. These cases pin that the owner leads, and that every other ordering\\n// rule still decides the list.\\n\\nimport { describe, expect, it } from 'vitest';\\nimport { rankTypedCommandOwnerFirst } from '../../lib/scorer/fusion.js';\\nimport type { AdvisorScoredRecommendation } from '../../lib/scorer/types.js';\\n\\nfunction recommendation(\\n  skill: string,\\n  overrides: Partial<AdvisorScoredRecommendation> = {},\\n): AdvisorScoredRecommendation {\\n  return {\\n    skill,\\n    kind: 'skill',\\n    confidence: 0.9,\\n    uncertainty: 0.1,\\n    passes_threshold: true,\\n    reason: '',\\n    score: 1,\\n    laneContributions: [],\\n    dominantLane: null,\\n    lifecycleStatus: 'active',\\n    ...overrides,\\n  };\\n}\\n\\nfunction rankedSkills(\\n  ranked: readonly AdvisorScoredRecommendation[],\\n  promptLower: string,\\n): string[] {\\n  return rankTypedCommandOwnerFirst(ranked, promptLower).map((entry) => entry.skill);\\n}\\n\\ndescribe('a typed command without a scorer row leads through its owner', () => {\\n  it('moves the passing owner to the front and keeps the rest in order', () => {\\n    const ranked = [\\n      recommendation('sk-code'),\\n      recommendation('sk-doc'),\\n      recommendation('sk-prompt'),\\n    ];\\n    expect(rankedSkills(ranked, '/create:goal x')).toEqual(['sk-doc', 'sk-code', 'sk-prompt']);\\n  });\\n\\n  it('keeps the order when the owner does not pass the threshold', () => {\\n    const ranked = [\\n      recommendation('sk-code'),\\n      recommendation('sk-doc', { passes_threshold: false }),\\n    ];\\n    expect(rankedSkills(ranked, '/create:goal x')).toEqual(['sk-code', 'sk-doc']);\\n  });\\n\\n  it('keeps the order when the typed command has a scorer row', () => {\\n    const ranked = [\\n      recommendation('sk-code'),\\n      recommendation('system-spec-kit'),\\n    ];\\n    expect(rankedSkills(ranked, '/speckit:save x')).toEqual(['sk-code', 'system-spec-kit']);\\n  });\\n\\n  it('keeps the order when the prompt types no command', () => {\\n    const ranked = [\\n      recommendation('sk-code'),\\n      recommendation('sk-doc'),\\n    ];\\n    expect(rankedSkills(ranked, 'create a goal for the utils folder')).toEqual(['sk-code', 'sk-doc']);\\n  });\\n});\\n\"}"},"time":{"start":1794540369386,"end":1794540373973}}}}
