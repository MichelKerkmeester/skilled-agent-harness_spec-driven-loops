:     }\n275:   }\n276:   return found;\n277: }\n278: \n279: // A typed command travels on the recommendation that leads, so it is delivered\n280: // only when the leading skill owns the command or carries the same command row.\n281: // A leading skill unrelated to the command must not carry it.\n282: export interface TypedCommand {\n283:   readonly command: string;\n284:   readonly policy: 'run' | 'start' | 'ask';\n285:   readonly ownerSkillId: string;\n286: }\n287: \n288: export function typedCommandForTop(topSkillId: string, prompt: string): TypedCommand | undefined {\n289:   const command = typedCommandIn(prompt);\n290:   if (command === undefined || !Object.hasOwn(TRACKED_COMMANDS, command)) return undefined;\n291:   const row = TRACKED_COMMANDS[command];\n292:   const sameCommandRow = commandRowFor(topSkillId)?.command === command;\n293:   if (topSkillId !== row.ownerSkillId && !sameCommandRow) return undefined;\n294:   return { command, policy: row.policy, ownerSkillId: row.ownerSkillId };\n295: }\n296: \n297: // Deep-loop commands open a long, multi-pass run, so one attached to a prompt\n298: // that merely mentions the topic spends the reader's budget on work they never\n299: // asked for. The list below is the vocabulary that counts as asking for it, and\n[Output truncated. Continue reading with offset: 300]","title":"read","metadata":{"metadata":{"truncated":true},"content":[{"type":"text","text":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/lib/command-attach.ts, lines 250-299\n250: \n251: // A typed command is the reader's own wording, so it counts only where a command\n252: // can start and where it ends on a boundary. That keeps a path such as\n253: // `docs/create:goal.md` and a prefix such as `/create:sk` from reading as a\n254: // command, and the longest key wins so `/create:skill-parent` is never reduced to\n255: // its `/create:skill` prefix.\n256: const COMMAND_S