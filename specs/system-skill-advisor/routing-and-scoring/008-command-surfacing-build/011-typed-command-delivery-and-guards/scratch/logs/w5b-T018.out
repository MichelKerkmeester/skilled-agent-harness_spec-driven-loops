g-research/.skilled/skills/sk-doc/ROUTER.md:\n  Line 26: (sk-create-skill, sk-create-skill-parent, sk-create-readme, sk-create-agent, sk-create-command,\n\n  Line 252:         \"sk-create-readme/references/README.md\",\n\n  Line 253:         \"sk-create-readme/assets/readme-template.md\"\n\n  Line 367:         \"sk-create-readme/assets/architecture-template.md\",\n\n  Line 368:         \"sk-create-readme/assets/readme-code-template.md\",\n\n  Line 369:         \"sk-create-readme/assets/readme-template.md\",\n\n  Line 370:         \"sk-create-readme/references/README.md\",\n\n  Line 371:         \"sk-create-readme/references/readme/quality-and-checklist.md\",\n\n  Line 372:         \"sk-create-readme/references/readme/types-and-voice.md\",\n\n  Line 373:         \"sk-create-readme/references/readme/writing-patterns.md\",\n\n  Line 472:     \"Confirm whether this is sk-create-skill, sk-create-skill-parent, sk-create-readme, sk-create-agent, sk-create-command, sk-create-feature-catalog, sk-create-manual-testing-playbook, sk-create-benchmark, sk-create-changelog, sk-create-diff, sk-create-repo-rule, sk-create-frontmatter, sk-create-goal, sk-create-with-human-voice, or sk-create-quality-control work\",\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/sk-doc/ROUTER.md\",\"pattern\":\"code README|readme leaves|sk-create-readme\"}"},"time":{"start":1794540844946,"end":1794540845487}}}}
