nts in the split\n326: // total without inventing a family for itself.\n327: function attachedFamilyTally(byFamily, command) {\n328:   const namespace = commandNamespace(command);\n329:   if (namespace === null) return undefined;\n330:   if (!byFamily.has(namespace)) {\n331:     byFamily.set(namespace, { tune: emptyAttachedTally(), holdout: emptyAttachedTally() });\n332:   }\n333:   return byFamily.get(namespace);\n334: }\n335: \n336: function readHeadSha(workspaceRoot) {\n337:   const spawned = spawnSync('git', ['rev-parse', '--short', 'HEAD'], { cwd: workspaceRoot, encoding: 'utf8' });\n338:   return spawned.status === 0 ? spawned.stdout.trim() : 'unknown';\n339: }\n340: \n341: // ───────────────────────────────────────────────────────────────────\n342: // 6. CORE LOGIC\n343: // ───────────────────────────────────────────────────────────────────\n344: \n345: export async function scoreCommandCorpus(options = {}) {\n346:   const realEmbedding = options.realEmbedding === true;\n347:   const RealDate = Date;\n[Output truncated. Continue reading with offset: 348]","title":"read","metadata":{"metadata":{"truncated":true},"content":[{"type":"text","text":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/capture-command-routing-baseline.mjs, lines 298-347\n298: \n299: // Attached reach is kept apart from bridge reach and only ever counts a row the\n300: // ranked bridge did not already land, so `own` and `attached` partition the rows\n301: // and their sum is real reach rather than one row claimed twice.\n302: function emptyAttachedTally() {\n303:   return { own: 0, attached: 0, total: 0 };\n304: }\n305: \n306: function addAttachedRow(tally, ownHit, attachedHit) {\n307:   tally.total += 1;\n308:   if (ownHit) tally.own += 1;\n309:   if (attachedHit) tally.attached += 1;\n310: }\n311: \n312: function attachedTallyJson(tally) {\n313:   return { own: tally.own, attached: 