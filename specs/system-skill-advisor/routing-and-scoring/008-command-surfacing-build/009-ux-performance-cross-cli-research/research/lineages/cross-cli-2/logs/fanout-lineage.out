\",\\n    \\\"parentSessionId\\\": null,\\n    \\\"lineageMode\\\": \\\"new\\\",\\n    \\\"allowedModes\\\": [\\n      \\\"new\\\",\\n      \\\"resume\\\",\\n      \\\"restart\\\"\\n    ],\\n    \\\"deferredModes\\\": [\\n      \\\"fork\\\",\\n      \\\"completed-continue\\\"\\n    ],\\n    \\\"generation\\\": 1,\\n    \\\"continuedFromRun\\\": null\\n  },\\n  \\\"reducer\\\": {\\n    \\\"enabled\\\": true,\\n    \\\"version\\\": \\\"1.0\\\",\\n    \\\"registryFile\\\": \\\"findings-registry.json\\\",\\n    \\\"dashboardFile\\\": \\\"deep-research-dashboard.md\\\",\\n    \\\"strategyFile\\\": \\\"deep-research-strategy.md\\\",\\n    \\\"machineOwnedSections\\\": [\\n      \\\"key-questions\\\",\\n      \\\"answered-questions\\\",\\n      \\\"what-worked\\\",\\n      \\\"what-failed\\\",\\n      \\\"exhausted-approaches\\\",\\n      \\\"ruled-out-directions\\\",\\n      \\\"divergence-frontier\\\",\\n      \\\"next-focus\\\"\\n    ]\\n  },\\n  \\\"capabilityMatrixPath\\\": \\\".skilled/skills/system-deep-loop/deep-research/assets/runtime-capabilities.json\\\",\\n  \\\"capabilityMatrixDocPath\\\": \\\".skilled/skills/system-deep-loop/deep-research/references/guides/capability-matrix.md\\\",\\n  \\\"runtimeCapabilityResolver\\\": \\\".skilled/skills/system-deep-loop/deep-research/scripts/runtime-capabilities.cjs\\\",\\n  \\\"reducerScriptPath\\\": \\\".skilled/skills/system-deep-loop/deep-research/scripts/reduce-state.cjs\\\",\\n  \\\"pauseSentinelPath\\\": \\\".deep-research-pause\\\",\\n  \\\"archiveRoot\\\": \\\"_archive\\\",\\n  \\\"migrationWindowDays\\\": 28,\\n  \\\"fileProtection\\\": {\\n    \\\"deep-research-config.json\\\": \\\"immutable\\\",\\n    \\\"deep-research-state.jsonl\\\": \\\"append-only\\\",\\n    \\\"deep-research-strategy.md\\\": \\\"mutable\\\",\\n    \\\"deep-research-dashboard.md\\\": \\\"auto-generated\\\",\\n    \\\"findings-registry.json\\\": \\\"auto-generated\\\",\\n    \\\"iteration-*.md\\\": \\\"write-once\\\",\\n    \\\"research.md\\