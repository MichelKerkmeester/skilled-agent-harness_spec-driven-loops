r, runtime });\n198:     } catch {\n199:       return 'unknown';\n200:     }\n201:     if (!loaded?.ok) return 'unknown';\n202:     return recordsHaveBrief(loaded.records);\n203:   }\n204: \n205:   return 'unknown';\n206: }\n207: \n208: // ───────────────────────────────────────────────────────────────\n209: // Run-log backfill\n210: // ───────────────────────────────────────────────────────────────\n211: \n212: // A fresh daemon can outlast the first prompt's budget, so the backfill asks\n213: // each checkout to start one before it replays. The status call writes nothing,\n214: // and its failure is ignored because a replay that finds no daemon records its\n215: // own error instead of losing the line.\n216: function warmCheckout(checkoutDir) {\n217:   const cliPath = join(checkoutDir, ADVISOR_CLI_RELATIVE);\n218:   if (!existsSync(cliPath)) return;\n219:   spawnSync(\n[Output truncated. Continue reading with offset: 220]"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\": \".skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/command-offer.mjs\", \"offset\": 120, \"limit\": 100}"},"time":{"start":1794539699351,"end":1794539699907}}}}
