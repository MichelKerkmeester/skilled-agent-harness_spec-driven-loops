ue;\\n96:             release();\\n97:             resolve(Buffer.concat(chunks, totalBytes));\\n98:         }\\n99:         function onError(error) {\\n100:             if (settled)\\n101:                 return;\\n102:             settled = true;\\n103:             release();\\n104:             reject(error);\\n105:         }\\n106:         function onData(chunk) {\\n107:             if (settled)\\n108:                 return;\\n109:             const buffer = Buffer.isBuffer(chunk) ? chunk : Buffer.from(chunk);\\n110:             totalBytes += buffer.length;\\n111:             if (totalBytes > MAX_STDIN_BYTES) {\\n112:                 settled = true;\\n113:                 release();\\n114:                 stdin.destroy();\\n115:                 reject(new Error('INPUT_OVERFLOW'));\\n116:                 return;\\n117:             }\\n118:             chunks.push(buffer);\\n119:         }\\n120:         // Listeners go on before the timer, so a stdin that cannot take listeners\\n121:         // rejects at once and leaves no timer behind.\\n122:         stdin.on('data', onData);\\n123:         stdin.on('end', onEnd);\\n124:         stdin.on('error', onError);\\n125:         const timer = setTimeout(onEnd, STDIN_DEADLINE_MS);\\n126:     });\\n127: }\\n128: async function runShim() {\\n129:     const target = resolveTarget();\\n130:     if (!target) {\\n131:         emitDiagnostic('TARGET_UNRESOLVED');\\n132:         return '{}';\\n133:     }\\n134:     try {\\n135:         const childEnv = { ...process.env };\\n136:         // The advisor must finish before this shim kills it, or its fallback output is lost.\\n137:         const childBudgetCeilingMs = CHILD_TIMEOUT_MS - CHILD_START_MARGIN_MS;\\n138:         const operatorBudgetMs = Number.parseInt(process.env.SPECKIT_CLAUDE_HOOK_TIMEOUT_MS ?? '', 10);\\n139:         childEnv.SPECKIT_CLAUDE_HOOK_TIMEOUT_MS = String(Number.isFinite(operatorBudgetMs) && operatorBudgetMs > 0\\n140:             ? Math.min(operatorBudgetMs, childBudgetCeilingMs)\\n141:             : childBudgetCeilingMs);\\n142:         const input = await readBoundedStdin();\\n143:         const result = spawnSync(process.execPath, [target, ...process.argv.slice(2)], {\\n144:             cwd: process.cwd(),\\n145:             input,\\n146:             encoding: 'utf8',\\n147:             env: childEnv,\\n148:             timeout: CHILD_TIMEOUT_MS,\\n149:             maxBuffer: MAX_STDIO_BYTES,\\n150:             killSignal: 'SIGKILL',\\n151:         });\\n152:         if (result.error) {\\n153:             const code = result.error.code;\\n154:             emitDiagnostic(code === 'ETIMEDOUT' ? 'CHILD_TIMEOUT' : code === 'ENOBUFS' ? 'OUTPUT_OVERFLOW' : 'SPAWN_ERROR');\\n155:             return '{}';\\n156:         }\\n157:         if (result.status !== 0) {\\n158:             emitDiagnostic('NONZERO_EXIT');\\n159:             return '{}';\\n160:         }\\n161:         const stdout = typeof result.stdout === 'string' ? result.stdout.trim() : '';\\n162:         if (!stdout) {\\n163:             emitDiagnostic('EMPTY_OUTPUT');\\n164:             return '{}';\\n165:         }\\n166:         try {\\n167:             JSON.parse(stdout);\\n168:             return stdout;\\n169:         }\\n170:         catch {\\n171:             emitDiagnostic('INVALID_JSON');\\n172:             return '{}';\\n173:         }\\n174:     }\\n175:     catch (error) {\\n176:         emitDiagnostic(error instanceof Error && error.message === 'INPUT_OVERFLOW'\\n177:             ? 'INPUT_OVERFLOW'\\n178:             : 'STDIN_READ_ERROR');\\n179:         return '{}';\\n180:     }\\n181: }\\n182: // ───────────────────────────────────────────────────────────────────\\n183: // 3. ENTRYPOINT\\n184: // ───────────────────────────────────────────────────────────────────\\n185: async function main() {\\n186:     const advisorJson = await runShim();\\n187:     process.stdout.write(`${advisorJson}\\\\n`);\\n188:     process.exit(0);\\n189: }\\n190: void main();\\n191: //# sourceMappingURL=user-prompt-submit.js.map\"}],\"providerCall\":{\"executed\":false},\"providerResult\":{\"executed\":false},\"rawInput\":\"{\\\"path\\\":\\\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-spec-kit/runtime/dist/hooks/claude/user-prompt-submit.js\\\"}\"},\"time\":{\"start\":1794527291275,\"end\":1794527291711}}}}\n=== pi reader locator ===\n\nfunction recordsFromLines(lines) {\n  const records = [];\n\n  lines.forEach((line, index) => {\n    if (line?.type !== 'message' || !line.message || typeof line.message !== 'object') return;\n    const message = line.message;\n    const id = typeof line.id === 'string' && line.id ? line.id : `pi-entry-${index}`;\n    const timestamp = line.timestamp;\n\n    if (message.role === 'user') {\n      const blocks = [];\n      for (const item of Array.isArray(message.content) ? message.content : []) {\n        if (item?.type === 'text' && typeof item.text === 'string') blocks.push(textBlock(item.text));\n      }\n      // Pi records harness injections as their own `custom_message` entry type,\n      // which this mapping never reads, so a user message is operator content\n      // even when it opens with '<'.\n      const text = contentText(blocks);\n      if (!text) return;\n      records.push({ id, role: 'user', timestamp, content: blocks });\n      return;\n    }\n\n    if (message.role === 'assistant') {\n      const blocks = assistantBlocks(message.content);\n      if (blocks.length === 0) return;\n      records.push({ id, role: 'assistant', timestamp, content: blocks });\n      return;\n    }\n\n    if (message.role === 'toolResult') {\n      if (typeof message.toolCallId !== 'string' || !message.toolCallId) return;\n      const blocks = [];\n      for (const item of Array.isArray(message.content) ? message.content : []) {\n        if (item?.type === 'text' && typeof item.text === 'string') blocks.push(textBlock(item.text));\n      }\n      const record = {\n        id,\n        role: 'toolResult',\n        timestamp,\n        content: blocks.length > 0 ? blocks : [textBlock(contentText(message.content))],\n        toolCallId: message.toolCallId,\n      };\n      if (message.isError === true) record.isError = true;\n      records.push(record);\n    }\n  });\n\n  return records;\n}\n\n// ─────────────────────────────────────────────────────────────────────────────\n// 5. LOADER\n// ─────────────────────────────────────────────────────────────────────────────\n\nfunction liveResult({ sessionId, sessionManager, options }) {\n  const entries = branchEntries(sessionManager);\n  if (!Array.isArray(entries)) return { ok: false, code: 'store_unreadable' };\n  if (entries.length === 0) return { ok: false, code: 'session_not_found' };\n  return {\n    ok: true,\n    source: {\n      runtime: RUNTIME,\n      sessionId,\n      locatorKind: LOCATOR_KIND,\n\n[showing lines 10-77 of 77; full output saved to /Users/michelkerkmeester/.local/share/opencode/shell/4c10847297631c3af43d766cf1908920fe00c449/sh_1d2e9e685002MXVvO0K2Ecdw4T.out]"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\": \"cd /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research && grep -n \\\"pi\\\\|briefDelivered\\\\|delivered\\\" specs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/010-reachability-and-attribution/scratch/logs/*.out 2>/dev/null | head -10; echo \\\"=== pi reader locator ===\\\"; sed -n '110,175p' .skilled/hooks/shared/session-readers/pi.mjs\"}"},"time":{"start":1794539906260,"end":1794539906717}}}}
