teFileSync,\n} = require('node:fs');\nconst {\n  basename,\n  dirname,\n  isAbsolute,\n  join,\n  relative,\n  resolve,\n  sep,\n} = require('node:path');\nconst { latestIterationRecords, findingKeys } = require('../lib/deep-loop/iteration-findings.cjs');\n\n// ───────────────────────────────────────────────────────────────────\n// 2. CONSTANTS\n// ───────────────────────────────────────────────────────────────────\n\n// Per-mode structured finding fields, in the order a record is searched.\nconst FINDING_FIELDS = Object.freeze({\n  research: Object.freeze(['keyFindings', 'findings']),\n  review: Object.freeze(['findingDetails']),\n});\n\nconst FLAG_KEYS = Object.freeze({\n  '--mode': 'mode',\n  '--event-dir': 'eventDir',\n  '--artifact-dir': 'artifactDir',\n  '--state-log': 'stateLog',\n  '--registry': 'registry',\n  '--output': 'output',\n  '--dashboard': 'dashboard',\n  '--stop-reason': 'stopReason',\n  '--answered-count': 'answeredCount',\n  '--total-questions': 'totalQuestions',\n  '--active-p0': 'activeP0',\n  '--active-p1': 'activeP1',\n  '--active-p2': 'activeP2',\n  '--dimension-coverage': 'dimensionCoverage',\n  '--verdict': 'verdict',\n  '--release-readiness-state': 'releaseReadinessState',\n});\n\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"    missingStructuredFindingCount: 'uint32',\n    sourceFindingCount: 'nullable-uint32',\n    reconstructionGapCount: 'nullable-uint32',\n    stateParseFailureCount: 'uint32',\n  },\n  'deep_research.synthesis_complete': {\n    totalIterations: 'uint32',\n    answeredCount: 'uint32',\n    totalQuestions: 'uint32',\n    stopReason: 'prose',\n  },\n  'deep_research.spec_check_result': {\n    folderState: SPEC_FOLDER_STATE_RULE,\n    normalizedTopic: 'prose',\n    specPath: 'prose',\n    lockPath: 'prose',\n  },\n  'deep_research.spec_seed_created': {\n    folderState: SPEC_FOLDER_STATE_RULE,\n    anchorsTouched: 'prose-array',\n    diffSummary: 'prose',\n    seedMarkers: 'code-array',\n  },\n  'deep_research.spec_preinit_context_added': {\n    folderState: SPEC_FOLDER_STATE_RULE,\n    normalizedTopic: 'prose',\n=== closeout usage ===\n#!/usr/bin/env node\n\n// ───────────────────────────────────────────────────────────────────\n// MODULE: Synthesis Close-Out\n// ───────────────────────────────────────────────────────────────────\n\n// ───────────────────────────────────────────────────────────────────\n// 1. IMPORTS\n// ───────────────────────────────────────────────────────────────────\n\n'use strict';\n\nconst {\n  existsSync,\n  lstatSync,\n  readdirSync,\n  readFileSync,\n  realpathSync,\n  writeFileSync,\n} = require('node:fs');\nconst {\n  basename,\n  dirname,\n  isAbsolute,\n  join,\n  relative,\n  resolve,\n  sep,\n} = require('node:path');\nconst { latestIterationRecords, findingKeys } = require('../lib/deep-loop/iteration-findings.cjs');\n\n// ───────────────────────────────────────────────────────────────────\n// 2. CONSTANTS\n// ───────────────────────────────────────────────────────────────────\n\n// Per-mode structured finding fields, in the order a record is searched.\nconst FINDING_FIELDS = Object.freeze({\n  research: Object.freeze(['keyFindings', 'findings']),\n  review: Object.freeze(['findingDetails']),\n});\n\nconst FLAG_KEYS = Object.freeze({\n  '--mode': 'mode',\n  '--event-dir': 'eventDir',\n  '--artifact-dir': 'artifactDir',\n  '--state-log': 'stateLog',\n  '--registry': 'registry',\n  '--output': 'output',\n  '--dashboard': 'dashboard',\n  '--stop-reason': 'stopReason',\n  '--answered-count': 'answeredCount',\n  '--total-questions': 'totalQuestions',\n  '--active-p0': 'activeP0',\n  '--active-p1': 'activeP1',\n  '--active-p2': 'activeP2',\n  '--dimension-coverage': 'dimensionCoverage',\n  '--verdict': 'verdict',\n  '--release-readiness-state': 'releaseReadinessState',\n});\n\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\": 