c, statSync } from 'node:fs';\\n8: import { spawnSync } from 'node:child_process';\\n9: import { fileURLToPath } from 'node:url';\\n10: import { dirname, isAbsolute, join } from 'node:path';\\n11: // ───────────────────────────────────────────────────────────────────\\n12: // 1. CONSTANTS\\n13: // ───────────────────────────────────────────────────────────────────\\n14: const TARGET_REL = 'skills/system-skill-advisor/runtime/dist/hooks/claude/user-prompt-submit.js';\\n15: const MAX_STDIN_BYTES = 1024 * 1024;\\n16: const MAX_STDIO_BYTES = 1024 * 1024;\\n17: const CHILD_TIMEOUT_MS = 2500;\\n18: // Reserve fallback time after advisor CLI; 300 ms covers measured startup overhead with headroom.\\n19: const CHILD_START_MARGIN_MS = 300;\\n20: // The host kills this hook after 3 seconds and the advisor child needs most of\\n21: // that, so a host that never closes stdin must not hold the read for long. The\\n22: // value matches SHORT_HOST_STDIN_TIMEOUT_MS in ../shared-stdin.ts, which this\\n23: // file cannot import because its tests run the source directly.\\n24: const STDIN_DEADLINE_MS = 500;\\n25: const MAX_ROOT_WALK_DEPTH = 14;\\n26: // ───────────────────────────────────────────────────────────────────\\n27: // 2. TARGET RESOLUTION & SHIM DISPATCH\\n28: // ───────────────────────────────────────────────────────────────────\\n29: // Resolve the advisor target from this module's own location by walking up to\\n30: // the nearest ancestor that owns one of the adapter roots (`.skilled` first,\\n31: // then the legacy `.opencode` mirror). Claude may invoke the hook from any\\n32: // working directory, so a CWD-relative path would silently miss the target and\\n33: // fail open to `{}`; an install-anchored absolute path stays correct off-root.\\n34: // An override names one executable module. It must be absolute, so a relative\\n35: // path cannot be resolved against whatever cwd Claude happened to spawn the hook\\n36: // with, and it must be a regular file, so a directory or a dangling link falls\\n37: // back to the install-anchored walk instead of being handed to node.\\n38: function isRegularFileOverride(candidate) {\\n39:     if (!isAbsolute(candidate))\\n40:         return false;\\n41:     try {\\n42:         return statSync(candidate).isFile();\\n43:     }\\n44:     catch {\\n45:         return false;\\n46:     }\\n47: }\\n48: function resolveTarget() {\\n49:     // Test/install override: an explicit absolute target wins over the walk.\\n50:     const override = process.env.SPECKIT_USER_PROMPT_TARGET;\\n51:     if (override && isRegularFileOverride(override)) {\\n52:         return override;\\n53:     }\\n54:     let current = dirname(fileURLToPath(import.meta.url));\\n55:     for (let depth = 0; depth < MAX_ROOT_WALK_DEPTH; depth += 1) {\\n56:         // Both root names must resolve identically: a checkout whose legacy mirror\\n57:         // was dropped must not silently lose the advisor target, so the probe never\\n58:         // assumes which root name owns it.\\n59:         for (const rootName of ['.skilled', '.opencode']) {\\n60:             const candidate = join(current, rootName, TARGET_REL);\\n61:             if (existsSync(candidate)) {\\n62:                 return candidate;\\n63:             }\\n64:         }\\n65:         const parent = dirname(current);\\n66:         if (parent === current) {\\n67:             break;\\n68:         }\\n69:         current = parent;\\n70:     }\\n71:     return null;\\n72: }\\n73: function emitDiagnostic(code) {\\n74:     process.stderr.write(`[speckit-hook:user-prompt-submit] ${code}\\\\n`);\\n75: }\\n76: // Collect stdin until it ends or the deadline passes, then release it so the\\n77: // process can exit. More than MAX_STDIN_BYTES rejects with INPUT_OVERFLOW and\\n78: // destroys stdin, so a runaway payload is never buffered whole.\\n79: function readBoundedStdin() {\\n80:     return new Promise((resolve, reject) => {\\n81:         const stdin = process.stdin;\\n82:         const chunks = [];\\n83:         let totalBytes = 0;\\n84:         let settled = false;\\n85:         const release = () => {\\n86:             clearTimeout(timer);\\n87:             stdin.removeListener('data', onData);\\n88:             stdin.removeListener('end', onEnd);\\n89:             stdin.removeListener('error', onError);\\n90:             stdin.pause();\\n91:         };\\n92:         function onEnd() {\\n93:             if (settled)\\n94:                 return;\\n95:             settled = true;\\n96:             release();\\n97:             resolve(Buffer.concat(chunks, totalBytes));\\n98:         }\\n99:         function onError(error) {\\n100:             if (settled)\\n101:                 return;\\n102:             settled = true;\\n103:             release();\\n104:             reject(error);\\n105:         }\\n106:         function onData(chunk) {\\n107:             if (settled)\\n108:                 return;\\n109:             const buffer = Buffer.isBuffer(chunk) ? chunk : Buffer.from(chunk);\\n110:             totalBytes += buffer.length;\\n111:             if (totalBytes > MAX_STDIN_BYTES) {\\n112:                 settled = true;\\n113:                 release();\\n114:                 stdin.destroy();\\n115:                 reject(new Error('INPUT_OVERFLOW'));\\n116:                 return;\\n117:             }\\n118:             chunks.push(buffer);\\n119:         }\\n120:         // Listeners go on before the timer, so a stdin that cannot take listeners\\n121:         // rejects at once and leaves no timer behind.\\n122:         stdin.on('data', onData);\\n123:         stdin.on('end', onEnd);\\n124:         stdin.on('error', onError);\\n125:         const timer = setTimeout(onEnd, STDIN_DEADLINE_MS);\\n126:     });\\n127: }\\n128: async function runShim() {\\n129:     const target = resolveTarget();\\n130:     if (!target) {\\n131:         emitDiagnostic('TARGET_UNRESOLVED');\\n132:         return '{}';\\n133:     }\\n134:     try {\\n135:         const childEnv = { ...process.env };\\n136:         // The advisor must finish before this shim kills it, or its fallback output is lost.\\n137:         const childBudgetCeilingMs = CHILD_TIMEOUT_MS - CHILD_START_MARGIN_MS;\\n138:         const operatorBudgetMs = Number.parseInt(process.env.SPECKIT_CLAUDE_HOOK_TIMEOUT_MS ?? '', 10);\\n139:         childEnv.SPECKIT_CLAUDE_HOOK_TIMEOUT_MS = String(Number.isFinite(operatorBudgetMs) && operatorBudgetMs > 0\\n140:             ? Math.min(operatorBudgetMs, childBudgetCeilingMs)\\n141:             : childBudgetCeilingMs);\\n142:         const input = await readBoundedStdin();\\n143:         const result = spawnSync(process.execPath, [target, ...process.argv.slice(2)], {\\n144:             cwd: process.cwd(),\\n145:             input,\\n146:             encoding: 'utf8',\\n147:             env: childEnv,\\n148:             timeout: CHILD_TIMEOUT_MS,\\n149:             maxBuffer: MAX_STDIO_BYTES,\\n150:             killSignal: 'SIGKILL',\\n151:         });\\n152:         if (result.error) {\\n153:             const code = result.error.code;\\n154:             emitDiagnostic(code === 'ETIMEDOUT' ? 'CHILD_TIMEOUT' : code === 'ENOBUFS' ? 'OUTPUT_OVERFLOW' : 'SPAWN_ERROR');\\n155:             return '{}';\\n156:         }\\n157:         if (result.status !== 0) {\\n158:             emitDiagnostic('NONZERO_EXIT');\\n159:             return '{}';\\n160:         }\\n161:         const stdout = typeof result.stdout === 'string' ? result.stdout.trim() : '';\\n162:         if (!stdout) {\\n163:             emitDiagnostic('EMPTY_OUTPUT');\\n164:             return '{}';\\n165:         }\\n166:         try {\\n167:             JSON.parse(stdout);\\n168:             return stdout;\\n169:         }\\n170:         catch {\\n171:             emitDiagnostic('INVALID_JSON');\\n172:             return '{}';\\n173:         }\\n174:     }\\n175:     catch (error) {\\n176:         emitDiagnostic(error instanceof Error && error.message === 'INPUT_OVERFLOW'\\n177:             ? 'INPUT_OVERFLOW'\\n178:             : 'STDIN_READ_ERROR');\\n179:         return '{}';\\n180:     }\\n181: }\\n182: // ───────────────────────────────────────────────────────────────────\\n183: // 3. ENTRYPOINT\\n184: // ───────────────────────────────────────────────────────────────────\\n185: async function main() {\\n186:     const advisorJson = await runShim();\\n187:     process.stdout.write(`${advisorJson}\\\\n`);\\n188:     process.exit(0);\\n189: }\\n190: void main();\\n191: //# sourceMappingURL=user-prompt-submit.js.map\",\"title\":\"read\",\"metadata\":{\"metadata\":{\"truncated\":false},\"content\":[{\"type\":\"text\",\"text\":\"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-spec-kit/runtime/dist/hooks/claude/user-prompt-submit.js, lines 1-191\\n1: #!/usr/bin/env node\\n2: // ───────────────────────────────────────────────────────────────────\\n3: // MODULE: Claude User Prompt Submit Shim\\n4: // ───────────────────────────────────────────────────────────────────\\n5: // Thin process-boundary shim. The advisor implementation lives in\\n6: // system-skill-advisor; this path stays for existing runtime settings.\\n7: import { existsSync, statSync } from 'node:fs';\\n8: import { spawnSync } from 'node:child_process';\\n9: import { fileURLToPath } from 'node:url';\\n10: import { dirname, isAbsolute, join } from 'node:path';\\n11: // ───────────────────────────────────────────────────────────────────\\n12: // 1. CONSTANTS\\n13: // ───────────────────────────────────────────────────────────────────\\n14: const TARGET_REL = 'skills/system-skill-advisor/runtime/dist/hooks/claude/user-prompt-submit.js';\\n15: const MAX_STDIN_BYTES = 1024 * 1024;\\n16: const MAX_STDIO_BYTES = 1024 * 1024;\\n17: const CHILD_TIMEOUT_MS = 2500;\\n18: // Reserve fallback time after advisor CLI; 300 ms covers measured startup overhead with headroom.\\n19: const CHILD_START_MARGIN_MS = 300;\\n20: /