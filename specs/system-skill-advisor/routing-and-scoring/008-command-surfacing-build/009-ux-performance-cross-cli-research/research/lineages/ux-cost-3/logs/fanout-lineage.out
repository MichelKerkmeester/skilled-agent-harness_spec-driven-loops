  policySetChanged: input.policy_set_changed === true,\n233:     goalChanged: input.goal_changed === true,\n234:     deliveryConfirmed: false,\n235:   };\n236: }\n237: \n238: export function emitDiagnostic(\n239:   record: HookDiagnosticInput,\n240:   writeDiagnostic: (line: string) => void = (line) => process.stderr.write(`${line}\\n`),\n241:   persistDiagnostic: typeof persistAdvisorHookDiagnosticRecord = persistAdvisorHookDiagnosticRecord,\n242: ): void {\n243:   try {\n244:     const diagnosticRecord = createAdvisorHookDiagnosticRecord({\n245:       runtime: 'claude',\n246:       ...record,\n247:     });\n248:     const line = serializeAdvisorHookDiagnosticRecord(diagnosticRecord);\n249:     writeDiagnostic(line);\n250:     const pendingWrite = persistDiagnostic(record.workspaceRoot, diagnosticRecord).catch(() => undefined);\n251:     pendingDiagnosticWrites.add(pendingWrite);\n252:     void pendingWrite.then(() => pendingDiagnosticWrites.delete(pendingWrite));\n253:   } catch {\n254:     // Diagnostics must never affect hook behavior.\n255:   }\n256: }\n257: \n258: export async function flushPendingDiagnostics(maxWaitMs = 100): Promise<void> {\n259:   let timeout: NodeJS.Timeout | undefined;\n260:   try {\n261:     if (pendingDiagnosticWrites.size === 0) return;\n262:     const pendingWrites = Promise.all([...pendingDiagnosticWrites]).then(() => undefined);\n263:     const timeoutElapsed = new Promise<void>((resolvePromise) => {\n264:       timeout = setTimeout(resolvePromise, maxWaitMs);\n265:       timeout.unref();\n266:     });\n267:     await Promise.race([pendingWrites, timeoutElapsed]);\n268:   } catch {\n269:     // Diagnostics must never affect hook behavior.\n270:   } finally {\n271:     if (timeout) clearTimeout(timeout);\n272:   }\n273: }\n274: \n275: export function parseClaudeUserPromptSubmitInput(raw: string): ClaudeUserPromptSubmitInput | null {\n276:   try {\n277:     const parsed = JSON.parse(raw) as unknown;\n278:     return isRecord(parsed) ?