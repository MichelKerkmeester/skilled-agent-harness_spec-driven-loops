 \"metrics\": {\n  \"typed_recall_at_1\": {\n   \"correct\": 24,\n   \"total\": 44\n  },\n  \"typed_reach_top3\": {\n   \"correct\": 27,\n   \"total\": 44\n  },\n  \"plain_recall_at_1\": {\n   \"tune\": {\n    \"correct\": 8,\n    \"total\": 45\n   },\n   \"holdout\": {\n    \"correct\": 1,\n    \"total\": 44\n   }\n  },\n  \"plain_reach_top3\": {\n   \"tune\": {\n    \"correct\": 10,\n    \"total\": 45\n   },\n   \"holdout\": {\n    \"correct\": 1,\n    \"total\": 44\n   }\n  },\n  \"false_offer\": {\n   \"count\": 0,\n   \"total\": 35\n  },\n  \"slash_variant\": {\n   \"reached_top3\": 5,\n   \"named_total\": 8,\n   \"offered_on_partial\": 0,\n   \"partial_total\": 4\n  },\n  \"agreement\": {\n   \"correct\": 8,\n   \"total\": 10\n  }\n },\n \"attached\": {\n  \"plain\": {\n   \"tune\": {\n    \"own\": 8,\n    \"attached\": 15,\n    \"combined\": 23,\n    \"total\": 45\n   },\n   \"holdout\": {\n    \"own\": 1,\n    \"attached\": 0,\n    \"combined\": 1,\n    \"total\": 44\n   }\n  },\n  \"plain_by_family\": {\n   \"create\": {\n    \"tune\": {\n     \"own\": 1,\n     \"attached\": 9,\n     \"combined\": 10,\n     \"total\": 14\n    },\n    \"holdout\": {\n     \"own\": 0,\n     \"attached\": 0,\n     \"combined\": 0,\n     \"total\": 13\n    }\n   },\n   \"deep\": {\n    \"tune\": {\n     \"own\": 0,\n     \"attached\": 3,\n     \"combined\": 3,\n     \"total\": 3\n    },\n    \"holdout\": {\n     \"own\": 0,\n     \"attached\": 0,\n     \"combined\": 0,\n     \"total\": 3\n    }\n   },\n   \"design\": {\n    \"tune\": {\n     \"own\": 0,\n     \"attached\": 3,\n     \"combined\": 3,\n     \"total\": 3\n    },\n    \"holdout\": {\n     \"own\": 0,\n     \"attached\": 0,\n     \"combined\": 0,\n     \"total\": 3\n    }\n   },\n   \"doctor\": {\n    \"tune\": {\n     \"own\": 5,\n     \"attached\": 0,\n     \"combined\": 5,\n     \"total\": 17\n    },\n    \"holdout\": {\n     \"own\": 1,\n     \"attached\": 0,\n     \"combined\": 1,\n     \"total\": 17\n    }\n   },\n   \"prompt\": {\n    \"tune\": {\n     \"own\": 1,\n     \"attached\": 0,\n     \"combined\": 1,\n     \"total\": 1\n    },\n    \"holdout\": {\n     \"own\": 0,\n     \"attached\": 0,\n     \"combined\": 0,\n     \"total\": 1\n    }\n   },\n   \"speckit\": {\n    \"tune\": {\n     \"own\": 1,\n     \"attached\": 0,\n     \"combined\": 1,\n     \"total\": 7\n    },\n    \"holdout\": {\n     \"own\": 0,\n     \"attached\": 0,\n     \"combined\": 0,\n     \"total\": 7\n    }\n   }\n  },\n  \"false_offer_attached\": {\n   \"count\": 0,\n   \"total\": 35\n  },\n  \"typed\": {\n   \"own\": 24,\n   \"attached\": 20,\n   \"combined\": 44,\n   \"total\": 44\n  },\n  \"typedRows\": {\n   \"cmd-create-agent-typed-01\": {\n    \"expected_command\": \"/create:agent\",\n    \"top\": \"create:agent\",\n    \"carried\": \"own\",\n    \"command\": \"/create:agent\",\n    \"policy\": \"start\"\n   },\n   \"cmd-create-bench\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"L=specs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/009-ux-performance-cross-cli-research/research/lineages/ux-cost-3; node -e '\\nconst fs=require(\\\"fs\\\");const text=fs.readFileSync(process.argv[1],\\\"utf8\\\");\\nconst start=text.indexOf(\\\"{\\\");const j=JSON.parse(text.slice(start));\\nconsole.log(JSON.stringify({metrics:j.metrics,attached:j.attachedMetrics,evals:j.scorerEval||j.eval||null,keys:Object.keys(j)},null,1).slice(0,2500));\\n' \\\"$L/scratch/floor-baseline-head.txt\\\"\",\"workdir\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research\"}"},"time":{"start":1794551247742,"end":1794551249160}}}}
