nt":[{"type":"text","text":"127:export const HYGIENE_DIRECTIVE = '\\n- Comment hygiene [HARD BLOCK]: NEVER embed ADR-/REQ-/CHK-/task-ids or spec paths in code comments — forbidden regardless of instruction. Write the durable WHY instead. Pre-commit gate blocks violations.';\n133:export const DIRECTIVES_LABEL = '\\nDirectives:';\n314:export function renderRouteOnlyAdvisorBrief(rendered: string | null): string | null {\n507:export function renderAdvisorBrief(\n581:      const head = `Advisor: ${result.freshness}; ambiguous: ${headLabel} `\n588:      ) + DIRECTIVES_LABEL + HYGIENE_DIRECTIVE;\n594:  const head = `Advisor: ${result.freshness}; use ${headLabel} `\n600:  ) + DIRECTIVES_LABEL + HYGIENE_DIRECTIVE;\n627:export function renderAdvisorFallbackDirective(\n633:    ? `Advisor: outage (${classification.outageLabel});${options.setupWording === true ? ' for setup or health checks, run /doctor:setup;' : ''} route by hand: node .skilled/bin/skill-advisor.cjs advisor_recommend --json '{\"prompt\":\"<request>\"}' --format json`\n635:      ? 'Advisor: prompt skipped.'\n637:        ? `Advisor: no skill matched.${SETUP_HINT}`\n638:        : 'Advisor: no skill matched.';\n639:  const rendered = head + DIRECTIVES_LABEL + HYGIENE_DIRECTIVE;\n645:export function renderAdvisorTimeoutFallback(\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"grep -n \\\"Advisor: \\\\|function render\\\\|export function render\\\\|parts.push\\\\|HYGIENE_DIRECTIVE\\\\|DIRECTIVES_LABEL\\\" .skilled/skills/system-skill-advisor/runtime/lib/render.ts | head -60\",\"workdir\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research\"}"},"time":{"start":1794550364383,"end":1794550365862}}}}
