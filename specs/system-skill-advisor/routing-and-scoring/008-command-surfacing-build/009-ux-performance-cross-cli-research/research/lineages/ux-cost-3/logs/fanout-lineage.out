: {\n    \"name\": \"nomic-embed-text:v1.5\",\n    \"sizeBytes\": 274302450\n  },\n  \"loaded\": {\n    \"name\": \"nomic-embed-text:v1.5\",\n    \"sizeBytes\": 335733063,\n    \"sizeVramBytes\": 335733063,\n    \"expiresAt\": \"2026-11-13T07:27:11.769741+01:00\"\n  },\n  \"memory\": {\n    \"servePid\": 27430,\n    \"serveRssKb\": 26624,\n    \"runnerPid\": 95797,\n    \"runnerRssKb\": 257824\n  },\n  \"idle\": null,\n  \"warm\": {\n    \"n\": 30,\n    \"medianMs\": 7.89,\n    \"p95Ms\": 9.85\n  },\n  \"cold\": null,\n  \"coldReason\": \"model already loaded\",\n  \"cli\": {\n    \"ms\": [\n      193.39,\n      159.06,\n      322.84,\n      145.96,\n      90.15\n    ],\n    \"medianMs\": 159.06\n  }\n}\n\n--- err ---\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"cd /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research && L=specs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/009-ux-performance-cross-cli-research/research/lineages/ux-cost-3 && node .skilled/skills/system-skill-advisor/runtime/scripts/measure-embedder-cost.mjs > \\\"$L/scratch/embedder-cost-head.json\\\" 2> \\\"$L/scratch/embedder-cost-head.err\\\"; echo \\\"EXIT=$?\\\"; head -c 3000 \\\"$L/scratch/embedder-cost-head.json\\\"; echo; echo \\\"--- err ---\\\"; head -5 \\\"$L/scratch/embedder-cost-head.err\\\"\",\"timeout\":300000}"},"time":{"start":1794550940951,"end":1794550943314}}}}
