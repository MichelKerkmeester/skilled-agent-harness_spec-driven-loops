reading with offset: 330]","title":"read","metadata":{"metadata":{"truncated":true},"content":[{"type":"text","text":"Read file .skilled/skills/system-skill-advisor/hooks/claude/user-prompt-submit.ts, lines 150-329\n150: // 5. HELPERS\n151: // ───────────────────────────────────────────────────────────────\n152: \n153: function isRecord(value: unknown): value is Record<string, unknown> {\n154:   return typeof value === 'object' && value !== null && !Array.isArray(value);\n155: }\n156: \n157: function normalizePrompt(value: unknown): string | null {\n158:   if (typeof value !== 'string') {\n159:     return null;\n160:   }\n161:   if (Buffer.byteLength(value, 'utf8') <= MAX_PROMPT_BYTES) {\n162:     return value;\n163:   }\n164: \n165:   let low = 0;\n166:   let high = value.length;\n167:   while (low < high) {\n168:     const midpoint = Math.ceil((low + high) / 2);\n169:     if (Buffer.byteLength(value.slice(0, midpoint), 'utf8') <= MAX_PROMPT_BYTES) {\n170:       low = midpoint;\n171:     } else {\n172:       high = midpoint - 1;\n173:     }\n174:   }\n175:   return value.slice(0, low);\n176: }\n177: \n178: export function workspaceRootFor(input: ClaudeUserPromptSubmitInput): string {\n179:   const start =\n180:     typeof input.cwd === 'string' && input.cwd.trim().length > 0\n181:       ? input.cwd\n182:       : process.cwd();\n183:   // Anchor to the real repo root. A raw session cwd inside a specs/<packet>\n184:   // directory would otherwise become the \"workspace root\", and the advisor's\n185:   // state writers materialize a stray .state/advisor tree under it.\n186:   return findAdvisorWorkspaceRoot(start);\n187: }\n188: \n189: function skillLabelFor(result: AdvisorHookResult): string | null {\n190:   const metadataLabel = result.sharedPayload?.metadata?.skillLabel;\n191:   if (typeof metadataLabel === 'string') {\n192:     return metadataLabel;\n193:   }\n194:   return result.recommendations[0]?.skill ?? null;\n195: }\n196: \n197: function positiveIntFromEnv(value: string | undefined, fallback: number): number {\n198:   if (typeof value !== 'string' || value.trim().length === 0) {\n199:     return fallback;\n200:   }\n201:   const parsed = Number.parseInt(value, 10);\n202:   return Number.isFinite(parsed) && parsed > 0 ? parsed : fallback;\n203: }\n204: \n205: function claudeHookTimeoutMs(): number {\n206:   return positiveIntFromEnv(process.env.SPECKIT_CLAUDE_HOOK_TIMEOUT_MS, DEFAULT_CLAUDE_HOOK_TIMEOUT_MS);\n207: }\n208: \n209: function lifecycleEventFor(input: ClaudeUserPromptSubmitInput): string | undefined {\n210:   const explicit = input.lifecycle_event ?? input.lifecycle_source;\n211:   if (explicit === 'startup' || explicit === 'resume' || explicit === 'compact') {\n212:     return explicit;\n213:   }\n214:   if (input.hook_event_name === 'SessionStart'\n215:     && (input.source === 'startup' || input.source === 'resume' || input.source === 'compact')) {\n216:     return input.source;\n217:   }\n218:   return undefined;\n219: }\n220: \n221: /** Convert runtime-owned identity and lifecycle fields into shadow-only signals. */\n222: export function deliveryStateOptionsFor(\n223:   input: ClaudeUserPromptSubmitInput,\n224: ): ShadowDeliveryRenderOptions {\n225:   const hasSessionId = typeof input.session_id === 'string' && input.session_id.trim().length > 0;\n226:   return {\n227:     sessionId: input.session_id,\n228:     sessionIdentityConfirmed: input.session_identity_confirmed ?? hasSessionId,\n229:     sessionIdentityAmbiguous: input.session_identity_ambiguous === true,\n230:     lifecycleEvent: lifecycleEventFor(input),\n231:     scopeChanged: input.scope_changed === true,\n232:     policySetChanged: input.policy_set_changed === true,\n233:     goalChanged: input.goal_changed === true,\n234:     deliveryConfirmed: false,\n235:   };\n236: }\n237: \n238: export function emitDiagnostic(\n239:   record: HookDiagnosticInput,\n240:   writeDiagnostic: (line: string) => void = (line) => process.stderr.write(`${line}\\n`),\n241:   persistDiagnostic: typeof persistAdvisorHookDiagnosticRecord = persistAdvisorHookDiagnosticRecord,\n242: ): void {\n243:   try {\n244:     const diagnosticRecord = createAdvisorHookDiagnosticRecord({\n245:       runtime: 'claude',\n246:       ...record,\n247:     });\n248:     const line = serializeAdvisorHookDiagnosticRecord(diagnosticRecord);\n249:     writeDiagnostic(line);\n250:     const pendingWrite = persistDiagnostic(record.workspaceRoot, diagnosticRecord).catch(() => undefined);\n251:     pendingDiagnosticWrites.add(pendingWrite);\n252:     void pendingWrite.then(() => pendingDiagnosticWrites.delete(pendingWrite));\n253:   } catch {\n254:     // Diagnostics must never affect hook behavior.\n255:   }\n256: }\n257: \n258: export async function flushPendingDiagnostics(maxWaitMs = 100): Promise<void> {\n259:   let timeout: NodeJS.Timeout | undefined;\n260:   try {\n261:     if (pendingDiagnosticWrites.size === 0) return;\n262:     const pendingWrites = Promise.all([...pendingDiagnosticWrites]).then(() => undefined);\n263:     const timeoutElapsed = new Promise<void>((resolvePromise) => {\n264:       timeout = setTimeout(resolvePromise, maxWaitMs);\n265:       timeout.unref();\n266:     });\n267:     await Promise.race([pendingWrites, timeoutElapsed]);\n268:   } catch {\n269:     // Diagnostics must never affect hook behavior.\n270:   } finally {\n271:     if (timeout) clearTimeout(timeout);\n272:   }\n273: }\n274: \n275: export function parseClaudeUserPromptSubmitInput(raw: string): ClaudeUserPromptSubmitInput | null {\n276:   try {\n277:     const parsed = JSON.parse(raw) as unknown;\n278:     return isRecord(parsed) ? parsed : null;\n279:   } catch {\n280:     return null;\n281:   }\n282: }\n283: \n284: // ───────────────────────────────────────────────────────────────\n285: // 6. CORE LOGIC\n286: // ───────────────────────────────────────────────────────────────\n287: \n288: export async function handleClaudeUserPromptSubmit(\n289:   input: ClaudeUserPromptSubmitInput | null,\n290:   dependencies: UserPromptSubmitDependencies = {},\n291: ): Promise<ClaudeUserPromptSubmitOutput> {\n292:   const environmentRuntime = process.env.SPECKIT_RUNTIME;\n293:   const runtime = dependencies.runtime\n294:     ?? (isAdvisorRuntime(environmentRuntime) ? environmentRuntime : 'claude');\n295:   const startedAt = dependencies.now?.() ?? performance.now();\n296:   const elapsed = (): number => Number(((dependencies.now?.() ?? performance.now()) - startedAt).toFixed(3));\n297:   const writeDiagnostic = dependencies.writeDiagnostic;\n298: \n299:   try {\n300:     if (!skillAdvisorHookEnabled() || process.env.SPECKIT_SKILL_ADVISOR_HOOK_DISABLED === '1') {\n301:       emitDiagnostic({\n302:         runtime,\n303:         workspaceRoot: process.cwd(),\n304:         status: 'skipped',\n305:         freshness: 'unavailable',\n306:         durationMs: elapsed(),\n307:         cacheHit: false,\n308:       }, writeDiagnostic);\n309:       return {};\n310:     }\n311: \n312:     if (!input) {\n313:       emitDiagnostic({\n314:         runtime,\n315:         workspaceRoot: process.cwd(),\n316:         status: 'fail_open',\n317:         freshness: 'unavailable',\n318:         durationMs: elapsed(),\n319:         cacheHit: false,\n320:         errorCode: 'PARSE_FAIL',\n321:         errorDetails: 'Invalid UserPromptSubmit JSON payload',\n322:       }, writeDiagnostic);\n323:       return {};\n324:     }\n325: \n326:     const prompt = normalizePrompt(input.prompt);\n327:     const workspaceRoot = workspaceRootFor(input);\n328:     if (prompt === null) {\n329:       emitDiagnostic({\n[Output truncated. Continue reading with offset: 330]"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\".skilled/skills/system-skill-advisor/hooks/claude/user-prompt-submit.ts\",\"offset\":150,\"limit\":180}"},"time":{"start":1794550344352,"end":1794550344767}}}}
