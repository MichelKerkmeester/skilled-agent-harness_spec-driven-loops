amed_total\": 8,\n49:       \"offered_on_partial\": 0,\n50:       \"partial_total\": 4\n[Output truncated. Continue reading with offset: 51]","title":"read","metadata":{"metadata":{"truncated":true},"content":[{"type":"text","text":"Read file specs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/009-ux-performance-cross-cli-research/research/lineages/offer-reach-3/prompts/real-embed-capture.json, lines 1-50\n1: {\n2:   \"schemaVersion\": 1,\n3:   \"capturedAt\": \"2026-10-11\",\n4:   \"capturedAtSha\": \"320e7b64d4\",\n5:   \"corpusSha256\": \"sha256:698da57b02159a756dbba5d6a2c9a3c6d14588d07e96be268567835cf36448b8\",\n6:   \"bridgeCounts\": {\n7:     \"commandMetadata\": 27,\n8:     \"doctorRoutes\": 36,\n9:     \"generated\": 63,\n10:     \"typescriptActive\": 46,\n11:     \"pythonActive\": 52\n12:   },\n13:   \"metrics\": {\n14:     \"typed_recall_at_1\": {\n15:       \"correct\": 24,\n16:       \"total\": 44\n17:     },\n18:     \"typed_reach_top3\": {\n19:       \"correct\": 27,\n20:       \"total\": 44\n21:     },\n22:     \"plain_recall_at_1\": {\n23:       \"tune\": {\n24:         \"correct\": 13,\n25:         \"total\": 45\n26:       },\n27:       \"holdout\": {\n28:         \"correct\": 3,\n29:         \"total\": 44\n30:       }\n31:     },\n32:     \"plain_reach_top3\": {\n33:       \"tune\": {\n34:         \"correct\": 15,\n35:         \"total\": 45\n36:       },\n37:       \"holdout\": {\n38:         \"correct\": 3,\n39:         \"total\": 44\n40:       }\n41:     },\n42:     \"false_offer\": {\n43:       \"count\": 0,\n44:       \"total\": 35\n45:     },\n46:     \"slash_variant\": {\n47:       \"reached_top3\": 5,\n48:       \"named_total\": 8,\n49:       \"offered_on_partial\": 0,\n50:       \"partial_total\": 4\n[Output truncated. Continue reading with offset: 51]"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\"specs/system-skill-advisor/routing-and-scoring/008-command-surfacing-bu