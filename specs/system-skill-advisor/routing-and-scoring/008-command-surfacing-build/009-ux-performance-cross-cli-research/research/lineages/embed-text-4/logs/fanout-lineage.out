e-rerank.mjs\nscore-routing-corpus.py\nscorer-eval-baseline.json\nworktree-restore.mjs\n---\nacceptance-criteria.md\ndescription.json\ngraph-metadata.json\nimplementation-summary.md\nplan.md\nscratch\nspec.md\ntasks.md\n---\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"ls .skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/ 2>&1; echo \\\"---\\\"; ls specs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/014-review-remediation/ 2>&1 | head; echo \\\"---\\\"; find .skilled/skills/system-skill-advisor -name \\\"command-metadata.json\\\" | head -50\"}"},"time":{"start":1794570121404,"end":1794570122509}}}}
