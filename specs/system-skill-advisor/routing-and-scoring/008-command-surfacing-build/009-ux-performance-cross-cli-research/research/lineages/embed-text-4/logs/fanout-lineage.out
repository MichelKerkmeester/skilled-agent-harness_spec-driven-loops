:     if (!isRecord(entry) || typeof entry.embeddingText !== 'string') {\n783:       continue;\n784:     }\n785:     const embeddingText = entry.embeddingText.trim();\n786:     if (!embeddingText) {\n787:       continue;\n788:     }\n789:     // Only a command the TypeScript router serves is ever a scoring candidate,\n790:     // so a python-only or disabled row would pay for a vector nobody reads.\n791:     if (!isRecord(entry.runtime) || !isRecord(entry.runtime.typescript)) {\n792:       continue;\n793:     }\n794:     const typescriptRuntime = entry.runtime.typescript;\n795:     if (typescriptRuntime.enabled !== true) {\n796:       continue;\n797:     }\n798:     const commandId = typescriptRuntime.id;\n799:     if (typeof commandId !== 'string' || commandId.trim().length === 0) {\n800:       continue;\n801:     }\n802:     // One command can be projected from more than one authored source. The\n803:     // vector is keyed by runtime id, so a repeat would pay twice for one row.\n804:     if (seenIds.has(commandId)) {\n805:       continue;\n806:     }\n807:     seenIds.add(commandId);\n808:     sources.push({ commandId, embeddingText });\n809:   }\n810: \n811:   return sources;\n812: }\n813: \n814: export function providerModelId(profile: { provider: string; model: string; dim: number; dtype?: string | null; slug?: string }): string {\n815:   return profile.slug ?? [profile.provider, profile.model, profile.dim, profile.dtype ?? null]\n816:     .filter((part): part is string | number => part !== null && part !== undefined && part !== '')\n817:     .join(':');\n818: }\n819: \n820: function discoverGraphMetadataFiles(skillDir: string): string[] {\n821:   if (!existsSync(skillDir)) {\n822:     return [];\n823:   }\n824: \n825:   const discovered: string[] = [];\n826:   const stack: string[] = [skillDir];\n827:   const isTrustedLink = createPrivateSkillLinkCheck(skillDir);\n828: \n829:   while (stack.length > 0) {\n830:     // The loop guard guarantees a directory is a