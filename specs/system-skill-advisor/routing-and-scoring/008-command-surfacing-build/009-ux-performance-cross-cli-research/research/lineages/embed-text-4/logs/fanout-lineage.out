{"type":"tool_use","timestamp":1794570131088,"sessionID":"ses_e2b4abd5affeHy554lSqReHMR4","part":{"partID":"prt_1d4b713790018LFT0V8iJYhkzj","sessionID":"ses_e2b4abd5affeHy554lSqReHMR4","messageID":"msg_1d4b70d600017u65IVaGzU3Gh3","type":"tool","id":"call_e6912bc80cc74dbb9d433e48","tool":"read","state":{"status":"completed","input":{"path":".skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/capture-command-routing-baseline.mjs","offset":1,"limit":120},"output":"Read file .skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/capture-command-routing-baseline.mjs, lines 1-120\n1: // ───────────────────────────────────────────────────────────────────\n2: // MODULE: COMMAND ROUTING BASELINE CAPTURE\n3: // ───────────────────────────────────────────────────────────────────\n4: //\n5: // Captures how the built scorer routes the command-prompt corpus under the\n6: // reproducible filesystem projection (empty SYSTEM_SKILL_ADVISOR_DB_DIR →\n7: // SQLite loader returns null → projection built purely from committed graph\n8: // metadata). It answers the questions command surfacing has to hold to: a\n9: // prompt that names a slash command reaches that command's bridge, a prompt\n10: // that must stay quiet offers no command at all, a partial slash mention is\n11: // not routed as if it were complete, and a bridge ranked below the top skill\n12: // is owned by that skill.\n13: //\n14: // It also measures what the compiled route adds on top of that: a hub can name\n15: // the slash command its own routing would take, which reaches a reader who never\n16: // types a slash command. That reach is reported under its own key so every\n17: // existing number keeps the value and the comparability it had before.\n18: //\n19: // The result is the ratchet baseline: the gate re-scores live under the same\n20: // environment and holds every count to it, so any scoring or bridge-metadata\n21: // change that moves a number forces a conscious re-capture rather than\n22: // drifting silently. `corpusSha256` pins the baseline to the exact corpus it\n23: // was captured against, so a corpus edit changes the hash and forces\n24: // re-baselining.\n25: //\n26: // The same corpus can also be scored against the operator's own skill graph and\n27: // embedder under `--real-embedding`, which is a live probe of this machine rather\n28: // than a reproducible projection. Its numbers describe an environment, so it never\n29: // writes the baseline and never runs under the fixture regime the ratchet replays.\n30: //\n31: // Setup runs on call, never on import: the environment projection, the clock\n32: // pin and the scorer import all live inside scoreCommandCorpus(), so a harness\n33: // may import this module and score in-process without inheriting either.\n34: //\n35: // Usage:\n36: //   node capture-command-routing-baseline.mjs            # print JSON to stdout\n37: //   node capture-command-routing-baseline.mjs --write    # also write the baseline\n38: //   node capture-command-routing-baseline.mjs --real-embedding   # score live vectors\n39: \n40: // ───────────────────────────────────────────────────────────────────\n41: // 1. IMPORTS\n42: // ───────────────────────────────────────────────────────────────────\n43: \n44: import { execFileSync, spawnSync } from 'node:child_process';\n45: import { createHash } from 'node:crypto';\n46: import { existsSync, mkdtempSync, readdirSync, readFileSync, rmSync, writeFileSync } from 'node:fs';\n47: import { createRequire } from 'node:module';\n48: import { tmpdir } from 'node:os';\n49: import { dirname, join, resolve } from 'node:path';\n50: import { fileURLToPath, pathToFileURL } from 'node:url';\n51: import { rejectUnknownOptions } from './reject-unknown-options.mjs';\n52: \n53: // ───────────────────────────────────────────────────────────────────\n54: // 2. CONSTANTS\n55: // ───────────────────────────────────────────────────────────────────\n56: \n57: const HERE = dirname(fileURLToPath(import.meta.url));\n58: const CORPUS_JSONL = resolve(HERE, 'command-prompts.jsonl');\n59: const BRIDGES_JSON = resolve(HERE, '../command-bridges/command-bridges.generated.json');\n60: const SCORER_EVAL_BASELINE_JSON = resolve(HERE, 'scorer-eval-baseline.json');\n61: const OUTPUT_JSON = resolve(HERE, 'command-routing-baseline.json');\n62: const DIST = resolve(HERE, '../../dist/runtime');\n63: const FUSION_MODULE = resolve(DIST, 'lib/scorer/fusion.js');\n64: const WORKSPACE_ROOT_MODULE = resolve(DIST, 'lib/utils/workspace-root.js');\n65: const COMMAND_ATTACH_MODULE = resolve(DIST, 'lib/command-attach.js');\n66: const PROMPT_POLICY_MODULE = resolve(DIST, 'lib/prompt-policy.js');\n67: const COMPILED_ROUTING_FLAG_MODULE = resolve(DIST, 'lib/compiled-routing-flag.js');\n68: const SEMANTIC_SHADOW_MODULE = resolve(DIST, 'lib/scorer/lanes/semantic-shadow.js');\n69: const SKILL_GRAPH_DB_MODULE = resolve(DIST, 'lib/skill-graph/skill-graph-db.js');\n70: const DIST_FRESHNESS_MODULE = resolve(HERE, '../../../../system-spec-kit/runtime/cli/lib/dist-freshness.cjs');\n71: \n72: const SENTINEL = '.skilled/skills/system-spec-kit/SKILL.md';\n73: const COMMANDS_DIR = '.skilled/commands';\n74: // Only the folder-level README is a document; a lowercase `readme.md` shipped\n75: // beside the commands is itself a command, so the skip is case-sensitive.\n76: const COMMAND_DOC_SKIP = 'README.md';\n77: const COMMAND_DOC_SUFFIX = '.md';\n78: // The compiled route is asked for through the public front door a hub's SKILL.md\n79: // calls, so this measures the decision the runtime actually serves rather than a\n80: // second derivation of it that could disagree with the first.\n81: const COMPILED_ROUTE_CLI = '.skilled/bin/compiled-route.cjs';\n82: const COMPILED_ROUTE_TIMEOUT_MS = 5000;\n83: \n84: // A real capture talks to the same embedder the recommend path does, so the probe\n85: // asks that daemon directly and names the model family the routing vectors come\n86: // from. The command vectors sit beside the skill vectors in the skill graph, in a\n87: // table whose name carries the embedder dimension.\n88: const EMBEDDER_TAGS_URL = 'http://localhost:11434/api/tags';\n89: const EMBEDDER_MODEL_PREFIX = 'nomic-embed-text';\n90: const EMBEDDER_PROBE_TIMEOUT_MS = 5000;\n91: const COMMAND_VECTOR_TABLE_PREFIX = 'vec_cmd_';\n92: \n93: // ───────────────────────────────────────────────────────────────────\n94: // 3. RUNTIME SETUP\n95: // ───────────────────────────────────────────────────────────────────\n96: //\n97: // Only the value lookups live here; the mutations themselves are deferred into\n98: // scoreCommandCorpus() so importing this module has no side effects.\n99: \n100: function isCalendarDate(value) {\n101:   if (!/^\\d{4}-\\d{2}-\\d{2}$/.test(value)) return false;\n102:   const parsed = new Date(`${value}T00:00:00Z`);\n103:   return !Number.isNaN(parsed.getTime()) && parsed.toISOString().slice(0, 10) === value;\n104: }\n105: \n106: // The derived lane halves each skill's score every 90 days of age, measured\n107: // from its derived.generated_at to the scoring clock (floored at 0.1), so\n108: // scores move with the calendar. The scoring date is therefore inherited from\n109: // the scorer-eval baseline and pinned, never read from the wall clock: a\n110: // recapture on any day replays the recorded date and reproduces the same\n111: // numbers, which keeps the two baselines directly comparable.\n112: function readPinnedScoringDate() {\n113:   let recorded;\n114:   try {\n115:     recorded = JSON.parse(readFileSync(SCORER_EVAL_BASELINE_JSON, 'utf8')).capturedAt;\n116:   } catch {\n117:     recorded = undefined;\n118:   }\n119:   if (typeof recorded !== 'string' || !isCalendarDate(recorded)) {\n120:     throw new Error(`scorer-eval baseline has no pinned scoring date (capturedAt): ${SCORER_EVAL_BASELINE_JSON}`);\n[Output truncated. Continue reading with offset: 121]","title":"read","metadata":{"metadata":{"truncated":true},"content":[{"type":"text","text":"Read file .skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/capture-command-routing-baseline.mjs, lines 1-120\n1: // ───────────────────────────────────────────────────────────────────\n2: // MODULE: COMMAND ROUTING BASELINE CAPTURE\n3: // ───────────────────────────────────────────────────────────────────\n4: //\n5: // Captures how the built scorer routes the command-prompt corpus under the\n6: // reproducible filesystem projection (empty SYSTEM_SKILL_ADVISOR_DB_DIR →\n7: // SQLite loader returns null → projection built purely from committed graph\n8: // metadata). It answers the questions command surfacing has to hold to: a\n9: // prompt that names a slash command reaches that command's bridge, a prompt\n10: // that must stay quiet offers no command at all, a partial slash mention is\n11: // not routed as if it were complete, and a bridge ranked below the top skill\n12: // is owned by that skill.\n13: //\n14: // It also measures what the compiled route adds on top of that: a hub can name\n15: // the slash command its own routing would take, which reaches a reader who never\n16: // types a slash command. That reach is reported under its own key so every\n17: // existing number keeps the value and the comparability it had before.\n18: //\n19: // The result is the ratchet baseline: the gate re-scores live under the same\n20: // environment and holds every count to it, so any scoring or bridge-metadata\n21: // change that moves a number forces a conscious re-capture rather than\n22: // drifting silently. `corpusSha256` pins the baseline to the exact corpus it\n23: // was captured against, so a corpus edit changes the hash and forces\n24: // re-baselining.\n25: //\n26: // The same corpus can also be scored against the operator's own skill graph and\n27: // embedder under `--real-embedding`, which is a live probe of this machine rather\n28: // than a reproducible projection. Its numbers describe an environment, so it never\n29: // writes the baseline and never runs under the fixture regime the ratchet replays.\n30: //\n31: // Setup runs on call, never on import: the environment projection, the clock\n32: // pin and the scorer import all live inside scoreCommandCorpus(), so a harness\n33: // may import this module and score in-process without inheriting either.\n34: //\n35: // Usage:\n36: //   node capture-command-routing-baseline.mjs            # print JSON to stdout\n37: //   node capture-command-routing-baseline.mjs --write    # also write the baseline\n38: //   node capture-command-routing-baseline.mjs --real-embedding   # score live vectors\n39: \n40: // ───────────────────────────────────────────────────────────────────\n41: // 1. IMPORTS\n42: // ───────────────────────────────────────────────────────────────────\n43: \n44: import { execFileSync, spawnSync } from 'node:child_process';\n45: import { createHash } from 'node:crypto';\n46: import { existsSync, mkdtempSync, readdirSync, readFileSync, rmSync, writeFileSync } from 'node:fs';\n47: import { createRequire } from 'node:module';\n48: import { tmpdir } from 'node:os';\n49: import { dirname, join, resolve } from 'node:path';\n50: import { fileURLToPath, pathToFileURL } from 'node:url';\n51: import { rejectUnknownOptions } from './reject-unknown-options.mjs';\n52: \n53: // ───────────────────────────────────────────────────────────────────\n54: // 2. CONSTANTS\n55: // ───────────────────────────────────────────────────────────────────\n56: \n57: const HERE = dirname(fileURLToPath(import.meta.url));\n58: const CORPUS_JSONL = resolve(HERE, 'command-prompts.jsonl');\n59: const BRIDGES_JSON = resolve(HERE, '../command-bridges/command-bridges.generated.json');\n60: const SCORER_EVAL_BASELINE_JSON = resolve(HERE, 'scorer-eval-baseline.json');\n61: const OUTPUT_JSON = resolve(HERE, 'command-routing-baseline.json');\n62: const DIST = resolve(HERE, '../../dist/runtime');\n63: const FUSION_MODULE = resolve(DIST, 'lib/scorer/fusion.js');\n64: const WORKSPACE_ROOT_MODULE = resolve(DIST, 'lib/utils/workspace-root.js');\n65: const COMMAND_ATTACH_MODULE = resolve(DIST, 'lib/command-attach.js');\n66: const PROMPT_POLICY_MODULE = resolve(DIST, 'lib/prompt-policy.js');\n67: const COMPILED_ROUTING_FLAG_MODULE = resolve(DIST, 'lib/compiled-routing-flag.js');\n68: const SEMANTIC_SHADOW_MODULE = resolve(DIST, 'lib/scorer/lanes/semantic-shadow.js');\n69: const SKILL_GRAPH_DB_MODULE = resolve(DIST, 'lib/skill-graph/skill-graph-db.js');\n70: const DIST_FRESHNESS_MODULE = resolve(HERE, '../../../../system-spec-kit/runtime/cli/lib/dist-freshness.cjs');\n71: \n72: const SENTINEL = '.skilled/skills/system-spec-kit/SKILL.md';\n73: const COMMANDS_DIR = '.skilled/commands';\n74: // Only the folder-level README is a document; a lowercase `readme.md` shipped\n75: // beside the commands is itself a command, so the skip is case-sensitive.\n76: const COMMAND_DOC_SKIP = 'README.md';\n77: const COMMAND_DOC_SUFFIX = '.md';\n78: // The compiled route is asked for through the public front door a hub's SKILL.md\n79: // calls, so this measures the decision the runtime actually serves rather than a\n80: // second derivation of it that could disagree with the first.\n81: const COMPILED_ROUTE_CLI = '.skilled/bin/compiled-route.cjs';\n82: const COMPILED_ROUTE_TIMEOUT_MS = 5000;\n83: \n84: // A real capture talks to the same embedder the recommend path does, so the probe\n85: // asks that daemon directly and names the model family the routing vectors come\n86: // from. The command vectors sit beside the skill vectors in the skill graph, in a\n87: // table whose name carries the embedder dimension.\n88: const EMBEDDER_TAGS_URL = 'http://localhost:11434/api/tags';\n89: const EMBEDDER_MODEL_PREFIX = 'nomic-embed-text';\n90: const EMBEDDER_PROBE_TIMEOUT_MS = 5000;\n91: const COMMAND_VECTOR_TABLE_PREFIX = 'vec_cmd_';\n92: \n93: // ───────────────────────────────────────────────────────────────────\n94: // 3. RUNTIME SETUP\n95: // ───────────────────────────────────────────────────────────────────\n96: //\n97: // Only the value lookups live here; the mutations themselves are deferred into\n98: // scoreCommandCorpus() so importing this module has no side effects.\n99: \n100: function isCalendarDate(value) {\n101:   if (!/^\\d{4}-\\d{2}-\\d{2}$/.test(value)) return false;\n102:   const parsed = new Date(`${value}T00:00:00Z`);\n103:   return !Number.isNaN(parsed.getTime()) && parsed.toISOString().slice(0, 10) === value;\n104: }\n105: \n106: // The derived lane halves each skill's score every 90 days of age, measured\n107: // from its derived.generated_at to the scoring clock (floored at 0.1), so\n108: // scores move with the calendar. The scoring date is therefore inherited from\n109: // the scorer-eval baseline and pinned, never read from the wall clock: a\n110: // recapture on any day replays the recorded date and reproduces the same\n111: // numbers, which keeps the two baselines directly comparable.\n112: function readPinnedScoringDate() {\n113:   let recorded;\n114:   try {\n115:     recorded = JSON.parse(readFileSync(SCORER_EVAL_BASELINE_JSON, 'utf8')).capturedAt;\n116:   } catch {\n117:     recorded = undefined;\n118:   }\n119:   if (typeof recorded !== 'string' || !isCalendarDate(recorded)) {\n120:     throw new Error(`scorer-eval baseline has no pinned scoring date (capturedAt): ${SCORER_EVAL_BASELINE_JSON}`);\n[Output truncated. Continue reading with offset: 121]"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\".skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/capture-command-routing-baseline.mjs\",\"offset\":1,\"limit\":120}"},"time":{"start":1794570130297,"end":1794570131088}}}}
{"type":"tool_use","timestamp":1794570131093,"sessionID":"ses_e2b4abd5affeHy554lSqReHMR4","part":{"partID":"prt_1d4b715200016uHrfMoZof7BYn","sessionID":"ses_e2b4abd5affeHy554lSqReHMR4","messageID":"msg_1d4b70d600017u65IVaGzU3Gh3","type":"tool","id":"call_537e54e11aae45fd9209bcef","tool":"read","state":{"status":"completed","input":{"path":".skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/capture-command-routing-baseline.mjs","offset":330,"limit":140},"output":"Read file .skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/capture-command-routing-baseline.mjs, lines 330-469\n330:   if (namespace === null) return undefined;\n331:   if (!byFamily.has(namespace)) {\n332:     byFamily.set(namespace, { tune: emptyAttachedTally(), holdout: emptyAttachedTally() });\n333:   }\n334:   return byFamily.get(namespace);\n335: }\n336: \n337: function readHeadSha(workspaceRoot) {\n338:   const spawned = spawnSync('git', ['rev-parse', '--short', 'HEAD'], { cwd: workspaceRoot, encoding: 'utf8' });\n339:   return spawned.status === 0 ? spawned.stdout.trim() : 'unknown';\n340: }\n341: \n342: // ───────────────────────────────────────────────────────────────────\n343: // 6. CORE LOGIC\n344: // ───────────────────────────────────────────────────────────────────\n345: \n346: export async function scoreCommandCorpus(options = {}) {\n347:   const realEmbedding = options.realEmbedding === true;\n348:   const RealDate = Date;\n349:   // The projection needs an existing, empty cache directory, and that directory\n350:   // is scratch space this run owns. It is created before the `try` so a failure\n351:   // to create it has nothing left to remove, and removed in the `finally` so\n352:   // repeated captures do not leave one behind per run. A real capture reads the\n353:   // operator's own skill graph, so it owns no scratch directory and sweeps none.\n354:   const dbDir = realEmbedding ? null : mkdtempSync(join(tmpdir(), 'advisor-command-routing-'));\n355:   try {\n356:     // Environment projection. That empty directory makes the SQLite loader\n357:     // return null, so the projection is built from committed metadata alone,\n358:     // which is the only state a clean checkout can reproduce. A real capture reads\n359:     // the operator's own skill graph and embedder instead, so the three variables\n360:     // that select the projection are exactly the three it leaves unset.\n361:     if (!realEmbedding) {\n362:       process.env.SYSTEM_SKILL_ADVISOR_DB_DIR = dbDir;\n363:       process.env.SKILL_ADVISOR_DISABLE_BUILTIN_SEMANTIC = '1';\n364:       // Match the test-harness regime: the semantic-shadow lane substitutes\n365:       // deterministic fixture vectors under the harness flag (real embeddings are\n366:       // not reproducible in CI), so every scorer gate runs this way. The baseline\n367:       // must be captured under the same regime the ratchet re-scores it in.\n368:       process.env.VITEST = 'true';\n369:     }\n370:     process.env.SPECKIT_SKILL_ADVISOR_FORCE_LOCAL = '1';\n371:     process.env.PYTHONDONTWRITEBYTECODE = '1';\n372:     delete process.env.SPECKIT_ADVISOR_LANE_WEIGHTS_JSON;\n373:     delete process.env.SPECKIT_ADVISOR_LANE_SHADOW_WEIGHTS_JSON;\n374:     delete process.env.SPECKIT_ADVISOR_BM25_LEXICAL_SHADOW;\n375:     // Private `local-*` skills linked in through this variable live outside the\n376:     // checkout, so a baseline measured on a clean checkout must not see them.\n377:     delete process.env.SPECKIT_PRIVATE_SKILL_ROOTS;\n378: \n379:     // Pin the scoring clock to midnight UTC on the inherited scoring date.\n380:     const capturedAt = readPinnedScoringDate();\n381:     const scoringInstant = Date.parse(`${capturedAt}T00:00:00Z`);\n382:     globalThis.Date = class extends RealDate {\n383:       constructor(...args) {\n384:         if (args.length === 0) super(scoringInstant);\n385:         else super(...args);\n386:       }\n387: \n388:       static now() {\n389:         return scoringInstant;\n390:       }\n391:     };\n392: \n393:     if (!existsSync(FUSION_MODULE)) {\n394:       throw new Error(`built scorer file missing: ${FUSION_MODULE}`);\n395:     }\n396:     for (const modulePath of [COMMAND_ATTACH_MODULE, COMPILED_ROUTING_FLAG_MODULE, PROMPT_POLICY_MODULE]) {\n397:       if (!existsSync(modulePath)) {\n398:         throw new Error(`built command-attach file missing: ${modulePath}`);\n399:       }\n400:     }\n401: \n402:     // Imported after the clock is pinned so the compiled scorer initializes\n403:     // against the pinned date, and only after it is known to exist so a missing\n404:     // build is reported as such rather than as a module-resolution failure.\n405:     const { scoreAdvisorPrompt } = await import(pathToFileURL(FUSION_MODULE).href);\n406:     const { findAdvisorWorkspaceRoot } = await import(pathToFileURL(WORKSPACE_ROOT_MODULE).href);\n407:     const { attachCommand, typedCommandForTop, TRACKED_COMMANDS, routeNeedsMode } = await import(pathToFileURL(COMMAND_ATTACH_MODULE).href);\n408:     const { extractMetalinguisticSkillMentions } = await import(pathToFileURL(PROMPT_POLICY_MODULE).href);\n409:     const { COMPILED_ROUTING_HUBS } = await import(pathToFileURL(COMPILED_ROUTING_FLAG_MODULE).href);\n410:     const workspaceRoot = findAdvisorWorkspaceRoot(HERE, { maxDepth: 14, sentinel: SENTINEL });\n411: \n412:     // A missing front door would make every spawn fail and report the same zero\n413:     // as a hub with nothing to attach, so it fails the capture instead.\n414:     if (!existsSync(resolve(workspaceRoot, COMPILED_ROUTE_CLI))) {\n415:       throw new Error(`compiled route front door missing: ${resolve(workspaceRoot, COMPILED_ROUTE_CLI)}`);\n416:     }\n417: \n418:     // A build older than its source scores code that no longer exists, so its\n419:     // numbers would describe a scorer nobody can read. Refuse it, and likewise\n420:     // a build whose freshness cannot be assessed.\n421:     const { checkPackageFreshness } = createRequire(import.meta.url)(DIST_FRESHNESS_MODULE);\n422:     const freshness = checkPackageFreshness('system-skill-advisor/runtime', { workspaceRoot });\n423:     if (freshness.status !== 'fresh') {\n424:       throw new Error(freshness.message);\n425:     }\n426: \n427:     // Real scoring is the only mode that reads this machine, so it is the only one\n428:     // that has to prove the machine can answer before walking the corpus. Without\n429:     // the flag nothing here runs and the prompt embedding is the direct call below.\n430:     const embedPrompt = realEmbedding ? await prepareRealEmbeddingScoring() : null;\n431: \n432:     const commandNames = readCommandFileNames(workspaceRoot);\n433:     const commandSet = new Set(commandNames);\n434:     const { bridgeCounts, idToCommand } = readBridgeMap(BRIDGES_JSON);\n435:     const corpus = readCorpus(CORPUS_JSONL);\n436: \n437:     // A label naming a command that does not exist would silently score as a\n438:     // permanent miss, so it fails the capture instead of deflating a metric.\n439:     for (const row of corpus) {\n440:       if (row.expected_command === null || row.expected_command === undefined) continue;\n441:       if (!commandSet.has(row.expected_command)) {\n442:         throw new Error(`corpus row ${row.id} expects ${row.expected_command}, which is not a command file under ${resolve(workspaceRoot, COMMANDS_DIR)}`);\n443:       }\n444:     }\n445: \n446:     const perCommand = new Map();\n447:     for (const command of commandNames) {\n448:       perCommand.set(command, { typed: emptyTally(), plain: { tune: emptyTally(), holdout: emptyTally() } });\n449:     }\n450: \n451:     const typed = emptyTally();\n452:     const plain = { tune: emptyTally(), holdout: emptyTally() };\n453:     let falseOfferCount = 0;\n454:     let falseOfferTotal = 0;\n455:     let slashReachedTop3 = 0;\n456:     let slashNamedTotal = 0;\n457:     let slashOfferedOnPartial = 0;\n458:     let slashPartialTotal = 0;\n459:     let agreementCorrect = 0;\n460:     let agreementTotal = 0;\n461:     // Per-row results sit beside the totals because a total can hold still\n462:     // while one row is gained and another lost, and a changed label has to\n463:     // surface under the id of the row it belongs to.\n464:     const rows = {};\n465:     // Attached reach: what a hub's own route adds on the same rows, split the\n466:     // same way, plus the rows that had to stay silent and the ties a bridge\n467:     // leaves with its own owner.\n468:     const attachedRows = {};\n469:     // A typed command reaches the reader through the recommendation that leads,\n[Output truncated. Continue reading with offset: 470]","title":"read","metadata":{"metadata":{"truncated":true},"content":[{"type":"text","text":"Read file .skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/capture-command-routing-baseline.mjs, lines 330-469\n330:   if (namespace === null) return undefined;\n331:   if (!byFamily.has(namespace)) {\n332:     byFamily.set(namespace, { tune: emptyAttachedTally(), holdout: emptyAttachedTally() });\n333:   }\n334:   return byFamily.get(namespace);\n335: }\n336: \n337: function readHeadSha(workspaceRoot) {\n338:   const spawned = spawnSync('git', ['rev-parse', '--short', 'HEAD'], { cwd: workspaceRoot, encoding: 'utf8' });\n339:   return spawned.status === 0 ? spawned.stdout.trim() : 'unknown';\n340: }\n341: \n342: // ───────────────────────────────────────────────────────────────────\n343: // 6. CORE LOGIC\n344: // ───────────────────────────────────────────────────────────────────\n345: \n346: export async function scoreCommandCorpus(options = {}) {\n347:   const realEmbedding = options.realEmbedding === true;\n348:   const RealDate = Date;\n349:   // The projection needs an existing, empty cache directory, and that directory\n350:   // is scratch space this run owns. It is created before the `try` so a failure\n351:   // to create it has