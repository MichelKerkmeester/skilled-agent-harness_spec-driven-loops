":false,"exit":0},"content":[{"type":"text","text":"087888ec4a\n087888ec4a\nsha256:698da57b02159a756dbba5d6a2c9a3c6d14588d07e96be268567835cf36448b8\n{\"commandMetadata\":27,\"doctorRoutes\":36,\"generated\":63,\"typescriptActive\":46,\"pythonActive\":52}\n---six prompts with expected---\ncmd-create-skill-parent-plain-tune-01 | /create:skill-parent | sk-doc | start\ncmd-doctor-install-plain-tune-01 | /doctor:install | system-skilled-doctor | run\ncmd-doctor-setup-plain-tune-01 | /doctor:setup | system-skilled-doctor | run\ncmd-doctor-speckit-plain-tune-01 | /doctor:speckit | system-skilled-doctor | run\ncmd-doctor-update-plain-tune-01 | /doctor:update | system-skilled-doctor | run\ncmd-speckit-search-plain-tune-01 | /speckit:search | system-spec-kit | run\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"cd /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research && git rev-parse --short HEAD; jq -r '.capturedAtSha, .corpusSha256, (.bridgeCounts|tostring)' specs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/009-ux-performance-cross-cli-research/research/lineages/embed-text-4/scratch/before-capture.json; echo \\\"---six prompts with expected---\\\"; node -e \\\"\\nconst fs=require('fs');\\nconst rows=fs.readFileSync('.skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/command-prompts.jsonl','utf8').trim().split('\\\\n').map(JSON.parse);\\nfor (const r of rows){ if(/^(cmd-doctor-install|cmd-doctor-setup|cmd-doctor-speckit|cmd-doctor-update|cmd-speckit-search|cmd-create-skill-parent)-plain-tune-01$/.test(r.id)) console.log([r.id,r.expected_command,r.expected_top,r.expected_policy].join(' | ')); }\\n\\\"\"}"},"time":{"start":1794570567409,"end":1794570569493}}}}
