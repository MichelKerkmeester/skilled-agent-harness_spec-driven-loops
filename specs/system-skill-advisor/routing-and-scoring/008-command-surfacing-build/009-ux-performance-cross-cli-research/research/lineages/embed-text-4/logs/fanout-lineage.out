n      \"order\": 2,\n      \"skill\": \"create-skill\",\n      \"resource\": \".skilled/skills/sk-doc/sk-create-skill/SKILL.md\",\n      \"action\": \"load the parent-hub scaffolding mode contract, then apply the workflow to $ARGUMENTS\"\n    },\n    {\n      \"order\": 3,\n      \"skill\": \"create-skill\",\n      \"resource\": \".skilled/commands/create/assets/create-skill-parent-presentation.txt\",\n      \"action\": \"load the command presentation contract before resolving setup and execution mode\"\n    }\n  ],\n  \"discriminator\": {\n    \"whenToUse\": \"Use this command when the deliverable is a parent skill hub with nested workflow or surface packets.\",\n    \"preferSiblingWhen\": [\n      {\n        \"sibling\": \"/create:skill\",\n        \"when\": \"Prefer the standalone command when the deliverable is one skill package without a multi-packet hub.\"\n      }\n    ]\n  }\n}\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"/create:skill, /create:skill-parent, /create:readme, /create:agent, /create:command, /create:feature-catalog, /create:manual-testing-playbook, /create:benchmark, /create:changelog, /create:diff, /create:repo-rule, /create:with-human-voice, /create:goal\n{\n  \"command\": \"/create:skill-parent\",\n  \"ownerMode\": \"sk-create-skill-parent\",\n  \"description\": \"Scaffold a parent skill with nested mode packets (one hub identity, registry source of truth). :auto/:confirm.\",\n  \"argumentHint\": \"<skill-name> [create|update] [--modes <mode1,mode2,...>] [--surfaces <s1,s2,...>] [--path <dir>] [:auto|:confirm]\",\n  \"mutating\": \"mutates\",\n  \"gate3_location\": \"a parent skill hub with nested mode packets, one graph-metadata.json, at the resolved --path\",\n  \"userIntent\": {\n    \"job\": \"I want to scaffold or update a parent skill hub with nested mode packets.\",\n    \"ownedSignals\": [\n      \"create a parent skill hub\",\n      \"add nested mode packets\",\n      \"scaffold a skill router\"\n    ]\n  },\n  \"choreography\": [\n    {\n      \"order\": 1,\n      \"skill\": \"sk-doc\",\n      \"resource\": \".skilled/skills/sk-doc/SKILL.md\",\n      \"action\": \"load the sk-doc parent hub routing table\"\n    },\n    {\n      \"order\": 2,\n      \"skill\": \"create-skill\",\n      \"resource\": \".skilled/skills/sk-doc/sk-create-skill/SKILL.md\",\n      \"action\": \"load the parent-hub scaffolding mode contract, then apply the workflow to $ARGUMENTS\"\n    },\n    {\n      \"order\": 3,\n      \"skill\": \"create-skill\",\n      \"resource\": \".skilled/commands/create/assets/create-skill-parent-presentation.txt\",\n      \"action\": \"load the command presentation contract before resolving setup and execution mode\"\n    }\n  ],\n  \"discriminator\": {\n    \"whenToUse\": \"Use this command when the deliverable is a parent skill hub with nested workflow or surface packets.\",\n    \"preferSiblingWhen\": [\n      {\n        \"sibling\": \"/create:skill\",\n        \"when\": \"Prefer the standalone command when the deliverable is one skill package without a multi-packet hub.\"\n      }\n    ]\n  }\n}\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"cd /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research && node -e \\\"\\nconst fs=require('fs');\\nconst j=JSON.parse(fs.readFileSync('.skilled/skills/sk-doc/command-metadata.json','utf8'));\\nconsole.log(j.map(c=>c.name||c.command||c.id).join(', '));\\nconst skp=j.find(c=>(c.name||c.command||c.id||'').includes('skill-parent'));\\nconsole.log(JSON.stringify(skp,null,2));\\n\\\"\"}"},"time":{"start":1794570163921,"end":1794570164311}}}}
