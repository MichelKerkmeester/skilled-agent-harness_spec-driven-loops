dPinnedScoringDate();\n381:     const scoringInstant = Date.parse(`${capturedAt}T00:00:00Z`);\n382:     globalThis.Date = class extends RealDate {\n383:       constructor(...args) {\n384:         if (args.length === 0) super(scoringInstant);\n385:         else super(...args);\n386:       }\n387: \n388:       static now() {\n389:         return scoringInstant;\n390:       }\n391:     };\n392: \n393:     if (!existsSync(FUSION_MODULE)) {\n394:       throw new Error(`built scorer file missing: ${FUSION_MODULE}`);\n395:     }\n396:     for (const modulePath of [COMMAND_ATTACH_MODULE, COMPILED_ROUTING_FLAG_MODULE, PROMPT_POLICY_MODULE]) {\n397:       if (!existsSync(modulePath)) {\n398:         throw new Error(`built command-attach file missing: ${modulePath}`);\n399:       }\n400:     }\n401: \n402:     // Imported after the clock is pinned so the compiled scorer initializes\n403:     // against the pinned date, and only after it is known to exist so a missing\n404:     // build is reported as such rather than as a module-resolution failure.\n405:     const { scoreAdvisorPrompt } = await import(pathToFileURL(FUSION_MODULE).href);\n406:     const { findAdvisorWorkspaceRoot } = await import(pathToFileURL(WORKSPACE_ROOT_MODULE).href);\n407:     const { attachCommand, typedCommandForTop, TRACKED_COMMANDS, routeNeedsMode } = await import(pathToFileURL(COMMAND_ATTACH_MODULE).href);\n408:     const { extractMetalinguisticSkillMentions } = await import(pathToFileURL(PROMPT_POLICY_MODULE).href);\n409:     const { COMPILED_ROUTING_HUBS } = await import(pathToFileURL(COMPILED_ROUTING_FLAG_MODULE).href);\n410:     const workspaceRoot = findAdvisorWorkspaceRoot(HERE, { maxDepth: 14, sentinel: SENTINEL });\n411: \n412:     // A missing front door would make every spawn fail and report the same zero\n413:     // as a hub with nothing to attach, so it fails the capture instead.\n414:     if (!existsSync(resolve(workspaceRoot, COMPILED_ROUTE_CLI))) {\n415:       throw new Error(`compiled route front door missing: ${resolve(workspaceRoot, COMPILED_ROUTE_CLI)}`);\n416:     }\n417: \n418:     // A build older than its source scores code that no longer exists, so its\n419:     // numbers would describe a scorer nobody can read. Refuse it, and likewise\n420:     // a build whose freshness cannot be assessed.\n421:     const { checkPackageFreshness } = createRequire(import.meta.url)(DIST_FRESHNESS_MODULE);\n422:     const freshness = checkPackageFreshness('system-skill-advisor/runtime', { workspaceRoot });\n423:     if (freshness.status !== 'fresh') {\n424:       throw new Error(freshness.message);\n425:     }\n426: \n427:     // Real scoring is the only mode that reads this machine, so it is the only one\n428:     // that has to prove the machine can answer before walking the corpus. Without\n429:     // the flag nothing here runs and the prompt embedding is the direct call below.\n430:     const embedPrompt = realEmbedding ? await prepareRealEmbeddingScoring() : null;\n431: \n432:     const commandNames = readCommandFileNames(workspaceRoot);\n433:     const commandSet = new Set(commandNames);\n434:     const { bridgeCounts, idToCommand } = readBridgeMap(BRIDGES_JSON);\n435:     const corpus = readCorpus(CORPUS_JSONL);\n436: \n437:     // A label naming a command that does not exist would silently score as a\n438:     // permanent miss, so it fails the capture instead of deflating a metric.\n439:     for (const row of corpus) {\n440:       if (row.expected_command === null || row.expected_command === undefined) continue;\n441:       if (!commandSet.has(row.expected_command)) {\n442:         throw new Error(`corpus row ${row.id} expects ${row.expected_command}, which is not a command file under ${resolve(workspaceRoot, COMMANDS_DIR)}`);\n443:       }\n444:     }\n445: \n446:     const perCommand = new Map();\n447:     for (const command of commandNames) {\n448:       perCommand.set(command, { typed: emptyTally(), plain: { tune: emptyTally(), holdout: emptyTally() } });\n449:     }\n450: \n451:     const typed = emptyTally();\n452:     const plain = { tune: emptyTally(), holdout: emptyTally() };\n453:     let falseOfferCount = 0;\n454:     let falseOfferTotal = 0;\n455:     let slashReachedTop3 = 0;\n456:     let slashNamedTotal = 0;\n457:     let slashOfferedOnPartial = 0;\n458:     let slashPartialTotal = 0;\n459:     let agreementCorrect = 0;\n460:     let agreementTotal = 0;\n461:     // Per-row results sit beside the totals because a total can hold still\n462:     // while one row is gained and another lost, and a changed label has to\n463:     // surface under the id of the row it belongs to.\n464:     const rows = {};\n465:     // Attached reach: what a hub's own route adds on the same rows, split the\n466:     // same way, plus the rows that had to stay silent and the ties a bridge\n467:     // leaves with its own owner.\n468:     const attachedRows = {};\n469:     // A typed command reaches the reader through the recommendation that leads,\n[Output truncated. Continue reading with offset: 470]"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\".skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/capture-command-routing-baseline.mjs\",\"offset\":330,\"limit\":140}"},"time":{"start":1794570130720,"end":1794570131093}}}}
