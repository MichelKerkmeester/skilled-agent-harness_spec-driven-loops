n    \"convergenceScore\": 0.35,\n    \"coverageBySources\": {\n      \"code\": 25,\n      \"other\": 18\n    },\n    \"completedPivots\": 0,\n    \"failedPivots\": 0,\n    \"pivotOverrides\": 0\n  }\n}\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"cd /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research && RUN_DIR=\\\"specs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/009-ux-performance-cross-cli-research/research/lineages/embed-text-4\\\" && jq '{open:(.openQuestions|length),answered:(.answeredQuestions|length),keyFindings:(.keyFindings|length),openFindings:(.openFindings|length),metrics:.metrics}' \\\"$RUN_DIR/findings-registry.json\\\" 2>/dev/null || jq 'keys' \\\"$RUN_DIR/findings-registry.json\\\"\"}"},"time":{"start":1794571268601,"end":1794571269861}}}}
