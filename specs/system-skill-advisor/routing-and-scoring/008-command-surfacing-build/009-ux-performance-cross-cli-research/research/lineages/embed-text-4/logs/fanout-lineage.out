hall()\n    h=hashlib.sha256()\n    for r in rows: h.update(repr(r).encode())\n    db.close(); return len(rows), h.hexdigest()[:16]\nfor table,key in [('vec_768','skill_id'),('vec_cmd_768','command_id')]:\n    print(table, 'before', digest(f\"{base}/db-before/skill-graph.sqlite\",table,key))\n    print(table, 'after ', digest(f\"{base}/db-after/skill-graph.sqlite\",table,key))\nPY","timeout":600000},"output":"before-capture.json {\"typed\":{\"correct\":24,\"total\":44},\"tune\":{\"correct\":13,\"total\":45},\"holdout\":{\"correct\":3,\"total\":44},\"falseOffer\":{\"count\":0,\"total\":35},\"combinedTune\":28}\nbefore-capture-rerun.json {\"typed\":{\"correct\":24,\"total\":44},\"tune\":{\"correct\":13,\"total\":45},\"holdout\":{\"correct\":3,\"total\":44},\"falseOffer\":{\"count\":0,\"total\":35},\"combinedTune\":28}\nafter-capture.json {\"typed\":{\"correct\":24,\"total\":44},\"tune\":{\"correct\":18,\"total\":45},\"holdout\":{\"correct\":5,\"total\":44},\"falseOffer\":{\"count\":0,\"total\":35},\"combinedTune\":33}\nafter-capture-rerun.json {\"typed\":{\"correct\":24,\"total\":44},\"tune\":{\"correct\":18,\"total\":45},\"holdout\":{\"correct\":5,\"total\":44},\"falseOffer\":{\"count\":0,\"total\":35},\"combinedTune\":33}\n---table parity---\nvec_768 before (14, '4f355d8ecde8d730')\nvec_768 after  (14, '4f355d8ecde8d730')\nvec_cmd_768 before (46, '064a29fea6823f48')\nvec_cmd_768 after  (46, 'c630d333d61b9a60')\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"before-capture.json {\"typed\":{\"correct\":24,\"total\":44},\"tune\":{\"correct\":13,\"total\":45},\"holdout\":{\"correct\":3,\"total\":44},\"falseOffer\":{\"count\":0,\"total\":35},\"combinedTune\":28}\nbefore-capture-rerun.json {\"typed\":{\"correct\":24,\"total\":44},\"tune\":{\"correct\":13,\"total\":45},\"holdout\":{\"correct\":3,\"total\":44},\"falseOffer\":{\"count\":0,\"total\":35},\"combinedTune\":28}\nafter-capture.json {\"ty