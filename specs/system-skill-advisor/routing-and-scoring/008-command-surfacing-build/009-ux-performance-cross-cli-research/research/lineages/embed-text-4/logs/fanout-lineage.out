{"type":"tool_use","timestamp":1794570136064,"sessionID":"ses_e2b4abd5affeHy554lSqReHMR4","part":{"partID":"prt_1d4b7265c001GeFcsW5q0iMkOt","sessionID":"ses_e2b4abd5affeHy554lSqReHMR4","messageID":"msg_1d4b71cc2001kwyqycXIW2x00i","type":"tool","id":"call_c9d16a62c1004574940233fa","tool":"read","state":{"status":"completed","input":{"limit":120,"offset":121,"path":".skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/capture-command-routing-baseline.mjs"},"output":"Read file .skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/capture-command-routing-baseline.mjs, lines 121-240\n121:   }\n122:   return recorded;\n123: }\n124: \n125: // ───────────────────────────────────────────────────────────────────\n126: // 4. REAL EMBEDDING PREFLIGHT\n127: // ───────────────────────────────────────────────────────────────────\n128: //\n129: // A real capture scores whatever this machine's cosine lane can see, so both\n130: // halves of that lane are proved before a single row is scored: an embedder that\n131: // answers and a populated command vector table. Each half is named as itself when\n132: // it is missing, because a silent cosine lane reads exactly like a scoring change.\n133: \n134: async function assertEmbedderAnswers() {\n135:   const listed = [];\n136:   try {\n137:     const response = await fetch(EMBEDDER_TAGS_URL, { signal: AbortSignal.timeout(EMBEDDER_PROBE_TIMEOUT_MS) });\n138:     if (!response.ok) throw new Error(`HTTP ${response.status}`);\n139:     const payload = await response.json();\n140:     for (const model of Array.isArray(payload?.models) ? payload.models : []) {\n141:       if (typeof model?.name === 'string') listed.push(model.name);\n142:     }\n143:   } catch (error) {\n144:     const message = error instanceof Error ? error.message : String(error);\n145:     throw new Error(`real embedding needs a live embedder: GET ${EMBEDDER_TAGS_URL} failed (${message})`);\n146:   }\n147:   // The stored vectors were built with this model family, so a daemon serving some\n148:   // other model cannot answer them no matter how well the dimensions line up.\n149:   if (!listed.some((name) => name.startsWith(EMBEDDER_MODEL_PREFIX))) {\n150:     throw new Error(`real embedding needs an embedder serving ${EMBEDDER_MODEL_PREFIX}*: GET ${EMBEDDER_TAGS_URL} lists ${listed.length > 0 ? listed.join(', ') : 'no models'}`);\n151:   }\n152: }\n153: \n154: function assertCommandVectorsPresent(database, databasePath) {\n155:   if (!database) {\n156:     throw new Error(`real embedding needs command vectors: the skill graph database is absent (${databasePath})`);\n157:   }\n158:   // GLOB keeps the trailing underscore of the prefix literal, so the match is the\n159:   // `vec_cmd_<dim>` family alone rather than any name shaped like it.\n160:   const tables = database\n161:     .prepare(\"SELECT name FROM sqlite_master WHERE type = 'table' AND name GLOB ?\")\n162:     .all(`${COMMAND_VECTOR_TABLE_PREFIX}*`)\n163:     .map((table) => table.name);\n164:   if (tables.length === 0) {\n165:     throw new Error(`real embedding needs command vectors: no ${COMMAND_VECTOR_TABLE_PREFIX}* table in ${databasePath}`);\n166:   }\n167:   const populated = tables.filter((name) => database.prepare(`SELECT COUNT(*) AS rowCount FROM \"${name}\"`).get().rowCount > 0);\n168:   if (populated.length === 0) {\n169:     throw new Error(`real embedding needs command vectors: ${tables.join(', ')} has no rows in ${databasePath}`);\n170:   }\n171: }\n172: \n173: // The wrapper, the embedder and the command vectors are resolved together because\n174: // a real capture needs all three or it measures nothing worth reporting.\n175: async function prepareRealEmbeddingScoring() {\n176:   if (!existsSync(SEMANTIC_SHADOW_MODULE)) {\n177:     throw new Error(`built semantic-shadow file missing: ${SEMANTIC_SHADOW_MODULE}`);\n178:   }\n179:   const { withSemanticShadowPromptEmbedding } = await import(pathToFileURL(SEMANTIC_SHADOW_MODULE).href);\n180:   const { getDbReadOnly, getSkillGraphDbPath } = await import(pathToFileURL(SKILL_GRAPH_DB_MODULE).href);\n181:   await assertEmbedderAnswers();\n182:   assertCommandVectorsPresent(getDbReadOnly(), getSkillGraphDbPath());\n183:   return withSemanticShadowPromptEmbedding;\n184: }\n185: \n186: // ───────────────────────────────────────────────────────────────────\n187: // 5. HELPERS\n188: // ───────────────────────────────────────────────────────────────────\n189: \n190: function sha256File(path) {\n191:   return `sha256:${createHash('sha256').update(readFileSync(path)).digest('hex')}`;\n192: }\n193: \n194: // Line numbers are reported as the physical line a bad row sits on, so a\n195: // parse failure points at the line to repair rather than at a row ordinal.\n196: function readCorpus(path) {\n197:   if (!existsSync(path)) throw new Error(`corpus file missing: ${path}`);\n198:   const lines = readFileSync(path, 'utf8').split('\\n');\n199:   const rows = [];\n200:   for (let index = 0; index < lines.length; index += 1) {\n201:     const line = lines[index].trim();\n202:     if (line === '') continue;\n203:     try {\n204:       rows.push(JSON.parse(line));\n205:     } catch (error) {\n206:       throw new Error(`invalid JSON on corpus line ${index + 1} of ${path}: ${error.message}`);\n207:     }\n208:   }\n209:   if (rows.length === 0) throw new Error(`corpus file empty: ${path}`);\n210:   return rows;\n211: }\n212: \n213: // Commands live exactly two levels deep, `<namespace>/<name>.md`, and become\n214: // `/<namespace>:<name>`. Anything directly in the commands root is a document\n215: // rather than a command, and deeper nesting is a command's own assets.\n216: function readCommandFileNames(workspaceRoot) {\n217:   const commandsRoot = resolve(workspaceRoot, COMMANDS_DIR);\n218:   const commands = [];\n219:   for (const namespace of readdirSync(commandsRoot, { withFileTypes: true })) {\n220:     if (!namespace.isDirectory()) continue;\n221:     for (const file of readdirSync(join(commandsRoot, namespace.name), { withFileTypes: true })) {\n222:       if (!file.isFile()) continue;\n223:       if (!file.name.endsWith(COMMAND_DOC_SUFFIX) || file.name === COMMAND_DOC_SKIP) continue;\n224:       commands.push(`/${namespace.name}:${file.name.slice(0, -COMMAND_DOC_SUFFIX.length)}`);\n225:     }\n226:   }\n227:   return commands.sort();\n228: }\n229: \n230: // The TypeScript inventory id is what the scorer actually emits, and it differs\n231: // from the human command name, so the bridge id is the map key. A command with\n232: // only the Python runtime enabled has no TypeScript id to emit and is reported\n233: // as unreachable instead.\n234: function readBridgeMap(path) {\n235:   const bridges = JSON.parse(readFileSync(path, 'utf8'));\n236:   const idToCommand = new Map();\n237:   for (const entry of bridges.entries ?? []) {\n238:     const typescript = entry.runtime?.typescript;\n239:     if (typescript?.enabled !== true || typeof typescript.id !== 'string') continue;\n240:     idToCommand.set(typescript.id, { command: entry.command, skillId: entry.skillId });\n[Output truncated. Continue reading with offset: 241]","title":"read","metadata":{"metadata":{"truncated":true},"content":[{"type":"text","text":"Read file .skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/capture-command-routing-baseline.mjs, lines 121-240\n121:   }\n122:   return recorded;\n123: }\n124: \n125: // ───────────────────────────────────────────────────────────────────\n126: // 4. REAL EMBEDDING PREFLIGHT\n127: // ───────────────────────────────────────────────────────────────────\n128: //\n129: // A real capture scores whatever this machine's cosine lane can see, so both\n130: // halves of that lane are proved before a single row is scored: an embedder that\n131: // answers and a populated command vector table. Each half is named as itself when\n132: // it is missing, because a silent cosine lane reads exactly like a scoring change.