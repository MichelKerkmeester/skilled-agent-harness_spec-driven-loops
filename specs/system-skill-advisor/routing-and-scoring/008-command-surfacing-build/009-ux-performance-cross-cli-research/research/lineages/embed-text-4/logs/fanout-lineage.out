so a hub that adds or renames a mode\n.skilled/skills/system-skill-advisor/runtime/lib/command-attach.ts:25:    'sk-create-command': '/create:command',\n.skilled/skills/system-skill-advisor/runtime/lib/command-attach.ts:44:// One row of the command table: the runnable slash command, the policy that says\n.skilled/skills/system-skill-advisor/runtime/lib/command-attach.ts:49:  readonly command: string;\n.skilled/skills/system-skill-advisor/runtime/lib/command-attach.ts:55:// The table below covers every tracked command, whether or not its bridge is\n.skilled/skills/system-skill-advisor/runtime/lib/command-attach.ts:56:// active, so a typed command always has a policy and an owner. `scorerRow` says\n.skilled/skills/system-skill-advisor/runtime/lib/command-attach.ts:57:// whether a scorer can also return the command on its own.\n.skilled/skills/system-skill-advisor/runtime/lib/command-attach.ts:66:  'command-create-agent': { command: '/create:agent', policy: 'start', mutating: 'mutates', ownerSkillId: 'sk-doc' },\n.skilled/skills/system-skill-advisor/runtime/lib/command-attach.ts:67:  'command-create-changelog': { command: '/create:changelog', policy: 'ask', mutating: 'mutates', ownerSkillId: 'sk-doc' },\n.skilled/skills/system-skill-advisor/runtime/lib/command-attach.ts:68:  'command-create-feature-catalog': { command: '/create:feature-catalog', policy: 'start', mutating: 'mutates', ownerSkillId: 'sk-doc' },\n.skilled/skills/system-skill-advisor/runtime/lib/command-attach.ts:69:  'command-create-manual-testing-playbook': { command: '/create:manual-testing-playbook', policy: 'start', mutating: 'mutates', ownerSkillId: 'sk-doc' },\n.skilled/skills/system-skill-advisor/runtime/lib/command-attach.ts:70:  'command-create-readme': { command: '/create:readme', policy: 'start', mutating: 'mutates', ownerSkillId: 'sk-doc' },\n.skilled/skills/system-skill-advisor/runtime/lib/command-attach.ts:71:  'command-create-skill': { command: '/create:skill', policy: 'start', mutating: 'mutates', ownerSkillId: 'sk-doc' },\n.skilled/skills/system-skill-advisor/runtime/lib/command-attach.ts:72:  'command-deep-research': { command: '/deep:research', policy: 'ask', mutating: 'mutates', ownerSkillId: 'system-deep-loop' },\n.skilled/skills/system-skill-advisor/runtime/lib/command-attach.ts:73:  'command-deep-review': { command: '/deep:review', policy: 'ask', mutating: 'mutates', ownerSkillId: 'system-deep-loop' },\n.skilled/skills/system-skill-advisor/runtime/lib/command-attach.ts:74:  'command-doctor-agents-md-check': { command: '/doctor:agents-md check', policy: 'run', mutating: 'read-only', ownerSkillId: 'system-skilled-doctor' },\n.skilled/skills/system-skill-advisor/runtime/lib/command-attach.ts:75:  'command-doctor-agents-md-embed': { command: '/doctor:agents-md embed', policy: 'ask', mutating: 'mutates', ownerSkillId: 'system-skilled-doctor' },\n.skilled/skills/system-skill-advisor/runtime/lib/command-attach.ts:76:  'command-doctor-agents-md-restore': { command: '/doctor:agents-md restore', policy: 'ask', mutating: 'mutates', ownerSkillId: 'system-skilled-doctor' },\n.skilled/skills/system-skill-advisor/runtime/lib/command-attach.ts:77:  'command-doctor-ci-report': { command: '/doctor:ci report', policy: 'run', mutating: 'read-only', ownerSkillId: 'sk-code' },\n.skilled/skills/system-skill-advisor/runtime/lib/command-attach.ts:78:  'command-doctor-ci-scaffold': { command: '/doctor:ci scaffold', policy: 'ask', mutating: 'mutates', ownerSkillId: 'sk-code' },\n.skilled/skills/system-skill-advisor/runtime/lib/command-attach.ts:79:  'command-doctor-ci-toggle': { command: '/doctor:ci toggle', policy: 'ask', mutating: 'mutates', ownerSkillId: 'sk-code' },\n.skilled/skills/system-skill-advisor/runtime/lib/command-attach.ts:80:  'command-doctor-deep-loop': { command: '/doctor:deep-loop', policy: 'run', mutating: 'add-only', ownerSkillId: 'system-deep-loop' },\n.skilled/skills/system-skill-advisor/runtime/lib/command-attach.ts:81:  'command-doctor-env': { command: '/doctor:env list', policy: 'run', mutating: 'read-only', ownerSkillId: 'system-skilled-doctor' },\n.skilled/skills/system-skill-advisor/runtime/lib/command-attach.ts:82:  'command-doctor-git-hooks': { command: '/doctor:git hooks', policy: 'ask', mutating: 'mutates', ownerSkillId: 'sk-git' },\n.skilled/skills/system-skill-advisor/runtime/lib/command-attach.ts:83:  'command-doctor-git-setup': { command: '/doctor:git setup', policy: 'run', mutating: 'read-only', ownerSkillId: 'sk-git' },\n.skilled/skills/system-skill-advisor/runtime/lib/command-attach.ts:84:  'command-doctor-git-standards': { command: '/doctor:git standards', policy: 'ask', mutating: 'mutates', ownerSkillId: 'sk-git' },\n.skilled/skills/system-skill-advisor/runtime/lib/command-attach.ts:85:  'command-doctor-helper': { command: '/doctor:helper', policy: 'run', mutating: 'read-only', ownerSkillId: 'system-skilled-doctor' },\n.skilled/skills/system-skill-advisor/runtime/lib/command-attach.ts:86:  'command-doctor-install': { command: '/doctor:install', policy: 'run', mutating: 'read-only', ownerSkillId: 'system-skilled-doctor' },\n.skilled/skills/system-skill-advisor/runtime/lib/command-attach.ts:87:  'command-doctor-mcp-debug': { command: '/doctor:mcp debug', policy: 'ask', mutating: 'mutates', ownerSkillId: 'system-skilled-doctor' },\n.skilled/skills/system-skill-advisor/runtime/lib/command-attach.ts:88:  'command-doctor-mcp-install': { command: '/doctor:mcp install', policy: 'ask', mutating: 'mutates', ownerSkillId: 'system-skilled-doctor' },\n.skilled/skills/system-skill-advisor/runtime/lib/command-attach.ts:89:  'command-doctor-overlay-apply': { command: '/doctor:overlay apply', policy: 'ask', mutating: 'mutates', ownerSkillId: 'system-skilled-doctor' },\n.skilled/skills/system-skill-advisor/runtime/lib/command-attach.ts:90:  'command-doctor-overlay-repin': { command: '/doctor:overlay repin', policy: 'ask', mutating: 'mutates', ownerSkillId: 'system-skilled-doctor' },\n.skilled/skills/system-sk