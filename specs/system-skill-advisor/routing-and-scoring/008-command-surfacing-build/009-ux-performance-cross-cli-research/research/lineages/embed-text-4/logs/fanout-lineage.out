 python3 - <<'PY'\\nimport sqlite3, hashlib\\nbase=\\\"specs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/009-ux-performance-cross-cli-research/research/lineages/embed-text-4/scratch\\\"\\ndef digest(path, table, key):\\n    db=sqlite3.connect(path)\\n    rows=db.execute(f\\\"select {key}, embedding, model_id, content_hash from {table} order by {key}\\\").fetchall()\\n    h=hashlib.sha256()\\n    for r in rows: h.update(repr(r).encode())\\n    db.close(); return len(rows), h.hexdigest()[:16]\\nfor table,key in [('vec_768','skill_id'),('vec_cmd_768','command_id')]:\\n    print(table, 'before', digest(f\\\"{base}/db-before/skill-graph.sqlite\\\",table,key))\\n    print(table, 'after ', digest(f\\\"{base}/db-after/skill-graph.sqlite\\\",table,key))\\nPY\",\"timeout\":600000}"},"time":{"start":1794570783308,"end":1794570804373}}}}
