f ${denominator}`;\n2189: }\n2190: \n2191: // Two counts alone cannot say how much of the rate is the arm's size, so each rate\n2192: // carries the interval a 95 percent Wilson score puts around it. A rate whose arm\n2193: // scored nothing has no interval to carry.\n2194: export function wilsonRange(successes, total) {\n2195:   if (total === 0) return null;\n2196:   const z = 1.96;\n2197:   const observed = successes / total;\n2198:   const zSquared = z * z;\n2199:   const denominator = 1 + zSquared / total;\n2200:   const centre = (observed + zSquared / (2 * total)) / denominator;\n2201:   const spread = (z * Math.sqrt((observed * (1 - observed)) / total\n2202:     + zSquared / (4 * total * total))) / denominator;\n2203:   const bound = (value) => Math.min(1, Math.max(0, Math.round(value * 100) / 100));\n2204:   return { low: bound(centre - spread), high: bound(centre + spread) };\n2205: }\n2206: \n2207: // Two arms that differ only in the advisor can still split their wins by chance, so\n2208: // the pair counts are read against the exact one-sided tail of the sign test rather\n2209: // than a normal approximation. Integer arithmetic keeps the tail exact at the sizes\n2210: // an arm reports, and the result is rounded to the four decimals a printed p carries.\n2211: export function signTestP(gained, lost) {\n2212:   const pairs = gained + lost;\n2213:   if (pairs === 0) return null;\n2214:   let tail = 0n;\n2215:   let coefficient = 1n;\n2216:   for (let k = 0; k <= pairs; k += 1) {\n2217:     if (k >= gained) tail += coefficient;\n2218:     coefficient = (coefficient * BigInt(pairs - k)) / BigInt(k + 1);\n2219:   }\n2220:   const total = 2n ** BigInt(pairs);\n2221:   const tenThousandths = (tail * 10000n + total / 2n) / total;\n2222:   return Number(tenThousandths) / 10000;\n2223: }\n2224: \n2225: function tallyBlock(tally) {\n2226:   return {\n2227:     runs: tally.runs,\n2228:     scored: tally.scored,\n2229:     capped: tally.capped,\n2230:     unscored: tally.unscored,\n2231:     unscoredRuns: tally.unscoredRuns,\n2232:     startRate: rate(tally.started, tally.startRows),\n2233:     cappedStartRows: tally.cappedStartRows,\n2234:     offered: tally.offered,\n2235:     cappedOfferRows: tally.cappedOfferRows,\n2236:     startedOfOffered: tally.startedOfOffered,\n2237:     offerFieldAbsent: tally.offerFieldAbsent,\n2238:     offeredAsPartner: tally.offeredAsPartner,\n2239:     offerReached: tally.offerReached,\n2240:     deliveryUnknown: tally.deliveryUnknown,\n2241:     offerSeen: tally.offerSeen,\n2242:     offerDeclined: tally.offerDeclined,\n2243:     commandLineRate: rate(tally.commandLineRuns, tally.scored),\n2244:     unsafe: tally.unsafe,\n2245:     unsafeNoChangedPath: tally.unsafeNoChangedPath,\n2246:     repeatedCommandLines: tally.repeatedCommandLines,\n2247:     loopsWithoutInit: tally.loopsWithoutInit,\n2248:     loops: tally.loops,\n2249:     workflow: {\n2250:       command: tally.workflow.command,\n2251:       skill: tally.workflow.skill,\n2252:       asked: tally.workflow.asked,\n2253:       askedActed: tally.workflow.askedActed,\n2254:       otherMode: tally.workflow.otherMode,\n2255:       improvised: tally.workflow.improvised,\n2256:       none: tally.workflow.none,\n2257:       noneActed: tally.workflow.noneActed,\n2258:       noOwner: tally.workflow.noOwner,\n2259:       unscored: tally.unscored,\n2260:       // The load rate is the outcome reading: every owned run the arm scored is in\n2261:       // its denominator, so a run that skipped the workflow and wrote nothing cannot\n2262:       // leave the count the way it leaves the share.\n2263:       loadRate: rate(\n2264:         tally.workflow.command + tally.workflow.skill,\n2265:         tally.workflow.command + tally.workflow.skill + tally.workflow.asked + tally.workflow.otherMode + tally.workflow.improvised + tally.workflow.none,\n2266:       ),\n2267:       followedRate: rate(\n2268:         tally.workflow.command + tally.workflow.skill + tally.workflow.asked,\n2269:         tally.workflow.command + tally.workflow.skill + tally.workflow.asked + tally.workflow.otherMode + tally.workflow.improvised + tally.workflow.none,\n2270:       ),\n2271:       // The same followed counts are read again within each group the offer puts a run\n2272:       // in, because a run the head never offered the command to cannot follow that offer.\n2273:       followedOffered: rate(\n2274:         tally.followedByOffer.offered.followed,\n2275:         tally.followedByOffer.offered.total,\n2276:       ),\n2277:       followedNotOffered: rate(\n2278:         tally.followedByOffer.notOffered.followed,\n2279:         tally.followedByOffer.notOffered.total,\n2280:       ),\n2281:       offerUnknown: tally.followedByOffer.unknown,\n2282:       share: rate(\n2283:         tally.workflow.command + tally.workflow.skill,\n2284:         tally.workflow.command + tally.workflow.skill + tally.workflow.improvised,\n2285:       ),\n2286:       // The rate keeps its text and the interval sits beside it, so a reader can tell\n2287:       // a clean arm from a large one without parsing the counts back out.\n2288:       followedRange: wilsonRange(\n2289:         tally.workflow.command + tally.workflow.skill + tally.workflow.asked,\n2290:         tally.workflow.command + tally.workflow.skill + tally.workflow.asked + tally.workflow.otherMode + tally.workflow.improvised + tally.workflow.none,\n2291:       ),\n2292:       loadRange: wilsonRange(\n2293:         tally.workflow.command + tally.workflow.skill,\n2294:         tally.workflow.command + tally.workflow.skill + tally.workflow.asked + tally.workflow.otherMode + tally.workflow.improvised + tally.workflow.none,\n2295:       ),\n2296:     },\n2297:     byPolicy: Object.fromEntries(\n2298:       POLICY_KEYS.map((key) => [key, { ...tally.byPolicy[key] }]),\n2299:     ),\n[Output truncated. Continue reading with offset: 2300]","title":"read","metadata":{"metadata":{"truncated":true},"content":[{"type"