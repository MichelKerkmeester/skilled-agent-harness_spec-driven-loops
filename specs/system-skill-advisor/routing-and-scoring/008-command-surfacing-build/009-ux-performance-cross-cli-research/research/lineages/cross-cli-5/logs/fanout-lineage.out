N.stringify(payload),\n118:       encoding: 'utf8',\n119:       timeout: timeoutMs,\n120:       maxBuffer: MAX_OUTPUT_BYTES,\n121:     });\n122:   } catch {\n123:     return failedOffer('hook_failed');\n124:   }\n125: \n126:   if (result.error || result.status !== 0 || typeof result.stdout !== 'string') {\n127:     return failedOffer('hook_failed');\n128:   }\n129: \n130:   let output;\n131:   try {\n132:     output = JSON.parse(result.stdout);\n133:   } catch {\n134:     return failedOffer('hook_failed');\n135:   }\n136: \n137:   const context = output?.hookSpecificOutput?.additionalContext;\n138:   if (typeof context !== 'string') {\n139:     return failedOffer('no_head');\n[Output truncated. Continue reading with offset: 140]","title":"read","metadata":{"metadata":{"truncated":true},"content":[{"type":"text","text":"Read file .skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/command-offer.mjs, lines 85-139\n85: /**\n86:  * Replay the Claude prompt hook for one prompt and parse the offer it prints.\n87:  *\n88:  * The hook is resolved from the checkout rather than from this module, so a\n89:  * backfill records what that checkout's advisor would have offered at the time\n90:  * of the run, not what the current working copy happens to say.\n91:  *\n92:  * @param {object} options\n93:  * @param {string} options.checkoutDir - Root of the checkout whose hook runs.\n94:  * @param {string} options.prompt - The prompt to replay.\n95:  * @param {string} options.sessionId - Session id for the hook payload.\n96:  * @param {number} [options.timeoutMs] - Hook timeout before the replay fails.\n97:  * @returns {{ offeredCommand: string | null, offeredPolicy: string | null,\n98:  *   offeredAs: 'head' | 'partner' | null, offerError: string | null }}\n99:  */\n100: export function replayOffer({ checkoutDir, prompt, sessionId, timeoutMs = DEFAULT_TIMEOUT_MS }) {\n101:   const hookPath = join(checkoutDir, HOOK_RELATIVE);\n102:   if (!existsSync(hookPath)) {\n103:     return failedOffer('hook_missing');\n104:   }\n105: \n106:   const payload = {\n107:     prompt,\n108:     cwd: checkoutDir,\n109:     hook_event_name: 'UserPromptSubmit',\n110:     session_id: sessionId,\n111:   };\n112: \n113:   let result;\n114:   try {\n115:     result = spawnSync('node', [hookPath], {\n116:       cwd: checkoutDir,\n117:       input: JSON.stringify(payload),\n118:       encoding: 'utf8',\n119:       timeout: timeoutMs,\n120:       maxBuffer: MAX_OUTPUT_BYTES,\n121:     });\n122:   } catch {\n123:     return failedOffer('hook_failed');\n124:   }\n125: \n126:   if (result.error || result.status !== 0 || typeof result.stdout !== 'string') {\n127:     return failedOffer('hook_failed');\n128:   }\n129: \n130:   let output;\n131:   try {\n132:     output = JSON.parse(result.stdout);\n133:   } catch {\n134:     return failedOffer('hook_failed');\n135:   }\n136: \n137:   const context = output?.hookSpecificOutput?.additionalContext;\n138:   if (typeof context !== 'string') {\n139:     return failedOffer('no_head');\n[Output truncated. Continue reading with offset: 140]"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"limit\":55,\"offset\":85,\"path\":\".skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/command-offer.mjs\"}"},"time":{"start":1794802118213,"end":1794802118990}}}}
