bled_when: \"dry_run == true\"\n  default: false\n  modes: [auto, confirm]\n  purpose: \"Run safe setup and read-only inspection, then stop before side effects.\"\n  safe_operations:\n    - \"Resolve setup inputs and artifact roots.\"\n    - \"Read current state, strategy, focus, and convergence signals.\"\n    - \"Render the next prompt to terminal preview without writing prompt files.\"\n  forbidden_operations:\n    - \"Executor dispatch.\"\n    - \"Persistent state, queue, lock, git index, memory, or graph mutation.\"\n    - \"Reducer refresh or generated artifact writes.\"\n    - \"Child-lineage spawn.\"\n  event_policy:\n    event_name: dry_run_halt\n    sink: \"terminal JSONL preview only; never append to {state_paths.state_log}\"\n    required_fields: [type, event, mode, boundary, step, timestamp]\n    optional_fields: [run, sessionId, generation, detail]\n    default_halt_event: '{\"type\":\"event\",\"event\":\"dry_run_halt\",\"mode\":\"research\",\"boundary\":\"{dry_run_boundary}\",\"step\":\"{step_name}\",\"timestamp\":\"{ISO_8601_NOW}\"}'\n    preview_only: \"A step or branch marked dry_run_event_policy: preview-only still runs its read and classify work. It prints the event it would append as a terminal JSONL preview line and appends nothing.\"\n  halt_hook_rule: \"Before executing any command, dispatch, edit, output, template write, append_to_jsonl, append_jsonl, log_event, mcp_tool, write, or git-index mutation in a step tagged with dry_run_boundary, emit event_policy.default_halt_event with that step's name and boundary to the terminal and halt. This holds in both execution modes.\"\n  boundary_labels:\n    child_spawn: \"child-spawn\"\n    state_mutation: \"state-mutation\"\n    dispatch: \"dispatch\"\n    reducer_refresh: \"reducer-refresh\"\n\n# ────────\n# CONTEXT LOADING\n# ────────\ncontext_loading:\n  trigger: \"At workflow START, before phase_init\"\n  purpose: \"Load prior research context for the topic and buffer it until strategy.md exists\