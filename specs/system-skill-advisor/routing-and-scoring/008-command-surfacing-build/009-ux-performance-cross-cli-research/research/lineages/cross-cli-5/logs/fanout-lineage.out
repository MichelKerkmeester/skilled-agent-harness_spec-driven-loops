ct.freeze(['findingDetails']),\n});\n\nconst FLAG_KEYS = Object.freeze({\n  '--mode': 'mode',\n  '--event-dir': 'eventDir',\n  '--artifact-dir': 'artifactDir',\n  '--state-log': 'stateLog',\n  '--registry': 'registry',\n  '--output': 'output',\n  '--dashboard': 'dashboard',\n  '--stop-reason': 'stopReason',\n  '--answered-count': 'answeredCount',\n  '--total-questions': 'totalQuestions',\n  '--active-p0': 'activeP0',\n  '--active-p1': 'activeP1',\n  '--active-p2': 'activeP2',\n  '--dimension-coverage': 'dimensionCoverage',\n  '--verdict': 'verdict',\n  '--release-readiness-state': 'releaseReadinessState',\n});\n=== usage ===\n46:  '--artifact-dir': 'artifactDir',\n49:  '--output': 'output',\n51:  '--stop-reason': 'stopReason',\n64:  ['artifactDir', '--artifact-dir'],\n67:  ['output', '--output'],\n105:    throw new Error('missing required flag: --stop-reason');\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"cd /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research && sed -n '1,60p' .skilled/skills/system-deep-loop/runtime/scripts/synthesis-closeout.cjs; echo \\\"=== usage ===\\\"; grep -n \\\"Usage\\\\|--artifact-dir\\\\|--output\\\\|--stop-reason\\\" .skilled/skills/system-deep-loop/runtime/scripts/synthesis-closeout.cjs | head -20\"}"},"time":{"start":1794802239434,"end":1794802240235}}}}
