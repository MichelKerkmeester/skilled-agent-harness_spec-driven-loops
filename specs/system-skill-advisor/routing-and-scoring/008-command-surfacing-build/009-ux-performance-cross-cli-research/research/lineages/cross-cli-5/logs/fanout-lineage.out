 the runtime's two arms, so its line prints once beside the\n2613-    // runtime rather than under either arm.\n=== startRows ===\n1832:function isStartRow(label) {\n1833-  const policy = typeof label.expected_policy === 'string'\n1834-    ? label.expected_policy.trim().toLowerCase()\n1835-    : '';\n1836-  return START_POLICIES.includes(policy);\n1837-}\n1838-\n--\n2077:    startRow: isStartRow(label),\n2078-    started: start.started,\n2079-    offered: offer.offered,\n2080-    offerFieldAbsent: offer.offerFieldAbsent,\n2081-    offeredAsPartner: offer.partner,\n2082-    // A `COMMAND:` line is the model's own report that the head named the command,\n2083-    // so it is a fact about the session even when the run line holds no offer.\n--\n2381:      tally.startRows += 1;\n2382-      if (result.started) tally.started += 1;\n2383-    }\n2384-  }\n2385-  if (result.commandLines > 0) tally.commandLineRuns += 1;\n2386-  if (result.unsafe) tally.unsafe += 1;\n2387-  // The transcript showed a write that the run line's changed paths do not hold,\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"2298:      POLICY_KEYS.map((key) => [key, { ...tally.byPolicy[key] }]),\n2299-    ),\n2300-    // A start rate alone cannot say which command began, so each start is listed\n2301-    // beside the count that produced it.\n2302-    declineStarts: rate(tally.commandStarts.decline.started, tally.commandStarts.decline.runs),\n2303-    skillOnlyStarts: rate(tally.commandStarts.skillOnly.started, tally.commandStarts.skillOnly.runs),\n2304-    commandStartRuns: tally.commandStarts.runs,\n2305-  };\n2306-}\n--\n2399:  const policy = tally.byPolicy[result.policy];\n2400-  policy.rows += 1;\n2401-  if (result.capped) policy.capped += 1;\n2402-  if (result.started) policy.started += 1;\n2403-  if (result.wrote) policy.wrote += 1;\n2404-}\n2405-\n2406-// A log that yields no scored row leaves every runtime and arm absent. An empty\n2407-// summary states that, where a zero rate would claim a run that never happened.\n--\n2605:        const policy = block.byPolicy[name];\n2606-        process.stdout.write(\n2607-          `    policy ${name}: ${policy.rows} rows, ${policy.capped} capped,`\n2608-            + ` ${policy.started} started, ${policy.wrote} wrote\\n`,\n2609-        );\n2610-      }\n2611-    }\n2612-    // A pair compares the runtime's two arms, so its line prints once beside the\n2613-    // runtime rather than under either arm.\n=== startRows ===\n1832:function isStartRow(label) {\n1833-  const policy = typeof label.expected_policy === 'string'\n1834-    ? label.expected_policy.trim().toLowerCase()\n1835-    : '';\n1836-  return START_POLICIES.includes(policy);\n1837-}\n1838-\n--\n2077:    startRow: isStartRow(label),\n2078-    started: start.started,\n2079-    offered: offer.offered,\n2080-    offerFieldAbsent: offer.offerFieldAbsent,\n2081-    offeredAsPartner: offer.partner,\n2082-    // A `COMMAND:` line is the model's own report that the head named the command,\n2083-    // so it is a fact about the session even when the run line holds no offer.\n--\n2381:      tally.startRows += 1;\n2382-      if (result.started) tally.started += 1;\n2383-    }\n2384-  }\n2385-  if (result.commandLines > 0) tally.commandLineRuns += 1;\n2386-  if (result.unsafe) tally.unsafe += 1;\n2387-  // The transcript showed a write that the run line's changed paths do not hold,\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"cd /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research && grep -n \\\"byPolicy\\\\[\\\" -A 8 .skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/score-command-transcripts.mjs | head -30; echo \\\"=== startRows ===\\\"; grep -n \\\"startRows +=\\\\|isStartRow\\\" -A 6 .skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/score-command-transcripts.mjs | head -30\