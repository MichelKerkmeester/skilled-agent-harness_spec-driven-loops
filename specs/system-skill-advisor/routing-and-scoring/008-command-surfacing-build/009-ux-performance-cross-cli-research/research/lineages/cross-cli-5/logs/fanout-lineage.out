>Math.min(1,Math.max(0,Math.round(v*100)/100));return [b(c-sp),b(c+sp)];};\\nconst rows=[[\\\"claude\\\",\\\"2 of 15\\\",\\\"3 of 15\\\"],[\\\"opencode\\\",\\\"1 of 7\\\",\\\"3 of 10\\\"],[\\\"pi\\\",\\\"3 of 14\\\",\\\"6 of 15\\\"],[\\\"devin\\\",\\\"2 of 11\\\",\\\"6 of 12\\\"],[\\\"dsh\\\",\\\"6 of 15\\\",\\\"10 of 15\\\"]];\\nfor (const [r,a,b] of rows){const [as,an]=a.split(\\\" of \\\").map(Number),[bs,bn]=b.split(\\\" of \\\").map(Number);console.log(r,a,JSON.stringify(w(as,an)),\\\"->\\\",b,JSON.stringify(w(bs,bn)));}\\n'\"}"},"time":{"start":1794801849725,"end":1794801851740}}}}
