,\n    \"cmd\": \"/create:diff\",\n    \"policy\": \"start\",\n    \"type\": \"plain\",\n    \"exit\": 143,\n    \"changed\": 2\n   },\n   {\n    \"rowId\": \"cmd-deep-research-plain-tune-01\",\n    \"cmd\": \"/deep:research\",\n    \"policy\": \"ask\",\n    \"type\": \"plain\",\n    \"exit\": 0,\n    \"changed\": 1\n   }\n  ],\n  \"byPolicy\": {\n   \"start\": 8,\n   \"run\": 4,\n   \"ask\": 4,\n   \"?\": 8\n  }\n },\n \"devin\": {\n  \"runs\": 15,\n  \"changed\": 6,\n  \"changedRows\": [\n   {\n    \"rowId\": \"cmd-create-agent-plain-tune-01\",\n    \"cmd\": \"/create:agent\",\n    \"policy\": \"start\",\n    \"type\": \"plain\",\n    \"exit\": null,\n    \"changed\": 3\n   },\n   {\n    \"rowId\": \"cmd-create-agent-plain-tune-02\",\n    \"cmd\": \"/create:agent\",\n    \"policy\": \"start\",\n    \"type\": \"plain\",\n    \"exit\": null,\n    \"changed\": 3\n   },\n   {\n    \"rowId\": \"cmd-create-command-plain-tune-01\",\n    \"cmd\": \"/create:command\",\n    \"policy\": \"start\",\n    \"type\": \"plain\",\n    \"exit\": 0,\n    \"changed\": 1\n   },\n   {\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"{\n \"claude\": {\n  \"runs\": 24,\n  \"changed\": 0,\n  \"changedRows\": [],\n  \"byPolicy\": {\n   \"start\": 8,\n   \"run\": 4,\n   \"ask\": 4,\n   \"?\": 8\n  }\n },\n \"codex\": {\n  \"runs\": 24,\n  \"changed\": 0,\n  \"changedRows\": [],\n  \"byPolicy\": {\n   \"start\": 8,\n   \"run\": 4,\n   \"ask\": 4,\n   \"?\": 8\n  }\n },\n \"pi\": {\n  \"runs\": 24,\n  \"changed\": 2,\n  \"changedRows\": [\n   {\n    \"rowId\": \"cmd-create-diff-plain-tune-01\",\n    \"cmd\": \"/create:diff\",\n    \"policy\": \"start\",\n    \"type\": \"plain\",\n    \"exit\": 143,\n    \"changed\": 2\n   },\n   {\n    \"rowId\": \"cmd-deep-research-plain-tune-01\",\n    \"cmd\": \"/deep:research\",\n    \"policy\": \"ask\",\n    \"type\": \"plain\",\n    \"exit\": 0,\n    \"changed\": 1\n   }\n  ],\n