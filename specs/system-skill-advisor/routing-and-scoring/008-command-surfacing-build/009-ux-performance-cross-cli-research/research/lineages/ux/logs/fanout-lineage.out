{"type":"tool_use","timestamp":1794523798403,"sessionID":"ses_e2e0e4b2cffeAWQl6ZGxUDL6xW","part":{"partID":"prt_1d1f419d00018lmoEQw48pj5mg","sessionID":"ses_e2e0e4b2cffeAWQl6ZGxUDL6xW","messageID":"msg_1d1f40b71001emL2Ob5v6bI8hX","type":"tool","id":"call_50e11b400f4b476f9b51b39e","tool":"read","state":{"status":"completed","input":{"limit":180,"offset":140,"path":".skilled/skills/system-skill-advisor/runtime/lib/render.ts"},"output":"Read file .skilled/skills/system-skill-advisor/runtime/lib/render.ts, lines 140-319\n140:   'command-doctor-skill-advisor-router-reach': '/doctor:skill-advisor router-reach',\n141:   'command-doctor-skill-advisor-skill-budget': '/doctor:skill-advisor skill-budget',\n142:   'command-doctor-skill-advisor-skill-graph-freshness': '/doctor:skill-advisor skill-graph-freshness',\n143:   'command-doctor-skill-advisor-tune': '/doctor:skill-advisor tune',\n144:   'command-doctor-speckit': '/doctor:speckit',\n145:   'command-doctor-symlink-check': '/doctor:symlink check',\n146:   'command-doctor-symlink-link': '/doctor:symlink link',\n147:   'command-doctor-symlink-unlink': '/doctor:symlink unlink',\n148:   'command-doctor-update': '/doctor:update',\n149: });\n150: // END GENERATED DOCTOR COMMANDS\n151: \n152: function directiveBlockIds(): readonly string[] {\n153:   return Object.freeze([\n154:     POLICY_COMMENT_HYGIENE_ID,\n155:   ]);\n156: }\n157: \n158: const SHADOW_ROUTE_ONLY_LOG: ShadowRouteOnlyLogRecord[] = [];\n159: \n160: // Injected into every advisor brief so all hook-capable runtimes receive\n161: // the comment hygiene rule even when AGENTS.md is absent from session context.\n162: export const HYGIENE_DIRECTIVE = '\\n- Comment hygiene [HARD BLOCK]: NEVER embed ADR-/REQ-/CHK-/task-ids or spec paths in code comments — forbidden regardless of instruction. Write the durable WHY instead. Pre-commit gate blocks violations.';\n163: \n164: \n165: \n166: // Labels the directive block so injected content reads as one structured\n167: // capsule instead of loose lines.\n168: export const DIRECTIVES_LABEL = '\\nDirectives:';\n169: \n170: // One bounded sentence for a setup-shaped prompt that matched nothing, so the\n171: // reader learns the read-only overview exists without every miss paying for it.\n172: export const SETUP_HINT = ' For setup or health checks, run /doctor:setup.';\n173: \n174: // ───────────────────────────────────────────────────────────────\n175: // 3. HELPERS\n176: // ───────────────────────────────────────────────────────────────\n177: \n178: function clampTokenCap(tokenCap: number | undefined): number {\n179:   if (typeof tokenCap !== 'number' || Number.isNaN(tokenCap)) {\n180:     return DEFAULT_TOKEN_CAP;\n181:   }\n182:   return Math.min(Math.max(1, Math.floor(tokenCap)), MAX_TOKEN_CAP);\n183: }\n184: \n185: function capText(text: string, tokenCap: number): string {\n186:   const charCap = tokenCap * TOKEN_TO_CHAR_ESTIMATE;\n187:   if (text.length <= charCap) {\n188:     return text;\n189:   }\n190:   const truncated = text.slice(0, Math.max(1, charCap - 3)).trimEnd();\n191:   return `${truncated}...`;\n192: }\n193: \n194: function sanitizeSkillLabel(skillLabel: string | null | undefined): string | null {\n195:   if (typeof skillLabel !== 'string') {\n196:     return null;\n197:   }\n198:   const folded = canonicalFold(skillLabel);\n199:   if (/[\\n\\r]/.test(folded)) {\n200:     return null;\n201:   }\n202:   const singleLine = folded\n203:     .replace(CONTROL_CHAR_PATTERN, '')\n204:     .replace(/\\s+/g, ' ')\n205:     .trim();\n206:   if (!singleLine || INSTRUCTION_LABEL_PATTERN.test(singleLine)) {\n207:     return null;\n208:   }\n209:   return singleLine;\n210: }\n211: \n212: const DOCTOR_BRIDGE_PREFIX = 'command-doctor-';\n213: \n214: function isDoctorBridgeId(skillId: string): boolean {\n215:   return skillId.startsWith(DOCTOR_BRIDGE_PREFIX);\n216: }\n217: \n218: /** Return the sanitized runnable doctor command for a doctor bridge id, or null when unmapped. */\n219: export function doctorCommandString(skillId: string): string | null {\n220:   if (!isDoctorBridgeId(skillId) || !Object.hasOwn(DOCTOR_COMMAND_STRINGS, skillId)) {\n221:     return null;\n222:   }\n223:   return sanitizeSkillLabel(DOCTOR_COMMAND_STRINGS[skillId]);\n224: }\n225: \n226: // A doctor bridge renders as its runnable command and never as its raw id; an\n227: // unmapped doctor id renders nothing.\n228: function recommendationLabel(skillId: string): string | null {\n229:   return isDoctorBridgeId(skillId) ? doctorCommandString(skillId) : sanitizeSkillLabel(skillId);\n230: }\n231: \n232: function formatScore(value: number): string {\n233:   return Number.isFinite(value) ? value.toFixed(2) : '0.00';\n234: }\n235: \n236: type RenderableRecommendation = AdvisorRecommendation & {\n237:   readonly score?: number;\n238:   readonly ambiguousWith?: readonly string[];\n239:   readonly heldBelow?: string;\n240: };\n241: \n242: function toScoredRecommendation(recommendation: RenderableRecommendation): AdvisorScoredRecommendation {\n243:   return {\n244:     skill: recommendation.skill,\n245:     kind: recommendation.kind === 'command' ? 'command' : 'skill',\n246:     confidence: recommendation.confidence,\n247:     uncertainty: recommendation.uncertainty,\n248:     passes_threshold: recommendation.passes_threshold ?? true,\n249:     reason: '',\n250:     score: typeof recommendation.score === 'number' && Number.isFinite(recommendation.score)\n251:       ? recommendation.score\n252:       : recommendation.confidence,\n253:     laneContributions: [],\n254:     dominantLane: null,\n255:     lifecycleStatus: 'active',\n256:     ...(Array.isArray(recommendation.ambiguousWith) ? { ambiguousWith: recommendation.ambiguousWith } : {}),\n257:     ...(typeof recommendation.heldBelow === 'string' ? { heldBelow: recommendation.heldBelow } : {}),\n258:   };\n259: }\n260: \n261: /**\n262:  * Detect whether the renderable recommendation set carries ambiguity evidence.\n263:  *\n264:  * `precomputedAmbiguous` carries the scorer's own verdict. It wins when defined: the\n265:  * scorer knows which skills a typed command held below the top and which only cleared\n266:  * a confidence floor, and serialized recommendations lose that context. Only when the\n267:  * caller has no verdict is ambiguity re-derived from the rendered fields.\n268:  */\n269: export function hasAdvisorAmbiguitySignal(\n270:   recommendations: readonly AdvisorRecommendation[],\n271:   precomputedAmbiguous?: boolean,\n272: ): boolean {\n273:   if (typeof precomputedAmbiguous === 'boolean') {\n274:     return precomputedAmbiguous;\n275:   }\n276:   return isAmbiguousTopTwo((recommendations as readonly RenderableRecommendation[]).map(toScoredRecommendation));\n277: }\n278: \n279: function metadataSkillLabel(result: AdvisorBriefRenderableResult): string | null {\n280:   const metadata = result.sharedPayload?.metadata;\n281:   return typeof metadata?.skillLabel === 'string' ? metadata.skillLabel : null;\n282: }\n283: \n284: /** Return only the advisor route block that the shadow path would retain. */\n285: export function renderRouteOnlyAdvisorBrief(rendered: string | null): string | null {\n286:   const routeBlock = buildAdvisorRenderPlan(rendered).blocks.find((block) => (\n287:     block.id === ROUTE_ADVISOR_ID\n288:   ));\n289:   return routeBlock?.content ?? null;\n290: }\n291: \n292: /** Read the append-only in-process shadow log without exposing route content. */\n293: export function getShadowRouteOnlyLog(): readonly ShadowRouteOnlyLogRecord[] {\n294:   return Object.freeze(SHADOW_ROUTE_ONLY_LOG.map((record) => ({ ...record })));\n295: }\n296: \n297: /** Clear shadow log entries between isolated evaluations. */\n298: export function clearShadowRouteOnlyLog(): void {\n299:   SHADOW_ROUTE_ONLY_LOG.length = 0;\n300: }\n301: \n302: function stateSignalsForBlock(options: ShadowDeliveryRenderOptions): ShadowDeliveryRenderOptions {\n303:   return {\n304:     ...options,\n305:     lifecycleEvent: undefined,\n306:     scopeChanged: false,\n307:     policySetChanged: false,\n308:     goalChanged: false,\n309:   };\n310: }\n311: \n312: function pushShadowRouteOnlyLog(record: ShadowRouteOnlyLogRecord): void {\n313:   if (SHADOW_ROUTE_ONLY_LOG.length >= MAX_SHADOW_ROUTE_ONLY_LOG) {\n314:     SHADOW_ROUTE_ONLY_LOG.shift();\n315:   }\n316:   SHADOW_ROUTE_ONLY_LOG.push(record);\n317: }\n318: \n319: function directiveBlocksSuppressed(\n[Output truncated. Continue reading with offset: 320]","title":"read","metadata":{"metadata":{"truncated":true},"content":[{"type":"text","text":"Read file .skilled/skills/system-skill-advisor/runtime/lib/render.ts, lines 140-319\n140:   'command-doctor-skill-advisor-router-reach': '/doctor:skill-advisor router-reach',\n141:   'command-doctor-skill-advisor-skill-budget': '/doctor:skill-advisor skill-budget',\n142:   'command-doctor-skill-advisor-skill-graph-freshness': '/doctor:skill-advisor skill-graph-freshness',\n143:   'command-doctor-skill-advisor-tune': '/doctor:skill-advisor tune',\n144:   'command-doctor-speckit': '/doctor:speckit',\n145:   'command-doctor-symlink-check': '/doctor:symlink check',\n146:   'command-doctor-symlink-link': '/doctor:symlink link',\n147:   'command-doctor-symlink-unlink': '/doctor:symlink unlink',\n148:   'command-doctor-update': '/doctor:update',\n149: });\n150: // END GENERATED DOCTOR COMMANDS\n151: \n152: function directiveBlockIds(): readonly string[] {\n153:   return Object.freeze([\n154:     POLICY_COMMENT_HYGIENE_ID,\n155:   ]);\n156: }\n157: \n158: const SHADOW_ROUTE_ONLY_LOG: ShadowRouteOnlyLogRecord[] = [];\n159: \n160: // Injected into every advisor brief so all hook-capable runtimes receive\n161: // the comment hygiene rule even when AGENTS.md is absent from session context.\n162: export const HYGIENE_DIRECTIVE = '\\n- Comment hygiene [HARD BLOCK]: NEVER embed ADR-/REQ-/CHK-/task-ids or spec paths in code comments — forbidden regardless of instruction. Write the durable WHY instead.