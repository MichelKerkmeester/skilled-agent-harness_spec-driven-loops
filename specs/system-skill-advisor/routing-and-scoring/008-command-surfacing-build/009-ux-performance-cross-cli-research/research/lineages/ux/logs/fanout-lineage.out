{"type":"tool_use","timestamp":1794523723536,"sessionID":"ses_e2e0e4b2cffeAWQl6ZGxUDL6xW","part":{"partID":"prt_1d1f2f5e50016rsrlTUITUQCs4","sessionID":"ses_e2e0e4b2cffeAWQl6ZGxUDL6xW","messageID":"msg_1d1f2e845001w6gzEIrdHJNRl7","type":"tool","id":"call_1fb515f6f6bf4a848b284649","tool":"read","state":{"status":"completed","input":{"path":".skilled/commands/deep/assets/deep-research-auto.yaml"},"output":"Read file .skilled/commands/deep/assets/deep-research-auto.yaml, lines 1-749\n1: # ─────────────────────────────────────────────────────────────────\n2: # DEEP RESEARCH: AUTONOMOUS DEEP RESEARCH LOOP (AUTO MODE)\n3: # ─────────────────────────────────────────────────────────────────\n4: # YAML PREDICATE GRAMMAR CONTRACT:\n5: # - This asset does not currently use typed BooleanExpr predicates under\n6: #   `when:`; flow control is branch-label-driven (`on_resume`, `on_fresh`,\n7: #   `on_restart`, etc.). Retain the existing shape.\n8: # - `after:` carries prose timing / narrative notes if needed; `when:` in\n9: #   this file is reserved for future typed predicates and must NOT carry\n10: #   free-form narrative prose.\n11: # - See `.skilled/skills/system-spec-kit/shared/predicates/boolean-expr.ts`\n12: #   for the canonical BooleanExpr grammar.\n13: #\n14: # GATE 3 CLASSIFICATION:\n15: # - `resume` is a tested WRITE-PATH that produces `iteration-NNN.md` files\n16: #   and JSONL state-log appends. The workflow classifies resume as\n17: #   write-path below (see `gate3_classification` fields) so Gate 3 trigger\n18: #   extraction can surface resume correctly rather than false-negative.\n19: # ─────────────────────────────────────────────────────────────────\n20: role: Deep Research Loop Manager\n21: purpose: Iterative deep research with convergence detection\n22: action: Run deep-research loop from initialization through synthesis\n23: operating_mode:\n24:   workflow: iterative_loop\n25:   workflow_compliance: MANDATORY\n26:   workflow_execution: autonomous\n27:   approvals: none\n28:   tracking: progressive_research_state\n29:   validation: convergence_detection\n30: \n31: # ─────────────────────────────────────────────────────────────────\n32: # OPERATING PRINCIPLES\n33: # ─────────────────────────────────────────────────────────────────\n34: operating_principles:\n35:   core: \"Fresh context per iteration + externalized state = no context degradation\"\n36:   approach: \"Dispatch focused agent, evaluate convergence, repeat or stop\"\n37:   mandate: \"Never hold findings in memory; write everything to files\"\n38: \n39: # ─────────────────────────────────────────────────────────────────\n40: # USER INPUTS (from setup phase)\n41: # ─────────────────────────────────────────────────────────────────\n42: user_inputs:\n43:   research_topic: \"[RESEARCH_TOPIC] - Topic to investigate deeply. REQUIRED.\"\n44:   spec_folder: \"[SPEC_FOLDER] - Spec folder path. REQUIRED.\"\n45:   max_iterations: \"[MAX_ITERATIONS] - Maximum loop iterations. Default: 10.\"\n46:   convergence_threshold: \"[CONVERGENCE_THRESHOLD] - Stop threshold. Default: 0.05.\"\n47:   convergence_mode: \"[default|off|sliding-window|divergent] - Convergence policy modifier. Default: default.\"\n48:   stop_policy: \"[convergence|max-iterations] - Convergence stop policy; max-iterations forces the loop to run every iteration. Default: convergence.\"\n49: \n50: # ─────────────────────────────────────────────────────────────────\n51: # CONTEXT LOADING\n52: # ─────────────────────────────────────────────────────────────────\n53: context_loading:\n54:   trigger: \"At workflow START, before phase_init\"\n55:   purpose: \"Load prior research context for the topic and buffer it until strategy.md exists\"\n56:   retrieval:\n57:     mechanism: \"continuity-ladder-then-ripgrep\"\n58:     note: \"File reads only. Nothing here needs a running daemon, and every step is reproducible by hand.\"\n59:     ladder:\n60:       - \"{spec_folder}/handover.md when present\"\n61:       - \"the _memory.continuity frontmatter block in {spec_folder}/implementation-summary.md\"\n62:       - \"the packet's canonical spec docs, spec.md and decision-record.md, for what the first two steps leave open\"\n63:     free_text_recipe: \"rg --no-config --json --fixed-strings --ignore-case -C 2 --glob '*.md' --glob '!**/z_archive/**' --glob '!**/node_modules/**' -- '{research_topic}' specs .skilled\"\n64:     recipe_contract: \".skilled/skills/system-spec-kit/references/retrieval/retrieval-conventions.md\"\n65:     exit_status: \"0 is a hit set, 1 is a clean no-hit, 2 or higher is a failure that must be surfaced instead of reported as no-hit\"\n66:     ranking: \"Ripgrep does not rank. Order the hits caller-side with the tuple in retrieval-conventions.md section 5.\"\n67:   when_to_skip: [\"User says 'skip context' or 'fresh start'\"]\n68:   behavior:\n69:     if_context_found: \"Store full results as prior_context plus a concise prior_context_summary; inject after strategy.md is created.\"\n70:     if_no_context: \"Set prior_context and prior_context_summary to 'None' and continue.\"\n71: \n72: # ─────────────────────────────────────────────────────────────────\n73: # SKILL REFERENCE\n74: # ─────────────────────────────────────────────────────────────────\n75: skill_reference:\n76:   skill: system-deep-loop\n77:   skill_md: .skilled/skills/system-deep-loop/deep-research/SKILL.md\n78:   references:\n79:     loop_protocol: .skilled/skills/system-deep-loop/deep-research/references/protocol/loop-protocol.md\n80:     spec_check_protocol: .skilled/skills/system-deep-loop/deep-research/references/protocol/spec-check-protocol.md\n81:     state_format: .skilled/skills/system-deep-loop/deep-research/references/state/state-format.md\n82:     convergence: .skilled/skills/system-deep-loop/deep-research/references/convergence/convergence.md\n83:   templates:\n84:     config: .skilled/skills/system-deep-loop/deep-research/assets/deep-research-config.json\n85:     strategy: .skilled/skills/system-deep-loop/deep-research/assets/deep-research-strategy.md\n86: \n87: # ─────────────────────────────────────────────────────────────────\n88: # AGENT CONFIGURATION\n89: # ─────────────────────────────────────────────────────────────────\n90: agent_config:\n91:   agent: deep-research\n92:   agent_file: \".skilled/agents/deep-research.md\"\n93:   # Canonical path. Runtime-specific directories (e.g. .claude/agents/) reference this source.\n94:   model: opus\n95:   leaf_only: true\n96:   tools: [Read, Write, Edit, Bash, Grep, Glob, WebFetch]\n97:   mcp_servers: []\n98:   tool_call_budget: { target: 12, max: 24 }\n99: \n100: # ─────────────────────────────────────────────────────────────────\n101: # STATE FILE PATHS\n102: # ─────────────────────────────────────────────────────────────────\n103: # ─────────────────────────────────────────────────────────────────\n104: # CANONICAL STATE WRITE MECHANISM\n105: # ─────────────────────────────────────────────────────────────────\n106: state_write_protocol:\n107:   mechanism: \"append-gateway\"\n108:   command: \"node .skilled/skills/system-deep-loop/runtime/scripts/append-mode-event.cjs --mode research --run-directory {artifact_dir} --event-json <record file>\"\n109:   applies_to: \"every append_to_jsonl and append_jsonl directive in this workflow\"\n110:   refusal_handling: \"halt on exit 2; never fall back to a direct file write. Exit 1 on a row that is still routed through the gateway is a workflow defect and halts; the pinned_bookkeeping rows are recorded through bookkeeping_log and are never routed.\"\n111:   pinned_bookkeeping:\n112:     events: [config_warning, graph_convergence, lock_released, schema_mismatch]\n113:     directive: \"bookkeeping_log\"\n114:     handling: \"These rows are workflow bookkeeping that the research ledger schema pins to the legacy path: they have no lossless research-event target, so the gateway would refuse them with exit 1 and write nothing. They are never sent to the gateway. The step prints the row in its log line and continues; none of them is a halt condition.\"\n115:   contract: |\n116:     The directives below specify WHAT to record; this block specifies the mechanism. The\n117:     command accepts a canonical event envelope — a `stem` with `scope` and `data`, or an\n118:     `event_type` with a `payload` — and for this mode it also accepts a legacy-shaped row,\n119:     which it upcasts before appending. Where the upcast is lossy it returns a warning, and\n120:     the warning is surfaced rather than swallowed. Some directives below record workflow\n121:     bookkeeping rather than research semantics: the schema deliberately pins several of them\n122:     to the legacy path and the upcaster has no registered stem for the rest. Those rows are\n123:     declared under pinned_bookkeeping and recorded through bookkeeping_log, so they are never\n124:     routed here. A refusal names its own reason, so the caller can tell a deliberate pin from\n125:     a missing stem. A row the upcaster does refuse returns exit 1 and writes nothing, with the\n126:     reason naming why. Exit 1 is distinct from the exit 2 refusal described in the next\n127:     paragraph: exit 1 means the input never reached authority, exit 2 means authority refused\n128:     it.\n129: \n130:     The gateway authorizes the write against the mode's durable authority record, serialises it\n131:     behind the ledger fence, returns a receipt, and refreshes state_log from the ledger. Exit 0\n132:     means the record is durable. Exit 2 means it was refused, and the refusal names the check\n133:     that failed.\n134: \n135:     Writing state_log directly bypasses ordering, authorization, and the receipt. Two writers\n136:     can then interleave with no shared ordering, and a record nobody authorized carries no\n137:     receipt, so a later reader cannot tell an accepted record from an invented one. A refusal\n138:     is a halt, never a reason to write the file directly.\n139: \n140:     There is no direct-append exception. The run-now sentinels, the restored-sentinel row and\n141:     the synthesis reconciliation rows are canonical ledger events, because state_log is a\n142:     projection the gateway rebuilds from the ledger and a row written beside it is dropped by\n143:     the next refresh.\n144: \n145: state_paths:\n146:   # Template paths document the canonical packet layout. Runtime resolution happens via\n147:   # step_resolve_artifact_root plus the shared resolver, so root specs keep root-local\n148:   # research/ and child phases keep local research/ packet directories.\n149:   packet_dir: \"{artifact_dir}\"\n150:   config: \"{artifact_dir}/deep-research-config.json\"\n151:   state_log: \"{artifact_dir}/deep-research-state.jsonl\"\n152:   status_ledger: \"{artifact_dir}/orchestration-status.log\"\n153:   strategy: \"{artifact_dir}/deep-research-strategy.md\"\n154:   registry: \"{artifact_dir}/findings-registry.json\"\n155:   dashboard: \"{artifact_dir}/deep-research-dashboard.md\"\n156:   pause_sentinel: \"{artifact_dir}/.deep-research-pause\"\n157:   run_now_sentinel: \"{artifact_dir}/.deep-research-run-now\"\n158:   lock_file: \"{artifact_dir}/.deep-research.lock\"\n159:   prompt_dir: \"{artifact_dir}/prompts\"\n160:   iteration_dir: \"{artifact_dir}/iterations\"\n161:   iteration_pattern: \"{artifact_dir}/iterations/iteration-{NNN}.md\"\n162:   # Per-iteration structured delta stream (one file per iteration) — complement to the\n163:   # canonical state_log append. The delta file MUST contain at least one record whose\n164:   # `type === \"iteration\"` so the reducer can rehydrate iteration state after a partial\n165:   # run. Variants like `\"iteration_delta\"` are silently dropped by the reducer; the\n166:   # post_dispatch_validate step enforces the canonical type below.\n167:   delta_dir: \"{artifact_dir}/deltas\"\n168:   delta_pattern: \"{artifact_dir}/deltas/iter-{NNN}.jsonl\"\n169:   research_output: \"{artifact_dir}/research.md\"\n170:   resource_map_output: \"{artifact_dir}/resource-map.md\"\n171:   archive_root: \"{artifact_archive_root}\"\n172:   synthesis_snapshot_pattern: \"{artifact_dir}/synthesis-v{generation}.md\"\n173: \n174: # ─────────────────────────────────────────────────────────────────\n175: # WORKFLOW\n176: # ─────────────────────────────────────────────────────────────────\n177: workflow:\n178: \n179:   step_resolve_artifact_root:\n180:     description: \"Resolve artifact directory — use fan-out lineage override when provided, else resolve from spec_folder\"\n181:     note: \"Root specs keep research artifacts directly in {spec_folder}/research/. Child phases and sub-phases keep local packet directories in {spec_folder}/research/{packet}/, and archives stay local at {spec_folder}/research_archive/{packet}/.\"\n182:     branch_on: \"config.fanout_lineage_artifact_dir\"\n183:     if_present:\n184:       bind:\n185:         artifact_dir: \"{config.fanout_lineage_artifact_dir}\"\n186:         artifact_root_dir: \"{config.fanout_lineage_artifact_dir}\"\n187:         artifact_subfolder: null\n188:         artifact_archive_root: \"{config.fanout_lineage_artifact_dir}/_archive\"\n189:     if_absent:\n190:       command: \"node -e \\\"const { resolveArtifactRoot } = require('./.skilled/skills/system-spec-kit/shared/review-research-paths.cjs'); console.log(JSON.stringify(resolveArtifactRoot('{spec_folder}', 'research')));\\\"\"\n191:       outputs:\n192:         - artifact_root_dir: \"Resolved local research owner directory\"\n193:         - artifact_subfolder: \"Local packet subfolder ({ownerSlug}-pt-{NN}), else null\"\n194:         - artifact_dir: \"Resolved research packet directory for this target\"\n195:         - artifact_archive_root: \"Resolved local research archive directory for this target\"\n196: \n197:   step_bind_reducer_artifact_arg:\n198:     description: \"Keep the reducer on the lineage-owned artifact directory during fan-out\"\n199:     branch_on: \"config.fanout_lineage_artifact_dir\"\n200:     if_present:\n201:       bind:\n202:         reducer_artifact_arg: \"--artifact-dir {artifact_dir}\"\n203:     if_absent:\n204:       bind:\n205:         reducer_artifact_arg: \"\"\n206: \n207:   step_fanout_spawn:\n208:     description: \"Spawn fan-out lineages; skip and proceed to phase_init normally when single-executor\"\n209:     skip_when: \"config.fanout is absent\"\n210:     instructions: |\n211:       Fan-out mode is active. Spawn all lineages. Each lineage runs the full loop in its own\n212:       isolated sub-packet under {artifact_dir}/lineages/{label}/.\n213:       fanout-run.cjs owns native and CLI lineage execution; native is run through the\n214:       deep/research command surface with config.fanout_lineage_artifact_dir so the LEAF\n215:       deep-research agent is used only for individual iterations, never as a full-loop\n216:       sub-agent or pasted phase-running prompt.\n217:       After all lineages complete, jump directly to phase_synthesis — skip phase_init and\n218:       phase_main_loop entirely (those are the single-executor path). The merge step in\n219:       phase_synthesis will consolidate results across all lineages.\n220:     sub_steps:\n221:       step_fanout_spawn_cli:\n222:         description: \"Spawn all native and CLI lineages in capped worker pool\"\n223:         skip_when: \"no entries in config.fanout.executors\"\n224:         command: |\n225:           node .skilled/skills/system-deep-loop/runtime/scripts/fanout-run.cjs \\\n226:             --spec-folder {spec_folder} \\\n227:             --loop-type research \\\n228:             --research-topic \"{research_topic}\" \\\n229:             --fanout-config-json '{config.fanout_json}' \\\n230:             --base-artifact-dir {artifact_dir} \\\n231:             --convergence-threshold {convergence_threshold} \\\n232:             --stop-policy {stop_policy} \\\n233:             --convergence-mode {convergence_mode}\n234:         working_directory: \"{repo_root}\"\n235:         wait_for_completion: true\n236: \n237:   # ═══════════════════════════════════════════════════════════════\n238:   # PHASE 1: INITIALIZATION\n239:   # ═══════════════════════════════════════════════════════════════\n240:   phase_init:\n241:     purpose: Create all state files for the research session\n242:     steps:\n243: \n244:       step_preflight_contract:\n245:         action: \"Validate required setup bindings and executable workflow contract before any file writes\"\n246:         verify:\n247:           - required_values_present: [research_topic, spec_folder, max_iterations, convergence_threshold, convergence_mode, stop_policy]\n248:           - spec_folder_is_within: \"specs/ or .opencode/specs/ (canonicalize alias roots before validation)\"\n249:           - unresolved_placeholders: \"FAIL if any user-facing template references placeholders not produced by earlier steps\"\n250:           - tool_contract: \"FAIL if executable steps reference tools outside the command allowlist\"\n251:         on_fail: \"Halt with STATUS=FAIL and report the missing binding or unsupported contract reference\"\n252: \n253:       step_create_directories:\n254:         action: \"Create spec folder and research packet directories if they don't exist\"\n255:         command: \"mkdir -p {state_paths.prompt_dir} {state_paths.iteration_dir} {state_paths.delta_dir}\"\n256: \n257:       step_detect_resource_map:\n258:         action: \"Detect resource-map.md before config creation so init can persist the flag and seed Known Context\"\n259:         inspect:\n260:           - \"{spec_folder}/resource-map.md\"\n261:         classify:\n262:           present: \"resource-map.md exists at init\"\n263:           absent: \"resource-map.md does not exist at init\"\n264:         outputs:\n265:           - resource_map_present: \"Boolean true when {spec_folder}/resource-map.md exists, else false\"\n266:           - resource_map_known_context: \"When present: summarize the map by section with entry counts across READMEs, Documents, Commands, Agents, Skills, Specs, Scripts, Tests, Config, and Meta, plus a one-line theme summary for each section. When absent: 'resource-map.md not present; skipping coverage gate'.\"\n267: \n268:       step_resolve_canonical_names:\n269:         action: \"Resolve canonical research packet artifact names before classification\"\n270:         inspect_legacy:\n271:           - \"{state_paths.packet_dir}/config.json\"\n272:           - \"{state_paths.packet_dir}/state.jsonl\"\n273:           - \"{state_paths.packet_dir}/strategy.md\"\n274:           - \"{state_paths.packet_dir}/dashboard.md\"\n275:           - \"{state_paths.packet_dir}/.pause\"\n276:         migration_policy: \"dual-read / single-write for 4 weeks\"\n277:         on_legacy_read:\n278:           set: { legacy_migration_detected: true, migration_recorded: false }\n279:           outputs:\n280:             - legacy_path: \"The legacy artifact path that was read\"\n281:             - canonical_path: \"The canonical artifact path it maps to\"\n282:           note: \"Only detect and bind here. The migration row is appended by step_record_artifact_migration, once the session is classified and the run is open, because an append before classification would create the state log and turn a fresh packet into a partial one.\"\n283: \n284:       step_acquire_lock:\n285:         action: \"Acquire the single-writer advisory lock before session classification\"\n286:         command: \"node .skilled/skills/system-deep-loop/runtime/scripts/loop-lock.cjs acquire --lock-path {state_paths.lock_file} --packet-id {spec_folder} --ttl-ms 1800000\"\n287:         on_acquire: \"Capture lock.ownerPid as captured_owner_pid and lock.acquireNonce as captured_acquire_nonce from the JSON output, and reuse both for every release below. If acquired=false, fail closed: another deep-research run already holds this packet.\"\n288:         note: \"Uses the promoted runtime/ loop-lock CLI (single source of truth: stale-lock reclaim, clean owner-scoped release). macOS/BSD locking is advisory — best-effort single-writer, not a hard mutex across host calls. Acquire reclaims a stale lock itself and reports the old holder under `reclaimed`. A lock is stale when its heartbeat is older than twice its TTL, or when its owning process is known to be dead. No confirmation step exists in either mode: log a `reclaimed` holder and continue.\"\n289:         # Lock-cleanup contract: the lock file MUST be released on every terminal exit path that follows acquisition.\n290:         # Runtimes honoring step_acquire_lock are required to perform this cleanup before halting or pausing.\n291:         on_halt:\n292:           action: \"Release the lock before any terminal halt branch returns control\"\n293:           applies_to: [\"step_classify_session.on_invalid_state\", \"step_classify_session.on_completed_session\", \"step_preinit_spec_branch.conflict-detected\"]\n294:           command: \"node .skilled/skills/system-deep-loop/runtime/scripts/loop-lock.cjs release --lock-path {state_paths.lock_file} --owner-pid {captured_owner_pid} --nonce {captured_acquire_nonce}; failures here are logged but do not block the halt\"\n295:         on_cancel:\n296:           action: \"Release the lock on user cancel or pause-sentinel detection before sentinel processing\"\n297:           command: \"node .skilled/skills/system-deep-loop/runtime/scripts/loop-lock.cjs release --lock-path {state_paths.lock_file} --owner-pid {captured_owner_pid} --nonce {captured_acquire_nonce}; cancel completes regardless of cleanup result\"\n298:         on_workflow_exit:\n299:           action: \"Release the lock as the final step of any workflow exit path (success or failure)\"\n300:           command: \"node .skilled/skills/system-deep-loop/runtime/scripts/loop-lock.cjs release --lock-path {state_paths.lock_file} --owner-pid {captured_owner_pid} --nonce {captured_acquire_nonce}; idempotent, safe to invoke when already released\"\n301: \n302:       step_classify_session:\n303:         action: \"Classify the session before writing files\"\n304:         inspect:\n305:           - \"{state_paths.config}\"\n306:           - \"{state_paths.state_log}\"\n307:           - \"{state_paths.strategy}\"\n308:         classify:\n309:           fresh: \"None of the three state artifacts exist\"\n310:           resume: \"Config, JSONL, and strategy all exist and agree on topic/spec folder; missing wait-checkpoint fields are read as nextRunAt:null and remainingDelayMs:null\"\n311:           completed-session: \"Resume artifacts exist and config.status == 'complete'\"\n312:           invalid-state: \"Any partial, missing, or contradictory combination\"\n313:         outputs:\n314:           - session_state: \"fresh | resume | completed-session | invalid-state\"\n315:         on_resume:\n316:           # Resume is a WRITE-PATH. Produces `iteration-NNN.md` + JSONL appends.\n317:           # Gate 3 lists it as a trigger beside save context, save memory and /speckit:save.\n318:           gate3_classification: write-path\n319:           gate3_rationale: \"resume produces iteration-NNN.md writes and JSONL state-log appends\"\n320:           log: \"Auto-resume: state artifacts are complete and consistent. Continue the same lineage (sessionId unchanged, generation unchanged, no archive).\"\n321:           append_jsonl: '{\"type\":\"event\",\"event\":\"resumed\",\"mode\":\"research\",\"sessionId\":\"{session_id}\",\"parentSessionId\":\"{session_id}\",\"lineageMode\":\"resume\",\"continuedFromRun\":{iteration_count},\"generation\":{generation},\"archivedPath\":null,\"timestamp\":\"{ISO_8601_NOW}\"}'\n322:           skip_to: phase_loop\n323:         on_restart:\n324:           action: \"Archive the current research packet under the root-level research_archive/ tree and start a new lineage segment with a fresh sessionId and generation+1.\"\n325:           command: \"if [ -d {state_paths.packet_dir} ]; then mkdir -p {state_paths.archive_root} && mv {state_paths.packet_dir} {state_paths.archive_root}/{timestamp_slug}; fi\"\n326:           set:\n327:             lineage_mode: \"restart\"\n328:             parent_session_id: \"{prior_session_id}\"\n329:             generation: \"{prior_generation + 1}\"\n330:           append_jsonl: '{\"type\":\"event\",\"event\":\"restarted\",\"mode\":\"research\",\"sessionId\":\"{session_id}\",\"parentSessionId\":\"{prior_session_id}\",\"lineageMode\":\"restart\",\"generation\":{generation},\"archivedPath\":\"{state_paths.archive_root}/{timestamp_slug}\",\"timestamp\":\"{ISO_8601_NOW}\"}'\n331:           skip_to: step_create_config\n332:         note_deferred_branches: \"fork and completed-continue are deferred and no longer runtime-supported in this release. The reducer still reads `lineageMode` from config for dashboards and analysis, but only `new`, `resume`, and `restart` are live. See deep-research/references/protocol/loop-protocol.md §Lifecycle Branch Contract for the one-session contract.\"\n333:         on_completed_session:\n334:           log: \"Prior session already completed. Do not route directly to synthesis; archive the completed research/ tree or start a fresh packet instead.\"\n335:           halt: true\n336:           message: \"Completed deep-research packet detected. Archive or replace the existing research/ tree before starting a new session.\"\n337:         on_invalid_state:\n338:           halt: true\n339:           message: \"Existing deep-research state is incomplete or contradictory. Repair or archive the invalid research packet before continuing.\"\n340:         on_fresh:\n341:           action: \"Proceed with a new session\"\n342: \n343:       step_resolve_session_id:\n344:         action: \"Resolve init session id from caller when supplied, else preserve the auto-generated fallback\"\n345:         branch_on: \"session_id\"\n346:         if_present:\n347:           bind:\n348:             session_id_init: \"{session_id}\"\n349:         if_absent:\n350:           bind:\n351:             # The token is bound here so the fallback literal resolves to a real timestamp when no caller session_id is supplied.\n352:             AUTO_SESSION_ID: \"{ISO_8601_NOW}\"\n353:             session_id_init: \"{AUTO_SESSION_ID}\"\n354: \n355:       step_create_config:\n356:         action: \"Create deep-research-config.json from template\"\n357:         template: .skilled/skills/system-deep-loop/deep-research/assets/deep-research-config.json\n358:         populate:\n359:           topic: \"{research_topic}\"\n360:           maxIterations: \"{max_iterations}\"\n361:           minIterations: 3\n362:           # Semantic: newInfoRatio with negative-knowledge emphasis. See SKILL.md §\"Convergence Threshold Semantics\".\n363:           convergenceThreshold: \"{convergence_threshold}\"\n364:           stopPolicy: \"{stop_policy}\"\n365:           antiConvergence.convergenceMode: \"{convergence_mode}\"\n366:           antiConvergence.divergent: {}\n367:           stuckThreshold: 3\n368:           minIdeaObservations: 2\n369:           maxDurationMinutes: 120\n370:           specFolder: \"{spec_folder}\"\n371:           resource_map_present: \"{resource_map_present}\"\n372:           # Honor the parsed --no-resource-map flag from deep-research.md:73 (default true; false when flag is set).\n373:           # The markdown command parses $ARGUMENTS and binds {resource_map_emit} before this step runs.\n374:           resource_map.emit: \"{resource_map_emit}\"\n375:           createdAt: \"{ISO_8601_NOW}\"\n376:           status: \"initialized\"\n377:           executionMode: \"auto\"\n378:           lineage.sessionId: \"{session_id_init}\"\n379:           lineage.parentSessionId: null\n380:           lineage.lineageMode: \"new\"\n381:           lineage.generation: 1\n382:           lineage.continuedFromRun: null\n383:           nextRunAt: null\n384:           remainingDelayMs: null\n385:         output: \"{state_paths.config}\"\n386: \n387:       step_create_state_log:\n388:         action: \"Open the research run by appending deep_research.run_initialized through the gateway\"\n389:         note: |\n390:           The state log is a projection rebuilt by the gateway. Recording the run's opening in\n391:           the ledger gives every later state append the same authorized, ordered source.\n392:         command: |\n393:           GATEWAY=\".skilled/skills/system-deep-loop/runtime/scripts/append-mode-event.cjs\"\n394:           [ -f \"$GATEWAY\" ] || GATEWAY=\"scripts/append-mode-event.cjs\"\n395:           EVENT_FILE=\"$(mktemp \"${TMPDIR:-/tmp}/deep-research-run-open.XXXXXX\")\"\n396:           node -e '\n397:             const fs = require(\"fs\"), crypto = require(\"crypto\");\n398:             const [configPath] = process.argv.slice(1);\n399:             const raw = fs.readFileSync(configPath);\n400:             const config = JSON.parse(raw);\n401:             const sha = (value) => crypto.createHash(\"sha256\").update(value).digest(\"hex\");\n402:             const lineage = config.lineage || {};\n403:             const sessionId = lineage.sessionId;\n404:             const lineageId = lineage.parentSessionId || sessionId;\n405:             const generation = Number(lineage.generation) || 1;\n406:             const configDigest = sha(raw);\n407:             // The projected config row shows this topic; one the schema cannot hold is left out,\n408:             // and the row falls back to the run id rather than the run failing to open.\n409:             const topic = typeof config.topic === \"string\" && config.topic.trim() !== \"\" && config.topic.length <= 4096\n410:               ? config.topic\n411:               : null;\n412:             const event = {\n413:               stem: \"deep_research.run_initialized\",\n414:               scope: { runId: sessionId, lineageId },\n415:               data: {\n416:                 generation,\n417:                 ...(topic === null ? {} : { topic }),\n418:                 charterDigest: sha(Buffer.from(JSON.stringify({\n419:                   topic: config.topic,\n420:                   specFolder: config.specFolder || \"\",\n421:                 }))),\n422:                 configDigest,\n423:                 executorFingerprint: sha(Buffer.from(JSON.stringify(config.executor || {}))),\n424:                 replayFingerprint: sha(Buffer.from(JSON.stringify({\n425:                   runId: sessionId,\n426:                   lineageId,\n427:                   generation,\n428:                   configDigest,\n429:                 }))),\n430:                 maxIterations: Number(config.maxIterations),\n431:                 convergencePolicyVersion: \"convergence-policy@\" + (\n432:                   (config.antiConvergence && config.antiConvergence.convergenceMode) || \"default\"\n433:                 ),\n434:               },\n435:             };\n436:             process.stdout.write(JSON.stringify(event));\n437:           ' \"{state_paths.config}\" > \"$EVENT_FILE\" || { rm -f \"$EVENT_FILE\"; exit 1; }\n438:           node \"$GATEWAY\" --mode research --run-directory \"$(dirname \"{state_paths.state_log}\")\" --event-json \"$EVENT_FILE\"\n439:           STATUS=$?\n440:           rm -f \"$EVENT_FILE\"\n441:           exit \"$STATUS\"\n442:         output: \"{state_paths.state_log}\"\n443: \n444:       step_create_strategy:\n445:         action: \"Create strategy file from template with initial questions\"\n446:         template: .skilled/skills/system-deep-loop/deep-research/assets/deep-research-strategy.md\n447:         populate:\n448:           topic: \"{research_topic}\"\n449:           key_questions: \"Derive 3-5 key questions from the research topic\"\n450:           known_context: \"None\"\n451:           known_context_summary: \"None\"\n452:           max_iterations: \"{max_iterations}\"\n453:           convergence_threshold: \"{convergence_threshold}\"\n454:         output: \"{state_paths.strategy}\"\n455: \n456:       step_create_registry:\n457:         action: \"Initialize reducer-owned findings registry\"\n458:         content: '{\"openQuestions\":[],\"resolvedQuestions\":[],\"keyFindings\":[],\"ruledOutDirections\":[],\"metrics\":{\"iterationsCompleted\":0,\"openQuestions\":0,\"resolvedQuestions\":0,\"keyFindings\":0,\"convergenceScore\":0,\"coverageBySources\":{}}}'\n459:         output: \"{state_paths.registry}\"\n460: \n461:       step_enrich_strategy_context:\n462:         action: \"Ensure Known Context is written only after strategy.md exists\"\n463:         condition: \"prior_context_found\"\n464:         edit: \"{state_paths.strategy}\"\n465:         note: \"Append or replace the Known Context section with prior_context_summary and retained detail from prior_context\"\n466: \n467:       step_enrich_strategy_resource_map:\n468:         action: \"Inject resource-map status into Known Context after strategy.md exists\"\n469:         edit: \"{state_paths.strategy}\"\n470:         note: \"When resource_map_present is true, append the resource_map_known_context snapshot. When false, append 'resource-map.md not present; skipping coverage gate'.\"\n471: \n472:       step_detect_spec_present:\n473:         action: \"Classify late-INIT spec.md state after the durable research packet exists\"\n474:         inspect:\n475:           - \"{spec_folder}/spec.md\"\n476:           - \"{state_paths.lock_file}\"\n477:         classify:\n478:           no-spec: \"spec.md is absent before any pre-init mutation\"\n479:           spec-present: \"spec.md exists and approved host anchors are available for bounded mutation\"\n480:           spec-just-created-by-this-run: \"spec.md already carries this run's DR seed markers and should not be reseeded\"\n481:           conflict-detected: \"missing host anchor, duplicate markers, or generated-block ambiguity makes mutation unsafe\"\n482:         outputs:\n483:           - folder_state: \"no-spec | spec-present | spec-just-created-by-this-run | conflict-detected\"\n484:           - normalized_topic: \"Trim, lowercase, and collapse whitespace in research_topic before dedupe checks\"\n485:         append_to_jsonl: '{\"type\":\"event\",\"event\":\"spec_check_result\",\"folder_state\":\"{folder_state}\",\"normalized_topic\":\"{normalized_topic}\",\"specPath\":\"{spec_folder}/spec.md\",\"lockPath\":\"{state_paths.lock_file}\",\"timestamp\":\"{ISO_8601_NOW}\"}'\n486: \n487:       step_preinit_spec_branch:\n488:         action: \"Run the bounded pre-init spec branch required by spec_check_protocol\"\n489:         protocol_reference: \".skilled/skills/system-deep-loop/deep-research/references/protocol/spec-check-protocol.md\"\n490:         branches:\n491:           no-spec:\n492:             create: \"{spec_folder}/spec.md\"\n493:             seed_markers:\n494:               - \"<!-- DR-SEED:REQUIREMENTS -->\"\n495:               - \"<!-- DR-SEED:SCOPE -->\"\n496:             requirements_host: \"Seed Requirements from the research ask without broadening scope\"\n497:             scope_host: \"Seed Scope from the research ask without inventing implementation details\"\n498:             set:\n499:               folder_state: \"spec-just-created-by-this-run\"\n500:               validate_spec_doc: true\n501:             append_to_jsonl: '{\"type\":\"spec_mutation\",\"event\":\"spec_seed_created\",\"folder_state\":\"spec-just-created-by-this-run\",\"anchors_touched\":[\"Requirements\",\"Scope\"],\"diff_summary\":\"Seeded Level 1 spec.md from research topic with DR seed markers.\",\"seed_markers\":[\"DR-SEED:REQUIREMENTS\",\"DR-SEED:SCOPE\"],\"timestamp\":\"{ISO_8601_NOW}\"}'\n502:           spec-present:\n503:             edit: \"{spec_folder}/spec.md\"\n504:             set:\n505:               validate_spec_doc: true\n506:             idempotency_check:\n507:               host_anchor: \"Open Questions\"\n508:               normalized_match: \"Normalize the existing anchor text by lowercasing, stripping punctuation, collapsing whitespace, and trimming before comparing with {normalized_topic}.\"\n509:               if_match:\n510:                 skip_append: true\n511:                 append_to_jsonl: '{\"type\":\"spec_mutation\",\"event\":\"spec_preinit_context_deduped\",\"folder_state\":\"spec-present\",\"anchors_touched\":[\"Open Questions\"],\"diff_summary\":\"Skipped duplicate pre-init topic append because normalized topic already exists in Open Questions.\",\"normalized_topic\":\"{normalized_topic}\",\"specPath\":\"{spec_folder}/spec.md\",\"timestamp\":\"{ISO_8601_NOW}\"}'\n512:               if_no_match:\n513:                 append_only:\n514:                   - host_anchor: \"Open Questions\"\n515:                     content: \"Add the normalized research topic only if it is not already present.\"\n516:                   - host_anchor: \"Research Context\"\n517:                     content: \"Add a bounded note that deep-research is active for this topic and that research/research.md remains canonical.\"\n518:                 append_to_jsonl: '{\"type\":\"spec_mutation\",\"event\":\"spec_preinit_context_added\",\"folder_state\":\"spec-present\",\"anchors_touched\":[\"Open Questions\",\"Research Context\"],\"diff_summary\":\"Appended bounded pre-init research context for the normalized topic.\",\"normalized_topic\":\"{normalized_topic}\",\"specPath\":\"{spec_folder}/spec.md\",\"timestamp\":\"{ISO_8601_NOW}\"}'\n519:           spec-just-created-by-this-run:\n520:             verify_markers:\n521:               - \"<!-- DR-SEED:REQUIREMENTS -->\"\n522:               - \"<!-- DR-SEED:SCOPE -->\"\n523:             set:\n524:               validate_spec_doc: false\n525:             note: \"Treat already-seeded spec.md as a no-op guard and continue.\"\n526:           conflict-detected:\n527:             append_to_jsonl: '{\"type\":\"spec_mutation\",\"event\":\"spec_mutation_conflict\",\"folder_state\":\"conflict-detected\",\"reason\":\"Pre-init spec.md mutation is ambiguous or unsafe.\",\"specPath\":\"{spec_folder}/spec.md\",\"timestamp\":\"{ISO_8601_NOW}\"}'\n528:             halt: true\n529: \n530:       step_validate_preinit_spec_doc:\n531:         action: \"Run targeted strict validation after any deep-research pre-init spec.md mutation\"\n532:         condition: \"validate_spec_doc\"\n533:         command: \"SPECKIT_RULES=FRONTMATTER_VALID,LEVEL_DECLARED,TEMPLATE_SOURCE,PLACEHOLDER_FILLED,ANCHORS_VALID,SPEC_DOC_INTEGRITY,TOC_POLICY bash .skilled/skills/system-spec-kit/runtime/cli/spec/validate.sh {spec_folder} --strict\"\n534:         note: \"This enforces the authored-spec markdown structural contract without applying full-packet required-file or completeness checks to workflow-owned research artifacts. It uses the Node validation orchestrator, whose strict path was measured at about 108ms for a fresh Level 3 packet on the local harness.\"\n535: \n536:       step_telemetry_heartbeat_started:\n537:         action: \"Emit a single-loop started row in the orchestration status ledger\"\n538:         skip_when: \"config.fanout is present\"\n539:         canonical_lifecycle_event: \"iteration_start\"\n540:         command: |\n541:           node --import \"$(node -p \"require.resolve('tsx', { paths: ['.skilled/skills/system-deep-loop/runtime'] })\")\" --input-type=module <<'EOF'\n542:           import { readFileSync } from 'node:fs';\n543: \n544:           import { appendJsonlIfChangedAtomic } from './.skilled/skills/system-deep-loop/runtime/lib/deep-loop/atomic-state.ts';\n545:           import observabilityEvents from './.skilled/skills/system-deep-loop/runtime/lib/deep-loop/observability-events.cjs';\n546: \n547:           const { appendObservabilityEvent } = observabilityEvents;\n548:           const config = JSON.parse(readFileSync('{state_paths.config}', 'utf8'));\n549:           const timestamp = '{ISO_8601_NOW}';\n550:           const sessionId = String(config.lineage?.sessionId ?? '{AUTO_SESSION_ID}');\n551:           const generation = Number(config.lineage?.generation ?? 1);\n552:           const observabilityPath = '{state_paths.packet_dir}/observability-events.jsonl';\n553:           const row = {\n554:             event: 'started',\n555:             label: 'single',\n556:             at: timestamp,\n557:             duration_ms: 0,\n558:             loop_type: 'research',\n559:             sessionId,\n560:             generation,\n561:             gauges: { iterations: 0, elapsed_ms: 0, score: 0 },\n562:           };\n563: \n564:           const appended = appendJsonlIfChangedAtomic('{state_paths.status_ledger}', row, {\n565:             diffData: { event: row.event, label: row.label, sessionId, generation, gauges: { iterations: 0, score: 0 } },\n566:             diffField: 'state_hash',\n567:           });\n568:           if (appended) {\n569:             try {\n570:               appendObservabilityEvent(observabilityPath, row, {\n571:                 producer: 'deep-research-auto',\n572:                 stream: 'single-loop-telemetry',\n573:                 subject: { label: row.label, sessionId, generation },\n574:                 event: row.event,\n575:                 status: 'running',\n576:               });\n577:             } catch {}\n578:           }\n579:           EOF\n580:         working_directory: \"{repo_root}\"\n581:         outputs:\n582:           - status_ledger_started: \"A fan-out-shaped status row with label single and event started\"\n583: \n584:       step_init_complete:\n585:         log: \"Initialization complete. Config, state, and strategy files created.\"\n586:         set: { current_iteration: 1, current_segment: 1, stuck_count: 0 }\n587: \n588:   # ═══════════════════════════════════════════════════════════════\n589:   # PHASE 2: ITERATION LOOP\n590:   # ═══════════════════════════════════════════════════════════════\n591:   phase_loop:\n592:     purpose: Dispatch agent iterations until convergence\n593:     repeat: true\n594:     max_repeats: \"{max_iterations}\"\n595:     steps:\n596: \n597:       step_refresh_lock:\n598:         action: \"Refresh the packet lock heartbeat before the iteration begins\"\n599:         command: \"node .skilled/skills/system-deep-loop/runtime/scripts/loop-lock.cjs refresh --lock-path {state_paths.lock_file} --owner-pid {captured_owner_pid} --nonce {captured_acquire_nonce}\"\n600:         on_refresh: \"If the refresh output has refreshed:false, fail closed: lost the packet lock. This run no longer holds the packet and must stop rather than iterate without it.\"\n601: \n602:       step_record_artifact_migration:\n603:         action: \"Record a legacy artifact alias read once per session, after the run is open\"\n604:         skip_when: \"legacy_migration_detected != true or migration_recorded == true\"\n605:         append_jsonl: '{\"type\":\"event\",\"event\":\"migration\",\"legacyPath\":\"{legacy_path}\",\"canonicalPath\":\"{canonical_path}\",\"timestamp\":\"{ISO_8601_NOW}\"}'\n606:         set: { migration_recorded: true }\n607: \n608:       step_read_state:\n609:         action: \"Read current state from JSONL and strategy\"\n610:         read:\n611:           - \"{state_paths.state_log}\"\n612:           - \"{state_paths.strategy}\"\n613:           - \"{state_paths.config}\"\n614:         extract:\n615:           - iteration_count: \"Count distinct run values (run, else iteration) across lines where type === 'iteration'; a redispatched run counts once\"\n616:           - highest_run: \"Highest run value (run, else iteration) across lines where type === 'iteration', else 0\"\n617:           - current_iteration: \"max(highest_run, iteration_count) + 1\"\n618:           - current_segment: \"Latest segment_start event segment, else 1\"\n619:           - last_newInfoRatio: \"Extract newInfoRatio from last iteration record\"\n620:           - last_focus: \"Extract focus from latest iteration record, else 'none yet'\"\n621:           - ratio_prev: \"Extract newInfoRatio from second-latest iteration record, else 'N/A'\"\n622:           - ratio_latest: \"Extract newInfoRatio from latest iteration record, else 'N/A'\"\n623:           - next_focus: \"Extract 'Next Focus' section from strategy.md\"\n624:           - remaining_questions: \"Count unchecked items in 'Key Questions'\"\n625:           - remaining_questions_list: \"List unchecked key questions from strategy.md\"\n626:           - carried_forward_open_questions: \"Extract 'Carried-Forward Open Questions' section from strategy.md, else '[None yet]'\"\n627:           - answered_count: \"Count answered questions from strategy.md\"\n628:           - total_questions: \"Count total questions tracked in strategy.md\"\n629:           - resource_map_present: \"Extract boolean from deep-research-config.json, default false\"\n630:           - resource_map_prompt_line: \"If resource_map_present is true, return 'Resource map: prior-inventoried files are listed in {spec_folder}/resource-map.md; treat them as the exclusion set when hunting for net-new files; flag only missed-from-map candidates as gaps.' Else return 'Resource map: resource-map.md not present; skipping coverage gate.'\"\n631:           - lineage_context_prompt_line: \"If a refreshed lineage context summary exists from the previous iteration, return 'Lineage context refresh: {summary}'. Else use prior_context_summary from startup when available; otherwise return 'Lineage context refresh: none loaded yet.'\"\n632:           - least_explored: \"First unanswered question not covered by the most recent iteration focus, else first unanswered question\"\n633:           - last_3_summaries: \"Summarize the latest 3 iteration records as 'run N: focus (ratio)'\"\n634:           - latest_status: \"Extract status from latest iteration record, else 'none yet'\"\n635:           - nextRunAt: \"Extract nullable nextRunAt from deep-research-config.json, default null\"\n636:           - remainingDelayMs: \"Extract nullable remainingDelayMs from deep-research-config.json, default null\"\n637:           - min_iterations_present: \"Boolean true when deep-research-config.json has a numeric minIterations field\"\n638:           - min_iterations_missing_warning: \"Boolean true when minIterations is missing; use no floor and log a warning so older configs keep prior stop behavior\"\n639:           - min_iterations_raw: \"Extract numeric minIterations from deep-research-config.json when present, default 0\"\n640:           - effective_min_iterations: \"Clamp min_iterations_raw to the inclusive range 0..max_iterations; if min_iterations_raw exceeds max_iterations, use max_iterations\"\n641:           - min_iterations_clamped: \"Boolean true when min_iterations_raw > max_iterations\"\n642:           - min_iterations_guard_already_passed: \"Boolean true when the floor had already cleared before this iteration: iteration_count - 1 >= effective_min_iterations\"\n643:           - convergence_mode: \"Extract antiConvergence.convergenceMode when it is one of 'default', 'off', 'sliding-window', or 'divergent'; default to 'default'\"\n644:           - stop_policy: \"Extract stopPolicy from deep-research-config.json, default 'convergence'. Valid values: convergence, max-iterations.\"\n645:           - convergence_mode_warning: \"Boolean true when antiConvergence.convergenceMode is present with an unsupported value; use 'default'\"\n646:           - rejected_patterns_count: \"Read registry.rejectedPatterns length when registry exists, else 0\"\n647:           - rejected_candidate_matches: \"Read registry.suppressedCandidates when registry exists, else []\"\n648:           - rejected_pattern_fuzzy_threshold: \"Read config.rejectedPatternFuzzyThreshold when present, else 0.85\"\n649:           - min_idea_observations: \"Read config.minIdeaObservations when present, default 2; clamp to 1..10\"\n650:           - observed_ideas_count: \"Read registry.observedIdeas length when registry exists, else 0\"\n651:           - promoted_ideas_count: \"Read registry.promotedIdeas length when registry exists, else 0\"\n652:           - promoted_ideas_list: \"Read registry.promotedIdeas idea text in rank order when registry exists, else []\"\n653:           - suppressed_ideas_count: \"Read registry.suppressedIdeas length when registry exists, else 0\"\n654:           - pivot_lineage: \"Summarize registry.divergence.completed and registry.divergence.overrides with pivot ids, source iterations, and selected focus; else 'none yet'\"\n655:           - saturated_directions: \"List registry.divergence.saturatedDirections; else 'none yet'\"\n656: \n657:       step_run_now_check:\n658:         action: \"Detect and consume a one-shot run-now sentinel before pause/convergence/dispatch\"\n659:         command: |\n660:           GATEWAY=\".skilled/skills/system-deep-loop/runtime/scripts/append-mode-event.cjs\"\n661:           [ -f \"$GATEWAY\" ] || GATEWAY=\"scripts/append-mode-event.cjs\"\n662:           EVENT_DIR=\"$(mktemp -d \"${TMPDIR:-/tmp}/deep-research-run-now.XXXXXX\")\"\n663:           node - \"$EVENT_DIR\" <<'EOF'\n664:           const { existsSync, renameSync, unlinkSync, writeFileSync } = require('node:fs');\n665:           const { join } = require('node:path');\n666: \n667:           const eventDir = process.argv[2];\n668:           const sentinelPath = \"{state_paths.run_now_sentinel}\";\n669:           const pausePath = \"{state_paths.pause_sentinel}\";\n670:           const sessionId = \"{config.lineage.sessionId}\";\n671:           const generation = Number(\"{config.lineage.generation}\");\n672:           const run = Number(\"{current_iteration}\");\n673: \n674:           // The state log is a projection the gateway rebuilds from the ledger, so a\n675:           // run-now row is staged as a canonical ledger event and appended by the\n676:           // gateway; a write beside the projection is dropped by the next refresh.\n677:           // The loop boundary has no lineage identity yet, so the session names both\n678:           // scope halves rather than inventing a second identifier.\n679:           const scope = { runId: sessionId, lineageId: sessionId };\n680: \n681:           let sequence = 0;\n682: \n683:           function record(event, fields) {\n684:             sequence += 1;\n685:             writeFileSync(\n686:               join(eventDir, `${String(sequence).padStart(2, \"0\")}-${event}.json`),\n687:               JSON.stringify({\n688:                 stem: `deep_research.${event}`,\n689:                 scope,\n690:                 data: { mode: \"research\", run, sessionId, generation, ...fields },\n691:               }),\n692:               \"utf8\",\n693:             );\n694:           }\n695: \n696:           if (existsSync(sentinelPath)) {\n697:             record(\"run_now_requested\", { sentinelPath });\n698:             if (existsSync(pausePath)) {\n699:               record(\"run_now_rejected\", {\n700:                 sentinelPath,\n701:                 reason: \"loop_paused\",\n702:                 pauseSentinelPath: pausePath,\n703:               });\n704:             } else {\n705:               const claimPath = `${sentinelPath}.consuming.${process.pid}.${Date.now()}`;\n706:               try {\n707:                 renameSync(sentinelPath, claimPath);\n708:                 unlinkSync(claimPath);\n709:                 record(\"run_now_accepted\", {\n710:                   sentinelPath,\n711:                   dispatchEvent: \"iteration_start\",\n712:                 });\n713:               } catch (error) {\n714:                 if (!error || error.code !== \"ENOENT\") {\n715:                   throw error;\n716:                 }\n717:               }\n718:             }\n719:           }\n720:           EOF\n721:           for eventFile in \"$EVENT_DIR\"/*.json; do\n722:             [ -e \"$eventFile\" ] || continue\n723:             node \"$GATEWAY\" --mode research --run-directory \"$(dirname \"{state_paths.state_log}\")\" --event-json \"$eventFile\"\n724:             GATEWAY_STATUS=$?\n725:             if [ \"$GATEWAY_STATUS\" -ne 0 ]; then\n726:               rm -rf \"$EVENT_DIR\"\n727:               exit \"$GATEWAY_STATUS\"\n728:             fi\n729:           done\n730:           rm -rf \"$EVENT_DIR\"\n731:         outputs:\n732:           - run_now_requested: \"Emitted when {state_paths.run_now_sentinel} exists at the loop boundary\"\n733:           - run_now_accepted: \"Emitted after the sentinel is atomically renamed and deleted before dispatch\"\n734:           - run_now_rejected: \"Emitted with reason loop_paused when pause takes precedence; sentinel remains present\"\n735: \n736:       step_check_pause_sentinel:\n737:         action: \"Check for pause sentinel file\"\n738:         check: \"Does {state_paths.pause_sentinel} exist?\"\n739:         if_exists:\n740:           append_jsonl: '{\"type\":\"event\",\"event\":\"userPaused\",\"mode\":\"research\",\"run\":{current_iteration},\"stopReason\":\"userPaused\",\"sentinelPath\":\"{state_paths.pause_sentinel}\",\"timestamp\":\"{ISO_8601_NOW}\",\"sessionId\":\"{config.lineage.sessionId}\",\"generation\":{config.lineage.generation}}'\n741:           message: \"Research paused. Delete research/.deep-research-pause to resume.\"\n742:           halt: true\n743:         if_not_exists:\n744:           proceed: true\n745: \n746:       step_validate_convergence_config:\n747:         action: \"Validate convergence floor settings when loading config\"\n748:         if_min_iterations_missing:\n749:           bookkeeping_log: '{\"type\":\"event\",\"event\":\"config_warning\",\"mode\":\"research\",\"field\":\"minIterations\",\"fallback\":0,\"message\":\"minIterations missing; using no convergence floor for backward compatibility.\",\"timestamp\":\"{ISO_8601_NOW}\",\"sessionId\":\"{config.lineage.sessionId}\",\"generation\":{config.lineage.generation}}'\n[Output truncated. Continue reading with offset: 750]","title":"read","metadata":{"metadata":{"truncated":true},"content":[{"type":"text","text":"Read file .skilled/commands/deep/assets/deep-research-auto.yaml, lines 1-749\n1: # ─────────────────────────────────────────────────────────────────\n2: # DEEP RESEARCH: AUTONOMOUS DEEP RESEARCH LOOP (AUTO MODE)\n3: # ─────────────────────────────────────────────────────────────────\n4: # YAML PREDICATE GRAMMAR CONTRACT:\n5: # - This asset does not currently use typed BooleanExpr predicates under\n6: #   `when:`; flow control is branch-label-driven (`on_resume`, `on_fresh`,\n7: #   `on_restart`, etc.). Retain the existing shape.\n8: # - `after:` carries prose timing / narrative notes if needed; `when:` in\n9: #   this file is reserved for future typed predicates and must NOT carry\n10: #   free-form narrative prose.\n11: # - See `.skilled/skills/system-spec-kit/shared/predicates/boolean-expr.ts`\n12: #   for the canonical BooleanExpr grammar.\n13: #\n14: # GATE 3 CLASSIFICATION:\n15: # - `resume` is a tested WRITE-PATH that produces `iteration-NNN.md` files\n16: #   and JSONL state-log appends. The workflow classifies resume as\n17: #   write-path below (see `gate3_classification` fields) so Gate 3 trigger\n18: #   extraction can surface resume correctly rather than false-negative.\n19: # ─────────────────────────────────────────────────────────────────\n20: role: Deep Research Loop Manager\n21: purpose: Iterative deep research with convergence detection\n22: action: Run deep-research loop from initialization through synthesis\n23: operating_mode:\n24:   workflow: iterative_loop\n25:   workflow_compliance: MANDATORY\n26:   workflow_execution: autonomous\n27:   approvals: none\n28:   tracking: progressive_research_state\n29:   validation: convergence_detection\n30: \n31: # ─────────────────────────────────────────────────────────────────\n32: # OPERATING PRINCIPLES\n33: # ─────────────────────────────────────────────────────────────────\n34: operating_principles:\n35:   core: \"Fresh context per iteration + externalized state = no context degradation\"\n36:   approach: \"Dispatch focused agent, evaluate convergence, repeat or stop\"\n37:   mandate: \"Never hold findings in memory; write everything to files\"\n38: \n39: # ─────────────────────────────────────────────────────────────────\n40: # USER INPUTS (from setup phase)\n41: # ─────────────────────────────────────────────────────────────────\n42: user_inputs:\n43:   research_topic: \"[RESEARCH_TOPIC] - Topic to investigate deeply. REQUIRED.\"\n44:   spec_folder: \"[SPEC_FOLDER] - Spec folder path. REQUIRED.\"\n45:   max_iterations: \"[MAX_ITERATIONS] - Maximum loop iterations. Default: 10.\"\n46:   convergence_threshold: \"[CONVERGENCE_THRESHOLD] - Stop threshold. Default: 0.05.\"\n47:   convergence_mode: \"[default|off|sliding-window|divergent] - Convergence policy modifier. Default: default.\"\n48:   stop_policy: \"[convergence|max-iterations] - Convergence stop policy; max-iterations forces the loop to run every iteration. Default: convergence.\"\n49: \n50: # ─────────────────────────────────────────────────────────────────\n51: # CONTEXT LOADING\n52: # ─────────────────────────────────────────────────────────────────\n53: context_loading:\n54:   trigger: \"At workflow START, before phase_init\"\n55:   purpose: \"Load prior research context for the topic and buffer it until strategy.md exists\"\n56:   retrieval:\n57:     mechanism: \"continuity-ladder-then-ripgrep\"\n58:     note: \"File reads only. Nothing here needs a running daemon, and every step is reproducible by hand.\"\n59:     ladder:\n60:       - \"{spec_folder}/handover.md when present\"\n61:       - \"the _memory.continuity frontmatter block in {spec_folder}/implementation-summary.md\"\n62:       - \"the packet's canonical spec docs, spec.md and decision-record.md, for what the first two steps leave open\"\n63:     free_text_recipe: \"rg --no-config --json --fixed-strings --ignore-case -C 2 --glob '*.md' --glob '!**/z_archive/**' --glob '!**/node_modules/**' -- '{research_topic}' specs .skilled\"\n64:     recipe_contract: \".skilled/skills/system-spec-kit/references/retrieval/retrieval-conventions.md\"\n65:     exit_status: \"0 is a hit set, 1 is a clean no-hit, 2 or higher is a failure that must be surfaced instead of reported as no-hit\"\n66:     ranking: \"Ripgrep does not rank. Order the hits caller-side with the tuple in retrieval-conventions.md section 5.\"\n67:   when_to_skip: [\"User says 'skip context' or 'fresh start'\"]\n68:   behavior:\n69:     if_context_found: \"Store full results as prior_context plus a concise prior_context_summary; inject after strategy.md is created.\"\n70:     if_no_context: \"Set prior_context and prior_context_summary to 'None' and continue.\"\n71: \n72: # ─────────────────────────────────────────────────────────────────\n73: # SKILL REFERENCE\n74: # ─────────────────────────────────────────────────────────────────\n75: skill_reference:\n76:   skill: system-deep-loop\n77:   skill_md: .skilled/skills/system-deep-loop/deep-research/SKILL.md\n78:   references:\n79:     loop_protocol: .skilled/skills/system-deep-loop/deep-research/references/protocol/loop-protocol.md\n80:     spec_check_protocol: .skilled/skills/system-deep-loop/deep-research/references/protocol/spec-check-protocol.md\n81:     state_format: .skilled/skills/system-deep-loop/deep-research/references/state/state-format.md\n82:     convergence: .skilled/skills/system-deep-loop/deep-research/references/convergence/convergence.md\n83:   templates:\n84:     config: .skilled/skills/system-deep-loop/deep-research/assets/deep-research-config.json\n85:     strategy: .skilled/skills/system-deep-loop/deep-research/assets/deep-research-strategy.md\n86: \n87: # ─────────────────────────────────────────────────────────────────\n88: # AGENT CONFIGURATION\n89: # ─────────────────────────────────────────────────────────────────\n90: agent_config:\n91:   agent: deep-research\n92:   agent_file: \".skilled/agents/deep-research.md\"\n93:   # Canonical path. Runtime-specific directories (e.g. .claude/agents/) reference this source.\n94:   model: opus\n95:   leaf_only: true\n96:   tools: [Read, Write, Edit, Bash, Grep, Glob, WebFetch]\n97:   mcp_servers: []\n98:   tool_call_budget: { target: 12, max: 24 }\n99: \n100: # ─────────────────────────────────────────────────────────────────\n101: # STATE FILE PATHS\n102: # ─────────────────────────────────────────────────────────────────\n103: # ─────────────────────────────────────────────────────────────────\n104: # CANONICAL STATE WRITE MECHANISM\n105: # ─────────────────────────────────────────────────────────────────\n106: state_write_protocol:\n107:   mechanism: \"append-gateway\"\n108:   command: \"node .skilled/skills/system-deep-loop/runtime/scripts/append-mode-event.cjs --mode research --run-directory {artifact_dir} --event-json <record file>\"\n109:   applies_to: \"every append_to_jsonl and append_jsonl directive in this workflow\"\n110:   refusal_handling: \"halt on exit 2; never fall back to a direct file write. Exit 1 on a row that is still routed through the gateway is a workflow defect and halts; the pinned_bookkeeping rows are recorded through bookkeeping_log and are never routed.\"\n111:   pinned_bookkeeping:\n112:     events: [config_warning, graph_convergence, lock_released, schema_mismatch]\n113:     directive: \"bookkeeping_log\"\n114:     handling: \"These rows are workflow bookkeeping that the research ledger schema pins to the legacy path: they have no lossless research-event target, so the gateway would refuse them with exit 1 and write nothing. They are never sent to the gateway. The step prints the row in its log line and continues; none of them is a halt condition.\"\n115:   contract: |\n116:     The directives below specify WHAT to record; this block specifies the mechanism. The\n117:     command accepts a canonical event envelope — a `stem` with `scope` and `data`, or an\n118:     `event_type` with a `payload` — and for this mode it also accepts a legacy-shaped row,\n119:     which it upcasts before appending. Where the upcast is lossy it returns a warning, and\n120:     the warning is surfaced rather than swallowed. Some directives below record workflow\n121:     bookkeeping rather than research semantics: the schema deliberately pins several of them\n122:     to the legacy path and the upcaster has no registered stem for the rest. Those rows are\n123:     declared under pinned_bookkeeping and recorded through bookkeeping_log, so they are never\n124:     routed here. A refusal names its own reason, so the caller can tell a deliberate pin from\n125:     a missing stem. A row the upcaster does refuse returns exit 1 and writes nothing, with the\n126:     reason naming why. Exit 1 is distinct from the exit 2 refusal described in the next\n127:     paragraph: exit 1 means the input never reached authority, exit 2 means authority refused\n128:     it.\n129: \n130:     The gateway authorizes the write against the mode's durable authority record, serialises it\n131:     behind the ledger fence, returns a receipt, and refreshes state_log from the ledger. Exit 0\n132:     means the record is durable. Exit 2 means it was refused, and the refusal names the check\n133:     that failed.\n134: \n135:     Writing state_log directly bypasses ordering, authorization, and the receipt. Two writers\n136:     can then interleave with no shared ordering, and a record nobody authorized carries no\n137:     receipt, so a later reader cannot tell an accepted record from an invented one. A refusal\n138:     is a halt, never a reason to write the file directly.\n139: \n140:     There is no direct-append exception. The run-now sentinels, the restored-sentinel row and\n141:     the synthesis reconciliation rows are canonical ledger events, because state_log is a\n142:     projection the gateway rebuilds from the ledger and a row written beside it is dropped by\n143:     the next refresh.\n144: \n145: state_paths:\n146:   # Template paths document the canonical packet layout. Runtime resolution happens via\n147:   # step_resolve_artifact_root plus the shared resolver, so root specs keep root-local\n148:   # research/ and child phases keep local research/ packet directories.\n149:   packet_dir: \"{artifact_dir}\"\n150:   config: \"{artifact_dir}/deep-research-config.json\"\n151:   state_log: \"{artifact_dir}/deep-research-state.jsonl\"\n152:   status_ledger: \"{artifact_dir}/orchestration-status.log\"\n153:   strategy: \"{artifact_dir}/deep-research-strategy.md\"\n154:   registry: \"{artifact_dir}/findings-registry.json\"\n155:   dashboard: \"{artifact_dir}/deep-research-dashboard.md\"\n156:   pause_sentinel: \"{artifact_dir}/.deep-research-pause\"\n157:   run_now_sentinel: \"{artifact_dir}/.deep-research-run-now\"\n158:   lock_file: \"{artifact_dir}/.deep-research.lock\"\n159:   prompt_dir: \"{artifact_dir}/prompts\"\n160:   iteration_dir: \"{artifact_dir}/iterations\"\n161:   iteration_pattern: \"{artifact_dir}/iterations/iteration-{NNN}.md\"\n162:   # Per-iteration structured delta stream (one file per iteration) — complement to the\n163:   # canonical state_log append. The delta file MUST contain at least one record whose\n164:   # `type === \"iteration\"` so the reducer can rehydrate iteration state after a partial\n165:   # run. Variants like `\"iteration_delta\"` are silently dropped by the reducer; the\n166:   # post_dispatch_validate step enforces the canonical type below.\n167:   delta_dir: \"{artifact_dir}/deltas\"\n168:   delta_pattern: \"{artifact_dir}/deltas/iter-{NNN}.jsonl\"\n169:   research_output: \"{artifact_dir}/research.md\"\n170:   resource_map_output: \"{artifact_dir}/resource-map.md\"\n171:   archive_root: \"{artifact_archive_root}\"\n172:   synthesis_snapshot_pattern: \"{artifact_dir}/synthesis-v{generation}.md\"\n173: \n174: # ─────────────────────────────────────────────────────────────────\n175: # WORKFLOW\n176: # ─────────────────────────────────────────────────────────────────\n177: workflow:\n178: \n179:   step_resolve_artifact_root:\n180:     description: \"Resolve artifact directory — use fan-out lineage override when provided, else resolve from spec_folder\"\n181:     note: \"Root specs keep research artifacts directly in {spec_folder}/research/. Child phases and sub-phases keep local packet directories in {spec_folder}/research/{packet}/, and archives stay local at {spec_folder}/research_archive/{packet}/.\"\n182:     branch_on: \"config.fanout_lineage_artifact_dir\"\n183:     if_present:\n184:       bind:\n185:         artifact_dir: \"{config.fanout_lineage_artifact_dir}\"\n186:         artifact_root_dir: \"{config.fanout_lineage_artifact_dir}\"\n187:         artifact_subfolder: null\n188:         artifact_archive_root: \"{config.fanout_lineage_artifact_dir}/_archive\"\n189:     if_absent:\n190:       command: \"node -e \\\"const { resolveArtifactRoot } = require('./.skilled/skills/system-spec-kit/shared/review-research-paths.cjs'); console.log(JSON.stringify(resolveArtifactRoot('{spec_folder}', 'research')));\\\"\"\n191:       outputs:\n192:         - artifact_root_dir: \"Resolved local research owner directory\"\n193:         - artifact_subfolder: \"Local packet subfolder ({ownerSlug}-pt-{NN}), else null\"\n194:         - artifact_dir: \"Resolved research packet directory for this target\"\n195:         - artifact_archive_root: \"Resolved local research archive directory for this target\"\n196: \n197:   step_bind_reducer_artifact_arg:\n198:     description: \"Keep the reducer on the lineage-owned artifact directory during fan-out\"\n199:     branch_on: \"config.fanout_lineage_artifact_dir\"\n200:     if_present:\n201:       bind:\n202:         reducer_artifact_arg: \"--artifact-dir {artifact_dir}\"\n203:     if_absent:\n204:       bind:\n205:         reducer_artifact_arg: \"\"\n206: \n207:   step_fanout_spawn:\n208:     description: \"Spawn fan-out lineages; skip and proceed to phase_init normally when single-executor\"\n209:     skip_when: \"config.fanout is absent\"\n210:     instructions: |\n211:       Fan-out mode is active. Spawn all lineages. Each lineage runs the full loop in its own\n212:       isolated sub-packet under {artifact_dir}/lineages/{label}/.\n213:       fanout-run.cjs owns native and CLI lineage execution; native is run through the\n214:       deep/research command surface with config.fanout_lineage_artifact_dir so the LEAF\n215:       deep-research agent is used only for individual iterations, never as a full-loop\n216:       sub-agent or pasted phase-running prompt.\n217:       After all lineages complete, jump directly to phase_synthesis — skip phase_init and\n218:       phase_main_loop entirely (those are the single-executor path). The merge step in\n219:       phase_synthesis will consolidate results across all lineages.\n220:     sub_steps:\n221:       step_fanout_spawn_cli:\n222:         description: \"Spawn all native and CLI lineages in capped worker pool\"\n223:         skip_when: \"no entries in config.fanout.executors\"\n224:         command: |\n225:           node .skilled/skills/system-deep-loop/runtime/scripts/fanout-run.cjs \\\n226:             --spec-folder {spec_folder} \\\n227:             --loop-type research \\\n228:             --research-topic \"{research_topic}\" \\\n229:             --fanout-config-json '{config.fanout_json}' \\\n230:             --base-artifact-dir {artifact_dir} \\\n231:             --convergence-threshold {convergence_threshold} \\\n232:             --stop-policy {stop_policy} \\\n233:             --convergence-mode {convergence_mode}\n234:         working_directory: \"{repo_root}\"\n235:         wait_for_completion: true\n236: \n237:   # ═══════════════════════════════════════════════════════════════\n238:   # PHASE 1: INITIALIZATION\n239:   # ═══════════════════════════════════════════════════════════════\n240:   phase_init:\n241:     purpose: Create all state files for the research session\n242:     steps:\n243: \n244:       step_preflight_contract:\n245:         action: \"Validate required setup bindings and executable workflow contract before any file writes\"\n246:         verify:\n247:           - required_values_present: [research_topic, spec_folder, max_iterations, convergence_threshold, convergence_mode, stop_policy]\n248:           - spec_folder_is_within: \"specs/ or .opencode/specs/ (canonicalize alias roots before validation)\"\n249:           - unresolved_placeholders: \"FAIL if any user-facing template references placeholders not produced by earlier steps\"\n250:           - tool_contract: \"FAIL if executable steps reference tools outside the command allowlist\"\n251:         on_fail: \"Halt with STATUS=FAIL and report the missing binding or unsupported contract reference\"\n252: \n253:       step_create_directories:\n254:         action: \"Create spec folder and research packet directories if they don't exist\"\n255:         command: \"mkdir -p {state_paths.prompt_dir} {state_paths.iteration_dir} {state_paths.delta_dir}\"\n256: \n257:       step_detect_resource_map:\n258:         action: \"Detect resource-map.md before config creation so init can persist the flag and seed Known Context\"\n259:         inspect:\n260:           - \"{spec_folder}/resource-map.md\"\n261:         classify:\n262:           present: \"resource-map.md exists at init\"\n263:           absent: \"resource-map.md does not exist at init\"\n264:         outputs:\n265:           - resource_map_present: \"Boolean true when {spec_folder}/resource-map.md exists, else false\"\n266:           - resource_map_known_context: \"When present: summarize the map by section with entry counts across READMEs, Documents, Commands, Agents, Skills, Specs, Scripts, Tests, Config, and Meta, plus a one-line theme summary for each section. When absent: 'resource-map.md not present; skipping coverage gate'.\"\n267: \n268:       step_resolve_canonical_names:\n269:         action: \"Resolve canonical research packet artifact names before classification\"\n270:         inspect_legacy:\n271:           - \"{state_paths.packet_dir}/config.json\"\n272:           - \"{state_paths.packet_dir}/state.jsonl\"\n273:           - \"{state_paths.packet_dir}/strategy.md\"\n274:           - \"{state_paths.packet_dir}/dashboard.md\"\n275:           - \"{state_paths.packet_dir}/.pause\"\n276:         migration_policy: \"dual-read / single-write for 4 weeks\"\n277:         on_legacy_read:\n278:           set: { legacy_migration_detected: true, migration_recorded: false }\n279:           outputs:\n280:             - legacy_path: \"The legacy artifact path that was read\"\n281:             - canonical_path: \"The canonical artifact path it maps to\"\n282:           note: \"Only detect and bind here. The migration row is appended by step_record_artifact_migration, once the session is classified and the run is open, because an append before classification would create the state log and turn a fresh packet into a partial one.\"\n283: \n284:       step_acquire_lock:\n285:         action: \"Acquire the single-writer advisory lock before session classification\"\n286:         command: \"node .skilled/skills/system-deep-loop/runtime/scripts/loop-lock.cjs acquire --lock-path {state_paths.lock_file} --packet-id {spec_folder} --ttl-ms 1800000\"\n287:         on_acquire: \"Capture lock.ownerPid as captured_owner_pid and lock.acquireNonce as captured_acquire_nonce from the JSON output, and reuse both for every release below. If acquired=false, fail closed: another deep-research run already holds this packet.\"\n288:         note: \"Uses the promoted runtime/ loop-lock CLI (single source of truth: stale-lock reclaim, clean owner-scoped release). macOS/BSD locking is advisory — best-effort single-writer, not a hard mutex across host calls. Acquire reclaims a stale lock itself and reports the old holder under `reclaimed`. A lock is stale when its heartbeat is older than twice its TTL, or when its owning process is known to be dead. No confirmation step exists in either mode: log a `reclaimed` holder and continue.\"\n289:         # Lock-cleanup contract: the lock file MUST be released on every terminal exit path that follows acquisition.\n290:         # Runtimes honoring step_acquire_lock are required to perform this cleanup before halting or pausing.\n291:         on_halt:\n292:           action: \"Release the lock before any terminal halt branch returns control\"\n293:           applies_to: [\"step_classify_session.on_invalid_state\", \"step_classify_session.on_completed_session\", \"step_preinit_spec_branch.conflict-detected\"]\n294:           command: \"node .skilled/skills/system-deep-loop/runtime/scripts/loop-lock.cjs release --lock-path {state_paths.lock_file} --owner-pid {captured_owner_pid} --nonce {captured_acquire_nonce}; failures here are logged but do not block the halt\"\n295:         on_cancel:\n296:           action: \"Release the lock on user cancel or pause-sentinel detection before sentinel processing\"\n297:           command: \"node .skilled/skills/system-deep-loop/runtime/scripts/loop-lock.cjs release --lock-path {state_paths.lock_file} --owner-pid {captured_owner_pid} --nonce {captured_acquire_nonce}; cancel completes regardless of cleanup result\"\n298:         on_workflow_exit:\n299:           action: \"Release the lock as the final step of any workflow exit path (success or failure)\"\n300:           command: \"node .skilled/skills/system-deep-loop/runtime/scripts/loop-lock.cjs release --lock-path {state_paths.lock_file} --owner-pid {captured_owner_pid} --nonce {captured_acquire_nonce}; idempotent, safe to invoke when already released\"\n301: \n302:       step_classify_session:\n303:         action: \"Classify the session before writing files\"\n304:         inspect:\n305:           - \"{state_paths.config}\"\n306:           - \"{state_paths.state_log}\"\n307:           - \"{state_paths.strategy}\"\n308:         classify:\n309:           fresh: \"None of the three state artifacts exist\"\n310:           resume: \"Config, JSONL, and strategy all exist and agree on topic/spec folder; missing wait-checkpoint fields are read as nextRunAt:null and remainingDelayMs:null\"\n311:           completed-session: \"Resume artifacts exist and config.status == 'complete'\"\n312:           invalid-state: \"Any partial, missing, or contradictory combination\"\n313:         outputs:\n314:           - session_state: \"fresh | resume | completed-session | invalid-state\"\n315:         on_resume:\n316:           # Resume is a WRITE-PATH. Produces `iteration-NNN.md` + JSONL appends.\n317:           # Gate 3 lists it as a trigger beside save context, save memory and /speckit:save.\n318:           gate3_classification: write-path\n319:           gate3_rationale: \"resume produces iteration-NNN.md writes and JSONL state-log appends\"\n320:           log: \"Auto-resume: state artifacts are complete and consistent. Continue the same lineage (sessionId unchanged, generation unchanged, no archive).\"\n321:           append_jsonl: '{\"type\":\"event\",\"event\":\"resumed\",\"mode\":\"research\",\"sessionId\":\"{session_id}\",\"parentSessionId\":\"{session_id}\",\"lineageMode\":\"resume\",\"continuedFromRun\":{iteration_count},\"generation\":{generation},\"archivedPath\":null,\"timestamp\":\"{ISO_8601_NOW}\"}'\n322:           skip_to: phase_loop\n323:         on_restart:\n324:           action: \"Archive the current research packet under the root-level research_archive/ tree and start a new lineage segment with a fresh sessionId and generation+1.\"\n325:           command: \"if [ -d {state_paths.packet_dir} ]; then mkdir -p {state_paths.archive_root} && mv {state_paths.packet_dir} {state_paths.archive_root}/{timestamp_slug}; fi\"\n326:           set:\n327:             lineage_mode: \"restart\"\n328:             parent_session_id: \"{prior_session_id}\"\n329:             generation: \"{prior_generation + 1}\"\n330:           append_jsonl: '{\"type\":\"event\",\"event\":\"restarted\",\"mode\":\"research\",\"sessionId\":\"{session_id}\",\"parentSessionId\":\"{prior_session_id}\",\"lineageMode\":\"restart\",\"generation\":{generation},\"archivedPath\":\"{state_paths.archive_root}/{timestamp_slug}\",\"timestamp\":\"{ISO_8601_NOW}\"}'\n331:           skip_to: step_create_config\n332:         note_deferred_branches: \"fork and completed-continue are deferred and no longer runtime-supported in this release. The reducer still reads `lineageMode` from config for dashboards and analysis, but only `new`, `resume`, and `restart` are live. See deep-research/references/protocol/loop-protocol.md §Lifecycle Branch Contract for the one-session contract.\"\n333:         on_completed_session:\n334:           log: \"Prior session already completed. Do not route directly to synthesis; archive the completed research/ tree or start a fresh packet instead.\"\n335:           halt: true\n336:           message: \"Completed deep-research packet detected. Archive or replace the existing research/ tree before starting a new session.\"\n337:         on_invalid_state:\n338:           halt: true\n339:           message: \"Existing deep-research state is incomplete or contradictory. Repair or archive the invalid research packet before continuing.\"\n340:         on_fresh:\n341:           action: \"Proceed with a new session\"\n342: \n343:       step_resolve_session_id:\n344:         action: \"Resolve init session id from caller when supplied, else preserve the auto-generated fallback\"\n345:         branch_on: \"session_id\"\n346:         if_present:\n347:           bind:\n348:             session_id_init: \"{session_id}\"\n349:         if_absent:\n350:           bind:\n351:             # The token is bound here so the fallback literal resolves to a real timestamp when no caller session_id is supplied.\n352:             AUTO_SESSION_ID: \"{ISO_8601_NOW}\"\n353:             session_id_init: \"{AUTO_SESSION_ID}\"\n354: \n355:       step_create_config:\n356:         action: \"Create deep-research-config.json from template\"\n357:         template: .skilled/skills/system-deep-loop/deep-research/assets/deep-research-config.json\n358:         populate:\n359:           topic: \"{research_topic}\"\n360:           maxIterations: \"{max_iterations}\"\n361:           minIterations: 3\n362:           # Semantic: newInfoRatio with negative-knowledge emphasis. See SKILL.md §\"Convergence Threshold Semantics\".\n363:           convergenceThreshold: \"{convergence_threshold}\"\n364:           stopPolicy: \"{stop_policy}\"\n365:           antiConvergence.convergenceMode: \"{convergence_mode}\"\n366:           antiConvergence.divergent: {}\n367:           stuckThreshold: 3\n368:           minIdeaObservations: 2\n369:           maxDurationMinutes: 120\n370:           specFolder: \"{spec_folder}\"\n371:           resource_map_present: \"{resource_map_present}\"\n372:           # Honor the parsed --no-resource-map flag from deep-research.md:73 (default true; false when flag is set).\n373:           # The markdown command parses $ARGUMENTS and binds {resource_map_emit} before this step runs.\n374:           resource_map.emit: \"{resource_map_emit}\"\n375:           createdAt: \"{ISO_8601_NOW}\"\n376:           status: \"initialized\"\n377:           executionMode: \"auto\"\n378:           lineage.sessionId: \"{session_id_init}\"\n379:           lineage.parentSessionId: null\n380:           lineage.lineageMode: \"new\"\n381:           lineage.generation: 1\n382:           lineage.continuedFromRun: null\n383:           nextRunAt: null\n384:           remainingDelayMs: null\n385:         output: \"{state_paths.config}\"\n386: \n387:       step_create_state_log:\n388:         action: \"Open the research run by appending deep_research.run_initialized through the gateway\"\n389:         note: |\n390:           The state log is a projection rebuilt by the gateway. Recording the run's opening in\n391:           the ledger gives every later state append the same authorized, ordered source.\n392:         command: |\n393:           GATEWAY=\".skilled/skills/system-deep-loop/runtime/scripts/append-mode-event.cjs\"\n394:           [ -f \"$GATEWAY\" ] || GATEWAY=\"scripts/append-mode-event.cjs\"\n395:           EVENT_FILE=\"$(mktemp \"${TMPDIR:-/tmp}/deep-research-run-open.XXXXXX\")\"\n396:           node -e '\n397:             const fs = require(\"fs\"), crypto = require(\"crypto\");\n398:             const [configPath] = process.argv.slice(1);\n399:             const raw = fs.readFileSync(configPath);\n400:             const config = JSON.parse(raw);\n401:             const sha = (value) => crypto.createHash(\"sha256\").update(value).digest(\"hex\");\n402:             const lineage = config.lineage || {};\n403:             const sessionId = lineage.sessionId;\n404:             const lineageId = lineage.parentSessionId || sessionId;\n405:             const generation = Number(lineage.generation) || 1;\n406:             const configDigest = sha(raw);\n407:             // The projected config row shows this topic; one the schema cannot hold is left out,\n408:             // and the row falls back to the run id rather than the run failing to open.\n409:             const topic = typeof config.topic === \"string\" && config.topic.trim() !== \"\" && config.topic.length <= 4096\n410:               ? config.topic\n411:               : null;\n412:             const event = {\n413:               stem: \"deep_research.run_initialized\",\n414:               scope: { runId: sessionId, lineageId },\n415:               data: {\n416:                 generation,\n417:                 ...(topic === null ? {} : { topic }),\n418:                 charterDigest: sha(Buffer.from(JSON.stringify({\n419:                   topic: config.topic,\n420:                   specFolder: config.specFolder || \"\",\n421:                 }))),\n422:                 configDigest,\n423:                 executorFingerprint: sha(Buffer.from(JSON.stringify(config.executor || {}))),\n424:                 replayFingerprint: sha(Buffer.from(JSON.stringify({\n425:                   runId: sessionId,\n426:                   lineageId,\n427:                   generation,\n428:                   configDigest,\n429:                 }))),\n430:                 maxIterations: Number(config.maxIterations),\n431:                 convergencePolicyVersion: \"convergence-policy@\" + (\n432:                   (config.antiConvergence && config.antiConvergence.convergenceMode) || \"default\"\n433:                 ),\n434:               },\n435:             };\n436:             process.stdout.write(JSON.stringify(event));\n437:           ' \"{state_paths.config}\" > \"$EVENT_FILE\" || { rm -f \"$EVENT_FILE\"; exit 1; }\n438:           node \"$GATEWAY\" --mode research --run-directory \"$(dirname \"{state_paths.state_log}\")\" --event-json \"$EVENT_FILE\"\n439:           STATUS=$?\n440:           rm -f \"$EVENT_FILE\"\n441:           exit \"$STATUS\"\n442:         output: \"{state_paths.state_log}\"\n443: \n444:       step_create_strategy:\n445:         action: \"Create strategy file from template with initial questions\"\n446:         template: .skilled/skills/system-deep-loop/deep-research/assets/deep-research-strategy.md\n447:         populate:\n448:           topic: \"{research_topic}\"\n449:           key_questions: \"Derive 3-5 key questions from the research topic\"\n450:           known_context: \"None\"\n451:           known_context_summary: \"None\"\n452:           max_iterations: \"{max_iterations}\"\n453:           convergence_threshold: \"{convergence_threshold}\"\n454:         output: \"{state_paths.strategy}\"\n455: \n456:       step_create_registry:\n457:         action: \"Initialize reducer-owned findings registry\"\n458:         content: '{\"openQuestions\":[],\"resolvedQuestions\":[],\"keyFindings\":[],\"ruledOutDirections\":[],\"metrics\":{\"iterationsCompleted\":0,\"openQuestions\":0,\"resolvedQuestions\":0,\"keyFindings\":0,\"convergenceScore\":0,\"coverageBySources\":{}}}'\n459:         output: \"{state_paths.registry}\"\n460: \n461:       step_enrich_strategy_context:\n462:         action: \"Ensure Known Context is written only after strategy.md exists\"\n463:         condition: \"prior_context_found\"\n464:         edit: \"{state_paths.strategy}\"\n465:         note: \"Append or replace the Known Context section with prior_context_summary and retained detail from prior_context\"\n466: \n467:       step_enrich_strategy_resource_map:\n468:         action: \"Inject resource-map status into Known Context after strategy.md exists\"\n469:         edit: \"{state_paths.strategy}\"\n470:         note: \"When resource_map_present is true, append the resource_map_known_context snapshot. When false, append 'resource-map.md not present; skipping coverage gate'.\"\n471: \n472:       step_detect_spec_present:\n473:         action: \"Classify late-INIT spec.md state after the durable research packet exists\"\n474:         inspect:\n475:           - \"{spec_folder}/spec.md\"\n476:           - \"{state_paths.lock_file}\"\n477:         classify:\n478:           no-spec: \"spec.md is absent before any pre-init mutation\"\n479:           spec-present: \"spec.md exists and approved host anchors are available for bounded mutation\"\n480:           spec-just-created-by-this-run: \"spec.md already carries this run's DR seed markers and should not be reseeded\"\n481:           conflict-detected: \"missing host anchor, duplicate markers, or generated-block ambiguity makes mutation unsafe\"\n482:         outputs:\n483:           - folder_state: \"no-spec | spec-present | spec-just-created-by-this-run | conflict-detected\"\n484:           - normalized_topic: \"Trim, lowercase, and collapse whitespace in research_topic before dedupe checks\"\n485:         append_to_jsonl: '{\"type\":\"event\",\"event\":\"spec_check_result\",\"folder_state\":\"{folder_state}\",\"normalized_topic\":\"{normalized_topic}\",\"specPath\":\"{spec_folder}/spec.md\",\"lockPath\":\"{state_paths.lock_file}\",\"timestamp\":\"{ISO_8601_NOW}\"}'\n486: \n487:       step_preinit_spec_branch:\n488:         action: \"Run the bounded pre-init spec branch required by spec_check_protocol\"\n489:         protocol_reference: \".skilled/skills/system-deep-loop/deep-research/references/protocol/spec-check-protocol.md\"\n490:         branches:\n491:           no-spec:\n492:             create: \"{spec_folder}/spec.md\"\n493:             seed_markers:\n494:               - \"<!-- DR-SEED:REQUIREMENTS -->\"\n495:               - \"<!-- DR-SEED:SCOPE -->\"\n496:             requirements_host: \"Seed Requirements from the research ask without broadening scope\"\n497:             scope_host: \"Seed Scope from the research ask without inventing implementation details\"\n498:             set:\n499:               folder_state: \"spec-just-created-by-this-run\"\n500:               validate_spec_doc: true\n501:             append_to_jsonl: '{\"type\":\"spec_mutation\",\"event\":\"spec_seed_created\",\"folder_state\":\"spec-just-created-by-this-run\",\"anchors_touched\":[\"Requirements\",\"Scope\"],\"diff_summary\":\"Seeded Level 1 spec.md from research topic with DR seed markers.\",\"seed_markers\":[\"DR-SEED:REQUIREMENTS\",\"DR-SEED:SCOPE\"],\"timestamp\":\"{ISO_8601_NOW}\"}'\n502:           spec-present:\n503:             edit: \"{spec_folder}/spec.md\"\n504:             set:\n505:               validate_spec_doc: true\n506:             idempotency_check:\n507:               host_anchor: \"Open Questions\"\n508:               normalized_match: \"Normalize the existing anchor text by lowercasing, stripping punctuation, collapsing whitespace, and trimming before comparing with {normalized_topic}.\"\n509:               if_match:\n510:                 skip_append: true\n511:                 append_to_jsonl: '{\"type\":\"spec_mutation\",\"event\":\"spec_preinit_context_deduped\",\"folder_state\":\"spec-present\",\"anchors_touched\":[\"Open Questions\"],\"diff_summary\":\"Skipped duplicate pre-init topic append because normalized topic already exists in Open Questions.\",\"normalized_topic\":\"{normalized_topic}\",\"specPath\":\"{spec_folder}/spec.md\",\"timestamp\":\"{ISO_8601_NOW}\"}'\n512:               if_no_match:\n513:                 append_only:\n514:                   - host_anchor: \"Open Questions\"\n515:                     content: \"Add the normalized research topic only if it is not already present.\"\n516:                   - host_anchor: \"Research Context\"\n517:                     content: \"Add a bounded note that deep-research is active for this topic and that research/research.md remains canonical.\"\n518:                 append_to_jsonl: '{\"type\":\"spec_mutation\",\"event\":\"spec_preinit_context_added\",\"folder_state\":\"spec-present\",\"anchors_touched\":[\"Open Questions\",\"Research Context\"],\"diff_summary\":\"Appended bounded pre-init research context for the normalized topic.\",\"normalized_topic\":\"{normalized_topic}\",\"specPath\":\"{spec_folder}/spec.md\",\"timestamp\":\"{ISO_8601_NOW}\"}'\n519:           spec-just-created-by-this-run:\n520:             verify_markers:\n521:               - \"<!-- DR-SEED:REQUIREMENTS -->\"\n522:               - \"<!-- DR-SEED:SCOPE -->\"\n523:             set:\n524:               validate_spec_doc: false\n525:             note: \"Treat already-seeded spec.md as a no-op guard and continue.\"\n526:           conflict-detected:\n527:             append_to_jsonl: '{\"type\":\"spec_mutation\",\"event\":\"spec_mutation_conflict\",\"folder_state\":\"conflict-detected\",\"reason\":\"Pre-init spec.md mutation is ambiguous or unsafe.\",\"specPath\":\"{spec_folder}/spec.md\",\"timestamp\":\"{ISO_8601_NOW}\"}'\n528:             halt: true\n529: \n530:       step_validate_preinit_spec_doc:\n531:         action: \"Run targeted strict validation after any deep-research pre-init spec.md mutation\"\n532:         condition: \"validate_spec_doc\"\n533:         command: \"SPECKIT_RULES=FRONTMATTER_VALID,LEVEL_DECLARED,TEMPLATE_SOURCE,PLACEHOLDER_FILLED,ANCHORS_VALID,SPEC_DOC_INTEGRITY,TOC_POLICY bash .skilled/skills/system-spec-kit/runtime/cli/spec/validate.sh {spec_folder} --strict\"\n534:         note: \"This enforces the authored-spec markdown structural contract without applying full-packet required-file or completeness checks to workflow-owned research artifacts. It uses the Node validation orchestrator, whose strict path was measured at about 108ms for a fresh Level 3 packet on the local harness.\"\n535: \n536:       step_telemetry_heartbeat_started:\n537:         action: \"Emit a single-loop started row in the orchestration status ledger\"\n538:         skip_when: \"config.fanout is present\"\n539:         canonical_lifecycle_event: \"iteration_start\"\n540:         command: |\n541:           node --import \"$(node -p \"require.resolve('tsx', { paths: ['.skilled/skills/system-deep-loop/runtime'] })\")\" --input-type=module <<'EOF'\n542:           import { readFileSync } from 'node:fs';\n543: \n544:           import { appendJsonlIfChangedAtomic } from './.skilled/skills/system-deep-loop/runtime/lib/deep-loop/atomic-state.ts';\n545:           import observabilityEvents from './.skilled/skills/system-deep-loop/runtime/lib/deep-loop/observability-events.cjs';\n546: \n547:           const { appendObservabilityEvent } = observabilityEvents;\n548:           const config = JSON.parse(readFileSync('{state_paths.config}', 'utf8'));\n549:           const timestamp = '{ISO_8601_NOW}';\n550:           const sessionId = String(config.lineage?.sessionId ?? '{AUTO_SESSION_ID}');\n551:           const generation = Number(config.lineage?.generation ?? 1);\n552:           const observabilityPath = '{state_paths.packet_dir}/observability-events.jsonl';\n553:           const row = {\n554:             event: 'started',\n555:             label: 'single',\n556:             at: timestamp,\n557:             duration_ms: 0,\n558:             loop_type: 'research',\n559:             sessionId,\n560:             generation,\n561:             gauges: { iterations: 0, elapsed_ms: 0, score: 0 },\n562:           };\n563: \n564:           const appended = appendJsonlIfChangedAtomic('{state_paths.status_ledger}', row, {\n565:             diffData: { event: row.event, label: row.label, sessionId, generation, gauges: { iterations: 0, score: 0 } },\n566:             diffField: 'state_hash',\n567:           });\n568:           if (appended) {\n569:             try {\n570:               appendObservabilityEvent(observabilityPath, row, {\n571:                 producer: 'deep-research-auto',\n572:                 stream: 'single-loop-telemetry',\n573:                 subject: { label: row.label, sessionId, generation },\n574:                 event: row.event,\n575:                 status: 'running',\n576:               });\n577:             } catch {}\n578:           }\n579:           EOF\n580:         working_directory: \"{repo_root}\"\n581:         outputs:\n582:           - status_ledger_started: \"A fan-out-shaped status row with label single and event started\"\n583: \n584:       step_init_complete:\n585:         log: \"Initialization complete. Config, state, and strategy files created.\"\n586:         set: { current_iteration: 1, current_segment: 1, stuck_count: 0 }\n587: \n588:   # ═══════════════════════════════════════════════════════════════\n589:   # PHASE 2: ITERATION LOOP\n590:   # ═══════════════════════════════════════════════════════════════\n591:   phase_loop:\n592:     purpose: Dispatch agent iterations until convergence\n593:     repeat: true\n594:     max_repeats: \"{max_iterations}\"\n595:     steps:\n596: \n597:       step_refresh_lock:\n598:         action: \"Refresh the packet lock heartbeat before the iteration begins\"\n599:         command: \"node .skilled/skills/system-deep-loop/runtime/scripts/loop-lock.cjs refresh --lock-path {state_paths.lock_file} --owner-pid {captured_owner_pid} --nonce {captured_acquire_nonce}\"\n600:         on_refresh: \"If the refresh output has refreshed:false, fail closed: lost the packet lock. This run no longer holds the packet and must stop rather than iterate without it.\"\n601: \n602:       step_record_artifact_migration:\n603:         action: \"Record a legacy artifact alias read once per session, after the run is open\"\n604:         skip_when: \"legacy_migration_detected != true or migration_recorded == true\"\n605:         append_jsonl: '{\"type\":\"event\",\"event\":\"migration\",\"legacyPath\":\"{legacy_path}\",\"canonicalPath\":\"{canonical_path}\",\"timestamp\":\"{ISO_8601_NOW}\"}'\n606:         set: { migration_recorded: true }\n607: \n608:       step_read_state:\n609:         action: \"Read current state from JSONL and strategy\"\n610:         read:\n611:           - \"{state_paths.state_log}\"\n612:           - \"{state_paths.strategy}\"\n613:           - \"{state_paths.config}\"\n614:         extract:\n615:           - iteration_count: \"Count distinct run values (run, else iteration) across lines where type === 'iteration'; a redispatched run counts once\"\n616:           - highest_run: \"Highest run value (run, else iteration) across lines where type === 'iteration', else 0\"\n617:           - current_iteration: \"max(highest_run, iteration_count) + 1\"\n618:           - current_segment: \"Latest segment_start event segment, else 1\"\n619:           - last_newInfoRatio: \"Extract newInfoRatio from last iteration record\"\n620:           - last_focus: \"Extract focus from latest iteration record, else 'none yet'\"\n621:           - ratio_prev: \"Extract newInfoRatio from second-latest iteration record, else 'N/A'\"\n622:           - ratio_latest: \"Extract newInfoRatio from latest iteration record, else 'N/A'\"\n623:           - next_focus: \"Extract 'Next Focus' section from strategy.md\"\n624:           - remaining_questions: \"Count unchecked items in 'Key Questions'\"\n625:           - remaining_questions_list: \"List unchecked key questions from strategy.md\"\n626:           - carried_forward_open_questions: \"Extract 'Carried-Forward Open Questions' section from strategy.md, else '[None yet]'\"\n627:           - answered_count: \"Count answered questions from strategy.md\"\n628:           - total_questions: \"Count total questions tracked in strategy.md\"\n629:           - resource_map_present: \"Extract boolean from deep-research-config.json, default false\"\n630:           - resource_map_prompt_line: \"If resource_map_present is true, return 'Resource map: prior-inventoried files are listed in {spec_folder}/resource-map.md; treat them as the exclusion set when hunting for net-new files; flag only missed-from-map candidates as gaps.' Else return 'Resource map: resource-map.md not present; skipping coverage gate.'\"\n631:           - lineage_context_prompt_line: \"If a refreshed lineage context summary exists from the previous iteration, return 'Lineage context refresh: {summary}'. Else use prior_context_summary from startup when available; otherwise return 'Lineage context refresh: none loaded yet.'\"\n632:           - least_explored: \"First unanswered question not covered by the most recent iteration focus, else first unanswered question\"\n633:           - last_3_summaries: \"Summarize the latest 3 iteration records as 'run N: focus (ratio)'\"\n634:           - latest_status: \"Extract status from latest iteration record, else 'none yet'\"\n635:           - nextRunAt: \"Extract nullable nextRunAt from deep-research-config.json, default null\"\n636:           - remainingDelayMs: \"Extract nullable remainingDelayMs from deep-research-config.json, default null\"\n637:           - min_iterations_present: \"Boolean true when deep-research-config.json has a numeric minIterations field\"\n638:           - min_iterations_missing_warning: \"Boolean true when minIterations is missing; use no floor and log a warning so older configs keep prior stop behavior\"\n639:           - min_iterations_raw: \"Extract numeric minIterations from deep-research-config.json when present, default 0\"\n640:           - effective_min_iterations: \"Clamp min_iterations_raw to the inclusive range 0..max_iterations; if min_iterations_raw exceeds max_iterations, use max_iterations\"\n641:           - min_iterations_clamped: \"Boolean true when min_iterations_raw > max_iterations\"\n642:           - min_iterations_guard_already_passed: \"Boolean true when the floor had already cleared before this iteration: iteration_count - 1 >= effective_min_iterations\"\n643:           - convergence_mode: \"Extract antiConvergence.convergenceMode when it is one of 'default', 'off', 'sliding-window', or 'divergent'; default to 'default'\"\n644:           - stop_policy: \"Extract stopPolicy from deep-research-config.json, default 'convergence'. Valid values: convergence, max-iterations.\"\n645:           - convergence_mode_warning: \"Boolean true when antiConvergence.convergenceMode is present with an unsupported value; use 'default'\"\n646:           - rejected_patterns_count: \"Read registry.rejectedPatterns length when registry exists, else 0\"\n647:           - rejected_candidate_matches: \"Read registry.suppressedCandidates when registry exists, else []\"\n648:           - rejected_pattern_fuzzy_threshold: \"Read config.rejectedPatternFuzzyThreshold when present, else 0.85\"\n649:           - min_idea_observations: \"Read config.minIdeaObservations when present, default 2; clamp to 1..10\"\n650:           - observed_ideas_count: \"Read registry.observedIdeas length when registry exists, else 0\"\n651:           - promoted_ideas_count: \"Read registry.promotedIdeas length when registry exists, else 0\"\n652:           - promoted_ideas_list: \"Read registry.promotedIdeas idea text in rank order when registry exists, else []\"\n653:           - suppressed_ideas_count: \"Read registry.suppressedIdeas length when registry exists, else 0\"\n654:           - pivot_lineage: \"Summarize registry.divergence.completed and registry.divergence.overrides with pivot ids, source iterations, and selected focus; else 'none yet'\"\n655:           - saturated_directions: \"List registry.divergence.saturatedDirections; else 'none yet'\"\n656: \n657:       step_run_now_check:\n658:         action: \"Detect and consume a one-shot run-now sentinel before pause/convergence/dispatch\"\n659:         command: |\n660:           GATEWAY=\".skilled/skills/system-deep-loop/runtime/scripts/append-mode-event.cjs\"\n661:           [ -f \"$GATEWAY\" ] || GATEWAY=\"scripts/append-mode-event.cjs\"\n662:           EVENT_DIR=\"$(mktemp -d \"${TMPDIR:-/tmp}/deep-research-run-now.XXXXXX\")\"\n663:           node - \"$EVENT_DIR\" <<'EOF'\n664:           const { existsSync, renameSync, unlinkSync, writeFileSync } = require('node:fs');\n665:           const { join } = require('node:path');\n666: \n667:           const eventDir = process.argv[2];\n668:           const sentinelPath = \"{state_paths.run_now_sentinel}\";\n669:           const pausePath = \"{state_paths.pause_sentinel}\";\n670:           const sessionId = \"{config.lineage.sessionId}\";\n671:           const generation = Number(\"{config.lineage.generation}\");\n672:           const run = Number(\"{current_iteration}\");\n673: \n674:           // The state log is a projection the gateway rebuilds from the ledger, so a\n675:           // run-now row is staged as a canonical ledger event and appended by the\n676:           // gateway; a write beside the projection is dropped by the next refresh.\n677:           // The loop boundary has no lineage identity yet, so the session names both\n678:           // scope halves rather than inventing a second identifier.\n679:           const scope = { runId: sessionId, lineageId: sessionId };\n680: \n681:           let sequence = 0;\n682: \n683:           function record(event, fields) {\n684:             sequence += 1;\n685:             writeFileSync(\n686:               join(eventDir, `${String(sequence).padStart(2, \"0\")}-${event}.json`),\n687:               JSON.stringify({\n688:                 stem: `deep_research.${event}`,\n689:                 scope,\n690:                 data: { mode: \"research\", run, sessionId, generation, ...fields },\n691:               }),\n692:               \"utf8\",\n693:             );\n694:           }\n695: \n696:           if (existsSync(sentinelPath)) {\n697:             record(\"run_now_requested\", { sentinelPath });\n698:             if (existsSync(pausePath)) {\n699:               record(\"run_now_rejected\", {\n700:                 sentinelPath,\n701:                 reason: \"loop_paused\",\n702:                 pauseSentinelPath: pausePath,\n703:               });\n704:             } else {\n705:               const claimPath = `${sentinelPath}.consuming.${process.pid}.${Date.now()}`;\n706:               try {\n707:                 renameSync(sentinelPath, claimPath);\n708:                 unlinkSync(claimPath);\n709:                 record(\"run_now_accepted\", {\n710:                   sentinelPath,\n711:                   dispatchEvent: \"iteration_start\",\n712:                 });\n713:               } catch (error) {\n714:                 if (!error || error.code !== \"ENOENT\") {\n715:                   throw error;\n716:                 }\n717:               }\n718:             }\n719:           }\n720:           EOF\n721:           for eventFile in \"$EVENT_DIR\"/*.json; do\n722:             [ -e \"$eventFile\" ] || continue\n723:             node \"$GATEWAY\" --mode research --run-directory \"$(dirname \"{state_paths.state_log}\")\" --event-json \"$eventFile\"\n724:             GATEWAY_STATUS=$?\n725:             if [ \"$GATEWAY_STATUS\" -ne 0 ]; then\n726:               rm -rf \"$EVENT_DIR\"\n727:               exit \"$GATEWAY_STATUS\"\n728:             fi\n729:           done\n730:           rm -rf \"$EVENT_DIR\"\n731:         outputs:\n732:           - run_now_requested: \"Emitted when {state_paths.run_now_sentinel} exists at the loop boundary\"\n733:           - run_now_accepted: \"Emitted after the sentinel is atomically renamed and deleted before dispatch\"\n734:           - run_now_rejected: \"Emitted with reason loop_paused when pause takes precedence; sentinel remains present\"\n735: \n736:       step_check_pause_sentinel:\n737:         action: \"Check for pause sentinel file\"\n738:         check: \"Does {state_paths.pause_sentinel} exist?\"\n739:         if_exists:\n740:           append_jsonl: '{\"type\":\"event\",\"event\":\"userPaused\",\"mode\":\"research\",\"run\":{current_iteration},\"stopReason\":\"userPaused\",\"sentinelPath\":\"{state_paths.pause_sentinel}\",\"timestamp\":\"{ISO_8601_NOW}\",\"sessionId\":\"{config.lineage.sessionId}\",\"generation\":{config.lineage.generation}}'\n741:           message: \"Research paused. Delete research/.deep-research-pause to resume.\"\n742:           halt: true\n743:         if_not_exists:\n744:           proceed: true\n745: \n746:       step_validate_convergence_config:\n747:         action: \"Validate convergence floor settings when loading config\"\n748:         if_min_iterations_missing:\n749:           bookkeeping_log: '{\"type\":\"event\",\"event\":\"config_warning\",\"mode\":\"research\",\"field\":\"minIterations\",\"fallback\":0,\"message\":\"minIterations missing; using no convergence floor for backward compatibility.\",\"timestamp\":\"{ISO_8601_NOW}\",\"sessionId\":\"{config.lineage.sessionId}\",\"generation\":{config.lineage.generation}}'\n[Output truncated. Continue reading with offset: 750]"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\".skilled/commands/deep/assets/deep-research-auto.yaml\"}"},"time":{"start":1794523723237,"end":1794523723536}}}}
