{"type":"tool_use","timestamp":1794523976562,"sessionID":"ses_e2e0e4b2cffeAWQl6ZGxUDL6xW","part":{"partID":"prt_1d1f6d217001R7GQCr6ZhJOV0i","sessionID":"ses_e2e0e4b2cffeAWQl6ZGxUDL6xW","messageID":"msg_1d1f6b7d5001ffDt9k2nSR8tW9","type":"tool","id":"call_2395c60cfa1e4a6092ab1aa5","tool":"read","state":{"status":"completed","input":{"path":"specs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/005-recommendation-contract-and-brief/scratch/brief-heads.mjs"},"output":"Read file specs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/005-recommendation-contract-and-brief/scratch/brief-heads.mjs, lines 1-118\n1: #!/usr/bin/env node\n2: // ───────────────────────────────────────────────────────────────────\n3: // MODULE: Advisor brief head probe\n4: // ───────────────────────────────────────────────────────────────────\n5: // Pipes a fixed set of prompts through the real UserPromptSubmit hook and\n6: // prints the first line of each rendered context, so the model-visible head\n7: // can be compared before and after a renderer change without reading any\n8: // corpus file.\n9: // ───────────────────────────────────────────────────────────────────\n10: \n11: import { existsSync } from 'node:fs';\n12: import { spawnSync } from 'node:child_process';\n13: import { dirname, join, resolve } from 'node:path';\n14: import { fileURLToPath } from 'node:url';\n15: \n16: // ───────────────────────────────────────────────────────────────────\n17: // 1. CONSTANTS\n18: // ───────────────────────────────────────────────────────────────────\n19: \n20: const HOOK_REL = '.skilled/skills/system-spec-kit/runtime/dist/hooks/claude/user-prompt-submit.js';\n21: const HOOK_TIMEOUT_MS = 30_000;\n22: const MAX_ROOT_WALK_DEPTH = 14;\n23: \n24: // One prompt per brief family plus one prompt outside the measured block.\n25: // Every entry is public probe text, never a corpus row.\n26: const PROMPTS = [\n27:   '/speckit:plan add a login page',\n28:   'save context for this packet before I stop for the day',\n29:   'please improve this prompt so the worker follows it better',\n30:   'create a readme for the utils folder',\n31:   'turn off the comment hygiene git hook',\n32:   'research caching strategies in depth over several iterations',\n33: ];\n34: \n35: // ───────────────────────────────────────────────────────────────────\n36: // 2. PATH RESOLUTION\n37: // ───────────────────────────────────────────────────────────────────\n38: \n39: // Anchor every path to this module's own location. The probe is launched from\n40: // arbitrary working directories by orchestrators, so a CWD-relative path would\n41: // find the wrong checkout or nothing at all.\n42: const scriptDir = dirname(fileURLToPath(import.meta.url));\n43: \n44: function findRepoRoot() {\n45:   let current = scriptDir;\n46:   for (let depth = 0; depth < MAX_ROOT_WALK_DEPTH; depth += 1) {\n47:     if (existsSync(join(current, HOOK_REL))) {\n48:       return current;\n49:     }\n50:     const parent = dirname(current);\n51:     if (parent === current) {\n52:       break;\n53:     }\n54:     current = parent;\n55:   }\n56:   return null;\n57: }\n58: \n59: function fail(message) {\n60:   process.stderr.write(`${message}\\n`);\n61:   process.exit(2);\n62: }\n63: \n64: const repoRoot = findRepoRoot();\n65: if (!repoRoot) {\n66:   fail(`hook file not found: walked up from ${scriptDir} for ${HOOK_REL}`);\n67: }\n68: const hookPath = resolve(repoRoot, HOOK_REL);\n69: if (!existsSync(hookPath)) {\n70:   fail(`hook file missing: ${hookPath}`);\n71: }\n72: \n73: // ───────────────────────────────────────────────────────────────────\n74: // 3. PROBE\n75: // ───────────────────────────────────────────────────────────────────\n76: \n77: // The hook reads one JSON object off stdin and ignores argv. Field names mirror\n78: // what the hook source actually reads: prompt, cwd, hook_event_name, session_id.\n79: // Each prompt gets its own session so directive dedup cannot shorten a later\n80: // line in the same run.\n81: function buildStdin(prompt, sessionId) {\n82:   return JSON.stringify({\n83:     prompt,\n84:     cwd: repoRoot,\n85:     hook_event_name: 'UserPromptSubmit',\n86:     session_id: sessionId,\n87:   });\n88: }\n89: \n90: for (const [index, prompt] of PROMPTS.entries()) {\n91:   const result = spawnSync(process.execPath, [hookPath], {\n92:     cwd: repoRoot,\n93:     input: buildStdin(prompt, `brief-heads-probe-${index + 1}`),\n94:     encoding: 'utf8',\n95:     timeout: HOOK_TIMEOUT_MS,\n96:     killSignal: 'SIGKILL',\n97:   });\n98:   if (result.status !== 0) {\n99:     fail(`hook exited ${result.status} for probe ${index + 1}`);\n100:   }\n101:   const stdout = typeof result.stdout === 'string' ? result.stdout.trim() : '';\n102:   if (!stdout) {\n103:     fail(`hook printed no JSON for probe ${index + 1}`);\n104:   }\n105:   let payload;\n106:   try {\n107:     payload = JSON.parse(stdout);\n108:   } catch {\n109:     fail(`hook printed invalid JSON for probe ${index + 1}`);\n110:   }\n111:   const context = payload?.hookSpecificOutput?.additionalContext;\n112:   if (typeof context !== 'string' || context.trim().length === 0) {\n113:     fail(`hook printed no advisor context for probe ${index + 1}`);\n114:   }\n115:   // Only the head is compared, so a directive block that follows it stays out\n116:   // of the one-line-per-prompt output.\n117:   process.stdout.write(`${context.split('\\n', 1)[0].trim()}\\n`);\n118: }","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file specs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/005-recommendation-contract-and-brief/scratch/brief-heads.mjs, lines 1-118\n1: #!/usr/bin/env node\n2: // ───────────────────────────────────────────────────────────────────\n3: // MODULE: Advisor brief head probe\n4: // ───────────────────────────────────────────────────────────────────\n5: // Pipes a fixed set of prompts through the real UserPromptSubmit hook and\n6: // prints the first line of each rendered context, so the model-visible head\n7: // can be compared before and after a renderer change without reading any\n8: // corpus file.\n9: // ───────────────────────────────────────────────────────────────────\n10: \n11: import { existsSync } from 'node:fs';\n12: import { spawnSync } from 'node:child_process';\n13: import { dirname, join, resolve } from 'node:path';\n14: import { fileURLToPath } from 'node:url';\n15: \n16: // ───────────────────────────────────────────────────────────────────\n17: // 1. CONSTANTS\n18: // ───────────────────────────────────────────────────────────────────\n19: \n20: const HOOK_REL = '.skilled/skills/system-spec-kit/runtime/dist/hooks/claude/user-prompt-submit.js';\n21: const HOOK_TIMEOUT_MS = 30_000;\n22: const MAX_ROOT_WALK_DEPTH = 14;\n23: \n24: // One prompt per brief family plus one prompt outside the measured block.\n25: // Every entry is public probe text, never a corpus row.\n26: const PROMPTS = [\n27:   '/speckit:plan add a login page',\n28:   'save context for this packet before I stop for the day',\n29:   'please improve this prompt so the worker follows it better',\n30:   'create a readme for the utils folder',\n31:   'turn off the comment hygiene git hook',\n32:   'research caching strategies in depth over several iterations',\n33: ];\n34: \n35: // ───────────────────────────────────────────────────────────────────\n36: // 2. PATH RESOLUTION\n37: // ───────────────────────────────────────────────────────────────────\n38: \n39: // Anchor every path to this module's own location. The probe is launched from\n40: // arbitrary working directories by orchestrators, so a CWD-relative path would\n41: // find the wrong checkout or nothing at all.\n42: const scriptDir = dirname(fileURLToPath(import.meta.url));\n43: \n44: function findRepoRoot() {\n45:   let current = scriptDir;\n46:   for (let depth = 0; depth < MAX_ROOT_WALK_DEPTH; depth += 1) {\n47:     if (existsSync(join(current, HOOK_REL))) {\n48:       return current;\n49:     }\n50:     const parent = dirname(current);\n51:     if (parent === current) {\n52:       break;\n53:     }\n54:     current = parent;\n55:   }\n56:   return null;\n57: }\n58: \n59: function fail(message) {\n60:   process.stderr.write(`${message}\\n`);\n61:   process.exit(2);\n62: }\n63: \n64: const repoRoot = findRepoRoot();\n65: if (!repoRoot) {\n66:   fail(`hook file not found: walked up from ${scriptDir} for ${HOOK_REL}`);\n67: }\n68: const hookPath = resolve(repoRoot, HOOK_REL);\n69: if (!existsSync(hookPath)) {\n70:   fail(`hook file missing: ${hookPath}`);\n71: }\n72: \n73: // ───────────────────────────────────────────────────────────────────\n74: // 3. PROBE\n75: // ───────────────────────────────────────────────────────────────────\n76: \n77: // The hook reads one JSON object off stdin and ignores argv. Field names mirror\n78: // what the hook source actually reads: prompt, cwd, hook_event_name, session_id.\n79: // Each prompt gets its own session so directive dedup cannot shorten a later\n80: // line in the same run.\n81: function buildStdin(prompt, sessionId) {\n82:   return JSON.stringify({\n83:     prompt,\n84:     cwd: repoRoot,\n85:     hook_event_name: 'UserPromptSubmit',\n86:     session_id: sessionId,\n87:   });\n88: }\n89: \n90: for (const [index, prompt] of PROMPTS.entries()) {\n91:   const result = spawnSync(process.execPath, [hookPath], {\n92:     cwd: repoRoot,\n93:     input: buildStdin(prompt, `brief-heads-probe-${index + 1}`),\n94:     encoding: 'utf8',\n95:     timeout: HOOK_TIMEOUT_MS,\n96:     killSignal: 'SIGKILL',\n97:   });\n98:   if (result.status !== 0) {\n99:     fail(`hook exited ${result.status} for probe ${index + 1}`);\n100:   }\n101:   const stdout = typeof result.stdout === 'string' ? result.stdout.trim() : '';\n102:   if (!stdout) {\n103:     fail(`hook printed no JSON for probe ${index + 1}`);\n104:   }\n105:   let payload;\n106:   try {\n107:     payload = JSON.parse(stdout);\n108:   } catch {\n109:     fail(`hook printed invalid JSON for probe ${index + 1}`);\n110:   }\n111:   const context = payload?.hookSpecificOutput?.additionalContext;\n112:   if (typeof context !== 'string' || context.trim().length === 0) {\n113:     fail(`hook printed no advisor context for probe ${index + 1}`);\n114:   }\n115:   // Only the head is compared, so a directive block that follows it stays out\n116:   // of the one-line-per-prompt output.\n117:   process.stdout.write(`${context.split('\\n', 1)[0].trim()}\\n`);\n118: }"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\"specs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/005-recommendation-contract-and-brief/scratch/brief-heads.mjs\"}"},"time":{"start":1794523976215,"end":1794523976562}}}}
