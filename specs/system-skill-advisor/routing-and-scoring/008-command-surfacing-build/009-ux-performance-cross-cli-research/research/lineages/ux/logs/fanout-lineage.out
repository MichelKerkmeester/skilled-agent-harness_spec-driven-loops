tional failure-mode tag for query-scored recall (\"how this skill tends\n120:   // to fail on inputs like yours\"). Advisory only — never a hard demotion.\n121:   readonly failureMode?: string;\n122:   // Optional bounded, caller-sanitized context tags scored against a query for\n123:   // failure-mode recall. The store never captures the raw prompt.\n124:   readonly contextTags?: readonly string[];\n125: }\n126: \n127: // ───────────────────────────────────────────────────────────────\n128: // 2. CONSTANTS\n129: // ───────────────────────────────────────────────────────────────\n[Output truncated. Continue reading with offset: 130]"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"limit\":90,\"offset\":40,\"path\":\".skilled/skills/system-skill-advisor/runtime/lib/metrics.ts\"}"},"time":{"start":1794523967128,"end":1794523967599}}}}
