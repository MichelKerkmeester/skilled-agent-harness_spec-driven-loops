uteResearchClaimVerificationRateFromData(nodes);\n810-  const contradictionDensity = computeResearchContradictionDensityFromData(edges);\n811-  const sourceDiversity = computeResearchSourceDiversityFromData(nodes, edges);\n812-  const evidenceDepth = computeResearchEvidenceDepthFromData(nodes, edges);\n813-\n814-  return {\n815-    questionCoverage,\n816-    claimVerificationRate,\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"607:export function computeResearchClaimVerificationRateFromData(\n608-  nodes: ReadonlyArray<ResearchSignalNodeLike>,\n609-): number {\n610-  const claims = nodes.filter(node => node.kind === 'CLAIM');\n611-  if (claims.length === 0) return 1.0;\n612-\n613-  let verifiedClaims = 0;\n614-  for (const claim of claims) {\n615-    const meta = parseNodeMetadata(claim.metadata);\n616-    if (meta?.verification_status && meta.verification_status !== 'unresolved') {\n617-      verifiedClaims++;\n618-    }\n619-  }\n620-\n621-  return verifiedClaims / claims.length;\n622-}\n623-\n624-/**\n625- * Canonical research contradiction density: CONTRADICTS edges divided by all\n626- * research edges in the graph.\n627- *\n628- * @param edges - Research edges in the graph.\n629- * @returns Contradiction density in [0, 1].\n630- */\n631-export function computeResearchContradictionDensityFromData(\n632-  edges: ReadonlyArray<ResearchSignalEdgeLike>,\n633-): number {\n634-  if (edges.length === 0) return 0;\n635-  let contradictionCount = 0;\n636-\n637-  for (const edge of edges) {\n638-    if (edge.relation === 'CONTRADICTS') contradictionCount++;\n639-  }\n640-\n641-  return contradictionCount / edges.length;\n642-}\n643-\n644-/**\n645- * Canonical research source diversity: for each question, count distinct\n646- * source metadata quality classes reachable through ANSWERS -> CITES paths,\n647- * then average that count across all questions.\n--\n809:  const claimVerificationRate = computeResearchClaimVerificationRateFromData(nodes);\n810-  const contradictionDensity = computeResearchContradictionDensityFromData(edges);\n811-  const sourceDiversity = computeResearchSourceDiversityFromData(nodes, edges);\n812-  const evidenceDepth = computeResearchEvidenceDepthFromData(nodes, edges);\n813-\n814-  return {\n815-    questionCoverage,\n816-    claimVerificationRate,\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"grep -n \\\"computeResearchClaimVerification\\\" -A 40 .skilled/skills/system-deep-loop/runtime/lib/coverage-graph/coverage-graph-signals.ts | head -50\"}"},"time":{"start":1794802705825,"end":1794802706299}}}}
