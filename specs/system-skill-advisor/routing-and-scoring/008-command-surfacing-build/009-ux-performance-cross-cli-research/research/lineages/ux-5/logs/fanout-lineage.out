 \"token\": \"cross\"\n    },\n    {\n      \"reason\": \"beyond-max-query-tokens\",\n      \"token\": \"cli\"\n    },\n    {\n      \"reason\": \"beyond-max-query-tokens\",\n      \"token\": \"delivery\"\n    },\n    {\n      \"reason\": \"beyond-max-query-tokens\",\n      \"token\": \"decline\"\n    },\n    {\n      \"reason\": \"beyond-max-query-tokens\",\n      \"token\": \"refusal\"\n    }\n  ],\n  \"indexHash\": \"75c7a3d07bfe49f36c21536a9574b8d7845cf8a04606471b31f22e011a3e26b7\",\n  \"manifestHash\": \"61fda407407ffb25d6f8a80a7ce1cc7eb5f1578b4ecb467468c313ff8c5d61f5\",\n  \"normalizedQuery\": \"command surfacing offer ask start ux brief hook latency cross cli delivery decline refusal\",\n  \"results\": [],\n  \"schemaVersion\": 2,\n  \"specFolder\": null,\n  \"tokens\": [\n    \"command\",\n    \"surfacing\",\n    \"offer\",\n    \"ask\",\n    \"start\",\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"node .skilled/skills/system-spec-kit/runtime/cli/retrieval/lookup-trigger-index.mjs --json --scoring-only -- \\\"command surfacing offer ask start UX brief hook latency cross-cli delivery decline refusal\\\" 2>&1 | head -40\"}"},"time":{"start":1794801475308,"end":1794801476186}}}}
