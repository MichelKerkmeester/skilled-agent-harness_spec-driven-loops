run.\n548:   const topLabel = commandLabel(top, childSession)\n549:     ?? (isDoctorBridgeId(top.skill)\n550:       ? doctorCommandString(top.skill)\n551:       : sanitizeSkillLabel(metadataSkillLabel(result) ?? (top.needsMode === true ? commandRowFor(top.skill)?.ownerSkillId : undefined) ?? top.skill));\n552:   if (!topLabel) {\n553:     observeAdvisorPolicy(null, options);\n554:     return null;\n555:   }\n556: \n557:   // A hub that withheld its command because the prompt names no single mode says\n558:   // so, so the reader asks for the mode instead of improvising one.\n559:   const headLabel = top.needsMode === true && top.command === undefined\n560:     ? `${topLabel} (needs a mode)`\n561:     : topLabel;\n562: \n563:   // A command printed twice reads as two offers, so the companion line never\n564:   // repeats the command the head already names.\n565:   const headPrintedCommand = top.command\n566:     ?? (top.needsMode === true ? undefined : commandRowFor(top.skill)?.command);\n567:   const companion = isDoctorBridgeId(top.skill)\n568:     ? undefined\n569:     : recommendations.slice(1).find((recommendation) => {\n570:       const command = doctorCommandString(recommendation.skill);\n571:       return command !== null && command !== headPrintedCommand;\n572:     });\n573:   const companionLabel = companion ? companionCommandLabel(companion.skill, childSession) : null;\n574:   const companionCommand = companion ? doctorCommandString(companion.skill) : null;\n575:   // The partner's command shares the printed line with the head, so a companion\n576:   // that repeats it would offer that command a second time.\n577:   const companionLine = (shownSecond: string | undefined, shownCommand?: string): string => (\n578:     companionLabel\n579:     && companion\n580:     && companion.skill !== shownSecond\n581:     && (shownCommand === undefined || companionCommand !== shownCommand)\n582:       ? `\\nAlso: ${companionLabel}`\n583:       : ''\n584:   );\n585:   con