 command: \"node .skilled/skills/system-deep-loop/runtime/scripts/verify-iteration.cjs --loop-type research --artifact-dir {artifact_dir} --iteration {current_iteration}\"\n1514:           command_note: \"Mechanical leaf-reliability gate: exit 0 = complete; non-zero prints one machine reason (dispatch_failed|iteration_file_missing|state_record_missing|route_proof_missing|route_proof_mismatch|delta_file_missing|executor_missing). dispatch_failed means the narrative is missing and the completion receipt shows a non-zero exit or a signal. executor_missing means the config names a non-native executor and neither the iteration record nor its iteration_start row names one. In a fan-out lineage it means the lineage's invocation-metadata.json does not name that executor. The script enforces the artifact + route-proof + executor contract instead of trusting the leaf to self-report, and a non-zero exit triggers on_failure.redispatch_once.\"\n1515:           assert_exists: \"{state_paths.iteration_pattern}\"\n1516:           assert_appended: \"{state_paths.state_log}\"\n1517:           assert_jsonl_fields: [type, iteration, newInfoRatio, status, focus, mode]\n1518:           route_proof:\n1519:             mode: research\n1520:             target_agent: deep-research\n1521:             agent_definition_loaded: true\n1522:             resolved_route: \"Resolved route: mode=research target_agent=deep-research\"\n1523:           dispatchReceipt:\n1524:             receiptDir: \"{state_paths.packet_dir}/dispatch-receipts\"\n1525:             dispatchId: \"research-i{current_iteration}-g{config.lineage.generation}\"\n1526:           sessionId: \"{config.lineage.sessionId}\"\n1527:           optional_jsonl_fields:\n1528:             logOffset: \"Byte offset where the seekable log region starts\"\n1529:             logSize: \"Byte length of the seekable log region\"\n1530:             logPath: \"Absolute path to the file containing the seekable log region\"\n1531:             skippedCount: \"Missed fixed-rate slots counted for the completed dispatch; 0 when no slot was missed\"\n1532:             slotDurationMs: \"Monotonic elapsed duration for the completed dispatch slot\"\n1533:           assert_canonical_type: \"iteration\"\n1534:           assert_delta_file_exists: \"{state_paths.delta_pattern}\"\n1535:           assert_delta_file_has_iteration_record: true\n1536:           on_failure:\n1537:             action: \"record the schema_mismatch row as pinned bookkeeping; the research ledger has no stem for it, so the gateway would refuse it\"\n1538:             bookkeeping_log: '{\"type\":\"event\",\"event\":\"schema_mismatch\",\"mode\":\"research\",\"run\":{current_iteration},\"reason\":\"{failure_reason}\",\"timestamp\":\"{ISO_8601_NOW}\",\"sessionId\":\"{config.lineage.sessionId}\",\"generation\":{config.lineage.generation}}'\n1539:             redispatch_once: \"On the FIRST failure of the mechanical command check for this iteration, re-run step_dispatch_iteration exactly once for the same iteration number, then re-run the check. If it still fails, record the iteration as error and continue. Never re-dispatch a given iteration more than once.\"\n1540:           failure_reasons_reference:\n1541:             - \"iteration_file_missing — iteration narrative markdown not written\"\n1542:             - \"iteration_file_empty — iteration narrative markdown is zero bytes\"\n1543:             - \"jsonl_not_appended — state log file did not grow since pre-dispatch snapshot\"\n1544:             - \"jsonl_missing_fields — last state-log record omits required schema fields\"\n1545:             - \"jsonl_parse_error — last state-log line is not valid JSON\"\n1546:             - \"jsonl_wrong_type — last state-log record uses type!='iteration' (e.g. 'iteration_delta'); reducer will silently drop\"\n1547:             - \"delta_file_missing — per-iteration deltas/iter-NNN.jsonl not written\"\n1548:             - \"delta_file_empty — per-iteration delta file exists but has zero bytes\"\n1549:             - \"delta_file_missing_iteration_record — delta file lacks any record with type='iteration'\"\n1550:             - \"route_proof_missing — state-log or delta iteration record omits route-proof fields\"\n1551:             - \"route_proof_mismatch — state-log or delta iteration record does not match the resolved deep route\"\n1552:             - \"executor_missing — non-native executor did not record provenance\"\n1553:             - \"dispatch_failure_logged — last record is an explicit dispatch_failure event\"\n1554: \n1555:       step_run_now_restore_check:\n1556:         action: \"Record a run-now sentinel recreated during the completed dispatch\"\n1557:         command: |\n1558:           node .skilled/skills/system-deep-loop/runtime/scripts/run-now-sentinel.cjs restore --sentinel \"{state_paths.run_now_sentinel}\" --state-log \"{state_paths.state_log}\" --session-id \"{config.lineage.sessionId}\" --generation \"{config.lineage.generation}\" --run \"{current_iteration}\"\n1559:         outputs:\n1560:           - run_now_restored: \"Emitted when an operator recreates the sentinel before the accepted dispatch completes\"\n1561: \n1562:       step_check_executor_unavailable:\n1563:         action: \"Stop when the current iteration dispatch records an unavailable executor\"\n1564:         read:\n1565:           - \"{state_paths.state_log}\"\n1566:         extract:\n1567:           - unavailable_record: \"Latest line with type == 'event', event == 'dispatch_failure', iteration == current_iteration, and executorUnavailable == true; else none\"\n1568:         branch_on: \"unavailable_record\"\n1569:         if_present:\n1570:           set: { reason: \"error\", stopReason: \"error\" }\n1571:           message: \"The {unavailable_record.executor.kind} executor is unavailable ({unavailable_record.matchedMarker}). Switch executor or wait, then resume this run.\"\n1572:           halt: true\n1573:           release_lock: step_release_lock\n1574:         if_absent:\n1575:           action: \"Continue to state reduction\"\n1576: \n1577:       step_reduce_state:\n1578:         action: \"Run the reducer to synchronize registry, dashboard, and strategy\"\n1579:         dry_run_boundary: \"reducer-refresh\"\n1580:         command: \"node .skilled/skills/system-deep-loop/deep-research/scripts/reduce-state.cjs {spec_folder} {reducer_artifact_arg}\"\n1581:         inputs:\n1582:           latestJSONLDelta: \"Latest JSONL records written since the previous iteration\"\n1583:           newIterationFile: \"{state_paths.iteration_pattern}\"\n1584:           priorReducedState: \"{state_paths.registry}\"\n1585:         outputs:\n1586:           - \"{state_paths.registry}\"\n1587:           - \"{state_paths.dashboard}\"\n1588:           - \"{state_paths.strategy}\"\n1589:           - \"{state_paths.state_log} question_conflict events when inbox text disagrees with registry-owned question text\"\n1590:           - \"{state_paths.state_log} idempotent idea_promoted events when observed ideas reach minIdeaObservations\"\n1591:           - \"{state_paths.registry} observedIdeas, promotedIdeas, suppressedIdeas, rejectedPatterns, and suppressedCandidates from idea lifecycle events\"\n1592:         failure_modes:\n1593:           malformed_delta: \"skip + warn\"\n1594:           missing_iteration_file: \"no-op + error\"\n1595:           schema_mismatch: \"reject + conflict event\"\n1596:           question_conflict: \"keep registry value + append question_conflict event with inboxValue, registryValue, and operatorDecision\"\n1597:         guarantee: \"Idempotent for identical inputs\"\n1598: \n1599:       step_graph_upsert:\n1600:         action: \"Persist the latest iteration graph delta after the reducer refresh and after the iteration file exists\"\n1601:         dry_run_boundary: \"state-mutation\"\n1602:         note: \"Skips with an informational line and exit 0 when this iteration carries no graph events.\"\n1603:         command: |\n1604:           node .skilled/skills/system-deep-loop/runtime/scripts/iteration-graph-upsert.cjs --delta-dir \"{state_paths.delta_dir}\" --state-log \"{state_paths.state_log}\" --iteration \"{current_iteration}\" --spec-folder \"{spec_folder}\" --session-id \"{config.lineage.sessionId}\"\n1605: \n1606:       step_refresh_lineage_context:\n1607:         action: \"Refresh the focused context line from lineage-local state before the next prompt render\"\n1608:         read:\n1609:           - \"{state_paths.dashboard}\"\n[Output truncated. Continue reading with offset: 1610]"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"limit\":190,\"offset\":1420,\"path\":\".skilled/commands/deep/assets/deep-research.yaml\"}"},"time":{"start":1794801375522,"end":1794801375910}}}}
