ompleted","truncated":false,"exit":0},"content":[{"type":"text","text":"2140:function newPolicyTally() {\n2181:    byPolicy: Object.fromEntries(POLICY_KEYS.map((key) => [key, newPolicyTally()])),\n2297:    byPolicy: Object.fromEntries(\n2298:      POLICY_KEYS.map((key) => [key, { ...tally.byPolicy[key] }]),\n2399:  const policy = tally.byPolicy[result.policy];\n2605:        const policy = block.byPolicy[name];\n===\n    if (!event) return false;\n    if (event.kind === 'skill') return true;\n    if (event.kind === 'shell') return !GATE_SHELL.test(event.command ?? '');\n    if (event.kind === 'read') {\n      const path = typeof event.path === 'string' ? event.path.replace(/\\\\/g, '/') : '';\n      return !GATE_DOCUMENT.test(path);\n    }\n    return false;\n  });\n}\n\n// ───────────────────────────────────────────────────────────────────\n// 13. SUMMARY\n// ───────────────────────────────────────────────────────────────────\n\nfunction newPolicyTally() {\n  return { rows: 0, capped: 0, started: 0, wrote: 0 };\n}\n\nfunction newTally() {\n  return {\n    runs: 0,\n    scored: 0,\n    capped: 0,\n    unscored: 0,\n    unscoredRuns: [],\n    started: 0,\n    startRows: 0,\n    cappedStartRows: 0,\n    offered: 0,\n    cappedOfferRows: 0,\n    startedOfOffered: 0,\n    offerFieldAbsent: 0,\n    offeredAsPartner: 0,\n    offerReached: 0,\n    deliveryUnknown: 0,\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"grep -n \\\"byPolicy\\\\|newPolicyTally\\\" .skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/score-command-transcripts.mjs | head -20; echo ===; sed -n 2125,2160p .skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/score-command-transcripts.mjs\"}"},"time":{"start":1794801965664,"end":1794801966262}}}}
