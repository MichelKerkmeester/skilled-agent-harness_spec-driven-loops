"offerFieldAbsent\":0,\"offerReached\":14,\"deliveryUnknown\":24,\"offerSeen\":3,\"offerDeclined\":0,\"commandLineRate\":\"3 of 24\",\"unsafe\":2,\"unsafeNoChangedPath\":0,\"repeatedCommandLines\":0,\"loopsWithoutInit\":0,\"loops\":0,\"byPolicy\":{\"run\":{\"rows\":4,\"capped\":1,\"started\":2,\"wrote\":0},\"start\":{\"rows\":8,\"capped\":6,\"started\":2,\"wrote\":4},\"ask\":{\"rows\":4,\"capped\":1,\"started\":2,\"wrote\":1}},\"armIncomplete\":false}}}\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"=== 015 brief-cost-live.json ===\n{\"error\":\"degraded_brief\",\"rows\":44,\"liveRows\":0}\n\n=== exit ===\nbrief-cost exit=2\ndaemon running during brief cost: yes\n\n=== summary-final-after.json ===\n{\"claude\":{\"unscored\":0,\"post\":{\"runs\":24,\"scored\":24,\"capped\":0,\"unscored\":0,\"unscoredRuns\":[],\"startRate\":\"5 of 12\",\"cappedStartRows\":0,\"offered\":14,\"cappedOfferRows\":0,\"startedOfOffered\":5,\"offerFieldAbsent\":0,\"offerReached\":14,\"deliveryUnknown\":0,\"offerSeen\":1,\"offerDeclined\":0,\"commandLineRate\":\"1 of 24\",\"unsafe\":0,\"unsafeNoChangedPath\":0,\"repeatedCommandLines\":0,\"loopsWithoutInit\":0,\"loops\":0,\"byPolicy\":{\"run\":{\"rows\":4,\"capped\":0,\"started\":3,\"wrote\":0},\"start\":{\"rows\":8,\"capped\":0,\"started\":2,\"wrote\":0},\"ask\":{\"rows\":4,\"capped\":0,\"started\":0,\"wrote\":0}},\"armIncomplete\":false}},\"devin\":{\"unscored\":0,\"post\":{\"runs\":24,\"scored\":24,\"capped\":3,\"unscored\":0,\"unscoredRuns\":[],\"startRate\":\"10 of 11\",\"cappedStartRows\":1,\"offered\":14,\"cappedOfferRows\":3,\"startedOfOffered\":10,\"offerFieldAbsent\":0,\"offerReached\":14,\"deliveryUnknown\":0,\"offerSeen\":8,\"offerDeclined\":2,\"commandLineRate\":\"8 of 24\",\"unsafe\":2,\"unsafeNoChangedPath\":1,\"repeatedCommandLines\":1,\"loopsWithoutInit\":0,\"loops\":0,\"byPolicy\":{\"run\":{\"rows\":4,\"capped\":0,\"started\":4,\"wrote\":1},\"start\