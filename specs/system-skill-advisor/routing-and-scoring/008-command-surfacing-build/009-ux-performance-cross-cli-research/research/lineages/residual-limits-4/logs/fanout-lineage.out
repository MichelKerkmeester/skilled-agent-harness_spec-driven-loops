= options.maxPromptBytes - Buffer.byteLength(request(''), 'utf8');\n879-  let end = 0;\n880-  for (const char of prompt.slice(0, ADVISOR_PROMPT_MAX_CHARS)) {\n881-    remaining -= Buffer.byteLength(JSON.stringify(char), 'utf8') - 2;\n882-    if (remaining < 0) break;\n883-    end += char.length;\n884-  }\n885-  return end > 0 ? request(prompt.slice(0, end)) : null;\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"cd .opencode/plugins && rg -n \\\"function detectWorkspaceSurface\\\" -A40 system-skill-advisor.js | head -50\"}"},"time":{"start":1794570936209,"end":1794570936566}}}}
