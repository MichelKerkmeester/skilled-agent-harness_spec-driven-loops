{"type":"tool_use","timestamp":1794570623608,"sessionID":"ses_e2b4abca3ffePbIpjwQOl85imo","part":{"partID":"prt_1d4be990e002A0g0qGxV9RraM4","sessionID":"ses_e2b4abca3ffePbIpjwQOl85imo","messageID":"msg_1d4be7f60001yq9SUGz0a2kmu7","type":"tool","id":"call_6e3ae4ed08c14dec94f393a7","tool":"shell","state":{"status":"completed","input":{"command":"cd .skilled/skills/system-skill-advisor && sed -n '289,360p' hooks/claude/user-prompt-submit.ts"},"output":"export async function handleClaudeUserPromptSubmit(\n  input: ClaudeUserPromptSubmitInput | null,\n  dependencies: UserPromptSubmitDependencies = {},\n): Promise<ClaudeUserPromptSubmitOutput> {\n  const environmentRuntime = process.env.SPECKIT_RUNTIME;\n  const runtime = dependencies.runtime\n    ?? (isAdvisorRuntime(environmentRuntime) ? environmentRuntime : 'claude');\n  const startedAt = dependencies.now?.() ?? performance.now();\n  const elapsed = (): number => Number(((dependencies.now?.() ?? performance.now()) - startedAt).toFixed(3));\n  const writeDiagnostic = dependencies.writeDiagnostic;\n\n  try {\n    if (!skillAdvisorHookEnabled() || process.env.SPECKIT_SKILL_ADVISOR_HOOK_DISABLED === '1') {\n      emitDiagnostic({\n        runtime,\n        workspaceRoot: process.cwd(),\n        status: 'skipped',\n        freshness: 'unavailable',\n        durationMs: elapsed(),\n        cacheHit: false,\n      }, writeDiagnostic);\n      return {};\n    }\n\n    if (!input) {\n      emitDiagnostic({\n        runtime,\n        workspaceRoot: process.cwd(),\n        status: 'fail_open',\n        freshness: 'unavailable',\n        durationMs: elapsed(),\n        cacheHit: false,\n        errorCode: 'PARSE_FAIL',\n        errorDetails: 'Invalid UserPromptSubmit JSON payload',\n      }, writeDiagnostic);\n      return {};\n    }\n\n    const prompt = normalizePrompt(input.prompt);\n    const workspaceRoot = workspaceRootFor(input);\n    if (prompt === null) {\n      emitDiagnostic({\n        runtime,\n        workspaceRoot,\n        status: 'fail_open',\n        freshness: 'unavailable',\n        durationMs: elapsed(),\n        cacheHit: false,\n        errorCode: 'PARSE_FAIL',\n        errorDetails: 'Missing UserPromptSubmit prompt string',\n      }, writeDiagnostic);\n      return {};\n    }\n\n    const renderBrief = dependencies.renderBrief ?? renderAdvisorBrief;\n    // The CLI owns the warm-daemon probe and local-scorer fallback.\n    // The prompt-policy gate skips prompts that need no advisor before the\n    // CLI call; injected full producers stay ungated for producer-level tests.\n    const injectedBrief = dependencies.buildBrief;\n    const buildCliBrief = dependencies.buildCliBrief ?? buildSkillAdvisorBriefFromCli;\n    let result = injectedBrief\n      ? await injectedBrief(prompt, {\n        runtime,\n        workspaceRoot,\n        subprocessTimeoutMs: claudeHookTimeoutMs(),\n      })\n      : skippedAdvisorResultFor(prompt) ?? await buildCliBrief(prompt, {\n        runtime,\n        workspaceRoot,\n        timeoutMs: claudeHookTimeoutMs(),\n      }, {\n        now: dependencies.now,\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"export async function handleClaudeUserPromptSubmit(\n  input: ClaudeUserPromptSubmitInput | null,\n  dependencies: UserPromptSubmitDependencies = {},\n): Promise<ClaudeUserPromptSubmitOutput> {\n  const environmentRuntime = process.env.SPECKIT_RUNTIME;\n  const runtime = dependencies.runtime\n    ?? (isAdvisorRuntime(environmentRuntime) ? environmentRuntime : 'claude');\n  const startedAt = dependencies.now?.() ?? performance.now();\n  const elapsed = (): number => Number(((dependencies.now?.() ?? performance.now()) - startedAt).toFixed(3));\n  const writeDiagnostic = dependencies.writeDiagnostic;\n\n  try {\n    if (!skillAdvisorHookEnabled() || process.env.SPECKIT_SKILL_ADVISOR_HOOK_DISABLED === '1') {\n      emitDiagnostic({\n        runtime,\n        workspaceRoot: process.cwd(),\n        status: 'skipped',\n        freshness: 'unavailable',\n        durationMs: elapsed(),\n        cacheHit: false,\n      }, writeDiagnostic);\n      return {};\n    }\n\n    if (!input) {\n      emitDiagnostic({\n        runtime,\n        workspaceRoot: process.cwd(),\n        status: 'fail_open',\n        freshness: 'unavailable',\n        durationMs: elapsed(),\n        cacheHit: false,\n        errorCode: 'PARSE_FAIL',\n        errorDetails: 'Invalid UserPromptSubmit JSON payload',\n      }, writeDiagnostic);\n      return {};\n    }\n\n    const prompt = normalizePrompt(input.prompt);\n    const workspaceRoot = workspaceRootFor(input);\n    if (prompt === null) {\n      emitDiagnostic({\n        runtime,\n        workspaceRoot,\n        status: 'fail_open',\n        freshness: 'unavailable',\n        durationMs: elapsed(),\n        cacheHit: false,\n        errorCode: 'PARSE_FAIL',\n        errorDetails: 'Missing UserPromptSubmit prompt string',\n      }, writeDiagnostic);\n      return {};\n    }\n\n    const renderBrief = dependencies.renderBrief ?? renderAdvisorBrief;\n    // The CLI owns the warm-daemon probe and local-scorer fallback.\n    // The prompt-policy gate skips prompts that need no advisor before the\n    // CLI call; injected full producers stay ungated for producer-level tests.\n    const injectedBrief = dependencies.buildBrief;\n    const buildCliBrief = dependencies.buildCliBrief ?? buildSkillAdvisorBriefFromCli;\n    let result = injectedBrief\n      ? await injectedBrief(prompt, {\n        runtime,\n        workspaceRoot,\n        subprocessTimeoutMs: claudeHookTimeoutMs(),\n      })\n      : skippedAdvisorResultFor(prompt) ?? await buildCliBrief(prompt, {\n        runtime,\n        workspaceRoot,\n        timeoutMs: claudeHookTimeoutMs(),\n      }, {\n        now: dependencies.now,\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"cd .skilled/skills/system-skill-advisor && sed -n '289,360p' hooks/claude/user-prompt-submit.ts\"}"},"time":{"start":1794570623246,"end":1794570623608}}}}
