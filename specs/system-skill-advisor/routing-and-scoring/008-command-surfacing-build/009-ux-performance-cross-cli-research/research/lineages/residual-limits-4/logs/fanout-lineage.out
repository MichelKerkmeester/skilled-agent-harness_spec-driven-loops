h') return 'deep-research';\n  if (trimmed === 'review' || trimmed === 'deep-review') return 'deep-review';\n  if (trimmed === 'ai-council' || trimmed === 'council' || trimmed === 'deep-ai-council' || trimmed === 'deep-council') return 'deep-ai-council';\n  return trimmed;\n}\n\nasync function resolveModeAdapter(mode) {\n  const normalized = normalizeMode(mode);\n  switch (normalized) {\n    case 'deep-research': {\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"cd .skilled/skills/system-deep-loop/runtime/scripts && sed -n '1,120p' append-mode-event.cjs\"}"},"time":{"start":1794570167684,"end":1794570168043}}}}
