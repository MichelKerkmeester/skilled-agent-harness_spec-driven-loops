{"type":"tool_use","timestamp":1794523743804,"sessionID":"ses_e2e0e4b1affe2HORa6vu9VcI7O","part":{"partID":"prt_1d1f34472001A1aX7LIOLSro4l","sessionID":"ses_e2e0e4b1affe2HORa6vu9VcI7O","messageID":"msg_1d1f3394a001AWUoXj1SNZGcCu","type":"tool","id":"call_6a85b40c19454756a5ad65a2","tool":"read","state":{"status":"completed","input":{"limit":220,"offset":2320,"path":".skilled/commands/deep/assets/deep-research-auto.yaml"},"output":"Read file .skilled/commands/deep/assets/deep-research-auto.yaml, lines 2320-2539\n2320:         generated_fence_end: \"<!-- END GENERATED: deep-research/spec-findings -->\"\n2321:         fail_closed_conflict_check:\n2322:           if_existing_generated_fence_present:\n2323:             detect_manual_edits: \"Use generated checksum metadata or an explicit MANUAL-EDIT marker inside the existing fence to detect human edits before overwrite.\"\n2324:             on_manual_edit_conflict:\n2325:               append_to_jsonl: '{\"type\":\"spec_mutation\",\"event\":\"spec_mutation_conflict\",\"folder_state\":\"conflict-detected\",\"reason\":\"Manual edits detected inside existing generated findings fence.\",\"specPath\":\"{spec_folder}/spec.md\",\"generatedFence\":\"deep-research/spec-findings\",\"conflictKind\":\"generated-fence-manual-edit\",\"timestamp\":\"{ISO_8601_NOW}\"}'\n2326:               halt: true\n2327:         instructions:\n2328:           - \"Read `{state_paths.research_output}` as the canonical synthesis source.\"\n2329:           - \"Replace exactly one generated findings block under the chosen host anchor.\"\n2330:           - \"Fail closed if the host anchor is missing, duplicate markers exist, or human edits are detected inside the generated block.\"\n2331:           - \"Do not overwrite a generated block that fails checksum validation or carries an explicit MANUAL-EDIT marker.\"\n2332:           - \"Emit `spec_synthesis_deferred` instead of partial output when synthesis cannot safely write back.\"\n2333:         append_to_jsonl: '{\"type\":\"spec_mutation\",\"event\":\"spec_mutation\",\"phase\":\"post-synthesis\",\"anchors_touched\":[\"<chosen host anchor>\"],\"diff_summary\":\"Replaced generated deep-research findings fence from research/research.md.\",\"generatedFence\":\"deep-research/spec-findings\",\"timestamp\":\"{ISO_8601_NOW}\"}'\n2334: \n2335:       step_validate_post_synthesis_spec_doc:\n2336:         action: \"Run targeted strict validation after deep-research writes back into spec.md\"\n2337:         command: \"SPECKIT_RULES=FRONTMATTER_VALID,LEVEL_DECLARED,TEMPLATE_SOURCE,PLACEHOLDER_FILLED,ANCHORS_VALID,SPEC_DOC_INTEGRITY,TOC_POLICY bash .skilled/skills/system-spec-kit/runtime/cli/spec/validate.sh {spec_folder} --strict\"\n2338:         note: \"Fail closed before completion if the deep-research spec.md sync breaks the authored-spec structural contract. This targeted check uses the fast Node validation orchestrator.\"\n2339: \n2340:       step_update_config_status:\n2341:         action: \"Mark config as complete\"\n2342:         edit: \"{state_paths.config}\"\n2343:         set_field: { status: \"complete\" }\n2344: \n2345:       step_telemetry_heartbeat_terminal:\n2346:         action: \"Emit a single-loop terminal row in the orchestration status ledger\"\n2347:         skip_when: \"config.fanout is present\"\n2348:         terminal_events: [completed, failed, stopped]\n2349:         command: |\n2350:           node --import \"$(node -p \"require.resolve('tsx', { paths: ['.skilled/skills/system-deep-loop/runtime'] })\")\" --input-type=module <<'EOF'\n2351:           import { existsSync, readFileSync } from 'node:fs';\n2352: \n2353:           import { appendJsonlIfChangedAtomic } from './.skilled/skills/system-deep-loop/runtime/lib/deep-loop/atomic-state.ts';\n2354:           import observabilityEvents from './.skilled/skills/system-deep-loop/runtime/lib/deep-loop/observability-events.cjs';\n2355: \n2356:           const { appendObservabilityEvent } = observabilityEvents;\n2357:           const stateLogPath = '{state_paths.state_log}';\n2358:           const config = JSON.parse(readFileSync('{state_paths.config}', 'utf8'));\n2359:           const timestamp = '{ISO_8601_NOW}';\n2360:           const sessionId = String(config.lineage?.sessionId ?? '{config.lineage.sessionId}');\n2361:           const generation = Number(config.lineage?.generation ?? '{config.lineage.generation}');\n2362:           const reason = '{reason}';\n2363:           const observabilityPath = '{state_paths.packet_dir}/observability-events.jsonl';\n2364: \n2365:           function readRecords(path) {\n2366:             if (!existsSync(path)) return [];\n2367:             return readFileSync(path, 'utf8')\n2368:               .split(/\\r?\\n/)\n2369:               .map((line) => line.trim())\n2370:               .filter(Boolean)\n2371:               .map((line) => JSON.parse(line));\n2372:           }\n2373: \n2374:           function elapsedSince(value) {\n2375:             const startedAtMs = Date.parse(String(value ?? ''));\n2376:             const nowMs = Date.parse(timestamp);\n2377:             if (!Number.isFinite(startedAtMs) || !Number.isFinite(nowMs)) return 0;\n2378:             return Math.max(0, nowMs - startedAtMs);\n2379:           }\n2380: \n2381:           function terminalEvent(stopReason) {\n2382:             if (stopReason === 'manualStop' || stopReason === 'userPaused') return 'stopped';\n2383:             if (stopReason === 'error') return 'failed';\n2384:             return 'completed';\n2385:           }\n2386: \n2387:           const records = readRecords(stateLogPath);\n2388:           const iterations = records.filter((record) => record.type === 'iteration');\n2389:           const latest = iterations.at(-1) ?? {};\n2390:           const startedAt = records.find((record) => typeof record.createdAt === 'string')?.createdAt\n2391:             ?? records.find((record) => typeof record.timestamp === 'string')?.timestamp\n2392:             ?? timestamp;\n2393:           const elapsedMs = elapsedSince(startedAt);\n2394:           const score = Number.isFinite(Number(latest.newInfoRatio)) ? Number(latest.newInfoRatio) : 0;\n2395:           const event = terminalEvent(reason);\n2396:           const row = {\n2397:             event,\n2398:             label: 'single',\n2399:             terminal: true,\n2400:             reason,\n2401:             at: timestamp,\n2402:             duration_ms: elapsedMs,\n2403:             loop_type: 'research',\n2404:             sessionId,\n2405:             generation,\n2406:             gauges: { iterations: iterations.length, elapsed_ms: elapsedMs, score },\n2407:           };\n2408: \n2409:           const appended = appendJsonlIfChangedAtomic('{state_paths.status_ledger}', row, {\n2410:             diffData: { event, label: row.label, reason, sessionId, generation, gauges: { iterations: iterations.length, score } },\n2411:             diffField: 'state_hash',\n2412:           });\n2413:           if (appended) {\n2414:             try {\n2415:               appendObservabilityEvent(observabilityPath, row, {\n2416:                 producer: 'deep-research-auto',\n2417:                 stream: 'single-loop-telemetry',\n2418:                 subject: { label: row.label, sessionId, generation, reason },\n2419:                 event,\n2420:                 status: event,\n2421:               });\n2422:             } catch {}\n2423:           }\n2424:           EOF\n2425:         working_directory: \"{repo_root}\"\n2426:         outputs:\n2427:           - status_ledger_terminal: \"A fan-out-shaped status row with label single and event completed, failed, or stopped\"\n2428: \n2429:       step_stage_artifact_dir:\n2430:         skip_when: \"config.fanout_lineage_artifact_dir is present\"\n2431:         action: \"Stage all skill-owned artifacts under artifact_dir for the operator's next git commit\"\n2432:         command: 'git add -- \"{state_paths.packet_dir}\" \":(exclude){state_paths.packet_dir}/.deep-research.lock\" \":(exclude){state_paths.packet_dir}/.deep-research-pause\" \":(exclude){state_paths.packet_dir}/.deep-research-run-now\" \":(exclude){state_paths.packet_dir}/.legacy-projection-watermarks\"'\n2433:         note: \"Skill-owned contract: without this stage step, operators who do `git add research-report.md` lose the iteration trail (iterations/, deltas/, state.jsonl, strategy, etc.). Staging the whole artifact_dir keeps the audit trail intact. Operators retain commit authority and can `git restore --staged {path}` to unstage anything before commit. Failure is non-fatal: log warning and continue. The exclude pathspecs keep the live lock file, the pause and run-now sentinels, and the legacy projection watermark directory out of the index; locks-and-fencing-v1, ledgers, deltas, iterations and the state log stay staged.\"\n2434:         on_fail: \"Log warning. Do not block synthesis. The artifact_dir may be outside a git repo (e.g., temp test fixture) which is a valid case.\"\n2435: \n2436:   # ═══════════════════════════════════════════════════════════════\n2437:   # PHASE 4: SAVE\n2438:   # ═══════════════════════════════════════════════════════════════\n2439:   phase_save:\n2440:     purpose: Preserve research context in the packet's canonical continuity documents\n2441:     steps:\n2442: \n2443:       step_compose_save_payload:\n2444:         action: \"Compose the structured JSON payload consumed by generate-context.js\"\n2445:         output: \"/tmp/save-context-data-<session-id>.json\"\n2446:         requirements:\n2447:           - \"Write this file before invoking generate-context.js; the loader fails closed if the explicit JSON file is absent.\"\n2448:           - \"Include `specFolder`, a concise `sessionSummary`, curated `observations`, `recent_context`, `toolCalls`, and `exchanges` from the completed research loop.\"\n2449:           - \"Use a session-scoped temp filename; do not use the retired shared `/tmp/save-context-data.json` path.\"\n2450:         example_payload: |\n2451:           {\n2452:             \"specFolder\": \"{spec_folder}\",\n2453:             \"sessionSummary\": \"Deep research completed; see research/research.md for synthesized findings.\",\n2454:             \"observations\": [\"Summarize the final research conclusions and evidence.\"],\n2455:             \"recent_context\": [\"Point to the generated research artifacts and next action.\"],\n2456:             \"exchanges\": [],\n2457:             \"toolCalls\": []\n2458:           }\n2459: \n2460:       step_generate_context:\n2461:         action: \"Route continuity content into the correct canonical spec document via generate-context.js\"\n2462:         command: \"node .skilled/skills/system-spec-kit/runtime/cli/dist/continuity/generate-context.js /tmp/save-context-data-<session-id>.json {spec_folder}\"\n2463:         critical_rule: \"NEVER manually author files under retired memory/ paths (the runtime rejects them); use generate-context.js so the save routes into decision-record.md, implementation-summary.md, or handover.md\"\n2464: \n2465:       step_verify_save:\n2466:         action: \"Verify canonical save routed content into the correct spec document\"\n2467:         check: \"Does {spec_folder}/implementation-summary.md, {spec_folder}/decision-record.md, or {spec_folder}/handover.md carry the new continuity update?\"\n2468:         on_fail: \"Log warning but do not block completion\"\n2469: \n2470:       step_release_lock:\n2471:         action: \"Release the single-writer lock after save, skip-save, or cancellation cleanup has resolved\"\n2472:         command: \"node .skilled/skills/system-deep-loop/runtime/scripts/loop-lock.cjs release --lock-path {state_paths.lock_file} --owner-pid {captured_owner_pid} --nonce {captured_acquire_nonce}\"\n2473:         bookkeeping_log: '{\"type\":\"event\",\"event\":\"lock_released\",\"path\":\"{state_paths.lock_file}\",\"releasePhase\":\"save\",\"timestamp\":\"{ISO_8601_NOW}\"}'\n2474: \n2475:   # ═══════════════════════════════════════════════════════════════\n2476:   # COMPLETION\n2477:   # ═══════════════════════════════════════════════════════════════\n2478:   completion:\n2479:     message: |\n2480:       Deep research complete.\n2481:       Iterations: {iteration_count} | Stop reason: {reason}\n2482:       Questions answered: {answered_count}/{total_questions}\n2483: \n2484:       Artifacts:\n2485:         - research/research.md (compiled from {iteration_count} iterations)\n2486:         - {iteration_count} iteration files in research/\n2487:         - State files: config.json, state.jsonl, strategy.md, findings-registry.json, dashboard.md\n2488:         - Continuity update routed into the canonical spec document\n2489: \n2490:       STATUS=OK PATH={spec_folder}\n2491:     next_steps:\n2492:       - \"/speckit:plan [feature-description]\"\n2493:       - \"/deep:research [new-topic] (for related deep research)\"\n2494:       - \"/speckit:save {spec_folder} (refresh canonical continuity before the next session)\"\n2495: \n2496: # ─────────────────────────────────────────────────────────────────\n2497: # ERROR RECOVERY\n2498: # ─────────────────────────────────────────────────────────────────\n2499: error_recovery:\n2500:   agent_dispatch_timeout: \"Retry once with reduced scope (fewer research actions). If second timeout, mark as 'timeout' and continue.\"\n2501:   state_file_missing: \"If JSONL missing during loop, reconstruct from iteration files. If strategy missing, create minimal version.\"\n2502:   consecutive_failures: \"After 3 consecutive errors, halt loop and enter synthesis with partial findings.\"\n2503:   continuity_save_failure: \"Preserve the research/ packet as backup. Log warning.\"\n2504: \n2505: # ─────────────────────────────────────────────────────────────────\n2506: # RULES\n2507: # ─────────────────────────────────────────────────────────────────\n2508: rules:\n2509:   ALWAYS:\n2510:     - follow_workflow_phases_in_order\n2511:     - dispatch_deep_research_agent_per_iteration\n2512:     - check_convergence_before_each_iteration\n2513:     - write_all_state_to_files\n2514:     - refresh_lineage_context_before_next_prompt\n2515:     - write_continuity_after_synthesis\n2516:     - respect_max_iterations_cap\n2517:   NEVER:\n2518:     - skip_convergence_check\n2519:     - dispatch_non_leaf_agents\n2520:     - hold_iteration_findings_in_memory_only\n2521:     - modify_config_after_initialization\n2522:     - overwrite_jsonl_state_log\n2523:     - proceed_without_state_file_verification\n2524: \n2525: # ─────────────────────────────────────────────────────────────────\n2526: # REFERENCE-ONLY APPENDIX\n2527: # ─────────────────────────────────────────────────────────────────\n2528: reference_only_appendix:\n2529:   checkpoint_commit:\n2530:     note: \"Checkpoint commits are intentionally excluded from workflow.steps.\"\n2531:     commands:\n2532:       - \"git add {state_paths.iteration_pattern} {state_paths.state_log} {state_paths.strategy} {state_paths.research_output}\"\n2533:       - 'git commit -m \"chore(deep-research): iteration {NNN} complete\" -m \"{one-line summary of what the iteration found}\"'\n2534:   wave_orchestration:\n2535:     note: \"Wave execution is intentionally excluded from workflow.steps.\"\n2536:     summary:\n2537:       - \"Check whether 3+ independent unanswered questions justify a wave.\"\n2538:       - \"Dispatch up to 3 parallel agents on distinct questions.\"\n2539:       - \"Score wave results by median newInfoRatio and promote top branches.\"","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file .skilled/commands/deep/assets/deep-research-auto.yaml, lines 2320-2539\n2320:         generated_fence_end: \"<!-- END GENERATED: deep-research/spec-findings -->\"\n2321:         fail_closed_conflict_check:\n2322:           if_existing_generated_fence_present:\n2323:             detect_manual_edits: \"Use generated checksum metadata or an explicit MANUAL-EDIT marker inside the existing fence to detect human edits before overwrite.\"\n2324:             on_manual_edit_conflict:\n2325:               append_to_jsonl: '{\"type\":\"spec_mutation\",\"event\":\"spec_mutation_conflict\",\"folder_state\":\"conflict-detected\",\"reason\":\"Manual edits detected inside existing generated findings fence.\",\"specPath\":\"{spec_folder}/spec.md\",\"generatedFence\":\"deep-research/spec-findings\",\"conflictKind\":\"generated-fence-manual-edit\",\"timestamp\":\"{ISO_8601_NOW}\"}'\n2326:               halt: true\n2327:         instructions:\n2328:           - \"Read `{state_paths.research_output}` as the canonical synthesis source.\"\n2329:           - \"Replace exactly one generated findings block under the chosen host anchor.\"\n2330:           - \"Fail closed if the host anchor is missing, duplicate markers exist, or human edits are detected inside the generated block.\"\n2331:           - \"Do not overwrite a generated block that fails checksum validation or carries an explicit MANUAL-EDIT marker.\"\n2332:           - \"Emit `spec_synthesis_deferred` instead of partial output when synthesis cannot safely write back.\"\n2333:         append_to_jsonl: '{\"type\":\"spec_mutation\",\"event\":\"spec_mutation\",\"phase\":\"post-synthesis\",\"anchors_touched\":[\"<chosen host anchor>\"],\"diff_summary\":\"Replaced generated deep-research findings fence from research/research.md.\",\"generatedFence\":\"deep-research/spec-findings\",\"timestamp\":\"{ISO_8601_NOW}\"}'\n2334: \n2335:       step_validate_post_synthesis_spec_doc:\n2336:         action: \"Run targeted strict validation after deep-research writes back into spec.md\"\n2337:         command: \"SPECKIT_RULES=FRONTMATTER_VALID,LEVEL_DECLARED,TEMPLATE_SOURCE,PLACEHOLDER_FILLED,ANCHORS_VALID,SPEC_DOC_INTEGRITY,TOC_POLICY bash .skilled/skills/system-spec-kit/runtime/cli/spec/validate.sh {spec_folder} --strict\"\n2338:         note: \"Fail closed before completion if the deep-research spec.md sync breaks the authored-spec structural contract. This targeted check uses the fast Node validation orchestrator.\"\n2339: \n2340:       step_update_config_status:\n2341:         action: \"Mark config as complete\"\n2342:         edit: \"{state_paths.config}\"\n2343:         set_field: { status: \"complete\" }\n2344: \n2345:       step_telemetry_heartbeat_terminal:\n2346:         action: \"Emit a single-loop terminal row in the orchestration status ledger\"\n2347:         skip_when: \"config.fanout is present\"\n2348:         terminal_events: [completed, failed, stopped]\n2349:         command: |\n2350:           node --import \"$(node -p \"require.resolve('tsx', { paths: ['.skilled/skills/system-deep-loop/runtime'] })\")\" --input-type=module <<'EOF'\n2351:           import { existsSync, readFileSync } from 'node:fs';\n2352: \n2353:           import { appendJsonlIfChangedAtomic } from './.skilled/skills/system-deep-loop/runtime/lib/deep-loop/atomic-state.ts';\n2354:           import observabilityEvents from './.skilled/skills/system-deep-loop/runtime/lib/deep-loop/observability-events.cjs';\n2355: \n2356:           const { appendObservabilityEvent } = observabilityEvents;\n2357:           const stateLogPath = '{state_paths.state_log}';\n2358:           const config = JSON.parse(readFileSync('{state_paths.config}', 'utf8'));\n2359:           const timestamp = '{ISO_8601_NOW}';\n2360:           const sessionId = String(config.lineage?.sessionId ?? '{config.lineage.sessionId}');\n2361:           const generation = Number(config.lineage?.generation ?? '{config.lineage.generation}');\n2362:           const reason = '{reason}';\n2363:           const observabilityPath = '{state_paths.packet_dir}/observability-events.jsonl';\n2364: \n2365:           function readRecords(path) {\n2366:             if (!existsSync(path)) return [];\n2367:             return readFileSync(path, 'utf8')\n2368:               .split(/\\r?\\n/)\n2369:               .map((line) => line.trim())\n2370:               .filter(Boolean)\n2371:               .map((line) => JSON.parse(line));\n2372:           }\n2373: \n2374:           function elapsedSince(value) {\n2375:             const startedAtMs = Date.parse(String(value ?? ''));\n2376:             const nowMs = Date.parse(timestamp);\n2377:             if (!Number.isFinite(startedAtMs) || !Number.isFinite(nowMs)) return 0;\n2378:             return Math.max(0, nowMs - startedAtMs);\n2379:           }\n2380: \n2381:           function terminalEvent(stopReason) {\n2382:             if (stopReason === 'manualStop' || stopReason === 'userPaused') return 'stopped';\n2383:             if (stopReason === 'error') return 'failed';\n2384:             return 'completed';\n2385:           }\n2386: \n2387:           const records = readRecords(stateLogPath);\n2388:           const iterations = records.filter((record) => record.type === 'iteration');\n2389:           const latest = iterations.at(-1) ?? {};\n2390:           const startedAt = records.find((record) => typeof record.createdAt === 'string')?.createdAt\n2391:             ?? records.find((record) => typeof record.timestamp === 'string')?.timestamp\n2392:             ?? timestamp;\n2393:           const elapsedMs = elapsedSince(startedAt);\n2394:           const score = Number.isFinite(Number(latest.newInfoRatio)) ? Number(latest.newInfoRatio) : 0;\n2395:           const event = terminalEvent(reason);\n2396:           const row = {\n2397:             event,\n2398:             label: 'single',\n2399:             terminal: true,\n2400:             reason,\n2401:             at: timestamp,\n2402:             duration_ms: elapsedMs,\n2403:             loop_type: 'research',\n2404:             sessionId,\n2405:             generation,\n2406:             gauges: { iterations: iterations.length, elapsed_ms: elapsedMs, score },\n2407:           };\n2408: \n2409:           const appended = appendJsonlIfChangedAtomic('{state_paths.status_ledger}', row, {\n2410:             diffData: { event, label: row.label, reason, sessionId, generation, gauges: { iterations: iterations.length, score } },\n2411:             diffField: 'state_hash',\n2412:           });\n2413:           if (appended) {\n2414:             try {\n2415:               appendObservabilityEvent(observabilityPath, row, {\n2416:                 producer: 'deep-research-auto',\n2417:                 stream: 'single-loop-telemetry',\n2418:                 subject: { label: row.label, sessionId, generation, reason },\n2419:                 event,\n2420:                 status: event,\n2421:               });\n2422:             } catch {}\n2423:           }\n2424:           EOF\n2425:         working_directory: \"{repo_root}\"\n2426:         outputs:\n2427:           - status_ledger_terminal: \"A fan-out-shaped status row with label single and event completed, failed, or stopped\"\n2428: \n2429:       step_stage_artifact_dir:\n2430:         skip_when: \"config.fanout_lineage_artifact_dir is present\"\n2431:         action: \"Stage all skill-owned artifacts under artifact_dir for the operator's next git commit\"\n2432:         command: 'git add -- \"{state_paths.packet_dir}\" \":(exclude){state_paths.packet_dir}/.deep-research.lock\" \":(exclude){state_paths.packet_dir}/.deep-research-pause\" \":(exclude){state_paths.packet_dir}/.deep-research-run-now\" \":(exclude){state_paths.packet_dir}/.legacy-projection-watermarks\"'\n2433:         note: \"Skill-owned contract: without this stage step, operators who do `git add research-report.md` lose the iteration trail (iterations/, deltas/, state.jsonl, strategy, etc.). Staging the whole artifact_dir keeps the audit trail intact. Operators retain commit authority and can `git restore --staged {path}` to unstage anything before commit. Failure is non-fatal: log warning and continue. The exclude pathspecs keep the live lock file, the pause and run-now sentinels, and the legacy projection watermark directory out of the index; locks-and-fencing-v1, ledgers, deltas, iterations and the state log stay staged.\"\n2434:         on_fail: \"Log warning. Do not block synthesis. The artifact_dir may be outside a git repo (e.g., temp test fixture) which is a valid case.\"\n2435: \n2436:   # ═══════════════════════════════════════════════════════════════\n2437:   # PHASE 4: SAVE\n2438:   # ═══════════════════════════════════════════════════════════════\n2439:   phase_save:\n2440:     purpose: Preserve research context in the packet's canonical continuity documents\n2441:     steps:\n2442: \n2443:       step_compose_save_payload:\n2444:         action: \"Compose the structured JSON payload consumed by generate-context.js\"\n2445:         output: \"/tmp/save-context-data-<session-id>.json\"\n2446:         requirements:\n2447:           - \"Write this file before invoking generate-context.js; the loader fails closed if the explicit JSON file is absent.\"\n2448:           - \"Include `specFolder`, a concise `sessionSummary`, curated `observations`, `recent_context`, `toolCalls`, and `exchanges` from the completed research loop.\"\n2449:           - \"Use a session-scoped temp filename; do not use the retired shared `/tmp/save-context-data.json` path.\"\n2450:         example_payload: |\n2451:           {\n2452:             \"specFolder\": \"{spec_folder}\",\n2453:             \"sessionSummary\": \"Deep research completed; see research/research.md for synthesized findings.\",\n2454:             \"observations\": [\"Summarize the final research conclusions and evidence.\"],\n2455:             \"recent_context\": [\"Point to the generated research artifacts and next action.\"],\n2456:             \"exchanges\": [],\n2457:             \"toolCalls\": []\n2458:           }\n2459: \n2460:       step_generate_context:\n2461:         action: \"Route continuity content into the correct canonical spec document via generate-context.js\"\n2462:         command: \"node .skilled/skills/system-spec-kit/runtime/cli/dist/continuity/generate-context.js /tmp/save-context-data-<session-id>.json {spec_folder}\"\n2463:         critical_rule: \"NEVER manually author files under retired memory/ paths (the runtime rejects them); use generate-context.js so the save routes into decision-record.md, implementation-summary.md, or handover.md\"\n2464: \n2465:       step_verify_save:\n2466:         action: \"Verify canonical save routed content into the correct spec document\"\n2467:         check: \"Does {spec_folder}/implementation-summary.md, {spec_folder}/decision-record.md, or {spec_folder}/handover.md carry the new continuity update?\"\n2468:         on_fail: \"Log warning but do not block completion\"\n2469: \n2470:       step_release_lock:\n2471:         action: \"Release the single-writer lock after save, skip-save, or cancellation cleanup has resolved\"\n2472:         command: \"node .skilled/skills/system-deep-loop/runtime/scripts/loop-lock.cjs release --lock-path {state_paths.lock_file} --owner-pid {captured_owner_pid} --nonce {captured_acquire_nonce}\"\n2473:         bookkeeping_log: '{\"type\":\"event\",\"event\":\"lock_released\",\"path\":\"{state_paths.lock_file}\",\"releasePhase\":\"save\",\"timestamp\":\"{ISO_8601_NOW}\"}'\n2474: \n2475:   # ═══════════════════════════════════════════════════════════════\n2476:   # COMPLETION\n2477:   # ═══════════════════════════════════════════════════════════════\n2478:   completion:\n2479:     message: |\n2480:       Deep research complete.\n2481:       Iterations: {iteration_count} | Stop reason: {reason}\n2482:       Questions answered: {answered_count}/{total_questions}\n2483: \n2484:       Artifacts:\n2485:         - research/research.md (compiled from {iteration_count} iterations)\n2486:         - {iteration_count} iteration files in research/\n2487:         - State files: config.json, state.jsonl, strategy.md, findings-registry.json, dashboard.md\n2488:         -