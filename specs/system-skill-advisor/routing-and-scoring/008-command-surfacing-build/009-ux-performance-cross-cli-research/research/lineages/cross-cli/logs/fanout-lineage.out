═══\n2186:   phase_synthesis:\n2187:     purpose: Compile all iteration findings into final research/research.md\n2188:     steps:\n2189: \n2190:       step_fanout_merge:\n2191:         description: \"Merge N lineage registries into one consolidated registry; skip when single-executor\"\n2192:         skip_when: \"config.fanout is absent\"\n2193:         command: |\n2194:           node .skilled/skills/system-deep-loop/runtime/scripts/fanout-merge.cjs \\\n2195:             --loop-type research \\\n2196:             --artifact-dir {artifact_dir}\n2197:         working_directory: \"{repo_root}\"\n2198:         wait_for_completion: true\n2199: \n2200:       step_hydrate_summary_metrics:\n2201:         action: \"Hydrate summary metrics before synthesis\"\n2202:         read:\n2203:           - \"{state_paths.config}\"\n2204:           - \"{state_paths.state_log}\"\n2205:           - \"{state_paths.registry}\"\n2206:           - \"{state_paths.strategy}\"\n2207:         read_patterns:\n2208:           - \"{state_paths.packet_dir}/lineages/*/deep-research-state.jsonl\"\n2209:           - \"{state_paths.packet_dir}/lineages/*/deep-research-strategy.md\"\n2210:         extract:\n2211:           - iteration_count: \"When direct lineage state logs exist, count distinct run values (run, else iteration) across those logs in stable lineage order; otherwise count distinct run values (run, else iteration) across the root state log. Never add root compatibility records to lineage records.\"\n2212:           - highest_run: \"When direct lineage state logs exist, take the highest run value (run, else iteration) across lines where type === 'iteration' in those logs in stable lineage order, else 0; otherwise take the highest run value (run, else iteration) across lines where type === 'iteration' in the root state log, else 0. Never add root compatibility records to lineage records.\"\n2213:           - current_iteration: \"max(highest_run, iteration_count) + 1\"\n2214:           - curr