quire('./specs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/009-ux-performance-cross-cli-research/research/lineages/cross-cli/findings-registry.json'); console.log('sourceFindings',r.metrics.sourceFindings,'gaps',r.metrics.reconstructionGaps)\\\"\",\"workdir\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research\"}"},"time":{"start":1794524775377,"end":1794524777233}}}}
