n { check: true };\n  }\n  throw new Error('Usage: node sync-prompts.cjs [--check]');\n}\n\nfunction listCommandFiles(directory) {\n  if (!fs.existsSync(directory)) {\n    return [];\n  }\n\n  const relativePaths = [];\n  const walk = (current) => {\n    for (const entry of fs.readdirSync(current, { withFileTypes: true })) {\n      const absolute = path.join(current, entry.name);\n      if (entry.isDirectory()) {\n        if (!EXCLUDED_DIRECTORIES.has(entry.name)) {\n          walk(absolute);\n        }\n        continue;\n      }\n      if (!entry.isFile() || !entry.name.endsWith('.md')) {\n        continue;\n      }\n      if (entry.name === 'README.md' || entry.name.endsWith('.contract.md')) {\n        continue;\n      }\n      relativePaths.push(path.relative(SOURCE_DIR, absolute).split(path.sep).join('/'));\n--- naming\n20:const REPO_ROOT = findRepoRoot(__dirname);\n47:      const absolute = path.join(current, entry.name);\n49:        if (!EXCLUDED_DIRECTORIES.has(entry.name)) {\n54:      if (!entry.isFile() || !entry.name.endsWith('.md')) {\n57:      if (entry.name === 'README.md' || entry.name.endsWith('.contract.md')) {\n73:    .filter((entry) => entry.isFile() && entry.name.endsWith('.md'))\n74:    .map((entry) => entry.name)\n79:  return relativePath.replace(/\\.md$/, '').split('/').join('-');\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"// ───────────────────────────────────────────────────────────────────\n// MODULE: Sync Codex Prompts\n// ───────────────────────────────────────────────────────────────────\n\n'use strict';\n\n// ───────────────────────────────────────────────────────────────────\n// 1. IMPORTS\n// ───────────────────────────────────────────────────────────────────\n\nconst fs = require('node:fs');\nconst path = require('node:path');\nconst { isCanonicalMirrorExcluded } = require('../runtime-mirrors/command-scope.cjs');\n\n// ───────────────────────────────────────────────────────────────────\n// 2. CONSTANTS\n// ───────────────────────────────────────────────────────────────────\n\nconst { findRepoRoot } = require('@spec-kit/shared/workspace/repo-root.mjs');\nconst REPO_ROOT = findRepoRoot(__dirname);\nconst SOURCE_DIR = path.join(REPO_ROOT, '.skilled', 'commands');\nconst OUTPUT_DIR = path.join(REPO_ROOT, '.codex', 'prompts');\nconst EXCLUDED_DIRECTORIES = new Set(['assets', 'scripts', 'fixtures']);\n\n// ───────────────────────────────────────────────────────────────────\n// 3. HELPERS\n// ───────────────────────────────────────────────────────────────────\n\nfunction parseArguments(argv) {\n  if (argv.length === 0) {\n    return { check: false };\n  }\n  if (argv.length === 1 && argv[0] === '--check') {\n    return { check: true };\n  }\n  throw new Error('Usage: node sync-prompts.cjs [--check]');\n}\n\nfunction listCommandFiles(directory) {\n  if (!fs.existsSync(directory)) {\n    return [];\n  }\n\n  const relativePaths = [];\n  const walk = (current) => {\n    for (const entry of fs.readdirSync(current, { withFileTypes: true })) {\n      const absolute = path.join(current, entry.name);\n      if (entry.isDirectory()) {\n        if (!EXCLUDED_DIRECTORIES.has(entry.name)) {\n          walk(absolute);\n        }\n        continue;\n      }\n      if (!entry.isFile() || !entry.name.endsWith('.md')) {\n        continue;\n      }\n      if (entry.name === 'README.md' || entry.name.endsWith('.contract.md')) {\n        continue;\n      }\n      relativePaths.push(path.relative(SOURCE_DIR, absolute).split(path.sep).join('/'));\n--- naming\n20:const REPO_ROOT = findRepoRoot(__dirname);\n47:      const absolute = path.join(current, entry.name);\n49:        if (!EXCLUDED_DIRECTORIES.has(entry.name)) {\n54:      if (!entry.isFile() || !entry.name.endsWith('.md')) {\n57:      if (entry.name === 'README.md' || entry.name.endsWith('.contract.md')) {\n73:    .filter((entry) => entry.isFile() && entry.name.endsWith('.md'))\n74:   