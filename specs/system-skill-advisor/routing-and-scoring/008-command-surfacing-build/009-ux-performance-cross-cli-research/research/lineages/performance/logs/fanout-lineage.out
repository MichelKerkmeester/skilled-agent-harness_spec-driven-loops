{"type":"tool_use","timestamp":1794524024763,"sessionID":"ses_e2e0e4d38ffeP1JOC1np1mhw9O","part":{"partID":"prt_1d1f78d0e001at3vVMPW2JDgLG","sessionID":"ses_e2e0e4d38ffeP1JOC1np1mhw9O","messageID":"msg_1d1f7751a001x8tpD3h1x8WKwF","type":"tool","id":"call_9664573d030042578d19edcc","tool":"shell","state":{"status":"completed","input":{"command":"cd /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research && sed -n '210,340p' .skilled/skills/system-skill-advisor/hooks/pi/prompt-advisor.ts"},"output":"// its timeout budget — enough to distinguish a timeout (durationMs ≈ budgetMs)\n// from an unreachable daemon (fast fallback) without instrumenting the advisor.\nexport function formatPiAdvisorDebug(\n  context: string | undefined,\n  advisorFailed: boolean,\n  durationMs: number,\n): string {\n  let brief: string;\n  if (advisorFailed) brief = \"failed\";\n  else if (!context || !context.trim()) brief = \"empty\";\n  else if (context.startsWith(\"Advisor: outage (\")) brief = \"fallback(outage)\";\n  else if (context.startsWith(\"Advisor: no skill matched.\")) brief = \"fallback(no-match)\";\n  else if (context.startsWith(\"Advisor: prompt skipped.\")) brief = \"fallback(skipped)\";\n  else if (context.startsWith(\"Directives:\")) brief = \"fallback(headless)\";\n  else {\n    const match = context.match(/^Advisor:\\s*([A-Za-z]+)/);\n    brief = match ? `head(${match[1]})` : \"other\";\n  }\n  const budgetMs = advisorBudgetMs();\n  return `[advisor-debug] brief=${brief} durationMs=${durationMs} budgetMs=${budgetMs}`;\n}\n\n// ───────────────────────────────────────────────────────────────────\n// 7. EXTENSION ENTRY POINT\n// ───────────────────────────────────────────────────────────────────\n\ninterface AdvisorEnvelope {\n  hookSpecificOutput?: {\n    additionalContext?: string;\n  };\n}\n\n/**\n * Bridges the skill-advisor's UserPromptSubmit recommendation into Pi's input\n * event. Distinct from spec-gate-classify.ts, which opens the gate silently and\n * appends only the one-shot deferral instruction when the session has no dialog\n * UI attached.\n */\nexport default function promptAdvisor(pi: ExtensionAPI): void {\n  pi.on(\"session_start\", (_event, ctx) => {\n    resetPiDirectiveDedupForSession(sessionIdFromContext(ctx));\n  });\n\n  pi.on(\"session_compact\", (_event, ctx) => {\n    resetPiDirectiveDedupForSession(sessionIdFromContext(ctx));\n  });\n\n  pi.on(\"input\", async (event, ctx) => {\n    try {\n      if (event.source === \"interactive\" || event.source === \"rpc\") {\n        captureRawPiUserInput(event.text, sessionIdFromContext(ctx));\n      }\n    } catch {\n      // A failed raw capture must not alter a valid user turn.\n    }\n\n    let context: string | undefined;\n    let advisorFailed = false;\n    let advisorMs = 0;\n    const advisorStart = Date.now();\n    try {\n      if (!event.text.trim()) return;\n\n      const advisorModule = await import(ADVISOR_HOOK_MODULE).catch(\n        () => import(ADVISOR_HOOK_FALLBACK_MODULE),\n      );\n      const { handleClaudeUserPromptSubmit, renderAdvisorFallbackDirective, SETUP_WORDING } = advisorModule as {\n        handleClaudeUserPromptSubmit?: (\n          input: {\n            prompt?: string;\n            cwd?: string;\n            hook_event_name?: string;\n          },\n          dependencies?: { runtime?: \"pi\"; writeDiagnostic?: (line: string) => void },\n        ) => Promise<AdvisorEnvelope | Record<string, unknown>>;\n        renderAdvisorFallbackDirective?: (options?: { setupWording?: boolean }) => string;\n        SETUP_WORDING?: RegExp;\n      };\n      if (typeof handleClaudeUserPromptSubmit === \"function\") {\n        let deadlineTimer: ReturnType<typeof setTimeout> | undefined;\n        try {\n          const outcome = await Promise.race([\n            handleClaudeUserPromptSubmit(\n              {\n                prompt: event.text,\n                cwd: ctx.cwd,\n                hook_event_name: \"UserPromptSubmit\",\n              },\n              // The hook runs inside Pi's own process, so its default stderr\n              // diagnostic would draw over Pi's input line. The record is\n              // still persisted to disk by the hook.\n              { runtime: \"pi\", writeDiagnostic: () => {} },\n            ).then((output) => ({ timedOut: false as const, output })),\n            new Promise<{ timedOut: true }>((resolve) => {\n              const budgetMs = advisorBudgetMs();\n              deadlineTimer = setTimeout(\n                () => resolve({ timedOut: true }),\n                budgetMs + PI_ADVISOR_DEADLINE_MARGIN_MS,\n              );\n              deadlineTimer.unref();\n            }),\n          ]);\n          if (outcome.timedOut) {\n            if (typeof renderAdvisorFallbackDirective === \"function\") {\n              context = renderAdvisorFallbackDirective({\n                setupWording: SETUP_WORDING?.test(event.text) === true,\n              });\n            }\n          } else {\n            context = (outcome.output as AdvisorEnvelope).hookSpecificOutput\n              ?.additionalContext;\n          }\n        } finally {\n          if (deadlineTimer) clearTimeout(deadlineTimer);\n        }\n      }\n    } catch {\n      advisorFailed = true;\n    } finally {\n      advisorMs = Date.now() - advisorStart;\n    }\n\n    const advisorDebug = isPiAdvisorDebugEnabled()\n      ? formatPiAdvisorDebug(context, advisorFailed, advisorMs)\n      : \"\";\n\n    if (!advisorFailed && context) {\n      try {\n        const decision = decidePiDirectiveDelivery(context, sessionIdFromContext(ctx));\n        if (decision.suppressed) {\n          // A suppressed turn normally emits no transform. When advisor-debug is\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"// its timeout budget — enough to distinguish a timeout (durationMs ≈ budgetMs)\n// from an unreachable daemon (fast fallback) without instrumenting the advisor.\nexport function formatPiAdvisorDebug(\n  context: string | undefined,\n  advisorFailed: boolean,\n  durationMs: number,\n): string {\n  let brief: string;\n  if (advisorFailed) brief = \"failed\";\n  else if (!context || !context.trim()) brief = \"empty\";\n  else if (context.startsWith(\"Advisor: outage (\")) brief = \"fallback(outage)\";\n  else if (context.startsWith(\"Advisor: no skill matched.\")) brief = \"fallback(no-match)\";\n  else if (context.startsWith(\"Advisor: prompt skipped.\")) brief = \"fallback(skipped)\";\n  else if (context.startsWith(\"Directives:\")) brief = \"fallback(headless)\";\n  else {\n    const match = context.match(/^Advisor:\\s*([A-Za-z]+)/);\n    brief = match ? `head(${match[1]})` : \"other\";\n  }\n  const budgetMs = advisorBudgetMs();\n  return `[advisor-debug] brief=${brief} durationMs=${durationMs} budgetMs=${budgetMs}`;\n}\n\n// ───────────────────────────────────────────────────────────────────\n// 7. EXTENSION ENTRY POINT\n// ───────────────────────────────────────────────────────────────────\n\ninterface AdvisorEnvelope {\n  hookSpecificOutput?: {\n    additionalContext?: string;\n  };\n}\n\n/**\n * Bridges the skill-advisor's UserPromptSubmit recommendation into Pi's input\n * event. Distinct from spec-gate-classify.ts, which opens the gate silently and\n * appends only the one-shot deferral instruction when the session has no dialog\n * UI attached.\n */\nexport default function promptAdvisor(pi: ExtensionAPI): void {\n  pi.on(\"session_start\", (_event, ctx) => {\n    resetPiDirectiveDedupForSession(sessionIdFromContext(ctx));\n  });\n\n  pi.on(\"session_compact\", (_event, ctx) => {\n    resetPiDirectiveDedupForSession(sessionIdFromContext(ctx));\n  });\n\n  pi.on(\"input\", async (event, ctx) => {\n    try {\n      if (event.source === \"interactive\" || event.source === \"rpc\") {\n        captureRawPiUserInput(event.text, sessionIdFromContext(ctx));\n      }\n    } catch {\n      // A failed raw capture must not alter a valid user turn.\n    }\n\n    let context: string | undefined;\n    let advisorFailed = false;\n    let advisorMs = 0;\n    const advisorStart = Date.now();\n    try {\n      if (!event.text.trim()) return;\n\n      const advisorModule = await import(ADVISOR_HOOK_MODULE).catch(\n        () => import(ADVISOR_HOOK_FALLBACK_MODULE),\n      );\n      const { handleClaudeUserPromptSubmit, renderAdvisorFallbackDirective, SETUP_WORDING } = advisorModule as {\n        handleClaudeUserPromptSubmit?: (\n          input: {\n            prompt?: string;\n            cwd?: string;\n            hook_event_name?: string;\n          },\n          dependencies?: { runtime?: \"pi\"; writeDiagnostic?: (line: string) => void },\n        ) => Promise<AdvisorEnvelope | Record<string, unknown>>;\n        renderAdvisorFallbackDirective?: (options?: { setupWording?: boolean }) => string;\n        SETUP_WORDING?: RegExp;\n      };\n      if (typeof handleClaudeUserPromptSubmit === \"function\") {\n        let deadlineTimer: ReturnType<typeof setTimeout> | undefined;\n        try {\n          const outcome = await Promise.race([\n            handleClaudeUserPromptSubmit(\n              {\n                prompt: event.text,\n                cwd: ctx.cwd,\n                hook_event_name: \"UserPromptSubmit\",\n              },\n              // The hook runs inside Pi's own process, so its default stderr\n              // diagnostic would draw over Pi's input line. The record is\n              // still persisted to disk by the hook.\n              { runtime: \"pi\", writeDiagnostic: () => {} },\n            ).then((output) => ({ timedOut: false as const, output })),\n            new Promise<{ timedOut: true }>((resolve) => {\n              const budgetMs = advisorBudgetMs();\n              deadlineTimer = setTimeout(\n                () => resolve({ timedOut: true }),\n                budgetMs + PI_ADVISOR_DEADLINE_MARGIN_MS,\n              );\n              deadlineTimer.unref();\n            }),\n          ]);\n          if (outcome.timedOut) {\n            if (typeof renderAdvisorFallbackDirective === \"function\") {\n              context = renderAdvisorFallbackDirective({\n                setupWording: SETUP_WORDING?.test(event.text) === true,\n              });\n            }\n          } else {\n            context = (outcome.output as AdvisorEnvelope).hookSpecificOutput\n              ?.additionalContext;\n          }\n        } finally {\n          if (deadlineTimer) clearTimeout(deadlineTimer);\n        }\n      }\n    } catch {\n      advisorFailed = true;\n    } finally {\n      advisorMs = Date.now() - advisorStart;\n    }\n\n    const advisorDebug = isPiAdvisorDebugEnabled()\n      ? formatPiAdvisorDebug(context, advisorFailed, advisorMs)\n      : \"\";\n\n    if (!advisorFailed && context) {\n      try {\n        const decision = decidePiDirectiveDelivery(context, sessionIdFromContext(ctx));\n        if (decision.suppressed) {\n          // A suppressed turn normally emits no transform. When advisor-debug is\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"cd /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research && sed -n '210,340p' .skilled/skills/system-skill-advisor/hooks/pi/prompt-advisor.ts\"}"},"time":{"start":1794524024078,"end":1794524024763}}}}
