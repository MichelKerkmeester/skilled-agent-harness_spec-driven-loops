{"type":"tool_use","timestamp":1794524447532,"sessionID":"ses_e2e0e4d38ffeP1JOC1np1mhw9O","part":{"partID":"prt_1d1fe0181001Uw6Iv3CPe6MMO1","sessionID":"ses_e2e0e4d38ffeP1JOC1np1mhw9O","messageID":"msg_1d1fdc2b4001GE8SBQWgDnyTqK","type":"tool","id":"call_36f758666a8148d19e02b246","tool":"read","state":{"status":"completed","input":{"limit":140,"offset":470,"path":".skilled/skills/system-skill-advisor/runtime/lib/render.ts"},"output":"Read file .skilled/skills/system-skill-advisor/runtime/lib/render.ts, lines 470-609\n470: \n471: /**\n472:  * Render the model-visible advisor brief from typed advisor output only.\n473:  *\n474:  * The renderer is the prompt-boundary guard: it ignores free-form reasons,\n475:  * descriptions, stdout/stderr, and prompt text, and emits nothing when the\n476:  * repository-authored skill label looks instruction-shaped after folding.\n477:  */\n478: export function renderAdvisorBrief(\n479:   result: AdvisorBriefRenderableResult,\n480:   options: AdvisorBriefRenderOptions = {},\n481: ): string | null {\n482:   if (result.status !== 'ok') {\n483:     observeAdvisorPolicy(null, options);\n484:     return null;\n485:   }\n486:   if (result.freshness !== 'live' && result.freshness !== 'stale') {\n487:     observeAdvisorPolicy(null, options);\n488:     return null;\n489:   }\n490: \n491:   const tokenCap = clampTokenCap(result.metrics?.tokenCap ?? options.tokenCap);\n492:   const thresholdConfig = options.thresholdConfig;\n493:   const recommendations = result.recommendations.filter((recommendation) => (\n494:     recommendation.passes_threshold === true\n495:     || (\n496:       recommendation.confidence >= (thresholdConfig?.confidenceThreshold ?? resolvedConfidenceThreshold())\n497:       && (\n498:         thresholdConfig?.confidenceOnly === true\n499:         || recommendation.uncertainty <= (thresholdConfig?.uncertaintyThreshold ?? resolvedUncertaintyThreshold())\n500:       )\n501:     )\n502:   ));\n503:   const [top, second] = recommendations;\n504:   if (!top) {\n505:     observeAdvisorPolicy(null, options);\n506:     return null;\n507:   }\n508: \n509:   const topLabel = isDoctorBridgeId(top.skill)\n510:     ? doctorCommandString(top.skill)\n511:     : sanitizeSkillLabel(metadataSkillLabel(result) ?? top.skill);\n512:   if (!topLabel) {\n513:     observeAdvisorPolicy(null, options);\n514:     return null;\n515:   }\n516: \n517:   const companion = isDoctorBridgeId(top.skill)\n518:     ? undefined\n519:     : recommendations.slice(1).find((recommendation) => doctorCommandString(recommendation.skill) !== null);\n520:   const companionLabel = companion ? doctorCommandString(companion.skill) : null;\n521:   const companionLine = (shownSecond: string | undefined): string => (\n522:     companionLabel && companion && companion.skill !== shownSecond ? `\\nAlso: ${companionLabel}` : ''\n523:   );\n524:   const capWithCompanion = (head: string, companionText: string, cap: number): string => {\n525:     const companionFits = head.length + companionText.length <= cap * TOKEN_TO_CHAR_ESTIMATE;\n526:     return `${capText(head, cap)}${companionFits ? companionText : ''}`;\n527:   };\n528: \n529:   const precomputedAmbiguous = typeof result.ambiguous === 'boolean' ? result.ambiguous : undefined;\n530:   if (tokenCap > DEFAULT_TOKEN_CAP && second && hasAdvisorAmbiguitySignal(recommendations, precomputedAmbiguous)) {\n531:     // The scorer names its own tie partners, which can sit below the second passing\n532:     // entry, so prefer a named partner and fall back to the second entry.\n533:     const namedPartners = (top as RenderableRecommendation).ambiguousWith;\n534:     const ambiguousWith: readonly string[] = Array.isArray(namedPartners) ? namedPartners : [];\n535:     const vs = (ambiguousWith.length > 0\n536:       ? recommendations.find((recommendation) => ambiguousWith.includes(recommendation.skill))\n537:       : undefined) ?? second;\n538:     const vsLabel = recommendationLabel(vs.skill);\n539:     if (!vsLabel && !isDoctorBridgeId(vs.skill)) {\n540:       observeAdvisorPolicy(null, options);\n541:       return null;\n542:     }\n543:     if (vsLabel) {\n544:       const head = `Advisor: ${result.freshness}; ambiguous: ${topLabel} `\n545:         + `${formatScore(top.confidence)}/${formatScore(top.uncertainty)} vs ${vsLabel} `\n546:         + `${formatScore(vs.confidence)}/${formatScore(vs.uncertainty)} pass.`;\n547:       const rendered = capWithCompanion(\n548:         head,\n549:         companionLine(vs.skill),\n550:         Math.min(tokenCap, AMBIGUOUS_TOKEN_CAP),\n551:       ) + DIRECTIVES_LABEL + HYGIENE_DIRECTIVE;\n552:       observeAdvisorPolicy(rendered, options);\n553:       return rendered;\n554:     }\n555:   }\n556: \n557:   const head = `Advisor: ${result.freshness}; use ${topLabel} `\n558:     + `${formatScore(top.confidence)}/${formatScore(top.uncertainty)} pass.`;\n559:   const rendered = capWithCompanion(\n560:     head,\n561:     companionLine(undefined),\n562:     Math.min(tokenCap, DEFAULT_TOKEN_CAP),\n563:   ) + DIRECTIVES_LABEL + HYGIENE_DIRECTIVE;\n564:   observeAdvisorPolicy(rendered, options);\n565:   return rendered;\n566: }\n567: \n568: /** Classify a result with no brief; no result at all means the advisor did not answer. */\n569: export function advisorFallbackCase(\n570:   result?: Pick<AdvisorHookResult, 'status' | 'freshness'>,\n571: ): AdvisorFallbackClassification {\n572:   if (!result || result.status === 'fail_open' || result.freshness === 'absent'\n573:     || (result.freshness === 'unavailable' && result.status !== 'skipped')) {\n574:     return {\n575:       fallbackCase: 'outage',\n576:       outageLabel: result?.freshness === 'absent'\n577:         ? 'absent'\n578:         : result?.status === 'degraded'\n579:           ? 'degraded'\n580:           : 'fail_open',\n581:     };\n582:   }\n583:   if (result.status === 'skipped' && result.freshness === 'unavailable') {\n584:     return { fallbackCase: 'skipped' };\n585:   }\n586:   return { fallbackCase: 'no-match' };\n587: }\n588: \n589: /** Render the fallback status and directive block when no advisor brief is available. */\n590: export function renderAdvisorFallbackDirective(\n591:   options: AdvisorBriefRenderOptions = {},\n592:   result?: Pick<AdvisorHookResult, 'status' | 'freshness'>,\n593: ): string {\n594:   const classification = advisorFallbackCase(result);\n595:   const head = classification.fallbackCase === 'outage'\n596:     ? `Advisor: outage (${classification.outageLabel});${options.setupWording === true ? ' for setup or health checks, run /doctor:setup;' : ''} route by hand: node .skilled/bin/skill-advisor.cjs advisor_recommend --json '{\"prompt\":\"<request>\"}' --format json`\n597:     : classification.fallbackCase === 'skipped'\n598:       ? 'Advisor: prompt skipped.'\n599:       : options.setupWording === true\n600:         ? `Advisor: no skill matched.${SETUP_HINT}`\n601:         : 'Advisor: no skill matched.';\n602:   const rendered = head + DIRECTIVES_LABEL + HYGIENE_DIRECTIVE;\n603:   observeAdvisorPolicy(rendered, options);\n604:   return rendered;\n605: }\n606: \n607: /** Render the outage fallback used when advisor execution times out or is unavailable. */\n608: export function renderAdvisorTimeoutFallback(\n609:   options: AdvisorBriefRenderOptions = {},\n[Output truncated. Continue reading with offset: 610]","title":"read","metadata":{"metadata":{"truncated":true},"content":[{"type":"text","text":"Read file .skilled/skills/system-skill-advisor/runtime/lib/render.ts, lines 470-609\n470: \n471: /**\n472:  * Render the model-visible advisor brief from typed advisor output only.\n473:  *\n474:  * The renderer is the prompt-boundary guard: it ignores free-form reasons,\n475:  * descriptions, stdout/stderr, and prompt text, and emits nothing when the\n476:  * repository-authored skill label looks instruction-shaped after folding.\n477:  */\n478: export function renderAdvisorBrief(\n479:   result: AdvisorBriefRenderableResult,\n480:   options: AdvisorBriefRenderOptions = {},\n481: ): string | null {\n482:   if (result.status !== 'ok') {\n483:     observeAdvisorPolicy(null, options);\n484:     return null;\n485:   }\n486:   if (result.freshness !== 'live' && result.freshness !== 'stale') {\n487:     observeAdvisorPolicy(null, options);\n488:     return null;\n489:   }\n490: \n491:   const tokenCap = clampTokenCap(result.metrics?.tokenCap ?? options.tokenCap);\n492:   const thresholdConfig = options.thresholdConfig;\n493:   const recommendations = result.recommendations.filter((recommendation) => (\n494:     recommendation.passes_threshold === true\n495:     || (\n496:       recommendation.confidence >= (thresholdConfig?.confidenceThreshold ?? resolvedConfidenceThreshold())\n497:       && (\n498:         thresholdConfig?.confidenceOnly === true\n499:         || recommendation.uncertainty <= (thresholdConfig?.uncertaintyThreshold ?? resolvedUncertaintyThreshold())\n500:       )\n501:     )\n502:   ));\n503:   const [top, second] = recommendations;\n504:   if (!top) {\n505:     observeAdvisorPolicy(null, options);\n506:     return null;\n507:   }\n508: \n509:   const topLabel = isDoctorBridgeId(top.skill)\n510:     ? doctorCommandString(top.skill)\n511:     : sanitizeSkillLabel(metadataSkillLabel(result) ?? top.skill);\n512:   if (!topLabel) {\n513:     observeAdvisorPolicy(null, options);\n514:     return null;\n515:   }\n516: \n517:   const companion = isDoctorBridgeId(top.skill)\n518:     ? undefined\n519:     : recommendations.slice(1).find((recommendation) => doctorCommandString(recommendation.skill) !== null);\n520:   const companionLabel = companion ? doctorCommandString(companion.skill) : null;\n521:   const companionLine = (shownSecond: string | undefined): string => (\n522:     companionLabel && companion && companion.skill !== shownSecond ? `\\nAlso: ${companionLabel}` : ''\n523:   );\n524:   const capWithCompanion = (head: string, companionText: string, cap: number): string => {\n525:     const companionFits = head.length + companionText.length <= cap * TOKEN_TO_CHAR_ESTIMATE;\n526:     return `${capText(head, cap)}${companionFits ? companionText : ''}`;\n527:   };\n528: \n529:   const precomputedAmbiguous = typeof result.ambiguous === 'boolean' ? result.ambiguous : undefined;\n530:   if (tokenCap > DEFAULT_TOKEN_CAP && second && hasAdvisorAmbiguitySignal(recommendations, precomputedAmbiguous)) {\n531:     // The scorer names its own tie partners, which can sit below the second passing\n532:     // entry, so prefer a named partner and fall back to the second entry.\n533:     const namedPartners = (top as RenderableRecommendation).ambiguousWith;\n534:     const ambiguousWith: readonly string[] = Array.isArray(namedPartners) ? namedPartners : [];\n535:     const vs = (ambiguousWith.length > 0\n536:       ? recommendations.find((recommendation) => ambiguousWith.includes(recommendation.skill))\n537:       : undefined) ?? second;\n538:     const vsLabel = recommendationLabel(vs.skill);\n539:     if (!vsLabel && !isDoctorBridgeId(vs.skill)) {\n540:       observeAdvisorPolicy(null, options);\n541:       return null;\n542:     }\n543:     if (vsLabel) {\n544:       const head = `Advisor: ${result.freshness}; ambiguous: ${topLabel} `\n545:         + `${formatScore(top.confidence)}/${formatScore(top.uncertainty)} vs ${vsLabel} `\n546:         + `${formatScore(vs.confidence)}/${formatScore(vs.uncertainty)} pass.`;\n547:       const rendered = capWithCompanion(\n548:         head,\n549:         companionLine(vs.skill),\n550:         Math.min(tokenCap, AMBIGUOUS_TOKEN_CAP),\n551:       ) + DIRECTIVES_LABEL + HYGIENE_DIRECTIVE;\n552:       observeAdvisorPolicy(rendered, options);\n553:       return rendered;\n554:     }\n555:   }\n556: \n557:   const head = `Advisor: ${result.freshness}; use ${topLabel} `\n558:     + `${formatScore(top.confidence)}/${formatScore(top.uncertainty)} pass.`;\n559:   const rendered = capWithCompanion(\n560:     head,\n561:     companionLine(undefined),\n562:     Math.min(tokenCap, DEFAULT_TOKEN_CAP),\n563:   ) + DIRECTIVES_LABEL + HYGIENE_DIRECTIVE;\n564:   observeAdvisorPolicy(rendered, options);\n565:   return rendered;\n566: }\n567: \n568: /** Classify a result with no brief; no result at all means the advisor did not answer. */\n569: export function advisorFallbackCase(\n570:   result?: Pick<AdvisorHookResult, 'status' | 'freshness'>,\n571: ): AdvisorFallbackClassification {\n572:   if (!result || result.status === 'fail_open' || result.freshness === 'absent'\n573:     || (result.freshness === 'unavailable' && result.status !== 'skipped')) {\n574:     return {\n575:       fallbackCase: 'outage',\n576:       outageLabel: result?.freshness === 'absent'\n577:         ? 'absent'\n578:         : result?.status === 'degraded'\n579:           ? 'degraded'\n580:           : 'fail_open',\n581:     };\n582:   }\n583:   if (result.status === 'skipped' && result.freshness === 'unavailable') {\n584:     return { fallbackCase: 'skipped' };\n585:   }\n586:   return { fallbackCase: 'no-match' };\n587: }\n588: \n589: /** Render the fallback status and directive block when no advisor brief is available. */\n590: export function renderAdvisorFallbackDirective(\n591:   options: AdvisorBriefRenderOptions = {},\n592:   result?: Pick<AdvisorHookResult, 'status' | 'freshness'>,\n593: ): string {\n594:   const classification = advisorFallbackCase(result);\n595:   const head = classification.fallbackCase === 'outage'\n596:     ? `Advisor: outage (${classification.outageLabel});${options.setupWording === true ? ' for setup or health checks, run /doctor:setup;' : ''} route by hand: node .skilled/bin/skill-advisor.cjs advisor_recommend --json '{\"prompt\":\"<request>\"}' --format json`\n597:     : classification.fallbackCase === 'skipped'\n598:       ? 'Advisor: prompt skipped.'\n599:       : options.setupWording === true\n600:         ? `Advisor: no skill matched.${SETUP_HINT}`\n601:         : 'Advisor: no skill matched.';\n602:   const rendered = head + DIRECTIVES_LABEL + HYGIENE_DIRECTIVE;\n603:   observeAdvisorPolicy(rendered, options);\n604:   return rendered;\n605: }\n606: \n607: /** Render the outage fallback used when advisor execution times out or is unavailable. */\n608: export function renderAdvisorTimeoutFallback(\n609:   options: AdvisorBriefRenderOptions = {},\n[Output truncated. Continue reading with offset: 610]"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"limit\":140,\"offset\":470,\"path\":\".skilled/skills/system-skill-advisor/runtime/lib/render.ts\"}"},"time":{"start":1794524447105,"end":1794524447532}}}}
