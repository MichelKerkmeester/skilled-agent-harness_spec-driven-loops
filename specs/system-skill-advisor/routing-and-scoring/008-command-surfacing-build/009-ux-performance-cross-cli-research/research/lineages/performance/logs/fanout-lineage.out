turn DEFAULT_TOKEN_CAP;\n181:   }\n182:   return Math.min(Math.max(1, Math.floor(tokenCap)), MAX_TOKEN_CAP);\n183: }\n184: \n185: function capText(text: string, tokenCap: number): string {\n186:   const charCap = tokenCap * TOKEN_TO_CHAR_ESTIMATE;\n187:   if (text.length <= charCap) {\n188:     return text;\n189:   }\n190:   const truncated = text.slice(0, Math.max(1, charCap - 3)).trimEnd();\n191:   return `${truncated}...`;\n192: }\n193: \n194: function sanitizeSkillLabel(skillLabel: string | null | undefined): string | null {\n195:   if (typeof skillLabel !== 'string') {\n196:     return null;\n197:   }\n198:   const folded = canonicalFold(skillLabel);\n199:   if (/[\\n\\r]/.test(folded)) {\n200:     return null;\n201:   }\n202:   const singleLine = folded\n203:     .replace(CONTROL_CHAR_PATTERN, '')\n204:     .replace(/\\s+/g, ' ')\n205:     .trim();\n206:   if (!singleLine || INSTRUCTION_LABEL_PATTERN.test(singleLine)) {\n207:     return null;\n208:   }\n209:   return singleLine;\n210: }\n211: \n212: const DOCTOR_BRIDGE_PREFIX = 'command-doctor-';\n213: \n214: function isDoctorBridgeId(skillId: string): boolean {\n215:   return skillId.startsWith(DOCTOR_BRIDGE_PREFIX);\n216: }\n217: \n218: /** Return the sanitized runnable doctor command for a doctor bridge id, or null when unmapped. */\n219: export function doctorCommandString(skillId: string): string | null {\n220:   if (!isDoctorBridgeId(skillId) || !Object.hasOwn(DOCTOR_COMMAND_STRINGS, skillId)) {\n221:     return null;\n222:   }\n223:   return sanitizeSkillLabel(DOCTOR_COMMAND_STRINGS[skillId]);\n224: }\n225: \n226: // A doctor bridge renders as its runnable command and never as its raw id; an\n227: // unmapped doctor id renders nothing.\n228: function recommendationLabel(skillId: string): string | null {\n229:   return isDoctorBridgeId(skillId) ? doctorCommandString(skillId) : sanitizeSkillLabel(skillId);\n230: }\n231: \n232: function formatScore(value: number): string {\n233:   return Number.isFinite(value) ? value.toFixed(2) : '0.00';\n234: }\n235: \n236: type RenderableRecommendation = AdvisorRecommendation & {\n237:   readonly score?: number;\n238:   readonly ambiguousWith?: readonly string[];\n239:   readonly heldBelow?: string;\n240: };\n241: \n242: function toScoredRecommendation(recommendation: RenderableRecommendation): AdvisorScoredRecommendation {\n243:   return {\n244:     skill: recommendation.skill,\n245:     kind: recommendation.kind === 'command' ? 'command' : 'skill',\n246:     confidence: recommendation.confidence,\n247:     uncertainty: recommendation.uncertainty,\n248:     passes_threshold: recommendation.passes_threshold ?? true,\n249:     reason: '',\n250:     score: typeof recommendation.score === 'number' && Number.isFinite(recommendation.score)\n251:       ? recommendation.score\n252:       : recommendation.confidence,\n253:     laneContributions: [],\n254:     dominantLane: null,\n255:     lifecycleStatus: 'active',\n256:     ...(Array.isArray(recommendation.ambiguousWith) ? { ambiguousWith: recommendation.ambiguousWith } : {}),\n257:     ...(typeof recommendation.heldBelow === 'string' ? { heldBelow: recommendation.heldBelow } : {}),\n258:   };\n259: }\n260: \n261: /**\n262:  * Detect whether the renderable recommendation set carries ambiguity evidence.\n263:  *\n264:  * `precomputedAmbiguous` carries the scorer's own verdict. It wins when defined: the\n265:  * scorer knows which skills a typed command held below the top and which only cleared\n266:  * a confidence floor, and serialized recommendations lose that context. Only when the\n267:  * caller has no verdict is ambiguity re-derived from the rendered fields.\n268:  */\n269: export function hasAdvisorAmbiguitySignal(\n270:   recommendations: readonly AdvisorRecommendation[],\n271:   precomputedAmbiguous?: boolean,\n272: ): boolean {\n273:   if (typeof precomputedAmbiguous === 'boolean') {\n274:     return precomputedAmbiguous;\n275:   }\n276:   return isAmbiguousTopTwo((recommendatio