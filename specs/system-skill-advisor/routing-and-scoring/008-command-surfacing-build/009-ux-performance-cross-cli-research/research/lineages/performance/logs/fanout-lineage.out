cache is process-local and exact-prompt keyed, so unique prompts miss at any TTL.\\\",iteration:1}\\n];\\nfs.writeFileSync(dir+\\\"/.gateway-events/iteration-001.json\\\",JSON.stringify(rec));\\nfs.writeFileSync(dir+\\\"/deltas/iter-001.jsonl\\\",[rec,...findings].map(r=>JSON.stringify(r)).join(\\\"\\\\n\\\")+\\\"\\\\n\\\");\\nconsole.log(\\\"wrote\\\",ts);\\n'\"}"},"time":{"start":1794524260919,"end":1794524274658}}}}
