{"type":"tool_use","timestamp":1794523792654,"sessionID":"ses_e2e0e4d38ffeP1JOC1np1mhw9O","part":{"partID":"prt_1d1f401cf0011L2QN8c97a21LB","sessionID":"ses_e2e0e4d38ffeP1JOC1np1mhw9O","messageID":"msg_1d1f3faef001yCLcPODiERoTFp","type":"tool","id":"call_2ed871a84eea40548198db57","tool":"read","state":{"status":"completed","input":{"path":"specs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/004-command-meaning-matching/scratch/hook-latency.mjs"},"output":"Read file specs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/004-command-meaning-matching/scratch/hook-latency.mjs, lines 1-172\n1: #!/usr/bin/env node\n2: // ───────────────────────────────────────────────────────────────────\n3: // MODULE: Claude prompt-hook latency probe\n4: // ───────────────────────────────────────────────────────────────────\n5: // Times the real UserPromptSubmit hook once per prompt and reports the\n6: // distribution on stdout. The hook self-limits to a few seconds per call,\n7: // so the probe runs strictly sequentially: parallel runs would contend for\n8: // the same advisor daemon and the same diagnostic store and would measure\n9: // queueing rather than per-prompt cost.\n10: // ───────────────────────────────────────────────────────────────────\n11: \n12: import { existsSync, readFileSync } from 'node:fs';\n13: import { spawnSync } from 'node:child_process';\n14: import { dirname, join, resolve } from 'node:path';\n15: import { fileURLToPath } from 'node:url';\n16: import { performance } from 'node:perf_hooks';\n17: \n18: // ───────────────────────────────────────────────────────────────────\n19: // 1. CONSTANTS\n20: // ───────────────────────────────────────────────────────────────────\n21: \n22: const HOOK_REL = '.skilled/skills/system-spec-kit/runtime/dist/hooks/claude/user-prompt-submit.js';\n23: // The hook emits diagnostics on stderr that dwarf the prompt; keep the cap\n24: // generous enough that a verbose run cannot be reported as OUTPUT_OVERFLOW.\n25: const MAX_STDIO_BYTES = 16 * 1024 * 1024;\n26: const HOOK_TIMEOUT_MS = 30_000;\n27: const MAX_ROOT_WALK_DEPTH = 14;\n28: \n29: // ───────────────────────────────────────────────────────────────────\n30: // 2. PATH RESOLUTION\n31: // ───────────────────────────────────────────────────────────────────\n32: \n33: // Anchor every path to this module's own location. The probe is launched from\n34: // arbitrary working directories by orchestrators, so a CWD-relative path would\n35: // find the wrong checkout or nothing at all.\n36: const scriptDir = dirname(fileURLToPath(import.meta.url));\n37: const rowsPath = join(scriptDir, 'tune-rows.jsonl');\n38: \n39: function findRepoRoot() {\n40:   let current = scriptDir;\n41:   for (let depth = 0; depth < MAX_ROOT_WALK_DEPTH; depth += 1) {\n42:     if (existsSync(join(current, HOOK_REL))) {\n43:       return current;\n44:     }\n45:     const parent = dirname(current);\n46:     if (parent === current) {\n47:       break;\n48:     }\n49:     current = parent;\n50:   }\n51:   return null;\n52: }\n53: \n54: function fail(message) {\n55:   process.stderr.write(`${message}\\n`);\n56:   process.exit(2);\n57: }\n58: \n59: const repoRoot = findRepoRoot();\n60: if (!repoRoot) {\n61:   fail(`hook file not found: walked up from ${scriptDir} for ${HOOK_REL}`);\n62: }\n63: const hookPath = resolve(repoRoot, HOOK_REL);\n64: if (!existsSync(hookPath)) {\n65:   fail(`hook file missing: ${hookPath}`);\n66: }\n67: if (!existsSync(rowsPath)) {\n68:   fail(`rows file missing: ${rowsPath}`);\n69: }\n70: \n71: // ───────────────────────────────────────────────────────────────────\n72: // 3. ROW LOADING\n73: // ───────────────────────────────────────────────────────────────────\n74: \n75: // Blank lines and non-object records are skipped rather than thrown: the prompt\n76: // corpus is hand-maintained and one malformed row must not void a full run.\n77: function loadPrompts(path) {\n78:   const prompts = [];\n79:   const lines = readFileSync(path, 'utf8').split('\\n');\n80:   for (const line of lines) {\n81:     const trimmed = line.trim();\n82:     if (!trimmed) continue;\n83:     try {\n84:       const parsed = JSON.parse(trimmed);\n85:       if (parsed && typeof parsed.prompt === 'string') {\n86:         prompts.push(parsed.prompt);\n87:       }\n88:     } catch {\n89:       // Unparseable row: skip.\n90:     }\n91:   }\n92:   return prompts;\n93: }\n94: \n95: // ───────────────────────────────────────────────────────────────────\n96: // 4. MEASUREMENT\n97: // ───────────────────────────────────────────────────────────────────\n98: \n99: // The hook reads one JSON object off stdin and ignores argv. Field names mirror\n100: // what the hook source actually reads: prompt, cwd, hook_event_name, session_id.\n101: function buildStdin(prompt) {\n102:   return JSON.stringify({\n103:     prompt,\n104:     cwd: repoRoot,\n105:     hook_event_name: 'UserPromptSubmit',\n106:     session_id: 'latency-probe',\n107:   });\n108: }\n109: \n110: const prompts = loadPrompts(rowsPath);\n111: const durations = [];\n112: let nonZeroExits = 0;\n113: let emptyOutputs = 0;\n114: \n115: for (const prompt of prompts) {\n116:   const startedAt = performance.now();\n117:   const result = spawnSync(process.execPath, [hookPath], {\n118:     cwd: repoRoot,\n119:     input: buildStdin(prompt),\n120:     encoding: 'utf8',\n121:     timeout: HOOK_TIMEOUT_MS,\n122:     maxBuffer: MAX_STDIO_BYTES,\n123:     killSignal: 'SIGKILL',\n124:   });\n125:   durations.push(performance.now() - startedAt);\n126: \n127:   // A null status means the process was killed, timed out or never spawned;\n128:   // that is not a clean exit either, so it counts alongside a non-zero code.\n129:   if (result.status !== 0) {\n130:     nonZeroExits += 1;\n131:   }\n132:   const stdout = typeof result.stdout === 'string' ? result.stdout.trim() : '';\n133:   if (!stdout) {\n134:     emptyOutputs += 1;\n135:   }\n136: }\n137: \n138: // ───────────────────────────────────────────────────────────────────\n139: // 5. SUMMARY\n140: // ───────────────────────────────────────────────────────────────────\n141: \n142: function round(value) {\n143:   return Math.round(value * 100) / 100;\n144: }\n145: \n146: function median(sorted) {\n147:   const midpoint = Math.floor(sorted.length / 2);\n148:   return sorted.length % 2 === 1\n149:     ? sorted[midpoint]\n150:     : (sorted[midpoint - 1] + sorted[midpoint]) / 2;\n151: }\n152: \n153: // Nearest-rank percentile: the smallest value at or above the requested rank.\n154: // With small sample counts an interpolated percentile would report a duration\n155: // that was never actually observed.\n156: function percentile(sorted, fraction) {\n157:   const rank = Math.ceil(fraction * sorted.length) - 1;\n158:   return sorted[Math.min(Math.max(rank, 0), sorted.length - 1)];\n159: }\n160: \n161: const sorted = [...durations].sort((left, right) => left - right);\n162: const summary = {\n163:   n: durations.length,\n164:   medianMs: sorted.length ? round(median(sorted)) : 0,\n165:   p95Ms: sorted.length ? round(percentile(sorted, 0.95)) : 0,\n166:   minMs: sorted.length ? round(sorted[0]) : 0,\n167:   maxMs: sorted.length ? round(sorted[sorted.length - 1]) : 0,\n168:   nonZeroExits,\n169:   emptyOutputs,\n170: };\n171: \n172: process.stdout.write(`${JSON.stringify(summary)}\\n`);","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file specs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/004-command-meaning-matching/scratch/hook-latency.mjs, lines 1-172\n1: #!/usr/bin/env node\n2: // ───────────────────────────────────────────────────────────────────\n3: // MODULE: Claude prompt-hook latency probe\n4: // ───────────────────────────────────────────────────────────────────\n5: // Times the real UserPromptSubmit hook once per prompt and reports the\n6: // distribution on stdout. The hook self-limits to a few seconds per call,\n7: // so the probe runs strictly sequentially: parallel runs would contend for\n8: // the same advisor daemon and the same diagnostic store and would measure\n9: // queueing rather than per-prompt cost.\n10: // ───────────────────────────────────────────────────────────────────\n11: \n12: import { existsSync, readFileSync } from 'node:fs';\n13: import { spawnSync } from 'node:child_process';\n14: import { dirname, join, resolve } from 'node:path';\n15: import { fileURLToPath } from 'node:url';\n16: import { performance } from 'node:perf_hooks';\n17: \n18: // ───────────────────────────────────────────────────────────────────\n19: // 1. CONSTANTS\n20: // ───────────────────────────────────────────────────────────────────\n21: \n22: const HOOK_REL = '.skilled/skills/system-spec-kit/runtime/dist/hooks/claude/user-prompt-submit.js';\n23: // The hook emits diagnostics on stderr that dwarf the prompt; keep the cap\n24: // generous enough that a verbose run cannot be reported as OUTPUT_OVERFLOW.\n25: const MAX_STDIO_BYTES = 16 * 1024 * 1024;\n26: const HOOK_TIMEOUT_MS = 30_000;\n27: const MAX_ROOT_WALK_DEPTH = 14;\n28: \n29: // ───────────────────────────────────────────────────────────────────\n30: // 2. PATH RESOLUTION\n31: // ───────────────────────────────────────────────────────────────────\n32: \n33: // Anchor every path to this module's own location. The probe is launched from\n34: // arbitrary working directories by orchestrators, so a CWD-relative path would\n35: // find the wrong checkout or nothing at all.\n36: const scriptDir = dirname(fileURLToPath(import.meta.url));\n37: const rowsPath = join(scriptDir, 'tune-rows.jsonl');\n38: \n39: function findRepoRoot() {\n40:   let current = scriptDir;\n41:   for (let depth = 0; depth < MAX_ROOT_WALK_DEPTH; depth += 1) {\n42:     if (existsSync(join(current, HOOK_REL))) {\n43:       return current;\n44:     }\n45:     const parent = dirname(current);\n46:     if (parent === current) {\n47:       break;\n48:     }\n49:     current = parent;\n50:   }\n51:   return null;\n52: }\n53: \n54: function fail(message) {\n55:   process.stderr.write(`${message}\\n`);\n56:   process.exit(2);\n57: }\n58: \n59: const repoRoot = findRepoRoot();\n60: if (!repoRoot) {\n61:   fail(`hook file not found: walked up from ${scriptDir} for ${HOOK_REL}`);\n62: }\n63: const hookPath = resolve(repoRoot, HOOK_REL);\n64: if (!existsSync(hookPath)) {\n65:   fail(`hook file missing: ${hookPath}`);\n66: }\n67: if (!existsSync(rowsPath)) {\n68:   fail(`rows file missing: ${rowsPath}`);\n69: }\n70: \n71: // ───────────────────────────────────────────────────────────────────\n72: // 3. ROW LOADING\n73: // ───────────────────────────────────────────────────────────────────\n74: \n75: // Blank lines and non-object records are skipped rather than thrown: the prompt\n76: // corpus is hand-maintained and one malformed row must not void a full run.\n77: function loadPrompts(path) {\n78:   const prompts = [];\n79:   const lines = readFileSync(path, 'utf8').split('\\n');\n80:   for (const line of lines) {\n81:     const trimmed = line.trim();\n82:     if (!trimmed) continue;\n83:     try {\n84:       const parsed = JSON.parse(trimmed);\n85:       if (parsed && typeof parsed.prompt === 'string') {\n86:         prompts.push(parsed.prompt);\n87:       }\n88:     } catch {\n89:       // Unparseable row: skip.\n90:     }\n91:   }\n92:   return prompts;\n93: }\n94: \n95: // ───────────────────────────────────────────────────────────────────\n96: // 4. MEASUREMENT\n97: // ───────────────────────────────────────────────────────────────────\n98: \n99: // The hook reads one JSON object off stdin and ignores argv. Field names mirror\n100: // what the hook source actually reads: prompt, cwd, hook_event_name, session_id.\n101: function buildStdin(prompt) {\n102:   return JSON.stringify({\n103:     prompt,\n104:     cwd: repoRoot,\n105:     hook_event_name: 'UserPromptSubmit',\n106:     session_id: 'latency-probe',\n107:   });\n108: }\n109: \n110: const prompts = loadPrompts(rowsPath);\n111: const durations = [];\n112: let nonZeroExits = 0;\n113: let emptyOutputs = 0;\n114: \n115: for (const prompt of prompts) {\n116:   const startedAt = performance.now();\n117:   const result = spawnSync(process.execPath, [hookPath], {\n118:     cwd: repoRoot,\n119:     input: buildStdin(prompt),\n120:     encoding: 'utf8',\n121:     timeout: HOOK_TIMEOUT_MS,\n122:     maxBuffer: MAX_STDIO_BYTES,\n123:     killSignal: 'SIGKILL',\n124:   });\n125:   durations.push(performance.now() - startedAt);\n126: \n127:   // A null status means the process was killed, timed out or never spawned;\n128:   // that is not a clean exit either, so it counts alongside a non-zero code.\n129:   if (result.status !== 0) {\n130:     nonZeroExits += 1;\n131:   }\n132:   const stdout = typeof result.stdout === 'string' ? result.stdout.trim() : '';\n133:   if (!stdout) {\n134:     emptyOutputs += 1;\n135:   }\n136: }\n137: \n138: // ───────────────────────────────────────────────────────────────────\n139: // 5. SUMMARY\n140: // ───────────────────────────────────────────────────────────────────\n141: \n142: function round(value) {\n143:   return Math.round(value * 100) / 100;\n144: }\n145: \n146: function median(sorted) {\n147:   const midpoint = Math.floor(sorted.length / 2);\n148:   return sorted.length % 2 === 1\n149:     ? sorted[midpoint]\n150:     : (sorted[midpoint - 1] + sorted[midpoint]) / 2;\n151: }\n152: \n153: // Nearest-rank percentile: the smallest value at or above the requested rank.\n154: // With small sample counts an interpolated percentile would report a duration\n155: // that was never actually observed.\n156: function percentile(sorted, fraction) {\n157:   const rank = Math.ceil(fraction * sorted.length) - 1;\n158:   return sorted[Math.min(Math.max(rank, 0), sorted.length - 1)];\n159: }\n160: \n161: const sorted = [...durations].sort((left, right) => left - right);\n162: const summary = {\n163:   n: durations.length,\n164:   medianMs: sorted.length ? round(median(sorted)) : 0,\n165:   p95Ms: sorted.length ? round(percentile(sorted, 0.95)) : 0,\n166:   minMs: sorted.length ? round(sorted[0]) : 0,\n167:   maxMs: sorted.length ? round(sorted[sorted.length - 1]) : 0,\n168:   nonZeroExits,\n169:   emptyOutputs,\n170: };\n171: \n172: process.stdout.write(`${JSON.stringify(summary)}\\n`);"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\"specs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/004-command-meaning-matching/scratch/hook-latency.mjs\"}"},"time":{"start":1794523791823,"end":1794523792654}}}}
