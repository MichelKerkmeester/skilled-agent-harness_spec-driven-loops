63:   const tokenCap = Math.min(Math.max(1, Math.floor(args.options.maxTokens ?? (ambiguous === true ? 120 : 80))), 120);\n464:   const status = resultStatus(freshness, recommendations);\n465:   const warnings = Array.isArray(args.data.warnings)\n466:     ? args.data.warnings.filter((value): value is string => typeof value === 'string')\n467:     : [];\n468:   // A live or stale advisor that returned nothing above the threshold answered\n469:   // the question; it simply had no skill to name. Reporting that as an outage\n470:   // sends a reader hunting a transport failure that never happened, which has\n471:   // already cost one long investigation.\n472:   const answeredWithNoMatch = freshness === 'live' || freshness === 'stale';\n473:   const reason = status === 'ok'\n474:     ? 'ok'\n475:     : answeredWithNoMatch\n476:       ? 'no_recommendation'\n477:       : (freshness === 'absent' ? 'advisor_absent' : 'advisor_unavailable');\n478:   const hookResult: CliFallbackHookResult = {\n479:     status,\n480:     freshness,\n481:     brief: null,\n482:     recommendations,\n483:     ...(ambiguous === undefined ? {} : { ambiguous }),\n484:     diagnostics: status === 'ok'\n485:       ? (freshness === 'stale' && warnings[0] ? { staleReason: warnings[0] } : null)\n486:       : answeredWithNoMatch\n487:         ? {\n488:           // No error code or class: nothing failed, so naming a failure class\n489:           // here is what made this look like an outage in the first place.\n490:           reason: 'no_recommendation',\n491:           errorMessage: 'CLI_ADVISOR_NO_MATCH',\n492:         }\n493:         : {\n494:           errorCode: 'NON_ZERO_EXIT',\n495:           errorClass: 'unknown',\n496:           errorMessage: freshness === 'absent' ? 'CLI_ADVISOR_ABSENT' : 'CLI_ADVISOR_UNAVAILABLE',\n497:         },\n498:     metrics: {\n499:       durationMs: Number((args.now() - args.startedAt).toFixed(3)),\n500:       cacheHit: cacheHitFrom(args.data),\n501:       subprocess