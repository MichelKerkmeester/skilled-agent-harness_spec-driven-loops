\n2273:           Preserve machine-owned markers so the reducer-owned registry, dashboard, and strategy anchors can be refreshed on re-run without mutating prior synthesis. (Note: `completed-continue` lineage branch is deferred — see `deep-research/references/protocol/loop-protocol.md §Lifecycle Branch Contract`.)\n2274:         output: \"{state_paths.research_output}\"\n2275: \n2276:       step_convergence_report:\n2277:         action: \"Generate and append convergence report\"\n2278:         report: |\n2279:           ## Convergence Report\n2280:           - Stop reason: {reason}\n2281:           - Total iterations: {iteration_count}\n2282:           - Questions answered: {answered_count} / {total_questions}\n2283:           - Remaining questions: {remaining_questions}\n2284:           - Last 3 iteration summaries: {last_3_summaries}\n2285:           - Convergence threshold: {convergence_threshold}\n2286:           - Divergence summary: {divergence_summary}\n2287:           - Segment transitions, wave scores, and checkpoint metrics are experimental and omitted from the live report.\n2288:         command: |\n2289:           GATEWAY=\".skilled/skills/system-deep-loop/runtime/scripts/append-mode-event.cjs\"\n2290:           [ -f \"$GATEWAY\" ] || GATEWAY=\"scripts/append-mode-event.cjs\"\n2291:           EVENT_DIR=\"$(mktemp -d \"${TMPDIR:-/tmp}/deep-research-synthesis.XXXXXX\")\"\n2292:           CLOSEOUT=\".skilled/skills/system-deep-loop/runtime/scripts/synthesis-closeout.cjs\"\n2293:           [ -f \"$CLOSEOUT\" ] || CLOSEOUT=\"scripts/synthesis-closeout.cjs\"\n2294:           node \"$CLOSEOUT\" --mode research --event-dir \"$EVENT_DIR\" \\\n2295:             --artifact-dir \"{state_paths.packet_dir}\" \\\n2296:             --state-log \"{state_paths.state_log}\" \\\n2297:             --registry \"{state_paths.registry}\" \\\n2298:             --output \"{state_paths.research_output}\" \\\n2299:             --dashboard \"{state_paths.dashboard}\" \\\n2300:             --stop-reason \"{reason}\" \\\n2301:             --answered-count \"{answered_count}\" --total-questions \"{total_questions}\"\n2302:           NODE_STATUS=$?\n2303:           for eventFile in \"$EVENT_DIR\"/*.json; do\n2304:             [ -e \"$eventFile\" ] || continue\n2305:             node \"$GATEWAY\" --mode research --run-directory \"$(dirname \"{state_paths.state_log}\")\" --event-json \"$eventFile\"\n2306:             GATEWAY_STATUS=$?\n2307:             if [ \"$GATEWAY_STATUS\" -ne 0 ]; then\n2308:               rm -rf \"$EVENT_DIR\"\n2309:               exit \"$GATEWAY_STATUS\"\n2310:             fi\n2311:           done\n2312:           rm -rf \"$EVENT_DIR\"\n2313:           exit \"$NODE_STATUS\"\n2314: \n2315:       step_writeback_spec_findings:\n2316:         action: \"Write or replace the bounded generated findings block in spec.md before config completion\"\n2317:         edit: \"{spec_folder}/spec.md\"\n2318:         host_anchor: \"Use the chosen host anchor required by spec_check_protocol\"\n2319:         generated_fence_begin: \"<!-- BEGIN GENERATED: deep-research/spec-findings -->\"\n2320:         generated_fence_end: \"<!-- END GENERATED: deep-research/spec-findings -->\"\n2321:         fail_closed_conflict_check:\n2322:           if_existing_generated_fence_present:\n2323:             detect_manual_edits: \"Use generated checksum metadata or an explicit MANUAL-EDIT marker inside the existing fence to detect human edits before overwrite.\"\n2324:             on_manual_edit_conflict:\n2325:               append_to_jsonl: '{\"type\":\"spec_mutation\",\"event\":\"spec_mutation_conflict\",\"folder_state\":\"conflict-detected\",\"reason\":\"Manual edits detected inside existing generated findings fence.\",\"specPath\":\"{spec_folder}/spec.md\",\"generatedFence\":\"deep-research/spec-findings\",\"conflictKind\":\"generated-fence-manual-edit\",\"timestamp\":\"{ISO_8601_NOW}\"}'\n2326:               halt: true\n2327:         instructions:\n2328: