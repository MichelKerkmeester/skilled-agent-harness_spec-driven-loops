{\n60:   return JSON.stringify({\n61:     confidenceThreshold: thresholdConfig?.confidenceThreshold ?? resolvedConfidenceThreshold(),\n62:     uncertaintyThreshold: thresholdConfig?.uncertaintyThreshold ?? resolvedUncertaintyThreshold(),\n63:     confidenceOnly: thresholdConfig?.confidenceOnly ?? false,\n64:     showRejections: thresholdConfig?.showRejections ?? false,\n65:     includeAttribution: thresholdConfig?.includeAttribution ?? false,\n66:     includeAbstainReasons: thresholdConfig?.includeAbstainReasons ?? false,\n67:   });\n68: }\n69: \n70: function normalizeMaxTokens(maxTokens: number | undefined): number {\n71:   if (typeof maxTokens !== 'number' || Number.isNaN(maxTokens)) {\n72:     return ADVISOR_PROMPT_CACHE_DEFAULT_MAX_TOKENS;\n73:   }\n74:   return Math.min(\n75:     Math.max(1, Math.floor(maxTokens)),\n76:     ADVISOR_PROMPT_CACHE_MAX_TOKENS,\n77:   );\n78: }\n79: \n80: /** Build an opaque HMAC key for exact prompt-cache lookups. */\n81: export function createAdvisorPromptCacheKey(\n82:   parts: AdvisorPromptCacheKeyParts,\n83:   secret: Buffer = DEFAULT_SECRET,\n84: ): string {\n85:   const payload = [\n86:     parts.canonicalPrompt,\n87:     parts.sourceSignature,\n88:     parts.workspaceRoot ?? '',\n89:     parts.runtime,\n90:     String(normalizeMaxTokens(parts.maxTokens)),\n91:     stableThresholdConfig(parts.thresholdConfig),\n92:   ].join('\\u001f');\n93:   return createHmac('sha256', secret).update(payload).digest('hex');\n94: }\n95: \n96: // ───────────────────────────────────────────────────────────────────\n97: // 5. CORE LOGIC\n98: // ───────────────────────────────────────────────────────────────────\n99: /** In-memory exact cache for advisor briefs scoped to one host process. */\n100: export class AdvisorPromptCache<T> {\n101:   private readonly entries = new Map<string, AdvisorPromptCacheEntry<T>>();\n102: \n103:   constructor(\n104:     private readonly ttlMs: number = ADVISOR_PROMPT_CACHE_TTL_MS,\n105:     private readonly secret: