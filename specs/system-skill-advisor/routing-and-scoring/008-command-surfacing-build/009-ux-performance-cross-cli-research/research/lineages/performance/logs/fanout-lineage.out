= mode.trim();\n  if (trimmed === 'research' || trimmed === 'deep-research') return 'deep-research';\n  if (trimmed === 'review' || trimmed === 'deep-review') return 'deep-review';\n  if (trimmed === 'ai-council' || trimmed === 'council' || trimmed === 'deep-ai-council' || trimmed === 'deep-council') return 'deep-ai-council';\n  return trimmed;\n}\n\nasync function resolveModeAdapter(mode) {\n  const normalized = normalizeMode(mode);\n  switch (normalized) {\n    case 'deep-research': {\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"cd /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research && sed -n '1,120p' .skilled/skills/system-deep-loop/runtime/scripts/append-mode-event.cjs\"}"},"time":{"start":1794524134805,"end":1794524135379}}}}
