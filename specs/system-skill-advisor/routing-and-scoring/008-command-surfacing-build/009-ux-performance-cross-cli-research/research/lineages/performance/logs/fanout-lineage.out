{"type":"tool_use","timestamp":1794524082918,"sessionID":"ses_e2e0e4d38ffeP1JOC1np1mhw9O","part":{"partID":"prt_1d1f872da0011zBzWYoxynvI4p","sessionID":"ses_e2e0e4d38ffeP1JOC1np1mhw9O","messageID":"msg_1d1f86964001KicHL2SKxCvpJA","type":"tool","id":"call_25adec462d534bd2834c6ba6","tool":"read","state":{"status":"completed","input":{"path":".skilled/skills/system-skill-advisor/runtime/lib/prompt-policy.ts"},"output":"Read file .skilled/skills/system-skill-advisor/runtime/lib/prompt-policy.ts, lines 1-221\n1: // ───────────────────────────────────────────────────────────────\n2: // MODULE: Skill Advisor Prompt Policy\n3: // ───────────────────────────────────────────────────────────────\n4: \n5: // ───────────────────────────────────────────────────────────────────\n6: // 1. IMPORTS\n7: // ───────────────────────────────────────────────────────────────────\n8: \n9: import { canonicalFold } from './shared/unicode-normalization.js';\n10: import { readFileSync } from 'node:fs';\n11: import { join, dirname } from 'node:path';\n12: import { fileURLToPath } from 'node:url';\n13: \n14: const __filename = fileURLToPath(import.meta.url);\n15: const __dirname = dirname(__filename);\n16: \n17: // ───────────────────────────────────────────────────────────────────\n18: // 2. TYPE DEFINITIONS\n19: // ───────────────────────────────────────────────────────────────────\n20: \n21: interface PromptPolicyConfig {\n22:   sets: {\n23:     EXACT_SKIP_COMMANDS: string[];\n24:     CASUAL_ACKNOWLEDGEMENTS: string[];\n25:     WORK_INTENT_VERBS: string[];\n26:     STOP_WORDS: string[];\n27:     GOVERNANCE_MARKERS: string[];\n28:   };\n29:   thresholds: {\n30:     MIN_VISIBLE_CHARS: number;\n31:     MIN_MEANINGFUL_TOKENS: number;\n32:     LENGTH_AND_TOKEN_VISIBLE_CHARS: number;\n33:     LENGTH_AND_TOKEN_MEANINGFUL_FLOOR: number;\n34:     LONG_NON_CASUAL_CHARS: number;\n35:   };\n36: }\n37: \n38: // ───────────────────────────────────────────────────────────────────\n39: // 3. POLICY CONFIG\n40: // ───────────────────────────────────────────────────────────────────\n41: \n42: const policyJsonPath = process.env.SPECKIT_ADVISOR_PROMPT_POLICY_PATH\n43:   ?? join(__dirname, '..', 'data', 'prompt-policy.default.json');\n44: \n45: function loadPolicyConfig(): PromptPolicyConfig {\n46:   const raw = readFileSync(policyJsonPath, 'utf-8');\n47:   return JSON.parse(raw) as PromptPolicyConfig;\n48: }\n49: \n50: const policyConfig = loadPolicyConfig();\n51: \n52: const EXACT_SKIP_COMMANDS = new Set(policyConfig.sets.EXACT_SKIP_COMMANDS);\n53: const CASUAL_ACKNOWLEDGEMENTS = new Set(policyConfig.sets.CASUAL_ACKNOWLEDGEMENTS);\n54: const WORK_INTENT_VERBS = new Set(policyConfig.sets.WORK_INTENT_VERBS);\n55: const STOP_WORDS = new Set(policyConfig.sets.STOP_WORDS);\n56: const GOVERNANCE_MARKERS = policyConfig.sets.GOVERNANCE_MARKERS;\n57: \n58: function resolveNumericThreshold(envName: string, defaultValue: number): number {\n59:   const raw = process.env[envName];\n60:   if (raw === undefined) return defaultValue;\n61:   const parsed = parseInt(raw, 10);\n62:   if (isNaN(parsed)) return defaultValue;\n63:   return parsed;\n64: }\n65: \n66: const MIN_VISIBLE_CHARS = resolveNumericThreshold('SPECKIT_ADVISOR_PROMPT_POLICY_MIN_VISIBLE_CHARS', policyConfig.thresholds.MIN_VISIBLE_CHARS);\n67: const MIN_MEANINGFUL_TOKENS = resolveNumericThreshold('SPECKIT_ADVISOR_PROMPT_POLICY_MEANINGFUL_TOKEN_FLOOR', policyConfig.thresholds.MIN_MEANINGFUL_TOKENS);\n68: const LENGTH_AND_TOKEN_VISIBLE_CHARS = resolveNumericThreshold('SPECKIT_ADVISOR_PROMPT_POLICY_LENGTH_AND_TOKEN_VISIBLE_CHARS', policyConfig.thresholds.LENGTH_AND_TOKEN_VISIBLE_CHARS);\n69: const LENGTH_AND_TOKEN_MEANINGFUL_FLOOR = resolveNumericThreshold('SPECKIT_ADVISOR_PROMPT_POLICY_LENGTH_AND_TOKEN_MEANINGFUL_FLOOR', policyConfig.thresholds.LENGTH_AND_TOKEN_MEANINGFUL_FLOOR);\n70: const LONG_NON_CASUAL_CHARS = resolveNumericThreshold('SPECKIT_ADVISOR_PROMPT_POLICY_LONG_NON_CASUAL_CHARS', policyConfig.thresholds.LONG_NON_CASUAL_CHARS);\n71: \n72: // ───────────────────────────────────────────────────────────────────\n73: // 4. RESULT TYPE\n74: // ───────────────────────────────────────────────────────────────────\n75: \n76: export interface AdvisorPromptPolicyResult {\n77:   readonly fire: boolean;\n78:   readonly reason: string;\n79:   readonly canonicalPrompt: string;\n80:   readonly meaningfulTokenCount: number;\n81:   readonly visibleCharCount: number;\n82:   readonly metalinguisticMentions: string[];\n83: }\n84: \n85: // ───────────────────────────────────────────────────────────────────\n86: // 5. HELPERS\n87: // ───────────────────────────────────────────────────────────────────\n88: \n89: function normalizePrompt(prompt: string): string {\n90:   return canonicalFold(prompt).replace(/\\s+/g, ' ').trim();\n91: }\n92: \n93: function tokenize(prompt: string): string[] {\n94:   return prompt\n95:     .toLowerCase()\n96:     .match(/[a-z0-9][a-z0-9_-]*/g) ?? [];\n97: }\n98: \n99: function meaningfulTokens(tokens: string[]): string[] {\n100:   return tokens.filter((token) => token.length > 0 && !STOP_WORDS.has(token));\n101: }\n102: \n103: function hasExplicitMarker(canonicalLower: string): boolean {\n104:   return /\\bsk-[a-z0-9][a-z0-9-]*\\b/.test(canonicalLower)\n105:     || /(?:^|\\s)\\/[a-z][a-z0-9:_-]*/.test(canonicalLower)\n106:     || GOVERNANCE_MARKERS.some((marker) => canonicalLower.includes(marker));\n107: }\n108: \n109: function hasWorkIntentVerb(tokens: string[]): boolean {\n110:   return tokens.some((token) => WORK_INTENT_VERBS.has(token));\n111: }\n112: \n113: // ───────────────────────────────────────────────────────────────────\n114: // 6. CORE LOGIC\n115: // ───────────────────────────────────────────────────────────────────\n116: \n117: /** Extract explicit `sk-*` mentions used for prompt-policy diagnostics. */\n118: export function extractMetalinguisticSkillMentions(prompt: string): string[] {\n119:   const canonicalLower = normalizePrompt(prompt).toLowerCase();\n120:   return [...new Set(canonicalLower.match(/\\bsk-[a-z0-9][a-z0-9-]*\\b/g) ?? [])].sort();\n121: }\n122: \n123: /** Decide whether a user prompt should invoke the advisor producer. */\n124: export function shouldFireAdvisor(prompt: string): AdvisorPromptPolicyResult {\n125:   const canonicalPrompt = normalizePrompt(prompt);\n126:   const canonicalLower = canonicalPrompt.toLowerCase();\n127:   const tokens = tokenize(canonicalPrompt);\n128:   const meaningful = meaningfulTokens(tokens);\n129:   const visibleCharCount = canonicalPrompt.length;\n130:   const metalinguisticMentions = extractMetalinguisticSkillMentions(canonicalPrompt);\n131: \n132:   if (visibleCharCount === 0) {\n133:     return {\n134:       fire: false,\n135:       reason: 'empty_prompt',\n136:       canonicalPrompt,\n137:       meaningfulTokenCount: 0,\n138:       visibleCharCount,\n139:       metalinguisticMentions,\n140:     };\n141:   }\n142: \n143:   if (EXACT_SKIP_COMMANDS.has(canonicalLower)) {\n144:     return {\n145:       fire: false,\n146:       reason: 'skip_command',\n147:       canonicalPrompt,\n148:       meaningfulTokenCount: meaningful.length,\n149:       visibleCharCount,\n150:       metalinguisticMentions,\n151:     };\n152:   }\n153: \n154:   const explicitMarker = hasExplicitMarker(canonicalLower);\n155:   const workIntent = hasWorkIntentVerb(tokens);\n156:   const casual = CASUAL_ACKNOWLEDGEMENTS.has(canonicalLower);\n157: \n158:   if (!explicitMarker && !workIntent && visibleCharCount <= MIN_VISIBLE_CHARS && casual) {\n159:     return {\n160:       fire: false,\n161:       reason: 'short_casual_acknowledgement',\n162:       canonicalPrompt,\n163:       meaningfulTokenCount: meaningful.length,\n164:       visibleCharCount,\n165:       metalinguisticMentions,\n166:     };\n167:   }\n168: \n169:   if (explicitMarker) {\n170:     return {\n171:       fire: true,\n172:       reason: 'explicit_skill_or_governance_marker',\n173:       canonicalPrompt,\n174:       meaningfulTokenCount: meaningful.length,\n175:       visibleCharCount,\n176:       metalinguisticMentions,\n177:     };\n178:   }\n179: \n180:   if (workIntent && meaningful.length >= MIN_MEANINGFUL_TOKENS) {\n181:     return {\n182:       fire: true,\n183:       reason: 'work_intent_with_meaningful_tokens',\n184:       canonicalPrompt,\n185:       meaningfulTokenCount: meaningful.length,\n186:       visibleCharCount,\n187:       metalinguisticMentions,\n188:     };\n189:   }\n190: \n191:   if (visibleCharCount >= LENGTH_AND_TOKEN_VISIBLE_CHARS && meaningful.length >= LENGTH_AND_TOKEN_MEANINGFUL_FLOOR) {\n192:     return {\n193:       fire: true,\n194:       reason: 'length_and_token_threshold',\n195:       canonicalPrompt,\n196:       meaningfulTokenCount: meaningful.length,\n197:       visibleCharCount,\n198:       metalinguisticMentions,\n199:     };\n200:   }\n201: \n202:   if (visibleCharCount >= LONG_NON_CASUAL_CHARS && !casual) {\n203:     return {\n204:       fire: true,\n205:       reason: 'long_non_casual_prompt',\n206:       canonicalPrompt,\n207:       meaningfulTokenCount: meaningful.length,\n208:       visibleCharCount,\n209:       metalinguisticMentions,\n210:     };\n211:   }\n212: \n213:   return {\n214:     fire: false,\n215:     reason: 'below_prompt_policy_threshold',\n216:     canonicalPrompt,\n217:     meaningfulTokenCount: meaningful.length,\n218:     visibleCharCount,\n219:     metalinguisticMentions,\n220:   };\n221: }","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file .skilled/skills/system-skill-advisor/runtime/lib/prompt-policy.ts, lines 1-221\n1: // ───────────────────────────────────────────────────────────────\n2: // MODULE: Skill Advisor Prompt Policy\n3: // ───────────────────────────────────────────────────────────────\n4: \n5: // ───────────────────────────────────────────────────────────────────\n6: // 1. IMPORTS\n7: // ───────────────────────────────────────────────────────────────────\n8: \n9: import { canonicalFold } from './shared/unicode-normalization.js';\n10: import { readFileSync } from 'node:fs';\n11: import { join, dirname } from 'node:path';\n12: import { fileURLToPath } from 'node:url';\n13: \n14: const __filename = fileURLToPath(import.meta.url);\n15: const __dirname = dirname(__filename);\n16: \n17: // ───────────────────────────────────────────────────────────────────\n18: // 2. TYPE DEFINITIONS\n19: // ───────────────────────────────────────────────────────────────────\n20: \n21: interface PromptPolicyConfig {\n22:   sets: {\n23:     EXACT_SKIP_COMMANDS: string[];\n24:     CASUAL_ACKNOWLEDGEMENTS: string[];\n25:     WORK_INTENT_VERBS: string[];\n26:     STOP_WORDS: string[];\n27:     GOVERNANCE_MARKERS: string[];\n28:   };\n29:   thresholds: {\n30:     MIN_VISIBLE_CHARS: number;\n31:     MIN_MEANINGFUL_TOKENS: number;\n32:     LENGTH_AND_TOKEN_VISIBLE_CHARS: number;\n33:     LENGTH_AND_TOKEN_MEANINGFUL_FLOOR: number;\n34:     LONG_NON_CASUAL_CHARS: number;\n35:   };\n36: }\n37: \n38: // ───────────────────────────────────────────────────────────────────\n39: // 3. POLICY CONFIG\n40: // ───────────────────────────────────────────────────────────────────\n41: \n42: const policyJsonPath = process.env.SPECKIT_ADVISOR_PROMPT_POLICY_PATH\n43:   ?? join(__dirname, '..', 'data', 'prompt-policy.default.json');\n44: \n45: function loadPolicyConfig(): PromptPolicyConfig {\n46:   const raw = readFileSync(policyJsonPath, 'utf-8');\n47:   return JSON.parse(raw) as PromptPolicyConfig;\n48: }\n49: \n50: const policyConfig = loadPolicyConfig();\n51: \n52: const EXACT_SKIP_COMMANDS = new Set(policyConfig.sets.EXACT_SKIP_COMMANDS);\n53: const CASUAL_ACKNOWLEDGEMENTS = new Set(policyConfig.sets.CASUAL_ACKNOWLEDGEMENTS);\n54: const WORK_INTENT_VERBS = new Set(policyConfig.sets.WORK_INTENT_VERBS);\n55: const STOP_WORDS = new Set(policyConfig.sets.STOP_WORDS);\n56: const GOVERNANCE_MARKERS = policyConfig.sets.GOVERNANCE_MARKERS;\n57: \n58: function resolveNumericThreshold(envName: string, defaultValue: number): number {\n59:   const raw = process.env[envName];\n60:   if (raw === undefined) return defaultValue;\n61:   const parsed = parseInt(raw, 10);\n62:   if (isNaN(parsed)) return defaultValue;\n63:   return parsed;\n64: }\n65: \n66: const MIN_VISIBLE_CHARS = resolveNumericThreshold('SPECKIT_ADVISOR_PROMPT_POLICY_MIN_VISIBLE_CHARS', policyConfig.thresholds.MIN_VISIBLE_CHARS);\n67: const MIN_MEANINGFUL_TOKENS = resolveNumericThreshold('SPECKIT_ADVISOR_PROMPT_POLICY_MEANINGFUL_TOKEN_FLOOR', policyConfig.thresholds.MIN_MEANINGFUL_TOKENS);\n68: const LENGTH_AND_TOKEN_VISIBLE_CHARS = resolveNumericThreshold('SPECKIT_ADVISOR_PROMPT_POLICY_LENGTH_AND_TOKEN_VISIBLE_CHARS', policyConfig.thresholds.LENGTH_AND_TOKEN_VISIBLE_CHARS);\n69: const LENGTH_AND_TOKEN_MEANINGFUL_FLOOR = resolveNumericThreshold('SPECKIT_ADVISOR_PROMPT_POLICY_LENGTH_AND_TOKEN_MEANINGFUL_FLOOR', policyConfig.thresholds.LENGTH_AND_TOKEN_MEANINGFUL_FLOOR);\n70: const LONG_NON_CASUAL_CHARS = resolveNumericThreshold('SPECKIT_ADVISOR_PROMPT_POLICY_LONG_NON_CASUAL_CHARS', policyConfig.thresholds.LONG_NON_CASUAL_CHARS);\n71: \n72: // ───────────────────────────────────────────────────────────────────\n73: // 4. RESULT TYPE\n74: // ───────────────────────────────────────────────────────────────────\n75: \n76: export interface AdvisorPromptPolicyResult {\n77:   readonly fire: boolean;\n78:   readonly reason: string;\n79:   readonly canonicalPrompt: string;\n80:   readonly meaningfulTokenCount: number;\n81:   readonly visibleCharCount: number;\n82:   readonly metalinguisticMentions: string[];\n83: }\n84: \n85: // ───────────────────────────────────────────────────────────────────\n86: // 5. HELPERS\n87: // ───────────────────────────────────────────────────────────────────\n88: \n89: function normalizePrompt(prompt: string): string {\n90:   return canonicalFold(prompt).replace(/\\s+/g, ' ').trim();\n91: }\n92: \n93: function tokenize(prompt: string): string[] {\n94:   return prompt\n95:     .toLowerCase()\n96:     .match(/[a-z0-9][a-z0-9_-]*/g) ?? [];\n97: }\n98: \n99: function meaningfulTokens(tokens: string[]): string[] {\n100:   return tokens.filter((token) => token.length > 0 && !STOP_WORDS.has(token));\n101: }\n102: \n103: function hasExplicitMarker(canonicalLower: string): boolean {\n104:   return /\\bsk-[a-z0-9][a-z0-9-]*\\b/.test(canonicalLower)\n105:     || /(?:^|\\s)\\/[a-z][a-z0-9:_-]*/.test(canonicalLower)\n106:     || GOVERNANCE_MARKERS.some((marker) => canonicalLower.includes(marker));\n107: }\n108: \n109: function hasWorkIntentVerb(tokens: string[]): boolean {\n110:   return tokens.some((token) => WORK_INTENT_VERBS.has(token));\n111: }\n112: \n113: // ───────────────────────────────────────────────────────────────────\n114: // 6. CORE LOGIC\n115: // ───────────────────────────────────────────────────────────────────\n116: \n117: /** Extract explicit `sk-*` mentions used for prompt-policy diagnostics. */\n118: export function extractMetalinguisticSkillMentions(prompt: string): string[] {\n119:   const canonicalLower = normalizePrompt(prompt).toLowerCase();\n120:   return [...new Set(canonicalLower.match(/\\bsk-[a-z0-9][a-z0-9-]*\\b/g) ?? [])].sort();\n121: }\n122: \n123: /** Decide whether a user prompt should invoke the advisor producer. */\n124: export function shouldFireAdvisor(prompt: string): AdvisorPromptPolicyResult {\n125:   const canonicalPrompt = normalizePrompt(prompt);\n126:   const canonicalLower = canonicalPrompt.toLowerCase();\n127:   const tokens = tokenize(canonicalPrompt);\n128:   const meaningful = meaningfulTokens(tokens);\n129:   const visibleCharCount = canonicalPrompt.length;\n130:   const metalinguisticMentions = extractMetalinguisticSkillMentions(canonicalPrompt);\n131: \n132:   if (visibleCharCount === 0) {\n133:     return {\n134:       fire: false,\n135:       reason: 'empty_prompt',\n136:       canonicalPrompt,\n137:       meaningfulTokenCount: 0,\n138:       visibleCharCount,\n139:       metalinguisticMentions,\n140:     };\n141:   }\n142: \n143:   if (EXACT_SKIP_COMMANDS.has(canonicalLower)) {\n144:     return {\n145:       fire: false,\n146:       reason: 'skip_command',\n147:       canonicalPrompt,\n148:       meaningfulTokenCount: meaningful.length,\n149:       visibleCharCount,\n150:       metalinguisticMentions,\n151:     };\n152:   }\n153: \n154:   const explicitMarker = hasExplicitMarker(canonicalLower);\n155:   const workIntent = hasWorkIntentVerb(tokens);\n156:   const casual = CASUAL_ACKNOWLEDGEMENTS.has(canonicalLower);\n157: \n158:   if (!explicitMarker && !workIntent && visibleCharCount <= MIN_VISIBLE_CHARS && casual) {\n159:     return {\n160:       fire: false,\n161:       reason: 'short_casual_acknowledgement',\n162:       canonicalPrompt,\n163:       meaningfulTokenCount: meaningful.length,\n164:       visibleCharCount,\n165:       metalinguisticMentions,\n166:     };\n167:   }\n168: \n169:   if (explicitMarker) {\n170:     return {\n171:       fire: true,\n172:       reason: 'explicit_skill_or_governance_marker',\n173:       canonicalPrompt,\n174:       meaningfulTokenCount: meaningful.length,\n175:       visibleCharCount,\n176:       metalinguisticMentions,\n177:     };\n178:   }\n179: \n180:   if (workIntent && meaningful.length >= MIN_MEANINGFUL_TOKENS) {\n181:     return {\n182:       fire: true,\n183:       reason: 'work_intent_with_meaningful_tokens',\n184:       canonicalPrompt,\n185:       meaningfulTokenCount: meaningful.length,\n186:       visibleCharCount,\n187:       metalinguisticMentions,\n188:     };\n189:   }\n190: \n191:   if (visibleCharCount >= LENGTH_AND_TOKEN_VISIBLE_CHARS && meaningful.length >= LENGTH_AND_TOKEN_MEANINGFUL_FLOOR) {\n192:     return {\n193:       fire: true,\n194:       reason: 'length_and_token_threshold',\n195:       canonicalPrompt,\n196:       meaningfulTokenCount: meaningful.length,\n197:       visibleCharCount,\n198:       metalinguisticMentions,\n199:     };\n200:   }\n201: \n202:   if (visibleCharCount >= LONG_NON_CASUAL_CHARS && !casual) {\n203:     return {\n204:       fire: true,\n205:       reason: 'long_non_casual_prompt',\n206:       canonicalPrompt,\n207:       meaningfulTokenCount: meaningful.length,\n208:       visibleCharCount,\n209:       metalinguisticMentions,\n210:     };\n211:   }\n212: \n213:   return {\n214:     fire: false,\n215:     reason: 'below_prompt_policy_threshold',\n216:     canonicalPrompt,\n217:     meaningfulTokenCount: meaningful.length,\n218:     visibleCharCount,\n219:     metalinguisticMentions,\n220:   };\n221: }"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\".skilled/skills/system-skill-advisor/runtime/lib/prompt-policy.ts\"}"},"time":{"start":1794524082906,"end":1794524082918}}}}
