illLabel: sanitizeSkillLabel(input.correctedSkillLabel) } : {}),\n  };\n}\n--- files:\ntotal 9464\ndrwxr-xr-x@ 12 michelkerkmeester  staff      384 Nov 13 00:02 .\ndrwxr-xr-x@ 28 michelkerkmeester  staff      896 Nov 12 22:23 ..\n-rw-r--r--@  1 michelkerkmeester  staff      546 Nov 12 10:24 .gitignore\n-rw-------@  1 michelkerkmeester  staff      423 Nov 13 00:02 .skill-advisor-owner.json\n-rw-------@  1 michelkerkmeester  staff      177 Nov 12 21:11 .system-skill-advisor-launcher.json\n-rw-r--r--@  1 michelkerkmeester  staff     2537 Nov 12 10:24 README.md\n-rw-------@  1 michelkerkmeester  staff    12288 Nov 12 23:57 skill-graph-daemon-lease.sqlite\n-rw-------@  1 michelkerkmeester  staff    32768 Nov 12 21:11 skill-graph-daemon-lease.sqlite-shm\n-rw-------@  1 michelkerkmeester  staff  4120032 Nov 13 00:02 skill-graph-daemon-lease.sqlite-wal\n-rw-r--r--@  1 michelkerkmeester  staff   548864 Nov 12 23:26 skill-graph.sqlite\n-rw-r--r--@  1 michelkerkmeester  staff    32768 Nov 12 23:33 skill-graph.sqlite-shm\n-rw-r--r--@  1 michelkerkmeester  staff        0 Nov 12 23:26 skill-graph.sqlite-wal\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"  };\n}\n\nexport function readAdvisorHookHealthSection(workspaceRoot: string): AdvisorHookHealthSection {\n  return buildAdvisorHookHealthSection(readAdvisorHookDiagnosticRecords(workspaceRoot));\n}\n\nexport function advisorHookDiagnosticsPath(workspaceRoot: string): string {\n  return durableMetricsPath(workspaceRoot, 'diagnostics');\n}\n\n// Persists only sanitized skill labels + the accept/correct/ignore signal,\n// never the prompt or scenario — deliberate prompt-safety. Real misroutes\n// therefore cannot be reconstructed into gold cases from this telemetry; that\n// is an accepted capability tradeoff, not an omission to fix by capturing\n// prompts (which would breach the prompt-safety invariant).\nexport function createAdvisorHookOutcomeRecord(input: {\n  readonly runtime: AdvisorRuntime;\n  readonly outcome: AdvisorOutcome;\n  readonly skillLabel: string;\n  readonly correctedSkillLabel?: string | null;\n  readonly timestamp?: string;\n}): AdvisorHookOutcomeRecord {\n  return {\n    timestamp: input.timestamp ?? new Date().toISOString(),\n    runtime: input.runtime,\n    outcome: input.outcome,\n    skillLabel: sanitizeSkillLabel(input.skillLabel) ?? 'unknown-skill',\n    ...(sanitizeSkillLabel(input.correctedSkillLabel) ? { correctedSkillLabel: sanitizeSkillLabel(input.correctedSkillLabel) } : {}),\n  };\n}\n--- files:\ntotal 9464\ndrwxr-xr-x@ 12 michelkerkmeester  staff      384 Nov 13 00:02 .\ndrwxr-xr-x@ 28 michelkerkmeester  staff      896 Nov 12 22:23 ..\n-rw-r--r--@  1 michelkerkmeester  staff      546 Nov 12 10:24 .gitignore\n-rw-------@  1 michelkerkmeester  staff      423 Nov 13 00:02 .skill-advisor-owner.json\n-rw-------@  1 michelkerkmeester  staff      177 Nov 12 21:11 .system-skill-advisor-launcher.json\n-rw-r--r--@  1 michelkerkmeester  staff     2537 Nov 12 10:24 README.md\n-rw-------@  1 michelkerkmeester  staff    12288 Nov 12 23:57 skill-graph-daemon-lease.sqlite\n-rw-------@  1 michelkerkmeester  staff    32768 Nov 12 21:11 skill-graph-daemon-lease.sqlite-shm\n-rw-------@  1 michelkerkmeester  staff  4120032 Nov 13 00:02 skill-graph-daemon-lease.sqlite-wal\n-rw-r--r--@  1 michelkerkmeester  staff   548864 Nov 12 23:26 skill-graph.sqlite\n-rw-r--r--@  1 michelkerkmeester  staff    32768 Nov 12 23:33 skill-graph.sqlite-shm\n-rw-r--r--@  1 michelkerkmeester  staff        0 Nov 12 23:26 skill-graph.sqlite-wal\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"cd /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research && sed -n '480,510p' .skilled/skills/system-skill-advisor/runtime/lib/metrics.ts; echo \\\"--- files:\\\"; ls -la .skilled/skills/system-skill-advisor/runtime/database/ 2>/dev/null | head -20; find .skilled/s