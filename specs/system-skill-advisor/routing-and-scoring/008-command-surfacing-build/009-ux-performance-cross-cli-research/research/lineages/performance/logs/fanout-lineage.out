     setRuntimeHealth({\n139:         activeEmbedder: { name: active.name, dim: active.dim, adapterDim: adapter.dim },\n140:         dimMismatch: true,\n141:         disabledReason: 'dim_mismatch',\n142:       });\n143:       throw new Error(`active embedder dimension mismatch: ${active.name} reports ${adapter.dim}, pointer expects ${active.dim}`);\n144:     }\n145: \n146:     const [vector] = await adapter.embed([prompt], { inputType: 'query' });\n147:     setSemanticShadowPromptEmbedding(prompt, vector ?? null);\n148:     setRuntimeHealth({\n149:       activeEmbedder: { name: active.name, dim: active.dim, adapterDim: adapter.dim },\n150:       dimMismatch: false,\n151:       disabledReason: vector ? null : 'prompt_embedding_empty',\n152:       lastPromptEmbeddingAt: vector ? new Date().toISOString() : runtimeHealth.lastPromptEmbeddingAt,\n153:     });\n154:   } catch (error: unknown) {\n155:     setSemanticShadowPromptEmbedding(prompt, null);\n156:     const message = error instanceof Error ? error.message : String(error);\n157:     if (!runtimeHealth.disabledReason) {\n158:       setRuntimeHealth({ disabledReason: 'prompt_embedding_failed' });\n159:     }\n160:     console.warn(`[semantic-shadow] Prompt embedding failed; cosine lane disabled for this call (${message})`);\n161:   }\n162: \n163:   try {\n164:     return run();\n165:   } finally {\n166:     clearSemanticShadowPromptEmbedding();\n167:   }\n168: }\n169: \n170: // ───────────────────────────────────────────────────────────────────\n171: // 7. TEST HOOKS\n172: // ───────────────────────────────────────────────────────────────────\n173: export const _semanticShadowTest = {\n174:   cosineSimilarity,\n175:   fixtureVector,\n176: };\n177: \n178: // ───────────────────────────────────────────────────────────────────\n179: // 8. CORE LOGIC\n[Output truncated. Continue reading with offset: 180]"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"limit\":80,\"offset\":100,\"p