{"type":"tool_use","timestamp":1794523895940,"sessionID":"ses_e2e0e4d38ffeP1JOC1np1mhw9O","part":{"partID":"prt_1d1f5958f001ZRtYNdi53pXwFh","sessionID":"ses_e2e0e4d38ffeP1JOC1np1mhw9O","messageID":"msg_1d1f587b60013Itt3RRSJsqAgq","type":"tool","id":"call_a5984c64eaa643cba361631f","tool":"read","state":{"status":"completed","input":{"path":".skilled/skills/system-skill-advisor/runtime/lib/prompt-cache.ts"},"output":"Read file .skilled/skills/system-skill-advisor/runtime/lib/prompt-cache.ts, lines 1-211\n1: // ───────────────────────────────────────────────────────────────\n2: // MODULE: Skill Advisor Exact Prompt Cache\n3: // ───────────────────────────────────────────────────────────────\n4: \n5: // ───────────────────────────────────────────────────────────────────\n6: // 1. IMPORTS\n7: // ───────────────────────────────────────────────────────────────────\n8: import { createHmac, createHash } from 'node:crypto';\n9: import { performance } from 'node:perf_hooks';\n10: import { isSpeckitMetricsEnabled, speckitMetrics } from './metrics.js';\n11: import { SKILL_ADVISOR_COMPAT_CONTRACT, resolvedConfidenceThreshold, resolvedUncertaintyThreshold } from './compat/contract.js';\n12: \n13: // ───────────────────────────────────────────────────────────────────\n14: // 2. CONSTANTS\n15: // ───────────────────────────────────────────────────────────────────\n16: export const ADVISOR_PROMPT_CACHE_TTL_MS = 5 * 60 * 1000;\n17: export const ADVISOR_PROMPT_CACHE_DEFAULT_MAX_TOKENS = 80;\n18: export const ADVISOR_PROMPT_CACHE_MAX_TOKENS = 120;\n19: export const MAX_CACHE_ENTRIES = 1000;\n20: \n21: // ───────────────────────────────────────────────────────────────────\n22: // 3. TYPE DEFINITIONS\n23: // ───────────────────────────────────────────────────────────────────\n24: export interface AdvisorThresholds {\n25:   readonly confidenceThreshold?: number;\n26:   readonly uncertaintyThreshold?: number;\n27:   readonly confidenceOnly?: boolean;\n28:   readonly showRejections?: boolean;\n29:   readonly includeAttribution?: boolean;\n30:   readonly includeAbstainReasons?: boolean;\n31: }\n32: \n33: export interface AdvisorPromptCacheKeyParts {\n34:   readonly canonicalPrompt: string;\n35:   readonly sourceSignature: string;\n36:   readonly workspaceRoot?: string;\n37:   readonly runtime: string;\n38:   readonly maxTokens?: number;\n39:   readonly thresholdConfig?: AdvisorThresholds;\n40: }\n41: \n42: export interface AdvisorPromptCacheEntry<T> {\n43:   readonly key: string;\n44:   readonly sourceSignature: string;\n45:   readonly value: T;\n46:   readonly skillLabels: readonly string[];\n47:   readonly createdAtMs: number;\n48:   readonly expiresAtMs: number;\n49: }\n50: \n51: // ───────────────────────────────────────────────────────────────────\n52: // 4. HELPERS\n53: // ───────────────────────────────────────────────────────────────────\n54: const SESSION_LAUNCH_TIME = performance.timeOrigin.toFixed(3);\n55: const DEFAULT_SECRET = createHash('sha256')\n56:   .update(`${process.pid}:${SESSION_LAUNCH_TIME}:${Math.random()}`)\n57:   .digest();\n58: \n59: function stableThresholdConfig(thresholdConfig: AdvisorThresholds | undefined): string {\n60:   return JSON.stringify({\n61:     confidenceThreshold: thresholdConfig?.confidenceThreshold ?? resolvedConfidenceThreshold(),\n62:     uncertaintyThreshold: thresholdConfig?.uncertaintyThreshold ?? resolvedUncertaintyThreshold(),\n63:     confidenceOnly: thresholdConfig?.confidenceOnly ?? false,\n64:     showRejections: thresholdConfig?.showRejections ?? false,\n65:     includeAttribution: thresholdConfig?.includeAttribution ?? false,\n66:     includeAbstainReasons: thresholdConfig?.includeAbstainReasons ?? false,\n67:   });\n68: }\n69: \n70: function normalizeMaxTokens(maxTokens: number | undefined): number {\n71:   if (typeof maxTokens !== 'number' || Number.isNaN(maxTokens)) {\n72:     return ADVISOR_PROMPT_CACHE_DEFAULT_MAX_TOKENS;\n73:   }\n74:   return Math.min(\n75:     Math.max(1, Math.floor(maxTokens)),\n76:     ADVISOR_PROMPT_CACHE_MAX_TOKENS,\n77:   );\n78: }\n79: \n80: /** Build an opaque HMAC key for exact prompt-cache lookups. */\n81: export function createAdvisorPromptCacheKey(\n82:   parts: AdvisorPromptCacheKeyParts,\n83:   secret: Buffer = DEFAULT_SECRET,\n84: ): string {\n85:   const payload = [\n86:     parts.canonicalPrompt,\n87:     parts.sourceSignature,\n88:     parts.workspaceRoot ?? '',\n89:     parts.runtime,\n90:     String(normalizeMaxTokens(parts.maxTokens)),\n91:     stableThresholdConfig(parts.thresholdConfig),\n92:   ].join('\\u001f');\n93:   return createHmac('sha256', secret).update(payload).digest('hex');\n94: }\n95: \n96: // ───────────────────────────────────────────────────────────────────\n97: // 5. CORE LOGIC\n98: // ───────────────────────────────────────────────────────────────────\n99: /** In-memory exact cache for advisor briefs scoped to one host process. */\n100: export class AdvisorPromptCache<T> {\n101:   private readonly entries = new Map<string, AdvisorPromptCacheEntry<T>>();\n102: \n103:   constructor(\n104:     private readonly ttlMs: number = ADVISOR_PROMPT_CACHE_TTL_MS,\n105:     private readonly secret: Buffer = DEFAULT_SECRET,\n106:   ) {}\n107: \n108:   /** Create an opaque cache key from normalized prompt/runtime/source inputs. */\n109:   makeKey(parts: AdvisorPromptCacheKeyParts): string {\n110:     return createAdvisorPromptCacheKey(parts, this.secret);\n111:   }\n112: \n113:   /** Return a live entry, evicting it first when its TTL has expired. */\n114:   get(key: string, nowMs: number = performance.now()): AdvisorPromptCacheEntry<T> | null {\n115:     const entry = this.entries.get(key);\n116:     if (!entry) {\n117:       if (isSpeckitMetricsEnabled()) {\n118:         speckitMetrics.incrementCounter('spec_kit.scorer.near_dup_cache_miss_total', { cache_layer: 'exact' });\n119:         speckitMetrics.recordPromptCacheOutcome('miss');\n120:       }\n121:       return null;\n122:     }\n123:     if (entry.expiresAtMs <= nowMs) {\n124:       this.entries.delete(key);\n125:       if (isSpeckitMetricsEnabled()) {\n126:         speckitMetrics.incrementCounter('spec_kit.scorer.near_dup_cache_miss_total', { cache_layer: 'exact' });\n127:         speckitMetrics.recordPromptCacheOutcome('miss');\n128:       }\n129:       return null;\n130:     }\n131:     if (isSpeckitMetricsEnabled()) {\n132:       speckitMetrics.recordPromptCacheOutcome('hit');\n133:     }\n134:     return entry;\n135:   }\n136: \n137:   /** Insert or replace an entry, sweeping expired rows and evicting oldest overflow. */\n138:   set(args: {\n139:     key: string;\n140:     sourceSignature: string;\n141:     value: T;\n142:     skillLabels: readonly string[];\n143:     nowMs?: number;\n144:   }): AdvisorPromptCacheEntry<T> {\n145:     const createdAtMs = args.nowMs ?? performance.now();\n146:     this.sweepExpired(createdAtMs);\n147:     if (!this.entries.has(args.key)) {\n148:       this.evictOldestUntilBelowLimit();\n149:     }\n150:     const entry: AdvisorPromptCacheEntry<T> = {\n151:       key: args.key,\n152:       sourceSignature: args.sourceSignature,\n153:       value: args.value,\n154:       skillLabels: [...new Set(args.skillLabels)].sort(),\n155:       createdAtMs,\n156:       expiresAtMs: createdAtMs + this.ttlMs,\n157:     };\n158:     this.entries.set(args.key, entry);\n159:     return entry;\n160:   }\n161: \n162:   /** Remove a single cache entry by key. */\n163:   invalidate(key: string): void {\n164:     this.entries.delete(key);\n165:   }\n166: \n167:   /** Drop entries produced from stale advisor source signatures. */\n168:   invalidateSourceSignatureChange(currentSourceSignature: string): number {\n169:     let dropped = 0;\n170:     for (const [key, entry] of this.entries) {\n171:       if (entry.sourceSignature !== currentSourceSignature) {\n172:         this.entries.delete(key);\n173:         dropped += 1;\n174:       }\n175:     }\n176:     return dropped;\n177:   }\n178: \n179:   /** Clear all cache entries, primarily for tests and session teardown. */\n180:   clear(): void {\n181:     this.entries.clear();\n182:   }\n183: \n184:   /** Return the number of live and unswept entries currently retained. */\n185:   size(): number {\n186:     return this.entries.size;\n187:   }\n188: \n189:   private sweepExpired(nowMs: number): void {\n190:     for (const [key, entry] of this.entries) {\n191:       if (entry.expiresAtMs <= nowMs) {\n192:         this.entries.delete(key);\n193:       }\n194:     }\n195:   }\n196: \n197:   private evictOldestUntilBelowLimit(): void {\n198:     while (this.entries.size >= MAX_CACHE_ENTRIES) {\n199:       const oldestKey = this.entries.keys().next().value as string | undefined;\n200:       if (oldestKey === undefined) {\n201:         return;\n202:       }\n203:       this.entries.delete(oldestKey);\n204:     }\n205:   }\n206: }\n207: \n208: // ───────────────────────────────────────────────────────────────────\n209: // 6. EXPORTS\n210: // ───────────────────────────────────────────────────────────────────\n211: export const advisorPromptCache = new AdvisorPromptCache<unknown>();","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file .skilled/skills/system-skill-advisor/runtime/lib/prompt-cache.ts, lines 1-211\n1: // ───────────────────────────────────────────────────────────────\n2: // MODULE: Skill Advisor Exact Prompt Cache\n3: // ───────────────────────────────────────────────────────────────\n4: \n5: // ───────────────────────────────────────────────────────────────────\n6: // 1. IMPORTS\n7: // ───────────────────────────────────────────────────────────────────\n8: import { createHmac, createHash } from 'node:crypto';\n9: import { performance } from 'node:perf_hooks';\n10: import { isSpeckitMetricsEnabled, speckitMetrics } from './metrics.js';\n11: import { SKILL_ADVISOR_COMPAT_CONTRACT, resolvedConfidenceThreshold, resolvedUncertaintyThreshold } from './compat/c