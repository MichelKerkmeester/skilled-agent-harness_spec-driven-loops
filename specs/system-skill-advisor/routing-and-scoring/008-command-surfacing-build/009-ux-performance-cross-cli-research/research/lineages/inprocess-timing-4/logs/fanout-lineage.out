skill-advisor/runtime; for f in handlers/advisor-recommend.ts lib/subprocess.ts lib/skill-graph/skill-graph-db.ts lib/command-attach.ts skill-advisor-cli.ts; do d=dist/runtime/${f%.ts}.js; printf \\\"%s src=%s dist=%s\\\\n\\\" \\\"$f\\\" \\\"$(stat -f %Sm -t %H:%M:%S $f)\\\" \\\"$(stat -f %Sm -t %H:%M:%S $d 2>/dev/null || echo MISSING)\\\"; done; grep -c \\\"export async function handleAdvisorRecommend\\\" dist/runtime/handlers/advisor-recommend.js; grep -n \\\"degradedRecommendations\\\" dist/runtime/skill-advisor-cli.js | head -3\"}"},"time":{"start":1794570292340,"end":1794570293647}}}}
