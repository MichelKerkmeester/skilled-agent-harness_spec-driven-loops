oad(args: Record<string, unknown>, timeoutMs: number, trusted: boolean, warmOnly: boolean): Promise<ToolPayloadResult> {\n1415:   return invokeWithRetry(\n1416:     () => invokeToolPayload('advisor_validate', args, timeoutMs, trusted, warmOnly),\n1417:     {\n1418:       maxAttempts: ADVISOR_VALIDATE_MAX_ATTEMPTS,\n1419:       sleepMsForAttempt: advisorValidateRetryDelayMs,\n1420:     },\n1421:   );\n1422: }\n1423: \n1424: function generationFromPayload(payload: unknown): unknown {\n1425:   return getDataRecord(payload)?.generation ?? null;\n1426: }\n1427: \n1428: async function runSkillGraphScanJob(args: Record<string, unknown>, timeoutMs: number, trusted: boolean, warmOnly: boolean): Promise<ToolPayloadResult> {\n1429:   const workspaceRoot = findRepoPaths().repoRoot;\n1430:   const before = await invokeToolPayload('advisor_status', { workspaceRoot }, timeoutMs, false, warmOnly);\n1431:   const scan = await invokeToolPayload('skill_graph_scan', args, timeoutMs, trusted, warmOnly);\n1432:   const after = await invokeToolPayload('advisor_status', { workspaceRoot }, timeoutMs, false, warmOnly);\n1433:   const status = isRecord(scan.payload) && typeof scan.payload.status === 'string' ? scan.payload.status : 'ok';\n1434:   const scanData = getDataRecord(scan.payload) ?? scan.payload;\n1435: \n1436:   return {\n1437:     payload: {\n1438:       status,\n1439:       data: {\n1440:         progress: [\n1441:           { step: 'advisor_status_before', generation: generationFromPayload(before.payload), ok: !before.isError },\n1442:           { step: 'skill_graph_scan', ok: !scan.isError },\n1443:           { step: 'advisor_status_after', generation: generationFromPayload(after.payload), ok: !after.isError },\n1444:         ],\n1445:         generationBefore: generationFromPayload(before.payload),\n1446:         generationAfter: generationFromPayload(after.payload),\n1447:         scan: scanData,\n1448:       },\n1449:       ...(isRecord(scan.payload) && typeof scan.payload.error === 'string' ? { error: scan.payload.error } : {}),\n1450:     },\n1451:     isError: before.isError || scan.isError || after.isError,\n1452:   };\n1453: }\n1454: \n1455: async function runLocalScorer(prompt: string): Promise<readonly AdvisorRecommendation[] | null> {\n1456:   const forceLocalEnv = SKILL_ADVISOR_COMPAT_CONTRACT.forceLocalEnv;\n1457:   const previous = process.env[forceLocalEnv];\n1458:   // Force-local for this spawn alone: the scorer would otherwise spend the fallback\n1459:   // budget retrying the daemon that just proved unreachable.\n1460:   process.env[forceLocalEnv] = '1';\n1461:   try {\n1462:     const result = await runAdvisorSubprocess(prompt, {\n1463:       workspaceRoot: findRepoPaths().repoRoot,\n1464:       timeoutMs: LOCAL_SCORER_TIMEOUT_MS,\n1465:       thresholdConfig: LOCAL_SCORER_THRESHOLDS,\n1466:     });\n1467:     return result.ok ? result.recommendations : null;\n1468:   } finally {\n1469:     if (previous === undefined) {\n1470:       delete process.env[forceLocalEnv];\n1471:     } else {\n1472:       process.env[forceLocalEnv] = previous;\n1473:     }\n1474:   }\n1475: }\n1476: \n1477: // The local scorer names command ids, but a reader can only act on a command they\n1478: // typed or on the skill that owns it. A row whose bare slash command appears in\n1479: // the prompt keeps its command fields, and every other row collapses to its owner\n1480: // skill so the degraded brief names a skill that exists instead of a raw row id.\n1481: export function degradedRecommendations(\n1482:   entries: readonly AdvisorRecommendation[],\n1483:   prompt: string,\n1484: ): Array<Record<string, unknown>> {\n1485:   const offeredSkills = new Set<string>();\n1486:   const recommendations: Array<Record<string, unknown>> = [];\n1487: \n1488:   for (const entry of entries) {\n1489:     if (entry.passes_threshold !== true) continue;\n1490:     const base = {\n1491:       confidence: entry.confidence,\n1492:       uncertainty: entry.uncertainty,\n1493:       reason: entry.reason ?? '',\n1494:     };\n1495:     const row = commandRowFor(entry.skill);\n1496: \n1497:     if (row && prompt.includes(row.command.split(' ')[0])) {\n1498:       recommendations.push({\n1499:         skillId: entry.skill,\n1500:         kind: 'command',\n1501:         command: row.command,\n1502:         ...(row.policy ? { policy: row.policy } : {}),\n1503:         ownerSkillId: row.ownerSkillId,\n1504:         ...base,\n1505:       });\n1506:       offeredSkills.add(entry.skill);\n1507:       continue;\n1508:     }\n1509: \n1510:     if (row) {\n1511:       if (offeredSkills.has(row.ownerSkillId)) continue;\n1512:       recommendations.push({\n1513:         skillId: row.ownerSkillId,\n1514:         kind: 'skill',\n1515:         ...base,\n1516:       });\n1517:       offeredSkills.add(row.ownerSkillId);\n1518:       continue;\n1519:     }\n1520: \n1521:     recommendations.push({ skillId: entry.skill, ...base });\n1522:     offeredSkills.add(entry.skill);\n1523:   }\n1524: \n1525:   return recommendations;\n1526: }\n1527: \n1528: // Request options added after the daemon protocol was fixed, oldest first.\n1529: const COMPILED_ROUTE_OPTION_KEYS = ['includeCompiledRoute', 'compiledRouteTopOnly'] as const;\n1530: \n1531: async function invokeAdvisorRecommendPayload(\n1532:   args: Record<string, unknown>,\n1533:   timeoutMs: number,\n1534:   trusted: boolean,\n1535:   warmOnly: boolean,\n1536: ): Promise<ToolPayloadResult> {\n1537:   try {\n1538:     return await invokeToolPayload('advisor_recommend', args, timeoutMs, trusted, warmOnly);\n1539:   } catch (error: unknown) {\n1540:     let failure = error;\n1541:     const options = args.options;\n1542:     const rejected = error instanceof JsonRpcError && error.code === -32602 && isRecord(options)\n1543:       ? COMPILED_ROUTE_OPTION_KEYS.filter((key) => (\n1544:         error.message.includes(key) && Object.prototype.hasOwnProperty.call(options, key)\n1545:       ))\n1546:      