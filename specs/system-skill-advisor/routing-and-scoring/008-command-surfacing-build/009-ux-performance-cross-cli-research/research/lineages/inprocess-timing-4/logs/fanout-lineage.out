st elapsedMs = performance.now() - startedAt;\n345:     const remainingMs = Math.max(0, timeoutMs - elapsedMs);\n346:     const attemptResult = await runSpawnAttempt({\n347:       command,\n348:       commandArgs,\n349:       prompt,\n350:       cwd: options.workspaceRoot,\n351:       timeoutMs: Math.max(1, remainingMs),\n352:     });\n353: \n354:     if (!attemptResult.ok) {\n355:       const busy = SQLITE_BUSY_PATTERN.test(attemptResult.stderr);\n356:       const budgetRemaining = timeoutMs - (performance.now() - startedAt);\n357:       if (busy && attempt === 0 && budgetRemaining >= 500) {\n358:         retriesAttempted = 1;\n359:         await delay(options.retryJitterMs?.() ?? 75 + Math.floor(Math.random() * 51));\n360:         continue;\n361:       }\n362:       return {\n363:         ok: false,\n364:         recommendations: [],\n365:         errorCode: busy ? 'SQLITE_BUSY_EXHAUSTED' : attemptResult.errorCode ?? 'NON_ZERO_EXIT',\n366:         exitCode: attemptResult.exitCode,\n367:         signal: attemptResult.signal,\n368:         stderr: sanitizeStderr(attemptResult.stderr),\n369:         durationMs: performance.now() - startedAt,\n370:         retriesAttempted,\n371:       };\n372:     }\n373: \n374:     try {\n375:       return {\n376:         ok: true,\n377:         recommendations: parseRecommendations(attemptResult.stdout),\n378:         errorCode: null,\n379:         exitCode: attemptResult.exitCode,\n380:         signal: attemptResult.signal,\n381:         stderr: sanitizeStderr(attemptResult.stderr),\n382:         durationMs: performance.now() - startedAt,\n383:         retriesAttempted,\n384:       };\n385:     } catch (error: unknown) {\n386:       return {\n387:         ok: false,\n388:         recommendations: [],\n389:         errorCode: error instanceof SyntaxError ? 'JSON_PARSE_FAILED' : 'INVALID_JSON_SHAPE',\n390:         exitCode: attemptResult.exitCode,\n391:         signal: attemptResult.signal,\n392:         stderr: null,\n393:         