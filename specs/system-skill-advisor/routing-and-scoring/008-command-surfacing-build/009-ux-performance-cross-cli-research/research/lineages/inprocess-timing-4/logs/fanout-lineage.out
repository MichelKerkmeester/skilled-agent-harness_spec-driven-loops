adResult> {\n1537:   try {\n1538:     return await invokeToolPayload('advisor_recommend', args, timeoutMs, trusted, warmOnly);\n1539:   } catch (error: unknown) {\n1540:     let failure = error;\n1541:     const options = args.options;\n1542:     const rejected = error instanceof JsonRpcError && error.code === -32602 && isRecord(options)\n1543:       ? COMPILED_ROUTE_OPTION_KEYS.filter((key) => (\n1544:         error.message.includes(key) && Object.prototype.hasOwnProperty.call(options, key)\n1545:       ))\n1546:       : [];\n1547:     if (rejected.length > 0 && isRecord(options)) {\n1548:       // A daemon started before these options existed rejects them, and the\n1549:       // protocol handshake cannot distinguish the builds. A daemon too old for\n1550:       // the first option is too old for the later one as well, and it may name\n1551:       // only one of them, so both go together in that case.\n1552:       const retryOptions: Record<string, unknown> = { ...options };\n1553:       const drop = rejected.includes('includeCompiledRoute') ? COMPILED_ROUTE_OPTION_KEYS : rejected;\n1554:       for (const key of drop) delete retryOptions[key];\n1555:       const retryArgs: Record<string, unknown> = { ...args, options: retryOptions };\n1556:       try {\n1557:         return await invokeToolPayload('advisor_recommend', retryArgs, timeoutMs, trusted, warmOnly);\n1558:       } catch (retryError: unknown) {\n1559:         failure = retryError;\n1560:       }\n1561:     }\n1562:     // Only an unreachable daemon reaches this catch: one that answered, even with a\n1563:     // tool-level error, returned above. A fallback that also fails rethrows the\n1564:     // original error, so the exit code and error envelope stay unchanged.\n1565:     if (exitCodeForError(failure) !== EXIT_RETRYABLE) throw failure;\n1566:     // Warm-only is attach-or-refuse: it never spawns a process, and the local scorer\n1567:     // is a spawn, so it must not run here. Rethrow the original failure so the\n1568:     // retryable exit code and error envelope stay unchanged.\n1569:     if (warmOnly) throw failure;\n1570:     const prompt = args.prompt;\n1571:     if (typeof prompt !== 'string') throw failure;\n1572:     const recommendations = await runLocalScorer(prompt).catch(() => null);\n1573:     if (!recommendations) throw failure;\n1574:     return {\n1575:       payload: {\n1576:         status: 'ok',\n1577:         degraded: true,\n1578:         source: LOCAL_SCORER_SOURCE,\n1579:         data: {\n1580:           recommendations: degradedRecommendations(recommendations, prompt),\n1581:           effectiveThresholds: LOCAL_SCORER_THRESHOLDS,\n1582:         },\n1583:       },\n1584:       isError: false,\n1585:     };\n1586:   }\n1587: }\n1588: \n1589: // ───────────────────────────────────────────────────────────────────\n1590: // 6. EXPORTS\n1591: // ───────────────────────────────────────────────────────────────────\n1592: export async function runSkillAdvisorCli(argv: string[], io: CliIo = { stdout: process.stdout, stderr: process.stderr }): Promise<number> {\n1593:   try {\n1594:     const parsed = parseCliArgs(argv);\n1595:     if (parsed.help) {\n1596:       await writeLine(io.stdout, usageText(parsed.command || undefined));\n1597:       return EXIT_SUCCESS;\n1598:     }\n1599:     if (parsed.version) {\n[Output truncated. Continue reading with offset: 1600]"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\".skilled/skills/system-skill-advisor/runtime/skill-advisor-cli.ts\",\"offset\":1380,\"limit\":220}"},"time":{"start":1794570168390,"end":1794570168409}}}}
