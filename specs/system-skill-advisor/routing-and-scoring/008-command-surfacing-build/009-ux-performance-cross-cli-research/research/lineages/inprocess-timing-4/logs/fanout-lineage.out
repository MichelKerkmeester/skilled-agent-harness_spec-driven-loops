{"type":"tool_use","timestamp":1794570498769,"sessionID":"ses_e2b4abdd3ffe0ORlG2coZj9Q9y","part":{"partID":"prt_1d4bcb118002YdXfTtTF0ue7F0","sessionID":"ses_e2b4abdd3ffe0ORlG2coZj9Q9y","messageID":"msg_1d4bc8877001nltBcO6Bi1YPwK","type":"tool","id":"call_3f3d61baf5bf47cea40c7051","tool":"shell","state":{"status":"completed","input":{"command":"cd .skilled/skills/system-skill-advisor/runtime; sed -n '270,340p' schemas/advisor-tool-schemas.ts"},"output":"// `AdvisorScoringOptions.affordances` (see `lib/scorer/types.ts:94`) is a\n// COMPILE-TIME-ONLY internal seam used by the scorer fusion path. Affordance\n// evidence is sourced from compiled skill graph metadata via\n// `skill_graph_compiler.py` (which emits sanitized `derived.affordances[]`\n// nodes), not from public command input. Exposing `affordances` through this\n// request schema would re-introduce the prompt-stuffing surface that\n// `affordance-normalizer.ts` specifically defends against (URLs, emails,\n// instruction-shaped strings, free-form `description` fields). The public\n// `advisor_recommend` tool intentionally does NOT accept `affordances`.\n// Internal callers that need request-local affordance scoring should invoke\n// `scoreAdvisorPrompt` directly with `AdvisorScoringOptions.affordances`.\n// advisor_recommend routes on at most this many prompt characters. A caller holding a\n// longer prompt sends its head, so a long prompt is routed rather than refused.\nexport const ADVISOR_PROMPT_MAX_CHARS = 10_000;\n\nexport const AdvisorRecommendInputSchema = z.object({\n  // workspaceRoot must resolve under the allowed prefix set.\n  workspaceRoot: BoundedWorkspaceRootSchema.optional(),\n  prompt: z.string().min(1).max(ADVISOR_PROMPT_MAX_CHARS),\n  options: z.object({\n    topK: z.number().int().min(1).max(10).optional(),\n    includeAttribution: z.boolean().optional(),\n    includeAbstainReasons: z.boolean().optional(),\n    confidenceThreshold: z.number().min(0).max(1).optional(),\n    uncertaintyThreshold: z.number().min(0).max(1).optional(),\n    includeCompiledRoute: z.boolean().optional(),\n    // Limits the per-hub route lookup to the first recommendation, for a caller\n    // on a tight time budget that acts on the top pick alone.\n    compiledRouteTopOnly: z.boolean().optional(),\n    // Forwarded to the compiled-route front door as --surface-hint; a value\n    // that names no known surface is ignored there.\n    surfaceHint: z.string().min(1).max(64).optional(),\n  }).strict().optional(),\n}).strict();\n\nexport const AdvisorRecommendationSchema = z.object({\n  skillId: z.string().min(1),\n  score: z.number().min(0),\n  confidence: z.number().min(0).max(1),\n  uncertainty: z.number().min(0).max(1),\n  dominantLane: AdvisorLaneSchema.nullable(),\n  laneBreakdown: z.array(laneBreakdownSchema).optional(),\n  why_recommended: whyRecommendedSchema.optional(),\n  matchedDocs: z.array(z.string().min(1)).max(3).optional(),\n  redirectFrom: z.array(z.string().min(1)).optional(),\n  redirectTo: z.string().min(1).optional(),\n  heldBelow: z.string().min(1).optional(),\n  status: z.enum(['active', 'deprecated', 'archived', 'future']).optional(),\n  workflowMode: z.string().min(1).optional(),\n  compiledRoute: z.record(z.string(), z.unknown()).optional(),\n  // Names the slash command that runs the recommended skill's resolved mode.\n  command: z.string().min(1).optional(),\n  // A command-bearing recommendation also says which face it is (a skill or a\n  // command row), how a caller may run it, and which skill owns it. Each stays\n  // optional so output from a runtime that predates the fields still parses.\n  kind: z.enum(['skill', 'command']).optional(),\n  policy: z.enum(['run', 'start', 'ask']).optional(),\n  ownerSkillId: z.string().min(1).optional(),\n  // Set only when a hub held back its command because the prompt names no\n  // single mode, so the head can say so.\n  needsMode: z.literal(true).optional(),\n}).strict();\n\nexport const AdvisorRecommendOutputSchema = z.object({\n  workspaceRoot: z.string().min(1),\n  effectiveThresholds: z.object({\n    confidenceThreshold: z.number().min(0).max(1),\n    uncertaintyThreshold: z.number().min(0).max(1),\n    confidenceOnly: z.boolean(),\n  }).strict(),\n  recommendations: z.array(AdvisorRecommendationSchema),\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"// `AdvisorScoringOptions.affordances` (see `lib/scorer/types.ts:94`) is a\n// COMPILE-TIME-ONLY internal seam used by the scorer fusion path. Affordance\n// evidence is sourced from compiled skill graph metadata via\n// `skill_graph_compiler.py` (which emits sanitized `derived.affordances[]`\n// nodes), not from public command input. Exposing `affordances` through this\n// request schema would re-introduce the prompt-stuffing surface that\n// `affordance-normalizer.ts` specifically defends against (URLs, emails,\n// instruction-shaped strings, free-form `description` fields). The public\n// `advisor_recommend` tool intentionally does NOT accept `affordances`.\n// Internal callers that need request-local affordance scoring should invoke\n// `scoreAdvisorPrompt` directly with `AdvisorScoringOptions.affordances`.\n// advisor_recommend routes on at most this many prompt characters. A caller holding a\n// longer prompt sends its head, so a long prompt is routed rather than refused.\nexport const ADVISOR_PROMPT_MAX_CHARS = 10_000;\n\nexport const AdvisorRecommendInputSchema = z.object({\n  // workspaceRoot must resolve under the allowed prefix set.\n  workspaceRoot: BoundedWorkspaceRootSchema.optional(),\n  prompt: z.string().min(1).max(ADVISOR_PROMPT_MAX_CHARS),\n  options: z.object({\n    topK: z.number().int().min(1).max(10).optional(),\n    includeAttribution: z.boolean().optional(),\n    includeAbstainReasons: z.boolean().optional(),\n    confidenceThreshold: z.number().min(0).max(1).optional(),\n    uncertaintyThreshold: z.number().min(0).max(1).optional(),\n    includeCompiledRoute: z.boolean().optional(),\n    // Limits the per-hub route lookup to the first recommendation, for a caller\n    // on a tight time budget that acts on the top pick alone.\n    compiledRouteTopOnly: z.boolean().optional(),\n    // Forwarded to the compiled-route front door as --surface-hint; a value\n    // that names no known surface is ignored there.\n    surfaceHint: z.string().min(1).max(64).optional(),\n  }).strict().optional(),\n}).strict();\n\nexport const AdvisorRecommendationSchema = z.object({\n  skillId: z.string().min(1),\n  score: z.number().min(0),\n  confidence: z.number().min(0).max(1),\n  uncertainty: z.number().min(0).max(1),\n  dominantLane: AdvisorLaneSchema.nullable(),\n  laneBreakdown: z.array(laneBreakdownSchema).optional(),\n  why_recommended: whyRecommendedSchema.optional(),\n  matchedDocs: z.array(z.string().min(1)).max(3).optional(),\n  redirectFrom: z.array(z.string().min(1)).optional(),\n  redirectTo: z.string().min(1).optional(),\n  heldBelow: z.string().min(1).optional(),\n  status: z.enum(['active', 'deprecated', 'archived', 'future']).optional(),\n  workflowMode: z.string().min(1).optional(),\n  compiledRoute: z.record(z.string(), z.unknown()).optional(),\n  // Names the slash command that runs the recommended skill's resolved mode.\n  command: z.string().min(1).optional(),\n  // A command-bearing recommendation also says which face it is (a skill or a\n  // command row), how a caller may run it, and which skill owns it. Each stays\n  // optional so output from a runtime that predates the fields still parses.\n  kind: z.enum(['skill', 'command']).optional(),\n  policy: z.enum(['run', 'start', 'ask']).optional(),\n  ownerSkillId: z.string().min(1).optional(),\n  // Set only when a hub held back its command because the prompt names no\n  // single mode, so the head can say so.\n  needsMode: z.literal(true).optional(),\n}).strict();\n\nexport const AdvisorRecommendOutputSchema = z.object({\n  workspaceRoot: z.string().min(1),\n  effectiveThresholds: z.object({\n    confidenceThreshold: z.number().min(0).max(1),\n    uncertaintyThreshold: z.number().min(0).max(1),\n    confidenceOnly: z.boolean(),\n  }).strict(),\n  recommendations: z.array(AdvisorRecommendationSchema),\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"cd .skilled/skills/system-skill-advisor/runtime; sed -n '270,340p' schemas/advisor-tool-schemas.ts\"}"},"time":{"start":1794570498328,"end":1794570498769}}}}
