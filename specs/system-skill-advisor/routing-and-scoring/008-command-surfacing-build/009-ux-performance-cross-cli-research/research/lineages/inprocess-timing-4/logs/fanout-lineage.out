eason: 'skill_embedding_load_failed' });\n361:    setRuntimeHealth({ disabledReason: 'no_skill_vectors' });\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"12:} from '../../embedders/adapters/ollama.js';\n13:import { getAdapter } from '../../embedders/registry.js';\n14:import { getActiveEmbedder } from '../../embedders/schema.js';\n24:// A prompt reaches the caller's hook budget, so the embedding must never wait\n114:    super(`prompt embedding timed out after ${timeoutMs} ms`);\n...\n12:} from '../../embedders/adapters/ollama.js';\n13:import { getAdapter } from '../../embedders/registry.js';\n14:import { getActiveEmbedder } from '../../embedders/schema.js';\n38:  readonly disabledReason: string | null;\n49:  disabledReason: null,\n160:        disabledReason: 'database_absent',\n171:        disabledReason: 'adapter_unavailable',\n174:      throw new Error(`active embedder is not registered: ${active.name}`);\n180:        disabledReason: 'dim_mismatch',\n183:      throw new Error(`active embedder dimension mismatch: ${active.name} reports ${adapter.dim}, pointer expects ${active.dim}`);\n206:      disabledReason: vector ? null : 'prompt_embedding_empty',\n213:      setRuntimeHealth({ disabledReason: promptEmbeddingDisabledReason(error) });\n242:    setRuntimeHealth({ disabledReason: 'projection_embedding_stale' });\n278:      setRuntimeHealth({ disabledReason: 'skill_embedding_load_failed' });\n305:    setRuntimeHealth({ disabledReason: 'projection_embedding_stale' });\n354:      setRuntimeHealth({ disabledReason: 'skill_embedding_load_failed' });\n361:    setRuntimeHealth({ disabledReason: 'no_skill_vectors' });\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"cd .skilled/skills/system-skill-advisor/runtime; sed -n '1,120p' lib/scorer/lanes/semantic-shadow.ts | grep -n \\\"env\\\\|embed\\\\|enabled\\\\|OLLAMA\\\" ; echo \\\"...\\\"; grep