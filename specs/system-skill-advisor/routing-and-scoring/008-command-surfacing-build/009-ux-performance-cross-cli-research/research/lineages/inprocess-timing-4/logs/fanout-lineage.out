"}}\n{\"mode\":\"shape-live\",\"index\":9,\"id\":\"cmd-doctor-setup-typed-01\",\"split\":\"none\",\"inProcessMs\":29.474791000000096,\"fallbackMs\":188.16316599999982,\"rawTop\":{\"top\":\"command-doctor-setup\",\"command\":\"/doctor:setup\",\"needsMode\":false,\"kind\":\"command\"},\"naive\":{\"top\":\"command-doctor-setup\",\"command\":\"/doctor:setup\",\"count\":1,\"commandKept\":true},\"corrected\":{\"top\":\"command-doctor-setup\",\"command\":\"/doctor:setup\",\"count\":1,\"commandKept\":true},\"fallback\":{\"top\":\"command-doctor-setup\",\"command\":\"/doctor:setup\",\"count\":1,\"commandKept\":true},\"fallbackRawTop\":{\"top\":\"command-doctor-setup\",\"command\":null,\"needsMode\":false,\"kind\":\"command\"}}\n{\"mode\":\"shape-live\",\"index\":10,\"id\":\"synthetic-sk-doc-hub\",\"split\":\"tune\",\"inProcessMs\":74.11779099999967,\"fallbackMs\":169.81112499999972,\"rawTop\":{\"top\":\"sk-doc\",\"command\":null,\"needsMode\":true,\"kind\":\"skill\"},\"naive\":{\"top\":\"sk-doc\",\"command\":null,\"count\":2,\"commandKept\":false},\"corrected\":{\"top\":\"sk-doc\",\"command\":null,\"count\":2,\"commandKept\":false},\"fallback\":{\"top\":\"sk-doc\",\"command\":null,\"count\":1,\"commandKept\":false},\"fallbackRawTop\":{\"top\":\"sk-doc\",\"command\":null,\"needsMode\":false,\"kind\":\"skill\"}}\n{\"mode\":\"shape-live\",\"index\":11,\"id\":\"synthetic-deep-loop-hub\",\"split\":\"tune\",\"inProcessMs\":59.2260839999999,\"fallbackMs\":172.12275,\"rawTop\":{\"top\":\"system-deep-loop\",\"command\":null,\"needsMode\":true,\"kind\":\"skill\"},\"naive\":{\"top\":\"system-deep-loop\",\"command\":null,\"count\":2,\"commandKept\":false},\"corrected\":{\"top\":\"system-deep-loop\",\"command\":null,\"count\":2,\"commandKept\":false},\"fallback\":{\"top\":\"system-deep-loop\",\"command\":null,\"count\":1,\"commandKept\":false},\"fallbackRawTop\":{\"top\":\"system-deep-loop\",\"command\":null,\"needsMode\":false,\"kind\":\"skill\"}}\n--- err ---\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"L=specs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/009-ux-performance-cross-cli-research/research/lineages/inprocess-timing-4\\nexport SYSTEM_SKILL_ADVISOR_DB_DIR=\\\"$PWD/$L/scratch/db\\\"\\nexport SPECKIT_SKILL_ADVISOR_FORCE_LOCAL=1\\nnode \\\"$L/scratch/timing-handler.mjs\\\" shape-live > \\\"$L/scratch/shape-live.jsonl\\\" 2> \\\"$L/scratch/shape-live.err\\\"; echo \\\"EXIT=$?\\\"; cat \\\"$L/scratch/shape-live.jsonl\\\"; echo \\\"--- err ---\\\"; cat \\\"$L/scratch/shape-live.err\\\"\",\"timeout\":240000}"},"time":{"start":1794570769682,"end":1794570774048}}}}
