-cli-fallback.ts:551:  const timeoutMs = resolveSkillAdvisorCliFallbackTimeoutMs(options.timeoutMs, env);\nhooks/lib/skill-advisor-cli-fallback.ts:570:  const remainingMs = Math.max(1, Math.floor(timeoutMs - (now() - startedAt)));\nhooks/lib/skill-advisor-cli-fallback.ts:571:  const cli = await runCliRecommend({ paths, prompt, options, env, timeoutMs: remainingMs });\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"cd .skilled/skills/system-skill-advisor; grep -rn \\\"2500\\\\|2_500\\\\|2.5 s\\\\|2500ms\\\" hooks/lib/*.ts hooks/claude/*.ts runtime/lib/subprocess.ts 2>/dev/null | head -20; echo \\\"=== timeout defaults ===\\\"; grep -rn \\\"timeoutMs\\\" hooks/lib/skill-advisor-cli-fallback.ts | head -20\"}"},"time":{"start":1794570247748,"end":1794570248971}}}}
