 { ...eventRecord };\n278:   delete data.event;\n279:   const built = buildStem(mode, eventName, scopeRunId);\n280:   writeFileSync(\n281:     join(eventDir, `${eventName}.json`),\n282:     JSON.stringify({ stem: built.stem, scope: built.scope, data }),\n283:     'utf8',\n284:   );\n285: }\n286: \n287: // ───────────────────────────────────────────────────────────────────\n288: // 4. CORE LOGIC\n289: // ───────────────────────────────────────────────────────────────────\n290: \n291: function closeOut(args) {\n292:   const mode = args.mode;\n293:   const fields = FINDING_FIELDS[mode];\n294:   const scopeRunId = basename(dirname(args.stateLog)) || mode;\n295:   const registry = readJson(args.registry);\n296:   const evidence = registryEvidence(mode, registry);\n297:   const lineageLogs = lineageStateLogs(args.artifactDir, mode);\n298:   const parsedState = (lineageLogs.length > 0 ? lineageLogs : [args.stateLog])\n299:     .map(readJsonl)\n300:     .map((entry) => ({ ...entry, records: latestIterationRecords(entry.records) }));\n301:   const stateRecords = parsedState.flatMap((entry) => entry.records);\n302:   const stateParseFailureCount = parsedState.reduce((sum, entry) => sum + entry.parseFailures, 0);\n303:   const totalIterations = stateRecords.filter((record) => record && record.type === 'iteration').length;\n304:   const iterationFindingCount = stateRecords.reduce(\n305:     (sum, record) => sum + countIterationFindings(record, fields),\n306:     0,\n307:   );\n308:   const identifiableFindingGroups = stateRecords.flatMap(\n309:     (record) => collectIterationFindingGroups(record, fields),\n310:   );\n311:   const registryFindingKeys = new Set(evidence.keys);\n312:   const missingStructuredFindingGroups = identifiableFindingGroups\n313:     .filter((keys) => !keys.some((key) => registryFindingKeys.has(key)));\n314:   const missingStructuredFindingCount = countDistinctFindings(\n315:     missingStructuredFindingGroups.map((keys) => keys[0]),\n316:   );\n317:   c