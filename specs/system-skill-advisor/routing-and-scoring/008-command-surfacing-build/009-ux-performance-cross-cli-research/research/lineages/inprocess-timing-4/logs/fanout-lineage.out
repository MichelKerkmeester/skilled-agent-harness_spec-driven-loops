fs';\nimport net from 'node:net';\nimport { createRequire } from 'node:module';\nimport path from 'node:path';\nimport { StringDecoder } from 'node:string_decoder';\nimport { fileURLToPath } from 'node:url';\n\nimport {\n  SKILL_ADVISOR_CLI_TOOL_MANIFEST,\n  type SkillAdvisorCliToolDefinition,\n} from './skill-advisor-cli-manifest.js';\n\nimport { commandRowFor } from './lib/command-attach.js';\nimport { SKILL_ADVISOR_COMPAT_CONTRACT } from './lib/compat/contract.js';\nimport { runAdvisorSubprocess, type AdvisorRecommendation } from './lib/subprocess.js';\n\n// ───────────────────────────────────────────────────────────────────\n// 2. CONSTANTS\n// ───────────────────────────────────────────────────────────────────\nconst ADVISOR_PROTOCOL_VERSION = '1';\nconst DEFAULT_TIMEOUT_MS = 30_000;\nconst DEFAULT_SOCKET_DIR = '/tmp/system-skill-advisor';\n// A cold call starts the daemon and waits for it, but never past this. The measured\n// cold start is well inside it, and the stall this replaces came from waiting out the\n// tool timeout on a daemon that never accepted a connection — not from waiting at all.\nconst COLD_START_WAIT_MS = 5_000;\n// The launcher's lease, which records when the running daemon was launched.\nconst LAUNCHER_LEASE_FILE_NAME = '.system-skill-advisor-launcher.json';\nconst ADVISOR_VALIDATE_MAX_ATTEMPTS = 3;\nconst ADVISOR_VALIDATE_RETRY_BASE_DELAY_MS = 250;\nconst RESERVED_COMMANDS = new Set(['list-tools', 'completion']);\n// The CLI's own last resort when no daemon answers: the checked-in Python scorer\n// still routes locally, so an unreachable daemon degrades a recommendation\n// instead of failing the call and leaving every caller to build this path again.\nconst LOCAL_SCORER_TIMEOUT_MS = 5_000;\nconst LOCAL_SCORER_SOURCE = 'local-scorer';\n// The same values are passed to the scorer and reported back, so the degraded\n// envelope cannot advertise a threshold the scorer did not apply.\nconst LOCAL_SCORER_THRESHOLDS = {\n  confidenceThreshold: SKILL_ADVISOR_COMPAT_CONTRACT.defaults.confidenceThreshold,\n  uncertaintyThreshold: SKILL_ADVISOR_COMPAT_CONTRACT.defaults.uncertaintyThreshold,\n  confidenceOnly: false,\n} as const;\n\nconst EXIT_SUCCESS = 0;\nconst EXIT_RUNTIME = 1;\nconst EXIT_USAGE = 64;\nconst EXIT_PROTOCOL = 69;\nconst EXIT_RETRYABLE = 75;\n\n// ───────────────────────────────────────────────────────────────────\n// 3. TYPE DEFINITIONS\n// ───────────────────────────────────────────────────────────────────\ntype OutputFormat = 'json' | 'text' | 'jsonl';\ntype ToolListMode = 'full' | 'compact' | 'names-only';\ntype CompletionShell = 'bash' | 'zsh';\n\ninterface ParsedCommand {\n  readonly command: string;\n  readonly format: OutputFormat;\n  readonly timeoutMs: number;\n  readonly sessionId?: string;\n  readonly warmOnly: boolean;\n  readonly toolListMode: ToolListMode;\n  readonly completionShell?: CompletionShell;\n  readonly args: Record<string, unknown>;\n  readonly jsonFromStdin?: boolean;\n  readonly help: boolean;\n  readonly version: boolean;\n  readonly trusted: boolean;\n  readonly promptTime: boolean;\n}\n\ninterface CliIo {\n  readonly stdout: Pick<NodeJS.WriteStream, 'write'>;\n  readonly stderr: Pick<NodeJS.WriteStream, 'write'>;\n  readonly readStdin?: () => Promise<string>;\n}\n\ninterface RepoPaths {\n  readonly opencodeDir: string;\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"./tests/legacy/advisor-timing.vitest.ts:12:import { runAdvisorSubprocess } from '../../lib/subprocess.js';\n./tests/legacy/advisor-timing.vitest.ts:19:  runAdvisorSubprocess: vi.fn(),\n./tests/legacy/advisor-timing.vitest.ts:49:  vi.mocked(runAdvisorSubprocess).mockResolvedValue({\n./tests/legacy/advisor-timing.vitest.ts:83:  vi.mocked(runAdvisorSubprocess).mockReset();\n./tests/legacy/advisor-privacy.vitest.ts:13:import { runAdvisorSubprocess } from '../../lib/subprocess.js';\n./tests/legacy/advisor-privacy.vitest.ts:27:  