{"type":"tool_use","timestamp":1794570216845,"sessionID":"ses_e2b4abdd3ffe0ORlG2coZj9Q9y","part":{"partID":"prt_1d4b8640d002j8uUvCsH63umcQ","sessionID":"ses_e2b4abdd3ffe0ORlG2coZj9Q9y","messageID":"msg_1d4b83544001fjrFh3OGkv54Hg","type":"tool","id":"call_a8fd8f2ad79d45c9a6e1eaaa","tool":"read","state":{"status":"completed","input":{"limit":90,"offset":270,"path":".skilled/skills/system-skill-advisor/runtime/lib/skill-graph/skill-graph-db.ts"},"output":"Read file .skilled/skills/system-skill-advisor/runtime/lib/skill-graph/skill-graph-db.ts, lines 270-359\n270:     title TEXT,\n271:     description TEXT,\n272:     trigger_phrases TEXT NOT NULL,\n273:     importance_tier TEXT NOT NULL DEFAULT 'normal',\n274:     context_type TEXT NOT NULL DEFAULT 'general',\n275:     content_hash TEXT NOT NULL,\n276:     indexed_at TEXT DEFAULT (datetime('now')),\n277:     UNIQUE(skill_id, doc_path)\n278:   );\n279: \n280:   CREATE INDEX IF NOT EXISTS idx_skill_docs_skill ON skill_docs(skill_id);\n281: \n282:   CREATE INDEX IF NOT EXISTS idx_skill_nodes_family ON skill_nodes(family);\n283:   CREATE INDEX IF NOT EXISTS idx_skill_nodes_category ON skill_nodes(category);\n284:   CREATE INDEX IF NOT EXISTS idx_skill_nodes_hash ON skill_nodes(content_hash);\n285:   CREATE INDEX IF NOT EXISTS idx_skill_edges_source ON skill_edges(source_id, edge_type);\n286:   CREATE INDEX IF NOT EXISTS idx_skill_edges_target ON skill_edges(target_id, edge_type);\n287:   CREATE INDEX IF NOT EXISTS idx_skill_edges_type ON skill_edges(edge_type);\n288: `;\n289: \n290: // ───────────────────────────────────────────────────────────────\n291: // 4. DATABASE LIFECYCLE\n292: // ───────────────────────────────────────────────────────────────\n293: \n294: let db: Database.Database | null = null;\n295: let dbPath: string | null = null;\n296: let readOnlyDb: Database.Database | null = null;\n297: \n298: // The env override is read on every call (never captured at module load) so a\n299: // diagnostic probe and the writing daemon always agree on the artifact path\n300: // even if the override is set after either module first loaded. `baseRoot`\n301: // defaults to the writer's cwd; a caller resolving for a specific workspace\n302: // (e.g. the status probe) passes that root so both sides target one file.\n303: export function resolveSkillGraphDbDir(baseRoot: string = process.cwd()): string {\n304:   const overrideDbDir = process.env.SYSTEM_SKILL_ADVISOR_DB_DIR;\n305:   if (overrideDbDir) {\n306:     return resolve(overrideDbDir);\n307:   }\n308:   // Anchor to the real repo root. A default `process.cwd()` inside a\n309:   // specs/<packet> directory would otherwise plant the skill-graph database\n310:   // under that packet; the anchored resolver can never land inside an .skilled\n311:   // tree, so the DB always resolves to one file at the workspace root.\n312:   return resolve(\n313:     findAdvisorWorkspaceRoot(baseRoot),\n314:     '.skilled',\n315:     'skills',\n316:     'system-skill-advisor',\n317:     'runtime',\n318:     'database',\n319:   );\n320: }\n321: \n322: export function getSkillGraphDbPath(): string {\n323:   return dbPath ?? join(resolveSkillGraphDbDir(), DB_FILENAME);\n324: }\n325: \n326: const CORRUPTION_REASON_PATTERN = /SQLITE_CORRUPT|SQLITE_NOTADB|database disk image is malformed|file is not a database|malformed/i;\n327: const TRANSIENT_REASON_PATTERN = /database is locked|SQLITE_BUSY|SQLITE_LOCKED|SQLITE_PROTOCOL|EIO|EPERM|EACCES|EROFS|ENOSPC/i;\n328: \n329: /**\n330:  * Only genuine on-disk corruption may trigger destructive recovery.\n331:  *\n332:  * Transient conditions (lock contention from a concurrent daemon, I/O or\n333:  * permission errors) must never rename/delete the live database out from\n334:  * under its owner, so they fail this check and initDb proceeds to a normal\n335:  * open (busy_timeout handles contention).\n336:  */\n337: export function isGenuineCorruptionReason(reason: string): boolean {\n338:   if (reason.startsWith('SQLITE_CHECK_FAILED') || TRANSIENT_REASON_PATTERN.test(reason)) {\n339:     return false;\n340:   }\n341:   // quick_check completed and reported integrity violations\n342:   if (reason.startsWith('SQLITE_QUICK_CHECK_')) {\n343:     return true;\n344:   }\n345:   return CORRUPTION_REASON_PATTERN.test(reason);\n346: }\n347: \n348: function recoverMalformedDatabase(databasePath: string, reason: string): void {\n349:   if (!existsSync(databasePath)) {\n350:     return;\n351:   }\n352: \n353:   const backupPath = join(dirname(databasePath), `${DB_FILENAME}.${Date.now()}.corrupt`);\n354:   try {\n355:     renameSync(databasePath, backupPath);\n356:   } catch {\n357:     rmSync(databasePath, { force: true });\n358:   }\n359:   console.warn(`[skill-graph] Recovered malformed SQLite database via initDb quick_check (${reason})`);\n[Output truncated. Continue reading with offset: 360]","title":"read","metadata":{"metadata":{"truncated":true},"content":[{"type":"text","text":"Read file .skilled/skills/system-skill-advisor/runtime/lib/skill-graph/skill-graph-db.ts, lines 270-359\n270:     title TEXT,\n271:     description TEXT,\n272:     trigger_phrases TEXT NOT NULL,\n273:     importance_tier TEXT NOT NULL DEFAULT 'normal',\n274:     context_type TEXT NOT NULL DEFAULT 'general',\n275:     content_hash TEXT NOT NULL,\n276:     indexed_at TEXT DEFAULT (datetime('now')),\n277:     UNIQUE(skill_id, doc_path)\n278:   );\n279: \n280:   CREATE INDEX IF NOT EXISTS idx_skill_docs_skill ON skill_docs(skill_id);\n281: \n282:   CREATE INDEX IF NOT EXISTS idx_skill_nodes_family ON skill_nodes(family);\n283:   CREATE INDEX IF NOT EXISTS idx_skill_nodes_category ON skill_nodes(category);\n284:   CREATE INDEX IF NOT EXISTS idx_skill_nodes_hash ON skill_nodes(content_hash);\n285:   CREATE INDEX IF NOT EXISTS idx_skill_edges_source ON skill_edges(source_id, edge_type);\n286:   CREATE INDEX IF NOT EXISTS idx_skill_edges_target ON skill_edges(target_id, edge_type);\n287:   CREATE INDEX IF NOT EXISTS idx_sk