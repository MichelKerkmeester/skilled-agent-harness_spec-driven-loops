nd\": \"file\", \"source\": \"AGENTS.md\" },\n.skilled/commands/doctor/scripts/agents-md-embed.cjs:92:  'CLAUDE.md',\n.skilled/commands/doctor/scripts/agents-md-embed.cjs:101:const FOLDED_COPIES = ['CLAUDE.md', '.codex/AGENTS.md'];\n.skilled/commands/doctor/scripts/agents-md-embed.cjs:111:  '  --keep-claude-md           fold a divergent CLAUDE.md into the block but keep the file',\n.skilled/commands/doctor/scripts/agents-md-embed.cjs:746:    if (copy.path === 'CLAUDE.md' && keepClaudeMd) {\n.skilled/commands/doctor/assets/agents-md-manifest.json:738:      \"path\": \"CLAUDE.md\",\n.skilled/commands/doctor/assets/agents-md-manifest.json:777:      \"path\": \"~/.claude/CLAUDE.md\",\n.skilled/commands/doctor/assets/doctor-symlink-link.yaml:55:  link_instructions: \"When true, pass --link-instructions to include AGENTS.md, CLAUDE.md and REPO RULES.md.\"\n.skilled/commands/doctor/assets/doctor-agents-md-embed.yaml:29:    - \"CLAUDE.md, folded into the block and removed by default; kept, with its lines still moved into the block, when --keep-claude-md was given\"\n.skilled/commands/doctor/assets/doctor-agents-md-embed.yaml:64:  keep_claude_md: \"--keep-claude-md folds a divergent CLAUDE.md into the block and keeps the file; --remove-claude-md folds it and removes it, which is the default (default false, so removal).\"\n.skilled/commands/doctor/scripts/tests/agents-md-embed.test.cjs:414:    removed: [{ path: 'CLAUDE.md', content: '# Notes\\n\\nRun the checks first.\\n' }],\n.skilled/commands/doctor/scripts/tests/agents-md-embed.test.cjs:634:  const claude = readInside(dir, 'CLAUDE.md');\n.skilled/commands/doctor/scripts/tests/agents-md-embed.test.cjs:638:  assert.equal(existsInside(dir, 'CLAUDE.md'), false, 'the folded copy is gone');\n.skilled/commands/doctor/scripts/tests/agents-md-embed.test.cjs:643:  assert.equal(readInside(dir, 'CLAUDE.md'), claude, 'the removed file is recreated byte for byte');\n.skilled/commands/doctor/scripts/tests/agents-md-embed.test.cjs:835:  f