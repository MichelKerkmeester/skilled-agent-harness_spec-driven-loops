= result.recommendations.find((entry) => entry.skill === skillId);\\n113:   expect(recommendation).toBeDefined();\\n114:   return recommendation?.laneContributions.find((entry) => entry.lane === 'semantic_shadow')?.evidence ?? [];\\n115: }\\n116: \\n117: // ───────────────────────────────────────────────────────────────────\\n118: // 2. TESTS\\n119: // ───────────────────────────────────────────────────────────────────\\n120: \\n121: describe('semantic prompt embedding degrade matrix', () => {\\n122:   beforeEach(() => {\\n123:     vi.stubEnv('VITEST', 'false');\\n124:     vi.spyOn(console, 'warn').mockImplementation(() => {});\\n125:     for (const mock of Object.values(mocks)) {\\n126:       mock.mockReset();\\n127:     }\\n128: \\n129:     mocks.getDbReadOnly.mockReturnValue({ name: 'mocked-read-only-database' });\\n130:     mocks.getActiveEmbedder.mockReturnValue({ name: 'nomic-embed-text:v1.5', dim: 2 });\\n131:     mocks.getAdapter.mockReturnValue({\\n132:       name: 'nomic-embed-text:v1.5',\\n133:       dim: 2,\\n134:       backend: 'ollama',\\n135:       embed: mocks.embed,\\n136:     });\\n137:     mocks.loadSkillEmbeddings.mockReturnValue([\\n138:       { skillId: 'alpha-skill', embedding: new Float32Array([1, 0]), modelId: 'nomic-embed-text-v1.5', contentHash: 'hash-alpha' },\\n139:       { skillId: 'beta-skill', embedding: new Float32Array([0, 1]), modelId: 'nomic-embed-text-v1.5', contentHash: 'hash-beta' },\\n140:     ]);\\n141:   });\\n142: \\n143:   afterEach(() => {\\n144:     vi.unstubAllEnvs();\\n145:     vi.restoreAllMocks();\\n146:   });\\n147: \\n148:   it('scores a warm answer with a cosine', async () => {\\n149:     mocks.embed.mockResolvedValue([WARM_VECTOR]);\\n150: \\n151:     const result = await withSemanticShadowPromptEmbedding(PROMPT, score);\\n152: \\n153:     expect(mocks.embed).toHaveBeenCalledWith([PROMPT], { inputType: 'query' });\\n154:     expect(semanticEvidence(result, 'alpha-skill')).toContain('cosine:1.0000');\\n155:     expect(getSemanticShadowRuntimeHealth().disabledReason).toBeNull();\\n156:   });\\n157: \\n158:   it('scores a cold answer at 300 ms with a cosine', async () => {\\n159:     mocks.embed.mockImplementation(() => new Promise<Float32Array[]>((resolve) => {\\n160:       setTimeout(() => resolve([WARM_VECTOR]), COLD_DELAY_MS);\\n161:     }));\\n162: \\n163:     const startedAt = performance.now();\\n164:     const result = await withSemanticShadowPromptEmbedding(PROMPT, score);\\n165:     const elapsedMs = performance.now() - startedAt;\\n166: \\n167:     expect(elapsedMs).toBeGreaterThanOrEqual(COLD_DELAY_MS);\\n168:     expect(elapsedMs).toBeLessThan(PROMPT_EMBEDDING_DEADLINE_MS);\\n169:     expect(semanticEvidence(result, 'alpha-skill')).toContain('cosine:1.0000');\\n170:     expect(getSemanticShadowRuntimeHealth().disabledReason).toBeNull();\\n171:   });\\n172: \\n173:   it('reports an absent server and scores without the cosine lane', async () => {\\n174:     mocks.embed.mockRejectedValue(new OllamaBackendUnreachableError('http://127.0.0.1:11434'));\\n175: \\n176:     const result = await withSemanticShadowPromptEmbedding(PROMPT, score);\\n177: \\n178:     expect(getSemanticShadowRuntimeHealth().disabledReason).toBe('prompt_embedding_unreachable');\\n179:     expect(semanticEvidence(result, 'alpha-skill')).toEqual([]);\\n180:   });\\n181: \\n182:   it('reports a missing model and scores without the cosine lane', async () => {\\n183:     mocks.embed.mockRejectedValue(new OllamaModelNotLoadedError('nomic-embed-text:v1.5'));\\n184: \\n185:     const result = await withSemanticShadowPromptEmbedding(PROMPT, score);\\n186: \\n187:     expect(getSemanticShadowRuntimeHealth().disabledReason).toBe('prompt_embedding_model_missing');\\n188:     expect(semanticEvidence(result, 'alpha-skill')).toEqual([]);\\n189:   });\\n190: \\n191:   it('returns inside the deadline plus 100 ms when no answer arrives', async () => {\\n192:     mocks.embed.mockImplementation(() => new Promise<Float32Array[]>(() => {}));\\n193: \\n194:     const startedAt = performance.now();\\n195:     const result = await withSemanticShadowPromptEmbedding(PROMPT, score);\\n196:     const elapsedMs = performance.now() - startedAt;\\n197: \\n198:     expect(elapsedMs).toBeLessThan(PROMPT_EMBEDDING_DEADLINE_MS + DEADLINE_SLACK_MS);\\n199:     expect(result.recommendations.length).toBeGreaterThan(0);\\n200:     expect(getSemanticShadowRuntimeHealth().disabledReason).toBe('prompt_embedding_timeout');\\n201:   });\\n202: \\n203:   it('leaves the result equal to the no-embedder result after a failure', async () => {\\n204:     mocks.embed.mockRejectedValue(new OllamaAdapterError('embedding failed'));\\n205: \\n206:     const noEmbedder = score();\\n207:     const degraded = await withSemanticShadowPromptEmbedding(PROMPT, score);\\n208: \\n209:     expect(getSemanticShadowRuntimeHealth().disabledReason).toBe('prompt_embedding_failed');\\n210:     expect(degraded).toEqual(noEmbedder);\\n211:   });\\n212: });\"}],\"providerCall\":{\"executed\":false},\"providerResult\":{\"executed\":false},\"rawInput\":\"{\\\"path\\\":\\\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/tests/semantic-prompt-embedding-degrade.vitest.ts\\\"}\"},\"time\":{\"start\":1794535427836,\"end\":1794535428257}}}}\nspecs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/008-embedder-setup-and-cost/scratch/logs/w3-T019.out:145:{\"type\":\"text\",\"timestamp\":1794535458973,\"sessionID\":\"ses_e2d61a837fferT6vx7XBcnnvGb\",\"part\":{\"id\":\"prt_1d2a5f6dc001nahKCc5r512kDV\",\"sessionID\":\"ses_e2d61a837fferT6vx7XBcnnvGb\",\"messageID\":\"msg_1d2a5e923001lC21Do0YzFlHx4\",\"type\":\"text\",\"text\":\"T019 complete.\\n\\n**File written**\\n- `.skilled/skills/system-skill-advisor/runtime/tests/semantic-prompt-embedding-degrade.vitest.ts` (new, 212 lines)\\n\\nThe test mocks the adapter (`getAdapter`), the active pointer (`getActiveEmbedder`) and the read-only database (`getDbReadOnly`), stubs `VITEST` to `false` per case via `vi.stubEnv` in `beforeEach`, and runs scoring through the real `scoreAdvisorPrompt` against a `sqlite`-source projection. Six rows, matching the plan's matrix (listed in the file header):\\n\\n1. warm answer inside the deadline, cosine `1.0000`\\n2. cold answer at 300 ms, still inside the deadline, cosine `1.0000`\\n3. absent server → `prompt_embedding_unreachable`\\n4. missing model → `prompt_embedding_model_missing`\\n5. answer that never arrives → returns under `PROMPT_EMBEDDING_DEADLINE_MS + 100` with `prompt_embedding_timeout`\\n6. generic failure → `prompt_embedding_failed`, result deep-equals the no-embedder result\\n\\n**Verify** (`$ADV` → `npx vitest run tests/semantic-prompt-embedding-degrade.vitest.ts`)\\n\\n```\\n RUN  v4.1.12 /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime\\n\\n Test Files  1 passed (1)\\n      Tests  6 passed (6)\\n   Start at  03:04:07\\n   Duration  1.54s (transform 238ms, setup 24ms, import 326ms, tests 1.07s, environment 0ms)\\n```\\n\\n**Evidence checks**\\n- Comment hygiene: `rg -n \\\"T0[0-9]{2}|REQ-0|specs/\\\"` over the new file exits 1 (no matches).\\n- `git status --short` shows only the new test file as my addition. Other modified/untracked paths belong to other workers and were left untouched. `tasks.md` was not ticked.\\n\\n**Could not do / notes**\\n- Initial run failed all six because I first wrote the test under `tests/` with `../../lib/...` specifiers. Corrected to `../lib/...` before the passing run. No source files were changed.\",\"time\":{\"start\":1794535454428,\"end\":1794535458973}}}\n\n[showing lines 11-15 of 15; full output saved to /Users/michelkerkmeester/.local/share/opencode/shell/4c10847297631c3af43d766cf1908920fe00c449/sh_1d2efb8d6001NNp0vUKWtaY3GF.out]"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"cd /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research && rg -n \\\"538\\\\.53|4\\\\.8 ms|PROMPT_EMBEDDING_DEADLINE_MS\\\" --glob '!**/node_modules/**' --glob '!**/dist/**' .skilled specs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build 2>/dev/null | head -15\"}"},"time":{"start":1794540287304,"end":1794540288570}}}}
