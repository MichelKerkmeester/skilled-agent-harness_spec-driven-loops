{"type":"tool_use","timestamp":1794540062711,"sessionID":"ses_e2d1cc122ffeqzrRrTg65W0LsJ","part":{"partID":"prt_1d2ec45b1002EgatxvtQ2c3ZT1","sessionID":"ses_e2d1cc122ffeqzrRrTg65W0LsJ","messageID":"msg_1d2ec167f001zNt5CYMtNIZNUf","type":"tool","id":"chatcmpl-tool-835600f971d535b0","tool":"shell","state":{"status":"completed","input":{"command":"cd /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research && sed -n '1,80p' .skilled/skills/system-skill-advisor/runtime/lib/scorer/lanes/semantic-shadow.ts && grep -n \"weight\\|0\\.\\|text\\|embedding\" .skilled/skills/system-skill-advisor/runtime/lib/scorer/lanes/semantic-shadow.ts | head -30"},"output":"// ───────────────────────────────────────────────────────────────\n// MODULE: Semantic Shadow Lane\n// ───────────────────────────────────────────────────────────────\n\n// ───────────────────────────────────────────────────────────────────\n// 1. IMPORTS\n// ───────────────────────────────────────────────────────────────────\nimport {\n  OllamaBackendUnreachableError,\n  OllamaModelNotLoadedError,\n  OllamaRequestTimeoutError,\n} from '../../embedders/adapters/ollama.js';\nimport { getAdapter } from '../../embedders/registry.js';\nimport { getActiveEmbedder } from '../../embedders/schema.js';\nimport { getDbReadOnly, loadSkillEmbeddings } from '../../skill-graph/skill-graph-db.js';\nimport { scoreTokenOverlap, tokenizePrompt } from '../text.js';\nimport type { AdvisorProjection, LaneMatch } from '../types.js';\n\n// ───────────────────────────────────────────────────────────────────\n// 2. CONSTANTS\n// ───────────────────────────────────────────────────────────────────\nconst COSINE_THRESHOLD = 0.2;\n\n// A prompt reaches the caller's hook budget, so the embedding must never wait\n// on a cold model load or a wedged request. Past this deadline the lane degrades\n// to phrase scoring for the call instead of stalling it.\nexport const PROMPT_EMBEDDING_DEADLINE_MS = 750;\n\nlet activePromptEmbedding: { prompt: string; vector: Float32Array } | null = null;\n\n// ───────────────────────────────────────────────────────────────────\n// 3. TYPE DEFINITIONS\n// ───────────────────────────────────────────────────────────────────\nexport interface SemanticShadowRuntimeHealth {\n  readonly checkedAt: string;\n  readonly activeEmbedder: { readonly name: string; readonly dim: number; readonly adapterDim: number | null } | null;\n  readonly dimMismatch: boolean;\n  readonly disabledReason: string | null;\n  readonly lastPromptEmbeddingAt: string | null;\n}\n\n// ───────────────────────────────────────────────────────────────────\n// 4. RUNTIME HEALTH\n// ───────────────────────────────────────────────────────────────────\nlet runtimeHealth: SemanticShadowRuntimeHealth = {\n  checkedAt: new Date(0).toISOString(),\n  activeEmbedder: null,\n  dimMismatch: false,\n  disabledReason: null,\n  lastPromptEmbeddingAt: null,\n};\n\nfunction setRuntimeHealth(update: Partial<SemanticShadowRuntimeHealth>): void {\n  runtimeHealth = {\n    ...runtimeHealth,\n    ...update,\n    checkedAt: new Date().toISOString(),\n  };\n}\n\nexport function getSemanticShadowRuntimeHealth(): SemanticShadowRuntimeHealth {\n  return runtimeHealth;\n}\n\n// ───────────────────────────────────────────────────────────────────\n// 5. HELPERS\n// ───────────────────────────────────────────────────────────────────\nfunction toFloat32Array(vector: Float32Array | readonly number[]): Float32Array {\n  return vector instanceof Float32Array ? vector : Float32Array.from(vector);\n}\n\nfunction cosineSimilarity(left: Float32Array, right: Float32Array): number {\n  const length = Math.min(left.length, right.length);\n  if (length === 0) {\n    return 0;\n  }\n\n  let dot = 0;\n  let leftNorm = 0;\n  let rightNorm = 0;\n16:import { scoreTokenOverlap, tokenizePrompt } from '../text.js';\n22:const COSINE_THRESHOLD = 0.2;\n24:// A prompt reaches the caller's hook budget, so the embedding must never wait\n96:function fixtureVector(text: string): Float32Array {\n97:  const normalized = text.toLowerCase().split(/\\W+/).filter(Boolean);\n114:    super(`prompt embedding timed out after ${timeoutMs} ms`);\n124:    return 'prompt_embedding_model_missing';\n127:    return 'prompt_embedding_timeout';\n130:    return 'prompt_embedding_unreachable';\n133:  return 'prompt_embedding_failed';\n186:    const embedding = adapter.embed([prompt], { inputType: 'query' });\n189:    embedding.catch(() => undefined);\n198:      [vector] = await Promise.race([embedding, deadline]);\n206:      disabledReason: vector ? null : 'prompt_embedding_empty',\n215:    console.warn(`[semantic-shadow] Prompt embedding failed; cosine lane disabled for this call (${message})`);\n241:  if (projection.embeddingStaleness?.stale) {\n242:    setRuntimeHealth({ disabledReason: 'projection_embedding_stale' });\n274:          .map((row) => [row.skillId, row.embedding]),\n278:      setRuntimeHealth({ disabledReason: 'skill_embedding_load_failed' });\n279:      console.warn(`[semantic-shadow] Exact skill embedding load failed; rerank disabled (${message})`);\n304:  if (projection.embeddingStaleness?.stale) {\n305:    setRuntimeHealth({ disabledReason: 'projection_embedding_stale' });\n321:        ]) * 0.8, 1),\n325:      .filter((match) => match.score > 0.08);\n349:        .map((row) => [row.skillId, row.embedding]),\n354:      setRuntimeHealth({ disabledReason: 'skill_embedding_load_failed' });\n355:      console.warn(`[semantic-shadow] Skill embedding load failed; cosine lane disabled (${message})`);\n376:      // LIVE in the registry (weight 0.05, live=true), so the raw match tags\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"// ───────────────────────────────────────────────────────────────\n// MODULE: Semantic Shadow Lane\n// ───────────────────────────────────────────────────────────────\n\n// ───────────────────────────────────────────────────────────────────\n// 1. IMPORTS\n// ───────────────────────────────────────────────────────────────────\nimport {\n  OllamaBackendUnreachableError,\n  OllamaModelNotLoadedError,\n  OllamaRequestTimeoutError,\n} from '../../embedders/adapters/ollama.js';\nimport { getAdapter } from '../../embedders/registry.js';\nimport { getActiveEmbedder } from '../../embedders/schema.js';\nimport { getDbReadOnly, loadSkillEmbeddings } from '../../skill-graph/skill-graph-db.js';\nimport { scoreTokenOverlap, tokenizePrompt } from '../text.js';\nimport type { AdvisorProjection, LaneMatch } from '../types.js';\n\n// ───────────────────────────────────────────────────────────────────\n// 2. CONSTANTS\n// ───────────────────────────────────────────────────────────────────\nconst COSINE_THRESHOLD = 0.2;\n\n// A prompt reaches the caller's hook budget, so the embedding must never wait\n// on a cold model load or a wedged request. Past this deadline the lane degrades\n// to phrase scoring for the call instead of stalling it.\nexport const PROMPT_EMBEDDING_DEADLINE_MS = 750;\n\nlet activePromptEmbedding: { prompt: string; vector: Float32Array } | null = null;\n\n// ───────────────────────────────────────────────────────────────────\n// 3. TYPE DEFINITIONS\n// ───────────────────────────────────────────────────────────────────\nexport interface SemanticShadowRuntimeHealth {\n  readonly checkedAt: string;\n  readonly activeEmbedder: { readonly name: string; readonly dim: number; readonly adapterDim: number | null } | null;\n  readonly dimMismatch: boolean;\n  readonly disabledReason: string | null;\n  readonly lastPromptEmbeddingAt: string | null;\n}\n\n// ───────────────────────────────────────────────────────────────────\n// 4. RUNTIME HEALTH\n// ───────────────────────────────────────────────────────────────────\nlet runtimeHealth: SemanticShadowRuntimeHealth = {\n  checkedAt: new Date(0).toISOString(),\n  activeEmbedder: null,\n  dimMismatch: false,\n  disabledReason: null,\n  lastPromptEmbeddingAt: null,\n};\n\nfunction setRuntimeHealth(update: Partial<SemanticShadowRuntimeHealth>): void {\n  runtimeHealth = {\n    ...runtimeHealth,\n    ...update,\n    checkedAt: new Date().toISOString(),\n  };\n}\n\nexport function getSemanticShadowRuntimeHealth(): SemanticShadowRuntimeHealth {\n  return runtimeHealth;\n}\n\n// ───────────────────────────────────────────────────────────────────\n// 5. HELPERS\n// ───────────────────────────────────────────────────────────────────\nfunction toFloat32Array(vector: Float32Array | readonly number[]): Float32Array {\n  return vector instanceof Float32Array ? vector : Float32Array.from(vector);\n}\n\nfunction cosineSimilarity(left: Float32Array, right: Float32Array): number {\n  const length = Math.min(left.length, right.length);\n  if (length === 0) {\n    return 0;\n  }\n\n  let dot = 0;\n  let leftNorm = 0;\n  let rightNorm = 0;\n16:import { scoreTokenOverlap, tokenizePrompt } from '../text.js';\n22:const COSINE_THRESHOLD = 0.2;\n24:// A prompt reaches the caller's hook budget, so the embedding must never wait\n96:function fixtureVector(text: string): Float32Array {\n97:  const normalized = text.toLowerCase().split(/\\W+/).filter(Boolean);\n114:    super(`prompt embedding timed out after ${timeoutMs} ms`);\n124:    return 'prompt_embedding_model_missing';\n127:    return 'prompt_embedding_timeout';\n130:    return 'prompt_embedding_unreachable';\n133:  return 'prompt_embedding_failed';\n186:    const embedding = adapter.embed([prompt], { inputType: 'query' });\n189:    embedding.catch(() => undefined);\n198:      [vector] = await Promise.race([embedding, deadline]);\n206:      disabledReason: vector ? null : 'prompt_embedding_empty',\n215:    console.warn(`[semantic-shadow] Prompt embedding failed; cosine lane disabled for this call (${message})`);\n241:  if (projection.embeddingStaleness?.stale) {\n242:    setRuntimeHealth({ disabledReason: 'projection_embedding_stale' });\n274:          .map((row) => [row.skillId, row.embedding]),\n278:      setRuntimeHealth({ disabledReason: 'skill_embedding_load_failed' });\n279:      console.warn(`[semantic-shadow] Exact skill embedding load failed; rerank disabled (${message})`);\n304:  if (projection.embeddingStaleness?.stale) {\n305:    setRuntimeHealth({ disabledReason: 'projection_embedding_stale' });\n321:        ]) * 0.8, 1),\n325:      .filter((match) => match.score > 0.08);\n349:        .map((row) => [row.skillId, row.embedding]),\n354:      setRuntimeHealth({ disabledReason: 'skill_embedding_load_failed' });\n355:      console.warn(`[semantic-shadow] Skill embedding load failed; cosine lane disabled (${message})`);\n376:      // LIVE in the registry (weight 0.05, live=true), so the raw match tags\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\": \"cd /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research && sed -n '1,80p' .skilled/skills/system-skill-advisor/runtime/lib/scorer/lanes/semantic-shadow.ts && grep -n \\\"weight\\\\|0\\\\.\\\\|text\\\\|embedding\\\" .skilled/skills/system-skill-advisor/runtime/lib/scorer/lanes/semantic-shadow.ts | head -30\"}"},"time":{"start":1794540062129,"end":1794540062711}}}}
