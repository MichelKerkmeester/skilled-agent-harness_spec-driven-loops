value).digest(\\\"hex\\\");\\nconst lineage = config.lineage || {};\\nconst sessionId = lineage.sessionId;\\nconst lineageId = lineage.parentSessionId || sessionId;\\nconst generation = Number(lineage.generation) || 1;\\nconst configDigest = sha(raw);\\nconst topic = typeof config.topic === \\\"string\\\" && config.topic.trim() !== \\\"\\\" && config.topic.length <= 4096 ? config.topic : null;\\nconst event = {\\n  stem: \\\"deep_research.run_initialized\\\",\\n  scope: { runId: sessionId, lineageId },\\n  data: {\\n    generation,\\n    ...(topic === null ? {} : { topic }),\\n    charterDigest: sha(Buffer.from(JSON.stringify({ topic: config.topic, specFolder: config.specFolder || \\\"\\\" }))),\\n    configDigest,\\n    executorFingerprint: sha(Buffer.from(JSON.stringify(config.executor || {}))),\\n    replayFingerprint: sha(Buffer.from(JSON.stringify({ runId: sessionId, lineageId, generation, configDigest }))),\\n    maxIterations: Number(config.maxIterations),\\n    convergencePolicyVersion: \\\"convergence-policy@\\\" + ((config.antiConvergence && config.antiConvergence.convergenceMode) || \\\"default\\\"),\\n  },\\n};\\nfs.writeFileSync(outPath, JSON.stringify(event));\\n' specs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/009-ux-performance-cross-cli-research/research/lineages/offer-reach/deep-research-config.json specs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/009-ux-performance-cross-cli-research/research/lineages/offer-reach/prompts/run-open.json && node .skilled/skills/system-deep-loop/runtime/scripts/append-mode-event.cjs --mode research --run-directory specs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/009-ux-performance-cross-cli-research/research/lineages/offer-reach --event-json specs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/009-ux-performance-cross-cli-research/research/lineages/offer-reach/prompts/run-open.json; echo \\\"EXIT=$?\\\"\"}"},"time":{"s