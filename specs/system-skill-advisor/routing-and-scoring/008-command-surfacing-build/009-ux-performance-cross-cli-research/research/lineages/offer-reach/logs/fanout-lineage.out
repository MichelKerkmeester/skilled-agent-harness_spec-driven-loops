and) => command !== null);\n.skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/capture-command-routing-baseline.mjs:513:      rows[row.id] = { expected_command: expected, top: ids[0] ?? null, top1: top1Hit, top3: top3Hit, offered };\n.skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/capture-command-routing-baseline.mjs:523:        if (offered) falseOfferCount += 1;\n.skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/capture-command-routing-baseline.mjs:530:          if (offered) slashOfferedOnPartial += 1;\n.skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/capture-command-routing-baseline.mjs:537:      // A bridge offered below a skill is correct when the skill that outranked\n.skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/capture-command-routing-baseline.mjs:588:          offered_on_partial: slashOfferedOnPartial,\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\": \"cd /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research && grep -rn \\\"COMMAND_MEANING_MIN_COSINE\\\\|commandMeaning\\\\|offered\\\" .skilled/skills/system-skill-advisor/runtime/lib/scorer/fusion.ts | head -20 && grep -rn \\\"offered\\\" .skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/capture-command-routing-baseline.mjs | head -10\"}"},"time":{"start":1794539832280,"end":1794539832897}}}}
