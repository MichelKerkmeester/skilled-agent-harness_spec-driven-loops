t defers, semantic lane weight and embedding text, the doctor family, and scoring thresholds, while false offers stay 0 of 35 and typed recall stays at least 24 of 44 and the scorer floors stay [159,50,20,5].\\\",\\n  \\\"maxIterations\\\": 4,\\n  \\\"convergenceThreshold\\\": 0.05,\\n  \\\"antiConvergence\\\": {\\n    \\\"minIterations\\\": 3,\\n    \\\"convergenceMode\\\": \\\"default\\\",\\n    \\\"stopPolicy\\\": \\\"convergence\\\"\\n  },\\n  \\\"stuckThreshold\\\": 3,\\n  \\\"maxDurationMinutes\\\": 120,\\n  \\\"maxToolCallsPerIteration\\\": 24,\\n  \\\"maxMinutesPerIteration\\\": 10,\\n  \\\"progressiveSynthesis\\\": true,\\n  \\\"specFolder\\\": \\\"specs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/009-ux-performance-cross-cli-research\\\",\\n  \\\"createdAt\\\": \\\"2026-11-13T10:00:00.000Z\\\",\\n  \\\"status\\\": \\\"initialized\\\",\\n  \\\"executionMode\\\": \\\"auto\\\",\\n  \\\"executor\\\": {\\n    \\\"kind\\\": \\\"cli-opencode\\\",\\n    \\\"model\\\": \\\"opencode-go/deepseek-v4.1-flash\\\",\\n    \\\"reasoningEffort\\\": \\\"max\\\",\\n    \\\"serviceTier\\\": null,\\n    \\\"sandboxMode\\\": null,\\n    \\\"timeoutSeconds\\\": 900\\n  },\\n  \\\"lineage\\\": {\\n    \\\"sessionId\\\": \\\"fanout-offer-reach-1794539443568-6stapj\\\",\\n    \\\"parentSessionId\\\": null,\\n    \\\"lineageMode\\\": \\\"new\\\",\\n    \\\"allowedModes\\\": [\\n      \\\"new\\\",\\n      \\\"resume\\\",\\n      \\\"restart\\\"\\n    ],\\n    \\\"deferredModes\\\": [\\n      \\\"fork\\\",\\n      \\\"completed-continue\\\"\\n    ],\\n    \\\"generation\\\": 1,\\n    \\\"continuedFromRun\\\": null\\n  },\\n  \\\"reducer\\\": {\\n    \\\"enabled\\\": true,\\n    \\\"version\\\": \\\"1.0\\\",\\n    \\\"registryFile\\\": \\\"findings-registry.json\\\",\\n    \\\"dashboardFile\\\": \\\"deep-research-dashboard.md\\\",\\n    \\\"strategyFile\\\": \\\"deep-research-strategy.md\\\",\\n    \\\"machineOwnedSections\\\": [\\n      \\\"key-questions\\\",\\n      \\\"answered-questions\\\",\\n      \\\"what-worked\\\",\\n      \\\"what-failed\\\",\\n      \\\"exhausted-approaches\\\",\\n      \\\"ruled-out-directions\\\",\\n      \\\"divergence-frontier\\\",\\n      \\\"next-focus\\\"\\n    ]\\n  },\\n  \\\"capabilityMatrixPath\\\": \\\".skilled/skills/system-deep-loop/deep-research/assets/runtime-capabilities.json\\\",\\n  \\\"capabilityMatrixDocPath\\\": \\\".skilled/skills/system-deep-loop/deep-research/references/guides/capability-matrix.md\\\",\\n  \\\"runtimeCapabilityResolver\\\": \\\".skilled/skills/system-deep-loop/deep-research/scripts/runtime-capabilities.cjs\\\",\\n  \\\"reducerScriptPath\\\": \\\".skilled/skills/system-deep-loop/deep-research/scripts/reduce-state.cjs\\\",\\n  \\\"pauseSentinelPath\\\": \\\".deep-research-pause\\\",\\n  \\\"archiveRoot\\\": \\\"_archive\\\",\\n  \\\"migrationWindowDays\\\": 28,\\n  \\\"resource_map_present\\\": false,\\n  \\\"resource_map\\\": {\\n    \\\"emit\\\": true\\n  },\\n  \\\"nextRunAt\\\": null,\\n  \\\"remainingDelayMs\\\": null,\\n  \\\"fileProtection\\\": {\\n    \\\"deep-research-config.json\\\": \\\"immutable\\\",\\n    \\\"deep-research-state.jsonl\\\": \\\"append-only\\\",\\n    \\\"deep-research-strategy.md\\\": \\\"mutable\\\",\\n    \\\"deep-research-dashboard.md\\\": \\\"auto-generated\\\",\\n    \\\"findings-registry.json\\\": \\\"auto-generated\\\",\\n    \\\"iteration-*.md\\\": \\\"write-once\\\",\\n    \\\"research.md\\\": \\\"mutable\\\"\\n  }\\n}\\n\"}"},"time":{"start":1794539597890,"end":1794539602307}}}}
