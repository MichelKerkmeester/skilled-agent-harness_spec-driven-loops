pMs, ghConfig, arm) {\n1064:   return new Promise((settle) => {\n1065:     // A CLI that reads the prompt from stdin gets a pipe to write it into. Every other\n1066:     // runtime keeps stdin ignored, because an open stdin leaves that CLI waiting on\n1067:     // input nobody types until the cap runs out into an empty transcript.\n1068:     const child = spawn(runtime.command, argv, {\n1069:       cwd: REPO_ROOT,\n1070:       env: childEnv(ghConfig, arm),\n1071:       // Ignored means the child reads /dev/null rather than blocking on a terminal.\n1072:       stdio: [runtime.promptOnStdin ? 'pipe' : 'ignore', 'pipe', 'inherit'],\n1073:       // A chat turn still running after its cap is stuck, while a started workflow\n1074:       // legitimately needs the longer one. The prompt decides which it gets.\n1075:       timeout: capMs,\n1076:     });\n1077:     // The prompt is written and the stream closed at once, so a CLI that reads until\n1078:     // the end of input sees a whole prompt. A CLI that exits before reading leaves a\n1079:     // broken pipe behind, and that write error is the CLI's failure to report rather\n1080:     // than an uncaught error that would end the run early.\n1081:     if (child.stdin !== null) {\n1082:       child.stdin.on('error', () => {});\n1083:       child.stdin.end(prompt);\n1084:     }\n1085:     const locator = streamLocator(runtime.locator.field ?? null);\n1086:     // The turn's own output is still shown, and the locator is read out of the\n1087:     // same bytes, so watching a run and recording it never diverge.\n1088:     child.stdout.setEncoding('utf8');\n1089:     child.stdout.on('data', (chunk) => {\n1090:       locator.push(chunk);\n1091:       process.stdout.write(chunk);\n1092:     });\n1093:     child.on('error', (error) => settle({ exit: null, error, streamId: null }));\n1094:     child.on('close', (exit) => settle({ exit, error: null, streamId: locator.value() }));\n1095:   });\n1096: }\n1097: \n1098: // ─────────────