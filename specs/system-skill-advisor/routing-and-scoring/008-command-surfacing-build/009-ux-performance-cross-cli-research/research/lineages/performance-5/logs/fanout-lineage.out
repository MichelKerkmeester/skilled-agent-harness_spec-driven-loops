valuation | null = input.state.evaluate(\n141:       sessionId,\n142:       parts.directives,\n143:       transcriptPath,\n144:       transcriptBytes,\n145:       isLifecycleBoundary(input.lifecycleEvent),\n146:     );\n147:     if (!evaluated) return FULL_DIRECTIVE_LIFECYCLE_DELIVERY;\n148:     if (evaluated.suppressed) {\n149:       return Object.freeze({ reducedContext: parts.head, suppressed: true });\n150:     }\n151:     return evaluated.record\n152:       ? fullWithReceipt(input.state, sessionId, evaluated.record, input.deferFullReceipt === true)\n153:       : FULL_DIRECTIVE_LIFECYCLE_DELIVERY;\n154:   }\n155: \n156:   const firstClock = input.state.clock(sessionId);\n157:   if (!firstClock) return FULL_DIRECTIVE_LIFECYCLE_DELIVERY;\n158:   const record = input.state.get(sessionId);\n159:   const secondClock = input.state.clock(sessionId);\n160:   if (!secondClock || !sameClock(firstClock, secondClock)) {\n161:     return FULL_DIRECTIVE_LIFECYCLE_DELIVERY;\n162:   }\n163: \n164:   const replacement = nextRecord(parts, secondClock, transcriptPath, transcriptBytes);\n165:   const mustDeliverFull = isLifecycleBoundary(input.lifecycleEvent)\n166:     || !record\n167:     || !sameClock(record, secondClock)\n168:     || record.directives !== parts.directives\n169:     || record.transcriptPath !== transcriptPath\n170:     || transcriptBytes < record.transcriptHighWaterBytes;\n171:   if (mustDeliverFull) {\n172:     return fullWithReceipt(input.state, sessionId, replacement, input.deferFullReceipt === true);\n173:   }\n174: \n175:   if (transcriptBytes > record.transcriptHighWaterBytes\n176:     && !input.state.set(sessionId, replacement)) {\n177:     return FULL_DIRECTIVE_LIFECYCLE_DELIVERY;\n178:   }\n179:   return Object.freeze({ reducedContext: parts.head, suppressed: true });\n[Output truncated. Continue reading with offset: 180]","title":"read","metadata":{"metadata":{"truncated":true},"content":[{"type":"text","text":"Read file .skilled/skills/system-skill-adv