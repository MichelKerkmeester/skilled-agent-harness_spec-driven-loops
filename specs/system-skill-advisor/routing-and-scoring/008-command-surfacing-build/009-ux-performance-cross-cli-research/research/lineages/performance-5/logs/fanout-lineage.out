{"type":"tool_use","timestamp":1794802737870,"sessionID":"ses_e1d814441ffeT6EyjaVEb2SkHU","part":{"partID":"prt_1e2945088002jLbODXpN7GW3ht","sessionID":"ses_e1d814441ffeT6EyjaVEb2SkHU","messageID":"msg_1e29435ed001kHSxg57Qg3MYSQ","type":"tool","id":"chatcmpl-tool-b862297044d7b615","tool":"shell","state":{"status":"completed","input":{"command":"cd \"$TMPDIR/speckit-skill-advisor-metrics\" && python3 - <<'PY'\nimport json, glob, collections\nrows=[]\nfor p in glob.glob(\"*.jsonl\"):\n    rs=[]\n    for line in open(p, encoding=\"utf-8\"):\n        line=line.strip()\n        if not line: continue\n        try: r=json.loads(line)\n        except Exception: continue\n        if isinstance(r.get(\"durationMs\"),(int,float)): rs.append(r)\n    if not rs: continue\n    d=[r[\"durationMs\"] for r in rs]\n    if len(d)>=20 and max(d)-min(d)==len(d)-1 and all(d[i]<=d[i+1] for i in range(len(d)-1)): continue\n    rows+=rs\nlive=[r for r in rows if r.get(\"freshness\")==\"live\"]\nby=collections.defaultdict(lambda: {True:[],False:[]})\nfor r in live:\n    by[r.get(\"runtime\",\"-\")][bool(r.get(\"cacheHit\"))].append(r[\"durationMs\"])\nfor rt in sorted(by):\n    out=[]\n    for flag in (True,False):\n        v=sorted(by[rt][flag]); n=len(v)\n        out.append(f\"{'cache' if flag else 'cold'} n={n} p50={v[n//2] if n else '-'} p95={v[int(n*.95)] if n else '-'}\")\n    print(rt, \"|\", \" | \".join(out))\nPY"},"output":"claude | cache n=926 p50=30 p95=151 | cold n=529 p50=172 p95=618\ncodex | cache n=2 p50=161 p95=161 | cold n=4 p50=0 p95=0\ndevin | cache n=4 p50=200 p95=230 | cold n=44 p50=160 p95=237\ndsh | cache n=20 p50=139 p95=323 | cold n=49 p50=165 p95=243\npi | cache n=20 p50=140 p95=327 | cold n=48 p50=161 p95=264\nvibe | cache n=8 p50=142 p95=220 | cold n=41 p50=140 p95=742\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"claude | cache n=926 p50=30 p95=151 | cold n=529 p50=172 p95=618\ncodex | cache n=2 p50=161 p95=161 | cold n=4 p50=0 p95=0\ndevin | cache n=4 p50=200 p95=230 | cold n=44 p50=160 p95=237\ndsh | cache n=20 p50=139 p95=323 | cold n=49 p50=165 p95=243\npi | cache n=20 p50=140 p95=327 | cold n=48 p50=161 p95=264\nvibe | cache n=8 p50=142 p95=220 | cold n=41 p50=140 p95=742\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\": \"cd \\\"$TMPDIR/speckit-skill-advisor-metrics\\\" && python3 - <<'PY'\\nimport json, glob, collections\\nrows=[]\\nfor p in glob.glob(\\\"*.jsonl\\\"):\\n    rs=[]\\n    for line in open(p, encoding=\\\"utf-8\\\"):\\n        line=line.strip()\\n        if not line: continue\\n        try: r=json.loads(line)\\n        except Exception: continue\\n        if isinstance(r.get(\\\"durationMs\\\"),(int,float)): rs.append(r)\\n    if not rs: continue\\n    d=[r[\\\"durationMs\\\"] for r in rs]\\n    if len(d)>=20 and max(d)-min(d)==len(d)-1 and all(d[i]<=d[i+1] for i in range(len(d)-1)): continue\\n    rows+=rs\\nlive=[r for r in rows if r.get(\\\"freshness\\\")==\\\"live\\\"]\\nby=collections.defaultdict(lambda: {True:[],False:[]})\\nfor r in live:\\n    by[r.get(\\\"runtime\\\",\\\"-\\\")][bool(r.get(\\\"cacheHit\\\"))].append(r[\\\"durationMs\\\"])\\nfor rt in sorted(by):\\n    out=[]\\n    for flag in (True,False):\\n        v=sorted(by[rt][flag]); n=len(v)\\n        out.append(f\\\"{'cache' if flag else 'cold'} n={n} p50={v[n//2] if n else '-'} p95={v[int(n*.95)] if n else '-'}\\\")\\n    print(rt, \\\"|\\\", \\\" | \\\".join(out))\\nPY\"}"},"time":{"start":1794802733192,"end":1794802737870}}}}
