{"type":"tool_use","timestamp":1794802207368,"sessionID":"ses_e1d814441ffeT6EyjaVEb2SkHU","part":{"partID":"prt_1e28c3926002aS1aPqty6Vxu7k","sessionID":"ses_e1d814441ffeT6EyjaVEb2SkHU","messageID":"msg_1e28c23100017bw9VJXQ47zplK","type":"tool","id":"chatcmpl-tool-81ef3184a6b3986b","tool":"shell","state":{"status":"completed","input":{"command":"cd \"$TMPDIR/speckit-skill-advisor-metrics\" && python3 - <<'PY'\nimport json, glob, collections\nrows=[]\nfor p in glob.glob(\"*.jsonl\"):\n    rs=[]\n    for line in open(p, encoding=\"utf-8\"):\n        line=line.strip()\n        if not line: continue\n        try: r=json.loads(line)\n        except Exception: continue\n        if isinstance(r.get(\"durationMs\"), (int,float)): rs.append(r)\n    if not rs: continue\n    d=[r[\"durationMs\"] for r in rs]\n    if len(d)>=20 and max(d)-min(d)==len(d)-1 and all(d[i]<=d[i+1] for i in range(len(d)-1)):\n        continue\n    for r in rs:\n        r[\"_file\"]=p; rows.append(r)\ndef pct(v):\n    v=sorted(v); n=len(v)\n    return dict(n=n, p50=v[int(n*0.5)], p90=v[int(n*0.90)], p95=v[int(n*0.95)], p99=v[min(n-1,int(n*0.99))], max=v[-1])\nprint(\"REAL\", pct([r[\"durationMs\"] for r in rows]))\nbyday=collections.defaultdict(list)\nbyrt=collections.defaultdict(list)\nbyfr=collections.defaultdict(list)\nfor r in rows:\n    byday[str(r.get(\"timestamp\",\"\"))[:10]].append(r[\"durationMs\"])\n    byrt[str(r.get(\"runtime\",\"-\"))].append(r[\"durationMs\"])\n    byfr[str(r.get(\"freshness\",\"-\"))].append(r[\"durationMs\"])\nfor k,v in sorted(byday.items()): print(\"day\",k,pct(v))\nfor k,v in sorted(byrt.items(), key=lambda kv:-len(kv[1])): print(\"rt\",k,pct(v))\nfor k,v in sorted(byfr.items(), key=lambda kv:-len(kv[1])): print(\"fr\",k,pct(v))\nbr=[r[\"emittedBytes\"] for r in rows if isinstance(r.get(\"emittedBytes\"),(int,float)) and r[\"emittedBytes\"]>=0]\nif br:\n    br.sort(); print(\"brief n\",len(br),\"mean\",round(sum(br)/len(br),1),\"p50\",br[len(br)//2],\"p95\",br[int(len(br)*0.95)],\"max\",br[-1])\nst=collections.Counter(r.get(\"status\",\"-\") for r in rows)\nprint(\"status\",dict(st))\nPY"},"output":"REAL {'n': 2375, 'p50': 12, 'p90': 200, 'p95': 279, 'p99': 735, 'max': 2218}\nday 2026-11-13 {'n': 438, 'p50': 10, 'p90': 30, 'p95': 30, 'p99': 218, 'max': 922}\nday 2026-11-14 {'n': 301, 'p50': 10, 'p90': 230, 'p95': 375, 'p99': 704, 'max': 1205}\nday 2026-11-15 {'n': 1056, 'p50': 2, 'p90': 241, 'p95': 345, 'p99': 824, 'max': 2218}\nday 2026-11-16 {'n': 580, 'p50': 136, 'p90': 179, 'p95': 215, 'p99': 609, 'max': 2208}\nrt claude {'n': 1794, 'p50': 30, 'p90': 208, 'p95': 292, 'p99': 757, 'max': 2218}\nrt pi {'n': 272, 'p50': 1, 'p90': 163, 'p95': 179, 'p99': 276, 'max': 327}\nrt dsh {'n': 131, 'p50': 119, 'p90': 179, 'p95': 243, 'p99': 323, 'max': 609}\nrt devin {'n': 117, 'p50': 1, 'p90': 184, 'p95': 230, 'p99': 356, 'max': 435}\nrt vibe {'n': 49, 'p50': 140, 'p90': 617, 'p95': 742, 'p99': 947, 'max': 947}\nrt codex {'n': 12, 'p50': 1, 'p90': 352, 'p95': 381, 'p99': 381, 'max': 381}\nfr live {'n': 1695, 'p50': 124, 'p90': 225, 'p95': 311, 'p99': 757, 'max': 1538}\nfr unavailable {'n': 664, 'p50': 0, 'p90': 1, 'p95': 2, 'p99': 3, 'max': 2218}\nfr stale {'n': 13, 'p50': 374, 'p90': 517, 'p95': 555, 'p99': 555, 'max': 555}\nfr absent {'n': 3, 'p50': 0, 'p90': 0, 'p95': 0, 'p99': 0, 'max': 0}\nbrief n 1234 mean 270.6 p50 262 p95 316 max 361\nstatus {'ok': 1572, 'skipped': 693, 'fail_open': 104, 'degraded': 6}\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"REAL {'n': 2375, 'p50': 12, 'p90': 200, 'p95': 279, 'p99': 735, 'max': 2218}\nday 2026-11-13 {'n': 438, 'p50': 10, 'p90': 30, 'p95': 30, 'p99': 218, 'max': 922}\nday 2026-11-14 {'n': 301, 'p50': 10, 'p90': 230, 'p95': 375, 'p99': 704, 'max': 1205}\nday 2026-11-15 {'n': 1056, 'p50': 2, 'p90': 241, 'p95': 345, 'p99': 824, 'max': 2218}\nday 2026-11-16 {'n': 580, 'p50': 136, 'p90': 179, 'p95': 215, 'p99': 609, 'max': 2208}\nrt claude {'n': 1794, 'p50': 30, 'p90': 208, 'p95': 292, 'p99': 757, 'max': 2218}\nrt pi {'n': 272, 'p50': 1, 'p90': 163, 'p95': 179, 'p99': 276, 'max': 327}\nrt dsh {'n': 131, 'p50': 119, 'p90': 179, 'p95': 243, 'p99': 323, 'max': 609}\nrt devin {'n': 117, 'p50': 1, 'p90': 184, 'p95': 230, 'p99': 356, 'max': 435}\nrt vibe {'n': 49, 'p50': 140, 'p90': 617, 'p95': 742, 'p99': 947, 'max': 947}\nrt codex {'n': 12, 'p50': 1, 'p90': 352, 'p95': 381, 'p99': 381, 'max': 381}\nfr live {'n': 1695, 'p50': 124, 'p90': 225, 'p95': 311, 'p99': 757, 'max': 1538}\nfr unavailable {'n': 664, 'p50': 0, 'p90': 1, 'p95': 2, 'p99': 3, 'max': 2218}\nfr stale {'n': 13, 'p50': 374, 'p90': 517, 'p95': 555, 'p99': 555, 'max': 555}\nfr absent {'n': 3, 'p50': 0, 'p90': 0, 'p95': 0, 'p99': 0, 'max': 0}\nbrief n 1234 mean 270.6 p50 262 p95 316 max 361\nstatus {'ok': 1572, 'skipped': 693, 'fail_open': 104, 'degraded': 6}\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\": \"cd \\\"$TMPDIR/speckit-skill-advisor-metrics\\\" && python3 - <<'PY'\\nimport json, glob, collections\\nrows=[]\\nfor p in glob.glob(\\\"*.jsonl\\\"):\\n    rs=[]\\n    for line in open(p, encoding=\\\"utf-8\\\"):\\n        line=line.strip()\\n        if not line: continue\\n        try: r=json.loads(line)\\n        except Exception: continue\\n        if isinstance(r.get(\\\"durationMs\\\"), (int,float)): rs.append(r)\\n    if not rs: continue\\n    d=[r[\\\"durationMs\\\"] for r in rs]\\n    if len(d)>=20 and max(d)-min(d)==len(d)-1 and all(d[i]<=d[i+1] for i in range(len(d)-1)):\\n        continue\\n    for r in rs:\\n        r[\\\"_file\\\"]=p; rows.append(r)\\ndef pct(v):\\n    v=sorted(v); n=len(v)\\n    return dict(n=n, p50=v[int(n*0.5)], p90=v[int(n*0.90)], p95=v[int(n*0.95)], p99=v[min(n-1,int(n*0.99))], max=v[-1])\\nprint(\\\"REAL\\\", pct([r[\\\"durationMs\\\"] for r in rows]))\\nbyday=collections.defaultdict(list)\\nbyrt=collections.defaultdict(list)\\nbyfr=collections.defaultdict(list)\\nfor r in rows:\\n    byday[str(r.get(\\\"timestamp\\\",\\\"\\\"))[:10]].append(r[\\\"durationMs\\\"])\\n    byrt[str(r.get(\\\"runtime\\\",\\\"-\\\"))].append(r[\\\"durationMs\\\"])\\n    byfr[str(r.get(\\\"freshness\\\",\\\"-\\\"))].append(r[\\\"durationMs\\\"])\\nfor k,v in sorted(byday.items()): print(\\\"day\\\",k,pct(v))\\nfor k,v in sorted(byrt.items(), key=lambda kv:-len(kv[1])): print(\\\"rt\\\",k,pct(v))\\nfor k,v in sorted(byfr.items(), key=lambda kv:-len(kv[1])): print(\\\"fr\\\",k,pct(v))\\nbr=[r[\\\"emittedBytes\\\"] for r in rows if isinstance(r.get(\\\"emittedBytes\\\"),(int,float)) and r[\\\"emittedBytes\\\"]>=0]\\nif br:\\n    br.sort(); print(\\\"brief n\\\",len(br),\\\"mean\\\",round(sum(br)/len(br),1),\\\"p50\\\",br[len(br)//2],\\\"p95\\\",br[int(len(br)*0.95)],\\\"max\\\",br[-1])\\nst=collections.Counter(r.get(\\\"status\\\",\\\"-\\\") for r in rows)\\nprint(\\\"status\\\",dict(st))\\nPY\"}"},"time":{"start":1794802202918,"end":1794802207368}}}}
