\":\"f-iter005-004\",\"label\":\"The 664 unavailable health rows price a cold fail-open at p50 0 ms and p95 2 ms, so the population that should carry the cold cost carries none of it.\",\"iteration\":5,\"sources\":[\"$TMPDIR/speckit-skill-advisor-metrics/*.jsonl\"]})\nrows.append({\"type\":\"finding\",\"id\":\"f-iter005-005\",\"label\":\"What would confirm the bound: one sandbox cold start with the embed model unloaded, recording hook wall time, cascade probe duration and fail-open reason.\",\"iteration\":5,\"sources\":[b+\"/008-embedder-setup-and-cost/spec.md\"]})\nrows.append({\"type\":\"ruled_out\",\"direction\":\"Reading a cold first-prompt cost from the health records\",\"reason\":\"The fail-open branch writes 0 ms, so the record cannot carry it.\",\"iteration\":5})\nwith p.open(\"w\",encoding=\"utf-8\") as fh:\n    for r in rows: fh.write(json.dumps(r,ensure_ascii=False)+\"\\n\")\nprint(\"rows\",len(rows))\nPY\njq -c . specs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/009-ux-performance-cross-cli-research/research/lineages/performance-5/deltas/iter-005.jsonl >/dev/null && echo VALID && head -1 specs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/009-ux-performance-cross-cli-research/research/lineages/performance-5/deltas/iter-005.jsonl > \"$TMPDIR/perf5-iter005-event.json\" && node .skilled/skills/system-deep-loop/runtime/scripts/append-mode-event.cjs --mode research --run-directory \"specs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/009-ux-performance-cross-cli-research/research/lineages/performance-5\" --event-json \"$TMPDIR/perf5-iter005-event.json\" > \"$TMPDIR/r5.json\" 2>&1; echo EXIT:$?; jq -c '{ok,seq:.receipt.sequence}' \"$TMPDIR/r5.json\""},"output":"rows 7\nVALID\nEXIT:0\n{\"ok\":true,\"seq\":6}\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"rows 7\nVALID\nEXIT:0\n{\"ok\":true,\"seq\":6}\n"}],"provide