the colon and would otherwise use the\n88: // max level its settings file names.\n89: const OPENCODE_MODEL = 'opencode-go/deepseek-v4.1-flash';\n90: const PI_MODEL = 'opencode-go/deepseek-v4.1-flash:off';\n91: const DEVIN_MODEL = 'swe-2-max';\n92: const DSH_MODEL = 'deepseek-v4.1-flash-1017';\n93: \n94: // Runtimes the phase reports as not measured, with the reason a run would be\n95: // wasted work rather than evidence. Cursor's reader never leaves gated, so its\n96: // transcript could not be scored even if the turn ran. Vibe's reader is ready\n97: // but no live arm may run it, so it is reported rather than run.\n98: const NOT_MEASURED = Object.freeze({\n99:   cursor: 'its session reader is gated, so no produced transcript can be scored',\n100:   vibe: 'no live turn is wired for it: live runs need an arena with credentials off and the behaviour arms are stopped',\n101: });\n102: \n103: function has(object, key) {\n104:   return Object.prototype.hasOwnProperty.call(object, key);\n105: }\n106: \n107: // ───────────────────────────────────────────────────────────────\n108: // Runtime argv table\n109: // ───────────────────────────────────────────────────────────────\n[Output truncated. Continue reading with offset: 110]","title":"read","metadata":{"metadata":{"truncated":true},"content":[{"type":"text","text":"Read file .skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/run-command-behaviour.mjs, lines 60-109\n60: import { MARK } from './prepare-behaviour-arena.mjs';\n61: import { restoreTurn, statusSnapshot } from './worktree-restore.mjs';\n62: \n63: const HERE = dirname(fileURLToPath(import.meta.url));\n64: const REPO_ROOT = resolve(HERE, '../../../../../..');\n65: const DSH_PATCH_DIR = resolve(REPO_ROOT, '.dsh/patches');\n66: // A stored session is found by its id plus the directory the turn ran in, and the\n67: // scorer reads it back from another checkout, so the locator records the resolved\n68: // directory instead of letting each reader compare the id against its own root.\n69: const PROJECT_DIR = realpathSync(REPO_ROOT);\n70: const PROMPTS_PATH = resolve(HERE, 'command-prompts.jsonl');\n71: const FRESH_PATH = resolve(HERE, 'behaviour-fresh-prompts.jsonl');\n72: \n73: const EXIT_REFUSED = 2;\n74: const EXIT_HEAD_MOVED = 3;\n75: \n76: // Keyed by prompt kind rather than by set name, because one arm can hold rows\n77: // from either set and the cap has to follow the row, not the invocation.\n78: const CAP_MS = Object.freeze({\n79:   chat: 300_000,\n80:   started: 900_000,\n81: });\n82: \n83: const CLAUDE_MODEL = 'claude-sonnet-5-5';\n84: const CODEX_MODEL = 'gpt-6-luna';\n85: // OpenCode and Pi run the flat-rate OpenCode Go flash model, the fastest and\n86: // cheapest DeepSeek route, because the max variant took about three minutes a\n87: // turn. Pi takes its thinking level after the colon and would otherwise use the\n88: // max level its settings file names.\n89: const OPENCODE_MODEL = 'opencode-go/deepseek-v4.1-flash';\n90: const PI_MODEL = 'opencode-go/deepseek-v4.1-flash:off';\n91: const DEVIN_MODEL = 'swe-2-max';\n92: const DSH_MODEL = 'deepseek-v4.1-flash-1017';\n93: \n94: // Runtimes the phase reports as not measured, with the reason a run would be\n95: // wasted work rather than evidence. Cursor's reader never leaves gated, so its\n96: // transcript could not be scored even if the turn ran. Vibe's reader is ready\n97: // but no live arm may run it, so it is reported rather than run.\n98: const NOT_MEASURED = Object.freeze({\n99:   cursor: 'its session reader is gated, so no produced transcript can be scored',\n100:   vibe: 'no live turn is wired for it: live runs need an arena with credentials off and the behaviour arms are stopped',\n101: });\n102: \n103: function has(object, key) {\n104:   return Object.prototype.hasOwnProperty.call(object, key);\n105: }\n106: \n107: // ───────────────────────────────────────────────────────────────\n108: // Runtime argv table\n109: // ───────────────────────────────────────────────────────────────\n[Output truncated. Continue reading with offset: 110]"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\": \".skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/run-command-behaviour.mjs\", \"offset\": 60, \"limit\": 50}"},"time":{"start":1794801525246,"end":1794801525618}}}}
