{"type":"tool_use","timestamp":1794801552707,"sessionID":"ses_e1d814441ffeT6EyjaVEb2SkHU","part":{"partID":"prt_1e282491c001lkTsNRfBINwHnU","sessionID":"ses_e1d814441ffeT6EyjaVEb2SkHU","messageID":"msg_1e28230f8001sR2eN9TXTVRLEY","type":"tool","id":"chatcmpl-tool-98097a8e4e0c0a0e","tool":"shell","state":{"status":"completed","input":{"command":"sed -n '955,1000p' .skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/run-command-behaviour.mjs"},"output":"// machine the arm runs on.\nfunction promptFor(rowId, fixture) {\n  const fixed = G2_PROMPTS.get(rowId);\n  if (fixed === undefined) return lookupPrompt(rowId).prompt;\n  return fixed.split(FIXTURE_TOKEN).join(fixture);\n}\n\n// The cap belongs to the prompt rather than to the invocation, so an arm that\n// mixes the two sets still gives a started workflow the time it needs.\nfunction capForRow(rowId) {\n  return G2_PROMPTS.has(rowId) ? CAP_MS.started : CAP_MS.chat;\n}\n\n// ───────────────────────────────────────────────────────────────\n// One turn\n// ───────────────────────────────────────────────────────────────\n\n// A turn runs with bypassed permissions, so it gets only what a runtime needs to\n// start and authenticate, and every other credential in the operator's shell stays\n// out. The shell basics and each runtime's own prefixes are enough for a CLI to\n// find its home, account and route, while a dispatched worker's marker is not\n// passed at all, because a CLI that answers as a child session is not the chat\n// start an arm measures.\n//\n// The network credentials stay out of the allowlist for the same reason: a turn\n// that reaches a forge with the operator's identity is a side effect no transcript\n// can undo. The GitHub CLI is pointed at an empty folder beside the run log rather\n// than the operator's authenticated one, and an empty credential helper replaces\n// whatever a global git config would have offered. A missing credential then fails\n// at once instead of waiting on a terminal nobody is sitting at.\nconst CHILD_ENV_NAMES = Object.freeze([\n  'PATH',\n  'HOME',\n  'USER',\n  'LOGNAME',\n  'SHELL',\n  'TMPDIR',\n  'TMP',\n  'TEMP',\n  'LANG',\n  'TERM',\n  'TERM_PROGRAM',\n  'COLORTERM',\n  'NO_COLOR',\n]);\n\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"// machine the arm runs on.\nfunction promptFor(rowId, fixture) {\n  const fixed = G2_PROMPTS.get(rowId);\n  if (fixed === undefined) return lookupPrompt(rowId).prompt;\n  return fixed.split(FIXTURE_TOKEN).join(fixture);\n}\n\n// The cap belongs to the prompt rather than to the invocation, so an arm that\n// mixes the two sets still gives a started workflow the time it needs.\nfunction capForRow(rowId) {\n  return G2_PROMPTS.has(rowId) ? CAP_MS.started : CAP_MS.chat;\n}\n\n// ───────────────────────────────────────────────────────────────\n// One turn\n// ───────────────────────────────────────────────────────────────\n\n// A turn runs with bypassed permissions, so it gets only what a runtime needs to\n// start and authenticate, and every other credential in the operator's shell stays\n// out. The shell basics and each runtime's own prefixes are enough for a CLI to\n// find its home, account and route, while a dispatched worker's marker is not\n// passed at all, because a CLI that answers as a child session is not the chat\n// start an arm measures.\n//\n// The network credentials stay out of the allowlist for the same reason: a turn\n// that reaches a forge with the operator's identity is a side effect no transcript\n// can undo. The GitHub CLI is pointed at an empty folder beside the run log rather\n// than the operator's authenticated one, and an empty credential helper replaces\n// whatever a global git config would have offered. A missing credential then fails\n// at once instead of waiting on a terminal nobody is sitting at.\nconst CHILD_ENV_NAMES = Object.freeze([\n  'PATH',\n  'HOME',\n  'USER',\n  'LOGNAME',\n  'SHELL',\n  'TMPDIR',\n  'TMP',\n  'TEMP',\n  'LANG',\n  'TERM',\n  'TERM_PROGRAM',\n  'COLORTERM',\n  'NO_COLOR',\n]);\n\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\": \"sed -n '955,1000p' .skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/run-command-behaviour.mjs\"}"},"time":{"start":1794801551644,"end":1794801552707}}}}
