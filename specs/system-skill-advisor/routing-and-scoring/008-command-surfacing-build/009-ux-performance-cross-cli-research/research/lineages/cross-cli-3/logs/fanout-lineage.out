{"type":"tool_use","timestamp":1794550356252,"sessionID":"ses_e2c799dd1ffeZnROszLt7sZevy","part":{"partID":"prt_1d38958ba001B5rF5N5xyLbxKK","sessionID":"ses_e2c799dd1ffeZnROszLt7sZevy","messageID":"msg_1d38941a2001mozg6Tk35fmfzA","type":"tool","id":"call_00_h7xmrpht4bzoplq88nsalv4o","tool":"read","state":{"status":"completed","input":{"limit":150,"offset":639,"path":".opencode/plugins/system-skill-advisor.js"},"output":"Read file .opencode/plugins/system-skill-advisor.js, lines 639-788\n639:   const renderer = freshness === 'unavailable' ? null : await loadShadowRenderer();\n640:   const renderBrief = typeof renderer?.renderAdvisorBrief === 'function' ? renderer.renderAdvisorBrief : null;\n641:   const rendered = renderBrief\n642:     ? renderBrief({\n643:       status: 'ok',\n644:       freshness,\n645:       recommendations,\n646:       ambiguous: data.ambiguous === true,\n647:       metrics: { tokenCap },\n648:       sharedPayload: { metadata: { skillLabel: top?.skill ?? null } },\n649:     }, {\n650:       tokenCap,\n651:       thresholdConfig: {\n652:         confidenceThreshold: options.thresholdConfidence,\n653:         uncertaintyThreshold: DEFAULT_THRESHOLD_UNCERTAINTY,\n654:       },\n655:     })\n656:     : null;\n657:   const brief = typeof rendered === 'string' && rendered.trim() ? rendered : null;\n658:   const routeSummary = compiledRouteSummary(data);\n659: \n660:   return {\n661:     brief,\n662:     status: brief ? 'ok' : 'skipped',\n663:     metadata: {\n664:       route: parsed.degraded === true ? 'cli-local-scorer' : 'cli',\n665:       freshness,\n666:       recommendationCount: recommendations.length,\n667:       tokenCap,\n668:       skillLabel: top?.skill ?? null,\n669:       cacheHit: Boolean(data.cache?.hit),\n670:       ...(routeSummary ? { compiledRouteSummary: routeSummary } : {}),\n671:     },\n672:   };\n673: }\n674: \n675: // ─────────────────────────────────────────────────────────────────────────────\n676: // 4. SIZE-CAP HELPERS\n677: // ─────────────────────────────────────────────────────────────────────────────\n678: \n679: /**\n680:  * Clamp advisor brief text by JavaScript character count.\n681:  *\n682:  * @param {string} brief - Advisor brief text to clamp\n683:  * @param {number} maxChars - Maximum character count to retain\n684:  * @returns {string} Original brief or truncated prefix within the limit\n685:  */\n686: function clampBrief(brief, maxChars) {\n687:   if (typeof brief !== 'string' || brief.length <= maxChars) {\n688:     return brief;\n689:   }\n690:   return brief.slice(0, maxChars);\n691: }\n692: \n693: /**\n694:  * Insert a cache value and evict oldest entries by insertion order.\n695:  *\n696:  * @param {Map<string, Object>} cache - Cache map using insertion order as LRU state\n697:  * @param {string} key - Cache key to insert or refresh\n698:  * @param {Object} value - Cache value to store\n699:  * @param {number} maxEntries - Maximum entries retained after insertion\n700:  * @returns {void}\n701:  */\n702: function insertWithEviction(cache, key, value, maxEntries) {\n703:   cache.set(key, value);\n704:   while (cache.size > maxEntries) {\n705:     const oldest = cache.keys().next().value;\n706:     cache.delete(oldest);\n707:   }\n708: }\n709: \n710: // The advisor CLI reads its request from stdin (`--json -`), so the prompt never\n711: // appears in argv, which any local user can read from the process table.\n712: function advisorCliArgs() {\n713:   return [ADVISOR_CLI_PATH, 'advisor_recommend', '--json', '-', '--format', 'json'];\n714: }\n715: \n716: // Build the stdin request, or null when the byte budget cannot hold even one prompt\n717: // character beside the request's fixed part. The prompt keeps at most\n718: // ADVISOR_PROMPT_MAX_CHARS characters and is clamped by its escaped size, because JSON\n719: // writes a quote or newline as two bytes and a control character as six.\n720: // The hub's own `.skilled` directory, resolved once. The plugin loads from `.opencode/plugins`,\n721: // one level below the repository root.\n722: let hubSkilledRoot;\n723: function resolveHubSkilledRoot() {\n724:   if (hubSkilledRoot === undefined) {\n725:     try {\n726:       hubSkilledRoot = realpathSync(join(dirname(fileURLToPath(import.meta.url)), '..', '..', '.skilled'));\n727:     } catch {\n728:       hubSkilledRoot = null;\n729:     }\n730:   }\n731:   return hubSkilledRoot;\n732: }\n733: \n734: // The sk-code surfaces declared for detection, in the order detection tries them:\n735: // every specific surface first, the hub registry's in registry order and then those\n736: // of outside skills whose graph-metadata.json names the sk-code family, by skill_id,\n737: // and the hub's one fallback last. An outside block that claims the fallback role is\n738: // ignored, because the fallback is the hub's own code.\n739: const SK_CODE_HUB = 'sk-code';\n740: const EXTENSION_MARKER = /^\\.[a-z0-9]+$/i;\n741: \n742: function readJsonFile(file) {\n743:   try {\n744:     const value = JSON.parse(readFileSync(file, 'utf8'));\n745:     return value && typeof value === 'object' ? value : null;\n746:   } catch {\n747:     return null;\n748:   }\n749: }\n750: \n751: // A block with no marker of any kind declares no surface, as the hub reader drops it too, so the\n752: // two readers list the same surfaces. Only path and file markers are kept for matching here.\n753: function surfaceEntry(block) {\n754:   if (!block || typeof block !== 'object' || typeof block.label !== 'string' || !block.label.trim()) return null;\n755:   const markerList = (list) => (Array.isArray(list) ? list : [])\n756:     .filter((marker) => typeof marker === 'string' && marker.length > 0);\n757:   const markers = [block.pathMarkers, block.fileMarkers].flatMap(markerList);\n758:   if (markers.length === 0 && markerList(block.contentMarkers).length === 0) return null;\n759:   return { label: block.label.toUpperCase(), role: block.role, markers };\n760: }\n761: \n762: // The trusted-root rule for a private link lives in the advisor runtime as plain\n763: // CommonJS, so both skills-root readers apply one copy of it on every supported Node\n764: // version. When the module cannot load, the check rejects every link, which keeps an\n765: // unverified target out of detection, and one stderr line records the lost rule.\n766: let privateSkillTarget;\n767: function loadPrivateSkillTarget() {\n768:   if (privateSkillTarget === undefined) {\n769:     try {\n770:       const hubRoot = resolveHubSkilledRoot();\n771:       privateSkillTarget = hubRoot\n772:         ? pluginRequire(join(hubRoot, ADVISOR_ROOT_RELATIVE_PATH, 'lib', 'private-skill-target.cjs'))\n773:         : null;\n774:     } catch (error) {\n775:       privateSkillTarget = null;\n776:       process.stderr.write(`[${PLUGIN_ID}] private-skill trusted-root rule failed to load, so every local-* link is skipped: ${error.message}\\n`);\n777:     }\n778:   }\n779:   return privateSkillTarget;\n780: }\n781: \n782: function privateSkillLinkCheck(skillsDir) {\n783:   const lib = loadPrivateSkillTarget();\n784:   return lib && typeof lib.createPrivateSkillLinkCheck === 'function'\n785:     ? lib.createPrivateSkillLinkCheck(skillsDir)\n786:     : () => false;\n787: }\n788: \n[Output truncated. Continue reading with offset: 789]","title":"read","metadata":{"metadata":{"truncated":true},"content":[{"type":"text","text":"Read file .opencode/plugins/system-skill-advisor.js, lines 639-788\n639:   const renderer = freshness === 'unavailable' ? null : await loadShadowRenderer();\n640:   const renderBrief = typeof renderer?.renderAdvisorBrief === 'function' ? renderer.renderAdvisorBrief : null;\n641:   const rendered = renderBrief\n642:     ? renderBrief({\n643:       status: 'ok',\n644:       freshness,\n645:       recommendations,\n646:       ambiguous: data.ambiguous === true,\n647:       metrics: { tokenCap },\n648:       sharedPayload: { metadata: { skillLabel: top?.skill ?? null } },\n649:     }, {\n650:       tokenCap,\n651:       thresholdConfig: {\n652:         confidenceThreshold: options.thresholdConfidence,\n653:         uncertaintyThreshold: DEFAULT_THRESHOLD_UNCERTAINTY,\n654:       },\n655:     })\n656:     : null;\n657:   const brief = typeof rendered === 'string' && rendered.trim() ? rendered : null;\n658:   const routeSummary = compiledRouteSummary(data);\n659: \n660:   return {\n661:     brief,\n662:     status: brief ? 'ok' : 'skipped',\n663:     metadata: {\n664:       route: parsed.degraded === true ? 'cli-local-scorer' : 'cli',\n665:       freshness,\n666:       recommendationCount: recommendations.length,\n667:       tokenCap,\n668:       skillLabel: top?.skill ?? null,\n669:       cacheHit: Boolean(data.cache?.hit),\n670:       ...(routeSummary ? { compiledRouteSummary: routeSummary } : {}),\n671:     },\n672:   };\n673: }\n674: \n675: // ─────────────────────────────────────────────────────────────────────────────\n676: // 4. SIZE-CAP HELPERS\n677: // ─────────────────────────────────────────────────────────────────────────────\n678: \n679: /**\n680:  * Clamp advisor brief text by JavaScript character count.\n681:  *\n682:  * @param {string} brief - Advisor brief text to clamp\n683:  * @param {number} maxChars - Maximum character count to retain\n684:  * @returns {string} Original brief or truncated prefix within the limit\n685:  */\n686: function clampBrief(brief, maxChars) {\n687:   if (typeof brief !== 'string' || brief.length <= maxChars) {\n688:     return brief;\n689:   }\n690:   return brief.slice(0, maxChars);\n691: }\n692: \n693: /**\n694:  * Insert a cache value and evict oldest entries by insertion order.\n695:  *\n696:  * @param {Map<string, Object>} cache - Cache map using insertion order as LRU state\n697:  * @param {string} key - Cache key to insert or refresh\n698:  * @param {Object} value - Cache value to store\n699:  * @param {number} maxEntries - Maximum entries retained after insertion\n700:  * @returns {void}\n701:  */\n702: function insertWithEviction(cache, key, value, maxEntries) {\n703:   cache.set(key, value);\n704:   while (cache.size > maxEntries) {\n705:     const oldest = cache.keys().next().value;\n706:     cache.delete(oldest);\n707:   }\n708: }\n709: \n710: // The advisor CLI reads its request from stdin (`--json -`), so the prompt never\n711: // appears in argv, which any local user can read from the process table.\n712: function advisorCliArgs() {\n713:   return [ADVISOR_CLI_PATH, 'advisor_recommend', '--json', '-', '--format', 'json'];\n714: }\n715: \n716: // Build the stdin request, or null when the byte budget cannot hold even one prompt\n717: // character beside the request's fixed part. The prompt keeps at most\n718: // ADVISOR_PROMPT_MAX_CHARS characters and is clamped by its escaped size, because JSON\n719: // writes a quote or newline as two bytes and a control character as six.\n720: // The hub's own `.skilled` directory, resolved once. The plugin loads from `.opencode/plugins`,\n721: // one level below the repository root.\n722: let hubSkilledRoot;\n723: function resolveHubSkilledRoot() {\n724:   if (hubSkilledRoot === undefined) {\n725:     try {\n726:       hubSkilledRoot = realpathSync(join(dirname(fileURLToPath(import.meta.url)), '..', '..', '.skilled'));\n727:     } catch {\n728:       hubSkilledRoot = null;\n729:     }\n730:   }\n731:   return hubSkilledRoot;\n732: }\n733: \n734: // The sk-code surfaces declared for detection, in the order detection tries them:\n735: // every specific surface first, the hub registry's in registry order and then those\n736: // of outside skills whose graph-metadata.json names the sk-code family, by skill_id,\n737: // and the hub's one fallback last. An outside block that claims the fallback role is\n738: // ignored, because the fallback is the hub's own code.\n739: const SK_CODE_HUB = 'sk-code';\n740: const EXTENSION_MARKER = /^\\.[a-z0-9]+$/i;\n741: \n742: function readJsonFile(file) {\n743:   try {\n744:     const value = JSON.parse(readFileSync(file, 'utf8'));\n745:     return value && typeof value === 'object' ? value : null;\n746:   } catch {\n747:     return null;\n748:   }\n749: }\n750: \n751: // A block with no marker of any kind declares no surface, as the hub reader drops it too, so the\n752: // two readers list the same surfaces. Only path and file markers are kept for matching here.\n753: function surfaceEntry(block) {\n754:   if (!block || typeof block !== 'object' || typeof block.label !== 'string' || !block.label.trim()) return null;\n755:   const markerList = (list) => (Array.isArray(list) ? list : [])\n756:     .filter((marker) => typeof marker === 'string' && marker.length > 0);\n757:   const markers = [block.pathMarkers, block.fileMarkers].flatMap(markerList);\n758:   if (markers.length === 0 && markerList(block.contentMarkers).length === 0) return null;\n759:   return { label: block.label.toUpperCase(), role: block.role, markers };\n760: }\n761: \n762: // The trusted-root rule for a private link lives in the advisor runtime as plain\n763: // CommonJS, so both skills-root readers apply one copy of it on every supported Node\n764: // version. When the module cannot load, the check rejects every link, which keeps an\n765: // unverified target out of detection, and one stderr line records the lost rule.\n766: let privateSkillTarget;\n767: function loadPrivateSkillTarget() {\n768:   if (privateSkillTarget === undefined) {\n769:     try {\n770:       const hubRoot = resolveHubSkilledRoot();\n771:       privateSkillTarget = hubRoot\n772:         ? pluginRequire(join(hubRoot, ADVISOR_ROOT_RELATIVE_PATH, 'lib', 'private-skill-target.cjs'))\n773:         : null;\n774:     } catch (error) {\n775:       privateSkillTarget = null;\n776:       process.stderr.write(`[${PLUGIN_ID}] private-skill trusted-root rule failed to load, so every local-* link is skipped: ${error.message}\\n`);\n777:     }\n778:   }\n779:   return privateSkillTarget;\n780: }\n781: \n782: function privateSkillLinkCheck(skillsDir) {\n783:   const lib = loadPrivateSkillTarget();\n784:   return lib && typeof lib.createPrivateSkillLinkCheck === 'function'\n785:     ? lib.createPrivateSkillLinkCheck(skillsDir)\n786:     : () => false;\n787: }\n788: \n[Output truncated. Continue reading with offset: 789]"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"limit\": 150, \"offset\": 639, \"path\": \".opencode/plugins/system-skill-advisor.js\"}"},"time":{"start":1794550356154,"end":1794550356252}}}}
