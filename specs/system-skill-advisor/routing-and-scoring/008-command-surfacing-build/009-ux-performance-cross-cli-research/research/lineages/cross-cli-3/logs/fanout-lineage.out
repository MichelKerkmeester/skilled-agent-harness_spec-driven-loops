 eventName, scopeRunId) {\n260:   const builders = {\n261:     research: (name) => ({\n262:       stem: `deep_research.${name}`,\n263:       scope: { runId: scopeRunId, lineageId: scopeRunId },\n264:     }),\n265:     review: (name) => ({\n266:       stem: `deep_review.${name}`,\n267:       scope: { runId: scopeRunId, sessionId: scopeRunId },\n268:     }),\n269:   };\n270:   return builders[mode](eventName);\n271: }\n272: \n273: // The state log is a projection the gateway rebuilds. The staged ledger event\n274: // is what survives the next refresh.\n275: function stage(eventDir, scopeRunId, mode, eventRecord) {\n276:   const eventName = eventRecord.event;\n277:   const data = { ...eventRecord };\n278:   delete data.event;\n279:   const built = buildStem(mode, eventName, scopeRunId);\n280:   writeFileSync(\n281:     join(eventDir, `${eventName}.json`),\n282:     JSON.stringify({ stem: built.stem, scope: built.scope, data }),\n283:     'utf8',\n284:   );\n285: }\n286: \n287: // ───────────────────────────────────────────────────────────────────\n288: // 4. CORE LOGIC\n289: // ───────────────────────────────────────────────────────────────────\n290: \n291: function closeOut(args) {\n292:   const mode = args.mode;\n293:   const fields = FINDING_FIELDS[mode];\n294:   const scopeRunId = basename(dirname(args.stateLog)) || mode;\n295:   const registry = readJson(args.registry);\n296:   const evidence = registryEvidence(mode, registry);\n297:   const lineageLogs = lineageStateLogs(args.artifactDir, mode);\n298:   const parsedState = (lineageLogs.length > 0 ? lineageLogs : [args.stateLog])\n299:     .map(readJsonl)\n[Output truncated. Continue reading with offset: 300]","title":"read","metadata":{"metadata":{"truncated":true},"content":[{"type":"text","text":"Read file .skilled/skills/system-deep-loop/runtime/scripts/synthesis-closeout.cjs, lines 230-299\n230:       missingCode: 'registry_missing_keyFindings',\n231:     };\n232:   }\n233:   const openFindings = Array.isArra