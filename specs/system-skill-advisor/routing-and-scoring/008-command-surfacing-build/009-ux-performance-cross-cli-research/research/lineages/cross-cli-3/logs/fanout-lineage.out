  if (!validated) {\n1620:       throw new CliUsageError(`Unknown command: ${parsed.command}`);\n1621:     }\n1622: \n1623:     const invoked = validated.tool.name === 'advisor_recommend'\n1624:       ? await invokeAdvisorRecommendPayload(validated.args, parsed.timeoutMs, parsed.trusted, parsed.warmOnly)\n1625:       : validated.tool.name === 'skill_graph_scan'\n1626:         ? await runSkillGraphScanJob(validated.args, parsed.timeoutMs, parsed.trusted, parsed.warmOnly)\n1627:         : validated.tool.name === 'advisor_validate'\n1628:           ? await invokeAdvisorValidatePayload(validated.args, parsed.timeoutMs, parsed.trusted, parsed.warmOnly)\n1629:           : await invokeToolPayload(validated.tool.name, validated.args, parsed.timeoutMs, parsed.trusted, parsed.warmOnly);\n[Output truncated. Continue reading with offset: 1630]","title":"read","metadata":{"metadata":{"truncated":true},"content":[{"type":"text","text":"Read file .skilled/skills/system-skill-advisor/runtime/skill-advisor-cli.ts, lines 1550-1629\n1550:       // the first option is too old for the later one as well, and it may name\n1551:       // only one of them, so both go together in that case.\n1552:       const retryOptions: Record<string, unknown> = { ...options };\n1553:       const drop = rejected.includes('includeCompiledRoute') ? COMPILED_ROUTE_OPTION_KEYS : rejected;\n1554:       for (const key of drop) delete retryOptions[key];\n1555:       const retryArgs: Record<string, unknown> = { ...args, options: retryOptions };\n1556:       try {\n1557:         return await invokeToolPayload('advisor_recommend', retryArgs, timeoutMs, trusted, warmOnly);\n1558:       } catch (retryError: unknown) {\n1559:         failure = retryError;\n1560:       }\n1561:     }\n1562:     // Only an unreachable daemon reaches this catch: one that answered, even with a\n1563:     // tool-level error, returned above. A fallback that also fails rethrows the\n1564:     // original error, so the exit code and error envelope stay unchanged.\n1565:     if (exitCodeForError(failure) !== EXIT_RETRYABLE) throw failure;\n1566:     // Warm-only is attach-or-refuse: it never spawns a process, and the local scorer\n1567:     // is a spawn, so it must not run here. Rethrow the original failure so the\n1568:     // retryable exit code and error envelope stay unchanged.\n1569:     if (warmOnly) throw failure;\n1570:     const prompt = args.prompt;\n1571:     if (typeof prompt !== 'string') throw failure;\n1572:     const recommendations = await runLocalScorer(prompt).catch(() => null);\n1573:     if (!recommendations) throw failure;\n1574:     return {\n1575:       payload: {\n1576:         status: 'ok',\n1577:         degraded: true,\n1578:         source: LOCAL_SCORER_SOURCE,\n1579:         data: {\n1580:           recommendations: degradedRecommendations(recommendations, prompt),\n1581:           effectiveThresholds: LOCAL_SCORER_THRESHOLDS,\n1582:         },\n1583:       },\n1584:       isError: false,\n1585:     };\n1586:   }\n1587: }\n1588: \n1589: // ───────────────────────────────────────────────────────────────────\n1590: // 6. EXPORTS\n1591: // ───────────────────────────────────────────────────────────────────\n1592: export async function runSkillAdvisorCli(argv: string[], io: CliIo = { stdout: process.stdout, stderr: process.stderr }): Promise<number> {\n1593:   try {\n1594:     const parsed = parseCliArgs(argv);\n1595:     if (parsed.help) {\n1596:       await writeLine(io.stdout, usageText(parsed.command || undefined));\n1597:       return EXIT_SUCCESS;\n1598:     }\n1599:     if (parsed.version) {\n1600:       await writeLine(io.stdout, readCliVersion(findRepoPaths()));\n1601:       return EXIT_SUCCESS;\n1602:     }\n1603:     if (parsed.command === 'list-tools') {\n1604:       await writeLine(io.stdout, renderToolList(parsed.format, parsed.toolListMode));\n1605:       return EXIT_SUCCESS;\n1606:     }\n1607:     if (parsed.command === 'completion') {\n1608:       if (!parsed.completionShell) {\n1609:         throw new CliUsageError('completion requires a shell: bash or zsh');\n1610:       }\n1611:       await writeLine(io.stdout, renderCompletion(parsed.completionShell));\n1612:       return EXIT_SUCCESS;\n1613:     }\n1614: \n1615:     const command = parsed.jsonFromStdin\n1616:       ? { ...parsed, args: parseJsonObject(await (io.readStdin ?? readProcessStdin)()) }\n1617:       : parsed;\n1618:     const validated = validateCommand(command);\n1619:     if (!validated) {\n1620:       throw new CliUsageError(`Unknown command: ${parsed.command}`);\n1621:     }\n1622: \n1623:     const invoked = validated.tool.name === 'advisor_recommend'\n1624:       ? await invokeAdvisorRecommendPayload(validated.args, parsed.timeoutMs, parsed.trusted, parsed.warmOnly)\n1625:       : validated.tool.name === 'skill_graph_scan'\n1626:         ? await runSkillGraphScanJob(validated.args, parsed.timeoutMs, parsed.trusted, parsed.warmOnly)\n1627:         : validated.tool.name === 'advisor_validate'\n1628:           ? await invokeAdvisorValidatePayload(validated.args, parsed.timeoutMs, parsed.trusted, parsed.warmOnly)\n1629:           : await invokeToolPayload(validated.tool.name, validated.args, parsed.timeoutMs, parsed.trusted, parsed.warmOnly);\n[Output truncated. Continue reading with offset: 1630]"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"limit\": 80, \"offset\": 1550, \"path\": \".skilled/skills/system-skill-advisor/runtime/skill-advisor-cli.ts\"}"},"time":{"start":1794550900900,"end":1794550900987}}}}
