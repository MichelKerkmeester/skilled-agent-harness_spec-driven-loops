{"type":"tool_use","timestamp":1794550348939,"sessionID":"ses_e2c799dd1ffeZnROszLt7sZevy","part":{"partID":"prt_1d3893c79001FOtVy1cautQg5w","sessionID":"ses_e2c799dd1ffeZnROszLt7sZevy","messageID":"msg_1d389343f001e8m51C35zMuV2W","type":"tool","id":"call_01_pgncusqjoup1f2fd3k10xfsl","tool":"read","state":{"status":"completed","input":{"limit":120,"offset":520,"path":".opencode/plugins/system-skill-advisor.js"},"output":"Read file .opencode/plugins/system-skill-advisor.js, lines 520-639\n520:   return `${String(sessionKey)}::${promptKey}`;\n521: }\n522: \n523: function extractPrompt(input) {\n524:   if (typeof input === 'string') {\n525:     return input;\n526:   }\n527:   if (!input || typeof input !== 'object') {\n528:     return null;\n529:   }\n530: \n531:   const candidates = [\n532:     input.prompt,\n533:     input.text,\n534:     input.userPrompt,\n535:     input.message,\n536:     input.input,\n537:     input.properties?.prompt,\n538:     input.properties?.message,\n539:     input.request?.prompt,\n540:     input.request?.message,\n541:   ];\n542: \n543:   for (const candidate of candidates) {\n544:     if (typeof candidate === 'string' && candidate.trim()) {\n545:       return candidate;\n546:     }\n547:     if (candidate && typeof candidate === 'object') {\n548:       const content = candidate.content ?? candidate.text;\n549:       if (typeof content === 'string' && content.trim()) {\n550:         return content;\n551:       }\n552:     }\n553:   }\n554: \n555:   return null;\n556: }\n557: \n558: function cliRecommendations(data, options) {\n559:   if (!Array.isArray(data?.recommendations)) {\n560:     return [];\n561:   }\n562:   return data.recommendations\n563:     .filter((recommendation) => recommendation && typeof recommendation.skillId === 'string')\n564:     .map((recommendation) => {\n565:       const confidence = Number.isFinite(recommendation.confidence) ? recommendation.confidence : 0;\n566:       const uncertainty = Number.isFinite(recommendation.uncertainty) ? recommendation.uncertainty : 1;\n567:       return {\n568:         skill: recommendation.skillId,\n569:         confidence,\n570:         uncertainty,\n571:         // The CLI's public recommendations carry no verdict field, so the caller\n572:         // decides it from the same thresholds the renderer enforces.\n573:         passes_threshold: confidence >= options.thresholdConfidence\n574:           && uncertainty <= DEFAULT_THRESHOLD_UNCERTAINTY,\n575:         ...(Array.isArray(recommendation.ambiguousWith)\n576:           ? { ambiguousWith: recommendation.ambiguousWith.filter((value) => typeof value === 'string') }\n577:           : {}),\n578:         // The renderer prints a command, its policy and its owner only from these\n579:         // fields. A skill row such as sk-doc has no generated command row to refill\n580:         // them, so a dropped field hides the command the advisor attached.\n581:         ...(typeof recommendation.command === 'string' && recommendation.command.trim() !== '' ? { command: recommendation.command } : {}),\n582:         ...(recommendation.policy === 'run' || recommendation.policy === 'start' || recommendation.policy === 'ask' ? { policy: recommendation.policy } : {}),\n583:         ...(typeof recommendation.ownerSkillId === 'string' && recommendation.ownerSkillId.trim() !== '' ? { ownerSkillId: recommendation.ownerSkillId } : {}),\n584:         ...(recommendation.needsMode === true ? { needsMode: true } : {}),\n585:       };\n586:     });\n587: }\n588: \n589: // Compact the served compiled decision the advisor attached to a recommendation.\n590: // Returns null when no recommendation carried a route, which keeps the injected\n591: // context byte-identical to the legacy brief.\n592: function compiledRouteSummary(data) {\n593:   if (!Array.isArray(data?.recommendations)) return null;\n594:   for (const recommendation of data.recommendations) {\n595:     const route = recommendation?.compiledRoute;\n596:     if (!route || typeof route !== 'object' || typeof route.action !== 'string') continue;\n597:     return {\n598:       outcome: route.action,\n599:       hubId: typeof route.hubId === 'string' ? route.hubId : null,\n600:       targets: Array.isArray(route.targets) ? route.targets.filter((target) => typeof target === 'string') : [],\n601:       servingAuthority: 'compiled',\n602:     };\n603:   }\n604:   return null;\n605: }\n606: \n607: /**\n608:  * Parse the advisor CLI's stdout and render its brief.\n609:  *\n610:  * @param {string} stdout - Raw CLI stdout text\n611:  * @param {Object} options - Normalized plugin options\n612:  * @returns {Promise<Object>} Response with `brief`, `status`, and `metadata`\n613:  */\n614: async function parseCliResponse(stdout, options) {\n615:   if (!stdout.trim()) {\n616:     return { brief: null, status: 'fail_open', error: 'EMPTY_STDOUT', metadata: {} };\n617:   }\n618: \n619:   let parsed;\n620:   try {\n621:     parsed = JSON.parse(stdout.trim());\n622:   } catch {\n623:     return { brief: null, status: 'fail_open', error: 'PARSE_FAIL', metadata: {} };\n624:   }\n625: \n626:   const data = parsed?.data && typeof parsed.data === 'object' ? parsed.data : null;\n627:   if (parsed?.status !== 'ok' || !data) {\n628:     return { brief: null, status: 'fail_open', error: 'UNEXPECTED_PAYLOAD', metadata: {} };\n629:   }\n630: \n631:   const recommendations = cliRecommendations(data, options);\n632:   const top = recommendations[0] ?? null;\n633:   // The CLI reports no freshness when it answered from the local scorer instead\n634:   // of the daemon; 'stale' keeps that brief renderable and honest.\n635:   const freshness = data.freshness === 'live' || data.freshness === 'stale'\n636:     ? data.freshness\n637:     : (parsed.degraded === true ? 'stale' : 'unavailable');\n638:   const tokenCap = data.ambiguous === true ? AMBIGUOUS_TOKEN_CAP : options.maxTokens;\n639:   const renderer = freshness === 'unavailable' ? null : await loadShadowRenderer();\n[Output truncated. Continue reading with offset: 640]","title":"read","metadata":{"metadata":{"truncated":true},"content":[{"type":"text","text":"Read file .opencode/plugins/system-skill-advisor.js, lines 520-639\n520:   return `${String(sessionKey)}::${promptKey}`;\n521: }\n522: \n523: function extractPrompt(input) {\n524:   if (typeof input === 'string') {\n525:     return input;\n526:   }\n527:   if (!input || typeof input !== 'object') {\n528:     return null;\n529:   }\n530: \n531:   const candidates = [\n532:     input.prompt,\n533:     input.text,\n534:     input.userPrompt,\n535:     input.message,\n536:     input.input,\n537:     input.properties?.prompt,\n538:     input.properties?.message,\n539:     input.request?.prompt,\n540:     input.request?.message,\n541:   ];\n542: \n543:   for (const candidate of candidates) {\n544:     if (typeof candidate === 'string' && candidate.trim()) {\n545:       return candidate;\n546:     }\n547:     if (candidate && typeof candidate === 'object') {\n548:       const content = candidate.content ?? candidate.text;\n549:       if (typeof content === 'string' && content.trim()) {\n550:         return content;\n551:       }\n552:     }\n553:   }\n554: \n555:   return null;\n556: }\n557: \n558: function cliRecommendations(data, options) {\n559:   if (!Array.isArray(data?.recommendations)) {\n560:     return [];\n561:   }\n562:   return data.recommendations\n563:     .filter((recommendation) => recommendation && typeof recommendation.skillId === 'string')\n564:     .map((recommendation) => {\n565:       const confidence = Number.isFinite(recommendation.confidence) ? recommendation.confidence : 0;\n566:       const uncertainty = Number.isFinite(recommendation.uncertainty) ? recommendation.uncertainty : 1;\n567:       return {\n568:         skill: recommendation.skillId,\n569:         confidence,\n570:         uncertainty,\n571:         // The CLI's public recommendations carry no verdict field, so the caller\n572:     