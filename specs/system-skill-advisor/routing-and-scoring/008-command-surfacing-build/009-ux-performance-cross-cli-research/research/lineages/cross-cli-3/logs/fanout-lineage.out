ns.dryRun) {\\n977:       const remotes = remoteNames();\\n978:       if (remotes.length > 0) {\\n979:         return {\\n980:           status: EXIT_REFUSED,\\n981:           refusal: { ok: false, code: 'remote_present', remotes },\\n982:         };\\n983:       }\\n984:     }\\n985:     const dirty = dirtyPaths(before.status, exempt);\\n986:     if (dirty.length > 0) {\\n987:       return {\\n988:         status: EXIT_REFUSED,\\n989:         refusal: { ok: false, code: 'worktree_dirty', paths: dirty },\\n990:       };\\n991:     }\\n992:   }\\n993: \\n994:   const sessionId = randomUUID();\\n995:   const argv = job.runtime.buildArgv({ prompt: job.prompt, sessionId });\\n996:   // A runtime that names its session only in its own store is bracketed by a\\n997:   // listing, and the entry the turn added is the session it wrote. A dry run\\n998:   // starts no CLI, so it has nothing to list.\\n999:   const listed = !options.dryRun && listsStore(job.runtime);\\n1000:   const listingBefore = listed ? storeIds(job.runtime, job.ghConfig) : null;\\n1001:   const turn = options.dryRun\\n1002:     ? { exit: null, error: null, streamId: null }\\n1003:     : await spawnTurn(job.runtime, argv, job.prompt, job.cap, job.ghConfig);\\n1004:   const reportedId = listed\\n1005:     ? addedSessionId(listingBefore, storeIds(job.runtime, job.ghConfig))\\n1006:     : turn.streamId;\\n1007: \\n1008:   const after = { status: statusPaths(), ...gitSnapshot() };\\n1009:   const headMoved = before.head !== after.head || before.stash !== after.stash;\\n1010:   const changed = changedPaths(before.status, after.status);\\n1011:   // The locator is kept in hand because the brief reader opens the same session\\n1012:   // the line records, and resolving it twice could name a different file.\\n1013:   const locator = locatorFor(job.runtime, sessionId, reportedId);\\n1014:   const line = {\\n1015:     runtime: job.runtimeName,\\n1016:     rowId: job.rowId,\\n1017:     arm: options.arm,\\n1018:     locator,\\n1019:     exit: turn.exit,\\n1020:     changedPaths: changed,\\n1021:   };\\n1022: \\n1023:   if (headMoved) {\\n1024:     // The worktree the restore was written for is gone. Restoring now could discard\\n1025:     // whatever the commit or stash brought in, so the paths stay listed instead.\\n1026:     appendRunLine(options.out, { ...line, restored: false, headMoved: true });\\n1027:     return { status: EXIT_HEAD_MOVED, refusal: { ok: false, code: 'head_moved', rowId: job.rowId } };\\n1028:   }\\n1029: \\n1030:   // A dry run spawns nothing, so an unchanged worktree is the only thing it can\\n1031:   // honestly report as left as found.\\n1032:   const restore = options.dryRun ? null : restoreTurn({ cwd: REPO_ROOT, before: before.status });\\n1033:   const restored = options.dryRun ? changed.length === 0 : restore.restored;\\n1034:   // The head the reader saw is the only place the offer was named, and not every\\n1035:   // runtime keeps it, so the offer is replayed after the turn. A dry run still\\n1036:   // replays it, which lets an operator read the offer without paying for a model\\n1037:   // call, while the brief stays `unknown` because no session exists to read.\\n1038:   const offer = replayOffer({ checkoutDir: PROJECT_DIR, prompt: job.prompt, sessionId });\\n1039:   const delivered = options.dryRun\\n1040:     ? 'unknown'\\n1041:     : await briefDelivered({ runtime: job.runtimeName, locator });\\n1042:   appendRunLine(options.out, {\\n1043:     ...line,\\n1044:     offeredCommand: offer.offeredCommand,\\n[Output truncated. Continue reading with offset: 1045]\",\"title\":\"read\",\"metadata\":{\"metadata\":{\"truncated\":true},\"content\":[{\"type\":\"text\",\"text\":\"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/run-command-behaviour.mjs, lines 970-1044\\n970: // fires, so a broken precondition never spends another model call.\\n971: async function runTurn(job, options, exempt, isFirst) {\\n972:   const before = { status: statusPaths(), ...gitSnapshot() };\\n973:   if (isFirst) {\\n974:     // A live turn can push, so it may only start where there is no remote to push\\n975:     // to. A dry run spawns nothing and keeps running in this checkout.\\n976:     if (!options.dryRun) {\\n977:       const remotes = remoteNames();\\n978:       if (remotes.length > 0) {\\n979:         return {\\n980:           status: EXIT_REFUSED,\\n981:           refusal: { ok: false, code: 'remote_present', remotes },\\n982:         };\\n983:       }\\n984:     }\\n985:     const dirty = dirtyPaths(before.status, exempt);\\n986:     if (dirty.length > 0) {\\n987:       return {\\n988:         status: EXIT_REFUSED,\\n989:         refusal: { ok: false, code: 'worktree_dirty', paths: dirty },\\n990:       };\\n991:     }\\n992:   }\\n993: \\n994:   const sessionId = randomUUID();\\n995:   const argv = job.runtime.buildArgv({ prompt: job.prompt, sessionId });\\n996:   // A runtime that names its session only in its own store is bracketed by a\\n997:   // listing, and the entry the turn added is the session it wrote. A dry run\\n998:   // starts no CLI, so it has nothing to list.\\n999:   const listed = !options.dryRun && listsStore(job.runtime);\\n1000:   const listingBefore = listed ? storeIds(job.runtime, job.ghConfig) : null;\\n1001:   const turn = options.dryRun\\n1002:     ? { exit: null, error: null, streamId: null }\\n1003:     : await spawnTurn(job.runtime, argv, job.prompt, job.cap, job.ghConfig);\\n1004:   const reportedId = listed\\n1005:     ? addedSessionId(listingBefore, storeIds(job.runtime, job.ghConfig))\\n1006:     : turn.streamId;\\n1007: \\n1008:   const after = { status: statusPaths(), ...gitSnapshot() };\\n1009:   const headMoved = before.head !== after.head || before.stash !== after.stash;\\n1010:   const changed = changedPaths(before.status, after.status);\\n1011:   // The locator is kept in hand because the brief reader opens the same session\\n1012:   // the line records, and resolving it twice could name a different file.\\n1013:   const locator = locatorFor(job.runtime, sessionId, reportedId);\\n1014:   const line = {\\n1015:     runtime: job.runtimeName,\\n1016:     rowId: job.rowId,\\n1017:     arm: options.arm,\\n1018:     locator,\\n1019:     exit: turn.exit,\\n1020:     changedPaths: changed,\\n1021:   };\\n1022: \\n1023:   if (headMoved) {\\n1024:     // The worktree the restore was written for is gone. Restoring now could discard\\n1025:     // whatever the commit or stash brought in, so the paths stay listed instead.\\n1026:     appendRunLine(options.out, { ...line, restored: false, headMoved: true });\\n1027:     return { status: EXIT_HEAD_MOVED, refusal: { ok: false, code: 'head_moved', rowId: job.rowId } };\\n1028:   }\\n1029: \\n1030:   // A dry run spawns nothing, so an unchanged worktree is the only thing it can\\n1031:   // honestly report as left as found.\\n1032:   const restore = options.dryRun ? null : restoreTurn({ cwd: REPO_ROOT, before: before.status });\\n1033:   const restored = options.dryRun ? changed.length === 0 : restore.restored;\\n1034:   // The head the reader saw is the only place the offer was named, and not every\\n1035:   // runtime keeps it, so the offer is replayed after the turn. A dry run still\\n1036:   // replays it, which lets an operator read the offer without paying for a model\\n1037:   // call, while the brief stays `unknown` because no session exists to read.\\n1038:   const offer = replayOffer({ checkoutDir: PROJECT_DIR, prompt: job.prompt, sessionId });\\n1039:   const delivered = options.dryRun\\n1040:     ? 'unknown'\\n1041:     : await briefDelivered({ runtime: job.runtimeName, locator });\\n1042:   appendRunLine(options.out, {\\n1043:     ...line,\\n1044:     offeredCommand: offer.offeredCommand,\\n[Output truncated. Continue reading with offset: 1045]\"}],\"providerCall\":{\"executed\":false},\"provider