-config.json\" \"$L/logs/run-open.json\" && node .skilled/skills/system-deep-loop/runtime/scripts/append-mode-event.cjs --mode research --run-directory \"$L\" --event-json \"$L/logs/run-open.json\"; echo \"EXIT=$?\""},"output":"{\"ok\":true,\"receipt\":{\"ledger_id\":\"deep-research-ledger\",\"sequence\":1,\"event_id\":\"event-ff8971f3-ecd4-4f04-9ab6-46041c973222\",\"event_type\":\"deep-research.ledger.run-initialized\",\"event_version\":1,\"stream_id\":\"deep-research-ledger\",\"stream_sequence\":1,\"committed_at\":\"2026-11-13T06:12:19.080Z\",\"canonicalEventHash\":\"6f8e7016969ce8223a4e34791f264be784d7cdeac4bfad28a1014da137a00fd8\",\"recordHash\":\"b21477518be5f9590fc826822def5c8b1e8d8dc33ed9103fc79cb5f264d716ab\",\"authorizationRef\":{\"audit_ledger_id\":\"deep-research-audit-ledger\",\"audit_sequence\":2,\"audit_record_hash\":\"6eee4e23c1381ef20cdf6985ee41822cd87524c6f827b6b162f0c36c7ab878a2\",\"decision_id\":\"decision-a6a98a51-2c86-4633-bc12-3fdab0881ed2\",\"decision_digest\":\"a8cacaad17cc893d4a84a4803f0991105e322e0cb1f8e3ac867c2ba1077d90b1\",\"request_digest\":\"7e842e8e0c1aa626d34eefa38f0601ddecf851ad944288d631a25e4a1caa4d43\",\"policy_digest\":\"a4b1c20c36f40aa5f6c82a50e7fb20354deda901fb7b2be8f51dc112f221c7dd\",\"authority_epoch\":1,\"fence_token\":1},\"ledgerId\":\"deep-research-ledger\",\"eventId\":\"event-ff8971f3-ecd4-4f04-9ab6-46041c973222\",\"eventType\":\"deep-research.ledger.run-initialized\",\"eventVersion\":1,\"streamId\":\"deep-research-ledger\",\"streamSequence\":1,\"committedAt\":\"2026-11-13T06:12:19.080Z\"},\"projectionRefreshed\":true,\"projectionError\":null}\nEXIT=0\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"{\"ok\":true,\"receipt\":{\"ledger_id\":\"deep-research-ledger\",\"sequence\":1,\"event_id\":\"event-ff8971f3-ecd4-4f04-9ab6-46041c973222\",\"event_type\":\"deep-research.ledger.run-initialized\",\"event_version\":1,\"stream_id\":\"deep-research-ledger