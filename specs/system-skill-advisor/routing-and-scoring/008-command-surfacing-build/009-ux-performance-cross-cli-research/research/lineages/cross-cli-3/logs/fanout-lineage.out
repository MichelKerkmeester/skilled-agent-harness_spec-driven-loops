eiling. The CLI request and the\n44: // brief render must carry the same bound, or a recommendation can pass one and\n45: // fail the other.\n46: const DEFAULT_THRESHOLD_UNCERTAINTY = 0.35;\n47: const DEFAULT_MAX_TOKENS = 80;\n48: const AMBIGUOUS_TOKEN_CAP = 120;\n49: const DEFAULT_BRIDGE_TIMEOUT_MS = 2500;\n50: const OBSERVED_ADVISOR_POLICY_CANDIDATE = '004';\n51: const DEFAULT_NODE_BINARY = 'node';\n52: const DEFAULT_MAX_PROMPT_BYTES = 64 * 1024;\n53: // advisor_recommend refuses a longer prompt, so a longer one is sent as its head\n54: // rather than refused and reported as an outage.\n55: const ADVISOR_PROMPT_MAX_CHARS = 10_000;\n56: const DEFAULT_MAX_BRIEF_CHARS = 2 * 1024;\n57: const DEFAULT_MAX_CACHE_ENTRIES = 1000;\n58: const MAX_BRIDGE_STDOUT_BYTES = 256 * 1024;\n59: // Unique prompts each need their own advisor child, so a burst must not multiply\n60: // live processes without limit.\n[Output truncated. Continue reading with offset: 61]"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"limit\": 60, \"offset\": 1, \"path\": \".opencode/plugins/system-skill-advisor.js\"}"},"time":{"start":1794550420770,"end":1794550420871}}}}
