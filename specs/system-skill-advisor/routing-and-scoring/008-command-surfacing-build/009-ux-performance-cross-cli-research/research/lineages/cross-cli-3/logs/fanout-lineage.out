e:diff\",\"sk-create-feature-catalog\":\"/create:feature-catalog\",\"sk-create-goal\":\"/create:goal\",\"sk-create-manual-testing-playbook\":\"/create:manual-testing-playbook\",\"sk-create-readme\":\"/create:readme\",\"sk-create-repo-rule\":\"/create:repo-rule\",\"sk-create-skill\":\"/create:skill\",\"sk-create-skill-parent\":\"/create:skill-parent\",\"sk-create-with-human-voice\":\"/create:with-human-voice\"}\nsystem-deep-loop: {\"ai-council\":\"/deep:ai-council\",\"research\":\"/deep:research\",\"review\":\"/deep:review\"}\ntypedCommandIn: \"/create:readme\"\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\": \"cd /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research && node -e '\\nconst m=require(\\\"./.skilled/skills/system-skill-advisor/runtime/dist/runtime/lib/command-attach.js\\\");\\nconsole.log(\\\"sk-doc:\\\", JSON.stringify(m.MODE_COMMANDS[\\\"sk-doc\\\"]));\\nconsole.log(\\\"system-deep-loop:\\\", JSON.stringify(m.MODE_COMMANDS[\\\"system-deep-loop\\\"]));\\ntry { console.log(\\\"typedCommandIn:\\\", JSON.stringify(m.typedCommandIn(\\\"/create:readme for the utils folder\\\"))); } catch(e){ console.log(\\\"typed err\\\", e.message); }\\n'\"}"},"time":{"start":1794551068470,"end":1794551068659}}}}
