s : null;\n1468:   } finally {\n1469:     if (previous === undefined) {\n1470:       delete process.env[forceLocalEnv];\n1471:     } else {\n1472:       process.env[forceLocalEnv] = previous;\n1473:     }\n1474:   }\n1475: }\n1476: \n1477: // The local scorer names command ids, but a reader can only act on a command they\n1478: // typed or on the skill that owns it. A row whose bare slash command appears in\n1479: // the prompt keeps its command fields, and every other row collapses to its owner\n1480: // skill so the degraded brief names a skill that exists instead of a raw row id.\n1481: export function degradedRecommendations(\n1482:   entries: readonly AdvisorRecommendation[],\n1483:   prompt: string,\n1484: ): Array<Record<string, unknown>> {\n1485:   const offeredSkills = new Set<string>();\n1486:   const recommendations: Array<Record<string, unknown>> = [];\n1487: \n1488:   for (const entry of entries) {\n1489:     if (entry.passes_threshold !== true) continue;\n1490:     const base = {\n1491:       confidence: entry.confidence,\n1492:       uncertainty: entry.uncertainty,\n1493:       reason: entry.reason ?? '',\n1494:     };\n1495:     const row = commandRowFor(entry.skill);\n1496: \n1497:     if (row && prompt.includes(row.command.split(' ')[0])) {\n1498:       recommendations.push({\n1499:         skillId: entry.skill,\n1500:         kind: 'command',\n1501:         command: row.command,\n1502:         ...(row.policy ? { policy: row.policy } : {}),\n1503:         ownerSkillId: row.ownerSkillId,\n1504:         ...base,\n1505:       });\n1506:       offeredSkills.add(entry.skill);\n1507:       continue;\n1508:     }\n1509: \n1510:     if (row) {\n1511:       if (offeredSkills.has(row.ownerSkillId)) continue;\n1512:       recommendations.push({\n1513:         skillId: row.ownerSkillId,\n1514:         kind: 'skill',\n1515:         ...base,\n1516:       });\n1517:       offeredSkills.add(row.ownerSkillId);\n1518:       continue;\n1519:     }\n1520: \n1521:     