g(thresholdConfig?.uncertaintyThreshold ?? resolvedUncertaintyThreshold());\n125-  const args = ['--threshold', confidenceThreshold, '--uncertainty', uncertaintyThreshold];\n126-  if (thresholdConfig?.confidenceOnly) {\n127-    args.push('--confidence-only');\n128-  }\n129-  if (thresholdConfig?.showRejections) {\n130-    args.push('--show-rejections');\n131-  }\n132-  return args;\n133-}\n134-\n.skilled/skills/system-skill-advisor/runtime/dist/runtime/skill-advisor-cli.js\n1329:export function degradedRecommendations(entries, prompt) {\n1420:                    recommendations: degradedRecommendations(recommendations, prompt),\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\": \"cd /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research && rg -n \\\"function thresholdArgs\\\" -A 12 .skilled/skills/system-skill-advisor/runtime/lib/subprocess.ts; ls .skilled/skills/system-skill-advisor/runtime/dist/runtime/skill-advisor-cli.js 2>&1; rg -n \\\"degradedRecommendations\\\" .skilled/skills/system-skill-advisor/runtime/dist/runtime/skill-advisor-cli.js | head -3\"}"},"time":{"start":1794550932149,"end":1794550932352}}}}
