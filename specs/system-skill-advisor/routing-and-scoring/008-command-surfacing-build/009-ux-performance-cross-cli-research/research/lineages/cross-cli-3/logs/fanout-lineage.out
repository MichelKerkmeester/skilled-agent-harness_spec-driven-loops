lds stay authoritative and the generated row fills only what they omit, so a\n222: // caller that already resolved the command is never second-guessed.\n223: function commandLabel(recommendation: RenderableRecommendation, childSession: boolean): string | null {\n224:   const row = commandRowFor(recommendation.skill);\n225:   const command = recommendation.command ?? row?.command;\n226:   const owner = recommendation.ownerSkillId ?? row?.ownerSkillId ?? recommendation.skill;\n227:   const policy = recommendation.policy ?? row?.policy;\n228:   const commandPart = command === undefined ? null : sanitizeSkillLabel(command);\n229:   const ownerPart = sanitizeSkillLabel(owner);\n230:   if (!commandPart || !ownerPart) {\n231:     return null;\n232:   }\n233:   const policyPart = policyWord(policy, row?.mutating, childSession);\n234:   return policyPart === null\n235:     ? `${ownerPart} → ${commandPart}`\n236:     : `${ownerPart} → ${commandPart} (${policyPart})`;\n237: }\n238: \n239: // A doctor bridge renders as its runnable command and never as its raw id; an\n240: // unmapped doctor id renders nothing.\n241: function recommendationLabel(recommendation: RenderableRecommendation, childSession: boolean): string | null {\n242:   return commandLabel(recommendation, childSession)\n243:     ?? (isDoctorBridgeId(recommendation.skill)\n244:       ? doctorCommandString(recommendation.skill)\n245:       : sanitizeSkillLabel(recommendation.skill));\n246: }\n247: \n248: // The companion line normally shows only the runnable command. A child gets the\n249: // downgrade marker appended because that command must not be started there.\n250: function companionCommandLabel(skillId: string, childSession: boolean): string | null {\n251:   const command = doctorCommandString(skillId);\n252:   if (command === null) {\n253:     return null;\n254:   }\n255:   const row = commandRowFor(skillId);\n256:   return childSession && parentNamedOnly(row?.policy, row?.mutating)\n257:     ? `${command} (