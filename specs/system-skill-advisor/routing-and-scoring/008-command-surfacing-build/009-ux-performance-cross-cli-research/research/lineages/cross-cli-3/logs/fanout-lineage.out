{"type":"tool_use","timestamp":1794550348935,"sessionID":"ses_e2c799dd1ffeZnROszLt7sZevy","part":{"partID":"prt_1d3893c3000132WvyjYBWQbjC7","sessionID":"ses_e2c799dd1ffeZnROszLt7sZevy","messageID":"msg_1d389343f001e8m51C35zMuV2W","type":"tool","id":"call_00_73rezc5n6godogx85k8ovimk","tool":"read","state":{"status":"completed","input":{"limit":130,"offset":520,"path":".skilled/skills/system-skill-advisor/runtime/lib/render.ts"},"output":"Read file .skilled/skills/system-skill-advisor/runtime/lib/render.ts, lines 520-649\n520:   const tokenCap = clampTokenCap(result.metrics?.tokenCap ?? options.tokenCap);\n521:   const thresholdConfig = options.thresholdConfig;\n522:   const childSession = options.childSession ?? process.env.AI_SESSION_CHILD === '1';\n523:   const recommendations = result.recommendations.filter((recommendation) => (\n524:     recommendation.passes_threshold === true\n525:     || (\n526:       recommendation.confidence >= (thresholdConfig?.confidenceThreshold ?? resolvedConfidenceThreshold())\n527:       && (\n528:         thresholdConfig?.confidenceOnly === true\n529:         || recommendation.uncertainty <= (thresholdConfig?.uncertaintyThreshold ?? resolvedUncertaintyThreshold())\n530:       )\n531:     )\n532:   ));\n533:   const [top, second] = recommendations;\n534:   if (!top) {\n535:     observeAdvisorPolicy(null, options);\n536:     return null;\n537:   }\n538: \n539:   const topLabel = commandLabel(top, childSession)\n540:     ?? (isDoctorBridgeId(top.skill)\n541:       ? doctorCommandString(top.skill)\n542:       : sanitizeSkillLabel(metadataSkillLabel(result) ?? top.skill));\n543:   if (!topLabel) {\n544:     observeAdvisorPolicy(null, options);\n545:     return null;\n546:   }\n547: \n548:   // A hub that withheld its command because the prompt names no single mode says\n549:   // so, so the reader asks for the mode instead of improvising one.\n550:   const headLabel = top.needsMode === true && top.command === undefined && commandRowFor(top.skill) === undefined\n551:     ? `${topLabel} (needs a mode)`\n552:     : topLabel;\n553: \n554:   const companion = isDoctorBridgeId(top.skill)\n555:     ? undefined\n556:     : recommendations.slice(1).find((recommendation) => doctorCommandString(recommendation.skill) !== null);\n557:   const companionLabel = companion ? companionCommandLabel(companion.skill, childSession) : null;\n558:   const companionLine = (shownSecond: string | undefined): string => (\n559:     companionLabel && companion && companion.skill !== shownSecond ? `\\nAlso: ${companionLabel}` : ''\n560:   );\n561:   const capWithCompanion = (head: string, companionText: string, cap: number): string => {\n562:     const companionFits = head.length + companionText.length <= cap * TOKEN_TO_CHAR_ESTIMATE;\n563:     return `${capText(head, cap)}${companionFits ? companionText : ''}`;\n564:   };\n565: \n566:   const precomputedAmbiguous = typeof result.ambiguous === 'boolean' ? result.ambiguous : undefined;\n567:   if (tokenCap > DEFAULT_TOKEN_CAP && second && hasAdvisorAmbiguitySignal(recommendations, precomputedAmbiguous)) {\n568:     // The scorer names its own tie partners, which can sit below the second passing\n569:     // entry, so prefer a named partner and fall back to the second entry.\n570:     const namedPartners = (top as RenderableRecommendation).ambiguousWith;\n571:     const ambiguousWith: readonly string[] = Array.isArray(namedPartners) ? namedPartners : [];\n572:     const vs = (ambiguousWith.length > 0\n573:       ? recommendations.find((recommendation) => ambiguousWith.includes(recommendation.skill))\n574:       : undefined) ?? second;\n575:     const vsLabel = recommendationLabel(vs, childSession);\n576:     if (!vsLabel && !isDoctorBridgeId(vs.skill)) {\n577:       observeAdvisorPolicy(null, options);\n578:       return null;\n579:     }\n580:     if (vsLabel) {\n581:       const head = `Advisor: ${result.freshness}; ambiguous: ${headLabel} `\n582:         + `${formatScore(top.confidence)}/${formatScore(top.uncertainty)} vs ${vsLabel} `\n583:         + `${formatScore(vs.confidence)}/${formatScore(vs.uncertainty)} pass.`;\n584:       const rendered = capWithCompanion(\n585:         head,\n586:         companionLine(vs.skill),\n587:         Math.min(tokenCap, AMBIGUOUS_TOKEN_CAP),\n588:       ) + DIRECTIVES_LABEL + HYGIENE_DIRECTIVE;\n589:       observeAdvisorPolicy(rendered, options);\n590:       return rendered;\n591:     }\n592:   }\n593: \n594:   const head = `Advisor: ${result.freshness}; use ${headLabel} `\n595:     + `${formatScore(top.confidence)}/${formatScore(top.uncertainty)} pass.`;\n596:   const rendered = capWithCompanion(\n597:     head,\n598:     companionLine(undefined),\n599:     Math.min(tokenCap, DEFAULT_TOKEN_CAP),\n600:   ) + DIRECTIVES_LABEL + HYGIENE_DIRECTIVE;\n601:   observeAdvisorPolicy(rendered, options);\n602:   return rendered;\n603: }\n604: \n605: /** Classify a result with no brief; no result at all means the advisor did not answer. */\n606: export function advisorFallbackCase(\n607:   result?: Pick<AdvisorHookResult, 'status' | 'freshness'>,\n608: ): AdvisorFallbackClassification {\n609:   if (!result || result.status === 'fail_open' || result.freshness === 'absent'\n610:     || (result.freshness === 'unavailable' && result.status !== 'skipped')) {\n611:     return {\n612:       fallbackCase: 'outage',\n613:       outageLabel: result?.freshness === 'absent'\n614:         ? 'absent'\n615:         : result?.status === 'degraded'\n616:           ? 'degraded'\n617:           : 'fail_open',\n618:     };\n619:   }\n620:   if (result.status === 'skipped' && result.freshness === 'unavailable') {\n621:     return { fallbackCase: 'skipped' };\n622:   }\n623:   return { fallbackCase: 'no-match' };\n624: }\n625: \n626: /** Render the fallback status and directive block when no advisor brief is available. */\n627: export function renderAdvisorFallbackDirective(\n628:   options: AdvisorBriefRenderOptions = {},\n629:   result?: Pick<AdvisorHookResult, 'status' | 'freshness'>,\n630: ): string {\n631:   const classification = advisorFallbackCase(result);\n632:   const head = classification.fallbackCase === 'outage'\n633:     ? `Advisor: outage (${classification.outageLabel});${options.setupWording === true ? ' for setup or health checks, run /doctor:setup;' : ''} route by hand: node .skilled/bin/skill-advisor.cjs advisor_recommend --json '{\"prompt\":\"<request>\"}' --format json`\n634:     : classification.fallbackCase === 'skipped'\n635:       ? 'Advisor: prompt skipped.'\n636:       : options.setupWording === true\n637:         ? `Advisor: no skill matched.${SETUP_HINT}`\n638:         : 'Advisor: no skill matched.';\n639:   const rendered = head + DIRECTIVES_LABEL + HYGIENE_DIRECTIVE;\n640:   observeAdvisorPolicy(rendered, options);\n641:   return rendered;\n642: }\n643: \n644: /** Render the outage fallback used when advisor execution times out or is unavailable. */\n645: export function renderAdvisorTimeoutFallback(\n646:   options: AdvisorBriefRenderOptions = {},\n647:   status: Extract<AdvisorHookResult['status'], 'fail_open' | 'degraded'> = 'fail_open',\n648: ): string {\n649:   return renderAdvisorFallbackDirective(options, { status, freshness: 'unavailable' });\n[Output truncated. Continue reading with offset: 650]","title":"read","metadata":{"metadata":{"truncated":true},"content":[{"type":"text","text":"Read file .skilled/skills/system-skill-advisor/runtime/lib/render.ts, lines 520-649\n520:   const tokenCap = clampTokenCap(result.metrics?.tokenCap ?? options.tokenCap);\n521:   const thresholdConfig = options.thresholdConfig;\n522:   const childSession = options.childSession ?? process.env.AI_SESSION_CHILD === '1';\n523:   const recommendations = result.recommendations.filter((recommendation) => (\n524:     recommendation.passes_threshold === true\n525:     || (\n526:       recommendation.confidence >= (thresholdConfig?.confidenceThreshold ?? resolvedConfidenceThreshold())\n527