uldDeliver) {\n1024:     messageIdentity.commitTransformDelivery(\n1025:       decision.identity,\n1026:       decision.blockId,\n1027:       decision.contentHash,\n1028:       { transform: PLUGIN_ID },\n1029:     );\n1030:     return;\n1031:   }\n1032:   messageIdentity.releaseTransformReservation(\n1033:     decision.identity,\n1034:     decision.blockId,\n1035:     decision.contentHash,\n1036:   );\n1037: }\n1038: \n1039: function releaseTransformContribution(decision) {\n1040:   if (!decision?.identity || !decision.blockId || !decision.contentHash) return;\n1041:   messageIdentity.releaseTransformReservation(\n1042:     decision.identity,\n1043:     decision.blockId,\n1044:     decision.contentHash,\n1045:   );\n1046: }\n1047: \n1048: function deliverTransformContribution(decision, deliver) {\n1049:   if (!decision?.shouldDeliver) {\n1050:     commitTransformContribution(decision);\n1051:     return;\n1052:   }\n1053:   try {\n1054:     deliver();\n1055:     commitTransformContribution(decision);\n1056:   } catch (error) {\n1057:     releaseTransformContribution(decision);\n1058:     throw error;\n1059:   }\n1060: }\n1061: \n1062: // ─────────────────────────────────────────────────────────────────────────────\n1063: // 6. PLUGIN FACTORY\n1064: // ─────────────────────────────────────────────────────────────────────────────\n1065: \n1066: /**\n1067:  * Create the Spec Kit skill advisor OpenCode plugin hooks.\n1068:  *\n1069:  * @param {import('@opencode-ai/plugin').PluginInput} ctx - OpenCode plugin context\n1070:  * @param {Object} [rawOptions] - Plugin options\n1071:  * @param {boolean} [rawOptions.enabled] - Whether the plugin should inject advisor briefs\n1072:  * @param {number} [rawOptions.cacheTTLMs] - Advisor cache TTL in milliseconds\n1073:  * @param {number} [rawOptions.cacheTtlMs] - Advisor cache TTL alias in milliseconds\n1074:  * @param {number} [rawOptions.thresholdConfidence] - Minimum advisor confidence threshold\n1075:  * @param {number} [rawOpt