ack.ts, lines 455-514\n455: // reader gets about why no brief appeared, and a wrong one here sends them\n456: // hunting a transport failure that never happened.\n457: export function resultFromCliData(args: {\n458:   readonly data: CliRecommendData;\n459:   readonly options: SkillAdvisorCliFallbackOptions;\n460:   readonly startedAt: number;\n461:   readonly now: () => number;\n462: }): AdvisorHookResult {\n463:   const degraded = args.data.degraded === true || args.data.source === LOCAL_SCORER_SOURCE;\n464:   const freshness = freshnessFrom(args.data.freshness, degraded);\n465:   const thresholds = thresholdsFrom(args.data, args.options);\n466:   const recommendations = Array.isArray(args.data.recommendations)\n467:     ? args.data.recommendations\n468:       .map((recommendation) => recommendationFromCli(recommendation, thresholds))\n469:       .filter((recommendation): recommendation is CliAdvisorRecommendation => Boolean(recommendation?.passes_threshold))\n470:     : [];\n471:   const ambiguous = typeof args.data.ambiguous === 'boolean' ? args.data.ambiguous : undefined;\n472:   const tokenCap = Math.min(Math.max(1, Math.floor(args.options.maxTokens ?? (ambiguous === true ? 120 : 80))), 120);\n473:   const status = resultStatus(freshness, recommendations);\n474:   const warnings = Array.isArray(args.data.warnings)\n475:     ? args.data.warnings.filter((value): value is string => typeof value === 'string')\n476:     : [];\n477:   // A live or stale advisor that returned nothing above the threshold answered\n478:   // the question; it simply had no skill to name. Reporting that as an outage\n479:   // sends a reader hunting a transport failure that never happened, which has\n480:   // already cost one long investigation.\n481:   const answeredWithNoMatch = freshness === 'live' || freshness === 'stale';\n482:   const reason = status === 'ok'\n483:     ? 'ok'\n484:     : answeredWithNoMatch\n485:       ? 'no_recommendation'\n486:       : (freshness === 'absent' ? 'advisor_absent' : 'advisor_unavailable');\n487:   const hookResult: CliFallbackHookResult = {\n488:     status,\n489:     freshness,\n490:     brief: null,\n491:     recommendations,\n492:     ...(ambiguous === undefined ? {} : { ambiguous }),\n493:     diagnostics: status === 'ok'\n494:       ? (freshness === 'stale' && warnings[0] ? { staleReason: warnings[0] } : null)\n495:       : answeredWithNoMatch\n496:         ? {\n497:           // No error code or class: nothing failed, so naming a failure class\n498:           // here is what made this look like an outage in the first place.\n499:           reason: 'no_recommendation',\n500:           errorMessage: 'CLI_ADVISOR_NO_MATCH',\n501:         }\n502:         : {\n503:           errorCode: 'NON_ZERO_EXIT',\n504:           errorClass: 'unknown',\n505:           errorMessage: freshness === 'absent' ? 'CLI_ADVISOR_ABSENT' : 'CLI_ADVISOR_UNAVAILABLE',\n506:         },\n507:     metrics: {\n508:       durationMs: Number((args.now() - args.startedAt).toFixed(3)),\n509:       cacheHit: cacheHitFrom(args.data),\n510:       subprocessInvoked: true,\n511:       retriesAttempted: 0,\n512:       recommendationCount: recommendations.length,\n513:       tokenCap,\n514:     },\n[Output truncated. Continue reading with offset: 515]"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"limit\": 60, \"offset\": 455, \"path\": \".skilled/skills/system-skill-advisor/hooks/lib/skill-advisor-cli-fallback.ts\"}"},"time":{"start":1794550391726,"end":1794550391756}}}}
