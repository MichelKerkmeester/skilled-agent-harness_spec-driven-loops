uting-accuracy/command-prompts.jsonl && : > $L/prompts/none-floor-live.jsonl && jq -c 'select(.split==\\\"none\\\") | select(.row_type==\\\"must-not-start\\\" or .row_type==\\\"near-miss\\\" or (.row_type==\\\"slash-variant\\\" and .expected_command==null)) | {id, row_type, prompt}' $F | while IFS= read -r row; do ID=$(printf '%s' \\\"$row\\\" | jq -r .id); RT=$(printf '%s' \\\"$row\\\" | jq -r .row_type); PAYLOAD=$(printf '%s' \\\"$row\\\" | jq -c '{prompt}'); OUT=$(env -u AI_SESSION_CHILD node .skilled/bin/skill-advisor.cjs advisor_recommend --json \\\"$PAYLOAD\\\" --format json 2>/dev/null); printf '%s' \\\"$OUT\\\" | jq -c --arg id \\\"$ID\\\" --arg rt \\\"$RT\\\" '{id:$id, row_type:$rt, recs:[.data.recommendations[]? | {skillId, score, confidence, uncertainty, command:(.command // null)}]}' >> $L/prompts/none-floor-live.jsonl; done; wc -l $L/prompts/none-floor-live.jsonl; jq -s '{rows:length, withCommand: (map(select(any(.recs[]?; .command != null)))|length), topSkills: (map(.recs[0].skillId // \\\"none\\\")|group_by(.)|map({k:.[0],n:length})|sort_by(-.n))}' $L/prompts/none-floor-live.jsonl\",\"timeout\":300000}"},"time":{"start":1794551321054,"end":1794551332303}}}}
