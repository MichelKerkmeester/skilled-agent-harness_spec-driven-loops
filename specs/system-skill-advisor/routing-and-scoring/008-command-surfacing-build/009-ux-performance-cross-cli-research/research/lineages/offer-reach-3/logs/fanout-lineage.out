147:  return Math.min(Math.max(1, Math.floor(tokenCap)), MAX_TOKEN_CAP);\n155:  const truncated = text.slice(0, Math.max(1, charCap - 3)).trimEnd();\n295: * a confidence floor, and serialized recommendations lose that context. Only when the\n299:  recommendations: readonly AdvisorRecommendation[],\n305:  return isAmbiguousTopTwo((recommendations as readonly RenderableRecommendation[]).map(toScoredRecommendation));\n342:  if (SHADOW_ROUTE_ONLY_LOG.length >= MAX_SHADOW_ROUTE_ONLY_LOG) {\n416:      : Math.max(0, emittedByteCount - routeOnlyByteCount);\n523:  const recommendations = result.recommendations.filter((recommendation) => (\n533:  const [top, second] = recommendations;\n556:    : recommendations.slice(1).find((recommendation) => doctorCommandString(recommendation.skill) !== null);\n567:  if (tokenCap > DEFAULT_TOKEN_CAP && second && hasAdvisorAmbiguitySignal(recommendations, precomputedAmbiguous)) {\n573:      ? recommendations.find((recommendation) => ambiguousWith.includes(recommendation.skill))\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"cd /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research && R=.skilled/skills/system-skill-advisor/runtime/lib/render.ts && grep -n \\\"slice\\\\|MAX\\\\|max\\\\|heads\\\\|recommendations\\\" $R | head -40\"}"},"time":{"start":1794550598152,"end":1794550598213}}}}
