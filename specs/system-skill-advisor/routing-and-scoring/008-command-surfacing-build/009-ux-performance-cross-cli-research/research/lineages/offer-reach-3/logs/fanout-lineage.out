 // route only because the advisor derives the slash command from it, and a\n237:      // recommendation with no command cannot tell the reader which mode to run.\n242:      // Forward caller thresholds so the CLI scorer applies them; without this\n243:      // the scorer uses its own defaults and thresholdsFrom trusts the echoed\n331:// A degraded answer is still an answer: the CLI spent its own local scorer because no\n332:// daemon answered, so the route is stale, not missing. Reporting it as unavailable is\n334:function freshnessFrom(value: unknown, degraded: boolean): AdvisorHookFreshness {\n335:  if (value === 'live' || value === 'stale' || value === 'absent' || value === 'unavailable') {\n338:  return degraded ? 'stale' : 'unavailable';\n355:  // The slash command that runs the mode the advisor routed this skill to. Absent\n357:  readonly command?: string;\n368:    // A command row names the mode it runs, so the reader must keep that kind\n370:    kind: value.kind === 'skill' || value.kind === 'command' ? value.kind : 'skill',\n377:    // The brief re-derives ambiguity from these fields, so the typed-command hold\n378:    // must survive the trip or a pair the command already ranked reads as a tie.\n380:    // Kept only when it names something: an empty command would render a blank\n381:    // prompt where the reader expects a slash command to type.\n382:    ...(typeof value.command === 'string' && value.command.trim() !== '' ? { command: value.command } : {}),\n383:    // An unknown policy or a blank owner would render as if it were real, so each\n385:    ...(value.policy === 'run' || value.policy === 'start' || value.policy === 'ask' ? { policy: value.policy } : {}),\n387:    // A hub that held back its command for want of a mode keeps that signal, so\n388:    // the head can say why no command came with it.\n389:    ...(value.needsMode === true ? { needsMode: true } : {}),\n397:function resultStatus(freshness: AdvisorHookFreshness, recommendations: readonly AdvisorRecommendation[]): WarmSkillAdvisorCliFallbackStatus {\n398:  if ((freshness === 'live' || freshness === 'stale') && recommendations.length > 0) {\n401:  if (freshness === 'unavailable') {\n413:  readonly reason: string;\n420:    freshness: 'unavailable',\n440:    reason: args.reason,\n464:  const freshness = freshnessFrom(args.data.freshness, degraded);\n473:  const status = resultStatus(freshness, recommendations);\n477:  // A live or stale advisor that returned nothing above the threshold answered\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"     621 .skilled/skills/system-skill-advisor/hooks/lib/skill-advisor-cli-fallback.ts\n43:  readonly freshness?: unknown;\n50:  // freshness decision can tell a degraded local-scorer answer from a missing one.\n59:  readonly reason: string;\n66:  readonly reason?: string | null;\n93:const LOCAL_SCORER_SOURCE = 'local-scorer';\n96:// CLI fallback envelope; 'socket_absent' and 'timeout' are the canonical\n97:// spellings for those conditions across the warm-fallback hook helpers.\n113:function normalizeSkillAdvisorCliFallbackReason(reason: string | null | undefined, exitCode: number | null, status: WarmSkillAdvisorCliFallbackStatus): string {\n114:  const trimmed = typeof reason === 'string' ? reason.trim() : '';\n131:  const reason = normalizeSkillAdvisorCliFallbackReason(input.reason, exitCode, input.status);\n134:    reason,\n136:    retryable: input.status !== 'ok' && (input.timedOut === true || exitCode === EXIT_RETRYABLE || RETRYABLE_REASONS.has(reason)),\n147:function positiveIntFromEnv(value: string | undefined, fallback: number): number {\n149:    return fallback;\n152:  return Number.isFinite(parsed) && parsed > 0 ? parsed : fallback;\n155:function clampUnitThreshold(value: number | undefined, fallback: number): number {\n158:    : fallback;\n171:  // The caller budget is the hook's real deadline; clamping it to the fallback\n236:      // route only because the advisor derives the slash command from it, and a\n237:      // recommendation with no command cannot tell the reader which mode to run.\n242:      // Forward caller thresholds so the CLI scorer applies them; without this\n243:      // the scorer uses its own defaults and thresholdsFrom trusts the echoed\n331:// A degraded answer is still an answer: the CLI spent its own local scorer because no\n332:// daemon answered, so the route is stale, not missing. Reporting it as unavailable is\n334:function freshnessFrom(value: unknown, degraded: boolean): AdvisorHookFreshness {\n335:  if (value === 'live' || value === 'stale' || value === 'absent' || value === 'unavailable') {\n338:  return degraded ? 'stale' : 'unavailable';\n355:  // The slash command that runs the mode the advisor routed this skill to. Absent\n357:  readonly command?: string;\n368:    // A command row names the mode it runs, so the reader must keep that kind\n370:    kind: value.kind === 'skill' || value.kind === 'command' ? value.kind : 'skill',\n377:    // The brief re-derives ambiguity from these fields, so the typed-command hold\n378:    // must survive the trip or a pair the command already ranked reads as a tie.\n380:    // Kept only when it names something: an empty command would render a blank\n381:    // prompt where the reader expects a slash command to type.\n382:    ...(typeof value.command === 'string' && value.command.trim() !== '' ? { command: value.command } : {}),\n383:    // An unknown policy or a blank owner would render as if it were real, so each\n385:    ...(value.policy === 'run' || value.policy === 'start' || value.policy === 'ask' ? { policy: value.policy } : {}),\n387:    // A hub that held back its command for want of a mode keeps that signal, so\n388:    // the head can say why no command came with it.\n389:    ...(value.needsMode === true ? { needsMode: true } : {}),\n397:function resultStatus(freshness: AdvisorHookFreshness, recommendations: readonly AdvisorRecommendation[]): WarmSkillAdvisorCliFallbackStatus {\n398:  if ((freshness === 'live' || freshness === 'stale') && recommendations.length > 0) {\n401:  if (freshness === 'unavailable') {\n413:  readonly reason: string;\n420:    freshness: 'unavailable',\n440:    reason: args.reason,\n464:  const freshness = freshnessFrom(args.data.freshness, degraded);\n473:  const status = resultStatus(freshness, recommendations);\n477:  // A live or stale advisor that returned nothing above the threshold answered\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"cd /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research && F=.skilled/skills/system-skill-advisor/hooks/lib/skill-advisor-cli-fallback.ts && wc -l $F && grep -n \\\"command\\\\|policy\\\\|needsMode\\\\|reason\\\\|freshness\\\\|stale\\\\|scorer\\\\|fallback\\\" $F | head -50\"}"},"time":{"start":1794551027306,"end":1794551028055}}}}
