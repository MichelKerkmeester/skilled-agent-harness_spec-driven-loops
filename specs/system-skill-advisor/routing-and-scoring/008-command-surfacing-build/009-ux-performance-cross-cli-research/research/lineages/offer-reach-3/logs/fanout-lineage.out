core = cosineSimilarity(promptVector, skillVector);\n293:        skillId,\n296:        evidence: [`cosine-exact:${score.toFixed(4)}`],\n311:    return projection.skills\n312:      .map((skill) => ({\n313:        skillId: skill.id,\n316:          skill.name,\n317:          skill.description,\n318:          ...skill.domains,\n319:          ...skill.intentSignals,\n320:          ...skill.derivedTriggers,\n321:        ]) * 0.8, 1),\n325:      .filter((match) => match.score > 0.08);\n336:    ? new Map(projection.skills.map((skill) => [skill.id, fixtureVector([\n337:        skill.name,\n338:        skill.description,\n339:        ...skill.domains,\n340:        ...skill.intentSignals,\n341:        ...skill.derivedTriggers,\n348:      loadSkillEmbeddings(projection.skills.map((skill) => skill.id))\n349:        .map((row) => [row.skillId, row.embedding]),\n354:      setRuntimeHealth({ disabledReason: 'skill_embedding_load_failed' });\n355:      console.warn(`[semantic-shadow] Skill embedding load failed; cosine lane disabled (${message})`);\n360:  if (projection.source !== 'fixture' && process.env.VITEST !== 'true' && projection.skills.length > 0 && cachedVectors.size === 0) {\n361:    setRuntimeHealth({ disabledReason: 'no_skill_vectors' });\n364:  return projection.skills\n365:    .map((skill): LaneMatch | null => {\n366:      const skillVector = cachedVectors.get(skill.id) ?? fixtureVectors.get(skill.id);\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"     390 .skilled/skills/system-skill-advisor/runtime/lib/scorer/lanes/semantic-shadow.ts\n15:import { getDbReadOnly, loadSkillEmbeddings } from '../../skill-graph/skill-graph-db.js';\n22:const COSINE_THRESHOLD = 0.2;\n72:function cosineSimilarity(left: Float32Array, right: Float32Array): number {\n163:      throw new Error('skill graph database is absent; shadow scoring disabled');\n215:    console.warn(`[semantic-shadow] Prompt embedding failed;