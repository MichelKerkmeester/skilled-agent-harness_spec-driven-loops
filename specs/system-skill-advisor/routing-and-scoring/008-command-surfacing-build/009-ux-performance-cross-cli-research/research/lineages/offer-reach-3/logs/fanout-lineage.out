-quality-control\",\n40:          \"sk-create-quality-control\"\n69:    \"sk-create-readme\": {\n72:        \"create-readme-aliases\"\n75:        \"sk-create-readme/SKILL.md\"\n141:    \"sk-create-quality-control\": {\n144:        \"create-quality-control-aliases\",\n148:        \"sk-create-quality-control/SKILL.md\"\n160:    \"sk-create-with-human-voice\": {\n163:        \"create-with-human-voice-aliases\"\n166:        \"sk-create-with-human-voice/SKILL.md\"\n240:    \"create-readme-aliases\": {\n242:        \"create readme\",\n243:        \"readme\",\n244:        \"folder readme\",\n245:        \"write readme\",\n247:        \"code folder readme\",\n249:        \"/create:readme\"\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"cd /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research && H=.skilled/skills/sk-doc/hub-router.json && jq -r 'keys' $H && jq -r '.aliases // .modes // empty | to_entries[:8][] | [.key, (.value|tostring)] | @tsv' $H 2>/dev/null | cut -c1-160; echo \\\"--- grep readme/voice/quality\\\"; grep -n \\\"readme\\\\|human-voice\\\\|quality-control\\\" $H | head -20\"}"},"time":{"start":1794551229623,"end":1794551231639}}}}
