, typedCommandForTop } from '../lib/command-attach.js';\n317:  const commandRow = commandRowFor(recommendation.skill);\n377:function compiledRouteForRecommendation(\n411:    const compiledRoute = parsed as Record<string, unknown>;\n412:    return compiledRoute.servingAuthority === 'legacy' ? undefined : compiledRoute;\n443:  // cohort), so unset attaches compiledRoute for those hubs; the kill-switch\n462:      const compiledRoute = compiledRouteForRecommendation(\n468:      if (!compiledRoute) return recommendation;\n472:      const command = attachCommand(recommendation.skillId, compiledRoute, prompt);\n476:          compiledRoute,\n480:        : { ...recommendation, compiledRoute, ...(!command && routeNeedsMode(recommendation.skillId, compiledRoute) ? { needsMode: true as const } : {}) };\n627:        : enrichCompiledRoutes(parsedCachedOutput, input.prompt, workspaceRoot, input.options?.surfaceHint, input.options?.compiledRouteTopOnly === true),\n702:      : enrichCompiledRoutes(parsed, input.prompt, workspaceRoot, input.options?.surfaceHint, input.options?.compiledRouteTopOnly === true),\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"cd /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research && H=.skilled/skills/system-skill-advisor/runtime/handlers/advisor-recommend.ts && grep -n \\\"attachCommand\\\\|needsMode\\\\|routeNeedsMode\\\\|commandRowFor\\\\|compiledRoute\\\" $H | head -40\"}"},"time":{"start":1794550576083,"end":1794550576711}}}}
