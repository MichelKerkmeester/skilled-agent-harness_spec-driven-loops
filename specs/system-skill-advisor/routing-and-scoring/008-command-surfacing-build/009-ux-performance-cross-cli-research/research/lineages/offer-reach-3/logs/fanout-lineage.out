    must-not-start  0.090611  0.82  0.34  system-skilled-doctor,sk-code,sk-doc\nnm-system-skilled-doctor-01  near-miss       0.240312  0.82  0.22  system-skilled-doctor\nsv-03                        slash-variant   0.125331  0.82  0.26  system-skilled-doctor,cli-external-orchestration,mcp-code-mode\n--- tune keyword counts\ncmd-create-readme-plain-tune-01\t/create:readme\ncmd-create-diff-plain-tune-01\t/create:diff\ncmd-create-with-human-voice-plain-tune-01\t/create:with-human-voice\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"cd /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research && L=specs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/009-ux-performance-cross-cli-research/research/lineages/offer-reach-3 && echo \\\"--- doctor-top floor rows\\\" && jq -r 'select(.recs[0].skillId==\\\"system-skilled-doctor\\\") | [.id, .row_type, (.recs[0].score|tostring), (.recs[0].confidence|tostring), (.recs[0].uncertainty|tostring), ([.recs[].skillId]|join(\\\",\\\"))] | @tsv' $L/prompts/none-floor-live.jsonl | column -t -s $'\\\\t'; echo \\\"--- tune keyword counts\\\" && F=.skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/command-prompts.jsonl && jq -r 'select(.split==\\\"tune\\\") | select(.prompt|test(\\\"overview|quality bar\\\";\\\"i\\\")) | [.id, .expected_command] | @tsv' $F; jq -r 'select(.split==\\\"tune\\\") | select(.prompt|test(\\\"rewrite|human|person wrote\\\";\\\"i\\\")) | [.id, .expected_command] | @tsv' $F\"}"},"time":{"start":1794551340179,"end":1794551342386}}}}
