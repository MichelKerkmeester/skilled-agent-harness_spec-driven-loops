dding refresh\n159:// command can be embedded yet, never a failed skill refresh.\n208:function isWalFallbackError(error: unknown): boolean {\n303:export function resolveSkillGraphDbDir(baseRoot: string = process.cwd()): string {\n322:export function getSkillGraphDbPath(): string {\n337:export function isGenuineCorruptionReason(reason: string): boolean {\n348:function recoverMalformedDatabase(databasePath: string, reason: string): void {\n362:function ensureSchemaMigrations(database: Database.Database): void {\n412:  // a family accepted in code still fails the stale CHECK and aborts the entire scan\n463:  // above: a new edge type added to the app-level EDGE_TYPES gate still fails the stale SQL\n501:export function initDb(dbDir: string): Database.Database {\n547:export function getDb(): Database.Database {\n563:export function probeStatusIntegrity(): { ok: true } | { ok: false; reason: string } | null {\n577:export function getDbReadOnly(): Database.Database | null {\n599:export function closeDb(): void {\n617:function getMetadata(key: string): string | null {\n623:function setMetadata(key: string, value: string): void {\n633:function checkpointWal(database: Database.Database): void {\n644:export function getLastScanTimestamp(): string | null {\n652:function isRecord(value: unknown): value is JsonRecord {\n656:function toDisplayPath(filePath: string): string {\n661:function requireString(value: unknown, fieldName: string, sourcePath: string): string {\n668:function requireStringArray(value: unknown, fieldName: string, sourcePath: string): string[] {\n675:function requireDerived(value: unknown, schemaVersion: number, sourcePath: string): JsonRecord | null {\n687:function requireEdgeWeight(value: unknown, edgeType: SkillEdgeType, sourcePath: string): number {\n701:function warnWeightBand(edge: SkillEdge, sourcePath: string, warnings: string[]): void {\n713:function computeContentHash(content: string): string {\n718:export function computeSkillMetadataContentHash(content: string): string {\n724:function encodeEmbedding(vector: Float32Array | readonly number[]): Buffer {\n729:function decodeEmbedding(blob: Buffer): Float32Array | null {\n737:function skillDescriptionForEmbedding(sourcePath: string): string {\n747: * Read the generated command-bridge projection into the texts the refresh embeds.\n751: * refresh, so every one of those cases reads as \"no commands to embed\".\n753:export function readCommandEmbeddingSources(): CommandEmbeddingSource[] | null {\n782:    if (!isRecord(entry) || typeof entry.embeddingText !== 'string') {\n785:    const embeddingText = entry.embeddingText.trim();\n786:    if (!embeddingText) {\n808:    sources.push({ commandId, embeddingText });\n814:export function providerModelId(profile: { provider: string; model: string; dim: number; dtype?: string | null; slug?: string }): string {\n820:function discoverGraphMetadataFiles(skillDir: string): string[] {\n857:function readMetadataJson(sourcePath: string, content: string): JsonRecord {\n873:function isSkillGraphMetadata(parsedJson: JsonRecord): boolean {\n877:function parseSkillMetadata(sourcePath: string, parsedJson: JsonRecord, contentHash: string): ParsedSkillMetadata {\n945:      contentHash,\n951:function deleteMissingNodes(database: Database.Database, skillIds: string[]): number {\n970:function harvestSkillDocs(\n1023:        const contentHash = computeContentHash(raw);\n1025:        if (existing && existing.content_hash === contentHash) {\n1038:          contentHash,\n1070: * cleanup removes stale edges, even when neighboring source files are skipped.\n1072:export function indexSkillMetadata(skillDir: string): SkillGraphIndexResult {\n1089:    const contentHash = computeSkillMetadataContentHash(content);\n1090:    parsedMetadata.push(parseSkillMetadata(sourcePath, parsedJson, contentHash));\n1201:        existing.content_hash === entry.node.contentHash &&\n1217:        entry.node.contentHash,\n1308: * stale-but-harmless. A separate \"legacy embedding column deprecation\" packet\n1311:export async function refreshSkillEmbeddings(skillDir?: string): Promise<SkillEmbeddingRefreshResult> {\n1315:    return refreshSkillEmbeddingsViaAdapter(database, skillDir);\n1318:  return refreshSkillEmbeddingsLegacy(database, skillDir);\n1325:async function refreshSkillEmbeddingsViaAdapter(\n1339:      // Report every skill node as failed so refresh-watchers see an outage\n1356:    const warning = `ADAPTER-DIM-MISMATCH: ${active.name} reports dim=${adapter.dim} but vec_metadata pointer dim=${active.dim}; fix configuration before refresh`;\n1413:    const contentHash = computeContentHash(description);\n1417:      && row.vec_content_hash === contentHash\n1437:      upsertEmbedding.run(row.id, encodeEmbedding(vector), modelId, contentHash);\n1452:          + ' failed and retried on the next refresh';\n1461:  // the returned totals, which report the skill corpus this refresh exists for.\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"cd /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research && F=.skilled/skills/system-skill-advisor/runtime/lib/skill-graph/skill-graph-db.ts && grep -n \\\"contentHash\\\\|embeddingText\\\\|stale\\\\|refresh\\\\|sources.push\\\\|function \\\" $F | sed -n '1,70p'\"}"},"time":{"start":1794550820787,"end":1794550821189}}}}
{"type":"step_finish","timestamp":1794550823504,"sessionID":"ses_e2c799d85ffebLHFzdZg0KLfFI","part":{"id":"prt_1d3907a50001t91l76vNznyGgu","sessionID":"ses_e2c799d85ffebLHFzdZg0KLfFI","messageID":"msg_1d39066c8001hzeksME3zpx7Ck","type":"step-finish","reason":"tool-calls","snapshot":"d614d49398394122d9f7fab6b60ae95ec0365b71","cost":0,"tokens":{"input":1020,"output":121,"reasoning":0,"cache":{"read":137984,"write":0}}}}
{"type":"step_start","timestamp":1794550825849,"sessionID":"ses_e2c799d85ffebLHFzdZg0KLfFI","part":{"id":"prt_1d3908379001Ho4C6mTWbEXwI0","sessionID":"ses_e2c799d85ffebLHFzdZg0KLfFI","messageID":"msg_1d3907a58001X2lubwdtG6jb6O","type":"step-start","snapshot":"d614d49398394122d9f7fab6b60ae95ec0365b71"}}
{"type":"tool_use","timestamp":1794550828130,"sessionID":"ses_e2c799d85ffebLHFzdZg0KLfFI","part":{"partID":"prt_1d39088cb002cMV6trlcr37QX5","sessionID":"ses_e2c799d85ffebLHFzdZg0KLfFI","messageID":"msg_1d3907a58001X2lubwdtG6jb6O","type":"tool","id":"call_ef8083f8844945b9b7dd42ad","tool":"shell","state":{"status":"completed","input":{"command":"cd /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research && F=.skilled/skills/system-skill-advisor/runtime/lib/skill-graph/skill-graph-db.ts && sed -n '713,760p' $F && echo \"=== refresh\" && sed -n '1311,1345p' $F && sed -n '1400,1460p' $F && echo \"=== db dir\" && sed -n '303,340p' $F"},"output":"function computeContentHash(content: string): string {\n  return createHash('sha256').update(content).digest('hex');\n}\n\n/** Keep indexed metadata hashes aligned with the sanitizer policy version. */\nexport function computeSkillMetadataContentHash(content: string): string {\n  return createHash('sha256')\n    .update(`${SKILL_METADATA_SANITIZER_VERSION}\\n${content}`)\n    .digest('hex');\n}\n\nfunction encodeEmbedding(vector: Float32Array | readonly number[]): Buffer {\n  const array = vector instanceof Float32Array ? vector : Float32Array.from(vector);\n  return Buffer.from(array.buffer, array.byteOffset, array.byteLength);\n}\n\nfunction decodeEmbedding(blob: Buffer): Float32Array | null {\n  if (blob.byteLength === 0 || blob.byteLength % Float32Array.BYTES_PER_ELEMENT !== 0) {\n    return null;\n  }\n  const copied = blob.buffer.slice(blob.byteOffset, blob.byteOffset + blob.byteLength);\n  return new Float32Array(copied);\n}\n\nfunction skillDescriptionForEmbedding(sourcePath: string): string {\n  const skillMdPath = join(dirname(sourcePath), 'SKILL.md');\n  if (!existsSync(skillMdPath)) {\n    return '';\n  }\n  const parsed = parseSkillFrontmatter(readFileSync(skillMdPath, 'utf8'));\n  return parsed.frontmatter.description || '';\n}\n\n/**\n * Read the generated command-bridge projection into the texts the refresh embeds.\n *\n * Returns null when the projection is absent, unparsable or shaped differently\n * than expected. A regenerated artifact must never be able to fail a skill\n * refresh, so every one of those cases reads as \"no commands to embed\".\n */\nexport function readCommandEmbeddingSources(): CommandEmbeddingSource[] | null {\n  const filePath = COMMAND_BRIDGES_DIR_CANDIDATES\n    .map((dir) => join(dir, COMMAND_BRIDGES_FILENAME))\n    .find((candidate) => existsSync(candidate));\n  if (!filePath) {\n    return null;\n  }\n\n=== refresh\nexport async function refreshSkillEmbeddings(skillDir?: string): Promise<SkillEmbeddingRefreshResult> {\n  const database = getDb();\n\n  if (hasActiveEmbedderPointer(database)) {\n    return refreshSkillEmbeddingsViaAdapter(database, skillDir);\n  }\n\n  return refreshSkillEmbeddingsLegacy(database, skillDir);\n}\n\n// A dead or wedged embedding backend fails every row for the same reason, so a\n// per-row retry buys nothing and costs one full request deadline each time.\nconst EMBEDDING_BACKEND_OUTAGE_STREAK = 3;\n\nasync function refreshSkillEmbeddingsViaAdapter(\n  database: Database.Database,\n  skillDir: string | undefined,\n): Promise<SkillEmbeddingRefreshResult> {\n  const active = getActiveEmbedder(database);\n  ensureVecTableForDim(database, active.dim);\n  ensureCommandVecTableForDim(database, active.dim);\n  const tableName = vecTableNameForDim(active.dim);\n  let adapter: EmbedderAdapter;\n  try {\n    const resolved = getAdapter(active.name);\n    if (!resolved) {\n      const warning = `ADAPTER-UNAVAILABLE: ${active.name} (manifest not found in registry)`;\n      console.warn(`[skill-graph] ${warning}`);\n      // Report every skill node as failed so refresh-watchers see an outage\n      // signal instead of an empty-corpus-looking zero count.\n      const rowCount = (database.prepare('SELECT COUNT(*) AS c FROM skill_nodes').get() as { c: number }).c;\n      return { embedded: 0, skipped: 0, failed: rowCount, warnings: [warning] };\n    }\n    adapter = resolved;\n  } catch (error: unknown) {\n  for (const row of rows) {\n    if (skillDir && !row.source_path.startsWith(skillDir)) {\n      skipped++;\n      continue;\n    }\n\n    const description = skillDescriptionForEmbedding(row.source_path).trim();\n    if (!description) {\n      deleteEmbedding.run(row.id);\n      skipped++;\n      continue;\n    }\n\n    const contentHash = computeContentHash(description);\n    if (\n      row.vec_embedding\n      && row.vec_model_id === modelId\n      && row.vec_content_hash === contentHash\n    ) {\n      skipped++;\n      continue;\n    }\n\n    // A current row never needed the backend, so an outage leaves it alone. A row\n    // that did need it is written exactly as a failed ask would write it.\n    if (backendOutage !== null) {\n      failed++;\n      deleteEmbedding.run(row.id);\n      continue;\n    }\n\n    try {\n      const vectors = await adapter.embed([description], { inputType: 'document' });\n      const vector = vectors[0];\n      if (!vector || vector.length !== active.dim) {\n        throw new Error(`adapter returned vector of length ${vector?.length ?? 0}, expected ${active.dim}`);\n      }\n      upsertEmbedding.run(row.id, encodeEmbedding(vector), modelId, contentHash);\n      embedded++;\n      consecutiveFailures = 0;\n    } catch (error: unknown) {\n      failed++;\n      consecutiveFailures++;\n      deleteEmbedding.run(row.id);\n      const message = error instanceof Error ? error.message : String(error);\n      const warning = `EMBEDDING-FAILED: ${row.id} (${message})`;\n      warnings.push(warning);\n      console.warn(`[skill-graph] ${warning}`);\n      if (consecutiveFailures >= EMBEDDING_BACKEND_OUTAGE_STREAK) {\n        backendOutage = message;\n        const outageWarning = `EMBEDDING-BACKEND-OUTAGE: stopped after ${consecutiveFailures}`\n          + ` consecutive failures (${message}); the remaining skills are counted as`\n          + ' failed and retried on the next refresh';\n        warnings.push(outageWarning);\n        console.warn(`[skill-graph] ${outageWarning}`);\n      }\n    }\n  }\n\n  // Commands share the skill vector space, so a backend the skill loop has\n  // already proved dead is not asked again for them. Their counts stay out of\n=== db dir\nexport function resolveSkillGraphDbDir(baseRoot: string = process.cwd()): string {\n  const overrideDbDir = process.env.SYSTEM_SKILL_ADVISOR_DB_DIR;\n  if (overrideDbDir) {\n    return resolve(overrideDbDir);\n  }\n  // Anchor to the real repo root. A default `process.cwd()` inside a\n  // specs/<packet> directory would otherwise plant the skill-graph database\n  // under that packet; the anchored resolver can never land inside an .skilled\n  // tree, so the DB always resolves to one file at the workspace root.\n  return resolve(\n    findAdvisorWorkspaceRoot(baseRoot),\n    '.skilled',\n    'skills',\n    'system-skill-advisor',\n    'runtime',\n    'database',\n  );\n}\n\nexport function getSkillGraphDbPath(): string {\n  return dbPath ?? join(resolveSkillGraphDbDir(), DB_FILENAME);\n}\n\nconst CORRUPTION_REASON_PATTERN = /SQLITE_CORRUPT|SQLITE_NOTADB|database disk image is malformed|file is not a database|malformed/i;\nconst TRANSIENT_REASON_PATTERN = /database is locked|SQLITE_BUSY|SQLITE_LOCKED|SQLITE_PROTOCOL|EIO|EPERM|EACCES|EROFS|ENOSPC/i;\n\n/**\n * Only genuine on-disk corruption may trigger destructive recovery.\n *\n * Transient conditions (lock contention from a concurrent daemon, I/O or\n * permission errors) must never rename/delete the live database out from\n * under its owner, so they fail this check and initDb proceeds to a normal\n * open (busy_timeout handles contention).\n */\nexport function isGenuineCorruptionReason(reason: string): boolean {\n  if (reason.startsWith('SQLITE_CHECK_FAILED') || TRANSIENT_REASON_PATTERN.test(reason)) {\n    return false;\n  }\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"function computeContentHash(content: string): string {\n  return createHash('sha256').update(content).digest('hex');\n}\n\n/** Keep indexed metadata hashes aligned with the sanitizer policy version. */\nexport function computeSkillMetadataContentHash(content: string): string {\n  return createHash('sha256')\n    .update(`${SKILL_METADATA_SANITIZER_VERSION}\\n${content}`)\n    .digest('hex');\n}\n\nfunction encodeEmbedding(vector: Float32Array | readonly number[]): Buffer {\n  const array = vector instanceof Float32Array ? vector : Float32Array.from(vector);\n  return Buffer.from(array.buffer, array.byteOffset, array.byteLength);\n}\n\nfunction decodeEmbedding(blob: Buffer): Float32Array | null {\n  if (blob.byteLength === 0 || blob.byteLength % Float32Array.BYTES_PER_ELEMENT !== 0) {\n    return null;\n  }\n  const copied = blob.buffer.slice(blob.byteOffset, blob.byteOffset + blob.byteLength);\n  return new Float32Array(copied);\n}\n\nfunction skillDescriptionForEmbedding(sourcePath: string): string {\n  const skillMdPath = join(dirname(sourcePath), 'SKILL.md');\n  if (!existsSync(skillMdPath)) {\n    return '';\n  }\n  const parsed = parseSkillFrontmatter(readFileSync(skillMdPath, 'utf8'));\n  return parsed.frontmatter.description || '';\n}\n\n/**\n * Read the generated command-bridge projection into the texts the refresh embeds.\n *\n * Returns null when the projection is absent, unparsable or shaped differently\n * than expected. A regenerated artifact must never be able to fail a skill\n * refresh, so every one of those cases reads as \"no commands to embed\".\n */\nexport function readCommandEmbeddingSources(): CommandEmbeddingSource[] | null {\n  const filePath = COMMAND_BRIDGES_DIR_CANDIDATES\n    .map((dir) => join(dir, COMMAND_BRIDGES_FILENAME))\n    .find((candidate) => existsSync(candidate));\n  if (!filePath) {\n    return null;\n  }\n\n=== refresh\nexport async function refreshSkillEmbeddings(skillDir?: string): Promise<SkillEmbeddingRefreshResult> {\n  const database = getDb();\n\n  if (hasActiveEmbedderPointer(database)) {\n    return refreshSkillEmbeddingsViaAdapter(database, skillDir);\n  }\n\n  return refreshSkillEmbeddingsLegacy(database, skillDir);\n}\n\n// A dead or wedged embedding backend fails every row for the same reason, so a\n// per-row retry buys nothing and costs one full request deadline each time.\nconst EMBEDDING_BACKEND_OUTAGE_STREAK = 3;\n\nasync function refreshSkillEmbeddingsViaAdapter(\n  database: Database.Database,\n  skillDir: string | undefined,\n): Promise<SkillEmbeddingRefreshResult> {\n  const active = getActiveEmbedder(database);\n  ensureVecTableForDim(database, active.dim);\n  ensureCommandVecTableForDim(database, active.dim);\n  const tableName = vecTableNameForDim(active.dim);\n  let adapter: EmbedderAdapter;\n  try {\n    const resolved = getAdapter(active.name);\n    if (!resolved) {\n      const warning = `ADAPTER-UNAVAILABLE: ${active.name} (manifest not found in registry)`;\n      console.warn(`[skill-graph] ${warning}`);\n      // Report every skill node as failed so refresh-watchers see an outage\n      // signal instead of an empty-corpus-looking zero count.\n      const rowCount = (database.prepare('SELECT COUNT(*) AS c FROM skill_nodes').get() as { c: number }).c;\n      return { embedded: 0, skipped: 0, failed: rowCount, warnings: [warning] };\n    }\n    adapter = resolved;\n  } catch (error: unknown) {\n  for (const row of rows) {\n    if (skillDir && !row.source_path.startsWith(skillDir)) {\n      skipped++;\n      continue;\n    }\n\n    const description = skillDescriptionForEmbedding(row.source_path).trim();\n    if (!description) {\n      deleteEmbedding.run(row.id);\n      skipped++;\n      continue;\n    }\n\n    const contentHash = computeContentHash(description);\n    if (\n      row.vec_embedding\n      && row.vec_model_id === modelId\n      && row.vec_content_hash === contentHash\n    ) {\n      skipped++;\n      continue;\n    }\n\n    // A current row never needed the backend, so an outage leaves it alone. A row\n    // that did need it is written exactly as a failed ask would write it.\n    if (backendOutage !== null) {\n      failed++;\n      deleteEmbedding.run(row.id);\n      continue;\n    }\n\n    try {\n      const vectors = await adapter.embed([description], { inputType: 'document' });\n      const vector = vectors[0];\n      if (!vector || vector.length !== active.dim) {\n        throw new Error(`adapter returned vector of length ${vector?.length ?? 0}, expected ${active.dim}`);\n      }\n      upsertEmbedding.run(row.id, encodeEmbedding(vector), modelId, contentHash);\n      embedded++;\n      consecutiveFailures = 0;\n    } catch (error: unknown) {\n      failed++;\n      consecutiveFailures++;\n      deleteEmbedding.run(row.id);\n      const message = error instanceof Error ? error.message : String(error);\n      const warning = `EMBEDDING-FAILED: ${row.id} (${message})`;\n      warnings.push(warning);\n      console.warn(`[skill-graph] ${warning}`);\n      if (consecutiveFailures >= EMBEDDING_BACKEND_OUTAGE_STREAK) {\n        backendOutage = message;\n        const outageWarning = `EMBEDDING-BACKEND-OUTAGE: stopped after ${consecutiveFailures}`\n          + ` consecutive failures (${message}); the remaining skills are counted as`\n          + ' failed and retried on the next refresh';\n        warnings.push(outageWarning);\n        console.warn(`[skill-graph] ${outageWarning}`);\n      }\n    }\n  }\n\n  // Commands share the skill vector space, so a backend the skill loop has\n  // already proved dead is not asked again for them. Their counts stay out of\n=== db dir\nexport function resolveSkillGraphDbDir(baseRoot: string = process.cwd()): string {\n  const overrideDbDir = process.env.SYSTEM_SKILL_ADVISOR_DB_DIR;\n  if (overrideDbDir) {\n    return resolve(overrideDbDir);\n  }\n  // Anchor to the real repo root. A default `process.cwd()` inside a\n  // specs/<packet> directory would otherwise plant the skill-graph database\n  // under that packet; the anchored resolver can never land inside an .skilled\n  // tree, so the DB always resolves to one file at the workspace root.\n  return resolve(\n    findAdvisorWorkspaceRoot(baseRoot),\n    '.skilled',\n    'skills',\n    'system-skill-advisor',\n    'runtime',\n    'database',\n  );\n}\n\nexport function getSkillGraphDbPath(): string {\n  return dbPath ?? join(resolveSkillGraphDbDir(), DB_FILENAME);\n}\n\nconst CORRUPTION_REASON_PATTERN = /SQLITE_CORRUPT|SQLITE_NOTADB|database disk image is malformed|file is not a database|malformed/i;\nconst TRANSIENT_REASON_PATTERN = /database is locked|SQLITE_BUSY|SQLITE_LOCKED|SQLITE_PROTOCOL|EIO|EPERM|EACCES|EROFS|ENOSPC/i;\n\n/**\n * Only genuine on-disk corruption may trigger destructive recovery.\n *\n * Transient conditions (lock contention from a concurrent daemon, I/O or\n * permission errors) must never rename/delete the live database out from\n * under its owner, so they fail this check and initDb proceeds to a normal\n * open (busy_timeout handles contention).\n */\nexport function isGenuineCorruptionReason(reason: string): boolean {\n  if (reason.startsWith('SQLITE_CHECK_FAILED') || TRANSIENT_REASON_PATTERN.test(reason)) {\n    return false;\n  }\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"cd /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research && F=.skilled/skills/system-skill-advisor/runtime/lib/skill-graph/skill-graph-db.ts && sed -n '713,760p' $F && echo \\\"=== refresh\\\" && sed -n '1311,1345p' $F && sed -n '1400,1460p' $F && echo \\\"=== db dir\\\" && sed -n '303,340p' $F\"}"},"time":{"start":1794550827211,"end":1794550828130}}}}
