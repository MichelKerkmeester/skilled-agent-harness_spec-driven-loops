\n              \"workflowMode\": \"sk-create-goal\"\n            }\n          ],\n          \"effectivePolicyHash\": \"c0ef88b811d75969ee726921ac8797265388fe009069d3af3fae5647da09298d\",\n          \"generation\": 5\n        },\n        \"command\": \"/create:goal\",\n        \"kind\": \"skill\",\n        \"policy\": \"start\"\n      },\n      {\n        \"skillId\": \"system-spec-kit\",\n        \"score\": 0.660169,\n        \"confidence\": 0.8748,\n        \"uncertainty\": 0.12,\n        \"dominantLane\": \"lexical\",\n        \"status\": \"active\",\n        \"kind\": \"skill\"\n      },\n      {\n        \"skillId\": \"sk-code\",\n        \"score\": 0.214995,\n        \"confidence\": 0.82,\n        \"uncertainty\": 0.22,\n        \"dominantLane\": \"lexical\",\n        \"status\": \"active\",\n        \"compiledRoute\": {\n          \"hubId\": \"sk-code\",\n          \"action\": \"defer\",\n          \"selectionKind\": null,\n          \"targets\": [],\n          \"effectivePolicyHash\": \"7467db9aaf0acc44e6a36dc3ab206c0b8a42a58f08ec02cf000115b23a774f1f\",\n          \"generation\": 2\nnode .skilled/bin/skill-advisor.cjs advisor_recommend --json  --format json 2  0.06s user 0.03s system 23% cpu 0.407 total\nhead -60  0.00s user 0.00s system 0% cpu 0.400 total\nEXIT=0\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"cd /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research && F=.skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/command-prompts.jsonl && P=$(jq -r 'select(.id==\\\"cmd-create-goal-plain-tune-01\\\") | .prompt' $F) && time node .skilled/bin/skill-advisor.cjs advisor_recommend --json \\\"$(jq -cn --arg p \\\"$P\\\" '{prompt:$p}')\\\" --format json 2>&1 | head -60; echo \\\"EXIT=$?\\\"\"}"},"time":{"start":1794550446082,"end":1794550447525}}}}
