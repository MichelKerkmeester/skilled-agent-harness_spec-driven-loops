{"type":"tool_use","timestamp":1794527425504,"sessionID":"ses_e2dd83265ffe1sA4o14G3RbaA3","part":{"partID":"prt_1d22b64c5001ApFIstV3eLluUS","sessionID":"ses_e2dd83265ffe1sA4o14G3RbaA3","messageID":"msg_1d22b137c001M0CaWj4T9T94JU","type":"tool","id":"call_d3e18d03d8f6476d9754c856","tool":"write","state":{"status":"completed","input":{"path":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/tests/command-offer.vitest.ts","content":"// ───────────────────────────────────────────────────────────────\n// MODULE: Command offer\n// ───────────────────────────────────────────────────────────────\n\n// The head is the only advisor text that names both the offered command and the\n// policy, so these cases pin each shape a live head takes, a command with a\n// policy, a command under an ambiguous head without one, and a head that names\n// no command at all. The replay case proves a checkout without the prompt hook\n// reports the miss, because a backfill off such a checkout has to stay readable\n// instead of throwing away the lines around it.\n\nimport { mkdtempSync, rmSync } from 'node:fs';\nimport { tmpdir } from 'node:os';\nimport { join } from 'node:path';\n\nimport { describe, expect, it } from 'vitest';\n\nimport { parseOffer, replayOffer } from '../scripts/routing-accuracy/command-offer.mjs';\n\nconst OFFERED_HEAD = 'Advisor: live; use sk-git → /doctor:git hooks (ask) 0.82/0.12 pass.';\nconst AMBIGUOUS_HEAD = 'Advisor: live; ambiguous: /doctor:git hooks 0.82/0.12 vs sk-git 0.86/0.16 pass.';\nconst NO_COMMAND_HEAD = 'Advisor: live; use command-spec-kit-plan 0.82/0.16 pass.';\n\ndescribe('parseOffer', () => {\n  it('reads the command and the policy a head offers', () => {\n    expect(parseOffer(OFFERED_HEAD)).toEqual({\n      offeredCommand: '/doctor:git hooks',\n      offeredPolicy: 'ask',\n    });\n  });\n\n  it('reads the command but no policy under an ambiguous head', () => {\n    expect(parseOffer(AMBIGUOUS_HEAD)).toEqual({\n      offeredCommand: '/doctor:git hooks',\n      offeredPolicy: null,\n    });\n  });\n\n  it('reads no command when the head names none', () => {\n    expect(parseOffer(NO_COMMAND_HEAD)).toEqual({\n      offeredCommand: null,\n      offeredPolicy: null,\n    });\n  });\n});\n\ndescribe('replayOffer', () => {\n  it('reports a checkout without the prompt hook instead of throwing', () => {\n    const checkoutDir = mkdtempSync(join(tmpdir(), 'command-offer-'));\n    try {\n      expect(replayOffer({ checkoutDir, prompt: 'create a readme', sessionId: 'offer-test' })).toEqual({\n        offeredCommand: null,\n        offeredPolicy: null,\n        offerError: 'hook_missing',\n      });\n    } finally {\n      rmSync(checkoutDir, { recursive: true, force: true });\n    }\n  });\n});\n"},"output":"Created file successfully: .skilled/skills/system-skill-advisor/runtime/tests/command-offer.vitest.ts","title":"write","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Created file successfully: .skilled/skills/system-skill-advisor/runtime/tests/command-offer.vitest.ts"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/tests/command-offer.vitest.ts\",\"content\":\"// ───────────────────────────────────────────────────────────────\\n// MODULE: Command offer\\n// ───────────────────────────────────────────────────────────────\\n\\n// The head is the only advisor text that names both the offered command and the\\n// policy, so these cases pin each shape a live head takes, a command with a\\n// policy, a command under an ambiguous head without one, and a head that names\\n// no command at all. The replay case proves a checkout without the prompt hook\\n// reports the miss, because a backfill off such a checkout has to stay readable\\n// instead of throwing away the lines around it.\\n\\nimport { mkdtempSync, rmSync } from 'node:fs';\\nimport { tmpdir } from 'node:os';\\nimport { join } from 'node:path';\\n\\nimport { describe, expect, it } from 'vitest';\\n\\nimport { parseOffer, replayOffer } from '../scripts/routing-accuracy/command-offer.mjs';\\n\\nconst OFFERED_HEAD = 'Advisor: live; use sk-git → /doctor:git hooks (ask) 0.82/0.12 pass.';\\nconst AMBIGUOUS_HEAD = 'Advisor: live; ambiguous: /doctor:git hooks 0.82/0.12 vs sk-git 0.86/0.16 pass.';\\nconst NO_COMMAND_HEAD = 'Advisor: live; use command-spec-kit-plan 0.82/0.16 pass.';\\n\\ndescribe('parseOffer', () => {\\n  it('reads the command and the policy a head offers', () => {\\n    expect(parseOffer(OFFERED_HEAD)).toEqual({\\n      offeredCommand: '/doctor:git hooks',\\n      offeredPolicy: 'ask',\\n    });\\n  });\\n\\n  it('reads the command but no policy under an ambiguous head', () => {\\n    expect(parseOffer(AMBIGUOUS_HEAD)).toEqual({\\n      offeredCommand: '/doctor:git hooks',\\n      offeredPolicy: null,\\n    });\\n  });\\n\\n  it('reads no command when the head names none', () => {\\n    expect(parseOffer(NO_COMMAND_HEAD)).toEqual({\\n      offeredCommand: null,\\n      offeredPolicy: null,\\n    });\\n  });\\n});\\n\\ndescribe('replayOffer', () => {\\n  it('reports a checkout without the prompt hook instead of throwing', () => {\\n    const checkoutDir = mkdtempSync(join(tmpdir(), 'command-offer-'));\\n    try {\\n      expect(replayOffer({ checkoutDir, prompt: 'create a readme', sessionId: 'offer-test' })).toEqual({\\n        offeredCommand: null,\\n        offeredPolicy: null,\\n        offerError: 'hook_missing',\\n      });\\n    } finally {\\n      rmSync(checkoutDir, { recursive: true, force: true });\\n    }\\n  });\\n});\\n\"}"},"time":{"start":1794527421637,"end":1794527425504}}}}
{"type":"tool_use","timestamp":1794527425581,"sessionID":"ses_e2dd83265ffe1sA4o14G3RbaA3","part":{"partID":"prt_1d22b4b45001L1SFrUtBjl2Mnz","sessionID":"ses_e2dd83265ffe1sA4o14G3RbaA3","messageID":"msg_1d22b137c001M0CaWj4T9T94JU","type":"tool","id":"call_b9eea93e9a384927b531b05e","tool":"write","state":{"status":"completed","input":{"path":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/command-offer.mjs","content":"// ───────────────────────────────────────────────────────────────\n// MODULE: Command offer from an advisor head\n// ───────────────────────────────────────────────────────────────\n//\n// A run line records which command the advisor offered and the policy it named,\n// so a start rate can be read as \"did the reader follow the offer\" rather than\n// only \"did a command run\". The offer is recovered by replaying the Claude\n// prompt hook after the turn, because the head is the only text that names both\n// the command and the policy, and a replay keeps the recorded value independent\n// of whatever the session reader happened to retain.\n//\n// A failed replay returns null fields plus an offerError, so a backfill over a\n// checkout without the hook, or a hook that crashes, still produces a readable\n// line instead of aborting the run.\n\nimport { spawnSync } from 'node:child_process';\nimport { existsSync } from 'node:fs';\nimport { join } from 'node:path';\n\nconst HOOK_RELATIVE = '.skilled/skills/system-spec-kit/runtime/dist/hooks/claude/user-prompt-submit.js';\nconst OFFER_PATTERN = /\\/[a-z][a-z-]*:[a-z][a-z-]*(?: [a-z][a-z-]*)?/;\nconst POLICY_PATTERN = /^ *(?:\\((run|start|ask)\\))/;\nconst DEFAULT_TIMEOUT_MS = 30_000;\nconst MAX_OUTPUT_BYTES = 1024 * 1024;\n\nfunction failedOffer(offerError) {\n  return { offeredCommand: null, offeredPolicy: null, offerError };\n}\n\n/**\n * Read the command and the policy out of the first line of a head.\n *\n * The policy only counts when it directly follows the command, so a `(ask)`\n * that belongs to a later clause cannot attach itself to an earlier match.\n *\n * @param {string} head - One line of advisor output.\n * @returns {{ offeredCommand: string | null, offeredPolicy: string | null }}\n */\nexport function parseOffer(head) {\n  const text = typeof head === 'string' ? head : '';\n  const match = text.match(OFFER_PATTERN);\n  if (!match) {\n    return { offeredCommand: null, offeredPolicy: null };\n  }\n  const policy = text.slice(match.index + match[0].length).match(POLICY_PATTERN);\n  return {\n    offeredCommand: match[0],\n    offeredPolicy: policy ? policy[1] : null,\n  };\n}\n\n/**\n * Replay the Claude prompt hook for one prompt and parse the offer it prints.\n *\n * The hook is resolved from the checkout rather than from this module, so a\n * backfill records what that checkout's advisor would have offered at the time\n * of the run, not what the current working copy happens to say.\n *\n * @param {object} options\n * @param {string} options.checkoutDir - Root of the checkout whose hook runs.\n * @param {string} options.prompt - The prompt to replay.\n * @param {string} options.sessionId - Session id for the hook payload.\n * @param {number} [options.timeoutMs] - Hook timeout before the replay fails.\n * @returns {{ offeredCommand: string | null, offeredPolicy: string | null, offerError: string | null }}\n */\nexport function replayOffer({ checkoutDir, prompt, sessionId, timeoutMs = DEFAULT_TIMEOUT_MS }) {\n  const hookPath = join(checkoutDir, HOOK_RELATIVE);\n  if (!existsSync(hookPath)) {\n    return failedOffer('hook_missing');\n  }\n\n  const payload = {\n    prompt,\n    cwd: checkoutDir,\n    hook_event_name: 'UserPromptSubmit',\n    session_id: sessionId,\n  };\n\n  let result;\n  try {\n    result = spawnSync('node', [hookPath], {\n      cwd: checkoutDir,\n      input: JSON.stringify(payload),\n      encoding: 'utf8',\n      timeout: timeoutMs,\n      maxBuffer: MAX_OUTPUT_BYTES,\n    });\n  } catch {\n    return failedOffer('hook_failed');\n  }\n\n  if (result.error || result.status !== 0 || typeof result.stdout !== 'string') {\n    return failedOffer('hook_failed');\n  }\n\n  let output;\n  try {\n    output = JSON.parse(result.stdout);\n  } catch {\n    return failedOffer('hook_failed');\n  }\n\n  const context = output?.hookSpecificOutput?.additionalContext;\n  if (typeof context !== 'string') {\n    return failedOffer('no_head');\n  }\n\n  const [firstLine = ''] = context.split(/\\r?\\n/);\n  if (!firstLine.trim()) {\n    return failedOffer('no_head');\n  }\n\n  return { ...parseOffer(firstLine), offerError: null };\n}\n"},"output":"Created file successfully: .skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/command-offer.mjs","title":"write","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Created file successfully: .skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/command-offer.mjs"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/command-offer.mjs\",\"content\":\"// ───────────────────────────────────────────────────────────────\\n// MODULE: Command offer from an advisor head\\n// ───────────────────────────────────────────────────────────────\\n//\\n// A run line records which command the advisor offered and the policy it named,\\n// so a start rate can be read as \\\"did the reader follow the offer\\\" rather than\\n// only \\\"did a command run\\\". The offer is recovered by replaying the Claude\\n// prompt hook after the turn, because the head is the only text that names both\\n// the command and the policy, and a replay keeps the recorded value independent\\n// of whatever the session reader happened to retain.\\n//\\n// A failed replay returns null fields plus an offerError, so a backfill over a\\n// checkout without the hook, or a hook that crashes, still produces a readable\\n// line instead of aborting the run.\\n\\nimport { spawnSync } from 'node:child_process';\\nimport { existsSync } from 'node:fs';\\nimport { join } from 'node:path';\\n\\nconst HOOK_RELATIVE = '.skilled/skills/system-spec-kit/runtime/dist/hooks/claude/user-prompt-submit.js';\\nconst OFFER_PATTERN = /\\\\/[a-z][a-z-]*:[a-z][a-z-]*(?: [a-z][a-z-]*)?/;\\nconst POLICY_PATTERN = /^ *(?:\\\\((run|start|ask)\\\\))/;\\nconst DEFAULT_TIMEOUT_MS = 30_000;\\nconst MAX_OUTPUT_BYTES = 1024 * 1024;\\n\\nfunction failedOffer(offerError) {\\n  return { offeredCommand: null, offeredPolicy: null, offerError };\\n}\\n\\n/**\\n * Read the command and the policy out of the first line of a head.\\n *\\n * The policy only counts when it directly follows the command, so a `(ask)`\\n * that belongs to a later clause cannot attach itself to an earlier match.\\n *\\n * @param {string} head - One line of advisor output.\\n * @returns {{ offeredCommand: string | null, offeredPolicy: string | null }}\\n */\\nexport function parseOffer(head) {\\n  const text = typeof head === 'string' ? head : '';\\n  const match = text.match(OFFER_PATTERN);\\n  if (!match) {\\n    return { offeredCommand: null, offeredPolicy: null };\\n  }\\n  const policy = text.slice(match.index + match[0].length).match(POLICY_PATTERN);\\n  return {\\n    offeredCommand: match[0],\\n    offeredPolicy: policy ? policy[1] : null,\\n  };\\n}\\n\\n/**\\n * Replay the Claude prompt hook for one prompt and parse the offer it prints.\\n *\\n * The hook is resolved from the checkout rather than from this module, so a\\n * backfill records what that checkout's advisor would have offered at the time\\n * of the run, not what the current working copy happens to say.\\n *\\n * @param {object} options\\n * @param {string} options.checkoutDir - Root of the checkout whose hook runs.\\n * @param {string} options.prompt - The prompt to replay.\\n * @param {string} options.sessionId - Session id for the hook payload.\\n * @param {number} [options.timeoutMs] - Hook timeout before the replay fails.\\n * @returns {{ offeredCommand: string | null, offeredPolicy: string | null, offerError: string | null }}\\n */\\nexport function replayOffer({ checkoutDir, prompt, sessionId, timeoutMs = DEFAULT_TIMEOUT_MS }) {\\n  const hookPath = join(checkoutDir, HOOK_RELATIVE);\\n  if (!existsSync(hookPath)) {\\n    return failedOffer('hook_missing');\\n  }\\n\\n  const payload = {\\n    prompt,\\n    cwd: checkoutDir,\\n    hook_event_name: 'UserPromptSubmit',\\n    session_id: sessionId,\\n  };\\n\\n  let result;\\n  try {\\n    result = spawnSync('node', [hookPath], {\\n      cwd: checkoutDir,\\n      input: JSON.stringify(payload),\\n      encoding: 'utf8',\\n      timeout: timeoutMs,\\n      maxBuffer: MAX_OUTPUT_BYTES,\\n    });\\n  } catch {\\n    return failedOffer('hook_failed');\\n  }\\n\\n  if (result.error || result.status !== 0 || typeof result.stdout !== 'string') {\\n    return failedOffer('hook_failed');\\n  }\\n\\n  let output;\\n  try {\\n    output = JSON.parse(result.stdout);\\n  } catch {\\n    return failedOffer('hook_failed');\\n  }\\n\\n  const context = output?.hookSpecificOutput?.additionalContext;\\n  if (typeof context !== 'string') {\\n    return failedOffer('no_head');\\n  }\\n\\n  const [firstLine = ''] = context.split(/\\\\r?\\\\n/);\\n  if (!firstLine.trim()) {\\n    return failedOffer('no_head');\\n  }\\n\\n  return { ...parseOffer(firstLine), offerError: null };\\n}\\n\"}"},"time":{"start":1794527415109,"end":1794527425581}}}}
