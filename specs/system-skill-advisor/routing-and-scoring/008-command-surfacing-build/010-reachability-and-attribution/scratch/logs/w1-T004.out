@  1 michelkerkmeester  staff   3325 Nov 12 10:24 launcher-idle-timeout.vitest.ts\n-rw-r--r--@  1 michelkerkmeester  staff   6974 Nov 12 10:24 launcher-install-guard.vitest.ts\n-rw-r--r--@  1 michelkerkmeester  staff  18715 Nov 12 10:24 launcher-lease.vitest.ts\n-rw-r--r--@  1 michelkerkmeester  staff   7153 Nov 12 10:24 launcher-model-server-default.vitest.ts\n-rw-r--r--@  1 michelkerkmeester  staff  10920 Nov 12 10:24 launcher-reap-pid-reuse.vitest.ts\n-rw-r--r--@  1 michelkerkmeester  staff   5036 Nov 12 10:24 launcher-stale-build-recycle.vitest.ts\ndrwxr-xr-x@ 16 michelkerkmeester  staff    512 Nov 12 21:10 legacy\n-rw-r--r--@  1 michelkerkmeester  staff  22143 Nov 12 10:24 lifecycle-derived-metadata.vitest.ts\n-rw-r--r--@  1 michelkerkmeester  staff   2685 Nov 12 21:10 manual-testing-playbook.vitest.ts\n-rw-r--r--@  1 michelkerkmeester  staff   2417 Nov 12 10:24 metadata-sanitizer-entities-guard.vitest.ts\n-rw-r--r--@  1 michelkerkmeester  staff   4156 Nov 12 10:24 metrics-file-permissions.vitest.ts\n-rw-r--r--@  1 michelkerkmeester  staff   9784 Nov 12 10:24 migration-lineage-identity.vitest.ts\n-rw-r--r--@  1 michelkerkmeester  staff   6216 Nov 12 10:24 name-mention-scoring.vitest.ts\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"ls -la .skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/ && ls -la .skilled/skills/system-skill-advisor/runtime/tests/ | head -50\",\"workdir\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research\"}"},"time":{"start":1794527281426,"end":1794527283478}}}}
