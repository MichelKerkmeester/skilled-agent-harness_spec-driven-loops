from the package here could load a second vitest\n23: // copy. defineConfig is an identity type-helper; dropping it changes nothing at\n24: // runtime.\n25: export default ({\n26:   root: import.meta.dirname,\n27:   test: {\n28:     include: [\n29:       ...(INCLUDE_STRESS ? ['stress-test/**/*.vitest.ts'] : ['tests/**/*.vitest.ts']),\n30:       ...(INCLUDE_BENCHES ? ['bench/**/*.bench.ts'] : []),\n31:     ],\n32:     exclude: [\n33:       'node_modules',\n34:       'dist',\n35:       ...(INCLUDE_BENCHES ? [] : ['bench/**/*.bench.ts']),\n36:     ],\n37:     setupFiles: [\n38:       path.resolve(import.meta.dirname, '../../system-spec-kit/runtime/tests/_support/vitest-setup.ts'),\n39:     ],\n40:     fileParallelism: false,\n41:     globals: true,\n42:     environment: 'node',\n43:     testTimeout: TEST_TIMEOUT_MS,\n44:     teardownTimeout: TEARDOWN_TIMEOUT_MS,\n45:     alias: {\n46:       '@lib': path.resolve(import.meta.dirname, 'lib'),\n47:     },\n48:   },\n49: });","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/vitest.config.ts, lines 1-49\n1: // ───────────────────────────────────────────────────────────────\n2: // MODULE: System Skill Advisor Vitest Config\n3: // ───────────────────────────────────────────────────────────────\n4: \n5: import path from 'node:path';\n6: \n7: const TEST_TIMEOUT_MS = 30_000;\n8: const TEARDOWN_TIMEOUT_MS = 1_000;\n9: const INCLUDE_BENCHES = process.env.SPECKIT_RUN_BENCHES === 'true';\n10: // The stress suites are excluded from the default run because they are slow, not\n11: // because they are unwanted. Without a way to opt in they were unreachable: no\n12: // script and no pattern selected them, so 21 files sat in the tree running never.\n13: // Opting in REPLACES the default set rather than adding to it: these suites churn\n14: // the daemon, its socket and its lease, and running them beside the ordinary\n15: // suites fails a handful of those on shared state rather than on their own logic.\n16: const INCLUDE_STRESS = process.env.SPECKIT_RUN_STRESS === 'true';\n17: \n18: // A plain object export instead of vitest's defineConfig wrapper: the config is\n19: // loaded by node's own module graph, where a bare `vitest` import resolves to\n20: // whatever node_modules sits next to this file. CI's routing job runs the suites\n21: // under a vitest pinned through npx, which can differ from the runtime's own\n22: // vitest range, so importing from the package here could load a second vitest\n23: // copy. defineConfig is an identity type-helper; dropping it changes nothing at\n24: // runtime.\n25: export default ({\n26:   root: import.meta.dirname,\n27:   test: {\n28:     include: [\n29:       ...(INCLUDE_STRESS ? ['stress-test/**/*.vitest.ts'] : ['tests/**/*.vitest.ts']),\n30:       ...(INCLUDE_BENCHES ? ['bench/**/*.bench.ts'] : []),\n31:     ],\n32:     exclude: [\n33:       'node_modules',\n34:       'dist',\n35:       ...(INCLUDE_BENCHES ? [] : ['bench/**/*.bench.ts']),\n36:     ],\n37:     setupFiles: [\n38:       path.resolve(import.meta.dirname, '../../system-spec-kit/runtime/tests/_support/vitest-setup.ts'),\n39:     ],\n40:     fileParallelism: false,\n41:     globals: true,\n42:     environment: 'node',\n43:     testTimeout: TEST_TIMEOUT_MS,\n44:     teardownTimeout: TEARDOWN_TIMEOUT_MS,\n45:     alias: {\n46:       '@lib': path.resolve(import.meta.dirname, 'lib'),\n47:     },\n48:   },\n49: });"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/vitest.config.ts\"}"},"time":{"start":1794527358383,"end":1794527359327}}}}
