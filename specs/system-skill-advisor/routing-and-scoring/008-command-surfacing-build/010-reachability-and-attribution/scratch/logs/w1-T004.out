mkdtempSync, readFileSync, readdirSync, rmSync, symlinkSync, writeFileSync } from 'node:fs';\n.skilled/skills/system-skill-advisor/runtime/tests/command-bridges-drift-guard.vitest.ts:512:    const root = mkdtempSync(join(tmpdir(), 'command-bridges-'));\n.skilled/skills/system-skill-advisor/runtime/tests/daemon-watcher-new-root-ingestion.vitest.ts:49:  const root = join(tmpdir(), `${name}-${process.pid}-${Date.now()}-${Math.random().toString(16).slice(2)}`);\n.skilled/skills/system-skill-advisor/runtime/tests/cross-skill-edges.vitest.ts:5:import { mkdtempSync, mkdirSync, readFileSync, rmSync, writeFileSync } from 'node:fs';\n.skilled/skills/system-skill-advisor/runtime/tests/cross-skill-edges.vitest.ts:63:    const root = mkdtempSync(join(tmpdir(), 'cross-skill-edges-'));\n.skilled/skills/system-skill-advisor/runtime/tests/cross-skill-edges.vitest.ts:128:    const root = mkdtempSync(join(tmpdir(), 'cross-skill-edges-'));\n.skilled/skills/system-skill-advisor/runtime/tests/cross-skill-edges.vitest.ts:169:    const root = mkdtempSync(join(tmpdir(), 'cross-skill-edges-'));\n.skilled/skills/system-skill-advisor/runtime/tests/cross-skill-edges.vitest.ts:230:    const root = mkdtempSync(join(tmpdir(), 'cross-skill-edges-'));\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"rg -n \\\"mkdtempSync|tmpdir\\\\(\\\\)\\\" .skilled/skills/system-skill-advisor/runtime/tests/*.vitest.ts | head -20\",\"workdir\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research\"}"},"time":{"start":1794527374914,"end":1794527376070}}}}
