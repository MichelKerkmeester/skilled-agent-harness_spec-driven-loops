advisor/runtime --entry skill-advisor-cli\",\n12:     \"build\": \"npm --prefix ../../system-spec-kit/shared run build && ../../system-spec-kit/node_modules/.bin/tsc -p tsconfig.build.json\",\n13:     \"postbuild\": \"mkdir -p dist/runtime/data && cp data/*.json dist/runtime/data/ && (node ../../system-spec-kit/runtime/cli/lib/dist-freshness.cjs record-build --package system-skill-advisor/runtime --entry default || node -e \\\"const r=require('../../system-spec-kit/runtime/cli/lib/dist-freshness.cjs').writePackageSourceHashCache('system-skill-advisor/runtime',{entry:'default'});if(r.status!=='cached')throw new Error(r.message)\\\") && (node ../../system-spec-kit/runtime/cli/lib/dist-freshness.cjs record-build --package system-skill-advisor/runtime --entry skill-advisor-cli || node -e \\\"const r=require('../../system-spec-kit/runtime/cli/lib/dist-freshness.cjs').writePackageSourceHashCache('system-skill-advisor/runtime',{entry:'skill-advisor-cli'});if(r.status!=='cached')throw new Error(r.message)\\\")\",\n14:     \"typecheck\": \"../../system-spec-kit/node_modules/.bin/tsc --noEmit --composite false -p tsconfig.build.json\",\n15:     \"test\": \"vitest run\",\n16:     \"test:stress\": \"SPECKIT_RUN_STRESS=true vitest run\"\n17:   },\n18:   \"dependencies\": {\n19:     \"@huggingface/transformers\": \"^3.8.1\",\n20:     \"@spec-kit/shared\": \"file:../../system-spec-kit/shared\",\n21:     \"better-sqlite3\": \"^12.11.1\",\n22:     \"chokidar\": \"^4.0.3\",\n23:     \"zod\": \"^4.6.7\"\n24:   },\n25:   \"overrides\": {\n26:     \"@hono/node-server\": \"^2.0.5\",\n27:     \"fast-uri\": \"^3.1.5\",\n28:     \"hono\": \"^4.12.34\",\n29:     \"ip-address\": \"^10.3.1\",\n30:     \"nanoid\": \"3.3.20\",\n31:     \"postcss\": \"^8.5.23\",\n32:     \"vite\": \"^8.1.2\",\n33:     \"protobufjs\": \"^7.6.4\",\n34:     \"tar\": \"^7.5.19\",\n35:     \"sharp\": \"^0.35.4\"\n36:   },\n37:   \"devDependencies\": {\n38:     \"vitest\": \"^4.1.12\"\n39:   }\n40: }"}],"providerCall":