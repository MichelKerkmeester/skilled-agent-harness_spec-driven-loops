{"type":"tool_use","timestamp":1794527333563,"sessionID":"ses_e2dd83265ffe1sA4o14G3RbaA3","part":{"partID":"prt_1d22a06790016IU1FWBnLfM4I6","sessionID":"ses_e2dd83265ffe1sA4o14G3RbaA3","messageID":"msg_1d229f9580016ZQ8l76e0qvihv","type":"tool","id":"call_3f72d221700946ac927b7e05","tool":"read","state":{"status":"completed","input":{"path":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-spec-kit/runtime/dist/hooks/claude/user-prompt-submit.js","limit":80},"output":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-spec-kit/runtime/dist/hooks/claude/user-prompt-submit.js, lines 1-80\n1: #!/usr/bin/env node\n2: // ───────────────────────────────────────────────────────────────────\n3: // MODULE: Claude User Prompt Submit Shim\n4: // ───────────────────────────────────────────────────────────────────\n5: // Thin process-boundary shim. The advisor implementation lives in\n6: // system-skill-advisor; this path stays for existing runtime settings.\n7: import { existsSync, statSync } from 'node:fs';\n8: import { spawnSync } from 'node:child_process';\n9: import { fileURLToPath } from 'node:url';\n10: import { dirname, isAbsolute, join } from 'node:path';\n11: // ───────────────────────────────────────────────────────────────────\n12: // 1. CONSTANTS\n13: // ───────────────────────────────────────────────────────────────────\n14: const TARGET_REL = 'skills/system-skill-advisor/runtime/dist/hooks/claude/user-prompt-submit.js';\n15: const MAX_STDIN_BYTES = 1024 * 1024;\n16: const MAX_STDIO_BYTES = 1024 * 1024;\n17: const CHILD_TIMEOUT_MS = 2500;\n18: // Reserve fallback time after advisor CLI; 300 ms covers measured startup overhead with headroom.\n19: const CHILD_START_MARGIN_MS = 300;\n20: // The host kills this hook after 3 seconds and the advisor child needs most of\n21: // that, so a host that never closes stdin must not hold the read for long. The\n22: // value matches SHORT_HOST_STDIN_TIMEOUT_MS in ../shared-stdin.ts, which this\n23: // file cannot import because its tests run the source directly.\n24: const STDIN_DEADLINE_MS = 500;\n25: const MAX_ROOT_WALK_DEPTH = 14;\n26: // ───────────────────────────────────────────────────────────────────\n27: // 2. TARGET RESOLUTION & SHIM DISPATCH\n28: // ───────────────────────────────────────────────────────────────────\n29: // Resolve the advisor target from this module's own location by walking up to\n30: // the nearest ancestor that owns one of the adapter roots (`.skilled` first,\n31: // then the legacy `.opencode` mirror). Claude may invoke the hook from any\n32: // working directory, so a CWD-relative path would silently miss the target and\n33: // fail open to `{}`; an install-anchored absolute path stays correct off-root.\n34: // An override names one executable module. It must be absolute, so a relative\n35: // path cannot be resolved against whatever cwd Claude happened to spawn the hook\n36: // with, and it must be a regular file, so a directory or a dangling link falls\n37: // back to the install-anchored walk instead of being handed to node.\n38: function isRegularFileOverride(candidate) {\n39:     if (!isAbsolute(candidate))\n40:         return false;\n41:     try {\n42:         return statSync(candidate).isFile();\n43:     }\n44:     catch {\n45:         return false;\n46:     }\n47: }\n48: function resolveTarget() {\n49:     // Test/install override: an explicit absolute target wins over the walk.\n50:     const override = process.env.SPECKIT_USER_PROMPT_TARGET;\n51:     if (override && isRegularFileOverride(override)) {\n52:         return override;\n53:     }\n54:     let current = dirname(fileURLToPath(import.meta.url));\n55:     for (let depth = 0; depth < MAX_ROOT_WALK_DEPTH; depth += 1) {\n56:         // Both root names must resolve identically: a checkout whose legacy mirror\n57:         // was dropped must not silently lose the advisor target, so the probe never\n58:         // assumes which root name owns it.\n59:         for (const rootName of ['.skilled', '.opencode']) {\n60:             const candidate = join(current, rootName, TARGET_REL);\n61:             if (existsSync(candidate)) {\n62:                 return candidate;\n63:             }\n64:         }\n65:         const parent = dirname(current);\n66:         if (parent === current) {\n67:             break;\n68:         }\n69:         current = parent;\n70:     }\n71:     return null;\n72: }\n73: function emitDiagnostic(code) {\n74:     process.stderr.write(`[speckit-hook:user-prompt-submit] ${code}\\n`);\n75: }\n76: // Collect stdin until it ends or the deadline passes, then release it so the\n77: // process can exit. More than MAX_STDIN_BYTES rejects with INPUT_OVERFLOW and\n78: // destroys stdin, so a runaway payload is never buffered whole.\n79: function readBoundedStdin() {\n80:     return new Promise((resolve, reject) => {\n[Output truncated. Continue reading with offset: 81]","title":"read","metadata":{"metadata":{"truncated":true},"content":[{"type":"text","text":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-spec-kit/runtime/dist/hooks/claude/user-prompt-submit.js, lines 1-80\n1: #!/usr/bin/env node\n2: // ───────────────────────────────────────────────────────────────────\n3: // MODULE: Claude User Prompt Submit Shim\n4: // ───────────────────────────────────────────────────────────────────\n5: // Thin process-boundary shim. The advisor implementation lives in\n6: // system-skill-advisor; this path stays for existing runtime settings.\n7: import { existsSync, statSync } from 'node:fs';\n8: import { spawnSync } from 'node:child_process';\n9: import { fileURLToPath } from 'node:url';\n10: import { dirname, isAbsolute, join } from 'node:path';\n11: // ───────────────────────────────────────────────────────────────────\n12: // 1. CONSTANTS\n13: // ──────────────────────────────────────────────────