     \"reason\": \"beyond-max-query-tokens\",\n      \"token\": \"exports\"\n    },\n    {\n      \"reason\": \"beyond-max-query-tokens\",\n      \"token\": \"plus\"\n    },\n    {\n      \"reason\": \"beyond-max-query-tokens\",\n      \"token\": \"vitest\"\n    },\n    {\n      \"reason\": \"beyond-max-query-tokens\",\n      \"token\": \"cases\"\n    }\n  ],\n  \"indexHash\": \"cac6622b1df8eae3cf5fe37681108fd2e890dfeb637c88211608313d0c4227cd\",\n  \"manifestHash\": \"c243be4138be26b030af5a965ddc587955809ebe6ccd694e69601c9e81a327a8\",\n  \"normalizedQuery\": \"create command offer module with parseoffer and replayoffer exports plus vitest cases\",\n  \"results\": [\n    {\n      \"matchClass\": \"query-containment\",\n      \"path\": \".skilled/skills/sk-doc/sk-create-command/README.md\",\n      \"phrases\": [\n        \"create command\",\n        \"slash command\"\n      ],\n      \"score\": 0.88\n    }\n  ],\n  \"schemaVersion\": 2,\n  \"specFolder\": null,\n  \"tokens\": [\n    \"create\",\n    \"command\",\n    \"offer\",\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"ls REPO RULES.md 2>/dev/null; node .skilled/skills/system-spec-kit/runtime/cli/retrieval/lookup-trigger-index.mjs --json --scoring-only -- \\\"Create command-offer module with parseOffer and replayOffer exports plus vitest cases\\\" 2>&1 | head -40\",\"workdir\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research\"}"},"time":{"start":1794527282214,"end":1794527284073}}}}
