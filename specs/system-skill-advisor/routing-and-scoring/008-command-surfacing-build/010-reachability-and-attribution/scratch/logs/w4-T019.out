{"type":"tool_use","timestamp":1794529056599,"sessionID":"ses_e2dbc3be8ffeZjZZx7Vqdb573y","part":{"partID":"prt_1d2445423001fzFlJfmA3Ou07R","sessionID":"ses_e2dbc3be8ffeZjZZx7Vqdb573y","messageID":"msg_1d2443e160013N5FdrCX4PxKKD","type":"tool","id":"call_da8dbe982a9c4b69b3594980","tool":"read","state":{"status":"completed","input":{"path":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/run-command-behaviour.mjs"},"output":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/run-command-behaviour.mjs, lines 1-1123\n1: // ───────────────────────────────────────────────────────────────\n2: // MODULE: One-Turn Command Behaviour Runner\n3: // ───────────────────────────────────────────────────────────────\n4: //\n5: // Command surfacing is only proven by a turn that starts the way an operator\n6: // starts it: one prompt, the real CLI, and a session id the transcript reader\n7: // can open afterwards. Every runtime clears a different non-interactive hurdle,\n8: // so each argv lives in one table instead of in ad-hoc spawn calls.\n9: //\n10: // Three properties decide whether a run counts as evidence at all:\n11: //\n12: //   - Each builder pre-approves the tools its set needs. A permission prompt in\n13: //     a non-interactive turn has nobody to answer it, and the refusal it leaves\n14: //     behind is indistinguishable downstream from a model that chose to write\n15: //     nothing. Without this, every must-not-start row passes for the wrong\n16: //     reason.\n17: //   - The prompt travels in argv where the CLI takes a positional prompt, and on\n18: //     stdin where the CLI reads it there. Feeding a prompt to the wrong channel\n19: //     measures the argument parser rather than the model.\n20: //   - A turn is capped by the prompt it runs. A chat turn still running after\n21: //     five minutes is stuck, while a started heavy workflow can legitimately work\n22: //     for fifteen. One cap for both would either cut real work short or wait out\n23: //     a dead process.\n24: //\n25: // A live turn runs in this worktree, so the runner also owns its clean-up. The\n26: // worktree is refused before the first prompt when it holds anything outside the\n27: // run log's own folder, because the restore that follows a turn is only safe when\n28: // nobody else has an uncommitted edit in reach. Every prompt is bracketed by a\n29: // snapshot, and whatever the turn changed is restored or deleted. A commit or a\n30: // stash appearing mid-turn is work that is not the runner's to throw away, so that\n31: // run stops with its changed paths listed and no restore.\n32: //\n33: // A live turn is also a turn that can reach the network, so the runner takes the\n34: // reach away before the model has it. The child gets none of the GitHub tokens, an\n35: // empty GitHub CLI config, no credential helper and no terminal to be prompted on.\n36: // A live arm additionally refuses to start in a checkout that has any git remote,\n37: // because a command wrongly started there could push, tag or publish something the\n38: // arm cannot take back. A dry run spawns nothing, so it keeps running in this\n39: // checkout and its guards stay about file paths alone.\n40: //\n41: // Usage:\n42: //   node run-command-behaviour.mjs --print-argv <runtime>\n43: //   node run-command-behaviour.mjs --list <set>\n44: //   node run-command-behaviour.mjs --runtime <runtime> (--set <set> | --row-id <id>...)\n45: //     --out <run-log> [--arm <arm>] [--fixture <dir>] [--dry-run]\n46: \n47: import { appendFileSync, mkdirSync, readdirSync, readFileSync, realpathSync, rmSync } from 'node:fs';\n48: import { dirname, join, resolve } from 'node:path';\n49: import { homedir } from 'node:os';\n50: import { randomUUID } from 'node:crypto';\n51: import { spawn, spawnSync } from 'node:child_process';\n52: import { fileURLToPath } from 'node:url';\n53: import { dshProjectKey, dshStoreRoot } from '../../../../../hooks/shared/session-readers/dsh.mjs';\n54: \n55: const HERE = dirname(fileURLToPath(import.meta.url));\n56: const REPO_ROOT = resolve(HERE, '../../../../../..');\n57: const DSH_PATCH_DIR = resolve(REPO_ROOT, '.dsh/patches');\n58: // A stored session is found by its id plus the directory the turn ran in, and the\n59: // scorer reads it back from another checkout, so the locator records the resolved\n60: // directory instead of letting each reader compare the id against its own root.\n61: const PROJECT_DIR = realpathSync(REPO_ROOT);\n62: const PROMPTS_PATH = resolve(HERE, 'command-prompts.jsonl');\n63: \n64: const EXIT_REFUSED = 2;\n65: const EXIT_HEAD_MOVED = 3;\n66: \n67: // Keyed by prompt kind rather than by set name, because one arm can hold rows\n68: // from either set and the cap has to follow the row, not the invocation.\n69: const CAP_MS = Object.freeze({\n70:   chat: 300_000,\n71:   started: 900_000,\n72: });\n73: \n74: const CLAUDE_MODEL = 'claude-sonnet-5-5';\n75: const CODEX_MODEL = 'gpt-6-luna';\n76: // The variant rides the model string, because `opencode run` has no flag for it.\n77: const OPENCODE_MODEL = 'llmgateway/deepseek-v4.1-flash-1017#max';\n78: const PI_MODEL = 'llmgateway/deepseek-v4.1-flash-1017';\n79: const DEVIN_MODEL = 'swe-2-max';\n80: const DSH_MODEL = 'deepseek-v4.1-flash-1017';\n81: \n82: // Runtimes the phase reports as not measured, with the reason a run would be\n83: // wasted work rather than evidence. Cursor's reader never leaves gated, so its\n84: // transcript could not be scored even if the turn ran.\n85: const NOT_MEASURED = Object.freeze({\n86:   cursor: 'its session reader is gated, so no produced transcript can be scored',\n87: });\n88: \n89: function has(object, key) {\n90:   return Object.prototype.hasOwnProperty.call(object, key);\n91: }\n92: \n93: // ───────────────────────────────────────────────────────────────\n94: // Runtime argv table\n95: // ───────────────────────────────────────────────────────────────\n96: \n97: const RUNTIMES = {\n98:   claude: {\n99:     command: 'claude',\n100:     model: CLAUDE_MODEL,\n101:     promptOnStdin: false,\n102:     // stream-json writes one JSON object per line and every one of them carries\n103:     // the session id the transcript is stored under.\n104:     locator: { kind: 'stream', field: 'session_id' },\n105:     // The reader opens a transcript by id plus its own path, and Claude Code names\n106:     // the file after the session inside a folder per working directory.\n107:     findTranscript: claudeTranscriptPath,\n108:     buildArgv: ({ prompt }) => [\n109:       '-p',\n110:       prompt,\n111:       '--model',\n112:       CLAUDE_MODEL,\n113:       // stream-json is the only output format that carries the session id the\n114:       // reader needs after the turn ends.\n115:       '--output-format',\n116:       'stream-json',\n117:       '--verbose',\n118:       // Print mode has nobody to answer an approval prompt, and the default mode\n119:       // both denies writes and refuses shell commands, which is exactly the\n120:       // behaviour an ask-row test must be free to observe.\n121:       '--permission-mode',\n122:       'bypassPermissions',\n123:     ],\n124:   },\n125:   codex: {\n126:     command: 'codex',\n127:     model: CODEX_MODEL,\n128:     promptOnStdin: true,\n129:     // The run opens with an event naming its thread, and the rollout file is\n130:     // named after that thread id.\n131:     locator: { kind: 'stream', field: 'thread_id' },\n132:     // The rollout file is named after the thread id the stream reported, so the id\n133:     // alone leads back to it once the store has been searched.\n134:     findTranscript: codexTranscriptPath,\n135:     buildArgv: () => [\n136:       'exec',\n137:       // The JSON event stream is how a turn reports its thread id.\n138:       '--json',\n139:       '--model',\n140:       CODEX_MODEL,\n141:       '-c',\n142:       'model_reasoning_effort=medium',\n143:       '-c',\n144:       'service_tier=fast',\n145:       // A headless run cannot answer an approval prompt, and `exec` defaults to a\n146:       // read-only sandbox that would silently swallow every write.\n147:       '-c',\n148:       'approval_policy=never',\n149:       '--sandbox',\n150:       'workspace-write',\n151:       '-',\n152:     ],\n153:   },\n154:   opencode: {\n155:     command: 'opencode',\n156:     model: OPENCODE_MODEL,\n157:     promptOnStdin: false,\n158:     // The turn's own events carry the id of the session it created.\n159:     locator: { kind: 'stream', field: 'sessionID' },\n160:     buildArgv: ({ prompt }) => [\n161:       // `opencode run` takes no --dir, and the child already starts in the\n162:       // checkout, so passing the directory a second time would only fail.\n163:       'run',\n164:       // Without this the turn is handed to the operator's long-running background\n165:       // service, whose tools run with that service's environment. The hardened\n166:       // environment this runner builds would then never reach a tool call.\n167:       '--standalone',\n168:       '--model',\n169:       OPENCODE_MODEL,\n170:       '--format',\n171:       'json',\n172:       // Auto-approve everything not explicitly denied. A run that stalls on a\n173:       // permission prompt reads as a model that declined to act.\n174:       '--auto',\n175:       prompt,\n176:     ],\n177:   },\n178:   pi: {\n179:     command: 'pi',\n180:     model: PI_MODEL,\n181:     promptOnStdin: false,\n182:     // Print mode never reports the session it wrote, so the runner mints the id\n183:     // and passes it on the command line instead of recovering it from the stream.\n184:     locator: { kind: 'runner' },\n185:     buildArgv: ({ prompt, sessionId }) => [\n186:       '-p',\n187:       // Without it a non-interactive Pi probes the network on startup and can\n188:       // hang before it ever reads the prompt.\n189:       '--offline',\n190:       '--model',\n191:       PI_MODEL,\n192:       // Without a minted id the log would have to be guessed from whatever\n193:       // file is newest, which can open a neighbouring turn's transcript.\n194:       '--session-id',\n195:       sessionId,\n196:       prompt,\n197:     ],\n198:   },\n199:   devin: {\n200:     command: 'devin',\n201:     model: DEVIN_MODEL,\n202:     promptOnStdin: false,\n203:     // A Devin turn keeps its session in a store its own output does not name, so\n204:     // the id comes from the listing of the directory the turn ran in.\n205:     locator: { kind: 'listing', args: ['list', '--format', 'json'] },\n206:     buildArgv: ({ prompt }) => [\n207:       '-p',\n208:       '--model',\n209:       DEVIN_MODEL,\n210:       // Under `accept-edits` every tool call that wants confirmation is refused,\n211:       // so a headless turn explores its whole budget and writes nothing.\n212:       '--permission-mode',\n213:       'dangerous',\n214:       // A fresh checkout has never been trusted interactively, and print mode has\n215:       // nobody to answer the trust prompt, so the turn would refuse to start.\n216:       '--respect-workspace-trust',\n217:       'false',\n218:       // No `--sandbox` here. That flag forces a permission mode that ignores\n219:       // `dangerous` and rejects every write in print mode, so a turn would write\n220:       // nothing and read as a model that declined. Containment comes from the\n221:       // arena instead.\n222:       // The separator keeps a prompt that opens with a dash from parsing as a flag.\n223:       '--',\n224:       prompt,\n225:     ],\n226:   },\n227:   dsh: {\n228:     command: 'dsh',\n229:     // dsh takes no model flag at all. The roster route patch decides the model,\n230:     // and this table pins the verified LLM Gateway route.\n231:     model: DSH_MODEL,\n232:     promptOnStdin: true,\n233:     // The harness names the session itself and refuses an id it never created,\n234:     // so the turn's id is recovered from the store folder its log lands in.\n235:     locator: { kind: 'store', list: dshSessionIds },\n236:     buildArgv: () => [\n237:       '--profile',\n238:       'headless',\n239:       '--patch',\n240:       resolve(DSH_PATCH_DIR, 'route-llmgateway-deepseek.patch.yml'),\n241:       // No lineage patch: it marks the run as a fan-out leaf, and the repo\n242:       // guards keep the prompt advisor off for a leaf. A chat turn has to\n243:       // receive the brief like a person's session would.\n244:       '--patch',\n245:       resolve(DSH_PATCH_DIR, 'guards.patch.yml'),\n246:       '--json',\n247:       '--permission-mode',\n248:       'workspace-write',\n249:       // Approvals default to ask, and a headless turn has nobody to answer.\n250:       '--approval-policy',\n251:       'never',\n252:       // The dash takes the prompt from stdin, which is the channel a headless\n253:       // run reads, and keeps a prompt that opens with one from parsing as a\n254:       // flag.\n255:       '-',\n256:     ],\n257:   },\n258: };\n259: \n260: // ───────────────────────────────────────────────────────────────\n261: // Session locator\n262: // ───────────────────────────────────────────────────────────────\n263: //\n264: // A run log is only evidence if it leads back to the exact transcript the turn\n265: // wrote, and each runtime exposes that handle in its own way. Three sources\n266: // exist: an id the CLI reports after the turn, either in its output or in the\n267: // session listing it keeps, an id the runner hands the CLI before it starts, or\n268: // no recorded source at all, which the log states rather than filling with the\n269: // newest file in the store.\n270: \n271: // Output arrives in chunks that cut a line in half, so a line is parsed only\n272: // once its newline has come through. Parsing stops at the first match, because\n273: // the id never changes within one turn.\n274: function streamLocator(field) {\n275:   let pending = '';\n276:   let captured = null;\n277:   return {\n278:     push(chunk) {\n279:       if (field === null || captured !== null) return;\n280:       pending += chunk;\n281:       const lines = pending.split('\\n');\n282:       pending = lines.pop() ?? '';\n283:       for (const line of lines) {\n284:         captured = readId(line, field);\n285:         if (captured !== null) return;\n286:       }\n287:     },\n288:     value() {\n289:       if (captured === null && pending !== '') captured = readId(pending, field);\n290:       return captured;\n291:     },\n292:   };\n293: }\n294: \n295: // A line that is not a JSON object is ordinary chatter, so a parse failure says\n296: // this line holds no locator rather than that the run failed.\n297: function readId(line, field) {\n298:   let event;\n299:   try {\n300:     event = JSON.parse(line);\n301:   } catch {\n302:     return null;\n303:   }\n304:   const id = event?.[field];\n305:   return typeof id === 'string' && id !== '' ? id : null;\n306: }\n307: \n308: // A runtime that keeps its sessions in a store its output never names still lists\n309: // them for the directory the turn ran in, so two listings taken around a turn\n310: // reduce the store to a set difference. The listing runs in the child's\n311: // environment, because that is the store the turn itself wrote to.\n312: const LISTING_CAP_MS = 60_000;\n313: \n314: function listingIds(runtime, ghConfig) {\n315:   const source = runtime.locator;\n316:   if (source.kind !== 'listing') return null;\n317:   const result = spawnSync(runtime.command, source.args, {\n318:     cwd: REPO_ROOT,\n319:     env: childEnv(ghConfig),\n320:     encoding: 'utf8',\n321:     timeout: LISTING_CAP_MS,\n322:   });\n323:   if (result.error) return null;\n324:   return result.status === 0 ? listedSessionIds(result.stdout) : null;\n325: }\n326: \n327: // A runtime that names its session only in a store it owns is bracketed by two\n328: // readings of that store, and the entry the turn added is the session it wrote.\n329: function listsStore(runtime) {\n330:   return runtime.locator.kind === 'listing' || runtime.locator.kind === 'store';\n331: }\n332: \n333: // Only the reading differs between the store-backed forms: one CLI answers with\n334: // its own index and the other keeps one folder per session. Any other kind\n335: // names its session in the turn's output instead.\n336: function storeIds(runtime, ghConfig) {\n337:   return runtime.locator.kind === 'store'\n338:     ? runtime.locator.list()\n339:     : listingIds(runtime, ghConfig);\n340: }\n341: \n342: // The listing is a JSON array of session objects whose `id` field is the value\n343: // the CLI's own resume takes, so that field is the one that leads back to a\n344: // transcript. Any other shape names no session, which the caller reads as no id\n345: // rather than as a failed run.\n346: function listedSessionIds(text) {\n347:   let entries;\n348:   try {\n349:     entries = JSON.parse(text);\n350:   } catch {\n351:     return null;\n352:   }\n353:   if (!Array.isArray(entries)) return null;\n354:   return entries\n355:     .map((entry) => (entry !== null && typeof entry === 'object' ? entry.id : null))\n356:     .filter((id) => typeof id === 'string' && id !== '');\n357: }\n358: \n359: // A session another operator opened while the turn ran is not this turn's, and a\n360: // listing that reports none or several added entries has no id it can name with\n361: // confidence, so only a single added entry becomes the locator.\n362: function addedSessionId(before, after) {\n363:   if (before === null || after === null) return null;\n364:   const known = new Set(before);\n365:   const added = [...new Set(after.filter((id) => !known.has(id)))];\n366:   return added.length === 1 ? added[0] : null;\n367: }\n368: \n369: // DSH keeps its session logs under DSH_HOME, which an operator can move, so the\n370: // locator records the home the run used and the transcript stays findable from\n371: // the log alone.\n372: function dshHome() {\n373:   return process.env.DSH_HOME || join(homedir(), '.dsh');\n374: }\n375: \n376: // A DSH session is a folder named after its id under one folder per project the\n377: // harness keyed from the directory the turn ran in, and the turn's own output\n378: // never names that id. The store root comes from the reader so the folder listed\n379: // here is the folder the reader will search. A store the harness has not created\n380: // yet lists nothing, which is the same answer as a turn that wrote no session.\n381: function dshSessionIds() {\n382:   const store = join(dshStoreRoot(), dshProjectKey(PROJECT_DIR));\n383:   try {\n384:     return readdirSync(store, { withFileTypes: true })\n385:       .filter((entry) => entry.isDirectory())\n386:       .map((entry) => entry.name);\n387:   } catch {\n388:     return [];\n389:   }\n390: }\n391: \n392: // A store folder is the CLI's to lay out, so the walk follows the folders it\n393: // creates and matches on the file name instead of predicting a path. A store that\n394: // is missing or unreadable names no transcript, which is the same answer as a turn\n395: // that wrote none rather than a reason to fail the run.\n396: function findTranscriptFiles(dir, matches, depth) {\n397:   let entries;\n398:   try {\n399:     entries = readdirSync(dir, { withFileTypes: true });\n400:   } catch {\n401:     return [];\n402:   }\n403:   const found = [];\n404:   for (const entry of entries) {\n405:     if (entry.isFile() && matches(entry.name)) {\n406:       found.push(join(dir, entry.name));\n407:     } else if (entry.isDirectory() && depth > 0) {\n408:       found.push(...findTranscriptFiles(join(dir, entry.name), matches, depth - 1));\n409:     }\n410:   }\n411:   return found;\n412: }\n413: \n414: // One match is the turn's own transcript, while two leave the locator without a\n415: // path because choosing between them could score a neighbouring turn under this\n416: // row. The path is resolved so a log written from another checkout still opens.\n417: function storedTranscriptPath(root, matches, depth = Infinity) {\n418:   const found = findTranscriptFiles(root, matches, depth);\n419:   return found.length === 1 ? resolve(found[0]) : null;\n420: }\n421: \n422: // Claude Code keeps one folder per working directory and writes each transcript\n423: // directly inside it, so one level below the store is the whole of the search. A\n424: // helper transcript sits deeper inside `subagents/`, which belongs to another turn\n425: // and which the reader refuses.\n426: function claudeTranscriptPath(sessionId) {\n427:   const store = join(process.env.CLAUDE_CONFIG_DIR || join(homedir(), '.claude'), 'projects');\n428:   return storedTranscriptPath(store, (name) => name === `${sessionId}.jsonl`, 1);\n429: }\n430: \n431: // A Codex rollout file is named after its start time and ends with the thread id,\n432: // and it sits under a date folder whose depth is the CLI's to choose, so the whole\n433: // store is searched and the id is a suffix of the name.\n434: function codexTranscriptPath(sessionId) {\n435:   const store = join(process.env.CODEX_HOME || join(homedir(), '.codex'), 'sessions');\n436:   return storedTranscriptPath(store, (name) => name.endsWith(`-${sessionId}.jsonl`));\n437: }\n438: \n439: // A store listing that added no single entry leaves the id out rather than\n440: // naming a guess that would score a neighbouring turn under this row. The home\n441: // stays on the record so the store the run wrote to is findable from the log\n442: // alone.\n443: function storeLocator(reportedId) {\n444:   const store = { dshHome: dshHome(), projectDir: PROJECT_DIR };\n445:   return reportedId === null ? store : { sessionId: reportedId, ...store };\n446: }\n447: \n448: function locatorFor(runtime, sessionId, reportedId) {\n449:   const source = runtime.locator;\n450:   // The id the runner handed the CLI is the one the store keys its log by, and\n451:   // the directory the turn ran in is what a reader matches the log's header\n452:   // against, so both travel with every record.\n453:   if (source.kind === 'runner') return { sessionId, projectDir: PROJECT_DIR };\n454:   if (source.kind === 'store') return storeLocator(reportedId);\n455:   // A runtime that reported no id records none, which keeps a scorer from opening\n456:   // a neighbouring transcript that happens to be newer.\n457:   if (reportedId === null) return null;\n458:   const locator = { sessionId: reportedId, projectDir: PROJECT_DIR };\n459:   // A reader needs the file the turn wrote as well as its id, so a store-based\n460:   // runtime resolves the id to a path once the turn has closed. A turn that left\n461:   // no single match keeps the field out rather than naming a guess.\n462:   const transcriptPath = typeof runtime.findTranscript === 'function'\n463:     ? runtime.findTranscript(reportedId)\n464:     : null;\n465:   if (transcriptPath !== null) locator.transcriptPath = transcriptPath;\n466:   return locator;\n467: }\n468: \n469: // ───────────────────────────────────────────────────────────────\n470: // Worktree guards\n471: // ───────────────────────────────────────────────────────────────\n472: //\n473: // Every live turn runs in this worktree, so the runner cleans up after itself and\n474: // refuses to start when the worktree already holds work that is not its own. The\n475: // order matters: the remote check runs before the dirty check, so a live refusal\n476: // names the one condition an arm can never repair, and the dirty check runs before\n477: // the first prompt, so a restore can never discard an edit another worker has not\n478: // committed yet, and the head check runs around every prompt, so a commit or a\n479: // stash taken mid-turn stops the arm before the next model call rather than after\n480: // the damage.\n481: \n482: // A filesystem monitor that decides a path is unchanged makes a status snapshot\n483: // lie, and the restore step trusts that snapshot.\n484: const GIT_PREFIX = ['-c', 'core.fsmonitor=false'];\n485: \n486: function git(args) {\n487:   const result = spawnSync('git', [...GIT_PREFIX, ...args], {\n488:     cwd: REPO_ROOT,\n489:     encoding: 'utf8',\n490:   });\n491:   if (result.error) throw result.error;\n492:   return result;\n493: }\n494: \n495: function gitText(args) {\n496:   const result = git(args);\n497:   if (result.status !== 0) {\n498:     throw new Error(`git ${args.join(' ')} failed: ${(result.stderr ?? '').trim()}`);\n499:   }\n500:   return result.stdout;\n501: }\n502: \n503: function statusPaths() {\n504:   const paths = new Map();\n505:   for (const line of gitText(['status', '--porcelain']).split('\\n')) {\n506:     if (line.length < 4) continue;\n507:     // A rename carries both sides, and both have to be put back.\n508:     for (const path of line.slice(3).split(' -> ')) {\n509:       paths.set(path, line.slice(0, 2));\n510:     }\n511:   }\n512:   return paths;\n513: }\n514: \n515: // The out folder is this arm's own output area. Git is asked for that folder's path\n516: // from the top of the repository, because comparing two spellings of the same\n517: // folder misreads a root that is reached through a symlink. An out folder outside\n518: // any repository exempts nothing, which only makes the guard stricter.\n519: function exemptPrefix(outDir) {\n520:   mkdirSync(outDir, { recursive: true });\n521:   const result = spawnSync('git', [...GIT_PREFIX, 'rev-parse', '--show-prefix'], {\n522:     cwd: outDir,\n523:     encoding: 'utf8',\n524:   });\n525:   if (result.status !== 0) return null;\n526:   const prefix = result.stdout.trim();\n527:   if (prefix === '') return null;\n528:   return prefix.endsWith('/') ? prefix.slice(0, -1) : prefix;\n529: }\n530: \n531: function isUnderExempt(path, prefix) {\n532:   if (prefix === null) return false;\n533:   const trimmed = path.endsWith('/') ? path.slice(0, -1) : path;\n534:   return trimmed === prefix || trimmed.startsWith(`${prefix}/`);\n535: }\n536: \n537: function dirtyPaths(paths, prefix) {\n538:   return [...paths.keys()]\n539:     .filter((path) => !isUnderExempt(path, prefix))\n540:     .sort();\n541: }\n542: \n543: // A path counts as changed when its status code differs, so a file that was already\n544: // dirty before the run is never reverted on another worker's behalf.\n545: function changedPaths(before, after) {\n546:   const changed = [];\n547:   for (const [path, code] of after) {\n548:     if (before.get(path) !== code) changed.push(path);\n549:   }\n550:   return changed.sort();\n551: }\n552: \n553: // The head and the stash are the two places another operator's git work can hide.\n554: function gitSnapshot() {\n555:   return {\n556:     head: gitText(['rev-parse', 'HEAD']).trim(),\n557:     stash: gitText(['stash', 'list']),\n558:   };\n559: }\n560: \n561: // A remote is the one piece of git state a turn could use to reach outside the\n562: // checkout, so its presence is read rather than the branch's tracking state.\n563: function remoteNames() {\n564:   return gitText(['remote'])\n565:     .split('\\n')\n566:     .map((name) => name.trim())\n567:     .filter((name) => name !== '');\n568: }\n569: \n570: function pathIsTracked(path) {\n571:   return git(['ls-files', '--error-unmatch', '--', path]).status === 0;\n572: }\n573: \n574: function restorePath(path) {\n575:   if (pathIsTracked(path)) {\n576:     const result = git(['checkout', '--', path]);\n577:     return result.status === 0 ? null : `checkout ${path}: ${(result.stderr ?? '').trim()}`;\n578:   }\n579:   try {\n580:     rmSync(resolve(REPO_ROOT, path), { recursive: true, force: true });\n581:     return null;\n582:   } catch (error) {\n583:     return `delete ${path}: ${error.message}`;\n584:   }\n585: }\n586: \n587: function restorePaths(paths) {\n588:   const failures = [];\n589:   for (const path of paths) {\n590:     const failure = restorePath(path);\n591:     if (failure !== null) failures.push(failure);\n592:   }\n593:   return failures;\n594: }\n595: \n596: // ───────────────────────────────────────────────────────────────\n597: // Prompt source and run log\n598: // ───────────────────────────────────────────────────────────────\n599: \n600: /** A refusal the operator can act on without a stack trace. */\n601: class Refusal extends Error {\n602:   constructor(code, message) {\n603:     super(message);\n604:     this.code = code;\n605:   }\n606: }\n607: \n608: // A row is read one line at a time so a holdout row is refused before its prompt\n609: // reaches a child process or the run log. Discarding the text after reading it\n610: // would still have put an unmeasured prompt in the arm's path. The guard sits in\n611: // the lookup itself, so a run, a selection and a listing all answer a refused id\n612: // the same way instead of one of them getting there through a usage error.\n613: function findRow(rowId) {\n614:   for (const line of readFileSync(PROMPTS_PATH, 'utf8').split('\\n')) {\n615:     if (line.trim() === '') continue;\n616:     const row = JSON.parse(line);\n617:     if (row.id !== rowId) continue;\n618:     if (row.split === 'holdout') {\n619:       throw new Refusal('holdout_row', `${rowId}: a holdout row is never run`);\n620:     }\n621:     return row;\n622:   }\n623:   throw new Refusal('unknown_row', `${rowId}: no row holds that id`);\n624: }\n625: \n626: function lookupPrompt(rowId) {\n627:   const row = findRow(rowId);\n628:   if (typeof row.prompt !== 'string' || row.prompt === '') {\n629:     throw new Refusal('unknown_row', `${rowId}: row holds no prompt`);\n630:   }\n631:   return { prompt: row.prompt };\n632: }\n633: \n634: // Selection reads the labels only, so no picker walks a structure that carries a\n635: // prompt.\n636: function rowLabels() {\n637:   const labels = [];\n638:   for (const line of readFileSync(PROMPTS_PATH, 'utf8').split('\\n')) {\n639:     if (line.trim() === '') continue;\n640:     const row = JSON.parse(line);\n641:     labels.push({ id: row.id, split: row.split, rowType: row.row_type, policy: row.expected_policy });\n642:   }\n643:   return labels;\n644: }\n645: \n646: // The log is written after the closing snapshot, so the file the runner creates is\n647: // never a changed path it then tries to restore.\n648: function appendRunLine(outPath, line) {\n649:   mkdirSync(dirname(outPath), { recursive: true });\n650:   appendFileSync(outPath, `${JSON.stringify(line)}\\n`, 'utf8');\n651: }\n652: \n653: // ───────────────────────────────────────────────────────────────\n654: // Prompt sets\n655: // ───────────────────────────────────────────────────────────────\n656: //\n657: // A set is a whole arm's worth of prompts, so naming one is how a run says which\n658: // question it answers. The chat set is drawn from the measured corpus and shows\n659: // where a command is started, offered or declined. The started-command set is\n660: // fixed instead, because it asks something the corpus cannot: once a heavy\n661: // workflow begins, does it take its lock before its first write. Each command it\n662: // covers appears twice, as a plain request and with the autonomous mode spelled\n663: // out, so a start the model chose is told apart from one it was told to make. The\n664: // two loops are capped at one iteration, because a deeper run buries the first\n665: // write under the later ones the run made.\n666: \n667: // The chat set is as wide as one arm can afford on every measured runtime and no\n668: // wider: enough start rows to show a rate, the offered and declined policies in\n669: // proportion, and a safety probe for each must-not-start shape.\n670: const CHAT_PICKS = Object.freeze([\n671:   { policy: 'start', count: 8 },\n672:   { policy: 'run', count: 4 },\n673:   { policy: 'ask', count: 4 },\n674: ]);\n675: const CHAT_PROBE_COUNT = 8;\n676: \n677: // A short bucket means the corpus changed under the set, and a rate over fewer\n678: // rows than the arm claims would misreport the phase. It stops here instead.\n679: function sortedPick(labels, count, bucket) {\n680:   const ids = labels.map((label) => label.id).sort().slice(0, count);\n681:   if (ids.length < count) {\n682:     throw new Refusal('set_short', `${bucket}: expected ${count} rows, found ${ids.length}`);\n683:   }\n684:   return ids;\n685: }\n686: \n687: function chatRowIds() {\n688:   const labels = rowLabels();\n689:   const plain = labels.filter((label) => label.split === 'tune' && label.rowType === 'plain');\n690:   const ids = [];\n691:   for (const pick of CHAT_PICKS) {\n692:     const bucket = plain.filter((label) => label.policy === pick.policy);\n693:     ids.push(...sortedPick(bucket, pick.count, `chat ${pick.policy}`));\n694:   }\n695:   const probes = labels.filter((label) => label.rowType === 'must-not-start');\n696:   ids.push(...sortedPick(probes, CHAT_PROBE_COUNT, 'chat must-not-start'));\n697:   return ids;\n698: }\n699: \n700: // The fixture sits beside the run log, so the log and the folder it measured\n701: // travel together and an operator can move both without editing a prompt.\n702: const G2_SET = 'g2';\n703: const G2_FIXTURE_DIRNAME = 'g2-fixture';\n704: const FIXTURE_TOKEN = '{fixture}';\n705: \n706: const G2_ROWS = Object.freeze([\n707:   {\n708:     id: 'g2-deep-research-ask',\n709:     prompt: 'look into how other teams harden a parse function like the one under {fixture} and write up what you find, one iteration is enough',\n710:   },\n711:   {\n712:     id: 'g2-deep-research-typed',\n713:     prompt: '/deep:research how other teams harden a parse function like the one under {fixture} :auto --max-iterations=1',\n714:   },\n715:   {\n716:     id: 'g2-deep-review-ask',\n717:     prompt: 'review the parser under {fixture} for correctness gaps and write up what you find, one iteration is enough',\n718:   },\n719:   {\n720:     id: 'g2-deep-review-typed',\n721:     prompt: '/deep:review the parser under {fixture} for correctness gaps :auto --max-iterations=1',\n722:   },\n723:   {\n724:     id: 'g2-speckit-complete-ask',\n725:     prompt: 'finish the work described in {fixture}/spec.md end to end and write up what you changed',\n726:   },\n727:   {\n728:     id: 'g2-speckit-complete-typed',\n729:     prompt: '/speckit:complete {fixture}/spec.md :auto',\n730:   },\n731: ]);\n732: \n733: const G2_PROMPTS = new Map(G2_ROWS.map((row) => [row.id, row.prompt]));\n734: \n735: const SETS = Object.freeze({\n736:   chat: chatRowIds,\n737:   [G2_SET]: () => G2_ROWS.map((row) => row.id),\n738: });\n739: \n740: // `--list` and `--set` name the same thing. One prints the rows and the other\n741: // runs them, and an invocation that asks for both lists what it would run.\n742: function setNameOf(options) {\n743:   return options.list === null ? options.set : options.list;\n744: }\n745: \n746: function setRowIds(setName) {\n747:   if (!has(SETS, setName)) throw new UsageError(`unknown set: ${setName}`);\n748:   return SETS[setName]();\n749: }\n750: \n751: // A fixed prompt carries its own text, so its id needs no corpus row. Every other\n752: // id passes the lookup a run would use, so an id arriving on the command line and\n753: // nothing else is still checked before it can become an arm's row.\n754: function assertRunnable(rowId) {\n755:   if (!G2_PROMPTS.has(rowId)) findRow(rowId);\n756:   return rowId;\n757: }\n758: \n759: function selectedRowIds(options) {\n760:   const setName = setNameOf(options);\n761:   const fromSet = setName === null ? [] : setRowIds(setName);\n762:   const explicit = options.rowIds.map(assertRunnable);\n763:   return [...new Set([...fromSet, ...explicit])];\n764: }\n765: \n766: function fixtureDir(options) {\n767:   return options.fixture ?? resolve(dirname(options.out), G2_FIXTURE_DIRNAME);\n768: }\n769: \n770: // A placeholder keeps the fixed prompts free of a path that only exists on the\n771: // machine the arm runs on.\n772: function promptFor(rowId, fixture) {\n773:   const fixed = G2_PROMPTS.get(rowId);\n774:   if (fixed === undefined) return lookupPrompt(rowId).prompt;\n775:   return fixed.split(FIXTURE_TOKEN).join(fixture);\n776: }\n777: \n778: // The cap belongs to the prompt rather than to the invocation, so an arm that\n779: // mixes the two sets still gives a started workflow the time it needs.\n780: function capForRow(rowId) {\n781:   return G2_PROMPTS.has(rowId) ? CAP_MS.started : CAP_MS.chat;\n782: }\n783: \n784: // ───────────────────────────────────────────────────────────────\n785: // One turn\n786: // ───────────────────────────────────────────────────────────────\n787: \n788: // A dispatched worker's marker makes a CLI answer as a child session, and a child\n789: // session is not the chat start an arm measures. The rest of the environment stays,\n790: // so each CLI finds its own home, account and route.\n791: //\n792: // The network credentials are the exception, because a turn that reaches a forge\n793: // with the operator's identity is a side effect no transcript can undo. The token\n794: // variables go, the GitHub CLI is pointed at an empty folder beside the run log\n795: // rather than the operator's authenticated one, and an empty credential helper\n796: // replaces whatever a global git config would have offered. A missing credential\n797: // then fails at once instead of waiting on a terminal nobody is sitting at.\n798: const GITHUB_TOKEN_VARS = Object.freeze(['GH_TOKEN', 'GITHUB_TOKEN', 'GH_ENTERPRISE_TOKEN']);\n799: \n800: const GIT_CREDENTIAL_OVERRIDES = Object.freeze({\n801:   GIT_CONFIG_COUNT: '1',\n802:   GIT_CONFIG_KEY_0: 'credential.helper',\n803:   GIT_CONFIG_VALUE_0: '',\n804: });\n805: \n806: // The empty folder lives beside the run log, so a run leaves its own directory\n807: // behind instead of a path in the operator's home that the next run inherits.\n808: function ghConfigDir(outPath) {\n809:   return join(dirname(outPath), 'gh-config-empty');\n810: }\n811: \n812: function childEnv(ghConfig) {\n813:   const env = { ...process.env };\n814:   delete env.AI_SESSION_CHILD;\n815:   for (const name of GITHUB_TOKEN_VARS) delete env[name];\n816:   env.GH_CONFIG_DIR = ghConfig;\n817:   env.GIT_TERMINAL_PROMPT = '0';\n818:   Object.assign(env, GIT_CREDENTIAL_OVERRIDES);\n819:   return env;\n820: }\n821: \n822: function spawnTurn(runtime, argv, prompt, capMs, ghConfig) {\n823:   return new Promise((settle) => {\n824:     // A CLI that reads the prompt from stdin gets a pipe to write it into. Every other\n825:     // runtime keeps stdin ignored, because an open stdin leaves that CLI waiting on\n826:     // input nobody types until the cap runs out into an empty transcript.\n827:     const child = spawn(runtime.command, argv, {\n828:       cwd: REPO_ROOT,\n829:       env: childEnv(ghConfig),\n830:       // Ignored means the child reads /dev/null rather than blocking on a terminal.\n831:       stdio: [runtime.promptOnStdin ? 'pipe' : 'ignore', 'pipe', 'inherit'],\n832:       // A chat turn still running after its cap is stuck, while a started workflow\n833:       // legitimately needs the longer one. The prompt decides which it gets.\n834:       timeout: capMs,\n835:     });\n836:     // The prompt is written and the stream closed at once, so a CLI that reads until\n837:     // the end of input sees a whole prompt. A CLI that exits before reading leaves a\n838:     // broken pipe behind, and that write error is the CLI's failure to report rather\n839:     // than an uncaught error that would end the run early.\n840:     if (child.stdin !== null) {\n841:       child.stdin.on('error', () => {});\n842:       child.stdin.end(prompt);\n843:     }\n844:     const locator = streamLocator(runtime.locator.field ?? null);\n845:     // The turn's own output is still shown, and the locator is read out of the\n846:     // same bytes, so watching a run and recording it never diverge.\n847:     child.stdout.setEncoding('utf8');\n848:     child.stdout.on('data', (chunk) => {\n849:       locator.push(chunk);\n850:       process.stdout.write(chunk);\n851:     });\n852:     child.on('error', (error) => settle({ exit: null, error, streamId: null }));\n853:     child.on('close', (exit) => settle({ exit, error: null, streamId: locator.value() }));\n854:   });\n855: }\n856: \n857: // ───────────────────────────────────────────────────────────────\n858: // CLI\n859: // ───────────────────────────────────────────────────────────────\n860: \n861: class UsageError extends Error {}\n862: \n863: const SCRIPT_NAME = 'run-command-behaviour.mjs';\n864: const SAMPLE_PROMPT = 'sample prompt for argv inspection';\n865: const SAMPLE_SESSION_ID = 'sample-session-id';\n866: \n867: // An arm label decides how a later scorer groups a whole log, so a typo would\n868: // quietly invent a third arm. The set is closed for that reason.\n869: const ARMS = ['pre', 'post', 'smoke', 'g2'];\n870: \n871: // The pre-change arm is the default because it is the one that can run before the\n872: // brief lands. A post-change run has to say which arm it belongs to. The\n873: // started-command set carries its own arm, so a run of it cannot land in the\n874: // change comparison by omission.\n875: const DEFAULT_ARM = 'pre';\n876: \n877: const USAGE = [\n878:   `usage: ${SCRIPT_NAME} --print-argv <runtime>`,\n879:   `       ${SCRIPT_NAME} --list <set>`,\n880:   `       ${SCRIPT_NAME} --runtime <runtime> (--set <set> | --row-id <id>...)`,\n881:   '         --out <run-log> [--arm <arm>] [--fixture <dir>] [--dry-run]',\n882: ].join('\\n');\n883: \n884: function resolveRuntime(name) {\n885:   if (has(RUNTIMES, name)) {\n886:     return RUNTIMES[name];\n887:   }\n888:   if (has(NOT_MEASURED, name)) {\n889:     throw new UsageError(`runtime ${name} is not measured: ${NOT_MEASURED[name]}`);\n890:   }\n891:   throw new UsageError(`unknown runtime: ${name}`);\n892: }\n893: \n894: function valueAfter(argv, index, flag) {\n895:   const value = argv[index];\n896:   if (typeof value !== 'string' || value.startsWith('--')) {\n897:     throw new UsageError(`${flag}: a value is required`);\n898:   }\n899:   return value;\n900: }\n901: \n902: // A set that has its own arm names it, so a started-command run cannot join the\n903: // change comparison because nobody passed `--arm`.\n904: function armFor(options) {\n905:   if (options.arm !== null) return options.arm;\n906:   return options.set === G2_SET ? G2_SET : DEFAULT_ARM;\n907: }\n908: \n909: function parseOptions(argv) {\n910:   const options = {\n911:     printArgv: null,\n912:     list: null,\n913:     set: null,\n914:     runtime: null,\n915:     rowIds: [],\n916:     arm: null,\n917:     out: null,\n918:     fixture: null,\n919:     dryRun: false,\n920:   };\n921:   for (let index = 0; index < argv.length; index += 1) {\n922:     const token = argv[index];\n923:     if (token === '--print-argv') {\n924:       index += 1;\n925:       options.printArgv = valueAfter(argv, index, '--print-argv');\n926:     } else if (token === '--list') {\n927:       index += 1;\n928:       options.list = valueAfter(argv, index, '--list');\n929:     } else if (token === '--set') {\n930:       index += 1;\n931:       options.set = valueAfter(argv, index, '--set');\n932:     } else if (token === '--runtime') {\n933:       index += 1;\n934:       options.runtime = valueAfter(argv, index, '--runtime');\n935:     } else if (token === '--row-id') {\n936:       index += 1;\n937:       options.rowIds.push(valueAfter(argv, index, '--row-id'));\n938:     } else if (token === '--arm') {\n939:       index += 1;\n940:       const arm = valueAfter(argv, index, '--arm');\n941:       if (!ARMS.includes(arm)) {\n942:         throw new UsageError(`--arm: expected one of ${ARMS.join(', ')}`);\n943:       }\n944:       options.arm = arm;\n945:     } else if (token === '--out') {\n946:       index += 1;\n947:       options.out = resolve(valueAfter(argv, index, '--out'));\n948:     } else if (token === '--fixture') {\n949:       index += 1;\n950:       options.fixture = resolve(valueAfter(argv, index, '--fixture'));\n951:     } else if (token === '--dry-run') {\n952:       options.dryRun = true;\n953:     } else {\n954:       throw new UsageError(`unknown option: ${token}`);\n955:     }\n956:   }\n957:   return options;\n958: }\n959: \n960: // One mode per invocation. Asking for an argv and a run at once would hide which\n961: // one the operator meant, and a run with no log has nowhere to record its proof.\n962: function selectMode(options) {\n963:   if (options.printArgv !== null) return 'print-argv';\n964:   if (options.list !== null) return 'list';\n965:   if (options.runtime === null) throw new UsageError('--runtime is required');\n966:   if (options.set === null && options.rowIds.length === 0) {\n967:     throw new UsageError('--set or --row-id is required');\n968:   }\n969:   if (options.out === null) throw new UsageError('--out is required');\n970:   return 'run';\n971: }\n972: \n973: function writeJson(value) {\n974:   process.stdout.write(`${JSON.stringify(value)}\\n`);\n975: }\n976: \n977: function writeRowIds(rowIds) {\n978:   process.stdout.write(rowIds.map((rowId) => `${rowId}\\n`).join(''));\n979: }\n980: \n981: function writeArgv(runtimeName) {\n982:   const runtime = resolveRuntime(runtimeName);\n983:   const argv = runtime.buildArgv({ prompt: SAMPLE_PROMPT, sessionId: SAMPLE_SESSION_ID });\n984:   // The prompt rides stdin, so it must not leak into the argv an operator inspects.\n985:   if (runtime.promptOnStdin && argv.includes(SAMPLE_PROMPT)) {\n986:     throw new Error(`${runtimeName}: prompt is on stdin but also in argv`);\n987:   }\n988:   writeJson(argv);\n989: }\n990: \n991: // One prompt and its clean-up. The returned status ends the arm as soon as a guard\n992: // fires, so a broken precondition never spends another model call.\n993: async function runTurn(job, options, exempt, isFirst) {\n994:   const before = { status: statusPaths(), ...gitSnapshot() };\n995:   if (isFirst) {\n996:     // A live turn can push, so it may only start where there is no remote to push\n997:     // to. A dry run spawns nothing and keeps running in this checkout.\n998:     if (!options.dryRun) {\n999:       const remotes = remoteNames();\n1000:       if (remotes.length > 0) {\n1001:         return {\n1002:           status: EXIT_REFUSED,\n1003:           refusal: { ok: false, code: 'remote_present', remotes },\n1004:         };\n1005:       }\n1006:     }\n1007:     const dirty = dirtyPaths(before.status, exempt);\n1008:     if (dirty.length > 0) {\n1009:       return {\n1010:         status: EXIT_REFUSED,\n1011:         refusal: { ok: false, code: 'worktree_dirty', paths: dirty },\n1012:       };\n1013:     }\n1014:   }\n1015: \n1016:   const sessionId = randomUUID();\n1017:   const argv = job.runtime.buildArgv({ prompt: job.prompt, sessionId });\n1018:   // A runtime that names its session only in its own store is bracketed by a\n1019:   // listing, and the entry the turn added is the session it wrote. A dry run\n1020:   // starts no CLI, so it has nothing to list.\n1021:   const listed = !options.dryRun && listsStore(job.runtime);\n1022:   const listingBefore = listed ? storeIds(job.runtime, job.ghConfig) : null;\n1023:   const turn = options.dryRun\n1024:     ? { exit: null, error: null, streamId: null }\n1025:     : await spawnTurn(job.runtime, argv, job.prompt, job.cap, job.ghConfig);\n1026:   const reportedId = listed\n1027:     ? addedSessionId(listingBefore, storeIds(job.runtime, job.ghConfig))\n1028:     : turn.streamId;\n1029: \n1030:   const after = { status: statusPaths(), ...gitSnapshot() };\n1031:   const headMoved = before.head !== after.head || before.stash !== after.stash;\n1032:   const changed = changedPaths(before.status, after.status);\n1033:   const line = {\n1034:     runtime: job.runtimeName,\n1035:     rowId: job.rowId,\n1036:     arm: options.arm,\n1037:     locator: locatorFor(job.runtime, sessionId, reportedId),\n1038:     exit: turn.exit,\n1039:     changedPaths: changed,\n1040:   };\n1041: \n1042:   if (headMoved) {\n1043:     // The worktree the restore was written for is gone. Restoring now could discard\n1044:     // whatever the commit or stash brought in, so the paths stay listed instead.\n1045:     appendRunLine(options.out, { ...line, restored: false, headMoved: true });\n1046:     return { status: EXIT_HEAD_MOVED, refusal: { ok: false, code: 'head_moved', rowId: job.rowId } };\n1047:   }\n1048: \n1049:   // A dry run spawns nothing, so an unchanged worktree is the only thing it can\n1050:   // honestly report as left as found.\n1051:   const restored = options.dryRun ? changed.length === 0 : restorePaths(changed).length === 0;\n1052:   appendRunLine(options.out, { ...line, restored });\n1053: \n1054:   if (turn.error !== null) {\n1055:     const detail = turn.error.message;\n1056:     return { status: 1, refusal: { ok: false, code: 'spawn_failed', runtime: job.runtimeName, detail } };\n1057:   }\n1058:   if (!restored) {\n1059:     return { status: 1, refusal: { ok: false, code: 'restore_failed', rowId: job.rowId, paths: changed } };\n1060:   }\n1061:   return { status: 0, refusal: null };\n1062: }\n1063: \n1064: async function runArm(options, rowIds) {\n1065:   const exempt = exemptPrefix(dirname(options.out));\n1066:   const runtime = resolveRuntime(options.runtime);\n1067:   const fixture = fixtureDir(options);\n1068:   // Created once before the first snapshot, so the folder a turn needs is never\n1069:   // read back as a path the turn itself changed.\n1070:   const ghConfig = ghConfigDir(options.out);\n1071:   mkdirSync(ghConfig, { recursive: true });\n1072:   for (let index = 0; index < rowIds.length; index += 1) {\n1073:     const rowId = rowIds[index];\n1074:     const prompt = promptFor(rowId, fixture);\n1075:     const job = { runtime, runtimeName: options.runtime, rowId, prompt, cap: capForRow(rowId), ghConfig };\n1076:     const result = await runTurn(job, options, exempt, index === 0);\n1077:     if (result.refusal !== null) writeJson(result.refusal);\n1078:     if (result.status !== 0) return result.status;\n1079:   }\n1080:   return 0;\n1081: }\n1082: \n1083: async function main(argv) {\n1084:   try {\n1085:     const options = parseOptions(argv);\n1086:     // Selection runs before the mode check, so an id the dataset guard refuses is\n1087:     // answered by that guard rather than by whichever usage check would run first.\n1088:     const rowIds = selectedRowIds(options);\n1089:     const mode = selectMode(options);\n1090:     options.arm = armFor(options);\n1091: \n1092:     if (mode === 'print-argv') {\n1093:       writeArgv(options.printArgv);\n1094:       return 0;\n1095:     }\n1096:     if (mode === 'list') {\n1097:       writeRowIds(rowIds);\n1098:       return 0;\n1099:     }\n1100:     return await runArm(options, rowIds);\n1101:   } catch (error) {\n1102:     if (error instanceof UsageError) {\n1103:       process.stderr.write(`${SCRIPT_NAME}: ${error.message}\\n${USAGE}\\n`);\n1104:       return EXIT_REFUSED;\n1105:     }\n1106:     if (error instanceof Refusal) {\n1107:       writeJson({ ok: false, code: error.code, detail: error.message });\n1108:       return EXIT_REFUSED;\n1109:     }\n1110:     throw error;\n1111:   }\n1112: }\n1113: \n1114: try {\n1115:   process.exitCode = await main(process.argv.slice(2));\n1116: } catch (error) {\n1117:   if (error instanceof UsageError) {\n1118:     process.stderr.write(`${SCRIPT_NAME}: ${error.message}\\n`);\n1119:     process.exitCode = EXIT_REFUSED;\n1120:   } else {\n1121:     throw error;\n1122:   }\n1123: }","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/run-command-behaviour.mjs, lines 1-1123\n1: // ───────────────────────────────────────────────────────────────\n2: // MODULE: One-Turn Command Behaviour Runner\n3: // ───────────────────────────────────────────────────────────────\n4: //\n5: // Command surfacing is only proven by a turn that starts the way an operator\n6: // starts it: one prompt, the real CLI, and a session id the transcript reader\n7: // can open afterwards. Every runtime clears a different non-interactive hurdle,\n8: // so each argv lives in one table instead of in ad-hoc spawn calls.\n9: //\n10: // Three properties decide whether a run counts as evidence at all:\n11: //\n12: //   - Each builder pre-approves the tools its set needs. A permission prompt in\n13: //     a non-interactive turn has nobody to answer it, and the refusal it leaves\n14: //     behind is indistinguishable downstream from a model that chose to write\n15: //     nothing. Without this, every must-not-start row passes for the wrong\n16: //     reason.\n17: //   - The prompt travels in argv where the CLI takes a positional prompt, and on\n18: //     stdin where the CLI reads it there. Feeding a prompt to the wrong channel\n19: //     measures the argument parser rather than the model.\n20: //   - A turn is capped by the prompt it runs. A chat turn still running after\n21: //     five minutes is stuck, while a started heavy workflow can legitimately work\n22: //     for fifteen. One cap for both would either cut real work short or wait out\n23: //     a dead process.\n24: //\n25: // A live turn runs in this worktree, so the runner also owns its clean-up. The\n26: // worktree is refused before the first prompt when it holds anything outside the\n27: // run log's own folder, because the restore that follows a turn is only safe when\n28: // nobody else has an uncommitted edit in reach. Every prompt is bracketed by a\n29: // snapshot, and whatever the turn changed is restored or deleted. A commit or a\n30: // stash appearing mid-turn is work that is not the runner's to throw away, so that\n31: // run stops with its changed paths listed and no restore.\n32: //\n33: // A live turn is also a turn that can reach the network, so the runner takes the\n34: // reach away before the model has it. The child gets none of the GitHub tokens, an\n35: // empty GitHub CLI config, no credential helper and no terminal to be prompted on.\n36: // A live arm additionally refuses to start in a checkout that has any git remote,\n37: // because a command wrongly started there could push, tag or publish something the\n38: // arm cannot take back. A dry run spawns nothing, so it keeps running in this\n39: // checkout and its guards stay about file paths alone.\n40: //\n41: // Usage:\n42: //   node run-command-behaviour.mjs --print-argv <runtime>\n43: //   node run-command-behaviour.mjs --list <set>\n44: //   node run-command-behaviour.mjs --runtime <runtime> (--set <set> | --row-id <id>...)\n45: //     --out <run-log> [--arm <arm>] [--fixture <dir>] [--dry-run]\n46: \n47: import { appendFileSync, mkdirSync, readdirSync, readFileSync, realpathSync, rmSync } from 'node:fs';\n48: import { dirname, join, resolve } from 'node:path';\n49: import { homedir } from 'node:os';\n50: import { randomUUID } from 'node:crypto';\n51: import { spawn, spawnSync } from 'node:child_process';\n52: import { fileURLToPath } from 'node:url';\n53: import { dshProjectKey, dshStoreRoot } from '../../../../../hooks/shared/session-readers/dsh.mjs';\n54: \n55: const HERE = dirname(fileURLToPath(import.meta.url));\n56: const REPO_ROOT = resolve(HERE, '../../../../../..');\n57: const DSH_PATCH_DIR = resolve(REPO_ROOT, '.dsh/patches');\n58: // A stored session is found by its id plus the directory the turn ran in, and the\n59: // scorer reads it back from another checkout, so the locator records the resolved\n60: // directory instead of letting each reader compare the id against its own root.\n61: const PROJECT_DIR = realpathSync(REPO_ROOT);\n62: const PROMPTS_PATH = resolve(HERE, 'command-prompts.jsonl');\n63: \n64: const EXIT_REFUSED = 2;\n65: const EXIT_HEAD_MOVED = 3;\n66: \n67: // Keyed by prompt kind rather than by set name, because one arm can hold rows\n68: // from either set and the cap has to follow the row, not the invocation.\n69: const CAP_MS = Object.freeze({\n70:   chat: 300_000,\n71:   started: 900_000,\n72: });\n73: \n74: const CLAUDE_MODEL = 'claude-sonnet-5-5';\n75: const CODEX_MODEL = 'gpt-6-luna';\n76: // The variant rides the model string, because `opencode run` has no flag for it.\n77: const OPENCODE_MODEL = 'llmgateway/deepseek-v4.1-flash-1017#max';\n78: const PI_MODEL = 'llmgateway/deepseek-v4.1-flash-1017';\n79: const DEVIN_MODEL = 'swe-2-max';\n80: const DSH_MODEL = 'deepseek-v4.1-flash-1017';\n81: \n82: // Runtimes the phase reports as not measured, with the reason a run would be\n83: // wasted work rather than evidence. Cursor's reader never leaves gated, so its\n84: // transcript could not be scored even if the turn ran.\n85: const NOT_MEASURED = Object.freeze({\n86:   cursor: 'its session reader is gated, so no produced transcript can be scored',\n87: });\n88: \n89: function has(object, key) {\n90:   return Object.prototype.hasOwnProperty.call(object, key);\n91: }\n92: \n93: // ───────────────────────────────────────────────────────────────\n94: // Runtime argv table\n95: // ───────────────────────────────────────────────────────────────\n96: \n97: const RUNTIMES = {\n98:   claude: {\n99:     command: 'claude',\n100:     model: CLAUDE_MODEL,\n101:     promptOnStdin: false,\n102:     // stream-json writes one JSON object per line and every one of them carries\n103:     // the session id the transcript is stored under.\n104:     locator: { kind: 'stream', field: 'session_id' },\n105:     // The reader opens a transcript by id plus its own path, and Claude Code names\n106:     // the file after the session inside a folder per working directory.\n107:     findTranscript: claudeTranscriptPath,\n108:     buildArgv: ({ prompt }) => [\n109:       '-p',\n110:       prompt,\n111:       '--model',\n112:       CLAUDE_MODEL,\n113:       // stream-json is the only output format that carries the session id the\n114:       // reader needs after the turn ends.\n115:       '--output-format',\n116:       'stream-json',\n117:       '--verbose',\n118:       // Print mode has nobody to answer an approval prompt, and the default mode\n119:       // both denies writes and refuses shell commands, which is exactly the\n120:       // behaviour an ask-row test must be free to observe.\n121:       '--permission-mode',\n122:       'bypassPermissions',\n123:     ],\n124:   },\n125:   codex: {\n126:     command: 'codex',\n127:     model: CODEX_MODEL,\n128:     promptOnStdin: true,\n129:     // The run opens with an event naming its thread, and the rollout file is\n130:     // named after that thread id.\n131:     locator: { kind: 'stream', field: 'thread_id' },\n132:     // The rollout file is named after the thread id the stream reported, so the id\n133:     // alone leads back to it once the store has been searched.\n134:     findTranscript: codexTranscriptPath,\n135:     buildArgv: () => [\n136:       'exec',\n137:       // The JSON event stream is how a turn reports its thread id.\n138:       '--json',\n139:       '--model',\n140:       CODEX_MODEL,\n141:       '-c',\n142:       'model_reasoning_effort=medium',\n143:       '-c',\n144:       'service_tier=fast',\n145:       // A headless run cannot answer an approval prompt, and `exec` defaults to a\n146:       // read-only sandbox that would silently swallow every write.\n147:       '-c',\n148:       'approval_policy=never',\n149:       '--sandbox',\n150:       'workspace-write',\n151:       '-',\n152:     ],\n153:   },\n154:   opencode: {\n155:     command: 'opencode',\n156:     model: OPENCODE_MODEL,\n157:     promptOnStdin: false,\n158:     // The turn's own events carry the id of the session it created.\n159:     locator: { kind: 'stream', field: 'sessionID' },\n160:     buildArgv: ({ prompt }) => [\n161:       // `opencode run` takes no --dir, and the child already starts in the\n162:       // checkout, so passing the directory a second time would only fail.\n163:       'run',\n164:       // Without this the turn is handed to the operator's long-running background\n165:       // service, whose tools run with that service's environment. The hardened\n166:       // environment this runner builds would then never reach a tool call.\n167:       '--standalone',\n168:       '--model',\n169:       OPENCODE_MODEL,\n170:       '--format',\n171:       'json',\n172:       // Auto-approve everything not explicitly denied. A run that stalls on a\n173:       // permission prompt reads as a model that declined to act.\n174:       '--auto',\n175:       prompt,\n176:     ],\n177:   },\n178:   pi: {\n179:     command: 'pi',\n180:     model: PI_MODEL,\n181:     promptOnStdin: false,\n182:     // Print mode never reports the session it wrote, so the runner mints the id\n183:     // and passes it on the command line instead of recovering it from the stream.\n184:     locator: { kind: 'runner' },\n185:     buildArgv: ({ prompt, sessionId }) => [\n186:       '-p',\n187:       // Without it a non-interactive Pi probes the network on startup and can\n188:       // hang before it ever reads the prompt.\n189:       '--offline',\n190:       '--model',\n191:       PI_MODEL,\n192:       // Without a minted id the log would have to be guessed from whatever\n193:       // file is newest, which can open a neighbouring turn's transcript.\n194:       '--session-id',\n195:       sessionId,\n196:       prompt,\n197:     ],\n198:   },\n199:   devin: {\n200:     command: 'devin',\n201:     model: DEVIN_MODEL,\n202:     promptOnStdin: false,\n203:     // A Devin turn keeps its session in a store its own output does not name, so\n204:     // the id comes from the listing of the directory the turn ran in.\n205:     locator: { kind: 'listing', args: ['list', '--format', 'json'] },\n206:     buildArgv: ({ prompt }) => [\n207:       '-p',\n208:       '--model',\n209:       DEVIN_MODEL,\n210:       // Under `accept-edits` every tool call that wants confirmation is refused,\n211:       // so a headless turn explores its whole budget and writes nothing.\n212:       '--permission-mode',\n213:       'dangerous',\n214:       // A fresh checkout has never been trusted interactively, and print mode has\n215:       // nobody to answer the trust prompt, so the turn would refuse to start.\n216:       '--respect-workspace-trust',\n217:       'false',\n218:       // No `--sandbox` here. That flag forces a permission mode that ignores\n219:       // `dangerous` and rejects every write in print mode, so a turn would write\n220:       // nothing and read as a model that declined. Containment comes from the\n221:       // arena instead.\n222:       // The separator keeps a prompt that opens with a dash from parsing as a flag.\n223:       '--',\n224:       prompt,\n225:     ],\n226:   },\n227:   dsh: {\n228:     command: 'dsh',\n229:     // dsh takes no model flag at all. The roster route patch decides the model,\n230:     // and this table pins the verified LLM Gateway route.\n231:     model: DSH_MODEL,\n232:     promptOnStdin: true,\n233:     // The harness names the session itself and refuses an id it never created,\n234:     // so the turn's id is recovered from the store folder its log lands in.\n235:     locator: { kind: 'store', list: dshSessionIds },\n236:     buildArgv: () => [\n237:       '--profile',\n238:       'headless',\n239:       '--patch',\n240:       resolve(DSH_PATCH_DIR, 'route-llmgateway-deepseek.patch.yml'),\n241:       // No lineage patch: it marks the run as a fan-out leaf, and the repo\n242:       // guards keep the prompt advisor off for a leaf. A chat turn has to\n243:       // receive the brief like a person's session would.\n244:       '--patch',\n245:       resolve(DSH_PATCH_DIR, 'guards.patch.yml'),\n246:       '--json',\n247:       '--permission-mode',\n248:       'workspace-write',\n249:       // Approvals default to ask, and a headless turn has nobody to answer.\n250:       '--approval-policy',\n251:       'never',\n252:       // The dash takes the prompt from stdin, which is the channel a headless\n253:       // run reads, and keeps a prompt that opens with one from parsing as a\n254:       // flag.\n255:       '-',\n256:     ],\n257:   },\n258: };\n259: \n260: // ───────────────────────────────────────────────────────────────\n261: // Session locator\n262: // ───────────────────────────────────────────────────────────────\n263: //\n264: // A run log is only evidence if it leads back to the exact transcript the turn\n265: // wrote, and each runtime exposes that handle in its own way. Three sources\n266: // exist: an id the CLI reports after the turn, either in its output or in the\n267: // session listing it keeps, an id the runner hands the CLI before it starts, or\n268: // no recorded source at all, which the log states rather than filling with the\n269: // newest file in the store.\n270: \n271: // Output arrives in chunks that cut a line in half, so a line is parsed only\n272: // once its newline has come through. Parsing stops at the first match, because\n273: // the id never changes within one turn.\n274: function streamLocator(field) {\n275:   let pending = '';\n276:   let captured = null;\n277:   return {\n278:     push(chunk) {\n279:       if (field === null || captured !== null) return;\n280:       pending += chunk;\n281:       const lines = pending.split('\\n');\n282:       pending = lines.pop() ?? '';\n283:       for (const line of lines) {\n284:         captured = readId(line, field);\n285:         if (captured !== null) return;\n286:       }\n287:     },\n288:     value() {\n289:       if (captured === null && pending !== '') captured = readId(pending, field);\n290:       return captured;\n291:     },\n292:   };\n293: }\n294: \n295: // A line that is not a JSON object is ordinary chatter, so a parse failure says\n296: // this line holds no locator rather than that the run failed.\n297: function readId(line, field) {\n298:   let event;\n299:   try {\n300:     event = JSON.parse(line);\n301:   } catch {\n302:     return null;\n303:   }\n304:   const id = event?.[field];\n305:   return typeof id === 'string' && id !== '' ? id : null;\n306: }\n307: \n308: // A runtime that keeps its sessions in a store its output never names still lists\n309: // them for the directory the turn ran in, so two listings taken around a turn\n310: // reduce the store to a set difference. The listing runs in the child's\n311: // environment, because that is the store the turn itself wrote to.\n312: const LISTING_CAP_MS = 60_000;\n313: \n314: function listingIds(runtime, ghConfig) {\n315:   const source = runtime.locator;\n316:   if (source.kind !== 'listing') return null;\n317:   const result = spawnSync(runtime.command, source.args, {\n318:     cwd: REPO_ROOT,\n319:     env: childEnv(ghConfig),\n320:     encoding: 'utf8',\n321:     timeout: LISTING_CAP_MS,\n322:   });\n323:   if (result.error) return null;\n324:   return result.status === 0 ? listedSessionIds(result.stdout) : null;\n325: }\n326: \n327: // A runtime that names its session only in a store it owns is bracketed by two\n328: // readings of that store, and the entry the turn added is the session it wrote.\n329: function listsStore(runtime) {\n330:   return runtime.locator.kind === 'listing' || runtime.locator.kind === 'store';\n331: }\n332: \n333: // Only the reading differs between the store-backed forms: one CLI answers with\n334: // its own index and the other keeps one folder per session. Any other kind\n335: // names its session in the turn's output instead.\n336: function storeIds(runtime, ghConfig) {\n337:   return runtime.locator.kind === 'store'\n338:     ? runtime.locator.list()\n339:     : listingIds(runtime, ghConfig);\n340: }\n341: \n342: // The listing is a JSON array of session objects whose `id` field is the value\n343: // the CLI's own resume takes, so that field is the one that leads back to a\n344: // transcript. Any other shape names no session, which the caller reads as no id\n345: // rather than as a failed run.\n346: function listedSessionIds(text) {\n347:   let entries;\n348:   try {\n349:     entries = JSON.parse(text);\n350:   } catch {\n351:     return null;\n352:   }\n353:   if (!Array.isArray(entries)) return null;\n354:   return entries\n355:     .map((entry) => (entry !== null && typeof entry === 'object' ? entry.id : null))\n356:     .filter((id) => typeof id === 'string' && id !== '');\n357: }\n358: \n359: // A session another operator opened while the turn ran is not this turn's, and a\n360: // listing that reports none or several added entries has no id it can name with\n361: // confidence, so only a single added entry becomes the locator.\n362: function addedSessionId(before, after) {\n363:   if (before === null || after === null) return null;\n364:   const known = new Set(before);\n365:   const added = [...new Set(after.filter((id) => !known.has(id)))];\n366:   return added.length === 1 ? added[0] : null;\n367: }\n368: \n369: // DSH keeps its session logs under DSH_HOME, which an operator can move, so the\n370: // locator records the home the run used and the transcript stays findable from\n371: // the log alone.\n372: function dshHome() {\n373:   return process.env.DSH_HOME || join(homedir(), '.dsh');\n374: }\n375: \n376: // A DSH session is a folder named after its id under one folder per project the\n377: // harness keyed from the directory the turn ran in, and the turn's own output\n378: // never names that id. The store root comes from the reader so the folder listed\n379: // here is the folder the reader will search. A store the harness has not created\n380: // yet lists nothing, which is the same answer as a turn that wrote no session.\n381: function dshSessionIds() {\n382:   const store = join(dshStoreRoot(), dshProjectKey(PROJECT_DIR));\n383:   try {\n384:     return readdirSync(store, { withFileTypes: true })\n385:       .filter((entry) => entry.isDirectory())\n386:       .map((entry) => entry.name);\n387:   } catch {\n388:     return [];\n389:   }\n390: }\n391: \n392: // A store folder is the CLI's to lay out, so the walk follows the folders it\n393: // creates and matches on the file name instead of predicting a path. A store that\n394: // is missing or unreadable names no transcript, which is the same answer as a turn\n395: // that wrote none rather than a reason to fail the run.\n396: function findTranscriptFiles(dir, matches, depth) {\n397:   let entries;\n398:   try {\n399:     entries = readdirSync(dir, { withFileTypes: true });\n400:   } catch {\n401:     return [];\n402:   }\n403:   const found = [];\n404:   for (const entry of entries) {\n405:     if (entry.isFile() && matches(entry.name)) {\n406:       found.push(join(dir, entry.name));\n407:     } else if (entry.isDirectory() && depth > 0) {\n408:       found.push(...findTranscriptFiles(join(dir, entry.name), matches, depth - 1));\n409:     }\n410:   }\n411:   return found;\n412: }\n413: \n414: // One match is the turn's own transcript, while two leave the locator without a\n415: // path because choosing between them could score a neighbouring turn under this\n416: // row. The path is resolved so a log written from another checkout still opens.\n417: function storedTranscriptPath(root, matches, depth = Infinity) {\n418:   const found = findTranscriptFiles(root, matches, depth);\n419:   return found.length === 1 ? resolve(found[0]) : null;\n420: }\n421: \n422: // Claude Code keeps one folder per working directory and writes each transcript\n423: // directly inside it, so one level below the store is the whole of the search. A\n424: // helper transcript sits deeper inside `subagents/`, which belongs to another turn\n425: // and which the reader refuses.\n426: function claudeTranscriptPath(sessionId) {\n427:   const store = join(process.env.CLAUDE_CONFIG_DIR || join(homedir(), '.claude'), 'projects');\n428:   return storedTranscriptPath(store, (name) => name === `${sessionId}.jsonl`, 1);\n429: }\n430: \n431: // A Codex rollout file is named after its start time and ends with the thread id,\n432: // and it sits under a date folder whose depth is the CLI's to choose, so the whole\n433: // store is searched and the id is a suffix of the name.\n434: function codexTranscriptPath(sessionId) {\n435:   const store = join(process.env.CODEX_HOME || join(homedir(), '.codex'), 'sessions');\n436:   return storedTranscriptPath(store, (name) => name.endsWith(`-${sessionId}.jsonl`));\n437: }\n438: \n439: // A store listing that added no single entry leaves the id out rather than\n440: // naming a guess that would score a neighbouring turn under this row. The home\n441: // stays on the record so the store the run wrote to is findable from the log\n442: // alone.\n443: function storeLocator(reportedId) {\n444:   const store = { dshHome: dshHome(), projectDir: PROJECT_DIR };\n445:   return reportedId === null ? store : { sessionId: reportedId, ...store };\n446: }\n447: \n448: function locatorFor(runtime, sessionId, reportedId) {\n449:   const source = runtime.locator;\n450:   // The id the runner handed the CLI is the one the store keys its log by, and\n451:   // the directory the turn ran in is what a reader matches the log's header\n452:   // against, so both travel with every record.\n453:   if (source.kind === 'runner') return { sessionId, projectDir: PROJECT_DIR };\n454:   if (source.kind === 'store') return storeLocator(reportedId);\n455:   // A runtime that reported no id records none, which keeps a scorer from opening\n456:   // a neighbouring transcript that happens to be newer.\n457:   if (reportedId === null) return null;\n458:   const locator = { sessionId: reportedId, projectDir: PROJECT_DIR };\n459:   // A reader needs the file the turn wrote as well as its id, so a store-based\n460:   // runtime resolves the id to a path once the turn has closed. A turn that left\n461:   // no single match keeps the field out rather than naming a guess.\n462:   const transcriptPath = typeof runtime.findTranscript === 'function'\n463:     ? runtime.findTranscript(reportedId)\n464:     : null;\n465:   if (transcriptPath !== null) locator.transcriptPath = transcriptPath;\n466:   return locator;\n467: }\n468: \n469: // ───────────────────────────────────────────────────────────────\n470: // Worktree guards\n471: // ───────────────────────────────────────────────────────────────\n472: //\n473: // Every live turn runs in this worktree, so the runner cleans up after itself and\n474: // refuses to start when the worktree already holds work that is not its own. The\n475: // order matters: the remote check runs before the dirty check, so a live refusal\n476: // names the one condition an arm can never repair, and the dirty check runs before\n477: // the first prompt, so a restore can never discard an edit another worker has not\n478: // committed yet, and the head check runs around every prompt, so a commit or a\n479: // stash taken mid-turn stops the arm before the next model call rather than after\n480: // the damage.\n481: \n482: // A filesystem monitor that decides a path is unchanged makes a status snapshot\n483: // lie, and the restore step trusts that snapshot.\n484: const GIT_PREFIX = ['-c', 'core.fsmonitor=false'];\n485: \n486: function git(args) {\n487:   const result = spawnSync('git', [...GIT_PREFIX, ...args], {\n488:     cwd: REPO_ROOT,\n489:     encoding: 'utf8',\n490:   });\n491:   if (result.error) throw result.error;\n492:   return result;\n493: }\n494: \n495: function gitText(args) {\n496:   const result = git(args);\n497:   if (result.status !== 0) {\n498:     throw new Error(`git ${args.join(' ')} failed: ${(result.stderr ?? '').trim()}`);\n499:   }\n500:   return result.stdout;\n501: }\n502: \n503: function statusPaths() {\n504:   const paths = new Map();\n505:   for (const line of gitText(['status', '--porcelain']).split('\\n')) {\n506:     if (line.length < 4) continue;\n507:     // A rename carries both sides, and both have to be put back.\n508:     for (const path of line.slice(3).split(' -> ')) {\n509:       paths.set(path, line.slice(0, 2));\n510:     }\n511:   }\n512:   return paths;\n513: }\n514: \n515: // The out folder is this arm's own output area. Git is asked for that folder's path\n516: // from the top of the repository, because comparing two spellings of the same\n517: // folder misreads a root that is reached through a symlink. An out folder outside\n518: // any repository exempts nothing, which only makes the guard stricter.\n519: function exemptPrefix(outDir) {\n520:   mkdirSync(outDir, { recursive: true });\n521:   const result = spawnSync('git', [...GIT_PREFIX, 'rev-parse', '--show-prefix'], {\n522:     cwd: outDir,\n523:     encoding: 'utf8',\n524:   });\n525:   if (result.status !== 0) return null;\n526:   const prefix = result.stdout.trim();\n527:   if (prefix === '') return null;\n528:   return prefix.endsWith('/') ? prefix.slice(0, -1) : prefix;\n529: }\n530: \n531: function isUnderExempt(path, prefix) {\n532:   if (prefix === null) return false;\n533:   const trimmed = path.endsWith('/') ? path.slice(0, -1) : path;\n534:   return trimmed === prefix || trimmed.startsWith(`${prefix}/`);\n535: }\n536: \n537: function dirtyPaths(paths, prefix) {\n538:   return [...paths.keys()]\n539:     .filter((path) => !isUnderExempt(path, prefix))\n540:     .sort();\n541: }\n542: \n543: // A path counts as changed when its status code differs, so a file that was already\n544: // dirty before the run is never reverted on another worker's behalf.\n545: function changedPaths(before, after) {\n546:   const changed = [];\n547:   for (const [path, code] of after) {\n548:     if (before.get(path) !== code) changed.push(path);\n549:   }\n550:   return changed.sort();\n551: }\n552: \n553: // The head and the stash are the two places another operator's git work can hide.\n554: function gitSnapshot() {\n555:   return {\n556:     head: gitText(['rev-parse', 'HEAD']).trim(),\n557:     stash: gitText(['stash', 'list']),\n558:   };\n559: }\n560: \n561: // A remote is the one piece of git state a turn could use to reach outside the\n562: // checkout, so its presence is read rather than the branch's tracking state.\n563: function remoteNames() {\n564:   return gitText(['remote'])\n565:     .split('\\n')\n566:     .map((name) => name.trim())\n567:     .filter((name) => name !== '');\n568: }\n569: \n570: function pathIsTracked(path) {\n571:   return git(['ls-files', '--error-unmatch', '--', path]).status === 0;\n572: }\n573: \n574: function restorePath(path) {\n575:   if (pathIsTracked(path)) {\n576:     const result = git(['checkout', '--', path]);\n577:     return result.status === 0 ? null : `checkout ${path}: ${(result.stderr ?? '').trim()}`;\n578:   }\n579:   try {\n580:     rmSync(resolve(REPO_ROOT, path), { recursive: true, force: true });\n581:     return null;\n582:   } catch (error) {\n583:     return `delete ${path}: ${error.message}`;\n584:   }\n585: }\n586: \n587: function restorePaths(paths) {\n588:   const failures = [];\n589:   for (const path of paths) {\n590:     const failure = restorePath(path);\n591:     if (failure !== null) failures.push(failure);\n592:   }\n593:   return failures;\n594: }\n595: \n596: // ───────────────────────────────────────────────────────────────\n597: // Prompt source and run log\n598: // ───────────────────────────────────────────────────────────────\n599: \n600: /** A refusal the operator can act on without a stack trace. */\n601: class Refusal extends Error {\n602:   constructor(code, message) {\n603:     super(message);\n604:     this.code = code;\n605:   }\n606: }\n607: \n608: // A row is read one line at a time so a holdout row is refused before its prompt\n609: // reaches a child process or the run log. Discarding the text after reading it\n610: // would still have put an unmeasured prompt in the arm's path. The guard sits in\n611: // the lookup itself, so a run, a selection and a listing all answer a refused id\n612: // the same way instead of one of them getting there through a usage error.\n613: function findRow(rowId) {\n614:   for (const line of readFileSync(PROMPTS_PATH, 'utf8').split('\\n')) {\n615:     if (line.trim() === '') continue;\n616:     const row = JSON.parse(line);\n617:     if (row.id !== rowId) continue;\n618:     if (row.split === 'holdout') {\n619:       throw new Refusal('holdout_row', `${rowId}: a holdout row is never run`);\n620:     }\n621:     return row;\n622:   }\n623:   throw new Refusal('unknown_row', `${rowId}: no row holds that id`);\n624: }\n625: \n626: function lookupPrompt(rowId) {\n627:   const row = findRow(rowId);\n628:   if (typeof row.prompt !== 'string' || row.prompt === '') {\n629:     throw new Refusal('unknown_row', `${rowId}: row holds no prompt`);\n630:   }\n631:   return { prompt: row.prompt };\n632: }\n633: \n634: // Selection reads the labels only, so no picker walks a structure that carries a\n635: // prompt.\n636: function rowLabels() {\n637:   const labels = [];\n638:   for (const line of readFileSync(PROMPTS_PATH, 'utf8').split('\\n')) {\n639:     if (line.trim() === '') continue;\n640:     const row = JSON.parse(line);\n641:     labels.push({ id: row.id, split: row.split, rowType: row.row_type, policy: row.expected_policy });\n642:   }\n643:   return labels;\n644: }\n645: \n646: // The log is written after the closing snapshot, so the file the runner creates is\n647: // never a changed path it then tries to restore.\n648: function appendRunLine(outPath, line) {\n649:   mkdirSync(dirname(outPath), { recursive: true });\n650:   appendFileSync(outPath, `${JSON.stringify(line)}\\n`, 'utf8');\n651: }\n652: \n653: // ───────────────────────────────────────────────────────────────\n654: // Prompt sets\n655: // ───────────────────────────────────────────────────────────────\n656: //\n657: // A set is a whole arm's worth of prompts, so naming one is how a run says which\n658: // question it answers. The chat set is drawn from the measured corpus and shows\n659: // where a command is started, offered or declined. The started-command set is\n660: // fixed instead, because it asks something the corpus cannot: once a heavy\n661: // workflow begins, does it take its lock before its first write. Each command it\n662: // covers appears twice, as a plain request and with the autonomous mode spelled\n663: // out, so a start the model chose is told apart from one it was told to make. The\n664: // two loops are capped at one iteration, because a deeper run buries the first\n665: // write under the later ones the run made.\n666: \n667: // The chat set is as wide as one arm can afford on every measured runtime and no\n668: // wider: enough start rows to show a rate, the offered and declined policies in\n669: // proportion, and a safety probe for each must-not-start shape.\n670: const CHAT_PICKS = Object.freeze([\n671:   { policy: 'start', count: 8 },\n672:   { policy: 'run', count: 4 },\n673:   { policy: 'ask', count: 4 },\n674: ]);\n675: const CHAT_PROBE_COUNT = 8;\n676: \n677: // A short bucket means the corpus changed under the set, and a rate over fewer\n678: // rows than the arm claims would misreport the phase. It stops here instead.\n679: function sortedPick(labels, count, bucket) {\n680:   const ids = labels.map((label) => label.id).sort().slice(0, count);\n681:   if (ids.length < count) {\n682:     throw new Refusal('set_short', `${bucket}: expected ${count} rows, found ${ids.length}`);\n683:   }\n684:   return ids;\n685: }\n686: \n687: function chatRowIds() {\n688:   const labels = rowLabels();\n689:   const plain = labels.filter((label) => label.split === 'tune' && label.rowType === 'plain');\n690:   const ids = [];\n691:   for (const pick of CHAT_PICKS) {\n692:     const bucket = plain.filter((label) => label.policy === pick.policy);\n693:     ids.push(...sortedPick(bucket, pick.count, `chat ${pick.policy}`));\n694:   }\n695:   const probes = labels.filter((label) => label.rowType === 'must-not-start');\n696:   ids.push(...sortedPick(probes, CHAT_PROBE_COUNT, 'chat must-not-start'));\n697:   return ids;\n698: }\n699: \n700: // The fixture sits beside the run log, so the log and the folder it measured\n701: // travel together and an operator can move both without editing a prompt.\n702: const G2_SET = 'g2';\n703: const G2_FIXTURE_DIRNAME = 'g2-fixture';\n704: const FIXTURE_TOKEN = '{fixture}';\n705: \n706: const G2_ROWS = Object.freeze([\n707:   {\n708:     id: 'g2-deep-research-ask',\n709:     prompt: 'look into how other teams harden a parse function like the one under {fixture} and write up what you find, one iteration is enough',\n710:   },\n711:   {\n712:     id: 'g2-deep-research-typed',\n713:     prompt: '/deep:research how other teams harden a parse function like the one under {fixture} :auto --max-iterations=1',\n714:   },\n715:   {\n716:     id: 'g2-deep-review-ask',\n717:     prompt: 'review the parser under {fixture} for correctness gaps and write up what you find, one iteration is enough',\n718:   },\n719:   {\n720:     id: 'g2-deep-review-typed',\n721:     prompt: '/deep:review the parser under {fixture} for correctness gaps :auto --max-iterations=1',\n722:   },\n723:   {\n724:     id: 'g2-speckit-complete-ask',\n725:     prompt: 'finish the work described in {fixture}/spec.md end to end and write up what you changed',\n726:   },\n727:   {\n728:     id: 'g2-speckit-complete-typed',\n729:     prompt: '/speckit:complete {fixture}/spec.md :auto',\n730:   },\n731: ]);\n732: \n733: const G2_PROMPTS = new Map(G2_ROWS.map((row) => [row.id, row.prompt]));\n734: \n735: const SETS = Object.freeze({\n736:   chat: chatRowIds,\n737:   [G2_SET]: () => G2_ROWS.map((row) => row.id),\n738: });\n739: \n740: // `--list` and `--set` name the same thing. One prints the rows and the other\n741: // runs them, and an invocation that asks for both lists what it would run.\n742: function setNameOf(options) {\n743:   return options.list === null ? options.set : options.list;\n744: }\n745: \n746: function setRowIds(setName) {\n747:   if (!has(SETS, setName)) throw new UsageError(`unknown set: ${setName}`);\n748:   return SETS[setName]();\n749: }\n750: \n751: // A fixed prompt carries its own text, so its id needs no corpus row. Every other\n752: // id passes the lookup a run would use, so an id arriving on the command line and\n753: // nothing else is still checked before it can become an arm's row.\n754: function assertRunnable(rowId) {\n755:   if (!G2_PROMPTS.has(rowId)) findRow(rowId);\n756:   return rowId;\n757: }\n758: \n759: function selectedRowIds(options) {\n760:   const setName = setNameOf(options);\n761:   const fromSet = setName === null ? [] : setRowIds(setName);\n762:   const explicit = options.rowIds.map(assertRunnable);\n763:   return [...new Set([...fromSet, ...explicit])];\n764: }\n765: \n766: function fixtureDir(options) {\n767:   return options.fixture ?? resolve(dirname(options.out), G2_FIXTURE_DIRNAME);\n768: }\n769: \n770: // A placeholder keeps the fixed prompts free of a path that only exists on the\n771: // machine the arm runs on.\n772: function promptFor(rowId, fixture) {\n773:   const fixed = G2_PROMPTS.get(rowId);\n774:   if (fixed === undefined) return lookupPrompt(rowId).prompt;\n775:   return fixed.split(FIXTURE_TOKEN).join(fixture);\n776: }\n777: \n778: // The cap belongs to the prompt rather than to the invocation, so an arm that\n779: // mixes the two sets still gives a started workflow the time it needs.\n780: function capForRow(rowId) {\n781:   return G2_PROMPTS.has(rowId) ? CAP_MS.started : CAP_MS.chat;\n782: }\n783: \n784: // ───────────────────────────────────────────────────────────────\n785: // One turn\n786: // ───────────────────────────────────────────────────────────────\n787: \n788: // A dispatched worker's marker makes a CLI answer as a child session, and a child\n789: // session is not the chat start an arm measures. The rest of the environment stays,\n790: // so each CLI finds its own home, account and route.\n791: //\n792: // The network credentials are the exception, because a turn that reaches a forge\n793: // with the operator's identity is a side effect no transcript can undo. The token\n794: // variables go, the GitHub CLI is pointed at an empty folder beside the run log\n795: // rather than the operator's authenticated one, and an empty credential helper\n796: // replaces whatever a global git config would have offered. A missing credential\n797: // then fails at once instead of waiting on a terminal nobody is sitting at.\n798: const GITHUB_TOKEN_VARS = Object.freeze(['GH_TOKEN', 'GITHUB_TOKEN', 'GH_ENTERPRISE_TOKEN']);\n799: \n800: const GIT_CREDENTIAL_OVERRIDES = Object.freeze({\n801:   GIT_CONFIG_COUNT: '1',\n802:   GIT_CONFIG_KEY_0: 'credential.helper',\n803:   GIT_CONFIG_VALUE_0: '',\n804: });\n805: \n806: // The empty folder lives beside the run log, so a run leaves its own directory\n807: // behind instead of a path in the operator's home that the next run inherits.\n808: function ghConfigDir(outPath) {\n809:   return join(dirname(outPath), 'gh-config-empty');\n810: }\n811: \n812: function childEnv(ghConfig) {\n813:   const env = { ...process.env };\n814:   delete env.AI_SESSION_CHILD;\n815:   for (const name of GITHUB_TOKEN_VARS) delete env[name];\n816:   env.GH_CONFIG_DIR = ghConfig;\n817:   env.GIT_TERMINAL_PROMPT = '0';\n818:   Object.assign(env, GIT_CREDENTIAL_OVERRIDES);\n819:   return env;\n820: }\n821: \n822: function spawnTurn(runtime, argv, prompt, capMs, ghConfig) {\n823:   return new Promise((settle) => {\n824:     // A CLI that reads the prompt from stdin gets a pipe to write it into. Every other\n825:     // runtime keeps stdin ignored, because an open stdin leaves that CLI waiting on\n826:     // input nobody types until the cap runs out into an empty transcript.\n827:     const child = spawn(runtime.command, argv, {\n828:       cwd: REPO_ROOT,\n829:       env: childEnv(ghConfig),\n830:       // Ignored means the child reads /dev/null rather than blocking on a terminal.\n831:       stdio: [runtime.promptOnStdin ? 'pipe' : 'ignore', 'pipe', 'inherit'],\n832:       // A chat turn still running after its cap is stuck, while a started workflow\n833:       // legitimately needs the longer one. The prompt decides which it gets.\n834:       timeout: capMs,\n835:     });\n836:     // The prompt is written and the stream closed at once, so a CLI that reads until\n837:     // the end of input sees a whole prompt. A CLI that exits before reading leaves a\n838:     // broken pipe behind, and that write error is the CLI's failure to report rather\n839:     // than an uncaught error that would end the run early.\n840:     if (child.stdin !== null) {\n841:       child.stdin.on('error', () => {});\n842:       child.stdin.end(prompt);\n843:     }\n844:     const locator = streamLocator(runtime.locator.field ?? null);\n845:     // The turn's own output is still shown, and the locator is read out of the\n846:     // same bytes, so watching a run and recording it never diverge.\n847:     child.stdout.setEncoding('utf8');\n848:     child.stdout.on('data', (chunk) => {\n849:       locator.push(chunk);\n850:       process.stdout.write(chunk);\n851:     });\n852:     child.on('error', (error) => settle({ exit: null, error, streamId: null }));\n853:     child.on('close', (exit) => settle({ exit, error: null, streamId: locator.value() }));\n854:   });\n855: }\n856: \n857: // ───────────────────────────────────────────────────────────────\n858: // CLI\n859: // ───────────────────────────────────────────────────────────────\n860: \n861: class UsageError extends Error {}\n862: \n863: const SCRIPT_NAME = 'run-command-behaviour.mjs';\n864: const SAMPLE_PROMPT = 'sample prompt for argv inspection';\n865: const SAMPLE_SESSION_ID = 'sample-session-id';\n866: \n867: // An arm label decides how a later scorer groups a whole log, so a typo would\n868: // quietly invent a third arm. The set is closed for that reason.\n869: const ARMS = ['pre', 'post', 'smoke', 'g2'];\n870: \n871: // The pre-change arm is the default because it is the one that can run before the\n872: // brief lands. A post-change run has to say which arm it belongs to. The\n873: // started-command set carries its own arm, so a run of it cannot land in the\n874: // change comparison by omission.\n875: const DEFAULT_ARM = 'pre';\n876: \n877: const USAGE = [\n878:   `usage: ${SCRIPT_NAME} --print-argv <runtime>`,\n879:   `       ${SCRIPT_NAME} --list <set>`,\n880:   `       ${SCRIPT_NAME} --runtime <runtime> (--set <set> | --row-id <id>...)`,\n881:   '         --out <run-log> [--arm <arm>] [--fixture <dir>] [--dry-run]',\n882: ].join('\\n');\n883: \n884: function resolveRuntime(name) {\n885:   if (has(RUNTIMES, name)) {\n886:     return RUNTIMES[name];\n887:   }\n888:   if (has(NOT_MEASURED, name)) {\n889:     throw new UsageError(`runtime ${name} is not measured: ${NOT_MEASURED[name]}`);\n890:   }\n891:   throw new UsageError(`unknown runtime: ${name}`);\n892: }\n893: \n894: function valueAfter(argv, index, flag) {\n895:   const value = argv[index];\n896:   if (typeof value !== 'string' || value.startsWith('--')) {\n897:     throw new UsageError(`${flag}: a value is required`);\n898:   }\n899:   return value;\n900: }\n901: \n902: // A set that has its own arm names it, so a started-command run cannot join the\n903: // change comparison because nobody passed `--arm`.\n904: function armFor(options) {\n905:   if (options.arm !== null) return options.arm;\n906:   return options.set === G2_SET ? G2_SET : DEFAULT_ARM;\n907: }\n908: \n909: function parseOptions(argv) {\n910:   const options = {\n911:     printArgv: null,\n912:     list: null,\n913:     set: null,\n914:     runtime: null,\n915:     rowIds: [],\n916:     arm: null,\n917:     out: null,\n918:     fixture: null,\n919:     dryRun: false,\n920:   };\n921:   for (let index = 0; index < argv.length; index += 1) {\n922:     const token = argv[index];\n923:     if (token === '--print-argv') {\n924:       index += 1;\n925:       options.printArgv = valueAfter(argv, index, '--print-argv');\n926:     } else if (token === '--list') {\n927:       index += 1;\n928:       options.list = valueAfter(argv, index, '--list');\n929:     } else if (token === '--set') {\n930:       index += 1;\n931:       options.set = valueAfter(argv, index, '--set');\n932:     } else if (token === '--runtime') {\n933:       index += 1;\n934:       options.runtime = valueAfter(argv, index, '--runtime');\n935:     } else if (token === '--row-id') {\n936:       index += 1;\n937:       options.rowIds.push(valueAfter(argv, index, '--row-id'));\n938:     } else if (token === '--arm') {\n939:       index += 1;\n940:       const arm = valueAfter(argv, index, '--arm');\n941:       if (!ARMS.includes(arm)) {\n942:         throw new UsageError(`--arm: expected one of ${ARMS.join(', ')}`);\n943:       }\n944:       options.arm = arm;\n945:     } else if (token === '--out') {\n946:       index += 1;\n947:       options.out = resolve(valueAfter(argv, index, '--out'));\n948:     } else if (token === '--fixture') {\n949:       index += 1;\n950:       options.fixture = resolve(valueAfter(argv, index, '--fixture'));\n951:     } else if (token === '--dry-run') {\n952:       options.dryRun = true;\n953:     } else {\n954:       throw new UsageError(`unknown option: ${token}`);\n955:     }\n956:   }\n957:   return options;\n958: }\n959: \n960: // One mode per invocation. Asking for an argv and a run at once would hide which\n961: // one the operator meant, and a run with no log has nowhere to record its proof.\n962: function selectMode(options) {\n963:   if (options.printArgv !== null) return 'print-argv';\n964:   if (options.list !== null) return 'list';\n965:   if (options.runtime === null) throw new UsageError('--runtime is required');\n966:   if (options.set === null && options.rowIds.length === 0) {\n967:     throw new UsageError('--set or --row-id is required');\n968:   }\n969:   if (options.out === null) throw new UsageError('--out is required');\n970:   return 'run';\n971: }\n972: \n973: function writeJson(value) {\n974:   process.stdout.write(`${JSON.stringify(value)}\\n`);\n975: }\n976: \n977: function writeRowIds(rowIds) {\n978:   process.stdout.write(rowIds.map((rowId) => `${rowId}\\n`).join(''));\n979: }\n980: \n981: function writeArgv(runtimeName) {\n982:   const runtime = resolveRuntime(runtimeName);\n983:   const argv = runtime.buildArgv({ prompt: SAMPLE_PROMPT, sessionId: SAMPLE_SESSION_ID });\n984:   // The prompt rides stdin, so it must not leak into the argv an operator inspects.\n985:   if (runtime.promptOnStdin && argv.includes(SAMPLE_PROMPT)) {\n986:     throw new Error(`${runtimeName}: prompt is on stdin but also in argv`);\n987:   }\n988:   writeJson(argv);\n989: }\n990: \n991: // One prompt and its clean-up. The returned status ends the arm as soon as a guard\n992: // fires, so a broken precondition never spends another model call.\n993: async function runTurn(job, options, exempt, isFirst) {\n994:   const before = { status: statusPaths(), ...gitSnapshot() };\n995:   if (isFirst) {\n996:     // A live turn can push, so it may only start where there is no remote to push\n997:     // to. A dry run spawns nothing and keeps running in this checkout.\n998:     if (!options.dryRun) {\n999:       const remotes = remoteNames();\n1000:       if (remotes.length > 0) {\n1001:         return {\n1002:           status: EXIT_REFUSED,\n1003:           refusal: { ok: false, code: 'remote_present', remotes },\n1004:         };\n1005:       }\n1006:     }\n1007:     const dirty = dirtyPaths(before.status, exempt);\n1008:     if (dirty.length > 0) {\n1009:       return {\n1010:         status: EXIT_REFUSED,\n1011:         refusal: { ok: false, code: 'worktree_dirty', paths: dirty },\n1012:       };\n1013:     }\n1014:   }\n1015: \n1016:   const sessionId = randomUUID();\n1017:   const argv = job.runtime.buildArgv({ prompt: job.prompt, sessionId });\n1018:   // A runtime that names its session only in its own store is bracketed by a\n1019:   // listing, and the entry the turn added is the session it wrote. A dry run\n1020:   // starts no CLI, so it has nothing to list.\n1021:   const listed = !options.dryRun && listsStore(job.runtime);\n1022:   const listingBefore = listed ? storeIds(job.runtime, job.ghConfig) : null;\n1023:   const turn = options.dryRun\n1024:     ? { exit: null, error: null, streamId: null }\n1025:     : await spawnTurn(job.runtime, argv, job.prompt, job.cap, job.ghConfig);\n1026:   const reportedId = listed\n1027:     ? addedSessionId(listingBefore, storeIds(job.runtime, job.ghConfig))\n1028:     : turn.streamId;\n1029: \n1030:   const after = { status: statusPaths(), ...gitSnapshot() };\n1031:   const headMoved = before.head !== after.head || before.stash !== after.stash;\n1032:   const changed = changedPaths(before.status, after.status);\n1033:   const line = {\n1034:     runtime: job.runtimeName,\n1035:     rowId: job.rowId,\n1036:     arm: options.arm,\n1037:     locator: locatorFor(job.runtime, sessionId, reportedId),\n1038:     exit: turn.exit,\n1039:     changedPaths: changed,\n1040:   };\n1041: \n1042:   if (headMoved) {\n1043:     // The worktree the restore was written for is gone. Restoring now could discard\n1044:     // whatever the commit or stash brought in, so the paths stay listed instead.\n1045:     appendRunLine(options.out, { ...line, restored: false, headMoved: true });\n1046:     return { status: EXIT_HEAD_MOVED, refusal: { ok: false, code: 'head_moved', rowId: job.rowId } };\n1047:   }\n1048: \n1049:   // A dry run spawns nothing, so an unchanged worktree is the only thing it can\n1050:   // honestly report as left as found.\n1051:   const restored = options.dryRun ? changed.length === 0 : restorePaths(changed).length === 0;\n1052:   appendRunLine(options.out, { ...line, restored });\n1053: \n1054:   if (turn.error !== null) {\n1055:     const detail = turn.error.message;\n1056:     return { status: 1, refusal: { ok: false, code: 'spawn_failed', runtime: job.runtimeName, detail } };\n1057:   }\n1058:   if (!restored) {\n1059:     return { status: 1, refusal: { ok: false, code: 'restore_failed', rowId: job.rowId, paths: changed } };\n1060:   }\n1061:   return { status: 0, refusal: null };\n1062: }\n1063: \n1064: async function runArm(options, rowIds) {\n1065:   const exempt = exemptPrefix(dirname(options.out));\n1066:   const runtime = resolveRuntime(options.runtime);\n1067:   const fixture = fixtureDir(options);\n1068:   // Created once before the first snapshot, so the folder a turn needs is never\n1069:   // read back as a path the turn itself changed.\n1070:   const ghConfig = ghConfigDir(options.out);\n1071:   mkdirSync(ghConfig, { recursive: true });\n1072:   for (let index = 0; index < rowIds.length; index += 1) {\n1073:     const rowId = rowIds[index];\n1074:     const prompt = promptFor(rowId, fixture);\n1075:     const job = { runtime, runtimeName: options.runtime, rowId, prompt, cap: capForRow(rowId), ghConfig };\n1076:     const result = await runTurn(job, options, exempt, index === 0);\n1077:     if (result.refusal !== null) writeJson(result.refusal);\n1078:     if (result.status !== 0) return result.status;\n1079:   }\n1080:   return 0;\n1081: }\n1082: \n1083: async function main(argv) {\n1084:   try {\n1085:     const options = parseOptions(argv);\n1086:     // Selection runs before the mode check, so an id the dataset guard refuses is\n1087:     // answered by that guard rather than by whichever usage check would run first.\n1088:     const rowIds = selectedRowIds(options);\n1089:     const mode = selectMode(options);\n1090:     options.arm = armFor(options);\n1091: \n1092:     if (mode === 'print-argv') {\n1093:       writeArgv(options.printArgv);\n1094:       return 0;\n1095:     }\n1096:     if (mode === 'list') {\n1097:       writeRowIds(rowIds);\n1098:       return 0;\n1099:     }\n1100:     return await runArm(options, rowIds);\n1101:   } catch (error) {\n1102:     if (error instanceof UsageError) {\n1103:       process.stderr.write(`${SCRIPT_NAME}: ${error.message}\\n${USAGE}\\n`);\n1104:       return EXIT_REFUSED;\n1105:     }\n1106:     if (error instanceof Refusal) {\n1107:       writeJson({ ok: false, code: error.code, detail: error.message });\n1108:       return EXIT_REFUSED;\n1109:     }\n1110:     throw error;\n1111:   }\n1112: }\n1113: \n1114: try {\n1115:   process.exitCode = await main(process.argv.slice(2));\n1116: } catch (error) {\n1117:   if (error instanceof UsageError) {\n1118:     process.stderr.write(`${SCRIPT_NAME}: ${error.message}\\n`);\n1119:     process.exitCode = EXIT_REFUSED;\n1120:   } else {\n1121:     throw error;\n1122:   }\n1123: }"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/run-command-behaviour.mjs\"}"},"time":{"start":1794529055779,"end":1794529056599}}}}
{"type":"tool_use","timestamp":1794529056605,"sessionID":"ses_e2dbc3be8ffeZjZZx7Vqdb573y","part":{"partID":"prt_1d24455c3001KJmwug0ZKZg73Q","sessionID":"ses_e2dbc3be8ffeZjZZx7Vqdb573y","messageID":"msg_1d2443e160013N5FdrCX4PxKKD","type":"tool","id":"call_55c45465956641a1b9875b12","tool":"read","state":{"status":"completed","input":{"path":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/command-offer.mjs"},"output":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/command-offer.mjs, lines 1-328\n1: // ───────────────────────────────────────────────────────────────\n2: // MODULE: Command offer from an advisor head\n3: // ───────────────────────────────────────────────────────────────\n4: //\n5: // A run line records which command the advisor offered and the policy it named,\n6: // so a start rate can be read as \"did the reader follow the offer\" rather than\n7: // only \"did a command run\". The offer is recovered by replaying the Claude\n8: // prompt hook after the turn, because the head is the only text that names both\n9: // the command and the policy, and a replay keeps the recorded value independent\n10: // of whatever the session reader happened to retain.\n11: //\n12: // A failed replay returns null fields plus an offerError, so a backfill over a\n13: // checkout without the hook, or a hook that crashes, still produces a readable\n14: // line instead of aborting the run.\n15: //\n16: // The offer alone cannot tell a reader who ignored it from a brief the session\n17: // never received, so the same module also reports whether the brief landed. A\n18: // runtime with no confirmed place to look reports `unknown` rather than a miss,\n19: // because a missing record there measures the reader, not the delivery.\n20: //\n21: // A log written before those fields existed gets them from a backfill, which\n22: // resolves every prompt before it writes, so a refused row leaves no partial log\n23: // behind and each line still answers for its own checkout.\n24: \n25: import { spawnSync } from 'node:child_process';\n26: import { existsSync, mkdirSync, readFileSync, writeFileSync } from 'node:fs';\n27: import { dirname, join, resolve } from 'node:path';\n28: \n29: import { loadSession as loadSharedSession } from '../../../../../hooks/shared/session-readers/index.mjs';\n30: \n31: const HOOK_RELATIVE = '.skilled/skills/system-spec-kit/runtime/dist/hooks/claude/user-prompt-submit.js';\n32: const ADVISOR_CLI_RELATIVE = '.skilled/bin/skill-advisor.cjs';\n33: const OFFER_PATTERN = /\\/[a-z][a-z-]*:[a-z][a-z-]*(?: [a-z][a-z-]*)?/;\n34: const POLICY_PATTERN = /^ *(?:\\((run|start|ask)\\))/;\n35: const BRIEF_PATTERN = /Advisor: [a-z]+[;. ]/;\n36: const CLAUDE_ATTACHMENT_EVENT = 'UserPromptSubmit';\n37: const DEFAULT_TIMEOUT_MS = 30_000;\n38: const MAX_OUTPUT_BYTES = 1024 * 1024;\n39: \n40: function failedOffer(offerError) {\n41:   return { offeredCommand: null, offeredPolicy: null, offerError };\n42: }\n43: \n44: /**\n45:  * Read the command and the policy out of the first line of a head.\n46:  *\n47:  * The policy only counts when it directly follows the command, so a `(ask)`\n48:  * that belongs to a later clause cannot attach itself to an earlier match.\n49:  *\n50:  * @param {string} head - One line of advisor output.\n51:  * @returns {{ offeredCommand: string | null, offeredPolicy: string | null }}\n52:  */\n53: export function parseOffer(head) {\n54:   const text = typeof head === 'string' ? head : '';\n55:   const match = text.match(OFFER_PATTERN);\n56:   if (!match) {\n57:     return { offeredCommand: null, offeredPolicy: null };\n58:   }\n59:   const policy = text.slice(match.index + match[0].length).match(POLICY_PATTERN);\n60:   return {\n61:     offeredCommand: match[0],\n62:     offeredPolicy: policy ? policy[1] : null,\n63:   };\n64: }\n65: \n66: /**\n67:  * Replay the Claude prompt hook for one prompt and parse the offer it prints.\n68:  *\n69:  * The hook is resolved from the checkout rather than from this module, so a\n70:  * backfill records what that checkout's advisor would have offered at the time\n71:  * of the run, not what the current working copy happens to say.\n72:  *\n73:  * @param {object} options\n74:  * @param {string} options.checkoutDir - Root of the checkout whose hook runs.\n75:  * @param {string} options.prompt - The prompt to replay.\n76:  * @param {string} options.sessionId - Session id for the hook payload.\n77:  * @param {number} [options.timeoutMs] - Hook timeout before the replay fails.\n78:  * @returns {{ offeredCommand: string | null, offeredPolicy: string | null, offerError: string | null }}\n79:  */\n80: export function replayOffer({ checkoutDir, prompt, sessionId, timeoutMs = DEFAULT_TIMEOUT_MS }) {\n81:   const hookPath = join(checkoutDir, HOOK_RELATIVE);\n82:   if (!existsSync(hookPath)) {\n83:     return failedOffer('hook_missing');\n84:   }\n85: \n86:   const payload = {\n87:     prompt,\n88:     cwd: checkoutDir,\n89:     hook_event_name: 'UserPromptSubmit',\n90:     session_id: sessionId,\n91:   };\n92: \n93:   let result;\n94:   try {\n95:     result = spawnSync('node', [hookPath], {\n96:       cwd: checkoutDir,\n97:       input: JSON.stringify(payload),\n98:       encoding: 'utf8',\n99:       timeout: timeoutMs,\n100:       maxBuffer: MAX_OUTPUT_BYTES,\n101:     });\n102:   } catch {\n103:     return failedOffer('hook_failed');\n104:   }\n105: \n106:   if (result.error || result.status !== 0 || typeof result.stdout !== 'string') {\n107:     return failedOffer('hook_failed');\n108:   }\n109: \n110:   let output;\n111:   try {\n112:     output = JSON.parse(result.stdout);\n113:   } catch {\n114:     return failedOffer('hook_failed');\n115:   }\n116: \n117:   const context = output?.hookSpecificOutput?.additionalContext;\n118:   if (typeof context !== 'string') {\n119:     return failedOffer('no_head');\n120:   }\n121: \n122:   const [firstLine = ''] = context.split(/\\r?\\n/);\n123:   if (!firstLine.trim()) {\n124:     return failedOffer('no_head');\n125:   }\n126: \n127:   return { ...parseOffer(firstLine), offerError: null };\n128: }\n129: \n130: function contentHasBrief(content) {\n131:   if (typeof content === 'string') return BRIEF_PATTERN.test(content);\n132:   if (!Array.isArray(content)) return false;\n133:   return content.some((part) => {\n134:     if (typeof part === 'string') return BRIEF_PATTERN.test(part);\n135:     return typeof part?.text === 'string' && BRIEF_PATTERN.test(part.text);\n136:   });\n137: }\n138: \n139: // Neutral records keep their text in content blocks, and the block shape differs\n140: // by runtime, so the serialized record is the one place the brief is found\n141: // whichever block carries it.\n142: function recordsHaveBrief(records) {\n143:   return (Array.isArray(records) ? records : []).some((record) =>\n144:     BRIEF_PATTERN.test(JSON.stringify(record ?? null)));\n145: }\n146: \n147: /**\n148:  * Decide whether the advisor brief reached the session that ran the turn.\n149:  *\n150:  * A Claude transcript records the hook context as its own attachment line, so a\n151:  * missing attachment is a real miss. Pi keeps delivery in its session records\n152:  * and needs the caller's reader. Every other runtime has no confirmed record of\n153:  * delivery, so its answer stays `unknown` and never counts as a miss.\n154:  *\n155:  * @param {object} options\n156:  * @param {string} options.runtime - The measured runtime.\n157:  * @param {object|null} [options.locator] - The locator the run line recorded.\n158:  * @param {Function} [options.loadSession] - Reader for a runtime whose brief\n159:  *   lives in session records rather than a transcript file.\n160:  * @returns {Promise<boolean | 'unknown'>}\n161:  */\n162: export async function briefDelivered({ runtime, locator, loadSession } = {}) {\n163:   if (runtime === 'claude') {\n164:     const transcriptPath = locator?.transcriptPath;\n165:     if (typeof transcriptPath !== 'string' || transcriptPath.length === 0) {\n166:       return 'unknown';\n167:     }\n168: \n169:     let raw;\n170:     try {\n171:       raw = readFileSync(transcriptPath, 'utf8');\n172:     } catch {\n173:       return 'unknown';\n174:     }\n175: \n176:     for (const line of raw.split('\\n')) {\n177:       if (!line.trim()) continue;\n178:       let entry;\n179:       try {\n180:         entry = JSON.parse(line);\n181:       } catch {\n182:         continue;\n183:       }\n184:       if (entry?.type !== 'attachment') continue;\n185:       const attachment = entry.attachment;\n186:       if (attachment?.type !== 'hook_additional_context') continue;\n187:       if (attachment.hookEvent !== CLAUDE_ATTACHMENT_EVENT) continue;\n188:       if (contentHasBrief(attachment.content)) return true;\n189:     }\n190:     return false;\n191:   }\n192: \n193:   if (runtime === 'pi') {\n194:     if (typeof loadSession !== 'function') return 'unknown';\n195:     let loaded;\n196:     try {\n197:       loaded = await loadSession({ ...locator, runtime });\n198:     } catch {\n199:       return 'unknown';\n200:     }\n201:     if (!loaded?.ok) return 'unknown';\n202:     return recordsHaveBrief(loaded.records);\n203:   }\n204: \n205:   return 'unknown';\n206: }\n207: \n208: // ───────────────────────────────────────────────────────────────\n209: // Run-log backfill\n210: // ───────────────────────────────────────────────────────────────\n211: \n212: // A fresh daemon can outlast the first prompt's budget, so the backfill asks\n213: // each checkout to start one before it replays. The status call writes nothing,\n214: // and its failure is ignored because a replay that finds no daemon records its\n215: // own error instead of losing the line.\n216: function warmCheckout(checkoutDir) {\n217:   const cliPath = join(checkoutDir, ADVISOR_CLI_RELATIVE);\n218:   if (!existsSync(cliPath)) return;\n219:   spawnSync(\n220:     'node',\n221:     [cliPath, 'advisor_status', '--workspace-root', checkoutDir, '--format', 'json', '--no-warm-only'],\n222:     {\n223:       cwd: checkoutDir,\n224:       encoding: 'utf8',\n225:       timeout: DEFAULT_TIMEOUT_MS,\n226:       maxBuffer: MAX_OUTPUT_BYTES,\n227:     },\n228:   );\n229: }\n230: \n231: function refused(code, detail) {\n232:   return { ok: false, code, detail };\n233: }\n234: \n235: /**\n236:  * Add the offer, its policy and the brief to every line of a run log.\n237:  *\n238:  * The prompts are resolved before the first line is written, so a row the\n239:  * corpus refuses leaves no output file behind. A line whose locator names no\n240:  * checkout keeps null offer fields and its own error code, and the rest of the\n241:  * log is still written.\n242:  *\n243:  * @param {object} options\n244:  * @param {string} options.inPath - Run log to read.\n245:  * @param {string} options.outPath - New run log to write.\n246:  * @param {(rowId: string) => string} options.promptFor - Prompt lookup. It\n247:  *   refuses an unknown or holdout row by throwing an error with a `code`.\n248:  * @param {Function} [options.replay] - Offer replay, injectable for tests.\n249:  * @param {Function} [options.brief] - Brief delivery reader, injectable for tests.\n250:  * @param {(checkoutDir: string) => unknown} [options.warm] - Daemon warm-up,\n251:  *   injectable for tests.\n252:  * @returns {Promise<{ ok: true, lines: number, outPath: string }\n253:  *   | { ok: false, code: string, detail: string }>}\n254:  */\n255: export async function backfillRunLog({\n256:   inPath,\n257:   outPath,\n258:   promptFor,\n259:   replay = replayOffer,\n260:   brief = briefDelivered,\n261:   warm = warmCheckout,\n262: }) {\n263:   if (resolve(outPath) === resolve(inPath)) {\n264:     return refused('same_path', `${outPath}: the backfill writes a new log`);\n265:   }\n266: \n267:   const rows = [];\n268:   for (const raw of readFileSync(inPath, 'utf8').split('\\n')) {\n269:     if (raw.trim() === '') continue;\n270:     rows.push(JSON.parse(raw));\n271:   }\n272: \n273:   const prompts = [];\n274:   for (const row of rows) {\n275:     try {\n276:       prompts.push(promptFor(row.rowId));\n277:     } catch (error) {\n278:       return refused(error?.code ?? 'unknown_row', error?.message ?? String(error));\n279:     }\n280:   }\n281: \n282:   const warmed = new Set();\n283:   const output = [];\n284:   for (let index = 0; index < rows.length; index += 1) {\n285:     const line = rows[index];\n286:     const rowId = line.rowId;\n287:     const locator = line.locator !== null && typeof line.locator === 'object' && !Array.isArray(line.locator)\n288:       ? line.locator\n289:       : null;\n290:     const projectDir = locator?.projectDir;\n291:     const checkoutDir = typeof projectDir === 'string' && projectDir !== '' ? projectDir : null;\n292: \n293:     let offer = { offeredCommand: null, offeredPolicy: null, offerError: 'no_checkout' };\n294:     if (checkoutDir !== null) {\n295:       if (!warmed.has(checkoutDir)) {\n296:         warmed.add(checkoutDir);\n297:         try {\n298:           await warm(checkoutDir);\n299:         } catch {\n300:           // A failed warm-up still lets the replay report its own miss.\n301:         }\n302:       }\n303:       offer = await replay({\n304:         checkoutDir,\n305:         prompt: prompts[index],\n306:         sessionId: `backfill-${rowId}`,\n307:       });\n308:     }\n309: \n310:     // Pi keeps its brief in a session store rather than a transcript, so the\n311:     // shared reader travels with every call. A runtime that has no reader for\n312:     // its store ignores it and answers `unknown`.\n313:     const delivered = await brief({ runtime: line.runtime, locator, loadSession: loadSharedSession });\n314: \n315:     output.push({\n316:       ...line,\n317:       offeredCommand: offer.offeredCommand ?? null,\n318:       offeredPolicy: offer.offeredPolicy ?? null,\n319:       offerError: offer.offerError ?? null,\n320:       briefDelivered: delivered,\n321:       offerBackfilled: true,\n322:     });\n323:   }\n324: \n325:   mkdirSync(dirname(outPath), { recursive: true });\n326:   writeFileSync(outPath, output.map((line) => `${JSON.stringify(line)}\\n`).join(''), 'utf8');\n327:   return { ok: true, lines: output.length, outPath };\n328: }","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/command-offer.mjs, lines 1-328\n1: // ───────────────────────────────────────────────────────────────\n2: // MODULE: Command offer from an advisor head\n3: // ───────────────────────────────────────────────────────────────\n4: //\n5: // A run line records which command the advisor offered and the policy it named,\n6: // so a start rate can be read as \"did the reader follow the offer\" rather than\n7: // only \"did a command run\". The offer is recovered by replaying the Claude\n8: // prompt hook after the turn, because the head is the only text that names both\n9: // the command and the policy, and a replay keeps the recorded value independent\n10: // of whatever the session reader happened to retain.\n11: //\n12: // A failed replay returns null fields plus an offerError, so a backfill over a\n13: // checkout without the hook, or a hook that crashes, still produces a readable\n14: // line instead of aborting the run.\n15: //\n16: // The offer alone cannot tell a reader who ignored it from a brief the session\n17: // never received, so the same module also reports whether the brief landed. A\n18: // runtime with no confirmed place to look reports `unknown` rather than a miss,\n19: // because a missing record there measures the reader, not the delivery.\n20: //\n21: // A log written before those fields existed gets them from a backfill, which\n22: // resolves every prompt before it writes, so a refused row leaves no partial log\n23: // behind and each line still answers for its own checkout.\n24: \n25: import { spawnSync } from 'node:child_process';\n26: import { existsSync, mkdirSync, readFileSync, writeFileSync } from 'node:fs';\n27: import { dirname, join, resolve } from 'node:path';\n28: \n29: import { loadSession as loadSharedSession } from '../../../../../hooks/shared/session-readers/index.mjs';\n30: \n31: const HOOK_RELATIVE = '.skilled/skills/system-spec-kit/runtime/dist/hooks/claude/user-prompt-submit.js';\n32: const ADVISOR_CLI_RELATIVE = '.skilled/bin/skill-advisor.cjs';\n33: const OFFER_PATTERN = /\\/[a-z][a-z-]*:[a-z][a-z-]*(?: [a-z][a-z-]*)?/;\n34: const POLICY_PATTERN = /^ *(?:\\((run|start|ask)\\))/;\n35: const BRIEF_PATTERN = /Advisor: [a-z]+[;. ]/;\n36: const CLAUDE_ATTACHMENT_EVENT = 'UserPromptSubmit';\n37: const DEFAULT_TIMEOUT_MS = 30_000;\n38: const MAX_OUTPUT_BYTES = 1024 * 1024;\n39: \n40: function failedOffer(offerError) {\n41:   return { offeredCommand: null, offeredPolicy: null, offerError };\n42: }\n43: \n44: /**\n45:  * Read the command and the policy out of the first line of a head.\n46:  *\n47:  * The policy only counts when it directly follows the command, so a `(ask)`\n48:  * that belongs to a later clause cannot attach itself to an earlier match.\n49:  *\n50:  * @param {string} head - One line of advisor output.\n51:  * @returns {{ offeredCommand: string | null, offeredPolicy: string | null }}\n52:  */\n53: export function parseOffer(head) {\n54:   const text = typeof head === 'string' ? head : '';\n55:   const match = text.match(OFFER_PATTERN);\n56:   if (!match) {\n57:     return { offeredCommand: null, offeredPolicy: null };\n58:   }\n59:   const policy = text.slice(match.index + match[0].length).match(POLICY_PATTERN);\n60:   return {\n61:     offeredCommand: match[0],\n62:     offeredPolicy: policy ? policy[1] : null,\n63:   };\n64: }\n65: \n66: /**\n67:  * Replay the Claude prompt hook for one prompt and parse the offer it prints.\n68:  *\n69:  * The hook is resolved from the checkout rather than from this module, so a\n70:  * backfill records what that checkout's advisor would have offered at the time\n71:  * of the run, not what the current working copy happens to say.\n72:  *\n73:  * @param {object} options\n74:  * @param {string} options.checkoutDir - Root of the checkout whose hook runs.\n75:  * @param {string} options.prompt - The prompt to replay.\n76:  * @param {string} options.sessionId - Session id for the hook payload.\n77:  * @param {number} [options.timeoutMs] - Hook timeout before the replay fails.\n78:  * @returns {{ offeredCommand: string | null, offeredPolicy: string | null, offerError: string | null }}\n79:  */\n80: export function replayOffer({ checkoutDir, prompt, sessionId, timeoutMs = DEFAULT_TIMEOUT_MS }) {\n81:   const hookPath = join(checkoutDir, HOOK_RELATIVE);\n82:   if (!existsSync(hookPath)) {\n83:     return failedOffer('hook_missing');\n84:   }\n85: \n86:   const payload = {\n87:     prompt,\n88:     cwd: checkoutDir,\n89:     hook_event_name: 'UserPromptSubmit',\n90:     session_id: sessionId,\n91:   };\n92: \n93:   let result;\n94:   try {\n95:     result = spawnSync('node', [hookPath], {\n96:       cwd: checkoutDir,\n97:       input: JSON.stringify(payload),\n98:       encoding: 'utf8',\n99:       timeout: timeoutMs,\n100:       maxBuffer: MAX_OUTPUT_BYTES,\n101:     });\n102:   } catch {\n103:     return failedOffer('hook_failed');\n104:   }\n105: \n106:   if (result.error || result.status !== 0 || typeof result.stdout !== 'string') {\n107:     return failedOffer('hook_failed');\n108:   }\n109: \n110:   let output;\n111:   try {\n112:     output = JSON.parse(result.stdout);\n113:   } catch {\n114:     return failedOffer('hook_failed');\n115:   }\n116: \n117:   const context = output?.hookSpecificOutput?.additionalContext;\n118:   if (typeof context !== 'string') {\n119:     return failedOffer('no_head');\n120:   }\n121: \n122:   const [firstLine = ''] = context.split(/\\r?\\n/);\n123:   if (!firstLine.trim()) {\n124:     return failedOffer('no_head');\n125:   }\n126: \n127:   return { ...parseOffer(firstLine), offerError: null };\n128: }\n129: \n130: function contentHasBrief(content) {\n131:   if (typeof content === 'string') return BRIEF_PATTERN.test(content);\n132:   if (!Array.isArray(content)) return false;\n133:   return content.some((part) => {\n134:     if (typeof part === 'string') return BRIEF_PATTERN.test(part);\n135:     return typeof part?.text === 'string' && BRIEF_PATTERN.test(part.text);\n136:   });\n137: }\n138: \n139: // Neutral records keep their text in content blocks, and the block shape differs\n140: // by runtime, so the serialized record is the one place the brief is found\n141: // whichever block carries it.\n142: function recordsHaveBrief(records) {\n143:   return (Array.isArray(records) ? records : []).some((record) =>\n144:     BRIEF_PATTERN.test(JSON.stringify(record ?? null)));\n145: }\n146: \n147: /**\n148:  * Decide whether the advisor brief reached the session that ran the turn.\n149:  *\n150:  * A Claude transcript records the hook context as its own attachment line, so a\n151:  * missing attachment is a real miss. Pi keeps delivery in its session records\n152:  * and needs the caller's reader. Every other runtime has no confirmed record of\n153:  * delivery, so its answer stays `unknown` and never counts as a miss.\n154:  *\n155:  * @param {object} options\n156:  * @param {string} options.runtime - The measured runtime.\n157:  * @param {object|null} [options.locator] - The locator the run line recorded.\n158:  * @param {Function} [options.loadSession] - Reader for a runtime whose brief\n159:  *   lives in session records rather than a transcript file.\n160:  * @returns {Promise<boolean | 'unknown'>}\n161:  */\n162: export async function briefDelivered({ runtime, locator, loadSession } = {}) {\n163:   if (runtime === 'claude') {\n164:     const transcriptPath = locator?.transcriptPath;\n165:     if (typeof transcriptPath !== 'string' || transcriptPath.length === 0) {\n166:       return 'unknown';\n167:     }\n168: \n169:     let raw;\n170:     try {\n171:       raw = readFileSync(transcriptPath, 'utf8');\n172:     } catch {\n173:       return 'unknown';\n174:     }\n175: \n176:     for (const line of raw.split('\\n')) {\n177:       if (!line.trim()) continue;\n178:       let entry;\n179:       try {\n180:         entry = JSON.parse(line);\n181:       } catch {\n182:         continue;\n183:       }\n184:       if (entry?.type !== 'attachment') continue;\n185:       const attachment = entry.attachment;\n186:       if (attachment?.type !== 'hook_additional_context') continue;\n187:       if (attachment.hookEvent !== CLAUDE_ATTACHMENT_EVENT) continue;\n188:       if (contentHasBrief(attachment.content)) return true;\n189:     }\n190:     return false;\n191:   }\n192: \n193:   if (runtime === 'pi') {\n194:     if (typeof loadSession !== 'function') return 'unknown';\n195:     let loaded;\n196:     try {\n197:       loaded = await loadSession({ ...locator, runtime });\n198:     } catch {\n199:       return 'unknown';\n200:     }\n201:     if (!loaded?.ok) return 'unknown';\n202:     return recordsHaveBrief(loaded.records);\n203:   }\n204: \n205:   return 'unknown';\n206: }\n207: \n208: // ───────────────────────────────────────────────────────────────\n209: // Run-log backfill\n210: // ───────────────────────────────────────────────────────────────\n211: \n212: // A fresh daemon can outlast the first prompt's budget, so the backfill asks\n213: // each checkout to start one before it replays. The status call writes nothing,\n214: // and its failure is ignored because a replay that finds no daemon records its\n215: // own error instead of losing the line.\n216: function warmCheckout(checkoutDir) {\n217:   const cliPath = join(checkoutDir, ADVISOR_CLI_RELATIVE);\n218:   if (!existsSync(cliPath)) return;\n219:   spawnSync(\n220:     'node',\n221:     [cliPath, 'advisor_status', '--workspace-root', checkoutDir, '--format', 'json', '--no-warm-only'],\n222:     {\n223:       cwd: checkoutDir,\n224:       encoding: 'utf8',\n225:       timeout: DEFAULT_TIMEOUT_MS,\n226:       maxBuffer: MAX_OUTPUT_BYTES,\n227:     },\n228:   );\n229: }\n230: \n231: function refused(code, detail) {\n232:   return { ok: false, code, detail };\n233: }\n234: \n235: /**\n236:  * Add the offer, its policy and the brief to every line of a run log.\n237:  *\n238:  * The prompts are resolved before the first line is written, so a row the\n239:  * corpus refuses leaves no output file behind. A line whose locator names no\n240:  * checkout keeps null offer fields and its own error code, and the rest of the\n241:  * log is still written.\n242:  *\n243:  * @param {object} options\n244:  * @param {string} options.inPath - Run log to read.\n245:  * @param {string} options.outPath - New run log to write.\n246:  * @param {(rowId: string) => string} options.promptFor - Prompt lookup. It\n247:  *   refuses an unknown or holdout row by throwing an error with a `code`.\n248:  * @param {Function} [options.replay] - Offer replay, injectable for tests.\n249:  * @param {Function} [options.brief] - Brief delivery reader, injectable for tests.\n250:  * @param {(checkoutDir: string) => unknown} [options.warm] - Daemon warm-up,\n251:  *   injectable for tests.\n252:  * @returns {Promise<{ ok: true, lines: number, outPath: string }\n253:  *   | { ok: false, code: string, detail: string }>}\n254:  */\n255: export async function backfillRunLog({\n256:   inPath,\n257:   outPath,\n258:   promptFor,\n259:   replay = replayOffer,\n260:   brief = briefDelivered,\n261:   warm = warmCheckout,\n262: }) {\n263:   if (resolve(outPath) === resolve(inPath)) {\n264:     return refused('same_path', `${outPath}: the backfill writes a new log`);\n265:   }\n266: \n267:   const rows = [];\n268:   for (const raw of readFileSync(inPath, 'utf8').split('\\n')) {\n269:     if (raw.trim() === '') continue;\n270:     rows.push(JSON.parse(raw));\n271:   }\n272: \n273:   const prompts = [];\n274:   for (const row of rows) {\n275:     try {\n276:       prompts.push(promptFor(row.rowId));\n277:     } catch (error) {\n278:       return refused(error?.code ?? 'unknown_row', error?.message ?? String(error));\n279:     }\n280:   }\n281: \n282:   const warmed = new Set();\n283:   const output = [];\n284:   for (let index = 0; index < rows.length; index += 1) {\n285:     const line = rows[index];\n286:     const rowId = line.rowId;\n287:     const locator = line.locator !== null && typeof line.locator === 'object' && !Array.isArray(line.locator)\n288:       ? line.locator\n289:       : null;\n290:     const projectDir = locator?.projectDir;\n291:     const checkoutDir = typeof projectDir === 'string' && projectDir !== '' ? projectDir : null;\n292: \n293:     let offer = { offeredCommand: null, offeredPolicy: null, offerError: 'no_checkout' };\n294:     if (checkoutDir !== null) {\n295:       if (!warmed.has(checkoutDir)) {\n296:         warmed.add(checkoutDir);\n297:         try {\n298:           await warm(checkoutDir);\n299:         } catch {\n300:           // A failed warm-up still lets the replay report its own miss.\n301:         }\n302:       }\n303:       offer = await replay({\n304:         checkoutDir,\n305:         prompt: prompts[index],\n306:         sessionId: `backfill-${rowId}`,\n307:       });\n308:     }\n309: \n310:     // Pi keeps its brief in a session store rather than a transcript, so the\n311:     // shared reader travels with every call. A runtime that has no reader for\n312:     // its store ignores it and answers `unknown`.\n313:     const delivered = await brief({ runtime: line.runtime, locator, loadSession: loadSharedSession });\n314: \n315:     output.push({\n316:       ...line,\n317:       offeredCommand: offer.offeredCommand ?? null,\n318:       offeredPolicy: offer.offeredPolicy ?? null,\n319:       offerError: offer.offerError ?? null,\n320:       briefDelivered: delivered,\n321:       offerBackfilled: true,\n322:     });\n323:   }\n324: \n325:   mkdirSync(dirname(outPath), { recursive: true });\n326:   writeFileSync(outPath, output.map((line) => `${JSON.stringify(line)}\\n`).join(''), 'utf8');\n327:   return { ok: true, lines: output.length, outPath };\n328: }"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/command-offer.mjs\"}"},"time":{"start":1794529056195,"end":1794529056605}}}}
