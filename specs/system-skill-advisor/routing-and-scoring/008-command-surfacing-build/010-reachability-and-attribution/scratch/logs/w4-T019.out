================\n--- .skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/run-command-behaviour.mjs\n+++ .skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/run-command-behaviour.mjs\n@@ -1030,13 +1030,16 @@\n \n   const after = { status: statusPaths(), ...gitSnapshot() };\n   const headMoved = before.head !== after.head || before.stash !== after.stash;\n   const changed = changedPaths(before.status, after.status);\n+  // The locator is kept in hand because the brief reader opens the same session\n+  // the line records, and resolving it twice could name a different file.\n+  const locator = locatorFor(job.runtime, sessionId, reportedId);\n   const line = {\n     runtime: job.runtimeName,\n     rowId: job.rowId,\n     arm: options.arm,\n-    locator: locatorFor(job.runtime, sessionId, reportedId),\n+    locator,\n     exit: turn.exit,\n     changedPaths: changed,\n   };\n \n","status":"modified","additions":4,"deletions":1}],"truncated":false},"content":[{"type":"text","text":"Edited .skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/run-command-behaviour.mjs (1 replacement)"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"newString\":\"  const after = { status: statusPaths(), ...gitSnapshot() };\\n  const headMoved = before.head !== after.head || before.stash !== after.stash;\\n  const changed = changedPaths(before.status, after.status);\\n  // The locator is kept in hand because the brief reader opens the same session\\n  // the line records, and resolving it twice could name a different file.\\n  const locator = locatorFor(job.runtime, sessionId, reportedId);\\n  const line = {\\n    runtime: job.runtimeName,\\n    rowId: job.rowId,\\n    arm: options.arm,\\n    locator,\\n    exit: turn.exit,\\n    changedPaths: changed,\\n  };\",\"oldString\":\"  const after = { status: statusPaths(), ...gitSnapshot() };\\n  const headMoved = before.head !== after.head || before.stash 