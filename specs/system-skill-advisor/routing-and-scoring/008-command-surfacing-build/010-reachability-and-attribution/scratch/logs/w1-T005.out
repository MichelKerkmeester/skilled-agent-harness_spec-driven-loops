ollowed = named.some((value) => tailMatches(value, documents))\n544:         || (event.kind === 'skill' && namesCommand(event.command, wanted));\n545:       if (followed) followDocument = true;\n546:     } else if (named.some((value) => tailMatches(value, confirms))) {\n547:       confirmLate = true;\n548:     }\n549:   }\n550: \n551:   return followDocument && !confirmLate;\n552: }\n553: \n554: // ───────────────────────────────────────────────────────────────────\n555: // 8. START STATE\n556: // ───────────────────────────────────────────────────────────────────\n557: \n558: // The two row shapes whose policy forbids an unasked write: an `ask` row\n559: // carries the policy, and a must-not-start row carries only its type, because\n560: // the corpus leaves the policy of every no-start row empty.\n561: const ASK_POLICY = 'ask';\n562: const MUST_NOT_START = 'must-not-start';\n563: \n564: // A model writes the mode it chose onto the command, so a `:auto` suffix is\n565: // its own choice unless the prompt carried one. The end anchor keeps a command\n566: // whose name merely starts with those letters out of the check.\n567: const SELF_AUTO = /:auto$/i;\n568: const PROMPT_AUTO = /:auto\\b/i;\n569: \n570: // The commands a session names out loud: the ones it reported on a `COMMAND:`\n571: // line, and the ones it loaded through a skill tool. A mode suffix on either is\n572: // the model's own edit of a command it was offered.\n573: function spokenCommands(events) {\n574:   const commands = commandLines(events).map((line) => line.command);\n575: \n576:   for (const event of events ?? []) {\n577:     if (!event || event.kind !== 'skill') continue;\n578:     if (typeof event.command === 'string' && event.command.trim()) commands.push(event.command.trim());\n579:   }\n580: \n581:   return commands;\n582: }\n583: \n584: // A start has more than one shape and most of them carry no order: the\n585: // document the command routes to was read, the command was loaded through a\