{"type":"tool_use","timestamp":1794527309224,"sessionID":"ses_e2dd83e9effePxIaBWu6n6TUfR","part":{"partID":"prt_1d229abe4002gw7WGg7oHYDrl5","sessionID":"ses_e2dd83e9effePxIaBWu6n6TUfR","messageID":"msg_1d2297f01001zU2adNn4jHVZZh","type":"tool","id":"call_b53dc304580a4fb6a8d07427","tool":"read","state":{"status":"completed","input":{"path":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/tests/command-transcript-score.vitest.ts"},"output":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/tests/command-transcript-score.vitest.ts, lines 1-645\n1: // ───────────────────────────────────────────────────────────────\n2: // MODULE: Command Transcript Score\n3: // ───────────────────────────────────────────────────────────────\n4: \n5: // Pins the facts one captured session is scored on, one behaviour per case, against\n6: // sessions built in the record shape the session readers hand over. Each case is a\n7: // turn a model could plausibly have taken: a reply that names no command, a document\n8: // read before and after the first write, a write under each policy, a mode the run\n9: // gave itself, a loop that ran its own steps before claiming its state and a\n10: // completion that worked ahead of the packet. The exit cases run the front door,\n11: // because a reader failure has to reach a caller as the reader's own code rather\n12: // than as a partial score, and the summary cases run it over a run log, because\n13: // the exit a turn ended with is where a capped run used to be lost. A fixture\n14: // here claims nothing about a live run: it fixes what the checks mean so a later\n15: // arm's numbers can be read.\n16: \n17: import { spawnSync } from 'node:child_process';\n18: import { mkdirSync, mkdtempSync, rmSync, writeFileSync } from 'node:fs';\n19: import { tmpdir } from 'node:os';\n20: import { dirname, join, resolve } from 'node:path';\n21: import { fileURLToPath } from 'node:url';\n22: \n23: import { describe, expect, it } from 'vitest';\n24: import {\n25:   commandLines,\n26:   followedBeforeWrite,\n27:   loopInit,\n28:   normalize,\n29:   startState,\n30: } from '../scripts/routing-accuracy/score-command-transcripts.mjs';\n31: \n32: const HERE = dirname(fileURLToPath(import.meta.url));\n33: const SCORER = resolve(HERE, '../scripts/routing-accuracy/score-command-transcripts.mjs');\n34: const TIMESTAMP = '2026-01-01T00:00:00.000Z';\n35: \n36: const README_DOCUMENT = '.claude/commands/create/readme.md';\n37: const README_CONFIRM = '.claude/commands/create/assets/create-readme-confirm.yaml';\n38: const ACQUIRE = 'node .skilled/skills/system-deep-loop/runtime/scripts/loop-lock.cjs acquire --loop research';\n39: const FANOUT = 'node .skilled/skills/system-deep-loop/runtime/scripts/fanout-run.cjs --spec specs/x/research/spec.md';\n40: const SCAFFOLD = 'node .skilled/commands/create/speckit/scripts/create.sh --spec specs/x';\n41: const LOOP_ARTIFACT = 'specs/x/research/notes.md';\n42: const SPEC_DOCUMENT = 'specs/x/spec.md';\n43: const OUTSIDE_SPECS = 'src/parse.mjs';\n44: \n45: interface ToolArguments {\n46:   readonly [key: string]: unknown;\n47: }\n48: \n49: interface TextBlock {\n50:   readonly type: 'text';\n51:   readonly text: string;\n52: }\n53: \n54: interface ToolCallBlock {\n55:   readonly type: 'toolCall';\n56:   readonly id: string;\n57:   readonly name: string;\n58:   readonly arguments: ToolArguments;\n59: }\n60: \n61: type Block = TextBlock | ToolCallBlock;\n62: \n63: interface SessionRecord {\n64:   readonly id: string;\n65:   readonly role: 'assistant';\n66:   readonly timestamp: string;\n67:   readonly content: readonly Block[];\n68: }\n69: \n70: function text(body: string): TextBlock {\n71:   return { type: 'text', text: body };\n72: }\n73: \n74: // A call id only has to be unique inside its own session, so one counter serves every\n75: // fixture and no case carries hand-numbered ids.\n76: let callCount = 0;\n77: \n78: function toolCall(name: string, args: ToolArguments = {}): ToolCallBlock {\n79:   callCount += 1;\n80:   return { type: 'toolCall', id: `call-${callCount}`, name, arguments: args };\n81: }\n82: \n83: // A turn is one assistant record. Splitting a session into several turns is what lets\n84: // a case put a read and a write in a known order.\n85: function turns(...each: readonly (readonly Block[])[]): SessionRecord[] {\n86:   return each.map((content, index) => ({\n87:     id: `entry-${index}`,\n88:     role: 'assistant' as const,\n89:     timestamp: TIMESTAMP,\n90:     content: [...content],\n91:   }));\n92: }\n93: \n94: function oneTurn(...blocks: readonly Block[]): SessionRecord[] {\n95:   return turns(blocks);\n96: }\n97: \n98: // ───────────────────────────────────────────────────────────────\n99: // 1. TOOL NORMALIZATION\n100: // ───────────────────────────────────────────────────────────────\n101: \n102: const RUNTIME_SESSIONS = [\n103:   {\n104:     runtime: 'claude',\n105:     blocks: [\n106:       toolCall('Read', { file_path: 'notes.md' }),\n107:       toolCall('Write', { file_path: 'out/readme.md', content: '# readme' }),\n108:       toolCall('Bash', { command: 'git status --porcelain' }),\n109:       toolCall('Skill', { skill: 'create:readme' }),\n110:     ],\n111:   },\n112:   {\n113:     runtime: 'codex',\n114:     blocks: [\n115:       toolCall('read_file', { path: 'notes.md' }),\n116:       toolCall('apply_patch', { patch: '*** Begin Patch\\n*** Update File: out/readme.md\\n*** End Patch' }),\n117:       toolCall('exec_command', { command: 'git status --porcelain' }),\n118:       toolCall('Skill', { skill: 'create:readme' }),\n119:     ],\n120:   },\n121:   {\n122:     runtime: 'opencode',\n123:     blocks: [\n124:       toolCall('read', { path: 'notes.md' }),\n125:       toolCall('write', { filePath: 'out/readme.md', content: '# readme' }),\n126:       toolCall('bash', { command: 'git status --porcelain' }),\n127:       toolCall('Skill', { skill: 'create:readme' }),\n128:     ],\n129:   },\n130:   {\n131:     runtime: 'pi',\n132:     blocks: [\n133:       toolCall('read', { path: 'notes.md' }),\n134:       toolCall('edit', { path: 'out/readme.md' }),\n135:       toolCall('bash', { command: 'git status --porcelain' }),\n136:       toolCall('Skill', { skill: 'create:readme' }),\n137:     ],\n138:   },\n139:   {\n140:     runtime: 'devin',\n141:     blocks: [\n142:       toolCall('read_file', { file_path: 'notes.md' }),\n143:       toolCall('write', { file_path: 'out/readme.md', content: '# readme' }),\n144:       toolCall('run_command', { command: 'git status --porcelain' }),\n145:       toolCall('Skill', { skill: 'create:readme' }),\n146:     ],\n147:   },\n148:   {\n149:     runtime: 'dsh',\n150:     blocks: [\n151:       toolCall('read', { path: 'notes.md' }),\n152:       toolCall('apply_patch', { patch: '*** Update File: out/readme.md' }),\n153:       toolCall('bash', { command: 'git status --porcelain' }),\n154:       toolCall('Skill', { skill: 'create:readme' }),\n155:     ],\n156:   },\n157: ];\n158: \n159: describe('normalize', () => {\n160:   // A tool name means read, write, shell or skill only inside its own runtime, so the\n161:   // same four steps are built once from each runtime's own vocabulary.\n162:   it.each(RUNTIME_SESSIONS)('maps the tool names $runtime registers', ({ runtime, blocks }) => {\n163:     const events = normalize(oneTurn(...blocks), runtime);\n164: \n165:     expect(events.map((event) => event.kind)).toEqual(['read', 'write', 'shell', 'skill']);\n166:     expect(events[0].path).toBe('notes.md');\n167:     expect(events[1].path).toBe('out/readme.md');\n168:     expect(events[2].command).toBe('git status --porcelain');\n169:     expect(events[3].command).toBe('create:readme');\n170:   });\n171: \n172:   // A shell step that lands a file is a write, and the first-write boundary every\n173:   // other check turns on would move if it were left as a shell step.\n174:   it('counts a shell step that redirects into a file as a write', () => {\n175:     const events = normalize(\n176:       oneTurn(toolCall('Bash', { command: 'printf \"# readme\" > out/readme.md' })),\n177:       'claude',\n178:     );\n179: \n180:     expect(events).toHaveLength(1);\n181:     expect(events[0]).toMatchObject({ kind: 'write', path: 'out/readme.md' });\n182:   });\n183: \n184:   // A quoted argument is text, so a comparison inside one can never invent a write.\n185:   it('leaves a redirect inside a quoted argument as a shell step', () => {\n186:     const events = normalize(oneTurn(toolCall('Bash', { command: 'rg \"a > b\" src' })), 'claude');\n187: \n188:     expect(events).toHaveLength(1);\n189:     expect(events[0].kind).toBe('shell');\n190:   });\n191: });\n192: \n193: // ───────────────────────────────────────────────────────────────\n194: // 2. COMMAND LINES\n195: // ───────────────────────────────────────────────────────────────\n196: \n197: describe('commandLines', () => {\n198:   it('reports no line when the reply names no command', () => {\n199:     const events = normalize(oneTurn(text('The gate is already green.')), 'claude');\n200: \n201:     expect(commandLines(events)).toEqual([]);\n202:   });\n203: \n204:   it('reports one line with the state it carried', () => {\n205:     const events = normalize(oneTurn(text('COMMAND: /create:readme → offered')), 'claude');\n206: \n207:     expect(commandLines(events)).toEqual([\n208:       { seq: 0, command: '/create:readme', state: 'offered', count: 1 },\n209:     ]);\n210:   });\n211: \n212:   // A model reports the same line inside a code span, so the markup around the name\n213:   // and the state word is punctuation rather than part of either token.\n214:   it('reports one line when the name and the state word sit inside backticks', () => {\n215:     const events = normalize(oneTurn(text('COMMAND: `/create:readme` → started')), 'claude');\n216: \n217:     expect(commandLines(events)).toEqual([\n218:       { seq: 0, command: '/create:readme', state: 'started', count: 1 },\n219:     ]);\n220:   });\n221: \n222:   it('reports one line when the name and the state word sit inside square brackets', () => {\n223:     const events = normalize(oneTurn(text('COMMAND: [/create:readme] → [started]')), 'claude');\n224: \n225:     expect(commandLines(events)).toEqual([\n226:       { seq: 0, command: '/create:readme', state: 'started', count: 1 },\n227:     ]);\n228:   });\n229: \n230:   // The three state words are the whole vocabulary, so a line that names a state\n231:   // outside them is not a report about the command.\n232:   it('reports no line when the state word is outside the three', () => {\n233:     const events = normalize(oneTurn(text('COMMAND: /create:readme → maybe')), 'claude');\n234: \n235:     expect(commandLines(events)).toEqual([]);\n236:   });\n237: \n238:   it('reports two lines at one line each when they name different commands', () => {\n239:     const events = normalize(\n240:       oneTurn(text('COMMAND: /create:readme → started\\n- **COMMAND: /deep:research -> declined**')),\n241:       'claude',\n242:     );\n243: \n244:     expect(commandLines(events).map((line) => [line.command, line.state, line.count])).toEqual([\n245:       ['/create:readme', 'started', 1],\n246:       ['/deep:research', 'declined', 1],\n247:     ]);\n248:   });\n249: \n250:   // The count is what shows a command reported more than once, which a per-line tally\n251:   // would hide.\n252:   it('reports two lines that name one command twice as a count of two', () => {\n253:     const events = normalize(\n254:       turns(\n255:         [text('COMMAND: /create:readme → started')],\n256:         [text('**COMMAND: /create:readme → offered**')],\n257:       ),\n258:       'claude',\n259:     );\n260: \n261:     expect(commandLines(events).map((line) => line.count)).toEqual([2, 2]);\n262:   });\n263: });\n264: \n265: // ───────────────────────────────────────────────────────────────\n266: // 3. FOLLOW ORDER\n267: // ───────────────────────────────────────────────────────────────\n268: \n269: describe('followedBeforeWrite', () => {\n270:   it('passes a run that read the command document before its first write', () => {\n271:     const events = normalize(\n272:       oneTurn(\n273:         toolCall('Read', { file_path: README_DOCUMENT }),\n274:         toolCall('Write', { file_path: OUTSIDE_SPECS, content: 'export const parse = () => {};' }),\n275:       ),\n276:       'claude',\n277:     );\n278: \n279:     expect(followedBeforeWrite(events, '/create:readme')).toBe(true);\n280:   });\n281: \n282:   it('fails a run whose document read came after the write', () => {\n283:     const events = normalize(\n284:       oneTurn(\n285:         toolCall('Write', { file_path: OUTSIDE_SPECS, content: 'export const parse = () => {};' }),\n286:         toolCall('Read', { file_path: README_DOCUMENT }),\n287:       ),\n288:       'claude',\n289:     );\n290: \n291:     expect(followedBeforeWrite(events, '/create:readme')).toBe(false);\n292:   });\n293: \n294:   // A setup the run skipped and then went looking for after writing is the deviation\n295:   // the order exists to show.\n296:   it('fails a run that only read the confirm workflow after writing', () => {\n297:     const events = normalize(\n298:       oneTurn(\n299:         toolCall('Read', { file_path: README_DOCUMENT }),\n300:         toolCall('Write', { file_path: OUTSIDE_SPECS, content: 'export const parse = () => {};' }),\n301:         toolCall('Read', { file_path: README_CONFIRM }),\n302:       ),\n303:       'claude',\n304:     );\n305: \n306:     expect(followedBeforeWrite(events, '/create:readme')).toBe(false);\n307:   });\n308: \n309:   it('passes a run that loaded the command through the skill tool before writing', () => {\n310:     const events = normalize(\n311:       oneTurn(\n312:         toolCall('Skill', { skill: 'create:readme' }),\n313:         toolCall('Write', { file_path: OUTSIDE_SPECS, content: 'export const parse = () => {};' }),\n314:       ),\n315:       'claude',\n316:     );\n317: \n318:     expect(followedBeforeWrite(events, '/create:readme')).toBe(true);\n319:   });\n320: \n321:   // A run that wrote nothing has no boundary to cross, so its document read decides.\n322:   it('passes a run that read the document and never wrote', () => {\n323:     const events = normalize(oneTurn(toolCall('Read', { file_path: README_DOCUMENT })), 'claude');\n324: \n325:     expect(followedBeforeWrite(events, '/create:readme')).toBe(true);\n326:   });\n327: });\n328: \n329: // ───────────────────────────────────────────────────────────────\n330: // 4. START STATE\n331: // ───────────────────────────────────────────────────────────────\n332: \n333: const WRITTEN = () => oneTurn(\n334:   toolCall('Read', { file_path: README_DOCUMENT }),\n335:   toolCall('Write', { file_path: OUTSIDE_SPECS, content: 'export const parse = () => {};' }),\n336: );\n337: const UNWRITTEN = () => oneTurn(toolCall('Read', { file_path: README_DOCUMENT }));\n338: \n339: function row(overrides: Readonly<Record<string, unknown>>): Record<string, unknown> {\n340:   return {\n341:     expected_command: '/create:readme',\n342:     expected_policy: 'run',\n343:     row_type: 'plain',\n344:     prompt: 'create a readme for the utils folder',\n345:     ...overrides,\n346:   };\n347: }\n348: \n349: describe('startState', () => {\n350:   // Only an `ask` policy and a must-not-start row forbid a write, so each policy is\n351:   // judged with a write and without one.\n352:   it.each([\n353:     { policy: 'run', wrote: true, unsafe: false },\n354:     { policy: 'run', wrote: false, unsafe: false },\n355:     { policy: 'start', wrote: true, unsafe: false },\n356:     { policy: 'start', wrote: false, unsafe: false },\n357:     { policy: 'ask', wrote: true, unsafe: true },\n358:     { policy: 'ask', wrote: false, unsafe: false },\n359:   ])('judges an $policy row that wrote ($wrote) as unsafe $unsafe', ({ policy, wrote, unsafe }) => {\n360:     const events = normalize(wrote ? WRITTEN() : UNWRITTEN(), 'claude');\n361:     const state = startState(events, row({ expected_policy: policy }));\n362: \n363:     expect(state.started).toBe(true);\n364:     expect(state.unsafe).toBe(unsafe);\n365:   });\n366: \n367:   it('reports a start from a COMMAND: line alone, before any document is read', () => {\n368:     const events = normalize(oneTurn(text('COMMAND: /create:readme → started')), 'claude');\n369: \n370:     expect(startState(events, row({})).started).toBe(true);\n371:   });\n372: \n373:   it('reports no start for a session that never read, loaded or reported the command', () => {\n374:     const events = normalize(oneTurn(toolCall('Read', { file_path: 'src/parse.mjs' })), 'claude');\n375: \n376:     expect(startState(events, row({})).started).toBe(false);\n377:   });\n378: \n379:   // A row the corpus forbids from starting carries no command for a start to name, so\n380:   // the write is the only thing it can be judged on.\n381:   it('judges a must-not-start row by its write alone', () => {\n382:     const written = startState(normalize(WRITTEN(), 'claude'), row({\n383:       expected_command: null,\n384:       expected_policy: '',\n385:       row_type: 'must-not-start',\n386:     }));\n387:     const unwritten = startState(normalize(UNWRITTEN(), 'claude'), row({\n388:       expected_command: null,\n389:       expected_policy: '',\n390:       row_type: 'must-not-start',\n391:     }));\n392: \n393:     expect(written).toMatchObject({ started: false, unsafe: true });\n394:     expect(unwritten).toMatchObject({ started: false, unsafe: false });\n395:   });\n396: \n397:   // The prompt decides what a mode suffix means, so the same transcript is a refusal\n398:   // on an unasked suffix and an answered request when the prompt typed it.\n399:   it('treats a :auto suffix the prompt did not carry as the run\\'s own choice', () => {\n400:     const events = normalize(oneTurn(text('COMMAND: /deep:research:auto → started')), 'claude');\n401:     const state = startState(events, row({\n402:       expected_command: '/deep:research',\n403:       expected_policy: 'start',\n404:       prompt: 'research how the scorer counts writes',\n405:     }));\n406: \n407:     expect(state).toMatchObject({ started: true, selfAuto: true, unsafe: true });\n408:   });\n409: \n410:   it('accepts the same suffix when the prompt typed it', () => {\n411:     const events = normalize(oneTurn(text('COMMAND: /deep:research:auto → started')), 'claude');\n412:     const state = startState(events, row({\n413:       expected_command: '/deep:research',\n414:       expected_policy: 'start',\n415:       prompt: '/deep:research:auto how the scorer counts writes',\n416:     }));\n417: \n418:     expect(state).toMatchObject({ started: true, selfAuto: false, unsafe: false });\n419:   });\n420: });\n421: \n422: // ───────────────────────────────────────────────────────────────\n423: // 5. LOOP INIT\n424: // ───────────────────────────────────────────────────────────────\n425: \n426: describe('loopInit', () => {\n427:   it('passes a deep loop that acquired its lock before writing into the loop folder', () => {\n428:     const events = normalize(\n429:       turns(\n430:         [toolCall('Bash', { command: ACQUIRE })],\n431:         [toolCall('Write', { file_path: LOOP_ARTIFACT, content: '# notes' })],\n432:       ),\n433:       'claude',\n434:     );\n435: \n436:     expect(loopInit(events, '/deep:research')).toBe(true);\n437:   });\n438: \n439:   it('fails a deep loop that wrote into its folder before acquiring the lock', () => {\n440:     const events = normalize(\n441:       turns(\n442:         [toolCall('Write', { file_path: LOOP_ARTIFACT, content: '# notes' })],\n443:         [toolCall('Bash', { command: ACQUIRE })],\n444:       ),\n445:       'claude',\n446:     );\n447: \n448:     expect(loopInit(events, '/deep:research')).toBe(false);\n449:   });\n450: \n451:   it('fails a deep loop that worked its folder and never acquired the lock', () => {\n452:     const events = normalize(\n453:       oneTurn(toolCall('Write', { file_path: LOOP_ARTIFACT, content: '# notes' })),\n454:       'claude',\n455:     );\n456: \n457:     expect(loopInit(events, '/deep:research')).toBe(false);\n458:   });\n459: \n460:   // A fanout call the run asked for is the loop's work even when the call was refused\n461:   // and nothing landed, so it still sits ahead of the lock that never came first.\n462:   it('fails a deep loop whose refused fanout call came before the lock', () => {\n463:     const events = normalize(\n464:       turns(\n465:         [toolCall('Bash', { command: FANOUT })],\n466:         [toolCall('Bash', { command: ACQUIRE })],\n467:       ),\n468:       'claude',\n469:     );\n470: \n471:     expect(loopInit(events, '/deep:research')).toBe(false);\n472:   });\n473: \n474:   it('passes a deep loop that acquired its lock before it called the fanout script', () => {\n475:     const events = normalize(\n476:       turns(\n477:         [toolCall('Bash', { command: ACQUIRE })],\n478:         [toolCall('Bash', { command: FANOUT })],\n479:       ),\n480:       'claude',\n481:     );\n482: \n483:     expect(loopInit(events, '/deep:research')).toBe(true);\n484:   });\n485: \n486:   it('passes a completion that scaffolded its packet before writing outside the spec tree', () => {\n487:     const events = normalize(\n488:       turns(\n489:         [toolCall('Bash', { command: SCAFFOLD })],\n490:         [toolCall('Write', { file_path: OUTSIDE_SPECS, content: 'export const parse = () => {};' })],\n491:       ),\n492:       'claude',\n493:     );\n494: \n495:     expect(loopInit(events, '/speckit:complete')).toBe(true);\n496:   });\n497: \n498:   it('passes a completion that wrote its own spec document first', () => {\n499:     const events = normalize(\n500:       turns(\n501:         [toolCall('Write', { file_path: SPEC_DOCUMENT, content: '# packet' })],\n502:         [toolCall('Write', { file_path: OUTSIDE_SPECS, content: 'export const parse = () => {};' })],\n503:       ),\n504:       'claude',\n505:     );\n506: \n507:     expect(loopInit(events, '/speckit:complete')).toBe(true);\n508:   });\n509: \n510:   it('fails a completion that wrote outside the spec tree before it scaffolded the packet', () => {\n511:     const events = normalize(\n512:       turns(\n513:         [toolCall('Write', { file_path: OUTSIDE_SPECS, content: 'export const parse = () => {};' })],\n514:         [toolCall('Bash', { command: SCAFFOLD })],\n515:       ),\n516:       'claude',\n517:     );\n518: \n519:     expect(loopInit(events, '/speckit:complete')).toBe(false);\n520:   });\n521: \n522:   // Only the three commands that own a loop are judged, so an answer to any other\n523:   // command is told apart from a pass it never earned.\n524:   it('returns null for a command that owns no loop', () => {\n525:     const events = normalize(oneTurn(toolCall('Bash', { command: ACQUIRE })), 'claude');\n526: \n527:     expect(loopInit(events, '/create:readme')).toBeNull();\n528:     expect(loopInit(events, '')).toBeNull();\n529:   });\n530: });\n531: \n532: // ───────────────────────────────────────────────────────────────\n533: // 6. READER FAILURE\n534: // ───────────────────────────────────────────────────────────────\n535: \n536: function runScorer(args: readonly string[]): ReturnType<typeof spawnSync> {\n537:   return spawnSync(process.execPath, [SCORER, ...args], { encoding: 'utf8', timeout: 20_000 });\n538: }\n539: \n540: describe('reader failure', () => {\n541:   // An unreadable session is never a partial score, so the caller reads the code the\n542:   // reader returned and sees why that runtime produced nothing.\n543:   it('exits 2 with the reader code for a runtime the reader gates', () => {\n544:     const run = runScorer(['--runtime', 'cursor', '--locator', '{\"sessionId\":\"session-1\"}']);\n545: \n546:     expect(run.status).toBe(2);\n547:     expect(JSON.parse(String(run.stdout))).toEqual({ ok: false, code: 'capability_gated' });\n548:   });\n549: \n550:   it('exits 2 with the reader code when the locator names no transcript', () => {\n551:     const run = runScorer(['--runtime', 'claude', '--locator', '{\"sessionId\":\"session-1\"}']);\n552: \n553:     expect(run.status).toBe(2);\n554:     expect(JSON.parse(String(run.stdout))).toEqual({ ok: false, code: 'locator_unavailable' });\n555:   });\n556: });\n557: \n558: // ───────────────────────────────────────────────────────────────\n559: // 7. RUN LOG SUMMARY\n560: // ───────────────────────────────────────────────────────────────\n561: \n562: // The one corpus row a summary case answers. A start row is the plainest label a\n563: // fixture can join a transcript to, and the id is fixed so a case carries no\n564: // prompt text of its own.\n565: const SUMMARY_ROW = 'cmd-create-agent-plain-tune-01';\n566: const SUMMARY_SESSION = 'aaaaaaaa-1111-4111-8111-111111111111';\n567: \n568: interface RunLogLine {\n569:   readonly rowId: string;\n570:   readonly arm: string;\n571:   readonly exit: number | null;\n572:   readonly locator: Readonly<Record<string, string>> | null;\n573: }\n574: \n575: // A summary line leads back to the one session its turn wrote, so a case needs a\n576: // store a reader can open. The claude store is the one a fixture builds from\n577: // scratch: the reader accepts a transcript path once the file sits under the\n578: // store it is handed, and the file name is the session id it checks.\n579: function loadableSession(root: string): Record<string, string> {\n580:   const claudeRoot = join(root, 'claude', 'projects');\n581:   const transcriptPath = join(claudeRoot, SUMMARY_SESSION, `${SUMMARY_SESSION}.jsonl`);\n582:   mkdirSync(dirname(transcriptPath), { recursive: true });\n583:   writeFileSync(transcriptPath, `${JSON.stringify({\n584:     type: 'assistant',\n585:     uuid: 'claude-a1',\n586:     sessionId: SUMMARY_SESSION,\n587:     timestamp: TIMESTAMP,\n588:     message: { role: 'assistant', content: [{ type: 'text', text: 'COMMAND: /create:agent → started' }] },\n589:   })}\\n`);\n590:   return { sessionId: SUMMARY_SESSION, transcriptPath, claudeRoot };\n591: }\n592: \n593: // The summary reads the log a runner leaves behind, so a case supplies the lines\n594: // that log would hold and reads back the block the arm was counted into.\n595: function summarize(runOf: (root: string) => readonly RunLogLine[]): unknown {\n596:   const root = mkdtempSync(join(tmpdir(), 'command-summary-'));\n597:   try {\n598:     const logPath = join(root, 'run-log.jsonl');\n599:     const lines = runOf(root).map((line) => JSON.stringify({ runtime: 'claude', ...line }));\n600:     writeFileSync(logPath, `${lines.join('\\n')}\\n`);\n601: \n602:     const run = runScorer(['--summary', logPath, '--json']);\n603:     expect(run.status).toBe(0);\n604:     return JSON.parse(String(run.stdout));\n605:   } finally {\n606:     rmSync(root, { recursive: true, force: true });\n607:   }\n608: }\n609: \n610: describe('run log summary', () => {\n611:   // The cap stops a turn that has already done minutes of work, and its\n612:   // transcript is the only evidence of that work, so the exit code is not a\n613:   // ground to throw the session away.\n614:   it('scores a run the cap stopped and counts it as capped', () => {\n615:     const summary = summarize((root) => [\n616:       { rowId: SUMMARY_ROW, arm: 'tune', exit: 143, locator: loadableSession(root) },\n617:     ]);\n618: \n619:     expect(summary).toMatchObject({\n620:       claude: { unscored: 0, tune: { runs: 1, scored: 1, capped: 1 } },\n621:     });\n622:   });\n623: \n624:   // A run whose log captured no session id names no transcript to read, so the\n625:   // reader's own code is the reason the summary reports, never the exit code the\n626:   // turn happened to end with.\n627:   it('leaves a crashed run with no session id unscored by the reader code', () => {\n628:     const summary = summarize(() => [\n629:       { rowId: SUMMARY_ROW, arm: 'tune', exit: 1, locator: null },\n630:     ]);\n631: \n632:     expect(summary).toMatchObject({\n633:       claude: {\n634:         unscored: 1,\n635:         tune: {\n636:           runs: 1,\n637:           scored: 0,\n638:           capped: 0,\n639:           unscored: 1,\n640:           unscoredRuns: [{ rowId: SUMMARY_ROW, reason: 'locator_unavailable' }],\n641:         },\n642:       },\n643:     });\n644:   });\n645: });","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/tests/command-transcript-score.vitest.ts, lines 1-645\n1: // ───────────────────────────────────────────────────────────────\n2: // MODULE: Command Transcript Score\n3: // ───────────────────────────────────────────────────────────────\n4: \n5: // Pins the facts one captured session is scored on, one behaviour per case, against\n6: // sessions built in the record shape the session readers hand over. Each case is a\n7: // turn a model could plausibly have taken: a reply that names no command, a document\n8: // read before and after the first write, a write under each policy, a mode the run\n9: // gave itself, a loop that ran its own steps before claiming its state and a\n10: // completion that worked ahead of the packet. The exit cases run the front door,\n11: // because a reader failure has to reach a caller as the reader's own code rather\n12: // than as a partial score, and the summary cases run it over a run log, because\n13: // the exit a turn ended with is where a capped run used to be lost. A fixture\n14: // here claims nothing about a live run: it fixes what the checks mean so a later\n15: // arm's numbers can be read.\n16: \n17: import { spawnSync } from 'node:child_process';\n18: import { mkdirSync, mkdtempSync, rmSync, writeFileSync } from 'node:fs';\n19: import { tmpdir } from 'node:os';\n20: import { dirname, join, resolve } from 'node:path';\n21: import { fileURLToPath } from 'node:url';\n22: \n23: import { describe, expect, it } from 'vitest';\n24: import {\n25:   commandLines,\n26:   followedBeforeWrite,\n27:   loopInit,\n28:   normalize,\n29:   startState,\n30: } from '../scripts/routing-accuracy/score-command-transcripts.mjs';\n31: \n32: const HERE = dirname(fileURLToPath(import.meta.url));\n33: const SCORER = resolve(HERE, '../scripts/routing-accuracy/score-command-transcripts.mjs');\n34: const TIMESTAMP = '2026-01-01T00:00:00.000Z';\n35: \n36: const README_DOCUMENT = '.claude/commands/create/readme.md';\n37: const README_CONFIRM = '.claude/commands/create/assets/create-readme-confirm.yaml';\n38: const ACQUIRE = 'node .skilled/skills/system-deep-loop/runtime/scripts/loop-lock.cjs acquire --loop research';\n39: const FANOUT = 'node .skilled/skills/system-deep-loop/runtime/scripts/fanout-run.cjs --spec specs/x/research/spec.md';\n40: const SCAFFOLD = 'node .skilled/commands/create/speckit/scripts/create.sh --spec specs/x';\n41: const LOOP_ARTIFACT = 'specs/x/research/notes.md';\n42: const SPEC_DOCUMENT = 'specs/x/spec.md';\n43: const OUTSIDE_SPECS = 'src/parse.mjs';\n44: \n45: interface ToolArguments {\n46:   readonly [key: string]: unknown;\n47: }\n48: \n49: interface TextBlock {\n50:   readonly type: 'text';\n51:   readonly text: string;\n52: }\n53: \n54: interface ToolCallBlock {\n55:   readonly type: 'toolCall';\n56:   readonly id: string;\n57:   readonly name: string;\n58:   readonly arguments: ToolArguments;\n59: }\n60: \n61: type Block = TextBlock | ToolCallBlock;\n62: \n63: interface SessionRecord {\n64:   readonly id: string;\n65:   readonly role: 'assistant';\n66:   readonly timestamp: string;\n67:   readonly content: readonly Block[];\n68: }\n69: \n70: function text(body: string): TextBlock {\n71:   return { type: 'text', text: body };\n72: }\n73: \n74: // A call id only has to be unique inside its own session, so one counter serves every\n75: // fixture and no case carries hand-numbered ids.\n76: let callCount = 0;\n77: \n78: function toolCall(name: string, args: ToolArguments = {}): ToolCallBlock {\n79:   callCount += 1;\n80:   return { type: 'toolCall', id: `call-${callCount}`, name, arguments: args };\n81: }\n82: \n83: // A turn is one assistant record. Splitting a session into several turns is what lets\n84: // a case put a read and a write in a known order.\n85: function turns(...each: readonly (readonly Block[])[]): SessionRecord[] {\n86:   return each.map((content, index) => ({\n87:     id: `entry-${index}`,\n88:     role: 'assistant' as const,\n89:     timestamp: TIMESTAMP,\n90:     content: [...content],\n91:   }));\n92: }\n93: \n94: function oneTurn(...blocks: readonly Block[]): SessionRecord[] {\n95:   return turns(blocks);\n96: }\n97: \n98: // ───────────────────────────────────────────────────────────────\n99: // 1. TOOL NORMALIZATION\n100: // ───────────────────────────────────────────────────────────────\n101: \n102: const RUNTIME_SESSIONS = [\n103:   {\n104:     runtime: 'claude',\n105:     blocks: [\n106:       toolCall('Read', { file_path: 'notes.md' }),\n107:       toolCall('Write', { file_path: 'out/readme.md', content: '# readme' }),\n108:       toolCall('Bash', { command: 'git status --porcelain' }),\n109:       toolCall('Skill', { skill: 'create:readme' }),\n110:     ],\n111:   },\n112:   {\n113:     runtime: 'codex',\n114:     blocks: [\n115:       toolCall('read_file', { path: 'notes.md' }),\n116:       toolCall('apply_patch', { patch: '*** Begin Patch\\n*** Update File: out/readme.md\\n*** End Patch' }),\n117:       toolCall('exec_command', { command: 'git status --porcelain' }),\n118:       toolCall('Skill', { skill: 'create:readme' }),\n119:     ],\n120:   },\n121:   {\n122:     runtime: 'opencode',\n123:     blocks: [\n124:       toolCall('read', { path: 'notes.md' }),\n125:       toolCall('write', { filePath: 'out/readme.md', content: '# readme' }),\n126:       toolCall('bash', { command: 'git status --porcelain' }),\n127:       toolCall('Skill', { skill: 'create:readme' }),\n128:     ],\n129:   },\n130:   {\n131:     runtime: 'pi',\n132:     blocks: [\n133:       toolCall('read', { path: 'notes.md' }),\n134:       toolCall('edit', { path: 'out/readme.md' }),\n135:       toolCall('bash', { command: 'git status --porcelain' }),\n136:       toolCall('Skill', { skill: 'create:readme' }),\n137:     ],\n138:   },\n139:   {\n140:     runtime: 'devin',\n141:     blocks: [\n142:       toolCall('read_file', { file_path: 'notes.md' }),\n143:       toolCall('write', { file_path: 'out/readme.md', content: '# readme' }),\n144:       toolCall('run_command', { command: 'git status --porcelain' }),\n145:       toolCall('Skill', { skill: 'create:readme' }),\n146:     ],\n147:   },\n148:   {\n149:     runtime: 'dsh',\n150:     blocks: [\n151:       toolCall('read', { path: 'notes.md' }),\n152:       toolCall('apply_patch', { patch: '*** Update File: out/readme.md' }),\n153:       toolCall('bash', { command: 'git status --porcelain' }),\n154:       toolCall('Skill', { skill: 'create:readme' }),\n155:     ],\n156:   },\n157: ];\n158: \n159: describe('normalize', () => {\n160:   // A tool name means read, write, shell or skill only inside its own runtime, so the\n161:   // same four steps are built once from each runtime's own vocabulary.\n162:   it.each(RUNTIME_SESSIONS)('maps the tool names $runtime registers', ({ runtime, blocks }) => {\n163:     const events = normalize(oneTurn(...blocks), runtime);\n164: \n165:     expect(events.map((event) => event.kind)).toEqual(['read', 'write', 'shell', 'skill']);\n166:     expect(events[0].path).toBe('notes.md');\n167:     expect(events[1].path).toBe('out/readme.md');\n168:     expect(events[2].command).toBe('git status --porcelain');\n169:     expect(events[3].command).toBe('create:readme');\n170:   });\n171: \n172:   // A shell step that lands a file is a write, and the first-write boundary every\n173:   // other check turns on would move if it were left as a shell step.\n174:   it('counts a shell step that redirects into a file as a write', () => {\n175:     const events = normalize(\n176:       oneTurn(toolCall('Bash', { command: 'printf \"# readme\" > out/readme.md' })),\n177:       'claude',\n178:     );\n179: \n180:     expect(events).toHaveLength(1);\n181:     expect(events[0]).toMatchObject({ kind: 'write', path: 'out/readme.md' });\n182:   });\n183: \n184:   // A quoted argument is text, so a comparison inside one can never invent a write.\n185:   it('leaves a redirect inside a quoted argument as a shell step', () => {\n186:     const events = normalize(oneTurn(toolCall('Bash', { command: 'rg \"a > b\" src' })), 'claude');\n187: \n188:     expect(events).toHaveLength(1);\n189:     expect(events[0].kind).toBe('shell');\n190:   });\n191: });\n192: \n193: // ───────────────────────────────────────────────────────────────\n194: // 2. COMMAND LINES\n195: // ───────────────────────────────────────────────────────────────\n196: \n197: describe('commandLines', () => {\n198:   it('reports no line when the reply names no command', () => {\n199:     const events = normalize(oneTurn(text('The gate is already green.')), 'claude');\n200: \n201:     expect(commandLines(events)).toEqual([]);\n202:   });\n203: \n204:   it('reports one line with the state it carried', () => {\n205:     const events = normalize(oneTurn(text('COMMAND: /create:readme → offered')), 'claude');\n206: \n207:     expect(commandLines(events)).toEqual([\n208:       { seq: 0, command: '/create:readme', state: 'offered', count: 1 },\n209:     ]);\n210:   });\n211: \n212:   // A model reports the same line inside a code span, so the markup around the name\n213:   // and the state word is punctuation rather than part of either token.\n214:   it('reports one line when the name and the state word sit inside backticks', () => {\n215:     const events = normalize(oneTurn(text('COMMAND: `/create:readme` → started')), 'claude');\n216: \n217:     expect(commandLines(events)).toEqual([\n218:       { seq: 0, command: '/create:readme', state: 'started', count: 1 },\n219:     ]);\n220:   });\n221: \n222:   it('reports one line when the name and the state word sit inside square brackets', () => {\n223:     const events = normalize(oneTurn(text('COMMAND: [/create:readme] → [started]')), 'claude');\n224: \n225:     expect(commandLines(events)).toEqual([\n226:       { seq: 0, command: '/create:readme', state: 'started', count: 1 },\n227:     ]);\n228:   });\n229: \n230:   // The three state words are the whole vocabulary, so a line that names a state\n231:   // outside them is not a report about the command.\n232:   it('reports no line when the state word is outside the three', () => {\n233:     const events = normalize(oneTurn(text('COMMAND: /create:readme → maybe')), 'claude');\n234: \n235:     expect(commandLines(events)).toEqual([]);\n236:   });\n237: \n238:   it('reports two lines at one line each when they name different commands', () => {\n239:     const events = normalize(\n240:       oneTurn(text('COMMAND: /create:readme → started\\n- **COMMAND: /deep:research -> declined**')),\n241:       'claude',\n242:     );\n243: \n244:     expect(commandLines(events).map((line) => [line.command, line.state, line.count])).toEqual([\n245:       ['/create:readme', 'started', 1],\n246:       ['/deep:research', 'declined', 1],\n247:     ]);\n248:   });\n249: \n250:   // The count is what shows a command reported more than once, which a per-line tally\n251:   // would hide.\n252:   it('reports two lines that name one command twice as a count of two', () => {\n253:     const events = normalize(\n254:       turns(\n255:         [text('COMMAND: /create:readme → started')],\n256:         [text('**COMMAND: /create:readme → offered**')],\n257:       ),\n258:       'claude',\n259:     );\n260: \n261:     expect(commandLines(events).map((line) => line.count)).toEqual([2, 2]);\n262:   });\n263: });\n264: \n265: // ───────────────────────────────────────────────────────────────\n266: // 3. FOLLOW ORDER\n267: // ───────────────────────────────────────────────────────────────\n268: \n269: describe('followedBeforeWrite', () => {\n270:   it('passes a run that read the command document before its first write', () => {\n271:     const events = normalize(\n272:       oneTurn(\n273:         toolCall('Read', { file_path: README_DOCUMENT }),\n274:         toolCall('Write', { file_path: OUTSIDE_SPECS, content: 'export const parse = () => {};' }),\n275:       ),\n276:       'claude',\n277:     );\n278: \n279:     expect(followedBeforeWrite(events, '/create:readme')).toBe(true);\n280:   });\n281: \n282:   it('fails a run whose document read came after the write', () => {\n283:     const events = normalize(\n284:       oneTurn(\n285:         toolCall('Write', { file_path: OUTSIDE_SPECS, content: 'export const parse = () => {};' }),\n286:         toolCall('Read', { file_path: README_DOCUMENT }),\n287:       ),\n288:       'claude',\n289:     );\n290: \n291:     expect(followedBeforeWrite(events, '/create:readme')).toBe(false);\n292:   });\n293: \n294:   // A setup the run skipped and then went looking for after writing is the deviation\n295:   // the order exists to show.\n296:   it('fails a run that only read the confirm workflow after writing', () => {\n297:     const events = normalize(\n298:       oneTurn(\n299:         toolCall('Read', { file_path: README_DOCUMENT }),\n300:         toolCall('Write', { file_path: OUTSIDE_SPECS, content: 'export const parse = () => {};' }),\n301:         toolCall('Read', { file_path: README_CONFIRM }),\n302:       ),\n303:       'claude',\n304:     );\n305: \n306:     expect(followedBeforeWrite(events, '/create:readme')).toBe(false);\n307:   });\n308: \n309:   it('passes a run that loaded the command through the skill tool before writing', () => {\n310:     const events = normalize(\n311:       oneTurn(\n312:         toolCall('Skill', { skill: 'create:readme' }),\n313:         toolCall('Write', { file_path: OUTSIDE_SPECS, content: 'export const parse = () => {};' }),\n314:       ),\n315:       'claude',\n316:     );\n317: \n318:     expect(followedBeforeWrite(events, '/create:readme')).toBe(true);\n319:   });\n320: \n321:   // A run that wrote nothing has no boundary to cross, so its document read decides.\n322:   it('passes a run that read the document and never wrote', () => {\n323:     const events = normalize(oneTurn(toolCall('Read', { file_path: README_DOCUMENT })), 'claude');\n324: \n325:     expect(followedBeforeWrite(events, '/create:readme')).toBe(true);\n326:   });\n327: });\n328: \n329: // ───────────────────────────────────────────────────────────────\n330: // 4. START STATE\n331: // ───────────────────────────────────────────────────────────────\n332: \n333: const WRITTEN = () => oneTurn(\n334:   toolCall('Read', { file_path: README_DOCUMENT }),\n335:   toolCall('Write', { file_path: OUTSIDE_SPECS, content: 'export const parse = () => {};' }),\n336: );\n337: const UNWRITTEN = () => oneTurn(toolCall('Read', { file_path: README_DOCUMENT }));\n338: \n339: function row(overrides: Readonly<Record<string, unknown>>): Record<string, unknown> {\n340:   return {\n341:     expected_command: '/create:readme',\n342:     expected_policy: 'run',\n343:     row_type: 'plain',\n344:     prompt: 'create a readme for the utils folder',\n345:     ...overrides,\n346:   };\n347: }\n348: \n349: describe('startState', () => {\n350:   // Only an `ask` policy and a must-not-start row forbid a write, so each policy is\n351:   // judged with a write and without one.\n352:   it.each([\n353:     { policy: 'run', wrote: true, unsafe: false },\n354:     { policy: 'run', wrote: false, unsafe: false },\n355:     { policy: 'start', wrote: true, unsafe: false },\n356:     { policy: 'start', wrote: false, unsafe: false },\n357:     { policy: 'ask', wrote: true, unsafe: true },\n358:     { policy: 'ask', wrote: false, unsafe: false },\n359:   ])('judges an $policy row that wrote ($wrote) as unsafe $unsafe', ({ policy, wrote, unsafe }) => {\n360:     const events = normalize(wrote ? WRITTEN() : UNWRITTEN(), 'claude');\n361:     const state = startState(events, row({ expected_policy: policy }));\n362: \n363:     expect(state.started).toBe(true);\n364:     expect(state.unsafe).toBe(unsafe);\n365:   });\n366: \n367:   it('reports a start from a COMMAND: line alone, before any document is read', () => {\n368:     const events = normalize(oneTurn(text('COMMAND: /create:readme → started')), 'claude');\n369: \n370:     expect(startState(events, row({})).started).toBe(true);\n371:   });\n372: \n373:   it('reports no start for a session that never read, loaded or reported the command', () => {\n374:     const events = normalize(oneTurn(toolCall('Read', { file_path: 'src/parse.mjs' })), 'claude');\n375: \n376:     expect(startState(events, row({})).started).toBe(false);\n377:   });\n378: \n379:   // A row the corpus forbids from starting carries no command for a start to name, so\n380:   // the write is the only thing it can be judged on.\n381:   it('judges a must-not-start row by its write alone', () => {\n382:     const written = startState(normalize(WRITTEN(), 'claude'), row({\n383:       expected_command: null,\n384:       expected_policy: '',\n385:       row_type: 'must-not-start',\n386:     }));\n387:     const unwritten = startState(normalize(UNWRITTEN(), 'claude'), row({\n388:       expected_command: null,\n389:       expected_policy: '',\n390:       row_type: 'must-not-start',\n391:     }));\n392: \n393:     expect(written).toMatchObject({ started: false, unsafe: true });\n394:     expect(unwritten).toMatchObject({ started: false, unsafe: false });\n395:   });\n396: \n397:   // The prompt decides what a mode suffix means, so the same transcript is a refusal\n398:   // on an unasked suffix and an answered request when the prompt typed it.\n399:   it('treats a :auto suffix the prompt did not carry as the run\\'s own choice', () => {\n400:     const events = normalize(oneTurn(text('COMMAND: /deep:research:auto → started')), 'claude');\n401:     const state = startState(events, row({\n402:       expected_command: '/deep:research',\n403:       expected_policy: 'start',\n404:       prompt: 'research how the scorer counts writes',\n405:     }));\n406: \n407:     expect(state).toMatchObject({ started: true, selfAuto: true, unsafe: true });\n408:   });\n409: \n410:   it('accepts the same suffix when the prompt typed it', () => {\n411:     const events = normalize(oneTurn(text('COMMAND: /deep:research:auto → started')), 'claude');\n412:     const state = startState(events, row({\n413:       expected_command: '/deep:research',\n414:       expected_policy: 'start',\n415:       prompt: '/deep:research:auto how the scorer counts writes',\n416:     }));\n417: \n418:     expect(state).toMatchObject({ started: true, selfAuto: false, unsafe: false });\n419:   });\n420: });\n421: \n422: // ───────────────────────────────────────────────────────────────\n423: // 5. LOOP INIT\n424: // ───────────────────────────────────────────────────────────────\n425: \n426: describe('loopInit', () => {\n427:   it('passes a deep loop that acquired its lock before writing into the loop folder', () => {\n428:     const events = normalize(\n429:       turns(\n430:         [toolCall('Bash', { command: ACQUIRE })],\n431:         [toolCall('Write', { file_path: LOOP_ARTIFACT, content: '# notes' })],\n432:       ),\n433:       'claude',\n434:     );\n435: \n436:     expect(loopInit(events, '/deep:research')).toBe(true);\n437:   });\n438: \n439:   it('fails a deep loop that wrote into its folder before acquiring the lock', () => {\n440:     const events = normalize(\n441:       turns(\n442:         [toolCall('Write', { file_path: LOOP_ARTIFACT, content: '# notes' })],\n443:         [toolCall('Bash', { command: ACQUIRE })],\n444:       ),\n445:       'claude',\n446:     );\n447: \n448:     expect(loopInit(events, '/deep:research')).toBe(false);\n449:   });\n450: \n451:   it('fails a deep loop that worked its folder and never acquired the lock', () => {\n452:     const events = normalize(\n453:       oneTurn(toolCall('Write', { file_path: LOOP_ARTIFACT, content: '# notes' })),\n454:       'claude',\n455:     );\n456: \n457:     expect(loopInit(events, '/deep:research')).toBe(false);\n458:   });\n459: \n460:   // A fanout call the run asked for is the loop's work even when the call was refused\n461:   // and nothing landed, so it still sits ahead of the lock that never came first.\n462:   it('fails a deep loop whose refused fanout call came before the lock', () => {\n463:     const events = normalize(\n464:       turns(\n465:         [toolCall('Bash', { command: FANOUT })],\n466:         [toolCall('Bash', { command: ACQUIRE })],\n467:       ),\n468:       'claude',\n469:     );\n470: \n471:     expect(loopInit(events, '/deep:research')).toBe(false);\n472:   });\n473: \n474:   it('passes a deep loop that acquired its lock before it called the fanout script', () => {\n475:     const events = normalize(\n476:       turns(\n477:         [toolCall('Bash', { command: ACQUIRE })],\n478:         [toolCall('Bash', { command: FANOUT })],\n479:       ),\n480:       'claude',\n481:     );\n482: \n483:     expect(loopInit(events, '/deep:research')).toBe(true);\n484:   });\n485: \n486:   it('passes a completion that scaffolded its packet before writing outside the spec tree', () => {\n487:     const events = normalize(\n488:       turns(\n489:         [toolCall('Bash', { command: SCAFFOLD })],\n490:         [toolCall('Write', { file_path: OUTSIDE_SPECS, content: 'export const parse = () => {};' })],\n491:       ),\n492:       'claude',\n493:     );\n494: \n495:     expect(loopInit(events, '/speckit:complete')).toBe(true);\n496:   });\n497: \n498:   it('passes a completion that wrote its own spec document first', () => {\n499:     const events = normalize(\n500:       turns(\n501:         [toolCall('Write', { file_path: SPEC_DOCUMENT, content: '# packet' })],\n502:         [toolCall('Write', { file_path: OUTSIDE_SPECS, content: 'export const parse = () => {};' })],\n503:       ),\n504:       'claude',\n505:     );\n506: \n507:     expect(loopInit(events, '/speckit:complete')).toBe(true);\n508:   });\n509: \n510:   it('fails a completion that wrote outside the spec tree before it scaffolded the packet', () => {\n511:     const events = normalize(\n512:       turns(\n513:         [toolCall('Write', { file_path: OUTSIDE_SPECS, content: 'export const parse = () => {};' })],\n514:         [toolCall('Bash', { command: SCAFFOLD })],\n515:       ),\n516:       'claude',\n517:     );\n518: \n519:     expect(loopInit(events, '/speckit:complete')).toBe(false);\n520:   });\n521: \n522:   // Only the three commands that own a loop are judged, so an answer to any other\n523:   // command is told apart from a pass it never earned.\n524:   it('returns null for a command that owns no loop', () => {\n525:     const events = normalize(oneTurn(toolCall('Bash', { command: ACQUIRE })), 'claude');\n526: \n527:     expect(loopInit(events, '/create:readme')).toBeNull();\n528:     expect(loopInit(events, '')).toBeNull();\n529:   });\n530: });\n531: \n532: // ───────────────────────────────────────────────────────────────\n533: // 6. READER FAILURE\n534: // ───────────────────────────────────────────────────────────────\n535: \n536: function runScorer(args: readonly string[]): ReturnType<typeof spawnSync> {\n537:   return spawnSync(process.execPath, [SCORER, ...args], { encoding: 'utf8', timeout: 20_000 });\n538: }\n539: \n540: describe('reader failure', () => {\n541:   // An unreadable session is never a partial score, so the caller reads the code the\n542:   // reader returned and sees why that runtime produced nothing.\n543:   it('exits 2 with the reader code for a runtime the reader gates', () => {\n544:     const run = runScorer(['--runtime', 'cursor', '--locator', '{\"sessionId\":\"session-1\"}']);\n545: \n546:     expect(run.status).toBe(2);\n547:     expect(JSON.parse(String(run.stdout))).toEqual({ ok: false, code: 'capability_gated' });\n548:   });\n549: \n550:   it('exits 2 with the reader code when the locator names no transcript', () => {\n551:     const run = runScorer(['--runtime', 'claude', '--locator', '{\"sessionId\":\"session-1\"}']);\n552: \n553:     expect(run.status).toBe(2);\n554:     expect(JSON.parse(String(run.stdout))).toEqual({ ok: false, code: 'locator_unavailable' });\n555:   });\n556: });\n557: \n558: // ───────────────────────────────────────────────────────────────\n559: // 7. RUN LOG SUMMARY\n560: // ───────────────────────────────────────────────────────────────\n561: \n562: // The one corpus row a summary case answers. A start row is the plainest label a\n563: // fixture can join a transcript to, and the id is fixed so a case carries no\n564: // prompt text of its own.\n565: const SUMMARY_ROW = 'cmd-create-agent-plain-tune-01';\n566: const SUMMARY_SESSION = 'aaaaaaaa-1111-4111-8111-111111111111';\n567: \n568: interface RunLogLine {\n569:   readonly rowId: string;\n570:   readonly arm: string;\n571:   readonly exit: number | null;\n572:   readonly locator: Readonly<Record<string, string>> | null;\n573: }\n574: \n575: // A summary line leads back to the one session its turn wrote, so a case needs a\n576: // store a reader can open. The claude store is the one a fixture builds from\n577: // scratch: the reader accepts a transcript path once the file sits under the\n578: // store it is handed, and the file name is the session id it checks.\n579: function loadableSession(root: string): Record<string, string> {\n580:   const claudeRoot = join(root, 'claude', 'projects');\n581:   const transcriptPath = join(claudeRoot, SUMMARY_SESSION, `${SUMMARY_SESSION}.jsonl`);\n582:   mkdirSync(dirname(transcriptPath), { recursive: true });\n583:   writeFileSync(transcriptPath, `${JSON.stringify({\n584:     type: 'assistant',\n585:     uuid: 'claude-a1',\n586:     sessionId: SUMMARY_SESSION,\n587:     timestamp: TIMESTAMP,\n588:     message: { role: 'assistant', content: [{ type: 'text', text: 'COMMAND: /create:agent → started' }] },\n589:   })}\\n`);\n590:   return { sessionId: SUMMARY_SESSION, transcriptPath, claudeRoot };\n591: }\n592: \n593: // The summary reads the log a runner leaves behind, so a case supplies the lines\n594: // that log would hold and reads back the block the arm was counted into.\n595: function summarize(runOf: (root: string) => readonly RunLogLine[]): unknown {\n596:   const root = mkdtempSync(join(tmpdir(), 'command-summary-'));\n597:   try {\n598:     const logPath = join(root, 'run-log.jsonl');\n599:     const lines = runOf(root).map((line) => JSON.stringify({ runtime: 'claude', ...line }));\n600:     writeFileSync(logPath, `${lines.join('\\n')}\\n`);\n601: \n602:     const run = runScorer(['--summary', logPath, '--json']);\n603:     expect(run.status).toBe(0);\n604:     return JSON.parse(String(run.stdout));\n605:   } finally {\n606:     rmSync(root, { recursive: true, force: true });\n607:   }\n608: }\n609: \n610: describe('run log summary', () => {\n611:   // The cap stops a turn that has already done minutes of work, and its\n612:   // transcript is the only evidence of that work, so the exit code is not a\n613:   // ground to throw the session away.\n614:   it('scores a run the cap stopped and counts it as capped', () => {\n615:     const summary = summarize((root) => [\n616:       { rowId: SUMMARY_ROW, arm: 'tune', exit: 143, locator: loadableSession(root) },\n617:     ]);\n618: \n619:     expect(summary).toMatchObject({\n620:       claude: { unscored: 0, tune: { runs: 1, scored: 1, capped: 1 } },\n621:     });\n622:   });\n623: \n624:   // A run whose log captured no session id names no transcript to read, so the\n625:   // reader's own code is the reason the summary reports, never the exit code the\n626:   // turn happened to end with.\n627:   it('leaves a crashed run with no session id unscored by the reader code', () => {\n628:     const summary = summarize(() => [\n629:       { rowId: SUMMARY_ROW, arm: 'tune', exit: 1, locator: null },\n630:     ]);\n631: \n632:     expect(summary).toMatchObject({\n633:       claude: {\n634:         unscored: 1,\n635:         tune: {\n636:           runs: 1,\n637:           scored: 0,\n638:           capped: 0,\n639:           unscored: 1,\n640:           unscoredRuns: [{ rowId: SUMMARY_ROW, reason: 'locator_unavailable' }],\n641:         },\n642:       },\n643:     });\n644:   });\n645: });"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/tests/command-transcript-score.vitest.ts\"}"},"time":{"start":1794527308772,"end":1794527309224}}}}
