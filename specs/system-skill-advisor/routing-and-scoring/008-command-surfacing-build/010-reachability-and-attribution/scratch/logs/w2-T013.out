"token\": \"false\"\n    }\n  ],\n  \"indexHash\": \"cac6622b1df8eae3cf5fe37681108fd2e890dfeb637c88211608313d0c4227cd\",\n  \"manifestHash\": \"c243be4138be26b030af5a965ddc587955809ebe6ccd694e69601c9e81a327a8\",\n  \"normalizedQuery\": \"in dr section 5 and in the prompt advisor mjs row of da state that the bundle registers the prompt advisor unless its row flag is false\",\n  \"results\": [],\n  \"schemaVersion\": 2,\n  \"specFolder\": null,\n  \"tokens\": [\n    \"section\",\n    \"and\",\n    \"the\",\n    \"prompt\",\n    \"advisor\",\n    \"mjs\",\n    \"row\",\n    \"state\"\n  ],\n  \"totalCandidates\": 0,\n  \"truncated\": false,\n  \"staleFallback\": {\n    \"available\": true,\n    \"files\": 232,\n    \"matches\": 0,\n    \"paths\": [],\n    \"truncated\": false\n  }\n}\n"},{"type":"text","text":"Exit code: 1"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"node .skilled/skills/system-spec-kit/runtime/cli/retrieval/lookup-trigger-index.mjs --json --scoring-only -- \\\"In DR section 5 and in the prompt-advisor.mjs row of DA state that the bundle registers the prompt advisor unless its row flag is false\\\"\",\"workdir\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research\"}"},"time":{"start":1794528106998,"end":1794528109308}}}}
