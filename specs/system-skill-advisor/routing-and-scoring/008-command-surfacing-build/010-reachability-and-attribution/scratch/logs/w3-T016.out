const G2_FIXTURE_DIRNAME = 'g2-fixture';\n704:const FIXTURE_TOKEN = '{fixture}';\n767:  return options.fixture ?? resolve(dirname(options.out), G2_FIXTURE_DIRNAME);\n772:function promptFor(rowId, fixture) {\n775:  return fixed.split(FIXTURE_TOKEN).join(fixture);\n844:    const locator = streamLocator(runtime.locator.field ?? null);\n845:    // The turn's own output is still shown, and the locator is read out of the\n849:      locator.push(chunk);\n853:    child.on('close', (exit) => settle({ exit, error: null, streamId: locator.value() }));\n1037:    locator: locatorFor(job.runtime, sessionId, reportedId),\n1074:    const prompt = promptFor(rowId, fixture);\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"59:// scorer reads it back from another checkout, so the locator records the resolved\n104:    locator: { kind: 'stream', field: 'session_id' },\n131:    locator: { kind: 'stream', field: 'thread_id' },\n159:    locator: { kind: 'stream', field: 'sessionID' },\n184:    locator: { kind: 'runner' },\n205:    locator: { kind: 'listing', args: ['list', '--format', 'json'] },\n235:    locator: { kind: 'store', list: dshSessionIds },\n261:// Session locator\n296:// this line holds no locator rather than that the run failed.\n315:  const source = runtime.locator;\n330:  return runtime.locator.kind === 'listing' || runtime.locator.kind === 'store';\n337:  return runtime.locator.kind === 'store'\n338:    ? runtime.locator.list()\n361:// confidence, so only a single added entry becomes the locator.\n370:// locator records the home the run used and the transcript stays findable from\n414:// One match is the turn's own transcript, while two leave the locator without a\n444:  const store = { dshHome: dshHome(), projectDir: PROJECT_DIR };\n448:function locatorFor(runtime, sessionId, reportedId) {\n449:  const source = runtime.locator;\n453:  if (source.kind === 'runner') return { sessionId, projectDir: PROJECT_DIR };\n458:  const locator = { sessionId: reportedId, projectDir: PROJECT_DIR };\n465:  if (transcriptPath !== null) locator.transcriptPath = transcriptPath;\n466:  return locator;\n703:const G2_FIXTURE_DIRNAME = 'g2-fixture';\n704:const FIXTURE_TOKEN = '{fixture}';\n767:  return options.fixture ?? resolve(dirname(options.out), G2_FIXTURE_DIRNAME);\n772:function promptFor(rowId, fixture) {\n775:  return fixed.split(FIXTURE_TOKEN).join(fixture);\n844:    const locator = streamLocator(runtime.locator.field ?? null);\n845:    // The turn's own output is still shown, and the locator is read out of the\n849:      locator.push(chunk);\n853:    child.on('close', (exit) => settle({ exit, error: null, streamId: locator.value() }));\n1037:    locator: locatorFor(job.runtime, sessionId, reportedId),\n1074:    const prompt = promptFor(rowId, fixture);\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"rg -n \\\"promptFor|FIXTURE|locator|projectDir\\\" .skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/run-command-behaviour.mjs | head -60\",\"workdir\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research\"}"},"time":{"start":1794528527204,"end":1794528527923}}}}
