{"type":"tool_use","timestamp":1794528520386,"sessionID":"ses_e2dc4377affeMLBMP15YBCIej5","part":{"partID":"prt_1d23c270e001V3WpY73D8tamVV","sessionID":"ses_e2dc4377affeMLBMP15YBCIej5","messageID":"msg_1d23c0701001j1cYG1tKTNbAm9","type":"tool","id":"call_c9e77a7510a2481cabdd906b","tool":"read","state":{"status":"completed","input":{"path":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/tests/command-offer.vitest.ts"},"output":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/tests/command-offer.vitest.ts, lines 1-110\n1: // ───────────────────────────────────────────────────────────────\n2: // MODULE: Command offer\n3: // ───────────────────────────────────────────────────────────────\n4: \n5: // The head is the only advisor text that names both the offered command and the\n6: // policy, so these cases pin each shape a live head takes, a command with a\n7: // policy, a command under an ambiguous head without one, and a head that names\n8: // no command at all. The replay case proves a checkout without the prompt hook\n9: // reports the miss, because a backfill off such a checkout has to stay readable\n10: // instead of throwing away the lines around it. The delivery cases pin the two\n11: // real answers a Claude transcript can give and the third answer a runtime with\n12: // no confirmed delivery point must give, so a later summary never reads a\n13: // missing record as a miss.\n14: \n15: import { mkdtempSync, rmSync, writeFileSync } from 'node:fs';\n16: import { tmpdir } from 'node:os';\n17: import { join } from 'node:path';\n18: \n19: import { describe, expect, it } from 'vitest';\n20: \n21: import { briefDelivered, parseOffer, replayOffer } from '../scripts/routing-accuracy/command-offer.mjs';\n22: \n23: const OFFERED_HEAD = 'Advisor: live; use sk-git → /doctor:git hooks (ask) 0.82/0.12 pass.';\n24: const AMBIGUOUS_HEAD = 'Advisor: live; ambiguous: /doctor:git hooks 0.82/0.12 vs sk-git 0.86/0.16 pass.';\n25: const NO_COMMAND_HEAD = 'Advisor: live; use command-spec-kit-plan 0.82/0.16 pass.';\n26: \n27: function writeTranscript(lines: unknown[]): { dir: string; transcriptPath: string } {\n28:   const dir = mkdtempSync(join(tmpdir(), 'command-offer-'));\n29:   const transcriptPath = join(dir, 'session.jsonl');\n30:   writeFileSync(transcriptPath, lines.map((line) => JSON.stringify(line)).join('\\n'));\n31:   return { dir, transcriptPath };\n32: }\n33: \n34: describe('parseOffer', () => {\n35:   it('reads the command and the policy a head offers', () => {\n36:     expect(parseOffer(OFFERED_HEAD)).toEqual({\n37:       offeredCommand: '/doctor:git hooks',\n38:       offeredPolicy: 'ask',\n39:     });\n40:   });\n41: \n42:   it('reads the command but no policy under an ambiguous head', () => {\n43:     expect(parseOffer(AMBIGUOUS_HEAD)).toEqual({\n44:       offeredCommand: '/doctor:git hooks',\n45:       offeredPolicy: null,\n46:     });\n47:   });\n48: \n49:   it('reads no command when the head names none', () => {\n50:     expect(parseOffer(NO_COMMAND_HEAD)).toEqual({\n51:       offeredCommand: null,\n52:       offeredPolicy: null,\n53:     });\n54:   });\n55: });\n56: \n57: describe('replayOffer', () => {\n58:   it('reports a checkout without the prompt hook instead of throwing', () => {\n59:     const checkoutDir = mkdtempSync(join(tmpdir(), 'command-offer-'));\n60:     try {\n61:       expect(replayOffer({ checkoutDir, prompt: 'create a readme', sessionId: 'offer-test' })).toEqual({\n62:         offeredCommand: null,\n63:         offeredPolicy: null,\n64:         offerError: 'hook_missing',\n65:       });\n66:     } finally {\n67:       rmSync(checkoutDir, { recursive: true, force: true });\n68:     }\n69:   });\n70: });\n71: \n72: describe('briefDelivered', () => {\n73:   it('finds the advisor context in a Claude transcript attachment', async () => {\n74:     const { dir, transcriptPath } = writeTranscript([\n75:       { type: 'user', message: { role: 'user', content: 'create a readme' } },\n76:       {\n77:         type: 'attachment',\n78:         attachment: {\n79:           type: 'hook_additional_context',\n80:           hookEvent: 'UserPromptSubmit',\n81:           content: [OFFERED_HEAD],\n82:         },\n83:       },\n84:     ]);\n85:     try {\n86:       await expect(briefDelivered({ runtime: 'claude', locator: { transcriptPath } })).resolves.toBe(true);\n87:     } finally {\n88:       rmSync(dir, { recursive: true, force: true });\n89:     }\n90:   });\n91: \n92:   it('returns false when the Claude transcript holds no advisor attachment', async () => {\n93:     const { dir, transcriptPath } = writeTranscript([\n94:       { type: 'user', message: { role: 'user', content: 'create a readme' } },\n95:       { type: 'attachment', attachment: { type: 'hook_additional_context', hookEvent: 'SessionStart', content: ['Session ready'] } },\n96:     ]);\n97:     try {\n98:       await expect(briefDelivered({ runtime: 'claude', locator: { transcriptPath } })).resolves.toBe(false);\n99:     } finally {\n100:       rmSync(dir, { recursive: true, force: true });\n101:     }\n102:   });\n103: \n104:   it('returns unknown for a runtime with no confirmed delivery point', async () => {\n105:     await expect(briefDelivered({\n106:       runtime: 'devin',\n107:       locator: { transcriptPath: join(tmpdir(), 'command-offer-devin.jsonl') },\n108:     })).resolves.toBe('unknown');\n109:   });\n110: });","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/tests/command-offer.vitest.ts, lines 1-110\n1: // ───────────────────────────────────────────────────────────────\n2: // MODULE: Command offer\n3: // ───────────────────────────────────────────────────────────────\n4: \n5: // The head is the only advisor text that names both the offered command and the\n6: // policy, so these cases pin each shape a live head takes, a command with a\n7: // policy, a command under an ambiguous head without one, and a head that names\n8: // no command at all. The replay case proves a checkout without the prompt hook\n9: // reports the miss, because a backfill off such a checkout has to stay readable\n10: // instead of throwing away the lines around it. The delivery cases pin the two\n11: // real answers a Claude transcript can give and the third answer a runtime with\n12: // no confirmed delivery point must give, so a later summary never reads a\n13: // missing record as a miss.\n14: \n15: import { mkdtempSync, rmSync, writeFileSync } from 'node:fs';\n16: import { tmpdir } from 'node:os';\n17: import { join } from 'node:path';\n18: \n19: import { describe, expect, it } from 'vitest';\n20: \n21: import { briefDelivered, parseOffer, replayOffer } from '../scripts/routing-accuracy/command-offer.mjs';\n22: \n23: const OFFERED_HEAD = 'Advisor: live; use sk-git → /doctor:git hooks (ask) 0.82/0.12 pass.';\n24: const AMBIGUOUS_HEAD = 'Advisor: live; ambiguous: /doctor:git hooks 0.82/0.12 vs sk-git 0.86/0.16 pass.';\n25: const NO_COMMAND_HEAD = 'Advisor: live; use command-spec-kit-plan 0.82/0.16 pass.';\n26: \n27: function writeTranscript(lines: unknown[]): { dir: string; transcriptPath: string } {\n28:   const dir = mkdtempSync(join(tmpdir(), 'command-offer-'));\n29:   const transcriptPath = join(dir, 'session.jsonl');\n30:   writeFileSync(transcriptPath, lines.map((line) => JSON.stringify(line)).join('\\n'));\n31:   return { dir, transcriptPath };\n32: }\n33: \n34: describe('parseOffer', () => {\n35:   it('reads the command and the policy a head offers', () => {\n36:     expect(parseOffer(OFFERED_HEAD)).toEqual({\n37:       offeredCommand: '/doctor:git hooks',\n38:       offeredPolicy: 'ask',\n39:     });\n40:   });\n41: \n42:   it('reads the command but no policy under an ambiguous head', () => {\n43:     expect(parseOffer(AMBIGUOUS_HEAD)).toEqual({\n44:       offeredCommand: '/doctor:git hooks',\n45:       offeredPolicy: null,\n46:     });\n47:   });\n48: \n49:   it('reads no command when the head names none', () => {\n50:     expect(parseOffer(NO_COMMAND_HEAD)).toEqual({\n51:       offeredCommand: null,\n52:       offeredPolicy: null,\n53:     });\n54:   });\n55: });\n56: \n57: describe('replayOffer', () => {\n58:   it('reports a checkout without the prompt hook instead of throwing', () => {\n59:     const checkoutDir = mkdtempSync(join(tmpdir(), 'command-offer-'));\n60:     try {\n61:       expect(replayOffer({ checkoutDir, prompt: 'create a readme', sessionId: 'offer-test' })).toEqual({\n62:         offeredCommand: null,\n63:         offeredPolicy: null,\n64:         offerError: 'hook_missing',\n65:       });\n66:     } finally {\n67:       rmSync(checkoutDir, { recursive: true, force: true });\n68:     }\n69:   });\n70: });\n71: \n72: describe('briefDelivered', () => {\n73:   it('finds the advisor context in a Claude transcript attachment', async () => {\n74:     const { dir, transcriptPath } = writeTranscript([\n75:       { type: 'user', message: { role: 'user', content: 'create a readme' } },\n76:       {\n77:         type: 'attachment',\n78:         attachment: {\n79:           type: 'hook_additional_context',\n80:           hookEvent: 'UserPromptSubmit',\n81:           content: [OFFERED_HEAD],\n82:         },\n83:       },\n84:     ]);\n85:     try {\n86:       await expect(briefDelivered({ runtime: 'claude', locator: { transcriptPath } })).resolves.toBe(true);\n87:     } finally {\n88:       rmSync(dir, { recursive: true, force: true });\n89:     }\n90:   });\n91: \n92:   it('returns false when the Claude transcript holds no advisor attachment', async () => {\n93:     const { dir, transcriptPath } = writeTranscript([\n94:       { type: 'user', message: { role: 'user', content: 'create a readme' } },\n95:       { type: 'attachment', attachment: { type: 'hook_additional_context', hookEvent: 'SessionStart', content: ['Session ready'] } },\n96:     ]);\n97:     try {\n98:       await expect(briefDelivered({ runtime: 'claude', locator: { transcriptPath } })).resolves.toBe(false);\n99:     } finally {\n100:       rmSync(dir, { recursive: true, force: true });\n101:     }\n102:   });\n103: \n104:   it('returns unknown for a runtime with no confirmed delivery point', async () => {\n105:     await expect(briefDelivered({\n106:       runtime: 'devin',\n107:       locator: { transcriptPath: join(tmpdir(), 'command-offer-devin.jsonl') },\n108:     })).resolves.toBe('unknown');\n109:   });\n110: });"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/tests/command-offer.vitest.ts\"}"},"time":{"start":1794528519950,"end":1794528520386}}}}
{"type":"tool_use","timestamp":1794528520399,"sessionID":"ses_e2dc4377affeMLBMP15YBCIej5","part":{"partID":"prt_1d23c2577001BUIYC4zia9dYbn","sessionID":"ses_e2dc4377affeMLBMP15YBCIej5","messageID":"msg_1d23c0701001j1cYG1tKTNbAm9","type":"tool","id":"call_9b05ca97812640d19f949210","tool":"read","state":{"status":"completed","input":{"path":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/command-offer.mjs"},"output":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/command-offer.mjs, lines 1-199\n1: // ───────────────────────────────────────────────────────────────\n2: // MODULE: Command offer from an advisor head\n3: // ───────────────────────────────────────────────────────────────\n4: //\n5: // A run line records which command the advisor offered and the policy it named,\n6: // so a start rate can be read as \"did the reader follow the offer\" rather than\n7: // only \"did a command run\". The offer is recovered by replaying the Claude\n8: // prompt hook after the turn, because the head is the only text that names both\n9: // the command and the policy, and a replay keeps the recorded value independent\n10: // of whatever the session reader happened to retain.\n11: //\n12: // A failed replay returns null fields plus an offerError, so a backfill over a\n13: // checkout without the hook, or a hook that crashes, still produces a readable\n14: // line instead of aborting the run.\n15: //\n16: // The offer alone cannot tell a reader who ignored it from a brief the session\n17: // never received, so the same module also reports whether the brief landed. A\n18: // runtime with no confirmed place to look reports `unknown` rather than a miss,\n19: // because a missing record there measures the reader, not the delivery.\n20: \n21: import { spawnSync } from 'node:child_process';\n22: import { existsSync, readFileSync } from 'node:fs';\n23: import { join } from 'node:path';\n24: \n25: const HOOK_RELATIVE = '.skilled/skills/system-spec-kit/runtime/dist/hooks/claude/user-prompt-submit.js';\n26: const OFFER_PATTERN = /\\/[a-z][a-z-]*:[a-z][a-z-]*(?: [a-z][a-z-]*)?/;\n27: const POLICY_PATTERN = /^ *(?:\\((run|start|ask)\\))/;\n28: const BRIEF_PATTERN = /Advisor: [a-z]+[;. ]/;\n29: const CLAUDE_ATTACHMENT_EVENT = 'UserPromptSubmit';\n30: const DEFAULT_TIMEOUT_MS = 30_000;\n31: const MAX_OUTPUT_BYTES = 1024 * 1024;\n32: \n33: function failedOffer(offerError) {\n34:   return { offeredCommand: null, offeredPolicy: null, offerError };\n35: }\n36: \n37: /**\n38:  * Read the command and the policy out of the first line of a head.\n39:  *\n40:  * The policy only counts when it directly follows the command, so a `(ask)`\n41:  * that belongs to a later clause cannot attach itself to an earlier match.\n42:  *\n43:  * @param {string} head - One line of advisor output.\n44:  * @returns {{ offeredCommand: string | null, offeredPolicy: string | null }}\n45:  */\n46: export function parseOffer(head) {\n47:   const text = typeof head === 'string' ? head : '';\n48:   const match = text.match(OFFER_PATTERN);\n49:   if (!match) {\n50:     return { offeredCommand: null, offeredPolicy: null };\n51:   }\n52:   const policy = text.slice(match.index + match[0].length).match(POLICY_PATTERN);\n53:   return {\n54:     offeredCommand: match[0],\n55:     offeredPolicy: policy ? policy[1] : null,\n56:   };\n57: }\n58: \n59: /**\n60:  * Replay the Claude prompt hook for one prompt and parse the offer it prints.\n61:  *\n62:  * The hook is resolved from the checkout rather than from this module, so a\n63:  * backfill records what that checkout's advisor would have offered at the time\n64:  * of the run, not what the current working copy happens to say.\n65:  *\n66:  * @param {object} options\n67:  * @param {string} options.checkoutDir - Root of the checkout whose hook runs.\n68:  * @param {string} options.prompt - The prompt to replay.\n69:  * @param {string} options.sessionId - Session id for the hook payload.\n70:  * @param {number} [options.timeoutMs] - Hook timeout before the replay fails.\n71:  * @returns {{ offeredCommand: string | null, offeredPolicy: string | null, offerError: string | null }}\n72:  */\n73: export function replayOffer({ checkoutDir, prompt, sessionId, timeoutMs = DEFAULT_TIMEOUT_MS }) {\n74:   const hookPath = join(checkoutDir, HOOK_RELATIVE);\n75:   if (!existsSync(hookPath)) {\n76:     return failedOffer('hook_missing');\n77:   }\n78: \n79:   const payload = {\n80:     prompt,\n81:     cwd: checkoutDir,\n82:     hook_event_name: 'UserPromptSubmit',\n83:     session_id: sessionId,\n84:   };\n85: \n86:   let result;\n87:   try {\n88:     result = spawnSync('node', [hookPath], {\n89:       cwd: checkoutDir,\n90:       input: JSON.stringify(payload),\n91:       encoding: 'utf8',\n92:       timeout: timeoutMs,\n93:       maxBuffer: MAX_OUTPUT_BYTES,\n94:     });\n95:   } catch {\n96:     return failedOffer('hook_failed');\n97:   }\n98: \n99:   if (result.error || result.status !== 0 || typeof result.stdout !== 'string') {\n100:     return failedOffer('hook_failed');\n101:   }\n102: \n103:   let output;\n104:   try {\n105:     output = JSON.parse(result.stdout);\n106:   } catch {\n107:     return failedOffer('hook_failed');\n108:   }\n109: \n110:   const context = output?.hookSpecificOutput?.additionalContext;\n111:   if (typeof context !== 'string') {\n112:     return failedOffer('no_head');\n113:   }\n114: \n115:   const [firstLine = ''] = context.split(/\\r?\\n/);\n116:   if (!firstLine.trim()) {\n117:     return failedOffer('no_head');\n118:   }\n119: \n120:   return { ...parseOffer(firstLine), offerError: null };\n121: }\n122: \n123: function contentHasBrief(content) {\n124:   if (typeof content === 'string') return BRIEF_PATTERN.test(content);\n125:   if (!Array.isArray(content)) return false;\n126:   return content.some((part) => {\n127:     if (typeof part === 'string') return BRIEF_PATTERN.test(part);\n128:     return typeof part?.text === 'string' && BRIEF_PATTERN.test(part.text);\n129:   });\n130: }\n131: \n132: // Neutral records keep their text in content blocks, and the block shape differs\n133: // by runtime, so the serialized record is the one place the brief is found\n134: // whichever block carries it.\n135: function recordsHaveBrief(records) {\n136:   return (Array.isArray(records) ? records : []).some((record) =>\n137:     BRIEF_PATTERN.test(JSON.stringify(record ?? null)));\n138: }\n139: \n140: /**\n141:  * Decide whether the advisor brief reached the session that ran the turn.\n142:  *\n143:  * A Claude transcript records the hook context as its own attachment line, so a\n144:  * missing attachment is a real miss. Pi keeps delivery in its session records\n145:  * and needs the caller's reader. Every other runtime has no confirmed record of\n146:  * delivery, so its answer stays `unknown` and never counts as a miss.\n147:  *\n148:  * @param {object} options\n149:  * @param {string} options.runtime - The measured runtime.\n150:  * @param {object|null} [options.locator] - The locator the run line recorded.\n151:  * @param {Function} [options.loadSession] - Reader for a runtime whose brief\n152:  *   lives in session records rather than a transcript file.\n153:  * @returns {Promise<boolean | 'unknown'>}\n154:  */\n155: export async function briefDelivered({ runtime, locator, loadSession } = {}) {\n156:   if (runtime === 'claude') {\n157:     const transcriptPath = locator?.transcriptPath;\n158:     if (typeof transcriptPath !== 'string' || transcriptPath.length === 0) {\n159:       return 'unknown';\n160:     }\n161: \n162:     let raw;\n163:     try {\n164:       raw = readFileSync(transcriptPath, 'utf8');\n165:     } catch {\n166:       return 'unknown';\n167:     }\n168: \n169:     for (const line of raw.split('\\n')) {\n170:       if (!line.trim()) continue;\n171:       let entry;\n172:       try {\n173:         entry = JSON.parse(line);\n174:       } catch {\n175:         continue;\n176:       }\n177:       if (entry?.type !== 'attachment') continue;\n178:       const attachment = entry.attachment;\n179:       if (attachment?.type !== 'hook_additional_context') continue;\n180:       if (attachment.hookEvent !== CLAUDE_ATTACHMENT_EVENT) continue;\n181:       if (contentHasBrief(attachment.content)) return true;\n182:     }\n183:     return false;\n184:   }\n185: \n186:   if (runtime === 'pi') {\n187:     if (typeof loadSession !== 'function') return 'unknown';\n188:     let loaded;\n189:     try {\n190:       loaded = await loadSession({ ...locator, runtime });\n191:     } catch {\n192:       return 'unknown';\n193:     }\n194:     if (!loaded?.ok) return 'unknown';\n195:     return recordsHaveBrief(loaded.records);\n196:   }\n197: \n198:   return 'unknown';\n199: }","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/command-offer.mjs, lines 1-199\n1: // ───────────────────────────────────────────────────────────────\n2: // MODULE: Command offer from an advisor head\n3: // ───────────────────────────────────────────────────────────────\n4: //\n5: // A run line records which command the advisor offered and the policy it named,\n6: // so a start rate can be read as \"did the reader follow the offer\" rather than\n7: // only \"did a command run\". The offer is recovered by replaying the Claude\n8: // prompt hook after the turn, because the head is the only text that names both\n9: // the command and the policy, and a replay keeps the recorded value independent\n10: // of whatever the session reader happened to retain.\n11: //\n12: // A failed replay returns null fields plus an offerError, so a backfill over a\n13: // checkout without the hook, or a hook that crashes, still produces a readable\n14: // line instead of aborting the run.\n15: //\n16: // The offer alone cannot tell a reader who ignored it from a brief the session\n17: // never received, so the same module also reports whether the brief landed. A\n18: // runtime with no confirmed place to look reports `unknown` rather than a miss,\n19: // because a missing record there measures the reader, not the delivery.\n20: \n21: import { spawnSync } from 'node:child_process';\n22: import { existsSync, readFileSync } from 'node:fs';\n23: import { join } from 'node:path';\n24: \n25: const HOOK_RELATIVE = '.skilled/skills/system-spec-kit/runtime/dist/hooks/claude/user-prompt-submit.js';\n26: const OFFER_PATTERN = /\\/[a-z][a-z-]*:[a-z][a-z-]*(?: [a-z][a-z-]*)?/;\n27: const POLICY_PATTERN = /^ *(?:\\((run|start|ask)\\))/;\n28: const BRIEF_PATTERN = /Advisor: [a-z]+[;. ]/;\n29: const CLAUDE_ATTACHMENT_EVENT = 'UserPromptSubmit';\n30: const DEFAULT_TIMEOUT_MS = 30_000;\n31: const MAX_OUTPUT_BYTES = 1024 * 1024;\n32: \n33: function failedOffer(offerError) {\n34:   return { offeredCommand: null, offeredPolicy: null, offerError };\n35: }\n36: \n37: /**\n38:  * Read the command and the policy out of the first line of a head.\n39:  *\n40:  * The policy only counts when it directly follows the command, so a `(ask)`\n41:  * that belongs to a later clause cannot attach itself to an earlier match.\n42:  *\n43:  * @param {string} head - One line of advisor output.\n44:  * @returns {{ offeredCommand: string | null, offeredPolicy: string | null }}\n45:  */\n46: export function parseOffer(head) {\n47:   const text = typeof head === 'string' ? head : '';\n48:   const match = text.match(OFFER_PATTERN);\n49:   if (!match) {\n50:     return { offeredCommand: null, offeredPolicy: null };\n51:   }\n52:   const policy = text.slice(match.index + match[0].length).match(POLICY_PATTERN);\n53:   return {\n54:     offeredCommand: match[0],\n55:     offeredPolicy: policy ? policy[1] : null,\n56:   };\n57: }\n58: \n59: /**\n60:  * Replay the Claude prompt hook for one prompt and parse the offer it prints.\n61:  *\n62:  * The hook is resolved from the checkout rather than from this module, so a\n63:  * backfill records what that checkout's advisor would have offered at the time\n64:  * of the run, not what the current working copy happens to say.\n65:  *\n66:  * @param {object} options\n67:  * @param {string} options.checkoutDir - Root of the checkout whose hook runs.\n68:  * @param {string} options.prompt - The prompt to replay.\n69:  * @param {string} options.sessionId - Session id for the hook payload.\n70:  * @param {number} [options.timeoutMs] - Hook timeout before the replay fails.\n71:  * @returns {{ offeredCommand: string | null, offeredPolicy: string | null, offerError: string | null }}\n72:  */\n73: export function replayOffer({ checkoutDir, prompt, sessionId, timeoutMs = DEFAULT_TIMEOUT_MS }) {\n74:   const hookPath = join(checkoutDir, HOOK_RELATIVE);\n75:   if (!existsSync(hookPath)) {\n76:     return failedOffer('hook_missing');\n77:   }\n78: \n79:   const payload = {\n80:     prompt,\n81:     cwd: checkoutDir,\n82:     hook_event_name: 'UserPromptSubmit',\n83:     session_id: sessionId,\n84:   };\n85: \n86:   let result;\n87:   try {\n88:     result = spawnSync('node', [hookPath], {\n89:       cwd: checkoutDir,\n90:       input: JSON.stringify(payload),\n91:       encoding: 'utf8',\n92:       timeout: timeoutMs,\n93:       maxBuffer: MAX_OUTPUT_BYTES,\n94:     });\n95:   } catch {\n96:     return failedOffer('hook_failed');\n97:   }\n98: \n99:   if (result.error || result.status !== 0 || typeof result.stdout !== 'string') {\n100:     return failedOffer('hook_failed');\n101:   }\n102: \n103:   let output;\n104:   try {\n105:     output = JSON.parse(result.stdout);\n106:   } catch {\n107:     return failedOffer('hook_failed');\n108:   }\n109: \n110:   const context = output?.hookSpecificOutput?.additionalContext;\n111:   if (typeof context !== 'string') {\n112:     return failedOffer('no_head');\n113:   }\n114: \n115:   const [firstLine = ''] = context.split(/\\r?\\n/);\n116:   if (!firstLine.trim()) {\n117:     return failedOffer('no_head');\n118:   }\n119: \n120:   return { ...parseOffer(firstLine), offerError: null };\n121: }\n122: \n123: function contentHasBrief(content) {\n124:   if (typeof content === 'string') return BRIEF_PATTERN.test(content);\n125:   if (!Array.isArray(content)) return false;\n126:   return content.some((part) => {\n127:     if (typeof part === 'string') return BRIEF_PATTERN.test(part);\n128:     return typeof part?.text === 'string' && BRIEF_PATTERN.test(part.text);\n129:   });\n130: }\n131: \n132: // Neutral records keep their text in content blocks, and the block shape differs\n133: // by runtime, so the serialized record is the one place the brief is found\n134: // whichever block carries it.\n135: function recordsHaveBrief(records) {\n136:   return (Array.isArray(records) ? records : []).some((record) =>\n137:     BRIEF_PATTERN.test(JSON.stringify(record ?? null)));\n138: }\n139: \n140: /**\n141:  * Decide whether the advisor brief reached the session that ran the turn.\n142:  *\n143:  * A Claude transcript records the hook context as its own attachment line, so a\n144:  * missing attachment is a real miss. Pi keeps delivery in its session records\n145:  * and needs the caller's reader. Every other runtime has no confirmed record of\n146:  * delivery, so its answer stays `unknown` and never counts as a miss.\n147:  *\n148:  * @param {object} options\n149:  * @param {string} options.runtime - The measured runtime.\n150:  * @param {object|null} [options.locator] - The locator the run line recorded.\n151:  * @param {Function} [options.loadSession] - Reader for a runtime whose brief\n152:  *   lives in session records rather than a transcript file.\n153:  * @returns {Promise<boolean | 'unknown'>}\n154:  */\n155: export async function briefDelivered({ runtime, locator, loadSession } = {}) {\n156:   if (runtime === 'claude') {\n157:     const transcriptPath = locator?.transcriptPath;\n158:     if (typeof transcriptPath !== 'string' || transcriptPath.length === 0) {\n159:       return 'unknown';\n160:     }\n161: \n162:     let raw;\n163:     try {\n164:       raw = readFileSync(transcriptPath, 'utf8');\n165:     } catch {\n166:       return 'unknown';\n167:     }\n168: \n169:     for (const line of raw.split('\\n')) {\n170:       if (!line.trim()) continue;\n171:       let entry;\n172:       try {\n173:         entry = JSON.parse(line);\n174:       } catch {\n175:         continue;\n176:       }\n177:       if (entry?.type !== 'attachment') continue;\n178:       const attachment = entry.attachment;\n179:       if (attachment?.type !== 'hook_additional_context') continue;\n180:       if (attachment.hookEvent !== CLAUDE_ATTACHMENT_EVENT) continue;\n181:       if (contentHasBrief(attachment.content)) return true;\n182:     }\n183:     return false;\n184:   }\n185: \n186:   if (runtime === 'pi') {\n187:     if (typeof loadSession !== 'function') return 'unknown';\n188:     let loaded;\n189:     try {\n190:       loaded = await loadSession({ ...locator, runtime });\n191:     } catch {\n192:       return 'unknown';\n193:     }\n194:     if (!loaded?.ok) return 'unknown';\n195:     return recordsHaveBrief(loaded.records);\n196:   }\n197: \n198:   return 'unknown';\n199: }"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/command-offer.mjs\"}"},"time":{"start":1794528519543,"end":1794528520399}}}}
