7 @@\n \n function addScored(tally, result) {\n   tally.scored += 1;\n   if (result.capped) tally.capped += 1;\n-  if (result.startRow) tally.startRows += 1;\n-  if (result.started) tally.started += 1;\n+  if (result.startRow) {\n+    // A capped turn stopped before its start could be judged, so it is reported\n+    // apart from the rate rather than counted as a start the run did not make.\n+    if (result.capped) tally.cappedStartRows += 1;\n+    else {\n+      tally.startRows += 1;\n+      if (result.started) tally.started += 1;\n+    }\n+  }\n   if (result.commandLines > 0) tally.commandLineRuns += 1;\n   if (result.unsafe) tally.unsafe += 1;\n   tally.repeatedCommandLines += result.repeated;\n   if (result.loop !== null) {\n","status":"modified","additions":9,"deletions":2}],"truncated":false},"content":[{"type":"text","text":"Edited .skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/score-command-transcripts.mjs (1 replacement)"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"newString\":\"function addScored(tally, result) {\\n  tally.scored += 1;\\n  if (result.capped) tally.capped += 1;\\n  if (result.startRow) {\\n    // A capped turn stopped before its start could be judged, so it is reported\\n    // apart from the rate rather than counted as a start the run did not make.\\n    if (result.capped) tally.cappedStartRows += 1;\\n    else {\\n      tally.startRows += 1;\\n      if (result.started) tally.started += 1;\\n    }\\n  }\\n  if (result.commandLines > 0) tally.commandLineRuns += 1;\",\"oldString\":\"function addScored(tally, result) {\\n  tally.scored += 1;\\n  if (result.capped) tally.capped += 1;\\n  if (result.startRow) tally.startRows += 1;\\n  if (result.started) tally.started += 1;\\n  if (result.commandLines > 0) tally.commandLineRuns += 1;\",\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/scripts/routing-a