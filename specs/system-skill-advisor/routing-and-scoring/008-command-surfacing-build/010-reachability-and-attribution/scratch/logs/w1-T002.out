{"type":"tool_use","timestamp":1794527282348,"sessionID":"ses_e2dd83c38ffe6oPXPzjHJBVHzf","part":{"partID":"prt_1d229432f001y7I2w67WkdByEz","sessionID":"ses_e2dd83c38ffe6oPXPzjHJBVHzf","messageID":"msg_1d22933da0016EN44uthqmHOJl","type":"tool","id":"call_7a8e22a5c0e44a6799d66804","tool":"read","state":{"status":"completed","input":{"path":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/bin/lib/launcher-ipc-bridge.cjs"},"output":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/bin/lib/launcher-ipc-bridge.cjs, lines 1-581\n1: // ╔══════════════════════════════════════════════════════════════════════════╗\n2: // ║ COMPONENT: Launcher IPC Bridge                                           ║\n3: // ╠══════════════════════════════════════════════════════════════════════════╣\n4: // ║ PURPOSE: Provides daemon IPC paths, probes, and JSON-RPC helpers.        ║\n5: // ╚══════════════════════════════════════════════════════════════════════════╝\n6: 'use strict';\n7: \n8: // ─────────────────────────────────────────────────────────────────────────────\n9: // 1. IMPORTS\n10: // ─────────────────────────────────────────────────────────────────────────────\n11: \n12: const fs = require('fs');\n13: const crypto = require('crypto');\n14: const net = require('net');\n15: const os = require('os');\n16: const path = require('path');\n17: const { StringDecoder } = require('string_decoder');\n18: \n19: // ─────────────────────────────────────────────────────────────────────────────\n20: // 2. CONSTANTS\n21: // ─────────────────────────────────────────────────────────────────────────────\n22: \n23: const SOCKET_FILE_NAME = 'daemon-ipc.sock';\n24: const DEFAULT_SKILL_ADVISOR_SOCKET_DIR = '/tmp/system-skill-advisor';\n25: // A unix domain socket address is bounded by sockaddr_un.sun_path: 104 bytes on\n26: // macOS, 108 on Linux. Take the smaller so one machine's socket path is every\n27: // machine's socket path. A service whose socket sits beside its database inherits\n28: // the checkout prefix, and a repository a few directories deep pushes it past the\n29: // limit. bind then fails with EINVAL, which names neither the length nor the path,\n30: // so the daemon looks unreachable rather than misconfigured.\n31: const SUN_PATH_LIMIT = 104;\n32: const DEFAULT_PROBE_TIMEOUT_MS = 5000;\n33: const MAX_PROBE_TIMEOUT_MS = 6999;\n34: const DEFAULT_MODEL_SERVER_LOADING_MAX_MS = 150000;\n35: const JSON_RPC_PROTOCOL_VERSION = '2025-06-18';\n36: const MODEL_SERVER_HEALTH_PATH = '/api/health';\n37: let nextProbeId = 1;\n38: \n39: // ─────────────────────────────────────────────────────────────────────────────\n40: // 3. TIMEOUT AND RETRY HELPERS\n41: // ─────────────────────────────────────────────────────────────────────────────\n42: \n43: function parsePositiveInteger(value, fallback) {\n44:   if (value === undefined || value === null || String(value).trim() === '') return fallback;\n45:   const parsed = Number.parseInt(String(value).trim(), 10);\n46:   return Number.isFinite(parsed) && parsed > 0 ? parsed : fallback;\n47: }\n48: \n49: function clampProbeTimeoutMs(value) {\n50:   return Math.min(value, MAX_PROBE_TIMEOUT_MS);\n51: }\n52: \n53: function resolveProbeTimeoutMs(options = {}) {\n54:   if (Number.isFinite(options.timeoutMs) && options.timeoutMs > 0) {\n55:     return clampProbeTimeoutMs(options.timeoutMs);\n56:   }\n57:   return clampProbeTimeoutMs(parsePositiveInteger(\n58:     (options.env ?? process.env).SPECKIT_PROBE_TIMEOUT_MS,\n59:     DEFAULT_PROBE_TIMEOUT_MS,\n60:   ));\n61: }\n62: \n63: function parseNonNegativeInteger(value, fallback) {\n64:   if (value === undefined || value === null || String(value).trim() === '') return fallback;\n65:   const parsed = Number.parseInt(String(value).trim(), 10);\n66:   return Number.isFinite(parsed) && parsed >= 0 ? parsed : fallback;\n67: }\n68: \n69: // A single transient probe miss must NOT make a sibling reap the lease owner and respawn a second\n70: // daemon: a busy owner (e.g. mid-FTS-merge) can momentarily exceed the probe window. Require N\n71: // consecutive deep-probe failures before declaring the owner dead. Defaults keep the first probe at\n72: // its tuned full timeout and add one short retry plus a small backoff so the worst case stays inside\n73: // the probe grace ceiling — a genuinely dead socket fails fast, so only a hung daemon pays the retry.\n74: function resolveLeaseProbeAttempts(env = process.env) {\n75:   return 1 + parseNonNegativeInteger(env.SPECKIT_LEASE_PROBE_RETRIES, 1);\n76: }\n77: function resolveLeaseProbeRetryTimeoutMs(env = process.env) {\n78:   return clampProbeTimeoutMs(parsePositiveInteger(env.SPECKIT_LEASE_PROBE_RETRY_TIMEOUT_MS, 1500));\n79: }\n80: function resolveLeaseProbeRetryBackoffMs(env = process.env) {\n81:   return parsePositiveInteger(env.SPECKIT_LEASE_PROBE_RETRY_BACKOFF_MS, 250);\n82: }\n83: \n84: // ─────────────────────────────────────────────────────────────────────────────\n85: // 4. PATH AND TRANSPORT HELPERS\n86: // ─────────────────────────────────────────────────────────────────────────────\n87: \n88: function repoRoot() {\n89:   return path.resolve(__dirname, '..', '..', '..');\n90: }\n91: \n92: function defaultDbDirForService(serviceName) {\n93:   const root = repoRoot();\n94:   if (serviceName === 'system-skill-advisor') {\n95:     const advisorOverride = process.env.SYSTEM_SKILL_ADVISOR_DB_DIR;\n96:     return advisorOverride\n97:       ? path.resolve(advisorOverride)\n98:       : path.join(root, '.skilled', 'skills', 'system-skill-advisor', 'runtime', 'database');\n99:   }\n100:   throw new Error(`Unknown MCP service name: ${serviceName}`);\n101: }\n102: \n103: function shouldScopeIpcSocket(serviceName, socketDir = process.env.SPECKIT_IPC_SOCKET_DIR, env = process.env) {\n104:   if (serviceName !== 'system-skill-advisor') return false;\n105:   if (String(socketDir ?? '').startsWith('tcp://')) return false;\n106:   if (env.SPECKIT_IPC_SOCKET_SCOPE === 'database') return true;\n107:   return path.resolve(socketDir ?? DEFAULT_SKILL_ADVISOR_SOCKET_DIR)\n108:     === path.resolve(DEFAULT_SKILL_ADVISOR_SOCKET_DIR);\n109: }\n110: \n111: function withinSunPathLimit(socketPath) {\n112:   return Buffer.byteLength(socketPath, 'utf8') < SUN_PATH_LIMIT;\n113: }\n114: \n115: /**\n116:  * A short, deterministic socket directory for a path that cannot fit the limit.\n117:  *\n118:  * Keyed by a digest of the directory it replaces, so every process that computes\n119:  * the address independently arrives at the same one, and two checkouts of the\n120:  * same service never collide. Windows named pipes carry no such limit, so the\n121:  * platform temporary directory is only consulted there.\n122:  */\n123: function shortSocketDirFor(serviceName, intendedDir) {\n124:   const base = process.platform === 'win32' ? os.tmpdir() : '/tmp';\n125:   const scope = crypto.createHash('sha256').update(path.resolve(intendedDir)).digest('hex').slice(0, 12);\n126:   return path.join(base, serviceName, scope);\n127: }\n128: \n129: function canonicalSocketScopePath(value) {\n130:   const resolved = path.resolve(value);\n131:   try {\n132:     return fs.realpathSync.native(resolved);\n133:   } catch (error) {\n134:     if (error.code === 'ENOENT') return resolved;\n135:     throw error;\n136:   }\n137: }\n138: \n139: function resolveIpcSocketDir(serviceName, options = {}) {\n140:   const env = options.env ?? process.env;\n141:   const rawSocketDir = env.SPECKIT_IPC_SOCKET_DIR\n142:     ?? options.socketDir\n143:     ?? options.dbDir\n144:     ?? defaultDbDirForService(serviceName);\n145:   if (String(rawSocketDir).startsWith('tcp://')) return String(rawSocketDir);\n146:   const socketDir = path.resolve(rawSocketDir);\n147:   if (!shouldScopeIpcSocket(serviceName, rawSocketDir, env)) {\n148:     return withinLimitOrRelocated(serviceName, socketDir);\n149:   }\n150: \n151:   const dbDir = canonicalSocketScopePath(options.dbDir ?? defaultDbDirForService(serviceName));\n152:   const scope = crypto.createHash('sha256').update(dbDir).digest('hex').slice(0, 12);\n153:   return withinLimitOrRelocated(serviceName, path.join(socketDir, scope));\n154: }\n155: \n156: /** Keep a socket directory only while the address it implies can actually bind. */\n157: function withinLimitOrRelocated(serviceName, socketDir) {\n158:   if (withinSunPathLimit(path.join(socketDir, SOCKET_FILE_NAME))) return socketDir;\n159:   return shortSocketDirFor(serviceName, socketDir);\n160: }\n161: \n162: function getIpcSocketPath(serviceName, options = {}) {\n163:   if (process.env.SPECKIT_IPC_SOCKET_DIR?.startsWith('tcp://')) {\n164:     return process.env.SPECKIT_IPC_SOCKET_DIR;\n165:   }\n166:   const socketDir = resolveIpcSocketDir(serviceName, options);\n167:   return path.join(socketDir, SOCKET_FILE_NAME);\n168: }\n169: \n170: function toConnectionOptions(socketPath) {\n171:   if (!socketPath.startsWith('tcp://')) {\n172:     return socketPath;\n173:   }\n174:   const url = new URL(socketPath);\n175:   return {\n176:     host: url.hostname,\n177:     port: Number.parseInt(url.port, 10),\n178:   };\n179: }\n180: \n181: // ─────────────────────────────────────────────────────────────────────────────\n182: // 5. STDIO BRIDGE\n183: // ─────────────────────────────────────────────────────────────────────────────\n184: \n185: function bridgeStdioToSocket(socketPath, options = {}) {\n186:   const input = options.stdin ?? process.stdin;\n187:   const output = options.stdout ?? process.stdout;\n188:   const exit = options.exit ?? ((code) => process.exit(code));\n189:   const socket = net.createConnection(toConnectionOptions(socketPath));\n190:   let closed = false;\n191: \n192:   const closeOnce = (code = 0) => {\n193:     if (closed) return;\n194:     closed = true;\n195:     input.unpipe(socket);\n196:     socket.unpipe(output);\n197:     socket.destroy();\n198:     exit(code);\n199:   };\n200: \n201:   socket.once('connect', () => {\n202:     options.onConnect?.(socket);\n203:     input.pipe(socket);\n204:     socket.pipe(output);\n205:   });\n206: \n207:   socket.once('error', (error) => {\n208:     options.onError?.(error);\n209:     closeOnce(0);\n210:   });\n211: \n212:   socket.once('close', () => {\n213:     closeOnce(0);\n214:   });\n215: \n216:   input.once('end', () => {\n217:     socket.end();\n218:   });\n219:   input.once('close', () => {\n220:     closeOnce(0);\n221:   });\n222:   output.once('error', () => {\n223:     closeOnce(0);\n224:   });\n225: \n226:   return socket;\n227: }\n228: \n229: // ─────────────────────────────────────────────────────────────────────────────\n230: // 6. LIVENESS PROBES\n231: // ─────────────────────────────────────────────────────────────────────────────\n232: \n233: function probeDaemon(socketPath, options = {}) {\n234:   const timeoutMs = resolveProbeTimeoutMs(options);\n235:   const connect = options.connect ?? ((connectionOptions) => net.createConnection(connectionOptions));\n236:   // deepProbe=true REQUIRES a JSON-RPC initialize reply to call the daemon alive (detects a hung daemon\n237:   // that accepts the connection but never responds). Without it, a bare socket 'connect' counts as alive\n238:   // (connect-ok) — only safe for callers that genuinely need connection-liveness, NOT for the reap/bridge\n239:   // decision (which always passes deepProbe:true). See maybeBridgeLeaseHolder.\n240:   const deepProbe = options.deepProbe === true;\n241:   const id = nextProbeId++;\n242:   const request = `${JSON.stringify({\n243:     jsonrpc: '2.0',\n244:     id,\n245:     method: 'initialize',\n246:     params: {\n247:       protocolVersion: JSON_RPC_PROTOCOL_VERSION,\n248:       capabilities: {},\n249:       clientInfo: { name: 'liveness-probe', version: '0' },\n250:     },\n251:   })}\\n`;\n252: \n253:   return new Promise((resolve) => {\n254:     let socket;\n255:     let settled = false;\n256:     let buffer = '';\n257:     let timer;\n258:     // Hold a multibyte char split across chunk boundaries until complete, so a probe reply\n259:     // carrying CJK/emoji (e.g. serverInfo strings) is not corrupted to U+FFFD mid-parse.\n260:     const decoder = new StringDecoder('utf8');\n261: \n262:     const finish = (status, reason) => {\n263:       if (settled) return;\n264:       settled = true;\n265:       if (timer) clearTimeout(timer);\n266:       if (socket) socket.destroy();\n267:       resolve({ status, reason });\n268:     };\n269: \n270:     try {\n271:       socket = connect(toConnectionOptions(socketPath));\n272:     } catch (error) {\n273:       finish('dead', error instanceof Error ? error.message : 'connect-threw');\n274:       return;\n275:     }\n276: \n277:     timer = setTimeout(() => finish('dead', 'timeout'), timeoutMs);\n278:     timer.unref?.();\n279: \n280:     socket.once('connect', () => {\n281:       if (!deepProbe) {\n282:         finish('alive', 'connect-ok');\n283:         return;\n284:       }\n285:       socket.write(request);\n286:     });\n287:     socket.on('data', (chunk) => {\n288:       buffer += Buffer.isBuffer(chunk) ? decoder.write(chunk) : String(chunk ?? '');\n289:       let newlineIndex = buffer.indexOf('\\n');\n290:       while (newlineIndex !== -1) {\n291:         const line = buffer.slice(0, newlineIndex).trim();\n292:         buffer = buffer.slice(newlineIndex + 1);\n293:         newlineIndex = buffer.indexOf('\\n');\n294:         if (!line) continue;\n295:         try {\n296:           const parsed = JSON.parse(line);\n297:           if (\n298:             parsed &&\n299:             parsed.jsonrpc === '2.0' &&\n300:             parsed.id === id &&\n301:             (Object.prototype.hasOwnProperty.call(parsed, 'result') ||\n302:               Object.prototype.hasOwnProperty.call(parsed, 'error'))\n303:           ) {\n304:             finish('alive', 'json-rpc-reply');\n305:             return;\n306:           }\n307:         } catch {\n308:           // Ignore malformed or unrelated frames; the bounded probe decides liveness.\n309:         }\n310:       }\n311:     });\n312:     socket.once('error', (error) => {\n313:       finish('dead', error instanceof Error ? error.message : 'socket-error');\n314:     });\n315:     socket.once('close', () => {\n316:       finish('dead', 'closed-before-reply');\n317:     });\n318:   });\n319: }\n320: \n321: function normalizeExistingServiceProbeResult(result = {}) {\n322:   if (result.status === 'alive') {\n323:     return { status: 'alive', kind: 'json-rpc-reply' };\n324:   }\n325: \n326:   const failureText = `${result.reason ?? ''} ${result.code ?? ''}`.toUpperCase();\n327:   if (failureText.includes('ENOENT')) return { status: 'dead', kind: 'enoent' };\n328:   if (failureText.includes('ECONNREFUSED')) return { status: 'dead', kind: 'econnrefused' };\n329:   if (failureText.includes('TIMEOUT')) return { status: 'dead', kind: 'timeout' };\n330:   return { status: 'dead', kind: 'unknown' };\n331: }\n332: \n333: async function probeExistingService(socketPath, opts = {}) {\n334:   const result = await probeDaemon(socketPath, { ...opts, deepProbe: true });\n335:   return normalizeExistingServiceProbeResult(result);\n336: }\n337: \n338: function parseHttpJsonResponse(buffer) {\n339:   const raw = buffer.toString('utf8');\n340:   const headerEnd = raw.indexOf('\\r\\n\\r\\n');\n341:   if (headerEnd === -1) return null;\n342:   const statusLine = raw.slice(0, raw.indexOf('\\r\\n'));\n343:   const statusMatch = statusLine.match(/^HTTP\\/\\d(?:\\.\\d)?\\s+(\\d+)/);\n344:   if (!statusMatch) return null;\n345:   const statusCode = Number.parseInt(statusMatch[1], 10);\n346:   const bodyRaw = raw.slice(headerEnd + 4).trim();\n347:   let body = null;\n348:   try {\n349:     body = bodyRaw ? JSON.parse(bodyRaw) : null;\n350:   } catch {\n351:     return { statusCode, body: null };\n352:   }\n353:   return { statusCode, body };\n354: }\n355: \n356: function probeModelServer(socketPath, options = {}) {\n357:   const timeoutMs = resolveProbeTimeoutMs(options);\n358:   const loadingMaxMs = Number.isFinite(options.loadingMaxMs) && options.loadingMaxMs > 0\n359:     ? options.loadingMaxMs\n360:     : parsePositiveInteger(\n361:       (options.env ?? process.env).SPECKIT_HF_MODEL_SERVER_LOADING_MAX_MS,\n362:       DEFAULT_MODEL_SERVER_LOADING_MAX_MS,\n363:     );\n364:   const nowMs = typeof options.nowMs === 'function' ? options.nowMs : () => Date.now();\n365:   const connect = options.connect ?? ((connectionOptions) => net.createConnection(connectionOptions));\n366:   // Mark this as the launcher's internal liveness probe so a cold-state demand listener can answer\n367:   // without spawning a model server. Genuine embed consumers do not send this header, so their\n368:   // wake-on-demand path is unchanged.\n369:   const request = `GET ${MODEL_SERVER_HEALTH_PATH} HTTP/1.1\\r\\nHost: localhost\\r\\nAccept: application/json\\r\\nX-Speckit-Probe: liveness\\r\\nConnection: close\\r\\n\\r\\n`;\n370: \n371:   return new Promise((resolve) => {\n372:     let socket;\n373:     let settled = false;\n374:     let chunks = [];\n375:     let timer;\n376: \n377:     // Carry the parsed health body so callers (the idle-eviction tick) can read\n378:     // lastSuccessfulEmbedAt / inFlight. The 'alive' branches below pass parsed.body as the 3rd arg.\n379:     const finish = (status, reason, health) => {\n380:       if (settled) return;\n381:       settled = true;\n382:       if (timer) clearTimeout(timer);\n383:       if (socket) socket.destroy();\n384:       resolve({ status, reason, health });\n385:     };\n386: \n387:     try {\n388:       socket = connect(toConnectionOptions(socketPath));\n389:     } catch (error) {\n390:       finish('dead', error instanceof Error ? error.message : 'connect-threw');\n391:       return;\n392:     }\n393: \n394:     timer = setTimeout(() => finish('dead', 'timeout'), timeoutMs);\n395:     timer.unref?.();\n396: \n397:     socket.once('connect', () => {\n398:       socket.write(request);\n399:     });\n400:     socket.on('data', (chunk) => {\n401:       chunks.push(Buffer.isBuffer(chunk) ? chunk : Buffer.from(String(chunk ?? '')));\n402:     });\n403:     socket.once('end', () => {\n404:       const parsed = parseHttpJsonResponse(Buffer.concat(chunks));\n405:       const state = parsed && parsed.body && typeof parsed.body === 'object'\n406:         ? parsed.body.state\n407:         : null;\n408:       if (parsed && parsed.statusCode >= 200 && parsed.statusCode < 300 && state === 'ready') {\n409:         finish('alive', `health-${state}`, parsed.body);\n410:         return;\n411:       }\n412:       if (parsed && parsed.statusCode >= 200 && parsed.statusCode < 300 && state === 'loading') {\n413:         const loadStartedAt = parsed.body.loadStartedAt;\n414:         const loadProgressAt = parsed.body.loadProgressAt;\n415:         // The loading budget is per model-load attempt; device fallback re-stamps loadProgressAt.\n416:         const loadingMarker = Number.isFinite(loadProgressAt) && loadProgressAt > 0\n417:           ? loadProgressAt\n418:           : loadStartedAt;\n419:         if (Number.isFinite(loadingMarker) && loadingMarker > 0 && nowMs() - loadingMarker > loadingMaxMs) {\n420:           finish('dead', 'loading-wedged');\n421:           return;\n422:         }\n423:         finish('alive', 'health-loading', parsed.body);\n424:         return;\n425:       }\n426:       finish('dead', state === 'error' ? 'health-error' : 'health-not-ready');\n427:     });\n428:     socket.once('error', (error) => {\n429:       finish('dead', error instanceof Error ? error.message : 'socket-error');\n430:     });\n431:     socket.once('close', () => {\n432:       if (!settled && chunks.length === 0) finish('dead', 'closed-before-reply');\n433:     });\n434:   });\n435: }\n436: \n437: // ─────────────────────────────────────────────────────────────────────────────\n438: // 7. LEASE PROBE AND BRIDGE ORCHESTRATION\n439: // ─────────────────────────────────────────────────────────────────────────────\n440: \n441: // Run the deep liveness probe up to `attempts` times; any 'alive' short-circuits to a bridge, and\n442: // only an all-failures run returns the final (dead) result so the caller respawns. The probe fn and\n443: // sleep are injectable so the retry decision is unit-testable without real sockets or timers.\n444: async function probeLeaseHolderWithRetries(socketPath, options = {}) {\n445:   const {\n446:     probe = probeDaemon,\n447:     firstTimeoutMs,\n448:     retryTimeoutMs = resolveLeaseProbeRetryTimeoutMs(),\n449:     retryBackoffMs = resolveLeaseProbeRetryBackoffMs(),\n450:     attempts = resolveLeaseProbeAttempts(),\n451:     connect,\n452:     sleepFn = (ms) => new Promise((resolve) => { setTimeout(resolve, ms); }),\n453:     onRetry,\n454:   } = options;\n455:   const totalAttempts = Math.max(1, attempts);\n456:   let result = { status: 'dead', reason: 'no-probe-attempted' };\n457:   for (let attempt = 1; attempt <= totalAttempts; attempt += 1) {\n458:     const timeoutMs = attempt === 1 ? firstTimeoutMs : retryTimeoutMs;\n459:     result = await probe(socketPath, { timeoutMs, connect, deepProbe: true });\n460:     if (result.status === 'alive') return result;\n461:     if (attempt < totalAttempts) {\n462:       if (typeof onRetry === 'function') onRetry(attempt, totalAttempts, result);\n463:       await sleepFn(retryBackoffMs);\n464:     }\n465:   }\n466:   return result;\n467: }\n468: \n469: async function maybeBridgeLeaseHolder(options) {\n470:   const {\n471:     serviceName,\n472:     leaseResult,\n473:     loggerPrefix,\n474:     dbDir,\n475:     legacyReport,\n476:     probeTimeoutMs,\n477:     connect,\n478:     bridge,\n479:     respawnOnMissingSocket = false,\n480:   } = options;\n481:   const startedAt = leaseResult.startedAt ?? new Date(0).toISOString();\n482:   const legacyMarker = leaseResult.legacyPath ? ' (legacy path)' : '';\n483:   const ownerPid = leaseResult.ownerPid;\n484:   const writeLeaseHeld = (suffix = '') => {\n485:     process.stdout.write(`LEASE_HELD_BY:${ownerPid} startedAt=${startedAt}${legacyMarker}${suffix}\\n`);\n486:   };\n487: \n488:   if (process.env.SPECKIT_LAUNCHER_BRIDGE_DISABLED === '1') {\n489:     if (legacyReport) {\n490:       legacyReport(leaseResult);\n491:       return { action: 'report', reason: 'bridge-disabled' };\n492:     }\n493:     writeLeaseHeld();\n494:     return { action: 'report', reason: 'bridge-disabled' };\n495:   }\n496: \n497:   // Prefer the path the lease owner actually recorded over recomputing one from env. Under a\n498:   // divergent SPECKIT_IPC_SOCKET_DIR (e.g. a secondary launcher in a different worktree env), the\n499:   // recomputed path can miss the live socket and false-report 'no-bridge-socket'. Only trust the\n500:   // stored path when it still exists on disk; tcp:// endpoints bypass the existence check. Fall back\n501:   // to recomputation for legacy leases that predate socketPath and for the other launchers whose\n502:   // leases never carry it.\n503:   const storedSocketPath = leaseResult.socketPath;\n504:   const recomputedSocketPath = getIpcSocketPath(serviceName, { dbDir });\n505:   const socketDir = process.env.SPECKIT_IPC_SOCKET_DIR ?? DEFAULT_SKILL_ADVISOR_SOCKET_DIR;\n506:   const scopedSocket = shouldScopeIpcSocket(serviceName, socketDir);\n507:   const usableStoredSocketPath = typeof storedSocketPath === 'string'\n508:     && storedSocketPath.length > 0\n509:     && (storedSocketPath.startsWith('tcp://') || fs.existsSync(storedSocketPath))\n510:     && (!scopedSocket || storedSocketPath === recomputedSocketPath)\n511:     ? storedSocketPath\n512:     : null;\n513:   const socketPath = usableStoredSocketPath ?? recomputedSocketPath;\n514:   if (!socketPath.startsWith('tcp://') && !fs.existsSync(socketPath)) {\n515:     if (respawnOnMissingSocket) {\n516:       process.stderr.write(`[${loggerPrefix}] lease holder pid=${ownerPid} has no socket at ${socketPath}; requesting respawn\\n`);\n517:       return { action: 'respawn', reason: 'no-bridge-socket', socketPath };\n518:     }\n519:     writeLeaseHeld(' (no-bridge-socket)');\n520:     return { action: 'report', reason: 'no-bridge-socket', socketPath };\n521:   }\n522: \n523:   // deepProbe: REQUIRE a JSON-RPC reply, not just a socket accept. The reap/bridge decision must\n524:   // detect a HUNG daemon (event loop wedged / deadlocked — it still accepts the UDS connection but\n525:   // never services requests). A connect-ok-only probe would bridge a client to the wedged daemon and\n526:   // hang it forever, never respawning. The raised probe timeout (default 5000ms, < the 7000ms launcher\n527:   // grace) already prevents false-reaping a busy-but-responsive daemon mid-FTS-merge, so deep probing\n528:   // does not regress that.\n529:   // Require N consecutive failures (not one transient miss) before reaping a sibling's owner.\n530:   const probeAttempts = resolveLeaseProbeAttempts();\n531:   const probe = await probeLeaseHolderWithRetries(socketPath, {\n532:     firstTimeoutMs: probeTimeoutMs,\n533:     attempts: probeAttempts,\n534:     connect,\n535:     onRetry: (attempt, total, result) => process.stderr.write(\n536:       `[${loggerPrefix}] lease holder pid=${ownerPid} probe ${attempt}/${total} not alive (${result.reason}); retrying\\n`,\n537:     ),\n538:   });\n539:   if (probe.status !== 'alive') {\n540:     process.stderr.write(`[${loggerPrefix}] lease holder pid=${ownerPid} socket=${socketPath} failed ${probeAttempts} consecutive liveness probes: ${probe.reason}\\n`);\n541:     return { action: 'respawn', reason: probe.reason, socketPath };\n542:   }\n543: \n544:   process.stderr.write(`[${loggerPrefix}] bridging to lease holder pid=${ownerPid} socket=${socketPath}\\n`);\n545:   const bridgeToSocket = bridge ?? bridgeStdioToSocket;\n546:   // Await so an injected reconnecting bridge (whose start() resolves after the first\n547:   // attach) is fully wired before returning. The raw bridge returns a socket, not a\n548:   // promise, so Promise.resolve keeps the original fire-and-forget timing for it.\n549:   // Forward the deep probe that just confirmed liveness above so a reconnecting bridge\n550:   // (session proxy) does not pay a second, redundant daemon-readiness round-trip for the\n551:   // same socket on this warm-owner path; reattach paths that never called this function\n552:   // still run their own probe as before.\n553:   await Promise.resolve(bridgeToSocket(socketPath, {\n554:     onError: () => {\n555:       writeLeaseHeld(' (bridge-refused)');\n556:     },\n557:     initialReadyResult: probe,\n558:   }));\n559:   return { action: 'bridge', socketPath };\n560: }\n561: \n562: // ─────────────────────────────────────────────────────────────────────────────\n563: // 8. EXPORTS\n564: // ─────────────────────────────────────────────────────────────────────────────\n565: \n566: module.exports = {\n567:   DEFAULT_MODEL_SERVER_LOADING_MAX_MS,\n568:   bridgeStdioToSocket,\n569:   getIpcSocketPath,\n570:   resolveIpcSocketDir,\n571:   maybeBridgeLeaseHolder,\n572:   normalizeExistingServiceProbeResult,\n573:   probeDaemon,\n574:   probeExistingService,\n575:   probeLeaseHolderWithRetries,\n576:   probeModelServer,\n577:   resolveLeaseProbeAttempts,\n578:   resolveLeaseProbeRetryBackoffMs,\n579:   resolveLeaseProbeRetryTimeoutMs,\n580:   toConnectionOptions,\n581: };","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/bin/lib/launcher-ipc-bridge.cjs, lines 1-581\n1: // ╔══════════════════════════════════════════════════════════════════════════╗\n2: // ║ COMPONENT: Launcher IPC Bridge                                           ║\n3: // ╠══════════════════════════════════════════════════════════════════════════╣\n4: // ║ PURPOSE: Provides daemon IPC paths, probes, and JSON-RPC helpers.        ║\n5: // ╚══════════════════════════════════════════════════════════════════════════╝\n6: 'use strict';\n7: \n8: // ─────────────────────────────────────────────────────────────────────────────\n9: // 1. IMPORTS\n10: // ─────────────────────────────────────────────────────────────────────────────\n11: \n12: const fs = require('fs');\n13: const crypto = require('crypto');\n14: const net = require('net');\n15: const os = require('os');\n16: const path = require('path');\n17: const { StringDecoder } = require('string_decoder');\n18: \n19: // ─────────────────────────────────────────────────────────────────────────────\n20: // 2. CONSTANTS\n21: // ─────────────────────────────────────────────────────────────────────────────\n22: \n23: const SOCKET_FILE_NAME = 'daemon-ipc.sock';\n24: const DEFAULT_SKILL_ADVISOR_SOCKET_DIR = '/tmp/system-skill-advisor';\n25: // A unix domain socket address is bounded by sockaddr_un.sun_path: 104 bytes on\n26: // macOS, 108 on Linux. Take the smaller so one machine's socket path is every\n27: // machine's socket path. A service whose socket sits beside its database inherits\n28: // the checkout prefix, and a repository a few directories deep pushes it past the\n29: // limit. bind then fails with EINVAL, which names neither the length nor the path,\n30: // so the daemon looks unreachable rather than misconfigured.\n31: const SUN_PATH_LIMIT = 104;\n32: const DEFAULT_PROBE_TIMEOUT_MS = 5000;\n33: const MAX_PROBE_TIMEOUT_MS = 6999;\n34: const DEFAULT_MODEL_SERVER_LOADING_MAX_MS = 150000;\n35: const JSON_RPC_PROTOCOL_VERSION = '2025-06-18';\n36: const MODEL_SERVER_HEALTH_PATH = '/api/health';\n37: let nextProbeId = 1;\n38: \n39: // ─────────────────────────────────────────────────────────────────────────────\n40: // 3. TIMEOUT AND RETRY HELPERS\n41: // ─────────────────────────────────────────────────────────────────────────────\n42: \n43: function parsePositiveInteger(value, fallback) {\n44:   if (value === undefined || value === null || String(value).trim() === '') return fallback;\n45:   const parsed = Number.parseInt(String(value).trim(), 10);\n46:   return Number.isFinite(parsed) && parsed > 0 ? parsed : fallback;\n47: }\n48: \n49: function clampProbeTimeoutMs(value) {\n50:   return Math.min(value, MAX_PROBE_TIMEOUT_MS);\n51: }\n52: \n53: function resolveProbeTimeoutMs(options = {}) {\n54:   if (Number.isFinite(options.timeoutMs) && options.timeoutMs > 0) {\n55:     return clampProbeTimeoutMs(options.timeoutMs);\n56:   }\n57:   return clampProbeTimeoutMs(parsePositiveInteger(\n58:     (options.env ?? process.env).SPECKIT_PROBE_TIMEOUT_MS,\n59:     DEFAULT_PROBE_TIMEOUT_MS,\n60:   ));\n61: }\n62: \n63: function parseNonNegativeInteger(value, fallback) {\n64:   if (value === undefined || value === null || String(value).trim() === '') return fallback;\n65:   const parsed = Number.parseInt(String(value).trim(), 10);\n66:   return Number.isFinite(parsed) && parsed >= 0 ? parsed : fallback;\n67: }\n68: \n69: // A single transient probe miss must NOT make a sibling reap the lease owner and respawn a second\n70: // daemon: a busy owner (e.g. mid-FTS-merge) can momentarily exceed the probe window. Require N\n71: // consecutive deep-probe failures before declaring the owner dead. Defaults keep the first probe at\n72: // its tuned full timeout and add one short retry plus a small backoff so the worst case stays inside\n73: // the probe grace ceiling — a genuinely dead socket fails fast, so only a hung daemon pays the retry.\n74: function resolveLeaseProbeAttempts(env = process.env) {\n75:   return 1 + parseNonNegativeInteger(env.SPECKIT_LEASE_PROBE_RETRIES, 1);\n76: }\n77: function resolveLeaseProbeRetryTimeoutMs(env = process.env) {\n78:   return clampProbeTimeoutMs(parsePositiveInteger(env.SPECKIT_LEASE_PROBE_RETRY_TIMEOUT_MS, 1500));\n79: }\n80: function resolveLeaseProbeRetryBackoffMs(env = process.env) {\n81:   return parsePositiveInteger(env.SPECKIT_LEASE_PROBE_RETRY_BACKOFF_MS, 250);\n82: }\n83: \n84: // ─────────────────────────────────────────────────────────────────────────────\n85: // 4. PATH AND TRANSPORT HELPERS\n86: // ─────────────────────────────────────────────────────────────────────────────\n87: \n88: function repoRoot() {\n89:   return path.resolve(__dirname, '..', '..', '..');\n90: }\n91: \n92: function defaultDbDirForService(serviceName) {\n93:   const root = repoRoot();\n94:   if (serviceName === 'system-skill-advisor') {\n95:     const advisorOverride = process.env.SYSTEM_SKILL_ADVISOR_DB_DIR;\n96:     return advisorOverride\n97:       ? path.resolve(advisorOverride)\n98:       : path.join(root, '.skilled', 'skills', 'system-skill-advisor', 'runtime', 'database');\n99:   }\n100:   throw new Error(`Unknown MCP service name: ${serviceName}`);\n101: }\n102: \n103: function shouldScopeIpcSocket(serviceName, socketDir = process.env.SPECKIT_IPC_SOCKET_DIR, env = process.env) {\n104:   if (serviceName !== 'system-skill-advisor') return false;\n105:   if (String(socketDir ?? '').startsWith('tcp://')) return false;\n106:   if (env.SPECKIT_IPC_SOCKET_SCOPE === 'database') return true;\n107:   return path.resolve(socketDir ?? DEFAULT_SKILL_ADVISOR_SOCKET_DIR)\n108:     === path.resolve(DEFAULT_SKILL_ADVISOR_SOCKET_DIR);\n109: }\n110: \n111: function withinSunPathLimit(socketPath) {\n112:   return Buffer.byteLength(socketPath, 'utf8') < SUN_PATH_LIMIT;\n113: }\n114: \n115: /**\n116:  * A short, deterministic socket directory for a path that cannot fit the limit.\n117:  *\n118:  * Keyed by a digest of the directory it replaces, so every process that computes\n119:  * the address independently arrives at the same one, and two checkouts of the\n120:  * same service never collide. Windows named pipes carry no such limit, so the\n121:  * platform temporary directory is only consulted there.\n122:  */\n123: function shortSocketDirFor(serviceName, intendedDir) {\n124:   const base = process.platform === 'win32' ? os.tmpdir() : '/tmp';\n125:   const scope = crypto.createHash('sha256').update(path.resolve(intendedDir)).digest('hex').slice(0, 12);\n126:   return path.join(base, serviceName, scope);\n127: }\n128: \n129: function canonicalSocketScopePath(value) {\n130:   const resolved = path.resolve(value);\n131:   try {\n132:     return fs.realpathSync.native(resolved);\n133:   } catch (error) {\n134:     if (error.code === 'ENOENT') return resolved;\n135:     throw error;\n136:   }\n137: }\n138: \n139: function resolveIpcSocketDir(serviceName, options = {}) {\n140:   const env = options.env ?? process.env;\n141:   const rawSocketDir = env.SPECKIT_IPC_SOCKET_DIR\n142:     ?? options.socketDir\n143:     ?? options.dbDir\n144:     ?? defaultDbDirForService(serviceName);\n145:   if (String(rawSocketDir).startsWith('tcp://')) return String(rawSocketDir);\n146:   const socketDir = path.resolve(rawSocketDir);\n147:   if (!shouldScopeIpcSocket(serviceName, rawSocketDir, env)) {\n148:     return withinLimitOrRelocated(serviceName, socketDir);\n149:   }\n150: \n151:   const dbDir = canonicalSocketScopePath(options.dbDir ?? defaultDbDirForService(serviceName));\n152:   const scope = crypto.createHash('sha256').update(dbDir).digest('hex').slice(0, 12);\n153:   return withinLimitOrRelocated(serviceName, path.join(socketDir, scope));\n154: }\n155: \n156: /** Keep a socket directory only while the address it implies can actually bind. */\n157: function withinLimitOrRelocated(serviceName, socketDir) {\n158:   if (withinSunPathLimit(path.join(socketDir, SOCKET_FILE_NAME))) return socketDir;\n159:   return shortSocketDirFor(serviceName, socketDir);\n160: }\n161: \n162: function getIpcSocketPath(serviceName, options = {}) {\n163:   if (process.env.SPECKIT_IPC_SOCKET_DIR?.startsWith('tcp://')) {\n164:     return process.env.SPECKIT_IPC_SOCKET_DIR;\n165:   }\n166:   const socketDir = resolveIpcSocketDir(serviceName, options);\n167:   return path.join(socketDir, SOCKET_FILE_NAME);\n168: }\n169: \n170: function toConnectionOptions(socketPath) {\n171:   if (!socketPath.startsWith('tcp://')) {\n172:     return socketPath;\n173:   }\n174:   const url = new URL(socketPath);\n175:   return {\n176:     host: url.hostname,\n177:     port: Number.parseInt(url.port, 10),\n178:   };\n179: }\n180: \n181: // ─────────────────────────────────────────────────────────────────────────────\n182: // 5. STDIO BRIDGE\n183: // ─────────────────────────────────────────────────────────────────────────────\n184: \n185: function bridgeStdioToSocket(socketPath, options = {}) {\n186:   const input = options.stdin ?? process.stdin;\n187:   const output = options.stdout ?? process.stdout;\n188:   const exit = options.exit ?? ((code) => process.exit(code));\n189:   const socket = net.createConnection(toConnectionOptions(socketPath));\n190:   let closed = false;\n191: \n192:   const closeOnce = (code = 0) => {\n193:     if (closed) return;\n194:     closed = true;\n195:     input.unpipe(socket);\n196:     socket.unpipe(output);\n197:     socket.destroy();\n198:     exit(code);\n199:   };\n200: \n201:   socket.once('connect', () => {\n202:     options.onConnect?.(socket);\n203:     input.pipe(socket);\n204:     socket.pipe(output);\n205:   });\n206: \n207:   socket.once('error', (error) => {\n208:     options.onError?.(error);\n209:     closeOnce(0);\n210:   });\n211: \n212:   socket.once('close', () => {\n213:     closeOnce(0);\n214:   });\n215: \n216:   input.once('end', () => {\n217:     socket.end();\n218:   });\n219:   input.once('close', () => {\n220:     closeOnce(0);\n221:   });\n222:   output.once('error', () => {\n223:     closeOnce(0);\n224:   });\n225: \n226:   return socket;\n227: }\n228: \n229: // ─────────────────────────────────────────────────────────────────────────────\n230: // 6. LIVENESS PROBES\n231: // ─────────────────────────────────────────────────────────────────────────────\n232: \n233: function probeDaemon(socketPath, options = {}) {\n234:   const timeoutMs = resolveProbeTimeoutMs(options);\n235:   const connect = options.connect ?? ((connectionOptions) => net.createConnection(connectionOptions));\n236:   // deepProbe=true REQUIRES a JSON-RPC initialize reply to call the daemon alive (detects a hung daemon\n237:   // that accepts the connection but never responds). Without it, a bare socket 'connect' counts as alive\n238:   // (connect-ok) — only safe for callers that genuinely need connection-liveness, NOT for the reap/bridge\n239:   // decision (which always passes deepProbe:true). See maybeBridgeLeaseHolder.\n240:   const deepProbe = options.deepProbe === true;\n241:   const id = nextProbeId++;\n242:   const request = `${JSON.stringify({\n243:     jsonrpc: '2.0',\n244:     id,\n245:     method: 'initialize',\n246:     params: {\n247:       protocolVersion: JSON_RPC_PROTOCOL_VERSION,\n248:       capabilities: {},\n249:       clientInfo: { name: 'liveness-probe', version: '0' },\n250:     },\n251:   })}\\n`;\n252: \n253:   return new Promise((resolve) => {\n254:     let socket;\n255:     let settled = false;\n256:     let buffer = '';\n257:     let timer;\n258:     // Hold a multibyte char split across chunk boundaries until complete, so a probe reply\n259:     // carrying CJK/emoji (e.g. serverInfo strings) is not corrupted to U+FFFD mid-parse.\n260:     const decoder = new StringDecoder('utf8');\n261: \n262:     const finish = (status, reason) => {\n263:       if (settled) return;\n264:       settled = true;\n265:       if (timer) clearTimeout(timer);\n266:       if (socket) socket.destroy();\n267:       resolve({ status, reason });\n268:     };\n269: \n270:     try {\n271:       socket = connect(toConnectionOptions(socketPath));\n272:     } catch (error) {\n273:       finish('dead', error instanceof Error ? error.message : 'connect-threw');\n274:       return;\n275:     }\n276: \n277:     timer = setTimeout(() => finish('dead', 'timeout'), timeoutMs);\n278:     timer.unref?.();\n279: \n280:     socket.once('connect', () => {\n281:       if (!deepProbe) {\n282:         finish('alive', 'connect-ok');\n283:         return;\n284:       }\n285:       socket.write(request);\n286:     });\n287:     socket.on('data', (chunk) => {\n288:       buffer += Buffer.isBuffer(chunk) ? decoder.write(chunk) : String(chunk ?? '');\n289:       let newlineIndex = buffer.indexOf('\\n');\n290:       while (newlineIndex !== -1) {\n291:         const line = buffer.slice(0, newlineIndex).trim();\n292:         buffer = buffer.slice(newlineIndex + 1);\n293:         newlineIndex = buffer.indexOf('\\n');\n294:         if (!line) continue;\n295:         try {\n296:           const parsed = JSON.parse(line);\n297:           if (\n298:             parsed &&\n299:             parsed.jsonrpc === '2.0' &&\n300:             parsed.id === id &&\n301:             (Object.prototype.hasOwnProperty.call(parsed, 'result') ||\n302:               Object.prototype.hasOwnProperty.call(parsed, 'error'))\n303:           ) {\n304:             finish('alive', 'json-rpc-reply');\n305:             return;\n306:           }\n307:         } catch {\n308:           // Ignore malformed or unrelated frames; the bounded probe decides liveness.\n309:         }\n310:       }\n311:     });\n312:     socket.once('error', (error) => {\n313:       finish('dead', error instanceof Error ? error.message : 'socket-error');\n314:     });\n315:     socket.once('close', () => {\n316:       finish('dead', 'closed-before-reply');\n317:     });\n318:   });\n319: }\n320: \n321: function normalizeExistingServiceProbeResult(result = {}) {\n322:   if (result.status === 'alive') {\n323:     return { status: 'alive', kind: 'json-rpc-reply' };\n324:   }\n325: \n326:   const failureText = `${result.reason ?? ''} ${result.code ?? ''}`.toUpperCase();\n327:   if (failureText.includes('ENOENT')) return { status: 'dead', kind: 'enoent' };\n328:   if (failureText.includes('ECONNREFUSED')) return { status: 'dead', kind: 'econnrefused' };\n329:   if (failureText.includes('TIMEOUT')) return { status: 'dead', kind: 'timeout' };\n330:   return { status: 'dead', kind: 'unknown' };\n331: }\n332: \n333: async function probeExistingService(socketPath, opts = {}) {\n334:   const result = await probeDaemon(socketPath, { ...opts, deepProbe: true });\n335:   return normalizeExistingServiceProbeResult(result);\n336: }\n337: \n338: function parseHttpJsonResponse(buffer) {\n339:   const raw = buffer.toString('utf8');\n340:   const headerEnd = raw.indexOf('\\r\\n\\r\\n');\n341:   if (headerEnd === -1) return null;\n342:   const statusLine = raw.slice(0, raw.indexOf('\\r\\n'));\n343:   const statusMatch = statusLine.match(/^HTTP\\/\\d(?:\\.\\d)?\\s+(\\d+)/);\n344:   if (!statusMatch) return null;\n345:   const statusCode = Number.parseInt(statusMatch[1], 10);\n346:   const bodyRaw = raw.slice(headerEnd + 4).trim();\n347:   let body = null;\n348:   try {\n349:     body = bodyRaw ? JSON.parse(bodyRaw) : null;\n350:   } catch {\n351:     return { statusCode, body: null };\n352:   }\n353:   return { statusCode, body };\n354: }\n355: \n356: function probeModelServer(socketPath, options = {}) {\n357:   const timeoutMs = resolveProbeTimeoutMs(options);\n358:   const loadingMaxMs = Number.isFinite(options.loadingMaxMs) && options.loadingMaxMs > 0\n359:     ? options.loadingMaxMs\n360:     : parsePositiveInteger(\n361:       (options.env ?? process.env).SPECKIT_HF_MODEL_SERVER_LOADING_MAX_MS,\n362:       DEFAULT_MODEL_SERVER_LOADING_MAX_MS,\n363:     );\n364:   const nowMs = typeof options.nowMs === 'function' ? options.nowMs : () => Date.now();\n365:   const connect = options.connect ?? ((connectionOptions) => net.createConnection(connectionOptions));\n366:   // Mark this as the launcher's internal liveness probe so a cold-state demand listener can answer\n367:   // without spawning a model server. Genuine embed consumers do not send this header, so their\n368:   // wake-on-demand path is unchanged.\n369:   const request = `GET ${MODEL_SERVER_HEALTH_PATH} HTTP/1.1\\r\\nHost: localhost\\r\\nAccept: application/json\\r\\nX-Speckit-Probe: liveness\\r\\nConnection: close\\r\\n\\r\\n`;\n370: \n371:   return new Promise((resolve) => {\n372:     let socket;\n373:     let settled = false;\n374:     let chunks = [];\n375:     let timer;\n376: \n377:     // Carry the parsed health body so callers (the idle-eviction tick) can read\n378:     // lastSuccessfulEmbedAt / inFlight. The 'alive' branches below pass parsed.body as the 3rd arg.\n379:     const finish = (status, reason, health) => {\n380:       if (settled) return;\n381:       settled = true;\n382:       if (timer) clearTimeout(timer);\n383:       if (socket) socket.destroy();\n384:       resolve({ status, reason, health });\n385:     };\n386: \n387:     try {\n388:       socket = connect(toConnectionOptions(socketPath));\n389:     } catch (error) {\n390:       finish('dead', error instanceof Error ? error.message : 'connect-threw');\n391:       return;\n392:     }\n393: \n394:     timer = setTimeout(() => finish('dead', 'timeout'), timeoutMs);\n395:     timer.unref?.();\n396: \n397:     socket.once('connect', () => {\n398:       socket.write(request);\n399:     });\n400:     socket.on('data', (chunk) => {\n401:       chunks.push(Buffer.isBuffer(chunk) ? chunk : Buffer.from(String(chunk ?? '')));\n402:     });\n403:     socket.once('end', () => {\n404:       const parsed = parseHttpJsonResponse(Buffer.concat(chunks));\n405:       const state = parsed && parsed.body && typeof parsed.body === 'object'\n406:         ? parsed.body.state\n407:         : null;\n408:       if (parsed && parsed.statusCode >= 200 && parsed.statusCode < 300 && state === 'ready') {\n409:         finish('alive', `health-${state}`, parsed.body);\n410:         return;\n411:       }\n412:       if (parsed && parsed.statusCode >= 200 && parsed.statusCode < 300 && state === 'loading') {\n413:         const loadStartedAt = parsed.body.loadStartedAt;\n414:         const loadProgressAt = parsed.body.loadProgressAt;\n415:         // The loading budget is per model-load attempt; device fallback re-stamps loadProgressAt.\n416:         const loadingMarker = Number.isFinite(loadProgressAt) && loadProgressAt > 0\n417:           ? loadProgressAt\n418:           : loadStartedAt;\n419:         if (Number.isFinite(loadingMarker) && loadingMarker > 0 && nowMs() - loadingMarker > loadingMaxMs) {\n420:           finish('dead', 'loading-wedged');\n421:           return;\n422:         }\n423:         finish('alive', 'health-loading', parsed.body);\n424:         return;\n425:       }\n426:       finish('dead', state === 'error' ? 'health-error' : 'health-not-ready');\n427:     });\n428:     socket.once('error', (error) => {\n429:       finish('dead', error instanceof Error ? error.message : 'socket-error');\n430:     });\n431:     socket.once('close', () => {\n432:       if (!settled && chunks.length === 0) finish('dead', 'closed-before-reply');\n433:     });\n434:   });\n435: }\n436: \n437: // ─────────────────────────────────────────────────────────────────────────────\n438: // 7. LEASE PROBE AND BRIDGE ORCHESTRATION\n439: // ─────────────────────────────────────────────────────────────────────────────\n440: \n441: // Run the deep liveness probe up to `attempts` times; any 'alive' short-circuits to a bridge, and\n442: // only an all-failures run returns the final (dead) result so the caller respawns. The probe fn and\n443: // sleep are injectable so the retry decision is unit-testable without real sockets or timers.\n444: async function probeLeaseHolderWithRetries(socketPath, options = {}) {\n445:   const {\n446:     probe = probeDaemon,\n447:     firstTimeoutMs,\n448:     retryTimeoutMs = resolveLeaseProbeRetryTimeoutMs(),\n449:     retryBackoffMs = resolveLeaseProbeRetryBackoffMs(),\n450:     attempts = resolveLeaseProbeAttempts(),\n451:     connect,\n452:     sleepFn = (ms) => new Promise((resolve) => { setTimeout(resolve, ms); }),\n453:     onRetry,\n454:   } = options;\n455:   const totalAttempts = Math.max(1, attempts);\n456:   let result = { status: 'dead', reason: 'no-probe-attempted' };\n457:   for (let attempt = 1; attempt <= totalAttempts; attempt += 1) {\n458:     const timeoutMs = attempt === 1 ? firstTimeoutMs : retryTimeoutMs;\n459:     result = await probe(socketPath, { timeoutMs, connect, deepProbe: true });\n460:     if (result.status === 'alive') return result;\n461:     if (attempt < totalAttempts) {\n462:       if (typeof onRetry === 'function') onRetry(attempt, totalAttempts, result);\n463:       await sleepFn(retryBackoffMs);\n464:     }\n465:   }\n466:   return result;\n467: }\n468: \n469: async function maybeBridgeLeaseHolder(options) {\n470:   const {\n471:     serviceName,\n472:     leaseResult,\n473:     loggerPrefix,\n474:     dbDir,\n475:     legacyReport,\n476:     probeTimeoutMs,\n477:     connect,\n478:     bridge,\n479:     respawnOnMissingSocket = false,\n480:   } = options;\n481:   const startedAt = leaseResult.startedAt ?? new Date(0).toISOString();\n482:   const legacyMarker = leaseResult.legacyPath ? ' (legacy path)' : '';\n483:   const ownerPid = leaseResult.ownerPid;\n484:   const writeLeaseHeld = (suffix = '') => {\n485:     process.stdout.write(`LEASE_HELD_BY:${ownerPid} startedAt=${startedAt}${legacyMarker}${suffix}\\n`);\n486:   };\n487: \n488:   if (process.env.SPECKIT_LAUNCHER_BRIDGE_DISABLED === '1') {\n489:     if (legacyReport) {\n490:       legacyReport(leaseResult);\n491:       return { action: 'report', reason: 'bridge-disabled' };\n492:     }\n493:     writeLeaseHeld();\n494:     return { action: 'report', reason: 'bridge-disabled' };\n495:   }\n496: \n497:   // Prefer the path the lease owner actually recorded over recomputing one from env. Under a\n498:   // divergent SPECKIT_IPC_SOCKET_DIR (e.g. a secondary launcher in a different worktree env), the\n499:   // recomputed path can miss the live socket and false-report 'no-bridge-socket'. Only trust the\n500:   // stored path when it still exists on disk; tcp:// endpoints bypass the existence check. Fall back\n501:   // to recomputation for legacy leases that predate socketPath and for the other launchers whose\n502:   // leases never carry it.\n503:   const storedSocketPath = leaseResult.socketPath;\n504:   const recomputedSocketPath = getIpcSocketPath(serviceName, { dbDir });\n505:   const socketDir = process.env.SPECKIT_IPC_SOCKET_DIR ?? DEFAULT_SKILL_ADVISOR_SOCKET_DIR;\n506:   const scopedSocket = shouldScopeIpcSocket(serviceName, socketDir);\n507:   const usableStoredSocketPath = typeof storedSocketPath === 'string'\n508:     && storedSocketPath.length > 0\n509:     && (storedSocketPath.startsWith('tcp://') || fs.existsSync(storedSocketPath))\n510:     && (!scopedSocket || storedSocketPath === recomputedSocketPath)\n511:     ? storedSocketPath\n512:     : null;\n513:   const socketPath = usableStoredSocketPath ?? recomputedSocketPath;\n514:   if (!socketPath.startsWith('tcp://') && !fs.existsSync(socketPath)) {\n515:     if (respawnOnMissingSocket) {\n516:       process.stderr.write(`[${loggerPrefix}] lease holder pid=${ownerPid} has no socket at ${socketPath}; requesting respawn\\n`);\n517:       return { action: 'respawn', reason: 'no-bridge-socket', socketPath };\n518:     }\n519:     writeLeaseHeld(' (no-bridge-socket)');\n520:     return { action: 'report', reason: 'no-bridge-socket', socketPath };\n521:   }\n522: \n523:   // deepProbe: REQUIRE a JSON-RPC reply, not just a socket accept. The reap/bridge decision must\n524:   // detect a HUNG daemon (event loop wedged / deadlocked — it still accepts the UDS connection but\n525:   // never services requests). A connect-ok-only probe would bridge a client to the wedged daemon and\n526:   // hang it forever, never respawning. The raised probe timeout (default 5000ms, < the 7000ms launcher\n527:   // grace) already prevents false-reaping a busy-but-responsive daemon mid-FTS-merge, so deep probing\n528:   // does not regress that.\n529:   // Require N consecutive failures (not one transient miss) before reaping a sibling's owner.\n530:   const probeAttempts = resolveLeaseProbeAttempts();\n531:   const probe = await probeLeaseHolderWithRetries(socketPath, {\n532:     firstTimeoutMs: probeTimeoutMs,\n533:     attempts: probeAttempts,\n534:     connect,\n535:     onRetry: (attempt, total, result) => process.stderr.write(\n536:       `[${loggerPrefix}] lease holder pid=${ownerPid} probe ${attempt}/${total} not alive (${result.reason}); retrying\\n`,\n537:     ),\n538:   });\n539:   if (probe.status !== 'alive') {\n540:     process.stderr.write(`[${loggerPrefix}] lease holder pid=${ownerPid} socket=${socketPath} failed ${probeAttempts} consecutive liveness probes: ${probe.reason}\\n`);\n541:     return { action: 'respawn', reason: probe.reason, socketPath };\n542:   }\n543: \n544:   process.stderr.write(`[${loggerPrefix}] bridging to lease holder pid=${ownerPid} socket=${socketPath}\\n`);\n545:   const bridgeToSocket = bridge ?? bridgeStdioToSocket;\n546:   // Await so an injected reconnecting bridge (whose start() resolves after the first\n547:   // attach) is fully wired before returning. The raw bridge returns a socket, not a\n548:   // promise, so Promise.resolve keeps the original fire-and-forget timing for it.\n549:   // Forward the deep probe that just confirmed liveness above so a reconnecting bridge\n550:   // (session proxy) does not pay a second, redundant daemon-readiness round-trip for the\n551:   // same socket on this warm-owner path; reattach paths that never called this function\n552:   // still run their own probe as before.\n553:   await Promise.resolve(bridgeToSocket(socketPath, {\n554:     onError: () => {\n555:       writeLeaseHeld(' (bridge-refused)');\n556:     },\n557:     initialReadyResult: probe,\n558:   }));\n559:   return { action: 'bridge', socketPath };\n560: }\n561: \n562: // ─────────────────────────────────────────────────────────────────────────────\n563: // 8. EXPORTS\n564: // ─────────────────────────────────────────────────────────────────────────────\n565: \n566: module.exports = {\n567:   DEFAULT_MODEL_SERVER_LOADING_MAX_MS,\n568:   bridgeStdioToSocket,\n569:   getIpcSocketPath,\n570:   resolveIpcSocketDir,\n571:   maybeBridgeLeaseHolder,\n572:   normalizeExistingServiceProbeResult,\n573:   probeDaemon,\n574:   probeExistingService,\n575:   probeLeaseHolderWithRetries,\n576:   probeModelServer,\n577:   resolveLeaseProbeAttempts,\n578:   resolveLeaseProbeRetryBackoffMs,\n579:   resolveLeaseProbeRetryTimeoutMs,\n580:   toConnectionOptions,\n581: };"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/bin/lib/launcher-ipc-bridge.cjs\"}"},"time":{"start":1794527281967,"end":1794527282348}}}}
