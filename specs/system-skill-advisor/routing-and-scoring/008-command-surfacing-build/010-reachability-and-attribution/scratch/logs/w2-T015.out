ommand: /doctor:symlink\\\" .skilled/commands/doctor/_routes.yaml | head -80\",\"workdir\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research\"}"},"time":{"start":1794528220576,"end":1794528221055}}}}
