yond-max-query-tokens\",\n      \"token\": \"contract\"\n    },\n    {\n      \"reason\": \"beyond-max-query-tokens\",\n      \"token\": \"test\"\n    }\n  ],\n  \"indexHash\": \"cac6622b1df8eae3cf5fe37681108fd2e890dfeb637c88211608313d0c4227cd\",\n  \"manifestHash\": \"c243be4138be26b030af5a965ddc587955809ebe6ccd694e69601c9e81a327a8\",\n  \"normalizedQuery\": \"t015 add hook wiring to doctor symlink check yaml doctor symlink contract test\",\n  \"results\": [],\n  \"schemaVersion\": 2,\n  \"specFolder\": null,\n  \"tokens\": [\n    \"t015\",\n    \"add\",\n    \"hook\",\n    \"wiring\",\n    \"doctor\",\n    \"symlink\",\n    \"check\",\n    \"yaml\"\n  ],\n  \"totalCandidates\": 0,\n  \"truncated\": false,\n  \"staleFallback\": {\n    \"available\": true,\n    \"files\": 232,\n    \"matches\": 0,\n    \"paths\": [],\n    \"truncated\": false\n  }\n}\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"node .skilled/skills/system-spec-kit/runtime/cli/retrieval/lookup-trigger-index.mjs --json --scoring-only -- \\\"T015 add hook_wiring to doctor-symlink-check.yaml doctor symlink contract test\\\" 2>&1 | head -50\",\"workdir\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research\"}"},"time":{"start":1794528107283,"end":1794528109685}}}}
