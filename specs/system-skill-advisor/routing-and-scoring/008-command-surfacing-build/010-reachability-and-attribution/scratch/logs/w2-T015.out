.yaml\ndoctor-update-compat-action.yaml\ndoctor-update-presentation.txt\ndoctor-update-record-base.yaml\ndoctor-update-rollback.yaml\nmcp-mutation-class-manifest.yaml\nsymlink-manifest.json\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"agents-md-manifest.json\ndoctor-agents-md-check.yaml\ndoctor-agents-md-embed.yaml\ndoctor-agents-md-presentation.txt\ndoctor-agents-md-restore.yaml\ndoctor-ci-presentation.txt\ndoctor-ci-report.yaml\ndoctor-ci-scaffold.yaml\ndoctor-ci-toggle.yaml\ndoctor-deep-loop-presentation.txt\ndoctor-deep-loop.yaml\ndoctor-env-presentation.txt\ndoctor-env.yaml\ndoctor-git-hooks.yaml\ndoctor-git-presentation.txt\ndoctor-git-setup.yaml\ndoctor-git-standards.yaml\ndoctor-helper-presentation.txt\ndoctor-helper.yaml\ndoctor-install-presentation.txt\ndoctor-install.yaml\ndoctor-mcp-debug.yaml\ndoctor-mcp-install.yaml\ndoctor-mcp-presentation.txt\ndoctor-overlay-apply.yaml\ndoctor-overlay-presentation.txt\ndoctor-overlay-repin.yaml\ndoctor-overlay-status.yaml\ndoctor-parent-skill.yaml\ndoctor-router-reach.yaml\ndoctor-runtime-mirrors-presentation.txt\ndoctor-runtime-mirrors.yaml\ndoctor-setup-presentation.txt\ndoctor-setup.yaml\ndoctor-sk-code-presentation.txt\ndoctor-sk-code-quality.yaml\ndoctor-sk-code-setup.yaml\ndoctor-sk-skill-check.yaml\ndoctor-sk-skill-convert.yaml\ndoctor-sk-skill-presentation.txt\ndoctor-skill-advisor-presentation.txt\ndoctor-skill-advisor-rebuild.yaml\ndoctor-skill-advisor-tune.yaml\ndoctor-skill-budget.yaml\ndoctor-skill-graph-freshness.yaml\ndoctor-speckit-presentation.txt\ndoctor-speckit-retrieval.yaml\ndoctor-symlink-check.yaml\ndoctor-symlink-link.yaml\ndoctor-symlink-presentation.txt\ndoctor-symlink-unlink.yaml\ndoctor-update-align.yaml\ndoctor-update-apply.yaml\ndoctor-update-check.yaml\ndoctor-update-compat-action.yaml\ndoctor-update-presentation.txt\ndoctor-update-record-base.yaml\ndoctor-update-rollback.yaml\nmcp-mutation-class-manifest.yaml\nsymlink-manifest.json\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"ls .skilled/commands/doctor/assets/\",\"workdir\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research\"}"},"time":{"start":1794528171856,"end":1794528172251}}}}
