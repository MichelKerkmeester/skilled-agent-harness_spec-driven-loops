{"type":"tool_use","timestamp":1794528141250,"sessionID":"ses_e2dcb1a37ffeB0Y69siDRonAev","part":{"partID":"prt_1d2365f98001zSEu7rWBIeZOf3","sessionID":"ses_e2dcb1a37ffeB0Y69siDRonAev","messageID":"msg_1d2365233001Ub5hexbwzNH53i","type":"tool","id":"call_7d694304bbdc4772bd546b24","tool":"read","state":{"status":"completed","input":{"path":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/commands/doctor/scripts/tests/doctor-symlink-contract.test.cjs"},"output":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/commands/doctor/scripts/tests/doctor-symlink-contract.test.cjs, lines 1-619\n1: #!/usr/bin/env node\n2: // ───────────────────────────────────────────────────────────────────\n3: // MODULE: Doctor Symlink Contract Tests\n4: // ───────────────────────────────────────────────────────────────────\n5: 'use strict';\n6: \n7: const assert = require('node:assert/strict');\n8: const fs = require('node:fs');\n9: const path = require('node:path');\n10: const test = require('node:test');\n11: const { parse: parseYaml } = require('yaml');\n12: \n13: const DOCTOR = path.resolve(__dirname, '..', '..');\n14: const ASSETS = path.join(DOCTOR, 'assets');\n15: const REPO_ROOT = path.resolve(DOCTOR, '..', '..', '..');\n16: const SKILL_DOC_ASSETS = path.resolve(DOCTOR, '..', '..', 'skills', 'sk-doc', 'sk-create-command', 'assets');\n17: const read = (file) => fs.readFileSync(file, 'utf8');\n18: const TICK = String.fromCharCode(96);\n19: \n20: const MANIFEST = parseYaml(read(path.join(DOCTOR, '_routes.yaml')));\n21: const ROUTES = MANIFEST.routes.filter((route) => route.command === '/doctor:symlink');\n22: const routeFor = (target) => ROUTES.find((route) => route.target === target);\n23: \n24: const ROUTER = read(path.join(DOCTOR, 'symlink.md'));\n25: const PRESENTATION = read(path.join(ASSETS, 'doctor-symlink-presentation.txt'));\n26: const CHECK_YAML = read(path.join(ASSETS, 'doctor-symlink-check.yaml'));\n27: const LINK_YAML = read(path.join(ASSETS, 'doctor-symlink-link.yaml'));\n28: const UNLINK_YAML = read(path.join(ASSETS, 'doctor-symlink-unlink.yaml'));\n29: const CHECK_WORKFLOW = parseYaml(CHECK_YAML);\n30: const LINK_WORKFLOW = parseYaml(LINK_YAML);\n31: const UNLINK_WORKFLOW = parseYaml(UNLINK_YAML);\n32: const LINK_PHASES = Object.keys(LINK_WORKFLOW.execution);\n33: const UNLINK_PHASES = Object.keys(UNLINK_WORKFLOW.execution);\n34: \n35: const CONTRACT = JSON.parse(read(path.join(SKILL_DOC_ASSETS, 'command-contract.json')));\n36: const SCHEMA = JSON.parse(read(path.join(SKILL_DOC_ASSETS, 'command-contract.schema.json')));\n37: const DOCTOR_CONTRACT = CONTRACT.families.doctor;\n38: const FAMILY_SCHEMA = SCHEMA.definitions.familyContract;\n39: \n40: const ENGINE_PATH = '.skilled/commands/doctor/scripts/symlink-engine.cjs';\n41: const MANIFEST_PATH = '.skilled/commands/doctor/assets/symlink-manifest.json';\n42: const ENGINE_COMMANDS = ['check', 'plan', 'apply', 'unlink'];\n43: const { parseArgs: parseEngineArgs } = require(path.join(REPO_ROOT, ENGINE_PATH));\n44: \n45: const yamlStrings = (node, out = []) => {\n46:   if (Array.isArray(node)) {\n47:     for (const value of node) yamlStrings(value, out);\n48:   } else if (node && typeof node === 'object') {\n49:     for (const [key, value] of Object.entries(node)) {\n50:       out.push(key);\n51:       yamlStrings(value, out);\n52:     }\n53:   } else if (typeof node === 'string') {\n54:     out.push(node);\n55:   }\n56:   return out;\n57: };\n58: \n59: const phaseText = (workflow, phase) => yamlStrings(workflow.execution[phase]).join('\\n');\n60: \n61: const engineOf = (entry) => {\n62:   const match = entry.match(/symlink-engine\\.cjs\\s+([a-z-]+)/u);\n63:   assert.ok(match, entry);\n64:   return match[1];\n65: };\n66: \n67: // The engine's own argument parser is the authority for which flags each subcommand accepts.\n68: // Each probe carries the subcommand's required flags, then offers the flag with and without\n69: // a value; a flag the parser takes in either form is accepted.\n70: const ENGINE_REQUIRED = {\n71:   check: ['--root', '/tmp/doctor-symlink-probe'],\n72:   plan: ['--root', '/tmp/doctor-symlink-probe'],\n73:   apply: ['--root', '/tmp/doctor-symlink-probe', '--plan-digest', 'a'.repeat(64)],\n74:   unlink: ['--run', '/tmp/doctor-symlink-probe'],\n75: };\n76: const PROBE_VALUES = { '--mode': 'auto', '--ignore': 'none', '--runtimes': 'claude', '--include': 'env' };\n77: const CANDIDATE_FLAGS = [\n78:   '--root', '--source', '--runtimes', '--mode', '--include', '--link-instructions', '--ignore',\n79:   '--plan-digest', '--run', '--dry-run', '--yes', '--json',\n80: ];\n81: \n82: const engineAccepts = (command, flag) => {\n83:   if (ENGINE_REQUIRED[command].includes(flag)) return true;\n84:   for (const tail of [[flag, PROBE_VALUES[flag] || '/tmp/doctor-symlink-probe-value'], [flag]]) {\n85:     try {\n86:       parseEngineArgs([command, ...ENGINE_REQUIRED[command], ...tail]);\n87:       return true;\n88:     } catch {\n89:       // A rejected form is tried in its other shape before the flag counts as unknown.\n90:     }\n91:   }\n92:   return false;\n93: };\n94: \n95: const ENGINE_FLAGS = new Map(ENGINE_COMMANDS.map((command) => [\n96:   command,\n97:   new Set(CANDIDATE_FLAGS.filter((flag) => engineAccepts(command, flag))),\n98: ]));\n99: \n100: // link's --dry-run stops the workflow after the plan is shown. The engine's plan never\n101: // writes, so no engine flag carries it.\n102: const WORKFLOW_ONLY_FLAGS = { link: new Set(['--dry-run']) };\n103: \n104: const flagName = (flag) => flag.match(/^--[a-z-]+/u)?.[0] || flag;\n105: \n106: // ─────────────────────────────────────────────────────────────────────────────\n107: // 2. THE ROUTES\n108: // ─────────────────────────────────────────────────────────────────────────────\n109: \n110: test('the manifest holds check, link and unlink routes, with only check as the bare default', () => {\n111:   assert.deepEqual(ROUTES.map((route) => route.target), ['check', 'link', 'unlink']);\n112:   assert.equal(routeFor('check').default_target, true);\n113:   assert.equal(routeFor('link').default_target, undefined);\n114:   assert.equal(routeFor('unlink').default_target, undefined);\n115:   assert.equal(routeFor('check').mutating, 'read-only');\n116:   assert.match(routeFor('check').gate3_location, /^n\\/a/u);\n117:   assert.equal(routeFor('link').mutating, 'mutates');\n118:   assert.equal(routeFor('unlink').mutating, 'mutates');\n119: \n120:   for (const route of ROUTES) {\n121:     assert.equal(route.yaml, 'doctor-symlink-' + route.target + '.yaml');\n122:     assert.ok(fs.existsSync(path.join(ASSETS, route.yaml)), route.yaml);\n123:     assert.deepEqual(route.mcp_tools, []);\n124:   }\n125: \n126:   assert.deepEqual(routeFor('check').allowed_flags, [\n127:     '--json',\n128:     '--root <dir>',\n129:     '--runtimes <list>',\n130:     '--include <list>',\n131:     '--link-instructions',\n132:   ]);\n133:   assert.deepEqual(routeFor('link').allowed_flags, [\n134:     '--root <dir>',\n135:     '--runtimes <list>',\n136:     '--mode <shape>',\n137:     '--include <list>',\n138:     '--link-instructions',\n139:     '--ignore <where>',\n140:     '--dry-run',\n141:     '--plan-digest <digest>',\n142:   ]);\n143:   assert.deepEqual(routeFor('unlink').allowed_flags, ['--run <dir>', '--yes', '--dry-run']);\n144: });\n145: \n146: test('the route manifest header lists every router file in the folder', () => {\n147:   const header = read(path.join(DOCTOR, '_routes.yaml')).split(/^schema_version:/mu)[0];\n148:   const listed = [...header.matchAll(/^#\\s+\\/doctor:(\\S+)\\s+\\S+\\.md$/gmu)]\n149:     .map((match) => match[1])\n150:     .sort();\n151:   const routers = fs.readdirSync(DOCTOR)\n152:     .filter((file) => file.endsWith('.md') && !file.startsWith('local-'))\n153:     .map((file) => file.replace(/\\.md$/u, ''))\n154:     .sort();\n155:   assert.deepEqual(listed, routers, 'the header names every router or its count is wrong');\n156: });\n157: \n158: test('the writing routes name their write boundary and keep it out of unrelated state', () => {\n159:   const link = routeFor('link').gate3_location;\n160:   for (const expected of [\n161:     /framework links/u,\n162:     /broken links into the Skilled checkout/u,\n163:     /info\\/exclude/u,\n164:     /run record/u,\n165:     /plan digest/u,\n166:   ]) {\n167:     assert.match(link, expected);\n168:   }\n169:   assert.doesNotMatch(link, /the git index|history|remotes/u);\n170: \n171:   const unlink = routeFor('unlink').gate3_location;\n172:   assert.match(unlink, /manifest\\.json/u);\n173:   assert.match(unlink, /changed since the apply/u);\n174:   assert.match(unlink, /run directory itself is read and kept/u);\n175: });\n176: \n177: test('each route names its engine calls and its triggers describe the route in plain language', () => {\n178:   for (const route of ROUTES) {\n179:     for (const phrase of route.trigger_phrases) {\n180:       assert.ok(phrase.trim().split(/\\s+/u).length >= 3, phrase);\n181:     }\n182:   }\n183: \n184:   assert.deepEqual(routeFor('check').script_invocations.map(engineOf), ['check']);\n185:   assert.deepEqual(routeFor('link').script_invocations.map(engineOf), ['plan', 'apply']);\n186:   assert.deepEqual(routeFor('unlink').script_invocations.map(engineOf), ['unlink', 'unlink']);\n187: \n188:   const planAndApply = routeFor('link').script_invocations.join('\\n');\n189:   assert.match(planAndApply, /symlink-engine\\.cjs plan/u);\n190:   assert.doesNotMatch(planAndApply.split('\\n')[0], /--plan-digest/u);\n191:   assert.match(planAndApply, /symlink-engine\\.cjs apply --root <dir> --plan-digest <digest>/u);\n192:   assert.match(routeFor('unlink').script_invocations[0], /unlink --run <dir> --dry-run/u);\n193:   assert.match(routeFor('unlink').script_invocations[1], /unlink --run <dir> --yes/u);\n194: });\n195: \n196: test('every route flag is accepted by an engine subcommand that route invokes', () => {\n197:   const unsupported = [];\n198:   for (const route of ROUTES) {\n199:     const subcommands = new Set(route.script_invocations.map(engineOf));\n200:     const accepted = new Set([...subcommands].flatMap((command) => [...ENGINE_FLAGS.get(command)]));\n201:     for (const allowedFlag of route.allowed_flags) {\n202:       const name = flagName(allowedFlag);\n203:       if (!accepted.has(name) && !WORKFLOW_ONLY_FLAGS[route.target]?.has(name)) {\n204:         unsupported.push(route.target + ' ' + name);\n205:       }\n206:     }\n207:   }\n208:   assert.deepEqual(unsupported, [], 'route flags outside the engine CLI contract');\n209: });\n210: \n211: test('every engine invocation uses flags accepted by the documented subcommand', () => {\n212:   const unsupported = [];\n213:   for (const route of ROUTES) {\n214:     for (const invocation of route.script_invocations) {\n215:       const command = engineOf(invocation);\n216:       const call = invocation.split('#')[0];\n217:       const flags = [...call.matchAll(/(--[a-z-]+)/gu)].map((match) => match[1]);\n218:       for (const flag of flags) {\n219:         if (!ENGINE_FLAGS.get(command).has(flag)) unsupported.push(route.target + ' ' + command + ' ' + flag);\n220:       }\n221:     }\n222:   }\n223:   assert.deepEqual(unsupported, [], 'engine invocations outside the CLI contract');\n224: });\n225: \n226: test('the router follows the six-section router template and keeps presentation out of line', () => {\n227:   const headings = [...ROUTER.matchAll(/^## \\d+\\. ([A-Z ]+)$/gmu)].map((match) => match[1]);\n228:   assert.deepEqual(headings, [\n229:     'ROUTER CONTRACT',\n230:     'OWNED ASSETS',\n231:     'MODE ROUTING',\n232:     'EXECUTION TARGETS',\n233:     'PRESENTATION BOUNDARY',\n234:     'WORKFLOW SUMMARY',\n235:   ]);\n236:   assert.equal(ROUTER.includes(TICK.repeat(3)), false);\n237:   assert.doesNotMatch(ROUTER, /STATUS=/u);\n238: });\n239: \n240: test('the router frontmatter stays within budget and grants only the tools it uses', () => {\n241:   const description = ROUTER.match(/^description:\\s*\"(.*)\"$/mu)?.[1];\n242:   assert.ok(description);\n243:   assert.ok(description.length <= 110, 'description is ' + description.length + ' chars');\n244:   assert.doesNotMatch(description, /[<>]/u);\n245: \n246:   const hint = ROUTER.match(/^argument-hint:\\s*\"(.*)\"$/mu)?.[1];\n247:   assert.ok(hint);\n248:   assert.ok(hint.length <= 140, 'argument-hint is ' + hint.length + ' chars');\n249:   for (const token of [\n250:     '[check|link|unlink]',\n251:     '[--root <dir>]',\n252:     '[--runtimes <list>]',\n253:     '[--mode <shape>]',\n254:     '[--plan-digest <digest>]',\n255:     '[--run <dir>]',\n256:     '[--yes]',\n257:   ]) {\n258:     assert.ok(hint.includes(token), token);\n259:   }\n260: \n261:   const tools = ROUTER.match(/^allowed-tools:\\s*(.+)$/mu)[1].split(',').map((tool) => tool.trim());\n262:   assert.deepEqual(tools, ['Read', 'Bash']);\n263:   assert.equal(ROUTER.split('<!-- skill_agent: system-skilled-doctor -->').length - 1, 1);\n264: });\n265: \n266: test('the router binds each target to the workflow asset its route names', () => {\n267:   for (const route of ROUTES) {\n268:     const row = '| ' + TICK + route.target + TICK + ' | ' + TICK\n269:       + '.skilled/commands/doctor/assets/' + route.yaml + TICK + ' |';\n270:     assert.ok(ROUTER.includes(row), route.target);\n271:   }\n272: });\n273: \n274: test('the router names the engine and manifest as owned assets and composes no link itself', () => {\n275:   const owned = ROUTER.split('## 2. OWNED ASSETS')[1].split('## 3.')[0];\n276:   assert.ok(owned.includes(ENGINE_PATH), ENGINE_PATH);\n277:   assert.ok(owned.includes(MANIFEST_PATH), MANIFEST_PATH);\n278:   assert.ok(owned.includes('doctor-symlink-presentation.txt'));\n279:   assert.match(ROUTER, /Do not compose a link, remove one or hash a plan/u);\n280: });\n281: \n282: test('the router resolves the bare command to check and keeps every write behind digest and yes', () => {\n283:   assert.match(ROUTER, /default_target/u);\n284:   assert.match(ROUTER, /A bare .*never reaches .*which write/u);\n285:   assert.match(ROUTER, /never runs .*apply.*without the digest its own plan printed/u);\n286:   assert.match(ROUTER, /never runs a writing target without its yes/u);\n287: });\n288: \n289: test('the router workflow summary runs plan, digest, question, apply and re-read in order', () => {\n290:   const summary = ROUTER.split('## 6. WORKFLOW SUMMARY')[1];\n291:   const steps = summary.split('\\n')\n292:     .map((line) => line.trim())\n293:     .filter((line) => /^\\d+\\. /u.test(line));\n294:   const at = (pattern) => {\n295:     const index = steps.findIndex((step) => pattern.test(step));\n296:     assert.ok(index >= 0, 'no step names ' + pattern);\n297:     return index;\n298:   };\n299: \n300:   const plan = at(/symlink-engine\\.cjs plan/u);\n301:   const digest = at(/plan digest/u);\n302:   const question = at(/asks the link question/u);\n303:   const apply = at(/symlink-engine\\.cjs apply --plan-digest/u);\n304:   const reread = at(/post-apply check summary/u);\n305:   assert.ok(plan < digest, 'the plan prints before its digest is offered');\n306:   assert.ok(digest < question, 'the digest is named before the question');\n307:   assert.ok(question < apply, 'apply follows the link question');\n308:   assert.ok(apply < reread, 'the re-read follows apply');\n309:   assert.match(steps.join('\\n'), /ends the run as cancelled/u);\n310:   assert.match(steps.join('\\n'), /nothing is written/u);\n311:   assert.match(steps.join('\\n'), /unlink/u);\n312: });\n313: \n314: test('the presentation carries the menu, accepted answers and route manifest rows', () => {\n315:   assert.match(PRESENTATION, /^## 1\\. Argument Failure$/mu);\n316:   assert.match(PRESENTATION, /^1\\) check$/mu);\n317:   assert.match(PRESENTATION, /^2\\) link$/mu);\n318:   assert.match(PRESENTATION, /^3\\) unlink$/mu);\n319:   for (const row of [\n320:     '| ' + TICK + '1' + TICK + ' | target = ' + TICK + 'check' + TICK + ' |',\n321:     '| ' + TICK + '2' + TICK + ' | target = ' + TICK + 'link' + TICK + ' |',\n322:     '| ' + TICK + '3' + TICK + ' | target = ' + TICK + 'unlink' + TICK + ' |',\n323:   ]) {\n324:     assert.ok(PRESENTATION.includes(row), row);\n325:   }\n326:   assert.match(PRESENTATION, /^Valid targets: check, link, unlink$/mu);\n327:   for (const [target, workflow, mutation] of [\n328:     ['check', 'doctor-symlink-check.yaml', 'read-only'],\n329:     ['link', 'doctor-symlink-link.yaml', 'mutates'],\n330:     ['unlink', 'doctor-symlink-unlink.yaml', 'mutates'],\n331:   ]) {\n332:     const row = '| ' + TICK + target + TICK + ' | ' + TICK + workflow + TICK + ' | ' + mutation + ' |';\n333:     assert.ok(PRESENTATION.includes(row), target);\n334:   }\n335: });\n336: \n337: test('the argument table defines a missing value and second positional for every target', () => {\n338:   const table = PRESENTATION.split('## 1. Argument Failure')[1].split(/\\n## 2\\./u)[0];\n339:   const rows = table.split('\\n').filter((line) => line.startsWith('| '));\n340:   const missing = rows.find((line) => /value flag given without its value/u.test(line));\n341:   assert.ok(missing, 'no row for a value flag given without its value');\n342:   for (const flag of ['--root', '--runtimes', '--mode', '--include', '--ignore', '--plan-digest', '--run']) {\n343:     assert.ok(missing.includes(flag), flag + ' is not named');\n344:   }\n345:   assert.match(missing, /STATUS=FAIL ERROR=\"missing_argument\"/u);\n346:   assert.match(missing, /Try: /u);\n347: \n348:   const second = rows.find((line) => /second positional/u.test(line));\n349:   assert.ok(second, 'no row for a second positional');\n350:   assert.match(second, /\\/doctor:symlink check \\[--json\\] \\[--root <dir>\\]/u);\n351:   assert.match(second, /\\/doctor:symlink link \\[--dry-run\\]/u);\n352:   assert.match(second, /\\/doctor:symlink unlink --run <dir>/u);\n353:   assert.match(second, /STATUS=FAIL ERROR=\"too_many_arguments\"/u);\n354:   assert.match(ROUTER, /a value flag without its value/u);\n355:   assert.match(ROUTER, /a second positional/u);\n356: });\n357: \n358: test('the check presentation carries status, JSON and result fields', () => {\n359:   for (const status of [\n360:     'linked-whole',\n361:     'linked-merge',\n362:     'partial-merge',\n363:     'missing',\n364:     'broken',\n365:     'foreign-link',\n366:     'local',\n367:     'source-missing',\n368:   ]) {\n369:     assert.ok(PRESENTATION.includes(status), status);\n370:   }\n371:   assert.match(PRESENTATION, /^Skilled link check: \\[the root the engine read\\]$/mu);\n372:   assert.match(PRESENTATION, /^DOCTOR DIAGNOSTIC RESULT$/mu);\n373:   const statusTemplates = PRESENTATION.split(/\\r?\\n/u).filter((line) => /^STATUS=\\[/u.test(line));\n374:   assert.ok(statusTemplates.length > 0, 'presentation has a STATUS template');\n375:   assert.deepEqual(statusTemplates, statusTemplates.map(() => 'STATUS=[OK|WARN|FAIL]'));\n376:   assert.match(PRESENTATION, /^Status: \\[OK\\|WARN\\|FAIL\\]$/mu);\n377:   assert.match(PRESENTATION, /`Status` is `OK` when the engine exits 0, `WARN` when it exits 1 and `FAIL` when it exits 2/u);\n378:   assert.doesNotMatch(PRESENTATION, /FINDINGS/u);\n379:   assert.match(PRESENTATION, /print the engine's JSON and nothing else/u);\n380:   assert.match(PRESENTATION, /^Plan digest: \\[the engine's plan-digest line\\]$/mu);\n381:   assert.match(PRESENTATION, /Link the Skilled checkout into this repository now\\? \\[yes\\/no\\]\\n?$/u);\n382:   assert.match(PRESENTATION, /the digest on screen is the digest the apply repeats/u);\n383:   assert.match(PRESENTATION, /never compose a plan digest/u);\n384: });\n385: \n386: test('the presentation closes on cancelled, dry-run and failure results', () => {\n387:   assert.match(PRESENTATION, /^STATUS=CANCELLED ACTION=cancelled$/mu);\n388:   assert.match(PRESENTATION, /^Changed: none$/mu);\n389:   assert.match(PRESENTATION, /^Dry run: nothing was written and nothing was asked\\.$/mu);\n390:   assert.match(PRESENTATION, /^STATUS=FAIL ERROR=\"\\[code\\]\"$/mu);\n391:   assert.match(PRESENTATION, /End interactive presentations with:.*What would you like to do next/u);\n392:   assert.equal(PRESENTATION.split('STATUS=CANCELLED ACTION=cancelled').length - 1, 2);\n393: });\n394: \n395: // ─────────────────────────────────────────────────────────────────────────────\n396: // 4. THE CHECK WORKFLOW\n397: // ─────────────────────────────────────────────────────────────────────────────\n398: \n399: test('the check workflow is read-only and runs only the check engine', () => {\n400:   assert.equal(CHECK_WORKFLOW.operating_mode.execution, 'read_only');\n401:   assert.equal(CHECK_WORKFLOW.mutation_boundaries.read_only, true);\n402:   assert.deepEqual(CHECK_WORKFLOW.mutation_boundaries.allowed_targets, []);\n403:   assert.ok(CHECK_YAML.includes(ENGINE_PATH), ENGINE_PATH);\n404:   assert.match(CHECK_WORKFLOW.mutation_boundaries.invariant, /check subcommand only/u);\n405:   assert.doesNotMatch(CHECK_YAML, /symlink-engine\\.cjs (?:plan|apply|unlink)/u);\n406: });\n407: \n408: test('the check workflow declares every variable the route resolves', () => {\n409:   for (const key of routeFor('check').setup_vars) {\n410:     assert.ok(key in CHECK_WORKFLOW.inputs, 'inputs.' + key + ' is missing');\n411:   }\n412: });\n413: \n414: test('the check workflow forwards optional flags only when requested', () => {\n415:   assert.match(CHECK_WORKFLOW.inputs.json_output, /pass --json/u);\n416:   assert.match(CHECK_YAML, /--json when requested/u);\n417:   assert.match(CHECK_WORKFLOW.inputs.root, /--root <dir>/u);\n418:   assert.match(CHECK_WORKFLOW.inputs.runtimes, /--runtimes/u);\n419:   assert.match(CHECK_WORKFLOW.inputs.include, /--include/u);\n420:   assert.match(CHECK_WORKFLOW.inputs.link_instructions, /--link-instructions/u);\n421:   assert.match(CHECK_YAML, /check --root \"\\{root\\}\"/u);\n422: });\n423: \n424: test('the check workflow maps the engine exit classes to the route status', () => {\n425:   assert.match(CHECK_WORKFLOW.output, /STATUS=OK/u);\n426:   assert.match(CHECK_WORKFLOW.output, /STATUS=WARN/u);\n427:   assert.match(CHECK_WORKFLOW.output, /STATUS=FAIL/u);\n428:   assert.match(CHECK_YAML, /Exit 0 means no drift/u);\n429:   assert.match(CHECK_YAML, /Exit 1 means drift was found/u);\n430:   assert.match(CHECK_YAML, /Exit 2 means the invocation/u);\n431:   assert.match(CHECK_WORKFLOW.output, /engine exits 2/u);\n432: });\n433: \n434: // ─────────────────────────────────────────────────────────────────────────────\n435: // 5. THE LINK AND UNLINK WORKFLOWS\n436: // ─────────────────────────────────────────────────────────────────────────────\n437: \n438: test('the link workflow is interactive, digest-gated and never commits', () => {\n439:   assert.equal(LINK_WORKFLOW.operating_mode.execution, 'interactive');\n440:   assert.equal(LINK_WORKFLOW.operating_mode.approvals, 'explicit_yes');\n441:   assert.equal(LINK_WORKFLOW.operating_mode.planning, 'show_plan_and_digest_before_question');\n442:   assert.equal(LINK_WORKFLOW.operating_mode.tracking, 'one_plan_digest');\n443:   assert.equal(LINK_WORKFLOW.operating_mode.never_commit, true);\n444:   assert.deepEqual(LINK_WORKFLOW.output.statuses, ['OK', 'CANCELLED', 'FAIL']);\n445:   assert.equal(LINK_WORKFLOW.output.presentation, '.skilled/commands/doctor/assets/doctor-symlink-presentation.txt');\n446:   assert.equal(LINK_WORKFLOW.mutation_boundaries.read_only, false);\n447: \n448:   const allowed = LINK_WORKFLOW.mutation_boundaries.allowed_targets.join('\\n');\n449:   assert.match(allowed, /Only link paths and directories listed by the plan/u);\n450:   assert.match(allowed, /\\.git\\/info\\/exclude or \\.gitignore/u);\n451:   assert.match(allowed, /doctor-symlink\\/<first 16 hex characters/u);\n452:   const forbidden = LINK_WORKFLOW.mutation_boundaries.forbidden_targets.join('\\n');\n453:   assert.match(forbidden, /Any path that the plan does not list/u);\n454:   assert.match(forbidden, /git index, history and remotes/u);\n455:   assert.match(LINK_WORKFLOW.mutation_boundaries.invariant, /digest differs/u);\n456: });\n457: \n458: test('the link workflow runs read, plan, approval, apply and report in order', () => {\n459:   assert.deepEqual(LINK_PHASES, [\n460:     'phase_1_read',\n461:     'phase_2_plan',\n462:     'phase_3_approval',\n463:     'phase_4_apply',\n464:     'phase_5_report',\n465:   ]);\n466: \n467:   const plan = phaseText(LINK_WORKFLOW, 'phase_2_plan');\n468:   assert.match(plan, /symlink-engine\\.cjs plan/u);\n469:   assert.doesNotMatch(plan, /--plan-digest/u);\n470:   assert.match(plan, /plan digest/iu);\n471: \n472:   const approval = phaseText(LINK_WORKFLOW, 'phase_3_approval');\n473:   assert.match(approval, /Ask the one link question/u);\n474:   assert.match(approval, /Any answer other than yes is a no/u);\n475:   assert.match(approval, /STATUS=CANCELLED ACTION=cancelled/u);\n476:   assert.match(approval, /Do not run apply/u);\n477: \n478:   const apply = phaseText(LINK_WORKFLOW, 'phase_4_apply');\n479:   assert.match(apply, /symlink-engine\\.cjs apply --root/u);\n480:   assert.match(apply, /--plan-digest/u);\n481:   assert.match(apply, /only after the operator approves/u);\n482:   assert.match(apply, /same optional flags/u);\n483:   assert.match(apply, /undo command/u);\n484: });\n485: \n486: test('the link workflow declares every variable the route resolves', () => {\n487:   const missing = routeFor('link').setup_vars.filter((key) => !(key in LINK_WORKFLOW.inputs));\n488:   assert.deepEqual(missing, [], 'link workflow inputs missing route variables');\n489: });\n490: \n491: test('the link workflow handles its route dry-run flag before approval or apply', () => {\n492:   assert.ok('dry_run' in LINK_WORKFLOW.inputs, 'inputs.dry_run is missing');\n493:   assert.match(phaseText(LINK_WORKFLOW, 'phase_2_plan'), /dry_run/u);\n494:   assert.match(phaseText(LINK_WORKFLOW, 'phase_2_plan'), /writes nothing/u);\n495: });\n496: \n497: test('the unlink workflow is interactive and changes only recorded paths', () => {\n498:   assert.equal(UNLINK_WORKFLOW.operating_mode.execution, 'interactive');\n499:   assert.equal(UNLINK_WORKFLOW.operating_mode.approvals, 'explicit_yes');\n500:   assert.equal(UNLINK_WORKFLOW.operating_mode.never_commit, true);\n501:   assert.deepEqual(UNLINK_WORKFLOW.output.statuses, ['OK', 'CANCELLED', 'FAIL']);\n502:   assert.equal(UNLINK_WORKFLOW.output.presentation, '.skilled/commands/doctor/assets/doctor-symlink-presentation.txt');\n503:   assert.equal(UNLINK_WORKFLOW.mutation_boundaries.read_only, false);\n504: \n505:   const allowed = UNLINK_WORKFLOW.mutation_boundaries.allowed_targets.join('\\n');\n506:   assert.match(allowed, /Only paths listed in the run manifest/u);\n507:   assert.match(allowed, /Only directories listed in created_dirs/u);\n508:   assert.match(allowed, /Only the exact lines listed in ignore_added/u);\n509:   const forbidden = UNLINK_WORKFLOW.mutation_boundaries.forbidden_targets.join('\\n');\n510:   assert.match(forbidden, /Any path not listed in the run manifest/u);\n511:   assert.match(forbidden, /run directory, its manifest and its copies/u);\n512:   assert.match(forbidden, /git index, history and remotes/u);\n513: });\n514: \n515: test('the unlink workflow shows the dry-run plan, asks once and writes only after yes', () => {\n516:   assert.deepEqual(UNLINK_PHASES, [\n517:     'phase_1_read',\n518:     'phase_2_plan',\n519:     'phase_3_approval',\n520:     'phase_4_unlink',\n521:     'phase_5_report',\n522:   ]);\n523: \n524:   const plan = phaseText(UNLINK_WORKFLOW, 'phase_2_plan');\n525:   assert.match(plan, /symlink-engine\\.cjs unlink --run .*--dry-run/u);\n526:   assert.doesNotMatch(plan, /--yes/u);\n527:   assert.match(plan, /dry-run writes nothing/u);\n528: \n529:   const approval = phaseText(UNLINK_WORKFLOW, 'phase_3_approval');\n530:   assert.match(approval, /Ask the one unlink question/u);\n531:   assert.match(approval, /Any answer other than yes is a no/u);\n532:   assert.match(approval, /Do not run unlink with --yes/u);\n533: \n534:   const write = phaseText(UNLINK_WORKFLOW, 'phase_4_unlink');\n535:   assert.match(write, /symlink-engine\\.cjs unlink --run .*--yes/u);\n536:   assert.match(write, /only after the unlink yes/u);\n537:   assert.match(write, /changed since apply/u);\n538:   assert.match(write, /keeps the run directory/u);\n539: });\n540: \n541: test('the unlink workflow declares every variable the route resolves', () => {\n542:   const missing = routeFor('unlink').setup_vars.filter((key) => !(key in UNLINK_WORKFLOW.inputs));\n543:   assert.deepEqual(missing, [], 'unlink workflow inputs missing route variables');\n544: });\n545: \n546: test('the unlink workflow lets an explicit dry run end before its approval question', () => {\n547:   assert.ok('dry_run' in UNLINK_WORKFLOW.inputs, 'inputs.dry_run is missing');\n548:   assert.match(phaseText(UNLINK_WORKFLOW, 'phase_2_plan'), /dry_run/u);\n549:   assert.match(phaseText(UNLINK_WORKFLOW, 'phase_2_plan'), /end the run without asking/u);\n550: });\n551: \n552: test('the doctor family contract carries every schema-required field and no unknown field', () => {\n553:   for (const key of FAMILY_SCHEMA.required) {\n554:     assert.ok(key in DOCTOR_CONTRACT, 'families.doctor is missing ' + key);\n555:   }\n556:   const known = new Set(Object.keys(FAMILY_SCHEMA.properties));\n557:   assert.deepEqual(\n558:     Object.keys(DOCTOR_CONTRACT).filter((key) => !known.has(key)),\n559:     [],\n560:     'the schema forbids an additional property',\n561:   );\n562:   assert.ok(FAMILY_SCHEMA.properties.topology.enum.includes(DOCTOR_CONTRACT.topology));\n563: });\n564: \n565: test('the doctor family contract names the symlink router and generic route assets', () => {\n566:   assert.ok(DOCTOR_CONTRACT.router_path.includes('.skilled/commands/doctor/symlink.md'));\n567:   const routeTarget = DOCTOR_CONTRACT.execution_targets.find((entry) => /symlink/u.test(entry.selector));\n568:   assert.ok(routeTarget, 'the family contract has no symlink route selector');\n569:   assert.match(routeTarget.target, /<the route's yaml>, named per route in _routes\\.yaml/u);\n570:   assert.ok(DOCTOR_CONTRACT.owned_assets.some((entry) => (\n571:     entry.purpose === 'route_manifest' && entry.path === '.skilled/commands/doctor/_routes.yaml'\n572:   )));\n573:   assert.ok(DOCTOR_CONTRACT.owned_assets.some((entry) => (\n574:     entry.purpose === 'presentation' && entry.path.endsWith('doctor-<entry>-presentation.txt')\n575:   )));\n576:   assert.ok(DOCTOR_CONTRACT.owned_assets.some((entry) => entry.path.includes('doctor-<target>.yaml')));\n577:   assert.equal(DOCTOR_CONTRACT.presentation.owner, 'presentation-asset');\n578: \n579:   const hint = ROUTER.match(/^argument-hint:\\s*\"(.*)\"$/mu)[1];\n580:   assert.ok(DOCTOR_CONTRACT.input.argument_hint.includes(hint + ' (symlink)'));\n581: });\n582: \n583: test('the doctor family contract owns the symlink engine and entry manifest', () => {\n584:   for (const asset of [ENGINE_PATH, MANIFEST_PATH]) {\n585:     assert.ok(\n586:       DOCTOR_CONTRACT.owned_assets.some((entry) => entry.path.includes(asset)),\n587:       asset,\n588:     );\n589:   }\n590: });\n591: \n592: test('the doctor family loader requirements preserve the symlink route contract', () => {\n593:   const lines = DOCTOR_CONTRACT.loader_requirements.filter((line) => line.includes('/doctor:symlink'));\n594:   assert.ok(lines.length > 0, 'the family contract has no symlink loader requirement');\n595:   const text = lines.join('\\n');\n596:   assert.match(text, /check is the read-only default target/u);\n597:   assert.match(text, /plan digest/u);\n598:   assert.match(text, /unlink/u);\n599:   assert.match(text, /STATUS=CANCELLED/u);\n600: });\n601: \n602: test('the doctor family destructive policy names the gated symlink writes', () => {\n603:   assert.equal(DOCTOR_CONTRACT.destructive_policy.has_destructive_ops, true);\n604:   assert.equal(DOCTOR_CONTRACT.destructive_policy.gated, true);\n605:   assert.ok(\n606:     DOCTOR_CONTRACT.destructive_policy.operations.some((line) => /symlink/u.test(line)),\n607:     'the family contract has no symlink write operation',\n608:   );\n609: });\n610: \n611: test('the doctor family invocation aliases include the symlink command form', () => {\n612:   const hint = ROUTER.match(/^argument-hint:\\s*\"(.*)\"$/mu)[1];\n613:   assert.ok(\n614:     DOCTOR_CONTRACT.invocation_aliases.some((alias) => (\n615:       alias.startsWith('/doctor:symlink ') && alias.includes(hint)\n616:     )),\n617:     'the family contract has no /doctor:symlink invocation alias',\n618:   );\n619: });","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/commands/doctor/scripts/tests/doctor-symlink-contract.test.cjs, lines 1-619\n1: #!/usr/bin/env node\n2: // ───────────────────────────────────────────────────────────────────\n3: // MODULE: Doctor Symlink Contract Tests\n4: // ───────────────────────────────────────────────────────────────────\n5: 'use strict';\n6: \n7: const assert = require('node:assert/strict');\n8: const fs = require('node:fs');\n9: const path = require('node:path');\n10: const test = require('node:test');\n11: const { parse: parseYaml } = require('yaml');\n12: \n13: const DOCTOR = path.resolve(__dirname, '..', '..');\n14: const ASSETS = path.join(DOCTOR, 'assets');\n15: const REPO_ROOT = path.resolve(DOCTOR, '..', '..', '..');\n16: const SKILL_DOC_ASSETS = path.resolve(DOCTOR, '..', '..', 'skills', 'sk-doc', 'sk-create-command', 'assets');\n17: const read = (file) => fs.readFileSync(file, 'utf8');\n18: const TICK = String.fromCharCode(96);\n19: \n20: const MANIFEST = parseYaml(read(path.join(DOCTOR, '_routes.yaml')));\n21: const ROUTES = MANIFEST.routes.filter((route) => route.command === '/doctor:symlink');\n22: const routeFor = (target) => ROUTES.find((route) => route.target === target);\n23: \n24: const ROUTER = read(path.join(DOCTOR, 'symlink.md'));\n25: const PRESENTATION = read(path.join(ASSETS, 'doctor-symlink-presentation.txt'));\n26: const CHECK_YAML = read(path.join(ASSETS, 'doctor-symlink-check.yaml'));\n27: const LINK_YAML = read(path.join(ASSETS, 'doctor-symlink-link.yaml'));\n28: const UNLINK_YAML = read(path.join(ASSETS, 'doctor-symlink-unlink.yaml'));\n29: const CHECK_WORKFLOW = parseYaml(CHECK_YAML);\n30: const LINK_WORKFLOW = parseYaml(LINK_YAML);\n31: const UNLINK_WORKFLOW = parseYaml(UNLINK_YAML);\n32: const LINK_PHASES = Object.keys(LINK_WORKFLOW.execution);\n33: const UNLINK_PHASES = Object.keys(UNLINK_WORKFLOW.execution);\n34: \n35: const CONTRACT = JSON.parse(read(path.join(SKILL_DOC_ASSETS, 'command-contract.json')));\n36: const SCHEMA = JSON.parse(read(path.join(SKILL_DOC_ASSETS, 'command-contract.schema.json')));\n37: const DOCTOR_CONTRACT = CONTRACT.families.doctor;\n38: const FAMILY_SCHEMA = SCHEMA.definitions.familyContract;\n39: \n40: const ENGINE_PATH = '.skilled/commands/doctor/scripts/symlink-engine.cjs';\n41: const MANIFEST_PATH = '.skilled/commands/doctor/assets/symlink-manifest.json';\n42: const ENGINE_COMMANDS = ['check', 'plan', 'apply', 'unlink'];\n43: const { parseArgs: parseEngineArgs } = require(path.join(REPO_ROOT, ENGINE_PATH));\n44: \n45: const yamlStrings = (node, out = []) => {\n46:   if (Array.isArray(node)) {\n47:     for (const value of node) yamlStrings(value, out);\n48:   } else if (node && typeof node === 'object') {\n49:     for (const [key, value] of Object.entries(node)) {\n50:       out.push(key);\n51:       yamlStrings(value, out);\n52:     }\n53:   } else if (typeof node === 'string') {\n54:     out.push(node);\n55:   }\n56:   return out;\n57: };\n58: \n59: const phaseText = (workflow, phase) => yamlStrings(workflow.execution[phase]).join('\\n');\n60: \n61: const engineOf = (entry) => {\n62:   const match = entry.match(/symlink-engine\\.cjs\\s+([a-z-]+)/u);\n63:   assert.ok(match, entry);\n64:   return match[1];\n65: };\n66: \n67: // The engine's own argument parser is the authority for which flags each subcommand accepts.\n68: // Each probe carries the subcommand's required flags, then offers the flag with and without\n69: // a value; a flag the parser takes in either form is accepted.\n70: const ENGINE_REQUIRED = {\n71:   check: ['--root', '/tmp/doctor-symlink-probe'],\n72:   plan: ['--root', '/tmp/doctor-symlink-probe'],\n73:   apply: ['--root', '/tmp/doctor-symlink-probe', '--plan-digest', 'a'.repeat(64)],\n74:   unlink: ['--run', '/tmp/doctor-symlink-probe'],\n75: };\n76: const PROBE_VALUES = { '--mode': 'auto', '--ignore': 'none', '--runtimes': 'claude', '--include': 'env' };\n77: const CANDIDATE_FLAGS = [\n78:   '--root', '--source', '--runtimes', '--mode', '--include', '--link-instructions', '--ignore',\n79:   '--plan-digest', '--run', '--dry-run', '--yes', '--json',\n80: ];\n81: \n82: const engineAccepts = (command, flag) => {\n83:   if (ENGINE_REQUIRED[command].includes(flag)) return true;\n84:   for (const tail of [[flag, PROBE_VALUES[flag] || '/tmp/doctor-symlink-probe-value'], [flag]]) {\n85:     try {\n86:       parseEngineArgs([command, ...ENGINE_REQUIRED[command], ...tail]);\n87:       return true;\n88:     } catch {\n89:       // A rejected form is tried in its other shape before the flag counts as unknown.\n90:     }\n91:   }\n92:   return false;\n93: };\n94: \n95: const ENGINE_FLAGS = new Map(ENGINE_COMMANDS.map((command) => [\n96:   command,\n97:   new Set(CANDIDATE_FLAGS.filter((flag) => engineAccepts(command, flag))),\n98: ]));\n99: \n100: // link's --dry-run stops the workflow after the plan is shown. The engine's plan never\n101: // writes, so no engine flag carries it.\n102: const WORKFLOW_ONLY_FLAGS = { link: new Set(['--dry-run']) };\n103: \n104: const flagName = (flag) => flag.match(/^--[a-z-]+/u)?.[0] || flag;\n105: \n106: // ─────────────────────────────────────────────────────────────────────────────\n107: // 2. THE ROUTES\n108: // ─────────────────────────────────────────────────────────────────────────────\n109: \n110: test('the manifest holds check, link and unlink routes, with only check as the bare default', () => {\n111:   assert.deepEqual(ROUTES.map((route) => route.target), ['check', 'link', 'unlink']);\n112:   assert.equal(routeFor('check').default_target, true);\n113:   assert.equal(routeFor('link').default_target, undefined);\n114:   assert.equal(routeFor('unlink').default_target, undefined);\n115:   assert.equal(routeFor('check').mutating, 'read-only');\n116:   assert.match(routeFor('check').gate3_location, /^n\\/a/u);\n117:   assert.equal(routeFor('link').mutating, 'mutates');\n118:   assert.equal(routeFor('unlink').mutating, 'mutates');\n119: \n120:   for (const route of ROUTES) {\n121:     assert.equal(route.yaml, 'doctor-symlink-' + route.target + '.yaml');\n122:     assert.ok(fs.existsSync(path.join(ASSETS, route.yaml)), route.yaml);\n123:     assert.deepEqual(route.mcp_tools, []);\n124:   }\n125: \n126:   assert.deepEqual(routeFor('check').allowed_flags, [\n127:     '--json',\n128:     '--root <dir>',\n129:     '--runtimes <list>',\n130:     '--include <list>',\n131:     '--link-instructions',\n132:   ]);\n133:   assert.deepEqual(routeFor('link').allowed_flags, [\n134:     '--root <dir>',\n135:     '--runtimes <list>',\n136:     '--mode <shape>',\n137:     '--include <list>',\n138:     '--link-instructions',\n139:     '--ignore <where>',\n140:     '--dry-run',\n141:     '--plan-digest <digest>',\n142:   ]);\n143:   assert.deepEqual(routeFor('unlink').allowed_flags, ['--run <dir>', '--yes', '--dry-run']);\n144: });\n145: \n146: test('the route manifest header lists every router file in the folder', () => {\n147:   const header = read(path.join(DOCTOR, '_routes.yaml')).split(/^schema_version:/mu)[0];\n148:   const listed = [...header.matchAll(/^#\\s+\\/doctor:(\\S+)\\s+\\S+\\.md$/gmu)]\n149:     .map((match) => match[1])\n150:     .sort();\n151:   const routers = fs.readdirSync(DOCTOR)\n152:     .filter((file) => file.endsWith('.md') && !file.startsWith('local-'))\n153:     .map((file) => file.replace(/\\.md$/u, ''))\n154:     .sort();\n155:   assert.deepEqual(listed, routers, 'the header names every router or its count is wrong');\n156: });\n157: \n158: test('the writing routes name their write boundary and keep it out of unrelated state', () => {\n159:   const link = routeFor('link').gate3_location;\n160:   for (const expected of [\n161:     /framework links/u,\n162:     /broken links into the Skilled checkout/u,\n163:     /info\\/exclude/u,\n164:     /run record/u,\n165:     /plan digest/u,\n166:   ]) {\n167:     assert.match(link, expected);\n168:   }\n169:   assert.doesNotMatch(link, /the git index|history|remotes/u);\n170: \n171:   const unlink = routeFor('unlink').gate3_location;\n172:   assert.match(unlink, /manifest\\.json/u);\n173:   assert.match(unlink, /changed since the apply/u);\n174:   assert.match(unlink, /run directory itself is read and kept/u);\n175: });\n176: \n177: test('each route names its engine calls and its triggers describe the route in plain language', () => {\n178:   for (const route of ROUTES) {\n179:     for (const phrase of route.trigger_phrases) {\n180:       assert.ok(phrase.trim().split(/\\s+/u).length >= 3, phrase);\n181:     }\n182:   }\n183: \n184:   assert.deepEqual(routeFor('check').script_invocations.map(engineOf), ['check']);\n185:   assert.deepEqual(routeFor('link').script_invocations.map(engineOf), ['plan', 'apply']);\n186:   assert.deepEqual(routeFor('unlink').script_invocations.map(engineOf), ['unlink', 'unlink']);\n187: \n188:   const planAndApply = routeFor('link').script_invocations.join('\\n');\n189:   assert.match(planAndApply, /symlink-engine\\.cjs plan/u);\n190:   assert.doesNotMatch(planAndApply.split('\\n')[0], /--plan-digest/u);\n191:   assert.match(planAndApply, /symlink-engine\\.cjs apply --root <dir> --plan-digest <digest>/u);\n192:   assert.match(routeFor('unlink').script_invocations[0], /unlink --run <dir> --dry-run/u);\n193:   assert.match(routeFor('unlink').script_invocations[1], /unlink --run <dir> --yes/u);\n194: });\n195: \n196: test('every route flag is accepted by an engine subcommand that route invokes', () => {\n197:   const unsupported = [];\n198:   for (const route of ROUTES) {\n199:     const subcommands = new Set(route.script_invocations.map(engineOf));\n200:     const accepted = new Set([...subcommands].flatMap((command) => [...ENGINE_FLAGS.get(command)]));\n201:     for (const allowedFlag of route.allowed_flags) {\n202:       const name = flagName(allowedFlag);\n203:       if (!accepted.has(name) && !WORKFLOW_ONLY_FLAGS[route.target]?.has(name)) {\n204:         unsupported.push(route.target + ' ' + name);\n205:       }\n206:     }\n207:   }\n208:   assert.deepEqual(unsupported, [], 'route flags outside the engine CLI contract');\n209: });\n210: \n211: test('every engine invocation uses flags accepted by the documented subcommand', () => {\n212:   const unsupported = [];\n213:   for (const route of ROUTES) {\n214:     for (const invocation of route.script_invocations) {\n215:       const command = engineOf(invocation);\n216:       const call = invocation.split('#')[0];\n217:       const flags = [...call.matchAll(/(--[a-z-]+)/gu)].map((match) => match[1]);\n218:       for (const flag of flags) {\n219:         if (!ENGINE_FLAGS.get(command).has(flag)) unsupported.push(route.target + ' ' + command + ' ' + flag);\n220:       }\n221:     }\n222:   }\n223:   assert.deepEqual(unsupported, [], 'engine invocations outside the CLI contract');\n224: });\n225: \n226: test('the router follows the six-section router template and keeps presentation out of line', () => {\n227:   const headings = [...ROUTER.matchAll(/^## \\d+\\. ([A-Z ]+)$/gmu)].map((match) => match[1]);\n228:   assert.deepEqual(headings, [\n229:     'ROUTER CONTRACT',\n230:     'OWNED ASSETS',\n231:     'MODE ROUTING',\n232:     'EXECUTION TARGETS',\n233:     'PRESENTATION BOUNDARY',\n234:     'WORKFLOW SUMMARY',\n235:   ]);\n236:   assert.equal(ROUTER.includes(TICK.repeat(3)), false);\n237:   assert.doesNotMatch(ROUTER, /STATUS=/u);\n238: });\n239: \n240: test('the router frontmatter stays within budget and grants only the tools it uses', () => {\n241:   const description = ROUTER.match(/^description:\\s*\"(.*)\"$/mu)?.[1];\n242:   assert.ok(description);\n243:   assert.ok(description.length <= 110, 'description is ' + description.length + ' chars');\n244:   assert.doesNotMatch(description, /[<>]/u);\n245: \n246:   const hint = ROUTER.match(/^argument-hint:\\s*\"(.*)\"$/mu)?.[1];\n247:   assert.ok(hint);\n248:   assert.ok(hint.length <= 140, 'argument-hint is ' + hint.length + ' chars');\n249:   for (const token of [\n250:     '[check|link|unlink]',\n251:     '[--root <dir>]',\n252:     '[--runtimes <list>]',\n253:     '[--mode <shape>]',\n254:     '[--plan-digest <digest>]',\n255:     '[--run <dir>]',\n256:     '[--yes]',\n257:   ]) {\n258:     assert.ok(hint.includes(token), token);\n259:   }\n260: \n261:   const tools = ROUTER.match(/^allowed-tools:\\s*(.+)$/mu)[1].split(',').map((tool) => tool.trim());\n262:   assert.deepEqual(tools, ['Read', 'Bash']);\n263:   assert.equal(ROUTER.split('<!-- skill_agent: system-skilled-doctor -->').length - 1, 1);\n264: });\n265: \n266: test('the router binds each target to the workflow asset its route names', () => {\n267:   for (const route of ROUTES) {\n268:     const row = '| ' + TICK + route.target + TICK + ' | ' + TICK\n269:       + '.skilled/commands/doctor/assets/' + route.yaml + TICK + ' |';\n270:     assert.ok(ROUTER.includes(row), route.target);\n271:   }\n272: });\n273: \n274: test('the router names the engine and manifest as owned assets and composes no link itself', () => {\n275:   const owned = ROUTER.split('## 2. OWNED ASSETS')[1].split('## 3.')[0];\n276:   assert.ok(owned.includes(ENGINE_PATH), ENGINE_PATH);\n277:   assert.ok(owned.includes(MANIFEST_PATH), MANIFEST_PATH);\n278:   assert.ok(owned.includes('doctor-symlink-presentation.txt'));\n279:   assert.match(ROUTER, /Do not compose a link, remove one or hash a plan/u);\n280: });\n281: \n282: test('the router resolves the bare command to check and keeps every write behind digest and yes', () => {\n283:   assert.match(ROUTER, /default_target/u);\n284:   assert.match(ROUTER, /A bare .*never reaches .*which write/u);\n285:   assert.match(ROUTER, /never runs .*apply.*without the digest its own plan printed/u);\n286:   assert.match(ROUTER, /never runs a writing target without its yes/u);\n287: });\n288: \n289: test('the router workflow summary runs plan, digest, question, apply and re-read in order', () => {\n290:   const summary = ROUTER.split('## 6. WORKFLOW SUMMARY')[1];\n291:   const steps = summary.split('\\n')\n292:     .map((line) => line.trim())\n293:     .filter((line) => /^\\d+\\. /u.test(line));\n294:   const at = (pattern) => {\n295:     const index = steps.findIndex((step) => pattern.test(step));\n296:     assert.ok(index >= 0, 'no step names ' + pattern);\n297:     return index;\n298:   };\n299: \n300:   const plan = at(/symlink-engine\\.cjs plan/u);\n301:   const digest = at(/plan digest/u);\n302:   const question = at(/asks the link question/u);\n303:   const apply = at(/symlink-engine\\.cjs apply --plan-digest/u);\n304:   const reread = at(/post-apply check summary/u);\n305:   assert.ok(plan < digest, 'the plan prints before its digest is offered');\n306:   assert.ok(digest < question, 'the digest is named before the question');\n307:   assert.ok(question < apply, 'apply follows the link question');\n308:   assert.ok(apply < reread, 'the re-read follows apply');\n309:   assert.match(steps.join('\\n'), /ends the run as cancelled/u);\n310:   assert.match(steps.join('\\n'), /nothing is written/u);\n311:   assert.match(steps.join('\\n'), /unlink/u);\n312: });\n313: \n314: test('the presentation carries the menu, accepted answers and route manifest rows', () => {\n315:   assert.match(PRESENTATION, /^## 1\\. Argument Failure$/mu);\n316:   assert.match(PRESENTATION, /^1\\) check$/mu);\n317:   assert.match(PRESENTATION, /^2\\) link$/mu);\n318:   assert.match(PRESENTATION, /^3\\) unlink$/mu);\n319:   for (const row of [\n320:     '| ' + TICK + '1' + TICK + ' | target = ' + TICK + 'check' + TICK + ' |',\n321:     '| ' + TICK + '2' + TICK + ' | target = ' + TICK + 'link' + TICK + ' |',\n322:     '| ' + TICK + '3' + TICK + ' | target = ' + TICK + 'unlink' + TICK + ' |',\n323:   ]) {\n324:     assert.ok(PRESENTATION.includes(row), row);\n325:   }\n326:   assert.match(PRESENTATION, /^Valid targets: check, link, unlink$/mu);\n327:   for (const [target, workflow, mutation] of [\n328:     ['check', 'doctor-symlink-check.yaml', 'read-only'],\n329:     ['link', 'doctor-symlink-link.yaml', 'mutates'],\n330:     ['unlink', 'doctor-symlink-unlink.yaml', 'mutates'],\n331:   ]) {\n332:     const row = '| ' + TICK + target + TICK + ' | ' + TICK + workflow + TICK + ' | ' + mutation + ' |';\n333:     assert.ok(PRESENTATION.includes(row), target);\n334:   }\n335: });\n336: \n337: test('the argument table defines a missing value and second positional for every target', () => {\n338:   const table = PRESENTATION.split('## 1. Argument Failure')[1].split(/\\n## 2\\./u)[0];\n339:   const rows = table.split('\\n').filter((line) => line.startsWith('| '));\n340:   const missing = rows.find((line) => /value flag given without its value/u.test(line));\n341:   assert.ok(missing, 'no row for a value flag given without its value');\n342:   for (const flag of ['--root', '--runtimes', '--mode', '--include', '--ignore', '--plan-digest', '--run']) {\n343:     assert.ok(missing.includes(flag), flag + ' is not named');\n344:   }\n345:   assert.match(missing, /STATUS=FAIL ERROR=\"missing_argument\"/u);\n346:   assert.match(missing, /Try: /u);\n347: \n348:   const second = rows.find((line) => /second positional/u.test(line));\n349:   assert.ok(second, 'no row for a second positional');\n350:   assert.match(second, /\\/doctor:symlink check \\[--json\\] \\[--root <dir>\\]/u);\n351:   assert.match(second, /\\/doctor:symlink link \\[--dry-run\\]/u);\n352:   assert.match(second, /\\/doctor:symlink unlink --run <dir>/u);\n353:   assert.match(second, /STATUS=FAIL ERROR=\"too_many_arguments\"/u);\n354:   assert.match(ROUTER, /a value flag without its value/u);\n355:   assert.match(ROUTER, /a second positional/u);\n356: });\n357: \n358: test('the check presentation carries status, JSON and result fields', () => {\n359:   for (const status of [\n360:     'linked-whole',\n361:     'linked-merge',\n362:     'partial-merge',\n363:     'missing',\n364:     'broken',\n365:     'foreign-link',\n366:     'local',\n367:     'source-missing',\n368:   ]) {\n369:     assert.ok(PRESENTATION.includes(status), status);\n370:   }\n371:   assert.match(PRESENTATION, /^Skilled link check: \\[the root the engine read\\]$/mu);\n372:   assert.match(PRESENTATION, /^DOCTOR DIAGNOSTIC RESULT$/mu);\n373:   const statusTemplates = PRESENTATION.split(/\\r?\\n/u).filter((line) => /^STATUS=\\[/u.test(line));\n374:   assert.ok(statusTemplates.length > 0, 'presentation has a STATUS template');\n375:   assert.deepEqual(statusTemplates, statusTemplates.map(() => 'STATUS=[OK|WARN|FAIL]'));\n376:   assert.match(PRESENTATION, /^Status: \\[OK\\|WARN\\|FAIL\\]$/mu);\n377:   assert.match(PRESENTATION, /`Status` is `OK` when the engine exits 0, `WARN` when it exits 1 and `FAIL` when it exits 2/u);\n378:   assert.doesNotMatch(PRESENTATION, /FINDINGS/u);\n379:   assert.match(PRESENTATION, /print the engine's JSON and nothing else/u);\n380:   assert.match(PRESENTATION, /^Plan digest: \\[the engine's plan-digest line\\]$/mu);\n381:   assert.match(PRESENTATION, /Link the Skilled checkout into this repository now\\? \\[yes\\/no\\]\\n?$/u);\n382:   assert.match(PRESENTATION, /the digest on screen is the digest the apply repeats/u);\n383:   assert.match(PRESENTATION, /never compose a plan digest/u);\n384: });\n385: \n386: test('the presentation closes on cancelled, dry-run and failure results', () => {\n387:   assert.match(PRESENTATION, /^STATUS=CANCELLED ACTION=cancelled$/mu);\n388:   assert.match(PRESENTATION, /^Changed: none$/mu);\n389:   assert.match(PRESENTATION, /^Dry run: nothing was written and nothing was asked\\.$/mu);\n390:   assert.match(PRESENTATION, /^STATUS=FAIL ERROR=\"\\[code\\]\"$/mu);\n391:   assert.match(PRESENTATION, /End interactive presentations with:.*What would you like to do next/u);\n392:   assert.equal(PRESENTATION.split('STATUS=CANCELLED ACTION=cancelled').length - 1, 2);\n393: });\n394: \n395: // ─────────────────────────────────────────────────────────────────────────────\n396: // 4. THE CHECK WORKFLOW\n397: // ─────────────────────────────────────────────────────────────────────────────\n398: \n399: test('the check workflow is read-only and runs only the check engine', () => {\n400:   assert.equal(CHECK_WORKFLOW.operating_mode.execution, 'read_only');\n401:   assert.equal(CHECK_WORKFLOW.mutation_boundaries.read_only, true);\n402:   assert.deepEqual(CHECK_WORKFLOW.mutation_boundaries.allowed_targets, []);\n403:   assert.ok(CHECK_YAML.includes(ENGINE_PATH), ENGINE_PATH);\n404:   assert.match(CHECK_WORKFLOW.mutation_boundaries.invariant, /check subcommand only/u);\n405:   assert.doesNotMatch(CHECK_YAML, /symlink-engine\\.cjs (?:plan|apply|unlink)/u);\n406: });\n407: \n408: test('the check workflow declares every variable the route resolves', () => {\n409:   for (const key of routeFor('check').setup_vars) {\n410:     assert.ok(key in CHECK_WORKFLOW.inputs, 'inputs.' + key + ' is missing');\n411:   }\n412: });\n413: \n414: test('the check workflow forwards optional flags only when requested', () => {\n415:   assert.match(CHECK_WORKFLOW.inputs.json_output, /pass --json/u);\n416:   assert.match(CHECK_YAML, /--json when requested/u);\n417:   assert.match(CHECK_WORKFLOW.inputs.root, /--root <dir>/u);\n418:   assert.match(CHECK_WORKFLOW.inputs.runtimes, /--runtimes/u);\n419:   assert.match(CHECK_WORKFLOW.inputs.include, /--include/u);\n420:   assert.match(CHECK_WORKFLOW.inputs.link_instructions, /--link-instructions/u);\n421:   assert.match(CHECK_YAML, /check --root \"\\{root\\}\"/u);\n422: });\n423: \n424: test('the check workflow maps the engine exit classes to the route status', () => {\n425:   assert.match(CHECK_WORKFLOW.output, /STATUS=OK/u);\n426:   assert.match(CHECK_WORKFLOW.output, /STATUS=WARN/u);\n427:   assert.match(CHECK_WORKFLOW.output, /STATUS=FAIL/u);\n428:   assert.match(CHECK_YAML, /Exit 0 means no drift/u);\n429:   assert.match(CHECK_YAML, /Exit 1 means drift was found/u);\n430:   assert.match(CHECK_YAML, /Exit 2 means the invocation/u);\n431:   assert.match(CHECK_WORKFLOW.output, /engine exits 2/u);\n432: });\n433: \n434: // ─────────────────────────────────────────────────────────────────────────────\n435: // 5. THE LINK AND UNLINK WORKFLOWS\n436: // ─────────────────────────────────────────────────────────────────────────────\n437: \n438: test('the link workflow is interactive, digest-gated and never commits', () => {\n439:   assert.equal(LINK_WORKFLOW.operating_mode.execution, 'interactive');\n440:   assert.equal(LINK_WORKFLOW.operating_mode.approvals, 'explicit_yes');\n441:   assert.equal(LINK_WORKFLOW.operating_mode.planning, 'show_plan_and_digest_before_question');\n442:   assert.equal(LINK_WORKFLOW.operating_mode.tracking, 'one_plan_digest');\n443:   assert.equal(LINK_WORKFLOW.operating_mode.never_commit, true);\n444:   assert.deepEqual(LINK_WORKFLOW.output.statuses, ['OK', 'CANCELLED', 'FAIL']);\n445:   assert.equal(LINK_WORKFLOW.output.presentation, '.skilled/commands/doctor/assets/doctor-symlink-presentation.txt');\n446:   assert.equal(LINK_WORKFLOW.mutation_boundaries.read_only, false);\n447: \n448:   const allowed = LINK_WORKFLOW.mutation_boundaries.allowed_targets.join('\\n');\n449:   assert.match(allowed, /Only link paths and directories listed by the plan/u);\n450:   assert.match(allowed, /\\.git\\/info\\/exclude or \\.gitignore/u);\n451:   assert.match(allowed, /doctor-symlink\\/<first 16 hex characters/u);\n452:   const forbidden = LINK_WORKFLOW.mutation_boundaries.forbidden_targets.join('\\n');\n453:   assert.match(forbidden, /Any path that the plan does not list/u);\n454:   assert.match(forbidden, /git index, history and remotes/u);\n455:   assert.match(LINK_WORKFLOW.mutation_boundaries.invariant, /digest differs/u);\n456: });\n457: \n458: test('the link workflow runs read, plan, approval, apply and report in order', () => {\n459:   assert.deepEqual(LINK_PHASES, [\n460:     'phase_1_read',\n461:     'phase_2_plan',\n462:     'phase_3_approval',\n463:     'phase_4_apply',\n464:     'phase_5_report',\n465:   ]);\n466: \n467:   const plan = phaseText(LINK_WORKFLOW, 'phase_2_plan');\n468:   assert.match(plan, /symlink-engine\\.cjs plan/u);\n469:   assert.doesNotMatch(plan, /--plan-digest/u);\n470:   assert.match(plan, /plan digest/iu);\n471: \n472:   const approval = phaseText(LINK_WORKFLOW, 'phase_3_approval');\n473:   assert.match(approval, /Ask the one link question/u);\n474:   assert.match(approval, /Any answer other than yes is a no/u);\n475:   assert.match(approval, /STATUS=CANCELLED ACTION=cancelled/u);\n476:   assert.match(approval, /Do not run apply/u);\n477: \n478:   const apply = phaseText(LINK_WORKFLOW, 'phase_4_apply');\n479:   assert.match(apply, /symlink-engine\\.cjs apply --root/u);\n480:   assert.match(apply, /--plan-digest/u);\n481:   assert.match(apply, /only after the operator approves/u);\n482:   assert.match(apply, /same optional flags/u);\n483:   assert.match(apply, /undo command/u);\n484: });\n485: \n486: test('the link workflow declares every variable the route resolves', () => {\n487:   const missing = routeFor('link').setup_vars.filter((key) => !(key in LINK_WORKFLOW.inputs));\n488:   assert.deepEqual(missing, [], 'link workflow inputs missing route variables');\n489: });\n490: \n491: test('the link workflow handles its route dry-run flag before approval or apply', () => {\n492:   assert.ok('dry_run' in LINK_WORKFLOW.inputs, 'inputs.dry_run is missing');\n493:   assert.match(phaseText(LINK_WORKFLOW, 'phase_2_plan'), /dry_run/u);\n494:   assert.match(phaseText(LINK_WORKFLOW, 'phase_2_plan'), /writes nothing/u);\n495: });\n496: \n497: test('the unlink workflow is interactive and changes only recorded paths', () => {\n498:   assert.equal(UNLINK_WORKFLOW.operating_mode.execution, 'interactive');\n499:   assert.equal(UNLINK_WORKFLOW.operating_mode.approvals, 'explicit_yes');\n500:   assert.equal(UNLINK_WORKFLOW.operating_mode.never_commit, true);\n501:   assert.deepEqual(UNLINK_WORKFLOW.output.statuses, ['OK', 'CANCELLED', 'FAIL']);\n502:   assert.equal(UNLINK_WORKFLOW.output.presentation, '.skilled/commands/doctor/assets/doctor-symlink-presentation.txt');\n503:   assert.equal(UNLINK_WORKFLOW.mutation_boundaries.read_only, false);\n504: \n505:   const allowed = UNLINK_WORKFLOW.mutation_boundaries.allowed_targets.join('\\n');\n506:   assert.match(allowed, /Only paths listed in the run manifest/u);\n507:   assert.match(allowed, /Only directories listed in created_dirs/u);\n508:   assert.match(allowed, /Only the exact lines listed in ignore_added/u);\n509:   const forbidden = UNLINK_WORKFLOW.mutation_boundaries.forbidden_targets.join('\\n');\n510:   assert.match(forbidden, /Any path not listed in the run manifest/u);\n511:   assert.match(forbidden, /run directory, its manifest and its copies/u);\n512:   assert.match(forbidden, /git index, history and remotes/u);\n513: });\n514: \n515: test('the unlink workflow shows the dry-run plan, asks once and writes only after yes', () => {\n516:   assert.deepEqual(UNLINK_PHASES, [\n517:     'phase_1_read',\n518:     'phase_2_plan',\n519:     'phase_3_approval',\n520:     'phase_4_unlink',\n521:     'phase_5_report',\n522:   ]);\n523: \n524:   const plan = phaseText(UNLINK_WORKFLOW, 'phase_2_plan');\n525:   assert.match(plan, /symlink-engine\\.cjs unlink --run .*--dry-run/u);\n526:   assert.doesNotMatch(plan, /--yes/u);\n527:   assert.match(plan, /dry-run writes nothing/u);\n528: \n529:   const approval = phaseText(UNLINK_WORKFLOW, 'phase_3_approval');\n530:   assert.match(approval, /Ask the one unlink question/u);\n531:   assert.match(approval, /Any answer other than yes is a no/u);\n532:   assert.match(approval, /Do not run unlink with --yes/u);\n533: \n534:   const write = phaseText(UNLINK_WORKFLOW, 'phase_4_unlink');\n535:   assert.match(write, /symlink-engine\\.cjs unlink --run .*--yes/u);\n536:   assert.match(write, /only after the unlink yes/u);\n537:   assert.match(write, /changed since apply/u);\n538:   assert.match(write, /keeps the run directory/u);\n539: });\n540: \n541: test('the unlink workflow declares every variable the route resolves', () => {\n542:   const missing = routeFor('unlink').setup_vars.filter((key) => !(key in UNLINK_WORKFLOW.inputs));\n543:   assert.deepEqual(missing, [], 'unlink workflow inputs missing route variables');\n544: });\n545: \n546: test('the unlink workflow lets an explicit dry run end before its approval question', () => {\n547:   assert.ok('dry_run' in UNLINK_WORKFLOW.inputs, 'inputs.dry_run is missing');\n548:   assert.match(phaseText(UNLINK_WORKFLOW, 'phase_2_plan'), /dry_run/u);\n549:   assert.match(phaseText(UNLINK_WORKFLOW, 'phase_2_plan'), /end the run without asking/u);\n550: });\n551: \n552: test('the doctor family contract carries every schema-required field and no unknown field', () => {\n553:   for (const key of FAMILY_SCHEMA.required) {\n554:     assert.ok(key in DOCTOR_CONTRACT, 'families.doctor is missing ' + key);\n555:   }\n556:   const known = new Set(Object.keys(FAMILY_SCHEMA.properties));\n557:   assert.deepEqual(\n558:     Object.keys(DOCTOR_CONTRACT).filter((key) => !known.has(key)),\n559:     [],\n560:     'the schema forbids an additional property',\n561:   );\n562:   assert.ok(FAMILY_SCHEMA.properties.topology.enum.includes(DOCTOR_CONTRACT.topology));\n563: });\n564: \n565: test('the doctor family contract names the symlink router and generic route assets', () => {\n566:   assert.ok(DOCTOR_CONTRACT.router_path.includes('.skilled/commands/doctor/symlink.md'));\n567:   const routeTarget = DOCTOR_CONTRACT.execution_targets.find((entry) => /symlink/u.test(entry.selector));\n568:   assert.ok(routeTarget, 'the family contract has no symlink route selector');\n569:   assert.match(routeTarget.target, /<the route's yaml>, named per route in _routes\\.yaml/u);\n570:   assert.ok(DOCTOR_CONTRACT.owned_assets.some((entry) => (\n571:     entry.purpose === 'route_manifest' && entry.path === '.skilled/commands/doctor/_routes.yaml'\n572:   )));\n573:   assert.ok(DOCTOR_CONTRACT.owned_assets.some((entry) => (\n574:     entry.purpose === 'presentation' && entry.path.endsWith('doctor-<entry>-presentation.txt')\n575:   )));\n576:   assert.ok(DOCTOR_CONTRACT.owned_assets.some((entry) => entry.path.includes('doctor-<target>.yaml')));\n577:   assert.equal(DOCTOR_CONTRACT.presentation.owner, 'presentation-asset');\n578: \n579:   const hint = ROUTER.match(/^argument-hint:\\s*\"(.*)\"$/mu)[1];\n580:   assert.ok(DOCTOR_CONTRACT.input.argument_hint.includes(hint + ' (symlink)'));\n581: });\n582: \n583: test('the doctor family contract owns the symlink engine and entry manifest', () => {\n584:   for (const asset of [ENGINE_PATH, MANIFEST_PATH]) {\n585:     assert.ok(\n586:       DOCTOR_CONTRACT.owned_assets.some((entry) => entry.path.includes(asset)),\n587:       asset,\n588:     );\n589:   }\n590: });\n591: \n592: test('the doctor family loader requirements preserve the symlink route contract', () => {\n593:   const lines = DOCTOR_CONTRACT.loader_requirements.filter((line) => line.includes('/doctor:symlink'));\n594:   assert.ok(lines.length > 0, 'the family contract has no symlink loader requirement');\n595:   const text = lines.join('\\n');\n596:   assert.match(text, /check is the read-only default target/u);\n597:   assert.match(text, /plan digest/u);\n598:   assert.match(text, /unlink/u);\n599:   assert.match(text, /STATUS=CANCELLED/u);\n600: });\n601: \n602: test('the doctor family destructive policy names the gated symlink writes', () => {\n603:   assert.equal(DOCTOR_CONTRACT.destructive_policy.has_destructive_ops, true);\n604:   assert.equal(DOCTOR_CONTRACT.destructive_policy.gated, true);\n605:   assert.ok(\n606:     DOCTOR_CONTRACT.destructive_policy.operations.some((line) => /symlink/u.test(line)),\n607:     'the family contract has no symlink write operation',\n608:   );\n609: });\n610: \n611: test('the doctor family invocation aliases include the symlink command form', () => {\n612:   const hint = ROUTER.match(/^argument-hint:\\s*\"(.*)\"$/mu)[1];\n613:   assert.ok(\n614:     DOCTOR_CONTRACT.invocation_aliases.some((alias) => (\n615:       alias.startsWith('/doctor:symlink ') && alias.includes(hint)\n616:     )),\n617:     'the family contract has no /doctor:symlink invocation alias',\n618:   );\n619: });"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/commands/doctor/scripts/tests/doctor-symlink-contract.test.cjs\"}"},"time":{"start":1794528141208,"end":1794528141250}}}}
