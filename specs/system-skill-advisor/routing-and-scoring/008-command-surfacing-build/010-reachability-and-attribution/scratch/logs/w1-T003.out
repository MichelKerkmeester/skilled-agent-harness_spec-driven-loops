trings-and-checklist.md\",\n345:     ],\n346:     \"RUST\": [\n347:         \"sk-code-skilled/references/rust/style-guide/overview-and-file-header.md\",\n348:         \"sk-code-skilled/references/rust/style-guide/toolchain-and-project-structure.md\",\n349:         \"sk-code-skilled/references/rust/style-guide/naming-conventions.md\",\n350:         \"sk-code-skilled/references/rust/style-guide/formatting-and-imports.md\",\n351:         \"sk-code-skilled/references/rust/style-guide/commenting-and-rustdoc.md\",\n352:         \"sk-code-skilled/references/rust/style-guide/interop-model.md\",\n353:         \"sk-code-skilled/references/rust/style-guide/interop-errors-and-parity.md\",\n354:         \"sk-code-skilled/references/rust/quality-standards/overview-and-data-ownership.md\",\n355:         \"sk-code-skilled/references/rust/quality-standards/modeling-collections-and-api.md\",\n356:         \"sk-code-skilled/references/rust/quality-standards/docs-errors-and-async.md\",\n357:         \"sk-code-skilled/references/rust/quality-standards/build-and-organization.md\",\n358:         \"sk-code-skilled/references/rust/quality-standards/determinism-and-parity.md\",\n359:         \"sk-code-skilled/references/rust/quick-reference/overview-and-boundary-template.md\",\n360:         \"sk-code-skilled/references/rust/quick-reference/naming-ordering-and-signatures.md\",\n361:         \"sk-code-skilled/references/rust/quick-reference/collections-imports-and-errors.md\",\n362:         \"sk-code-skilled/references/rust/quick-reference/rustdoc-and-cargo.md\",\n363:         \"sk-code-skilled/references/rust/quick-reference/determinism-parity-and-related.md\",\n364:     ],\n365:     \"CI_WORKFLOW\": [\n366:         \"sk-code-ci/references/ci-workflow-standards.md\",\n367:         \"sk-code-ci/references/trigger-and-filter-rules.md\",\n368:         \"sk-code-ci/references/job-shape-rules.md\",\n369:         \"sk-code-ci/references/protected-set.md\",\n370:     ],\n371:     \"FRONTEND_WEB\": [\n372:         \"sk-code-frontend/references/frontend-practice.md\",\n373:         \"sk-code-frontend/references/web-markup-and-css.md\",\n374:     ],\n375:     \"WEB_ELEMENTS\": [\n376:         \"sk-code-frontend/references/frontend-practice.md\",\n377:         \"sk-code-frontend/references/web-markup-and-css.md\",\n378:         \"sk-code-frontend/references/web-elements-and-attributes.md\",\n379:     ],\n380:     \"WEB_CASCADE\": [\n381:         \"sk-code-frontend/references/frontend-practice.md\",\n382:         \"sk-code-frontend/references/web-markup-and-css.md\",\n383:         \"sk-code-frontend/references/web-cascade-and-selectors.md\",\n384:     ],\n385:     \"WEB_LAYOUT\": [\n386:         \"sk-code-frontend/references/frontend-practice.md\",\n387:         \"sk-code-frontend/references/web-markup-and-css.md\",\n388:         \"sk-code-frontend/references/web-layout-and-sizing.md\",\n389:     ],\n390:     \"WEB_A11Y\": [\n391:         \"sk-code-frontend/references/frontend-practice.md\",\n392:         \"sk-code-frontend/references/web-markup-and-css.md\",\n393:         \"sk-code-frontend/references/web-accessibility-patterns.md\",\n394:     ],\n395:     \"WEB_PERF\": [\n396:         \"sk-code-frontend/references/frontend-practice.md\",\n397:         \"sk-code-frontend/references/web-markup-and-css.md\",\n398:         \"sk-code-frontend/references/web-performance-and-loading.md\",\n399:     ],\n400:     \"WEB_I18N\": [\n401:         \"sk-code-frontend/references/frontend-practice.md\",\n402:         \"sk-code-frontend/references/web-markup-and-css.md\",\n403:         \"sk-code-frontend/references/web-internationalization.md\",\n404:     ],\n405:     \"WEB_VISUAL_VALUES\": [\n406:         \"sk-code-frontend/references/frontend-practice.md\",\n407:         \"sk-code-frontend/references/web-visual-values.md\",\n408:     ],\n409:     \"WEB_VISUAL_HIERARCHY\": [\n410:         \"sk-code-frontend/references/frontend-practice.md\",\n411:         \"sk-code-frontend/references/web-visual-hierarchy.md\",\n412:         \"sk-code-frontend/references/web-visual-values.md\",\n413:         \"sk-code-frontend/references/web-accessibility-patterns.md\",\n414:     ],\n415:     \"WEB_MOTION\": [\n416:         \"sk-code-frontend/references/frontend-practice.md\",\n417:         \"sk-code-frontend/references/web-motion-and-interaction.md\",\n418:     ],\n419:     \"FIGMA_TO_CODE\": [\n420:         \"sk-code-frontend/references/figma-to-code.md\",\n421:         \"sk-code-frontend/references/frontend-practice.md\",\n422:     ],\n423: }\n424: \n425: # Hub-level shared controls, declared once here. This list holds every\n426: # contained shared/ path that RESOURCE_MAP references but that is exempt from\n427: # typed-leaf projection, because it has no single packet owner. The root-router\n428: # contract validates each entry and requires RESOURCE_MAP to reference it.\n429: # DEFAULT_RESOURCE above is the other half of the set: its always-loaded\n430: # preamble paths are hub-level controls too. No other shared/ path is a\n431: # control, so a guard that needs the control set reads these two lists.\n432: SHARED_CONTROL_RESOURCES = [\n433:     \"shared/references/universal/code-quality-standards.md\",\n434:     \"shared/references/universal/rule-overrides.md\",\n435:     \"shared/references/workflow-debug.md\",\n436:     \"shared/references/workflow-verify.md\",\n437: ]\n438: ```\n439: \n440: ### Surface-aware loading (route-time)\n441: \n442: The router does NOT load the whole matched-intent union. After surface detection (§1, `stack-detection.md`), a route loads:\n443: \n444: - the always-loaded `DEFAULT_RESOURCE` preamble (stack/phase detection and the universal quality baseline), plus\n445: - the `shared/` entries the matched intents map (for example `code-quality-standards.md` under CODE_QUALITY, `workflow-debug.md` under DEBUGGING and `workflow-verify.md` under VERIFICATION), never the whole `shared/references/universal/` folder, plus\n446: - only the **detected surface's** slice (`<surface>/references/*`) for the matched intents.\n447: \n448: - It does not load another surface's resources.\n449: - It defers `assets/*` (checklists, recipes, templates) to on-demand rather than the first slice.\n450: - Within SKILLED it slices once more by the **detected language** (§1 sub-detection): a TypeScript task loads `sk-code-skilled/references/typescript/*` plus the language-agnostic `sk-code-skilled/references/shared/*`, not the Python, shell, config, or JavaScript folders.\n451: - An `UNKNOWN` surface falls back to the preamble plus the shared-tier entries its matched intents map.\n452: \n453: This is what stops a routine single-surface task from pulling the full cross-surface set. The deterministic router-replay enforces the same rule, so the benchmark measures it.\n454: \n455: ---\n456: \n457: ## 9. HOW TO READ THIS\n458: \n459: - Every code task first loads the always-on preamble (stack + phase detection and the universal quality baseline); routing then narrows to the detected surface's slice for the matched intents.\n460: - One dominant intent on one surface loads that surface's slice; two near-tied intents (within the router's ambiguity delta) load both intent sets, deduped by canonical pair.\n461: - A single-surface task never pulls another surface's resources.\n462: - No keyword match, or an `UNKNOWN` surface, falls back to the preamble plus the shared-tier entries its matched intents map — confirm the surface and intent before loading more. See §6 (UNKNOWN FALLBACK) and §7 (LOADING DISCIPLINE) for the full rules.\n463: \n464: ---\n465: \n466: ## 10. RELATED RESOURCES\n467: \n468: - [`stack-detection.md`](shared/references/stack-detection.md): surface detection (a declared specific surface, then the SKILLED fallback, then UNKNOWN) + SKILLED language sub-detection\n469: - [`phase-detection.md`](shared/references/phase-detection.md) — Phase 1/2/3 lifecycle and per-phase resource loading\n470: - `SKILL.md` §2 SMART ROUTING — names the routing authority split and the compiled front door\n471: - Barter equivalent: `barter/.skilled/skills/sk-code/shared/references/smart-routing.md` (different routing key — git-remote project — but same structural pattern)\n472: \n473: ---\n474: \n475: ## 11. MACHINE ROUTER\n476: \n477: The hub's detailed routing prose, moved here from `SKILL.md` so the skill body keeps only a short routing summary and a pointer to this file. It sits last, after the stage-two map above, and it declares no map of its own: the `INTENT_SIGNALS` and `RESOURCE_MAP` block in section 8 stays the only replay source.\n478: \n479: > **Compiled routing (default-on, flag-gated, additive).** Resolve the mode via the compiled router contract first:\n480: > ```bash\n481: > node .skilled/bin/compiled-route.cjs --hub sk-code --prompt \"<task>\"\n482: > ```\n483: > Follow the returned decision: `route` (use its `targets`), `clarify`/`defer` (disambiguate) or `reject` (refuse). On a `{\"servingAuthority\":\"legacy\"}` sentinel or any error, use the routing below. The front door self-gates on serving-authority. Compiled routing is now the default for `sk-code`. Set `SPECKIT_COMPILED_ROUTING=0`, the explicit kill-switch, to force legacy routing fleet-wide.\n484: \n485: **Session surface hint.** Before you call the front door, run the surface detection in [`stack-detection.md`](shared/references/stack-detection.md) on the session's working directory and the files it is editing.\n486: Then add its result as `--surface-hint <SURFACE>`, for example `--surface-hint SKILLED`.\n487: When the prompt's keywords tie between surfaces, a hinted specific surface leads them.\n488: Workflow modes keep first place, and the targets and the bundle kind stay the same.\n489: `SKILLED` is the fallback surface and always ranks last, so a `SKILLED` hint changes nothing.\n490: With `UNKNOWN`, no hint or a surface the prompt did not match, the `routerPolicy.tieBreak` order applies.\n491: \n492: ### Surface Router: per-intent leaf sets\n493: \n494: Root `ROUTER.md` owns the second-stage `INTENT_SIGNALS` / `RESOURCE_MAP`, while packet-owned resources stay typed through `leaf-manifest.json`.\n495: The hub-level shared controls are declared once, in `ROUTER.md` §8: the `SHARED_CONTROL_RESOURCES` list plus the always-loaded `DEFAULT_RESOURCE` preamble. They resolve on disk but never project as leaves.\n496: The hub router keeps stage-one mode selection and its `shared/README.md` fallback.\n497: \n498: ### The discriminator\n499: - **`workflowMode`** - the public mode/packet key: `sk-code-quality`, `sk-code-review` (workflow) or `sk-code-ci`, `sk-code-frontend`, `sk-code-skilled` (surface).\n500: - **`packetKind`** - the axis: `workflow` (a mode that acts) or `surface` (read-only evidence bundled alongside a mode).\n501: - **`backendKind`** - which backend runs the packet: `surface-router` or `review-cache` for workflow modes, `evidence-base` for surface packets.\n502: \n503: Surface packets are advisor-invisible (`routingClass: metadata`, read-only `toolSurface`).\n504: The advisor still routes the single identity `sk-code`, and the hub bundles zero-or-more surfaces as evidence via `routerPolicy.outcomes.surfaceBundle`.\n505: The workflow mode comes first, followed by surfaces.\n506: \"review my typescript module for jank\" → `[sk-code-review, sk-code-skilled]`.\n507: Bundled surfaces follow the `routerPolicy.tieBreak` order. It ranks `sk-code-frontend` ahead of `sk-code-ci`, then `sk-code-skilled` last, because a new surface goes ahead of the existing ones and the SKILLED fallback stays last.\n508: \n509: ### Surface detection\n510: \n511: Surface detection lives once in the hub's `shared/` layer and every mode and surface consumes it.\n512: It tries every declared specific surface first, then the `SKILLED` fallback, then `UNKNOWN`.\n513: When a specific surface and `SKILLED` both match, the specific one leads and `SKILLED` comes along as second evidence.\n514: Each surface declares its markers in a `surfaceDetection` block in `mode-registry.json`, or in its own `graph-metadata.json` when it lives outside the hub.\n515: Modes own workflow contracts, not surface identity.\n516: `sk-code-ci` and `sk-code-frontend` are the surfaces that stack detection does not select. The hub bundles both from request vocabulary alone: CI through `code-ci-aliases` and `code-ci-runtime`, and Frontend through `code-frontend-aliases` in `hub-router.json`.\n517: \n518: ### Fallback route\n519: \n520: When no workflow mode dominates (a bare implement/debug/verify request), the router defers to a pure surface bundle: it detects the surface, loads that surface's evidence and workflow doctrine, and the agent acts. `routerPolicy.defaultMode` is `null`, so the hub does not force a stale default. An unclear code intent asks for disambiguation.\n521: \n522: Per-mode behavior is **not flattened**: each packet keeps its own code-work contract, standards, evidence rules, and tool-permission guards.\n523: \n524: ### Routing rule\n525: ```python\n526: from pathlib import Path\n527: \n528: SKILL_ROOT = Path(__file__).resolve().parent\n529: UNKNOWN_FALLBACK_CHECKLIST = [\n530:     \"Confirm whether this is sk-code-quality, sk-code-review, sk-code-ci, sk-code-frontend or sk-code-skilled work\",\n531:     \"Confirm the target files or runtime surface\",\n532:     \"Confirm the expected action: implement, debug, verify, quality gate, or review\",\n533:     \"Confirm the verification command set before completion\",\n534: ]\n535: \n536: def _guard_in_skill(relative_path: str) -> str:\n537:     resolved = (SKILL_ROOT / relative_path).resolve()\n538:     resolved.relative_to(SKILL_ROOT)\n539:     if resolved.name != \"SKILL.md\" and resolved.suffix.lower() != \".md\":\n540:         raise ValueError(f\"Only markdown skill resources are routable: {relative_path}\")\n541:     return resolved.relative_to(SKILL_ROOT).as_posix()\n542: \n543: def load_if_available(relative_path: str, loaded: list[str], seen: set[str]) -> None:\n544:     guarded = _guard_in_skill(relative_path)\n545:     path = SKILL_ROOT / guarded\n546:     if path.exists() and guarded not in seen:\n547:         load(guarded)\n548:         loaded.append(guarded)\n549:         seen.add(guarded)\n550: \n551: def route(task):\n552:     loaded, seen = [], set()\n553:     registry = read_json(SKILL_ROOT / \"mode-registry.json\")\n554:     workflow_mode = explicit_mode_hint(task) or classify_workflow_mode(task)\n555: \n556:     if not workflow_mode:\n557:         load_if_available(\"shared/README.md\", loaded, seen)\n558:         return {\n559:             \"load_level\": \"UNKNOWN_FALLBACK\",\n560:             \"needs_disambiguation\": True,\n561:             \"disambiguation_checklist\": UNKNOWN_FALLBACK_CHECKLIST,\n562:             \"resources\": loaded,\n563:         }\n564: \n565:     entry = find_registry_entry(registry, workflowMode=workflow_mode)\n566:     if not entry:\n567:         load_if_available(\"shared/README.md\", loaded, seen)\n568:         return {\"load_level\": \"UNKNOWN_FALLBACK\", \"unknown_mode\": workflow_mode, \"resources\": loaded}\n569: \n570:     packet_skill = f\"{entry['packet']}/SKILL.md\"\n571:     load_if_available(packet_skill, loaded, seen)\n572: \n573:     for surface_mode in surface_bundle_from_hub_router(task):\n574:         surface_entry = find_registry_entry(registry, workflowMode=surface_mode)\n575:         if surface_entry:\n576:             load_if_available(f\"{surface_entry['packet']}/SKILL.md\", loaded, seen)\n577: \n578:     if not loaded:\n579:         load_if_available(\"shared/README.md\", loaded, seen)\n580:         return {\"load_level\": \"UNKNOWN_FALLBACK\", \"notice\": \"matched registry but no packet SKILL.md was available\", \"resources\": loaded}\n581: \n582:     return {\"workflowMode\": workflow_mode, \"backendKind\": entry[\"backendKind\"], \"resources\": loaded}\n583: ```"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/sk-code/ROUTER.md\"}"},"time":{"start":1794527290824,"end":1794527291690}}}}
{"type":"tool_use","timestamp":1794527291711,"sessionID":"ses_e2dd83e38ffeLH4Ot77Rgtkbk7","part":{"partID":"prt_1d229678b001j43OUXXuNxcKKF","sessionID":"ses_e2dd83e38ffeLH4Ot77Rgtkbk7","messageID":"msg_1d2294e07001E4qI6EZmrNHyXi","type":"tool","id":"call_e40f128068114923ad5b62cb","tool":"read","state":{"status":"completed","input":{"path":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-spec-kit/runtime/dist/hooks/claude/user-prompt-submit.js"},"output":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-spec-kit/runtime/dist/hooks/claude/user-prompt-submit.js, lines 1-191\n1: #!/usr/bin/env node\n2: // ───────────────────────────────────────────────────────────────────\n3: // MODULE: Claude User Prompt Submit Shim\n4: // ───────────────────────────────────────────────────────────────────\n5: // Thin process-boundary shim. The advisor implementation lives in\n6: // system-skill-advisor; this path stays for existing runtime settings.\n7: import { existsSync, statSync } from 'node:fs';\n8: import { spawnSync } from 'node:child_process';\n9: import { fileURLToPath } from 'node:url';\n10: import { dirname, isAbsolute, join } from 'node:path';\n11: // ───────────────────────────────────────────────────────────────────\n12: // 1. CONSTANTS\n13: // ───────────────────────────────────────────────────────────────────\n14: const TARGET_REL = 'skills/system-skill-advisor/runtime/dist/hooks/claude/user-prompt-submit.js';\n15: const MAX_STDIN_BYTES = 1024 * 1024;\n16: const MAX_STDIO_BYTES = 1024 * 1024;\n17: const CHILD_TIMEOUT_MS = 2500;\n18: // Reserve fallback time after advisor CLI; 300 ms covers measured startup overhead with headroom.\n19: const CHILD_START_MARGIN_MS = 300;\n20: // The host kills this hook after 3 seconds and the advisor child needs most of\n21: // that, so a host that never closes stdin must not hold the read for long. The\n22: // value matches SHORT_HOST_STDIN_TIMEOUT_MS in ../shared-stdin.ts, which this\n23: // file cannot import because its tests run the source directly.\n24: const STDIN_DEADLINE_MS = 500;\n25: const MAX_ROOT_WALK_DEPTH = 14;\n26: // ───────────────────────────────────────────────────────────────────\n27: // 2. TARGET RESOLUTION & SHIM DISPATCH\n28: // ───────────────────────────────────────────────────────────────────\n29: // Resolve the advisor target from this module's own location by walking up to\n30: // the nearest ancestor that owns one of the adapter roots (`.skilled` first,\n31: // then the legacy `.opencode` mirror). Claude may invoke the hook from any\n32: // working directory, so a CWD-relative path would silently miss the target and\n33: // fail open to `{}`; an install-anchored absolute path stays correct off-root.\n34: // An override names one executable module. It must be absolute, so a relative\n35: // path cannot be resolved against whatever cwd Claude happened to spawn the hook\n36: // with, and it must be a regular file, so a directory or a dangling link falls\n37: // back to the install-anchored walk instead of being handed to node.\n38: function isRegularFileOverride(candidate) {\n39:     if (!isAbsolute(candidate))\n40:         return false;\n41:     try {\n42:         return statSync(candidate).isFile();\n43:     }\n44:     catch {\n45:         return false;\n46:     }\n47: }\n48: function resolveTarget() {\n49:     // Test/install override: an explicit absolute target wins over the walk.\n50:     const override = process.env.SPECKIT_USER_PROMPT_TARGET;\n51:     if (override && isRegularFileOverride(override)) {\n52:         return override;\n53:     }\n54:     let current = dirname(fileURLToPath(import.meta.url));\n55:     for (let depth = 0; depth < MAX_ROOT_WALK_DEPTH; depth += 1) {\n56:         // Both root names must resolve identically: a checkout whose legacy mirror\n57:         // was dropped must not silently lose the advisor target, so the probe never\n58:         // assumes which root name owns it.\n59:         for (const rootName of ['.skilled', '.opencode']) {\n60:             const candidate = join(current, rootName, TARGET_REL);\n61:             if (existsSync(candidate)) {\n62:                 return candidate;\n63:             }\n64:         }\n65:         const parent = dirname(current);\n66:         if (parent === current) {\n67:             break;\n68:         }\n69:         current = parent;\n70:     }\n71:     return null;\n72: }\n73: function emitDiagnostic(code) {\n74:     process.stderr.write(`[speckit-hook:user-prompt-submit] ${code}\\n`);\n75: }\n76: // Collect stdin until it ends or the deadline passes, then release it so the\n77: // process can exit. More than MAX_STDIN_BYTES rejects with INPUT_OVERFLOW and\n78: // destroys stdin, so a runaway payload is never buffered whole.\n79: function readBoundedStdin() {\n80:     return new Promise((resolve, reject) => {\n81:         const stdin = process.stdin;\n82:         const chunks = [];\n83:         let totalBytes = 0;\n84:         let settled = false;\n85:         const release = () => {\n86:             clearTimeout(timer);\n87:             stdin.removeListener('data', onData);\n88:             stdin.removeListener('end', onEnd);\n89:             stdin.removeListener('error', onError);\n90:             stdin.pause();\n91:         };\n92:         function onEnd() {\n93:             if (settled)\n94:                 return;\n95:             settled = true;\n96:             release();\n97:             resolve(Buffer.concat(chunks, totalBytes));\n98:         }\n99:         function onError(error) {\n100:             if (settled)\n101:                 return;\n102:             settled = true;\n103:             release();\n104:             reject(error);\n105:         }\n106:         function onData(chunk) {\n107:             if (settled)\n108:                 return;\n109:             const buffer = Buffer.isBuffer(chunk) ? chunk : Buffer.from(chunk);\n110:             totalBytes += buffer.length;\n111:             if (totalBytes > MAX_STDIN_BYTES) {\n112:                 settled = true;\n113:                 release();\n114:                 stdin.destroy();\n115:                 reject(new Error('INPUT_OVERFLOW'));\n116:                 return;\n117:             }\n118:             chunks.push(buffer);\n119:         }\n120:         // Listeners go on before the timer, so a stdin that cannot take listeners\n121:         // rejects at once and leaves no timer behind.\n122:         stdin.on('data', onData);\n123:         stdin.on('end', onEnd);\n124:         stdin.on('error', onError);\n125:         const timer = setTimeout(onEnd, STDIN_DEADLINE_MS);\n126:     });\n127: }\n128: async function runShim() {\n129:     const target = resolveTarget();\n130:     if (!target) {\n131:         emitDiagnostic('TARGET_UNRESOLVED');\n132:         return '{}';\n133:     }\n134:     try {\n135:         const childEnv = { ...process.env };\n136:         // The advisor must finish before this shim kills it, or its fallback output is lost.\n137:         const childBudgetCeilingMs = CHILD_TIMEOUT_MS - CHILD_START_MARGIN_MS;\n138:         const operatorBudgetMs = Number.parseInt(process.env.SPECKIT_CLAUDE_HOOK_TIMEOUT_MS ?? '', 10);\n139:         childEnv.SPECKIT_CLAUDE_HOOK_TIMEOUT_MS = String(Number.isFinite(operatorBudgetMs) && operatorBudgetMs > 0\n140:             ? Math.min(operatorBudgetMs, childBudgetCeilingMs)\n141:             : childBudgetCeilingMs);\n142:         const input = await readBoundedStdin();\n143:         const result = spawnSync(process.execPath, [target, ...process.argv.slice(2)], {\n144:             cwd: process.cwd(),\n145:             input,\n146:             encoding: 'utf8',\n147:             env: childEnv,\n148:             timeout: CHILD_TIMEOUT_MS,\n149:             maxBuffer: MAX_STDIO_BYTES,\n150:             killSignal: 'SIGKILL',\n151:         });\n152:         if (result.error) {\n153:             const code = result.error.code;\n154:             emitDiagnostic(code === 'ETIMEDOUT' ? 'CHILD_TIMEOUT' : code === 'ENOBUFS' ? 'OUTPUT_OVERFLOW' : 'SPAWN_ERROR');\n155:             return '{}';\n156:         }\n157:         if (result.status !== 0) {\n158:             emitDiagnostic('NONZERO_EXIT');\n159:             return '{}';\n160:         }\n161:         const stdout = typeof result.stdout === 'string' ? result.stdout.trim() : '';\n162:         if (!stdout) {\n163:             emitDiagnostic('EMPTY_OUTPUT');\n164:             return '{}';\n165:         }\n166:         try {\n167:             JSON.parse(stdout);\n168:             return stdout;\n169:         }\n170:         catch {\n171:             emitDiagnostic('INVALID_JSON');\n172:             return '{}';\n173:         }\n174:     }\n175:     catch (error) {\n176:         emitDiagnostic(error instanceof Error && error.message === 'INPUT_OVERFLOW'\n177:             ? 'INPUT_OVERFLOW'\n178:             : 'STDIN_READ_ERROR');\n179:         return '{}';\n180:     }\n181: }\n182: // ───────────────────────────────────────────────────────────────────\n183: // 3. ENTRYPOINT\n184: // ───────────────────────────────────────────────────────────────────\n185: async function main() {\n186:     const advisorJson = await runShim();\n187:     process.stdout.write(`${advisorJson}\\n`);\n188:     process.exit(0);\n189: }\n190: void main();\n191: //# sourceMappingURL=user-prompt-submit.js.map","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-spec-kit/runtime/dist/hooks/claude/user-prompt-submit.js, lines 1-191\n1: #!/usr/bin/env node\n2: // ───────────────────────────────────────────────────────────────────\n3: // MODULE: Claude User Prompt Submit Shim\n4: // ───────────────────────────────────────────────────────────────────\n5: // Thin process-boundary shim. The advisor implementation lives in\n6: // system-skill-advisor; this path stays for existing runtime settings.\n7: import { existsSync, statSync } from 'node:fs';\n8: import { spawnSync } from 'node:child_process';\n9: import { fileURLToPath } from 'node:url';\n10: import { dirname, isAbsolute, join } from 'node:path';\n11: // ───────────────────────────────────────────────────────────────────\n12: // 1. CONSTANTS\n13: // ───────────────────────────────────────────────────────────────────\n14: const TARGET_REL = 'skills/system-skill-advisor/runtime/dist/hooks/claude/user-prompt-submit.js';\n15: const MAX_STDIN_BYTES = 1024 * 1024;\n16: const MAX_STDIO_BYTES = 1024 * 1024;\n17: const CHILD_TIMEOUT_MS = 2500;\n18: // Reserve fallback time after advisor CLI; 300 ms covers measured startup overhead with headroom.\n19: const CHILD_START_MARGIN_MS = 300;\n20: // The host kills this hook after 3 seconds and the advisor child needs most of\n21: // that, so a host that never closes stdin must not hold the read for long. The\n22: // value matches SHORT_HOST_STDIN_TIMEOUT_MS in ../shared-stdin.ts, which this\n23: // file cannot import because its tests run the source directly.\n24: const STDIN_DEADLINE_MS = 500;\n25: const MAX_ROOT_WALK_DEPTH = 14;\n26: // ───────────────────────────────────────────────────────────────────\n27: // 2. TARGET RESOLUTION & SHIM DISPATCH\n28: // ───────────────────────────────────────────────────────────────────\n29: // Resolve the advisor target from this module's own location by walking up to\n30: // the nearest ancestor that owns one of the adapter roots (`.skilled` first,\n31: // then the legacy `.opencode` mirror). Claude may invoke the hook from any\n32: // working directory, so a CWD-relative path would silently miss the target and\n33: // fail open to `{}`; an install-anchored absolute path stays correct off-root.\n34: // An override names one executable module. It must be absolute, so a relative\n35: // path cannot be resolved against whatever cwd Claude happened to spawn the hook\n36: // with, and it must be a regular file, so a directory or a dangling link falls\n37: // back to the install-anchored walk instead of being handed to node.\n38: function isRegularFileOverride(candidate) {\n39:     if (!isAbsolute(candidate))\n40:         return false;\n41:     try {\n42:         return statSync(candidate).isFile();\n43:     }\n44:     catch {\n45:         return false;\n46:     }\n47: }\n48: function resolveTarget() {\n49:     // Test/install override: an explicit absolute target wins over the walk.\n50:     const override = process.env.SPECKIT_USER_PROMPT_TARGET;\n51:     if (override && isRegularFileOverride(override)) {\n52:         return override;\n53:     }\n54:     let current = dirname(fileURLToPath(import.meta.url));\n55:     for (let depth = 0; depth < MAX_ROOT_WALK_DEPTH; depth += 1) {\n56:         // Both root names must resolve identically: a checkout whose legacy mirror\n57:         // was dropped must not silently lose the advisor target, so the probe never\n58:         // assumes which root name owns it.\n59:         for (const rootName of ['.skilled', '.opencode']) {\n60:             const candidate = join(current, rootName, TARGET_REL);\n61:             if (existsSync(candidate)) {\n62:                 return candidate;\n63:             }\n64:         }\n65:         const parent = dirname(current);\n66:         if (parent === current) {\n67:             break;\n68:         }\n69:         current = parent;\n70:     }\n71:     return null;\n72: }\n73: function emitDiagnostic(code) {\n74:     process.stderr.write(`[speckit-hook:user-prompt-submit] ${code}\\n`);\n75: }\n76: // Collect stdin until it ends or the deadline passes, then release it so the\n77: // process can exit. More than MAX_STDIN_BYTES rejects with INPUT_OVERFLOW and\n78: // destroys stdin, so a runaway payload is never buffered whole.\n79: function readBoundedStdin() {\n80:     return new Promise((resolve, reject) => {\n81:         const stdin = process.stdin;\n82:         const chunks = [];\n83:         let totalBytes = 0;\n84:         let settled = false;\n85:         const release = () => {\n86:             clearTimeout(timer);\n87:             stdin.removeListener('data', onData);\n88:             stdin.removeListener('end', onEnd);\n89:             stdin.removeListener('error', onError);\n90:             stdin.pause();\n91:         };\n92:         function onEnd() {\n93:             if (settled)\n94:                 return;\n95:             settled = true;\n96:             release();\n97:             resolve(Buffer.concat(chunks, totalBytes));\n98:         }\n99:         function onError(error) {\n100:             if (settled)\n101:                 return;\n102:             settled = true;\n103:             release();\n104:             reject(error);\n105:         }\n106:         function onData(chunk) {\n107:             if (settled)\n108:                 return;\n109:             const buffer = Buffer.isBuffer(chunk) ? chunk : Buffer.from(chunk);\n110:             totalBytes += buffer.length;\n111:             if (totalBytes > MAX_STDIN_BYTES) {\n112:                 settled = true;\n113:                 release();\n114:                 stdin.destroy();\n115:                 reject(new Error('INPUT_OVERFLOW'));\n116:                 return;\n117:             }\n118:             chunks.push(buffer);\n119:         }\n120:         // Listeners go on before the timer, so a stdin that cannot take listeners\n121:         // rejects at once and leaves no timer behind.\n122:         stdin.on('data', onData);\n123:         stdin.on('end', onEnd);\n124:         stdin.on('error', onError);\n125:         const timer = setTimeout(onEnd, STDIN_DEADLINE_MS);\n126:     });\n127: }\n128: async function runShim() {\n129:     const target = resolveTarget();\n130:     if (!target) {\n131:         emitDiagnostic('TARGET_UNRESOLVED');\n132:         return '{}';\n133:     }\n134:     try {\n135:         const childEnv = { ...process.env };\n136:         // The advisor must finish before this shim kills it, or its fallback output is lost.\n137:         const childBudgetCeilingMs = CHILD_TIMEOUT_MS - CHILD_START_MARGIN_MS;\n138:         const operatorBudgetMs = Number.parseInt(process.env.SPECKIT_CLAUDE_HOOK_TIMEOUT_MS ?? '', 10);\n139:         childEnv.SPECKIT_CLAUDE_HOOK_TIMEOUT_MS = String(Number.isFinite(operatorBudgetMs) && operatorBudgetMs > 0\n140:             ? Math.min(operatorBudgetMs, childBudgetCeilingMs)\n141:             : childBudgetCeilingMs);\n142:         const input = await readBoundedStdin();\n143:         const result = spawnSync(process.execPath, [target, ...process.argv.slice(2)], {\n144:             cwd: process.cwd(),\n145:             input,\n146:             encoding: 'utf8',\n147:             env: childEnv,\n148:             timeout: CHILD_TIMEOUT_MS,\n149:             maxBuffer: MAX_STDIO_BYTES,\n150:             killSignal: 'SIGKILL',\n151:         });\n152:         if (result.error) {\n153:             const code = result.error.code;\n154:             emitDiagnostic(code === 'ETIMEDOUT' ? 'CHILD_TIMEOUT' : code === 'ENOBUFS' ? 'OUTPUT_OVERFLOW' : 'SPAWN_ERROR');\n155:             return '{}';\n156:         }\n157:         if (result.status !== 0) {\n158:             emitDiagnostic('NONZERO_EXIT');\n159:             return '{}';\n160:         }\n161:         const stdout = typeof result.stdout === 'string' ? result.stdout.trim() : '';\n162:         if (!stdout) {\n163:             emitDiagnostic('EMPTY_OUTPUT');\n164:             return '{}';\n165:         }\n166:         try {\n167:             JSON.parse(stdout);\n168:             return stdout;\n169:         }\n170:         catch {\n171:             emitDiagnostic('INVALID_JSON');\n172:             return '{}';\n173:         }\n174:     }\n175:     catch (error) {\n176:         emitDiagnostic(error instanceof Error && error.message === 'INPUT_OVERFLOW'\n177:             ? 'INPUT_OVERFLOW'\n178:             : 'STDIN_READ_ERROR');\n179:         return '{}';\n180:     }\n181: }\n182: // ───────────────────────────────────────────────────────────────────\n183: // 3. ENTRYPOINT\n184: // ───────────────────────────────────────────────────────────────────\n185: async function main() {\n186:     const advisorJson = await runShim();\n187:     process.stdout.write(`${advisorJson}\\n`);\n188:     process.exit(0);\n189: }\n190: void main();\n191: //# sourceMappingURL=user-prompt-submit.js.map"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-spec-kit/runtime/dist/hooks/claude/user-prompt-submit.js\"}"},"time":{"start":1794527291275,"end":1794527291711}}}}
