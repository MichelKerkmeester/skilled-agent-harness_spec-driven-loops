ntime: options.runtime,\n457-            tokenCap,\n458-            errorMessage: cli.exitCode === EXIT_RETRYABLE\n459-                ? 'CLI_RETRYABLE_EXIT_75'\n460-                : `CLI_EXIT_${cli.exitCode ?? 'SIGNAL'}`,\n461-            reason: cli.exitCode === EXIT_RETRYABLE ? 'exit_75' : `exit_${cli.exitCode ?? 'signal'}`,\n462-            exitCode: cli.exitCode,\n463-            subprocessInvoked: true,\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"cd /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research\\ngrep -n \\\"export async function buildSkillAdvisorBriefFromCli\\\" -A 60 .skilled/skills/system-skill-advisor/runtime/dist/hooks/lib/skill-advisor-cli-fallback.js | head -80\"}"},"time":{"start":1794527660790,"end":1794527662584}}}}
