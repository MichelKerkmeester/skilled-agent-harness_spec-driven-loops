{"type":"tool_use","timestamp":1794527274070,"sessionID":"ses_e2dd83ee1ffeYEdnoBAHqwXnbt","part":{"partID":"prt_1d229228c001CI9WglV9trPm2Z","sessionID":"ses_e2dd83ee1ffeYEdnoBAHqwXnbt","messageID":"msg_1d2290f1c001rY1nW4JdZltmLm","type":"tool","id":"call_6ef4774d9bc24f49a8c4a1f5","tool":"shell","state":{"status":"completed","input":{"command":"ls -la REPO RULES.md; sed -n '1,40p' .dsh/plugins/repo-guards/adapters/prompt-advisor.mjs"},"output":"ls: REPO: No such file or directory\nls: RULES.md: No such file or directory\n// ───────────────────────────────────────────────────────────────────\n// MODULE: Prompt Advisor Adapter\n// ───────────────────────────────────────────────────────────────────\n\n// ─────────────────────────────────────────────────────────────────────────────\n// 1. IMPORTS\n// ─────────────────────────────────────────────────────────────────────────────\n\nimport { isHookEnabled } from '../../../../hooks/shared/hook-flags.mjs';\nimport { loadDshLlm } from '../../../../hooks/shared/dsh/dsh-llm.mjs';\nimport { isLineageLeaf } from '../../../../hooks/shared/dsh/session-role.mjs';\n\n// ─────────────────────────────────────────────────────────────────────────────\n// 2. CONSTANTS\n// ─────────────────────────────────────────────────────────────────────────────\n\nconst ADVISOR_MODULE_URL = new URL(\n  '../../runtime/dist/hooks/claude/user-prompt-submit.js',\n  import.meta.url,\n).href;\n\n// Mirrors the advisor renderer's directive label. A brief that drifts past it is\n// never split, so it is always delivered whole.\nconst DIRECTIVE_SEPARATOR = '\\nDirectives:';\nconst MAX_TRACKED_SESSIONS = 64;\nconst RECEIPTS = Symbol.for('skilled.repo-guards.directive-receipts');\n\nexport const ERROR_POLICY = 'fail-open';\n// The advisor keys its metrics and outcome records by runtime and drops a label it does not list.\nexport const ADVISOR_RUNTIME = 'dsh';\n\n// ─────────────────────────────────────────────────────────────────────────────\n// 3. HELPERS\n// ─────────────────────────────────────────────────────────────────────────────\n\nfunction contentText(content) {\n  if (typeof content === 'string') return content;\n  if (!Array.isArray(content)) return '';\n  return content.map((part) => typeof part === 'string' ? part : part?.text)\n    .filter((text) => typeof text === 'string').join('\\n');\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"ls: REPO: No such file or directory\nls: RULES.md: No such file or directory\n// ───────────────────────────────────────────────────────────────────\n// MODULE: Prompt Advisor Adapter\n// ───────────────────────────────────────────────────────────────────\n\n// ─────────────────────────────────────────────────────────────────────────────\n// 1. IMPORTS\n// ─────────────────────────────────────────────────────────────────────────────\n\nimport { isHookEnabled } from '../../../../hooks/shared/hook-flags.mjs';\nimport { loadDshLlm } from '../../../../hooks/shared/dsh/dsh-llm.mjs';\nimport { isLineageLeaf } from '../../../../hooks/shared/dsh/session-role.mjs';\n\n// ─────────────────────────────────────────────────────────────────────────────\n// 2. CONSTANTS\n// ─────────────────────────────────────────────────────────────────────────────\n\nconst ADVISOR_MODULE_URL = new URL(\n  '../../runtime/dist/hooks/claude/user-prompt-submit.js',\n  import.meta.url,\n).href;\n\n// Mirrors the advisor renderer's directive label. A brief that drifts past it is\n// never split, so it is always delivered whole.\nconst DIRECTIVE_SEPARATOR = '\\nDirectives:';\nconst MAX_TRACKED_SESSIONS = 64;\nconst RECEIPTS = Symbol.for('skilled.repo-guards.directive-receipts');\n\nexport const ERROR_POLICY = 'fail-open';\n// The advisor keys its metrics and outcome records by runtime and drops a label it does not list.\nexport const ADVISOR_RUNTIME = 'dsh';\n\n// ─────────────────────────────────────────────────────────────────────────────\n// 3. HELPERS\n// ─────────────────────────────────────────────────────────────────────────────\n\nfunction contentText(content) {\n  if (typeof content === 'string') return content;\n  if (!Array.isArray(content)) return '';\n  return content.map((part) => typeof part === 'string' ? part : part?.text)\n    .filter((text) => typeof text === 'string').join('\\n');\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"ls -la REPO RULES.md; sed -n '1,40p' .dsh/plugins/repo-guards/adapters/prompt-advisor.mjs\"}"},"time":{"start":1794527273612,"end":1794527274070}}}}
