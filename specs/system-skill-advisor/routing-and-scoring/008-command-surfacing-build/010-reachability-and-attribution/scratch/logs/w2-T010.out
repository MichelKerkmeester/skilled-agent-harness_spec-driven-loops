should be injected by watcher fixtures');\n\n\n/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/lib/render.ts:\n  Line 124: // Labels the directive block so injected content reads as one structured\n\n\n/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-spec-kit/runtime/tests/multi-ai-council-rollback.vitest.ts:\n  Line 65:       reason: 'seat-error injection',\n\n\n/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/tests/daemon-watcher-resource-leaks-049-005.vitest.ts:\n  Line 22:       throw new Error('chokidar should be injected by watcher fixtures');\n\n\n/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-deep-loop/runtime/lib/authorized-ledger/append-only-ledger.ts:\n  Line 529:    * clock is this ledger's own, so a caller that injects a fixed or\n\n\n/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/tests/hooks/settings-driven-invocation-parity.vitest.ts:\n  Line 98:   PreCompact: 'dist/hooks/claude/compact-inject.js',\n\n\n/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-deep-loop/runtime/lib/deep-research-ledger-schema/deep-research-ledger-schema.ts:\n  Line 581:     injectedAtIteration: 'uint32',\n\n\n/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-deep-loop/runtime/lib/deep-research-ledger-schema/deep-research-ledger-types.ts:\n  Line 483:   readonly injectedAtIteration: Uint32;\n\n\n/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-spec-kit/runtime/tests/hooks-shared-provenance.vitest.ts:\n  Line 88:     it('strips instruction-style injections', () => {\n\n\n/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-deep-loop/runtime/lib/deep-research-ledger-schema/legacy-compatibility.ts:\n  Line 178:       'registryValue', 'source', 'origin', 'injectedAtIteration', 'sessionId', 'generation',\n\n\n/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-spec-kit/runtime/tests/adversarial/compact-prime-identity-race.vitest.ts:\n  Line 8: //      via compact-inject, overwriting pendingCompactPrime.\n\n  Line 102:     // 2. Producer (compact-inject) writes a fresher compact prime.\n\n\n/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-spec-kit/runtime/tests/directive-lifecycle-boundary-bridge.vitest.ts:\n  Line 54:     const received = runBoundaryOwner('dist/hooks/claude/compact-inject.js', {\n\n\n/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/lib/embedders/schema.ts:\n  Line 248:    * Override the cascade invocation. Used by tests to inject a deterministic\n\n\n/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-spec-kit/runtime/lib/utils/skill-label-sanitizer.ts:\n  Line 14:  * Fold, single-line, and strip a skill label of prompt-injection-shaped or control-character\n\n\n(Results are truncated: showing first 60 results. Consider using a more specific path or pattern.)"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"limit\":60,\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled\",\"pattern\":\"custom_message|registerInjectedInput|inject\",\"include\":\"*.ts\"}"},"time":{"start":1794528142779,"end":1794528143003}}}}
