: \"beyond-max-query-tokens\",\n      \"token\": \"node\"\n    },\n    {\n      \"reason\": \"beyond-max-query-tokens\",\n      \"token\": \"test\"\n    },\n    {\n      \"reason\": \"beyond-max-query-tokens\",\n      \"token\": \"suite\"\n    }\n  ],\n  \"indexHash\": \"cac6622b1df8eae3cf5fe37681108fd2e890dfeb637c88211608313d0c4227cd\",\n  \"manifestHash\": \"c243be4138be26b030af5a965ddc587955809ebe6ccd694e69601c9e81a327a8\",\n  \"normalizedQuery\": \"create a codex hook approval check doctor script with a node test suite\",\n  \"results\": [],\n  \"schemaVersion\": 2,\n  \"specFolder\": null,\n  \"tokens\": [\n    \"create\",\n    \"codex\",\n    \"hook\",\n    \"approval\",\n    \"check\",\n    \"doctor\",\n    \"script\",\n    \"with\"\n  ],\n  \"totalCandidates\": 0,\n  \"truncated\": false,\n  \"staleFallback\": {\n    \"available\": true,\nEXIT:0\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"node .skilled/skills/system-spec-kit/runtime/cli/retrieval/lookup-trigger-index.mjs --json --scoring-only -- \\\"Create a codex hook approval check doctor script with a node:test suite\\\" 2>&1 | head -40; echo \\\"EXIT:$?\\\"\",\"workdir\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research\"}"},"time":{"start":1794527276973,"end":1794527278777}}}}
