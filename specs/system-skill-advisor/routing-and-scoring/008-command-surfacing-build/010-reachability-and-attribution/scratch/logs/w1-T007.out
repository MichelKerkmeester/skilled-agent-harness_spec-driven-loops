{"type":"tool_use","timestamp":1794527394481,"sessionID":"ses_e2dd82e01ffeqmnJRIxBdI7fut","part":{"partID":"prt_1d22afa29001iCavR9i9swEJmS","sessionID":"ses_e2dd82e01ffeqmnJRIxBdI7fut","messageID":"msg_1d22ae1e3001hZqYC8i2yzjPhe","type":"tool","id":"call_1de0a69667434f17a4e8884c","tool":"shell","state":{"status":"completed","input":{"command":"sed -n '1,80p' .skilled/commands/doctor/scripts/tests/git-hook-gates.test.cjs","workdir":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research"},"output":"#!/usr/bin/env node\n// ───────────────────────────────────────────────────────────────────\n// MODULE: Git Hook Gate Settings Tests\n// ───────────────────────────────────────────────────────────────────\n'use strict';\n\n// Drives the gate settings script as a process against throwaway repositories with\n// an isolated global config, and proves the hook helper reads what it writes.\n\n// ─────────────────────────────────────────────────────────────────────────────\n// 1. IMPORTS AND FIXTURES\n// ─────────────────────────────────────────────────────────────────────────────\n\nconst assert = require('node:assert/strict');\nconst { spawnSync, execFileSync } = require('node:child_process');\nconst fs = require('node:fs');\nconst os = require('node:os');\nconst path = require('node:path');\nconst test = require('node:test');\n\nconst SCRIPT = path.resolve(__dirname, '..', 'git-hook-gates.cjs');\nconst HELPER = path.resolve(__dirname, '../../../../scripts/git-hooks/lib/gate-config.sh');\n\nfunction fixture(t) {\n  const dir = fs.mkdtempSync(path.join(os.tmpdir(), 'git-hook-gates-'));\n  t.after(() => fs.rmSync(dir, { recursive: true, force: true }));\n  const repo = path.join(dir, 'repo');\n  const global = path.join(dir, 'global.gitconfig');\n  fs.writeFileSync(global, '');\n  const env = { ...process.env, GIT_CONFIG_GLOBAL: global, GIT_CONFIG_NOSYSTEM: '1' };\n  for (const name of Object.keys(env)) if (/^(GIT_DIR|GIT_WORK_TREE|GIT_CONFIG_COUNT|SPECKIT_SKIP_|SPECKIT_ALLOW_)/.test(name)) delete env[name];\n  execFileSync('git', ['init', '-q', repo], { env });\n  const run = (...args) => {\n    const r = spawnSync(process.execPath, [SCRIPT, ...args, '--repo', repo], { encoding: 'utf8', env });\n    return { code: r.status, out: r.stdout, err: r.stderr };\n  };\n  const config = (...args) => spawnSync('git', ['-C', repo, 'config', ...args], { encoding: 'utf8', env }).stdout.trim();\n  return { repo, global, env, run, config };\n}\n\nconst gate = (out, key) => JSON.parse(out.slice(0, out.lastIndexOf('STATUS='))).gates.find((g) => g.key === key);\n\n// ─────────────────────────────────────────────────────────────────────────────\n// 2. TESTS\n// ─────────────────────────────────────────────────────────────────────────────\n\ntest('list reports every registered gate, all on in a fresh repository', (t) => {\n  const f = fixture(t);\n  const r = f.run('list');\n  assert.equal(r.code, 0);\n  assert.match(r.out, /STATUS=OK GATES=16 OFF=0/);\n  assert.match(r.out, /\\| cardSync \\| pre-commit \\| - \\| - \\| on \\(default\\) \\|/);\n  assert.match(r.out, /\\| remotePush \\| pre-push \\| - \\| - \\| per push only \\|/);\n});\n\ntest('set is a dry run until --apply', (t) => {\n  const f = fixture(t);\n  const dry = f.run('set', 'cardSync', 'off');\n  assert.equal(dry.code, 0);\n  assert.match(dry.out, /Would run: git config --local --replace-all speckit\\.hooks\\.cardSync off/);\n  assert.match(dry.out, /STATUS=OK MODE=DRY_RUN/);\n  assert.equal(f.config('--get', 'speckit.hooks.cardSync'), '');\n});\n\ntest('an applied off is what the hook helper reads', (t) => {\n  const f = fixture(t);\n  assert.equal(f.run('set', 'cardSync', 'off', '--apply').code, 0);\n  assert.equal(f.config('--local', '--get', 'speckit.hooks.cardSync'), 'off');\n  assert.equal(gate(f.run('list', '--json').out, 'cardSync').effective.state, 'off');\n  const hook = spawnSync('bash', ['-c', `. \"${HELPER}\"; gate_config_apply pre-commit 2>/dev/null; printf '%s' \"\\${SPECKIT_SKIP_CARD_SYNC:-unset}\"`],\n    { cwd: f.repo, encoding: 'utf8', env: f.env });\n  assert.equal(hook.stdout, '1');\n});\n\ntest('on removes a local off, and writes an explicit local on over a global off', (t) => {\n  const f = fixture(t);\n  f.run('set', 'specRemint', 'off', '--apply');\n  const unset = f.run('set', 'specRemint', 'on', '--apply');\n  assert.match(unset.out, /--unset-all speckit\\.hooks\\.specRemint/);\n  assert.equal(f.config('--local', '--get', 'speckit.hooks.specRemint'), '');\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"#!/usr/bin/env node\n// ───────────────────────────────────────────────────────────────────\n// MODULE: Git Hook Gate Settings Tests\n// ───────────────────────────────────────────────────────────────────\n'use strict';\n\n// Drives the gate settings script as a process against throwaway repositories with\n// an isolated global config, and proves the hook helper reads what it writes.\n\n// ─────────────────────────────────────────────────────────────────────────────\n// 1. IMPORTS AND FIXTURES\n// ─────────────────────────────────────────────────────────────────────────────\n\nconst assert = require('node:assert/strict');\nconst { spawnSync, execFileSync } = require('node:child_process');\nconst fs = require('node:fs');\nconst os = require('node:os');\nconst path = require('node:path');\nconst test = require('node:test');\n\nconst SCRIPT = path.resolve(__dirname, '..', 'git-hook-gates.cjs');\nconst HELPER = path.resolve(__dirname, '../../../../scripts/git-hooks/lib/gate-config.sh');\n\nfunction fixture(t) {\n  const dir = fs.mkdtempSync(path.join(os.tmpdir(), 'git-hook-gates-'));\n  t.after(() => fs.rmSync(dir, { recursive: true, force: true }));\n  const repo = path.join(dir, 'repo');\n  const global = path.join(dir, 'global.gitconfig');\n  fs.writeFileSync(global, '');\n  const env = { ...process.env, GIT_CONFIG_GLOBAL: global, GIT_CONFIG_NOSYSTEM: '1' };\n  for (const name of Object.keys(env)) if (/^(GIT_DIR|GIT_WORK_TREE|GIT_CONFIG_COUNT|SPECKIT_SKIP_|SPECKIT_ALLOW_)/.test(name)) delete env[name];\n  execFileSync('git', ['init', '-q', repo], { env });\n  const run = (...args) => {\n    const r = spawnSync(process.execPath, [SCRIPT, ...args, '--repo', repo], { encoding: 'utf8', env });\n    return { code: r.status, out: r.stdout, err: r.stderr };\n  };\n  const config = (...args) => spawnSync('git', ['-C', repo, 'config', ...args], { encoding: 'utf8', env }).stdout.trim();\n  return { repo, global, env, run, config };\n}\n\nconst gate = (out, key) => JSON.parse(out.slice(0, out.lastIndexOf('STATUS='))).gates.find((g) => g.key === key);\n\n// ─────────────────────────────────────────────────────────────────────────────\n// 2. TESTS\n// ─────────────────────────────────────────────────────────────────────────────\n\ntest('list reports every registered gate, all on in a fresh repository', (t) => {\n  const f = fixture(t);\n  const r = f.run('list');\n  assert.equal(r.code, 0);\n  assert.match(r.out, /STATUS=OK GATES=16 OFF=0/);\n  assert.match(r.out, /\\| cardSync \\| pre-commit \\| - \\| - \\| on \\(default\\) \\|/);\n  assert.match(r.out, /\\| remotePush \\| pre-push \\| - \\| - \\| per push only \\|/);\n});\n\ntest('set is a dry run until --apply', (t) => {\n  const f = fixture(t);\n  const dry = f.run('set', 'cardSync', 'off');\n  assert.equal(dry.code, 0);\n  assert.match(dry.out, /Would run: git config --local --replace-all speckit\\.hooks\\.cardSync off/);\n  assert.match(dry.out, /STATUS=OK MODE=DRY_RUN/);\n  assert.equal(f.config('--get', 'speckit.hooks.cardSync'), '');\n});\n\ntest('an applied off is what the hook helper reads', (t) => {\n  const f = fixture(t);\n  assert.equal(f.run('set', 'cardSync', 'off', '--apply').code, 0);\n  assert.equal(f.config('--local', '--get', 'speckit.hooks.cardSync'), 'off');\n  assert.equal(gate(f.run('list', '--json').out, 'cardSync').effective.state, 'off');\n  const hook = spawnSync('bash', ['-c', `. \"${HELPER}\"; gate_config_apply pre-commit 2>/dev/null; printf '%s' \"\\${SPECKIT_SKIP_CARD_SYNC:-unset}\"`],\n    { cwd: f.repo, encoding: 'utf8', env: f.env });\n  assert.equal(hook.stdout, '1');\n});\n\ntest('on removes a local off, and writes an explicit local on over a global off', (t) => {\n  const f = fixture(t);\n  f.run('set', 'specRemint', 'off', '--apply');\n  const unset = f.run('set', 'specRemint', 'on', '--apply');\n  assert.match(unset.out, /--unset-all speckit\\.hooks\\.specRemint/);\n  assert.equal(f.config('--local', '--get', 'speckit.hooks.specRemint'), '');\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"sed -n '1,80p' .skilled/commands/doctor/scripts/tests/git-hook-gates.test.cjs\",\"workdir\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research\"}"},"time":{"start":1794527394345,"end":1794527394481}}}}
{"type":"tool_use","timestamp":1794527394487,"sessionID":"ses_e2dd82e01ffeqmnJRIxBdI7fut","part":{"partID":"prt_1d22af74f002x4K6q2ez5jjFja","sessionID":"ses_e2dd82e01ffeqmnJRIxBdI7fut","messageID":"msg_1d22ae1e3001hZqYC8i2yzjPhe","type":"tool","id":"call_0d849e82c921409bb89adbaa","tool":"shell","state":{"status":"completed","input":{"command":"sed -n '1,90p' .skilled/commands/doctor/scripts/git-hook-gates.cjs; echo \"=== ENTRY ===\"; sed -n '290,380p' .skilled/commands/doctor/scripts/git-hook-gates.cjs","workdir":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research"},"output":"#!/usr/bin/env node\n// ───────────────────────────────────────────────────────────────────\n// MODULE: Git Hook Gate Settings\n// ───────────────────────────────────────────────────────────────────\n'use strict';\n\n// Lists and changes the persistent on/off setting of each shipped git hook gate.\n//\n// WHY THIS EXISTS: every optional gate in the pre-commit, prepare-commit-msg and\n// pre-push hooks has a SPECKIT_SKIP_* variable, but a variable lasts one command.\n// An operator who never wants a gate had to export it in every shell. The hooks\n// now read `speckit.hooks.<key>` from local or global git config through\n// lib/gate-config.sh, and this script is the guided way to see and change those\n// keys. gates.tsv beside that helper is the one list of gates; this script reads\n// it rather than keeping its own, so a new gate appears here when it is registered.\n//\n// Two kinds of switch are deliberately not settable here. The per-push approvals\n// (SPECKIT_ALLOW_REMOTE_PUSH, SPECKIT_ALLOW_MASS_DELETION) are marked\n// non-persistable in the registry, because a saved approval would approve every\n// later push. The commit-msg hook has no switch at all: its rules live in the sk-git\n// templates, and changing them is git-standards.cjs's job.\n//\n// Dry-run by default: `set` prints the git config commands it would run and the\n// resulting effective value, and changes nothing without --apply.\n//\n// Usage:\n//   git-hook-gates.cjs list [--repo <dir>] [--json]\n//   git-hook-gates.cjs set <key> on|off [--scope local|global] [--repo <dir>] [--apply] [--json]\n//\n// Exit 0 on success, 2 on a refused or invalid request (unknown key, a\n// non-persistable gate, bad arguments, a missing registry), always with a STATUS= line.\n\n// ─────────────────────────────────────────────────────────────────────────────\n// 1. IMPORTS\n// ─────────────────────────────────────────────────────────────────────────────\n\nconst fs = require('node:fs');\nconst path = require('node:path');\nconst { execFileSync, spawnSync } = require('node:child_process');\n\n// ─────────────────────────────────────────────────────────────────────────────\n// 2. CONSTANTS\n// ─────────────────────────────────────────────────────────────────────────────\n\nconst DEFAULT_REGISTRY = path.resolve(__dirname, '../../../scripts/git-hooks/lib/gates.tsv');\nconst KEY_PREFIX = 'speckit.hooks.';\nconst OFF_VALUES = new Set(['off', 'false', 'no', '0']);\nconst SCOPES = new Set(['local', 'global']);\n\nclass RefusedError extends Error {}\n\n// ─────────────────────────────────────────────────────────────────────────────\n// 3. HELPERS\n// ─────────────────────────────────────────────────────────────────────────────\n\nfunction parseArgs(argv) {\n  const opts = { positional: [], scope: 'local', apply: false, json: false, repo: null };\n  for (let i = 0; i < argv.length; i += 1) {\n    const arg = argv[i];\n    if (arg === '--apply') opts.apply = true;\n    else if (arg === '--json') opts.json = true;\n    else if (arg === '--scope' || arg === '--repo') {\n      const value = argv[i + 1];\n      if (value === undefined) throw new RefusedError(`${arg} needs a value`);\n      opts[arg.slice(2)] = value;\n      i += 1;\n    } else if (arg.startsWith('--')) throw new RefusedError(`unknown flag: ${arg}`);\n    else opts.positional.push(arg);\n  }\n  if (!SCOPES.has(opts.scope)) throw new RefusedError(`--scope must be local or global, not ${opts.scope}`);\n  return opts;\n}\n\nfunction readRegistry(file) {\n  if (!fs.existsSync(file)) throw new RefusedError(`gate registry not found: ${file}`);\n  return fs.readFileSync(file, 'utf8').split('\\n')\n    .filter((line) => line.trim() && !line.startsWith('#'))\n    .map((line) => {\n      const [hook, key, env, persistable, description] = line.split('\\t');\n      return { hook, key, env, persistable: persistable === 'yes', description: description || '' };\n    });\n}\n\nfunction repoRoot(dir) {\n  try {\n    return execFileSync('git', ['-C', dir, 'rev-parse', '--show-toplevel'], { encoding: 'utf8', stdio: ['ignore', 'pipe', 'ignore'] }).trim();\n  } catch {\n    throw new RefusedError(`not inside a git repository: ${dir}`);\n  }\n}\n=== ENTRY ===\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"#!/usr/bin/env node\n// ───────────────────────────────────────────────────────────────────\n// MODULE: Git Hook Gate Settings\n// ───────────────────────────────────────────────────────────────────\n'use strict';\n\n// Lists and changes the persistent on/off setting of each shipped git hook gate.\n//\n// WHY THIS EXISTS: every optional gate in the pre-commit, prepare-commit-msg and\n// pre-push hooks has a SPECKIT_SKIP_* variable, but a variable lasts one command.\n// An operator who never wants a gate had to export it in every shell. The hooks\n// now read `speckit.hooks.<key>` from local or global git config through\n// lib/gate-config.sh, and this script is the guided way to see and change those\n// keys. gates.tsv beside that helper is the one list of gates; this script reads\n// it rather than keeping its own, so a new gate appears here when it is registered.\n//\n// Two kinds of switch are deliberately not settable here. The per-push approvals\n// (SPECKIT_ALLOW_REMOTE_PUSH, SPECKIT_ALLOW_MASS_DELETION) are marked\n// non-persistable in the registry, because a saved approval would approve every\n// later push. The commit-msg hook has no switch at all: its rules live in the sk-git\n// templates, and changing them is git-standards.cjs's job.\n//\n// Dry-run by default: `set` prints the git config commands it would run and the\n// resulting effective value, and changes nothing without --apply.\n//\n// Usage:\n//   git-hook-gates.cjs list [--repo <dir>] [--json]\n//   git-hook-gates.cjs set <key> on|off [--scope local|global] [--repo <dir>] [--apply] [--json]\n//\n// Exit 0 on success, 2 on a refused or invalid request (unknown key, a\n// non-persistable gate, bad arguments, a missing registry), always with a STATUS= line.\n\n// ─────────────────────────────────────────────────────────────────────────────\n// 1. IMPORTS\n// ─────────────────────────────────────────────────────────────────────────────\n\nconst fs = require('node:fs');\nconst path = require('node:path');\nconst { execFileSync, spawnSync } = require('node:child_process');\n\n// ─────────────────────────────────────────────────────────────────────────────\n// 2. CONSTANTS\n// ─────────────────────────────────────────────────────────────────────────────\n\nconst DEFAULT_REGISTRY = path.resolve(__dirname, '../../../scripts/git-hooks/lib/gates.tsv');\nconst KEY_PREFIX = 'speckit.hooks.';\nconst OFF_VALUES = new Set(['off', 'false', 'no', '0']);\nconst SCOPES = new Set(['local', 'global']);\n\nclass RefusedError extends Error {}\n\n// ─────────────────────────────────────────────────────────────────────────────\n// 3. HELPERS\n// ─────────────────────────────────────────────────────────────────────────────\n\nfunction parseArgs(argv) {\n  const opts = { positional: [], scope: 'local', apply: false, json: false, repo: null };\n  for (let i = 0; i < argv.length; i += 1) {\n    const arg = argv[i];\n    if (arg === '--apply') opts.apply = true;\n    else if (arg === '--json') opts.json = true;\n    else if (arg === '--scope' || arg === '--repo') {\n      const value = argv[i + 1];\n      if (value === undefined) throw new RefusedError(`${arg} needs a value`);\n      opts[arg.slice(2)] = value;\n      i += 1;\n    } else if (arg.startsWith('--')) throw new RefusedError(`unknown flag: ${arg}`);\n    else opts.positional.push(arg);\n  }\n  if (!SCOPES.has(opts.scope)) throw new RefusedError(`--scope must be local or global, not ${opts.scope}`);\n  return opts;\n}\n\nfunction readRegistry(file) {\n  if (!fs.existsSync(file)) throw new RefusedError(`gate registry not found: ${file}`);\n  return fs.readFileSync(file, 'utf8').split('\\n')\n    .filter((line) => line.trim() && !line.startsWith('#'))\n    .map((line) => {\n      const [hook, key, env, persistable, description] = line.split('\\t');\n      return { hook, key, env, persistable: persistable === 'yes', description: description || '' };\n    });\n}\n\nfunction repoRoot(dir) {\n  try {\n    return execFileSync('git', ['-C', dir, 'rev-parse', '--show-toplevel'], { encoding: 'utf8', stdio: ['ignore', 'pipe', 'ignore'] }).trim();\n  } catch {\n    throw new RefusedError(`not inside a git repository: ${dir}`);\n  }\n}\n=== ENTRY ===\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"sed -n '1,90p' .skilled/commands/doctor/scripts/git-hook-gates.cjs; echo \\\"=== ENTRY ===\\\"; sed -n '290,380p' .skilled/commands/doctor/scripts/git-hook-gates.cjs\",\"workdir\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research\"}"},"time":{"start":1794527393615,"end":1794527394487}}}}
{"type":"step_finish","timestamp":1794527395509,"sessionID":"ses_e2dd82e01ffeqmnJRIxBdI7fut","part":{"id":"prt_1d22afeb5001CPbKXtjSK6jyaq","sessionID":"ses_e2dd82e01ffeqmnJRIxBdI7fut","messageID":"msg_1d22ae1e3001hZqYC8i2yzjPhe","type":"step-finish","reason":"tool-calls","snapshot":"ad3f8a427d9fbbd3842295906dd1ef310c63035e","cost":0,"tokens":{"input":85205,"output":227,"reasoning":135,"cache":{"read":0,"write":0}}}}
{"type":"step_start","timestamp":1794527421562,"sessionID":"ses_e2dd82e01ffeqmnJRIxBdI7fut","part":{"id":"prt_1d22b647a001TESro5T6twQ5K9","sessionID":"ses_e2dd82e01ffeqmnJRIxBdI7fut","messageID":"msg_1d22afeb9001WxlvskglbxPxzv","type":"step-start","snapshot":"09f2c9364636552d46c1538012b7d64c01649cea"}}
{"type":"tool_use","timestamp":1794527422390,"sessionID":"ses_e2dd82e01ffeqmnJRIxBdI7fut","part":{"partID":"prt_1d22b65ca002lKUbF3uEko94XZ","sessionID":"ses_e2dd82e01ffeqmnJRIxBdI7fut","messageID":"msg_1d22afeb9001WxlvskglbxPxzv","type":"tool","id":"call_7f3d2f7f1da94345ae0f0a12","tool":"shell","state":{"status":"completed","input":{"command":"tail -60 .skilled/commands/doctor/scripts/git-hook-gates.cjs","workdir":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research"},"output":"  const name = `${KEY_PREFIX}${key}`;\n  const commands = [];\n  if (state === 'off') {\n    commands.push(['config', scopeFlag, '--replace-all', name, 'off']);\n  } else if (opts.scope === 'local' && valueAt(values, 'global') !== null && effective(values.filter((v) => v.scope !== 'local')).state === 'off') {\n    // A local unset would let the global off decide, so a local on is written explicitly.\n    commands.push(['config', '--local', '--replace-all', name, 'on']);\n  } else if (valueAt(values, opts.scope) !== null) {\n    commands.push(['config', scopeFlag, '--unset-all', name]);\n  }\n\n  const before = effective(values);\n  if (opts.apply) {\n    for (const args of commands) execFileSync('git', ['-C', root, ...args], { stdio: ['ignore', 'pipe', 'pipe'] });\n  }\n  const after = opts.apply ? effective(storedValues(root, key)) : null;\n  const shown = commands.map((args) => `git ${args.join(' ')}`);\n  const note = state === 'on' && opts.scope === 'global' && valueAt(values, 'local') !== null\n    && OFF_VALUES.has(String(valueAt(values, 'local')).toLowerCase())\n    ? 'local config still switches this gate off in this repository'\n    : null;\n\n  if (opts.json) {\n    process.stdout.write(`${JSON.stringify({ repo: root, key, hook: gate.hook, env: gate.env, scope: opts.scope, requested: state, applied: opts.apply, commands: shown, before, after, note }, null, 2)}\\n`);\n  } else {\n    process.stdout.write(`Gate ${key} (${gate.hook}): ${before.state} (${before.from}) -> requested ${state} in ${opts.scope} config\\n`);\n    if (shown.length === 0) process.stdout.write('Nothing to change: no stored value to remove at that scope.\\n');\n    for (const cmd of shown) process.stdout.write(`${opts.apply ? 'Ran' : 'Would run'}: ${cmd}\\n`);\n    if (after) process.stdout.write(`Now: ${after.state} (${after.from})\\n`);\n    if (note) process.stdout.write(`Note: ${note}\\n`);\n    if (!opts.apply && shown.length) process.stdout.write('Dry run: nothing changed. Add --apply to write.\\n');\n  }\n  process.stdout.write(`STATUS=OK MODE=${opts.apply ? 'APPLIED' : 'DRY_RUN'} KEY=${key}\\n`);\n  return 0;\n}\n\n// ─────────────────────────────────────────────────────────────────────────────\n// 5. MAIN\n// ─────────────────────────────────────────────────────────────────────────────\n\nfunction main(argv) {\n  try {\n    const opts = parseArgs(argv);\n    const registry = readRegistry(process.env.GATE_REGISTRY || DEFAULT_REGISTRY);\n    const root = repoRoot(opts.repo || process.cwd());\n    const mode = opts.positional[0];\n    if (mode === 'list') return list(registry, root, opts);\n    if (mode === 'set') return set(registry, root, opts);\n    throw new RefusedError('usage: git-hook-gates.cjs list|set ... (see the header)');\n  } catch (err) {\n    const message = err instanceof RefusedError ? err.message : `unexpected: ${err.message}`;\n    process.stderr.write(`git-hook-gates: ${message}\\n`);\n    process.stdout.write(`STATUS=FAIL ERROR=\"${message.replace(/\"/g, \"'\")}\"\\n`);\n    return 2;\n  }\n}\n\nif (require.main === module) process.exitCode = main(process.argv.slice(2));\n\nmodule.exports = { main, readRegistry, effective };\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"  const name = `${KEY_PREFIX}${key}`;\n  const commands = [];\n  if (state === 'off') {\n    commands.push(['config', scopeFlag, '--replace-all', name, 'off']);\n  } else if (opts.scope === 'local' && valueAt(values, 'global') !== null && effective(values.filter((v) => v.scope !== 'local')).state === 'off') {\n    // A local unset would let the global off decide, so a local on is written explicitly.\n    commands.push(['config', '--local', '--replace-all', name, 'on']);\n  } else if (valueAt(values, opts.scope) !== null) {\n    commands.push(['config', scopeFlag, '--unset-all', name]);\n  }\n\n  const before = effective(values);\n  if (opts.apply) {\n    for (const args of commands) execFileSync('git', ['-C', root, ...args], { stdio: ['ignore', 'pipe', 'pipe'] });\n  }\n  const after = opts.apply ? effective(storedValues(root, key)) : null;\n  const shown = commands.map((args) => `git ${args.join(' ')}`);\n  const note = state === 'on' && opts.scope === 'global' && valueAt(values, 'local') !== null\n    && OFF_VALUES.has(String(valueAt(values, 'local')).toLowerCase())\n    ? 'local config still switches this gate off in this repository'\n    : null;\n\n  if (opts.json) {\n    process.stdout.write(`${JSON.stringify({ repo: root, key, hook: gate.hook, env: gate.env, scope: opts.scope, requested: state, applied: opts.apply, commands: shown, before, after, note }, null, 2)}\\n`);\n  } else {\n    process.stdout.write(`Gate ${key} (${gate.hook}): ${before.state} (${before.from}) -> requested ${state} in ${opts.scope} config\\n`);\n    if (shown.length === 0) process.stdout.write('Nothing to change: no stored value to remove at that scope.\\n');\n    for (const cmd of shown) process.stdout.write(`${opts.apply ? 'Ran' : 'Would run'}: ${cmd}\\n`);\n    if (after) process.stdout.write(`Now: ${after.state} (${after.from})\\n`);\n    if (note) process.stdout.write(`Note: ${note}\\n`);\n    if (!opts.apply && shown.length) process.stdout.write('Dry run: nothing changed. Add --apply to write.\\n');\n  }\n  process.stdout.write(`STATUS=OK MODE=${opts.apply ? 'APPLIED' : 'DRY_RUN'} KEY=${key}\\n`);\n  return 0;\n}\n\n// ─────────────────────────────────────────────────────────────────────────────\n// 5. MAIN\n// ─────────────────────────────────────────────────────────────────────────────\n\nfunction main(argv) {\n  try {\n    const opts = parseArgs(argv);\n    const registry = readRegistry(process.env.GATE_REGISTRY || DEFAULT_REGISTRY);\n    const root = repoRoot(opts.repo || process.cwd());\n    const mode = opts.positional[0];\n    if (mode === 'list') return list(registry, root, opts);\n    if (mode === 'set') return set(registry, root, opts);\n    throw new RefusedError('usage: git-hook-gates.cjs list|set ... (see the header)');\n  } catch (err) {\n    const message = err instanceof RefusedError ? err.message : `unexpected: ${err.message}`;\n    process.stderr.write(`git-hook-gates: ${message}\\n`);\n    process.stdout.write(`STATUS=FAIL ERROR=\"${message.replace(/\"/g, \"'\")}\"\\n`);\n    return 2;\n  }\n}\n\nif (require.main === module) process.exitCode = main(process.argv.slice(2));\n\nmodule.exports = { main, readRegistry, effective };\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"tail -60 .skilled/commands/doctor/scripts/git-hook-gates.cjs\",\"workdir\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research\"}"},"time":{"start":1794527421898,"end":1794527422390}}}}
{"type":"step_finish","timestamp":1794527423619,"sessionID":"ses_e2dd82e01ffeqmnJRIxBdI7fut","part":{"id":"prt_1d22b6c83001J1MBjFb5s0dNq6","sessionID":"ses_e2dd82e01ffeqmnJRIxBdI7fut","messageID":"msg_1d22afeb9001WxlvskglbxPxzv","type":"step-finish","reason":"tool-calls","snapshot":"56d890794a5bc707cd5b364c521d8dd8c88a5ca9","cost":0,"tokens":{"input":75480,"output":94,"reasoning":39,"cache":{"read":12288,"write":0}}}}
{"type":"step_start","timestamp":1794527472446,"sessionID":"ses_e2dd82e01ffeqmnJRIxBdI7fut","part":{"id":"prt_1d22c2b3e001v5ATGXdBfb0kPc","sessionID":"ses_e2dd82e01ffeqmnJRIxBdI7fut","messageID":"msg_1d22b6c870018KGmIaLGIFV4jk","type":"step-start","snapshot":"0c572508912c4c51d4c73391ffa71231680a9fca"}}
{"type":"tool_use","timestamp":1794527522505,"sessionID":"ses_e2dd82e01ffeqmnJRIxBdI7fut","part":{"partID":"prt_1d22cebf0002NKg1d2ckBoshRb","sessionID":"ses_e2dd82e01ffeqmnJRIxBdI7fut","messageID":"msg_1d22b6c870018KGmIaLGIFV4jk","type":"tool","id":"call_9277cc804818481cba6610a5","tool":"read","state":{"status":"completed","input":{"path":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.opencode/skills/sk-code/shared/references/workflow-implement.md"},"output":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.opencode/skills/sk-code/shared/references/workflow-implement.md, lines 1-133\n1: ---\n2: title: Workflow Reference - Implementation\n3: description: Shared sk-code doctrine for the mutating build phase, from research before a change to the handoff into quality and verification.\n4: trigger_phrases:\n5:   - \"sk-code implementation workflow\"\n6:   - \"implement workflow doctrine\"\n7:   - \"mutating build workflow\"\n8:   - \"surface implementation standards\"\n9: importance_tier: important\n10: contextType: general\n11: version: 2.1.6.0\n12: ---\n13: \n14: # Workflow Reference - Implementation\n15: \n16: Open this when you are about to change behavior and need to know how much to read before the first edit.\n17: \n18: ---\n19: \n20: ## 1. OVERVIEW\n21: \n22: ### Purpose\n23: \n24: Implementation is the one lifecycle phase that builds new behavior. It reads before it writes, lands the smallest correct edit and hands the result on with the facts later phases need. It takes the active surface from the shared router and loads only that surface's resources.\n25: \n26: ### When to Use\n27: \n28: - Writing, modifying, refactoring or building code in the active surface.\n29: - Implementing a feature, script, component, module, fallback, parameter, authoring packet or runtime behavior.\n30: - Researching unfamiliar, risky, config-sensitive, security-sensitive or multi-file code before changing it.\n31: - Applying surface authoring patterns once the shared router has resolved the surface.\n32: - Using a library or framework overlay as peer reference after surface detection, never as a replacement for surface standards.\n33: \n34: ### When Not to Use\n35: \n36: - A concrete failing symptom dominates the task. Use [debugging](./workflow-debug.md).\n37: - The code is written and needs author-side P0/P1/P2 checks, comment hygiene or surface checklists. Use the `sk-code-quality` mode, which runs `quality-gate.cjs` first.\n38: - The task is final non-mutating evidence. Use [verification](./workflow-verify.md).\n39: - The user wants findings-first review output instead of workspace edits. Use the `sk-code-review` mode.\n40: - The change is documentation-only prose with no executable behavior or routing change.\n41: \n42: ### Core Principle\n43: \n44: Read first, change the least and write the baseline down before the first edit. Debugging and verification can only measure a change against the starting state this phase recorded.\n45: \n46: ---\n47: \n48: ## 2. WORKFLOW\n49: \n50: ### Research\n51: \n52: Research comes before any change to unfamiliar or high-blast code. For a small local edit it can be brief, but it always includes reading the target file.\n53: \n54: 1. Read every target file in this session before editing it.\n55: 2. List every place the change must reach (callers, tests, fixtures, config and exports). Read them, with nearby conventions and existing examples, before introducing a new shape.\n56: 3. Use the surface the shared router resolved ([stack-detection.md](../../shared/references/stack-detection.md)). Never re-detect or override it inside this phase.\n57: 4. Load the smallest active-surface resource set that covers the intent and the changed file types.\n58: 5. For broad or risky work, run a bounded read-only research sweep before editing.\n59: 6. When design or other upstream guidance handed off locked values, constraints or risks, keep them as given instead of redesigning the task.\n60: \n61: ### Pre-Write Restraint\n62: \n63: Before the first edit of non-trivial work, record two facts:\n64: \n65: | Field | Content |\n66: | --- | --- |\n67: | Baseline | The starting state, in the shape of the Baseline row in the verification [Baseline And Delta](./workflow-verify.md#baseline-and-delta) table. Write `UNKNOWN` when no safe baseline exists, because verification then has to settle for a narrower claim. |\n68: | Blast Radius | One phrase, such as `low-blast, reversible`, `medium-blast: multi-file behavior` or `high-blast: touches auth/data/filesystem/config`. |\n69: \n70: Then walk the [Design Restraint Ladder](../../shared/references/universal/code-quality-standards.md#design-restraint-ladder-pre-write) and stop at the first rung that holds. The ladder never cuts a P0 item or anything the user asked for. When requested scope looks unnecessary or risky, implement the requirement and raise a scope-amendment recommendation in the same response. Never cut scope silently. The restraint floor belongs to `.skilled/repo-rules/prevent-overengineering.md` sections 1 and 2 and the Restraint Signals table in `AGENTS.md` section 3.\n71: \n72: ### Write\n73: \n74: 1. Write the smallest correct change that meets the request and the active-surface standards.\n75: 2. Keep the project's existing conventions unless the request changes them.\n76: 3. Stay inside the user's scope and the established documentation scope.\n77: 4. Keep comments durable and explanatory. Never add artifact labels or temporary process markers, because they go stale the moment the work that named them closes.\n78: 5. Keep routing metadata, config shapes, generated-metadata ownership and packet boundaries intact when authoring system assets.\n79: 6. Prepare the handoff: changed scope, baseline, likely checks and accepted residual risks.\n80: \n81: ### OpenCode Implementation Guardrails\n82: \n83: For system code under `.skilled/` (the `sk-code-skilled` surface), also apply the [implementation guardrails](../../sk-code-skilled/references/shared/workflow-guardrails.md#2-implementation-guardrails).\n84: \n85: ---\n86: \n87: ## 3. DISCIPLINE\n88: \n89: ### Always\n90: \n91: - Always read a target file before editing it, including skeletons and existing README or contract files.\n92: - Always use the surface identity the shared router resolved before loading implementation resources.\n93: - Always pick the active-surface language or file-type guidance before applying standards.\n94: - Always load authoring checklists at write time when the active surface requires them.\n95: - Always record a baseline and a one-phrase blast-radius read for non-trivial work.\n96: - Always build the simplest correct implementation of the stated requirement.\n97: - Always hand off to quality and verification explicitly once the code is written.\n98: \n99: ### Never\n100: \n101: - Never claim completion from implementation alone. The [Iron Law](./workflow-verify.md#iron-law) gates every completion claim.\n102: - Never treat an unsupported or ambiguous surface as supported.\n103: - Never apply one surface's standards to another surface's runtime behavior.\n104: - Never narrow requested scope silently because part of it looks unnecessary.\n105: - Never add packet-local advisor metadata when the parent owns the identity.\n106: - Never paste whole reference documents into the workflow. Link or load the focused reference instead.\n107: \n108: ### Escalate If\n109: \n110: - Surface identity stays ambiguous after the shared-router inputs are read.\n111: - Implementation evidence conflicts with the approved spec or a user instruction.\n112: - The verification command set is unknown and the user expects a completion claim.\n113: - Security-sensitive, filesystem, credential, destructive or production-data behavior is unclear.\n114: \n115: ---\n116: \n117: ## 4. HANDOFF BOUNDARIES\n118: \n119: - Quality (`sk-code-quality`) receives the change for author-side checks, comment hygiene and active-surface checklists. The mode runs `quality-gate.cjs` first and loads every checklist its verdict lists.\n120: - [Debugging](./workflow-debug.md) receives failing checks or runtime symptoms and traces one root cause at a time.\n121: - [Verification](./workflow-verify.md) receives the final changed state, the baseline, the commands to run and the exact claim to prove.\n122: - Review (`sk-code-review`) owns findings-first critique when the user asks for severity-ranked risks instead of edits.\n123: \n124: The handoff is ready when the surface is known, the target files were read, the loaded resources match the active surface, non-trivial work carries a baseline and a blast-radius note and the change is the smallest correct implementation of the stated requirement.\n125: \n126: ---\n127: \n128: ## 5. RELATED RESOURCES\n129: \n130: - [workflow-debug.md](./workflow-debug.md) - the repair phase that takes over when a symptom appears.\n131: - [workflow-verify.md](./workflow-verify.md) - the evidence phase, the Iron Law and the baseline shape this phase records.\n132: - [phase-detection.md](../../shared/references/phase-detection.md) - how a request maps to this phase and what each phase hands on.\n133: - [code-quality-standards.md](../../shared/references/universal/code-quality-standards.md) - the Design Restraint Ladder and the P0 items it never cuts.","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.opencode/skills/sk-code/shared/references/workflow-implement.md, lines 1-133\n1: ---\n2: title: Workflow Reference - Implementation\n3: description: Shared sk-code doctrine for the mutating build phase, from research before a change to the handoff into quality and verification.\n4: trigger_phrases:\n5:   - \"sk-code implementation workflow\"\n6:   - \"implement workflow doctrine\"\n7:   - \"mutating build workflow\"\n8:   - \"surface implementation standards\"\n9: importance_tier: important\n10: contextType: general\n11: version: 2.1.6.0\n12: ---\n13: \n14: # Workflow Reference - Implementation\n15: \n16: Open this when you are about to change behavior and need to know how much to read before the first edit.\n17: \n18: ---\n19: \n20: ## 1. OVERVIEW\n21: \n22: ### Purpose\n23: \n24: Implementation is the one lifecycle phase that builds new behavior. It reads before it writes, lands the smallest correct edit and hands the result on with the facts later phases need. It takes the active surface from the shared router and loads only that surface's resources.\n25: \n26: ### When to Use\n27: \n28: - Writing, modifying, refactoring or building code in the active surface.\n29: - Implementing a feature, script, component, module, fallback, parameter, authoring packet or runtime behavior.\n30: - Researching unfamiliar, risky, config-sensitive, security-sensitive or multi-file code before changing it.\n31: - Applying surface authoring patterns once the shared router has resolved the surface.\n32: - Using a library or framework overlay as peer reference after surface detection, never as a replacement for surface standards.\n33: \n34: ### When Not to Use\n35: \n36: - A concrete failing symptom dominates the task. Use [debugging](./workflow-debug.md).\n37: - The code is written and needs author-side P0/P1/P2 checks, comment hygiene or surface checklists. Use the `sk-code-quality` mode, which runs `quality-gate.cjs` first.\n38: - The task is final non-mutating evidence. Use [verification](./workflow-verify.md).\n39: - The user wants findings-first review output instead of workspace edits. Use the `sk-code-review` mode.\n40: - The change is documentation-only prose with no executable behavior or routing change.\n41: \n42: ### Core Principle\n43: \n44: Read first, change the least and write the baseline down before the first edit. Debugging and verification can only measure a change against the starting state this phase recorded.\n45: \n46: ---\n47: \n48: ## 2. WORKFLOW\n49: \n50: ### Research\n51: \n52: Research comes before any change to unfamiliar or high-blast code. For a small local edit it can be brief, but it always includes reading the target file.\n53: \n54: 1. Read every target file in this session before editing it.\n55: 2. List every place the change must reach (callers, tests, fixtures, config and exports). Read them, with nearby conventions and existing examples, before introducing a new shape.\n56: 3. Use the surface the shared router resolved ([stack-detection.md](../../shared/references/stack-detection.md)). Never re-detect or override it inside this phase.\n57: 4. Load the smallest active-surface resource set that covers the intent and the changed file types.\n58: 5. For broad or risky work, run a bounded read-only research sweep before editing.\n59: 6. When design or other upstream guidance handed off locked values, constraints or risks, keep them as given instead of redesigning the task.\n60: \n61: ### Pre-Write Restraint\n62: \n63: Before the first edit of non-trivial work, record two facts:\n64: \n65: | Field | Content |\n66: | --- | --- |\n67: | Baseline | The starting state, in the shape of the Baseline row in the verification [Baseline And Delta](./workflow-verify.md#baseline-and-delta) table. Write `UNKNOWN` when no safe baseline exists, because verification then has to settle for a narrower claim. |\n68: | Blast Radius | One phrase, such as `low-blast, reversible`, `medium-blast: multi-file behavior` or `high-blast: touches auth/data/filesystem/config`. |\n69: \n70: Then walk the [Design Restraint Ladder](../../shared/references/universal/code-quality-standards.md#design-restraint-ladder-pre-write) and stop at the first rung that holds. The ladder never cuts a P0 item or anything the user asked for. When requested scope looks unnecessary or risky, implement the requirement and raise a scope-amendment recommendation in the same response. Never cut scope silently. The restraint floor belongs to `.skilled/repo-rules/prevent-overengineering.md` sections 1 and 2 and the Restraint Signals table in `AGENTS.md` section 3.\n71: \n72: ### Write\n73: \n74: 1. Write the smallest correct change that meets the request and the active-surface standards.\n75: 2. Keep the project's existing conventions unless the request changes them.\n76: 3. Stay inside the user's scope and the established documentation scope.\n77: 4. Keep comments durable and explanatory. Never add artifact labels or temporary process markers, because they go stale the moment the work that named them closes.\n78: 5. Keep routing metadata, config shapes, generated-metadata ownership and packet boundaries intact when authoring system assets.\n79: 6. Prepare the handoff: changed scope, baseline, likely checks and accepted residual risks.\n80: \n81: ### OpenCode Implementation Guardrails\n82: \n83: For system code under `.skilled/` (the `sk-code-skilled` surface), also apply the [implementation guardrails](../../sk-code-skilled/references/shared/workflow-guardrails.md#2-implementation-guardrails).\n84: \n85: ---\n86: \n87: ## 3. DISCIPLINE\n88: \n89: ### Always\n90: \n91: - Always read a target file before editing it, including skeletons and existing README or contract files.\n92: - Always use the surface identity the shared router resolved before loading implementation resources.\n93: - Always pick the active-surface language or file-type guidance before applying standards.\n94: - Always load authoring checklists at write time when the active surface requires them.\n95: - Always record a baseline and a one-phrase blast-radius read for non-trivial work.\n96: - Always build the simplest correct implementation of the stated requirement.\n97: - Always hand off to quality and verification explicitly once the code is written.\n98: \n99: ### Never\n100: \n101: - Never claim completion from implementation alone. The [Iron Law](./workflow-verify.md#iron-law) gates every completion claim.\n102: - Never treat an unsupported or ambiguous surface as supported.\n103: - Never apply one surface's standards to another surface's runtime behavior.\n104: - Never narrow requested scope silently because part of it looks unnecessary.\n105: - Never add packet-local advisor metadata when the parent owns the identity.\n106: - Never paste whole reference documents into the workflow. Link or load the focused reference instead.\n107: \n108: ### Escalate If\n109: \n110: - Surface identity stays ambiguous after the shared-router inputs are read.\n111: - Implementation evidence conflicts with the approved spec or a user instruction.\n112: - The verification command set is unknown and the user expects a completion claim.\n113: - Security-sensitive, filesystem, credential, destructive or production-data behavior is unclear.\n114: \n115: ---\n116: \n117: ## 4. HANDOFF BOUNDARIES\n118: \n119: - Quality (`sk-code-quality`) receives the change for author-side checks, comment hygiene and active-surface checklists. The mode runs `quality-gate.cjs` first and loads every checklist its verdict lists.\n120: - [Debugging](./workflow-debug.md) receives failing checks or runtime symptoms and traces one root cause at a time.\n121: - [Verification](./workflow-verify.md) receives the final changed state, the baseline, the commands to run and the exact claim to prove.\n122: - Review (`sk-code-review`) owns findings-first critique when the user asks for severity-ranked risks instead of edits.\n123: \n124: The handoff is ready when the surface is known, the target files were read, the loaded resources match the active surface, non-trivial work carries a baseline and a blast-radius note and the change is the smallest correct implementation of the stated requirement.\n125: \n126: ---\n127: \n128: ## 5. RELATED RESOURCES\n129: \n130: - [workflow-debug.md](./workflow-debug.md) - the repair phase that takes over when a symptom appears.\n131: - [workflow-verify.md](./workflow-verify.md) - the evidence phase, the Iron Law and the baseline shape this phase records.\n132: - [phase-detection.md](../../shared/references/phase-detection.md) - how a request maps to this phase and what each phase hands on.\n133: - [code-quality-standards.md](../../shared/references/universal/code-quality-standards.md) - the Design Restraint Ladder and the P0 items it never cuts."}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.opencode/skills/sk-code/shared/references/workflow-implement.md\"}"},"time":{"start":1794527521776,"end":1794527522505}}}}
{"type":"tool_use","timestamp":1794527522508,"sessionID":"ses_e2dd82e01ffeqmnJRIxBdI7fut","part":{"partID":"prt_1d22ced5e001w00oStIpasSiJj","sessionID":"ses_e2dd82e01ffeqmnJRIxBdI7fut","messageID":"msg_1d22b6c870018KGmIaLGIFV4jk","type":"tool","id":"call_513f213e4ba747c18ad9d88f","tool":"read","state":{"status":"completed","input":{"path":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.opencode/skills/sk-code/sk-code-skilled/references/javascript/style-guide.md"},"output":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.opencode/skills/sk-code/sk-code-skilled/references/javascript/style-guide.md, lines 1-467\n1: ---\n2: title: JavaScript Style Guide\n3: description: Formatting standards and naming conventions for JavaScript files in the OpenCode development environment.\n4: trigger_phrases:\n5:   - \"opencode javascript style guide\"\n6:   - \"javascript file header format\"\n7:   - \"use strict directive\"\n8:   - \"javascript section organization\"\n9: importance_tier: normal\n10: contextType: implementation\n11: version: 1.0.4.0\n12: ---\n13: \n14: # JavaScript Style Guide\n15: \n16: Open this when you are drafting or reviewing a JavaScript file and need the header, section order, naming rule or formatting detail that settles the point.\n17: \n18: ---\n19: \n20: ## 1. OVERVIEW\n21: \n22: ### Purpose\n23: \n24: Defines consistent styling rules for JavaScript files to ensure readability, maintainability, and alignment across all OpenCode JavaScript code.\n25: \n26: ### When to Use\n27: \n28: Use when writing, reviewing, or resolving style questions for JavaScript files.\n29: \n30: ### Use Cases\n31: \n32: - Writing new JavaScript files\n33: - Reviewing JavaScript code for consistency\n34: - Resolving style disagreements in code review\n35: \n36: ---\n37: \n38: ## 2. FILE HEADER FORMAT\n39: \n40: All JavaScript files MUST begin with a module header identifying the module,\n41: using the divider form below. Module syntax follows the nearest package\n42: boundary and loader contract: `.cjs` is CommonJS, `.mjs` is ESM, and `.js`\n43: follows the nearest package's `type`. OpenCode plugin paths use their ESM\n44: loader contract.\n45: \n46: ### Template\n47: \n48: ```javascript\n49: // ───────────────────────────────────────────────────────────────────\n50: // MODULE: [Module Name]\n51: // ───────────────────────────────────────────────────────────────────\n52: ```\n53: \n54: ### Requirements\n55: \n56: - Divider width: 67 box-drawing characters after `// `\n57: - Module name: after `MODULE:` on the middle line\n58: - A shebang line may precede the header in an executable script\n59: - Immediately followed by `'use strict';` for `.js/.cjs` files, as required by\n60:   this repository's alignment checks; it is redundant in ESM `.js` files\n61: - `.mjs` files do not require `'use strict'`; ESM `.js` plugin files follow the\n62:   `.js` requirement above\n63: - The older 78-character `╔═╗` box is accepted where it already exists; do not\n64:   introduce it in new files\n65: \n66: **Evidence**: `.skilled/skills/system-spec-kit/runtime/cli/lib/dist-freshness.cjs:1-4`,\n67: `.skilled/skills/system-spec-kit/runtime/cli/retrieval/generate-trigger-index.mjs:1-4`\n68: \n69: ---\n70: \n71: ## 3. USE STRICT DIRECTIVE\n72: \n73: Every `.js` and `.cjs` JavaScript file MUST include the strict mode directive.\n74: This repository convention also applies to ESM `.js` files, where it is\n75: redundant because modules are strict by definition. Do not add it to `.mjs`\n76: files; the alignment verifier intentionally skips `.mjs` enforcement.\n77: \n78: ```javascript\n79: 'use strict';\n80: ```\n81: \n82: **Placement**: Immediately after file header, before any other code.\n83: \n84: **Evidence**: `verify_alignment_drift.py` skips `.mjs`; CommonJS-style JS\n85: helpers still use `'use strict'`.\n86: \n87: ---\n88: \n89: ## 4. SECTION ORGANIZATION\n90: \n91: Large files are organized using numbered section dividers.\n92: \n93: ### Section Divider Template\n94: \n95: ```javascript\n96: // ─────────────────────────────────────────────────────────────────────────────\n97: // 1. [SECTION NAME]\n98: // ─────────────────────────────────────────────────────────────────────────────\n99: ```\n100: \n101: ### Standard Section Order\n102: \n103: | Order | Section Name     | Purpose                           |\n104: |-------|------------------|-----------------------------------|\n105: | 1     | IMPORTS          | Module dependencies               |\n106: | 2     | CONSTANTS        | Configuration values, magic numbers |\n107: | 3     | HELPERS          | Internal utility functions        |\n108: | 4     | CORE LOGIC       | Main implementation               |\n109: | 5     | EXPORTS          | Module public interface           |\n110: \n111: **Evidence**: `.skilled/skills/system-spec-kit/runtime/cli/core/config.ts`\n112: \n113: ---\n114: \n115: ## 5. NAMING CONVENTIONS\n116: \n117: ### Function Names\n118: \n119: **Style**: `camelCase`\n120: \n121: ```javascript\n122: // CORRECT\n123: function loadConfig(path) { }\n124: function memorySearch(query, options) { }\n125: function validateInput(data) { }\n126: \n127: // INCORRECT\n128: function load_config(path) { }     // snake_case\n129: function LoadConfig(path) { }      // PascalCase\n130: function load-config(path) { }     // kebab-case (invalid syntax)\n131: ```\n132: \n133: **Evidence**: MDN Web Docs, Airbnb Style Guide, Node.js core APIs\n134: \n135: ### Constant Names\n136: \n137: **Style**: `UPPER_SNAKE_CASE`\n138: \n139: ```javascript\n140: // CORRECT\n141: const MAX_RETRIES = 3;\n142: const DEFAULT_TIMEOUT = 5000;\n143: const SQLITE_BUSY_TIMEOUT = 30000;\n144: \n145: // INCORRECT\n146: const maxRetries = 3;       // camelCase\n147: const max_retries = 3;      // snake_case (reserved for variables)\n148: ```\n149: \n150: **Evidence**: `.skilled/skills/system-spec-kit/runtime/core/config.ts`\n151: \n152: ### Class Names\n153: \n154: **Style**: `PascalCase`\n155: \n156: ```javascript\n157: // CORRECT\n158: class SpecFolderError extends Error { }\n159: class ConfigLoader { }\n160: class TriggerIndex { }\n161: \n162: // INCORRECT\n163: class specFolderError { }   // camelCase\n164: class spec_folder_error { } // snake_case\n165: ```\n166: \n167: **Evidence**: `.skilled/skills/system-spec-kit/runtime/lib/config/spec-doc-paths.ts`\n168: \n169: ### Variable Names\n170: \n171: | Scope        | Style        | Example                          |\n172: |--------------|--------------|----------------------------------|\n173: | Local        | `camelCase`  | `const searchResults = []`       |\n174: | Module-level | `camelCase`  | `const dbPath = '...'`           |\n175: | Parameters   | `camelCase`  | `function search(query, maxResults)` |\n176: \n177: ### Boolean Names\n178: \n179: **Style**: `camelCase` with `is`/`has`/`can`/`should` prefix\n180: \n181: ```javascript\n182: // CORRECT\n183: const isValid = true;\n184: const hasResults = items.length > 0;\n185: const canProceed = !isBlocked;\n186: const shouldRetry = attempts < MAX_RETRIES;\n187: \n188: // INCORRECT\n189: const is_valid = true;       // snake_case\n190: const valid = true;          // ambiguous\n191: ```\n192: \n193: ### Naming Summary Table\n194: \n195: | Element          | Convention         | Example                |\n196: |------------------|--------------------|------------------------|\n197: | Functions        | `camelCase`        | `loadConfig`           |\n198: | Constants        | `UPPER_SNAKE_CASE` | `MAX_RETRIES`          |\n199: | Classes          | `PascalCase`       | `MemoryError`          |\n200: | Local variables  | `camelCase`        | `searchResults`        |\n201: | Module variables | `camelCase`        | `dbConnection`         |\n202: | Parameters       | `camelCase`        | `queryText`            |\n203: | Booleans         | `is`/`has`/`can`   | `isValid`, `hasItems`  |\n204: \n205: ---\n206: \n207: ## 6. FORMATTING RULES\n208: \n209: ### Indentation\n210: \n211: - **Size**: 2 spaces\n212: - **Tabs**: Never use tabs\n213: \n214: ```javascript\n215: // CORRECT (2 spaces)\n216: function example() {\n217:   if (condition) {\n218:     return value;\n219:   }\n220: }\n221: \n222: // INCORRECT (4 spaces or tabs)\n223: function example() {\n224:     if (condition) {\n225:         return value;\n226:     }\n227: }\n228: ```\n229: \n230: ### Braces\n231: \n232: **Style**: K&R (opening brace on same line)\n233: \n234: ```javascript\n235: // CORRECT (K&R style)\n236: if (condition) {\n237:   // code\n238: } else {\n239:   // code\n240: }\n241: \n242: function example() {\n243:   // code\n244: }\n245: \n246: // INCORRECT (Allman style)\n247: if (condition)\n248: {\n249:   // code\n250: }\n251: ```\n252: \n253: ### Semicolons\n254: \n255: **Rule**: Always use semicolons\n256: \n257: ```javascript\n258: // CORRECT\n259: const value = 42;\n260: return result;\n261: \n262: // INCORRECT (ASI-dependent)\n263: const value = 42\n264: return result\n265: ```\n266: \n267: ### Quotes\n268: \n269: **Rule**: Single quotes for strings\n270: \n271: ```javascript\n272: // CORRECT\n273: const message = 'Hello world';\n274: const template = `Value: ${value}`;  // Template literals OK\n275: \n276: // INCORRECT\n277: const message = \"Hello world\";  // Double quotes\n278: ```\n279: \n280: ### Line Length\n281: \n282: - **Soft limit**: roughly 100 to 120 characters, per the shared formatting rule\n283: - **Preferred**: 80 characters\n284: - **Exception**: URLs and long strings\n285: \n286: ---\n287: \n288: ## 7. COMMENTING RULES\n289: \n290: ### Principles\n291: \n292: 1. **Quantity limit (Skilled surface setting):** Maximum 3 comments per 10 lines of code, this surface's budget for the shared comment-density rule (see [naming and commenting](../shared/universal-patterns/naming-and-commenting.md))\n293: 2. **Focus on purposeful semantics:** Explain WHY something is done, not WHAT it does\n294: 3. **Focus on WHY, not WHAT:** Explain intent, constraints, reasoning\n295: 4. **No commented-out code:** Delete unused code (git preserves history)\n296: \n297: ### Comment Examples\n298: \n299: Use plain comments that explain reasoning:\n300: \n301: - `// Reasoning for non-obvious choice`\n302: - `// Precondition/invariant check`\n303: - `// State that must always hold`\n304: - `// SEC: security note tied to a stable standard (CWE-###)`\n305: - `// Safety, performance, or reliability constraint`\n306: \n307: ### Capitalization\n308: \n309: All comment text MUST start with a capital letter:\n310: \n311: ```javascript\n312: // Reverse order preserves dependency chain     // correct\n313: // reverse order preserves dependency chain     // wrong\n314: ```\n315: \n316: **Exceptions**: `eslint-disable` directives, `@ts-` annotations, and inline code references.\n317: \n318: ### Reference Comments\n319: \n320: Use a bracketed module prefix for inline comments:\n321: \n322: ```javascript\n323: // [module-name] Description of what this does\n324: ```\n325: \n326: Cite only durable references, never a spec-folder-internal id. Comments must not embed a spec folder/number, task/checklist/requirement id (`T###`, `CHK-###`, `REQ-###`), feature-catalog entry, ADR id, or ticket id; see [`../shared/universal-patterns/naming-and-commenting.md`](../shared/universal-patterns/naming-and-commenting.md) §4 and [`../../../sk-code-quality/references/code-style-guide.md`](../../../sk-code-quality/references/code-style-guide.md) §4 \"No ephemeral-artifact pointers\".\n327: \n328: ```javascript\n329: // GOOD — durable WHY, no ephemeral id\n330: // Causal Memory Graph handlers: drift-why, causal-link, causal-stats, causal-unlink\n331: // Recover pending writes on startup so a crash cannot lose data\n332: // SEC: sanitize input to prevent stored XSS (CWE-79)\n333: ```\n334: \n335: ### Function Purpose Comments\n336: \n337: Single line above function describing intent:\n338: \n339: ```javascript\n340: // Load configuration from YAML file, merging with defaults\n341: // Returns validated config object or throws on invalid schema\n342: function loadConfig(configPath) { }\n343: \n344: // Calculate weighted memory score using decay function\n345: // Higher scores indicate more recent and relevant memories\n346: function calculateMemoryScore(memory, currentTime) { }\n347: ```\n348: \n349: ### Inline Comments (WHY, Not WHAT)\n350: \n351: **Good examples (explain reasoning):**\n352: \n353: ```javascript\n354: // Skip if already initialized to prevent double-binding\n355: if (window[INIT_FLAG]) return;\n356: \n357: // Sort by recency so newest memories surface first\n358: results.sort((a, b) => b.timestamp - a.timestamp);\n359: \n360: // Add timeout to prevent hang on unresponsive database\n361: const timeout = new Promise((_, reject) =>\n362:   setTimeout(() => reject(new Error('Timeout')), 30000)\n363: );\n364: \n365: // Close DB connection on all control paths\n366: try {\n367:   await processBatch(items);\n368: } finally {\n369:   db.close();\n370: }\n371: ```\n372: \n373: **Bad examples (narrate implementation):**\n374: \n375: ```javascript\n376: // Set the value to 42\n377: const value = 42;\n378: \n379: // Loop through items\n380: for (const item of items) { }\n381: \n382: // Check if result exists\n383: if (result) { }\n384: \n385: // Add item to array\n386: items.push(item);\n387: ```\n388: \n389: ### Debug Logging Pattern\n390: \n391: ```javascript\n392: // Conditional logging for debug mode\n393: const DEBUG = false;\n394: const LOG_PREFIX = '[ModuleName]';\n395: \n396: function log(...args) {\n397:   if (DEBUG) {\n398:     console.log(LOG_PREFIX, ...args);\n399:   }\n400: }\n401: \n402: // Usage\n403: log('Initialized with config:', config);\n404: log('Processing batch:', batch.length, 'items');\n405: ```\n406: \n407: ### JSDoc Comments\n408: \n409: Required for all exported functions. See `quality-standards.md` for full JSDoc format.\n410: \n411: ```javascript\n412: /**\n413:  * Brief description of function purpose.\n414:  *\n415:  * @param {string} query - Search query text\n416:  * @param {Object} options - Search options\n417:  * @param {number} options.limit - Maximum results to return\n418:  * @returns {Array} Array of search results\n419:  */\n420: function search(query, options = {}) {\n421:   // implementation\n422: }\n423: ```\n424: \n425: ### TODO Comments\n426: \n427: Format for tracking incomplete work.\n428: \n429: ```javascript\n430: // TODO: [description of work needed]\n431: // FIXME: [description of bug to fix]\n432: ```\n433: \n434: ---\n435: \n436: ## 8. IMPORT ORDER\n437: \n438: Organize imports in three groups with blank lines between.\n439: \n440: ```javascript\n441: 'use strict';\n442: \n443: // ─────────────────────────────────────────────────────────────────────────────\n444: // 1. IMPORTS\n445: // ─────────────────────────────────────────────────────────────────────────────\n446: \n447: // Node.js built-ins\n448: const fs = require('fs');\n449: const path = require('path');\n450: \n451: // Third-party modules\n452: const yaml = require('js-yaml');\n453: const sqlite = require('better-sqlite3');\n454: \n455: // Local modules\n456: const { loadConfig } = require('./config');\n457: const logger = require('../utils/logger');\n458: ```\n459: \n460: **Evidence**: `mcp-server/lib/search/folder-discovery.ts:1-26`\n461: \n462: ---\n463: \n464: ## 9. RELATED RESOURCES\n465: \n466: - [quality-standards.md](quality-standards/overview-modules-and-docs.md) - Error handling, JSDoc, security patterns\n467: - [quick-reference.md](./quick-reference.md) - Copy-paste templates and cheat sheets","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.opencode/skills/sk-code/sk-code-skilled/references/javascript/style-guide.md, lines 1-467\n1: ---\n2: title: JavaScript Style Guide\n3: description: Formatting standards and naming conventions for JavaScript files in the OpenCode development environment.\n4: trigger_phrases:\n5:   - \"opencode javascript style guide\"\n6:   - \"javascript file header format\"\n7:   - \"use strict directive\"\n8:   - \"javascript section organization\"\n9: importance_tier: normal\n10: contextType: implementation\n11: version: 1.0.4.0\n12: ---\n13: \n14: # JavaScript Style Guide\n15: \n16: Open this when you are drafting or reviewing a JavaScript file and need the header, section order, naming rule or formatting detail that settles the point.\n17: \n18: ---\n19: \n20: ## 1. OVERVIEW\n21: \n22: ### Purpose\n23: \n24: Defines consistent styling rules for JavaScript files to ensure readability, maintainability, and alignment across all OpenCode JavaScript code.\n25: \n26: ### When to Use\n27: \n28: Use when writing, reviewing, or resolving style questions for JavaScript files.\n29: \n30: ### Use Cases\n31: \n32: - Writing new JavaScript files\n33: - Reviewing JavaScript code for consistency\n34: - Resolving style disagreements in code review\n35: \n36: ---\n37: \n38: ## 2. FILE HEADER FORMAT\n39: \n40: All JavaScript files MUST begin with a module header identifying the module,\n41: using the divider form below. Module syntax follows the nearest package\n42: boundary and loader contract: `.cjs` is CommonJS, `.mjs` is ESM, and `.js`\n43: follows the nearest package's `type`. OpenCode plugin paths use their ESM\n44: loader contract.\n45: \n46: ### Template\n47: \n48: ```javascript\n49: // ───────────────────────────────────────────────────────────────────\n50: // MODULE: [Module Name]\n51: // ───────────────────────────────────────────────────────────────────\n52: ```\n53: \n54: ### Requirements\n55: \n56: - Divider width: 67 box-drawing characters after `// `\n57: - Module name: after `MODULE:` on the middle line\n58: - A shebang line may precede the header in an executable script\n59: - Immediately followed by `'use strict';` for `.js/.cjs` files, as required by\n60:   this repository's alignment checks; it is redundant in ESM `.js` files\n61: - `.mjs` files do not require `'use strict'`; ESM `.js` plugin files follow the\n62:   `.js` requirement above\n63: - The older 78-character `╔═╗` box is accepted where it already exists; do not\n64:   introduce it in new files\n65: \n66: **Evidence**: `.skilled/skills/system-spec-kit/runtime/cli/lib/dist-freshness.cjs:1-4`,\n67: `.skilled/skills/system-spec-kit/runtime/cli/retrieval/generate-trigger-index.mjs:1-4`\n68: \n69: ---\n70: \n71: ## 3. USE STRICT DIRECTIVE\n72: \n73: Every `.js` and `.cjs` JavaScript file MUST include the strict mode directive.\n74: This repository convention also applies to ESM `.js` files, where it is\n75: redundant because modules are strict by definition. Do not add it to `.mjs`\n76: files; the alignment verifier intentionally skips `.mjs` enforcement.\n77: \n78: ```javascript\n79: 'use strict';\n80: ```\n81: \n82: **Placement**: Immediately after file header, before any other code.\n83: \n84: **Evidence**: `verify_alignment_drift.py` skips `.mjs`; CommonJS-style JS\n85: helpers still use `'use strict'`.\n86: \n87: ---\n88: \n89: ## 4. SECTION ORGANIZATION\n90: \n91: Large files are organized using numbered section dividers.\n92: \n93: ### Section Divider Template\n94: \n95: ```javascript\n96: // ─────────────────────────────────────────────────────────────────────────────\n97: // 1. [SECTION NAME]\n98: // ─────────────────────────────────────────────────────────────────────────────\n99: ```\n100: \n101: ### Standard Section Order\n102: \n103: | Order | Section Name     | Purpose                           |\n104: |-------|------------------|-----------------------------------|\n105: | 1     | IMPORTS          | Module dependencies               |\n106: | 2     | CONSTANTS        | Configuration values, magic numbers |\n107: | 3     | HELPERS          | Internal utility functions        |\n108: | 4     | CORE LOGIC       | Main implementation               |\n109: | 5     | EXPORTS          | Module public interface           |\n110: \n111: **Evidence**: `.skilled/skills/system-spec-kit/runtime/cli/core/config.ts`\n112: \n113: ---\n114: \n115: ## 5. NAMING CONVENTIONS\n116: \n117: ### Function Names\n118: \n119: **Style**: `camelCase`\n120: \n121: ```javascript\n122: // CORRECT\n123: function loadConfig(path) { }\n124: function memorySearch(query, options) { }\n125: function validateInput(data) { }\n126: \n127: // INCORRECT\n128: function load_config(path) { }     // snake_case\n129: function LoadConfig(path) { }      // PascalCase\n130: function load-config(path) { }     // kebab-case (invalid syntax)\n131: ```\n132: \n133: **Evidence**: MDN Web Docs, Airbnb Style Guide, Node.js core APIs\n134: \n135: ### Constant Names\n136: \n137: **Style**: `UPPER_SNAKE_CASE`\n138: \n139: ```javascript\n140: // CORRECT\n141: const MAX_RETRIES = 3;\n142: const DEFAULT_TIMEOUT = 5000;\n143: const SQLITE_BUSY_TIMEOUT = 30000;\n144: \n145: // INCORRECT\n146: const maxRetries = 3;       // camelCase\n147: const max_retries = 3;      // snake_case (reserved for variables)\n148: ```\n149: \n150: **Evidence**: `.skilled/skills/system-spec-kit/runtime/core/config.ts`\n151: \n152: ### Class Names\n153: \n154: **Style**: `PascalCase`\n155: \n156: ```javascript\n157: // CORRECT\n158: class SpecFolderError extends Error { }\n159: class ConfigLoader { }\n160: class TriggerIndex { }\n161: \n162: // INCORRECT\n163: class specFolderError { }   // camelCase\n164: class spec_folder_error { } // snake_case\n165: ```\n166: \n167: **Evidence**: `.skilled/skills/system-spec-kit/runtime/lib/config/spec-doc-paths.ts`\n168: \n169: ### Variable Names\n170: \n171: | Scope        | Style        | Example                          |\n172: |--------------|--------------|----------------------------------|\n173: | Local        | `camelCase`  | `const searchResults = []`       |\n174: | Module-level | `camelCase`  | `const dbPath = '...'`           |\n175: | Parameters   | `camelCase`  | `function search(query, maxResults)` |\n176: \n177: ### Boolean Names\n178: \n179: **Style**: `camelCase` with `is`/`has`/`can`/`should` prefix\n180: \n181: ```javascript\n182: // CORRECT\n183: const isValid = true;\n184: const hasResults = items.length > 0;\n185: const canProceed = !isBlocked;\n186: const shouldRetry = attempts < MAX_RETRIES;\n187: \n188: // INCORRECT\n189: const is_valid = true;       // snake_case\n190: const valid = true;          // ambiguous\n191: ```\n192: \n193: ### Naming Summary Table\n194: \n195: | Element          | Convention         | Example                |\n196: |------------------|--------------------|------------------------|\n197: | Functions        | `camelCase`        | `loadConfig`           |\n198: | Constants        | `UPPER_SNAKE_CASE` | `MAX_RETRIES`          |\n199: | Classes          | `PascalCase`       | `MemoryError`          |\n200: | Local variables  | `camelCase`        | `searchResults`        |\n201: | Module variables | `camelCase`        | `dbConnection`         |\n202: | Parameters       | `camelCase`        | `queryText`            |\n203: | Booleans         | `is`/`has`/`can`   | `isValid`, `hasItems`  |\n204: \n205: ---\n206: \n207: ## 6. FORMATTING RULES\n208: \n209: ### Indentation\n210: \n211: - **Size**: 2 spaces\n212: - **Tabs**: Never use tabs\n213: \n214: ```javascript\n215: // CORRECT (2 spaces)\n216: function example() {\n217:   if (condition) {\n218:     return value;\n219:   }\n220: }\n221: \n222: // INCORRECT (4 spaces or tabs)\n223: function example() {\n224:     if (condition) {\n225:         return value;\n226:     }\n227: }\n228: ```\n229: \n230: ### Braces\n231: \n232: **Style**: K&R (opening brace on same line)\n233: \n234: ```javascript\n235: // CORRECT (K&R style)\n236: if (condition) {\n237:   // code\n238: } else {\n239:   // code\n240: }\n241: \n242: function example() {\n243:   // code\n244: }\n245: \n246: // INCORRECT (Allman style)\n247: if (condition)\n248: {\n249:   // code\n250: }\n251: ```\n252: \n253: ### Semicolons\n254: \n255: **Rule**: Always use semicolons\n256: \n257: ```javascript\n258: // CORRECT\n259: const value = 42;\n260: return result;\n261: \n262: // INCORRECT (ASI-dependent)\n263: const value = 42\n264: return result\n265: ```\n266: \n267: ### Quotes\n268: \n269: **Rule**: Single quotes for strings\n270: \n271: ```javascript\n272: // CORRECT\n273: const message = 'Hello world';\n274: const template = `Value: ${value}`;  // Template literals OK\n275: \n276: // INCORRECT\n277: const message = \"Hello world\";  // Double quotes\n278: ```\n279: \n280: ### Line Length\n281: \n282: - **Soft limit**: roughly 100 to 120 characters, per the shared formatting rule\n283: - **Preferred**: 80 characters\n284: - **Exception**: URLs and long strings\n285: \n286: ---\n287: \n288: ## 7. COMMENTING RULES\n289: \n290: ### Principles\n291: \n292: 1. **Quantity limit (Skilled surface setting):** Maximum 3 comments per 10 lines of code, this surface's budget for the shared comment-density rule (see [naming and commenting](../shared/universal-patterns/naming-and-commenting.md))\n293: 2. **Focus on purposeful semantics:** Explain WHY something is done, not WHAT it does\n294: 3. **Focus on WHY, not WHAT:** Explain intent, constraints, reasoning\n295: 4. **No commented-out code:** Delete unused code (git preserves history)\n296: \n297: ### Comment Examples\n298: \n299: Use plain comments that explain reasoning:\n300: \n301: - `// Reasoning for non-obvious choice`\n302: - `// Precondition/invariant check`\n303: - `// State that must always hold`\n304: - `// SEC: security note tied to a stable standard (CWE-###)`\n305: - `// Safety, performance, or reliability constraint`\n306: \n307: ### Capitalization\n308: \n309: All comment text MUST start with a capital letter:\n310: \n311: ```javascript\n312: // Reverse order preserves dependency chain     // correct\n313: // reverse order preserves dependency chain     // wrong\n314: ```\n315: \n316: **Exceptions**: `eslint-disable` directives, `@ts-` annotations, and inline code references.\n317: \n318: ### Reference Comments\n319: \n320: Use a bracketed module prefix for inline comments:\n321: \n322: ```javascript\n323: // [module-name] Description of what this does\n324: ```\n325: \n326: Cite only durable references, never a spec-folder-internal id. Comments must not embed a spec folder/number, task/checklist/requirement id (`T###`, `CHK-###`, `REQ-###`), feature-catalog entry, ADR id, or ticket id; see [`../shared/universal-patterns/naming-and-commenting.md`](../shared/universal-patterns/naming-and-commenting.md) §4 and [`../../../sk-code-quality/references/code-style-guide.md`](../../../sk-code-quality/references/code-style-guide.md) §4 \"No ephemeral-artifact pointers\".\n327: \n328: ```javascript\n329: // GOOD — durable WHY, no ephemeral id\n330: // Causal Memory Graph handlers: drift-why, causal-link, causal-stats, causal-unlink\n331: // Recover pending writes on startup so a crash cannot lose data\n332: // SEC: sanitize input to prevent stored XSS (CWE-79)\n333: ```\n334: \n335: ### Function Purpose Comments\n336: \n337: Single line above function describing intent:\n338: \n339: ```javascript\n340: // Load configuration from YAML file, merging with defaults\n341: // Returns validated config object or throws on invalid schema\n342: function loadConfig(configPath) { }\n343: \n344: // Calculate weighted memory score using decay function\n345: // Higher scores indicate more recent and relevant memories\n346: function calculateMemoryScore(memory, currentTime) { }\n347: ```\n348: \n349: ### Inline Comments (WHY, Not WHAT)\n350: \n351: **Good examples (explain reasoning):**\n352: \n353: ```javascript\n354: // Skip if already initialized to prevent double-binding\n355: if (window[INIT_FLAG]) return;\n356: \n357: // Sort by recency so newest memories surface first\n358: results.sort((a, b) => b.timestamp - a.timestamp);\n359: \n360: // Add timeout to prevent hang on unresponsive database\n361: const timeout = new Promise((_, reject) =>\n362:   setTimeout(() => reject(new Error('Timeout')), 30000)\n363: );\n364: \n365: // Close DB connection on all control paths\n366: try {\n367:   await processBatch(items);\n368: } finally {\n369:   db.close();\n370: }\n371: ```\n372: \n373: **Bad examples (narrate implementation):**\n374: \n375: ```javascript\n376: // Set the value to 42\n377: const value = 42;\n378: \n379: // Loop through items\n380: for (const item of items) { }\n381: \n382: // Check if result exists\n383: if (result) { }\n384: \n385: // Add item to array\n386: items.push(item);\n387: ```\n388: \n389: ### Debug Logging Pattern\n390: \n391: ```javascript\n392: // Conditional logging for debug mode\n393: const DEBUG = false;\n394: const LOG_PREFIX = '[ModuleName]';\n395: \n396: function log(...args) {\n397:   if (DEBUG) {\n398:     console.log(LOG_PREFIX, ...args);\n399:   }\n400: }\n401: \n402: // Usage\n403: log('Initialized with config:', config);\n404: log('Processing batch:', batch.length, 'items');\n405: ```\n406: \n407: ### JSDoc Comments\n408: \n409: Required for all exported functions. See `quality-standards.md` for full JSDoc format.\n410: \n411: ```javascript\n412: /**\n413:  * Brief description of function purpose.\n414:  *\n415:  * @param {string} query - Search query text\n416:  * @param {Object} options - Search options\n417:  * @param {number} options.limit - Maximum results to return\n418:  * @returns {Array} Array of search results\n419:  */\n420: function search(query, options = {}) {\n421:   // implementation\n422: }\n423: ```\n424: \n425: ### TODO Comments\n426: \n427: Format for tracking incomplete work.\n428: \n429: ```javascript\n430: // TODO: [description of work needed]\n431: // FIXME: [description of bug to fix]\n432: ```\n433: \n434: ---\n435: \n436: ## 8. IMPORT ORDER\n437: \n438: Organize imports in three groups with blank lines between.\n439: \n440: ```javascript\n441: 'use strict';\n442: \n443: // ─────────────────────────────────────────────────────────────────────────────\n444: // 1. IMPORTS\n445: // ─────────────────────────────────────────────────────────────────────────────\n446: \n447: // Node.js built-ins\n448: const fs = require('fs');\n449: const path = require('path');\n450: \n451: // Third-party modules\n452: const yaml = require('js-yaml');\n453: const sqlite = require('better-sqlite3');\n454: \n455: // Local modules\n456: const { loadConfig } = require('./config');\n457: const logger = require('../utils/logger');\n458: ```\n459: \n460: **Evidence**: `mcp-server/lib/search/folder-discovery.ts:1-26`\n461: \n462: ---\n463: \n464: ## 9. RELATED RESOURCES\n465: \n466: - [quality-standards.md](quality-standards/overview-modules-and-docs.md) - Error handling, JSDoc, security patterns\n467: - [quick-reference.md](./quick-reference.md) - Copy-paste templates and cheat sheets"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.opencode/skills/sk-code/sk-code-skilled/references/javascript/style-guide.md\"}"},"time":{"start":1794527522142,"end":1794527522508}}}}
