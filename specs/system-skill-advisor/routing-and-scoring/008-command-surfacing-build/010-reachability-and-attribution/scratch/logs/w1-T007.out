AVASCRIPT\": [\n319:         \"sk-code-skilled/references/javascript/style-guide.md\",\n320:         \"sk-code-skilled/references/javascript/quality-standards/overview-modules-and-docs.md\",\n321:         \"sk-code-skilled/references/javascript/quality-standards/security-testing-and-exemptions.md\",\n322:         \"sk-code-skilled/references/javascript/quick-reference.md\",\n323:     ],\n324:     \"TYPESCRIPT\": [\n325:         \"sk-code-skilled/references/typescript/style-guide/overview-strict-and-naming.md\",\n326:         \"sk-code-skilled/references/typescript/style-guide/formatting-imports-and-coexistence.md\",\n327:         \"sk-code-skilled/references/typescript/quality-standards/overview-and-type-system.md\",\n328:         \"sk-code-skilled/references/typescript/quality-standards/tsdoc-errors-and-async.md\",\n329:         \"sk-code-skilled/references/typescript/quality-standards/tsconfig-and-modules.md\",\n330:         \"sk-code-skilled/references/typescript/quick-reference/template-naming-and-types.md\",\n331:         \"sk-code-skilled/references/typescript/quick-reference/imports-errors-and-tsconfig.md\",\n332:     ],\n333:     \"PYTHON\": [\n334:         \"sk-code-skilled/references/python/style-guide.md\",\n335:         \"sk-code-skilled/references/python/quality-standards.md\",\n336:         \"sk-code-skilled/references/python/quick-reference.md\",\n337:     ],\n338:     \"SHELL\": [\n339:         \"sk-code-skilled/references/shell/style-guide/overview-structure-and-naming.md\",\n340:         \"sk-code-skilled/references/shell/style-guide/variables-functions-and-output.md\",\n341:         \"sk-code-skilled/references/shell/quality-standards/overview-and-priority-blockers.md\",\n342:         \"sk-code-skilled/references/shell/quality-standards/validation-security-and-shellcheck.md\",\n343:         \"sk-code-skilled/references/shell/quick-reference/template-variables-and-loops.md\",\n344:         \"sk-code-skilled/references/shell/quick-reference/functions-strings-and-checklist.md\",\n345:     ],\n346:     \"RUST\": [\n347:         \"sk-code-skilled/references/rust/style-guide/overview-and-file-header.md\",\n348:         \"sk-code-skilled/references/rust/style-guide/toolchain-and-project-structure.md\",\n349:         \"sk-code-skilled/references/rust/style-guide/naming-conventions.md\",\n350:         \"sk-code-skilled/references/rust/style-guide/formatting-and-imports.md\",\n351:         \"sk-code-skilled/references/rust/style-guide/commenting-and-rustdoc.md\",\n352:         \"sk-code-skilled/references/rust/style-guide/interop-model.md\",\n353:         \"sk-code-skilled/references/rust/style-guide/interop-errors-and-parity.md\",\n354:         \"sk-code-skilled/references/rust/quality-standards/overview-and-data-ownership.md\",\n355:         \"sk-code-skilled/references/rust/quality-standards/modeling-collections-and-api.md\",\n356:         \"sk-code-skilled/references/rust/quality-standards/docs-errors-and-async.md\",\n357:         \"sk-code-skilled/references/rust/quality-standards/build-and-organization.md\",\n358:         \"sk-code-skilled/references/rust/quality-standards/determinism-and-parity.md\",\n359:         \"sk-code-skilled/references/rust/quick-reference/overview-and-boundary-template.md\",\n360:         \"sk-code-skilled/references/rust/quick-reference/naming-ordering-and-signatures.md\",\n361:         \"sk-code-skilled/references/rust/quick-reference/collections-imports-and-errors.md\",\n362:         \"sk-code-skilled/references/rust/quick-reference/rustdoc-and-cargo.md\",\n363:         \"sk-code-skilled/references/rust/quick-reference/determinism-parity-and-related.md\",\n364:     ],\n365:     \"CI_WORKFLOW\": [\n366:         \"sk-code-ci/references/ci-workflow-standards.md\",\n367:         \"sk-code-ci/references/trigger-and-filter-rules.md\",\n368:         \"sk-code-ci/references/job-shape-rules.md\",\n369:         \"sk-code-ci/references/protected-set.md\",\n370:     ],\n371:     \"FRONTEND_WEB\": [\n372:         \"sk-code-frontend/references/frontend-practice.md\",\n373:         \"sk-code-frontend/references/web-markup-and-css.md\",\n374:     ],\n375:     \"WEB_ELEMENTS\": [\n376:         \"sk-code-frontend/references/frontend-practice.md\",\n377:         \"sk-code-frontend/references/web-markup-and-css.md\",\n378:         \"sk-code-frontend/references/web-elements-and-attributes.md\",\n379:     ],\n380:     \"WEB_CASCADE\": [\n381:         \"sk-code-frontend/references/frontend-practice.md\",\n382:         \"sk-code-frontend/references/web-markup-and-css.md\",\n383:         \"sk-code-frontend/references/web-cascade-and-selectors.md\",\n384:     ],\n385:     \"WEB_LAYOUT\": [\n386:         \"sk-code-frontend/references/frontend-practice.md\",\n387:         \"sk-code-frontend/references/web-markup-and-css.md\",\n388:         \"sk-code-frontend/references/web-layout-and-sizing.md\",\n389:     ],\n390:     \"WEB_A11Y\": [\n391:         \"sk-code-frontend/references/frontend-practice.md\",\n392:         \"sk-code-frontend/references/web-markup-and-css.md\",\n393:         \"sk-code-frontend/references/web-accessibility-patterns.md\",\n394:     ],\n395:     \"WEB_PERF\": [\n396:         \"sk-code-frontend/references/frontend-practice.md\",\n397:         \"sk-code-frontend/references/web-markup-and-css.md\",\n398:         \"sk-code-frontend/references/web-performance-and-loading.md\",\n399:     ],\n400:     \"WEB_I18N\": [\n401:         \"sk-code-frontend/references/frontend-practice.md\",\n402:         \"sk-code-frontend/references/web-markup-and-css.md\",\n403:         \"sk-code-frontend/references/web-internationalization.md\",\n404:     ],\n405:     \"WEB_VISUAL_VALUES\": [\n406:         \"sk-code-frontend/references/frontend-practice.md\",\n407:         \"sk-code-frontend/references/web-visual-values.md\",\n408:     ],\n409:     \"WEB_VISUAL_HIERARCHY\": [\n410:         \"sk-code-frontend/references/frontend-practice.md\",\n411:         \"sk-code-frontend/references/web-visual-hierarchy.md\",\n412:         \"sk-code-frontend/references/web-visual-values.md\",\n413:         \"sk-code-frontend/references/web-accessibility-patterns.md\",\n414:     ],\n415:     \"WEB_MOTION\": [\n416:         \"sk-code-frontend/references/frontend-practice.md\",\n417:         \"sk-code-frontend/references/web-motion-and-interaction.md\",\n418:     ],\n419:     \"FIGMA_TO_CODE\": [\n420:         \"sk-code-frontend/references/figma-to-code.md\",\n421:         \"sk-code-frontend/references/frontend-practice.md\",\n422:     ],\n423: }\n424: \n425: # Hub-level shared controls, declared once here. This list holds every\n426: # contained shared/ path that RESOURCE_MAP references but that is exempt from\n427: # typed-leaf projection, because it has no single packet owner. The root-router\n428: # contract validates each entry and requires RESOURCE_MAP to reference it.\n429: # DEFAULT_RESOURCE above is the other half of the set: its always-loaded\n430: # preamble paths are hub-level controls too. No other shared/ path is a\n431: # control, so a guard that needs the control set reads these two lists.\n432: SHARED_CONTROL_RESOURCES = [\n433:     \"shared/references/universal/code-quality-standards.md\",\n434:     \"shared/references/universal/rule-overrides.md\",\n435:     \"shared/references/workflow-debug.md\",\n436:     \"shared/references/workflow-verify.md\",\n437: ]\n438: ```\n439: \n440: ### Surface-aware loading (route-time)\n441: \n442: The router does NOT load the whole matched-intent union. After surface detection (§1, `stack-detection.md`), a route loads:\n443: \n444: - the always-loaded `DEFAULT_RESOURCE` preamble (stack/phase detection and the universal quality baseline), plus\n445: - the `shared/` entries the matched intents map (for example `code-quality-standards.md` under CODE_QUALITY, `workflow-debug.md` under DEBUGGING and `workflow-verify.md` under VERIFICATION), never the whole `shared/references/universal/` folder, plus\n446: - only the **detected surface's** slice (`<surface>/references/*`) for the matched intents.\n447: \n448: - It does not load another surface's resources.\n449: - It defers `assets/*` (checklists, recipes, templates) to on-demand rather than the first slice.\n450: - Within SKILLED it slices once more by the **detected language** (§1 sub-detection): a TypeScript task loads `sk-code-skilled/references/typescript/*` plus the language-agnostic `sk-code-skilled/references/shared/*`, not the Python, shell, config, or JavaScript folders.\n451: - An `UNKNOWN` surface falls back to the preamble plus the shared-tier entries its matched intents map.\n452: \n453: This is what stops a routine single-surface task from pulling the full cross-surface set. The deterministic router-replay enforces the same rule, so the benchmark measures it.\n454: \n455: ---\n456: \n457: ## 9. HOW TO READ THIS\n458: \n459: - Every code task first loads the always-on preamble (stack + phase detection and the universal quality baseline); routing then narrows to the detected surface's slice for the matched intents.\n460: - One dominant intent on one surface loads that surface's slice; two near-tied intents (within the router's ambiguity delta) load both intent sets, deduped by canonical pair.\n461: - A single-surface task never pulls another surface's resources.\n462: - No keyword match, or an `UNKNOWN` surface, falls back to the preamble plus the shared-tier entries its matched intents map — confirm the surface and intent before loading more. See §6 (UNKNOWN FALLBACK) and §7 (LOADING DISCIPLINE) for the full rules.\n463: \n464: ---\n465: \n466: ## 10. RELATED RESOURCES\n467: \n468: - [`stack-detection.md`](shared/references/stack-detection.md): surface detection (a declared specific surface, then the SKILLED fallback, then UNKNOWN) + SKILLED language sub-detection\n469: - [`phase-detection.md`](shared/references/phase-detection.md) — Phase 1/2/3 lifecycle and per-phase resource loading\n470: - `SKILL.md` §2 SMART ROUTING — names the routing authority split and the compiled front door\n471: - Barter equivalent: `barter/.skilled/skills/sk-code/shared/references/smart-routing.md` (different routing key — git-remote project — but same structural pattern)\n472: \n473: ---\n474: \n475: ## 11. MACHINE ROUTER\n476: \n477: The hub's detailed routing prose, moved here from `SKILL.md` so the skill body keeps only a short routing summary and a pointer to this file. It sits last, after the stage-two map above, and it declares no map of its own: the `INTENT_SIGNALS` and `RESOURCE_MAP` block in section 8 stays the only replay source.\n478: \n479: > **Compiled routing (default-on, flag-gated, additive).** Resolve the mode via the compiled router contract first:\n480: > ```bash\n481: > node .skilled/bin/compiled-route.cjs --hub sk-code --prompt \"<task>\"\n482: > ```\n483: > Follow the returned decision: `route` (use its `targets`), `clarify`/`defer` (disambiguate) or `reject` (refuse). On a `{\"servingAuthority\":\"legacy\"}` sentinel or any error, use the routing below. The front door self-gates on serving-authority. Compiled routing is now the default for `sk-code`. Set `SPECKIT_COMPILED_ROUTING=0`, the explicit kill-switch, to force legacy routing fleet-wide.\n484: \n485: **Session surface hint.** Before you call the front door, run the surface detection in [`stack-detection.md`](shared/references/stack-detection.md) on the session's working directory and the files it is editing.\n486: Then add its result as `--surface-hint <SURFACE>`, for example `--surface-hint SKILLED`.\n487: When the prompt's keywords tie between surfaces, a hinted specific surface leads them.\n488: Workflow modes keep first place, and the targets and the bundle kind stay the same.\n489: `SKILLED` is the fallback surface and always ranks last, so a `SKILLED` hint changes nothing.\n490: With `UNKNOWN`, no hint or a surface the prompt did not match, the `routerPolicy.tieBreak` order applies.\n491: \n492: ### Surface Router: per-intent leaf sets\n493: \n494: Root `ROUTER.md` owns the second-stage `INTENT_SIGNALS` / `RESOURCE_MAP`, while packet-owned resources stay typed through `leaf-manifest.json`.\n495: The hub-level shared controls are declared once, in `ROUTER.md` §8: the `SHARED_CONTROL_RESOURCES` list plus the always-loaded `DEFAULT_RESOURCE` preamble. They resolve on disk but never project as leaves.\n496: The hub router keeps stage-one mode selection and its `shared/README.md` fallback.\n497: \n498: ### The discriminator\n499: - **`workflowMode`** - the public mode/packet key: `sk-code-quality`, `sk-code-review` (workflow) or `sk-code-ci`, `sk-code-frontend`, `sk-code-skilled` (surface).\n500: - **`packetKind`** - the axis: `workflow` (a mode that acts) or `surface` (read-only evidence bundled alongside a mode).\n501: - **`backendKind`** - which backend runs the packet: `surface-router` or `review-cache` for workflow modes, `evidence-base` for surface packets.\n502: \n503: Surface packets are advisor-invisible (`routingClass: metadata`, read-only `toolSurface`).\n504: The advisor still routes the single identity `sk-code`, and the hub bundles zero-or-more surfaces as evidence via `routerPolicy.outcomes.surfaceBundle`.\n505: The workflow mode comes first, followed by surfaces.\n506: \"review my typescript module for jank\" → `[sk-code-review, sk-code-skilled]`.\n507: Bundled surfaces follow the `routerPolicy.tieBreak` order. It ranks `sk-code-frontend` ahead of `sk-code-ci`, then `sk-code-skilled` last, because a new surface goes ahead of the existing ones and the SKILLED fallback stays last.\n508: \n509: ### Surface detection\n510: \n511: Surface detection lives once in the hub's `shared/` layer and every mode and surface consumes it.\n512: It tries every declared specific surface first, then the `SKILLED` fallback, then `UNKNOWN`.\n513: When a specific surface and `SKILLED` both match, the specific one leads and `SKILLED` comes along as second evidence.\n514: Each surface declares its markers in a `surfaceDetection` block in `mode-registry.json`, or in its own `graph-metadata.json` when it lives outside the hub.\n515: Modes own workflow contracts, not surface identity.\n516: `sk-code-ci` and `sk-code-frontend` are the surfaces that stack detection does not select. The hub bundles both from request vocabulary alone: CI through `code-ci-aliases` and `code-ci-runtime`, and Frontend through `code-frontend-aliases` in `hub-router.json`.\n517: \n518: ### Fallback route\n519: \n520: When no workflow mode dominates (a bare implement/debug/verify request), the router defers to a pure surface bundle: it detects the surface, loads that surface's evidence and workflow doctrine, and the agent acts. `routerPolicy.defaultMode` is `null`, so the hub does not force a stale default. An unclear code intent asks for disambiguation.\n521: \n522: Per-mode behavior is **not flattened**: each packet keeps its own code-work contract, standards, evidence rules, and tool-permission guards.\n523: \n524: ### Routing rule\n525: ```python\n526: from pathlib import Path\n527: \n528: SKILL_ROOT = Path(__file__).resolve().parent\n529: UNKNOWN_FALLBACK_CHECKLIST = [\n530:     \"Confirm whether this is sk-code-quality, sk-code-review, sk-code-ci, sk-code-frontend or sk-code-skilled work\",\n531:     \"Confirm the target files or runtime surface\",\n532:     \"Confirm the expected action: implement, debug, verify, quality gate, or review\",\n533:     \"Confirm the verification command set before completion\",\n534: ]\n535: \n536: def _guard_in_skill(relative_path: str) -> str:\n537:     resolved = (SKILL_ROOT / relative_path).resolve()\n538:     resolved.relative_to(SKILL_ROOT)\n539:     if resolved.name != \"SKILL.md\" and resolved.suffix.lower() != \".md\":\n540:         raise ValueError(f\"Only markdown skill resources are routable: {relative_path}\")\n541:     return resolved.relative_to(SKILL_ROOT).as_posix()\n542: \n543: def load_if_available(relative_path: str, loaded: list[str], seen: set[str]) -> None:\n544:     guarded = _guard_in_skill(relative_path)\n545:     path = SKILL_ROOT / guarded\n546:     if path.exists() and guarded not in seen:\n547:         load(guarded)\n548:         loaded.append(guarded)\n549:         seen.add(guarded)\n550: \n551: def route(task):\n552:     loaded, seen = [], set()\n553:     registry = read_json(SKILL_ROOT / \"mode-registry.json\")\n554:     workflow_mode = explicit_mode_hint(task) or classify_workflow_mode(task)\n555: \n556:     if not workflow_mode:\n557:         load_if_available(\"shared/README.md\", loaded, seen)\n558:         return {\n559:             \"load_level\": \"UNKNOWN_FALLBACK\",\n560:             \"needs_disambiguation\": True,\n561:             \"disambiguation_checklist\": UNKNOWN_FALLBACK_CHECKLIST,\n562:             \"resources\": loaded,\n563:         }\n564: \n565:     entry = find_registry_entry(registry, workflowMode=workflow_mode)\n566:     if not entry:\n567:         load_if_available(\"shared/README.md\", loaded, seen)\n568:         return {\"load_level\": \"UNKNOWN_FALLBACK\", \"unknown_mode\": workflow_mode, \"resources\": loaded}\n569: \n570:     packet_skill = f\"{entry['packet']}/SKILL.md\"\n571:     load_if_available(packet_skill, loaded, seen)\n572: \n573:     for surface_mode in surface_bundle_from_hub_router(task):\n574:         surface_entry = find_registry_entry(registry, workflowMode=surface_mode)\n575:         if surface_entry:\n576:             load_if_available(f\"{surface_entry['packet']}/SKILL.md\", loaded, seen)\n577: \n578:     if not loaded:\n579:         load_if_available(\"shared/README.md\", loaded, seen)\n580:         return {\"load_level\": \"UNKNOWN_FALLBACK\", \"notice\": \"matched registry but no packet SKILL.md was available\", \"resources\": loaded}\n581: \n582:     return {\"workflowMode\": workflow_mode, \"backendKind\": entry[\"backendKind\"], \"resources\": loaded}\n583: ```"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.opencode/skills/sk-code/ROUTER.md\"}"},"time":{"start":1794527303778,"end":1794527304533}}}}
{"type":"step_finish","timestamp":1794527307480,"sessionID":"ses_e2dd82e01ffeqmnJRIxBdI7fut","part":{"id":"prt_1d229a6d8001i24MoG5o6Uncza","sessionID":"ses_e2dd82e01ffeqmnJRIxBdI7fut","messageID":"msg_1d2298295001mHzmIzmnCQrzZ6","type":"step-finish","reason":"tool-calls","snapshot":"3114e2511131b250ee00e5206ae57d08898feab7","cost":0,"tokens":{"input":4965,"output":125,"reasoning":398,"cache":{"read":38528,"write":0}}}}
{"type":"step_start","timestamp":1794527321212,"sessionID":"ses_e2dd82e01ffeqmnJRIxBdI7fut","part":{"id":"prt_1d229dc7c001B16Yy0Bi7AQIUI","sessionID":"ses_e2dd82e01ffeqmnJRIxBdI7fut","messageID":"msg_1d229a6df001hFBcdjX3dqDyEB","type":"step-start","snapshot":"3dec70948eea060d260eeb48c7f50f8e77814f27"}}
{"type":"tool_use","timestamp":1794527325461,"sessionID":"ses_e2dd82e01ffeqmnJRIxBdI7fut","part":{"partID":"prt_1d229ecc3002Hxq7f6D8VKIGWA","sessionID":"ses_e2dd82e01ffeqmnJRIxBdI7fut","messageID":"msg_1d229a6df001hFBcdjX3dqDyEB","type":"tool","id":"call_2145521e3f78404da547dc54","tool":"read","state":{"status":"completed","input":{"path":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/commands/doctor/scripts/doctor-phrase-reach.cjs"},"output":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/commands/doctor/scripts/doctor-phrase-reach.cjs, lines 1-334\n1: #!/usr/bin/env node\n2: // ───────────────────────────────────────────────────────────────────\n3: // MODULE: Doctor Phrase Reach Probe\n4: // ───────────────────────────────────────────────────────────────────\n5: \n6: // Read-only /doctor diagnostic. Every doctor command bridge that is active in the\n7: // TypeScript scorer declares diagnostic phrases in the doctor route manifest, and\n8: // the bridge promises the advisor serves them: each declared phrase, plus the\n9: // runnable command string itself, must reach that bridge either as the top pick or\n10: // as the first doctor bridge among the passing recommendations behind the top pick.\n11: // A phrase that reaches neither is wording the manifest advertises and the advisor\n12: // cannot serve, which no diff can tell apart from a deliberate wording choice.\n13: //\n14: // The probe scores in process under the same pinned force-local regime the doctor\n15: // routing slice uses, so its verdict is reproducible and matches that gate instead\n16: // of drifting with the calendar, the local SQLite index or lane overrides.\n17: //\n18: // It is strictly REPORT-ONLY. It writes nothing in the repository; its only\n19: // filesystem touch is the empty temporary database directory the pinned regime\n20: // needs, which it removes before exiting. The freshness check may also refresh\n21: // its cached build record inside the ignored dist folder.\n22: //\n23: // Exit codes:\n24: //   0  every admitted phrase and runnable string reaches its bridge\n25: //   1  at least one admitted phrase reaches neither the top pick nor the second line\n26: //   2  bad argument, missing or stale build output, or an unreadable input\n27: //\n28: // Usage: doctor-phrase-reach.cjs [--json]\n29: //   --json  print one JSON object instead of the per-phrase text report\n30: \n31: 'use strict';\n32: \n33: // ─────────────────────────────────────────────────────────────────────────────\n34: // 1. IMPORTS\n35: // ─────────────────────────────────────────────────────────────────────────────\n36: \n37: const fs = require('fs');\n38: const os = require('os');\n39: const path = require('path');\n40: const { pathToFileURL } = require('url');\n41: const { checkPackageFreshness } = require(path.join(__dirname, '../../../skills/system-spec-kit/runtime/cli/lib/dist-freshness.cjs'));\n42: \n43: // ─────────────────────────────────────────────────────────────────────────────\n44: // 2. CONSTANTS AND PATHS\n45: // ─────────────────────────────────────────────────────────────────────────────\n46: \n47: const REPO_ROOT = path.resolve(__dirname, '../../../..');\n48: const ROUTES = path.join(REPO_ROOT, '.skilled', 'commands', 'doctor', '_routes.yaml');\n49: const RUNTIME = path.join(REPO_ROOT, '.skilled', 'skills', 'system-skill-advisor', 'runtime');\n50: const COMPAT = path.join(RUNTIME, 'scripts', 'command-bridges', 'scoring-compatibility.json');\n51: const BASELINE = path.join(RUNTIME, 'scripts', 'routing-accuracy', 'scorer-eval-baseline.json');\n52: const DIST = path.join(RUNTIME, 'dist', 'runtime');\n53: const BUILT_SCORER = path.join(DIST, 'lib', 'scorer', 'fusion.js');\n54: const BUILT_WORKSPACE_ROOT = path.join(DIST, 'lib', 'utils', 'workspace-root.js');\n55: const DOCTOR_PREFIX = 'command-doctor-';\n56: const DOCTOR_MCP_COMMAND = '/doctor:mcp';\n57: const SENTINEL = '.skilled/skills/system-spec-kit/SKILL.md';\n58: \n59: // ─────────────────────────────────────────────────────────────────────────────\n60: // 3. HELPERS\n61: // ─────────────────────────────────────────────────────────────────────────────\n62: \n63: // A misspelled flag must fail loudly rather than fall back to a default run.\n64: function parseArgs(argv) {\n65:   const options = { asJson: false };\n66:   for (const arg of argv) {\n67:     if (arg === '--json') {\n68:       options.asJson = true;\n69:       continue;\n70:     }\n71:     return null;\n72:   }\n73:   return options;\n74: }\n75: \n76: function doctorName(command) {\n77:   const match = /^\\/doctor:([a-z0-9-]+)$/.exec(command);\n78:   return match ? match[1] : null;\n79: }\n80: \n81: function stringArray(value) {\n82:   return Array.isArray(value) ? value.filter((entry) => typeof entry === 'string' && entry) : [];\n83: }\n84: \n85: // The admitted set is the compatibility document's TypeScript inventory: a bridge\n86: // admitted in only one scorer cannot be probed through the TypeScript scorer.\n87: function admittedBridgeIds() {\n88:   const doc = JSON.parse(fs.readFileSync(COMPAT, 'utf8'));\n89:   return new Set(doc.typescript.map((entry) => entry.inventoryId));\n90: }\n91: \n92: // Recomputes the bridge ids, runnable strings and phrases the deriver produces from\n93: // the manifest, so the probe reads the same contract the scorer was generated from\n94: // rather than the generated copy that could have fallen behind it.\n95: function manifestBridges() {\n96:   const YAML = require('yaml');\n97:   const manifest = YAML.parse(fs.readFileSync(ROUTES, 'utf8'));\n98:   const admitted = admittedBridgeIds();\n99:   const routes = manifest.routes;\n100: \n101:   const routeCounts = new Map();\n102:   for (const route of routes) {\n103:     const name = doctorName(route.command);\n104:     if (name) routeCounts.set(name, (routeCounts.get(name) || 0) + 1);\n105:   }\n106: \n107:   const bridges = [];\n108:   for (const route of routes) {\n109:     const name = doctorName(route.command);\n110:     if (!name || typeof route.target !== 'string' || !route.target) continue;\n111:     // A command with several targets needs one bridge per target; a single-target\n112:     // command takes the command's own id.\n113:     const multiTarget = routeCounts.get(name) > 1;\n114:     const id = multiTarget\n115:       ? `${DOCTOR_PREFIX}${name}-${route.target}`\n116:       : `${DOCTOR_PREFIX}${name}`;\n117:     if (!admitted.has(id)) continue;\n118:     bridges.push({\n119:       id,\n120:       runnable: multiTarget ? `${route.command} ${route.target}` : route.command,\n121:       phrases: stringArray(route.trigger_phrases),\n122:     });\n123:   }\n124: \n125:   const standalone = Array.isArray(manifest.standalone) ? manifest.standalone : [];\n126:   for (const item of standalone) {\n127:     if (!item || typeof item.command !== 'string') continue;\n128:     const name = doctorName(item.command);\n129:     if (!name) continue;\n130:     const id = `${DOCTOR_PREFIX}${name}`;\n131:     if (!admitted.has(id)) continue;\n132:     bridges.push({\n133:       id,\n134:       runnable: typeof item.runnable === 'string' && item.runnable ? item.runnable : item.command,\n135:       phrases: stringArray(item.trigger_phrases),\n136:     });\n137:   }\n138: \n139:   const mcpSubroutes = Array.isArray(manifest.mcp_subroutes) ? manifest.mcp_subroutes : [];\n140:   for (const item of mcpSubroutes) {\n141:     if (!item || typeof item.sub_action !== 'string' || !item.sub_action) continue;\n142:     const id = `${DOCTOR_PREFIX}${doctorName(DOCTOR_MCP_COMMAND)}-${item.sub_action}`;\n143:     if (!admitted.has(id)) continue;\n144:     bridges.push({\n145:       id,\n146:       runnable: `${DOCTOR_MCP_COMMAND} ${item.sub_action}`,\n147:       phrases: stringArray(item.trigger_phrases),\n148:     });\n149:   }\n150:   return bridges;\n151: }\n152: \n153: // Read only the capturedAt stamp, which is the instant the accuracy baseline\n154: // attests the scorer's behavior at.\n155: function baselineInstant() {\n156:   const baseline = JSON.parse(fs.readFileSync(BASELINE, 'utf8'));\n157:   return `${baseline.capturedAt}T00:00:00Z`;\n158: }\n159: \n160: let tempDbDir = null;\n161: \n162: // Freeze scoring to the reproducible filesystem projection: an empty database\n163: // directory makes the SQLite loader return null, semantic embeddings are disabled,\n164: // and the native lane-ranking overrides are cleared so the top-1 decision is\n165: // deterministic.\n166: function freezeRegime(instant) {\n167:   tempDbDir = fs.mkdtempSync(path.join(os.tmpdir(), 'doctor-phrase-reach-'));\n168:   process.env.SYSTEM_SKILL_ADVISOR_DB_DIR = tempDbDir;\n169:   process.env.SKILL_ADVISOR_DISABLE_BUILTIN_SEMANTIC = '1';\n170:   process.env.SPECKIT_SKILL_ADVISOR_FORCE_LOCAL = '1';\n171:   delete process.env.SPECKIT_ADVISOR_LANE_WEIGHTS_JSON;\n172:   delete process.env.SPECKIT_ADVISOR_LANE_SHADOW_WEIGHTS_JSON;\n173:   delete process.env.SPECKIT_ADVISOR_BM25_LEXICAL_SHADOW;\n174: \n175:   // The derived lane discounts each skill by its age at scoring time, so score at\n176:   // the instant the accuracy baseline was captured; a later calendar day must not\n177:   // move a phrase that no change touched. Only the no-argument constructor and the\n178:   // static clock are pinned, so an explicit timestamp still constructs normally.\n179:   const RealDate = Date;\n180:   const fixedNow = new RealDate(instant).getTime();\n181:   class FixedDate extends RealDate {\n182:     constructor(...args) {\n183:       if (args.length === 0) super(fixedNow);\n184:       else super(...args);\n185:     }\n186: \n187:     static now() {\n188:       return fixedNow;\n189:     }\n190:   }\n191:   globalThis.Date = FixedDate;\n192: }\n193: \n194: function removeTempDbDir() {\n195:   if (tempDbDir) {\n196:     fs.rmSync(tempDbDir, { recursive: true, force: true });\n197:     tempDbDir = null;\n198:   }\n199: }\n200: \n201: function errorText(error) {\n202:   if (error instanceof Error) return error.stack ?? error.message;\n203:   return String(error);\n204: }\n205: \n206: // ─────────────────────────────────────────────────────────────────────────────\n207: // 4. CORE LOGIC\n208: // ─────────────────────────────────────────────────────────────────────────────\n209: \n210: // Only the first three recommendations render. A doctor bridge can be second only\n211: // under a non-doctor top pick, and a runnable command must rank first.\n212: function probeBridge(scoreAdvisorPrompt, workspaceRoot, bridge) {\n213:   const rows = [];\n214:   for (const [index, phrase] of [...bridge.phrases, bridge.runnable].entries()) {\n215:     const isRunnable = index === bridge.phrases.length;\n216:     if (!isRunnable && phrase.trim().split(/\\s+/).filter(Boolean).length < 3) {\n217:       rows.push({ id: bridge.id, phrase, reached: null, top: null, second: null, short: true });\n218:       continue;\n219:     }\n220: \n221:     const result = scoreAdvisorPrompt(phrase, { workspaceRoot });\n222:     const recommendations = result.recommendations.slice(0, 3);\n223:     const top = recommendations[0]?.skill ?? null;\n224:     let second = null;\n225:     if (top !== null && !top.startsWith(DOCTOR_PREFIX)) {\n226:       for (const recommendation of recommendations.slice(1)) {\n227:         if (recommendation.skill.startsWith(DOCTOR_PREFIX)) {\n228:           second = recommendation.skill;\n229:           break;\n230:         }\n231:       }\n232:     }\n233:     let reached = null;\n234:     if (top === bridge.id) {\n235:       reached = 'top';\n236:     } else if (!isRunnable && second === bridge.id) {\n237:       reached = 'second';\n238:     }\n239:     rows.push({ id: bridge.id, phrase, reached, top, second });\n240:   }\n241:   return rows;\n242: }\n243: \n244: async function main(bridges, options) {\n245:   const fusion = await import(pathToFileURL(BUILT_SCORER).href);\n246:   const workspace = await import(pathToFileURL(BUILT_WORKSPACE_ROOT).href);\n247:   const workspaceRoot = workspace.findAdvisorWorkspaceRoot(RUNTIME, { maxDepth: 14, sentinel: SENTINEL });\n248: \n249:   const rows = [];\n250:   for (const bridge of bridges) {\n251:     rows.push(...probeBridge(fusion.scoreAdvisorPrompt, workspaceRoot, bridge));\n252:   }\n253: \n254:   const missed = rows.filter((row) => row.reached === null).length;\n255: \n256:   if (options.asJson) {\n257:     process.stdout.write(`${JSON.stringify({\n258:       status: missed === 0 ? 'ok' : 'fail',\n259:       bridges: bridges.length,\n260:       phrases: rows.length,\n261:       missed,\n262:       rows,\n263:     }, null, 2)}\\n`);\n264:   } else {\n265:     for (const row of rows) {\n266:       if (row.short) {\n267:         process.stdout.write([\n268:           'FAIL',\n269:           row.id,\n270:           JSON.stringify(row.phrase),\n271:           'phrase has fewer than three words',\n272:         ].join(' ') + '\\n');\n273:         continue;\n274:       }\n275:       if (row.reached) {\n276:         process.stdout.write(`PASS ${row.id} ${row.reached} ${JSON.stringify(row.phrase)}\\n`);\n277:       } else {\n278:         process.stdout.write(`FAIL ${row.id} ${JSON.stringify(row.phrase)} top=${row.top} second=${row.second}\\n`);\n279:       }\n280:     }\n281:     process.stdout.write(missed === 0\n282:       ? `STATUS=OK phrases=${rows.length} bridges=${bridges.length}\\n`\n283:       : `STATUS=FAIL missed=${missed} phrases=${rows.length}\\n`);\n284:   }\n285: \n286:   return missed === 0 ? 0 : 1;\n287: }\n288: \n289: // ─────────────────────────────────────────────────────────────────────────────\n290: // 5. ENTRY POINT\n291: // ─────────────────────────────────────────────────────────────────────────────\n292: \n293: const options = parseArgs(process.argv.slice(2));\n294: if (options === null) {\n295:   process.stderr.write('Usage: doctor-phrase-reach.cjs [--json]\\n');\n296:   process.exit(2);\n297: }\n298: \n299: // A missing build is a setup problem, not a probe verdict: nothing can be scored,\n300: // so the run must not print a reach result either way.\n301: if (!fs.existsSync(BUILT_SCORER)) {\n302:   process.stderr.write('doctor-phrase-reach: advisor runtime is not built; run npm --prefix .skilled/skills/system-skill-advisor/runtime run build\\n');\n303:   process.exit(2);\n304: }\n305: \n306: // A build older than its source scores code that no longer exists, so its\n307: // verdict could pass a phrase the current source would miss. Refuse it too,\n308: // and likewise a build whose freshness cannot be assessed.\n309: const freshness = checkPackageFreshness('system-skill-advisor/runtime', { workspaceRoot: REPO_ROOT });\n310: if (freshness.status !== 'fresh') {\n311:   process.stderr.write(`doctor-phrase-reach: ${freshness.message}\\n`);\n312:   process.exit(2);\n313: }\n314: \n315: let bridges;\n316: try {\n317:   bridges = manifestBridges();\n318:   freezeRegime(baselineInstant());\n319: } catch (error) {\n320:   removeTempDbDir();\n321:   process.stderr.write(`doctor-phrase-reach: ${errorText(error)}\\n`);\n322:   process.exit(2);\n323: }\n324: \n325: main(bridges, options)\n326:   .then((code) => {\n327:     removeTempDbDir();\n328:     process.exit(code);\n329:   })\n330:   .catch((error) => {\n331:     removeTempDbDir();\n332:     process.stderr.write(`doctor-phrase-reach: ${errorText(error)}\\n`);\n333:     process.exit(2);\n334:   });","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/commands/doctor/scripts/doctor-phrase-reach.cjs, lines 1-334\n1: #!/usr/bin/env node\n2: // ───────────────────────────────────────────────────────────────────\n3: // MODULE: Doctor Phrase Reach Probe\n4: // ───────────────────────────────────────────────────────────────────\n5: \n6: // Read-only /doctor diagnostic. Every doctor command bridge that is active in the\n7: // TypeScript scorer declares diagnostic phrases in the doctor route manifest, and\n8: // the bridge promises the advisor serves them: each declared phrase, plus the\n9: // runnable command string itself, must reach that bridge either as the top pick or\n10: // as the first doctor bridge among the passing recommendations behind the top pick.\n11: // A phrase that reaches neither is wording the manifest advertises and the advisor\n12: // cannot serve, which no diff can tell apart from a deliberate wording choice.\n13: //\n14: // The probe scores in process under the same pinned force-local regime the doctor\n15: // routing slice uses, so its verdict is reproducible and matches that gate instead\n16: // of drifting with the calendar, the local SQLite index or lane overrides.\n17: //\n18: // It is strictly REPORT-ONLY. It writes nothing in the repository; its only\n19: // filesystem touch is the empty temporary database directory the pinned regime\n20: // needs, which it removes before exiting. The freshness check may also refresh\n21: // its cached build record inside the ignored dist folder.\n22: //\n23: // Exit codes:\n24: //   0  every admitted phrase and runnable string reaches its bridge\n25: //   1  at least one admitted phrase reaches neither the top pick nor the second line\n26: //   2  bad argument, missing or stale build output, or an unreadable input\n27: //\n28: // Usage: doctor-phrase-reach.cjs [--json]\n29: //   --json  print one JSON object instead of the per-phrase text report\n30: \n31: 'use strict';\n32: \n33: // ─────────────────────────────────────────────────────────────────────────────\n34: // 1. IMPORTS\n35: // ─────────────────────────────────────────────────────────────────────────────\n36: \n37: const fs = require('fs');\n38: const os = require('os');\n39: const path = require('path');\n40: const { pathToFileURL } = require('url');\n41: const { checkPackageFreshness } = require(path.join(__dirname, '../../../skills/system-spec-kit/runtime/cli/lib/dist-freshness.cjs'));\n42: \n43: // ─────────────────────────────────────────────────────────────────────────────\n44: // 2. CONSTANTS AND PATHS\n45: // ─────────────────────────────────────────────────────────────────────────────\n46: \n47: const REPO_ROOT = path.resolve(__dirname, '../../../..');\n48: const ROUTES = path.join(REPO_ROOT, '.skilled', 'commands', 'doctor', '_routes.yaml');\n49: const RUNTIME = path.join(REPO_ROOT, '.skilled', 'skills', 'system-skill-advisor', 'runtime');\n50: const COMPAT = path.join(RUNTIME, 'scripts', 'command-bridges', 'scoring-compatibility.json');\n51: const BASELINE = path.join(RUNTIME, 'scripts', 'routing-accuracy', 'scorer-eval-baseline.json');\n52: const DIST = path.join(RUNTIME, 'dist', 'runtime');\n53: const BUILT_SCORER = path.join(DIST, 'lib', 'scorer', 'fusion.js');\n54: const BUILT_WORKSPACE_ROOT = path.join(DIST, 'lib', 'utils', 'workspace-root.js');\n55: const DOCTOR_PREFIX = 'command-doctor-';\n56: const DOCTOR_MCP_COMMAND = '/doctor:mcp';\n57: const SENTINEL = '.skilled/skills/system-spec-kit/SKILL.md';\n58: \n59: // ─────────────────────────────────────────────────────────────────────────────\n60: // 3. HELPERS\n61: // ─────────────────────────────────────────────────────────────────────────────\n62: \n63: // A misspelled flag must fail loudly rather than fall back to a default run.\n64: function parseArgs(argv) {\n65:   const options = { asJson: false };\n66:   for (const arg of argv) {\n67:     if (arg === '--json') {\n68:       options.asJson = true;\n69:       continue;\n70:     }\n71:     return null;\n72:   }\n73:   return options;\n74: }\n75: \n76: function doctorName(command) {\n77:   const match = /^\\/doctor:([a-z0-9-]+)$/.exec(command);\n78:   return match ? match[1] : null;\n79: }\n80: \n81: function stringArray(value) {\n82:   return Array.isArray(value) ? value.filter((entry) => typeof entry === 'string' && entry) : [];\n83: }\n84: \n85: // The admitted set is the compatibility document's TypeScript inventory: a bridge\n86: // admitted in only one scorer cannot be probed through the TypeScript scorer.\n87: function admittedBridgeIds() {\n88:   const doc = JSON.parse(fs.readFileSync(COMPAT, 'utf8'));\n89:   return new Set(doc.typescript.map((entry) => entry.inventoryId));\n90: }\n91: \n92: // Recomputes the bridge ids, runnable strings and phrases the deriver produces from\n93: // the manifest, so the probe reads the same contract the scorer was generated from\n94: // rather than the generated copy that could have fallen behind it.\n95: function manifestBridges() {\n96:   const YAML = require('yaml');\n97:   const manifest = YAML.parse(fs.readFileSync(ROUTES, 'utf8'));\n98:   const admitted = admittedBridgeIds();\n99:   const routes = manifest.routes;\n100: \n101:   const routeCounts = new Map();\n102:   for (const route of routes) {\n103:     const name = doctorName(route.command);\n104:     if (name) routeCounts.set(name, (routeCounts.get(name) || 0) + 1);\n105:   }\n106: \n107:   const bridges = [];\n108:   for (const route of routes) {\n109:     const name = doctorName(route.command);\n110:     if (!name || typeof route.target !== 'string' || !route.target) continue;\n111:     // A command with several targets needs one bridge per target; a single-target\n112:     // command takes the command's own id.\n113:     const multiTarget = routeCounts.get(name) > 1;\n114:     const id = multiTarget\n115:       ? `${DOCTOR_PREFIX}${name}-${route.target}`\n116:       : `${DOCTOR_PREFIX}${name}`;\n117:     if (!admitted.has(id)) continue;\n118:     bridges.push({\n119:       id,\n120:       runnable: multiTarget ? `${route.command} ${route.target}` : route.command,\n121:       phrases: stringArray(route.trigger_phrases),\n122:     });\n123:   }\n124: \n125:   const standalone = Array.isArray(manifest.standalone) ? manifest.standalone : [];\n126:   for (const item of standalone) {\n127:     if (!item || typeof item.command !== 'string') continue;\n128:     const name = doctorName(item.command);\n129:     if (!name) continue;\n130:     const id = `${DOCTOR_PREFIX}${name}`;\n131:     if (!admitted.has(id)) continue;\n132:     bridges.push({\n133:       id,\n134:       runnable: typeof item.runnable === 'string' && item.runnable ? item.runnable : item.command,\n135:       phrases: stringArray(item.trigger_phrases),\n136:     });\n137:   }\n138: \n139:   const mcpSubroutes = Array.isArray(manifest.mcp_subroutes) ? manifest.mcp_subroutes : [];\n140:   for (const item of mcpSubroutes) {\n141:     if (!item || typeof item.sub_action !== 'string' || !item.sub_action) continue;\n142:     const id = `${DOCTOR_PREFIX}${doctorName(DOCTOR_MCP_COMMAND)}-${item.sub_action}`;\n143:     if (!admitted.has(id)) continue;\n144:     bridges.push({\n145:       id,\n146:       runnable: `${DOCTOR_MCP_COMMAND} ${item.sub_action}`,\n147:       phrases: stringArray(item.trigger_phrases),\n148:     });\n149:   }\n150:   return bridges;\n151: }\n152: \n153: // Read only the capturedAt stamp, which is the instant the accuracy baseline\n154: // attests the scorer's behavior at.\n155: function baselineInstant() {\n156:   const baseline = JSON.parse(fs.readFileSync(BASELINE, 'utf8'));\n157:   return `${baseline.capturedAt}T00:00:00Z`;\n158: }\n159: \n160: let tempDbDir = null;\n161: \n162: // Freeze scoring to the reproducible filesystem projection: an empty database\n163: // directory makes the SQLite loader return null, semantic embeddings are disabled,\n164: // and the native lane-ranking overrides are cleared so the top-1 decision is\n165: // deterministic.\n166: function freezeRegime(instant) {\n167:   tempDbDir = fs.mkdtempSync(path.join(os.tmpdir(), 'doctor-phrase-reach-'));\n168:   process.env.SYSTEM_SKILL_ADVISOR_DB_DIR = tempDbDir;\n169:   process.env.SKILL_ADVISOR_DISABLE_BUILTIN_SEMANTIC = '1';\n170:   process.env.SPECKIT_SKILL_ADVISOR_FORCE_LOCAL = '1';\n171:   delete process.env.SPECKIT_ADVISOR_LANE_WEIGHTS_JSON;\n172:   delete process.env.SPECKIT_ADVISOR_LANE_SHADOW_WEIGHTS_JSON;\n173:   delete process.env.SPECKIT_ADVISOR_BM25_LEXICAL_SHADOW;\n174: \n175:   // The derived lane discounts each skill by its age at scoring time, so score at\n176:   // the instant the accuracy baseline was captured; a later calendar day must not\n177:   // move a phrase that no change touched. Only the no-argument constructor and the\n178:   // static clock are pinned, so an explicit timestamp still constructs normally.\n179:   const RealDate = Date;\n180:   const fixedNow = new RealDate(instant).getTime();\n181:   class FixedDate extends RealDate {\n182:     constructor(...args) {\n183:       if (args.length === 0) super(fixedNow);\n184:       else super(...args);\n185:     }\n186: \n187:     static now() {\n188:       return fixedNow;\n189:     }\n190:   }\n191:   globalThis.Date = FixedDate;\n192: }\n193: \n194: function removeTempDbDir() {\n195:   if (tempDbDir) {\n196:     fs.rmSync(tempDbDir, { recursive: true, force: true });\n197:     tempDbDir = null;\n198:   }\n199: }\n200: \n201: function errorText(error) {\n202:   if (error instanceof Error) return error.stack ?? error.message;\n203:   return String(error);\n204: }\n205: \n206: // ─────────────────────────────────────────────────────────────────────────────\n207: // 4. CORE LOGIC\n208: // ─────────────────────────────────────────────────────────────────────────────\n209: \n210: // Only the first three recommendations render. A doctor bridge can be second only\n211: // under a non-doctor top pick, and a runnable command must rank first.\n212: function probeBridge(scoreAdvisorPrompt, workspaceRoot, bridge) {\n213:   const rows = [];\n214:   for (const [index, phrase] of [...bridge.phrases, bridge.runnable].entries()) {\n215:     const isRunnable = index === bridge.phrases.length;\n216:     if (!isRunnable && phrase.trim().split(/\\s+/).filter(Boolean).length < 3) {\n217:       rows.push({ id: bridge.id, phrase, reached: null, top: null, second: null, short: true });\n218:       continue;\n219:     }\n220: \n221:     const result = scoreAdvisorPrompt(phrase, { workspaceRoot });\n222:     const recommendations = result.recommendations.slice(0, 3);\n223:     const top = recommendations[0]?.skill ?? null;\n224:     let second = null;\n225:     if (top !== null && !top.startsWith(DOCTOR_PREFIX)) {\n226:       for (const recommendation of recommendations.slice(1)) {\n227:         if (recommendation.skill.startsWith(DOCTOR_PREFIX)) {\n228:           second = recommendation.skill;\n229:           break;\n230:         }\n231:       }\n232:     }\n233:     let reached = null;\n234:     if (top === bridge.id) {\n235:       reached = 'top';\n236:     } else if (!isRunnable && second === bridge.id) {\n237:       reached = 'second';\n238:     }\n239:     rows.push({ id: bridge.id, phrase, reached, top, second });\n240:   }\n241:   return rows;\n242: }\n243: \n244: async function main(bridges, options) {\n245:   const fusion = await import(pathToFileURL(BUILT_SCORER).href);\n246:   const workspace = await import(pathToFileURL(BUILT_WORKSPACE_ROOT).href);\n247:   const workspaceRoot = workspace.findAdvisorWorkspaceRoot(RUNTIME, { maxDepth: 14, sentinel: SENTINEL });\n248: \n249:   const rows = [];\n250:   for (const bridge of bridges) {\n251:     rows.push(...probeBridge(fusion.scoreAdvisorPrompt, workspaceRoot, bridge));\n252:   }\n253: \n254:   const missed = rows.filter((row) => row.reached === null).length;\n255: \n256:   if (options.asJson) {\n257:     process.stdout.write(`${JSON.stringify({\n258:       status: missed === 0 ? 'ok' : 'fail',\n259:       bridges: bridges.length,\n260:       phrases: rows.length,\n261:       missed,\n262:       rows,\n263:     }, null, 2)}\\n`);\n264:   } else {\n265:     for (const row of rows) {\n266:       if (row.short) {\n267:         process.stdout.write([\n268:           'FAIL',\n269:           row.id,\n270:           JSON.stringify(row.phrase),\n271:           'phrase has fewer than three words',\n272:         ].join(' ') + '\\n');\n273:         continue;\n274:       }\n275:       if (row.reached) {\n276:         process.stdout.write(`PASS ${row.id} ${row.reached} ${JSON.stringify(row.phrase)}\\n`);\n277:       } else {\n278:         process.stdout.write(`FAIL ${row.id} ${JSON.stringify(row.phrase)} top=${row.top} second=${row.second}\\n`);\n279:       }\n280:     }\n281:     process.stdout.write(missed === 0\n282:       ? `STATUS=OK phrases=${rows.length} bridges=${bridges.length}\\n`\n283:       : `STATUS=FAIL missed=${missed} phrases=${rows.length}\\n`);\n284:   }\n285: \n286:   return missed === 0 ? 0 : 1;\n287: }\n288: \n289: // ─────────────────────────────────────────────────────────────────────────────\n290: // 5. ENTRY POINT\n291: // ─────────────────────────────────────────────────────────────────────────────\n292: \n293: const options = parseArgs(process.argv.slice(2));\n294: if (options === null) {\n295:   process.stderr.write('Usage: doctor-phrase-reach.cjs [--json]\\n');\n296:   process.exit(2);\n297: }\n298: \n299: // A missing build is a setup problem, not a probe verdict: nothing can be scored,\n300: // so the run must not print a reach result either way.\n301: if (!fs.existsSync(BUILT_SCORER)) {\n302:   process.stderr.write('doctor-phrase-reach: advisor runtime is not built; run npm --prefix .skilled/skills/system-skill-advisor/runtime run build\\n');\n303:   process.exit(2);\n304: }\n305: \n306: // A build older than its source scores code that no longer exists, so its\n307: // verdict could pass a phrase the current source would miss. Refuse it too,\n308: // and likewise a build whose freshness cannot be assessed.\n309: const freshness = checkPackageFreshness('system-skill-advisor/runtime', { workspaceRoot: REPO_ROOT });\n310: if (freshness.status !== 'fresh') {\n311:   process.stderr.write(`doctor-phrase-reach: ${freshness.message}\\n`);\n312:   process.exit(2);\n313: }\n314: \n315: let bridges;\n316: try {\n317:   bridges = manifestBridges();\n318:   freezeRegime(baselineInstant());\n319: } catch (error) {\n320:   removeTempDbDir();\n321:   process.stderr.write(`doctor-phrase-reach: ${errorText(error)}\\n`);\n322:   process.exit(2);\n323: }\n324: \n325: main(bridges, options)\n326:   .then((code) => {\n327:     removeTempDbDir();\n328:     process.exit(code);\n329:   })\n330:   .catch((error) => {\n331:     removeTempDbDir();\n332:     process.stderr.write(`doctor-phrase-reach: ${errorText(error)}\\n`);\n333:     process.exit(2);\n334:   });"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/commands/doctor/scripts/doctor-phrase-reach.cjs\"}"},"time":{"start":1794527325379,"end":1794527325461}}}}
{"type":"tool_use","timestamp":1794527325470,"sessionID":"ses_e2dd82e01ffeqmnJRIxBdI7fut","part":{"partID":"prt_1d229ecc6001hlgeQSHMgVSPRa","sessionID":"ses_e2dd82e01ffeqmnJRIxBdI7fut","messageID":"msg_1d229a6df001hFBcdjX3dqDyEB","type":"tool","id":"call_dc28eeb5902e4835b70d016d","tool":"read","state":{"status":"completed","input":{"path":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/commands/doctor/scripts/tests/doctor-phrase-reach.test.cjs"},"output":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/commands/doctor/scripts/tests/doctor-phrase-reach.test.cjs, lines 1-135\n1: #!/usr/bin/env node\n2: // ───────────────────────────────────────────────────────────────────\n3: // MODULE: Doctor Phrase Reach Probe Tests\n4: // ───────────────────────────────────────────────────────────────────\n5: 'use strict';\n6: \n7: // Drives the probe as a process, so each verdict is observed through its exit code\n8: // and output. The passing run scores the repository's own route manifest against the\n9: // built advisor. The stale-build run uses a throwaway copy of the probe whose\n10: // freshness library reports a stale build, so no real build is touched.\n11: \n12: // ─────────────────────────────────────────────────────────────────────────────\n13: // 1. IMPORTS AND FIXTURES\n14: // ─────────────────────────────────────────────────────────────────────────────\n15: \n16: const assert = require('node:assert/strict');\n17: const { spawnSync } = require('node:child_process');\n18: const fs = require('node:fs');\n19: const os = require('node:os');\n20: const path = require('node:path');\n21: const test = require('node:test');\n22: \n23: const SCRIPT = path.resolve(__dirname, '..', 'doctor-phrase-reach.cjs');\n24: \n25: // The probe resolves these from its own folder, so a copy placed at SCRIPT_COPY\n26: // inside a throwaway root reads the stubs below instead of the repository.\n27: const SCRIPT_COPY = '.skilled/commands/doctor/scripts/doctor-phrase-reach.cjs';\n28: const FRESHNESS_LIB = '.skilled/skills/system-spec-kit/runtime/cli/lib/dist-freshness.cjs';\n29: const BUILT_SCORER = '.skilled/skills/system-skill-advisor/runtime/dist/runtime/lib/scorer/fusion.js';\n30: \n31: function runProbe(script, args = []) {\n32:   return spawnSync(process.execPath, [script, ...args], { encoding: 'utf8' });\n33: }\n34: \n35: function writeFile(root, rel, body) {\n36:   const abs = path.join(root, rel);\n37:   fs.mkdirSync(path.dirname(abs), { recursive: true });\n38:   fs.writeFileSync(abs, body);\n39: }\n40: \n41: // ─────────────────────────────────────────────────────────────────────────────\n42: // 2. TESTS\n43: // ─────────────────────────────────────────────────────────────────────────────\n44: \n45: test('every admitted phrase reaches its bridge on the built advisor', () => {\n46:   const result = runProbe(SCRIPT, ['--json']);\n47:   assert.equal(result.status, 0, result.stderr);\n48:   const report = JSON.parse(result.stdout);\n49:   assert.equal(report.status, 'ok');\n50:   assert.equal(report.missed, 0);\n51:   assert.ok(report.bridges > 0);\n52:   assert.equal(report.phrases, report.rows.length);\n53: });\n54: \n55: test('a two-word manifest phrase is reported as missed without scoring it', (t) => {\n56:   const root = fs.mkdtempSync(path.join(os.tmpdir(), 'doctor-phrase-reach-test-'));\n57:   t.after(() => fs.rmSync(root, { recursive: true, force: true }));\n58:   writeFile(root, SCRIPT_COPY, fs.readFileSync(SCRIPT, 'utf8'));\n59:   writeFile(root, 'package.json', '{\"type\":\"module\"}');\n60:   writeFile(root, BUILT_SCORER, [\n61:     'export function scoreAdvisorPrompt() {',\n62:     '  return {',\n63:     \"    topSkill: 'command-doctor-status',\",\n64:     \"    recommendations: [{ skill: 'command-doctor-status' }],\",\n65:     '  };',\n66:     '}',\n67:     '',\n68:   ].join('\\n'));\n69:   writeFile(root,\n70:     '.skilled/skills/system-skill-advisor/runtime/dist/runtime/lib/utils/' +\n71:       'workspace-root.js',\n72:     \"export function findAdvisorWorkspaceRoot() { return '/tmp'; }\\n\");\n73:   writeFile(root, FRESHNESS_LIB, [\n74:     'module.exports = {',\n75:     \"  checkPackageFreshness: () => ({ status: 'fresh', message: 'stub build is current' }),\",\n76:     '};',\n77:     '',\n78:   ].join('\\n'));\n79:   writeFile(root,\n80:     '.skilled/commands/doctor/scripts/node_modules/yaml/package.json',\n81:     '{\"type\":\"commonjs\"}');\n82:   writeFile(root,\n83:     '.skilled/commands/doctor/scripts/node_modules/yaml/index.js',\n84:     'module.exports = { parse: JSON.parse };\\n');\n85:   writeFile(root, '.skilled/commands/doctor/_routes.yaml', JSON.stringify({\n86:     routes: [{\n87:       command: '/doctor:status',\n88:       target: 'workspace',\n89:       trigger_phrases: ['doctor update'],\n90:     }],\n91:     standalone: [],\n92:   }));\n93:   writeFile(root,\n94:     '.skilled/skills/system-skill-advisor/runtime/scripts/command-bridges/' +\n95:       'scoring-compatibility.json',\n96:     JSON.stringify({ typescript: [{ inventoryId: 'command-doctor-status' }] }));\n97:   writeFile(root,\n98:     '.skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/' +\n99:       'scorer-eval-baseline.json',\n100:     JSON.stringify({ capturedAt: '2026-10-16' }));\n101: \n102:   const result = runProbe(path.join(root, SCRIPT_COPY), ['--json']);\n103:   assert.equal(result.status, 1, result.stderr);\n104:   const report = JSON.parse(result.stdout);\n105:   assert.equal(report.status, 'fail');\n106:   assert.equal(report.missed, 1);\n107:   const shortRow = report.rows.find((row) => row.phrase === 'doctor update');\n108:   assert.equal(shortRow.reached, null);\n109:   assert.equal(shortRow.short, true);\n110:   const runnableRow = report.rows.find((row) => row.phrase === '/doctor:status');\n111:   assert.equal(runnableRow.reached, 'top');\n112: \n113:   const textResult = runProbe(path.join(root, SCRIPT_COPY));\n114:   assert.equal(textResult.status, 1, textResult.stderr);\n115:   assert.match(textResult.stdout,\n116:     /FAIL command-doctor-status \"doctor update\" phrase has fewer than three words/);\n117: });\n118: \n119: test('a stale build exits 2 and prints no reach verdict', (t) => {\n120:   const root = fs.mkdtempSync(path.join(os.tmpdir(), 'doctor-phrase-reach-test-'));\n121:   t.after(() => fs.rmSync(root, { recursive: true, force: true }));\n122:   writeFile(root, SCRIPT_COPY, fs.readFileSync(SCRIPT, 'utf8'));\n123:   writeFile(root, BUILT_SCORER, '');\n124:   writeFile(root, FRESHNESS_LIB, [\n125:     'module.exports = {',\n126:     \"  checkPackageFreshness: () => ({ status: 'stale', message: 'stub build is older than its source' }),\",\n127:     '};',\n128:     '',\n129:   ].join('\\n'));\n130: \n131:   const result = runProbe(path.join(root, SCRIPT_COPY));\n132:   assert.equal(result.status, 2);\n133:   assert.match(result.stderr, /stub build is older than its source/);\n134:   assert.doesNotMatch(result.stdout, /STATUS=/);\n135: });","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/commands/doctor/scripts/tests/doctor-phrase-reach.test.cjs, lines 1-135\n1: #!/usr/bin/env node\n2: // ───────────────────────────────────────────────────────────────────\n3: // MODULE: Doctor Phrase Reach Probe Tests\n4: // ───────────────────────────────────────────────────────────────────\n5: 'use strict';\n6: \n7: // Drives the probe as a process, so each verdict is observed through its exit code\n8: // and output. The passing run scores the repository's own route manifest against the\n9: // built advisor. The stale-build run uses a throwaway copy of the probe whose\n10: // freshness library reports a stale build, so no real build is touched.\n11: \n12: // ─────────────────────────────────────────────────────────────────────────────\n13: // 1. IMPORTS AND FIXTURES\n14: // ─────────────────────────────────────────────────────────────────────────────\n15: \n16: const assert = require('node:assert/strict');\n17: const { spawnSync } = require('node:child_process');\n18: const fs = require('node:fs');\n19: const os = require('node:os');\n20: const path = require('node:path');\n21: const test = require('node:test');\n22: \n23: const SCRIPT = path.resolve(__dirname, '..', 'doctor-phrase-reach.cjs');\n24: \n25: // The probe resolves these from its own folder, so a copy placed at SCRIPT_COPY\n26: // inside a throwaway root reads the stubs below instead of the repository.\n27: const SCRIPT_COPY = '.skilled/commands/doctor/scripts/doctor-phrase-reach.cjs';\n28: const FRESHNESS_LIB = '.skilled/skills/system-spec-kit/runtime/cli/lib/dist-freshness.cjs';\n29: const BUILT_SCORER = '.skilled/skills/system-skill-advisor/runtime/dist/runtime/lib/scorer/fusion.js';\n30: \n31: function runProbe(script, args = []) {\n32:   return spawnSync(process.execPath, [script, ...args], { encoding: 'utf8' });\n33: }\n34: \n35: function writeFile(root, rel, body) {\n36:   const abs = path.join(root, rel);\n37:   fs.mkdirSync(path.dirname(abs), { recursive: true });\n38:   fs.writeFileSync(abs, body);\n39: }\n40: \n41: // ─────────────────────────────────────────────────────────────────────────────\n42: // 2. TESTS\n43: // ─────────────────────────────────────────────────────────────────────────────\n44: \n45: test('every admitted phrase reaches its bridge on the built advisor', () => {\n46:   const result = runProbe(SCRIPT, ['--json']);\n47:   assert.equal(result.status, 0, result.stderr);\n48:   const report = JSON.parse(result.stdout);\n49:   assert.equal(report.status, 'ok');\n50:   assert.equal(report.missed, 0);\n51:   assert.ok(report.bridges > 0);\n52:   assert.equal(report.phrases, report.rows.length);\n53: });\n54: \n55: test('a two-word manifest phrase is reported as missed without scoring it', (t) => {\n56:   const root = fs.mkdtempSync(path.join(os.tmpdir(), 'doctor-phrase-reach-test-'));\n57:   t.after(() => fs.rmSync(root, { recursive: true, force: true }));\n58:   writeFile(root, SCRIPT_COPY, fs.readFileSync(SCRIPT, 'utf8'));\n59:   writeFile(root, 'package.json', '{\"type\":\"module\"}');\n60:   writeFile(root, BUILT_SCORER, [\n61:     'export function scoreAdvisorPrompt() {',\n62:     '  return {',\n63:     \"    topSkill: 'command-doctor-status',\",\n64:     \"    recommendations: [{ skill: 'command-doctor-status' }],\",\n65:     '  };',\n66:     '}',\n67:     '',\n68:   ].join('\\n'));\n69:   writeFile(root,\n70:     '.skilled/skills/system-skill-advisor/runtime/dist/runtime/lib/utils/' +\n71:       'workspace-root.js',\n72:     \"export function findAdvisorWorkspaceRoot() { return '/tmp'; }\\n\");\n73:   writeFile(root, FRESHNESS_LIB, [\n74:     'module.exports = {',\n75:     \"  checkPackageFreshness: () => ({ status: 'fresh', message: 'stub build is current' }),\",\n76:     '};',\n77:     '',\n78:   ].join('\\n'));\n79:   writeFile(root,\n80:     '.skilled/commands/doctor/scripts/node_modules/yaml/package.json',\n81:     '{\"type\":\"commonjs\"}');\n82:   writeFile(root,\n83:     '.skilled/commands/doctor/scripts/node_modules/yaml/index.js',\n84:     'module.exports = { parse: JSON.parse };\\n');\n85:   writeFile(root, '.skilled/commands/doctor/_routes.yaml', JSON.stringify({\n86:     routes: [{\n87:       command: '/doctor:status',\n88:       target: 'workspace',\n89:       trigger_phrases: ['doctor update'],\n90:     }],\n91:     standalone: [],\n92:   }));\n93:   writeFile(root,\n94:     '.skilled/skills/system-skill-advisor/runtime/scripts/command-bridges/' +\n95:       'scoring-compatibility.json',\n96:     JSON.stringify({ typescript: [{ inventoryId: 'command-doctor-status' }] }));\n97:   writeFile(root,\n98:     '.skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/' +\n99:       'scorer-eval-baseline.json',\n100:     JSON.stringify({ capturedAt: '2026-10-16' }));\n101: \n102:   const result = runProbe(path.join(root, SCRIPT_COPY), ['--json']);\n103:   assert.equal(result.status, 1, result.stderr);\n104:   const report = JSON.parse(result.stdout);\n105:   assert.equal(report.status, 'fail');\n106:   assert.equal(report.missed, 1);\n107:   const shortRow = report.rows.find((row) => row.phrase === 'doctor update');\n108:   assert.equal(shortRow.reached, null);\n109:   assert.equal(shortRow.short, true);\n110:   const runnableRow = report.rows.find((row) => row.phrase === '/doctor:status');\n111:   assert.equal(runnableRow.reached, 'top');\n112: \n113:   const textResult = runProbe(path.join(root, SCRIPT_COPY));\n114:   assert.equal(textResult.status, 1, textResult.stderr);\n115:   assert.match(textResult.stdout,\n116:     /FAIL command-doctor-status \"doctor update\" phrase has fewer than three words/);\n117: });\n118: \n119: test('a stale build exits 2 and prints no reach verdict', (t) => {\n120:   const root = fs.mkdtempSync(path.join(os.tmpdir(), 'doctor-phrase-reach-test-'));\n121:   t.after(() => fs.rmSync(root, { recursive: true, force: true }));\n122:   writeFile(root, SCRIPT_COPY, fs.readFileSync(SCRIPT, 'utf8'));\n123:   writeFile(root, BUILT_SCORER, '');\n124:   writeFile(root, FRESHNESS_LIB, [\n125:     'module.exports = {',\n126:     \"  checkPackageFreshness: () => ({ status: 'stale', message: 'stub build is older than its source' }),\",\n127:     '};',\n128:     '',\n129:   ].join('\\n'));\n130: \n131:   const result = runProbe(path.join(root, SCRIPT_COPY));\n132:   assert.equal(result.status, 2);\n133:   assert.match(result.stderr, /stub build is older than its source/);\n134:   assert.doesNotMatch(result.stdout, /STATUS=/);\n135: });"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/commands/doctor/scripts/tests/doctor-phrase-reach.test.cjs\"}"},"time":{"st