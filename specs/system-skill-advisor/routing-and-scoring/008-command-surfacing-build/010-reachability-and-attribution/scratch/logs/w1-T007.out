"PreToolUse\\\\\\\",\\\\\\\"additionalContext\\\\\\\":\\\\\\\"mk codex hook could not resolve; build the spec-kit runtime (npm --prefix .skilled/skills/system-spec-kit run build) or restore the missing adapter\\\\\\\"}}\\\"; }'\",\n119:             \"timeout\": 10\n120:           }\n121:         ]\n122:       },\n123:       {\n124:         \"matcher\": \"exec|Bash|apply_patch|edit|read_file\",\n125:         \"hooks\": [\n126:           {\n127:             \"type\": \"command\",\n128:             \"command\": \"bash -c 'cd \\\"${CODEX_PROJECT_DIR:-$PWD}\\\" && node .skilled/hooks/env-secret-guard/command-hook/env-secret-guard.cjs || { printf \\\"%s\\\\n\\\" \\\"mk-hook-drift host=codex event=PreToolUse adapter=env-secret-guard.cjs\\\" >&2; printf %s \\\"{\\\\\\\"hookSpecificOutput\\\\\\\":{\\\\\\\"hookEventName\\\\\\\":\\\\\\\"PreToolUse\\\\\\\",\\\\\\\"additionalContext\\\\\\\":\\\\\\\"mk codex hook could not resolve; build the spec-kit runtime (npm --prefix .skilled/skills/system-spec-kit run build) or restore the missing adapter\\\\\\\"}}\\\"; }'\",\n129:             \"timeout\": 10\n130:           }\n131:         ]\n132:       }\n133:     ],\n134:     \"PostToolUse\": [\n135:       {\n136:         \"matcher\": \"apply_patch|edit\",\n137:         \"hooks\": [\n138:           {\n139:             \"type\": \"command\",\n140:             \"command\": \"bash -c 'cd \\\"${CODEX_PROJECT_DIR:-$PWD}\\\" && node .skilled/hooks/post-edit-quality/codex/post-edit-quality.cjs || { printf \\\"%s\\\\n\\\" \\\"mk-hook-drift host=codex event=PostToolUse adapter=post-edit-quality.cjs\\\" >&2; printf %s \\\"{\\\\\\\"hookSpecificOutput\\\\\\\":{\\\\\\\"hookEventName\\\\\\\":\\\\\\\"PostToolUse\\\\\\\",\\\\\\\"additionalContext\\\\\\\":\\\\\\\"mk codex hook could not resolve; build the spec-kit runtime (npm --prefix .skilled/skills/system-spec-kit run build) or restore the missing adapter\\\\\\\"}}\\\"; }'\",\n141:             \"timeout\": 10\n142:           }\n143:         ]\n144:       },\n145:       {\n146:         \"matcher\": \"exec|Bash\",\n147:         \"hooks\": [\n148:           {\n149:             \"type\": \"command\",\n150:             \"command\": \"bash -c 'cd \\\"${CODEX_PROJECT_DIR:-$PWD}\\\" && node .skilled/hooks/dispatch/codex/dispatch-audit-posttooluse.mjs || { printf \\\"%s\\\\n\\\" \\\"mk-hook-drift host=codex event=PostToolUse adapter=dispatch-audit-posttooluse.mjs\\\" >&2; printf %s \\\"{\\\\\\\"hookSpecificOutput\\\\\\\":{\\\\\\\"hookEventName\\\\\\\":\\\\\\\"PostToolUse\\\\\\\",\\\\\\\"additionalContext\\\\\\\":\\\\\\\"mk codex hook could not resolve; build the spec-kit runtime (npm --prefix .skilled/skills/system-spec-kit run build) or restore the missing adapter\\\\\\\"}}\\\"; }'\",\n151:             \"timeout\": 5\n152:           }\n153:         ]\n154:       },\n155:       {\n156:         \"hooks\": [\n157:           {\n158:             \"type\": \"command\",\n159:             \"command\": \"bash -c 'cd \\\"${CODEX_PROJECT_DIR:-$PWD}\\\" && node .skilled/hooks/session-relaunch/codex/context-nudge.mjs || { printf \\\"%s\\\\n\\\" \\\"mk-hook-drift host=codex event=PostToolUse adapter=context-nudge.mjs\\\" >&2; printf %s \\\"{\\\\\\\"hookSpecificOutput\\\\\\\":{\\\\\\\"hookEventName\\\\\\\":\\\\\\\"PostToolUse\\\\\\\",\\\\\\\"additionalContext\\\\\\\":\\\\\\\"mk codex hook could not resolve; build the spec-kit runtime (npm --prefix .skilled/skills/system-spec-kit run build) or restore the missing adapter\\\\\\\"}}\\\"; }'\",\n160:             \"timeout\": 5\n161:           }\n162:         ]\n163:       },\n164:       {\n165:         \"matcher\": \"exec|Bash\",\n166:         \"hooks\": [\n167:           {\n168:             \"type\": \"command\",\n169:             \"command\": \"bash -c 'cd \\\"${CODEX_PROJECT_DIR:-$PWD}\\\" && node .skilled/hooks/env-secret-guard/command-hook/env-secret-guard-after.cjs || { printf \\\"%s\\\\n\\\" \\\"mk-hook-drift host=codex event=PostToolUse adapter=env-secret-guard-after.cjs\\\" >&2; 