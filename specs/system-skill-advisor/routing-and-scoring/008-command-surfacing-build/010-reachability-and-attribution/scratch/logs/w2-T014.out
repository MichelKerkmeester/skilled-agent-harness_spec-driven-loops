{"type":"tool_use","timestamp":1794528138111,"sessionID":"ses_e2dcb3598ffevqcAV0JB0ZlAmZ","part":{"partID":"prt_1d236537000132bxN2qxwjqVv3","sessionID":"ses_e2dcb3598ffevqcAV0JB0ZlAmZ","messageID":"msg_1d23647ff001eSBsIVYyBcv1AV","type":"tool","id":"call_17f9d4d821e041a3ad8264bc","tool":"read","state":{"status":"completed","input":{"path":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/commands/doctor/scripts/tests/doctor-runtime-mirrors-contract.test.cjs"},"output":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/commands/doctor/scripts/tests/doctor-runtime-mirrors-contract.test.cjs, lines 1-301\n1: #!/usr/bin/env node\n2: // ───────────────────────────────────────────────────────────────────\n3: // MODULE: Doctor Runtime Mirrors Contract Tests\n4: // ───────────────────────────────────────────────────────────────────\n5: 'use strict';\n6: \n7: /**\n8:  * The runtime-mirrors route and its workflow are two halves of one contract: the\n9:  * manifest declares which checkers run, and the workflow has to invoke each one\n10:  * in its check-only form. A mirror check the repository's CI runs but this pair\n11:  * omits is the failure mode worth a test, because a local run then reports in\n12:  * sync while the remote run fails on the same tree.\n13:  *\n14:  * DSH checks are asserted in the shape their neighbours use,\n15:  * including the n/a rule: an absent runtime tree is reported as n/a rather than\n16:  * created, so a read-only diagnostic never has a write side effect.\n17:  *\n18:  * Both files resolve through an environment override so the removed-line case can\n19:  * be exercised against a copy in a scratch directory instead of by deleting a\n20:  * line from a tracked file.\n21:  */\n22: \n23: // ─────────────────────────────────────────────────────────────────────────────\n24: // 1. IMPORTS AND PATHS\n25: // ─────────────────────────────────────────────────────────────────────────────\n26: \n27: const assert = require('node:assert/strict');\n28: const fs = require('node:fs');\n29: const path = require('node:path');\n30: const test = require('node:test');\n31: const { parse: parseYaml } = require('yaml');\n32: \n33: const REPO_ROOT = path.resolve(__dirname, '..', '..', '..', '..', '..');\n34: const COMMANDS_DIR = path.join(REPO_ROOT, '.skilled', 'commands', 'doctor');\n35: const ASSETS_DIR = path.join(COMMANDS_DIR, 'assets');\n36: const ROUTES_PATH = process.env.DOCTOR_ROUTES_MANIFEST || path.join(COMMANDS_DIR, '_routes.yaml');\n37: const WORKFLOW_PATH =\n38:   process.env.DOCTOR_RUNTIME_MIRRORS_WORKFLOW || path.join(ASSETS_DIR, 'doctor-runtime-mirrors.yaml');\n39: \n40: const ROUTE_TARGET = 'runtime-mirrors';\n41: const AGENT_BODY_PARITY = {\n42:   key: 'agent_body_parity',\n43:   script: '.skilled/bin/check-agent-mirror-sync.cjs',\n44: };\n45: \n46: // Each mirror check names its surface, runtime tree and upstream_assets key. The\n47: // surface and tree are asserted so the diagnostic says what it checks and skips.\n48: const DSH_CHECKS = [\n49:   {\n50:     key: 'dsh_skills',\n51:     script: '.skilled/skills/system-spec-kit/runtime/cli/dsh/sync-skills-dsh.cjs',\n52:     surface: '.dsh/skills',\n53:     tree: '.dsh/',\n54:   },\n55:   {\n56:     key: 'dsh_prompts',\n57:     script: '.skilled/skills/system-spec-kit/runtime/cli/dsh/sync-prompts-dsh.cjs',\n58:     surface: '.dsh/prompts',\n59:     tree: '.dsh/',\n60:   },\n61:   {\n62:     key: 'dsh_agents',\n63:     script: '.skilled/skills/system-spec-kit/runtime/cli/dsh/sync-agents-dsh.cjs',\n64:     surface: '.dsh/agents',\n65:     tree: '.dsh/',\n66:   },\n67: ];\n68: const MIRROR_CHECKS = DSH_CHECKS;\n69: \n70: // ─────────────────────────────────────────────────────────────────────────────\n71: // 2. READERS AND SMALL HELPERS\n72: // ─────────────────────────────────────────────────────────────────────────────\n73: \n74: function read(absolutePath) {\n75:   return fs.readFileSync(absolutePath, 'utf8');\n76: }\n77: \n78: function tokens(entry) {\n79:   return String(entry).split(/\\s+/).filter(Boolean);\n80: }\n81: \n82: function deleteLines(source, predicate) {\n83:   return source.split('\\n').filter((line) => !predicate(line)).join('\\n');\n84: }\n85: \n86: function runtimeMirrorsRoute(manifestText) {\n87:   const manifest = parseYaml(manifestText);\n88:   const routes = manifest && Array.isArray(manifest.routes) ? manifest.routes : [];\n89:   const route = routes.find((entry) => entry && entry.target === ROUTE_TARGET);\n90:   assert.ok(route, `no route with target '${ROUTE_TARGET}' in ${ROUTES_PATH}`);\n91:   return route;\n92: }\n93: \n94: // ─────────────────────────────────────────────────────────────────────────────\n95: // 3. GAP DETECTION, PURE SO A REMOVED LINE IS OBSERVABLE\n96: // ─────────────────────────────────────────────────────────────────────────────\n97: \n98: /** Manifest gaps: a mirror check missing from script_invocations, or not check-only. */\n99: function routeGaps(manifestText) {\n100:   const route = runtimeMirrorsRoute(manifestText);\n101:   const invocations = Array.isArray(route.script_invocations) ? route.script_invocations : [];\n102:   const gaps = [];\n103:   for (const check of MIRROR_CHECKS) {\n104:     const entry = invocations.find((invocation) => tokens(invocation).includes(check.script));\n105:     if (!entry) {\n106:       gaps.push(`script_invocations never runs ${check.script}`);\n107:       continue;\n108:     }\n109:     if (tokens(entry)[0] !== 'node') {\n110:       gaps.push(`${check.script} is not invoked through node`);\n111:     }\n112:     if (!tokens(entry).includes('--check')) {\n113:       gaps.push(`${check.script} is not in its --check form`);\n114:     }\n115:   }\n116:   return gaps;\n117: }\n118: \n119: /** Workflow gaps: no upstream_assets entry, or no step with the surface and n/a rule. */\n120: function workflowGaps(workflowText) {\n121:   const document = parseYaml(workflowText);\n122:   const assets = (document && document.upstream_assets) || {};\n123:   const steps = document && document.execution && Array.isArray(document.execution.steps)\n124:     ? document.execution.steps\n125:     : [];\n126:   const gaps = [];\n127: \n128:   for (const check of MIRROR_CHECKS) {\n129:     if (assets[check.key] !== check.script) {\n130:       gaps.push(`upstream_assets.${check.key} does not name ${check.script}`);\n131:     }\n132: \n133:     const step = steps.find((entry) => typeof entry === 'string' && entry.includes(`upstream_assets.${check.key}`));\n134:     if (!step) {\n135:       gaps.push(`no execution step runs upstream_assets.${check.key}`);\n136:       continue;\n137:     }\n138:     if (!step.includes('--check')) {\n139:       gaps.push(`the ${check.key} step does not run the check-only form`);\n140:     }\n141:     if (!step.includes(check.surface)) {\n142:       gaps.push(`the ${check.key} step does not name the ${check.surface} surface it covers`);\n143:     }\n144:     if (!/\\bn\\/a\\b/.test(step)) {\n145:       gaps.push(`the ${check.key} step never reports n/a`);\n146:     }\n147:     if (!step.includes(check.tree)) {\n148:       gaps.push(`the ${check.key} step never names the ${check.tree} tree whose absence makes it n/a`);\n149:     }\n150:     if (!/never creates/i.test(step)) {\n151:       gaps.push(`the ${check.key} step does not say the run never creates ${check.tree}`);\n152:     }\n153:   }\n154:   return gaps;\n155: }\n156: \n157: /** Output gaps: no repair line, a repair line that is the check form, or an unrendered one. */\n158: function repairGaps(workflowText) {\n159:   const document = parseYaml(workflowText);\n160:   const outputLines = String((document && document.output) || '').split('\\n');\n161:   const gaps = [];\n162: \n163:   for (const check of MIRROR_CHECKS) {\n164:     const line = outputLines.find((candidate) => candidate.includes(check.script));\n165:     if (!line) {\n166:       gaps.push(`the output block carries no repair line for ${check.script}`);\n167:       continue;\n168:     }\n169:     if (line.includes('--check')) {\n170:       gaps.push(`the repair line for ${check.script} is the check form, not the generator`);\n171:     }\n172:     if (!line.includes('->')) {\n173:       gaps.push(`the repair line for ${check.script} is not rendered as \"<surface> -> <command>\"`);\n174:     }\n175:   }\n176:   return gaps;\n177: }\n178: \n179: // ─────────────────────────────────────────────────────────────────────────────\n180: // 4. THE MANIFEST AND WORKFLOW AS THEY SHIP\n181: // ─────────────────────────────────────────────────────────────────────────────\n182: \n183: test('the route declares all DSH checks in their check-only form', () => {\n184:   assert.deepEqual(routeGaps(read(ROUTES_PATH)), []);\n185: });\n186: \n187: test('the workflow names all mirror checks and reports n/a when a runtime tree is absent', () => {\n188:   assert.deepEqual(workflowGaps(read(WORKFLOW_PATH)), []);\n189: });\n190: \n191: test('agent body parity runs after the roster check and reports its comparison outcomes', () => {\n192:   const route = runtimeMirrorsRoute(read(ROUTES_PATH));\n193:   const invocation = (route.script_invocations || []).find((entry) => tokens(entry).includes(AGENT_BODY_PARITY.script));\n194:   assert.ok(invocation, `script_invocations never runs ${AGENT_BODY_PARITY.script}`);\n195:   assert.equal(tokens(invocation)[0], 'node');\n196:   assert.ok(tokens(invocation).includes('--all'));\n197: \n198:   const workflow = parseYaml(read(WORKFLOW_PATH));\n199:   assert.equal(workflow.upstream_assets[AGENT_BODY_PARITY.key], AGENT_BODY_PARITY.script);\n200:   const steps = workflow.execution.steps;\n201:   const rosterIndex = steps.findIndex((step) => step.includes('upstream_assets.agent_roster'));\n202:   const parityIndex = steps.findIndex((step) => step.includes(`upstream_assets.${AGENT_BODY_PARITY.key}`));\n203:   assert.ok(rosterIndex >= 0, 'the workflow has no agent roster step');\n204:   assert.equal(parityIndex, rosterIndex + 1, 'agent body parity follows the agent roster step');\n205: \n206:   const step = steps[parityIndex];\n207:   assert.match(step, /with --all/);\n208:   assert.match(step, /same-file mirrors and non-comparable formats are reported, not counted as matches/i);\n209:   assert.match(step, /Exit 0 = all comparable mirrors in sync/);\n210:   assert.match(step, /1 = drift or comparison failure/);\n211:   assert.match(step, /2 = checker invocation error \\(unknown option\\)/);\n212:   assert.match(step, /3 = not checkable \\(frontmatter parser unavailable\\)/);\n213: });\n214: \n215: test('the output block carries a generator repair line for every mirror check', () => {\n216:   assert.deepEqual(repairGaps(read(WORKFLOW_PATH)), []);\n217: });\n218: \n219: test('agent body parity output names the real-file and generated mirror repairs', () => {\n220:   const output = String(parseYaml(read(WORKFLOW_PATH)).output || '');\n221:   const repair = output.split('\\n').find((line) => line.includes(AGENT_BODY_PARITY.script));\n222:   assert.ok(repair, 'agent body parity has a repair line');\n223:   assert.match(repair, /\\.claude\\/agents is a hand-maintained real-file mirror/u);\n224:   assert.match(repair, /runtime\\/cli\\/codex\\/sync-agents\\.cjs/u);\n225:   assert.match(repair, /runtime\\/cli\\/pi\\/sync-agents-pi\\.cjs/u);\n226:   assert.match(repair, /runtime\\/cli\\/runtime-mirrors\\/sync-runtime-mirrors\\.cjs/u);\n227: });\n228: \n229: test('the route stays read-only and never runs a mirror generator in write mode', () => {\n230:   const route = runtimeMirrorsRoute(read(ROUTES_PATH));\n231:   assert.equal(route.mutating, 'read-only');\n232: \n233:   const writers = (route.script_invocations || []).filter((entry) => {\n234:     const parts = tokens(entry);\n235:     const namesGenerator = parts.some((token) => /(?:^|\\/)(?:sync-|install-)[\\w.-]+\\.(?:cjs|mjs)$/.test(token));\n236:     return namesGenerator && !parts.includes('--check');\n237:   });\n238:   assert.deepEqual(writers, [], 'every generator invocation must carry --check');\n239: \n240:   const boundaries = parseYaml(read(WORKFLOW_PATH)).mutation_boundaries || {};\n241:   assert.equal(boundaries.read_only, true);\n242:   assert.ok((boundaries.forbidden_targets || []).includes('**/*'));\n243: });\n244: \n245: // ─────────────────────────────────────────────────────────────────────────────\n246: // 5. THE CONTRACT FAILS WHEN EITHER LINE GOES MISSING\n247: // ─────────────────────────────────────────────────────────────────────────────\n248: \n249: test('the contract fails when a mirror line is removed from the route', () => {\n250:   const manifestText = read(ROUTES_PATH);\n251:   for (const check of MIRROR_CHECKS) {\n252:     const stripped = deleteLines(manifestText, (line) => line.includes(check.script));\n253:     const gaps = routeGaps(stripped);\n254:     assert.ok(\n255:       gaps.some((gap) => gap.includes(check.script)),\n256:       `removing ${check.script} from script_invocations went unnoticed`,\n257:     );\n258:   }\n259: });\n260: \n261: test('the contract fails when a mirror asset, step or repair line leaves the workflow', () => {\n262:   const workflowText = read(WORKFLOW_PATH);\n263:   for (const check of MIRROR_CHECKS) {\n264:     const withoutAsset = deleteLines(workflowText, (line) => line.includes(check.script));\n265:     assert.ok(\n266:       workflowGaps(withoutAsset).some((gap) => gap.includes(`upstream_assets.${check.key}`)),\n267:       `removing upstream_assets.${check.key} went unnoticed`,\n268:     );\n269: \n270:     const withoutStep = deleteLines(workflowText, (line) => line.includes(`upstream_assets.${check.key}`));\n271:     assert.ok(\n272:       workflowGaps(withoutStep).some((gap) => gap.includes(`no execution step runs upstream_assets.${check.key}`)),\n273:       `removing the ${check.key} step went unnoticed`,\n274:     );\n275: \n276:     const withoutRepair = deleteLines(\n277:       workflowText,\n278:       (line) => line.includes(check.script) && line.includes('->'),\n279:     );\n280:     assert.ok(\n281:       repairGaps(withoutRepair).some((gap) => gap.includes(check.script)),\n282:       `removing the ${check.script} repair line went unnoticed`,\n283:     );\n284:   }\n285: });\n286: \n287: test('the contract fails when a step loses its n/a rule or names no surface', () => {\n288:   const workflowText = read(WORKFLOW_PATH);\n289:   for (const check of MIRROR_CHECKS) {\n290:     const bareStep = workflowText\n291:       .split('\\n')\n292:       .map((line) => {\n293:         if (!line.includes(`upstream_assets.${check.key}`)) return line;\n294:         return line.replace(/\\bn\\/a\\b/g, 'nothing').replace(check.surface, 'the tree');\n295:       })\n296:       .join('\\n');\n297:     const gaps = workflowGaps(bareStep);\n298:     assert.ok(gaps.some((gap) => gap.includes(`the ${check.key} step never reports n/a`)));\n299:     assert.ok(gaps.some((gap) => gap.includes(`the ${check.key} step does not name the ${check.surface} surface`)));\n300:   }\n301: });","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/commands/doctor/scripts/tests/doctor-runtime-mirrors-contract.test.cjs, lines 1-301\n1: #!/usr/bin/env node\n2: // ───────────────────────────────────────────────────────────────────\n3: // MODULE: Doctor Runtime Mirrors Contract Tests\n4: // ───────────────────────────────────────────────────────────────────\n5: 'use strict';\n6: \n7: /**\n8:  * The runtime-mirrors route and its workflow are two halves of one contract: the\n9:  * manifest declares which checkers run, and the workflow has to invoke each one\n10:  * in its check-only form. A mirror check the repository's CI runs but this pair\n11:  * omits is the failure mode worth a test, because a local run then reports in\n12:  * sync while the remote run fails on the same tree.\n13:  *\n14:  * DSH checks are asserted in the shape their neighbours use,\n15:  * including the n/a rule: an absent runtime tree is reported as n/a rather than\n16:  * created, so a read-only diagnostic never has a write side effect.\n17:  *\n18:  * Both files resolve through an environment override so the removed-line case can\n19:  * be exercised against a copy in a scratch directory instead of by deleting a\n20:  * line from a tracked file.\n21:  */\n22: \n23: // ─────────────────────────────────────────────────────────────────────────────\n24: // 1. IMPORTS AND PATHS\n25: // ─────────────────────────────────────────────────────────────────────────────\n26: \n27: const assert = require('node:assert/strict');\n28: const fs = require('node:fs');\n29: const path = require('node:path');\n30: const test = require('node:test');\n31: const { parse: parseYaml } = require('yaml');\n32: \n33: const REPO_ROOT = path.resolve(__dirname, '..', '..', '..', '..', '..');\n34: const COMMANDS_DIR = path.join(REPO_ROOT, '.skilled', 'commands', 'doctor');\n35: const ASSETS_DIR = path.join(COMMANDS_DIR, 'assets');\n36: const ROUTES_PATH = process.env.DOCTOR_ROUTES_MANIFEST || path.join(COMMANDS_DIR, '_routes.yaml');\n37: const WORKFLOW_PATH =\n38:   process.env.DOCTOR_RUNTIME_MIRRORS_WORKFLOW || path.join(ASSETS_DIR, 'doctor-runtime-mirrors.yaml');\n39: \n40: const ROUTE_TARGET = 'runtime-mirrors';\n41: const AGENT_BODY_PARITY = {\n42:   key: 'agent_body_parity',\n43:   script: '.skilled/bin/check-agent-mirror-sync.cjs',\n44: };\n45: \n46: // Each mirror check names its surface, runtime tree and upstream_assets key. The\n47: // surface and tree are asserted so the diagnostic says what it checks and skips.\n48: const DSH_CHECKS = [\n49:   {\n50:     key: 'dsh_skills',\n51:     script: '.skilled/skills/system-spec-kit/runtime/cli/dsh/sync-skills-dsh.cjs',\n52:     surface: '.dsh/skills',\n53:     tree: '.dsh/',\n54:   },\n55:   {\n56:     key: 'dsh_prompts',\n57:     script: '.skilled/skills/system-spec-kit/runtime/cli/dsh/sync-prompts-dsh.cjs',\n58:     surface: '.dsh/prompts',\n59:     tree: '.dsh/',\n60:   },\n61:   {\n62:     key: 'dsh_agents',\n63:     script: '.skilled/skills/system-spec-kit/runtime/cli/dsh/sync-agents-dsh.cjs',\n64:     surface: '.dsh/agents',\n65:     tree: '.dsh/',\n66:   },\n67: ];\n68: const MIRROR_CHECKS = DSH_CHECKS;\n69: \n70: // ─────────────────────────────────────────────────────────────────────────────\n71: // 2. READERS AND SMALL HELPERS\n72: // ─────────────────────────────────────────────────────────────────────────────\n73: \n74: function read(absolutePath) {\n75:   return fs.readFileSync(absolutePath, 'utf8');\n76: }\n77: \n78: function tokens(entry) {\n79:   return String(entry).split(/\\s+/).filter(Boolean);\n80: }\n81: \n82: function deleteLines(source, predicate) {\n83:   return source.split('\\n').filter((line) => !predicate(line)).join('\\n');\n84: }\n85: \n86: function runtimeMirrorsRoute(manifestText) {\n87:   const manifest = parseYaml(manifestText);\n88:   const routes = manifest && Array.isArray(manifest.routes) ? manifest.routes : [];\n89:   const route = routes.find((entry) => entry && entry.target === ROUTE_TARGET);\n90:   assert.ok(route, `no route with target '${ROUTE_TARGET}' in ${ROUTES_PATH}`);\n91:   return route;\n92: }\n93: \n94: // ─────────────────────────────────────────────────────────────────────────────\n95: // 3. GAP DETECTION, PURE SO A REMOVED LINE IS OBSERVABLE\n96: // ─────────────────────────────────────────────────────────────────────────────\n97: \n98: /** Manifest gaps: a mirror check missing from script_invocations, or not check-only. */\n99: function routeGaps(manifestText) {\n100:   const route = runtimeMirrorsRoute(manifestText);\n101:   const invocations = Array.isArray(route.script_invocations) ? route.script_invocations : [];\n102:   const gaps = [];\n103:   for (const check of MIRROR_CHECKS) {\n104:     const entry = invocations.find((invocation) => tokens(invocation).includes(check.script));\n105:     if (!entry) {\n106:       gaps.push(`script_invocations never runs ${check.script}`);\n107:       continue;\n108:     }\n109:     if (tokens(entry)[0] !== 'node') {\n110:       gaps.push(`${check.script} is not invoked through node`);\n111:     }\n112:     if (!tokens(entry).includes('--check')) {\n113:       gaps.push(`${check.script} is not in its --check form`);\n114:     }\n115:   }\n116:   return gaps;\n117: }\n118: \n119: /** Workflow gaps: no upstream_assets entry, or no step with the surface and n/a rule. */\n120: function workflowGaps(workflowText) {\n121:   const document = parseYaml(workflowText);\n122:   const assets = (document && document.upstream_assets) || {};\n123:   const steps = document && document.execution && Array.isArray(document.execution.steps)\n124:     ? document.execution.steps\n125:     : [];\n126:   const gaps = [];\n127: \n128:   for (const check of MIRROR_CHECKS) {\n129:     if (assets[check.key] !== check.script) {\n130:       gaps.push(`upstream_assets.${check.key} does not name ${check.script}`);\n131:     }\n132: \n133:     const step = steps.find((entry) => typeof entry === 'string' && entry.includes(`upstream_assets.${check.key}`));\n134:     if (!step) {\n135:       gaps.push(`no execution step runs upstream_assets.${check.key}`);\n136:       continue;\n137:     }\n138:     if (!step.includes('--check')) {\n139:       gaps.push(`the ${check.key} step does not run the check-only form`);\n140:     }\n141:     if (!step.includes(check.surface)) {\n142:       gaps.push(`the ${check.key} step does not name the ${check.surface} surface it covers`);\n143:     }\n144:     if (!/\\bn\\/a\\b/.test(step)) {\n145:       gaps.push(`the ${check.key} step never reports n/a`);\n146:     }\n147:     if (!step.includes(check.tree)) {\n148:       gaps.push(`the ${check.key} step never names the ${check.tree} tree whose absence makes it n/a`);\n149:     }\n150:     if (!/never creates/i.test(step)) {\n151:       gaps.push(`the ${check.key} step does not say the run never creates ${check.tree}`);\n152:     }\n153:   }\n154:   return gaps;\n155: }\n156: \n157: /** Output gaps: no repair line, a repair line that is the check form, or an unrendered one. */\n158: function repairGaps(workflowText) {\n159:   const document = parseYaml(workflowText);\n160:   const outputLines = String((document && document.output) || '').split('\\n');\n161:   const gaps = [];\n162: \n163:   for (const check of MIRROR_CHECKS) {\n164:     const line = outputLines.find((candidate) => candidate.includes(check.script));\n165:     if (!line) {\n166:       gaps.push(`the output block carries no repair line for ${check.script}`);\n167:       continue;\n168:     }\n169:     if (line.includes('--check')) {\n170:       gaps.push(`the repair line for ${check.script} is the check form, not the generator`);\n171:     }\n172:     if (!line.includes('->')) {\n173:       gaps.push(`the repair line for ${check.script} is not rendered as \"<surface> -> <command>\"`);\n174:     }\n175:   }\n176:   return gaps;\n177: }\n178: \n179: // ─────────────────────────────────────────────────────────────────────────────\n180: // 4. THE MANIFEST AND WORKFLOW AS THEY SHIP\n181: // ─────────────────────────────────────────────────────────────────────────────\n182: \n183: test('the route declares all DSH checks in their check-only form', () => {\n184:   assert.deepEqual(routeGaps(read(ROUTES_PATH)), []);\n185: });\n186: \n187: test('the workflow names all mirror checks and reports n/a when a runtime tree is absent', () => {\n188:   assert.deepEqual(workflowGaps(read(WORKFLOW_PATH)), []);\n189: });\n190: \n191: test('agent body parity runs after the roster check and reports its comparison outcomes', () => {\n192:   const route = runtimeMirrorsRoute(read(ROUTES_PATH));\n193:   const invocation = (route.script_invocations || []).find((entry) => tokens(entry).includes(AGENT_BODY_PARITY.script));\n194:   assert.ok(invocation, `script_invocations never runs ${AGENT_BODY_PARITY.script}`);\n195:   assert.equal(tokens(invocation)[0], 'node');\n196:   assert.ok(tokens(invocation).includes('--all'));\n197: \n198:   const workflow = parseYaml(read(WORKFLOW_PATH));\n199:   assert.equal(workflow.upstream_assets[AGENT_BODY_PARITY.key], AGENT_BODY_PARITY.script);\n200:   const steps = workflow.execution.steps;\n201:   const rosterIndex = steps.findIndex((step) => step.includes('upstream_assets.agent_roster'));\n202:   const parityIndex = steps.findIndex((step) => step.includes(`upstream_assets.${AGENT_BODY_PARITY.key}`));\n203:   assert.ok(rosterIndex >= 0, 'the workflow has no agent roster step');\n204:   assert.equal(parityIndex, rosterIndex + 1, 'agent body parity follows the agent roster step');\n205: \n206:   const step = steps[parityIndex];\n207:   assert.match(step, /with --all/);\n208:   assert.match(step, /same-file mirrors and non-comparable formats are reported, not counted as matches/i);\n209:   assert.match(step, /Exit 0 = all comparable mirrors in sync/);\n210:   assert.match(step, /1 = drift or comparison failure/);\n211:   assert.match(step, /2 = checker invocation error \\(unknown option\\)/);\n212:   assert.match(step, /3 = not checkable \\(frontmatter parser unavailable\\)/);\n213: });\n214: \n215: test('the output block carries a generator repair line for every mirror check', () => {\n216:   assert.deepEqual(repairGaps(read(WORKFLOW_PATH)), []);\n217: });\n218: \n219: test('agent body parity output names the real-file and generated mirror repairs', () => {\n220:   const output = String(parseYaml(read(WORKFLOW_PATH)).output || '');\n221:   const repair = output.split('\\n').find((line) => line.includes(AGENT_BODY_PARITY.script));\n222:   assert.ok(repair, 'agent body parity has a repair line');\n223:   assert.match(repair, /\\.claude\\/agents is a hand-maintained real-file mirror/u);\n224:   assert.match(repair, /runtime\\/cli\\/codex\\/sync-agents\\.cjs/u);\n225:   assert.match(repair, /runtime\\/cli\\/pi\\/sync-agents-pi\\.cjs/u);\n226:   assert.match(repair, /runtime\\/cli\\/runtime-mirrors\\/sync-runtime-mirrors\\.cjs/u);\n227: });\n228: \n229: test('the route stays read-only and never runs a mirror generator in write mode', () => {\n230:   const route = runtimeMirrorsRoute(read(ROUTES_PATH));\n231:   assert.equal(route.mutating, 'read-only');\n232: \n233:   const writers = (route.script_invocations || []).filter((entry) => {\n234:     const parts = tokens(entry);\n235:     const namesGenerator = parts.some((token) => /(?:^|\\/)(?:sync-|install-)[\\w.-]+\\.(?:cjs|mjs)$/.test(token));\n236:     return namesGenerator && !parts.includes('--check');\n237:   });\n238:   assert.deepEqual(writers, [], 'every generator invocation must carry --check');\n239: \n240:   const boundaries = parseYaml(read(WORKFLOW_PATH)).mutation_boundaries || {};\n241:   assert.equal(boundaries.read_only, true);\n242:   assert.ok((boundaries.forbidden_targets || []).includes('**/*'));\n243: });\n244: \n245: // ─────────────────────────────────────────────────────────────────────────────\n246: // 5. THE CONTRACT FAILS WHEN EITHER LINE GOES MISSING\n247: // ─────────────────────────────────────────────────────────────────────────────\n248: \n249: test('the contract fails when a mirror line is removed from the route', () => {\n250:   const manifestText = read(ROUTES_PATH);\n251:   for (const check of MIRROR_CHECKS) {\n252:     const stripped = deleteLines(manifestText, (line) => line.includes(check.script));\n253:     const gaps = routeGaps(stripped);\n254:     assert.ok(\n255:       gaps.some((gap) => gap.includes(check.script)),\n256:       `removing ${check.script} from script_invocations went unnoticed`,\n257:     );\n258:   }\n259: });\n260: \n261: test('the contract fails when a mirror asset, step or repair line leaves the workflow', () => {\n262:   const workflowText = read(WORKFLOW_PATH);\n263:   for (const check of MIRROR_CHECKS) {\n264:     const withoutAsset = deleteLines(workflowText, (line) => line.includes(check.script));\n265:     assert.ok(\n266:       workflowGaps(withoutAsset).some((gap) => gap.includes(`upstream_assets.${check.key}`)),\n267:       `removing upstream_assets.${check.key} went unnoticed`,\n268:     );\n269: \n270:     const withoutStep = deleteLines(workflowText, (line) => line.includes(`upstream_assets.${check.key}`));\n271:     assert.ok(\n272:       workflowGaps(withoutStep).some((gap) => gap.includes(`no execution step runs upstream_assets.${check.key}`)),\n273:       `removing the ${check.key} step went unnoticed`,\n274:     );\n275: \n276:     const withoutRepair = deleteLines(\n277:       workflowText,\n278:       (line) => line.includes(check.script) && line.includes('->'),\n279:     );\n280:     assert.ok(\n281:       repairGaps(withoutRepair).some((gap) => gap.includes(check.script)),\n282:       `removing the ${check.script} repair line went unnoticed`,\n283:     );\n284:   }\n285: });\n286: \n287: test('the contract fails when a step loses its n/a rule or names no surface', () => {\n288:   const workflowText = read(WORKFLOW_PATH);\n289:   for (const check of MIRROR_CHECKS) {\n290:     const bareStep = workflowText\n291:       .split('\\n')\n292:       .map((line) => {\n293:         if (!line.includes(`upstream_assets.${check.key}`)) return line;\n294:         return line.replace(/\\bn\\/a\\b/g, 'nothing').replace(check.surface, 'the tree');\n295:       })\n296:       .join('\\n');\n297:     const gaps = workflowGaps(bareStep);\n298:     assert.ok(gaps.some((gap) => gap.includes(`the ${check.key} step never reports n/a`)));\n299:     assert.ok(gaps.some((gap) => gap.includes(`the ${check.key} step does not name the ${check.surface} surface`)));\n300:   }\n301: });"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/commands/doctor/scripts/tests/doctor-runtime-mirrors-contract.test.cjs\"}"},"time":{"start":1794528138096,"end":1794528138111}}}}
{"type":"step_finish","timestamp":1794528142140,"sessionID":"ses_e2dcb3598ffevqcAV0JB0ZlAmZ","part":{"id":"prt_1d236633c001Htk4ZzDsvg2aA5","sessionID":"ses_e2dcb3598ffevqcAV0JB0ZlAmZ","messageID":"msg_1d23647ff001eSBsIVYyBcv1AV","type":"step-finish","reason":"tool-calls","snapshot":"dddc0d06d7862c036facb65f2e30c8d9cb2c0a48","cost":0,"tokens":{"input":641,"output":81,"reasoning":0,"cache":{"read":35456,"write":0}}}}
{"type":"step_start","timestamp":1794528146139,"sessionID":"ses_e2dcb3598ffevqcAV0JB0ZlAmZ","part":{"id":"prt_1d23672db001QRv27cGexqAlZC","sessionID":"ses_e2dcb3598ffevqcAV0JB0ZlAmZ","messageID":"msg_1d2366342001odH5Mfmf8VDUWY","type":"step-start","snapshot":"6b7c448ac00ecd5e3505d5f1fc2bbdc18206b745"}}
{"type":"tool_use","timestamp":1794528155830,"sessionID":"ses_e2dcb3598ffevqcAV0JB0ZlAmZ","part":{"partID":"prt_1d2369548001qO6m0Jaxkgb1uw","sessionID":"ses_e2dcb3598ffevqcAV0JB0ZlAmZ","messageID":"msg_1d2366342001odH5Mfmf8VDUWY","type":"tool","id":"call_d57c2fc98dbf4575ac2764f1","tool":"read","state":{"status":"completed","input":{"path":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/REPO RULES.md"},"output":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/REPO RULES.md, lines 1-108\n1: # REPO RULES\n2: \n3: Repo-local operating rules. `AGENTS.md` **Gate 5 (§2)** makes reading this mandatory\n4: before your first write of the session; this document then routes you to every rule\n5: file that governs what you are about to do. **It is a router, not a rulebook:** it\n6: holds no rules of its own.\n7: \n8: ---\n9: \n10: ## 1. HOW TO USE THIS\n11: \n12: 1. **Match on the action you are about to take**, not the topic of the request.\n13: 2. **Load before the action.** A rule read afterwards is a post-mortem.\n14: 3. **A file already in context is not re-read.**\n15: 4. **Every trigger that fires is loaded, not just the first.** They compose; the more\n16:    specific wins on conflict. Three and four firing at once is the normal case, not an\n17:    edge case.\n18: 5. **Nothing fires → `AGENTS.md` alone governs.** Do not hunt for a rule to apply.\n19: \n20: ### Precedence\n21: \n22: | Level | Source | Can be overridden? |\n23: |-------|--------|--------------------|\n24: | 1 | Every `AGENTS.md` §1 hard blocker, the Four Laws, PLAN-WORKFLOW LOCK, Comment Hygiene, and every mandatory gate in §2 | No |\n25: | 2 | An explicit, in-the-moment operator instruction | Not applicable, it is the instruction |\n26: | 3 | These rule files, and the guidance in a skill's `SKILL.md` | Only by level 1 or 2 |\n27: | 4 | General judgment | By anything above |\n28: \n29: A rule file may tighten `AGENTS.md`. None relaxes a HARD BLOCK or authorizes what\n30: `AGENTS.md` forbids. Gate 5 does not change that: it makes the **load** mandatory,\n31: while what you load stays at level 3, the obligation to read is tier 1, the content\n32: is not.\n33: \n34: ---\n35: \n36: ## 2. TRIGGER TABLE\n37: \n38: | You are about to… | Load | It settles |\n39: |-------------------|------|-----------|\n40: | Add a file, module, class, interface, option, layer, or dependency · write a spec or plan that adds one · generalize something that works · write \"flexible\", \"future-proof\", \"scalable\", \"extensible\", \"might need\", \"best practice\", \"while we're here\" · add a test beyond the coverage floor | [`prevent-overengineering.md`](.skilled/repo-rules/prevent-overengineering.md) | Whether this should exist at all, and at what size |\n41: | Touch a file outside the ask · fix something noticed in passing · change something else because it would make the fix easier · rename, reformat, or delete beyond the named area · deviate from an approved plan · decide what to do with the rest when part of the work is blocked · notice a defect, smell or stale comment outside the files in scope | [`scope-discipline.md`](.skilled/repo-rules/scope-discipline.md) | What is yours to change, and how to raise what isn't |\n42: | Say \"done\", \"works\", \"fixed\", \"passing\", \"no regressions\" · report a result · quote a number · act on a tool's or sub-agent's success report · close out a turn · report a file path or command output · write a completion summary or tick something off as done | [`evidence-and-proof.md`](.skilled/repo-rules/evidence-and-proof.md) | What counts as proof, how a green run lies, what an honest close-out contains |\n43: | Decide whether to hand work to another runtime at all · hand it to a CLI executor, sub-agent, fan-out lineage, or deep loop · compose the prompt one will act on · accept or quote what one returned · answer a judgment question from your own reading alone | [`delegation-and-orchestration.md`](.skilled/repo-rules/delegation-and-orchestration.md) | The orchestrating posture, what a brief must carry, why one model is one opinion |\n44: | Delete, overwrite, migrate, deploy, publish, send, install · force-push or rewrite history · change a shared contract · touch auth, data, or config · make any call that leaves this machine · truncate · touch branches, tags, or reflogs | [`blast-radius.md`](.skilled/repo-rules/blast-radius.md) | Reversibility, the rollback sentence, when to stop for a yes |\n45: | Diagnose a failure · make a red check green · attempt the same fix twice · add a special case, retry, sleep, or broadened catch · call a failure a flake, infra, or pre-existing | [`root-cause-and-debugging.md`](.skilled/repo-rules/root-cause-and-debugging.md) | Fixing the producer instead of the symptom, and when to level up to the seam |\n46: | Answer without certainty · contradict the operator · fill a gap with a plausible guess · hit a contradiction between two things that must both be true · name a path, flag, function, version, or number you have not verified · not know while a plausible answer is available · see sources disagree, or the code contradict the spec, the docs or the operator · the operator asserts something you believe is wrong · change a checked answer after pushback or doubt, or drop an approach before it concludes · cite a rule, restriction, policy, limit or permission, or decline a request | [`uncertainty-and-honesty.md`](.skilled/repo-rules/uncertainty-and-honesty.md) | Confidence bands, UNKNOWN, contradiction halts |\n47: | Write any substantive reply, an answer, an explanation, a close-out or a status · draft or edit any sentence a reader will read · present a recommendation, a fork, or a trade-off · start a multi-step stretch of work the reader will not see inside · report what a long autonomous run found · the reader says they did not follow or asks for a plainer version | [`communication.md`](.skilled/repo-rules/communication.md) | How a reply reads: answer first, one recommended path, length, filler, plain sentences, punctuation, and no table in a reply |\n48: | End a turn · report work done, blocked, or partly done · end a turn while something you started is still running · ask the operator anything · end a turn on a fork or two acceptable paths · continue past a decision nobody made | [`communication-handoff.md`](.skilled/repo-rules/communication-handoff.md) | What is the operator's to do next, what is still running and what resumes it, and when a question becomes a structured choice |\n49: | Wire, rewire or remove a mode in a parent-hub skill · edit a hub's registry, router, root `ROUTER.md`, `graph-metadata.json` or `SKILL.md` mode table, or a mode packet's own `ROUTER.md` · report that a mode is registered, routed, reachable or integrated · quote a per-hub gate result · create a new skill under a hub, or refactor one that already lives there | [`skill-hub-routing.md`](.skilled/repo-rules/skill-hub-routing.md) | The two routing stages, what \"integrated\" requires, and checking the hub you actually changed |\n50: \n51: ---\n52: \n53: ## 3. INDEX\n54: \n55: | Rule | Summary |\n56: |------|---------|\n57: | [Overengineering](.skilled/repo-rules/prevent-overengineering.md) | Build the smallest thing that solves the stated problem; take a costlier move only by naming what fails at the cheaper one. |\n58: | [Scope discipline](.skilled/repo-rules/scope-discipline.md) | The requested scope is the deliverable. Adjacent problems get named, not fixed. |\n59: | [Evidence and proof](.skilled/repo-rules/evidence-and-proof.md) | A claim is only as strong as the observation behind it, and a receipt confirms only what could have contradicted it. Distinguish observed from derived from inferred. |\n60: | [Delegation and orchestration](.skilled/repo-rules/delegation-and-orchestration.md) | Delegating makes you the orchestrator; brief with evidence, and no single model's verdict closes a question. |\n61: | [Blast radius](.skilled/repo-rules/blast-radius.md) | Size effort to what the change can break; no irreversible step without a named rollback and a yes. |\n62: | [Root cause](.skilled/repo-rules/root-cause-and-debugging.md) | Fix the producer, not the symptom; every fix names the mechanism that caused the failure. |\n63: | [Uncertainty and honesty](.skilled/repo-rules/uncertainty-and-honesty.md) | Never fabricate; mark the confidence you actually have and halt on a contradiction. |\n64: | [Communication](.skilled/repo-rules/communication.md) | Write so the reader can act after one pass: no table in a reply, nothing that does not carry information. |\n65: | [Communication handoff](.skilled/repo-rules/communication-handoff.md) | End every turn by naming what is now the operator's to do, in the form that lets them do it. |\n66: | [Hub routing](.skilled/repo-rules/skill-hub-routing.md) | A hub routes in two stages, so a mode registered on one surface is not reachable, and a gate run without its hub argument reports on a hub you did not touch. |\n67: \n68: Each file expands `AGENTS.md` and is bounded by it: where a rule file appears to\n69: permit something `AGENTS.md` restricts, `AGENTS.md` wins and the rule file is wrong.\n70: \n71: ---\n72: \n73: ## 4. SCOPE OF THIS DOCUMENT\n74: \n75: **In:** how to think and act, restraint, scope, evidence, risk, diagnosis, honesty,\n76: the posture to hold when work is handed to another runtime, how the resulting reply\n77: reads, what you may claim about wiring you have changed, and how a turn hands control\n78: back to the operator. The delegation posture was the first widening and Delivery the\n79: second, added when `AGENTS.md` §8 moved down. Delivery is one of two rules here whose\n80: trigger is a whole turn rather than a specific action, the other being the handback rule,\n81: which fires at every turn's end, and `AGENTS.md` §4, under Reply Rules and Mandates, keeps\n82: the two clauses that must bind even when nothing loads.\n83: \n84: **Out:** skill routing, workflow selection, spec-folder mechanics, and the *mechanics*\n85: of agent and CLI dispatch: which agent, which command, which model, which flags.\n86: Those belong to `AGENTS.md` §2 and the skills it routes to, and are deliberately\n87: absent here so each has exactly one place to change. The line is between plumbing and\n88: posture: how to dispatch is theirs, how to think while dispatching is ours.\n89: \n90: **The routing carve-out, added deliberately as the third widening.** *Selecting* a\n91: route stays Out. *Verifying wiring you changed, and what you may claim about it*, is\n92: In; it is an evidence obligation whose subject happens to be routing. `skill-hub-routing.md`\n93: is the one rule on this side of that line, and it carries no route-selection guidance:\n94: the mechanics stay in the skills, and the rule points at them. A fourth widening that\n95: admits selection itself would dissolve the boundary; this one does not.\n96: \n97: **The ask-surface carve-out, added as the fourth widening, on an operator decision that\n98: overrode a research refusal.** A four-iteration decision-test run returned *refuse* here:\n99: naming a question tool per runtime reads as the \"which command\" family, and the paragraph\n100: above pre-refuses a fourth widening that admits selection. The operator widened it anyway,\n101: and what follows is the narrowing that keeps the boundary standing. *Choosing between\n102: runtimes, agents, commands, models or flags* stays Out, unchanged. *Naming the surface that\n103: asks the operator a question, in the runtime you are already running in*, is In. That is not\n104: a selection, because nothing is being selected: the runtime is a given, and the rule records\n105: which of its surfaces carries an obligation the rule already imposes. `communication-handoff.md`\n106: is the one rule on this side of that line, its §5 is the only place a tool name appears, and\n107: it names only what this repository confirms. A fifth widening that let a rule pick between\n108: runtimes would be the dissolution this one avoids.","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/REPO RULES.md, lines 1-108\n1: # REPO RULES\n2: \n3: Repo-local operating rules. `AGENTS.md` **Gate 5 (§2)** makes reading this mandatory\n4: before your first write of the session; this document then routes you to every rule\n5: file that governs what you are about to do. **It is a router, not a rulebook:** it\n6: holds no rules of its own.\n7: \n8: ---\n9: \n10: ## 1. HOW TO USE THIS\n11: \n12: 1. **Match on the action you are about to take**, not the topic of the request.\n13: 2. **Load before the action.** A rule read afterwards is a post-mortem.\n14: 3. **A file already in context is not re-read.**\n15: 4. **Every trigger that fires is loaded, not just the first.** They compose; the more\n16:    specific wins on conflict. Three and four firing at once is the normal case, not an\n17:    edge case.\n18: 5. **Nothing fires → `AGENTS.md` alone governs.** Do not hunt for a rule to apply.\n19: \n20: ### Precedence\n21: \n22: | Level | Source | Can be overridden? |\n23: |-------|--------|--------------------|\n24: | 1 | Every `AGENTS.md` §1 hard blocker, the Four Laws, PLAN-WORKFLOW LOCK, Comment Hygiene, and every mandatory gate in §2 | No |\n25: | 2 | An explicit, in-the-moment operator instruction | Not applicable, it is the instruction |\n26: | 3 | These rule files, and the guidance in a skill's `SKILL.md` | Only by level 1 or 2 |\n27: | 4 | General judgment | By anything above |\n28: \n29: A rule file may tighten `AGENTS.md`. None relaxes a HARD BLOCK or authorizes what\n30: `AGENTS.md` forbids. Gate 5 does not change that: it makes the **load** mandatory,\n31: while what you load stays at level 3, the obligation to read is tier 1, the content\n32: is not.\n33: \n34: ---\n35: \n36: ## 2. TRIGGER TABLE\n37: \n38: | You are about to… | Load | It settles |\n39: |-------------------|------|-----------|\n40: | Add a file, module, class, interface, option, layer, or dependency · write a spec or plan that adds one · generalize something that works · write \"flexible\", \"future-proof\", \"scalable\", \"extensible\", \"might need\", \"best practice\", \"while we're here\" · add a test beyond the coverage floor | [`prevent-overengineering.md`](.skilled/repo-rules/prevent-overengineering.md) | Whether this should exist at all, and at what size |\n41: | Touch a file outside the ask · fix something noticed in passing · change something else because it would make the fix easier · rename, reformat, or delete beyond the named area · deviate from an approved plan · decide what to do with the rest when part of the work is blocked · notice a defect, smell or stale comment outside the files in scope | [`scope-discipline.md`](.skilled/repo-rules/scope-discipline.md) | What is yours to change, and how to raise what isn't |\n42: | Say \"done\", \"works\", \"fixed\", \"passing\", \"no regressions\" · report a result · quote a number · act on a tool's or sub-agent's success report · close out a turn · report a file path or command output · write a completion summary or tick something off as done | [`evidence-and-proof.md`](.skilled/repo-rules/evidence-and-proof.md) | What counts as proof, how a green run lies, what an honest close-out contains |\n43: | Decide whether to hand work to another runtime at all · hand it to a CLI executor, sub-agent, fan-out lineage, or deep loop · compose the prompt one will act on · accept or quote what one returned · answer a judgment question from your own reading alone | [`delegation-and-orchestration.md`](.skilled/repo-rules/delegation-and-orchestration.md) | The orchestrating posture, what a brief must carry, why one model is one opinion |\n44: | Delete, overwrite, migrate, deploy, publish, send, install · force-push or rewrite history · change a shared contract · touch auth, data, or config · make any call that leaves this machine · truncate · touch branches, tags, or reflogs | [`blast-radius.md`](.skilled/repo-rules/blast-radius.md) | Reversibility, the rollback sentence, when to stop for a yes |\n45: | Diagnose a failure · make a red check green · attempt the same fix twice · add a special case, retry, sleep, or broadened catch · call a failure a flake, infra, or pre-existing | [`root-cause-and-debugging.md`](.skilled/repo-rules/root-cause-and-debugging.md) | Fixing the producer instead of the symptom, and when to level up to the seam |\n46: | Answer without certainty · contradict the operator · fill a gap with a plausible guess · hit a contradiction between two things that must both be true · name a path, flag, function, version, or number you have not verified · not know while a plausible answer is available · see sources disagree, or the code contradict the spec, the docs or the operator · the operator asserts something you believe is wrong · change a checked answer after pushback or doubt, or drop an approach before it concludes · cite a rule, restriction, policy, limit or permission, or decline a request | [`uncertainty-and-honesty.md`](.skilled/repo-rules/uncertainty-and-honesty.md) | Confidence bands, UNKNOWN, contradiction halts |\n47: | Write any substantive reply, an answer, an explanation, a close-out or a status · draft or edit any sentence a reader will read · present a recommendation, a fork, or a trade-off · start a multi-step stretch of work the reader will not see inside · report what a long autonomous run found · the reader says they did not follow or asks for a plainer version | [`communication.md`](.skilled/repo-rules/communication.md) | How a reply reads: answer first, one recommended path, length, filler, plain sentences, punctuation, and no table in a reply |\n48: | End a turn · report work done, blocked, or partly done · end a turn while something you started is still running · ask the operator anything · end a turn on a fork or two acceptable paths · continue past a decision nobody made | [`communication-handoff.md`](.skilled/repo-rules/communication-handoff.md) | What is the operator's to do next, what is still running and what resumes it, and when a question becomes a structured choice |\n49: | Wire, rewire or remove a mode in a parent-hub skill · edit a hub's registry, router, root `ROUTER.md`, `graph-metadata.json` or `SKILL.md` mode table, or a mode packet's own `ROUTER.md` · report that a mode is registered, routed, reachable or integrated · quote a per-hub gate result · create a new skill under a hub, or refactor one that already lives there | [`skill-hub-routing.md`](.skilled/repo-rules/skill-hub-routing.md) | The two routing stages, what \"integrated\" requires, and checking the hub you actually changed |\n50: \n51: ---\n52: \n53: ## 3. INDEX\n54: \n55: | Rule | Summary |\n56: |------|---------|\n57: | [Overengineering](.skilled/repo-rules/prevent-overengineering.md) | Build the smallest thing that solves the stated problem; take a costlier move only by naming what fails at the cheaper one. |\n58: | [Scope discipline](.skilled/repo-rules/scope-discipline.md) | The requested scope is the deliverable. Adjacent problems get named, not fixed. |\n59: | [Evidence and proof](.skilled/repo-rules/evidence-and-proof.md) | A claim is only as strong as the observation behind it, and a receipt confirms only what could have contradicted it. Distinguish observed from derived from inferred. |\n60: | [Delegation and orchestration](.skilled/repo-rules/delegation-and-orchestration.md) | Delegating makes you the orchestrator; brief with evidence, and no single model's verdict closes a question. |\n61: | [Blast radius](.skilled/repo-rules/blast-radius.md) | Size effort to what the change can break; no irreversible step without a named rollback and a yes. |\n62: | [Root cause](.skilled/repo-rules/root-cause-and-debugging.md) | Fix the producer, not the symptom; every fix names the mechanism that caused the failure. |\n63: | [Uncertainty and honesty](.skilled/repo-rules/uncertainty-and-honesty.md) | Never fabricate; mark the confidence you actually have and halt on a contradiction. |\n64: | [Communication](.skilled/repo-rules/communication.md) | Write so the reader can act after one pass: no table in a reply, nothing that does not carry information. |\n65: | [Communication handoff](.skilled/repo-rules/communication-handoff.md) | End every turn by naming what is now the operator's to do, in the form that lets them do it. |\n66: | [Hub routing](.skilled/repo-rules/skill-hub-routing.md) | A hub routes in two stages, so a mode registered on one surface is not reachable, and a gate run without its hub argument reports on a hub you did not touch. |\n67: \n68: Each file expands `AGENTS.md` and is bounded by it: where a rule file appears to\n69: permit something `AGENTS.md` restricts, `AGENTS.md` wins and the rule file is wrong.\n70: \n71: ---\n72: \n73: ## 4. SCOPE OF THIS DOCUMENT\n74: \n75: **In:** how to think and act, restraint, scope, evidence, risk, diagnosis, honesty,\n76: the posture to hold when work is handed to another runtime, how the resulting reply\n77: reads, what you may claim about wiring you have changed, and how a turn hands control\n78: back to the operator. The delegation posture was the first widening and Delivery the\n79: second, added when `AGENTS.md` §8 moved down. Delivery is one of two rules here whose\n80: trigger is a whole turn rather than a specific action, the other being the handback rule,\n81: which fires at every turn's end, and `AGENTS.md` §4, under Reply Rules and Mandates, keeps\n82: the two clauses that must bind even when nothing loads.\n83: \n84: **Out:** skill routing, workflow selection, spec-folder mechanics, and the *mechanics*\n85: of agent and CLI dispatch: which agent, which command, which model, which flags.\n86: Those belong to `AGENTS.md` §2 and the skills it routes to, and are deliberately\n87: absent here so each has exactly one place to change. The line is between plumbing and\n88: posture: how to dispatch is theirs, how to think while dispatching is ours.\n89: \n90: **The routing carve-out, added deliberately as the third widening.** *Selecting* a\n91: route stays Out. *Verifying wiring you changed, and what you may claim about it*, is\n92: In; it is an evidence obligation whose subject happens to be routing. `skill-hub-routing.md`\n93: is the one rule on this side of that line, and it carries no route-selection guidance:\n94: the mechanics stay in the skills, and the rule points at them. A fourth widening that\n95: admits selection itself would dissolve the boundary; this one does not.\n96: \n97: **The ask-surface carve-out, added as the fourth widening, on an operator decision that\n98: overrode a research refusal.** A four-iteration decision-test run returned *refuse* here:\n99: naming a question tool per runtime reads as the \"which command\" family, and the paragraph\n100: above pre-refuses a fourth widening that admits selection. The operator widened it anyway,\n101: and what follows is the narrowing that keeps the boundary standing. *Choosing between\n102: runtimes, agents, commands, models or flags* stays Out, unchanged. *Naming the surface that\n103: asks the operator a question, in the runtime you are already running in*, is In. That is not\n104: a selection, because nothing is being selected: the runtime is a given, and the rule records\n105: which of its surfaces carries an obligation the rule already imposes. `communication-handoff.md`\n106: is the one rule on this side of that line, its §5 is the only place a tool name appears, and\n107: it names only what this repository confirms. A fifth widening that let a rule pick between\n108: runtimes would be the dissolution this one avoids."}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/REPO RULES.md\"}"},"time":{"start":1794528154952,"end":1794528155830}}}}
{"type":"tool_use","timestamp":1794528155865,"sessionID":"ses_e2dcb3598ffevqcAV0JB0ZlAmZ","part":{"partID":"prt_1d236968e001uJq1pSgS4HotbC","sessionID":"ses_e2dcb3598ffevqcAV0JB0ZlAmZ","messageID":"msg_1d2366342001odH5Mfmf8VDUWY","type":"tool","id":"call_0eb46583b0d445f39aea091f","tool":"read","state":{"status":"completed","input":{"path":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/commands/doctor/scripts/codex-hook-approval-check.cjs"},"output":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/commands/doctor/scripts/codex-hook-approval-check.cjs, lines 1-214\n1: #!/usr/bin/env node\n2: // ───────────────────────────────────────────────────────────────────\n3: // MODULE: Codex Hook Approval Check\n4: // ───────────────────────────────────────────────────────────────────\n5: 'use strict';\n6: \n7: // Codex runs a project hook only after the operator approves that exact entry.\n8: // The approval lives in config.toml under a hooks.state key as a trusted_hash,\n9: // and an unapproved entry is skipped without a warning. A wired advisor hook can\n10: // therefore be present in .codex/hooks.json and still never deliver a brief,\n11: // which no diff can tell apart from a hook that was never wired.\n12: //\n13: // This check is read-only on purpose. The approval belongs to the /hooks review\n14: // in a Codex session, so the repair line names that step instead of offering to\n15: // copy a hash. The hash value stays out of every output because echoing a\n16: // credential serves no diagnostic purpose.\n17: //\n18: // Exit codes:\n19: //   0  the project has no hooks file, or the advisor entry is approved\n20: //   1  the advisor entry is absent, or present and unapproved\n21: //   2  bad argument\n22: //\n23: // Usage: codex-hook-approval-check.cjs [--root <dir>] [--config <path>] [--json]\n24: //   --root    project root whose .codex/hooks.json is read, defaults to the cwd\n25: //   --config  Codex config file, defaults to $CODEX_HOME/config.toml\n26: //   --json    print one JSON object instead of the text lines\n27: \n28: // ─────────────────────────────────────────────────────────────────────────────\n29: // 1. IMPORTS\n30: // ─────────────────────────────────────────────────────────────────────────────\n31: \n32: const fs = require('node:fs');\n33: const os = require('node:os');\n34: const path = require('node:path');\n35: \n36: // ─────────────────────────────────────────────────────────────────────────────\n37: // 2. CONSTANTS\n38: // ─────────────────────────────────────────────────────────────────────────────\n39: \n40: const ADVISOR_MARKER = 'hooks/codex/user-prompt-submit.js';\n41: const EVENT_KEY = 'user_prompt_submit';\n42: const USAGE = 'Usage: codex-hook-approval-check.cjs [--root <dir>] [--config <path>] [--json]\\n';\n43: \n44: // ─────────────────────────────────────────────────────────────────────────────\n45: // 3. HELPERS\n46: // ─────────────────────────────────────────────────────────────────────────────\n47: \n48: // A misspelled or value-less flag must fail loudly rather than read another root.\n49: function parseArgs(argv) {\n50:   const options = { root: process.cwd(), config: null, json: false };\n51:   for (let index = 0; index < argv.length; index += 1) {\n52:     const arg = argv[index];\n53:     if (arg === '--json') {\n54:       options.json = true;\n55:       continue;\n56:     }\n57:     if (arg === '--root' || arg === '--config') {\n58:       const value = argv[index + 1];\n59:       if (value === undefined || value === '') return null;\n60:       options[arg.slice(2)] = value;\n61:       index += 1;\n62:       continue;\n63:     }\n64:     return null;\n65:   }\n66:   return options;\n67: }\n68: \n69: function defaultConfigFile() {\n70:   const codexHome = process.env.CODEX_HOME || path.join(os.homedir(), '.codex');\n71:   return path.join(codexHome, 'config.toml');\n72: }\n73: \n74: function trimSeparators(value) {\n75:   const trimmed = value.replace(/[\\\\/]+$/, '');\n76:   return trimmed === '' ? value : trimmed;\n77: }\n78: \n79: // Codex keys an approval by the hooks file, the event, the group and the hook\n80: // index, so any edit that moves the advisor entry needs a fresh approval. The\n81: // caller may pass a relative or symlinked root while Codex recorded the real\n82: // path, so both forms are tried.\n83: function hookStateKeys(root, group, index) {\n84:   const roots = [trimSeparators(root)];\n85:   try {\n86:     roots.push(trimSeparators(fs.realpathSync(root)));\n87:   } catch {\n88:     // A root that cannot be resolved has only the form the caller gave.\n89:   }\n90:   const keys = [];\n91:   for (const base of roots) {\n92:     const key = `${base}/.codex/hooks.json:${EVENT_KEY}:${group}:${index}`;\n93:     if (!keys.includes(key)) keys.push(key);\n94:   }\n95:   return keys;\n96: }\n97: \n98: // An unparseable hooks file cannot hold a findable entry, so it takes the same\n99: // verdict as a file that lacks the entry. Either way the hook cannot run.\n100: function findAdvisorEntry(hooksFile) {\n101:   if (!fs.existsSync(hooksFile)) return { kind: 'skip' };\n102:   let document;\n103:   try {\n104:     document = JSON.parse(fs.readFileSync(hooksFile, 'utf8'));\n105:   } catch {\n106:     return { kind: 'absent' };\n107:   }\n108:   const groups = document?.hooks?.UserPromptSubmit;\n109:   if (!Array.isArray(groups)) return { kind: 'absent' };\n110:   for (const [groupIndex, group] of groups.entries()) {\n111:     const hooks = Array.isArray(group?.hooks) ? group.hooks : [];\n112:     for (const [hookIndex, hook] of hooks.entries()) {\n113:       if (typeof hook?.command === 'string' && hook.command.includes(ADVISOR_MARKER)) {\n114:         return { kind: 'present', group: groupIndex, index: hookIndex };\n115:       }\n116:     }\n117:   }\n118:   return { kind: 'absent' };\n119: }\n120: \n121: // The approval block ends at the next TOML header, so a trusted_hash recorded\n122: // under a different hooks.state key must not count for this entry.\n123: function approvalFound(configFile, keys) {\n124:   let text;\n125:   try {\n126:     text = fs.readFileSync(configFile, 'utf8');\n127:   } catch {\n128:     return false;\n129:   }\n130:   const lines = text.split(/\\r?\\n/);\n131:   const headers = new Set(keys.map((key) => `[hooks.state.\"${key}\"]`));\n132:   for (let index = 0; index < lines.length; index += 1) {\n133:     if (!headers.has(lines[index].trim())) continue;\n134:     for (let cursor = index + 1; cursor < lines.length; cursor += 1) {\n135:       const line = lines[cursor].trim();\n136:       if (line.startsWith('[')) break;\n137:       if (/^trusted_hash\\s*=/.test(line)) return true;\n138:     }\n139:   }\n140:   return false;\n141: }\n142: \n143: function report(options, verdict, lines) {\n144:   if (options.json) {\n145:     process.stdout.write(`${JSON.stringify(verdict, null, 2)}\\n`);\n146:     return;\n147:   }\n148:   for (const line of lines) process.stdout.write(`${line}\\n`);\n149: }\n150: \n151: // ─────────────────────────────────────────────────────────────────────────────\n152: // 4. CORE LOGIC\n153: // ─────────────────────────────────────────────────────────────────────────────\n154: \n155: function main(argv) {\n156:   const options = parseArgs(argv);\n157:   if (options === null) {\n158:     process.stderr.write(USAGE);\n159:     return 2;\n160:   }\n161: \n162:   const root = options.root;\n163:   const hooksFile = path.join(root, '.codex', 'hooks.json');\n164:   const entry = findAdvisorEntry(hooksFile);\n165: \n166:   if (entry.kind === 'skip') {\n167:     report(options, { status: 'skip', code: 'no-codex-hooks', root }, ['SKIP no-codex-hooks']);\n168:     return 0;\n169:   }\n170: \n171:   if (entry.kind === 'absent') {\n172:     report(options, {\n173:       status: 'warn',\n174:       code: 'codex-advisor-hook-absent',\n175:       root,\n176:       hooksFile,\n177:     }, ['WARN codex-advisor-hook-absent']);\n178:     return 1;\n179:   }\n180: \n181:   const configFile = options.config || defaultConfigFile();\n182:   const keys = hookStateKeys(root, entry.group, entry.index);\n183:   if (approvalFound(configFile, keys)) {\n184:     report(options, {\n185:       status: 'pass',\n186:       code: 'codex-hooks-approved',\n187:       root,\n188:       group: entry.group,\n189:       index: entry.index,\n190:       config: configFile,\n191:     }, ['PASS codex-hooks-approved']);\n192:     return 0;\n193:   }\n194: \n195:   const repair = `repair: open /hooks in a Codex session at ${root} and approve each entry`;\n196:   report(options, {\n197:     status: 'warn',\n198:     code: 'codex-hooks-unapproved',\n199:     root,\n200:     group: entry.group,\n201:     index: entry.index,\n202:     config: configFile,\n203:     repair,\n204:   }, [`WARN codex-hooks-unapproved ${root}`, repair]);\n205:   return 1;\n206: }\n207: \n208: // ─────────────────────────────────────────────────────────────────────────────\n209: // 5. ENTRY POINT\n210: // ─────────────────────────────────────────────────────────────────────────────\n211: \n212: if (require.main === module) process.exitCode = main(process.argv.slice(2));\n213: \n214: module.exports = { main, findAdvisorEntry, approvalFound };","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/commands/doctor/scripts/codex-hook-approval-check.cjs, lines 1-214\n1: #!/usr/bin/env node\n2: // ───────────────────────────────────────────────────────────────────\n3: // MODULE: Codex Hook Approval Check\n4: // ───────────────────────────────────────────────────────────────────\n5: 'use strict';\n6: \n7: // Codex runs a project hook only after the operator approves that exact entry.\n8: // The approval lives in config.toml under a hooks.state key as a trusted_hash,\n9: // and an unapproved entry is skipped without a warning. A wired advisor hook can\n10: // therefore be present in .codex/hooks.json and still never deliver a brief,\n11: // which no diff can tell apart from a hook that was never wired.\n12: //\n13: // This check is read-only on purpose. The approval belongs to the /hooks review\n14: // in a Codex session, so the repair line names that step instead of offering to\n15: // copy a hash. The hash value stays out of every output because echoing a\n16: // credential serves no diagnostic purpose.\n17: //\n18: // Exit codes:\n19: //   0  the project has no hooks file, or the advisor entry is approved\n20: //   1  the advisor entry is absent, or present and unapproved\n21: //   2  bad argument\n22: //\n23: // Usage: codex-hook-approval-check.cjs [--root <dir>] [--config <path>] [--json]\n24: //   --root    project root whose .codex/hooks.json is read, defaults to the cwd\n25: //   --config  Codex config file, defaults to $CODEX_HOME/config.toml\n26: //   --json    print one JSON object instead of the text lines\n27: \n28: // ─────────────────────────────────────────────────────────────────────────────\n29: // 1. IMPORTS\n30: // ─────────────────────────────────────────────────────────────────────────────\n31: \n32: const fs = require('node:fs');\n33: const os = require('node:os');\n34: const path = require('node:path');\n35: \n36: // ─────────────────────────────────────────────────────────────────────────────\n37: // 2. CONSTANTS\n38: // ─────────────────────────────────────────────────────────────────────────────\n39: \n40: const ADVISOR_MARKER = 'hooks/codex/user-prompt-submit.js';\n41: const EVENT_KEY = 'user_prompt_submit';\n42: const USAGE = 'Usage: codex-hook-approval-check.cjs [--root <dir>] [--config <path>] [--json]\\n';\n43: \n44: // ─────────────────────────────────────────────────────────────────────────────\n45: // 3. HELPERS\n46: // ─────────────────────────────────────────────────────────────────────────────\n47: \n48: // A misspelled or value-less flag must fail loudly rather than read another root.\n49: function parseArgs(argv) {\n50:   const options = { root: process.cwd(), config: null, json: false };\n51:   for (let index = 0; index < argv.length; index += 1) {\n52:     const arg = argv[index];\n53:     if (arg === '--json') {\n54:       options.json = true;\n55:       continue;\n56:     }\n57:     if (arg === '--root' || arg === '--config') {\n58:       const value = argv[index + 1];\n59:       if (value === undefined || value === '') return null;\n60:       options[arg.slice(2)] = value;\n61:       index += 1;\n62:       continue;\n63:     }\n64:     return null;\n65:   }\n66:   return options;\n67: }\n68: \n69: function defaultConfigFile() {\n70:   const codexHome = process.env.CODEX_HOME || path.join(os.homedir(), '.codex');\n71:   return path.join(codexHome, 'config.toml');\n72: }\n73: \n74: function trimSeparators(value) {\n75:   const trimmed = value.replace(/[\\\\/]+$/, '');\n76:   return trimmed === '' ? value : trimmed;\n77: }\n78: \n79: // Codex keys an approval by the hooks file, the event, the group and the hook\n80: // index, so any edit that moves the advisor entry needs a fresh approval. The\n81: // caller may pass a relative or symlinked root while Codex recorded the real\n82: // path, so both forms are tried.\n83: function hookStateKeys(root, group, index) {\n84:   const roots = [trimSeparators(root)];\n85:   try {\n86:     roots.push(trimSeparators(fs.realpathSync(root)));\n87:   } catch {\n88:     // A root that cannot be resolved has only the form the caller gave.\n89:   }\n90:   const keys = [];\n91:   for (const base of roots) {\n92:     const key = `${base}/.codex/hooks.json:${EVENT_KEY}:${group}:${index}`;\n93:     if (!keys.includes(key)) keys.push(key);\n94:   }\n95:   return keys;\n96: }\n97: \n98: // An unparseable hooks file cannot hold a findable entry, so it takes the same\n99: // verdict as a file that lacks the entry. Either way the hook cannot run.\n100: function findAdvisorEntry(hooksFile) {\n101:   if (!fs.existsSync(hooksFile)) return { kind: 'skip' };\n102:   let document;\n103:   try {\n104:     document = JSON.parse(fs.readFileSync(hooksFile, 'utf8'));\n105:   } catch {\n106:     return { kind: 'absent' };\n107:   }\n108:   const groups = document?.hooks?.UserPromptSubmit;\n109:   if (!Array.isArray(groups)) return { kind: 'absent' };\n110:   for (const [groupIndex, group] of groups.entries()) {\n111:     const hooks = Array.isArray(group?.hooks) ? group.hooks : [];\n112:     for (const [hookIndex, hook] of hooks.entries()) {\n113:       if (typeof hook?.command === 'string' && hook.command.includes(ADVISOR_MARKER)) {\n114:         return { kind: 'present', group: groupIndex, index: hookIndex };\n115:       }\n116:     }\n117:   }\n118:   return { kind: 'absent' };\n119: }\n120: \n121: // The approval block ends at the next TOML header, so a trusted_hash recorded\n122: // under a different hooks.state key must not count for this entry.\n123: function approvalFound(configFile, keys) {\n124:   let text;\n125:   try {\n126:     text = fs.readFileSync(configFile, 'utf8');\n127:   } catch {\n128:     return false;\n129:   }\n130:   const lines = text.split(/\\r?\\n/);\n131:   const headers = new Set(keys.map((key) => `[hooks.state.\"${key}\"]`));\n132:   for (let index = 0; index < lines.length; index += 1) {\n133:     if (!headers.has(lines[index].trim())) continue;\n134:     for (let cursor = index + 1; cursor < lines.length; cursor += 1) {\n135:       const line = lines[cursor].trim();\n136:       if (line.startsWith('[')) break;\n137:       if (/^trusted_hash\\s*=/.test(line)) return true;\n138:     }\n139:   }\n140:   return false;\n141: }\n142: \n143: function report(options, verdict, lines) {\n144:   if (options.json) {\n145:     process.stdout.write(`${JSON.stringify(verdict, null, 2)}\\n`);\n146:     return;\n147:   }\n148:   for (const line of lines) process.stdout.write(`${line}\\n`);\n149: }\n150: \n151: // ─────────────────────────────────────────────────────────────────────────────\n152: // 4. CORE LOGIC\n153: // ─────────────────────────────────────────────────────────────────────────────\n154: \n155: function main(argv) {\n156:   const options = parseArgs(argv);\n157:   if (options === null) {\n158:     process.stderr.write(USAGE);\n159:     return 2;\n160:   }\n161: \n162:   const root = options.root;\n163:   const hooksFile = path.join(root, '.codex', 'hooks.json');\n164:   const entry = findAdvisorEntry(hooksFile);\n165: \n166:   if (entry.kind === 'skip') {\n167:     report(options, { status: 'skip', code: 'no-codex-hooks', root }, ['SKIP no-codex-hooks']);\n168:     return 0;\n169:   }\n170: \n171:   if (entry.kind === 'absent') {\n172:     report(options, {\n173:       status: 'warn',\n174:       code: 'codex-advisor-hook-absent',\n175:       root,\n176:       hooksFile,\n177:     }, ['WARN codex-advisor-hook-absent']);\n178:     return 1;\n179:   }\n180: \n181:   const configFile = options.config || defaultConfigFile();\n182:   const keys = hookStateKeys(root, entry.group, entry.index);\n183:   if (approvalFound(configFile, keys)) {\n184:     report(options, {\n185:       status: 'pass',\n186:       code: 'codex-hooks-approved',\n187:       root,\n188:       group: entry.group,\n189:       index: entry.index,\n190:       config: configFile,\n191:     }, ['PASS codex-hooks-approved']);\n192:     return 0;\n193:   }\n194: \n195:   const repair = `repair: open /hooks in a Codex session at ${root} and approve each entry`;\n196:   report(options, {\n197:     status: 'warn',\n198:     code: 'codex-hooks-unapproved',\n199:     root,\n200:     group: entry.group,\n201:     index: entry.index,\n202:     config: configFile,\n203:     repair,\n204:   }, [`WARN codex-hooks-unapproved ${root}`, repair]);\n205:   return 1;\n206: }\n207: \n208: // ─────────────────────────────────────────────────────────────────────────────\n209: // 5. ENTRY POINT\n210: // ─────────────────────────────────────────────────────────────────────────────\n211: \n212: if (require.main === module) process.exitCode = main(process.argv.slice(2));\n213: \n214: module.exports = { main, findAdvisorEntry, approvalFound };"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/commands/doctor/scripts/codex-hook-approval-check.cjs\"}"},"time":{"start":1794528155278,"end":1794528155865}}}}
{"type":"step_finish","timestamp":1794528159545,"sessionID":"ses_e2dcb3598ffevqcAV0JB0ZlAmZ","part":{"id":"prt_1d236a739001vXQk87M9B4HS8S","sessionID":"ses_e2dcb3598ffevqcAV0JB0ZlAmZ","messageID":"msg_1d2366342001odH5Mfmf8VDUWY","type":"step-finish","reason":"tool-calls","snapshot":"a795ece8013c2731d3f0a8928bbefe27ca2a427f","cost":0,"tokens":{"input":4090,"output":131,"reasoning":1179,"cache":{"read":36096,"write":0}}}}
{"type":"step_start","timestamp":1794528164005,"sessionID":"ses_e2dcb3598ffevqcAV0JB0ZlAmZ","part":{"id":"prt_1d236b8a5001K8NqloRGXcvogp","sessionID":"ses_e2dcb3598ffevqcAV0JB0ZlAmZ","messageID":"msg_1d236a745001EHSj7LWuURFWUi","type":"step-start","snapshot":"2d590412749375d03af8d92ced838161b98cde07"}}
{"type":"tool_use","timestamp":1794528164087,"sessionID":"ses_e2dcb3598ffevqcAV0JB0ZlAmZ","part":{"partID":"prt_1d236b8ab002vjlS1vXVLr8Wrb","sessionID":"ses_e2dcb3598ffevqcAV0JB0ZlAmZ","messageID":"msg_1d236a745001EHSj7LWuURFWUi","type":"tool","id":"call_e988202ce8ac4a7197baf2ae","tool":"skill","state":{"status":"completed","input":{"id":"sk-code"},"output":"<skill_content name=\"sk-code\">\n# Skill: sk-code\n\n<!-- Keywords: sk-code, code, surface-aware, two-axis, opencode, typescript, python, shell, json, jsonc, github-actions, ci-workflow, sk-code-quality, sk-code-review, sk-code-ci, sk-code-frontend, quality, code-review, verification, debug, implement, workflow-doctrine, mode-registry, workflowmode, packetkind, backendkind, surface-router, evidence-base, surface-packet, guard, adapter, stderr, detector -->\n\n# Code Family Hub (sk-code)\n\nOne skill has two axes, one shared surface-detection router and one advisor identity.\nThe **workflow axis** has two code modes that act: sk-code-quality and sk-code-review.\nThe **surface axis** has three read-only evidence packets the hub bundles alongside a workflow mode: sk-code-ci, sk-code-frontend and sk-code-skilled.\nEach packet carries the shared **implement → debug → verify** workflow doctrine (`shared/references/workflow-*.md`, symlinked in) plus its own domain knowledge.\nThis hub holds NO per-mode logic. It routes by `workflowMode` through `mode-registry.json`, and each mode or surface keeps its own contract in its packet.\n\n**Version authority.** This file's `version` frontmatter is the hub's release version and matches the newest entry under `changelog/`.\n`description.json`, `mode-registry.json` and `hub-router.json` carry the same value. Each hub-root JSON routing file therefore states the same release.\n`ROUTER.md` and `README.md` keep their own document versions, as the frontmatter-versioning standard gives every doc but `SKILL.md`.\nThe authority stops at the hub root. Each `modes[]` packet carries its own version and release cadence.\nA packet version is independent of this one by design, so a gap between them is not drift.\n\n---\n\n## 1. WHEN TO USE\n\nUse this skill for code-family workflows. Invoke it as `sk-code` with an optional mode hint such as `quality: <request>`. The hub classifies the request, resolves a mode key, and loads the matching nested packet.\n\n**Workflow axis** (modes that act, one of them chosen as primary):\n\n| Mode | Use it for | Packet |\n|------|------------|--------|\n| **sk-code-quality** | Quality gate, P0/P1/P2 author checks, comment hygiene and surface checklists. | `sk-code/sk-code-quality/` |\n| **sk-code-review** | Findings-first review, security and correctness baseline, checklists, output contract and PR-state gates. | `sk-code/sk-code-review/` |\n\n**Surface axis** (read-only, advisor-invisible evidence. When a workflow mode scores, the hub bundles the surface after that primary mode. When no workflow mode scores, the hub routes the surface alone for a lookup, implement, debug or verify task, and the acting agent hands the author gates to `sk-code-quality` before it claims completion):\n\n| Surface | Carries | Packet |\n|---------|---------|--------|\n| **sk-code-ci** | GitHub Actions evidence: trigger, filter, permission, timeout, concurrency and caching rules, the protected set, the intentional message-contract exception and the scaffold templates, with the repository-specific values read from a CI profile. Read-only. | `sk-code/sk-code-ci/` |\n| **sk-code-frontend** | Stack-agnostic frontend evidence: web markup and CSS, web layout and accessibility, visual values, visual hierarchy and review, motion and interaction, the `tokens.css` starter tokens and Figma-to-code checks. Read-only. | `sk-code/sk-code-frontend/` |\n| **sk-code-skilled** | System-code evidence: TypeScript/Python/shell/config standards, hooks, alignment verification, authoring checklists. Bundles the implement → debug → verify workflow doctrine (read-only evidence) for the Skilled surface, and the acting agent applies it. | `sk-code/sk-code-skilled/` |\n\n**Surface list.** The hub has exactly three surfaces:\n- SKILLED (`sk-code-skilled`): the native surface for this framework's own code.\n- CI (`sk-code-ci`): the GitHub Actions workflow standards surface.\n- Frontend (`sk-code-frontend`): the stack-agnostic web practice and Figma-to-code surface, with visual values, visual hierarchy and review, and motion and interaction guidance, bundled from request vocabulary alone.\n\nThe hub also has two workflow modes: quality (`sk-code-quality`) and review (`sk-code-review`).\nAny other sk-code doc that counts surfaces points to this sentence.\n\n### When NOT to Use\n- Documentation-only changes with no code-work contract - use `sk-doc`.\n- Git workflow, branch, commit, PR, merge, or release work - use `sk-git`.\n- Pure browser inspection or external MCP transport work - use the relevant MCP skill.\n- For a measured Style Reference (design tokens extracted from a live source), use `sk-design-md-generator` first.\n- When a request or a frame leaves a visual value open (spacing, type, color, radius, shadow or motion), or a value sits off every token and scale, load `sk-code-frontend` and decide it from its visual-values reference.\n- Backend support primitives in `shared/` - they are consumed by the modes, not invoked as a user workflow.\n\n---\n\n## 2. SMART ROUTING\n\nRouting is **registry-driven at runtime and authored in `hub-router.json`** in two stages.\nStage 1 (hub → mode) uses `hub-router.json` as the authored mode vocabulary. `mode-registry.json` carries the packet contracts, whose aliases are checked against that vocabulary.\nStage 2 (mode → leaves) uses the root [`ROUTER.md`](./ROUTER.md) as the authored leaf-set router.\nBoth files point back here instead of restating the split.\n\nThe advisor routes every code query to the single identity `sk-code`. Resolve the mode with `node .skilled/bin/compiled-route.cjs --hub sk-code --prompt \"<task>\"` and follow the decision: `route` loads its `targets`, `clarify` and `defer` ask, `reject` refuses.\nCompiled routing is the default. The legacy fallback, the kill-switch and the `UNKNOWN_FALLBACK_CHECKLIST` live in the compiled-routing section of [`ROUTER.md`](./ROUTER.md).\n\nA bare implement, debug or verify request with no workflow mode becomes a pure surface bundle, and an unclear code intent asks for disambiguation. Neither path forces a stale default.\nRun the compiled-routing directive in [`ROUTER.md`](./ROUTER.md) before selecting hub resources.\n\n---\n\n## 3. HOW IT WORKS\n\n### Terms\n\n- **`workflowMode`**: the public mode or surface key a request resolves to.\n- **`packetKind`**: the axis a packet sits on, `workflow` for a mode that acts and `surface` for read-only evidence bundled alongside a mode.\n- **`backendKind`**: which backend runs the packet, `surface-router` or `review-cache` for a workflow mode and `evidence-base` for a surface.\n- **`surfaceBundle`**: the `routerPolicy.outcomes` entry where one workflow mode leads and zero or more surfaces follow as evidence.\n- **`mode-registry.json`**: the registry that owns each mode's discriminator, `surfaceDetection` markers and `advisorRouting`.\n- **`hub-router.json`**: stage one's `routerSignals`, `vocabularyClasses` and the surface-bundling policy.\n- **`ROUTER.md`**: stage two's `INTENT_SIGNALS` and `RESOURCE_MAP`, plus the `SHARED_CONTROL_RESOURCES` list and the always-loaded `DEFAULT_RESOURCE` preamble.\n- **shared control**: a hub-level resource declared in `SHARED_CONTROL_RESOURCES`, which resolves on disk and never projects as a leaf.\n- **leaf**: a typed `(workflowMode, leafResourceId)` pair from `leaf-manifest.json` that a `RESOURCE_MAP` path converts to.\n- **surface detection**: the shared detection order over the declared surfaces, which tries each specific surface first, then the `SKILLED` fallback, then `UNKNOWN`.\n- **`--surface-hint`**: the front-door flag that carries the detected surface into the compiled route, so a hinted surface leads a keyword tie.\n- **`UNKNOWN_FALLBACK`**: the load level the router returns, with a disambiguation checklist, when no mode resolves.\n\n### Layout\n```\nsk-code/\n  SKILL.md               # this routing hub (no per-mode code logic)\n  README.md              # human-facing front page for the hub\n  ROUTER.md              # active stage-two surface router and shared-control declaration\n  mode-registry.json     # the two-axis discriminator + advisorRouting contract\n  hub-router.json        # lexical routing signals + surfaceBundle policy for hub-local choice\n  description.json       # hub advisor descriptor\n  graph-metadata.json    # the ONE advisor identity for the whole skill\n  leaf-manifest.json     # typed (workflowMode, leaf) pairs the router guards validate\n  changelog/             # hub release notes, one v<version>.md per hub release\n  feature-catalog/       # current-state inventory of the hub's routing capabilities\n  manual-testing-playbook/  # routing and disambiguation scenarios for the hub\n  benchmark/             # historical routing benchmark inputs and reports\n  sk-code-quality/       # quality mode packet     (workflow)\n  sk-code-review/        # review mode packet      (workflow)\n  sk-code-ci/            # GitHub Actions workflow standards packet (read-only evidence; rules, protected set and scaffold templates)\n  sk-code-frontend/      # stack-agnostic web and Figma-to-code evidence packet (read-only; references/web-visual-values.md, web-visual-hierarchy.md and web-motion-and-interaction.md plus assets/tokens.css)\n  sk-code-skilled/      # skilled surface packet (read-only evidence; carries the workflow doctrine)\n  shared/                # shared surface-detection router, cross-mode helpers, and the implement/debug/verify workflow doctrine (references/workflow-*.md)\n```\n\nEach mode or surface packet is self-contained and carries no per-packet `graph-metadata.json`. Only this hub carries one, so the advisor discovers exactly one code skill identity. The implement/debug/verify workflow doctrine is a single shared source under `shared/references/`, and each surface symlinks it in rather than duplicating it.\n\n### Backend\nThe `surface-router` backend is the shared surface-detection router under `shared/`.\nIt centralizes the detection order over the declared surfaces, the SKILLED fallback and UNKNOWN.\nIt carries the shared implement → debug → verify workflow doctrine consumed by each surface.\nThe `review-cache` backend supports the sk-code-review mode's non-mutating review output cache.\nThe `evidence-base` backend serves the surface packets as read-only domain evidence (`sk-code-ci/`, `sk-code-frontend/`, `sk-code-skilled/`). The hub bundles them alongside the primary mode.\nThe packet mutates nothing and never carries process. The acting agent applies the doctrine it bundles.\nShared backend material provides surface identity, the workflow doctrine and cross-mode helpers.\nIt must never gain per-mode workflow contracts.\n\nThe **implement → debug → verify** phases are not standalone modes.\nTheir surface-agnostic doctrine lives once in `shared/references/workflow-implement.md`, `workflow-debug.md` and `workflow-verify.md`.\nThose files are symlinked into each surface, so the active surface carries the full workflow.\nA request to implement, debug or verify code causes the router to detect its surface and load that surface's bundled doctrine.\nThe acting agent applies that doctrine.\n\n### Maintenance\n\nAfter adding or removing a surface, run `/doctor:sk-code setup`. It checks the hub and names the repair for each failing check.\n\n---\n\n## 4. RULES\n\n### ✅ ALWAYS\n- **ALWAYS** resolve a mode through `mode-registry.json`, and never hardcode a router mapping in the hub.\n- **ALWAYS** keep mode contracts in the mode packets, so the hub stays routing-only.\n- **ALWAYS** keep exactly one `graph-metadata.json` (this hub's) so the advisor sees one skill identity.\n- **ALWAYS** give every mode an `advisorRouting` block with `routingClass: \"metadata\"` and the correct `packetSkillName`.\n- **ALWAYS** keep the implement/debug/verify workflow doctrine as one shared source under `shared/references/`, symlinked into each surface, and never fork per-surface copies.\n- **ALWAYS** keep `ROUTER.md` `RESOURCE_MAP` keys aligned with its intent keys and packet leaves aligned with `leaf-manifest.json`.\n- **ALWAYS** keep hub-shared map inputs explicit in `SHARED_CONTROL_RESOURCES`, because they are control resources and never typed leaves.\n\n### ⛔ NEVER\n- **NEVER** add a `graph-metadata.json` inside a mode packet or `shared/`.\n- **NEVER** put per-mode quality, review, or surface workflow logic in the hub.\n- **NEVER** hardcode a router mapping outside `mode-registry.json`.\n- **NEVER** reintroduce implement, debug, or verify as standalone mode packets, because they are surface-owned doctrine.\n\n### ⚠️ ESCALATE IF\n- A new code mode is needed - extend `mode-registry.json` and open a packet. Do not bolt logic onto the hub.\n- Surface identity and workflow ownership conflict in a way the shared router cannot classify.\n\n---\n\n## 5. REFERENCES\n\n- Workflow mode packets: `sk-code-quality/SKILL.md`, `sk-code-review/SKILL.md`.\n- Surface evidence packets: `sk-code-ci/SKILL.md`, `sk-code-frontend/SKILL.md`, `sk-code-skilled/SKILL.md`.\n- Shared workflow doctrine: `shared/references/workflow-implement.md`, `shared/references/workflow-debug.md`, `shared/references/workflow-verify.md` (symlinked into each surface).\n- Registry: `mode-registry.json` (two-axis: `packetKind` discriminates workflow vs surface).\n- Hub router signals + surface bundling: `hub-router.json`.\n- Surface router and shared controls: `ROUTER.md`.\n- Parent-skill pattern: `.skilled/skills/sk-doc/sk-create-skill/references/parent-skill/parent-skills-nested-packets.md`.\n- Sibling example: `.skilled/skills/sk-prompt/`.\n\nBase directory for this skill: /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.opencode/skills/sk-code\nRelative paths in this skill (e.g., scripts/, reference/) are relative to this base directory.\nNote: file list is sampled.\n\n<skill_files>\n<file>/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.opencode/skills/sk-code/README.md</file>\n<file>/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.opencode/skills/sk-code/ROUTER.md</file>\n<file>/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.opencode/skills/sk-code/benchmark/README.md</file>\n<file>/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.opencode/skills/sk-code/benchmark/reports/2026-06-01--after--router/README.md</file>\n<file>/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.opencode/skills/sk-code/benchmark/reports/2026-06-01--after--router/failed-runs.md</file>\n<file>/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.opencode/skills/sk-code/benchmark/reports/2026-06-01--after--router/findings-and-recommendations.md</file>\n<file>/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.opencode/skills/sk-code/benchmark/reports/2026-06-01--after--router/results.csv</file>\n<file>/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.opencode/skills/sk-code/benchmark/reports/2026-06-01--after--router/skill-benchmark-report.json</file>\n<file>/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.opencode/skills/sk-code/benchmark/reports/2026-06-01--after--router/skill-benchmark-report.md</file>\n<file>/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.opencode/skills/sk-code/benchmark/reports/2026-06-01--after--router/source.md</file>\n</skill_files>\n</skill_content>","title":"skill","metadata":{"metadata":{"name":"sk-code","directory":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.opencode/skills/sk-code","truncated":false},"content":[{"type":"text","text":"<skill_content name=\"sk-code\">\n# Skill: sk-code\n\n<!-- Keywords: sk-code, code, surface-aware, two-axis, opencode, typescript, python, shell, json, jsonc, github-actions, ci-workflow, sk-code-quality, sk-code-review, sk-code-ci, sk-code-frontend, quality, code-review, verification, debug, implement, workflow-doctrine, mode-registry, workflowmode, packetkind, backendkind, surface-router, evidence-base, surface-packet, guard, adapter, stderr, detector -->\n\n# Code Family Hub (sk-code)\n\nOne skill has two axes, one shared surface-detection router and one advisor identity.\nThe **workflow axis** has two code modes that act: sk-code-quality and sk-code-review.\nThe **surface axis** has three read-only evidence packets the hub bundles alongside a workflow mode: sk-code-ci, sk-code-frontend and sk-code-skilled.\nEach packet carries the shared **implement → debug → verify** workflow doctrine (`shared/references/workflow-*.md`, symlinked in) plus its own domain knowledge.\nThis hub holds NO per-mode logic. It routes by `workflowMode` through `mode-registry.json`, and each mode or surface keeps its own contract in its packet.\n\n**Version authority.** This file's `version` frontmatter is the hub's release version and matches the newest entry under `changelog/`.\n`description.json`, `mode-registry.json` and `hub-router.json` carry the same value. Each hub-root JSON routing file therefore states the same release.\n`ROUTER.md` and `README.md` keep their own document versions, as the frontmatter-versioning standard gives every doc but `SKILL.md`.\nThe authority stops at the hub root. Each `modes[]` packet carries its own version and release cadence.\nA packet version is independent of this one by design, so a gap between them is not drift.\n\n---\n\n## 1. WHEN TO USE\n\nUse this skill for code-family workflows. Invoke it as `sk-code` with an optional mode hint such as `quality: <request>`. The hub classifies the request, resolves a mode key, and loads the matching nested packet.\n\n**Workflow axis** (modes that act, one of them chosen as primary):\n\n| Mode | Use it for | Packet |\n|------|------------|--------|\n| **sk-code-quality** | Quality gate, P0/P1/P2 author checks, comment hygiene and surface checklists. | `sk-code/sk-code-quality/` |\n| **sk-code-review** | Findings-first review, security and correctness baseline, checklists, output contract and PR-state gates. | `sk-code/sk-code-review/` |\n\n**Surface axis** (read-only, advisor-invisible evidence. When a workflow mode scores, the hub bundles the surface after that primary mode. When no workflow mode scores, the hub routes the surface alone for a lookup, implement, debug or verify task, and the acting agent hands the author gates to `sk-code-quality` before it claims completion):\n\n| Surface | Carries | Packet |\n|---------|---------|--------|\n| **sk-code-ci** | GitHub Actions evidence: trigger, filter, permission, timeout, concurrency and caching rules, the protected set, the intentional message-contract exception and the scaffold templates, with the repository-specific values read from a CI profile. Read-only. | `sk-code/sk-code-ci/` |\n| **sk-code-frontend** | Stack-agnostic frontend evidence: web markup and CSS, web layout and accessibility, visual values, visual hierarchy and review, motion and interaction, the `tokens.css` starter tokens and Figma-to-code checks. Read-only. | `sk-code/sk-code-frontend/` |\n| **sk-code-skilled** | System-code evidence: TypeScript/Python/shell/config standards, hooks, alignment verification, authoring checklists. Bundles the implement → debug → verify workflow doctrine (read-only evidence) for the Skilled surface, and the acting agent applies it. | `sk-code/sk-code-skilled/` |\n\n**Surface list.** The hub has exactly three surfaces:\n- SKILLED (`sk-code-skilled`): the native surface for this framework's own code.\n- CI (`sk-code-ci`): the GitHub Actions workflow standards surface.\n- Frontend (`sk-code-frontend`): the stack-agnostic web practice and Figma-to-code surface, with visual values, visual hierarchy and review, and motion and interaction guidance, bundled from request vocabulary alone.\n\nThe hub also has two workflow modes: quality (`sk-code-quality`) and review (`sk-code-review`).\nAny other sk-code doc that counts surfaces points to this sentence.\n\n### When NOT to Use\n- Documentation-only changes with no code-work contract - use `sk-doc`.\n- Git workflow, branch, commit, PR, merge, or release work - use `sk-git`.\n- Pure browser inspection or external MCP transport work - use the relevant MCP skill.\n- For a measured Style Reference (design tokens extracted from a live source), use `sk-design-md-generator` first.\n- When a request or a frame leaves a visual value open (spacing, type, color, radius, shadow or motion), or a value sits off every token and scale, load `sk-code-frontend` and decide it from its visual-values reference.\n- Backend support primitives in `shared/` - they are consumed by the modes, not invoked as a user workflow.\n\n---\n\n## 2. SMART ROUTING\n\nRouting is **registry-driven at runtime and authored in `hub-router.json`** in two stages.\nStage 1 (hub → mode) uses `hub-router.json` as the authored mode vocabulary. `mode-registry.json` carries the packet contracts, whose aliases are checked against that vocabulary.\nStage 2 (mode → leaves) uses the root [`ROUTER.md`](./ROUTER.md) as the authored leaf-set router.\nBoth files point back here instead of restating the split.\n\nThe advisor routes every code query to the single identity `sk-code`. Resolve the mode with `node .skilled/bin/compiled-route.cjs --hub sk-code --prompt \"<task>\"` and follow the decision: `route` loads its `targets`, `clarify` and `defer` ask, `reject` refuses.\nCompiled routing is the default. The legacy fallback, the kill-switch and the `UNKNOWN_FALLBACK_CHECKLIST` live in the compiled-routing section of [`ROUTER.md`](./ROUTER.md).\n\nA bare implement, debug or verify request with no workflow mode becomes a pure surface bundle, and an unclear code intent asks for disambiguation. Neither path forces a stale default.\nRun the compiled-routing directive in [`ROUTER.md`](./ROUTER.md) before selecting hub resources.\n\n---\n\n## 3. HOW IT WORKS\n\n### Terms\n\n- **`workflowMode`**: the public mode or surface key a request resolves to.\n- **`packetKind`**: the axis a packet sits on, `workflow` for a mode that acts and `surface` for read-only evidence bundled alongside a mode.\n- **`backendKind`**: which backend runs the packet, `surface-router` or `review-cache` for a workflow mode and `evidence-base` for a surface.\n- **`surfaceBundle`**: the `routerPolicy.outcomes` entry where one workflow mode leads and zero or more surfaces follow as evidence.\n- **`mode-registry.json`**: the registry that owns each mode's discriminator, `surfaceDetection` markers and `advisorRouting`.\n- **`hub-router.json`**: stage one's `routerSignals`, `vocabularyClasses` and the surface-bundling policy.\n- **`ROUTER.md`**: stage two's `INTENT_SIGNALS` and `RESOURCE_MAP`, plus the `SHARED_CONTROL_RESOURCES` list and the always-loaded `DEFAULT_RESOURCE` preamble.\n- **shared control**: a hub-level resource declared in `SHARED_CONTROL_RESOURCES`, which resolves on disk and never projects as a leaf.\n- **leaf**: a typed `(workflowMode, leafResourceId)` pair from `leaf-manifest.json` that a `RESOURCE_MAP` path converts to.\n- **surface detection**: the shared detection order over the declared surfaces, which tries each specific surface first, then the `SKILLED` fallback, then `UNKNOWN`.\n- **`--surface-hint`**: the front-door flag that carries the detected surface into the compiled route, so a hinted surface leads a keyword tie.\n- **`UNKNOWN_FALLBACK`**: the load level the router returns, with a disambiguation checklist, when no mode resolves.\n\n### Layout\n```\nsk-code/\n  SKILL.md               # this routing hub (no per-mode code logic)\n  README.md              # human-facing front page for the hub\n  ROUTER.md              # active stage-two surface router and shared-control declaration\n  mode-registry.json     # the two-axis discriminator + advisorRouting contract\n  hub-router.json        # lexical routing signals + surfaceBundle policy for hub-local choice\n  description.json       # hub advisor descriptor\n  graph-metadata.json    # the ONE advisor identity for the whole skill\n  leaf-manifest.json     # typed (workflowMode, leaf) pairs the router guards validate\n  changelog/             # hub release notes, one v<version>.md per hub release\n  feature-catalog/       # current-state inventory of the hub's routing capabilities\n  manual-testing-playbook/  # routing and disambiguation scenarios for the hub\n  benchmark/             # historical routing benchmark inputs and reports\n  sk-code-quality/       # quality mode packet     (workflow)\n  sk-code-review/        # review mode packet      (workflow)\n  sk-code-ci/            # GitHub Actions workflow standards packet (read-only evidence; rules, protected set and scaffold templates)\n  sk-code-frontend/      # stack-agnostic web and Figma-to-code evidence packet (read-only; references/web-visual-values.md, web-visual-hierarchy.md and web-motion-and-interaction.md plus assets/tokens.css)\n  sk-code-skilled/      # skilled surface packet (read-only evidence; carries the workflow doctrine)\n  shared/                # shared surface-detection router, cross-mode helpers, and the implement/debug/verify workflow doctrine (references/workflow-*.md)\n```\n\nEach mode or surface packet is self-contained and carries no per-packet `graph-metadata.json`. Only this hub carries one, so the advisor discovers exactly one code skill identity. The implement/debug/verify workflow doctrine is a single shared source under `shared/references/`, and each surface symlinks it in rather than duplicating it.\n\n### Backend\nThe `surface-router` backend is the shared surface-detection router under `shared/`.\nIt centralizes the detection order over the declared surfaces, the SKILLED fallback and UNKNOWN.\nIt carries the shared implement → debug → verify workflow doctrine consumed by each surface.\nThe `review-cache` backend supports the sk-code-review mode's non-mutating review output cache.\nThe `evidence-base` backend serves the surface packets as read-only domain evidence (`sk-code-ci/`, `sk-code-frontend/`, `sk-code-skilled/`). The hub bundles them alongside the primary mode.\nThe packet mutates nothing and never carries process. The acting agent applies the doctrine it bundles.\nShared backend material provides surface identity, the workflow doctrine and cross-mode helpers.\nIt must never gain per-mode workflow contracts.\n\nThe **implement → debug → verify** phases are not standalone modes.\nTheir surface-agnostic doctrine lives once in `shared/references/workflow-implement.md`, `workflow-debug.md` and `workflow-verify.md`.\nThose files are symlinked into each surface, so the active surface carries the full workflow.\nA request to implement, debug or verify code causes the router to detect its surface and load that surface's bundled doctrine.\nThe acting agent applies that doctrine.\n\n### Maintenance\n\nAfter adding or removing a surface, run `/doctor:sk-code setup`. It checks the hub and names the repair for each failing check.\n\n---\n\n## 4. RULES\n\n### ✅ ALWAYS\n- **ALWAYS** resolve a mode through `mode-registry.json`, and never hardcode a router mapping in the hub.\n- **ALWAYS** keep mode contracts in the mode packets, so the hub stays routing-only.\n- **ALWAYS** keep exactly one `graph-metadata.json` (this hub's) so the advisor sees one skill identity.\n- **ALWAYS** give every mode an `advisorRouting` block with `routingClass: \"metadata\"` and the correct `packetSkillName`.\n- **ALWAYS** keep the implement/debug/verify workflow doctrine as one shared source under `shared/references/`, symlinked into each surface, and never fork per-surface copies.\n- **ALWAYS** keep `ROUTER.md` `RESOURCE_MAP` keys aligned with its intent keys and packet leaves aligned with `leaf-manifest.json`.\n- **ALWAYS** keep hub-shared map inputs explicit in `SHARED_CONTROL_RESOURCES`, because they are control resources and never typed leaves.\n\n### ⛔ NEVER\n- **NEVER** add a `graph-metadata.json` inside a mode packet or `shared/`.\n- **NEVER** put per-mode quality, review, or surface workflow logic in the hub.\n- **NEVER** hardcode a router mapping outside `mode-registry.json`.\n- **NEVER** reintroduce implement, debug, or verify as standalone mode packets, because they are surface-owned doctrine.\n\n### ⚠️ ESCALATE IF\n- A new code mode is needed - extend `mode-registry.json` and open a packet. Do not bolt logic onto the hub.\n- Surface identity and workflow ownership conflict in a way the shared router cannot classify.\n\n---\n\n## 5. REFERENCES\n\n- Workflow mode packets: `sk-code-quality/SKILL.md`, `sk-code-review/SKILL.md`.\n- Surface evidence packets: `sk-code-ci/SKILL.md`, `sk-code-frontend/SKILL.md`, `sk-code-skilled/SKILL.md`.\n- Shared workflow doctrine: `shared/references/workflow-implement.md`, `shared/references/workflow-debug.md`, `shared/references/workflow-verify.md` (symlinked into each surface).\n- Registry: `mode-registry.json` (two-axis: `packetKind` discriminates workflow vs surface).\n- Hub router signals + surface bundling: `hub-router.json`.\n- Surface router and shared controls: `ROUTER.md`.\n- Parent-skill pattern: `.skilled/skills/sk-doc/sk-create-skill/references/parent-skill/parent-skills-nested-packets.md`.\n- Sibling example: `.skilled/skills/sk-prompt/`.\n\nBase directory for this skill: /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.opencode/skills/sk-code\nRelative paths in this skill (e.g., scripts/, reference/) are relative to this base directory.\nNote: file list is sampled.\n\n<skill_files>\n<file>/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.opencode/skills/sk-code/README.md</file>\n<file>/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.opencode/skills/sk-code/ROUTER.md</file>\n<file>/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.opencode/skills/sk-code/benchmark/README.md</file>\n<file>/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.opencode/skills/sk-code/benchmark/reports/2026-06-01--after--router/README.md</file>\n<file>/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.opencode/skills/sk-code/benchmark/reports/2026-06-01--after--router/failed-runs.md</file>\n<file>/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.opencode/skills/sk-code/benchmark/reports/2026-06-01--after--router/findings-and-recommendations.md</file>\n<file>/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.opencode/skills/sk-code/benchmark/reports/2026-06-01--after--router/results.csv</file>\n<file>/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.opencode/skills/sk-code/benchmark/reports/2026-06-01--after--router/skill-benchmark-report.json</file>\n<file>/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.opencode/skills/sk-code/benchmark/reports/2026-06-01--after--router/skill-benchmark-report.md</file>\n<file>/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.opencode/skills/sk-code/benchmark/reports/2026-06-01--after--router/source.md</file>\n</skill_files>\n</skill_content>"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"id\":\"sk-code\"}"},"time":{"start":1794528164011,"end":1794528164087}}}}
