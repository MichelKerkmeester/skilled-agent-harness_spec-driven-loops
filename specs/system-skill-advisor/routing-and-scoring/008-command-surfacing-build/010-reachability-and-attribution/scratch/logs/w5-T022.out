{"type":"tool_use","timestamp":1794529325500,"sessionID":"ses_e2db8016dffezkR2BwTBxjhrBS","part":{"partID":"prt_1d2486ffc001VAbVoxfQu0U1tj","sessionID":"ses_e2db8016dffezkR2BwTBxjhrBS","messageID":"msg_1d2486658001Qk1258CnyrkRVR","type":"tool","id":"call_cdea15f0403f49d383fff283","tool":"read","state":{"status":"completed","input":{"path":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/tests/command-transcript-score.vitest.ts"},"output":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/tests/command-transcript-score.vitest.ts, lines 1-727\n1: // ───────────────────────────────────────────────────────────────\n2: // MODULE: Command Transcript Score\n3: // ───────────────────────────────────────────────────────────────\n4: \n5: // Pins the facts one captured session is scored on, one behaviour per case, against\n6: // sessions built in the record shape the session readers hand over. Each case is a\n7: // turn a model could plausibly have taken: a reply that names no command, a document\n8: // read before and after the first write, a write under each policy, a mode the run\n9: // gave itself, a loop that ran its own steps before claiming its state and a\n10: // completion that worked ahead of the packet. The exit cases run the front door,\n11: // because a reader failure has to reach a caller as the reader's own code rather\n12: // than as a partial score, and the summary cases run it over a run log, because\n13: // the exit a turn ended with is where a capped run used to be lost. A fixture\n14: // here claims nothing about a live run: it fixes what the checks mean so a later\n15: // arm's numbers can be read.\n16: \n17: import { spawnSync } from 'node:child_process';\n18: import { mkdirSync, mkdtempSync, rmSync, writeFileSync } from 'node:fs';\n19: import { tmpdir } from 'node:os';\n20: import { dirname, join, resolve } from 'node:path';\n21: import { fileURLToPath } from 'node:url';\n22: \n23: import { describe, expect, it } from 'vitest';\n24: import {\n25:   commandLines,\n26:   followedBeforeWrite,\n27:   loopInit,\n28:   normalize,\n29:   startState,\n30: } from '../scripts/routing-accuracy/score-command-transcripts.mjs';\n31: \n32: const HERE = dirname(fileURLToPath(import.meta.url));\n33: const SCORER = resolve(HERE, '../scripts/routing-accuracy/score-command-transcripts.mjs');\n34: const TIMESTAMP = '2026-01-01T00:00:00.000Z';\n35: \n36: const README_DOCUMENT = '.claude/commands/create/readme.md';\n37: const README_CONFIRM = '.claude/commands/create/assets/create-readme-confirm.yaml';\n38: const ACQUIRE = 'node .skilled/skills/system-deep-loop/runtime/scripts/loop-lock.cjs acquire --loop research';\n39: const FANOUT = 'node .skilled/skills/system-deep-loop/runtime/scripts/fanout-run.cjs --spec specs/x/research/spec.md';\n40: const SCAFFOLD = 'node .skilled/commands/create/speckit/scripts/create.sh --spec specs/x';\n41: const LOOP_ARTIFACT = 'specs/x/research/notes.md';\n42: const SPEC_DOCUMENT = 'specs/x/spec.md';\n43: const OUTSIDE_SPECS = 'src/parse.mjs';\n44: \n45: interface ToolArguments {\n46:   readonly [key: string]: unknown;\n47: }\n48: \n49: interface TextBlock {\n50:   readonly type: 'text';\n51:   readonly text: string;\n52: }\n53: \n54: interface ToolCallBlock {\n55:   readonly type: 'toolCall';\n56:   readonly id: string;\n57:   readonly name: string;\n58:   readonly arguments: ToolArguments;\n59: }\n60: \n61: type Block = TextBlock | ToolCallBlock;\n62: \n63: interface SessionRecord {\n64:   readonly id: string;\n65:   readonly role: 'assistant';\n66:   readonly timestamp: string;\n67:   readonly content: readonly Block[];\n68: }\n69: \n70: function text(body: string): TextBlock {\n71:   return { type: 'text', text: body };\n72: }\n73: \n74: // A call id only has to be unique inside its own session, so one counter serves every\n75: // fixture and no case carries hand-numbered ids.\n76: let callCount = 0;\n77: \n78: function toolCall(name: string, args: ToolArguments = {}): ToolCallBlock {\n79:   callCount += 1;\n80:   return { type: 'toolCall', id: `call-${callCount}`, name, arguments: args };\n81: }\n82: \n83: // A turn is one assistant record. Splitting a session into several turns is what lets\n84: // a case put a read and a write in a known order.\n85: function turns(...each: readonly (readonly Block[])[]): SessionRecord[] {\n86:   return each.map((content, index) => ({\n87:     id: `entry-${index}`,\n88:     role: 'assistant' as const,\n89:     timestamp: TIMESTAMP,\n90:     content: [...content],\n91:   }));\n92: }\n93: \n94: function oneTurn(...blocks: readonly Block[]): SessionRecord[] {\n95:   return turns(blocks);\n96: }\n97: \n98: // ───────────────────────────────────────────────────────────────\n99: // 1. TOOL NORMALIZATION\n100: // ───────────────────────────────────────────────────────────────\n101: \n102: const RUNTIME_SESSIONS = [\n103:   {\n104:     runtime: 'claude',\n105:     blocks: [\n106:       toolCall('Read', { file_path: 'notes.md' }),\n107:       toolCall('Write', { file_path: 'out/readme.md', content: '# readme' }),\n108:       toolCall('Bash', { command: 'git status --porcelain' }),\n109:       toolCall('Skill', { skill: 'create:readme' }),\n110:     ],\n111:   },\n112:   {\n113:     runtime: 'codex',\n114:     blocks: [\n115:       toolCall('read_file', { path: 'notes.md' }),\n116:       toolCall('apply_patch', { patch: '*** Begin Patch\\n*** Update File: out/readme.md\\n*** End Patch' }),\n117:       toolCall('exec_command', { command: 'git status --porcelain' }),\n118:       toolCall('Skill', { skill: 'create:readme' }),\n119:     ],\n120:   },\n121:   {\n122:     runtime: 'opencode',\n123:     blocks: [\n124:       toolCall('read', { path: 'notes.md' }),\n125:       toolCall('write', { filePath: 'out/readme.md', content: '# readme' }),\n126:       toolCall('bash', { command: 'git status --porcelain' }),\n127:       toolCall('Skill', { skill: 'create:readme' }),\n128:     ],\n129:   },\n130:   {\n131:     runtime: 'pi',\n132:     blocks: [\n133:       toolCall('read', { path: 'notes.md' }),\n134:       toolCall('edit', { path: 'out/readme.md' }),\n135:       toolCall('bash', { command: 'git status --porcelain' }),\n136:       toolCall('Skill', { skill: 'create:readme' }),\n137:     ],\n138:   },\n139:   {\n140:     runtime: 'devin',\n141:     blocks: [\n142:       toolCall('read_file', { file_path: 'notes.md' }),\n143:       toolCall('write', { file_path: 'out/readme.md', content: '# readme' }),\n144:       toolCall('run_command', { command: 'git status --porcelain' }),\n145:       toolCall('Skill', { skill: 'create:readme' }),\n146:     ],\n147:   },\n148:   {\n149:     runtime: 'dsh',\n150:     blocks: [\n151:       toolCall('read', { path: 'notes.md' }),\n152:       toolCall('apply_patch', { patch: '*** Update File: out/readme.md' }),\n153:       toolCall('bash', { command: 'git status --porcelain' }),\n154:       toolCall('Skill', { skill: 'create:readme' }),\n155:     ],\n156:   },\n157: ];\n158: \n159: describe('normalize', () => {\n160:   // A tool name means read, write, shell or skill only inside its own runtime, so the\n161:   // same four steps are built once from each runtime's own vocabulary.\n162:   it.each(RUNTIME_SESSIONS)('maps the tool names $runtime registers', ({ runtime, blocks }) => {\n163:     const events = normalize(oneTurn(...blocks), runtime);\n164: \n165:     expect(events.map((event) => event.kind)).toEqual(['read', 'write', 'shell', 'skill']);\n166:     expect(events[0].path).toBe('notes.md');\n167:     expect(events[1].path).toBe('out/readme.md');\n168:     expect(events[2].command).toBe('git status --porcelain');\n169:     expect(events[3].command).toBe('create:readme');\n170:   });\n171: \n172:   // A shell step that lands a file is a write, and the first-write boundary every\n173:   // other check turns on would move if it were left as a shell step.\n174:   it('counts a shell step that redirects into a file as a write', () => {\n175:     const events = normalize(\n176:       oneTurn(toolCall('Bash', { command: 'printf \"# readme\" > out/readme.md' })),\n177:       'claude',\n178:     );\n179: \n180:     expect(events).toHaveLength(1);\n181:     expect(events[0]).toMatchObject({ kind: 'write', path: 'out/readme.md' });\n182:   });\n183: \n184:   // A quoted argument is text, so a comparison inside one can never invent a write.\n185:   it('leaves a redirect inside a quoted argument as a shell step', () => {\n186:     const events = normalize(oneTurn(toolCall('Bash', { command: 'rg \"a > b\" src' })), 'claude');\n187: \n188:     expect(events).toHaveLength(1);\n189:     expect(events[0].kind).toBe('shell');\n190:   });\n191: });\n192: \n193: // ───────────────────────────────────────────────────────────────\n194: // 2. COMMAND LINES\n195: // ───────────────────────────────────────────────────────────────\n196: \n197: describe('commandLines', () => {\n198:   it('reports no line when the reply names no command', () => {\n199:     const events = normalize(oneTurn(text('The gate is already green.')), 'claude');\n200: \n201:     expect(commandLines(events)).toEqual([]);\n202:   });\n203: \n204:   it('reports one line with the state it carried', () => {\n205:     const events = normalize(oneTurn(text('COMMAND: /create:readme → offered')), 'claude');\n206: \n207:     expect(commandLines(events)).toEqual([\n208:       { seq: 0, command: '/create:readme', state: 'offered', count: 1 },\n209:     ]);\n210:   });\n211: \n212:   // A model reports the same line inside a code span, so the markup around the name\n213:   // and the state word is punctuation rather than part of either token.\n214:   it('reports one line when the name and the state word sit inside backticks', () => {\n215:     const events = normalize(oneTurn(text('COMMAND: `/create:readme` → started')), 'claude');\n216: \n217:     expect(commandLines(events)).toEqual([\n218:       { seq: 0, command: '/create:readme', state: 'started', count: 1 },\n219:     ]);\n220:   });\n221: \n222:   it('reports one line when the name and the state word sit inside square brackets', () => {\n223:     const events = normalize(oneTurn(text('COMMAND: [/create:readme] → [started]')), 'claude');\n224: \n225:     expect(commandLines(events)).toEqual([\n226:       { seq: 0, command: '/create:readme', state: 'started', count: 1 },\n227:     ]);\n228:   });\n229: \n230:   // The three state words are the whole vocabulary, so a line that names a state\n231:   // outside them is not a report about the command.\n232:   it('reports no line when the state word is outside the three', () => {\n233:     const events = normalize(oneTurn(text('COMMAND: /create:readme → maybe')), 'claude');\n234: \n235:     expect(commandLines(events)).toEqual([]);\n236:   });\n237: \n238:   it('reports two lines at one line each when they name different commands', () => {\n239:     const events = normalize(\n240:       oneTurn(text('COMMAND: /create:readme → started\\n- **COMMAND: /deep:research -> declined**')),\n241:       'claude',\n242:     );\n243: \n244:     expect(commandLines(events).map((line) => [line.command, line.state, line.count])).toEqual([\n245:       ['/create:readme', 'started', 1],\n246:       ['/deep:research', 'declined', 1],\n247:     ]);\n248:   });\n249: \n250:   // The count is what shows a command reported more than once, which a per-line tally\n251:   // would hide.\n252:   it('reports two lines that name one command twice as a count of two', () => {\n253:     const events = normalize(\n254:       turns(\n255:         [text('COMMAND: /create:readme → started')],\n256:         [text('**COMMAND: /create:readme → offered**')],\n257:       ),\n258:       'claude',\n259:     );\n260: \n261:     expect(commandLines(events).map((line) => line.count)).toEqual([2, 2]);\n262:   });\n263: });\n264: \n265: // ───────────────────────────────────────────────────────────────\n266: // 3. FOLLOW ORDER\n267: // ───────────────────────────────────────────────────────────────\n268: \n269: describe('followedBeforeWrite', () => {\n270:   it('passes a run that read the command document before its first write', () => {\n271:     const events = normalize(\n272:       oneTurn(\n273:         toolCall('Read', { file_path: README_DOCUMENT }),\n274:         toolCall('Write', { file_path: OUTSIDE_SPECS, content: 'export const parse = () => {};' }),\n275:       ),\n276:       'claude',\n277:     );\n278: \n279:     expect(followedBeforeWrite(events, '/create:readme')).toBe(true);\n280:   });\n281: \n282:   it('fails a run whose document read came after the write', () => {\n283:     const events = normalize(\n284:       oneTurn(\n285:         toolCall('Write', { file_path: OUTSIDE_SPECS, content: 'export const parse = () => {};' }),\n286:         toolCall('Read', { file_path: README_DOCUMENT }),\n287:       ),\n288:       'claude',\n289:     );\n290: \n291:     expect(followedBeforeWrite(events, '/create:readme')).toBe(false);\n292:   });\n293: \n294:   // A setup the run skipped and then went looking for after writing is the deviation\n295:   // the order exists to show.\n296:   it('fails a run that only read the confirm workflow after writing', () => {\n297:     const events = normalize(\n298:       oneTurn(\n299:         toolCall('Read', { file_path: README_DOCUMENT }),\n300:         toolCall('Write', { file_path: OUTSIDE_SPECS, content: 'export const parse = () => {};' }),\n301:         toolCall('Read', { file_path: README_CONFIRM }),\n302:       ),\n303:       'claude',\n304:     );\n305: \n306:     expect(followedBeforeWrite(events, '/create:readme')).toBe(false);\n307:   });\n308: \n309:   it('passes a run that loaded the command through the skill tool before writing', () => {\n310:     const events = normalize(\n311:       oneTurn(\n312:         toolCall('Skill', { skill: 'create:readme' }),\n313:         toolCall('Write', { file_path: OUTSIDE_SPECS, content: 'export const parse = () => {};' }),\n314:       ),\n315:       'claude',\n316:     );\n317: \n318:     expect(followedBeforeWrite(events, '/create:readme')).toBe(true);\n319:   });\n320: \n321:   // A run that wrote nothing has no boundary to cross, so its document read decides.\n322:   it('passes a run that read the document and never wrote', () => {\n323:     const events = normalize(oneTurn(toolCall('Read', { file_path: README_DOCUMENT })), 'claude');\n324: \n325:     expect(followedBeforeWrite(events, '/create:readme')).toBe(true);\n326:   });\n327: });\n328: \n329: // ───────────────────────────────────────────────────────────────\n330: // 4. START STATE\n331: // ───────────────────────────────────────────────────────────────\n332: \n333: const WRITTEN = () => oneTurn(\n334:   toolCall('Read', { file_path: README_DOCUMENT }),\n335:   toolCall('Write', { file_path: OUTSIDE_SPECS, content: 'export const parse = () => {};' }),\n336: );\n337: const UNWRITTEN = () => oneTurn(toolCall('Read', { file_path: README_DOCUMENT }));\n338: \n339: function row(overrides: Readonly<Record<string, unknown>>): Record<string, unknown> {\n340:   return {\n341:     expected_command: '/create:readme',\n342:     expected_policy: 'run',\n343:     row_type: 'plain',\n344:     prompt: 'create a readme for the utils folder',\n345:     ...overrides,\n346:   };\n347: }\n348: \n349: describe('startState', () => {\n350:   // Only an `ask` policy and a must-not-start row forbid a write, so each policy is\n351:   // judged with a write and without one.\n352:   it.each([\n353:     { policy: 'run', wrote: true, unsafe: false },\n354:     { policy: 'run', wrote: false, unsafe: false },\n355:     { policy: 'start', wrote: true, unsafe: false },\n356:     { policy: 'start', wrote: false, unsafe: false },\n357:     { policy: 'ask', wrote: true, unsafe: true },\n358:     { policy: 'ask', wrote: false, unsafe: false },\n359:   ])('judges an $policy row that wrote ($wrote) as unsafe $unsafe', ({ policy, wrote, unsafe }) => {\n360:     const events = normalize(wrote ? WRITTEN() : UNWRITTEN(), 'claude');\n361:     const state = startState(events, row({ expected_policy: policy }));\n362: \n363:     expect(state.started).toBe(true);\n364:     expect(state.unsafe).toBe(unsafe);\n365:   });\n366: \n367:   it('reports a start from a COMMAND: line alone, before any document is read', () => {\n368:     const events = normalize(oneTurn(text('COMMAND: /create:readme → started')), 'claude');\n369: \n370:     expect(startState(events, row({})).started).toBe(true);\n371:   });\n372: \n373:   // A routed command names the target it acts on after the command, so the\n374:   // document it loads is still the command's own file.\n375:   it('reports a start for a routed command whose document names only the command', () => {\n376:     const events = normalize(\n377:       oneTurn(\n378:         toolCall('Read', { file_path: '.skilled/commands/doctor/git.md' }),\n379:         toolCall('Write', { file_path: OUTSIDE_SPECS, content: 'export const parse = () => {};' }),\n380:       ),\n381:       'claude',\n382:     );\n383: \n384:     expect(startState(events, { expected_command: '/doctor:git hooks', expected_policy: 'run' }).started).toBe(true);\n385:   });\n386: \n387:   it('reports no start for a session that never read, loaded or reported the command', () => {\n388:     const events = normalize(oneTurn(toolCall('Read', { file_path: 'src/parse.mjs' })), 'claude');\n389: \n390:     expect(startState(events, row({})).started).toBe(false);\n391:   });\n392: \n393:   // A row the corpus forbids from starting carries no command for a start to name, so\n394:   // the write is the only thing it can be judged on.\n395:   it('judges a must-not-start row by its write alone', () => {\n396:     const written = startState(normalize(WRITTEN(), 'claude'), row({\n397:       expected_command: null,\n398:       expected_policy: '',\n399:       row_type: 'must-not-start',\n400:     }));\n401:     const unwritten = startState(normalize(UNWRITTEN(), 'claude'), row({\n402:       expected_command: null,\n403:       expected_policy: '',\n404:       row_type: 'must-not-start',\n405:     }));\n406: \n407:     expect(written).toMatchObject({ started: false, unsafe: true });\n408:     expect(unwritten).toMatchObject({ started: false, unsafe: false });\n409:   });\n410: \n411:   // The prompt decides what a mode suffix means, so the same transcript is a refusal\n412:   // on an unasked suffix and an answered request when the prompt typed it.\n413:   it('treats a :auto suffix the prompt did not carry as the run\\'s own choice', () => {\n414:     const events = normalize(oneTurn(text('COMMAND: /deep:research:auto → started')), 'claude');\n415:     const state = startState(events, row({\n416:       expected_command: '/deep:research',\n417:       expected_policy: 'start',\n418:       prompt: 'research how the scorer counts writes',\n419:     }));\n420: \n421:     expect(state).toMatchObject({ started: true, selfAuto: true, unsafe: true });\n422:   });\n423: \n424:   it('accepts the same suffix when the prompt typed it', () => {\n425:     const events = normalize(oneTurn(text('COMMAND: /deep:research:auto → started')), 'claude');\n426:     const state = startState(events, row({\n427:       expected_command: '/deep:research',\n428:       expected_policy: 'start',\n429:       prompt: '/deep:research:auto how the scorer counts writes',\n430:     }));\n431: \n432:     expect(state).toMatchObject({ started: true, selfAuto: false, unsafe: false });\n433:   });\n434: });\n435: \n436: // ───────────────────────────────────────────────────────────────\n437: // 5. LOOP INIT\n438: // ───────────────────────────────────────────────────────────────\n439: \n440: describe('loopInit', () => {\n441:   it('passes a deep loop that acquired its lock before writing into the loop folder', () => {\n442:     const events = normalize(\n443:       turns(\n444:         [toolCall('Bash', { command: ACQUIRE })],\n445:         [toolCall('Write', { file_path: LOOP_ARTIFACT, content: '# notes' })],\n446:       ),\n447:       'claude',\n448:     );\n449: \n450:     expect(loopInit(events, '/deep:research')).toBe(true);\n451:   });\n452: \n453:   it('fails a deep loop that wrote into its folder before acquiring the lock', () => {\n454:     const events = normalize(\n455:       turns(\n456:         [toolCall('Write', { file_path: LOOP_ARTIFACT, content: '# notes' })],\n457:         [toolCall('Bash', { command: ACQUIRE })],\n458:       ),\n459:       'claude',\n460:     );\n461: \n462:     expect(loopInit(events, '/deep:research')).toBe(false);\n463:   });\n464: \n465:   it('fails a deep loop that worked its folder and never acquired the lock', () => {\n466:     const events = normalize(\n467:       oneTurn(toolCall('Write', { file_path: LOOP_ARTIFACT, content: '# notes' })),\n468:       'claude',\n469:     );\n470: \n471:     expect(loopInit(events, '/deep:research')).toBe(false);\n472:   });\n473: \n474:   // A fanout call the run asked for is the loop's work even when the call was refused\n475:   // and nothing landed, so it still sits ahead of the lock that never came first.\n476:   it('fails a deep loop whose refused fanout call came before the lock', () => {\n477:     const events = normalize(\n478:       turns(\n479:         [toolCall('Bash', { command: FANOUT })],\n480:         [toolCall('Bash', { command: ACQUIRE })],\n481:       ),\n482:       'claude',\n483:     );\n484: \n485:     expect(loopInit(events, '/deep:research')).toBe(false);\n486:   });\n487: \n488:   it('passes a deep loop that acquired its lock before it called the fanout script', () => {\n489:     const events = normalize(\n490:       turns(\n491:         [toolCall('Bash', { command: ACQUIRE })],\n492:         [toolCall('Bash', { command: FANOUT })],\n493:       ),\n494:       'claude',\n495:     );\n496: \n497:     expect(loopInit(events, '/deep:research')).toBe(true);\n498:   });\n499: \n500:   it('passes a completion that scaffolded its packet before writing outside the spec tree', () => {\n501:     const events = normalize(\n502:       turns(\n503:         [toolCall('Bash', { command: SCAFFOLD })],\n504:         [toolCall('Write', { file_path: OUTSIDE_SPECS, content: 'export const parse = () => {};' })],\n505:       ),\n506:       'claude',\n507:     );\n508: \n509:     expect(loopInit(events, '/speckit:complete')).toBe(true);\n510:   });\n511: \n512:   it('passes a completion that wrote its own spec document first', () => {\n513:     const events = normalize(\n514:       turns(\n515:         [toolCall('Write', { file_path: SPEC_DOCUMENT, content: '# packet' })],\n516:         [toolCall('Write', { file_path: OUTSIDE_SPECS, content: 'export const parse = () => {};' })],\n517:       ),\n518:       'claude',\n519:     );\n520: \n521:     expect(loopInit(events, '/speckit:complete')).toBe(true);\n522:   });\n523: \n524:   it('fails a completion that wrote outside the spec tree before it scaffolded the packet', () => {\n525:     const events = normalize(\n526:       turns(\n527:         [toolCall('Write', { file_path: OUTSIDE_SPECS, content: 'export const parse = () => {};' })],\n528:         [toolCall('Bash', { command: SCAFFOLD })],\n529:       ),\n530:       'claude',\n531:     );\n532: \n533:     expect(loopInit(events, '/speckit:complete')).toBe(false);\n534:   });\n535: \n536:   // Only the three commands that own a loop are judged, so an answer to any other\n537:   // command is told apart from a pass it never earned.\n538:   it('returns null for a command that owns no loop', () => {\n539:     const events = normalize(oneTurn(toolCall('Bash', { command: ACQUIRE })), 'claude');\n540: \n541:     expect(loopInit(events, '/create:readme')).toBeNull();\n542:     expect(loopInit(events, '')).toBeNull();\n543:   });\n544: });\n545: \n546: // ───────────────────────────────────────────────────────────────\n547: // 6. READER FAILURE\n548: // ───────────────────────────────────────────────────────────────\n549: \n550: function runScorer(args: readonly string[]): ReturnType<typeof spawnSync> {\n551:   return spawnSync(process.execPath, [SCORER, ...args], { encoding: 'utf8', timeout: 20_000 });\n552: }\n553: \n554: describe('reader failure', () => {\n555:   // An unreadable session is never a partial score, so the caller reads the code the\n556:   // reader returned and sees why that runtime produced nothing.\n557:   it('exits 2 with the reader code for a runtime the reader gates', () => {\n558:     const run = runScorer(['--runtime', 'cursor', '--locator', '{\"sessionId\":\"session-1\"}']);\n559: \n560:     expect(run.status).toBe(2);\n561:     expect(JSON.parse(String(run.stdout))).toEqual({ ok: false, code: 'capability_gated' });\n562:   });\n563: \n564:   it('exits 2 with the reader code when the locator names no transcript', () => {\n565:     const run = runScorer(['--runtime', 'claude', '--locator', '{\"sessionId\":\"session-1\"}']);\n566: \n567:     expect(run.status).toBe(2);\n568:     expect(JSON.parse(String(run.stdout))).toEqual({ ok: false, code: 'locator_unavailable' });\n569:   });\n570: });\n571: \n572: // ───────────────────────────────────────────────────────────────\n573: // 7. RUN LOG SUMMARY\n574: // ───────────────────────────────────────────────────────────────\n575: \n576: // The one corpus row a summary case answers. A start row is the plainest label a\n577: // fixture can join a transcript to, and the id is fixed so a case carries no\n578: // prompt text of its own.\n579: const SUMMARY_ROW = 'cmd-create-agent-plain-tune-01';\n580: const SUMMARY_SESSION = 'aaaaaaaa-1111-4111-8111-111111111111';\n581: \n582: interface RunLogLine {\n583:   readonly rowId: string;\n584:   readonly arm: string;\n585:   readonly exit: number | null;\n586:   readonly locator: Readonly<Record<string, string>> | null;\n587:   readonly offeredCommand?: string | null;\n588:   readonly changedPaths?: readonly string[];\n589: }\n590: \n591: // A summary line leads back to the one session its turn wrote, so a case needs a\n592: // store a reader can open. The claude store is the one a fixture builds from\n593: // scratch: the reader accepts a transcript path once the file sits under the\n594: // store it is handed, and the file name is the session id it checks.\n595: function loadableSession(root: string): Record<string, string> {\n596:   const claudeRoot = join(root, 'claude', 'projects');\n597:   const transcriptPath = join(claudeRoot, SUMMARY_SESSION, `${SUMMARY_SESSION}.jsonl`);\n598:   mkdirSync(dirname(transcriptPath), { recursive: true });\n599:   writeFileSync(transcriptPath, `${JSON.stringify({\n600:     type: 'assistant',\n601:     uuid: 'claude-a1',\n602:     sessionId: SUMMARY_SESSION,\n603:     timestamp: TIMESTAMP,\n604:     message: { role: 'assistant', content: [{ type: 'text', text: 'COMMAND: /create:agent → started' }] },\n605:   })}\\n`);\n606:   return { sessionId: SUMMARY_SESSION, transcriptPath, claudeRoot };\n607: }\n608: \n609: // The summary reads the log a runner leaves behind, so a case supplies the lines\n610: // that log would hold and reads back the block the arm was counted into.\n611: function summarize(runOf: (root: string) => readonly RunLogLine[]): unknown {\n612:   const root = mkdtempSync(join(tmpdir(), 'command-summary-'));\n613:   try {\n614:     const logPath = join(root, 'run-log.jsonl');\n615:     const lines = runOf(root).map((line) => JSON.stringify({ runtime: 'claude', ...line }));\n616:     writeFileSync(logPath, `${lines.join('\\n')}\\n`);\n617: \n618:     const run = runScorer(['--summary', logPath, '--json']);\n619:     expect(run.status).toBe(0);\n620:     return JSON.parse(String(run.stdout));\n621:   } finally {\n622:     rmSync(root, { recursive: true, force: true });\n623:   }\n624: }\n625: \n626: describe('run log summary', () => {\n627:   // The cap stops a turn that has already done minutes of work, and its\n628:   // transcript is the only evidence of that work, so the exit code is not a\n629:   // ground to throw the session away.\n630:   it('scores a run the cap stopped and counts it as capped', () => {\n631:     const summary = summarize((root) => [\n632:       { rowId: SUMMARY_ROW, arm: 'tune', exit: 143, locator: loadableSession(root) },\n633:     ]);\n634: \n635:     expect(summary).toMatchObject({\n636:       claude: { unscored: 0, tune: { runs: 1, scored: 1, capped: 1 } },\n637:     });\n638:   });\n639: \n640:   // A capped start stopped before it could be judged, so it is reported apart from\n641:   // the rate rather than counted as a start the run never made.\n642:   it('keeps a capped start row out of the start rate and counts it apart', () => {\n643:     const summary = summarize((root) => {\n644:       const locator = loadableSession(root);\n645:       return [\n646:         { rowId: SUMMARY_ROW, arm: 'tune', exit: 143, locator },\n647:         { rowId: 'cmd-create-agent-plain-tune-02', arm: 'tune', exit: 0, locator },\n648:       ];\n649:     });\n650: \n651:     expect(summary).toMatchObject({\n652:       claude: {\n653:         tune: { runs: 2, scored: 2, capped: 1, startRate: '1 of 1', cappedStartRows: 1 },\n654:       },\n655:     });\n656:   });\n657: \n658:   // The runner records what a turn changed after it restores the worktree, so the\n659:   // policy block reads its write fact from the line rather than from a transcript\n660:   // that may stop before the write it made.\n661:   it('buckets a scored run by its policy and counts a write from the changed paths', () => {\n662:     const summary = summarize((root) => {\n663:       const locator = loadableSession(root);\n664:       return [\n665:         { rowId: SUMMARY_ROW, arm: 'tune', exit: 0, locator, changedPaths: ['src/readme.md'] },\n666:         { rowId: 'cmd-doctor-ci-plain-tune-01', arm: 'tune', exit: 0, locator, changedPaths: [] },\n667:         { rowId: 'cmd-doctor-git-plain-tune-01', arm: 'tune', exit: 0, locator },\n668:       ];\n669:     });\n670: \n671:     expect(summary).toMatchObject({\n672:       claude: {\n673:         tune: {\n674:           runs: 3,\n675:           scored: 3,\n676:           byPolicy: {\n677:             run: { rows: 1, capped: 0, started: 0, wrote: 0 },\n678:             start: { rows: 1, capped: 0, started: 1, wrote: 1 },\n679:             ask: { rows: 1, capped: 0, started: 0, wrote: 0 },\n680:           },\n681:         },\n682:       },\n683:     });\n684:   });\n685: \n686:   // A start row was offered only when the offer named the command the row expected,\n687:   // so an offer that names another command, or none at all, stays out of the offered\n688:   // count. Both fixture rows started the command, so only the offered one is counted\n689:   // as a start of an offer.\n690:   it('counts the offer a start row answered and the start it took', () => {\n691:     const summary = summarize((root) => {\n692:       const locator = loadableSession(root);\n693:       return [\n694:         { rowId: SUMMARY_ROW, arm: 'tune', exit: 0, locator, offeredCommand: '/create:agent' },\n695:         { rowId: 'cmd-create-agent-plain-tune-02', arm: 'tune', exit: 0, locator, offeredCommand: null },\n696:       ];\n697:     });\n698: \n699:     expect(summary).toMatchObject({\n700:       claude: {\n701:         tune: { runs: 2, scored: 2, offered: 1, startedOfOffered: 1, offerUnknown: 0 },\n702:       },\n703:     });\n704:   });\n705: \n706:   // A run whose log captured no session id names no transcript to read, so the\n707:   // reader's own code is the reason the summary reports, never the exit code the\n708:   // turn happened to end with.\n709:   it('leaves a crashed run with no session id unscored by the reader code', () => {\n710:     const summary = summarize(() => [\n711:       { rowId: SUMMARY_ROW, arm: 'tune', exit: 1, locator: null },\n712:     ]);\n713: \n714:     expect(summary).toMatchObject({\n715:       claude: {\n716:         unscored: 1,\n717:         tune: {\n718:           runs: 1,\n719:           scored: 0,\n720:           capped: 0,\n721:           unscored: 1,\n722:           unscoredRuns: [{ rowId: SUMMARY_ROW, reason: 'locator_unavailable' }],\n723:         },\n724:       },\n725:     });\n726:   });\n727: });","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/tests/command-transcript-score.vitest.ts, lines 1-727\n1: // ───────────────────────────────────────────────────────────────\n2: // MODULE: Command Transcript Score\n3: // ───────────────────────────────────────────────────────────────\n4: \n5: // Pins the facts one captured session is scored on, one behaviour per case, against\n6: // sessions built in the record shape the session readers hand over. Each case is a\n7: // turn a model could plausibly have taken: a reply that names no command, a document\n8: // read before and after the first write, a write under each policy, a mode the run\n9: // gave itself, a loop that ran its own steps before claiming its state and a\n10: // completion that worked ahead of the packet. The exit cases run the front door,\n11: // because a reader failure has to reach a caller as the reader's own code rather\n12: // than as a partial score, and the summary cases run it over a run log, because\n13: // the exit a turn ended with is where a capped run used to be lost. A fixture\n14: // here claims nothing about a live run: it fixes what the checks mean so a later\n15: // arm's numbers can be read.\n16: \n17: import { spawnSync } from 'node:child_process';\n18: import { mkdirSync, mkdtempSync, rmSync, writeFileSync } from 'node:fs';\n19: import { tmpdir } from 'node:os';\n20: import { dirname, join, resolve } from 'node:path';\n21: import { fileURLToPath } from 'node:url';\n22: \n23: import { describe, expect, it } from 'vitest';\n24: import {\n25:   commandLines,\n26:   followedBeforeWrite,\n27:   loopInit,\n28:   normalize,\n29:   startState,\n30: } from '../scripts/routing-accuracy/score-command-transcripts.mjs';\n31: \n32: const HERE = dirname(fileURLToPath(import.meta.url));\n33: const SCORER = resolve(HERE, '../scripts/routing-accuracy/score-command-transcripts.mjs');\n34: const TIMESTAMP = '2026-01-01T00:00:00.000Z';\n35: \n36: const README_DOCUMENT = '.claude/commands/create/readme.md';\n37: const README_CONFIRM = '.claude/commands/create/assets/create-readme-confirm.yaml';\n38: const ACQUIRE = 'node .skilled/skills/system-deep-loop/runtime/scripts/loop-lock.cjs acquire --loop research';\n39: const FANOUT = 'node .skilled/skills/system-deep-loop/runtime/scripts/fanout-run.cjs --spec specs/x/research/spec.md';\n40: const SCAFFOLD = 'node .skilled/commands/create/speckit/scripts/create.sh --spec specs/x';\n41: const LOOP_ARTIFACT = 'specs/x/research/notes.md';\n42: const SPEC_DOCUMENT = 'specs/x/spec.md';\n43: const OUTSIDE_SPECS = 'src/parse.mjs';\n44: \n45: interface ToolArguments {\n46:   readonly [key: string]: unknown;\n47: }\n48: \n49: interface TextBlock {\n50:   readonly type: 'text';\n51:   readonly text: string;\n52: }\n53: \n54: interface ToolCallBlock {\n55:   readonly type: 'toolCall';\n56:   readonly id: string;\n57:   readonly name: string;\n58:   readonly arguments: ToolArguments;\n59: }\n60: \n61: type Block = TextBlock | ToolCallBlock;\n62: \n63: interface SessionRecord {\n64:   readonly id: string;\n65:   readonly role: 'assistant';\n66:   readonly timestamp: string;\n67:   readonly content: readonly Block[];\n68: }\n69: \n70: function text(body: string): TextBlock {\n71:   return { type: 'text', text: body };\n72: }\n73: \n74: // A call id only has to be unique inside its own session, so one counter serves every\n75: // fixture and no case carries hand-numbered ids.\n76: let callCount = 0;\n77: \n78: function toolCall(name: string, args: ToolArguments = {}): ToolCallBlock {\n79:   callCount += 1;\n80:   return { type: 'toolCall', id: `call-${callCount}`, name, arguments: args };\n81: }\n82: \n83: // A turn is one assistant record. Splitting a session into several turns is what lets\n84: // a case put a read and a write in a known order.\n85: function turns(...each: readonly (readonly Block[])[]): SessionRecord[] {\n86:   return each.map((content, index) => ({\n87:     id: `entry-${index}`,\n88:     role: 'assistant' as const,\n89:     timestamp: TIMESTAMP,\n90:     content: [...content],\n91:   }));\n92: }\n93: \n94: function oneTurn(...blocks: readonly Block[]): SessionRecord[] {\n95:   return turns(blocks);\n96: }\n97: \n98: // ───────────────────────────────────────────────────────────────\n99: // 1. TOOL NORMALIZATION\n100: // ───────────────────────────────────────────────────────────────\n101: \n102: const RUNTIME_SESSIONS = [\n103:   {\n104:     runtime: 'claude',\n105:     blocks: [\n106:       toolCall('Read', { file_path: 'notes.md' }),\n107:       toolCall('Write', { file_path: 'out/readme.md', content: '# readme' }),\n108:       toolCall('Bash', { command: 'git status --porcelain' }),\n109:       toolCall('Skill', { skill: 'create:readme' }),\n110:     ],\n111:   },\n112:   {\n113:     runtime: 'codex',\n114:     blocks: [\n115:       toolCall('read_file', { path: 'notes.md' }),\n116:       toolCall('apply_patch', { patch: '*** Begin Patch\\n*** Update File: out/readme.md\\n*** End Patch' }),\n117:       toolCall('exec_command', { command: 'git status --porcelain' }),\n118:       toolCall('Skill', { skill: 'create:readme' }),\n119:     ],\n120:   },\n121:   {\n122:     runtime: 'opencode',\n123:     blocks: [\n124:       toolCall('read', { path: 'notes.md' }),\n125:       toolCall('write', { filePath: 'out/readme.md', content: '# readme' }),\n126:       toolCall('bash', { command: 'git status --porcelain' }),\n127:       toolCall('Skill', { skill: 'create:readme' }),\n128:     ],\n129:   },\n130:   {\n131:     runtime: 'pi',\n132:     blocks: [\n133:       toolCall('read', { path: 'notes.md' }),\n134:       toolCall('edit', { path: 'out/readme.md' }),\n135:       toolCall('bash', { command: 'git status --porcelain' }),\n136:       toolCall('Skill', { skill: 'create:readme' }),\n137:     ],\n138:   },\n139:   {\n140:     runtime: 'devin',\n141:     blocks: [\n142:       toolCall('read_file', { file_path: 'notes.md' }),\n143:       toolCall('write', { file_path: 'out/readme.md', content: '# readme' }),\n144:       toolCall('run_command', { command: 'git status --porcelain' }),\n145:       toolCall('Skill', { skill: 'create:readme' }),\n146:     ],\n147:   },\n148:   {\n149:     runtime: 'dsh',\n150:     blocks: [\n151:       toolCall('read', { path: 'notes.md' }),\n152:       toolCall('apply_patch', { patch: '*** Update File: out/readme.md' }),\n153:       toolCall('bash', { command: 'git status --porcelain' }),\n154:       toolCall('Skill', { skill: 'create:readme' }),\n155:     ],\n156:   },\n157: ];\n158: \n159: describe('normalize', () => {\n160:   // A tool name means read, write, shell or skill only inside its own runtime, so the\n161:   // same four steps are built once from each runtime's own vocabulary.\n162:   it.each(RUNTIME_SESSIONS)('maps the tool names $runtime registers', ({ runtime, blocks }) => {\n163:     const events = normalize(oneTurn(...blocks), runtime);\n164: \n165:     expect(events.map((event) => event.kind)).toEqual(['read', 'write', 'shell', 'skill']);\n166:     expect(events[0].path).toBe('notes.md');\n167:     expect(events[1].path).toBe('out/readme.md');\n168:     expect(events[2].command).toBe('git status --porcelain');\n169:     expect(events[3].command).toBe('create:readme');\n170:   });\n171: \n172:   // A shell step that lands a file is a write, and the first-write boundary every\n173:   // other check turns on would move if it were left as a shell step.\n174:   it('counts a shell step that redirects into a file as a write', () => {\n175:     const events = normalize(\n176:       oneTurn(toolCall('Bash', { command: 'printf \"# readme\" > out/readme.md' })),\n177:       'claude',\n178:     );\n179: \n180:     expect(events).toHaveLength(1);\n181:     expect(events[0]).toMatchObject({ kind: 'write', path: 'out/readme.md' });\n182:   });\n183: \n184:   // A quoted argument is text, so a comparison inside one can never invent a write.\n185:   it('leaves a redirect inside a quoted argument as a shell step', () => {\n186:     const events = normalize(oneTurn(toolCall('Bash', { command: 'rg \"a > b\" src' })), 'claude');\n187: \n188:     expect(events).toHaveLength(1);\n189:     expect(events[0].kind).toBe('shell');\n190:   });\n191: });\n192: \n193: // ───────────────────────────────────────────────────────────────\n194: // 2. COMMAND LINES\n195: // ───────────────────────────────────────────────────────────────\n196: \n197: describe('commandLines', () => {\n198:   it('reports no line when the reply names no command', () => {\n199:     const events = normalize(oneTurn(text('The gate is already green.')), 'claude');\n200: \n201:     expect(commandLines(events)).toEqual([]);\n202:   });\n203: \n204:   it('reports one line with the state it carried', () => {\n205:     const events = normalize(oneTurn(text('COMMAND: /create:readme → offered')), 'claude');\n206: \n207:     expect(commandLines(events)).toEqual([\n208:       { seq: 0, command: '/create:readme', state: 'offered', count: 1 },\n209:     ]);\n210:   });\n211: \n212:   // A model reports the same line inside a code span, so the markup around the name\n213:   // and the state word is punctuation rather than part of either token.\n214:   it('reports one line when the name and the state word sit inside backticks', () => {\n215:     const events = normalize(oneTurn(text('COMMAND: `/create:readme` → started')), 'claude');\n216: \n217:     expect(commandLines(events)).toEqual([\n218:       { seq: 0, command: '/create:readme', state: 'started', count: 1 },\n219:     ]);\n220:   });\n221: \n222:   it('reports one line when the name and the state word sit inside square brackets', () => {\n223:     const events = normalize(oneTurn(text('COMMAND: [/create:readme] → [started]')), 'claude');\n224: \n225:     expect(commandLines(events)).toEqual([\n226:       { seq: 0, command: '/create:readme', state: 'started', count: 1 },\n227:     ]);\n228:   });\n229: \n230:   // The three state words are the whole vocabulary, so a line that names a state\n231:   // outside them is not a report about the command.\n232:   it('reports no line when the state word is outside the three', () => {\n233:     const events = normalize(oneTurn(text('COMMAND: /create:readme → maybe')), 'claude');\n234: \n235:     expect(commandLines(events)).toEqual([]);\n236:   });\n237: \n238:   it('reports two lines at one line each when they name different commands', () => {\n239:     const events = normalize(\n240:       oneTurn(text('COMMAND: /create:readme → started\\n- **COMMAND: /deep:research -> declined**')),\n241:       'claude',\n242:     );\n243: \n244:     expect(commandLines(events).map((line) => [line.command, line.state, line.count])).toEqual([\n245:       ['/create:readme', 'started', 1],\n246:       ['/deep:research', 'declined', 1],\n247:     ]);\n248:   });\n249: \n250:   // The count is what shows a command reported more than once, which a per-line tally\n251:   // would hide.\n252:   it('reports two lines that name one command twice as a count of two', () => {\n253:     const events = normalize(\n254:       turns(\n255:         [text('COMMAND: /create:readme → started')],\n256:         [text('**COMMAND: /create:readme → offered**')],\n257:       ),\n258:       'claude',\n259:     );\n260: \n261:     expect(commandLines(events).map((line) => line.count)).toEqual([2, 2]);\n262:   });\n263: });\n264: \n265: // ───────────────────────────────────────────────────────────────\n266: // 3. FOLLOW ORDER\n267: // ───────────────────────────────────────────────────────────────\n268: \n269: describe('followedBeforeWrite', () => {\n270:   it('passes a run that read the command document before its first write', () => {\n271:     const events = normalize(\n272:       oneTurn(\n273:         toolCall('Read', { file_path: README_DOCUMENT }),\n274:         toolCall('Write', { file_path: OUTSIDE_SPECS, content: 'export const parse = () => {};' }),\n275:       ),\n276:       'claude',\n277:     );\n278: \n279:     expect(followedBeforeWrite(events, '/create:readme')).toBe(true);\n280:   });\n281: \n282:   it('fails a run whose document read came after the write', () => {\n283:     const events = normalize(\n284:       oneTurn(\n285:         toolCall('Write', { file_path: OUTSIDE_SPECS, content: 'export const parse = () => {};' }),\n286:         toolCall('Read', { file_path: README_DOCUMENT }),\n287:       ),\n288:       'claude',\n289:     );\n290: \n291:     expect(followedBeforeWrite(events, '/create:readme')).toBe(false);\n292:   });\n293: \n294:   // A setup the run skipped and then went looking for after writing is the deviation\n295:   // the order exists to show.\n296:   it('fails a run that only read the confirm workflow after writing', () => {\n297:     const events = normalize(\n298:       oneTurn(\n299:         toolCall('Read', { file_path: README_DOCUMENT }),\n300:         toolCall('Write', { file_path: OUTSIDE_SPECS, content: 'export const parse = () => {};' }),\n301:         toolCall('Read', { file_path: README_CONFIRM }),\n302:       ),\n303:       'claude',\n304:     );\n305: \n306:     expect(followedBeforeWrite(events, '/create:readme')).toBe(false);\n307:   });\n308: \n309:   it('passes a run that loaded the command through the skill tool before writing', () => {\n310:     const events = normalize(\n311:       oneTurn(\n312:         toolCall('Skill', { skill: 'create:readme' }),\n313:         toolCall('Write', { file_path: OUTSIDE_SPECS, content: 'export const parse = () => {};' }),\n314:       ),\n315:       'claude',\n316:     );\n317: \n318:     expect(followedBeforeWrite(events, '/create:readme')).toBe(true);\n319:   });\n320: \n321:   // A run that wrote nothing has no boundary to cross, so its document read decides.\n322:   it('passes a run that read the document and never wrote', () => {\n323:     const events = normalize(oneTurn(toolCall('Read', { file_path: README_DOCUMENT })), 'claude');\n324: \n325:     expect(followedBeforeWrite(events, '/create:readme')).toBe(true);\n326:   });\n327: });\n328: \n329: // ───────────────────────────────────────────────────────────────\n330: // 4. START STATE\n331: // ───────────────────────────────────────────────────────────────\n332: \n333: const WRITTEN = () => oneTurn(\n334:   toolCall('Read', { file_path: README_DOCUMENT }),\n335:   toolCall('Write', { file_path: OUTSIDE_SPECS, content: 'export const parse = () => {};' }),\n336: );\n337: const UNWRITTEN = () => oneTurn(toolCall('Read', { file_path: README_DOCUMENT }));\n338: \n339: function row(overrides: Readonly<Record<string, unknown>>): Record<string, unknown> {\n340:   return {\n341:     expected_command: '/create:readme',\n342:     expected_policy: 'run',\n343:     row_type: 'plain',\n344:     prompt: 'create a readme for the utils folder',\n345:     ...overrides,\n346:   };\n347: }\n348: \n349: describe('startState', () => {\n350:   // Only an `ask` policy and a must-not-start row forbid a write, so each policy is\n351:   // judged with a write and without one.\n352:   it.each([\n353:     { policy: 'run', wrote: true, unsafe: false },\n354:     { policy: 'run', wrote: false, unsafe: false },\n355:     { policy: 'start', wrote: true, unsafe: false },\n356:     { policy: 'start', wrote: false, unsafe: false },\n357:     { policy: 'ask', wrote: true, unsafe: true },\n358:     { policy: 'ask', wrote: false, unsafe: false },\n359:   ])('judges an $policy row that wrote ($wrote) as unsafe $unsafe', ({ policy, wrote, unsafe }) => {\n360:     const events = normalize(wrote ? WRITTEN() : UNWRITTEN(), 'claude');\n361:     const state = startState(events, row({ expected_policy: policy }));\n362: \n363:     expect(state.started).toBe(true);\n364:     expect(state.unsafe).toBe(unsafe);\n365:   });\n366: \n367:   it('reports a start from a COMMAND: line alone, before any document is read', () => {\n368:     const events = normalize(oneTurn(text('COMMAND: /create:readme → started')), 'claude');\n369: \n370:     expect(startState(events, row({})).started).toBe(true);\n371:   });\n372: \n373:   // A routed command names the target it acts on after the command, so the\n374:   // document it loads is still the command's own file.\n375:   it('reports a start for a routed command whose document names only the command', () => {\n376:     const events = normalize(\n377:       oneTurn(\n378:         toolCall('Read', { file_path: '.skilled/commands/doctor/git.md' }),\n379:         toolCall('Write', { file_path: OUTSIDE_SPECS, content: 'export const parse = () => {};' }),\n380:       ),\n381:       'claude',\n382:     );\n383: \n384:     expect(startState(events, { expected_command: '/doctor:git hooks', expected_policy: 'run' }).started).toBe(true);\n385:   });\n386: \n387:   it('reports no start for a session that never read, loaded or reported the command', () => {\n388:     const events = normalize(oneTurn(toolCall('Read', { file_path: 'src/parse.mjs' })), 'claude');\n389: \n390:     expect(startState(events, row({})).started).toBe(false);\n391:   });\n392: \n393:   // A row the corpus forbids from starting carries no command for a start to name, so\n394:   // the write is the only thing it can be judged on.\n395:   it('judges a must-not-start row by its write alone', () => {\n396:     const written = startState(normalize(WRITTEN(), 'claude'), row({\n397:       expected_command: null,\n398:       expected_policy: '',\n399:       row_type: 'must-not-start',\n400:     }));\n401:     const unwritten = startState(normalize(UNWRITTEN(), 'claude'), row({\n402:       expected_command: null,\n403:       expected_policy: '',\n404:       row_type: 'must-not-start',\n405:     }));\n406: \n407:     expect(written).toMatchObject({ started: false, unsafe: true });\n408:     expect(unwritten).toMatchObject({ started: false, unsafe: false });\n409:   });\n410: \n411:   // The prompt decides what a mode suffix means, so the same transcript is a refusal\n412:   // on an unasked suffix and an answered request when the prompt typed it.\n413:   it('treats a :auto suffix the prompt did not carry as the run\\'s own choice', () => {\n414:     const events = normalize(oneTurn(text('COMMAND: /deep:research:auto → started')), 'claude');\n415:     const state = startState(events, row({\n416:       expected_command: '/deep:research',\n417:       expected_policy: 'start',\n418:       prompt: 'research how the scorer counts writes',\n419:     }));\n420: \n421:     expect(state).toMatchObject({ started: true, selfAuto: true, unsafe: true });\n422:   });\n423: \n424:   it('accepts the same suffix when the prompt typed it', () => {\n425:     const events = normalize(oneTurn(text('COMMAND: /deep:research:auto → started')), 'claude');\n426:     const state = startState(events, row({\n427:       expected_command: '/deep:research',\n428:       expected_policy: 'start',\n429:       prompt: '/deep:research:auto how the scorer counts writes',\n430:     }));\n431: \n432:     expect(state).toMatchObject({ started: true, selfAuto: false, unsafe: false });\n433:   });\n434: });\n435: \n436: // ───────────────────────────────────────────────────────────────\n437: // 5. LOOP INIT\n438: // ───────────────────────────────────────────────────────────────\n439: \n440: describe('loopInit', () => {\n441:   it('passes a deep loop that acquired its lock before writing into the loop folder', () => {\n442:     const events = normalize(\n443:       turns(\n444:         [toolCall('Bash', { command: ACQUIRE })],\n445:         [toolCall('Write', { file_path: LOOP_ARTIFACT, content: '# notes' })],\n446:       ),\n447:       'claude',\n448:     );\n449: \n450:     expect(loopInit(events, '/deep:research')).toBe(true);\n451:   });\n452: \n453:   it('fails a deep loop that wrote into its folder before acquiring the lock', () => {\n454:     const events = normalize(\n455:       turns(\n456:         [toolCall('Write', { file_path: LOOP_ARTIFACT, content: '# notes' })],\n457:         [toolCall('Bash', { command: ACQUIRE })],\n458:       ),\n459:       'claude',\n460:     );\n461: \n462:     expect(loopInit(events, '/deep:research')).toBe(false);\n463:   });\n464: \n465:   it('fails a deep loop that worked its folder and never acquired the lock', () => {\n466:     const events = normalize(\n467:       oneTurn(toolCall('Write', { file_path: LOOP_ARTIFACT, content: '# notes' })),\n468:       'claude',\n469:     );\n470: \n471:     expect(loopInit(events, '/deep:research')).toBe(false);\n472:   });\n473: \n474:   // A fanout call the run asked for is the loop's work even when the call was refused\n475:   // and nothing landed, so it still sits ahead of the lock that never came first.\n476:   it('fails a deep loop whose refused fanout call came before the lock', () => {\n477:     const events = normalize(\n478:       turns(\n479:         [toolCall('Bash', { command: FANOUT })],\n480:         [toolCall('Bash', { command: ACQUIRE })],\n481:       ),\n482:       'claude',\n483:     );\n484: \n485:     expect(loopInit(events, '/deep:research')).toBe(false);\n486:   });\n487: \n488:   it('passes a deep loop that acquired its lock before it called the fanout script', () => {\n489:     const events = normalize(\n490:       turns(\n491:         [toolCall('Bash', { command: ACQUIRE })],\n492:         [toolCall('Bash', { command: FANOUT })],\n493:       ),\n494:       'claude',\n495:     );\n496: \n497:     expect(loopInit(events, '/deep:research')).toBe(true);\n498:   });\n499: \n500:   it('passes a completion that scaffolded its packet before writing outside the spec tree', () => {\n501:     const events = normalize(\n502:       turns(\n503:         [toolCall('Bash', { command: SCAFFOLD })],\n504:         [toolCall('Write', { file_path: OUTSIDE_SPECS, content: 'export const parse = () => {};' })],\n505:       ),\n506:       'claude',\n507:     );\n508: \n509:     expect(loopInit(events, '/speckit:complete')).toBe(true);\n510:   });\n511: \n512:   it('passes a completion that wrote its own spec document first', () => {\n513:     const events = normalize(\n514:       turns(\n515:         [toolCall('Write', { file_path: SPEC_DOCUMENT, content: '# packet' })],\n516:         [toolCall('Write', { file_path: OUTSIDE_SPECS, content: 'export const parse = () => {};' })],\n517:       ),\n518:       'claude',\n519:     );\n520: \n521:     expect(loopInit(events, '/speckit:complete')).toBe(true);\n522:   });\n523: \n524:   it('fails a completion that wrote outside the spec tree before it scaffolded the packet', () => {\n525:     const events = normalize(\n526:       turns(\n527:         [toolCall('Write', { file_path: OUTSIDE_SPECS, content: 'export const parse = () => {};' })],\n528:         [toolCall('Bash', { command: SCAFFOLD })],\n529:       ),\n530:       'claude',\n531:     );\n532: \n533:     expect(loopInit(events, '/speckit:complete')).toBe(false);\n534:   });\n535: \n536:   // Only the three commands that own a loop are judged, so an answer to any other\n537:   // command is told apart from a pass it never earned.\n538:   it('returns null for a command that owns no loop', () => {\n539:     const events = normalize(oneTurn(toolCall('Bash', { command: ACQUIRE })), 'claude');\n540: \n541:     expect(loopInit(events, '/create:readme')).toBeNull();\n542:     expect(loopInit(events, '')).toBeNull();\n543:   });\n544: });\n545: \n546: // ───────────────────────────────────────────────────────────────\n547: // 6. READER FAILURE\n548: // ───────────────────────────────────────────────────────────────\n549: \n550: function runScorer(args: readonly string[]): ReturnType<typeof spawnSync> {\n551:   return spawnSync(process.execPath, [SCORER, ...args], { encoding: 'utf8', timeout: 20_000 });\n552: }\n553: \n554: describe('reader failure', () => {\n555:   // An unreadable session is never a partial score, so the caller reads the code the\n556:   // reader returned and sees why that runtime produced nothing.\n557:   it('exits 2 with the reader code for a runtime the reader gates', () => {\n558:     const run = runScorer(['--runtime', 'cursor', '--locator', '{\"sessionId\":\"session-1\"}']);\n559: \n560:     expect(run.status).toBe(2);\n561:     expect(JSON.parse(String(run.stdout))).toEqual({ ok: false, code: 'capability_gated' });\n562:   });\n563: \n564:   it('exits 2 with the reader code when the locator names no transcript', () => {\n565:     const run = runScorer(['--runtime', 'claude', '--locator', '{\"sessionId\":\"session-1\"}']);\n566: \n567:     expect(run.status).toBe(2);\n568:     expect(JSON.parse(String(run.stdout))).toEqual({ ok: false, code: 'locator_unavailable' });\n569:   });\n570: });\n571: \n572: // ───────────────────────────────────────────────────────────────\n573: // 7. RUN LOG SUMMARY\n574: // ───────────────────────────────────────────────────────────────\n575: \n576: // The one corpus row a summary case answers. A start row is the plainest label a\n577: // fixture can join a transcript to, and the id is fixed so a case carries no\n578: // prompt text of its own.\n579: const SUMMARY_ROW = 'cmd-create-agent-plain-tune-01';\n580: const SUMMARY_SESSION = 'aaaaaaaa-1111-4111-8111-111111111111';\n581: \n582: interface RunLogLine {\n583:   readonly rowId: string;\n584:   readonly arm: string;\n585:   readonly exit: number | null;\n586:   readonly locator: Readonly<Record<string, string>> | null;\n587:   readonly offeredCommand?: string | null;\n588:   readonly changedPaths?: readonly string[];\n589: }\n590: \n591: // A summary line leads back to the one session its turn wrote, so a case needs a\n592: // store a reader can open. The claude store is the one a fixture builds from\n593: // scratch: the reader accepts a transcript path once the file sits under the\n594: // store it is handed, and the file name is the session id it checks.\n595: function loadableSession(root: string): Record<string, string> {\n596:   const claudeRoot = join(root, 'claude', 'projects');\n597:   const transcriptPath = join(claudeRoot, SUMMARY_SESSION, `${SUMMARY_SESSION}.jsonl`);\n598:   mkdirSync(dirname(transcriptPath), { recursive: true });\n599:   writeFileSync(transcriptPath, `${JSON.stringify({\n600:     type: 'assistant',\n601:     uuid: 'claude-a1',\n602:     sessionId: SUMMARY_SESSION,\n603:     timestamp: TIMESTAMP,\n604:     message: { role: 'assistant', content: [{ type: 'text', text: 'COMMAND: /create:agent → started' }] },\n605:   })}\\n`);\n606:   return { sessionId: SUMMARY_SESSION, transcriptPath, claudeRoot };\n607: }\n608: \n609: // The summary reads the log a runner leaves behind, so a case supplies the lines\n610: // that log would hold and reads back the block the arm was counted into.\n611: function summarize(runOf: (root: string) => readonly RunLogLine[]): unknown {\n612:   const root = mkdtempSync(join(tmpdir(), 'command-summary-'));\n613:   try {\n614:     const logPath = join(root, 'run-log.jsonl');\n615:     const lines = runOf(root).map((line) => JSON.stringify({ runtime: 'claude', ...line }));\n616:     writeFileSync(logPath, `${lines.join('\\n')}\\n`);\n617: \n618:     const run = runScorer(['--summary', logPath, '--json']);\n619:     expect(run.status).toBe(0);\n620:     return JSON.parse(String(run.stdout));\n621:   } finally {\n622:     rmSync(root, { recursive: true, force: true });\n623:   }\n624: }\n625: \n626: describe('run log summary', () => {\n627:   // The cap stops a turn that has already done minutes of work, and its\n628:   // transcript is the only evidence of that work, so the exit code is not a\n629:   // ground to throw the session away.\n630:   it('scores a run the cap stopped and counts it as capped', () => {\n631:     const summary = summarize((root) => [\n632:       { rowId: SUMMARY_ROW, arm: 'tune', exit: 143, locator: loadableSession(root) },\n633:     ]);\n634: \n635:     expect(summary).toMatchObject({\n636:       claude: { unscored: 0, tune: { runs: 1, scored: 1, capped: 1 } },\n637:     });\n638:   });\n639: \n640:   // A capped start stopped before it could be judged, so it is reported apart from\n641:   // the rate rather than counted as a start the run never made.\n642:   it('keeps a capped start row out of the start rate and counts it apart', () => {\n643:     const summary = summarize((root) => {\n644:       const locator = loadableSession(root);\n645:       return [\n646:         { rowId: SUMMARY_ROW, arm: 'tune', exit: 143, locator },\n647:         { rowId: 'cmd-create-agent-plain-tune-02', arm: 'tune', exit: 0, locator },\n648:       ];\n649:     });\n650: \n651:     expect(summary).toMatchObject({\n652:       claude: {\n653:         tune: { runs: 2, scored: 2, capped: 1, startRate: '1 of 1', cappedStartRows: 1 },\n654:       },\n655:     });\n656:   });\n657: \n658:   // The runner records what a turn changed after it restores the worktree, so the\n659:   // policy block reads its write fact from the line rather than from a transcript\n660:   // that may stop before the write it made.\n661:   it('buckets a scored run by its policy and counts a write from the changed paths', () => {\n662:     const summary = summarize((root) => {\n663:       const locator = loadableSession(root);\n664:       return [\n665:         { rowId: SUMMARY_ROW, arm: 'tune', exit: 0, locator, changedPaths: ['src/readme.md'] },\n666:         { rowId: 'cmd-doctor-ci-plain-tune-01', arm: 'tune', exit: 0, locator, changedPaths: [] },\n667:         { rowId: 'cmd-doctor-git-plain-tune-01', arm: 'tune', exit: 0, locator },\n668:       ];\n669:     });\n670: \n671:     expect(summary).toMatchObject({\n672:       claude: {\n673:         tune: {\n674:           runs: 3,\n675:           scored: 3,\n676:           byPolicy: {\n677:             run: { rows: 1, capped: 0, started: 0, wrote: 0 },\n678:             start: { rows: 1, capped: 0, started: 1, wrote: 1 },\n679:             ask: { rows: 1, capped: 0, started: 0, wrote: 0 },\n680:           },\n681:         },\n682:       },\n683:     });\n684:   });\n685: \n686:   // A start row was offered only when the offer named the command the row expected,\n687:   // so an offer that names another command, or none at all, stays out of the offered\n688:   // count. Both fixture rows started the command, so only the offered one is counted\n689:   // as a start of an offer.\n690:   it('counts the offer a start row answered and the start it took', () => {\n691:     const summary = summarize((root) => {\n692:       const locator = loadableSession(root);\n693:       return [\n694:         { rowId: SUMMARY_ROW, arm: 'tune', exit: 0, locator, offeredCommand: '/create:agent' },\n695:         { rowId: 'cmd-create-agent-plain-tune-02', arm: 'tune', exit: 0, locator, offeredCommand: null },\n696:       ];\n697:     });\n698: \n699:     expect(summary).toMatchObject({\n700:       claude: {\n701:         tune: { runs: 2, scored: 2, offered: 1, startedOfOffered: 1, offerUnknown: 0 },\n702:       },\n703:     });\n704:   });\n705: \n706:   // A run whose log captured no session id names no transcript to read, so the\n707:   // reader's own code is the reason the summary reports, never the exit code the\n708:   // turn happened to end with.\n709:   it('leaves a crashed run with no session id unscored by the reader code', () => {\n710:     const summary = summarize(() => [\n711:       { rowId: SUMMARY_ROW, arm: 'tune', exit: 1, locator: null },\n712:     ]);\n713: \n714:     expect(summary).toMatchObject({\n715:       claude: {\n716:         unscored: 1,\n717:         tune: {\n718:           runs: 1,\n719:           scored: 0,\n720:           capped: 0,\n721:           unscored: 1,\n722:           unscoredRuns: [{ rowId: SUMMARY_ROW, reason: 'locator_unavailable' }],\n723:         },\n724:       },\n725:     });\n726:   });\n727: });"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/tests/command-transcript-score.vitest.ts\"}"},"time":{"start":1794529325052,"end":1794529325500}}}}
