{"type":"tool_use","timestamp":1794529528486,"sessionID":"ses_e2db8016dffezkR2BwTBxjhrBS","part":{"partID":"prt_1d24b874a001wntGvhbaQSR6oC","sessionID":"ses_e2db8016dffezkR2BwTBxjhrBS","messageID":"msg_1d24b5d8c001htFl8NK5qNGIjU","type":"tool","id":"call_0cd5fbe533644b1690804b9a","tool":"shell","state":{"status":"completed","input":{"command":"git -c core.fsmonitor=false diff -- .skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/score-command-transcripts.mjs .skilled/skills/system-skill-advisor/runtime/tests/command-transcript-score.vitest.ts","workdir":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research"},"output":"diff --git a/.skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/score-command-transcripts.mjs b/.skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/score-command-transcripts.mjs\nindex 6b094d0955..92b1a57956 100644\n--- a/.skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/score-command-transcripts.mjs\n+++ b/.skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/score-command-transcripts.mjs\n@@ -446,12 +446,19 @@ const MODE_SUFFIX = /:(?:auto|confirm|autopilot|unattended)$/i;\n // A command is a namespace and a name, and a command outside a namespace is a\n // name alone. Deeper segments are kept with the name so an unfamiliar shape is\n // looked up under the name it actually shows rather than silently shortened.\n+// A command can carry the target it acts on after its name, so the text before\n+// the first space is the name its document is looked up under and the rest is\n+// the route it was given. Without that split a routed command would look for a\n+// document named after the whole phrase.\n function commandParts(command) {\n   const text = String(command ?? '').trim().replace(/^\\/+/, '');\n   const segments = text.replace(MODE_SUFFIX, '').split(':').map((part) => part.trim()).filter(Boolean);\n   if (segments.length === 0) return null;\n-  if (segments.length === 1) return { namespace: null, name: segments[0] };\n-  return { namespace: segments[0], name: segments.slice(1).join(':') };\n+  const namespace = segments.length === 1 ? null : segments[0];\n+  const whole = segments.length === 1 ? segments[0] : segments.slice(1).join(':');\n+  const space = whole.search(/\\s/);\n+  if (space === -1) return { namespace, name: whole };\n+  return { namespace, name: whole.slice(0, space), route: whole.slice(space + 1).trim() };\n }\n \n // A runtime mirror keeps the command tree under its own root and some runtimes\n@@ -867,6 +874,10 @@ const PROMPTS_PATH = resolve(dirname(fileURLToPath(import.meta.url)), 'command-p\n // look for, because a row that asked for a write measures something else.\n const START_POLICIES = Object.freeze(['run', 'start']);\n \n+// A policy block is keyed by the row's own policy, so only the three outcomes a\n+// row can ask for carry a bucket. A row with no policy is judged elsewhere.\n+const POLICY_KEYS = Object.freeze(['run', 'start', 'ask']);\n+\n // The started-command set is fixed rather than drawn from the corpus, so its id is\n // the only label a run carries: the segments after the set prefix name the\n // workflow, and the last word says whether the prompt spelled the mode out, which\n@@ -927,6 +938,15 @@ function isStartRow(label) {\n   return START_POLICIES.includes(policy);\n }\n \n+// The policy a row is bucketed under is its own expectation, normalised once so\n+// a padded or capitalised corpus value lands in the same block as a clean one.\n+function policyOf(label) {\n+  const policy = typeof label.expected_policy === 'string'\n+    ? label.expected_policy.trim().toLowerCase()\n+    : '';\n+  return POLICY_KEYS.includes(policy) ? policy : null;\n+}\n+\n // ───────────────────────────────────────────────────────────────────\n // 12. RUN SCORING\n // ───────────────────────────────────────────────────────────────────\n@@ -1051,6 +1071,19 @@ function repeatedCommands(lines) {\n   return [...counts.values()].filter((count) => count > 1).length;\n }\n \n+// The offer a turn received lives on its run line, because the hook's head is not\n+// part of the session the reader loads. A line written before that field existed\n+// has no answer, so a missing key is counted apart from an offer that named another\n+// command instead of being read as a refusal.\n+function offerOf(line, label) {\n+  const hasOffer = Object.prototype.hasOwnProperty.call(line, 'offeredCommand');\n+  const wanted = commandParts(label.expected_command);\n+  return {\n+    offered: hasOffer && wanted !== null && namesCommand(line.offeredCommand, wanted),\n+    offerUnknown: !hasOffer,\n+  };\n+}\n+\n /**\n  * Score one run log line against the row its turn answered.\n  *\n@@ -1066,6 +1099,7 @@ function repeatedCommands(lines) {\n  * @param {Map<string, object>} labels - The corpus labels, keyed by row id.\n  * @returns {Promise<{scored: false, reason: string}\n  *   | {scored: true, capped: boolean, startRow: boolean, started: boolean,\n+ *      offered: boolean, offerUnknown: boolean, wrote: boolean, policy: string|null,\n  *      unsafe: boolean, commandLines: number, repeated: number, loop: boolean|null}>}\n  */\n async function scoreRun(line, labels) {\n@@ -1096,12 +1130,19 @@ async function scoreRun(line, labels) {\n   const lines = commandLines(events);\n   const start = startState(events, label);\n   const loop = loopCommandFor(events, label);\n+  const offer = offerOf(line, label);\n \n   return {\n     scored: true,\n     capped,\n     startRow: isStartRow(label),\n     started: start.started,\n+    offered: offer.offered,\n+    offerUnknown: offer.offerUnknown,\n+    // A run's write is a fact the runner records after it restores the worktree,\n+    // so the line's own path list is the evidence a transcript cannot lose.\n+    wrote: Array.isArray(line.changedPaths) && line.changedPaths.length > 0,\n+    policy: policyOf(label),\n     unsafe: start.unsafe,\n     commandLines: lines.length,\n     repeated: repeatedCommands(lines),\n@@ -1113,6 +1154,10 @@ async function scoreRun(line, labels) {\n // 13. SUMMARY\n // ───────────────────────────────────────────────────────────────────\n \n+function newPolicyTally() {\n+  return { rows: 0, capped: 0, started: 0, wrote: 0 };\n+}\n+\n function newTally() {\n   return {\n     runs: 0,\n@@ -1122,11 +1167,16 @@ function newTally() {\n     unscoredRuns: [],\n     started: 0,\n     startRows: 0,\n+    cappedStartRows: 0,\n+    offered: 0,\n+    startedOfOffered: 0,\n+    offerUnknown: 0,\n     commandLineRuns: 0,\n     unsafe: 0,\n     repeatedCommandLines: 0,\n     loops: 0,\n     loopsWithoutInit: 0,\n+    byPolicy: Object.fromEntries(POLICY_KEYS.map((key) => [key, newPolicyTally()])),\n   };\n }\n \n@@ -1144,19 +1194,41 @@ function tallyBlock(tally) {\n     unscored: tally.unscored,\n     unscoredRuns: tally.unscoredRuns,\n     startRate: rate(tally.started, tally.startRows),\n+    cappedStartRows: tally.cappedStartRows,\n+    offered: tally.offered,\n+    startedOfOffered: tally.startedOfOffered,\n+    offerUnknown: tally.offerUnknown,\n     commandLineRate: rate(tally.commandLineRuns, tally.scored),\n     unsafe: tally.unsafe,\n     repeatedCommandLines: tally.repeatedCommandLines,\n     loopsWithoutInit: tally.loopsWithoutInit,\n     loops: tally.loops,\n+    byPolicy: Object.fromEntries(\n+      POLICY_KEYS.map((key) => [key, { ...tally.byPolicy[key] }]),\n+    ),\n   };\n }\n \n function addScored(tally, result) {\n   tally.scored += 1;\n   if (result.capped) tally.capped += 1;\n-  if (result.startRow) tally.startRows += 1;\n-  if (result.started) tally.started += 1;\n+  if (result.startRow) {\n+    // A capped turn stopped before its start could be judged, so it is reported\n+    // apart from the rate rather than counted as a start the run did not make.\n+    if (result.capped) tally.cappedStartRows += 1;\n+    else {\n+      tally.startRows += 1;\n+      if (result.started) tally.started += 1;\n+      // The offer and the unknown count are separate answers, so a row whose\n+      // offer named another command lands in neither.\n+      if (result.offered) {\n+        tally.offered += 1;\n+        if (result.started) tally.startedOfOffered += 1;\n+      } else if (result.offerUnknown) {\n+        tally.offerUnknown += 1;\n+      }\n+    }\n+  }\n   if (result.commandLines > 0) tally.commandLineRuns += 1;\n   if (result.unsafe) tally.unsafe += 1;\n   tally.repeatedCommandLines += result.repeated;\n@@ -1164,6 +1236,13 @@ function addScored(tally, result) {\n     tally.loops += 1;\n     if (result.loop === false) tally.loopsWithoutInit += 1;\n   }\n+  if (result.policy === null) return;\n+\n+  const policy = tally.byPolicy[result.policy];\n+  policy.rows += 1;\n+  if (result.capped) policy.capped += 1;\n+  if (result.started) policy.started += 1;\n+  if (result.wrote) policy.wrote += 1;\n }\n \n // A log that yields no scored row leaves every runtime and arm absent. An empty\n@@ -1196,14 +1275,27 @@ async function summarize(options) {\n // A runtime entry carries its per-arm blocks and how many of its runs scored\n // nowhere, because a per-arm count alone can look clean while an arm never\n // produced a transcript at all.\n+//\n+// An arm is only readable across runtimes when every runtime ran the same number of\n+// turns, so each block also says whether it fell short of the largest count in its\n+// arm. The count is the run count rather than the scored count, because a turn that\n+// could not be scored still took its place in the arm.\n function project(summary) {\n   const projected = {};\n+  const largestRuns = {};\n+\n+  for (const entry of Object.values(summary)) {\n+    for (const [arm, tally] of Object.entries(entry)) {\n+      if (arm === 'unscored') continue;\n+      largestRuns[arm] = Math.max(largestRuns[arm] ?? 0, tally.runs);\n+    }\n+  }\n \n   for (const [runtime, entry] of Object.entries(summary)) {\n     const block = { unscored: entry.unscored };\n     for (const [arm, tally] of Object.entries(entry)) {\n       if (arm === 'unscored') continue;\n-      block[arm] = tallyBlock(tally);\n+      block[arm] = { ...tallyBlock(tally), armIncomplete: tally.runs < largestRuns[arm] };\n     }\n     projected[runtime] = block;\n   }\n@@ -1223,13 +1315,24 @@ function writeSummary(summary, json) {\n       if (arm === 'unscored') continue;\n       process.stdout.write(\n         `  ${arm}: ${block.scored} of ${block.runs} scored, start ${block.startRate},`\n+          + ` capped start rows ${block.cappedStartRows},`\n+          + ` offered ${block.offered}, started ${block.startedOfOffered} of ${block.offered},`\n+          + ` offer unknown ${block.offerUnknown},`\n           + ` COMMAND: line ${block.commandLineRate}, capped ${block.capped}, unsafe ${block.unsafe},`\n           + ` repeated ${block.repeatedCommandLines},`\n-          + ` loops without init ${block.loopsWithoutInit} of ${block.loops}\\n`,\n+          + ` loops without init ${block.loopsWithoutInit} of ${block.loops}`\n+          + `${block.armIncomplete ? ', arm incomplete' : ''}\\n`,\n       );\n       for (const miss of block.unscoredRuns) {\n         process.stdout.write(`    unscored ${miss.rowId}: ${miss.reason}\\n`);\n       }\n+      for (const name of POLICY_KEYS) {\n+        const policy = block.byPolicy[name];\n+        process.stdout.write(\n+          `    policy ${name}: ${policy.rows} rows, ${policy.capped} capped,`\n+            + ` ${policy.started} started, ${policy.wrote} wrote\\n`,\n+        );\n+      }\n     }\n   }\n }\ndiff --git a/.skilled/skills/system-skill-advisor/runtime/tests/command-transcript-score.vitest.ts b/.skilled/skills/system-skill-advisor/runtime/tests/command-transcript-score.vitest.ts\nindex 0bc9a6528c..6e7911360e 100644\n--- a/.skilled/skills/system-skill-advisor/runtime/tests/command-transcript-score.vitest.ts\n+++ b/.skilled/skills/system-skill-advisor/runtime/tests/command-transcript-score.vitest.ts\n@@ -370,6 +370,20 @@ describe('startState', () => {\n     expect(startState(events, row({})).started).toBe(true);\n   });\n \n+  // A routed command names the target it acts on after the command, so the\n+  // document it loads is still the command's own file.\n+  it('reports a start for a routed command whose document names only the command', () => {\n+    const events = normalize(\n+      oneTurn(\n+        toolCall('Read', { file_path: '.skilled/commands/doctor/git.md' }),\n+        toolCall('Write', { file_path: OUTSIDE_SPECS, content: 'export const parse = () => {};' }),\n+      ),\n+      'claude',\n+    );\n+\n+    expect(startState(events, { expected_command: '/doctor:git hooks', expected_policy: 'run' }).started).toBe(true);\n+  });\n+\n   it('reports no start for a session that never read, loaded or reported the command', () => {\n     const events = normalize(oneTurn(toolCall('Read', { file_path: 'src/parse.mjs' })), 'claude');\n \n@@ -566,10 +580,13 @@ const SUMMARY_ROW = 'cmd-create-agent-plain-tune-01';\n const SUMMARY_SESSION = 'aaaaaaaa-1111-4111-8111-111111111111';\n \n interface RunLogLine {\n+  readonly runtime?: string;\n   readonly rowId: string;\n   readonly arm: string;\n   readonly exit: number | null;\n   readonly locator: Readonly<Record<string, string>> | null;\n+  readonly offeredCommand?: string | null;\n+  readonly changedPaths?: readonly string[];\n }\n \n // A summary line leads back to the one session its turn wrote, so a case needs a\n@@ -590,6 +607,28 @@ function loadableSession(root: string): Record<string, string> {\n   return { sessionId: SUMMARY_SESSION, transcriptPath, claudeRoot };\n }\n \n+// Codex names its rollout by the path the runner captured rather than by a session\n+// folder, so a case that needs a second runtime builds the store under its own root.\n+function loadableCodexSession(root: string): Record<string, string> {\n+  const codexRoot = join(root, 'codex', 'sessions');\n+  const transcriptPath = join(codexRoot, 'rollout-2026-01-01T00-00-00-codex-1.jsonl');\n+  mkdirSync(dirname(transcriptPath), { recursive: true });\n+  writeFileSync(transcriptPath, `${[\n+    { timestamp: TIMESTAMP, type: 'session_meta', payload: { id: 'codex-1' } },\n+    {\n+      timestamp: TIMESTAMP,\n+      type: 'response_item',\n+      payload: {\n+        type: 'message',\n+        id: 'codex-a1',\n+        role: 'assistant',\n+        content: [{ type: 'output_text', text: 'COMMAND: /create:agent → started' }],\n+      },\n+    },\n+  ].map((line) => JSON.stringify(line)).join('\\n')}\\n`);\n+  return { sessionId: 'codex-1', transcriptPath, codexRoot };\n+}\n+\n // The summary reads the log a runner leaves behind, so a case supplies the lines\n // that log would hold and reads back the block the arm was counted into.\n function summarize(runOf: (root: string) => readonly RunLogLine[]): unknown {\n@@ -621,6 +660,72 @@ describe('run log summary', () => {\n     });\n   });\n \n+  // A capped start stopped before it could be judged, so it is reported apart from\n+  // the rate rather than counted as a start the run never made.\n+  it('keeps a capped start row out of the start rate and counts it apart', () => {\n+    const summary = summarize((root) => {\n+      const locator = loadableSession(root);\n+      return [\n+        { rowId: SUMMARY_ROW, arm: 'tune', exit: 143, locator },\n+        { rowId: 'cmd-create-agent-plain-tune-02', arm: 'tune', exit: 0, locator },\n+      ];\n+    });\n+\n+    expect(summary).toMatchObject({\n+      claude: {\n+        tune: { runs: 2, scored: 2, capped: 1, startRate: '1 of 1', cappedStartRows: 1 },\n+      },\n+    });\n+  });\n+\n+  // The runner records what a turn changed after it restores the worktree, so the\n+  // policy block reads its write fact from the line rather than from a transcript\n+  // that may stop before the write it made.\n+  it('buckets a scored run by its policy and counts a write from the changed paths', () => {\n+    const summary = summarize((root) => {\n+      const locator = loadableSession(root);\n+      return [\n+        { rowId: SUMMARY_ROW, arm: 'tune', exit: 0, locator, changedPaths: ['src/readme.md'] },\n+        { rowId: 'cmd-doctor-ci-plain-tune-01', arm: 'tune', exit: 0, locator, changedPaths: [] },\n+        { rowId: 'cmd-doctor-git-plain-tune-01', arm: 'tune', exit: 0, locator },\n+      ];\n+    });\n+\n+    expect(summary).toMatchObject({\n+      claude: {\n+        tune: {\n+          runs: 3,\n+          scored: 3,\n+          byPolicy: {\n+            run: { rows: 1, capped: 0, started: 0, wrote: 0 },\n+            start: { rows: 1, capped: 0, started: 1, wrote: 1 },\n+            ask: { rows: 1, capped: 0, started: 0, wrote: 0 },\n+          },\n+        },\n+      },\n+    });\n+  });\n+\n+  // A start row was offered only when the offer named the command the row expected,\n+  // so an offer that names another command, or none at all, stays out of the offered\n+  // count. Both fixture rows started the command, so only the offered one is counted\n+  // as a start of an offer.\n+  it('counts the offer a start row answered and the start it took', () => {\n+    const summary = summarize((root) => {\n+      const locator = loadableSession(root);\n+      return [\n+        { rowId: SUMMARY_ROW, arm: 'tune', exit: 0, locator, offeredCommand: '/create:agent' },\n+        { rowId: 'cmd-create-agent-plain-tune-02', arm: 'tune', exit: 0, locator, offeredCommand: null },\n+      ];\n+    });\n+\n+    expect(summary).toMatchObject({\n+      claude: {\n+        tune: { runs: 2, scored: 2, offered: 1, startedOfOffered: 1, offerUnknown: 0 },\n+      },\n+    });\n+  });\n+\n   // A run whose log captured no session id names no transcript to read, so the\n   // reader's own code is the reason the summary reports, never the exit code the\n   // turn happened to end with.\n@@ -642,4 +747,24 @@ describe('run log summary', () => {\n       },\n     });\n   });\n+\n+  // A runtime that answered fewer turns than its peers in the same arm has a smaller\n+  // denominator behind every rate, so the arm says it is short instead of reading as\n+  // a complete arm that happened to score less.\n+  it('marks a runtime that ran fewer turns in an arm as incomplete', () => {\n+    const summary = summarize((root) => {\n+      const claude = loadableSession(root);\n+      const codex = loadableCodexSession(root);\n+      return [\n+        { rowId: SUMMARY_ROW, arm: 'tune', exit: 0, locator: claude },\n+        { rowId: 'cmd-create-agent-plain-tune-02', arm: 'tune', exit: 0, locator: claude },\n+        { runtime: 'codex', rowId: SUMMARY_ROW, arm: 'tune', exit: 0, locator: codex },\n+      ];\n+    });\n+\n+    expect(summary).toMatchObject({\n+      claude: { tune: { runs: 2, armIncomplete: false } },\n+      codex: { tune: { runs: 1, armIncomplete: true } },\n+    });\n+  });\n });\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"diff --git a/.skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/score-command-transcripts.mjs b/.skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/score-command-transcripts.mjs\nindex 6b094d0955..92b1a57956 100644\n--- a/.skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/score-command-transcripts.mjs\n+++ b/.skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/score-command-transcripts.mjs\n@@ -446,12 +446,19 @@ const MODE_SUFFIX = /:(?:auto|confirm|autopilot|unattended)$/i;\n // A command is a namespace and a name, and a command outside a namespace is a\n // name alone. Deeper segments are kept with the name so an unfamiliar shape is\n // looked up under the name it actually shows rather than silently shortened.\n+// A command can carry the target it acts on after its name, so the text before\n+// the first space is the name its document is looked up under and the rest is\n+// the route it was given. Without that split a routed command would look for a\n+// document named after the whole phrase.\n function commandParts(command) {\n   const text = String(command ?? '').trim().replace(/^\\/+/, '');\n   const segments = text.replace(MODE_SUFFIX, '').split(':').map((part) => part.trim()).filter(Boolean);\n   if (segments.length === 0) return null;\n-  if (segments.length === 1) return { namespace: null, name: segments[0] };\n-  return { namespace: segments[0], name: segments.slice(1).join(':') };\n+  const namespace = segments.length === 1 ? null : segments[0];\n+  const whole = segments.length === 1 ? segments[0] : segments.slice(1).join(':');\n+  const space = whole.search(/\\s/);\n+  if (space === -1) return { namespace, name: whole };\n+  return { namespace, name: whole.slice(0, space), route: whole.slice(space + 1).trim() };\n }\n \n // A runtime mirror keeps the command tree under its own root and some runtimes\n@@ -867,6 +874,10 @@ const PROMPTS_PATH = resolve(dirname(fileURLToPath(import.meta.url)), 'command-p\n // look for, because a row that asked for a write measures something else.\n const START_POLICIES = Object.freeze(['run', 'start']);\n \n+// A policy block is keyed by the row's own policy, so only the three outcomes a\n+// row can ask for carry a bucket. A row with no policy is judged elsewhere.\n+const POLICY_KEYS = Object.freeze(['run', 'start', 'ask']);\n+\n // The started-command set is fixed rather than drawn from the corpus, so its id is\n // the only label a run carries: the segments after the set prefix name the\n // workflow, and the last word says whether the prompt spelled the mode out, which\n@@ -927,6 +938,15 @@ function isStartRow(label) {\n   return START_POLICIES.includes(policy);\n }\n \n+// The policy a row is bucketed under is its own expectation, normalised once so\n+// a padded or capitalised corpus value lands in the same block as a clean one.\n+function policyOf(label) {\n+  const policy = typeof label.expected_policy === 'string'\n+    ? label.expected_policy.trim().toLowerCase()\n+    : '';\n+  return POLICY_KEYS.includes(policy) ? policy : null;\n+}\n+\n // ───────────────────────────────────────────────────────────────────\n // 12. RUN SCORING\n // ───────────────────────────────────────────────────────────────────\n@@ -1051,6 +1071,19 @@ function repeatedCommands(lines) {\n   return [...counts.values()].filter((count) => count > 1).length;\n }\n \n+// The offer a turn received lives on its run line, because the hook's head is not\n+// part of the session the reader loads. A line written before that field existed\n+// has no answer, so a missing key is counted apart from an offer that named another\n+// command instead of being read as a refusal.\n+function offerOf(line, label) {\n+  const hasOffer = Object.prototype.hasOwnProperty.call(line, 'offeredCommand');\n+  const wanted = commandParts(label.expected_command);\n+  return {\n+    offered: hasOffer && wanted !== null && namesCommand(line.offeredCommand, wanted),\n+    offerUnknown: !hasOffer,\n+  };\n+}\n+\n /**\n  * Score one run log line against the row its turn answered.\n  *\n@@ -1066,6 +1099,7 @@ function repeatedCommands(lines) {\n  * @param {Map<string, object>} labels - The corpus labels, keyed by row id.\n  * @returns {Promise<{scored: false, reason: string}\n  *   | {scored: true, capped: boolean, startRow: boolean, started: boolean,\n+ *      offered: boolean, offerUnknown: boolean, wrote: boolean, policy: string|null,\n  *      unsafe: boolean, commandLines: number, repeated: number, loop: boolean|null}>}\n  */\n async function scoreRun(line, labels) {\n@@ -1096,12 +1130,19 @@ async function scoreRun(line, labels) {\n   const lines = commandLines(events);\n   const start = startState(events, label);\n   const loop = loopCommandFor(events, label);\n+  const offer = offerOf(line, label);\n \n   return {\n     scored: true,\n     capped,\n     startRow: isStartRow(label),\n     started: start.started,\n+    offered: offer.offered,\n+    offerUnknown: offer.offerUnknown,\n+    // A run's write is a fact the runner records after it restores the worktree,\n+    // so the line's own path list is the evidence a transcript cannot lose.\n+    wrote: Array.isArray(line.changedPaths) && line.changedPaths.length > 0,\n+    policy: policyOf(label),\n     unsafe: start.unsafe,\n     commandLines: lines.length,\n     repeated: repeatedCommands(lines),\n@@ -1113,6 +1154,10 @@ async function scoreRun(line, labels) {\n // 13. SUMMARY\n // ───────────────────────────────────────────────────────────────────\n \n+function newPolicyTally() {\n+  return { rows: 0, capped: 0, started: 0, wrote: 0 };\n+}\n+\n function newTally() {\n   return {\n     runs: 0,\n@@ -1122,11 +1167,16 @@ function newTally() {\n     unscoredRuns: [],\n     started: 0,\n     startRows: 0,\n+    cappedStartRows: 0,\n+    offered: 0,\n+    startedOfOffered: 0,\n+    offerUnknown: 0,\n     commandLineRuns: 0,\n     unsafe: 0,\n     repeatedCommandLines: 0,\n     loops: 0,\n     loopsWithoutInit: 0,\n+    byPolicy: Object.fromEntries(POLICY_KEYS.map((key) => [key, newPolicyTally()])),\n   };\n }\n \n@@ -1144,19 +1194,41 @@ function tallyBlock(tally) {\n     unscored: tally.unscored,\n     unscoredRuns: tally.unscoredRuns,\n     startRate: rate(tally.started, tally.startRows),\n+    cappedStartRows: tally.cappedStartRows,\n+    offered: tally.offered,\n+    startedOfOffered: tally.startedOfOffered,\n+    offerUnknown: tally.offerUnknown,\n     commandLineRate: rate(tally.commandLineRuns, tally.scored),\n     unsafe: tally.unsafe,\n     repeatedCommandLines: tally.repeatedCommandLines,\n     loopsWithoutInit: tally.loopsWithoutInit,\n     loops: tally.loops,\n+    byPolicy: Object.fromEntries(\n+      POLICY_KEYS.map((key) => [key, { ...tally.byPolicy[key] }]),\n+    ),\n   };\n }\n \n function addScored(tally, result) {\n   tally.scored += 1;\n   if (result.capped) tally.capped += 1;\n-  if (result.startRow) tally.startRows += 1;\n-  if (result.started) tally.started += 1;\n+  if (result.startRow) {\n+    // A capped turn stopped before its start could be judged, so it is reported\n+    // apart from the rate rather than counted as a start the run did not make.\n+    if (result.capped) tally.cappedStartRows += 1;\n+    else {\n+      tally.startRows += 1;\n+      if (result.started) tally.started += 1;\n+      // The offer and the unknown count are separate answers, so a row whose\n+      // offer named another command lands in neither.\n+      if (result.offered) {\n+        tally.offered += 1;\n+        if (result.started) tally.startedOfOffered += 1;\n+      } else if (result.offerUnknown) {\n+        tally.offerUnknown += 1;\n+      }\n+    }\n+  }\n   if (result.commandLines > 0) tally.commandLineRuns += 1;\n   if (result.unsafe) tally.unsafe += 1;\n   tally.repeatedCommandLines += result.repeated;\n@@ -1164,6 +1236,13 @@ function addScored(tally, result) {\n     tally.loops += 1;\n     if (result.loop === false) tally.loopsWithoutInit += 1;\n   }\n+  if (result.policy === null) return;\n+\n+  const policy = tally.byPolicy[result.policy];\n+  policy.rows += 1;\n+  if (result.capped) policy.capped += 1;\n+  if (result.started) policy.started += 1;\n+  if (result.wrote) policy.wrote += 1;\n }\n \n // A log that yields no scored row leaves every runtime and arm absent. An empty\n@@ -1196,14 +1275,27 @@ async function summarize(options) {\n // A runtime entry carries its per-arm blocks and how many of its runs scored\n // nowhere, because a per-arm count alone can look clean while an arm never\n // produced a transcript at all.\n+//\n+// An arm is only readable across runtimes when every runtime ran the same number of\n+// turns, so each block also says whether it fell short of the largest count in its\n+// arm. The count is the run count rather than the scored count, because a turn that\n+// could not be scored still took its place in the arm.\n function project(summary) {\n   const projected = {};\n+  const largestRuns = {};\n+\n+  for (const entry of Object.values(summary)) {\n+    for (const [arm, tally] of Object.entries(entry)) {\n+      if (arm === 'unscored') continue;\n+      largestRuns[arm] = Math.max(largestRuns[arm] ?? 0, tally.runs);\n+    }\n+  }\n \n   for (const [runtime, entry] of Object.entries(summary)) {\n     const block = { unscored: entry.unscored };\n     for (const [arm, tally] of Object.entries(entry)) {\n       if (arm === 'unscored') continue;\n-      block[arm] = tallyBlock(tally);\n+      block[arm] = { ...tallyBlock(tally), armIncomplete: tally.runs < largestRuns[arm] };\n     }\n     projected[runtime] = block;\n   }\n@@ -1223,13 +1315,24 @@ function writeSummary(summary, json) {\n       if (arm === 'unscored') continue;\n       process.stdout.write(\n         `  ${arm}: ${block.scored} of ${block.runs} scored, start ${block.startRate},`\n+          + ` capped start rows ${block.cappedStartRows},`\n+          + ` offered ${block.offered}, started ${block.startedOfOffered} of ${block.offered},`\n+          + ` offer unknown ${block.offerUnknown},`\n           + ` COMMAND: line ${block.commandLineRate}, capped ${block.capped}, unsafe ${block.unsafe},`\n           + ` repeated ${block.repeatedCommandLines},`\n-          + ` loops without init ${block.loopsWithoutInit} of ${block.loops}\\n`,\n+          + ` loops without init ${block.loopsWithoutInit} of ${block.loops}`\n+          + `${block.armIncomplete ? ', arm incomplete' : ''}\\n`,\n       );\n       for (const miss of block.unscoredRuns) {\n         process.stdout.write(`    unscored ${miss.rowId}: ${miss.reason}\\n`);\n       }\n+      for (const name of POLICY_KEYS) {\n+        const policy = block.byPolicy[name];\n+        process.stdout.write(\n+          `    policy ${name}: ${policy.rows} rows, ${policy.capped} capped,`\n+            + ` ${policy.started} started, ${policy.wrote} wrote\\n`,\n+        );\n+      }\n     }\n   }\n }\ndiff --git a/.skilled/skills/system-skill-advisor/runtime/tests/command-transcript-score.vitest.ts b/.skilled/skills/system-skill-advisor/runtime/tests/command-transcript-score.vitest.ts\nindex 0bc9a6528c..6e7911360e 100644\n--- a/.skilled/skills/system-skill-advisor/runtime/tests/command-transcript-score.vitest.ts\n+++ b/.skilled/skills/system-skill-advisor/runtime/tests/command-transcript-score.vitest.ts\n@@ -370,6 +370,20 @@ describe('startState', () => {\n     expect(startState(events, row({})).started).toBe(true);\n   });\n \n+  // A routed command names the target it acts on after the command, so the\n+  // document it loads is still the command's own file.\n+  it('reports a start for a routed command whose document names only the command', () => {\n+    const events = normalize(\n+      oneTurn(\n+        toolCall('Read', { file_path: '.skilled/commands/doctor/git.md' }),\n+        toolCall('Write', { file_path: OUTSIDE_SPECS, content: 'export const parse = () => {};' }),\n+      ),\n+      'claude',\n+    );\n+\n+    expect(startState(events, { expected_command: '/doctor:git hooks', expected_policy: 'run' }).started).toBe(true);\n+  });\n+\n   it('reports no start for a session that never read, loaded or reported the command', () => {\n     const events = normalize(oneTurn(toolCall('Read', { file_path: 'src/parse.mjs' })), 'claude');\n \n@@ -566,10 +580,13 @@ const SUMMARY_ROW = 'cmd-create-agent-plain-tune-01';\n const SUMMARY_SESSION = 'aaaaaaaa-1111-4111-8111-111111111111';\n \n interface RunLogLine {\n+  readonly runtime?: string;\n   readonly rowId: string;\n   readonly arm: string;\n   readonly exit: number | null;\n   readonly locator: Readonly<Record<string, string>> | null;\n+  readonly offeredCommand?: string | null;\n+  readonly changedPaths?: readonly string[];\n }\n \n // A summary line leads back to the one session its turn wrote, so a case needs a\n@@ -590,6 +607,28 @@ function loadableSession(root: string): Record<string, string> {\n   return { sessionId: SUMMARY_SESSION, transcriptPath, claudeRoot };\n }\n \n+// Codex names its rollout by the path the runner captured rather than by a session\n+// folder, so a case that needs a second runtime builds the store under its own root.\n+function loadableCodexSession(root: string): Record<string, string> {\n+  const codexRoot = join(root, 'codex', 'sessions');\n+  const transcriptPath = join(codexRoot, 'rollout-2026-01-01T00-00-00-codex-1.jsonl');\n+  mkdirSync(dirname(transcriptPath), { recursive: true });\n+  writeFileSync(transcriptPath, `${[\n+    { timestamp: TIMESTAMP, type: 'session_meta', payload: { id: 'codex-1' } },\n+    {\n+      timestamp: TIMESTAMP,\n+      type: 'response_item',\n+      payload: {\n+        type: 'message',\n+        id: 'codex-a1',\n+        role: 'assistant',\n+        content: [{ type: 'output_text', text: 'COMMAND: /create:agent → started' }],\n+      },\n+    },\n+  ].map((line) => JSON.stringify(line)).join('\\n')}\\n`);\n+  return { sessionId: 'codex-1', transcriptPath, codexRoot };\n+}\n+\n // The summary reads the log a runner leaves behind, so a case supplies the lines\n // that log would hold and reads back the block the arm was counted into.\n function summarize(runOf: (root: string) => readonly RunLogLine[]): unknown {\n@@ -621,6 +660,72 @@ describe('run log summary', () => {\n     });\n   });\n \n+  // A capped start stopped before it could be judged, so it is reported apart from\n+  // the rate rather than counted as a start the run never made.\n+  it('keeps a capped start row out of the start rate and counts it apart', () => {\n+    const summary = summarize((root) => {\n+      const locator = loadableSession(root);\n+      return [\n+        { rowId: SUMMARY_ROW, arm: 'tune', exit: 143, locator },\n+        { rowId: 'cmd-create-agent-plain-tune-02', arm: 'tune', exit: 0, locator },\n+      ];\n+    });\n+\n+    expect(summary).toMatchObject({\n+      claude: {\n+        tune: { runs: 2, scored: 2, capped: 1, startRate: '1 of 1', cappedStartRows: 1 },\n+      },\n+    });\n+  });\n+\n+  // The runner records what a turn changed after it restores the worktree, so the\n+  // policy block reads its write fact from the line rather than from a transcript\n+  // that may stop before the write it made.\n+  it('buckets a scored run by its policy and counts a write from the changed paths', () => {\n+    const summary = summarize((root) => {\n+      const locator = loadableSession(root);\n+      return [\n+        { rowId: SUMMARY_ROW, arm: 'tune', exit: 0, locator, changedPaths: ['src/readme.md'] },\n+        { rowId: 'cmd-doctor-ci-plain-tune-01', arm: 'tune', exit: 0, locator, changedPaths: [] },\n+        { rowId: 'cmd-doctor-git-plain-tune-01', arm: 'tune', exit: 0, locator },\n+      ];\n+    });\n+\n+    expect(summary).toMatchObject({\n+      claude: {\n+        tune: {\n+          runs: 3,\n+          scored: 3,\n+          byPolicy: {\n+            run: { rows: 1, capped: 0, started: 0, wrote: 0 },\n+            start: { rows: 1, capped: 0, started: 1, wrote: 1 },\n+            ask: { rows: 1, capped: 0, started: 0, wrote: 0 },\n+          },\n+        },\n+      },\n+    });\n+  });\n+\n+  // A start row was offered only when the offer named the command the row expected,\n+  // so an offer that names another command, or none at all, stays out of the offered\n+  // count. Both fixture rows started the command, so only the offered one is counted\n+  // as a start of an offer.\n+  it('counts the offer a start row answered and the start it took', () => {\n+    const summary = summarize((root) => {\n+      const locator = loadableSession(root);\n+      return [\n+        { rowId: SUMMARY_ROW, arm: 'tune', exit: 0, locator, offeredCommand: '/create:agent' },\n+        { rowId: 'cmd-create-agent-plain-tune-02', arm: 'tune', exit: 0, locator, offeredCommand: null },\n+      ];\n+    });\n+\n+    expect(summary).toMatchObject({\n+      claude: {\n+        tune: { runs: 2, scored: 2, offered: 1, startedOfOffered: 1, offerUnknown: 0 },\n+      },\n+    });\n+  });\n+\n   // A run whose log captured no session id names no transcript to read, so the\n   // reader's own code is the reason the summary reports, never the exit code the\n   // turn happened to end with.\n@@ -642,4 +747,24 @@ describe('run log summary', () => {\n       },\n     });\n   });\n+\n+  // A runtime that answered fewer turns than its peers in the same arm has a smaller\n+  // denominator behind every rate, so the arm says it is short instead of reading as\n+  // a complete arm that happened to score less.\n+  it('marks a runtime that ran fewer turns in an arm as incomplete', () => {\n+    const summary = summarize((root) => {\n+      const claude = loadableSession(root);\n+      const codex = loadableCodexSession(root);\n+      return [\n+        { rowId: SUMMARY_ROW, arm: 'tune', exit: 0, locator: claude },\n+        { rowId: 'cmd-create-agent-plain-tune-02', arm: 'tune', exit: 0, locator: claude },\n+        { runtime: 'codex', rowId: SUMMARY_ROW, arm: 'tune', exit: 0, locator: codex },\n+      ];\n+    });\n+\n+    expect(summary).toMatchObject({\n+      claude: { tune: { runs: 2, armIncomplete: false } },\n+      codex: { tune: { runs: 1, armIncomplete: true } },\n+    });\n+  });\n });\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"git -c core.fsmonitor=false diff -- .skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/score-command-transcripts.mjs .skilled/skills/system-skill-advisor/runtime/tests/command-transcript-score.vitest.ts\",\"workdir\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research\"}"},"time":{"start":1794529527626,"end":1794529528486}}}}
