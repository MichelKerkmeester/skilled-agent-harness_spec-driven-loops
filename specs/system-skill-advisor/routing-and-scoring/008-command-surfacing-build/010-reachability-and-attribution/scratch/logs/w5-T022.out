(!item || typeof item !== 'object') continue;\n67:     if ((item.type === itemType || item.type === 'text') && typeof item.text === 'string') {\n68:       blocks.push(textBlock(item.text));\n69:     } else if (item.type === 'thinking' && typeof item.thinking === 'string') {\n70:       blocks.push(thinkingBlock(item.thinking));\n71:     }\n72:   }\n73:   return blocks;\n74: }\n75: \n76: function recordsFromLines(lines) {\n77:   const records = [];\n78: \n79:   lines.forEach((line, index) => {\n80:     if (line?.type !== 'response_item') return;\n81:     const payload = line.payload;\n82:     if (!payload || typeof payload !== 'object') return;\n83: \n84:     const timestamp = line.timestamp;\n85:     const id = typeof payload.id === 'string' && payload.id\n86:       ? payload.id\n87:       : typeof payload.call_id === 'string' && payload.call_id\n88:         ? payload.call_id\n89:         : `codex-entry-${index}`;\n90: \n91:     if (payload.type === 'message') {\n92:       if (payload.role !== 'user' && payload.role !== 'assistant') return;\n93:       const blocks = messageBlocks(payload);\n94:       const text = contentText(blocks);\n95:       if (!text) return;\n96:       // Codex injects environment context and harness notes as user messages;\n97:       // they are attached to the turn, not typed by the operator.\n98:       if (payload.role === 'user' && INJECTED_USER_TAGS.some((tag) => text.startsWith(tag))) return;\n99:       records.push({ id, role: payload.role, timestamp, content: blocks });\n100:       return;\n101:     }\n102: \n103:     if (payload.type === 'function_call' || payload.type === 'custom_tool_call') {\n104:       records.push({\n105:         id: (typeof payload.id === 'string' && payload.id ? payload.id : `codex-call-${payload.call_id}`).slice(0, 128),\n106:         role: 'assistant',\n107:         timestamp,\n108:         content: [toolCallBlock({\n109:           id: payload.call_id ?? id,\n110:           name: payload.name,\n111:           arguments: parseJsonObject(payload.arguments) ?? {},\n112:         })],\n113:       });\n114:       return;\n115:     }\n116: \n117:     if (payload.type === 'function_call_output' || payload.type === 'custom_tool_call_output') {\n118:       const output = typeof payload.output === 'string'\n119:         ? payload.output\n120:         : JSON.stringify(payload.output ?? '');\n121:       records.push({\n122:         id: (typeof payload.id === 'string' && payload.id ? payload.id : `codex-output-${payload.call_id}`).slice(0, 128),\n123:         role: 'toolResult',\n124:         timestamp,\n125:         content: [textBlock(output)],\n126:         toolCallId: payload.call_id,\n127:         isError: false,\n128:       });\n129:     }\n130:   });\n131: \n132:   return records;\n133: }\n134: \n135: // ─────────────────────────────────────────────────────────────────────────────\n136: // 5. LOADER\n137: // ─────────────────────────────────────────────────────────────────────────────\n138: \n139: export function loadCodexSession({ sessionId, transcriptPath, ...options } = {}) {\n140:   if (typeof transcriptPath !== 'string' || !transcriptPath.trim()) {\n141:     return { ok: false, code: 'locator_unavailable' };\n142:   }\n143:   if (!isSafeSessionId(sessionId)) {\n144:     return { ok: false, code: sessionId ? 'session_mismatch' : 'locator_unavailable' };\n145:   }\n146: \n147:   // Containment is decided before the file is opened, so a path outside the\n148:   // store is refused without its content ever being read.\n149:   const root = codexStoreRoot(options);\n150:   const containment = resolveInside({ path: transcriptPath, root });\n151:   if (!containment.ok) {\n152:     if (containment.code === 'session_mismatch') return containment;\n153:     try {\n154:       statSync(root);\n155:       return { ok: false, code: 'session_not_found' };\n156:     } catch {\n157:       return { ok: false, code: 'store_unreadable' };\n158:     }\n159:   }\n160:   const storePath = containment.path;\n161: \n162:   let raw;\n163:   try {\n164:     raw = readFileSync(transcriptPath, 'utf8');\n165:   } catch {\n166:     try {\n167:       statSync(root);\n168:       return { ok: false, code: 'session_not_found' };\n169:     } catch {\n170:       return { ok: false, code: 'store_unreadable' };\n171:     }\n172:   }\n173: \n174:   const lines = parseJsonLines(raw);\n175:   if (recordedSessionId(lines, transcriptPath) !== sessionId) {\n176:     return { ok: false, code: 'session_mismatch' };\n177:   }\n178: \n179:   return {\n180:     ok: true,\n181:     source: {\n182:       runtime: RUNTIME,\n183:       sessionId,\n184:       locatorKind: LOCATOR_KIND,\n185:       storePath,\n186:     },\n187:     records: recordsFromLines(lines),\n188:   };\n189: }"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/hooks/shared/session-readers/codex.mjs\"}"},"time":{"start":1794529370213,"end":1794529370220}}}}
