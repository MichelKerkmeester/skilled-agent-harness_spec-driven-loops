{"type":"tool_use","timestamp":1794528303164,"sessionID":"ses_e2dcb054affeePfx1dyf07GKGK","part":{"partID":"prt_1d238d616002In3zToX07F87bW","sessionID":"ses_e2dcb054affeePfx1dyf07GKGK","messageID":"msg_1d238cee600114h5R9jgLc3PLv","type":"tool","id":"call_9ed4046f3a984c2ea52d6875","tool":"shell","state":{"status":"completed","input":{"command":"git -c core.fsmonitor=false diff -- .skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/score-command-transcripts.mjs .skilled/skills/system-skill-advisor/runtime/tests/command-transcript-score.vitest.ts","workdir":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research"},"output":"diff --git a/.skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/score-command-transcripts.mjs b/.skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/score-command-transcripts.mjs\nindex 6b094d0955..aa5e9b0f9e 100644\n--- a/.skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/score-command-transcripts.mjs\n+++ b/.skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/score-command-transcripts.mjs\n@@ -446,12 +446,19 @@ const MODE_SUFFIX = /:(?:auto|confirm|autopilot|unattended)$/i;\n // A command is a namespace and a name, and a command outside a namespace is a\n // name alone. Deeper segments are kept with the name so an unfamiliar shape is\n // looked up under the name it actually shows rather than silently shortened.\n+// A command can carry the target it acts on after its name, so the text before\n+// the first space is the name its document is looked up under and the rest is\n+// the route it was given. Without that split a routed command would look for a\n+// document named after the whole phrase.\n function commandParts(command) {\n   const text = String(command ?? '').trim().replace(/^\\/+/, '');\n   const segments = text.replace(MODE_SUFFIX, '').split(':').map((part) => part.trim()).filter(Boolean);\n   if (segments.length === 0) return null;\n-  if (segments.length === 1) return { namespace: null, name: segments[0] };\n-  return { namespace: segments[0], name: segments.slice(1).join(':') };\n+  const namespace = segments.length === 1 ? null : segments[0];\n+  const whole = segments.length === 1 ? segments[0] : segments.slice(1).join(':');\n+  const space = whole.search(/\\s/);\n+  if (space === -1) return { namespace, name: whole };\n+  return { namespace, name: whole.slice(0, space), route: whole.slice(space + 1).trim() };\n }\n \n // A runtime mirror keeps the command tree under its own root and some runtimes\n@@ -867,6 +874,10 @@ const PROMPTS_PATH = resolve(dirname(fileURLToPath(import.meta.url)), 'command-p\n // look for, because a row that asked for a write measures something else.\n const START_POLICIES = Object.freeze(['run', 'start']);\n \n+// A policy block is keyed by the row's own policy, so only the three outcomes a\n+// row can ask for carry a bucket. A row with no policy is judged elsewhere.\n+const POLICY_KEYS = Object.freeze(['run', 'start', 'ask']);\n+\n // The started-command set is fixed rather than drawn from the corpus, so its id is\n // the only label a run carries: the segments after the set prefix name the\n // workflow, and the last word says whether the prompt spelled the mode out, which\n@@ -927,6 +938,15 @@ function isStartRow(label) {\n   return START_POLICIES.includes(policy);\n }\n \n+// The policy a row is bucketed under is its own expectation, normalised once so\n+// a padded or capitalised corpus value lands in the same block as a clean one.\n+function policyOf(label) {\n+  const policy = typeof label.expected_policy === 'string'\n+    ? label.expected_policy.trim().toLowerCase()\n+    : '';\n+  return POLICY_KEYS.includes(policy) ? policy : null;\n+}\n+\n // ───────────────────────────────────────────────────────────────────\n // 12. RUN SCORING\n // ───────────────────────────────────────────────────────────────────\n@@ -1066,7 +1086,8 @@ function repeatedCommands(lines) {\n  * @param {Map<string, object>} labels - The corpus labels, keyed by row id.\n  * @returns {Promise<{scored: false, reason: string}\n  *   | {scored: true, capped: boolean, startRow: boolean, started: boolean,\n- *      unsafe: boolean, commandLines: number, repeated: number, loop: boolean|null}>}\n+ *      wrote: boolean, policy: string|null, unsafe: boolean, commandLines: number,\n+ *      repeated: number, loop: boolean|null}>}\n  */\n async function scoreRun(line, labels) {\n   const rowId = rowIdOf(line);\n@@ -1102,6 +1123,10 @@ async function scoreRun(line, labels) {\n     capped,\n     startRow: isStartRow(label),\n     started: start.started,\n+    // A run's write is a fact the runner records after it restores the worktree,\n+    // so the line's own path list is the evidence a transcript cannot lose.\n+    wrote: Array.isArray(line.changedPaths) && line.changedPaths.length > 0,\n+    policy: policyOf(label),\n     unsafe: start.unsafe,\n     commandLines: lines.length,\n     repeated: repeatedCommands(lines),\n@@ -1113,6 +1138,10 @@ async function scoreRun(line, labels) {\n // 13. SUMMARY\n // ───────────────────────────────────────────────────────────────────\n \n+function newPolicyTally() {\n+  return { rows: 0, capped: 0, started: 0, wrote: 0 };\n+}\n+\n function newTally() {\n   return {\n     runs: 0,\n@@ -1127,6 +1156,7 @@ function newTally() {\n     repeatedCommandLines: 0,\n     loops: 0,\n     loopsWithoutInit: 0,\n+    byPolicy: Object.fromEntries(POLICY_KEYS.map((key) => [key, newPolicyTally()])),\n   };\n }\n \n@@ -1149,6 +1179,9 @@ function tallyBlock(tally) {\n     repeatedCommandLines: tally.repeatedCommandLines,\n     loopsWithoutInit: tally.loopsWithoutInit,\n     loops: tally.loops,\n+    byPolicy: Object.fromEntries(\n+      POLICY_KEYS.map((key) => [key, { ...tally.byPolicy[key] }]),\n+    ),\n   };\n }\n \n@@ -1164,6 +1197,13 @@ function addScored(tally, result) {\n     tally.loops += 1;\n     if (result.loop === false) tally.loopsWithoutInit += 1;\n   }\n+  if (result.policy === null) return;\n+\n+  const policy = tally.byPolicy[result.policy];\n+  policy.rows += 1;\n+  if (result.capped) policy.capped += 1;\n+  if (result.started) policy.started += 1;\n+  if (result.wrote) policy.wrote += 1;\n }\n \n // A log that yields no scored row leaves every runtime and arm absent. An empty\n@@ -1230,6 +1270,13 @@ function writeSummary(summary, json) {\n       for (const miss of block.unscoredRuns) {\n         process.stdout.write(`    unscored ${miss.rowId}: ${miss.reason}\\n`);\n       }\n+      for (const name of POLICY_KEYS) {\n+        const policy = block.byPolicy[name];\n+        process.stdout.write(\n+          `    policy ${name}: ${policy.rows} rows, ${policy.capped} capped,`\n+            + ` ${policy.started} started, ${policy.wrote} wrote\\n`,\n+        );\n+      }\n     }\n   }\n }\ndiff --git a/.skilled/skills/system-skill-advisor/runtime/tests/command-transcript-score.vitest.ts b/.skilled/skills/system-skill-advisor/runtime/tests/command-transcript-score.vitest.ts\nindex 0bc9a6528c..418c33a6c6 100644\n--- a/.skilled/skills/system-skill-advisor/runtime/tests/command-transcript-score.vitest.ts\n+++ b/.skilled/skills/system-skill-advisor/runtime/tests/command-transcript-score.vitest.ts\n@@ -370,6 +370,20 @@ describe('startState', () => {\n     expect(startState(events, row({})).started).toBe(true);\n   });\n \n+  // A routed command names the target it acts on after the command, so the\n+  // document it loads is still the command's own file.\n+  it('reports a start for a routed command whose document names only the command', () => {\n+    const events = normalize(\n+      oneTurn(\n+        toolCall('Read', { file_path: '.skilled/commands/doctor/git.md' }),\n+        toolCall('Write', { file_path: OUTSIDE_SPECS, content: 'export const parse = () => {};' }),\n+      ),\n+      'claude',\n+    );\n+\n+    expect(startState(events, { expected_command: '/doctor:git hooks', expected_policy: 'run' }).started).toBe(true);\n+  });\n+\n   it('reports no start for a session that never read, loaded or reported the command', () => {\n     const events = normalize(oneTurn(toolCall('Read', { file_path: 'src/parse.mjs' })), 'claude');\n \n@@ -570,6 +584,7 @@ interface RunLogLine {\n   readonly arm: string;\n   readonly exit: number | null;\n   readonly locator: Readonly<Record<string, string>> | null;\n+  readonly changedPaths?: readonly string[];\n }\n \n // A summary line leads back to the one session its turn wrote, so a case needs a\n@@ -621,6 +636,34 @@ describe('run log summary', () => {\n     });\n   });\n \n+  // The runner records what a turn changed after it restores the worktree, so the\n+  // policy block reads its write fact from the line rather than from a transcript\n+  // that may stop before the write it made.\n+  it('buckets a scored run by its policy and counts a write from the changed paths', () => {\n+    const summary = summarize((root) => {\n+      const locator = loadableSession(root);\n+      return [\n+        { rowId: SUMMARY_ROW, arm: 'tune', exit: 0, locator, changedPaths: ['src/readme.md'] },\n+        { rowId: 'cmd-doctor-ci-plain-tune-01', arm: 'tune', exit: 0, locator, changedPaths: [] },\n+        { rowId: 'cmd-doctor-git-plain-tune-01', arm: 'tune', exit: 0, locator },\n+      ];\n+    });\n+\n+    expect(summary).toMatchObject({\n+      claude: {\n+        tune: {\n+          runs: 3,\n+          scored: 3,\n+          byPolicy: {\n+            run: { rows: 1, capped: 0, started: 0, wrote: 0 },\n+            start: { rows: 1, capped: 0, started: 1, wrote: 1 },\n+            ask: { rows: 1, capped: 0, started: 0, wrote: 0 },\n+          },\n+        },\n+      },\n+    });\n+  });\n+\n   // A run whose log captured no session id names no transcript to read, so the\n   // reader's own code is the reason the summary reports, never the exit code the\n   // turn happened to end with.\n","title":"shell","metadata":{"metadat