status\": \"active\",\n        \"command\": \"/doctor:setup\",\n        \"kind\": \"command\",\n        \"policy\": \"run\",\n        \"ownerSkillId\": \"system-skilled-doctor\"\n      },\n      {\n        \"skillId\": \"sk-prompt\",\n        \"score\": 0.437903,\n        \"confidence\": 0.82,\n        \"uncertainty\": 0.16,\n        \"dominantLane\": \"explicit_author\",\n        \"status\": \"active\",\n        \"kind\": \"skill\"\n      },\n      {\n        \"skillId\": \"sk-doc\",\n        \"score\": 0.178904,\n        \"confidence\": 0.82,\n        \"uncertainty\": 0.22,\n        \"dominantLane\": \"lexical\",\n        \"status\": \"active\",\n        \"compiledRoute\": {\n          \"hubId\": \"sk-doc\",\n          \"action\": \"defer\",\n          \"selectionKind\": null,\n          \"targets\": [],\n          \"effectivePolicyHash\": \"0c36f5c183023baaed6076575b48271ef45e528322d8abb079f83cc0fd8843ed\",\n          \"generation\": 5\n        },\n        \"kind\": \"skill\"\n      }\n    ],\n    \"ambiguous\": true,\n    \"freshness\": \"live\",\n    \"trustState\": {\n      \"state\": \"live\",\n      \"reason\": null,\n      \"generation\": 88,\n      \"checkedAt\": \"2026-11-12T23:49:30.259Z\",\n      \"lastLiveAt\": \"2026-11-12T23:47:27.413Z\"\n    },\n    \"generatedAt\": \"2026-11-12T23:49:30.315Z\",\n    \"cache\": {\n      \"hit\": false,\n      \"sourceSignaturePresent\": true\n    },\n    \"_shadow\": {\n      \"model\": \"advisor-shadow-learned-weights-v1\",\n      \"liveWeightsFrozen\": true,\n      \"recommendations\": [\n        {\n          \"skillId\": \"sk-prompt\",\n          \"liveScore\": 0.437903,\n          \"shadowScore\": 0.415966,\n          \"delta\": -0.021937,\n          \"dominantShadowLane\": \"explicit_author\"\n        },\n        {\n          \"skillId\": \"sk-doc\",\n          \"liveScore\": 0.178904,\n          \"shadowScore\": 0.179957,\n          \"delta\": 0.001053,\n          \"dominantShadowLane\": \"lexical\"\n        }