{"type":"tool_use","timestamp":1794527321244,"sessionID":"ses_e2dd83989ffevoEHqeWn41PhPb","part":{"partID":"prt_1d229daf0001VujjtUWmjhP2Cc","sessionID":"ses_e2dd83989ffevoEHqeWn41PhPb","messageID":"msg_1d2296369001OjwrzseZcsvjHR","type":"tool","id":"call_028c1b0464a442fa804b51af","tool":"read","state":{"status":"completed","input":{"path":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/commands/doctor/scripts/agent-roster-mirror-check.cjs"},"output":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/commands/doctor/scripts/agent-roster-mirror-check.cjs, lines 1-233\n1: #!/usr/bin/env node\n2: // ───────────────────────────────────────────────────────────────────\n3: // MODULE: Agent Roster Mirror Check\n4: // ───────────────────────────────────────────────────────────────────\n5: 'use strict';\n6: \n7: // Read-only /doctor diagnostic for agent-roster coverage across runtimes.\n8: //\n9: // WHY THIS EXISTS: the same agent roster is exposed to five runtimes, but each\n10: // discovers agents from its own path with its own file shape. Cursor and Devin\n11: // are served by symlinks into the canonical Claude tree, while OpenCode and Codex\n12: // keep independently-authored files in their own dialects. Nothing in the\n13: // runtimes themselves notices when a newly-added agent reaches only some of\n14: // them -- it simply goes missing where it was never mirrored, silently, with no\n15: // error at dispatch time. This check makes that omission loud.\n16: //\n17: // Never writes; a /doctor run is read-only by contract.\n18: // Exit 0 when every runtime covers the canonical roster, 1 on drift, 2 on\n19: // checker error (bad arguments, a missing canonical dir, or any unexpected\n20: // throw), always with a STATUS= line.\n21: \n22: // ─────────────────────────────────────────────────────────────────────────────\n23: // 1. IMPORTS\n24: // ─────────────────────────────────────────────────────────────────────────────\n25: \n26: const fs = require('node:fs');\n27: const path = require('node:path');\n28: \n29: // ─────────────────────────────────────────────────────────────────────────────\n30: // 2. CONSTANTS\n31: // ─────────────────────────────────────────────────────────────────────────────\n32: \n33: const DEFAULT_REPO = path.resolve(__dirname, '../../../..');\n34: \n35: const USAGE = [\n36:   'Usage: agent-roster-mirror-check.cjs [--root <dir>] [--check]',\n37:   '  --root  check the tree under <dir> instead of this repository (default: the',\n38:   '          repository holding this script), so drift can be proven on a copy.',\n39:   '  --check accepted as a no-op, because this checker is read-only either way and',\n40:   '          the sibling mirror checkers take the flag.',\n41: ].join('\\n');\n42: \n43: // The Claude tree is canonical: it holds the full agent bodies that the Cursor\n44: // and Devin mirrors symlink back to.\n45: const CANONICAL_REL = '.claude/agents';\n46: \n47: // Agents that exist only because Claude Code resolves a subagent by exact name and\n48: // lets a user or project file replace its built-in. No other runtime has that\n49: // built-in, so they are not part of the roster the other surfaces must cover.\n50: // Keep in step with the same list in sync-runtime-mirrors.cjs.\n51: const CLAUDE_ONLY_AGENTS = new Set(['Explore']);\n52: \n53: // Symlink mirrors must resolve to the canonical file, not merely exist -- a real\n54: // file here would be a silent fork that drifts on the next canonical edit.\n55: // Each surface names its directory once; `entry` is the agent's path inside it.\n56: const LINKED = [\n57:   { id: 'cursor', dir: '.cursor/agents', entry: (n) => `${n}.md`, ext: '.md' },\n58:   // Devin is the one directory-per-agent surface, so its entries carry no extension.\n59:   { id: 'devin', dir: '.devin/agents', entry: (n) => `${n}/AGENT.md`, ext: null },\n60: ];\n61: \n62: // Independently-authored surfaces: a different frontmatter dialect is expected,\n63: // so only presence is checked, never content equality.\n64: const AUTHORED = [\n65:   { id: 'opencode', dir: '.skilled/agents', entry: (n) => `${n}.md`, ext: '.md' },\n66:   { id: 'codex', dir: '.codex/agents', entry: (n) => `${n}.toml`, ext: '.toml' },\n67:   // Pi agents are generated real files (sync-agents-pi.cjs), not symlinks.\n68:   { id: 'pi', dir: '.pi/agents', entry: (n) => `${n}.md`, ext: '.md' },\n69: ];\n70: \n71: // Width of the surface-id column in the report.\n72: const SURFACE_WIDTH = 9;\n73: \n74: // ─────────────────────────────────────────────────────────────────────────────\n75: // 3. HELPERS\n76: // ─────────────────────────────────────────────────────────────────────────────\n77: \n78: function fail(message) {\n79:   console.error(`STATUS=ERROR agent-roster-mirror: ${message}`);\n80:   process.exit(2);\n81: }\n82: \n83: function parseArgs(argv) {\n84:   const opts = { root: DEFAULT_REPO };\n85:   for (let i = 0; i < argv.length; i++) {\n86:     // Every run here is a check, so the flag its siblings require names no other\n87:     // mode; refusing it would fail a valid shared invocation.\n88:     if (argv[i] === '--check') continue;\n89:     if (argv[i] === '--root') {\n90:       const next = argv[++i];\n91:       if (!next || next.startsWith('-')) fail(`--root needs a directory\\n${USAGE}`);\n92:       opts.root = path.resolve(next);\n93:     } else {\n94:       fail(`unknown argument: ${argv[i]}\\n${USAGE}`);\n95:     }\n96:   }\n97:   return opts;\n98: }\n99: \n100: // Sibling READMEs and stray notes are not agents; flagging them as orphans or\n101: // counting them as roster members would train the reader to ignore output.\n102: function isReadme(entry) {\n103:   return /^readme(\\.|$)/i.test(entry);\n104: }\n105: \n106: // ─────────────────────────────────────────────────────────────────────────────\n107: // 4. CORE LOGIC\n108: // ─────────────────────────────────────────────────────────────────────────────\n109: \n110: function canonicalRoster(canonicalDir) {\n111:   return fs\n112:     .readdirSync(canonicalDir)\n113:     .filter((f) => f.endsWith('.md') && !isReadme(f))\n114:     .map((f) => f.slice(0, -3))\n115:     .filter((name) => !CLAUDE_ONLY_AGENTS.has(name))\n116:     .sort();\n117: }\n118: \n119: function checkLinked(repo, surface, name) {\n120:   const abs = path.join(repo, surface.dir, surface.entry(name));\n121:   let st;\n122:   try {\n123:     st = fs.lstatSync(abs);\n124:   } catch {\n125:     return { ok: false, why: 'missing' };\n126:   }\n127:   if (!st.isSymbolicLink()) return { ok: false, why: 'not a symlink (silent fork risk)' };\n128:   if (!fs.existsSync(abs)) return { ok: false, why: 'broken symlink' };\n129:   const want = path.join(repo, CANONICAL_REL, `${name}.md`);\n130:   if (fs.realpathSync(abs) !== fs.realpathSync(want)) {\n131:     return { ok: false, why: 'resolves elsewhere' };\n132:   }\n133:   return { ok: true };\n134: }\n135: \n136: // Classify one directory entry for a directory-per-agent surface. lstat first,\n137: // because a broken symlink makes a following stat throw; the broken link is a\n138: // problem to report, not a reason to crash the whole check.\n139: function directoryEntryKind(abs) {\n140:   const st = fs.lstatSync(abs);\n141:   if (!st.isSymbolicLink()) return st.isDirectory() ? 'agent' : 'other';\n142:   try {\n143:     return fs.statSync(abs).isDirectory() ? 'agent' : 'other';\n144:   } catch {\n145:     return 'broken';\n146:   }\n147: }\n148: \n149: // A mirror with no canonical source is drift in the other direction: it keeps\n150: // serving an agent that the roster no longer defines.\n151: function scanSurface(repo, surface, roster) {\n152:   const dir = path.join(repo, surface.dir);\n153:   const result = { orphans: [], broken: [] };\n154:   if (!fs.existsSync(dir)) return result;\n155:   const known = new Set(roster);\n156:   const names = [];\n157:   for (const e of fs.readdirSync(dir).sort()) {\n158:     if (e.startsWith('.') || isReadme(e)) continue;\n159:     if (surface.ext === null) {\n160:       const kind = directoryEntryKind(path.join(dir, e));\n161:       if (kind === 'broken') result.broken.push(e);\n162:       if (kind === 'agent') names.push(e);\n163:     } else if (e.endsWith(surface.ext)) {\n164:       names.push(e.slice(0, -surface.ext.length));\n165:     }\n166:   }\n167:   result.orphans = names.filter((n) => !known.has(n));\n168:   return result;\n169: }\n170: \n171: // ─────────────────────────────────────────────────────────────────────────────\n172: // 5. REPORT\n173: // ─────────────────────────────────────────────────────────────────────────────\n174: \n175: function main() {\n176:   const { root } = parseArgs(process.argv.slice(2));\n177:   const canonicalDir = path.join(root, CANONICAL_REL);\n178:   if (!fs.existsSync(canonicalDir)) fail(`canonical dir not found: ${canonicalDir}`);\n179: \n180:   const roster = canonicalRoster(canonicalDir);\n181:   const problems = [];\n182: \n183:   console.log('\\n/doctor agent-roster-mirror — read-only coverage check');\n184:   console.log(`canonical: ${CANONICAL_REL} (${roster.length} agents)\\n`);\n185: \n186:   for (const s of [...LINKED, ...AUTHORED]) {\n187:     const linked = LINKED.includes(s);\n188:     const bad = [];\n189:     for (const name of roster) {\n190:       if (linked) {\n191:         const r = checkLinked(root, s, name);\n192:         if (!r.ok) bad.push(`${name} (${r.why})`);\n193:       } else if (!fs.existsSync(path.join(root, s.dir, s.entry(name)))) {\n194:         bad.push(`${name} (missing)`);\n195:       }\n196:     }\n197:     const { orphans, broken } = scanSurface(root, s, roster);\n198:     const clean = bad.length === 0 && orphans.length === 0 && broken.length === 0;\n199:     const mark = clean ? 'OK  ' : 'DRIFT';\n200:     const kind = linked ? 'symlinked' : 'present';\n201:     const tally = `${roster.length - bad.length}/${roster.length} ${kind}`;\n202:     console.log(`  ${mark} ${s.id.padEnd(SURFACE_WIDTH)} ${tally}`);\n203:     for (const b of bad) {\n204:       console.log(`         - ${b}`);\n205:       problems.push(`${s.id}: ${b}`);\n206:     }\n207:     for (const e of orphans) {\n208:       console.log(`         + ${e} (no canonical source)`);\n209:       problems.push(`${s.id}: orphan ${e}`);\n210:     }\n211:     for (const e of broken) {\n212:       console.log(`         ! ${e} (broken symlink)`);\n213:       problems.push(`${s.id}: broken symlink ${e}`);\n214:     }\n215:   }\n216: \n217:   if (problems.length > 0) {\n218:     console.log(`\\nSTATUS=DRIFT agent-roster-mirror: ${problems.length} issue(s)`);\n219:     console.log('Repair: symlink surfaces mirror .claude/agents/<name>.md; '\n220:       + 'authored surfaces need a native file per dialect.\\n');\n221:     process.exit(1);\n222:   }\n223:   console.log('\\nSTATUS=OK agent-roster-mirror: every runtime covers the canonical roster\\n');\n224:   process.exit(0);\n225: }\n226: \n227: // Any throw is the checker failing, never a drift verdict, so it must reach the\n228: // exit code the workflow maps to checker error rather than Node's default 1.\n229: try {\n230:   main();\n231: } catch (err) {\n232:   fail(`checker crashed: ${err && err.message ? err.message : String(err)}`);\n233: }","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/commands/doctor/scripts/agent-roster-mirror-check.cjs, lines 1-233\n1: #!/usr/bin/env node\n2: // ───────────────────────────────────────────────────────────────────\n3: // MODULE: Agent Roster Mirror Check\n4: // ───────────────────────────────────────────────────────────────────\n5: 'use strict';\n6: \n7: // Read-only /doctor diagnostic for agent-roster coverage across runtimes.\n8: //\n9: // WHY THIS EXISTS: the same agent roster is exposed to five runtimes, but each\n10: // discovers agents from its own path with its own file shape. Cursor and Devin\n11: // are served by symlinks into the canonical Claude tree, while OpenCode and Codex\n12: // keep independently-authored files in their own dialects. Nothing in the\n13: // runtimes themselves notices when a newly-added agent reaches only some of\n14: // them -- it simply goes missing where it was never mirrored, silently, with no\n15: // error at dispatch time. This check makes that omission loud.\n16: //\n17: // Never writes; a /doctor run is read-only by contract.\n18: // Exit 0 when every runtime covers the canonical roster, 1 on drift, 2 on\n19: // checker error (bad arguments, a missing canonical dir, or any unexpected\n20: // throw), always with a STATUS= line.\n21: \n22: // ─────────────────────────────────────────────────────────────────────────────\n23: // 1. IMPORTS\n24: // ─────────────────────────────────────────────────────────────────────────────\n25: \n26: const fs = require('node:fs');\n27: const path = require('node:path');\n28: \n29: // ─────────────────────────────────────────────────────────────────────────────\n30: // 2. CONSTANTS\n31: // ─────────────────────────────────────────────────────────────────────────────\n32: \n33: const DEFAULT_REPO = path.resolve(__dirname, '../../../..');\n34: \n35: const USAGE = [\n36:   'Usage: agent-roster-mirror-check.cjs [--root <dir>] [--check]',\n37:   '  --root  check the tree under <dir> instead of this repository (default: the',\n38:   '          repository holding this script), so drift can be proven on a copy.',\n39:   '  --check accepted as a no-op, because this checker is read-only either way and',\n40:   '          the sibling mirror checkers take the flag.',\n41: ].join('\\n');\n42: \n43: // The Claude tree is canonical: it holds the full agent bodies that the Cursor\n44: // and Devin mirrors symlink back to.\n45: const CANONICAL_REL = '.claude/agents';\n46: \n47: // Agents that exist only because Claude Code resolves a subagent by