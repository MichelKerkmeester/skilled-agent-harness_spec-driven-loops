— read-only coverage check');\n184:   console.log(`canonical: ${CANONICAL_REL} (${roster.length} agents)\\n`);\n185: \n186:   for (const s of [...LINKED, ...AUTHORED]) {\n187:     const linked = LINKED.includes(s);\n188:     const bad = [];\n189:     for (const name of roster) {\n190:       if (linked) {\n191:         const r = checkLinked(root, s, name);\n192:         if (!r.ok) bad.push(`${name} (${r.why})`);\n193:       } else if (!fs.existsSync(path.join(root, s.dir, s.entry(name)))) {\n194:         bad.push(`${name} (missing)`);\n195:       }\n196:     }\n197:     const { orphans, broken } = scanSurface(root, s, roster);\n198:     const clean = bad.length === 0 && orphans.length === 0 && broken.length === 0;\n199:     const mark = clean ? 'OK  ' : 'DRIFT';\n200:     const kind = linked ? 'symlinked' : 'present';\n201:     const tally = `${roster.length - bad.length}/${roster.length} ${kind}`;\n202:     console.log(`  ${mark} ${s.id.padEnd(SURFACE_WIDTH)} ${tally}`);\n203:     for (const b of bad) {\n204:       console.log(`         - ${b}`);\n205:       problems.push(`${s.id}: ${b}`);\n206:     }\n207:     for (const e of orphans) {\n208:       console.log(`         + ${e} (no canonical source)`);\n209:       problems.push(`${s.id}: orphan ${e}`);\n210:     }\n211:     for (const e of broken) {\n212:       console.log(`         ! ${e} (broken symlink)`);\n213:       problems.push(`${s.id}: broken symlink ${e}`);\n214:     }\n215:   }\n216: \n217:   if (problems.length > 0) {\n218:     console.log(`\\nSTATUS=DRIFT agent-roster-mirror: ${problems.length} issue(s)`);\n219:     console.log('Repair: symlink surfaces mirror .claude/agents/<name>.md; '\n220:       + 'authored surfaces need a native file per dialect.\\n');\n221:     process.exit(1);\n222:   }\n223:   console.log('\\nSTATUS=OK agent-roster-mirror: every runtime covers the canonical roster\\n');\n224:   process.exit(0);\n225: }\n226: \n227: // Any throw is the checker failing, never a drift verdict, so it must reach the\n228: // exit code the workflow maps to checker error rather than Node's default 1.\n229: try {\n230:   main();\n231: } catch (err) {\n232:   fail(`checker crashed: ${err && err.message ? err.message : String(err)}`);\n233: }"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/commands/doctor/scripts/agent-roster-mirror-check.cjs\"}"},"time":{"start":1794527320816,"end":1794527321244}}}}
