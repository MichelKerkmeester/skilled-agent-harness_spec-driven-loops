{"type":"tool_use","timestamp":1794527276791,"sessionID":"ses_e2dd83989ffevoEHqeWn41PhPb","part":{"partID":"prt_1d2292ee7002N5Q7J5ldHkZQYx","sessionID":"ses_e2dd83989ffevoEHqeWn41PhPb","messageID":"msg_1d2291f320019B6OfznfZbnk1j","type":"tool","id":"call_baeb884f999849b8935b990c","tool":"read","state":{"status":"completed","input":{"path":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/commands/doctor/scripts/git-hook-gates.cjs"},"output":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/commands/doctor/scripts/git-hook-gates.cjs, lines 1-226\n1: #!/usr/bin/env node\n2: // ───────────────────────────────────────────────────────────────────\n3: // MODULE: Git Hook Gate Settings\n4: // ───────────────────────────────────────────────────────────────────\n5: 'use strict';\n6: \n7: // Lists and changes the persistent on/off setting of each shipped git hook gate.\n8: //\n9: // WHY THIS EXISTS: every optional gate in the pre-commit, prepare-commit-msg and\n10: // pre-push hooks has a SPECKIT_SKIP_* variable, but a variable lasts one command.\n11: // An operator who never wants a gate had to export it in every shell. The hooks\n12: // now read `speckit.hooks.<key>` from local or global git config through\n13: // lib/gate-config.sh, and this script is the guided way to see and change those\n14: // keys. gates.tsv beside that helper is the one list of gates; this script reads\n15: // it rather than keeping its own, so a new gate appears here when it is registered.\n16: //\n17: // Two kinds of switch are deliberately not settable here. The per-push approvals\n18: // (SPECKIT_ALLOW_REMOTE_PUSH, SPECKIT_ALLOW_MASS_DELETION) are marked\n19: // non-persistable in the registry, because a saved approval would approve every\n20: // later push. The commit-msg hook has no switch at all: its rules live in the sk-git\n21: // templates, and changing them is git-standards.cjs's job.\n22: //\n23: // Dry-run by default: `set` prints the git config commands it would run and the\n24: // resulting effective value, and changes nothing without --apply.\n25: //\n26: // Usage:\n27: //   git-hook-gates.cjs list [--repo <dir>] [--json]\n28: //   git-hook-gates.cjs set <key> on|off [--scope local|global] [--repo <dir>] [--apply] [--json]\n29: //\n30: // Exit 0 on success, 2 on a refused or invalid request (unknown key, a\n31: // non-persistable gate, bad arguments, a missing registry), always with a STATUS= line.\n32: \n33: // ─────────────────────────────────────────────────────────────────────────────\n34: // 1. IMPORTS\n35: // ─────────────────────────────────────────────────────────────────────────────\n36: \n37: const fs = require('node:fs');\n38: const path = require('node:path');\n39: const { execFileSync, spawnSync } = require('node:child_process');\n40: \n41: // ─────────────────────────────────────────────────────────────────────────────\n42: // 2. CONSTANTS\n43: // ─────────────────────────────────────────────────────────────────────────────\n44: \n45: const DEFAULT_REGISTRY = path.resolve(__dirname, '../../../scripts/git-hooks/lib/gates.tsv');\n46: const KEY_PREFIX = 'speckit.hooks.';\n47: const OFF_VALUES = new Set(['off', 'false', 'no', '0']);\n48: const SCOPES = new Set(['local', 'global']);\n49: \n50: class RefusedError extends Error {}\n51: \n52: // ─────────────────────────────────────────────────────────────────────────────\n53: // 3. HELPERS\n54: // ─────────────────────────────────────────────────────────────────────────────\n55: \n56: function parseArgs(argv) {\n57:   const opts = { positional: [], scope: 'local', apply: false, json: false, repo: null };\n58:   for (let i = 0; i < argv.length; i += 1) {\n59:     const arg = argv[i];\n60:     if (arg === '--apply') opts.apply = true;\n61:     else if (arg === '--json') opts.json = true;\n62:     else if (arg === '--scope' || arg === '--repo') {\n63:       const value = argv[i + 1];\n64:       if (value === undefined) throw new RefusedError(`${arg} needs a value`);\n65:       opts[arg.slice(2)] = value;\n66:       i += 1;\n67:     } else if (arg.startsWith('--')) throw new RefusedError(`unknown flag: ${arg}`);\n68:     else opts.positional.push(arg);\n69:   }\n70:   if (!SCOPES.has(opts.scope)) throw new RefusedError(`--scope must be local or global, not ${opts.scope}`);\n71:   return opts;\n72: }\n73: \n74: function readRegistry(file) {\n75:   if (!fs.existsSync(file)) throw new RefusedError(`gate registry not found: ${file}`);\n76:   return fs.readFileSync(file, 'utf8').split('\\n')\n77:     .filter((line) => line.trim() && !line.startsWith('#'))\n78:     .map((line) => {\n79:       const [hook, key, env, persistable, description] = line.split('\\t');\n80:       return { hook, key, env, persistable: persistable === 'yes', description: description || '' };\n81:     });\n82: }\n83: \n84: function repoRoot(dir) {\n85:   try {\n86:     return execFileSync('git', ['-C', dir, 'rev-parse', '--show-toplevel'], { encoding: 'utf8', stdio: ['ignore', 'pipe', 'ignore'] }).trim();\n87:   } catch {\n88:     throw new RefusedError(`not inside a git repository: ${dir}`);\n89:   }\n90: }\n91: \n92: // Every stored value of one key, by scope. Command-line config is dropped because the\n93: // hooks drop it: a `git -c` value never decides a gate, so showing it would mislead.\n94: function storedValues(root, key) {\n95:   const result = spawnSync('git', ['-C', root, 'config', '--show-scope', '--get-all', `${KEY_PREFIX}${key}`], { encoding: 'utf8' });\n96:   const values = [];\n97:   for (const line of (result.stdout || '').split('\\n')) {\n98:     if (!line) continue;\n99:     const tab = line.indexOf('\\t');\n100:     const scope = line.slice(0, tab);\n101:     if (scope === 'command') continue;\n102:     values.push({ scope, value: line.slice(tab + 1) });\n103:   }\n104:   return values;\n105: }\n106: \n107: function effective(values) {\n108:   const last = values[values.length - 1];\n109:   if (!last) return { state: 'on', from: 'default' };\n110:   return { state: OFF_VALUES.has(last.value.toLowerCase()) ? 'off' : 'on', from: `${last.scope} config` };\n111: }\n112: \n113: function valueAt(values, scope) {\n114:   const hits = values.filter((v) => v.scope === scope);\n115:   return hits.length ? hits[hits.length - 1].value : null;\n116: }\n117: \n118: function describe(root, gate) {\n119:   const values = storedValues(root, gate.key);\n120:   return {\n121:     key: gate.key,\n122:     hook: gate.hook,\n123:     env: gate.env,\n124:     persistable: gate.persistable,\n125:     description: gate.description,\n126:     local: valueAt(values, 'local'),\n127:     global: valueAt(values, 'global'),\n128:     effective: gate.persistable ? effective(values) : { state: 'on', from: 'not persistable' },\n129:     envSet: process.env[gate.env] === '1',\n130:   };\n131: }\n132: \n133: // ─────────────────────────────────────────────────────────────────────────────\n134: // 4. MODES\n135: // ─────────────────────────────────────────────────────────────────────────────\n136: \n137: function list(registry, root, opts) {\n138:   const rows = registry.map((gate) => describe(root, gate));\n139:   if (opts.json) {\n140:     process.stdout.write(`${JSON.stringify({ repo: root, gates: rows }, null, 2)}\\n`);\n141:   } else {\n142:     process.stdout.write(`Gate settings for ${root}\\n\\n`);\n143:     process.stdout.write('| Key | Hook | Local | Global | Effective | Bypass variable | What it does |\\n|-----|------|-------|--------|-----------|-----------------|--------------|\\n');\n144:     for (const r of rows) {\n145:       const eff = r.persistable ? `${r.effective.state} (${r.effective.from})` : 'per push only';\n146:       const env = r.envSet ? `${r.env} (set in this shell)` : r.env;\n147:       process.stdout.write(`| ${r.key} | ${r.hook} | ${r.local ?? '-'} | ${r.global ?? '-'} | ${eff} | ${env} | ${r.description} |\\n`);\n148:     }\n149:   }\n150:   const off = rows.filter((r) => r.persistable && r.effective.state === 'off').length;\n151:   process.stdout.write(`STATUS=OK GATES=${rows.length} OFF=${off}\\n`);\n152:   return 0;\n153: }\n154: \n155: function set(registry, root, opts) {\n156:   const [, key, state] = opts.positional;\n157:   if (!key || !state) throw new RefusedError('usage: set <key> on|off [--scope local|global] [--apply]');\n158:   const gate = registry.find((g) => g.key === key);\n159:   if (!gate) throw new RefusedError(`unknown gate key: ${key}. Run list to see the keys.`);\n160:   if (!gate.persistable) {\n161:     throw new RefusedError(`${key} cannot be saved: ${gate.env} approves one push at a time, so set it on that one command only.`);\n162:   }\n163:   if (state !== 'on' && state !== 'off') throw new RefusedError(`state must be on or off, not ${state}`);\n164: \n165:   const values = storedValues(root, key);\n166:   const scopeFlag = `--${opts.scope}`;\n167:   const name = `${KEY_PREFIX}${key}`;\n168:   const commands = [];\n169:   if (state === 'off') {\n170:     commands.push(['config', scopeFlag, '--replace-all', name, 'off']);\n171:   } else if (opts.scope === 'local' && valueAt(values, 'global') !== null && effective(values.filter((v) => v.scope !== 'local')).state === 'off') {\n172:     // A local unset would let the global off decide, so a local on is written explicitly.\n173:     commands.push(['config', '--local', '--replace-all', name, 'on']);\n174:   } else if (valueAt(values, opts.scope) !== null) {\n175:     commands.push(['config', scopeFlag, '--unset-all', name]);\n176:   }\n177: \n178:   const before = effective(values);\n179:   if (opts.apply) {\n180:     for (const args of commands) execFileSync('git', ['-C', root, ...args], { stdio: ['ignore', 'pipe', 'pipe'] });\n181:   }\n182:   const after = opts.apply ? effective(storedValues(root, key)) : null;\n183:   const shown = commands.map((args) => `git ${args.join(' ')}`);\n184:   const note = state === 'on' && opts.scope === 'global' && valueAt(values, 'local') !== null\n185:     && OFF_VALUES.has(String(valueAt(values, 'local')).toLowerCase())\n186:     ? 'local config still switches this gate off in this repository'\n187:     : null;\n188: \n189:   if (opts.json) {\n190:     process.stdout.write(`${JSON.stringify({ repo: root, key, hook: gate.hook, env: gate.env, scope: opts.scope, requested: state, applied: opts.apply, commands: shown, before, after, note }, null, 2)}\\n`);\n191:   } else {\n192:     process.stdout.write(`Gate ${key} (${gate.hook}): ${before.state} (${before.from}) -> requested ${state} in ${opts.scope} config\\n`);\n193:     if (shown.length === 0) process.stdout.write('Nothing to change: no stored value to remove at that scope.\\n');\n194:     for (const cmd of shown) process.stdout.write(`${opts.apply ? 'Ran' : 'Would run'}: ${cmd}\\n`);\n195:     if (after) process.stdout.write(`Now: ${after.state} (${after.from})\\n`);\n196:     if (note) process.stdout.write(`Note: ${note}\\n`);\n197:     if (!opts.apply && shown.length) process.stdout.write('Dry run: nothing changed. Add --apply to write.\\n');\n198:   }\n199:   process.stdout.write(`STATUS=OK MODE=${opts.apply ? 'APPLIED' : 'DRY_RUN'} KEY=${key}\\n`);\n200:   return 0;\n201: }\n202: \n203: // ─────────────────────────────────────────────────────────────────────────────\n204: // 5. MAIN\n205: // ─────────────────────────────────────────────────────────────────────────────\n206: \n207: function main(argv) {\n208:   try {\n209:     const opts = parseArgs(argv);\n210:     const registry = readRegistry(process.env.GATE_REGISTRY || DEFAULT_REGISTRY);\n211:     const root = repoRoot(opts.repo || process.cwd());\n212:     const mode = opts.positional[0];\n213:     if (mode === 'list') return list(registry, root, opts);\n214:     if (mode === 'set') return set(registry, root, opts);\n215:     throw new RefusedError('usage: git-hook-gates.cjs list|set ... (see the header)');\n216:   } catch (err) {\n217:     const message = err instanceof RefusedError ? err.message : `unexpected: ${err.message}`;\n218:     process.stderr.write(`git-hook-gates: ${message}\\n`);\n219:     process.stdout.write(`STATUS=FAIL ERROR=\"${message.replace(/\"/g, \"'\")}\"\\n`);\n220:     return 2;\n221:   }\n222: }\n223: \n224: if (require.main === module) process.exitCode = main(process.argv.slice(2));\n225: \n226: module.exports = { main, readRegistry, effective };","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/commands/doctor/scripts/git-hook-gates.cjs, lines 1-226\n1: #!/usr/bin/env node\n2: // ───────────────────────────────────────────────────────────────────\n3: // MODULE: Git Hook Gate Settings\n4: // ───────────────────────────────────────────────────────────────────\n5: 'use strict';\n6: \n7: // Lists and changes the persistent on/off setting of each shipped git hook gate.\n8: //\n9: // WHY THIS EXISTS: every optional gate in the pre-commit, prepare-commit-msg and\n10: // pre-push hooks has a SPECKIT_SKIP_* variable, but a variable lasts one command.\n11: // An operator who never wants a gate had to export it in every shell. The hooks\n12: // now read `speckit.hooks.<key>` from local or global git config through\n13: // lib/gate-config.sh, and this script is the guided way to see and change those\n14: // keys. gates.tsv beside that helper is the one list of gates; this script reads\n15: // it rather than keeping its own, so a new gate appears here when it is registered.\n16: //\n17: // Two kinds of switch are deliberately not settable here. The per-push approvals\n18: // (SPECKIT_ALLOW_REMOTE_PUSH, SPECKIT_ALLOW_MASS_DELETION) are marked\n19: // non-persistable in the registry, because a saved approval would approve every\n20: // later push. The commit-msg hook has no switch at all: its rules live in the sk-git\n21: // templates, and changing them is git-standards.cjs's job.\n22: //\n23: // Dry-run by default: `set` prints the git config commands it would run and the\n24: // resulting effective value, and changes nothing without --apply.\n25: //\n26: // Usage:\n27: //   git-hook-gates.cjs list [--repo <dir>] [--json]\n28: //   git-hook-gates.cjs set <key> on|off [--scope local|global] [--repo <dir>] [--apply] [--json]\n29: //\n30: // Exit 0 on success, 2 on a refused or invalid request (unknown key, a\n31: // non-persistable gate, bad arguments, a missing registry), always with a STATUS= line.\n32: \n33: // ─────────────────────────────────────────────────────────────────────────────\n34: // 1. IMPORTS\n35: // ─────────────────────────────────────────────────────────────────────────────\n36: \n37: const fs = require('node:fs');\n38: const path = require('node:path');\n39: const { execFileSync, spawnSync } = require('node:child_process');\n40: \n41: // ─────────────────────────────────────────────────────────────────────────────\n42: // 2. CONSTANTS\n43: // ─────────────────────────────────────────────────────────────────────────────\n44: \n45: const DEFAULT_REGISTRY = path.resolve(__dirname, '../../../scripts/git-hooks/lib/gates.tsv');\n46: const KEY_PREFIX = 'speckit.hooks.';\n47: const OFF_VALUES = new Set(['off', 'false', 'no', '0']);\n48: const SCOPES = new Set(['local', 'global']);\n49: \n50: class RefusedError extends Error {}\n51: \n52: // ─────────────────────────────────────────────────────────────────────────────\n53: // 3. HELPERS\n54: // ─────────────────────────────────────────────────────────────────────────────\n55: \n56: function parseArgs(argv) {\n57:   const opts = { positional: [], scope: 'local', apply: false, json: false, repo: null };\n58:   for (let i = 0; i < argv.length; i += 1) {\n59:     const arg = argv[i];\n60:     if (arg === '--apply') opts.apply = true;\n61:     else if (arg === '--json') opts.json = true;\n62:     else if (arg === '--scope' || arg === '--repo') {\n63:       const value = argv[i + 1];\n64:       if (value === undefined) throw new RefusedError(`${arg} needs a value`);\n65:       opts[arg.slice(2)] = value;\n66:       i += 1;\n67:     } else if (arg.startsWith('--')) throw new RefusedError(`unknown flag: ${arg}`);\n68:     else opts.positional.push(arg);\n69:   }\n70:   if (!SCOPES.has(opts.scope)) throw new RefusedError(`--scope must be local or global, not ${opts.scope}`);\n71:   return opts;\n72: }\n73: \n74: function readRegistry(file) {\n75:   if (!fs.existsSync(file)) throw new RefusedError(`gate registry not found: ${file}`);\n76:   return fs.readFileSync(file, 'utf8').split('\\n')\n77:     .filter((line) => line.trim() && !line.startsWith('#'))\n78:     .map((line) => {\n79:       const [hook, key, env, persistable, description] = line.split('\\t');\n80:       return { hook, key, env, persistable: persistable === 'yes', description: description || '' };\n81:     });\n82: }\n83: \n84: function repoRoot(dir) {\n85:   try {\n86:     return execFileSync('git', ['-C', dir, 'rev-parse', '--show-toplevel'], { encoding: 'utf8', stdio: ['ignore', 'pipe', 'ignore'] }).trim();\n87:   } catch {\n88:     throw new RefusedError(`not inside a git repository: ${dir}`);\n89:   }\n90: }\n91: \n92: // Every stored value of one key, by scope. Command-line config is dropped because the\n93: // hooks drop it: a `git -c` value never decides a gate, so showing it would mislead.\n94: function storedValues(root, key) {\n95:   const result = spawnSync('git', ['-C', root, 'config', '--show-scope', '--get-all', `${KEY_PREFIX}${key}`], { encoding: 'utf8' });\n96:   const values = [];\n97:   for (const line of (result.stdout || '').split('\\n')) {\n98:     if (!line) continue;\n99:     const tab = line.indexOf('\\t');\n100:     const scope = line.slice(0, tab);\n101:     if (scope === 'command') continue;\n102:     values.push({ scope, value: line.slice(tab + 1) });\n103:   }\n104:   return values;\n105: }\n106: \n107: function effective(values) {\n108:   const last = values[values.length - 1];\n109:   if (!last) return { state: 'on', from: 'default' };\n110:   return { state: OFF_VALUES.has(last.value.toLowerCase()) ? 'off' : 'on', from: `${last.scope} config` };\n111: }\n112: \n113: function valueAt(values, scope) {\n114:   const hits = values.filter((v) => v.scope === scope);\n115:   return hits.length ? hits[hits.length - 1].value : null;\n116: }\n117: \n118: function describe(root, gate) {\n119:   const values = storedValues(root, gate.key);\n120:   return {\n121:     key: gate.key,\n122:     hook: gate.hook,\n123:     env: gate.env,\n124:     persistable: gate.persistable,\n125:     description: gate.description,\n126:     local: valueAt(values, 'local'),\n127:     global: valueAt(values, 'global'),\n128:     effective: gate.persistable ? effective(values) : { state: 'on', from: 'not persistable' },\n129:     envSet: process.env[gate.env] === '1',\n130:   };\n131: }\n132: \n133: // ─────────────────────────────────────────────────────────────────────────────\n134: // 4. MODES\n135: // ─────────────────────────────────────────────────────────────────────────────\n136: \n137: function list(registry, root, opts) {\n138:   const rows = registry.map((gate) => describe(root, gate));\n139:   if (opts.json) {\n140:     process.stdout.write(`${JSON.stringify({ repo: root, gates: rows }, null, 2)}\\n`);\n141:   } else {\n142:     process.stdout.write(`Gate settings for ${root}\\n\\n`);\n143:     process.stdout.write('| Key | Hook | Local | Global | Effective | Bypass variable | What it does |\\n|-----|------|-------|--------|-----------|-----------------|--------------|\\n');\n144:     for (const r of rows) {\n145:       const eff = r.persistable ? `${r.effective.state} (${r.effective.from})` : 'per push only';\n146:       const env = r.envSet ? `${r.env} (set in this shell)` : r.env;\n147:       process.stdout.write(`| ${r.key} | ${r.hook} | ${r.local ?? '-'} | ${r.global ?? '-'} | ${eff} | ${env} | ${r.description} |\\n`);\n148:     }\n149:   }\n150:   const off = rows.filter((r) => r.persistable && r.effective.state === 'off').length;\n151:   process.stdout.write(`STATUS=OK GATES=${rows.length} OFF=${off}\\n`);\n152:   return 0;\n153: }\n154: \n155: function set(registry, root, opts) {\n156:   const [, key, state] = opts.positional;\n157:   if (!key || !state) throw new RefusedError('usage: set <key> on|off [--scope local|global] [--apply]');\n158:   const gate = registry.find((g) => g.key === key);\n159:   if (!gate) throw new RefusedError(`unknown gate key: ${key}. Run list to see the keys.`);\n160:   if (!gate.persistable) {\n161:     throw new RefusedError(`${key} cannot be saved: ${gate.env} approves one push at a time, so set it on that one command only.`);\n162:   }\n163:   if (state !== 'on' && state !== 'off') throw new RefusedError(`state must be on or off, not ${state}`);\n164: \n165:   const values = storedValues(root, key);\n166:   const scopeFlag = `--${opts.scope}`;\n167:   const name = `${KEY_PREFIX}${key}`;\n168:   const commands = [];\n169:   if (state === 'off') {\n170:     commands.push(['config', scopeFlag, '--replace-all', name, 'off']);\n171:   } else if (opts.scope === 'local' && valueAt(values, 'global') !== null && effective(values.filter((v) => v.scope !== 'local')).state === 'off') {\n172:     // A local unset would let the global off decide, so a local on is written explicitly.\n173:     commands.push(['config', '--local', '--replace-all', name, 'on']);\n174:   } else if (valueAt(values, opts.scope) !== null) {\n175:     commands.push(['config', scopeFlag, '--unset-all', name]);\n176:   }\n177: \n178:   const before = effective(values);\n179:   if (opts.apply) {\n180:     for (const args of commands) execFileSync('git', ['-C', root, ...args], { stdio: ['ignore', 'pipe', 'pipe'] });\n181:   }\n182:   const after = opts.apply ? effective(storedValues(root, key)) : null;\n183:   const shown = commands.map((args) => `git ${args.join(' ')}`);\n184:   const note = state === 'on' && opts.scope === 'global' && valueAt(values, 'local') !== null\n185:     && OFF_VALUES.has(String(valueAt(values, 'local')).toLowerCase())\n186:     ? 'local config still switches this gate off in this repository'\n187:     : null;\n188: \n189:   if (opts.json) {\n190:     process.stdout.write(`${JSON.stringify({ repo: root, key, hook: gate.hook, env: gate.env, scope: opts.scope, requested: state, applied: opts.apply, commands: shown, before, after, note }, null, 2)}\\n`);\n191:   } else {\n192:     process.stdout.write(`Gate ${key} (${gate.hook}): ${before.state} (${before.from}) -> requested ${state} in ${opts.scope} config\\n`);\n193:     if (shown.length === 0) process.stdout.write('Nothing to change: no stored value to remove at that scope.\\n');\n194:     for (const cmd of shown) process.stdout.write(`${opts.apply ? 'Ran' : 'Would run'}: ${cmd}\\n`);\n195:     if (after) process.stdout.write(`Now: ${after.state} (${after.from})\\n`);\n196:     if (note) process.stdout.write(`Note: ${note}\\n`);\n197:     if (!opts.apply && shown.length) process.stdout.write('Dry run: nothing changed. Add --apply to write.\\n');\n198:   }\n199:   process.stdout.write(`STATUS=OK MODE=${opts.apply ? 'APPLIED' : 'DRY_RUN'} KEY=${key}\\n`);\n200:   return 0;\n201: }\n202: \n203: // ─────────────────────────────────────────────────────────────────────────────\n204: // 5. MAIN\n205: // ─────────────────────────────────────────────────────────────────────────────\n206: \n207: function main(argv) {\n208:   try {\n209:     const opts = parseArgs(argv);\n210:     const registry = readRegistry(process.env.GATE_REGISTRY || DEFAULT_REGISTRY);\n211:     const root = repoRoot(opts.repo || process.cwd());\n212:     const mode = opts.positional[0];\n213:     if (mode === 'list') return list(registry, root, opts);\n214:     if (mode === 'set') return set(registry, root, opts);\n215:     throw new RefusedError('usage: git-hook-gates.cjs list|set ... (see the header)');\n216:   } catch (err) {\n217:     const message = err instanceof RefusedError ? err.message : `unexpected: ${err.message}`;\n218:     process.stderr.write(`git-hook-gates: ${message}\\n`);\n219:     process.stdout.write(`STATUS=FAIL ERROR=\"${message.replace(/\"/g, \"'\")}\"\\n`);\n220:     return 2;\n221:   }\n222: }\n223: \n224: if (require.main === module) process.exitCode = main(process.argv.slice(2));\n225: \n226: module.exports = { main, readRegistry, effective };"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/commands/doctor/scripts/git-hook-gates.cjs\"}"},"time":{"start":1794527276775,"end":1794527276791}}}}
{"type":"tool_use","timestamp":1794527276797,"sessionID":"ses_e2dd83989ffevoEHqeWn41PhPb","part":{"partID":"prt_1d2292ee80019a0FJR4sXJvk5O","sessionID":"ses_e2dd83989ffevoEHqeWn41PhPb","messageID":"msg_1d2291f320019B6OfznfZbnk1j","type":"tool","id":"call_a48e1a7b18c948e4848b73d3","tool":"read","state":{"status":"completed","input":{"path":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/commands/doctor/scripts/tests/git-hook-gates.test.cjs"},"output":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/commands/doctor/scripts/tests/git-hook-gates.test.cjs, lines 1-106\n1: #!/usr/bin/env node\n2: // ───────────────────────────────────────────────────────────────────\n3: // MODULE: Git Hook Gate Settings Tests\n4: // ───────────────────────────────────────────────────────────────────\n5: 'use strict';\n6: \n7: // Drives the gate settings script as a process against throwaway repositories with\n8: // an isolated global config, and proves the hook helper reads what it writes.\n9: \n10: // ─────────────────────────────────────────────────────────────────────────────\n11: // 1. IMPORTS AND FIXTURES\n12: // ─────────────────────────────────────────────────────────────────────────────\n13: \n14: const assert = require('node:assert/strict');\n15: const { spawnSync, execFileSync } = require('node:child_process');\n16: const fs = require('node:fs');\n17: const os = require('node:os');\n18: const path = require('node:path');\n19: const test = require('node:test');\n20: \n21: const SCRIPT = path.resolve(__dirname, '..', 'git-hook-gates.cjs');\n22: const HELPER = path.resolve(__dirname, '../../../../scripts/git-hooks/lib/gate-config.sh');\n23: \n24: function fixture(t) {\n25:   const dir = fs.mkdtempSync(path.join(os.tmpdir(), 'git-hook-gates-'));\n26:   t.after(() => fs.rmSync(dir, { recursive: true, force: true }));\n27:   const repo = path.join(dir, 'repo');\n28:   const global = path.join(dir, 'global.gitconfig');\n29:   fs.writeFileSync(global, '');\n30:   const env = { ...process.env, GIT_CONFIG_GLOBAL: global, GIT_CONFIG_NOSYSTEM: '1' };\n31:   for (const name of Object.keys(env)) if (/^(GIT_DIR|GIT_WORK_TREE|GIT_CONFIG_COUNT|SPECKIT_SKIP_|SPECKIT_ALLOW_)/.test(name)) delete env[name];\n32:   execFileSync('git', ['init', '-q', repo], { env });\n33:   const run = (...args) => {\n34:     const r = spawnSync(process.execPath, [SCRIPT, ...args, '--repo', repo], { encoding: 'utf8', env });\n35:     return { code: r.status, out: r.stdout, err: r.stderr };\n36:   };\n37:   const config = (...args) => spawnSync('git', ['-C', repo, 'config', ...args], { encoding: 'utf8', env }).stdout.trim();\n38:   return { repo, global, env, run, config };\n39: }\n40: \n41: const gate = (out, key) => JSON.parse(out.slice(0, out.lastIndexOf('STATUS='))).gates.find((g) => g.key === key);\n42: \n43: // ─────────────────────────────────────────────────────────────────────────────\n44: // 2. TESTS\n45: // ─────────────────────────────────────────────────────────────────────────────\n46: \n47: test('list reports every registered gate, all on in a fresh repository', (t) => {\n48:   const f = fixture(t);\n49:   const r = f.run('list');\n50:   assert.equal(r.code, 0);\n51:   assert.match(r.out, /STATUS=OK GATES=16 OFF=0/);\n52:   assert.match(r.out, /\\| cardSync \\| pre-commit \\| - \\| - \\| on \\(default\\) \\|/);\n53:   assert.match(r.out, /\\| remotePush \\| pre-push \\| - \\| - \\| per push only \\|/);\n54: });\n55: \n56: test('set is a dry run until --apply', (t) => {\n57:   const f = fixture(t);\n58:   const dry = f.run('set', 'cardSync', 'off');\n59:   assert.equal(dry.code, 0);\n60:   assert.match(dry.out, /Would run: git config --local --replace-all speckit\\.hooks\\.cardSync off/);\n61:   assert.match(dry.out, /STATUS=OK MODE=DRY_RUN/);\n62:   assert.equal(f.config('--get', 'speckit.hooks.cardSync'), '');\n63: });\n64: \n65: test('an applied off is what the hook helper reads', (t) => {\n66:   const f = fixture(t);\n67:   assert.equal(f.run('set', 'cardSync', 'off', '--apply').code, 0);\n68:   assert.equal(f.config('--local', '--get', 'speckit.hooks.cardSync'), 'off');\n69:   assert.equal(gate(f.run('list', '--json').out, 'cardSync').effective.state, 'off');\n70:   const hook = spawnSync('bash', ['-c', `. \"${HELPER}\"; gate_config_apply pre-commit 2>/dev/null; printf '%s' \"\\${SPECKIT_SKIP_CARD_SYNC:-unset}\"`],\n71:     { cwd: f.repo, encoding: 'utf8', env: f.env });\n72:   assert.equal(hook.stdout, '1');\n73: });\n74: \n75: test('on removes a local off, and writes an explicit local on over a global off', (t) => {\n76:   const f = fixture(t);\n77:   f.run('set', 'specRemint', 'off', '--apply');\n78:   const unset = f.run('set', 'specRemint', 'on', '--apply');\n79:   assert.match(unset.out, /--unset-all speckit\\.hooks\\.specRemint/);\n80:   assert.equal(f.config('--local', '--get', 'speckit.hooks.specRemint'), '');\n81: \n82:   f.run('set', 'specRemint', 'off', '--scope', 'global', '--apply');\n83:   assert.match(fs.readFileSync(f.global, 'utf8'), /specRemint = off/);\n84:   const override = f.run('set', 'specRemint', 'on', '--apply');\n85:   assert.match(override.out, /--local --replace-all speckit\\.hooks\\.specRemint on/);\n86:   assert.deepEqual(gate(f.run('list', '--json').out, 'specRemint').effective, { state: 'on', from: 'local config' });\n87: });\n88: \n89: test('a global on reports that a local off still wins', (t) => {\n90:   const f = fixture(t);\n91:   f.run('set', 'routeRemint', 'off', '--apply');\n92:   f.run('set', 'routeRemint', 'off', '--scope', 'global', '--apply');\n93:   const r = f.run('set', 'routeRemint', 'on', '--scope', 'global', '--apply');\n94:   assert.match(r.out, /local config still switches this gate off/);\n95: });\n96: \n97: test('refuses unknown keys, per-push approvals and bad arguments without writing', (t) => {\n98:   const f = fixture(t);\n99:   for (const args of [['set', 'nope', 'off'], ['set', 'remotePush', 'off'], ['set', 'massDeletion', 'off'],\n100:     ['set', 'cardSync', 'maybe'], ['set', 'cardSync', 'off', '--scope', 'system'], ['frobnicate']]) {\n101:     const r = f.run(...args, '--apply');\n102:     assert.equal(r.code, 2, args.join(' '));\n103:     assert.match(r.out, /STATUS=FAIL/);\n104:   }\n105:   assert.equal(f.config('--get-regexp', '^speckit\\\\.hooks\\\\.'), '');\n106: });","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/commands/doctor/scripts/tests/git-hook-gates.test.cjs, lines 1-106\n1: #!/usr/bin/env node\n2: // ───────────────────────────────────────────────────────────────────\n3: // MODULE: Git Hook Gate Settings Tests\n4: // ───────────────────────────────────────────────────────────────────\n5: 'use strict';\n6: \n7: // Drives the gate settings script as a process against throwaway repositories with\n8: // an isolated global config, and proves the hook helper reads what it writes.\n9: \n10: // ─────────────────────────────────────────────────────────────────────────────\n11: // 1. IMPORTS AND FIXTURES\n12: // ─────────────────────────────────────────────────────────────────────────────\n13: \n14: const assert = require('node:assert/strict');\n15: const { spawnSync, execFileSync } = require('node:child_process');\n16: const fs = require('node:fs');\n17: const os = require('node:os');\n18: const path = require('node:path');\n19: const test = require('node:test');\n20: \n21: const SCRIPT = path.resolve(__dirname, '..', 'git-hook-gates.cjs');\n22: const HELPER = path.resolve(__dirname, '../../../../scripts/git-hooks/lib/gate-config.sh');\n23: \n24: function fixture(t) {\n25:   const dir = fs.mkdtempSync(path.join(os.tmpdir(), 'git-hook-gates-'));\n26:   t.after(() => fs.rmSync(dir, { recursive: true, force: true }));\n27:   const repo = path.join(dir, 'repo');\n28:   const global = path.join(dir, 'global.gitconfig');\n29:   fs.writeFileSync(global, '');\n30:   const env = { ...process.env, GIT_CONFIG_GLOBAL: global, GIT_CONFIG_NOSYSTEM: '1' };\n31:   for (const name of Object.keys(env)) if (/^(GIT_DIR|GIT_WORK_TREE|GIT_CONFIG_COUNT|SPECKIT_SKIP_|SPECKIT_ALLOW_)/.test(name)) delete env[name];\n32:   execFileSync('git', ['init', '-q', repo], { env });\n33:   const run = (...args) => {\n34:     const r = spawnSync(process.execPath, [SCRIPT, ...args, '--repo', repo], { encoding: 'utf8', env });\n35:     return { code: r.status, out: r.stdout, err: r.stderr };\n36:   };\n37:   const config = (...args) => spawnSync('git', ['-C', repo, 'config', ...args], { encoding: 'utf8', env }).stdout.trim();\n38:   return { repo, global, env, run, config };\n39: }\n40: \n41: const gate = (out, key) => JSON.parse(out.slice(0, out.lastIndexOf('STATUS='))).gates.find((g) => g.key === key);\n42: \n43: // ─────────────────────────────────────────────────────────────────────────────\n44: // 2. TESTS\n45: // ─────────────────────────────────────────────────────────────────────────────\n46: \n47: test('list reports every registered gate, all on in a fresh repository', (t) => {\n48:   const f = fixture(t);\n49:   const r = f.run('list');\n50:   assert.equal(r.code, 0);\n51:   assert.match(r.out, /STATUS=OK GATES=16 OFF=0/);\n52:   assert.match(r.out, /\\| cardSync \\| pre-commit \\| - \\| - \\| on \\(default\\) \\|/);\n53:   assert.match(r.out, /\\| remotePush \\| pre-push \\| - \\| - \\| per push only \\|/);\n54: });\n55: \n56: test('set is a dry run until --apply', (t) => {\n57:   const f = fixture(t);\n58:   const dry = f.run('set', 'cardSync', 'off');\n59:   assert.equal(dry.code, 0);\n60:   assert.match(dry.out, /Would run: git config --local --replace-all speckit\\.hooks\\.cardSync off/);\n61:   assert.match(dry.out, /STATUS=OK MODE=DRY_RUN/);\n62:   assert.equal(f.config('--get', 'speckit.hooks.cardSync'), '');\n63: });\n64: \n65: test('an applied off is what the hook helper reads', (t) => {\n66:   const f = fixture(t);\n67:   assert.equal(f.run('set', 'cardSync', 'off', '--apply').code, 0);\n68:   assert.equal(f.config('--local', '--get', 'speckit.hooks.cardSync'), 'off');\n69:   assert.equal(gate(f.run('list', '--json').out, 'cardSync').effective.state, 'off');\n70:   const hook = spawnSync('bash', ['-c', `. \"${HELPER}\"; gate_config_apply pre-commit 2>/dev/null; printf '%s' \"\\${SPECKIT_SKIP_CARD_SYNC:-unset}\"`],\n71:     { cwd: f.repo, encoding: 'utf8', env: f.env });\n72:   assert.equal(hook.stdout, '1');\n73: });\n74: \n75: test('on removes a local off, and writes an explicit local on over a global off', (t) => {\n76:   const f = fixture(t);\n77:   f.run('set', 'specRemint', 'off', '--apply');\n78:   const unset = f.run('set', 'specRemint', 'on', '--apply');\n79:   assert.match(unset.out, /--unset-all speckit\\.hooks\\.specRemint/);\n80:   assert.equal(f.config('--local', '--get', 'speckit.hooks.specRemint'), '');\n81: \n82:   f.run('set', 'specRemint', 'off', '--scope', 'global', '--apply');\n83:   assert.match(fs.readFileSync(f.global, 'utf8'), /specRemint = off/);\n84:   const override = f.run('set', 'specRemint', 'on', '--apply');\n85:   assert.match(override.out, /--local --replace-all speckit\\.hooks\\.specRemint on/);\n86:   assert.deepEqual(gate(f.run('list', '--json').out, 'specRemint').effective, { state: 'on', from: 'local config' });\n87: });\n88: \n89: test('a global on reports that a local off still wins', (t) => {\n90:   const f = fixture(t);\n91:   f.run('set', 'routeRemint', 'off', '--apply');\n92:   f.run('set', 'routeRemint', 'off', '--scope', 'global', '--apply');\n93:   const r = f.run('set', 'routeRemint', 'on', '--scope', 'global', '--apply');\n94:   assert.match(r.out, /local config still switches this gate off/);\n95: });\n96: \n97: test('refuses unknown keys, per-push approvals and bad arguments without writing', (t) => {\n98:   const f = fixture(t);\n99:   for (const args of [['set', 'nope', 'off'], ['set', 'remotePush', 'off'], ['set', 'massDeletion', 'off'],\n100:     ['set', 'cardSync', 'maybe'], ['set', 'cardSync', 'off', '--scope', 'system'], ['frobnicate']]) {\n101:     const r = f.run(...args, '--apply');\n102:     assert.equal(r.code, 2, args.join(' '));\n103:     assert.match(r.out, /STATUS=FAIL/);\n104:   }\n105:   assert.equal(f.config('--get-regexp', '^speckit\\\\.hooks\\\\.'), '');\n106: });"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/commands/doctor/scripts/tests/git-hook-gates.test.cjs\"}"},"time":{"start":1794527276776,"end":1794527276797}}}}
