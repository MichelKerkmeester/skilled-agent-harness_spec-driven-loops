.md\n.opencode/skills/sk-code/sk-code-skilled/assets/checklists/rust-checklist/p0-safety-and-boundary-discipline.md\n.opencode/skills/sk-code/sk-code-skilled/assets/checklists/rust-checklist/p1-required.md\n.opencode/skills/sk-code/sk-code-skilled/assets/checklists/rust-checklist/p2-evidence-validation-and-resources.md\n.opencode/skills/sk-code/sk-code-skilled/assets/checklists/shell-checklist.md\n.opencode/skills/sk-code/sk-code-skilled/assets/checklists/skill-authoring.md\n.opencode/skills/sk-code/sk-code-skilled/assets/checklists/typescript-checklist.md\n.opencode/skills/sk-code/sk-code-skilled/assets/checklists/universal-checklist.md\n.opencode/skills/sk-code/sk-code-skilled/references/config/quality-standards.md\n.opencode/skills/sk-code/sk-code-skilled/references/config/quick-reference.md\n.opencode/skills/sk-code/sk-code-skilled/references/config/style-guide.md\n.opencode/skills/sk-code/sk-code-skilled/references/javascript/quick-reference.md\n.opencode/skills/sk-code/sk-code-skilled/references/javascript/style-guide.md\n.opencode/skills/sk-code/sk-code-skilled/references/python/quality-standards.md\n.opencode/skills/sk-code/sk-code-skilled/references/python/quick-reference.md\n.opencode/skills/sk-code/sk-code-skilled/references/python/style-guide.md\n.opencode/skills/sk-code/sk-code-skilled/references/shared/alignment-verification-automation.md\n.opencode/skills/sk-code/sk-code-skilled/references/shared/hooks.md\n.opencode/skills/sk-code/sk-code-skilled/references/shared/workflow-guardrails.md\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":".opencode/skills/sk-code/shared/references/phase-detection.md\n.opencode/skills/sk-code/shared/references/stack-detection.md\n.opencode/skills/sk-code/shared/references/universal/code-quality-standards.md\n.opencode/skills/sk-code/shared/references/universal/rule-overrides.json\n.opencode/skills/sk-code/shared/references/universal/rule-overrides.md\n.opencode/skills/sk-code/shared/references/workflow-debug.md\n.opencode/skills/sk-code/shared/references/workflow-implement.md\n.opencode/skills/sk-code/shared/references/workflow-verify.md\n.opencode/skills/sk-code/sk-code-skilled/assets/checklists/agent-authoring.md\n.opencode/skills/sk-code/sk-code-skilled/assets/checklists/command-authoring.md\n.opencode/skills/sk-code/sk-code-skilled/assets/checklists/config-checklist.md\n.opencode/skills/sk-code/sk-code-skilled/assets/checklists/javascript-checklist.md\n.opencode/skills/sk-code/sk-code-skilled/assets/checklists/js-css-style/naming-init-formatting-and-css.md\n.opencode/skills/sk-code/sk-code-skilled/assets/checklists/js-css-style/overview-header-and-comments.md\n.opencode/skills/sk-code/sk-code-skilled/assets/checklists/js-css-style/verification-quick-reference-and-related.md\n.opencode/skills/sk-code/sk-code-skilled/assets/checklists/mcp-server-authoring.md\n.opencode/skills/sk-code/sk-code-skilled/assets/checklists/python-checklist.md\n.opencode/skills/sk-code/sk-code-skilled/assets/checklists/rust-checklist/overview-and-p0-parity.md\n.opencode/skills/sk-code/sk-code-skilled/assets/checklists/rust-checklist/p0-safety-and-boundary-discipline.md\n.opencode/skills/sk-code/sk-code-skilled/assets/checklists/rust-checklist/p1-required.md\n.opencode/skills/sk-code/sk-code-skilled/assets/checklists/rust-checklist/p2-evidence-validation-and-resources.md\n.opencode/skills/sk-code/sk-code-skilled/assets/checklists/shell-checklist.md\n.opencode/skills/sk-code/sk-code-skilled/assets/checklists/skill-authoring.md\n.opencode/skills/sk-code/sk-code-skilled/assets/checklists/typescript-checklist.md\n.opencode/skills/sk-code/sk-code-skilled/assets/checklists/universal-checklist.md\n.opencode/skills/sk-code/sk-code-skilled/references/config/quality-standards.md\n.opencode/skills/sk-code/sk-code-skilled/references/config/quick-reference.md\n.opencode/skills/sk-code/sk-code-skilled/references/config/style-guide.md\n.opencode/skills/sk-code/sk-code-skilled/references/javascript/quick-reference.md\n.opencode/skills/sk-code/sk-code-skilled/references/javascript/style-guide.md\n.opencode/skills/sk-code/sk-code-skilled/references/python/quality-standards.md\n.opencode/skills/sk-code/sk-code-skilled/references/python/quick-reference.md\n.opencode/skills/sk-code/sk-code-skilled/references/python/style-guide.md\n.opencode/skills/sk-code/sk-code-skilled/references/shared/alignment-verification-automation.md\n.opencode/skills/sk-code/sk-code-skilled/references/shared/hooks.md\n.opencode/skills/sk-code/sk-code-skilled/references/shared/workflow-guardrails.md\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"find .opencode/skills/sk-code/shared/references .opencode/skills/sk-code/sk-code-skilled/references .opencode/skills/sk-code/sk-code-skilled/assets/checklists -maxdepth 2 -type f | sort\"}"},"time":{"start":1794527405422,"end":1794527405895}}}}
