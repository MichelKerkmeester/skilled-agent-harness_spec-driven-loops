{"type":"tool_use","timestamp":1794527464112,"sessionID":"ses_e2dd83989ffevoEHqeWn41PhPb","part":{"partID":"prt_1d22bf8170016NBTiSbDzBpsDB","sessionID":"ses_e2dd83989ffevoEHqeWn41PhPb","messageID":"msg_1d22bebeb001ED5Db0w3zVeyyj","type":"tool","id":"call_e3ac318e67b44f29b2885d5a","tool":"write","state":{"status":"completed","input":{"content":"#!/usr/bin/env node\n// ───────────────────────────────────────────────────────────────────\n// MODULE: Hook Wiring Check Tests\n// ───────────────────────────────────────────────────────────────────\n'use strict';\n\n// Drives the hook wiring check as a process against throwaway checkouts. The\n// cases pin both verdicts and the checkout that has no runtime folder at all.\n\n// ─────────────────────────────────────────────────────────────────────────────\n// 1. IMPORTS AND FIXTURES\n// ─────────────────────────────────────────────────────────────────────────────\n\nconst assert = require('node:assert/strict');\nconst { spawnSync } = require('node:child_process');\nconst fs = require('node:fs');\nconst os = require('node:os');\nconst path = require('node:path');\nconst test = require('node:test');\n\nconst SCRIPT = path.resolve(__dirname, '..', 'hook-wiring-check.cjs');\nconst CLAUDE_FILE = '.claude/settings.json';\nconst CLAUDE_MARKER = '.skilled/skills/system-spec-kit/runtime/dist/hooks/claude/user-prompt-submit.js';\n\nfunction fixture(t) {\n  const root = fs.mkdtempSync(path.join(os.tmpdir(), 'hook-wiring-check-'));\n  t.after(() => fs.rmSync(root, { recursive: true, force: true }));\n  const run = (...args) => {\n    const result = spawnSync(process.execPath, [SCRIPT, '--root', root, ...args], { encoding: 'utf8' });\n    return { code: result.status, out: result.stdout, err: result.stderr };\n  };\n  return { root, run };\n}\n\nfunction writeClaudeSettings(root, hooks) {\n  fs.mkdirSync(path.join(root, '.claude'), { recursive: true });\n  fs.writeFileSync(path.join(root, CLAUDE_FILE), JSON.stringify({ hooks }, null, 2));\n}\n\n// ─────────────────────────────────────────────────────────────────────────────\n// 2. TESTS\n// ─────────────────────────────────────────────────────────────────────────────\n\ntest('names a runtime whose prompt entry is absent', (t) => {\n  const f = fixture(t);\n  writeClaudeSettings(f.root, {\n    UserPromptSubmit: [{ hooks: [{ type: 'command', command: 'node some-other-hook.js' }] }],\n  });\n  const before = fs.readFileSync(path.join(f.root, CLAUDE_FILE), 'utf8');\n  const result = f.run();\n  assert.equal(result.code, 1);\n  assert.match(result.out, /^hook-missing claude \\.claude\\/settings\\.json$/m);\n  assert.equal(fs.readFileSync(path.join(f.root, CLAUDE_FILE), 'utf8'), before, 'check changed the hook file');\n});\n\ntest('passes a runtime whose prompt entry is wired', (t) => {\n  const f = fixture(t);\n  writeClaudeSettings(f.root, {\n    UserPromptSubmit: [{\n      hooks: [{ type: 'command', command: `node ${CLAUDE_MARKER}` }],\n    }],\n  });\n  const text = f.run();\n  assert.equal(text.code, 0);\n  assert.equal(text.out.trim(), 'ok claude');\n  const json = f.run('--json');\n  assert.equal(json.code, 0);\n  assert.equal(JSON.parse(json.out).checks.find((check) => check.runtime === 'claude').status, 'ok');\n});\n\ntest('skips a runtime whose folder is absent', (t) => {\n  const f = fixture(t);\n  const text = f.run();\n  assert.equal(text.code, 0);\n  assert.equal(text.out, '');\n  const json = f.run('--json');\n  assert.equal(json.code, 0);\n  assert.deepEqual(JSON.parse(json.out).checks.map((check) => check.status), ['skipped', 'skipped', 'skipped', 'skipped']);\n});\n","path":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/commands/doctor/scripts/tests/hook-wiring-check.test.cjs"},"output":"Created file successfully: .skilled/commands/doctor/scripts/tests/hook-wiring-check.test.cjs","title":"write","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Created file successfully: .skilled/commands/doctor/scripts/tests/hook-wiring-check.test.cjs"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"content\":\"#!/usr/bin/env node\\n// ───────────────────────────────────────────────────────────────────\\n// MODULE: Hook Wiring Check Tests\\n// ───────────────────────────────────────────────────────────────────\\n'use strict';\\n\\n// Drives the hook wiring check as a process against throwaway checkouts. The\\n// cases pin both verdicts and the checkout that has no runtime folder at all.\\n\\n// ─────────────────────────────────────────────────────────────────────────────\\n// 1. IMPORTS AND FIXTURES\\n// ─────────────────────────────────────────────────────────────────────────────\\n\\nconst assert = require('node:assert/strict');\\nconst { spawnSync } = require('node:child_process');\\nconst fs = require('node:fs');\\nconst os = require('node:os');\\nconst path = require('node:path');\\nconst test = require('node:test');\\n\\nconst SCRIPT = path.resolve(__dirname, '..', 'hook-wiring-check.cjs');\\nconst CLAUDE_FILE = '.claude/settings.json';\\nconst CLAUDE_MARKER = '.skilled/skills/system-spec-kit/runtime/dist/hooks/claude/user-prompt-submit.js';\\n\\nfunction fixture(t) {\\n  const root = fs.mkdtempSync(path.join(os.tmpdir(), 'hook-wiring-check-'));\\n  t.after(() => fs.rmSync(root, { recursive: true, force: true }));\\n  const run = (...args) => {\\n    const result = spawnSync(process.execPath, [SCRIPT, '--root', root, ...args], { encoding: 'utf8' });\\n    return { code: result.status, out: result.stdout, err: result.stderr };\\n  };\\n  return { root, run };\\n}\\n\\nfunction writeClaudeSettings(root, hooks) {\\n  fs.mkdirSync(path.join(root, '.claude'), { recursive: true });\\n  fs.writeFileSync(path.join(root, CLAUDE_FILE), JSON.stringify({ hooks }, null, 2));\\n}\\n\\n// ─────────────────────────────────────────────────────────────────────────────\\n// 2. TESTS\\n// ─────────────────────────────────────────────────────────────────────────────\\n\\ntest('names a runtime whose prompt entry is absent', (t) => {\\n  const f = fixture(t);\\n  writeClaudeSettings(f.root, {\\n    UserPromptSubmit: [{ hooks: [{ type: 'command', command: 'node some-other-hook.js' }] }],\\n  });\\n  const before = fs.readFileSync(path.join(f.root, CLAUDE_FILE), 'utf8');\\n  const result = f.run();\\n  assert.equal(result.code, 1);\\n  assert.match(result.out, /^hook-missing claude \\\\.claude\\\\/settings\\\\.json$/m);\\n  assert.equal(fs.readFileSync(path.join(f.root, CLAUDE_FILE), 'utf8'), before, 'check changed the hook file');\\n});\\n\\ntest('passes a runtime whose prompt entry is wired', (t) => {\\n  const f = fixture(t);\\n  writeClaudeSettings(f.root, {\\n    UserPromptSubmit: [{\\n      hooks: [{ type: 'command', command: `node ${CLAUDE_MARKER}` }],\\n    }],\\n  });\\n  const text = f.run();\\n  assert.equal(text.code, 0);\\n  assert.equal(text.out.trim(), 'ok claude');\\n  const json = f.run('--json');\\n  assert.equal(json.code, 0);\\n  assert.equal(JSON.parse(json.out).checks.find((check) => check.runtime === 'claude').status, 'ok');\\n});\\n\\ntest('skips a runtime whose folder is absent', (t) => {\\n  const f = fixture(t);\\n  const text = f.run();\\n  assert.equal(text.code, 0);\\n  assert.equal(text.out, '');\\n  const json = f.run('--json');\\n  assert.equal(json.code, 0);\\n  assert.deepEqual(JSON.parse(json.out).checks.map((check) => check.status), ['skipped', 'skipped', 'skipped', 'skipped']);\\n});\\n\",\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/commands/doctor/scripts/tests/hook-wiring-check.test.cjs\"}"},"time":{"start":1794527459351,"end":1794527464112}}}}
