l-advisor/runtime/scripts/command-bridges/derive-command-bridges.cjs\n M .skilled/skills/system-skill-advisor/runtime/scripts/command-bridges/scoring-compatibility.json\n M .skilled/skills/system-skill-advisor/runtime/scripts/fixtures/gate2-golden-prompts.jsonl\n M .skilled/skills/system-skill-advisor/runtime/scripts/fixtures/skill-advisor-regression-cases.jsonl\n M .skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/holdout-prompts.jsonl\n M .skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/run-command-behaviour.mjs\n M .skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/score-command-transcripts.mjs\n M .skilled/skills/system-skill-advisor/runtime/scripts/skill_advisor.py\n M .skilled/skills/system-skill-advisor/runtime/skill-advisor-cli.ts\n M .skilled/skills/system-skill-advisor/runtime/tests/command-transcript-score.vitest.ts\n M .skilled/skills/system-skill-advisor/runtime/tests/doctor-brief-render.vitest.ts\n M .skilled/skills/system-skill-advisor/runtime/tests/doctor-command-bridges.vitest.ts\n M .skilled/skills/system-skill-advisor/runtime/tests/hooks/skill-advisor-cli-fallback-envelope.vitest.ts\n M .skilled/skills/system-skill-advisor/runtime/tests/parity/fixtures/local-native-approved-divergences.json\n M .skilled/skills/system-skill-advisor/runtime/tests/schemas/advisor-tool-schemas.vitest.ts\n M .skilled/skills/system-skill-advisor/runtime/tests/scorer/same-owner-ambiguity.vitest.ts\n M INSTALL-SKILLED.md\n M specs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/005-recommendation-contract-and-brief/graph-metadata.json\n M specs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/005-recommendation-contract-and-brief/tasks.md\n M specs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/006-gate-2-binding-and-runtime-pointers/graph-metadata.json\n M specs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/007-per-runtime-behaviour-proof/graph-metadata.json\n M specs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/008-embedder-setup-and-cost/graph-metadata.json\n M specs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/goal.md\n M specs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/graph-metadata.json\n M specs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/spec.md\n?? .skilled/commands/doctor/scripts/codex-hook-approval-check.cjs\n?? .skilled/commands/doctor/scripts/hook-wiring-check.cjs\n?? .skilled/commands/doctor/scripts/tests/codex-hook-approval-check.test.cjs\n?? .skilled/commands/doctor/scripts/tests/hook-wiring-check.test.cjs\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":" M .dsh/plugins/repo-guards/README.md\n M .dsh/plugins/repo-guards/adapters/README.md\n M .dsh/plugins/repo-guards/index.mjs\n M .dsh/plugins/repo-guards/tests/bundle.test.mjs\n M .skilled/commands/doctor/assets/doctor-runtime-mirrors.yaml\n M .skilled/commands/doctor/assets/doctor-symlink-check.yaml\n M .skilled/commands/doctor/scripts/README.markdown\n M .skilled/skills/sk-doc/sk-create-skill/scripts/ci-router-vocabulary-reach.cjs\n M .skilled/skills/sk-doc/sk-create-skill/scripts/tests/ci-router-vocabulary-reach.test.cjs\n M .skilled/skills/system-skill-advisor/hooks/lib/skill-advisor-cli-fallback.ts\n M .skilled/skills/system-skill-advisor/runtime/handlers/advisor-recommend.ts\n M .skilled/skills/system-skill-advisor/runtime/lib/command-attach.ts\n M .skilled/skills/system-skill-advisor/runtime/lib/render.ts\n M .skilled/skills/system-skill-advisor/runtime/lib/scorer/fusion.ts\n M .skilled/skills/system-skill-advisor/runtime/lib/scorer/lanes/explicit.ts\n M .skilled/skills/system-skill-advisor/runtime/lib/scorer/projection.ts\n M .skilled/skills/system-skill-advisor/runtime/lib/scorer/scoring-constants.ts\n M .skilled/skills/system-skill-advisor/runtime/lib/subprocess.ts\n M .skilled/skills/system-skill-advisor/runtime/schemas/advisor-tool-schemas.ts\n D .skilled/skills/system-skill-advisor/runtime/scripts/command-bridges/allow-list.json\n M .skilled/skills/system-skill-advisor/runtime/scripts/command-bridges/command-bridges.generated.json\n M .skilled/skills/system-skill-advisor/runtime/scripts/command-bridges/derive-command-bridges.cjs\n M .skilled/skills/system-skill-advisor/runtime/scripts/command-bridges/scoring-compatibility.json\n M .skilled/skills/system-skill-advisor/runtime/scripts/fixtures/gate2-golden-prompts.jsonl\n M .skilled/skills/system-skill-advisor/runtime/scripts/fixtures/skill-advisor-regression-cases.jsonl\n M .skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/holdout-prompts.jsonl\n M .skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/run-command-behaviour.mjs\n M .skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/score-command-transcripts.mjs\n M .skilled/skills/system-skill-advisor/runtime/scripts/skill_advisor.py\n M .skilled/skills/system-skill-advisor/runtime/skill-advisor-cli.ts\n M .skilled/skills/system-skill-advisor/runtime/tests/command-transcript-score.vitest.ts\n M .skilled/skills/system-skill-advisor/runtime/tests/doctor-brief-render.vitest.ts\n M .skilled/skills/system-skill-advisor/runtime/tests/doctor-command-bridges.vitest.ts\n M .skilled/skills/system-skill-advisor/runtime/tests/hooks/skill-advisor-cli-fallback-envelope.vitest.ts\n M .skilled/skills/system-skill-advisor/runtime/tests/parity/fixtures/local-native-approved-divergences.json\n M .skilled/skills/system-skill-advisor/runtime/tests/schemas/advisor-tool-schemas.vitest.ts\n M .skilled/skills/system-skill-advisor/runtime/tests/scorer/same-owner-ambiguity.vitest.ts\n M INSTALL-SKILLED.md\n M specs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/005-recommendation-contract-and-brief/graph-metadata.json\n M specs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/005-recommendation-contract-and-brief/tasks.md\n M specs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/006-gate-2-binding-and-runtime-pointers/graph-metadata.json\n M specs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/007-per-runtime-behaviour-proof/graph-metadata.json\n M specs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/008-embedder-setup-and-cost/graph-metadata.json\n M specs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/goal.md\n M specs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/graph-metadata.json\n M specs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/spec.md\n?? .skilled/commands/doctor/scripts/codex-hook-approval-check.cjs\n?? .skilled/commands/doctor/scripts/hook-wiring-check.cjs\n?? .skilled/commands/doctor/scripts/tests/codex-hook-approval-check.test.cjs\n?? .skilled/commands/doctor/scripts/tests/hook-wiring-check.test.cjs\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"git -c core.fsmonitor=false status --porcelain | head -50\",\"workdir\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research\"}"},"time":{"start":1794529063645,"end":1794529064629}}}}
