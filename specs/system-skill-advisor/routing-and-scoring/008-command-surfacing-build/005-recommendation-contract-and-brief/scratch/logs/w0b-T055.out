)\n24:     .replace(/\\s+/g, ' ')\n25:     .trim()\n26:     .toLowerCase();\n27: }\n28: \n29: export function tokenize(value: string, includeStopWords = false): string[] {\n30:   const tokens = Array.from(value.toLowerCase().matchAll(/\\b\\w+\\b/g), (match) => match[0]);\n31:   return includeStopWords\n32:     ? tokens\n33:     : tokens.filter((token) => token.length > 1 && !STOP_WORDS.has(token));\n34: }\n35: \n36: // A typed slash command such as \"/deep:research\" or \"/speckit:plan\".\n37: const SLASH_COMMAND = /(?:^|[^\\w/])\\/[a-z][\\w-]*:[\\w-]+/i;\n38: // The execution-mode suffixes the command docs accept after a slash command,\n39: // either attached (\"/speckit:plan:auto\") or as its own argument (\":auto\").\n40: // They choose how the command runs, not what it is about, so they are not\n41: // prompt content. The \":with-*\" modifiers are left alone: their words name\n42: // extra work (research, phases) and can carry intent.\n43: const COMMAND_MODE_SUFFIX = /:(?:auto|confirm|autopilot|unattended)(?![\\w-])/gi;\n44: \n45: export function stripCommandModeSuffixes(prompt: string): string {\n46:   const command = SLASH_COMMAND.exec(prompt);\n47:   if (!command) return prompt;\n48:   return prompt.slice(0, command.index) + prompt.slice(command.index).replace(COMMAND_MODE_SUFFIX, ' ');\n49: }\n50: \n51: // Tokenize a user prompt. Skill-side text goes through tokenize() unchanged.\n52: export function tokenizePrompt(prompt: string, includeStopWords = false): string[] {\n53:   return tokenize(stripCommandModeSuffixes(prompt), includeStopWords);\n54: }\n55: \n56: export function unique<T>(values: readonly T[]): T[] {\n57:   return [...new Set(values)];\n58: }\n59: \n60: export function phraseVariants(value: string): string[] {\n61:   const lowered = value.trim().toLowerCase();\n62:   if (!lowered) return [];\n63:   return unique([\n64:     lowered,\n65:     lowered.replace(/-/g, ' '),\n66:     lowered.replace(/_/g, ' '),\n67:     lowered.replace(/-/g, '_'),\n68:     normalizeText(lowered),\n69:   ].filter(Boolean));\n70: }\n71: \n72: export function skillNameVariants(skillId: string | null | undefined): string[] {\n73:   if (typeof skillId !== 'string' || skillId.trim().length === 0) return [];\n74:   const base = skillId.toLowerCase();\n75:   return unique([\n76:     base,\n77:     `$${base}`,\n78:     `/${base}`,\n79:     base.replace(/-/g, ' '),\n80:     base.replace(/-/g, '_'),\n81:   ]);\n82: }\n83: \n84: export function matchesPhraseBoundary(text: string, phrase: string): boolean {\n85:   const normalizedPhrase = phrase.trim().toLowerCase();\n86:   if (!normalizedPhrase) return false;\n87:   const escaped = normalizedPhrase.replace(/[.*+?^${}()|[\\]\\\\]/g, '\\\\$&');\n88:   return new RegExp(`(?<!\\\\w)${escaped}(?!\\\\w)`).test(text);\n89: }\n90: \n[Output truncated. Continue reading with offset: 91]","title":"read","metadata":{"metadata":{"truncated":true},"content":[{"type":"text","text":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/lib/scorer/text.ts, lines 1-90\n1: // ───────────────────────────────────────────────────────────────\n2: // MODULE: Advisor Scorer Text Utilities\n3: // ───────────────────────────────────────────────────────────────\n4: \n5: const STOP_WORDS = new Set([\n6:   'a', 'about', 'able', 'actually', 'agent', 'all', 'also', 'an', 'and', 'any',\n7:   'are', 'as', 'at', 'be', 'been', 'being', 'but', 'by', 'can', 'could', 'did',\n8:   'do', 'does', 'even', 'for', 'from', 'get', 'give', 'go', 'going', 'had',\n9:   'has', 'have', 'he', 'help', 'her', 'him', 'how', 'i', 'if', 'in', 'into',\n10:   'is', 'it', 'its', 'just', 'let', 'like', 'may', 'me', 'might', 'more',\n11:   'most', 'must', 'my', 'need', 'no', 'not', 'now', 'of', 'on', 'only', 'or',\n12:   'other', 'our', 'please', 'really', 'she', 'should', 'skill', 'skills',\n13:   'so', 'some', 'tell', 'that', 'the', 'them', 'then', 'these', 'they',\n14:   'thing', 'things', 'this', 'those', 'to', 'tool', 'try', 'us',\n15:   'used', 'using', 'very', 'want', 'was', 'way', 'we', 'were', 'what', 'when',\n16:   'where', 'which', 'who', 'why', 'will', 'with', 'would', 'you', 'your',\n17: ]);\n18: \n19: export function normalizeText(value: string): string {\n20:   return value\n21:     .replace(/([a-z])([A-Z])/g, '$1 $2')\n22:     .replace(/[_./-]+/g, ' ')\n23:     .replace(/[^A-Za-z0-9:/`'\". ]+/g, ' ')\n24:     .replace(/\\s+/g, ' ')\n25:     .trim()\n26:     .toLowerCase();\n27: }\n28: \n29: export function tokenize(value: string, includeStopWords = false): string[] {\n30:   const tokens = Array.from(value.toLowerCase().matchAll(/\\b\\w+\\b/g), (match) => match[0]);\n31:   return includeStopWords\n32:     ? tokens\n33:     : tokens.filter((token) => token.length > 1 && !STOP_WORDS.has(token));\n34: }\n35: \n36: // A typed slash command such as \"/deep:research\" or \"/speckit:plan\".\n37: const SLASH_COMMAND = /(?:^|[^\\w/])\\/[a-z][\\w-]*:[\\w-]+/i;\n38: // The execution-mode suffixes the command docs accept after a slash command,\n39: // either attached (\"/speckit:plan:auto\") or as its own argument (\":auto\").\n40: // They choose how the command runs, not what it is about, so they are not\n41: // prompt content. The \":with-*\" modifiers are left alone: their words name\n42: // extra work (research, phases) and can carry intent.\n43: const COMMAND_MODE_SUFFIX = /:(?:auto|confirm|autopilot|unattended)(?![\\w-])/gi;\n44: \n45: export function stripCommandModeSuffixes(prompt: string): string {\n46:   const command = SLASH_COMMAND.exec(prompt);\n47:   if (!command) return prompt;\n48:   return prompt.slice(0, command.index) + prompt.slice(command.index).replace(COMMAND_MODE_SUFFIX, ' ');\n49: }\n50: \n51: // Tokenize a user prompt. Skill-side text goes through tokenize() unchanged.\n52: export function tokenizePrompt(prompt: string, includeStopWords = false): string[] {\n53:   return tokenize(stripCommandModeSuffixes(prompt), includeStopWords);\n54: }\n55: \n56: export function unique<T>(values: readonly T[]): T[] {\n57:   return [...new Set(values)];\n58: }\n59: \n60: export function phraseVariants(value: string): string[] {\n61:   const lowered = value.trim().toLowerCase();\n62:   if (!lowered) return [];\n63:   return unique([\n64:     lowered,\n65:     lowered.replace(/-/g, ' '),\n66:     lowered.replace(/_/g, ' '),\n67:     lowered.replace(/-/g, '_'),\n68:     normalizeText(lowered),\n69:   ].filter(Boolean));\n70: }\n71: \n72: export function skillNameVariants(skillId: string | null | undefined): string[] {\n73:   if (typeof skillId !== 'string' || skillId.trim().length === 0) return [];\n74:   const base = skillId.toLowerCase();\n75:   return unique([\n76:     base,\n77:     `$${base}`,\n78:     `/${base}`,\n79:     base.replace(/-/g, ' '),\n80:     base.replace(/-/g, '_'),\n81:   ]);\n82: }\n83: \n84: export function matchesPhraseBoundary(text: string, phrase: string): boolean {\n85:   const normalizedPhrase = phrase.trim().toLowerCase();\n86:   if (!normalizedPhrase) return false;\n87:   const escaped = normalizedPhrase.replace(/[.*+?^${}()|[\\]\\\\]/g, '\\\\$&');\n88:   return new RegExp(`(?<!\\\\w)${escaped}(?!\\\\w)`).test(text);\n89: }\n90: \n[Output truncated. Continue reading with offset: 91]"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/lib/scorer/text.ts\",\"offset\":1,\"limit\":90}"},"time":{"start":1794522578748,"end":1794522578764}}}}
