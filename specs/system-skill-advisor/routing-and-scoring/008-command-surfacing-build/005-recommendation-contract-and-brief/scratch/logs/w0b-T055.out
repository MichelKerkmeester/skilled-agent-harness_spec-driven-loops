───────────────────────────────────────────────────────────────────\n1395: // 8. HELPERS\n1396: // ───────────────────────────────────────────────────────────────────\n1397: \n1398: function sqliteTableExists(db: Database.Database, tableName: string): boolean {\n1399:   const row = db.prepare(`\n1400:     SELECT 1 AS present\n1401:     FROM sqlite_master\n1402:     WHERE type = 'table' AND name = ?\n1403:     LIMIT 1\n1404:   `).get(tableName) as { present: number } | undefined;\n1405:   return Boolean(row);\n1406: }\n1407: \n1408: function readMetadataMap(db: Database.Database): Map<string, string> {\n1409:   if (!sqliteTableExists(db, 'vec_metadata')) return new Map();\n1410:   const rows = db.prepare(`\n1411:     SELECT key, value\n1412:     FROM vec_metadata\n1413:     WHERE key IN (?, ?, ?)\n1414:   `).all(ACTIVE_EMBEDDER_NAME_KEY, ACTIVE_EMBEDDER_DIM_KEY, ACTIVE_EMBEDDER_PROVIDER_KEY) as MetadataRow[];\n1415:   return new Map(rows.map((row) => [row.key, row.value]));\n1416: }\n1417: \n1418: function providerForBackend(backend: BackendKind | undefined): string | null {\n1419:   switch (backend) {\n1420:     case 'ollama':\n1421:       return 'ollama';\n1422:     case 'api':\n1423:       return 'openai';\n1424:     case 'sentence-transformers':\n1425:       return 'hf-local';\n1426:     default:\n1427:       return null;\n1428:   }\n1429: }\n1430: \n1431: function readActiveEmbeddingPointer(db: Database.Database): ActiveEmbeddingPointer | null {\n1432:   const metadata = readMetadataMap(db);\n1433:   const name = metadata.get(ACTIVE_EMBEDDER_NAME_KEY);\n1434:   const rawDim = metadata.get(ACTIVE_EMBEDDER_DIM_KEY);\n1435:   const dim = rawDim && /^[0-9]+$/.test(rawDim) ? Number.parseInt(rawDim, 10) : null;\n1436:   if (!name || dim === null || dim <= 0) {\n1437:     return null;\n1438:   }\n1439:   const metadataProvider = metadata.get(ACTIVE_EMBEDDER_PROVIDER_KEY);\n1440:   const manifest = getManifest(name);\n1441:   return {\n1442:     name,\n1443:     dim,\n1444:     provider: metadataProvider && metadataProvider.trim().length > 0\n1445:       ? metadataProvider\n1446:       : providerForBackend(manifest?.backend),\n1447:   };\n1448: }\n1449: \n1450: function signatureFromPointer(pointer: ActiveEmbeddingPointer): AdvisorEmbeddingSignature {\n1451:   const profileId = pointer.provider\n1452:     ? providerModelId({ provider: pointer.provider, model: pointer.name, dim: pointer.dim })\n1453:     : null;\n1454:   return {\n1455:     provider: pointer.provider,\n1456:     name: pointer.name,\n1457:     dim: pointer.dim,\n1458:     modelId: pointer.name,\n1459:     providerModelId: profileId,\n1460:   };\n1461: }\n1462: \n1463: function parseProviderModelId(modelId: string): { provider: string; name: string; dim: number } | null {\n1464:   const slugParts = modelId.split('__');\n1465:   if (slugParts.length >= 3 && /^[0-9]+$/.test(slugParts[2])) {\n1466:     return {\n1467:       provider: slugParts[0],\n1468:       name: slugParts[1],\n1469:       dim: Number.parseInt(slugParts[2], 10),\n1470:     };\n1471:   }\n1472: \n1473:   const parts = modelId.split(':');\n1474:   for (let index = parts.length - 1; index >= 2; index--) {\n1475:     if (!/^[0-9]+$/.test(parts[index])) continue;\n1476:     return {\n1477:       provider: parts[0],\n1478:       name: parts.slice(1, index).join(':'),\n1479:       dim: Number.parseInt(parts[index], 10),\n1480:     };\n1481:   }\n1482:   return null;\n1483: }\n1484: \n1485: function signatureFromModelId(modelId: string, fallbackDim: number | null): AdvisorEmbeddingSignature {\n1486:   const parsed = parseProviderModelId(modelId);\n1487:   if (parsed) {\n1488:     return {\n1489:       provider: parsed.provider,\n1490:       name: parsed.name,\n1491:       dim: parsed.dim,\n1492:       modelId,\n1493:       providerModelId: modelId,\n1494:     };\n1495:   }\n1496:   return {\n1497:     provider: null,\n1498:     name: modelId,\n1499:     dim: fallbackDim ?? 0,\n1500:     modelId,\n1501:     providerModelId: null,\n1502:   };\n1503: }\n1504: \n1505: function activeCompatibleModelIds(active: AdvisorEmbeddingSignature): Set<string> {\n1506:   const ids = new Set<string>([active.modelId]);\n1507:   if (active.providerModelId) ids.add(active.providerModelId);\n1508:   const manifest = getManifest(active.name);\n1509:   if (active.provider && manifest?.ollamaName) {\n1510:     ids.add(providerModelId({ provider: active.provider, model: manifest.ollamaName, dim: active.dim }));\n1511:   }\n1512:   return ids;\n1513: }\n1514: \n1515: function vecTables(db: Database.Database): Array<{ name: string; dim: number }> {\n1516:   const rows = db.prepare(`\n1517:     SELECT name\n1518:     FROM sqlite_master\n1519:     WHERE type = 'table' AND name GLOB 'vec_[0-9]*'\n1520:     ORDER BY name ASC\n1521:   `).all() as TableNameRow[];\n1522:   return rows\n1523:     .map((row) => {\n1524:       const match = /^vec_([0-9]+)$/.exec(row.name);\n1525:       return match ? { name: row.name, dim: Number.parseInt(match[1], 10) } : null;\n1526:     })\n1527:     .filter((row): row is { name: string; dim: number } => row !== null);\n1528: }\n1529: \n1530: function summarizeModelRows(rows: readonly EmbeddingModelRow[], dim: number | null): StoredEmbeddingSummary {\n1531:   const normalizedModelIds = rows.map((row) => row.model_id?.trim() ?? '');\n1532:   const modelIds = unique(\n1533:     normalizedModelIds.filter((modelId) => modelId.length > 0),\n1534:   );\n1535:   return {\n1536:     vectorCount: rows.length,\n1537:     missingModelCount: normalizedModelIds.filter((modelId) => modelId.length === 0).length,\n1538:     modelIds,\n1539:     dim,\n1540:   };\n1541: }\n1542: \n1543: function summarizeVecTable(db: Database.Database, tableName: string, dim: number): StoredEmbeddingSummary {\n1544:   const rows = db.prepare(`\n1545:     SELECT model_id\n1546:     FROM ${tableName}\n1547:     WHERE embedding IS NOT NULL\n1548:     ORDER BY skill_id ASC\n1549:   `).all() as EmbeddingModelRow[];\n1550:   return summarizeModelRows(rows, dim);\n1551: }\n1552: \n1553: function summarizeLegacyEmbeddings(db: Database.Database): StoredEmbeddingSummary {\n1554:   if (!sqliteTableExists(db, 'skill_nodes')) {\n1555:     return { vectorCount: 0, missingModelCount: 0, modelIds: [], dim: null };\n1556:   }\n1557:   const rows = db.prepare(`\n1558:     SELECT embedding_model_id AS model_id\n1559:     FROM skill_nodes\n1560:     WHERE embedding IS NOT NULL\n1561:     ORDER BY id ASC\n1562:   `).all() as EmbeddingModelRow[];\n1563:   return summarizeModelRows(rows, null);\n1564: }\n1565: \n1566: function combineSummaries(summaries: readonly StoredEmbeddingSummary[]): StoredEmbeddingSummary {\n1567:   return {\n1568:     vectorCount: summaries.reduce((total, summary) => total + summary.vectorCount, 0),\n1569:     missingModelCount: summaries.reduce((total, summary) => total + summary.missingModelCount, 0),\n1570:     modelIds: unique(summaries.flatMap((summary) => [...summary.modelIds])),\n1571:     dim: summaries.find((summary) => summary.dim !== null)?.dim ?? null,\n1572:   };\n1573: }\n1574: \n1575: function storedEmbeddingSummary(db: Database.Database, active: ActiveEmbeddingPointer | null): StoredEmbeddingSummary {\n1576:   const tables = vecTables(db);\n1577:   if (active) {\n1578:     const activeTable = tables.find((table) => table.dim === active.dim);\n1579:     if (activeTable) {\n1580:       const summary = summarizeVecTable(db, activeTable.name, activeTable.dim);\n1581:       if (summary.vectorCount > 0 || summary.missingModelCount > 0) {\n1582:         return summary;\n1583:       }\n1584:     }\n1585:     const nonActiveSummaries = tables\n1586:       .filter((table) => table.dim !== active.dim)\n1587:       .map((table) => summarizeVecTable(db, table.name, table.dim))\n1588:       .filter((summary) => summary.vectorCount > 0 || summary.missingModelCount > 0);\n1589:     return combineSummaries(nonActiveSummaries);\n1590:   }\n1591: \n1592:   const legacy = summarizeLegacyEmbeddings(db);\n1593:   if (legacy.vectorCount > 0 || legacy.missingModelCount > 0) {\n1594:     return legacy;\n1595:   }\n1596:   return combineSummaries(\n1597:     tables\n1598:       .map((table) => summarizeVecTable(db, table.name, table.dim))\n1599:       .filter((summary) => summary.vectorCount > 0 || summary.missingModelCount > 0),\n1600:   );\n1601: }\n1602: \n1603: function buildEmbeddingStalenessVerdict(\n1604:   active: AdvisorEmbeddingSignature | null,\n1605:   summary: StoredEmbeddingSummary,\n1606: ): AdvisorEmbeddingStalenessVerdict {\n1607:   if (summary.vectorCount === 0 && summary.missingModelCount === 0) {\n1608:     return { stale: false, active, stored: null, vectorCount: 0 };\n1609:   }\n1610: \n1611:   const storedModelId = summary.modelIds[0] ?? null;\n1612:   const rawStored = storedModelId\n1613:     ? signatureFromModelId(storedModelId, summary.dim)\n1614:     : null;\n1615:   const stored = rawStored && active && activeCompatibleModelIds(active).has(rawStored.modelId)\n1616:     ? { ...active, modelId: rawStored.modelId }\n1617:     : rawStored;\n1618:   const base = {\n1619:     active,\n1620:     stored,\n1621:     vectorCount: summary.vectorCount,\n1622:     modelIds: summary.modelIds,\n1623:   };\n1624: \n1625:   if (!active) {\n1626:     return { ...base, stale: true, reason: 'main active-embedder pointer incomplete' };\n1627:   }\n1628:   if (summary.missingModelCount > 0) {\n1629:     return { ...base, stale: true, reason: 'projection embedding model missing' };\n1630:   }\n1631:   if (summary.modelIds.length !== 1) {\n1632:     return {\n1633:       ...base,\n1634:       stale: true,\n1635:       reason: `projection model set '${summary.modelIds.join(', ')}' != active '${active.name}'`,\n1636:     };\n1637:   }\n1638:   if (stored && stored.dim > 0 && stored.provider !== null && stored.dim !== active.dim) {\n1639:     return { ...base, stale: true, reason: `projection dim ${stored.dim} != active ${active.dim}` };\n1640:   }\n1641:   if (!activeCompatibleModelIds(active).has(summary.modelIds[0])) {\n1642:     return {\n1643:       ...base,\n1644:       stale: true,\n1645:       reason: `projection model '${summary.modelIds[0]}' != active '${active.name}'`,\n1646:     };\n1647:   }\n1648:   return { ...base, stale: false };\n1649: }\n1650: \n1651: // ───────────────────────────────────────────────────────────────────\n1652: // 9. CORE LOGIC\n1653: // ───────────────────────────────────────────────────────────────────\n1654: \n1655: export function readAdvisorEmbeddingStaleness(db: Database.Database): AdvisorEmbeddingStalenessVerdict {\n1656:   try {\n1657:     const activePointer = readActiveEmbeddingPointer(db);\n1658:     const active = activePointer ? signatureFromPointer(activePointer) : null;\n1659:     return buildEmbeddingStalenessVerdict(active, storedEmbeddingSummary(db, activePointer));\n1660:   } catch (error: unknown) {\n1661:     const reason = error instanceof Error ? error.message : String(error);\n1662:     return {\n1663:       stale: true,\n1664:       reason: `projection embedding staleness check failed: ${reason}`,\n1665:       active: null,\n1666:       stored: null,\n1667:       vectorCount: 0,\n1668:       modelIds: [],\n1669:     };\n1670:   }\n1671: }\n1672: \n1673: /**\n1674:  * Load doc-level trigger projections grouped by skill id. Tolerates a\n1675:  * pre-migration database (missing skill_docs table) by returning an\n1676:  * empty map — the read-only recommend path never runs migrations.\n1677:  */\n1678: function loadDocTriggersBySkill(db: Database.Database): Map<string, SkillDocTriggerProjection[]> {\n1679:   const bySkill = new Map<string, SkillDocTriggerProjection[]>();\n1680:   if (!isDocTriggerHarvestEnabled()) return bySkill;\n1681:   let docRows: SkillDocRow[];\n1682:   try {\n1683:     docRows = db.prepare(`\n1684:       SELECT skill_id, doc_path, trigger_phrases, importance_tier\n1685:       FROM skill_docs\n1686:       ORDER BY skill_id ASC, doc_path ASC\n1687:     `).all() as SkillDocRow[];\n1688:   } catch {\n1689:     return bySkill;\n1690:   }\n1691:   for (const row of docRows) {\n1692:     const phrases = unique(parseJsonStringArray(row.trigger_phrases).flatMap((entry) => phraseVariants(entry)));\n1693:     if (phrases.length === 0) continue;\n1694:     const entry: SkillDocTriggerProjection = {\n1695:       docPath: row.doc_path,\n1696:       phrases,\n1697:       tierWeight: docTierWeight(row.importance_tier),\n1698:     };\n1699:     const existing = bySkill.get(row.skill_id);\n1700:     if (existing) existing.push(entry);\n1701:     else bySkill.set(row.skill_id, [entry]);\n1702:   }\n1703:   return bySkill;\n1704: }\n1705: \n1706: function loadSqliteProjection(workspaceRoot: string): AdvisorProjection | null {\n1707:   const dbPath = isAbsolute(SKILL_GRAPH_DB) ? SKILL_GRAPH_DB : join(workspaceRoot, SKILL_GRAPH_DB);\n1708:   if (!existsSync(dbPath)) return null;\n1709:   const db = new Database(dbPath, { readonly: true, fileMustExist: true });\n1710:   try {\n1711:     const rows = db.prepare(`\n1712:       SELECT id, family, category, domains, intent_signals, derived, source_path\n1713:       FROM skill_nodes\n1714:       ORDER BY id ASC\n1715:     `).all() as SkillNodeRow[];\n1716:     const edgeRows = db.prepare(`\n1717:       SELECT source_id, target_id, edge_type, weight, context\n1718:       FROM skill_edges\n1719:       ORDER BY source_id ASC, edge_type ASC, target_id ASC\n1720:     `).all() as SkillEdgeRow[];\n1721:     const docTriggersBySkill = loadDocTriggersBySkill(db);\n1722:     const embeddingStaleness = readAdvisorEmbeddingStaleness(db);\n1723:     return {\n1724:       skills: [\n1725:         ...rows.map((row) => {\n1726:           const projection = projectionFromRow(row);\n1727:           const docTriggers = docTriggersBySkill.get(row.id);\n1728:           return docTriggers && docTriggers.length > 0 ? { ...projection, docTriggers } : projection;\n1729:         }),\n1730:         ...scoringCommandBridges(COMMAND_BRIDGES),\n1731:       ],\n1732:       edges: edgeRows.map((row) => ({\n1733:         sourceId: row.source_id,\n1734:         targetId: row.target_id,\n1735:         edgeType: row.edge_type,\n1736:         weight: Math.max(0, Math.min(1, row.weight)),\n1737:         context: row.context,\n1738:       })),\n1739:       generatedAt: new Date().toISOString(),\n1740:       source: 'sqlite',\n1741:       embeddingSignature: embeddingStaleness.stored,\n1742:       embeddingStaleness,\n1743:     };\n1744:   } finally {\n1745:     db.close();\n1746:   }\n1747: }\n1748: \n1749: function loadFilesystemProjection(workspaceRoot: string): AdvisorProjection {\n1750:   const skillRoot = join(workspaceRoot, '.skilled', 'skills');\n1751:   const skills: SkillProjection[] = [];\n[Output truncated. Continue reading with offset: 1752]","title":"read","metadata":{"metadata":{"truncated":true},"content":[{"type":"text","text":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/lib/scorer/projection.ts, lines 1352-1751\n1352: \n1353: interface SkillDocRow {\n1354:   readonly skill_id: string;\n1355:   readonly doc_path: string;\n1356:   readonly trigger_phrases: string;\n1357:   readonly importance_tier: string | null;\n1358: }\n1359: \n1360: interface MetadataRow {\n1361:   readonly key: string;\n1362:   readonly value: string;\n1363: }\n1364: \n1365: interface TableNameRow {\n1366:   readonly name: string;\n1367: }\n1368: \n1369: interface EmbeddingModelRow {\n1370:   readonly model_id: string | null;\n1371: }\n1372: \n1373: interface StoredEmbeddingSummary {\n1374:   readonly vectorCount: number;\n1375:   readonly missingModelCount: number;\n1376:   readonly modelIds: readonly string[];\n1377:   readonly dim: number | null;\n1378: }\n1379: \n1380: interface ActiveEmbeddingPointer {\n1381:   readonly name: string;\n1382:   readonly dim: number;\n1383:   readonly provider: string | null;\n1384: }\n1385: \n1386: // ───────────────────────────────────────────────────────────────────\n1387: // 7. CONSTANTS\n1388: // ───────────────────────────────────────────────────────────────────\n1389: \n1390: const ACTIVE_EMBEDDER_NAME_KEY = 'active_embedder_name';\n1391: const ACTIVE_EMBEDDER_DIM_KEY = 'active_embedder_dim';\n1392: const ACTIVE_EMBEDDER_PROVIDER_KEY = 'active_embedder_provider';\n1393: \n1394: // ───────────────────────────────────────────────────────────────────\n1395: // 8. HELPERS\n1396: // ───────────────────────────────────────────────────────────────────\n1397: \n1398: function sqliteTableExists(db: Database.Database, tableName: string): boolean {\n1399:   const row = db.prepare(`\n1400:     SELECT 1 AS present\n1401:     FROM sqlite_master\n1402:     WHERE type = 'table' AND name = ?\n1403:     LIMIT 1\n1404:   `).get(tableName) as { present: number } | undefined;\n1405:   return Boolean(row);\n1406: }\n1407: \n1408: function readMetadataMap(db: Database.Database): Map<string, string> {\n1409:   if (!sqliteTableExists(db, 'vec_metadata')) return new Map();\n1410:   const rows = db.prepare(`\n1411:     SELECT key, value\n1412:     FROM vec_metadata\n1413:     WHERE key IN (?, ?, ?)\n1414:   `).all(ACTIVE_EMBEDDER_NAME_KEY, ACTIVE_EMBEDDER_DIM_KEY, ACTIVE_EMBEDDER_PROVIDER_KEY) as MetadataRow[];\n1415:   return new Map(rows.map((row) => [row.key, row.value]));\n1416: }\n1417: \n1418: function providerForBackend(backend: BackendKind | undefined): string | null {\n1419:   switch (backend) {\n1420:     case 'ollama':\n1421:       return 'ollama';\n1422:     case 'api':\n1423:       return 'openai';\n1424:     case 'sentence-transformers':\n1425:       return 'hf-local';\n1426:     default:\n1427:       return null;\n1428:   }\n1429: }\n1430: \n1431: function readActiveEmbeddingPointer(db: Database.Database): ActiveEmbeddingPointer | null {\n1432:   const metadata = readMetadataMap(db);\n1433:   const name = metadata.get(ACTIVE_EMBEDDER_NAME_KEY);\n1434:   const rawDim = metadata.get(ACTIVE_EMBEDDER_DIM_KEY);\n1435:   const dim = rawDim && /^[0-9]+$/.test(rawDim) ? Number.parseInt(rawDim, 10) : null;\n1436:   if (!name || dim === null || dim <= 0) {\n1437:     return null;\n1438:   }\n1439:   const metadataProvider = metadata.get(ACTIVE_EMBEDDER_PROVIDER_KEY);\n1440:   const manifest = getManifest(name);\n1441:   return {\n1442:     name,\n1443:     dim,\n1444:     provider: metadataProvider && metadataProvider.trim().length > 0\n1445:       ? metadataProvider\n1446:       : providerForBackend(manifest?.backend),\n1447:   };\n1448: }\n1449: \n1450: function signatureFromPointer(pointer: ActiveEmbeddingPointer): AdvisorEmbeddingSignature {\n1451:   const profileId = pointer.provider\n1452:     ? providerModelId({ provider: pointer.provider, model: pointer.name, dim: pointer.dim })\n1453:     : null;\n1454:   return {\n1455:     provider: pointer.provider,\n1456:     name: pointer.name,\n1457:     dim: pointer.dim,\n1458:     modelId: pointer.name,\n1459:     providerModelId: profileId,\n1460:   };\n1461: }\n1462: \n1463: function parseProviderModelId(modelId: string): { provider: string; name: string; dim: number } | null {\n1464:   const slugParts = modelId.split('__');\n1465:   if (slugParts.length >= 3 && /^[0-9]+$/.test(slugParts[2])) {\n1466:     return {\n1467:       provider: slugParts[0],\n1468:       name: slugParts[1],\n1469:       dim: Number.parseInt(slugParts[2], 10),\n1470:     };\n1471:   }\n1472: \n1473:   const parts = modelId.split(':');\n1474:   for (let index = parts.length - 1; index >= 2; index--) {\n1475:     if (!/^[0-9]+$/.test(parts[index])) continue;\n1476:     return {\n1477:       provider: parts[0],\n1478:       name: parts.slice(1, index).join(':'),\n1479:       dim: Number.parseInt(parts[index], 10),\n1480:     };\n1481:   }\n1482:   return null;\n1483: }\n1484: \n1485: function signatureFromModelId(modelId: string, fallbackDim: number | null): AdvisorEmbeddingSignature {\n1486:   const parsed = parseProviderModelId(modelId);\n1487:   if (parsed) {\n1488:     return {\n1489:       provider: parsed.provider,\n1490:       name: parsed.name,\n1491:       dim: parsed.dim,\n1492:       modelId,\n1493:       providerModelId: modelId,\n1494:     };\n1495:   }\n1496:   return {\n1497:     provider: null,\n1498:     name: modelId,\n1499:     dim: fallbackDim ?? 0,\n1500:     modelId,\n1501:     providerModelId: null,\n1502:   };\n1503: }\n1504: \n1505: function activeCompatibleModelIds(active: AdvisorEmbeddingSignature): Set<string> {\n1506:   const ids = new Set<string>([active.modelId]);\n1507:   if (active.providerModelId) ids.add(active.providerModelId);\n1508:   const manifest = getManifest(active.name);\n1509:   if (active.provider && manifest?.ollamaName) {\n1510:     ids.add(providerModelId({ provider: active.provider, model: manifest.ollamaName, dim: active.dim }));\n1511:   }\n1512:   return ids;\n1513: }\n1514: \n1515: function vecTables(db: Database.Database): Array<{ name: string; dim: number }> {\n1516:   const rows = db.prepare(`\n1517:     SELECT name\n1518:     FROM sqlite_master\n1519:     WHERE type = 'table' AND name GLOB 'vec_[0-9]*'\n1520:     ORDER BY name ASC\n1521:   `).all() as TableNameRow[];\n1522:   return rows\n1523:     .map((row) => {\n1524:       const match = /^vec_([0-9]+)$/.exec(row.name);\n1525:       return match ? { name: row.name, dim: Number.parseInt(match[1], 10) } : null;\n1526:     })\n1527:     .filter((row): row is { name: string; dim: number } => row !== null);\n1528: }\n1529: \n1530: function summarizeModelRows(rows: readonly EmbeddingModelRow[], dim: number | null): StoredEmbeddingSummary {\n1531:   const normalizedModelIds = rows.map((row) => row.model_id?.trim() ?? '');\n1532:   const modelIds = unique(\n1533:     normalizedModelIds.filter((modelId) => modelId.length > 0),\n1534:   );\n1535:   return {\n1536:     vectorCount: rows.length,\n1537:     missingModelCount: normalizedModelIds.filter((modelId) => modelId.length === 0).length,\n1538:     modelIds,\n1539:     dim,\n1540:   };\n1541: }\n1542: \n1543: function summarizeVecTable(db: Database.Database, tableName: string, dim: number): StoredEmbeddingSummary {\n1544:   const rows = db.prepare(`\n1545:     SELECT model_id\n1546:     FROM ${tableName}\n1547:     WHERE embedding IS NOT NULL\n1548:     ORDER BY skill_id ASC\n1549:   `).all() as EmbeddingModelRow[];\n1550:   return summarizeModelRows(rows, dim);\n1551: }\n1552: \n1553: function summarizeLegacyEmbeddings(db: Database.Database): StoredEmbeddingSummary {\n1554:   if (!sqliteTableExists(db, 'skill_nodes')) {\n1555:     return { vectorCount: 0, missingModelCount: 0, modelIds: [], dim: null };\n1556:   }\n1557:   const rows = db.prepare(`\n1558:     SELECT embedding_model_id AS model_id\n1559:     FROM skill_nodes\n1560:     WHERE embedding IS NOT NULL\n1561:     ORDER BY id ASC\n1562:   `).all() as EmbeddingModelRow[];\n1563:   return summarizeModelRows(rows, null);\n1564: }\n1565: \n1566: function combineSummaries(summaries: readonly StoredEmbeddingSummary[]): StoredEmbeddingSummary {\n1567:   return {\n1568:     vectorCount: summaries.reduce((total, summary) => total + summary.vectorCount, 0),\n1569:     missingModelCount: summaries.reduce((total, summary) => total + summary.missingModelCount, 0),\n1570:     modelIds: unique(summaries.flatMap((summary) => [...summary.modelIds])),\n1571:     dim: summaries.find((summary) => summary.dim !== null)?.dim ?? null,\n1572:   };\n1573: }\n1574: \n1575: function storedEmbeddingSummary(db: Database.Database, active: ActiveEmbeddingPointer | null): StoredEmbeddingSummary {\n1576:   const tables = vecTables(db);\n1577:   if (active) {\n1578:     const activeTable = tables.find((table) => table.dim === active.dim);\n1579:     if (activeTable) {\n1580:       const summary = summarizeVecTable(db, activeTable.name, activeTable.dim);\n1581:       if (summary.vectorCount > 0 || summary.missingModelCount > 0) {\n1582:         return summary;\n1583:       }\n1584:     }\n1585:     const nonActiveSummaries = tables\n1586:       .filter((table) => table.dim !== active.dim)\n1587:       .map((table) => summarizeVecTable(db, table.name, table.dim))\n1588:       .filter((summary) => summary.vectorCount > 0 || summary.missingModelCount > 0);\n1589:     return combineSummaries(nonActiveSummaries);\n1590:   }\n1591: \n1592:   const legacy = summarizeLegacyEmbeddings(db);\n1593:   if (legacy.vectorCount > 0 || legacy.missingModelCount > 0) {\n1594:     return legacy;\n1595:   }\n1596:   return combineSummaries(\n1597:     tables\n1598:       .map((table) => summarizeVecTable(db, table.name, table.dim))\n1599:       .filter((summary) => summary.vectorCount > 0 || summary.missingModelCount > 0),\n1600:   );\n1601: }\n1602: \n1603: function buildEmbeddingStalenessVerdict(\n1604:   active: AdvisorEmbeddingSignature | null,\n1605:   summary: StoredEmbeddingSummary,\n1606: ): AdvisorEmbeddingStalenessVerdict {\n1607:   if (summary.vectorCount === 0 && summary.missingModelCount === 0) {\n1608:     return { stale: false, active, stored: null, vectorCount: 0 };\n1609:   }\n1610: \n1611:   const storedModelId = summary.modelIds[0] ?? null;\n1612:   const rawStored = storedModelId\n1613:     ? signatureFromModelId(storedModelId, summary.dim)\n1614:     : null;\n1615:   const stored = rawStored && active && activeCompatibleModelIds(active).has(rawStored.modelId)\n1616:     ? { ...active, modelId: rawStored.modelId }\n1617:     : rawStored;\n1618:   const base = {\n1619:     active,\n1620:     stored,\n1621:     vectorCount: summary.vectorCount,\n1622:     modelIds: summary.modelIds,\n1623:   };\n1624: \n1625:   if (!active) {\n1626:     return { ...base, stale: true, reason: 'main active-embedder pointer incomplete' };\n1627:   }\n1628:   if (summary.missingModelCount > 0) {\n1629:     return { ...base, stale: true, reason: 'projection embedding model missing' };\n1630:   }\n1631:   if (summary.modelIds.length !== 1) {\n1632:     return {\n1633:       ...base,\n1634:       stale: true,\n1635:       reason: `projection model set '${summary.modelIds.join(', ')}' != active '${active.name}'`,\n1636:     };\n1637:   }\n1638:   if (stored && stored.dim > 0 && stored.provider !== null && stored.dim !== active.dim) {\n1639:     return { ...base, stale: true, reason: `projection dim ${stored.dim} != active ${active.dim}` };\n1640:   }\n1641:   if (!activeCompatibleModelIds(active).has(summary.modelIds[0])) {\n1642:     return {\n1643:       ...base,\n1644:       stale: true,\n1645:       reason: `projection model '${summary.modelIds[0]}' != active '${active.name}'`,\n1646:     };\n1647:   }\n1648:   return { ...base, stale: false };\n1649: }\n1650: \n1651: // ───────────────────────────────────────────────────────────────────\n1652: // 9. CORE LOGIC\n1653: // ───────────────────────────────────────────────────────────────────\n1654: \n1655: export function readAdvisorEmbeddingStaleness(db: Database.Database): AdvisorEmbeddingStalenessVerdict {\n1656:   try {\n1657:     const activePointer = readActiveEmbeddingPointer(db);\n1658:     const active = activePointer ? signatureFromPointer(activePointer) : null;\n1659:     return buildEmbeddingStalenessVerdict(active, storedEmbeddingSummary(db, activePointer));\n1660:   } catch (error: unknown) {\n1661:     const reason = error instanceof Error ? error.message : String(error);\n1662:     return {\n1663:       stale: true,\n1664:       reason: `projection embedding staleness check failed: ${reason}`,\n1665:       active: null,\n1666:       stored: null,\n1667:       vectorCount: 0,\n1668:       modelIds: [],\n1669:     };\n1670:   }\n1671: }\n1672: \n1673: /**\n1674:  * Load doc-level trigger projections grouped by skill id. Tolerates a\n1675:  * pre-migration database (missing skill_docs table) by returning an\n1676:  * empty map — the read-only recommend path never runs migrations.\n1677:  */\n1678: function loadDocTriggersBySkill(db: Database.Database): Map<string, SkillDocTriggerProjection[]> {\n1679:   const bySkill = new Map<string, SkillDocTriggerProjection[]>();\n1680:   if (!isDocTriggerHarvestEnabled()) return bySkill;\n1681:   let docRows: SkillDocRow[];\n1682:   try {\n1683:     docRows = db.prepare(`\n1684:       SELECT skill_id, doc_path, trigger_phrases, importance_tier\n1685:       FROM skill_docs\n1686:       ORDER BY skill_id ASC, doc_path ASC\n1687:     `).all() as SkillDocRow[];\n1688:   } catch {\n1689:     return bySkill;\n1690:   }\n1691:   for (const row of docRows) {\n1692:     const phrases = unique(parseJsonStringArray(row.trigger_phrases).flatMap((entry) => phraseVariants(entry)));\n1693:     if (phrases.length === 0) continue;\n1694:     const entry: SkillDocTriggerProjection = {\n1695:       docPath: row.doc_path,\n1696:       phrases,\n1697:       tierWeight: docTierWeight(row.importance_tier),\n1698:     };\n1699:     const existing = bySkill.get(row.skill_id);\n1700:     if (existing) existing.push(entry);\n1701:     else bySkill.set(row.skill_id, [entry]);\n1702:   }\n1703:   return bySkill;\n1704: }\n1705: \n1706: function loadSqliteProjection(workspaceRoot: string): AdvisorProjection | null {\n1707:   const dbPath = isAbsolute(SKILL_GRAPH_DB) ? SKILL_GRAPH_DB : join(workspaceRoot, SKILL_GRAPH_DB);\n1708:   if (!existsSync(dbPath)) return null;\n1709:   const db = new Database(dbPath, { readonly: true, fileMustExist: true });\n1710:   try {\n1711:     const rows = db.prepare(`\n1712:       SELECT id, family, category, domains, intent_signals, derived, source_path\n1713:       FROM skill_nodes\n1714:       ORDER BY id ASC\n1715:     `).all() as SkillNodeRow[];\n1716:     const edgeRows = db.prepare(`\n1717:       SELECT source_id, target_id, edge_type, weight, context\n1718:       FROM skill_edges\n1719:       ORDER BY source_id ASC, edge_type ASC, target_id ASC\n1720:     `).all() as SkillEdgeRow[];\n1721:     const docTriggersBySkill = loadDocTriggersBySkill(db);\n1722:     const embeddingStaleness = readAdvisorEmbeddingStaleness(db);\n1723:     return {\n1724:       skills: [\n1725:         ...rows.map((row) => {\n1726:           const projection = projectionFromRow(row);\n1727:           const docTriggers = docTriggersBySkill.get(row.id);\n1728:           return docTriggers && docTriggers.length > 0 ? { ...projection, docTriggers } : projection;\n1729:         }),\n1730:         ...scoringCommandBridges(COMMAND_BRIDGES),\n1731:       ],\n1732:       edges: edgeRows.map((row) => ({\n1733:         sourceId: row.source_id,\n1734:         targetId: row.target_id,\n1735:         edgeType: row.edge_type,\n1736:         weight: Math.max(0, Math.min(1, row.weight)),\n1737:         context: row.context,\n1738:       })),\n1739:       generatedAt: new Date().toISOString(),\n1740:       source: 'sqlite',\n1741:       embeddingSignature: embeddingStaleness.stored,\n1742:       embeddingStaleness,\n1743:     };\n1744:   } finally {\n1745:     db.close();\n1746:   }\n1747: }\n1748: \n1749: function loadFilesystemProjection(workspaceRoot: string): AdvisorProjection {\n1750:   const skillRoot = join(workspaceRoot, '.skilled', 'skills');\n1751:   const skills: SkillProjection[] = [];\n[Output truncated. Continue reading with offset: 1752]"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/lib/scorer/projection.ts\",\"offset\":1352,\"limit\":400}"},"time":{"start":1794522460799,"end":1794522462071}}}}
{"type":"tool_use","timestamp":1794522462082,"sessionID":"ses_e2e22251effedzgdgxW9ZYGzGw","part":{"partID":"prt_1d1dfb4d3001sM5wB1tshoV11f","sessionID":"ses_e2e22251effedzgdgxW9ZYGzGw","messageID":"msg_1d1df73ce001uu7Y74Q9o6tYIx","type":"tool","id":"call_61a02ff4eb97497989cffb78","tool":"shell","state":{"status":"completed","input":{"command":"cd /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research && sed -n '1,60p' .skilled/skills/sk-code/graph-metadata.json && echo \"---- sk-code keywords\" && sed -n '1,35p' .skilled/skills/sk-code/SKILL.md"},"output":"{\n  \"schema_version\": 2,\n  \"skill_id\": \"sk-code\",\n  \"family\": \"sk-code\",\n  \"category\": \"code-quality\",\n  \"deprecated\": false,\n  \"edges\": {\n    \"depends_on\": [],\n    \"enhances\": [\n      {\n        \"target\": \"system-spec-kit\",\n        \"weight\": 0.3,\n        \"context\": \"opencode standards and verification for spec-kit system code\"\n      }\n    ],\n    \"siblings\": [\n      {\n        \"target\": \"sk-prompt\",\n        \"weight\": 0.4,\n        \"context\": \"prompt-craft pairs with code standards on dispatched work\"\n      },\n      {\n        \"target\": \"cli-external-orchestration\",\n        \"weight\": 0.4,\n        \"context\": \"dispatched code sessions load sk-code standards\"\n      },\n      {\n        \"target\": \"sk-git\",\n        \"weight\": 0.4,\n        \"context\": \"commit hygiene pairs with code standards\"\n      }\n    ],\n    \"conflicts_with\": [],\n    \"prerequisite_for\": [\n      {\n        \"target\": \"system-skill-advisor\",\n        \"weight\": 0.7,\n        \"context\": \"skill advisor routes code work to sk-code surfaces\"\n      },\n      {\n        \"target\": \"system-deep-loop\",\n        \"weight\": 0.8,\n        \"context\": \"deep-review depends on the sk-code code-review mode baseline\"\n      }\n    ]\n  },\n  \"domains\": [\n    \"code\",\n    \"smart-router\",\n    \"surface-aware\",\n    \"javascript\",\n    \"opencode\",\n    \"system-code\",\n    \"typescript\",\n    \"python\",\n    \"shell\",\n    \"json\",\n    \"jsonc\",\n    \"code-quality\",\n    \"verification\",\n---- sk-code keywords\n---\nname: sk-code\ndescription: \"Implement, debug and verify code: TypeScript, Python, shell, JSON; quality and review workflow modes with stack surface packets.\"\nallowed-tools: [Read, Write, Edit, Bash, Grep, Glob]\nversion: 3.11.6.0\nmetadata:\n  family: sk-code\n---\n\n<!-- Keywords: sk-code, code, surface-aware, two-axis, opencode, typescript, python, shell, json, jsonc, github-actions, ci-workflow, sk-code-quality, sk-code-review, sk-code-ci, sk-code-frontend, quality, code-review, verification, debug, implement, workflow-doctrine, mode-registry, workflowmode, packetkind, backendkind, surface-router, evidence-base, surface-packet, guard, adapter, stderr, detector -->\n\n# Code Family Hub (sk-code)\n\nOne skill has two axes, one shared surface-detection router and one advisor identity.\nThe **workflow axis** has two code modes that act: sk-code-quality and sk-code-review.\nThe **surface axis** has three read-only evidence packets the hub bundles alongside a workflow mode: sk-code-ci, sk-code-frontend and sk-code-skilled.\nEach packet carries the shared **implement → debug → verify** workflow doctrine (`shared/references/workflow-*.md`, symlinked in) plus its own domain knowledge.\nThis hub holds NO per-mode logic. It routes by `workflowMode` through `mode-registry.json`, and each mode or surface keeps its own contract in its packet.\n\n**Version authority.** This file's `version` frontmatter is the hub's release version and matches the newest entry under `changelog/`.\n`description.json`, `mode-registry.json` and `hub-router.json` carry the same value. Each hub-root JSON routing file therefore states the same release.\n`ROUTER.md` and `README.md` keep their own document versions, as the frontmatter-versioning standard gives every doc but `SKILL.md`.\nThe authority stops at the hub root. Each `modes[]` packet carries its own version and release cadence.\nA packet version is independent of this one by design, so a gap between them is not drift.\n\n---\n\n## 1. WHEN TO USE\n\nUse this skill for code-family workflows. Invoke it as `sk-code` with an optional mode hint such as `quality: <request>`. The hub classifies the request, resolves a mode key, and loads the matching nested packet.\n\n**Workflow axis** (modes that act, one of them chosen as primary):\n\n| Mode | Use it for | Packet |\n|------|------------|--------|\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"{\n  \"schema_version\": 2,\n  \"skill_id\": \"sk-code\",\n  \"family\": \"sk-code\",\n  \"category\": \"code-quality\",\n  \"deprecated\": false,\n  \"edges\": {\n    \"depends_on\": [],\n    \"enhances\": [\n      {\n        \"target\": \"system-spec-kit\",\n        \"weight\": 0.3,\n        \"context\": \"opencode standards and verification for spec-kit system code\"\n      }\n    ],\n    \"siblings\": [\n      {\n        \"target\": \"sk-prompt\",\n        \"weight\": 0.4,\n        \"context\": \"prompt-craft pairs with code standards on dispatched work\"\n      },\n      {\n        \"target\": \"cli-external-orchestration\",\n        \"weight\": 0.4,\n        \"context\": \"dispatched code sessions load sk-code standards\"\n      },\n      {\n        \"target\": \"sk-git\",\n        \"weight\": 0.4,\n        \"context\": \"commit hygiene pairs with code standards\"\n      }\n    ],\n    \"conflicts_with\": [],\n    \"prerequisite_for\": [\n      {\n        \"target\": \"system-skill-advisor\",\n        \"weight\": 0.7,\n        \"context\": \"skill advisor routes code work to sk-code surfaces\"\n      },\n      {\n        \"target\": \"system-deep-loop\",\n        \"weight\": 0.8,\n        \"context\": \"deep-review depends on the sk-code code-review mode baseline\"\n      }\n    ]\n  },\n  \"domains\": [\n    \"code\",\n    \"smart-router\",\n    \"surface-aware\",\n    \"javascript\",\n    \"opencode\",\n    \"system-code\",\n    \"typescript\",\n    \"python\",\n    \"shell\",\n    \"json\",\n    \"jsonc\",\n    \"code-quality\",\n    \"verification\",\n---- sk-code keywords\n---\nname: sk-code\ndescription: \"Implement, debug and verify code: TypeScript, Python, shell, JSON; quality and review workflow modes with stack surface packets.\"\nallowed-tools: [Read, Write, Edit, Bash, Grep, Glob]\nversion: 3.11.6.0\nmetadata:\n  family: sk-code\n---\n\n<!-- Keywords: sk-code, code, surface-aware, two-axis, opencode, typescript, python, shell, json, jsonc, github-actions, ci-workflow, sk-code-quality, sk-code-review, sk-code-ci, sk-code-frontend, quality, code-review, verification, debug, implement, workflow-doctrine, mode-registry, workflowmode, packetkind, backendkind, surface-router, evidence-base, surface-packet, guard, adapter, stderr, detector -->\n\n# Code Family Hub (sk-code)\n\nOne skill has two axes, one shared surface-detection router and one advisor identity.\nThe **workflow axis** has two code modes that act: sk-code-quality and sk-code-review.\nThe **surface axis** has three read-only evidence packets the hub bundles alongside a workflow mode: sk-code-ci, sk-code-frontend and sk-code-skilled.\nEach packet carries the shared **implement → debug → verify** workflow doctrine (`shared/references/workflow-*.md`, symlinked in) plus its own domain knowledge.\nThis hub holds NO per-mode logic. It routes by `workflowMode` through `mode-registry.json`, and each mode or surface keeps its own contract in its packet.\n\n**Version authority.** This file's `version` frontmatter is the hub's release version and matches the newest entry under `changelog/`.\n`description.json`, `mode-registry.json` and `hub-router.json` carry the same value. Each hub-root JSON routing file therefore states the same release.\n`ROUTER.md` and `README.md` keep their own document versions, as the frontmatter-versioning standard gives every doc but `SKILL.md`.\nThe authority stops at the hub root. Each `modes[]` packet carries its own version and release cadence.\nA packet version is independent of this one by design, so a gap between them is not drift.\n\n---\n\n## 1. WHEN TO USE\n\nUse this skill for code-family workflows. Invoke it as `sk-code` with an optional mode hint such as `quality: <request>`. The hub classifies the request, resolves a mode key, and loads the matching nested packet.\n\n**Workflow axis** (modes that act, one of them chosen as primary):\n\n| Mode | Use it for | Packet |\n|------|------------|--------|\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"cd /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research && sed -n '1,60p' .skilled/skills/sk-code/graph-metadata.json && echo \\\"---- sk-code keywords\\\" && sed -n '1,35p' .skilled/skills/sk-code/SKILL.md\"}"},"time":{"start":1794522461395,"end":1794522462082}}}}
