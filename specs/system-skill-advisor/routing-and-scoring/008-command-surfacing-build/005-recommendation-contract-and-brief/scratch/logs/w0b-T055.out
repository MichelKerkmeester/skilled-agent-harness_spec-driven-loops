 'command-design-chart',\n1168:     kind: 'command',\n1169:     family: 'system',\n1170:     category: 'command',\n1171:     name: 'command-design-chart',\n1172:     description: '',\n1173:     keywords: [],\n1174:     domains: [],\n1175:     intentSignals: [],\n1176:     derivedTriggers: [],\n1177:     derivedKeywords: [],\n1178:     sourcePath: null,\n1179:     lifecycleStatus: 'active',\n1180:   },\n1181:   {\n1182:     inventoryId: 'command-design-diagram',\n1183:     ownerSkill: 'sk-design',\n1184:     routingEnabled: false,\n1185:     id: 'command-design-diagram',\n1186:     kind: 'command',\n1187:     family: 'system',\n1188:     category: 'command',\n1189:     name: 'command-design-diagram',\n1190:     description: '',\n1191:     keywords: [],\n1192:     domains: [],\n1193:     intentSignals: [],\n1194:     derivedTriggers: [],\n1195:     derivedKeywords: [],\n1196:     sourcePath: null,\n1197:     lifecycleStatus: 'active',\n1198:   },\n1199:   {\n1200:     inventoryId: 'command-design-extract',\n1201:     ownerSkill: 'sk-design',\n1202:     routingEnabled: false,\n1203:     id: 'command-design-extract',\n1204:     kind: 'command',\n1205:     family: 'system',\n1206:     category: 'command',\n1207:     name: 'command-design-extract',\n1208:     description: '',\n1209:     keywords: [],\n1210:     domains: [],\n1211:     intentSignals: [],\n1212:     derivedTriggers: [],\n1213:     derivedKeywords: [],\n1214:     sourcePath: null,\n1215:     lifecycleStatus: 'active',\n1216:   },\n1217: ];\n1218: // END GENERATED COMMAND BRIDGES\n1219: \n1220: export const COMMAND_BRIDGES: readonly CommandBridgeProjection[] = GENERATED_COMMAND_BRIDGES;\n1221: \n1222: // ───────────────────────────────────────────────────────────────────\n1223: // 4. HELPERS\n1224: // ───────────────────────────────────────────────────────────────────\n1225: \n1226: function scoringCommandBridges(\n1227:   bridges: readonly CommandBridgeProjection[],\n1228: ): CommandBridgeProjection[] {\n1229:   return bridges.filter((bridge) => bridge.routingEnabled !== false);\n1230: }\n1231: \n1232: function jsonArray(value: string | null | undefined): string[] {\n1233:   return value ? parseJsonStringArray(value) : [];\n1234: }\n1235: \n1236: function jsonObject(value: string | null | undefined): Record<string, unknown> {\n1237:   return value ? parseJsonObject(value) ?? {} : {};\n1238: }\n1239: \n1240: function stringArray(value: unknown): string[] {\n1241:   return Array.isArray(value) ? value.filter((entry): entry is string => typeof entry === 'string') : [];\n1242: }\n1243: \n1244: function reduceDerivedPathEntry(value: string): string {\n1245:   if (!value.includes('/')) return value;\n1246:   const fileName = basename(value);\n1247:   const extension = extname(fileName);\n1248:   // Full repo paths create generic assets/patterns/md/js tokens that match\n1249:   // unrelated prompts; the extension-free basename preserves the distinct concept.\n1250:   return extension ? fileName.slice(0, -extension.length) : fileName;\n1251: }\n1252: \n1253: function boundedDemotion(value: unknown): number | undefined {\n1254:   return typeof value === 'number' && Number.isFinite(value)\n1255:     ? Math.max(0, Math.min(1, value))\n1256:     : undefined;\n1257: }\n1258: \n1259: function readJson(filePath: string): Record<string, unknown> {\n1260:   return readJsonObject(filePath) ?? {};\n1261: }\n1262: \n1263: function parseSkillMarkdown(skillMdPath: string, fallbackId: string): SkillMarkdownMetadata {\n1264:   if (!existsSync(skillMdPath)) {\n1265:     return { name: fallbackId, description: '', keywords: [] };\n1266:   }\n1267:   const { frontmatter, keywords } = parseSkillFrontmatter(readFileSync(skillMdPath, 'utf8'));\n1268:   return {\n1269:     name: frontmatter.name || fallbackId,\n1270:     description: frontmatter.description || '',\n1271:     keywords,\n1272:   };\n1273: }\n1274: \n1275: function lifecycleStatus(raw: unknown, sourcePath: string): SkillLifecycleStatus {\n1276:   if (raw === 'deprecated' || raw === 'archived' || raw === 'future' || raw === 'active') return raw;\n1277:   const pathStatus = lifecycleStatusForPath(sourcePath);\n1278:   return pathStatus === 'archived' || pathStatus === 'future' ? pathStatus : 'active';\n1279: }\n1280: \n1281: // ───────────────────────────────────────────────────────────────────\n1282: // 5. CORE LOGIC\n1283: // ───────────────────────────────────────────────────────────────────\n1284: \n1285: function projectionFromRow(row: SkillNodeRow): SkillProjection {\n1286:   const derived = sanitizeDerivedMetadata(jsonObject(row.derived), row.source_path) ?? {};\n1287:   const graphMetadata = readJson(row.source_path);\n1288:   const skillDir = dirname(row.source_path);\n1289:   const skillMd = parseSkillMarkdown(join(skillDir, 'SKILL.md'), row.id);\n1290:   const lifecycle = lifecycleStatus(\n1291:     graphMetadata.lifecycle_status ?? derived.lifecycle_status,\n1292:     row.source_path,\n1293:   );\n1294:   const redirectTo = typeof graphMetadata.redirect_to === 'string'\n1295:     ? graphMetadata.redirect_to\n1296:     : (typeof derived.redirect_to === 'string' ? derived.redirect_to : null);\n1297:   const redirectFrom = stringArray(graphMetadata.redirect_from ?? derived.redirect_from);\n1298:   // Distinguish derivedTriggers (intent-shaped phrases) from\n1299:   // derivedKeywords (entity-shaped concepts). Previously both fields were\n1300:   // assigned the same array (value-by-reference), which double-counted the\n1301:   // same evidence into two scoring inputs. Triggers now come from\n1302:   // `derived.trigger_phrases` only; keywords come from `derived.key_topics`\n1303:   // + `derived.entities` + `derived.key_files` + `derived.source_docs`. Each\n1304:   // pipeline still passes through `phraseVariants` and `unique`. The two\n1305:   // arrays may overlap when authors duplicate entries, but they are no longer\n1306:   // assigned the same value-by-reference.\n1307:   const derivedTriggers = unique(\n1308:     stringArray(derived.trigger_phrases).flatMap((entry) => phraseVariants(entry)),\n1309:   );\n1310:   const derivedKeywords = unique([\n1311:     ...stringArray(derived.key_topics),\n1312:     ...stringArray(derived.entities),\n1313:     ...stringArray(derived.key_files).map(reduceDerivedPathEntry),\n1314:     ...stringArray(derived.source_docs).map(reduceDerivedPathEntry),\n1315:   ].flatMap((entry) => phraseVariants(entry)));\n1316: \n1317:   return {\n1318:     id: row.id,\n1319:     kind: 'skill',\n1320:     family: row.family,\n1321:     category: row.category,\n1322:     name: skillMd.name,\n1323:     description: skillMd.description,\n1324:     keywords: unique(skillMd.keywords.flatMap((entry) => phraseVariants(entry))),\n1325:     domains: unique(sanitizeMetadataStringArray(jsonArray(row.domains), row.source_path).flatMap((entry) => phraseVariants(entry))),\n1326:     intentSignals: unique(sanitizeMetadataStringArray(jsonArray(row.intent_signals), row.source_path).flatMap((entry) => phraseVariants(entry))),\n1327:     derivedTriggers,\n1328:     derivedKeywords,\n1329:     derivedDemotion: boundedDemotion(derived.demotion),\n1330:     // V2 derived sync stamps generated_at (the canonical author/sync time of\n1331:     // the derived block); older shapes carried last_updated_at/created_at.\n1332:     // generated_at leads the chain so a V2 block's real freshness wins over a\n1333:     // stray legacy field. This value is AUTHOR-TIME, not runtime: rebuild\n1334:     // re-indexes the existing block without re-stamping it; only a\n1335:     // derived-content change through sync re-stamps generated_at.\n1336:     derivedGeneratedAt: isoTimestampOrNull(derived.generated_at ?? derived.last_updated_at ?? derived.created_at),\n1337:     sourcePath: row.source_path,\n1338:     lifecycleStatus: lifecycle,\n1339:     redirectTo,\n1340:     redirectFrom,\n1341:   };\n1342: }\n1343: \n1344: function isoTimestampOrNull(value: unknown): string | null {\n1345:   if (typeof value !== 'string' || value.trim().length === 0) return null;\n1346:   return Number.isNaN(Date.parse(value)) ? null : value;\n1347: }\n1348: \n1349: // ───────────────────────────────────────────────────────────────────\n1350: // 6. TYPE DEFINITIONS\n1351: // ───────────────────────────────────────────────────────────────────\n[Output truncated. Continue reading with offset: 1352]"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/lib/scorer/projection.ts\"}"},"time":{"start":1794522403918,"end":1794522404375}}}}
