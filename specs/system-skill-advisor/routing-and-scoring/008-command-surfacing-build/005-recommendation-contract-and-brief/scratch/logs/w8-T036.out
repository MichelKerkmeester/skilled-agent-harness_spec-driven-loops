]}\"}\n518:     if command.startswith(\"/deep:\"):\n519:         mode = command.split(\":\", 1)[1]\n520:         return {\"skillId\": \"system-deep-loop\", \"ownerMode\": mode}\n521:     if command_name.startswith(SPECKIT_COMMAND_BRIDGE_PREFIXES) or command == \"/memory:save\":\n522:         return {\"skillId\": \"system-spec-kit\", \"ownerMode\": \"system-spec-kit\"}\n523:     if command.startswith(\"/create:\"):\n524:         return {\"skillId\": \"sk-doc\", \"ownerMode\": f\"sk-create-{command.split(':', 1)[1]}\"}\n525:     if command == \"/prompt\":\n526:         return {\"skillId\": \"sk-prompt\", \"ownerMode\": \"sk-prompt\"}\n527:     return {\n528:         \"skillId\": str(owner or \"\"),\n529:         \"ownerMode\": \"\",\n530:     }\n531: \n532: \n533: def _normalized_live_command_bridges() -> List[Dict[str, str]]:\n534:     \"\"\"Return the selected Python command bridges in inventory projection form.\"\"\"\n535:     entries: List[Dict[str, str]] = []\n536:     for command_name, command_config in COMMAND_BRIDGES.items():\n537:         configured_command = command_config.get(\"command\")\n538:         command = configured_command if isinstance(configured_command, str) else next(\n539:             (\n540:                 marker\n541:                 for marker in command_config.get(\"slash_markers\", [])\n542:                 if isinstance(marker, str) and marker.startswith(\"/\")\n543:             ),\n544:             \"\",\n545:         )\n546:         configured_skill_id = command_config.get(\"skill_id\")\n547:         configured_owner_mode = command_config.get(\"owner_mode\")\n548:         owner = (\n549:             {\n550:                 \"skillId\": configured_skill_id,\n551:                 \"ownerMode\": configured_owner_mode,\n552:             }\n553:             if isinstance(configured_skill_id, str) and isinstance(configured_owner_mode, str)\n554:             else _command_bridge_owner(command_name, command)\n[Output truncated. Continue reading with offset: 555]","title":"read","metadata":{"metadata":{"truncated":true},"content":[{"type":"text","text":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/scripts/skill_advisor.py, lines 495-554\n495:     print(json.dumps({\n496:         \"status\": \"emitted\",\n497:         \"projectionHash\": projection_hash,\n498:         \"changed\": changed,\n499:     }, indent=2))\n500:     return 0\n501: \n502: \n503: # Every /speckit command is scored under its own bridge id, so the family is\n504: # matched by prefix; the umbrella id that used to name the whole family is gone.\n505: SPECKIT_COMMAND_BRIDGE_PREFIXES = (\"command-spec-kit-\", \"command-speckit-\")\n506: \n507: \n508: def _command_bridge_owner(command_name: str, command: str) -> Dict[str, str]:\n509:     \"\"\"Normalize a live Python bridge owner to the generated projection shape.\"\"\"\n510:     command_config = COMMAND_BRIDGES.get(command_name, {})\n511:     owner = COMMAND_BRIDGE_OWNER_NORMALIZATION.get(command_name) or command_config.get(\"owning_skill\")\n512:     if owner == \"system-spec-kit\":\n513:         return {\"skillId\": \"system-spec-kit\", \"ownerMode\": \"system-spec-kit\"}\n514:     if isinstance(owner, str) and owner.startswith(\"deep-\"):\n515:         return {\"skillId\": \"system-deep-loop\", \"ownerMode\": owner.removeprefix(\"deep-\")}\n516:     if isinstance(owner, str) and owner.startswith(\"create:\"):\n517:         return {\"skillId\": \"sk-doc\", \"ownerMode\": f\"sk-create-{owner.split(':', 1)[1]}\"}\n518:     if command.startswith(\"/deep:\"):\n519:         mode = command.split(\":\", 1)[1]\n520:         return {\"skillId\": \"system-deep-loop\", \"ownerMode\": mode}\n521:     if command_name.startswith(SPECKIT_COMMAND_BRIDGE_PREFIXES) or command == \"/memory:save\":\n522:         return {\"skillId\": \"system-spec-kit\", \"ownerMode\": \"system-spec-kit\"}\n523:     if command.startswith(\"/create:\"):\n524:         return {\"skillId\": \"sk-doc\", \"ownerMode\": f\"sk-create-{command.split(':', 1)[1]}\"}\n525:     if command == \"/prompt\":\n526:         return {\"skillId\": \"sk-prompt\", \"ownerMode\": \"sk-prompt\"}\n527:     return {\n528:         \"skillId\": str(owner or \"\"),\n529:         \"ownerMode\": \"\",\n530:     }\n531: \n532: \n533: def _normalized_live_command_bridges() -> List[Dict[str, str]]:\n534:     \"\"\"Return the selected Python command bridges in inventory projection form.\"\"\"\n535:     entries: List[Dict[str, str]] = []\n536:     for command_name, command_config in COMMAND_BRIDGES.items():\n537:         configured_command = command_config.get(\"command\")\n538:         command = configured_command if isinstance(configured_command, str) else next(\n539:             (\n540:                 marker\n541:                 for marker in command_config.get(\"slash_markers\", [])\n542:                 if isinstance(marker, str) and marker.startswith(\"/\")\n543:             ),\n544:             \"\",\n545:         )\n546:         configured_skill_id = command_config.get(\"skill_id\")\n547:         configured_owner_mode = command_config.get(\"owner_mode\")\n548:         owner = (\n549:             {\n550:                 \"skillId\": configured_skill_id,\n551:                 \"ownerMode\": configured_owner_mode,\n552:             }\n553:             if isinstance(configured_skill_id, str) and isinstance(configured_owner_mode, str)\n554:             else _command_bridge_owner(command_name, command)\n[Output truncated. Continue reading with offset: 555]"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/scripts/skill_advisor.py\",\"offset\":495,\"limit\":60}"},"time":{"start":1794529057177,"end":1794529058049}}}}
