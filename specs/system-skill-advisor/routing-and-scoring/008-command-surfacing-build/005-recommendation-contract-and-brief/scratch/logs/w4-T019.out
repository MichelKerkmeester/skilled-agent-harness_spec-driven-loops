{"type":"tool_use","timestamp":1794527525409,"sessionID":"ses_e2dd383c7ffeJEUDldBoCXKO5w","part":{"partID":"prt_1d22cf88c002cXNnc72FitZj1f","sessionID":"ses_e2dd383c7ffeJEUDldBoCXKO5w","messageID":"msg_1d22ce02100104N0DYgJwyZ7Eb","type":"tool","id":"call_4d4648d03f084c618c9e3bf2","tool":"read","state":{"status":"completed","input":{"path":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/handlers/advisor-recommend.ts"},"output":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/handlers/advisor-recommend.ts, lines 1-692\n1: // ───────────────────────────────────────────────────────────────\n2: // MODULE: advisor_recommend Handler\n3: // ───────────────────────────────────────────────────────────────\n4: \n5: // ───────────────────────────────────────────────────────────────────\n6: // 1. IMPORTS\n7: // ───────────────────────────────────────────────────────────────────\n8: \n9: import { execFileSync } from 'node:child_process';\n10: import { readFileSync, realpathSync } from 'node:fs';\n11: import { resolve } from 'node:path';\n12: \n13: import { attachCommand, commandRowFor } from '../lib/command-attach.js';\n14: import { advisorPromptCache } from '../lib/prompt-cache.js';\n15: import {\n16:   resolveAdvisorThresholdConfig,\n17: } from '../lib/skill-advisor-brief.js';\n18: import { scoreAdvisorPrompt } from '../lib/scorer/fusion.js';\n19: import { COMMAND_BRIDGES } from '../lib/scorer/projection.js';\n20: import {\n21:   DEEP_ROUTING_PROJECTION_HASH,\n22:   MERGED_DEEP_SKILL_ID,\n23:   modeForAlias,\n24:   modeForPromptAlias,\n25: } from '../lib/scorer/aliases.js';\n26: import { withSemanticShadowPromptEmbedding } from '../lib/scorer/lanes/semantic-shadow.js';\n27: import { DEFAULT_SHADOW_SCORER_LANE_WEIGHTS } from '../lib/scorer/lane-registry.js';\n28: import { sanitizeSkillLabel } from '../lib/render.js';\n29: import { recordShadowDelta, shadowDeltaSinkEnabled } from '../lib/shadow/shadow-sink.js';\n30: import { findAdvisorWorkspaceRoot } from '../lib/utils/workspace-root.js';\n31: import {\n32:   AdvisorRecommendInputSchema,\n33:   AdvisorRecommendOutputSchema,\n34:   type AdvisorRecommendInput,\n35:   type AdvisorRecommendOutput,\n36: } from '../schemas/advisor-tool-schemas.js';\n37: import { readAdvisorStatus } from './advisor-status.js';\n38: import {\n39:   COMPILED_ROUTING_HUBS,\n40:   compiledRoutingEnabledForHub,\n41:   parseCompiledRoutingFlagMode,\n42: } from '../lib/compiled-routing-flag.js';\n43: import type { AdvisorScoringOptions } from '../lib/scorer/types.js';\n44: \n45: // ───────────────────────────────────────────────────────────────────\n46: // 2. TYPE DEFINITIONS\n47: // ───────────────────────────────────────────────────────────────────\n48: \n49: type HandlerResponse = { content: Array<{ type: string; text: string }> };\n50: type AdvisorStatus = ReturnType<typeof readAdvisorStatus>;\n51: type ScoredRecommendation = ReturnType<typeof scoreAdvisorPrompt>['recommendations'][number];\n52: type PublicRecommendationStatus = NonNullable<AdvisorRecommendOutput['recommendations'][number]['status']>;\n53: type PublicThresholds = AdvisorRecommendOutput['effectiveThresholds'];\n54: type ShadowRecommendation = NonNullable<AdvisorRecommendOutput['_shadow']>['recommendations'][number];\n55: \n56: // ───────────────────────────────────────────────────────────────────\n57: // 3. HELPERS\n58: // ───────────────────────────────────────────────────────────────────\n59: \n60: // Emit-only, stderr, debug-gated compiled-routing diagnostic. Never written to\n61: // stdout or the tool response, and never changes the recommendation outcome.\n62: function emitCompiledRoutingBreadcrumb(message: string): void {\n63:   if (process.env.SPECKIT_COMPILED_ROUTING_DEBUG) {\n64:     process.stderr.write(`[compiled-routing] ${message}\\n`);\n65:   }\n66: }\n67: \n68: function findWorkspaceRoot(start = process.cwd()): string {\n69:   return findAdvisorWorkspaceRoot(start, { maxDepth: 12 });\n70: }\n71: \n72: // Canonicalize a caller-supplied workspaceRoot via realpath.\n73: // The schema-level allowlist refinement runs against the same canonical\n74: // form, so a caller passing /tmp/symlink-to-repo gets the real path\n75: // post-symlink before downstream code uses it.\n76: function canonicalizeWorkspaceRoot(input: string): string {\n77:   const resolved = resolve(input);\n78:   try {\n79:     return realpathSync.native(resolved);\n80:   } catch {\n81:     return resolved;\n82:   }\n83: }\n84: \n85: function cacheSourceSignature(status: AdvisorStatus): string {\n86:   return `${status.freshness}:${status.generation}:${status.lastGenerationBump ?? 'never'}:${DEEP_ROUTING_PROJECTION_HASH}`;\n87: }\n88: \n89: function recommendationLabels(output: AdvisorRecommendOutput): string[] {\n90:   return output.recommendations.map((recommendation) => recommendation.skillId);\n91: }\n92: \n93: function unavailableTrustState(reason: string): AdvisorRecommendOutput['trustState'] {\n94:   return {\n95:     state: 'unavailable',\n96:     reason,\n97:     generation: 0,\n98:     checkedAt: new Date().toISOString(),\n99:     lastLiveAt: null,\n100:   };\n101: }\n102: \n103: function publicThresholds(args: {\n104:   confidenceThreshold?: number;\n105:   uncertaintyThreshold?: number;\n106: }): PublicThresholds {\n107:   const resolved = resolveAdvisorThresholdConfig(args);\n108:   return {\n109:     confidenceThreshold: resolved.confidenceThreshold,\n110:     uncertaintyThreshold: resolved.uncertaintyThreshold,\n111:     confidenceOnly: resolved.confidenceOnly,\n112:   };\n113: }\n114: \n115: function runtimeLaneHealthForStatus(status: AdvisorStatus): AdvisorScoringOptions['runtimeLaneHealth'] | undefined {\n116:   if (status.freshness !== 'stale') {\n117:     return undefined;\n118:   }\n119:   return {\n120:     graph_causal: {\n121:       status: 'runtime_degraded',\n122:       reason: status.trustState.reason ?? 'skill_graph_stale',\n123:     },\n124:   };\n125: }\n126: \n127: function renderableStatus(status: AdvisorStatus): AdvisorStatus {\n128:   const trustState = status.trustState.state;\n129:   if (status.freshness === 'unavailable' && (trustState === 'live' || trustState === 'stale')) {\n130:     return { ...status, freshness: trustState };\n131:   }\n132:   return status;\n133: }\n134: \n135: function emptyOutput(args: {\n136:   workspaceRoot: string;\n137:   effectiveThresholds: AdvisorRecommendOutput['effectiveThresholds'];\n138:   freshness: AdvisorRecommendOutput['freshness'];\n139:   trustState: AdvisorRecommendOutput['trustState'];\n140:   warnings?: readonly string[];\n141:   abstainReasons?: readonly string[];\n142: }): AdvisorRecommendOutput {\n143:   return AdvisorRecommendOutputSchema.parse({\n144:     workspaceRoot: args.workspaceRoot,\n145:     effectiveThresholds: args.effectiveThresholds,\n146:     recommendations: [],\n147:     ambiguous: false,\n148:     freshness: args.freshness,\n149:     trustState: args.trustState,\n150:     generatedAt: new Date().toISOString(),\n151:     cache: {\n152:       hit: false,\n153:       sourceSignaturePresent: false,\n154:     },\n155:     ...(args.warnings && args.warnings.length > 0 ? { warnings: [...args.warnings] } : {}),\n156:     ...(args.abstainReasons && args.abstainReasons.length > 0 ? { abstainReasons: [...args.abstainReasons] } : {}),\n157:   });\n158: }\n159: \n160: // The canonical flag is checked first so the reason names it when both are set.\n161: const ADVISOR_DISABLED_FLAGS = [\n162:   'SYSTEM_SKILL_ADVISOR_HOOK_DISABLED',\n163:   'SPECKIT_SKILL_ADVISOR_HOOK_DISABLED',\n164: ] as const;\n165: \n166: function disabledOutput(\n167:   workspaceRoot: string,\n168:   effectiveThresholds: PublicThresholds,\n169:   disabledBy: string,\n170: ): AdvisorRecommendOutput {\n171:   return emptyOutput({\n172:     workspaceRoot,\n173:     effectiveThresholds,\n174:     freshness: 'unavailable',\n175:     trustState: unavailableTrustState('ADVISOR_DISABLED'),\n176:     warnings: ['ADVISOR_DISABLED'],\n177:     abstainReasons: [`Skill advisor disabled by ${disabledBy}.`],\n178:   });\n179: }\n180: \n181: function absentOutput(\n182:   status: AdvisorStatus,\n183:   workspaceRoot: string,\n184:   effectiveThresholds: AdvisorRecommendOutput['effectiveThresholds'],\n185: ): AdvisorRecommendOutput {\n186:   return emptyOutput({\n187:     workspaceRoot,\n188:     effectiveThresholds,\n189:     freshness: 'absent',\n190:     trustState: status.trustState,\n191:     warnings: [status.trustState.reason ?? 'ADVISOR_FRESHNESS_ABSENT'],\n192:     abstainReasons: ['Skill advisor freshness is absent; returning fail-open empty recommendations.'],\n193:   });\n194: }\n195: \n196: function unavailableOutput(\n197:   status: AdvisorStatus,\n198:   workspaceRoot: string,\n199:   effectiveThresholds: AdvisorRecommendOutput['effectiveThresholds'],\n200: ): AdvisorRecommendOutput {\n201:   return emptyOutput({\n202:     workspaceRoot,\n203:     effectiveThresholds,\n204:     freshness: 'unavailable',\n205:     trustState: {\n206:       ...status.trustState,\n207:       state: 'unavailable',\n208:       reason: 'advisor_unavailable',\n209:     },\n210:     warnings: ['advisor_unavailable', ...(status.errors ?? [])],\n211:     abstainReasons: ['Skill advisor freshness is unavailable; returning fail-open empty recommendations.'],\n212:   });\n213: }\n214: \n215: function safeMany(values: readonly string[] | undefined): string[] {\n216:   return (values ?? [])\n217:     .map((value) => sanitizeSkillLabel(value))\n218:     .filter((value): value is string => Boolean(value));\n219: }\n220: \n221: function evidenceFeature(value: string): string {\n222:   const prefix = value.split(':', 1)[0];\n223:   switch (prefix) {\n224:     case 'phrase':\n225:       return 'phrase_match';\n226:     case 'token':\n227:       return 'token_match';\n228:     case 'hint':\n229:       return 'category_hint';\n230:     case 'derived':\n231:       return 'derived_skill_signal';\n232:     case 'doc':\n233:       return 'doc_reference_signal';\n234:     case 'cosine':\n235:       return 'semantic_similarity';\n236:     default:\n237:       if (value.includes('disambiguation')) return 'disambiguation_rule';\n238:       if (value.includes('surface')) return 'surface_signal';\n239:       if (value.includes('intent')) return 'intent_signal';\n240:       if (value.includes('loop')) return 'workflow_signal';\n241:       return 'scorer_signal';\n242:   }\n243: }\n244: \n245: function publicWhyRecommended(recommendation: ScoredRecommendation) {\n246:   const positiveLanes = recommendation.laneContributions\n247:     .filter((lane) => lane.rawScore > 0 || lane.weightedScore > 0)\n248:     .sort((left, right) => right.weightedScore - left.weightedScore)\n249:     .slice(0, 4);\n250:   const matchedSkillFeatures = positiveLanes.flatMap((lane) => (\n251:     Array.from(new Set(lane.evidence.map((entry) => evidenceFeature(entry)))).map((feature) => ({\n252:       lane: lane.lane,\n253:       feature,\n254:     }))\n255:   ));\n256:   const dominant = recommendation.dominantLane;\n257:   return {\n258:     reason: dominant\n259:       ? `Recommended from ranker signals: ${dominant} contributed the strongest live score.`\n260:       : 'Recommended from ranker signals without a single dominant live lane.',\n261:     dominantLane: dominant,\n262:     topLanes: positiveLanes.map((lane) => ({\n263:       lane: lane.lane,\n264:       rawScore: lane.rawScore,\n265:       weightedScore: lane.weightedScore,\n266:       weight: lane.weight,\n267:       shadowOnly: lane.shadowOnly,\n268:       evidenceTypes: Array.from(new Set(lane.evidence.map((entry) => evidenceFeature(entry)))),\n269:       evidenceCount: lane.evidence.length,\n270:     })),\n271:     matchedSkillFeatures,\n272:   };\n273: }\n274: \n275: // Doc evidence entries are skill-relative markdown paths emitted by the\n276: // derived lane as `doc:<path>`. The allowlist rejects anything that\n277: // could smuggle prompt content or path traversal into the response.\n278: const SAFE_DOC_PATH = /^(references|assets)\\/[A-Za-z0-9_./-]+\\.md$/;\n279: \n280: export function matchedDocsFromContributions(\n281:   recommendation: { readonly laneContributions: ReadonlyArray<{ readonly evidence: readonly string[] }> },\n282: ): string[] {\n283:   const docs: string[] = [];\n284:   for (const lane of recommendation.laneContributions) {\n285:     for (const entry of lane.evidence) {\n286:       if (!entry.startsWith('doc:')) continue;\n287:       const path = entry.slice(4);\n288:       if (!SAFE_DOC_PATH.test(path) || path.includes('..')) continue;\n289:       if (!docs.includes(path)) docs.push(path);\n290:       if (docs.length >= 3) return docs;\n291:     }\n292:   }\n293:   return docs;\n294: }\n295: \n296: function workflowModeForRecommendation(\n297:   recommendation: ScoredRecommendation,\n298:   prompt: string,\n299: ): string | undefined {\n300:   const directMode = modeForAlias(recommendation.skill);\n301:   const promptMode = recommendation.skill === MERGED_DEEP_SKILL_ID\n302:     ? modeForPromptAlias(prompt)\n303:     : null;\n304:   const workflowMode = sanitizeSkillLabel(directMode ?? promptMode ?? '');\n305:   return workflowMode || undefined;\n306: }\n307: \n308: function publicRecommendation(\n309:   recommendation: ScoredRecommendation,\n310:   includeAttribution: boolean,\n311:   prompt: string,\n312: ) {\n313:   const skillId = sanitizeSkillLabel(recommendation.skill);\n314:   if (!skillId) return null;\n315:   const commandRow = commandRowFor(recommendation.skill);\n316:   const matchedDocs = matchedDocsFromContributions(recommendation);\n317:   const redirectFrom = safeMany(recommendation.redirectFrom);\n318:   const redirectTo = sanitizeSkillLabel(recommendation.redirectTo ?? '');\n319:   const heldBelow = sanitizeSkillLabel(recommendation.heldBelow ?? '');\n320:   const sanitizedStatus = sanitizeSkillLabel(recommendation.lifecycleStatus);\n321:   const status: PublicRecommendationStatus | undefined = sanitizedStatus === 'active'\n322:     || sanitizedStatus === 'deprecated'\n323:     || sanitizedStatus === 'archived'\n324:     || sanitizedStatus === 'future'\n325:     ? sanitizedStatus as PublicRecommendationStatus\n326:     : undefined;\n327:   const workflowMode = workflowModeForRecommendation(recommendation, prompt);\n328:   return {\n329:     skillId,\n330:     kind: recommendation.kind,\n331:     score: recommendation.score,\n332:     confidence: recommendation.confidence,\n333:     uncertainty: recommendation.uncertainty,\n334:     dominantLane: recommendation.dominantLane,\n335:     ...(includeAttribution ? {\n336:       laneBreakdown: recommendation.laneContributions.map((lane) => ({\n337:         lane: lane.lane,\n338:         rawScore: lane.rawScore,\n339:         weightedScore: lane.weightedScore,\n340:         weight: lane.weight,\n341:         shadowOnly: lane.shadowOnly,\n342:       })),\n343:       why_recommended: publicWhyRecommended(recommendation),\n344:     } : {}),\n345:     ...(matchedDocs.length > 0 ? { matchedDocs } : {}),\n346:     ...(redirectFrom.length > 0 ? { redirectFrom } : {}),\n347:     ...(redirectTo ? { redirectTo } : {}),\n348:     // Hook briefs re-derive ambiguity from the public list, so a skill the typed\n349:     // command already ranked below its seed has to say so here.\n350:     ...(heldBelow ? { heldBelow } : {}),\n351:     ...(status ? { status } : {}),\n352:     ...(workflowMode ? { workflowMode } : {}),\n353:     // A command row is the contract a reader acts on, so its runnable string,\n354:     // policy and owner travel with the pick. An id with no row adds nothing.\n355:     ...(commandRow ? {\n356:       command: commandRow.command,\n357:       ...(commandRow.policy ? { policy: commandRow.policy } : {}),\n358:       ownerSkillId: commandRow.ownerSkillId,\n359:     } : {}),\n360:   };\n361: }\n362: \n363: // The front door runs from the request's workspaceRoot, and a caller may name\n364: // another checkout there, such as a worktree under the repository root. Its copy\n365: // can predate --prompt-stdin and would resolve an empty prompt, so such a copy\n366: // gets no compiled route rather than the prompt in argv.\n367: export function frontDoorReadsPromptFromStdin(frontDoorPath: string): boolean {\n368:   try {\n369:     return readFileSync(frontDoorPath, 'utf8').includes('--prompt-stdin');\n370:   } catch {\n371:     return false;\n372:   }\n373: }\n374: \n375: function compiledRouteForRecommendation(\n376:   skillId: string,\n377:   prompt: string,\n378:   workspaceRoot: string,\n379:   surfaceHint?: string,\n380: ): Record<string, unknown> | undefined {\n381:   if (!COMPILED_ROUTING_HUBS.has(skillId)) return undefined;\n382:   const frontDoor = resolve(workspaceRoot, '.skilled', 'bin', 'compiled-route.cjs');\n383:   if (!frontDoorReadsPromptFromStdin(frontDoor)) {\n384:     emitCompiledRoutingBreadcrumb(`compiled-route front door cannot read the prompt from stdin; skipping hub=${skillId}`);\n385:     return undefined;\n386:   }\n387:   try {\n388:     const args = [\n389:       frontDoor,\n390:       '--hub',\n391:       skillId,\n392:       '--prompt-stdin',\n393:     ];\n394:     // A hint the caller already holds is forwarded as its own argv element;\n395:     // the front door ignores a value that names no known surface.\n396:     if (surfaceHint) args.push('--surface-hint', surfaceHint);\n397:     const output = execFileSync(process.execPath, args, {\n398:       cwd: workspaceRoot,\n399:       encoding: 'utf8',\n400:       input: prompt,\n401:       stdio: ['pipe', 'pipe', 'pipe'],\n402:       timeout: 5_000,\n403:       maxBuffer: 1_048_576,\n404:     });\n405:     const parsed: unknown = JSON.parse(output.trim());\n406:     if (typeof parsed !== 'object' || parsed === null || Array.isArray(parsed)) {\n407:       return undefined;\n408:     }\n409:     const compiledRoute = parsed as Record<string, unknown>;\n410:     return compiledRoute.servingAuthority === 'legacy' ? undefined : compiledRoute;\n411:   } catch (error) {\n412:     // Surface the otherwise-silent fallback (debug-gated), including any child\n413:     // stderr the pipe above now captures instead of discarding. The served\n414:     // outcome is unchanged: a failed probe attaches no compiled route (legacy).\n415:     const childStderr = (error as { stderr?: unknown } | null)?.stderr;\n416:     const detail = typeof childStderr === 'string' && childStderr.trim()\n417:       ? ` child-stderr=${childStderr.trim()}`\n418:       : '';\n419:     emitCompiledRoutingBreadcrumb(\n420:       `compiled-route subprocess failed for hub=${skillId}: ${error instanceof Error ? error.message : String(error)}${detail}`,\n421:     );\n422:     return undefined;\n423:   }\n424: }\n425: \n426: // Every command row lists its slash string among its keywords, which is the one\n427: // place the row states what a reader types.\n428: const BRIDGE_COMMAND_BY_ID: ReadonlyMap<string, string> = new Map(\n429:   COMMAND_BRIDGES.flatMap((bridge) => {\n430:     const command = bridge.keywords.find((keyword) => keyword.startsWith('/'));\n431:     return command ? [[bridge.id, command] as const] : [];\n432:   }),\n433: );\n434: \n435: function enrichCompiledRoutes(\n436:   output: AdvisorRecommendOutput,\n437:   prompt: string,\n438:   workspaceRoot: string,\n439:   surfaceHint?: string,\n440:   topOnly = false,\n441: ): AdvisorRecommendOutput {\n442:   const mode = parseCompiledRoutingFlagMode(process.env.SPECKIT_COMPILED_ROUTING);\n443:   if (mode === 'invalid') {\n444:     emitCompiledRoutingBreadcrumb(\n445:       `ignoring invalid SPECKIT_COMPILED_ROUTING=${JSON.stringify(process.env.SPECKIT_COMPILED_ROUTING)}; serving legacy`,\n446:     );\n447:   }\n448:   // Only enrich hubs the flag permits. The default cohort now covers all 7\n449:   // compiled-eligible hubs (mirrors the runtime resolver's own default-on\n450:   // cohort), so unset attaches compiledRoute for those hubs; the kill-switch\n451:   // ('0'|'false'|'off') and invalid values still skip enrichment for every hub.\n452:   // Skip the schema re-parse entirely when nothing is eligible so the output is\n453:   // returned unchanged.\n454:   const anyEligible = output.recommendations.some((r) => compiledRoutingEnabledForHub(r.skillId));\n455:   if (!anyEligible) return output;\n456:   // A command row that already ranks in this result offers its command by itself,\n457:   // so the owning hub must not offer the same one again and spend a second slot on it.\n458:   const alreadyOffered = new Set<string>();\n459:   for (const recommendation of output.recommendations) {\n460:     const command = BRIDGE_COMMAND_BY_ID.get(recommendation.skillId);\n461:     if (command) alreadyOffered.add(command);\n462:   }\n463:   return AdvisorRecommendOutputSchema.parse({\n464:     ...output,\n465:     recommendations: output.recommendations.map((recommendation, index) => {\n466:       // Each lookup is a subprocess, so a caller that acts on the top pick alone\n467:       // pays for that one and no more.\n468:       if (topOnly && index > 0) return recommendation;\n469:       if (!compiledRoutingEnabledForHub(recommendation.skillId)) return recommendation;\n470:       const compiledRoute = compiledRouteForRecommendation(\n471:         recommendation.skillId,\n472:         prompt,\n473:         workspaceRoot,\n474:         surfaceHint,\n475:       );\n476:       if (!compiledRoute) return recommendation;\n477:       // The route answers which mode the hub would take; the command is what a reader\n478:       // types to run it, so it rides along only when the route names exactly one mode\n479:       // that has a command. A broader route leaves the key off rather than guessing.\n480:       const command = attachCommand(recommendation.skillId, compiledRoute, prompt);\n481:       return command && !alreadyOffered.has(command)\n482:         ? { ...recommendation, compiledRoute, command }\n483:         : { ...recommendation, compiledRoute };\n484:     }),\n485:   });\n486: }\n487: \n488: function publicShadowRecommendations(recommendations: readonly ScoredRecommendation[], topK: number): ShadowRecommendation[] {\n489:   const shadowRecommendations: ShadowRecommendation[] = [];\n490:   for (const recommendation of recommendations) {\n491:     const skillId = sanitizeSkillLabel(recommendation.skill);\n492:     if (!skillId) continue;\n493:     const shadowContributions = recommendation.laneContributions.map((lane) => ({\n494:       lane: lane.lane,\n495:       weightedScore: lane.rawScore * DEFAULT_SHADOW_SCORER_LANE_WEIGHTS[lane.lane],\n496:     }));\n497:     const shadowScore = roundScore(shadowContributions.reduce((total, lane) => total + lane.weightedScore, 0));\n498:     const dominant = shadowContributions\n499:       .filter((lane) => lane.weightedScore > 0)\n500:       .sort((left, right) => right.weightedScore - left.weightedScore)[0]?.lane ?? null;\n501:     shadowRecommendations.push({\n502:         skillId,\n503:         liveScore: recommendation.score,\n504:         shadowScore,\n505:         delta: roundScore(shadowScore - recommendation.score),\n506:         dominantShadowLane: dominant,\n507:     });\n508:   }\n509:   return shadowRecommendations\n510:     .sort((left, right) => right.shadowScore - left.shadowScore || left.skillId.localeCompare(right.skillId))\n511:     .slice(0, topK);\n512: }\n513: \n514: function roundScore(value: number): number {\n515:   return Math.round(value * 1_000_000) / 1_000_000;\n516: }\n517: \n518: function outputWarnings(\n519:   status: AdvisorStatus,\n520:   result: ReturnType<typeof scoreAdvisorPrompt>,\n521: ): string[] {\n522:   const degradedLanes = result.metrics.degradedLanes ?? [];\n523:   return [\n524:     ...(status.freshness === 'stale' ? [status.trustState.reason ?? 'STALE_ADVISOR_FRESHNESS'] : []),\n525:     ...(degradedLanes.length > 0\n526:       ? [`runtime_degraded_lanes:${degradedLanes.join(',')}`]\n527:       : []),\n528:   ];\n529: }\n530: \n531: function outputAbstainReasons(\n532:   input: AdvisorRecommendInput,\n533:   result: ReturnType<typeof scoreAdvisorPrompt>,\n534: ): string[] {\n535:   if (!input.options?.includeAbstainReasons) return [];\n536:   return [\n537:     ...(result.unknown ? ['No recommendation passed confidence and uncertainty thresholds.'] : []),\n538:     ...(result.abstainReasons ?? []),\n539:   ];\n540: }\n541: \n542: // ───────────────────────────────────────────────────────────────────\n543: // 4. CORE LOGIC\n544: // ───────────────────────────────────────────────────────────────────\n545: \n546: async function computeRecommendationOutput(input: AdvisorRecommendInput): Promise<AdvisorRecommendOutput> {\n547:   // Canonicalize via realpath after the schema allowlist check.\n548:   const workspaceRoot = input.workspaceRoot\n549:     ? canonicalizeWorkspaceRoot(input.workspaceRoot)\n550:     : findWorkspaceRoot();\n551:   const effectiveThresholds = publicThresholds({\n552:     confidenceThreshold: input.options?.confidenceThreshold,\n553:     uncertaintyThreshold: input.options?.uncertaintyThreshold,\n554:   });\n555:   // Detect on-disk corruption here too: without it a malformed artifact reads\n556:   // 'live' from the generation counters and the recommend path would serve\n557:   // results as fresh. The verdict is cached per generation, so the quick_check\n558:   // runs at most once per rebuild rather than on every recommendation.\n559:   const status = renderableStatus(readAdvisorStatus({ workspaceRoot, checkArtifactIntegrity: true }));\n560:   if (status.freshness === 'unavailable') {\n561:     return unavailableOutput(status, workspaceRoot, effectiveThresholds);\n562:   }\n563:   if (status.freshness === 'absent') {\n564:     return absentOutput(status, workspaceRoot, effectiveThresholds);\n565:   }\n566:   const sourceSignature = cacheSourceSignature(status);\n567:   advisorPromptCache.invalidateSourceSignatureChange(sourceSignature);\n568:   const key = advisorPromptCache.makeKey({\n569:     canonicalPrompt: input.prompt.trim(),\n570:     sourceSignature,\n571:     workspaceRoot,\n572:     runtime: 'mcp',\n573:     maxTokens: input.options?.topK,\n574:     thresholdConfig: {\n575:       confidenceThreshold: input.options?.confidenceThreshold,\n576:       uncertaintyThreshold: input.options?.uncertaintyThreshold,\n577:       includeAttribution: input.options?.includeAttribution,\n578:       includeAbstainReasons: input.options?.includeAbstainReasons,\n579:     },\n580:   });\n581:   const cached = advisorPromptCache.get(key);\n582:   if (cached) {\n583:     const cachedOutput = cached.value as AdvisorRecommendOutput;\n584:     const parsedCachedOutput = AdvisorRecommendOutputSchema.parse({\n585:       ...cachedOutput,\n586:       workspaceRoot,\n587:       effectiveThresholds,\n588:       cache: {\n589:         ...cachedOutput.cache,\n590:         hit: true,\n591:       },\n592:     });\n593:     return input.options?.includeCompiledRoute === false\n594:       ? parsedCachedOutput\n595:       : enrichCompiledRoutes(parsedCachedOutput, input.prompt, workspaceRoot, input.options?.surfaceHint, input.options?.compiledRouteTopOnly === true);\n596:   }\n597: \n598:   const topK = input.options?.topK ?? 3;\n599:   const result = await withSemanticShadowPromptEmbedding(input.prompt, () => scoreAdvisorPrompt(input.prompt, {\n600:     workspaceRoot,\n601:     confidenceThreshold: input.options?.confidenceThreshold,\n602:     uncertaintyThreshold: input.options?.uncertaintyThreshold,\n603:     runtimeLaneHealth: runtimeLaneHealthForStatus(status),\n604:   }));\n605:   const recommendations = result.recommendations\n606:     .map((recommendation) => publicRecommendation(\n607:       recommendation,\n608:       Boolean(input.options?.includeAttribution),\n609:       input.prompt,\n610:     ))\n611:     .filter((recommendation): recommendation is NonNullable<typeof recommendation> => Boolean(recommendation))\n612:     .slice(0, topK);\n613:   const degradedLanes = result.metrics.degradedLanes ?? [];\n614:   const warnings = outputWarnings(status, result);\n615:   const abstainReasons = outputAbstainReasons(input, result);\n616:   const output: AdvisorRecommendOutput = {\n617:     workspaceRoot,\n618:     effectiveThresholds,\n619:     recommendations,\n620:     ambiguous: result.ambiguous,\n621:     freshness: status.freshness,\n622:     trustState: status.trustState,\n623:     generatedAt: new Date().toISOString(),\n624:     cache: {\n625:       hit: false,\n626:       sourceSignaturePresent: status.generation > 0 || status.lastGenerationBump !== null,\n627:     },\n628:     _shadow: {\n629:       model: 'advisor-shadow-learned-weights-v1',\n630:       liveWeightsFrozen: true,\n631:       recommendations: publicShadowRecommendations(result.recommendations, topK),\n632:     },\n633:     ...(degradedLanes.length > 0 ? {\n634:       runtimeLaneHealth: {\n635:         liveLaneCount: result.metrics.liveLaneCount,\n636:         degradedLanes: [...degradedLanes],\n637:       },\n638:     } : {}),\n639:     ...(warnings.length > 0 ? { warnings } : {}),\n640:     ...(abstainReasons.length > 0 ? { abstainReasons } : {}),\n641:   };\n642:   const parsed = AdvisorRecommendOutputSchema.parse(output);\n643:   if (shadowDeltaSinkEnabled()) {\n644:     for (const shadow of parsed._shadow?.recommendations ?? []) {\n645:       recordShadowDelta({\n646:         prompt: `hmac:${key}`,\n647:         recommendation: shadow.skillId,\n648:         liveScore: shadow.liveScore,\n649:         shadowScore: shadow.shadowScore,\n650:         delta: shadow.delta,\n651:         dominantLane: shadow.dominantShadowLane,\n652:         timestamp: parsed.generatedAt,\n653:       });\n654:     }\n655:   }\n656:   advisorPromptCache.set({\n657:     key,\n658:     sourceSignature,\n659:     value: parsed,\n660:     skillLabels: recommendationLabels(parsed),\n661:   });\n662:   return input.options?.includeCompiledRoute === false\n663:     ? parsed\n664:     : enrichCompiledRoutes(parsed, input.prompt, workspaceRoot, input.options?.surfaceHint, input.options?.compiledRouteTopOnly === true);\n665: }\n666: \n667: // ───────────────────────────────────────────────────────────────────\n668: // 5. EXPORTS\n669: // ───────────────────────────────────────────────────────────────────\n670: \n671: export async function handleAdvisorRecommend(args: unknown): Promise<HandlerResponse> {\n672:   const input = AdvisorRecommendInputSchema.parse(args);\n673:   // Canonicalize via realpath after the schema allowlist check.\n674:   const workspaceRoot = input.workspaceRoot\n675:     ? canonicalizeWorkspaceRoot(input.workspaceRoot)\n676:     : findWorkspaceRoot();\n677:   const effectiveThresholds = publicThresholds({\n678:     confidenceThreshold: input.options?.confidenceThreshold,\n679:     uncertaintyThreshold: input.options?.uncertaintyThreshold,\n680:   });\n681:   const disabledBy = ADVISOR_DISABLED_FLAGS.find((flag) => process.env[flag] === '1');\n682:   const data = disabledBy\n683:     ? disabledOutput(workspaceRoot, effectiveThresholds, disabledBy)\n684:     : await computeRecommendationOutput(input);\n685:   return {\n686:     content: [{\n687:       type: 'text',\n688:       text: JSON.stringify({ status: 'ok', data }, null, 2),\n689:     }],\n690:   };\n691: }\n692: ","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/handlers/advisor-recommend.ts, lines 1-692\n1: // ───────────────────────────────────────────────────────────────\n2: // MODULE: advisor_recommend Handler\n3: // ───────────────────────────────────────────────────────────────\n4: \n5: // ───────────────────────────────────────────────────────────────────\n6: // 1. IMPORTS\n7: // ───────────────────────────────────────────────────────────────────\n8: \n9: import { execFileSync } from 'node:child_process';\n10: import { readFileSync, realpathSync } from 'node:fs';\n11: import { resolve } from 'node:path';\n12: \n13: import { attachCommand, commandRowFor } from '../lib/command-attach.js';\n14: import { advisorPromptCache } from '../lib/prompt-cache.js';\n15: import {\n16:   resolveAdvisorThresholdConfig,\n17: } from '../lib/skill-advisor-brief.js';\n18: import { scoreAdvisorPrompt } from '../lib/scorer/fusion.js';\n19: import { COMMAND_BRIDGES } from '../lib/scorer/projection.js';\n20: import {\n21:   DEEP_ROUTING_PROJECTION_HASH,\n22:   MERGED_DEEP_SKILL_ID,\n23:   modeForAlias,\n24:   modeForPromptAlias,\n25: } from '../lib/scorer/aliases.js';\n26: import { withSemanticShadowPromptEmbedding } from '../lib/scorer/lanes/semantic-shadow.js';\n27: import { DEFAULT_SHADOW_SCORER_LANE_WEIGHTS } from '../lib/scorer/lane-registry.js';\n28: import { sanitizeSkillLabel } from '../lib/render.js';\n29: import { recordShadowDelta, shadowDeltaSinkEnabled } from '../lib/shadow/shadow-sink.js';\n30: import { findAdvisorWorkspaceRoot } from '../lib/utils/workspace-root.js';\n31: import {\n32:   AdvisorRecommendInputSchema,\n33:   AdvisorRecommendOutputSchema,\n34:   type AdvisorRecommendInput,\n35:   type AdvisorRecommendOutput,\n36: } from '../schemas/advisor-tool-schemas.js';\n37: import { readAdvisorStatus } from './advisor-status.js';\n38: import {\n39:   COMPILED_ROUTING_HUBS,\n40:   compiledRoutingEnabledForHub,\n41:   parseCompiledRoutingFlagMode,\n42: } from '../lib/compiled-routing-flag.js';\n43: import type { AdvisorScoringOptions } from '../lib/scorer/types.js';\n44: \n45: // ───────────────────────────────────────────────────────────────────\n46: // 2. TYPE DEFINITIONS\n47: // ───────────────────────────────────────────────────────────────────\n48: \n49: type HandlerResponse = { content: Array<{ type: string; text: string }> };\n50: type AdvisorStatus = ReturnType<typeof readAdvisorStatus>;\n51: type ScoredRecommendation = ReturnType<typeof scoreAdvisorPrompt>['recommendations'][number];\n52: type PublicRecommendationStatus = NonNullable<AdvisorRecommendOutput['recommendations'][number]['status']>;\n53: type PublicThresholds = AdvisorRecommendOutput['effectiveThresholds'];\n54: type ShadowRecommendation = NonNullable<AdvisorRecommendOutput['_shadow']>['recommendations'][number];\n55: \n56: // ───────────────────────────────────────────────────────────────────\n57: // 3. HELPERS\n58: // ───────────────────────────────────────────────────────────────────\n59: \n60: // Emit-only, stderr, debug-gated compiled-routing diagnostic. Never written to\n61: // stdout or the tool response, and never changes the recommendation outcome.\n62: function emitCompiledRoutingBreadcrumb(message: string): void {\n63:   if (process.env.SPECKIT_COMPILED_ROUTING_DEBUG) {\n64:     process.stderr.write(`[compiled-routing] ${message}\\n`);\n65:   }\n66: }\n67: \n68: function findWorkspaceRoot(start = process.cwd()): string {\n69:   return findAdvisorWorkspaceRoot(start, { maxDepth: 12 });\n70: }\n71: \n72: // Canonicalize a caller-supplied workspaceRoot via realpath.\n73: // The schema-level allowlist refinement runs against the same canonical\n74: // form, so a caller passing /tmp/symlink-to-repo gets the real path\n75: // post-symlink before downstream code uses it.\n76: function canonicalizeWorkspaceRoot(input: string): string {\n77:   const resolved = resolve(input);\n78:   try {\n79:     return realpathSync.native(resolved);\n80:   } catch {\n81:     return resolved;\n82:   }\n83: }\n84: \n85: function cacheSourceSignature(status: AdvisorStatus): string {\n86:   return `${status.freshness}:${status.generation}:${status.lastGenerationBump ?? 'never'}:${DEEP_ROUTING_PROJECTION_HASH}`;\n87: }\n88: \n89: function recommendationLabels(output: AdvisorRecommendOutput): string[] {\n90:   return output.recommendations.map((recommendation) => recommendation.skillId);\n91: }\n92: \n93: function unavailableTrustState(reason: string): AdvisorRecommendOutput['trustState'] {\n94:   return {\n95:     state: 'unavailable',\n96:     reason,\n97:     generation: 0,\n98:     checkedAt: new Date().toISOString(),\n99:     lastLiveAt: null,\n100:   };\n101: }\n102: \n103: function publicThresholds(args: {\n104:   confidenceThreshold?: number;\n105:   uncertaintyThreshold?: number;\n106: }): PublicThresholds {\n107:   const resolved = resolveAdvisorThresholdConfig(args);\n108:   return {\n109:     confidenceThreshold: resolved.confidenceThreshold,\n110:     uncertaintyThreshold: resolved.uncertaintyThreshold,\n111:     confidenceOnly: resolved.confidenceOnly,\n112:   };\n113: }\n114: \n115: function runtimeLaneHealthForStatus(status: AdvisorStatus): AdvisorScoringOptions['runtimeLaneHealth'] | undefined {\n116:   if (status.freshness !== 'stale') {\n117:     return undefined;\n118:   }\n119:   return {\n120:     graph_causal: {\n121:       status: 'runtime_degraded',\n122:       reason: status.trustState.reason ?? 'skill_graph_stale',\n123:     },\n124:   };\n125: }\n126: \n127: function renderableStatus(status: AdvisorStatus): AdvisorStatus {\n128:   const trustState = status.trustState.state;\n129:   if (status.freshness === 'unavailable' && (trustState === 'live' || trustState === 'stale')) {\n130:     return { ...status, freshness: trustState };\n131:   }\n132:   return status;\n133: }\n134: \n135: function emptyOutput(args: {\n136:   workspaceRoot: string;\n137:   effectiveThresholds: AdvisorRecommendOutput['effectiveThresholds'];\n138:   freshness: AdvisorRecommendOutput['freshness'];\n139:   trustState: AdvisorRecommendOutput['trustState'];\n140:   warnings?: readonly string[];\n141:   abstainReasons?: readonly string[];\n142: }): AdvisorRecommendOutput {\n143:   return AdvisorRecommendOutputSchema.parse({\n144:     workspaceRoot: args.workspaceRoot,\n145:     effectiveThresholds: args.effectiveThresholds,\n146:     recommendations: [],\n147:     ambiguous: false,\n148:     freshness: args.freshness,\n149:     trustState: args.trustState,\n150:     generatedAt: new Date().toISOString(),\n151:     cache: {\n152:       hit: false,\n153:       sourceSignaturePresent: false,\n154:     },\n155:     ...(args.warnings && args.warnings.length > 0 ? { warnings: [...args.warnings] } : {}),\n156:     ...(args.abstainReasons && args.abstainReasons.length > 0 ? { abstainReasons: [...args.abstainReasons] } : {}),\n157:   });\n158: }\n159: \n160: // The canonical flag is checked first so the reason names it when both are set.\n161: const ADVISOR_DISABLED_FLAGS = [\n162:   'SYSTEM_SKILL_ADVISOR_HOOK_DISABLED',\n163:   'SPECKIT_SKILL_ADVISOR_HOOK_DISABLED',\n164: ] as const;\n165: \n166: function disabledOutput(\n167:   workspaceRoot: string,\n168:   effectiveThresholds: PublicThresholds,\n169:   disabledBy: string,\n170: ): AdvisorRecommendOutput {\n171:   return emptyOutput({\n172:     workspaceRoot,\n173:     effectiveThresholds,\n174:     freshness: 'unavailable',\n175:     trustState: unavailableTrustState('ADVISOR_DISABLED'),\n176:     warnings: ['ADVISOR_DISABLED'],\n177:     abstainReasons: [`Skill advisor disabled by ${disabledBy}.`],\n178:   });\n179: }\n180: \n181: function absentOutput(\n182:   status: AdvisorStatus,\n183:   workspaceRoot: string,\n184:   effectiveThresholds: AdvisorRecommendOutput['effectiveThresholds'],\n185: ): AdvisorRecommendOutput {\n186:   return emptyOutput({\n187:     workspaceRoot,\n188:     effectiveThresholds,\n189:     freshness: 'absent',\n190:     trustState: status.trustState,\n191:     warnings: [status.trustState.reason ?? 'ADVISOR_FRESHNESS_ABSENT'],\n192:     abstainReasons: ['Skill advisor freshness is absent; returning fail-open empty recommendations.'],\n193:   });\n194: }\n195: \n196: function unavailableOutput(\n197:   status: AdvisorStatus,\n198:   workspaceRoot: string,\n199:   effectiveThresholds: AdvisorRecommendOutput['effectiveThresholds'],\n200: ): AdvisorRecommendOutput {\n201:   return emptyOutput({\n202:     workspaceRoot,\n203:     effectiveThresholds,\n204:     freshness: 'unavailable',\n205:     trustState: {\n206:       ...status.trustState,\n207:       state: 'unavailable',\n208:       reason: 'advisor_unavailable',\n209:     },\n210:     warnings: ['advisor_unavailable', ...(status.errors ?? [])],\n211:     abstainReasons: ['Skill advisor freshness is unavailable; returning fail-open empty recommendations.'],\n212:   });\n213: }\n214: \n215: function safeMany(values: readonly string[] | undefined): string[] {\n216:   return (values ?? [])\n217:     .map((value) => sanitizeSkillLabel(value))\n218:     .filter((value): value is string => Boolean(value));\n219: }\n220: \n221: function evidenceFeature(value: string): string {\n222:   const prefix = value.split(':', 1)[0];\n223:   switch (prefix) {\n224:     case 'phrase':\n225:       return 'phrase_match';\n226:     case 'token':\n227:       return 'token_match';\n228:     case 'hint':\n229:       return 'category_hint';\n230:     case 'derived':\n231:       return 'derived_skill_signal';\n232:     case 'doc':\n233:       return 'doc_reference_signal';\n234:     case 'cosine':\n235:       return 'semantic_similarity';\n236:     default:\n237:       if (value.includes('disambiguation')) return 'disambiguation_rule';\n238:       if (value.includes('surface')) return 'surface_signal';\n239:       if (value.includes('intent')) return 'intent_signal';\n240:       if (value.includes('loop')) return 'workflow_signal';\n241:       return 'scorer_signal';\n242:   }\n243: }\n244: \n245: function publicWhyRecommended(recommendation: ScoredRecommendation) {\n246:   const positiveLanes = recommendation.laneContributions\n247:     .filter((lane) => lane.rawScore > 0 || lane.weightedScore > 0)\n248:     .sort((left, right) => right.weightedScore - left.weightedScore)\n249:     .slice(0, 4);\n250:   const matchedSkillFeatures = positiveLanes.flatMap((lane) => (\n251:     Array.from(new Set(lane.evidence.map((entry) => evidenceFeature(entry)))).map((feature) => ({\n252:       lane: lane.lane,\n253:       feature,\n254:     }))\n255:   ));\n256:   const dominant = recommendation.dominantLane;\n257:   return {\n258:     reason: dominant\n259:       ? `Recommended from ranker signals: ${dominant} contributed the strongest live score.`\n260:       : 'Recommended from ranker signals without a single dominant live lane.',\n261:     dominantLane: dominant,\n262:     topLanes: positiveLanes.map((lane) => ({\n263:       lane: lane.lane,\n264:       rawScore: lane.rawScore,\n265:       weightedScore: lane.weightedScore,\n266:       weight: lane.weight,\n267:       shadowOnly: lane.shadowOnly,\n268:       evidenceTypes: Array.from(new Set(lane.evidence.map((entry) => evidenceFeature(entry)))),\n269:       evidenceCount: lane.evidence.length,\n270:     })),\n271:     matchedSkillFeatures,\n272:   };\n273: }\n274: \n275: // Doc evidence entries are skill-relative markdown paths emitted by the\n276: // derived lane as `doc:<path>`. The allowlist rejects anything that\n277: // could smuggle prompt content or path traversal into the response.\n278: const SAFE_DOC_PATH = /^(references|assets)\\/[A-Za-z0-9_./-]+\\.md$/;\n279: \n280: export function matchedDocsFromContributions(\n281:   recommendation: { readonly laneContributions: ReadonlyArray<{ readonly evidence: readonly string[] }> },\n282: ): string[] {\n283:   const docs: string[] = [];\n284:   for (const lane of recommendation.laneContributions) {\n285:     for (const entry of lane.evidence) {\n286:       if (!entry.startsWith('doc:')) continue;\n287:       const path = entry.slice(4);\n288:       if (!SAFE_DOC_PATH.test(path) || path.includes('..')) continue;\n289:       if (!docs.includes(path)) docs.push(path);\n290:       if (docs.length >= 3) return docs;\n291:     }\n292:   }\n293:   return docs;\n294: }\n295: \n296: function workflowModeForRecommendation(\n297:   recommendation: ScoredRecommendation,\n298:   prompt: string,\n299: ): string | undefined {\n300:   const directMode = modeForAlias(recommendation.skill);\n301:   const promptMode = recommendation.skill === MERGED_DEEP_SKILL_ID\n302:     ? modeForPromptAlias(prompt)\n303:     : null;\n304:   const workflowMode = sanitizeSkillLabel(directMode ?? promptMode ?? '');\n305:   return workflowMode || undefined;\n306: }\n307: \n308: function publicRecommendation(\n309:   recommendation: ScoredRecommendation,\n310:   includeAttribution: boolean,\n311:   prompt: string,\n312: ) {\n313:   const skillId = sanitizeSkillLabel(recommendation.skill);\n314:   if (!skillId) return null;\n315:   const commandRow = commandRowFor(recommendation.skill);\n316:   const matchedDocs = matchedDocsFromContributions(recommendation);\n317:   const redirectFrom = safeMany(recommendation.redirectFrom);\n318:   const redirectTo = sanitizeSkillLabel(recommendation.redirectTo ?? '');\n319:   const heldBelow = sanitizeSkillLabel(recommendation.heldBelow ?? '');\n320:   const sanitizedStatus = sanitizeSkillLabel(recommendation.lifecycleStatus);\n321:   const status: PublicRecommendationStatus | undefined = sanitizedStatus === 'active'\n322:     || sanitizedStatus === 'deprecated'\n323:     || sanitizedStatus === 'archived'\n324:     || sanitizedStatus === 'future'\n325:     ? sanitizedStatus as PublicRecommendationStatus\n326:     : undefined;\n327:   const workflowMode = workflowModeForRecommendation(recommendation, prompt);\n328:   return {\n329:     skillId,\n330:     kind: recommendation.kind,\n331:     score: recommendation.score,\n332:     confidence: recommendation.confidence,\n333:     uncertainty: recommendation.uncertainty,\n334:     dominantLane: recommendation.dominantLane,\n335:     ...(includeAttribution ? {\n336:       laneBreakdown: recommendation.laneContributions.map((lane) => ({\n337:         lane: lane.lane,\n338:         rawScore: lane.rawScore,\n339:         weightedScore: lane.weightedScore,\n340:         weight: lane.weight,\n341:         shadowOnly: lane.shadowOnly,\n342:       })),\n343:       why_recommended: publicWhyRecommended(recommendation),\n344:     } : {}),\n345:     ...(matchedDocs.length > 0 ? { matchedDocs } : {}),\n346:     ...(redirectFrom.length > 0 ? { redirectFrom } : {}),\n347:     ...(redirectTo ? { redirectTo } : {}),\n348:     // Hook briefs re-derive ambiguity from the public list, so a skill the typed\n349:     // command already ranked below its seed has to say so here.\n350:     ...(heldBelow ? { heldBelow } : {}),\n351:     ...(status ? { status } : {}),\n352:     ...(workflowMode ? { workflowMode } : {}),\n353:     // A command row is the contract a reader acts on, so its runnable string,\n354:     // policy and owner travel with the pick. An id with no row adds nothing.\n355:     ...(commandRow ? {\n356:       command: commandRow.command,\n357:       ...(commandRow.policy ? { policy: commandRow.policy } : {}),\n358:       ownerSkillId: commandRow.ownerSkillId,\n359:     } : {}),\n360:   };\n361: }\n362: \n363: // The front door runs from the request's workspaceRoot, and a caller may name\n364: // another checkout there, such as a worktree under the repository root. Its copy\n365: // can predate --prompt-stdin and would resolve an empty prompt, so such a copy\n366: // gets no compiled route rather than the prompt in argv.\n367: export function frontDoorReadsPromptFromStdin(frontDoorPath: string): boolean {\n368:   try {\n369:     return readFileSync(frontDoorPath, 'utf8').includes('--prompt-stdin');\n370:   } catch {\n371:     return false;\n372:   }\n373: }\n374: \n375: function compiledRouteForRecommendation(\n376:   skillId: string,\n377:   prompt: string,\n378:   workspaceRoot: string,\n379:   surfaceHint?: string,\n380: ): Record<string, unknown> | undefined {\n381:   if (!COMPILED_ROUTING_HUBS.has(skillId)) return undefined;\n382:   const frontDoor = resolve(workspaceRoot, '.skilled', 'bin', 'compiled-route.cjs');\n383:   if (!frontDoorReadsPromptFromStdin(frontDoor)) {\n384:     emitCompiledRoutingBreadcrumb(`compiled-route front door cannot read the prompt from stdin; skipping hub=${skillId}`);\n385:     return undefined;\n386:   }\n387:   try {\n388:     const args = [\n389:       frontDoor,\n390:       '--hub',\n391:       skillId,\n392:       '--prompt-stdin',\n393:     ];\n394:     // A hint the caller already holds is forwarded as its own argv element;\n395:     // the front door ignores a value that names no known surface.\n396:     if (surfaceHint) args.push('--surface-hint', surfaceHint);\n397:     const output = execFileSync(process.execPath, args, {\n398:       cwd: workspaceRoot,\n399:       encoding: 'utf8',\n400:       input: prompt,\n401:       stdio: ['pipe', 'pipe', 'pipe'],\n402:       timeout: 5_000,\n403:       maxBuffer: 1_048_576,\n404:     });\n405:     const parsed: unknown = JSON.parse(output.trim());\n406:     if (typeof parsed !== 'object' || parsed === null || Array.isArray(parsed)) {\n407:       return undefined;\n408:     }\n409:     const compiledRoute = parsed as Record<string, unknown>;\n410:     return compiledRoute.servingAuthority === 'legacy' ? undefined : compiledRoute;\n411:   } catch (error) {\n412:     // Surface the otherwise-silent fallback (debug-gated), including any child\n413:     // stderr the pipe above now captures instead of discarding. The served\n414:     // outcome is unchanged: a failed probe attaches no compiled route (legacy).\n415:     const childStderr = (error as { stderr?: unknown } | null)?.stderr;\n416:     const detail = typeof childStderr === 'string' && childStderr.trim()\n417:       ? ` child-stderr=${childStderr.trim()}`\n418:       : '';\n419:     emitCompiledRoutingBreadcrumb(\n420:       `compiled-route subprocess failed for hub=${skillId}: ${error instanceof Error ? error.message : String(error)}${detail}`,\n421:     );\n422:     return undefined;\n423:   }\n424: }\n425: \n426: // Every command row lists its slash string among its keywords, which is the one\n427: // place the row states what a reader types.\n428: const BRIDGE_COMMAND_BY_ID: ReadonlyMap<string, string> = new Map(\n429:   COMMAND_BRIDGES.flatMap((bridge) => {\n430:     const command = bridge.keywords.find((keyword) => keyword.startsWith('/'));\n431:     return command ? [[bridge.id, command] as const] : [];\n432:   }),\n433: );\n434: \n435: function enrichCompiledRoutes(\n436:   output: AdvisorRecommendOutput,\n437:   prompt: string,\n438:   workspaceRoot: string,\n439:   surfaceHint?: string,\n440:   topOnly = false,\n441: ): AdvisorRecommendOutput {\n442:   const mode = parseCompiledRoutingFlagMode(process.env.SPECKIT_COMPILED_ROUTING);\n443:   if (mode === 'invalid') {\n444:     emitCompiledRoutingBreadcrumb(\n445:       `ignoring invalid SPECKIT_COMPILED_ROUTING=${JSON.stringify(process.env.SPECKIT_COMPILED_ROUTING)}; serving legacy`,\n446:     );\n447:   }\n448:   // Only enrich hubs the flag permits. The default cohort now covers all 7\n449:   // compiled-eligible hubs (mirrors the runtime resolver's own default-on\n450:   // cohort), so unset attaches compiledRoute for those hubs; the kill-switch\n451:   // ('0'|'false'|'off') and invalid values still skip enrichment for every hub.\n452:   // Skip the schema re-parse entirely when nothing is eligible so the output is\n453:   // returned unchanged.\n454:   const anyEligible = output.recommendations.some((r) => compiledRoutingEnabledForHub(r.skillId));\n455:   if (!anyEligible) return output;\n456:   // A command row that already ranks in this result offers its command by itself,\n457:   // so the owning hub must not offer the same one again and spend a second slot on it.\n458:   const alreadyOffered = new Set<string>();\n459:   for (const recommendation of output.recommendations) {\n460:     const command = BRIDGE_COMMAND_BY_ID.get(recommendation.skillId);\n461:     if (command) alreadyOffered.add(command);\n462:   }\n463:   return AdvisorRecommendOutputSchema.parse({\n464:     ...output,\n465:     recommendations: output.recommendations.map((recommendation, index) => {\n466:       // Each lookup is a subprocess, so a caller that acts on the top pick alone\n467:       // pays for that one and no more.\n468:       if (topOnly && index > 0) return recommendation;\n469:       if (!compiledRoutingEnabledForHub(recommendation.skillId)) return recommendation;\n470:       const compiledRoute = compiledRouteForRecommendation(\n471:         recommendation.skillId,\n472:         prompt,\n473:         workspaceRoot,\n474:         surfaceHint,\n475:       );\n476:       if (!compiledRoute) return recommendation;\n477:       // The route answers which mode the hub would take; the command is what a reader\n478:       // types to run it, so it rides along only when the route names exactly one mode\n479:       // that has a command. A broader route leaves the key off rather than guessing.\n480:       const command = attachCommand(recommendation.skillId, compiledRoute, prompt);\n481:       return command && !alreadyOffered.has(command)\n482:         ? { ...recommendation, compiledRoute, command }\n483:         : { ...recommendation, compiledRoute };\n484:     }),\n485:   });\n486: }\n487: \n488: function publicShadowRecommendations(recommendations: readonly ScoredRecommendation[], topK: number): ShadowRecommendation[] {\n489:   const shadowRecommendations: ShadowRecommendation[] = [];\n490:   for (const recommendation of recommendations) {\n491:     const skillId = sanitizeSkillLabel(recommendation.skill);\n492:     if (!skillId) continue;\n493:     const shadowContributions = recommendation.laneContributions.map((lane) => ({\n494:       lane: lane.lane,\n495:       weightedScore: lane.rawScore * DEFAULT_SHADOW_SCORER_LANE_WEIGHTS[lane.lane],\n496:     }));\n497:     const shadowScore = roundScore(shadowContributions.reduce((total, lane) => total + lane.weightedScore, 0));\n498:     const dominant = shadowContributions\n499:       .filter((lane) => lane.weightedScore > 0)\n500:       .sort((left, right) => right.weightedScore - left.weightedScore)[0]?.lane ?? null;\n501:     shadowRecommendations.push({\n502:         skillId,\n503:         liveScore: recommendation.score,\n504:         shadowScore,\n505:         delta: roundScore(shadowScore - recommendation.score),\n506:         dominantShadowLane: dominant,\n507:     });\n508:   }\n509:   return shadowRecommendations\n510:     .sort((left, right) => right.shadowScore - left.shadowScore || left.skillId.localeCompare(right.skillId))\n511:     .slice(0, topK);\n512: }\n513: \n514: function roundScore(value: number): number {\n515:   return Math.round(value * 1_000_000) / 1_000_000;\n516: }\n517: \n518: function outputWarnings(\n519:   status: AdvisorStatus,\n520:   result: ReturnType<typeof scoreAdvisorPrompt>,\n521: ): string[] {\n522:   const degradedLanes = result.metrics.degradedLanes ?? [];\n523:   return [\n524:     ...(status.freshness === 'stale' ? [status.trustState.reason ?? 'STALE_ADVISOR_FRESHNESS'] : []),\n525:     ...(degradedLanes.length > 0\n526:       ? [`runtime_degraded_lanes:${degradedLanes.join(',')}`]\n527:       : []),\n528:   ];\n529: }\n530: \n531: function outputAbstainReasons(\n532:   input: AdvisorRecommendInput,\n533:   result: ReturnType<typeof scoreAdvisorPrompt>,\n534: ): string[] {\n535:   if (!input.options?.includeAbstainReasons) return [];\n536:   return [\n537:     ...(result.unknown ? ['No recommendation passed confidence and uncertainty thresholds.'] : []),\n538:     ...(result.abstainReasons ?? []),\n539:   ];\n540: }\n541: \n542: // ───────────────────────────────────────────────────────────────────\n543: // 4. CORE LOGIC\n544: // ───────────────────────────────────────────────────────────────────\n545: \n546: async function computeRecommendationOutput(input: AdvisorRecommendInput): Promise<AdvisorRecommendOutput> {\n547:   // Canonicalize via realpath after the schema allowlist check.\n548:   const workspaceRoot = input.workspaceRoot\n549:     ? canonicalizeWorkspaceRoot(input.workspaceRoot)\n550:     : findWorkspaceRoot();\n551:   const effectiveThresholds = publicThresholds({\n552:     confidenceThreshold: input.options?.confidenceThreshold,\n553:     uncertaintyThreshold: input.options?.uncertaintyThreshold,\n554:   });\n555:   // Detect on-disk corruption here too: without it a malformed artifact reads\n556:   // 'live' from the generation counters and the recommend path would serve\n557:   // results as fresh. The verdict is cached per generation, so the quick_check\n558:   // runs at most once per rebuild rather than on every recommendation.\n559:   const status = renderableStatus(readAdvisorStatus({ workspaceRoot, checkArtifactIntegrity: true }));\n560:   if (status.freshness === 'unavailable') {\n561:     return unavailableOutput(status, workspaceRoot, effectiveThresholds);\n562:   }\n563:   if (status.freshness === 'absent') {\n564:     return absentOutput(status, workspaceRoot, effectiveThresholds);\n565:   }\n566:   const sourceSignature = cacheSourceSignature(status);\n567:   advisorPromptCache.invalidateSourceSignatureChange(sourceSignature);\n568:   const key = advisorPromptCache.makeKey({\n569:     canonicalPrompt: input.prompt.trim(),\n570:     sourceSignature,\n571:     workspaceRoot,\n572:     runtime: 'mcp',\n573:     maxTokens: input.options?.topK,\n574:     thresholdConfig: {\n575:       confidenceThreshold: input.options?.confidenceThreshold,\n576:       uncertaintyThreshold: input.options?.uncertaintyThreshold,\n577:       includeAttribution: input.options?.includeAttribution,\n578:       includeAbstainReasons: input.options?.includeAbstainReasons,\n579:     },\n580:   });\n581:   const cached = advisorPromptCache.get(key);\n582:   if (cached) {\n583:     const cachedOutput = cached.value as AdvisorRecommendOutput;\n584:     const parsedCachedOutput = AdvisorRecommendOutputSchema.parse({\n585:       ...cachedOutput,\n586:       workspaceRoot,\n587:       effectiveThresholds,\n588:       cache: {\n589:         ...cachedOutput.cache,\n590:         hit: true,\n591:       },\n592:     });\n593:     return input.options?.includeCompiledRoute === false\n594:       ? parsedCachedOutput\n595:       : enrichCompiledRoutes(parsedCachedOutput, input.prompt, workspaceRoot, input.options?.surfaceHint, input.options?.compiledRouteTopOnly === true);\n596:   }\n597: \n598:   const topK = input.options?.topK ?? 3;\n599:   const result = await withSemanticShadowPromptEmbedding(input.prompt, () => scoreAdvisorPrompt(input.prompt, {\n600:     workspaceRoot,\n601:     confidenceThreshold: input.options?.confidenceThreshold,\n602:     uncertaintyThreshold: input.options?.uncertaintyThreshold,\n603:     runtimeLaneHealth: runtimeLaneHealthForStatus(status),\n604:   }));\n605:   const recommendations = result.recommendations\n606:     .map((recommendation) => publicRecommendation(\n607:       recommendation,\n608:       Boolean(input.options?.includeAttribution),\n609:       input.prompt,\n610:     ))\n611:     .filter((recommendation): recommendation is NonNullable<typeof recommendation> => Boolean(recommendation))\n612:     .slice(0, topK);\n613:   const degradedLanes = result.metrics.degradedLanes ?? [];\n614:   const warnings = outputWarnings(status, result);\n615:   const abstainReasons = outputAbstainReasons(input, result);\n616:   const output: AdvisorRecommendOutput = {\n617:     workspaceRoot,\n618:     effectiveThresholds,\n619:     recommendations,\n620:     ambiguous: result.ambiguous,\n621:     freshness: status.freshness,\n622:     trustState: status.trustState,\n623:     generatedAt: new Date().toISOString(),\n624:     cache: {\n625:       hit: false,\n626:       sourceSignaturePresent: status.generation > 0 || status.lastGenerationBump !== null,\n627:     },\n628:     _shadow: {\n629:       model: 'advisor-shadow-learned-weights-v1',\n630:       liveWeightsFrozen: true,\n631:       recommendations: publicShadowRecommendations(result.recommendations, topK),\n632:     },\n633:     ...(degradedLanes.length > 0 ? {\n634:       runtimeLaneHealth: {\n635:         liveLaneCount: result.metrics.liveLaneCount,\n636:         degradedLanes: [...degradedLanes],\n637:       },\n638:     } : {}),\n639:     ...(warnings.length > 0 ? { warnings } : {}),\n640:     ...(abstainReasons.length > 0 ? { abstainReasons } : {}),\n641:   };\n642:   const parsed = AdvisorRecommendOutputSchema.parse(output);\n643:   if (shadowDeltaSinkEnabled()) {\n644:     for (const shadow of parsed._shadow?.recommendations ?? []) {\n645:       recordShadowDelta({\n646:         prompt: `hmac:${key}`,\n647:         recommendation: shadow.skillId,\n648:         liveScore: shadow.liveScore,\n649:         shadowScore: shadow.shadowScore,\n650:         delta: shadow.delta,\n651:         dominantLane: shadow.dominantShadowLane,\n652:         timestamp: parsed.generatedAt,\n653:       });\n654:     }\n655:   }\n656:   advisorPromptCache.set({\n657:     key,\n658:     sourceSignature,\n659:     value: parsed,\n660:     skillLabels: recommendationLabels(parsed),\n661:   });\n662:   return input.options?.includeCompiledRoute === false\n663:     ? parsed\n664:     : enrichCompiledRoutes(parsed, input.prompt, workspaceRoot, input.options?.surfaceHint, input.options?.compiledRouteTopOnly === true);\n665: }\n666: \n667: // ───────────────────────────────────────────────────────────────────\n668: // 5. EXPORTS\n669: // ───────────────────────────────────────────────────────────────────\n670: \n671: export async function handleAdvisorRecommend(args: unknown): Promise<HandlerResponse> {\n672:   const input = AdvisorRecommendInputSchema.parse(args);\n673:   // Canonicalize via realpath after the schema allowlist check.\n674:   const workspaceRoot = input.workspaceRoot\n675:     ? canonicalizeWorkspaceRoot(input.workspaceRoot)\n676:     : findWorkspaceRoot();\n677:   const effectiveThresholds = publicThresholds({\n678:     confidenceThreshold: input.options?.confidenceThreshold,\n679:     uncertaintyThreshold: input.options?.uncertaintyThreshold,\n680:   });\n681:   const disabledBy = ADVISOR_DISABLED_FLAGS.find((flag) => process.env[flag] === '1');\n682:   const data = disabledBy\n683:     ? disabledOutput(workspaceRoot, effectiveThresholds, disabledBy)\n684:     : await computeRecommendationOutput(input);\n685:   return {\n686:     content: [{\n687:       type: 'text',\n688:       text: JSON.stringify({ status: 'ok', data }, null, 2),\n689:     }],\n690:   };\n691: }\n692: "}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/handlers/advisor-recommend.ts\"}"},"time":{"start":1794527525004,"end":1794527525409}}}}
