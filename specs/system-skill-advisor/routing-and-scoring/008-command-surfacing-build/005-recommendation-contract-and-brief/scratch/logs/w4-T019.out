irely when nothing is eligible so the output is\n443:   // returned unchanged.\n444:   const anyEligible = output.recommendations.some((r) => compiledRoutingEnabledForHub(r.skillId));\n445:   if (!anyEligible) return output;\n446:   // A command row that already ranks in this result offers its command by itself,\n447:   // so the owning hub must not offer the same one again and spend a second slot on it.\n448:   const alreadyOffered = new Set<string>();\n449:   for (const recommendation of output.recommendations) {\n450:     if (recommendation.command) alreadyOffered.add(recommendation.command);\n451:   }\n452:   return AdvisorRecommendOutputSchema.parse({\n453:     ...output,\n454:     recommendations: output.recommendations.map((recommendation, index) => {\n455:       // Each lookup is a subprocess, so a caller that acts on the top pick alone\n456:       // pays for that one and no more.\n457:       if (topOnly && index > 0) return recommendation;\n458:       if (!compiledRoutingEnabledForHub(recommendation.skillId)) return recommendation;\n459:       const compiledRoute = compiledRouteForRecommendation(\n460:         recommendation.skillId,\n461:         prompt,\n462:         workspaceRoot,\n463:         surfaceHint,\n464:       );\n465:       if (!compiledRoute) return recommendation;\n466:       // The route answers which mode the hub would take; the command is what a reader\n467:       // types to run it, so it rides along only when the route names exactly one mode\n468:       // that has a command. A broader route leaves the key off rather than guessing.\n469:       const command = attachCommand(recommendation.skillId, compiledRoute, prompt);\n470:       return command && !alreadyOffered.has(command)\n471:         ? {\n472:           ...recommendation,\n473:           compiledRoute,\n474:           command,\n475:           ...(Object.hasOwn(COMMAND_POLICIES, command) ? { policy: COMMAND_POLICIES[command] } : {}),\n476:         }\n477:         : { ...recommend