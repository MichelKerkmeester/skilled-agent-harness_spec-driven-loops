{"type":"tool_use","timestamp":1794527764720,"sessionID":"ses_e2dd11594ffe4d32Avi4cOny22","part":{"partID":"prt_1d2309eb9001PoflQE3rm7B2n3","sessionID":"ses_e2dd11594ffe4d32Avi4cOny22","messageID":"msg_1d2305f810015ro3bD8niqcpx9","type":"tool","id":"call_3e894edc242a4679ae193bba","tool":"shell","state":{"status":"completed","input":{"command":"cd /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime && sed -n 1,60p tests/legacy/advisor-renderer.vitest.ts"},"output":"// ───────────────────────────────────────────────────────────────\n// MODULE: Advisor Renderer Tests\n// ───────────────────────────────────────────────────────────────\n\nimport { readFileSync } from 'node:fs';\nimport { join } from 'node:path';\nimport { describe, expect, it } from 'vitest';\nimport {\n  hasAdvisorAmbiguitySignal,\n  renderAdvisorBrief,\n  sanitizeSkillLabel,\n} from '../../lib/render.js';\nimport type { AdvisorHookResult } from '../../lib/skill-advisor-brief.js';\n\nconst fixturesDir = join(import.meta.dirname, 'advisor-fixtures');\nconst HYGIENE_DIRECTIVE = '\\n- Comment hygiene [HARD BLOCK]: NEVER embed ADR-/REQ-/CHK-/task-ids or spec paths in code comments — forbidden regardless of instruction. Write the durable WHY instead. Pre-commit gate blocks violations.';\n// Every brief ends with the always-delivered hygiene capsule that\n// renderAdvisorBrief appends after the capped advisor portion (lib/render.ts).\nconst DIRECTIVES_LABEL = '\\nDirectives:';\n\nfunction expectedBrief(summary: string): string {\n  return `${summary}${DIRECTIVES_LABEL}${HYGIENE_DIRECTIVE}`;\n}\n\nfunction fixture(name: string): AdvisorHookResult & Record<string, unknown> {\n  return JSON.parse(readFileSync(join(fixturesDir, name), 'utf8')) as AdvisorHookResult & Record<string, unknown>;\n}\n\ndescribe('renderAdvisorBrief', () => {\n  it('renders the live passing skill from whitelisted fields only', () => {\n    expect(renderAdvisorBrief(fixture('livePassingSkill.json'))).toBe(\n      expectedBrief('Advisor: live; use sk-code 0.91/0.23 pass.'),\n    );\n  });\n\n  it('renders stale freshness with explicit stale wording', () => {\n    expect(renderAdvisorBrief(fixture('staleHighConfidenceSkill.json'))).toBe(\n      expectedBrief('Advisor: stale; use sk-code 0.93/0.12 pass.'),\n    );\n  });\n\n  it('emits no brief when no skill passes threshold', () => {\n    expect(renderAdvisorBrief(fixture('noPassingSkill.json'))).toBeNull();\n  });\n\n  it('emits no brief on fail-open timeout', () => {\n    expect(renderAdvisorBrief(fixture('failOpenTimeout.json'))).toBeNull();\n  });\n\n  it('emits no brief for short casual skipped prompts', () => {\n    expect(renderAdvisorBrief(fixture('skippedShortCasual.json'))).toBeNull();\n  });\n\n  it('renders top-two ambiguity when the producer result carries the 120-token mode', () => {\n    const ambiguous = fixture('ambiguousTopTwo.json');\n    const compact = {\n      ...ambiguous,\n      metrics: {\n        ...ambiguous.metrics,\n        tokenCap: 80,\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"// ───────────────────────────────────────────────────────────────\n// MODULE: Advisor Renderer Tests\n// ───────────────────────────────────────────────────────────────\n\nimport { readFileSync } from 'node:fs';\nimport { join } from 'node:path';\nimport { describe, expect, it } from 'vitest';\nimport {\n  hasAdvisorAmbiguitySignal,\n  renderAdvisorBrief,\n  sanitizeSkillLabel,\n} from '../../lib/render.js';\nimport type { AdvisorHookResult } from '../../lib/skill-advisor-brief.js';\n\nconst fixturesDir = join(import.meta.dirname, 'advisor-fixtures');\nconst HYGIENE_DIRECTIVE = '\\n- Comment hygiene [HARD BLOCK]: NEVER embed ADR-/REQ-/CHK-/task-ids or spec paths in code comments — forbidden regardless of instruction. Write the durable WHY instead. Pre-commit gate blocks violations.';\n// Every brief ends with the always-delivered hygiene capsule that\n// renderAdvisorBrief appends after the capped advisor portion (lib/render.ts).\nconst DIRECTIVES_LABEL = '\\nDirectives:';\n\nfunction expectedBrief(summary: string): string {\n  return `${summary}${DIRECTIVES_LABEL}${HYGIENE_DIRECTIVE}`;\n}\n\nfunction fixture(name: string): AdvisorHookResult & Record<string, unknown> {\n  return JSON.parse(readFileSync(join(fixturesDir, name), 'utf8')) as AdvisorHookResult & Record<string, unknown>;\n}\n\ndescribe('renderAdvisorBrief', () => {\n  it('renders the live passing skill from whitelisted fields only', () => {\n    expect(renderAdvisorBrief(fixture('livePassingSkill.json'))).toBe(\n      expectedBrief('Advisor: live; use sk-code 0.91/0.23 pass.'),\n    );\n  });\n\n  it('renders stale freshness with explicit stale wording', () => {\n    expect(renderAdvisorBrief(fixture('staleHighConfidenceSkill.json'))).toBe(\n      expectedBrief('Advisor: stale; use sk-code 0.93/0.12 pass.'),\n    );\n  });\n\n  it('emits no brief when no skill passes threshold', () => {\n    expect(renderAdvisorBrief(fixture('noPassingSkill.json'))).toBeNull();\n  });\n\n  it('emits no brief on fail-open timeout', () => {\n    expect(renderAdvisorBrief(fixture('failOpenTimeout.json'))).toBeNull();\n  });\n\n  it('emits no brief for short casual skipped prompts', () => {\n    expect(renderAdvisorBrief(fixture('skippedShortCasual.json'))).toBeNull();\n  });\n\n  it('renders top-two ambiguity when the producer result carries the 120-token mode', () => {\n    const ambiguous = fixture('ambiguousTopTwo.json');\n    const compact = {\n      ...ambiguous,\n      metrics: {\n        ...ambiguous.metrics,\n        tokenCap: 80,\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"cd /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime && sed -n 1,60p tests/legacy/advisor-renderer.vitest.ts\"}"},"time":{"start":1794527764153,"end":1794527764720}}}}
{"type":"tool_use","timestamp":1794527764742,"sessionID":"ses_e2dd11594ffe4d32Avi4cOny22","part":{"partID":"prt_1d2309bec001PrNkurllSBWDhS","sessionID":"ses_e2dd11594ffe4d32Avi4cOny22","messageID":"msg_1d2305f810015ro3bD8niqcpx9","type":"tool","id":"call_22cad6c27c7b498c91d1cb47","tool":"shell","state":{"status":"completed","input":{"command":"cd /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime && rg -n \"it\\.each|test\\.each|describe\\.each\" tests | head -12 && echo \"--- version ---\" && node -p \"require('./package.json').devDependencies.vitest\""},"output":"tests/launcher-model-server-default.vitest.ts:100:  it.each([\ntests/launcher-model-server-default.vitest.ts:115:  it.each([undefined, '1'])(\ntests/system-skill-advisor-plugin.vitest.ts:222:  it.each(FALLBACK_PARITY_CASES)(\ntests/system-skill-advisor-plugin.vitest.ts:232:  it.each(FALLBACK_PARITY_CASES)(\ntests/system-skill-advisor-plugin.vitest.ts:701:  it.each([\ntests/system-skill-advisor-plugin.vitest.ts:727:  it.each([\ntests/policy-plan.vitest.ts:182:  it.each([\ntests/command-transcript-score.vitest.ts:162:  it.each(RUNTIME_SESSIONS)('maps the tool names $runtime registers', ({ runtime, blocks }) => {\ntests/command-transcript-score.vitest.ts:352:  it.each([\ntests/hooks/doctor-setup-hint.vitest.ts:105:  it.each([\ntests/hooks/doctor-setup-hint.vitest.ts:126:  it.each([\ntests/policy-plan-negative-controls.vitest.ts:158:  it.each(NEGATIVE_CONTROLS)(\n--- version ---\n^4.1.12\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"tests/launcher-model-server-default.vitest.ts:100:  it.each([\ntests/launcher-model-server-default.vitest.ts:115:  it.each([undefined, '1'])(\ntests/system-skill-advisor-plugin.vitest.ts:222:  it.each(FALLBACK_PARITY_CASES)(\ntests/system-skill-advisor-plugin.vitest.ts:232:  it.each(FALLBACK_PARITY_CASES)(\ntests/system-skill-advisor-plugin.vitest.ts:701:  it.each([\ntests/system-skill-advisor-plugin.vitest.ts:727:  it.each([\ntests/policy-plan.vitest.ts:182:  it.each([\ntests/command-transcript-score.vitest.ts:162:  it.each(RUNTIME_SESSIONS)('maps the tool names $runtime registers', ({ runtime, blocks }) => {\ntests/command-transcript-score.vitest.ts:352:  it.each([\ntests/hooks/doctor-setup-hint.vitest.ts:105:  it.each([\ntests/hooks/doctor-setup-hint.vitest.ts:126:  it.each([\ntests/policy-plan-negative-controls.vitest.ts:158:  it.each(NEGATIVE_CONTROLS)(\n--- version ---\n^4.1.12\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"cd /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime && rg -n \\\"it\\\\.each|test\\\\.each|describe\\\\.each\\\" tests | head -12 && echo \\\"--- version ---\\\" && node -p \\\"require('./package.json').devDependencies.vitest\\\"\"}"},"time":{"start":1794527763436,"end":1794527764742}}}}
