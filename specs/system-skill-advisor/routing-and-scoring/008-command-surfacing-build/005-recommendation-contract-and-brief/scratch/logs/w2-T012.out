eys,\n1337:   derivePolicy,\n1338:   metadataRiskRecords,\n1339:   doctorRiskRecords,\n1340:   doctorLeadPhrases,\n1341:   identityViolations,\n1342:   commandPolicies,\n1343: };"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/scripts/command-bridges/derive-command-bridges.cjs\",\"offset\":1300,\"limit\":80}"},"time":{"start":1794526800213,"end":1794526800810}}}}
