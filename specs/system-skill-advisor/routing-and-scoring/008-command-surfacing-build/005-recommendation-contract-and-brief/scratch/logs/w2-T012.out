{"type":"tool_use","timestamp":1794526797051,"sessionID":"ses_e2dded17affesGmz6buFRezyjx","part":{"partID":"prt_1d221db6900121fv9Jj2gsLTfb","sessionID":"ses_e2dded17affesGmz6buFRezyjx","messageID":"msg_1d221d20d001RGKoxsYM08iYjA","type":"tool","id":"call_ea67d53513ae42dfbf0b7867","tool":"read","state":{"status":"completed","input":{"path":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/scripts/command-bridges/derive-command-bridges.cjs"},"output":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/scripts/command-bridges/derive-command-bridges.cjs, lines 1-1308\n1: // ───────────────────────────────────────────────────────────────────\n2: // MODULE: Derive Command Bridges\n3: // ───────────────────────────────────────────────────────────────────\n4: \n5: 'use strict';\n6: \n7: // ───────────────────────────────────────────────────────────────────\n8: // 1. IMPORTS\n9: // ───────────────────────────────────────────────────────────────────\n10: \n11: const { existsSync, readFileSync, readdirSync, writeFileSync } = require('node:fs');\n12: const { join, relative, resolve, sep } = require('node:path');\n13: \n14: // ───────────────────────────────────────────────────────────────────\n15: // 2. CONSTANTS\n16: // ───────────────────────────────────────────────────────────────────\n17: \n18: const COMMAND_BRIDGES_DIR = __dirname;\n19: const REPO_ROOT = resolve(COMMAND_BRIDGES_DIR, '../../../../../..');\n20: const SKILLS_ROOT = join(REPO_ROOT, '.skilled', 'skills');\n21: // One folder per command group, one Markdown file per command: the tree the\n22: // inventory identity check reads.\n23: const COMMANDS_ROOT = join(REPO_ROOT, '.skilled', 'commands');\n24: const ALLOW_LIST_PATH = join(COMMAND_BRIDGES_DIR, 'allow-list.json');\n25: const DOCTOR_COMMANDS_DIR = join(COMMANDS_ROOT, 'doctor');\n26: const DOCTOR_ROUTES_PATH = join(DOCTOR_COMMANDS_DIR, '_routes.yaml');\n27: const COMPATIBILITY_PATH = join(COMMAND_BRIDGES_DIR, 'scoring-compatibility.json');\n28: const OUTPUT_PATH = join(COMMAND_BRIDGES_DIR, 'command-bridges.generated.json');\n29: const TS_PROJECTION_PATH = join(\n30:   SKILLS_ROOT,\n31:   'system-skill-advisor',\n32:   'runtime',\n33:   'lib',\n34:   'scorer',\n35:   'projection.ts',\n36: );\n37: const PY_ADVISOR_PATH = join(\n38:   SKILLS_ROOT,\n39:   'system-skill-advisor',\n40:   'runtime',\n41:   'scripts',\n42:   'skill_advisor.py',\n43: );\n44: const TS_GENERATED_START = '// BEGIN GENERATED COMMAND BRIDGES';\n45: const TS_GENERATED_END = '// END GENERATED COMMAND BRIDGES';\n46: const PY_GENERATED_START = '# BEGIN GENERATED COMMAND BRIDGES';\n47: const PY_GENERATED_END = '# END GENERATED COMMAND BRIDGES';\n48: const DOCTOR_PREFIX = 'command-doctor-';\n49: const DOCTOR_MCP_COMMAND = '/doctor:mcp';\n50: \n51: // Closed vocabularies: an unrecognised value has to fail loudly, because a\n52: // silent fallthrough would hand a mutating command the read-only policy (or the\n53: // reverse) and nothing downstream would notice.\n54: const MUTATING_CLASSES = ['read-only', 'add-only', 'mutates'];\n55: const ASK_FIRST_REASONS = ['settings', 'outside-repo', 'spend', 'relaunch'];\n56: const WRITE_SCOPES = ['spec-folder'];\n57: // A lead phrase outranks a passing skill, which is only safe when the prompt asks\n58: // about the state of something. A phrase that names no state or health word could\n59: // outrank the skill on an ordinary task, so it belongs only on a route that\n60: // already asks before it runs.\n61: const LEAD_PHRASE_STATE_WORDS = [\n62:   'check',\n63:   'state',\n64:   'status',\n65:   'report',\n66:   'health',\n67:   'off',\n68:   'on',\n69:   'which',\n70:   'show',\n71:   'list',\n72:   'inventory',\n73:   'drift',\n74:   'stale',\n75:   'missing',\n76:   'failing',\n77:   'broken',\n78: ];\n79: const RENDER_PATH = join(SKILLS_ROOT, 'system-skill-advisor', 'runtime', 'lib', 'render.ts');\n80: const RENDER_GENERATED_START = '// BEGIN GENERATED DOCTOR COMMANDS';\n81: const RENDER_GENERATED_END = '// END GENERATED DOCTOR COMMANDS';\n82: const COMMAND_ATTACH_PATH = join(\n83:   SKILLS_ROOT,\n84:   'system-skill-advisor',\n85:   'runtime',\n86:   'lib',\n87:   'command-attach.ts',\n88: );\n89: const COMMAND_ATTACH_GENERATED_START = '// BEGIN GENERATED MODE COMMANDS';\n90: const COMMAND_ATTACH_GENERATED_END = '// END GENERATED MODE COMMANDS';\n91: \n92: // Manifest-derived runnable strings, trigger phrases and precedence phrases per doctor bridge id.\n93: // The inventory entries keep their five-key shape; the projection merge reads here.\n94: const DOCTOR_DETAILS = new Map();\n95: \n96: // Meaning text per command, taken from the metadata record that already states\n97: // what the command does in the words a person uses. Keyed by command rather than\n98: // by id because an allow-list row keeps its own historical id while the metadata\n99: // it came from still names the command.\n100: const METADATA_MEANING = new Map();\n101: \n102: // ───────────────────────────────────────────────────────────────────\n103: // 3. HELPERS\n104: // ───────────────────────────────────────────────────────────────────\n105: \n106: function readJson(filePath) {\n107:   try {\n108:     return JSON.parse(readFileSync(filePath, 'utf8'));\n109:   } catch (error) {\n110:     throw new Error(`[command-bridges] Failed to read JSON ${filePath}: ${error.message}`);\n111:   }\n112: }\n113: \n114: function bridgeId(command) {\n115:   if (!/^\\/[a-z][a-z0-9-]*:[a-z0-9-]+$/.test(command)) {\n116:     throw new Error(`[command-bridges] Invalid command id: ${command}`);\n117:   }\n118:   return `command-${command.slice(1).replace(':', '-')}`;\n119: }\n120: \n121: function sourcePath(filePath) {\n122:   return relative(REPO_ROOT, filePath).split(sep).join('/');\n123: }\n124: \n125: function metadataEntries(skillsRoot = SKILLS_ROOT) {\n126:   METADATA_MEANING.clear();\n127:   const entries = [];\n128:   const skillIds = readdirSync(skillsRoot, { withFileTypes: true })\n129:     // A private skill is local to one checkout and must never reach a tracked bridge file.\n130:     // Only a private skill may be a link, so any other linked folder is not a skill source.\n131:     .filter((entry) => !entry.name.startsWith('local-') && !entry.isSymbolicLink())\n132:     .map((entry) => entry.name)\n133:     .sort();\n134:   for (const skillId of skillIds) {\n135:     const filePath = join(skillsRoot, skillId, 'command-metadata.json');\n136:     if (!existsSync(filePath)) continue;\n137: \n138:     // A skill with no mode registry has no hub to route its commands, so its\n139:     // metadata is the whole declaration of what each command reaches.\n140:     const standalone = !existsSync(join(skillsRoot, skillId, 'mode-registry.json'));\n141:     const metadata = readJson(filePath);\n142:     if (!Array.isArray(metadata)) {\n143:       throw new Error(`[command-bridges] ${sourcePath(filePath)} must contain a JSON array`);\n144:     }\n145:     for (const [index, entry] of metadata.entries()) {\n146:       if (!entry || typeof entry !== 'object') {\n147:         throw new Error(`[command-bridges] ${sourcePath(filePath)}[${index}] must be an object`);\n148:       }\n149:       const { command, ownerMode } = entry;\n150:       if (typeof command !== 'string' || typeof ownerMode !== 'string' || !ownerMode) {\n151:         throw new Error(\n152:           `[command-bridges] ${sourcePath(filePath)}[${index}] requires string command and ownerMode`,\n153:         );\n154:       }\n155:       const description = entry.description === undefined ? '' : entry.description;\n156:       if (typeof description !== 'string') {\n157:         throw new Error(\n158:           `[command-bridges] ${sourcePath(filePath)}[${index}] description must be a string`,\n159:         );\n160:       }\n161:       // The phrases a person types instead of the command are declared once, in\n162:       // the metadata, so the bridge reads them here instead of restating them.\n163:       const ownedSignals = entry.userIntent && entry.userIntent.ownedSignals !== undefined\n164:         ? stringArray(\n165:           entry.userIntent.ownedSignals,\n166:           `${sourcePath(filePath)}[${index}].userIntent.ownedSignals`,\n167:         )\n168:         : [];\n169:       // The job is prose about the outcome a person wants, so it describes the\n170:       // command in words none of the identifiers do. An absent job is a record\n171:       // that says less, not a broken one.\n172:       const job = entry.userIntent && typeof entry.userIntent.job === 'string'\n173:         ? entry.userIntent.job\n174:         : '';\n175:       METADATA_MEANING.set(command, { description, job, ownedSignals });\n176:       entries.push({\n177:         id: bridgeId(command),\n178:         command,\n179:         skillId,\n180:         ownerMode,\n181:         description,\n182:         ownedSignals: [...ownedSignals],\n183:         standalone,\n184:         mutating: entry.mutating,\n185:         source: sourcePath(filePath),\n186:       });\n187:     }\n188:   }\n189:   return entries;\n190: }\n191: \n192: function allowListEntries() {\n193:   const allowList = readJson(ALLOW_LIST_PATH);\n194:   if (!Array.isArray(allowList)) {\n195:     throw new Error('[command-bridges] allow-list.json must contain a JSON array');\n196:   }\n197:   return allowList.map((entry, index) => {\n198:     if (!entry || typeof entry !== 'object') {\n199:       throw new Error(`[command-bridges] allow-list.json[${index}] must be an object`);\n200:     }\n201:     const { id, command, skillId, ownerMode, reason } = entry;\n202:     if ([id, command, skillId, ownerMode, reason].some((value) => typeof value !== 'string' || !value)) {\n203:       throw new Error(\n204:         `[command-bridges] allow-list.json[${index}] requires id, command, skillId, ownerMode, and reason`,\n205:       );\n206:     }\n207:     return {\n208:       id,\n209:       command,\n210:       skillId,\n211:       ownerMode,\n212:       source: 'scripts/command-bridges/allow-list.json',\n213:     };\n214:   });\n215: }\n216: \n217: function doctorSkillAgent(name) {\n218:   const routerPath = join(DOCTOR_COMMANDS_DIR, `${name}.md`);\n219:   const tag = existsSync(routerPath)\n220:     ? /<!--\\s*skill_agent:\\s*([a-z0-9-]+)\\s*-->/.exec(readFileSync(routerPath, 'utf8'))\n221:     : null;\n222:   if (!tag) {\n223:     throw new Error(\n224:       `[command-bridges] ${sourcePath(routerPath)} has no skill_agent tag; `\n225:         + 'a doctor bridge needs its owning skill',\n226:     );\n227:   }\n228:   return tag[1];\n229: }\n230: \n231: // A router names its own purpose in the frontmatter sentence a person reads\n232: // before anything else, so the bridge embeds that sentence rather than a second\n233: // copy written for the scorer to drift from.\n234: function doctorCommandDescription(name) {\n235:   const routerPath = join(DOCTOR_COMMANDS_DIR, `${name}.md`);\n236:   const match = existsSync(routerPath)\n237:     ? /^---\\r?\\n([\\s\\S]*?)\\r?\\n---/.exec(readFileSync(routerPath, 'utf8'))\n238:     : null;\n239:   // Required lazily for the same reason as the route manifest: an\n240:   // argument-rejecting run must exit before this module needs a YAML parser.\n241:   const YAML = require('yaml');\n242:   let frontmatter = null;\n243:   if (match) {\n244:     try {\n245:       frontmatter = YAML.parse(match[1]);\n246:     } catch (error) {\n247:       throw new Error(\n248:         `[command-bridges] Failed to read the frontmatter of ${sourcePath(routerPath)}: ${error.message}`,\n249:       );\n250:     }\n251:   }\n252:   const description = frontmatter && frontmatter.description;\n253:   if (typeof description !== 'string' || !description.trim()) {\n254:     throw new Error(\n255:       `[command-bridges] ${sourcePath(routerPath)} has no frontmatter description; `\n256:         + 'a doctor bridge needs the sentence it embeds',\n257:     );\n258:   }\n259:   return description.trim();\n260: }\n261: \n262: function doctorCommandName(command, label) {\n263:   const match = /^\\/doctor:([a-z0-9-]+)$/.exec(command);\n264:   if (!match) {\n265:     throw new Error(`[command-bridges] ${label} has invalid doctor command ${command}`);\n266:   }\n267:   return match[1];\n268: }\n269: \n270: function doctorRouteEntries() {\n271:   DOCTOR_DETAILS.clear();\n272:   // Required lazily: an argument-rejecting run must exit before this module\n273:   // ever needs a YAML parser.\n274:   const YAML = require('yaml');\n275:   let manifest;\n276:   try {\n277:     manifest = YAML.parse(readFileSync(DOCTOR_ROUTES_PATH, 'utf8'));\n278:   } catch (error) {\n279:     throw new Error(\n280:       `[command-bridges] Failed to read ${sourcePath(DOCTOR_ROUTES_PATH)}: ${error.message}`,\n281:     );\n282:   }\n283:   const routes = manifest && manifest.routes;\n284:   if (!Array.isArray(routes)) {\n285:     throw new Error('[command-bridges] _routes.yaml routes must be an array');\n286:   }\n287:   const names = routes.map((route, index) => (\n288:     doctorCommandName(route.command, `_routes.yaml routes[${index}]`)\n289:   ));\n290:   const totals = new Map();\n291:   for (const name of names) {\n292:     totals.set(name, (totals.get(name) || 0) + 1);\n293:   }\n294: \n295:   const entries = [];\n296:   routes.forEach((route, index) => {\n297:     const label = `_routes.yaml routes[${index}]`;\n298:     if (typeof route.target !== 'string' || !route.target) {\n299:       throw new Error(`[command-bridges] ${label} requires a non-empty string target`);\n300:     }\n301:     // A command with several targets needs one bridge per target; a\n302:     // single-target command takes the command's own id.\n303:     const multiTarget = totals.get(names[index]) > 1;\n304:     const id = multiTarget\n305:       ? `command-doctor-${names[index]}-${route.target}`\n306:       : `command-doctor-${names[index]}`;\n307:     const skillId = doctorSkillAgent(names[index]);\n308:     const phrases = stringArray(route.trigger_phrases, `${label}.trigger_phrases`);\n309:     const leadPhrases = doctorLeadPhrases(route, label, phrases);\n310:     DOCTOR_DETAILS.set(id, {\n311:       runnable: multiTarget ? `${route.command} ${route.target}` : route.command,\n312:       bareCommand: doctorDefaultTarget(route, label, multiTarget),\n313:       description: doctorCommandDescription(names[index]),\n314:       phrases,\n315:       leadPhrases,\n316:       readOnly: isReadOnlyRoute(route),\n317:     });\n318:     entries.push({\n319:       id,\n320:       command: route.command,\n321:       skillId,\n322:       ownerMode: skillId,\n323:       source: sourcePath(DOCTOR_ROUTES_PATH),\n324:     });\n325:   });\n326: \n327:   const standalone = manifest.standalone === undefined ? [] : manifest.standalone;\n328:   if (!Array.isArray(standalone)) {\n329:     throw new Error('[command-bridges] _routes.yaml standalone must be an array');\n330:   }\n331:   standalone.forEach((item, index) => {\n332:     if (!item || typeof item !== 'object') return;\n333:     const label = `_routes.yaml standalone[${index}]`;\n334:     const phrases = Object.prototype.hasOwnProperty.call(item, 'trigger_phrases')\n335:       ? stringArray(item.trigger_phrases, `${label}.trigger_phrases`)\n336:       : [];\n337:     const leadPhrases = doctorLeadPhrases(item, label, phrases);\n338:     if (typeof item.command !== 'string') return;\n339:     const name = doctorCommandName(item.command, label);\n340:     const skillId = doctorSkillAgent(name);\n341:     const runnable = typeof item.runnable === 'string' && item.runnable\n342:       ? item.runnable\n343:       : item.command;\n344:     DOCTOR_DETAILS.set(`command-doctor-${name}`, {\n345:       runnable,\n346:       description: doctorCommandDescription(name),\n347:       phrases,\n348:       leadPhrases,\n349:       readOnly: isReadOnlyRoute(item),\n350:     });\n351:     entries.push({\n352:       id: `command-doctor-${name}`,\n353:       command: item.command,\n354:       skillId,\n355:       ownerMode: skillId,\n356:       source: sourcePath(DOCTOR_ROUTES_PATH),\n357:     });\n358:   });\n359: \n360:   const mcpSubroutes = manifest.mcp_subroutes === undefined ? [] : manifest.mcp_subroutes;\n361:   if (!Array.isArray(mcpSubroutes)) {\n362:     throw new Error('[command-bridges] _routes.yaml mcp_subroutes must be an array');\n363:   }\n364:   mcpSubroutes.forEach((item, index) => {\n365:     const label = `_routes.yaml mcp_subroutes[${index}]`;\n366:     if (!item || typeof item.sub_action !== 'string' || !item.sub_action) {\n367:       throw new Error(`[command-bridges] ${label} requires a non-empty string sub_action`);\n368:     }\n369:     const commandName = doctorCommandName(DOCTOR_MCP_COMMAND, label);\n370:     const skillId = doctorSkillAgent(commandName);\n371:     const id = `${DOCTOR_PREFIX}${commandName}-${item.sub_action}`;\n372:     const runnable = `${DOCTOR_MCP_COMMAND} ${item.sub_action}`;\n373:     const phrases = stringArray(item.trigger_phrases, `${label}.trigger_phrases`);\n374:     const leadPhrases = doctorLeadPhrases(item, label, phrases);\n375:     DOCTOR_DETAILS.set(id, {\n376:       runnable,\n377:       description: doctorCommandDescription(commandName),\n378:       phrases,\n379:       leadPhrases,\n380:       readOnly: isReadOnlyRoute(item),\n381:     });\n382:     entries.push({\n383:       id,\n384:       command: DOCTOR_MCP_COMMAND,\n385:       skillId,\n386:       ownerMode: skillId,\n387:       source: sourcePath(DOCTOR_ROUTES_PATH),\n388:     });\n389:   });\n390: \n391:   return entries;\n392: }\n393: \n394: // A command exists when its router file exists: the folder directly under the\n395: // commands root names the group and a Markdown file inside it names the action.\n396: // A README and a .contract.md describe a command instead of being one, a file\n397: // directly in the root names no command at all, and a local- name belongs to a\n398: // single checkout, so none of them count.\n399: function commandTreeNames(commandsRoot = COMMANDS_ROOT) {\n400:   const commands = [];\n401:   const groups = readdirSync(commandsRoot, { withFileTypes: true })\n402:     .filter((entry) => entry.isDirectory() && !entry.name.startsWith('local-'))\n403:     .map((entry) => entry.name)\n404:     .sort();\n405:   for (const group of groups) {\n406:     const files = readdirSync(join(commandsRoot, group), { withFileTypes: true })\n407:       .filter((entry) => entry.isFile() && entry.name.endsWith('.md'))\n408:       .filter((entry) => (\n409:         entry.name !== 'README.md'\n410:         && !entry.name.endsWith('.contract.md')\n411:         && !entry.name.startsWith('local-')\n412:       ))\n413:       .map((entry) => `/${group}:${entry.name.slice(0, -'.md'.length)}`);\n414:     commands.push(...files);\n415:   }\n416:   return commands.sort();\n417: }\n418: \n419: // A hub's mode registry is the only place that pairs a workflow mode with the\n420: // command that runs it, so the reader's reverse lookup is derived from the hubs\n421: // themselves rather than transcribed into the consumer and left to drift.\n422: function modeCommandRecords(skillsRoot = SKILLS_ROOT, commandsRoot = COMMANDS_ROOT) {\n423:   const commandNames = new Set(commandTreeNames(commandsRoot));\n424:   const records = [];\n425:   const hubIds = readdirSync(skillsRoot, { withFileTypes: true })\n426:     // The same skill folders as the bridge metadata, for the same reason: a\n427:     // private skill is local to one checkout and a linked folder is not a skill\n428:     // source.\n429:     .filter((entry) => !entry.name.startsWith('local-') && !entry.isSymbolicLink())\n430:     .map((entry) => entry.name)\n431:     .sort();\n432:   for (const hubId of hubIds) {\n433:     const filePath = join(skillsRoot, hubId, 'mode-registry.json');\n434:     if (!existsSync(filePath)) continue;\n435: \n436:     const registry = readJson(filePath);\n437:     const modes = registry && registry.modes;\n438:     if (!Array.isArray(modes)) {\n439:       throw new Error(`[command-bridges] ${sourcePath(filePath)} must contain a modes array`);\n440:     }\n441:     const seen = new Set();\n442:     for (const [index, mode] of modes.entries()) {\n443:       const label = `${sourcePath(filePath)} modes[${index}]`;\n444:       const workflowMode = mode && mode.workflowMode;\n445:       if (typeof workflowMode !== 'string' || !workflowMode) {\n446:         throw new Error(`[command-bridges] ${label} requires a non-empty string workflowMode`);\n447:       }\n448:       // One key per hub: a repeated workflow mode would leave the lookup holding\n449:       // whichever row the table happened to keep, so the registry has to say it\n450:       // once.\n451:       if (seen.has(workflowMode)) {\n452:         throw new Error(\n453:           `[command-bridges] Duplicate workflow mode ${workflowMode} in ${sourcePath(filePath)}`,\n454:         );\n455:       }\n456:       seen.add(workflowMode);\n457: \n458:       const { command } = mode;\n459:       // A null command is a mode with no dedicated slash command, which is a\n460:       // declared state rather than a mistake, so it contributes no row.\n461:       if (typeof command !== 'string' || !command) continue;\n462:       // A command with no router file is one the reader cannot type, so naming\n463:       // it here would promise a surface that does not exist.\n464:       if (!commandNames.has(command)) {\n465:         throw new Error(\n466:           `[command-bridges] ${label} names ${command}, which has no command file`,\n467:         );\n468:       }\n469:       records.push({ hubId, workflowMode, command });\n470:     }\n471:   }\n472:   // The generated file is compared byte for byte, so the order has to be total.\n473:   return records.sort((left, right) => (\n474:     left.hubId === right.hubId\n475:       ? left.workflowMode.localeCompare(right.workflowMode)\n476:       : left.hubId.localeCompare(right.hubId)\n477:   ));\n478: }\n479: \n480: // The policy ladder reads only these keys, so a wrong value has to fail here\n481: // rather than fall through to a branch that merely looks safe.\n482: function validateRiskKeys(record, label, requireTarget = false) {\n483:   if (!MUTATING_CLASSES.includes(record.mutating)) {\n484:     throw new Error(\n485:       `[command-bridges] ${label} has mutating ${JSON.stringify(record.mutating)}; `\n486:         + `expected one of ${MUTATING_CLASSES.join(', ')}`,\n487:     );\n488:   }\n489:   if (record.ask_first !== undefined) {\n490:     const askFirst = record.ask_first;\n491:     if (!Array.isArray(askFirst) || askFirst.some((value) => !ASK_FIRST_REASONS.includes(value))) {\n492:       throw new Error(\n493:         `[command-bridges] ${label} has ask_first ${JSON.stringify(askFirst)}; `\n494:           + `expected an array of ${ASK_FIRST_REASONS.join(', ')}`,\n495:       );\n496:     }\n497:   }\n498:   if (record.write_scope !== undefined && !WRITE_SCOPES.includes(record.write_scope)) {\n499:     throw new Error(\n500:       `[command-bridges] ${label} has write_scope ${JSON.stringify(record.write_scope)}; `\n501:         + `expected one of ${WRITE_SCOPES.join(', ')}`,\n502:     );\n503:   }\n504:   if (requireTarget && (typeof record.gate3_location !== 'string' || !record.gate3_location)) {\n505:     throw new Error(\n506:       `[command-bridges] ${label} needs a non-empty string gate3_location naming what it writes`,\n507:     );\n508:   }\n509: }\n510: \n511: // One policy per command, decided from the risk keys alone so the answer never\n512: // depends on which scorer asks: an ask-first reason always wins, a doctor route\n513: // that mutates asks because its repair is the operator's call, and only a\n514: // read-only route or an add-only route confined to the spec folder may run\n515: // unprompted. Everything else starts as an ordinary task.\n516: function derivePolicy(record) {\n517:   if (Array.isArray(record.ask_first) && record.ask_first.length > 0) return 'ask';\n518:   if (record.doctor === true && record.mutating === 'mutates') return 'ask';\n519:   if (record.mutating === 'read-only') return 'run';\n520:   if (record.mutating === 'add-only' && record.write_scope === 'spec-folder') return 'run';\n521:   return 'start';\n522: }\n523: \n524: // The same skill folders as the bridge metadata, for the same reason: a private\n525: // skill is local to a checkout and a linked folder is not a skill source. A\n526: // metadata command is reachable by typing its name, so it must also name where\n527: // its writes land before its policy may be derived.\n528: function metadataRiskRecords(skillsRoot = SKILLS_ROOT) {\n529:   const records = [];\n530:   const skillIds = readdirSync(skillsRoot, { withFileTypes: true })\n531:     .filter((entry) => !entry.name.startsWith('local-') && !entry.isSymbolicLink())\n532:     .map((entry) => entry.name)\n533:     .sort();\n534:   for (const skillId of skillIds) {\n535:     const filePath = join(skillsRoot, skillId, 'command-metadata.json');\n536:     if (!existsSync(filePath)) continue;\n537:     const metadata = readJson(filePath);\n538:     if (!Array.isArray(metadata)) {\n539:       throw new Error(`[command-bridges] ${sourcePath(filePath)} must contain a JSON array`);\n540:     }\n541:     for (const [index, entry] of metadata.entries()) {\n542:       if (!entry || typeof entry !== 'object') {\n543:         throw new Error(`[command-bridges] ${sourcePath(filePath)}[${index}] must be an object`);\n544:       }\n545:       validateRiskKeys(entry, `${sourcePath(filePath)}[${index}] ${entry.command}`, true);\n546:       records.push({\n547:         command: entry.command,\n548:         route: null,\n549:         mutating: entry.mutating,\n550:         ask_first: entry.ask_first || [],\n551:         write_scope: entry.write_scope,\n552:         doctor: false,\n553:       });\n554:     }\n555:   }\n556:   return records;\n557: }\n558: \n559: // The manifest is the doctor half of the same surface. Requiring YAML lazily\n560: // keeps an argument-rejecting run from ever loading a parser.\n561: function doctorRiskRecords(routesPath = DOCTOR_ROUTES_PATH) {\n562:   const YAML = require('yaml');\n563:   let manifest;\n564:   try {\n565:     manifest = YAML.parse(readFileSync(routesPath, 'utf8'));\n566:   } catch (error) {\n567:     throw new Error(\n568:       `[command-bridges] Failed to read ${sourcePath(routesPath)}: ${error.message}`,\n569:     );\n570:   }\n571: \n572:   const records = [];\n573:   const addRecord = (fields, label) => {\n574:     const record = {\n575:       command: fields.command,\n576:       route: fields.route,\n577:       mutating: fields.mutating,\n578:       ask_first: fields.ask_first || [],\n579:       write_scope: fields.write_scope,\n580:       doctor: true,\n581:     };\n582:     validateRiskKeys(record, label);\n583:     records.push(record);\n584:   };\n585: \n586:   const routes = manifest && manifest.routes;\n587:   if (!Array.isArray(routes)) {\n588:     throw new Error('[command-bridges] _routes.yaml routes must be an array');\n589:   }\n590:   routes.forEach((route, index) => {\n591:     addRecord({\n592:       command: route.command,\n593:       route: route.target,\n594:       mutating: route.mutating,\n595:       ask_first: route.ask_first,\n596:       write_scope: route.write_scope,\n597:     }, `${sourcePath(routesPath)} routes[${index}]`);\n598:   });\n599: \n600:   const mcpSubroutes = manifest.mcp_subroutes === undefined ? [] : manifest.mcp_subroutes;\n601:   if (!Array.isArray(mcpSubroutes)) {\n602:     throw new Error('[command-bridges] _routes.yaml mcp_subroutes must be an array');\n603:   }\n604:   mcpSubroutes.forEach((item, index) => {\n605:     addRecord({\n606:       command: DOCTOR_MCP_COMMAND,\n607:       route: item?.sub_action,\n608:       mutating: item?.mutating,\n609:       ask_first: item?.ask_first,\n610:       write_scope: item?.write_scope,\n611:     }, `${sourcePath(routesPath)} mcp_subroutes[${index}]`);\n612:   });\n613: \n614:   const standalone = manifest.standalone === undefined ? [] : manifest.standalone;\n615:   if (!Array.isArray(standalone)) {\n616:     throw new Error('[command-bridges] _routes.yaml standalone must be an array');\n617:   }\n618:   standalone.forEach((item, index) => {\n619:     if (!item || typeof item.command !== 'string') return;\n620:     const label = `${sourcePath(routesPath)} standalone[${index}]`;\n621:     const actions = item.actions;\n622:     // One command, several actions: the action carries the class because the\n623:     // bare command name cannot say what the run will do.\n624:     if (actions && typeof actions === 'object' && !Array.isArray(actions)) {\n625:       for (const [action, entry] of Object.entries(actions)) {\n626:         addRecord({\n627:           command: item.command,\n628:           route: action,\n629:           mutating: entry?.mutating,\n630:           ask_first: entry?.ask_first,\n631:           write_scope: entry?.write_scope,\n632:         }, `${label}.actions.${action}`);\n633:       }\n634:       return;\n635:     }\n636:     addRecord({\n637:       command: item.command,\n638:       route: null,\n639:       mutating: item.mutating,\n640:       ask_first: item.ask_first,\n641:       write_scope: item.write_scope,\n642:     }, label);\n643:   });\n644: \n645:   return records;\n646: }\n647: \n648: // Three views of one surface. A name in the tree that neither declaration\n649: // carries is a command nothing can suggest; a declared name with no file is a\n650: // bridge to a command the operator cannot type. Either way the inventory lies,\n651: // so both directions are reported together.\n652: function identityViolations({ treeCommands, metadataCommands, doctorCommands }) {\n653:   const tree = new Set(treeCommands);\n654:   const declared = new Set([...metadataCommands, ...doctorCommands]);\n655:   const violations = [];\n656:   for (const command of tree) {\n657:     if (!declared.has(command)) {\n658:       violations.push(\n659:         `${command}: command file has no command-metadata.json entry and no doctor route`,\n660:       );\n661:     }\n662:   }\n663:   for (const command of declared) {\n664:     if (!tree.has(command)) {\n665:       violations.push(\n666:         `${command}: declared in command-metadata.json or the doctor manifest but has no command file`,\n667:       );\n668:     }\n669:   }\n670:   return violations.sort();\n671: }\n672: \n673: // The generated file is compared byte for byte, so the order has to be total:\n674: // command name first, then the bare route before its named ones.\n675: function commandPolicies(skillsRoot, routesPath) {\n676:   return [...metadataRiskRecords(skillsRoot), ...doctorRiskRecords(routesPath)]\n677:     .map((record) => ({\n678:       command: record.command,\n679:       route: record.route,\n680:       mutating: record.mutating,\n681:       askFirst: record.ask_first,\n682:       policy: derivePolicy(record),\n683:     }))\n684:     .sort((left, right) => {\n685:       if (left.command !== right.command) return left.command.localeCompare(right.command);\n686:       if (left.route === right.route) return 0;\n687:       if (left.route === null) return -1;\n688:       if (right.route === null) return 1;\n689:       return left.route.localeCompare(right.route);\n690:     });\n691: }\n692: \n693: function assertUniqueIds(entries) {\n694:   const seen = new Map();\n695:   for (const entry of entries) {\n696:     const previous = seen.get(entry.id);\n697:     if (previous) {\n698:       throw new Error(\n699:         `[command-bridges] Duplicate bridge id ${entry.id}: ${previous.source} and ${entry.source}`,\n700:       );\n701:     }\n702:     seen.set(entry.id, entry);\n703:   }\n704: }\n705: \n706: function stringArray(value, label) {\n707:   if (!Array.isArray(value) || value.some((entry) => typeof entry !== 'string' || !entry)) {\n708:     throw new Error(`[command-bridges] ${label} must be an array of non-empty strings`);\n709:   }\n710:   return value;\n711: }\n712: \n713: // A vector has to describe the job a command does, so the slash form is dropped\n714: // before the text is built. A name left in would hand the scorer a second copy\n715: // of the token it already matches literally.\n716: function commandEmbeddingText({ description, job, ownedSignals }) {\n717:   // Each part is cleaned before the join: a part that was only a slash command,\n718:   // or one that already ends in a full stop, would otherwise leave stray\n719:   // punctuation in text whose only reader is an embedder.\n720:   // A prompt is written in the asker's voice, and so are the job sentence and\n721:   // the owned phrases. The description is written in the command's voice and\n722:   // carries mode and step notes no asker types, so it stands in only when a\n723:   // record states no job.\n724:   const lead = typeof job === 'string' && job.trim() ? job : description;\n725:   return [lead, ...ownedSignals]\n726:     .filter((part) => typeof part === 'string')\n727:     .map((part) => part\n728:       .replace(/\\/?[a-z-]+:[a-z-]+/g, ' ')\n729:       .replace(/\\s+/g, ' ')\n730:       .trim()\n731:       .replace(/[.\\s]+$/, ''))\n732:     .filter(Boolean)\n733:     .join('. ');\n734: }\n735: \n736: // Only a bridge a scorer can offer carries meaning text, and where it comes from\n737: // depends on the row: a metadata row states it in its own record, while a doctor\n738: // row states it in the router sentence and the route phrases it already declares.\n739: function entryMeaning(entryId, command, isDoctor) {\n740:   if (!isDoctor) return METADATA_MEANING.get(command);\n741:   const { description, phrases } = DOCTOR_DETAILS.get(entryId);\n742:   return { description, ownedSignals: phrases };\n743: }\n744: \n745: // Only a route the manifest classes as read-only may answer a list or show\n746: // question; add-only and mutating routes keep the read-only confidence floor.\n747: function isReadOnlyRoute(item) {\n748:   return item.mutating === 'read-only';\n749: }\n750: \n751: // A command with several targets runs only as `<command> <target>`, yet its router binds one\n752: // target when none is typed. A route marked default_target also answers the bare command, so\n753: // the typed command alone still reaches a bridge.\n754: function doctorDefaultTarget(route, label, multiTarget) {\n755:   if (!Object.prototype.hasOwnProperty.call(route, 'default_target')) return null;\n756:   if (typeof route.default_target !== 'boolean') {\n757:     throw new Error(`[command-bridges] ${label}.default_target must be a boolean`);\n758:   }\n759:   if (!route.default_target) return null;\n760:   if (!multiTarget) {\n761:     throw new Error(\n762:       `[command-bridges] ${label}.default_target is only valid on a command with several targets`,\n763:     );\n764:   }\n765:   return route.command;\n766: }\n767: \n768: // A lead phrase is matched against the whole prompt, so the state word has to be\n769: // a word of its own: \"on\" inside \"environment\" would clear a phrase that asks\n770: // nothing about state.\n771: function hasStateWord(phrase) {\n772:   return phrase\n773:     .toLowerCase()\n774:     .split(/[^a-z0-9]+/)\n775:     .some((word) => LEAD_PHRASE_STATE_WORDS.includes(word));\n776: }\n777: \n778: // A route that asks first may lead with a phrase that names no state or health\n779: // word, because the ask already keeps the run behind a decision.\n780: function doctorLeadPhrases(item, label, triggerPhrases) {\n781:   const leadPhrases = Object.prototype.hasOwnProperty.call(item, 'lead_phrases')\n782:     ? stringArray(item.lead_phrases, `${label}.lead_phrases`)\n783:     : [];\n784:   const asksFirst = derivePolicy({\n785:     doctor: true,\n786:     mutating: item.mutating,\n787:     ask_first: item.ask_first,\n788:     write_scope: item.write_scope,\n789:   }) === 'ask';\n790:   for (const phrase of leadPhrases) {\n791:     if (!triggerPhrases.includes(phrase)) {\n792:       throw new Error(\n793:         `[command-bridges] ${label}.lead_phrases entry ${JSON.stringify(phrase)} must also appear in trigger_phrases`,\n794:       );\n795:     }\n796:     if (!asksFirst && !hasStateWord(phrase)) {\n797:       throw new Error(\n798:         `[command-bridges] ${label}.lead_phrases entry ${JSON.stringify(phrase)} needs a state or health word because its route does not ask first`,\n799:       );\n800:     }\n801:   }\n802:   return leadPhrases;\n803: }\n804: \n805: function compatibilityByInventoryId(entries, inventoryIds, platform) {\n806:   if (!Array.isArray(entries)) {\n807:     throw new Error(`[command-bridges] scoring-compatibility.json ${platform} must be an array`);\n808:   }\n809:   const byInventoryId = new Map();\n810:   const orders = new Set();\n811:   for (const [index, entry] of entries.entries()) {\n812:     if (!entry || typeof entry !== 'object') {\n813:       throw new Error(`[command-bridges] ${platform}[${index}] must be an object`);\n814:     }\n815:     const { inventoryId, order, id, description } = entry;\n816:     if (\n817:       typeof inventoryId !== 'string'\n818:       || !inventoryIds.has(inventoryId)\n819:       || !Number.isInteger(order)\n820:       || order < 0\n821:       || typeof id !== 'string'\n822:       || !id\n823:       || typeof description !== 'string'\n824:     ) {\n825:       throw new Error(\n826:         `[command-bridges] ${platform}[${index}] requires a known inventoryId, ` +\n827:           'non-negative integer order, id, and description',\n828:       );\n829:     }\n830:     if (byInventoryId.has(inventoryId)) {\n831:       throw new Error(`[command-bridges] Duplicate ${platform} inventoryId ${inventoryId}`);\n832:     }\n833:     if (orders.has(order)) {\n834:       throw new Error(`[command-bridges] Duplicate ${platform} order ${order}`);\n835:     }\n836:     const isDoctor = inventoryId.startsWith(DOCTOR_PREFIX);\n837:     if (isDoctor && id !== inventoryId) {\n838:       throw new Error(\n839:         `[command-bridges] ${platform}[${index}] doctor bridge id must equal its inventoryId`,\n840:       );\n841:     }\n842:     if (platform === 'typescript') {\n843:       if (!isDoctor) {\n844:         if (typeof entry.name !== 'string' || !entry.name) {\n845:           throw new Error(`[command-bridges] typescript[${index}] requires name`);\n846:         }\n847:         stringArray(entry.keywords, `typescript[${index}].keywords`);\n848:         stringArray(entry.domains, `typescript[${index}].domains`);\n849:         stringArray(entry.intentSignals, `typescript[${index}].intentSignals`);\n850:       }\n851:     } else {\n852:       if (!isDoctor) {\n853:         stringArray(entry.slashMarkers, `python[${index}].slashMarkers`);\n854:       }\n855:       if ('owningSkill' in entry && (typeof entry.owningSkill !== 'string' || !entry.owningSkill)) {\n856:         throw new Error(`[command-bridges] python[${index}].owningSkill must be a non-empty string`);\n857:       }\n858:       if ('deprecated' in entry && typeof entry.deprecated !== 'boolean') {\n859:         throw new Error(`[command-bridges] python[${index}].deprecated must be boolean`);\n860:       }\n861:     }\n862:     byInventoryId.set(inventoryId, entry);\n863:     orders.add(order);\n864:   }\n865:   return byInventoryId;\n866: }\n867: \n868: // A standalone skill has no hub registry, so the only record of what its\n869: // commands reach is its own metadata. The match is by command rather than by id\n870: // because one command can enter the inventory under a row that carries its own\n871: // historical id.\n872: function standaloneCommandRecords(entries, metadata) {\n873:   const byCommand = new Map();\n874:   for (const record of metadata) {\n875:     if (record.standalone) byCommand.set(record.command, record);\n876:   }\n877:   return entries\n878:     .filter((entry) => byCommand.has(entry.command))\n879:     .sort((left, right) => left.id.localeCompare(right.id))\n880:     .map((entry) => ({ entry, record: byCommand.get(entry.command) }));\n881: }\n882: \n883: // A generated row is the command's only reach, so one phrase would leave it\n884: // indistinguishable from every other command and the activation would claim a\n885: // surface the scorer cannot actually offer.\n886: function assertPlainChatSignals(records) {\n887:   for (const { entry, record } of records) {\n888:     if (record.ownedSignals.length < 2) {\n889:       throw new Error(\n890:         `[command-bridges] ${entry.command} needs at least two userIntent.ownedSignals `\n891:           + `in ${record.source}, found ${record.ownedSignals.length}`,\n892:       );\n893:     }\n894:   }\n895: }\n896: \n897: function commandNamespace(command) {\n898:   return command.slice(1, command.indexOf(':'));\n899: }\n900: \n901: // A standalone skill's commands are active by construction: the metadata already\n902: // names the phrases a person types, so a hand row would be a second copy left to\n903: // drift. A hand row still wins where one exists, because a curated row can carry\n904: // phrases the metadata cannot know. Orders start past the highest hand-written\n905: // one so a later hand row never has to renumber a generated one.\n906: function activateStandaloneCommands(byInventoryId, records, platform) {\n907:   let nextOrder = 0;\n908:   for (const row of byInventoryId.values()) {\n909:     nextOrder = Math.max(nextOrder, row.order + 1);\n910:   }\n911:   for (const { entry, record } of records) {\n912:     if (byInventoryId.has(entry.id)) continue;\n913:     byInventoryId.set(entry.id, standaloneRuntimeRow(entry, record, nextOrder, platform));\n914:     nextOrder += 1;\n915:   }\n916: }\n917: \n918: function standaloneRuntimeRow(entry, record, order, platform) {\n919:   if (platform === 'typescript') {\n920:     return {\n921:       inventoryId: entry.id,\n922:       order,\n923:       id: entry.id,\n924:       name: entry.id,\n925:       description: record.description,\n926:       keywords: [...record.ownedSignals],\n927:       domains: [commandNamespace(entry.command), 'command'],\n928:       intentSignals: [...record.ownedSignals],\n929:       // The class decides this for every command, not only a doctor route.\n930:       ...(isReadOnlyRoute(record) ? { readOnly: true } : {}),\n931:     };\n932:   }\n933:   return {\n934:     inventoryId: entry.id,\n935:     order,\n936:     id: entry.id,\n937:     description: record.description,\n938:     slashMarkers: [entry.command, entry.command.slice(1)],\n939:     owningSkill: record.skillId,\n940:   };\n941: }\n942: \n943: function runtimeCompatibility(entries, metadata) {\n944:   const compatibility = readJson(COMPATIBILITY_PATH);\n945:   if (!compatibility || typeof compatibility !== 'object' || compatibility.schemaVersion !== 1) {\n946:     throw new Error('[command-bridges] scoring-compatibility.json requires schemaVersion 1');\n947:   }\n948:   const inventoryIds = new Set(entries.map((entry) => entry.id));\n949:   const typescript = compatibilityByInventoryId(\n950:     compatibility.typescript,\n951:     inventoryIds,\n952:     'typescript',\n953:   );\n954:   const python = compatibilityByInventoryId(compatibility.python, inventoryIds, 'python');\n955:   const standalone = standaloneCommandRecords(entries, metadata);\n956:   assertPlainChatSignals(standalone);\n957:   activateStandaloneCommands(typescript, standalone, 'typescript');\n958:   activateStandaloneCommands(python, standalone, 'python');\n959:   const pythonOwnerNormalization = compatibility.pythonOwnerNormalization;\n960:   if (\n961:     !pythonOwnerNormalization\n962:     || typeof pythonOwnerNormalization !== 'object'\n963:     || Array.isArray(pythonOwnerNormalization)\n964:     || Object.entries(pythonOwnerNormalization).some(\n965:       ([key, value]) => !key || typeof value !== 'string' || !value,\n966:     )\n967:   ) {\n968:     throw new Error(\n969:       '[command-bridges] scoring-compatibility.json pythonOwnerNormalization must be a string map',\n970:     );\n971:   }\n972:   const activePythonIds = new Set([...python.values()].map((entry) => entry.id));\n973:   for (const runtimeId of Object.keys(pythonOwnerNormalization)) {\n974:     if (!activePythonIds.has(runtimeId)) {\n975:       throw new Error(\n976:         `[command-bridges] pythonOwnerNormalization references inactive bridge ${runtimeId}`,\n977:       );\n978:     }\n979:   }\n980:   return { typescript, python, pythonOwnerNormalization };\n981: }\n982: \n983: function tsString(value) {\n984:   return `'${value.replaceAll('\\\\', '\\\\\\\\').replaceAll(\"'\", \"\\\\'\")}'`;\n985: }\n986: \n987: function tsArray(values) {\n988:   return `[${values.map((value) => tsString(value)).join(', ')}]`;\n989: }\n990: \n991: function doctorRuntime(entryId, platform, compat) {\n992:   const { runnable, bareCommand, phrases, leadPhrases, readOnly } = DOCTOR_DETAILS.get(entryId);\n993:   if (platform === 'typescript') {\n994:     return {\n995:       ...compat,\n996:       name: runnable,\n997:       keywords: bareCommand ? [...phrases, bareCommand] : [...phrases],\n998:       intentSignals: [runnable],\n999:       ...(leadPhrases.length > 0 ? { leadPhrases: [...leadPhrases] } : {}),\n1000:       ...(readOnly ? { readOnly: true } : {}),\n1001:       domains: ['doctor', 'command'],\n1002:     };\n1003:   }\n1004:   return {\n1005:     ...compat,\n1006:     slashMarkers: bareCommand ? [runnable, bareCommand] : [runnable],\n1007:     ...(leadPhrases.length > 0 ? { leadPhrases: [...leadPhrases] } : {}),\n1008:   };\n1009: }\n1010: \n1011: function runtimeOrdered(entries, platform) {\n1012:   return [...entries].sort((left, right) => {\n1013:     const leftRuntime = left.runtime[platform];\n1014:     const rightRuntime = right.runtime[platform];\n1015:     if (leftRuntime.enabled !== rightRuntime.enabled) {\n1016:       return leftRuntime.enabled ? -1 : 1;\n1017:     }\n1018:     if (leftRuntime.enabled && rightRuntime.enabled) {\n1019:       return leftRuntime.order - rightRuntime.order;\n1020:     }\n1021:     return left.id.localeCompare(right.id);\n1022:   });\n1023: }\n1024: \n1025: function renderTypescriptBridge(entry) {\n1026:   const runtime = entry.runtime.typescript;\n1027:   const active = runtime.enabled;\n1028:   const id = active ? runtime.id : entry.id;\n1029:   const name = active ? runtime.name : entry.id;\n1030:   const description = active ? runtime.description : '';\n1031:   const keywords = active ? runtime.keywords : [];\n1032:   const domains = active ? runtime.domains : [];\n1033:   const intentSignals = active ? runtime.intentSignals : [];\n1034:   const lines = [\n1035:     '  {',\n1036:     `    inventoryId: ${tsString(entry.id)},`,\n1037:     `    ownerSkill: ${tsString(entry.skillId)},`,\n1038:     `    routingEnabled: ${active},`,\n1039:     `    id: ${tsString(id)},`,\n1040:     \"    kind: 'command',\",\n1041:     \"    family: 'system',\",\n1042:     \"    category: 'command',\",\n1043:     `    name: ${tsString(name)},`,\n1044:     `    description: ${tsString(description)},`,\n1045:     `    keywords: ${tsArray(keywords)},`,\n1046:     `    domains: ${tsArray(domains)},`,\n1047:     `    intentSignals: ${tsArray(intentSignals)},`,\n1048:   ];\n1049:   if (active && runtime.leadPhrases?.length) {\n1050:     lines.push(`    leadPhrases: ${tsArray(runtime.leadPhrases)},`);\n1051:   }\n1052:   if (active && runtime.readOnly === true) {\n1053:     lines.push('    readOnly: true,');\n1054:   }\n1055:   lines.push(\n1056:     '    derivedTriggers: [],',\n1057:     '    derivedKeywords: [],',\n1058:     '    sourcePath: null,',\n1059:     \"    lifecycleStatus: 'active',\",\n1060:     '  },',\n1061:   );\n1062:   return lines.join('\\n');\n1063: }\n1064: \n1065: function renderTypescriptProjection(entries) {\n1066:   const body = runtimeOrdered(entries, 'typescript').map(renderTypescriptBridge).join('\\n');\n1067:   return `export const GENERATED_COMMAND_BRIDGES: readonly CommandBridgeProjection[] = [\\n${body}\\n];`;\n1068: }\n1069: \n1070: function pythonString(value) {\n1071:   return JSON.stringify(value);\n1072: }\n1073: \n1074: function pythonList(values) {\n1075:   return `[${values.map((value) => pythonString(value)).join(', ')}]`;\n1076: }\n1077: \n1078: function renderPythonBridge(entry) {\n1079:   const runtime = entry.runtime.python;\n1080:   const active = runtime.enabled;\n1081:   const runtimeId = active ? runtime.id : entry.id;\n1082:   const description = active ? runtime.description : '';\n1083:   const slashMarkers = active ? runtime.slashMarkers : [entry.command];\n1084:   const lines = [\n1085:     `    ${pythonString(runtimeId)}: {`,\n1086:     `        \"description\": ${pythonString(description)},`,\n1087:     `        \"slash_markers\": ${pythonList(slashMarkers)},`,\n1088:   ];\n1089:   if (active && runtime.leadPhrases?.length) {\n1090:     lines.push(`        \"lead_phrases\": ${pythonList(runtime.leadPhrases)},`);\n1091:   }\n1092:   if (active && runtime.deprecated === true) {\n1093:     lines.push('        \"deprecated\": True,');\n1094:   }\n1095:   if (active && typeof runtime.owningSkill === 'string') {\n1096:     lines.push(`        \"owning_skill\": ${pythonString(runtime.owningSkill)},`);\n1097:   }\n1098:   lines.push(\n1099:     `        \"inventory_id\": ${pythonString(entry.id)},`,\n1100:     `        \"command\": ${pythonString(entry.command)},`,\n1101:     `        \"skill_id\": ${pythonString(entry.skillId)},`,\n1102:     `        \"owner_mode\": ${pythonString(entry.ownerMode)},`,\n1103:     `        \"routing_enabled\": ${active ? 'True' : 'False'},`,\n1104:     '    },',\n1105:   );\n1106:   return lines.join('\\n');\n1107: }\n1108: \n1109: function renderPythonProjection(entries, pythonOwnerNormalization) {\n1110:   const body = runtimeOrdered(entries, 'python').map(renderPythonBridge).join('\\n');\n1111:   const normalization = Object.entries(pythonOwnerNormalization)\n1112:     .map(([id, owner]) => `    ${pythonString(id)}: ${pythonString(owner)},`)\n1113:     .join('\\n');\n1114:   return [\n1115:     'GENERATED_COMMAND_BRIDGES = {',\n1116:     body,\n1117:     '}',\n1118:     '',\n1119:     'GENERATED_COMMAND_BRIDGE_OWNER_NORMALIZATION = {',\n1120:     normalization,\n1121:     '}',\n1122:   ].join('\\n');\n1123: }\n1124: \n1125: function replaceMarkedBlock(content, startMarker, endMarker, replacement, filePath) {\n1126:   const start = content.indexOf(startMarker);\n1127:   const end = content.indexOf(endMarker);\n1128:   if (start < 0 || end < 0 || end < start) {\n1129:     throw new Error(`[command-bridges] Missing generated markers in ${sourcePath(filePath)}`);\n1130:   }\n1131:   const bodyStart = start + startMarker.length;\n1132:   return `${content.slice(0, bodyStart)}\\n${replacement}\\n${content.slice(end)}`;\n1133: }\n1134: \n1135: function renderDoctorCommandStrings(entries) {\n1136:   const lines = entries\n1137:     .filter((entry) => entry.id.startsWith(DOCTOR_PREFIX))\n1138:     .sort((left, right) => left.id.localeCompare(right.id))\n1139:     .map((entry) => {\n1140:       const { runnable } = DOCTOR_DETAILS.get(entry.id);\n1141:       return `  ${tsString(entry.id)}: ${tsString(runnable)},`;\n1142:     });\n1143:   return [\n1144:     'const DOCTOR_COMMAND_STRINGS: Readonly<Record<string, string>> = Object.freeze({',\n1145:     ...lines,\n1146:     '});',\n1147:   ].join('\\n');\n1148: }\n1149: \n1150: // Hub-then-mode nesting so a reader scans one hub's modes together, and the\n1151: // records arrive already ordered so the block is byte-identical between runs.\n1152: function renderModeCommands(records) {\n1153:   const lines = [\n1154:     'export const MODE_COMMANDS: Readonly<Record<string, Readonly<Record<string, string>>>> = {',\n1155:   ];\n1156:   let hubId = null;\n1157:   for (const record of records) {\n1158:     if (record.hubId !== hubId) {\n1159:       if (hubId !== null) lines.push('  },');\n1160:       hubId = record.hubId;\n1161:       lines.push(`  ${tsString(hubId)}: {`);\n1162:     }\n1163:     lines.push(`    ${tsString(record.workflowMode)}: ${tsString(record.command)},`);\n1164:   }\n1165:   if (hubId !== null) lines.push('  },');\n1166:   lines.push('};');\n1167:   return lines.join('\\n');\n1168: }\n1169: \n1170: function generatedSources(entries, pythonOwnerNormalization, modeCommands) {\n1171:   const typescript = readFileSync(TS_PROJECTION_PATH, 'utf8');\n1172:   const python = readFileSync(PY_ADVISOR_PATH, 'utf8');\n1173:   const render = readFileSync(RENDER_PATH, 'utf8');\n1174:   const commandAttach = readFileSync(COMMAND_ATTACH_PATH, 'utf8');\n1175:   return [\n1176:     {\n1177:       path: TS_PROJECTION_PATH,\n1178:       current: typescript,\n1179:       next: replaceMarkedBlock(\n1180:         typescript,\n1181:         TS_GENERATED_START,\n1182:         TS_GENERATED_END,\n1183:         renderTypescriptProjection(entries),\n1184:         TS_PROJECTION_PATH,\n1185:       ),\n1186:     },\n1187:     {\n1188:       path: PY_ADVISOR_PATH,\n1189:       current: python,\n1190:       next: replaceMarkedBlock(\n1191:         python,\n1192:         PY_GENERATED_START,\n1193:         PY_GENERATED_END,\n1194:         renderPythonProjection(entries, pythonOwnerNormalization),\n1195:         PY_ADVISOR_PATH,\n1196:       ),\n1197:     },\n1198:     {\n1199:       path: RENDER_PATH,\n1200:       current: render,\n1201:       next: replaceMarkedBlock(\n1202:         render,\n1203:         RENDER_GENERATED_START,\n1204:         RENDER_GENERATED_END,\n1205:         renderDoctorCommandStrings(entries),\n1206:         RENDER_PATH,\n1207:       ),\n1208:     },\n1209:     {\n1210:       path: COMMAND_ATTACH_PATH,\n1211:       current: commandAttach,\n1212:       next: replaceMarkedBlock(\n1213:         commandAttach,\n1214:         COMMAND_ATTACH_GENERATED_START,\n1215:         COMMAND_ATTACH_GENERATED_END,\n1216:         renderModeCommands(modeCommands),\n1217:         COMMAND_ATTACH_PATH,\n1218:       ),\n1219:     },\n1220:   ];\n1221: }\n1222: \n1223: // ───────────────────────────────────────────────────────────────────\n1224: // 4. CORE LOGIC\n1225: // ───────────────────────────────────────────────────────────────────\n1226: \n1227: function main() {\n1228:   // CLI-only rejection: requiring this module (for example from tests) must\n1229:   // not exit on arguments belonging to the host process.\n1230:   if (require.main === module) {\n1231:     const unknownArg = process.argv.slice(2).find((token) => token !== '--check');\n1232:     if (unknownArg !== undefined) {\n1233:       console.error(`derive-command-bridges.cjs: unknown option: ${unknownArg}`);\n1234:       console.error('usage: derive-command-bridges.cjs [--check]');\n1235:       process.exit(2);\n1236:     }\n1237:   }\n1238:   const checkOnly = process.argv.includes('--check');\n1239:   const metadata = metadataEntries();\n1240:   const allowList = allowListEntries();\n1241:   const doctor = doctorRouteEntries();\n1242:   // The identity check compares command names against the declarations that make\n1243:   // a command real; an allow-list row only repeats an ownership id for a command\n1244:   // the tree and the metadata already name, so it adds nothing there.\n1245:   const tree = commandTreeNames();\n1246:   const metadataRisk = metadataRiskRecords();\n1247:   const doctorRisk = doctorRiskRecords();\n1248:   const modeCommands = modeCommandRecords();\n1249:   const violations = identityViolations({\n1250:     treeCommands: tree,\n1251:     metadataCommands: metadataRisk.map((record) => record.command),\n1252:     doctorCommands: doctorRisk.map((record) => record.command),\n1253:   });\n1254:   if (violations.length > 0) {\n1255:     throw new Error(`[command-bridges] command inventory mismatch:\\n${violations.join('\\n')}`);\n1256:   }\n1257:   // A command the allow-list already carries keeps that row's id: both scorers\n1258:   // know it, and a second id for one command would be a second bridge.\n1259:   const allowListCommands = new Set(allowList.map((entry) => entry.command));\n1260:   const bridgedMetadata = metadata.filter((entry) => !allowListCommands.has(entry.command));\n1261:   const inventory = [...bridgedMetadata, ...allowList, ...doctor]\n1262:     .sort((left, right) => left.id.localeCompare(right.id));\n1263:   assertUniqueIds(inventory);\n1264:   const compatibility = runtimeCompatibility(inventory, metadata);\n1265:   const entries = inventory.map((entry) => {\n1266:     const isDoctor = entry.id.startsWith(DOCTOR_PREFIX);\n1267:     const typescript = compatibility.typescript.get(entry.id);\n1268:     const python = compatibility.python.get(entry.id);\n1269:     // A command nothing describes has nothing written to embed, so the field\n1270:     // appears only where a source sentence exists for it.\n1271:     const meaning = typescript ? entryMeaning(entry.id, entry.command, isDoctor) : undefined;\n1272:     const runtime = { typescript: { enabled: false }, python: { enabled: false } };\n1273:     if (typescript) {\n1274:       runtime.typescript = {\n1275:         enabled: true,\n1276:         ...(isDoctor ? doctorRuntime(entry.id, 'typescript', typescript) : typescript),\n1277:       };\n1278:     }\n1279:     if (python) {\n1280:       runtime.python = {\n1281:         enabled: true,\n1282:         ...(isDoctor ? doctorRuntime(entry.id, 'python', python) : python),\n1283:       };\n1284:     }\n1285:     return {\n1286:       ...entry,\n1287:       ...(meaning ? { embeddingText: commandEmbeddingText(meaning) } : {}),\n1288:       runtime,\n1289:     };\n1290:   });\n1291: \n1292:   const projection = {\n1293:     schemaVersion: 2,\n1294:     generatedBy: 'scripts/command-bridges/derive-command-bridges.cjs',\n1295:     counts: {\n1296:       commandMetadata: bridgedMetadata.length,\n1297:       allowList: allowList.length,\n1298:       doctorRoutes: doctor.length,\n1299:       generated: entries.length,\n1300:       typescriptActive: compatibility.typescript.size,\n1301:       pythonActive: compatibility.python.size,\n1302:     },\n1303:     entries,\n1304:     commandPolicies: commandPolicies(),\n1305:   };\n1306:   const output = `${JSON.stringify(projection, null, 2)}\\n`;\n1307:   const sources = generatedSources(entries, compatibility.pythonOwnerNormalization, modeCommands);\n1308:   const changed = [\n[Output truncated. Continue reading with offset: 1309]","title":"read","metadata":{"metadata":{"truncated":true},"content":[{"type":"text","text":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/scripts/command-bridges/derive-command-bridges.cjs, lines 1-1308\n1: // ───────────────────────────────────────────────────────────────────\n2: // MODULE: Derive Command Bridges\n3: // ───────────────────────────────────────────────────────────────────\n4: \n5: 'use strict';\n6: \n7: // ───────────────────────────────────────────────────────────────────\n8: // 1. IMPORTS\n9: // ───────────────────────────────────────────────────────────────────\n10: \n11: const { existsSync, readFileSync, readdirSync, writeFileSync } = require('node:fs');\n12: const { join, relative, resolve, sep } = require('node:path');\n13: \n14: // ───────────────────────────────────────────────────────────────────\n15: // 2. CONSTANTS\n16: // ───────────────────────────────────────────────────────────────────\n17: \n18: const COMMAND_BRIDGES_DIR = __dirname;\n19: const REPO_ROOT = resolve(COMMAND_BRIDGES_DIR, '../../../../../..');\n20: const SKILLS_ROOT = join(REPO_ROOT, '.skilled', 'skills');\n21: // One folder per command group, one Markdown file per command: the tree the\n22: // inventory identity check reads.\n23: const COMMANDS_ROOT = join(REPO_ROOT, '.skilled', 'commands');\n24: const ALLOW_LIST_PATH = join(COMMAND_BRIDGES_DIR, 'allow-list.json');\n25: const DOCTOR_COMMANDS_DIR = join(COMMANDS_ROOT, 'doctor');\n26: const DOCTOR_ROUTES_PATH = join(DOCTOR_COMMANDS_DIR, '_routes.yaml');\n27: const COMPATIBILITY_PATH = join(COMMAND_BRIDGES_DIR, 'scoring-compatibility.json');\n28: const OUTPUT_PATH = join(COMMAND_BRIDGES_DIR, 'command-bridges.generated.json');\n29: const TS_PROJECTION_PATH = join(\n30:   SKILLS_ROOT,\n31:   'system-skill-advisor',\n32:   'runtime',\n33:   'lib',\n34:   'scorer',\n35:   'projection.ts',\n36: );\n37: const PY_ADVISOR_PATH = join(\n38:   SKILLS_ROOT,\n39:   'system-skill-advisor',\n40:   'runtime',\n41:   'scripts',\n42:   'skill_advisor.py',\n43: );\n44: const TS_GENERATED_START = '// BEGIN GENERATED COMMAND BRIDGES';\n45: const TS_GENERATED_END = '// END GENERATED COMMAND BRIDGES';\n46: const PY_GENERATED_START = '# BEGIN GENERATED COMMAND BRIDGES';\n47: const PY_GENERATED_END = '# END GENERATED COMMAND BRIDGES';\n48: const DOCTOR_PREFIX = 'command-doctor-';\n49: const DOCTOR_MCP_COMMAND = '/doctor:mcp';\n50: \n51: // Closed vocabularies: an unrecognised value has to fail loudly, because a\n52: // silent fallthrough would hand a mutating command the read-only policy (or the\n53: // reverse) and nothing downstream would notice.\n54: const MUTATING_CLASSES = ['read-only', 'add-only', 'mutates'];\n55: const ASK_FIRST_REASONS = ['settings', 'outside-repo', 'spend', 'relaunch'];\n56: const WRITE_SCOPES = ['spec-folder'];\n57: // A lead phrase outranks a passing skill, which is only safe when the prompt asks\n58: // about the state of something. A phrase that names no state or health word could\n59: // outrank the skill on an ordinary task, so it belongs only on a route that\n60: // already asks before it runs.\n61: const LEAD_PHRASE_STATE_WORDS = [\n62:   'check',\n63:   'state',\n64:   'status',\n65:   'report',\n66:   'health',\n67:   'off',\n68:   'on',\n69:   'which',\n70:   'show',\n71:   'list',\n72:   'inventory',\n73:   'drift',\n74:   'stale',\n75:   'missing',\n76:   'failing',\n77:   'broken',\n78: ];\n79: const RENDER_PATH = join(SKILLS_ROOT, 'system-skill-advisor', 'runtime', 'lib', 'render.ts');\n80: const RENDER_GENERATED_START = '// BEGIN GENERATED DOCTOR COMMANDS';\n81: const RENDER_GENERATED_END = '// END GENERATED DOCTOR COMMANDS';\n82: const COMMAND_ATTACH_PATH = join(\n83:   SKILLS_ROOT,\n84:   'system-skill-advisor',\n85:   'runtime',\n86:   'lib',\n87:   'command-attach.ts',\n88: );\n89: const COMMAND_ATTACH_GENERATED_START = '// BEGIN GENERATED MODE COMMANDS';\n90: const COMMAND_ATTACH_GENERATED_END = '// END GENERATED MODE COMMANDS';\n91: \n92: // Manifest-derived runnable strings, trigger phrases and precedence phrases per doctor bridge id.\n93: // The inventory entries keep their five-key shape; the projection merge reads here.\n94: const DOCTOR_DETAILS = new Map();\n95: \n96: // Meaning text per command, taken from the metadata record that already states\n97: // what the command does in the words a person uses. Keyed by command rather than\n98: // by id because an allow-list row keeps its own historical id while the metadata\n99: // it came from still names the command.\n100: const METADATA_MEANING = new Map();\n101: \n102: // ───────────────────────────────────────────────────────────────────\n103: // 3. HELPERS\n104: // ───────────────────────────────────────────────────────────────────\n105: \n106: function readJson(filePath) {\n107:   try {\n108:     return JSON.parse(readFileSync(filePath, 'utf8'));\n109:   } catch (error) {\n110:     throw new Error(`[command-bridges] Failed to read JSON ${filePath}: ${error.message}`);\n111:   }\n112: }\n113: \n114: function bridgeId(command) {\n115:   if (!/^\\/[a-z][a-z0-9-]*:[a-z0-9-]+$/.test(command)) {\n116:     throw new Error(`[command-bridges] Invalid command id: ${command}`);\n117:   }\n118:   return `command-${command.slice(1).replace(':', '-')}`;\n119: }\n120: \n121: function sourcePath(filePath) {\n122:   return relative(REPO_ROOT, filePath).split(sep).join('/');\n123: }\n124: \n125: function metadataEntries(skillsRoot = SKILLS_ROOT) {\n126:   METADATA_MEANING.clear();\n127:   const entries = [];\n128:   const skillIds = readdirSync(skillsRoot, { withFileTypes: true })\n129:     // A private skill is local to one checkout and must never reach a tracked bridge file.\n130:     // Only a private skill may be a link, so any other linked folder is not a skill source.\n131:     .filter((entry) => !entry.name.startsWith('local-') && !entry.isSymbolicLink())\n132:     .map((entry) => entry.name)\n133:     .sort();\n134:   for (const skillId of skillIds) {\n135:     const filePath = join(skillsRoot, skillId, 'command-metadata.json');\n136:     if (!existsSync(filePath)) continue;\n137: \n138:     // A skill with no mode registry has no hub to route its commands, so its\n139:     // metadata is the whole declaration of what each command reaches.\n140:     const standalone = !existsSync(join(skillsRoot, skillId, 'mode-registry.json'));\n141:     const metadata = readJson(filePath);\n142:     if (!Array.isArray(metadata)) {\n143:       throw new Error(`[command-bridges] ${sourcePath(filePath)} must contain a JSON array`);\n144:     }\n145:     for (const [index, entry] of metadata.entries()) {\n146:       if (!entry || typeof entry !== 'object') {\n147:         throw new Error(`[command-bridges] ${sourcePath(filePath)}[${index}] must be an object`);\n148:       }\n149:       const { command, ownerMode } = entry;\n150:       if (typeof command !== 'string' || typeof ownerMode !== 'string' || !ownerMode) {\n151:         throw new Error(\n152:           `[command-bridges] ${sourcePath(filePath)}[${index}] requires string command and ownerMode`,\n153:         );\n154:       }\n155:       const description = entry.description === undefined ? '' : entry.description;\n156:       if (typeof description !== 'string') {\n157:         throw new Error(\n158:           `[command-bridges] ${sourcePath(filePath)}[${index}] description must be a string`,\n159:         );\n160:       }\n161:       // The phrases a person types instead of the command are declared once, in\n162:       // the metadata, so the bridge reads them here instead of restating them.\n163:       const ownedSignals = entry.userIntent && entry.userIntent.ownedSignals !== undefined\n164:         ? stringArray(\n165:           entry.userIntent.ownedSignals,\n166:           `${sourcePath(filePath)}[${index}].userIntent.ownedSignals`,\n167:         )\n168:         : [];\n169:       // The job is prose about the outcome a person wants, so it describes the\n170:       // command in words none of the identifiers do. An absent job is a record\n171:       // that says less, not a broken one.\n172:       const job = entry.userIntent && typeof entry.userIntent.job === 'string'\n173:         ? entry.userIntent.job\n174:         : '';\n175:       METADATA_MEANING.set(command, { description, job, ownedSignals });\n176:       entries.push({\n177:         id: bridgeId(command),\n178:         command,\n179:         skillId,\n180:         ownerMode,\n181:         description,\n182:         ownedSignals: [...ownedSignals],\n183:         standalone,\n184:         mutating: entry.mutating,\n185:         source: sourcePath(filePath),\n186:       });\n187:     }\n188:   }\n189:   return entries;\n190: }\n191: \n192: function allowListEntries() {\n193:   const allowList = readJson(ALLOW_LIST_PATH);\n194:   if (!Array.isArray(allowList)) {\n195:     throw new Error('[command-bridges] allow-list.json must contain a JSON array');\n196:   }\n197:   return allowList.map((entry, index) => {\n198:     if (!entry || typeof entry !== 'object') {\n199:       throw new Error(`[command-bridges] allow-list.json[${index}] must be an object`);\n200:     }\n201:     const { id, command, skillId, ownerMode, reason } = entry;\n202:     if ([id, command, skillId, ownerMode, reason].some((value) => typeof value !== 'string' || !value)) {\n203:       throw new Error(\n204:         `[command-bridges] allow-list.json[${index}] requires id, command, skillId, ownerMode, and reason`,\n205:       );\n206:     }\n207:     return {\n208:       id,\n209:       command,\n210:       skillId,\n211:       ownerMode,\n212:       source: 'scripts/command-bridges/allow-list.json',\n213:     };\n214:   });\n215: }\n216: \n217: function doctorSkillAgent(name) {\n218:   const routerPath = join(DOCTOR_COMMANDS_DIR, `${name}.md`);\n219:   const tag = existsSync(routerPath)\n220:     ? /<!--\\s*skill_agent:\\s*([a-z0-9-]+)\\s*-->/.exec(readFileSync(routerPath, 'utf8'))\n221:     : null;\n222:   if (!tag) {\n223:     throw new Error(\n224:       `[command-bridges] ${sourcePath(routerPath)} has no skill_agent tag; `\n225:         + 'a doctor bridge needs its owning skill',\n226:     );\n227:   }\n228:   return tag[1];\n229: }\n230: \n231: // A router names its own purpose in the frontmatter sentence a person reads\n232: // before anything else, so the bridge embeds that sentence rather than a second\n233: // copy written for the scorer to drift from.\n234: function doctorCommandDescription(name) {\n235:   const routerPath = join(DOCTOR_COMMANDS_DIR, `${name}.md`);\n236:   const match = existsSync(routerPath)\n237:     ? /^---\\r?\\n([\\s\\S]*?)\\r?\\n---/.exec(readFileSync(routerPath, 'utf8'))\n238:     : null;\n239:   // Required lazily for the same reason as the route manifest: an\n240:   // argument-rejecting run must exit before this module needs a YAML parser.\n241:   const YAML = require('yaml');\n242:   let frontmatter = null;\n243:   if (match) {\n244:     try {\n245:       frontmatter = YAML.parse(match[1]);\n246:     } catch (error) {\n247:       throw new Error(\n248:         `[command-bridges] Failed to read the frontmatter of ${sourcePath(routerPath)}: ${error.message}`,\n249:       );\n250:     }\n251:   }\n252:   const description = frontmatter && frontmatter.description;\n253:   if (typeof description !== 'string' || !description.trim()) {\n254:     throw new Error(\n255:       `[command-bridges] ${sourcePath(routerPath)} has no frontmatter description; `\n256:         + 'a doctor bridge needs the sentence it embeds',\n257:     );\n258:   }\n259:   return description.trim();\n260: }\n261: \n262: function doctorCommandName(command, label) {\n263:   const match = /^\\/doctor:([a-z0-9-]+)$/.exec(command);\n264:   if (!match) {\n265:     throw new Error(`[command-bridges] ${label} has invalid doctor command ${command}`);\n266:   }\n267:   return match[1];\n268: }\n269: \n270: function doctorRouteEntries() {\n271:   DOCTOR_DETAILS.clear();\n272:   // Required lazily: an argument-rejecting run must exit before this module\n273:   // ever needs a YAML parser.\n274:   const YAML = require('yaml');\n275:   let manifest;\n276:   try {\n277:     manifest = YAML.parse(readFileSync(DOCTOR_ROUTES_PATH, 'utf8'));\n278:   } catch (error) {\n279:     throw new Error(\n280:       `[command-bridges] Failed to read ${sourcePath(DOCTOR_ROUTES_PATH)}: ${error.message}`,\n281:     );\n282:   }\n283:   const routes = manifest && manifest.routes;\n284:   if (!Array.isArray(routes)) {\n285:     throw new Error('[command-bridges] _routes.yaml routes must be an array');\n286:   }\n287:   const names = routes.map((route, index) => (\n288:     doctorCommandName(route.command, `_routes.yaml routes[${index}]`)\n289:   ));\n290:   const totals = new Map();\n291:   for (const name of names) {\n292:     totals.set(name, (totals.get(name) || 0) + 1);\n293:   }\n294: \n295:   const entries = [];\n296:   routes.forEach((route, index) => {\n297:     const label = `_routes.yaml routes[${index}]`;\n298:     if (typeof route.target !== 'string' || !route.target) {\n299:       throw new Error(`[command-bridges] ${label} requires a non-empty string target`);\n300:     }\n301:     // A command with several targets needs one bridge per target; a\n302:     // single-target command takes the command's own id.\n303:     const multiTarget = totals.get(names[index]) > 1;\n304:     const id = multiTarget\n305:       ? `command-doctor-${names[index]}-${route.target}`\n306:       : `command-doctor-${names[index]}`;\n307:     const skillId = doctorSkillAgent(names[index]);\n308:     const phrases = stringArray(route.trigger_phrases, `${label}.trigger_phrases`);\n309:     const leadPhrases = doctorLeadPhrases(route, label, phrases);\n310:     DOCTOR_DETAILS.set(id, {\n311:       runnable: multiTarget ? `${route.command} ${route.target}` : route.command,\n312:       bareCommand: doctorDefaultTarget(route, label, multiTarget),\n313:       description: doctorCommandDescription(names[index]),\n314:       phrases,\n315:       leadPhrases,\n316:       readOnly: isReadOnlyRoute(route),\n317:     });\n318:     entries.push({\n319:       id,\n320:       command: route.command,\n321:       skillId,\n322:       ownerMode: skillId,\n323:       source: sourcePath(DOCTOR_ROUTES_PATH),\n324:     });\n325:   });\n326: \n327:   const standalone = manifest.standalone === undefined ? [] : manifest.standalone;\n328:   if (!Array.isArray(standalone)) {\n329:     throw new Error('[command-bridges] _routes.yaml standalone must be an array');\n330:   }\n331:   standalone.forEach((item, index) => {\n332:     if (!item || typeof item !== 'object') return;\n333:     const label = `_routes.yaml standalone[${index}]`;\n334:     const phrases = Object.prototype.hasOwnProperty.call(item, 'trigger_phrases')\n335:       ? stringArray(item.trigger_phrases, `${label}.trigger_phrases`)\n336:       : [];\n337:     const leadPhrases = doctorLeadPhrases(item, label, phrases);\n338:     if (typeof item.command !== 'string') return;\n339:     const name = doctorCommandName(item.command, label);\n340:     const skillId = doctorSkillAgent(name);\n341:     const runnable = typeof item.runnable === 'string' && item.runnable\n342:       ? item.runnable\n343:       : item.command;\n344:     DOCTOR_DETAILS.set(`command-doctor-${name}`, {\n345:       runnable,\n346:       description: doctorCommandDescription(name),\n347:       phrases,\n348:       leadPhrases,\n349:       readOnly: isReadOnlyRoute(item),\n350:     });\n351:     entries.push({\n352:       id: `command-doctor-${name}`,\n353:       command: item.command,\n354:       skillId,\n355:       ownerMode: skillId,\n356:       source: sourcePath(DOCTOR_ROUTES_PATH),\n357:     });\n358:   });\n359: \n360:   const mcpSubroutes = manifest.mcp_subroutes === undefined ? [] : manifest.mcp_subroutes;\n361:   if (!Array.isArray(mcpSubroutes)) {\n362:     throw new Error('[command-bridges] _routes.yaml mcp_subroutes must be an array');\n363:   }\n364:   mcpSubroutes.forEach((item, index) => {\n365:     const label = `_routes.yaml mcp_subroutes[${index}]`;\n366:     if (!item || typeof item.sub_action !== 'string' || !item.sub_action) {\n367:       throw new Error(`[command-bridges] ${label} requires a non-empty string sub_action`);\n368:     }\n369:     const commandName = doctorCommandName(DOCTOR_MCP_COMMAND, label);\n370:     const skillId = doctorSkillAgent(commandName);\n371:     const id = `${DOCTOR_PREFIX}${commandName}-${item.sub_action}`;\n372:     const runnable = `${DOCTOR_MCP_COMMAND} ${item.sub_action}`;\n373:     const phrases = stringArray(item.trigger_phrases, `${label}.trigger_phrases`);\n374:     const leadPhrases = doctorLeadPhrases(item, label, phrases);\n375:     DOCTOR_DETAILS.set(id, {\n376:       runnable,\n377:       description: doctorCommandDescription(commandName),\n378:       phrases,\n379:       leadPhrases,\n380:       readOnly: isReadOnlyRoute(item),\n381:     });\n382:     entries.push({\n383:       id,\n384:       command: DOCTOR_MCP_COMMAND,\n385:       skillId,\n386:       ownerMode: skillId,\n387:       source: sourcePath(DOCTOR_ROUTES_PATH),\n388:     });\n389:   });\n390: \n391:   return entries;\n392: }\n393: \n394: // A command exists when its router file exists: the folder directly under the\n395: // commands root names the group and a Markdown file inside it names the action.\n396: // A README and a .contract.md describe a command instead of being one, a file\n397: // directly in the root names no command at all, and a local- name belongs to a\n398: // single checkout, so none of them count.\n399: function commandTreeNames(commandsRoot = COMMANDS_ROOT) {\n400:   const commands = [];\n401:   const groups = readdirSync(commandsRoot, { withFileTypes: true })\n402:     .filter((entry) => entry.isDirectory() && !entry.name.startsWith('local-'))\n403:     .map((entry) => entry.name)\n404:     .sort();\n405:   for (const group of groups) {\n406:     const files = readdirSync(join(commandsRoot, group), { withFileTypes: true })\n407:       .filter((entry) => entry.isFile() && entry.name.endsWith('.md'))\n408:       .filter((entry) => (\n409:         entry.name !== 'README.md'\n410:         && !entry.name.endsWith('.contract.md')\n411:         && !entry.name.startsWith('local-')\n412:       ))\n413:       .map((entry) => `/${group}:${entry.name.slice(0, -'.md'.length)}`);\n414:     commands.push(...files);\n415:   }\n416:   return commands.sort();\n417: }\n418: \n419: // A hub's mode registry is the only place that pairs a workflow mode with the\n420: // command that runs it, so the reader's reverse lookup is derived from the hubs\n421: // themselves rather than transcribed into the consumer and left to drift.\n422: function modeCommandRecords(skillsRoot = SKILLS_ROOT, commandsRoot = COMMANDS_ROOT) {\n423:   const commandNames = new Set(commandTreeNames(commandsRoot));\n424:   const records = [];\n425:   const hubIds = readdirSync(skillsRoot, { withFileTypes: true })\n426:     // The same skill folders as the bridge metadata, for the same reason: a\n427:     // private skill is local to one checkout and a linked folder is not a skill\n428:     // source.\n429:     .filter((entry) => !entry.name.startsWith('local-') && !entry.isSymbolicLink())\n430:     .map((entry) => entry.name)\n431:     .sort();\n432:   for (const hubId of hubIds) {\n433:     const filePath = join(skillsRoot, hubId, 'mode-registry.json');\n434:     if (!existsSync(filePath)) continue;\n435: \n436:     const registry = readJson(filePath);\n437:     const modes = registry && registry.modes;\n438:     if (!Array.isArray(modes)) {\n439:       throw new Error(`[command-bridges] ${sourcePath(filePath)} must contain a modes array`);\n440:     }\n441:     const seen = new Set();\n442:     for (const [index, mode] of modes.entries()) {\n443:       const label = `${sourcePath(filePath)} modes[${index}]`;\n444:       const workflowMode = mode && mode.workflowMode;\n445:       if (typeof workflowMode !== 'string' || !workflowMode) {\n446:         throw new Error(`[command-bridges] ${label} requires a non-empty string workflowMode`);\n447:       }\n448:       // One key per hub: a repeated workflow mode would leave the lookup holding\n449:       // whichever row the table happened to keep, so the registry has to say it\n450:       // once.\n451:       if (seen.has(workflowMode)) {\n452:         throw new Error(\n453:           `[command-bridges] Duplicate workflow mode ${workflowMode} in ${sourcePath(filePath)}`,\n454:         );\n455:       }\n456:       seen.add(workflowMode);\n457: \n458:       const { command } = mode;\n459:       // A null command is a mode with no dedicated slash command, which is a\n460:       // declared state rather than a mistake, so it contributes no row.\n461:       if (typeof command !== 'string' || !command) continue;\n462:       // A command with no router file is one the reader cannot type, so naming\n463:       // it here would promise a surface that does not exist.\n464:       if (!commandNames.has(command)) {\n465:         throw new Error(\n466:           `[command-bridges] ${label} names ${command}, which has no command file`,\n467:         );\n468:       }\n469:       records.push({ hubId, workflowMode, command });\n470:     }\n471:   }\n472:   // The generated file is compared byte for byte, so the order has to be total.\n473:   return records.sort((left, right) => (\n474:     left.hubId === right.hubId\n475:       ? left.workflowMode.localeCompare(right.workflowMode)\n476:       : left.hubId.localeCompare(right.hubId)\n477:   ));\n478: }\n479: \n480: // The policy ladder reads only these keys, so a wrong value has to fail here\n481: // rather than fall through to a branch that merely looks safe.\n482: function validateRiskKeys(record, label, requireTarget = false) {\n483:   if (!MUTATING_CLASSES.includes(record.mutating)) {\n484:     throw new Error(\n485:       `[command-bridges] ${label} has mutating ${JSON.stringify(record.mutating)}; `\n486:         + `expected one of ${MUTATING_CLASSES.join(', ')}`,\n487:     );\n488:   }\n489:   if (record.ask_first !== undefined) {\n490:     const askFirst = record.ask_first;\n491:     if (!Array.isArray(askFirst) || askFirst.some((value) => !ASK_FIRST_REASONS.includes(value))) {\n492:       throw new Error(\n493:         `[command-bridges] ${label} has ask_first ${JSON.stringify(askFirst)}; `\n494:           + `expected an array of ${ASK_FIRST_REASONS.join(', ')}`,\n495:       );\n496:     }\n497:   }\n498:   if (record.write_scope !== undefined && !WRITE_SCOPES.includes(record.write_scope)) {\n499:     throw new Error(\n500:       `[command-bridges] ${label} has write_scope ${JSON.stringify(record.write_scope)}; `\n501:         + `expected one of ${WRITE_SCOPES.join(', ')}`,\n502:     );\n503:   }\n504:   if (requireTarget && (typeof record.gate3_location !== 'string' || !record.gate3_location)) {\n505:     throw new Error(\n506:       `[command-bridges] ${label} needs a non-empty string gate3_location naming what it writes`,\n507:     );\n508:   }\n509: }\n510: \n511: // One policy per command, decided from the risk keys alone so the answer never\n512: // depends on which scorer asks: an ask-first reason always wins, a doctor route\n513: // that mutates asks because its repair is the operator's call, and only a\n514: // read-only route or an add-only route confined to the spec folder may run\n515: // unprompted. Everything else starts as an ordinary task.\n516: function derivePolicy(record) {\n517:   if (Array.isArray(record.ask_first) && record.ask_first.length > 0) return 'ask';\n518:   if (record.doctor === true && record.mutating === 'mutates') return 'ask';\n519:   if (record.mutating === 'read-only') return 'run';\n520:   if (record.mutating === 'add-only' && record.write_scope === 'spec-folder') return 'run';\n521:   return 'start';\n522: }\n523: \n524: // The same skill folders as the bridge metadata, for the same reason: a private\n525: // skill is local to a checkout and a linked folder is not a skill source. A\n526: // metadata command is reachable by typing its name, so it must also name where\n527: // its writes land before its policy may be derived.\n528: function metadataRiskRecords(skillsRoot = SKILLS_ROOT) {\n529:   const records = [];\n530:   const skillIds = readdirSync(skillsRoot, { withFileTypes: true })\n531:     .filter((entry) => !entry.name.startsWith('local-') && !entry.isSymbolicLink())\n532:     .map((entry) => entry.name)\n533:     .sort();\n534:   for (const skillId of skillIds) {\n535:     const filePath = join(skillsRoot, skillId, 'command-metadata.json');\n536:     if (!existsSync(filePath)) continue;\n537:     const metadata = readJson(filePath);\n538:     if (!Array.isArray(metadata)) {\n539:       throw new Error(`[command-bridges] ${sourcePath(filePath)} must contain a JSON array`);\n540:     }\n541:     for (const [index, entry] of metadata.entries()) {\n542:       if (!entry || typeof entry !== 'object') {\n543:         throw new Error(`[command-bridges] ${sourcePath(filePath)}[${index}] must be an object`);\n544:       }\n545:       validateRiskKeys(entry, `${sourcePath(filePath)}[${index}] ${entry.command}`, true);\n546:       records.push({\n547:         command: entry.command,\n548:         route: null,\n549:         mutating: entry.mutating,\n550:         ask_first: entry.ask_first || [],\n551:         write_scope: entry.write_scope,\n552:         doctor: false,\n553:       });\n554:     }\n555:   }\n556:   return records;\n557: }\n558: \n559: // The manifest is the doctor half of the same surface. Requiring YAML lazily\n560: // keeps an argument-rejecting run from ever loading a parser.\n561: function doctorRiskRecords(routesPath = DOCTOR_ROUTES_PATH) {\n562:   const YAML = require('yaml');\n563:   let manifest;\n564:   try {\n565:     manifest = YAML.parse(readFileSync(routesPath, 'utf8'));\n566:   } catch (error) {\n567:     throw new Error(\n568:       `[command-bridges] Failed to read ${sourcePath(routesPath)}: ${error.message}`,\n569:     );\n570:   }\n571: \n572:   const records = [];\n573:   const addRecord = (fields, label) => {\n574:     const record = {\n575:       command: fields.command,\n576:       route: fields.route,\n577:       mutating: fields.mutating,\n578:       ask_first: fields.ask_first || [],\n579:       write_scope: fields.write_scope,\n580:       doctor: true,\n581:     };\n582:     validateRiskKeys(record, label);\n583:     records.push(record);\n584:   };\n585: \n586:   const routes = manifest && manifest.routes;\n587:   if (!Array.isArray(routes)) {\n588:     throw new Error('[command-bridges] _routes.yaml routes must be an array');\n589:   }\n590:   routes.forEach((route, index) => {\n591:     addRecord({\n592:       command: route.command,\n593:       route: route.target,\n594:       mutating: route.mutating,\n595:       ask_first: route.ask_first,\n596:       write_scope: route.write_scope,\n597:     }, `${sourcePath(routesPath)} routes[${index}]`);\n598:   });\n599: \n600:   const mcpSubroutes = manifest.mcp_subroutes === undefined ? [] : manifest.mcp_subroutes;\n601:   if (!Array.isArray(mcpSubroutes)) {\n602:     throw new Error('[command-bridges] _routes.yaml mcp_subroutes must be an array');\n603:   }\n604:   mcpSubroutes.forEach((item, index) => {\n605:     addRecord({\n606:       command: DOCTOR_MCP_COMMAND,\n607:       route: item?.sub_action,\n608:       mutating: item?.mutating,\n609:       ask_first: item?.ask_first,\n610:       write_scope: item?.write_scope,\n611:     }, `${sourcePath(routesPath)} mcp_subroutes[${index}]`);\n612:   });\n613: \n614:   const standalone = manifest.standalone === undefined ? [] : manifest.standalone;\n615:   if (!Array.isArray(standalone)) {\n616:     throw new Error('[command-bridges] _routes.yaml standalone must be an array');\n617:   }\n618:   standalone.forEach((item, index) => {\n619:     if (!item || typeof item.command !== 'string') return;\n620:     const label = `${sourcePath(routesPath)} standalone[${index}]`;\n621:     const actions = item.actions;\n622:     // One command, several actions: the action carries the class because the\n623:     // bare command name cannot say what the run will do.\n624:     if (actions && typeof actions === 'object' && !Array.isArray(actions)) {\n625:       for (const [action, entry] of Object.entries(actions)) {\n626:         addRecord({\n627:           command: item.command,\n628:           route: action,\n629:           mutating: entry?.mutating,\n630:           ask_first: entry?.ask_first,\n631:           write_scope: entry?.write_scope,\n632:         }, `${label}.actions.${action}`);\n633:       }\n634:       return;\n635:     }\n636:     addRecord({\n637:       command: item.command,\n638:       route: null,\n639:       mutating: item.mutating,\n640:       ask_first: item.ask_first,\n641:       write_scope: item.write_scope,\n642:     }, label);\n643:   });\n644: \n645:   return records;\n646: }\n647: \n648: // Three views of one surface. A name in the tree that neither declaration\n649: // carries is a command nothing can suggest; a declared name with no file is a\n650: // bridge to a command the operator cannot type. Either way the inventory lies,\n651: // so both directions are reported together.\n652: function identityViolations({ treeCommands, metadataCommands, doctorCommands }) {\n653:   const tree = new Set(treeCommands);\n654:   const declared = new Set([...metadataCommands, ...doctorCommands]);\n655:   const violations = [];\n656:   for (const command of tree) {\n657:     if (!declared.has(command)) {\n658:       violations.push(\n659:         `${command}: command file has no command-metadata.json entry and no doctor route`,\n660:       );\n661:     }\n662:   }\n663:   for (const command of declared) {\n664:     if (!tree.has(command)) {\n665:       violations.push(\n666:         `${command}: declared in command-metadata.json or the doctor manifest but has no command file`,\n667:       );\n668:     }\n669:   }\n670:   return violations.sort();\n671: }\n672: \n673: // The generated file is compared byte for byte, so the order has to be total:\n674: // command name first, then the bare route before its named ones.\n675: function commandPolicies(skillsRoot, routesPath) {\n676:   return [...metadataRiskRecords(skillsRoot), ...doctorRiskRecords(routesPath)]\n677:     .map((record) => ({\n678:       command: record.command,\n679:       route: record.route,\n680:       mutating: record.mutating,\n681:       askFirst: record.ask_first,\n682:       policy: derivePolicy(record),\n683:     }))\n684:     .sort((left, right) => {\n685:       if (left.command !== right.command) return left.command.localeCompare(right.command);\n686:       if (left.route === right.route) return 0;\n687:       if (left.route === null) return -1;\n688:       if (right.route === null) return 1;\n689:       return left.route.localeCompare(right.route);\n690:     });\n691: }\n692: \n693: function assertUniqueIds(entries) {\n694:   const seen = new Map();\n695:   for (const entry of entries) {\n696:     const previous = seen.get(entry.id);\n697:     if (previous) {\n698:       throw new Error(\n699:         `[command-bridges] Duplicate bridge id ${entry.id}: ${previous.source} and ${entry.source}`,\n700:       );\n701:     }\n702:     seen.set(entry.id, entry);\n703:   }\n704: }\n705: \n706: function stringArray(value, label) {\n707:   if (!Array.isArray(value) || value.some((entry) => typeof entry !== 'string' || !entry)) {\n708:     throw new Error(`[command-bridges] ${label} must be an array of non-empty strings`);\n709:   }\n710:   return value;\n711: }\n712: \n713: // A vector has to describe the job a command does, so the slash form is dropped\n714: // before the text is built. A name left in would hand the scorer a second copy\n715: // of the token it already matches literally.\n716: function commandEmbeddingText({ description, job, ownedSignals }) {\n717:   // Each part is cleaned before the join: a part that was only a slash command,\n718:   // or one that already ends in a full stop, would otherwise leave stray\n719:   // punctuation in text whose only reader is an embedder.\n720:   // A prompt is written in the asker's voice, and so are the job sentence and\n721:   // the owned phrases. The description is written in the command's voice and\n722:   // carries mode and step notes no asker types, so it stands in only when a\n723:   // record states no job.\n724:   const lead = typeof job === 'string' && job.trim() ? job : description;\n725:   return [lead, ...ownedSignals]\n726:     .filter((part) => typeof part === 'string')\n727:     .map((part) => part\n728:       .replace(/\\/?[a-z-]+:[a-z-]+/g, ' ')\n729:       .replace(/\\s+/g, ' ')\n730:       .trim()\n731:       .replace(/[.\\s]+$/, ''))\n732:     .filter(Boolean)\n733:     .join('. ');\n734: }\n735: \n736: // Only a bridge a scorer can offer carries meaning text, and where it comes from\n737: // depends on the row: a metadata row states it in its own record, while a doctor\n738: // row states it in the router sentence and the route phrases it already declares.\n739: function entryMeaning(entryId, command, isDoctor) {\n740:   if (!isDoctor) return METADATA_MEANING.get(command);\n741:   const { description, phrases } = DOCTOR_DETAILS.get(entryId);\n742:   return { description, ownedSignals: phrases };\n743: }\n744: \n745: // Only a route the manifest classes as read-only may answer a list or show\n746: // question; add-only and mutating routes keep the read-only confidence floor.\n747: function isReadOnlyRoute(item) {\n748:   return item.mutating === 'read-only';\n749: }\n750: \n751: // A command with several targets runs only as `<command> <target>`, yet its router binds one\n752: // target when none is typed. A route marked default_target also answers the bare command, so\n753: // the typed command alone still reaches a bridge.\n754: function doctorDefaultTarget(route, label, multiTarget) {\n755:   if (!Object.prototype.hasOwnProperty.call(route, 'default_target')) return null;\n756:   if (typeof route.default_target !== 'boolean') {\n757:     throw new Error(`[command-bridges] ${label}.default_target must be a boolean`);\n758:   }\n759:   if (!route.default_target) return null;\n760:   if (!multiTarget) {\n761:     throw new Error(\n762:       `[command-bridges] ${label}.default_target is only valid on a command with several targets`,\n763:     );\n764:   }\n765:   return route.command;\n766: }\n767: \n768: // A lead phrase is matched against the whole prompt, so the state word has to be\n769: // a word of its own: \"on\" inside \"environment\" would clear a phrase that asks\n770: // nothing about state.\n771: function hasStateWord(phrase) {\n772:   return phrase\n773:     .toLowerCase()\n774:     .split(/[^a-z0-9]+/)\n775:     .some((word) => LEAD_PHRASE_STATE_WORDS.includes(word));\n776: }\n777: \n778: // A route that asks first may lead with a phrase that names no state or health\n779: // word, because the ask already keeps the run behind a decision.\n780: function doctorLeadPhrases(item, label, triggerPhrases) {\n781:   const leadPhrases = Object.prototype.hasOwnProperty.call(item, 'lead_phrases')\n782:     ? stringArray(item.lead_phrases, `${label}.lead_phrases`)\n783:     : [];\n784:   const asksFirst = derivePolicy({\n785:     doctor: true,\n786:     mutating: item.mutating,\n787:     ask_first: item.ask_first,\n788:     write_scope: item.write_scope,\n789:   }) === 'ask';\n790:   for (const phrase of leadPhrases) {\n791:     if (!triggerPhrases.includes(phrase)) {\n792:       throw new Error(\n793:         `[command-bridges] ${label}.lead_phrases entry ${JSON.stringify(phrase)} must also appear in trigger_phrases`,\n794:       );\n795:     }\n796:     if (!asksFirst && !hasStateWord(phrase)) {\n797:       throw new Error(\n798:         `[command-bridges] ${label}.lead_phrases entry ${JSON.stringify(phrase)} needs a state or health word because its route does not ask first`,\n799:       );\n800:     }\n801:   }\n802:   return leadPhrases;\n803: }\n804: \n805: function compatibilityByInventoryId(entries, inventoryIds, platform) {\n806:   if (!Array.isArray(entries)) {\n807:     throw new Error(`[command-bridges] scoring-compatibility.json ${platform} must be an array`);\n808:   }\n809:   const byInventoryId = new Map();\n810:   const orders = new Set();\n811:   for (const [index, entry] of entries.entries()) {\n812:     if (!entry || typeof entry !== 'object') {\n813:       throw new Error(`[command-bridges] ${platform}[${index}] must be an object`);\n814:     }\n815:     const { inventoryId, order, id, description } = entry;\n816:     if (\n817:       typeof inventoryId !== 'string'\n818:       || !inventoryIds.has(inventoryId)\n819:       || !Number.isInteger(order)\n820:       || order < 0\n821:       || typeof id !== 'string'\n822:       || !id\n823:       || typeof description !== 'string'\n824:     ) {\n825:       throw new Error(\n826:         `[command-bridges] ${platform}[${index}] requires a known inventoryId, ` +\n827:           'non-negative integer order, id, and description',\n828:       );\n829:     }\n830:     if (byInventoryId.has(inventoryId)) {\n831:       throw new Error(`[command-bridges] Duplicate ${platform} inventoryId ${inventoryId}`);\n832:     }\n833:     if (orders.has(order)) {\n834:       throw new Error(`[command-bridges] Duplicate ${platform} order ${order}`);\n835:     }\n836:     const isDoctor = inventoryId.startsWith(DOCTOR_PREFIX);\n837:     if (isDoctor && id !== inventoryId) {\n838:       throw new Error(\n839:         `[command-bridges] ${platform}[${index}] doctor bridge id must equal its inventoryId`,\n840:       );\n841:     }\n842:     if (platform === 'typescript') {\n843:       if (!isDoctor) {\n844:         if (typeof entry.name !== 'string' || !entry.name) {\n845:           throw new Error(`[command-bridges] typescript[${index}] requires name`);\n846:         }\n847:         stringArray(entry.keywords, `typescript[${index}].keywords`);\n848:         stringArray(entry.domains, `typescript[${index}].domains`);\n849:         stringArray(entry.intentSignals, `typescript[${index}].intentSignals`);\n850:       }\n851:     } else {\n852:       if (!isDoctor) {\n853:         stringArray(entry.slashMarkers, `python[${index}].slashMarkers`);\n854:       }\n855:       if ('owningSkill' in entry && (typeof entry.owningSkill !== 'string' || !entry.owningSkill)) {\n856:         throw new Error(`[command-bridges] python[${index}].owningSkill must be a non-empty string`);\n857:       }\n858:       if ('deprecated' in entry && typeof entry.deprecated !== 'boolean') {\n859:         throw new Error(`[command-bridges] python[${index}].deprecated must be boolean`);\n860:       }\n861:     }\n862:     byInventoryId.set(inventoryId, entry);\n863:     orders.add(order);\n864:   }\n865:   return byInventoryId;\n866: }\n867: \n868: // A standalone skill has no hub registry, so the only record of what its\n869: // commands reach is its own metadata. The match is by command rather than by id\n870: // because one command can enter the inventory under a row that carries its own\n871: // historical id.\n872: function standaloneCommandRecords(entries, metadata) {\n873:   const byCommand = new Map();\n874:   for (const record of metadata) {\n875:     if (record.standalone) byCommand.set(record.command, record);\n876:   }\n877:   return entries\n878:     .filter((entry) => byCommand.has(entry.command))\n879:     .sort((left, right) => left.id.localeCompare(right.id))\n880:     .map((entry) => ({ entry, record: byCommand.get(entry.command) }));\n881: }\n882: \n883: // A generated row is the command's only reach, so one phrase would leave it\n884: // indistinguishable from every other command and the activation would claim a\n885: // surface the scorer cannot actually offer.\n886: function assertPlainChatSignals(records) {\n887:   for (const { entry, record } of records) {\n888:     if (record.ownedSignals.length < 2) {\n889:       throw new Error(\n890:         `[command-bridges] ${entry.command} needs at least two userIntent.ownedSignals `\n891:           + `in ${record.source}, found ${record.ownedSignals.length}`,\n892:       );\n893:     }\n894:   }\n895: }\n896: \n897: function commandNamespace(command) {\n898:   return command.slice(1, command.indexOf(':'));\n899: }\n900: \n901: // A standalone skill's commands are active by construction: the metadata already\n902: // names the phrases a person types, so a hand row would be a second copy left to\n903: // drift. A hand row still wins where one exists, because a curated row can carry\n904: // phrases the metadata cannot know. Orders start past the highest hand-written\n905: // one so a later hand row never has to renumber a generated one.\n906: function activateStandaloneCommands(byInventoryId, records, platform) {\n907:   let nextOrder = 0;\n908:   for (const row of byInventoryId.values()) {\n909:     nextOrder = Math.max(nextOrder, row.order + 1);\n910:   }\n911:   for (const { entry, record } of records) {\n912:     if (byInventoryId.has(entry.id)) continue;\n913:     byInventoryId.set(entry.id, standaloneRuntimeRow(entry, record, nextOrder, platform));\n914:     nextOrder += 1;\n915:   }\n916: }\n917: \n918: function standaloneRuntimeRow(entry, record, order, platform) {\n919:   if (platform === 'typescript') {\n920:     return {\n921:       inventoryId: entry.id,\n922:       order,\n923:       id: entry.id,\n924:       name: entry.id,\n925:       description: record.description,\n926:       keywords: [...record.ownedSignals],\n927:       domains: [commandNamespace(entry.command), 'command'],\n928:       intentSignals: [...record.ownedSignals],\n929:       // The class decides this for every command, not only a doctor route.\n930:       ...(isReadOnlyRoute(record) ? { readOnly: true } : {}),\n931:     };\n932:   }\n933:   return {\n934:     inventoryId: entry.id,\n935:     order,\n936:     id: entry.id,\n937:     description: record.description,\n938:     slashMarkers: [entry.command, entry.command.slice(1)],\n939:     owningSkill: record.skillId,\n940:   };\n941: }\n942: \n943: function runtimeCompatibility(entries, metadata) {\n944:   const compatibility = readJson(COMPATIBILITY_PATH);\n945:   if (!compatibility || typeof compatibility !== 'object' || compatibility.schemaVersion !== 1) {\n946:     throw new Error('[command-bridges] scoring-compatibility.json requires schemaVersion 1');\n947:   }\n948:   const inventoryIds = new Set(entries.map((entry) => entry.id));\n949:   const typescript = compatibilityByInventoryId(\n950:     compatibility.typescript,\n951:     inventoryIds,\n952:     'typescript',\n953:   );\n954:   const python = compatibilityByInventoryId(compatibility.python, inventoryIds, 'python');\n955:   const standalone = standaloneCommandRecords(entries, metadata);\n956:   assertPlainChatSignals(standalone);\n957:   activateStandaloneCommands(typescript, standalone, 'typescript');\n958:   activateStandaloneCommands(python, standalone, 'python');\n959:   const pythonOwnerNormalization = compatibility.pythonOwnerNormalization;\n960:   if (\n961:     !pythonOwnerNormalization\n962:     || typeof pythonOwnerNormalization !== 'object'\n963:     || Array.isArray(pythonOwnerNormalization)\n964:     || Object.entries(pythonOwnerNormalization).some(\n965:       ([key, value]) => !key || typeof value !== 'string' || !value,\n966:     )\n967:   ) {\n968:     throw new Error(\n969:       '[command-bridges] scoring-compatibility.json pythonOwnerNormalization must be a string map',\n970:     );\n971:   }\n972:   const activePythonIds = new Set([...python.values()].map((entry) => entry.id));\n973:   for (const runtimeId of Object.keys(pythonOwnerNormalization)) {\n974:     if (!activePythonIds.has(runtimeId)) {\n975:       throw new Error(\n976:         `[command-bridges] pythonOwnerNormalization references inactive bridge ${runtimeId}`,\n977:       );\n978:     }\n979:   }\n980:   return { typescript, python, pythonOwnerNormalization };\n981: }\n982: \n983: function tsString(value) {\n984:   return `'${value.replaceAll('\\\\', '\\\\\\\\').replaceAll(\"'\", \"\\\\'\")}'`;\n985: }\n986: \n987: function tsArray(values) {\n988:   return `[${values.map((value) => tsString(value)).join(', ')}]`;\n989: }\n990: \n991: function doctorRuntime(entryId, platform, compat) {\n992:   const { runnable, bareCommand, phrases, leadPhrases, readOnly } = DOCTOR_DETAILS.get(entryId);\n993:   if (platform === 'typescript') {\n994:     return {\n995:       ...compat,\n996:       name: runnable,\n997:       keywords: bareCommand ? [...phrases, bareCommand] : [...phrases],\n998:       intentSignals: [runnable],\n999:       ...(leadPhrases.length > 0 ? { leadPhrases: [...leadPhrases] } : {}),\n1000:       ...(readOnly ? { readOnly: true } : {}),\n1001:       domains: ['doctor', 'command'],\n1002:     };\n1003:   }\n1004:   return {\n1005:     ...compat,\n1006:     slashMarkers: bareCommand ? [runnable, bareCommand] : [runnable],\n1007:     ...(leadPhrases.length > 0 ? { leadPhrases: [...leadPhrases] } : {}),\n1008:   };\n1009: }\n1010: \n1011: function runtimeOrdered(entries, platform) {\n1012:   return [...entries].sort((left, right) => {\n1013:     const leftRuntime = left.runtime[platform];\n1014:     const rightRuntime = right.runtime[platform];\n1015:     if (leftRuntime.enabled !== rightRuntime.enabled) {\n1016:       return leftRuntime.enabled ? -1 : 1;\n1017:     }\n1018:     if (leftRuntime.enabled && rightRuntime.enabled) {\n1019:       return leftRuntime.order - rightRuntime.order;\n1020:     }\n1021:     return left.id.localeCompare(right.id);\n1022:   });\n1023: }\n1024: \n1025: function renderTypescriptBridge(entry) {\n1026:   const runtime = entry.runtime.typescript;\n1027:   const active = runtime.enabled;\n1028:   const id = active ? runtime.id : entry.id;\n1029:   const name = active ? runtime.name : entry.id;\n1030:   const description = active ? runtime.description : '';\n1031:   const keywords = active ? runtime.keywords : [];\n1032:   const domains = active ? runtime.domains : [];\n1033:   const intentSignals = active ? runtime.intentSignals : [];\n1034:   const lines = [\n1035:     '  {',\n1036:     `    inventoryId: ${tsString(entry.id)},`,\n1037:     `    ownerSkill: ${tsString(entry.skillId)},`,\n1038:     `    routingEnabled: ${active},`,\n1039:     `    id: ${tsString(id)},`,\n1040:     \"    kind: 'command',\",\n1041:     \"    family: 'system',\",\n1042:     \"    category: 'command',\",\n1043:     `    name: ${tsString(name)},`,\n1044:     `    description: ${tsString(description)},`,\n1045:     `    keywords: ${tsArray(keywords)},`,\n1046:     `    domains: ${tsArray(domains)},`,\n1047:     `    intentSignals: ${tsArray(intentSignals)},`,\n1048:   ];\n1049:   if (active && runtime.leadPhrases?.length) {\n1050:     lines.push(`    leadPhrases: ${tsArray(runtime.leadPhrases)},`);\n1051:   }\n1052:   if (active && runtime.readOnly === true) {\n1053:     lines.push('    readOnly: true,');\n1054:   }\n1055:   lines.push(\n1056:     '    derivedTriggers: [],',\n1057:     '    derivedKeywords: [],',\n1058:     '    sourcePath: null,',\n1059:     \"    lifecycleStatus: 'active',\",\n1060:     '  },',\n1061:   );\n1062:   return lines.join('\\n');\n1063: }\n1064: \n1065: function renderTypescriptProjection(entries) {\n1066:   const body = runtimeOrdered(entries, 'typescript').map(renderTypescriptBridge).join('\\n');\n1067:   return `export const GENERATED_COMMAND_BRIDGES: readonly CommandBridgeProjection[] = [\\n${body}\\n];`;\n1068: }\n1069: \n1070: function pythonString(value) {\n1071:   return JSON.stringify(value);\n1072: }\n1073: \n1074: function pythonList(values) {\n1075:   return `[${values.map((value) => pythonString(value)).join(', ')}]`;\n1076: }\n1077: \n1078: function renderPythonBridge(entry) {\n1079:   const runtime = entry.runtime.python;\n1080:   const active = runtime.enabled;\n1081:   const runtimeId = active ? runtime.id : entry.id;\n1082:   const description = active ? runtime.description : '';\n1083:   const slashMarkers = active ? runtime.slashMarkers : [entry.command];\n1084:   const lines = [\n1085:     `    ${pythonString(runtimeId)}: {`,\n1086:     `        \"description\": ${pythonString(description)},`,\n1087:     `        \"slash_markers\": ${pythonList(slashMarkers)},`,\n1088:   ];\n1089:   if (active && runtime.leadPhrases?.length) {\n1090:     lines.push(`        \"lead_phrases\": ${pythonList(runtime.leadPhrases)},`);\n1091:   }\n1092:   if (active && runtime.deprecated === true) {\n1093:     lines.push('        \"deprecated\": True,');\n1094:   }\n1095:   if (active && typeof runtime.owningSkill === 'string') {\n1096:     lines.push(`        \"owning_skill\": ${pythonString(runtime.owningSkill)},`);\n1097:   }\n1098:   lines.push(\n1099:     `        \"inventory_id\": ${pythonString(entry.id)},`,\n1100:     `        \"command\": ${pythonString(entry.command)},`,\n1101:     `        \"skill_id\": ${pythonString(entry.skillId)},`,\n1102:     `        \"owner_mode\": ${pythonString(entry.ownerMode)},`,\n1103:     `        \"routing_enabled\": ${active ? 'True' : 'False'},`,\n1104:     '    },',\n1105:   );\n1106:   return lines.join('\\n');\n1107: }\n1108: \n1109: function renderPythonProjection(entries, pythonOwnerNormalization) {\n1110:   const body = runtimeOrdered(entries, 'python').map(renderPythonBridge).join('\\n');\n1111:   const normalization = Object.entries(pythonOwnerNormalization)\n1112:     .map(([id, owner]) => `    ${pythonString(id)}: ${pythonString(owner)},`)\n1113:     .join('\\n');\n1114:   return [\n1115:     'GENERATED_COMMAND_BRIDGES = {',\n1116:     body,\n1117:     '}',\n1118:     '',\n1119:     'GENERATED_COMMAND_BRIDGE_OWNER_NORMALIZATION = {',\n1120:     normalization,\n1121:     '}',\n1122:   ].join('\\n');\n1123: }\n1124: \n1125: function replaceMarkedBlock(content, startMarker, endMarker, replacement, filePath) {\n1126:   const start = content.indexOf(startMarker);\n1127:   const end = content.indexOf(endMarker);\n1128:   if (start < 0 || end < 0 || end < start) {\n1129:     throw new Error(`[command-bridges] Missing generated markers in ${sourcePath(filePath)}`);\n1130:   }\n1131:   const bodyStart = start + startMarker.length;\n1132:   return `${content.slice(0, bodyStart)}\\n${replacement}\\n${content.slice(end)}`;\n1133: }\n1134: \n1135: function renderDoctorCommandStrings(entries) {\n1136:   const lines = entries\n1137:     .filter((entry) => entry.id.startsWith(DOCTOR_PREFIX))\n1138:     .sort((left, right) => left.id.localeCompare(right.id))\n1139:     .map((entry) => {\n1140:       const { runnable } = DOCTOR_DETAILS.get(entry.id);\n1141:       return `  ${tsString(entry.id)}: ${tsString(runnable)},`;\n1142:     });\n1143:   return [\n1144:     'const DOCTOR_COMMAND_STRINGS: Readonly<Record<string, string>> = Object.freeze({',\n1145:     ...lines,\n1146:     '});',\n1147:   ].join('\\n');\n1148: }\n1149: \n1150: // Hub-then-mode nesting so a reader scans one hub's modes together, and the\n1151: // records arrive already ordered so the block is byte-identical between runs.\n1152: function renderModeCommands(records) {\n1153:   const lines = [\n1154:     'export const MODE_COMMANDS: Readonly<Record<string, Readonly<Record<string, string>>>> = {',\n1155:   ];\n1156:   let hubId = null;\n1157:   for (const record of records) {\n1158:     if (record.hubId !== hubId) {\n1159:       if (hubId !== null) lines.push('  },');\n1160:       hubId = record.hubId;\n1161:       lines.push(`  ${tsString(hubId)}: {`);\n1162:     }\n1163:     lines.push(`    ${tsString(record.workflowMode)}: ${tsString(record.command)},`);\n1164:   }\n1165:   if (hubId !== null) lines.push('  },');\n1166:   lines.push('};');\n1167:   return lines.join('\\n');\n1168: }\n1169: \n1170: function generatedSources(entries, pythonOwnerNormalization, modeCommands) {\n1171:   const typescript = readFileSync(TS_PROJECTION_PATH, 'utf8');\n1172:   const python = readFileSync(PY_ADVISOR_PATH, 'utf8');\n1173:   const render = readFileSync(RENDER_PATH, 'utf8');\n1174:   const commandAttach = readFileSync(COMMAND_ATTACH_PATH, 'utf8');\n1175:   return [\n1176:     {\n1177:       path: TS_PROJECTION_PATH,\n1178:       current: typescript,\n1179:       next: replaceMarkedBlock(\n1180:         typescript,\n1181:         TS_GENERATED_START,\n1182:         TS_GENERATED_END,\n1183:         renderTypescriptProjection(entries),\n1184:         TS_PROJECTION_PATH,\n1185:       ),\n1186:     },\n1187:     {\n1188:       path: PY_ADVISOR_PATH,\n1189:       current: python,\n1190:       next: replaceMarkedBlock(\n1191:         python,\n1192:         PY_GENERATED_START,\n1193:         PY_GENERATED_END,\n1194:         renderPythonProjection(entries, pythonOwnerNormalization),\n1195:         PY_ADVISOR_PATH,\n1196:       ),\n1197:     },\n1198:     {\n1199:       path: RENDER_PATH,\n1200:       current: render,\n1201:       next: replaceMarkedBlock(\n1202:         render,\n1203:         RENDER_GENERATED_START,\n1204:         RENDER_GENERATED_END,\n1205:         renderDoctorCommandStrings(entries),\n1206:         RENDER_PATH,\n1207:       ),\n1208:     },\n1209:     {\n1210:       path: COMMAND_ATTACH_PATH,\n1211:       current: commandAttach,\n1212:       next: replaceMarkedBlock(\n1213:         commandAttach,\n1214:         COMMAND_ATTACH_GENERATED_START,\n1215:         COMMAND_ATTACH_GENERATED_END,\n1216:         renderModeCommands(modeCommands),\n1217:         COMMAND_ATTACH_PATH,\n1218:       ),\n1219:     },\n1220:   ];\n1221: }\n1222: \n1223: // ───────────────────────────────────────────────────────────────────\n1224: // 4. CORE LOGIC\n1225: // ───────────────────────────────────────────────────────────────────\n1226: \n1227: function main() {\n1228:   // CLI-only rejection: requiring this module (for example from tests) must\n1229:   // not exit on arguments belonging to the host process.\n1230:   if (require.main === module) {\n1231:     const unknownArg = process.argv.slice(2).find((token) => token !== '--check');\n1232:     if (unknownArg !== undefined) {\n1233:       console.error(`derive-command-bridges.cjs: unknown option: ${unknownArg}`);\n1234:       console.error('usage: derive-command-bridges.cjs [--check]');\n1235:       process.exit(2);\n1236:     }\n1237:   }\n1238:   const checkOnly = process.argv.includes('--check');\n1239:   const metadata = metadataEntries();\n1240:   const allowList = allowListEntries();\n1241:   const doctor = doctorRouteEntries();\n1242:   // The identity check compares command names against the declarations that make\n1243:   // a command real; an allow-list row only repeats an ownership id for a command\n1244:   // the tree and the metadata already name, so it adds nothing there.\n1245:   const tree = commandTreeNames();\n1246:   const metadataRisk = metadataRiskRecords();\n1247:   const doctorRisk = doctorRiskRecords();\n1248:   const modeCommands = modeCommandRecords();\n1249:   const violations = identityViolations({\n1250:     treeCommands: tree,\n1251:     metadataCommands: metadataRisk.map((record) => record.command),\n1252:     doctorCommands: doctorRisk.map((record) => record.command),\n1253:   });\n1254:   if (violations.length > 0) {\n1255:     throw new Error(`[command-bridges] command inventory mismatch:\\n${violations.join('\\n')}`);\n1256:   }\n1257:   // A command the allow-list already carries keeps that row's id: both scorers\n1258:   // know it, and a second id for one command would be a second bridge.\n1259:   const allowListCommands = new Set(allowList.map((entry) => entry.command));\n1260:   const bridgedMetadata = metadata.filter((entry) => !allowListCommands.has(entry.command));\n1261:   const inventory = [...bridgedMetadata, ...allowList, ...doctor]\n1262:     .sort((left, right) => left.id.localeCompare(right.id));\n1263:   assertUniqueIds(inventory);\n1264:   const compatibility = runtimeCompatibility(inventory, metadata);\n1265:   const entries = inventory.map((entry) => {\n1266:     const isDoctor = entry.id.startsWith(DOCTOR_PREFIX);\n1267:     const typescript = compatibility.typescript.get(entry.id);\n1268:     const python = compatibility.python.get(entry.id);\n1269:     // A command nothing describes has nothing written to embed, so the field\n1270:     // appears only where a source sentence exists for it.\n1271:     const meaning = typescript ? entryMeaning(entry.id, entry.command, isDoctor) : undefined;\n1272:     const runtime = { typescript: { enabled: false }, python: { enabled: false } };\n1273:     if (typescript) {\n1274:       runtime.typescript = {\n1275:         enabled: true,\n1276:         ...(isDoctor ? doctorRuntime(entry.id, 'typescript', typescript) : typescript),\n1277:       };\n1278:     }\n1279:     if (python) {\n1280:       runtime.python = {\n1281:         enabled: true,\n1282:         ...(isDoctor ? doctorRuntime(entry.id, 'python', python) : python),\n1283:       };\n1284:     }\n1285:     return {\n1286:       ...entry,\n1287:       ...(meaning ? { embeddingText: commandEmbeddingText(meaning) } : {}),\n1288:       runtime,\n1289:     };\n1290:   });\n1291: \n1292:   const projection = {\n1293:     schemaVersion: 2,\n1294:     generatedBy: 'scripts/command-bridges/derive-command-bridges.cjs',\n1295:     counts: {\n1296:       commandMetadata: bridgedMetadata.length,\n1297:       allowList: allowList.length,\n1298:       doctorRoutes: doctor.length,\n1299:       generated: entries.length,\n1300:       typescriptActive: compatibility.typescript.size,\n1301:       pythonActive: compatibility.python.size,\n1302:     },\n1303:     entries,\n1304:     commandPolicies: commandPolicies(),\n1305:   };\n1306:   const output = `${JSON.stringify(projection, null, 2)}\\n`;\n1307:   const sources = generatedSources(entries, compatibility.pythonOwnerNormalization, modeCommands);\n1308:   const changed = [\n[Output truncated. Continue reading with offset: 1309]"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/scripts/command-bridges/derive-command-bridges.cjs\"}"},"time":{"start":1794526796649,"end":1794526797051}}}}
