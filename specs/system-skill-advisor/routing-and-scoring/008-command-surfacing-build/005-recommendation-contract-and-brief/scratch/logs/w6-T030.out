{"type":"tool_use","timestamp":1794528100942,"sessionID":"ses_e2dcb1103ffeGrdgWm2vKSdC9J","part":{"partID":"prt_1d235c02b0013snlYreJlXbP2s","sessionID":"ses_e2dcb1103ffeGrdgWm2vKSdC9J","messageID":"msg_1d235b276001Yu59kjWVLtuJYL","type":"tool","id":"call_593ccb337ec442adbe5b935e","tool":"read","state":{"status":"completed","input":{"path":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/lib/scorer/fusion.ts"},"output":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/lib/scorer/fusion.ts, lines 1-1058\n1: // ───────────────────────────────────────────────────────────────\n2: // MODULE: Advisor 5-Lane Fusion\n3: // ───────────────────────────────────────────────────────────────\n4: \n5: // ───────────────────────────────────────────────────────────────────\n6: // 1. IMPORTS\n7: // ───────────────────────────────────────────────────────────────────\n8: \n9: import { fuseResultsMulti } from '@spec-kit/shared/algorithms/rrf-fusion.js';\n10: \n11: import { applyAmbiguity, isAmbiguousTopTwo, wideAmbiguityMembers } from './ambiguity.js';\n12: import { attributionReason, dominantLane, isDerivedDominant } from './attribution.js';\n13: import {\n14:   ADVISOR_HOOK_FRESHNESS_VALUES,\n15:   ADVISOR_RUNTIME_VALUES,\n16:   isSpeckitMetricsEnabled,\n17:   speckitMetrics,\n18: } from '../metrics.js';\n19: import { normalize } from '../affordance-normalizer.js';\n20: import { scoreDerivedLane } from './lanes/derived.js';\n21: import { scoreExplicitLane } from './lanes/explicit.js';\n22: import { scoreGraphCausalLaneSplit } from './lanes/graph-causal.js';\n23: import { scoreLexicalLane } from './lanes/lexical.js';\n24: import { scoreSemanticShadowExactSubset, scoreSemanticShadowLane } from './lanes/semantic-shadow.js';\n25: import { applyExecutorDelegationOverride } from './executor-delegation.js';\n26: import {\n27:   DOCTOR_HELPER_BRIDGE_ID,\n28:   DOCTOR_HELPER_UNCUED_MIN_SCORE,\n29:   doctorProblemCue,\n30:   matchDoctorProblem,\n31: } from './doctor-helper-handoff.js';\n32: import { loadAdvisorProjection } from './projection.js';\n33: import { SCORING_CALIBRATION } from './scoring-constants.js';\n34: import { isReadOnlyExplainer, matchesPhraseBoundary } from './text.js';\n35: import {\n36:   DEFAULT_SCORER_WEIGHTS,\n37:   SCORER_LANES,\n38:   liveWeightTotal,\n39: } from './weights-config.js';\n40: import { isLiveScorerLane } from './lane-registry.js';\n41: import { isRouteExcludedSkillId } from '../route-exclusions.js';\n42: import { SKILL_ADVISOR_COMPAT_CONTRACT, resolvedConfidenceThreshold, resolvedUncertaintyThreshold } from '../compat/contract.js';\n43: import type {\n44:   AdvisorProjection,\n45:   AdvisorScoredRecommendation,\n46:   AdvisorScoringOptions,\n47:   AdvisorScoringResult,\n48:   LaneContribution,\n49:   LaneMatch,\n50:   LaneRuntimeHealth,\n51:   LaneScores,\n52:   ScorerLane,\n53:   SkillProjection,\n54: } from './types.js';\n55: import type { NormalizedAffordance } from '../affordance-normalizer.js';\n56: import type { RankedList, RrfItem } from '@spec-kit/shared/algorithms/rrf-fusion.js';\n57: \n58: // ───────────────────────────────────────────────────────────────────\n59: // 2. CONSTANTS\n60: // ───────────────────────────────────────────────────────────────────\n61: \n62: const DEFAULT_CONFIDENCE_THRESHOLD = resolvedConfidenceThreshold();\n63: const DEFAULT_UNCERTAINTY_THRESHOLD = resolvedUncertaintyThreshold();\n64: export const ADVISOR_RRF_FUSION_FLAG = 'SPECKIT_ADVISOR_RRF_FUSION';\n65: export const ADVISOR_QUERY_CLASS_ROUTING_FLAG = 'SPECKIT_ADVISOR_QUERY_CLASS_ROUTING';\n66: export const ADVISOR_EXACT_SEMANTIC_RERANK_FLAG = 'SPECKIT_ADVISOR_EXACT_SEMANTIC_RERANK';\n67: export const ADVISOR_RRF_K = 8;\n68: export const ADVISOR_EXACT_SEMANTIC_RERANK_TOP_K = 10;\n69: const ADVISOR_EXACT_SEMANTIC_RERANK_WINDOW = 0.05;\n70: const TASK_INTENT = /\\b(add|append|build|change|configure|create|edit|fix|generate|implement|modify|move|patch|refactor|rename|replace|run|start|sweep|update|write)\\b/;\n71: const DEEP_RESEARCH_CYCLE = /\\b(automated research cycle|looped investigation|continue iteration|resume iteration|overnight run|overnight research run|packet-local iteration|delta record|canonical jsonl|same lineage)\\b/;\n72: // Writing a test or a helper is code work even when the prompt also names a deep-review phrase or a\n73: // study artifact: the thing asked for comes before the phrase it is written about, so a \"deep review\"\n74: // between the verb and the noun means the loop itself is the subject.\n75: const AUTHORS_CODE = /\\b(?:add|build|create|implement|write)\\b(?:(?!deep[- ]review)[^.?!]){0,60}?\\b(?:helper|vitest|tests?)\\b/;\n76: // Writing a changelog is sk-doc's changelog mode even when the prompt names a\n77: // packet or spec folder. That folder is only where the change history comes from.\n78: // The verb must govern the changelog itself: only articles and folder or scope\n79: // modifiers may sit between them, so \"add a nested phase ... for the changelog\n80: // work\" or \"write the spec folder docs, including the changelog ...\" stay\n81: // spec-folder work.\n82: const CHANGELOG_AUTHORING = /\\b(?:add|create|draft|write)\\s+(?:(?:a|an|the|new|nested|packet|packet-local|phase|global|release)\\s+){0,4}changelog(?:\\s+entry)?\\b/;\n83: const CHANGELOG_PACKET_SOURCE = /\\b(?:packet|nested|spec folder)\\b/;\n84: const FILE_SAVE_OPERATION = /\\bsave\\b.{0,48}\\b(file|files|document|documents|buffer|tab|workspace)\\b|\\b(file|files|document|documents|buffer|tab|workspace)\\b.{0,48}\\bsave\\b/;\n85: const MEMORY_SAVE_CONTEXT_ANCHOR = /\\b(memory|context|conversation|session|handover|checkpoint|resume|preserve|remember|capture|store)\\b|\\/memory:save|memory:save/;\n86: // Class C breadth/multi-concern abstention gates. A broad greenfield build or a\n87: // multi-concern optimization is under-specified for single-skill routing.\n88: const BREADTH_BUILD_VERB = /\\b(build|create|implement|generate|scaffold)\\b/;\n89: const BREADTH_NOUN = /\\b(full[- ]?stack|service|platform|application|microservice|saas|backend|whole (app|system))\\b/;\n90: // Narrow anchors that make a broad-build prompt specific enough to route.\n91: const BREADTH_NARROW_ANCHOR = /\\.[a-z]{2,4}\\b|\\b(test|tests|error|bug|failure|failing|handler|component|function|route|endpoint|class|method|benchmark|review|audit|migration|schema)\\b/;\n92: const MULTI_CONCERN_VERB = /\\b(optimize|improve|enhance|harden|speed up)\\b/;\n93: const CONCERN_PERF = /\\b(speed|latency|execution|throughput|performance|startup|memory|cpu)\\b/;\n94: const CONCERN_QUALITY = /\\b(quality|accuracy|recommendation|recommendations|correctness|reliability|coverage)\\b/;\n95: const TRUE_FLAG_VALUES = new Set(['1', 'true', 'yes', 'on', 'enabled']);\n96: const NO_RRF_RANK = Number.MAX_SAFE_INTEGER;\n97: const ADVISOR_SELF_RECOMMENDATION_SKILL_IDS = new Set(['system-skill-advisor', 'skill-advisor']);\n98: const DOCTOR_BRIDGE_PREFIX = 'command-doctor-';\n99: const DOCTOR_COMMAND_PREFIX = '/doctor:';\n100: \n101: // ───────────────────────────────────────────────────────────────────\n102: // 3. TYPE DEFINITIONS\n103: // ───────────────────────────────────────────────────────────────────\n104: \n105: type MutableLaneScores = {\n106:   -readonly [K in keyof LaneScores]: LaneMatch[];\n107: };\n108: \n109: interface LaneScoreBundle {\n110:   readonly laneScores: LaneScores;\n111:   readonly graphConflictMatches: readonly LaneMatch[];\n112:   readonly graphSupportBySeed: ReadonlyMap<string, ReadonlyMap<string, number>>;\n113: }\n114: \n115: interface AdvisorRrfFusion {\n116:   readonly scoreBySkill: ReadonlyMap<string, number>;\n117:   readonly rankBySkill: ReadonlyMap<string, number>;\n118: }\n119: \n120: type AdvisorRuntimeLabel = (typeof ADVISOR_RUNTIME_VALUES)[number];\n121: type AdvisorFreshnessLabel = (typeof ADVISOR_HOOK_FRESHNESS_VALUES)[number];\n122: export type AdvisorQueryClass = 'implementation' | 'review' | 'documentation' | 'memory' | 'tooling' | 'unknown';\n123: \n124: interface ExactSemanticRerankEntry {\n125:   readonly rawScore: number;\n126: }\n127: \n128: type ExactSemanticRerankIndex = ReadonlyMap<string, ExactSemanticRerankEntry>;\n129: \n130: // ───────────────────────────────────────────────────────────────────\n131: // 4. HELPERS\n132: // ───────────────────────────────────────────────────────────────────\n133: \n134: function emptyLaneScores(): MutableLaneScores {\n135:   return Object.fromEntries(SCORER_LANES.map((lane) => [lane, []])) as unknown as MutableLaneScores;\n136: }\n137: \n138: function projectionWithUsableSkillIds(projection: AdvisorProjection): AdvisorProjection {\n139:   const skills = projection.skills.filter((skill) => {\n140:     const skillId: unknown = skill.id;\n141:     return typeof skillId === 'string' && skillId.trim().length > 0;\n142:   });\n143:   return skills.length === projection.skills.length\n144:     ? projection\n145:     : { ...projection, skills };\n146: }\n147: \n148: export function isAdvisorRrfFusionEnabled(): boolean {\n149:   const value = process.env[ADVISOR_RRF_FUSION_FLAG]?.trim().toLowerCase();\n150:   return value ? TRUE_FLAG_VALUES.has(value) : false;\n151: }\n152: \n153: export function isAdvisorQueryClassRoutingEnabled(): boolean {\n154:   const value = process.env[ADVISOR_QUERY_CLASS_ROUTING_FLAG]?.trim().toLowerCase();\n155:   return value ? TRUE_FLAG_VALUES.has(value) : false;\n156: }\n157: \n158: export function isAdvisorExactSemanticRerankEnabled(): boolean {\n159:   const value = process.env[ADVISOR_EXACT_SEMANTIC_RERANK_FLAG]?.trim().toLowerCase();\n160:   return value ? TRUE_FLAG_VALUES.has(value) : false;\n161: }\n162: \n163: export function classifyAdvisorQuery(prompt: string): AdvisorQueryClass {\n164:   const promptLower = prompt.toLowerCase();\n165:   if (/\\b(save context|save memory|handover|resume|checkpoint|spec folder|implementation summary|packet docs?)\\b/.test(promptLower)) {\n166:     return 'memory';\n167:   }\n168:   if (/\\b(review|audit|findings|regression|pull request|pr readiness|release readiness)\\b/.test(promptLower)) {\n169:     return 'review';\n170:   }\n171:   if (/\\b(readme|markdown|documentation|docs|manual testing playbook|feature catalog|taxonomy)\\b/.test(promptLower)) {\n172:     return 'documentation';\n173:   }\n174:   if (/\\b(call_tool_chain|code mode|tool ?chain|chrome devtools|browser console|figma|github|clickup)\\b/.test(promptLower)) {\n175:     return 'tooling';\n176:   }\n177:   if (TASK_INTENT.test(promptLower) || /\\b(typescript|javascript|python|vitest|mcp|handler|schema|fixture)\\b/.test(promptLower)) {\n178:     return 'implementation';\n179:   }\n180:   return 'unknown';\n181: }\n182: \n183: export function queryClassLaneMultipliers(queryClass: AdvisorQueryClass): Readonly<Partial<Record<ScorerLane, number>>> {\n184:   switch (queryClass) {\n185:     case 'implementation':\n186:       return { explicit_author: 1.04, lexical: 1.00, graph_causal: 0.98, derived_generated: 0.98, semantic_shadow: 1.00 };\n187:     case 'review':\n188:       return { explicit_author: 1.03, lexical: 1.02, graph_causal: 0.96, derived_generated: 0.98, semantic_shadow: 1.00 };\n189:     case 'documentation':\n190:       return { explicit_author: 1.03, lexical: 0.98, graph_causal: 0.95, derived_generated: 1.04, semantic_shadow: 1.00 };\n191:     case 'memory':\n192:       return { explicit_author: 1.04, lexical: 0.98, graph_causal: 1.02, derived_generated: 1.00, semantic_shadow: 0.96 };\n193:     case 'tooling':\n194:       return { explicit_author: 1.04, lexical: 1.00, graph_causal: 0.98, derived_generated: 0.96, semantic_shadow: 1.00 };\n195:     case 'unknown':\n196:       return {};\n197:   }\n198: }\n199: \n200: export function applyQueryClassLaneMultipliers(\n201:   weights: Readonly<Record<ScorerLane, number>>,\n202:   queryClass: AdvisorQueryClass,\n203: ): Readonly<Record<ScorerLane, number>> {\n204:   const multipliers = queryClassLaneMultipliers(queryClass);\n205:   if (Object.keys(multipliers).length === 0) return weights;\n206:   const next = { ...weights };\n207:   for (const lane of SCORER_LANES) {\n208:     const multiplier = multipliers[lane];\n209:     if (typeof multiplier === 'number' && Number.isFinite(multiplier)) {\n210:       next[lane] = Number((next[lane] * multiplier).toFixed(6));\n211:     }\n212:   }\n213:   const strongestOther = Math.max(...SCORER_LANES\n214:     .filter((lane) => lane !== 'explicit_author')\n215:     .map((lane) => next[lane]));\n216:   if (next.explicit_author < strongestOther) {\n217:     next.explicit_author = Number(strongestOther.toFixed(6));\n218:   }\n219:   return next;\n220: }\n221: \n222: function effectiveScorerWeights(\n223:   override: AdvisorScoringOptions['laneWeightsOverride'] | undefined,\n224:   queryClass: AdvisorQueryClass = 'unknown',\n225: ): Readonly<Record<ScorerLane, number>> {\n226:   const base = !override ? DEFAULT_SCORER_WEIGHTS : (() => {\n227:     const weights: Record<ScorerLane, number> = { ...DEFAULT_SCORER_WEIGHTS };\n228:     const runtimeOverride = override as Partial<Record<string, number>>;\n229:     for (const lane of SCORER_LANES) {\n230:       const value = runtimeOverride[lane];\n231:       if (typeof value === 'number' && Number.isFinite(value)) {\n232:         weights[lane] = value;\n233:       }\n234:     }\n235:     return weights;\n236:   })();\n237:   if (queryClass === 'unknown') return base;\n238:   return applyQueryClassLaneMultipliers(base, queryClass);\n239: }\n240: \n241: function normalizeRuntimeLabel(value: string | undefined): AdvisorRuntimeLabel | null {\n242:   if (value === undefined) {\n243:     return null;\n244:   }\n245:   return ADVISOR_RUNTIME_VALUES.includes(value as AdvisorRuntimeLabel) ? value as AdvisorRuntimeLabel : null;\n246: }\n247: \n248: function normalizeFreshnessLabel(value: string | undefined): AdvisorFreshnessLabel | null {\n249:   if (value === undefined) {\n250:     return 'unavailable';\n251:   }\n252:   return ADVISOR_HOOK_FRESHNESS_VALUES.includes(value as AdvisorFreshnessLabel) ? value as AdvisorFreshnessLabel : null;\n253: }\n254: \n255: interface LaneMatchIndexEntry {\n256:   rawScore: number;\n257:   evidence: string[];\n258:   producerSkillIds: string[];\n259: }\n260: \n261: type LaneMatchIndex = Map<string, LaneMatchIndexEntry>;\n262: \n263: function buildLaneRuntimeHealth(\n264:   laneScores: LaneScores,\n265:   disabled: ReadonlySet<ScorerLane>,\n266:   runtimeLaneHealth: AdvisorScoringOptions['runtimeLaneHealth'] | undefined,\n267: ): readonly LaneRuntimeHealth[] {\n268:   return SCORER_LANES.map((lane): LaneRuntimeHealth => {\n269:     const matchCount = laneScores[lane].length;\n270:     const signal = runtimeLaneHealth?.[lane];\n271:     if (!disabled.has(lane) && signal?.status === 'runtime_degraded' && matchCount === 0) {\n272:       return {\n273:         lane,\n274:         status: 'runtime_degraded',\n275:         matchCount,\n276:         ...(signal.reason ? { reason: signal.reason } : {}),\n277:       };\n278:     }\n279:     return {\n280:       lane,\n281:       status: matchCount > 0 ? 'healthy' : 'matched_nothing',\n282:       matchCount,\n283:       ...(signal?.reason && signal.status === 'healthy' ? { reason: signal.reason } : {}),\n284:     };\n285:   });\n286: }\n287: \n288: function projectionRuntimeLaneHealth(\n289:   projection: AdvisorProjection,\n290:   runtimeLaneHealth: AdvisorScoringOptions['runtimeLaneHealth'] | undefined,\n291: ): AdvisorScoringOptions['runtimeLaneHealth'] | undefined {\n292:   if (!projection.embeddingStaleness?.stale) {\n293:     return runtimeLaneHealth;\n294:   }\n295:   return {\n296:     ...runtimeLaneHealth,\n297:     semantic_shadow: runtimeLaneHealth?.semantic_shadow ?? {\n298:       status: 'runtime_degraded',\n299:       reason: projection.embeddingStaleness.reason ?? 'projection_embedding_stale',\n300:     },\n301:   };\n302: }\n303: \n304: function degradedLaneReason(degradedLanes: readonly ScorerLane[]): string | null {\n305:   if (degradedLanes.length === 0) return null;\n306:   return `Runtime-degraded scorer lanes omitted from confidence normalization: ${degradedLanes.join(', ')}.`;\n307: }\n308: \n309: function buildLaneMatchIndex(matches: readonly LaneMatch[]): LaneMatchIndex {\n310:   const index: LaneMatchIndex = new Map();\n311:   for (const match of matches) {\n312:     const existing = index.get(match.skillId) ?? { rawScore: 0, evidence: [], producerSkillIds: [] };\n313:     existing.rawScore = Math.max(existing.rawScore, match.score);\n314:     if (existing.evidence.length < 6) {\n315:       existing.evidence.push(...match.evidence.slice(0, 6 - existing.evidence.length));\n316:     }\n317:     for (const producerSkillId of match.producerSkillIds ?? []) {\n318:       if (!existing.producerSkillIds.includes(producerSkillId)) {\n319:         existing.producerSkillIds.push(producerSkillId);\n320:       }\n321:     }\n322:     index.set(match.skillId, existing);\n323:   }\n324:   return index;\n325: }\n326: \n327: function buildConflictMatchIndex(matches: readonly LaneMatch[]): LaneMatchIndex {\n328:   const index: LaneMatchIndex = new Map();\n329:   for (const match of matches) {\n330:     const existing = index.get(match.skillId) ?? { rawScore: 0, evidence: [], producerSkillIds: [] };\n331:     existing.rawScore = Math.min(existing.rawScore, match.score);\n332:     if (existing.evidence.length < 6) {\n333:       existing.evidence.push(...match.evidence.slice(0, 6 - existing.evidence.length));\n334:     }\n335:     index.set(match.skillId, existing);\n336:   }\n337:   return index;\n338: }\n339: \n340: function rankedRrfItems(matches: readonly LaneMatch[]): RrfItem[] {\n341:   return [...matches]\n342:     .filter((match) => match.score > 0)\n343:     .sort((left, right) => right.score - left.score || left.skillId.localeCompare(right.skillId))\n344:     .map((match) => ({ id: match.skillId }));\n345: }\n346: \n347: export function fuseAdvisorLaneRanks(\n348:   laneScores: LaneScores,\n349:   weights: Readonly<Record<ScorerLane, number>>,\n350:   disabled: ReadonlySet<ScorerLane> = new Set(),\n351:   runtimeDegraded: ReadonlySet<ScorerLane> = new Set(),\n352: ): AdvisorRrfFusion {\n353:   const lists: RankedList[] = SCORER_LANES.map((lane) => ({\n354:     source: lane,\n355:     results: rankedRrfItems(laneScores[lane]),\n356:     weight: disabled.has(lane) || runtimeDegraded.has(lane) || !isLiveScorerLane(lane)\n357:       ? 0\n358:       : weights[lane],\n359:   }));\n360:   const fused = fuseResultsMulti(lists, {\n361:     k: ADVISOR_RRF_K,\n362:     convergenceBonus: 0,\n363:     calibratedOverlapBeta: 0,\n364:     bonusOverChannels: 'configured',\n365:   });\n366:   const scoreBySkill = new Map<string, number>();\n367:   const rankBySkill = new Map<string, number>();\n368:   fused.forEach((result, index) => {\n369:     const skillId = String(result.id);\n370:     scoreBySkill.set(skillId, result.rrfScore);\n371:     rankBySkill.set(skillId, index);\n372:   });\n373:   return { scoreBySkill, rankBySkill };\n374: }\n375: \n376: function graphConflictAdjustment(\n377:   conflictIndex: LaneMatchIndex,\n378:   recommendation: AdvisorScoredRecommendation,\n379: ): number {\n380:   return conflictIndex.get(recommendation.skill)?.rawScore ?? 0;\n381: }\n382: \n383: function buildExactSemanticRerankIndex(\n384:   prompt: string,\n385:   projection: AdvisorProjection,\n386:   recommendations: readonly AdvisorScoredRecommendation[],\n387:   fusion: AdvisorRrfFusion | null,\n388: ): ExactSemanticRerankIndex {\n389:   if (!fusion) return new Map();\n390:   const topSkillIds = [...recommendations]\n391:     .filter((recommendation) => fusion.rankBySkill.has(recommendation.skill))\n392:     .sort((left, right) => rrfRankFor(fusion, left) - rrfRankFor(fusion, right))\n393:     .slice(0, ADVISOR_EXACT_SEMANTIC_RERANK_TOP_K)\n394:     .map((recommendation) => recommendation.skill);\n395:   const matches = scoreSemanticShadowExactSubset(prompt, projection, topSkillIds);\n396:   return new Map(matches.map((match) => [match.skillId, {\n397:     rawScore: match.score,\n398:   }]));\n399: }\n400: \n401: function exactSemanticRerankScore(\n402:   rerankIndex: ExactSemanticRerankIndex,\n403:   recommendation: AdvisorScoredRecommendation,\n404: ): number | null {\n405:   return rerankIndex.get(recommendation.skill)?.rawScore ?? null;\n406: }\n407: \n408: function rrfRankFor(\n409:   fusion: AdvisorRrfFusion | null,\n410:   recommendation: AdvisorScoredRecommendation,\n411: ): number {\n412:   return fusion?.rankBySkill.get(recommendation.skill) ?? NO_RRF_RANK;\n413: }\n414: \n415: function promptMentionsSkill(promptLower: string, skill: SkillProjection): boolean {\n416:   const phrases = [skill.id, skill.name, skill.id.replace(/-/g, ' ')];\n417:   // A cli skill wraps one named external tool, so the tool's own name (\"orca\"\n418:   // for cli-orca) names the skill as surely as its id does.\n419:   if (skill.family === 'cli' && skill.id.startsWith('cli-')) {\n420:     phrases.push(skill.id.slice('cli-'.length).replace(/-/g, ' '));\n421:   }\n422:   return phrases.some((phrase) => matchesPhraseBoundary(promptLower, phrase.toLowerCase()));\n423: }\n424: \n425: function isDefaultRoutable(promptLower: string, skill: SkillProjection): boolean {\n426:   if (isRouteExcludedSkillId(skill.id)) return false;\n427:   if (skill.lifecycleStatus === 'archived' || skill.lifecycleStatus === 'future') return false;\n428:   if (skill.lifecycleStatus === 'deprecated') return promptMentionsSkill(promptLower, skill);\n429:   return true;\n430: }\n431: \n432: function isAdvisorSelfRecommendationSkill(skillId: string): boolean {\n433:   return ADVISOR_SELF_RECOMMENDATION_SKILL_IDS.has(skillId);\n434: }\n435: \n436: function confidenceFor(args: {\n437:   liveNormalized: number;\n438:   directScore: number;\n439:   readOnlyExplainer: boolean;\n440:   hasExplicitWorkflowSignal: boolean;\n441:   hasTaskIntent: boolean;\n442:   readOnlyRouteAllowed: boolean;\n443:   derivedDominant: boolean;\n444:   skillId: string;\n445: }): { value: number; floored: boolean } {\n446:   const C = SCORING_CALIBRATION.confidence;\n447:   // The advisor alias must never rank itself first on a read-only explainer;\n448:   // floor its confidence. The canonical id is demoted separately by the audit\n449:   // penalty in primaryIntentBonus, so this branch intentionally matches only\n450:   // the alias id.\n451:   if (args.readOnlyExplainer && args.skillId === 'skill-advisor') {\n452:     return { value: C.readOnlyExplainerFloor, floored: false };\n453:   }\n454:   const base = C.baseConstant\n455:     + Math.min(1, args.liveNormalized * C.liveNormalizedRampGain) * C.liveNormalizedRampCoefficient;\n456:   if (args.readOnlyExplainer && !args.readOnlyRouteAllowed) {\n457:     return { value: C.readOnlyExplainerFloor, floored: false };\n458:   }\n459:   if (args.readOnlyRouteAllowed) {\n460:     return {\n461:       value: Number(Math.max(base, C.readOnlyRouteAllowedFloor).toFixed(4)),\n462:       floored: C.readOnlyRouteAllowedFloor > base,\n463:     };\n464:   }\n465:   if (args.derivedDominant && args.directScore < C.derivedDominantDirectScoreCeiling) {\n466:     return { value: C.derivedDominantConfidence, floored: false };\n467:   }\n468:   if (args.hasTaskIntent\n469:     && (args.directScore >= C.taskIntentDirectScoreFloor\n470:       || args.liveNormalized >= C.taskIntentLiveNormalizedFloor)) {\n471:     // Token-stuffing dispersion guard. Without this, a prompt\n472:     // with task-intent + many weak signals (saturating liveNormalized) but\n473:     // no strong direct anchor would force confidence to taskIntentFloor for\n474:     // many unrelated skills. The guard fires when liveNormalized is near-\n475:     // saturated AND directScore is below the directScoreLiftThreshold —\n476:     // the precise signature of a token-stuffed prompt. Legitimate task-intent\n477:     // prompts have at least one strong direct hit and pass via directScore;\n478:     // they don't hit this branch. When the guard fires we fall through to\n479:     // the standard `base + directBonus` math below.\n480:     const dispersionGuardTripped = args.liveNormalized >= 0.95\n481:       && args.directScore < C.directScoreLiftThreshold;\n482:     if (!dispersionGuardTripped) {\n483:       return {\n484:         value: Number(Math.max(base, C.taskIntentFloor).toFixed(4)),\n485:         floored: C.taskIntentFloor > base,\n486:       };\n487:     }\n488:   }\n489:   if (args.directScore >= C.directScoreLiftThreshold) {\n490:     return {\n491:       value: Number(Math.max(base, C.directScoreFloor).toFixed(4)),\n492:       floored: C.directScoreFloor > base,\n493:     };\n494:   }\n495:   const directBonus = args.directScore >= C.directScoreBonusThreshold ? C.directScoreBonus : 0;\n496:   return { value: Number(Math.max(0, Math.min(C.hardCeiling, base + directBonus)).toFixed(4)), floored: false };\n497: }\n498: \n499: function uncertaintyFor(contributions: readonly LaneContribution[], confidence: number, ambiguousPressure: number): number {\n500:   const U = SCORING_CALIBRATION.uncertainty;\n501:   const evidenceCount = contributions.reduce((total, contribution) => total + contribution.evidence.length, 0);\n502:   const direct = contributions\n503:     .filter((contribution) => contribution.lane === 'explicit_author' || contribution.lane === 'lexical')\n504:     .reduce((max, contribution) => Math.max(max, contribution.rawScore), 0);\n505:   let uncertainty = U.noEvidenceDefault;\n506:   if (evidenceCount >= U.highEvidenceCount) uncertainty = U.lowFloor;\n507:   else if (evidenceCount >= U.mediumEvidenceCount) uncertainty = U.mediumFloor;\n508:   else if (evidenceCount >= U.someEvidenceCount) uncertainty = U.elevatedFloor;\n509:   if (direct >= U.directEvidenceDiscountThreshold) uncertainty -= U.directEvidenceDiscount;\n510:   if (confidence < U.lowConfidencePenaltyThreshold) uncertainty += U.lowConfidencePenalty;\n511:   uncertainty += ambiguousPressure;\n512:   return Number(Math.max(U.hardFloor, Math.min(U.hardCeiling, uncertainty)).toFixed(2));\n513: }\n514: \n515: function buildLaneScores(\n516:   prompt: string,\n517:   projection: AdvisorProjection,\n518:   disabled: Set<ScorerLane>,\n519:   affordances: readonly NormalizedAffordance[],\n520:   useRrfFusion: boolean,\n521: ): LaneScoreBundle {\n522:   const scores = emptyLaneScores();\n523:   if (!disabled.has('explicit_author')) {\n524:     scores.explicit_author = scoreExplicitLane(prompt, projection);\n525:   }\n526:   if (!disabled.has('lexical')) scores.lexical = scoreLexicalLane(prompt, projection);\n527:   if (!disabled.has('derived_generated')) scores.derived_generated = scoreDerivedLane(prompt, projection, new Date(), affordances);\n528:   if (!disabled.has('semantic_shadow')) scores.semantic_shadow = scoreSemanticShadowLane(prompt, projection);\n529:   let graphConflictMatches: readonly LaneMatch[] = [];\n530:   let graphSupportBySeed: ReadonlyMap<string, ReadonlyMap<string, number>> = new Map();\n531:   if (!disabled.has('graph_causal')) {\n532:     const graphSplit = scoreGraphCausalLaneSplit([\n533:       ...scores.explicit_author,\n534:       ...scores.lexical,\n535:       ...scores.derived_generated,\n536:     ], projection, {}, affordances);\n537:     scores.graph_causal = useRrfFusion ? graphSplit.positiveMatches : graphSplit.combinedMatches;\n538:     graphConflictMatches = graphSplit.conflictMatches;\n539:     graphSupportBySeed = graphSplit.positiveSupportBySeed;\n540:   }\n541:   return { laneScores: scores, graphConflictMatches, graphSupportBySeed };\n542: }\n543: \n544: // Smallest gap the rounded weighted score can still express, so a bounded\n545: // target sorts strictly below its seed instead of tying with it.\n546: const SEED_BOUND_GAP = 0.000001;\n547: \n548: // Below this explicit-lane score a match is a side mention, not a request.\n549: const EXPLICIT_WORKFLOW_SIGNAL_FLOOR = 0.55;\n550: \n551: // Explicit-lane evidence that a typed slash command named this skill.\n552: const SLASH_COMMAND_EVIDENCE = /^(phrase|author|explicit):\\//;\n553: \n554: export function hasSlashCommandAnchor(rawScore: number, evidence: readonly string[]): boolean {\n555:   return rawScore >= EXPLICIT_WORKFLOW_SIGNAL_FLOOR\n556:     && evidence.some((entry) => SLASH_COMMAND_EVIDENCE.test(entry));\n557: }\n558: \n559: // Graph support is lent: a seed's own evidence propagates to its neighbours so\n560: // related skills surface beside it. When the seed was invoked by a typed slash\n561: // command, the user has named it outright, so support it lends may lift a\n562: // target up to it but never past it; otherwise the command's own match is what\n563: // buries the command (a typed \"/deep:research\" handing its dependency enough\n564: // support to win). Seeds matched only on loose tokens keep ordinary graph\n565: // lending, since there the neighbour may well be the better route. Two skills\n566: // often lend to each other, so the pair is compared on what each holds once\n567: // the other's loan is taken back: a target whose own evidence still beats the\n568: // seed's own evidence keeps its score.\n569: export function boundGraphSupportBySeed(\n570:   scores: ReadonlyMap<string, number>,\n571:   graphRawBySkill: ReadonlyMap<string, number>,\n572:   graphSupportBySeed: ReadonlyMap<string, ReadonlyMap<string, number>>,\n573:   graphWeight: number,\n574:   slashAnchoredSeeds: ReadonlySet<string>,\n575: ): Map<string, number> {\n576:   return boundGraphSupportBySeedWithHolders(\n577:     scores,\n578:     graphRawBySkill,\n579:     graphSupportBySeed,\n580:     graphWeight,\n581:     slashAnchoredSeeds,\n582:   ).scores;\n583: }\n584: \n585: export interface SeedBoundResult {\n586:   readonly scores: Map<string, number>;\n587:   // Target skill -> the typed-command seed whose ceiling actually lowered it.\n588:   readonly heldBelow: Map<string, string>;\n589: }\n590: \n591: export function boundGraphSupportBySeedWithHolders(\n592:   scores: ReadonlyMap<string, number>,\n593:   graphRawBySkill: ReadonlyMap<string, number>,\n594:   graphSupportBySeed: ReadonlyMap<string, ReadonlyMap<string, number>>,\n595:   graphWeight: number,\n596:   slashAnchoredSeeds: ReadonlySet<string>,\n597: ): SeedBoundResult {\n598:   const bounded = new Map(scores);\n599:   const heldBelow = new Map<string, string>();\n600:   if (graphWeight <= 0) return { scores: bounded, heldBelow };\n601:   const lentBy = (lenderId: string, receiverId: string): number => {\n602:     const support = graphSupportBySeed.get(receiverId)?.get(lenderId) ?? 0;\n603:     const graphRaw = Math.max(0, graphRawBySkill.get(receiverId) ?? 0);\n604:     return Math.min(support, graphRaw) * graphWeight;\n605:   };\n606:   // Which seed holds which target down is decided once, on the unbounded\n607:   // scores, so the evidence comparison never sees a cap.\n608:   const holdersByTarget = new Map<string, string[]>();\n609:   for (const [targetId, supportBySeed] of graphSupportBySeed) {\n610:     const targetScore = scores.get(targetId);\n611:     if (targetScore === undefined) continue;\n612:     const holders: string[] = [];\n613:     for (const seedId of supportBySeed.keys()) {\n614:       if (seedId === targetId || !slashAnchoredSeeds.has(seedId)) continue;\n615:       const seedScore = scores.get(seedId);\n616:       if (seedScore === undefined) continue;\n617:       const targetOwn = targetScore - lentBy(seedId, targetId);\n618:       const seedOwn = seedScore - lentBy(targetId, seedId);\n619:       if (targetOwn < seedOwn) holders.push(seedId);\n620:     }\n621:     if (holders.length > 0) holdersByTarget.set(targetId, holders);\n622:   }\n623:   // A held seed can itself be held by another typed command, so each ceiling\n624:   // follows the seed's bounded score and the caps repeat until nothing moves.\n625:   // Caps only ever lower a score, and each pass settles at least one more link\n626:   // of a chain, so one pass per held target is enough.\n627:   for (let pass = 0; pass <= holdersByTarget.size; pass += 1) {\n628:     let moved = false;\n629:     for (const [targetId, holders] of holdersByTarget) {\n630:       const current = bounded.get(targetId) ?? 0;\n631:       let ceiling = current;\n632:       for (const seedId of holders) ceiling = Math.min(ceiling, (bounded.get(seedId) ?? 0) - SEED_BOUND_GAP);\n633:       if (ceiling < current) {\n634:         bounded.set(targetId, Math.max(0, ceiling));\n635:         moved = true;\n636:       }\n637:     }\n638:     if (!moved) break;\n639:   }\n640:   // Only a target the cap really lowered is marked, and only against the seed\n641:   // whose ceiling set its final score: a seed that merely could have held it\n642:   // ranked nothing, so the pair keeps its ordinary ambiguity check.\n643:   for (const [targetId, holders] of holdersByTarget) {\n644:     const final = bounded.get(targetId) ?? 0;\n645:     if (final >= (scores.get(targetId) ?? 0)) continue;\n646:     let binding: string | null = null;\n647:     let lowestSeed = Number.POSITIVE_INFINITY;\n648:     for (const seedId of holders) {\n649:       const seedScore = bounded.get(seedId) ?? 0;\n650:       if (seedScore < lowestSeed) {\n651:         lowestSeed = seedScore;\n652:         binding = seedId;\n653:       }\n654:     }\n655:     if (binding) heldBelow.set(targetId, binding);\n656:   }\n657:   return { scores: bounded, heldBelow };\n658: }\n659: \n660: function hasExplicitWorkflowSignal(contributions: readonly LaneContribution[], skillId: string): boolean {\n661:   const explicit = contributions.find((contribution) => contribution.lane === 'explicit_author');\n662:   if (!explicit || explicit.rawScore < EXPLICIT_WORKFLOW_SIGNAL_FLOOR) return false;\n663:   return explicit.evidence.some((entry) => (\n664:     entry.startsWith('phrase:')\n665:     || entry.startsWith('explicit:')\n666:     || entry.startsWith('author:')\n667:     || entry.includes(skillId)\n668:     || entry.includes('loop')\n669:     || entry.includes('write-')\n670:   ));\n671: }\n672: \n673: // Wording that asks for an answer and rules out a change. One pattern serves\n674: // every gate that has to honour it, so a new gate cannot drift from the first.\n675: const NO_EDIT_REQUEST = /\\b(no edits?|without making changes|do not (change|edit|modify|touch)|read-only only|no edits yet|only; do not|just show|just list)\\b/;\n676: \n677: export function readOnlyRouteAllowed(promptLower: string, skill: SkillProjection): boolean {\n678:   const skillId = skill.id;\n679:   if (NO_EDIT_REQUEST.test(promptLower)) {\n680:     return false;\n681:   }\n682:   // The explainer floor exists to stop an ambiguous read-only question from\n683:   // routing anywhere. Naming the skill removes the ambiguity: the caller has\n684:   // already chosen, and a read-only verb does not undo that choice. Without\n685:   // this, an explicit request is answered with an abstention while the same\n686:   // sentence phrased with a write verb routes fine.\n687:   if (promptMentionsSkill(promptLower, skill)) {\n688:     return true;\n689:   }\n690:   // A command whose route only reads (a report, a status check) is the answer\n691:   // to a list or show question, so its own trigger phrase lifts it off the\n692:   // floor. A mutating command never carries the flag and stays gated.\n693:   if (skill.kind === 'command' && 'readOnly' in skill && skill.readOnly === true\n694:     && skill.keywords.some((phrase) => matchesPhraseBoundary(promptLower, phrase.toLowerCase()))) {\n695:     return true;\n696:   }\n697:   if (skillId === 'sk-code' && /\\b(compare|audit|review)\\b/.test(promptLower)\n698:     && /\\b(classifier|vocabulary|prose|implementation|agents\\.md|drift|mismatch)\\b/.test(promptLower)) {\n699:     return true;\n700:   }\n701:   if (skillId === 'system-spec-kit' && /\\b(memory_save|resume_write|routing taxonomy|corpus|source-type|routing bucket)\\b/.test(promptLower)) {\n702:     return true;\n703:   }\n704:   if (skillId === 'system-spec-kit' && /\\b(packet|spec folder|save memory|phase|continuation prompts|resume handling)\\b/.test(promptLower)) {\n705:     return true;\n706:   }\n707:   // Captured operator answers wait in a queue that spec-kit's save step owns, so a show or list\n708:   // question about that queue, its chat candidates or the decision record is answered there.\n709:   // Only a read-only question is lifted: a lift applies to any prompt, and a request to research,\n710:   // dispatch or build something about decisions belongs to another skill.\n711:   if (skillId === 'system-spec-kit' && isReadOnlyExplainer(promptLower)\n712:     && /\\b(decision capture|decision record|chat candidates?|operator decisions?|recorded as decisions?)\\b/.test(promptLower)) {\n713:     return true;\n714:   }\n715:   // The trigger index is spec-kit's own lookup surface, so a question about what a lookup\n716:   // returned, counted or left out is answered there. Without the lift no skill passes on such a\n717:   // question, and the doctor hand-off claims it on the index noun alone. Drift is the doctor's\n718:   // own diagnosis, so a drift question stays with the hand-off.\n719:   if (skillId === 'system-spec-kit' && isReadOnlyExplainer(promptLower)\n720:     && /\\btrigger[- ]index\\b/.test(promptLower) && !/\\bdrift\\b/.test(promptLower)) {\n721:     return true;\n722:   }\n723:   if (skillId === 'system-deep-loop' && /\\b(ai council|planning council|council deliberation|council artifacts|multi-seat planning)\\b/.test(promptLower)) {\n724:     return true;\n725:   }\n726:   // Browser/devtools inspection is a genuine chrome-devtools task even though\n727:   // its verb (\"inspect\") reads as a read-only explainer. Lift it off the\n728:   // explainer floor when the prompt carries devtools-specific vocabulary.\n729:   if (skillId === 'mcp-tooling'\n730:     && /\\b(network waterfall|network tab|network request|dev ?tools|browser console|page inspector|dom inspector|performance trace|inspect (the )?(network|dom|page|element|browser))\\b/.test(promptLower)) {\n731:     return true;\n732:   }\n733:   if (skillId === 'sk-code' && /\\bgate-3-classifier\\.ts\\b/.test(promptLower)) {\n734:     return true;\n735:   }\n736:   return false;\n737: }\n738: \n739: function isPlainFileSavePrompt(promptLower: string): boolean {\n740:   return FILE_SAVE_OPERATION.test(promptLower) && !MEMORY_SAVE_CONTEXT_ANCHOR.test(promptLower.replace(/\\bfile(s)?\\b/g, ''));\n741: }\n742: \n743: function primaryIntentBonus(\n744:   promptLower: string,\n745:   recommendation: AdvisorScoredRecommendation,\n746: ): number {\n747:   const R = SCORING_CALIBRATION.routing;\n748:   if (/\\bsemantic (code )?search\\b/.test(promptLower)) {\n749:   }\n750:   if (/\\bdeep[- ]review\\b/.test(promptLower)) {\n751:     if (recommendation.skill === 'sk-code') {\n752:       return AUTHORS_CODE.test(promptLower) ? R.deepReviewCodeAuthoringSkCodeBonus : R.deepReviewSkCodeReviewPenalty;\n753:     }\n754:   }\n755:   if (/\\bdeep[- ]research\\b/.test(promptLower)) {\n756:     if (recommendation.skill === 'system-spec-kit' || recommendation.skill === 'sk-code') return R.deepResearchOtherSkillsPenalty;\n757:   }\n758:   if (DEEP_RESEARCH_CYCLE.test(promptLower)) {\n759:     if (recommendation.skill === 'system-spec-kit' || recommendation.skill === 'sk-code') return R.deepResearchCycleOtherSkillsPenalty;\n760:   }\n761:   if (/\\b(compare|audit|review)\\b/.test(promptLower) && /\\b(classifier|vocabulary|prose|implementation|agents\\.md|drift|mismatch)\\b/.test(promptLower)) {\n762:     if (recommendation.skill === 'sk-code') return R.compareAuditCodeReviewBonus;\n763:   }\n764:   // A changelog request that names its packet or spec folder still asks for a\n765:   // changelog, so sk-doc must outrank the spec workflow that \"spec folder\" lifts.\n766:   // Only those two skills are adjusted here. Every other skill falls through so\n767:   // later rules such as save-context or /speckit:plan still apply to it.\n768:   const changelogFromPacket = CHANGELOG_AUTHORING.test(promptLower)\n769:     && CHANGELOG_PACKET_SOURCE.test(promptLower)\n770:     && !AUTHORS_CODE.test(promptLower);\n771:   if (changelogFromPacket) {\n772:     if (recommendation.skill === 'sk-doc') return R.changelogFromPacketSkDocBonus;\n773:     if (recommendation.skill === 'system-spec-kit') return R.changelogFromPacketSpecKitPenalty;\n774:   }\n775:   // The corpus-study rule reads \"packet-local\" as study vocabulary, so it must\n776:   // stay off a changelog request or it would pull the prompt to system-spec-kit.\n777:   // \"packet-local changelog\" names sk-doc's changelog mode with or without an\n778:   // authoring verb, so packet-local is study vocabulary only when it qualifies\n779:   // something other than a changelog.\n780:   if (!changelogFromPacket && /\\b(corpus ids?|first-100 predictions|continuation prompts|routing study config|confusion matrix|source-mix note|prompt template|packet-local(?!\\s+changelog))\\b/.test(promptLower) && !AUTHORS_CODE.test(promptLower)) {\n781:     if (recommendation.skill === 'system-spec-kit') return R.corpusStudySpecKitBonus;\n782:     if (recommendation.skill === 'sk-prompt' || recommendation.skill === 'mcp-tooling' || recommendation.skill === 'sk-doc') return R.corpusStudyOtherSkillsPenalty;\n783:   }\n784:   if (promptLower.includes('/speckit:resume')) {\n785:     if (recommendation.skill === 'system-spec-kit') return R.speckitResumeSpecKitBonus;\n786:     if (recommendation.skill === 'command-spec-kit-resume') return R.speckitResumeCommandPenalty;\n787:   }\n788:   if (promptLower.includes('/speckit:plan')) {\n789:     if (recommendation.skill === 'command-spec-kit-plan') return R.speckitPlanCommandBonus;\n790:     if (recommendation.skill === 'sk-doc') return R.speckitPlanSkDocPenalty;\n791:   }\n792:   // External-tool-chain (\"call_tool_chain\") vocabulary belongs to mcp-code-mode,\n793:   // not the generic code skill. Disambiguate so the best guess for these\n794:   // toolchain-shaped prompts is mcp-code-mode.\n795:   // Toolchain + external-data-source vocabulary (webflow CMS, cms collection)\n796:   // is mcp-code-mode territory, not the generic code skill.\n797:   if (/\\b(call_tool_chain|code mode|tool ?chain|api chain|webflow cms|cms collection)\\b/.test(promptLower)) {\n798:     if (recommendation.skill === 'mcp-code-mode') return R.mcpToolchainCodeModeBonus;\n799:     if (recommendation.skill === 'sk-code') return R.mcpToolchainSkCodePenalty;\n800:   }\n801:   // A \"code audit\" is a single-pass code-review task, not a deep-review loop, so\n802:   // sk-code should win the near-tie this phrase produces. The sk-code bonus\n803:   // carries that; the deep-loop skills intentionally hold no \"code audit\"\n804:   // vocabulary, so they need no counter-penalty here.\n805:   if (/\\bcode audit\\b/.test(promptLower)) {\n806:     if (recommendation.skill === 'sk-code') return R.codeAuditCodeReviewBonus;\n807:   }\n808:   // Colon-command review-loop syntax (\":review:auto\") invokes the deep-review\n809:   // loop; rank it above single-pass code review.\n810:   if (/:review:(auto|confirm)\\b/.test(promptLower)) {\n811:     if (recommendation.skill === 'system-deep-loop') return R.reviewLoopDeepReviewBonus;\n812:     if (recommendation.skill === 'sk-code') return R.deepReviewSkCodeReviewPenalty;\n813:   }\n814:   // Auditing recommendation quality is a review task, not an advisor-self task.\n815:   if (/\\baudit\\b/.test(promptLower) && /\\b(recommendation|recommendations|recommendation quality|routing quality)\\b/.test(promptLower)) {\n816:     if (recommendation.skill === 'sk-code') return R.auditRecsCodeReviewBonus;\n817:     // Auditing routing output is a review task, not an advisor invocation: demote\n818:     // the advisor and its alias (the canonical self-rec id set) so neither ranks\n819:     // itself first here.\n820:     if (isAdvisorSelfRecommendationSkill(recommendation.skill)) return R.auditRecsAdvisorPenalty;\n821:   }\n822:   if (/\\b(save context|save memory)\\b/.test(promptLower)) {\n823:     if (recommendation.skill === 'command-speckit-save') return R.saveContextMemorySaveBonus;\n824:     if (recommendation.skill === 'system-spec-kit') return R.saveContextMemorySpecKitPenalty;\n825:   }\n826:   if (/\\b(create (a )?new agent|create agent)\\b/.test(promptLower) || promptLower.includes('/create:agent')) {\n827:     if (recommendation.skill === 'create:agent') return R.createAgentCreateAgentBonus;\n828:     if (recommendation.skill === 'sk-doc') return R.createAgentSkDocPenalty;\n829:   }\n830:   if (/\\bcreate (a )?(test|testing) playbook\\b/.test(promptLower) || promptLower.includes('/create:manual-testing-playbook')) {\n831:     if (recommendation.skill === 'create:manual-testing-playbook' || recommendation.skill === 'command-create-manual-testing-playbook') return R.createTestingPlaybookBonus;\n832:     if (recommendation.skill === 'sk-doc') return R.createTestingPlaybookSkDocPenalty;\n833:     if (recommendation.skill === 'system-deep-loop') return R.createTestingPlaybookOtherSkillsPenalty;\n834:   }\n835:   if (/\\bphase folder\\b/.test(promptLower)) {\n836:     if (recommendation.skill === 'system-spec-kit') return R.phaseFolderSpecKitBonus;\n837:   }\n838:   return 0;\n839: }\n840: \n841: // ───────────────────────────────────────────────────────────────────\n842: // 5. CORE LOGIC\n843: // ───────────────────────────────────────────────────────────────────\n844: \n845: // The bar sits above the highest cosine any prompt that must stay silent reached\n846: // against a command row, with headroom, because a command offered for the wrong\n847: // prompt costs more than one that stays quiet. The margin asks for a small lead\n848: // over the next command and over the top skill, which is what kept a wrong\n849: // command out of first place on the tuning rows. Raise the bar before the\n850: // margin if a false offer appears.\n851: export const COMMAND_MEANING_MIN_COSINE = 0.72;\n852: export const COMMAND_MEANING_MARGIN = 0.02;\n853: \n854: // The lane reports a real embedder cosine as \"cosine:\", while the word-overlap\n855: // stand-in used under test reports \"shadow:\". Only a real cosine may carry a\n856: // command on meaning, because the stand-in measures shared words rather than\n857: // shared meaning.\n858: function commandMeaningCosine(contribution: LaneContribution | undefined): number | null {\n859:   if (!contribution) return null;\n860:   return contribution.evidence.some((entry) => entry.startsWith('cosine:'))\n861:     ? contribution.rawScore\n862:     : null;\n863: }\n864: \n865: // A command bridge passes on its own wording: one of its authored phrases or its\n866: // runnable slash string, which the explicit-author lane reports. A bridge that\n867: // passed on shared single tokens alone stays scored but stops passing, because\n868: // its phrases are everyday words and a command must not be offered for a prompt\n869: // that merely shares some of them. A paraphrase shares no words at all, so the\n870: // second way in is meaning: a real prompt embedding that clears both bars above.\n871: // Meaning-passed ids are collected so a later ordering step can tell them apart,\n872: // and a doctor problem in other words reaches /doctor:helper through\n873: // applyDoctorHelperHandoff instead.\n874: // A question that only wants an answer must not be handed a command that\n875: // changes things, however close the meaning. Phrase matches are already held to\n876: // this by the read-only confidence floor, and a meaning match lifts confidence\n877: // past that floor, so it has to ask the same question itself. A command whose\n878: // route only reads stays eligible for a plain explainer, because running it is\n879: // the answer. An explicit no-edit request rules out every command.\n880: export function commandMeaningEligible(\n881:   promptLower: string,\n882:   readOnlyExplainer: boolean,\n883:   skill: SkillProjection | undefined,\n884: ): boolean {\n885:   if (NO_EDIT_REQUEST.test(promptLower)) return false;\n886:   if (!readOnlyExplainer) return true;\n887:   return skill !== undefined && skill.kind === 'command' && 'readOnly' in skill && skill.readOnly === true;\n888: }\n889: \n890: export function requireCommandPhraseAnchor(\n891:   ranked: readonly AdvisorScoredRecommendation[],\n892:   confidenceThreshold: number = DEFAULT_CONFIDENCE_THRESHOLD,\n893:   meaningPassed: Set<string> = new Set(),\n894:   meaningEligible: (skillId: string) => boolean = () => true,\n895: ): AdvisorScoredRecommendation[] {\n896:   const cosineByCommandId = new Map<string, number>();\n897:   for (const recommendation of ranked) {\n898:     if (recommendation.kind !== 'command') continue;\n899:     const cosine = commandMeaningCosine(\n900:       recommendation.laneContributions.find((contribution) => contribution.lane === 'semantic_shadow'),\n901:     );\n902:     if (cosine !== null) cosineByCommandId.set(recommendation.skill, cosine);\n903:   }\n904:   // A command row with no cosine counts as 0, so the bar is the strongest other\n905:   // command row, not the strongest row overall: a skill row never decides this.\n906:   const leadingOtherCosine = (skillId: string): number => {\n907:     let lead = 0;\n908:     for (const [otherSkillId, cosine] of cosineByCommandId) {\n909:       if (otherSkillId !== skillId && cosine > lead) lead = cosine;\n910:     }\n911:     return lead;\n912:   };\n913:   return ranked.map((recommendation) => {\n914:     if (recommendation.kind !== 'command') return recommendation;\n915:     const anchored = recommendation.laneContributions.some((contribution) => (\n916:       contribution.lane === 'explicit_author' && contribution.rawScore > 0\n917:     ));\n918:     if (anchored) return recommendation;\n919:     const cosine = cosineByCommandId.get(recommendation.skill);\n920:     if (cosine !== undefined\n921:       && cosine >= COMMAND_MEANING_MIN_COSINE\n922:       && cosine - leadingOtherCosine(recommendation.skill) >= COMMAND_MEANING_MARGIN\n923:       && meaningEligible(recommendation.skill)) {\n924:       // A meaning match alone rarely clears the threshold on its lane weight, so\n925:       // the anchor lifts the row to it rather than leaving it scored but unpassed.\n926:       meaningPassed.add(recommendation.skill);\n927:       return {\n928:         ...recommendation,\n929:         confidence: Math.max(recommendation.confidence, confidenceThreshold),\n930:         passes_threshold: true,\n931:       };\n932:     }\n933:     return recommendation.passes_threshold\n934:       ? { ...recommendation, passes_threshold: false }\n935:       : recommendation;\n936:   });\n937: }\n938: \n939: function findTypedDoctorCommandText(promptLower: string): string | null {\n940:   const prompt = promptLower.trim();\n941:   if (prompt.startsWith(DOCTOR_COMMAND_PREFIX)) {\n942:     return prompt.slice(DOCTOR_COMMAND_PREFIX.length);\n943:   }\n944: \n945:   const invocationPattern = /\\b(?:run|execute|start|launch|use|kick\\s+off)\\s+\\/doctor:/g;\n946:   let quote: \"'\" | '\"' | '`' | null = null;\n947:   let quoteScanPosition = 0;\n948:   let invocation: RegExpExecArray | null;\n949: \n950:   while ((invocation = invocationPattern.exec(prompt)) !== null) {\n951:     const commandPosition = (\n952:       invocation.index + invocation[0].length - DOCTOR_COMMAND_PREFIX.length\n953:     );\n954:     while (quoteScanPosition < commandPosition) {\n955:       const character = prompt.charAt(quoteScanPosition);\n956:       const isWordApostrophe = character === \"'\"\n957:         && /[a-z0-9]/.test(prompt.charAt(quoteScanPosition - 1))\n958:         && /[a-z0-9]/.test(prompt.charAt(quoteScanPosition + 1));\n959:       if (!isWordApostrophe) {\n960:         if (quote === null) {\n961:           if (character === \"'\" || character === '\"' || character === '`') {\n962:             quote = character;\n963:           }\n964:         } else if (character === quote) {\n965:           quote = null;\n966:         }\n967:       }\n968:       quoteScanPosition += 1;\n969:     }\n970:     if (quote === null) return prompt.slice(commandPosition + DOCTOR_COMMAND_PREFIX.length);\n971:   }\n972:   return null;\n973: }\n974: \n975: export function isDoctorCommandTyped(promptLower: string): boolean {\n976:   return findTypedDoctorCommandText(promptLower) !== null;\n977: }\n978: \n979: // A typed command or matching doctor lead phrase moves its passing bridge first; otherwise passing\n980: // bridges follow the second passing skill or the only passing skill, and other recommendations keep order.\n981: export function keepPassingSkillsAboveDoctorBridges(\n982:   ranked: readonly AdvisorScoredRecommendation[],\n983:   promptLower: string,\n984:   leadPhrasesById: ReadonlyMap<string, readonly string[]> = new Map(),\n985: ): AdvisorScoredRecommendation[] {\n986:   const isDoctorBridge = (recommendation: AdvisorScoredRecommendation): boolean => (\n987:     recommendation.kind === 'command' && recommendation.skill.startsWith(DOCTOR_BRIDGE_PREFIX)\n988:   );\n989:   const isPassingDoctorBridge = (recommendation: AdvisorScoredRecommendation): boolean => (\n990:     isDoctorBridge(recommendation) && recommendation.passes_threshold\n991:   );\n992:   const typedCommandText = findTypedDoctorCommandText(promptLower);\n993:   if (typedCommandText !== null) {\n994:     const normalizedCommand = typedCommandText.toLowerCase().trim().replace(/\\s+/g, '-');\n995:     let matchedBridgeIndex = -1;\n996:     let matchedBridgeLength = -1;\n997:     ranked.forEach((recommendation, index) => {\n998:       if (!isPassingDoctorBridge(recommendation)) return;\n999:       const bridgeName = recommendation.skill.slice(DOCTOR_BRIDGE_PREFIX.length);\n1000:       if (bridgeName.length === 0 || !normalizedCommand.startsWith(bridgeName)) return;\n1001:       const nextCharacter = normalizedCommand.charAt(bridgeName.length);\n1002:       const endsAtWordBoundary = (\n1003:         nextCharacter === '' || !/[a-z0-9_]/.test(nextCharacter)\n1004:       );\n1005:       if (!endsAtWordBoundary || bridgeName.length <= matchedBridgeLength) return;\n1006:       matchedBridgeIndex = index;\n1007:       matchedBridgeLength = bridgeName.length;\n1008:     });\n1009:     const matchedBridge = ranked[matchedBridgeIndex];\n1010:     if (!matchedBridge) return [...ranked];\n1011:     return [\n1012:       matchedBridge,\n1013:       ...ranked.slice(0, matchedBridgeIndex),\n1014:       ...ranked.slice(matchedBridgeIndex + 1),\n1015:     ];\n1016:   }\n1017: \n1018:   const leadPhraseBridgeIndex = ranked.findIndex((recommendation) => {\n1019:     if (!isPassingDoctorBridge(recommendation)) return false;\n1020:     return leadPhrasesById.get(recommendation.skill)?.some((phrase) => (\n1021:       matchesPhraseBoundary(promptLower, phrase.toLowerCase())\n1022:     )) ?? false;\n1023:   });\n1024:   const leadPhraseBridge = ranked[leadPhraseBridgeIndex];\n1025:   if (leadPhraseBridge) {\n1026:     return [\n1027:       leadPhraseBridge,\n1028:       ...ranked.slice(0, leadPhraseBridgeIndex),\n1029:       ...ranked.slice(leadPhraseBridgeIndex + 1),\n1030:     ];\n1031:   }\n1032: \n1033:   const passingSkillCount = ranked.filter((recommendation) => (\n1034:     recommendation.kind === 'skill' && recommendation.passes_threshold\n1035:   )).length;\n1036:   if (passingSkillCount === 0) return [...ranked];\n1037: \n1038:   const passingDoctorBridges = ranked.filter(isPassingDoctorBridge);\n1039:   if (passingDoctorBridges.length === 0) return [...ranked];\n1040:   const remaining = ranked.filter((recommendation) => !isPassingDoctorBridge(recommendation));\n1041:   const targetPassingSkillCount = Math.min(2, passingSkillCount);\n1042:   let seenPassingSkills = 0;\n1043:   let insertionIndex = remaining.length;\n1044:   for (const [index, recommendation] of remaining.entries()) {\n1045:     if (recommendation.kind !== 'skill' || !recommendation.passes_threshold) continue;\n1046:     seenPassingSkills += 1;\n1047:     if (seenPassingSkills === targetPassingSkillCount) {\n1048:       insertionIndex = index + 1;\n1049:       break;\n1050:     }\n1051:   }\n1052:   return [\n1053:     ...remaining.slice(0, insertionIndex),\n1054:     ...passingDoctorBridges,\n1055:     ...remaining.slice(insertionIndex),\n1056:   ];\n1057: }\n1058: \n[Output truncated. Continue reading with offset: 1059]","title":"read","metadata":{"metadata":{"truncated":true},"content":[{"type":"text","text":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/lib/scorer/fusion.ts, lines 1-1058\n1: // ───────────────────────────────────────────────────────────────\n2: // MODULE: Advisor 5-Lane Fusion\n3: // ───────────────────────────────────────────────────────────────\n4: \n5: // ───────────────────────────────────────────────────────────────────\n6: // 1. IMPORTS\n7: // ───────────────────────────────────────────────────────────────────\n8: \n9: import { fuseResultsMulti } from '@spec-kit/shared/algorithms/rrf-fusion.js';\n10: \n11: import { applyAmbiguity, isAmbiguousTopTwo, wideAmbiguityMembers } from './ambiguity.js';\n12: import { attributionReason, dominantLane, isDerivedDominant } from './attribution.js';\n13: import {\n14:   ADVISOR_HOOK_FRESHNESS_VALUES,\n15:   ADVISOR_RUNTIME_VALUES,\n16:   isSpeckitMetricsEnabled,\n17:   speckitMetrics,\n18: } from '../metrics.js';\n19: import { normalize } from '../affordance-normalizer.js';\n20: import { scoreDerivedLane } from './lanes/derived.js';\n21: import { scoreExplicitLane } from './lanes/explicit.js';\n22: import { scoreGraphCausalLaneSplit } from './lanes/graph-causal.js';\n23: import { scoreLexicalLane } from './lanes/lexical.js';\n24: import { scoreSemanticShadowExactSubset, scoreSemanticShadowLane } from './lanes/semantic-shadow.js';\n25: import { applyExecutorDelegationOverride } from './executor-delegation.js';\n26: import {\n27:   DOCTOR_HELPER_BRIDGE_ID,\n28:   DOCTOR_HELPER_UNCUED_MIN_SCORE,\n29:   doctorProblemCue,\n30:   matchDoctorProblem,\n31: } from './doctor-helper-handoff.js';\n32: import { loadAdvisorProjection } from './projection.js';\n33: import { SCORING_CALIBRATION } from './scoring-constants.js';\n34: import { isReadOnlyExplainer, matchesPhraseBoundary } from './text.js';\n35: import {\n36:   DEFAULT_SCORER_WEIGHTS,\n37:   SCORER_LANES,\n38:   liveWeightTotal,\n39: } from './weights-config.js';\n40: import { isLiveScorerLane } from './lane-registry.js';\n41: import { isRouteExcludedSkillId } from '../route-exclusions.js';\n42: import { SKILL_ADVISOR_COMPAT_CONTRACT, resolvedConfidenceThreshold, resolvedUncertaintyThreshold } from '../compat/contract.js';\n43: import type {\n44:   AdvisorProjection,\n45:   AdvisorScoredRecommendation,\n46:   AdvisorScoringOptions,\n47:   AdvisorScoringResult,\n48:   LaneContribution,\n49:   LaneMatch,\n50:   LaneRuntimeHealth,\n51:   LaneScores,\n52:   ScorerLane,\n53:   SkillProjection,\n54: } from './types.js';\n55: import type { NormalizedAffordance } from '../affordance-normalizer.js';\n56: import type { RankedList, RrfItem } from '@spec-kit/shared/algorithms/rrf-fusion.js';\n57: \n58: // ───────────────────────────────────────────────────────────────────\n59: // 2. CONSTANTS\n60: // ───────────────────────────────────────────────────────────────────\n61: \n62: const DEFAULT_CONFIDENCE_THRESHOLD = resolvedConfidenceThreshold();\n63: const DEFAULT_UNCERTAINTY_THRESHOLD = resolvedUncertaintyThreshold();\n64: export const ADVISOR_RRF_FUSION_FLAG = 'SPECKIT_ADVISOR_RRF_FUSION';\n65: export const ADVISOR_QUERY_CLASS_ROUTING_FLAG = 'SPECKIT_ADVISOR_QUERY_CLASS_ROUTING';\n66: export const ADVISOR_EXACT_SEMANTIC_RERANK_FLAG = 'SPECKIT_ADVISOR_EXACT_SEMANTIC_RERANK';\n67: export const ADVISOR_RRF_K = 8;\n68: export const ADVISOR_EXACT_SEMANTIC_RERANK_TOP_K = 10;\n69: const ADVISOR_EXACT_SEMANTIC_RERANK_WINDOW = 0.05;\n70: const TASK_INTENT = /\\b(add|append|build|change|configure|create|edit|fix|generate|implement|modify|move|patch|refactor|rename|replace|run|start|sweep|update|write)\\b/;\n71: const DEEP_RESEARCH_CYCLE = /\\b(automated research cycle|looped investigation|continue iteration|resume iteration|overnight run|overnight research run|packet-local iteration|delta record|canonical jsonl|same lineage)\\b/;\n72: // Writing a test or a helper is code work even when the prompt also names a deep-review phrase or a\n73: // study artifact: the thing asked for comes before the phrase it is written about, so a \"deep review\"\n74: // between the verb and the noun means the loop itself is the subject.\n75: const AUTHORS_CODE = /\\b(?:add|build|create|implement|write)\\b(?:(?!deep[- ]review)[^.?!]){0,60}?\\b(?:helper|vitest|tests?)\\b/;\n76: // Writing a changelog is sk-doc's changelog mode even when the prompt names a\n77: // packet or spec folder. That folder is only where the change history comes from.\n78: // The verb must govern the changelog itself: only articles and folder or scope\n79: // modifiers may sit between them, so \"add a nested phase ... for the changelog\n80: // work\" or \"write the spec folder docs, including the changelog ...\" stay\n81: // spec-folder work.\n82: const CHANGELOG_AUTHORING = /\\b(?:add|create|draft|write)\\s+(?:(?:a|an|the|new|nested|packet|packet-local|phase|global|release)\\s+){0,4}changelog(?:\\s+entry)?\\b/;\n83: const CHANGELOG_PACKET_SOURCE = /\\b(?:packet|nested|spec folder)\\b/;\n84: const FILE_SAVE_OPERATION = /\\bsave\\b.{0,48}\\b(file|files|document|documents|buffer|tab|workspace)\\b|\\b(file|files|document|documents|buffer|tab|workspace)\\b.{0,48}\\bsave\\b/;\n85: const MEMORY_SAVE_CONTEXT_ANCHOR = /\\b(memory|context|conversation|session|handover|checkpoint|resume|preserve|remember|capture|store)\\b|\\/memory:save|memory:save/;\n86: // Class C breadth/multi-concern abstention gates. A broad greenfield build or a\n87: // multi-concern optimization is under-specified for single-skill routing.\n88: const BREADTH_BUILD_VERB = /\\b(build|create|implement|generate|scaffold)\\b/;\n89: const BREADTH_NOUN = /\\b(full[- ]?stack|service|platform|application|microservice|saas|backend|whole (app|system))\\b/;\n90: // Narrow anchors that make a broad-build prompt specific enough to route.\n91: const BREADTH_NARROW_ANCHOR = /\\.[a-z]{2,4}\\b|\\b(test|tests|error|bug|failure|failing|handler|component|function|route|endpoint|class|method|benchmark|review|audit|migration|schema)\\b/;\n92: const MULTI_CONCERN_VERB = /\\b(optimize|improve|enhance|harden|speed up)\\b/;\n93: const CONCERN_PERF = /\\b(speed|latency|execution|throughput|performance|startup|memory|cpu)\\b/;\n94: const CONCERN_QUALITY = /\\b(quality|accuracy|recommendation|recommendations|correctness|reliability|coverage)\\b/;\n95: const TRUE_FLAG_VALUES = new Set(['1', 'true', 'yes', 'on', 'enabled']);\n96: const NO_RRF_RANK = Number.MAX_SAFE_INTEGER;\n97: const ADVISOR_SELF_RECOMMENDATION_SKILL_IDS = new Set(['system-skill-advisor', 'skill-advisor']);\n98: const DOCTOR_BRIDGE_PREFIX = 'command-doctor-';\n99: const DOCTOR_COMMAND_PREFIX = '/doctor:';\n100: \n101: // ───────────────────────────────────────────────────────────────────\n102: // 3. TYPE DEFINITIONS\n103: // ───────────────────────────────────────────────────────────────────\n104: \n105: type MutableLaneScores = {\n106:   -readonly [K in keyof LaneScores]: LaneMatch[];\n107: };\n108: \n109: interface LaneScoreBundle {\n110:   readonly laneScores: LaneScores;\n111:   readonly graphConflictMatches: readonly LaneMatch[];\n112:   readonly graphSupportBySeed: ReadonlyMap<string, ReadonlyMap<string, number>>;\n113: }\n114: \n115: interface AdvisorRrfFusion {\n116:   readonly scoreBySkill: ReadonlyMap<string, number>;\n117:   readonly rankBySkill: ReadonlyMap<string, number>;\n118: }\n119: \n120: type AdvisorRuntimeLabel = (typeof ADVISOR_RUNTIME_VALUES)[number];\n121: type AdvisorFreshnessLabel = (typeof ADVISOR_HOOK_FRESHNESS_VALUES)[number];\n122: export type AdvisorQueryClass = 'implementation' | 'review' | 'documentation' | 'memory' | 'tooling' | 'unknown';\n123: \n124: interface ExactSemanticRerankEntry {\n125:   readonly rawScore: number;\n126: }\n127: \n128: type ExactSemanticRerankIndex = ReadonlyMap<string, ExactSemanticRerankEntry>;\n129: \n130: // ───────────────────────────────────────────────────────────────────\n131: // 4. HELPERS\n132: // ───────────────────────────────────────────────────────────────────\n133: \n134: function emptyLaneScores(): MutableLaneScores {\n135:   return Object.fromEntries(SCORER_LANES.map((lane) => [lane, []])) as unknown as MutableLaneScores;\n136: }\n137: \n138: function projectionWithUsableSkillIds(projection: AdvisorProjection): AdvisorProjection {\n139:   const skills = projection.skills.filter((skill) => {\n140:     const skillId: unknown = skill.id;\n141:     return typeof skillId === 'string' && skillId.trim().length > 0;\n142:   });\n143:   return skills.length === projection.skills.length\n144:     ? projection\n145:     : { ...projection, skills };\n146: }\n147: \n148: export function isAdvisorRrfFusionEnabled(): boolean {\n149:   const value = process.env[ADVISOR_RRF_FUSION_FLAG]?.trim().toLowerCase();\n150:   return value ? TRUE_FLAG_VALUES.has(value) : false;\n151: }\n152: \n153: export function isAdvisorQueryClassRoutingEnabled(): boolean {\n154:   const value = process.env[ADVISOR_QUERY_CLASS_ROUTING_FLAG]?.trim().toLowerCase();\n155:   return value ? TRUE_FLAG_VALUES.has(value) : false;\n156: }\n157: \n158: export function isAdvisorExactSemanticRerankEnabled(): boolean {\n159:   const value = process.env[ADVISOR_EXACT_SEMANTIC_RERANK_FLAG]?.trim().toLowerCase();\n160:   return value ? TRUE_FLAG_VALUES.has(value) : false;\n161: }\n162: \n163: export function classifyAdvisorQuery(prompt: string): AdvisorQueryClass {\n164:   const promptLower = prompt.toLowerCase();\n165:   if (/\\b(save context|save memory|handover|resume|checkpoint|spec folder|implementation summary|packet docs?)\\b/.test(promptLower)) {\n166:     return 'memory';\n167:   }\n168:   if (/\\b(review|audit|findings|regression|pull request|pr readiness|release readiness)\\b/.test(promptLower)) {\n169:     return 'review';\n170:   }\n171:   if (/\\b(readme|markdown|documentation|docs|manual testing playbook|feature catalog|taxonomy)\\b/.test(promptLower)) {\n172:     return 'documentation';\n173:   }\n174:   if (/\\b(call_tool_chain|code mode|tool ?chain|chrome devtools|browser console|figma|github|clickup)\\b/.test(promptLower)) {\n175:     return 'tooling';\n176:   }\n177:   if (TASK_INTENT.test(promptLower) || /\\b(typescript|javascript|python|vitest|mcp|handler|schema|fixture)\\b/.test(promptLower)) {\n178:     return 'implementation';\n179:   }\n180:   return 'unknown';\n181: }\n182: \n183: export function queryClassLaneMultipliers(queryClass: AdvisorQueryClass): Readonly<Partial<Record<ScorerLane, number>>> {\n184:   switch (queryClass) {\n185:     case 'implementation':\n186:       return { explicit_author: 1.04, lexical: 1.00, graph_causal: 0.98, derived_generated: 0.98, semantic_shadow: 1.00 };\n187:     case 'review':\n188:       return { explicit_author: 1.03, lexical: 1.02, graph_causal: 0.96, derived_generated: 0.98, semantic_shadow: 1.00 };\n189:     case 'documentation':\n190:       return { explicit_author: 1.03, lexical: 0.98, graph_causal: 0.95, derived_generated: 1.04, semantic_shadow: 1.00 };\n191:     case 'memory':\n192:       return { explicit_author: 1.04, lexical: 0.98, graph_causal: 1.02, derived_generated: 1.00, semantic_shadow: 0.96 };\n193:     case 'tooling':\n194:       return { explicit_author: 1.04, lexical: 1.00, graph_causal: 0.98, derived_generated: 0.96, semantic_shadow: 1.00 };\n195:     case 'unknown':\n196:       return {};\n197:   }\n198: }\n199: \n200: export function applyQueryClassLaneMultipliers(\n201:   weights: Readonly<Record<ScorerLane, number>>,\n202:   queryClass: AdvisorQueryClass,\n203: ): Readonly<Record<ScorerLane, number>> {\n204:   const multipliers = queryClassLaneMultipliers(queryClass);\n205:   if (Object.keys(multipliers).length === 0) return weights;\n206:   const next = { ...weights };\n207:   for (const lane of SCORER_LANES) {\n208:     const multiplier = multipliers[lane];\n209:     if (typeof multiplier === 'number' && Number.isFinite(multiplier)) {\n210:       next[lane] = Number((next[lane] * multiplier).toFixed(6));\n211:     }\n212:   }\n213:   const strongestOther = Math.max(...SCORER_LANES\n214:     .filter((lane) => lane !== 'explicit_author')\n215:     .map((lane) => next[lane]));\n216:   if (next.explicit_author < strongestOther) {\n217:     next.explicit_author = Number(strongestOther.toFixed(6));\n218:   }\n219:   return next;\n220: }\n221: \n222: function effectiveScorerWeights(\n223:   override: AdvisorScoringOptions['laneWeightsOverride'] | undefined,\n224:   queryClass: AdvisorQueryClass = 'unknown',\n225: ): Readonly<Record<ScorerLane, number>> {\n226:   const base = !override ? DEFAULT_SCORER_WEIGHTS : (() => {\n227:     const weights: Record<ScorerLane, number> = { ...DEFAULT_SCORER_WEIGHTS };\n228:     const runtimeOverride = override as Partial<Record<string, number>>;\n229:     for (const lane of SCORER_LANES) {\n230:       const value = runtimeOverride[lane];\n231:       if (typeof value === 'number' && Number.isFinite(value)) {\n232:         weights[lane] = value;\n233:       }\n234:     }\n235:     return weights;\n236:   })();\n237:   if (queryClass === 'unknown') return base;\n238:   return applyQueryClassLaneMultipliers(base, queryClass);\n239: }\n240: \n241: function normalizeRuntimeLabel(value: string | undefined): AdvisorRuntimeLabel | null {\n242:   if (value === undefined) {\n243:     return null;\n244:   }\n245:   return ADVISOR_RUNTIME_VALUES.includes(value as AdvisorRuntimeLabel) ? value as AdvisorRuntimeLabel : null;\n246: }\n247: \n248: function normalizeFreshnessLabel(value: string | undefined): AdvisorFreshnessLabel | null {\n249:   if (value === undefined) {\n250:     return 'unavailable';\n251:   }\n252:   return ADVISOR_HOOK_FRESHNESS_VALUES.includes(value as AdvisorFreshnessLabel) ? value as AdvisorFreshnessLabel : null;\n253: }\n254: \n255: interface LaneMatchIndexEntry {\n256:   rawScore: number;\n257:   evidence: string[];\n258:   producerSkillIds: string[];\n259: }\n260: \n261: type LaneMatchIndex = Map<string, LaneMatchIndexEntry>;\n262: \n263: function buildLaneRuntimeHealth(\n264:   laneScores: LaneScores,\n265:   disabled: ReadonlySet<ScorerLane>,\n266:   runtimeLaneHealth: AdvisorScoringOptions['runtimeLaneHealth'] | undefined,\n267: ): readonly LaneRuntimeHealth[] {\n268:   return SCORER_LANES.map((lane): LaneRuntimeHealth => {\n269:     const matchCount = laneScores[lane].length;\n270:     const signal = runtimeLaneHealth?.[lane];\n271:     if (!disabled.has(lane) && signal?.status === 'runtime_degraded' && matchCount === 0) {\n272:       return {\n273:         lane,\n274:         status: 'runtime_degraded',\n275:         matchCount,\n276:         ...(signal.reason ? { reason: signal.reason } : {}),\n277:       };\n278:     }\n279:     return {\n280:       lane,\n281:       status: matchCount > 0 ? 'healthy' : 'matched_nothing',\n282:       matchCount,\n283:       ...(signal?.reason && signal.status === 'healthy' ? { reason: signal.reason } : {}),\n284:     };\n285:   });\n286: }\n287: \n288: function projectionRuntimeLaneHealth(\n289:   projection: AdvisorProjection,\n290:   runtimeLaneHealth: AdvisorScoringOptions['runtimeLaneHealth'] | undefined,\n291: ): AdvisorScoringOptions['runtimeLaneHealth'] | undefined {\n292:   if (!projection.embeddingStaleness?.stale) {\n293:     return runtimeLaneHealth;\n294:   }\n295:   return {\n296:     ...runtimeLaneHealth,\n297:     semantic_shadow: runtimeLaneHealth?.semantic_shadow ?? {\n298:       status: 'runtime_degraded',\n299:       reason: projection.embeddingStaleness.reason ?? 'projection_embedding_stale',\n300:     },\n301:   };\n302: }\n303: \n304: function degradedLaneReason(degradedLanes: readonly ScorerLane[]): string | null {\n305:   if (degradedLanes.length === 0) return null;\n306:   return `Runtime-degraded scorer lanes omitted from confidence normalization: ${degradedLanes.join(', ')}.`;\n307: }\n308: \n309: function buildLaneMatchIndex(matches: readonly LaneMatch[]): LaneMatchIndex {\n310:   const index: LaneMatchIndex = new Map();\n311:   for (const match of matches) {\n312:     const existing = index.get(match.skillId) ?? { rawScore: 0, evidence: [], producerSkillIds: [] };\n313:     existing.rawScore = Math.max(existing.rawScore, match.score);\n314:     if (existing.evidence.length < 6) {\n315:       existing.evidence.push(...match.evidence.slice(0, 6 - existing.evidence.length));\n316:     }\n317:     for (const producerSkillId of match.producerSkillIds ?? []) {\n318:       if (!existing.producerSkillIds.includes(producerSkillId)) {\n319:         existing.producerSkillIds.push(producerSkillId);\n320:       }\n321:     }\n322:     index.set(match.skillId, existing);\n323:   }\n324:   return index;\n325: }\n326: \n327: function buildConflictMatchIndex(matches: readonly LaneMatch[]): LaneMatchIndex {\n328:   const index: LaneMatchIndex = new Map();\n329:   for (const match of matches) {\n330:     const existing = index.get(match.skillId) ?? { rawScore: 0, evidence: [], producerSkillIds: [] };\n331:     existing.rawScore = Math.min(existing.rawScore, match.score);\n332:     if (existing.evidence.length < 6) {\n333:       existing.evidence.push(...match.evidence.slice(0, 6 - existing.evidence.length));\n334:     }\n335:     index.set(match.skillId, existing);\n336:   }\n337:   return index;\n338: }\n339: \n340: function rankedRrfItems(matches: readonly LaneMatch[]): RrfItem[] {\n341:   return [...matches]\n342:     .filter((match) => match.score > 0)\n343:     .sort((left, right) => right.score - left.score || left.skillId.localeCompare(right.skillId))\n344:     .map((match) => ({ id: match.skillId }));\n345: }\n346: \n347: export function fuseAdvisorLaneRanks(\n348:   laneScores: LaneScores,\n349:   weights: Readonly<Record<ScorerLane, number>>,\n350:   disabled: ReadonlySet<ScorerLane> = new Set(),\n351:   runtimeDegraded: ReadonlySet<ScorerLane> = new Set(),\n352: ): AdvisorRrfFusion {\n353:   const lists: RankedList[] = SCORER_LANES.map((lane) => ({\n354:     source: lane,\n355:     results: rankedRrfItems(laneScores[lane]),\n356:     weight: disabled.has(lane) || runtimeDegraded.has(lane) || !isLiveScorerLane(lane)\n357:       ? 0\n358:       : weights[lane],\n359:   }));\n360:   const fused = fuseResultsMulti(lists, {\n361:     k: ADVISOR_RRF_K,\n362:     convergenceBonus: 0,\n363:     calibratedOverlapBeta: 0,\n364:     bonusOverChannels: 'configured',\n365:   });\n366:   const scoreBySkill = new Map<string, number>();\n367:   const rankBySkill = new Map<string, number>();\n368:   fused.forEach((result, index) => {\n369:     const skillId = String(result.id);\n370:     scoreBySkill.set(skillId, result.rrfScore);\n371:     rankBySkill.set(skillId, index);\n372:   });\n373:   return { scoreBySkill, rankBySkill };\n374: }\n375: \n376: function graphConflictAdjustment(\n377:   conflictIndex: LaneMatchIndex,\n378:   recommendation: AdvisorScoredRecommendation,\n379: ): number {\n380:   return conflictIndex.get(recommendation.skill)?.rawScore ?? 0;\n381: }\n382: \n383: function buildExactSemanticRerankIndex(\n384:   prompt: string,\n385:   projection: AdvisorProjection,\n386:   recommendations: readonly AdvisorScoredRecommendation[],\n387:   fusion: AdvisorRrfFusion | null,\n388: ): ExactSemanticRerankIndex {\n389:   if (!fusion) return new Map();\n390:   const topSkillIds = [...recommendations]\n391:     .filter((recommendation) => fusion.rankBySkill.has(recommendation.skill))\n392:     .sort((left, right) => rrfRankFor(fusion, left) - rrfRankFor(fusion, right))\n393:     .slice(0, ADVISOR_EXACT_SEMANTIC_RERANK_TOP_K)\n394:     .map((recommendation) => recommendation.skill);\n395:   const matches = scoreSemanticShadowExactSubset(prompt, projection, topSkillIds);\n396:   return new Map(matches.map((match) => [match.skillId, {\n397:     rawScore: match.score,\n398:   }]));\n399: }\n400: \n401: function exactSemanticRerankScore(\n402:   rerankIndex: ExactSemanticRerankIndex,\n403:   recommendation: AdvisorScoredRecommendation,\n404: ): number | null {\n405:   return rerankIndex.get(recommendation.skill)?.rawScore ?? null;\n406: }\n407: \n408: function rrfRankFor(\n409:   fusion: AdvisorRrfFusion | null,\n410:   recommendation: AdvisorScoredRecommendation,\n411: ): number {\n412:   return fusion?.rankBySkill.get(recommendation.skill) ?? NO_RRF_RANK;\n413: }\n414: \n415: function promptMentionsSkill(promptLower: string, skill: SkillProjection): boolean {\n416:   const phrases = [skill.id, skill.name, skill.id.replace(/-/g, ' ')];\n417:   // A cli skill wraps one named external tool, so the tool's own name (\"orca\"\n418:   // for cli-orca) names the skill as surely as its id does.\n419:   if (skill.family === 'cli' && skill.id.startsWith('cli-')) {\n420:     phrases.push(skill.id.slice('cli-'.length).replace(/-/g, ' '));\n421:   }\n422:   return phrases.some((phrase) => matchesPhraseBoundary(promptLower, phrase.toLowerCase()));\n423: }\n424: \n425: function isDefaultRoutable(promptLower: string, skill: SkillProjection): boolean {\n426:   if (isRouteExcludedSkillId(skill.id)) return false;\n427:   if (skill.lifecycleStatus === 'archived' || skill.lifecycleStatus === 'future') return false;\n428:   if (skill.lifecycleStatus === 'deprecated') return promptMentionsSkill(promptLower, skill);\n429:   return true;\n430: }\n431: \n432: function isAdvisorSelfRecommendationSkill(skillId: string): boolean {\n433:   return ADVISOR_SELF_RECOMMENDATION_SKILL_IDS.has(skillId);\n434: }\n435: \n436: function confidenceFor(args: {\n437:   liveNormalized: number;\n438:   directScore: number;\n439:   readOnlyExplainer: boolean;\n440:   hasExplicitWorkflowSignal: boolean;\n441:   hasTaskIntent: boolean;\n442:   readOnlyRouteAllowed: boolean;\n443:   derivedDominant: boolean;\n444:   skillId: string;\n445: }): { value: number; floored: boolean } {\n446:   const C = SCORING_CALIBRATION.confidence;\n447:   // The advisor alias must never rank itself first on a read-only explainer;\n448:   // floor its confidence. The canonical id is demoted separately by the audit\n449:   // penalty in primaryIntentBonus, so this branch intentionally matches only\n450:   // the alias id.\n451:   if (args.readOnlyExplainer && args.skillId === 'skill-advisor') {\n452:     return { value: C.readOnlyExplainerFloor, floored: false };\n453:   }\n454:   const base = C.baseConstant\n455:     + Math.min(1, args.liveNormalized * C.liveNormalizedRampGain) * C.liveNormalizedRampCoefficient;\n456:   if (args.readOnlyExplainer && !args.readOnlyRouteAllowed) {\n457:     return { value: C.readOnlyExplainerFloor, floored: false };\n458:   }\n459:   if (args.readOnlyRouteAllowed) {\n460:     return {\n461:       value: Number(Math.max(base, C.readOnlyRouteAllowedFloor).toFixed(4)),\n462:       floored: C.readOnlyRouteAllowedFloor > base,\n463:     };\n464:   }\n465:   if (args.derivedDominant && args.directScore < C.derivedDominantDirectScoreCeiling) {\n466:     return { value: C.derivedDominantConfidence, floored: false };\n467:   }\n468:   if (args.hasTaskIntent\n469:     && (args.directScore >= C.taskIntentDirectScoreFloor\n470:       || args.liveNormalized >= C.taskIntentLiveNormalizedFloor)) {\n471:     // Token-stuffing dispersion guard. Without this, a prompt\n472:     // with task-intent + many weak signals (saturating liveNormalized) but\n473:     // no strong direct anchor would force confidence to taskIntentFloor for\n474:     // many unrelated skills. The guard fires when liveNormalized is near-\n475:     // saturated AND directScore is below the directScoreLiftThreshold —\n476:     // the precise signature of a token-stuffed prompt. Legitimate task-intent\n477:     // prompts have at least one strong direct hit and pass via directScore;\n478:     // they don't hit this branch. When the guard fires we fall through to\n479:     // the standard `base + directBonus` math below.\n480:     const dispersionGuardTripped = args.liveNormalized >= 0.95\n481:       && args.directScore < C.directScoreLiftThreshold;\n482:     if (!dispersionGuardTripped) {\n483:       return {\n484:         value: Number(Math.max(base, C.taskIntentFloor).toFixed(4)),\n485:         floored: C.taskIntentFloor > base,\n486:       };\n487:     }\n488:   }\n489:   if (args.directScore >= C.directScoreLiftThreshold) {\n490:     return {\n491:       value: Number(Math.max(base, C.directScoreFloor).toFixed(4)),\n492:       floored: C.directScoreFloor > base,\n493:     };\n494:   }\n495:   const directBonus = args.directScore >= C.directScoreBonusThreshold ? C.directScoreBonus : 0;\n496:   return { value: Number(Math.max(0, Math.min(C.hardCeiling, base + directBonus)).toFixed(4)), floored: false };\n497: }\n498: \n499: function uncertaintyFor(contributions: readonly LaneContribution[], confidence: number, ambiguousPressure: number): number {\n500:   const U = SCORING_CALIBRATION.uncertainty;\n501:   const evidenceCount = contributions.reduce((total, contribution) => total + contribution.evidence.length, 0);\n502:   const direct = contributions\n503:     .filter((contribution) => contribution.lane === 'explicit_author' || contribution.lane === 'lexical')\n504:     .reduce((max, contribution) => Math.max(max, contribution.rawScore), 0);\n505:   let uncertainty = U.noEvidenceDefault;\n506:   if (evidenceCount >= U.highEvidenceCount) uncertainty = U.lowFloor;\n507:   else if (evidenceCount >= U.mediumEvidenceCount) uncertainty = U.mediumFloor;\n508:   else if (evidenceCount >= U.someEvidenceCount) uncertainty = U.elevatedFloor;\n509:   if (direct >= U.directEvidenceDiscountThreshold) uncertainty -= U.directEvidenceDiscount;\n510:   if (confidence < U.lowConfidencePenaltyThreshold) uncertainty += U.lowConfidencePenalty;\n511:   uncertainty += ambiguousPressure;\n512:   return Number(Math.max(U.hardFloor, Math.min(U.hardCeiling, uncertainty)).toFixed(2));\n513: }\n514: \n515: function buildLaneScores(\n516:   prompt: string,\n517:   projection: AdvisorProjection,\n518:   disabled: Set<ScorerLane>,\n519:   affordances: readonly NormalizedAffordance[],\n520:   useRrfFusion: boolean,\n521: ): LaneScoreBundle {\n522:   const scores = emptyLaneScores();\n523:   if (!disabled.has('explicit_author')) {\n524:     scores.explicit_author = scoreExplicitLane(prompt, projection);\n525:   }\n526:   if (!disabled.has('lexical')) scores.lexical = scoreLexicalLane(prompt, projection);\n527:   if (!disabled.has('derived_generated')) scores.derived_generated = scoreDerivedLane(prompt, projection, new Date(), affordances);\n528:   if (!disabled.has('semantic_shadow')) scores.semantic_shadow = scoreSemanticShadowLane(prompt, projection);\n529:   let graphConflictMatches: readonly LaneMatch[] = [];\n530:   let graphSupportBySeed: ReadonlyMap<string, ReadonlyMap<string, number>> = new Map();\n531:   if (!disabled.has('graph_causal')) {\n532:     const graphSplit = scoreGraphCausalLaneSplit([\n533:       ...scores.explicit_author,\n534:       ...scores.lexical,\n535:       ...scores.derived_generated,\n536:     ], projection, {}, affordances);\n537:     scores.graph_causal = useRrfFusion ? graphSplit.positiveMatches : graphSplit.combinedMatches;\n538:     graphConflictMatches = graphSplit.conflictMatches;\n539:     graphSupportBySeed = graphSplit.positiveSupportBySeed;\n540:   }\n541:   return { laneScores: scores, graphConflictMatches, graphSupportBySeed };\n542: }\n543: \n544: // Smallest gap the rounded weighted score can still express, so a bounded\n545: // target sorts strictly below its seed instead of tying with it.\n546: const SEED_BOUND_GAP = 0.000001;\n547: \n548: // Below this explicit-lane score a match is a side mention, not a request.\n549: const EXPLICIT_WORKFLOW_SIGNAL_FLOOR = 0.55;\n550: \n551: // Explicit-lane evidence that a typed slash command named this skill.\n552: const SLASH_COMMAND_EVIDENCE = /^(phrase|author|explicit):\\//;\n553: \n554: export function hasSlashCommandAnchor(rawScore: number, evidence: readonly string[]): boolean {\n555:   return rawScore >= EXPLICIT_WORKFLOW_SIGNAL_FLOOR\n556:     && evidence.some((entry) => SLASH_COMMAND_EVIDENCE.test(entry));\n557: }\n558: \n559: // Graph support is lent: a seed's own evidence propagates to its neighbours so\n560: // related skills surface beside it. When the seed was invoked by a typed slash\n561: // command, the user has named it outright, so support it lends may lift a\n562: // target up to it but never past it; otherwise the command's own match is what\n563: // buries the command (a typed \"/deep:research\" handing its dependency enough\n564: // support to win). Seeds matched only on loose tokens keep ordinary graph\n565: // lending, since there the neighbour may well be the better route. Two skills\n566: // often lend to each other, so the pair is compared on what each holds once\n567: // the other's loan is taken back: a target whose own evidence still beats the\n568: // seed's own evidence keeps its score.\n569: export function boundGraphSupportBySeed(\n570:   scores: ReadonlyMap<string, number>,\n571:   graphRawBySkill: ReadonlyMap<string, number>,\n572:   graphSupportBySeed: ReadonlyMap<string, ReadonlyMap<string, number>>,\n573:   graphWeight: number,\n574:   slashAnchoredSeeds: ReadonlySet<string>,\n575: ): Map<string, number> {\n576:   return boundGraphSupportBySeedWithHolders(\n577:     scores,\n578:     graphRawBySkill,\n579:     graphSupportBySeed,\n580:     graphWeight,\n581:     slashAnchoredSeeds,\n582:   ).scores;\n583: }\n584: \n585: export interface SeedBoundResult {\n586:   readonly scores: Map<string, number>;\n587:   // Target skill -> the typed-command seed whose ceiling actually lowered it.\n588:   readonly heldBelow: Map<string, string>;\n589: }\n590: \n591: export function boundGraphSupportBySeedWithHolders(\n592:   scores: ReadonlyMap<string, number>,\n593:   graphRawBySkill: ReadonlyMap<string, number>,\n594:   graphSupportBySeed: ReadonlyMap<string, ReadonlyMap<string, number>>,\n595:   graphWeight: number,\n596:   slashAnchoredSeeds: ReadonlySet<string>,\n597: ): SeedBoundResult {\n598:   const bounded = new Map(scores);\n599:   const heldBelow = new Map<string, string>();\n600:   if (graphWeight <= 0) return { scores: bounded, heldBelow };\n601:   const lentBy = (lenderId: string, receiverId: string): number => {\n602:     const support = graphSupportBySeed.get(receiverId)?.get(lenderId) ?? 0;\n603:     const graphRaw = Math.max(0, graphRawBySkill.get(receiverId) ?? 0);\n604:     return Math.min(support, graphRaw) * graphWeight;\n605:   };\n606:   // Which seed holds which target down is decided once, on the unbounded\n607:   // scores, so the evidence comparison never sees a cap.\n608:   const holdersByTarget = new Map<string, string[]>();\n609:   for (const [targetId, supportBySeed] of graphSupportBySeed) {\n610:     const targetScore = scores.get(targetId);\n611:     if (targetScore === undefined) continue;\n612:     const holders: string[] = [];\n613:     for (const seedId of supportBySeed.keys()) {\n614:       if (seedId === targetId || !slashAnchoredSeeds.has(seedId)) continue;\n615:       const seedScore = scores.get(seedId);\n616:       if (seedScore === undefined) continue;\n617:       const targetOwn = targetScore - lentBy(seedId, targetId);\n618:       const seedOwn = seedScore - lentBy(targetId, seedId);\n619:       if (targetOwn < seedOwn) holders.push(seedId);\n620:     }\n621:     if (holders.length > 0) holdersByTarget.set(targetId, holders);\n622:   }\n623:   // A held seed can itself be held by another typed command, so each ceiling\n624:   // follows the seed's bounded score and the caps repeat until nothing moves.\n625:   // Caps only ever lower a score, and each pass settles at least one more link\n626:   // of a chain, so one pass per held target is enough.\n627:   for (let pass = 0; pass <= holdersByTarget.size; pass += 1) {\n628:     let moved = false;\n629:     for (const [targetId, holders] of holdersByTarget) {\n630:       const current = bounded.get(targetId) ?? 0;\n631:       let ceiling = current;\n632:       for (const seedId of holders) ceiling = Math.min(ceiling, (bounded.get(seedId) ?? 0) - SEED_BOUND_GAP);\n633:       if (ceiling < current) {\n634:         bounded.set(targetId, Math.max(0, ceiling));\n635:         moved = true;\n636:       }\n637:     }\n638:     if (!moved) break;\n639:   }\n640:   // Only a target the cap really lowered is marked, and only against the seed\n641:   // whose ceiling set its final score: a seed that merely could have held it\n642:   // ranked nothing, so the pair keeps its ordinary ambiguity check.\n643:   for (const [targetId, holders] of holdersByTarget) {\n644:     const final = bounded.get(targetId) ?? 0;\n645:     if (final >= (scores.get(targetId) ?? 0)) continue;\n646:     let binding: string | null = null;\n647:     let lowestSeed = Number.POSITIVE_INFINITY;\n648:     for (const seedId of holders) {\n649:       const seedScore = bounded.get(seedId) ?? 0;\n650:       if (seedScore < lowestSeed) {\n651:         lowestSeed = seedScore;\n652:         binding = seedId;\n653:       }\n654:     }\n655:     if (binding) heldBelow.set(targetId, binding);\n656:   }\n657:   return { scores: bounded, heldBelow };\n658: }\n659: \n660: function hasExplicitWorkflowSignal(contributions: readonly LaneContribution[], skillId: string): boolean {\n661:   const explicit = contributions.find((contribution) => contribution.lane === 'explicit_author');\n662:   if (!explicit || explicit.rawScore < EXPLICIT_WORKFLOW_SIGNAL_FLOOR) return false;\n663:   return explicit.evidence.some((entry) => (\n664:     entry.startsWith('phrase:')\n665:     || entry.startsWith('explicit:')\n666:     || entry.startsWith('author:')\n667:     || entry.includes(skillId)\n668:     || entry.includes('loop')\n669:     || entry.includes('write-')\n670:   ));\n671: }\n672: \n673: // Wording that asks for an answer and rules out a change. One pattern serves\n674: // every gate that has to honour it, so a new gate cannot drift from the first.\n675: const NO_EDIT_REQUEST = /\\b(no edits?|without making changes|do not (change|edit|modify|touch)|read-only only|no edits yet|only; do not|just show|just list)\\b/;\n676: \n677: export function readOnlyRouteAllowed(promptLower: string, skill: SkillProjection): boolean {\n678:   const skillId = skill.id;\n679:   if (NO_EDIT_REQUEST.test(promptLower)) {\n680:     return false;\n681:   }\n682:   // The explainer floor exists to stop an ambiguous read-only question from\n683:   // routing anywhere. Naming the skill removes the ambiguity: the caller has\n684:   // already chosen, and a read-only verb does not undo that choice. Without\n685:   // this, an explicit request is answered with an abstention while the same\n686:   // sentence phrased with a write verb routes fine.\n687:   if (promptMentionsSkill(promptLower, skill)) {\n688:     return true;\n689:   }\n690:   // A command whose route only reads (a report, a status check) is the answer\n691:   // to a list or show question, so its own trigger phrase lifts it off the\n692:   // floor. A mutating command never carries the flag and stays gated.\n693:   if (skill.kind === 'command' && 'readOnly' in skill && skill.readOnly === true\n694:     && skill.keywords.some((phrase) => matchesPhraseBoundary(promptLower, phrase.toLowerCase()))) {\n695:     return true;\n696:   }\n697:   if (skillId === 'sk-code' && /\\b(compare|audit|review)\\b/.test(promptLower)\n698:     && /\\b(classifier|vocabulary|prose|implementation|agents\\.md|drift|mismatch)\\b/.test(promptLower)) {\n699:     return true;\n700:   }\n701:   if (skillId === 'system-spec-kit' && /\\b(memory_save|resume_write|routing taxonomy|corpus|source-type|routing bucket)\\b/.test(promptLower)) {\n702:     return true;\n703:   }\n704:   if (skillId === 'system-spec-kit' && /\\b(packet|spec folder|save memory|phase|continuation prompts|resume handling)\\b/.test(promptLower)) {\n705:     return true;\n706:   }\n707:   // Captured operator answers wait in a queue that spec-kit's save step owns, so a show or list\n708:   // question about that queue, its chat candidates or the decision record is answered there.\n709:   // Only a read-only question is lifted: a lift applies to any prompt, and a request to research,\n710:   // dispatch or build something about decisions belongs to another skill.\n711:   if (skillId === 'system-spec-kit' && isReadOnlyExplainer(promptLower)\n712:     && /\\b(decision capture|decision record|chat candidates?|operator decisions?|recorded as decisions?)\\b/.test(promptLower)) {\n713:     return true;\n714:   }\n715:   // The trigger index is spec-kit's own lookup surface, so a question about what a lookup\n716:   // returned, counted or left out is answered there. Without the lift no skill passes on such a\n717:   // question, and the doctor hand-off claims it on the index noun alone. Drift is the doctor's\n718:   // own diagnosis, so a drift question stays with the hand-off.\n719:   if (skillId === 'system-spec-kit' && isReadOnlyExplainer(promptLower)\n720:     && /\\btrigger[- ]index\\b/.test(promptLower) && !/\\bdrift\\b/.test(promptLower)) {\n721:     return true;\n722:   }\n723:   if (skillId === 'system-deep-loop' && /\\b(ai council|planning council|council deliberation|council artifacts|multi-seat planning)\\b/.test(promptLower)) {\n724:     return true;\n725:   }\n726:   // Browser/devtools inspection is a genuine chrome-devtools task even though\n727:   // its verb (\"inspect\") reads as a read-only explainer. Lift it off the\n728:   // explainer floor when the prompt carries devtools-specific vocabulary.\n729:   if (skillId === 'mcp-tooling'\n730:     && /\\b(network waterfall|network tab|network request|dev ?tools|browser console|page inspector|dom inspector|performance trace|inspect (the )?(network|dom|page|element|browser))\\b/.test(promptLower)) {\n731:     return true;\n732:   }\n733:   if (skillId === 'sk-code' && /\\bgate-3-classifier\\.ts\\b/.test(promptLower)) {\n734:     return true;\n735:   }\n736:   return false;\n737: }\n738: \n739: function isPlainFileSavePrompt(promptLower: string): boolean {\n740:   return FILE_SAVE_OPERATION.test(promptLower) && !MEMORY_SAVE_CONTEXT_ANCHOR.test(promptLower.replace(/\\bfile(s)?\\b/g, ''));\n741: }\n742: \n743: function primaryIntentBonus(\n744:   promptLower: string,\n745:   recommendation: AdvisorScoredRecommendation,\n746: ): number {\n747:   const R = SCORING_CALIBRATION.routing;\n748:   if (/\\bsemantic (code )?search\\b/.test(promptLower)) {\n749:   }\n750:   if (/\\bdeep[- ]review\\b/.test(promptLower)) {\n751:     if (recommendation.skill === 'sk-code') {\n752:       return AUTHORS_CODE.test(promptLower) ? R.deepReviewCodeAuthoringSkCodeBonus : R.deepReviewSkCodeReviewPenalty;\n753:     }\n754:   }\n755:   if (/\\bdeep[- ]research\\b/.test(promptLower)) {\n756:     if (recommendation.skill === 'system-spec-kit' || recommendation.skill === 'sk-code') return R.deepResearchOtherSkillsPenalty;\n757:   }\n758:   if (DEEP_RESEARCH_CYCLE.test(promptLower)) {\n759:     if (recommendation.skill === 'system-spec-kit' || recommendation.skill === 'sk-code') return R.deepResearchCycleOtherSkillsPenalty;\n760:   }\n761:   if (/\\b(compare|audit|review)\\b/.test(promptLower) && /\\b(classifier|vocabulary|prose|implementation|agents\\.md|drift|mismatch)\\b/.test(promptLower)) {\n762:     if (recommendation.skill === 'sk-code') return R.compareAuditCodeReviewBonus;\n763:   }\n764:   // A changelog request that names its packet or spec folder still asks for a\n765:   // changelog, so sk-doc must outrank the spec workflow that \"spec folder\" lifts.\n766:   // Only those two skills are adjusted here. Every other skill falls through so\n767:   // later rules such as save-context or /speckit:plan still apply to it.\n768:   const changelogFromPacket = CHANGELOG_AUTHORING.test(promptLower)\n769:     && CHANGELOG_PACKET_SOURCE.test(promptLower)\n770:     && !AUTHORS_CODE.test(promptLower);\n771:   if (changelogFromPacket) {\n772:     if (recommendation.skill === 'sk-doc') return R.changelogFromPacketSkDocBonus;\n773:     if (recommendation.skill === 'system-spec-kit') return R.changelogFromPacketSpecKitPenalty;\n774:   }\n775:   // The corpus-study rule reads \"packet-local\" as study vocabulary, so it must\n776:   // stay off a changelog request or it would pull the prompt to system-spec-kit.\n777:   // \"packet-local changelog\" names sk-doc's changelog mode with or without an\n778:   // authoring verb, so packet-local is study vocabulary only when it qualifies\n779:   // something other than a changelog.\n780:   if (!changelogFromPacket && /\\b(corpus ids?|first-100 predictions|continuation prompts|routing study config|confusion matrix|source-mix note|prompt template|packet-local(?!\\s+changelog))\\b/.test(promptLower) && !AUTHORS_CODE.test(promptLower)) {\n781:     if (recommendation.skill === 'system-spec-kit') return R.corpusStudySpecKitBonus;\n782:     if (recommendation.skill === 'sk-prompt' || recommendation.skill === 'mcp-tooling' || recommendation.skill === 'sk-doc') return R.corpusStudyOtherSkillsPenalty;\n783:   }\n784:   if (promptLower.includes('/speckit:resume')) {\n785:     if (recommendation.skill === 'system-spec-kit') return R.speckitResumeSpecKitBonus;\n786:     if (recommendation.skill === 'command-spec-kit-resume') return R.speckitResumeCommandPenalty;\n787:   }\n788:   if (promptLower.includes('/speckit:plan')) {\n789:     if (recommendation.skill === 'command-spec-kit-plan') return R.speckitPlanCommandBonus;\n790:     if (recommendation.skill === 'sk-doc') return R.speckitPlanSkDocPenalty;\n791:   }\n792:   // External-tool-chain (\"call_tool_chain\") vocabulary belongs to mcp-code-mode,\n793:   // not the generic code skill. Disambiguate so the best guess for these\n794:   // toolchain-shaped prompts is mcp-code-mode.\n795:   // Toolchain + external-data-source vocabulary (webflow CMS, cms collection)\n796:   // is mcp-code-mode territory, not the generic code skill.\n797:   if (/\\b(call_tool_chain|code mode|tool ?chain|api chain|webflow cms|cms collection)\\b/.test(promptLower)) {\n798:     if (recommendation.skill === 'mcp-code-mode') return R.mcpToolchainCodeModeBonus;\n799:     if (recommendation.skill === 'sk-code') return R.mcpToolchainSkCodePenalty;\n800:   }\n801:   // A \"code audit\" is a single-pass code-review task, not a deep-review loop, so\n802:   // sk-code should win the near-tie this phrase produces. The sk-code bonus\n803:   // carries that; the deep-loop skills intentionally hold no \"code audit\"\n804:   // vocabulary, so they need no counter-penalty here.\n805:   if (/\\bcode audit\\b/.test(promptLower)) {\n806:     if (recommendation.skill === 'sk-code') return R.codeAuditCodeReviewBonus;\n807:   }\n808:   // Colon-command review-loop syntax (\":review:auto\") invokes the deep-review\n809:   // loop; rank it above single-pass code review.\n810:   if (/:review:(auto|confirm)\\b/.test(promptLower)) {\n811:     if (recommendation.skill === 'system-deep-loop') return R.reviewLoopDeepReviewBonus;\n812:     if (recommendation.skill === 'sk-code') return R.deepReviewSkCodeReviewPenalty;\n813:   }\n814:   // Auditing recommendation quality is a review task, not an advisor-self task.\n815:   if (/\\baudit\\b/.test(promptLower) && /\\b(recommendation|recommendations|recommendation quality|routing quality)\\b/.test(promptLower)) {\n816:     if (recommendation.skill === 'sk-code') return R.auditRecsCodeReviewBonus;\n817:     // Auditing routing output is a review task, not an advisor invocation: demote\n818:     // the advisor and its alias (the canonical self-rec id set) so neither ranks\n819:     // itself first here.\n820:     if (isAdvisorSelfRecommendationSkill(recommendation.skill)) return R.auditRecsAdvisorPenalty;\n821:   }\n822:   if (/\\b(save context|save memory)\\b/.test(promptLower)) {\n823:     if (recommendation.skill === 'command-speckit-save') return R.saveContextMemorySaveBonus;\n824:     if (recommendation.skill === 'system-spec-kit') return R.saveContextMemorySpecKitPenalty;\n825:   }\n826:   if (/\\b(create (a )?new agent|create agent)\\b/.test(promptLower) || promptLower.includes('/create:agent')) {\n827:     if (recommendation.skill === 'create:agent') return R.createAgentCreateAgentBonus;\n828:     if (recommendation.skill === 'sk-doc') return R.createAgentSkDocPenalty;\n829:   }\n830:   if (/\\bcreate (a )?(test|testing) playbook\\b/.test(promptLower) || promptLower.includes('/create:manual-testing-playbook')) {\n831:     if (recommendation.skill === 'create:manual-testing-playbook' || recommendation.skill === 'command-create-manual-testing-playbook') return R.createTestingPlaybookBonus;\n832:     if (recommendation.skill === 'sk-doc') return R.createTestingPlaybookSkDocPenalty;\n833:     if (recommendation.skill === 'system-deep-loop') return R.createTestingPlaybookOtherSkillsPenalty;\n834:   }\n835:   if (/\\bphase folder\\b/.test(promptLower)) {\n836:     if (recommendation.skill === 'system-spec-kit') return R.phaseFolderSpecKitBonus;\n837:   }\n838:   return 0;\n839: }\n840: \n841: // ───────────────────────────────────────────────────────────────────\n842: // 5. CORE LOGIC\n843: // ───────────────────────────────────────────────────────────────────\n844: \n845: // The bar sits above the highest cosine any prompt that must stay silent reached\n846: // against a command row, with headroom, because a command offered for the wrong\n847: // prompt costs more than one that stays quiet. The margin asks for a small lead\n848: // over the next command and over the top skill, which is what kept a wrong\n849: // command out of first place on the tuning rows. Raise the bar before the\n850: // margin if a false offer appears.\n851: export const COMMAND_MEANING_MIN_COSINE = 0.72;\n852: export const COMMAND_MEANING_MARGIN = 0.02;\n853: \n854: // The lane reports a real embedder cosine as \"cosine:\", while the word-overlap\n855: // stand-in used under test reports \"shadow:\". Only a real cosine may carry a\n856: // command on meaning, because the stand-in measures shared words rather than\n857: // shared meaning.\n858: function commandMeaningCosine(contribution: LaneContribution | undefined): number | null {\n859:   if (!contribution) return null;\n860:   return contribution.evidence.some((entry) => entry.startsWith('cosine:'))\n861:     ? contribution.rawScore\n862:     : null;\n863: }\n864: \n865: // A command bridge passes on its own wording: one of its authored phrases or its\n866: // runnable slash string, which the explicit-author lane reports. A bridge that\n867: // passed on shared single tokens alone stays scored but stops passing, because\n868: // its phrases are everyday words and a command must not be offered for a prompt\n869: // that merely shares some of them. A paraphrase shares no words at all, so the\n870: // second way in is meaning: a real prompt embedding that clears both bars above.\n871: // Meaning-passed ids are collected so a later ordering step can tell them apart,\n872: // and a doctor problem in other words reaches /doctor:helper through\n873: // applyDoctorHelperHandoff instead.\n874: // A question that only wants an answer must not be handed a command that\n875: // changes things, however close the meaning. Phrase matches are already held to\n876: // this by the read-only confidence floor, and a meaning match lifts confidence\n877: // past that floor, so it has to ask the same question itself. A command whose\n878: // route only reads stays eligible for a plain explainer, because running it is\n879: // the answer. An explicit no-edit request rules out every command.\n880: export function commandMeaningEligible(\n881:   promptLower: string,\n882:   readOnlyExplainer: boolean,\n883:   skill: SkillProjection | undefined,\n884: ): boolean {\n885:   if (NO_EDIT_REQUEST.test(promptLower)) return false;\n886:   if (!readOnlyExplainer) return true;\n887:   return skill !== undefined && skill.kind === 'command' && 'readOnly' in skill && skill.readOnly === true;\n888: }\n889: \n890: export function requireCommandPhraseAnchor(\n891:   ranked: readonly AdvisorScoredRecommendation[],\n892:   confidenceThreshold: number = DEFAULT_CONFIDENCE_THRESHOLD,\n893:   meaningPassed: Set<string> = new Set(),\n894:   meaningEligible: (skillId: string) => boolean = () => true,\n895: ): AdvisorScoredRecommendation[] {\n896:   const cosineByCommandId = new Map<string, number>();\n897:   for (const recommendation of ranked) {\n898:     if (recommendation.kind !== 'command') continue;\n899:     const cosine = commandMeaningCosine(\n900:       recommendation.laneContributions.find((contribution) => contribution.lane === 'semantic_shadow'),\n901:     );\n902:     if (cosine !== null) cosineByCommandId.set(recommendation.skill, cosine);\n903:   }\n904:   // A command row with no cosine counts as 0, so the bar is the strongest other\n905:   // command row, not the strongest row overall: a skill row never decides this.\n906:   const leadingOtherCosine = (skillId: string): number => {\n907:     let lead = 0;\n908:     for (const [otherSkillId, cosine] of cosineByCommandId) {\n909:       if (otherSkillId !== skillId && cosine > lead) lead = cosine;\n910:     }\n911:     return lead;\n912:   };\n913:   return ranked.map((recommendation) => {\n914:     if (recommendation.kind !== 'command') return recommendation;\n915:     const anchored = recommendation.laneContributions.some((contribution) => (\n916:       contribution.lane === 'explicit_author' && contribution.rawScore > 0\n917:     ));\n918:     if (anchored) return recommendation;\n919:     const cosine = cosineByCommandId.get(recommendation.skill);\n920:     if (cosine !== undefined\n921:       && cosine >= COMMAND_MEANING_MIN_COSINE\n922:       && cosine - leadingOtherCosine(recommendation.skill) >= COMMAND_MEANING_MARGIN\n923:       && meaningEligible(recommendation.skill)) {\n924:       // A meaning match alone rarely clears the threshold on its lane weight, so\n925:       // the anchor lifts the row to it rather than leaving it scored but unpassed.\n926:       meaningPassed.add(recommendation.skill);\n927:       return {\n928:         ...recommendation,\n929:         confidence: Math.max(recommendation.confidence, confidenceThreshold),\n930:         passes_threshold: true,\n931:       };\n932:     }\n933:     return recommendation.passes_threshold\n934:       ? { ...recommendation, passes_threshold: false }\n935:       : recommendation;\n936:   });\n937: }\n938: \n939: function findTypedDoctorCommandText(promptLower: string): string | null {\n940:   const prompt = promptLower.trim();\n941:   if (prompt.startsWith(DOCTOR_COMMAND_PREFIX)) {\n942:     return prompt.slice(DOCTOR_COMMAND_PREFIX.length);\n943:   }\n944: \n945:   const invocationPattern = /\\b(?:run|execute|start|launch|use|kick\\s+off)\\s+\\/doctor:/g;\n946:   let quote: \"'\" | '\"' | '`' | null = null;\n947:   let quoteScanPosition = 0;\n948:   let invocation: RegExpExecArray | null;\n949: \n950:   while ((invocation = invocationPattern.exec(prompt)) !== null) {\n951:     const commandPosition = (\n952:       invocation.index + invocation[0].length - DOCTOR_COMMAND_PREFIX.length\n953:     );\n954:     while (quoteScanPosition < commandPosition) {\n955:       const character = prompt.charAt(quoteScanPosition);\n956:       const isWordApostrophe = character === \"'\"\n957:         && /[a-z0-9]/.test(prompt.charAt(quoteScanPosition - 1))\n958:         && /[a-z0-9]/.test(prompt.charAt(quoteScanPosition + 1));\n959:       if (!isWordApostrophe) {\n960:         if (quote === null) {\n961:           if (character === \"'\" || character === '\"' || character === '`') {\n962:             quote = character;\n963:           }\n964:         } else if (character === quote) {\n965:           quote = null;\n966:         }\n967:       }\n968:       quoteScanPosition += 1;\n969:     }\n970:     if (quote === null) return prompt.slice(commandPosition + DOCTOR_COMMAND_PREFIX.length);\n971:   }\n972:   return null;\n973: }\n974: \n975: export function isDoctorCommandTyped(promptLower: string): boolean {\n976:   return findTypedDoctorCommandText(promptLower) !== null;\n977: }\n978: \n979: // A typed command or matching doctor lead phrase moves its passing bridge first; otherwise passing\n980: // bridges follow the second passing skill or the only passing skill, and other recommendations keep order.\n981: export function keepPassingSkillsAboveDoctorBridges(\n982:   ranked: readonly AdvisorScoredRecommendation[],\n983:   promptLower: string,\n984:   leadPhrasesById: ReadonlyMap<string, readonly string[]> = new Map(),\n985: ): AdvisorScoredRecommendation[] {\n986:   const isDoctorBridge = (recommendation: AdvisorScoredRecommendation): boolean => (\n987:     recommendation.kind === 'command' && recommendation.skill.startsWith(DOCTOR_BRIDGE_PREFIX)\n988:   );\n989:   const isPassingDoctorBridge = (recommendation: AdvisorScoredRecommendation): boolean => (\n990:     isDoctorBridge(recommendation) && recommendation.passes_threshold\n991:   );\n992:   const typedCommandText = findTypedDoctorCommandText(promptLower);\n993:   if (typedCommandText !== null) {\n994:     const normalizedCommand = typedCommandText.toLowerCase().trim().replace(/\\s+/g, '-');\n995:     let matchedBridgeIndex = -1;\n996:     let matchedBridgeLength = -1;\n997:     ranked.forEach((recommendation, index) => {\n998:       if (!isPassingDoctorBridge(recommendation)) return;\n999:       const bridgeName = recommendation.skill.slice(DOCTOR_BRIDGE_PREFIX.length);\n1000:       if (bridgeName.length === 0 || !normalizedCommand.startsWith(bridgeName)) return;\n1001:       const nextCharacter = normalizedCommand.charAt(bridgeName.length);\n1002:       const endsAtWordBoundary = (\n1003:         nextCharacter === '' || !/[a-z0-9_]/.test(nextCharacter)\n1004:       );\n1005:       if (!endsAtWordBoundary || bridgeName.length <= matchedBridgeLength) return;\n1006:       matchedBridgeIndex = index;\n1007:       matchedBridgeLength = bridgeName.length;\n1008:     });\n1009:     const matchedBridge = ranked[matchedBridgeIndex];\n1010:     if (!matchedBridge) return [...ranked];\n1011:     return [\n1012:       matchedBridge,\n1013:       ...ranked.slice(0, matchedBridgeIndex),\n1014:       ...ranked.slice(matchedBridgeIndex + 1),\n1015:     ];\n1016:   }\n1017: \n1018:   const leadPhraseBridgeIndex = ranked.findIndex((recommendation) => {\n1019:     if (!isPassingDoctorBridge(recommendation)) return false;\n1020:     return leadPhrasesById.get(recommendation.skill)?.some((phrase) => (\n1021:       matchesPhraseBoundary(promptLower, phrase.toLowerCase())\n1022:     )) ?? false;\n1023:   });\n1024:   const leadPhraseBridge = ranked[leadPhraseBridgeIndex];\n1025:   if (leadPhraseBridge) {\n1026:     return [\n1027:       leadPhraseBridge,\n1028:       ...ranked.slice(0, leadPhraseBridgeIndex),\n1029:       ...ranked.slice(leadPhraseBridgeIndex + 1),\n1030:     ];\n1031:   }\n1032: \n1033:   const passingSkillCount = ranked.filter((recommendation) => (\n1034:     recommendation.kind === 'skill' && recommendation.passes_threshold\n1035:   )).length;\n1036:   if (passingSkillCount === 0) return [...ranked];\n1037: \n1038:   const passingDoctorBridges = ranked.filter(isPassingDoctorBridge);\n1039:   if (passingDoctorBridges.length === 0) return [...ranked];\n1040:   const remaining = ranked.filter((recommendation) => !isPassingDoctorBridge(recommendation));\n1041:   const targetPassingSkillCount = Math.min(2, passingSkillCount);\n1042:   let seenPassingSkills = 0;\n1043:   let insertionIndex = remaining.length;\n1044:   for (const [index, recommendation] of remaining.entries()) {\n1045:     if (recommendation.kind !== 'skill' || !recommendation.passes_threshold) continue;\n1046:     seenPassingSkills += 1;\n1047:     if (seenPassingSkills === targetPassingSkillCount) {\n1048:       insertionIndex = index + 1;\n1049:       break;\n1050:     }\n1051:   }\n1052:   return [\n1053:     ...remaining.slice(0, insertionIndex),\n1054:     ...passingDoctorBridges,\n1055:     ...remaining.slice(insertionIndex),\n1056:   ];\n1057: }\n1058: \n[Output truncated. Continue reading with offset: 1059]"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/lib/scorer/fusion.ts\"}"},"time":{"start":1794528100395,"end":1794528100942}}}}
