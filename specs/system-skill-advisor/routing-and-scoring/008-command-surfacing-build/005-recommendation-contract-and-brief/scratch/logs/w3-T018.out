{"type":"tool_use","timestamp":1794527437190,"sessionID":"ses_e2dd8cae6ffeV3iKQc8fxV7h6K","part":{"partID":"prt_1d22b9ee6002LfSYh7bBY9vM07","sessionID":"ses_e2dd8cae6ffeV3iKQc8fxV7h6K","messageID":"msg_1d22b91c5001H29hjJo9ihIZ2B","type":"tool","id":"call_6336fedc31be41aa886519db","tool":"shell","state":{"status":"completed","input":{"command":"git -c core.fsmonitor=false diff -- .skilled/skills/system-skill-advisor/runtime/skill-advisor-cli.ts","workdir":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research"},"output":"diff --git a/.skilled/skills/system-skill-advisor/runtime/skill-advisor-cli.ts b/.skilled/skills/system-skill-advisor/runtime/skill-advisor-cli.ts\nindex fd418a294d..a73c6f2d71 100644\n--- a/.skilled/skills/system-skill-advisor/runtime/skill-advisor-cli.ts\n+++ b/.skilled/skills/system-skill-advisor/runtime/skill-advisor-cli.ts\n@@ -19,6 +19,7 @@ import {\n   type SkillAdvisorCliToolDefinition,\n } from './skill-advisor-cli-manifest.js';\n \n+import { commandRowFor } from './lib/command-attach.js';\n import { SKILL_ADVISOR_COMPAT_CONTRACT } from './lib/compat/contract.js';\n import { runAdvisorSubprocess, type AdvisorRecommendation } from './lib/subprocess.js';\n \n@@ -1473,15 +1474,55 @@ async function runLocalScorer(prompt: string): Promise<readonly AdvisorRecommend\n   }\n }\n \n-function degradedRecommendations(entries: readonly AdvisorRecommendation[]): Array<Record<string, unknown>> {\n-  return entries\n-    .filter((entry) => entry.passes_threshold === true)\n-    .map((entry) => ({\n-      skillId: entry.skill,\n+// The local scorer names command ids, but a reader can only act on a command they\n+// typed or on the skill that owns it. A row whose bare slash command appears in\n+// the prompt keeps its command fields, and every other row collapses to its owner\n+// skill so the degraded brief names a skill that exists instead of a raw row id.\n+export function degradedRecommendations(\n+  entries: readonly AdvisorRecommendation[],\n+  prompt: string,\n+): Array<Record<string, unknown>> {\n+  const offeredSkills = new Set<string>();\n+  const recommendations: Array<Record<string, unknown>> = [];\n+\n+  for (const entry of entries) {\n+    if (entry.passes_threshold !== true) continue;\n+    const base = {\n       confidence: entry.confidence,\n       uncertainty: entry.uncertainty,\n       reason: entry.reason ?? '',\n-    }));\n+    };\n+    const row = commandRowFor(entry.skill);\n+\n+    if (row && prompt.includes(row.command.split(' ')[0])) {\n+      recommendations.push({\n+        skillId: entry.skill,\n+        kind: 'command',\n+        command: row.command,\n+        ...(row.policy ? { policy: row.policy } : {}),\n+        ownerSkillId: row.ownerSkillId,\n+        ...base,\n+      });\n+      offeredSkills.add(entry.skill);\n+      continue;\n+    }\n+\n+    if (row) {\n+      if (offeredSkills.has(row.ownerSkillId)) continue;\n+      recommendations.push({\n+        skillId: row.ownerSkillId,\n+        kind: 'skill',\n+        ...base,\n+      });\n+      offeredSkills.add(row.ownerSkillId);\n+      continue;\n+    }\n+\n+    recommendations.push({ skillId: entry.skill, ...base });\n+    offeredSkills.add(entry.skill);\n+  }\n+\n+  return recommendations;\n }\n \n // Request options added after the daemon protocol was fixed, oldest first.\n@@ -1536,7 +1577,7 @@ async function invokeAdvisorRecommendPayload(\n         degraded: true,\n         source: LOCAL_SCORER_SOURCE,\n         data: {\n-          recommendations: degradedRecommendations(recommendations),\n+          recommendations: degradedRecommendations(recommendations, prompt),\n           effectiveThresholds: LOCAL_SCORER_THRESHOLDS,\n         },\n       },\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"diff --git a/.skilled/skills/system-skill-advisor/runtime/skill-advisor-cli.ts b/.skilled/skills/system-skill-advisor/runtime/skill-advisor-cli.ts\nindex fd418a294d..a73c6f2d71 100644\n--- a/.skilled/skills/system-skill-advisor/runtime/skill-advisor-cli.ts\n+++ b/.skilled/skills/system-skill-advisor/runtime/skill-advisor-cli.ts\n@@ -19,6 +19,7 @@ import {\n   type SkillAdvisorCliToolDefinition,\n } from './skill-advisor-cli-manifest.js';\n \n+import { commandRowFor } from './lib/command-attach.js';\n import { SKILL_ADVISOR_COMPAT_CONTRACT } from './lib/compat/contract.js';\n import { runAdvisorSubprocess, type AdvisorRecommendation } from './lib/subprocess.js';\n \n@@ -1473,15 +1474,55 @@ async function runLocalScorer(prompt: string): Promise<readonly AdvisorRecommend\n   }\n }\n \n-function degradedRecommendations(entries: readonly AdvisorRecommendation[]): Array<Record<string, unknown>> {\n-  return entries\n-    .filter((entry) => entry.passes_threshold === true)\n-    .map((entry) => ({\n-      skillId: entry.skill,\n+// The local scorer names command ids, but a reader can only act on a command they\n+// typed or on the skill that owns it. A row whose bare slash command appears in\n+// the prompt keeps its command fields, and every other row collapses to its owner\n+// skill so the degraded brief names a skill that exists instead of a raw row id.\n+export function degradedRecommendations(\n+  entries: readonly AdvisorRecommendation[],\n+  prompt: string,\n+): Array<Record<string, unknown>> {\n+  const offeredSkills = new Set<string>();\n+  const recommendations: Array<Record<string, unknown>> = [];\n+\n+  for (const entry of entries) {\n+    if (entry.passes_threshold !== true) continue;\n+    const base = {\n       confidence: entry.confidence,\n       uncertainty: entry.uncertainty,\n       reason: entry.reason ?? '',\n-    }));\n+    };\n+    const row = commandRowFor(entry.skill);\n+\n+    if (row && prompt.includes(row.command.split(' ')[0])) {\n+      recommendations.push({\n+        skillId: entry.skill,\n+        kind: 'command',\n+        command: row.command,\n+        ...(row.policy ? { policy: row.policy } : {}),\n+        ownerSkillId: row.ownerSkillId,\n+        ...base,\n+      });\n+      offeredSkills.add(entry.skill);\n+      continue;\n+    }\n+\n+    if (row) {\n+      if (offeredSkills.has(row.ownerSkillId)) continue;\n+      recommendations.push({\n+        skillId: row.ownerSkillId,\n+        kind: 'skill',\n+        ...base,\n+      });\n+      offeredSkills.add(row.ownerSkillId);\n+      continue;\n+    }\n+\n+    recommendations.push({ skillId: entry.skill, ...base });\n+    offeredSkills.add(entry.skill);\n+  }\n+\n+  return recommendations;\n }\n \n // Request options added after the daemon protocol was fixed, oldest first.\n@@ -1536,7 +1577,7 @@ async function invokeAdvisorRecommendPayload(\n         degraded: true,\n         source: LOCAL_SCORER_SOURCE,\n         data: {\n-          recommendations: degradedRecommendations(recommendations),\n+          recommendations: degradedRecommendations(recommendations, prompt),\n           effectiveThresholds: LOCAL_SCORER_THRESHOLDS,\n         },\n       },\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"git -c core.fsmonitor=false diff -- .skilled/skills/system-skill-advisor/runtime/skill-advisor-cli.ts\",\"workdir\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research\"}"},"time":{"start":1794527436518,"end":1794527437190}}}}
