 took the\\n1325: // connection and stayed silent, the one failure still worth waiting out on the caller's\\n1326: // own timeout. Every other reason — absent socket, refused connection, a handshake that\\n1327: // errored or closed before replying — is a daemon that is simply not running yet, so the\\n1328: // call starts it and waits, bounded: a caller that can also answer without the daemon\\n1329: // must not be held for the whole tool timeout by one that never accepts a connection.\\n1330: function probeTimedOut(probe: BridgeProbeResult): boolean {\\n1331:   return /timeout/i.test(probe.reason ?? '');\\n1332: }\\n1333: \\n1334: async function ensureDaemonReady(\\n1335:   socketPath: string,\\n1336:   bridge: BridgeModule,\\n1337:   paths: RepoPaths,\\n1338:   timeoutMs: number,\\n1339:   warmOnly: boolean,\\n1340:   hasLocalFallback: boolean,\\n1341: ): Promise<void> {\\n1342:   const initialProbe = await bridge.probeDaemon(socketPath, { timeoutMs: Math.min(timeoutMs, 5000), deepProbe: true });\\n1343:   if (initialProbe.status === 'alive') {\\n1344:     if (warmOnly || !liveDaemonPredatesBuild(paths)) return;\\n1345:     await waitForStaleDaemonRecycle(paths, timeoutMs, spawnLauncher(paths));\\n1346:     await waitForDaemon(so... (line truncated to 2000 chars)\n12: {\"type\":\"step_finish\",\"timestamp\":1794527184762,\"sessionID\":\"ses_e2dd8cae6ffeV3iKQc8fxV7h6K\",\"part\":{\"id\":\"prt_1d227c77a001DEhnvcipz6dInO\",\"sessionID\":\"ses_e2dd8cae6ffeV3iKQc8fxV7h6K\",\"messageID\":\"msg_1d227b38e001GmvShCtR7nY7MN\",\"type\":\"step-finish\",\"reason\":\"tool-calls\",\"snapshot\":\"1eefd423409cac5901bb40a2062024850a1e5869\",\"cost\":0,\"tokens\":{\"input\":16635,\"output\":111,\"reasoning\":0,\"cache\":{\"read\":27648,\"write\":0}}}}\n13: {\"type\":\"step_start\",\"timestamp\":1794527186768,\"sessionID\":\"ses_e2dd8cae6ffeV3iKQc8fxV7h6K\",\"part\":{\"id\":\"prt_1d227cf50001pebxO2usKKi204\",\"sessionID\":\"ses_e2dd8cae6ffeV3iKQc8fxV7h6K\",\"messageID\":\"msg_1d227c