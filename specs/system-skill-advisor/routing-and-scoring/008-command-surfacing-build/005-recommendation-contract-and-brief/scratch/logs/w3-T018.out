,"rawInput":"{\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/skill-advisor-cli.ts\",\"offset\":1470,\"limit\":65}"},"time":{"start":1794527453406,"end":1794527453996}}}}
