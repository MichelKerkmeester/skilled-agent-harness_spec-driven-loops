visor/runtime/skill-advisor-cli.ts (1 replacement)"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/skill-advisor-cli.ts\",\"oldString\":\"import { SKILL_ADVISOR_COMPAT_CONTRACT } from './lib/compat/contract.js';\\nimport { runAdvisorSubprocess, type AdvisorRecommendation } from './lib/subprocess.js';\",\"newString\":\"import { commandRowFor } from './lib/command-attach.js';\\nimport { SKILL_ADVISOR_COMPAT_CONTRACT } from './lib/compat/contract.js';\\nimport { runAdvisorSubprocess, type AdvisorRecommendation } from './lib/subprocess.js';\"}"},"time":{"start":1794527389242,"end":1794527390292}}}}
