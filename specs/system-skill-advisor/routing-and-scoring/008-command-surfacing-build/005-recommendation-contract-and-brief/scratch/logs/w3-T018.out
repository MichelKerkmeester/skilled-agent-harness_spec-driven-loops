{"type":"tool_use","timestamp":1794527189956,"sessionID":"ses_e2dd8cae6ffeV3iKQc8fxV7h6K","part":{"partID":"prt_1d227da2100101QyLuQ5MFto5q","sessionID":"ses_e2dd8cae6ffeV3iKQc8fxV7h6K","messageID":"msg_1d227c77f001voG45Vp4BMTACM","type":"tool","id":"call_ab70b3227fa9420c940543f1","tool":"read","state":{"status":"completed","input":{"path":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/lib/command-attach.ts"},"output":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/lib/command-attach.ts, lines 1-265\n1: // ───────────────────────────────────────────────────────────────\n2: // MODULE: Slash command attached to a hub's recommendation\n3: // ───────────────────────────────────────────────────────────────\n4: //\n5: // The advisor can name the workflow mode a hub would route a prompt to, but the\n6: // reader still has to translate that mode into the slash command that acts on\n7: // it. This module owns that translation and nothing else, kept free of imports\n8: // so the recommend path and a test read the same semantics.\n9: //\n10: // The mode-to-command table is generated rather than hand-maintained: each row is\n11: // derived from a hub's own command files, so a hub that adds or renames a mode\n12: // regenerates its row instead of drifting from a copy someone forgot to update.\n13: \n14: // BEGIN GENERATED MODE COMMANDS\n15: export const MODE_COMMANDS: Readonly<Record<string, Readonly<Record<string, string>>>> = {\n16:   'sk-design': {\n17:     'sk-design-chart': '/design:chart',\n18:     'sk-design-diagram': '/design:diagram',\n19:     'sk-design-md-generator': '/design:extract',\n20:   },\n21:   'sk-doc': {\n22:     'sk-create-agent': '/create:agent',\n23:     'sk-create-benchmark': '/create:benchmark',\n24:     'sk-create-changelog': '/create:changelog',\n25:     'sk-create-command': '/create:command',\n26:     'sk-create-diff': '/create:diff',\n27:     'sk-create-feature-catalog': '/create:feature-catalog',\n28:     'sk-create-goal': '/create:goal',\n29:     'sk-create-manual-testing-playbook': '/create:manual-testing-playbook',\n30:     'sk-create-readme': '/create:readme',\n31:     'sk-create-repo-rule': '/create:repo-rule',\n32:     'sk-create-skill': '/create:skill',\n33:     'sk-create-skill-parent': '/create:skill-parent',\n34:     'sk-create-with-human-voice': '/create:with-human-voice',\n35:   },\n36:   'system-deep-loop': {\n37:     'ai-council': '/deep:ai-council',\n38:     'research': '/deep:research',\n39:     'review': '/deep:review',\n40:   },\n41: };\n42: // END GENERATED MODE COMMANDS\n43: \n44: // One row of the command table: the runnable slash command, the policy that says\n45: // whether it runs, asks or starts a session, and the skill that owns it. The\n46: // rows are generated, so only the shape lives here.\n47: export interface CommandRow {\n48:   readonly command: string;\n49:   readonly policy?: 'run' | 'start' | 'ask';\n50:   readonly ownerSkillId: string;\n51: }\n52: \n53: // BEGIN GENERATED COMMAND ROWS\n54: export const COMMAND_ROWS: Readonly<Record<string, CommandRow>> = {\n55:   'command-create-agent': { command: '/create:agent', policy: 'start', ownerSkillId: 'sk-doc' },\n56:   'command-create-changelog': { command: '/create:changelog', policy: 'ask', ownerSkillId: 'sk-doc' },\n57:   'command-create-feature-catalog': { command: '/create:feature-catalog', policy: 'start', ownerSkillId: 'sk-doc' },\n58:   'command-create-manual-testing-playbook': { command: '/create:manual-testing-playbook', policy: 'start', ownerSkillId: 'sk-doc' },\n59:   'command-create-readme': { command: '/create:readme', policy: 'start', ownerSkillId: 'sk-doc' },\n60:   'command-create-skill': { command: '/create:skill', policy: 'start', ownerSkillId: 'sk-doc' },\n61:   'command-deep-research': { command: '/deep:research', policy: 'ask', ownerSkillId: 'system-deep-loop' },\n62:   'command-deep-review': { command: '/deep:review', policy: 'ask', ownerSkillId: 'system-deep-loop' },\n63:   'command-doctor-agents-md-check': { command: '/doctor:agents-md check', policy: 'run', ownerSkillId: 'system-skilled-doctor' },\n64:   'command-doctor-agents-md-embed': { command: '/doctor:agents-md embed', policy: 'ask', ownerSkillId: 'system-skilled-doctor' },\n65:   'command-doctor-agents-md-restore': { command: '/doctor:agents-md restore', policy: 'ask', ownerSkillId: 'system-skilled-doctor' },\n66:   'command-doctor-ci-report': { command: '/doctor:ci report', policy: 'run', ownerSkillId: 'sk-code' },\n67:   'command-doctor-ci-scaffold': { command: '/doctor:ci scaffold', policy: 'ask', ownerSkillId: 'sk-code' },\n68:   'command-doctor-ci-toggle': { command: '/doctor:ci toggle', policy: 'ask', ownerSkillId: 'sk-code' },\n69:   'command-doctor-deep-loop': { command: '/doctor:deep-loop', policy: 'run', ownerSkillId: 'system-deep-loop' },\n70:   'command-doctor-env': { command: '/doctor:env list', policy: 'run', ownerSkillId: 'system-skilled-doctor' },\n71:   'command-doctor-git-hooks': { command: '/doctor:git hooks', policy: 'ask', ownerSkillId: 'sk-git' },\n72:   'command-doctor-git-setup': { command: '/doctor:git setup', policy: 'run', ownerSkillId: 'sk-git' },\n73:   'command-doctor-git-standards': { command: '/doctor:git standards', policy: 'ask', ownerSkillId: 'sk-git' },\n74:   'command-doctor-helper': { command: '/doctor:helper', policy: 'run', ownerSkillId: 'system-skilled-doctor' },\n75:   'command-doctor-install': { command: '/doctor:install', policy: 'run', ownerSkillId: 'system-skilled-doctor' },\n76:   'command-doctor-mcp-debug': { command: '/doctor:mcp debug', policy: 'ask', ownerSkillId: 'system-skilled-doctor' },\n77:   'command-doctor-mcp-install': { command: '/doctor:mcp install', policy: 'ask', ownerSkillId: 'system-skilled-doctor' },\n78:   'command-doctor-overlay-apply': { command: '/doctor:overlay apply', policy: 'ask', ownerSkillId: 'system-skilled-doctor' },\n79:   'command-doctor-overlay-repin': { command: '/doctor:overlay repin', policy: 'ask', ownerSkillId: 'system-skilled-doctor' },\n80:   'command-doctor-overlay-status': { command: '/doctor:overlay status', policy: 'run', ownerSkillId: 'system-skilled-doctor' },\n81:   'command-doctor-runtime-mirrors': { command: '/doctor:runtime-mirrors', policy: 'run', ownerSkillId: 'system-skilled-doctor' },\n82:   'command-doctor-setup': { command: '/doctor:setup', policy: 'run', ownerSkillId: 'system-skilled-doctor' },\n83:   'command-doctor-sk-code-quality': { command: '/doctor:sk-code quality', policy: 'ask', ownerSkillId: 'sk-code' },\n84:   'command-doctor-sk-code-setup': { command: '/doctor:sk-code setup', policy: 'run', ownerSkillId: 'sk-code' },\n85:   'command-doctor-sk-skill-check': { command: '/doctor:sk-skill check', policy: 'run', ownerSkillId: 'sk-doc' },\n86:   'command-doctor-sk-skill-convert': { command: '/doctor:sk-skill convert', policy: 'ask', ownerSkillId: 'sk-doc' },\n87:   'command-doctor-skill-advisor-parent-skill': { command: '/doctor:skill-advisor parent-skill', policy: 'run', ownerSkillId: 'system-skill-advisor' },\n88:   'command-doctor-skill-advisor-rebuild': { command: '/doctor:skill-advisor rebuild', policy: 'ask', ownerSkillId: 'system-skill-advisor' },\n89:   'command-doctor-skill-advisor-router-reach': { command: '/doctor:skill-advisor router-reach', policy: 'run', ownerSkillId: 'system-skill-advisor' },\n90:   'command-doctor-skill-advisor-skill-budget': { command: '/doctor:skill-advisor skill-budget', policy: 'run', ownerSkillId: 'system-skill-advisor' },\n91:   'command-doctor-skill-advisor-skill-graph-freshness': { command: '/doctor:skill-advisor skill-graph-freshness', policy: 'run', ownerSkillId: 'system-skill-advisor' },\n92:   'command-doctor-skill-advisor-tune': { command: '/doctor:skill-advisor tune', policy: 'ask', ownerSkillId: 'system-skill-advisor' },\n93:   'command-doctor-speckit': { command: '/doctor:speckit', policy: 'run', ownerSkillId: 'system-skilled-doctor' },\n94:   'command-doctor-symlink-check': { command: '/doctor:symlink check', policy: 'run', ownerSkillId: 'system-skilled-doctor' },\n95:   'command-doctor-symlink-link': { command: '/doctor:symlink link', policy: 'ask', ownerSkillId: 'system-skilled-doctor' },\n96:   'command-doctor-symlink-unlink': { command: '/doctor:symlink unlink', policy: 'ask', ownerSkillId: 'system-skilled-doctor' },\n97:   'command-doctor-update': { command: '/doctor:update', policy: 'ask', ownerSkillId: 'system-skilled-doctor' },\n98:   'command-prompt-improve': { command: '/prompt:improve', policy: 'start', ownerSkillId: 'sk-prompt' },\n99:   'command-spec-kit-complete': { command: '/speckit:complete', policy: 'start', ownerSkillId: 'system-spec-kit' },\n100:   'command-spec-kit-deep-research': { command: '/deep:research', policy: 'ask', ownerSkillId: 'system-deep-loop' },\n101:   'command-spec-kit-deep-review': { command: '/deep:review', policy: 'ask', ownerSkillId: 'system-deep-loop' },\n102:   'command-spec-kit-implement': { command: '/speckit:implement', policy: 'start', ownerSkillId: 'system-spec-kit' },\n103:   'command-spec-kit-plan': { command: '/speckit:plan', policy: 'start', ownerSkillId: 'system-spec-kit' },\n104:   'command-spec-kit-resume': { command: '/speckit:resume', policy: 'start', ownerSkillId: 'system-spec-kit' },\n105:   'command-speckit-handoff': { command: '/speckit:handoff', policy: 'ask', ownerSkillId: 'system-spec-kit' },\n106:   'command-speckit-save': { command: '/speckit:save', policy: 'start', ownerSkillId: 'system-spec-kit' },\n107:   'command-speckit-search': { command: '/speckit:search', policy: 'run', ownerSkillId: 'system-spec-kit' },\n108:   'create:agent': { command: '/create:agent', policy: 'start', ownerSkillId: 'sk-doc' },\n109:   'create:manual-testing-playbook': { command: '/create:manual-testing-playbook', policy: 'start', ownerSkillId: 'sk-doc' },\n110: };\n111: export const COMMAND_POLICIES: Readonly<Record<string, 'run' | 'start' | 'ask'>> = {\n112:   '/create:agent': 'start',\n113:   '/create:changelog': 'ask',\n114:   '/create:feature-catalog': 'start',\n115:   '/create:manual-testing-playbook': 'start',\n116:   '/create:readme': 'start',\n117:   '/create:skill': 'start',\n118:   '/deep:research': 'ask',\n119:   '/deep:review': 'ask',\n120:   '/doctor:agents-md check': 'run',\n121:   '/doctor:agents-md embed': 'ask',\n122:   '/doctor:agents-md restore': 'ask',\n123:   '/doctor:ci report': 'run',\n124:   '/doctor:ci scaffold': 'ask',\n125:   '/doctor:ci toggle': 'ask',\n126:   '/doctor:deep-loop': 'run',\n127:   '/doctor:env list': 'run',\n128:   '/doctor:git hooks': 'ask',\n129:   '/doctor:git setup': 'run',\n130:   '/doctor:git standards': 'ask',\n131:   '/doctor:helper': 'run',\n132:   '/doctor:install': 'run',\n133:   '/doctor:mcp debug': 'ask',\n134:   '/doctor:mcp install': 'ask',\n135:   '/doctor:overlay apply': 'ask',\n136:   '/doctor:overlay repin': 'ask',\n137:   '/doctor:overlay status': 'run',\n138:   '/doctor:runtime-mirrors': 'run',\n139:   '/doctor:setup': 'run',\n140:   '/doctor:sk-code quality': 'ask',\n141:   '/doctor:sk-code setup': 'run',\n142:   '/doctor:sk-skill check': 'run',\n143:   '/doctor:sk-skill convert': 'ask',\n144:   '/doctor:skill-advisor parent-skill': 'run',\n145:   '/doctor:skill-advisor rebuild': 'ask',\n146:   '/doctor:skill-advisor router-reach': 'run',\n147:   '/doctor:skill-advisor skill-budget': 'run',\n148:   '/doctor:skill-advisor skill-graph-freshness': 'run',\n149:   '/doctor:skill-advisor tune': 'ask',\n150:   '/doctor:speckit': 'run',\n151:   '/doctor:symlink check': 'run',\n152:   '/doctor:symlink link': 'ask',\n153:   '/doctor:symlink unlink': 'ask',\n154:   '/doctor:update': 'ask',\n155:   '/prompt:improve': 'start',\n156:   '/speckit:complete': 'start',\n157:   '/speckit:handoff': 'ask',\n158:   '/speckit:implement': 'start',\n159:   '/speckit:plan': 'start',\n160:   '/speckit:resume': 'start',\n161:   '/speckit:save': 'start',\n162:   '/speckit:search': 'run',\n163: };\n164: // END GENERATED COMMAND ROWS\n165: \n166: // The row for an id a recommendation carries, or undefined when that id names no\n167: // command. Own-key lookup because the table is generated data, so an inherited\n168: // name such as `constructor` must not resolve to a row nobody declared.\n169: export function commandRowFor(id: string): CommandRow | undefined {\n170:   return Object.hasOwn(COMMAND_ROWS, id) ? COMMAND_ROWS[id] : undefined;\n171: }\n172: \n173: // Deep-loop commands open a long, multi-pass run, so one attached to a prompt\n174: // that merely mentions the topic spends the reader's budget on work they never\n175: // asked for. The list below is the vocabulary that counts as asking for it, and\n176: // it holds only effort wording: a bare topic word such as `research`, `review`\n177: // or `council` says what to look at, never how far to go, so it never qualifies\n178: // on its own.\n179: //\n180: // The phrases live in a data list, one per line, so the vocabulary a reviewer\n181: // has to judge stays visible and cheap to correct.\n182: export const DEPTH_WORDING: readonly string[] = [\n183:   'in depth',\n184:   'deep dive',\n185:   'deep research',\n186:   'deep review',\n187:   'thorough',\n188:   'thoroughly',\n189:   'exhaustive',\n190:   'iteratively',\n191:   'multiple passes',\n192:   'many passes',\n193:   'several passes',\n194:   'ask the council',\n195:   'convene',\n196:   'several models',\n197:   'final verdict',\n198:   'everything you can',\n199: ];\n200: \n201: // A phrase may carry punctuation a regex would read as a metacharacter, so it is\n202: // escaped before it is trusted as a pattern.\n203: function escapePhrase(phrase: string): string {\n204:   return phrase.replace(/[.*+?^${}()|[\\]\\\\]/g, '\\\\$&');\n205: }\n206: \n207: // One alternation over the list keeps the gate a single test per prompt, and the\n208: // boundary markers keep `thorough` from firing inside a longer word while a\n209: // multi-word phrase still has to match as a whole.\n210: const DEPTH_REQUEST = new RegExp(`\\\\b(?:${DEPTH_WORDING.map(escapePhrase).join('|')})\\\\b`);\n211: \n212: // A compiled route arrives as unvalidated JSON from a separate process, so the\n213: // shape is narrowed here rather than trusted. Arrays count as objects in\n214: // JavaScript and would let `action` read off an unrelated field, so they are\n215: // excluded explicitly.\n216: function asRecord(value: unknown): Record<string, unknown> | undefined {\n217:   if (typeof value !== 'object' || value === null || Array.isArray(value)) return undefined;\n218:   return value as Record<string, unknown>;\n219: }\n220: \n221: // The command for a hub's recommendation, or undefined when the route does not\n222: // single out one mode. Only a single-mode route names a command unambiguously:\n223: // a bundle or a multi-target route has more than one answer, and asking the\n224: // reader to pick belongs to the recommend path, not here. Never throws, because\n225: // a missing command must degrade to \"no command offered\" rather than break\n226: // routing. The prompt decides whether a costly deep-loop command is offered at\n227: // all: a reader who only asks about the topic gets no command, rather than one\n228: // that would launch work they never requested.\n229: export function attachCommand(\n230:   skillId: string,\n231:   compiledRoute: unknown,\n232:   prompt: string,\n233:   modeCommands: Readonly<Record<string, Readonly<Record<string, string>>>> = MODE_COMMANDS,\n234: ): string | undefined {\n235:   const route = asRecord(compiledRoute);\n236:   if (!route) return undefined;\n237:   if (route.action !== 'route' || route.selectionKind !== 'single') return undefined;\n238: \n239:   const targets = route.targets;\n240:   if (!Array.isArray(targets) || targets.length !== 1) return undefined;\n241: \n242:   const onlyTarget = asRecord(targets[0]);\n243:   if (!onlyTarget) return undefined;\n244: \n245:   const workflowMode = onlyTarget.workflowMode;\n246:   if (typeof workflowMode !== 'string' || workflowMode === '') return undefined;\n247: \n248:   // Own-key lookup on both levels: the table is data read from a generated\n249:   // object, so an inherited name such as `constructor` must not resolve to a\n250:   // command the hub never declared.\n251:   if (!Object.prototype.hasOwnProperty.call(modeCommands, skillId)) return undefined;\n252:   const commands = modeCommands[skillId];\n253:   if (!Object.prototype.hasOwnProperty.call(commands, workflowMode)) return undefined;\n254: \n255:   // Deep-loop commands are the ones that commit the reader to a long, multi-pass\n256:   // run, so they are offered only when the prompt asks for that effort. Typing\n257:   // the slash command is itself the ask, and every other hub answers a short\n258:   // question with a short answer, so no other skill consults the wording list.\n259:   if (skillId === 'system-deep-loop') {\n260:     const lowered = prompt.toLowerCase();\n261:     if (!lowered.includes('/deep:') && !DEPTH_REQUEST.test(lowered)) return undefined;\n262:   }\n263: \n264:   return commands[workflowMode];\n265: }","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/lib/command-attach.ts, lines 1-265\n1: // ───────────────────────────────────────────────────────────────\n2: // MODULE: Slash command attached to a hub's recommendation\n3: // ───────────────────────────────────────────────────────────────\n4: //\n5: // The advisor can name the workflow mode a hub would route a prompt to, but the\n6: // reader still has to translate that mode into the slash command that acts on\n7: // it. This module owns that translation and nothing else, kept free of imports\n8: // so the recommend path and a test read the same semantics.\n9: //\n10: // The mode-to-command table is generated rather than hand-maintained: each row is\n11: // derived from a hub's own command files, so a hub that adds or renames a mode\n12: // regenerates its row instead of drifting from a copy someone forgot to update.\n13: \n14: // BEGIN GENERATED MODE COMMANDS\n15: export const MODE_COMMANDS: Readonly<Record<string, Readonly<Record<string, string>>>> = {\n16:   'sk-design': {\n17:     'sk-design-chart': '/design:chart',\n18:     'sk-design-diagram': '/design:diagram',\n19:     'sk-design-md-generator': '/design:extract',\n20:   },\n21:   'sk-doc': {\n22:     'sk-create-agent': '/create:agent',\n23:     'sk-create-benchmark': '/create:benchmark',\n24:     'sk-create-changelog': '/create:changelog',\n25:     'sk-create-command': '/create:command',\n26:     'sk-create-diff': '/create:diff',\n27:     'sk-create-feature-catalog': '/create:feature-catalog',\n28:     'sk-create-goal': '/create:goal',\n29:     'sk-create-manual-testing-playbook': '/create:manual-testing-playbook',\n30:     'sk-create-readme': '/create:readme',\n31:     'sk-create-repo-rule': '/create:repo-rule',\n32:     'sk-create-skill': '/create:skill',\n33:     'sk-create-skill-parent': '/create:skill-parent',\n34:     'sk-create-with-human-voice': '/create:with-human-voice',\n35:   },\n36:   'system-deep-loop': {\n37:     'ai-council': '/deep:ai-council',\n38:     'research': '/deep:research',\n39:     'review': '/deep:review',\n40:   },\n41: };\n42: // END GENERATED MODE COMMANDS\n43: \n44: // One row of the command table: the runnable slash command, the policy that says\n45: // whether it runs, asks or starts a session, and the skill that owns it. The\n46: // rows are generated, so only the shape lives here.\n47: export interface CommandRow {\n48:   readonly command: string;\n49:   readonly policy?: 'run' | 'start' | 'ask';\n50:   readonly ownerSkillId: string;\n51: }\n52: \n53: // BEGIN GENERATED COMMAND ROWS\n54: export const COMMAND_ROWS: Readonly<Record<string, CommandRow>> = {\n55:   'command-create-agent': { command: '/create:agent', policy: 'start', ownerSkillId: 'sk-doc' },\n56:   'command-create-changelog': { command: '/create:changelog', policy: 'ask', ownerSkillId: 'sk-doc' },\n57:   'command-create-feature-catalog': { command: '/create:feature-catalog', policy: 'start', ownerSkillId: 'sk-doc' },\n58:   'command-create-manual-testing-playbook': { command: '/create:manual-testing-playbook', policy: 'start', ownerSkillId: 'sk-doc' },\n59:   'command-create-readme': { command: '/create:readme', policy: 'start', ownerSkillId: 'sk-doc' },\n60:   'command-create-skill': { command: '/create:skill', policy: 'start', ownerSkillId: 'sk-doc' },\n61:   'command-deep-research': { command: '/deep:research', policy: 'ask', ownerSkillId: 'system-deep-loop' },\n62:   'command-deep-review': { command: '/deep:review', policy: 'ask', ownerSkillId: 'system-deep-loop' },\n63:   'command-doctor-agents-md-check': { command: '/doctor:agents-md check', policy: 'run', ownerSkillId: 'system-skilled-doctor' },\n64:   'command-doctor-agents-md-embed': { command: '/doctor:agents-md embed', policy: 'ask', ownerSkillId: 'system-skilled-doctor' },\n65:   'command-doctor-agents-md-restore': { command: '/doctor:agents-md restore', policy: 'ask', ownerSkillId: 'system-skilled-doctor' },\n66:   'command-doctor-ci-report': { command: '/doctor:ci report', policy: 'run', ownerSkillId: 'sk-code' },\n67:   'command-doctor-ci-scaffold': { command: '/doctor:ci scaffold', policy: 'ask', ownerSkillId: 'sk-code' },\n68:   'command-doctor-ci-toggle': { command: '/doctor:ci toggle', policy: 'ask', ownerSkillId: 'sk-code' },\n69:   'command-doctor-deep-loop': { command: '/doctor:deep-loop', policy: 'run', ownerSkillId: 'system-deep-loop' },\n70:   'command-doctor-env': { command: '/doctor:env list', policy: 'run', ownerSkillId: 'system-skilled-doctor' },\n71:   'command-doctor-git-hooks': { command: '/doctor:git hooks', policy: 'ask', ownerSkillId: 'sk-git' },\n72:   'command-doctor-git-setup': { command: '/doctor:git setup', policy: 'run', ownerSkillId: 'sk-git' },\n73:   'command-doctor-git-standards': { command: '/doctor:git standards', policy: 'ask', ownerSkillId: 'sk-git' },\n74:   'command-doctor-helper': { command: '/doctor:helper', policy: 'run', ownerSkillId: 'system-skilled-doctor' },\n75:   'command-doctor-install': { command: '/doctor:install', policy: 'run', ownerSkillId: 'system-skilled-doctor' },\n76:   'command-doctor-mcp-debug': { command: '/doctor:mcp debug', policy: 'ask', ownerSkillId: 'system-skilled-doctor' },\n77:   'command-doctor-mcp-install': { command: '/doctor:mcp install', policy: 'ask', ownerSkillId: 'system-skilled-doctor' },\n78:   'command-doctor-overlay-apply': { command: '/doctor:overlay apply', policy: 'ask', ownerSkillId: 'system-skilled-doctor' },\n79:   'command-doctor-overlay-repin': { command: '/doctor:overlay repin', policy: 'ask', ownerSkillId: 'system-skilled-doctor' },\n80:   'command-doctor-overlay-status': { command: '/doctor:overlay status', policy: 'run', ownerSkillId: 'system-skilled-doctor' },\n81:   'command-doctor-runtime-mirrors': { command: '/doctor:runtime-mirrors', policy: 'run', ownerSkillId: 'system-skilled-doctor' },\n82:   'command-doctor-setup': { command: '/doctor:setup', policy: 'run', ownerSkillId: 'system-skilled-doctor' },\n83:   'command-doctor-sk-code-quality': { command: '/doctor:sk-code quality', policy: 'ask', ownerSkillId: 'sk-code' },\n84:   'command-doctor-sk-code-setup': { command: '/doctor:sk-code setup', policy: 'run', ownerSkillId: 'sk-code' },\n85:   'command-doctor-sk-skill-check': { command: '/doctor:sk-skill check', policy: 'run', ownerSkillId: 'sk-doc' },\n86:   'command-doctor-sk-skill-convert': { command: '/doctor:sk-skill convert', policy: 'ask', ownerSkillId: 'sk-doc' },\n87:   'command-doctor-skill-advisor-parent-skill': { command: '/doctor:skill-advisor parent-skill', policy: 'run', ownerSkillId: 'system-skill-advisor' },\n88:   'command-doctor-skill-advisor-rebuild': { command: '/doctor:skill-advisor rebuild', policy: 'ask', ownerSkillId: 'system-skill-advisor' },\n89:   'command-doctor-skill-advisor-router-reach': { command: '/doctor:skill-advisor router-reach', policy: 'run', ownerSkillId: 'system-skill-advisor' },\n90:   'command-doctor-skill-advisor-skill-budget': { command: '/doctor:skill-advisor skill-budget', policy: 'run', ownerSkillId: 'system-skill-advisor' },\n91:   'command-doctor-skill-advisor-skill-graph-freshness': { command: '/doctor:skill-advisor skill-graph-freshness', policy: 'run', ownerSkillId: 'system-skill-advisor' },\n92:   'command-doctor-skill-advisor-tune': { command: '/doctor:skill-advisor tune', policy: 'ask', ownerSkillId: 'system-skill-advisor' },\n93:   'command-doctor-speckit': { command: '/doctor:speckit', policy: 'run', ownerSkillId: 'system-skilled-doctor' },\n94:   'command-doctor-symlink-check': { command: '/doctor:symlink check', policy: 'run', ownerSkillId: 'system-skilled-doctor' },\n95:   'command-doctor-symlink-link': { command: '/doctor:symlink link', policy: 'ask', ownerSkillId: 'system-skilled-doctor' },\n96:   'command-doctor-symlink-unlink': { command: '/doctor:symlink unlink', policy: 'ask', ownerSkillId: 'system-skilled-doctor' },\n97:   'command-doctor-update': { command: '/doctor:update', policy: 'ask', ownerSkillId: 'system-skilled-doctor' },\n98:   'command-prompt-improve': { command: '/prompt:improve', policy: 'start', ownerSkillId: 'sk-prompt' },\n99:   'command-spec-kit-complete': { command: '/speckit:complete', policy: 'start', ownerSkillId: 'system-spec-kit' },\n100:   'command-spec-kit-deep-research': { command: '/deep:research', policy: 'ask', ownerSkillId: 'system-deep-loop' },\n101:   'command-spec-kit-deep-review': { command: '/deep:review', policy: 'ask', ownerSkillId: 'system-deep-loop' },\n102:   'command-spec-kit-implement': { command: '/speckit:implement', policy: 'start', ownerSkillId: 'system-spec-kit' },\n103:   'command-spec-kit-plan': { command: '/speckit:plan', policy: 'start', ownerSkillId: 'system-spec-kit' },\n104:   'command-spec-kit-resume': { command: '/speckit:resume', policy: 'start', ownerSkillId: 'system-spec-kit' },\n105:   'command-speckit-handoff': { command: '/speckit:handoff', policy: 'ask', ownerSkillId: 'system-spec-kit' },\n106:   'command-speckit-save': { command: '/speckit:save', policy: 'start', ownerSkillId: 'system-spec-kit' },\n107:   'command-speckit-search': { command: '/speckit:search', policy: 'run', ownerSkillId: 'system-spec-kit' },\n108:   'create:agent': { command: '/create:agent', policy: 'start', ownerSkillId: 'sk-doc' },\n109:   'create:manual-testing-playbook': { command: '/create:manual-testing-playbook', policy: 'start', ownerSkillId: 'sk-doc' },\n110: };\n111: export const COMMAND_POLICIES: Readonly<Record<string, 'run' | 'start' | 'ask'>> = {\n112:   '/create:agent': 'start',\n113:   '/create:changelog': 'ask',\n114:   '/create:feature-catalog': 'start',\n115:   '/create:manual-testing-playbook': 'start',\n116:   '/create:readme': 'start',\n117:   '/create:skill': 'start',\n118:   '/deep:research': 'ask',\n119:   '/deep:review': 'ask',\n120:   '/doctor:agents-md check': 'run',\n121:   '/doctor:agents-md embed': 'ask',\n122:   '/doctor:agents-md restore': 'ask',\n123:   '/doctor:ci report': 'run',\n124:   '/doctor:ci scaffold': 'ask',\n125:   '/doctor:ci toggle': 'ask',\n126:   '/doctor:deep-loop': 'run',\n127:   '/doctor:env list': 'run',\n128:   '/doctor:git hooks': 'ask',\n129:   '/doctor:git setup': 'run',\n130:   '/doctor:git standards': 'ask',\n131:   '/doctor:helper': 'run',\n132:   '/doctor:install': 'run',\n133:   '/doctor:mcp debug': 'ask',\n134:   '/doctor:mcp install': 'ask',\n135:   '/doctor:overlay apply': 'ask',\n136:   '/doctor:overlay repin': 'ask',\n137:   '/doctor:overlay status': 'run',\n138:   '/doctor:runtime-mirrors': 'run',\n139:   '/doctor:setup': 'run',\n140:   '/doctor:sk-code quality': 'ask',\n141:   '/doctor:sk-code setup': 'run',\n142:   '/doctor:sk-skill check': 'run',\n143:   '/doctor:sk-skill convert': 'ask',\n144:   '/doctor:skill-advisor parent-skill': 'run',\n145:   '/doctor:skill-advisor rebuild': 'ask',\n146:   '/doctor:skill-advisor router-reach': 'run',\n147:   '/doctor:skill-advisor skill-budget': 'run',\n148:   '/doctor:skill-advisor skill-graph-freshness': 'run',\n149:   '/doctor:skill-advisor tune': 'ask',\n150:   '/doctor:speckit': 'run',\n151:   '/doctor:symlink check': 'run',\n152:   '/doctor:symlink link': 'ask',\n153:   '/doctor:symlink unlink': 'ask',\n154:   '/doctor:update': 'ask',\n155:   '/prompt:improve': 'start',\n156:   '/speckit:complete': 'start',\n157:   '/speckit:handoff': 'ask',\n158:   '/speckit:implement': 'start',\n159:   '/speckit:plan': 'start',\n160:   '/speckit:resume': 'start',\n161:   '/speckit:save': 'start',\n162:   '/speckit:search': 'run',\n163: };\n164: // END GENERATED COMMAND ROWS\n165: \n166: // The row for an id a recommendation carries, or undefined when that id names no\n167: // command. Own-key lookup because the table is generated data, so an inherited\n168: // name such as `constructor` must not resolve to a row nobody declared.\n169: export function commandRowFor(id: string): CommandRow | undefined {\n170:   return Object.hasOwn(COMMAND_ROWS, id) ? COMMAND_ROWS[id] : undefined;\n171: }\n172: \n173: // Deep-loop commands open a long, multi-pass run, so one attached to a prompt\n174: // that merely mentions the topic spends the reader's budget on work they never\n175: // asked for. The list below is the vocabulary that counts as asking for it, and\n176: // it holds only effort wording: a bare topic word such as `research`, `review`\n177: // or `council` says what to look at, never how far to go, so it never qualifies\n178: // on its own.\n179: //\n180: // The phrases live in a data list, one per line, so the vocabulary a reviewer\n181: // has to judge stays visible and cheap to correct.\n182: export const DEPTH_WORDING: readonly string[] = [\n183:   'in depth',\n184:   'deep dive',\n185:   'deep research',\n186:   'deep review',\n187:   'thorough',\n188:   'thoroughly',\n189:   'exhaustive',\n190:   'iteratively',\n191:   'multiple passes',\n192:   'many passes',\n193:   'several passes',\n194:   'ask the council',\n195:   'convene',\n196:   'several models',\n197:   'final verdict',\n198:   'everything you can',\n199: ];\n200: \n201: // A phrase may carry punctuation a regex would read as a metacharacter, so it is\n202: // escaped before it is trusted as a pattern.\n203: function escapePhrase(phrase: string): string {\n204:   return phrase.replace(/[.*+?^${}()|[\\]\\\\]/g, '\\\\$&');\n205: }\n206: \n207: // One alternation over the list keeps the gate a single test per prompt, and the\n208: // boundary markers keep `thorough` from firing inside a longer word while a\n209: // multi-word phrase still has to match as a whole.\n210: const DEPTH_REQUEST = new RegExp(`\\\\b(?:${DEPTH_WORDING.map(escapePhrase).join('|')})\\\\b`);\n211: \n212: // A compiled route arrives as unvalidated JSON from a separate process, so the\n213: // shape is narrowed here rather than trusted. Arrays count as objects in\n214: // JavaScript and would let `action` read off an unrelated field, so they are\n215: // excluded explicitly.\n216: function asRecord(value: unknown): Record<string, unknown> | undefined {\n217:   if (typeof value !== 'object' || value === null || Array.isArray(value)) return undefined;\n218:   return value as Record<string, unknown>;\n219: }\n220: \n221: // The command for a hub's recommendation, or undefined when the route does not\n222: // single out one mode. Only a single-mode route names a command unambiguously:\n223: // a bundle or a multi-target route has more than one answer, and asking the\n224: // reader to pick belongs to the recommend path, not here. Never throws, because\n225: // a missing command must degrade to \"no command offered\" rather than break\n226: // routing. The prompt decides whether a costly deep-loop command is offered at\n227: // all: a reader who only asks about the topic gets no command, rather than one\n228: // that would launch work they never requested.\n229: export function attachCommand(\n230:   skillId: string,\n231:   compiledRoute: unknown,\n232:   prompt: string,\n233:   modeCommands: Readonly<Record<string, Readonly<Record<string, string>>>> = MODE_COMMANDS,\n234: ): string | undefined {\n235:   const route = asRecord(compiledRoute);\n236:   if (!route) return undefined;\n237:   if (route.action !== 'route' || route.selectionKind !== 'single') return undefined;\n238: \n239:   const targets = route.targets;\n240:   if (!Array.isArray(targets) || targets.length !== 1) return undefined;\n241: \n242:   const onlyTarget = asRecord(targets[0]);\n243:   if (!onlyTarget) return undefined;\n244: \n245:   const workflowMode = onlyTarget.workflowMode;\n246:   if (typeof workflowMode !== 'string' || workflowMode === '') return undefined;\n247: \n248:   // Own-key lookup on both levels: the table is data read from a generated\n249:   // object, so an inherited name such as `constructor` must not resolve to a\n250:   // command the hub never declared.\n251:   if (!Object.prototype.hasOwnProperty.call(modeCommands, skillId)) return undefined;\n252:   const commands = modeCommands[skillId];\n253:   if (!Object.prototype.hasOwnProperty.call(commands, workflowMode)) return undefined;\n254: \n255:   // Deep-loop commands are the ones that commit the reader to a long, multi-pass\n256:   // run, so they are offered only when the prompt asks for that effort. Typing\n257:   // the slash command is itself the ask, and every other hub answers a short\n258:   // question with a short answer, so no other skill consults the wording list.\n259:   if (skillId === 'system-deep-loop') {\n260:     const lowered = prompt.toLowerCase();\n261:     if (!lowered.includes('/deep:') && !DEPTH_REQUEST.test(lowered)) return undefined;\n262:   }\n263: \n264:   return commands[workflowMode];\n265: }"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/lib/command-attach.ts\"}"},"time":{"start":1794527189537,"end":1794527189956}}}}
