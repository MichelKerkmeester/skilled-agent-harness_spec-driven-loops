{"type":"tool_use","timestamp":1794527174338,"sessionID":"ses_e2dd8cae6ffeV3iKQc8fxV7h6K","part":{"partID":"prt_1d2279d32002nVMYyPchQNQrP2","sessionID":"ses_e2dd8cae6ffeV3iKQc8fxV7h6K","messageID":"msg_1d2278041001SB161H9Nyh3m4b","type":"tool","id":"call_91e28f322ef344ac8e446bfe","tool":"read","state":{"status":"completed","input":{"path":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/skill-advisor-cli.ts"},"output":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/skill-advisor-cli.ts, lines 1-1324\n1: #!/usr/bin/env node\n2: // ───────────────────────────────────────────────────────────────────\n3: // MODULE: SKILL ADVISOR CLI\n4: // ───────────────────────────────────────────────────────────────────\n5: \n6: // ───────────────────────────────────────────────────────────────────\n7: // 1. IMPORTS\n8: // ───────────────────────────────────────────────────────────────────\n9: import { spawn, type ChildProcess } from 'node:child_process';\n10: import { existsSync, mkdirSync, readFileSync, statSync } from 'node:fs';\n11: import net from 'node:net';\n12: import { createRequire } from 'node:module';\n13: import path from 'node:path';\n14: import { StringDecoder } from 'node:string_decoder';\n15: import { fileURLToPath } from 'node:url';\n16: \n17: import {\n18:   SKILL_ADVISOR_CLI_TOOL_MANIFEST,\n19:   type SkillAdvisorCliToolDefinition,\n20: } from './skill-advisor-cli-manifest.js';\n21: \n22: import { SKILL_ADVISOR_COMPAT_CONTRACT } from './lib/compat/contract.js';\n23: import { runAdvisorSubprocess, type AdvisorRecommendation } from './lib/subprocess.js';\n24: \n25: // ───────────────────────────────────────────────────────────────────\n26: // 2. CONSTANTS\n27: // ───────────────────────────────────────────────────────────────────\n28: const ADVISOR_PROTOCOL_VERSION = '1';\n29: const DEFAULT_TIMEOUT_MS = 30_000;\n30: const DEFAULT_SOCKET_DIR = '/tmp/system-skill-advisor';\n31: // A cold call starts the daemon and waits for it, but never past this. The measured\n32: // cold start is well inside it, and the stall this replaces came from waiting out the\n33: // tool timeout on a daemon that never accepted a connection — not from waiting at all.\n34: const COLD_START_WAIT_MS = 5_000;\n35: // The launcher's lease, which records when the running daemon was launched.\n36: const LAUNCHER_LEASE_FILE_NAME = '.system-skill-advisor-launcher.json';\n37: const ADVISOR_VALIDATE_MAX_ATTEMPTS = 3;\n38: const ADVISOR_VALIDATE_RETRY_BASE_DELAY_MS = 250;\n39: const RESERVED_COMMANDS = new Set(['list-tools', 'completion']);\n40: // The CLI's own last resort when no daemon answers: the checked-in Python scorer\n41: // still routes locally, so an unreachable daemon degrades a recommendation\n42: // instead of failing the call and leaving every caller to build this path again.\n43: const LOCAL_SCORER_TIMEOUT_MS = 5_000;\n44: const LOCAL_SCORER_SOURCE = 'local-scorer';\n45: // The same values are passed to the scorer and reported back, so the degraded\n46: // envelope cannot advertise a threshold the scorer did not apply.\n47: const LOCAL_SCORER_THRESHOLDS = {\n48:   confidenceThreshold: SKILL_ADVISOR_COMPAT_CONTRACT.defaults.confidenceThreshold,\n49:   uncertaintyThreshold: SKILL_ADVISOR_COMPAT_CONTRACT.defaults.uncertaintyThreshold,\n50:   confidenceOnly: false,\n51: } as const;\n52: \n53: const EXIT_SUCCESS = 0;\n54: const EXIT_RUNTIME = 1;\n55: const EXIT_USAGE = 64;\n56: const EXIT_PROTOCOL = 69;\n57: const EXIT_RETRYABLE = 75;\n58: \n59: // ───────────────────────────────────────────────────────────────────\n60: // 3. TYPE DEFINITIONS\n61: // ───────────────────────────────────────────────────────────────────\n62: type OutputFormat = 'json' | 'text' | 'jsonl';\n63: type ToolListMode = 'full' | 'compact' | 'names-only';\n64: type CompletionShell = 'bash' | 'zsh';\n65: \n66: interface ParsedCommand {\n67:   readonly command: string;\n68:   readonly format: OutputFormat;\n69:   readonly timeoutMs: number;\n70:   readonly sessionId?: string;\n71:   readonly warmOnly: boolean;\n72:   readonly toolListMode: ToolListMode;\n73:   readonly completionShell?: CompletionShell;\n74:   readonly args: Record<string, unknown>;\n75:   readonly jsonFromStdin?: boolean;\n76:   readonly help: boolean;\n77:   readonly version: boolean;\n78:   readonly trusted: boolean;\n79:   readonly promptTime: boolean;\n80: }\n81: \n82: interface CliIo {\n83:   readonly stdout: Pick<NodeJS.WriteStream, 'write'>;\n84:   readonly stderr: Pick<NodeJS.WriteStream, 'write'>;\n85:   readonly readStdin?: () => Promise<string>;\n86: }\n87: \n88: interface RepoPaths {\n89:   readonly opencodeDir: string;\n90:   readonly repoRoot: string;\n91:   readonly launcherPath: string;\n92:   readonly bridgePath: string;\n93:   readonly dbDir: string;\n94:   readonly packageJsonPath: string;\n95:   readonly packageLockPath: string;\n96: }\n97: \n98: interface BridgeProbeResult {\n99:   readonly status: string;\n100:   readonly reason?: string;\n101: }\n102: \n103: interface BridgeModule {\n104:   readonly getIpcSocketPath: (serviceName: string, options?: { dbDir?: string }) => string;\n105:   readonly maybeBridgeLeaseHolder: (options: unknown) => unknown;\n106:   readonly probeDaemon: (socketPath: string, options?: { timeoutMs?: number; deepProbe?: boolean }) => Promise<BridgeProbeResult>;\n107:   readonly toConnectionOptions: (socketPath: string) => string | net.NetConnectOpts;\n108: }\n109: \n110: interface JsonRpcResponse {\n111:   readonly jsonrpc?: string;\n112:   readonly id?: unknown;\n113:   readonly result?: unknown;\n114:   readonly error?: {\n115:     readonly code?: number;\n116:     readonly message?: string;\n117:     readonly data?: unknown;\n118:   };\n119: }\n120: \n121: interface InitializeResult {\n122:   readonly advisorProtocol?: string;\n123: }\n124: \n125: interface ToolPayloadResult {\n126:   readonly payload: unknown;\n127:   readonly isError: boolean;\n128: }\n129: \n130: interface RetryOptions {\n131:   readonly maxAttempts: number;\n132:   readonly sleepMsForAttempt: (attempt: number) => number;\n133:   readonly sleepFn?: (ms: number) => Promise<void>;\n134: }\n135: \n136: class CliUsageError extends Error {\n137:   constructor(message: string) {\n138:     super(message);\n139:     this.name = 'CliUsageError';\n140:   }\n141: }\n142: \n143: class CliRetryableError extends Error {\n144:   constructor(message: string) {\n145:     super(message);\n146:     this.name = 'CliRetryableError';\n147:   }\n148: }\n149: \n150: class CliProtocolError extends Error {\n151:   constructor(message: string) {\n152:     super(message);\n153:     this.name = 'CliProtocolError';\n154:   }\n155: }\n156: \n157: class ToolSchemaValidationError extends Error {\n158:   constructor(message: string) {\n159:     super(message);\n160:     this.name = 'ToolSchemaValidationError';\n161:   }\n162: }\n163: \n164: class JsonRpcError extends Error {\n165:   public readonly code?: number;\n166:   public readonly data?: unknown;\n167: \n168:   constructor(error: NonNullable<JsonRpcResponse['error']>) {\n169:     super(error.message ?? 'JSON-RPC request failed');\n170:     this.name = 'JsonRpcError';\n171:     this.code = error.code;\n172:     this.data = error.data;\n173:   }\n174: }\n175: \n176: // ───────────────────────────────────────────────────────────────────\n177: // 4. HELPERS\n178: // ───────────────────────────────────────────────────────────────────\n179: // Awaits drain when the kernel pipe buffer is full: a fire-and-forget\n180: // write followed by process.exit() truncates large payloads at the pipe\n181: // buffer boundary (observed as exactly 64KB on darwin). Streams without\n182: // emitter methods (test fakes) resolve immediately.\n183: async function writeLine(stream: Pick<NodeJS.WriteStream, 'write'>, value: string): Promise<void> {\n184:   const flushed = stream.write(`${value}\\n`);\n185:   if (flushed) return;\n186:   const drainable = stream as Pick<NodeJS.WriteStream, 'write'> & Partial<Pick<NodeJS.WriteStream, 'once' | 'off'>>;\n187:   if (typeof drainable.once !== 'function') return;\n188:   await new Promise<void>((resolve) => {\n189:     const settle = (): void => {\n190:       drainable.off?.('drain', settle);\n191:       drainable.off?.('error', settle);\n192:       drainable.off?.('close', settle);\n193:       resolve();\n194:     };\n195:     drainable.once?.('drain', settle);\n196:     drainable.once?.('error', settle);\n197:     drainable.once?.('close', settle);\n198:   });\n199: }\n200: \n201: function currentModulePath(): string {\n202:   return fileURLToPath(import.meta.url);\n203: }\n204: \n205: // The source tree sits under .skilled or .opencode, and a checkout may link one name\n206: // to the other, so the launcher assets count under either name.\n207: const SOURCE_ROOT_NAMES: readonly string[] = ['.skilled', '.opencode'];\n208: \n209: function findRepoPaths(startFile = currentModulePath()): RepoPaths {\n210:   let current = path.dirname(startFile);\n211: \n212:   while (true) {\n213:     const sourceRootDirs = SOURCE_ROOT_NAMES.includes(path.basename(current))\n214:       ? [current]\n215:       : SOURCE_ROOT_NAMES.map((name) => path.join(current, name));\n216:     for (const directOpencodeDir of sourceRootDirs) {\n217:       const launcherPath = path.join(directOpencodeDir, 'bin', 'system-skill-advisor-launcher.cjs');\n218:       const bridgePath = path.join(directOpencodeDir, 'bin', 'lib', 'launcher-ipc-bridge.cjs');\n219:       if (existsSync(launcherPath) && existsSync(bridgePath)) {\n220:         const repoRoot = path.dirname(directOpencodeDir);\n221:         const mcpServerDir = path.join(directOpencodeDir, 'skills', 'system-skill-advisor', 'runtime');\n222:         const configuredDbDir = process.env.SYSTEM_SKILL_ADVISOR_DB_DIR;\n223:         return {\n224:           opencodeDir: directOpencodeDir,\n225:           repoRoot,\n226:           launcherPath,\n227:           bridgePath,\n228:           dbDir: configuredDbDir ? path.resolve(repoRoot, configuredDbDir) : path.join(mcpServerDir, 'database'),\n229:           packageJsonPath: path.join(mcpServerDir, 'package.json'),\n230:           packageLockPath: path.join(mcpServerDir, 'package-lock.json'),\n231:         };\n232:       }\n233:     }\n234: \n235:     const parent = path.dirname(current);\n236:     if (parent === current) {\n237:       throw new CliProtocolError('Unable to locate .skilled/bin or .opencode/bin launcher assets from CLI path');\n238:     }\n239:     current = parent;\n240:   }\n241: }\n242: \n243: function loadBridge(paths: RepoPaths): BridgeModule {\n244:   const require = createRequire(import.meta.url);\n245:   const bridge = require(paths.bridgePath) as Partial<BridgeModule>;\n246:   if (\n247:     typeof bridge.getIpcSocketPath !== 'function'\n248:     || typeof bridge.maybeBridgeLeaseHolder !== 'function'\n249:     || typeof bridge.probeDaemon !== 'function'\n250:     || typeof bridge.toConnectionOptions !== 'function'\n251:   ) {\n252:     throw new CliProtocolError('launcher IPC bridge does not expose the expected helper contract');\n253:   }\n254:   return bridge as BridgeModule;\n255: }\n256: \n257: function readJsonFile(filePath: string): Record<string, unknown> | null {\n258:   try {\n259:     return JSON.parse(readFileSync(filePath, 'utf8')) as Record<string, unknown>;\n260:   } catch {\n261:     return null;\n262:   }\n263: }\n264: \n265: function readCliVersion(paths: RepoPaths): string {\n266:   const packageJson = existsSync(paths.packageJsonPath) ? readJsonFile(paths.packageJsonPath) : null;\n267:   if (typeof packageJson?.version === 'string') return packageJson.version;\n268:   const packageLock = existsSync(paths.packageLockPath) ? readJsonFile(paths.packageLockPath) : null;\n269:   if (typeof packageLock?.version === 'string') return packageLock.version;\n270:   return '0.0.0';\n271: }\n272: \n273: function normalizeName(value: string): string {\n274:   return value.replace(/[-_]/g, '').toLowerCase();\n275: }\n276: \n277: function toCamelCaseFlag(value: string): string {\n278:   return value.replace(/-([a-z0-9])/g, (_match, char: string) => char.toUpperCase());\n279: }\n280: \n281: function setCommandAlias(map: Map<string, SkillAdvisorCliToolDefinition>, alias: string, tool: SkillAdvisorCliToolDefinition): void {\n282:   const existing = map.get(alias);\n283:   if (existing && existing.name !== tool.name) {\n284:     throw new CliProtocolError(`Command alias collision: ${alias} maps to ${existing.name} and ${tool.name}`);\n285:   }\n286:   map.set(alias, tool);\n287: }\n288: \n289: function commandMap(): Map<string, SkillAdvisorCliToolDefinition> {\n290:   const map = new Map<string, SkillAdvisorCliToolDefinition>();\n291:   for (const tool of SKILL_ADVISOR_CLI_TOOL_MANIFEST) {\n292:     for (const alias of tool.aliases) {\n293:       setCommandAlias(map, alias, tool);\n294:       setCommandAlias(map, normalizeName(alias), tool);\n295:     }\n296:   }\n297:   return map;\n298: }\n299: \n300: function getToolDefinition(command: string): SkillAdvisorCliToolDefinition | null {\n301:   return commandMap().get(command) ?? commandMap().get(normalizeName(command)) ?? null;\n302: }\n303: \n304: function inputPropertyNames(tool: SkillAdvisorCliToolDefinition): string[] {\n305:   const schema = tool.inputSchema;\n306:   const properties = typeof schema === 'object' && schema !== null && !Array.isArray(schema)\n307:     ? (schema as { readonly properties?: unknown }).properties\n308:     : null;\n309:   if (!properties || typeof properties !== 'object' || Array.isArray(properties)) return [];\n310:   return Object.keys(properties);\n311: }\n312: \n313: function resolvePropertyName(rawFlag: string, tool: SkillAdvisorCliToolDefinition): string {\n314:   const exact = inputPropertyNames(tool).find((name) => name === rawFlag);\n315:   if (exact) return exact;\n316: \n317:   const normalized = normalizeName(rawFlag);\n318:   const matched = inputPropertyNames(tool).find((name) => normalizeName(name) === normalized);\n319:   if (matched) return matched;\n320: \n321:   return rawFlag.includes('-') ? toCamelCaseFlag(rawFlag) : rawFlag;\n322: }\n323: \n324: function parseValue(raw: string): unknown {\n325:   const trimmed = raw.trim();\n326:   if (trimmed === 'true') return true;\n327:   if (trimmed === 'false') return false;\n328:   if (trimmed === 'null') return null;\n329:   if (/^-?(?:\\d+|\\d*\\.\\d+)(?:e[+-]?\\d+)?$/i.test(trimmed)) {\n330:     const parsed = Number(trimmed);\n331:     if (Number.isFinite(parsed)) return parsed;\n332:   }\n333:   if ((trimmed.startsWith('{') && trimmed.endsWith('}')) || (trimmed.startsWith('[') && trimmed.endsWith(']'))) {\n334:     try {\n335:       return JSON.parse(trimmed) as unknown;\n336:     } catch (error: unknown) {\n337:       const message = error instanceof Error ? error.message : String(error);\n338:       throw new CliUsageError(`Invalid JSON value: ${message}`);\n339:     }\n340:   }\n341:   return raw;\n342: }\n343: \n344: function parsePositiveInteger(raw: string, flagName: string): number {\n345:   if (!/^\\d+$/.test(raw)) {\n346:     throw new CliUsageError(`${flagName} must be a positive integer`);\n347:   }\n348:   const value = Number.parseInt(raw, 10);\n349:   if (!Number.isFinite(value) || value <= 0) {\n350:     throw new CliUsageError(`${flagName} must be a positive integer`);\n351:   }\n352:   return value;\n353: }\n354: \n355: function parseFormat(raw: string): OutputFormat {\n356:   if (raw === 'json' || raw === 'text' || raw === 'jsonl') return raw;\n357:   throw new CliUsageError('--format must be one of: json, text, jsonl');\n358: }\n359: \n360: function parseInlineBoolean(raw: string, flagName: string): boolean {\n361:   if (raw === 'true' || raw === '1') return true;\n362:   if (raw === 'false' || raw === '0') return false;\n363:   throw new CliUsageError(`${flagName} must be true or false`);\n364: }\n365: \n366: function readOptionValue(tokens: string[], index: number, flagName: string): { readonly value: string; readonly nextIndex: number } {\n367:   const inline = tokens[index].match(/^--[^=]+=(.*)$/);\n368:   if (inline) return { value: inline[1], nextIndex: index + 1 };\n369:   const value = tokens[index + 1];\n370:   if (value === undefined) {\n371:     throw new CliUsageError(`${flagName} requires a value`);\n372:   }\n373:   return { value, nextIndex: index + 2 };\n374: }\n375: \n376: function parseJsonObject(raw: string): Record<string, unknown> {\n377:   let parsed: unknown;\n378:   try {\n379:     parsed = JSON.parse(raw) as unknown;\n380:   } catch (error: unknown) {\n381:     const message = error instanceof Error ? error.message : String(error);\n382:     throw new CliUsageError(`--json must be a valid JSON object: ${message}`);\n383:   }\n384:   if (!parsed || typeof parsed !== 'object' || Array.isArray(parsed)) {\n385:     throw new CliUsageError('--json must be a JSON object');\n386:   }\n387:   return parsed as Record<string, unknown>;\n388: }\n389: \n390: // `--json -` reads the payload here, so a caller can keep a prompt out of\n391: // argv, which any local user can read from the process table.\n392: async function readProcessStdin(): Promise<string> {\n393:   process.stdin.setEncoding('utf8');\n394:   let text = '';\n395:   for await (const chunk of process.stdin) text += String(chunk);\n396:   return text;\n397: }\n398: \n399: function envTrustedDefault(): boolean {\n400:   return process.env.SYSTEM_SKILL_ADVISOR_CLI_TRUSTED === '1'\n401:     || process.env.SPECKIT_SKILL_ADVISOR_CLI_TRUSTED === '1';\n402: }\n403: \n404: function envFlagEnabled(name: string): boolean {\n405:   const raw = process.env[name];\n406:   if (raw === undefined || raw === null) return false;\n407:   return ['1', 'true', 'yes', 'on'].includes(raw.trim().toLowerCase());\n408: }\n409: \n410: // Prompt-time markers (the env this front-door is launched with from a runtime hook).\n411: // Warm-only and prompt-time are orthogonal: warm-only just suppresses cold spawn, while\n412: // prompt-time additionally forbids shared-state mutations regardless of trusted authority,\n413: // because a hook process must never be the thing that scans/rebuilds the skill graph.\n414: function defaultPromptTime(): boolean {\n415:   return envFlagEnabled('SYSTEM_SKILL_ADVISOR_CLI_PROMPT_TIME')\n416:     || envFlagEnabled('SPECKIT_SKILL_ADVISOR_CLI_PROMPT_TIME')\n417:     || envFlagEnabled('SPECKIT_CLI_PROMPT_TIME')\n418:     || envFlagEnabled('OPENCODE_PROMPT_TIME')\n419:     || envFlagEnabled('CLAUDE_CODE_PROMPT_TIME');\n420: }\n421: \n422: function defaultWarmOnly(): boolean {\n423:   return envFlagEnabled('SYSTEM_SKILL_ADVISOR_CLI_WARM_ONLY')\n424:     || envFlagEnabled('SPECKIT_SKILL_ADVISOR_CLI_WARM_ONLY')\n425:     || defaultPromptTime();\n426: }\n427: \n428: export function parseCliArgs(argv: string[]): ParsedCommand {\n429:   const command = argv[0];\n430:   const trustedDefault = envTrustedDefault();\n431:   const warmOnlyDefault = defaultWarmOnly();\n432:   const promptTimeDefault = defaultPromptTime();\n433:   if (!command || command === '--help' || command === '-h') {\n434:     return { command: '', format: 'text', timeoutMs: DEFAULT_TIMEOUT_MS, warmOnly: warmOnlyDefault, toolListMode: 'full', args: {}, help: true, version: false, trusted: trustedDefault, promptTime: promptTimeDefault };\n435:   }\n436:   if (command === '--version' || command === '-v') {\n437:     return { command: '', format: 'text', timeoutMs: DEFAULT_TIMEOUT_MS, warmOnly: warmOnlyDefault, toolListMode: 'full', args: {}, help: false, version: true, trusted: trustedDefault, promptTime: promptTimeDefault };\n438:   }\n439: \n440:   let format: OutputFormat = 'json';\n441:   let timeoutMs = DEFAULT_TIMEOUT_MS;\n442:   let sessionId: string | undefined;\n443:   let warmOnly = warmOnlyDefault;\n444:   let toolListMode: ToolListMode = 'full';\n445:   let completionShell: CompletionShell | undefined;\n446:   let jsonPayload: Record<string, unknown> | null = null;\n447:   let jsonFromStdin = false;\n448:   let trusted = trustedDefault;\n449:   let promptTime = promptTimeDefault;\n450:   const tool = getToolDefinition(command);\n451:   const parsedArgs: Record<string, unknown> = {};\n452:   const tokens = argv.slice(1);\n453:   let index = 0;\n454: \n455:   while (index < tokens.length) {\n456:     const token = tokens[index];\n457:     if (command === 'completion' && completionShell === undefined && !token.startsWith('--')) {\n458:       completionShell = parseCompletionShell(token);\n459:       index += 1;\n460:       continue;\n461:     }\n462:     if (!token.startsWith('--')) {\n463:       throw new CliUsageError(`Unexpected positional argument: ${token}`);\n464:     }\n465:     const rawFlag = token.slice(2).split('=', 1)[0];\n466:     const option = `--${rawFlag}`;\n467: \n468:     if (rawFlag === 'help' || rawFlag === 'h') {\n469:       return { command, format: 'text', timeoutMs, sessionId, warmOnly, toolListMode, completionShell, args: {}, help: true, version: false, trusted, promptTime };\n470:     }\n471:     if (rawFlag === 'format') {\n472:       const read = readOptionValue(tokens, index, option);\n473:       format = parseFormat(read.value);\n474:       index = read.nextIndex;\n475:       continue;\n476:     }\n477:     if (rawFlag === 'timeout-ms') {\n478:       const read = readOptionValue(tokens, index, option);\n479:       timeoutMs = parsePositiveInteger(read.value, option);\n480:       index = read.nextIndex;\n481:       continue;\n482:     }\n483:     if (rawFlag === 'session-id') {\n484:       const read = readOptionValue(tokens, index, option);\n485:       sessionId = read.value;\n486:       index = read.nextIndex;\n487:       continue;\n488:     }\n489:     if (rawFlag === 'json') {\n490:       const read = readOptionValue(tokens, index, option);\n491:       if (read.value === '-') {\n492:         jsonFromStdin = true;\n493:       } else {\n494:         jsonPayload = parseJsonObject(read.value);\n495:       }\n496:       index = read.nextIndex;\n497:       continue;\n498:     }\n499:     if (rawFlag === 'trusted' || rawFlag === 'maintainer') {\n500:       const inline = token.match(/^--[^=]+=(.*)$/);\n501:       trusted = inline ? parseInlineBoolean(inline[1], option) : true;\n502:       index += 1;\n503:       continue;\n504:     }\n505:     if (rawFlag === 'untrusted') {\n506:       trusted = false;\n507:       index += 1;\n508:       continue;\n509:     }\n510:     if (rawFlag === 'prompt-time') {\n511:       const inline = token.match(/^--[^=]+=(.*)$/);\n512:       promptTime = inline ? parseInlineBoolean(inline[1], option) : true;\n513:       index += 1;\n514:       continue;\n515:     }\n516:     if (rawFlag === 'no-prompt-time') {\n517:       promptTime = false;\n518:       index += 1;\n519:       continue;\n520:     }\n521:     if (rawFlag === 'compact') {\n522:       toolListMode = 'compact';\n523:       index += 1;\n524:       continue;\n525:     }\n526:     if (rawFlag === 'names-only') {\n527:       toolListMode = 'names-only';\n528:       index += 1;\n529:       continue;\n530:     }\n531:     if (rawFlag === 'warm-only') {\n532:       const inline = token.match(/^--[^=]+=(.*)$/);\n533:       warmOnly = inline ? parseInlineBoolean(inline[1], option) : true;\n534:       index += 1;\n535:       continue;\n536:     }\n537:     if (rawFlag === 'no-warm-only') {\n538:       warmOnly = false;\n539:       index += 1;\n540:       continue;\n541:     }\n542: \n543:     if (!tool) {\n544:       throw new CliUsageError(`Unknown command: ${command}`);\n545:     }\n546: \n547:     const propertyName = resolvePropertyName(rawFlag, tool);\n548:     const inline = token.match(/^--[^=]+=(.*)$/);\n549:     if (inline) {\n550:       parsedArgs[propertyName] = parseValue(inline[1]);\n551:       index += 1;\n552:       continue;\n553:     }\n554: \n555:     const next = tokens[index + 1];\n556:     if (next === undefined || next.startsWith('--')) {\n557:       parsedArgs[propertyName] = true;\n558:       index += 1;\n559:       continue;\n560:     }\n561:     parsedArgs[propertyName] = parseValue(next);\n562:     index += 2;\n563:   }\n564: \n565:   if ((jsonPayload || jsonFromStdin) && Object.keys(parsedArgs).length > 0) {\n566:     throw new CliUsageError('--json cannot be combined with per-parameter flags');\n567:   }\n568: \n569:   return {\n570:     command,\n571:     format,\n572:     timeoutMs,\n573:     sessionId,\n574:     warmOnly,\n575:     toolListMode,\n576:     completionShell,\n577:     args: jsonPayload ?? parsedArgs,\n578:     ...(jsonFromStdin ? { jsonFromStdin: true } : {}),\n579:     help: false,\n580:     version: false,\n581:     trusted,\n582:     promptTime,\n583:   };\n584: }\n585: \n586: function isRecord(value: unknown): value is Record<string, unknown> {\n587:   return value !== null && typeof value === 'object' && !Array.isArray(value);\n588: }\n589: \n590: function schemaTypes(schema: Record<string, unknown>): string[] {\n591:   const type = schema.type;\n592:   if (typeof type === 'string') return [type];\n593:   if (Array.isArray(type) && type.every((entry) => typeof entry === 'string')) return type as string[];\n594:   return [];\n595: }\n596: \n597: function coerceValueForSchema(schema: unknown, value: unknown): unknown {\n598:   if (!isRecord(schema)) return value;\n599:   const types = schemaTypes(schema);\n600:   if (types.includes('number') && typeof value === 'string') {\n601:     const parsed = Number(value);\n602:     if (Number.isFinite(parsed)) return parsed;\n603:   }\n604:   if (types.includes('boolean') && typeof value === 'string') {\n605:     if (value === 'true') return true;\n606:     if (value === 'false') return false;\n607:   }\n608:   if (types.includes('object') && isRecord(value) && isRecord(schema.properties)) {\n609:     return coerceObjectForSchema(schema, value);\n610:   }\n611:   if (types.includes('array') && Array.isArray(value)) {\n612:     return value.map((entry) => coerceValueForSchema(schema.items, entry));\n613:   }\n614:   return value;\n615: }\n616: \n617: function coerceObjectForSchema(schema: Record<string, unknown>, args: Record<string, unknown>): Record<string, unknown> {\n618:   if (!isRecord(schema.properties)) return args;\n619:   const coerced: Record<string, unknown> = { ...args };\n620:   for (const [key, value] of Object.entries(args)) {\n621:     coerced[key] = coerceValueForSchema(schema.properties[key], value);\n622:   }\n623:   return coerced;\n624: }\n625: \n626: function expectedTypeLabel(types: string[]): string {\n627:   return types.length > 0 ? types.join(' or ') : 'valid JSON schema value';\n628: }\n629: \n630: function valueType(value: unknown): string {\n631:   if (value === null) return 'null';\n632:   if (Array.isArray(value)) return 'array';\n633:   return typeof value;\n634: }\n635: \n636: function valueMatchesTypes(value: unknown, types: string[]): boolean {\n637:   if (types.length === 0) return true;\n638:   return types.some((type) => {\n639:     if (type === 'null') return value === null;\n640:     if (type === 'array') return Array.isArray(value);\n641:     if (type === 'object') return isRecord(value);\n642:     if (type === 'number') return typeof value === 'number' && Number.isFinite(value);\n643:     if (type === 'integer') return Number.isInteger(value);\n644:     return typeof value === type;\n645:   });\n646: }\n647: \n648: function validateJsonSchema(schema: unknown, value: unknown, location: string): void {\n649:   if (!isRecord(schema)) return;\n650:   const types = schemaTypes(schema);\n651:   if (!valueMatchesTypes(value, types)) {\n652:     throw new ToolSchemaValidationError(`${location} expected ${expectedTypeLabel(types)}, received ${valueType(value)}`);\n653:   }\n654: \n655:   if (Object.prototype.hasOwnProperty.call(schema, 'const') && value !== schema.const) {\n656:     throw new ToolSchemaValidationError(`${location} must be ${JSON.stringify(schema.const)}`);\n657:   }\n658:   if (Array.isArray(schema.enum) && !schema.enum.includes(value)) {\n659:     throw new ToolSchemaValidationError(`${location} must be one of: ${schema.enum.map(String).join(', ')}`);\n660:   }\n661: \n662:   if (typeof value === 'string') {\n663:     if (typeof schema.minLength === 'number' && value.length < schema.minLength) {\n664:       throw new ToolSchemaValidationError(`${location} must be at least ${schema.minLength} character(s)`);\n665:     }\n666:     if (typeof schema.maxLength === 'number' && value.length > schema.maxLength) {\n667:       throw new ToolSchemaValidationError(`${location} must be at most ${schema.maxLength} character(s)`);\n668:     }\n669:   }\n670: \n671:   if (typeof value === 'number') {\n672:     if (typeof schema.minimum === 'number' && value < schema.minimum) {\n673:       throw new ToolSchemaValidationError(`${location} must be >= ${schema.minimum}`);\n674:     }\n675:     if (typeof schema.maximum === 'number' && value > schema.maximum) {\n676:       throw new ToolSchemaValidationError(`${location} must be <= ${schema.maximum}`);\n677:     }\n678:   }\n679: \n680:   if (Array.isArray(value)) {\n681:     if (typeof schema.minItems === 'number' && value.length < schema.minItems) {\n682:       throw new ToolSchemaValidationError(`${location} must contain at least ${schema.minItems} item(s)`);\n683:     }\n684:     if (typeof schema.maxItems === 'number' && value.length > schema.maxItems) {\n685:       throw new ToolSchemaValidationError(`${location} must contain at most ${schema.maxItems} item(s)`);\n686:     }\n687:     value.forEach((entry, index) => validateJsonSchema(schema.items, entry, `${location}[${index}]`));\n688:   }\n689: \n690:   if (isRecord(value)) {\n691:     const properties = isRecord(schema.properties) ? schema.properties : {};\n692:     const required = Array.isArray(schema.required) ? schema.required.filter((entry): entry is string => typeof entry === 'string') : [];\n693:     for (const key of required) {\n694:       if (!Object.prototype.hasOwnProperty.call(value, key)) {\n695:         throw new ToolSchemaValidationError(`${location}.${key} is required`);\n696:       }\n697:     }\n698:     if (schema.additionalProperties === false) {\n699:       const unknownKeys = Object.keys(value).filter((key) => !Object.prototype.hasOwnProperty.call(properties, key));\n700:       if (unknownKeys.length > 0) {\n701:         throw new ToolSchemaValidationError(`Unknown parameter(s): ${unknownKeys.join(', ')}`);\n702:       }\n703:     }\n704:     for (const [key, nestedValue] of Object.entries(value)) {\n705:       if (Object.prototype.hasOwnProperty.call(properties, key)) {\n706:         validateJsonSchema(properties[key], nestedValue, `${location}.${key}`);\n707:       }\n708:     }\n709:   }\n710: }\n711: \n712: function formatValidationMessage(error: unknown): string {\n713:   if (error instanceof ToolSchemaValidationError) return error.message;\n714:   if (error instanceof Error) return error.message;\n715:   return String(error);\n716: }\n717: \n718: function applySchemaDefaults(schema: unknown, args: Record<string, unknown>): Record<string, unknown> {\n719:   if (!isRecord(schema) || !isRecord(schema.properties)) return args;\n720:   const withDefaults: Record<string, unknown> = { ...args };\n721:   for (const [key, propertySchema] of Object.entries(schema.properties)) {\n722:     if (Object.prototype.hasOwnProperty.call(withDefaults, key)) continue;\n723:     if (isRecord(propertySchema) && Object.prototype.hasOwnProperty.call(propertySchema, 'default')) {\n724:       withDefaults[key] = propertySchema.default;\n725:     }\n726:   }\n727:   return withDefaults;\n728: }\n729: \n730: function validateToolArgs(tool: SkillAdvisorCliToolDefinition, args: Record<string, unknown>): Record<string, unknown> {\n731:   const coerced = coerceObjectForSchema(tool.inputSchema, applySchemaDefaults(tool.inputSchema, args));\n732:   try {\n733:     validateJsonSchema(tool.inputSchema, coerced, tool.name);\n734:   } catch (error: unknown) {\n735:     throw new ToolSchemaValidationError(`Invalid arguments for ${tool.name}: ${formatValidationMessage(error)}`);\n736:   }\n737:   return coerced;\n738: }\n739: \n740: function isPropagateApply(args: Record<string, unknown>): boolean {\n741:   return args.mode === 'apply' && args.dryRun !== true;\n742: }\n743: \n744: function assertTrustedForMutation(toolName: string, args: Record<string, unknown>, trusted: boolean, promptTime: boolean): void {\n745:   const requiresTrusted = toolName === 'advisor_rebuild'\n746:     || toolName === 'skill_graph_scan'\n747:     || (toolName === 'skill_graph_propagate_enhances' && isPropagateApply(args));\n748:   if (!requiresTrusted) return;\n749:   // Defense-in-depth: a prompt-time hook process must never run a shared-state mutation,\n750:   // even if it also asserts trusted authority — the documented hook convention forbids it,\n751:   // so the front-door enforces it structurally instead of trusting every wrapper to pass\n752:   // only read tools.\n753:   if (promptTime) {\n754:     throw new CliUsageError(`${toolName} is blocked at prompt-time (mutations require a non-prompt-time, trusted invocation)`);\n755:   }\n756:   if (trusted) return;\n757:   throw new CliUsageError(`${toolName} requires --trusted or SYSTEM_SKILL_ADVISOR_CLI_TRUSTED=1`);\n758: }\n759: \n760: function validateCommand(parsed: ParsedCommand): { readonly tool: SkillAdvisorCliToolDefinition; readonly args: Record<string, unknown> } | null {\n761:   if (RESERVED_COMMANDS.has(parsed.command)) return null;\n762:   const tool = getToolDefinition(parsed.command);\n763:   if (!tool) {\n764:     throw new CliUsageError(`Unknown command: ${parsed.command}`);\n765:   }\n766: \n767:   const args = { ...parsed.args };\n768:   const properties = new Set(inputPropertyNames(tool));\n769:   if (parsed.sessionId && !Object.prototype.hasOwnProperty.call(args, 'sessionId') && properties.has('sessionId')) {\n770:     args.sessionId = parsed.sessionId;\n771:   } else if (parsed.sessionId && !Object.prototype.hasOwnProperty.call(args, 'session_id') && properties.has('session_id')) {\n772:     args.session_id = parsed.sessionId;\n773:   }\n774: \n775:   const validated = validateToolArgs(tool, args);\n776:   assertTrustedForMutation(tool.name, validated, parsed.trusted, parsed.promptTime);\n777:   return { tool, args: validated };\n778: }\n779: \n780: function renderJson(value: unknown, format: OutputFormat): string {\n781:   if (format === 'jsonl') return JSON.stringify(value);\n782:   return JSON.stringify(value, null, 2);\n783: }\n784: \n785: function usageText(command?: string): string {\n786:   const tool = command ? getToolDefinition(command) : null;\n787:   if (tool) {\n788:     return `skill-advisor ${tool.command}\n789: \n790: Description:\n791:   ${tool.description}\n792: \n793: Aliases:\n794:   ${tool.aliases.join(', ')}\n795: \n796: Input schema:\n797: ${JSON.stringify(tool.inputSchema, null, 2)}`;\n798:   }\n799: \n800:   const commands = SKILL_ADVISOR_CLI_TOOL_MANIFEST\n801:     .map((entry) => `  ${entry.command} (${entry.kebabCommand}, ${entry.camelCommand})`)\n802:     .join('\\n');\n803: \n804:   return `skill-advisor - daemon-backed CLI for system-skill-advisor\n805: \n806: Usage:\n807:   skill-advisor list-tools [--format json|text|jsonl] [--compact|--names-only]\n808:   skill-advisor completion bash|zsh\n809:   skill-advisor <tool_name> [--json '{...}' | --json -] [--format json|text|jsonl] [--timeout-ms N] [--trusted] [--warm-only]\n810:   skill-advisor <tool_name> --param value [--another-param value]\n811: \n812: Commands:\n813: ${commands}\n814: \n815: Examples:\n816:   skill-advisor list-tools --format text\n817:   skill-advisor list-tools --compact\n818:   skill-advisor completion zsh\n819:   skill-advisor advisor_status --workspace-root \"$PWD\" --format text\n820:   skill-advisor advisor_recommend --prompt \"implement cli core\"\n821:   printf '%s' '{\"prompt\":\"implement cli core\"}' | skill-advisor advisor_recommend --json -\n822:   skill-advisor advisor_rebuild --trusted --force true\n823:   skill-advisor skill_graph_scan --trusted --format text\n824: \n825: Trusted context:\n826:   Mutation commands require --trusted or SYSTEM_SKILL_ADVISOR_CLI_TRUSTED=1.\n827:   Calls are sent as untrusted by default.\n828: \n829: Exit codes:\n830:   0 success, 1 runtime error, 64 usage/schema error, 69 protocol mismatch, 75 retryable daemon error`;\n831: }\n832: \n833: function parseCompletionShell(raw: string): CompletionShell {\n834:   if (raw === 'bash' || raw === 'zsh') return raw;\n835:   throw new CliUsageError('completion shell must be one of: bash, zsh');\n836: }\n837: \n838: function compactTool(tool: SkillAdvisorCliToolDefinition): Record<string, unknown> {\n839:   return {\n840:     name: tool.name,\n841:     command: tool.command,\n842:     kebabCommand: tool.kebabCommand,\n843:     camelCommand: tool.camelCommand,\n844:     aliases: tool.aliases,\n845:     description: tool.description,\n846:   };\n847: }\n848: \n849: function renderToolList(format: OutputFormat, mode: ToolListMode = 'full'): string {\n850:   const payload = {\n851:     status: 'ok',\n852:     data: {\n853:       count: SKILL_ADVISOR_CLI_TOOL_MANIFEST.length,\n854:       mode,\n855:       tools: SKILL_ADVISOR_CLI_TOOL_MANIFEST.map((tool) => ({\n856:         name: tool.name,\n857:         command: tool.command,\n858:         kebabCommand: tool.kebabCommand,\n859:         camelCommand: tool.camelCommand,\n860:         description: tool.description,\n861:         inputSchema: tool.inputSchema,\n862:       })),\n863:     },\n864:   };\n865:   const compactPayload = {\n866:     status: 'ok',\n867:     data: {\n868:       count: SKILL_ADVISOR_CLI_TOOL_MANIFEST.length,\n869:       mode,\n870:       tools: SKILL_ADVISOR_CLI_TOOL_MANIFEST.map(compactTool),\n871:     },\n872:   };\n873:   const namesOnlyPayload = {\n874:     status: 'ok',\n875:     data: {\n876:       count: SKILL_ADVISOR_CLI_TOOL_MANIFEST.length,\n877:       mode,\n878:       names: SKILL_ADVISOR_CLI_TOOL_MANIFEST.map((tool) => tool.name),\n879:     },\n880:   };\n881: \n882:   if (format === 'text') {\n883:     return SKILL_ADVISOR_CLI_TOOL_MANIFEST.map((tool) => tool.name).join('\\n');\n884:   }\n885:   if (mode === 'compact') return renderJson(compactPayload, format);\n886:   if (mode === 'names-only') return renderJson(namesOnlyPayload, format);\n887:   return renderJson(payload, format);\n888: }\n889: \n890: function completionWords(): string[] {\n891:   return ['list-tools', 'completion', ...SKILL_ADVISOR_CLI_TOOL_MANIFEST.map((tool) => tool.name)];\n892: }\n893: \n894: function shellWords(words: readonly string[]): string {\n895:   return words.join(' ');\n896: }\n897: \n898: function renderBashCompletion(): string {\n899:   const commands = shellWords(completionWords());\n900:   const commonFlags = shellWords(['--help', '--format', '--json', '--timeout-ms', '--session-id', '--trusted', '--untrusted', '--warm-only', '--no-warm-only']);\n901:   const listFlags = shellWords(['--help', '--format', '--compact', '--names-only']);\n902:   return `_skill_advisor_completion() {\n903:   local cur\n904:   COMPREPLY=()\n905:   cur=\"\\${COMP_WORDS[COMP_CWORD]}\"\n906:   if [[ \\${COMP_CWORD} -eq 1 ]]; then\n907:     COMPREPLY=( $(compgen -W \"${commands}\" -- \"\\${cur}\") )\n908:     return 0\n909:   fi\n910:   case \"\\${COMP_WORDS[1]}\" in\n911:     completion) COMPREPLY=( $(compgen -W \"bash zsh\" -- \"\\${cur}\") ) ;;\n912:     list-tools) COMPREPLY=( $(compgen -W \"${listFlags}\" -- \"\\${cur}\") ) ;;\n913:     *) COMPREPLY=( $(compgen -W \"${commonFlags}\" -- \"\\${cur}\") ) ;;\n914:   esac\n915: }\n916: complete -F _skill_advisor_completion skill-advisor`;\n917: }\n918: \n919: function renderZshCompletion(): string {\n920:   const commands = shellWords(completionWords());\n921:   const commonFlags = shellWords(['--help', '--format', '--json', '--timeout-ms', '--session-id', '--trusted', '--untrusted', '--warm-only', '--no-warm-only']);\n922:   const listFlags = shellWords(['--help', '--format', '--compact', '--names-only']);\n923:   return `#compdef skill-advisor\n924: _skill_advisor() {\n925:   local -a commands common_flags list_flags shells\n926:   commands=(${commands})\n927:   common_flags=(${commonFlags})\n928:   list_flags=(${listFlags})\n929:   shells=(bash zsh)\n930:   if (( CURRENT == 2 )); then\n931:     _describe 'commands' commands\n932:     return\n933:   fi\n934:   case \\${words[2]} in\n935:     completion) _describe 'shells' shells ;;\n936:     list-tools) _describe 'flags' list_flags ;;\n937:     *) _describe 'flags' common_flags ;;\n938:   esac\n939: }\n940: _skill_advisor \"$@\"`;\n941: }\n942: \n943: function renderCompletion(shell: CompletionShell): string {\n944:   return shell === 'bash' ? renderBashCompletion() : renderZshCompletion();\n945: }\n946: \n947: function isErrorPayload(payload: unknown): boolean {\n948:   return isRecord(payload) && payload.status === 'error';\n949: }\n950: \n951: function extractToolPayload(result: unknown): ToolPayloadResult {\n952:   return {\n953:     payload: result,\n954:     isError: isErrorPayload(result),\n955:   };\n956: }\n957: \n958: function getDataRecord(payload: unknown): Record<string, unknown> | null {\n959:   if (!isRecord(payload) || !isRecord(payload.data)) return null;\n960:   return payload.data;\n961: }\n962: \n963: function renderJobText(toolName: string, payload: unknown): string | null {\n964:   const data = getDataRecord(payload);\n965:   if (!data) return null;\n966: \n967:   if (toolName === 'advisor_rebuild') {\n968:     return [\n969:       `advisor_rebuild: ${data.rebuilt === true ? 'rebuilt' : 'skipped'}`,\n970:       `reason: ${String(data.reason ?? 'unknown')}`,\n971:       `freshness: ${String(data.freshnessBefore ?? 'unknown')} -> ${String(data.freshnessAfter ?? 'unknown')}`,\n972:       `generation: ${String(data.generationBefore ?? 'unknown')} -> ${String(data.generationAfter ?? 'unknown')}`,\n973:       `skillCount: ${String(data.skillCount ?? 'unknown')}`,\n974:     ].join('\\n');\n975:   }\n976: \n977:   if (toolName === 'skill_graph_scan') {\n978:     const scan = isRecord(data.scan) ? data.scan : data;\n979:     const payloadStatus = isRecord(payload) && typeof payload.status === 'string' ? payload.status : null;\n980:     const progress = Array.isArray(data.progress) ? data.progress.filter(isRecord) : [];\n981:     const hasProgressFailure = progress.some((step) => step.ok === false);\n982:     const status = payloadStatus === 'error' || hasProgressFailure ? 'failed' : 'completed';\n983:     return [\n984:       `skill_graph_scan: ${status}`,\n985:       `generation: ${String(data.generationBefore ?? 'unknown')} -> ${String(data.generationAfter ?? 'unknown')}`,\n986:       `scannedFiles: ${String(scan.scannedFiles ?? 'unknown')}`,\n987:       `indexedFiles: ${String(scan.indexedFiles ?? 'unknown')}`,\n988:       `indexedEdges: ${String(scan.indexedEdges ?? 'unknown')}`,\n989:       `rejectedEdges: ${String(scan.rejectedEdges ?? 'unknown')}`,\n990:     ].join('\\n');\n991:   }\n992: \n993:   return null;\n994: }\n995: \n996: function renderPayload(payload: unknown, format: OutputFormat, toolName?: string): string {\n997:   if (format === 'json' || format === 'jsonl') return renderJson(payload, format);\n998:   if (toolName) {\n999:     const jobText = renderJobText(toolName, payload);\n1000:     if (jobText) return jobText;\n1001:   }\n1002:   if (isRecord(payload)) {\n1003:     if (typeof payload.summary === 'string') return payload.summary;\n1004:     if (typeof payload.error === 'string') return payload.error;\n1005:     if (typeof payload.message === 'string') return payload.message;\n1006:   }\n1007:   return typeof payload === 'string' ? payload : JSON.stringify(payload, null, 2);\n1008: }\n1009: \n1010: function isProtocolMismatch(error: unknown): boolean {\n1011:   if (error instanceof JsonRpcError && (error.code === -32002 || error.code === -32600)) return true;\n1012:   const message = error instanceof Error ? error.message : String(error);\n1013:   return /protocol.*(mismatch|changed|version)/i.test(message);\n1014: }\n1015: \n1016: function isRetryableError(error: unknown): boolean {\n1017:   if (error instanceof CliRetryableError) return true;\n1018:   if (error instanceof JsonRpcError && (error.code === -32001 || error.code === -32000)) return true;\n1019:   const message = error instanceof Error ? error.message : String(error);\n1020:   return /SQLITE_BUSY|ECONNREFUSED|ENOENT|ECONNRESET|EPIPE|ETIMEDOUT|backend unavailable|retry/i.test(message);\n1021: }\n1022: \n1023: function exitCodeForError(error: unknown): number {\n1024:   if (error instanceof CliUsageError || error instanceof ToolSchemaValidationError) return EXIT_USAGE;\n1025:   if (error instanceof JsonRpcError && error.code === -32601) return EXIT_USAGE;\n1026:   if (error instanceof CliProtocolError || isProtocolMismatch(error)) return EXIT_PROTOCOL;\n1027:   if (isRetryableError(error)) return EXIT_RETRYABLE;\n1028:   if (error instanceof JsonRpcError && error.code === -32602) return EXIT_USAGE;\n1029:   return EXIT_RUNTIME;\n1030: }\n1031: \n1032: function levenshteinDistance(left: string, right: string): number {\n1033:   const previous = Array.from({ length: right.length + 1 }, (_value, index) => index);\n1034:   const current = new Array<number>(right.length + 1);\n1035: \n1036:   for (let leftIndex = 1; leftIndex <= left.length; leftIndex += 1) {\n1037:     current[0] = leftIndex;\n1038:     for (let rightIndex = 1; rightIndex <= right.length; rightIndex += 1) {\n1039:       const cost = left[leftIndex - 1] === right[rightIndex - 1] ? 0 : 1;\n1040:       current[rightIndex] = Math.min(\n1041:         current[rightIndex - 1] + 1,\n1042:         previous[rightIndex] + 1,\n1043:         previous[rightIndex - 1] + cost,\n1044:       );\n1045:     }\n1046:     previous.splice(0, previous.length, ...current);\n1047:   }\n1048: \n1049:   return previous[right.length];\n1050: }\n1051: \n1052: function closestCommand(command: string): string | undefined {\n1053:   const targets = new Map<string, string>([['list-tools', 'list-tools']]);\n1054:   targets.set('completion', 'completion');\n1055:   for (const tool of SKILL_ADVISOR_CLI_TOOL_MANIFEST) {\n1056:     for (const alias of tool.aliases) {\n1057:       targets.set(alias, tool.name);\n1058:     }\n1059:   }\n1060: \n1061:   let best: { readonly command: string; readonly distance: number } | null = null;\n1062:   for (const [alias, canonical] of targets) {\n1063:     const distance = levenshteinDistance(normalizeName(command), normalizeName(alias));\n1064:     if (!best || distance < best.distance || (distance === best.distance && canonical < best.command)) {\n1065:       best = { command: canonical, distance };\n1066:     }\n1067:   }\n1068: \n1069:   if (!best) return undefined;\n1070:   const threshold = Math.max(2, Math.floor(normalizeName(command).length * 0.4));\n1071:   return best.distance <= threshold ? best.command : undefined;\n1072: }\n1073: \n1074: function unknownCommandContext(message: string): { readonly hint: string; readonly suggestion?: string } | null {\n1075:   const match = message.match(/^Unknown command: (.+)$/);\n1076:   if (!match) return null;\n1077:   return {\n1078:     hint: 'Try `list-tools` to see available commands.',\n1079:     suggestion: closestCommand(match[1]),\n1080:   };\n1081: }\n1082: \n1083: function socketPathTooLong(socketPath: string): boolean {\n1084:   if (socketPath.startsWith('tcp://')) return false;\n1085:   return process.platform === 'darwin' && Buffer.byteLength(socketPath) > 103;\n1086: }\n1087: \n1088: function ensureSocketEnvironment(): void {\n1089:   if (!process.env.SPECKIT_IPC_SOCKET_DIR) {\n1090:     process.env.SPECKIT_IPC_SOCKET_DIR = DEFAULT_SOCKET_DIR;\n1091:   }\n1092:   const socketDir = process.env.SPECKIT_IPC_SOCKET_DIR;\n1093:   if (!socketDir || socketDir.startsWith('tcp://')) return;\n1094:   mkdirSync(socketDir, { recursive: true, mode: 0o700 });\n1095:   const stat = statSync(socketDir);\n1096:   if ((stat.mode & 0o022) !== 0) {\n1097:     throw new CliProtocolError(`IPC socket directory is group/world-writable: ${socketDir}`);\n1098:   }\n1099: }\n1100: \n1101: function sleep(ms: number): Promise<void> {\n1102:   return new Promise((resolve) => setTimeout(resolve, ms));\n1103: }\n1104: \n1105: function advisorValidateRetryDelayMs(attempt: number): number {\n1106:   return ADVISOR_VALIDATE_RETRY_BASE_DELAY_MS * attempt;\n1107: }\n1108: \n1109: // ───────────────────────────────────────────────────────────────────\n1110: // 5. CORE LOGIC\n1111: // ───────────────────────────────────────────────────────────────────\n1112: function spawnLauncher(paths: RepoPaths): ChildProcess {\n1113:   const child = spawn(process.execPath, [paths.launcherPath], {\n1114:     cwd: paths.repoRoot,\n1115:     env: process.env,\n1116:     detached: true,\n1117:     stdio: 'ignore',\n1118:   });\n1119:   child.unref();\n1120:   // Handed back so the wait below can end the moment the launcher proves it cannot\n1121:   // bring the socket up, instead of spending the rest of the budget on a dead process.\n1122:   return child;\n1123: }\n1124: \n1125: async function waitForDaemon(\n1126:   socketPath: string,\n1127:   bridge: BridgeModule,\n1128:   timeoutMs: number,\n1129:   launcher?: ChildProcess,\n1130: ): Promise<void> {\n1131:   const deadline = Date.now() + timeoutMs;\n1132:   let lastReason = 'not probed';\n1133:   // A launcher that has already died cannot bring the socket up, so the wait ends there\n1134:   // rather than burning the rest of the budget on a guaranteed failure. It arrives as an\n1135:   // event rather than a return value, so it is tracked as state.\n1136:   const launcherState: { exited: boolean; reason: string | null } = { exited: false, reason: null };\n1137:   if (launcher) {\n1138:     launcher.once('error', (error: Error) => {\n1139:       launcherState.exited = true;\n1140:       launcherState.reason = `daemon launcher failed to start: ${error.message}`;\n1141:     });\n1142:     launcher.once('exit', (code: number | null, signal: NodeJS.Signals | null) => {\n1143:       launcherState.exited = true;\n1144:       launcherState.reason = signal\n1145:         ? `daemon launcher exited on ${signal}`\n1146:         : `daemon launcher exited with code ${code ?? 'unknown'}`;\n1147:     });\n1148:   }\n1149: \n1150:   while (Date.now() <= deadline) {\n1151:     const remaining = Math.max(1, deadline - Date.now());\n1152:     // Probe before reading the launcher state: a launcher that bridged to a daemon which\n1153:     // was already running exits on success, so its exit only matters while the socket is\n1154:     // still not answering.\n1155:     const probe = await bridge.probeDaemon(socketPath, {\n1156:       timeoutMs: Math.min(remaining, 5000),\n1157:       deepProbe: true,\n1158:     });\n1159:     if (probe.status === 'alive') return;\n1160:     if (launcherState.exited) {\n1161:       throw new CliRetryableError(`backend unavailable: ${launcherState.reason ?? lastReason}`);\n1162:     }\n1163:     lastReason = probe.reason ?? probe.status;\n1164:     await sleep(100);\n1165:   }\n1166: \n1167:   throw new CliRetryableError(`backend unavailable: ${lastReason}`);\n1168: }\n1169: \n1170: class JsonRpcSocketClient {\n1171:   private nextId = 1;\n1172:   private readonly decoder = new StringDecoder('utf8');\n1173: \n1174:   private constructor(\n1175:     private readonly socket: net.Socket,\n1176:   ) {}\n1177: \n1178:   static connect(socketPath: string, bridge: BridgeModule, timeoutMs: number): Promise<JsonRpcSocketClient> {\n1179:     return new Promise((resolve, reject) => {\n1180:       let socket: net.Socket;\n1181:       let settled = false;\n1182:       const finish = (error?: Error): void => {\n1183:         if (settled) return;\n1184:         settled = true;\n1185:         clearTimeout(timer);\n1186:         socket.off?.('connect', onConnect);\n1187:         socket.off?.('error', onError);\n1188:         if (error) {\n1189:           socket.destroy?.();\n1190:           reject(error);\n1191:           return;\n1192:         }\n1193:         resolve(new JsonRpcSocketClient(socket));\n1194:       };\n1195:       const onConnect = (): void => finish();\n1196:       const onError = (error: Error): void => finish(error);\n1197:       const timer = setTimeout(() => finish(new CliRetryableError('connection timed out')), timeoutMs);\n1198:       timer.unref?.();\n1199: \n1200:       try {\n1201:         const connectionOptions = bridge.toConnectionOptions(socketPath);\n1202:         socket = typeof connectionOptions === 'string'\n1203:           ? net.createConnection(connectionOptions)\n1204:           : net.createConnection(connectionOptions);\n1205:       } catch (error: unknown) {\n1206:         clearTimeout(timer);\n1207:         reject(error instanceof Error ? error : new Error(String(error)));\n1208:         return;\n1209:       }\n1210:       socket.once('connect', onConnect);\n1211:       socket.once('error', onError);\n1212:     });\n1213:   }\n1214: \n1215:   request(method: string, params: unknown, timeoutMs: number): Promise<unknown> {\n1216:     const id = this.nextId++;\n1217:     const request = { jsonrpc: '2.0', id, method, params };\n1218:     return new Promise((resolve, reject) => {\n1219:       let buffer = '';\n1220:       let settled = false;\n1221: \n1222:       const cleanup = (): void => {\n1223:         clearTimeout(timer);\n1224:         this.socket.off('data', onData);\n1225:         this.socket.off('error', onError);\n1226:         this.socket.off('close', onClose);\n1227:       };\n1228:       const finish = (error: unknown, value?: unknown): void => {\n1229:         if (settled) return;\n1230:         settled = true;\n1231:         cleanup();\n1232:         if (error) {\n1233:           reject(error);\n1234:           return;\n1235:         }\n1236:         resolve(value);\n1237:       };\n1238:       const onData = (chunk: Buffer | string): void => {\n1239:         buffer += Buffer.isBuffer(chunk) ? this.decoder.write(chunk) : String(chunk ?? '');\n1240:         let newlineIndex = buffer.indexOf('\\n');\n1241:         while (newlineIndex !== -1) {\n1242:           const line = buffer.slice(0, newlineIndex).trim();\n1243:           buffer = buffer.slice(newlineIndex + 1);\n1244:           newlineIndex = buffer.indexOf('\\n');\n1245:           if (!line) continue;\n1246:           let parsed: JsonRpcResponse;\n1247:           try {\n1248:             parsed = JSON.parse(line) as JsonRpcResponse;\n1249:           } catch {\n1250:             continue;\n1251:           }\n1252:           if (parsed.id !== id) continue;\n1253:           if (parsed.error) {\n1254:             finish(new JsonRpcError(parsed.error));\n1255:             return;\n1256:           }\n1257:           finish(null, parsed.result);\n1258:           return;\n1259:         }\n1260:       };\n1261:       const onError = (error: Error): void => finish(error);\n1262:       const onClose = (): void => finish(new CliRetryableError('socket closed before response'));\n1263:       const timer = setTimeout(() => finish(new CliRetryableError(`${method} timed out`)), timeoutMs);\n1264:       timer.unref?.();\n1265: \n1266:       this.socket.on('data', onData);\n1267:       this.socket.once('error', onError);\n1268:       this.socket.once('close', onClose);\n1269:       this.socket.write(`${JSON.stringify(request)}\\n`);\n1270:     });\n1271:   }\n1272: \n1273:   close(): void {\n1274:     this.socket.end();\n1275:     this.socket.destroy();\n1276:   }\n1277: }\n1278: \n1279: function callerMeta(trusted: boolean): Record<string, unknown> {\n1280:   return {\n1281:     transport: 'cli',\n1282:     trusted,\n1283:     callerAuthority: trusted ? 'trusted' : 'untrusted',\n1284:     pid: process.pid,\n1285:     client: 'skill-advisor-cli',\n1286:   };\n1287: }\n1288: \n1289: // A daemon loads its code once at launch, so after a rebuild a live daemon still answers\n1290: // with the old code. Only a launched daemon counts: the lease carries a childPid once\n1291: // the launcher has started it, stamped after the launcher's own build.\n1292: function liveDaemonPredatesBuild(paths: RepoPaths): boolean {\n1293:   try {\n1294:     const lease = JSON.parse(readFileSync(path.join(paths.dbDir, LAUNCHER_LEASE_FILE_NAME), 'utf8')) as {\n1295:       childPid?: unknown;\n1296:       startedAt?: unknown;\n1297:     };\n1298:     if (!Number.isInteger(lease.childPid) || (lease.childPid as number) <= 0) return false;\n1299:     const launchedAtMs = Date.parse(typeof lease.startedAt === 'string' ? lease.startedAt : '');\n1300:     if (!Number.isFinite(launchedAtMs)) return false;\n1301:     const entrypoint = path.join(path.dirname(paths.packageJsonPath), 'dist', 'runtime', 'advisor-server.js');\n1302:     return statSync(entrypoint).mtimeMs > launchedAtMs;\n1303:   } catch {\n1304:     return false;\n1305:   }\n1306: }\n1307: \n1308: // A launcher started next to a stale daemon recycles it. The call waits for the lease to\n1309: // show the replacement rather than connecting to the daemon being retired. A launcher\n1310: // that exits with the old daemon still in place skipped the recycle, so the call uses\n1311: // that daemon as it always did.\n1312: async function waitForStaleDaemonRecycle(paths: RepoPaths, timeoutMs: number, launcher: ChildProcess): Promise<void> {\n1313:   const deadline = Date.now() + timeoutMs;\n1314:   let launcherExited = false;\n1315:   launcher.once('error', () => { launcherExited = true; });\n1316:   launcher.once('exit', () => { launcherExited = true; });\n1317:   while (Date.now() <= deadline && liveDaemonPredatesBuild(paths)) {\n1318:     if (launcherExited) return;\n1319:     await sleep(100);\n1320:   }\n1321: }\n1322: \n1323: // The deep probe doubles as the daemon's handshake, and its failure reason splits the\n1324: // two cases the cold-start budget must tell apart. A timeout means the daemon took the\n[Output truncated. Continue reading with offset: 1325]","title":"read","metadata":{"metadata":{"truncated":true},"content":[{"type":"text","text":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/skill-advisor-cli.ts, lines 1-1324\n1: #!/usr/bin/env node\n2: // ───────────────────────────────────────────────────────────────────\n3: // MODULE: SKILL ADVISOR CLI\n4: // ───────────────────────────────────────────────────────────────────\n5: \n6: // ───────────────────────────────────────────────────────────────────\n7: // 1. IMPORTS\n8: // ───────────────────────────────────────────────────────────────────\n9: import { spawn, type ChildProcess } from 'node:child_process';\n10: import { existsSync, mkdirSync, readFileSync, statSync } from 'node:fs';\n11: import net from 'node:net';\n12: import { createRequire } from 'node:module';\n13: import path from 'node:path';\n14: import { StringDecoder } from 'node:string_decoder';\n15: import { fileURLToPath } from 'node:url';\n16: \n17: import {\n18:   SKILL_ADVISOR_CLI_TOOL_MANIFEST,\n19:   type SkillAdvisorCliToolDefinition,\n20: } from './skill-advisor-cli-manifest.js';\n21: \n22: import { SKILL_ADVISOR_COMPAT_CONTRACT } from './lib/compat/contract.js';\n23: import { runAdvisorSubprocess, type AdvisorRecommendation } from './lib/subprocess.js';\n24: \n25: // ───────────────────────────────────────────────────────────────────\n26: // 2. CONSTANTS\n27: // ───────────────────────────────────────────────────────────────────\n28: const ADVISOR_PROTOCOL_VERSION = '1';\n29: const DEFAULT_TIMEOUT_MS = 30_000;\n30: const DEFAULT_SOCKET_DIR = '/tmp/system-skill-advisor';\n31: // A cold call starts the daemon and waits for it, but never past this. The measured\n32: // cold start is well inside it, and the stall this replaces came from waiting out the\n33: // tool timeout on a daemon that never accepted a connection — not from waiting at all.\n34: const COLD_START_WAIT_MS = 5_000;\n35: // The launcher's lease, which records when the running daemon was launched.\n36: const LAUNCHER_LEASE_FILE_NAME = '.system-skill-advisor-launcher.json';\n37: const ADVISOR_VALIDATE_MAX_ATTEMPTS = 3;\n38: const ADVISOR_VALIDATE_RETRY_BASE_DELAY_MS = 250;\n39: const RESERVED_COMMANDS = new Set(['list-tools', 'completion']);\n40: // The CLI's own last resort when no daemon answers: the checked-in Python scorer\n41: // still routes locally, so an unreachable daemon degrades a recommendation\n42: // instead of failing the call and leaving every caller to build this path again.\n43: const LOCAL_SCORER_TIMEOUT_MS = 5_000;\n44: const LOCAL_SCORER_SOURCE = 'local-scorer';\n45: // The same values are passed to the scorer and reported back, so the degraded\n46: // envelope cannot advertise a threshold the scorer did not apply.\n47: const LOCAL_SCORER_THRESHOLDS = {\n48:   confidenceThreshold: SKILL_ADVISOR_COMPAT_CONTRACT.defaults.confidenceThreshold,\n49:   uncertaintyThreshold: SKILL_ADVISOR_COMPAT_CONTRACT.defaults.uncertaintyThreshold,\n50:   confidenceOnly: false,\n51: } as const;\n52: \n53: const EXIT_SUCCESS = 0;\n54: const EXIT_RUNTIME = 1;\n55: const EXIT_USAGE = 64;\n56: const EXIT_PROTOCOL = 69;\n57: const EXIT_RETRYABLE = 75;\n58: \n59: // ───────────────────────────────────────────────────────────────────\n60: // 3. TYPE DEFINITIONS\n61: // ───────────────────────────────────────────────────────────────────\n62: type OutputFormat = 'json' | 'text' | 'jsonl';\n63: type ToolListMode = 'full' | 'compact' | 'names-only';\n64: type CompletionShell = 'bash' | 'zsh';\n65: \n66: interface ParsedCommand {\n67:   readonly command: string;\n68:   readonly format: OutputFormat;\n69:   readonly timeoutMs: number;\n70:   readonly sessionId?: string;\n71:   readonly warmOnly: boolean;\n72:   readonly toolListMode: ToolListMode;\n73:   readonly completionShell?: CompletionShell;\n74:   readonly args: Record<string, unknown>;\n75:   readonly jsonFromStdin?: boolean;\n76:   readonly help: boolean;\n77:   readonly version: boolean;\n78:   readonly trusted: boolean;\n79:   readonly promptTime: boolean;\n80: }\n81: \n82: interface CliIo {\n83:   readonly stdout: Pick<NodeJS.WriteStream, 'write'>;\n84:   readonly stderr: Pick<NodeJS.WriteStream, 'write'>;\n85:   readonly readStdin?: () => Promise<string>;\n86: }\n87: \n88: interface RepoPaths {\n89:   readonly opencodeDir: string;\n90:   readonly repoRoot: string;\n91:   readonly launcherPath: string;\n92:   readonly bridgePath: string;\n93:   readonly dbDir: string;\n94:   readonly packageJsonPath: string;\n95:   readonly packageLockPath: string;\n96: }\n97: \n98: interface BridgeProbeResult {\n99:   readonly status: string;\n100:   readonly reason?: string;\n101: }\n102: \n103: interface BridgeModule {\n104:   readonly getIpcSocketPath: (serviceName: string, options?: { dbDir?: string }) => string;\n105:   readonly maybeBridgeLeaseHolder: (options: unknown) => unknown;\n106:   readonly probeDaemon: (socketPath: string, options?: { timeoutMs?: number; deepProbe?: boolean }) => Promise<BridgeProbeResult>;\n107:   readonly toConnectionOptions: (socketPath: string) => string | net.NetConnectOpts;\n108: }\n109: \n110: interface JsonRpcResponse {\n111:   readonly jsonrpc?: string;\n112:   readonly id?: unknown;\n113:   readonly result?: unknown;\n114:   readonly error?: {\n115:     readonly code?: number;\n116:     readonly message?: string;\n117:     readonly data?: unknown;\n118:   };\n119: }\n120: \n121: interface InitializeResult {\n122:   readonly advisorProtocol?: string;\n123: }\n124: \n125: interface ToolPayloadResult {\n126:   readonly payload: unknown;\n127:   readonly isError: boolean;\n128: }\n129: \n130: interface RetryOptions {\n131:   readonly maxAttempts: number;\n132:   readonly sleepMsForAttempt: (attempt: number) => number;\n133:   readonly sleepFn?: (ms: number) => Promise<void>;\n134: }\n135: \n136: class CliUsageError extends Error {\n137:   constructor(message: string) {\n138:     super(message);\n139:     this.name = 'CliUsageError';\n140:   }\n141: }\n142: \n143: class CliRetryableError extends Error {\n144:   constructor(message: string) {\n145:     super(message);\n146:     this.name = 'CliRetryableError';\n147:   }\n148: }\n149: \n150: class CliProtocolError extends Error {\n151:   constructor(message: string) {\n152:     super(message);\n153:     this.name = 'CliProtocolError';\n154:   }\n155: }\n156: \n157: class ToolSchemaValidationError extends Error {\n158:   constructor(message: string) {\n159:     super(message);\n160:     this.name = 'ToolSchemaValidationError';\n161:   }\n162: }\n163: \n164: class JsonRpcError extends Error {\n165:   public readonly code?: number;\n166:   public readonly data?: unknown;\n167: \n168:   constructor(error: NonNullable<JsonRpcResponse['error']>) {\n169:     super(error.message ?? 'JSON-RPC request failed');\n170:     this.name = 'JsonRpcError';\n171:     this.code = error.code;\n172:     this.data = error.data;\n173:   }\n174: }\n175: \n176: // ───────────────────────────────────────────────────────────────────\n177: // 4. HELPERS\n178: // ───────────────────────────────────────────────────────────────────\n179: // Awaits drain when the kernel pipe buffer is full: a fire-and-forget\n180: // write followed by process.exit() truncates large payloads at the pipe\n181: // buffer boundary (observed as exactly 64KB on darwin). Streams without\n182: // emitter methods (test fakes) resolve immediately.\n183: async function writeLine(stream: Pick<NodeJS.WriteStream, 'write'>, value: string): Promise<void> {\n184:   const flushed = stream.write(`${value}\\n`);\n185:   if (flushed) return;\n186:   const drainable = stream as Pick<NodeJS.WriteStream, 'write'> & Partial<Pick<NodeJS.WriteStream, 'once' | 'off'>>;\n187:   if (typeof drainable.once !== 'function') return;\n188:   await new Promise<void>((resolve) => {\n189:     const settle = (): void => {\n190:       drainable.off?.('drain', settle);\n191:       drainable.off?.('error', settle);\n192:       drainable.off?.('close', settle);\n193:       resolve();\n194:     };\n195:     drainable.once?.('drain', settle);\n196:     drainable.once?.('error', settle);\n197:     drainable.once?.('close', settle);\n198:   });\n199: }\n200: \n201: function currentModulePath(): string {\n202:   return fileURLToPath(import.meta.url);\n203: }\n204: \n205: // The source tree sits under .skilled or .opencode, and a checkout may link one name\n206: // to the other, so the launcher assets count under either name.\n207: const SOURCE_ROOT_NAMES: readonly string[] = ['.skilled', '.opencode'];\n208: \n209: function findRepoPaths(startFile = currentModulePath()): RepoPaths {\n210:   let current = path.dirname(startFile);\n211: \n212:   while (true) {\n213:     const sourceRootDirs = SOURCE_ROOT_NAMES.includes(path.basename(current))\n214:       ? [current]\n215:       : SOURCE_ROOT_NAMES.map((name) => path.join(current, name));\n216:     for (const directOpencodeDir of sourceRootDirs) {\n217:       const launcherPath = path.join(directOpencodeDir, 'bin', 'system-skill-advisor-launcher.cjs');\n218:       const bridgePath = path.join(directOpencodeDir, 'bin', 'lib', 'launcher-ipc-bridge.cjs');\n219:       if (existsSync(launcherPath) && existsSync(bridgePath)) {\n220:         const repoRoot = path.dirname(directOpencodeDir);\n221:         const mcpServerDir = path.join(directOpencodeDir, 'skills', 'system-skill-advisor', 'runtime');\n222:         const configuredDbDir = process.env.SYSTEM_SKILL_ADVISOR_DB_DIR;\n223:         return {\n224:           opencodeDir: directOpencodeDir,\n225:           repoRoot,\n226:           launcherPath,\n227:           bridgePath,\n228:           dbDir: configuredDbDir ? path.resolve(repoRoot, configuredDbDir) : path.join(mcpServerDir, 'database'),\n229:           packageJsonPath: path.join(mcpServerDir, 'package.json'),\n230:           packageLockPath: path.join(mcpServerDir, 'package-lock.json'),\n231:         };\n232:       }\n233:     }\n234: \n235:     const parent = path.dirname(current);\n236:     if (parent === current) {\n237:       throw new CliProtocolError('Unable to locate .skilled/bin or .opencode/bin launcher assets from CLI path');\n238:     }\n239:     current = parent;\n240:   }\n241: }\n242: \n243: function loadBridge(paths: RepoPaths): BridgeModule {\n244:   const require = createRequire(import.meta.url);\n245:   const bridge = require(paths.bridgePath) as Partial<BridgeModule>;\n246:   if (\n247:     typeof bridge.getIpcSocketPath !== 'function'\n248:     || typeof bridge.maybeBridgeLeaseHolder !== 'function'\n249:     || typeof bridge.probeDaemon !== 'function'\n250:     || typeof bridge.toConnectionOptions !== 'function'\n251:   ) {\n252:     throw new CliProtocolError('launcher IPC bridge does not expose the expected helper contract');\n253:   }\n254:   return bridge as BridgeModule;\n255: }\n256: \n257: function readJsonFile(filePath: string): Record<string, unknown> | null {\n258:   try {\n259:     return JSON.parse(readFileSync(filePath, 'utf8')) as Record<string, unknown>;\n260:   } catch {\n261:     return null;\n262:   }\n263: }\n264: \n265: function readCliVersion(paths: RepoPaths): string {\n266:   const packageJson = existsSync(paths.packageJsonPath) ? readJsonFile(paths.packageJsonPath) : null;\n267:   if (typeof packageJson?.version === 'string') return packageJson.version;\n268:   const packageLock = existsSync(paths.packageLockPath) ? readJsonFile(paths.packageLockPath) : null;\n269:   if (typeof packageLock?.version === 'string') return packageLock.version;\n270:   return '0.0.0';\n271: }\n272: \n273: function normalizeName(value: string): string {\n274:   return value.replace(/[-_]/g, '').toLowerCase();\n275: }\n276: \n277: function toCamelCaseFlag(value: string): string {\n278:   return value.replace(/-([a-z0-9])/g, (_match, char: string) => char.toUpperCase());\n279: }\n280: \n281: function setCommandAlias(map: Map<string, SkillAdvisorCliToolDefinition>, alias: string, tool: SkillAdvisorCliToolDefinition): void {\n282:   const existing = map.get(alias);\n283:   if (existing && existing.name !== tool.name) {\n284:     throw new CliProtocolError(`Command alias collision: ${alias} maps to ${existing.name} and ${tool.name}`);\n285:   }\n286:   map.set(alias, tool);\n287: }\n288: \n289: function commandMap(): Map<string, SkillAdvisorCliToolDefinition> {\n290:   const map = new Map<string, SkillAdvisorCliToolDefinition>();\n291:   for (const tool of SKILL_ADVISOR_CLI_TOOL_MANIFEST) {\n292:     for (const alias of tool.aliases) {\n293:       setCommandAlias(map, alias, tool);\n294:       setCommandAlias(map, normalizeName(alias), tool);\n295:     }\n296:   }\n297:   return map;\n298: }\n299: \n300: function getToolDefinition(command: string): SkillAdvisorCliToolDefinition | null {\n301:   return commandMap().get(command) ?? commandMap().get(normalizeName(command)) ?? null;\n302: }\n303: \n304: function inputPropertyNames(tool: SkillAdvisorCliToolDefinition): string[] {\n305:   const schema = tool.inputSchema;\n306:   const properties = typeof schema === 'object' && schema !== null && !Array.isArray(schema)\n307:     ? (schema as { readonly properties?: unknown }).properties\n308:     : null;\n309:   if (!properties || typeof properties !== 'object' || Array.isArray(properties)) return [];\n310:   return Object.keys(properties);\n311: }\n312: \n313: function resolvePropertyName(rawFlag: string, tool: SkillAdvisorCliToolDefinition): string {\n314:   const exact = inputPropertyNames(tool).find((name) => name === rawFlag);\n315:   if (exact) return exact;\n316: \n317:   const normalized = normalizeName(rawFlag);\n318:   const matched = inputPropertyNames(tool).find((name) => normalizeName(name) === normalized);\n319:   if (matched) return matched;\n320: \n321:   return rawFlag.includes('-') ? toCamelCaseFlag(rawFlag) : rawFlag;\n322: }\n323: \n324: function parseValue(raw: string): unknown {\n325:   const trimmed = raw.trim();\n326:   if (trimmed === 'true') return true;\n327:   if (trimmed === 'false') return false;\n328:   if (trimmed === 'null') return null;\n329:   if (/^-?(?:\\d+|\\d*\\.\\d+)(?:e[+-]?\\d+)?$/i.test(trimmed)) {\n330:     const parsed = Number(trimmed);\n331:     if (Number.isFinite(parsed)) return parsed;\n332:   }\n333:   if ((trimmed.startsWith('{') && trimmed.endsWith('}')) || (trimmed.startsWith('[') && trimmed.endsWith(']'))) {\n334:     try {\n335:       return JSON.parse(trimmed) as unknown;\n336:     } catch (error: unknown) {\n337:       const message = error instanceof Error ? error.message : String(error);\n338:       throw new CliUsageError(`Invalid JSON value: ${message}`);\n339:     }\n340:   }\n341:   return raw;\n342: }\n343: \n344: function parsePositiveInteger(raw: string, flagName: string): number {\n345:   if (!/^\\d+$/.test(raw)) {\n346:     throw new CliUsageError(`${flagName} must be a positive integer`);\n347:   }\n348:   const value = Number.parseInt(raw, 10);\n349:   if (!Number.isFinite(value) || value <= 0) {\n350:     throw new CliUsageError(`${flagName} must be a positive integer`);\n351:   }\n352:   return value;\n353: }\n354: \n355: function parseFormat(raw: string): OutputFormat {\n356:   if (raw === 'json' || raw === 'text' || raw === 'jsonl') return raw;\n357:   throw new CliUsageError('--format must be one of: json, text, jsonl');\n358: }\n359: \n360: function parseInlineBoolean(raw: string, flagName: string): boolean {\n361:   if (raw === 'true' || raw === '1') return true;\n362:   if (raw === 'false' || raw === '0') return false;\n363:   throw new CliUsageError(`${flagName} must be true or false`);\n364: }\n365: \n366: function readOptionValue(tokens: string[], index: number, flagName: string): { readonly value: string; readonly nextIndex: number } {\n367:   const inline = tokens[index].match(/^--[^=]+=(.*)$/);\n368:   if (inline) return { value: inline[1], nextIndex: index + 1 };\n369:   const value = tokens[index + 1];\n370:   if (value === undefined) {\n371:     throw new CliUsageError(`${flagName} requires a value`);\n372:   }\n373:   return { value, nextIndex: index + 2 };\n374: }\n375: \n376: function parseJsonObject(raw: string): Record<string, unknown> {\n377:   let parsed: unknown;\n378:   try {\n379:     parsed = JSON.parse(raw) as unknown;\n380:   } catch (error: unknown) {\n381:     const message = error instanceof Error ? error.message : String(error);\n382:     throw new CliUsageError(`--json must be a valid JSON object: ${message}`);\n383:   }\n384:   if (!parsed || typeof parsed !== 'object' || Array.isArray(parsed)) {\n385:     throw new CliUsageError('--json must be a JSON object');\n386:   }\n387:   return parsed as Record<string, unknown>;\n388: }\n389: \n390: // `--json -` reads the payload here, so a caller can keep a prompt out of\n391: // argv, which any local user can read from the process table.\n392: async function readProcessStdin(): Promise<string> {\n393:   process.stdin.setEncoding('utf8');\n394:   let text = '';\n395:   for await (const chunk of process.stdin) text += String(chunk);\n396:   return text;\n397: }\n398: \n399: function envTrustedDefault(): boolean {\n400:   return process.env.SYSTEM_SKILL_ADVISOR_CLI_TRUSTED === '1'\n401:     || process.env.SPECKIT_SKILL_ADVISOR_CLI_TRUSTED === '1';\n402: }\n403: \n404: function envFlagEnabled(name: string): boolean {\n405:   const raw = process.env[name];\n406:   if (raw === undefined || raw === null) return false;\n407:   return ['1', 'true', 'yes', 'on'].includes(raw.trim().toLowerCase());\n408: }\n409: \n410: // Prompt-time markers (the env this front-door is launched with from a runtime hook).\n411: // Warm-only and prompt-time are orthogonal: warm-only just suppresses cold spawn, while\n412: // prompt-time additionally forbids shared-state mutations regardless of trusted authority,\n413: // because a hook process must never be the thing that scans/rebuilds the skill graph.\n414: function defaultPromptTime(): boolean {\n415:   return envFlagEnabled('SYSTEM_SKILL_ADVISOR_CLI_PROMPT_TIME')\n416:     || envFlagEnabled('SPECKIT_SKILL_ADVISOR_CLI_PROMPT_TIME')\n417:     || envFlagEnabled('SPECKIT_CLI_PROMPT_TIME')\n418:     || envFlagEnabled('OPENCODE_PROMPT_TIME')\n419:     || envFlagEnabled('CLAUDE_CODE_PROMPT_TIME');\n420: }\n421: \n422: function defaultWarmOnly(): boolean {\n423:   return envFlagEnabled('SYSTEM_SKILL_ADVISOR_CLI_WARM_ONLY')\n424:     || envFlagEnabled('SPECKIT_SKILL_ADVISOR_CLI_WARM_ONLY')\n425:     || defaultPromptTime();\n426: }\n427: \n428: export function parseCliArgs(argv: string[]): ParsedCommand {\n429:   const command = argv[0];\n430:   const trustedDefault = envTrustedDefault();\n431:   const warmOnlyDefault = defaultWarmOnly();\n432:   const promptTimeDefault = defaultPromptTime();\n433:   if (!command || command === '--help' || command === '-h') {\n434:     return { command: '', format: 'text', timeoutMs: DEFAULT_TIMEOUT_MS, warmOnly: warmOnlyDefault, toolListMode: 'full', args: {}, help: true, version: false, trusted: trustedDefault, promptTime: promptTimeDefault };\n435:   }\n436:   if (command === '--version' || command === '-v') {\n437:     return { command: '', format: 'text', timeoutMs: DEFAULT_TIMEOUT_MS, warmOnly: warmOnlyDefault, toolListMode: 'full', args: {}, help: false, version: true, trusted: trustedDefault, promptTime: promptTimeDefault };\n438:   }\n439: \n440:   let format: OutputFormat = 'json';\n441:   let timeoutMs = DEFAULT_TIMEOUT_MS;\n442:   let sessionId: string | undefined;\n443:   let warmOnly = warmOnlyDefault;\n444:   let toolListMode: ToolListMode = 'full';\n445:   let completionShell: CompletionShell | undefined;\n446:   let jsonPayload: Record<string, unknown> | null = null;\n447:   let jsonFromStdin = false;\n448:   let trusted = trustedDefault;\n449:   let promptTime = promptTimeDefault;\n450:   const tool = getToolDefinition(command);\n451:   const parsedArgs: Record<string, unknown> = {};\n452:   const tokens = argv.slice(1);\n453:   let index = 0;\n454: \n455:   while (index < tokens.length) {\n456:     const token = tokens[index];\n457:     if (command === 'completion' && completionShell === undefined && !token.startsWith('--')) {\n458:       completionShell = parseCompletionShell(token);\n459:       index += 1;\n460:       continue;\n461:     }\n462:     if (!token.startsWith('--')) {\n463:       throw new CliUsageError(`Unexpected positional argument: ${token}`);\n464:     }\n465:     const rawFlag = token.slice(2).split('=', 1)[0];\n466:     const option = `--${rawFlag}`;\n467: \n468:     if (rawFlag === 'help' || rawFlag === 'h') {\n469:       return { command, format: 'text', timeoutMs, sessionId, warmOnly, toolListMode, completionShell, args: {}, help: true, version: false, trusted, promptTime };\n470:     }\n471:     if (rawFlag === 'format') {\n472:       const read = readOptionValue(tokens, index, option);\n473:       format = parseFormat(read.value);\n474:       index = read.nextIndex;\n475:       continue;\n476:     }\n477:     if (rawFlag === 'timeout-ms') {\n478:       const read = readOptionValue(tokens, index, option);\n479:       timeoutMs = parsePositiveInteger(read.value, option);\n480:       index = read.nextIndex;\n481:       continue;\n482:     }\n483:     if (rawFlag === 'session-id') {\n484:       const read = readOptionValue(tokens, index, option);\n485:       sessionId = read.value;\n486:       index = read.nextIndex;\n487:       continue;\n488:     }\n489:     if (rawFlag === 'json') {\n490:       const read = readOptionValue(tokens, index, option);\n491:       if (read.value === '-') {\n492:         jsonFromStdin = true;\n493:       } else {\n494:         jsonPayload = parseJsonObject(read.value);\n495:       }\n496:       index = read.nextIndex;\n497:       continue;\n498:     }\n499:     if (rawFlag === 'trusted' || rawFlag === 'maintainer') {\n500:       const inline = token.match(/^--[^=]+=(.*)$/);\n501:       trusted = inline ? parseInlineBoolean(inline[1], option) : true;\n502:       index += 1;\n503:       continue;\n504:     }\n505:     if (rawFlag === 'untrusted') {\n506:       trusted = false;\n507:       index += 1;\n508:       continue;\n509:     }\n510:     if (rawFlag === 'prompt-time') {\n511:       const inline = token.match(/^--[^=]+=(.*)$/);\n512:       promptTime = inline ? parseInlineBoolean(inline[1], option) : true;\n513:       index += 1;\n514:       continue;\n515:     }\n516:     if (rawFlag === 'no-prompt-time') {\n517:       promptTime = false;\n518:       index += 1;\n519:       continue;\n520:     }\n521:     if (rawFlag === 'compact') {\n522:       toolListMode = 'compact';\n523:       index += 1;\n524:       continue;\n525:     }\n526:     if (rawFlag === 'names-only') {\n527:       toolListMode = 'names-only';\n528:       index += 1;\n529:       continue;\n530:     }\n531:     if (rawFlag === 'warm-only') {\n532:       const inline = token.match(/^--[^=]+=(.*)$/);\n533:       warmOnly = inline ? parseInlineBoolean(inline[1], option) : true;\n534:       index += 1;\n535:       continue;\n536:     }\n537:     if (rawFlag === 'no-warm-only') {\n538:       warmOnly = false;\n539:       index += 1;\n540:       continue;\n541:     }\n542: \n543:     if (!tool) {\n544:       throw new CliUsageError(`Unknown command: ${command}`);\n545:     }\n546: \n547:     const propertyName = resolvePropertyName(rawFlag, tool);\n548:     const inline = token.match(/^--[^=]+=(.*)$/);\n549:     if (inline) {\n550:       parsedArgs[propertyName] = parseValue(inline[1]);\n551:       index += 1;\n552:       continue;\n553:     }\n554: \n555:     const next = tokens[index + 1];\n556:     if (next === undefined || next.startsWith('--')) {\n557:       parsedArgs[propertyName] = true;\n558:       index += 1;\n559:       continue;\n560:     }\n561:     parsedArgs[propertyName] = parseValue(next);\n562:     index += 2;\n563:   }\n564: \n565:   if ((jsonPayload || jsonFromStdin) && Object.keys(parsedArgs).length > 0) {\n566:     throw new CliUsageError('--json cannot be combined with per-parameter flags');\n567:   }\n568: \n569:   return {\n570:     command,\n571:     format,\n572:     timeoutMs,\n573:     sessionId,\n574:     warmOnly,\n575:     toolListMode,\n576:     completionShell,\n577:     args: jsonPayload ?? parsedArgs,\n578:     ...(jsonFromStdin ? { jsonFromStdin: true } : {}),\n579:     help: false,\n580:     version: false,\n581:     trusted,\n582:     promptTime,\n583:   };\n584: }\n585: \n586: function isRecord(value: unknown): value is Record<string, unknown> {\n587:   return value !== null && typeof value === 'object' && !Array.isArray(value);\n588: }\n589: \n590: function schemaTypes(schema: Record<string, unknown>): string[] {\n591:   const type = schema.type;\n592:   if (typeof type === 'string') return [type];\n593:   if (Array.isArray(type) && type.every((entry) => typeof entry === 'string')) return type as string[];\n594:   return [];\n595: }\n596: \n597: function coerceValueForSchema(schema: unknown, value: unknown): unknown {\n598:   if (!isRecord(schema)) return value;\n599:   const types = schemaTypes(schema);\n600:   if (types.includes('number') && typeof value === 'string') {\n601:     const parsed = Number(value);\n602:     if (Number.isFinite(parsed)) return parsed;\n603:   }\n604:   if (types.includes('boolean') && typeof value === 'string') {\n605:     if (value === 'true') return true;\n606:     if (value === 'false') return false;\n607:   }\n608:   if (types.includes('object') && isRecord(value) && isRecord(schema.properties)) {\n609:     return coerceObjectForSchema(schema, value);\n610:   }\n611:   if (types.includes('array') && Array.isArray(value)) {\n612:     return value.map((entry) => coerceValueForSchema(schema.items, entry));\n613:   }\n614:   return value;\n615: }\n616: \n617: function coerceObjectForSchema(schema: Record<string, unknown>, args: Record<string, unknown>): Record<string, unknown> {\n618:   if (!isRecord(schema.properties)) return args;\n619:   const coerced: Record<string, unknown> = { ...args };\n620:   for (const [key, value] of Object.entries(args)) {\n621:     coerced[key] = coerceValueForSchema(schema.properties[key], value);\n622:   }\n623:   return coerced;\n624: }\n625: \n626: function expectedTypeLabel(types: string[]): string {\n627:   return types.length > 0 ? types.join(' or ') : 'valid JSON schema value';\n628: }\n629: \n630: function valueType(value: unknown): string {\n631:   if (value === null) return 'null';\n632:   if (Array.isArray(value)) return 'array';\n633:   return typeof value;\n634: }\n635: \n636: function valueMatchesTypes(value: unknown, types: string[]): boolean {\n637:   if (types.length === 0) return true;\n638:   return types.some((type) => {\n639:     if (type === 'null') return value === null;\n640:     if (type === 'array') return Array.isArray(value);\n641:     if (type === 'object') return isRecord(value);\n642:     if (type === 'number') return typeof value === 'number' && Number.isFinite(value);\n643:     if (type === 'integer') return Number.isInteger(value);\n644:     return typeof value === type;\n645:   });\n646: }\n647: \n648: function validateJsonSchema(schema: unknown, value: unknown, location: string): void {\n649:   if (!isRecord(schema)) return;\n650:   const types = schemaTypes(schema);\n651:   if (!valueMatchesTypes(value, types)) {\n652:     throw new ToolSchemaValidationError(`${location} expected ${expectedTypeLabel(types)}, received ${valueType(value)}`);\n653:   }\n654: \n655:   if (Object.prototype.hasOwnProperty.call(schema, 'const') && value !== schema.const) {\n656:     throw new ToolSchemaValidationError(`${location} must be ${JSON.stringify(schema.const)}`);\n657:   }\n658:   if (Array.isArray(schema.enum) && !schema.enum.includes(value)) {\n659:     throw new ToolSchemaValidationError(`${location} must be one of: ${schema.enum.map(String).join(', ')}`);\n660:   }\n661: \n662:   if (typeof value === 'string') {\n663:     if (typeof schema.minLength === 'number' && value.length < schema.minLength) {\n664:       throw new ToolSchemaValidationError(`${location} must be at least ${schema.minLength} character(s)`);\n665:     }\n666:     if (typeof schema.maxLength === 'number' && value.length > schema.maxLength) {\n667:       throw new ToolSchemaValidationError(`${location} must be at most ${schema.maxLength} character(s)`);\n668:     }\n669:   }\n670: \n671:   if (typeof value === 'number') {\n672:     if (typeof schema.minimum === 'number' && value < schema.minimum) {\n673:       throw new ToolSchemaValidationError(`${location} must be >= ${schema.minimum}`);\n674:     }\n675:     if (typeof schema.maximum === 'number' && value > schema.maximum) {\n676:       throw new ToolSchemaValidationError(`${location} must be <= ${schema.maximum}`);\n677:     }\n678:   }\n679: \n680:   if (Array.isArray(value)) {\n681:     if (typeof schema.minItems === 'number' && value.length < schema.minItems) {\n682:       throw new ToolSchemaValidationError(`${location} must contain at least ${schema.minItems} item(s)`);\n683:     }\n684:     if (typeof schema.maxItems === 'number' && value.length > schema.maxItems) {\n685:       throw new ToolSchemaValidationError(`${location} must contain at most ${schema.maxItems} item(s)`);\n686:     }\n687:     value.forEach((entry, index) => validateJsonSchema(schema.items, entry, `${location}[${index}]`));\n688:   }\n689: \n690:   if (isRecord(value)) {\n691:     const properties = isRecord(schema.properties) ? schema.properties : {};\n692:     const required = Array.isArray(schema.required) ? schema.required.filter((entry): entry is string => typeof entry === 'string') : [];\n693:     for (const key of required) {\n694:       if (!Object.prototype.hasOwnProperty.call(value, key)) {\n695:         throw new ToolSchemaValidationError(`${location}.${key} is required`);\n696:       }\n697:     }\n698:     if (schema.additionalProperties === false) {\n699:       const unknownKeys = Object.keys(value).filter((key) => !Object.prototype.hasOwnProperty.call(properties, key));\n700:       if (unknownKeys.length > 0) {\n701:         throw new ToolSchemaValidationError(`Unknown parameter(s): ${unknownKeys.join(', ')}`);\n702:       }\n703:     }\n704:     for (const [key, nestedValue] of Object.entries(value)) {\n705:       if (Object.prototype.hasOwnProperty.call(properties, key)) {\n706:         validateJsonSchema(properties[key], nestedValue, `${location}.${key}`);\n707:       }\n708:     }\n709:   }\n710: }\n711: \n712: function formatValidationMessage(error: unknown): string {\n713:   if (error instanceof ToolSchemaValidationError) return error.message;\n714:   if (error instanceof Error) return error.message;\n715:   return String(error);\n716: }\n717: \n718: function applySchemaDefaults(schema: unknown, args: Record<string, unknown>): Record<string, unknown> {\n719:   if (!isRecord(schema) || !isRecord(schema.properties)) return args;\n720:   const withDefaults: Record<string, unknown> = { ...args };\n721:   for (const [key, propertySchema] of Object.entries(schema.properties)) {\n722:     if (Object.prototype.hasOwnProperty.call(withDefaults, key)) continue;\n723:     if (isRecord(propertySchema) && Object.prototype.hasOwnProperty.call(propertySchema, 'default')) {\n724:       withDefaults[key] = propertySchema.default;\n725:     }\n726:   }\n727:   return withDefaults;\n728: }\n729: \n730: function validateToolArgs(tool: SkillAdvisorCliToolDefinition, args: Record<string, unknown>): Record<string, unknown> {\n731:   const coerced = coerceObjectForSchema(tool.inputSchema, applySchemaDefaults(tool.inputSchema, args));\n732:   try {\n733:     validateJsonSchema(tool.inputSchema, coerced, tool.name);\n734:   } catch (error: unknown) {\n735:     throw new ToolSchemaValidationError(`Invalid arguments for ${tool.name}: ${formatValidationMessage(error)}`);\n736:   }\n737:   return coerced;\n738: }\n739: \n740: function isPropagateApply(args: Record<string, unknown>): boolean {\n741:   return args.mode === 'apply' && args.dryRun !== true;\n742: }\n743: \n744: function assertTrustedForMutation(toolName: string, args: Record<string, unknown>, trusted: boolean, promptTime: boolean): void {\n745:   const requiresTrusted = toolName === 'advisor_rebuild'\n746:     || toolName === 'skill_graph_scan'\n747:     || (toolName === 'skill_graph_propagate_enhances' && isPropagateApply(args));\n748:   if (!requiresTrusted) return;\n749:   // Defense-in-depth: a prompt-time hook process must never run a shared-state mutation,\n750:   // even if it also asserts trusted authority — the documented hook convention forbids it,\n751:   // so the front-door enforces it structurally instead of trusting every wrapper to pass\n752:   // only read tools.\n753:   if (promptTime) {\n754:     throw new CliUsageError(`${toolName} is blocked at prompt-time (mutations require a non-prompt-time, trusted invocation)`);\n755:   }\n756:   if (trusted) return;\n757:   throw new CliUsageError(`${toolName} requires --trusted or SYSTEM_SKILL_ADVISOR_CLI_TRUSTED=1`);\n758: }\n759: \n760: function validateCommand(parsed: ParsedCommand): { readonly tool: SkillAdvisorCliToolDefinition; readonly args: Record<string, unknown> } | null {\n761:   if (RESERVED_COMMANDS.has(parsed.command)) return null;\n762:   const tool = getToolDefinition(parsed.command);\n763:   if (!tool) {\n764:     throw new CliUsageError(`Unknown command: ${parsed.command}`);\n765:   }\n766: \n767:   const args = { ...parsed.args };\n768:   const properties = new Set(inputPropertyNames(tool));\n769:   if (parsed.sessionId && !Object.prototype.hasOwnProperty.call(args, 'sessionId') && properties.has('sessionId')) {\n770:     args.sessionId = parsed.sessionId;\n771:   } else if (parsed.sessionId && !Object.prototype.hasOwnProperty.call(args, 'session_id') && properties.has('session_id')) {\n772:     args.session_id = parsed.sessionId;\n773:   }\n774: \n775:   const validated = validateToolArgs(tool, args);\n776:   assertTrustedForMutation(tool.name, validated, parsed.trusted, parsed.promptTime);\n777:   return { tool, args: validated };\n778: }\n779: \n780: function renderJson(value: unknown, format: OutputFormat): string {\n781:   if (format === 'jsonl') return JSON.stringify(value);\n782:   return JSON.stringify(value, null, 2);\n783: }\n784: \n785: function usageText(command?: string): string {\n786:   const tool = command ? getToolDefinition(command) : null;\n787:   if (tool) {\n788:     return `skill-advisor ${tool.command}\n789: \n790: Description:\n791:   ${tool.description}\n792: \n793: Aliases:\n794:   ${tool.aliases.join(', ')}\n795: \n796: Input schema:\n797: ${JSON.stringify(tool.inputSchema, null, 2)}`;\n798:   }\n799: \n800:   const commands = SKILL_ADVISOR_CLI_TOOL_MANIFEST\n801:     .map((entry) => `  ${entry.command} (${entry.kebabCommand}, ${entry.camelCommand})`)\n802:     .join('\\n');\n803: \n804:   return `skill-advisor - daemon-backed CLI for system-skill-advisor\n805: \n806: Usage:\n807:   skill-advisor list-tools [--format json|text|jsonl] [--compact|--names-only]\n808:   skill-advisor completion bash|zsh\n809:   skill-advisor <tool_name> [--json '{...}' | --json -] [--format json|text|jsonl] [--timeout-ms N] [--trusted] [--warm-only]\n810:   skill-advisor <tool_name> --param value [--another-param value]\n811: \n812: Commands:\n813: ${commands}\n814: \n815: Examples:\n816:   skill-advisor list-tools --format text\n817:   skill-advisor list-tools --compact\n818:   skill-advisor completion zsh\n819:   skill-advisor advisor_status --workspace-root \"$PWD\" --format text\n820:   skill-advisor advisor_recommend --prompt \"implement cli core\"\n821:   printf '%s' '{\"prompt\":\"implement cli core\"}' | skill-advisor advisor_recommend --json -\n822:   skill-advisor advisor_rebuild --trusted --force true\n823:   skill-advisor skill_graph_scan --trusted --format text\n824: \n825: Trusted context:\n826:   Mutation commands require --trusted or SYSTEM_SKILL_ADVISOR_CLI_TRUSTED=1.\n827:   Calls are sent as untrusted by default.\n828: \n829: Exit codes:\n830:   0 success, 1 runtime error, 64 usage/schema error, 69 protocol mismatch, 75 retryable daemon error`;\n831: }\n832: \n833: function parseCompletionShell(raw: string): CompletionShell {\n834:   if (raw === 'bash' || raw === 'zsh') return raw;\n835:   throw new CliUsageError('completion shell must be one of: bash, zsh');\n836: }\n837: \n838: function compactTool(tool: SkillAdvisorCliToolDefinition): Record<string, unknown> {\n839:   return {\n840:     name: tool.name,\n841:     command: tool.command,\n842:     kebabCommand: tool.kebabCommand,\n843:     camelCommand: tool.camelCommand,\n844:     aliases: tool.aliases,\n845:     description: tool.description,\n846:   };\n847: }\n848: \n849: function renderToolList(format: OutputFormat, mode: ToolListMode = 'full'): string {\n850:   const payload = {\n851:     status: 'ok',\n852:     data: {\n853:       count: SKILL_ADVISOR_CLI_TOOL_MANIFEST.length,\n854:       mode,\n855:       tools: SKILL_ADVISOR_CLI_TOOL_MANIFEST.map((tool) => ({\n856:         name: tool.name,\n857:         command: tool.command,\n858:         kebabCommand: tool.kebabCommand,\n859:         camelCommand: tool.camelCommand,\n860:         description: tool.description,\n861:         inputSchema: tool.inputSchema,\n862:       })),\n863:     },\n864:   };\n865:   const compactPayload = {\n866:     status: 'ok',\n867:     data: {\n868:       count: SKILL_ADVISOR_CLI_TOOL_MANIFEST.length,\n869:       mode,\n870:       tools: SKILL_ADVISOR_CLI_TOOL_MANIFEST.map(compactTool),\n871:     },\n872:   };\n873:   const namesOnlyPayload = {\n874:     status: 'ok',\n875:     data: {\n876:       count: SKILL_ADVISOR_CLI_TOOL_MANIFEST.length,\n877:       mode,\n878:       names: SKILL_ADVISOR_CLI_TOOL_MANIFEST.map((tool) => tool.name),\n879:     },\n880:   };\n881: \n882:   if (format === 'text') {\n883:     return SKILL_ADVISOR_CLI_TOOL_MANIFEST.map((tool) => tool.name).join('\\n');\n884:   }\n885:   if (mode === 'compact') return renderJson(compactPayload, format);\n886:   if (mode === 'names-only') return renderJson(namesOnlyPayload, format);\n887:   return renderJson(payload, format);\n888: }\n889: \n890: function completionWords(): string[] {\n891:   return ['list-tools', 'completion', ...SKILL_ADVISOR_CLI_TOOL_MANIFEST.map((tool) => tool.name)];\n892: }\n893: \n894: function shellWords(words: readonly string[]): string {\n895:   return words.join(' ');\n896: }\n897: \n898: function renderBashCompletion(): string {\n899:   const commands = shellWords(completionWords());\n900:   const commonFlags = shellWords(['--help', '--format', '--json', '--timeout-ms', '--session-id', '--trusted', '--untrusted', '--warm-only', '--no-warm-only']);\n901:   const listFlags = shellWords(['--help', '--format', '--compact', '--names-only']);\n902:   return `_skill_advisor_completion() {\n903:   local cur\n904:   COMPREPLY=()\n905:   cur=\"\\${COMP_WORDS[COMP_CWORD]}\"\n906:   if [[ \\${COMP_CWORD} -eq 1 ]]; then\n907:     COMPREPLY=( $(compgen -W \"${commands}\" -- \"\\${cur}\") )\n908:     return 0\n909:   fi\n910:   case \"\\${COMP_WORDS[1]}\" in\n911:     completion) COMPREPLY=( $(compgen -W \"bash zsh\" -- \"\\${cur}\") ) ;;\n912:     list-tools) COMPREPLY=( $(compgen -W \"${listFlags}\" -- \"\\${cur}\") ) ;;\n913:     *) COMPREPLY=( $(compgen -W \"${commonFlags}\" -- \"\\${cur}\") ) ;;\n914:   esac\n915: }\n916: complete -F _skill_advisor_completion skill-advisor`;\n917: }\n918: \n919: function renderZshCompletion(): string {\n920:   const commands = shellWords(completionWords());\n921:   const commonFlags = shellWords(['--help', '--format', '--json', '--timeout-ms', '--session-id', '--trusted', '--untrusted', '--warm-only', '--no-warm-only']);\n922:   const listFlags = shellWords(['--help', '--format', '--compact', '--names-only']);\n923:   return `#compdef skill-advisor\n924: _skill_advisor() {\n925:   local -a commands common_flags list_flags shells\n926:   commands=(${commands})\n927:   common_flags=(${commonFlags})\n928:   list_flags=(${listFlags})\n929:   shells=(bash zsh)\n930:   if (( CURRENT == 2 )); then\n931:     _describe 'commands' commands\n932:     return\n933:   fi\n934:   case \\${words[2]} in\n935:     completion) _describe 'shells' shells ;;\n936:     list-tools) _describe 'flags' list_flags ;;\n937:     *) _describe 'flags' common_flags ;;\n938:   esac\n939: }\n940: _skill_advisor \"$@\"`;\n941: }\n942: \n943: function renderCompletion(shell: CompletionShell): string {\n944:   return shell === 'bash' ? renderBashCompletion() : renderZshCompletion();\n945: }\n946: \n947: function isErrorPayload(payload: unknown): boolean {\n948:   return isRecord(payload) && payload.status === 'error';\n949: }\n950: \n951: function extractToolPayload(result: unknown): ToolPayloadResult {\n952:   return {\n953:     payload: result,\n954:     isError: isErrorPayload(result),\n955:   };\n956: }\n957: \n958: function getDataRecord(payload: unknown): Record<string, unknown> | null {\n959:   if (!isRecord(payload) || !isRecord(payload.data)) return null;\n960:   return payload.data;\n961: }\n962: \n963: function renderJobText(toolName: string, payload: unknown): string | null {\n964:   const data = getDataRecord(payload);\n965:   if (!data) return null;\n966: \n967:   if (toolName === 'advisor_rebuild') {\n968:     return [\n969:       `advisor_rebuild: ${data.rebuilt === true ? 'rebuilt' : 'skipped'}`,\n970:       `reason: ${String(data.reason ?? 'unknown')}`,\n971:       `freshness: ${String(data.freshnessBefore ?? 'unknown')} -> ${String(data.freshnessAfter ?? 'unknown')}`,\n972:       `generation: ${String(data.generationBefore ?? 'unknown')} -> ${String(data.generationAfter ?? 'unknown')}`,\n973:       `skillCount: ${String(data.skillCount ?? 'unknown')}`,\n974:     ].join('\\n');\n975:   }\n976: \n977:   if (toolName === 'skill_graph_scan') {\n978:     const scan = isRecord(data.scan) ? data.scan : data;\n979:     const payloadStatus = isRecord(payload) && typeof payload.status === 'string' ? payload.status : null;\n980:     const progress = Array.isArray(data.progress) ? data.progress.filter(isRecord) : [];\n981:     const hasProgressFailure = progress.some((step) => step.ok === false);\n982:     const status = payloadStatus === 'error' || hasProgressFailure ? 'failed' : 'completed';\n983:     return [\n984:       `skill_graph_scan: ${status}`,\n985:       `generation: ${String(data.generationBefore ?? 'unknown')} -> ${String(data.generationAfter ?? 'unknown')}`,\n986:       `scannedFiles: ${String(scan.scannedFiles ?? 'unknown')}`,\n987:       `indexedFiles: ${String(scan.indexedFiles ?? 'unknown')}`,\n988:       `indexedEdges: ${String(scan.indexedEdges ?? 'unknown')}`,\n989:       `rejectedEdges: ${String(scan.rejectedEdges ?? 'unknown')}`,\n990:     ].join('\\n');\n991:   }\n992: \n993:   return null;\n994: }\n995: \n996: function renderPayload(payload: unknown, format: OutputFormat, toolName?: string): string {\n997:   if (format === 'json' || format === 'jsonl') return renderJson(payload, format);\n998:   if (toolName) {\n999:     const jobText = renderJobText(toolName, payload);\n1000:     if (jobText) return jobText;\n1001:   }\n1002:   if (isRecord(payload)) {\n1003:     if (typeof payload.summary === 'string') return payload.summary;\n1004:     if (typeof payload.error === 'string') return payload.error;\n1005:     if (typeof payload.message === 'string') return payload.message;\n1006:   }\n1007:   return typeof payload === 'string' ? payload : JSON.stringify(payload, null, 2);\n1008: }\n1009: \n1010: function isProtocolMismatch(error: unknown): boolean {\n1011:   if (error instanceof JsonRpcError && (error.code === -32002 || error.code === -32600)) return true;\n1012:   const message = error instanceof Error ? error.message : String(error);\n1013:   return /protocol.*(mismatch|changed|version)/i.test(message);\n1014: }\n1015: \n1016: function isRetryableError(error: unknown): boolean {\n1017:   if (error instanceof CliRetryableError) return true;\n1018:   if (error instanceof JsonRpcError && (error.code === -32001 || error.code === -32000)) return true;\n1019:   const message = error instanceof Error ? error.message : String(error);\n1020:   return /SQLITE_BUSY|ECONNREFUSED|ENOENT|ECONNRESET|EPIPE|ETIMEDOUT|backend unavailable|retry/i.test(message);\n1021: }\n1022: \n1023: function exitCodeForError(error: unknown): number {\n1024:   if (error instanceof CliUsageError || error instanceof ToolSchemaValidationError) return EXIT_USAGE;\n1025:   if (error instanceof JsonRpcError && error.code === -32601) return EXIT_USAGE;\n1026:   if (error instanceof CliProtocolError || isProtocolMismatch(error)) return EXIT_PROTOCOL;\n1027:   if (isRetryableError(error)) return EXIT_RETRYABLE;\n1028:   if (error instanceof JsonRpcError && error.code === -32602) return EXIT_USAGE;\n1029:   return EXIT_RUNTIME;\n1030: }\n1031: \n1032: function levenshteinDistance(left: string, right: string): number {\n1033:   const previous = Array.from({ length: right.length + 1 }, (_value, index) => index);\n1034:   const current = new Array<number>(right.length + 1);\n1035: \n1036:   for (let leftIndex = 1; leftIndex <= left.length; leftIndex += 1) {\n1037:     current[0] = leftIndex;\n1038:     for (let rightIndex = 1; rightIndex <= right.length; rightIndex += 1) {\n1039:       const cost = left[leftIndex - 1] === right[rightIndex - 1] ? 0 : 1;\n1040:       current[rightIndex] = Math.min(\n1041:         current[rightIndex - 1] + 1,\n1042:         previous[rightIndex] + 1,\n1043:         previous[rightIndex - 1] + cost,\n1044:       );\n1045:     }\n1046:     previous.splice(0, previous.length, ...current);\n1047:   }\n1048: \n1049:   return previous[right.length];\n1050: }\n1051: \n1052: function closestCommand(command: string): string | undefined {\n1053:   const targets = new Map<string, string>([['list-tools', 'list-tools']]);\n1054:   targets.set('completion', 'completion');\n1055:   for (const tool of SKILL_ADVISOR_CLI_TOOL_MANIFEST) {\n1056:     for (const alias of tool.aliases) {\n1057:       targets.set(alias, tool.name);\n1058:     }\n1059:   }\n1060: \n1061:   let best: { readonly command: string; readonly distance: number } | null = null;\n1062:   for (const [alias, canonical] of targets) {\n1063:     const distance = levenshteinDistance(normalizeName(command), normalizeName(alias));\n1064:     if (!best || distance < best.distance || (distance === best.distance && canonical < best.command)) {\n1065:       best = { command: canonical, distance };\n1066:     }\n1067:   }\n1068: \n1069:   if (!best) return undefined;\n1070:   const threshold = Math.max(2, Math.floor(normalizeName(command).length * 0.4));\n1071:   return best.distance <= threshold ? best.command : undefined;\n1072: }\n1073: \n1074: function unknownCommandContext(message: string): { readonly hint: string; readonly suggestion?: string } | null {\n1075:   const match = message.match(/^Unknown command: (.+)$/);\n1076:   if (!match) return null;\n1077:   return {\n1078:     hint: 'Try `list-tools` to see available commands.',\n1079:     suggestion: closestCommand(match[1]),\n1080:   };\n1081: }\n1082: \n1083: function socketPathTooLong(socketPath: string): boolean {\n1084:   if (socketPath.startsWith('tcp://')) return false;\n1085:   return process.platform === 'darwin' && Buffer.byteLength(socketPath) > 103;\n1086: }\n1087: \n1088: function ensureSocketEnvironment(): void {\n1089:   if (!process.env.SPECKIT_IPC_SOCKET_DIR) {\n1090:     process.env.SPECKIT_IPC_SOCKET_DIR = DEFAULT_SOCKET_DIR;\n1091:   }\n1092:   const socketDir = process.env.SPECKIT_IPC_SOCKET_DIR;\n1093:   if (!socketDir || socketDir.startsWith('tcp://')) return;\n1094:   mkdirSync(socketDir, { recursive: true, mode: 0o700 });\n1095:   const stat = statSync(socketDir);\n1096:   if ((stat.mode & 0o022) !== 0) {\n1097:     throw new CliProtocolError(`IPC socket directory is group/world-writable: ${socketDir}`);\n1098:   }\n1099: }\n1100: \n1101: function sleep(ms: number): Promise<void> {\n1102:   return new Promise((resolve) => setTimeout(resolve, ms));\n1103: }\n1104: \n1105: function advisorValidateRetryDelayMs(attempt: number): number {\n1106:   return ADVISOR_VALIDATE_RETRY_BASE_DELAY_MS * attempt;\n1107: }\n1108: \n1109: // ───────────────────────────────────────────────────────────────────\n1110: // 5. CORE LOGIC\n1111: // ───────────────────────────────────────────────────────────────────\n1112: function spawnLauncher(paths: RepoPaths): ChildProcess {\n1113:   const child = spawn(process.execPath, [paths.launcherPath], {\n1114:     cwd: paths.repoRoot,\n1115:     env: process.env,\n1116:     detached: true,\n1117:     stdio: 'ignore',\n1118:   });\n1119:   child.unref();\n1120:   // Handed back so the wait below can end the moment the launcher proves it cannot\n1121:   // bring the socket up, instead of spending the rest of the budget on a dead process.\n1122:   return child;\n1123: }\n1124: \n1125: async function waitForDaemon(\n1126:   socketPath: string,\n1127:   bridge: BridgeModule,\n1128:   timeoutMs: number,\n1129:   launcher?: ChildProcess,\n1130: ): Promise<void> {\n1131:   const deadline = Date.now() + timeoutMs;\n1132:   let lastReason = 'not probed';\n1133:   // A launcher that has already died cannot bring the socket up, so the wait ends there\n1134:   // rather than burning the rest of the budget on a guaranteed failure. It arrives as an\n1135:   // event rather than a return value, so it is tracked as state.\n1136:   const launcherState: { exited: boolean; reason: string | null } = { exited: false, reason: null };\n1137:   if (launcher) {\n1138:     launcher.once('error', (error: Error) => {\n1139:       launcherState.exited = true;\n1140:       launcherState.reason = `daemon launcher failed to start: ${error.message}`;\n1141:     });\n1142:     launcher.once('exit', (code: number | null, signal: NodeJS.Signals | null) => {\n1143:       launcherState.exited = true;\n1144:       launcherState.reason = signal\n1145:         ? `daemon launcher exited on ${signal}`\n1146:         : `daemon launcher exited with code ${code ?? 'unknown'}`;\n1147:     });\n1148:   }\n1149: \n1150:   while (Date.now() <= deadline) {\n1151:     const remaining = Math.max(1, deadline - Date.now());\n1152:     // Probe before reading the launcher state: a launcher that bridged to a daemon which\n1153:     // was already running exits on success, so its exit only matters while the socket is\n1154:     // still not answering.\n1155:     const probe = await bridge.probeDaemon(socketPath, {\n1156:       timeoutMs: Math.min(remaining, 5000),\n1157:       deepProbe: true,\n1158:     });\n1159:     if (probe.status === 'alive') return;\n1160:     if (launcherState.exited) {\n1161:       throw new CliRetryableError(`backend unavailable: ${launcherState.reason ?? lastReason}`);\n1162:     }\n1163:     lastReason = probe.reason ?? probe.status;\n1164:     await sleep(100);\n1165:   }\n1166: \n1167:   throw new CliRetryableError(`backend unavailable: ${lastReason}`);\n1168: }\n1169: \n1170: class JsonRpcSocketClient {\n1171:   private nextId = 1;\n1172:   private readonly decoder = new StringDecoder('utf8');\n1173: \n1174:   private constructor(\n1175:     private readonly socket: net.Socket,\n1176:   ) {}\n1177: \n1178:   static connect(socketPath: string, bridge: BridgeModule, timeoutMs: number): Promise<JsonRpcSocketClient> {\n1179:     return new Promise((resolve, reject) => {\n1180:       let socket: net.Socket;\n1181:       let settled = false;\n1182:       const finish = (error?: Error): void => {\n1183:         if (settled) return;\n1184:         settled = true;\n1185:         clearTimeout(timer);\n1186:         socket.off?.('connect', onConnect);\n1187:         socket.off?.('error', onError);\n1188:         if (error) {\n1189:           socket.destroy?.();\n1190:           reject(error);\n1191:           return;\n1192:         }\n1193:         resolve(new JsonRpcSocketClient(socket));\n1194:       };\n1195:       const onConnect = (): void => finish();\n1196:       const onError = (error: Error): void => finish(error);\n1197:       const timer = setTimeout(() => finish(new CliRetryableError('connection timed out')), timeoutMs);\n1198:       timer.unref?.();\n1199: \n1200:       try {\n1201:         const connectionOptions = bridge.toConnectionOptions(socketPath);\n1202:         socket = typeof connectionOptions === 'string'\n1203:           ? net.createConnection(connectionOptions)\n1204:           : net.createConnection(connectionOptions);\n1205:       } catch (error: unknown) {\n1206:         clearTimeout(timer);\n1207:         reject(error instanceof Error ? error : new Error(String(error)));\n1208:         return;\n1209:       }\n1210:       socket.once('connect', onConnect);\n1211:       socket.once('error', onError);\n1212:     });\n1213:   }\n1214: \n1215:   request(method: string, params: unknown, timeoutMs: number): Promise<unknown> {\n1216:     const id = this.nextId++;\n1217:     const request = { jsonrpc: '2.0', id, method, params };\n1218:     return new Promise((resolve, reject) => {\n1219:       let buffer = '';\n1220:       let settled = false;\n1221: \n1222:       const cleanup = (): void => {\n1223:         clearTimeout(timer);\n1224:         this.socket.off('data', onData);\n1225:         this.socket.off('error', onError);\n1226:         this.socket.off('close', onClose);\n1227:       };\n1228:       const finish = (error: unknown, value?: unknown): void => {\n1229:         if (settled) return;\n1230:         settled = true;\n1231:         cleanup();\n1232:         if (error) {\n1233:           reject(error);\n1234:           return;\n1235:         }\n1236:         resolve(value);\n1237:       };\n1238:       const onData = (chunk: Buffer | string): void => {\n1239:         buffer += Buffer.isBuffer(chunk) ? this.decoder.write(chunk) : String(chunk ?? '');\n1240:         let newlineIndex = buffer.indexOf('\\n');\n1241:         while (newlineIndex !== -1) {\n1242:           const line = buffer.slice(0, newlineIndex).trim();\n1243:           buffer = buffer.slice(newlineIndex + 1);\n1244:           newlineIndex = buffer.indexOf('\\n');\n1245:           if (!line) continue;\n1246:           let parsed: JsonRpcResponse;\n1247:           try {\n1248:             parsed = JSON.parse(line) as JsonRpcResponse;\n1249:           } catch {\n1250:             continue;\n1251:           }\n1252:           if (parsed.id !== id) continue;\n1253:           if (parsed.error) {\n1254:             finish(new JsonRpcError(parsed.error));\n1255:             return;\n1256:           }\n1257:           finish(null, parsed.result);\n1258:           return;\n1259:         }\n1260:       };\n1261:       const onError = (error: Error): void => finish(error);\n1262:       const onClose = (): void => finish(new CliRetryableError('socket closed before response'));\n1263:       const timer = setTimeout(() => finish(new CliRetryableError(`${method} timed out`)), timeoutMs);\n1264:       timer.unref?.();\n1265: \n1266:       this.socket.on('data', onData);\n1267:       this.socket.once('error', onError);\n1268:       this.socket.once('close', onClose);\n1269:       this.socket.write(`${JSON.stringify(request)}\\n`);\n1270:     });\n1271:   }\n1272: \n1273:   close(): void {\n1274:     this.socket.end();\n1275:     this.socket.destroy();\n1276:   }\n1277: }\n1278: \n1279: function callerMeta(trusted: boolean): Record<string, unknown> {\n1280:   return {\n1281:     transport: 'cli',\n1282:     trusted,\n1283:     callerAuthority: trusted ? 'trusted' : 'untrusted',\n1284:     pid: process.pid,\n1285:     client: 'skill-advisor-cli',\n1286:   };\n1287: }\n1288: \n1289: // A daemon loads its code once at launch, so after a rebuild a live daemon still answers\n1290: // with the old code. Only a launched daemon counts: the lease carries a childPid once\n1291: // the launcher has started it, stamped after the launcher's own build.\n1292: function liveDaemonPredatesBuild(paths: RepoPaths): boolean {\n1293:   try {\n1294:     const lease = JSON.parse(readFileSync(path.join(paths.dbDir, LAUNCHER_LEASE_FILE_NAME), 'utf8')) as {\n1295:       childPid?: unknown;\n1296:       startedAt?: unknown;\n1297:     };\n1298:     if (!Number.isInteger(lease.childPid) || (lease.childPid as number) <= 0) return false;\n1299:     const launchedAtMs = Date.parse(typeof lease.startedAt === 'string' ? lease.startedAt : '');\n1300:     if (!Number.isFinite(launchedAtMs)) return false;\n1301:     const entrypoint = path.join(path.dirname(paths.packageJsonPath), 'dist', 'runtime', 'advisor-server.js');\n1302:     return statSync(entrypoint).mtimeMs > launchedAtMs;\n1303:   } catch {\n1304:     return false;\n1305:   }\n1306: }\n1307: \n1308: // A launcher started next to a stale daemon recycles it. The call waits for the lease to\n1309: // show the replacement rather than connecting to the daemon being retired. A launcher\n1310: // that exits with the old daemon still in place skipped the recycle, so the call uses\n1311: // that daemon as it always did.\n1312: async function waitForStaleDaemonRecycle(paths: RepoPaths, timeoutMs: number, launcher: ChildProcess): Promise<void> {\n1313:   const deadline = Date.now() + timeoutMs;\n1314:   let launcherExited = false;\n1315:   launcher.once('error', () => { launcherExited = true; });\n1316:   launcher.once('exit', () => { launcherExited = true; });\n1317:   while (Date.now() <= deadline && liveDaemonPredatesBuild(paths)) {\n1318:     if (launcherExited) return;\n1319:     await sleep(100);\n1320:   }\n1321: }\n1322: \n1323: // The deep probe doubles as the daemon's handshake, and its failure reason splits the\n1324: // two cases the cold-start budget must tell apart. A timeout means the daemon took the\n[Output truncated. Continue reading with offset: 1325]"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/skill-advisor-cli.ts\"}"},"time":{"start":1794527173938,"end":1794527174338}}}}
