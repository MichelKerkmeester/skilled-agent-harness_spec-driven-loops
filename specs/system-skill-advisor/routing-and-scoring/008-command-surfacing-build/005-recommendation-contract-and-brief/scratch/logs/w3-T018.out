{"type":"tool_use","timestamp":1794527183263,"sessionID":"ses_e2dd8cae6ffeV3iKQc8fxV7h6K","part":{"partID":"prt_1d227bf86001SfuLv1X0slw1GK","sessionID":"ses_e2dd8cae6ffeV3iKQc8fxV7h6K","messageID":"msg_1d227b38e001GmvShCtR7nY7MN","type":"tool","id":"call_19c2c7a028ec4adc97f78989","tool":"read","state":{"status":"completed","input":{"path":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/skill-advisor-cli.ts","offset":1324,"limit":400},"output":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/skill-advisor-cli.ts, lines 1324-1653\n1324: // two cases the cold-start budget must tell apart. A timeout means the daemon took the\n1325: // connection and stayed silent, the one failure still worth waiting out on the caller's\n1326: // own timeout. Every other reason — absent socket, refused connection, a handshake that\n1327: // errored or closed before replying — is a daemon that is simply not running yet, so the\n1328: // call starts it and waits, bounded: a caller that can also answer without the daemon\n1329: // must not be held for the whole tool timeout by one that never accepts a connection.\n1330: function probeTimedOut(probe: BridgeProbeResult): boolean {\n1331:   return /timeout/i.test(probe.reason ?? '');\n1332: }\n1333: \n1334: async function ensureDaemonReady(\n1335:   socketPath: string,\n1336:   bridge: BridgeModule,\n1337:   paths: RepoPaths,\n1338:   timeoutMs: number,\n1339:   warmOnly: boolean,\n1340:   hasLocalFallback: boolean,\n1341: ): Promise<void> {\n1342:   const initialProbe = await bridge.probeDaemon(socketPath, { timeoutMs: Math.min(timeoutMs, 5000), deepProbe: true });\n1343:   if (initialProbe.status === 'alive') {\n1344:     if (warmOnly || !liveDaemonPredatesBuild(paths)) return;\n1345:     await waitForStaleDaemonRecycle(paths, timeoutMs, spawnLauncher(paths));\n1346:     await waitForDaemon(socketPath, bridge, timeoutMs);\n1347:     return;\n1348:   }\n1349:   if (warmOnly) {\n1350:     throw new CliRetryableError(`backend unavailable: ${initialProbe.reason ?? initialProbe.status}`);\n1351:   }\n1352:   const waitMs = hasLocalFallback && !probeTimedOut(initialProbe)\n1353:     ? Math.min(timeoutMs, COLD_START_WAIT_MS)\n1354:     : timeoutMs;\n1355:   await waitForDaemon(socketPath, bridge, waitMs, spawnLauncher(paths));\n1356: }\n1357: \n1358: async function callTool(toolName: string, args: Record<string, unknown>, timeoutMs: number, trusted: boolean, warmOnly: boolean): Promise<unknown> {\n1359:   ensureSocketEnvironment();\n1360:   const paths = findRepoPaths();\n1361:   const bridge = loadBridge(paths);\n1362:   const socketPath = bridge.getIpcSocketPath('system-skill-advisor', { dbDir: paths.dbDir });\n1363:   if (socketPathTooLong(socketPath)) {\n1364:     throw new CliProtocolError(`IPC socket path exceeds the Darwin sun_path limit: ${socketPath}`);\n1365:   }\n1366: \n1367:   // advisor_recommend carries a local-scorer fallback, so it starts the daemon and waits\n1368:   // for it only within the bounded cold-start window; the local scorer still answers if\n1369:   // that window closes. Tools without a fallback keep the caller's full timeout: for them\n1370:   // the daemon is the only answer.\n1371:   await ensureDaemonReady(socketPath, bridge, paths, timeoutMs, warmOnly, toolName === 'advisor_recommend');\n1372: \n1373:   const client = await JsonRpcSocketClient.connect(socketPath, bridge, timeoutMs);\n1374:   try {\n1375:     const initialize = await client.request('initialize', {\n1376:       clientInfo: { name: 'skill-advisor-cli', version: readCliVersion(paths) },\n1377:       advisorProtocol: ADVISOR_PROTOCOL_VERSION,\n1378:     }, timeoutMs) as InitializeResult;\n1379:     if (initialize.advisorProtocol !== ADVISOR_PROTOCOL_VERSION) {\n1380:       const daemonVersion = initialize.advisorProtocol ?? 'missing advisorProtocol';\n1381:       throw new CliProtocolError(\n1382:         `backend protocol mismatch: daemon \"${daemonVersion}\", client \"${ADVISOR_PROTOCOL_VERSION}\"`,\n1383:       );\n1384:     }\n1385:     return await client.request('advisor.call', {\n1386:       command: toolName,\n1387:       args,\n1388:       _meta: callerMeta(trusted),\n1389:     }, timeoutMs);\n1390:   } finally {\n1391:     client.close();\n1392:   }\n1393: }\n1394: \n1395: async function invokeToolPayload(toolName: string, args: Record<string, unknown>, timeoutMs: number, trusted: boolean, warmOnly: boolean): Promise<ToolPayloadResult> {\n1396:   const result = await callTool(toolName, args, timeoutMs, trusted, warmOnly);\n1397:   return extractToolPayload(result);\n1398: }\n1399: \n1400: async function invokeWithRetry<T>(operation: () => Promise<T>, options: RetryOptions): Promise<T> {\n1401:   let attempt = 1;\n1402:   while (true) {\n1403:     try {\n1404:       return await operation();\n1405:     } catch (error: unknown) {\n1406:       if (attempt >= options.maxAttempts || !isRetryableError(error)) throw error;\n1407:       await (options.sleepFn ?? sleep)(options.sleepMsForAttempt(attempt));\n1408:       attempt += 1;\n1409:     }\n1410:   }\n1411: }\n1412: \n1413: async function invokeAdvisorValidatePayload(args: Record<string, unknown>, timeoutMs: number, trusted: boolean, warmOnly: boolean): Promise<ToolPayloadResult> {\n1414:   return invokeWithRetry(\n1415:     () => invokeToolPayload('advisor_validate', args, timeoutMs, trusted, warmOnly),\n1416:     {\n1417:       maxAttempts: ADVISOR_VALIDATE_MAX_ATTEMPTS,\n1418:       sleepMsForAttempt: advisorValidateRetryDelayMs,\n1419:     },\n1420:   );\n1421: }\n1422: \n1423: function generationFromPayload(payload: unknown): unknown {\n1424:   return getDataRecord(payload)?.generation ?? null;\n1425: }\n1426: \n1427: async function runSkillGraphScanJob(args: Record<string, unknown>, timeoutMs: number, trusted: boolean, warmOnly: boolean): Promise<ToolPayloadResult> {\n1428:   const workspaceRoot = findRepoPaths().repoRoot;\n1429:   const before = await invokeToolPayload('advisor_status', { workspaceRoot }, timeoutMs, false, warmOnly);\n1430:   const scan = await invokeToolPayload('skill_graph_scan', args, timeoutMs, trusted, warmOnly);\n1431:   const after = await invokeToolPayload('advisor_status', { workspaceRoot }, timeoutMs, false, warmOnly);\n1432:   const status = isRecord(scan.payload) && typeof scan.payload.status === 'string' ? scan.payload.status : 'ok';\n1433:   const scanData = getDataRecord(scan.payload) ?? scan.payload;\n1434: \n1435:   return {\n1436:     payload: {\n1437:       status,\n1438:       data: {\n1439:         progress: [\n1440:           { step: 'advisor_status_before', generation: generationFromPayload(before.payload), ok: !before.isError },\n1441:           { step: 'skill_graph_scan', ok: !scan.isError },\n1442:           { step: 'advisor_status_after', generation: generationFromPayload(after.payload), ok: !after.isError },\n1443:         ],\n1444:         generationBefore: generationFromPayload(before.payload),\n1445:         generationAfter: generationFromPayload(after.payload),\n1446:         scan: scanData,\n1447:       },\n1448:       ...(isRecord(scan.payload) && typeof scan.payload.error === 'string' ? { error: scan.payload.error } : {}),\n1449:     },\n1450:     isError: before.isError || scan.isError || after.isError,\n1451:   };\n1452: }\n1453: \n1454: async function runLocalScorer(prompt: string): Promise<readonly AdvisorRecommendation[] | null> {\n1455:   const forceLocalEnv = SKILL_ADVISOR_COMPAT_CONTRACT.forceLocalEnv;\n1456:   const previous = process.env[forceLocalEnv];\n1457:   // Force-local for this spawn alone: the scorer would otherwise spend the fallback\n1458:   // budget retrying the daemon that just proved unreachable.\n1459:   process.env[forceLocalEnv] = '1';\n1460:   try {\n1461:     const result = await runAdvisorSubprocess(prompt, {\n1462:       workspaceRoot: findRepoPaths().repoRoot,\n1463:       timeoutMs: LOCAL_SCORER_TIMEOUT_MS,\n1464:       thresholdConfig: LOCAL_SCORER_THRESHOLDS,\n1465:     });\n1466:     return result.ok ? result.recommendations : null;\n1467:   } finally {\n1468:     if (previous === undefined) {\n1469:       delete process.env[forceLocalEnv];\n1470:     } else {\n1471:       process.env[forceLocalEnv] = previous;\n1472:     }\n1473:   }\n1474: }\n1475: \n1476: function degradedRecommendations(entries: readonly AdvisorRecommendation[]): Array<Record<string, unknown>> {\n1477:   return entries\n1478:     .filter((entry) => entry.passes_threshold === true)\n1479:     .map((entry) => ({\n1480:       skillId: entry.skill,\n1481:       confidence: entry.confidence,\n1482:       uncertainty: entry.uncertainty,\n1483:       reason: entry.reason ?? '',\n1484:     }));\n1485: }\n1486: \n1487: // Request options added after the daemon protocol was fixed, oldest first.\n1488: const COMPILED_ROUTE_OPTION_KEYS = ['includeCompiledRoute', 'compiledRouteTopOnly'] as const;\n1489: \n1490: async function invokeAdvisorRecommendPayload(\n1491:   args: Record<string, unknown>,\n1492:   timeoutMs: number,\n1493:   trusted: boolean,\n1494:   warmOnly: boolean,\n1495: ): Promise<ToolPayloadResult> {\n1496:   try {\n1497:     return await invokeToolPayload('advisor_recommend', args, timeoutMs, trusted, warmOnly);\n1498:   } catch (error: unknown) {\n1499:     let failure = error;\n1500:     const options = args.options;\n1501:     const rejected = error instanceof JsonRpcError && error.code === -32602 && isRecord(options)\n1502:       ? COMPILED_ROUTE_OPTION_KEYS.filter((key) => (\n1503:         error.message.includes(key) && Object.prototype.hasOwnProperty.call(options, key)\n1504:       ))\n1505:       : [];\n1506:     if (rejected.length > 0 && isRecord(options)) {\n1507:       // A daemon started before these options existed rejects them, and the\n1508:       // protocol handshake cannot distinguish the builds. A daemon too old for\n1509:       // the first option is too old for the later one as well, and it may name\n1510:       // only one of them, so both go together in that case.\n1511:       const retryOptions: Record<string, unknown> = { ...options };\n1512:       const drop = rejected.includes('includeCompiledRoute') ? COMPILED_ROUTE_OPTION_KEYS : rejected;\n1513:       for (const key of drop) delete retryOptions[key];\n1514:       const retryArgs: Record<string, unknown> = { ...args, options: retryOptions };\n1515:       try {\n1516:         return await invokeToolPayload('advisor_recommend', retryArgs, timeoutMs, trusted, warmOnly);\n1517:       } catch (retryError: unknown) {\n1518:         failure = retryError;\n1519:       }\n1520:     }\n1521:     // Only an unreachable daemon reaches this catch: one that answered, even with a\n1522:     // tool-level error, returned above. A fallback that also fails rethrows the\n1523:     // original error, so the exit code and error envelope stay unchanged.\n1524:     if (exitCodeForError(failure) !== EXIT_RETRYABLE) throw failure;\n1525:     // Warm-only is attach-or-refuse: it never spawns a process, and the local scorer\n1526:     // is a spawn, so it must not run here. Rethrow the original failure so the\n1527:     // retryable exit code and error envelope stay unchanged.\n1528:     if (warmOnly) throw failure;\n1529:     const prompt = args.prompt;\n1530:     if (typeof prompt !== 'string') throw failure;\n1531:     const recommendations = await runLocalScorer(prompt).catch(() => null);\n1532:     if (!recommendations) throw failure;\n1533:     return {\n1534:       payload: {\n1535:         status: 'ok',\n1536:         degraded: true,\n1537:         source: LOCAL_SCORER_SOURCE,\n1538:         data: {\n1539:           recommendations: degradedRecommendations(recommendations),\n1540:           effectiveThresholds: LOCAL_SCORER_THRESHOLDS,\n1541:         },\n1542:       },\n1543:       isError: false,\n1544:     };\n1545:   }\n1546: }\n1547: \n1548: // ───────────────────────────────────────────────────────────────────\n1549: // 6. EXPORTS\n1550: // ───────────────────────────────────────────────────────────────────\n1551: export async function runSkillAdvisorCli(argv: string[], io: CliIo = { stdout: process.stdout, stderr: process.stderr }): Promise<number> {\n1552:   try {\n1553:     const parsed = parseCliArgs(argv);\n1554:     if (parsed.help) {\n1555:       await writeLine(io.stdout, usageText(parsed.command || undefined));\n1556:       return EXIT_SUCCESS;\n1557:     }\n1558:     if (parsed.version) {\n1559:       await writeLine(io.stdout, readCliVersion(findRepoPaths()));\n1560:       return EXIT_SUCCESS;\n1561:     }\n1562:     if (parsed.command === 'list-tools') {\n1563:       await writeLine(io.stdout, renderToolList(parsed.format, parsed.toolListMode));\n1564:       return EXIT_SUCCESS;\n1565:     }\n1566:     if (parsed.command === 'completion') {\n1567:       if (!parsed.completionShell) {\n1568:         throw new CliUsageError('completion requires a shell: bash or zsh');\n1569:       }\n1570:       await writeLine(io.stdout, renderCompletion(parsed.completionShell));\n1571:       return EXIT_SUCCESS;\n1572:     }\n1573: \n1574:     const command = parsed.jsonFromStdin\n1575:       ? { ...parsed, args: parseJsonObject(await (io.readStdin ?? readProcessStdin)()) }\n1576:       : parsed;\n1577:     const validated = validateCommand(command);\n1578:     if (!validated) {\n1579:       throw new CliUsageError(`Unknown command: ${parsed.command}`);\n1580:     }\n1581: \n1582:     const invoked = validated.tool.name === 'advisor_recommend'\n1583:       ? await invokeAdvisorRecommendPayload(validated.args, parsed.timeoutMs, parsed.trusted, parsed.warmOnly)\n1584:       : validated.tool.name === 'skill_graph_scan'\n1585:         ? await runSkillGraphScanJob(validated.args, parsed.timeoutMs, parsed.trusted, parsed.warmOnly)\n1586:         : validated.tool.name === 'advisor_validate'\n1587:           ? await invokeAdvisorValidatePayload(validated.args, parsed.timeoutMs, parsed.trusted, parsed.warmOnly)\n1588:           : await invokeToolPayload(validated.tool.name, validated.args, parsed.timeoutMs, parsed.trusted, parsed.warmOnly);\n1589:     await writeLine(io.stdout, renderPayload(invoked.payload, parsed.format, validated.tool.name));\n1590:     return invoked.isError ? EXIT_RUNTIME : EXIT_SUCCESS;\n1591:   } catch (error: unknown) {\n1592:     const exitCode = exitCodeForError(error);\n1593:     const message = error instanceof Error ? error.message : String(error);\n1594:     const unknownCommand = unknownCommandContext(message);\n1595:     const payload = {\n1596:       status: 'error',\n1597:       error: message,\n1598:       exitCode,\n1599:       ...(unknownCommand ? { hint: unknownCommand.hint } : {}),\n1600:       ...(unknownCommand?.suggestion ? { suggestion: unknownCommand.suggestion } : {}),\n1601:     };\n1602:     const format = (() => {\n1603:       try {\n1604:         return parseCliArgs(argv).format;\n1605:       } catch {\n1606:         return 'text' as OutputFormat;\n1607:       }\n1608:     })();\n1609:     if (format === 'json' || format === 'jsonl') {\n1610:       await writeLine(io.stderr, renderJson(payload, format));\n1611:     } else {\n1612:       await writeLine(io.stderr, [\n1613:         `ERROR: ${message}`,\n1614:         unknownCommand ? `Hint: ${unknownCommand.hint}` : null,\n1615:         unknownCommand?.suggestion ? `Did you mean \\`${unknownCommand.suggestion}\\`?` : null,\n1616:       ].filter((line): line is string => Boolean(line)).join('\\n'));\n1617:     }\n1618:     return exitCode;\n1619:   }\n1620: }\n1621: \n1622: function isCliEntrypoint(): boolean {\n1623:   const invoked = process.argv[1];\n1624:   if (!invoked) return false;\n1625:   return path.resolve(invoked) === path.resolve(currentModulePath());\n1626: }\n1627: \n1628: export const __testing = {\n1629:   DEFAULT_SOCKET_DIR,\n1630:   EXIT_PROTOCOL,\n1631:   EXIT_RETRYABLE,\n1632:   EXIT_USAGE,\n1633:   advisorValidateRetryDelayMs,\n1634:   commandMap,\n1635:   closestCommand,\n1636:   ensureSocketEnvironment,\n1637:   exitCodeForError,\n1638:   findRepoPaths,\n1639:   invokeWithRetry,\n1640:   liveDaemonPredatesBuild,\n1641:   renderCompletion,\n1642:   renderToolList,\n1643:   resolvePropertyName,\n1644:   validateCommand,\n1645: };\n1646: \n1647: if (isCliEntrypoint()) {\n1648:   // Natural exit via process.exitCode: a hard process.exit() drops any\n1649:   // stdout bytes still queued behind the kernel pipe buffer, truncating\n1650:   // large payloads. Pending pipe writes keep the event loop alive until\n1651:   // they flush; all sockets and timers are closed or unref'd by here.\n1652:   process.exitCode = await runSkillAdvisorCli(process.argv.slice(2));\n1653: }","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/skill-advisor-cli.ts, lines 1324-1653\n1324: // two cases the cold-start budget must tell apart. A timeout means the daemon took the\n1325: // connection and stayed silent, the one failure still worth waiting out on the caller's\n1326: // own timeout. Every other reason — absent socket, refused connection, a handshake that\n1327: // errored or closed before replying — is a daemon that is simply not running yet, so the\n1328: // call starts it and waits, bounded: a caller that can also answer without the daemon\n1329: // must not be held for the whole tool timeout by one that never accepts a connection.\n1330: function probeTimedOut(probe: BridgeProbeResult): boolean {\n1331:   return /timeout/i.test(probe.reason ?? '');\n1332: }\n1333: \n1334: async function ensureDaemonReady(\n1335:   socketPath: string,\n1336:   bridge: BridgeModule,\n1337:   paths: RepoPaths,\n1338:   timeoutMs: number,\n1339:   warmOnly: boolean,\n1340:   hasLocalFallback: boolean,\n1341: ): Promise<void> {\n1342:   const initialProbe = await bridge.probeDaemon(socketPath, { timeoutMs: Math.min(timeoutMs, 5000), deepProbe: true });\n1343:   if (initialProbe.status === 'alive') {\n1344:     if (warmOnly || !liveDaemonPredatesBuild(paths)) return;\n1345:     await waitForStaleDaemonRecycle(paths, timeoutMs, spawnLauncher(paths));\n1346:     await waitForDaemon(socketPath, bridge, timeoutMs);\n1347:     return;\n1348:   }\n1349:   if (warmOnly) {\n1350:     throw new CliRetryableError(`backend unavailable: ${initialProbe.reason ?? initialProbe.status}`);\n1351:   }\n1352:   const waitMs = hasLocalFallback && !probeTimedOut(initialProbe)\n1353:     ? Math.min(timeoutMs, COLD_START_WAIT_MS)\n1354:     : timeoutMs;\n1355:   await waitForDaemon(socketPath, bridge, waitMs, spawnLauncher(paths));\n1356: }\n1357: \n1358: async function callTool(toolName: string, args: Record<string, unknown>, timeoutMs: number, trusted: boolean, warmOnly: boolean): Promise<unknown> {\n1359:   ensureSocketEnvironment();\n1360:   const paths = findRepoPaths();\n1361:   const bridge = loadBridge(paths);\n1362:   const socketPath = bridge.getIpcSocketPath('system-skill-advisor', { dbDir: paths.dbDir });\n1363:   if (socketPathTooLong(socketPath)) {\n1364:     throw new CliProtocolError(`IPC socket path exceeds the Darwin sun_path limit: ${socketPath}`);\n1365:   }\n1366: \n1367:   // advisor_recommend carries a local-scorer fallback, so it starts the daemon and waits\n1368:   // for it only within the bounded cold-start window; the local scorer still answers if\n1369:   // that window closes. Tools without a fallback keep the caller's full timeout: for them\n1370:   // the daemon is the only answer.\n1371:   await ensureDaemonReady(socketPath, bridge, paths, timeoutMs, warmOnly, toolName === 'advisor_recommend');\n1372: \n1373:   const client = await JsonRpcSocketClient.connect(socketPath, bridge, timeoutMs);\n1374:   try {\n1375:     const initialize = await client.request('initialize', {\n1376:       clientInfo: { name: 'skill-advisor-cli', version: readCliVersion(paths) },\n1377:       advisorProtocol: ADVISOR_PROTOCOL_VERSION,\n1378:     }, timeoutMs) as InitializeResult;\n1379:     if (initialize.advisorProtocol !== ADVISOR_PROTOCOL_VERSION) {\n1380:       const daemonVersion = initialize.advisorProtocol ?? 'missing advisorProtocol';\n1381:       throw new CliProtocolError(\n1382:         `backend protocol mismatch: daemon \"${daemonVersion}\", client \"${ADVISOR_PROTOCOL_VERSION}\"`,\n1383:       );\n1384:     }\n1385:     return await client.request('advisor.call', {\n1386:       command: toolName,\n1387:       args,\n1388:       _meta: callerMeta(trusted),\n1389:     }, timeoutMs);\n1390:   } finally {\n1391:     client.close();\n1392:   }\n1393: }\n1394: \n1395: async function invokeToolPayload(toolName: string, args: Record<string, unknown>, timeoutMs: number, trusted: boolean, warmOnly: boolean): Promise<ToolPayloadResult> {\n1396:   const result = await callTool(toolName, args, timeoutMs, trusted, warmOnly);\n1397:   return extractToolPayload(result);\n1398: }\n1399: \n1400: async function invokeWithRetry<T>(operation: () => Promise<T>, options: RetryOptions): Promise<T> {\n1401:   let attempt = 1;\n1402:   while (true) {\n1403:     try {\n1404:       return await operation();\n1405:     } catch (error: unknown) {\n1406:       if (attempt >= options.maxAttempts || !isRetryableError(error)) throw error;\n1407:       await (options.sleepFn ?? sleep)(options.sleepMsForAttempt(attempt));\n1408:       attempt += 1;\n1409:     }\n1410:   }\n1411: }\n1412: \n1413: async function invokeAdvisorValidatePayload(args: Record<string, unknown>, timeoutMs: number, trusted: boolean, warmOnly: boolean): Promise<ToolPayloadResult> {\n1414:   return invokeWithRetry(\n1415:     () => invokeToolPayload('advisor_validate', args, timeoutMs, trusted, warmOnly),\n1416:     {\n1417:       maxAttempts: ADVISOR_VALIDATE_MAX_ATTEMPTS,\n1418:       sleepMsForAttempt: advisorValidateRetryDelayMs,\n1419:     },\n1420:   );\n1421: }\n1422: \n1423: function generationFromPayload(payload: unknown): unknown {\n1424:   return getDataRecord(payload)?.generation ?? null;\n1425: }\n1426: \n1427: async function runSkillGraphScanJob(args: Record<string, unknown>, timeoutMs: number, trusted: boolean, warmOnly: boolean): Promise<ToolPayloadResult> {\n1428:   const workspaceRoot = findRepoPaths().repoRoot;\n1429:   const before = await invokeToolPayload('advisor_status', { workspaceRoot }, timeoutMs, false, warmOnly);\n1430:   const scan = await invokeToolPayload('skill_graph_scan', args, timeoutMs, trusted, warmOnly);\n1431:   const after = await invokeToolPayload('advisor_status', { workspaceRoot }, timeoutMs, false, warmOnly);\n1432:   const status = isRecord(scan.payload) && typeof scan.payload.status === 'string' ? scan.payload.status : 'ok';\n1433:   const scanData = getDataRecord(scan.payload) ?? scan.payload;\n1434: \n1435:   return {\n1436:     payload: {\n1437:       status,\n1438:       data: {\n1439:         progress: [\n1440:           { step: 'advisor_status_before', generation: generationFromPayload(before.payload), ok: !before.isError },\n1441:           { step: 'skill_graph_scan', ok: !scan.isError },\n1442:           { step: 'advisor_status_after', generation: generationFromPayload(after.payload), ok: !after.isError },\n1443:         ],\n1444:         generationBefore: generationFromPayload(before.payload),\n1445:         generationAfter: generationFromPayload(after.payload),\n1446:         scan: scanData,\n1447:       },\n1448:       ...(isRecord(scan.payload) && typeof scan.payload.error === 'string' ? { error: scan.payload.error } : {}),\n1449:     },\n1450:     isError: before.isError || scan.isError || after.isError,\n1451:   };\n1452: }\n1453: \n1454: async function runLocalScorer(prompt: string): Promise<readonly AdvisorRecommendation[] | null> {\n1455:   const forceLocalEnv = SKILL_ADVISOR_COMPAT_CONTRACT.forceLocalEnv;\n1456:   const previous = process.env[forceLocalEnv];\n1457:   // Force-local for this spawn alone: the scorer would otherwise spend the fallback\n1458:   // budget retrying the daemon that just proved unreachable.\n1459:   process.env[forceLocalEnv] = '1';\n1460:   try {\n1461:     const result = await runAdvisorSubprocess(prompt, {\n1462:       workspaceRoot: findRepoPaths().repoRoot,\n1463:       timeoutMs: LOCAL_SCORER_TIMEOUT_MS,\n1464:       thresholdConfig: LOCAL_SCORER_THRESHOLDS,\n1465:     });\n1466:     return result.ok ? result.recommendations : null;\n1467:   } finally {\n1468:     if (previous === undefined) {\n1469:       delete process.env[forceLocalEnv];\n1470:     } else {\n1471:       process.env[forceLocalEnv] = previous;\n1472:     }\n1473:   }\n1474: }\n1475: \n1476: function degradedRecommendations(entries: readonly AdvisorRecommendation[]): Array<Record<string, unknown>> {\n1477:   return entries\n1478:     .filter((entry) => entry.passes_threshold === true)\n1479:     .map((entry) => ({\n1480:       skillId: entry.skill,\n1481:       confidence: entry.confidence,\n1482:       uncertainty: entry.uncertainty,\n1483:       reason: entry.reason ?? '',\n1484:     }));\n1485: }\n1486: \n1487: // Request options added after the daemon protocol was fixed, oldest first.\n1488: const COMPILED_ROUTE_OPTION_KEYS = ['includeCompiledRoute', 'compiledRouteTopOnly'] as const;\n1489: \n1490: async function invokeAdvisorRecommendPayload(\n1491:   args: Record<string, unknown>,\n1492:   timeoutMs: number,\n1493:   trusted: boolean,\n1494:   warmOnly: boolean,\n1495: ): Promise<ToolPayloadResult> {\n1496:   try {\n1497:     return await invokeToolPayload('advisor_recommend', args, timeoutMs, trusted, warmOnly);\n1498:   } catch (error: unknown) {\n1499:     let failure = error;\n1500:     const options = args.options;\n1501:     const rejected = error instanceof JsonRpcError && error.code === -32602 && isRecord(options)\n1502:       ? COMPILED_ROUTE_OPTION_KEYS.filter((key) => (\n1503:         error.message.includes(key) && Object.prototype.hasOwnProperty.call(options, key)\n1504:       ))\n1505:       : [];\n1506:     if (rejected.length > 0 && isRecord(options)) {\n1507:       // A daemon started before these options existed rejects them, and the\n1508:       // protocol handshake cannot distinguish the builds. A daemon too old for\n1509:       // the first option is too old for the later one as well, and it may name\n1510:       // only one of them, so both go together in that case.\n1511:       const retryOptions: Record<string, unknown> = { ...options };\n1512:       const drop = rejected.includes('includeCompiledRoute') ? COMPILED_ROUTE_OPTION_KEYS : rejected;\n1513:       for (const key of drop) delete retryOptions[key];\n1514:       const retryArgs: Record<string, unknown> = { ...args, options: retryOptions };\n1515:       try {\n1516:         return await invokeToolPayload('advisor_recommend', retryArgs, timeoutMs, trusted, warmOnly);\n1517:       } catch (retryError: unknown) {\n1518:         failure = retryError;\n1519:       }\n1520:     }\n1521:     // Only an unreachable daemon reaches this catch: one that answered, even with a\n1522:     // tool-level error, returned above. A fallback that also fails rethrows the\n1523:     // original error, so the exit code and error envelope stay unchanged.\n1524:     if (exitCodeForError(failure) !== EXIT_RETRYABLE) throw failure;\n1525:     // Warm-only is attach-or-refuse: it never spawns a process, and the local scorer\n1526:     // is a spawn, so it must not run here. Rethrow the original failure so the\n1527:     // retryable exit code and error envelope stay unchanged.\n1528:     if (warmOnly) throw failure;\n1529:     const prompt = args.prompt;\n1530:     if (typeof prompt !== 'string') throw failure;\n1531:     const recommendations = await runLocalScorer(prompt).catch(() => null);\n1532:     if (!recommendations) throw failure;\n1533:     return {\n1534:       payload: {\n1535:         status: 'ok',\n1536:         degraded: true,\n1537:         source: LOCAL_SCORER_SOURCE,\n1538:         data: {\n1539:           recommendations: degradedRecommendations(recommendations),\n1540:           effectiveThresholds: LOCAL_SCORER_THRESHOLDS,\n1541:         },\n1542:       },\n1543:       isError: false,\n1544:     };\n1545:   }\n1546: }\n1547: \n1548: // ───────────────────────────────────────────────────────────────────\n1549: // 6. EXPORTS\n1550: // ───────────────────────────────────────────────────────────────────\n1551: export async function runSkillAdvisorCli(argv: string[], io: CliIo = { stdout: process.stdout, stderr: process.stderr }): Promise<number> {\n1552:   try {\n1553:     const parsed = parseCliArgs(argv);\n1554:     if (parsed.help) {\n1555:       await writeLine(io.stdout, usageText(parsed.command || undefined));\n1556:       return EXIT_SUCCESS;\n1557:     }\n1558:     if (parsed.version) {\n1559:       await writeLine(io.stdout, readCliVersion(findRepoPaths()));\n1560:       return EXIT_SUCCESS;\n1561:     }\n1562:     if (parsed.command === 'list-tools') {\n1563:       await writeLine(io.stdout, renderToolList(parsed.format, parsed.toolListMode));\n1564:       return EXIT_SUCCESS;\n1565:     }\n1566:     if (parsed.command === 'completion') {\n1567:       if (!parsed.completionShell) {\n1568:         throw new CliUsageError('completion requires a shell: bash or zsh');\n1569:       }\n1570:       await writeLine(io.stdout, renderCompletion(parsed.completionShell));\n1571:       return EXIT_SUCCESS;\n1572:     }\n1573: \n1574:     const command = parsed.jsonFromStdin\n1575:       ? { ...parsed, args: parseJsonObject(await (io.readStdin ?? readProcessStdin)()) }\n1576:       : parsed;\n1577:     const validated = validateCommand(command);\n1578:     if (!validated) {\n1579:       throw new CliUsageError(`Unknown command: ${parsed.command}`);\n1580:     }\n1581: \n1582:     const invoked = validated.tool.name === 'advisor_recommend'\n1583:       ? await invokeAdvisorRecommendPayload(validated.args, parsed.timeoutMs, parsed.trusted, parsed.warmOnly)\n1584:       : validated.tool.name === 'skill_graph_scan'\n1585:         ? await runSkillGraphScanJob(validated.args, parsed.timeoutMs, parsed.trusted, parsed.warmOnly)\n1586:         : validated.tool.name === 'advisor_validate'\n1587:           ? await invokeAdvisorValidatePayload(validated.args, parsed.timeoutMs, parsed.trusted, parsed.warmOnly)\n1588:           : await invokeToolPayload(validated.tool.name, validated.args, parsed.timeoutMs, parsed.trusted, parsed.warmOnly);\n1589:     await writeLine(io.stdout, renderPayload(invoked.payload, parsed.format, validated.tool.name));\n1590:     return invoked.isError ? EXIT_RUNTIME : EXIT_SUCCESS;\n1591:   } catch (error: unknown) {\n1592:     const exitCode = exitCodeForError(error);\n1593:     const message = error instanceof Error ? error.message : String(error);\n1594:     const unknownCommand = unknownCommandContext(message);\n1595:     const payload = {\n1596:       status: 'error',\n1597:       error: message,\n1598:       exitCode,\n1599:       ...(unknownCommand ? { hint: unknownCommand.hint } : {}),\n1600:       ...(unknownCommand?.suggestion ? { suggestion: unknownCommand.suggestion } : {}),\n1601:     };\n1602:     const format = (() => {\n1603:       try {\n1604:         return parseCliArgs(argv).format;\n1605:       } catch {\n1606:         return 'text' as OutputFormat;\n1607:       }\n1608:     })();\n1609:     if (format === 'json' || format === 'jsonl') {\n1610:       await writeLine(io.stderr, renderJson(payload, format));\n1611:     } else {\n1612:       await writeLine(io.stderr, [\n1613:         `ERROR: ${message}`,\n1614:         unknownCommand ? `Hint: ${unknownCommand.hint}` : null,\n1615:         unknownCommand?.suggestion ? `Did you mean \\`${unknownCommand.suggestion}\\`?` : null,\n1616:       ].filter((line): line is string => Boolean(line)).join('\\n'));\n1617:     }\n1618:     return exitCode;\n1619:   }\n1620: }\n1621: \n1622: function isCliEntrypoint(): boolean {\n1623:   const invoked = process.argv[1];\n1624:   if (!invoked) return false;\n1625:   return path.resolve(invoked) === path.resolve(currentModulePath());\n1626: }\n1627: \n1628: export const __testing = {\n1629:   DEFAULT_SOCKET_DIR,\n1630:   EXIT_PROTOCOL,\n1631:   EXIT_RETRYABLE,\n1632:   EXIT_USAGE,\n1633:   advisorValidateRetryDelayMs,\n1634:   commandMap,\n1635:   closestCommand,\n1636:   ensureSocketEnvironment,\n1637:   exitCodeForError,\n1638:   findRepoPaths,\n1639:   invokeWithRetry,\n1640:   liveDaemonPredatesBuild,\n1641:   renderCompletion,\n1642:   renderToolList,\n1643:   resolvePropertyName,\n1644:   validateCommand,\n1645: };\n1646: \n1647: if (isCliEntrypoint()) {\n1648:   // Natural exit via process.exitCode: a hard process.exit() drops any\n1649:   // stdout bytes still queued behind the kernel pipe buffer, truncating\n1650:   // large payloads. Pending pipe writes keep the event loop alive until\n1651:   // they flush; all sockets and timers are closed or unref'd by here.\n1652:   process.exitCode = await runSkillAdvisorCli(process.argv.slice(2));\n1653: }"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/skill-advisor-cli.ts\",\"offset\":1324,\"limit\":400}"},"time":{"start":1794527182726,"end":1794527183263}}}}
