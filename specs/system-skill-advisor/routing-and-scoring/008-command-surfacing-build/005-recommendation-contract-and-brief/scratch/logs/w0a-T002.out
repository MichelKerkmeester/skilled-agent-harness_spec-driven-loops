{"type":"tool_use","timestamp":1794521936820,"sessionID":"ses_e2e2a7f1fffe9admTsfI03Rp1i","part":{"partID":"prt_1d1d7b3110019LYh4eGPKzzSkO","sessionID":"ses_e2e2a7f1fffe9admTsfI03Rp1i","messageID":"msg_1d1d7a946001Qy53XIE8U30uuw","type":"tool","id":"call_9208e27a66334e578613a0c8","tool":"read","state":{"status":"completed","input":{"path":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/hooks/claude/user-prompt-submit.ts"},"output":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/hooks/claude/user-prompt-submit.ts, lines 1-527\n1: #!/usr/bin/env node\n2: // ───────────────────────────────────────────────────────────────\n3: // MODULE: UserPromptSubmit Hook — Skill Advisor Brief\n4: // ───────────────────────────────────────────────────────────────\n5: // Runs on Claude Code UserPromptSubmit. Emits a JSON additionalContext\n6: // envelope for model-visible advisor guidance and fails open on all errors.\n7: \n8: // ───────────────────────────────────────────────────────────────\n9: // 1. IMPORTS\n10: // ───────────────────────────────────────────────────────────────\n11: \n12: import { statSync } from 'node:fs';\n13: import { createRequire } from 'node:module';\n14: import { performance } from 'node:perf_hooks';\n15: import { resolve } from 'node:path';\n16: import { fileURLToPath } from 'node:url';\n17: import { isAdvisorRuntime, type AdvisorRuntime } from '../../runtime/lib/advisor-runtime-values.js';\n18: import { findAdvisorWorkspaceRoot } from '../../runtime/lib/utils/workspace-root.js';\n19: import {\n20:   buildSkillAdvisorBrief,\n21:   skippedAdvisorResultFor,\n22:   type AdvisorHookResult,\n23:   type AdvisorHookStatus,\n24:   type AdvisorHookFreshness,\n25: } from '../../runtime/lib/skill-advisor-brief.js';\n26: import {\n27:   decideDirectiveLifecycleDelivery,\n28:   defaultDirectiveLifecycleStore,\n29:   isDirectiveLifecycleDedupEnabled,\n30:   type DirectiveLifecycleState,\n31: } from '../lib/directive-lifecycle.js';\n32: import {\n33:   renderAdvisorBrief,\n34:   renderAdvisorFallbackDirective,\n35:   observeEmittedAdvisorPolicy,\n36: } from '../../runtime/lib/render.js';\n37: import type { ShadowDeliveryRenderOptions } from '../../runtime/lib/render.js';\n38: import {\n39:   createAdvisorHookDiagnosticRecord,\n40:   persistAdvisorHookDiagnosticRecord,\n41:   serializeAdvisorHookDiagnosticRecord,\n42: } from '../../runtime/lib/metrics.js';\n43: import { buildSkillAdvisorBriefFromCli } from '../lib/skill-advisor-cli-fallback.js';\n44: \n45: export { renderAdvisorFallbackDirective };\n46: \n47: // ───────────────────────────────────────────────────────────────\n48: // 2. CONFIGURATION\n49: // ───────────────────────────────────────────────────────────────\n50: \n51: const IS_CLI_ENTRY = process.argv[1]\n52:   ? resolve(process.argv[1]) === fileURLToPath(import.meta.url)\n53:   : false;\n54: \n55: const requireFromAdvisor = createRequire(import.meta.url);\n56: \n57: // Setup, install and configure words trigger the hint; check needs nearby tooling context.\n58: // Bounded context keeps unrelated checks quiet without scanning long prompts.\n59: export const SETUP_WORDING = new RegExp(\n60:   String.raw`\\b(?:set[\\s-]?up|setups?`\n61:     + String.raw`|(?:re)?install(?:s|ed|ing|ation|er|ers)?`\n62:     + String.raw`|configur(?:e|es|ed|ing|ations?)`\n63:     + String.raw`|check(?:s|ed|ing)?(?:\\s+\\S+){0,2}?\\s+`\n64:     + String.raw`(?:environment|env|config(?:s|urations?)?`\n65:     + String.raw`|hooks?|tools|tooling|toolchain|skilled))\\b`,\n66:   'i',\n67: );\n68: function skillAdvisorHookEnabled(): boolean {\n69:   try {\n70:     const { isHookEnabled } = requireFromAdvisor(\n71:       fileURLToPath(new URL('../../../../../../hooks/shared/hook-flags.cjs', import.meta.url)),\n72:     ) as { isHookEnabled?: (concern: string) => boolean };\n73:     return typeof isHookEnabled !== 'function' || isHookEnabled('skill-advisor') !== false;\n74:   } catch {\n75:     return true;\n76:   }\n77: }\n78: \n79: // ───────────────────────────────────────────────────────────────\n80: // 3. TYPES\n81: // ───────────────────────────────────────────────────────────────\n82: \n83: export interface ClaudeUserPromptSubmitInput {\n84:   readonly session_id?: string;\n85:   readonly session_identity_confirmed?: boolean;\n86:   readonly session_identity_ambiguous?: boolean;\n87:   readonly hook_event_name?: string;\n88:   readonly lifecycle_event?: string;\n89:   readonly lifecycle_source?: string;\n90:   readonly source?: string;\n91:   readonly scope_changed?: boolean;\n92:   readonly policy_set_changed?: boolean;\n93:   readonly goal_changed?: boolean;\n94:   readonly delivery_receipt_status?: 'configured' | 'observed' | 'unobserved' | 'unknown';\n95:   readonly prompt?: string;\n96:   readonly cwd?: string;\n97:   readonly transcript_path?: string;\n98:   readonly [key: string]: unknown;\n99: }\n100: \n101: export interface ClaudeHookSpecificOutput {\n102:   readonly hookSpecificOutput: {\n103:     readonly hookEventName: 'UserPromptSubmit';\n104:     readonly additionalContext: string;\n105:   };\n106: }\n107: \n108: export type ClaudeUserPromptSubmitOutput = ClaudeHookSpecificOutput | Record<string, never>;\n109: \n110: export interface UserPromptSubmitDependencies {\n111:   /** In-process callers such as Pi pass their runtime directly. */\n112:   readonly runtime?: AdvisorRuntime;\n113:   readonly buildBrief?: typeof buildSkillAdvisorBrief;\n114:   readonly buildCliBrief?: typeof buildSkillAdvisorBriefFromCli;\n115:   readonly renderBrief?: typeof renderAdvisorBrief;\n116:   readonly now?: () => number;\n117:   readonly writeDiagnostic?: (line: string) => void;\n118:   /** Per-session directive-lifecycle dedup state; defaults to the durable file-backed store. */\n119:   readonly directiveLifecycleStore?: DirectiveLifecycleState;\n120:   /** Delay a full-delivery receipt until the process handoff acknowledges stdout. */\n121:   readonly deferDirectiveReceipt?: boolean;\n122: }\n123: \n124: interface HookDiagnosticInput {\n125:   readonly runtime?: AdvisorRuntime;\n126:   readonly workspaceRoot: string;\n127:   readonly status: AdvisorHookStatus;\n128:   readonly freshness: AdvisorHookFreshness;\n129:   readonly durationMs: number;\n130:   readonly cacheHit: boolean;\n131:   readonly errorCode?: unknown;\n132:   readonly errorDetails?: string;\n133:   readonly skillLabel?: string | null;\n134:   readonly generation?: number;\n135:   readonly emittedBytes?: number;\n136:   readonly directivesSuppressed?: boolean;\n137: }\n138: \n139: // ───────────────────────────────────────────────────────────────\n140: // 4. CONSTANTS\n141: // ───────────────────────────────────────────────────────────────\n142: \n143: export const DEFAULT_CLAUDE_HOOK_TIMEOUT_MS = 2500;\n144: const MAX_PROMPT_BYTES = 64 * 1024;\n145: const OBSERVED_ADVISOR_POLICY_CANDIDATE = '004';\n146: const DIRECTIVE_RECEIPT_COMMIT = Symbol('directiveReceiptCommit');\n147: const pendingDiagnosticWrites = new Set<Promise<unknown>>();\n148: \n149: // ───────────────────────────────────────────────────────────────\n150: // 5. HELPERS\n151: // ───────────────────────────────────────────────────────────────\n152: \n153: function isRecord(value: unknown): value is Record<string, unknown> {\n154:   return typeof value === 'object' && value !== null && !Array.isArray(value);\n155: }\n156: \n157: function normalizePrompt(value: unknown): string | null {\n158:   if (typeof value !== 'string') {\n159:     return null;\n160:   }\n161:   if (Buffer.byteLength(value, 'utf8') <= MAX_PROMPT_BYTES) {\n162:     return value;\n163:   }\n164: \n165:   let low = 0;\n166:   let high = value.length;\n167:   while (low < high) {\n168:     const midpoint = Math.ceil((low + high) / 2);\n169:     if (Buffer.byteLength(value.slice(0, midpoint), 'utf8') <= MAX_PROMPT_BYTES) {\n170:       low = midpoint;\n171:     } else {\n172:       high = midpoint - 1;\n173:     }\n174:   }\n175:   return value.slice(0, low);\n176: }\n177: \n178: export function workspaceRootFor(input: ClaudeUserPromptSubmitInput): string {\n179:   const start =\n180:     typeof input.cwd === 'string' && input.cwd.trim().length > 0\n181:       ? input.cwd\n182:       : process.cwd();\n183:   // Anchor to the real repo root. A raw session cwd inside a specs/<packet>\n184:   // directory would otherwise become the \"workspace root\", and the advisor's\n185:   // state writers materialize a stray .state/advisor tree under it.\n186:   return findAdvisorWorkspaceRoot(start);\n187: }\n188: \n189: function skillLabelFor(result: AdvisorHookResult): string | null {\n190:   const metadataLabel = result.sharedPayload?.metadata?.skillLabel;\n191:   if (typeof metadataLabel === 'string') {\n192:     return metadataLabel;\n193:   }\n194:   return result.recommendations[0]?.skill ?? null;\n195: }\n196: \n197: function positiveIntFromEnv(value: string | undefined, fallback: number): number {\n198:   if (typeof value !== 'string' || value.trim().length === 0) {\n199:     return fallback;\n200:   }\n201:   const parsed = Number.parseInt(value, 10);\n202:   return Number.isFinite(parsed) && parsed > 0 ? parsed : fallback;\n203: }\n204: \n205: function claudeHookTimeoutMs(): number {\n206:   return positiveIntFromEnv(process.env.SPECKIT_CLAUDE_HOOK_TIMEOUT_MS, DEFAULT_CLAUDE_HOOK_TIMEOUT_MS);\n207: }\n208: \n209: function lifecycleEventFor(input: ClaudeUserPromptSubmitInput): string | undefined {\n210:   const explicit = input.lifecycle_event ?? input.lifecycle_source;\n211:   if (explicit === 'startup' || explicit === 'resume' || explicit === 'compact') {\n212:     return explicit;\n213:   }\n214:   if (input.hook_event_name === 'SessionStart'\n215:     && (input.source === 'startup' || input.source === 'resume' || input.source === 'compact')) {\n216:     return input.source;\n217:   }\n218:   return undefined;\n219: }\n220: \n221: /** Convert runtime-owned identity and lifecycle fields into shadow-only signals. */\n222: export function deliveryStateOptionsFor(\n223:   input: ClaudeUserPromptSubmitInput,\n224: ): ShadowDeliveryRenderOptions {\n225:   const hasSessionId = typeof input.session_id === 'string' && input.session_id.trim().length > 0;\n226:   return {\n227:     sessionId: input.session_id,\n228:     sessionIdentityConfirmed: input.session_identity_confirmed ?? hasSessionId,\n229:     sessionIdentityAmbiguous: input.session_identity_ambiguous === true,\n230:     lifecycleEvent: lifecycleEventFor(input),\n231:     scopeChanged: input.scope_changed === true,\n232:     policySetChanged: input.policy_set_changed === true,\n233:     goalChanged: input.goal_changed === true,\n234:     deliveryConfirmed: false,\n235:   };\n236: }\n237: \n238: export function emitDiagnostic(\n239:   record: HookDiagnosticInput,\n240:   writeDiagnostic: (line: string) => void = (line) => process.stderr.write(`${line}\\n`),\n241:   persistDiagnostic: typeof persistAdvisorHookDiagnosticRecord = persistAdvisorHookDiagnosticRecord,\n242: ): void {\n243:   try {\n244:     const diagnosticRecord = createAdvisorHookDiagnosticRecord({\n245:       runtime: 'claude',\n246:       ...record,\n247:     });\n248:     const line = serializeAdvisorHookDiagnosticRecord(diagnosticRecord);\n249:     writeDiagnostic(line);\n250:     const pendingWrite = persistDiagnostic(record.workspaceRoot, diagnosticRecord).catch(() => undefined);\n251:     pendingDiagnosticWrites.add(pendingWrite);\n252:     void pendingWrite.then(() => pendingDiagnosticWrites.delete(pendingWrite));\n253:   } catch {\n254:     // Diagnostics must never affect hook behavior.\n255:   }\n256: }\n257: \n258: export async function flushPendingDiagnostics(maxWaitMs = 100): Promise<void> {\n259:   let timeout: NodeJS.Timeout | undefined;\n260:   try {\n261:     if (pendingDiagnosticWrites.size === 0) return;\n262:     const pendingWrites = Promise.all([...pendingDiagnosticWrites]).then(() => undefined);\n263:     const timeoutElapsed = new Promise<void>((resolvePromise) => {\n264:       timeout = setTimeout(resolvePromise, maxWaitMs);\n265:       timeout.unref();\n266:     });\n267:     await Promise.race([pendingWrites, timeoutElapsed]);\n268:   } catch {\n269:     // Diagnostics must never affect hook behavior.\n270:   } finally {\n271:     if (timeout) clearTimeout(timeout);\n272:   }\n273: }\n274: \n275: export function parseClaudeUserPromptSubmitInput(raw: string): ClaudeUserPromptSubmitInput | null {\n276:   try {\n277:     const parsed = JSON.parse(raw) as unknown;\n278:     return isRecord(parsed) ? parsed : null;\n279:   } catch {\n280:     return null;\n281:   }\n282: }\n283: \n284: // ───────────────────────────────────────────────────────────────\n285: // 6. CORE LOGIC\n286: // ───────────────────────────────────────────────────────────────\n287: \n288: export async function handleClaudeUserPromptSubmit(\n289:   input: ClaudeUserPromptSubmitInput | null,\n290:   dependencies: UserPromptSubmitDependencies = {},\n291: ): Promise<ClaudeUserPromptSubmitOutput> {\n292:   const environmentRuntime = process.env.SPECKIT_RUNTIME;\n293:   const runtime = dependencies.runtime\n294:     ?? (isAdvisorRuntime(environmentRuntime) ? environmentRuntime : 'claude');\n295:   const startedAt = dependencies.now?.() ?? performance.now();\n296:   const elapsed = (): number => Number(((dependencies.now?.() ?? performance.now()) - startedAt).toFixed(3));\n297:   const writeDiagnostic = dependencies.writeDiagnostic;\n298: \n299:   try {\n300:     if (!skillAdvisorHookEnabled() || process.env.SPECKIT_SKILL_ADVISOR_HOOK_DISABLED === '1') {\n301:       emitDiagnostic({\n302:         runtime,\n303:         workspaceRoot: process.cwd(),\n304:         status: 'skipped',\n305:         freshness: 'unavailable',\n306:         durationMs: elapsed(),\n307:         cacheHit: false,\n308:       }, writeDiagnostic);\n309:       return {};\n310:     }\n311: \n312:     if (!input) {\n313:       emitDiagnostic({\n314:         runtime,\n315:         workspaceRoot: process.cwd(),\n316:         status: 'fail_open',\n317:         freshness: 'unavailable',\n318:         durationMs: elapsed(),\n319:         cacheHit: false,\n320:         errorCode: 'PARSE_FAIL',\n321:         errorDetails: 'Invalid UserPromptSubmit JSON payload',\n322:       }, writeDiagnostic);\n323:       return {};\n324:     }\n325: \n326:     const prompt = normalizePrompt(input.prompt);\n327:     const workspaceRoot = workspaceRootFor(input);\n328:     if (prompt === null) {\n329:       emitDiagnostic({\n330:         runtime,\n331:         workspaceRoot,\n332:         status: 'fail_open',\n333:         freshness: 'unavailable',\n334:         durationMs: elapsed(),\n335:         cacheHit: false,\n336:         errorCode: 'PARSE_FAIL',\n337:         errorDetails: 'Missing UserPromptSubmit prompt string',\n338:       }, writeDiagnostic);\n339:       return {};\n340:     }\n341: \n342:     const renderBrief = dependencies.renderBrief ?? renderAdvisorBrief;\n343:     // The CLI owns the warm-daemon probe and local-scorer fallback.\n344:     // The prompt-policy gate skips prompts that need no advisor before the\n345:     // CLI call; injected full producers stay ungated for producer-level tests.\n346:     const injectedBrief = dependencies.buildBrief;\n347:     const buildCliBrief = dependencies.buildCliBrief ?? buildSkillAdvisorBriefFromCli;\n348:     let result = injectedBrief\n349:       ? await injectedBrief(prompt, {\n350:         runtime,\n351:         workspaceRoot,\n352:         subprocessTimeoutMs: claudeHookTimeoutMs(),\n353:       })\n354:       : skippedAdvisorResultFor(prompt) ?? await buildCliBrief(prompt, {\n355:         runtime,\n356:         workspaceRoot,\n357:         timeoutMs: claudeHookTimeoutMs(),\n358:       }, {\n359:         now: dependencies.now,\n360:       });\n361: \n362:     result = {\n363:       ...result,\n364:       metrics: {\n365:         ...result.metrics,\n366:         durationMs: elapsed(),\n367:       },\n368:     };\n369:     const deliveryState = deliveryStateOptionsFor(input);\n370:     const brief = renderBrief(result, { deliveryState });\n371:     const renderOptions = { deliveryState, setupWording: !brief && SETUP_WORDING.test(prompt) };\n372:     const emitted = brief ?? renderAdvisorFallbackDirective(renderOptions, result);\n373:     // Directive-lifecycle dedup delivers the full brief on the first message\n374:     // and after lifecycle boundaries or transcript shrink. On proven repeats,\n375:     // it keeps the head and drops the constant directive block. A headed\n376:     // fallback reduces like a brief; unknown sessions, the kill switch, and\n377:     // thrown errors still get the full text.\n378:     let effectiveEmitted = emitted;\n379:     let commitFullReceipt: (() => boolean) | undefined;\n380:     try {\n381:       const sessionId = typeof input.session_id === 'string' && input.session_id.trim().length > 0\n382:         ? input.session_id\n383:         : undefined;\n384:       const sessionConfirmed = input.session_identity_confirmed\n385:         ?? (Boolean(sessionId) && input.session_identity_ambiguous !== true);\n386:       const transcriptPath = typeof input.transcript_path === 'string' && input.transcript_path.length > 0\n387:         ? input.transcript_path\n388:         : null;\n389:       let transcriptBytes: number | null = null;\n390:       if (transcriptPath) {\n391:         try {\n392:           transcriptBytes = statSync(transcriptPath).size;\n393:         } catch {\n394:           transcriptBytes = null;\n395:         }\n396:       }\n397:       const decision = decideDirectiveLifecycleDelivery(emitted, {\n398:         state: dependencies.directiveLifecycleStore ?? defaultDirectiveLifecycleStore(),\n399:         sessionId,\n400:         sessionConfirmed,\n401:         lifecycleEvent: lifecycleEventFor(input),\n402:         transcriptPath,\n403:         transcriptBytes,\n404:         enabled: isDirectiveLifecycleDedupEnabled(),\n405:         deferFullReceipt: dependencies.deferDirectiveReceipt === true,\n406:       });\n407:       commitFullReceipt = decision.commitFullReceipt;\n408:       if (decision.suppressed && decision.reducedContext) {\n409:         effectiveEmitted = decision.reducedContext;\n410:       }\n411:     } catch {\n412:       // Directive dedup is advisory; on any failure keep the full brief.\n413:       effectiveEmitted = emitted;\n414:     }\n415:     emitDiagnostic({\n416:       runtime,\n417:       workspaceRoot,\n418:       status: result.status,\n419:       freshness: result.freshness,\n420:       durationMs: result.metrics.durationMs,\n421:       cacheHit: result.metrics.cacheHit,\n422:       errorCode: result.diagnostics?.errorCode,\n423:       errorDetails: result.diagnostics?.errorMessage ?? result.diagnostics?.policyReason ?? result.diagnostics?.staleReason,\n424:       skillLabel: skillLabelFor(result),\n425:       emittedBytes: Buffer.byteLength(effectiveEmitted, 'utf8'),\n426:       directivesSuppressed: effectiveEmitted !== emitted,\n427:     }, writeDiagnostic);\n428: \n429:     const output: ClaudeUserPromptSubmitOutput = {\n430:       hookSpecificOutput: {\n431:         hookEventName: 'UserPromptSubmit',\n432:         additionalContext: effectiveEmitted,\n433:       },\n434:     };\n435:     if (commitFullReceipt) {\n436:       Object.defineProperty(output, DIRECTIVE_RECEIPT_COMMIT, {\n437:         configurable: true,\n438:         enumerable: false,\n439:         value: commitFullReceipt,\n440:       });\n441:     }\n442:     observeEmittedAdvisorPolicy(effectiveEmitted, {\n443:       ...deliveryState,\n444:       runtime: 'Claude Code',\n445:       candidate: OBSERVED_ADVISOR_POLICY_CANDIDATE,\n446:     });\n447:     return output;\n448:   } catch {\n449:     emitDiagnostic({\n450:       runtime,\n451:       workspaceRoot: input ? workspaceRootFor(input) : process.cwd(),\n452:       status: 'fail_open',\n453:       freshness: 'unavailable',\n454:       durationMs: elapsed(),\n455:       cacheHit: false,\n456:       errorCode: 'UNKNOWN',\n457:       errorDetails: 'Unhandled UserPromptSubmit hook exception',\n458:     }, writeDiagnostic);\n459:     return {};\n460:   }\n461: }\n462: \n463: // ───────────────────────────────────────────────────────────────\n464: // 7. OUTPUT DELIVERY\n465: // ───────────────────────────────────────────────────────────────\n466: \n467: async function readStdin(): Promise<string> {\n468:   const chunks: Buffer[] = [];\n469:   for await (const chunk of process.stdin) {\n470:     chunks.push(chunk as Buffer);\n471:   }\n472:   return Buffer.concat(chunks).toString('utf-8').trim();\n473: }\n474: \n475: export function commitClaudeDirectiveDeliveryReceipt(\n476:   output: ClaudeUserPromptSubmitOutput,\n477: ): boolean {\n478:   const record = output as ClaudeUserPromptSubmitOutput & {\n479:     [DIRECTIVE_RECEIPT_COMMIT]?: () => boolean;\n480:   };\n481:   const commit = record[DIRECTIVE_RECEIPT_COMMIT];\n482:   if (!commit) return true;\n483:   delete record[DIRECTIVE_RECEIPT_COMMIT];\n484:   return commit();\n485: }\n486: \n487: function writeHookOutput(output: ClaudeUserPromptSubmitOutput): Promise<void> {\n488:   return new Promise<void>((resolvePromise) => {\n489:     process.stdout.write(`${JSON.stringify(output)}\\n`, () => {\n490:       commitClaudeDirectiveDeliveryReceipt(output);\n491:       resolvePromise();\n492:     });\n493:   });\n494: }\n495: \n496: // ───────────────────────────────────────────────────────────────\n497: // 8. CLI ENTRY POINT\n498: // ───────────────────────────────────────────────────────────────\n499: \n500: async function main(): Promise<void> {\n501:   const rawInput = await readStdin();\n502:   const input = rawInput ? parseClaudeUserPromptSubmitInput(rawInput) : null;\n503:   const output = await handleClaudeUserPromptSubmit(input, {\n504:     writeDiagnostic: (line) => process.stderr.write(`${line}\\n`),\n505:     deferDirectiveReceipt: true,\n506:   });\n507:   await writeHookOutput(output);\n508: }\n509: \n510: if (IS_CLI_ENTRY) {\n511:   main().catch(async () => {\n512:     emitDiagnostic({\n513:       workspaceRoot: process.cwd(),\n514:       status: 'fail_open',\n515:       freshness: 'unavailable',\n516:       durationMs: 0,\n517:       cacheHit: false,\n518:       errorCode: 'UNKNOWN',\n519:       errorDetails: 'Unhandled UserPromptSubmit CLI exception',\n520:     });\n521:     await writeHookOutput({});\n522:   }).finally(async () => {\n523:     // The exit would otherwise drop diagnostic appends; the cap preserves the shim's kill margin.\n524:     await flushPendingDiagnostics();\n525:     process.exit(0);\n526:   });\n527: }","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/hooks/claude/user-prompt-submit.ts, lines 1-527\n1: #!/usr/bin/env node\n2: // ───────────────────────────────────────────────────────────────\n3: // MODULE: UserPromptSubmit Hook — Skill Advisor Brief\n4: // ───────────────────────────────────────────────────────────────\n5: // Runs on Claude Code UserPromptSubmit. Emits a JSON additionalContext\n6: // envelope for model-visible advisor guidance and fails open on all errors.\n7: \n8: // ───────────────────────────────────────────────────────────────\n9: // 1. IMPORTS\n10: // ───────────────────────────────────────────────────────────────\n11: \n12: import { statSync } from 'node:fs';\n13: import { createRequire } from 'node:module';\n14: import { performance } from 'node:perf_hooks';\n15: import { resolve } from 'node:path';\n16: import { fileURLToPath } from 'node:url';\n17: import { isAdvisorRuntime, type AdvisorRuntime } from '../../runtime/lib/advisor-runtime-values.js';\n18: import { findAdvisorWorkspaceRoot } from '../../runtime/lib/utils/workspace-root.js';\n19: import {\n20:   buildSkillAdvisorBrief,\n21:   skippedAdvisorResultFor,\n22:   type AdvisorHookResult,\n23:   type AdvisorHookStatus,\n24:   type AdvisorHookFreshness,\n25: } from '../../runtime/lib/skill-advisor-brief.js';\n26: import {\n27:   decideDirectiveLifecycleDelivery,\n28:   defaultDirectiveLifecycleStore,\n29:   isDirectiveLifecycleDedupEnabled,\n30:   type DirectiveLifecycleState,\n31: } from '../lib/directive-lifecycle.js';\n32: import {\n33:   renderAdvisorBrief,\n34:   renderAdvisorFallbackDirective,\n35:   observeEmittedAdvisorPolicy,\n36: } from '../../runtime/lib/render.js';\n37: import type { ShadowDeliveryRenderOptions } from '../../runtime/lib/render.js';\n38: import {\n39:   createAdvisorHookDiagnosticRecord,\n40:   persistAdvisorHookDiagnosticRecord,\n41:   serializeAdvisorHookDiagnosticRecord,\n42: } from '../../runtime/lib/metrics.js';\n43: import { buildSkillAdvisorBriefFromCli } from '../lib/skill-advisor-cli-fallback.js';\n44: \n45: export { renderAdvisorFallbackDirective };\n46: \n47: // ───────────────────────────────────────────────────────────────\n48: // 2. CONFIGURATION\n49: // ───────────────────────────────────────────────────────────────\n50: \n51: const IS_CLI_ENTRY = process.argv[1]\n52:   ? resolve(process.argv[1]) === fileURLToPath(import.meta.url)\n53:   : false;\n54: \n55: const requireFromAdvisor = createRequire(import.meta.url);\n56: \n57: // Setup, install and configure words trigger the hint; check needs nearby tooling context.\n58: // Bounded context keeps unrelated checks quiet without scanning long prompts.\n59: export const SETUP_WORDING = new RegExp(\n60:   String.raw`\\b(?:set[\\s-]?up|setups?`\n61:     + String.raw`|(?:re)?install(?:s|ed|ing|ation|er|ers)?`\n62:     + String.raw`|configur(?:e|es|ed|ing|ations?)`\n63:     + String.raw`|check(?:s|ed|ing)?(?:\\s+\\S+){0,2}?\\s+`\n64:     + String.raw`(?:environment|env|config(?:s|urations?)?`\n65:     + String.raw`|hooks?|tools|tooling|toolchain|skilled))\\b`,\n66:   'i',\n67: );\n68: function skillAdvisorHookEnabled(): boolean {\n69:   try {\n70:     const { isHookEnabled } = requireFromAdvisor(\n71:       fileURLToPath(new URL('../../../../../../hooks/shared/hook-flags.cjs', import.meta.url)),\n72:     ) as { isHookEnabled?: (concern: string) => boolean };\n73:     return typeof isHookEnabled !== 'function' || isHookEnabled('skill-advisor') !== false;\n74:   } catch {\n75:     return true;\n76:   }\n77: }\n78: \n79: // ───────────────────────────────────────────────────────────────\n80: // 3. TYPES\n81: // ───────────────────────────────────────────────────────────────\n82: \n83: export interface ClaudeUserPromptSubmitInput {\n84:   readonly session_id?: string;\n85:   readonly session_identity_confirmed?: boolean;\n86:   readonly session_identity_ambiguous?: boolean;\n87:   readonly hook_event_name?: string;\n88:   readonly lifecycle_event?: string;\n89:   readonly lifecycle_source?: string;\n90:   readonly source?: string;\n91:   readonly scope_changed?: boolean;\n92:   readonly policy_set_changed?: boolean;\n93:   readonly goal_changed?: boolean;\n94:   readonly delivery_receipt_status?: 'configured' | 'observed' | 'unobserved' | 'unknown';\n95:   readonly prompt?: string;\n96:   readonly cwd?: string;\n97:   readonly transcript_path?: string;\n98:   readonly [key: string]: unknown;\n99: }\n100: \n101: export interface ClaudeHookSpecificOutput {\n102:   readonly hookSpecificOutput: {\n103:     readonly hookEventName: 'UserPromptSubmit';\n104:     readonly additionalContext: string;\n105:   };\n106: }\n107: \n108: export type ClaudeUserPromptSubmitOutput = ClaudeHookSpecificOutput | Record<string, never>;\n109: \n110: export interface UserPromptSubmitDependencies {\n111:   /** In-process callers such as Pi pass their runtime directly. */\n112:   readonly runtime?: AdvisorRuntime;\n113:   readonly buildBrief?: typeof buildSkillAdvisorBrief;\n114:   readonly buildCliBrief?: typeof buildSkillAdvisorBriefFromCli;\n115:   readonly renderBrief?: typeof renderAdvisorBrief;\n116:   readonly now?: () => number;\n117:   readonly writeDiagnostic?: (line: string) => void;\n118:   /** Per-session directive-lifecycle dedup state; defaults to the durable file-backed store. */\n119:   readonly directiveLifecycleStore?: DirectiveLifecycleState;\n120:   /** Delay a full-delivery receipt until the process handoff acknowledges stdout. */\n121:   readonly deferDirectiveReceipt?: boolean;\n122: }\n123: \n124: interface HookDiagnosticInput {\n125:   readonly runtime?: AdvisorRuntime;\n126:   readonly workspaceRoot: string;\n127:   readonly status: AdvisorHookStatus;\n128:   readonly freshness: AdvisorHookFreshness;\n129:   readonly durationMs: number;\n130:   readonly cacheHit: boolean;\n131:   readonly errorCode?: unknown;\n132:   readonly errorDetails?: string;\n133:   readonly skillLabel?: string | null;\n134:   readonly generation?: number;\n135:   readonly emittedBytes?: number;\n136:   readonly directivesSuppressed?: boolean;\n137: }\n138: \n139: // ───────────────────────────────────────────────────────────────\n140: // 4. CONSTANTS\n141: // ───────────────────────────────────────────────────────────────\n142: \n143: export const DEFAULT_CLAUDE_HOOK_TIMEOUT_MS = 2500;\n144: const MAX_PROMPT_BYTES = 64 * 1024;\n145: const OBSERVED_ADVISOR_POLICY_CANDIDATE = '004';\n146: const DIRECTIVE_RECEIPT_COMMIT = Symbol('directiveReceiptCommit');\n147: const pendingDiagnosticWrites = new Set<Promise<unknown>>();\n148: \n149: // ───────────────────────────────────────────────────────────────\n150: // 5. HELPERS\n151: // ───────────────────────────────────────────────────────────────\n152: \n153: function isRecord(value: unknown): value is Record<string, unknown> {\n154:   return typeof value === 'object' && value !== null && !Array.isArray(value);\n155: }\n156: \n157: function normalizePrompt(value: unknown): string | null {\n158:   if (typeof value !== 'string') {\n159:     return null;\n160:   }\n161:   if (Buffer.byteLength(value, 'utf8') <= MAX_PROMPT_BYTES) {\n162:     return value;\n163:   }\n164: \n165:   let low = 0;\n166:   let high = value.length;\n167:   while (low < high) {\n168:     const midpoint = Math.ceil((low + high) / 2);\n169:     if (Buffer.byteLength(value.slice(0, midpoint), 'utf8') <= MAX_PROMPT_BYTES) {\n170:       low = midpoint;\n171:     } else {\n172:       high = midpoint - 1;\n173:     }\n174:   }\n175:   return value.slice(0, low);\n176: }\n177: \n178: export function workspaceRootFor(input: ClaudeUserPromptSubmitInput): string {\n179:   const start =\n180:     typeof input.cwd === 'string' && input.cwd.trim().length > 0\n181:       ? input.cwd\n182:       : process.cwd();\n183:   // Anchor to the real repo root. A raw session cwd inside a specs/<packet>\n184:   // directory would otherwise become the \"workspace root\", and the advisor's\n185:   // state writers materialize a stray .state/advisor tree under it.\n186:   return findAdvisorWorkspaceRoot(start);\n187: }\n188: \n189: function skillLabelFor(result: AdvisorHookResult): string | null {\n190:   const metadataLabel = result.sharedPayload?.metadata?.skillLabel;\n191:   if (typeof metadataLabel === 'string') {\n192:     return metadataLabel;\n193:   }\n194:   return result.recommendations[0]?.skill ?? null;\n195: }\n196: \n197: function positiveIntFromEnv(value: string | undefined, fallback: number): number {\n198:   if (typeof value !== 'string' || value.trim().length === 0) {\n199:     return fallback;\n200:   }\n201:   const parsed = Number.parseInt(value, 10);\n202:   return Number.isFinite(parsed) && parsed > 0 ? parsed : fallback;\n203: }\n204: \n205: function claudeHookTimeoutMs(): number {\n206:   return positiveIntFromEnv(process.env.SPECKIT_CLAUDE_HOOK_TIMEOUT_MS, DEFAULT_CLAUDE_HOOK_TIMEOUT_MS);\n207: }\n208: \n209: function lifecycleEventFor(input: ClaudeUserPromptSubmitInput): string | undefined {\n210:   const explicit = input.lifecycle_event ?? input.lifecycle_source;\n211:   if (explicit === 'startup' || explicit === 'resume' || explicit === 'compact') {\n212:     return explicit;\n213:   }\n214:   if (input.hook_event_name === 'SessionStart'\n215:     && (input.source === 'startup' || input.source === 'resume' || input.source === 'compact')) {\n216:     return input.source;\n217:   }\n218:   return undefined;\n219: }\n220: \n221: /** Convert runtime-owned identity and lifecycle fields into shadow-only signals. */\n222: export function deliveryStateOptionsFor(\n223:   input: ClaudeUserPromptSubmitInput,\n224: ): ShadowDeliveryRenderOptions {\n225:   const hasSessionId = typeof input.session_id === 'string' && input.session_id.trim().length > 0;\n226:   return {\n227:     sessionId: input.session_id,\n228:     sessionIdentityConfirmed: input.session_identity_confirmed ?? hasSessionId,\n229:     sessionIdentityAmbiguous: input.session_identity_ambiguous === true,\n230:     lifecycleEvent: lifecycleEventFor(input),\n231:     scopeChanged: input.scope_changed === true,\n232:     policySetChanged: input.policy_set_changed === true,\n233:     goalChanged: input.goal_changed === true,\n234:     deliveryConfirmed: false,\n235:   };\n236: }\n237: \n238: export function emitDiagnostic(\n239:   record: HookDiagnosticInput,\n240:   writeDiagnostic: (line: string) => void = (line) => process.stderr.write(`${line}\\n`),\n241:   persistDiagnostic: typeof persistAdvisorHookDiagnosticRecord = persistAdvisorHookDiagnosticRecord,\n242: ): void {\n243:   try {\n244:     const diagnosticRecord = createAdvisorHookDiagnosticRecord({\n245:       runtime: 'claude',\n246:       ...record,\n247:     });\n248:     const line = serializeAdvisorHookDiagnosticRecord(diagnosticRecord);\n249:     writeDiagnostic(line);\n250:     const pendingWrite = persistDiagnostic(record.workspaceRoot, diagnosticRecord).catch(() => undefined);\n251:     pendingDiagnosticWrites.add(pendingWrite);\n252:     void pendingWrite.then(() => pendingDiagnosticWrites.delete(pendingWrite));\n253:   } catch {\n254:     // Diagnostics must never affect hook behavior.\n255:   }\n256: }\n257: \n258: export async function flushPendingDiagnostics(maxWaitMs = 100): Promise<void> {\n259:   let timeout: NodeJS.Timeout | undefined;\n260:   try {\n261:     if (pendingDiagnosticWrites.size === 0) return;\n262:     const pendingWrites = Promise.all([...pendingDiagnosticWrites]).then(() => undefined);\n263:     const timeoutElapsed = new Promise<void>((resolvePromise) => {\n264:       timeout = setTimeout(resolvePromise, maxWaitMs);\n265:       timeout.unref();\n266:     });\n267:     await Promise.race([pendingWrites, timeoutElapsed]);\n268:   } catch {\n269:     // Diagnostics must never affect hook behavior.\n270:   } finally {\n271:     if (timeout) clearTimeout(timeout);\n272:   }\n273: }\n274: \n275: export function parseClaudeUserPromptSubmitInput(raw: string): ClaudeUserPromptSubmitInput | null {\n276:   try {\n277:     const parsed = JSON.parse(raw) as unknown;\n278:     return isRecord(parsed) ? parsed : null;\n279:   } catch {\n280:     return null;\n281:   }\n282: }\n283: \n284: // ───────────────────────────────────────────────────────────────\n285: // 6. CORE LOGIC\n286: // ───────────────────────────────────────────────────────────────\n287: \n288: export async function handleClaudeUserPromptSubmit(\n289:   input: ClaudeUserPromptSubmitInput | null,\n290:   dependencies: UserPromptSubmitDependencies = {},\n291: ): Promise<ClaudeUserPromptSubmitOutput> {\n292:   const environmentRuntime = process.env.SPECKIT_RUNTIME;\n293:   const runtime = dependencies.runtime\n294:     ?? (isAdvisorRuntime(environmentRuntime) ? environmentRuntime : 'claude');\n295:   const startedAt = dependencies.now?.() ?? performance.now();\n296:   const elapsed = (): number => Number(((dependencies.now?.() ?? performance.now()) - startedAt).toFixed(3));\n297:   const writeDiagnostic = dependencies.writeDiagnostic;\n298: \n299:   try {\n300:     if (!skillAdvisorHookEnabled() || process.env.SPECKIT_SKILL_ADVISOR_HOOK_DISABLED === '1') {\n301:       emitDiagnostic({\n302:         runtime,\n303:         workspaceRoot: process.cwd(),\n304:         status: 'skipped',\n305:         freshness: 'unavailable',\n306:         durationMs: elapsed(),\n307:         cacheHit: false,\n308:       }, writeDiagnostic);\n309:       return {};\n310:     }\n311: \n312:     if (!input) {\n313:       emitDiagnostic({\n314:         runtime,\n315:         workspaceRoot: process.cwd(),\n316:         status: 'fail_open',\n317:         freshness: 'unavailable',\n318:         durationMs: elapsed(),\n319:         cacheHit: false,\n320:         errorCode: 'PARSE_FAIL',\n321:         errorDetails: 'Invalid UserPromptSubmit JSON payload',\n322:       }, writeDiagnostic);\n323:       return {};\n324:     }\n325: \n326:     const prompt = normalizePrompt(input.prompt);\n327:     const workspaceRoot = workspaceRootFor(input);\n328:     if (prompt === null) {\n329:       emitDiagnostic({\n330:         runtime,\n331:         workspaceRoot,\n332:         status: 'fail_open',\n333:         freshness: 'unavailable',\n334:         durationMs: elapsed(),\n335:         cacheHit: false,\n336:         errorCode: 'PARSE_FAIL',\n337:         errorDetails: 'Missing UserPromptSubmit prompt string',\n338:       }, writeDiagnostic);\n339:       return {};\n340:     }\n341: \n342:     const renderBrief = dependencies.renderBrief ?? renderAdvisorBrief;\n343:     // The CLI owns the warm-daemon probe and local-scorer fallback.\n344:     // The prompt-policy gate skips prompts that need no advisor before the\n345:     // CLI call; injected full producers stay ungated for producer-level tests.\n346:     const injectedBrief = dependencies.buildBrief;\n347:     const buildCliBrief = dependencies.buildCliBrief ?? buildSkillAdvisorBriefFromCli;\n348:     let result = injectedBrief\n349:       ? await injectedBrief(prompt, {\n350:         runtime,\n351:         workspaceRoot,\n352:         subprocessTimeoutMs: claudeHookTimeoutMs(),\n353:       })\n354:       : skippedAdvisorResultFor(prompt) ?? await buildCliBrief(prompt, {\n355:         runtime,\n356:         workspaceRoot,\n357:         timeoutMs: claudeHookTimeoutMs(),\n358:       }, {\n359:         now: dependencies.now,\n360:       });\n361: \n362:     result = {\n363:       ...result,\n364:       metrics: {\n365:         ...result.metrics,\n366:         durationMs: elapsed(),\n367:       },\n368:     };\n369:     const deliveryState = deliveryStateOptionsFor(input);\n370:     const brief = renderBrief(result, { deliveryState });\n371:     const renderOptions = { deliveryState, setupWording: !brief && SETUP_WORDING.test(prompt) };\n372:     const emitted = brief ?? renderAdvisorFallbackDirective(renderOptions, result);\n373:     // Directive-lifecycle dedup delivers the full brief on the first message\n374:     // and after lifecycle boundaries or transcript shrink. On proven repeats,\n375:     // it keeps the head and drops the constant directive block. A headed\n376:     // fallback reduces like a brief; unknown sessions, the kill switch, and\n377:     // thrown errors still get the full text.\n378:     let effectiveEmitted = emitted;\n379:     let commitFullReceipt: (() => boolean) | undefined;\n380:     try {\n381:       const sessionId = typeof input.session_id === 'string' && input.session_id.trim().length > 0\n382:         ? input.session_id\n383:         : undefined;\n384:       const sessionConfirmed = input.session_identity_confirmed\n385:         ?? (Boolean(sessionId) && input.session_identity_ambiguous !== true);\n386:       const transcriptPath = typeof input.transcript_path === 'string' && input.transcript_path.length > 0\n387:         ? input.transcript_path\n388:         : null;\n389:       let transcriptBytes: number | null = null;\n390:       if (transcriptPath) {\n391:         try {\n392:           transcriptBytes = statSync(transcriptPath).size;\n393:         } catch {\n394:           transcriptBytes = null;\n395:         }\n396:       }\n397:       const decision = decideDirectiveLifecycleDelivery(emitted, {\n398:         state: dependencies.directiveLifecycleStore ?? defaultDirectiveLifecycleStore(),\n399:         sessionId,\n400:         sessionConfirmed,\n401:         lifecycleEvent: lifecycleEventFor(input),\n402:         transcriptPath,\n403:         transcriptBytes,\n404:         enabled: isDirectiveLifecycleDedupEnabled(),\n405:         deferFullReceipt: dependencies.deferDirectiveReceipt === true,\n406:       });\n407:       commitFullReceipt = decision.commitFullReceipt;\n408:       if (decision.suppressed && decision.reducedContext) {\n409:         effectiveEmitted = decision.reducedContext;\n410:       }\n411:     } catch {\n412:       // Directive dedup is advisory; on any failure keep the full brief.\n413:       effectiveEmitted = emitted;\n414:     }\n415:     emitDiagnostic({\n416:       runtime,\n417:       workspaceRoot,\n418:       status: result.status,\n419:       freshness: result.freshness,\n420:       durationMs: result.metrics.durationMs,\n421:       cacheHit: result.metrics.cacheHit,\n422:       errorCode: result.diagnostics?.errorCode,\n423:       errorDetails: result.diagnostics?.errorMessage ?? result.diagnostics?.policyReason ?? result.diagnostics?.staleReason,\n424:       skillLabel: skillLabelFor(result),\n425:       emittedBytes: Buffer.byteLength(effectiveEmitted, 'utf8'),\n426:       directivesSuppressed: effectiveEmitted !== emitted,\n427:     }, writeDiagnostic);\n428: \n429:     const output: ClaudeUserPromptSubmitOutput = {\n430:       hookSpecificOutput: {\n431:         hookEventName: 'UserPromptSubmit',\n432:         additionalContext: effectiveEmitted,\n433:       },\n434:     };\n435:     if (commitFullReceipt) {\n436:       Object.defineProperty(output, DIRECTIVE_RECEIPT_COMMIT, {\n437:         configurable: true,\n438:         enumerable: false,\n439:         value: commitFullReceipt,\n440:       });\n441:     }\n442:     observeEmittedAdvisorPolicy(effectiveEmitted, {\n443:       ...deliveryState,\n444:       runtime: 'Claude Code',\n445:       candidate: OBSERVED_ADVISOR_POLICY_CANDIDATE,\n446:     });\n447:     return output;\n448:   } catch {\n449:     emitDiagnostic({\n450:       runtime,\n451:       workspaceRoot: input ? workspaceRootFor(input) : process.cwd(),\n452:       status: 'fail_open',\n453:       freshness: 'unavailable',\n454:       durationMs: elapsed(),\n455:       cacheHit: false,\n456:       errorCode: 'UNKNOWN',\n457:       errorDetails: 'Unhandled UserPromptSubmit hook exception',\n458:     }, writeDiagnostic);\n459:     return {};\n460:   }\n461: }\n462: \n463: // ───────────────────────────────────────────────────────────────\n464: // 7. OUTPUT DELIVERY\n465: // ───────────────────────────────────────────────────────────────\n466: \n467: async function readStdin(): Promise<string> {\n468:   const chunks: Buffer[] = [];\n469:   for await (const chunk of process.stdin) {\n470:     chunks.push(chunk as Buffer);\n471:   }\n472:   return Buffer.concat(chunks).toString('utf-8').trim();\n473: }\n474: \n475: export function commitClaudeDirectiveDeliveryReceipt(\n476:   output: ClaudeUserPromptSubmitOutput,\n477: ): boolean {\n478:   const record = output as ClaudeUserPromptSubmitOutput & {\n479:     [DIRECTIVE_RECEIPT_COMMIT]?: () => boolean;\n480:   };\n481:   const commit = record[DIRECTIVE_RECEIPT_COMMIT];\n482:   if (!commit) return true;\n483:   delete record[DIRECTIVE_RECEIPT_COMMIT];\n484:   return commit();\n485: }\n486: \n487: function writeHookOutput(output: ClaudeUserPromptSubmitOutput): Promise<void> {\n488:   return new Promise<void>((resolvePromise) => {\n489:     process.stdout.write(`${JSON.stringify(output)}\\n`, () => {\n490:       commitClaudeDirectiveDeliveryReceipt(output);\n491:       resolvePromise();\n492:     });\n493:   });\n494: }\n495: \n496: // ───────────────────────────────────────────────────────────────\n497: // 8. CLI ENTRY POINT\n498: // ───────────────────────────────────────────────────────────────\n499: \n500: async function main(): Promise<void> {\n501:   const rawInput = await readStdin();\n502:   const input = rawInput ? parseClaudeUserPromptSubmitInput(rawInput) : null;\n503:   const output = await handleClaudeUserPromptSubmit(input, {\n504:     writeDiagnostic: (line) => process.stderr.write(`${line}\\n`),\n505:     deferDirectiveReceipt: true,\n506:   });\n507:   await writeHookOutput(output);\n508: }\n509: \n510: if (IS_CLI_ENTRY) {\n511:   main().catch(async () => {\n512:     emitDiagnostic({\n513:       workspaceRoot: process.cwd(),\n514:       status: 'fail_open',\n515:       freshness: 'unavailable',\n516:       durationMs: 0,\n517:       cacheHit: false,\n518:       errorCode: 'UNKNOWN',\n519:       errorDetails: 'Unhandled UserPromptSubmit CLI exception',\n520:     });\n521:     await writeHookOutput({});\n522:   }).finally(async () => {\n523:     // The exit would otherwise drop diagnostic appends; the cap preserves the shim's kill margin.\n524:     await flushPendingDiagnostics();\n525:     process.exit(0);\n526:   });\n527: }"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/hooks/claude/user-prompt-submit.ts\"}"},"time":{"start":1794521936657,"end":1794521936820}}}}
