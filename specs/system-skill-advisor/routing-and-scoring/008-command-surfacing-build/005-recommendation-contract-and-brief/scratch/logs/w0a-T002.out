FromSnapshot(\n281:       snapshot,\n282:       generationNumber,\n283:       'absent',\n284:       'none',\n285:       nonLiveDiagnostics('SKILL_GRAPH_SQLITE_MISSING', [SQLITE_ARTIFACT_RELATIVE_PATH]),\n286:     );\n287:   }\n288: \n289:   if (generation.sourceSignature) {\n290:     return generation.sourceSignature === snapshot.sourceSignature\n291:       ? resultFromSnapshot(snapshot, generationNumber, 'live', 'sqlite', null)\n292:       : resultFromSnapshot(\n293:         snapshot,\n294:         generationNumber,\n295:         'stale',\n296:         'sqlite',\n297:         nonLiveDiagnostics('SOURCE_NEWER_THAN_SKILL_GRAPH'),\n298:       );\n299:   }\n300: \n301:   if (snapshot.maxSourceMtimeMs > snapshot.sqliteArtifact.mtimeMs) {\n302:     return resultFromSnapshot(\n303:       snapshot,\n304:       generationNumber,\n305:       'stale',\n306:       'sqlite',\n307:       nonLiveDiagnostics('SOURCE_NEWER_THAN_SKILL_GRAPH'),\n308:     );\n309:   }\n310: \n311:   return resultFromSnapshot(snapshot, generationNumber, 'live', 'sqlite', null);\n312: }\n313: \n314: function unavailableResult(\n315:   workspaceRoot: string,\n316:   reason: string,\n317:   recoveryPath?: AdvisorGenerationRecoveryPath,\n318:   errorDiagnostics?: AdvisorErrorDiagnostics,\n319: ): AdvisorFreshnessResult {\n320:   return {\n321:     state: 'unavailable',\n322:     generation: 0,\n323:     sourceSignature: createHash('sha256')\n324:       .update(resolve(workspaceRoot))\n325:       .update(reason)\n326:       .digest('hex'),\n327:     skillFingerprints: new Map(),\n328:     fallbackMode: 'none',\n329:     probedAt: new Date().toISOString(),\n330:     diagnostics: nonLiveDiagnostics(reason, [], recoveryPath, errorDiagnostics),\n[Output truncated. Continue reading with offset: 331]"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/l