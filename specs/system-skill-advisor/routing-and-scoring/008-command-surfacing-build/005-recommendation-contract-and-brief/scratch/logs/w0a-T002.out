  return recoverMalformedCounter(workspaceRoot, filePath);\n198:   }\n199: }\n200: \n201: /** Increment the advisor generation counter after source-affecting writes. */\n202: export function incrementAdvisorGeneration(workspaceRoot: string): AdvisorGenerationSnapshot {\n203:   const current = readAdvisorGeneration(workspaceRoot);\n204:   if (current.status === 'unavailable') {\n205:     return current;\n206:   }\n207:   const filePath = getAdvisorGenerationPath(workspaceRoot);\n208:   return setGeneration(workspaceRoot, filePath, current.generation + 1);\n209: }\n210: \n211: /** Clear process-local generation observations for tests. */\n212: export function clearAdvisorGenerationMemory(): void {\n213:   observedGenerations.clear();\n214: }","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/lib/generation.ts, lines 120-214\n120:     writeFileSync(tempPath, `${JSON.stringify(payload, null, 2)}\\n`, 'utf8');\n121:     renameSync(tempPath, filePath);\n122:   } catch (error: unknown) {\n123:     try {\n124:       rmSync(tempPath, { force: true });\n125:     } catch {\n126:       // Best-effort temp cleanup; the original write failure is authoritative.\n127:     }\n128:     throw error;\n129:   }\n130: }\n131: \n132: function parseGenerationFile(filePath: string): GenerationFilePayload {\n133:   const raw = readFileSync(filePath, 'utf8');\n134:   const payload: unknown = JSON.parse(raw);\n135:   if (!isGenerationFilePayload(payload)) {\n136:     throw new Error(\n137:       `Invalid generation counter payload at ${filePath}: expected {generation: safe integer >= 0, updatedAt: string}; actual ${typeof payload}.`,\n138:     );\n139:   }\n140:   return {\n141:     ...payload,\n142:     sourceSignature: payload.sourceSignature ?? null,\n143:   };\n144: }\n145: \n146: function recoverMalformedCounter(workspace