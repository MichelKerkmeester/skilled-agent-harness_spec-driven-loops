tifact ? 'sqlite' : snapshot.jsonArtifact ? 'json' : 'none',\n367:         nonLiveDiagnostics(\n368:           generation.reason ?? 'GENERATION_COUNTER_CORRUPT',\n369:           [],\n370:           generation.recoveryPath ?? undefined,\n371:           generation.errorClass\n372:             ? {\n373:               errorClass: generation.errorClass,\n374:               ...(generation.errorMessage ? { errorMessage: generation.errorMessage } : {}),\n375:             }\n376:             : undefined,\n377:         ),\n378:       ),\n379:     };\n380:   }\n381: \n382:   if (generation.status === 'recovered') {\n383:     return degradeRecoveredGeneration(deriveFreshness(snapshot, generation));\n384:   }\n385: \n386:   const cacheKey = `${resolve(workspaceRoot)}:${snapshot.sourceSignature}:${generation.generation}`;\n387:   return getOrCompute(\n388:     cacheKey,\n389:     ADVISOR_SOURCE_CACHE_TTL_MS,\n390:     () => deriveFreshness(snapshot, generation),\n391:   );\n392: }","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/lib/freshness.ts, lines 330-392\n330:     diagnostics: nonLiveDiagnostics(reason, [], recoveryPath, errorDiagnostics),\n331:   };\n332: }\n333: \n334: function degradeRecoveredGeneration(result: AdvisorFreshnessResult): AdvisorFreshnessResult {\n335:   return {\n336:     ...result,\n337:     state: result.state === 'live' ? 'stale' : result.state,\n338:     diagnostics: nonLiveDiagnostics('GENERATION_COUNTER_RECOVERED', [], 'regenerate'),\n339:   };\n340: }\n341: \n342: // ───────────────────────────────────────────────────────────────\n343: // 4. PUBLIC API\n344: // ───────────────────────────────────────────────────────────────\n345: \n346: export function getAdvisorFreshness(workspaceRoot: string): AdvisorFreshnessResult {\n347:   let snapshot: SourceSnapshot;\n348:   try {\n349:     snapshot = buildSourceSnapshot(workspaceRoot);\n350:   } catch (error: unknown) {\n351:     return unavailableResult(\n352:       workspaceRoot,\n353:       'ADVISOR_FRESHNESS_PROBE_FAILED',\n354:       undefined,\n355:       classifyAdvisorException(error),\n356:     );\n357:   }\n358: \n359:   const generation = readAdvisorGeneration(workspaceRoot);\n360:   if (generation.status === 'unavailable') {\n361:     return {\n362:       ...resultFromSnapshot(\n363:         snapshot,\n364:         0,\n365:         'unavailable',\n366:         snapshot.sqliteArtifact ? 'sqlite' : snapshot.jsonArtifact ? 'json' : 'none',\n367:         nonLiveDiagnostics(\n368:           generation.reason ?? 'GENERATION_COUNTER_CORRUPT',\n369:           [],\n370:           generation.recoveryPath ?? undefined,\n371:           generation.errorClass\n372:             ? {\n373:               errorClass: generation.errorClass,\n374:               ...(generation.errorMessage ? { errorMessage: generation.errorMessage } : {}),\n375:             }\n376:             : undefined,\n377:         ),\n378:       ),\n379:     };\n380:   }\n381: \n382:   if (generation.status === 'recovered') {\n383:     return degradeRecoveredGeneration(deriveFreshness(snapshot, generation));\n384:   }\n385: \n386:   const cacheKey = `${resolve(workspaceRoot)}:${snapshot.sourceSignature}:${generation.generation}`;\n387:   return getOrCompute(\n388:     cacheKey,\n389:     ADVISOR_SOURCE_CACHE_TTL_MS,\n390:     () => deriveFreshness(snapshot, generation),\n391:   );\n392: }"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/lib/freshness.ts\",\"offset\":330,\"limit\":130}"},"time":{"start":1794522078459,"end":1794522079008}}}}
