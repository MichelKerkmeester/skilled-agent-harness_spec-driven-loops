 suppress deleted or renamed skills. */\n38: export interface AdvisorSkillFingerprint {\n39:   readonly skillMdMtime: number;\n40:   readonly skillMdSize: number;\n41:   readonly skillMdHash: string;\n42:   readonly graphMetaMtime: number | null;\n43:   readonly graphMetaHash: string | null;\n44: }\n45: \n46: /** Machine-readable probe diagnostic for non-live advisor freshness states. */\n47: export interface AdvisorFreshnessDiagnostics {\n48:   readonly reason?: string;\n49:   readonly missingSources?: string[];\n50:   readonly recoveryPath?: AdvisorGenerationRecoveryPath;\n51:   readonly errorClass?: AdvisorErrorClass;\n52:   readonly errorMessage?: string;\n53: }\n54: \n55: /** Freshness snapshot consumed by downstream advisor brief producers. */\n56: export interface AdvisorFreshnessResult {\n57:   readonly state: AdvisorFreshnessState;\n58:   readonly generation: number;\n59:   readonly sourceSignature: string;\n60:   readonly skillFingerprints: Map<string, AdvisorSkillFingerprint>;\n61:   readonly fallbackMode: AdvisorFallbackMode;\n62:   readonly probedAt: string;\n63:   readonly diagnostics: AdvisorFreshnessDiagnostics | null;\n64: }\n65: \n66: interface FileProbe {\n67:   readonly path: string;\n68:   readonly mtimeMs: number;\n69:   readonly size: number;\n70:   readonly contentHash: string;\n71: }\n72: \n73: interface SourceSnapshot {\n74:   readonly sourceSignature: string;\n75:   readonly skillFingerprints: Map<string, AdvisorSkillFingerprint>;\n76:   readonly maxSourceMtimeMs: number;\n77:   readonly sqliteArtifact: FileProbe | null;\n78:   readonly jsonArtifact: FileProbe | null;\n79:   readonly missingSources: string[];\n80: }\n81: \n82: // ───────────────────────────────────────────────────────────────\n83: // 2. CONSTANTS\n84: // ───────────────────────────────────────────────────────────────\n85: \n86: const SKILL_ROOT_RELATIVE_PATH = join('.skilled', 'skills');\n87: const ADVISOR_SCRIPT_ROOT_RELATIVE_PATH = join(\n88:   SKILL_ROOT_RELATIVE_PATH,\n89:   'system-skill-advisor',\n90:   'runtime',\n91:   'scripts',\n92: );\n93: const SQLITE_ARTIFACT_RELATIVE_PATH = join(\n94:   SKILL_ROOT_RELATIVE_PATH,\n95:   'system-skill-advisor',\n96:   'runtime',\n97:   'database',\n98:   'skill-graph.sqlite',\n99: );\n100: const JSON_ARTIFACT_RELATIVE_PATH = join(\n101:   ADVISOR_SCRIPT_ROOT_RELATIVE_PATH,\n102:   'skill-graph.json',\n103: );\n104: const REQUIRED_SCRIPT_RELATIVE_PATHS = [\n105:   join(ADVISOR_SCRIPT_ROOT_RELATIVE_PATH, 'skill_advisor.py'),\n106:   join(ADVISOR_SCRIPT_ROOT_RELATIVE_PATH, 'skill_advisor_runtime.py'),\n107:   join(ADVISOR_SCRIPT_ROOT_RELATIVE_PATH, 'skill_graph_compiler.py'),\n108: ] as const;\n109: \n110: // ───────────────────────────────────────────────────────────────\n111: // 3. HELPERS\n112: // ───────────────────────────────────────────────────────────────\n113: \n114: function fileProbe(filePath: string): FileProbe | null {\n115:   if (!existsSync(filePath)) {\n116:     return null;\n117:   }\n118:   const stats = statSync(filePath);\n119:   if (!stats.isFile()) {\n120:     throw new Error(`Expected file but found non-file path: ${filePath}`);\n121:   }\n122:   const contentHash = createHash('sha256').update(readFileSync(filePath)).digest('hex');\n123:   return {\n124:     path: filePath,\n125:     mtimeMs: stats.mtimeMs,\n126:     size: stats.size,\n127:     contentHash,\n128:   };\n129: }\n130: \n131: function addSignaturePart(hash: ReturnType<typeof createHash>, label: string, probe: FileProbe | null): void {\n132:   if (!probe) {\n133:     hash.update(`${label}:missing\\n`);\n134:     return;\n135:   }\n136:   hash.update(`${label}:${probe.path}:${probe.mtimeMs}:${probe.size}:${probe.contentHash}\\n`);\n137: }\n138: \n139: function listSkillSlugs(skillRoot: string): string[] {\n140:   if (!existsSync(skillRoot)) {\n141:     return [];\n142:   }\n143:   const isTrustedLink = createPrivateSkillLinkCheck(skillRoot);\n144:   return readdirSync(skillRoot, { withFileTypes: true })\n145:     .filter(entry => !entry.name.startsWith('.') && (entry.isDirectory()\n146:       || (entry.name.startsWith('local-')\n147:         && entry.isSymbolicLink()\n148:         && isTrustedLink(join(skillRoot, entry.name)))))\n149:     .map(entry => entry.name)\n150:     .sort((left, right) => left.localeCompare(right));\n151: }\n152: \n153: function buildSourceSnapshot(workspaceRoot: string): SourceSnapshot {\n154:   const root = resolve(workspaceRoot);\n155:   const skillRoot = join(root, SKILL_ROOT_RELATIVE_PATH);\n156:   const missingSources: string[] = [];\n157:   const hash = createHash('sha256');\n158:   const skillFingerprints = new Map<string, AdvisorSkillFingerprint>();\n159:   let maxSourceMtimeMs = 0;\n160: \n161:   const skillSlugs = listSkillSlugs(skillRoot);\n162:   for (const skillSlug of skillSlugs) {\n163:     const skillDirectory = join(skillRoot, skillSlug);\n164:     const skillMd = fileProbe(join(skillDirectory, 'SKILL.md'));\n165:     if (!skillMd) {\n166:       continue;\n167:     }\n168:     const graphMetadata = fileProbe(join(skillDirectory, 'graph-metadata.json'));\n169:     const routerMd = fileProbe(join(skillDirectory, 'ROUTER.md'));\n170:     maxSourceMtimeMs = Math.max(\n171:       maxSourceMtimeMs,\n172:       skillMd.mtimeMs,\n173:       graphMetadata?.mtimeMs ?? 0,\n174:       routerMd?.mtimeMs ?? 0,\n175:     );\n176:     skillFingerprints.set(skillSlug, {\n177:       skillMdMtime: skillMd.mtimeMs,\n178:       skillMdSize: skillMd.size,\n179:       skillMdHash: skillMd.contentHash,\n180:       graphMetaMtime: graphMetadata?.mtimeMs ?? null,\n181:       graphMetaHash: graphMetadata?.contentHash ?? null,\n182:     });\n183:     addSignaturePart(hash, `skill:${skillSlug}:SKILL.md`, skillMd);\n184:     addSignaturePart(hash, `skill:${skillSlug}:graph-metadata.json`, graphMetadata);\n185:     // ROUTER.md is optional, so a skill without one keeps the signature it had\n186:     // before this probe existed; only a skill that carries the file adds a part.\n187:     if (routerMd) {\n188:       addSignaturePart(hash, `skill:${skillSlug}:ROUTER.md`, routerMd);\n189:     }\n190:   }\n191: \n192:   if (skillSlugs.length === 0 || skillFingerprints.size === 0) {\n193:     missingSources.push(SKILL_ROOT_RELATIVE_PATH);\n194:   }\n195: \n196:   for (const relativePath of REQUIRED_SCRIPT_RELATIVE_PATHS) {\n197:     const probe = fileProbe(join(root, relativePath));\n198:     if (!probe) {\n199:       missingSources.push(relativePath);\n200:     } else {\n201:       maxSourceMtimeMs = Math.max(maxSourceMtimeMs, probe.mtimeMs);\n202:     }\n203:     addSignaturePart(hash, relativePath, probe);\n204:   }\n205: \n206:   const sqliteArtifact = fileProbe(join(root, SQLITE_ARTIFACT_RELATIVE_PATH));\n207:   const jsonArtifact = fileProbe(join(root, JSON_ARTIFACT_RELATIVE_PATH));\n208:   addSignaturePart(hash, SQLITE_ARTIFACT_RELATIVE_PATH, sqliteArtifact);\n209:   addSignaturePart(hash, JSON_ARTIFACT_RELATIVE_PATH, jsonArtifact);\n210: \n211:   return {\n212:     sourceSignature: hash.digest('hex'),\n213:     skillFingerprints,\n214:     maxSourceMtimeMs,\n215:     sqliteArtifact,\n216:     jsonArtifact,\n217:     missingSources,\n218:   };\n219: }\n220: \n221: export function computeAdvisorSourceSignature(workspaceRoot: string): string {\n222:   return buildSourceSnapshot(workspaceRoot).sourceSignature;\n223: }\n224: \n225: function nonLiveDiagnostics(\n226:   reason: string,\n227:   missingSources: string[] = [],\n228:   recoveryPath?: AdvisorGenerationRecoveryPath,\n229:   errorDiagnostics?: AdvisorErrorDiagnostics,\n230: ): AdvisorFreshnessDiagnostics {\n231:   return {\n232:     reason,\n233:     ...(missingSources.length > 0 ? { missingSources } : {}),\n234:     ...(recoveryPath ? { recoveryPath } : {}),\n235:     ...(errorDiagnostics ?? {}),\n236:   };\n237: }\n238: \n239: function resultFromSnapshot(\n240:   snapshot: SourceSnapshot,\n241:   generation: number,\n242:   state: AdvisorFreshnessState,\n243:   fallbackMode: AdvisorFallbackMode,\n244:   diagnostics: AdvisorFreshnessDiagnostics | null,\n245: ): AdvisorFreshnessResult {\n246:   return {\n247:     state,\n248:     generation,\n249:     sourceSignature: snapshot.sourceSignature,\n250:     skillFingerprints: snapshot.skillFingerprints,\n251:     fallbackMode,\n252:     probedAt: new Date().toISOString(),\n253:     diagnostics,\n254:   };\n255: }\n256: \n257: function deriveFreshness(snapshot: SourceSnapshot, generation: AdvisorGenerationSnapshot): AdvisorFreshnessResult {\n258:   const generationNumber = generation.generation;\n259: \n260:   if (snapshot.missingSources.length > 0) {\n261:     return resultFromSnapshot(\n262:       snapshot,\n263:       generationNumber,\n264:       'absent',\n265:       snapshot.sqliteArtifact ? 'sqlite' : snapshot.jsonArtifact ? 'json' : 'none',\n266:       nonLiveDiagnostics('ADVISOR_SOURCE_MISSING', snapshot.missingSources),\n267:     );\n268:   }\n269: \n270:   if (!snapshot.sqliteArtifact) {\n271:     if (snapshot.jsonArtifact) {\n272:       return resultFromSnapshot(\n273:         snapshot,\n274:         generationNumber,\n275:         'stale',\n276:         'json',\n277:         nonLiveDiagnostics('JSON_FALLBACK_ONLY', [SQLITE_ARTIFACT_RELATIVE_PATH]),\n278:       );\n279:     }\n280:     return resultFromSnapshot(\n281:       snapshot,\n282:       generationNumber,\n283:       'absent',\n284:       'none',\n285:       nonLiveDiagnostics('SKILL_GRAPH_SQLITE_MISSING', [SQLITE_ARTIFACT_RELATIVE_PATH]),\n286:     );\n287:   }\n288: \n289:   if (generation.sourceSignature) {\n290:     return generation.sourceSignature === snapshot.sourceSignature\n291:       ? resultFromSnapshot(snapshot, generationNumber, 'live', 'sqlite', null)\n292:       : resultFromSnapshot(\n293:         snapshot,\n294:         generationNumber,\n295:         'stale',\n296:         'sqlite',\n297:         nonLiveDiagnostics('SOURCE_NEWER_THAN_SKILL_GRAPH'),\n298:       );\n299:   }\n300: \n301:   if (s