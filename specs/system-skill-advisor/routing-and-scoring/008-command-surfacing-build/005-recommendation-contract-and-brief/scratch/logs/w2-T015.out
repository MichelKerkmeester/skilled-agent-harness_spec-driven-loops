=  0\n\n--- CASE 2 head+tail ---\nFAIL sk-doc                       declared=257 wrong-hub=  0 outranked=257 no-reach=  0 allowed=  0 probe-error=  0 operator-local=  0\n       outranked  documentation quality                      command-doctor-git-hooks=0.8600, sk-doc=0.8200\n       outranked  doc quality                                command-doctor-git-hooks=0.8600, sk-doc=0.8200\nRESULT: FAILED\n--- CASE 2 kinds ---\n{\"outranked\":257}\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"--- CASE 1 head ---\nOK   sk-doc                       declared=257 wrong-hub=  0 outranked=  0 no-reach=  0 allowed=  0 probe-error=  0 operator-local=  0\n\n--- CASE 2 head+tail ---\nFAIL sk-doc                       declared=257 wrong-hub=  0 outranked=257 no-reach=  0 allowed=  0 probe-error=  0 operator-local=  0\n       outranked  documentation quality                      command-doctor-git-hooks=0.8600, sk-doc=0.8200\n       outranked  doc quality                                command-doctor-git-hooks=0.8600, sk-doc=0.8200\nRESULT: FAILED\n--- CASE 2 kinds ---\n{\"outranked\":257}\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"TMP=$(mktemp -d)\\ncat > \\\"$TMP/advisor.cjs\\\" <<'EOF'\\n'use strict';\\nconst fs = require('fs');\\nconst recommendations = JSON.parse(fs.readFileSync(process.env.REACH_TEST_SCENARIO, 'utf8'));\\nprocess.stdout.write(JSON.stringify({\\n  data: {\\n    trustState: { state: 'live', generation: 7 },\\n    effectiveThresholds: { confidenceThreshold: 0.8 },\\n    recommendations,\\n  },\\n}));\\nEOF\\nprintf '%s' '[{\\\"skillId\\\":\\\"create:agent\\\",\\\"confidence\\\":0.86,\\\"ownerSkillId\\\":\\\"sk-doc\\\"},{\\\"skillId\\\":\\\"sk-doc\\\",\\\"confidence\\\":0.84}]' > \\\"$TMP/s1.json\\\"\\nprintf '%s' '[{\\\"skillId\\\":\\\"command-doctor-git-hooks\\\",\\\"confidence\\\":0.86,\\\"ownerSkillId\\\":\\\"sk-git\\\"},{\\\"skillId\\\":\\\"sk-doc\\\",\\\"confidence\\\":0.82}]' > \\\"$TMP/s2.json\\\"\\necho \\\"--- CASE 1 head ---\\\"\\nROUTER_REACH_ADVISOR=\\\"$TMP/advisor.cjs\\\" REACH_TEST_SCENARIO=\\\"$TMP/s1.json\\\" node .skilled/skills/sk-doc/sk-create-skill/scripts/ci-router-vocabulary-reach.cjs --hub sk-doc | head -2\\necho \\\"--- CASE 2 head+tail ---\\\"\\nROUTER_REACH_ADVISOR=\\\"$TMP/advisor.cjs\\\" REACH_TEST_SCENARIO=\\\"$TMP/s2.json\\\" node .skilled/skills/sk-doc/sk-create-skill/scripts/ci-router-vocabulary-reach.cjs --hub sk-doc | sed -n '1,3p;$p'\\necho \\\"--- CASE 2 kinds ---\\\"\\nROUTER_REACH_ADVISOR=\\\"$TMP/advisor.cjs\\\" REACH_TEST_SCENARIO=\\\"$TMP/s2.json\\\" node .skilled/skills/sk-doc/sk-create-skill/scripts/ci-router-vocabulary-reach.cjs --hub sk-doc --json | jq -c '[.[].unreachable[].kind] | group_by(.) | map({(.[0]): length}) | add'\\nrm -rf \\\"$TMP\\\"\",\"timeout\":300000}"},"time":{"start":1794526940642,"end":1794526953677}}}}
