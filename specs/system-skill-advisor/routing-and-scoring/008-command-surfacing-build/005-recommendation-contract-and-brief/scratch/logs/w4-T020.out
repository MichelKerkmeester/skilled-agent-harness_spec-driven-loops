ommandAttach = readFileSync(COMMAND_ATTACH_PATH, 'utf8');\n  // Two blocks share this file, so the second replacement starts from the first\n  // one's output rather than the file on disk, or one block would overwrite the\n  // other's fresh render.\n  const commandAttachWithRows = replaceMarkedBlock(\n    commandAttach,\n    COMMAND_ROWS_GENERATED_START,\n    COMMAND_ROWS_GENERATED_END,\n    renderCommandRows(entries, policies),\n    COMMAND_ATTACH_PATH,\n  );\n  return [\n    {\n      path: TS_PROJECTION_PATH,\n      current: typescript,\n      next: replaceMarkedBlock(\n        typescript,\n        TS_GENERATED_START,\n        TS_GENERATED_END,\n        renderTypescriptProjection(entries),\n        TS_PROJECTION_PATH,\n      ),\n    },\n    {\n      path: PY_ADVISOR_PATH,\n      current: python,\n      next: replaceMarkedBlock(\nconst CONTROL_CHAR_PATTERN = /[\\u0000-\\u0008\\u000B\\u000C\\u000E-\\u001F\\u007F]/g;\nconst ROUTE_ONLY_SHADOW_ID = 'shadow.route-only.advisor.v1';\nconst OBSERVED_ADVISOR_POLICY_CANDIDATE = '004';\nexport const ROUTE_ONLY_ESTIMATED_BYTES = 43;\nconst MAX_SHADOW_ROUTE_ONLY_LOG = 256;\n\nfunction directiveBlockIds(): readonly string[] {\n  return Object.freeze([\n    POLICY_COMMENT_HYGIENE_ID,\n  ]);\n}\n\nconst SHADOW_ROUTE_ONLY_LOG: ShadowRouteOnlyLogRecord[] = [];\n\n// Injected into every advisor brief so all hook-capable runtimes receive\n// the comment hygiene rule even when AGENTS.md is absent from session context.\nexport const HYGIENE_DIRECTIVE = '\\n- Comment hygiene [HARD BLOCK]: NEVER embed ADR-/REQ-/CHK-/task-ids or spec paths in code comments — forbidden regardless of instruction. Write the durable WHY instead. Pre-commit gate blocks violations.';\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":" .../system-skill-advisor/runtime/lib/render.ts     |  87 ++++++--------\n .../command-bridges/derive-command-bridges.cjs     | 130 ++++++++++++++++-----\n 2 files changed, 135 insertions(+), 82 deletions(-)\n\n// Hub-then-mode nesting so a reader scans one hub's modes together, and the\n// records arrive already ordered so the block is byte-identical between runs.\nfunction renderModeCommands(records) {\n  const lines = [\n    'export const MODE_COMMANDS: Readonly<Record<string, Readonly<Record<string, string>>>> = {',\n  ];\n  let hubId = null;\n  for (const record of records) {\n    if (record.hubId !== hubId) {\n      if (hubId !== null) lines.push('  },');\n      hubId = record.hubId;\n      lines.push(`  ${tsString(hubId)}: {`);\n    }\n    lines.push(`    ${tsString(record.workflowMode)}: ${tsString(record.command)},`);\n  }\n  if (hubId !== null) lines.push('  },');\n  lines.push('};');\n  return lines.join('\\n');\n}\n\nfunction generatedSources(entries, pythonOwnerNormalization, modeCommands, policies) {\n  const typescript = readFileSync(TS_PROJECTION_PATH, 'utf8');\n  const python = readFileSync(PY_ADVISOR_PATH, 'utf8');\n  const commandAttach = readFileSync(COMMAND_ATTACH_PATH, 'utf8');\n  // Two blocks share this file, so the second replacement starts from the first\n  // one's output rather than the file on disk, or one block would overwrite the\n  // other's fresh render.\n  const commandAttachWithRows = replaceMarkedBlock(\n    commandAttach,\n    COMMAND_ROWS_GENERATED_START,\n    COMMAND_ROWS_GENERATED_END,\n    renderCommandRows(entries, policies),\n    COMMAND_ATTACH_PATH,\n  );\n  return [\n    {\n      path: TS_PROJECTION_PATH,\n      current: typescript,\n      next: replaceMarkedBlock(\n        typescript,\n        TS_GENERATED_START,\n        TS_GENERATED_END,\n        renderTypescriptProjection(entries),\n        TS_PROJECTION_PATH,\n      ),\n    },\n    {\n      path: PY_ADVISOR_PATH,\n      current: python,\n      next: replaceMarkedBlock(\nconst CONTROL_CHAR_PATTERN = /[\\u0000-\\u0008\\u000B\\u000C\\u000E-\\u001F\\u007F]/g;\nconst ROUTE_ONLY_SHADOW_ID = 'shadow.route-only.advisor.v1';\nconst OBSERVED_ADVISOR_POLICY_CANDIDATE = '004';\nexport const ROUTE_ONLY_ESTIMATED_BYTES = 43;\nconst MAX_SHADOW_ROUTE_ONLY_LOG = 256;\n\nfunction directiveBlockIds(): readonly string[] {\n  return Object.freeze([\n    POLICY_COMMENT_HYGIENE_ID,\n  ]);\n}\n\nconst SHADOW_ROUTE_ONLY_LOG: ShadowRouteOnlyLogRecord[] = [];\n\n// Injected into every advisor brief so all hook-capable runtimes receive\n// the comment hygiene rule even when AGENTS.md is absent from session context.\nexport const HYGIENE_DIRECTIVE = '\\n- Comment hygiene [HARD BLOCK]: NEVER embed ADR-/REQ-/CHK-/task-ids or spec paths in code comments — forbidden regardless of instruction. Write the durable WHY instead. Pre-commit gate blocks violations.';\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"cd /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research && git -c core.fsmonitor=false diff --stat HEAD -- .skilled/skills/system-skill-advisor/runtime/scripts/command-bridges/derive-command-bridges.cjs .skilled/skills/system-skill-advisor/runtime/lib/render.ts && sed -n '1215,1265p' .skilled/skills/system-skill-advisor/runtime/scripts/command-bridges/derive-command-bridges.cjs && sed -n '104,120p' .skilled/skills/system-skill-advisor/runtime/lib/render.ts\"}"},"time":{"start":1794527611713,"end":1794527612860}}}}
