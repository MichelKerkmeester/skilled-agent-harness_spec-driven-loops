ncludes('--check');\n1333:   const metadata = metadataEntries();\n1334:   const allowList = allowListEntries();\n1335:   const doctor = doctorRouteEntries();\n1336:   // The identity check compares command names against the declarations that make\n1337:   // a command real; an allow-list row only repeats an ownership id for a command\n1338:   // the tree and the metadata already name, so it adds nothing there.\n1339:   const tree = commandTreeNames();\n1340:   const metadataRisk = metadataRiskRecords();\n1341:   const doctorRisk = doctorRiskRecords();\n1342:   const modeCommands = modeCommandRecords();\n1343:   const violations = identityViolations({\n1344:     treeCommands: tree,\n1345:     metadataCommands: metadataRisk.map((record) => record.command),\n1346:     doctorCommands: doctorRisk.map((record) => record.command),\n1347:   });\n1348:   if (violations.length > 0) {\n1349:     throw new Error(`[command-bridges] command inventory mismatch:\\n${violations.join('\\n')}`);\n1350:   }\n1351:   // A command the allow-list already carries keeps that row's id: both scorers\n1352:   // know it, and a second id for one command would be a second bridge.\n1353:   const allowListCommands = new Set(allowList.map((entry) => entry.command));\n1354:   const bridgedMetadata = metadata.filter((entry) => !allowListCommands.has(entry.command));\n1355:   const inventory = [...bridgedMetadata, ...allowList, ...doctor]\n1356:     .sort((left, right) => left.id.localeCompare(right.id));\n1357:   assertUniqueIds(inventory);\n1358:   const compatibility = runtimeCompatibility(inventory, metadata);\n1359:   const entries = inventory.map((entry) => {\n1360:     const isDoctor = entry.id.startsWith(DOCTOR_PREFIX);\n1361:     const typescript = compatibility.typescript.get(entry.id);\n1362:     const python = compatibility.python.get(entry.id);\n1363:     // A command nothing describes has nothing written to embed, so the field\n1364:     // appears only where a source sentence exists for it.\n1365:     const meaning = typescript ? entryMeaning(entry.id, entry.command, isDoctor) : undefined;\n1366:     const runtime = { typescript: { enabled: false }, python: { enabled: false } };\n1367:     if (typescript) {\n1368:       runtime.typescript = {\n1369:         enabled: true,\n1370:         ...(isDoctor ? doctorRuntime(entry.id, 'typescript', typescript) : typescript),\n1371:       };\n1372:     }\n1373:     if (python) {\n1374:       runtime.python = {\n1375:         enabled: true,\n1376:         ...(isDoctor ? doctorRuntime(entry.id, 'python', python) : python),\n1377:       };\n1378:     }\n1379:     return {\n1380:       ...entry,\n1381:       ...(meaning ? { embeddingText: commandEmbeddingText(meaning) } : {}),\n1382:       runtime,\n1383:     };\n1384:   });\n1385: \n1386:   const policies = commandPolicies();\n1387:   const projection = {\n1388:     schemaVersion: 2,\n1389:     generatedBy: 'scripts/command-bridges/derive-command-bridges.cjs',\n1390:     counts: {\n1391:       commandMetadata: bridgedMetadata.length,\n1392:       allowList: allowList.length,\n1393:       doctorRoutes: doctor.length,\n1394:       generated: entries.length,\n1395:       typescriptActive: compatibility.typescript.size,\n1396:       pythonActive: compatibility.python.size,\n1397:     },\n1398:     entries,\n1399:     commandPolicies: policies,\n1400:   };\n1401:   const output = `${JSON.stringify(projection, null, 2)}\\n`;\n1402:   const sources = generatedSources(\n1403:     entries,\n1404:     compatibility.pythonOwnerNormalization,\n1405:     modeCommands,\n1406:     policies,\n1407:   );\n1408:   const changed = [\n1409:     ...(readFileSync(OUTPUT_PATH, 'utf8') === output ? [] : [OUTPUT_PATH]),\n1410:     ...sources.filter(({ current, next }) => current !== next).map(({ path }) => path),\n1411:   ];\n1412: \n1413:   if (!checkOnly) {\n1414:     writeFileSync(OUTPUT_PATH, output, 'utf8');\n1415:     for (const source of sources) {\n1416:       if (source.current !== source.next) {\n1417:         writeFileSync(source.path, source.next, 'utf8');\n1418:       }\n1419:     }\n1420:   }\n1421: \n1422:   console.log(JSON.stringify({\n1423:     status: changed.length === 0 ? 'fresh' : checkOnly ? 'stale' : 'generated',\n1424:     counts: projection.counts,\n1425:     changed: changed.map(sourcePath),\n1426:   }, null, 2));\n1427:   if (checkOnly && changed.length > 0) process.exitCode = 1;\n1428: }\n1429: \n1430: if (require.main === module) main();\n1431: \n1432: module.exports = {\n1433:   metadataEntries,\n1434:   commandTreeNames,\n1435:   modeCommandRecords,\n1436:   validateRiskKeys,\n1437:   derivePolicy,\n1438:   metadataRiskRecords,\n1439:   doctorRiskRecords,\n1440:   doctorLeadPhrases,\n1441:   identityViolations,\n1442:   commandPolicies,\n1443: };","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/scripts/command-bridges/derive-command-bridges.cjs, lines 1300-1443\n1300:         RENDER_PATH,\n1301:       ),\n1302:     },\n1303:     {\n1304:       path: COMMAND_ATTACH_PATH,\n1305:       current: commandAttach,\n1306:       next: replaceMarkedBlock(\n1307:         commandAttachWithRows,\n1308:         COMMAND_ATTACH_GENERATED_START,\n1309:         COMMAND_ATTACH_GENERATED_END,\n1310:         renderModeCommands(modeCommands),\n1311:         COMMAND_ATTACH_PATH,\n1312:       ),\n1313:     },\n1314:   ];\n1315: }\n1316: \n1317: // ───────────────────────────────────────────────────────────────────\n1318: // 4. CORE LOGIC\n1319: // ───────────────────────────────────────────────────────────────────\n1320: \n1321: function main() {\n1322:   // CLI-only rejection: requiring this module (for example from tests) must\n1323:   // not exit on arguments belonging to the host process.\n1324:   if (require.main === module) {\n1325:     const unknownArg = process.argv.slice(2).find((token) => token !== '--check');\n1326:     if (unknownArg !== undefined) {\n1327:       console.error(`derive-command-bridges.cjs: unknown option: ${unknownArg}`);\n1328:       console.error('usage: derive-command-bridges.cjs [--check]');\n1329:       process.exit(2);\n1330:     }\n1331:   }\n1332:   const checkOnly = process.argv.includes('--check');\n1333:   const metadata = metadataEntries();\n1334:   const allowList = allowListEntries();\n1335:   const doctor = doctorRouteEntries();\n1336:   // The identity check compares command names against the declarations that make\n1337:   // a command real; an allow-list row only repeats an ownership id for a command\n1338:   // the tree and the metadata already name, so it adds nothing there.\n1339:   const tree = commandTreeNames();\n1340:   const metadataRisk = metadataRiskRecords();\n1341:   const doctorRisk = doctorRiskRecords();\n1342:   const modeCommands = modeCommandRecords();\n1343:   const violations = identityViolations({\n1344:     treeCommands: tree,\n1345:     metadataCommands: metadataRisk.map((record) => record.command),\n1346:     doctorCommands: doctorRisk.map((record) => record.command),\n1347:   });\n1348:   if (violations.length > 0) {\n1349:     throw new Error(`[command-bridges] command inventory mismatch:\\n${violations.join('\\n')}`);\n1350:   }\n1351:   // A command the allow-list already carries keeps that row's id: both scorers\n1352:   // know it, and a second id for one command would be a second bridge.\n1353:   const allowListCommands = new Set(allowList.map((entry) => entry.command));\n1354:   const bridgedMetadata = metadata.filter((entry) => !allowListCommands.has(entry.command));\n1355:   const inventory = [...bridgedMetadata, ...allowList, ...doctor]\n1356:     .sort((left, right) => left.id.localeCompare(right.id));\n1357:   assertUniqueIds(inventory);\n1358:   const compatibility = runtimeCompatibility(inventory, metadata);\n1359:   const entries = inventory.map((entry) => {\n1360:     const isDoctor = entry.id.startsWith(DOCTOR_PREFIX);\n1361:     const typescript = compatibility.typescript.get(entry.id);\n1362:     const python = compatibility.python.get(entry.id);\n1363:     // A command nothing describes has nothing written to embed, so the field\n1364:     // appears only where a source sentence exists for it.\n1365:     const meaning = typescript ? entryMeaning(entry.id, entry.command, isDoctor) : undefined;\n1366:     const runtime = { typescript: { enabled: false }, python: { enabled: false } };\n1367:     if (typescript) {\n1368:       runtime.typescript = {\n1369:         enabled: true,\n1370:         ...(isDoctor ? doctorRuntime(entry.id, 'typescript', typescript) : typescript),\n1371:       };\n1372:     }\n1373:     if (python) {\n1374:       runtime.python = {\n1375:         enabled: true,\n1376:         ...(isDoctor ? doctorRuntime(entry.id, 'python', python) : python),\n1377:       };\n1378:     }\n1379:     return {\n1380:       ...entry,\n1381:       ...(meaning ? { embeddingText: commandEmbeddingText(meaning) } : {}),\n1382:       runtime,\n1383:     };\n1384:   });\n1385: \n1386:   const policies = commandPolicies();\n1387:   const projection = {\n1388:     schemaVersion: 2,\n1389:     generatedBy: 'scripts/command-bridges/derive-command-bridges.cjs',\n1390:     counts: {\n1391:       commandMetadata: bridgedMetadata.length,\n1392:       allowList: allowList.length,\n1393:       doctorRoutes: doctor.length,\n1394:       generated: entries.length,\n1395:       typescriptActive: compatibility.typescript.size,\n1396:       pythonActive: compatibility.python.size,\n1397:     },\n1398:     entries,\n1399:     commandPolicies: policies,\n1400:   };\n1401:   const output = `${JSON.stringify(projection, null, 2)}\\n`;\n1402:   const sources = generatedSources(\n1403:     entries,\n1404:     compatibility.pythonOwnerNormalization,\n1405:     modeCommands,\n1406:     policies,\n1407:   );\n1408:   const changed = [\n1409:     ...(readFileSync(OUTPUT_PATH, 'utf8') === output ? [] : [OUTPUT_PATH]),\n1410:     ...sources.filter(({ current, next }) => current !== next).map(({ path }) => path),\n1411:   ];\n1412: \n1413:   if (!checkOnly) {\n1414:     writeFileSync(OUTPUT_PATH, output, 'utf8');\n1415:     for (const source of sources) {\n1416:       if (source.current !== source.next) {\n1417:         writeFileSync(source.path, source.next, 'utf8');\n1418:       }\n1419:     }\n1420:   }\n1421: \n1422:   console.log(JSON.stringify({\n1423:     status: changed.length === 0 ? 'fresh' : checkOnly ? 'stale' : 'generated',\n1424:     counts: projection.counts,\n1425:     changed: changed.map(sourcePath),\n1426:   }, null, 2));\n1427:   if (checkOnly && changed.length > 0) process.exitCode = 1;\n1428: }\n1429: \n1430: if (require.main === module) main();\n1431: \n1432: module.exports = {\n1433:   metadataEntries,\n1434:   commandTreeNames,\n1435:   modeCommandRecords,\n1436:   validateRiskKeys,\n1437:   derivePolicy,\n1438:   metadataRiskRecords,\n1439:   doctorRiskRecords,\n1440:   doctorLeadPhrases,\n1441:   identityViolations,\n1442:   commandPolicies,\n1443: };"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"limit\":160,\"offset\":1300,\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/scripts/command-bridges/derive-command-bridges.cjs\"}"},"time":{"start":1794527535013,"end":1794527535256}}}}
