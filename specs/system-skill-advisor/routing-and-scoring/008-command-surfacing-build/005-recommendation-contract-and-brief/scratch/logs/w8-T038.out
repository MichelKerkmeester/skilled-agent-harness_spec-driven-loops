 a raw row id.\n1481: export function degradedRecommendations(\n1482:   entries: readonly AdvisorRecommendation[],\n1483:   prompt: string,\n1484: ): Array<Record<string, unknown>> {\n1485:   const offeredSkills = new Set<string>();\n1486:   const recommendations: Array<Record<string, unknown>> = [];\n1487: \n1488:   for (const entry of entries) {\n1489:     if (entry.passes_threshold !== true) continue;\n1490:     const base = {\n1491:       confidence: entry.confidence,\n1492:       uncertainty: entry.uncertainty,\n1493:       reason: entry.reason ?? '',\n1494:     };\n1495:     const row = commandRowFor(entry.skill);\n1496: \n1497:     if (row && prompt.includes(row.command.split(' ')[0])) {\n1498:       recommendations.push({\n1499:         skillId: entry.skill,\n1500:         kind: 'command',\n1501:         command: row.command,\n1502:         ...(row.policy ? { policy: row.policy } : {}),\n1503:         ownerSkillId: row.ownerSkillId,\n1504:         ...base,\n1505:       });\n1506:       offeredSkills.add(entry.skill);\n1507:       continue;\n1508:     }\n1509: \n1510:     if (row) {\n1511:       if (offeredSkills.has(row.ownerSkillId)) continue;\n1512:       recommendations.push({\n1513:         skillId: row.ownerSkillId,\n1514:         kind: 'skill',\n1515:         ...base,\n1516:       });\n1517:       offeredSkills.add(row.ownerSkillId);\n1518:       continue;\n1519:     }\n1520: \n1521:     recommendations.push({ skillId: entry.skill, ...base });\n1522:     offeredSkills.add(entry.skill);\n1523:   }\n1524: \n1525:   return recommendations;\n1526: }\n1527: \n1528: // Request options added after the daemon protocol was fixed, oldest first.\n1529: const COMPILED_ROUTE_OPTION_KEYS = ['includeCompiledRoute', 'compiledRouteTopOnly'] as const;\n1530: \n1531: async function invokeAdvisorRecommendPayload(\n1532:   args: Record<string, unknown>,\n1533:   timeoutMs: number,\n1534:   trusted: boolean,\n1535:   warmOnly: boolean,\n1536: ): Promise<ToolPayloadResult> {\n1537:   try {\n1538:     return await invokeToolPayload('advisor_recommend', args, timeoutMs, trusted, warmOnly);\n1539:   } catch (error: unknown) {\n1540:     let failure = error;\n1541:     const options = args.options;\n1542:     const rejected = error instanceof JsonRpcError && error.code === -32602 && isRecord(options)\n1543:       ? COMPILED_ROUTE_OPTION_KEYS.filter((key) => (\n1544:         error.message.includes(key) && Object.prototype.hasOwnProperty.call(options, key)\n[Output truncated. Continue reading with offset: 1545]","title":"read","metadata":{"metadata":{"truncated":true},"content":[{"type":"text","text":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/skill-advisor-cli.ts, lines 1455-1544\n1455: async function runLocalScorer(prompt: string): Promise<readonly AdvisorRecommendation[] | null> {\n1456:   const forceLocalEnv = SKILL_ADVISOR_COMPAT_CONTRACT.forceLocalEnv;\n1457:   const previous = process.env[forceLocalEnv];\n1458:   // Force-local for this spawn alone: the scorer would otherwise spend the fallback\n1459:   // budget retrying the daemon that just proved unreachable.\n1460:   process.env[forceLocalEnv] = '1';\n1461:   try {\n1462:     const result = await runAdvisorSubprocess(prompt, {\n1463:       workspaceRoot: findRepoPaths().repoRoot,\n1464:       timeoutMs: LOCAL_SCORER_TIMEOUT_MS,\n1465:       thresholdConfig: LOCAL_SCORER_THRESHOLDS,\n1466:     });\n1467:     return result.ok ? result.recommendations : null;\n1468:   } finally {\n1469:     if (previous === undefined) {\n1470:       delete process.env[forceLocalEnv];\n1471:     } else {\n1472:       process.env[forceLocalEnv] = previous;\n1473:     }\n1474:   }\n1475: }\n1476: \n1477: // The local scorer names command ids, but a reader can only act on a command they\n1478: // typed or on the skill that owns it. A row whose bare slash command appears in\n1479: // the prompt keeps its command fields, a