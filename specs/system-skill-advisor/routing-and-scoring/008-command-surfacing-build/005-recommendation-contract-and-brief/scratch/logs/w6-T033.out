   \"token\": \"the\"\n    },\n    {\n      \"reason\": \"beyond-max-query-tokens\",\n      \"token\": \"two\"\n    },\n    {\n      \"reason\": \"beyond-max-query-tokens\",\n      \"token\": \"old\"\n    },\n    {\n      \"reason\": \"beyond-max-query-tokens\",\n      \"token\": \"command\"\n    },\n    {\n      \"reason\": \"beyond-max-query-tokens\",\n      \"token\": \"ids\"\n    },\n    {\n      \"reason\": \"beyond-max-query-tokens\",\n      \"token\": \"with\"\n    },\n    {\n      \"reason\": \"beyond-max-query-tokens\",\n      \"token\": \"their\"\n    },\n    {\nEXIT:0\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"node .skilled/skills/system-spec-kit/runtime/cli/retrieval/lookup-trigger-index.mjs --json --scoring-only -- \\\"In runtime tests scorer same-owner-ambiguity.vitest.ts replace the two old command ids with their new ids\\\" 2>&1 | head -40; echo \\\"EXIT:$?\\\"\",\"workdir\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research\"}"},"time":{"start":1794528117988,"end":1794528119624}}}}
