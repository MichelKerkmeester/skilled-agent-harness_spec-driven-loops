{"type":"tool_use","timestamp":1794527764576,"sessionID":"ses_e2dd11478ffewTC2lNQ9TA6Xhv","part":{"partID":"prt_1d23090f8002x1mB4VxsQZLS92","sessionID":"ses_e2dd11478ffewTC2lNQ9TA6Xhv","messageID":"msg_1d23088d9001lSqkt0OBOfmTc6","type":"tool","id":"call_d9c997648db445a2b8c4b79e","tool":"write","state":{"status":"completed","input":{"path":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/tests/cli-degraded-command-contract.vitest.ts","content":"// ───────────────────────────────────────────────────────────────\n// MODULE: Degraded CLI command contract\n// ───────────────────────────────────────────────────────────────\n\n// The degraded path is the only one where a recommendation can still arrive as a\n// raw command row id. A reader can act on a command they typed and on the skill\n// that owns an untyped row, so these cases pin both shapes: the typed row keeps\n// its runnable string and policy, and the untyped row collapses to one owner\n// skill that names no command at all.\n//\n// The second case feeds the owner skill in ahead of the command row, because the\n// two would otherwise both survive as separate entries and the reader would see\n// the same skill twice with one offer they never asked for.\n\nimport { describe, expect, it } from 'vitest';\n\nimport { degradedRecommendations } from '../skill-advisor-cli.js';\n\n// A passing entry, so a case fails on the field it asserts rather than on the\n// threshold filter dropping the row before the contract is reached.\nfunction entry(skill: string): {\n  skill: string;\n  confidence: number;\n  uncertainty: number;\n  passes_threshold: boolean;\n} {\n  return { skill, confidence: 0.82, uncertainty: 0.16, passes_threshold: true };\n}\n\ndescribe('degradedRecommendations', () => {\n  it('keeps the command and the policy of a row the prompt typed', () => {\n    const result = degradedRecommendations([entry('command-speckit-save')], '/speckit:save this session');\n\n    expect(result).toHaveLength(1);\n    expect(result[0]).toMatchObject({\n      skillId: 'command-speckit-save',\n      kind: 'command',\n      command: '/speckit:save',\n      policy: 'start',\n      ownerSkillId: 'system-spec-kit',\n    });\n  });\n\n  it('collapses an untyped row to one owner skill that offers no command', () => {\n    const result = degradedRecommendations(\n      [entry('sk-doc'), entry('command-create-readme')],\n      'create a readme for the utils folder',\n    );\n\n    expect(result).toHaveLength(1);\n    expect(result[0]).toMatchObject({ skillId: 'sk-doc', kind: 'skill' });\n    expect(result[0]).not.toHaveProperty('command');\n  });\n});\n"},"output":"Created file successfully: .skilled/skills/system-skill-advisor/runtime/tests/cli-degraded-command-contract.vitest.ts","title":"write","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Created file successfully: .skilled/skills/system-skill-advisor/runtime/tests/cli-degraded-command-contract.vitest.ts"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/tests/cli-degraded-command-contract.vitest.ts\",\"content\":\"// ───────────────────────────────────────────────────────────────\\n// MODULE: Degraded CLI command contract\\n// ───────────────────────────────────────────────────────────────\\n\\n// The degraded path is the only one where a recommendation can still arrive as a\\n// raw command row id. A reader can act on a command they typed and on the skill\\n// that owns an untyped row, so these cases pin both shapes: the typed row keeps\\n// its runnable string and policy, and the untyped row collapses to one owner\\n// skill that names no command at all.\\n//\\n// The second case feeds the owner skill in ahead of the command row, because the\\n// two would otherwise both survive as separate entries and the reader would see\\n// the same skill twice with one offer they never asked for.\\n\\nimport { describe, expect, it } from 'vitest';\\n\\nimport { degradedRecommendations } from '../skill-advisor-cli.js';\\n\\n// A passing entry, so a case fails on the field it asserts rather than on the\\n// threshold filter dropping the row before the contract is reached.\\nfunction entry(skill: string): {\\n  skill: string;\\n  confidence: number;\\n  uncertainty: number;\\n  passes_threshold: boolean;\\n} {\\n  return { skill, confidence: 0.82, uncertainty: 0.16, passes_threshold: true };\\n}\\n\\ndescribe('degradedRecommendations', () => {\\n  it('keeps the command and the policy of a row the prompt typed', () => {\\n    const result = degradedRecommendations([entry('command-speckit-save')], '/speckit:save this session');\\n\\n    expect(result).toHaveLength(1);\\n    expect(result[0]).toMatchObject({\\n      skillId: 'command-speckit-save',\\n      kind: 'command',\\n      command: '/speckit:save',\\n      policy: 'start',\\n      ownerSkillId: 'system-spec-kit',\\n    });\\n  });\\n\\n  it('collapses an untyped row to one owner skill that offers no command', () => {\\n    const result = degradedRecommendations(\\n      [entry('sk-doc'), entry('command-create-readme')],\\n      'create a readme for the utils folder',\\n    );\\n\\n    expect(result).toHaveLength(1);\\n    expect(result[0]).toMatchObject({ skillId: 'sk-doc', kind: 'skill' });\\n    expect(result[0]).not.toHaveProperty('command');\\n  });\\n});\\n\"}"},"time":{"start":1794527760632,"end":1794527764576}}}}
