ll-graph-diagnostic-redaction.vitest.ts\nskill-graph-embedding-outage.vitest.ts\nskill-graph-handlers.vitest.ts\nskill-graph-queries-parity.vitest.ts\nsqlite-integrity.vitest.ts\nstate-containment.vitest.ts\nsystem-skill-advisor-plugin.vitest.ts\ntsconfig.tests.json\ntypo-flags.vitest.ts\nvocabulary-agreement.vitest.ts\nworkspace-root.vitest.ts\n---\n// ───────────────────────────────────────────────────────────────\n// MODULE: System Skill Advisor Vitest Config\n// ───────────────────────────────────────────────────────────────\n\nimport path from 'node:path';\n\nconst TEST_TIMEOUT_MS = 30_000;\nconst TEARDOWN_TIMEOUT_MS = 1_000;\nconst INCLUDE_BENCHES = process.env.SPECKIT_RUN_BENCHES === 'true';\n// The stress suites are excluded from the default run because they are slow, not\n// because they are unwanted. Without a way to opt in they were unreachable: no\n// script and no pattern selected them, so 21 files sat in the tree running never.\n// Opting in REPLACES the default set rather than adding to it: these suites churn\n// the daemon, its socket and its lease, and running them beside the ordinary\n// suites fails a handful of those on shared state rather than on their own logic.\nconst INCLUDE_STRESS = process.env.SPECKIT_RUN_STRESS === 'true';\n\n// A plain object export instead of vitest's defineConfig wrapper: the config is\n// loaded by node's own module graph, where a bare `vitest` import resolves to\n// whatever node_modules sits next to this file. CI's routing job runs the suites\n// under a vitest pinned through npx, which can differ from the runtime's own\n// vitest range, so importing from the package here could load a second vitest\n// copy. defineConfig is an identity type-helper; dropping it changes nothing at\n// runtime.\nexport default ({\n  root: import.meta.dirname,\n  test: {\n    include: [\n      ...(INCLUDE_STRESS ? ['stress-test/**/*.vitest.ts'] : ['tests/**/*.vitest.ts']),\n      ...(INCLUDE_BENCHES ? ['bench/**/*.bench.ts'] : []),\n    ],\n    exclude: [\n      'node_modules',\n      'dist',\n      ...(INCLUDE_BENCHES ? [] : ['bench/**/*.bench.ts']),\n    ],\n    setupFiles: [\n      path.resolve(import.meta.dirname, '../../system-spec-kit/runtime/tests/_support/vitest-setup.ts'),\n    ],\n    fileParallelism: false,\n    globals: true,\n    environment: 'node',\n    testTimeout: TEST_TIMEOUT_MS,\n    teardownTimeout: TEARDOWN_TIMEOUT_MS,\n    alias: {\n      '@lib': path.resolve(import.meta.dirname, 'lib'),\n    },\n  },\n});\n--- package scripts\n{\n  \"clean\": \"rm -rf dist\",\n  \"prebuild\": \"node ../../system-spec-kit/runtime/cli/lib/dist-freshness.cjs prepare-build --package system-skill-advisor/runtime --entry default && node ../../system-spec-kit/runtime/cli/lib/dist-freshness.cjs prepare-build --package system-skill-advisor/runtime --entry skill-advisor-cli\",\n  \"build\": \"npm --prefix ../../system-spec-kit/shared run build && ../../system-spec-kit/node_modules/.bin/tsc -p tsconfig.build.json\",\n  \"postbuild\": \"mkdir -p dist/runtime/data && cp data/*.json dist/runtime/data/ && (node ../../system-spec-kit/runtime/cli/lib/dist-freshness.cjs record-build --package system-skill-advisor/runtime --entry default || node -e \\\"const r=require('../../system-spec-kit/runtime/cli/lib/dist-freshness.cjs').writePackageSourceHashCache('system-skill-advisor/runtime',{entry:'default'});if(r.status!=='cached')throw new Error(r.message)\\\") && (node ../../system-spec-kit/runtime/cli/lib/dist-freshness.cjs record-build --package system-skill-advisor/runtime --entry skill-advisor-cli || node -e \\\"const r=require('../../system-spec-kit/runtime/cli/lib/dist-freshness.cjs').writePackageSourceHashCache('system-skill-advisor/runtime',{entry:'skill-advisor-cli'});if(r.status!=='cached')throw new Error(r.message)\\\")\",\n  \"typecheck\": \"../../system-spec-kit/node_modules/.bin/tsc --noEmit --composite false -p tsconfig.build.json\",\n  \"test\": \"vitest run\",\n  \"test:stress\": \"SPECKIT_RUN_STRESS=true vitest run\"\n}\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"ls .skilled/skills/system-skill-advisor/runtime/tests && echo \\\"---\\\" && cat .skilled/skills/system-skill-advisor/runtime/vitest.config.ts && echo \\\"--- package scripts\\\" && jq -r '.scripts' .skilled/skills/system-skill-advisor/runtime/package.json\"}"},"time":{"start":1794527723515,"end":1794527724179}}}}
