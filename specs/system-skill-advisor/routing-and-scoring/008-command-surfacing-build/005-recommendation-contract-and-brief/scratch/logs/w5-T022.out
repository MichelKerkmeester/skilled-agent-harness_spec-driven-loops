_PROTOCOL_VERSION = '1';\n30: const DEFAULT_TIMEOUT_MS = 30_000;\n31: const DEFAULT_SOCKET_DIR = '/tmp/system-skill-advisor';\n32: // A cold call starts the daemon and waits for it, but never past this. The measured\n33: // cold start is well inside it, and the stall this replaces came from waiting out the\n34: // tool timeout on a daemon that never accepted a connection — not from waiting at all.\n35: const COLD_START_WAIT_MS = 5_000;\n36: // The launcher's lease, which records when the running daemon was launched.\n37: const LAUNCHER_LEASE_FILE_NAME = '.system-skill-advisor-launcher.json';\n38: const ADVISOR_VALIDATE_MAX_ATTEMPTS = 3;\n39: const ADVISOR_VALIDATE_RETRY_BASE_DELAY_MS = 250;\n40: const RESERVED_COMMANDS = new Set(['list-tools', 'completion']);\n41: // The CLI's own last resort when no daemon answers: the checked-in Python scorer\n42: // still routes locally, so an unreachable daemon degrades a recommendation\n43: // instead of failing the call and leaving every caller to build this path again.\n44: const LOCAL_SCORER_TIMEOUT_MS = 5_000;\n45: const LOCAL_SCORER_SOURCE = 'local-scorer';\n46: // The same values are passed to the scorer and reported back, so the degraded\n47: // envelope cannot advertise a threshold the scorer did not apply.\n48: const LOCAL_SCORER_THRESHOLDS = {\n49:   confidenceThreshold: SKILL_ADVISOR_COMPAT_CONTRACT.defaults.confidenceThreshold,\n50:   uncertaintyThreshold: SKILL_ADVISOR_COMPAT_CONTRACT.defaults.uncertaintyThreshold,\n51:   confidenceOnly: false,\n52: } as const;\n53: \n54: const EXIT_SUCCESS = 0;\n55: const EXIT_RUNTIME = 1;\n56: const EXIT_USAGE = 64;\n57: const EXIT_PROTOCOL = 69;\n58: const EXIT_RETRYABLE = 75;\n59: \n60: // ───────────────────────────────────────────────────────────────────\n61: // 3. TYPE DEFINITIONS\n62: // ───────────────────────────────────────────────────────────────────\n63: type OutputFormat = 'json' | 'text' | 'jsonl';\n64: type ToolListMode = 'full' | 'compact' | 'names-only';\n65: type