{"type":"tool_use","timestamp":1794527728860,"sessionID":"ses_e2dd11478ffewTC2lNQ9TA6Xhv","part":{"partID":"prt_1d23010c2001cBfgisvnEtZCna","sessionID":"ses_e2dd11478ffewTC2lNQ9TA6Xhv","messageID":"msg_1d2300803001Sm5U1bxfjduV7t","type":"tool","id":"call_9720a0fa55254ddcaa08f301","tool":"read","state":{"status":"completed","input":{"path":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/tests/command-attach.vitest.ts"},"output":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/tests/command-attach.vitest.ts, lines 1-163\n1: // ───────────────────────────────────────────────────────────────\n2: // MODULE: Command attach for a hub recommendation\n3: // ───────────────────────────────────────────────────────────────\n4: \n5: // The advisor names the workflow mode a hub would route a prompt to, and\n6: // `attachCommand()` turns that mode into the slash command a reader can type.\n7: // The table it reads is generated from each hub's own command files, so these\n8: // tests assert the properties the generator has to keep — an own-key lookup on\n9: // both levels, and a real command file behind every row — rather than restating\n10: // today's rows, which would drift from the generator instead of catching it.\n11: //\n12: // The deep-loop gate is asserted on its own, because a command offered for a\n13: // prompt that never asked for that effort commits the reader to a long run they\n14: // did not request, and the prompt is the only thing that can tell the two apart.\n15: \n16: import { existsSync } from 'node:fs';\n17: import { join } from 'node:path';\n18: \n19: import { describe, expect, it } from 'vitest';\n20: \n21: import { attachCommand, DEPTH_WORDING, MODE_COMMANDS } from '../lib/command-attach.js';\n22: import { findAdvisorWorkspaceRoot } from '../lib/utils/workspace-root.js';\n23: import { AdvisorRecommendationSchema } from '../schemas/advisor-tool-schemas.js';\n24: \n25: type ModeCommands = Readonly<Record<string, Readonly<Record<string, string>>>>;\n26: \n27: const REPO_ROOT = findAdvisorWorkspaceRoot(import.meta.dirname);\n28: \n29: // A slash command spelling that also names the file behind it, so a generated row\n30: // can be checked against the command tree rather than against a second copy of\n31: // itself.\n32: const COMMAND_ID = /^\\/([a-z][a-z0-9-]*):([a-z0-9-]+)$/;\n33: \n34: // The only route shape that can name a command unambiguously: one decision, one\n35: // selected target, so the target's mode is the answer.\n36: function singleRoute(workflowMode: string, overrides: Record<string, unknown> = {}): Record<string, unknown> {\n37:   return { action: 'route', selectionKind: 'single', targets: [{ workflowMode }], ...overrides };\n38: }\n39: \n40: // Distinct from what the generated table holds for the same hub and mode, so a\n41: // passing assertion proves the injected table was read rather than the real one.\n42: const INJECTED_COMMAND = '/injected:readme';\n43: const INJECTED: ModeCommands = { 'sk-doc': { 'sk-create-readme': INJECTED_COMMAND } };\n44: const OTHER_HUB: ModeCommands = { 'made-up-hub': { 'made-up-mode': '/made-up:command' } };\n45: \n46: // Wording that names a topic without asking for effort: no phrase in the effort\n47: // vocabulary, and no typed slash command.\n48: const PLAIN_PROMPT = 'how does the routing table pick a skill';\n49: \n50: describe('command attach for a single routed mode', () => {\n51:   it('names the command the routed mode maps to', () => {\n52:     // Any generated hub except the gated one, read at test time so the case\n53:     // follows a regenerated table instead of pinning one of its rows.\n54:     const generated = Object.entries(MODE_COMMANDS).find(([hub]) => hub !== 'system-deep-loop');\n55:     expect(generated, 'the generated table names a hub outside the depth gate').toBeDefined();\n56:     const [hub, modes] = generated as [string, Readonly<Record<string, string>>];\n57:     const [mode, command] = Object.entries(modes)[0] as [string, string];\n58:     expect(command).toBeTypeOf('string');\n59: \n60:     expect(attachCommand(hub, singleRoute(mode), 'add a readme')).toBe(command);\n61: \n62:     expect(attachCommand('sk-doc', singleRoute('sk-create-readme'), 'anything', INJECTED)).toBe(INJECTED_COMMAND);\n63:     expect(attachCommand('made-up-hub', singleRoute('made-up-mode'), 'anything', OTHER_HUB)).toBe('/made-up:command');\n64:   });\n65: \n66:   it('offers no command unless the route names exactly one mode the table holds', () => {\n67:     const rows: Array<[string, string, unknown]> = [\n68:       ['a multi-selection route', 'sk-doc', {\n69:         action: 'route', selectionKind: 'multi', targets: [{ workflowMode: 'sk-create-readme' }],\n70:       }],\n71:       ['an ask decision', 'sk-doc', {\n72:         action: 'ask', selectionKind: 'single', targets: [{ workflowMode: 'sk-create-readme' }],\n73:       }],\n74:       ['a route with two targets', 'sk-doc', {\n75:         action: 'route',\n76:         selectionKind: 'single',\n77:         targets: [{ workflowMode: 'sk-create-readme' }, { workflowMode: 'sk-create-benchmark' }],\n78:       }],\n79:       ['a mode the table does not hold', 'sk-doc', singleRoute('sk-create-benchmark')],\n80:       ['a hub the table does not hold', 'sk-git', singleRoute('sk-create-readme')],\n81:       ['no route at all', 'sk-doc', null],\n82:       ['a route that is an array', 'sk-doc', [singleRoute('sk-create-readme')]],\n83:       // An inherited name such as `constructor` is never a command the hub\n84:       // declared, so the lookup must read own keys at both levels.\n85:       ['a mode named after an inherited key', 'sk-doc', singleRoute('constructor')],\n86:       ['a hub named after an inherited key', 'constructor', singleRoute('sk-create-readme')],\n87:     ];\n88: \n89:     for (const [label, skillId, compiledRoute] of rows) {\n90:       expect(attachCommand(skillId, compiledRoute, PLAIN_PROMPT, INJECTED), label).toBeUndefined();\n91:     }\n92:     expect(attachCommand('constructor', singleRoute('constructor'), PLAIN_PROMPT), 'both levels inherited').toBeUndefined();\n93:   });\n94: \n95:   it('offers a deep-loop command only when the prompt asks for that effort', () => {\n96:     const plainIsQuiet = DEPTH_WORDING.every((phrase) => !PLAIN_PROMPT.toLowerCase().includes(phrase));\n97:     expect(plainIsQuiet, 'the effort-free probe prompt mentions no effort wording').toBe(true);\n98: \n99:     const modes = Object.entries(MODE_COMMANDS['system-deep-loop']);\n100:     expect(modes.length).toBeGreaterThan(0);\n101:     const [effortPhrase] = DEPTH_WORDING;\n102:     expect(effortPhrase).toBeTruthy();\n103: \n104:     for (const [mode, command] of modes) {\n105:       const route = singleRoute(mode);\n106:       expect(attachCommand('system-deep-loop', route, PLAIN_PROMPT), mode).toBeUndefined();\n107:       expect(attachCommand('system-deep-loop', route, `explain the scorer ${effortPhrase}`), mode).toBe(command);\n108:       expect(attachCommand('system-deep-loop', route, `run ${command} for me`), mode).toBe(command);\n109:     }\n110: \n111:     // The gate belongs to the deep-loop hub alone: every other hub answers the\n112:     // same effort-free prompt with its command.\n113:     expect(attachCommand('sk-doc', singleRoute('sk-create-benchmark'), PLAIN_PROMPT, INJECTED)).toBeUndefined();\n114:     expect(attachCommand('sk-doc', singleRoute('sk-create-readme'), PLAIN_PROMPT, INJECTED)).toBe(INJECTED_COMMAND);\n115:   });\n116: \n117:   it('stays quiet when a prompt only names a deep-loop mode by its topic', () => {\n118:     const topicOnly: ReadonlyArray<readonly [string, string]> = [\n119:       ['ai-council', 'What does the AI council mode do?'],\n120:       ['research', 'what is research mode?'],\n121:       ['review', 'how does the review mode work?'],\n122:     ];\n123:     for (const [mode, prompt] of topicOnly) {\n124:       expect(MODE_COMMANDS['system-deep-loop'], mode).toHaveProperty(mode);\n125:       expect(attachCommand('system-deep-loop', singleRoute(mode), prompt), prompt).toBeUndefined();\n126:     }\n127:     expect(attachCommand('system-deep-loop', singleRoute('ai-council'), 'ask the council whether to split billing'))\n128:       .toBe(MODE_COMMANDS['system-deep-loop']['ai-council']);\n129:   });\n130: \n131:   it('names a real command file behind every generated row', () => {\n132:     const hubs = Object.keys(MODE_COMMANDS);\n133:     expect(hubs.length).toBeGreaterThan(0);\n134: \n135:     for (const hub of hubs) {\n136:       const modes = Object.entries(MODE_COMMANDS[hub]);\n137:       expect(modes.length, hub).toBeGreaterThan(0);\n138:       for (const [mode, command] of modes) {\n139:         const label = `${hub} ${mode}: ${command}`;\n140:         const match = command.match(COMMAND_ID);\n141:         expect(match, label).not.toBeNull();\n142:         const [, namespace, name] = match as RegExpMatchArray;\n143:         expect(existsSync(join(REPO_ROOT, '.skilled', 'commands', namespace, `${name}.md`)), label).toBe(true);\n144:       }\n145:     }\n146:   });\n147: \n148:   it('accepts a named command on a recommendation and refuses an empty one', () => {\n149:     // Only the schema's required keys, so the object proves the command field is\n150:     // the one under test rather than something an unrelated field satisfied.\n151:     const minimal = {\n152:       skillId: 'sk-create-readme',\n153:       score: 1,\n154:       confidence: 0.9,\n155:       uncertainty: 0.1,\n156:       dominantLane: null,\n157:     };\n158: \n159:     expect(AdvisorRecommendationSchema.safeParse(minimal).success).toBe(true);\n160:     expect(AdvisorRecommendationSchema.safeParse({ ...minimal, command: '/create:readme' }).success).toBe(true);\n161:     expect(AdvisorRecommendationSchema.safeParse({ ...minimal, command: '' }).success).toBe(false);\n162:   });\n163: });","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/tests/command-attach.vitest.ts, lines 1-163\n1: // ───────────────────────────────────────────────────────────────\n2: // MODULE: Command attach for a hub recommendation\n3: // ───────────────────────────────────────────────────────────────\n4: \n5: // The advisor names the workflow mode a hub would route a prompt to, and\n6: // `attachCommand()` turns that mode into the slash command a reader can type.\n7: // The table it reads is generated from each hub's own command files, so these\n8: // tests assert the properties the generator has to keep — an own-key lookup on\n9: // both levels, and a real command file behind every row — rather than restating\n10: // today's rows, which would drift from the generator instead of catching it.\n11: //\n12: // The deep-loop gate is asserted on its own, because a command offered for a\n13: // prompt that never asked for that effort commits the reader to a long run they\n14: // did not request, and the prompt is the only thing that can tell the two apart.\n15: \n16: import { existsSync } from 'node:fs';\n17: import { join } from 'node:path';\n18: \n19: import { describe, expect, it } from 'vitest';\n20: \n21: import { attachCommand, DEPTH_WORDING, MODE_COMMANDS } from '../lib/command-attach.js';\n22: import { findAdvisorWorkspaceRoot } from '../lib/utils/workspace-root.js';\n23: import { AdvisorRecommendationSchema } from '../schemas/advisor-tool-schemas.js';\n24: \n25: type ModeCommands = Readonly<Record<string, Readonly<Record<string, string>>>>;\n26: \n27: const REPO_ROOT = findAdvisorWorkspaceRoot(import.meta.dirname);\n28: \n29: // A slash command spelling that also names the file behind it, so a generated row\n30: // can be checked against the command tree rather than against a second copy of\n31: // itself.\n32: const COMMAND_ID = /^\\/([a-z][a-z0-9-]*):([a-z0-9-]+)$/;\n33: \n34: // The only route shape that can name a command unambiguously: one decision, one\n35: // selected target, so the target's mode is the answer.\n36: function singleRoute(workflowMode: string, overrides: Record<string, unknown> = {}): Record<string, unknown> {\n37:   return { action: 'route', selectionKind: 'single', targets: [{ workflowMode }], ...overrides };\n38: }\n39: \n40: // Distinct from what the generated table holds for the same hub and mode, so a\n41: // passing assertion proves the injected table was read rather than the real one.\n42: const INJECTED_COMMAND = '/injected:readme';\n43: const INJECTED: ModeCommands = { 'sk-doc': { 'sk-create-readme': INJECTED_COMMAND } };\n44: const OTHER_HUB: ModeCommands = { 'made-up-hub': { 'made-up-mode': '/made-up:command' } };\n45: \n46: // Wording that names a topic without asking for effort: no phrase in the effort\n47: // vocabulary, and no typed slash command.\n48: const PLAIN_PROMPT = 'how does the routing table pick a skill';\n49: \n50: describe('command attach for a single routed mode', () => {\n51:   it('names the command the routed mode maps to', () => {\n52:     // Any generated hub except the gated one, read at test time so the case\n53:     // follows a regenerated table instead of pinning one of its rows.\n54:     const generated = Object.entries(MODE_COMMANDS).find(([hub]) => hub !== 'system-deep-loop');\n55:     expect(generated, 'the generated table names a hub outside the depth gate').toBeDefined();\n56:     const [hub, modes] = generated as [string, Readonly<Record<string, string>>];\n57:     const [mode, command] = Object.entries(modes)[0] as [string, string];\n58:     expect(command).toBeTypeOf('string');\n59: \n60:     expect(attachCommand(hub, singleRoute(mode), 'add a readme')).toBe(command);\n61: \n62:     expect(attachCommand('sk-doc', singleRoute('sk-create-readme'), 'anything', INJECTED)).toBe(INJECTED_COMMAND);\n63:     expect(attachCommand('made-up-hub', singleRoute('made-up-mode'), 'anything', OTHER_HUB)).toBe('/made-up:command');\n64:   });\n65: \n66:   it('offers no command unless the route names exactly one mode the table holds', () => {\n67:     const rows: Array<[string, string, unknown]> = [\n68:       ['a multi-selection route', 'sk-doc', {\n69:         action: 'route', selectionKind: 'multi', targets: [{ workflowMode: 'sk-create-readme' }],\n70:       }],\n71:       ['an ask decision', 'sk-doc', {\n72:         action: 'ask', selectionKind: 'single', targets: [{ workflowMode: 'sk-create-readme' }],\n73:       }],\n74:       ['a route with two targets', 'sk-doc', {\n75:         action: 'route',\n76:         selectionKind: 'single',\n77:         targets: [{ workflowMode: 'sk-create-readme' }, { workflowMode: 'sk-create-benchmark' }],\n78:       }],\n79:       ['a mode the table does not hold', 'sk-doc', singleRoute('sk-create-benchmark')],\n80:       ['a hub the table does not hold', 'sk-git', singleRoute('sk-create-readme')],\n81:       ['no route at all', 'sk-doc', null],\n82:       ['a route that is an array', 'sk-doc', [singleRoute('sk-create-readme')]],\n83:       // An inherited name such as `constructor` is never a command the hub\n84:       // declared, so the lookup must read own keys at both levels.\n85:       ['a mode named after an inherited key', 'sk-doc', singleRoute('constructor')],\n86:       ['a hub named after an inherited key', 'constructor', singleRoute('sk-create-readme')],\n87:     ];\n88: \n89:     for (const [label, skillId, compiledRoute] of rows) {\n90:       expect(attachCommand(skillId, compiledRoute, PLAIN_PROMPT, INJECTED), label).toBeUndefined();\n91:     }\n92:     expect(attachCommand('constructor', singleRoute('constructor'), PLAIN_PROMPT), 'both levels inherited').toBeUndefined();\n93:   });\n94: \n95:   it('offers a deep-loop command only when the prompt asks for that effort', () => {\n96:     const plainIsQuiet = DEPTH_WORDING.every((phrase) => !PLAIN_PROMPT.toLowerCase().includes(phrase));\n97:     expect(plainIsQuiet, 'the effort-free probe prompt mentions no effort wording').toBe(true);\n98: \n99:     const modes = Object.entries(MODE_COMMANDS['system-deep-loop']);\n100:     expect(modes.length).toBeGreaterThan(0);\n101:     const [effortPhrase] = DEPTH_WORDING;\n102:     expect(effortPhrase).toBeTruthy();\n103: \n104:     for (const [mode, command] of modes) {\n105:       const route = singleRoute(mode);\n106:       expect(attachCommand('system-deep-loop', route, PLAIN_PROMPT), mode).toBeUndefined();\n107:       expect(attachCommand('system-deep-loop', route, `explain the scorer ${effortPhrase}`), mode).toBe(command);\n108:       expect(attachCommand('system-deep-loop', route, `run ${command} for me`), mode).toBe(command);\n109:     }\n110: \n111:     // The gate belongs to the deep-loop hub alone: every other hub answers the\n112:     // same effort-free prompt with its command.\n113:     expect(attachCommand('sk-doc', singleRoute('sk-create-benchmark'), PLAIN_PROMPT, INJECTED)).toBeUndefined();\n114:     expect(attachCommand('sk-doc', singleRoute('sk-create-readme'), PLAIN_PROMPT, INJECTED)).toBe(INJECTED_COMMAND);\n115:   });\n116: \n117:   it('stays quiet when a prompt only names a deep-loop mode by its topic', () => {\n118:     const topicOnly: ReadonlyArray<readonly [string, string]> = [\n119:       ['ai-council', 'What does the AI council mode do?'],\n120:       ['research', 'what is research mode?'],\n121:       ['review', 'how does the review mode work?'],\n122:     ];\n123:     for (const [mode, prompt] of topicOnly) {\n124:       expect(MODE_COMMANDS['system-deep-loop'], mode).toHaveProperty(mode);\n125:       expect(attachCommand('system-deep-loop', singleRoute(mode), prompt), prompt).toBeUndefined();\n126:     }\n127:     expect(attachCommand('system-deep-loop', singleRoute('ai-council'), 'ask the council whether to split billing'))\n128:       .toBe(MODE_COMMANDS['system-deep-loop']['ai-council']);\n129:   });\n130: \n131:   it('names a real command file behind every generated row', () => {\n132:     const hubs = Object.keys(MODE_COMMANDS);\n133:     expect(hubs.length).toBeGreaterThan(0);\n134: \n135:     for (const hub of hubs) {\n136:       const modes = Object.entries(MODE_COMMANDS[hub]);\n137:       expect(modes.length, hub).toBeGreaterThan(0);\n138:       for (const [mode, command] of modes) {\n139:         const label = `${hub} ${mode}: ${command}`;\n140:         const match = command.match(COMMAND_ID);\n141:         expect(match, label).not.toBeNull();\n142:         const [, namespace, name] = match as RegExpMatchArray;\n143:         expect(existsSync(join(REPO_ROOT, '.skilled', 'commands', namespace, `${name}.md`)), label).toBe(true);\n144:       }\n145:     }\n146:   });\n147: \n148:   it('accepts a named command on a recommendation and refuses an empty one', () => {\n149:     // Only the schema's required keys, so the object proves the command field is\n150:     // the one under test rather than something an unrelated field satisfied.\n151:     const minimal = {\n152:       skillId: 'sk-create-readme',\n153:       score: 1,\n154:       confidence: 0.9,\n155:       uncertainty: 0.1,\n156:       dominantLane: null,\n157:     };\n158: \n159:     expect(AdvisorRecommendationSchema.safeParse(minimal).success).toBe(true);\n160:     expect(AdvisorRecommendationSchema.safeParse({ ...minimal, command: '/create:readme' }).success).toBe(true);\n161:     expect(AdvisorRecommendationSchema.safeParse({ ...minimal, command: '' }).success).toBe(false);\n162:   });\n163: });"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/tests/command-attach.vitest.ts\"}"},"time":{"start":1794527727810,"end":1794527728860}}}}
{"type":"tool_use","timestamp":1794527728897,"sessionID":"ses_e2dd11478ffewTC2lNQ9TA6Xhv","part":{"partID":"prt_1d2301268001R0qzEnQo6COyfc","sessionID":"ses_e2dd11478ffewTC2lNQ9TA6Xhv","messageID":"msg_1d2300803001Sm5U1bxfjduV7t","type":"tool","id":"call_c4b2169ba95845c4b4f907dd","tool":"shell","state":{"status":"completed","input":{"command":"head -40 .skilled/skills/system-skill-advisor/runtime/tests/cli-exit-taxonomy.vitest.ts && echo \"=== hooks envelope\" && head -60 .skilled/skills/system-skill-advisor/runtime/tests/hooks/skill-advisor-cli-fallback-envelope.vitest.ts"},"output":"// -----------------------------------------------------------------------------\n// MODULE: Skill Advisor CLI Exit-Taxonomy Tests\n// -----------------------------------------------------------------------------\n// Proves the documented exit taxonomy end to end through the .skilled/bin shim:\n// each runnable case invokes the real front door and reads its numeric exit code\n// plus its JSON envelope. The two reserved codes are asserted at the constant,\n// because forcing a protocol mismatch or a daemon kill would disturb shared state.\n\nimport { afterEach, describe, expect, it } from 'vitest';\n\nimport { __testing } from '../skill-advisor-cli.js';\nimport {\n  cleanupSkillAdvisorScope,\n  createIsolatedCliScope,\n  parseJsonOutput,\n  runSkillAdvisorShim,\n  type CliRunResult,\n  type IsolatedCliScope,\n} from './skill-advisor-cli-test-utils.js';\n\ninterface Envelope {\n  readonly status?: string;\n}\n\nconst scopes: IsolatedCliScope[] = [];\n\nfunction makeScope(label: string): IsolatedCliScope {\n  const scope = createIsolatedCliScope(label);\n  scopes.push(scope);\n  return scope;\n}\n\nfunction parseStatusEnvelope(run: CliRunResult): Envelope {\n  const payload = parseJsonOutput<Envelope>(run);\n  expect(typeof payload.status).toBe('string');\n  return payload;\n}\n\nafterEach(async () => {\n  while (scopes.length > 0) {\n=== hooks envelope\n// ───────────────────────────────────────────────────────────────\n// MODULE: Skill Advisor CLI Fallback Envelope Tests\n// ───────────────────────────────────────────────────────────────\n\nimport { describe, expect, it } from 'vitest';\n\nimport { skillAdvisorCliFallbackEnvelope } from '../../../hooks/lib/skill-advisor-cli-fallback.js';\n\ndescribe('skill advisor CLI fallback envelope', () => {\n  it('normalizes advisor fallback outcomes to the shared warm-fallback shape', () => {\n    const skipped = skillAdvisorCliFallbackEnvelope({ status: 'skipped', reason: 'CLI_SOCKET_ABSENT', exitCode: 75 });\n    const failed = skillAdvisorCliFallbackEnvelope({ status: 'fail_open', reason: 'CLI_EXIT_1', exitCode: 1 });\n    const ok = skillAdvisorCliFallbackEnvelope({ status: 'ok', exitCode: 0 });\n\n    expect(skipped).toEqual({\n      status: 'skipped',\n      reason: 'socket_absent',\n      exitCode: 75,\n      retryable: true,\n    });\n    expect(failed).toEqual({\n      status: 'fail_open',\n      reason: 'exit_1',\n      exitCode: 1,\n      retryable: false,\n    });\n    expect(ok).toEqual({\n      status: 'ok',\n      reason: 'ok',\n      exitCode: 0,\n      retryable: false,\n    });\n  });\n});\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"// -----------------------------------------------------------------------------\n// MODULE: Skill Advisor CLI Exit-Taxonomy Tests\n// -----------------------------------------------------------------------------\n// Proves the documented exit taxonomy end to end through the .skilled/bin shim:\n// each runnable case invokes the real front door and reads its numeric exit code\n// plus its JSON envelope. The two reserved codes are asserted at the constant,\n// because forcing a protocol mismatch or a daemon kill would disturb shared state.\n\nimport { afterEach, describe, expect, it } from 'vitest';\n\nimport { __testing } from '../skill-advisor-cli.js';\nimport {\n  cleanupSkillAdvisorScope,\n  createIsolatedCliScope,\n  parseJsonOutput,\n  runSkillAdvisorShim,\n  type CliRunResult,\n  type IsolatedCliScope,\n} from './skill-advisor-cli-test-utils.js';\n\ninterface Envelope {\n  readonly status?: string;\n}\n\nconst scopes: IsolatedCliScope[] = [];\n\nfunction makeScope(label: string): IsolatedCliScope {\n  const scope = createIsolatedCliScope(label);\n  scopes.push(scope);\n  return scope;\n}\n\nfunction parseStatusEnvelope(run: CliRunResult): Envelope {\n  const payload = parseJsonOutput<Envelope>(run);\n  expect(typeof payload.status).toBe('string');\n  return payload;\n}\n\nafterEach(async () => {\n  while (scopes.length > 0) {\n=== hooks envelope\n// ───────────────────────────────────────────────────────────────\n// MODULE: Skill Advisor CLI Fallback Envelope Tests\n// ───────────────────────────────────────────────────────────────\n\nimport { describe, expect, it } from 'vitest';\n\nimport { skillAdvisorCliFallbackEnvelope } from '../../../hooks/lib/skill-advisor-cli-fallback.js';\n\ndescribe('skill advisor CLI fallback envelope', () => {\n  it('normalizes advisor fallback outcomes to the shared warm-fallback shape', () => {\n    const skipped = skillAdvisorCliFallbackEnvelope({ status: 'skipped', reason: 'CLI_SOCKET_ABSENT', exitCode: 75 });\n    const failed = skillAdvisorCliFallbackEnvelope({ status: 'fail_open', reason: 'CLI_EXIT_1', exitCode: 1 });\n    const ok = skillAdvisorCliFallbackEnvelope({ status: 'ok', exitCode: 0 });\n\n    expect(skipped).toEqual({\n      status: 'skipped',\n      reason: 'socket_absent',\n      exitCode: 75,\n      retryable: true,\n    });\n    expect(failed).toEqual({\n      status: 'fail_open',\n      reason: 'exit_1',\n      exitCode: 1,\n      retryable: false,\n    });\n    expect(ok).toEqual({\n      status: 'ok',\n      reason: 'ok',\n      exitCode: 0,\n      retryable: false,\n    });\n  });\n});\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"head -40 .skilled/skills/system-skill-advisor/runtime/tests/cli-exit-taxonomy.vitest.ts && echo \\\"=== hooks envelope\\\" && head -60 .skilled/skills/system-skill-advisor/runtime/tests/hooks/skill-advisor-cli-fallback-envelope.vitest.ts\"}"},"time":{"start":1794527728232,"end":1794527728897}}}}
