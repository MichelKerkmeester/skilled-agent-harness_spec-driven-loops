 getpath($p) as $v | select($v|test(\\\"^command-spec-kit-(plan|complete|implement|resume)$\\\")) | ($p|map(tostring)|join(\\\".\\\"))] | .[]' \\\"$F\\\"\"}"},"time":{"start":1794528533072,"end":1794528534710}}}}
