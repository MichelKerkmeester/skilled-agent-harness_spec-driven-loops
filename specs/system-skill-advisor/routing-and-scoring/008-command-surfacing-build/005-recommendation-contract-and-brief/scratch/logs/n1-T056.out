 if (!disabled.has('explicit_author')) {\n524:     scores.explicit_author = scoreExplicitLane(prompt, projection);\n525:   }\n526:   if (!disabled.has('lexical')) scores.lexical = scoreLexicalLane(prompt, projection);\n527:   if (!disabled.has('derived_generated')) scores.derived_generated = scoreDerivedLane(prompt, projection, new Date(), affordances);\n528:   if (!disabled.has('semantic_shadow')) scores.semantic_shadow = scoreSemanticShadowLane(prompt, projection);\n529:   let graphConflictMatches: readonly LaneMatch[] = [];\n530:   let graphSupportBySeed: ReadonlyMap<string, ReadonlyMap<string, number>> = new Map();\n531:   if (!disabled.has('graph_causal')) {\n532:     const graphSplit = scoreGraphCausalLaneSplit([\n533:       ...scores.explicit_author,\n534:       ...scores.lexical,\n535:       ...scores.derived_generated,\n536:     ], projection, {}, affordances);\n537:     scores.graph_causal = useRrfFusion ? graphSplit.positiveMatches : graphSplit.combinedMatches;\n538:     graphConflictMatches = graphSplit.conflictMatches;\n539:     graphSupportBySeed = graphSplit.positiveSupportBySeed;\n540:   }\n541:   return { laneScores: scores, graphConflictMatches, graphSupportBySeed };\n542: }\n543: \n544: // Smallest gap the rounded weighted score can still express, so a bounded\n545: // target sorts strictly below its seed instead of tying with it.\n546: const SEED_BOUND_GAP = 0.000001;\n547: \n548: // Below this explicit-lane score a match is a side mention, not a request.\n549: const EXPLICIT_WORKFLOW_SIGNAL_FLOOR = 0.55;\n550: \n551: // Explicit-lane evidence that a typed slash command named this skill.\n552: const SLASH_COMMAND_EVIDENCE = /^(phrase|author|explicit):\\//;\n553: \n554: export function hasSlashCommandAnchor(rawScore: number, evidence: readonly string[]): boolean {\n555:   return rawScore >= EXPLICIT_WORKFLOW_SIGNAL_FLOOR\n556:     && evidence.some((entry) => SLASH_COMMAND_EVIDENCE.test(entry));\n557: }\n558: \n[Output truncated. Continue reading w