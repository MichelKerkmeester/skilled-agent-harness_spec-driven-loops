p((skill) => [skill.id, skill]));\n1486:   ranked = requireCommandPhraseAnchor(\n1487:     ranked,\n1488:     options.confidenceThreshold ?? DEFAULT_CONFIDENCE_THRESHOLD,\n1489:     commandMeaningPassed,\n1490:     (skillId) => commandMeaningEligible(promptLower, readOnlyExplainer, projectionSkillById.get(skillId)),\n1491:   );\n1492:   const leadPhrasesById = new Map<string, readonly string[]>();\n1493:   for (const skill of projection.skills) {\n1494:     if (!skill.id.startsWith(DOCTOR_BRIDGE_PREFIX) || !skill.leadPhrases?.length) continue;\n1495:     leadPhrasesById.set(skill.id, skill.leadPhrases);\n1496:   }\n1497:   ranked = keepPassingSkillsAboveDoctorBridges(ranked, promptLower, leadPhrasesById);\n1498:   ranked = rankMeaningPassedCommandFirst(ranked, commandMeaningPassed);\n1499:   ranked = applyDoctorHelperHandoff(ranked, {\n1500:     prompt,\n1501:     promptLower,\n1502:     projection,\n1503:     workspaceRoot: options.workspaceRoot,\n1504:     confidenceThreshold: options.confidenceThreshold ?? DEFAULT_CONFIDENCE_THRESHOLD,\n1505:     uncertaintyThreshold: options.uncertaintyThreshold ?? DEFAULT_UNCERTAINTY_THRESHOLD,\n1506:     leadPhrasesById,\n1507:   });\n1508: \n1509:   const passing = ranked.filter((recommendation) => recommendation.passes_threshold);\n1510:   const visible = options.includeAllCandidates ? ranked : passing;\n1511:   const top = passing[0] ?? null;\n1512:   const laneHealthReason = degradedLaneReason(degradedLanes);\n1513:   const abstainReasons = laneHealthReason ? [laneHealthReason] : [];\n1514:   if (isSpeckitMetricsEnabled() && top) {\n1515:     const runtimeLabel = normalizeRuntimeLabel(process.env.SPECKIT_RUNTIME);\n1516:     const freshnessLabel = normalizeFreshnessLabel(process.env.SPECKIT_ADVISOR_FRESHNESS);\n1517:     if (runtimeLabel && freshnessLabel) {\n1518:       speckitMetrics.incrementCounter('spec_kit.advisor.recommendation_emitted_total', { runtime: runtimeLabel, freshness_state: freshnessLabel });\n1519:     }\n1520:     speckitMetrics.recordConfidenceBracket(top.confidence);\n1521:   }\n1522:   return {\n1523:     recommendations: visible,\n1524:     topSkill: top?.skill ?? null,\n1525:     unknown: !top,\n1526:     ambiguous: isAmbiguousTopTwo(ranked),\n1527:     metrics: {\n1528:       candidateCount: ranked.length,\n1529:       liveLaneCount: runtimeLiveLaneCount,\n1530:       ...(degradedLanes.length > 0 ? { degradedLanes, laneHealth } : {}),\n1531:     },\n1532:     ...(abstainReasons.length > 0 ? { abstainReasons } : {}),\n1533:   };\n1534: }"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"limit\":340,\"offset\":1200,\"path\":\".skilled/skills/system-skill-advisor/runtime/lib/scorer/fusion.ts\"}"},"time":{"start":1794529486289,"end":1794529486723}}}}
