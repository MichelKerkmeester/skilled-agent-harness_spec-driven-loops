et.path));\n517:     }\n518:     if (removals.length > 0) {\n519:       const removedPaths = removals.map((target) => target.path);\n520:       watcher.unwatch?.(removedPaths);\n521:       // Prune cached file hashes so a future re-add does not skip the first\n522:       // reindex on a stale \"unchanged\" comparison.\n523:       for (const removedPath of removedPaths) {\n524:         fileHashes.delete(removedPath);\n525:       }\n526:       // Also drop pending reindex requests whose owning skill no\n527:       // longer has any watched paths, so the queue cannot retain phantom work\n528:       // for skills that have been deleted on disk.\n529:       const livingSlugs = new Set(refreshed.map((target) => target.skillSlug));\n530:       for (const slug of [...pending.keys()]) {\n531:         if (!livingSlugs.has(slug)) {\n532:           pending.delete(slug);\n533:         }\n534:       }\n535:     }\n536:   }\n537: \n538:   function trackStorm(): void {\n539:     const currentTime = now();\n540:     eventTimes.push(currentTime);\n541:     while (eventTimes.length > 0 && currentTime - eventTimes[0] > stormWindowMs) {\n542:       eventTimes.shift();\n543:     }\n544:     if (eventTimes.length > stormEventLimit) {\n545:       circuitOpenUntil = currentTime + circuitCooldownMs;\n546:       // Route through pushDiagnostic so the entry counts toward\n547:       // the REINDEX_STORM_CIRCUIT_OPEN aggregate even after the ring buffer\n548:       // rolls over.\n549:       pushDiagnostic(`REINDEX_STORM_CIRCUIT_OPEN:${eventTimes.length}`);\n[Output truncated. Continue reading with offset: 550]","title":"read","metadata":{"metadata":{"truncated":true},"content":[{"type":"text","text":"Read file .skilled/skills/system-skill-advisor/runtime/lib/daemon/watcher.ts, lines 430-549\n430:     }\n431:     const colonIndex = entry.indexOf(':');\n432:     const key = colonIndex > 0 ? entry.slice(0, colonIndex) : entry;\n433:     diagnosticCounts.set(key, (diagnosticCounts.get(key) ?? 0) +