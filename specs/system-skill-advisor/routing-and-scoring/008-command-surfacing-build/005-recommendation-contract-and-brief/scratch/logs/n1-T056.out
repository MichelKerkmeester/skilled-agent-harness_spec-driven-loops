      if (useRrfFusion && graphConflictAdjustment(graphConflictIndex, recommendation) !== 0) {\n1304:         speckitMetrics.incrementCounter('spec_kit.scorer.graph_conflict_demote_applied_total', { skill_id: recommendation.skill });\n1305:       }\n1306:     }\n1307:   }\n1308:   const exactSemanticRerankIndex = useExactSemanticRerank\n1309:     ? buildExactSemanticRerankIndex(prompt, projection, recommendations, rrfFusion)\n1310:     : new Map<string, ExactSemanticRerankEntry>();\n1311:   let ranked = recommendations.sort((left, right) => {\n1312:     const leftCommandBonus = left.kind === 'command' && !promptLower.includes('/') ? -0.08 : 0;\n1313:     const rightCommandBonus = right.kind === 'command' && !promptLower.includes('/') ? -0.08 : 0;\n1314:     const leftIntent = primaryIntentBonus(promptLower, left);\n1315:     const rightIntent = primaryIntentBonus(promptLower, right);\n1316:     const leftConflict = useRrfFusion ? graphConflictAdjustment(graphConflictIndex, left) : 0;\n1317:     const rightConflict = useRrfFusion ? graphConflictAdjustment(graphConflictIndex, right) : 0;\n1318:     const adjustedScoreDiff = (right.score + rightCommandBonus + rightIntent + rightConflict)\n1319:       - (left.score + leftCommandBonus + leftIntent + leftConflict);\n1320:     if (useRrfFusion) {\n1321:       const leftExactSemantic = exactSemanticRerankScore(exactSemanticRerankIndex, left);\n1322:       const rightExactSemantic = exactSemanticRerankScore(exactSemanticRerankIndex, right);\n1323:       if (leftExactSemantic !== null\n1324:         && rightExactSemantic !== null\n1325:         && Math.abs(adjustedScoreDiff) <= ADVISOR_EXACT_SEMANTIC_RERANK_WINDOW) {\n1326:         const exactSemanticDiff = rightExactSemantic - leftExactSemantic;\n1327:         if (exactSemanticDiff !== 0) {\n1328:           return exactSemanticDiff;\n1329:         }\n1330:       }\n1331:       return adjustedScoreDiff\n1332:         || rrfRankFor(rrfFusion, left) - rrfRankFor(rrfFusion, right)\n1333:         || left.skill.localeCompare(right.skill);\n1334:     }\n1335:     return adjustedScoreDiff\n1336:       || right.confidence - left.confidence\n1337:       || left.skill.localeCompare(right.skill);\n1338:   });\n1339: \n1340:   // Doctor bridges must not shape skill ambiguity or abstention.\n1341:   // Skill slots take their values from the pass with those bridges removed.\n1342:   const finishRanked = (\n1343:     sorted: readonly AdvisorScoredRecommendation[],\n1344:   ): AdvisorScoredRecommendation[] => {\n1345:     let finished = sorted.map((recommendation, index) => {\n1346:       const next = sorted[index + 1];\n1347:       const ambiguityPressure = next\n1348:         && Math.abs(recommendation.confidence - next.confidence) <= 0.05\n1349:         ? 0.04\n1350:         : 0;\n1351:       const uncertainty = uncertaintyFor(\n1352:         recommendation.laneContributions,\n1353:         recommendation.confidence,\n1354:         ambiguityPressure,\n1355:       );\n1356:       return {\n1357:         ...recommendation,\n1358:         uncertainty,\n1359:         passes_threshold: recommendation.confidence\n1360:           >= (options.confidenceThreshold ?? DEFAULT_CONFIDENCE_THRESHOLD)\n1361:           && uncertainty <= (options.uncertaintyThreshold ?? DEFAULT_UNCERTAINTY_THRESHOLD),\n1362:       };\n1363:     });\n1364:     finished = applyAmbiguity(finished);\n1365: \n1366:     // Low-information ambiguity abstention: a short, intent-less prompt that lands\n1367:     // in a multi-candidate ambiguity cluster is genuinely under-specified. Floor\n1368:     // every cluster member's uncertainty above the strict threshold so strict\n1369:     // callers abstain, while confidence-only callers still surface the best guess\n1370:     // (the disambiguated top-ranked candidate).\n1371:     const meaningfulTokenCount = promptLower.split(/\\s+/)\n1372:       .filter((token) => token.length > 1).length;\n1373:     const lowInfoPrompt = meaningfulTokenCount <= 3\n1374:       && !hasTaskIntent\n1375:       && !promptLower.includes('/');\n1376:     if (lowInfoPrompt) {\n1377:       // Use the wider set: a floor-only skill must not top an under-specified prompt.\n1378:       const wideMembers = wideAmbiguityMembers(finished);\n1379:       const clusterMembers = finished.filter((recommendation) => (\n1380:         wideMembers.has(recommendation.skill)\n1381:       ));\n1382:       // Only abstain when the cluster's lead is built from diffuse, shared\n1383:       // single-word keyword matches rather than a distinctive multi-word phrase\n1384:       // anchor (an explicit-author/derived phrase match such as \"code audit\").\n1385:       // A multi-word anchor means the prompt does pin a specific skill, so it\n1386:       // should route instead of abstaining.\n1387:       const clusterHasPhraseAnchor = clusterMembers.some((recommendation) => (\n1388:         recommendation.laneContributions.some((contribution) => (\n1389:           (contribution.lane === 'explicit_author'\n1390:             || contribution.lane === 'derived_generated')\n1391:           && contribution.evidence.some((entry) => entry.includes(' '))\n1392:         ))\n1393:       ));\n1394:       if (clusterMembers.length >= 2 && !clusterHasPhraseAnchor) {\n1395:         const confThreshold = options.confidenceThreshold\n1396:           ?? DEFAULT_CONFIDENCE_THRESHOLD;\n1397:         const uncThreshold = options.uncertaintyThreshold\n1398:           ?? DEFAULT_UNCERTAINTY_THRESHOLD;\n1399:         const floor = SCORING_CALIBRATION.uncertainty.lowInfoAmbiguityFloor;\n1400:         finished = finished.map((recommendation) => {\n1401:           if (!wideMembers.has(recommendation.skill)) return recommendation;\n1402:           const uncertainty = Math.max(recommendation.uncertainty, floor);\n1403:           return {\n1404:             ...recommendation,\n1405:             uncertainty,\n1406:             passes_threshold: recommendation.confidence >= confThreshold\n1407:               && uncertainty <= uncThreshold,\n1408:           };\n1409:         });\n1410:       }\n1411:     }\n1412: \n1413:     // Class C: breadth / multi-concern abstention. A broad greenfield build\n1414:     // (\"build full stack typescript service\") or a multi-concern optimization\n1415:     // (\"optimize X execution speed and recommendation quality\") is under-specified\n1416:     // for single-skill routing. When the top code-like candidate carries that\n1417:     // shape, floor every passing candidate's uncertainty so strict callers abstain.\n1418:     // Narrow anchors (a file, failing test, named component/route, benchmark, or\n1419:     // review intent) bypass the broad-build branch; the multi-concern branch\n1420:     // requires two distinct concern classes, so a file + single concern still routes.\n1421:     if (!promptLower.includes('/')) {\n1422:       const concernClasses = (CONCERN_PERF.test(promptLower) ? 1 : 0)\n1423:         + (CONCERN_QUALITY.test(promptLower) ? 1 : 0);\n1424:       const broadBuild = BREADTH_BUILD_VERB.test(promptLower)\n1425:         && BREADTH_NOUN.test(promptLower)\n1426:         && !BREADTH_NARROW_ANCHOR.test(promptLower);\n1427:       const multiConcern = MULTI_CONCERN_VERB.test(promptLower)\n1428:         && concernClasses >= 2;\n1429:       if (broadBuild || multiConcern) {\n1430:         const topRec = finished.find((recommendation) => recommendation.passes_threshold)\n1431:           ?? null;\n1432:         if (topRec && (\n1433:           topRec.skill === 'sk-code'\n1434:           || topRec.skill === 'system-skill-advisor'\n1435:         )) {\n1436:           const confThreshold = options.confidenceThreshold\n1437:             ?? DEFAULT_CONFIDENCE_THRESHOLD;\n1438:           const uncThreshold = options.uncertaintyThreshold\n1439:             ?? DEFAULT_UNCERTAINTY_THRESHOLD;\n1440:           const floor = SCORING_CALIBRATION.uncertainty.lowInfoAmbiguityFloor;\n1441:           finished = finished.m