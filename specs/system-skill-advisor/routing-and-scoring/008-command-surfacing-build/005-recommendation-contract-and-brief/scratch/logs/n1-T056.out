eAllowedFloor > base,\n463:     };\n464:   }\n465:   if (args.derivedDominant && args.directScore < C.derivedDominantDirectScoreCeiling) {\n466:     return { value: C.derivedDominantConfidence, floored: false };\n467:   }\n468:   if (args.hasTaskIntent\n469:     && (args.directScore >= C.taskIntentDirectScoreFloor\n470:       || args.liveNormalized >= C.taskIntentLiveNormalizedFloor)) {\n471:     // Token-stuffing dispersion guard. Without this, a prompt\n472:     // with task-intent + many weak signals (saturating liveNormalized) but\n473:     // no strong direct anchor would force confidence to taskIntentFloor for\n474:     // many unrelated skills. The guard fires when liveNormalized is near-\n475:     // saturated AND directScore is below the directScoreLiftThreshold —\n476:     // the precise signature of a token-stuffed prompt. Legitimate task-intent\n477:     // prompts have at least one strong direct hit and pass via directScore;\n478:     // they don't hit this branch. When the guard fires we fall through to\n479:     // the standard `base + directBonus` math below.\n480:     const dispersionGuardTripped = args.liveNormalized >= 0.95\n481:       && args.directScore < C.directScoreLiftThreshold;\n482:     if (!dispersionGuardTripped) {\n483:       return {\n484:         value: Number(Math.max(base, C.taskIntentFloor).toFixed(4)),\n485:         floored: C.taskIntentFloor > base,\n486:       };\n487:     }\n488:   }\n489:   if (args.directScore >= C.directScoreLiftThreshold) {\n490:     return {\n491:       value: Number(Math.max(base, C.directScoreFloor).toFixed(4)),\n492:       floored: C.directScoreFloor > base,\n493:     };\n494:   }\n495:   const directBonus = args.directScore >= C.directScoreBonusThreshold ? C.directScoreBonus : 0;\n496:   return { value: Number(Math.max(0, Math.min(C.hardCeiling, base + directBonus)).toFixed(4)), floored: false };\n497: }\n498: \n499: function uncertaintyFor(contributions: readonly LaneContribution[], confidence: number, ambiguousPressure: number): number {\n500:   const U = SCORING_CALIBRATION.uncertainty;\n501:   const evidenceCount = contributions.reduce((total, contribution) => total + contribution.evidence.length, 0);\n[Output truncated. Continue reading with offset: 502]","title":"read","metadata":{"metadata":{"truncated":true},"content":[{"type":"text","text":"Read file .skilled/skills/system-skill-advisor/runtime/lib/scorer/fusion.ts, lines 432-501\n432: function isAdvisorSelfRecommendationSkill(skillId: string): boolean {\n433:   return ADVISOR_SELF_RECOMMENDATION_SKILL_IDS.has(skillId);\n434: }\n435: \n436: function confidenceFor(args: {\n437:   liveNormalized: number;\n438:   directScore: number;\n439:   readOnlyExplainer: boolean;\n440:   hasExplicitWorkflowSignal: boolean;\n441:   hasTaskIntent: boolean;\n442:   readOnlyRouteAllowed: boolean;\n443:   derivedDominant: boolean;\n444:   skillId: string;\n445: }): { value: number; floored: boolean } {\n446:   const C = SCORING_CALIBRATION.confidence;\n447:   // The advisor alias must never rank itself first on a read-only explainer;\n448:   // floor its confidence. The canonical id is demoted separately by the audit\n449:   // penalty in primaryIntentBonus, so this branch intentionally matches only\n450:   // the alias id.\n451:   if (args.readOnlyExplainer && args.skillId === 'skill-advisor') {\n452:     return { value: C.readOnlyExplainerFloor, floored: false };\n453:   }\n454:   const base = C.baseConstant\n455:     + Math.min(1, args.liveNormalized * C.liveNormalizedRampGain) * C.liveNormalizedRampCoefficient;\n456:   if (args.readOnlyExplainer && !args.readOnlyRouteAllowed) {\n457:     return { value: C.readOnlyExplainerFloor, floored: false };\n458:   }\n459:   if (args.readOnlyRouteAllowed) {\n460:     return {\n461:       value: Number(Math.max(base, C.readOnlyRouteAllowedFloor).toFixed(4)),\n462:       floored: C.readOnlyRouteAllowedFloor > base,\n463:     };\n464:   }\n465:   if (args.derivedDominant && args.dir