{"type":"tool_use","timestamp":1794529371604,"sessionID":"ses_e2db80168ffeLm0I2SBG3PMsOX","part":{"partID":"prt_1d24923e1001o6gXpbbCqhlDR3","sessionID":"ses_e2db80168ffeLm0I2SBG3PMsOX","messageID":"msg_1d24903ca001s2v0HAf5Qt9Mre","type":"tool","id":"call_4fa2c0b50c1a497daaa8f83b","tool":"read","state":{"status":"completed","input":{"path":".skilled/skills/system-skill-advisor/runtime/lib/scorer/projection.ts","offset":1690,"limit":220},"output":"Read file .skilled/skills/system-skill-advisor/runtime/lib/scorer/projection.ts, lines 1690-1863\n1690:   }\n1691:   for (const row of docRows) {\n1692:     const phrases = unique(parseJsonStringArray(row.trigger_phrases).flatMap((entry) => phraseVariants(entry)));\n1693:     if (phrases.length === 0) continue;\n1694:     const entry: SkillDocTriggerProjection = {\n1695:       docPath: row.doc_path,\n1696:       phrases,\n1697:       tierWeight: docTierWeight(row.importance_tier),\n1698:     };\n1699:     const existing = bySkill.get(row.skill_id);\n1700:     if (existing) existing.push(entry);\n1701:     else bySkill.set(row.skill_id, [entry]);\n1702:   }\n1703:   return bySkill;\n1704: }\n1705: \n1706: function loadSqliteProjection(workspaceRoot: string): AdvisorProjection | null {\n1707:   const dbPath = isAbsolute(SKILL_GRAPH_DB) ? SKILL_GRAPH_DB : join(workspaceRoot, SKILL_GRAPH_DB);\n1708:   if (!existsSync(dbPath)) return null;\n1709:   const db = new Database(dbPath, { readonly: true, fileMustExist: true });\n1710:   try {\n1711:     const rows = db.prepare(`\n1712:       SELECT id, family, category, domains, intent_signals, derived, source_path\n1713:       FROM skill_nodes\n1714:       ORDER BY id ASC\n1715:     `).all() as SkillNodeRow[];\n1716:     const edgeRows = db.prepare(`\n1717:       SELECT source_id, target_id, edge_type, weight, context\n1718:       FROM skill_edges\n1719:       ORDER BY source_id ASC, edge_type ASC, target_id ASC\n1720:     `).all() as SkillEdgeRow[];\n1721:     const docTriggersBySkill = loadDocTriggersBySkill(db);\n1722:     const embeddingStaleness = readAdvisorEmbeddingStaleness(db);\n1723:     return {\n1724:       skills: [\n1725:         ...rows.map((row) => {\n1726:           const projection = projectionFromRow(row);\n1727:           const docTriggers = docTriggersBySkill.get(row.id);\n1728:           return docTriggers && docTriggers.length > 0 ? { ...projection, docTriggers } : projection;\n1729:         }),\n1730:         ...scoringCommandBridges(COMMAND_BRIDGES),\n1731:       ],\n1732:       edges: edgeRows.map((row) => ({\n1733:         sourceId: row.source_id,\n1734:         targetId: row.target_id,\n1735:         edgeType: row.edge_type,\n1736:         weight: Math.max(0, Math.min(1, row.weight)),\n1737:         context: row.context,\n1738:       })),\n1739:       generatedAt: new Date().toISOString(),\n1740:       source: 'sqlite',\n1741:       embeddingSignature: embeddingStaleness.stored,\n1742:       embeddingStaleness,\n1743:     };\n1744:   } finally {\n1745:     db.close();\n1746:   }\n1747: }\n1748: \n1749: function loadFilesystemProjection(workspaceRoot: string): AdvisorProjection {\n1750:   const skillRoot = join(workspaceRoot, '.skilled', 'skills');\n1751:   const skills: SkillProjection[] = [];\n1752:   const edges: SkillEdgeProjection[] = [];\n1753:   if (!existsSync(skillRoot)) {\n1754:     return {\n1755:       skills: scoringCommandBridges(COMMAND_BRIDGES),\n1756:       edges,\n1757:       generatedAt: new Date().toISOString(),\n1758:       source: 'filesystem',\n1759:     };\n1760:   }\n1761:   const isTrustedLink = createPrivateSkillLinkCheck(skillRoot);\n1762:   for (const entry of readdirSync(skillRoot, { withFileTypes: true })) {\n1763:     // A private skill is linked in on purpose; read it only when its target\n1764:     // stays inside a directory the operator trusts.\n1765:     const linkedPrivateSkill = entry.name.startsWith('local-')\n1766:       && entry.isSymbolicLink()\n1767:       && isTrustedLink(join(skillRoot, entry.name));\n1768:     if (!entry.isDirectory() && !linkedPrivateSkill) continue;\n1769:     const skillDir = join(skillRoot, entry.name);\n1770:     const metadataPath = join(skillDir, 'graph-metadata.json');\n1771:     if (!existsSync(metadataPath)) continue;\n1772:     const metadata = readJson(metadataPath);\n1773:     const skillMd = parseSkillMarkdown(join(skillDir, 'SKILL.md'), entry.name);\n1774:     const skillId = typeof metadata.skill_id === 'string' ? metadata.skill_id : entry.name;\n1775:     const rawDerived = typeof metadata.derived === 'object' && metadata.derived !== null && !Array.isArray(metadata.derived)\n1776:       ? metadata.derived as Record<string, unknown>\n1777:       : {};\n1778:     const derived = sanitizeDerivedMetadata(rawDerived, metadataPath) ?? {};\n1779:     // Same split applied here as in projectionFromRow above —\n1780:     // derivedTriggers (from trigger_phrases) and derivedKeywords (from\n1781:     // key_topics + entities + key_files + source_docs) are now distinct.\n1782:     const derivedTriggers = unique(\n1783:       stringArray(derived.trigger_phrases).flatMap((item) => phraseVariants(item)),\n1784:     );\n1785:     const derivedKeywords = unique([\n1786:       ...stringArray(derived.key_topics),\n1787:       ...stringArray(derived.entities),\n1788:       ...stringArray(derived.key_files).map(reduceDerivedPathEntry),\n1789:       ...stringArray(derived.source_docs).map(reduceDerivedPathEntry),\n1790:     ].flatMap((item) => phraseVariants(item)));\n1791:     skills.push({\n1792:       id: skillId,\n1793:       kind: 'skill',\n1794:       family: typeof metadata.family === 'string' ? metadata.family : 'system',\n1795:       category: typeof metadata.category === 'string' ? metadata.category : 'skill',\n1796:       name: skillMd.name,\n1797:       description: skillMd.description,\n1798:       keywords: unique(skillMd.keywords.flatMap((item) => phraseVariants(item))),\n1799:       domains: unique(sanitizeMetadataStringArray(stringArray(metadata.domains), metadataPath).flatMap((item) => phraseVariants(item))),\n1800:       intentSignals: unique(sanitizeMetadataStringArray(stringArray(metadata.intent_signals), metadataPath).flatMap((item) => phraseVariants(item))),\n1801:       derivedTriggers,\n1802:       derivedKeywords,\n1803:       derivedDemotion: boundedDemotion(derived.demotion),\n1804:       // generated_at leads the chain (canonical V2 author/sync time); see the\n1805:       // SQLite branch above for why this is author-time, not runtime.\n1806:       derivedGeneratedAt: isoTimestampOrNull(derived.generated_at ?? derived.last_updated_at ?? derived.created_at),\n1807:       sourcePath: metadataPath,\n1808:       lifecycleStatus: lifecycleStatus(metadata.lifecycle_status ?? derived.lifecycle_status, metadataPath),\n1809:       redirectTo: typeof metadata.redirect_to === 'string' ? metadata.redirect_to : undefined,\n1810:       redirectFrom: stringArray(metadata.redirect_from),\n1811:     });\n1812:   }\n1813:   return {\n1814:     skills: [...skills, ...scoringCommandBridges(COMMAND_BRIDGES)],\n1815:     edges,\n1816:     generatedAt: new Date().toISOString(),\n1817:     source: 'filesystem',\n1818:   };\n1819: }\n1820: \n1821: // ───────────────────────────────────────────────────────────────────\n1822: // 10. EXPORTS\n1823: // ───────────────────────────────────────────────────────────────────\n1824: \n1825: // Previously a bare `catch {}` swallowed every SQLite read error\n1826: // and silently fell back to the filesystem projection, hiding corrupt-DB and\n1827: // schema-drift failures from operators. We now distinguish three cases:\n1828: //   1. SQLite read succeeded → return that projection ('sqlite').\n1829: //   2. SQLite DB does not exist yet → loadSqliteProjection returns null and we\n1830: //      fall through to a clean 'filesystem' projection (legitimate first run).\n1831: //   3. SQLite read THREW → we still degrade to filesystem so the daemon stays\n1832: //      up, but the projection is tagged 'filesystem-fallback' with a\n1833: //      fallbackReason carrying the underlying error message AND the failure\n1834: //      is logged via console.warn so it surfaces in daemon logs.\n1835: export function loadAdvisorProjection(workspaceRoot: string): AdvisorProjection {\n1836:   const resolvedRoot = resolve(workspaceRoot);\n1837:   try {\n1838:     const sqliteProjection = loadSqliteProjection(resolvedRoot);\n1839:     if (sqliteProjection !== null) return sqliteProjection;\n1840:     return loadFilesystemProjection(resolvedRoot);\n1841:   } catch (error: unknown) {\n1842:     const reason = error instanceof Error ? error.message : String(error);\n1843:     console.warn(`[advisor-projection] SQLite projection failed; degraded to filesystem fallback: ${reason}`);\n1844:     const fallback = loadFilesystemProjection(resolvedRoot);\n1845:     return {\n1846:       ...fallback,\n1847:       source: 'filesystem-fallback',\n1848:       fallbackReason: reason,\n1849:     };\n1850:   }\n1851: }\n1852: \n1853: export function createFixtureProjection(\n1854:   skills: readonly SkillProjection[],\n1855:   edges: readonly SkillEdgeProjection[] = [],\n1856: ): AdvisorProjection {\n1857:   return {\n1858:     skills,\n1859:     edges,\n1860:     generatedAt: new Date().toISOString(),\n1861:     source: 'fixture',\n1862:   };\n1863: }","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file .skilled/skills/system-skill-advisor/runtime/lib/scorer/projection.ts, lines 1690-1863\n1690:   }\n1691:   for (const row of docRows) {\n1692:     const phrases = unique(parseJsonStringArray(row.trigger_phrases).flatMap((entry) => phraseVariants(entry)));\n1693:     if (phrases.length === 0) continue;\n1694:     const entry: SkillDocTriggerProjection = {\n1695:       docPath: row.doc_path,\n1696:       phrases,\n1697:       tierWeight: docTierWeight(row.importance_tier),\n1698:     };\n1699:  