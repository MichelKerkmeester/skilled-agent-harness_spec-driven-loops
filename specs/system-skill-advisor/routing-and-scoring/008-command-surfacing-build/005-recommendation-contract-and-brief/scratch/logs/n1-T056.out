:{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\"specs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/005-recommendation-contract-and-brief/scratch/nm-sk-doc-before.txt\"}"},"time":{"start":1794529320161,"end":1794529320524}}}}
