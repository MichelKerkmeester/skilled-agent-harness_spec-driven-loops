{"type":"tool_use","timestamp":1794529339461,"sessionID":"ses_e2db80168ffeLm0I2SBG3PMsOX","part":{"partID":"prt_1d248a765001ZnDoAJ9s6Yjs9k","sessionID":"ses_e2db80168ffeLm0I2SBG3PMsOX","messageID":"msg_1d248a162001ePKxmI0qrwQBcu","type":"tool","id":"call_21b068965e5443b4a746164b","tool":"read","state":{"status":"completed","input":{"path":".skilled/skills/system-skill-advisor/runtime/lib/scorer/text.ts"},"output":"Read file .skilled/skills/system-skill-advisor/runtime/lib/scorer/text.ts, lines 1-157\n1: // ───────────────────────────────────────────────────────────────\n2: // MODULE: Advisor Scorer Text Utilities\n3: // ───────────────────────────────────────────────────────────────\n4: \n5: const STOP_WORDS = new Set([\n6:   'a', 'about', 'able', 'actually', 'agent', 'all', 'also', 'an', 'and', 'any',\n7:   'are', 'as', 'at', 'be', 'been', 'being', 'but', 'by', 'can', 'could', 'did',\n8:   'do', 'does', 'even', 'for', 'from', 'get', 'give', 'go', 'going', 'had',\n9:   'has', 'have', 'he', 'help', 'her', 'him', 'how', 'i', 'if', 'in', 'into',\n10:   'is', 'it', 'its', 'just', 'let', 'like', 'may', 'me', 'might', 'more',\n11:   'most', 'must', 'my', 'need', 'no', 'not', 'now', 'of', 'on', 'only', 'or',\n12:   'other', 'our', 'please', 'really', 'she', 'should', 'skill', 'skills',\n13:   'so', 'some', 'tell', 'that', 'the', 'them', 'then', 'these', 'they',\n14:   'thing', 'things', 'this', 'those', 'to', 'tool', 'try', 'us',\n15:   'used', 'using', 'very', 'want', 'was', 'way', 'we', 'were', 'what', 'when',\n16:   'where', 'which', 'who', 'why', 'will', 'with', 'would', 'you', 'your',\n17: ]);\n18: \n19: export function normalizeText(value: string): string {\n20:   return value\n21:     .replace(/([a-z])([A-Z])/g, '$1 $2')\n22:     .replace(/[_./-]+/g, ' ')\n23:     .replace(/[^A-Za-z0-9:/`'\". ]+/g, ' ')\n24:     .replace(/\\s+/g, ' ')\n25:     .trim()\n26:     .toLowerCase();\n27: }\n28: \n29: export function tokenize(value: string, includeStopWords = false): string[] {\n30:   const tokens = Array.from(value.toLowerCase().matchAll(/\\b\\w+\\b/g), (match) => match[0]);\n31:   return includeStopWords\n32:     ? tokens\n33:     : tokens.filter((token) => token.length > 1 && !STOP_WORDS.has(token));\n34: }\n35: \n36: // A typed slash command such as \"/deep:research\" or \"/speckit:plan\".\n37: const SLASH_COMMAND = /(?:^|[^\\w/])\\/[a-z][\\w-]*:[\\w-]+/i;\n38: // The execution-mode suffixes the command docs accept after a slash command,\n39: // either attached (\"/speckit:plan:auto\") or as its own argument (\":auto\").\n40: // They choose how the command runs, not what it is about, so they are not\n41: // prompt content. The \":with-*\" modifiers are left alone: their words name\n42: // extra work (research, phases) and can carry intent.\n43: const COMMAND_MODE_SUFFIX = /:(?:auto|confirm|autopilot|unattended)(?![\\w-])/gi;\n44: \n45: export function stripCommandModeSuffixes(prompt: string): string {\n46:   const command = SLASH_COMMAND.exec(prompt);\n47:   if (!command) return prompt;\n48:   return prompt.slice(0, command.index) + prompt.slice(command.index).replace(COMMAND_MODE_SUFFIX, ' ');\n49: }\n50: \n51: // Tokenize a user prompt. Skill-side text goes through tokenize() unchanged.\n52: export function tokenizePrompt(prompt: string, includeStopWords = false): string[] {\n53:   return tokenize(stripCommandModeSuffixes(prompt), includeStopWords);\n54: }\n55: \n56: export function unique<T>(values: readonly T[]): T[] {\n57:   return [...new Set(values)];\n58: }\n59: \n60: export function phraseVariants(value: string): string[] {\n61:   const lowered = value.trim().toLowerCase();\n62:   if (!lowered) return [];\n63:   return unique([\n64:     lowered,\n65:     lowered.replace(/-/g, ' '),\n66:     lowered.replace(/_/g, ' '),\n67:     lowered.replace(/-/g, '_'),\n68:     normalizeText(lowered),\n69:   ].filter(Boolean));\n70: }\n71: \n72: export function skillNameVariants(skillId: string | null | undefined): string[] {\n73:   if (typeof skillId !== 'string' || skillId.trim().length === 0) return [];\n74:   const base = skillId.toLowerCase();\n75:   return unique([\n76:     base,\n77:     `$${base}`,\n78:     `/${base}`,\n79:     base.replace(/-/g, ' '),\n80:     base.replace(/-/g, '_'),\n81:   ]);\n82: }\n83: \n84: export function matchesPhraseBoundary(text: string, phrase: string): boolean {\n85:   const normalizedPhrase = phrase.trim().toLowerCase();\n86:   if (!normalizedPhrase) return false;\n87:   const escaped = normalizedPhrase.replace(/[.*+?^${}()|[\\]\\\\]/g, '\\\\$&');\n88:   return new RegExp(`(?<!\\\\w)${escaped}(?!\\\\w)`).test(text);\n89: }\n90: \n91: export function phraseSpecificity(phrase: string): number {\n92:   const count = Math.max(1, tokenize(phrase, true).length);\n93:   return Math.min(0.7 + 0.18 * (count - 1), 1);\n94: }\n95: \n96: // What a longer skill word may add to a prompt word and still name the same\n97: // concept: a suffix (\"plan\" -> \"planning\", \"deploy\" -> \"deployment\"). English\n98: // suffixes start with a vowel or are one of a few consonant-led endings, while a\n99: // second word added on (\"auto\" -> \"autoreap\", \"open\" -> \"opencode\", \"launch\" ->\n100: // \"launchpad\") usually starts with a consonant and names something else.\n101: const VOWEL_LED_TAIL = /^[aeiouy]/;\n102: const CONSONANT_LED_SUFFIX = /^(?:s|d|ly|ment|ments|ness|ful|less)$/;\n103: // A stem ending in \"e\" drops it before \"-ence\", \"-ent\", \"-er\": \"converge\" -> \"convergence\".\n104: const AFTER_FINAL_E_SUFFIX = /^(?:s|d|r|rs|nce|ncy|nt|nts)$/;\n105: \n106: function extendsBySuffix(stem: string, word: string): boolean {\n107:   if (word.length <= stem.length || !word.startsWith(stem)) return false;\n108:   let tail = word.slice(stem.length);\n109:   if (stem.endsWith('e') && AFTER_FINAL_E_SUFFIX.test(tail)) return true;\n110:   // A doubled final consonant comes before the suffix: \"plan\" -> \"planning\".\n111:   if (tail[0] === stem[stem.length - 1] && !VOWEL_LED_TAIL.test(tail)) tail = tail.slice(1);\n112:   return VOWEL_LED_TAIL.test(tail) || CONSONANT_LED_SUFFIX.test(tail);\n113: }\n114: \n115: // denominatorBasis lets callers that expand the prompt (e.g. synonym injection)\n116: // normalize by the ORIGINAL prompt-token count, so adding synonyms can only help\n117: // recall and never dilutes a true match's score. Defaults to promptTokens.length\n118: // for callers that pass un-expanded tokens.\n119: export function scoreTokenOverlap(\n120:   promptTokens: readonly string[],\n121:   candidateText: readonly string[],\n122:   denominatorBasis: number = promptTokens.length,\n123: ): number {\n124:   const candidateTokens = new Set(candidateText.flatMap((entry) => tokenize(entry)));\n125:   if (candidateTokens.size === 0 || promptTokens.length === 0) return 0;\n126:   let hits = 0;\n127:   for (const token of promptTokens) {\n128:     if (candidateTokens.has(token)) {\n129:       hits += 1;\n130:       continue;\n131:     }\n132:     for (const candidate of candidateTokens) {\n133:       // A short prompt word inside or at the end of \"allowlist\" (\"list\") names a different concept.\n134:       // A prompt extension (\"regressions\") or a skill word that adds a suffix (\"plan\" -> \"planning\")\n135:       // stays related; one that adds a second word (\"auto\" -> \"autoreap\") does not.\n136:       if (token.length >= 4 && candidate.length >= 4 && (token.includes(candidate) || extendsBySuffix(token, candidate))) {\n137:         hits += 0.45;\n138:         break;\n139:       }\n140:     }\n141:   }\n142:   return Math.min(hits / Math.max(3, denominatorBasis), 1);\n143: }\n144: \n145: export function isReadOnlyExplainer(promptLower: string): boolean {\n146:   const readOnly = /\\b(analyze|explain|inspect|summarize|list|show|tell|compare|decompose)\\b/.test(promptLower);\n147:   const skillSurface = /\\b(review|audit|deep[- ]research|deep[- ]review|semantic search|figma|clickup|chrome devtools|git worktree|prompt)\\b/.test(promptLower);\n148:   const explicitNoWrite = /\\b(no edits?|without making changes|do not (change|edit|modify|touch)|read-only only|no edits yet|only; do not|just show|just list)\\b/.test(promptLower);\n149:   if (skillSurface) return false;\n150:   if (readOnly && explicitNoWrite) return true;\n151:   if (/^\\s*(analyze|explain|inspect|summarize|list|show|tell|compare|decompose)\\b/.test(promptLower)\n152:     && !/\\b(then|and)\\s+(add|build|change|configure|create|edit|fix|generate|implement|modify|move|patch|refactor|rename|replace|run|save|start|update|write)\\b/.test(promptLower)) {\n153:     return true;\n154:   }\n155:   const write = /\\b(add|build|change|configure|create|disable[sd]?|edit|enable[sd]?|execute|fix|generate|implement|modify|patch|refactor|rename|re-?run|run|save|switch (?:on|off)|turn (?:on|off)|update|write)\\b/.test(promptLower);\n156:   return readOnly && !write && !skillSurface;\n157: }","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file .skilled/skills/system-skill-advisor/runtime/lib/scorer/text.ts, lines 1-157\n1: // ───────────────────────────────────────────────────────────────\n2: // MODULE: Advisor Scorer Text Utilities\n3: // ───────────────────────────────────────────────────────────────\n4: \n5: const STOP_WORDS = new Set([\n6:   'a', 'about', 'able', 'actually', 'agent', 'all', 'also', 'an', 'and', 'any',\n7:   'are', 'as', 'at', 'be', 'been', 'being', 'but', 'by', 'can', 'could', 'did',\n8:   'do', 'does', 'even', 'for', 'from', 'get', 'give', 'go', 'going', 'had',\n9:   'has', 'have', 'he', 'help', 'her', 'him', 'how', 'i', 'if', 'in', 'into',\n10:   'is', 'it', 'its', 'just', 'let', 'like', 'may', 'me', 'might', 'more',\n11:   'most', 'must', 'my', 'need', 'no', 'not', 'now', 'of', 'on', 'only', 'or',\n12:   'other', 'our', 'please', 'really', 'she', 'should', 'skill', 'skills',\n13:   'so', 'some', 'tell', 'that', 'the', 'them', 'then', 'these', 'they',\n14:   'thing', 'things', 'this', 'those', 'to', 'tool', 'try', 'us',\n15:   'used', 'using', 'very', 'want', 'was', 'way', 'we', 'were', 'what', 'when',\n16:   'where', 'which', 'who', 'why', 'will', 'with', 'would', 'you', 'your',\n17: ]);\n18: \n19: export function normalizeText(value: string): string {\n20:   return value\n21:     .replace(/([a-z])([A-Z])/g, '$1 $2')\n22:     .replace(/[_./-]+/g, ' ')\n23:     .replace(/[^A-Za-z0-9:/`'\". ]+/g, ' ')\n24:     .replace(/\\s+/g, ' ')\n25:     .trim()\n26:     .toLowerCase();\n27: }\n28: \n29: export function tokenize(value: string, includeStopWords = false): string[] {\n30:   const tokens = Array.from(value.toLowerCase().matchAll(/\\b\\w+\\b/g), (match) => match[0]);\n31:   return includeStopWords\n32:     ? tokens\n33:     : tokens.filter((token) => token.length > 1 && !STOP_WORDS.has(token));\n34: }\n35: \n36: // A typed slash command such as \"/deep:research\" or \"/speckit:plan\".\n37: const SLASH_COMMAND = /(?:^|[^\\w/])\\/[a-z][\\w-]*:[\\w-]+/i;\n38: // The execution-mode suffixes the command docs accept after a slash command,\n39: // either attached (\"/speckit:plan:auto\") or as its own argument (\":auto\").\n40: // They choose how the command runs, not what it is about, so they are not\n41: // prompt content. The \":with-*\" modifiers are left alone: their words name\n42: // extra work (research, phases) and can carry intent.\n43: const COMMAND_MODE_SUFFIX = /:(?:auto|confirm|autopilot|unattended)(?![\\w-])/gi;\n44: \n45: export function stripCommandModeSuffixes(prompt: string): string {\n46:   const command = SLASH_COMMAND.exec(prompt);\n47:   if (!command) return prompt;\n48:   return prompt.slice(0, command.index) + prompt.slice(command.index).replace(COMMAND_MODE_SUFFIX, ' ');\n49: }\n50: \n51: // Tokenize a user prompt. Skill-side text goes through tokenize() unchanged.\n52: export function tokenizePrompt(prompt: string, includeStopWords = false): string[] {\n53:   return tokenize(stripCommandModeSuffixes(prompt), includeStopWords);\n54: }\n55: \n56: export function unique<T>(values: readonly T[]): T[] {\n57:   return [...new Set(values)];\n58: }\n59: \n60: export function phraseVariants(value: string): string[] {\n61:   const lowered = value.trim().toLowerCase();\n62:   if (!lowered) return [];\n63:   return unique([\n64:     lowered,\n65:     lowered.replace(/-/g, ' '),\n66:     lowered.replace(/_/g, ' '),\n67:     lowered.replace(/-/g, '_'),\n68:     normalizeText(lowered),\n69:   ].filter(Boolean));\n70: }\n71: \n72: export function skillNameVariants(skillId: string | null | undefined): string[] {\n73:   if (typeof skillId !== 'string' || skillId.trim().length === 0) return [];\n74:   const base = skillId.toLowerCase();\n75:   return unique([\n76:     base,\n77:     `$${base}`,\n78:     `/${base}`,\n79:     base.replace(/-/g, ' '),\n80:     base.replace(/-/g, '_'),\n81:   ]);\n82: }\n83: \n84: export function matchesPhraseBoundary(text: string, phrase: string): boolean {\n85:   const normalizedPhrase = phrase.trim().toLowerCase();\n86:   if (!normalizedPhrase) return false;\n87:   const escaped = normalizedPhrase.replace(/[.*+?^${}()|[\\]\\\\]/g, '\\\\$&');\n88:   return new RegExp(`(?<!\\\\w)${escaped}(?!\\\\w)`).test(text);\n89: }\n90: \n91: export function phraseSpecificity(phrase: string): number {\n92:   const count = Math.max(1, tokenize(phrase, true).length);\n93:   return Math.min(0.7 + 0.18 * (count - 1), 1);\n94: }\n95: \n96: // What a longer skill word may add to a prompt word and still name the same\n97: // concept: a suffix (\"plan\" -> \"planning\", \"deploy\" -> \"deployment\"). English\n98: // suffixes start with a vowel or are one of a few consonant-led endings, while a\n99: // second word added on (\"auto\" -> \"autoreap\", \"open\" -> \"opencode\", \"launch\" ->\n100: // \"launchpad\") usually starts with a consonant and names something else.\n101: const VOWEL_LED_TAIL = /^[aeiouy]/;\n102: const CONSONANT_LED_SUFFIX = /^(?:s|d|ly|ment|ments|ness|ful|less)$/;\n103: // A stem ending in \"e\" drops it before \"-ence\", \"-ent\", \"-er\": \"converge\" -> \"convergence\".\n104: const AFTER_FINAL_E_SUFFIX = /^(?:s|d|r|rs|nce|ncy|nt|nts)$/;\n105: \n106: function extendsBySuffix(stem: string, word: string): boolean {\n107:   if (word.length <= stem.length || !word.startsWith(stem)) return false;\n108:   let tail = word.slice(stem.length);\n109:   if (stem.endsWith('e') && AFTER_FINAL_E_SUFFIX.test(tail)) return true;\n110:   // A doubled final consonant comes before the suffix: \"plan\" -> \"planning\".\n111:   if (tail[0] === stem[stem.length - 1] && !VOWEL_LED_TAIL.test(tail)) tail = tail.slice(1);\n112:   return VOWEL_LED_TAIL.test(tail) || CONSONANT_LED_SUFFIX.test(tail);\n113: }\n114: \n115: // denominatorBasis lets callers that expand the prompt (e.g. synonym injection)\n116: // normalize by the ORIGINAL prompt-token count, so adding synonyms can only help\n117: // recall and never dilutes a true match's score. Defaults to promptTokens.length\n118: // for callers that pass un-expanded tokens.\n119: export function scoreTokenOverlap(\n120:   promptTokens: readonly string[],\n121:   candidateText: readonly string[],\n122:   denominatorBasis: number = promptTokens.length,\n123: ): number {\n124:   const candidateTokens = new Set(candidateText.flatMap((entry) => tokenize(entry)));\n125:   if (candidateTokens.size === 0 || promptTokens.length === 0) return 0;\n126:   let hits = 0;\n127:   for (const token of promptTokens) {\n128:     if (candidateTokens.has(token)) {\n129:       hits += 1;\n130:       continue;\n131:     }\n132:     for (const candidate of candidateTokens) {\n133:       // A short prompt word inside or at the end of \"allowlist\" (\"list\") names a different concept.\n134:       // A prompt extension (\"regressions\") or a skill word that adds a suffix (\"plan\" -> \"planning\")\n135:       // stays related; one that adds a second word (\"auto\" -> \"autoreap\") does not.\n136:       if (token.length >= 4 && candidate.length >= 4 && (token.includes(candidate) || extendsBySuffix(token, candidate))) {\n137:         hits += 0.45;\n138:         break;\n139:       }\n140:     }\n141:   }\n142:   return Math.min(hits / Math.max(3, denominatorBasis), 1);\n143: }\n144: \n145: export function isReadOnlyExplainer(promptLower: string): boolean {\n146:   const readOnly = /\\b(analyze|explain|inspect|summarize|list|show|tell|compare|decompose)\\b/.test(promptLower);\n147:   const skillSurface = /\\b(review|audit|deep[- ]research|deep[- ]review|semantic search|figma|clickup|chrome devtools|git worktree|prompt)\\b/.test(promptLower);\n148:   const explicitNoWrite = /\\b(no edits?|without making changes|do not (change|edit|modify|touch)|read-only only|no edits yet|only; do not|just show|just list)\\b/.test(promptLower);\n149:   if (skillSurface) return false;\n150:   if (readOnly && explicitNoWrite) return true;\n151:   if (/^\\s*(analyze|explain|inspect|summarize|list|show|tell|compare|decompose)\\b/.test(promptLower)\n152:     && !/\\b(then|and)\\s+(add|build|change|configure|create|edit|fix|generate|implement|modify|move|patch|refactor|rename|replace|run|save|start|update|write)\\b/.test(promptLower)) {\n153:     return true;\n154:   }\n155:   const write = /\\b(add|build|change|configure|create|disable[sd]?|edit|enable[sd]?|execute|fix|generate|implement|modify|patch|refactor|rename|re-?run|run|save|switch (?:on|off)|turn (?:on|off)|update|write)\\b/.test(promptLower);\n156:   return readOnly && !write && !skillSurface;\n157: }"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\".skilled/skills/system-skill-advisor/runtime/lib/scorer/text.ts\"}"},"time":{"start":1794529339237,"end":1794529339461}}}}
