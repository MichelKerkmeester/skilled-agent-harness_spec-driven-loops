   // watch shallow (top-level create/delete only); explicit file targets are\n455:   // unaffected by the depth limit.\n456:   const watcher = options.watchFactory([...targetPaths, skillsRoot], {\n457:     ignoreInitial: true,\n458:     awaitWriteFinish: {\n459:       stabilityThreshold: options.backpressure?.stableWriteMs ?? envPositiveInt('SPECKIT_SKILL_GRAPH_STABLE_WRITE_MS', DEFAULT_STABLE_WRITE_MS),\n460:     },\n461:     atomic: true,\n462:     followSymlinks: false,\n463:     depth: 0,\n464:     ignored: (targetPath: string) => TEMP_SUFFIX_PATTERN.test(targetPath),\n465:   }) as SkillGraphFsWatcher;\n466: \n467:   // Registered before any other listener so a fast initial scan cannot\n468:   // emit 'ready' before anyone is listening.\n469:   const ready = new Promise<void>((resolveReady) => {\n470:     watcher.on('ready', () => resolveReady());\n471:   });\n472:   const debounceMs = options.backpressure?.debounceMs ?? envPositiveInt('SPECKIT_SKILL_GRAPH_DEBOUNCE_MS', DEFAULT_DEBOUNCE_MS);\n473:   const stormEventLimit = options.backpressure?.stormEventLimit ?? envPositiveInt('SPECKIT_SKILL_GRAPH_STORM_EVENT_LIMIT', DEFAULT_STORM_EVENT_LIMIT);\n474:   const stormWindowMs = options.backpressure?.stormWindowMs ?? envPositiveInt('SPECKIT_SKILL_GRAPH_STORM_WINDOW_MS', DEFAULT_STORM_WINDOW_MS);\n475:   const circuitCooldownMs = options.backpressure?.circuitCooldownMs ?? envPositiveInt('SPECKIT_SKILL_GRAPH_CIRCUIT_COOLDOWN_MS', DEFAULT_CIRCUIT_COOLDOWN_MS);\n476:   const busyRetryDelaysMs = options.backpressure?.busyRetryDelaysMs ?? DEFAULT_BUSY_RETRY_DELAYS_MS;\n477:   const now = options.now ?? (() => Date.now());\n478:   const fileHashes = new Map<string, string>();\n479:   const pending = new Map<string, PendingSkill>();\n480:   const eventTimes: number[] = [];\n481: \n482:   let debounceTimer: NodeJS.Timeout | null = null;\n483:   let circuitOpenUntil = 0;\n484:   let closed = false;\n485:   // Serialization primitive: only one flush drain runs at a\n486:   //