lEdgeProjection,\n29:   SkillLifecycleStatus,\n30:   SkillProjection,\n31: } from './types.js';\n32: import { phraseVariants, unique } from './text.js';\n33: \n34: // ───────────────────────────────────────────────────────────────────\n35: // 2. TYPE DEFINITIONS\n36: // ───────────────────────────────────────────────────────────────────\n37: \n38: interface SkillNodeRow {\n39:   readonly id: string;\n40:   readonly family: string;\n41:   readonly category: string;\n42:   readonly domains: string | null;\n43:   readonly intent_signals: string | null;\n44:   readonly derived: string | null;\n45:   readonly source_path: string;\n46: }\n47: \n48: interface SkillEdgeRow {\n49:   readonly source_id: string;\n50:   readonly target_id: string;\n51:   readonly edge_type: SkillEdgeProjection['edgeType'];\n52:   readonly weight: number;\n53:   readonly context: string;\n54: }\n55: \n56: interface SkillMarkdownMetadata {\n57:   readonly name: string;\n58:   readonly description: string;\n59:   readonly keywords: readonly string[];\n60: }\n61: \n62: export interface CommandBridgeProjection extends SkillProjection {\n63:   readonly inventoryId?: string;\n64:   /** The skill whose workflow the command runs, so the two are never ranked as rivals. */\n65:   readonly ownerSkill?: string;\n66:   readonly routingEnabled: boolean;\n67:   /** Set when the command's route only reads, so a list or show prompt may reach it. */\n68:   readonly readOnly?: boolean;\n69: }\n70: \n71: // ───────────────────────────────────────────────────────────────────\n72: // 3. CONSTANTS\n73: // ───────────────────────────────────────────────────────────────────\n74: \n75: const advisorDbDirOverride = process.env.SYSTEM_SKILL_ADVISOR_DB_DIR;\n76: const SKILL_GRAPH_DB = advisorDbDirOverride\n77:   ? join(advisorDbDirOverride, 'skill-graph.sqlite')\n78:   : join('.skilled', 'skills', 'system-skill-advisor', 'runtime', 'database', 'skill-graph.sqlite');\n79: \n80: // BEGIN GENERATED COMMAND BRIDGES\n81: export 