{"type":"tool_use","timestamp":1794529335425,"sessionID":"ses_e2db80168ffeLm0I2SBG3PMsOX","part":{"partID":"prt_1d2489742001ONKKnylSmNW2PI","sessionID":"ses_e2db80168ffeLm0I2SBG3PMsOX","messageID":"msg_1d2488bd00013De2dXUyY2UaNA","type":"tool","id":"call_1ee2d84f81574281ab3bddad","tool":"read","state":{"status":"completed","input":{"path":".skilled/skills/system-skill-advisor/runtime/lib/scorer/lanes/lexical.ts"},"output":"Read file .skilled/skills/system-skill-advisor/runtime/lib/scorer/lanes/lexical.ts, lines 1-116\n1: // ───────────────────────────────────────────────────────────────\n2: // MODULE: Lexical Lane\n3: // ───────────────────────────────────────────────────────────────\n4: \n5: import type { AdvisorProjection, LaneMatch } from '../types.js';\n6: import { matchesPhraseBoundary, scoreTokenOverlap, tokenizePrompt } from '../text.js';\n7: import { scoreBm25LexicalShadowLane, type AdvisorBm25Match } from './bm25.js';\n8: \n9: const SYNONYMS: Readonly<Record<string, readonly string[]>> = {\n10:   branch: ['git', 'worktree', 'merge'],\n11:   commit: ['git', 'changes'],\n12:   context: ['memory', 'session', 'save'],\n13:   docs: ['documentation', 'readme', 'markdown'],\n14:   document: ['documentation', 'markdown'],\n15:   find: ['search', 'locate'],\n16:   fix: ['debug', 'correct', 'patch'],\n17:   prompt: ['improve', 'enhance', 'optimize'],\n18:   review: ['audit', 'findings', 'regression'],\n19:   save: ['memory', 'context', 'preserve'],\n20:   search: ['find', 'locate', 'semantic'],\n21:   spec: ['plan', 'packet', 'tasks', 'checklist'],\n22:   test: ['vitest', 'verify'],\n23:   write: ['create', 'generate', 'documentation'],\n24: };\n25: \n26: const CATEGORY_HINTS: Readonly<Record<string, readonly string[]>> = {\n27:   'sk-doc': ['readme', 'feature catalog', 'playbook', 'taxonomy', 'documentation', 'docs', 'manual testing'],\n28:   'system-spec-kit': ['spec folder', 'packet', 'plan', 'tasks', 'checklist', 'memory save', 'handover', 'implementation summary', 'corpus'],\n29:   'system-deep-loop': ['deep research', 'deep-research', 'research loop', 'overnight research', 'delta record', 'state log', 'lineage', 'deep review', 'deep-review', 'review loop', 'release readiness', 'canonical jsonl', 'convergence tracked', 'iterative review', 'iterative review loop', 'spec folder audit', 'iterative audit', 'multi-pass review', 'review iteration', 'convergence detection', 'review packet', 'spec folder review', 'deep ai council', 'ai council', 'planning council', 'council deliberation', 'multi-seat planning', 'ai-council artifacts', 'persist council artifacts', 'multi-ai-council'],\n30:   'mcp-tooling': ['chrome devtools', 'har', 'console errors', 'staging'],\n31:   'sk-prompt': ['better prompt', 'cleaner prompt', 'prompt package', 'system prompt', 'prompt variant'],\n32:   'sk-git': ['git worktree', 'experiment branch', 'clean branch'],\n33:   // 'browser' and 'layout' were removed as bare tokens: a single word here grants\n34:   // +0.38 to every prompt containing it, which handed sk-code phrases that other hubs\n35:   // declare verbatim — browser debug, browser agent, review this layout. A hint is for\n36:   // a phrase that belongs to this hub, not a word that merely appears in its domain.\n37:   'sk-code': ['javascript', 'opencode', 'classifier', 'helper', 'fixture', 'vitest', 'commonjs', 'typescript', 'python', 'script', 'mcp json', 'gate3 baseline'],\n38: };\n39: \n40: const BM25_SHADOW_ENABLED_VALUES = new Set(['1', 'true', 'yes', 'on', 'shadow', 'experimental']);\n41: \n42: export function isBm25LexicalShadowEnabled(): boolean {\n43:   const value = process.env.SPECKIT_ADVISOR_BM25_LEXICAL_SHADOW?.trim().toLowerCase();\n44:   return value ? BM25_SHADOW_ENABLED_VALUES.has(value) : false;\n45: }\n46: \n47: function expandedTokens(prompt: string): string[] {\n48:   const tokens = tokenizePrompt(prompt);\n49:   const expanded = new Set(tokens);\n50:   for (const token of tokens) {\n51:     for (const synonym of SYNONYMS[token] ?? []) {\n52:       expanded.add(synonym);\n53:     }\n54:   }\n55:   return [...expanded];\n56: }\n57: \n58: export function scoreLexicalLane(prompt: string, projection: AdvisorProjection): LaneMatch[] {\n59:   const lower = prompt.toLowerCase();\n60:   const tokens = expandedTokens(prompt);\n61:   // Normalize against the un-expanded prompt length so injected synonyms only add\n62:   // recall and never enlarge the denominator against a literally-matching skill.\n63:   const originalTokenCount = tokenizePrompt(prompt).length;\n64:   const matches: LaneMatch[] = [];\n65: \n66:   for (const skill of projection.skills) {\n67:     const evidence: string[] = [];\n68:     const candidates = [\n69:       skill.id.replace(/-/g, ' '),\n70:       skill.name,\n71:       skill.description,\n72:       ...skill.domains,\n73:       ...skill.intentSignals,\n74:       ...skill.keywords,\n75:     ];\n76:     let score = scoreTokenOverlap(tokens, candidates, originalTokenCount);\n77: \n78:     for (const hint of CATEGORY_HINTS[skill.id] ?? []) {\n79:       if (matchesPhraseBoundary(lower, hint)) {\n80:         score += 0.38;\n81:         evidence.push(`hint:${hint}`);\n82:       }\n83:     }\n84: \n85:     // Evidence is harvested from the SAME candidate set the score was computed\n86:     // over. Harvesting from a subset of it let a skill match on an intent signal or\n87:     // a keyword, score well enough to clear the confidence floor, and still carry no\n88:     // evidence at all — which takes the no-evidence uncertainty default and is then\n89:     // dropped by the surfacing gate. The candidate was confident and invisible at\n90:     // the same time, and nothing in the output said why.\n91:     const haystack = candidates.join(' ').toLowerCase();\n92:     const tokenHits = tokens.filter((token) => haystack.includes(token)).slice(0, 5);\n93:     evidence.push(...tokenHits.map((token) => `token:${token}`));\n94: \n95:     if (score <= 0.05) continue;\n96:     matches.push({\n97:       skillId: skill.id,\n98:       lane: 'lexical',\n99:       score: Math.min(score, 1),\n100:       evidence: evidence.slice(0, 6),\n101:     });\n102:   }\n103: \n104:   return matches;\n105: }\n106: \n107: export function scoreLexicalShadowLanes(\n108:   prompt: string,\n109:   projection: AdvisorProjection,\n110: ): { lexical: LaneMatch[]; bm25: AdvisorBm25Match[] } {\n111:   const lexical = scoreLexicalLane(prompt, projection);\n112:   return {\n113:     lexical,\n114:     bm25: isBm25LexicalShadowEnabled() ? scoreBm25LexicalShadowLane(prompt, projection) : [],\n115:   };\n116: }","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file .skilled/skills/system-skill-advisor/runtime/lib/scorer/lanes/lexical.ts, lines 1-116\n1: // ───────────────────────────────────────────────────────────────\n2: // MODULE: Lexical Lane\n3: // ───────────────────────────────────────────────────────────────\n4: \n5: import type { AdvisorProjection, LaneMatch } from '../types.js';\n6: import { matchesPhraseBoundary, scoreTokenOverlap, tokenizePrompt } from '../text.js';\n7: import { scoreBm25LexicalShadowLane, type AdvisorBm25Match } from './bm25.js';\n8: \n9: const SYNONYMS: Readonly<Record<string, readonly string[]>> = {\n10:   branch: ['git', 'worktree', 'merge'],\n11:   commit: ['git', 'changes'],\n12:   context: ['memory', 'session', 'save'],\n13:   docs: ['documentation', 'readme', 'markdown'],\n14:   document: ['documentation', 'markdown'],\n15:   find: ['search', 'locate'],\n16:   fix: ['debug', 'correct', 'patch'],\n17:   prompt: ['improve', 'enhance', 'optimize'],\n18:   review: ['audit', 'findings', 'regression'],\n19:   save: ['memory', 'context', 'preserve'],\n20:   search: ['find', 'locate', 'semantic'],\n21:   spec: ['plan', 'packet', 'tasks', 'checklist'],\n22:   test: ['vitest', 'verify'],\n23:   write: ['create', 'generate', 'documentation'],\n24: };\n25: \n26: const CATEGORY_HINTS: Readonly<Record<string, readonly string[]>> = {\n27:   'sk-doc': ['readme', 'feature catalog', 'playbook', 'taxonomy', 'documentation', 'docs', 'manual testing'],\n28:   'system-spec-kit': ['spec folder', 'packet', 'plan', 'tasks', 'checklist', 'memory save', 'handover', 'implementation summary', 'corpus'],\n29:   'system-deep-loop': ['deep research', 'deep-research', 'research loop', 'overnight research', 'delta record', 'state log', 'lineage', 'deep review', 'deep-review', 'review loop', 'release readiness', 'canonical jsonl', 'convergence tracked', 'iterative review', 'iterative review loop', 'spec folder audit', 'iterative audit', 'multi-pass review', 'review iteration', 'convergence detection', 'review packet', 'spec folder review', 'deep ai council', 'ai council', 'planning council', 'council deliberation', 'multi-seat planning', 'ai-council artifacts', 'persist council artifacts', 'multi-ai-council'],\n30:   'mcp-tooling': ['chrome devtools', 'har', 'console errors', 'staging'],\n31:   'sk-prompt': ['better prompt', 'cleaner prompt', 'prompt package', 'system prompt', 'prompt variant'],\n32:   'sk-git': ['git worktree', 'experiment branch', 'clean branch'],\n33:   // 'browser' and 'layout' were removed as bare tokens: a single word here grants\n34:   // +0.38 to every prompt containing it, which handed sk-code phrases that other hubs\n35:   // declare verbatim — browser debug, browser agent, review this layout. A hint is for\n36:   // a phrase that belongs to this hub, not a word that merely appears in its domain.\n37:   'sk-code': ['javascript', 'opencode', 'classifier', 'helper', 'fixture', 'vitest', 'commonjs', 'typescript', 'python', 'script', 'mcp json', 'gate3 baseline'],\n38: };\n39: \n40: const BM25_SHADOW_ENABLED_VALUES = new Set(['1', 'true', 'yes', 'on', 'shadow', 'experimental']);\n41: \n42: export function isBm25LexicalShadowEnabled(): boolean {\n43:   const value = process.env.SPECKIT_ADVISOR_BM25_LEXICAL_SHADOW?.trim().toLowerCase();\n44:   return value ? BM25_SHADOW_ENABLED_VALUES.has(value) : false;\n45: }\n46: \n47: function expandedTokens(prompt: string): string[] {\n48:   const tokens = tokenizePrompt(prompt);\n49:   const expanded = new Set(tokens);\n50:   for (const token of tokens) {\n51:     for (const synonym of SYNONYMS[token] ?? []) {\n52:       expanded.add(synonym);\n53:     }\n54:   }\n55:   return [...expanded];\n56: }\n57: \n58: export function scoreLexicalLane(prompt: string, projection: AdvisorProjection): LaneMatch[] {\n59:   const lower = prompt.toLowerCase();\n60:   const tokens = expandedTokens(prompt);\n61:   // Normalize against the un-expanded prompt length so injected synonyms only add\n62:   // recall and never enlarge the denominator against a literally-matching skill.\n63:   const originalTokenCount = tokenizePrompt(prompt).length;\n64:   const matches: LaneMatch[] = [];\n65: \n66:   for (const skill of projection.skills) {\n67:     const evidence: string[] = [];\n68:     const candidates = [\n69:       skill.id.replace(/-/g, ' '),\n70:       skill.name,\n71:       skill.description,\n72:       ...skill.domains,\n73:       ...skill.intentSignals,\n74:       ...skill.keywords,\n75:     ];\n76:     let score = scoreTokenOverlap(tokens, candidates, originalTokenCount);\n77: \n78:     for (const hint of CATEGORY_HINTS[skill.id] ?? []) {\n79:       if (matchesPhraseBoundary(lower, hint)) {\n80:         score += 0.38;\n81:         evidence.push(`hint:${hint}`);\n82:       }\n83:     }\n84: \n85:     // Evidence is harvested from the SAME candidate set the score was computed\n86:     // over. Harvesting from a subset of it let a skill match on an intent signal or\n87:     // a keyword, score well enough to clear the confidence floor, and still carry no\n88:     // evidence at all — which takes the no-evidence uncertainty default and is then\n89:     // dropped by the surfacing gate. The candidate was confident and invisible at\n90:     // the same time, and nothing in the output said why.\n91:     const haystack = candidates.join(' ').toLowerCase();\n92:     const tokenHits = tokens.filter((token) => haystack.includes(token)).slice(0, 5);\n93:     evidence.push(...tokenHits.map((token) => `token:${token}`));\n94: \n95:     if (score <= 0.05) continue;\n96:     matches.push({\n97:       skillId: skill.id,\n98:       lane: 'lexical',\n99:       score: Math.min(score, 1),\n100:       evidence: evidence.slice(0, 6),\n101:     });\n102:   }\n103: \n104:   return matches;\n105: }\n106: \n107: export function scoreLexicalShadowLanes(\n108:   prompt: string,\n109:   projection: AdvisorProjection,\n110: ): { lexical: LaneMatch[]; bm25: AdvisorBm25Match[] } {\n111:   const lexical = scoreLexicalLane(prompt, projection);\n112:   return {\n113:     lexical,\n114:     bm25: isBm25LexicalShadowEnabled() ? scoreBm25LexicalShadowLane(prompt, projection) : [],\n115:   };\n116: }"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\".skilled/skills/system-skill-advisor/runtime/lib/scorer/lanes/lexical.ts\"}"},"time":{"start":1794529335106,"end":1794529335425}}}}
