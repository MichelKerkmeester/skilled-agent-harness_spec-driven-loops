{"type":"tool_use","timestamp":1794526606751,"sessionID":"ses_e2de199bcffenOc4bBZXnEEa5a","part":{"partID":"prt_1d21eef3d001qWznZ7NENsg8rI","sessionID":"ses_e2de199bcffenOc4bBZXnEEa5a","messageID":"msg_1d21ee0ee001EgqYZCBrSvYIti","type":"tool","id":"call_1425d5f708924a4bb03d42fa","tool":"read","state":{"status":"completed","input":{"path":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/sk-doc/sk-create-skill/scripts/ci-router-vocabulary-reach.cjs"},"output":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/sk-doc/sk-create-skill/scripts/ci-router-vocabulary-reach.cjs, lines 1-362\n1: #!/usr/bin/env node\n2: /**\n3:  * Check that a phrase a hub's router advertises actually reaches that hub.\n4:  *\n5:  * usage: ci-router-vocabulary-reach.cjs [--hub <id>] [--json] [--limit N]\n6:  *        [--concurrency N] [--skill <name-or-path>]\n7:  *\n8:  * A router's INTENT_SIGNALS resolves an intent inside a hub that has already been\n9:  * chosen. A hub's graph-metadata.json intent_signals is what decides which hub\n10:  * gets chosen. The two are not meant to match, so diffing them reports hundreds\n11:  * of differences that are not defects: a bare common word belongs in the first and\n12:  * would over-trigger in the second.\n13:  *\n14:  * The only thing that settles it is asking the advisor. This probes every\n15:  * multi-word phrase a router declares and reports the ones that do not reach the\n16:  * hub declaring them, which is the failure a diff cannot distinguish from design.\n17:  *\n18:  * Single words are skipped: they fail on length rather than on vocabulary, and\n19:  * reporting them buries the real cases.\n20:  */\n21: 'use strict';\n22: const fs = require('fs');\n23: const path = require('path');\n24: const { execFile } = require('child_process');\n25: const { promisify } = require('util');\n26: \n27: const execFileAsync = promisify(execFile);\n28: \n29: // Probing is the whole cost of this check, and it is spent waiting rather than\n30: // working: an uncached prompt takes about six seconds inside the advisor whichever\n31: // entry point asks, so the process spawn is noise. Sequentially that is over forty\n32: // minutes for the fleet, which is long enough that the check gets sampled instead\n33: // of run, and a sampled inventory is how phrases stayed broken across green runs.\n34: // The daemon serves concurrent callers, so the wait overlaps. The default is 2\n35: // rather than 8 because a busy advisor reported 11 to 13 probe-error rows at 8 and\n36: // none at 2, so concurrency was reading advisor load as unreachable phrases. The\n37: // measured price of the safer setting is about half a second per 48 cold probes.\n38: const DEFAULT_CONCURRENCY = 2;\n39: \n40: async function pool(items, limit, worker) {\n41:   const results = new Array(items.length);\n42:   let next = 0;\n43:   const runners = Array.from({ length: Math.min(limit, items.length) }, async () => {\n44:     for (let i = next++; i < items.length; i = next++) {\n45:       results[i] = await worker(items[i], i);\n46:     }\n47:   });\n48:   await Promise.all(runners);\n49:   return results;\n50: }\n51: \n52: const REPO_ROOT = path.resolve(__dirname, '..', '..', '..', '..', '..');\n53: const SKILLS = path.join(REPO_ROOT, '.skilled', 'skills');\n54: // Overridable so the fail-closed path can be exercised against an advisor that is\n55: // not there. A gate nobody can watch fail is a gate nobody knows the shape of.\n56: const ADVISOR = process.env.ROUTER_REACH_ADVISOR\n57:   || path.join(REPO_ROOT, '.skilled', 'bin', 'skill-advisor.cjs');\n58: \n59: // Known ownership disputes the check may pass over. An entry pins the winner as\n60: // well as the phrase, so an allowed phrase that starts losing to somebody NEW still\n61: // fails: a blanket pass on the phrase would reintroduce the exact blindness this\n62: // check was written to remove.\n63: const ALLOWLIST_PATH = path.join(__dirname, 'router-reach-allowlist.json');\n64: \n65: function allowlist() {\n66:   if (!fs.existsSync(ALLOWLIST_PATH)) return new Map();\n67:   const raw = JSON.parse(fs.readFileSync(ALLOWLIST_PATH, 'utf8'));\n68:   return new Map((raw.entries || []).map((e) => [`${e.declaredBy}\\u0000${e.phrase}`, e]));\n69: }\n70: \n71: const ALLOWED = allowlist();\n72: \n73: function allowedFor(hub, phrase, winner) {\n74:   const e = ALLOWED.get(`${hub}\\u0000${phrase}`);\n75:   return e && e.wonBy === winner ? e : null;\n76: }\n77: \n78: // An operator can link private skills into the skills root under this prefix, and\n79: // the advisor scores one whenever its link resolves inside a trusted root\n80: // (system-skill-advisor/runtime/lib/private-skill-target.cjs). The tracked tree\n81: // ignores every such entry, so CI never has one. This check gates the shipped\n82: // fleet: a verdict that flips with what one machine happens to link cannot be\n83: // fixed in the tracked tree, and the allowlist could not name the winner without\n84: // leaking a private name. A private surface that ranks ahead of the shipped\n85: // leader is still reported, as a note that never fails the run, because on that\n86: // machine it really does take the phrase.\n87: const PRIVATE_SKILL_PREFIX = 'local-';\n88: \n89: function isOperatorLocal(skillId) {\n90:   return typeof skillId === 'string' && skillId.startsWith(PRIVATE_SKILL_PREFIX);\n91: }\n92: \n93: // Ranks the shipped fleet out of one passing-recommendation list, and keeps the\n94: // confidence of every private surface that sat ahead of the shipped leader.\n95: function rankShippedFleet(above, hub) {\n96:   const shipped = above.filter((r) => !isOperatorLocal(r.skillId));\n97:   const leaderAt = shipped.length ? above.indexOf(shipped[0]) : above.length;\n98:   return {\n99:     hit: shipped.length > 0 && shipped[0].skillId === hub,\n100:     present: shipped.some((r) => r.skillId === hub),\n101:     top: shipped.slice(0, 2),\n102:     localAhead: above.slice(0, leaderAt).filter((r) => isOperatorLocal(r.skillId)),\n103:   };\n104: }\n105: \n106: // Kinds reported for a human and never failed: a length limit, a pinned dispute,\n107: // and a private surface the tracked tree does not own.\n108: const NON_FAILING = new Set(['no-reach', 'allowed', 'operator-local']);\n109: \n110: function hubs() {\n111:   return fs.readdirSync(SKILLS, { withFileTypes: true })\n112:     .filter((e) => e.isDirectory())\n113:     .map((e) => e.name)\n114:     .filter((n) => fs.existsSync(path.join(SKILLS, n, 'mode-registry.json'))\n115:       && fs.existsSync(path.join(SKILLS, n, 'ROUTER.md')))\n116:     .sort();\n117: }\n118: \n119: function declaredPhrases(directory) {\n120:   const text = fs.readFileSync(path.join(directory, 'ROUTER.md'), 'utf8');\n121:   const block = /INTENT_SIGNALS\\s*=\\s*\\{([\\s\\S]*?)\\n\\}/.exec(text);\n122:   if (!block) return [];\n123:   const found = [...block[1].matchAll(/\"([^\"]{3,60})\"/g)].map((m) => m[1]);\n124:   return [...new Set(found.filter((k) => (\n125:     // a single token fails on length, not on vocabulary; reporting it buries the rest\n126:     k.includes(' ')\n127:     // a quote-delimited match is not always a phrase. Where a router formats its\n128:     // block across lines, the text between two quoted keywords is punctuation and\n129:     // structure, and probing it wastes a call and prints a row nobody can act on.\n130:     && /^[a-z0-9]/i.test(k)\n131:     && !/[{}[\\]]/.test(k)\n132:     && !/^(weight|keywords)$/i.test(k)\n133:   )))];\n134: }\n135: \n136: // A probe that could not run is not a phrase that reached nobody. Collapsing the\n137: // two lets a missing binary, a non-zero exit, a timeout or a cold daemon print a\n138: // clean pass over an advisor that never answered, so every failure to ask is\n139: // returned as its own result and fails the run.\n140: // The advisor exits 75 to say \"temporary, ask again\", and overlapping probes\n141: // provoke it: the same phrases that fail in a concurrent sweep answer correctly one\n142: // at a time. Reporting that as a defect would trade the old false green for a false\n143: // red, so a retryable exit is retried before it is believed. Anything else is a\n144: // real failure and is returned on the first try.\n145: const RETRYABLE_EXIT = 75;\n146: const PROBE_ATTEMPTS = 3;\n147: \n148: const sleep = (ms) => new Promise((r) => { setTimeout(r, ms); });\n149: \n150: async function probeOnce(phrase) {\n151:   const { stdout } = await execFileAsync('node', [ADVISOR, 'advisor_recommend', '--json',\n152:     JSON.stringify({ prompt: phrase }), '--format', 'json'],\n153:   { encoding: 'utf8', timeout: 60000 });\n154:   return stdout;\n155: }\n156: \n157: async function reaches(phrase, hub) {\n158:   let raw;\n159:   let lastErr;\n160:   for (let attempt = 1; attempt <= PROBE_ATTEMPTS; attempt += 1) {\n161:     try {\n162:       raw = await probeOnce(phrase);\n163:       lastErr = null;\n164:       break;\n165:     } catch (err) {\n166:       lastErr = err;\n167:       if (err.code !== RETRYABLE_EXIT) break;\n168:       // Back off enough for the contention that caused it to clear.\n169:       await sleep(250 * attempt);\n170:     }\n171:   }\n172:   if (lastErr) {\n173:     const detail = lastErr.stderr ? String(lastErr.stderr).trim().split('\\n')[0] : '';\n174:     const retried = lastErr.code === RETRYABLE_EXIT ? ` after ${PROBE_ATTEMPTS} attempts` : '';\n175:     return { error: `probe failed: ${lastErr.code || lastErr.message}${retried}${detail ? ` (${detail})` : ''}` };\n176:   }\n177:   let envelope;\n178:   try { envelope = JSON.parse(raw); } catch {\n179:     return { error: 'probe returned unparseable JSON' };\n180:   }\n181:   const data = envelope && typeof envelope === 'object' ? envelope.data : null;\n182:   if (!data) return { error: 'probe returned no data envelope' };\n183:   const trust = data.trustState;\n184:   if (envelope.degraded || trust?.state !== 'live' || !Number.isInteger(trust.generation)) {\n185:     return { error: 'advisor response is degraded, not live, or lacks generation' };\n186:   }\n187:   const bar = data.effectiveThresholds ? data.effectiveThresholds.confidenceThreshold : 0.8;\n188:   const above = (data.recommendations || []).filter((r) => r.confidence >= bar);\n189:   const generation = trust.generation;\n190:   // Presence above the bar is not routing. A hub sitting second behind a higher\n191:   // scorer never answers the request, so the declaring hub has to rank first in\n192:   // the shipped fleet for the phrase to count as reaching it.\n193:   return { ...rankShippedFleet(above, hub), generation };\n194: }\n195: \n196: // A standalone skill declares its phrases in its own ROUTER.md and has no hub\n197: // registry to list, so the fleet scan cannot see it at all. Naming it directly is\n198: // the only way its reach can be reported, and the folder name is the id the\n199: // advisor's recommendation list carries.\n200: function skillTarget(value) {\n201:   if (typeof value !== 'string' || value.trim() === '') {\n202:     process.stderr.write('ci-router-vocabulary-reach.cjs: --skill needs a skill name or path\\n');\n203:     process.exit(2);\n204:   }\n205:   const named = value.trim();\n206:   const directory = named.includes('/') || named.includes('\\\\')\n207:     ? path.resolve(named)\n208:     : path.join(SKILLS, named);\n209:   if (!fs.existsSync(path.join(directory, 'ROUTER.md'))) {\n210:     process.stderr.write(`ci-router-vocabulary-reach.cjs: no ROUTER.md under ${directory}\\n`);\n211:     process.exit(2);\n212:   }\n213:   return { hub: path.basename(directory), directory };\n214: }\n215: \n216: async function main() {\n217:   const args = process.argv.slice(2);\n218:   // A misspelled flag must fail loudly rather than fall back to a default run.\n219:   // Only a token in option position is checked: the token after a value-taking\n220:   // option is its value even when it begins with a dash.\n221:   const valueOptions = new Set(['--hub', '--limit', '--concurrency', '--skill']);\n222:   const knownOptions = new Set(['--json', ...valueOptions]);\n223:   for (let i = 0; i < args.length; i += 1) {\n224:     if (valueOptions.has(args[i])) {\n225:       i += 1;\n226:       continue;\n227:     }\n228:     if (!knownOptions.has(args[i]) && args[i].startsWith('-')) {\n229:       process.stderr.write(`ci-router-vocabulary-reach.cjs: unknown option: ${args[i]}\\n`);\n230:       process.exit(2);\n231:     }\n232:   }\n233:   const only = args.includes('--hub') ? args[args.indexOf('--hub') + 1] : null;\n234:   const skill = args.includes('--skill') ? args[args.indexOf('--skill') + 1] : null;\n235:   const limit = args.includes('--limit') ? Number(args[args.indexOf('--limit') + 1]) : Infinity;\n236:   const asJson = args.includes('--json');\n237: \n238:   // The fleet path answers \"which hub answers this\", the named path answers \"does\n239:   // this one root answer its own phrases\", so mixing them would print a row whose\n240:   // verdict nobody can read.\n241:   if (skill !== null && only) {\n242:     process.stderr.write('ci-router-vocabulary-reach.cjs: --hub and --skill probe different sets: pass one of them\\n');\n243:     process.exit(2);\n244:   }\n245: \n246:   // A truncated inventory proves only what it sampled, which is how phrases stay\n247:   // broken across green runs. Sampling stays available by hand and is refused\n248:   // wherever the result is read as a gate.\n249:   if (limit !== Infinity && process.env.CI) {\n250:     process.stderr.write('--limit is refused under CI: a sampled run cannot gate a build\\n');\n251:     process.exit(2);\n252:   }\n253: \n254:   const concurrency = args.includes('--concurrency')\n255:     ? Math.max(1, Number(args[args.indexOf('--concurrency') + 1]) || DEFAULT_CONCURRENCY)\n256:     : DEFAULT_CONCURRENCY;\n257: \n258:   const report = [];\n259:   let generation = null;\n260:   const targets = skill === null\n261:     ? hubs().map((hub) => ({ hub, directory: path.join(SKILLS, hub) }))\n262:     : [skillTarget(skill)];\n263:   for (const { hub, directory } of targets) {\n264:     if (only && hub !== only) continue;\n265:     const phrases = declaredPhrases(directory).slice(0, limit);\n266:     const unreachable = [];\n267:     // Probes overlap, but the report is emitted in declaration order, so a run is\n268:     // diffable against the previous one.\n269:     const probed = await pool(phrases, concurrency, (phrase) => reaches(phrase, hub));\n270:     for (let i = 0; i < phrases.length; i += 1) {\n271:       const phrase = phrases[i];\n272:       const r = probed[i];\n273:       if (r.generation != null) generation = r.generation;\n274:       if (r.error) {\n275:         unreachable.push({ phrase, kind: 'probe-error', reaches: [r.error] });\n276:         continue;\n277:       }\n278:       // The private surface is never named: its folder name stays on the machine\n279:       // that links it, so the row carries only its confidence.\n280:       if (r.hit && r.localAhead.length) {\n281:         unreachable.push({\n282:           phrase,\n283:           kind: 'operator-local',\n284:           reaches: [\n285:             ...r.localAhead.map((t) => `operator-local=${t.confidence.toFixed(4)}`),\n286:             ...r.top.slice(0, 1).map((t) => `${t.skillId}=${t.confidence.toFixed(4)}`),\n287:           ],\n288:         });\n289:         continue;\n290:       }\n291:       if (!r.hit) {\n292:         const winner = r.top.length ? r.top[0].skillId : null;\n293:         const allowed = winner ? allowedFor(hub, phrase, winner) : null;\n294:         // Three failures wearing one symptom. Another hub ranked first while this\n295:         // one never surfaced is a routing defect. This hub surfaced but lost the\n296:         // top slot is the same defect wearing a passing score. Nothing above the\n297:         // bar at all is usually length, which vocabulary does not fix.\n298:         unreachable.push({\n299:           phrase,\n300:           kind: allowed ? 'allowed' : (r.top.length ? (r.present ? 'outranked' : 'wrong-hub') : 'no-reach'),\n301:           reaches: r.top.map((t) => `${t.skillId}=${t.confidence.toFixed(4)}`),\n302:         });\n303:       }\n304:     }\n305:     // A hub whose router parsed to nothing is a broken extractor reading as a\n306:     // clean hub, so an empty inventory is a failure rather than a quiet zero.\n307:     if (phrases.length === 0) {\n308:       unreachable.push({ phrase: '(inventory)', kind: 'probe-error', reaches: ['router declared no multi-word phrases'] });\n309:     }\n310:     report.push({ hub, declared: phrases.length, unreachable });\n311:   }\n312: \n313:   if (asJson) {\n314:     process.stdout.write(`${JSON.stringify(report, null, 2)}\\n`);\n315:   } else {\n316:     for (const r of report) {\n317:       const errs = r.unreachable.filter((u) => u.kind === 'probe-error');\n318:       const wrong = r.unreachable.filter((u) => u.kind === 'wrong-hub');\n319:       const lost = r.unreachable.filter((u) => u.kind === 'outranked');\n320:       const none = r.unreachable.filter((u) => u.kind === 'no-reach');\n321:       const ok = r.unreachable.filter((u) => u.kind === 'allowed');\n322:       const local = r.unreachable.filter((u) => u.kind === 'operator-local');\n323:       const bad = errs.length + wrong.length + lost.length;\n324:       process.stdout.write(`${bad ? 'FAIL' : 'OK  '} ${r.hub.padEnd(28)} declared=${String(r.declared).padStart(3)} wrong-hub=${String(wrong.length).padStart(3)} outranked=${String(lost.length).padStart(3)} no-reach=${String(none.length).padStart(3)} allowed=${String(ok.length).padStart(3)} probe-error=${String(errs.length).padStart(3)} operator-local=${String(local.length).padStart(3)}\\n`);\n325:       for (const u of errs) {\n326:         process.stdout.write(`       probe-error ${u.phrase.padEnd(41)} ${u.reaches.join(', ')}\\n`);\n327:       }\n328:       for (const u of wrong) {\n329:         process.stdout.write(`       wrong-hub  ${u.phrase.padEnd(42)} ${u.reaches.join(', ')}\\n`);\n330:       }\n331:       for (const u of lost) {\n332:         process.stdout.write(`       outranked  ${u.phrase.padEnd(42)} ${u.reaches.join(', ')}\\n`);\n333:       }\n334:       for (const u of none) {\n335:         process.stdout.write(`       no-reach   ${u.phrase}\\n`);\n336:       }\n337:       for (const u of local) {\n338:         process.stdout.write(`       note       ${u.phrase.padEnd(42)} ${u.reaches.join(', ')} (ranks first on this machine only)\\n`);\n339:       }\n340:     }\n341:     const tally = (kind) => report.reduce((n, r) => n + r.unreachable.filter((u) => u.kind === kind).length, 0);\n342:     const errs = tally('probe-error');\n343:     const wrong = tally('wrong-hub');\n344:     const lost = tally('outranked');\n345:     const none = tally('no-reach');\n346:     const allowed = tally('allowed');\n347:     const local = tally('operator-local');\n348:     process.stdout.write(`\\nchecked=${report.length} hub(s), wrong-hub=${wrong}, outranked=${lost}, no-reach=${none}, allowed=${allowed}, probe-error=${errs}, operator-local=${local}\\n`);\n349:     process.stdout.write(`advisor generation: ${generation == null ? 'unknown' : generation}\\n`);\n350:     // A phrase that reaches nobody is reported rather than failed: it is usually a\n351:     // length limit, and failing on it would make the check unrunnable. Everything\n352:     // else is a real defect, and a probe that never ran is the worst of them,\n353:     // because it is the one that would otherwise print a pass.\n354:     process.stdout.write(errs + wrong + lost ? 'RESULT: FAILED\\n' : 'RESULT: PASSED\\n');\n355:   }\n356:   const failed = report.some((r) => r.unreachable.some((u) => !NON_FAILING.has(u.kind)));\n357:   process.exit(failed ? 1 : 0);\n358: }\n359: \n360: if (require.main === module) main();\n361: \n362: module.exports = { DEFAULT_CONCURRENCY };","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/sk-doc/sk-create-skill/scripts/ci-router-vocabulary-reach.cjs, lines 1-362\n1: #!/usr/bin/env node\n2: /**\n3:  * Check that a phrase a hub's router advertises actually reaches that hub.\n4:  *\n5:  * usage: ci-router-vocabulary-reach.cjs [--hub <id>] [--json] [--limit N]\n6:  *        [--concurrency N] [--skill <name-or-path>]\n7:  *\n8:  * A router's INTENT_SIGNALS resolves an intent inside a hub that has already been\n9:  * chosen. A hub's graph-metadata.json intent_signals is what decides which hub\n10:  * gets chosen. The two are not meant to match, so diffing them reports hundreds\n11:  * of differences that are not defects: a bare common word belongs in the first and\n12:  * would over-trigger in the second.\n13:  *\n14:  * The only thing that settles it is asking the advisor. This probes every\n15:  * multi-word phrase a router declares and reports the ones that do not reach the\n16:  * hub declaring them, which is the failure a diff cannot distinguish from design.\n17:  *\n18:  * Single words are skipped: they fail on length rather than on vocabulary, and\n19:  * reporting them buries the real cases.\n20:  */\n21: 'use strict';\n22: const fs = require('fs');\n23: const path = require('path');\n24: const { execFile } = require('child_process');\n25: const { promisify } = require('util');\n26: \n27: const execFileAsync = promisify(execFile);\n28: \n29: // Probing is the whole cost of this check, and it is spent waiting rather than\n30: // working: an uncached prompt takes about six seconds inside the advisor whichever\n31: // entry point asks, so the process spawn is noise. Sequentially that is over forty\n32: // minutes for the fleet, which is long enough that the check gets sampled instead\n33: // of run, and a sampled inventory is how phrases stayed broken across green runs.\n34: // The daemon serves concurrent callers, so the wait overlaps. The default is 2\n35: // rather than 8 because a busy advisor reported 11 to 13 probe-error rows at 8 and\n36: // none at 2, so concurrency was reading advisor load as unreachable phrases. The\n37: // measured price of the safer setting is about half a second per 48 cold probes.\n38: const DEFAULT_CONCURRENCY = 2;\n39: \n40: async function pool(items, limit, worker) {\n41:   const results = new Array(items.length);\n42:   let next = 0;\n43:   const runners = Array.from({ length: Math.min(limit, items.length) }, async () => {\n44:     for (let i = next++; i < items.length; i = next++) {\n45:       results[i] = await worker(items[i], i);\n46:     }\n47:   });\n48:   await Promise.all(runners);\n49:   return results;\n50: }\n51: \n52: const REPO_ROOT = path.resolve(__dirname, '..', '..', '..', '..', '..');\n53: const SKILLS = path.join(REPO_ROOT, '.skilled', 'skills');\n54: // Overridable so the fail-closed path can be exercised against an advisor that is\n55: // not there. A gate nobody can watch fail is a gate nobody knows the shape of.\n56: const ADVISOR = process.env.ROUTER_REACH_ADVISOR\n57:   || path.join(REPO_ROOT, '.skilled', 'bin', 'skill-advisor.cjs');\n58: \n59: // Known ownership disputes the check may pass over. An entry pins the winner as\n60: // well as the phrase, so an allowed phrase that starts losing to somebody NEW still\n61: // fails: a blanket pass on the phrase would reintroduce the exact blindness this\n62: // check was written to remove.\n63: const ALLOWLIST_PATH = path.join(__dirname, 'router-reach-allowlist.json');\n64: \n65: function allowlist() {\n66:   if (!fs.existsSync(ALLOWLIST_PATH)) return new Map();\n67:   const raw = JSON.parse(fs.readFileSync(ALLOWLIST_PATH, 'utf8'));\n68:   return new Map((raw.entries || []).map((e) => [`${e.declaredBy}\\u0000${e.phrase}`, e]));\n69: }\n70: \n71: const ALLOWED = allowlist();\n72: \n73: function allowedFor(hub, phrase, winner) {\n74:   const e = ALLOWED.get(`${hub}\\u0000${phrase}`);\n75:   return e && e.wonBy === winner ? e : null;\n76: }\n77: \n78: // An operator can link private skills into the skills root under this prefix, and\n79: // the advisor scores one whenever its link resolves inside a trusted root\n80: // (system-skill-advisor/runtime/lib/private-skill-target.cjs). The tracked tree\n81: // ignores every such entry, so CI never has one. This check gates the shipped\n82: // fleet: a verdict that flips with what one machine happens to link cannot be\n83: // fixed in the tracked tree, and the allowlist could not name the winner without\n84: // leaking a private name. A private surface that ranks ahead of the shipped\n85: // leader is still reported, as a note that never fails the run, because on that\n86: // machine it really does take the phrase.\n87: const PRIVATE_SKILL_PREFIX = 'local-';\n88: \n89: function isOperatorLocal(skillId) {\n90:   return typeof skillId === 'string' && skillId.startsWith(PRIVATE_SKILL_PREFIX);\n91: }\n92: \n93: // Ranks the shipped fleet out of one passing-recommendation list, and keeps the\n94: // confidence of every private surface that sat ahead of the shipped leader.\n95: function rankShippedFleet(above, hub) {\n96:   const shipped = above.filter((r) => !isOperatorLocal(r.skillId));\n97:   const leaderAt = shipped.length ? above.indexOf(shipped[0]) : above.length;\n98:   return {\n99:     hit: shipped.length > 0 && shipped[0].skillId === hub,\n100:     present: shipped.some((r) => r.skillId === hub),\n101:     top: shipped.slice(0, 2),\n102:     localAhead: above.slice(0, leaderAt).filter((r) => isOperatorLocal(r.skillId)),\n103:   };\n104: }\n105: \n106: // Kinds reported for a human and never failed: a length limit, a pinned dispute,\n107: // and a private surface the tracked tree does not own.\n108: const NON_FAILING = new Set(['no-reach', 'allowed', 'operator-local']);\n109: \n110: function hubs() {\n111:   return fs.readdirSync(SKILLS, { withFileTypes: true })\n112:     .filter((e) => e.isDirectory())\n113:     .map((e) => e.name)\n114:     .filter((n) => fs.existsSync(path.join(SKILLS, n, 'mode-registry.json'))\n115:       && fs.existsSync(path.join(SKILLS, n, 'ROUTER.md')))\n116:     .sort();\n117: }\n118: \n119: function declaredPhrases(directory) {\n120:   const text = fs.readFileSync(path.join(directory, 'ROUTER.md'), 'utf8');\n121:   const block = /INTENT_SIGNALS\\s*=\\s*\\{([\\s\\S]*?)\\n\\}/.exec(text);\n122:   if (!block) return [];\n123:   const found = [...block[1].matchAll(/\"([^\"]{3,60})\"/g)].map((m) => m[1]);\n124:   return [...new Set(found.filter((k) => (\n125:     // a single token fails on length, not on vocabulary; reporting it buries the rest\n126:     k.includes(' ')\n127:     // a quote-delimited match is not always a phrase. Where a router formats its\n128:     // block across lines, the text between two quoted keywords is punctuation and\n129:     // structure, and probing it wastes a call and prints a row nobody can act on.\n130:     && /^[a-z0-9]/i.test(k)\n131:     && !/[{}[\\]]/.test(k)\n132:     && !/^(weight|keywords)$/i.test(k)\n133:   )))];\n134: }\n135: \n136: // A probe that could not run is not a phrase that reached nobody. Collapsing the\n137: // two lets a missing binary, a non-zero exit, a timeout or a cold daemon print a\n138: // clean pass over an advisor that never answered, so every failure to ask is\n139: // returned as its own result and fails the run.\n140: // The advisor exits 75 to say \"temporary, ask again\", and overlapping probes\n141: // provoke it: the same phrases that fail in a concurrent sweep answer correctly one\n142: // at a time. Reporting that as a defect would trade the old false green for a false\n143: // red, so a retryable exit is retried before it is believed. Anything else is a\n144: // real failure and is returned on the first try.\n145: const RETRYABLE_EXIT = 75;\n146: const PROBE_ATTEMPTS = 3;\n147: \n148: const sleep = (ms) => new Promise((r) => { setTimeout(r, ms); });\n149: \n150: async function probeOnce(phrase) {\n151:   const { stdout } = await execFileAsync('node', [ADVISOR, 'advisor_recommend', '--json',\n152:     JSON.stringify({ prompt: phrase }), '--format', 'json'],\n153:   { encoding: 'utf8', timeout: 60000 });\n154:   return stdout;\n155: }\n156: \n157: async function reaches(phrase, hub) {\n158:   let raw;\n159:   let lastErr;\n160:   for (let attempt = 1; attempt <= PROBE_ATTEMPTS; attempt += 1) {\n161:     try {\n162:       raw = await probeOnce(phrase);\n163:       lastErr = null;\n164:       break;\n165:     } catch (err) {\n166:       lastErr = err;\n167:       if (err.code !== RETRYABLE_EXIT) break;\n168:       // Back off enough for the contention that caused it to clear.\n169:       await sleep(250 * attempt);\n170:     }\n171:   }\n172:   if (lastErr) {\n173:     const detail = lastErr.stderr ? String(lastErr.stderr).trim().split('\\n')[0] : '';\n174:     const retried = lastErr.code === RETRYABLE_EXIT ? ` after ${PROBE_ATTEMPTS} attempts` : '';\n175:     return { error: `probe failed: ${lastErr.code || lastErr.message}${retried}${detail ? ` (${detail})` : ''}` };\n176:   }\n177:   let envelope;\n178:   try { envelope = JSON.parse(raw); } catch {\n179:     return { error: 'probe returned unparseable JSON' };\n180:   }\n181:   const data = envelope && typeof envelope === 'object' ? envelope.data : null;\n182:   if (!data) return { error: 'probe returned no data envelope' };\n183:   const trust = data.trustState;\n184:   if (envelope.degraded || trust?.state !== 'live' || !Number.isInteger(trust.generation)) {\n185:     return { error: 'advisor response is degraded, not live, or lacks generation' };\n186:   }\n187:   const bar = data.effectiveThresholds ? data.effectiveThresholds.confidenceThreshold : 0.8;\n188:   const above = (data.recommendations || []).filter((r) => r.confidence >= bar);\n189:   const generation = trust.generation;\n190:   // Presence above the bar is not routing. A hub sitting second behind a higher\n191:   // scorer never answers the request, so the declaring hub has to rank first in\n192:   // the shipped fleet for the phrase to count as reaching it.\n193:   return { ...rankShippedFleet(above, hub), generation };\n194: }\n195: \n196: // A standalone skill declares its phrases in its own ROUTER.md and has no hub\n197: // registry to list, so the fleet scan cannot see it at all. Naming it directly is\n198: // the only way its reach can be reported, and the folder name is the id the\n199: // advisor's recommendation list carries.\n200: function skillTarget(value) {\n201:   if (typeof value !== 'string' || value.trim() === '') {\n202:     process.stderr.write('ci-router-vocabulary-reach.cjs: --skill needs a skill name or path\\n');\n203:     process.exit(2);\n204:   }\n205:   const named = value.trim();\n206:   const directory = named.includes('/') || named.includes('\\\\')\n207:     ? path.resolve(named)\n208:     : path.join(SKILLS, named);\n209:   if (!fs.existsSync(path.join(directory, 'ROUTER.md'))) {\n210:     process.stderr.write(`ci-router-vocabulary-reach.cjs: no ROUTER.md under ${directory}\\n`);\n211:     process.exit(2);\n212:   }\n213:   return { hub: path.basename(directory), directory };\n214: }\n215: \n216: async function main() {\n217:   const args = process.argv.slice(2);\n218:   // A misspelled flag must fail loudly rather than fall back to a default run.\n219:   // Only a token in option position is checked: the token after a value-taking\n220:   // option is its value even when it begins with a dash.\n221:   const valueOptions = new Set(['--hub', '--limit', '--concurrency', '--skill']);\n222:   const knownOptions = new Set(['--json', ...valueOptions]);\n223:   for (let i = 0; i < args.length; i += 1) {\n224:     if (valueOptions.has(args[i])) {\n225:       i += 1;\n226:       continue;\n227:     }\n228:     if (!knownOptions.has(args[i]) && args[i].startsWith('-')) {\n229:       process.stderr.write(`ci-router-vocabulary-reach.cjs: unknown option: ${args[i]}\\n`);\n230:       process.exit(2);\n231:     }\n232:   }\n233:   const only = args.includes('--hub') ? args[args.indexOf('--hub') + 1] : null;\n234:   const skill = args.includes('--skill') ? args[args.indexOf('--skill') + 1] : null;\n235:   const limit = args.includes('--limit') ? Number(args[args.indexOf('--limit') + 1]) : Infinity;\n236:   const asJson = args.includes('--json');\n237: \n238:   // The fleet path answers \"which hub answers this\", the named path answers \"does\n239:   // this one root answer its own phrases\", so mixing them would print a row whose\n240:   // verdict nobody can read.\n241:   if (skill !== null && only) {\n242:     process.stderr.write('ci-router-vocabulary-reach.cjs: --hub and --skill probe different sets: pass one of them\\n');\n243:     process.exit(2);\n244:   }\n245: \n246:   // A truncated inventory proves only what it sampled, which is how phrases stay\n247:   // broken across green runs. Sampling stays available by hand and is refused\n248:   // wherever the result is read as a gate.\n249:   if (limit !== Infinity && process.env.CI) {\n250:     process.stderr.write('--limit is refused under CI: a sampled run cannot gate a build\\n');\n251:     process.exit(2);\n252:   }\n253: \n254:   const concurrency = args.includes('--concurrency')\n255:     ? Math.max(1, Number(args[args.indexOf('--concurrency') + 1]) || DEFAULT_CONCURRENCY)\n256:     : DEFAULT_CONCURRENCY;\n257: \n258:   const report = [];\n259:   let generation = null;\n260:   const targets = skill === null\n261:     ? hubs().map((hub) => ({ hub, directory: path.join(SKILLS, hub) }))\n262:     : [skillTarget(skill)];\n263:   for (const { hub, directory } of targets) {\n264:     if (only && hub !== only) continue;\n265:     const phrases = declaredPhrases(directory).slice(0, limit);\n266:     const unreachable = [];\n267:     // Probes overlap, but the report is emitted in declaration order, so a run is\n268:     // diffable against the previous one.\n269:     const probed = await pool(phrases, concurrency, (phrase) => reaches(phrase, hub));\n270:     for (let i = 0; i < phrases.length; i += 1) {\n271:       const phrase = phrases[i];\n272:       const r = probed[i];\n273:       if (r.generation != null) generation = r.generation;\n274:       if (r.error) {\n275:         unreachable.push({ phrase, kind: 'probe-error', reaches: [r.error] });\n276:         continue;\n277:       }\n278:       // The private surface is never named: its folder name stays on the machine\n279:       // that links it, so the row carries only its confidence.\n280:       if (r.hit && r.localAhead.length) {\n281:         unreachable.push({\n282:           phrase,\n283:           kind: 'operator-local',\n284:           reaches: [\n285:             ...r.localAhead.map((t) => `operator-local=${t.confidence.toFixed(4)}`),\n286:             ...r.top.slice(0, 1).map((t) => `${t.skillId}=${t.confidence.toFixed(4)}`),\n287:           ],\n288:         });\n289:         continue;\n290:       }\n291:       if (!r.hit) {\n292:         const winner = r.top.length ? r.top[0].skillId : null;\n293:         const allowed = winner ? allowedFor(hub, phrase, winner) : null;\n294:         // Three failures wearing one symptom. Another hub ranked first while this\n295:         // one never surfaced is a routing defect. This hub surfaced but lost the\n296:         // top slot is the same defect wearing a passing score. Nothing above the\n297:         // bar at all is usually length, which vocabulary does not fix.\n298:         unreachable.push({\n299:           phrase,\n300:           kind: allowed ? 'allowed' : (r.top.length ? (r.present ? 'outranked' : 'wrong-hub') : 'no-reach'),\n301:           reaches: r.top.map((t) => `${t.skillId}=${t.confidence.toFixed(4)}`),\n302:         });\n303:       }\n304:     }\n305:     // A hub whose router parsed to nothing is a broken extractor reading as a\n306:     // clean hub, so an empty inventory is a failure rather than a quiet zero.\n307:     if (phrases.length === 0) {\n308:       unreachable.push({ phrase: '(inventory)', kind: 'probe-error', reaches: ['router declared no multi-word phrases'] });\n309:     }\n310:     report.push({ hub, declared: phrases.length, unreachable });\n311:   }\n312: \n313:   if (asJson) {\n314:     process.stdout.write(`${JSON.stringify(report, null, 2)}\\n`);\n315:   } else {\n316:     for (const r of report) {\n317:       const errs = r.unreachable.filter((u) => u.kind === 'probe-error');\n318:       const wrong = r.unreachable.filter((u) => u.kind === 'wrong-hub');\n319:       const lost = r.unreachable.filter((u) => u.kind === 'outranked');\n320:       const none = r.unreachable.filter((u) => u.kind === 'no-reach');\n321:       const ok = r.unreachable.filter((u) => u.kind === 'allowed');\n322:       const local = r.unreachable.filter((u) => u.kind === 'operator-local');\n323:       const bad = errs.length + wrong.length + lost.length;\n324:       process.stdout.write(`${bad ? 'FAIL' : 'OK  '} ${r.hub.padEnd(28)} declared=${String(r.declared).padStart(3)} wrong-hub=${String(wrong.length).padStart(3)} outranked=${String(lost.length).padStart(3)} no-reach=${String(none.length).padStart(3)} allowed=${String(ok.length).padStart(3)} probe-error=${String(errs.length).padStart(3)} operator-local=${String(local.length).padStart(3)}\\n`);\n325:       for (const u of errs) {\n326:         process.stdout.write(`       probe-error ${u.phrase.padEnd(41)} ${u.reaches.join(', ')}\\n`);\n327:       }\n328:       for (const u of wrong) {\n329:         process.stdout.write(`       wrong-hub  ${u.phrase.padEnd(42)} ${u.reaches.join(', ')}\\n`);\n330:       }\n331:       for (const u of lost) {\n332:         process.stdout.write(`       outranked  ${u.phrase.padEnd(42)} ${u.reaches.join(', ')}\\n`);\n333:       }\n334:       for (const u of none) {\n335:         process.stdout.write(`       no-reach   ${u.phrase}\\n`);\n336:       }\n337:       for (const u of local) {\n338:         process.stdout.write(`       note       ${u.phrase.padEnd(42)} ${u.reaches.join(', ')} (ranks first on this machine only)\\n`);\n339:       }\n340:     }\n341:     const tally = (kind) => report.reduce((n, r) => n + r.unreachable.filter((u) => u.kind === kind).length, 0);\n342:     const errs = tally('probe-error');\n343:     const wrong = tally('wrong-hub');\n344:     const lost = tally('outranked');\n345:     const none = tally('no-reach');\n346:     const allowed = tally('allowed');\n347:     const local = tally('operator-local');\n348:     process.stdout.write(`\\nchecked=${report.length} hub(s), wrong-hub=${wrong}, outranked=${lost}, no-reach=${none}, allowed=${allowed}, probe-error=${errs}, operator-local=${local}\\n`);\n349:     process.stdout.write(`advisor generation: ${generation == null ? 'unknown' : generation}\\n`);\n350:     // A phrase that reaches nobody is reported rather than failed: it is usually a\n351:     // length limit, and failing on it would make the check unrunnable. Everything\n352:     // else is a real defect, and a probe that never ran is the worst of them,\n353:     // because it is the one that would otherwise print a pass.\n354:     process.stdout.write(errs + wrong + lost ? 'RESULT: FAILED\\n' : 'RESULT: PASSED\\n');\n355:   }\n356:   const failed = report.some((r) => r.unreachable.some((u) => !NON_FAILING.has(u.kind)));\n357:   process.exit(failed ? 1 : 0);\n358: }\n359: \n360: if (require.main === module) main();\n361: \n362: module.exports = { DEFAULT_CONCURRENCY };"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/sk-doc/sk-create-skill/scripts/ci-router-vocabulary-reach.cjs\"}"},"time":{"start":1794526605117,"end":1794526606751}}}}
{"type":"tool_use","timestamp":1794526607001,"sessionID":"ses_e2de199bcffenOc4bBZXnEEa5a","part":{"partID":"prt_1d21ef10d001LGnpS7tK8N27dU","sessionID":"ses_e2de199bcffenOc4bBZXnEEa5a","messageID":"msg_1d21ee0ee001EgqYZCBrSvYIti","type":"tool","id":"call_bf10599a4d6f4c96a494e9c0","tool":"shell","state":{"status":"completed","input":{"command":"node .skilled/skills/system-spec-kit/runtime/cli/retrieval/lookup-trigger-index.mjs --json --scoring-only -- \"In rankShippedFleet set hit and present true when shipped skillId or ownerSkillId equals hub, router reach shipped-fleet ranking\" 2>&1 | head -50","workdir":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research"},"output":"{\n  \"candidatePhraseCount\": 4365,\n  \"discardedTokens\": [\n    {\n      \"reason\": \"below-min-token-length\",\n      \"token\": \"in\"\n    },\n    {\n      \"reason\": \"below-min-token-length\",\n      \"token\": \"or\"\n    },\n    {\n      \"reason\": \"beyond-max-query-tokens\",\n      \"token\": \"skillid\"\n    },\n    {\n      \"reason\": \"beyond-max-query-tokens\",\n      \"token\": \"ownerskillid\"\n    },\n    {\n      \"reason\": \"beyond-max-query-tokens\",\n      \"token\": \"equals\"\n    },\n    {\n      \"reason\": \"beyond-max-query-tokens\",\n      \"token\": \"hub\"\n    },\n    {\n      \"reason\": \"beyond-max-query-tokens\",\n      \"token\": \"router\"\n    },\n    {\n      \"reason\": \"beyond-max-query-tokens\",\n      \"token\": \"reach\"\n    },\n    {\n      \"reason\": \"beyond-max-query-tokens\",\n      \"token\": \"fleet\"\n    },\n    {\n      \"reason\": \"beyond-max-query-tokens\",\n      \"token\": \"ranking\"\n    }\n  ],\n  \"indexHash\": \"cac6622b1df8eae3cf5fe37681108fd2e890dfeb637c88211608313d0c4227cd\",\n  \"manifestHash\": \"c243be4138be26b030af5a965ddc587955809ebe6ccd694e69601c9e81a327a8\",\n  \"normalizedQuery\": \"in rankshippedfleet set hit and present true when shipped skillid or ownerskillid equals hub router reach shipped fleet ranking\",\n  \"results\": [\n    {\n      \"matchClass\": \"query-containment\",\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"{\n  \"candidatePhraseCount\": 4365,\n  \"discardedTokens\": [\n    {\n      \"reason\": \"below-min-token-length\",\n      \"token\": \"in\"\n    },\n    {\n      \"reason\": \"below-min-token-length\",\n      \"token\": \"or\"\n    },\n    {\n      \"reason\": \"beyond-max-query-tokens\",\n      \"token\": \"skillid\"\n    },\n    {\n      \"reason\": \"beyond-max-query-tokens\",\n      \"token\": \"ownerskillid\"\n    },\n    {\n      \"reason\": \"beyond-max-query-tokens\",\n      \"token\": \"equals\"\n    },\n    {\n      \"reason\": \"beyond-max-query-tokens\",\n      \"token\": \"hub\"\n    },\n    {\n      \"reason\": \"beyond-max-query-tokens\",\n      \"token\": \"router\"\n    },\n    {\n      \"reason\": \"beyond-max-query-tokens\",\n      \"token\": \"reach\"\n    },\n    {\n      \"reason\": \"beyond-max-query-tokens\",\n      \"token\": \"fleet\"\n    },\n    {\n      \"reason\": \"beyond-max-query-tokens\",\n      \"token\": \"ranking\"\n    }\n  ],\n  \"indexHash\": \"cac6622b1df8eae3cf5fe37681108fd2e890dfeb637c88211608313d0c4227cd\",\n  \"manifestHash\": \"c243be4138be26b030af5a965ddc587955809ebe6ccd694e69601c9e81a327a8\",\n  \"normalizedQuery\": \"in rankshippedfleet set hit and present true when shipped skillid or ownerskillid equals hub router reach shipped fleet ranking\",\n  \"results\": [\n    {\n      \"matchClass\": \"query-containment\",\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"node .skilled/skills/system-spec-kit/runtime/cli/retrieval/lookup-trigger-index.mjs --json --scoring-only -- \\\"In rankShippedFleet set hit and present true when shipped skillId or ownerSkillId equals hub, router reach shipped-fleet ranking\\\" 2>&1 | head -50\",\"workdir\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research\"}"},"time":{"start":1794526605581,"end":1794526607001}}}}
