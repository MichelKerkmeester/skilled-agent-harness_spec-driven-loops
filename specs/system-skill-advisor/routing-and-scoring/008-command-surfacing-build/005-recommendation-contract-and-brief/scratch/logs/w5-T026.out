-check-coat-hooks',\n136:     },\n137:   ])('keeps the plain no-match head for check wording with no tooling context: \"$prompt\"', async ({ prompt, sessionId }) => {\n138:     const { output } = await runHook(promptInput(prompt, sessionId), NO_MATCH_RESULT);\n139: \n140:     expect(additionalContext(output)).toBe(EXPECTED_NO_MATCH_CONTEXT);\n141:   });\n142: \n143:   it('keeps setup wording checks bounded for long sequences of check terms', () => {\n144:     expect(SETUP_WORDING.test(\n145:       'check '.repeat(5000) + 'x'.repeat(100000),\n146:     )).toBe(false);\n147:   });\n148: \n149:   it('appends the unchanged directive block after the setup hint head', async () => {\n150:     const { output } = await runHook(promptInput('Help me set up skilled', 'setup-hint-directive-block'), NO_MATCH_RESULT);\n151: \n152:     expect(additionalContext(output).slice(EXPECTED_SETUP_HEAD.length)).toBe(EXPECTED_FALLBACK_DIRECTIVES);\n153:   });\n154: });"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/tests/hooks/doctor-setup-hint.vitest.ts\"}"},"time":{"start":1794527790144,"end":1794527790544}}}}
