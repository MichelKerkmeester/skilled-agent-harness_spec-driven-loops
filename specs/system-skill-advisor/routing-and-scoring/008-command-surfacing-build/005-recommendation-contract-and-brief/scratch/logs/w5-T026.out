{"type":"tool_use","timestamp":1794527772334,"sessionID":"ses_e2dd1151dffe0h3yPjoMzUI7N6","part":{"partID":"prt_1d230bd020021UkWJKZPjcbuJw","sessionID":"ses_e2dd1151dffe0h3yPjoMzUI7N6","messageID":"msg_1d230af96001rDh33cMJkQfBUE","type":"tool","id":"call_ec0e2485c75b4e0797708e0d","tool":"read","state":{"status":"completed","input":{"path":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/tests/hooks/runtime-parity.vitest.ts"},"output":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/tests/hooks/runtime-parity.vitest.ts, lines 1-106\n1: // ───────────────────────────────────────────────────────────────────\n2: // MODULE: Runtime Parity Tests — Advisor brief shape across runtimes\n3: // ───────────────────────────────────────────────────────────────────\n4: // Asserts that buildSkillAdvisorBrief produces a consistent brief\n5: // shape regardless of the runtime tag (claude, opencode, opencode).\n6: // The brief is rendered via renderAdvisorBrief; the test verifies:\n7: //   - Brief is non-null and contains \"Advisor:\" marker\n8: //   - Brief contains the expected skill slug\n9: //   - Brief has the expected confidence/uncertainty pattern\n10: //   - Tolerance: byte-equivalent skill slug, ±0.01 confidence\n11: \n12: import { readFileSync } from 'node:fs';\n13: import { join } from 'node:path';\n14: import { describe, expect, it, vi } from 'vitest';\n15: import { buildSkillAdvisorBrief } from '../../lib/skill-advisor-brief.js';\n16: import { renderAdvisorBrief } from '../../lib/render.js';\n17: import type { AdvisorHookResult } from '../../lib/skill-advisor-brief.js';\n18: \n19: const fixturesDir = join(import.meta.dirname, '..', 'legacy', 'advisor-fixtures');\n20: \n21: function fixture(name: string): AdvisorHookResult {\n22:   return JSON.parse(readFileSync(join(fixturesDir, name), 'utf8')) as AdvisorHookResult;\n23: }\n24: \n25: const RUNTIMES = ['claude', 'opencode', 'opencode'] as const;\n26: \n27: describe('3-runtime advisor brief parity', () => {\n28:   it('produces byte-equivalent brief for a known passing fixture across all 3 runtimes', async () => {\n29:     const fixtureResult = fixture('livePassingSkill.json');\n30:     const prompt = 'implement a TypeScript hook';\n31: \n32:     for (const runtime of RUNTIMES) {\n33:       const buildBrief = vi.fn(async () => ({\n34:         ...fixtureResult,\n35:         sharedPayload: {\n36:           ...fixtureResult.sharedPayload,\n37:           metadata: {\n38:             ...fixtureResult.sharedPayload?.metadata,\n39:             skillLabel: 'sk-code',\n40:           },\n41:         },\n42:       }));\n43: \n44:       const result = await buildBrief(prompt, {\n45:         runtime,\n46:         workspaceRoot: process.cwd(),\n47:       });\n48: \n49:       const brief = renderAdvisorBrief(result);\n50: \n51:       expect(brief, `runtime ${runtime} should produce a brief`).not.toBeNull();\n52:       expect(brief, `runtime ${runtime} brief should contain Advisor marker`).toContain('Advisor:');\n53:       expect(brief, `runtime ${runtime} brief should contain skill slug`).toContain('sk-code');\n54:       expect(brief, `runtime ${runtime} brief should have confidence/uncertainty pattern`).toMatch(/\\d+\\.\\d{2}\\/\\d+\\.\\d{2} pass\\./);\n55:     }\n56:   });\n57: \n58:   it('returns empty brief for skipped fixture across all 3 runtimes', async () => {\n59:     const fixtureResult = fixture('skippedShortCasual.json');\n60:     const prompt = 'hello';\n61: \n62:     for (const runtime of RUNTIMES) {\n63:       const buildBrief = vi.fn(async () => fixtureResult);\n64: \n65:       const result = await buildBrief(prompt, {\n66:         runtime,\n67:         workspaceRoot: process.cwd(),\n68:       });\n69: \n70:       const brief = renderAdvisorBrief(result);\n71:       expect(brief, `runtime ${runtime} should return null for skipped`).toBeNull();\n72:     }\n73:   });\n74: \n75:   it('fails open on parse failure across all 3 runtimes', async () => {\n76:     const buildBrief = vi.fn(async (): Promise<AdvisorHookResult> => ({\n77:       status: 'fail_open',\n78:       freshness: 'unavailable',\n79:       brief: null,\n80:       recommendations: [],\n81:       diagnostics: null,\n82:       metrics: { durationMs: 0, cacheHit: false, subprocessInvoked: false, retriesAttempted: 0, recommendationCount: 0, tokenCap: 80 },\n83:       generatedAt: new Date().toISOString(),\n84:       sharedPayload: null,\n85:     }));\n86: \n87:     for (const runtime of RUNTIMES) {\n88:       const result = await buildBrief('', {\n89:         runtime,\n90:         workspaceRoot: process.cwd(),\n91:       });\n92:       expect(result.status, `runtime ${runtime} should fail open`).toBe('fail_open');\n93:       expect(renderAdvisorBrief(result), `runtime ${runtime} fail_open brief`).toBeNull();\n94:     }\n95:   });\n96: \n97:   it('accepts opencode runtime tag in buildSkillAdvisorBrief options', async () => {\n98:     const prompt = 'implement OAuth login flow';\n99:     const result = await buildSkillAdvisorBrief(prompt, {\n100:       runtime: 'opencode',\n101:       workspaceRoot: process.cwd(),\n102:     });\n103:     expect(result).toBeDefined();\n104:     expect(typeof result.status).toBe('string');\n105:   });\n106: });","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/tests/hooks/runtime-parity.vitest.ts, lines 1-106\n1: // ───────────────────────────────────────────────────────────────────\n2: // MODULE: Runtime Parity Tests — Advisor brief shape across runtimes\n3: // ───────────────────────────────────────────────────────────────────\n4: // Asserts that buildSkillAdvisorBrief produces a consistent brief\n5: // shape regardless of the runtime tag (claude, opencode, opencode).\n6: // The brief is rendered via renderAdvisorBrief; the test verifies:\n7: //   - Brief is non-null and contains \"Advisor:\" marker\n8: //   - Brief contains the expected skill slug\n9: //   - Brief has the expected confidence/uncertainty pattern\n10: //   - Tolerance: byte-equivalent skill slug, ±0.01 confidence\n11: \n12: import { readFileSync } from 'node:fs';\n13: import { join } from 'node:path';\n14: import { describe, expect, it, vi } from 'vitest';\n15: import { buildSkillAdvisorBrief } from '../../lib/skill-advisor-brief.js';\n16: import { renderAdvisorBrief } from '../../lib/render.js';\n17: import type { AdvisorHookResult } from '../../lib/skill-advisor-brief.js';\n18: \n19: const fixturesDir = join(import.meta.dirname, '..', 'legacy', 'advisor-fixtures');\n20: \n21: function fixture(name: string): AdvisorHookResult {\n22:   return JSON.parse(readFileSync(join(fixturesDir, name), 'utf8')) as AdvisorHookResult;\n23: }\n24: \n25: const RUNTIMES = ['claude', 'opencode', 'opencode'] as const;\n26: \n27: describe('3-runtime advisor brief parity', () => {\n28:   it('produces byte-equivalent brief for a known passing fixture across all 3 runtimes', async () => {\n29:     const fixtureResult = fixture('livePassingSkill.json');\n30:     const prompt = 'implement a TypeScript hook';\n31: \n32:     for (const runtime of RUNTIMES) {\n33:       const buildBrief = vi.fn(async () => ({\n34:         ...fixtureResult,\n35:         sharedPayload: {\n36:           ...fixtureResult.sharedPayload,\n37:           metadata: {\n38:             ...fixtureResult.sharedPayload?.metadata,\n39:             skillLabel: 'sk-code',\n40:           },\n41:         },\n42:       }));\n43: \n44:       const result = await buildBrief(prompt, {\n45:         runtime,\n46:         workspaceRoot: process.cwd(),\n47:       });\n48: \n49:       const brief = renderAdvisorBrief(result);\n50: \n51:       expect(brief, `runtime ${runtime} should produce a brief`).not.toBeNull();\n52:       expect(brief, `runtime ${runtime} brief should contain Advisor marker`).toContain('Advisor:');\n53:       expect(brief, `runtime ${runtime} brief should contain skill slug`).toContain('sk-code');\n54:       expect(brief, `runtime ${runtime} brief should have confidence/uncertainty pattern`).toMatch(/\\d+\\.\\d{2}\\/\\d+\\.\\d{2} pass\\./);\n55:     }\n56:   });\n57: \n58:   it('returns empty brief for skipped fixture across all 3 runtimes', async () => {\n59:     const fixtureResult = fixture('skippedShortCasual.json');\n60:     const prompt = 'hello';\n61: \n62:     for (const runtime of RUNTIMES) {\n63:       const buildBrief = vi.fn(async () => fixtureResult);\n64: \n65:       const result = await buildBrief(prompt, {\n66:         runtime,\n67:         workspaceRoot: process.cwd(),\n68:       });\n69: \n70:       const brief = renderAdvisorBrief(result);\n71:       expect(brief, `runtime ${runtime} should return null for skipped`).toBeNull();\n72:     }\n73:   });\n74: \n75:   it('fails open on parse failure across all 3 runtimes', async () => {\n76:     const buildBrief = vi.fn(async (): Promise<AdvisorHookResult> => ({\n77:       status: 'fail_open',\n78:       freshness: 'unavailable',\n79:       brief: null,\n80:       recommendations: [],\n81:       diagnostics: null,\n82:       metrics: { durationMs: 0, cacheHit: false, subprocessInvoked: false, retriesAttempted: 0, recommendationCount: 0, tokenCap: 80 },\n83:       generatedAt: new Date().toISOString(),\n84:       sharedPayload: null,\n85:     }));\n86: \n87:     for (const runtime of RUNTIMES) {\n88:       const result = await buildBrief('', {\n89:         runtime,\n90:         workspaceRoot: process.cwd(),\n91:       });\n92:       expect(result.status, `runtime ${runtime} should fail open`).toBe('fail_open');\n93:       expect(renderAdvisorBrief(result), `runtime ${runtime} fail_open brief`).toBeNull();\n94:     }\n95:   });\n96: \n97:   it('accepts opencode runtime tag in buildSkillAdvisorBrief options', async () => {\n98:     const prompt = 'implement OAuth login flow';\n99:     const result = await buildSkillAdvisorBrief(prompt, {\n100:       runtime: 'opencode',\n101:       workspaceRoot: process.cwd(),\n102:     });\n103:     expect(result).toBeDefined();\n104:     expect(typeof result.status).toBe('string');\n105:   });\n106: });"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/tests/hooks/runtime-parity.vitest.ts\"}"},"time":{"start":1794527771906,"end":1794527772334}}}}
