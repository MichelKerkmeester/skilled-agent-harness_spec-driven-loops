{"type":"tool_use","timestamp":1794527790544,"sessionID":"ses_e2dd1151dffe0h3yPjoMzUI7N6","part":{"partID":"prt_1d2310440002rlP3ikaTW7KIWO","sessionID":"ses_e2dd1151dffe0h3yPjoMzUI7N6","messageID":"msg_1d230ee2b001UfmxlTLTqMCZrD","type":"tool","id":"call_f9717283ddf64c7cb10564ba","tool":"read","state":{"status":"completed","input":{"path":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/tests/hooks/doctor-setup-hint.vitest.ts"},"output":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/tests/hooks/doctor-setup-hint.vitest.ts, lines 1-154\n1: // ───────────────────────────────────────────────────────────────────\n2: // MODULE: Doctor setup hint hook tests\n3: // ───────────────────────────────────────────────────────────────────\n4: \n5: import { readFileSync } from 'node:fs';\n6: import { join } from 'node:path';\n7: import { afterEach, describe, expect, it, vi } from 'vitest';\n8: import {\n9:   handleClaudeUserPromptSubmit,\n10:   SETUP_WORDING,\n11:   type ClaudeUserPromptSubmitInput,\n12:   type ClaudeUserPromptSubmitOutput,\n13: } from '../../../hooks/claude/user-prompt-submit.js';\n14: import {\n15:   DIRECTIVE_LIFECYCLE_DEDUP_ENV,\n16:   InMemoryDirectiveLifecycleStore,\n17: } from '../../../hooks/lib/directive-lifecycle.js';\n18: import { renderAdvisorBrief, renderAdvisorFallbackDirective } from '../../lib/render.js';\n19: import type { AdvisorHookResult } from '../../lib/skill-advisor-brief.js';\n20: \n21: const fixturesDir = join(import.meta.dirname, '..', 'legacy', 'advisor-fixtures');\n22: const ORIGINAL_HOOK_DISABLED = process.env.SPECKIT_SKILL_ADVISOR_HOOK_DISABLED;\n23: const ORIGINAL_DIRECTIVE_DEDUP = process.env[DIRECTIVE_LIFECYCLE_DEDUP_ENV];\n24: const ORIGINAL_ADVISOR_RUNTIME = process.env.SPECKIT_RUNTIME;\n25: \n26: const EXPECTED_FALLBACK_DIRECTIVES = '\\nDirectives:\\n- Comment hygiene [HARD BLOCK]: NEVER embed ADR-/REQ-/CHK-/task-ids or spec paths in code comments — forbidden regardless of instruction. Write the durable WHY instead. Pre-commit gate blocks violations.';\n27: const EXPECTED_SETUP_HEAD = 'Advisor: no skill matched. For setup or health checks, run /doctor:setup.';\n28: const EXPECTED_SETUP_CONTEXT = `${EXPECTED_SETUP_HEAD}${EXPECTED_FALLBACK_DIRECTIVES}`;\n29: const EXPECTED_NO_MATCH_CONTEXT = `Advisor: no skill matched.${EXPECTED_FALLBACK_DIRECTIVES}`;\n30: \n31: function fixture(name: string): AdvisorHookResult {\n32:   return JSON.parse(readFileSync(join(fixturesDir, name), 'utf8')) as AdvisorHookResult;\n33: }\n34: \n35: function diagnosticsSink(): { records: string[]; writeDiagnostic: (line: string) => void } {\n36:   const records: string[] = [];\n37:   return {\n38:     records,\n39:     writeDiagnostic: (line: string) => records.push(line),\n40:   };\n41: }\n42: \n43: async function runHook(input: ClaudeUserPromptSubmitInput, result: AdvisorHookResult) {\n44:   const diagnostics = diagnosticsSink();\n45:   const buildBrief = vi.fn(async () => result);\n46:   const output = await handleClaudeUserPromptSubmit(input, {\n47:     buildBrief,\n48:     renderBrief: renderAdvisorBrief,\n49:     writeDiagnostic: diagnostics.writeDiagnostic,\n50:     // Fresh in-memory dedup state per invocation keeps each case hermetic.\n51:     directiveLifecycleStore: new InMemoryDirectiveLifecycleStore(),\n52:   });\n53:   return { output, buildBrief, diagnostics };\n54: }\n55: \n56: function additionalContext(output: ClaudeUserPromptSubmitOutput): string {\n57:   return 'hookSpecificOutput' in output ? output.hookSpecificOutput.additionalContext : '';\n58: }\n59: \n60: function promptInput(prompt: string, sessionId: string): ClaudeUserPromptSubmitInput {\n61:   return {\n62:     session_id: sessionId,\n63:     hook_event_name: 'UserPromptSubmit',\n64:     prompt,\n65:     cwd: '/workspace/project',\n66:   };\n67: }\n68: \n69: const NO_MATCH_RESULT: AdvisorHookResult = {\n70:   ...fixture('livePassingSkill.json'),\n71:   brief: null,\n72:   recommendations: [],\n73: };\n74: \n75: afterEach(() => {\n76:   if (ORIGINAL_HOOK_DISABLED === undefined) delete process.env.SPECKIT_SKILL_ADVISOR_HOOK_DISABLED;\n77:   else process.env.SPECKIT_SKILL_ADVISOR_HOOK_DISABLED = ORIGINAL_HOOK_DISABLED;\n78:   if (ORIGINAL_DIRECTIVE_DEDUP === undefined) delete process.env[DIRECTIVE_LIFECYCLE_DEDUP_ENV];\n79:   else process.env[DIRECTIVE_LIFECYCLE_DEDUP_ENV] = ORIGINAL_DIRECTIVE_DEDUP;\n80:   if (ORIGINAL_ADVISOR_RUNTIME === undefined) delete process.env.SPECKIT_RUNTIME;\n81:   else process.env.SPECKIT_RUNTIME = ORIGINAL_ADVISOR_RUNTIME;\n82: });\n83: \n84: describe('doctor setup hint on a no-match', () => {\n85:   it('renders the setup hint when setup wording was seen', () => {\n86:     const rendered = renderAdvisorFallbackDirective({ setupWording: true }, { status: 'ok', freshness: 'live' });\n87: \n88:     expect(rendered).toBe(EXPECTED_SETUP_CONTEXT);\n89:   });\n90: \n91:   it('keeps the plain no-match head without setup wording and adds the hint to a setup-worded outage', () => {\n92:     const plain = renderAdvisorFallbackDirective({}, { status: 'ok', freshness: 'live' });\n93:     const outage = renderAdvisorFallbackDirective({ setupWording: true }, { status: 'fail_open', freshness: 'unavailable' });\n94: \n95:     expect(plain).toBe(EXPECTED_NO_MATCH_CONTEXT);\n96:     expect(outage.split('\\n')[0]).toBe(`Advisor: outage (fail_open); for setup or health checks, run /doctor:setup; route by hand: node .skilled/bin/skill-advisor.cjs advisor_recommend --json '{\"prompt\":\"<request>\"}' --format json`);\n97:   });\n98: \n99:   it('adds the setup hint for a setup-shaped prompt with no match', async () => {\n100:     const { output } = await runHook(promptInput('Help me set up skilled', 'setup-hint-set-up'), NO_MATCH_RESULT);\n101: \n102:     expect(additionalContext(output)).toBe(EXPECTED_SETUP_CONTEXT);\n103:   });\n104: \n105:   it.each([\n106:     { prompt: 'install the hooks', sessionId: 'setup-hint-install' },\n107:     { prompt: 'check my environment variables', sessionId: 'setup-hint-check' },\n108:     { prompt: 'check my config', sessionId: 'setup-hint-check-config' },\n109:     { prompt: 'reinstall skilled', sessionId: 'setup-hint-reinstall' },\n110:     { prompt: 'set-up skilled', sessionId: 'setup-hint-set-up-hyphen' },\n111:     { prompt: 'the installer is broken', sessionId: 'setup-hint-installer' },\n112:     { prompt: 'fix the configurations', sessionId: 'setup-hint-configurations' },\n113:     { prompt: 'configure the advisor', sessionId: 'setup-hint-configure' },\n114:   ])('adds the setup hint for \"$prompt\"', async ({ prompt, sessionId }) => {\n115:     const { output } = await runHook(promptInput(prompt, sessionId), NO_MATCH_RESULT);\n116: \n117:     expect(additionalContext(output)).toContain('run /doctor:setup.');\n118:   });\n119: \n120:   it('keeps the plain no-match head for an unrelated prompt with no match', async () => {\n121:     const { output } = await runHook(promptInput('what is the capital of France', 'setup-hint-unrelated'), NO_MATCH_RESULT);\n122: \n123:     expect(additionalContext(output)).toBe(EXPECTED_NO_MATCH_CONTEXT);\n124:   });\n125: \n126:   it.each([\n127:     { prompt: 'check what time the tide turns', sessionId: 'setup-hint-check-unrelated' },\n128:     { prompt: 'check with my doctor', sessionId: 'setup-hint-check-doctor' },\n129:     {\n130:       prompt: 'check the tool rental hours at the hardware store',\n131:       sessionId: 'setup-hint-check-tool-rental',\n132:     },\n133:     {\n134:       prompt: 'check whether the coat hooks are loose',\n135:       sessionId: 'setup-hint-check-coat-hooks',\n136:     },\n137:   ])('keeps the plain no-match head for check wording with no tooling context: \"$prompt\"', async ({ prompt, sessionId }) => {\n138:     const { output } = await runHook(promptInput(prompt, sessionId), NO_MATCH_RESULT);\n139: \n140:     expect(additionalContext(output)).toBe(EXPECTED_NO_MATCH_CONTEXT);\n141:   });\n142: \n143:   it('keeps setup wording checks bounded for long sequences of check terms', () => {\n144:     expect(SETUP_WORDING.test(\n145:       'check '.repeat(5000) + 'x'.repeat(100000),\n146:     )).toBe(false);\n147:   });\n148: \n149:   it('appends the unchanged directive block after the setup hint head', async () => {\n150:     const { output } = await runHook(promptInput('Help me set up skilled', 'setup-hint-directive-block'), NO_MATCH_RESULT);\n151: \n152:     expect(additionalContext(output).slice(EXPECTED_SETUP_HEAD.length)).toBe(EXPECTED_FALLBACK_DIRECTIVES);\n153:   });\n154: });","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/tests/hooks/doctor-setup-hint.vitest.ts, lines 1-154\n1: // ───────────────────────────────────────────────────────────────────\n2: // MODULE: Doctor setup hint hook tests\n3: // ───────────────────────────────────────────────────────────────────\n4: \n5: import { readFileSync } from 'node:fs';\n6: import { join } from 'node:path';\n7: import { afterEach, describe, expect, it, vi } from 'vitest';\n8: import {\n9:   handleClaudeUserPromptSubmit,\n10:   SETUP_WORDING,\n11:   type ClaudeUserPromptSubmitInput,\n12:   type ClaudeUserPromptSubmitOutput,\n13: } from '../../../hooks/claude/user-prompt-submit.js';\n14: import {\n15:   DIRECTIVE_LIFECYCLE_DEDUP_ENV,\n16:   InMemoryDirectiveLifecycleStore,\n17: } from '../../../hooks/lib/directive-lifecycle.js';\n18: import { renderAdvisorBrief, renderAdvisorFallbackDirective } from '../../lib/render.js';\n19: import type { AdvisorHookResult } from '../../lib/skill-advisor-brief.js';\n20: \n21: const fixturesDir = join(import.meta.dirname, '..', 'legacy', 'advisor-fixtures');\n22: const ORIGINAL_HOOK_DISABLED = process.env.SPECKIT_SKIL