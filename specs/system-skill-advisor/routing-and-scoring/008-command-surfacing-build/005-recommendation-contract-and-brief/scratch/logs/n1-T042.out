{"type":"tool_use","timestamp":1794529326835,"sessionID":"ses_e2db80179ffeaOrYcgpmM7vbPY","part":{"partID":"prt_1d2487558001DZ73M5GqCemtR4","sessionID":"ses_e2db80179ffeaOrYcgpmM7vbPY","messageID":"msg_1d2486cb3001zc2keiwQSdMD3Z","type":"tool","id":"call_3d0f79d0e7b74ca19cae8055","tool":"read","state":{"status":"completed","input":{"path":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/tests/command-policy-derivation.vitest.ts"},"output":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/tests/command-policy-derivation.vitest.ts, lines 1-187\n1: // ───────────────────────────────────────────────────────────────\n2: // MODULE: Command Policy Derivation\n3: // ───────────────────────────────────────────────────────────────\n4: \n5: // Pins the policy ladder and the closed key vocabularies that feed it. The ladder\n6: // is the only place an ask becomes a run, so each rung is asserted on its own: a\n7: // reordered branch would quietly promote a mutating command past the operator. The\n8: // real-tree tests read the repository once and assert the inventory agrees with\n9: // itself, which is the property a stale generated projection would break.\n10: \n11: import { mkdirSync, mkdtempSync, rmSync, writeFileSync } from 'node:fs';\n12: import { createRequire } from 'node:module';\n13: import { tmpdir } from 'node:os';\n14: import { join } from 'node:path';\n15: \n16: import { afterAll, beforeAll, describe, expect, it } from 'vitest';\n17: \n18: const require = createRequire(import.meta.url);\n19: \n20: const bridges = require('../scripts/command-bridges/derive-command-bridges.cjs') as {\n21:   commandTreeNames(commandsRoot?: string): string[];\n22:   validateRiskKeys(record: Record<string, unknown>, label: string, requireTarget?: boolean): void;\n23:   derivePolicy(record: RiskRecord): string;\n24:   doctorLeadPhrases(\n25:     item: { mutating: string; lead_phrases: string[] },\n26:     label: string,\n27:     triggerPhrases: string[],\n28:   ): string[];\n29:   metadataRiskRecords(skillsRoot?: string): Array<{ command: string }>;\n30:   identityViolations(input: {\n31:     treeCommands: string[];\n32:     metadataCommands: string[];\n33:     doctorCommands: string[];\n34:   }): string[];\n35:   commandPolicies(\n36:     skillsRoot?: string,\n37:     routesPath?: string,\n38:   ): Array<{ command: string; route: string | null; policy: string }>;\n39: };\n40: \n41: interface RiskRecord {\n42:   mutating: string;\n43:   ask_first?: string[];\n44:   write_scope?: string;\n45:   gate3_location?: string;\n46:   doctor?: boolean;\n47: }\n48: \n49: const POLICY_VALUES = ['run', 'start', 'ask'];\n50: \n51: let fixtureRoot = '';\n52: let commandsRoot = '';\n53: let skillsRoot = '';\n54: \n55: // Fixtures live in a temp tree so a partially written one can never be picked up by\n56: // the repository's own inventory scan.\n57: function createFixtureRoot(): string {\n58:   return mkdtempSync(join(tmpdir(), 'command-policy-derivation-'));\n59: }\n60: \n61: function writeFile(path: string, body = '# command\\n'): void {\n62:   mkdirSync(join(path, '..'), { recursive: true });\n63:   writeFileSync(path, body);\n64: }\n65: \n66: beforeAll(() => {\n67:   fixtureRoot = createFixtureRoot();\n68: \n69:   commandsRoot = join(fixtureRoot, 'commands');\n70:   // Only alpha/one.md names a command: a README and a .contract.md describe one\n71:   // instead of being one, a local- file belongs to a single checkout, a nested\n72:   // asset is not a router, a local- group is skipped whole, and a file directly in\n73:   // the root names no group at all.\n74:   writeFile(join(commandsRoot, 'alpha', 'one.md'));\n75:   writeFile(join(commandsRoot, 'alpha', 'README.md'));\n76:   writeFile(join(commandsRoot, 'alpha', 'one.contract.md'));\n77:   writeFile(join(commandsRoot, 'alpha', 'local-mine.md'));\n78:   writeFile(join(commandsRoot, 'alpha', 'assets', 'deep.md'));\n79:   writeFile(join(commandsRoot, 'local-group', 'x.md'));\n80:   writeFile(join(commandsRoot, 'top.md'));\n81: \n82:   skillsRoot = join(fixtureRoot, 'skills');\n83:   writeFile(\n84:     join(skillsRoot, 'beta', 'command-metadata.json'),\n85:     JSON.stringify([{ command: '/a:one', ownerMode: 'beta' }]),\n86:   );\n87: });\n88: \n89: afterAll(() => {\n90:   if (fixtureRoot) rmSync(fixtureRoot, { recursive: true, force: true });\n91: });\n92: \n93: describe('command policy derivation', () => {\n94:   it('derives the policy from the risk keys in a fixed order', () => {\n95:     const rows: Array<[string, RiskRecord, string]> = [\n96:       ['an ask-first reason wins over everything', { mutating: 'mutates', ask_first: ['spend'] }, 'ask'],\n97:       ['an ask-first reason applies to a read-only route too', { mutating: 'read-only', ask_first: ['settings'] }, 'ask'],\n98:       ['a mutating doctor route asks', { mutating: 'mutates', doctor: true }, 'ask'],\n99:       ['a read-only route runs', { mutating: 'read-only' }, 'run'],\n100:       ['an add-only route confined to the spec folder runs', { mutating: 'add-only', write_scope: 'spec-folder' }, 'run'],\n101:       ['an add-only route elsewhere is an ordinary task', { mutating: 'add-only' }, 'start'],\n102:       ['a mutating route is an ordinary task', { mutating: 'mutates' }, 'start'],\n103:     ];\n104: \n105:     for (const [label, record, expected] of rows) {\n106:       expect(bridges.derivePolicy(record), label).toBe(expected);\n107:     }\n108:   });\n109: \n110:   it('rejects a lead phrase with no state word on a route that runs unprompted', () => {\n111:     expect(() => bridges.doctorLeadPhrases(\n112:       { mutating: 'read-only', lead_phrases: ['disable the gate'] },\n113:       'fixture read-only route',\n114:       ['disable the gate'],\n115:     )).toThrow(/needs a state or health word/);\n116:   });\n117: \n118:   it('accepts the same lead phrase on a mutating route, whose policy asks first', () => {\n119:     expect(bridges.doctorLeadPhrases(\n120:       { mutating: 'mutates', lead_phrases: ['disable the gate'] },\n121:       'fixture mutates route',\n122:       ['disable the gate'],\n123:     )).toEqual(['disable the gate']);\n124:   });\n125: \n126:   it('rejects a missing class and unknown values', () => {\n127:     expect(() => bridges.validateRiskKeys({}, 'no-class')).toThrow(/no-class/);\n128:     expect(() => bridges.validateRiskKeys({ mutating: 'safe' }, 'bad-class')).toThrow(/bad-class/);\n129:     expect(() => bridges.validateRiskKeys({ mutating: 'mutates', ask_first: ['money'] }, 'bad-reason')).toThrow(\n130:       /bad-reason/,\n131:     );\n132:     expect(() => bridges.validateRiskKeys({ mutating: 'add-only', write_scope: 'anywhere' }, 'bad-scope')).toThrow(\n133:       /bad-scope/,\n134:     );\n135:     // A reachable command has to say where its writes land, so the target is\n136:     // required even when the class alone would otherwise validate.\n137:     expect(() => bridges.validateRiskKeys({ mutating: 'mutates' }, 'bad-target', true)).toThrow(/bad-target/);\n138: \n139:     expect(() => bridges.validateRiskKeys(\n140:       { mutating: 'mutates', gate3_location: 'x', ask_first: ['spend'] },\n141:       'good-record',\n142:       true,\n143:     )).not.toThrow();\n144:   });\n145: \n146:   it('reads commands two levels deep and skips documents and private files', () => {\n147:     expect(bridges.commandTreeNames(commandsRoot)).toEqual(['/alpha:one']);\n148:   });\n149: \n150:   it('names a command file with no declaration and a declaration with no file', () => {\n151:     const violations = bridges.identityViolations({\n152:       treeCommands: ['/a:one', '/a:two'],\n153:       metadataCommands: ['/a:one', '/a:gone'],\n154:       doctorCommands: [],\n155:     });\n156: \n157:     expect(violations).toHaveLength(2);\n158:     expect(violations.some(\n159:       (line) => line.includes('/a:two') && line.includes('no command-metadata.json entry'),\n160:     )).toBe(true);\n161:     expect(violations.some(\n162:       (line) => line.includes('/a:gone') && line.includes('has no command file'),\n163:     )).toBe(true);\n164: \n165:     expect(bridges.identityViolations({\n166:       treeCommands: ['/a:one'],\n167:       metadataCommands: ['/a:one'],\n168:       doctorCommands: [],\n169:     })).toEqual([]);\n170:   });\n171: \n172:   it('fails a metadata entry that states no class', () => {\n173:     expect(() => bridges.metadataRiskRecords(skillsRoot)).toThrow(/\\/a:one/);\n174:   });\n175: \n176:   it('emits a policy for every command file in the repository', () => {\n177:     const policies = bridges.commandPolicies();\n178:     const policyCommands = [...new Set(policies.map((record) => record.command))].sort();\n179:     const treeCommands = [...new Set(bridges.commandTreeNames())].sort();\n180: \n181:     expect(policyCommands).toEqual(treeCommands);\n182:     expect(policies.length).toBeGreaterThan(0);\n183:     for (const record of policies) {\n184:       expect(POLICY_VALUES).toContain(record.policy);\n185:     }\n186:   });\n187: });","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/tests/command-policy-derivation.vitest.ts, lines 1-187\n1: // ───────────────────────────────────────────────────────────────\n2: // MODULE: Command Policy Derivation\n3: // ───────────────────────────────────────────────────────────────\n4: \n5: // Pins the policy ladder and the closed key vocabularies that feed it. The ladder\n6: // is the only place an ask becomes a run, so each rung is asserted on its own: a\n7: // reordered branch would quietly promote a mutating command past the operator. The\n8: // real-tree tests read the repository once and assert the inventory agrees with\n9: // itself, which is the property a stale generated projection would break.\n10: \n11: import { mkdirSync, mkdtempSync, rmSync, writeFileSync } from 'node:fs';\n12: import { createRequire } from 'node:module';\n13: import { tmpdir } from 'node:os';\n14: import { join } from 'node:path';\n15: \n16: import { afterAll, beforeAll, describe, expect, it } from 'vitest';\n17: \n18: const require = createRequire(import.meta.url);\n19: \n20: const bridges = require('../scripts/command-bridges/derive-command-bridges.cjs') as {\n21:   commandTreeNames(commandsRoot?: string): string[];\n22:   validateRiskKeys(record: Record<string, unknown>, label: string, requireTarget?: boolean): void;\n23:   derivePolicy(record: RiskRecord): string;\n24:   doctorLeadPhrases(\n25:     item: { mutating: string; lead_phrases: string[] },\n26:     label: string,\n27:     triggerPhrases: string[],\n28:   ): string[];\n29:   metadataRiskRecords(skillsRoot?: string): Array<{ command: string }>;\n30:   identityViolations(input: {\n31:     treeCommands: string[];\n32:     metadataCommands: string[];\n33:     doctorCommands: string[];\n34:   }): string[];\n35:   commandPolicies(\n36:     skillsRoot?: string,\n37:     routesPath?: string,\n38:   ): Array<{ command: string; route: string | null; policy: string }>;\n39: };\n40: \n41: interface RiskRecord {\n42:   mutating: string;\n43:   ask_first?: string[];\n44:   write_scope?: string;\n45:   gate3_location?: string;\n46:   doctor?: boolean;\n47: }\n48: \n49: const POLICY_VALUES = ['run', 'start', 'ask'];\n50: \n51: let fixtureRoot = '';\n52: let commandsRoot = '';\n53: let skillsRoot = '';\n54: \n55: // Fixtures live in a temp tree so a partially written one can never be picked up by\n56: // the repository's own inventory scan.\n57: function createFixtureRoot(): string {\n58:   return mkdtempSync(join(tmpdir(), 'command-policy-derivation-'));\n59: }\n60: \n61: function writeFile(path: string, body = '# command\\n'): void {\n62:   mkdirSync(join(path, '..'), { recursive: true });\n63:   writeFileSync(path, body);\n64: }\n65: \n66: beforeAll(() => {\n67:   fixtureRoot = createFixtureRoot();\n68: \n69:   commandsRoot = join(fixtureRoot, 'commands');\n70:   // Only alpha/one.md names a command: a README and a .contract.md describe one\n71:   // instead of being one, a local- file belongs to a single checkout, a nested\n72:   // asset is not a router, a local- group is skipped whole, and a file directly in\n73:   // the root names no group at all.\n74:   writeFile(join(commandsRoot, 'alpha', 'one.md'));\n75:   writeFile(join(commandsRoot, 'alpha', 'README.md'));\n76:   writeFile(join(commandsRoot, 'alpha', 'one.contract.md'));\n77:   writeFile(join(commandsRoot, 'alpha', 'local-mine.md'));\n78:   writeFile(join(commandsRoot, 'alpha', 'assets', 'deep.md'));\n79:   writeFile(join(commandsRoot, 'local-group', 'x.md'));\n80:   writeFile(join(commandsRoot, 'top.md'));\n81: \n82:   skillsRoot = join(fixtureRoot, 'skills');\n83:   writeFile(\n84:     join(skillsRoot, 'beta', 'command-metadata.json'),\n85:     JSON.stringify([{ command: '/a:one', ownerMode: 'beta' }]),\n86:   );\n87: });\n88: \n89: afterAll(() => {\n90:   if (fixtureRoot) rmSync(fixtureRoot, { recursive: true, force: true });\n91: });\n92: \n93: describe('command policy derivation', () => {\n94:   it('derives the policy from the risk keys in a fixed order', () => {\n95:     const rows: Array<[string, RiskRecord, string]> = [\n96:       ['an ask-first reason wins over everything', { mutating: 'mutates', ask_first: ['spend'] }, 'ask'],\n97:       ['an ask-first reason applies to a read-only route too', { mutating: 'read-only', ask_first: ['settings'] }, 'ask'],\n98:       ['a mutating doctor route asks', { mutating: 'mutates', doctor: true }, 'ask'],\n99:       ['a read-only route runs', { mutating: 'read-only' }, 'run'],\n100:       ['an add-only route confined to the spec folder runs', { mutating: 'add-only', write_scope: 'spec-folder' }, 'run'],\n101:       ['an add-only route elsewhere is an ordinary task', { mutating: 'add-only' }, 'start'],\n102:       ['a mutating route is an ordinary task', { mutating: 'mutates' }, 'start'],\n103:     ];\n104: \n105:     for (const [label, record, expected] of rows) {\n106:       expect(bridges.derivePolicy(record), label).toBe(expected);\n107:     }\n108:   });\n109: \n110:   it('rejects a lead phrase with no state word on a route that runs unprompted', () => {\n111:     expect(() => bridges.doctorLeadPhrases(\n112:       { mutating: 'read-only', lead_phrases: ['disable the gate'] },\n113:       'fixture read-only route',\n114:       ['disable the gate'],\n115:     )).toThrow(/needs a state or health word/);\n116:   });\n117: \n118:   it('accepts the same lead phrase on a mutating route, whose policy asks first', () => {\n119:     expect(bridges.doctorLeadPhrases(\n120:       { mutating: 'mutates', lead_phrases: ['disable the gate'] },\n121:       'fixture mutates route',\n122:       ['disable the gate'],\n123:     )).toEqual(['disable the gate']);\n124:   });\n125: \n126:   it('rejects a missing class and unknown values', () => {\n127:     expect(() => bridges.validateRiskKeys({}, 'no-class')).toThrow(/no-class/);\n128:     expect(() => bridges.validateRiskKeys({ mutating: 'safe' }, 'bad-class')).toThrow(/bad-class/);\n129:     expect(() => bridges.validateRiskKeys({ mutating: 'mutates', ask_first: ['money'] }, 'bad-reason')).toThrow(\n130:       /bad-reason/,\n131:     );\n132:     expect(() => bridges.validateRiskKeys({ mutating: 'add-only', write_scope: 'anywhere' }, 'bad-scope')).toThrow(\n133:       /bad-scope/,\n134:     );\n135:     // A reachable command has to say where its writes land, so the target is\n136:     // required even when the class alone would otherwise validate.\n137:     expect(() => bridges.validateRiskKeys({ mutating: 'mutates' }, 'bad-target', true)).toThrow(/bad-target/);\n138: \n139:     expect(() => bridges.validateRiskKeys(\n140:       { mutating: 'mutates', gate3_location: 'x', ask_first: ['spend'] },\n141:       'good-record',\n142:       true,\n143:     )).not.toThrow();\n144:   });\n145: \n146:   it('reads commands two levels deep and skips documents and private files', () => {\n147:     expect(bridges.commandTreeNames(commandsRoot)).toEqual(['/alpha:one']);\n148:   });\n149: \n150:   it('names a command file with no declaration and a declaration with no file', () => {\n151:     const violations = bridges.identityViolations({\n152:       treeCommands: ['/a:one', '/a:two'],\n153:       metadataCommands: ['/a:one', '/a:gone'],\n154:       doctorCommands: [],\n155:     });\n156: \n157:     expect(violations).toHaveLength(2);\n158:     expect(violations.some(\n159:       (line) => line.includes('/a:two') && line.includes('no command-metadata.json entry'),\n160:     )).toBe(true);\n161:     expect(violations.some(\n162:       (line) => line.includes('/a:gone') && line.includes('has no command file'),\n163:     )).toBe(true);\n164: \n165:     expect(bridges.identityViolations({\n166:       treeCommands: ['/a:one'],\n167:       metadataCommands: ['/a:one'],\n168:       doctorCommands: [],\n169:     })).toEqual([]);\n170:   });\n171: \n172:   it('fails a metadata entry that states no class', () => {\n173:     expect(() => bridges.metadataRiskRecords(skillsRoot)).toThrow(/\\/a:one/);\n174:   });\n175: \n176:   it('emits a policy for every command file in the repository', () => {\n177:     const policies = bridges.commandPolicies();\n178:     const policyCommands = [...new Set(policies.map((record) => record.command))].sort();\n179:     const treeCommands = [...new Set(bridges.commandTreeNames())].sort();\n180: \n181:     expect(policyCommands).toEqual(treeCommands);\n182:     expect(policies.length).toBeGreaterThan(0);\n183:     for (const record of policies) {\n184:       expect(POLICY_VALUES).toContain(record.policy);\n185:     }\n186:   });\n187: });"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/tests/command-policy-derivation.vitest.ts\"}"},"time":{"start":1794529326424,"end":1794529326835}}}}
