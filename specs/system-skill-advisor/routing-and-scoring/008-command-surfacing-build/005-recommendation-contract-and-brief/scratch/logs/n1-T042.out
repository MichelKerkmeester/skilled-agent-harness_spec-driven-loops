andalone = standaloneCommandRecords(entries, metadata);\n930:  assertPlainChatSignals(standalone);\n931:  activateStandaloneCommands(typescript, standalone, 'typescript');\n932:  activateStandaloneCommands(python, standalone, 'python');\n1292:  const compatibility = runtimeCompatibility(inventory, metadata);\n1365:module.exports = {\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"139:    const standalone = !existsSync(join(skillsRoot, skillId, 'mode-registry.json'));\n182:        standalone,\n301:  const standalone = manifest.standalone === undefined ? [] : manifest.standalone;\n302:  if (!Array.isArray(standalone)) {\n303:    throw new Error('[command-bridges] _routes.yaml standalone must be an array');\n305:  standalone.forEach((item, index) => {\n307:    const label = `_routes.yaml standalone[${index}]`;\n502:function metadataRiskRecords(skillsRoot = SKILLS_ROOT) {\n588:  const standalone = manifest.standalone === undefined ? [] : manifest.standalone;\n589:  if (!Array.isArray(standalone)) {\n590:    throw new Error('[command-bridges] _routes.yaml standalone must be an array');\n592:  standalone.forEach((item, index) => {\n594:    const label = `${sourcePath(routesPath)} standalone[${index}]`;\n842:// A standalone skill has no hub registry, so the only record of what its\n846:function standaloneCommandRecords(entries, metadata) {\n849:    if (record.standalone) byCommand.set(record.command, record);\n875:// A standalone skill's commands are active by construction: the metadata already\n887:    byInventoryId.set(entry.id, standaloneRuntimeRow(entry, record, nextOrder, platform));\n892:function standaloneRuntimeRow(entry, record, order, platform) {\n917:function runtimeCompatibility(entries, metadata) {\n929:  const standalone = standaloneCommandRecords(entries, metadata);\n930:  assertPlainChatSignals(standalone);\n931:  activateStandaloneCommands(typescript, standalone, 'typescript');\n932:  activateStandaloneCommands(python, standalone, 'python');\n1292:  const compatibility = runtimeCompatibility(inventory, metadata);\n1365:module.exports = {\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"cd /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research && rg -n \\\"module.exports|^function metadataRiskRecords|standalone|runtimeCompatibility\\\\(\\\" .skilled/skills/system-skill-advisor/runtime/scripts/command-bridges/derive-command-bridges.cjs | head -60\"}"},"time":{"start":1794529341281,"end":1794529342754}}}}
