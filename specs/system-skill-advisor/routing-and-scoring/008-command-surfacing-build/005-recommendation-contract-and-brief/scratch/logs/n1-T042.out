   });\n1286:   if (violations.length > 0) {\n1287:     throw new Error(`[command-bridges] command inventory mismatch:\\n${violations.join('\\n')}`);\n1288:   }\n1289:   const inventory = [...metadata, ...doctor]\n1290:     .sort((left, right) => left.id.localeCompare(right.id));\n1291:   assertUniqueIds(inventory);\n1292:   const compatibility = runtimeCompatibility(inventory, metadata);\n1293:   const entries = inventory.map((entry) => {\n1294:     const isDoctor = entry.id.startsWith(DOCTOR_PREFIX);\n1295:     const typescript = compatibility.typescript.get(entry.id);\n1296:     const python = compatibility.python.get(entry.id);\n1297:     // A command nothing describes has nothing written to embed, so the field\n1298:     // appears only where a source sentence exists for it.\n1299:     const meaning = typescript ? entryMeaning(entry.id, entry.command, isDoctor) : undefined;\n1300:     const runtime = { typescript: { enabled: false }, python: { enabled: false } };\n1301:     if (typescript) {\n1302:       runtime.typescript = {\n1303:         enabled: true,\n1304:         ...(isDoctor ? doctorRuntime(entry.id, 'typescript', typescript) : typescript),\n1305:       };\n1306:     }\n1307:     if (python) {\n1308:       runtime.python = {\n1309:         enabled: true,\n1310:         ...(isDoctor ? doctorRuntime(entry.id, 'python', python) : python),\n1311:       };\n1312:     }\n1313:     return {\n1314:       ...entry,\n1315:       ...(meaning ? { embeddingText: commandEmbeddingText(meaning) } : {}),\n1316:       runtime,\n1317:     };\n1318:   });\n1319: \n1320:   const policies = commandPolicies();\n1321:   const projection = {\n1322:     schemaVersion: 2,\n1323:     generatedBy: 'scripts/command-bridges/derive-command-bridges.cjs',\n1324:     counts: {\n1325:       commandMetadata: metadata.length,\n1326:       doctorRoutes: doctor.length,\n1327:       generated: entries.length,\n1328:       typescriptActive: compatibility.typescript.size,\n1329:       pythonActive: compatibility.python.size,\n1330:     },\n1331:     entries,\n1332:     commandPolicies: policies,\n1333:   };\n1334:   const output = `${JSON.stringify(projection, null, 2)}\\n`;\n1335:   const sources = generatedSources(\n1336:     entries,\n1337:     compatibility.pythonOwnerNormalization,\n1338:     modeCommands,\n1339:     policies,\n1340:   );\n1341:   const changed = [\n1342:     ...(readFileSync(OUTPUT_PATH, 'utf8') === output ? [] : [OUTPUT_PATH]),\n1343:     ...sources.filter(({ current, next }) => current !== next).map(({ path }) => path),\n1344:   ];\n1345: \n1346:   if (!checkOnly) {\n1347:     writeFileSync(OUTPUT_PATH, output, 'utf8');\n1348:     for (const source of sources) {\n1349:       if (source.current !== source.next) {\n1350:         writeFileSync(source.path, source.next, 'utf8');\n1351:       }\n1352:     }\n1353:   }\n1354: \n1355:   console.log(JSON.stringify({\n1356:     status: changed.length === 0 ? 'fresh' : checkOnly ? 'stale' : 'generated',\n1357:     counts: projection.counts,\n1358:     changed: changed.map(sourcePath),\n1359:   }, null, 2));\n1360:   if (checkOnly && changed.length > 0) process.exitCode = 1;\n1361: }\n1362: \n1363: if (require.main === module) main();\n1364: \n1365: module.exports = {\n1366:   metadataEntries,\n1367:   commandTreeNames,\n1368:   modeCommandRecords,\n1369:   validateRiskKeys,\n1370:   derivePolicy,\n1371:   metadataRiskRecords,\n1372:   doctorRiskRecords,\n1373:   doctorLeadPhrases,\n1374:   identityViolations,\n1375:   commandPolicies,\n1376: };","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/scripts/command-bridges/derive-command-bridges.cjs, lines 1260-1376\n1260: // 4. CORE LOGIC\n1261: // ───────────────────────────────────────────────────────────────────\n1262: \n1263: function main() {\n1264:   // CLI-only rejection: requiring this module (for example from tests) must\n1265:   // not exit on arguments belonging to the host process.\n1266:   if (require.main === module) {\n1267:     const unknownArg = process.argv.slice(2).find((token) => token !== '--check');\n1268:     if (unknownArg !== undefined) {\n1269:       console.error(`derive-command-bridges.cjs: unknown option: ${unknownArg}`);\n1270:       console.error('usage: derive-command-bridges.cjs [--check]');\n1271:       process.exit(2);\n1272:     }\n1273:   }\n1274:   const checkOnly = process.argv.includes('--check');\n1275:   const metadata = metadataEntries();\n1276:   const doctor = doctorRouteEntries();\n1277:   const tree = commandTreeNames();\n1278:   const metadataRisk = metadataRiskRecords();\n1279:   const doctorRisk = doctorRiskRecords();\n1280:   const modeCommands = modeCommandRecords();\n1281:   const violations = identityViolations({\n1282:     treeCommands: tree,\n1283:     metadataCommands: metadataRisk.map((record) => record.command),\n1284:     doctorCommands: doctorRisk.map((record) => record.command),\n1285:   });\n1286:   if (violations.length > 0) {\n1287:     throw new Error(`[command-bridges] command inventory mismatch:\\n${violations.join('\\n')}`);\n1288:   }\n1289:   const inventory = [...metadata, ...doctor]\n1290:     .sort((left, right) => left.id.localeCompare(right.id));\n1291:   assertUniqueIds(inventory);\n1292:   const compatibility = runtimeCompatibility(inventory, metadata);\n1293:   const entries = inventory.map((entry) => {\n1294:     const isDoctor = entry.id.startsWith(DOCTOR_PREFIX);\n1295:     const typescript = compatibility.typescript.get(entry.id);\n1296:     const python = compatibility.python.get(entry.id);\n1297:     // A command nothing describes has nothing written to embed, so the field\n1298:     // appears only where a source sentence exists for it.\n1299:     const meaning = typescript ? entryMeaning(entry.id, entry.command, isDoctor) : undefined;\n1300:     const runtime = { typescript: { enabled: false }, python: { enabled: false } };\n1301:     if (typescript) {\n1302:       runtime.typescript = {\n1303:         enabled: true,\n1304:         ...(isDoctor ? doctorRuntime(entry.id, 'typescript', typescript) : typescript),\n1305:       };\n1306:     }\n1307:     if (python) {\n1308:       runtime.python = {\n1309:         enabled: true,\n1310:         ...(isDoctor ? doctorRuntime(entry.id, 'python', python) : python),\n1311:       };\n1312:     }\n1313:     return {\n1314:       ...entry,\n1315:       ...(meaning ? { embeddingText: commandEmbeddingText(meaning) } : {}),\n1316:       runtime,\n1317:     };\n1318:   });\n1319: \n1320:   const policies = commandPolicies();\n1321:   const projection = {\n1322:     schemaVersion: 2,\n1323:     generatedBy: 'scripts/command-bridges/derive-command-bridges.cjs',\n1324:     counts: {\n1325:       commandMetadata: metadata.length,\n1326:       doctorRoutes: doctor.length,\n1327:       generated: entries.length,\n1328:       typescriptActive: compatibility.typescript.size,\n1329:       pythonActive: compatibility.python.size,\n1330:     },\n1331:     entries,\n1332:     commandPolicies: policies,\n1333:   };\n1334:   const output = `${JSON.stringify(projection, null, 2)}\\n`;\n1335:   const sources = generatedSources(\n1336:     entries,\n1337:     compatibility.pythonOwnerNormalization,\n1338:     modeCommands,\n1339:     policies,\n1340:   );\n1341:   const changed = [\n1342:     ...(readFileSync(OUTPUT_PATH, 'utf8') === output ? [] : [OUTPUT_PATH]),\n1343:     ...sources.filter(({ current, next }) => current !== next).map(({ path }) => path),\n1344:   ];\n1345: \n1346:   if (!checkOnly) {\n1347:     writeFileSync(OUTPUT_PATH, output, 'utf8');\n1348:     for (const source of sources) {\n1349:       if (source.current !== source.next) {\n1350:         writeFileSync(source.path, source.next, 'utf8');\n1351:       }\n1352:     }\n1353:   }\n1354: \n1355:   console.log(JSON.stringify({\n1356:     status: changed.length === 0 ? 'fresh' : checkOnly ? 'stale' : 'generated',\n1357:     counts: projection.counts,\n1358:     changed: changed.map(sourcePath),\n1359:   }, null, 2));\n1360:   if (checkOnly && changed.length > 0) process.exitCode = 1;\n1361: }\n1362: \n1363: if (require.main === module) main();\n1364: \n1365: module.exports = {\n1366:   metadataEntries,\n1367:   commandTreeNames,\n1368:   modeCommandRecords,\n1369:   validateRiskKeys,\n1370:   derivePolicy,\n1371:   metadataRiskRecords,\n1372:   doctorRiskRecords,\n1373:   doctorLeadPhrases,\n1374:   identityViolations,\n1375:   commandPolicies,\n1376: };"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"limit\":120,\"offset\":1260,\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/scripts/command-bridges/derive-command-bridges.cjs\"}"},"time":{"start":1794529341959,"end":1794529342722}}}}
