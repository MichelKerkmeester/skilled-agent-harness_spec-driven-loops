    routingEnabled: ${active},`,\n1040:  const body = runtimeOrdered(entries, 'typescript').map(renderTypescriptBridge).join('\\n');\n1044:function pythonString(value) {\n1048:function pythonList(values) {\n1049:  return `[${values.map((value) => pythonString(value)).join(', ')}]`;\n1053:  const runtime = entry.runtime.python;\n1054:  const active = runtime.enabled;\n1059:    `    ${pythonString(runtimeId)}: {`,\n1060:    `        \"description\": ${pythonString(description)},`,\n1061:    `        \"slash_markers\": ${pythonList(slashMarkers)},`,\n1064:    lines.push(`        \"lead_phrases\": ${pythonList(runtime.leadPhrases)},`);\n1070:    lines.push(`        \"owning_skill\": ${pythonString(runtime.owningSkill)},`);\n1073:    `        \"inventory_id\": ${pythonString(entry.id)},`,\n1074:    `        \"command\": ${pythonString(entry.command)},`,\n1075:    `        \"skill_id\": ${pythonString(entry.skillId)},`,\n1076:    `        \"owner_mode\": ${pythonString(entry.ownerMode)},`,\n1077:    `        \"routing_enabled\": ${active ? 'True' : 'False'},`,\n1083:function renderPythonProjection(entries, pythonOwnerNormalization) {\n1084:  const body = runtimeOrdered(entries, 'python').map(renderPythonBridge).join('\\n');\n1085:  const normalization = Object.entries(pythonOwnerNormalization)\n1086:    .map(([id, owner]) => `    ${pythonString(id)}: ${pythonString(owner)},`)\n1152:    const { typescript, python } = entry.runtime;\n1153:    if (!typescript.enabled && !python.enabled) continue;\n1158:    if (typescript.enabled) ids.add(typescript.id);\n1159:    if (python.enabled) ids.add(python.id);\n1208:function generatedSources(entries, pythonOwnerNormalization, modeCommands, policies) {\n1209:  const typescript = readFileSync(TS_PROJECTION_PATH, 'utf8');\n1210:  const python = readFileSync(PY_ADVISOR_PATH, 'utf8');\n1225:      current: typescript,\n1227:        typescript,\n1236:      current: python,\n1238:        python,\n1241:        renderPythonProjection(entries, pythonOwnerNormalization),\n1295:    const typescript = compatibility.typescript.get(entry.id);\n1296:    const python = compatibility.python.get(entry.id);\n1299:    const meaning = typescript ? entryMeaning(entry.id, entry.command, isDoctor) : undefined;\n1300:    const runtime = { typescript: { enabled: false }, python: { enabled: false } };\n1301:    if (typescript) {\n1302:      runtime.typescript = {\n1303:        enabled: true,\n1304:        ...(isDoctor ? doctorRuntime(entry.id, 'typescript', typescript) : typescript),\n1307:    if (python) {\n1308:      runtime.python = {\n1309:        enabled: true,\n1310:        ...(isDoctor ? doctorRuntime(entry.id, 'python', python) : python),\n1328:      typescriptActive: compatibility.typescript.size,\n1329:      pythonActive: compatibility.python.size,\n1337:    compatibility.pythonOwnerNormalization,\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"cd /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research && wc -l .skilled/skills/system-skill-advisor/runtime/scripts/command-bridges/derive-command-bridges.cjs && rg -n \\\"routingEnabled|enabled|typescript|python\\\" .skilled/skills/system-skill-advisor/runtime/scripts/command-bridges/derive-command-bridges.cjs | head -80\"}"},"time":{"start":1794529331548,"end":1794529333269}}}}
