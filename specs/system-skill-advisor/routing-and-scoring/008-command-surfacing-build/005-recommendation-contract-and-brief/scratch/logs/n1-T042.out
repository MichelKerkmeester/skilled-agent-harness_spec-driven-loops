.ts'),\\n    join(runtime, 'lib', 'command-attach.ts'),\\n  );\\n  writeFileSync(join(bridges, 'scoring-compatibility.json'), JSON.stringify({\\n    schemaVersion: 1,\\n    typescript: [],\\n    python: [],\\n    pythonOwnerNormalization: {},\\n  }));\\n  writeFile(join(bridges, 'command-bridges.generated.json'), '{}\\\\n');\\n  writeFile(join(root, '.skilled', 'commands', 'gamma', 'one.md'));\\n  writeFile(\\n    join(root, '.skilled', 'commands', 'doctor', '_routes.yaml'),\\n    'routes: []\\\\nmcp_subroutes: []\\\\nstandalone: []\\\\n',\\n  );\\n  return staged;\\n}\\n\",\"oldString\":\"function writeFile(path: string, body = '# command\\\\n'): void {\\n  mkdirSync(join(path, '..'), { recursive: true });\\n  writeFileSync(path, body);\\n}\\n\",\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/tests/command-policy-derivation.vitest.ts\"}"},"time":{"start":1794529699142,"end":1794529703189}}}}
