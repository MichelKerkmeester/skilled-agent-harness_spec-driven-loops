honOwnerNormalization references inactive bridge ${runtimeId}`,\\n954:  return { typescript, python, pythonOwnerNormalization };\\n1044:function pythonString(value) {\\n1048:function pythonList(values) {\\n1049:  return `[${values.map((value) => pythonString(value)).join(', ')}]`;\\n1052:function renderPythonBridge(entry) {\\n1053:  const runtime = entry.runtime.python;\\n1059:    `    ${pythonString(runtimeId)}: {`,\\n1060:    `        \\\"description\\\": ${pythonString(description)},`,\\n1061:    `        \\\"slash_markers\\\": ${pythonList(slashMarkers)},`,\\n1064:    lines.push(`        \\\"lead_phrases\\\": ${pythonList(runtime.leadPhrases)},`);\\n1070:    lines.push(`        \\\"owning_skill\\\": ${pythonString(runtime.owningSkill)},`);\\n1073:    `        \\\"inventory_id\\\": ${pythonString(entry.id)},`,\\n1074:    `        \\\"command\\\": ${pythonString(entry.command)},`,\\n1075:    `        \\\"skill_id\\\": ${pythonString(entry.skillId)},`,\\n1076:    `        \\\"owner_mode\\\": ${pythonString(entry.ownerMode)},`,\\n1083:function renderPythonProjection(entries, pythonOwnerNormalization) {\\n1084:  const body = runtimeOrdered(entries, 'python').map(renderPythonBridge).join('\\\\n');\\n1085:  const normalization = Object.entries(pythonOwnerNormalization)\\n1086:    .map(([id, owner]) => `    ${pythonString(id)}: ${pythonString(owner)},`)\\n1152:    const { typescript, python } = entry.runtime;\\n1153:    if (!typescript.enabled && !python.enabled) continue;\\n1159:    if (python.enabled) ids.add(python.id);\\n1208:function generatedSources(entries, pythonOwnerNormalization, modeCommands, policies) {\\n1210:  const python = readFileSync(PY_ADVISOR_PATH, 'utf8');\\n\"}],\"providerCall\":{\"executed\":false},\"providerResult\":{\"executed\":false},\"rawInput\":\"{\\\"command\\\":\\\"rg -n \\\\\\\"python|Python|skill_advisor\\\\\\\" .skilled/skills/system-skill-advisor/runtime/scripts/command-bridges/derive-command-bridges.cjs | head -40\\\",\\\"workdir\\\":\\\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research\\\"}\"},\"time\":{\"start\":1794528279929,\"end\":1794528280582}}}}\n./specs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/005-recommendation-contract-and-brief/scratch/logs/w6-T032.out:{\"type\":\"tool_use\",\"timestamp\":1794528423074,\"sessionID\":\"ses_e2dcb0a25ffeKDrFVYdzDGhvxv\",\"part\":{\"partID\":\"prt_1d23aa7f500280QWZVEffQkWmm\",\"sessionID\":\"ses_e2dcb0a25ffeKDrFVYdzDGhvxv\",\"messageID\":\"msg_1d23a98210016FieWhUDtFZ5NI\",\"type\":\"tool\",\"id\":\"call_687b63ac7d5a4e1380f72e63\",\"tool\":\"shell\",\"state\":{\"status\":\"completed\",\"input\":{\"command\":\"sed -n '880,960p' .skilled/skills/system-skill-advisor/runtime/scripts/command-bridges/derive-command-bridges.cjs\",\"workdir\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research\"},\"output\":\"function n(byInventoryId, records, platform) {\\n  let nextOrder = 0;\\n  for (const row of byInventoryId.values()) {\\n    nextOrder = Math.max(nextOrder, row.order + 1);\\n  }\\n  for (const { entry, record } of records) {\\n    if (byInventoryId.has(entry.id)) continue;\\n    byInventoryId.set(entry.id, standaloneRuntimeRow(entry, record, nextOrder, platform));\\n    nextOrder += 1;\\n  }\\n}\\n\\nfunction standaloneRuntimeRow(entry, record, order, platform) {\\n  if (platform === 'typescript') {\\n    return {\\n      inventoryId: entry.id,\\n      order,\\n      id: entry.id,\\n      name: entry.id,\\n      description: record.description,\\n      keywords: [...record.ownedSignals],\\n      domains: [commandNamespace(entry.command), 'command'],\\n      intentSignals: [...record.ownedSignals],\\n      // The class decides this for every command, not only a doctor route.\\n      ...(isReadOnlyRoute(record) ? { readOnly: true } : {}),\\n    };\\n  }\\n  return {\\n    inventoryId: entry.id,\\n    order,\\n    id: entry.id,\\n    description: record.description,\\n    slashMarkers: [entry.command, entry.command.slice(1)],\\n    owningSkill: record.skillId,\\n  };\\n}\\n\\nfunction n(entries, metadata) {\\n  const compatibility = readJson(COMPATIBILITY_PATH);\\n  if (!compatibility || typeof compatibility !== 'object' || compatibility.schemaVersion !== 1) {\\n    throw new Error('[command-bridges] scoring-compatibility.json requires schemaVersion 1');\\n  }\\n  const inventoryIds = new Set(entries.map((entry) => entry.id));\\n  const typescript = compatibilityByInventoryId(\\n    compatibility.typescript,\\n    inventoryIds,\\n    'typescript',\\n  );\\n  const python = compatibilityByInventoryId(compatibility.python, inventoryIds, 'python');\\n  const standalone = standaloneCommandRecords(entries, metadata);\\n  assertPlainChatSignals(standalone);\\n  n(typescript, standalone, 'typescript');\\n  n(python, standalone, 'python');\\n  const pythonOwnerNormalization = compatibility.pythonOwnerNormalization;\\n  if (\\n    !pythonOwnerNormalization\\n    || typeof pythonOwnerNormalization !== 'object'\\n    || Array.isArray(pythonOwnerNormalization)\\n    || Object.entries(pythonOwnerNormalization).some(\\n      ([key, value]) => !key || typeof value !== 'string' || !value,\\n    )\\n  ) {\\n    throw new Error(\\n      '[command-bridges] scoring-compatibility.json pythonOwnerNormalization must be a string map',\\n    );\\n  }\\n  const activePythonIds = new Set([...python.values()].map((entry) => entry.id));\\n  for (const runtimeId of Object.keys(pythonOwnerNormalization)) {\\n    if (!activePythonIds.has(runtimeId)) {\\n      throw new Error(\\n        `[command-bridges] pythonOwnerNormalization references inactive bridge ${runtimeId}`,\\n      );\\n    }\\n  }\\n  return { typescript, python, pythonOwnerNormalization };\\n}\\n\\nfunction tsString(value) {\\n  return `'${value.replaceAll('\\\\\\\\', '\\\\\\\\\\\\\\\\').replaceAll(\\\"'\\\", \\\"\\\\\\\\'\\\")}'`;\\n}\\n\\n\",\"title\":\"shell\",\"metadata\":{\"metadata\":{\"status\":\"completed\",\"truncated\":false,\"exit\":0},\"content\":[{\"type\":\"text\",\"text\":\"function n(byInventoryId, records, platform) {\\n  let nextOrder = 0;\\n  for (const row of byInventoryId.values()) {\\n    nextOrder = Math.max(nextOrder, row.order + 1);\\n  }\\n  for (const { entry, record } of records) {\\n    if (byInventoryId.has(entry.id)) continue;\\n    byInventoryId.set(entry.id, standaloneRuntimeRow(entry, record, nextOrder, platform));\\n    nextOrder += 1;\\n  }\\n}\\n\\nfunction standaloneRuntimeRow(entry, record, order, platform) {\\n  if (platform === 'typescript') {\\n    return {\\n      inventoryId: entry.id,\\n      order,\\n      id: entry.id,\\n      name: entry.id,\\n      description: record.description,\\n      keywords: [...record.ownedSignals],\\n      domains: [commandNamespace(entry.command), 'command'],\\n      intentSignals: [...record.ownedSignals],\\n      // The class decides this for every command, not only a doctor route.\\n      ...(isReadOnlyRoute(record) ? { readOnly: true } : {}),\\n    };\\n  }\\n  return {\\n    inventoryId: entry.id,\\n    order,\\n    id: entry.id,\\n    description: record.description,\\n    slashMarkers: [entry.command, entry.command.slice(1)],\\n    owningSkill: record.skillId,\\n  };\\n}\\n\\nfunction n(entries, metadata) {\\n  const compatibility = readJson(COMPATIBILITY_PATH);\\n  if (!compatibility || typeof compatibility !== 'object' || compatibility.schemaVersion !== 1) {\\n    throw new Error('[command-bridges] scoring-compatibility.json requires schemaVersion 1');\\n  }\\n  const inventoryIds = new Set(entries.map((entry) => entry.id));\\n  const typescript = compatibilityByInventoryId(\\n    compatibility.typescript,\\n    inventoryIds,\\n    'typescript',\\n  );\\n  const python = compatibilityByInventoryId(compatibility.python, inventoryIds, 'python');\\n  const standalone = standaloneCommandRecords(entries, metadata);\\n  assertPlainChatSignals(standalone);\\n  n(typescript, standalone, 'typescript');\\n  n(python, standalone, 'python');\\n  const pythonOwnerNormalization = compatibility.pythonOwnerNormalization;\\n  if (\\n    !pythonOwnerNormalization\\n    || typeof pythonOwnerNormalization !== 'object'\\n    || Array.isArray(pythonOwnerNormalization)\\n    || Object.entries(pythonOwnerNormalization).some(\\n      ([key, value]) => !key || typeof value !== 'string' || !value,\\n    )\\n  ) {\\n    throw new Error(\\n      '[command-bridges] scoring-compatibility.json pythonOwnerNormalization must be a string map',\\n    );\\n  }\\n  const activePythonIds = new Set([...python.values()].map((entry) => entry.id));\\n  for (const runtimeId of Object.keys(pythonOwnerNormalization)) {\\n    if (!activePythonIds.has(runtimeId)) {\\n      throw new Error(\\n        `[command-bridges] pythonOwnerNormalization references inactive bridge ${runtimeId}`,\\n      );\\n    }\\n  }\\n  return { typescript, python, pythonOwnerNormalization };\\n}\\n\\nfunction tsString(value) {\\n  return `'${value.replaceAll('\\\\\\\\', '\\\\\\\\\\\\\\\\').replaceAll(\\\"'\\\", \\\"\\\\\\\\'\\\")}'`;\\n}\\n\\n\"}],\"providerCall\":{\"executed\":false},\"providerResult\":{\"executed\":false},\"rawInput\":\"{\\\"command\\\":\\\"sed -n '880,960p' .skilled/skills/system-skill-advisor/runtime/scripts/command-bridges/derive-command-bridges.cjs\\\",\\\"workdir\\\":\\\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research\\\"}\"},\"time\":{\"start\":1794528421877,\"end\":1794528423074}}}}\n./specs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/005-recommendation-contract-and-brief/scratch/logs/w6-T032.out:{\"type\":\"tool_use\",\"timestamp\":1794528423093,\"sessionID\":\"ses_e2dcb0a25ffeKDrFVYdzDGhvxv\",\"part\":{\"partID\":\"prt_1d23aaa25001EkxgoIIClogsUI\",\"sessionID\":\"ses_e2dcb0a25ffeKDrFVYdzDGhvxv\",\"messageID\":\"msg_1d23a98210016FieWhUDtFZ5NI\",\"type\":\"tool\",\"id\":\"call_3f981e1a56454db38cee1d4d\",\"tool\":\"shell\",\"state\":{\"status\":\"completed\",\"input\":{\"command\":\"rg -n \\\"n|standaloneCommand|function .*standalone|slug\\\" .skilled/skills/system-skill-advisor/runtime/scripts/command-bridges/derive-command-bridges.cjs | head -30\",\"workdir\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research\"},\"output\":\"846:function standaloneCommandRecords(entries, metadata) {\\n880:function n(byInventoryId, records, platform) {\\n892:function standaloneRuntimeRow(entry, record, order, platform) {\\n929:  const standalone = standaloneCommandRecords(entries, metadata);\\n931:  n(typescript, standalone, 'typescript');\\n932:  n(python, standalone, 'python');\\n\",\"title\":\"shell\",\"metadata\":{\"metadata\":{\"status\":\"completed\",\"truncated\":false,\"exit\":0},\"content\":[{\"type\":\"text\",\"text\":\"846:function standaloneCommandRecords(entries, metadata) {\\n880:function n(byInventoryId, records, platform) {\\n892:function standaloneRuntimeRow(entry, record, order, platform) {\\n929:  const standalone = standaloneCommandRecords(entries, metadata);\\n931:  n(typescript, standalone, 'typescript');\\n932:  n(python, standalone, 'python');\\n\"}],\"providerCall\":{\"executed\":false},\"providerResult\":{\"executed\":false},\"rawInput\":\"{\\\"command\\\":\\\"rg -n \\\\\\\"n|standaloneCommand|function .*standalone|slug\\\\\\\" .skilled/skills/system-skill-advisor/runtime/scripts/command-bridges/derive-command-bridges.cjs | head -30\\\",\\\"workdir\\\":\\\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research\\\"}\"},\"time\":{\"start\":1794528422437,\"end\":1794528423093}}}}\n./specs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/005-recommendation-contract-and-brief/scratch/logs/w6-T027.out:{\"type\":\"tool_use\",\"timestamp\":1794528122233,\"sessionID\":\"ses_e2dcb0be9ffeMCJ7YmLC6El56o\",\"part\":{\"partID\":\"prt_1d236156300268vlXjCWeAjY2O\",\"sessionID\":\"ses_e2dcb0be9ffeMCJ7YmLC6El56o\",\"messageID\":\"msg_1d23604cd001t0DEnGHkth6ZO5\",\"type\":\"tool\",\"id\":\"call_89063cd16ec94411bfd3118b\",\"tool\":\"read\",\"state\":{\"status\":\"completed\",\"input\":{\"limit\":220,\"offset\":1240,\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/scripts/command-bridges/derive-command-bridges.cjs\"},\"output\":\"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/scripts/command-bridges/derive-command-bridges.cjs, lines 1240-1413\\n1240:   // Two blocks share this file, so the second replacement starts from the first\\n1241:   // one's output rather than the file on disk, or one block would overwrite the\\n1242:   // other's fresh render.\\n1243:   const commandAttachWithRows = replaceMarkedBlock(\\n1244:     commandAttach,\\n1245:     COMMAND_ROWS_GENERATED_START,\\n1246:     COMMAND_ROWS_GENERATED_END,\\n1247:     renderCommandRows(entries, policies),\\n1248:     COMMAND_ATTACH_PATH,\\n1249:   );\\n1250:   return [\\n1251:     {\\n1252:       path: TS_PROJECTION_PATH,\\n1253:       current: typescript,\\n1254:       next: replaceMarkedBlock(\\n1255:         typescript,\\n1256:         TS_GENERATED_START,\\n1257:         TS_GENERATED_END,\\n1258:         renderTypescriptProjection(entries),\\n1259:         TS_PROJECTION_PATH,\\n1260:       ),\\n1261:     },\\n1262:     {\\n1263:       path: PY_ADVISOR_PATH,\\n1264:       current: python,\\n1265:       next: replaceMarkedBlock(\\n1266:         python,\\n1267:         PY_GENERATED_START,\\n1268:         PY_GENERATED_END,\\n1269:         renderPythonProjection(entries, pythonOwnerNormalization),\\n1270:         PY_ADVISOR_PATH,\\n1271:       ),\\n1272:     },\\n1273:     {\\n1274:       path: COMMAND_ATTACH_PATH,\\n1275:       current: commandAttach,\\n1276:       next: replaceMarkedBlock(\\n1277:         commandAttachWithRows,\\n1278:         COMMAND_ATTACH_GENERATED_START,\\n1279:         COMMAND_ATTACH_GENERATED_END,\\n1280:         renderModeCommands(modeCommands),\\n1281:         COMMAND_ATTACH_PATH,\\n1282:       ),\\n1283:     },\\n1284:   ];\\n1285: }\\n1286: \\n1287: // ───────────────────────────────────────────────────────────────────\\n1288: // 4. CORE LOGIC\\n1289: // ───────────────────────────────────────────────────────────────────\\n1290: \\n1291: function main() {\\n1292:   // CLI-only rejection: requiring this module (for example from tests) must\\n1293:   // not exit on arguments belonging to the host process.\\n1294:   if (require.main === module) {\\n1295:     const unknownArg = process.argv.slice(2).find((token) => token !== '--check');\\n1296:     if (unknownArg !== undefined) {\\n1297:       console.error(`derive-command-bridges.cjs: unknown option: ${unknownArg}`);\\n1298:       console.error('usage: derive-command-bridges.cjs [--check]');\\n1299:       process.exit(2);\\n1300:     }\\n1301:   }\\n1302:   const checkOnly = process.argv.includes('--check');\\n1303:   const metadata = metadataEntries();\\n1304:   const allowList = allowListEntries();\\n1305:   const doctor = doctorRouteEntries();\\n1306:   // The identity check compares command names against the declarations that make\\n1307:   // a command real; an allow-list row only repeats an ownership id for a command\\n1308:   // the tree and the metadata already name, so it adds nothing there.\\n1309:   const tree = commandTreeNames();\\n1310:   const metadataRisk = metadataRiskRecords();\\n1311:   const doctorRisk = doctorRiskRecords();\\n1312:   const modeCommands = modeCommandRecords();\\n1313:   const violations = identityViolations({\\n1314:     treeCommands: tree,\\n1315:     metadataCommands: metadataRisk.map((record) => record.command),\\n1316:     doctorCommands: doctorRisk.map((record) => record.command),\\n1317:   });\\n1318:   if (violations.length > 0) {\\n1319:     throw new Error(`[command-bridges] command inventory mismatch:\\\\n${violations.join('\\\\n')}`);\\n1320:   }\\n1321:   // A command the allow-list already carries keeps that row's id: both scorers\\n1322:   // know it, and a second id for one command would be a second bridge.\\n1323:   const allowListCommands = new Set(allowList.map((entry) => entry.command));\\n1324:   const bridgedMetadata = metadata.filter((entry) => !allowListCommands.has(entry.command));\\n1325:   const inventory = [...bridgedMetadata, ...allowList, ...doctor]\\n1326:     .sort((left, right) => left.id.localeCompare(right.id));\\n1327:   assertUniqueIds(inventory);\\n1328:   const compatibility = n(inventory, metadata);\\n1329:   const entries = inventory.map((entry) => {\\n1330:     const isDoctor = entry.id.startsWith(DOCTOR_PREFIX);\\n1331:     const typescript = compatibility.typescript.get(entry.id);\\n1332:     const python = compatibility.python.get(entry.id);\\n1333:     // A command nothing describes has nothing written to embed, so the field\\n1334:     // appears only where a source sentence exists for it.\\n1335:     const meaning = typescript ? entryMeaning(entry.id, entry.command, isDoctor) : undefined;\\n1336:     const runtime = { typescript: { enabled: false }, python: { enabled: false } };\\n1337:     if (typescript) {\\n1338:       runtime.typescript = {\\n1339:         enabled: true,\\n1340:         ...(isDoctor ? doctorRuntime(entry.id, 'typescript', typescript) : typescript),\\n1341:       };\\n1342:     }\\n1343:     if (python) {\\n1344:       runtime.python = {\\n1345:         enabled: true,\\n1346:         ...(isDoctor ? doctorRuntime(entry.id, 'python', python) : python),\\n1347:       };\\n1348:     }\\n1349:     return {\\n1350:       ...entry,\\n1351:       ...(meaning ? { embeddingText: commandEmbeddingText(meaning) } : {}),\\n1352:       runtime,\\n1353:     };\\n1354:   });\\n1355: \\n1356:   const policies = commandPolicies();\\n1357:   const projection = {\\n1358:     schemaVersion: 2,\\n1359:     generatedBy: 'scripts/command-bridges/derive-command-bridges.cjs',\