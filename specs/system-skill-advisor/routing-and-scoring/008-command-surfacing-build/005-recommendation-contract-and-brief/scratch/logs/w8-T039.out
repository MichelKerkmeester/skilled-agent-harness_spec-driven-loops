{"type":"tool_use","timestamp":1794529056456,"sessionID":"ses_e2dbc36c0ffexACT5imzdktU7L","part":{"partID":"prt_1d2445562001cc4eknJlZOyBSo","sessionID":"ses_e2dbc36c0ffexACT5imzdktU7L","messageID":"msg_1d244407c001bkzHmzprj1rL2n","type":"tool","id":"call_9a57996e139442fe93913d01","tool":"read","state":{"status":"completed","input":{"path":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/schemas/advisor-tool-schemas.ts"},"output":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/schemas/advisor-tool-schemas.ts, lines 1-637\n1: // ───────────────────────────────────────────────────────────────\n2: // MODULE: Advisor Tool Schemas\n3: // ───────────────────────────────────────────────────────────────\n4: \n5: // ───────────────────────────────────────────────────────────────────\n6: // 1. IMPORTS\n7: // ───────────────────────────────────────────────────────────────────\n8: \n9: import { z } from 'zod';\n10: import { existsSync, realpathSync } from 'node:fs';\n11: import { resolve, sep } from 'node:path';\n12: import { tmpdir } from 'node:os';\n13: import { ADVISOR_RUNTIME_VALUES } from '../lib/advisor-runtime-values.js';\n14: import { SCORER_LANE_IDS } from '../lib/scorer/lane-registry.js';\n15: \n16: // ───────────────────────────────────────────────────────────────────\n17: // 2. CONSTANTS\n18: // ───────────────────────────────────────────────────────────────────\n19: \n20: export const AdvisorFreshnessSchema = z.enum(['live', 'stale', 'absent', 'unavailable']);\n21: export const AdvisorLaneSchema = z.enum(SCORER_LANE_IDS);\n22: \n23: // ───────────────────────────────────────────────────────────────────\n24: // 3. HELPERS\n25: // ───────────────────────────────────────────────────────────────────\n26: \n27: // Bound caller-supplied workspaceRoot inputs to a small\n28: // allowlist (repo root + os.tmpdir()) so handlers cannot be coerced into\n29: // resolving paths outside the workspace. resolve() canonicalizes the input\n30: // path; realpathSync follows symlinks; the prefix check rejects anything\n31: // that escapes the allowlist after canonicalization.\n32: //\n33: // Directory names the source tree may sit under. A checkout may link one to the\n34: // other, so both mark the same tree.\n35: const SOURCE_ROOT_NAMES: readonly string[] = ['.skilled', '.opencode'];\n36: \n37: // Repo root is detected by walking up from process.cwd() looking for the\n38: // system-spec-kit SKILL.md sentinel — same shape as findAdvisorWorkspaceRoot but\n39: // inlined here to avoid a circular import between schemas/ and lib/. The start\n40: // directory is a parameter so the lockstep test can feed both resolvers one tree.\n41: export function detectRepoRoot(start: string = process.cwd()): string {\n42:   // Use the same SKILL.md file sentinel as findAdvisorWorkspaceRoot so the schema\n43:   // and the handler agree on which directory is the workspace root. A bare\n44:   // directory sentinel would match the nested mock trees other workflows create.\n45:   // The source tree sits under `.skilled` or `.opencode`, so the sentinel is\n46:   // tested under both.\n47:   const sentinels = SOURCE_ROOT_NAMES.map((name) => `${name}/skills/system-spec-kit/SKILL.md`);\n48:   let current = resolve(start);\n49:   for (let index = 0; index < 14; index += 1) {\n50:     if (sentinels.some((sentinel) => existsSync(resolve(current, sentinel)))) return current;\n51:     const parent = resolve(current, '..');\n52:     if (parent === current) break;\n53:     current = parent;\n54:   }\n55:   // Lockstep with findAdvisorWorkspaceRoot: when the walk misses the sentinel,\n56:   // never anchor the allowlist on a directory inside a source tree. Take the start\n57:   // or the nearest source-root parent that holds the sentinel, else hoist above the\n58:   // outermost source-root segment, so caller-supplied workspaceRoots are bounded\n59:   // to the real root, not a nested subdir.\n60:   return nearestSentinelHolder(start, sentinels) ?? hoistAboveOpencodeTree(start) ?? resolve(start);\n61: }\n62: \n63: // Inlined twin of lib/utils/workspace-root.ts:nearestSentinelHolder, kept local for\n64: // the same reason as the hoist below. A capped walk misses the sentinel, yet the root\n65: // is still the start or the parent of one source-root segment in the start path, so\n66: // testing the start and then those parents nearest first keeps a repository that\n67: // sits under a directory named .skilled or .opencode.\n68: function nearestSentinelHolder(dir: string, sentinels: readonly string[]): string | null {\n69:   const holdsSentinel = (candidate: string): boolean => sentinels.some((sentinel) => existsSync(resolve(candidate, sentinel)));\n70:   if (holdsSentinel(dir)) return resolve(dir);\n71:   const parts = resolve(dir).split(sep);\n72:   for (let index = parts.length - 1; index >= 1; index -= 1) {\n73:     if (!SOURCE_ROOT_NAMES.includes(parts[index])) continue;\n74:     const parent = parts.slice(0, index).join(sep) || sep;\n75:     if (holdsSentinel(parent)) return parent;\n76:   }\n77:   return null;\n78: }\n79: \n80: // Inlined twin of lib/utils/workspace-root.ts:hoistAboveOpencodeTree. Kept local\n81: // to avoid a circular import between schemas/ and lib/ — the two must stay in\n82: // lockstep so the schema allowlist and the handler agree on the workspace root.\n83: // A `.skilled` or `.opencode` directory is by definition a child of the workspace\n84: // root, so hoisting above the OUTERMOST one yields the real root and can never\n85: // return a path inside a source tree (the earlier specs-only shape missed sibling\n86: // subtrees like skills/).\n87: function hoistAboveOpencodeTree(dir: string): string | null {\n88:   const parts = resolve(dir).split(sep);\n89:   for (let index = 1; index < parts.length; index += 1) {\n90:     if (SOURCE_ROOT_NAMES.includes(parts[index])) {\n91:       return parts.slice(0, index).join(sep) || sep;\n92:     }\n93:   }\n94:   return null;\n95: }\n96: \n97: function canonicalize(input: string): string {\n98:   const resolved = resolve(input);\n99:   try {\n100:     return realpathSync.native(resolved);\n101:   } catch {\n102:     // Path may not exist yet (test fixtures created lazily,\n103:     // tmpdir mkdtemp paths probed before mkdir). Walk up and realpath the\n104:     // first existing ancestor, then re-join the unresolved tail. This\n105:     // resolves macOS-style symlinks like /tmp → /private/tmp even when\n106:     // the leaf doesn't exist.\n107:     let probe = resolved;\n108:     let tail = '';\n109:     for (let depth = 0; depth < 32; depth += 1) {\n110:       const parent = resolve(probe, '..');\n111:       if (parent === probe) break;\n112:       try {\n113:         const realParent = realpathSync.native(parent);\n114:         return tail\n115:           ? resolve(realParent, probe.slice(parent.length + 1) + tail)\n116:           : resolve(realParent, probe.slice(parent.length + 1));\n117:       } catch {\n118:         // Parent doesn't exist either — keep walking up.\n119:         const segment = probe.slice(parent.length + 1);\n120:         tail = tail ? `${segment}/${tail}` : segment;\n121:         probe = parent;\n122:       }\n123:     }\n124:     return resolved;\n125:   }\n126: }\n127: \n128: const SOURCE_REPO_ROOT = canonicalize(detectRepoRoot());\n129: \n130: const ALLOWED_WORKSPACE_PREFIXES: readonly string[] = (() => {\n131:   const prefixes: string[] = [];\n132:   prefixes.push(SOURCE_REPO_ROOT);\n133:   prefixes.push(canonicalize(tmpdir()));\n134:   // Include the canonicalized /tmp prefix as well. On macOS\n135:   // os.tmpdir() returns the per-user temp dir under /var/folders/...; the\n136:   // /tmp symlink resolves to /private/tmp. Test fixtures and tools that\n137:   // hardcode /tmp/foo paths need both forms in the allowlist.\n138:   prefixes.push(canonicalize('/tmp'));\n139:   // Accept additional explicit allowlist via env (CI / test runners).\n140:   const envExtras = process.env.SPECKIT_ADVISOR_WORKSPACE_ALLOWLIST;\n141:   if (envExtras) {\n142:     for (const extra of envExtras.split(':')) {\n143:       const trimmed = extra.trim();\n144:       if (trimmed) prefixes.push(canonicalize(trimmed));\n145:     }\n146:   }\n147:   return Array.from(new Set(prefixes));\n148: })();\n149: \n150: /**\n151:  * Validate that a caller-supplied workspaceRoot resolves under\n152:  * the repo root, os.tmpdir(), or an explicit allowlist entry after\n153:  * realpath canonicalization.\n154:  *\n155:  * Exported so handlers can re-canonicalize at call time and reuse the\n156:  * same bounding logic the schema applies at parse time.\n157:  */\n158: export function isAllowedWorkspaceRoot(input: string): boolean {\n159:   if (!input || typeof input !== 'string') return false;\n160:   const canonical = canonicalize(input);\n161:   return ALLOWED_WORKSPACE_PREFIXES.some(\n162:     (prefix) => canonical === prefix || canonical.startsWith(`${prefix}/`),\n163:   ) || isWiredToSourceTree(canonical);\n164: }\n165: \n166: function realpathOrNull(path: string): string | null {\n167:   try {\n168:     return realpathSync.native(path);\n169:   } catch {\n170:     return null;\n171:   }\n172: }\n173: \n174: /**\n175:  * True when the input, or a directory above it, holds a source-root entry\n176:  * (`.skilled` or `.opencode`) whose realpath is the source tree's own entry.\n177:  *\n178:  * A project linked to a shared checkout holds `.skilled -> <source>/.skilled`\n179:  * while the daemon runs from the source tree, so the prefix allowlist alone\n180:  * refuses every linked project. Matching realpaths admits only a workspace that\n181:  * is actually wired to this source; a copied tree or a link to another source\n182:  * resolves elsewhere and stays refused.\n183:  */\n184: export function isWiredToSourceTree(input: string, sourceRoot: string = SOURCE_REPO_ROOT): boolean {\n185:   if (!input || typeof input !== 'string') return false;\n186:   const sourceEntries = SOURCE_ROOT_NAMES\n187:     .map((name) => realpathOrNull(resolve(sourceRoot, name)))\n188:     .filter((entry): entry is string => entry !== null);\n189:   if (sourceEntries.length === 0) return false;\n190:   let current = canonicalize(input);\n191:   for (let depth = 0; depth < 64; depth += 1) {\n192:     for (const name of SOURCE_ROOT_NAMES) {\n193:       const entry = realpathOrNull(resolve(current, name));\n194:       if (entry !== null && sourceEntries.includes(entry)) return true;\n195:     }\n196:     const parent = resolve(current, '..');\n197:     if (parent === current) break;\n198:     current = parent;\n199:   }\n200:   return false;\n201: }\n202: \n203: // ───────────────────────────────────────────────────────────────────\n204: // 4. SCHEMA DEFINITIONS\n205: // ───────────────────────────────────────────────────────────────────\n206: \n207: const BoundedWorkspaceRootSchema = z\n208:   .string()\n209:   .min(1)\n210:   .refine(isAllowedWorkspaceRoot, {\n211:     message:\n212:       'workspaceRoot must resolve under the repo root, os.tmpdir(), an explicit SPECKIT_ADVISOR_WORKSPACE_ALLOWLIST entry, or a project whose .skilled links to this source tree',\n213:   });\n214: \n215: const laneBreakdownSchema = z.object({\n216:   lane: AdvisorLaneSchema,\n217:   rawScore: z.number().min(0),\n218:   weightedScore: z.number().min(0),\n219:   weight: z.number().min(0),\n220:   shadowOnly: z.boolean(),\n221: }).strict();\n222: \n223: const whyRecommendedLaneSchema = laneBreakdownSchema.extend({\n224:   evidenceTypes: z.array(z.string().min(1)),\n225:   evidenceCount: z.number().int().nonnegative(),\n226: }).strict();\n227: \n228: const whyRecommendedSchema = z.object({\n229:   reason: z.string().min(1),\n230:   dominantLane: AdvisorLaneSchema.nullable(),\n231:   topLanes: z.array(whyRecommendedLaneSchema),\n232:   matchedSkillFeatures: z.array(z.object({\n233:     lane: AdvisorLaneSchema,\n234:     feature: z.string().min(1),\n235:   }).strict()),\n236: }).strict();\n237: \n238: const runtimeLaneHealthSchema = z.object({\n239:   liveLaneCount: z.number().int().nonnegative(),\n240:   degradedLanes: z.array(AdvisorLaneSchema),\n241: }).strict();\n242: \n243: const semanticLaneHealthSchema = z.object({\n244:   activeEmbedder: z.object({\n245:     name: z.string().min(1),\n246:     dim: z.number().int().nonnegative(),\n247:     adapterDim: z.number().int().positive().nullable(),\n248:   }).strict().nullable(),\n249:   vectorCoverage: z.object({\n250:     embedded: z.number().int().nonnegative(),\n251:     total: z.number().int().nonnegative(),\n252:     ratio: z.number().min(0).max(1),\n253:   }).strict(),\n254:   dimMismatch: z.boolean(),\n255:   lastRefresh: z.string().nullable(),\n256:   disabledReason: z.string().nullable(),\n257:   laneEnabled: z.boolean(),\n258:   checkedAt: z.string().datetime(),\n259: }).strict();\n260: \n261: // NOTE (DEFER decision):\n262: // `AdvisorScoringOptions.affordances` (see `lib/scorer/types.ts:94`) is a\n263: // COMPILE-TIME-ONLY internal seam used by the scorer fusion path. Affordance\n264: // evidence is sourced from compiled skill graph metadata via\n265: // `skill_graph_compiler.py` (which emits sanitized `derived.affordances[]`\n266: // nodes), not from public command input. Exposing `affordances` through this\n267: // request schema would re-introduce the prompt-stuffing surface that\n268: // `affordance-normalizer.ts` specifically defends against (URLs, emails,\n269: // instruction-shaped strings, free-form `description` fields). The public\n270: // `advisor_recommend` tool intentionally does NOT accept `affordances`.\n271: // Internal callers that need request-local affordance scoring should invoke\n272: // `scoreAdvisorPrompt` directly with `AdvisorScoringOptions.affordances`.\n273: // advisor_recommend routes on at most this many prompt characters. A caller holding a\n274: // longer prompt sends its head, so a long prompt is routed rather than refused.\n275: export const ADVISOR_PROMPT_MAX_CHARS = 10_000;\n276: \n277: export const AdvisorRecommendInputSchema = z.object({\n278:   // workspaceRoot must resolve under the allowed prefix set.\n279:   workspaceRoot: BoundedWorkspaceRootSchema.optional(),\n280:   prompt: z.string().min(1).max(ADVISOR_PROMPT_MAX_CHARS),\n281:   options: z.object({\n282:     topK: z.number().int().min(1).max(10).optional(),\n283:     includeAttribution: z.boolean().optional(),\n284:     includeAbstainReasons: z.boolean().optional(),\n285:     confidenceThreshold: z.number().min(0).max(1).optional(),\n286:     uncertaintyThreshold: z.number().min(0).max(1).optional(),\n287:     includeCompiledRoute: z.boolean().optional(),\n288:     // Limits the per-hub route lookup to the first recommendation, for a caller\n289:     // on a tight time budget that acts on the top pick alone.\n290:     compiledRouteTopOnly: z.boolean().optional(),\n291:     // Forwarded to the compiled-route front door as --surface-hint; a value\n292:     // that names no known surface is ignored there.\n293:     surfaceHint: z.string().min(1).max(64).optional(),\n294:   }).strict().optional(),\n295: }).strict();\n296: \n297: export const AdvisorRecommendationSchema = z.object({\n298:   skillId: z.string().min(1),\n299:   score: z.number().min(0),\n300:   confidence: z.number().min(0).max(1),\n301:   uncertainty: z.number().min(0).max(1),\n302:   dominantLane: AdvisorLaneSchema.nullable(),\n303:   laneBreakdown: z.array(laneBreakdownSchema).optional(),\n304:   why_recommended: whyRecommendedSchema.optional(),\n305:   matchedDocs: z.array(z.string().min(1)).max(3).optional(),\n306:   redirectFrom: z.array(z.string().min(1)).optional(),\n307:   redirectTo: z.string().min(1).optional(),\n308:   heldBelow: z.string().min(1).optional(),\n309:   status: z.enum(['active', 'deprecated', 'archived', 'future']).optional(),\n310:   workflowMode: z.string().min(1).optional(),\n311:   compiledRoute: z.record(z.string(), z.unknown()).optional(),\n312:   // Names the slash command that runs the recommended skill's resolved mode.\n313:   command: z.string().min(1).optional(),\n314:   // A command-bearing recommendation also says which face it is (a skill or a\n315:   // command row), how a caller may run it, and which skill owns it. Each stays\n316:   // optional so output from a runtime that predates the fields still parses.\n317:   kind: z.enum(['skill', 'command']).optional(),\n318:   policy: z.enum(['run', 'start', 'ask']).optional(),\n319:   ownerSkillId: z.string().min(1).optional(),\n320: }).strict();\n321: \n322: export const AdvisorRecommendOutputSchema = z.object({\n323:   workspaceRoot: z.string().min(1),\n324:   effectiveThresholds: z.object({\n325:     confidenceThreshold: z.number().min(0).max(1),\n326:     uncertaintyThreshold: z.number().min(0).max(1),\n327:     confidenceOnly: z.boolean(),\n328:   }).strict(),\n329:   recommendations: z.array(AdvisorRecommendationSchema),\n330:   ambiguous: z.boolean().optional(),\n331:   freshness: AdvisorFreshnessSchema,\n332:   trustState: z.object({\n333:     state: AdvisorFreshnessSchema,\n334:     reason: z.string().nullable(),\n335:     generation: z.number().int().nonnegative(),\n336:     checkedAt: z.string().datetime(),\n337:     lastLiveAt: z.string().datetime().nullable(),\n338:   }).strict(),\n339:   generatedAt: z.string().datetime(),\n340:   cache: z.object({\n341:     hit: z.boolean(),\n342:     sourceSignaturePresent: z.boolean(),\n343:   }).strict(),\n344:   warnings: z.array(z.string()).optional(),\n345:   abstainReasons: z.array(z.string()).optional(),\n346:   runtimeLaneHealth: runtimeLaneHealthSchema.optional(),\n347:   _shadow: z.object({\n348:     model: z.literal('advisor-shadow-learned-weights-v1'),\n349:     liveWeightsFrozen: z.boolean(),\n350:     recommendations: z.array(z.object({\n351:       skillId: z.string().min(1),\n352:       liveScore: z.number().min(0),\n353:       shadowScore: z.number().min(0),\n354:       delta: z.number(),\n355:       dominantShadowLane: AdvisorLaneSchema.nullable(),\n356:     }).strict()),\n357:   }).strict().optional(),\n358: }).strict();\n359: \n360: export const AdvisorStatusInputSchema = z.object({\n361:   // Bound workspaceRoot to allowed prefix set.\n362:   workspaceRoot: BoundedWorkspaceRootSchema,\n363:   maxMetadataFiles: z.number().int().positive().max(10_000).optional(),\n364:   includeSemanticHealth: z.boolean().optional(),\n365:   includeEmbeddingsHealth: z.boolean().optional(),\n366:   // Run a read-only SQLite quick_check on the artifact so genuine corruption\n367:   // downgrades freshness to stale (and advisor_rebuild repairs it). Off by\n368:   // default so the read-style advisor_recommend path pays no per-call probe;\n369:   // the advisor_status diagnostic and advisor_rebuild pre-read opt in.\n370:   checkArtifactIntegrity: z.boolean().optional(),\n371:   debug: z.boolean().optional(),\n372: }).strict();\n373: \n374: const embeddingsHealthSchema = z.object({\n375:   checkedAt: z.string().datetime(),\n376:   provider: z.discriminatedUnion('state', [\n377:     z.object({\n378:       state: z.literal('resolved'),\n379:       requestedProvider: z.string(),\n380:       effectiveProvider: z.string(),\n381:       fallbackReason: z.string().nullable(),\n382:       dimensionChanged: z.boolean(),\n383:       reason: z.string(),\n384:     }).strict(),\n385:     z.object({\n386:       state: z.literal('unavailable'),\n387:       error: z.string().max(200),\n388:     }).strict(),\n389:   ]),\n390:   modelServer: z.discriminatedUnion('state', [\n391:     z.object({\n392:       state: z.literal('reachable'),\n393:       target: z.string().min(1),\n394:       serverState: z.string().nullable(),\n395:       model: z.string().nullable(),\n396:       dim: z.number().nullable(),\n397:       device: z.string().nullable(),\n398:       loadTimeMs: z.number().nullable(),\n399:       loadStartedAt: z.string().nullable(),\n400:       loadProgressAt: z.string().nullable(),\n401:       lastSuccessfulEmbedAt: z.string().nullable(),\n402:       inFlight: z.number().nullable(),\n403:       queueDepth: z.number().nullable(),\n404:       error: z.string().nullable(),\n405:     }).strict(),\n406:     z.object({\n407:       state: z.literal('unavailable'),\n408:       target: z.string().min(1),\n409:       errorClass: z.enum(['unreachable', 'timeout', 'bad_response', 'probe_failed']),\n410:       error: z.string(),\n411:     }).strict(),\n412:   ]),\n413: }).strict();\n414: \n415: export const AdvisorStatusOutputSchema = z.object({\n416:   freshness: AdvisorFreshnessSchema,\n417:   generation: z.number().int().nonnegative(),\n418:   trustState: z.object({\n419:     state: AdvisorFreshnessSchema,\n420:     reason: z.string().nullable(),\n421:     generation: z.number().int().nonnegative(),\n422:     checkedAt: z.string().datetime(),\n423:     lastLiveAt: z.string().datetime().nullable(),\n424:   }).strict(),\n425:   lastGenerationBump: z.string().datetime().nullable(),\n426:   lastScanAt: z.string().datetime().nullable(),\n427:   skillCount: z.number().int().nonnegative(),\n428:   indexStaleness: z.object({\n429:     state: z.enum(['fresh', 'stale', 'unavailable']),\n430:     reason: z.string().nullable(),\n431:     trackedSkills: z.number().int().nonnegative(),\n432:     freshSourceFiles: z.number().int().nonnegative(),\n433:     changedSourceFiles: z.number().int().nonnegative(),\n434:     missingSourceFiles: z.number().int().nonnegative(),\n435:     staleSkillIds: z.array(z.string()),\n436:   }).strict().optional(),\n437:   laneWeights: z.record(AdvisorLaneSchema, z.number().min(0)),\n438:   semanticLaneHealth: semanticLaneHealthSchema.optional(),\n439:   embeddingsHealth: embeddingsHealthSchema.optional(),\n440:   daemonPid: z.number().int().positive().optional(),\n441:   errors: z.array(z.string()).optional(),\n442: }).strict();\n443: \n444: export const AdvisorRebuildInputSchema = z.object({\n445:   force: z.boolean().optional(),\n446:   // Bound workspaceRoot to allowed prefix set.\n447:   workspaceRoot: BoundedWorkspaceRootSchema.optional(),\n448: }).strict();\n449: \n450: export const AdvisorRebuildOutputSchema = z.object({\n451:   rebuilt: z.boolean(),\n452:   skipped: z.boolean(),\n453:   reason: z.enum(['status-live', 'stale', 'absent', 'unavailable', 'force']),\n454:   freshnessBefore: AdvisorFreshnessSchema,\n455:   freshnessAfter: AdvisorFreshnessSchema,\n456:   generationBefore: z.number().int().nonnegative(),\n457:   generationAfter: z.number().int().nonnegative(),\n458:   skillCount: z.number().int().nonnegative(),\n459:   summary: z.record(z.string(), z.unknown()).nullable(),\n460:   diagnostics: z.array(z.string()),\n461: }).strict();\n462: \n463: export const AdvisorValidateInputSchema = z.object({\n464:   confirmHeavyRun: z.literal(true),\n465:   // Bound workspaceRoot to allowed prefix set.\n466:   workspaceRoot: BoundedWorkspaceRootSchema.optional(),\n467:   skillSlug: z.string().min(1).nullable().optional(),\n468:   // Outcome events carry only skill ids + the accept/correct/ignore signal —\n469:   // never the prompt, scenario, or expected skill. This omission is deliberate\n470:   // prompt-safety: telemetry must not store routable prompt content. The\n471:   // consequence is that real misroutes cannot be harvested from telemetry into\n472:   // gold regression cases; gold cases are authored by hand, not reconstructed.\n473:   // Capturing prompts to close that gap would violate the prompt-safety\n474:   // invariant and is intentionally not supported.\n475:   outcomeEvents: z.array(z.object({\n476:     runtime: z.enum(ADVISOR_RUNTIME_VALUES),\n477:     outcome: z.enum(['accepted', 'corrected', 'ignored']),\n478:     skillId: z.string().min(1),\n479:     correctedSkillId: z.string().min(1).optional(),\n480:     timestamp: z.string().datetime().optional(),\n481:   }).strict()).optional(),\n482: }).strict();\n483: \n484: const validationSliceSchema = z.object({\n485:   percentage: z.number().min(0).max(1),\n486:   passed: z.boolean(),\n487:   threshold: z.number().min(0).max(1).optional(),\n488:   count: z.object({\n489:     passed: z.number().int().nonnegative(),\n490:     total: z.number().int().nonnegative(),\n491:   }).strict(),\n492: }).strict();\n493: \n494: // A named data-slice accuracy gate. Extends the generic validation slice with\n495: // `minN` (the minimum row count below which the slice is statistically\n496: // meaningless and fails, guarding against a corpus edit silently shrinking a\n497: // bucket) and `top1` (the strict top-1 accuracy for the slice, surfaced\n498: // explicitly so operators read the bucket's accuracy without recomputing it\n499: // from `count`).\n500: const bucketSliceSchema = validationSliceSchema.extend({\n501:   minN: z.number().int().positive(),\n502:   top1: z.number().min(0).max(1),\n503: }).strict();\n504: \n505: const advisorValidateAggregateValidationSchema = z.object({\n506:   fullCorpusTop1: z.number().min(0).max(1),\n507:   holdoutTop1: z.number().min(0).max(1),\n508:   perSkillTop1: z.number().min(0).max(1),\n509:   unknownCountTargetMax: z.number().int().nonnegative(),\n510: }).strict().describe('Release-gate thresholds for full corpus, holdout, per-skill accuracy, and UNKNOWN counts.');\n511: \n512: const advisorValidateRuntimeRoutingSchema = z.object({\n513:   confidenceThreshold: z.number().min(0).max(1),\n514:   uncertaintyThreshold: z.number().min(0).max(1),\n515:   confidenceOnly: z.boolean(),\n516: }).strict().describe('Live runtime routing thresholds surfaced by advisor_validate so manual checks can compare runtime semantics with release gates.');\n517: \n518: const advisorValidateTelemetryDiagnosticsSchema = z.object({\n519:   recordsPath: z.string().min(1),\n520:   recordsRetained: z.number().int().nonnegative(),\n521:   rollingCacheHitRate: z.number().min(0).max(1),\n522:   rollingP95Ms: z.number().min(0),\n523:   rollingFailOpenRate: z.number().min(0).max(1),\n524: }).strict().describe('Prompt-safe rolling diagnostics from retained advisor hook telemetry records.');\n525: \n526: const advisorValidateTelemetryScopeSchema = z.object({\n527:   kind: z.enum(['workspace', 'skill']),\n528:   skillSlug: z.string().min(1).nullable(),\n529: }).strict().describe('Whether recorded outcome totals are workspace-wide or scoped to the selected skillSlug.');\n530: \n531: const advisorValidateOutcomeTotalsSchema = z.object({\n532:   accepted: z.number().int().nonnegative(),\n533:   corrected: z.number().int().nonnegative(),\n534:   ignored: z.number().int().nonnegative(),\n535: }).strict().describe('Recorded outcome totals retained for the active workspace or skill scope.');\n536: \n537: const advisorValidateTelemetryOutcomesSchema = z.object({\n538:   recordsPath: z.string().min(1),\n539:   recordedThisRun: z.number().int().nonnegative(),\n540:   scope: advisorValidateTelemetryScopeSchema,\n541:   totals: advisorValidateOutcomeTotalsSchema,\n542: }).strict().describe('Outcome recording summary, including injected event count and retained accepted/corrected/ignored totals.');\n543: \n544: export const AdvisorValidateOutputSchema = z.object({\n545:   workspaceRoot: z.string().min(1),\n546:   skillSlug: z.string().nullable(),\n547:   thresholdSemantics: z.object({\n548:     aggregateValidation: advisorValidateAggregateValidationSchema,\n549:     runtimeRouting: advisorValidateRuntimeRoutingSchema,\n550:   }).strict().describe('Public threshold contract for advisor_validate, covering release-gate scoring and runtime-routing semantics.'),\n551:   overallAccuracy: z.number().min(0).max(1),\n552:   perSkill: z.array(z.object({\n553:     skillId: z.string().min(1),\n554:     status: z.enum(['pass', 'fail', 'skipped']),\n555:     matched: z.number().int().nonnegative(),\n556:     total: z.number().int().nonnegative(),\n557:   }).strict()),\n558:   slices: z.object({\n559:     corpus: z.object({\n560:       full_corpus_top1: validationSliceSchema,\n561:       unknown_count: z.object({\n562:         value: z.number().int().nonnegative(),\n563:         targetMax: z.number().int().nonnegative(),\n564:         passed: z.boolean(),\n565:       }).strict(),\n566:       gold_none_false_fire_count: z.object({\n567:         value: z.number().int().nonnegative(),\n568:         baselineDelta: z.number().int(),\n569:       }).strict(),\n570:     }).strict(),\n571:     holdout: z.object({\n572:       holdout_top1: validationSliceSchema,\n573:     }).strict(),\n574:     parity: z.object({\n575:       explicit_skill_top1_regression: z.object({\n576:         passed: z.boolean(),\n577:         regressions: z.array(z.string()),\n578:       }).strict(),\n579:       ambiguity_slice_stable: z.object({\n580:         passed: z.boolean(),\n581:         top2Within005: z.boolean(),\n582:       }).strict(),\n583:       derived_lane_attribution_complete: z.boolean(),\n584:     }).strict(),\n585:     safety: z.object({\n586:       adversarial_stuffing_blocked: z.object({\n587:         passed: z.boolean(),\n588:         fixtureCount: z.number().int().nonnegative(),\n589:       }).strict(),\n590:     }).strict(),\n591:     latency: z.object({\n592:       regression_suite_status: z.object({\n593:         p0PassRate: z.number().min(0).max(1),\n594:         failedCount: z.number().int().nonnegative(),\n595:         commandBridgeFalsePositiveRate: z.number().min(0).max(1),\n596:         cacheHitP95Ms: z.number().min(0),\n597:         uncachedP95Ms: z.number().min(0),\n598:       }).strict(),\n599:     }).strict(),\n600:     // Named per-intent accuracy buckets. review/memory_save are corpus rows\n601:     // grouped by their labeled bucket; delegation is the shared executor-routing\n602:     // fixture (the training corpus carries no honest executor-delegation signal).\n603:     // Each is a first-class accuracy gate so a regression confined to one intent\n604:     // class stays visible even when the aggregate corpus number holds.\n605:     buckets: z.object({\n606:       review: bucketSliceSchema,\n607:       memory_save: bucketSliceSchema,\n608:       delegation: bucketSliceSchema,\n609:     }).strict(),\n610:   }).strict(),\n611:   telemetry: z.object({\n612:     diagnostics: advisorValidateTelemetryDiagnosticsSchema,\n613:     outcomes: advisorValidateTelemetryOutcomesSchema,\n614:   }).strict().describe('Prompt-safe telemetry diagnostics and recorded outcome summaries exposed for operator validation.'),\n615:   generatedAt: z.string().datetime(),\n616: }).strict();\n617: \n618: // ───────────────────────────────────────────────────────────────────\n619: // 5. EXPORTS\n620: // ───────────────────────────────────────────────────────────────────\n621: \n622: export type AdvisorFreshness = z.infer<typeof AdvisorFreshnessSchema>;\n623: export type AdvisorRecommendInput = z.infer<typeof AdvisorRecommendInputSchema>;\n624: export type AdvisorRecommendOutput = z.infer<typeof AdvisorRecommendOutputSchema>;\n625: export type AdvisorRebuildInput = z.infer<typeof AdvisorRebuildInputSchema>;\n626: export type AdvisorRebuildOutput = z.infer<typeof AdvisorRebuildOutputSchema>;\n627: export type AdvisorStatusInput = z.infer<typeof AdvisorStatusInputSchema>;\n628: export type AdvisorStatusOutput = z.infer<typeof AdvisorStatusOutputSchema>;\n629: export type AdvisorValidateInput = z.infer<typeof AdvisorValidateInputSchema>;\n630: export type AdvisorValidateOutput = z.infer<typeof AdvisorValidateOutputSchema>;\n631: \n632: export const AdvisorToolInputSchemas = {\n633:   advisor_recommend: AdvisorRecommendInputSchema,\n634:   advisor_rebuild: AdvisorRebuildInputSchema,\n635:   advisor_status: AdvisorStatusInputSchema,\n636:   advisor_validate: AdvisorValidateInputSchema,\n637: } as const;","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/schemas/advisor-tool-schemas.ts, lines 1-637\n1: // ───────────────────────────────────────────────────────────────\n2: // MODULE: Advisor Tool Schemas\n3: // ───────────────────────────────────────────────────────────────\n4: \n5: // ───────────────────────────────────────────────────────────────────\n6: // 1. IMPORTS\n7: // ───────────────────────────────────────────────────────────────────\n8: \n9: import { z } from 'zod';\n10: import { existsSync, realpathSync } from 'node:fs';\n11: import { resolve, sep } from 'node:path';\n12: import { tmpdir } from 'node:os';\n13: import { ADVISOR_RUNTIME_VALUES } from '../lib/advisor-runtime-values.js';\n14: import { SCORER_LANE_IDS } from '../lib/scorer/lane-registry.js';\n15: \n16: // ───────────────────────────────────────────────────────────────────\n17: // 2. CONSTANTS\n18: // ───────────────────────────────────────────────────────────────────\n19: \n20: export const AdvisorFreshnessSchema = z.enum(['live', 'stale', 'absent', 'unavailable']);\n21: export const AdvisorLaneSchema = z.enum(SCORER_LANE_IDS);\n22: \n23: // ───────────────────────────────────────────────────────────────────\n24: // 3. HELPERS\n25: // ───────────────────────────────────────────────────────────────────\n26: \n27: // Bound caller-supplied workspaceRoot inputs to a small\n28: // allowlist (repo root + os.tmpdir()) so handlers cannot be coerced into\n29: // resolving paths outside the workspace. resolve() canonicalizes the input\n30: // path; realpathSync follows symlinks; the prefix check rejects anything\n31: // that escapes the allowlist after canonicalization.\n32: //\n33: // Directory names the source tree may sit under. A checkout may link one to the\n34: // other, so both mark the same tree.\n35: const SOURCE_ROOT_NAMES: readonly string[] = ['.skilled', '.opencode'];\n36: \n37: // Repo root is detected by walking up from process.cwd() looking for the\n38: // system-spec-kit SKILL.md sentinel — same shape as findAdvisorWorkspaceRoot but\n39: // inlined here to avoid a circular import between schemas/ and lib/. The start\n40: // directory is a parameter so the lockstep test can feed both resolvers one tree.\n41: export function detectRepoRoot(start: string = process.cwd()): string {\n42:   // Use the same SKILL.md file sentinel as findAdvisorWorkspaceRoot so the schema\n43:   // and the handler agree on which directory is the workspace root. A bare\n44:   // directory sentinel would match the nested mock trees other workflows create.\n45:   // The source tree sits under `.skilled` or `.opencode`, so the sentinel is\n46:   // tested under both.\n47:   const sentinels = SOURCE_ROOT_NAMES.map((name) => `${name}/skills/system-spec-kit/SKILL.md`);\n48:   let current = resolve(start);\n49:   for (let index = 0; index < 14; index += 1) {\n50:     if (sentinels.some((sentinel) => existsSync(resolve(current, sentinel)))) return current;\n51:     const parent = resolve(current, '..');\n52:     if (parent === current) break;\n53:     current = parent;\n54:   }\n55:   // Lockstep with findAdvisorWorkspaceRoot: when the walk misses the sentinel,\n56:   // never anchor the allowlist on a directory inside a source tree. Take the start\n57:   // or the nearest source-root parent that holds the sentinel, else hoist above the\n58:   // outermost source-root segment, so caller-supplied workspaceRoots are bounded\n59:   // to the real root, not a nested subdir.\n60:   return nearestSentinelHolder(start, sentinels) ?? hoistAboveOpencodeTree(start) ?? resolve(start);\n61: }\n62: \n63: // Inlined twin of lib/utils/workspace-root.ts:nearestSentinelHolder, kept local for\n64: // the same reason as the hoist below. A capped walk misses the sentinel, yet the root\n65: // is still the start or the parent of one source-root segment in the start path, so\n66: // testing the start and then those parents nearest first keeps a repository that\n67: // sits under a directory named .skilled or .opencode.\n68: function nearestSentinelHolder(dir: string, sentinels: readonly string[]): string | null {\n69:   const holdsSentinel = (candidate: string): boolean => sentinels.some((sentinel) => existsSync(resolve(candidate, sentinel)));\n70:   if (holdsSentinel(dir)) return resolve(dir);\n71:   const parts = resolve(dir).split(sep);\n72:   for (let index = parts.length - 1; index >= 1; index -= 1) {\n73:     if (!SOURCE_ROOT_NAMES.includes(parts[index])) continue;\n74:     const parent = parts.slice(0, index).join(sep) || sep;\n75:     if (holdsSentinel(parent)) return parent;\n76:   }\n77:   return null;\n78: }\n79: \n80: // Inlined twin of lib/utils/workspace-root.ts:hoistAboveOpencodeTree. Kept local\n81: // to avoid a circular import between schemas/ and lib/ — the two must stay in\n82: // lockstep so the schema allowlist and the handler agree on the workspace root.\n83: // A `.skilled` or `.opencode` directory is by definition a child of the workspace\n84: // root, so hoisting above the OUTERMOST one yields the real root and can never\n85: // return a path inside a source tree (the earlier specs-only shape missed sibling\n86: // subtrees like skills/).\n87: function hoistAboveOpencodeTree(dir: string): string | null {\n88:   const parts = resolve(dir).split(sep);\n89:   for (let index = 1; index < parts.length; index += 1) {\n90:     if (SOURCE_ROOT_NAMES.includes(parts[index])) {\n91:       return parts.slice(0, index).join(sep) || sep;\n92:     }\n93:   }\n94:   return null;\n95: }\n96: \n97: function canonicalize(input: string): string {\n98:   const resolved = resolve(input);\n99:   try {\n100:     return realpathSync.native(resolved);\n101:   } catch {\n102:     // Path may not exist yet (test fixtures created lazily,\n103:     // tmpdir mkdtemp paths probed before mkdir). Walk up and realpath the\n104:     // first existing ancestor, then re-join the unresolved tail. This\n105:     // resolves macOS-style symlinks like /tmp → /private/tmp even when\n106:     // the leaf doesn't exist.\n107:     let probe = resolved;\n108:     let tail = '';\n109:     for (let depth = 0; depth < 32; depth += 1) {\n110:       const parent = resolve(probe, '..');\n111:       if (parent === probe) break;\n112:       try {\n113:         const realParent = realpathSync.native(parent);\n114:         return tail\n115:           ? resolve(realParent, probe.slice(parent.length + 1) + tail)\n116:           : resolve(realParent, probe.slice(parent.length + 1));\n117:       } catch {\n118:         // Parent doesn't exist either — keep walking up.\n119:         const segment = probe.slice(parent.length + 1);\n120:         tail = tail ? `${segment}/${tail}` : segment;\n121:         probe = parent;\n122:       }\n123:     }\n124:     return resolved;\n125:   }\n126: }\n127: \n128: const SOURCE_REPO_ROOT = canonicalize(detectRepoRoot());\n129: \n130: const ALLOWED_WORKSPACE_PREFIXES: readonly string[] = (() => {\n131:   const prefixes: string[] = [];\n132:   prefixes.push(SOURCE_REPO_ROOT);\n133:   prefixes.push(canonicalize(tmpdir()));\n134:   // Include the canonicalized /tmp prefix as well. On macOS\n135:   // os.tmpdir() returns the per-user temp dir under /var/folders/...; the\n136:   // /tmp symlink resolves to /private/tmp. Test fixtures and tools that\n137:   // hardcode /tmp/foo paths need both forms in the allowlist.\n138:   prefixes.push(canonicalize('/tmp'));\n139:   // Accept additional explicit allowlist via env (CI / test runners).\n140:   const envExtras = process.env.SPECKIT_ADVISOR_WORKSPACE_ALLOWLIST;\n141:   if (envExtras) {\n142:     for (const extra of envExtras.split(':')) {\n143:       const trimmed = extra.trim();\n144:       if (trimmed) prefixes.push(canonicalize(trimmed));\n145:     }\n146:   }\n147:   return Array.from(new Set(prefixes));\n148: })();\n149: \n150: /**\n151:  * Validate that a caller-supplied workspaceRoot resolves under\n152:  * the repo root, os.tmpdir(), or an explicit allowlist entry after\n153:  * realpath canonicalization.\n154:  *\n155:  * Exported so handlers can re-canonicalize at call time and reuse the\n156:  * same bounding logic the schema applies at parse time.\n157:  */\n158: export function isAllowedWorkspaceRoot(input: string): boolean {\n159:   if (!input || typeof input !== 'string') return false;\n160:   const canonical = canonicalize(input);\n161:   return ALLOWED_WORKSPACE_PREFIXES.some(\n162:     (prefix) => canonical === prefix || canonical.startsWith(`${prefix}/`),\n163:   ) || isWiredToSourceTree(canonical);\n164: }\n165: \n166: function realpathOrNull(path: string): string | null {\n167:   try {\n168:     return realpathSync.native(path);\n169:   } catch {\n170:     return null;\n171:   }\n172: }\n173: \n174: /**\n175:  * True when the input, or a directory above it, holds a source-root entry\n176:  * (`.skilled` or `.opencode`) whose realpath is the source tree's own entry.\n177:  *\n178:  * A project linked to a shared checkout holds `.skilled -> <source>/.skilled`\n179:  * while the daemon runs from the source tree, so the prefix allowlist alone\n180:  * refuses every linked project. Matching realpaths admits only a workspace that\n181:  * is actually wired to this source; a copied tree or a link to another source\n182:  * resolves elsewhere and stays refused.\n183:  */\n184: export function isWiredToSourceTree(input: string, sourceRoot: string = SOURCE_REPO_ROOT): boolean {\n185:   if (!input || typeof input !== 'string') return false;\n186:   const sourceEntries = SOURCE_ROOT_NAMES\n187:     .map((name) => realpathOrNull(resolve(sourceRoot, name)))\n188:     .filter((entry): entry is string => entry !== null);\n189:   if (sourceEntries.length === 0) return false;\n190:   let current = canonicalize(input);\n191:   for (let depth = 0; depth < 64; depth += 1) {\n192:     for (const name of SOURCE_ROOT_NAMES) {\n193:       const entry = realpathOrNull(resolve(current, name));\n194:       if (entry !== null && sourceEntries.includes(entry)) return true;\n195:     }\n196:     const parent = resolve(current, '..');\n197:     if (parent === current) break;\n198:     current = parent;\n199:   }\n200:   return false;\n201: }\n202: \n203: // ───────────────────────────────────────────────────────────────────\n204: // 4. SCHEMA DEFINITIONS\n205: // ───────────────────────────────────────────────────────────────────\n206: \n207: const BoundedWorkspaceRootSchema = z\n208:   .string()\n209:   .min(1)\n210:   .refine(isAllowedWorkspaceRoot, {\n211:     message:\n212:       'workspaceRoot must resolve under the repo root, os.tmpdir(), an explicit SPECKIT_ADVISOR_WORKSPACE_ALLOWLIST entry, or a project whose .skilled links to this source tree',\n213:   });\n214: \n215: const laneBreakdownSchema = z.object({\n216:   lane: AdvisorLaneSchema,\n217:   rawScore: z.number().min(0),\n218:   weightedScore: z.number().min(0),\n219:   weight: z.number().min(0),\n220:   shadowOnly: z.boolean(),\n221: }).strict();\n222: \n223: const whyRecommendedLaneSchema = laneBreakdownSchema.extend({\n224:   evidenceTypes: z.array(z.string().min(1)),\n225:   evidenceCount: z.number().int().nonnegative(),\n226: }).strict();\n227: \n228: const whyRecommendedSchema = z.object({\n229:   reason: z.string().min(1),\n230:   dominantLane: AdvisorLaneSchema.nullable(),\n231:   topLanes: z.array(whyRecommendedLaneSchema),\n232:   matchedSkillFeatures: z.array(z.object({\n233:     lane: AdvisorLaneSchema,\n234:     feature: z.string().min(1),\n235:   }).strict()),\n236: }).strict();\n237: \n238: const runtimeLaneHealthSchema = z.object({\n239:   liveLaneCount: z.number().int().nonnegative(),\n240:   degradedLanes: z.array(AdvisorLaneSchema),\n241: }).strict();\n242: \n243: const semanticLaneHealthSchema = z.object({\n244:   activeEmbedder: z.object({\n245:     name: z.string().min(1),\n246:     dim: z.number().int().nonnegative(),\n247:     adapterDim: z.number().int().positive().nullable(),\n248:   }).strict().nullable(),\n249:   vectorCoverage: z.object({\n250:     embedded: z.number().int().nonnegative(),\n251:     total: z.number().int().nonnegative(),\n252:     ratio: z.number().min(0).max(1),\n253:   }).strict(),\n254:   dimMismatch: z.boolean(),\n255:   lastRefresh: z.string().nullable(),\n256:   disabledReason: z.string().nullable(),\n257:   laneEnabled: z.boolean(),\n258:   checkedAt: z.string().datetime(),\n259: }).strict();\n260: \n261: // NOTE (DEFER decision):\n262: // `AdvisorScoringOptions.affordances` (see `lib/scorer/types.ts:94`) is a\n263: // COMPILE-TIME-ONLY internal seam used by the scorer fusion path. Affordance\n264: // evidence is sourced from compiled skill graph metadata via\n265: // `skill_graph_compiler.py` (which emits sanitized `derived.affordances[]`\n266: // nodes), not from public command input. Exposing `affordances` through this\n267: // request schema would re-introduce the prompt-stuffing surface that\n268: // `affordance-normalizer.ts` specifically defends against (URLs, emails,\n269: // instruction-shaped strings, free-form `description` fields). The public\n270: // `advisor_recommend` tool intentionally does NOT accept `affordances`.\n271: // Internal callers that need request-local affordance scoring should invoke\n272: // `scoreAdvisorPrompt` directly with `AdvisorScoringOptions.affordances`.\n273: // advisor_recommend routes on at most this many prompt characters. A caller holding a\n274: // longer prompt sends its head, so a long prompt is routed rather than refused.\n275: export const ADVISOR_PROMPT_MAX_CHARS = 10_000;\n276: \n277: export const AdvisorRecommendInputSchema = z.object({\n278:   // workspaceRoot must resolve under the allowed prefix set.\n279:   workspaceRoot: BoundedWorkspaceRootSchema.optional(),\n280:   prompt: z.string().min(1).max(ADVISOR_PROMPT_MAX_CHARS),\n281:   options: z.object({\n282:     topK: z.number().int().min(1).max(10).optional(),\n283:     includeAttribution: z.boolean().optional(),\n284:     includeAbstainReasons: z.boolean().optional(),\n285:     confidenceThreshold: z.number().min(0).max(1).optional(),\n286:     uncertaintyThreshold: z.number().min(0).max(1).optional(),\n287:     includeCompiledRoute: z.boolean().optional(),\n288:     // Limits the per-hub route lookup to the first recommendation, for a caller\n289:     // on a tight time budget that acts on the top pick alone.\n290:     compiledRouteTopOnly: z.boolean().optional(),\n291:     // Forwarded to the compiled-route front door as --surface-hint; a value\n292:     // that names no known surface is ignored there.\n293:     surfaceHint: z.string().min(1).max(64).optional(),\n294:   }).strict().optional(),\n295: }).strict();\n296: \n297: export const AdvisorRecommendationSchema = z.object({\n298:   skillId: z.string().min(1),\n299:   score: z.number().min(0),\n300:   confidence: z.number().min(0).max(1),\n301:   uncertainty: z.number().min(0).max(1),\n302:   dominantLane: AdvisorLaneSchema.nullable(),\n303:   laneBreakdown: z.array(laneBreakdownSchema).optional(),\n304:   why_recommended: whyRecommendedSchema.optional(),\n305:   matchedDocs: z.array(z.string().min(1)).max(3).optional(),\n306:   redirectFrom: z.array(z.string().min(1)).optional(),\n307:   redirectTo: z.string().min(1).optional(),\n308:   heldBelow: z.string().min(1).optional(),\n309:   status: z.enum(['active', 'deprecated', 'archived', 'future']).optional(),\n310:   workflowMode: z.string().min(1).optional(),\n311:   compiledRoute: z.record(z.string(), z.unknown()).optional(),\n312:   // Names the slash command that runs the recommended skill's resolved mode.\n313:   command: z.string().min(1).optional(),\n314:   // A command-bearing recommendation also says which face it is (a skill or a\n315:   // command row), how a caller may run it, and which skill owns it. Each stays\n316:   // optional so output from a runtime that predates the fields still parses.\n317:   kind: z.enum(['skill', 'command']).optional(),\n318:   policy: z.enum(['run', 'start', 'ask']).optional(),\n319:   ownerSkillId: z.string().min(1).optional(),\n320: }).strict();\n321: \n322: export const AdvisorRecommendOutputSchema = z.object({\n323:   workspaceRoot: z.string().min(1),\n324:   effectiveThresholds: z.object({\n325:     confidenceThreshold: z.number().min(0).max(1),\n326:     uncertaintyThreshold: z.number().min(0).max(1),\n327:     confidenceOnly: z.boolean(),\n328:   }).strict(),\n329:   recommendations: z.array(AdvisorRecommendationSchema),\n330:   ambiguous: z.boolean().optional(),\n331:   freshness: AdvisorFreshnessSchema,\n332:   trustState: z.object({\n333:     state: AdvisorFreshnessSchema,\n334:     reason: z.string().nullable(),\n335:     generation: z.number().int().nonnegative(),\n336:     checkedAt: z.string().datetime(),\n337:     lastLiveAt: z.string().datetime().nullable(),\n338:   }).strict(),\n339:   generatedAt: z.string().datetime(),\n340:   cache: z.object({\n341:     hit: z.boolean(),\n342:     sourceSignaturePresent: z.boolean(),\n343:   }).strict(),\n344:   warnings: z.array(z.string()).optional(),\n345:   abstainReasons: z.array(z.string()).optional(),\n346:   runtimeLaneHealth: runtimeLaneHealthSchema.optional(),\n347:   _shadow: z.object({\n348:     model: z.literal('advisor-shadow-learned-weights-v1'),\n349:     liveWeightsFrozen: z.boolean(),\n350:     recommendations: z.array(z.object({\n351:       skillId: z.string().min(1),\n352:       liveScore: z.number().min(0),\n353:       shadowScore: z.number().min(0),\n354:       delta: z.number(),\n355:       dominantShadowLane: AdvisorLaneSchema.nullable(),\n356:     }).strict()),\n357:   }).strict().optional(),\n358: }).strict();\n359: \n360: export const AdvisorStatusInputSchema = z.object({\n361:   // Bound workspaceRoot to allowed prefix set.\n362:   workspaceRoot: BoundedWorkspaceRootSchema,\n363:   maxMetadataFiles: z.number().int().positive().max(10_000).optional(),\n364:   includeSemanticHealth: z.boolean().optional(),\n365:   includeEmbeddingsHealth: z.boolean().optional(),\n366:   // Run a read-only SQLite quick_check on the artifact so genuine corruption\n367:   // downgrades freshness to stale (and advisor_rebuild repairs it). Off by\n368:   // default so the read-style advisor_recommend path pays no per-call probe;\n369:   // the advisor_status diagnostic and advisor_rebuild pre-read opt in.\n370:   checkArtifactIntegrity: z.boolean().optional(),\n371:   debug: z.boolean().optional(),\n372: }).strict();\n373: \n374: const embeddingsHealthSchema = z.object({\n375:   checkedAt: z.string().datetime(),\n376:   provider: z.discriminatedUnion('state', [\n377:     z.object({\n378:       state: z.literal('resolved'),\n379:       requestedProvider: z.string(),\n380:       effectiveProvider: z.string(),\n381:       fallbackReason: z.string().nullable(),\n382:       dimensionChanged: z.boolean(),\n383:       reason: z.string(),\n384:     }).strict(),\n385:     z.object({\n386:       state: z.literal('unavailable'),\n387:       error: z.string().max(200),\n388:     }).strict(),\n389:   ]),\n390:   modelServer: z.discriminatedUnion('state', [\n391:     z.object({\n392:       state: z.literal('reachable'),\n393:       target: z.string().min(1),\n394:       serverState: z.string().nullable(),\n395:       model: z.string().nullable(),\n396:       dim: z.number().nullable(),\n397:       device: z.string().nullable(),\n398:       loadTimeMs: z.number().nullable(),\n399:       loadStartedAt: z.string().nullable(),\n400:       loadProgressAt: z.string().nullable(),\n401:       lastSuccessfulEmbedAt: z.string().nullable(),\n402:       inFlight: z.number().nullable(),\n403:       queueDepth: z.number().nullable(),\n404:       error: z.string().nullable(),\n405:     }).strict(),\n406:     z.object({\n407:       state: z.literal('unavailable'),\n408:       target: z.string().min(1),\n409:       errorClass: z.enum(['unreachable', 'timeout', 'bad_response', 'probe_failed']),\n410:       error: z.string(),\n411:     }).strict(),\n412:   ]),\n413: }).strict();\n414: \n415: export const AdvisorStatusOutputSchema = z.object({\n416:   freshness: AdvisorFreshnessSchema,\n417:   generation: z.number().int().nonnegative(),\n418:   trustState: z.object({\n419:     state: AdvisorFreshnessSchema,\n420:     reason: z.string().nullable(),\n421:     generation: z.number().int().nonnegative(),\n422:     checkedAt: z.string().datetime(),\n423:     lastLiveAt: z.string().datetime().nullable(),\n424:   }).strict(),\n425:   lastGenerationBump: z.string().datetime().nullable(),\n426:   lastScanAt: z.string().datetime().nullable(),\n427:   skillCount: z.number().int().nonnegative(),\n428:   indexStaleness: z.object({\n429:     state: z.enum(['fresh', 'stale', 'unavailable']),\n430:     reason: z.string().nullable(),\n431:     trackedSkills: z.number().int().nonnegative(),\n432:     freshSourceFiles: z.number().int().nonnegative(),\n433:     changedSourceFiles: z.number().int().nonnegative(),\n434:     missingSourceFiles: z.number().int().nonnegative(),\n435:     staleSkillIds: z.array(z.string()),\n436:   }).strict().optional(),\n437:   laneWeights: z.record(AdvisorLaneSchema, z.number().min(0)),\n438:   semanticLaneHealth: semanticLaneHealthSchema.optional(),\n439:   embeddingsHealth: embeddingsHealthSchema.optional(),\n440:   daemonPid: z.number().int().positive().optional(),\n441:   errors: z.array(z.string()).optional(),\n442: }).strict();\n443: \n444: export const AdvisorRebuildInputSchema = z.object({\n445:   force: z.boolean().optional(),\n446:   // Bound workspaceRoot to allowed prefix set.\n447:   workspaceRoot: BoundedWorkspaceRootSchema.optional(),\n448: }).strict();\n449: \n450: export const AdvisorRebuildOutputSchema = z.object({\n451:   rebuilt: z.boolean(),\n452:   skipped: z.boolean(),\n453:   reason: z.enum(['status-live', 'stale', 'absent', 'unavailable', 'force']),\n454:   freshnessBefore: AdvisorFreshnessSchema,\n455:   freshnessAfter: AdvisorFreshnessSchema,\n456:   generationBefore: z.number().int().nonnegative(),\n457:   generationAfter: z.number().int().nonnegative(),\n458:   skillCount: z.number().int().nonnegative(),\n459:   summary: z.record(z.string(), z.unknown()).nullable(),\n460:   diagnostics: z.array(z.string()),\n461: }).strict();\n462: \n463: export const AdvisorValidateInputSchema = z.object({\n464:   confirmHeavyRun: z.literal(true),\n465:   // Bound workspaceRoot to allowed prefix set.\n466:   workspaceRoot: BoundedWorkspaceRootSchema.optional(),\n467:   skillSlug: z.string().min(1).nullable().optional(),\n468:   // Outcome events carry only skill ids + the accept/correct/ignore signal —\n469:   // never the prompt, scenario, or expected skill. This omission is deliberate\n470:   // prompt-safety: telemetry must not store routable prompt content. The\n471:   // consequence is that real misroutes cannot be harvested from telemetry into\n472:   // gold regression cases; gold cases are authored by hand, not reconstructed.\n473:   // Capturing prompts to close that gap would violate the prompt-safety\n474:   // invariant and is intentionally not supported.\n475:   outcomeEvents: z.array(z.object({\n476:     runtime: z.enum(ADVISOR_RUNTIME_VALUES),\n477:     outcome: z.enum(['accepted', 'corrected', 'ignored']),\n478:     skillId: z.string().min(1),\n479:     correctedSkillId: z.string().min(1).optional(),\n480:     timestamp: z.string().datetime().optional(),\n481:   }).strict()).optional(),\n482: }).strict();\n483: \n484: const validationSliceSchema = z.object({\n485:   percentage: z.number().min(0).max(1),\n486:   passed: z.boolean(),\n487:   threshold: z.number().min(0).max(1).optional(),\n488:   count: z.object({\n489:     passed: z.number().int().nonnegative(),\n490:     total: z.number().int().nonnegative(),\n491:   }).strict(),\n492: }).strict();\n493: \n494: // A named data-slice accuracy gate. Extends the generic validation slice with\n495: // `minN` (the minimum row count below which the slice is statistically\n496: // meaningless and fails, guarding against a corpus edit silently shrinking a\n497: // bucket) and `top1` (the strict top-1 accuracy for the slice, surfaced\n498: // explicitly so operators read the bucket's accuracy without recomputing it\n499: // from `count`).\n500: const bucketSliceSchema = validationSliceSchema.extend({\n501:   minN: z.number().int().positive(),\n502:   top1: z.number().min(0).max(1),\n503: }).strict();\n504: \n505: const advisorValidateAggregateValidationSchema = z.object({\n506:   fullCorpusTop1: z.number().min(0).max(1),\n507:   holdoutTop1: z.number().min(0).max(1),\n508:   perSkillTop1: z.number().min(0).max(1),\n509:   unknownCountTargetMax: z.number().int().nonnegative(),\n510: }).strict().describe('Release-gate thresholds for full corpus, holdout, per-skill accuracy, and UNKNOWN counts.');\n511: \n512: const advisorValidateRuntimeRoutingSchema = z.object({\n513:   confidenceThreshold: z.number().min(0).max(1),\n514:   uncertaintyThreshold: z.number().min(0).max(1),\n515:   confidenceOnly: z.boolean(),\n516: }).strict().describe('Live runtime routing thresholds surfaced by advisor_validate so manual checks can compare runtime semantics with release gates.');\n517: \n518: const advisorValidateTelemetryDiagnosticsSchema = z.object({\n519:   recordsPath: z.string().min(1),\n520:   recordsRetained: z.number().int().nonnegative(),\n521:   rollingCacheHitRate: z.number().min(0).max(1),\n522:   rollingP95Ms: z.number().min(0),\n523:   rollingFailOpenRate: z.number().min(0).max(1),\n524: }).strict().describe('Prompt-safe rolling diagnostics from retained advisor hook telemetry records.');\n525: \n526: const advisorValidateTelemetryScopeSchema = z.object({\n527:   kind: z.enum(['workspace', 'skill']),\n528:   skillSlug: z.string().min(1).nullable(),\n529: }).strict().describe('Whether recorded outcome totals are workspace-wide or scoped to the selected skillSlug.');\n530: \n531: const advisorValidateOutcomeTotalsSchema = z.object({\n532:   accepted: z.number().int().nonnegative(),\n533:   corrected: z.number().int().nonnegative(),\n534:   ignored: z.number().int().nonnegative(),\n535: }).strict().describe('Recorded outcome totals retained for the active workspace or skill scope.');\n536: \n537: const advisorValidateTelemetryOutcomesSchema = z.object({\n538:   recordsPath: z.string().min(1),\n539:   recordedThisRun: z.number().int().nonnegative(),\n540:   scope: advisorValidateTelemetryScopeSchema,\n541:   totals: advisorValidateOutcomeTotalsSchema,\n542: }).strict().describe('Outcome recording summary, including injected event count and retained accepted/corrected/ignored totals.');\n543: \n544: export const AdvisorValidateOutputSchema = z.object({\n545:   workspaceRoot: z.string().min(1),\n546:   skillSlug: z.string().nullable(),\n547:   thresholdSemantics: z.object({\n548:     aggregateValidation: advisorValidateAggregateValidationSchema,\n549:     runtimeRouting: advisorValidateRuntimeRoutingSchema,\n550:   }).strict().describe('Public threshold contract for advisor_validate, covering release-gate scoring and runtime-routing semantics.'),\n551:   overallAccuracy: z.number().min(0).max(1),\n552:   perSkill: z.array(z.object({\n553:     skillId: z.string().min(1),\n554:     status: z.enum(['pass', 'fail', 'skipped']),\n555:     matched: z.number().int().nonnegative(),\n556:     total: z.number().int().nonnegative(),\n557:   }).strict()),\n558:   slices: z.object({\n559:     corpus: z.object({\n560:       full_corpus_top1: validationSliceSchema,\n561:       unknown_count: z.object({\n562:         value: z.number().int().nonnegative(),\n563:         targetMax: z.number().int().nonnegative(),\n564:         passed: z.boolean(),\n565:       }).strict(),\n566:       gold_none_false_fire_count: z.object({\n567:         value: z.number().int().nonnegative(),\n568:         baselineDelta: z.number().int(),\n569:       }).strict(),\n570:     }).strict(),\n571:     holdout: z.object({\n572:       holdout_top1: validationSliceSchema,\n573:     }).strict(),\n574:     parity: z.object({\n575:       explicit_skill_top1_regression: z.object({\n576:         passed: z.boolean(),\n577:         regressions: z.array(z.string()),\n578:       }).strict(),\n579:       ambiguity_slice_stable: z.object({\n580:         passed: z.boolean(),\n581:         top2Within005: z.boolean(),\n582:       }).strict(),\n583:       derived_lane_attribution_complete: z.boolean(),\n584:     }).strict(),\n585:     safety: z.object({\n586:       adversarial_stuffing_blocked: z.object({\n587:         passed: z.boolean(),\n588:         fixtureCount: z.number().int().nonnegative(),\n589:       }).strict(),\n590:     }).strict(),\n591:     latency: z.object({\n592:       regression_suite_status: z.object({\n593:         p0PassRate: z.number().min(0).max(1),\n594:         failedCount: z.number().int().nonnegative(),\n595:         commandBridgeFalsePositiveRate: z.number().min(0).max(1),\n596:         cacheHitP95Ms: z.number().min(0),\n597:         uncachedP95Ms: z.number().min(0),\n598:       }).strict(),\n599:     }).strict(),\n600:     // Named per-intent accuracy buckets. review/memory_save are corpus rows\n601:     // grouped by their labeled bucket; delegation is the shared executor-routing\n602:     // fixture (the training corpus carries no honest executor-delegation signal).\n603:     // Each is a first-class accuracy gate so a regression confined to one intent\n604:     // class stays visible even when the aggregate corpus number holds.\n605:     buckets: z.object({\n606:       review: bucketSliceSchema,\n607:       memory_save: bucketSliceSchema,\n608:       delegation: bucketSliceSchema,\n609:     }).strict(),\n610:   }).strict(),\n611:   telemetry: z.object({\n612:     diagnostics: advisorValidateTelemetryDiagnosticsSchema,\n613:     outcomes: advisorValidateTelemetryOutcomesSchema,\n614:   }).strict().describe('Prompt-safe telemetry diagnostics and recorded outcome summaries exposed for operator validation.'),\n615:   generatedAt: z.string().datetime(),\n616: }).strict();\n617: \n618: // ───────────────────────────────────────────────────────────────────\n619: // 5. EXPORTS\n620: // ───────────────────────────────────────────────────────────────────\n621: \n622: export type AdvisorFreshness = z.infer<typeof AdvisorFreshnessSchema>;\n623: export type AdvisorRecommendInput = z.infer<typeof AdvisorRecommendInputSchema>;\n624: export type AdvisorRecommendOutput = z.infer<typeof AdvisorRecommendOutputSchema>;\n625: export type AdvisorRebuildInput = z.infer<typeof AdvisorRebuildInputSchema>;\n626: export type AdvisorRebuildOutput = z.infer<typeof AdvisorRebuildOutputSchema>;\n627: export type AdvisorStatusInput = z.infer<typeof AdvisorStatusInputSchema>;\n628: export type AdvisorStatusOutput = z.infer<typeof AdvisorStatusOutputSchema>;\n629: export type AdvisorValidateInput = z.infer<typeof AdvisorValidateInputSchema>;\n630: export type AdvisorValidateOutput = z.infer<typeof AdvisorValidateOutputSchema>;\n631: \n632: export const AdvisorToolInputSchemas = {\n633:   advisor_recommend: AdvisorRecommendInputSchema,\n634:   advisor_rebuild: AdvisorRebuildInputSchema,\n635:   advisor_status: AdvisorStatusInputSchema,\n636:   advisor_validate: AdvisorValidateInputSchema,\n637: } as const;"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/schemas/advisor-tool-schemas.ts\"}"},"time":{"start":1794529056098,"end":1794529056456}}}}
{"type":"tool_use","timestamp":1794529056461,"sessionID":"ses_e2dbc36c0ffexACT5imzdktU7L","part":{"partID":"prt_1d24453b3001BBE4CFNxps8Hak","sessionID":"ses_e2dbc36c0ffexACT5imzdktU7L","messageID":"msg_1d244407c001bkzHmzprj1rL2n","type":"tool","id":"call_9c92de9f50654351b9e5c291","tool":"read","state":{"status":"completed","input":{"path":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/feature-catalog/cli-surface/advisor-recommend.md"},"output":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/feature-catalog/cli-surface/advisor-recommend.md, lines 1-80\n1: ---\n2: title: \"advisor_recommend Command\"\n3: description: \"Native command that returns prompt-safe skill recommendations with lane attribution, lifecycle metadata, fail-open freshness semantics and an optional compiled-routing enrichment.\"\n4: trigger_phrases:\n5:   - \"advisor_recommend\"\n6:   - \"mcp recommend tool\"\n7:   - \"native recommend\"\n8:   - \"skill recommendation tool\"\n9:   - \"compiledRoute enrichment\"\n10: version: 0.9.2.0\n11: ---\n12: \n13: # advisor_recommend Command\n14: \n15: ## 1. OVERVIEW\n16: \n17: Expose the native scoring pipeline as a command that any runtime can call through the CLI front door, with prompt-safe attribution and lifecycle-aware redirects.\n18: \n19: ---\n20: \n21: ## 2. HOW IT WORKS\n22: \n23: `handlers/advisor-recommend.ts` implements the command. Input is validated by `schemas/advisor-tool-schemas.ts` (Zod strict). The public response always includes the resolved `workspaceRoot` plus `effectiveThresholds`, where `effectiveThresholds` publishes the active `confidenceThreshold`, `uncertaintyThreshold` and `confidenceOnly` mode after request overrides are merged with defaults. Output also carries prompt-safe `recommendations[]`, optional `laneBreakdown[]` when `includeAttribution: true`, lifecycle redirect metadata (`redirectFrom`, `redirectTo`, `status`), `freshness`, `trustState`, `generatedAt`, `cache`, optional `warnings` and optional `abstainReasons`. Fail-open states such as disabled or absent freshness still preserve `workspaceRoot` and `effectiveThresholds` in the envelope so callers can inspect the resolved repository scope and active routing thresholds even when no recommendations are returned. The handler enforces sanitization at the envelope boundary (see `lib/derived/sanitizer.ts`) and never echoes prompt text into response metadata. Cache behavior is tied to generation (see [`daemon-and-freshness/cache-invalidation.md`](../../feature-catalog/daemon-and-freshness/cache-invalidation.md)).\n24: \n25: Shadow comparison is response-visible but durable recording is default-off. The handler calls the shadow-delta sink only when `SPECKIT_ADVISOR_SHADOW_DELTA_PATH` is set or `SPECKIT_ADVISOR_SHADOW_DELTA_ENABLED=1` / `true`; otherwise `advisor_recommend` writes no shadow delta file.\n26: \n27: The caller-supplied `workspaceRoot` is bounded by `schemas/advisor-tool-schemas.ts`, which canonicalizes the path and accepts it only when it resolves under the repo root, `os.tmpdir()` or the `/tmp` symlink form, or sits in a project whose `.skilled` (or `.opencode`) links to this source tree, the way `/doctor:symlink` links one, meaning its realpath equals this source tree's own entry. The `SPECKIT_ADVISOR_WORKSPACE_ALLOWLIST` env var extends that set with extra colon-separated prefixes for CI or test runners, each canonicalized before it is trusted. The flag is unset by default, so the bounding logic stays repo-and-tmpdir-only unless an operator opts in.\n28: \n29: ### Compiled-Routing Enrichment (`compiledRoute`)\n30: \n31: Each recommendation carries an optional `compiledRoute` field (`schemas/advisor-tool-schemas.ts:308`, `z.record(z.string(), z.unknown()).optional()`). `handlers/advisor-recommend.ts`'s `enrichCompiledRoutes()` attaches it only when at least one recommended `skillId` is both in the fixed 7-hub `COMPILED_ROUTING_HUBS` set and currently permitted by the tri-state `SPECKIT_COMPILED_ROUTING` flag (`compiledRoutingEnabledForHub()`, from `../lib/compiled-routing-flag.ts`). Otherwise the schema re-parse is skipped entirely and the output returns unchanged. When enrichment runs, `compiledRouteForRecommendation()` shells out to `.skilled/bin/compiled-route.cjs --hub <skillId> --prompt-stdin`, writes the prompt to its stdin and attaches the parsed result. The one exception is a result whose `servingAuthority` is `\"legacy\"`: the field then stays absent, because a legacy sentinel is never surfaced as if it were a compiled decision. A subprocess failure is handled the same way: silently no `compiledRoute` field, with an optional debug-gated stderr breadcrumb via `SPECKIT_COMPILED_ROUTING_DEBUG`, so a probe failure degrades to exactly what an ineligible or flag-off recommendation already looks like. In short, `compiledRoute` is attached only for an eligible, flag-permitted hub that is genuinely serving compiled. It is intentionally absent for every other combination: flag off, hub not in `COMPILED_ROUTING_HUBS`, legacy sentinel or probe failure. See [`feature-flag-governance.md`](../../../system-spec-kit/feature-catalog/governance/feature-flag-governance.md) for the flag's phased-default and serving-status contract, and each eligible hub's own `compiled-routing-and-legacy-fallback.md` catalog leaf for the hub-side directive this enrichment mirrors. The front door runs from the request's `workspaceRoot`, and a caller may name another checkout there, such as a worktree under the repository root. So the handler first checks that the front door it would run reads `--prompt-stdin`. An ... (line truncated to 2000 chars)\n32: \n33: When a recommendation gets a `compiledRoute`, `enrichCompiledRoutes()` also asks `attachCommand()` in `lib/command-attach.ts` for a slash command and sets the optional `command` field when one comes back (`schemas/advisor-tool-schemas.ts:310`, `z.string().min(1).optional()`). `attachCommand()` names a command only for a `route` decision with `selectionKind: 'single'` and exactly one target, and only when the generated `MODE_COMMANDS` table maps that hub and `workflowMode` to a command. A bundle, a multi-target route or a mode with no command leaves `command` off. For `system-deep-loop` the prompt must also contain `/deep:` or a phrase from `DEPTH_WORDING`, so a prompt that only names a topic such as research or review gets no deep-loop command.\n34: \n35: The request option `options.includeCompiledRoute` is an optional boolean that defaults to true. When a caller passes `false` the handler skips `enrichCompiledRoutes()` on both the fresh and the cached return (`handlers/advisor-recommend.ts:563-565`, `632-634`), so no `compiled-route.cjs` subprocess starts and no recommendation carries `compiledRoute` or `command`. The prompt hooks pass `true` (`hooks/lib/skill-advisor-cli-fallback.ts:238`), because the `command` field is derived from the compiled route. The OpenCode plugin does not pass the option and keeps receiving `compiledRoute`. The option is declared in the zod schema (`schemas/advisor-tool-schemas.ts:287`), the tool descriptor (`tools/advisor-recommend.ts:23`) and the CLI manifest (`skill-advisor-cli-manifest.ts:57`).\n36: \n37: The request option `options.compiledRouteTopOnly` is an optional boolean that defaults to false. When a caller passes `true`, `enrichCompiledRoutes()` runs the route lookup for the first recommendation only and returns every later one unchanged, so only the top pick can carry `compiledRoute` or `command`. Each lookup is a `compiled-route.cjs` subprocess, so this saves one subprocess for each further eligible hub. The prompt hooks pass `true` with `includeCompiledRoute: true`, because the brief leads with the top pick. The option is declared in the zod schema (`schemas/advisor-tool-schemas.ts:290`), the tool descriptor (`tools/advisor-recommend.ts:24`) and the CLI manifest (`skill-advisor-cli-manifest.ts:58`).\n38: \n39: A hub also leaves `command` off when the same command already ranks in the result through its own command row. `enrichCompiledRoutes()` reads each row's slash string from `BRIDGE_COMMAND_BY_ID`, so one command never takes two slots.\n40: \n41: ---\n42: \n43: ## 3. SOURCE FILES\n44: \n45: ### Implementation\n46: \n47: | File | Layer | Role |\n48: |---|---|---|\n49: | `.skilled/skills/system-skill-advisor/runtime/handlers/advisor-recommend.ts` | Handler | Source reference |\n50: | `.skilled/skills/system-skill-advisor/runtime/schemas/advisor-tool-schemas.ts` | Schema | Source reference |\n51: | `.skilled/skills/system-skill-advisor/runtime/tools/` | Command surface | Source reference |\n52: | `.skilled/skills/system-skill-advisor/runtime/lib/command-attach.ts` | Shared | `attachCommand()`, the generated `MODE_COMMANDS` table and the `DEPTH_WORDING` gate that name the slash command for a single routed mode. |\n53: | `.skilled/skills/system-skill-advisor/runtime/lib/compiled-routing-flag.ts` | Shared | `COMPILED_ROUTING_HUBS` eligibility set, `DEFAULT_ON_HUBS` cohort, and the tri-state flag parser the enrichment gate reads. |\n54: | `.skilled/bin/compiled-route.cjs` | Script | Promoted CLI front door `compiledRouteForRecommendation()` shells out to. |\n55: \n56: ### Validation And Tests\n57: \n58: | File | Type | Role |\n59: |---|---|---|\n60: | `.skilled/skills/system-skill-advisor/runtime/tests/handlers/advisor-recommend.vitest.ts` | Automated test | Validation reference |\n61: | `.skilled/skills/system-skill-advisor/runtime/tests/handlers/advisor-recommend-compiled-route-option.vitest.ts` | Automated test | `includeCompiledRoute: false` skips enrichment on fresh and cached returns. `compiledRouteTopOnly: true` looks up the first recommendation alone. A command that ranks through its own row is not offered again by its hub. |\n62: | `.skilled/skills/system-skill-advisor/runtime/tests/legacy/advisor-privacy.vitest.ts` | Automated test | Validation reference |\n63: | `.skilled/skills/system-skill-advisor/runtime/tests/compiled-routing-consumption.vitest.ts` | Automated test | Bridge child-env allowlist forwarding, `buildNativeBrief` decision threading, and `=0` cache-invalidation coverage for the `compiledRoute` enrichment. |\n64: | `.skilled/bin/compiled-routing-flag-propagation.vitest.ts` | Automated test | Tri-state flag propagation coverage. |\n65: | `Playbook scenarios [NC-001](../../manual-testing-playbook/native-cli-tools/native-recommend-happy-path.md), [NC-004](../../manual-testing-playbook/native-cli-tools/ambiguous-brief-rendering.md), [NC-005](../../manual-testing-playbook/native-cli-tools/lifecycle-redirect-metadata.md).` | Manual playbook | Source reference |\n66: \n67: ---\n68: \n69: ## 4. SOURCE METADATA\n70: \n71: - Group: Command surface\n72: - Canonical catalog source: `feature-catalog.md`\n73: - Feature file path: `cli-surface/advisor-recommend.md`\n74: \n75: Related references:\n76: \n77: - [02-advisor-status.md](../../feature-catalog/cli-surface/advisor-status.md).\n78: - [03-advisor-validate.md](../../feature-catalog/cli-surface/advisor-validate.md).\n79: - [04-compat-entrypoint.md](../../feature-catalog/cli-surface/compat-entrypoint.md).\n80: - [feature-flag-governance.md](../../../system-spec-kit/feature-catalog/governance/feature-flag-governance.md) — the `SPECKIT_COMPILED_ROUTING` flag-governance entry this enrichment's gate reads.","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/feature-catalog/cli-surface/advisor-recommend.md, lines 1-80\n1: ---\n2: title: \"advisor_recommend Command\"\n3: description: \"Native command that returns prompt-safe skill recommendations with lane attribution, lifecycle metadata, fail-open freshness semantics and an optional compiled-routing enrichment.\"\n4: trigger_phrases:\n5:   - \"advisor_recommend\"\n6:   - \"mcp recommend tool\"\n7:   - \"native recommend\"\n8:   - \"skill recommendation tool\"\n9:   - \"compiledRoute enrichment\"\n10: version: 0.9.2.0\n11: ---\n12: \n13: # advisor_recommend Command\n14: \n15: ## 1. OVERVIEW\n16: \n17: Expose the native scoring pipeline as a command that any runtime can call through the CLI front door, with prompt-safe attribution and lifecycle-aware redirects.\n18: \n19: ---\n20: \n21: ## 2. HOW IT WORKS\n22: \n23: `handlers/advisor-recommend.ts` implements the command. Input is validated by `schemas/advisor-tool-schemas.ts` (Zod strict). The public response always includes the resolved `workspaceRoot` plus `effectiveThresholds`, where `effectiveThresholds` publishes the active `confidenceThreshold`, `uncertaintyThreshold` and `confidenceOnly` mode after request overrides are merged with defaults. Output also carries prompt-safe `recommendations[]`, optional `laneBreakdown[]` when `includeAttribution: true`, lifecycle redirect metadata (`redirectFrom`, `redirectTo`, `status`), `freshness`, `trustState`, `generatedAt`, `cache`, optional `warnings` and optional `abstainReasons`. Fail-open states such as disabled or absent freshness still preserve `workspaceRoot` and `effectiveThresholds` in the envelope so callers can inspect the resolved repository scope and active routing thresholds even when no recommendations are returned. The handler enforces sanitization at the envelope boundary (see `lib/derived/sanitizer.ts`) and never echoes prompt text into response metadata. Cache behavior is tied to generation (see [`daemon-and-freshness/cache-invalidation.md`](../../feature-catalog/daemon-and-freshness/cache-invalidation.md)).\n24: \n25: Shadow comparison is response-visible but durable recording is default-off. The handler calls the shadow-delta sink only when `SPECKIT_ADVISOR_SHADOW_DELTA_PATH` is set or `SPECKIT_ADVISOR_SHADOW_DELTA_ENABLED=1` / `true`; otherwise `advisor_recommend` writes no shadow delta file.\n26: \n27: The caller-supplied `workspaceRoot` is bounded by `schemas/advisor-tool-schemas.ts`, which canonicalizes the path and accepts it only when it resolves under the repo root, `os.tmpdir()` or the `/tmp` symlink form, or sits in a project whose `.skilled` (or `.opencode`) links to this source tree, the way `/doctor:symlink` links one, meaning its realpath equals this source tree's own entry. The `SPECKIT_ADVISOR_WORKSPACE_ALLOWLIST` env var extends that set with extra colon-separated prefixes for CI or test runners, each canonicalized before it is trusted. The flag is unset by default, so the bounding logic stays repo-and-tmpdir-only unless an operator opts in.\n28: \n29: ### Compiled-Routing Enrichment (`compiledRoute`)\n30: \n31: Each recommendation carries an optional `compiledRoute` field (`schemas/advisor-tool-schemas.ts:308`, `z.record(z.string(), z.unknown()).optional()`). `handlers/advisor-recommend.ts`'s `enrichCompiledRoutes()` attaches it only when at least one recommended `skillId` is both in the fixed 7-hub `COMPILED_ROUTING_HUBS` set and currently permitted by the tri-state `SPECKIT_COMPILED_ROUTING` flag (`compiledRoutingEnabledForHub()`, from `../lib/compiled-routing-flag.ts`). Otherwise the schema re-parse is skipped entirely and the output returns unchanged. When enrichment runs, `compiledRouteForRecommendation()` shells out to `.skilled/bin/compiled-route.cjs --hub <skillId> --prompt-stdin`, writes the prompt to its stdin and attaches the parsed result. The one exception is a result whose `servingAuthority` is `\"legacy\"`: the field then stays absent, because a legacy sentinel is never surfaced as if it were a compiled decision. A subprocess failure is handled the same way: silently no `compiledRoute` field, with an optional debug-gated stderr breadcrumb via `SPECKIT_COMPILED_ROUTING_DEBUG`, so a probe failure degrades to exactly what an ineligible or flag-off recommendation already looks like. In short, `compiledRoute` is attached only for an eligible, flag-permitted hub that is genuinely serving compiled. It is intentionally absent for every other combination: flag off, hub not in `COMPILED_ROUTING_HUBS`, legacy sentinel or probe failure. See [`feature-flag-governance.md`](../../../system-spec-kit/feature-catalog/governance/feature-flag-governance.md) for the flag's phased-default and serving-status contract, and each eligible hub's own `compiled-routing-and-legacy-fallback.md` catalog leaf for the hub-side directive this enrichment mirrors. The front door runs from the request's `workspaceRoot`, and a caller may name another checkout there, such as a worktree under the repository root. So the handler first checks that the front door it would run reads `--prompt-stdin`. An ... (line truncated to 2000 chars)\n32: \n33: When a recommendation gets a `compiledRoute`, `enrichCompiledRoutes()` also asks `attachCommand()` in `lib/command-attach.ts` for a slash command and sets the optional `command` field when one comes back (`schemas/advisor-tool-schemas.ts:310`, `z.string().min(1).optional()`). `attachCommand()` names a command only for a `route` decision with `selectionKind: 'single'` and exactly one target, and only when the generated `MODE_COMMANDS` table maps that hub and `workflowMode` to a command. A bundle, a multi-target route or a mode with no command leaves `command` off. For `system-deep-loop` the prompt must also contain `/deep:` or a phrase from `DEPTH_WORDING`, so a prompt that only names a topic such as research or review gets no deep-loop command.\n34: \n35: The request option `options.includeCompiledRoute` is an optional boolean that defaults to true. When a caller passes `false` the handler skips `enrichCompiledRoutes()` on both the fresh and the cached return (`handlers/advisor-recommend.ts:563-565`, `632-634`), so no `compiled-route.cjs` subprocess starts and no recommendation carries `compiledRoute` or `command`. The prompt hooks pass `true` (`hooks/lib/skill-advisor-cli-fallback.ts:238`), because the `command` field is derived from the compiled route. The OpenCode plugin does not pass the option and keeps receiving `compiledRoute`. The option is declared in the zod schema (`schemas/advisor-tool-schemas.ts:287`), the tool descriptor (`tools/advisor-recommend.ts:23`) and the CLI manifest (`skill-advisor-cli-manifest.ts:57`).\n36: \n37: The request option `options.compiledRouteTopOnly` is an optional boolean that defaults to false. When a caller passes `true`, `enrichCompiledRoutes()` runs the route lookup for the first recommendation only and returns every later one unchanged, so only the top pick can carry `compiledRoute` or `command`. Each lookup is a `compiled-route.cjs` subprocess, so this saves one subprocess for each further eligible hub. The prompt hooks pass `true` with `includeCompiledRoute: true`, because the brief leads with the top pick. The option is declared in the zod schema (`schemas/advisor-tool-schemas.ts:290`), the tool descriptor (`tools/advisor-recommend.ts:24`) and the CLI manifest (`skill-advisor-cli-manifest.ts:58`).\n38: \n39: A hub also leaves `command` off when the same command already ranks in the result through its own command row. `enrichCompiledRoutes()` reads each row's slash string from `BRIDGE_COMMAND_BY_ID`, so one command never takes two slots.\n40: \n41: ---\n42: \n43: ## 3. SOURCE FILES\n44: \n45: ### Implementation\n46: \n47: | File | Layer | Role |\n48: |---|---|---|\n49: | `.skilled/skills/system-skill-advisor/runtime/handlers/advisor-recommend.ts` | Handler | Source reference |\n50: | `.skilled/skills/system-skill-advisor/runtime/schemas/advisor-tool-schemas.ts` | Schema | Source reference |\n51: | `.skilled/skills/system-skill-advisor/runtime/tools/` | Command surface | Source reference |\n52: | `.skilled/skills/system-skill-advisor/runtime/lib/command-attach.ts` | Shared | `attachCommand()`, the generated `MODE_COMMANDS` table and the `DEPTH_WORDING` gate that name the slash command for a single routed mode. |\n53: | `.skilled/skills/system-skill-advisor/runtime/lib/compiled-routing-flag.ts` | Shared | `COMPILED_ROUTING_HUBS` eligibility set, `DEFAULT_ON_HUBS` cohort, and the tri-state flag parser the enrichment gate reads. |\n54: | `.skilled/bin/compiled-route.cjs` | Script | Promoted CLI front door `compiledRouteForRecommendation()` shells out to. |\n55: \n56: ### Validation And Tests\n57: \n58: | File | Type | Role |\n59: |---|---|---|\n60: | `.skilled/skills/system-skill-advisor/runtime/tests/handlers/advisor-recommend.vitest.ts` | Automated test | Validation reference |\n61: | `.skilled/skills/system-skill-advisor/runtime/tests/handlers/advisor-recommend-compiled-route-option.vitest.ts` | Automated test | `includeCompiledRoute: false` skips enrichment on fresh and cached returns. `compiledRouteTopOnly: true` looks up the first recommendation alone. A command that ranks through its own row is not offered again by its hub. |\n62: | `.skilled/skills/system-skill-advisor/runtime/tests/legacy/advisor-privacy.vitest.ts` | Automated test | Validation reference |\n63: | `.skilled/skills/system-skill-advisor/runtime/tests/compiled-routing-consumption.vitest.ts` | Automated test | Bridge child-env allowlist forwarding, `buildNativeBrief` decision threading, and `=0` cache-invalidation coverage for the `compiledRoute` enrichment. |\n64: | `.skilled/bin/compiled-routing-flag-propagation.vitest.ts` | Automated test | Tri-state flag propagation coverage. |\n65: | `Playbook scenarios [NC-001](../../manual-testing-playbook/native-cli-tools/native-recommend-happy-path.md), [NC-004](../../manual-testing-playbook/native-cli-tools/ambiguous-brief-rendering.md), [NC-005](../../manual-testing-playbook/native-cli-tools/lifecycle-redirect-metadata.md).` | Manual playbook | Source reference |\n66: \n67: ---\n68: \n69: ## 4. SOURCE METADATA\n70: \n71: - Group: Command surface\n72: - Canonical catalog source: `feature-catalog.md`\n73: - Feature file path: `cli-surface/advisor-recommend.md`\n74: \n75: Related references:\n76: \n77: - [02-advisor-status.md](../../feature-catalog/cli-surface/advisor-status.md).\n78: - [03-advisor-validate.md](../../feature-catalog/cli-surface/advisor-validate.md).\n79: - [04-compat-entrypoint.md](../../feature-catalog/cli-surface/compat-entrypoint.md).\n80: - [feature-flag-governance.md](../../../system-spec-kit/feature-catalog/governance/feature-flag-governance.md) — the `SPECKIT_COMPILED_ROUTING` flag-governance entry this enrichment's gate reads."}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/feature-catalog/cli-surface/advisor-recommend.md\"}"},"time":{"start":1794529055667,"end":1794529056461}}}}
