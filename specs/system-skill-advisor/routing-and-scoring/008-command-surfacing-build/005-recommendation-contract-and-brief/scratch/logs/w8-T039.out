${commandPart} (${policyPart})`;\n203: }\n204: \n205: // A doctor bridge renders as its runnable command and never as its raw id; an\n206: // unmapped doctor id renders nothing.\n207: function recommendationLabel(recommendation: RenderableRecommendation): string | null {\n208:   return commandLabel(recommendation)\n209:     ?? (isDoctorBridgeId(recommendation.skill)\n210:       ? doctorCommandString(recommendation.skill)\n211:       : sanitizeSkillLabel(recommendation.skill));\n212: }\n213: \n214: function formatScore(value: number): string {\n215:   return Number.isFinite(value) ? value.toFixed(2) : '0.00';\n216: }\n217: \n218: type RenderableRecommendation = AdvisorRecommendation & {\n219:   readonly score?: number;\n220:   readonly ambiguousWith?: readonly string[];\n221:   readonly heldBelow?: string;\n222: };\n[Output truncated. Continue reading with offset: 223]","title":"read","metadata":{"metadata":{"truncated":true},"content":[{"type":"text","text":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/lib/render.ts, lines 178-222\n178:   if (!isDoctorBridgeId(skillId)) {\n179:     return null;\n180:   }\n181:   const command = commandRowFor(skillId)?.command;\n182:   return command === undefined ? null : sanitizeSkillLabel(command);\n183: }\n184: \n185: // A recommendation that names a command renders as the skill that owns it, the\n186: // runnable command and the policy that governs the run. The recommendation's own\n187: // fields stay authoritative and the generated row fills only what they omit, so a\n188: // caller that already resolved the command is never second-guessed.\n189: function commandLabel(recommendation: RenderableRecommendation): string | null {\n190:   const row = commandRowFor(recommendation.skill);\n191:   const command = recommendation.command ?? row?.command;\n192:   const owner = recommendation.ownerSkillId ?? row?.ownerSkillId ?? recommendation.skill;\n193:   const policy = recommendation.policy ?? row?.policy;\n194:   const commandPart = command === undefined ? null : sanitizeSkillLabel(command);\n195:   const ownerPart = sanitizeSkillLabel(owner);\n196:   if (!commandPart || !ownerPart) {\n197:     return null;\n198:   }\n199:   const policyPart = policy === undefined ? null : sanitizeSkillLabel(policy);\n200:   return policyPart === null\n201:     ? `${ownerPart} → ${commandPart}`\n202:     : `${ownerPart} → ${commandPart} (${policyPart})`;\n203: }\n204: \n205: // A doctor bridge renders as its runnable command and never as its raw id; an\n206: // unmapped doctor id renders nothing.\n207: function recommendationLabel(recommendation: RenderableRecommendation): string | null {\n208:   return commandLabel(recommendation)\n209:     ?? (isDoctorBridgeId(recommendation.skill)\n210:       ? doctorCommandString(recommendation.skill)\n211:       : sanitizeSkillLabel(recommendation.skill));\n212: }\n213: \n214: function formatScore(value: number): string {\n215:   return Number.isFinite(value) ? value.toFixed(2) : '0.00';\n216: }\n217: \n218: type RenderableRecommendation = AdvisorRecommendation & {\n219:   readonly score?: number;\n220:   readonly ambiguousWith?: readonly string[];\n221:   readonly heldBelow?: string;\n222: };\n[Output truncated. Continue reading with offset: 223]"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"limit\":45,\"offset\":178,\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/lib/render.ts\"}"},"time":{"start":1794529110058,"end":1794529111157}}}}
