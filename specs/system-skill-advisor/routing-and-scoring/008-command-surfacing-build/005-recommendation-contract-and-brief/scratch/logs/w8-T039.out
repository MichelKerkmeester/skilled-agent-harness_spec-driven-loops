=== 'deprecated'\n322:     || sanitizedStatus === 'archived'\n323:     || sanitizedStatus === 'future'\n324:     ? sanitizedStatus as PublicRecommendationStatus\n325:     : undefined;\n326:   const workflowMode = workflowModeForRecommendation(recommendation, prompt);\n327:   return {\n328:     skillId,\n329:     kind: recommendation.kind,\n330:     score: recommendation.score,\n331:     confidence: recommendation.confidence,\n332:     uncertainty: recommendation.uncertainty,\n333:     dominantLane: recommendation.dominantLane,\n334:     ...(includeAttribution ? {\n335:       laneBreakdown: recommendation.laneContributions.map((lane) => ({\n336:         lane: lane.lane,\n337:         rawScore: lane.rawScore,\n338:         weightedScore: lane.weightedScore,\n339:         weight: lane.weight,\n340:         shadowOnly: lane.shadowOnly,\n341:       })),\n342:       why_recommended: publicWhyRecommended(recommendation),\n343:     } : {}),\n344:     ...(matchedDocs.length > 0 ? { matchedDocs } : {}),\n345:     ...(redirectFrom.length > 0 ? { redirectFrom } : {}),\n346:     ...(redirectTo ? { redirectTo } : {}),\n347:     // Hook briefs re-derive ambiguity from the public list, so a skill the typed\n348:     // command already ranked below its seed has to say so here.\n349:     ...(heldBelow ? { heldBelow } : {}),\n350:     ...(status ? { status } : {}),\n351:     ...(workflowMode ? { workflowMode } : {}),\n352:     // A command row is the contract a reader acts on, so its runnable string,\n353:     // policy and owner travel with the pick. An id with no row adds nothing.\n354:     ...(commandRow ? {\n355:       command: commandRow.command,\n356:       ...(commandRow.policy ? { policy: commandRow.policy } : {}),\n357:       ownerSkillId: commandRow.ownerSkillId,\n358:     } : {}),\n359:   };\n360: }\n361: \n362: // The front door runs from the request's workspaceRoot, and a caller may name\n363: // another checkout there, such as a worktree under the repository root. Its co