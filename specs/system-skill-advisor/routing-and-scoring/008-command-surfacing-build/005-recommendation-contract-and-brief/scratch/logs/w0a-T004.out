ve. This narrows the window where two reclaimers\n159:         // both believe they cleared the same stale lock.\n160:         try {\n161:           const reread = readLockTokenAndAge(lockPath);\n162:           if (reread.token !== null && reread.token === incumbentToken) {\n163:             rmSync(lockPath, { force: true });\n164:           }\n165:         } catch {\n166:           // Lock vanished between our two reads — nothing to do.\n167:         }\n168:         continue;\n169:       }\n170:       if (incumbentToken === null) {\n171:         // Corrupt lock contents (legacy format or partial write). Reclaim it.\n172:         rmSync(lockPath, { force: true });\n173:         continue;\n174:       }\n175:       if (Date.now() - startedAt > GENERATION_LOCK_WAIT_MS) {\n176:         throw new Error('Timed out acquiring skill graph generation lock');\n177:       }\n178:     }\n179:   }\n180: }\n181: \n182: // ───────────────────────────────────────────────────────────────────\n183: // 5. CORE LOGIC\n184: // ───────────────────────────────────────────────────────────────────\n185: \n186: export function readSkillGraphGeneration(workspaceRoot: string): GenerationMetadata {\n187:   const filePath = getSkillGraphGenerationPath(workspaceRoot);\n188:   if (!existsSync(filePath)) {\n189:     return {\n190:       generation: 0,\n191:       updatedAt: new Date(0).toISOString(),\n192:       sourceSignature: null,\n193:       reason: 'GENERATION_ABSENT',\n194:       state: 'absent',\n195:     };\n196:   }\n197: \n198:   const parsed: unknown = JSON.parse(readFileSync(filePath, 'utf8'));\n199:   return GenerationMetadataSchema.parse(parsed);\n200: }\n201: \n202: export function publishSkillGraphGeneration(options: PublishGenerationOptions): PublishGenerationResult {\n203:   const generationPath = getSkillGraphGenerationPath(options.workspaceRoot);\n204:   const releaseLock = acquireGenerationLock(generationPath);\n205:   let metadata: GenerationMetadata;\n206:   try {\n207:     const current = readSkillGraphGeneration(options.workspaceRoot);\n208:     metadata = {\n209:       generation: current.generation + 1,\n210:       updatedAt: new Date().toISOString(),\n211:       sourceSignature: options.sourceSignature ?? null,\n212:       reason: options.reason,\n213:       state: options.state ?? 'live',\n214:     };\n215:     writeJsonAtomic(generationPath, metadata);\n216:   } finally {\n217:     releaseLock();\n218:   }\n219:   const invalidation = invalidateSkillGraphCaches({\n220:     generation: metadata.generation,\n221:     changedPaths: options.changedPaths ?? [],\n222:     reason: options.reason,\n223:   });\n224:   return { metadata, invalidation };\n225: }\n226: \n227: export async function publishAfterCommit<T>(\n228:   commit: () => T | Promise<T>,\n229:   options: PublishGenerationOptions,\n230: ): Promise<{ result: T; publication: PublishGenerationResult }> {\n231:   const result = await commit();\n232:   return {\n233:     result,\n234:     publication: publishSkillGraphGeneration(options),\n235:   };\n236: }\n237: \n238: // ───────────────────────────────────────────────────────────────────\n239: // 6. EXPORTS\n[Output truncated. Continue reading with offset: 240]"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/lib/freshness/generation.ts\",\"offset\":120,\"limit\":120}"},"time":{"start":1794521970279,"end":1794521970819}}}}
{"type":"tool_use","timestamp":1794521970824,"sessionID":"ses_e2e2a8545ffel5iCm3sO3VeatJ","part":{"partID":"prt_1d1d833df001GAmmkeHX8eH7A9","sessionID":"ses_e2e2a8545ffel5iCm3sO3VeatJ","messageID":"msg_1d1d82a480017CH1G4iEqBhLlG","type":"tool","id":"call_007201c91ca7444f84953bf9","tool":"read","state":{"status":"completed","input":{"path":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/lib/freshness.ts","offset":150,"limit":130},"output":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/lib/freshness.ts, lines 150-279\n150:     .sort((left, right) => left.localeCompare(right));\n151: }\n152: \n153: function buildSourceSnapshot(workspaceRoot: string): SourceSnapshot {\n154:   const root = resolve(workspaceRoot);\n155:   const skillRoot = join(root, SKILL_ROOT_RELATIVE_PATH);\n156:   const missingSources: string[] = [];\n157:   const hash = createHash('sha256');\n158:   const skillFingerprints = new Map<string, AdvisorSkillFingerprint>();\n159:   let maxSourceMtimeMs = 0;\n160: \n161:   const skillSlugs = listSkillSlugs(skillRoot);\n162:   for (const skillSlug of skillSlugs) {\n163:     const skillDirectory = join(skillRoot, skillSlug);\n164:     const skillMd = fileProbe(join(skillDirectory, 'SKILL.md'));\n165:     if (!skillMd) {\n166:       continue;\n167:     }\n168:     const graphMetadata = fileProbe(join(skillDirectory, 'graph-metadata.json'));\n169:     const routerMd = fileProbe(join(skillDirectory, 'ROUTER.md'));\n170:     maxSourceMtimeMs = Math.max(\n171:       maxSourceMtimeMs,\n172:       skillMd.mtimeMs,\n173:       graphMetadata?.mtimeMs ?? 0,\n174:       routerMd?.mtimeMs ?? 0,\n175:     );\n176:     skillFingerprints.set(skillSlug, {\n177:       skillMdMtime: skillMd.mtimeMs,\n178:       skillMdSize: skillMd.size,\n179:       skillMdHash: skillMd.contentHash,\n180:       graphMetaMtime: graphMetadata?.mtimeMs ?? null,\n181:       graphMetaHash: graphMetadata?.contentHash ?? null,\n182:     });\n183:     addSignaturePart(hash, `skill:${skillSlug}:SKILL.md`, skillMd);\n184:     addSignaturePart(hash, `skill:${skillSlug}:graph-metadata.json`, graphMetadata);\n185:     // ROUTER.md is optional, so a skill without one keeps the signature it had\n186:     // before this probe existed; only a skill that carries the file adds a part.\n187:     if (routerMd) {\n188:       addSignaturePart(hash, `skill:${skillSlug}:ROUTER.md`, routerMd);\n189:     }\n190:   }\n191: \n192:   if (skillSlugs.length === 0 || skillFingerprints.size === 0) {\n193:     missingSources.push(SKILL_ROOT_RELATIVE_PATH);\n194:   }\n195: \n196:   for (const relativePath of REQUIRED_SCRIPT_RELATIVE_PATHS) {\n197:     const probe = fileProbe(join(root, relativePath));\n198:     if (!probe) {\n199:       missingSources.push(relativePath);\n200:     } else {\n201:       maxSourceMtimeMs = Math.max(maxSourceMtimeMs, probe.mtimeMs);\n202:     }\n203:     addSignaturePart(hash, relativePath, probe);\n204:   }\n205: \n206:   const sqliteArtifact = fileProbe(join(root, SQLITE_ARTIFACT_RELATIVE_PATH));\n207:   const jsonArtifact = fileProbe(join(root, JSON_ARTIFACT_RELATIVE_PATH));\n208:   addSignaturePart(hash, SQLITE_ARTIFACT_RELATIVE_PATH, sqliteArtifact);\n209:   addSignaturePart(hash, JSON_ARTIFACT_RELATIVE_PATH, jsonArtifact);\n210: \n211:   return {\n212:     sourceSignature: hash.digest('hex'),\n213:     skillFingerprints,\n214:     maxSourceMtimeMs,\n215:     sqliteArtifact,\n216:     jsonArtifact,\n217:     missingSources,\n218:   };\n219: }\n220: \n221: export function computeAdvisorSourceSignature(workspaceRoot: string): string {\n222:   return buildSourceSnapshot(workspaceRoot).sourceSignature;\n223: }\n224: \n225: function nonLiveDiagnostics(\n226:   reason: string,\n227:   missingSources: string[] = [],\n228:   recoveryPath?: AdvisorGenerationRecoveryPath,\n229:   errorDiagnostics?: AdvisorErrorDiagnostics,\n230: ): AdvisorFreshnessDiagnostics {\n231:   return {\n232:     reason,\n233:     ...(missingSources.length > 0 ? { missingSources } : {}),\n234:     ...(recoveryPath ? { recoveryPath } : {}),\n235:     ...(errorDiagnostics ?? {}),\n236:   };\n237: }\n238: \n239: function resultFromSnapshot(\n240:   snapshot: SourceSnapshot,\n241:   generation: number,\n242:   state: AdvisorFreshnessState,\n243:   fallbackMode: AdvisorFallbackMode,\n244:   diagnostics: AdvisorFreshnessDiagnostics | null,\n245: ): AdvisorFreshnessResult {\n246:   return {\n247:     state,\n248:     generation,\n249:     sourceSignature: snapshot.sourceSignature,\n250:     skillFingerprints: snapshot.skillFingerprints,\n251:     fallbackMode,\n252:     probedAt: new Date().toISOString(),\n253:     diagnostics,\n254:   };\n255: }\n256: \n257: function deriveFreshness(snapshot: SourceSnapshot, generation: AdvisorGenerationSnapshot): AdvisorFreshnessResult {\n258:   const generationNumber = generation.generation;\n259: \n260:   if (snapshot.missingSources.length > 0) {\n261:     return resultFromSnapshot(\n262:       snapshot,\n263:       generationNumber,\n264:       'absent',\n265:       snapshot.sqliteArtifact ? 'sqlite' : snapshot.jsonArtifact ? 'json' : 'none',\n266:       nonLiveDiagnostics('ADVISOR_SOURCE_MISSING', snapshot.missingSources),\n267:     );\n268:   }\n269: \n270:   if (!snapshot.sqliteArtifact) {\n271:     if (snapshot.jsonArtifact) {\n272:       return resultFromSnapshot(\n273:         snapshot,\n274:         generationNumber,\n275:         'stale',\n276:         'json',\n277:         nonLiveDiagnostics('JSON_FALLBACK_ONLY', [SQLITE_ARTIFACT_RELATIVE_PATH]),\n278:       );\n279:     }\n[Output truncated. Continue reading with offset: 280]","title":"read","metadata":{"metadata":{"truncated":true},"content":[{"type":"text","text":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/lib/freshness.ts, 