Z\"\n    },\n    \"lastGenerationBump\": \"2026-11-12T20:11:12.363Z\",\n    \"lastScanAt\": \"2026-11-12T20:11:12.363Z\",\n    \"skillCount\": 14,\n    \"indexStaleness\": {\n      \"state\": \"fresh\",\n      \"reason\": null,\n      \"trackedSkills\": 14,\n      \"freshSourceFiles\": 14,\n      \"changedSourceFiles\": 0,\n      \"missingSourceFiles\": 0,\n      \"staleSkillIds\": []\n    },\n    \"laneWeights\": {\n      \"explicit_author\": 0.42,\n      \"lexical\": 0.28,\n      \"graph_causal\": 0.13,\n      \"derived_generated\": 0.12,\n      \"semantic_shadow\": 0.05\n    }\n  }\n}\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"node .skilled/bin/skill-advisor.cjs advisor_status --json '{\\\"workspaceRoot\\\":\\\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research\\\"}' --format json 2>&1 | head -80\",\"timeout\":120000,\"workdir\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research\"}"},"time":{"start":1794521946207,"end":1794521947169}}}}
