{"type":"tool_use","timestamp":1794521937121,"sessionID":"ses_e2e2a8545ffel5iCm3sO3VeatJ","part":{"partID":"prt_1d1d7b350001esx0jXrJBX2FIu","sessionID":"ses_e2e2a8545ffel5iCm3sO3VeatJ","messageID":"msg_1d1d796aa001KrSkOlpOoIczYA","type":"tool","id":"call_5cdba79fde8f453789ec3631","tool":"read","state":{"status":"completed","input":{"path":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/lib/freshness/trust-state.ts"},"output":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/lib/freshness/trust-state.ts, lines 1-171\n1: // ───────────────────────────────────────────────────────────────\n2: // MODULE: Advisor Freshness Trust State\n3: // ───────────────────────────────────────────────────────────────\n4: // Canonical TrustState surface. This module is\n5: // the SINGLE source of truth for the 4-value caller-trust axis used by\n6: // every freshness producer (advisor, hook brief, code-graph handlers).\n7: //\n8: // Migration map (V1-V5 → canonical):\n9: //   V1  ensure-ready GraphFreshness = 'fresh' | 'stale' | 'empty'\n10: //       → DELETED, re-exported from ops-hardening (V2 superset).\n11: //   V2  ops-hardening GraphFreshness = 'fresh' | 'stale' | 'empty' | 'error'\n12: //       → CANONICAL L1 storage vocabulary (graph internal state).\n13: //   V3  ops-hardening StructuralReadiness = 'ready' | 'stale' | 'missing'\n14: //       → CANONICAL L2 readiness vocabulary (handler-level summary).\n15: //   V4  startup-brief graphState = 'ready' | 'stale' | 'empty' | 'missing'\n16: //       → CANONICAL L4 startup-surface vocabulary (now also accepts\n17: //         'error' via the trustStateFromGraphState mapper widening).\n18: //   V5  SkillGraphTrustState = 'live' | 'stale' | 'absent' | 'unavailable'\n19: //       → CANONICAL L3 caller-trust vocabulary (THIS module). Widened\n20: //         to include 'unavailable' for unreachable scopes.\n21: //\n22: // Cross-module mapping (V2 → V5 via readiness-contract.ts):\n23: //   'fresh' → 'live'\n24: //   'stale' → 'stale'\n25: //   'empty' → 'absent'\n26: // 'error' → 'unavailable' ← widening\n27: //\n28: // During the migration window we keep the SharedPayloadTrustState super-\n29: // type (8 values) as the wire-level union and re-export the 4-value\n30: // SkillGraphTrustState here as the advisor-facing alias. External\n31: // consumers should depend on `SkillGraphTrustState` from this module\n32: // rather than carving out their own narrower unions.\n33: \n34: // ───────────────────────────────────────────────────────────────────\n35: // 1. IMPORTS\n36: // ───────────────────────────────────────────────────────────────────\n37: import { isSpeckitMetricsEnabled, speckitMetrics } from '../metrics.js';\n38: // SkillGraphTrustState now derives from a canonical tuple in\n39: // trust-state-values.ts. The local re-export keeps every existing consumer\n40: // importing this path; the tuple is the single source of truth.\n41: import {\n42:   SKILL_GRAPH_TRUST_STATE_VALUES,\n43:   isSkillGraphTrustState,\n44:   type SkillGraphTrustState,\n45: } from './trust-state-values.js';\n46: \n47: // ───────────────────────────────────────────────────────────────────\n48: // 2. TYPE DEFINITIONS\n49: // ───────────────────────────────────────────────────────────────────\n50: export type GraphFreshness = 'fresh' | 'stale' | 'empty' | 'error';\n51: export type StructuralReadiness = 'ready' | 'stale' | 'missing';\n52: \n53: export {\n54:   SKILL_GRAPH_TRUST_STATE_VALUES,\n55:   isSkillGraphTrustState,\n56:   type SkillGraphTrustState,\n57: };\n58: export type StartupGraphState = 'ready' | 'stale' | 'empty' | 'missing' | 'error';\n59: \n60: // ───────────────────────────────────────────────────────────────────\n61: // 3. HELPERS\n62: // ───────────────────────────────────────────────────────────────────\n63: let lastObservedTrustState: SkillGraphTrustState | null = null;\n64: \n65: function recordTrustStateTransition(next: SkillGraphTrustState): void {\n66:   if (!isSpeckitMetricsEnabled()) {\n67:     lastObservedTrustState = next;\n68:     return;\n69:   }\n70:   const previous = lastObservedTrustState;\n71:   if (previous !== null && previous !== next) {\n72:     speckitMetrics.incrementCounter('spec_kit.freshness.state_transitions_total', { from_state: previous, to_state: next });\n73:   }\n74:   lastObservedTrustState = next;\n75: }\n76: \n77: // ───────────────────────────────────────────────────────────────────\n78: // 4. STATE CONTRACTS\n79: // ───────────────────────────────────────────────────────────────────\n80: /**\n81:  * Canonical alias used by callers that previously imported a custom\n82:  * `TrustState` type. Use `SkillGraphTrustState` for new code.\n83:  *\n84:  * @deprecated Use `SkillGraphTrustState` directly. Kept for one release\n85:  *   so in-flight branches keep compiling against the canonical vocabulary.\n86:  */\n87: export type TrustState = SkillGraphTrustState;\n88: \n89: export interface TrustStateSnapshot {\n90:   readonly state: SkillGraphTrustState;\n91:   readonly reason: string | null;\n92:   readonly generation: number;\n93:   readonly checkedAt: string;\n94:   readonly lastLiveAt: string | null;\n95: }\n96: \n97: export interface TrustStateInput {\n98:   readonly hasSources: boolean;\n99:   readonly hasArtifact: boolean;\n100:   readonly sourceChanged: boolean;\n101:   readonly daemonAvailable: boolean;\n102:   readonly generation: number;\n103:   readonly reason?: string | null;\n104:   readonly now?: Date;\n105:   readonly lastLiveAt?: string | null;\n106: }\n107: \n108: // ───────────────────────────────────────────────────────────────────\n109: // 5. CORE LOGIC\n110: // ───────────────────────────────────────────────────────────────────\n111: export function createTrustState(input: TrustStateInput): TrustStateSnapshot {\n112:   const checkedAt = (input.now ?? new Date()).toISOString();\n113:   const snapshot = computeTrustState(input, checkedAt);\n114:   recordTrustStateTransition(snapshot.state);\n115:   return snapshot;\n116: }\n117: \n118: function computeTrustState(input: TrustStateInput, checkedAt: string): TrustStateSnapshot {\n119:   if (!input.daemonAvailable) {\n120:     return {\n121:       state: 'unavailable',\n122:       reason: input.reason ?? 'DAEMON_UNAVAILABLE',\n123:       generation: input.generation,\n124:       checkedAt,\n125:       lastLiveAt: input.lastLiveAt ?? null,\n126:     };\n127:   }\n128: \n129:   if (!input.hasSources || !input.hasArtifact) {\n130:     return {\n131:       state: 'absent',\n132:       reason: input.reason ?? (input.hasSources ? 'SKILL_GRAPH_ABSENT' : 'SKILL_SOURCES_ABSENT'),\n133:       generation: input.generation,\n134:       checkedAt,\n135:       lastLiveAt: input.lastLiveAt ?? null,\n136:     };\n137:   }\n138: \n139:   if (input.sourceChanged) {\n140:     return {\n141:       state: 'stale',\n142:       reason: input.reason ?? 'SOURCE_NEWER_THAN_SKILL_GRAPH',\n143:       generation: input.generation,\n144:       checkedAt,\n145:       lastLiveAt: input.lastLiveAt ?? null,\n146:     };\n147:   }\n148: \n149:   return {\n150:     state: 'live',\n151:     reason: null,\n152:     generation: input.generation,\n153:     checkedAt,\n154:     lastLiveAt: input.lastLiveAt ?? checkedAt,\n155:   };\n156: }\n157: \n158: export function failOpenTrustState(reason: string, generation = 0): TrustStateSnapshot {\n159:   return createTrustState({\n160:     hasSources: false,\n161:     hasArtifact: false,\n162:     sourceChanged: false,\n163:     daemonAvailable: false,\n164:     generation,\n165:     reason,\n166:   });\n167: }\n168: \n169: export function isReaderUsable(state: SkillGraphTrustState): boolean {\n170:   return state === 'live' || state === 'stale';\n171: }","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/lib/freshness/trust-state.ts, lines 1-171\n1: // ───────────────────────────────────────────────────────────────\n2: // MODULE: Advisor Freshness Trust State\n3: // ───────────────────────────────────────────────────────────────\n4: // Canonical TrustState surface. This module is\n5: // the SINGLE source of truth for the 4-value caller-trust axis used by\n6: // every freshness producer (advisor, hook brief, code-graph handlers).\n7: //\n8: // Migration map (V1-V5 → canonical):\n9: //   V1  ensure-ready GraphFreshness = 'fresh' | 'stale' | 'empty'\n10: //       → DELETED, re-exported from ops-hardening (V2 superset).\n11: //   V2  ops-hardening GraphFreshness = 'fresh' | 'stale' | 'empty' | 'error'\n12: //       → CANONICAL L1 storage vocabulary (graph internal state).\n13: //   V3  ops-hardening StructuralReadiness = 'ready' | 'stale' | 'missing'\n14: //       → CANONICAL L2 readiness vocabulary (handler-level summary).\n15: //   V4  startup-brief graphState = 'ready' | 'stale' | 'empty' | 'missing'\n16: //       → CANONICAL L4 startup-surface vocabulary (now also accepts\n17: //         'error' via the trustStateFromGraphState mapper widening).\n18: //   V5  SkillGraphTrustState = 'live' | 'stale' | 'absent' | 'unavailable'\n19: //       → CANONICAL L3 caller-trust vocabulary (THIS module). Widened\n20: //         to include 'unavailable' for unreachable scopes.\n21: //\n22: // Cross-module mapping (V2 → V5 via readiness-contract.ts):\n23: //   'fresh' → 'live'\n24: //   'stale' → 'stale'\n25: //   'empty' → 'absent'\n26: // 'error' → 'unavailable' ← widening\n27: //\n28: // During the migration window we keep the SharedPayloadTrustState super-\n29: // type (8 values) as the wire-level union and re-export the 4-value\n30: // SkillGraphTrustState here as the advisor-facing alias. External\n31: // consumers should depend on `SkillGraphTrustState` from this module\n32: // rather than carving out their own narrower unions.\n33: \n34: // ───────────────────────────────────────────────────────────────────\n35: // 1. IMPORTS\n36: // ───────────────────────────────────────────────────────────────────\n37: import { isSpeckitMetricsEnabled, speckitMetrics } from '../metrics.js';\n38: // SkillGraphTrustState now derives from a canonical tuple in\n39: // trust-state-values.ts. The local re-export keeps every existing consumer\n40: // importing this path; the tuple is the single source of truth.\n41: import {\n42:   SKILL_GRAPH_TRUST_STATE_VALUES,\n43:   isSkillGraphTrustState,\n44:   type SkillGraphTrustState,\n45: } from './trust-state-values.js';\n46: \n47: // ───────────────────────────────────────────────────────────────────\n48: // 2. TYPE DEFINITIONS\n49: // ───────────────────────────────────────────────────────────────────\n50: export type GraphFreshness = 'fresh' | 'stale' | 'empty' | 'error';\n51: export type StructuralReadiness = 'ready' | 'stale' | 'missing';\n52: \n53: export {\n54:   SKILL_GRAPH_TRUST_STATE_VALUES,\n55:   isSkillGraphTrustState,\n56:   type SkillGraphTrustState,\n57: };\n58: export type StartupGraphState = 'ready' | 'stale' | 'empty' | 'missing' | 'error';\n59: \n60: // ───────────────────────────────────────────────────────────────────\n61: // 3. HELPERS\n62: // ───────────────────────────────────────────────────────────────────\n63: let lastObservedTrustState: SkillGraphTrustState | null = null;\n64: \n65: function recordTrustStateTransition(next: SkillGraphTrustState): void {\n66:   if (!isSpeckitMetricsEnabled()) {\n67:     lastObservedTrustState = next;\n68:     return;\n69:   }\n70:   const previous = lastObservedTrustState;\n71:   if (previous !== null && previous !== next) {\n72:     speckitMetrics.incrementCounter('spec_kit.freshness.state_transitions_total', { from_state: previous, to_state: next });\n73:   }\n74:   lastObservedTrustState = next;\n75: }\n76: \n77: // ───────────────────────────────────────────────────────────────────\n78: // 4. STATE CONTRACTS\n79: // ───────────────────────────────────────────────────────────────────\n80: /**\n81:  * Canonical alias used by callers that previously imported a custom\n82:  * `TrustState` type. Use `SkillGraphTrustState` for new code.\n83:  *\n84:  * @deprecated Use `SkillGraphTrustState` directly. Kept for one release\n85:  *   so in-flight branches keep compiling against the canonical vocabulary.\n86:  */\n87: export type TrustState = SkillGraphTrustState;\n88: \n89: export interface TrustStateSnapshot {\n90:   readonly state: SkillGraphTrustState;\n91:   readonly reason: string | null;\n92:   readonly generation: number;\n93:   readonly checkedAt: string;\n94:   readonly lastLiveAt: string | null;\n95: }\n96: \n97: export interface TrustStateInput {\n98:   readonly hasSources: boolean;\n99:   readonly hasArtifact: boolean;\n100:   readonly sourceChanged: boolean;\n101:   readonly daemonAvailable: boolean;\n102:   readonly generation: number;\n103:   readonly reason?: string | null;\n104:   readonly now?: Date;\n105:   readonly lastLiveAt?: string | null;\n106: }\n107: \n108: // ───────────────────────────────────────────────────────────────────\n109: // 5. CORE LOGIC\n110: // ───────────────────────────────────────────────────────────────────\n111: export function createTrustState(input: TrustStateInput): TrustStateSnapshot {\n112:   const checkedAt = (input.now ?? new Date()).toISOString();\n113:   const snapshot = computeTrustState(input, checkedAt);\n114:   recordTrustStateTransition(snapshot.state);\n115:   return snapshot;\n116: }\n117: \n118: function computeTrustState(input: TrustStateInput, checkedAt: string): TrustStateSnapshot {\n119:   if (!input.daemonAvailable) {\n120:     return {\n121:       state: 'unavailable',\n122:       reason: input.reason ?? 'DAEMON_UNAVAILABLE',\n123:       generation: input.generation,\n124:       checkedAt,\n125:       lastLiveAt: input.lastLiveAt ?? null,\n126:     };\n127:   }\n128: \n129:   if (!input.hasSources || !input.hasArtifact) {\n130:     return {\n131:       state: 'absent',\n132:       reason: input.reason ?? (input.hasSources ? 'SKILL_GRAPH_ABSENT' : 'SKILL_SOURCES_ABSENT'),\n133:       generation: input.generation,\n134:       checkedAt,\n135:       lastLiveAt: input.lastLiveAt ?? null,\n136:     };\n137:   }\n138: \n139:   if (input.sourceChanged) {\n140:     return {\n141:       state: 'stale',\n142:       reason: input.reason ?? 'SOURCE_NEWER_THAN_SKILL_GRAPH',\n143:       generation: input.generation,\n144:       checkedAt,\n145:       lastLiveAt: input.lastLiveAt ?? null,\n146:     };\n147:   }\n148: \n149:   return {\n150:     state: 'live',\n151:     reason: null,\n152:     generation: input.generation,\n153:     checkedAt,\n154:     lastLiveAt: input.lastLiveAt ?? checkedAt,\n155:   };\n156: }\n157: \n158: export function failOpenTrustState(reason: string, generation = 0): TrustStateSnapshot {\n159:   return createTrustState({\n160:     hasSources: false,\n161:     hasArtifact: false,\n162:     sourceChanged: false,\n163:     daemonAvailable: false,\n164:     generation,\n165:     reason,\n166:   });\n167: }\n168: \n169: export function isReaderUsable(state: SkillGraphTrustState): boolean {\n170:   return state === 'live' || state === 'stale';\n171: }"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/lib/freshness/trust-state.ts\"}"},"time":{"start":1794521936720,"end":1794521937121}}}}
