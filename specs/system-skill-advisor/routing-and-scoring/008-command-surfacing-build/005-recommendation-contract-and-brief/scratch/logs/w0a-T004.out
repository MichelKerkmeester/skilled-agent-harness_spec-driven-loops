request.\n114:  *\n115:  * Rebuild mutates the shared skill graph, so it requires a trusted caller\n116:  * just like skill_graph_scan; untrusted callers are rejected before any\n117:  * status read or index write happens.\n118:  */\n119: export async function handleAdvisorRebuild(\n120:   args: unknown,\n121:   callerContext?: CallerContext | null,\n122: ): Promise<HandlerResponse> {\n123:   const trustedCaller = requireTrustedCaller(callerContext, 'advisor_rebuild');\n124:   if (!trustedCaller.ok) {\n125:     return {\n126:       content: [{\n127:         type: 'text',\n128:         text: JSON.stringify({\n129:           status: 'error',\n130:           error: 'advisor_rebuild requires trusted caller context',\n131:           code: trustedCaller.code,\n132:         }),\n133:       }],\n134:     };\n135:   }\n136: \n137:   const data = rebuildAdvisorIndex(AdvisorRebuildInputSchema.parse(args));\n138:   return {\n139:     content: [{\n140:       type: 'text',\n141:       text: JSON.stringify({ status: 'ok', data }, null, 2),\n142:     }],\n143:   };\n144: }\n145: ","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/handlers/advisor-rebuild.ts, lines 80-145\n80:       generationBefore: before.generation,\n81:       generationAfter: before.generation,\n82:       skillCount: before.skillCount,\n83:       summary: null,\n84:       diagnostics: ['advisor_rebuild skipped because advisor_status is live; pass force:true to rebuild anyway'],\n85:     });\n86:   }\n87: \n88:   const skillsRoot = resolve(workspaceRoot, '.skilled', 'skills');\n89:   const summary = (dependencies.indexSkills ?? indexSkillMetadata)(skillsRoot);\n90:   (dependencies.publishGeneration ?? publishSkillGraphGeneration)({\n91:     workspaceRoot,\n92:     changedPaths: [skillsRoot],\n93:     reason: 'advisor_rebuild',\n94:     state: 'li