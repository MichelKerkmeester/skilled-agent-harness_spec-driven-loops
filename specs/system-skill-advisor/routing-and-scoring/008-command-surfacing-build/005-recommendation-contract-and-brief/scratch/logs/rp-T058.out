{"type":"tool_use","timestamp":1794531175037,"sessionID":"ses_e2d9b8ffbffea7yLpb2QNPNlui","part":{"partID":"prt_1d264a87c001B6Qt8gJgkmsKvy","sessionID":"ses_e2d9b8ffbffea7yLpb2QNPNlui","messageID":"msg_1d2649411001p8CLnLmHYzy9SS","type":"tool","id":"call_8c6942e4b99c460aac14f01d","tool":"read","state":{"status":"completed","input":{"path":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/tests/command-bridges-drift-guard.vitest.ts"},"output":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/tests/command-bridges-drift-guard.vitest.ts, lines 1-538\n1: // ───────────────────────────────────────────────────────────────────\n2: // MODULE: Command Bridges Shadow Drift Guard\n3: // ───────────────────────────────────────────────────────────────────\n4: \n5: import { execFileSync } from 'node:child_process';\n6: import { existsSync, mkdirSync, mkdtempSync, readFileSync, readdirSync, rmSync, symlinkSync, writeFileSync } from 'node:fs';\n7: import { createRequire } from 'node:module';\n8: import { tmpdir } from 'node:os';\n9: import { join } from 'node:path';\n10: \n11: import { describe, expect, it } from 'vitest';\n12: import { parse as parseYaml } from 'yaml';\n13: \n14: import { COMMAND_BRIDGES, GENERATED_COMMAND_BRIDGES } from '../lib/scorer/projection.js';\n15: import { findAdvisorWorkspaceRoot } from '../lib/utils/workspace-root.js';\n16: \n17: interface CommandBridgeEntry {\n18:   readonly id: string;\n19:   readonly command: string;\n20:   readonly skillId: string;\n21:   readonly ownerMode: string;\n22:   readonly description?: string;\n23:   readonly ownedSignals?: readonly string[];\n24:   readonly standalone?: boolean;\n25:   readonly mutating?: string;\n26:   readonly source: string;\n27:   readonly runtime?: {\n28:     readonly typescript: { readonly enabled: boolean };\n29:     readonly python: { readonly enabled: boolean };\n30:   };\n31: }\n32: \n33: interface CommandBridgeDump {\n34:   readonly count: number;\n35:   readonly entries: readonly CommandBridgeEntry[];\n36: }\n37: \n38: interface AllowListEntry extends Omit<CommandBridgeEntry, 'source'> {\n39:   readonly reason: string;\n40: }\n41: \n42: type Runtime = 'typescript' | 'python';\n43: \n44: interface CompatibilityRow {\n45:   readonly inventoryId: string;\n46:   readonly order: number;\n47:   readonly id: string;\n48:   readonly description: string;\n49:   readonly name?: string;\n50:   readonly keywords?: readonly string[];\n51:   readonly domains?: readonly string[];\n52:   readonly intentSignals?: readonly string[];\n53:   readonly slashMarkers?: readonly string[];\n54:   readonly leadPhrases?: readonly string[];\n55:   readonly readOnly?: boolean;\n56:   readonly deprecated?: boolean;\n57:   readonly owningSkill?: string;\n58: }\n59: \n60: interface CompatibilitySnapshot {\n61:   readonly typescript: readonly CompatibilityRow[];\n62:   readonly python: readonly CompatibilityRow[];\n63:   readonly pythonOwnerNormalization: Readonly<Record<string, string>>;\n64: }\n65: \n66: // A standalone skill's command paired with the inventory row it enters under.\n67: interface StandaloneCommand {\n68:   readonly inventoryId: string;\n69:   readonly inventorySkillId: string;\n70:   readonly command: string;\n71:   readonly description: string;\n72:   readonly ownedSignals: readonly string[];\n73:   readonly mutating: string;\n74:   readonly recordSkillId: string;\n75: }\n76: \n77: interface TypescriptEvidence {\n78:   readonly inventoryId: string;\n79:   readonly ownerSkill: string;\n80:   readonly id: string;\n81:   readonly name: string;\n82:   readonly description: string;\n83:   readonly keywords: readonly string[];\n84:   readonly domains: readonly string[];\n85:   readonly intentSignals: readonly string[];\n86:   readonly readOnly: boolean;\n87: }\n88: \n89: interface ProjectionRow {\n90:   readonly id: string;\n91:   readonly inventoryId?: string;\n92:   readonly ownerSkill?: string;\n93:   readonly name?: string;\n94:   readonly description?: string;\n95:   readonly keywords?: readonly string[];\n96:   readonly domains?: readonly string[];\n97:   readonly intentSignals?: readonly string[];\n98:   readonly readOnly?: boolean;\n99: }\n100: \n101: const REPO_ROOT = findAdvisorWorkspaceRoot(import.meta.dirname);\n102: const SKILLS_ROOT = join(REPO_ROOT, '.skilled', 'skills');\n103: const DOCTOR_DIR = join(REPO_ROOT, '.skilled', 'commands', 'doctor');\n104: const DOCTOR_PREFIX = 'command-doctor-';\n105: const DOCTOR_MCP_COMMAND = '/doctor:mcp';\n106: const COMMAND_BRIDGES_DIR = join(\n107:   SKILLS_ROOT,\n108:   'system-skill-advisor',\n109:   'runtime',\n110:   'scripts',\n111:   'command-bridges',\n112: );\n113: const GENERATED_PATH = join(COMMAND_BRIDGES_DIR, 'command-bridges.generated.json');\n114: const ALLOW_LIST_PATH = join(COMMAND_BRIDGES_DIR, 'allow-list.json');\n115: const COMPATIBILITY_PATH = join(COMMAND_BRIDGES_DIR, 'scoring-compatibility.json');\n116: const ADVISOR_SCRIPT = join(COMMAND_BRIDGES_DIR, '..', 'skill_advisor.py');\n117: \n118: function bridgeId(command: string): string {\n119:   return `command-${command.slice(1).replace(':', '-')}`;\n120: }\n121: \n122: function metadataProjection(): CommandBridgeEntry[] {\n123:   const entries: CommandBridgeEntry[] = [];\n124:   for (const skillId of readdirSync(SKILLS_ROOT).sort()) {\n125:     const metadataPath = join(SKILLS_ROOT, skillId, 'command-metadata.json');\n126:     if (!existsSync(metadataPath)) continue;\n127:     const metadata = JSON.parse(readFileSync(metadataPath, 'utf8')) as ReadonlyArray<{\n128:       readonly command: string;\n129:       readonly ownerMode: string;\n130:       readonly description?: string;\n131:       readonly mutating?: string;\n132:       readonly userIntent?: { readonly ownedSignals?: readonly string[] };\n133:     }>;\n134:     const source = `.skilled/skills/${skillId}/command-metadata.json`;\n135:     // A skill with no mode registry has no hub to route its commands, so its\n136:     // metadata is the whole declaration of what each command reaches.\n137:     const standalone = !existsSync(join(SKILLS_ROOT, skillId, 'mode-registry.json'));\n138:     for (const entry of metadata) {\n139:       entries.push({\n140:         id: bridgeId(entry.command),\n141:         command: entry.command,\n142:         skillId,\n143:         ownerMode: entry.ownerMode,\n144:         description: entry.description ?? '',\n145:         ownedSignals: [...(entry.userIntent?.ownedSignals ?? [])],\n146:         standalone,\n147:         mutating: entry.mutating,\n148:         source,\n149:       });\n150:     }\n151:   }\n152:   return entries;\n153: }\n154: \n155: function doctorProjection(): CommandBridgeEntry[] {\n156:   const source = '.skilled/commands/doctor/_routes.yaml';\n157:   const manifest = parseYaml(readFileSync(join(DOCTOR_DIR, '_routes.yaml'), 'utf8')) as {\n158:     readonly routes: readonly { readonly command: string; readonly target: string }[];\n159:     readonly standalone?: readonly { readonly command?: string }[];\n160:     readonly mcp_subroutes?: readonly { readonly sub_action: string }[];\n161:   };\n162:   const doctorName = (command: string): string => {\n163:     const match = /^\\/doctor:([a-z0-9-]+)$/.exec(command);\n164:     if (!match) throw new Error(`Unrecognized doctor command in ${source}: ${command}`);\n165:     return match[1] as string;\n166:   };\n167:   const routeCounts = new Map<string, number>();\n168:   for (const route of manifest.routes) {\n169:     const commandName = doctorName(route.command);\n170:     routeCounts.set(commandName, (routeCounts.get(commandName) ?? 0) + 1);\n171:   }\n172:   const skillAgent = (commandName: string): string => {\n173:     const router = readFileSync(join(DOCTOR_DIR, `${commandName}.md`), 'utf8');\n174:     const tag = /<!--\\s*skill_agent:\\s*([a-z0-9-]+)\\s*-->/.exec(router);\n175:     if (!tag) throw new Error(`No skill_agent tag in ${commandName}.md`);\n176:     return tag[1] as string;\n177:   };\n178: \n179:   const entries = manifest.routes.map((route) => {\n180:     const commandName = doctorName(route.command);\n181:     const skillId = skillAgent(commandName);\n182:     return {\n183:       // A command with several targets needs one bridge per target; a\n184:       // single-target command takes the command's own id.\n185:       id: (routeCounts.get(commandName) ?? 0) > 1\n186:         ? `${DOCTOR_PREFIX}${commandName}-${route.target}`\n187:         : `${DOCTOR_PREFIX}${commandName}`,\n188:       command: route.command,\n189:       skillId,\n190:       ownerMode: skillId,\n191:       source,\n192:     };\n193:   });\n194: \n195:   for (const item of manifest.standalone ?? []) {\n196:     if (typeof item.command !== 'string') continue;\n197:     const commandName = doctorName(item.command);\n198:     const skillId = skillAgent(commandName);\n199:     entries.push({\n200:       id: `${DOCTOR_PREFIX}${commandName}`,\n201:       command: item.command,\n202:       skillId,\n203:       ownerMode: skillId,\n204:       source,\n205:     });\n206:   }\n207: \n208:   const mcpCommandName = doctorName(DOCTOR_MCP_COMMAND);\n209:   for (const item of manifest.mcp_subroutes ?? []) {\n210:     const skillId = skillAgent(mcpCommandName);\n211:     entries.push({\n212:       id: `${DOCTOR_PREFIX}${mcpCommandName}-${item.sub_action}`,\n213:       command: DOCTOR_MCP_COMMAND,\n214:       skillId,\n215:       ownerMode: skillId,\n216:       source,\n217:     });\n218:   }\n219: \n220:   return entries;\n221: }\n222: \n223: function sorted(entries: readonly CommandBridgeEntry[]): CommandBridgeEntry[] {\n224:   return [...entries].sort((left, right) => left.id.localeCompare(right.id));\n225: }\n226: \n227: function inventoryEntry(entry: CommandBridgeEntry): CommandBridgeEntry {\n228:   // Both fields are derived for a consumer, never authored, so neither is part\n229:   // of the inventory this guard compares against its sources.\n230:   const { runtime: _runtime, embeddingText: _embeddingText, ...inventory } = entry;\n231:   return inventory;\n232: }\n233: \n234: function allowListEntries(): readonly AllowListEntry[] {\n235:   return JSON.parse(readFileSync(ALLOW_LIST_PATH, 'utf8')) as readonly AllowListEntry[];\n236: }\n237: \n238: // Every bridge the generated file holds: one per declaration, plus the residual\n239: // allow-list rows and the doctor routes the same inventory is built from.\n240: function inventoryProjection(): CommandBridgeEntry[] {\n241:   const allowList = allowListEntries();\n242:   // A command the allow-list already carries keeps that row's id, so its\n243:   // metadata entry adds no second bridge for the same command.\n244:   const allowListCommands = new Set(allowList.map((entry) => entry.command));\n245:   return sorted([\n246:     ...metadataProjection().filter((entry) => !allowListCommands.has(entry.command)),\n247:     ...allowList.map(({ reason: _reason, ...entry }) => ({\n248:       ...entry,\n249:       source: 'scripts/command-bridges/allow-list.json',\n250:     })),\n251:     ...doctorProjection(),\n252:   ]);\n253: }\n254: \n255: function compatibilitySnapshot(): CompatibilitySnapshot {\n256:   return JSON.parse(readFileSync(COMPATIBILITY_PATH, 'utf8')) as CompatibilitySnapshot;\n257: }\n258: \n259: // A compatibility row is hand-curated: its order, runtime id and phrases are the\n260: // curation itself, so the expectation reads them verbatim.\n261: function handRows(platform: Runtime): CompatibilityRow[] {\n262:   return compatibilitySnapshot()[platform]\n263:     .filter((row) => !row.inventoryId.startsWith(DOCTOR_PREFIX))\n264:     .sort((left, right) => left.order - right.order);\n265: }\n266: \n267: // A standalone skill's command is the one bridge its metadata declares, matched by\n268: // command rather than by id because a command can enter the inventory under a row\n269: // carrying its own historical id.\n270: function standaloneCommands(): StandaloneCommand[] {\n271:   const records = new Map(\n272:     metadataProjection()\n273:       .filter((entry) => entry.standalone === true)\n274:       .map((entry) => [entry.command, entry] as const),\n275:   );\n276:   return inventoryProjection()\n277:     .filter((entry) => records.has(entry.command))\n278:     .map((entry) => {\n279:       const record = records.get(entry.command) as CommandBridgeEntry;\n280:       return {\n281:         inventoryId: entry.id,\n282:         inventorySkillId: entry.skillId,\n283:         command: entry.command,\n284:         description: record.description ?? '',\n285:         ownedSignals: [...(record.ownedSignals ?? [])],\n286:         mutating: record.mutating ?? '',\n287:         recordSkillId: record.skillId,\n288:       };\n289:     });\n290: }\n291: \n292: // A hand row still wins where one exists, because a curated row can carry phrases\n293: // the metadata cannot know. Only the commands without one are generated.\n294: function generatedRows(platform: Runtime): StandaloneCommand[] {\n295:   const hand = new Set(compatibilitySnapshot()[platform].map((row) => row.inventoryId));\n296:   return standaloneCommands().filter((command) => !hand.has(command.inventoryId));\n297: }\n298: \n299: function activeInventoryIds(platform: Runtime): string[] {\n300:   return [\n301:     ...handRows(platform).map((row) => row.inventoryId),\n302:     ...generatedRows(platform).map((command) => command.inventoryId),\n303:   ].sort();\n304: }\n305: \n306: function commandNamespace(command: string): string {\n307:   return command.slice(1, command.indexOf(':'));\n308: }\n309: \n310: // The active TypeScript half of the surface: a hand row passes its curated entry\n311: // through unchanged, and a generated row takes its phrases, description and\n312: // read-only class from the standalone skill's metadata.\n313: function typescriptEvidence(): TypescriptEvidence[] {\n314:   const inventorySkill = new Map(\n315:     inventoryProjection().map((entry) => [entry.id, entry.skillId] as const),\n316:   );\n317:   return [\n318:     ...handRows('typescript').map((row) => ({\n319:       inventoryId: row.inventoryId,\n320:       ownerSkill: inventorySkill.get(row.inventoryId) ?? '',\n321:       id: row.id,\n322:       name: row.name ?? '',\n323:       description: row.description,\n324:       keywords: [...(row.keywords ?? [])],\n325:       domains: [...(row.domains ?? [])],\n326:       intentSignals: [...(row.intentSignals ?? [])],\n327:       readOnly: row.readOnly === true,\n328:     })),\n329:     ...generatedRows('typescript').map((command) => ({\n330:       inventoryId: command.inventoryId,\n331:       ownerSkill: command.inventorySkillId,\n332:       id: command.inventoryId,\n333:       name: command.inventoryId,\n334:       description: command.description,\n335:       keywords: [...command.ownedSignals],\n336:       domains: [commandNamespace(command.command), 'command'],\n337:       intentSignals: [...command.ownedSignals],\n338:       readOnly: command.mutating === 'read-only',\n339:     })),\n340:   ];\n341: }\n342: \n343: function typescriptView(entry: ProjectionRow): TypescriptEvidence {\n344:   return {\n345:     inventoryId: entry.inventoryId ?? entry.id,\n346:     ownerSkill: entry.ownerSkill ?? '',\n347:     id: entry.id,\n348:     name: entry.name ?? '',\n349:     description: entry.description ?? '',\n350:     keywords: [...(entry.keywords ?? [])],\n351:     domains: [...(entry.domains ?? [])],\n352:     intentSignals: [...(entry.intentSignals ?? [])],\n353:     readOnly: entry.readOnly === true,\n354:   };\n355: }\n356: \n357: function byInventoryId(\n358:   left: { readonly inventoryId: string },\n359:   right: { readonly inventoryId: string },\n360: ): number {\n361:   return left.inventoryId.localeCompare(right.inventoryId);\n362: }\n363: \n364: // The live Python dict is rendered in runtime order, so the expectation keeps the\n365: // hand rows in their compatibility order and appends the generated rows the way the\n366: // generator numbers them: after the highest hand order, by inventory id.\n367: function pythonEvidence(): Array<[string, Record<string, unknown>]> {\n368:   const hand: Array<[string, Record<string, unknown>]> = handRows('python').map((row) => [\n369:     row.id,\n370:     {\n371:       description: row.description,\n372:       slash_markers: [...(row.slashMarkers ?? [])],\n373:       ...(row.leadPhrases !== undefined && row.leadPhrases.length > 0\n374:         ? { lead_phrases: [...row.leadPhrases] }\n375:         : {}),\n376:       ...(row.deprecated === true ? { deprecated: true } : {}),\n377:       ...(typeof row.owningSkill === 'string' ? { owning_skill: row.owningSkill } : {}),\n378:     },\n379:   ]);\n380:   const generated: Array<[string, Record<string, unknown>]> = generatedRows('python').map(\n381:     (command) => [\n382:       command.inventoryId,\n383:       {\n384:         description: command.description,\n385:         slash_markers: [command.command, command.command.slice(1)],\n386:         owning_skill: command.recordSkillId,\n387:       },\n388:     ],\n389:   );\n390:   return [...hand, ...generated];\n391: }\n392: \n393: describe('command-bridges drift guard', () => {\n394:   it('generated projection exactly equals JSON-derived ids union the residual allow-list and the doctor routes', () => {\n395:     const generated = JSON.parse(readFileSync(GENERATED_PATH, 'utf8')) as CommandBridgeDump;\n396:     const expected = inventoryProjection();\n397:     const expectedIds = new Set(expected.map((entry) => entry.id));\n398:     const generatedInventory = generated.entries.map(inventoryEntry);\n399:     const generatedIds = new Set(generatedInventory.map((entry) => entry.id));\n400:     const missing = [...expectedIds].filter((id) => !generatedIds.has(id)).sort();\n401:     const extra = [...generatedIds].filter((id) => !expectedIds.has(id)).sort();\n402: \n403:     expect({ missing, extra }, `NAMING missing=${missing.join(',')} extra=${extra.join(',')}`).toEqual({\n404:       missing: [],\n405:       extra: [],\n406:     });\n407:     expect(sorted(generatedInventory)).toEqual(expected);\n408:   });\n409: \n410:   it('generates all inventory ids for both runtimes and scores exactly the compatibility rows plus the standalone commands', () => {\n411:     const generated = JSON.parse(readFileSync(GENERATED_PATH, 'utf8')) as CommandBridgeDump;\n412:     const inventoryIds = generated.entries.map((entry) => entry.id).sort();\n413:     const typescriptInventoryIds = GENERATED_COMMAND_BRIDGES\n414:       .map((entry) => entry.inventoryId ?? entry.id)\n415:       .sort();\n416: \n417:     expect(typescriptInventoryIds).toEqual(inventoryIds);\n418: \n419:     // Two rules turn a row on: a compatibility row names its runtime id, order and\n420:     // phrases by hand, and a standalone skill's command carries the same kind of\n421:     // declaration in its own metadata, so it needs no hand row to become reachable.\n422:     // Both halves are read out of the source files, never out of the current output.\n423:     expect(\n424:       GENERATED_COMMAND_BRIDGES.filter(\n425:         (entry) => entry.routingEnabled !== false && !entry.id.startsWith(DOCTOR_PREFIX),\n426:       )\n427:         .map(typescriptView)\n428:         .sort(byInventoryId),\n429:     ).toEqual(typescriptEvidence().sort(byInventoryId));\n430: \n431:     const enabledIds = (platform: Runtime): string[] => generated.entries\n432:       .filter(\n433:         (entry) => !entry.id.startsWith(DOCTOR_PREFIX) && entry.runtime?.[platform].enabled === true,\n434:       )\n435:       .map((entry) => entry.id)\n436:       .sort();\n437: \n438:     expect(enabledIds('typescript')).toEqual(activeInventoryIds('typescript'));\n439:     expect(enabledIds('python')).toEqual(activeInventoryIds('python'));\n440: \n441:     // Derived, not literal. This was a hardcoded total and went stale twice: once\n442:     // when a hub deprecation removed commands, once when new ones were added. The\n443:     // export may alias either the active subset or the whole inventory, so accept\n444:     // either, but measure both from the generated file rather than a magic number.\n445:     const typescriptActiveAll = GENERATED_COMMAND_BRIDGES.filter(\n446:       (entry) => entry.routingEnabled !== false,\n447:     ).length;\n448:     expect([typescriptActiveAll, inventoryIds.length]).toContain(COMMAND_BRIDGES.length);\n449:   });\n450: \n451:   it('preserves the Python bridge records, order, and owner normalization byte-for-byte', () => {\n452:     const probe = [\n453:       'import json, runpy, sys',\n454:       'module = runpy.run_path(sys.argv[1])',\n455:       'metadata = {\"inventory_id\", \"command\", \"skill_id\", \"owner_mode\", \"routing_enabled\"}',\n456:       'def cleaned(records):',\n457:       '    return [[key, {k: v for k, v in value.items() if k not in metadata}]',\n458:       '            for key, value in records.items() if value.get(\"routing_enabled\", True)',\n459:       '            and not key.startswith(\"command-doctor-\")]',\n460:       'print(json.dumps({',\n461:       '    \"generated\": cleaned(module[\"GENERATED_COMMAND_BRIDGES\"]),',\n462:       '    \"generatedOwners\": module[\"GENERATED_COMMAND_BRIDGE_OWNER_NORMALIZATION\"],',\n463:       '}))',\n464:     ].join('\\n');\n465:     const output = execFileSync('python3', ['-c', probe, ADVISOR_SCRIPT], {\n466:       cwd: REPO_ROOT,\n467:       encoding: 'utf8',\n468:     });\n469:     const runtime = JSON.parse(output) as {\n470:       readonly generated: unknown;\n471:       readonly generatedOwners: unknown;\n472:     };\n473: \n474:     expect(runtime.generated).toEqual(pythonEvidence());\n475: \n476:     const expectedOwners = compatibilitySnapshot().pythonOwnerNormalization;\n477:     expect(runtime.generatedOwners).toEqual(expectedOwners);\n478:     // Dict order is what the runtime walks, so it is part of the record too.\n479:     expect(Object.keys(runtime.generatedOwners as Record<string, string>)).toEqual(\n480:       Object.keys(expectedOwners),\n481:     );\n482:   });\n483: \n484:   it('live Python bridges match the generated projection exactly', () => {\n485:     const generated = JSON.parse(readFileSync(GENERATED_PATH, 'utf8')) as CommandBridgeDump;\n486:     const stdout = execFileSync('python3', [ADVISOR_SCRIPT, '--dump-command-bridges'], {\n487:       cwd: REPO_ROOT,\n488:       encoding: 'utf8',\n489:     });\n490:     const live = JSON.parse(stdout) as CommandBridgeDump;\n491:     const generatedById = new Map(generated.entries.map((entry) => [entry.id, entry] as const));\n492:     const liveById = new Map(live.entries.map((entry) => [entry.id, entry] as const));\n493:     const allIds = new Set([...generatedById.keys(), ...liveById.keys()]);\n494:     const actualDiff = [...allIds].filter((id) => {\n495:       const generatedEntry = generatedById.get(id);\n496:       const liveEntry = liveById.get(id);\n497:       if (!generatedEntry || !liveEntry) return true;\n498:       return ['command', 'skillId', 'ownerMode'].some(\n499:         (field) => generatedEntry[field as keyof CommandBridgeEntry] !== liveEntry[field as keyof CommandBridgeEntry],\n500:       );\n501:     }).sort();\n502: \n503:     // The live runtime consumes the generated projection, so any divergence —\n504:     // a missing id, an extra id, or a field mismatch — is real drift.\n505:     expect(actualDiff).toEqual([]);\n506:   });\n507: \n508:   it('derives bridges from real skill folders only, never a local-* folder or a linked one', () => {\n509:     const { metadataEntries } = createRequire(import.meta.url)(\n510:       join(COMMAND_BRIDGES_DIR, 'derive-command-bridges.cjs'),\n511:     ) as { metadataEntries: (skillsRoot: string) => Array<{ skillId: string }> };\n512:     const root = mkdtempSync(join(tmpdir(), 'command-bridges-'));\n513:     try {\n514:       const skills = join(root, 'skills');\n515:       const writeMetadata = (folder: string, command: string): void => {\n516:         mkdirSync(join(skills, folder), { recursive: true });\n517:         writeFileSync(\n518:           join(skills, folder, 'command-metadata.json'),\n519:           JSON.stringify([{ command, ownerMode: folder }]),\n520:           'utf8',\n521:         );\n522:       };\n523:       writeMetadata('alpha', '/alpha:run');\n524:       writeMetadata('local-private', '/private:run');\n525:       mkdirSync(join(root, 'elsewhere'), { recursive: true });\n526:       writeFileSync(\n527:         join(root, 'elsewhere', 'command-metadata.json'),\n528:         JSON.stringify([{ command: '/linked:run', ownerMode: 'linked' }]),\n529:         'utf8',\n530:       );\n531:       symlinkSync(join(root, 'elsewhere'), join(skills, 'linked'));\n532: \n533:       expect(metadataEntries(skills).map((entry) => entry.skillId)).toEqual(['alpha']);\n534:     } finally {\n535:       rmSync(root, { recursive: true, force: true });\n536:     }\n537:   });\n538: });","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/tests/command-bridges-drift-guard.vitest.ts, lines 1-538\n1: // ───────────────────────────────────────────────────────────────────\n2: // MODULE: Command Bridges Shadow Drift Guard\n3: // ───────────────────────────────────────────────────────────────────\n4: \n5: import { execFileSync } from 'node:child_process';\n6: import { existsSync, mkdirSync, mkdtempSync, readFileSync, readdirSync, rmSync, symlinkSync, writeFileSync } from 'node:fs';\n7: import { createRequire } from 'node:module';\n8: import { tmpdir } from 'node:os';\n9: import { join } from 'node:path';\n10: \n11: import { describe, expect, it } from 'vitest';\n12: import { parse as parseYaml } from 'yaml';\n13: \n14: import { COMMAND_BRIDGES, GENERATED_COMMAND_BRIDGES } from '../lib/scorer/projection.js';\n15: import { findAdvisorWorkspaceRoot } from '../lib/utils/workspace-root.js';\n16: \n17: interface CommandBridgeEntry {\n18:   readonly id: string;\n19:   readonly command: string;\n20:   readonly skillId: string;\n21:   readonly ownerMode: string;\n22:   readonly description?: string;\n23:   readonly ownedSignals?: readonly string[];\n24:   readonly standalone?: boolean;\n25:   readonly mutating?: string;\n26:   readonly source: string;\n27:   readonly runtime?: {\n28:     readonly typescript: { readonly enabled: boolean };\n29:     readonly python: { readonly enabled: boolean };\n30:   };\n31: }\n32: \n33: interface CommandBridgeDump {\n34:   readonly count: number;\n35:   readonly entries: readonly CommandBridgeEntry[];\n36: }\n37: \n38: interface AllowListEntry extends Omit<CommandBridgeEntry, 'source'> {\n39:   readonly reason: string;\n40: }\n41: \n42: type Runtime = 'typescript' | 'python';\n43: \n44: interface CompatibilityRow {\n45:   readonly inventoryId: string;\n46:   readonly order: number;\n47:   readonly id: string;\n48:   readonly description: string;\n49:   readonly name?: string;\n50:   readonly keywords?: readonly string[];\n51:   readonly domains?: readonly string[];\n52:   readonly intentSignals?: readonly string[];\n53:   readonly slashMarkers?: readonly string[];\n54:   readonly leadPhrases?: readonly string[];\n55:   readonly readOnly?: boolean;\n56:   readonly deprecated?: boolean;\n57:   readonly owningSkill?: string;\n58: }\n59: \n60: interface CompatibilitySnapshot {\n61:   readonly typescript: readonly CompatibilityRow[];\n62:   readonly python: readonly CompatibilityRow[];\n63:   readonly pythonOwnerNormalization: Readonly<Record<string, string>>;\n64: }\n65: \n66: // A standalone skill's command paired with the inventory row it enters under.\n67: interface StandaloneCommand {\n68:   readonly inventoryId: string;\n69:   readonly inventorySkillId: string;\n70:   readonly command: string;\n71:   readonly description: string;\n72:   readonly ownedSignals: readonly string[];\n73:   readonly mutating: string;\n74:   readonly recordSkillId: string;\n75: }\n76: \n77: interface TypescriptEvidence {\n78:   readonly inventoryId: string;\n79:   readonly ownerSkill: string;\n80:   readonly id: string;\n81:   readonly name: string;\n82:   readonly description: string;\n83:   readonly keywords: readonly string[];\n84:   readonly domains: readonly string[];\n85:   readonly intentSignals: readonly string[];\n86:   readonly readOnly: boolean;\n87: }\n88: \n89: interface ProjectionRow {\n90:   readonly id: string;\n91:   readonly inventoryId?: string;\n92:   readonly ownerSkill?: string;\n93:   readonly name?: string;\n94:   readonly description?: string;\n95:   readonly keywords?: readonly string[];\n96:   readonly domains?: readonly string[];\n97:   readonly intentSignals?: readonly string[];\n98:   readonly readOnly?: boolean;\n99: }\n100: \n101: const REPO_ROOT = findAdvisorWorkspaceRoot(import.meta.dirname);\n102: const SKILLS_ROOT = join(REPO_ROOT, '.skilled', 'skills');\n103: const DOCTOR_DIR = join(REPO_ROOT, '.skilled', 'commands', 'doctor');\n104: const DOCTOR_PREFIX = 'command-doctor-';\n105: const DOCTOR_MCP_COMMAND = '/doctor:mcp';\n106: const COMMAND_BRIDGES_DIR = join(\n107:   SKILLS_ROOT,\n108:   'system-skill-advisor',\n109:   'runtime',\n110:   'scripts',\n111:   'command-bridges',\n112: );\n113: const GENERATED_PATH = join(COMMAND_BRIDGES_DIR, 'command-bridges.generated.json');\n114: const ALLOW_LIST_PATH = join(COMMAND_BRIDGES_DIR, 'allow-list.json');\n115: const COMPATIBILITY_PATH = join(COMMAND_BRIDGES_DIR, 'scoring-compatibility.json');\n116: const ADVISOR_SCRIPT = join(COMMAND_BRIDGES_DIR, '..', 'skill_advisor.py');\n117: \n118: function bridgeId(command: string): string {\n119:   return `command-${command.slice(1).replace(':', '-')}`;\n120: }\n121: \n122: function metadataProjection(): CommandBridgeEntry[] {\n123:   const entries: CommandBridgeEntry[] = [];\n124:   for (const skillId of readdirSync(SKILLS_ROOT).sort()) {\n125:     const metadataPath = join(SKILLS_ROOT, skillId, 'command-metadata.json');\n126:     if (!existsSync(metadataPath)) continue;\n127:     const metadata = JSON.parse(readFileSync(metadataPath, 'utf8')) as ReadonlyArray<{\n128:       readonly command: string;\n129:       readonly ownerMode: string;\n130:       readonly description?: string;\n131:       readonly mutating?: string;\n132:       readonly userIntent?: { readonly ownedSignals?: readonly string[] };\n133:     }>;\n134:     const source = `.skilled/skills/${skillId}/command-metadata.json`;\n135:     // A skill with no mode registry has no hub to route its commands, so its\n136:     // metadata is the whole declaration of what each command reaches.\n137:     const standalone = !existsSync(join(SKILLS_ROOT, skillId, 'mode-registry.json'));\n138:     for (const entry of metadata) {\n139:       entries.push({\n140:         id: bridgeId(entry.command),\n141:         command: entry.command,\n142:         skillId,\n143:         ownerMode: entry.ownerMode,\n144:         description: entry.description ?? '',\n145:         ownedSignals: [...(entry.userIntent?.ownedSignals ?? [])],\n146:         standalone,\n147:         mutating: entry.mutating,\n148:         source,\n149:       });\n150:     }\n151:   }\n152:   return entries;\n153: }\n154: \n155: function doctorProjection(): CommandBridgeEntry[] {\n156:   const source = '.skilled/commands/doctor/_routes.yaml';\n157:   const manifest = parseYaml(readFileSync(join(DOCTOR_DIR, '_routes.yaml'), 'utf8')) as {\n158:     readonly routes: readonly { readonly command: string; readonly target: string }[];\n159:     readonly standalone?: readonly { readonly command?: string }[];\n160:     readonly mcp_subroutes?: readonly { readonly sub_action: string }[];\n161:   };\n162:   const doctorName = (command: string): string => {\n163:     const match = /^\\/doctor:([a-z0-9-]+)$/.exec(command);\n164:     if (!match) throw new Error(`Unrecognized doctor command in ${source}: ${command}`);\n165:     return match[1] as string;\n166:   };\n167:   const routeCounts = new Map<string, number>();\n168:   for (const route of manifest.routes) {\n169:     const commandName = doctorName(route.command);\n170:     routeCounts.set(commandName, (routeCounts.get(commandName) ?? 0) + 1);\n171:   }\n172:   const skillAgent = (commandName: string): string => {\n173:     const router = readFileSync(join(DOCTOR_DIR, `${commandName}.md`), 'utf8');\n174:     const tag = /<!--\\s*skill_agent:\\s*([a-z0-9-]+)\\s*-->/.exec(router);\n175:     if (!tag) throw new Error(`No skill_agent tag in ${commandName}.md`);\n176:     return tag[1] as string;\n177:   };\n178: \n179:   const entries = manifest.routes.map((route) => {\n180:     const commandName = doctorName(route.command);\n181:     const skillId = skillAgent(commandName);\n182:     return {\n183:       // A command with several targets needs one bridge per target; a\n184:       // single-target command takes the command's own id.\n185:       id: (routeCounts.get(commandName) ?? 0) > 1\n186:         ? `${DOCTOR_PREFIX}${commandName}-${route.target}`\n187:         : `${DOCTOR_PREFIX}${commandName}`,\n188:       command: route.command,\n189:       skillId,\n190:       ownerMode: skillId,\n191:       source,\n192:     };\n193:   });\n194: \n195:   for (const item of manifest.standalone ?? []) {\n196:     if (typeof item.command !== 'string') continue;\n197:     const commandName = doctorName(item.command);\n198:     const skillId = skillAgent(commandName);\n199:     entries.push({\n200:       id: `${DOCTOR_PREFIX}${commandName}`,\n201:       command: item.command,\n202:       skillId,\n203:       ownerMode: skillId,\n204:       source,\n205:     });\n206:   }\n207: \n208:   const mcpCommandName = doctorName(DOCTOR_MCP_COMMAND);\n209:   for (const item of manifest.mcp_subroutes ?? []) {\n210:     const skillId = skillAgent(mcpCommandName);\n211:     entries.push({\n212:       id: `${DOCTOR_PREFIX}${mcpCommandName}-${item.sub_action}`,\n213:       command: DOCTOR_MCP_COMMAND,\n214:       skillId,\n215:       ownerMode: skillId,\n216:       source,\n217:     });\n218:   }\n219: \n220:   return entries;\n221: }\n222: \n223: function sorted(entries: readonly CommandBridgeEntry[]): CommandBridgeEntry[] {\n224:   return [...entries].sort((left, right) => left.id.localeCompare(right.id));\n225: }\n226: \n227: function inventoryEntry(entry: CommandBridgeEntry): CommandBridgeEntry {\n228:   // Both fields are derived for a consumer, never authored, so neither is part\n229:   // of the inventory this guard compares against its sources.\n230:   const { runtime: _runtime, embeddingText: _embeddingText, ...inventory } = entry;\n231:   return inventory;\n232: }\n233: \n234: function allowListEntries(): readonly AllowListEntry[] {\n235:   return JSON.parse(readFileSync(ALLOW_LIST_PATH, 'utf8')) as readonly AllowListEntry[];\n236: }\n237: \n238: // Every bridge the generated file holds: one per declaration, plus the residual\n239: // allow-list rows and the doctor routes the same inventory is built from.\n240: function inventoryProjection(): CommandBridgeEntry[] {\n241:   const allowList = allowListEntries();\n242:   // A command the allow-list already carries keeps that row's id, so its\n243:   // metadata entry adds no second bridge for the same command.\n244:   const allowListCommands = new Set(allowList.map((entry) => entry.command));\n245:   return sorted([\n246:     ...metadataProjection().filter((entry) => !allowListCommands.has(entry.command)),\n247:     ...allowList.map(({ reason: _reason, ...entry }) => ({\n248:       ...entry,\n249:       source: 'scripts/command-bridges/allow-list.json',\n250:     })),\n251:     ...doctorProjection(),\n252:   ]);\n253: }\n254: \n255: function compatibilitySnapshot(): CompatibilitySnapshot {\n256:   return JSON.parse(readFileSync(COMPATIBILITY_PATH, 'utf8')) as CompatibilitySnapshot;\n257: }\n258: \n259: // A compatibility row is hand-curated: its order, runtime id and phrases are the\n260: // curation itself, so the expectation reads them verbatim.\n261: function handRows(platform: Runtime): CompatibilityRow[] {\n262:   return compatibilitySnapshot()[platform]\n263:     .filter((row) => !row.inventoryId.startsWith(DOCTOR_PREFIX))\n264:     .sort((left, right) => left.order - right.order);\n265: }\n266: \n267: // A standalone skill's command is the one bridge its metadata declares, matched by\n268: // command rather than by id because a command can enter the inventory under a row\n269: // carrying its own historical id.\n270: function standaloneCommands(): StandaloneCommand[] {\n271:   const records = new Map(\n272:     metadataProjection()\n273:       .filter((entry) => entry.standalone === true)\n274:       .map((entry) => [entry.command, entry] as const),\n275:   );\n276:   return inventoryProjection()\n277:     .filter((entry) => records.has(entry.command))\n278:     .map((entry) => {\n279:       const record = records.get(entry.command) as CommandBridgeEntry;\n280:       return {\n281:         inventoryId: entry.id,\n282:         inventorySkillId: entry.skillId,\n283:         command: entry.command,\n284:         description: record.description ?? '',\n285:         ownedSignals: [...(record.ownedSignals ?? [])],\n286:         mutating: record.mutating ?? '',\n287:         recordSkillId: record.skillId,\n288:       };\n289:     });\n290: }\n291: \n292: // A hand row still wins where one exists, because a curated row can carry phrases\n293: // the metadata cannot know. Only the commands without one are generated.\n294: function generatedRows(platform: Runtime): StandaloneCommand[] {\n295:   const hand = new Set(compatibilitySnapshot()[platform].map((row) => row.inventoryId));\n296:   return standaloneCommands().filter((command) => !hand.has(command.inventoryId));\n297: }\n298: \n299: function activeInventoryIds(platform: Runtime): string[] {\n300:   return [\n301:     ...handRows(platform).map((row) => row.inventoryId),\n302:     ...generatedRows(platform).map((command) => command.inventoryId),\n303:   ].sort();\n304: }\n305: \n306: function commandNamespace(command: string): string {\n307:   return command.slice(1, command.indexOf(':'));\n308: }\n309: \n310: // The active TypeScript half of the surface: a hand row passes its curated entry\n311: // through unchanged, and a generated row takes its phrases, description and\n312: // read-only class from the standalone skill's metadata.\n313: function typescriptEvidence(): TypescriptEvidence[] {\n314:   const inventorySkill = new Map(\n315:     inventoryProjection().map((entry) => [entry.id, entry.skillId] as const),\n316:   );\n317:   return [\n318:     ...handRows('typescript').map((row) => ({\n319:       inventoryId: row.inventoryId,\n320:       ownerSkill: inventorySkill.get(row.inventoryId) ?? '',\n321:       id: row.id,\n322:       name: row.name ?? '',\n323:       description: row.description,\n324:       keywords: [...(row.keywords ?? [])],\n325:       domains: [...(row.domains ?? [])],\n326:       intentSignals: [...(row.intentSignals ?? [])],\n327:       readOnly: row.readOnly === true,\n328:     })),\n329:     ...generatedRows('typescript').map((command) => ({\n330:       inventoryId: command.inventoryId,\n331:       ownerSkill: command.inventorySkillId,\n332:       id: command.inventoryId,\n333:       name: command.inventoryId,\n334:       description: command.description,\n335:       keywords: [...command.ownedSignals],\n336:       domains: [commandNamespace(command.command), 'command'],\n337:       intentSignals: [...command.ownedSignals],\n338:       readOnly: command.mutating === 'read-only',\n339:     })),\n340:   ];\n341: }\n342: \n343: function typescriptView(entry: ProjectionRow): TypescriptEvidence {\n344:   return {\n345:     inventoryId: entry.inventoryId ?? entry.id,\n346:     ownerSkill: entry.ownerSkill ?? '',\n347:     id: entry.id,\n348:     name: entry.name ?? '',\n349:     description: entry.description ?? '',\n350:     keywords: [...(entry.keywords ?? [])],\n351:     domains: [...(entry.domains ?? [])],\n352:     intentSignals: [...(entry.intentSignals ?? [])],\n353:     readOnly: entry.readOnly === true,\n354:   };\n355: }\n356: \n357: function byInventoryId(\n358:   left: { readonly inventoryId: string },\n359:   right: { readonly inventoryId: string },\n360: ): number {\n361:   return left.inventoryId.localeCompare(right.inventoryId);\n362: }\n363: \n364: // The live Python dict is rendered in runtime order, so the expectation keeps the\n365: // hand rows in their compatibility order and appends the generated rows the way the\n366: // generator numbers them: after the highest hand order, by inventory id.\n367: function pythonEvidence(): Array<[string, Record<string, unknown>]> {\n368:   const hand: Array<[string, Record<string, unknown>]> = handRows('python').map((row) => [\n369:     row.id,\n370:     {\n371:       description: row.description,\n372:       slash_markers: [...(row.slashMarkers ?? [])],\n373:       ...(row.leadPhrases !== undefined && row.leadPhrases.length > 0\n374:         ? { lead_phrases: [...row.leadPhrases] }\n375:         : {}),\n376:       ...(row.deprecated === true ? { deprecated: true } : {}),\n377:       ...(typeof row.owningSkill === 'string' ? { owning_skill: row.owningSkill } : {}),\n378:     },\n379:   ]);\n380:   const generated: Array<[string, Record<string, unknown>]> = generatedRows('python').map(\n381:     (command) => [\n382:       command.inventoryId,\n383:       {\n384:         description: command.description,\n385:         slash_markers: [command.command, command.command.slice(1)],\n386:         owning_skill: command.recordSkillId,\n387:       },\n388:     ],\n389:   );\n390:   return [...hand, ...generated];\n391: }\n392: \n393: describe('command-bridges drift guard', () => {\n394:   it('generated projection exactly equals JSON-derived ids union the residual allow-list and the doctor routes', () => {\n395:     const generated = JSON.parse(readFileSync(GENERATED_PATH, 'utf8')) as CommandBridgeDump;\n396:     const expected = inventoryProjection();\n397:     const expectedIds = new Set(expected.map((entry) => entry.id));\n398:     const generatedInventory = generated.entries.map(inventoryEntry);\n399:     const generatedIds = new Set(generatedInventory.map((entry) => entry.id));\n400:     const missing = [...expectedIds].filter((id) => !generatedIds.has(id)).sort();\n401:     const extra = [...generatedIds].filter((id) => !expectedIds.has(id)).sort();\n402: \n403:     expect({ missing, extra }, `NAMING missing=${missing.join(',')} extra=${extra.join(',')}`).toEqual({\n404:       missing: [],\n405:       extra: [],\n406:     });\n407:     expect(sorted(generatedInventory)).toEqual(expected);\n408:   });\n409: \n410:   it('generates all inventory ids for both runtimes and scores exactly the compatibility rows plus the standalone commands', () => {\n411:     const generated = JSON.parse(readFileSync(GENERATED_PATH, 'utf8')) as CommandBridgeDump;\n412:     const inventoryIds = generated.entries.map((entry) => entry.id).sort();\n413:     const typescriptInventoryIds = GENERATED_COMMAND_BRIDGES\n414:       .map((entry) => entry.inventoryId ?? entry.id)\n415:       .sort();\n416: \n417:     expect(typescriptInventoryIds).toEqual(inventoryIds);\n418: \n419:     // Two rules turn a row on: a compatibility row names its runtime id, order and\n420:     // phrases by hand, and a standalone skill's command carries the same kind of\n421:     // declaration in its own metadata, so it needs no hand row to become reachable.\n422:     // Both halves are read out of the source files, never out of the current output.\n423:     expect(\n424:       GENERATED_COMMAND_BRIDGES.filter(\n425:         (entry) => entry.routingEnabled !== false && !entry.id.startsWith(DOCTOR_PREFIX),\n426:       )\n427:         .map(typescriptView)\n428:         .sort(byInventoryId),\n429:     ).toEqual(typescriptEvidence().sort(byInventoryId));\n430: \n431:     const enabledIds = (platform: Runtime): string[] => generated.entries\n432:       .filter(\n433:         (entry) => !entry.id.startsWith(DOCTOR_PREFIX) && entry.runtime?.[platform].enabled === true,\n434:       )\n435:       .map((entry) => entry.id)\n436:       .sort();\n437: \n438:     expect(enabledIds('typescript')).toEqual(activeInventoryIds('typescript'));\n439:     expect(enabledIds('python')).toEqual(activeInventoryIds('python'));\n440: \n441:     // Derived, not literal. This was a hardcoded total and went stale twice: once\n442:     // when a hub deprecation removed commands, once when new ones were added. The\n443:     // export may alias either the active subset or the whole inventory, so accept\n444:     // either, but measure both from the generated file rather than a magic number.\n445:     const typescriptActiveAll = GENERATED_COMMAND_BRIDGES.filter(\n446:       (entry) => entry.routingEnabled !== false,\n447:     ).length;\n448:     expect([typescriptActiveAll, inventoryIds.length]).toContain(COMMAND_BRIDGES.length);\n449:   });\n450: \n451:   it('preserves the Python bridge records, order, and owner normalization byte-for-byte', () => {\n452:     const probe = [\n453:       'import json, runpy, sys',\n454:       'module = runpy.run_path(sys.argv[1])',\n455:       'metadata = {\"inventory_id\", \"command\", \"skill_id\", \"owner_mode\", \"routing_enabled\"}',\n456:       'def cleaned(records):',\n457:       '    return [[key, {k: v for k, v in value.items() if k not in metadata}]',\n458:       '            for key, value in records.items() if value.get(\"routing_enabled\", True)',\n459:       '            and not key.startswith(\"command-doctor-\")]',\n460:       'print(json.dumps({',\n461:       '    \"generated\": cleaned(module[\"GENERATED_COMMAND_BRIDGES\"]),',\n462:       '    \"generatedOwners\": module[\"GENERATED_COMMAND_BRIDGE_OWNER_NORMALIZATION\"],',\n463:       '}))',\n464:     ].join('\\n');\n465:     const output = execFileSync('python3', ['-c', probe, ADVISOR_SCRIPT], {\n466:       cwd: REPO_ROOT,\n467:       encoding: 'utf8',\n468:     });\n469:     const runtime = JSON.parse(output) as {\n470:       readonly generated: unknown;\n471:       readonly generatedOwners: unknown;\n472:     };\n473: \n474:     expect(runtime.generated).toEqual(pythonEvidence());\n475: \n476:     const expectedOwners = compatibilitySnapshot().pythonOwnerNormalization;\n477:     expect(runtime.generatedOwners).toEqual(expectedOwners);\n478:     // Dict order is what the runtime walks, so it is part of the record too.\n479:     expect(Object.keys(runtime.generatedOwners as Record<string, string>)).toEqual(\n480:       Object.keys(expectedOwners),\n481:     );\n482:   });\n483: \n484:   it('live Python bridges match the generated projection exactly', () => {\n485:     const generated = JSON.parse(readFileSync(GENERATED_PATH, 'utf8')) as CommandBridgeDump;\n486:     const stdout = execFileSync('python3', [ADVISOR_SCRIPT, '--dump-command-bridges'], {\n487:       cwd: REPO_ROOT,\n488:       encoding: 'utf8',\n489:     });\n490:     const live = JSON.parse(stdout) as CommandBridgeDump;\n491:     const generatedById = new Map(generated.entries.map((entry) => [entry.id, entry] as const));\n492:     const liveById = new Map(live.entries.map((entry) => [entry.id, entry] as const));\n493:     const allIds = new Set([...generatedById.keys(), ...liveById.keys()]);\n494:     const actualDiff = [...allIds].filter((id) => {\n495:       const generatedEntry = generatedById.get(id);\n496:       const liveEntry = liveById.get(id);\n497:       if (!generatedEntry || !liveEntry) return true;\n498:       return ['command', 'skillId', 'ownerMode'].some(\n499:         (field) => generatedEntry[field as keyof CommandBridgeEntry] !== liveEntry[field as keyof CommandBridgeEntry],\n500:       );\n501:     }).sort();\n502: \n503:     // The live runtime consumes the generated projection, so any divergence —\n504:     // a missing id, an extra id, or a field mismatch — is real drift.\n505:     expect(actualDiff).toEqual([]);\n506:   });\n507: \n508:   it('derives bridges from real skill folders only, never a local-* folder or a linked one', () => {\n509:     const { metadataEntries } = createRequire(import.meta.url)(\n510:       join(COMMAND_BRIDGES_DIR, 'derive-command-bridges.cjs'),\n511:     ) as { metadataEntries: (skillsRoot: string) => Array<{ skillId: string }> };\n512:     const root = mkdtempSync(join(tmpdir(), 'command-bridges-'));\n513:     try {\n514:       const skills = join(root, 'skills');\n515:       const writeMetadata = (folder: string, command: string): void => {\n516:         mkdirSync(join(skills, folder), { recursive: true });\n517:         writeFileSync(\n518:           join(skills, folder, 'command-metadata.json'),\n519:           JSON.stringify([{ command, ownerMode: folder }]),\n520:           'utf8',\n521:         );\n522:       };\n523:       writeMetadata('alpha', '/alpha:run');\n524:       writeMetadata('local-private', '/private:run');\n525:       mkdirSync(join(root, 'elsewhere'), { recursive: true });\n526:       writeFileSync(\n527:         join(root, 'elsewhere', 'command-metadata.json'),\n528:         JSON.stringify([{ command: '/linked:run', ownerMode: 'linked' }]),\n529:         'utf8',\n530:       );\n531:       symlinkSync(join(root, 'elsewhere'), join(skills, 'linked'));\n532: \n533:       expect(metadataEntries(skills).map((entry) => entry.skillId)).toEqual(['alpha']);\n534:     } finally {\n535:       rmSync(root, { recursive: true, force: true });\n536:     }\n537:   });\n538: });"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skil