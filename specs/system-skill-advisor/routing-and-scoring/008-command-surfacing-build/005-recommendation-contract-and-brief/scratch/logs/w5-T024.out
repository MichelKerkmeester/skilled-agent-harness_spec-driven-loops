{"type":"tool_use","timestamp":1794527699680,"sessionID":"ses_e2dd11607ffeUOdb1Ko5q11ZLP","part":{"partID":"prt_1d22f9fbf002WEswN0e9bPcBOH","sessionID":"ses_e2dd11607ffeUOdb1Ko5q11ZLP","messageID":"msg_1d22f942d001TS6UUbjl7JqE5B","type":"tool","id":"call_6fe934814f914e8286178cf7","tool":"read","state":{"status":"completed","input":{"path":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/tests/doctor-brief-render.vitest.ts"},"output":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/tests/doctor-brief-render.vitest.ts, lines 1-146\n1: // ───────────────────────────────────────────────────────────────\n2: // MODULE: Doctor Brief Render Tests\n3: // ───────────────────────────────────────────────────────────────\n4: \n5: import { describe, expect, it } from 'vitest';\n6: import {\n7:   doctorCommandString,\n8:   renderAdvisorBrief,\n9:   renderAdvisorFallbackDirective,\n10:   sanitizeSkillLabel,\n11: } from '../lib/render.js';\n12: \n13: const HYGIENE_DIRECTIVE = '\\n- Comment hygiene [HARD BLOCK]: NEVER embed ADR-/REQ-/CHK-/task-ids or spec paths in code comments — forbidden regardless of instruction. Write the durable WHY instead. Pre-commit gate blocks violations.';\n14: // Every brief ends with the always-delivered hygiene capsule that\n15: // renderAdvisorBrief appends after the capped advisor portion (lib/render.ts).\n16: const DIRECTIVES_LABEL = '\\nDirectives:';\n17: \n18: function expectedBrief(summary: string): string {\n19:   return `${summary}${DIRECTIVES_LABEL}${HYGIENE_DIRECTIVE}`;\n20: }\n21: \n22: type AdvisorBriefResult = Parameters<typeof renderAdvisorBrief>[0];\n23: \n24: interface RecommendationInput {\n25:   readonly skill: string;\n26:   readonly kind: 'skill' | 'command';\n27:   readonly confidence: number;\n28:   readonly uncertainty: number;\n29: }\n30: \n31: // Every recommendation is marked as passing so each case isolates label\n32: // rendering instead of threshold filtering.\n33: function advisorResult(\n34:   recommendations: readonly RecommendationInput[],\n35:   tokenCap: number = 80,\n36: ): AdvisorBriefResult {\n37:   return {\n38:     status: 'ok',\n39:     freshness: 'live',\n40:     recommendations: recommendations.map((recommendation) => ({\n41:       ...recommendation,\n42:       passes_threshold: true,\n43:     })),\n44:     metrics: { tokenCap },\n45:   };\n46: }\n47: \n48: describe('doctor command brief', () => {\n49:   it('renders a top doctor bridge as its runnable command', () => {\n50:     const rendered = renderAdvisorBrief(advisorResult([\n51:       { skill: 'command-doctor-setup', kind: 'command', confidence: 0.85, uncertainty: 0.2 },\n52:     ]));\n53: \n54:     expect(rendered).toBe(expectedBrief('Advisor: live; use /doctor:setup 0.85/0.20 pass.'));\n55:   });\n56: \n57:   it('keeps the complete companion before directives under the default cap', () => {\n58:     const rendered = renderAdvisorBrief(advisorResult([\n59:       { skill: 'sk-git', kind: 'skill', confidence: 0.82, uncertainty: 0.2 },\n60:       { skill: 'command-doctor-git-setup', kind: 'command', confidence: 0.82, uncertainty: 0.21 },\n61:     ]));\n62: \n63:     expect(rendered).toBe(expectedBrief('Advisor: live; use sk-git 0.82/0.20 pass.\\nAlso: /doctor:git setup'));\n64:   });\n65: \n66:   it('uses the first doctor bridge after the top pick, past other skills', () => {\n67:     const rendered = renderAdvisorBrief(advisorResult([\n68:       { skill: 'sk-code', kind: 'skill', confidence: 0.82, uncertainty: 0.2 },\n69:       { skill: 'sk-git', kind: 'skill', confidence: 0.82, uncertainty: 0.2 },\n70:       { skill: 'command-doctor-update', kind: 'command', confidence: 0.82, uncertainty: 0.22 },\n71:     ])) ?? '';\n72: \n73:     expect(rendered).toContain('\\nAlso: /doctor:update');\n74:     expect(rendered.startsWith('Advisor: live; use sk-code 0.82/0.20 pass.')).toBe(true);\n75:   });\n76: \n77:   it('never renders a raw or unmapped doctor id', () => {\n78:     const withUnmappedBridge = renderAdvisorBrief(advisorResult([\n79:       { skill: 'sk-git', kind: 'skill', confidence: 0.82, uncertainty: 0.2 },\n80:       { skill: 'command-doctor-not-a-route', kind: 'command', confidence: 0.82, uncertainty: 0.21 },\n81:     ]));\n82:     expect(withUnmappedBridge).toBe(expectedBrief('Advisor: live; use sk-git 0.82/0.20 pass.'));\n83: \n84:     const unmappedBridgeAlone = renderAdvisorBrief(advisorResult([\n85:       { skill: 'command-doctor-not-a-route', kind: 'command', confidence: 0.85, uncertainty: 0.2 },\n86:     ]));\n87:     expect(unmappedBridgeAlone).toBeNull();\n88: \n89:     for (const rendered of [withUnmappedBridge ?? '', unmappedBridgeAlone ?? '']) {\n90:       expect(rendered).not.toContain('command-doctor-');\n91:     }\n92:   });\n93: \n94:   it('renders no companion line when no doctor bridge passes', () => {\n95:     const rendered = renderAdvisorBrief(advisorResult([\n96:       { skill: 'sk-git', kind: 'skill', confidence: 0.82, uncertainty: 0.2 },\n97:       { skill: 'sk-doc', kind: 'skill', confidence: 0.82, uncertainty: 0.2 },\n98:     ]));\n99: \n100:     expect(rendered).toBe(expectedBrief('Advisor: live; use sk-git 0.82/0.20 pass.'));\n101:   });\n102: \n103:   it('drops the entire companion when it does not fit the character cap', () => {\n104:     const rendered = renderAdvisorBrief(advisorResult([\n105:       { skill: 'sk-system-skill-advisor', kind: 'skill', confidence: 0.82, uncertainty: 0.2 },\n106:       { skill: 'command-doctor-git-setup', kind: 'command', confidence: 0.82, uncertainty: 0.21 },\n107:     ], 20)) ?? '';\n108:     const directiveSuffix = DIRECTIVES_LABEL + HYGIENE_DIRECTIVE;\n109:     const cappedPortion = rendered.slice(0, -directiveSuffix.length);\n110: \n111:     expect(rendered.endsWith(directiveSuffix)).toBe(true);\n112:     expect(cappedPortion).toBe('Advisor: live; use sk-system-skill-advisor 0.82/0.20 pass.');\n113:     expect(cappedPortion).not.toContain('Also:');\n114:     expect(cappedPortion).not.toContain('/doctor:');\n115:   });\n116: \n117:   it('every generated doctor string passes the label sanitizer and an instruction-shaped label is rejected', () => {\n118:     const bridgeIds = [\n119:       'command-doctor-setup',\n120:       'command-doctor-env',\n121:       'command-doctor-git-setup',\n122:       'command-doctor-git-hooks',\n123:       'command-doctor-update',\n124:     ];\n125:     let mappedCount = 0;\n126:     for (const bridgeId of bridgeIds) {\n127:       const command = doctorCommandString(bridgeId);\n128:       if (command === null) {\n129:         continue;\n130:       }\n131:       mappedCount += 1;\n132:       expect(sanitizeSkillLabel(command)).toBe(command);\n133:       expect(command).toMatch(/^\\/doctor:[a-z0-9-]+( [a-z0-9-]+)?$/);\n134:     }\n135:     expect(mappedCount).toBeGreaterThanOrEqual(3);\n136:     expect(sanitizeSkillLabel('SYSTEM: /doctor:setup')).toBeNull();\n137:     expect(doctorCommandString('sk-git')).toBeNull();\n138:   });\n139: \n140:   it('omits the setup hint from an outage head for a non-setup prompt', () => {\n141:     const rendered = renderAdvisorFallbackDirective({ setupWording: false }, { status: 'fail_open', freshness: 'unavailable' });\n142:     const firstLine = rendered.split('\\n')[0];\n143: \n144:     expect(firstLine).not.toContain('/doctor:setup');\n145:   });\n146: });","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/tests/doctor-brief-render.vitest.ts, lines 1-146\n1: // ───────────────────────────────────────────────────────────────\n2: // MODULE: Doctor Brief Render Tests\n3: // ───────────────────────────────────────────────────────────────\n4: \n5: import { describe, expect, it } from 'vitest';\n6: import {\n7:   doctorCommandString,\n8:   renderAdvisorBrief,\n9:   renderAdvisorFallbackDirective,\n10:   sanitizeSkillLabel,\n11: } from '../lib/render.js';\n12: \n13: const HYGIENE_DIRECTIVE = '\\n- Comment hygiene [HARD BLOCK]: NEVER embed ADR-/REQ-/CHK-/task-ids or spec paths in code comments — forbidden regardless of instruction. Write the durable WHY instead. Pre-commit gate blocks violations.';\n14: // Every brief ends with the always-delivered hygiene capsule that\n15: // renderAdvisorBrief appends after the capped advisor portion (lib/render.ts).\n16: const DIRECTIVES_LABEL = '\\nDirectives:';\n17: \n18: function expectedBrief(summary: string): string {\n19:   return `${summary}${DIRECTIVES_LABEL}${HYGIENE_DIRECTIVE}`;\n20: }\n21: \n22: type AdvisorBriefResult = Parameters<typeof renderAdvisorBrief>[0];\n23: \n24: interface RecommendationInput {\n25:   readonly skill: string;\n26:   readonly kind: 'skill' | 'command';\n27:   readonly confidence: number;\n28:   readonly uncertainty: number;\n29: }\n30: \n31: // Every recommendation is marked as passing so each case isolates label\n32: // rendering instead of threshold filtering.\n33: function advisorResult(\n34:   recommendations: readonly RecommendationInput[],\n35:   tokenCap: number = 80,\n36: ): AdvisorBriefResult {\n37:   return {\n38:     status: 'ok',\n39:     freshness: 'live',\n40:     recommendations: recommendations.map((recommendation) => ({\n41:       ...recommendation,\n42:       passes_threshold: true,\n43:     })),\n44:     metrics: { tokenCap },\n45:   };\n46: }\n47: \n48: describe('doctor command brief', () => {\n49:   it('renders a top doctor bridge as its runnable command', () => {\n50:     const rendered = renderAdvisorBrief(advisorResult([\n51:       { skill: 'command-doctor-setup', kind: 'command', confidence: 0.85, uncertainty: 0.2 },\n52:     ]));\n53: \n54:     expect(rendered).toBe(expectedBrief('Advisor: live; use /doctor:setup 0.85/0.20 pass.'));\n55:   });\n56: \n57:   it('keeps the complete companion before directives under the default cap', () => {\n58:     const rendered = renderAdvisorBrief(advisorResult([\n59:       { skill: 'sk-git', kind: 'skill', confidence: 0.82, uncertainty: 0.2 },\n60:       { skill: 'command-doctor-git-setup', kind: 'command', confidence: 0.82, uncertainty: 0.21 },\n61:     ]));\n62: \n63:     expect(rendered).toBe(expectedBrief('Advisor: live; use sk-git 0.82/0.20 pass.\\nAlso: /doctor:git setup'));\n64:   });\n65: \n66:   it('uses the first doctor bridge after the top pick, past other skills', () => {\n67:     const rendered = renderAdvisorBrief(advisorResult([\n68:       { skill: 'sk-code', kind: 'skill', confidence: 0.82, uncertainty: 0.2 },\n69:       { skill: 'sk-git', kind: 'skill', confidence: 0.82, uncertainty: 0.2 },\n70:       { skill: 'command-doctor-update', kind: 'command', confidence: 0.82, uncertainty: 0.22 },\n71:     ])) ?? '';\n72: \n73:     expect(rendered).toContain('\\nAlso: /doctor:update');\n74:     expect(rendered.startsWith('Advisor: live; use sk-code 0.82/0.20 pass.')).toBe(true);\n75:   });\n76: \n77:   it('never renders a raw or unmapped doctor id', () => {\n78:     const withUnmappedBridge = renderAdvisorBrief(advisorResult([\n79:       { skill: 'sk-git', kind: 'skill', confidence: 0.82, uncertainty: 0.2 },\n80:       { skill: 'command-doctor-not-a-route', kind: 'command', confidence: 0.82, uncertainty: 0.21 },\n81:     ]));\n82:     expect(withUnmappedBridge).toBe(expectedBrief('Advisor: live; use sk-git 0.82/0.20 pass.'));\n83: \n84:     const unmappedBridgeAlone = renderAdvisorBrief(advisorResult([\n85:       { skill: 'command-doctor-not-a-route', kind: 'command', confidence: 0.85, uncertainty: 0.2 },\n86:     ]));\n87:     expect(unmappedBridgeAlone).toBeNull();\n88: \n89:     for (const rendered of [withUnmappedBridge ?? '', unmappedBridgeAlone ?? '']) {\n90:       expect(rendered).not.toContain('command-doctor-');\n91:     }\n92:   });\n93: \n94:   it('renders no companion line when no doctor bridge passes', () => {\n95:     const rendered = renderAdvisorBrief(advisorResult([\n96:       { skill: 'sk-git', kind: 'skill', confidence: 0.82, uncertainty: 0.2 },\n97:       { skill: 'sk-doc', kind: 'skill', confidence: 0.82, uncertainty: 0.2 },\n98:     ]));\n99: \n100:     expect(rendered).toBe(expectedBrief('Advisor: live; use sk-git 0.82/0.20 pass.'));\n101:   });\n102: \n103:   it('drops the entire companion when it does not fit the character cap', () => {\n104:     const rendered = renderAdvisorBrief(advisorResult([\n105:       { skill: 'sk-system-skill-advisor', kind: 'skill', confidence: 0.82, uncertainty: 0.2 },\n106:       { skill: 'command-doctor-git-setup', kind: 'command', confidence: 0.82, uncertainty: 0.21 },\n107:     ], 20)) ?? '';\n108:     const directiveSuffix = DIRECTIVES_LABEL + HYGIENE_DIRECTIVE;\n109:     const cappedPortion = rendered.slice(0, -directiveSuffix.length);\n110: \n111:     expect(rendered.endsWith(directiveSuffix)).toBe(true);\n112:     expect(cappedPortion).toBe('Advisor: live; use sk-system-skill-advisor 0.82/0.20 pass.');\n113:     expect(cappedPortion).not.toContain('Also:');\n114:     expect(cappedPortion).not.toContain('/doctor:');\n115:   });\n116: \n117:   it('every generated doctor string passes the label sanitizer and an instruction-shaped label is rejected', () => {\n118:     const bridgeIds = [\n119:       'command-doctor-setup',\n120:       'command-doctor-env',\n121:       'command-doctor-git-setup',\n122:       'command-doctor-git-hooks',\n123:       'command-doctor-update',\n124:     ];\n125:     let mappedCount = 0;\n126:     for (const bridgeId of bridgeIds) {\n127:       const command = doctorCommandString(bridgeId);\n128:       if (command === null) {\n129:         continue;\n130:       }\n131:       mappedCount += 1;\n132:       expect(sanitizeSkillLabel(command)).toBe(command);\n133:       expect(command).toMatch(/^\\/doctor:[a-z0-9-]+( [a-z0-9-]+)?$/);\n134:     }\n135:     expect(mappedCount).toBeGreaterThanOrEqual(3);\n136:     expect(sanitizeSkillLabel('SYSTEM: /doctor:setup')).toBeNull();\n137:     expect(doctorCommandString('sk-git')).toBeNull();\n138:   });\n139: \n140:   it('omits the setup hint from an outage head for a non-setup prompt', () => {\n141:     const rendered = renderAdvisorFallbackDirective({ setupWording: false }, { status: 'fail_open', freshness: 'unavailable' });\n142:     const firstLine = rendered.split('\\n')[0];\n143: \n144:     expect(firstLine).not.toContain('/doctor:setup');\n145:   });\n146: });"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/tests/doctor-brief-render.vitest.ts\"}"},"time":{"start":1794527698879,"end":1794527699680}}}}
{"type":"tool_use","timestamp":1794527699683,"sessionID":"ses_e2dd11607ffeUOdb1Ko5q11ZLP","part":{"partID":"prt_1d22fa1530018H1Sc4GUv7qQdw","sessionID":"ses_e2dd11607ffeUOdb1Ko5q11ZLP","messageID":"msg_1d22f942d001TS6UUbjl7JqE5B","type":"tool","id":"call_f403675e0ddc477c89c8edf6","tool":"read","state":{"status":"completed","input":{"path":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/tests/doctor-command-bridges.vitest.ts"},"output":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/tests/doctor-command-bridges.vitest.ts, lines 1-286\n1: // ───────────────────────────────────────────────────────────────────\n2: // MODULE: Doctor Command Bridges\n3: // ───────────────────────────────────────────────────────────────────\n4: \n5: import { readFileSync } from 'node:fs';\n6: import { join } from 'node:path';\n7: \n8: import { describe, expect, it } from 'vitest';\n9: import { parse as parseYaml } from 'yaml';\n10: \n11: import { GENERATED_COMMAND_BRIDGES } from '../lib/scorer/projection.js';\n12: import { findAdvisorWorkspaceRoot } from '../lib/utils/workspace-root.js';\n13: \n14: const REPO_ROOT = findAdvisorWorkspaceRoot(import.meta.dirname);\n15: const DOCTOR_ROUTES_PATH = join(REPO_ROOT, '.skilled', 'commands', 'doctor', '_routes.yaml');\n16: const RENDER_PATH = join(\n17:   REPO_ROOT,\n18:   '.skilled',\n19:   'skills',\n20:   'system-skill-advisor',\n21:   'runtime',\n22:   'lib',\n23:   'render.ts',\n24: );\n25: const GENERATED_PATH = join(\n26:   REPO_ROOT,\n27:   '.skilled',\n28:   'skills',\n29:   'system-skill-advisor',\n30:   'runtime',\n31:   'scripts',\n32:   'command-bridges',\n33:   'command-bridges.generated.json',\n34: );\n35: const DOCTOR_PREFIX = 'command-doctor-';\n36: const DOCTOR_MCP_COMMAND = '/doctor:mcp';\n37: \n38: interface DoctorBridgeExpectation {\n39:   readonly runnable: string;\n40:   readonly bareCommand?: string;\n41:   readonly phrases: readonly string[];\n42:   readonly leadPhrases?: readonly string[];\n43:   readonly readOnly: boolean;\n44: }\n45: \n46: interface DoctorManifest {\n47:   readonly routes: readonly {\n48:     readonly command: string;\n49:     readonly target: string;\n50:     readonly trigger_phrases: readonly string[];\n51:     readonly lead_phrases?: readonly string[];\n52:     readonly default_target?: boolean;\n53:     readonly mutating?: string;\n54:   }[];\n55:   readonly standalone?: readonly {\n56:     readonly command?: string;\n57:     readonly runnable?: string;\n58:     readonly trigger_phrases?: readonly string[];\n59:     readonly lead_phrases?: readonly string[];\n60:     readonly mutating?: string;\n61:   }[];\n62:   readonly mcp_subroutes?: readonly {\n63:     readonly sub_action: string;\n64:     readonly trigger_phrases: readonly string[];\n65:     readonly lead_phrases?: readonly string[];\n66:     readonly mutating?: string;\n67:   }[];\n68: }\n69: \n70: interface GeneratedDoctorBridge {\n71:   readonly id: string;\n72:   readonly runtime: {\n73:     readonly python: {\n74:       readonly enabled: boolean;\n75:       readonly slashMarkers?: readonly string[];\n76:     };\n77:   };\n78: }\n79: \n80: function doctorName(command: string): string {\n81:   const match = /^\\/doctor:([a-z0-9-]+)$/.exec(command);\n82:   if (!match) throw new Error(`Unrecognized doctor command: ${command}`);\n83:   return match[1] as string;\n84: }\n85: \n86: // Expectations are recomputed from the route manifest rather than read back from\n87: // the generated artifacts, so a generator defect cannot hide behind its own output.\n88: function manifestDoctorBridges(): Map<string, DoctorBridgeExpectation> {\n89:   const manifest = parseYaml(readFileSync(DOCTOR_ROUTES_PATH, 'utf8')) as DoctorManifest;\n90:   const routeCounts = new Map<string, number>();\n91:   for (const route of manifest.routes) {\n92:     const name = doctorName(route.command);\n93:     routeCounts.set(name, (routeCounts.get(name) ?? 0) + 1);\n94:   }\n95: \n96:   const bridges = new Map<string, DoctorBridgeExpectation>();\n97:   for (const route of manifest.routes) {\n98:     const name = doctorName(route.command);\n99:     const multiTarget = (routeCounts.get(name) ?? 0) > 1;\n100:     bridges.set(multiTarget ? `${DOCTOR_PREFIX}${name}-${route.target}` : `${DOCTOR_PREFIX}${name}`, {\n101:       runnable: multiTarget ? `${route.command} ${route.target}` : route.command,\n102:       bareCommand: route.default_target === true ? route.command : undefined,\n103:       phrases: route.trigger_phrases,\n104:       leadPhrases: route.lead_phrases?.length ? route.lead_phrases : undefined,\n105:       readOnly: route.mutating === 'read-only',\n106:     });\n107:   }\n108: \n109:   for (const item of manifest.standalone ?? []) {\n110:     if (typeof item.command !== 'string') continue;\n111:     const name = doctorName(item.command);\n112:     const runnable = typeof item.runnable === 'string' && item.runnable ? item.runnable : item.command;\n113:     bridges.set(`${DOCTOR_PREFIX}${name}`, {\n114:       runnable,\n115:       phrases: Array.isArray(item.trigger_phrases) ? item.trigger_phrases : [],\n116:       leadPhrases: item.lead_phrases?.length ? item.lead_phrases : undefined,\n117:       readOnly: item.mutating === 'read-only',\n118:     });\n119:   }\n120: \n121:   for (const item of manifest.mcp_subroutes ?? []) {\n122:     const id = `${DOCTOR_PREFIX}${doctorName(DOCTOR_MCP_COMMAND)}-${item.sub_action}`;\n123:     bridges.set(id, {\n124:       runnable: `${DOCTOR_MCP_COMMAND} ${item.sub_action}`,\n125:       phrases: item.trigger_phrases,\n126:       leadPhrases: item.lead_phrases?.length ? item.lead_phrases : undefined,\n127:       readOnly: item.mutating === 'read-only',\n128:     });\n129:   }\n130: \n131:   return bridges;\n132: }\n133: \n134: function renderedDoctorStrings(): Map<string, string> {\n135:   const render = readFileSync(RENDER_PATH, 'utf8');\n136:   const startMarker = '// BEGIN GENERATED DOCTOR COMMANDS';\n137:   const endMarker = '// END GENERATED DOCTOR COMMANDS';\n138:   const start = render.indexOf(startMarker);\n139:   const end = render.indexOf(endMarker);\n140:   if (start < 0 || end < start) {\n141:     throw new Error(`Missing generated doctor markers in ${RENDER_PATH}`);\n142:   }\n143: \n144:   const strings = new Map<string, string>();\n145:   for (const line of render.slice(start + startMarker.length, end).split('\\n')) {\n146:     const match = /^\\s*'([^']+)': '([^']+)',$/.exec(line);\n147:     if (match) strings.set(match[1] as string, match[2] as string);\n148:   }\n149:   return strings;\n150: }\n151: \n152: function sortedPairs(entries: Iterable<readonly [string, string]>): [string, string][] {\n153:   return [...entries]\n154:     .map(([key, value]) => [key, value] as [string, string])\n155:     .sort(([left], [right]) => left.localeCompare(right));\n156: }\n157: \n158: describe('doctor command bridges', () => {\n159:   it('the renderer lookup holds the runnable string of every doctor bridge in the manifest', () => {\n160:     const rendered = renderedDoctorStrings();\n161:     const expected = sortedPairs(\n162:       [...manifestDoctorBridges()].map(([id, { runnable }]) => [id, runnable] as const),\n163:     );\n164: \n165:     expect(rendered.size).toBeGreaterThan(10);\n166:     expect(sortedPairs(rendered)).toEqual(expected);\n167:   });\n168: \n169:   it('every active TypeScript doctor bridge carries its manifest phrases and runnable string', () => {\n170:     const manifest = manifestDoctorBridges();\n171:     const failures: string[] = [];\n172: \n173:     for (const entry of GENERATED_COMMAND_BRIDGES) {\n174:       if (entry.routingEnabled === false || !entry.id.startsWith(DOCTOR_PREFIX)) continue;\n175:       const expected = manifest.get(entry.id);\n176:       if (!expected) {\n177:         failures.push(`${entry.id}: no bridge in the doctor route manifest`);\n178:         continue;\n179:       }\n180: \n181:       if (entry.name !== expected.runnable) {\n182:         failures.push(`${entry.id}: name ${entry.name} !== runnable ${expected.runnable}`);\n183:       }\n184: \n185:       const keywords = [...entry.keywords].sort();\n186:       const phrases = [\n187:         ...expected.phrases,\n188:         ...(expected.bareCommand ? [expected.bareCommand] : []),\n189:       ].sort();\n190:       if (JSON.stringify(keywords) !== JSON.stringify(phrases)) {\n191:         failures.push(\n192:           `${entry.id}: keywords ${JSON.stringify(keywords)} !== phrases ${JSON.stringify(phrases)}`,\n193:         );\n194:       }\n195: \n196:       if (JSON.stringify(entry.intentSignals) !== JSON.stringify([expected.runnable])) {\n197:         failures.push(\n198:           `${entry.id}: intentSignals ${JSON.stringify(entry.intentSignals)} !== ${JSON.stringify([expected.runnable])}`,\n199:         );\n200:       }\n201:     }\n202: \n203:     expect(failures).toEqual([]);\n204:   });\n205: \n206:   it('every active TypeScript doctor bridge carries its manifest lead phrases', () => {\n207:     const manifest = manifestDoctorBridges();\n208:     const failures: string[] = [];\n209: \n210:     for (const entry of GENERATED_COMMAND_BRIDGES) {\n211:       if (entry.routingEnabled === false || !entry.id.startsWith(DOCTOR_PREFIX)) continue;\n212:       const expected = manifest.get(entry.id);\n213:       if (!expected) {\n214:         failures.push(`${entry.id}: no bridge in the doctor route manifest`);\n215:         continue;\n216:       }\n217: \n218:       if (JSON.stringify(entry.leadPhrases) !== JSON.stringify(expected.leadPhrases)) {\n219:         failures.push(\n220:           `${entry.id}: leadPhrases ${JSON.stringify(entry.leadPhrases)} !== ${JSON.stringify(expected.leadPhrases)}`,\n221:         );\n222:       }\n223:     }\n224: \n225:     expect(failures).toEqual([]);\n226:     const envBridge = GENERATED_COMMAND_BRIDGES.find((entry) => entry.id === 'command-doctor-env');\n227:     expect(envBridge?.leadPhrases).toEqual(['check my environment variables']);\n228:   });\n229: \n230:   it('every active TypeScript doctor bridge is read-only exactly when its manifest route is', () => {\n231:     const manifest = manifestDoctorBridges();\n232:     const failures: string[] = [];\n233: \n234:     for (const entry of GENERATED_COMMAND_BRIDGES) {\n235:       if (entry.routingEnabled === false || !entry.id.startsWith(DOCTOR_PREFIX)) continue;\n236:       const expected = manifest.get(entry.id);\n237:       if (!expected) {\n238:         failures.push(`${entry.id}: no bridge in the doctor route manifest`);\n239:         continue;\n240:       }\n241:       if ((entry.readOnly === true) !== expected.readOnly) {\n242:         failures.push(`${entry.id}: readOnly ${String(entry.readOnly)} !== ${String(expected.readOnly)}`);\n243:       }\n244:     }\n245: \n246:     expect(failures).toEqual([]);\n247:     const byId = (id: string) => GENERATED_COMMAND_BRIDGES.find((entry) => entry.id === id);\n248:     expect(byId('command-doctor-ci-report')?.readOnly).toBe(true);\n249:     expect(byId('command-doctor-ci-scaffold')?.readOnly).toBeUndefined();\n250:     expect(byId('command-doctor-ci-toggle')?.readOnly).toBeUndefined();\n251:   });\n252: \n253:   it('every active Python doctor bridge matches only on its runnable slash string', () => {\n254:     const generated = JSON.parse(readFileSync(GENERATED_PATH, 'utf8')) as {\n255:       readonly entries: readonly GeneratedDoctorBridge[];\n256:     };\n257:     const manifest = manifestDoctorBridges();\n258:     const failures: string[] = [];\n259: \n260:     for (const entry of generated.entries) {\n261:       if (!entry.id.startsWith(DOCTOR_PREFIX) || entry.runtime.python.enabled !== true) continue;\n262:       const expected = manifest.get(entry.id);\n263:       if (!expected) {\n264:         failures.push(`${entry.id}: no bridge in the doctor route manifest`);\n265:         continue;\n266:       }\n267: \n268:       const markers = entry.runtime.python.slashMarkers ?? [];\n269:       const expectedMarkers = expected.bareCommand\n270:         ? [expected.runnable, expected.bareCommand]\n271:         : [expected.runnable];\n272:       if (JSON.stringify(markers) !== JSON.stringify(expectedMarkers)) {\n273:         failures.push(\n274:           `${entry.id}: slashMarkers ${JSON.stringify(markers)} !== ${JSON.stringify(expectedMarkers)}`,\n275:         );\n276:       }\n277:       for (const marker of markers) {\n278:         if (!marker.startsWith('/doctor:')) {\n279:           failures.push(`${entry.id}: slash marker ${marker} does not start with /doctor:`);\n280:         }\n281:       }\n282:     }\n283: \n284:     expect(failures).toEqual([]);\n285:   });\n286: });","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/tests/doctor-command-bridges.vitest.ts, lines 1-286\n1: // ───────────────────────────────────────────────────────────────────\n2: // MODULE: Doctor Command Bridges\n3: // ───────────────────────────────────────────────────────────────────\n4: \n5: import { readFileSync } from 'node:fs';\n6: import { join } from 'node:path';\n7: \n8: import { describe, expect, it } from 'vitest';\n9: import { parse as parseYaml } from 'yaml';\n10: \n11: import { GENERATED_COMMAND_BRIDGES } from '../lib/scorer/projection.js';\n12: import { findAdvisorWorkspaceRoot } from '../lib/utils/workspace-root.js';\n13: \n14: const REPO_ROOT = findAdvisorWorkspaceRoot(import.meta.dirname);\n15: const DOCTOR_ROUTES_PATH = join(REPO_ROOT, '.skilled', 'commands', 'doctor', '_routes.yaml');\n16: const RENDER_PATH = join(\n17:   REPO_ROOT,\n18:   '.skilled',\n19:   'skills',\n20:   'system-skill-advisor',\n21:   'runtime',\n22:   'lib',\n23:   'render.ts',\n24: );\n25: const GENERATED_PATH = join(\n26:   REPO_ROOT,\n27:   '.skilled',\n28:   'skills',\n29:   'system-skill-advisor',\n30:   'runtime',\n31:   'scripts',\n32:   'command-bridges',\n33:   'command-bridges.generated.json',\n34: );\n35: const DOCTOR_PREFIX = 'command-doctor-';\n36: const DOCTOR_MCP_COMMAND = '/doctor:mcp';\n37: \n38: interface DoctorBridgeExpectation {\n39:   readonly runnable: string;\n40:   readonly bareCommand?: string;\n41:   readonly phrases: readonly string[];\n42:   readonly leadPhrases?: readonly string[];\n43:   readonly readOnly: boolean;\n44: }\n45: \n46: interface DoctorManifest {\n47:   readonly routes: readonly {\n48:     readonly command: string;\n49:     readonly target: string;\n50:     readonly trigger_phrases: readonly string[];\n51:     readonly lead_phrases?: readonly string[];\n52:     readonly default_target?: boolean;\n53:     readonly mutating?: string;\n54:   }[];\n55:   readonly standalone?: readonly {\n56:     readonly command?: string;\n57:     readonly runnable?: string;\n58:     readonly trigger_phrases?: readonly string[];\n59:     readonly lead_phrases?: readonly string[];\n60:     readonly mutating?: string;\n61:   }[];\n62:   readonly mcp_subroutes?: readonly {\n63:     readonly sub_action: string;\n64:     readonly trigger_phrases: readonly string[];\n65:     readonly lead_phrases?: readonly string[];\n66:     readonly mutating?: string;\n67:   }[];\n68: }\n69: \n70: interface GeneratedDoctorBridge {\n71:   readonly id: string;\n72:   readonly runtime: {\n73:     readonly python: {\n74:       readonly enabled: boolean;\n75:       readonly slashMarkers?: readonly string[];\n76:     };\n77:   };\n78: }\n79: \n80: function doctorName(command: string): string {\n81:   const match = /^\\/doctor:([a-z0-9-]+)$/.exec(command);\n82:   if (!match) throw new Error(`Unrecognized doctor command: ${command}`);\n83:   return match[1] as string;\n84: }\n85: \n86: // Expectations are recomputed from the route manifest rather than read back from\n87: // the generated artifacts, so a generator defect cannot hide behind its own output.\n88: function manifestDoctorBridges(): Map<string, DoctorBridgeExpectation> {\n89:   const manifest = parseYaml(readFileSync(DOCTOR_ROUTES_PATH, 'utf8')) as DoctorManifest;\n90:   const routeCounts = new Map<string, number>();\n91:   for (const route of manifest.routes) {\n92:     const name = doctorName(route.command);\n93:     routeCounts.set(name, (routeCounts.get(name) ?? 0) + 1);\n94:   }\n95: \n96:   const bridges = new Map<string, DoctorBridgeExpectation>();\n97:   for (const route of manifest.routes) {\n98:     const name = doctorName(route.command);\n99:     const multiTarget = (routeCounts.get(name) ?? 0) > 1;\n100:     bridges.set(multiTarget ? `${DOCTOR_PREFIX}${name}-${route.target}` : `${DOCTOR_PREFIX}${name}`, {\n101:       runnable: multiTarget ? `${route.command} ${route.target}` : route.command,\n102:       bareCommand: route.default_target === true ? route.command : undefined,\n103:       phrases: route.trigger_phrases,\n104:       leadPhrases: route.lead_phrases?.length ? route.lead_phrases : undefined,\n105:       readOnly: route.mutating === 'read-only',\n106:     });\n107:   }\n108: \n109:   for (const item of manifest.standalone ?? []) {\n110:     if (typeof item.command !== 'string') continue;\n111:     const name = doctorName(item.command);\n112:     const runnable = typeof item.runnable === 'string' && item.runnable ? item.runnable : item.command;\n113:     bridges.set(`${DOCTOR_PREFIX}${name}`, {\n114:       runnable,\n115:       phrases: Array.isArray(item.trigger_phrases) ? item.trigger_phrases : [],\n116:       leadPhrases: item.lead_phrases?.length ? item.lead_phrases : undefined,\n117:       readOnly: item.mutating === 'read-only',\n118:     });\n119:   }\n120: \n121:   for (const item of manifest.mcp_subroutes ?? []) {\n122:     const id = `${DOCTOR_PREFIX}${doctorName(DOCTOR_MCP_COMMAND)}-${item.sub_action}`;\n123:     bridges.set(id, {\n124:       runnable: `${DOCTOR_MCP_COMMAND} ${item.sub_action}`,\n125:       phrases: item.trigger_phrases,\n126:       leadPhrases: item.lead_phrases?.length ? item.lead_phrases : undefined,\n127:       readOnly: item.mutating === 'read-only',\n128:     });\n129:   }\n130: \n131:   return bridges;\n132: }\n133: \n134: function renderedDoctorStrings(): Map<string, string> {\n135:   const render = readFileSync(RENDER_PATH, 'utf8');\n136:   const startMarker = '// BEGIN GENERATED DOCTOR COMMANDS';\n137:   const endMarker = '// END GENERATED DOCTOR COMMANDS';\n138:   const start = render.indexOf(startMarker);\n139:   const end = render.indexOf(endMarker);\n140:   if (start < 0 || end < start) {\n141:     throw new Error(`Missing generated doctor markers in ${RENDER_PATH}`);\n142:   }\n143: \n144:   const strings = new Map<string, string>();\n145:   for (const line of render.slice(start + startMarker.length, end).split('\\n')) {\n146:     const match = /^\\s*'([^']+)': '([^']+)',$/.exec(line);\n147:     if (match) strings.set(match[1] as string, match[2] as string);\n148:   }\n149:   return strings;\n150: }\n151: \n152: function sortedPairs(entries: Iterable<readonly [string, string]>): [string, string][] {\n153:   return [...entries]\n154:     .map(([key, value]) => [key, value] as [string, string])\n155:     .sort(([left], [right]) => left.localeCompare(right));\n156: }\n157: \n158: describe('doctor command bridges', () => {\n159:   it('the renderer lookup holds the runnable string of every doctor bridge in the manifest', () => {\n160:     const rendered = renderedDoctorStrings();\n161:     const expected = sortedPairs(\n162:       [...manifestDoctorBridges()].map(([id, { runnable }]) => [id, runnable] as const),\n163:     );\n164: \n165:     expect(rendered.size).toBeGreaterThan(10);\n166:     expect(sortedPairs(rendered)).toEqual(expected);\n167:   });\n168: \n169:   it('every active TypeScript doctor bridge carries its manifest phrases and runnable string', () => {\n170:     const manifest = manifestDoctorBridges();\n171:     const failures: string[] = [];\n172: \n173:     for (const entry of GENERATED_COMMAND_BRIDGES) {\n174:       if (entry.routingEnabled === false || !entry.id.startsWith(DOCTOR_PREFIX)) continue;\n175:       const expected = manifest.get(entry.id);\n176:       if (!expected) {\n177:         failures.push(`${entry.id}: no bridge in the doctor route manifest`);\n178:         continue;\n179:       }\n180: \n181:       if (entry.name !== expected.runnable) {\n182:         failures.push(`${entry.id}: name ${entry.name} !== runnable ${expected.runnable}`);\n183:       }\n184: \n185:       const keywords = [...entry.keywords].sort();\n186:       const phrases = [\n187:         ...expected.phrases,\n188:         ...(expected.bareCommand ? [expected.bareCommand] : []),\n189:       ].sort();\n190:       if (JSON.stringify(keywords) !== JSON.stringify(phrases)) {\n191:         failures.push(\n192:           `${entry.id}: keywords ${JSON.stringify(keywords)} !== phrases ${JSON.stringify(phrases)}`,\n193:         );\n194:       }\n195: \n196:       if (JSON.stringify(entry.intentSignals) !== JSON.stringify([expected.runnable])) {\n197:         failures.push(\n198:           `${entry.id}: intentSignals ${JSON.stringify(entry.intentSignals)} !== ${JSON.stringify([expected.runnable])}`,\n199:         );\n200:       }\n201:     }\n202: \n203:     expect(failures).toEqual([]);\n204:   });\n205: \n206:   it('every active TypeScript doctor bridge carries its manifest lead phrases', () => {\n207:     const manifest = manifestDoctorBridges();\n208:     const failures: string[] = [];\n209: \n210:     for (const entry of GENERATED_COMMAND_BRIDGES) {\n211:       if (entry.routingEnabled === false || !entry.id.startsWith(DOCTOR_PREFIX)) continue;\n212:       const expected = manifest.get(entry.id);\n213:       if (!expected) {\n214:         failures.push(`${entry.id}: no bridge in the doctor route manifest`);\n215:         continue;\n216:       }\n217: \n218:       if (JSON.stringify(entry.leadPhrases) !== JSON.stringify(expected.leadPhrases)) {\n219:         failures.push(\n220:           `${entry.id}: leadPhrases ${JSON.stringify(entry.leadPhrases)} !== ${JSON.stringify(expected.leadPhrases)}`,\n221:         );\n222:       }\n223:     }\n224: \n225:     expect(failures).toEqual([]);\n226:     const envBridge = GENERATED_COMMAND_BRIDGES.find((entry) => entry.id === 'command-doctor-env');\n227:     expect(envBridge?.leadPhrases).toEqual(['check my environment variables']);\n228:   });\n229: \n230:   it('every active TypeScript doctor bridge is read-only exactly when its manifest route is', () => {\n231:     const manifest = manifestDoctorBridges();\n232:     const failures: string[] = [];\n233: \n234:     for (const entry of GENERATED_COMMAND_BRIDGES) {\n235:       if (entry.routingEnabled === false || !entry.id.startsWith(DOCTOR_PREFIX)) continue;\n236:       const expected = manifest.get(entry.id);\n237:       if (!expected) {\n238:         failures.push(`${entry.id}: no bridge in the doctor route manifest`);\n239:         continue;\n240:       }\n241:       if ((entry.readOnly === true) !== expected.readOnly) {\n242:         failures.push(`${entry.id}: readOnly ${String(entry.readOnly)} !== ${String(expected.readOnly)}`);\n243:       }\n244:     }\n245: \n246:     expect(failures).toEqual([]);\n247:     const byId = (id: string) => GENERATED_COMMAND_BRIDGES.find((entry) => entry.id === id);\n248:     expect(byId('command-doctor-ci-report')?.readOnly).toBe(true);\n249:     expect(byId('command-doctor-ci-scaffold')?.readOnly).toBeUndefined();\n250:     expect(byId('command-doctor-ci-toggle')?.readOnly).toBeUndefined();\n251:   });\n252: \n253:   it('every active Python doctor bridge matches only on its runnable slash string', () => {\n254:     const generated = JSON.parse(readFileSync(GENERATED_PATH, 'utf8')) as {\n255:       readonly entries: readonly GeneratedDoctorBridge[];\n256:     };\n257:     const manifest = manifestDoctorBridges();\n258:     const failures: string[] = [];\n259: \n260:     for (const entry of generated.entries) {\n261:       if (!entry.id.startsWith(DOCTOR_PREFIX) || entry.runtime.python.enabled !== true) continue;\n262:       const expected = manifest.get(entry.id);\n263:       if (!expected) {\n264:         failures.push(`${entry.id}: no bridge in the doctor route manifest`);\n265:         continue;\n266:       }\n267: \n268:       const markers = entry.runtime.python.slashMarkers ?? [];\n269:       const expectedMarkers = expected.bareCommand\n270:         ? [expected.runnable, expected.bareCommand]\n271:         : [expected.runnable];\n272:       if (JSON.stringify(markers) !== JSON.stringify(expectedMarkers)) {\n273:         failures.push(\n274:           `${entry.id}: slashMarkers ${JSON.stringify(markers)} !== ${JSON.stringify(expectedMarkers)}`,\n275:         );\n276:       }\n277:       for (const marker of markers) {\n278:         if (!marker.startsWith('/doctor:')) {\n279:           failures.push(`${entry.id}: slash marker ${marker} does not start with /doctor:`);\n280:         }\n281:       }\n282:     }\n283: \n284:     expect(failures).toEqual([]);\n285:   });\n286: });"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/tests/doctor-command-bridges.vitest.ts\"}"},"time":{"start":1794527699283,"end":1794527699683}}}}
