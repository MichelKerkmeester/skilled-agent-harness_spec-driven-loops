{"type":"tool_use","timestamp":1794527704909,"sessionID":"ses_e2dd11607ffeUOdb1Ko5q11ZLP","part":{"partID":"prt_1d22fb57f001GZ0qr4DYlwWSOL","sessionID":"ses_e2dd11607ffeUOdb1Ko5q11ZLP","messageID":"msg_1d22fa6f9001ygKKZKmnxIxOHR","type":"tool","id":"call_b48948a5c8ff454ba0b4044d","tool":"read","state":{"status":"completed","input":{"path":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/lib/render.ts"},"output":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/lib/render.ts, lines 1-598\n1: // ───────────────────────────────────────────────────────────────\n2: // MODULE: Skill Advisor Brief Renderer\n3: // ───────────────────────────────────────────────────────────────\n4: \n5: import { canonicalFold } from './shared/unicode-normalization.js';\n6: import { resolvedConfidenceThreshold, resolvedUncertaintyThreshold } from './compat/contract.js';\n7: import {\n8:   buildAdvisorRenderPlan,\n9:   evaluateDeliveryState,\n10:   isObservedDeliveryReceipt,\n11:   observeRenderedAdvisorPolicy,\n12:   POLICY_COMMENT_HYGIENE_ID,\n13:   recordObservedPolicyDelivery,\n14:   ROUTE_ADVISOR_ID,\n15:   SHADOW_DELIVERY_STATE_MACHINE,\n16:   type DeliveryStateMachine,\n17:   type DeliveryStateReceipt,\n18:   type DeliveryStateName,\n19:   type DeliveryStateSignals,\n20: } from './policy-plan.js';\n21: import { commandRowFor } from './command-attach.js';\n22: import { isAmbiguousTopTwo } from './scorer/ambiguity.js';\n23: import type { AdvisorRecommendation } from './subprocess.js';\n24: import type { AdvisorScoredRecommendation } from './scorer/types.js';\n25: import type { AdvisorHookResult } from './skill-advisor-brief.js';\n26: \n27: // ───────────────────────────────────────────────────────────────\n28: // 1. TYPES\n29: // ───────────────────────────────────────────────────────────────\n30: \n31: export interface AdvisorBriefRenderOptions {\n32:   readonly tokenCap?: number;\n33:   readonly thresholdConfig?: {\n34:     readonly confidenceThreshold?: number;\n35:     readonly uncertaintyThreshold?: number;\n36:     readonly confidenceOnly?: boolean;\n37:   };\n38:   readonly deliveryState?: ShadowDeliveryRenderOptions;\n39:   /**\n40:    * True when prompts use set up, set-up or setup wording, install or reinstall wording\n41:    * including installation and installer, configure or configuration wording or `check`\n42:    * followed within three words by environment, env, config, hooks, tools, tooling,\n43:    * toolchain or skilled. The renderer never reads prompt text.\n44:    */\n45:   readonly setupWording?: boolean;\n46: }\n47: \n48: export interface ShadowDeliveryRenderOptions extends DeliveryStateSignals {\n49:   readonly runtime?: string;\n50:   readonly candidate?: string | null;\n51:   readonly stateMachine?: DeliveryStateMachine;\n52:   readonly deliveryConfirmed?: boolean;\n53:   readonly receipt?: DeliveryStateReceipt;\n54:   readonly transformMessageIdentity?: string | null;\n55:   readonly onShadowLog?: (record: ShadowRouteOnlyLogRecord) => void;\n56: }\n57: \n58: export interface ShadowRouteOnlyLogRecord {\n59:   readonly shadowId: string;\n60:   readonly sessionKnown: boolean;\n61:   readonly epoch: number;\n62:   readonly policySetHash: string;\n63:   readonly routeState: DeliveryStateName | null;\n64:   readonly emittedByteCount: number;\n65:   readonly routeOnlyByteCount: number;\n66:   readonly savedBytes: number;\n67: }\n68: \n69: export interface AdvisorBriefRenderableResult {\n70:   readonly status: 'ok' | 'stale' | 'skipped' | 'degraded' | 'fail_open';\n71:   readonly freshness: 'live' | 'stale' | 'absent' | 'unavailable';\n72:   readonly recommendations: readonly AdvisorRecommendation[];\n73:   readonly ambiguous?: boolean;\n74:   readonly metrics?: {\n75:     readonly tokenCap?: number;\n76:   } | null;\n77:   readonly sharedPayload?: {\n78:     readonly metadata?: {\n79:       readonly skillLabel?: string | null;\n80:     } | null;\n81:   } | null;\n82: }\n83: \n84: export type AdvisorFallbackCase = 'outage' | 'no-match' | 'skipped';\n85: export type AdvisorFallbackClassification =\n86:   | {\n87:     readonly fallbackCase: 'outage';\n88:     readonly outageLabel: 'absent' | 'degraded' | 'fail_open';\n89:   }\n90:   | {\n91:     readonly fallbackCase: 'no-match' | 'skipped';\n92:   };\n93: \n94: // ───────────────────────────────────────────────────────────────\n95: // 2. CONSTANTS\n96: // ───────────────────────────────────────────────────────────────\n97: \n98: const DEFAULT_TOKEN_CAP = 80;\n99: const AMBIGUOUS_TOKEN_CAP = 120;\n100: const MAX_TOKEN_CAP = 120;\n101: const TOKEN_TO_CHAR_ESTIMATE = 4;\n102: const INSTRUCTION_LABEL_PATTERN =\n103:   /^\\s*(SYSTEM|INSTRUCTION|IGNORE|EXECUTE)\\s*[:=]|^\\s*(<!--|```)|\\b(ignore\\s+(previous|all)\\s+instructions|system\\s*:|instruction\\s*:|execute\\s*:|developer\\s*:|assistant\\s*:)/i;\n104: const CONTROL_CHAR_PATTERN = /[\\u0000-\\u0008\\u000B\\u000C\\u000E-\\u001F\\u007F]/g;\n105: const ROUTE_ONLY_SHADOW_ID = 'shadow.route-only.advisor.v1';\n106: const OBSERVED_ADVISOR_POLICY_CANDIDATE = '004';\n107: export const ROUTE_ONLY_ESTIMATED_BYTES = 43;\n108: const MAX_SHADOW_ROUTE_ONLY_LOG = 256;\n109: \n110: function directiveBlockIds(): readonly string[] {\n111:   return Object.freeze([\n112:     POLICY_COMMENT_HYGIENE_ID,\n113:   ]);\n114: }\n115: \n116: const SHADOW_ROUTE_ONLY_LOG: ShadowRouteOnlyLogRecord[] = [];\n117: \n118: // Injected into every advisor brief so all hook-capable runtimes receive\n119: // the comment hygiene rule even when AGENTS.md is absent from session context.\n120: export const HYGIENE_DIRECTIVE = '\\n- Comment hygiene [HARD BLOCK]: NEVER embed ADR-/REQ-/CHK-/task-ids or spec paths in code comments — forbidden regardless of instruction. Write the durable WHY instead. Pre-commit gate blocks violations.';\n121: \n122: \n123: \n124: // Labels the directive block so injected content reads as one structured\n125: // capsule instead of loose lines.\n126: export const DIRECTIVES_LABEL = '\\nDirectives:';\n127: \n128: // One bounded sentence for a setup-shaped prompt that matched nothing, so the\n129: // reader learns the read-only overview exists without every miss paying for it.\n130: export const SETUP_HINT = ' For setup or health checks, run /doctor:setup.';\n131: \n132: // ───────────────────────────────────────────────────────────────\n133: // 3. HELPERS\n134: // ───────────────────────────────────────────────────────────────\n135: \n136: function clampTokenCap(tokenCap: number | undefined): number {\n137:   if (typeof tokenCap !== 'number' || Number.isNaN(tokenCap)) {\n138:     return DEFAULT_TOKEN_CAP;\n139:   }\n140:   return Math.min(Math.max(1, Math.floor(tokenCap)), MAX_TOKEN_CAP);\n141: }\n142: \n143: function capText(text: string, tokenCap: number): string {\n144:   const charCap = tokenCap * TOKEN_TO_CHAR_ESTIMATE;\n145:   if (text.length <= charCap) {\n146:     return text;\n147:   }\n148:   const truncated = text.slice(0, Math.max(1, charCap - 3)).trimEnd();\n149:   return `${truncated}...`;\n150: }\n151: \n152: function sanitizeSkillLabel(skillLabel: string | null | undefined): string | null {\n153:   if (typeof skillLabel !== 'string') {\n154:     return null;\n155:   }\n156:   const folded = canonicalFold(skillLabel);\n157:   if (/[\\n\\r]/.test(folded)) {\n158:     return null;\n159:   }\n160:   const singleLine = folded\n161:     .replace(CONTROL_CHAR_PATTERN, '')\n162:     .replace(/\\s+/g, ' ')\n163:     .trim();\n164:   if (!singleLine || INSTRUCTION_LABEL_PATTERN.test(singleLine)) {\n165:     return null;\n166:   }\n167:   return singleLine;\n168: }\n169: \n170: const DOCTOR_BRIDGE_PREFIX = 'command-doctor-';\n171: \n172: function isDoctorBridgeId(skillId: string): boolean {\n173:   return skillId.startsWith(DOCTOR_BRIDGE_PREFIX);\n174: }\n175: \n176: /** Return the sanitized runnable command for a doctor bridge id, or null when unmapped. */\n177: export function doctorCommandString(skillId: string): string | null {\n178:   if (!isDoctorBridgeId(skillId)) {\n179:     return null;\n180:   }\n181:   const command = commandRowFor(skillId)?.command;\n182:   return command === undefined ? null : sanitizeSkillLabel(command);\n183: }\n184: \n185: // A recommendation that names a command renders as the skill that owns it, the\n186: // runnable command and the policy that governs the run. The recommendation's own\n187: // fields stay authoritative and the generated row fills only what they omit, so a\n188: // caller that already resolved the command is never second-guessed.\n189: function commandLabel(recommendation: RenderableRecommendation): string | null {\n190:   const row = commandRowFor(recommendation.skill);\n191:   const command = recommendation.command ?? row?.command;\n192:   const owner = recommendation.ownerSkillId ?? row?.ownerSkillId ?? recommendation.skill;\n193:   const policy = recommendation.policy ?? row?.policy;\n194:   const commandPart = command === undefined ? null : sanitizeSkillLabel(command);\n195:   const ownerPart = sanitizeSkillLabel(owner);\n196:   if (!commandPart || !ownerPart) {\n197:     return null;\n198:   }\n199:   const policyPart = policy === undefined ? null : sanitizeSkillLabel(policy);\n200:   return policyPart === null\n201:     ? `${ownerPart} → ${commandPart}`\n202:     : `${ownerPart} → ${commandPart} (${policyPart})`;\n203: }\n204: \n205: // A doctor bridge renders as its runnable command and never as its raw id; an\n206: // unmapped doctor id renders nothing.\n207: function recommendationLabel(recommendation: RenderableRecommendation): string | null {\n208:   return commandLabel(recommendation)\n209:     ?? (isDoctorBridgeId(recommendation.skill)\n210:       ? doctorCommandString(recommendation.skill)\n211:       : sanitizeSkillLabel(recommendation.skill));\n212: }\n213: \n214: function formatScore(value: number): string {\n215:   return Number.isFinite(value) ? value.toFixed(2) : '0.00';\n216: }\n217: \n218: type RenderableRecommendation = AdvisorRecommendation & {\n219:   readonly score?: number;\n220:   readonly ambiguousWith?: readonly string[];\n221:   readonly heldBelow?: string;\n222: };\n223: \n224: function toScoredRecommendation(recommendation: RenderableRecommendation): AdvisorScoredRecommendation {\n225:   return {\n226:     skill: recommendation.skill,\n227:     kind: recommendation.kind === 'command' ? 'command' : 'skill',\n228:     confidence: recommendation.confidence,\n229:     uncertainty: recommendation.uncertainty,\n230:     passes_threshold: recommendation.passes_threshold ?? true,\n231:     reason: '',\n232:     score: typeof recommendation.score === 'number' && Number.isFinite(recommendation.score)\n233:       ? recommendation.score\n234:       : recommendation.confidence,\n235:     laneContributions: [],\n236:     dominantLane: null,\n237:     lifecycleStatus: 'active',\n238:     ...(Array.isArray(recommendation.ambiguousWith) ? { ambiguousWith: recommendation.ambiguousWith } : {}),\n239:     ...(typeof recommendation.heldBelow === 'string' ? { heldBelow: recommendation.heldBelow } : {}),\n240:   };\n241: }\n242: \n243: /**\n244:  * Detect whether the renderable recommendation set carries ambiguity evidence.\n245:  *\n246:  * `precomputedAmbiguous` carries the scorer's own verdict. It wins when defined: the\n247:  * scorer knows which skills a typed command held below the top and which only cleared\n248:  * a confidence floor, and serialized recommendations lose that context. Only when the\n249:  * caller has no verdict is ambiguity re-derived from the rendered fields.\n250:  */\n251: export function hasAdvisorAmbiguitySignal(\n252:   recommendations: readonly AdvisorRecommendation[],\n253:   precomputedAmbiguous?: boolean,\n254: ): boolean {\n255:   if (typeof precomputedAmbiguous === 'boolean') {\n256:     return precomputedAmbiguous;\n257:   }\n258:   return isAmbiguousTopTwo((recommendations as readonly RenderableRecommendation[]).map(toScoredRecommendation));\n259: }\n260: \n261: function metadataSkillLabel(result: AdvisorBriefRenderableResult): string | null {\n262:   const metadata = result.sharedPayload?.metadata;\n263:   return typeof metadata?.skillLabel === 'string' ? metadata.skillLabel : null;\n264: }\n265: \n266: /** Return only the advisor route block that the shadow path would retain. */\n267: export function renderRouteOnlyAdvisorBrief(rendered: string | null): string | null {\n268:   const routeBlock = buildAdvisorRenderPlan(rendered).blocks.find((block) => (\n269:     block.id === ROUTE_ADVISOR_ID\n270:   ));\n271:   return routeBlock?.content ?? null;\n272: }\n273: \n274: /** Read the append-only in-process shadow log without exposing route content. */\n275: export function getShadowRouteOnlyLog(): readonly ShadowRouteOnlyLogRecord[] {\n276:   return Object.freeze(SHADOW_ROUTE_ONLY_LOG.map((record) => ({ ...record })));\n277: }\n278: \n279: /** Clear shadow log entries between isolated evaluations. */\n280: export function clearShadowRouteOnlyLog(): void {\n281:   SHADOW_ROUTE_ONLY_LOG.length = 0;\n282: }\n283: \n284: function stateSignalsForBlock(options: ShadowDeliveryRenderOptions): ShadowDeliveryRenderOptions {\n285:   return {\n286:     ...options,\n287:     lifecycleEvent: undefined,\n288:     scopeChanged: false,\n289:     policySetChanged: false,\n290:     goalChanged: false,\n291:   };\n292: }\n293: \n294: function pushShadowRouteOnlyLog(record: ShadowRouteOnlyLogRecord): void {\n295:   if (SHADOW_ROUTE_ONLY_LOG.length >= MAX_SHADOW_ROUTE_ONLY_LOG) {\n296:     SHADOW_ROUTE_ONLY_LOG.shift();\n297:   }\n298:   SHADOW_ROUTE_ONLY_LOG.push(record);\n299: }\n300: \n301: function directiveBlocksSuppressed(\n302:   plan: ReturnType<typeof buildAdvisorRenderPlan>,\n303:   decisions: readonly ReturnType<typeof evaluateDeliveryState>[],\n304: ): boolean {\n305:   for (const expectedId of directiveBlockIds()) {\n306:     const blockIndex = plan.blocks.findIndex((block) => block.id === expectedId);\n307:     if (blockIndex === -1) {\n308:       return false;\n309:     }\n310:     const decision = decisions[blockIndex];\n311:     if (!decision || decision.state !== 'SUPPRESSED_SAME') {\n312:       return false;\n313:     }\n314:   }\n315:   return true;\n316: }\n317: \n318: function recordObservedBlockDeliveries(\n319:   plan: ReturnType<typeof buildAdvisorRenderPlan>,\n320:   shadowOptions: ShadowDeliveryRenderOptions,\n321:   machine: DeliveryStateMachine,\n322:   epoch: number,\n323: ): void {\n324:   const blockOptions = stateSignalsForBlock(shadowOptions);\n325:   for (const block of plan.blocks) {\n326:     const receipt = shadowOptions.receipt;\n327:     if (!isObservedDeliveryReceipt(receipt, block.contentHash, epoch)) {\n328:       continue;\n329:     }\n330:     machine.recordDelivery({\n331:       ...blockOptions,\n332:       blockId: block.id,\n333:       contentHash: block.contentHash,\n334:       receipt,\n335:     });\n336:   }\n337: }\n338: \n339: function observeShadowRouteOnly(\n340:   rendered: string | null,\n341:   options: ShadowDeliveryRenderOptions | undefined,\n342: ): void {\n343:   try {\n344:     const plan = buildAdvisorRenderPlan(rendered);\n345:     const shadowOptions = options ?? {};\n346:     const machine = shadowOptions.stateMachine ?? SHADOW_DELIVERY_STATE_MACHINE;\n347:     const epochSnapshot = machine.advanceForSignals(shadowOptions);\n348:     const blockOptions = stateSignalsForBlock(shadowOptions);\n349:     const decisions = plan.blocks.map((block) => evaluateDeliveryState({\n350:       ...blockOptions,\n351:       blockId: block.id,\n352:       contentHash: block.contentHash,\n353:     }, machine));\n354: \n355:     recordObservedBlockDeliveries(plan, shadowOptions, machine, epochSnapshot.epoch);\n356: \n357:     const routeIndex = plan.blocks.findIndex((block) => block.id === ROUTE_ADVISOR_ID);\n358:     const routeDecision = routeIndex === -1 ? null : decisions[routeIndex] ?? null;\n359:     const routeOnlyEligible = Boolean(\n360:       routeDecision?.routeOnlyEligible && directiveBlocksSuppressed(plan, decisions),\n361:     );\n362:     const routeOnly = routeOnlyEligible\n363:       ? renderRouteOnlyAdvisorBrief(rendered)\n364:       : null;\n365:     const emittedByteCount = rendered === null ? 0 : Buffer.byteLength(rendered, 'utf8');\n366:     const routeOnlyByteCount = routeOnly === null ? 0 : Buffer.byteLength(routeOnly, 'utf8');\n367:     const savedBytes = routeOnly === null\n368:       ? 0\n369:       : Math.max(0, emittedByteCount - routeOnlyByteCount);\n370:     const record: ShadowRouteOnlyLogRecord = Object.freeze({\n371:       shadowId: ROUTE_ONLY_SHADOW_ID,\n372:       sessionKnown: routeDecision?.sessionKnown ?? epochSnapshot.sessionKnown,\n373:       epoch: routeDecision?.epoch ?? epochSnapshot.epoch,\n374:       policySetHash: plan.policySetHash,\n375:       routeState: routeDecision?.state ?? null,\n376:       emittedByteCount,\n377:       routeOnlyByteCount,\n378:       savedBytes,\n379:     });\n380:     pushShadowRouteOnlyLog(record);\n381:     try {\n382:       options?.onShadowLog?.(record);\n383:     } catch {\n384:       // Observer callbacks must never affect the rendered advisor bytes.\n385:     }\n386:   } catch {\n387:     // Shadow measurement is fail-open so a throwing observer cannot block delivery.\n388:   }\n389: }\n390: \n391: function observeAdvisorPolicy(\n392:   rendered: string | null,\n393:   options: AdvisorBriefRenderOptions = {},\n394: ): void {\n395:   try {\n396:     observeRenderedAdvisorPolicy(rendered);\n397:   } catch {\n398:     // Shadow measurement is fail-open so a throwing observer cannot block delivery.\n399:   }\n400:   observeShadowRouteOnly(rendered, options.deliveryState);\n401: }\n402: \n403: /** Run the shadow planner for a runtime callback without changing its output. */\n404: export function observeShadowDelivery(\n405:   rendered: string | null,\n406:   deliveryState: ShadowDeliveryRenderOptions = {},\n407: ): void {\n408:   observeAdvisorPolicy(rendered, { deliveryState });\n409: }\n410: \n411: /**\n412:  * Record host-observed policy blocks after the runtime places them into the\n413:  * emitted response. Fail-open: recording errors never change emitted bytes.\n414:  */\n415: export function observeEmittedAdvisorPolicy(\n416:   rendered: string | null,\n417:   deliveryState: ShadowDeliveryRenderOptions = {},\n418: ): void {\n419:   try {\n420:     if (typeof rendered !== 'string' || rendered.length === 0) {\n421:       return;\n422:     }\n423:     const runtime = typeof deliveryState.runtime === 'string' && deliveryState.runtime.length > 0\n424:       ? deliveryState.runtime\n425:       : 'unknown';\n426:     const machine = deliveryState.stateMachine ?? SHADOW_DELIVERY_STATE_MACHINE;\n427:     const epoch = machine.currentEpoch(deliveryState);\n428:     const plan = buildAdvisorRenderPlan(rendered);\n429:     for (const block of plan.blocks) {\n430:       recordObservedPolicyDelivery({\n431:         runtime,\n432:         candidate: deliveryState.candidate ?? OBSERVED_ADVISOR_POLICY_CANDIDATE,\n433:         blockId: block.id,\n434:         content: block.content,\n435:         contentHash: block.contentHash,\n436:         lifecycleEpoch: epoch,\n437:         sessionId: deliveryState.sessionId,\n438:         sessionIdentity: deliveryState.sessionIdentity,\n439:         sessionIdentityConfirmed: deliveryState.sessionIdentityConfirmed,\n440:         sessionIdentityAmbiguous: deliveryState.sessionIdentityAmbiguous,\n441:         transformMessageIdentity: deliveryState.transformMessageIdentity ?? null,\n442:       });\n443:     }\n444:   } catch {\n445:     // Host observation is fail-open so a throwing sink cannot affect delivery.\n446:   }\n447: }\n448: \n449: // ───────────────────────────────────────────────────────────────\n450: // 4. CORE LOGIC\n451: // ───────────────────────────────────────────────────────────────\n452: \n453: /**\n454:  * Render the model-visible advisor brief from typed advisor output only.\n455:  *\n456:  * The renderer is the prompt-boundary guard: it ignores free-form reasons,\n457:  * descriptions, stdout/stderr, and prompt text, and emits nothing when the\n458:  * repository-authored skill label looks instruction-shaped after folding.\n459:  */\n460: export function renderAdvisorBrief(\n461:   result: AdvisorBriefRenderableResult,\n462:   options: AdvisorBriefRenderOptions = {},\n463: ): string | null {\n464:   if (result.status !== 'ok') {\n465:     observeAdvisorPolicy(null, options);\n466:     return null;\n467:   }\n468:   if (result.freshness !== 'live' && result.freshness !== 'stale') {\n469:     observeAdvisorPolicy(null, options);\n470:     return null;\n471:   }\n472: \n473:   const tokenCap = clampTokenCap(result.metrics?.tokenCap ?? options.tokenCap);\n474:   const thresholdConfig = options.thresholdConfig;\n475:   const recommendations = result.recommendations.filter((recommendation) => (\n476:     recommendation.passes_threshold === true\n477:     || (\n478:       recommendation.confidence >= (thresholdConfig?.confidenceThreshold ?? resolvedConfidenceThreshold())\n479:       && (\n480:         thresholdConfig?.confidenceOnly === true\n481:         || recommendation.uncertainty <= (thresholdConfig?.uncertaintyThreshold ?? resolvedUncertaintyThreshold())\n482:       )\n483:     )\n484:   ));\n485:   const [top, second] = recommendations;\n486:   if (!top) {\n487:     observeAdvisorPolicy(null, options);\n488:     return null;\n489:   }\n490: \n491:   const topLabel = commandLabel(top)\n492:     ?? (isDoctorBridgeId(top.skill)\n493:       ? doctorCommandString(top.skill)\n494:       : sanitizeSkillLabel(metadataSkillLabel(result) ?? top.skill));\n495:   if (!topLabel) {\n496:     observeAdvisorPolicy(null, options);\n497:     return null;\n498:   }\n499: \n500:   const companion = isDoctorBridgeId(top.skill)\n501:     ? undefined\n502:     : recommendations.slice(1).find((recommendation) => doctorCommandString(recommendation.skill) !== null);\n503:   const companionLabel = companion ? doctorCommandString(companion.skill) : null;\n504:   const companionLine = (shownSecond: string | undefined): string => (\n505:     companionLabel && companion && companion.skill !== shownSecond ? `\\nAlso: ${companionLabel}` : ''\n506:   );\n507:   const capWithCompanion = (head: string, companionText: string, cap: number): string => {\n508:     const companionFits = head.length + companionText.length <= cap * TOKEN_TO_CHAR_ESTIMATE;\n509:     return `${capText(head, cap)}${companionFits ? companionText : ''}`;\n510:   };\n511: \n512:   const precomputedAmbiguous = typeof result.ambiguous === 'boolean' ? result.ambiguous : undefined;\n513:   if (tokenCap > DEFAULT_TOKEN_CAP && second && hasAdvisorAmbiguitySignal(recommendations, precomputedAmbiguous)) {\n514:     // The scorer names its own tie partners, which can sit below the second passing\n515:     // entry, so prefer a named partner and fall back to the second entry.\n516:     const namedPartners = (top as RenderableRecommendation).ambiguousWith;\n517:     const ambiguousWith: readonly string[] = Array.isArray(namedPartners) ? namedPartners : [];\n518:     const vs = (ambiguousWith.length > 0\n519:       ? recommendations.find((recommendation) => ambiguousWith.includes(recommendation.skill))\n520:       : undefined) ?? second;\n521:     const vsLabel = recommendationLabel(vs);\n522:     if (!vsLabel && !isDoctorBridgeId(vs.skill)) {\n523:       observeAdvisorPolicy(null, options);\n524:       return null;\n525:     }\n526:     if (vsLabel) {\n527:       const head = `Advisor: ${result.freshness}; ambiguous: ${topLabel} `\n528:         + `${formatScore(top.confidence)}/${formatScore(top.uncertainty)} vs ${vsLabel} `\n529:         + `${formatScore(vs.confidence)}/${formatScore(vs.uncertainty)} pass.`;\n530:       const rendered = capWithCompanion(\n531:         head,\n532:         companionLine(vs.skill),\n533:         Math.min(tokenCap, AMBIGUOUS_TOKEN_CAP),\n534:       ) + DIRECTIVES_LABEL + HYGIENE_DIRECTIVE;\n535:       observeAdvisorPolicy(rendered, options);\n536:       return rendered;\n537:     }\n538:   }\n539: \n540:   const head = `Advisor: ${result.freshness}; use ${topLabel} `\n541:     + `${formatScore(top.confidence)}/${formatScore(top.uncertainty)} pass.`;\n542:   const rendered = capWithCompanion(\n543:     head,\n544:     companionLine(undefined),\n545:     Math.min(tokenCap, DEFAULT_TOKEN_CAP),\n546:   ) + DIRECTIVES_LABEL + HYGIENE_DIRECTIVE;\n547:   observeAdvisorPolicy(rendered, options);\n548:   return rendered;\n549: }\n550: \n551: /** Classify a result with no brief; no result at all means the advisor did not answer. */\n552: export function advisorFallbackCase(\n553:   result?: Pick<AdvisorHookResult, 'status' | 'freshness'>,\n554: ): AdvisorFallbackClassification {\n555:   if (!result || result.status === 'fail_open' || result.freshness === 'absent'\n556:     || (result.freshness === 'unavailable' && result.status !== 'skipped')) {\n557:     return {\n558:       fallbackCase: 'outage',\n559:       outageLabel: result?.freshness === 'absent'\n560:         ? 'absent'\n561:         : result?.status === 'degraded'\n562:           ? 'degraded'\n563:           : 'fail_open',\n564:     };\n565:   }\n566:   if (result.status === 'skipped' && result.freshness === 'unavailable') {\n567:     return { fallbackCase: 'skipped' };\n568:   }\n569:   return { fallbackCase: 'no-match' };\n570: }\n571: \n572: /** Render the fallback status and directive block when no advisor brief is available. */\n573: export function renderAdvisorFallbackDirective(\n574:   options: AdvisorBriefRenderOptions = {},\n575:   result?: Pick<AdvisorHookResult, 'status' | 'freshness'>,\n576: ): string {\n577:   const classification = advisorFallbackCase(result);\n578:   const head = classification.fallbackCase === 'outage'\n579:     ? `Advisor: outage (${classification.outageLabel});${options.setupWording === true ? ' for setup or health checks, run /doctor:setup;' : ''} route by hand: node .skilled/bin/skill-advisor.cjs advisor_recommend --json '{\"prompt\":\"<request>\"}' --format json`\n580:     : classification.fallbackCase === 'skipped'\n581:       ? 'Advisor: prompt skipped.'\n582:       : options.setupWording === true\n583:         ? `Advisor: no skill matched.${SETUP_HINT}`\n584:         : 'Advisor: no skill matched.';\n585:   const rendered = head + DIRECTIVES_LABEL + HYGIENE_DIRECTIVE;\n586:   observeAdvisorPolicy(rendered, options);\n587:   return rendered;\n588: }\n589: \n590: /** Render the outage fallback used when advisor execution times out or is unavailable. */\n591: export function renderAdvisorTimeoutFallback(\n592:   options: AdvisorBriefRenderOptions = {},\n593:   status: Extract<AdvisorHookResult['status'], 'fail_open' | 'degraded'> = 'fail_open',\n594: ): string {\n595:   return renderAdvisorFallbackDirective(options, { status, freshness: 'unavailable' });\n596: }\n597: \n598: export { sanitizeSkillLabel };","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/lib/render.ts, lines 1-598\n1: // ───────────────────────────────────────────────────────────────\n2: // MODULE: Skill Advisor Brief Renderer\n3: // ───────────────────────────────────────────────────────────────\n4: \n5: import { canonicalFold } from './shared/unicode-normalization.js';\n6: import { resolvedConfidenceThreshold, resolvedUncertaintyThreshold } from './compat/contract.js';\n7: import {\n8:   buildAdvisorRenderPlan,\n9:   evaluateDeliveryState,\n10:   isObservedDeliveryReceipt,\n11:   observeRenderedAdvisorPolicy,\n12:   POLICY_COMMENT_HYGIENE_ID,\n13:   recordObservedPolicyDelivery,\n14:   ROUTE_ADVISOR_ID,\n15:   SHADOW_DELIVERY_STATE_MACHINE,\n16:   type DeliveryStateMachine,\n17:   type DeliveryStateReceipt,\n18:   type DeliveryStateName,\n19:   type DeliveryStateSignals,\n20: } from './policy-plan.js';\n21: import { commandRowFor } from './command-attach.js';\n22: import { isAmbiguousTopTwo } from './scorer/ambiguity.js';\n23: import type { AdvisorRecommendation } from './subprocess.js';\n24: import type { AdvisorScoredRecommendation } from './scorer/types.js';\n25: import type { AdvisorHookResult } from './skill-advisor-brief.js';\n26: \n27: // ───────────────────────────────────────────────────────────────\n28: // 1. TYPES\n29: // ───────────────────────────────────────────────────────────────\n30: \n31: export interface AdvisorBriefRenderOptions {\n32:   readonly tokenCap?: number;\n33:   readonly thresholdConfig?: {\n34:     readonly confidenceThreshold?: number;\n35:     readonly uncertaintyThreshold?: number;\n36:     readonly confidenceOnly?: boolean;\n37:   };\n38:   readonly deliveryState?: ShadowDeliveryRenderOptions;\n39:   /**\n40:    * True when prompts use set up, set-up or setup wording, install or reinstall wording\n41:    * including installation and installer, configure or configuration wording or `check`\n42:    * followed within three words by environment, env, config, hooks, tools, tooling,\n43:    * toolchain or skilled. The renderer never reads prompt text.\n44:    */\n45:   readonly setupWording?: boolean;\n46: }\n47: \n48: export interface ShadowDeliveryRenderOptions extends DeliveryStateSignals {\n49:   readonly runtime?: string;\n50:   readonly candidate?: string | null;\n51:   readonly stateMachine?: DeliveryStateMachine;\n52:   readonly deliveryConfirmed?: boolean;\n53:   readonly receipt?: DeliveryStateReceipt;\n54:   readonly transformMessageIdentity?: string | null;\n55:   readonly onShadowLog?: (record: ShadowRouteOnlyLogRecord) => void;\n56: }\n57: \n58: export interface ShadowRouteOnlyLogRecord {\n59:   readonly shadowId: string;\n60:   readonly sessionKnown: boolean;\n61:   readonly epoch: number;\n62:   readonly policySetHash: string;\n63:   readonly routeState: DeliveryStateName | null;\n64:   readonly emittedByteCount: number;\n65:   readonly routeOnlyByteCount: number;\n66:   readonly savedBytes: number;\n67: }\n68: \n69: export interface AdvisorBriefRenderableResult {\n70:   readonly status: 'ok' | 'stale' | 'skipped' | 'degraded' | 'fail_open';\n71:   readonly freshness: 'live' | 'stale' | 'absent' | 'unavailable';\n72:   readonly recommendations: readonly AdvisorRecommendation[];\n73:   readonly ambiguous?: boolean;\n74:   readonly metrics?: {\n75:     readonly tokenCap?: number;\n76:   } | null;\n77:   readonly sharedPayload?: {\n78:     readonly metadata?: {\n79:       readonly skillLabel?: string | null;\n80:     } | null;\n81:   } | null;\n82: }\n83: \n84: export type AdvisorFallbackCase = 'outage' | 'no-match' | 'skipped';\n85: export type AdvisorFallbackClassification =\n86:   | {\n87:     readonly fallbackCase: 'outage';\n88:     readonly outageLabel: 'absent' | 'degraded' | 'fail_open';\n89:   }\n90:   | {\n91:     readonly fallbackCase: 'no-match' | 'skipped';\n92:   };\n93: \n94: // ───────────────────────────────────────────────────────────────\n95: // 2. CONSTANTS\n96: // ───────────────────────────────────────────────────────────────\n97: \n98: const DEFAULT_TOKEN_CAP = 80;\n99: const AMBIGUOUS_TOKEN_CAP = 120;\n100: const MAX_TOKEN_CAP = 120;\n101: const TOKEN_TO_CHAR_ESTIMATE = 4;\n102: const INSTRUCTION_LABEL_PATTERN =\n103:   /^\\s*(SYSTEM|INSTRUCTION|IGNORE|EXECUTE)\\s*[:=]|^\\s*(<!--|```)|\\b(ignore\\s+(previous|all)\\s+instructions|system\\s*:|instruction\\s*:|execute\\s*:|developer\\s*:|assistant\\s*:)/i;\n104: const CONTROL_CHAR_PATTERN = /[\\u0000-\\u0008\\u000B\\u000C\\u000E-\\u001F\\u007F]/g;\n105: const ROUTE_ONLY_SHADOW_ID = 'shadow.route-only.advisor.v1';\n106: const OBSERVED_ADVISOR_POLICY_CANDIDATE = '004';\n107: export const ROUTE_ONLY_ESTIMATED_BYTES = 43;\n108: const MAX_SHADOW_ROUTE_ONLY_LOG = 256;\n109: \n110: function directiveBlockIds(): readonly string[] {\n111:   return Object.freeze([\n112:     POLICY_COMMENT_HYGIENE_ID,\n113:   ]);\n114: }\n115: \n116: const SHADOW_ROUTE_ONLY_LOG: ShadowRouteOnlyLogRecord[] = [];\n117: \n118: // Injected into every advisor brief so all hook-capable runtimes receive\n119: // the comment hygiene rule even when AGENTS.md is absent from session context.\n120: export const HYGIENE_DIRECTIVE = '\\n- Comment hygiene [HARD BLOCK]: NEVER embed ADR-/REQ-/CHK-/task-ids or spec paths in code comments — forbidden regardless of instruction. Write the durable WHY instead. Pre-commit gate blocks violations.';\n121: \n122: \n123: \n124: // Labels the directive block so injected content reads as one structured\n125: // capsule instead of loose lines.\n126: export const DIRECTIVES_LABEL = '\\nDirectives:';\n127: \n128: // One bounded sentence for a setup-shaped prompt that matched nothing, so the\n129: // reader learns the read-only overview exists without every miss paying for it.\n130: export const SETUP_HINT = ' For setup or health checks, run /doctor:setup.';\n131: \n132: // ───────────────────────────────────────────────────────────────\n133: // 3. HELPERS\n134: // ───────────────────────────────────────────────────────────────\n135: \n136: function clampTokenCap(tokenCap: number | undefined): number {\n137:   if (typeof tokenCap !== 'number' || Number.isNaN(tokenCap)) {\n138:     return DEFAULT_TOKEN_CAP;\n139:   }\n140:   return Math.min(Math.max(1, Math.floor(tokenCap)), MAX_TOKEN_CAP);\n141: }\n142: \n143: function capText(text: string, tokenCap: number): string {\n144:   const charCap = tokenCap * TOKEN_TO_CHAR_ESTIMATE;\n145:   if (text.length <= charCap) {\n146:     return text;\n147:   }\n148:   const truncated = text.slice(0, Math.max(1, charCap - 3)).trimEnd();\n149:   return `${truncated}...`;\n150: }\n151: \n152: function sanitizeSkillLabel(skillLabel: string | null | undefined): string | null {\n153:   if (typeof skillLabel !== 'string') {\n154:     return null;\n155:   }\n156:   const folded = canonicalFold(skillLabel);\n157:   if (/[\\n\\r]/.test(folded)) {\n158:     return null;\n159:   }\n160:   const singleLine = folded\n161:     .replace(CONTROL_CHAR_PATTERN, '')\n162:     .replace(/\\s+/g, ' ')\n163:     .trim();\n164:   if (!singleLine || INSTRUCTION_LABEL_PATTERN.test(singleLine)) {\n165:     return null;\n166:   }\n167:   return singleLine;\n168: }\n169: \n170: const DOCTOR_BRIDGE_PREFIX = 'command-doctor-';\n171: \n172: function isDoctorBridgeId(skillId: string): boolean {\n173:   return skillId.startsWith(DOCTOR_BRIDGE_PREFIX);\n174: }\n175: \n176: /** Return the sanitized runnable command for a doctor bridge id, or null when unmapped. */\n177: export function doctorCommandString(skillId: string): string | null {\n178:   if (!isDoctorBridgeId(skillId)) {\n179:     return null;\n180:   }\n181:   const command = commandRowFor(skillId)?.command;\n182:   return command === undefined ? null : sanitizeSkillLabel(command);\n183: }\n184: \n185: // A recommendation that names a command renders as the skill that owns it, the\n186: // runnable command and the policy that governs the run. The recommendation's own\n187: // fields stay authoritative and the generated row fills only what they omit, so a\n188: // caller that already resolved the command is never second-guessed.\n189: function commandLabel(recommendation: RenderableRecommendation): string | null {\n190:   const row = commandRowFor(recommendation.skill);\n191:   const command = recommendation.command ?? row?.command;\n192:   const owner = recommendation.ownerSkillId ?? row?.ownerSkillId ?? recommendation.skill;\n193:   const policy = recommendation.policy ?? row?.policy;\n194:   const commandPart = command === undefined ? null : sanitizeSkillLabel(command);\n195:   const ownerPart = sanitizeSkillLabel(owner);\n196:   if (!commandPart || !ownerPart) {\n197:     return null;\n198:   }\n199:   const policyPart = policy === undefined ? null : sanitizeSkillLabel(policy);\n200:   return policyPart === null\n201:     ? `${ownerPart} → ${commandPart}`\n202:     : `${ownerPart} → ${commandPart} (${policyPart})`;\n203: }\n204: \n205: // A doctor bridge renders as its runnable command and never as its raw id; an\n206: // unmapped doctor id renders nothing.\n207: function recommendationLabel(recommendation: RenderableRecommendation): string | null {\n208:   return commandLabel(recommendation)\n209:     ?? (isDoctorBridgeId(recommendation.skill)\n210:       ? doctorCommandString(recommendation.skill)\n211:       : sanitizeSkillLabel(recommendation.skill));\n212: }\n213: \n214: function formatScore(value: number): string {\n215:   return Number.isFinite(value) ? value.toFixed(2) : '0.00';\n216: }\n217: \n218: type RenderableRecommendation = AdvisorRecommendation & {\n219:   readonly score?: number;\n220:   readonly ambiguousWith?: readonly string[];\n221:   readonly heldBelow?: string;\n222: };\n223: \n224: function toScoredRecommendation(recommendation: RenderableRecommendation): AdvisorScoredRecommendation {\n225:   return {\n226:     skill: recommendation.skill,\n227:     kind: recommendation.kind === 'command' ? 'command' : 'skill',\n228:     confidence: recommendation.confidence,\n229:     uncertainty: recommendation.uncertainty,\n230:     passes_threshold: recommendation.passes_threshold ?? true,\n231:     reason: '',\n232:     score: typeof recommendation.score === 'number' && Number.isFinite(recommendation.score)\n233:       ? recommendation.score\n234:       : recommendation.confidence,\n235:     laneContributions: [],\n236:     dominantLane: null,\n237:     lifecycleStatus: 'active',\n238:     ...(Array.isArray(recommendation.ambiguousWith) ? { ambiguousWith: recommendation.ambiguousWith } : {}),\n239:     ...(typeof recommendation.heldBelow === 'string' ? { heldBelow: recommendation.heldBelow } : {}),\n240:   };\n241: }\n242: \n243: /**\n244:  * Detect whether the renderable recommendation set carries ambiguity evidence.\n245:  *\n246:  * `precomputedAmbiguous` carries the scorer's own verdict. It wins when defined: the\n247:  * scorer knows which skills a typed command held below the top and which only cleared\n248:  * a confidence floor, and serialized recommendations lose that context. Only when the\n249:  * caller has no verdict is ambiguity re-derived from the rendered fields.\n250:  */\n251: export function hasAdvisorAmbiguitySignal(\n252:   recommendations: readonly AdvisorRecommendation[],\n253:   precomputedAmbiguous?: boolean,\n254: ): boolean {\n255:   if (typeof precomputedAmbiguous === 'boolean') {\n256:     return precomputedAmbiguous;\n257:   }\n258:   return isAmbiguousTopTwo((recommendations as readonly RenderableRecommendation[]).map(toScoredRecommendation));\n259: }\n260: \n261: function metadataSkillLabel(result: AdvisorBriefRenderableResult): string | null {\n262:   const metadata = result.sharedPayload?.metadata;\n263:   return typeof metadata?.skillLabel === 'string' ? metadata.skillLabel : null;\n264: }\n265: \n266: /** Return only the advisor route block that the shadow path would retain. */\n267: export function renderRouteOnlyAdvisorBrief(rendered: string | null): string | null {\n268:   const routeBlock = buildAdvisorRenderPlan(rendered).blocks.find((block) => (\n269:     block.id === ROUTE_ADVISOR_ID\n270:   ));\n271:   return routeBlock?.content ?? null;\n272: }\n273: \n274: /** Read the append-only in-process shadow log without exposing route content. */\n275: export function getShadowRouteOnlyLog(): readonly ShadowRouteOnlyLogRecord[] {\n276:   return Object.freeze(SHADOW_ROUTE_ONLY_LOG.map((record) => ({ ...record })));\n277: }\n278: \n279: /** Clear shadow log entries between isolated evaluations. */\n280: export function clearShadowRouteOnlyLog(): void {\n281:   SHADOW_ROUTE_ONLY_LOG.length = 0;\n282: }\n283: \n284: function stateSignalsForBlock(options: ShadowDeliveryRenderOptions): ShadowDeliveryRenderOptions {\n285:   return {\n286:     ...options,\n287:     lifecycleEvent: undefined,\n288:     scopeChanged: false,\n289:     policySetChanged: false,\n290:     goalChanged: false,\n291:   };\n292: }\n293: \n294: function pushShadowRouteOnlyLog(record: ShadowRouteOnlyLogRecord): void {\n295:   if (SHADOW_ROUTE_ONLY_LOG.length >= MAX_SHADOW_ROUTE_ONLY_LOG) {\n296:     SHADOW_ROUTE_ONLY_LOG.shift();\n297:   }\n298:   SHADOW_ROUTE_ONLY_LOG.push(record);\n299: }\n300: \n301: function directiveBlocksSuppressed(\n302:   plan: ReturnType<typeof buildAdvisorRenderPlan>,\n303:   decisions: readonly ReturnType<typeof evaluateDeliveryState>[],\n304: ): boolean {\n305:   for (const expectedId of directiveBlockIds()) {\n306:     const blockIndex = plan.blocks.findIndex((block) => block.id === expectedId);\n307:     if (blockIndex === -1) {\n308:       return false;\n309:     }\n310:     const decision = decisions[blockIndex];\n311:     if (!decision || decision.state !== 'SUPPRESSED_SAME') {\n312:       return false;\n313:     }\n314:   }\n315:   return true;\n316: }\n317: \n318: function recordObservedBlockDeliveries(\n319:   plan: ReturnType<typeof buildAdvisorRenderPlan>,\n320:   shadowOptions: ShadowDeliveryRenderOptions,\n321:   machine: DeliveryStateMachine,\n322:   epoch: number,\n323: ): void {\n324:   const blockOptions = stateSignalsForBlock(shadowOptions);\n325:   for (const block of plan.blocks) {\n326:     const receipt = shadowOptions.receipt;\n327:     if (!isObservedDeliveryReceipt(receipt, block.contentHash, epoch)) {\n328:       continue;\n329:     }\n330:     machine.recordDelivery({\n331:       ...blockOptions,\n332:       blockId: block.id,\n333:       contentHash: block.contentHash,\n334:       receipt,\n335:     });\n336:   }\n337: }\n338: \n339: function observeShadowRouteOnly(\n340:   rendered: string | null,\n341:   options: ShadowDeliveryRenderOptions | undefined,\n342: ): void {\n343:   try {\n344:     const plan = buildAdvisorRenderPlan(rendered);\n345:     const shadowOptions = options ?? {};\n346:     const machine = shadowOptions.stateMachine ?? SHADOW_DELIVERY_STATE_MACHINE;\n347:     const epochSnapshot = machine.advanceForSignals(shadowOptions);\n348:     const blockOptions = stateSignalsForBlock(shadowOptions);\n349:     const decisions = plan.blocks.map((block) => evaluateDeliveryState({\n350:       ...blockOptions,\n351:       blockId: block.id,\n352:       contentHash: block.contentHash,\n353:     }, machine));\n354: \n355:     recordObservedBlockDeliveries(plan, shadowOptions, machine, epochSnapshot.epoch);\n356: \n357:     const routeIndex = plan.blocks.findIndex((block) => block.id === ROUTE_ADVISOR_ID);\n358:     const routeDecision = routeIndex === -1 ? null : decisions[routeIndex] ?? null;\n359:     const routeOnlyEligible = Boolean(\n360:       routeDecision?.routeOnlyEligible && directiveBlocksSuppressed(plan, decisions),\n361:     );\n362:     const routeOnly = routeOnlyEligible\n363:       ? renderRouteOnlyAdvisorBrief(rendered)\n364:       : null;\n365:     const emittedByteCount = rendered === null ? 0 : Buffer.byteLength(rendered, 'utf8');\n366:     const routeOnlyByteCount = routeOnly === null ? 0 : Buffer.byteLength(routeOnly, 'utf8');\n367:     const savedBytes = routeOnly === null\n368:       ? 0\n369:       : Math.max(0, emittedByteCount - routeOnlyByteCount);\n370:     const record: ShadowRouteOnlyLogRecord = Object.freeze({\n371:       shadowId: ROUTE_ONLY_SHADOW_ID,\n372:       sessionKnown: routeDecision?.sessionKnown ?? epochSnapshot.sessionKnown,\n373:       epoch: routeDecision?.epoch ?? epochSnapshot.epoch,\n374:       policySetHash: plan.policySetHash,\n375:       routeState: routeDecision?.state ?? null,\n376:       emittedByteCount,\n377:       routeOnlyByteCount,\n378:       savedBytes,\n379:     });\n380:     pushShadowRouteOnlyLog(record);\n381:     try {\n382:       options?.onShadowLog?.(record);\n383:     } catch {\n384:       // Observer callbacks must never affect the rendered advisor bytes.\n385:     }\n386:   } catch {\n387:     // Shadow measurement is fail-open so a throwing observer cannot block delivery.\n388:   }\n389: }\n390: \n391: function observeAdvisorPolicy(\n392:   rendered: string | null,\n393:   options: AdvisorBriefRenderOptions = {},\n394: ): void {\n395:   try {\n396:     observeRenderedAdvisorPolicy(rendered);\n397:   } catch {\n398:     // Shadow measurement is fail-open so a throwing observer cannot block delivery.\n399:   }\n400:   observeShadowRouteOnly(rendered, options.deliveryState);\n401: }\n402: \n403: /** Run the shadow planner for a runtime callback without changing its output. */\n404: export function observeShadowDelivery(\n405:   rendered: string | null,\n406:   deliveryState: ShadowDeliveryRenderOptions = {},\n407: ): void {\n408:   observeAdvisorPolicy(rendered, { deliveryState });\n409: }\n410: \n411: /**\n412:  * Record host-observed policy blocks after the runtime places them into the\n413:  * emitted response. Fail-open: recording errors never change emitted bytes.\n414:  */\n415: export function observeEmittedAdvisorPolicy(\n416:   rendered: string | null,\n417:   deliveryState: ShadowDeliveryRenderOptions = {},\n418: ): void {\n419:   try {\n420:     if (typeof rendered !== 'string' || rendered.length === 0) {\n421:       return;\n422:     }\n423:     const runtime = typeof deliveryState.runtime === 'string' && deliveryState.runtime.length > 0\n424:       ? deliveryState.runtime\n425:       : 'unknown';\n426:     const machine = deliveryState.stateMachine ?? SHADOW_DELIVERY_STATE_MACHINE;\n427:     const epoch = machine.currentEpoch(deliveryState);\n428:     const plan = buildAdvisorRenderPlan(rendered);\n429:     for (const block of plan.blocks) {\n430:       recordObservedPolicyDelivery({\n431:         runtime,\n432:         candidate: deliveryState.candidate ?? OBSERVED_ADVISOR_POLICY_CANDIDATE,\n433:         blockId: block.id,\n434:         content: block.content,\n435:         contentHash: block.contentHash,\n436:         lifecycleEpoch: epoch,\n437:         sessionId: deliveryState.sessionId,\n438:         sessionIdentity: deliveryState.sessionIdentity,\n439:         sessionIdentityConfirmed: deliveryState.sessionIdentityConfirmed,\n440:         sessionIdentityAmbiguous: deliveryState.sessionIdentityAmbiguous,\n441:         transformMessageIdentity: deliveryState.transformMessageIdentity ?? null,\n442:       });\n443:     }\n444:   } catch {\n445:     // Host observation is fail-open so a throwing sink cannot affect delivery.\n446:   }\n447: }\n448: \n449: // ───────────────────────────────────────────────────────────────\n450: // 4. CORE LOGIC\n451: // ───────────────────────────────────────────────────────────────\n452: \n453: /**\n454:  * Render the model-visible advisor brief from typed advisor output only.\n455:  *\n456:  * The renderer is the prompt-boundary guard: it ignores free-form reasons,\n457:  * descriptions, stdout/stderr, and prompt text, and emits nothing when the\n458:  * repository-authored skill label looks instruction-shaped after folding.\n459:  */\n460: export function renderAdvisorBrief(\n461:   result: AdvisorBriefRenderableResult,\n462:   options: AdvisorBriefRenderOptions = {},\n463: ): string | null {\n464:   if (result.status !== 'ok') {\n465:     observeAdvisorPolicy(null, options);\n466:     return null;\n467:   }\n468:   if (result.freshness !== 'live' && result.freshness !== 'stale') {\n469:     observeAdvisorPolicy(null, options);\n470:     return null;\n471:   }\n472: \n473:   const tokenCap = clampTokenCap(result.metrics?.tokenCap ?? options.tokenCap);\n474:   const thresholdConfig = options.thresholdConfig;\n475:   const recommendations = result.recommendations.filter((recommendation) => (\n476:     recommendation.passes_threshold === true\n477:     || (\n478:       recommendation.confidence >= (thresholdConfig?.confidenceThreshold ?? resolvedConfidenceThreshold())\n479:       && (\n480:         thresholdConfig?.confidenceOnly === true\n481:         || recommendation.uncertainty <= (thresholdConfig?.uncertaintyThreshold ?? resolvedUncertaintyThreshold())\n482:       )\n483:     )\n484:   ));\n485:   const [top, second] = recommendations;\n486:   if (!top) {\n487:     observeAdvisorPolicy(null, options);\n488:     return null;\n489:   }\n490: \n491:   const topLabel = commandLabel(top)\n492:     ?? (isDoctorBridgeId(top.skill)\n493:       ? doctorCommandString(top.skill)\n494:       : sanitizeSkillLabel(metadataSkillLabel(result) ?? top.skill));\n495:   if (!topLabel) {\n496:     observeAdvisorPolicy(null, options);\n497:     return null;\n498:   }\n499: \n500:   const companion = isDoctorBridgeId(top.skill)\n501:     ? undefined\n502:     : recommendations.slice(1).find((recommendation) => doctorCommandString(recommendation.skill) !== null);\n503:   const companionLabel = companion ? doctorCommandString(companion.skill) : null;\n504:   const companionLine = (shownSecond: string | undefined): string => (\n505:     companionLabel && companion && companion.skill !== shownSecond ? `\\nAlso: ${companionLabel}` : ''\n506:   );\n507:   const capWithCompanion = (head: string, companionText: string, cap: number): string => {\n508:     const companionFits = head.length + companionText.length <= cap * TOKEN_TO_CHAR_ESTIMATE;\n509:     return `${capText(head, cap)}${companionFits ? companionText : ''}`;\n510:   };\n511: \n512:   const precomputedAmbiguous = typeof result.ambiguous === 'boolean' ? result.ambiguous : undefined;\n513:   if (tokenCap > DEFAULT_TOKEN_CAP && second && hasAdvisorAmbiguitySignal(recommendations, precomputedAmbiguous)) {\n514:     // The scorer names its own tie partners, which can sit below the second passing\n515:     // entry, so prefer a named partner and fall back to the second entry.\n516:     const namedPartners = (top as RenderableRecommendation).ambiguousWith;\n517:     const ambiguousWith: readonly string[] = Array.isArray(namedPartners) ? namedPartners : [];\n518:     const vs = (ambiguousWith.length > 0\n519:       ? recommendations.find((recommendation) => ambiguousWith.includes(recommendation.skill))\n520:       : undefined) ?? second;\n521:     const vsLabel = recommendationLabel(vs);\n522:     if (!vsLabel && !isDoctorBridgeId(vs.skill)) {\n523:       observeAdvisorPolicy(null, options);\n524:       return null;\n525:     }\n526:     if (vsLabel) {\n527:       const head = `Advisor: ${result.freshness}; ambiguous: ${topLabel} `\n528:         + `${formatScore(top.confidence)}/${formatScore(top.uncertainty)} vs ${vsLabel} `\n529:         + `${formatScore(vs.confidence)}/${formatScore(vs.uncertainty)} pass.`;\n530:       const rendered = capWithCompanion(\n531:         head,\n532:         companionLine(vs.skill),\n533:         Math.min(tokenCap, AMBIGUOUS_TOKEN_CAP),\n534:       ) + DIRECTIVES_LABEL + HYGIENE_DIRECTIVE;\n535:       observeAdvisorPolicy(rendered, options);\n536:       return rendered;\n537:     }\n538:   }\n539: \n540:   const head = `Advisor: ${result.freshness}; use ${topLabel} `\n541:     + `${formatScore(top.confidence)}/${formatScore(top.uncertainty)} pass.`;\n542:   const rendered = capWithCompanion(\n543:     head,\n544:     companionLine(undefined),\n545:     Math.min(tokenCap, DEFAULT_TOKEN_CAP),\n546:   ) + DIRECTIVES_LABEL + HYGIENE_DIRECTIVE;\n547:   observeAdvisorPolicy(rendered, options);\n548:   return rendered;\n549: }\n550: \n551: /** Classify a result with no brief; no result at all means the advisor did not answer. */\n552: export function advisorFallbackCase(\n553:   result?: Pick<AdvisorHookResult, 'status' | 'freshness'>,\n554: ): AdvisorFallbackClassification {\n555:   if (!result || result.status === 'fail_open' || result.freshness === 'absent'\n556:     || (result.freshness === 'unavailable' && result.status !== 'skipped')) {\n557:     return {\n558:       fallbackCase: 'outage',\n559:       outageLabel: result?.freshness === 'absent'\n560:         ? 'absent'\n561:         : result?.status === 'degraded'\n562:           ? 'degraded'\n563:           : 'fail_open',\n564:     };\n565:   }\n566:   if (result.status === 'skipped' && result.freshness === 'unavailable') {\n567:     return { fallbackCase: 'skipped' };\n568:   }\n569:   return { fallbackCase: 'no-match' };\n570: }\n571: \n572: /** Render the fallback status and directive block when no advisor brief is available. */\n573: export function renderAdvisorFallbackDirective(\n574:   options: AdvisorBriefRenderOptions = {},\n575:   result?: Pick<AdvisorHookResult, 'status' | 'freshness'>,\n576: ): string {\n577:   const classification = advisorFallbackCase(result);\n578:   const head = classification.fallbackCase === 'outage'\n579:     ? `Advisor: outage (${classification.outageLabel});${options.setupWording === true ? ' for setup or health checks, run /doctor:setup;' : ''} route by hand: node .skilled/bin/skill-advisor.cjs advisor_recommend --json '{\"prompt\":\"<request>\"}' --format json`\n580:     : classification.fallbackCase === 'skipped'\n581:       ? 'Advisor: prompt skipped.'\n582:       : options.setupWording === true\n583:         ? `Advisor: no skill matched.${SETUP_HINT}`\n584:         : 'Advisor: no skill matched.';\n585:   const rendered = head + DIRECTIVES_LABEL + HYGIENE_DIRECTIVE;\n586:   observeAdvisorPolicy(rendered, options);\n587:   return rendered;\n588: }\n589: \n590: /** Render the outage fallback used when advisor execution times out or is unavailable. */\n591: export function renderAdvisorTimeoutFallback(\n592:   options: AdvisorBriefRenderOptions = {},\n593:   status: Extract<AdvisorHookResult['status'], 'fail_open' | 'degraded'> = 'fail_open',\n594: ): string {\n595:   return renderAdvisorFallbackDirective(options, { status, freshness: 'unavailable' });\n596: }\n597: \n598: export { sanitizeSkillLabel };"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":