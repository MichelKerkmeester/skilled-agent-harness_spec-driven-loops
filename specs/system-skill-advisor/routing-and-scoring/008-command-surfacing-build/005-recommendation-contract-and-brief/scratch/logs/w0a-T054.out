 'lib/scorer/fusion.js'));\n267:   const { mergedSkillForAlias, skillMatchesAlias } = await import(join(DIST, 'lib/scorer/aliases.js'));\n268:   const { findAdvisorWorkspaceRoot } = await import(join(DIST, 'lib/utils/workspace-root.js'));\n269:   const { loadAdvisorProjection } = await import(join(DIST, 'lib/scorer/projection.js'));\n270: \n271:   const workspaceRoot = findAdvisorWorkspaceRoot(HERE, { maxDepth: 14, sentinel: SENTINEL });\n272:   const projection = loadAdvisorProjection(workspaceRoot);\n273: \n274:   const corpora = {};\n275:   for (const [name, [file, n]] of Object.entries(CORPORA)) {\n276:     const rows = readFileSync(join(HERE, file), 'utf8').trim().split('\\n').filter(Boolean).map((line) => JSON.parse(line));\n277:     if (rows.length !== n) {\n278:       throw new Error(`${file}: expected ${n} rows, got ${rows.length}`);\n279:     }\n280:     corpora[name] = rows;\n281:   }\n282: \n283:   function isMatch(actual, goldRaw) {\n284:     const gold = goldRaw === 'none' ? null : goldRaw;\n285:     const expected = gold === null ? null : mergedSkillForAlias(gold);\n286:     const canonical = actual === null ? null : mergedSkillForAlias(actual);\n287:     return canonical === expected\n288:       || (canonical !== null && expected !== null && skillMatchesAlias(canonical, expected));\n289:   }\n[Output truncated. Continue reading with offset: 290]","title":"read","metadata":{"metadata":{"truncated":true},"content":[{"type":"text","text":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/specs/cli-classifier/003-cli-jev-workflow-integration/002-advisor-jev-tiebreak-arm/scratch/w3-build/logs/41.pre.mjs, lines 250-289\n250:  * @returns {Promise<{ holdoutTop1: { correct: number, total: number }, rows: object[], labels: Array<{ id: string, prompt: string, yes: boolean }>, isMatch: (actual: string|null, goldRaw: string) => boolean, describe: (skill: string) => string }>}\n251:  */\n252: export async function loadCensus() {\n253:   process.env.SYSTEM_SKILL_ADVISOR_DB_DIR = mkdtempSync(join(tmpdir(), 'advisor-jev-tiebreak-'));\n254:   process.env.SKILL_ADVISOR_DISABLE_BUILTIN_SEMANTIC = '1';\n255:   process.env.SPECKIT_SKILL_ADVISOR_FORCE_LOCAL = '1';\n256:   process.env.PYTHONDONTWRITEBYTECODE = '1';\n257:   // Match the test-harness regime: the semantic-shadow lane substitutes\n258:   // deterministic fixture vectors under the harness flag (real embeddings are not\n259:   // reproducible in CI), so every scorer gate runs this way. The baseline must be\n260:   // captured under the same regime the ratchet re-scores it in.\n261:   process.env.VITEST = 'true';\n262:   delete process.env.SPECKIT_ADVISOR_LANE_WEIGHTS_JSON;\n263:   delete process.env.SPECKIT_ADVISOR_LANE_SHADOW_WEIGHTS_JSON;\n264:   delete process.env.SPECKIT_ADVISOR_BM25_LEXICAL_SHADOW;\n265: \n266:   const { scoreAdvisorPrompt } = await import(join(DIST, 'lib/scorer/fusion.js'));\n267:   const { mergedSkillForAlias, skillMatchesAlias } = await import(join(DIST, 'lib/scorer/aliases.js'));\n268:   const { findAdvisorWorkspaceRoot } = await import(join(DIST, 'lib/utils/workspace-root.js'));\n269:   const { loadAdvisorProjection } = await import(join(DIST, 'lib/scorer/projection.js'));\n270: \n271:   const workspaceRoot = findAdvisorWorkspaceRoot(HERE, { maxDepth: 14, sentinel: SENTINEL });\n272:   const projection = loadAdvisorProjection(workspaceRoot);\n273: \n274:   const corpora = {};\n275:   for (const [name, [file, n]] of Object.entries(CORPORA)) {\n276:     const rows = readFileSync(join(HERE, file), 'utf8').trim().split('\\n').filter(Boolean).map((line) => JSON.parse(line));\n277:     if (rows.length !== n) {\n278:       throw new Error(`${file}: expected ${n} rows, got ${rows.length}`);\n279:     }\n280:     corpora[name] = rows;\n281:   }\n282: \n283:   function isMatch(actual, goldRaw) {\n284:     const gold = goldRaw === 'none' ? null : goldRaw;\n285:     const expected = gold === null ? null : mergedSkillForAlias(gold);\n286:     const canonical = actual === null ? null : mergedSkillForAlias(actual);\n287:     return canonical === expected\n288:       || (canonical !== null && expected !== null && skillMatchesAlias(canonical, expected));\n289:   }\n[Output truncated. Continue reading with offset: 290]"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"limit\":40,\"offset\":250,\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/specs/cli-classifier/003-cli-jev-workflow-integration/002-advisor-jev-tiebreak-arm/scratch/w3-build/logs/41.pre.mjs\"}"},"time":{"start":1794522088492,"end":1794522089164}}}}
