causal\",\n  \"raw\": 0,\n  \"w\": 0.13,\n  \"weighted\": 0\n },\n {\n  \"lane\": \"derived_generated\",\n  \"raw\": 0.551179,\n  \"w\": 0.12,\n  \"weighted\": 0.06614147999999999\n },\n {\n  \"lane\": \"semantic_shadow\",\n  \"raw\": 0.16000000000000003,\n  \"w\": 0.05,\n  \"weighted\": 0.008000000000000002\n }\n]\n2026-11-12T22:19:54Z\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"node --input-type=module -e '\\nprocess.env.VITEST = \\\"true\\\";\\nprocess.env.SPECKIT_SKILL_ADVISOR_FORCE_LOCAL = \\\"1\\\";\\nconst { scoreAdvisorPrompt } = await import(\\\"./.skilled/skills/system-skill-advisor/runtime/dist/runtime/lib/scorer/fusion.js\\\");\\nconst r = scoreAdvisorPrompt(\\\"fix the typo in the heading of the setup guide\\\", { workspaceRoot: process.cwd() });\\nconst x = r.recommendations.find((y) => y.skill === \\\"system-skilled-doctor\\\");\\nconsole.log(JSON.stringify(x.laneContributions.map((c) => ({lane:c.lane, raw:c.rawScore, w:c.weight, weighted:c.weightedScore})), null, 1));\\n' 2>&1 | head -40; date -u +\\\"%Y-%m-%dT%H:%M:%SZ\\\"\",\"workdir\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research\"}"},"time":{"start":1794521992308,"end":1794521994276}}}}
