{"type":"tool_use","timestamp":1794521873977,"sessionID":"ses_e2e2a7dd5ffeKSW8P83xK0M1au","part":{"partID":"prt_1d1d6ba56001LlS33cwmT05xyD","sessionID":"ses_e2e2a7dd5ffeKSW8P83xK0M1au","messageID":"msg_1d1d6a62d001SJQ19pXna2Z6rh","type":"tool","id":"call_810a56eec3984a1983b461fd","tool":"shell","state":{"status":"completed","input":{"command":"sed -n '1120,1200p' .skilled/skills/system-skill-advisor/runtime/lib/scorer/fusion.ts; rg -n \"interface AdvisorScoringResult|type AdvisorScoringResult|interface AdvisorScoringOptions|type AdvisorScoringOptions\" .skilled/skills/system-skill-advisor/runtime/lib/scorer/*.ts","workdir":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research"},"output":"  }\n  if (isDoctorCommandTyped(context.promptLower)) return [...ranked];\n  const skillPasses = ranked.some((recommendation) => (\n    !isDoctorBridge(recommendation) && recommendation.passes_threshold\n  ));\n  const cue = doctorProblemCue(context.prompt);\n  if (skillPasses && cue !== 'strong') return [...ranked];\n\n  const helperSkill = context.projection.skills.find((skill) => skill.id === DOCTOR_HELPER_BRIDGE_ID);\n  if (!helperSkill) return [...ranked];\n  const match = matchDoctorProblem(context.prompt, context.workspaceRoot);\n  if (!match) return [...ranked];\n  if (cue === null && match.score < DOCTOR_HELPER_UNCUED_MIN_SCORE) return [...ranked];\n\n  const existing = ranked.find((recommendation) => recommendation.skill === DOCTOR_HELPER_BRIDGE_ID);\n  const handoff: AdvisorScoredRecommendation = {\n    skill: DOCTOR_HELPER_BRIDGE_ID,\n    kind: 'command',\n    confidence: Math.max(existing?.confidence ?? 0, context.confidenceThreshold),\n    uncertainty: Math.min(existing?.uncertainty ?? context.uncertaintyThreshold, context.uncertaintyThreshold),\n    passes_threshold: true,\n    reason: `doctor helper hand-off: /doctor:helper ranks ${match.command} first for this problem`,\n    score: existing?.score ?? 0,\n    laneContributions: existing?.laneContributions ?? [],\n    dominantLane: existing?.dominantLane ?? null,\n    lifecycleStatus: helperSkill.lifecycleStatus,\n  };\n  const withHandoff = [\n    ...ranked.filter((recommendation) => recommendation.skill !== DOCTOR_HELPER_BRIDGE_ID),\n    handoff,\n  ];\n  return keepPassingSkillsAboveDoctorBridges(withHandoff, context.promptLower, context.leadPhrasesById);\n}\n\nexport function scoreAdvisorPrompt(prompt: string, options: AdvisorScoringOptions): AdvisorScoringResult {\n  const projection = projectionWithUsableSkillIds(\n    options.projection ?? loadAdvisorProjection(options.workspaceRoot),\n  );\n  const promptLower = prompt.toLowerCase();\n  const queryClass = classifyAdvisorQuery(promptLower);\n  const weights = effectiveScorerWeights(\n    options.laneWeightsOverride,\n    isAdvisorQueryClassRoutingEnabled() ? queryClass : 'unknown',\n  );\n  const disabled = new Set(options.disabledLanes ?? []);\n  const affordances = normalize(options.affordances ?? []);\n  const useRrfFusion = isAdvisorRrfFusionEnabled();\n  const useExactSemanticRerank = useRrfFusion && isAdvisorExactSemanticRerankEnabled();\n  const { laneScores, graphConflictMatches, graphSupportBySeed } = buildLaneScores(\n    prompt,\n    projection,\n    disabled,\n    affordances,\n    useRrfFusion,\n  );\n  const runtimeLaneHealth = projectionRuntimeLaneHealth(projection, options.runtimeLaneHealth);\n  const laneHealth = buildLaneRuntimeHealth(laneScores, disabled, runtimeLaneHealth);\n  const degradedLanes = laneHealth\n    .filter((lane) => lane.status === 'runtime_degraded')\n    .map((lane) => lane.lane);\n  const runtimeDegradedLanes = new Set(degradedLanes);\n  const graphConflictIndex = buildConflictMatchIndex(graphConflictMatches);\n  const rrfFusion = useRrfFusion\n    ? fuseAdvisorLaneRanks(laneScores, weights, disabled, runtimeDegradedLanes)\n    : null;\n  const laneScoreIndexes = Object.fromEntries(\n    SCORER_LANES.map((lane) => [lane, buildLaneMatchIndex(laneScores[lane])]),\n  ) as Record<ScorerLane, LaneMatchIndex>;\n  const liveTotal = SCORER_LANES\n    .filter((lane) => !disabled.has(lane) && !runtimeDegradedLanes.has(lane))\n    .reduce((total, lane) => isLiveScorerLane(lane) ? total + weights[lane] : total, 0) || liveWeightTotal();\n  const runtimeLiveLaneCount = SCORER_LANES\n    .filter((lane) => isLiveScorerLane(lane) && !disabled.has(lane) && !runtimeDegradedLanes.has(lane))\n    .length;\n  if (isSpeckitMetricsEnabled() && liveTotal > 0) {\n    for (const lane of SCORER_LANES) {\n      if (!isLiveScorerLane(lane) || disabled.has(lane) || runtimeDegradedLanes.has(lane)) continue;\n      speckitMetrics.setGauge('spec_kit.scorer.fusion_live_weight_share', weights[lane] / liveTotal, { lane });\n    }\n  }\n  const readOnlyExplainer = isReadOnlyExplainer(promptLower);\n.skilled/skills/system-skill-advisor/runtime/lib/scorer/types.ts:180:export interface AdvisorScoringOptions {\n.skilled/skills/system-skill-advisor/runtime/lib/scorer/types.ts:204:export interface AdvisorScoringResult {\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"  }\n  if (isDoctorCommandTyped(context.promptLower)) return [...ranked];\n  const skillPasses = ranked.some((recommendation) => (\n    !isDoctorBridge(recommendation) && recommendation.passes_threshold\n  ));\n  const cue = doctorProblemCue(context.prompt);\n  if (skillPasses && cue !== 'strong') return [...ranked];\n\n  const helperSkill = context.projection.skills.find((skill) => skill.id === DOCTOR_HELPER_BRIDGE_ID);\n  if (!helperSkill) return [...ranked];\n  const match = matchDoctorProblem(context.prompt, context.workspaceRoot);\n  if (!match) return [...ranked];\n  if (cue === null && match.score < DOCTOR_HELPER_UNCUED_MIN_SCORE) return [...ranked];\n\n  const existing = ranked.find((recommendation) => recommendation.skill === DOCTOR_HELPER_BRIDGE_ID);\n  const handoff: AdvisorScoredRecommendation = {\n    skill: DOCTOR_HELPER_BRIDGE_ID,\n    kind: 'command',\n    confidence: Math.max(existing?.confidence ?? 0, context.confidenceThreshold),\n    uncertainty: Math.min(existing?.uncertainty ?? context.uncertaintyThreshold, context.uncertaintyThreshold),\n    passes_threshold: true,\n    reason: `doctor helper hand-off: /doctor:helper ranks ${match.command} first for this problem`,\n    score: existing?.score ?? 0,\n    laneContributions: existing?.laneContributions ?? [],\n    dominantLane: existing?.dominantLane ?? null,\n    lifecycleStatus: helperSkill.lifecycleStatus,\n  };\n  const withHandoff = [\n    ...ranked.filter((recommendation) => recommendation.skill !== DOCTOR_HELPER_BRIDGE_ID),\n    handoff,\n  ];\n  return keepPassingSkillsAboveDoctorBridges(withHandoff, context.promptLower, context.leadPhrasesById);\n}\n\nexport function scoreAdvisorPrompt(prompt: string, options: AdvisorScoringOptions): AdvisorScoringResult {\n  const projection = projectionWithUsableSkillIds(\n    options.projection ?? loadAdvisorProjection(options.workspaceRoot),\n  );\n  const promptLower = prompt.toLowerCase();\n  const queryClass = classifyAdvisorQuery(promptLower);\n  const weights = effectiveScorerWeights(\n    options.laneWeightsOverride,\n    isAdvisorQueryClassRoutingEnabled() ? queryClass : 'unknown',\n  );\n  const disabled = new Set(options.disabledLanes ?? []);\n  const affordances = normalize(options.affordances ?? []);\n  const useRrfFusion = isAdvisorRrfFusionEnabled();\n  const useExactSemanticRerank = useRrfFusion && isAdvisorExactSemanticRerankEnabled();\n  const { laneScores, graphConflictMatches, graphSupportBySeed } = buildLaneScores(\n    prompt,\n    projection,\n    disabled,\n    affordances,\n    useRrfFusion,\n  );\n  const runtimeLaneHealth = projectionRuntimeLaneHealth(projection, options.runtimeLaneHealth);\n  const laneHealth = buildLaneRuntimeHealth(laneScores, disabled, runtimeLaneHealth);\n  const degradedLanes = laneHealth\n    .filter((lane) => lane.status === 'runtime_degraded')\n    .map((lane) => lane.lane);\n  const runtimeDegradedLanes = new Set(degradedLanes);\n  const graphConflictIndex = buildConflictMatchIndex(graphConflictMatches);\n  const rrfFusion = useRrfFusion\n    ? fuseAdvisorLaneRanks(laneScores, weights, disabled, runtimeDegradedLanes)\n    : null;\n  const laneScoreIndexes = Object.fromEntries(\n    SCORER_LANES.map((lane) => [lane, buildLaneMatchIndex(laneScores[lane])]),\n  ) as Record<ScorerLane, LaneMatchIndex>;\n  const liveTotal = SCORER_LANES\n    .filter((lane) => !disabled.has(lane) && !runtimeDegradedLanes.has(lane))\n    .reduce((total, lane) => isLiveScorerLane(lane) ? total + weights[lane] : total, 0) || liveWeightTotal();\n  const runtimeLiveLaneCount = SCORER_LANES\n    .filter((lane) => isLiveScorerLane(lane) && !disabled.has(lane) && !runtimeDegradedLanes.has(lane))\n    .length;\n  if (isSpeckitMetricsEnabled() && liveTotal > 0) {\n    for (const lane of SCORER_LANES) {\n      if (!isLiveScorerLane(lane) || disabled.has(lane) || runtimeDegradedLanes.has(lane)) continue;\n      speckitMetrics.setGauge('spec_kit.scorer.fusion_live_weight_share', weights[lane] / liveTotal, { lane });\n    }\n  }\n  const readOnlyExplainer = isReadOnlyExplainer(promptLower);\n.skilled/skills/system-skill-advisor/runtime/lib/scorer/types.ts:180:export interface AdvisorScoringOptions {\n.skilled/skills/system-skill-advisor/runtime/lib/scorer/types.ts:204:export interface AdvisorScoringResult {\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"sed -n '1120,1200p' .skilled/skills/system-skill-advisor/runtime/lib/scorer/fusion.ts; rg -n \\\"interface AdvisorScoringResult|type AdvisorScoringResult|interface AdvisorScoringOptions|type AdvisorScoringOptions\\\" .skilled/skills/system-skill-advisor/runtime/lib/scorer/*.ts\",\"workdir\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research\"}"},"time":{"start":1794521872983,"end":1794521873977}}}}
