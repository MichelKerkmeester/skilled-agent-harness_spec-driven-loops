{"type":"tool_use","timestamp":1794522186718,"sessionID":"ses_e2e2a7dd5ffeKSW8P83xK0M1au","part":{"partID":"prt_1d1db82080014MrHaoucocOcJf","sessionID":"ses_e2e2a7dd5ffeKSW8P83xK0M1au","messageID":"msg_1d1db6969001qtok8smglGhWJe","type":"tool","id":"call_27993572356a4f41a0389c96","tool":"read","state":{"status":"completed","input":{"path":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/lib/scorer/lanes/derived.ts"},"output":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/lib/scorer/lanes/derived.ts, lines 1-112\n1: // ───────────────────────────────────────────────────────────────\n2: // MODULE: Derived Generated Lane\n3: // ───────────────────────────────────────────────────────────────\n4: \n5: // Pull the age-haircut policy from the scorer-local seam\n6: // instead of reaching into the lifecycle subsystem directly. The lifecycle\n7: // implementation stays the source of truth; the seam keeps the scorer's\n8: // dependency direction inward.\n9: import { applyAgeHaircutToLane } from '../age-policy.js';\n10: import type { NormalizedAffordance } from '../../affordance-normalizer.js';\n11: import type { AdvisorProjection, LaneMatch } from '../types.js';\n12: import { matchesPhraseBoundary, phraseSpecificity, scoreTokenOverlap, tokenizePrompt } from '../text.js';\n13: \n14: function affordancesForSkill(\n15:   affordances: readonly NormalizedAffordance[],\n16:   skillId: string,\n17: ): NormalizedAffordance[] {\n18:   return affordances.filter((affordance) => affordance.skillId === skillId);\n19: }\n20: \n21: // Doc-level harvest contribution is bounded twice: only the strongest\n22: // few docs count (so doc-heavy skills cannot outscore lean skills on\n23: // volume alone) and the summed contribution is capped below the level a\n24: // skill's own curated triggers can reach.\n25: const DOC_TOP_N = 3;\n26: const DOC_PHRASE_FACTOR = 0.5;\n27: const DOC_CONTRIBUTION_CAP = 0.45;\n28: \n29: interface DocMatch {\n30:   readonly docPath: string;\n31:   readonly score: number;\n32: }\n33: \n34: function scoreDocTriggers(\n35:   lower: string,\n36:   skill: AdvisorProjection['skills'][number],\n37: ): DocMatch[] {\n38:   const matches: DocMatch[] = [];\n39:   for (const doc of skill.docTriggers ?? []) {\n40:     let best = 0;\n41:     for (const phrase of doc.phrases) {\n42:       if (!matchesPhraseBoundary(lower, phrase)) continue;\n43:       best = Math.max(best, phraseSpecificity(phrase));\n44:     }\n45:     if (best <= 0) continue;\n46:     matches.push({ docPath: doc.docPath, score: best * doc.tierWeight });\n47:   }\n48:   return matches.sort((left, right) => right.score - left.score).slice(0, DOC_TOP_N);\n49: }\n50: \n51: export function scoreDerivedLane(\n52:   prompt: string,\n53:   projection: AdvisorProjection,\n54:   now: Date = new Date(),\n55:   affordances: readonly NormalizedAffordance[] = [],\n56: ): LaneMatch[] {\n57:   const lower = prompt.toLowerCase();\n58:   const tokens = tokenizePrompt(prompt);\n59:   const matches: LaneMatch[] = [];\n60: \n61:   for (const skill of projection.skills) {\n62:     const phrases = [...skill.derivedTriggers, ...skill.derivedKeywords];\n63:     const skillAffordances = affordancesForSkill(affordances, skill.id);\n64:     const affordancePhrases = skillAffordances.flatMap((affordance) => [...affordance.derivedTriggers]);\n65:     const docMatches = scoreDocTriggers(lower, skill);\n66:     if (phrases.length === 0 && affordancePhrases.length === 0 && docMatches.length === 0) continue;\n67:     const evidence: string[] = docMatches.map((doc) => `doc:${doc.docPath}`);\n68:     let score = Math.min(\n69:       docMatches.reduce((total, doc) => total + doc.score, 0) * DOC_PHRASE_FACTOR,\n70:       DOC_CONTRIBUTION_CAP,\n71:     );\n72:     for (const phrase of phrases) {\n73:       if (!matchesPhraseBoundary(lower, phrase)) continue;\n74:       score += phraseSpecificity(phrase) * 0.7;\n75:       evidence.push(`derived:${phrase}`);\n76:     }\n77:     for (const affordance of skillAffordances) {\n78:       let matched = false;\n79:       for (const phrase of affordance.derivedTriggers) {\n80:         if (!matchesPhraseBoundary(lower, phrase)) continue;\n81:         matched = true;\n82:         score += phraseSpecificity(phrase) * 0.45;\n83:       }\n84:       if (matched) evidence.push(affordance.evidenceLabel);\n85:     }\n86:     score += scoreTokenOverlap(tokens, phrases) * 0.45;\n87:     score += scoreTokenOverlap(tokens, affordancePhrases) * 0.25;\n88:     // Decay by the skill's own derived-content age — derivedGeneratedAt is the\n89:     // author/sync time of the derived block (author-time, not refreshed by\n90:     // rebuild; see SkillProjection.derivedGeneratedAt). The projection.generatedAt\n91:     // fallback is a last-resort, timestamp-less value (near-now on every run, so\n92:     // it exempts the skill from the haircut), used ONLY when a skill has no\n93:     // derived.generated_at — it is not a runtime freshness signal.\n94:     const adjusted = applyAgeHaircutToLane(\n95:       { trustLane: 'derived_generated', score: Math.min(score, 1) },\n96:       {\n97:         generatedAt: skill.derivedGeneratedAt ?? projection.generatedAt,\n98:         now,\n99:         lifecycleStatus: skill.lifecycleStatus,\n100:       },\n101:     );\n102:     if (adjusted.score <= 0.05) continue;\n103:     matches.push({\n104:       skillId: skill.id,\n105:       lane: 'derived_generated',\n106:       score: Number((adjusted.score * (skill.derivedDemotion ?? 1)).toFixed(6)),\n107:       evidence: evidence.slice(0, 6),\n108:     });\n109:   }\n110: \n111:   return matches;\n112: }","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/lib/scorer/lanes/derived.ts, lines 1-112\n1: // ───────────────────────────────────────────────────────────────\n2: // MODULE: Derived Generated Lane\n3: // ───────────────────────────────────────────────────────────────\n4: \n5: // Pull the age-haircut policy from the scorer-local seam\n6: // instead of reaching into the lifecycle subsystem directly. The lifecycle\n7: // implementation stays the source of truth; the seam keeps the scorer's\n8: // dependency direction inward.\n9: import { applyAgeHaircutToLane } from '../age-policy.js';\n10: import type { NormalizedAffordance } from '../../affordance-normalizer.js';\n11: import type { AdvisorProjection, LaneMatch } from '../types.js';\n12: import { matchesPhraseBoundary, phraseSpecificity, scoreTokenOverlap, tokenizePrompt } from '../text.js';\n13: \n14: function affordancesForSkill(\n15:   affordances: readonly NormalizedAffordance[],\n16:   skillId: string,\n17: ): NormalizedAffordance[] {\n18:   return affordances.filter((affordance) => affordance.skillId === skillId);\n19: }\n20: \n21: // Doc-level harvest contribution is bounded twice: only the strongest\n22: // few docs count (so doc-heavy skills cannot outscore lean skills on\n23: // volume alone) and the summed contribution is capped below the level a\n24: // skill's own curated triggers can reach.\n25: const DOC_TOP_N = 3;\n26: const DOC_PHRASE_FACTOR = 0.5;\n27: const DOC_CONTRIBUTION_CAP = 0.45;\n28: \n29: interface DocMatch {\n30:   readonly docPath: string;\n31:   readonly score: number;\n32: }\n33: \n34: function scoreDocTriggers(\n35:   lower: string,\n36:   skill: AdvisorProjection['skills'][number],\n37: ): DocMatch[] {\n38:   const matches: DocMatch[] = [];\n39:   for (const doc of skill.docTriggers ?? []) {\n40:     let best = 0;\n41:     for (const phrase of doc.phrases) {\n42:       if (!matchesPhraseBoundary(lower, phrase)) continue;\n43:       best = Math.max(best, phraseSpecificity(phrase));\n44:     }\n45:     if (best <= 0) continue;\n46:     matches.push({ docPath: doc.docPath, score: best * doc.tierWeight });\n47:   }\n48:   return matches.sort((left, right) => right.score - left.score).slice(0, DOC_TOP_N);\n49: }\n50: \n51: export function scoreDerivedLane(\n52:   prompt: string,\n53:   projection: AdvisorProjection,\n54:   now: Date = new Date(),\n55:   affordances: readonly NormalizedAffordance[] = [],\n56: ): LaneMatch[] {\n57:   const lower = prompt.toLowerCase();\n58:   const tokens = tokenizePrompt(prompt);\n59:   const matches: LaneMatch[] = [];\n60: \n61:   for (const skill of projection.skills) {\n62:     const phrases = [...skill.derivedTriggers, ...skill.derivedKeywords];\n63:     const skillAffordances = affordancesForSkill(affordances, skill.id);\n64:     const affordancePhrases = skillAffordances.flatMap((affordance) => [...affordance.derivedTriggers]);\n65:     const docMatches = scoreDocTriggers(lower, skill);\n66:     if (phrases.length === 0 && affordancePhrases.length === 0 && docMatches.length === 0) continue;\n67:     const evidence: string[] = docMatches.map((doc) => `doc:${doc.docPath}`);\n68:     let score = Math.min(\n69:       docMatches.reduce((total, doc) => total + doc.score, 0) * DOC_PHRASE_FACTOR,\n70:       DOC_CONTRIBUTION_CAP,\n71:     );\n72:     for (const phrase of phrases) {\n73:       if (!matchesPhraseBoundary(lower, phrase)) continue;\n74:       score += phraseSpecificity(phrase) * 0.7;\n75:       evidence.push(`derived:${phrase}`);\n76:     }\n77:     for (const affordance of skillAffordances) {\n78:       let matched = false;\n79:       for (const phrase of affordance.derivedTriggers) {\n80:         if (!matchesPhraseBoundary(lower, phrase)) continue;\n81:         matched = true;\n82:         score += phraseSpecificity(phrase) * 0.45;\n83:       }\n84:       if (matched) evidence.push(affordance.evidenceLabel);\n85:     }\n86:     score += scoreTokenOverlap(tokens, phrases) * 0.45;\n87:     score += scoreTokenOverlap(tokens, affordancePhrases) * 0.25;\n88:     // Decay by the skill's own derived-content age — derivedGeneratedAt is the\n89:     // author/sync time of the derived block (author-time, not refreshed by\n90:     // rebuild; see SkillProjection.derivedGeneratedAt). The projection.generatedAt\n91:     // fallback is a last-resort, timestamp-less value (near-now on every run, so\n92:     // it exempts the skill from the haircut), used ONLY when a skill has no\n93:     // derived.generated_at — it is not a runtime freshness signal.\n94:     const adjusted = applyAgeHaircutToLane(\n95:       { trustLane: 'derived_generated', score: Math.min(score, 1) },\n96:       {\n97:         generatedAt: skill.derivedGeneratedAt ?? projection.generatedAt,\n98:         now,\n99:         lifecycleStatus: skill.lifecycleStatus,\n100:       },\n101:     );\n102:     if (adjusted.score <= 0.05) continue;\n103:     matches.push({\n104:       skillId: skill.id,\n105:       lane: 'derived_generated',\n106:       score: Number((adjusted.score * (skill.derivedDemotion ?? 1)).toFixed(6)),\n107:       evidence: evidence.slice(0, 6),\n108:     });\n109:   }\n110: \n111:   return matches;\n112: }"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/lib/scorer/lanes/derived.ts\"}"},"time":{"start":1794522186248,"end":1794522186718}}}}
