{"type":"tool_use","timestamp":1794521873939,"sessionID":"ses_e2e2a7dd5ffeKSW8P83xK0M1au","part":{"partID":"prt_1d1d6b7490018pZVnOoty2E4LA","sessionID":"ses_e2e2a7dd5ffeKSW8P83xK0M1au","messageID":"msg_1d1d6a62d001SJQ19pXna2Z6rh","type":"tool","id":"call_3f9d61e20d904afa95570aea","tool":"read","state":{"status":"completed","input":{"path":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/capture-command-routing-baseline.mjs","limit":150,"offset":340},"output":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/capture-command-routing-baseline.mjs, lines 340-489\n340: \n341: // ───────────────────────────────────────────────────────────────────\n342: // 6. CORE LOGIC\n343: // ───────────────────────────────────────────────────────────────────\n344: \n345: export async function scoreCommandCorpus(options = {}) {\n346:   const realEmbedding = options.realEmbedding === true;\n347:   const RealDate = Date;\n348:   // The projection needs an existing, empty cache directory, and that directory\n349:   // is scratch space this run owns. It is created before the `try` so a failure\n350:   // to create it has nothing left to remove, and removed in the `finally` so\n351:   // repeated captures do not leave one behind per run. A real capture reads the\n352:   // operator's own skill graph, so it owns no scratch directory and sweeps none.\n353:   const dbDir = realEmbedding ? null : mkdtempSync(join(tmpdir(), 'advisor-command-routing-'));\n354:   try {\n355:     // Environment projection. That empty directory makes the SQLite loader\n356:     // return null, so the projection is built from committed metadata alone,\n357:     // which is the only state a clean checkout can reproduce. A real capture reads\n358:     // the operator's own skill graph and embedder instead, so the three variables\n359:     // that select the projection are exactly the three it leaves unset.\n360:     if (!realEmbedding) {\n361:       process.env.SYSTEM_SKILL_ADVISOR_DB_DIR = dbDir;\n362:       process.env.SKILL_ADVISOR_DISABLE_BUILTIN_SEMANTIC = '1';\n363:       // Match the test-harness regime: the semantic-shadow lane substitutes\n364:       // deterministic fixture vectors under the harness flag (real embeddings are\n365:       // not reproducible in CI), so every scorer gate runs this way. The baseline\n366:       // must be captured under the same regime the ratchet re-scores it in.\n367:       process.env.VITEST = 'true';\n368:     }\n369:     process.env.SPECKIT_SKILL_ADVISOR_FORCE_LOCAL = '1';\n370:     process.env.PYTHONDONTWRITEBYTECODE = '1';\n371:     delete process.env.SPECKIT_ADVISOR_LANE_WEIGHTS_JSON;\n372:     delete process.env.SPECKIT_ADVISOR_LANE_SHADOW_WEIGHTS_JSON;\n373:     delete process.env.SPECKIT_ADVISOR_BM25_LEXICAL_SHADOW;\n374:     // Private `local-*` skills linked in through this variable live outside the\n375:     // checkout, so a baseline measured on a clean checkout must not see them.\n376:     delete process.env.SPECKIT_PRIVATE_SKILL_ROOTS;\n377: \n378:     // Pin the scoring clock to midnight UTC on the inherited scoring date.\n379:     const capturedAt = readPinnedScoringDate();\n380:     const scoringInstant = Date.parse(`${capturedAt}T00:00:00Z`);\n381:     globalThis.Date = class extends RealDate {\n382:       constructor(...args) {\n383:         if (args.length === 0) super(scoringInstant);\n384:         else super(...args);\n385:       }\n386: \n387:       static now() {\n388:         return scoringInstant;\n389:       }\n390:     };\n391: \n392:     if (!existsSync(FUSION_MODULE)) {\n393:       throw new Error(`built scorer file missing: ${FUSION_MODULE}`);\n394:     }\n395:     for (const modulePath of [COMMAND_ATTACH_MODULE, COMPILED_ROUTING_FLAG_MODULE]) {\n396:       if (!existsSync(modulePath)) {\n397:         throw new Error(`built command-attach file missing: ${modulePath}`);\n398:       }\n399:     }\n400: \n401:     // Imported after the clock is pinned so the compiled scorer initializes\n402:     // against the pinned date, and only after it is known to exist so a missing\n403:     // build is reported as such rather than as a module-resolution failure.\n404:     const { scoreAdvisorPrompt } = await import(pathToFileURL(FUSION_MODULE).href);\n405:     const { findAdvisorWorkspaceRoot } = await import(pathToFileURL(WORKSPACE_ROOT_MODULE).href);\n406:     const { attachCommand } = await import(pathToFileURL(COMMAND_ATTACH_MODULE).href);\n407:     const { COMPILED_ROUTING_HUBS } = await import(pathToFileURL(COMPILED_ROUTING_FLAG_MODULE).href);\n408:     const workspaceRoot = findAdvisorWorkspaceRoot(HERE, { maxDepth: 14, sentinel: SENTINEL });\n409: \n410:     // A missing front door would make every spawn fail and report the same zero\n411:     // as a hub with nothing to attach, so it fails the capture instead.\n412:     if (!existsSync(resolve(workspaceRoot, COMPILED_ROUTE_CLI))) {\n413:       throw new Error(`compiled route front door missing: ${resolve(workspaceRoot, COMPILED_ROUTE_CLI)}`);\n414:     }\n415: \n416:     // A build older than its source scores code that no longer exists, so its\n417:     // numbers would describe a scorer nobody can read. Refuse it, and likewise\n418:     // a build whose freshness cannot be assessed.\n419:     const { checkPackageFreshness } = createRequire(import.meta.url)(DIST_FRESHNESS_MODULE);\n420:     const freshness = checkPackageFreshness('system-skill-advisor/runtime', { workspaceRoot });\n421:     if (freshness.status !== 'fresh') {\n422:       throw new Error(freshness.message);\n423:     }\n424: \n425:     // Real scoring is the only mode that reads this machine, so it is the only one\n426:     // that has to prove the machine can answer before walking the corpus. Without\n427:     // the flag nothing here runs and the prompt embedding is the direct call below.\n428:     const embedPrompt = realEmbedding ? await prepareRealEmbeddingScoring() : null;\n429: \n430:     const commandNames = readCommandFileNames(workspaceRoot);\n431:     const commandSet = new Set(commandNames);\n432:     const { bridgeCounts, idToCommand } = readBridgeMap(BRIDGES_JSON);\n433:     const corpus = readCorpus(CORPUS_JSONL);\n434: \n435:     // A label naming a command that does not exist would silently score as a\n436:     // permanent miss, so it fails the capture instead of deflating a metric.\n437:     for (const row of corpus) {\n438:       if (row.expected_command === null || row.expected_command === undefined) continue;\n439:       if (!commandSet.has(row.expected_command)) {\n440:         throw new Error(`corpus row ${row.id} expects ${row.expected_command}, which is not a command file under ${resolve(workspaceRoot, COMMANDS_DIR)}`);\n441:       }\n442:     }\n443: \n444:     const perCommand = new Map();\n445:     for (const command of commandNames) {\n446:       perCommand.set(command, { typed: emptyTally(), plain: { tune: emptyTally(), holdout: emptyTally() } });\n447:     }\n448: \n449:     const typed = emptyTally();\n450:     const plain = { tune: emptyTally(), holdout: emptyTally() };\n451:     let falseOfferCount = 0;\n452:     let falseOfferTotal = 0;\n453:     let slashReachedTop3 = 0;\n454:     let slashNamedTotal = 0;\n455:     let slashOfferedOnPartial = 0;\n456:     let slashPartialTotal = 0;\n457:     let agreementCorrect = 0;\n458:     let agreementTotal = 0;\n459:     // Per-row results sit beside the totals because a total can hold still\n460:     // while one row is gained and another lost, and a changed label has to\n461:     // surface under the id of the row it belongs to.\n462:     const rows = {};\n463:     // Attached reach: what a hub's own route adds on the same rows, split the\n464:     // same way, plus the rows that had to stay silent and the ties a bridge\n465:     // leaves with its own owner.\n466:     const attachedRows = {};\n467:     const plainAttached = { tune: emptyAttachedTally(), holdout: emptyAttachedTally() };\n468:     const plainAttachedByFamily = new Map();\n469:     const sameOwnerAmbiguous = [];\n470:     let falseOfferAttached = 0;\n471: \n472:     for (const row of corpus) {\n473:       // The recommend path supplies the semantic lane's prompt vector through this\n474:       // wrapper, so a real capture threads the same path rather than scoring with\n475:       // the lane blind. Under the fixture regime the lane derives its own\n476:       // deterministic vector and the direct call is the whole behavior.\n477:       const score = () => scoreAdvisorPrompt(row.prompt, { workspaceRoot });\n478:       const result = embedPrompt === null ? score() : await embedPrompt(row.prompt, score);\n479:       const ids = recommendationIds(result);\n480:       const landed = ids.map((id) => commandOf(idToCommand, id));\n481:       const expected = row.expected_command ?? null;\n482:       const top1Hit = expected !== null && landed[0] === expected;\n483:       const top3Hit = expected !== null && landed.includes(expected);\n484:       const offered = landed.some((command) => command !== null);\n485:       const isPlainSplit = row.row_type === 'plain' && (row.split === 'tune' || row.split === 'holdout');\n486: \n487:       // A hub can name the slash command its route would take, which is reach a\n488:       // reader otherwise gets only by translating the workflow mode by hand.\n489:       const topId = ids[0];\n[Output truncated. Continue reading with offset: 490]","title":"read","metadata":{"metadata":{"truncated":true},"content":[{"type":"text","text":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/capture-command-routing-baseline.mjs, lines 340-489\n340: \n341: // ────────────────────────────────────────────────────────────────