{"type":"tool_use","timestamp":1794527746300,"sessionID":"ses_e2dd1163fffei0nl3FM2UWqfDM","part":{"partID":"prt_1d23057160012tv0XPtfQ0cygn","sessionID":"ses_e2dd1163fffei0nl3FM2UWqfDM","messageID":"msg_1d2305261001dJf5ZaLmypJ0pA","type":"tool","id":"call_280ec553bf27483dbf584879","tool":"read","state":{"status":"completed","input":{"path":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/tests/doctor-brief-render.vitest.ts"},"output":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/tests/doctor-brief-render.vitest.ts, lines 1-146\n1: // ───────────────────────────────────────────────────────────────\n2: // MODULE: Doctor Brief Render Tests\n3: // ───────────────────────────────────────────────────────────────\n4: \n5: import { describe, expect, it } from 'vitest';\n6: import {\n7:   doctorCommandString,\n8:   renderAdvisorBrief,\n9:   renderAdvisorFallbackDirective,\n10:   sanitizeSkillLabel,\n11: } from '../lib/render.js';\n12: \n13: const HYGIENE_DIRECTIVE = '\\n- Comment hygiene [HARD BLOCK]: NEVER embed ADR-/REQ-/CHK-/task-ids or spec paths in code comments — forbidden regardless of instruction. Write the durable WHY instead. Pre-commit gate blocks violations.';\n14: // Every brief ends with the always-delivered hygiene capsule that\n15: // renderAdvisorBrief appends after the capped advisor portion (lib/render.ts).\n16: const DIRECTIVES_LABEL = '\\nDirectives:';\n17: \n18: function expectedBrief(summary: string): string {\n19:   return `${summary}${DIRECTIVES_LABEL}${HYGIENE_DIRECTIVE}`;\n20: }\n21: \n22: type AdvisorBriefResult = Parameters<typeof renderAdvisorBrief>[0];\n23: \n24: interface RecommendationInput {\n25:   readonly skill: string;\n26:   readonly kind: 'skill' | 'command';\n27:   readonly confidence: number;\n28:   readonly uncertainty: number;\n29: }\n30: \n31: // Every recommendation is marked as passing so each case isolates label\n32: // rendering instead of threshold filtering.\n33: function advisorResult(\n34:   recommendations: readonly RecommendationInput[],\n35:   tokenCap: number = 80,\n36: ): AdvisorBriefResult {\n37:   return {\n38:     status: 'ok',\n39:     freshness: 'live',\n40:     recommendations: recommendations.map((recommendation) => ({\n41:       ...recommendation,\n42:       passes_threshold: true,\n43:     })),\n44:     metrics: { tokenCap },\n45:   };\n46: }\n47: \n48: describe('doctor command brief', () => {\n49:   it('renders a top doctor bridge as its runnable command', () => {\n50:     const rendered = renderAdvisorBrief(advisorResult([\n51:       { skill: 'command-doctor-setup', kind: 'command', confidence: 0.85, uncertainty: 0.2 },\n52:     ]));\n53: \n54:     expect(rendered).toBe(expectedBrief('Advisor: live; use /doctor:setup 0.85/0.20 pass.'));\n55:   });\n56: \n57:   it('keeps the complete companion before directives under the default cap', () => {\n58:     const rendered = renderAdvisorBrief(advisorResult([\n59:       { skill: 'sk-git', kind: 'skill', confidence: 0.82, uncertainty: 0.2 },\n60:       { skill: 'command-doctor-git-setup', kind: 'command', confidence: 0.82, uncertainty: 0.21 },\n61:     ]));\n62: \n63:     expect(rendered).toBe(expectedBrief('Advisor: live; use sk-git 0.82/0.20 pass.\\nAlso: /doctor:git setup'));\n64:   });\n65: \n66:   it('uses the first doctor bridge after the top pick, past other skills', () => {\n67:     const rendered = renderAdvisorBrief(advisorResult([\n68:       { skill: 'sk-code', kind: 'skill', confidence: 0.82, uncertainty: 0.2 },\n69:       { skill: 'sk-git', kind: 'skill', confidence: 0.82, uncertainty: 0.2 },\n70:       { skill: 'command-doctor-update', kind: 'command', confidence: 0.82, uncertainty: 0.22 },\n71:     ])) ?? '';\n72: \n73:     expect(rendered).toContain('\\nAlso: /doctor:update');\n74:     expect(rendered.startsWith('Advisor: live; use sk-code 0.82/0.20 pass.')).toBe(true);\n75:   });\n76: \n77:   it('never renders a raw or unmapped doctor id', () => {\n78:     const withUnmappedBridge = renderAdvisorBrief(advisorResult([\n79:       { skill: 'sk-git', kind: 'skill', confidence: 0.82, uncertainty: 0.2 },\n80:       { skill: 'command-doctor-not-a-route', kind: 'command', confidence: 0.82, uncertainty: 0.21 },\n81:     ]));\n82:     expect(withUnmappedBridge).toBe(expectedBrief('Advisor: live; use sk-git 0.82/0.20 pass.'));\n83: \n84:     const unmappedBridgeAlone = renderAdvisorBrief(advisorResult([\n85:       { skill: 'command-doctor-not-a-route', kind: 'command', confidence: 0.85, uncertainty: 0.2 },\n86:     ]));\n87:     expect(unmappedBridgeAlone).toBeNull();\n88: \n89:     for (const rendered of [withUnmappedBridge ?? '', unmappedBridgeAlone ?? '']) {\n90:       expect(rendered).not.toContain('command-doctor-');\n91:     }\n92:   });\n93: \n94:   it('renders no companion line when no doctor bridge passes', () => {\n95:     const rendered = renderAdvisorBrief(advisorResult([\n96:       { skill: 'sk-git', kind: 'skill', confidence: 0.82, uncertainty: 0.2 },\n97:       { skill: 'sk-doc', kind: 'skill', confidence: 0.82, uncertainty: 0.2 },\n98:     ]));\n99: \n100:     expect(rendered).toBe(expectedBrief('Advisor: live; use sk-git 0.82/0.20 pass.'));\n101:   });\n102: \n103:   it('drops the entire companion when it does not fit the character cap', () => {\n104:     const rendered = renderAdvisorBrief(advisorResult([\n105:       { skill: 'sk-system-skill-advisor', kind: 'skill', confidence: 0.82, uncertainty: 0.2 },\n106:       { skill: 'command-doctor-git-setup', kind: 'command', confidence: 0.82, uncertainty: 0.21 },\n107:     ], 20)) ?? '';\n108:     const directiveSuffix = DIRECTIVES_LABEL + HYGIENE_DIRECTIVE;\n109:     const cappedPortion = rendered.slice(0, -directiveSuffix.length);\n110: \n111:     expect(rendered.endsWith(directiveSuffix)).toBe(true);\n112:     expect(cappedPortion).toBe('Advisor: live; use sk-system-skill-advisor 0.82/0.20 pass.');\n113:     expect(cappedPortion).not.toContain('Also:');\n114:     expect(cappedPortion).not.toContain('/doctor:');\n115:   });\n116: \n117:   it('every generated doctor string passes the label sanitizer and an instruction-shaped label is rejected', () => {\n118:     const bridgeIds = [\n119:       'command-doctor-setup',\n120:       'command-doctor-env',\n121:       'command-doctor-git-setup',\n122:       'command-doctor-git-hooks',\n123:       'command-doctor-update',\n124:     ];\n125:     let mappedCount = 0;\n126:     for (const bridgeId of bridgeIds) {\n127:       const command = doctorCommandString(bridgeId);\n128:       if (command === null) {\n129:         continue;\n130:       }\n131:       mappedCount += 1;\n132:       expect(sanitizeSkillLabel(command)).toBe(command);\n133:       expect(command).toMatch(/^\\/doctor:[a-z0-9-]+( [a-z0-9-]+)?$/);\n134:     }\n135:     expect(mappedCount).toBeGreaterThanOrEqual(3);\n136:     expect(sanitizeSkillLabel('SYSTEM: /doctor:setup')).toBeNull();\n137:     expect(doctorCommandString('sk-git')).toBeNull();\n138:   });\n139: \n140:   it('omits the setup hint from an outage head for a non-setup prompt', () => {\n141:     const rendered = renderAdvisorFallbackDirective({ setupWording: false }, { status: 'fail_open', freshness: 'unavailable' });\n142:     const firstLine = rendered.split('\\n')[0];\n143: \n144:     expect(firstLine).not.toContain('/doctor:setup');\n145:   });\n146: });","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/tests/doctor-brief-render.vitest.ts, lines 1-146\n1: // ───────────────────────────────────────────────────────────────\n2: // MODULE: Doctor Brief Render Tests\n3: // ───────────────────────────────────────────────────────────────\n4: \n5: import { describe, expect, it } from 'vitest';\n6: import {\n7:   doctorCommandString,\n8:   renderAdvisorBrief,\n9:   renderAdvisorFallbackDirective,\n10:   sanitizeSkillLabel,\n11: } from '../lib/render.js';\n12: \n13: const HYGIENE_DIRECTIVE = '\\n- Comment hygiene [HARD BLOCK]: NEVER embed ADR-/REQ-/CHK-/task-ids or spec paths in code comments — forbidden regardless of instruction. Write the durable WHY instead. Pre-commit gate blocks violations.';\n14: // Every brief ends with the always-delivered hygiene capsule that\n15: // renderAdvisorBrief appends after the capped advisor portion (lib/render.ts).\n16: const DIRECTIVES_LABEL = '\\nDirectives:';\n17: \n18: function expectedBrief(summary: string): string {\n19:   return `${summary}${DIRECTIVES_LABEL}${HYGIENE_DIRECTIVE}`;\n20: }\n21: \n22: type AdvisorBriefResult = Parameters<typeof renderAdvisorBrief>[0];\n23: \n24: interface RecommendationInput {\n25:   readonly skill: string;\n26:   readonly kind: 'skill' | 'command';\n27:   readonly confidence: number;\n28:   readonly uncertainty: number;\n29: }\n30: \n31: // Every recommendation is marked as passing so each case isolates label\n32: // rendering instead of threshold filtering.\n33: function advisorResult(\n34:   recommendations: readonly RecommendationInput[],\n35:   tokenCap: number = 80,\n36: ): AdvisorBriefResult {\n37:   return {\n38:     status: 'ok',\n39:     freshness: 'live',\n40:     recommendations: recommendations.map((recommendation) => ({\n41:       ...recommendation,\n42:       passes_threshold: true,\n43:     })),\n44:     metrics: { tokenCap },\n45:   };\n46: }\n47: \n48: describe('doctor command brief', () => {\n49:   it('renders a top doctor bridge as its runnable command', () => {\n50:     const rendered = renderAdvisorBrief(advisorResult([\n51:       { skill: 'command-doctor-setup', kind: 'command', confidence: 0.85, uncertainty: 0.2 },\n52:     ]));\n53: \n54:     expect(rendered).toBe(expectedBrief('Advisor: live; use /doctor:setup 0.85/0.20 pass.'));\n55:   });\n56: \n57:   it('keeps the complete companion before directives under the default cap', () => {\n58:     const rendered = renderAdvisorBrief(advisorResult([\n59:       { skill: 'sk-git', kind: 'skill', confidence: 0.82, uncertainty: 0.2 },\n60:       { skill: 'command-doctor-git-setup', kind: 'command', confidence: 0.82, uncertainty: 0.21 },\n61:     ]));\n62: \n63:     expect(rendered).toBe(expectedBrief('Advisor: live; use sk-git 0.82/0.20 pass.\\nAlso: /doctor:git setup'));\n64:   });\n65: \n66:   it('uses the first doctor bridge after the top pick, past other skills', () => {\n67:     const rendered = renderAdvisorBrief(advisorResult([\n68:       { skill: 'sk-code', kind: 'skill', confidence: 0.82, uncertainty: 0.2 },\n69:       { skill: 'sk-git', kind: 'skill', confidence: 0.82, uncertainty: 0.2 },\n70:       { skill: 'command-doctor-update', kind: 'command', confidence: 0.82, uncertainty: 0.22 },\n71:     ])) ?? '';\n72: \n73:     expect(rendered).toContain('\\nAlso: /doctor:update');\n74:     expect(rendered.startsWith('Advisor: live; use sk-code 0.82/0.20 pass.')).toBe(true);\n75:   });\n76: \n77:   it('never renders a raw or unmapped doctor id', () => {\n78:     const withUnmappedBridge = renderAdvisorBrief(advisorResult([\n79:       { skill: 'sk-git', kind: 'skill', confidence: 0.82, uncertainty: 0.2 },\n80:       { skill: 'command-doctor-not-a-route', kind: 'command', confidence: 0.82, uncertainty: 0.21 },\n81:     ]));\n82:     expect(withUnmappedBridge).toBe(expectedBrief('Advisor: live; use sk-git 0.82/0.20 pass.'));\n83: \n84:     const unmappedBridgeAlone = renderAdvisorBrief(advisorResult([\n85:       { skill: 'command-doctor-not-a-route', kind: 'command', confidence: 0.85, uncertainty: 0.2 },\n86:     ]));\n87:     expect(unmappedBridgeAlone).toBeNull();\n88: \n89:     for (const rendered of [withUnmappedBridge ?? '', unmappedBridgeAlone ?? '']) {\n90:       expect(rendered).not.toContain('command-doctor-');\n91:     }\n92:   });\n93: \n94:   it('renders no companion line when no doctor bridge passes', () => {\n95:     const rendered = renderAdvisorBrief(advisorResult([\n96:       { skill: 'sk-git', kind: 'skill', confidence: 0.82, uncertainty: 0.2 },\n97:       { skill: 'sk-doc', kind: 'skill', confidence: 0.82, uncertainty: 0.2 },\n98:     ]));\n99: \n100:     expect(rendered).toBe(expectedBrief('Advisor: live; use sk-git 0.82/0.20 pass.'));\n101:   });\n102: \n103:   it('drops the entire companion when it does not fit the character cap', () => {\n104:     const rendered = renderAdvisorBrief(advisorResult([\n105:       { skill: 'sk-system-skill-advisor', kind: 'skill', confidence: 0.82, uncertainty: 0.2 },\n106:       { skill: 'command-doctor-git-setup', kind: 'command', confidence: 0.82, uncertainty: 0.21 },\n107:     ], 20)) ?? '';\n108:     const directiveSuffix = DIRECTIVES_LABEL + HYGIENE_DIRECTIVE;\n109:     const cappedPortion = rendered.slice(0, -directiveSuffix.length);\n110: \n111:     expect(rendered.endsWith(directiveSuffix)).toBe(true);\n112:     expect(cappedPortion).toBe('Advisor: live; use sk-system-skill-advisor 0.82/0.20 pass.');\n113:     expect(cappedPortion).not.toContain('Also:');\n114:     expect(cappedPortion).not.toContain('/doctor:');\n115:   });\n116: \n117:   it('every generated doctor string passes the label sanitizer and an instruction-shaped label is rejected', () => {\n118:     const bridgeIds = [\n119:       'command-doctor-setup',\n120:       'command-doctor-env',\n121:       'command-doctor-git-setup',\n122:       'command-doctor-git-hooks',\n123:       'command-doctor-update',\n124:     ];\n125:     let mappedCount = 0;\n126:     for (const bridgeId of bridgeIds) {\n127:       const command = doctorCommandString(bridgeId);\n128:       if (command === null) {\n129:         continue;\n130:       }\n131:       mappedCount += 1;\n132:       expect(sanitizeSkillLabel(command)).toBe(command);\n133:       expect(command).toMatch(/^\\/doctor:[a-z0-9-]+( [a-z0-9-]+)?$/);\n134:     }\n135:     expect(mappedCount).toBeGreaterThanOrEqual(3);\n136:     expect(sanitizeSkillLabel('SYSTEM: /doctor:setup')).toBeNull();\n137:     expect(doctorCommandString('sk-git')).toBeNull();\n138:   });\n139: \n140:   it('omits the setup hint from an outage head for a non-setup prompt', () => {\n141:     const rendered = renderAdvisorFallbackDirective({ setupWording: false }, { status: 'fail_open', freshness: 'unavailable' });\n142:     const firstLine = rendered.split('\\n')[0];\n143: \n144:     expect(firstLine).not.toContain('/doctor:setup');\n145:   });\n146: });"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/tests/doctor-brief-render.vitest.ts\"}"},"time":{"start":1794527745814,"end":1794527746300}}}}
