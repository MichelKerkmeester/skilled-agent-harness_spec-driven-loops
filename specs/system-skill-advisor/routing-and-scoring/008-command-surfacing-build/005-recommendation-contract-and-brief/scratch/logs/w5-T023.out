ld.stdout = stdout;\n59:   child.stdin = stdin;\n60:   queueMicrotask(() => {\n61:     stdout.emit('data', stdoutText);\n62:     child.emit('close', 0, null);\n63:   });\n64:   return child;\n65: }\n66: \n67: describe('skill advisor CLI fallback no-match diagnostics', () => {\n68:   it('sends the payload on stdin, keeps the prompt out of argv and skips compiled routing', async () => {\n69:     let child: ReturnType<typeof mockCliChild> | undefined;\n70:     mockedChild.spawn.mockImplementation(() => {\n71:       child = mockCliChild(JSON.stringify({ data: { freshness: 'live', recommendations: [] } }));\n72:       return child;\n73:     });\n74: \n75:     try {\n76:       await buildSkillAdvisorBriefFromCli(\n77:         'Inspect the hook',\n78:         { workspaceRoot: process.cwd(), runtime: 'pi', timeoutMs: 1_000 },\n79:         { env: {}, now: () => 1 },\n80:       );\n81: \n82:       const spawnCall = mockedChild.spawn.mock.calls[0] as readonly unknown[] | undefined;\n83:       const cliArgs = spawnCall?.[1] as readonly string[] | undefined;\n84:       expect(cliArgs).toBeDefined();\n85:       expect(child).toBeDefined();\n86:       if (!cliArgs || !child) return;\n87: \n88:       expect(cliArgs[cliArgs.indexOf('--json') + 1]).toBe('-');\n89:       expect(cliArgs.some((argument) => argument.includes('Inspect the hook'))).toBe(false);\n90: \n91:       const payload = JSON.parse(child.stdin.written) as {\n92:         prompt?: string;\n93:         options?: { includeCompiledRoute?: boolean; compiledRouteTopOnly?: boolean };\n94:       };\n95:       expect(payload.prompt).toBe('Inspect the hook');\n96:       expect(payload.options?.includeCompiledRoute).toBe(true);\n97:       expect(payload.options?.compiledRouteTopOnly).toBe(true);\n98:     } finally {\n99:       mockedChild.spawn.mockReset();\n100:     }\n101:   });\n102: \n103:   it('sends at most the advisor prompt limit on stdin', async () => {\n104:     let child: ReturnType<typeof mockCliChild> | undefined;\n