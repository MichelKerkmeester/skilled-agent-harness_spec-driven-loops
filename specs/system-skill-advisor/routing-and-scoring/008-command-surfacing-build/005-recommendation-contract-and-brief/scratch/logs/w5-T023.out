tics', () => {\n149:     const result = build({ freshness: 'live', recommendations: [PASSING_RECOMMENDATION] });\n150: \n151:     expect(result.status).toBe('ok');\n152:     expect(result.diagnostics).toBeNull();\n153:   });\n154: \n155:   it('carries the command a recommendation names through to the hook result', () => {\n156:     const carried = resultFromCliData({\n157:       data: {\n158:         freshness: 'live',\n159:         recommendations: [\n160:           { skillId: 'sk-doc', confidence: 0.95, uncertainty: 0.1, command: '/create:readme' },\n161:           { skillId: 'sk-git', confidence: 0.9, uncertainty: 0.1, command: '   ' },\n162:           { skillId: 'sk-code', confidence: 0.9, uncertainty: 0.1 },\n163:         ],\n164:       } as never,\n165:       options: OPTIONS,\n166:       startedAt: 0,\n167:       now: () => 1,\n168:     }) as unknown as { recommendations: Array<{ skill: string; command?: string }> };\n169: \n170:     const bySkill = new Map(carried.recommendations.map((row) => [row.skill, row]));\n171:     expect(bySkill.get('sk-doc')?.command).toBe('/create:readme');\n172:     // A blank command would render an empty prompt, so it is dropped with the key.\n173:     expect(bySkill.get('sk-git')).toBeDefined();\n174:     expect('command' in (bySkill.get('sk-git') ?? {})).toBe(false);\n175:     expect('command' in (bySkill.get('sk-code') ?? {})).toBe(false);\n176:   });\n177: });"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/tests/hooks/skill-advisor-cli-fallback-no-match.vitest.ts\"}"},"time":{"start":1794527717353,"end":1794527717864}}}}
