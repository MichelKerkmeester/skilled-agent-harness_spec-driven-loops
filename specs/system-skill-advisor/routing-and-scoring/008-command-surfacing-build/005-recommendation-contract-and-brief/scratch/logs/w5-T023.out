\n-rw-r--r--@  1 michelkerkmeester  staff   1356 Nov 12 10:24 README.md\n-rw-r--r--@  1 michelkerkmeester  staff   4433 Nov 12 10:24 runtime-parity.vitest.ts\n-rw-r--r--@  1 michelkerkmeester  staff  12120 Nov 12 10:24 settings-driven-invocation-parity.vitest.ts\n-rw-r--r--@  1 michelkerkmeester  staff   1437 Nov 12 10:24 skill-advisor-cli-fallback-envelope.vitest.ts\n-rw-r--r--@  1 michelkerkmeester  staff   6500 Nov 12 21:10 skill-advisor-cli-fallback-no-match.vitest.ts\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"ls -la .skilled/skills/system-skill-advisor/hooks/lib/ .skilled/skills/system-skill-advisor/runtime/tests/hooks/\"}"},"time":{"start":1794527705577,"end":1794527705611}}}}
