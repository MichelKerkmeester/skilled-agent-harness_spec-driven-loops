nitizeSkillLabel(policy);\n200:   return policyPart === null\n201:     ? `${ownerPart} → ${commandPart}`\n202:     : `${ownerPart} → ${commandPart} (${policyPart})`;\n203: }\n204: \n205: // A doctor bridge renders as its runnable command and never as its raw id; an\n206: // unmapped doctor id renders nothing.\n207: function recommendationLabel(recommendation: RenderableRecommendation): string | null {\n208:   return commandLabel(recommendation)\n209:     ?? (isDoctorBridgeId(recommendation.skill)\n210:       ? doctorCommandString(recommendation.skill)\n211:       : sanitizeSkillLabel(recommendation.skill));\n212: }\n213: \n214: function formatScore(value: number): string {\n215:   return Number.isFinite(value) ? value.toFixed(2) : '0.00';\n216: }\n217: \n218: type RenderableRecommendation = AdvisorRecommendation & {\n219:   readonly score?: number;\n220:   readonly ambiguousWith?: readonly string[];\n221:   readonly heldBelow?: string;\n222: };\n223: \n224: function toScoredRecommendation(recommendation: RenderableRecommendation): AdvisorScoredRecommendation {\n225:   return {\n226:     skill: recommendation.skill,\n227:     kind: recommendation.kind === 'command' ? 'command' : 'skill',\n228:     confidence: recommendation.confidence,\n229:     uncertainty: recommendation.uncertainty,\n230:     passes_threshold: recommendation.passes_threshold ?? true,\n231:     reason: '',\n232:     score: typeof recommendation.score === 'number' && Number.isFinite(recommendation.score)\n233:       ? recommendation.score\n234:       : recommendation.confidence,\n235:     laneContributions: [],\n236:     dominantLane: null,\n237:     lifecycleStatus: 'active',\n238:     ...(Array.isArray(recommendation.ambiguousWith) ? { ambiguousWith: recommendation.ambiguousWith } : {}),\n239:     ...(typeof recommendation.heldBelow === 'string' ? { heldBelow: recommendation.heldBelow } : {}),\n[Output truncated. Continue reading with offset: 240]"}],"providerCall":{"executed":false},"providerResu