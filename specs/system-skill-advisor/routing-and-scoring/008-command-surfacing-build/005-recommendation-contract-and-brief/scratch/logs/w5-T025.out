,\n26:     'sk-create-diff': '/create:diff',\n27:     'sk-create-feature-catalog': '/create:feature-catalog',\n28:     'sk-create-goal': '/create:goal',\n29:     'sk-create-manual-testing-playbook': '/create:manual-testing-playbook',\n30:     'sk-create-readme': '/create:readme',\n31:     'sk-create-repo-rule': '/create:repo-rule',\n32:     'sk-create-skill': '/create:skill',\n33:     'sk-create-skill-parent': '/create:skill-parent',\n34:     'sk-create-with-human-voice': '/create:with-human-voice',\n35:   },\n36:   'system-deep-loop': {\n37:     'ai-council': '/deep:ai-council',\n38:     'research': '/deep:research',\n39:     'review': '/deep:review',\n40:   },\n41: };\n42: // END GENERATED MODE COMMANDS\n43: \n44: // One row of the command table: the runnable slash command, the policy that says\n45: // whether it runs, asks or starts a session, and the skill that owns it. The\n46: // rows are generated, so only the shape lives here.\n47: export interface CommandRow {\n48:   readonly command: string;\n49:   readonly policy?: 'run' | 'start' | 'ask';\n50:   readonly ownerSkillId: string;\n51: }\n52: \n53: // BEGIN GENERATED COMMAND ROWS\n54: export const COMMAND_ROWS: Readonly<Record<string, CommandRow>> = {\n55:   'command-create-agent': { command: '/create:agent', policy: 'start', ownerSkillId: 'sk-doc' },\n56:   'command-create-changelog': { command: '/create:changelog', policy: 'ask', ownerSkillId: 'sk-doc' },\n57:   'command-create-feature-catalog': { command: '/create:feature-catalog', policy: 'start', ownerSkillId: 'sk-doc' },\n58:   'command-create-manual-testing-playbook': { command: '/create:manual-testing-playbook', policy: 'start', ownerSkillId: 'sk-doc' },\n59:   'command-create-readme': { command: '/create:readme', policy: 'start', ownerSkillId: 'sk-doc' },\n60:   'command-create-skill': { command: '/create:skill', policy: 'start', ownerSkillId: 'sk-doc' },\n[Output truncated. Continue reading with offset: 61]","title":"read","metadata":{"metadata":{"truncated":true},"content":[{"type":"text","text":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/lib/command-attach.ts, lines 1-60\n1: // ───────────────────────────────────────────────────────────────\n2: // MODULE: Slash command attached to a hub's recommendation\n3: // ───────────────────────────────────────────────────────────────\n4: //\n5: // The advisor can name the workflow mode a hub would route a prompt to, but the\n6: // reader still has to translate that mode into the slash command that acts on\n7: // it. This module owns that translation and nothing else, kept free of imports\n8: // so the recommend path and a test read the same semantics.\n9: //\n10: // The mode-to-command table is generated rather than hand-maintained: each row is\n11: // derived from a hub's own command files, so a hub that adds or renames a mode\n12: // regenerates its row instead of drifting from a copy someone forgot to update.\n13: \n14: // BEGIN GENERATED MODE COMMANDS\n15: export const MODE_COMMANDS: Readonly<Record<string, Readonly<Record<string, string>>>> = {\n16:   'sk-design': {\n17:     'sk-design-chart': '/design:chart',\n18:     'sk-design-diagram': '/design:diagram',\n19:     'sk-design-md-generator': '/design:extract',\n20:   },\n21:   'sk-doc': {\n22:     'sk-create-agent': '/create:agent',\n23:     'sk-create-benchmark': '/create:benchmark',\n24:     'sk-create-changelog': '/create:changelog',\n25:     'sk-create-command': '/create:command',\n26:     'sk-create-diff': '/create:diff',\n27:     'sk-create-feature-catalog': '/create:feature-catalog',\n28:     'sk-create-goal': '/create:goal',\n29:     'sk-create-manual-testing-playbook': '/create:manual-testing-playbook',\n30:     'sk-create-readme': '/create:readme',\n31:     'sk-create-repo-rule': '/create:repo-rule',\n32:     'sk-create-skill': '/create:skill',\n33:     'sk-create-skill-parent': '/create:skill-parent',\n34:     'sk-create-with-human-voice': '/create:with-human-voice',\n35:   },\n36:   'system-deep-loop': {\n37:     'ai-council': '/deep:ai-council',\n38:     'research': '/deep:research',\n39:     'review': '/deep:review',\n40:   },\n41: };\n42: // END GENERATED MODE COMMANDS\n43: \n44: // One row of the command table: the runnable slash command, the policy that says\n45: // whether it runs, asks or starts a session, and the skill that owns it. The\n46: // rows are generated, so only the shape lives here.\n47: export interface CommandRow {\n48:   readonly command: string;\n49:   readonly policy?: 'run' | 'start' | 'ask';\n50:   readonly ownerSkillId: string;\n51: }\n52: \n53: // BEGIN GENERATED COMMAND ROWS\n54: export const COMMAND_ROWS: Readonly<Record<string, CommandRow>> = {\n55:   'command-create-agent': { command: '/create:agent', policy: 'start', ownerSkillId: 'sk-doc' },\n56:   'command-create-changelog': { command: '/create:changelog', policy: 'ask', ownerSkillId: 'sk-doc' },\n57:   'command-create-feature-catalog': { command: '/create:feature-catalog', policy: 'start', ownerSkillId: 'sk-doc' },\n58:   'command-create-manual-testing-playbook': { command: '/create:manual-testing-playbook', policy: 'start', ownerSkillId: 'sk-doc' },\n59:   'command-create-readme': { command: '/create:readme', policy: 'start', ownerSkillId: 'sk-doc' },\n60:   'command-create-skill': { command: '/create:skill', policy: 'start', ownerSkillId: 'sk-doc' },\n[Output truncated. Continue reading with offset: 61]"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"limit\":60,\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/lib/command-attach.ts\"}"},"time":{"start":1794527774761,"end":1794527775064}}}}
