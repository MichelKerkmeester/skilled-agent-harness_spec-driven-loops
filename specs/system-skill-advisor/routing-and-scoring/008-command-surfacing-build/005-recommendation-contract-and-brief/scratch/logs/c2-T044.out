ed to be unambiguously ranked.\\n22: //\\n23: // One exception: a skill the typed-command bound capped just below the top\\n24: // (`heldBelow` names the top) sits close to it only because of that cap, and the\\n25: // cap already ranked the pair from the user's ow...\n  Line 8: {\"type\":\"tool_use\",\"timestamp\":1794530063750,\"sessionID\":\"ses_e2dad3a2dffe46l7KA6EEh2b1G\",\"part\":{\"partID\":\"prt_1d253b1d0001AXfC4xQNwrhf3w\",\"sessionID\":\"ses_e2dad3a2dffe46l7KA6EEh2b1G\",\"messageID\":\"msg_1d253918e0019DeXOJDz6mA7OY\",\"type\":\"tool\",\"id\":\"call_483487b169ed4a08b7da9459\",\"tool\":\"grep\",\"state\":{\"status\":\"completed\",\"input\":{\"pattern\":\"confidenceFloored\",\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime\",\"include\":\"*.ts\"},\"output\":\"Found 11 matches\\n/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/lib/scorer/ambiguity.ts:\\n  Line 72:     && recommendation.confidenceFloored === true\\n\\n  Line 73:     && top.confidenceFloored !== true;\\n\\n\\n/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/lib/scorer/fusion.ts:\\n  Line 1274:     let confidenceFloored = confidenceResult.floored;\\n\\n  Line 1277:       if (clamped < confidence) confidenceFloored = false;\\n\\n  Line 1291:       ...(confidenceFloored ? { confidenceFloored: true } : {}),\\n\\n\\n/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/lib/scorer/types.ts:\\n  Line 174:   readonly confidenceFloored?: boolean;\\n\\n\\n/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/tests/scorer/advisor-quality-049-003.vitest.ts:\\n  Line 295:         confidenceFloored: true,\\n\\n  Line 309:         confidenceFloored: true,\\n\\n  Line 31