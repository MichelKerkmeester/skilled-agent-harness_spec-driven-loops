aterThan(skCodeReviewExplicitScore);\n386:     }\n387:   });\n388: \n389:   it('does not fire on pure review prompts (no write verb)', () => {\n[Output truncated. Continue reading with offset: 390]"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/tests/scorer/advisor-quality-049-003.vitest.ts\",\"offset\":250,\"limit\":140}"},"time":{"start":1794530066907,"end":1794530067580}}}}
