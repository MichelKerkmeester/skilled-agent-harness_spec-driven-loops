0.560, confidence: 0.8235, passes_threshold: true }),\n291:       recommendation({\n292:         skill: 'floored',\n293:         score: 0.200,\n294:         confidence: 0.820,\n295:         confidenceFloored: true,\n296:         passes_threshold: true,\n297:       }),\n298:     ];\n299: \n300:     expect(isAmbiguousTopTwo(recommendations)).toBe(false);\n301:   });\n302: \n303:   it('clusters the same pair when the top cleared a floor too', () => {\n304:     const recommendations: AdvisorScoredRecommendation[] = [\n305:       recommendation({\n306:         skill: 'top',\n307:         score: 0.560,\n308:         confidence: 0.820,\n309:         confidenceFloored: true,\n310:         passes_threshold: true,\n311:       }),\n312:       recommendation({\n313:         skill: 'floored',\n314:         score: 0.200,\n315:         confidence: 0.820,\n316:         confidenceFloored: true,\n317:         passes_threshold: true,\n318:       }),\n319:     ];\n320: \n321:     expect(isAmbiguousTopTwo(recommendations)).toBe(true);\n322:   });\n323: \n324:   it('still clusters a floor-only member whose score is inside the score margin', () => {\n325:     const recommendations: AdvisorScoredRecommendation[] = [\n326:       recommendation({ skill: 'top', score: 0.560, confidence: 0.8235, passes_threshold: true }),\n327:       recommendation({\n328:         skill: 'floored',\n329:         score: 0.530,\n330:         confidence: 0.820,\n331:         confidenceFloored: true,\n332:         passes_threshold: true,\n333:       }),\n334:     ];\n335: \n336:     expect(isAmbiguousTopTwo(recommendations)).toBe(true);\n337:   });\n338: \n339:   it('keeps the floor-only member in the wide ambiguity set', () => {\n340:     // The abstention path reads the wide set, so a member the floor exception\n341:     // dropped from the visible cluster must still be reported there.\n342:     const recommendations: AdvisorScoredRecommendation[] = [\n343:       recommendation({ skill: 'top', score: 0.560, conf