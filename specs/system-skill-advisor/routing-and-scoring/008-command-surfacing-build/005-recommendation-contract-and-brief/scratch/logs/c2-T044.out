/ ───────────────────────────────────────────────────────────────\\n4: \\n5: import { COMMAND_BRIDGES } from './projection.js';\\n6: import type { AdvisorScoredRecommendation } from './types.js';\\n7: \\n8: export const AMBIGUITY_MARGIN = 0.05;\\n9: export const AMBIGUITY_CONFIDENCE_MARGIN = 0.05;\\n10: \\n11: // Compute ambiguity from ranking `score` so the cluster aligns\\n12: // with the score-based fusion ranking (top-two-by-confidence may not match\\n13: // top-two-by-score).\\n14: //\\n15: // Also compute on `confidence` and union the two\\n16: // clusters. Score-margin keeps ranking alignment; confidence-margin restores\\n17: // the documented \\\"0.05 confidence window\\\" and catches\\n18: // cross-domain prompts where confidence is near-tied (user-visible signal)\\n19: // even when score gaps just exceed the score margin. A candidate is in the\\n20: // ambiguity cluster when EITHER gap is within its respective 0.05 margin —\\n21: // \\\"outside both margins\\\" is required to be unambiguously ranked.\\n22: //\\n23: // One exception: a skill the typed-command bound capped just below the top\\n24: // (`heldBelow` names the top) sits close to it only because of that cap, and the\\n25: // cap already ranked the pair from the user's ow...\n  Line 8: {\"type\":\"tool_use\",\"timestamp\":1794530063750,\"sessionID\":\"ses_e2dad3a2dffe46l7KA6EEh2b1G\",\"part\":{\"partID\":\"prt_1d253b1d0001AXfC4xQNwrhf3w\",\"sessionID\":\"ses_e2dad3a2dffe46l7KA6EEh2b1G\",\"messageID\":\"msg_1d253918e0019DeXOJDz6mA7OY\",\"type\":\"tool\",\"id\":\"call_483487b169ed4a08b7da9459\",\"tool\":\"grep\",\"state\":{\"status\":\"completed\",\"input\":{\"pattern\":\"confidenceFloored\",\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime\",\"include\":\"*.ts\"},\"output\":\"Found 11 matches\\n/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/lib/scorer