oreGap = Math.abs(top.score - recommendation.score);\n   if (scoreGap <= AMBIGUITY_MARGIN + Number.EPSILON) return true;\n-  // A floor pins many unrelated skills to the same confidence, which is not a\n-  // tie with a top that earned its confidence from its own evidence.\n-  const floorOnlyMember = applyFloorException\n-    && recommendation.confidenceFloored === true\n-    && top.confidenceFloored !== true;\n-  if (floorOnlyMember) return false;\n+  // The score margin already failed, so a floored member has nothing left to\n+  // cluster on. Its confidence is the floor, not its own evidence.\n+  const flooredMember = applyFloorException && recommendation.confidenceFloored === true;\n+  if (flooredMember) return false;\n   return Math.abs(top.confidence - recommendation.confidence)\n     <= AMBIGUITY_CONFIDENCE_MARGIN + Number.EPSILON;\n }\ndiff --git a/.skilled/skills/system-skill-advisor/runtime/tests/scorer/advisor-quality-049-003.vitest.ts b/.skilled/skills/system-skill-advisor/runtime/tests/scorer/advisor-quality-049-003.vitest.ts\nindex 12e98f14db..0863016af4 100644\n--- a/.skilled/skills/system-skill-advisor/runtime/tests/scorer/advisor-quality-049-003.vitest.ts\n+++ b/.skilled/skills/system-skill-advisor/runtime/tests/scorer/advisor-quality-049-003.vitest.ts\n@@ -300,7 +300,7 @@ describe('F-012-C2-04 ambiguity tie-cluster computation', () => {\n     expect(isAmbiguousTopTwo(recommendations)).toBe(false);\n   });\n \n-  it('clusters the same pair when the top cleared a floor too', () => {\n+  it('does not cluster two floored candidates whose scores are outside the margin', () => {\n     const recommendations: AdvisorScoredRecommendation[] = [\n       recommendation({\n         skill: 'top',\n@@ -318,7 +318,7 @@ describe('F-012-C2-04 ambiguity tie-cluster computation', () => {\n       }),\n     ];\n \n-    expect(isAmbiguousTopTwo(recommendations)).toBe(true);\n+    expect(isAmbiguousTopTwo(recommendations)).toBe(false);\n   });\n \n   it('still clusters a 