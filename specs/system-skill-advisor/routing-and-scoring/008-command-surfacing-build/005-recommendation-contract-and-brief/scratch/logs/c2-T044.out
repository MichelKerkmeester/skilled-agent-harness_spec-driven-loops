{"type":"tool_use","timestamp":1794530053234,"sessionID":"ses_e2dad3a2dffe46l7KA6EEh2b1G","part":{"partID":"prt_1d2538ae7002eWMrvPzavYnAdl","sessionID":"ses_e2dad3a2dffe46l7KA6EEh2b1G","messageID":"msg_1d2537b45001uu2QAwY2nPSAJq","type":"tool","id":"call_2bf289feb85544cfb919ab4c","tool":"read","state":{"status":"completed","input":{"path":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/lib/scorer/ambiguity.ts"},"output":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/lib/scorer/ambiguity.ts, lines 1-125\n1: // ───────────────────────────────────────────────────────────────\n2: // MODULE: Advisor Ambiguity\n3: // ───────────────────────────────────────────────────────────────\n4: \n5: import { COMMAND_BRIDGES } from './projection.js';\n6: import type { AdvisorScoredRecommendation } from './types.js';\n7: \n8: export const AMBIGUITY_MARGIN = 0.05;\n9: export const AMBIGUITY_CONFIDENCE_MARGIN = 0.05;\n10: \n11: // Compute ambiguity from ranking `score` so the cluster aligns\n12: // with the score-based fusion ranking (top-two-by-confidence may not match\n13: // top-two-by-score).\n14: //\n15: // Also compute on `confidence` and union the two\n16: // clusters. Score-margin keeps ranking alignment; confidence-margin restores\n17: // the documented \"0.05 confidence window\" and catches\n18: // cross-domain prompts where confidence is near-tied (user-visible signal)\n19: // even when score gaps just exceed the score margin. A candidate is in the\n20: // ambiguity cluster when EITHER gap is within its respective 0.05 margin —\n21: // \"outside both margins\" is required to be unambiguously ranked.\n22: //\n23: // One exception: a skill the typed-command bound capped just below the top\n24: // (`heldBelow` names the top) sits close to it only because of that cap, and the\n25: // cap already ranked the pair from the user's own command. Counting that gap as\n26: // a tie would report the explicit command as a coin flip. Two skills close on\n27: // their own evidence still cluster.\n28: //\n29: // The confidence margin has one exception of its own: when the top earned its\n30: // confidence from its own evidence, a member whose confidence only reached a\n31: // floor clusters on the score margin alone.\n32: \n33: // A command bridge row and the skill that owns that command are one answer, so\n34: // their near-tie is a single route rather than a choice between two. Two\n35: // different skills, or a command row and a skill that does not own it, stay a\n36: // real tie.\n37: \n38: // The owner comes from the generated bridge data, never from the shape of an\n39: // id: a bridge id says nothing reliable about which skill runs the command.\n40: const OWNER_BY_BRIDGE_ID: ReadonlyMap<string, string> = new Map(\n41:   COMMAND_BRIDGES.flatMap((bridge) => (bridge.ownerSkill ? [[bridge.id, bridge.ownerSkill] as const] : [])),\n42: );\n43: \n44: function ownsCommandBridge(skillId: string, bridgeId: string): boolean {\n45:   return OWNER_BY_BRIDGE_ID.get(bridgeId) === skillId;\n46: }\n47: \n48: function answersSameRoute(\n49:   top: AdvisorScoredRecommendation,\n50:   recommendation: AdvisorScoredRecommendation,\n51: ): boolean {\n52:   if (top.kind === 'command' && recommendation.kind === 'skill') {\n53:     return ownsCommandBridge(recommendation.skill, top.skill);\n54:   }\n55:   if (top.kind === 'skill' && recommendation.kind === 'command') {\n56:     return ownsCommandBridge(top.skill, recommendation.skill);\n57:   }\n58:   return false;\n59: }\n60: \n61: function clustersWithTop(\n62:   top: AdvisorScoredRecommendation,\n63:   recommendation: AdvisorScoredRecommendation,\n64:   applyFloorException: boolean,\n65: ): boolean {\n66:   if (recommendation !== top && recommendation.heldBelow === top.skill) return false;\n67:   const scoreGap = Math.abs(top.score - recommendation.score);\n68:   if (scoreGap <= AMBIGUITY_MARGIN + Number.EPSILON) return true;\n69:   // A floor pins many unrelated skills to the same confidence, which is not a\n70:   // tie with a top that earned its confidence from its own evidence.\n71:   const floorOnlyMember = applyFloorException\n72:     && recommendation.confidenceFloored === true\n73:     && top.confidenceFloored !== true;\n74:   if (floorOnlyMember) return false;\n75:   return Math.abs(top.confidence - recommendation.confidence)\n76:     <= AMBIGUITY_CONFIDENCE_MARGIN + Number.EPSILON;\n77: }\n78: \n79: function ambiguousCluster(\n80:   recommendations: readonly AdvisorScoredRecommendation[],\n81:   applyFloorException = true,\n82: ): AdvisorScoredRecommendation[] {\n83:   const passing = recommendations.filter((recommendation) => recommendation.passes_threshold);\n84:   const [top] = passing;\n85:   if (!top) return [];\n86:   // A member that answers the top's own route is the same recommendation written\n87:   // twice, so it never counts as the rival that makes the top a coin flip.\n88:   return passing.filter((recommendation) => (\n89:     clustersWithTop(top, recommendation, applyFloorException)\n90:     && !answersSameRoute(top, recommendation)\n91:   ));\n92: }\n93: \n94: export function isAmbiguousTopTwo(recommendations: readonly AdvisorScoredRecommendation[]): boolean {\n95:   // Name preserved for back-compat with existing call sites; semantics are\n96:   // now \"is the passing top a member of an ambiguity cluster of size >= 2\".\n97:   return ambiguousCluster(recommendations).length >= 2;\n98: }\n99: \n100: export function wideAmbiguityMembers(\n101:   recommendations: readonly AdvisorScoredRecommendation[],\n102: ): Set<string> {\n103:   // The low-information abstention reads this wider set, so a skill the floor\n104:   // exception dropped cannot slip through as the top of an under-specified\n105:   // prompt.\n106:   const wide = ambiguousCluster(recommendations, false);\n107:   if (wide.length < 2) return new Set();\n108:   return new Set(wide.map((recommendation) => recommendation.skill));\n109: }\n110: \n111: export function applyAmbiguity(\n112:   recommendations: readonly AdvisorScoredRecommendation[],\n113: ): AdvisorScoredRecommendation[] {\n114:   const cluster = ambiguousCluster(recommendations);\n115:   if (cluster.length < 2) return [...recommendations];\n116:   const ambiguousSet = new Set(cluster.map((recommendation) => recommendation.skill));\n117:   return recommendations.map((recommendation) => (\n118:     ambiguousSet.has(recommendation.skill)\n119:       ? {\n120:         ...recommendation,\n121:         ambiguousWith: [...ambiguousSet].filter((skill) => skill !== recommendation.skill),\n122:       }\n123:       : recommendation\n124:   ));\n125: }","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/lib/scorer/ambiguity.ts, lines 1-125\n1: // ───────────────────────────────────────────────────────────────\n2: // MODULE: Advisor Ambiguity\n3: // ───────────────────────────────────────────────────────────────\n4: \n5: import { COMMAND_BRIDGES } from './projection.js';\n6: import type { AdvisorScoredRecommendation } from './types.js';\n7: \n8: export const AMBIGUITY_MARGIN = 0.05;\n9: export const AMBIGUITY_CONFIDENCE_MARGIN = 0.05;\n10: \n11: // Compute ambiguity from ranking `score` so the cluster aligns\n12: // with the score-based fusion ranking (top-two-by-confidence may not match\n13: // top-two-by-score).\n14: //\n15: // Also compute on `confidence` and union the two\n16: // clusters. Score-margin keeps ranking alignment; confidence-margin restores\n17: // the documented \"0.05 confidence window\" and catches\n18: // cross-domain prompts where confidence is near-tied (user-visible signal)\n19: // even when score gaps just exceed the score margin. A candidate is in the\n20: // ambiguity cluster when EITHER gap is within its respective 0.05 margin —\n21: // \"outside both margins\" is required to be unambiguously ranked.\n22: //\n23: // One exception: a skill the typed-command bound capped just below the top\n24: // (`heldBelow` names the top) sits close to it only because of that cap, and the\n25: // cap already ranked the pair from the user's own command. Counting that gap as\n26: // a tie would report the explicit command as a coin flip. Two skills close on\n27: // their own evidence still cluster.\n28: //\n29: // The confidence margin has one exception of its own: when the top earned its\n30: // confidence from its own evidence, a member whose confidence only reached a\n31: // floor clusters on the score margin alone.\n32: \n33: // A command bridge row and the skill that owns that command are one answer, so\n34: // their near-tie is a single route rather than a choice between two. Two\n35: // different skills, or a command row and a skill that does not own it, stay a\n36: // real tie.\n37: \n38: // The owner comes from the generated bridge data, never from the shape of an\n39: // id: a bridge id says nothing reliable about which skill runs the command.\n40: const OWNER_BY_BRIDGE_ID: ReadonlyMap<string, string> = new Map(\n41:   COMMAND_BRIDGES.flatMap((bridge) => (bridge.ownerSkill ? [[bridge.id, bridge.ownerSkill] as const] : [])),\n42: );\n43: \n44: function ownsCommandBridge(skillId: string, bridgeId: string): boolean {\n45:   return OWNER_BY_BRIDGE_ID.get(bridgeId) === skillId;\n46: }\n47: \n48: function answersSameRoute(\n49:   top: AdvisorScoredRecommendation,\n50:   recommendation: AdvisorScoredRecommendation,\n51: ): boolean {\n52:   if (top.kind === 'command' && recommendation.kind === 'skill') {\n53:     return ownsCommandBridge(recommendation.skill, top.skill);\n54:   }\n55:   if (top.kind === 'skill' && recommendation.kind === 'command') {\n56:     return ownsCommandBridge(top.skill, recommendation.skill);\n57:   }\n58:   return false;\n59: }\n60: \n61: function clustersWithTop(\n62:   top: AdvisorScoredRecommendation,\n63:   recommendation: AdvisorScoredRecommendation,\n64:   applyFloorException: boolean,\n65: ): boolean {\n66:   if (recommendation !== top && recommendation.heldBelow === top.skill) return false;\n67:   const scoreGap = Math.abs(top.score - recommendation.score);\n68:   if (scoreGap <= AMBIGUITY_MARGIN + Number.EPSILON) return true;\n69:   // A floor pins many unrelated skills to the same confidence, which is not a\n70:   // tie with a top that earned its confidence from its own evidence.\n71:   const floorOnlyMember = applyFloorException\n72:     && recommendation.confidenceFloored === true\n73:     && top.confidenceFloored !== true;\n74:   if (floorOnlyMember) return false;\n75:   return Math.abs(top.confidence - recommendation.confidence)\n76:     <= AMBIGUITY_CONFIDENCE_MARGIN + Number.EPSILON;\n77: }\n78: \n79: function ambiguousCluster(\n80:   recommendations: readonly AdvisorScoredRecommendation[],\n81:   applyFloorException = true,\n82: ): AdvisorScoredRecommendation[] {\n83:   const passing = recommendations.filter((recommendation) => recommendation.passes_threshold);\n84:   const [top] = passing;\n85:   if (!top) return [];\n86:   // A member that answers the top's own route is the same recommendation written\n87:   // twice, so it never counts as the rival that makes the top a coin flip.\n88:   return passing.filter((recommendation) => (\n89:     clustersWithTop(top, recommendation, applyFloorException)\n90:     && !answersSameRoute(top, recommendation)\n91:   ));\n92: }\n93: \n94: export function isAmbiguousTopTwo(recommendations: readonly AdvisorScoredRecommendation[]): boolean {\n95:   // Name preserved for back-compat with existing call sites; semantics are\n96:   // now \"is the passing top a member of an ambiguity cluster of size >= 2\".\n97:   return ambiguousCluster(recommendations).length >= 2;\n98: }\n99: \n100: export function wideAmbiguityMembers(\n101:   recommendations: readonly AdvisorScoredRecommendation[],\n102: ): Set<string> {\n103:   // The low-information abstention reads this wider set, so a skill the floor\n104:   // exception dropped cannot slip through as the top of an under-specified\n105:   // prompt.\n106:   const wide = ambiguousCluster(recommendations, false);\n107:   if (wide.length < 2) return new Set();\n108:   return new Set(wide.map((recommendation) => recommendation.skill));\n109: }\n110: \n111: export function applyAmbiguity(\n112:   recommendations: readonly AdvisorScoredRecommendation[],\n113: ): AdvisorScoredRecommendation[] {\n114:   const cluster = ambiguousCluster(recommendations);\n115:   if (cluster.length < 2) return [...recommendations];\n116:   const ambiguousSet = new Set(cluster.map((recommendation) => recommendation.skill));\n117:   return recommendations.map((recommendation) => (\n118:     ambiguousSet.has(recommendation.skill)\n119:       ? {\n120:         ...recommendation,\n121:         ambiguousWith: [...ambiguousSet].filter((skill) => skill !== recommendation.skill),\n122:       }\n123:       : recommendation\n124:   ));\n125: }"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/lib/scorer/ambiguity.ts\"}"},"time":{"start":1794530052839,"end":1794530053234}}}}
