{"type":"step_start","timestamp":1794530192807,"sessionID":"ses_e2dad3a2dffe46l7KA6EEh2b1G","part":{"id":"prt_1d255ada7001gfrupsjdQLrcpx","sessionID":"ses_e2dad3a2dffe46l7KA6EEh2b1G","messageID":"msg_1d25548ee001WayeoPuSFDxbVn","type":"step-start","snapshot":"e8d4bee6f2fc3dc8d9f69d74cfbc79f50e6e348e"}}
{"type":"tool_use","timestamp":1794530197185,"sessionID":"ses_e2dad3a2dffe46l7KA6EEh2b1G","part":{"partID":"prt_1d255bbff001C7mVSqFq8JeAiu","sessionID":"ses_e2dad3a2dffe46l7KA6EEh2b1G","messageID":"msg_1d25548ee001WayeoPuSFDxbVn","type":"tool","id":"call_6a95427066884726bd77b872","tool":"shell","state":{"status":"completed","input":{"command":"git -c core.fsmonitor=false show 1c80022452 -- .skilled/skills/system-skill-advisor/runtime/lib/scorer/ambiguity.ts .skilled/skills/system-skill-advisor/runtime/tests/scorer/advisor-quality-049-003.vitest.ts"},"output":"commit 1c80022452b8748399e3c581e83217532f7bfcee\nAuthor: Michel Kerkmeester <82775228+MichelKerkmeester@users.noreply.github.com>\nDate:   Tue Oct 27 11:10:13 2026 +0100\n\n    fix(system-skill-advisor): stop calling a confidence floor or a held skill a tie\n    \n    The advisor flagged 110 of 261 labelled routing prompts as ambiguous,\n    mostly because the task-intent confidence floor lifts unrelated skills\n    to 0.82, within the 0.05 confidence margin of a top that earned its\n    confidence. A floored skill now clusters on the score margin alone when\n    the top is not floored, and a skill the typed-command bound held below\n    a command's owner records that owner as heldBelow and never clusters\n    with it. The brief uses the scorer's ambiguity answer and names a real\n    cluster member after \"vs\", and the low-information abstention still\n    reads the wider cluster so a floored skill cannot top an\n    under-specified prompt.\n    \n    Over the 261 prompts, flags fall from 110 to 78 with the same 202\n    correct top skills and no top skill changed; the typed\n    /deep:research :auto prompt now reads ambiguous false. Released as\n    system-skill-advisor 0.17.7.0. Also keeps /specs/other/ local.\n    \n    Spec: system-speckit/054-weak-model-spec-authoring/024-typed-command-ambiguity\n    Commit-Id: 0012433\n\ndiff --git a/.skilled/skills/system-skill-advisor/runtime/lib/scorer/ambiguity.ts b/.skilled/skills/system-skill-advisor/runtime/lib/scorer/ambiguity.ts\nindex f3a8d106ba..ad921c9c1c 100644\n--- a/.skilled/skills/system-skill-advisor/runtime/lib/scorer/ambiguity.ts\n+++ b/.skilled/skills/system-skill-advisor/runtime/lib/scorer/ambiguity.ts\n@@ -18,21 +18,43 @@ export const AMBIGUITY_CONFIDENCE_MARGIN = 0.05;\n // even when score gaps just exceed the score margin. A candidate is in the\n // ambiguity cluster when EITHER gap is within its respective 0.05 margin —\n // \"outside both margins\" is required to be unambiguously ranked.\n+//\n+// One exception: a skill the typed-command bound capped just below the top\n+// (`heldBelow` names the top) sits close to it only because of that cap, and the\n+// cap already ranked the pair from the user's own command. Counting that gap as\n+// a tie would report the explicit command as a coin flip. Two skills close on\n+// their own evidence still cluster.\n+//\n+// The confidence margin has one exception of its own: when the top earned its\n+// confidence from its own evidence, a member whose confidence only reached a\n+// floor clusters on the score margin alone.\n+\n+function clustersWithTop(\n+  top: AdvisorScoredRecommendation,\n+  recommendation: AdvisorScoredRecommendation,\n+  applyFloorException: boolean,\n+): boolean {\n+  if (recommendation !== top && recommendation.heldBelow === top.skill) return false;\n+  const scoreGap = Math.abs(top.score - recommendation.score);\n+  if (scoreGap <= AMBIGUITY_MARGIN + Number.EPSILON) return true;\n+  // A floor pins many unrelated skills to the same confidence, which is not a\n+  // tie with a top that earned its confidence from its own evidence.\n+  const floorOnlyMember = applyFloorException\n+    && recommendation.confidenceFloored === true\n+    && top.confidenceFloored !== true;\n+  if (floorOnlyMember) return false;\n+  return Math.abs(top.confidence - recommendation.confidence)\n+    <= AMBIGUITY_CONFIDENCE_MARGIN + Number.EPSILON;\n+}\n \n function ambiguousCluster(\n   recommendations: readonly AdvisorScoredRecommendation[],\n+  applyFloorException = true,\n ): AdvisorScoredRecommendation[] {\n   const passing = recommendations.filter((recommendation) => recommendation.passes_threshold);\n   const [top] = passing;\n   if (!top) return [];\n-  return passing.filter((recommendation) => {\n-    const scoreGap = Math.abs(top.score - recommendation.score);\n-    const confidenceGap = Math.abs(top.confidence - recommendation.confidence);\n-    return (\n-      scoreGap <= AMBIGUITY_MARGIN + Number.EPSILON\n-      || confidenceGap <= AMBIGUITY_CONFIDENCE_MARGIN + Number.EPSILON\n-    );\n-  });\n+  return passing.filter((recommendation) => clustersWithTop(top, recommendation, applyFloorException));\n }\n \n export function isAmbiguousTopTwo(recommendations: readonly AdvisorScoredRecommendation[]): boolean {\n@@ -41,6 +63,17 @@ export function isAmbiguousTopTwo(recommendations: readonly AdvisorScoredRecomme\n   return ambiguousCluster(recommendations).length >= 2;\n }\n \n+export function wideAmbiguityMembers(\n+  recommendations: readonly AdvisorScoredRecommendation[],\n+): Set<string> {\n+  // The low-information abstention reads this wider set, so a skill the floor\n+  // exception dropped cannot slip through as the top of an under-specified\n+  // prompt.\n+  const wide = ambiguousCluster(recommendations, false);\n+  if (wide.length < 2) return new Set();\n+  return new Set(wide.map((recommendation) => recommendation.skill));\n+}\n+\n export function applyAmbiguity(\n   recommendations: readonly AdvisorScoredRecommendation[],\n ): AdvisorScoredRecommendation[] {\ndiff --git a/.skilled/skills/system-skill-advisor/runtime/tests/scorer/advisor-quality-049-003.vitest.ts b/.skilled/skills/system-skill-advisor/runtime/tests/scorer/advisor-quality-049-003.vitest.ts\nindex b57b2a25fb..12e98f14db 100644\n--- a/.skilled/skills/system-skill-advisor/runtime/tests/scorer/advisor-quality-049-003.vitest.ts\n+++ b/.skilled/skills/system-skill-advisor/runtime/tests/scorer/advisor-quality-049-003.vitest.ts\n@@ -8,7 +8,7 @@\n // and review-plus-write disambiguation.\n \n import { describe, expect, it } from 'vitest';\n-import { applyAmbiguity, isAmbiguousTopTwo } from '../../lib/scorer/ambiguity.js';\n+import { applyAmbiguity, isAmbiguousTopTwo, wideAmbiguityMembers } from '../../lib/scorer/ambiguity.js';\n import { scoreAdvisorPrompt } from '../../lib/scorer/fusion.js';\n import { scoreGraphCausalLane } from '../../lib/scorer/lanes/graph-causal.js';\n import { createFixtureProjection } from '../../lib/scorer/projection.js';\n@@ -282,6 +282,76 @@ describe('F-012-C2-04 ambiguity tie-cluster computation', () => {\n \n     expect(isAmbiguousTopTwo(recommendations)).toBe(false);\n   });\n+\n+  // A confidence floor pins many unrelated skills to the same confidence, so a\n+  // member that only cleared the floor is no tie with a top that earned its own.\n+  it('does not cluster a floor-only member when the top is not floored', () => {\n+    const recommendations: AdvisorScoredRecommendation[] = [\n+      recommendation({ skill: 'top', score: 0.560, confidence: 0.8235, passes_threshold: true }),\n+      recommendation({\n+        skill: 'floored',\n+        score: 0.200,\n+        confidence: 0.820,\n+        confidenceFloored: true,\n+        passes_threshold: true,\n+      }),\n+    ];\n+\n+    expect(isAmbiguousTopTwo(recommendations)).toBe(false);\n+  });\n+\n+  it('clusters the same pair when the top cleared a floor too', () => {\n+    const recommendations: AdvisorScoredRecommendation[] = [\n+      recommendation({\n+        skill: 'top',\n+        score: 0.560,\n+        confidence: 0.820,\n+        confidenceFloored: true,\n+        passes_threshold: true,\n+      }),\n+      recommendation({\n+        skill: 'floored',\n+        score: 0.200,\n+        confidence: 0.820,\n+        confidenceFloored: true,\n+        passes_threshold: true,\n+      }),\n+    ];\n+\n+    expect(isAmbiguousTopTwo(recommendations)).toBe(true);\n+  });\n+\n+  it('still clusters a floor-only member whose score is inside the score margin', () => {\n+    const recommendations: AdvisorScoredRecommendation[] = [\n+      recommendation({ skill: 'top', score: 0.560, confidence: 0.8235, passes_threshold: true }),\n+      recommendation({\n+        skill: 'floored',\n+        score: 0.530,\n+        confidence: 0.820,\n+        confidenceFloored: true,\n+        passes_threshold: true,\n+      }),\n+    ];\n+\n+    expect(isAmbiguousTopTwo(recommendations)).toBe(true);\n+  });\n+\n+  it('keeps the floor-only member in the wide ambiguity set', () => {\n+    // The abstention path reads the wide set, so a member the floor exception\n+    // dropped from the visible cluster must still be reported there.\n+    const recommendations: AdvisorScoredRecommendation[] = [\n+      recommendation({ skill: 'top', score: 0.560, confidence: 0.8235, passes_threshold: true }),\n+      recommendation({\n+        skill: 'floored',\n+        score: 0.200,\n+        confidence: 0.820,\n+        confidenceFloored: true,\n+        passes_threshold: true,\n+      }),\n+    ];\n+\n+    expect(wideAmbiguityMembers(recommendations)).toEqual(new Set(['top', 'floored']));\n+  });\n });\n \n // ───────────────────────────────────────────────────────────────\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"commit 1c80022452b8748399e3c581e83217532f7bfcee\nAuthor: Michel Kerkmeester <82775228+MichelKerkmeester@users.noreply.github.com>\nDate:   Tue Oct 27 11:10:13 2026 +0100\n\n    fix(system-skill-advisor): stop calling a confidence floor or a held skill a tie\n    \n    The advisor flagged 110 of 261 labelled routing prompts as ambiguous,\n    mostly because the task-intent confidence floor lifts unrelated skills\n    to 0.82, within the 0.05 confidence margin of a top that earned its\n    confidence. A floored skill now clusters on the score margin alone when\n    the top is not floored, and a skill the typed-command bound held below\n    a command's owner records that owner as heldBelow and never clusters\n    with it. The brief uses the scorer's ambiguity answer and names a real\n    cluster member after \"vs\", and the low-information abstention still\n    reads the wider cluster so a floored skill cannot top an\n    under-specified prompt.\n    \n    Over the 261 prompts, flags fall from 110 to 78 with the same 202\n    correct top skills and no top skill changed; the typed\n    /deep:research :auto prompt now reads ambiguous false. Released as\n    system-skill-advisor 0.17.7.0. Also keeps /specs/other/ local.\n    \n    Spec: system-speckit/054-weak-model-spec-authoring/024-typed-command-ambiguity\n    Commit-Id: 0012433\n\ndiff --git a/.skilled/skills/system-skill-advisor/runtime/lib/scorer/ambiguity.ts b/.skilled/skills/system-skill-advisor/runtime/lib/scorer/ambiguity.ts\nindex f3a8d106ba..ad921c9c1c 100644\n--- a/.skilled/skills/system-skill-advisor/runtime/lib/scorer/ambiguity.ts\n+++ b/.skilled/skills/system-skill-advisor/runtime/lib/scorer/ambiguity.ts\n@@ -18,21 +18,43 @@ export const AMBIGUITY_CONFIDENCE_MARGIN = 0.05;\n // even when score gaps just exceed the score margin. A candidate is in the\n // ambiguity cluster when EITHER gap is within its respective 0.05 margin —\n // \"outside both margins\" is required to be unambiguously ranked.\n+//\n+// One exception: a skill the typed-command bound capped just below the top\n+// (`heldBelow` names the top) sits close to it only because of that cap, and the\n+// cap already ranked the pair from the user's own command. Counting that gap as\n+// a tie would report the explicit command as a coin flip. Two skills close on\n+// their own evidence still cluster.\n+//\n+// The confidence margin has one exception of its own: when the top earned its\n+// confidence from its own evidence, a member whose confidence only reached a\n+// floor clusters on the score margin alone.\n+\n+function clustersWithTop(\n+  top: AdvisorScoredRecommendation,\n+  recommendation: AdvisorScoredRecommendation,\n+  applyFloorException: boolean,\n+): boolean {\n+  if (recommendation !== top && recommendation.heldBelow === top.skill) return false;\n+  const scoreGap = Math.abs(top.score - recommendation.score);\n+  if (scoreGap <= AMBIGUITY_MARGIN + Number.EPSILON) return true;\n+  // A floor pins many unrelated skills to the same confidence, which is not a\n+  // tie with a top that earned its confidence from its own evidence.\n+  const floorOnlyMember = applyFloorException\n+    && recommendation.confidenceFloored === true\n+    && top.confidenceFloored !== true;\n+  if (floorOnlyMember) return false;\n+  return Math.abs(top.confidence - recommendation.confidence)\n+    <= AMBIGUITY_CONFIDENCE_MARGIN + Number.EPSILON;\n+}\n \n function ambiguousCluster(\n   recommendations: readonly AdvisorScoredRecommendation[],\n+  applyFloorException = true,\n ): AdvisorScoredRecommendation[] {\n   const passing = recommendations.filter((recommendation) => recommendation.passes_threshold);\n   const [top] = passing;\n   if (!top) return [];\n-  return passing.filter((recommendation) => {\n-    const scoreGap = Math.abs(top.score - recommendation.score);\n-    const confidenceGap = Math.abs(top.confidence - recommendation.confidence);\n-    return (\n-      scoreGap <= AMBIGUITY_MARGIN + Number.EPSILON\n-      || confidenceGap <= AMBIGUITY_CONFIDENCE_MARGIN + Number.EPSILON\n-    );\n-  });\n+  return passing.filter((recommendation) => clustersWithTop(top, recommendation, applyFloorException));\n }\n \n export function isAmbiguousTopTwo(recommendations: readonly AdvisorScoredRecommendation[]): boolean {\n@@ -41,6 +63,17 @@ export function isAmbiguousTopTwo(recommendations: readonly AdvisorScoredRecomme\n   return ambiguousCluster(recommendations).length >= 2;\n }\n \n+export function wideAmbiguityMembers(\n+  recommendations: readonly AdvisorScoredRecommendation[],\n+): Set<string> {\n+  // The low-information abstention reads this wider set, so a skill the floor\n+  // exception dropped cannot slip through as the top of an under-specified\n+  // prompt.\n+  const wide = ambiguousCluster(recommendations, false);\n+  if (wide.length < 2) return new Set();\n+  return new Set(wide.map((recommendation) => recommendation.skill));\n+}\n+\n export function applyAmbiguity(\n   recommendations: readonly AdvisorScoredRecommendation[],\n ): AdvisorScoredRecommendation[] {\ndiff --git a/.skilled/skills/system-skill-advisor/runtime/tests/scorer/advisor-quality-049-003.vitest.ts b/.skilled/skills/system-skill-advisor/runtime/tests/scorer/advisor-quality-049-003.vitest.ts\nindex b57b2a25fb..12e98f14db 100644\n--- a/.skilled/skills/system-skill-advisor/runtime/tests/scorer/advisor-quality-049-003.vitest.ts\n+++ b/.skilled/skills/system-skill-advisor/runtime/tests/scorer/advisor-quality-049-003.vitest.ts\n@@ -8,7 +8,7 @@\n // and review-plus-write disambiguation.\n \n import { describe, expect, it } from 'vitest';\n-import { applyAmbiguity, isAmbiguousTopTwo } from '../../lib/scorer/ambiguity.js';\n+import { applyAmbiguity, isAmbiguousTopTwo, wideAmbiguityMembers } from '../../lib/scorer/ambiguity.js';\n import { scoreAdvisorPrompt } from '../../lib/scorer/fusion.js';\n import { scoreGraphCausalLane } from '../../lib/scorer/lanes/graph-causal.js';\n import { createFixtureProjection } from '../../lib/scorer/projection.js';\n@@ -282,6 +282,76 @@ describe('F-012-C2-04 ambiguity tie-cluster computation', () => {\n \n     expect(isAmbiguousTopTwo(recommendations)).toBe(false);\n   });\n+\n+  // A confidence floor pins many unrelated skills to the same confidence, so a\n+  // member that only cleared the floor is no tie with a top that earned its own.\n+  it('does not cluster a floor-only member when the top is not floored', () => {\n+    const recommendations: AdvisorScoredRecommendation[] = [\n+      recommendation({ skill: 'top', score: 0.560, confidence: 0.8235, passes_threshold: true }),\n+      recommendation({\n+        skill: 'floored',\n+        score: 0.200,\n+        confidence: 0.820,\n+        confidenceFloored: true,\n+        passes_threshold: true,\n+      }),\n+    ];\n+\n+    expect(isAmbiguousTopTwo(recommendations)).toBe(false);\n+  });\n+\n+  it('clusters the same pair when the top cleared a floor too', () => {\n+    const recommendations: AdvisorScoredRecommendation[] = [\n+      recommendation({\n+        skill: 'top',\n+        score: 0.560,\n+        confidence: 0.820,\n+        confidenceFloored: true,\n+        passes_threshold: true,\n+      }),\n+      recommendation({\n+        skill: 'floored',\n+        score: 0.200,\n+        confidence: 0.820,\n+        confidenceFloored: true,\n+        passes_threshold: true,\n+      }),\n+    ];\n+\n+    expect(isAmbiguousTopTwo(recommendations)).toBe(true);\n+  });\n+\n+  it('still clusters a floor-only member whose score is inside the score margin', () => {\n+    const recommendations: AdvisorScoredRecommendation[] = [\n+      recommendation({ skill: 'top', score: 0.560, confidence: 0.8235, passes_threshold: true }),\n+      recommendation({\n+        skill: 'floored',\n+        score: 0.530,\n+        confidence: 0.820,\n+        confidenceFloored: true,\n+        passes_threshold: true,\n+      }),\n+    ];\n+\n+    expect(isAmbiguousTopTwo(recommendations)).toBe(true);\n+  });\n+\n+  it('keeps the floor-only member in the wide ambiguity set', () => {\n+    // The abstention path reads the wide set, so a member the floor exception\n+    // dropped from the visible cluster must still be reported there.\n+    const recommendations: AdvisorScoredRecommendation[] = [\n+      recommendation({ skill: 'top', score: 0.560, confidence: 0.8235, passes_threshold: true }),\n+      recommendation({\n+        skill: 'floored',\n+        score: 0.200,\n+        confidence: 0.820,\n+        confidenceFloored: true,\n+        passes_threshold: true,\n+      }),\n+    ];\n+\n+    expect(wideAmbiguityMembers(recommendations)).toEqual(new Set(['top', 'floored']));\n+  });\n });\n \n // ───────────────────────────────────────────────────────────────\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"git -c core.fsmonitor=false show 1c80022452 -- .skilled/skills/system-skill-advisor/runtime/lib/scorer/ambiguity.ts .skilled/skills/system-skill-advisor/runtime/tests/scorer/advisor-quality-049-003.vitest.ts\"}"},"time":{"start":1794530196479,"end":1794530197185}}}}
