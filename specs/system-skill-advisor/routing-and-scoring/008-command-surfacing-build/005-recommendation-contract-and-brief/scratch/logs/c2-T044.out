{"type":"tool_use","timestamp":1794530141139,"sessionID":"ses_e2dad3a2dffe46l7KA6EEh2b1G","part":{"partID":"prt_1d254e018001KOyOFeRAjj1xYb","sessionID":"ses_e2dad3a2dffe46l7KA6EEh2b1G","messageID":"msg_1d254c4b0001W9NzkPXvB1wStn","type":"tool","id":"call_fb6b34847e9a43e08cbaa87a","tool":"read","state":{"status":"completed","input":{"path":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/capture-scorer-eval-baseline.mjs"},"output":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/capture-scorer-eval-baseline.mjs, lines 1-257\n1: // ───────────────────────────────────────────────────────────────────\n2: // MODULE: SCORER EVAL BASELINE CAPTURE\n3: // ───────────────────────────────────────────────────────────────────\n4: //\n5: // Captures the current scorer accuracy across the full corpus, the independent\n6: // holdout, the frozen ambiguity slice, and the named intent buckets, under the\n7: // reproducible filesystem projection (empty SYSTEM_SKILL_ADVISOR_DB_DIR → SQLite\n8: // loader returns null → projection built purely from committed graph metadata).\n9: // The result is the ratchet baseline: the ratchet gate re-scores live under the\n10: // same env and holds every metric to it, so any scoring or metadata change that\n11: // moves a number forces a conscious re-capture rather than drifting silently.\n12: //\n13: // The *Sha256 fields pin the baseline to the exact fixtures it was captured\n14: // against; a fixture edit changes a hash and forces re-baselining.\n15: //\n16: // Usage:\n17: //   node capture-scorer-eval-baseline.mjs            # print JSON to stdout\n18: //   node capture-scorer-eval-baseline.mjs --write     # also write the baseline\n19: //   node capture-scorer-eval-baseline.mjs --misses    # print each failing prompt, one JSON line each\n20: //   SPECKIT_EVAL_BASELINE_SCORING_DATE=YYYY-MM-DD node capture-scorer-eval-baseline.mjs --write\n21: //                                                     # move the pinned scoring date\n22: \n23: // ───────────────────────────────────────────────────────────────────\n24: // 1. IMPORTS\n25: // ───────────────────────────────────────────────────────────────────\n26: \n27: import { spawnSync } from 'node:child_process';\n28: import { createHash } from 'node:crypto';\n29: import { mkdtempSync, readFileSync, writeFileSync } from 'node:fs';\n30: import { tmpdir } from 'node:os';\n31: import { dirname, join, resolve } from 'node:path';\n32: import { fileURLToPath } from 'node:url';\n33: import { rejectUnknownOptions } from './reject-unknown-options.mjs';\n34: \n35: rejectUnknownOptions(import.meta.url, ['--write', '--misses']);\n36: \n37: // ───────────────────────────────────────────────────────────────────\n38: // 2. CONSTANTS\n39: // ───────────────────────────────────────────────────────────────────\n40: \n41: const HERE = dirname(fileURLToPath(import.meta.url));\n42: const CORPUS_JSONL = resolve(HERE, 'labeled-prompts.jsonl');\n43: const HOLDOUT_JSONL = resolve(HERE, 'holdout-prompts.jsonl');\n44: const AMBIGUITY_JSONL = resolve(HERE, 'ambiguity-prompts.jsonl');\n45: const DELEGATION_JSON = resolve(HERE, '../../tests/parity/fixtures/executor-delegation-cases.json');\n46: const OUTPUT_JSON = resolve(HERE, 'scorer-eval-baseline.json');\n47: const DIST = resolve(HERE, '../../dist/runtime');\n48: \n49: // ───────────────────────────────────────────────────────────────────\n50: // 3. RUNTIME SETUP\n51: // ───────────────────────────────────────────────────────────────────\n52: \n53: process.env.SYSTEM_SKILL_ADVISOR_DB_DIR = mkdtempSync(join(tmpdir(), 'advisor-eval-baseline-'));\n54: process.env.SKILL_ADVISOR_DISABLE_BUILTIN_SEMANTIC = '1';\n55: process.env.SPECKIT_SKILL_ADVISOR_FORCE_LOCAL = '1';\n56: process.env.PYTHONDONTWRITEBYTECODE = '1';\n57: // Match the test-harness regime: the semantic-shadow lane substitutes\n58: // deterministic fixture vectors under the harness flag (real embeddings are not\n59: // reproducible in CI), so every scorer gate runs this way. The baseline must be\n60: // captured under the same regime the ratchet re-scores it in.\n61: process.env.VITEST = 'true';\n62: delete process.env.SPECKIT_ADVISOR_LANE_WEIGHTS_JSON;\n63: delete process.env.SPECKIT_ADVISOR_LANE_SHADOW_WEIGHTS_JSON;\n64: delete process.env.SPECKIT_ADVISOR_BM25_LEXICAL_SHADOW;\n65: // Private `local-*` skills linked in through this variable live outside the\n66: // checkout, so a baseline measured on a clean checkout must not see them.\n67: delete process.env.SPECKIT_PRIVATE_SKILL_ROOTS;\n68: \n69: // The derived lane halves each skill's score every 90 days of age, measured from\n70: // its derived.generated_at to the scoring clock (floored at 0.1), so scores move\n71: // with the calendar. The scoring date is therefore pinned and recorded, never\n72: // read from the wall clock: a recapture on any day replays the recorded date and\n73: // reproduces the same numbers. Moving the pin is a deliberate act, made by\n74: // exporting SPECKIT_EVAL_BASELINE_SCORING_DATE=YYYY-MM-DD for the capture run.\n75: // The baseline's `capturedAt` field holds this pinned scoring date, which the\n76: // ratchet and the other baseline readers replay at midnight UTC.\n77: const SCORING_DATE_ENV = 'SPECKIT_EVAL_BASELINE_SCORING_DATE';\n78: \n79: function isCalendarDate(value) {\n80:   if (!/^\\d{4}-\\d{2}-\\d{2}$/.test(value)) return false;\n81:   const parsed = new Date(`${value}T00:00:00Z`);\n82:   return !Number.isNaN(parsed.getTime()) && parsed.toISOString().slice(0, 10) === value;\n83: }\n84: \n85: function resolveScoringDate() {\n86:   const fromEnv = process.env[SCORING_DATE_ENV];\n87:   if (fromEnv !== undefined && fromEnv !== '') {\n88:     if (!isCalendarDate(fromEnv)) {\n89:       process.stderr.write(`capture-scorer-eval-baseline.mjs: ${SCORING_DATE_ENV} must be a calendar date (YYYY-MM-DD), got: ${fromEnv}\\n`);\n90:       process.exit(2);\n91:     }\n92:     return fromEnv;\n93:   }\n94:   let recorded;\n95:   try {\n96:     recorded = JSON.parse(readFileSync(OUTPUT_JSON, 'utf8')).capturedAt;\n97:   } catch {\n98:     recorded = undefined;\n99:   }\n100:   if (typeof recorded === 'string' && isCalendarDate(recorded)) return recorded;\n101:   process.stderr.write(`capture-scorer-eval-baseline.mjs: no recorded scoring date in ${OUTPUT_JSON}; set ${SCORING_DATE_ENV}=YYYY-MM-DD\\n`);\n102:   process.exit(2);\n103: }\n104: \n105: const CAPTURED_AT = resolveScoringDate();\n106: const SCORING_INSTANT = Date.parse(`${CAPTURED_AT}T00:00:00Z`);\n107: const RealDate = Date;\n108: globalThis.Date = class extends RealDate {\n109:   constructor(...args) {\n110:     if (args.length === 0) super(SCORING_INSTANT);\n111:     else super(...args);\n112:   }\n113: \n114:   static now() {\n115:     return SCORING_INSTANT;\n116:   }\n117: };\n118: \n119: const { scoreAdvisorPrompt } = await import(join(DIST, 'lib/scorer/fusion.js'));\n120: const { mergedSkillForAlias, skillMatchesAlias } = await import(join(DIST, 'lib/scorer/aliases.js'));\n121: const { findAdvisorWorkspaceRoot } = await import(join(DIST, 'lib/utils/workspace-root.js'));\n122: \n123: const SENTINEL = '.skilled/skills/system-spec-kit/SKILL.md';\n124: const WORKSPACE_ROOT = findAdvisorWorkspaceRoot(HERE, { maxDepth: 14, sentinel: SENTINEL });\n125: \n126: // ───────────────────────────────────────────────────────────────────\n127: // 4. HELPERS\n128: // ───────────────────────────────────────────────────────────────────\n129: \n130: function sha256File(path) {\n131:   return `sha256:${createHash('sha256').update(readFileSync(path)).digest('hex')}`;\n132: }\n133: \n134: function readJsonl(path) {\n135:   return readFileSync(path, 'utf8').trim().split('\\n').filter(Boolean).map((line) => JSON.parse(line));\n136: }\n137: \n138: function topSkill(prompt) {\n139:   return scoreAdvisorPrompt(prompt, { workspaceRoot: WORKSPACE_ROOT }).topSkill;\n140: }\n141: \n142: // Alias-aware top-1 match: corpus/holdout labels may use superseded skill ids or\n143: // folded deep-loop mode ids, canonicalized on both sides before comparing. A\n144: // both-null result is a correct abstain.\n145: function isTop1Correct(top, goldRaw) {\n146:   const gold = goldRaw === 'none' ? null : goldRaw;\n147:   const expected = gold === null ? null : mergedSkillForAlias(gold);\n148:   const actual = top === null ? null : mergedSkillForAlias(top);\n149:   return actual === expected\n150:     || (actual !== null && expected !== null && skillMatchesAlias(actual, expected));\n151: }\n152: \n153: function accuracy(correct, total) {\n154:   return total > 0 ? Number((correct / total).toFixed(4)) : 0;\n155: }\n156: \n157: // A count says how many prompts fail, never which ones. A scoring change is judged\n158: // against the failing prompts themselves, so each set records them as it scores.\n159: const misses = [];\n160: \n161: function recordMiss(set, row, top) {\n162:   misses.push({ set, id: row.id, gold: row.skill_top_1, got: top === null ? 'none' : top, prompt: row.prompt });\n163: }\n164: \n165: function scoreSet(rows, set) {\n166:   let correct = 0;\n167:   for (const row of rows) {\n168:     const top = topSkill(row.prompt);\n169:     if (isTop1Correct(top, row.skill_top_1)) correct += 1;\n170:     else if (set) recordMiss(set, row, top);\n171:   }\n172:   return { correct, total: rows.length, accuracy: accuracy(correct, rows.length) };\n173: }\n174: \n175: // ───────────────────────────────────────────────────────────────────\n176: // 5. CORE LOGIC\n177: // ───────────────────────────────────────────────────────────────────\n178: \n179: const corpus = readJsonl(CORPUS_JSONL);\n180: let unknown = 0;\n181: let goldNoneFalseFire = 0;\n182: let fullCorrect = 0;\n183: for (const row of corpus) {\n184:   const top = topSkill(row.prompt);\n185:   if (top === null) unknown += 1;\n186:   if (row.skill_top_1 === 'none' && top !== null) goldNoneFalseFire += 1;\n187:   if (isTop1Correct(top, row.skill_top_1)) fullCorrect += 1;\n188:   else recordMiss('full_corpus', row, top);\n189: }\n190: \n191: const holdout = scoreSet(readJsonl(HOLDOUT_JSONL), 'holdout');\n192: \n193: const ambiguityRows = readJsonl(AMBIGUITY_JSONL);\n194: const ambiguity = scoreSet(ambiguityRows, 'ambiguity');\n195: const tau = ambiguityRows.length > 0 ? ambiguityRows[0].tau : null;\n196: \n197: const reviewRows = corpus.filter((row) => row.bucket === 'true_read_only');\n198: const memorySaveRows = corpus.filter((row) => row.bucket === 'memory_save_resume');\n199: const review = scoreSet(reviewRows);\n200: const memorySave = scoreSet(memorySaveRows);\n201: \n202: // Delegation uses strict equality: the targets are top-level skill ids with no\n203: // alias folding, and 'none' is a correct abstain.\n204: const delegationCases = JSON.parse(readFileSync(DELEGATION_JSON, 'utf8')).cases;\n205: let delegationCorrect = 0;\n206: for (const testCase of delegationCases) {\n207:   const expected = testCase.expectedTop === 'none' ? null : testCase.expectedTop;\n208:   if (topSkill(testCase.prompt) === expected) delegationCorrect += 1;\n209: }\n210: \n211: const headSha = (() => {\n212:   const result = spawnSync('git', ['rev-parse', '--short', 'HEAD'], { cwd: WORKSPACE_ROOT, encoding: 'utf8' });\n213:   return result.status === 0 ? result.stdout.trim() : 'unknown';\n214: })();\n215: \n216: const baseline = {\n217:   schemaVersion: 1,\n218:   capturedAt: CAPTURED_AT,\n219:   capturedAtSha: headSha,\n220:   corpusSha256: sha256File(CORPUS_JSONL),\n221:   holdoutSha256: sha256File(HOLDOUT_JSONL),\n222:   ambiguitySha256: sha256File(AMBIGUITY_JSONL),\n223:   env: {\n224:     SKILL_ADVISOR_DISABLE_BUILTIN_SEMANTIC: '1',\n225:     SYSTEM_SKILL_ADVISOR_DB_DIR: '<empty-dir>',\n226:     projectionSource: 'filesystem',\n227:   },\n228:   metrics: {\n229:     full_corpus_top1: { correct: fullCorrect, total: corpus.length, accuracy: accuracy(fullCorrect, corpus.length) },\n230:     unknown_count: { value: unknown },\n231:     gold_none_false_fire: { value: goldNoneFalseFire },\n232:     holdout_top1: holdout,\n233:     ambiguity_top1: { correct: ambiguity.correct, total: ambiguity.total, accuracy: ambiguity.accuracy, tau },\n234:     buckets: {\n235:       review: review,\n236:       memory_save: memorySave,\n237:       delegation: { correct: delegationCorrect, total: delegationCases.length, accuracy: accuracy(delegationCorrect, delegationCases.length) },\n238:     },\n239:   },\n240: };\n241: \n242: // ───────────────────────────────────────────────────────────────────\n243: // 6. CLI ENTRY\n244: // ───────────────────────────────────────────────────────────────────\n245: \n246: const serialized = JSON.stringify(baseline, null, 2) + '\\n';\n247: if (process.argv.includes('--misses')) {\n248:   // The review and memory-save buckets are slices of the full corpus, so their\n249:   // failing prompts are already listed under it.\n250:   for (const miss of misses) console.log(JSON.stringify(miss));\n251: } else {\n252:   if (process.argv.includes('--write')) {\n253:     writeFileSync(OUTPUT_JSON, serialized, 'utf8');\n254:     console.log(`wrote baseline -> ${OUTPUT_JSON}`);\n255:   }\n256:   console.log(serialized);\n257: }","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/capture-scorer-eval-baseline.mjs, lines 1-257\n1: // ───────────────────────────────────────────────────────────────────\n2: // MODULE: SCORER EVAL BASELINE CAPTURE\n3: // ───────────────────────────────────────────────────────────────────\n4: //\n5: // Captures the current scorer accuracy across the full corpus, the independent\n6: // holdout, the frozen ambiguity slice, and the named intent buckets, under the\n7: // reproducible filesystem projection (empty SYSTEM_SKILL_ADVISOR_DB_DIR → SQLite\n8: // loader returns null → projection built purely from committed graph metadata).\n9: // The result is the ratchet baseline: the ratchet gate re-scores live under the\n10: // same env and holds every metric to it, so any scoring or metadata change that\n11: // moves a number forces a conscious re-capture rather than drifting silently.\n12: //\n13: // The *Sha256 fields pin the baseline to the exact fixtures it was captured\n14: // against; a fixture edit changes a hash and forces re-baselining.\n15: //\n16: // Usage:\n17: //   node capture-scorer-eval-baseline.mjs            # print JSON to stdout\n18: //   node capture-scorer-eval-baseline.mjs --write     # also write the baseline\n19: //   node capture-scorer-eval-baseline.mjs --misses    # print each failing prompt, one JSON line each\n20: //   SPECKIT_EVAL_BASELINE_SCORING_DATE=YYYY-MM-DD node capture-scorer-eval-baseline.mjs --write\n21: //                                                     # move the pinned scoring date\n22: \n23: // ───────────────────────────────────────────────────────────────────\n24: // 1. IMPORTS\n25: // ───────────────────────────────────────────────────────────────────\n26: \n27: import { spawnSync } from 'node:child_process';\n28: import { createHash } from 'node:crypto';\n29: import { mkdtempSync, readFileSync, writeFileSync } from 'node:fs';\n30: import { tmpdir } from 'node:os';\n31: import { dirname, join, resolve } from 'node:path';\n32: import { fileURLToPath } from 'node:url';\n33: import { rejectUnknownOptions } from './reject-unknown-options.mjs';\n34: \n35: rejectUnknownOptions(import.meta.url, ['--write', '--misses']);\n36: \n37: // ───────────────────────────────────────────────────────────────────\n38: // 2. CONSTANTS\n39: // ───────────────────────────────────────────────────────────────────\n40: \n41: const HERE = dirname(fileURLToPath(import.meta.url));\n42: const CORPUS_JSONL = resolve(HERE, 'labeled-prompts.jsonl');\n43: const HOLDOUT_JSONL = resolve(HERE, 'holdout-prompts.jsonl');\n44: const AMBIGUITY_JSONL = resolve(HERE, 'ambiguity-prompts.jsonl');\n45: const DELEGATION_JSON = resolve(HERE, '../../tests/parity/fixtures/executor-delegation-cases.json');\n46: const OUTPUT_JSON = resolve(HERE, 'scorer-eval-baseline.json');\n47: const DIST = resolve(HERE, '../../dist/runtime');\n48: \n49: // ───────────────────────────────────────────────────────────────────\n50: // 3. RUNTIME SETUP\n51: // ───────────────────────────────────────────────────────────────────\n52: \n53: process.env.SYSTEM_SKILL_ADVISOR_DB_DIR = mkdtempSync(join(tmpdir(), 'advisor-eval-baseline-'));\n54: process.env.SKILL_ADVISOR_DISABLE_BUILTIN_SEMANTIC = '1';\n55: process.env.SPECKIT_SKILL_ADVISOR_FORCE_LOCAL = '1';\n56: process.env.PYTHONDONTWRITEBYTECODE = '1';\n57: // Match the test-harness regime: the semantic-shadow lane substitutes\n58: // deterministic fixture vectors under the harness flag (real embeddings are not\n59: // reproducible in CI), so every scorer gate runs this way. The baseline must be\n60: // captured under the same regime the ratchet re-scores it in.\n61: process.env.VITEST = 'true';\n62: delete process.env.SPECKIT_ADVISOR_LANE_WEIGHTS_JSON;\n63: delete process.env.SPECKIT_ADVISOR_LANE_SHADOW_WEIGHTS_JSON;\n64: delete process.env.SPECKIT_ADVISOR_BM25_LEXICAL_SHADOW;\n65: // Private `local-*` skills linked in through this variable live outside the\n66: // checkout, so a baseline measured on a clean checkout must not see them.\n67: delete process.env.SPECKIT_PRIVATE_SKILL_ROOTS;\n68: \n69: // The derived lane halves each skill's score every 90 days of age, measured from\n70: // its derived.generated_at to the scoring clock (floored at 0.1), so scores move\n71: // with the calendar. The scoring date is therefore pinned and recorded, never\n72: // read from the wall clock: a recapture on any day replays the recorded date and\n73: // reproduces the same numbers. Moving the pin is a deliberate act, made by\n74: // exporting SPECKIT_EVAL_BASELINE_SCORING_DATE=YYYY-MM-DD for the capture run.\n75: // The baseline's `capturedAt` field holds this pinned scoring date, which the\n76: // ratchet and the other baseline readers replay at midnight UTC.\n77: const SCORING_DATE_ENV = 'SPECKIT_EVAL_BASELINE_SCORING_DATE';\n78: \n79: function isCalendarDate(value) {\n80:   if (!/^\\d{4}-\\d{2}-\\d{2}$/.test(value)) return false;\n81:   const parsed = new Date(`${value}T00:00:00Z`);\n82:   return !Number.isNaN(parsed.getTime()) && parsed.toISOString().slice(0, 10) === value;\n83: }\n84: \n85: function resolveScoringDate() {\n86:   const fromEnv = process.env[SCORING_DATE_ENV];\n87:   if (fromEnv !== undefined && fromEnv !== '') {\n88:     if (!isCalendarDate(fromEnv)) {\n89:       process.stderr.write(`capture-scorer-eval-baseline.mjs: ${SCORING_DATE_ENV} must be a calendar date (YYYY-MM-DD), got: ${fromEnv}\\n`);\n90:       process.exit(2);\n91:     }\n92:     return fromEnv;\n93:   }\n94:   let recorded;\n95:   try {\n96:     recorded = JSON.parse(readFileSync(OUTPUT_JSON, 'utf8')).capturedAt;\n97:   } catch {\n98:     recorded = undefined;\n99:   }\n100:   if (typeof recorded === 'string' && isCalendarDate(recorded)) return recorded;\n101:   process.stderr.write(`capture-scorer-eval-baseline.mjs: no recorded scoring date in ${OUTPUT_JSON}; set ${SCORING_DATE_ENV}=YYYY-MM-DD\\n`);\n102:   process.exit(2);\n103: }\n104: \n105: const CAPTURED_AT = resolveScoringDate();\n106: const SCORING_INSTANT = Date.parse(`${CAPTURED_AT}T00:00:00Z`);\n107: const RealDate = Date;\n108: globalThis.Date = class extends RealDate {\n109:   constructor(...args) {\n110:     if (args.length === 0) super(SCORING_INSTANT);\n111:     else super(...args);\n112:   }\n113: \n114:   static now() {\n115:     return SCORING_INSTANT;\n116:   }\n117: };\n118: \n119: const { scoreAdvisorPrompt } = await import(join(DIST, 'lib/scorer/fusion.js'));\n120: const { mergedSkillForAlias, skillMatchesAlias } = await import(join(DIST, 'lib/scorer/aliases.js'));\n121: const { findAdvisorWorkspaceRoot } = await import(join(DIST, 'lib/utils/workspace-root.js'));\n122: \n123: const SENTINEL = '.skilled/skills/system-spec-kit/SKILL.md';\n124: const WORKSPACE_ROOT = findAdvisorWorkspaceRoot(HERE, { maxDepth: 14, sentinel: SENTINEL });\n125: \n126: // ───────────────────────────────────────────────────────────────────\n127: // 4. HELPERS\n128: // ───────────────────────────────────────────────────────────────────\n129: \n130: function sha256File(path) {\n131:   return `sha256:${createHash('sha256').update(readFileSync(path)).digest('hex')}`;\n132: }\n133: \n134: function readJsonl(path) {\n135:   return readFileSync(path, 'utf8').trim().split('\\n').filter(Boolean).map((line) => JSON.parse(line));\n136: }\n137: \n138: function topSkill(prompt) {\n139:   return scoreAdvisorPrompt(prompt, { workspaceRoot: WORKSPACE_ROOT }).topSkill;\n140: }\n141: \n142: // Alias-aware top-1 match: corpus/holdout labels may use superseded skill ids or\n143: // folded deep-loop mode ids, canonicalized on both sides before comparing. A\n144: // both-null result is a correct abstain.\n145: function isTop1Correct(top, goldRaw) {\n146:   const gold = goldRaw === 'none' ? null : goldRaw;\n147:   const expected = gold === null ? null : mergedSkillForAlias(gold);\n148:   const actual = top === null ? null : mergedSkillForAlias(top);\n149:   return actual === expected\n150:     || (actual !== null && expected !== null && skillMatchesAlias(actual, expected));\n151: }\n152: \n153: function accuracy(correct, total) {\n154:   return total > 0 ? Number((correct / total).toFixed(4)) : 0;\n155: }\n156: \n157: // A count says how many prompts fail, never which ones. A scoring change is judged\n158: // against the failing prompts themselves, so each set records them as it scores.\n159: const misses = [];\n160: \n161: function recordMiss(set, row, top) {\n162:   misses.push({ set, id: row.id, gold: row.skill_top_1, got: top === null ? 'none' : top, prompt: row.prompt });\n163: }\n164: \n165: function scoreSet(rows, set) {\n166:   let correct = 0;\n167:   for (const row of rows) {\n168:     const top = topSkill(row.prompt);\n169:     if (isTop1Correct(top, row.skill_top_1)) correct += 1;\n170:     else if (set) recordMiss(set, row, top);\n171:   }\n172:   return { correct, total: rows.length, accuracy: accuracy(correct, rows.length) };\n173: }\n174: \n175: // ───────────────────────────────────────────────────────────────────\n176: // 5. CORE LOGIC\n177: // ───────────────────────────────────────────────────────────────────\n178: \n179: const corpus = readJsonl(CORPUS_JSONL);\n180: let unknown = 0;\n181: let goldNoneFalseFire = 0;\n182: let fullCorrect = 0;\n183: for (const row of corpus) {\n184:   const top = topSkill(row.prompt);\n185:   if (top === null) unknown += 1;\n186:   if (row.skill_top_1 === 'none' && top !== null) goldNoneFalseFire += 1;\n187:   if (isTop1Correct(top, row.skill_top_1)) fullCorrect += 1;\n188:   else recordMiss('full_corpus', row, top);\n189: }\n190: \n191: const holdout = scoreSet(readJsonl(HOLDOUT_JSONL), 'holdout');\n192: \n193: const ambiguityRows = readJsonl(AMBIGUITY_JSONL);\n194: const ambiguity = scoreSet(ambiguityRows, 'ambiguity');\n195: const tau = ambiguityRows.length > 0 ? ambiguityRows[0].tau : null;\n196: \n197: const reviewRows = corpus.filter((row) => row.bucket === 'true_read_only');\n198: const memorySaveRows = corpus.filter((row) => row.bucket === 'memory_save_resume');\n199: const review = scoreSet(reviewRows);\n200: const memorySave = scoreSet(memorySaveRows);\n201: \n202: // Delegation uses strict equality: the targets are top-level skill ids with no\n203: // alias folding, and 'none' is a correct abstain.\n204: const delegationCases = JSON.parse(readFileSync(DELEGATION_JSON, 'utf8')).cases;\n205: let delegationCorrect = 0;\n206: for (const testCase of delegationCases) {\n207:   const expected = testCase.expectedTop === 'none' ? null : testCase.expectedTop;\n208:   if (topSkill(testCase.prompt) === expected) delegationCorrect += 1;\n209: }\n210: \n211: const headSha = (() => {\n212:   const result = spawnSync('git', ['rev-parse', '--short', 'HEAD'], { cwd: WORKSPACE_ROOT, encoding: 'utf8' });\n213:   return result.status === 0 ? result.stdout.trim() : 'unknown';\n214: })();\n215: \n216: const baseline = {\n217:   schemaVersion: 1,\n218:   capturedAt: CAPTURED_AT,\n219:   capturedAtSha: headSha,\n220:   corpusSha256: sha256File(CORPUS_JSONL),\n221:   holdoutSha256: sha256File(HOLDOUT_JSONL),\n222:   ambiguitySha256: sha256File(AMBIGUITY_JSONL),\n223:   env: {\n224:     SKILL_ADVISOR_DISABLE_BUILTIN_SEMANTIC: '1',\n225:     SYSTEM_SKILL_ADVISOR_DB_DIR: '<empty-dir>',\n226:     projectionSource: 'filesystem',\n227:   },\n228:   metrics: {\n229:     full_corpus_top1: { correct: fullCorrect, total: corpus.length, accuracy: accuracy(fullCorrect, corpus.length) },\n230:     unknown_count: { value: unknown },\n231:     gold_none_false_fire: { value: goldNoneFalseFire },\n232:     holdout_top1: holdout,\n233:     ambiguity_top1: { correct: ambiguity.correct, total: ambiguity.total, accuracy: ambiguity.accuracy, tau },\n234:     buckets: {\n235:       review: review,\n236:       memory_save: memorySave,\n237:       delegation: { correct: delegationCorrect, total: delegationCases.length, accuracy: accuracy(delegationCorrect, delegationCases.length) },\n238:     },\n239:   },\n240: };\n241: \n242: // ───────────────────────────────────────────────────────────────────\n243: // 6. CLI ENTRY\n244: // ───────────────────────────────────────────────────────────────────\n245: \n246: const serialized = JSON.stringify(baseline, null, 2) + '\\n';\n247: if (process.argv.includes('--misses')) {\n248:   // The review and memory-save buckets are slices of the full corpus, so their\n249:   // failing prompts are already listed under it.\n250:   for (const miss of misses) console.log(JSON.stringify(miss));\n251: } else {\n252:   if (process.argv.includes('--write')) {\n253:     writeFileSync(OUTPUT_JSON, serialized, 'utf8');\n254:     console.log(`wrote baseline -> ${OUTPUT_JSON}`);\n255:   }\n256:   console.log(serialized);\n257: }"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/capture-scorer-eval-baseline.mjs\"}"},"time":{"start":1794530140184,"end":1794530141139}}}}
