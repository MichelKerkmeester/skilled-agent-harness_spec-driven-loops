{"type":"tool_use","timestamp":1794526799615,"sessionID":"ses_e2dded06dffeT6AEa8rb4Zuf2e","part":{"partID":"prt_1d221e56b0016YVcyilEE1LTXd","sessionID":"ses_e2dded06dffeT6AEa8rb4Zuf2e","messageID":"msg_1d221d4cc0013NJC2tWOJUtpgo","type":"tool","id":"call_8a60dbbb11ea4bcf92f55132","tool":"read","state":{"status":"completed","input":{"path":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/tests/schemas/advisor-tool-schemas.vitest.ts"},"output":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/tests/schemas/advisor-tool-schemas.vitest.ts, lines 1-276\n1: // ───────────────────────────────────────────────────────────────\n2: // MODULE: Advisor Tool Schemas Tests\n3: // ───────────────────────────────────────────────────────────────\n4: // Bound workspaceRoot validation against the allowlist\n5: // (repo root + os.tmpdir() + explicit env extras).\n6: \n7: import { describe, expect, it } from 'vitest';\n8: import { mkdtempSync, rmSync, mkdirSync, symlinkSync, writeFileSync } from 'node:fs';\n9: import { tmpdir } from 'node:os';\n10: import { join, resolve } from 'node:path';\n11: \n12: import { findAdvisorWorkspaceRoot } from '../../lib/utils/workspace-root.js';\n13: import {\n14:   AdvisorRecommendInputSchema,\n15:   AdvisorRecommendOutputSchema,\n16:   AdvisorValidateInputSchema,\n17:   AdvisorStatusInputSchema,\n18:   AdvisorRebuildInputSchema,\n19:   detectRepoRoot,\n20:   isAllowedWorkspaceRoot,\n21:   isWiredToSourceTree,\n22: } from '../../schemas/advisor-tool-schemas.js';\n23: \n24: describe('AdvisorRecommendInputSchema workspaceRoot bounding (F-005-A5-01)', () => {\n25:   it('accepts paths under os.tmpdir()', () => {\n26:     const tmpDir = mkdtempSync(join(tmpdir(), 'speckit-advisor-test-'));\n27:     try {\n28:       expect(() => AdvisorRecommendInputSchema.parse({\n29:         workspaceRoot: tmpDir,\n30:         prompt: 'test prompt',\n31:       })).not.toThrow();\n32:     } finally {\n33:       rmSync(tmpDir, { recursive: true, force: true });\n34:     }\n35:   });\n36: \n37:   it('accepts the repo root', () => {\n38:     // The advisor schema's repo-root detection walks up from cwd looking\n39:     // for .skilled/skill. When tests run from the mcp_server directory,\n40:     // resolve('../..') is the repo root.\n41:     const repoRoot = resolve(process.cwd(), '..', '..', '..');\n42:     expect(isAllowedWorkspaceRoot(repoRoot) || isAllowedWorkspaceRoot(resolve(process.cwd()))).toBe(true);\n43:   });\n44: \n45:   it('rejects an arbitrary path outside the allowlist', () => {\n46:     // /etc is not under the repo root or tmpdir on any normal system.\n47:     expect(() => AdvisorRecommendInputSchema.parse({\n48:       workspaceRoot: '/etc',\n49:       prompt: 'test prompt',\n50:     })).toThrow(/workspaceRoot must resolve under/);\n51:   });\n52: \n53:   it('treats workspaceRoot as optional when omitted', () => {\n54:     expect(() => AdvisorRecommendInputSchema.parse({\n55:       prompt: 'test prompt',\n56:     })).not.toThrow();\n57:   });\n58: });\n59: \n60: describe('AdvisorRecommendOutputSchema runtime lane health', () => {\n61:   it('accepts prompt-safe degraded lane metadata', () => {\n62:     const parsed = AdvisorRecommendOutputSchema.parse({\n63:       workspaceRoot: process.cwd(),\n64:       effectiveThresholds: {\n65:         confidenceThreshold: 0.8,\n66:         uncertaintyThreshold: 0.35,\n67:         confidenceOnly: false,\n68:       },\n69:       recommendations: [],\n70:       ambiguous: false,\n71:       freshness: 'stale',\n72:       trustState: {\n73:         state: 'stale',\n74:         reason: 'SOURCE_NEWER_THAN_SKILL_GRAPH',\n75:         generation: 7,\n76:         checkedAt: '2026-04-20T00:00:00.000Z',\n77:         lastLiveAt: null,\n78:       },\n79:       generatedAt: '2026-04-20T00:00:00.000Z',\n80:       cache: {\n81:         hit: false,\n82:         sourceSignaturePresent: true,\n83:       },\n84:       runtimeLaneHealth: {\n85:         liveLaneCount: 4,\n86:         degradedLanes: ['graph_causal'],\n87:       },\n88:     });\n89: \n90:     expect(parsed.runtimeLaneHealth?.degradedLanes).toEqual(['graph_causal']);\n91:   });\n92: });\n93: \n94: describe('AdvisorValidateInputSchema workspaceRoot bounding (F-005-A5-01)', () => {\n95:   it('accepts paths under os.tmpdir()', () => {\n96:     const tmpDir = mkdtempSync(join(tmpdir(), 'speckit-advisor-validate-'));\n97:     try {\n98:       expect(() => AdvisorValidateInputSchema.parse({\n99:         confirmHeavyRun: true,\n100:         workspaceRoot: tmpDir,\n101:       })).not.toThrow();\n102:     } finally {\n103:       rmSync(tmpDir, { recursive: true, force: true });\n104:     }\n105:   });\n106: \n107:   it('rejects an arbitrary path outside the allowlist', () => {\n108:     expect(() => AdvisorValidateInputSchema.parse({\n109:       confirmHeavyRun: true,\n110:       workspaceRoot: '/etc',\n111:     })).toThrow(/workspaceRoot must resolve under/);\n112:   });\n113: });\n114: \n115: describe('AdvisorStatusInputSchema workspaceRoot bounding (F-005-A5-01)', () => {\n116:   it('rejects an arbitrary path outside the allowlist', () => {\n117:     expect(() => AdvisorStatusInputSchema.parse({\n118:       workspaceRoot: '/etc',\n119:     })).toThrow(/workspaceRoot must resolve under/);\n120:   });\n121: \n122:   it('accepts a tmpdir path', () => {\n123:     const tmpDir = mkdtempSync(join(tmpdir(), 'speckit-advisor-status-'));\n124:     try {\n125:       expect(() => AdvisorStatusInputSchema.parse({\n126:         workspaceRoot: tmpDir,\n127:       })).not.toThrow();\n128:     } finally {\n129:       rmSync(tmpDir, { recursive: true, force: true });\n130:     }\n131:   });\n132: });\n133: \n134: describe('AdvisorRebuildInputSchema workspaceRoot bounding (F-005-A5-01)', () => {\n135:   it('rejects an arbitrary path outside the allowlist', () => {\n136:     expect(() => AdvisorRebuildInputSchema.parse({\n137:       workspaceRoot: '/etc',\n138:     })).toThrow(/workspaceRoot must resolve under/);\n139:   });\n140: \n141:   it('treats workspaceRoot as optional', () => {\n142:     expect(() => AdvisorRebuildInputSchema.parse({\n143:       force: true,\n144:     })).not.toThrow();\n145:   });\n146: });\n147: \n148: describe('isAllowedWorkspaceRoot (F-005-A5-01)', () => {\n149:   it('canonicalizes via realpath before checking allowlist', () => {\n150:     // Create a tmp dir, then a symlink in tmpdir pointing to it.\n151:     const realDir = mkdtempSync(join(tmpdir(), 'speckit-real-'));\n152:     try {\n153:       // os.tmpdir() symlinks resolve to themselves on macOS (e.g. /var → /private/var),\n154:       // which is exactly why we canonicalize. The canonical form is itself in\n155:       // the allowlist because the allowlist list includes the canonicalized\n156:       // tmpdir prefix.\n157:       expect(isAllowedWorkspaceRoot(realDir)).toBe(true);\n158:     } finally {\n159:       rmSync(realDir, { recursive: true, force: true });\n160:     }\n161:   });\n162: \n163:   it('rejects unresolvable absolute paths outside the allowlist', () => {\n164:     expect(isAllowedWorkspaceRoot('/this-path-does-not-exist-anywhere-real')).toBe(false);\n165:   });\n166: \n167:   it('rejects empty string', () => {\n168:     expect(isAllowedWorkspaceRoot('')).toBe(false);\n169:   });\n170: \n171:   it('respects SPECKIT_ADVISOR_WORKSPACE_ALLOWLIST env extras at module load time', () => {\n172:     // Module-level allowlist is captured at import; this assertion just\n173:     // confirms a tmpdir path resolves true regardless of process.env state.\n174:     const tmpDir = mkdtempSync(join(tmpdir(), 'speckit-env-extras-'));\n175:     try {\n176:       mkdirSync(join(tmpDir, 'nested'), { recursive: true });\n177:       expect(isAllowedWorkspaceRoot(join(tmpDir, 'nested'))).toBe(true);\n178:     } finally {\n179:       rmSync(tmpDir, { recursive: true, force: true });\n180:     }\n181:   });\n182: });\n183: \n184: describe('isWiredToSourceTree admits a project linked to this source tree', () => {\n185:   // A project linked by /doctor:symlink holds `.skilled -> <source>/.skilled`, while the\n186:   // daemon runs from the source tree, so the prefix allowlist alone refuses it. Every\n187:   // fixture sits under tmpdir, which the prefix allowlist admits, so the helper is\n188:   // called with an explicit source root to keep the assertion discriminating.\n189:   function makeSource(base: string, name: string): string {\n190:     const source = join(base, name);\n191:     mkdirSync(join(source, '.skilled', 'skills', 'system-spec-kit'), { recursive: true });\n192:     writeFileSync(join(source, '.skilled', 'skills', 'system-spec-kit', 'SKILL.md'), '# sentinel\\n');\n193:     return source;\n194:   }\n195: \n196:   it('accepts a project whose .skilled links to the source, and its subdirectories', () => {\n197:     const base = mkdtempSync(join(tmpdir(), 'speckit-wired-'));\n198:     try {\n199:       const source = makeSource(base, 'source');\n200:       const project = join(base, 'project');\n201:       mkdirSync(join(project, 'src'), { recursive: true });\n202:       symlinkSync(join(source, '.skilled'), join(project, '.skilled'));\n203:       expect(isWiredToSourceTree(project, source)).toBe(true);\n204:       expect(isWiredToSourceTree(join(project, 'src'), source)).toBe(true);\n205:       expect(isWiredToSourceTree(source, source)).toBe(true);\n206:     } finally {\n207:       rmSync(base, { recursive: true, force: true });\n208:     }\n209:   });\n210: \n211:   it('refuses an unlinked directory, a link to another source and a copied tree', () => {\n212:     const base = mkdtempSync(join(tmpdir(), 'speckit-unwired-'));\n213:     try {\n214:       const source = makeSource(base, 'source');\n215:       const otherSource = makeSource(base, 'other-source');\n216:       const plain = join(base, 'plain');\n217:       mkdirSync(plain, { recursive: true });\n218:       const elsewhere = join(base, 'elsewhere');\n219:       mkdirSync(elsewhere, { recursive: true });\n220:       symlinkSync(join(otherSource, '.skilled'), join(elsewhere, '.skilled'));\n221:       const copied = makeSource(base, 'copied');\n222:       expect(isWiredToSourceTree(plain, source)).toBe(false);\n223:       expect(isWiredToSourceTree(elsewhere, source)).toBe(false);\n224:       expect(isWiredToSourceTree(copied, source)).toBe(false);\n225:       expect(isWiredToSourceTree('', source)).toBe(false);\n226:     } finally {\n227:       rmSync(base, { recursive: true, force: true });\n228:     }\n229:   });\n230: });\n231: \n232: describe('detectRepoRoot stays in lockstep with findAdvisorWorkspaceRoot', () => {\n233:   // The allowlist admits every temp path, so it cannot tell the two walks apart. The\n234:   // schema's walk is fed the same trees as the handler's walk instead.\n235:   it('names the same root under each source-root layout, entry name and fallback', () => {\n236:     const root = mkdtempSync(join(tmpdir(), 'speckit-advisor-lockstep-'));\n237:     try {\n238:       const writeSentinel = (repo: string, name: string): void => {\n239:         const skillDir = join(repo, name, 'skills', 'system-spec-kit');\n240:         mkdirSync(skillDir, { recursive: true });\n241:         writeFileSync(join(skillDir, 'SKILL.md'), '# sentinel\\n');\n242:       };\n243:       const today = join(root, 'today');\n244:       writeSentinel(today, '.opencode');\n245:       const skilledOnly = join(root, 'skilled-only');\n246:       writeSentinel(skilledOnly, '.skilled');\n247:       const wholeLink = join(root, 'whole-link');\n248:       writeSentinel(wholeLink, '.skilled');\n249:       symlinkSync('.skilled', join(wholeLink, '.opencode'));\n250:       const leak = join(root, 'leak', '.skilled', 'skills', 'x', '.opencode', 'skills');\n251:       mkdirSync(leak, { recursive: true });\n252:       // Deeper than both fixed walks, so each must fall back. The repository sits under\n253:       // an ancestor named .opencode and holds its tree under .skilled, so hoisting above\n254:       // the outermost segment would pass the repository.\n255:       const nestedRepo = join(root, '.opencode', 'outer', 'repo');\n256:       writeSentinel(nestedRepo, '.skilled');\n257:       const deepStart = join(nestedRepo, '.skilled', 'skills', 'system-spec-kit', ...Array.from({ length: 14 }, () => 'deep'));\n258:       mkdirSync(deepStart, { recursive: true });\n259: \n260:       const cases: ReadonlyArray<readonly [string, string]> = [\n261:         [join(today, '.opencode', 'skills', 'system-spec-kit'), today],\n262:         [join(skilledOnly, '.skilled', 'skills', 'system-spec-kit'), skilledOnly],\n263:         [join(wholeLink, '.opencode', 'skills', 'system-spec-kit'), wholeLink],\n264:         [join(wholeLink, '.skilled', 'skills', 'system-spec-kit'), wholeLink],\n265:         [leak, join(root, 'leak')],\n266:         [deepStart, nestedRepo],\n267:       ];\n268:       for (const [start, expectedRoot] of cases) {\n269:         expect(detectRepoRoot(start)).toBe(resolve(expectedRoot));\n270:         expect(detectRepoRoot(start)).toBe(findAdvisorWorkspaceRoot(start));\n271:       }\n272:     } finally {\n273:       rmSync(root, { recursive: true, force: true });\n274:     }\n275:   });\n276: });","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/tests/schemas/advisor-tool-schemas.vitest.ts, lines 1-276\n1: // ───────────────────────────────────────────────────────────────\n2: // MODULE: Advisor Tool Schemas Tests\n3: // ───────────────────────────────────────────────────────────────\n4: // Bound workspaceRoot validation against the allowlist\n5: // (repo root + os.tmpdir() + explicit env extras).\n6: \n7: import { describe, expect, it } from 'vitest';\n8: import { mkdtempSync, rmSync, mkdirSync, symlinkSync, writeFileSync } from 'node:fs';\n9: import { tmpdir } from 'node:os';\n10: import { join, resolve } from 'node:path';\n11: \n12: import { findAdvisorWorkspaceRoot } from '../../lib/utils/workspace-root.js';\n13: import {\n14:   AdvisorRecommendInputSchema,\n15:   AdvisorRecommendOutputSchema,\n16:   AdvisorValidateInputSchema,\n17:   AdvisorStatusInputSchema,\n18:   AdvisorRebuildInputSchema,\n19:   detectRepoRoot,\n20:   isAllowedWorkspaceRoot,\n21:   isWiredToSourceTree,\n22: } from '../../schemas/advisor-tool-schemas.js';\n23: \n24: describe('AdvisorRecommendInputSchema workspaceRoot bounding (F-005-A5-01)', () => {\n25:   it('accepts paths under os.tmpdir()', () => {\n26:     const tmpDir = mkdtempSync(join(tmpdir(), 'speckit-advisor-test-'));\n27:     try {\n28:       expect(() => AdvisorRecommendInputSchema.parse({\n29:         workspaceRoot: tmpDir,\n30:         prompt: 'test prompt',\n31:       })).not.toThrow();\n32:     } finally {\n33:       rmSync(tmpDir, { recursive: true, force: true });\n34:     }\n35:   });\n36: \n37:   it('accepts the repo root', () => {\n38:     // The advisor schema's repo-root detection walks up from cwd looking\n39:     // for .skilled/skill. When tests run from the mcp_server directory,\n40:     // resolve('../..') is the repo root.\n41:     const repoRoot = resolve(process.cwd(), '..', '..', '..');\n42:     expect(isAllowedWorkspaceRoot(repoRoot) || isAllowedWorkspaceRoot(resolve(process.cwd()))).toBe(true);\n43:   });\n44: \n45:   it('rejects an arbitrary path outside the allowlist', () => {\n46:     // /etc is not under the repo root or tmpdir on any normal system.\n47:     expect(() => AdvisorRecommendInputSchema.parse({\n48:       workspaceRoot: '/etc',\n49:       prompt: 'test prompt',\n50:     })).toThrow(/workspaceRoot must resolve under/);\n51:   });\n52: \n53:   it('treats workspaceRoot as optional when omitted', () => {\n54:     expect(() => AdvisorRecommendInputSchema.parse({\n55:       prompt: 'test prompt',\n56:     })).not.toThrow();\n57:   });\n58: });\n59: \n60: describe('AdvisorRecommendOutputSchema runtime lane health', () => {\n61:   it('accepts prompt-safe degraded lane metadata', () => {\n62:     const parsed = AdvisorRecommendOutputSchema.parse({\n63:       workspaceRoot: process.cwd(),\n64:       effectiveThresholds: {\n65:         confidenceThreshold: 0.8,\n66:         uncertaintyThreshold: 0.35,\n67:         confidenceOnly: false,\n68:       },\n69:       recommendations: [],\n70:       ambiguous: false,\n71:       freshness: 'stale',\n72:       trustState: {\n73:         state: 'stale',\n74:         reason: 'SOURCE_NEWER_THAN_SKILL_GRAPH',\n75:         generation: 7,\n76:         checkedAt: '2026-04-20T00:00:00.000Z',\n77:         lastLiveAt: null,\n78:       },\n79:       generatedAt: '2026-04-20T00:00:00.000Z',\n80:       cache: {\n81:         hit: false,\n82:         sourceSignaturePresent: true,\n83:       },\n84:       runtimeLaneHealth: {\n85:         liveLaneCount: 4,\n86:         degradedLanes: ['graph_causal'],\n87:       },\n88:     });\n89: \n90:     expect(parsed.runtimeLaneHealth?.degradedLanes).toEqual(['graph_causal']);\n91:   });\n92: });\n93: \n94: describe('AdvisorValidateInputSchema workspaceRoot bounding (F-005-A5-01)', () => {\n95:   it('accepts paths under os.tmpdir()', () => {\n96:     const tmpDir = mkdtempSync(join(tmpdir(), 'speckit-advisor-validate-'));\n97:     try {\n98:       expect(() => AdvisorValidateInputSchema.parse({\n99:         confirmHeavyRun: true,\n100:         workspaceRoot: tmpDir,\n101:       })).not.toThrow();\n102:     } finally {\n103:       rmSync(tmpDir, { recursive: true, force: true });\n104:     }\n105:   });\n106: \n107:   it('rejects an arbitrary path outside the allowlist', () => {\n108:     expect(() => AdvisorValidateInputSchema.parse({\n109:       confirmHeavyRun: true,\n110:       workspaceRoot: '/etc',\n111:     })).toThrow(/workspaceRoot must resolve under/);\n112:   });\n113: });\n114: \n115: describe('AdvisorStatusInputSchema workspaceRoot bounding (F-005-A5-01)', () => {\n116:   it('rejects an arbitrary path outside the allowlist', () => {\n117:     expect(() => AdvisorStatusInputSchema.parse({\n118:       workspaceRoot: '/etc',\n119:     })).toThrow(/workspaceRoot must resolve under/);\n120:   });\n121: \n122:   it('accepts a tmpdir path', () => {\n123:     const tmpDir = mkdtempSync(join(tmpdir(), 'speckit-advisor-status-'));\n124:     try {\n125:       expect(() => AdvisorStatusInputSchema.parse({\n126:         workspaceRoot: tmpDir,\n127:       })).not.toThrow();\n128:     } finally {\n129:       rmSync(tmpDir, { recursive: true, force: true });\n130:     }\n131:   });\n132: });\n133: \n134: describe('AdvisorRebuildInputSchema workspaceRoot bounding (F-005-A5-01)', () => {\n135:   it('rejects an arbitrary path outside the allowlist', () => {\n136:     expect(() => AdvisorRebuildInputSchema.parse({\n137:       workspaceRoot: '/etc',\n138:     })).toThrow(/workspaceRoot must resolve under/);\n139:   });\n140: \n141:   it('treats workspaceRoot as optional', () => {\n142:     expect(() => AdvisorRebuildInputSchema.parse({\n143:       force: true,\n144:     })).not.toThrow();\n145:   });\n146: });\n147: \n148: describe('isAllowedWorkspaceRoot (F-005-A5-01)', () => {\n149:   it('canonicalizes via realpath before checking allowlist', () => {\n150:     // Create a tmp dir, then a symlink in tmpdir pointing to it.\n151:     const realDir = mkdtempSync(join(tmpdir(), 'speckit-real-'));\n152:     try {\n153:       // os.tmpdir() symlinks resolve to themselves on macOS (e.g. /var → /private/var),\n154:       // which is exactly why we canonicalize. The canonical form is itself in\n155:       // the allowlist because the allowlist list includes the canonicalized\n156:       // tmpdir prefix.\n157:       expect(isAllowedWorkspaceRoot(realDir)).toBe(true);\n158:     } finally {\n159:       rmSync(