8:       for (const [start, expectedRoot] of cases) {\n269:         expect(detectRepoRoot(start)).toBe(resolve(expectedRoot));\n270:         expect(detectRepoRoot(start)).toBe(findAdvisorWorkspaceRoot(start));\n271:       }\n272:     } finally {\n273:       rmSync(root, { recursive: true, force: true });\n274:     }\n275:   });\n276: });"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/tests/schemas/advisor-tool-schemas.vitest.ts\"}"},"time":{"start":1794526799211,"end":1794526799615}}}}
