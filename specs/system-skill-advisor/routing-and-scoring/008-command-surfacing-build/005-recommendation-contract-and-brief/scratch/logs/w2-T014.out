:     try {\n199:       const source = makeSource(base, 'source');\n200:       const project = join(base, 'project');\n201:       mkdirSync(join(project, 'src'), { recursive: true });\n202:       symlinkSync(join(source, '.skilled'), join(project, '.skilled'));\n203:       expect(isWiredToSourceTree(project, source)).toBe(true);\n204:       expect(isWiredToSourceTree(join(project, 'src'), source)).toBe(true);\n205:       expect(isWiredToSourceTree(source, source)).toBe(true);\n206:     } finally {\n207:       rmSync(base, { recursive: true, force: true });\n208:     }\n209:   });\n210: \n211:   it('refuses an unlinked directory, a link to another source and a copied tree', () => {\n212:     const base = mkdtempSync(join(tmpdir(), 'speckit-unwired-'));\n213:     try {\n214:       const source = makeSource(base, 'source');\n215:       const otherSource = makeSource(base, 'other-source');\n216:       const plain = join(base, 'plain');\n217:       mkdirSync(plain, { recursive: true });\n218:       const elsewhere = join(base, 'elsewhere');\n219:       mkdirSync(elsewhere, { recursive: true });\n220:       symlinkSync(join(otherSource, '.skilled'), join(elsewhere, '.skilled'));\n221:       const copied = makeSource(base, 'copied');\n222:       expect(isWiredToSourceTree(plain, source)).toBe(false);\n223:       expect(isWiredToSourceTree(elsewhere, source)).toBe(false);\n224:       expect(isWiredToSourceTree(copied, source)).toBe(false);\n225:       expect(isWiredToSourceTree('', source)).toBe(false);\n226:     } finally {\n227:       rmSync(base, { recursive: true, force: true });\n228:     }\n229:   });\n230: });\n231: \n232: describe('detectRepoRoot stays in lockstep with findAdvisorWorkspaceRoot', () => {\n233:   // The allowlist admits every temp path, so it cannot tell the two walks apart. The\n234:   // schema's walk is fed the same trees as the handler's walk instead.\n235:   it('names the same root under each source-root layout, entry name and fallback', () => {\