ng(input.prompt, () => scoreAdvisorPrompt(input.prompt, {\n591:     workspaceRoot,\n592:     confidenceThreshold: input.options?.confidenceThreshold,\n593:     uncertaintyThreshold: input.options?.uncertaintyThreshold,\n594:     runtimeLaneHealth: runtimeLaneHealthForStatus(status),\n595:   }));\n596:   const recommendations = result.recommendations\n597:     .map((recommendation) => publicRecommendation(\n598:       recommendation,\n599:       Boolean(input.options?.includeAttribution),\n600:       input.prompt,\n601:     ))\n602:     .filter((recommendation): recommendation is NonNullable<typeof recommendation> => Boolean(recommendation))\n603:     .slice(0, topK);\n604:   const degradedLanes = result.metrics.degradedLanes ?? [];\n605:   const warnings = outputWarnings(status, result);\n606:   const abstainReasons = outputAbstainReasons(input, result);\n607:   const output: AdvisorRecommendOutput = {\n608:     workspaceRoot,\n609:     effectiveThresholds,\n610:     recommendations,\n611:     ambiguous: result.ambiguous,\n612:     freshness: status.freshness,\n613:     trustState: status.trustState,\n614:     generatedAt: new Date().toISOString(),\n615:     cache: {\n616:       hit: false,\n617:       sourceSignaturePresent: status.generation > 0 || status.lastGenerationBump !== null,\n618:     },\n619:     _shadow: {\n620:       model: 'advisor-shadow-learned-weights-v1',\n621:       liveWeightsFrozen: true,\n622:       recommendations: publicShadowRecommendations(result.recommendations, topK),\n623:     },\n624:     ...(degradedLanes.length > 0 ? {\n625:       runtimeLaneHealth: {\n626:         liveLaneCount: result.metrics.liveLaneCount,\n627:         degradedLanes: [...degradedLanes],\n628:       },\n629:     } : {}),\n[Output truncated. Continue reading with offset: 630]","title":"read","metadata":{"metadata":{"truncated":true},"content":[{"type":"text","text":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/s