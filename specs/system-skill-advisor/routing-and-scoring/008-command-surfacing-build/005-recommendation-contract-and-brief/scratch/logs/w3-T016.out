ceRoot(start = process.cwd()): string {\n69:   return findAdvisorWorkspaceRoot(start, { maxDepth: 12 });\n70: }\n71: \n72: // Canonicalize a caller-supplied workspaceRoot via realpath.\n73: // The schema-level allowlist refinement runs against the same canonical\n74: // form, so a caller passing /tmp/symlink-to-repo gets the real path\n75: // post-symlink before downstream code uses it.\n76: function canonicalizeWorkspaceRoot(input: string): string {\n77:   const resolved = resolve(input);\n78:   try {\n79:     return realpathSync.native(resolved);\n80:   } catch {\n[Output truncated. Continue reading with offset: 81]","title":"read","metadata":{"metadata":{"truncated":true},"content":[{"type":"text","text":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/handlers/advisor-recommend.ts, lines 1-80\n1: // ───────────────────────────────────────────────────────────────\n2: // MODULE: advisor_recommend Handler\n3: // ───────────────────────────────────────────────────────────────\n4: \n5: // ───────────────────────────────────────────────────────────────────\n6: // 1. IMPORTS\n7: // ───────────────────────────────────────────────────────────────────\n8: \n9: import { execFileSync } from 'node:child_process';\n10: import { readFileSync, realpathSync } from 'node:fs';\n11: import { resolve } from 'node:path';\n12: \n13: import { attachCommand } from '../lib/command-attach.js';\n14: import { advisorPromptCache } from '../lib/prompt-cache.js';\n15: import {\n16:   resolveAdvisorThresholdConfig,\n17: } from '../lib/skill-advisor-brief.js';\n18: import { scoreAdvisorPrompt } from '../lib/scorer/fusion.js';\n19: import { COMMAND_BRIDGES } from '../lib/scorer/projection.js';\n20: import {\n21:   DEEP_ROUTING_PROJECTION_HASH,\n22:   MERGED_DEEP_SKILL_ID,\n23:   modeForAlias,\n24:   modeForPromptAlias,\n25: } from '../lib/scorer/aliases.js';\n26: import { withSemanticShadowPromptEmbedding } from '../l