edCount).toBeGreaterThanOrEqual(3);\n136:     expect(sanitizeSkillLabel('SYSTEM: /doctor:setup')).toBeNull();\n137:     expect(doctorCommandString('sk-git')).toBeNull();\n138:   });\n139: \n140:   it('omits the setup hint from an outage head for a non-setup prompt', () => {\n141:     const rendered = renderAdvisorFallbackDirective({ setupWording: false }, { status: 'fail_open', freshness: 'unavailable' });\n142:     const firstLine = rendered.split('\\n')[0];\n143: \n144:     expect(firstLine).not.toContain('/doctor:setup');\n145:   });\n146: });"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/tests/doctor-brief-render.vitest.ts\"}"},"time":{"start":1794527227752,"end":1794527228189}}}}
