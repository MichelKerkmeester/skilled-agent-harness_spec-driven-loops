{"type":"tool_use","timestamp":1794527177928,"sessionID":"ses_e2dd8cacaffeYX7eAhuv52v3jL","part":{"partID":"prt_1d227a8ef0017uC70WyM4FZBis","sessionID":"ses_e2dd8cacaffeYX7eAhuv52v3jL","messageID":"msg_1d2278f16001oPISOTRa11qH7N","type":"tool","id":"call_bd020d5663cc4a41912d8a09","tool":"read","state":{"status":"completed","input":{"path":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/lib/render.ts"},"output":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/lib/render.ts, lines 1-615\n1: // ───────────────────────────────────────────────────────────────\n2: // MODULE: Skill Advisor Brief Renderer\n3: // ───────────────────────────────────────────────────────────────\n4: \n5: import { canonicalFold } from './shared/unicode-normalization.js';\n6: import { resolvedConfidenceThreshold, resolvedUncertaintyThreshold } from './compat/contract.js';\n7: import {\n8:   buildAdvisorRenderPlan,\n9:   evaluateDeliveryState,\n10:   isObservedDeliveryReceipt,\n11:   observeRenderedAdvisorPolicy,\n12:   POLICY_COMMENT_HYGIENE_ID,\n13:   recordObservedPolicyDelivery,\n14:   ROUTE_ADVISOR_ID,\n15:   SHADOW_DELIVERY_STATE_MACHINE,\n16:   type DeliveryStateMachine,\n17:   type DeliveryStateReceipt,\n18:   type DeliveryStateName,\n19:   type DeliveryStateSignals,\n20: } from './policy-plan.js';\n21: import { isAmbiguousTopTwo } from './scorer/ambiguity.js';\n22: import type { AdvisorRecommendation } from './subprocess.js';\n23: import type { AdvisorScoredRecommendation } from './scorer/types.js';\n24: import type { AdvisorHookResult } from './skill-advisor-brief.js';\n25: \n26: // ───────────────────────────────────────────────────────────────\n27: // 1. TYPES\n28: // ───────────────────────────────────────────────────────────────\n29: \n30: export interface AdvisorBriefRenderOptions {\n31:   readonly tokenCap?: number;\n32:   readonly thresholdConfig?: {\n33:     readonly confidenceThreshold?: number;\n34:     readonly uncertaintyThreshold?: number;\n35:     readonly confidenceOnly?: boolean;\n36:   };\n37:   readonly deliveryState?: ShadowDeliveryRenderOptions;\n38:   /**\n39:    * True when prompts use set up, set-up or setup wording, install or reinstall wording\n40:    * including installation and installer, configure or configuration wording or `check`\n41:    * followed within three words by environment, env, config, hooks, tools, tooling,\n42:    * toolchain or skilled. The renderer never reads prompt text.\n43:    */\n44:   readonly setupWording?: boolean;\n45: }\n46: \n47: export interface ShadowDeliveryRenderOptions extends DeliveryStateSignals {\n48:   readonly runtime?: string;\n49:   readonly candidate?: string | null;\n50:   readonly stateMachine?: DeliveryStateMachine;\n51:   readonly deliveryConfirmed?: boolean;\n52:   readonly receipt?: DeliveryStateReceipt;\n53:   readonly transformMessageIdentity?: string | null;\n54:   readonly onShadowLog?: (record: ShadowRouteOnlyLogRecord) => void;\n55: }\n56: \n57: export interface ShadowRouteOnlyLogRecord {\n58:   readonly shadowId: string;\n59:   readonly sessionKnown: boolean;\n60:   readonly epoch: number;\n61:   readonly policySetHash: string;\n62:   readonly routeState: DeliveryStateName | null;\n63:   readonly emittedByteCount: number;\n64:   readonly routeOnlyByteCount: number;\n65:   readonly savedBytes: number;\n66: }\n67: \n68: export interface AdvisorBriefRenderableResult {\n69:   readonly status: 'ok' | 'stale' | 'skipped' | 'degraded' | 'fail_open';\n70:   readonly freshness: 'live' | 'stale' | 'absent' | 'unavailable';\n71:   readonly recommendations: readonly AdvisorRecommendation[];\n72:   readonly ambiguous?: boolean;\n73:   readonly metrics?: {\n74:     readonly tokenCap?: number;\n75:   } | null;\n76:   readonly sharedPayload?: {\n77:     readonly metadata?: {\n78:       readonly skillLabel?: string | null;\n79:     } | null;\n80:   } | null;\n81: }\n82: \n83: export type AdvisorFallbackCase = 'outage' | 'no-match' | 'skipped';\n84: export type AdvisorFallbackClassification =\n85:   | {\n86:     readonly fallbackCase: 'outage';\n87:     readonly outageLabel: 'absent' | 'degraded' | 'fail_open';\n88:   }\n89:   | {\n90:     readonly fallbackCase: 'no-match' | 'skipped';\n91:   };\n92: \n93: // ───────────────────────────────────────────────────────────────\n94: // 2. CONSTANTS\n95: // ───────────────────────────────────────────────────────────────\n96: \n97: const DEFAULT_TOKEN_CAP = 80;\n98: const AMBIGUOUS_TOKEN_CAP = 120;\n99: const MAX_TOKEN_CAP = 120;\n100: const TOKEN_TO_CHAR_ESTIMATE = 4;\n101: const INSTRUCTION_LABEL_PATTERN =\n102:   /^\\s*(SYSTEM|INSTRUCTION|IGNORE|EXECUTE)\\s*[:=]|^\\s*(<!--|```)|\\b(ignore\\s+(previous|all)\\s+instructions|system\\s*:|instruction\\s*:|execute\\s*:|developer\\s*:|assistant\\s*:)/i;\n103: const CONTROL_CHAR_PATTERN = /[\\u0000-\\u0008\\u000B\\u000C\\u000E-\\u001F\\u007F]/g;\n104: const ROUTE_ONLY_SHADOW_ID = 'shadow.route-only.advisor.v1';\n105: const OBSERVED_ADVISOR_POLICY_CANDIDATE = '004';\n106: export const ROUTE_ONLY_ESTIMATED_BYTES = 43;\n107: const MAX_SHADOW_ROUTE_ONLY_LOG = 256;\n108: \n109: // Maps each doctor command bridge id to the runnable command string the brief\n110: // shows. Generated by derive-command-bridges.cjs from the doctor route manifest,\n111: // so the renderer never imports the scorer projection (which loads SQLite).\n112: // BEGIN GENERATED DOCTOR COMMANDS\n113: const DOCTOR_COMMAND_STRINGS: Readonly<Record<string, string>> = Object.freeze({\n114:   'command-doctor-agents-md-check': '/doctor:agents-md check',\n115:   'command-doctor-agents-md-embed': '/doctor:agents-md embed',\n116:   'command-doctor-agents-md-restore': '/doctor:agents-md restore',\n117:   'command-doctor-ci-report': '/doctor:ci report',\n118:   'command-doctor-ci-scaffold': '/doctor:ci scaffold',\n119:   'command-doctor-ci-toggle': '/doctor:ci toggle',\n120:   'command-doctor-deep-loop': '/doctor:deep-loop',\n121:   'command-doctor-env': '/doctor:env list',\n122:   'command-doctor-git-hooks': '/doctor:git hooks',\n123:   'command-doctor-git-setup': '/doctor:git setup',\n124:   'command-doctor-git-standards': '/doctor:git standards',\n125:   'command-doctor-helper': '/doctor:helper',\n126:   'command-doctor-install': '/doctor:install',\n127:   'command-doctor-mcp-debug': '/doctor:mcp debug',\n128:   'command-doctor-mcp-install': '/doctor:mcp install',\n129:   'command-doctor-overlay-apply': '/doctor:overlay apply',\n130:   'command-doctor-overlay-repin': '/doctor:overlay repin',\n131:   'command-doctor-overlay-status': '/doctor:overlay status',\n132:   'command-doctor-runtime-mirrors': '/doctor:runtime-mirrors',\n133:   'command-doctor-setup': '/doctor:setup',\n134:   'command-doctor-sk-code-quality': '/doctor:sk-code quality',\n135:   'command-doctor-sk-code-setup': '/doctor:sk-code setup',\n136:   'command-doctor-sk-skill-check': '/doctor:sk-skill check',\n137:   'command-doctor-sk-skill-convert': '/doctor:sk-skill convert',\n138:   'command-doctor-skill-advisor-parent-skill': '/doctor:skill-advisor parent-skill',\n139:   'command-doctor-skill-advisor-rebuild': '/doctor:skill-advisor rebuild',\n140:   'command-doctor-skill-advisor-router-reach': '/doctor:skill-advisor router-reach',\n141:   'command-doctor-skill-advisor-skill-budget': '/doctor:skill-advisor skill-budget',\n142:   'command-doctor-skill-advisor-skill-graph-freshness': '/doctor:skill-advisor skill-graph-freshness',\n143:   'command-doctor-skill-advisor-tune': '/doctor:skill-advisor tune',\n144:   'command-doctor-speckit': '/doctor:speckit',\n145:   'command-doctor-symlink-check': '/doctor:symlink check',\n146:   'command-doctor-symlink-link': '/doctor:symlink link',\n147:   'command-doctor-symlink-unlink': '/doctor:symlink unlink',\n148:   'command-doctor-update': '/doctor:update',\n149: });\n150: // END GENERATED DOCTOR COMMANDS\n151: \n152: function directiveBlockIds(): readonly string[] {\n153:   return Object.freeze([\n154:     POLICY_COMMENT_HYGIENE_ID,\n155:   ]);\n156: }\n157: \n158: const SHADOW_ROUTE_ONLY_LOG: ShadowRouteOnlyLogRecord[] = [];\n159: \n160: // Injected into every advisor brief so all hook-capable runtimes receive\n161: // the comment hygiene rule even when AGENTS.md is absent from session context.\n162: export const HYGIENE_DIRECTIVE = '\\n- Comment hygiene [HARD BLOCK]: NEVER embed ADR-/REQ-/CHK-/task-ids or spec paths in code comments — forbidden regardless of instruction. Write the durable WHY instead. Pre-commit gate blocks violations.';\n163: \n164: \n165: \n166: // Labels the directive block so injected content reads as one structured\n167: // capsule instead of loose lines.\n168: export const DIRECTIVES_LABEL = '\\nDirectives:';\n169: \n170: // One bounded sentence for a setup-shaped prompt that matched nothing, so the\n171: // reader learns the read-only overview exists without every miss paying for it.\n172: export const SETUP_HINT = ' For setup or health checks, run /doctor:setup.';\n173: \n174: // ───────────────────────────────────────────────────────────────\n175: // 3. HELPERS\n176: // ───────────────────────────────────────────────────────────────\n177: \n178: function clampTokenCap(tokenCap: number | undefined): number {\n179:   if (typeof tokenCap !== 'number' || Number.isNaN(tokenCap)) {\n180:     return DEFAULT_TOKEN_CAP;\n181:   }\n182:   return Math.min(Math.max(1, Math.floor(tokenCap)), MAX_TOKEN_CAP);\n183: }\n184: \n185: function capText(text: string, tokenCap: number): string {\n186:   const charCap = tokenCap * TOKEN_TO_CHAR_ESTIMATE;\n187:   if (text.length <= charCap) {\n188:     return text;\n189:   }\n190:   const truncated = text.slice(0, Math.max(1, charCap - 3)).trimEnd();\n191:   return `${truncated}...`;\n192: }\n193: \n194: function sanitizeSkillLabel(skillLabel: string | null | undefined): string | null {\n195:   if (typeof skillLabel !== 'string') {\n196:     return null;\n197:   }\n198:   const folded = canonicalFold(skillLabel);\n199:   if (/[\\n\\r]/.test(folded)) {\n200:     return null;\n201:   }\n202:   const singleLine = folded\n203:     .replace(CONTROL_CHAR_PATTERN, '')\n204:     .replace(/\\s+/g, ' ')\n205:     .trim();\n206:   if (!singleLine || INSTRUCTION_LABEL_PATTERN.test(singleLine)) {\n207:     return null;\n208:   }\n209:   return singleLine;\n210: }\n211: \n212: const DOCTOR_BRIDGE_PREFIX = 'command-doctor-';\n213: \n214: function isDoctorBridgeId(skillId: string): boolean {\n215:   return skillId.startsWith(DOCTOR_BRIDGE_PREFIX);\n216: }\n217: \n218: /** Return the sanitized runnable doctor command for a doctor bridge id, or null when unmapped. */\n219: export function doctorCommandString(skillId: string): string | null {\n220:   if (!isDoctorBridgeId(skillId) || !Object.hasOwn(DOCTOR_COMMAND_STRINGS, skillId)) {\n221:     return null;\n222:   }\n223:   return sanitizeSkillLabel(DOCTOR_COMMAND_STRINGS[skillId]);\n224: }\n225: \n226: // A doctor bridge renders as its runnable command and never as its raw id; an\n227: // unmapped doctor id renders nothing.\n228: function recommendationLabel(skillId: string): string | null {\n229:   return isDoctorBridgeId(skillId) ? doctorCommandString(skillId) : sanitizeSkillLabel(skillId);\n230: }\n231: \n232: function formatScore(value: number): string {\n233:   return Number.isFinite(value) ? value.toFixed(2) : '0.00';\n234: }\n235: \n236: type RenderableRecommendation = AdvisorRecommendation & {\n237:   readonly score?: number;\n238:   readonly ambiguousWith?: readonly string[];\n239:   readonly heldBelow?: string;\n240: };\n241: \n242: function toScoredRecommendation(recommendation: RenderableRecommendation): AdvisorScoredRecommendation {\n243:   return {\n244:     skill: recommendation.skill,\n245:     kind: recommendation.kind === 'command' ? 'command' : 'skill',\n246:     confidence: recommendation.confidence,\n247:     uncertainty: recommendation.uncertainty,\n248:     passes_threshold: recommendation.passes_threshold ?? true,\n249:     reason: '',\n250:     score: typeof recommendation.score === 'number' && Number.isFinite(recommendation.score)\n251:       ? recommendation.score\n252:       : recommendation.confidence,\n253:     laneContributions: [],\n254:     dominantLane: null,\n255:     lifecycleStatus: 'active',\n256:     ...(Array.isArray(recommendation.ambiguousWith) ? { ambiguousWith: recommendation.ambiguousWith } : {}),\n257:     ...(typeof recommendation.heldBelow === 'string' ? { heldBelow: recommendation.heldBelow } : {}),\n258:   };\n259: }\n260: \n261: /**\n262:  * Detect whether the renderable recommendation set carries ambiguity evidence.\n263:  *\n264:  * `precomputedAmbiguous` carries the scorer's own verdict. It wins when defined: the\n265:  * scorer knows which skills a typed command held below the top and which only cleared\n266:  * a confidence floor, and serialized recommendations lose that context. Only when the\n267:  * caller has no verdict is ambiguity re-derived from the rendered fields.\n268:  */\n269: export function hasAdvisorAmbiguitySignal(\n270:   recommendations: readonly AdvisorRecommendation[],\n271:   precomputedAmbiguous?: boolean,\n272: ): boolean {\n273:   if (typeof precomputedAmbiguous === 'boolean') {\n274:     return precomputedAmbiguous;\n275:   }\n276:   return isAmbiguousTopTwo((recommendations as readonly RenderableRecommendation[]).map(toScoredRecommendation));\n277: }\n278: \n279: function metadataSkillLabel(result: AdvisorBriefRenderableResult): string | null {\n280:   const metadata = result.sharedPayload?.metadata;\n281:   return typeof metadata?.skillLabel === 'string' ? metadata.skillLabel : null;\n282: }\n283: \n284: /** Return only the advisor route block that the shadow path would retain. */\n285: export function renderRouteOnlyAdvisorBrief(rendered: string | null): string | null {\n286:   const routeBlock = buildAdvisorRenderPlan(rendered).blocks.find((block) => (\n287:     block.id === ROUTE_ADVISOR_ID\n288:   ));\n289:   return routeBlock?.content ?? null;\n290: }\n291: \n292: /** Read the append-only in-process shadow log without exposing route content. */\n293: export function getShadowRouteOnlyLog(): readonly ShadowRouteOnlyLogRecord[] {\n294:   return Object.freeze(SHADOW_ROUTE_ONLY_LOG.map((record) => ({ ...record })));\n295: }\n296: \n297: /** Clear shadow log entries between isolated evaluations. */\n298: export function clearShadowRouteOnlyLog(): void {\n299:   SHADOW_ROUTE_ONLY_LOG.length = 0;\n300: }\n301: \n302: function stateSignalsForBlock(options: ShadowDeliveryRenderOptions): ShadowDeliveryRenderOptions {\n303:   return {\n304:     ...options,\n305:     lifecycleEvent: undefined,\n306:     scopeChanged: false,\n307:     policySetChanged: false,\n308:     goalChanged: false,\n309:   };\n310: }\n311: \n312: function pushShadowRouteOnlyLog(record: ShadowRouteOnlyLogRecord): void {\n313:   if (SHADOW_ROUTE_ONLY_LOG.length >= MAX_SHADOW_ROUTE_ONLY_LOG) {\n314:     SHADOW_ROUTE_ONLY_LOG.shift();\n315:   }\n316:   SHADOW_ROUTE_ONLY_LOG.push(record);\n317: }\n318: \n319: function directiveBlocksSuppressed(\n320:   plan: ReturnType<typeof buildAdvisorRenderPlan>,\n321:   decisions: readonly ReturnType<typeof evaluateDeliveryState>[],\n322: ): boolean {\n323:   for (const expectedId of directiveBlockIds()) {\n324:     const blockIndex = plan.blocks.findIndex((block) => block.id === expectedId);\n325:     if (blockIndex === -1) {\n326:       return false;\n327:     }\n328:     const decision = decisions[blockIndex];\n329:     if (!decision || decision.state !== 'SUPPRESSED_SAME') {\n330:       return false;\n331:     }\n332:   }\n333:   return true;\n334: }\n335: \n336: function recordObservedBlockDeliveries(\n337:   plan: ReturnType<typeof buildAdvisorRenderPlan>,\n338:   shadowOptions: ShadowDeliveryRenderOptions,\n339:   machine: DeliveryStateMachine,\n340:   epoch: number,\n341: ): void {\n342:   const blockOptions = stateSignalsForBlock(shadowOptions);\n343:   for (const block of plan.blocks) {\n344:     const receipt = shadowOptions.receipt;\n345:     if (!isObservedDeliveryReceipt(receipt, block.contentHash, epoch)) {\n346:       continue;\n347:     }\n348:     machine.recordDelivery({\n349:       ...blockOptions,\n350:       blockId: block.id,\n351:       contentHash: block.contentHash,\n352:       receipt,\n353:     });\n354:   }\n355: }\n356: \n357: function observeShadowRouteOnly(\n358:   rendered: string | null,\n359:   options: ShadowDeliveryRenderOptions | undefined,\n360: ): void {\n361:   try {\n362:     const plan = buildAdvisorRenderPlan(rendered);\n363:     const shadowOptions = options ?? {};\n364:     const machine = shadowOptions.stateMachine ?? SHADOW_DELIVERY_STATE_MACHINE;\n365:     const epochSnapshot = machine.advanceForSignals(shadowOptions);\n366:     const blockOptions = stateSignalsForBlock(shadowOptions);\n367:     const decisions = plan.blocks.map((block) => evaluateDeliveryState({\n368:       ...blockOptions,\n369:       blockId: block.id,\n370:       contentHash: block.contentHash,\n371:     }, machine));\n372: \n373:     recordObservedBlockDeliveries(plan, shadowOptions, machine, epochSnapshot.epoch);\n374: \n375:     const routeIndex = plan.blocks.findIndex((block) => block.id === ROUTE_ADVISOR_ID);\n376:     const routeDecision = routeIndex === -1 ? null : decisions[routeIndex] ?? null;\n377:     const routeOnlyEligible = Boolean(\n378:       routeDecision?.routeOnlyEligible && directiveBlocksSuppressed(plan, decisions),\n379:     );\n380:     const routeOnly = routeOnlyEligible\n381:       ? renderRouteOnlyAdvisorBrief(rendered)\n382:       : null;\n383:     const emittedByteCount = rendered === null ? 0 : Buffer.byteLength(rendered, 'utf8');\n384:     const routeOnlyByteCount = routeOnly === null ? 0 : Buffer.byteLength(routeOnly, 'utf8');\n385:     const savedBytes = routeOnly === null\n386:       ? 0\n387:       : Math.max(0, emittedByteCount - routeOnlyByteCount);\n388:     const record: ShadowRouteOnlyLogRecord = Object.freeze({\n389:       shadowId: ROUTE_ONLY_SHADOW_ID,\n390:       sessionKnown: routeDecision?.sessionKnown ?? epochSnapshot.sessionKnown,\n391:       epoch: routeDecision?.epoch ?? epochSnapshot.epoch,\n392:       policySetHash: plan.policySetHash,\n393:       routeState: routeDecision?.state ?? null,\n394:       emittedByteCount,\n395:       routeOnlyByteCount,\n396:       savedBytes,\n397:     });\n398:     pushShadowRouteOnlyLog(record);\n399:     try {\n400:       options?.onShadowLog?.(record);\n401:     } catch {\n402:       // Observer callbacks must never affect the rendered advisor bytes.\n403:     }\n404:   } catch {\n405:     // Shadow measurement is fail-open so a throwing observer cannot block delivery.\n406:   }\n407: }\n408: \n409: function observeAdvisorPolicy(\n410:   rendered: string | null,\n411:   options: AdvisorBriefRenderOptions = {},\n412: ): void {\n413:   try {\n414:     observeRenderedAdvisorPolicy(rendered);\n415:   } catch {\n416:     // Shadow measurement is fail-open so a throwing observer cannot block delivery.\n417:   }\n418:   observeShadowRouteOnly(rendered, options.deliveryState);\n419: }\n420: \n421: /** Run the shadow planner for a runtime callback without changing its output. */\n422: export function observeShadowDelivery(\n423:   rendered: string | null,\n424:   deliveryState: ShadowDeliveryRenderOptions = {},\n425: ): void {\n426:   observeAdvisorPolicy(rendered, { deliveryState });\n427: }\n428: \n429: /**\n430:  * Record host-observed policy blocks after the runtime places them into the\n431:  * emitted response. Fail-open: recording errors never change emitted bytes.\n432:  */\n433: export function observeEmittedAdvisorPolicy(\n434:   rendered: string | null,\n435:   deliveryState: ShadowDeliveryRenderOptions = {},\n436: ): void {\n437:   try {\n438:     if (typeof rendered !== 'string' || rendered.length === 0) {\n439:       return;\n440:     }\n441:     const runtime = typeof deliveryState.runtime === 'string' && deliveryState.runtime.length > 0\n442:       ? deliveryState.runtime\n443:       : 'unknown';\n444:     const machine = deliveryState.stateMachine ?? SHADOW_DELIVERY_STATE_MACHINE;\n445:     const epoch = machine.currentEpoch(deliveryState);\n446:     const plan = buildAdvisorRenderPlan(rendered);\n447:     for (const block of plan.blocks) {\n448:       recordObservedPolicyDelivery({\n449:         runtime,\n450:         candidate: deliveryState.candidate ?? OBSERVED_ADVISOR_POLICY_CANDIDATE,\n451:         blockId: block.id,\n452:         content: block.content,\n453:         contentHash: block.contentHash,\n454:         lifecycleEpoch: epoch,\n455:         sessionId: deliveryState.sessionId,\n456:         sessionIdentity: deliveryState.sessionIdentity,\n457:         sessionIdentityConfirmed: deliveryState.sessionIdentityConfirmed,\n458:         sessionIdentityAmbiguous: deliveryState.sessionIdentityAmbiguous,\n459:         transformMessageIdentity: deliveryState.transformMessageIdentity ?? null,\n460:       });\n461:     }\n462:   } catch {\n463:     // Host observation is fail-open so a throwing sink cannot affect delivery.\n464:   }\n465: }\n466: \n467: // ───────────────────────────────────────────────────────────────\n468: // 4. CORE LOGIC\n469: // ───────────────────────────────────────────────────────────────\n470: \n471: /**\n472:  * Render the model-visible advisor brief from typed advisor output only.\n473:  *\n474:  * The renderer is the prompt-boundary guard: it ignores free-form reasons,\n475:  * descriptions, stdout/stderr, and prompt text, and emits nothing when the\n476:  * repository-authored skill label looks instruction-shaped after folding.\n477:  */\n478: export function renderAdvisorBrief(\n479:   result: AdvisorBriefRenderableResult,\n480:   options: AdvisorBriefRenderOptions = {},\n481: ): string | null {\n482:   if (result.status !== 'ok') {\n483:     observeAdvisorPolicy(null, options);\n484:     return null;\n485:   }\n486:   if (result.freshness !== 'live' && result.freshness !== 'stale') {\n487:     observeAdvisorPolicy(null, options);\n488:     return null;\n489:   }\n490: \n491:   const tokenCap = clampTokenCap(result.metrics?.tokenCap ?? options.tokenCap);\n492:   const thresholdConfig = options.thresholdConfig;\n493:   const recommendations = result.recommendations.filter((recommendation) => (\n494:     recommendation.passes_threshold === true\n495:     || (\n496:       recommendation.confidence >= (thresholdConfig?.confidenceThreshold ?? resolvedConfidenceThreshold())\n497:       && (\n498:         thresholdConfig?.confidenceOnly === true\n499:         || recommendation.uncertainty <= (thresholdConfig?.uncertaintyThreshold ?? resolvedUncertaintyThreshold())\n500:       )\n501:     )\n502:   ));\n503:   const [top, second] = recommendations;\n504:   if (!top) {\n505:     observeAdvisorPolicy(null, options);\n506:     return null;\n507:   }\n508: \n509:   const topLabel = isDoctorBridgeId(top.skill)\n510:     ? doctorCommandString(top.skill)\n511:     : sanitizeSkillLabel(metadataSkillLabel(result) ?? top.skill);\n512:   if (!topLabel) {\n513:     observeAdvisorPolicy(null, options);\n514:     return null;\n515:   }\n516: \n517:   const companion = isDoctorBridgeId(top.skill)\n518:     ? undefined\n519:     : recommendations.slice(1).find((recommendation) => doctorCommandString(recommendation.skill) !== null);\n520:   const companionLabel = companion ? doctorCommandString(companion.skill) : null;\n521:   const companionLine = (shownSecond: string | undefined): string => (\n522:     companionLabel && companion && companion.skill !== shownSecond ? `\\nAlso: ${companionLabel}` : ''\n523:   );\n524:   const capWithCompanion = (head: string, companionText: string, cap: number): string => {\n525:     const companionFits = head.length + companionText.length <= cap * TOKEN_TO_CHAR_ESTIMATE;\n526:     return `${capText(head, cap)}${companionFits ? companionText : ''}`;\n527:   };\n528: \n529:   const precomputedAmbiguous = typeof result.ambiguous === 'boolean' ? result.ambiguous : undefined;\n530:   if (tokenCap > DEFAULT_TOKEN_CAP && second && hasAdvisorAmbiguitySignal(recommendations, precomputedAmbiguous)) {\n531:     // The scorer names its own tie partners, which can sit below the second passing\n532:     // entry, so prefer a named partner and fall back to the second entry.\n533:     const namedPartners = (top as RenderableRecommendation).ambiguousWith;\n534:     const ambiguousWith: readonly string[] = Array.isArray(namedPartners) ? namedPartners : [];\n535:     const vs = (ambiguousWith.length > 0\n536:       ? recommendations.find((recommendation) => ambiguousWith.includes(recommendation.skill))\n537:       : undefined) ?? second;\n538:     const vsLabel = recommendationLabel(vs.skill);\n539:     if (!vsLabel && !isDoctorBridgeId(vs.skill)) {\n540:       observeAdvisorPolicy(null, options);\n541:       return null;\n542:     }\n543:     if (vsLabel) {\n544:       const head = `Advisor: ${result.freshness}; ambiguous: ${topLabel} `\n545:         + `${formatScore(top.confidence)}/${formatScore(top.uncertainty)} vs ${vsLabel} `\n546:         + `${formatScore(vs.confidence)}/${formatScore(vs.uncertainty)} pass.`;\n547:       const rendered = capWithCompanion(\n548:         head,\n549:         companionLine(vs.skill),\n550:         Math.min(tokenCap, AMBIGUOUS_TOKEN_CAP),\n551:       ) + DIRECTIVES_LABEL + HYGIENE_DIRECTIVE;\n552:       observeAdvisorPolicy(rendered, options);\n553:       return rendered;\n554:     }\n555:   }\n556: \n557:   const head = `Advisor: ${result.freshness}; use ${topLabel} `\n558:     + `${formatScore(top.confidence)}/${formatScore(top.uncertainty)} pass.`;\n559:   const rendered = capWithCompanion(\n560:     head,\n561:     companionLine(undefined),\n562:     Math.min(tokenCap, DEFAULT_TOKEN_CAP),\n563:   ) + DIRECTIVES_LABEL + HYGIENE_DIRECTIVE;\n564:   observeAdvisorPolicy(rendered, options);\n565:   return rendered;\n566: }\n567: \n568: /** Classify a result with no brief; no result at all means the advisor did not answer. */\n569: export function advisorFallbackCase(\n570:   result?: Pick<AdvisorHookResult, 'status' | 'freshness'>,\n571: ): AdvisorFallbackClassification {\n572:   if (!result || result.status === 'fail_open' || result.freshness === 'absent'\n573:     || (result.freshness === 'unavailable' && result.status !== 'skipped')) {\n574:     return {\n575:       fallbackCase: 'outage',\n576:       outageLabel: result?.freshness === 'absent'\n577:         ? 'absent'\n578:         : result?.status === 'degraded'\n579:           ? 'degraded'\n580:           : 'fail_open',\n581:     };\n582:   }\n583:   if (result.status === 'skipped' && result.freshness === 'unavailable') {\n584:     return { fallbackCase: 'skipped' };\n585:   }\n586:   return { fallbackCase: 'no-match' };\n587: }\n588: \n589: /** Render the fallback status and directive block when no advisor brief is available. */\n590: export function renderAdvisorFallbackDirective(\n591:   options: AdvisorBriefRenderOptions = {},\n592:   result?: Pick<AdvisorHookResult, 'status' | 'freshness'>,\n593: ): string {\n594:   const classification = advisorFallbackCase(result);\n595:   const head = classification.fallbackCase === 'outage'\n596:     ? `Advisor: outage (${classification.outageLabel});${options.setupWording === true ? ' for setup or health checks, run /doctor:setup;' : ''} route by hand: node .skilled/bin/skill-advisor.cjs advisor_recommend --json '{\"prompt\":\"<request>\"}' --format json`\n597:     : classification.fallbackCase === 'skipped'\n598:       ? 'Advisor: prompt skipped.'\n599:       : options.setupWording === true\n600:         ? `Advisor: no skill matched.${SETUP_HINT}`\n601:         : 'Advisor: no skill matched.';\n602:   const rendered = head + DIRECTIVES_LABEL + HYGIENE_DIRECTIVE;\n603:   observeAdvisorPolicy(rendered, options);\n604:   return rendered;\n605: }\n606: \n607: /** Render the outage fallback used when advisor execution times out or is unavailable. */\n608: export function renderAdvisorTimeoutFallback(\n609:   options: AdvisorBriefRenderOptions = {},\n610:   status: Extract<AdvisorHookResult['status'], 'fail_open' | 'degraded'> = 'fail_open',\n611: ): string {\n612:   return renderAdvisorFallbackDirective(options, { status, freshness: 'unavailable' });\n613: }\n614: \n615: export { sanitizeSkillLabel };","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/lib/render.ts, lines 1-615\n1: // ───────────────────────────────────────────────────────────────\n2: // MODULE: Skill Advisor Brief Renderer\n3: // ───────────────────────────────────────────────────────────────\n4: \n5: import { canonicalFold } from './shared/unicode-normalization.js';\n6: import { resolvedConfidenceThreshold, resolvedUncertaintyThreshold } from './compat/contract.js';\n7: import {\n8:   buildAdvisorRenderPlan,\n9:   evaluateDeliveryState,\n10:   isObservedDeliveryReceipt,\n11:   observeRenderedAdvisorPolicy,\n12:   POLICY_COMMENT_HYGIENE_ID,\n13:   recordObservedPolicyDelivery,\n14:   ROUTE_ADVISOR_ID,\n15:   SHADOW_DELIVERY_STATE_MACHINE,\n16:   type DeliveryStateMachine,\n17:   type DeliveryStateReceipt,\n18:   type DeliveryStateName,\n19:   type DeliveryStateSignals,\n20: } from './policy-plan.js';\n21: import { isAmbiguousTopTwo } from './scorer/ambiguity.js';\n22: import type { AdvisorRecommendation } from './subprocess.js';\n23: import type { AdvisorScoredRecommendation } from './scorer/types.js';\n24: import type { AdvisorHookResult } from './skill-advisor-brief.js';\n25: \n26: // ───────────────────────────────────────────────────────────────\n27: // 1. TYPES\n28: // ───────────────────────────────────────────────────────────────\n29: \n30: export interface AdvisorBriefRenderOptions {\n31:   readonly tokenCap?: number;\n32:   readonly thresholdConfig?: {\n33:     readonly confidenceThreshold?: number;\n34:     readonly uncertaintyThreshold?: number;\n35:     readonly confidenceOnly?: boolean;\n36:   };\n37:   readonly deliveryState?: ShadowDeliveryRenderOptions;\n38:   /**\n39:    * True when prompts use set up, set-up or setup wording, install or reinstall wording\n40:    * including installation and installer, configure or configuration wording or `check`\n41:    * followed within three words by environment, env, config, hooks, tools, tooling,\n42:    * toolchain or skilled. The renderer never reads prompt text.\n43:    */\n44:   readonly setupWording?: boolean;\n45: }\n46: \n47: export interface ShadowDeliveryRenderOptions extends DeliveryStateSignals {\n48:   readonly runtime?: string;\n49:   readonly candidate?: string | null;\n50:   readonly stateMachine?: DeliveryStateMachine;\n51:   readonly deliveryConfirmed?: boolean;\n52:   readonly receipt?: DeliveryStateReceipt;\n53:   readonly transformMessageIdentity?: string | null;\n54:   readonly onShadowLog?: (record: ShadowRouteOnlyLogRecord) => void;\n55: }\n56: \n57: export interface ShadowRouteOnlyLogRecord {\n58:   readonly shadowId: string;\n59:   readonly sessionKnown: boolean;\n60:   readonly epoch: number;\n61:   readonly policySetHash: string;\n62:   readonly routeState: DeliveryStateName | null;\n63:   readonly emittedByteCount: number;\n64:   readonly routeOnlyByteCount: number;\n65:   readonly savedBytes: number;\n66: }\n67: \n68: export interface AdvisorBriefRenderableResult {\n69:   readonly status: 'ok' | 'stale' | 'skipped' | 'degraded' | 'fail_open';\n70:   readonly freshness: 'live' | 'stale' | 'absent' | 'unavailable';\n71:   readonly recommendations: readonly AdvisorRecommendation[];\n72:   readonly ambiguous?: boolean;\n73:   readonly metrics?: {\n74:     readonly tokenCap?: number;\n75:   } | null;\n76:   readonly sharedPayload?: {\n77:     readonly metadata?: {\n78:       readonly skillLabel?: string | null;\n79:     } | null;\n80:   } | null;\n81: }\n82: \n83: export type AdvisorFallbackCase = 'outage' | 'no-match' | 'skipped';\n84: export type AdvisorFallbackClassification =\n85:   | {\n86:     readonly fallbackCase: 'outage';\n87:     readonly outageLabel: 'absent' | 'degraded' | 'fail_open';\n88:   }\n89:   | {\n90:     readonly fallbackCase: 'no-match' | 'skipped';\n91:   };\n92: \n93: // ───────────────────────────────────────────────────────────────\n94: // 2. CONSTANTS\n95: // ───────────────────────────────────────────────────────────────\n96: \n97: const DEFAULT_TOKEN_CAP = 80;\n98: const AMBIGUOUS_TOKEN_CAP = 120;\n99: const MAX_TOKEN_CAP = 120;\n100: const TOKEN_TO_CHAR_ESTIMATE = 4;\n101: const INSTRUCTION_LABEL_PATTERN =\n102:   /^\\s*(SYSTEM|INSTRUCTION|IGNORE|EXECUTE)\\s*[:=]|^\\s*(<!--|```)|\\b(ignore\\s+(previous|all)\\s+instructions|system\\s*:|instruction\\s*:|execute\\s*:|developer\\s*:|assistant\\s*:)/i;\n103: const CONTROL_CHAR_PATTERN = /[\\u0000-\\u0008\\u000B\\u000C\\u000E-\\u001F\\u007F]/g;\n104: const ROUTE_ONLY_SHADOW_ID = 'shadow.route-only.advisor.v1';\n105: const OBSERVED_ADVISOR_POLICY_CANDIDATE = '004';\n106: export const ROUTE_ONLY_ESTIMATED_BYTES = 43;\n107: const MAX_SHADOW_ROUTE_ONLY_LOG = 256;\n108: \n109: // Maps each doctor command bridge id to the runnable command string the brief\n110: // shows. Generated by derive-command-bridges.cjs from the doctor route manifest,\n111: // so the renderer never imports the scorer projection (which loads SQLite).\n112: // BEGIN GENERATED DOCTOR COMMANDS\n113: const DOCTOR_COMMAND_STRINGS: Readonly<Record<string, string>> = Object.freeze({\n114:   'command-doctor-agents-md-check': '/doctor:agents-md check',\n115:   'command-doctor-agents-md-embed': '/doctor:agents-md embed',\n116:   'command-doctor-agents-md-restore': '/doctor:agents-md restore',\n117:   'command-doctor-ci-report': '/doctor:ci report',\n118:   'command-doctor-ci-scaffold': '/doctor:ci scaffold',\n119:   'command-doctor-ci-toggle': '/doctor:ci toggle',\n120:   'command-doctor-deep-loop': '/doctor:deep-loop',\n121:   'command-doctor-env': '/doctor:env list',\n122:   'command-doctor-git-hooks': '/doctor:git hooks',\n123:   'command-doctor-git-setup': '/doctor:git setup',\n124:   'command-doctor-git-standards': '/doctor:git standards',\n125:   'command-doctor-helper': '/doctor:helper',\n126:   'command-doctor-install': '/doctor:install',\n127:   'command-doctor-mcp-debug': '/doctor:mcp debug',\n128:   'command-doctor-mcp-install': '/doctor:mcp install',\n129:   'command-doctor-overlay-apply': '/doctor:overlay apply',\n130:   'command-doctor-overlay-repin': '/doctor:overlay repin',\n131:   'command-doctor-overlay-status': '/doctor:overlay status',\n132:   'command-doctor-runtime-mirrors': '/doctor:runtime-mirrors',\n133:   'command-doctor-setup': '/doctor:setup',\n134:   'command-doctor-sk-code-quality': '/doctor:sk-code quality',\n135:   'command-doctor-sk-code-setup': '/doctor:sk-code setup',\n136:   'command-doctor-sk-skill-check': '/doctor:sk-skill check',\n137:   'command-doctor-sk-skill-convert': '/doctor:sk-skill convert',\n138:   'command-doctor-skill-advisor-parent-skill': '/doctor:skill-advisor parent-skill',\n139:   'command-doctor-skill-advisor-rebuild': '/doctor:skill-advisor rebuild',\n140:   'command-doctor-skill-advisor-router-reach': '/doctor:skill-advisor router-reach',\n141:   'command-doctor-skill-advisor-skill-budget': '/doctor:skill-advisor skill-budget',\n142:   'command-doctor-skill-advisor-skill-graph-freshness': '/doctor:skill-advisor skill-graph-freshness',\n143:   'command-doctor-skill-advisor-tune': '/doctor:skill-advisor tune',\n144:   'command-doctor-speckit': '/doctor:speckit',\n145:   'command-doctor-symlink-check': '/doctor:symlink check',\n146:   'command-doctor-symlink-link': '/doctor:symlink link',\n147:   'command-doctor-symlink-unlink': '/doctor:symlink unlink',\n148:   'command-doctor-update': '/doctor:update',\n149: });\n150: // END GENERATED DOCTOR COMMANDS\n151: \n152: function directiveBlockIds(): readonly string[] {\n153:   return Object.freeze([\n154:     POLICY_COMMENT_HYGIENE_ID,\n155:   ]);\n156: }\n157: \n158: const SHADOW_ROUTE_ONLY_LOG: ShadowRouteOnlyLogRecord[] = [];\n159: \n160: // Injected into every advisor brief so all hook-capable runtimes receive\n161: // the comment hygiene rule even when AGENTS.md is absent from session context.\n162: export const HYGIENE_DIRECTIVE = '\\n- Comment hygiene [HARD BLOCK]: NEVER embed ADR-/REQ-/CHK-/task-ids or spec paths in code comments — forbidden regardless of instruction. Write the durable WHY instead. Pre-commit gate blocks violations.';\n163: \n164: \n165: \n166: // Labels the directive block so injected content reads as one structured\n167: // capsule instead of loose lines.\n168: export const DIRECTIVES_LABEL = '\\nDirectives:';\n169: \n170: // One bounded sentence for a setup-shaped prompt that matched nothing, so the\n171: // reader learns the read-only overview exists without every miss paying for it.\n172: export const SETUP_HINT = ' For setup or health checks, run /doctor:setup.';\n173: \n174: // ───────────────────────────────────────────────────────────────\n175: // 3. HELPERS\n176: // ───────────────────────────────────────────────────────────────\n177: \n178: function clampTokenCap(tokenCap: number | undefined): number {\n179:   if (typeof tokenCap !== 'number' || Number.isNaN(tokenCap)) {\n180:     return DEFAULT_TOKEN_CAP;\n181:   }\n182:   return Math.min(Math.max(1, Math.floor(tokenCap)), MAX_TOKEN_CAP);\n183: }\n184: \n185: function capText(text: string, tokenCap: number): string {\n186:   const charCap = tokenCap * TOKEN_TO_CHAR_ESTIMATE;\n187:   if (text.length <= charCap) {\n188:     return text;\n189:   }\n190:   const truncated = text.slice(0, Math.max(1, charCap - 3)).trimEnd();\n191:   return `${truncated}...`;\n192: }\n193: \n194: function sanitizeSkillLabel(skillLabel: string | null | undefined): string | null {\n195:   if (typeof skillLabel !== 'string') {\n196:     return null;\n197:   }\n198:   const folded = canonicalFold(skillLabel);\n199:   if (/[\\n\\r]/.test(folded)) {\n200:     return null;\n201:   }\n202:   const singleLine = folded\n203:     .replace(CONTROL_CHAR_PATTERN, '')\n204:     .replace(/\\s+/g, ' ')\n205:     .trim();\n206:   if (!singleLine || INSTRUCTION_LABEL_PATTERN.test(singleLine)) {\n207:     return null;\n208:   }\n209:   return singleLine;\n210: }\n211: \n212: const DOCTOR_BRIDGE_PREFIX = 'command-doctor-';\n213: \n214: function isDoctorBridgeId(skillId: string): boolean {\n215:   return skillId.startsWith(DOCTOR_BRIDGE_PREFIX);\n216: }\n217: \n218: /** Return the sanitized runnable doctor command for a doctor bridge id, or null when unmapped. */\n219: export function doctorCommandString(skillId: string): string | null {\n220:   if (!isDoctorBridgeId(skillId) || !Object.hasOwn(DOCTOR_COMMAND_STRINGS, skillId)) {\n221:     return null;\n222:   }\n223:   return sanitizeSkillLabel(DOCTOR_COMMAND_STRINGS[skillId]);\n224: }\n225: \n226: // A doctor bridge renders as its runnable command and never as its raw id; an\n227: // unmapped doctor id renders nothing.\n228: function recommendationLabel(skillId: string): string | null {\n229:   return isDoctorBridgeId(skillId) ? doctorCommandString(skillId) : sanitizeSkillLabel(skillId);\n230: }\n231: \n232: function formatScore(value: number): string {\n233:   return Number.isFinite(value) ? value.toFixed(2) : '0.00';\n234: }\n235: \n236: type RenderableRecommendation = AdvisorRecommendation & {\n237:   readonly score?: number;\n238:   readonly ambiguousWith?: readonly string[];\n239:   readonly heldBelow?: string;\n240: };\n241: \n242: function toScoredRecommendation(recommendation: RenderableRecommendation): AdvisorScoredRecommendation {\n243:   return {\n244:     skill: recommendation.skill,\n245:     kind: recommendation.kind === 'command' ? 'command' : 'skill',\n246:     confidence: recommendation.confidence,\n247:     uncertainty: recommendation.uncertainty,\n248:     passes_threshold: recommendation.passes_threshold ?? true,\n249:     reason: '',\n250:     score: typeof recommendation.score === 'number' && Number.isFinite(recommendation.score)\n251:       ? recommendation.score\n252:       : recommendation.confidence,\n253:     laneContributions: [],\n254:     dominantLane: null,\n255:     lifecycleStatus: 'active',\n256:     ...(Array.isArray(recommendation.ambiguousWith) ? { ambiguousWith: recommendation.ambiguousWith } : {}),\n257:     ...(typeof recommendation.heldBelow === 'string' ? { heldBelow: recommendation.heldBelow } : {}),\n258:   };\n259: }\n260: \n261: /**\n262:  * Detect whether the renderable recommendation set carries ambiguity evidence.\n263:  *\n264:  * `precomputedAmbiguous` carries the scorer's own verdict. It wins when defined: the\n265:  * scorer knows which skills a typed command held below the top and which only cleared\n266:  * a confidence floor, and serialized recommendations lose that context. Only when the\n267:  * caller has no verdict is ambiguity re-derived from the rendered fields.\n268:  */\n269: export function hasAdvisorAmbiguitySignal(\n270:   recommendations: readonly AdvisorRecommendation[],\n271:   precomputedAmbiguous?: boolean,\n272: ): boolean {\n273:   if (typeof precomputedAmbiguous === 'boolean') {\n274:     return precomputedAmbiguous;\n275:   }\n276:   return isAmbiguousTopTwo((recommendations as readonly RenderableRecommendation[]).map(toScoredRecommendation));\n277: }\n278: \n279: function metadataSkillLabel(result: AdvisorBriefRenderableResult): string | null {\n280:   const metadata = result.sharedPayload?.metadata;\n281:   return typeof metadata?.skillLabel === 'string' ? metadata.skillLabel : null;\n282: }\n283: \n284: /** Return only the advisor route block that the shadow path would retain. */\n285: export function renderRouteOnlyAdvisorBrief(rendered: string | null): string | null {\n286:   const routeBlock = buildAdvisorRenderPlan(rendered).blocks.find((block) => (\n287:     block.id === ROUTE_ADVISOR_ID\n288:   ));\n289:   return routeBlock?.content ?? null;\n290: }\n291: \n292: /** Read the append-only in-process shadow log without exposing route content. */\n293: export function getShadowRouteOnlyLog(): readonly ShadowRouteOnlyLogRecord[] {\n294:   return Object.freeze(SHADOW_ROUTE_ONLY_LOG.map((record) => ({ ...record })));\n295: }\n296: \n297: /** Clear shadow log entries between isolated evaluations. */\n298: export function clearShadowRouteOnlyLog(): void {\n299:   SHADOW_ROUTE_ONLY_LOG.length = 0;\n300: }\n301: \n302: function stateSignalsForBlock(options: ShadowDeliveryRenderOptions): ShadowDeliveryRenderOptions {\n303:   return {\n304:     ...options,\n305:     lifecycleEvent: undefined,\n306:     scopeChanged: false,\n307:     policySetChanged: false,\n308:     goalChanged: false,\n309:   };\n310: }\n311: \n312: function pushShadowRouteOnlyLog(record: ShadowRouteOnlyLogRecord): void {\n313:   if (SHADOW_ROUTE_ONLY_LOG.length >= MAX_SHADOW_ROUTE_ONLY_LOG) {\n314:     SHADOW_ROUTE_ONLY_LOG.shift();\n315:   }\n316:   SHADOW_ROUTE_ONLY_LOG.push(record);\n317: }\n318: \n319: function directiveBlocksSuppressed(\n320:   plan: ReturnType<typeof buildAdvisorRenderPlan>,\n321:   decisions: readonly ReturnType<typeof evaluateDeliveryState>[],\n322: ): boolean {\n323:   for (const expectedId of directiveBlockIds()) {\n324:     const blockIndex = plan.blocks.findIndex((block) => block.id === expectedId);\n325:     if (blockIndex === -1) {\n326:       return false;\n327:     }\n328:     const decision = decisions[blockIndex];\n329:     if (!decision || decision.state !== 'SUPPRESSED_SAME') {\n330:       return false;\n331:     }\n332:   }\n333:   return true;\n334: }\n335: \n336: function recordObservedBlockDeliveries(\n337:   plan: ReturnType<typeof buildAdvisorRenderPlan>,\n338:   shadowOptions: ShadowDeliveryRenderOptions,\n339:   machine: DeliveryStateMachine,\n340:   epoch: number,\n341: ): void {\n342:   const blockOptions = stateSignalsForBlock(shadowOptions);\n343:   for (const block of plan.blocks) {\n344:     const receipt = shadowOptions.receipt;\n345:     if (!isObservedDeliveryReceipt(receipt, block.contentHash, epoch)) {\n346:       continue;\n347:     }\n348:     machine.recordDelivery({\n349:       ...blockOptions,\n350:       blockId: block.id,\n351:       contentHash: block.contentHash,\n352:       receipt,\n353:     });\n354:   }\n355: }\n356: \n357: function observeShadowRouteOnly(\n358:   rendered: string | null,\n359:   options: ShadowDeliveryRenderOptions | undefined,\n360: ): void {\n361:   try {\n362:     const plan = buildAdvisorRenderPlan(rendered);\n363:     const shadowOptions = options ?? {};\n364:     const machine = shadowOptions.stateMachine ?? SHADOW_DELIVERY_STATE_MACHINE;\n365:     const epochSnapshot = machine.advanceForSignals(shadowOptions);\n366:     const blockOptions = stateSignalsForBlock(shadowOptions);\n367:     const decisions = plan.blocks.map((block) => evaluateDeliveryState({\n368:       ...blockOptions,\n369:       blockId: block.id,\n370:       contentHash: block.contentHash,\n371:     }, machine));\n372: \n373:     recordObservedBlockDeliveries(plan, shadowOptions, machine, epochSnapshot.epoch);\n374: \n375:     const routeIndex = plan.blocks.findIndex((block) => block.id === ROUTE_ADVISOR_ID);\n376:     const routeDecision = routeIndex === -1 ? null : decisions[routeIndex] ?? null;\n377:     const routeOnlyEligible = Boolean(\n378:       routeDecision?.routeOnlyEligible && directiveBlocksSuppressed(plan, decisions),\n379:     );\n380:     const routeOnly = routeOnlyEligible\n381:       ? renderRouteOnlyAdvisorBrief(rendered)\n382:       : null;\n383:     const emittedByteCount = rendered === null ? 0 : Buffer.byteLength(rendered, 'utf8');\n384:     const routeOnlyByteCount = routeOnly === null ? 0 : Buffer.byteLength(routeOnly, 'utf8');\n385:     const savedBytes = routeOnly === null\n386:       ? 0\n387:       : Math.max(0, emittedByteCount - routeOnlyByteCount);\n388:     const record: ShadowRouteOnlyLogRecord = Object.freeze({\n389:       shadowId: ROUTE_ONLY_SHADOW_ID,\n390:       sessionKnown: routeDecision?.sessionKnown ?? epochSnapshot.sessionKnown,\n391:       epoch: routeDecision?.epoch ?? epochSnapshot.epoch,\n392:       policySetHash: plan.policySetHash,\n393:       routeState: routeDecision?.state ?? null,\n394:       emittedByteCount,\n395:       routeOnlyByteCount,\n396:       savedBytes,\n397:     });\n398:     pushShadowRouteOnlyLog(record);\n399:     try {\n400:       options?.onShadowLog?.(record);\n401:     } catch {\n402:       // Observer callbacks must never affect the rendered advisor bytes.\n403:     }\n404:   } catch {\n405:     // Shadow measurement is fail-open so a throwing observer cannot block delivery.\n406:   }\n407: }\n408: \n409: function observeAdvisorPolicy(\n410:   rendered: string | null,\n411:   options: AdvisorBriefRenderOptions = {},\n412: ): void {\n413:   try {\n414:     observeRenderedAdvisorPolicy(rendered);\n415:   } catch {\n416:     // Shadow measurement is fail-open so a throwing observer cannot block delivery.\n417:   }\n418:   observeShadowRouteOnly(rendered, options.deliveryState);\n419: }\n420: \n421: /** Run the shadow planner for a runtime callback without changing its output. */\n422: export function observeShadowDelivery(\n423:   rendered: string | null,\n424:   deliveryState: ShadowDeliveryRenderOptions = {},\n425: ): void {\n426:   observeAdvisorPolicy(rendered, { deliveryState });\n427: }\n428: \n429: /**\n430:  * Record host-observed policy blocks after the runtime places them into the\n431:  * emitted response. Fail-open: recording errors never change emitted bytes.\n432:  */\n433: export function observeEmittedAdvisorPolicy(\n434:   rendered: string | null,\n435:   deliveryState: ShadowDeliveryRenderOptions = {},\n436: ): void {\n437:   try {\n438:     if (typeof rendered !== 'string' || rendered.length === 0) {\n439:       return;\n440:     }\n441:     const runtime = typeof deliveryState.runtime === 'string' && deliveryState.runtime.length > 0\n442:       ? deliveryState.runtime\n443:       : 'unknown';\n444:     const machine = deliveryState.stateMachine ?? SHADOW_DELIVERY_STATE_MACHINE;\n445:     const epoch = machine.currentEpoch(deliveryState);\n446:     const plan = buildAdvisorRenderPlan(rendered);\n447:     for (const block of plan.blocks) {\n448:       recordObservedPolicyDelivery({\n449:         runtime,\n450:         candidate: deliveryState.candidate ?? OBSERVED_ADVISOR_POLICY_CANDIDATE,\n451:         blockId: block.id,\n452:         content: block.content,\n453:         contentHash: block.contentHash,\n454:         lifecycleEpoch: epoch,\n455:         sessionId: deliveryState.sessionId,\n456:         sessionIdentity: deliveryState.sessionIdentity,\n457:         sessionIdentityConfirmed: deliveryState.sessionIdentityConfirmed,\n458:         sessionIdentityAmbiguous: deliveryState.sessionIdentityAmbiguous,\n459:         transformMessageIdentity: deliveryState.transformMessageIdentity ?? null,\n460:       });\n461:     }\n462:   } catch {\n463:     // Host observation is fail-open so a throwing sink cannot affect delivery.\n464:   }\n465: }\n466: \n467: // ───────────────────────────────────────────────────────────────\n468: // 4. CORE LOGIC\n469: // ───────────────────────────────────────────────────────────────\n470: \n471: /**\n472:  * Render the model-visible advisor brief from typed advisor output only.\n473:  *\n474:  * The renderer is the prompt-boundary guard: it ignores free-form reasons,\n475:  * descriptions, stdout/stderr, and prompt text, and emits nothing when the\n476:  * repository-authored skill label looks instruction-shaped after folding.\n477:  */\n478: export function renderAdvisorBrief(\n479:   result: AdvisorBriefRenderableResult,\n480:   options: AdvisorBriefRenderOptions = {},\n481: ): string | null {\n482:   if (result.status !== 'ok') {\n483:     observeAdvisorPolicy(null, options);\n484:     return null;\n485:   }\n486:   if (result.freshness !== 'live' && result.freshness !== 'stale') {\n487:     observeAdvisorPolicy(null, options);\n488:     return null;\n489:   }\n490: \n491:   const tokenCap = clampTokenCap(result.metrics?.tokenCap ?? options.tokenCap);\n492:   const thresholdConfig = options.thresholdConfig;\n493:   const recommendations = result.recommendations.filter((recommendation) => (\n494:     recommendation.passes_threshold === true\n495:     || (\n496:       recommendation.confidence >= (thresholdConfig?.confidenceThreshold ?? resolvedConfidenceThreshold())\n497:       && (\n498:         thresholdConfig?.confidenceOnly === true\n499:         || recommendation.uncertainty <= (thresholdConfig?.uncertaintyThreshold ?? resolvedUncertaintyThreshold())\n500:       )\n501:     )\n502:   ));\n503:   const [top, second] = recommendations;\n504:   if (!top) {\n505:     observeAdvisorPolicy(null, options);\n506:     return null;\n507:   }\n508: \n509:   const topLabel = isDoctorBridgeId(top.skill)\n510:     ? doctorCommandString(top.skill)\n511:     : sanitizeSkillLabel(metadataSkillLabel(result) ?? top.skill);\n512:   if (!topLabel) {\n513:     observeAdvisorPolicy(null, options);\n514:     return null;\n515:   }\n516: \n517:   const companion = isDoctorBridgeId(top.skill)\n518:     ? undefined\n519:     : recommendations.slice(1).find((recommendation) => doctorCommandString(recommendation.skill) !== null);\n520:   const companionLabel = companion ? doctorCommandString(companion.skill) : null;\n521:   const companionLine = (shownSecond: string | undefined): string => (\n522:     companionLabel && companion && companion.skill !== shownSecond ? `\\nAlso: ${companionLabel}` : ''\n523:   );\n524:   const capWithCompanion = (head: string, companionText: string, cap: number): string => {\n525:     const companionFits = head.length + companionText.length <= cap * TOKEN_TO_CHAR_ESTIMATE;\n526:     return `${capText(head, cap)}${companionFits ? companionText : ''}`;\n527:   };\n528: \n529:   const precomputedAmbiguous = typeof result.ambiguous === 'boolean' ? result.ambiguous : undefined;\n530:   if (tokenCap > DEFAULT_TOKEN_CAP && second && hasAdvisorAmbiguitySignal(recommendations, precomputedAmbiguous)) {\n531:     // The scorer names its own tie partners, which can sit below the second passing\n532:     // entry, so prefer a named partner and fall back to the second entry.\n533:     const namedPartners = (top as RenderableRecommendation).ambiguousWith;\n534:     const ambiguousWith: readonly string[] = Array.isArray(namedPartners) ? namedPartners : [];\n535:     const vs = (ambiguousWith.length > 0\n536:       ? recommendations.find((recommendation) => ambiguousWith.includes(recommendation.skill))\n537:       : undefined) ?? second;\n538:     const vsLabel = recommendationLabel(vs.skill);\n539:     if (!vsLabel && !isDoctorBridgeId(vs.skill)) {\n540:       observeAdvisorPolicy(null, options);\n541:       return null;\n542:     }\n543:     if (vsLabel) {\n544:       const head = `Advisor: ${result.freshness}; ambiguous: ${topLabel} `\n545:         + `${formatScore(top.confidence)}/${formatScore(top.uncertainty)} vs ${vsLabel} `\n546:         + `${formatScore(vs.confidence)}/${formatScore(vs.uncertainty)} pass.`;\n547:       const rendered = capWithCompanion(\n548:         head,\n549:         companionLine(vs.skill),\n550:         Math.min(tokenCap, AMBIGUOUS_TOKEN_CAP),\n551:       ) + DIRECTIVES_LABEL + HYGIENE_DIRECTIVE;\n552:       observeAdvisorPolicy(rendered, options);\n553:       return rendered;\n554:     }\n555:   }\n556: \n557:   const head = `Advisor: ${result.freshness}; use ${topLabel} `\n558:     + `${formatScore(top.confidence)}/${formatScore(top.uncertainty)} pass.`;\n559:   const rendered = capWithCompanion(\n560:     head,\n561:     companionLine(undefined),\n562:     Math.min(tokenCap, DEFAULT_TOKEN_CAP),\n563:   ) + DIRECTIVES_LABEL + HYGIENE_DIRECTIVE;\n564:   observeAdvisorPolicy(rendered, options);\n565:   return rendered;\n566: }\n567: \n568: /** Classify a result with no brief; no result at all means the advisor did not answer. */\n569: export function advisorFallbackCase(\n570:   result?: Pick<AdvisorHookResult, 'status' | 'freshness'>,\n571: ): AdvisorFallbackClassification {\n572:   if (!result || result.status === 'fail_open' || result.freshness === 'absent'\n573:     || (result.freshness === 'unavailable' && result.status !== 'skipped')) {\n574:     return {\n575:       fallbackCase: 'outage',\n576:       outageLabel: result?.freshness === 'absent'\n577:         ? 'absent'\n578:         : result?.status === 'degraded'\n579:           ? 'degraded'\n580:           : 'fail_open',\n581:     };\n582:   }\n583:   if (result.status === 'skipped' && result.freshness === 'unavailable') {\n584:     return { fallbackCase: 'skipped' };\n585:   }\n586:   return { fallbackCase: 'no-match' };\n587: }\n588: \n589: /** Render the fallback status and directive block when no advisor brief is available. */\n590: export function renderAdvisorFallbackDirective(\n591:   options: AdvisorBriefRenderOptions = {},\n592:   result?: Pick<AdvisorHookResult, 'status' | 'freshness'>,\n593: ): string {\n594:   const classification = advisorFallbackCase(result);\n595:   const head = classification.fallbackCase === 'outage'\n596:     ? `Advisor: outage (${classification.outageLabel});${options.setupWording === true ? ' for setup or health checks, run /doctor:setup;' : ''} route by hand: node .skilled/bin/skill-advisor.cjs advisor_recommend --json '{\"prompt\":\"<request>\"}' --format json`\n597:     : classification.fallbackCase === 'skipped'\n598:       ? 'Advisor: prompt skipped.'\n599:       : options.setupWording === true\n600:         ? `Advisor: no skill matched.${SETUP_HINT}`\n601:         : 'Advisor: no skill matched.';\n602:   const rendered = head + DIRECTIVES_LABEL + HYGIENE_DIRECTIVE;\n603:   observeAdvisorPolicy(rendered, options);\n604:   return rendered;\n605: }\n606: \n607: /** Render the outage fallback used when advisor execution times out or is unavailable. */\n608: export function renderAdvisorTimeoutFallback(\n609:   options: AdvisorBriefRenderOptions = {},\n610:   status: Extract<AdvisorHookResult['status'], 'fail_open' | 'degraded'> = 'fail_open',\n611: ): string {\n612:   return renderAdvisorFallbackDirective(options, { status, freshness: 'unavailable' });\n613: }\n614: \n615: export { sanitizeSkillLabel };"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/lib/render.ts\"}"},"time":{"start":1794527176943,"end":1794527177928}}}}
