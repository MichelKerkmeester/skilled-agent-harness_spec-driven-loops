{"type":"tool_use","timestamp":1794528094117,"sessionID":"ses_e2dcb14c4ffe1GsueiPYDsyX0B","part":{"partID":"prt_1d235a61e002h5W61TyR1cXecg","sessionID":"ses_e2dcb14c4ffe1GsueiPYDsyX0B","messageID":"msg_1d2359c0b001PYQ5U0Bz14YD1K","type":"tool","id":"call_a2d7e49e3e65472a8ae467b8","tool":"read","state":{"status":"completed","input":{"path":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/lib/scorer/scoring-constants.ts"},"output":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/lib/scorer/scoring-constants.ts, lines 1-276\n1: // ───────────────────────────────────────────────────────────────\n2: // MODULE: Advisor Scorer Calibration Constants\n3: // ───────────────────────────────────────────────────────────────\n4: // Single source of truth for the numeric tuning constants used by\n5: // `lib/scorer/fusion.ts` (`confidenceFor`, `uncertaintyFor`, and\n6: // `primaryIntentBonus`). The scorer-calibration bench\n7: // (`bench/scorer-calibration.bench.ts`) treats these values as the\n8: // \"tuned\" surface — naming them here lets a calibration pass be diffed\n9: // in PRs and rolled back in one place.\n10: //\n11: // IMPORTANT: This refactor MUST be byte-equivalent to the prior inline\n12: // numerics. Tweaking any value here is a behavior change, not a refactor.\n13: \n14: // ───────────────────────────────────────────────────────────────────\n15: // 1. TYPE DEFINITIONS\n16: // ───────────────────────────────────────────────────────────────────\n17: /**\n18:  * Confidence-assembly knobs used by `confidenceFor` in `fusion.ts`.\n19:  */\n20: export interface ConfidenceCalibration {\n21:   /** Floor confidence assigned to read-only explainer prompts that target the\n22:    * advisor itself, OR read-only explainer prompts where the read-only route\n23:    * is not allow-listed. */\n24:   readonly readOnlyExplainerFloor: number;\n25:   /** Base term added to the live-normalized confidence ramp. */\n26:   readonly baseConstant: number;\n27:   /** Multiplier applied to `liveNormalized` before clipping at 1.0. */\n28:   readonly liveNormalizedRampGain: number;\n29:   /** Coefficient on the ramp output that decides how much live-evidence\n30:    * pressure can lift base confidence. */\n31:   readonly liveNormalizedRampCoefficient: number;\n32:   /** When `readOnlyRouteAllowed` is true, base confidence is lifted to at\n33:    * least this value before rounding. */\n34:   readonly readOnlyRouteAllowedFloor: number;\n35:   /** When the derived lane dominates and direct evidence is below the\n36:    * `derivedDominantDirectScoreCeiling`, confidence is pinned to this value. */\n37:   readonly derivedDominantConfidence: number;\n38:   /** Maximum direct score still considered \"low direct evidence\" for the\n39:    * derived-dominant short-circuit. */\n40:   readonly derivedDominantDirectScoreCeiling: number;\n41:   /** Direct-score floor that, when paired with task-intent, lifts confidence\n42:    * to at least the task-intent floor. */\n43:   readonly taskIntentDirectScoreFloor: number;\n44:   /** Live-normalized floor that, when paired with task-intent, lifts\n45:    * confidence to at least the task-intent floor. */\n46:   readonly taskIntentLiveNormalizedFloor: number;\n47:   /** Confidence floor applied when task-intent is met. */\n48:   readonly taskIntentFloor: number;\n49:   /** Direct score above which confidence is lifted to at least the\n50:    * `directScoreFloor` (regardless of task-intent). */\n51:   readonly directScoreLiftThreshold: number;\n52:   /** Confidence floor applied to high-direct-score prompts. */\n53:   readonly directScoreFloor: number;\n54:   /** Direct-score threshold above which a fixed bonus is added to the base\n55:    * confidence (without forcing the floor). */\n56:   readonly directScoreBonusThreshold: number;\n57:   /** Bonus added when the direct score clears `directScoreBonusThreshold`. */\n58:   readonly directScoreBonus: number;\n59:   /** Hard ceiling on the final assembled confidence value. */\n60:   readonly hardCeiling: number;\n61: }\n62: \n63: /**\n64:  * Uncertainty-assembly knobs used by `uncertaintyFor` in `fusion.ts`.\n65:  */\n66: export interface UncertaintyCalibration {\n67:   /** Default uncertainty when no evidence is observed. */\n68:   readonly noEvidenceDefault: number;\n69:   /** Evidence count that drops uncertainty to the low floor. */\n70:   readonly highEvidenceCount: number;\n71:   /** Uncertainty applied at and above the high evidence count. */\n72:   readonly lowFloor: number;\n73:   /** Evidence count for the medium uncertainty band. */\n74:   readonly mediumEvidenceCount: number;\n75:   /** Uncertainty applied at the medium evidence band. */\n76:   readonly mediumFloor: number;\n77:   /** Evidence count for the elevated uncertainty band. */\n78:   readonly someEvidenceCount: number;\n79:   /** Uncertainty applied at the elevated band. */\n80:   readonly elevatedFloor: number;\n81:   /** Direct evidence threshold that triggers an uncertainty discount. */\n82:   readonly directEvidenceDiscountThreshold: number;\n83:   /** Discount applied when direct evidence clears the threshold. */\n84:   readonly directEvidenceDiscount: number;\n85:   /** Confidence threshold below which an uncertainty penalty is applied. */\n86:   readonly lowConfidencePenaltyThreshold: number;\n87:   /** Penalty added when confidence falls below the threshold. */\n88:   readonly lowConfidencePenalty: number;\n89:   /** Uncertainty floor applied to every member of a low-information ambiguity\n90:    * cluster. Above the default strict threshold so strict callers abstain,\n91:    * but below 1 so confidence-only callers still surface the best guess. */\n92:   readonly lowInfoAmbiguityFloor: number;\n93:   /** Hard floor on the final uncertainty value. */\n94:   readonly hardFloor: number;\n95:   /** Hard ceiling on the final uncertainty value. */\n96:   readonly hardCeiling: number;\n97: }\n98: \n99: /**\n100:  * Per-skill routing biases applied by `primaryIntentBonus` in `fusion.ts`.\n101:  *\n102:  * Naming convention: `<intent>SkillBonus` for positive (upweight) terms,\n103:  * `<intent>SkillPenalty` for negative (downweight) terms. The leading\n104:  * `routing.` namespace keeps the calibration surface scannable as a single\n105:  * block per call site.\n106:  */\n107: export interface RoutingCalibration {\n108:   // semantic search intent\n109:   readonly semanticSearchCodeGraphBonus: number;\n110:   // deep-review intent\n111:   readonly deepReviewSkCodeReviewPenalty: number;\n112:   // a request to write a test or helper that merely names a deep-review phrase\n113:   readonly deepReviewCodeAuthoringSkCodeBonus: number;\n114:   // deep-research intent (text-only)\n115:   readonly deepResearchOtherSkillsPenalty: number;\n116:   // deep-research-cycle phrase intent\n117:   readonly deepResearchCycleOtherSkillsPenalty: number;\n118:   // compare/audit/review + classifier-vocabulary intent\n119:   readonly compareAuditCodeReviewBonus: number;\n120:   // corpus/predictions/continuation/study-config intent\n121:   readonly corpusStudySpecKitBonus: number;\n122:   readonly corpusStudyOtherSkillsPenalty: number;\n123:   // a request to write a changelog that names its packet or spec folder only as\n124:   // the source: changelog authoring belongs to sk-doc, not the spec workflow\n125:   readonly changelogFromPacketSkDocBonus: number;\n126:   readonly changelogFromPacketSpecKitPenalty: number;\n127:   // explicit slash-command bonuses\n128:   readonly speckitResumeSpecKitBonus: number;\n129:   readonly speckitResumeCommandPenalty: number;\n130:   // explicit /speckit:plan command-bridge intent: the literal slash command must\n131:   // route to the command-spec-kit-plan bridge even when the prompt also carries a\n132:   // strong skill signal like \"docs\".\n133:   readonly speckitPlanCommandBonus: number;\n134:   readonly speckitPlanSkDocPenalty: number;\n135:   // code-mode / external-tool-chain intent: disambiguate toolchain-shaped\n136:   // prompts toward mcp-code-mode rather than the generic code skill.\n137:   readonly mcpToolchainCodeModeBonus: number;\n138:   readonly mcpToolchainSkCodePenalty: number;\n139:   // \"code audit\" review-target intent: a code audit is a single-pass code-review\n140:   // task, so sk-code must beat the deep-review loop skill on the near-tie.\n141:   readonly codeAuditCodeReviewBonus: number;\n142:   // review-loop colon syntax (\":review:auto\"): rank the deep-review loop above\n143:   // single-pass code review (the direct anchor already lifts its confidence).\n144:   readonly reviewLoopDeepReviewBonus: number;\n145:   // \"audit ... recommendations\" is a review task, not an advisor-self task.\n146:   readonly auditRecsCodeReviewBonus: number;\n147:   // Demotes the advisor — both its canonical id and its alias — from\n148:   // recommending itself on a read-only \"audit the recommendation quality\"\n149:   // prompt; auditing routing output is a review task, not an advisor\n150:   // invocation. This penalty is the SOLE defense against advisor\n151:   // self-recommendation on those prompts — there is no separate guard behind it,\n152:   // so this is the only thing demoting the advisor. It must be applied through\n153:   // the canonical self-rec id\n154:   // set so the alias is demoted too, not just the exact id. Do not remove or\n155:   // zero it without a documented, tested replacement, or the advisor can rank\n156:   // itself first on audit/explainer prompts again with nothing to stop it.\n157:   readonly auditRecsAdvisorPenalty: number;\n158:   // phase-folder intent\n159:   readonly phaseFolderSpecKitBonus: number;\n160:   // save-context / save-memory intent\n161:   readonly saveContextMemorySaveBonus: number;\n162:   readonly saveContextMemorySpecKitPenalty: number;\n163:   // create-agent intent\n164:   readonly createAgentCreateAgentBonus: number;\n165:   readonly createAgentSkDocPenalty: number;\n166:   // create-testing-playbook intent\n167:   readonly createTestingPlaybookBonus: number;\n168:   readonly createTestingPlaybookSkDocPenalty: number;\n169:   readonly createTestingPlaybookOtherSkillsPenalty: number;\n170: }\n171: \n172: export interface ScoringCalibration {\n173:   readonly confidence: ConfidenceCalibration;\n174:   readonly uncertainty: UncertaintyCalibration;\n175:   readonly routing: RoutingCalibration;\n176: }\n177: \n178: // ───────────────────────────────────────────────────────────────────\n179: // 2. CONSTANTS\n180: // ───────────────────────────────────────────────────────────────────\n181: export const SCORING_CALIBRATION: ScoringCalibration = Object.freeze({\n182:   confidence: Object.freeze({\n183:     readOnlyExplainerFloor: 0.25,\n184:     baseConstant: 0.52,\n185:     liveNormalizedRampGain: 1.25,\n186:     liveNormalizedRampCoefficient: 0.43,\n187:     readOnlyRouteAllowedFloor: 0.82,\n188:     derivedDominantConfidence: 0.72,\n189:     derivedDominantDirectScoreCeiling: 0.2,\n190:     taskIntentDirectScoreFloor: 0.18,\n191:     taskIntentLiveNormalizedFloor: 0.2,\n192:     taskIntentFloor: 0.82,\n193:     directScoreLiftThreshold: 0.65,\n194:     directScoreFloor: 0.82,\n195:     directScoreBonusThreshold: 0.85,\n196:     directScoreBonus: 0.04,\n197:     hardCeiling: 0.95,\n198:   }),\n199:   uncertainty: Object.freeze({\n200:     noEvidenceDefault: 0.42,\n201:     highEvidenceCount: 5,\n202:     lowFloor: 0.18,\n203:     mediumEvidenceCount: 3,\n204:     mediumFloor: 0.22,\n205:     someEvidenceCount: 1,\n206:     elevatedFloor: 0.30,\n207:     directEvidenceDiscountThreshold: 0.75,\n208:     directEvidenceDiscount: 0.06,\n209:     lowConfidencePenaltyThreshold: 0.8,\n210:     lowConfidencePenalty: 0.08,\n211:     lowInfoAmbiguityFloor: 0.42,\n212:     hardFloor: 0.08,\n213:     hardCeiling: 0.95,\n214:   }),\n215:   routing: Object.freeze({\n216:     semanticSearchCodeGraphBonus: 0.5,\n217:     deepReviewSkCodeReviewPenalty: -0.25,\n218:     deepReviewCodeAuthoringSkCodeBonus: 0.1,\n219:     deepResearchOtherSkillsPenalty: -0.18,\n220:     deepResearchCycleOtherSkillsPenalty: -0.18,\n221:     compareAuditCodeReviewBonus: 0.35,\n222:     corpusStudySpecKitBonus: 0.35,\n223:     corpusStudyOtherSkillsPenalty: -0.16,\n224:     changelogFromPacketSkDocBonus: 0.12,\n225:     changelogFromPacketSpecKitPenalty: -0.12,\n226:     speckitResumeSpecKitBonus: 0.16,\n227:     speckitResumeCommandPenalty: -0.12,\n228:     speckitPlanCommandBonus: 0.5,\n229:     speckitPlanSkDocPenalty: -0.18,\n230:     mcpToolchainCodeModeBonus: 0.5,\n231:     mcpToolchainSkCodePenalty: -0.18,\n232:     codeAuditCodeReviewBonus: 0.2,\n233:     reviewLoopDeepReviewBonus: 0.5,\n234:     auditRecsCodeReviewBonus: 0.35,\n235:     // Sole defense against advisor self-recommendation on audit prompts; see the\n236:     // interface declaration above. Must not be zeroed without a tested replacement.\n237:     auditRecsAdvisorPenalty: -0.25,\n238:     phaseFolderSpecKitBonus: 0.35,\n239:     saveContextMemorySaveBonus: 0.55,\n240:     saveContextMemorySpecKitPenalty: -0.25,\n241:     createAgentCreateAgentBonus: 0.55,\n242:     createAgentSkDocPenalty: -0.18,\n243:     createTestingPlaybookBonus: 0.65,\n244:     createTestingPlaybookSkDocPenalty: -0.3,\n245:     createTestingPlaybookOtherSkillsPenalty: -0.2,\n246:   }),\n247: });\n248: \n249: // ───────────────────────────────────────────────────────────────────\n250: // 3. CORE LOGIC\n251: // ───────────────────────────────────────────────────────────────────\n252: export interface RoutingCalibrationOverride {\n253:   memorySaveBonus?: number;\n254:   createAgentBonus?: number;\n255:   testingPlaybookBonus?: number;\n256: }\n257: \n258: export function resolvedCalibration(): ScoringCalibration {\n259:   const raw = process.env.SPECKIT_ADVISOR_CALIBRATION_OVERRIDE_JSON;\n260:   if (!raw) return SCORING_CALIBRATION;\n261:   try {\n262:     const override = JSON.parse(raw) as RoutingCalibrationOverride;\n263:     return {\n264:       ...SCORING_CALIBRATION,\n265:       routing: Object.freeze({\n266:         ...SCORING_CALIBRATION.routing,\n267:         ...(override.memorySaveBonus !== undefined ? { saveContextMemorySaveBonus: override.memorySaveBonus } : {}),\n268:         ...(override.createAgentBonus !== undefined ? { createAgentCreateAgentBonus: override.createAgentBonus } : {}),\n269:         ...(override.testingPlaybookBonus !== undefined ? { createTestingPlaybookBonus: override.testingPlaybookBonus } : {}),\n270:       }),\n271:     };\n272:   } catch {\n273:     console.warn('[skill-advisor] Failed to parse SPECKIT_ADVISOR_CALIBRATION_OVERRIDE_JSON; using defaults');\n274:     return SCORING_CALIBRATION;\n275:   }\n276: }","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/lib/scorer/scoring-constants.ts, lines 1-276\n1: // ───────────────────────────────────────────────────────────────\n2: // MODULE: Advisor Scorer Calibration Constants\n3: // ───────────────────────────────────────────────────────────────\n4: // Single source of truth for the numeric tuning constants used by\n5: // `lib/scorer/fusion.ts` (`confidenceFor`, `uncertaintyFor`, and\n6: // `primaryIntentBonus`). The scorer-calibration bench\n7: // (`bench/scorer-calibration.bench.ts`) treats these values as the\n8: // \"tuned\" surface — naming them here lets a calibration pass be diffed\n9: // in PRs and rolled back in one place.\n10: //\n11: // IMPORTANT: This refactor MUST be byte-equivalent to the prior inline\n12: // numerics. Tweaking any value here is a behavior change, not a refactor.\n13: \n14: // ───────────────────────────────────────────────────────────────────\n15: // 1. TYPE DEFINITIONS\n16: // ───────────────────────────────────────────────────────────────────\n17: /**\n18:  * Confidence-assembly knobs used by `confidenceFor` in `fusion.ts`.\n19:  */\n20: export interface ConfidenceCalibration {\n21:   /** Floor confidence assigned to read-only explainer prompts that target the\n22:    * advisor itself, OR read-only explainer prompts where the read-only route\n23:    * is not allow-listed. */\n24:   readonly readOnlyExplainerFloor: number;\n25:   /** Base term added to the live-normalized confidence ramp. */\n26:   readonly baseConstant: number;\n27:   /** Multiplier applied to `liveNormalized` before clipping at 1.0. */\n28:   readonly liveNormalizedRampGain: number;\n29:   /** Coefficient on the ramp output that decides how much live-evidence\n30:    * pressure can lift base confidence. */\n31:   readonly liveNormalizedRampCoefficient: number;\n32:   /** When `readOnlyRouteAllowed` is true, base confidence is lifted to at\n33:    * least this value before rounding. */\n34:   readonly readOnlyRouteAllowedFloor: number;\n35:   /** When the derived lane dominates and direct evidence is below the\n36:    * `derivedDominantDirectScoreCeiling`, confidence is pinned to this value. */\n37:   readonly derivedDominantConfidence: number;\n38:   /** Maximum direct score still considered \"low direct evidence\" for the\n39:    * derived-dominant short-circuit. */\n40:   readonly derivedDominantDirectScoreCeiling: number;\n41:   /** Direct-score floor that, when paired with task-intent, lifts confidence\n42:    * to at least the task-intent floor. */\n43:   readonly taskIntentDirectScoreFloor: number;\n44:   /** Live-normalized floor that, when paired with task-intent, lifts\n45:    * confidence to at least the task-intent floor. */\n46:   readonly taskIntentLiveNormalizedFloor: number;\n47:   /** Confidence floor applied when task-intent is met. */\n48:   readonly taskIntentFloor: number;\n49:   /** Direct score above which confidence is lifted to at least the\n50:    * `directScoreFloor` (regardless of task-intent). */\n51:   readonly directScoreLiftThreshold: number;\n52:   /** Confidence floor applied to high-direct-score prompts. */\n53:   readonly directScoreFloor: number;\n54:   /** Direct-score threshold above which a fixed bonus is added to the base\n55:    * confidence (without forcing the floor). */\n56:   readonly directScoreBonusThreshold: number;\n57:   /** Bonus added when the direct score clears `directScoreBonusThreshold`. */\n58:   readonly directScoreBonus: number;\n59:   /** Hard ceiling on the final assembled confidence value. */\n60:   readonly hardCeiling: number;\n61: }\n62: \n63: /**\n64:  * Uncertainty-assembly knobs used by `uncertaintyFor` in `fusion.ts`.\n65:  */\n66: export interface UncertaintyCalibration {\n67:   /** Default uncertainty when no evidence is observed. */\n68:   readonly noEvidenceDefault: number;\n69:   /** Evidence count that drops uncertainty to the low floor. */\n70:   readonly highEvidenceCount: number;\n71:   /** Uncertainty applied at and above the high evidence count. */\n72:   readonly lowFloor: number;\n73:   /** Evidence count for the medium uncertainty band. */\n74:   readonly mediumEvidenceCount: number;\n75:   /** Uncertainty applied at the medium evidence band. */\n76:   readonly mediumFloor: number;\n77:   /** Evidence count for the elevated uncertainty band. */\n78:   readonly someEvidenceCount: number;\n79:   /** Uncertainty applied at the elevated band. */\n80:   readonly elevatedFloor: number;\n81:   /** Direct evidence threshold that triggers an uncertainty discount. */\n82:   readonly directEvidenceDiscountThreshold: number;\n83:   /** Discount applied when direct evidence clears the threshold. */\n84:   readonly directEvidenceDiscount: number;\n85:   /** Confidence threshold below which an uncertainty penalty is applied. */\n86:   readonly lowConfidencePenaltyThreshold: number;\n87:   /** Penalty added when confidence falls below the threshold. */\n88:   readonly lowConfidencePenalty: number;\n89:   /** Uncertainty floor applied to every member of a low-information ambiguity\n90:    * cluster. Above the default strict threshold so strict callers abstain,\n91:    * but below 1 so confidence-only callers still surface the best guess. */\n92:   readonly lowInfoAmbiguityFloor: number;\n93:   /** Hard floor on the final uncertainty value. */\n94:   readonly hardFloor: number;\n95:   /** Hard ceiling on the final uncertainty value. */\n96:   readonly hardCeiling: number;\n97: }\n98: \n99: /**\n100:  * Per-skill routing biases applied by `primaryIntentBonus` in `fusion.ts`.\n101:  *\n102:  * Naming convention: `<intent>SkillBonus` for positive (upweight) terms,\n103:  * `<intent>SkillPenalty` for negative (downweight) terms. The leading\n104:  * `routing.` namespace keeps the calibration surface scannable as a single\n105:  * block per call site.\n106:  */\n107: export interface RoutingCalibration {\n108:   // semantic search intent\n109:   readonly semanticSearchCodeGraphBonus: number;\n110:   // deep-review intent\n111:   readonly deepReviewSkCodeReviewPenalty: number;\n112:   // a request to write a test or helper that merely names a deep-review phrase\n113:   readonly deepReviewCodeAuthoringSkCodeBonus: number;\n114:   // deep-research intent (text-only)\n115:   readonly deepResearchOtherSkillsPenalty: number;\n116:   // deep-research-cycle phrase intent\n117:   readonly deepResearchCycleOtherSkillsPenalty: number;\n118:   // compare/audit/review + classifier-vocabulary intent\n119:   readonly compareAuditCodeReviewBonus: number;\n120:   // corpus/predictions/continuation/study-config intent\n121:   readonly corpusStudySpecKitBonus: number;\n122:   readonly corpusStudyOtherSkillsPenalty: number;\n123:   // a request to write a changelog that names its packet or spec folder only as\n124:   // the source: changelog authoring belongs to sk-doc, not the spec workflow\n125:   readonly changelogFromPacketSkDocBonus: number;\n126:   readonly changelogFromPacketSpecKitPenalty: number;\n127:   // explicit slash-command bonuses\n128:   readonly speckitResumeSpecKitBonus: number;\n129:   readonly speckitResumeCommandPenalty: number;\n130:   // explicit /speckit:plan command-bridge intent: the literal slash command must\n131:   // route to the command-spec-kit-plan bridge even when the prompt also carries a\n132:   // strong skill signal like \"docs\".\n133:   readonly speckitPlanCommandBonus: number;\n134:   readonly speckitPlanSkDocPenalty: number;\n135:   // code-mode / external-tool-chain intent: disambiguate toolchain-shaped\n136:   // prompts toward mcp-code-mode rather than the generic code skill.\n137:   readonly mcpToolchainCodeModeBonus: number;\n138:   readonly mcpToolchainSkCodePenalty: number;\n139:   // \"code audit\" review-target intent: a code audit is a single-pass code-review\n140:   // task, so sk-code must beat the deep-review loop skill on the near-tie.\n141:   readonly codeAuditCodeReviewBonus: number;\n142:   // review-loop colon syntax (\":review:auto\"): rank the deep-review loop above\n143:   // single-pass code review (the direct anchor already lifts its confidence).\n144:   readonly reviewLoopDeepReviewBonus: number;\n145:   // \"audit ... recommendations\" is a review task, not an advisor-self task.\n146:   readonly auditRecsCodeReviewBonus: number;\n147:   // Demotes the advisor — both its canonical id and its alias — from\n148:   // recommending itself on a read-only \"audit the recommendation quality\"\n149:   // prompt; auditing routing output is a review task, not an advisor\n150:   // invocation. This penalty is the SOLE defense against advisor\n151:   // self-recommendation on those prompts — there is no separate guard behind it,\n152:   // so this is the only thing demoting the advisor. It must be applied through\n153:   // the canonical self-rec id\n154:   // set so the alias is demoted too, not just the exact id. Do not remove or\n155:   // zero it without a documented, tested replacement, or the advisor can rank\n156:   // itself first on audit/explainer prompts again with nothing to stop it.\n157:   readonly auditRecsAdvisorPenalty: number;\n158:   // phase-folder intent\n159:   readonly phaseFolderSpecKitBonus: number;\n160:   // save-context / save-memory intent\n161:   readonly saveContextMemorySaveBonus: number;\n162:   readonly saveContextMemorySpecKitPenalty: number;\n163:   // create-agent intent\n164:   readonly createAgentCreateAgentBonus: number;\n165:   readonly createAgentSkDocPenalty: number;\n166:   // create-testing-playbook intent\n167:   readonly createTestingPlaybookBonus: number;\n168:   readonly createTestingPlaybookSkDocPenalty: number;\n169:   readonly createTestingPlaybookOtherSkillsPenalty: number;\n170: }\n171: \n172: export interface ScoringCalibration {\n173:   readonly confidence: ConfidenceCalibration;\n174:   readonly uncertainty: UncertaintyCalibration;\n175:   readonly routing: RoutingCalibration;\n176: }\n177: \n178: // ───────────────────────────────────────────────────────────────────\n179: // 2. CONSTANTS\n180: // ───────────────────────────────────────────────────────────────────\n181: export const SCORING_CALIBRATION: ScoringCalibration = Object.freeze({\n182:   confidence: Object.freeze({\n183:     readOnlyExplainerFloor: 0.25,\n184:     baseConstant: 0.52,\n185:     liveNormalizedRampGain: 1.25,\n186:     liveNormalizedRampCoefficient: 0.43,\n187:     readOnlyRouteAllowedFloor: 0.82,\n188:     derivedDominantConfidence: 0.72,\n189:     derivedDominantDirectScoreCeiling: 0.2,\n190:     taskIntentDirectScoreFloor: 0.18,\n191:     taskIntentLiveNormalizedFloor: 0.2,\n192:     taskIntentFloor: 0.82,\n193:     directScoreLiftThreshold: 0.65,\n194:     directScoreFloor: 0.82,\n195:     directScoreBonusThreshold: 0.85,\n196:     directScoreBonus: 0.04,\n197:     hardCeiling: 0.95,\n198:   }),\n199:   uncertainty: Object.freeze({\n200:     noEvidenceDefault: 0.42,\n201:     highEvidenceCount: 5,\n202:     lowFloor: 0.18,\n203:     mediumEvidenceCount: 3,\n204:     mediumFloor: 0.22,\n205:     someEvidenceCount: 1,\n206:     elevatedFloor: 0.30,\n207:     directEvidenceDiscountThreshold: 0.75,\n208:     directEvidenceDiscount: 0.06,\n209:     lowConfidencePenaltyThreshold: 0.8,\n210:     lowConfidencePenalty: 0.08,\n211:     lowInfoAmbiguityFloor: 0.42,\n212:     hardFloor: 0.08,\n213:     hardCeiling: 0.95,\n214:   }),\n215:   routing: Object.freeze({\n216:     semanticSearchCodeGraphBonus: 0.5,\n217:     deepReviewSkCodeReviewPenalty: -0.25,\n218:     deepReviewCodeAuthoringSkCodeBonus: 0.1,\n219:     deepResearchOtherSkillsPenalty: -0.18,\n220:     deepResearchCycleOtherSkillsPenalty: -0.18,\n221:     compareAuditCodeReviewBonus: 0.35,\n222:     corpusStudySpecKitBonus: 0.35,\n223:     corpusStudyOtherSkillsPenalty: -0.16,\n224:     changelogFromPacketSkDocBonus: 0.12,\n225:     changelogFromPacketSpecKitPenalty: -0.12,\n226:     speckitResumeSpecKitBonus: 0.16,\n227:     speckitResumeCommandPenalty: -0.12,\n228:     speckitPlanCommandBonus: 0.5,\n229:     speckitPlanSkDocPenalty: -0.18,\n230:     mcpToolchainCodeModeBonus: 0.5,\n231:     mcpToolchainSkCodePenalty: -0.18,\n232:     codeAuditCodeReviewBonus: 0.2,\n233:     reviewLoopDeepReviewBonus: 0.5,\n234:     auditRecsCodeReviewBonus: 0.35,\n235:     // Sole defense against advisor self-recommendation on audit prompts; see the\n236:     // interface declaration above. Must not be zeroed without a tested replacement.\n237:     auditRecsAdvisorPenalty: -0.25,\n238:     phaseFolderSpecKitBonus: 0.35,\n239:     saveContextMemorySaveBonus: 0.55,\n240:     saveContextMemorySpecKitPenalty: -0.25,\n241:     createAgentCreateAgentBonus: 0.55,\n242:     createAgentSkDocPenalty: -0.18,\n243:     createTestingPlaybookBonus: 0.65,\n244:     createTestingPlaybookSkDocPenalty: -0.3,\n245:     createTestingPlaybookOtherSkillsPenalty: -0.2,\n246:   }),\n247: });\n248: \n249: // ───────────────────────────────────────────────────────────────────\n250: // 3. CORE LOGIC\n251: // ───────────────────────────────────────────────────────────────────\n252: export interface RoutingCalibrationOverride {\n253:   memorySaveBonus?: number;\n254:   createAgentBonus?: number;\n255:   testingPlaybookBonus?: number;\n256: }\n257: \n258: export function resolvedCalibration(): ScoringCalibration {\n259:   const raw = process.env.SPECKIT_ADVISOR_CALIBRATION_OVERRIDE_JSON;\n260:   if (!raw) return SCORING_CALIBRATION;\n261:   try {\n262:     const override = JSON.parse(raw) as RoutingCalibrationOverride;\n263:     return {\n264:       ...SCORING_CALIBRATION,\n265:       routing: Object.freeze({\n266:         ...SCORING_CALIBRATION.routing,\n267:         ...(override.memorySaveBonus !== undefined ? { saveContextMemorySaveBonus: override.memorySaveBonus } : {}),\n268:         ...(override.createAgentBonus !== undefined ? { createAgentCreateAgentBonus: override.createAgentBonus } : {}),\n269:         ...(override.testingPlaybookBonus !== undefined ? { createTestingPlaybookBonus: override.testingPlaybookBonus } : {}),\n270:       }),\n271:     };\n272:   } catch {\n273:     console.warn('[skill-advisor] Failed to parse SPECKIT_ADVISOR_CALIBRATION_OVERRIDE_JSON; using defaults');\n274:     return SCORING_CALIBRATION;\n275:   }\n276: }"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/lib/scorer/scoring-constants.ts\"}"},"time":{"start":1794528093726,"end":1794528094117}}}}
