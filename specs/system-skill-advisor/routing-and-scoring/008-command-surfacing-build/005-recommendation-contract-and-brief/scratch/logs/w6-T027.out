  const allowListCommands = new Set(allowList.map((entry) => entry.command));\n245:   return sorted([\n246:     ...metadataProjection().filter((entry) => !allowListCommands.has(entry.command)),\n247:     ...allowList.map(({ reason: _reason, ...entry }) => ({\n248:       ...entry,\n249:       source: 'scripts/command-bridges/allow-list.json',\n250:     })),\n251:     ...doctorProjection(),\n252:   ]);\n253: }\n254: \n255: function compatibilitySnapshot(): CompatibilitySnapshot {\n256:   return JSON.parse(readFileSync(COMPATIBILITY_PATH, 'utf8')) as CompatibilitySnapshot;\n257: }\n258: \n259: // A compatibility row is hand-curated: its order, runtime id and phrases are the\n260: // curation itself, so the expectation reads them verbatim.\n261: function handRows(platform: Runtime): CompatibilityRow[] {\n262:   return compatibilitySnapshot()[platform]\n263:     .filter((row) => !row.inventoryId.startsWith(DOCTOR_PREFIX))\n264:     .sort((left, right) => left.order - right.order);\n265: }\n266: \n267: // A standalone skill's command is the one bridge its metadata declares, matched by\n268: // command rather than by id because a command can enter the inventory under a row\n269: // carrying its own historical id.\n270: function standaloneCommands(): StandaloneCommand[] {\n271:   const records = new Map(\n272:     metadataProjection()\n273:       .filter((entry) => entry.standalone === true)\n274:       .map((entry) => [entry.command, entry] as const),\n[Output truncated. Continue reading with offset: 275]"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"limit\":45,\"offset\":230,\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/tests/command-bridges-drift-guard.vitest.ts\"}"},"time":{"start":1794528203320,"end":1794528203776}}}}
