h,\n1276:       next: replaceMarkedBlock(\n1277:         commandAttachWithRows,\n1278:         COMMAND_ATTACH_GENERATED_START,\n1279:         COMMAND_ATTACH_GENERATED_END,\n1280:         renderModeCommands(modeCommands),\n1281:         COMMAND_ATTACH_PATH,\n1282:       ),\n1283:     },\n1284:   ];\n1285: }\n1286: \n1287: // ───────────────────────────────────────────────────────────────────\n1288: // 4. CORE LOGIC\n1289: // ───────────────────────────────────────────────────────────────────\n1290: \n1291: function main() {\n1292:   // CLI-only rejection: requiring this module (for example from tests) must\n1293:   // not exit on arguments belonging to the host process.\n1294:   if (require.main === module) {\n1295:     const unknownArg = process.argv.slice(2).find((token) => token !== '--check');\n1296:     if (unknownArg !== undefined) {\n1297:       console.error(`derive-command-bridges.cjs: unknown option: ${unknownArg}`);\n1298:       console.error('usage: derive-command-bridges.cjs [--check]');\n1299:       process.exit(2);\n1300:     }\n1301:   }\n1302:   const checkOnly = process.argv.includes('--check');\n1303:   const metadata = metadataEntries();\n1304:   const allowList = allowListEntries();\n1305:   const doctor = doctorRouteEntries();\n1306:   // The identity check compares command names against the declarations that make\n1307:   // a command real; an allow-list row only repeats an ownership id for a command\n1308:   // the tree and the metadata already name, so it adds nothing there.\n1309:   const tree = commandTreeNames();\n1310:   const metadataRisk = metadataRiskRecords();\n1311:   const doctorRisk = doctorRiskRecords();\n1312:   const modeCommands = modeCommandRecords();\n1313:   const violations = identityViolations({\n1314:     treeCommands: tree,\n1315:     metadataCommands: metadataRisk.map((record) => record.command),\n1316:     doctorCommands: doctorRisk.map((record) => record.command),\n1317:   });\n1318:   if (violations.length > 0) {\n1319:     throw new Error(`[command-bridges] command inventory mismatch:\\n${violations.join('\\n')}`);\n1320:   }\n1321:   // A command the allow-list already carries keeps that row's id: both scorers\n1322:   // know it, and a second id for one command would be a second bridge.\n1323:   const allowListCommands = new Set(allowList.map((entry) => entry.command));\n1324:   const bridgedMetadata = metadata.filter((entry) => !allowListCommands.has(entry.command));\n1325:   const inventory = [...bridgedMetadata, ...allowList, ...doctor]\n1326:     .sort((left, right) => left.id.localeCompare(right.id));\n1327:   assertUniqueIds(inventory);\n1328:   const compatibility = runtimeCompatibility(inventory, metadata);\n1329:   const entries = inventory.map((entry) => {\n1330:     const isDoctor = entry.id.startsWith(DOCTOR_PREFIX);\n1331:     const typescript = compatibility.typescript.get(entry.id);\n1332:     const python = compatibility.python.get(entry.id);\n1333:     // A command nothing describes has nothing written to embed, so the field\n1334:     // appears only where a source sentence exists for it.\n1335:     const meaning = typescript ? entryMeaning(entry.id, entry.command, isDoctor) : undefined;\n1336:     const runtime = { typescript: { enabled: false }, python: { enabled: false } };\n1337:     if (typescript) {\n1338:       runtime.typescript = {\n1339:         enabled: true,\n1340:         ...(isDoctor ? doctorRuntime(entry.id, 'typescript', typescript) : typescript),\n1341:       };\n1342:     }\n1343:     if (python) {\n1344:       runtime.python = {\n1345:         enabled: true,\n1346:         ...(isDoctor ? doctorRuntime(entry.id, 'python', python) : python),\n1347:       };\n1348:     }\n1349:     return {\n1350:       ...entry,\n1351:       ...(meaning ? { embeddingText: commandEmbeddingText(meaning) } : {}),\n1352:       runtime,\n1353:     };\n1354:   });\n1355: \n1356:   const policies = commandPolicies();\n1357:   const projection = {\n1358:     schemaVersion: 2,\n1359:     generatedBy: 'scripts/command-bridges/derive-command-bridges.cjs',\n1360:     counts: {\n1361:       commandMetadata: bridgedMetadata.length,\n1362:       allowList: allowList.length,\n1363:       doctorRoutes: doctor.length,\n1364:       generated: entries.length,\n1365:       typescriptActive: compatibility.typescript.size,\n1366:       pythonActive: compatibility.python.size,\n1367:     },\n1368:     entries,\n1369:     commandPolicies: policies,\n1370:   };\n1371:   const output = `${JSON.stringify(projection, null, 2)}\\n`;\n1372:   const sources = generatedSources(\n1373:     entries,\n1374:     compatibility.pythonOwnerNormalization,\n1375:     modeCommands,\n1376:     policies,\n1377:   );\n1378:   const changed = [\n1379:     ...(readFileSync(OUTPUT_PATH, 'utf8') === output ? [] : [OUTPUT_PATH]),\n1380:     ...sources.filter(({ current, next }) => current !== next).map(({ path }) => path),\n1381:   ];\n1382: \n1383:   if (!checkOnly) {\n1384:     writeFileSync(OUTPUT_PATH, output, 'utf8');\n1385:     for (const source of sources) {\n1386:       if (source.current !== source.next) {\n1387:         writeFileSync(source.path, source.next, 'utf8');\n1388:       }\n1389:     }\n1390:   }\n1391: \n1392:   console.log(JSON.stringify({\n1393:     status: changed.length === 0 ? 'fresh' : checkOnly ? 'stale' : 'generated',\n1394:     counts: projection.counts,\n1395:     changed: changed.map(sourcePath),\n1396:   }, null, 2));\n1397:   if (checkOnly && changed.length > 0) process.exitCode = 1;\n1398: }\n1399: \n1400: if (require.main === module) main();\n1401: \n1402: module.exports = {\n1403:   metadataEntries,\n1404:   commandTreeNames,\n1405:   modeCommandRecords,\n1406:   validateRiskKeys,\n1407:   derivePolicy,\n1408:   metadataRiskRecords,\n1409:   doctorRiskRecords,\n1410:   doctorLeadPhrases,\n1411:   identityViolations,\n1412:   commandPolicies,\n1413: };","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"te