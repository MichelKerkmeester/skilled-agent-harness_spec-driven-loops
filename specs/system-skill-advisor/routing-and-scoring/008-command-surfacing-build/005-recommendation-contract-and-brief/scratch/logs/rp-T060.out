{"type":"tool_use","timestamp":1794531173681,"sessionID":"ses_e2d9b8ff0ffeLkeg7wA7t9JeIy","part":{"partID":"prt_1d264a31c001DQsTwnEx0a6zDC","sessionID":"ses_e2d9b8ff0ffeLkeg7wA7t9JeIy","messageID":"msg_1d26491aa001YFGRv6GloyFmaf","type":"tool","id":"call_e49c5e04841442209f2a4c16","tool":"read","state":{"status":"completed","input":{"path":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/tests/parity/python-ts-parity.vitest.ts"},"output":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/tests/parity/python-ts-parity.vitest.ts, lines 1-297\n1: // ───────────────────────────────────────────────────────────────\n2: // MODULE: Python TS Parity Tests\n3: // ───────────────────────────────────────────────────────────────\n4: \n5: import { existsSync, mkdtempSync, readFileSync } from 'node:fs';\n6: import { tmpdir } from 'node:os';\n7: import { dirname, join, resolve } from 'node:path';\n8: import { fileURLToPath } from 'node:url';\n9: import { spawnSync } from 'node:child_process';\n10: \n11: import { afterAll, beforeAll, describe, expect, it, vi } from 'vitest';\n12: import { findAdvisorWorkspaceRoot } from '../../lib/utils/workspace-root.js';\n13: \n14: // Private `local-*` skills linked in through this variable live outside the\n15: // checkout, so a pinned count measured on a clean checkout must not see them.\n16: const PRIVATE_SKILL_ROOTS_ENV = 'SPECKIT_PRIVATE_SKILL_ROOTS';\n17: const PREVIOUS_PRIVATE_SKILL_ROOTS = process.env[PRIVATE_SKILL_ROOTS_ENV];\n18: \n19: function restorePrivateSkillRoots(): void {\n20:   if (PREVIOUS_PRIVATE_SKILL_ROOTS === undefined) delete process.env[PRIVATE_SKILL_ROOTS_ENV];\n21:   else process.env[PRIVATE_SKILL_ROOTS_ENV] = PREVIOUS_PRIVATE_SKILL_ROOTS;\n22: }\n23: \n24: // Pinned force-local regime, set before the scorer import because the scorer\n25: // reads the database directory at module load. This is the regime CI runs in:\n26: // no skill-graph.sqlite, built-in semantic off. Without it the in-process\n27: // scorer and the spawned Python reference both read whatever locally built\n28: // graph exists, and the pinned counts below move with a daemon rebuild instead\n29: // of with a diff.\n30: process.env.SYSTEM_SKILL_ADVISOR_DB_DIR = mkdtempSync(join(tmpdir(), 'python-ts-parity-'));\n31: process.env.SKILL_ADVISOR_DISABLE_BUILTIN_SEMANTIC = '1';\n32: process.env.SPECKIT_SKILL_ADVISOR_FORCE_LOCAL = '1';\n33: delete process.env[PRIVATE_SKILL_ROOTS_ENV];\n34: \n35: const { runLaneAblation } = await import('../../lib/scorer/ablation.js');\n36: const { scoreAdvisorPrompt } = await import('../../lib/scorer/fusion.js');\n37: \n38: interface CorpusRow {\n39:   readonly id: string;\n40:   readonly prompt: string;\n41:   readonly skill_top_1: string;\n42: }\n43: \n44: interface PythonRow {\n45:   readonly prompt: string;\n46:   readonly top: string | null;\n47: }\n48: \n49: // Reviewed-accepted top-1 divergences (Python-correct, native scorer diverges),\n50: // aligned with the legacy corpus-parity ledger. What remains is cross-lane /\n51: // labeling-edge loss that explicit-lane calibration cannot resolve. Entries are\n52: // pruned as targeted work resolves them, which is the only reason this list ever\n53: // shrinks — rr-iter3-093 and rr-iter3-145 each left it that way.\n54: //\n55: // rr-iter2-020 is sk-code gold that the native scorer loses to sk-doc by under\n56: // 0.04 in the pinned regime. It is vocabulary bleed between the two hubs and\n57: // stays here until that is resolved, not hidden by a local graph.\n58: const ACCEPTED_PARITY_REGRESSION_IDS: string[] = [\n59:   // rr-hub6-204 and rr-hub6-207 left this list: the corpus growth (orchestration/jev\n60:   // skills) let the TS scorer recover both prompts to the Python-correct\n61:   // answer, so they no longer diverge. Conscious removal, reviewed against\n62:   // gold.\n63:   //\n64:   // rr-iter3-093 and rr-iter3-182 left this list when sk-code absorbed the\n65:   // retired sk-design-fundamentals mode and its screen-review vocabulary: the\n66:   // pinned native scorer now reaches the sk-code gold on both prompts.\n67:   //\n68:   // rr-iter3-146 left this list when the explicit lane stopped reading a negated\n69:   // write (\"don't write anything back\") as a request to write docs.\n70:   //\n71:   // rr-iter3-166 left this list when the hyphenated deep-review and deep-research\n72:   // workflow names became system-deep-loop lexical hints, the form the prompt uses.\n73:   'rr-iter2-020',\n74:   'rr-iter3-092',\n75:   'rr-iter3-097',\n76:   'rr-iter3-099',\n77:   // rr-iter3-105 typed \"/memory:save\" outright and carries the save gold. The\n78:   // Python reference answers it; the native scorer spends slightly more weight\n79:   // on the packet vocabulary and hands the row to system-spec-kit (0.625)\n80:   // ahead of the save command (0.56). Recorded as a divergence, not accepted as\n81:   // correct: a named command must outrank the hub that owns its topic.\n82:   'rr-iter3-105',\n83: ];\n84: \n85: function findWorkspaceRoot(): string {\n86:   const start = dirname(fileURLToPath(import.meta.url));\n87:   const sentinel = '.skilled/skills/system-spec-kit/SKILL.md';\n88:   const candidate = findAdvisorWorkspaceRoot(start, { maxDepth: 12, sentinel });\n89:   if (!existsSync(resolve(candidate, sentinel))) {\n90:     throw new Error('Unable to locate workspace root.');\n91:   }\n92:   return candidate;\n93: }\n94: \n95: const WORKSPACE_ROOT = findWorkspaceRoot();\n96: const SPECKIT_BENCH_CORPUS_PATH = '.skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/labeled-prompts.jsonl';\n97: const CORPUS_PATH = resolve(WORKSPACE_ROOT, SPECKIT_BENCH_CORPUS_PATH);\n98: \n99: function loadCorpus(): CorpusRow[] {\n100:   return readFileSync(CORPUS_PATH, 'utf8')\n101:     .trim()\n102:     .split('\\n')\n103:     .map((line) => JSON.parse(line) as CorpusRow);\n104: }\n105: \n106: function goldSkill(row: CorpusRow): string | null {\n107:   return row.skill_top_1 === 'none' ? null : row.skill_top_1;\n108: }\n109: \n110: function runPython(prompts: readonly string[]): PythonRow[] {\n111:   const script = `\n112: import importlib.util, json, os, sys\n113: workspace = sys.argv[1]\n114: path = os.path.join(workspace, '.skilled/skills/system-skill-advisor/runtime/scripts/skill_advisor.py')\n115: spec = importlib.util.spec_from_file_location('skill_advisor', path)\n116: mod = importlib.util.module_from_spec(spec)\n117: spec.loader.exec_module(mod)\n118: prompts = json.loads(sys.stdin.read())\n119: out = []\n120: for prompt in prompts:\n121:     recs = mod.analyze_prompt(prompt=prompt, confidence_threshold=0.8, uncertainty_threshold=0.35, confidence_only=False, show_rejections=False)\n122:     out.append({'prompt': prompt, 'top': recs[0]['skill'] if recs else None})\n123: print(json.dumps(out))\n124: `;\n125:   const result = spawnSync('python3', ['-c', script, WORKSPACE_ROOT], {\n126:     input: JSON.stringify(prompts),\n127:     encoding: 'utf8',\n128:     env: {\n129:       ...process.env,\n130:       SKILL_ADVISOR_DISABLE_BUILTIN_SEMANTIC: '1',\n131:     },\n132:     maxBuffer: 1024 * 1024 * 10,\n133:   });\n134:   if (result.status !== 0) {\n135:     throw new Error(`Python scorer failed: ${result.stderr || result.stdout}`);\n136:   }\n137:   return JSON.parse(result.stdout) as PythonRow[];\n138: }\n139: \n140: function stratifiedHoldout(rows: readonly CorpusRow[], target = 40): CorpusRow[] {\n141:   const groups = new Map<string, CorpusRow[]>();\n142:   for (const row of rows) {\n143:     const key = row.skill_top_1;\n144:     groups.set(key, [...(groups.get(key) ?? []), row]);\n145:   }\n146:   const selected: CorpusRow[] = [];\n147:   for (const group of [...groups.values()].sort((left, right) => left[0].skill_top_1.localeCompare(right[0].skill_top_1))) {\n148:     const take = Math.max(1, Math.round(group.length * 0.2));\n149:     selected.push(...group.filter((_, index) => index % 5 === 0).slice(0, take));\n150:   }\n151:   for (const row of rows) {\n152:     if (selected.length >= target) break;\n153:     if (!selected.includes(row)) selected.push(row);\n154:   }\n155:   return selected.slice(0, target);\n156: }\n157: \n158: // The derived lane discounts each skill by its age at scoring time, so the pinned\n159: // counts below move with the calendar when the scorer reads the real clock. Score\n160: // at the instant they were derived at, which keeps a later day from turning the\n161: // gate red with no routing change.\n162: const SCORING_INSTANT = '2026-10-03T00:00:00Z';\n163: \n164: describe('027/003 AC-1/AC-2 regression-protection parity and §11 gates', () => {\n165:   beforeAll(() => {\n166:     vi.useFakeTimers({ toFake: ['Date'] });\n167:     vi.setSystemTime(new Date(SCORING_INSTANT));\n168:   });\n169: \n170:   afterAll(() => {\n171:     vi.useRealTimers();\n172:     restorePrivateSkillRoots();\n173:   });\n174: \n175:   // drift: verified against shipped behavior during Unit H\n176:   it('preserves all Python-correct corpus decisions while improving accuracy', () => {\n177:     const rows = loadCorpus();\n178:     const python = runPython(rows.map((row) => row.prompt));\n179:     const ts = rows.map((row) => scoreAdvisorPrompt(row.prompt, { workspaceRoot: WORKSPACE_ROOT }));\n180: \n181:     let pythonCorrect = 0;\n182:     let tsAlsoCorrect = 0;\n183:     let regressions = 0;\n184:     let tsAbstainsOnPythonCorrect = 0;\n185:     let pythonIncorrect = 0;\n186:     let tsImproves = 0;\n187:     let tsCorrect = 0;\n188:     let tsUnknown = 0;\n189:     let goldNoneFalseFire = 0;\n190:     const regressionIds: string[] = [];\n191: \n192:     for (const [index, row] of rows.entries()) {\n193:       const gold = goldSkill(row);\n194:       const pythonTop = python[index].top;\n195:       const tsTop = ts[index].topSkill;\n196:       if (tsTop === gold) tsCorrect += 1;\n197:       if (tsTop === null) tsUnknown += 1;\n198:       if (gold === null && tsTop !== null) goldNoneFalseFire += 1;\n199: \n200:       if (pythonTop === gold) {\n201:         pythonCorrect += 1;\n202:         if (tsTop === gold) tsAlsoCorrect += 1;\n203:         else {\n204:           regressions += 1;\n205:           regressionIds.push(row.id);\n206:         }\n207:         if (gold !== null && tsTop === null) tsAbstainsOnPythonCorrect += 1;\n208:       } else {\n209:         pythonIncorrect += 1;\n210:         if (tsTop === gold) tsImproves += 1;\n211:       }\n212:     }\n213: \n214:     const holdout = stratifiedHoldout(rows);\n215:     const holdoutCorrect = holdout.filter((row) => (\n216:       scoreAdvisorPrompt(row.prompt, { workspaceRoot: WORKSPACE_ROOT }).topSkill === goldSkill(row)\n217:     )).length;\n218: \n219:     const report = {\n220:       pythonCorrect,\n221:       tsAlsoCorrect,\n222:       regressions,\n223:       tsAbstainsOnPythonCorrect,\n224:       pythonIncorrect,\n225:       tsImproves,\n226:       tsCorrect,\n227:       tsAccuracy: Number((tsCorrect / rows.length).toFixed(4)),\n228:       tsUnknown,\n229:       goldNoneFalseFire,\n230:       holdoutCorrect,\n231:       holdoutAccuracy: Number((holdoutCorrect / holdout.length).toFixed(4)),\n232:       regressionIds,\n233:     };\n234:     console.log(`advisor-parity-report ${JSON.stringify(report)}`);\n235: \n236:     // On the current 195-row corpus, in the pinned no-graph regime above, the\n237:     // Python reference makes 112 gold-correct top-1 calls; the native scorer\n238:     // preserves 107 of them and diverges only on the reviewed current-state rows\n239:     // enumerated above, while improving 52 rows the Python reference gets wrong.\n240:     //\n241:     // Both numbers measure the reference, not a target, so they move whenever the\n242:     // labeled corpus, the Python scoring tables, or any skill root's metadata\n243:     // does: the reference reads graph-metadata.json, SKILL.md and mode-registry\n244:     // files live. They no longer move with a local skill-graph rebuild, because\n245:     // the regime pinned at the top hides that database from both scorers. The\n246:     // earlier pin of 112 and 107 was captured with a live graph loaded and was\n247:     // unreachable from any committed state. Re-baseline only after checking the\n248:     // move is an improvement: pythonCorrect rising with tsAlsoCorrect rising and\n249:     // the regression list a subset of the one above is the shape of a good move.\n250:     // A pythonCorrect drop, or a new id in regressionIds, is a regression to fix.\n251:     // 106 -> 107 and 99 -> 100: the skill-graph status and indexer now share\n252:     // one sanitizer-versioned content-hash recipe, and the sk-code description\n253:     // names its languages (TypeScript, Python, shell, JSON) instead of relying\n254:     // on incidental tokens. The regression list above is unchanged.\n255:     // 107 -> 109 and 100 -> 101: the sk-prompt description no longer claims\n256:     // scoring or a single pass, which returns two prompts to their gold in the\n257:     // Python reference; the native scorer keeps one of them. The other is\n258:     // rr-iter3-093, recorded above.\n259:     // 101 -> 103: the native scorer reaches the sk-code gold on rr-iter3-093\n260:     // and rr-iter3-182 once sk-code carries the screen-review vocabulary.\n261:     // pythonCorrect held at 109 and no new id joined the regression list at that step.\n262:     // 109 -> 112 and 105 -> 107: the retired command bridges collapsed into one\n263:     // save id and one prompt-improve id, and a typed /speckit:plan or\n264:     // /speckit:resume now resolves to its own command id instead of an umbrella.\n265:     // Seventeen gold labels moved to the surviving names and the Python\n266:     // reference follows them, so it answers three more prompts correctly; the\n267:     // native scorer keeps two of the three. rr-iter3-105 is the one it loses.\n268:     expect(pythonCorrect).toBe(112);\n269:     // 103 -> 104: a negated write verb no longer awards the sk-doc write-surface\n270:     // boost, so rr-iter3-146 reaches its sk-code gold.\n271:     // 104 -> 105: the hyphenated deep-review and deep-research workflow names are\n272:     // system-deep-loop lexical hints, so rr-iter3-166 returns to its deep-loop gold.\n273:     expect(tsAlsoCorrect).toBe(107);\n274:     expect(regressions).toBe(ACCEPTED_PARITY_REGRESSION_IDS.length);\n275:     expect(regressionIds).toEqual(ACCEPTED_PARITY_REGRESSION_IDS);\n276:     expect(tsAbstainsOnPythonCorrect).toBe(0);\n277:     expect(tsCorrect).toBeGreaterThanOrEqual(95);\n278:     expect(tsUnknown).toBeLessThanOrEqual(13);\n279:     expect(goldNoneFalseFire).toBeLessThanOrEqual(10);\n280:     // 28 → 27 after the labeled corpus shrank 197 → 193 (4 mcp-figma\n281:     // rows removed). The stratified holdout's 40-row sample shifted strata; net accuracy\n282:     // dropped by 1 row. Threshold lowered to track the new baseline.\n283:     expect(holdoutCorrect).toBeGreaterThanOrEqual(17);\n284:   });\n285: \n286:   it('AC-4 ablation disabling lexical reduces corpus accuracy', () => {\n287:     const rows = loadCorpus();\n288:     const report = runLaneAblation({\n289:       workspaceRoot: WORKSPACE_ROOT,\n290:       cases: rows.map((row) => ({ prompt: row.prompt, expectedSkill: goldSkill(row) ?? 'UNKNOWN' }))\n291:         .filter((row) => row.expectedSkill !== 'UNKNOWN'),\n292:     });\n293:     const lexical = report.lanes.find((lane) => lane.disabledLane === 'lexical');\n294:     expect(lexical).toBeDefined();\n295:     expect((lexical?.accuracy ?? 1)).toBeLessThan(report.baseline.accuracy);\n296:   });\n297: });","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/tests/parity/python-ts-parity.vitest.ts, lines 1-297\n1: // ───────────────────────────────────────────────────────────────\n2: // MODULE: Python TS Parity Tests\n3: // ───────────────────────────────────────────────────────────────\n4: \n5: import { existsSync, mkdtempSync, readFileSync } from 'node:fs';\n6: import { tmpdir } from 'node:os';\n7: import { dirname, join, resolve } from 'node:path';\n8: import { fileURLToPath } from 'node:url';\n9: import { spawnSync } from 'node:child_process';\n10: \n11: import { afterAll, beforeAll, describe, expect, it, vi } from 'vitest';\n12: import { findAdvisorWorkspaceRoot } from '../../lib/utils/workspace-root.js';\n13: \n14: // Private `local-*` skills linked in through this variable live outside the\n15: // checkout, so a pinned count measured on a clean checkout must not see them.\n16: const PRIVATE_SKILL_ROOTS_ENV = 'SPECKIT_PRIVATE_SKILL_ROOTS';\n17: const PREVIOUS_PRIVATE_SKILL_ROOTS = process.env[PRIVATE_SKILL_ROOTS_ENV];\n18: \n19: function restorePrivateSkillRoots(): void {\n20:   if (PREVIOUS_PRIVATE_SKILL_ROOTS === undefined) delete process.env[PRIVATE_SKILL_ROOTS_ENV];\n21:   else process.env[PRIVATE_SKILL_ROOTS_ENV] = PREVIOUS_PRIVATE_SKILL_ROOTS;\n22: }\n23: \n24: // Pinned force-local regime, set before the scorer import because the scorer\n25: // reads the database directory at module load. This is the regime CI runs in:\n26: // no skill-graph.sqlite, built-in semantic off. Without it the in-process\n27: // scorer and the spawned Python reference both read whatever locally built\n28: // graph exists, and the pinned counts below move with a daemon rebuild instead\n29: // of with a diff.\n30: process.env.SYSTEM_SKILL_ADVISOR_DB_DIR = mkdtempSync(join(tmpdir(), 'python-ts-parity-'));\n31: process.env.SKILL_ADVISOR_DISABLE_BUILTIN_SEMANTIC = '1';\n32: process.env.SPECKIT_SKILL_ADVISOR_FORCE_LOCAL = '1';\n33: delete process.env[PRIVATE_SKILL_ROOTS_ENV];\n34: \n35: const { runLaneAblation } = await import('../../lib/scorer/ablation.js');\n36: const { scoreAdvisorPrompt } = await import('../../lib/scorer/fusion.js');\n37: \n38: interface CorpusRow {\n39:   readonly id: string;\n40:   readonly prompt: string;\n41:   readonly skill_top_1: string;\n42: }\n43: \n44: interface PythonRow {\n45:   readonly prompt: string;\n46:   readonly top: string | null;\n47: }\n48: \n49: // Reviewed-accepted top-1 divergences (Python-correct, native scorer diverges),\n50: // aligned with the legacy corpus-parity ledger. What remains is cross-lane /\n51: // labeling-edge loss that explicit-lane calibration cannot resolve. Entries are\n52: // pruned as targeted work resolves them, which is the only reason this list ever\n53: // shrinks — rr-iter3-093 and rr-iter3-145 each left it that way.\n54: //\n55: // rr-iter2-020 is sk-code gold that the native scorer loses to sk-doc by under\n56: // 0.04 in the pinned regime. It is vocabulary bleed between the two hubs and\n57: // stays here until that is resolved, not hidden by a local graph.\n58: const ACCEPTED_PARITY_REGRESSION_IDS: string[] = [\n59:   // rr-hub6-204 and rr-hub6-207 left this list: the corpus growth (orchestration/jev\n60:   // skills) let the TS scorer recover both prompts to the Python-correct\n61:   // answer, so they no longer diverge. Conscious removal, reviewed against\n62:   // gold.\n63:   //\n64:   // rr-iter3-093 and rr-iter3-182 left this list when sk-code absorbed the\n65:   // retired sk-design-fundamentals mode and its screen-review vocabulary: the\n66:   // pinned native scorer now reaches the sk-code gold on both prompts.\n67:   //\n68:   // rr-iter3-146 left this list when the explicit lane stopped reading a negated\n69:   // write (\"don't write anything back\") as a request to write docs.\n70:   //\n71:   // rr-iter3-166 left this list when the hyphenated deep-review and deep-research\n72:   // workflow names became system-deep-loop lexical hints, the form the prompt uses.\n73:   'rr-iter2-020',\n74:   'rr-iter3-092',\n75:   'rr-iter3-097',\n76:   'rr-iter3-099',\n77:   // rr-iter3-105 typed \"/memory:save\" outright and carries the save gold. The\n78:   // Python reference answers it; the native scorer spends slightly more weight\n79:   // on the packet vocabulary and hands the row to system-spec-kit (0.625)\n80:   // ahead of the save command (0.56). Recorded as a divergence, not accepted as\n81:   // correct: a named command must outrank the hub that owns its topic.\n82:   'rr-iter3-105',\n83: ];\n84: \n85: function findWorkspaceRoot(): string {\n86:   const start = dirname(fileURLToPath(import.meta.url));\n87:   const sentinel = '.skilled/skills/system-spec-kit/SKILL.md';\n88:   const candidate = findAdvisorWorkspaceRoot(start, { maxDepth: 12, sentinel });\n89:   if (!existsSync(resolve(candidate, sentinel))) {\n90:     throw new Error('Unable to locate workspace root.');\n91:   }\n92:   return candidate;\n93: }\n94: \n95: const WORKSPACE_ROOT = findWorkspaceRoot();\n96: const SPECKIT_BENCH_CORPUS_PATH = '.skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/labeled-prompts.jsonl';\n97: const CORPUS_PATH = resolve(WORKSPACE_ROOT, SPECKIT_BENCH_CORPUS_PATH);\n98: \n99: function loadCorpus(): CorpusRow[] {\n100:   return readFileSync(CORPUS_PATH, 'utf8')\n101:     .trim()\n102:     .split('\\n')\n103:     .map((line) => JSON.parse(line) as CorpusRow);\n104: }\n105: \n106: function goldSkill(row: CorpusRow): string | null {\n107:   return row.skill_top_1 === 'none' ? null : row.skill_top_1;\n108: }\n109: \n110: function runPython(prompts: readonly string[]): PythonRow[] {\n111:   const script = `\n112: import importlib.util, json, os, sys\n113: workspace = sys.argv[1]\n114: path = os.path.join(workspace, '.skilled/skills/system-skill-advisor/runtime/scripts/skill_advisor.py')\n115: spec = importlib.util.spec_from_file_location('skill_advisor', path)\n116: mod = importlib.util.module_from_spec(spec)\n117: spec.loader.exec_module(mod)\n118: prompts = json.loads(sys.stdin.read())\n119: out = []\n120: for prompt in prompts:\n121:     recs = mod.analyze_prompt(prompt=prompt, confidence_threshold=0.8, uncertainty_threshold=0.35, confidence_only=False, show_rejections=False)\n122:     out.append({'prompt': prompt, 'top': recs[0]['skill'] if recs else None})\n123: print(json.dumps(out))\n124: `;\n125:   const result = spawnSync('python3', ['-c', script, WORKSPACE_ROOT], {\n126:     input: JSON.stringify(prompts),\n127:     encoding: 'utf8',\n128:     env: {\n129:       ...process.env,\n130:       SKILL_ADVISOR_DISABLE_BUILTIN_SEMANTIC: '1',\n131:     },\n132:     maxBuffer: 1024 * 1024 * 10,\n133:   });\n134:   if (result.status !== 0) {\n135:     throw new Error(`Python scorer failed: ${result.stderr || result.stdout}`);\n136:   }\n137:   return JSON.parse(result.stdout) as PythonRow[];\n138: }\n139: \n140: function stratifiedHoldout(rows: readonly CorpusRow[], target = 40): CorpusRow[] {\n141:   const groups = new Map<string, CorpusRow[]>();\n142:   for (const row of rows) {\n143:     const key = row.skill_top_1;\n144:     groups.set(key, [...(groups.get(key) ?? []), row]);\n145:   }\n146:   const selected: CorpusRow[] = [];\n147:   for (const group of [...groups.values()].sort((left, right) => left[0].skill_top_1.localeCompare(right[0].skill_top_1))) {\n148:     const take = Math.max(1, Math.round(group.length * 0.2));\n149:     selected.push(...group.filter((_, index) => index % 5 === 0).slice(0, take));\n150:   }\n151:   for (const row of rows) {\n152:     if (selected.length >= target) break;\n153:     if (!selected.includes(row)) selected.push(row);\n154:   }\n155:   return selected.slice(0, target);\n156: }\n157: \n158: // The derived lane discounts each skill by its age at scoring time, so the pinned\n159: // counts below move with the calendar when the scorer reads the real clock. Score\n160: // at the instant they were derived at, which keeps a later day from turning the\n161: // gate red with no routing change.\n162: const SCORING_INSTANT = '2026-10-03T00:00:00Z';\n163: \n164: describe('027/003 AC-1/AC-2 regression-protection parity and §11 gates', () => {\n165:   beforeAll(() => {\n166:     vi.useFakeTimers({ toFake: ['Date'] });\n167:     vi.setSystemTime(new Date(SCORING_INSTANT));\n168:   });\n169: \n170:   afterAll(() => {\n171:     vi.useRealTimers();\n172:     restorePrivateSkillRoots();\n173:   });\n174: \n175:   // drift: verified against shipped behavior during Unit H\n176:   it('preserves all Python-correct corpus decisions while improving accuracy', () => {\n177:     const rows = loadCorpus();\n178:     const python = runPython(rows.map((row) => row.prompt));\n179:     const ts = rows.map((row) => scoreAdvisorPrompt(row.prompt, { workspaceRoot: WORKSPACE_ROOT }));\n180: \n181:     let pythonCorrect = 0;\n182:     let tsAlsoCorrect = 0;\n183:     let regressions = 0;\n184:     let tsAbstainsOnPythonCorrect = 0;\n185:     let pythonIncorrect = 0;\n186:     let tsImproves = 0;\n187:     let tsCorrect = 0;\n188:     let tsUnknown = 0;\n189:     let goldNoneFalseFire = 0;\n190:     const regressionIds: string[] = [];\n191: \n192:     for (const [index, row] of rows.entries()) {\n193:       const gold = goldSkill(row);\n194:       const pythonTop = python[index].top;\n195:       const tsTop = ts[index].topSkill;\n196:       if (tsTop === gold) tsCorrect += 1;\n197:       if (tsTop === null) tsUnknown += 1;\n198:       if (gold === null && tsTop !== null) goldNoneFalseFire += 1;\n199: \n200:       if (pythonTop === gold) {\n201:         pythonCorrect += 1;\n202:         if (tsTop === gold) tsAlsoCorrect += 1;\n203:         else {\n204:           regressions += 1;\n205:           regressionIds.push(row.id);\n206:         }\n207:         if (gold !== null && tsTop === null) tsAbstainsOnPythonCorrect += 1;\n208:       } else {\n209:         pythonIncorrect += 1;\n210:         if (tsTop === gold) tsImproves += 1;\n211:       }\n212:     }\n213: \n214:     const holdout = stratifiedHoldout(rows);\n215:     const holdoutCorrect = holdout.filter((row) => (\n216:       scoreAdvisorPrompt(row.prompt, { workspaceRoot: WORKSPACE_ROOT }).topSkill === goldSkill(row)\n217:     )).length;\n218: \n219:     const report = {\n220:       pythonCorrect,\n221:       tsAlsoCorrect,\n222:       regressions,\n223:       tsAbstainsOnPythonCorrect,\n224:       pythonIncorrect,\n225:       tsImproves,\n226:       tsCorrect,\n227:       tsAccuracy: Number((tsCorrect / rows.length).toFixed(4)),\n228:       tsUnknown,\n229:       goldNoneFalseFire,\n230:       holdoutCorrect,\n231:       holdoutAccuracy: Number((holdoutCorrect / holdout.length).toFixed(4)),\n232:       regressionIds,\n233:     };\n234:     console.log(`advisor-parity-report ${JSON.stringify(report)}`);\n235: \n236:     // On the current 195-row corpus, in the pinned no-graph regime above, the\n237:     // Python reference makes 112 gold-correct top-1 calls; the native scorer\n238:     // preserves 107 of them and diverges only on the reviewed current-state rows\n239:     // enumerated above, while improving 52 rows the Python reference gets wrong.\n240:     //\n241:     // Both numbers measure the reference, not a target, so they move whenever the\n242:     // labeled corpus, the Python scoring tables, or any skill root's metadata\n243:     // does: the reference reads graph-metadata.json, SKILL.md and mode-registry\n244:     // files live. They no longer move with a local skill-graph rebuild, because\n245:     // the regime pinned at the top hides that database from both scorers. The\n246:     // earlier pin of 112 and 107 was captured with a live graph loaded and was\n247:     // unreachable from any committed state. Re-baseline only after checking the\n248:     // move is an improvement: pythonCorrect rising with tsAlsoCorrect rising and\n249:     // the regression list a subset of the one above is the shape of a good move.\n250:     // A pythonCorrect drop, or a new id in regressionIds, is a regression to fix.\n251:     // 106 -> 107 and 99 -> 100: the skill-graph status and indexer now share\n252:     // one sanitizer-versioned content-hash recipe, and the sk-code description\n253:     // names its languages (TypeScript, Python, shell, JSON) instead of relying\n254:     // on incidental tokens. The regression list above is unchanged.\n255:     // 107 -> 109 and 100 -> 101: the sk-prompt description no longer claims\n256:     // scoring or a single pass, which returns two prompts to their gold in the\n257:     // Python reference; the native scorer keeps one of them. The other is\n258:     // rr-iter3-093, recorded above.\n259:     // 101 -> 103: the native scorer reaches the sk-code gold on rr-iter3-093\n260:     // and rr-iter3-182 once sk-code carries the screen-review vocabulary.\n261:     // pythonCorrect held at 109 and no new id joined the regression list at that step.\n262:     // 109 -> 112 and 105 -> 107: the retired command bridges collapsed into one\n263:     // save id and one prompt-improve id, and a typed /speckit:plan or\n264:     // /speckit:resume now resolves to its own command id instead of an umbrella.\n265:     // Seventeen gold labels moved to the surviving names and the Python\n266:     // reference follows them, so it answers three more prompts correctly; the\n267:     // native scorer keeps two of the three. rr-iter3-105 is the one it loses.\n268:     expect(pythonCorrect).toBe(112);\n269:     // 103 -> 104: a negated write verb no longer awards the sk-doc write-surface\n270:     // boost, so rr-iter3-146 reaches its sk-code gold.\n271:     // 104 -> 105: the hyphenated deep-review and deep-research workflow names are\n272:     // system-deep-loop lexical hints, so rr-iter3-166 returns to its deep-loop gold.\n273:     expect(tsAlsoCorrect).toBe(107);\n274:     expect(regressions).toBe(ACCEPTED_PARITY_REGRESSION_IDS.length);\n275:     expect(regressionIds).toEqual(ACCEPTED_PARITY_REGRESSION_IDS);\n276:     expect(tsAbstainsOnPythonCorrect).toBe(0);\n277:     expect(tsCorrect).toBeGreaterThanOrEqual(95);\n278:     expect(tsUnknown).toBeLessThanOrEqual(13);\n279:     expect(goldNoneFalseFire).toBeLessThanOrEqual(10);\n280:     // 28 → 27 after the labeled corpus shrank 197 → 193 (4 mcp-figma\n281:     // rows removed). The stratified holdout's 40-row sample shifted strata; net accuracy\n282:     // dropped by 1 row. Threshold lowered to track the new baseline.\n283:     expect(holdoutCorrect).toBeGreaterThanOrEqual(17);\n284:   });\n285: \n286:   it('AC-4 ablation disabling lexical reduces corpus accuracy', () => {\n287:     const rows = loadCorpus();\n288:     const report = runLaneAblation({\n289:       workspaceRoot: WORKSPACE_ROOT,\n290:       cases: rows.map((row) => ({ prompt: row.prompt, expectedSkill: goldSkill(row) ?? 'UNKNOWN' }))\n291:         .filter((row) => row.expectedSkill !== 'UNKNOWN'),\n292:     });\n293:     const lexical = report.lanes.find((lane) => lane.disabledLane === 'lexical');\n294:     expect(lexical).toBeDefined();\n295:     expect((lexical?.accuracy ?? 1)).toBeLessThan(report.baseline.accuracy);\n296:   });\n297: });"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/tests/parity/python-ts-parity.vitest.ts\"}"},"time":{"start":1794531173148,"end":1794531173681}}}}
