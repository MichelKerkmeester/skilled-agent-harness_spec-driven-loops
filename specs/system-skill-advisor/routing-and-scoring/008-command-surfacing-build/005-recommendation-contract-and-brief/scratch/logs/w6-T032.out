\n        \"skill_id\": \"sk-design\",\n        \"owner_mode\": \"sk-design-md-generator\",\n        \"routing_enabled\": False,\n    },\n}\n\nGENERATED_COMMAND_BRIDGE_OWNER_NORMALIZATION = {\n    \"command-create-agent\": \"create:agent\",\n    \"command-create-manual-testing-playbook\": \"create:manual-testing-playbook\",\n    \"command-spec-kit-resume\": \"system-spec-kit\",\n    \"command-spec-kit-deep-research\": \"deep-research\",\n    \"command-spec-kit-deep-review\": \"deep-review\",\n}\n# END GENERATED COMMAND BRIDGES\n\nCOMMAND_BRIDGES = GENERATED_COMMAND_BRIDGES\nCOMMAND_BRIDGE_OWNER_NORMALIZATION = GENERATED_COMMAND_BRIDGE_OWNER_NORMALIZATION\n\nCOMMAND_TARGET_IMPLEMENTATION_MARKERS = (\n    \"add\",\n    \"bridge\",\n    \"carve-out\",\n    \"carve out\",\n    \"command bridge\",\n    \"command target\",\n    \"command-only\",\n    \"command-surface\",\n    \"command surface\",\n    \"guard\",\n    \"implement\",\n    \"implementation\",\n    \"mapping\",\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"sed -n '2870,2905p' .skilled/skills/system-skill-advisor/runtime/scripts/skill_advisor.py\",\"workdir\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research\"}"},"time":{"start":1794528146579,"end":1794528147188}}}}
{"type":"tool_use","timestamp":1794528147202,"sessionID":"ses_e2dcb0a25ffeKDrFVYdzDGhvxv","part":{"partID":"prt_1d2367499001HBYklqCrMY6b3k","sessionID":"ses_e2dcb0a25ffeKDrFVYdzDGhvxv","messageID":"msg_1d236654a001qXg5goWc7mYcAw","type":"tool","id":"call_aea080438d9f437681f3d712","tool":"shell","state":{"status":"completed","input":{"command":"sed -n '480,545p' .skilled/skills/system-skill-advisor/runtime/scripts/skill_advisor.py","workdir":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research"},"output":"    if check_only:\n        print(json.dumps({\n            \"status\": \"stale\" if changed else \"fresh\",\n            \"projectionHash\": projection_hash,\n            \"changed\": changed,\n        }, indent=2))\n        return 1 if changed else 0\n\n    if next_aliases != aliases_content:\n        with open(ALIASES_TS_PATH, \"w\", encoding=\"utf-8\") as aliases_file:\n            aliases_file.write(next_aliases)\n    if next_script != script_content:\n        with open(__file__, \"w\", encoding=\"utf-8\") as script_file:\n            script_file.write(next_script)\n\n    print(json.dumps({\n        \"status\": \"emitted\",\n        \"projectionHash\": projection_hash,\n        \"changed\": changed,\n    }, indent=2))\n    return 0\n\n\n# Every /speckit command is scored under its own bridge id, so the family is\n# matched by prefix; the umbrella id that used to name the whole family is gone.\nSPECKIT_COMMAND_BRIDGE_PREFIXES = (\"command-spec-kit-\", \"command-speckit-\")\n\n\ndef _command_bridge_owner(command_name: str, command: str) -> Dict[str, str]:\n    \"\"\"Normalize a live Python bridge owner to the generated projection shape.\"\"\"\n    command_config = COMMAND_BRIDGES.get(command_name, {})\n    owner = COMMAND_BRIDGE_OWNER_NORMALIZATION.get(command_name) or command_config.get(\"owning_skill\")\n    if owner == \"system-spec-kit\":\n        return {\"skillId\": \"system-spec-kit\", \"ownerMode\": \"system-spec-kit\"}\n    if isinstance(owner, str) and owner.startswith(\"deep-\"):\n        return {\"skillId\": \"system-deep-loop\", \"ownerMode\": owner.removeprefix(\"deep-\")}\n    if isinstance(owner, str) and owner.startswith(\"create:\"):\n        return {\"skillId\": \"sk-doc\", \"ownerMode\": f\"sk-create-{owner.split(':', 1)[1]}\"}\n    if command.startswith(\"/deep:\"):\n        mode = command.split(\":\", 1)[1]\n        return {\"skillId\": \"system-deep-loop\", \"ownerMode\": mode}\n    if command_name.startswith(SPECKIT_COMMAND_BRIDGE_PREFIXES) or command == \"/memory:save\":\n        return {\"skillId\": \"system-spec-kit\", \"ownerMode\": \"system-spec-kit\"}\n    if command.startswith(\"/create:\"):\n        return {\"skillId\": \"sk-doc\", \"ownerMode\": f\"sk-create-{command.split(':', 1)[1]}\"}\n    if command == \"/prompt\":\n        return {\"skillId\": \"sk-prompt\", \"ownerMode\": \"sk-prompt\"}\n    return {\n        \"skillId\": str(owner or \"\"),\n        \"ownerMode\": \"\",\n    }\n\n\ndef _normalized_live_command_bridges() -> List[Dict[str, str]]:\n    \"\"\"Return the selected Python command bridges in inventory projection form.\"\"\"\n    entries: List[Dict[str, str]] = []\n    for command_name, command_config in COMMAND_BRIDGES.items():\n        configured_command = command_config.get(\"command\")\n        command = configured_command if isinstance(configured_command, str) else next(\n            (\n                marker\n                for marker in command_config.get(\"slash_markers\", [])\n                if isinstance(marker, str) and marker.startswith(\"/\")\n            ),\n            \"\",\n        )\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"    if check_only:\n        print(json.dumps({\n            \"status\": \"stale\" if changed else \"fresh\",\n            \"projectionHash\": projection_hash,\n            \"changed\": changed,\n        }, indent=2))\n        return 1 if changed else 0\n\n    if next_aliases != aliases_content:\n        with open(ALIASES_TS_PATH, \"w\", encoding=\"utf-8\") as aliases_file:\n            aliases_file.write(next_aliases)\n    if next_script != script_content:\n        with open(__file__, \"w\", encoding=\"utf-8\") as script_file:\n            script_file.write(next_script)\n\n    print(json.dumps({\n        \"status\": \"emitted\",\n        \"projectionHash\": projection_hash,\n        \"changed\": changed,\n    }, indent=2))\n    return 0\n\n\n# Every /speckit command is scored under its own bridge id, so the family is\n# matched by prefix; the umbrella id that used to name the whole family is gone.\nSPECKIT_COMMAND_BRIDGE_PREFIXES = (\"command-spec-kit-\", \"command-speckit-\")\n\n\ndef _command_bridge_owner(command_name: str, command: str) -> Dict[str, str]:\n    \"\"\"Normalize a live Python bridge owner to the generated projection shape.\"\"\"\n    command_config = COMMAND_BRIDGES.get(command_name, {})\n    owner = COMMAND_BRIDGE_OWNER_NORMALIZATION.get(command_name) or command_config.get(\"owning_skill\")\n    if owner == \"system-spec-kit\":\n        return {\"skillId\": \"system-spec-kit\", \"ownerMode\": \"system-spec-kit\"}\n    if isinstance(owner, str) and owner.startswith(\"deep-\"):\n        return {\"skillId\": \"system-deep-loop\", \"ownerMode\": owner.removeprefix(\"deep-\")}\n    if isinstance(owner, str) and owner.startswith(\"create:\"):\n        return {\"skillId\": \"sk-doc\", \"ownerMode\": f\"sk-create-{owner.split(':', 1)[1]}\"}\n    if command.startswith(\"/deep:\"):\n        mode = command.split(\":\", 1)[1]\n        return {\"skillId\": \"system-deep-loop\", \"ownerMode\": mode}\n    if command_name.startswith(SPECKIT_COMMAND_BRIDGE_PREFIXES) or command == \"/memory:save\":\n        return {\"skillId\": \"system-spec-kit\", \"ownerMode\": \"system-spec-kit\"}\n    if command.startswith(\"/create:\"):\n        return {\"skillId\": \"sk-doc\", \"ownerMode\": f\"sk-create-{command.split(':', 1)[1]}\"}\n    if command == \"/prompt\":\n        return {\"skillId\": \"sk-prompt\", \"ownerMode\": \"sk-prompt\"}\n    return {\n        \"skillId\": str(owner or \"\"),\n        \"ownerMode\": \"\",\n    }\n\n\ndef _normalized_live_command_bridges() -> List[Dict[str, str]]:\n    \"\"\"Return the selected Python command bridges in inventory projection form.\"\"\"\n    entries: List[Dict[str, str]] = []\n    for command_name, command_config in COMMAND_BRIDGES.items():\n        configured_command = command_config.get(\"command\")\n        command = configured_command if isinstance(configured_command, str) else next(\n            (\n                marker\n                for marker in command_config.get(\"slash_markers\", [])\n                if isinstance(marker, str) and marker.startswith(\"/\")\n            ),\n            \"\",\n        )\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"sed -n '480,545p' .skilled/skills/system-skill-advisor/runtime/scripts/skill_advisor.py\",\"workdir\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research\"}"},"time":{"start":1794528146585,"end":1794528147202}}}}
