.toBeGreaterThanOrEqual(6);\n61:   });\n62: \n63:   it('returns null for a prompt the helper does not match', () => {\n64:     expect(matchDoctorProblem('write me a poem about cats', WORKSPACE)).toBeNull();\n65:   });\n66: \n67:   it('returns null when the workspace has no doctor helper', () => {\n68:     expect(matchDoctorProblem('my deep research run never converges', mkdtempSync(join(tmpdir(), 'no-doctor-')))).toBeNull();\n69:   });\n70: });"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/tests/doctor-helper-handoff.vitest.ts\"}"},"time":{"start":1794543181075,"end":1794543181518}}}}
