{"type":"tool_use","timestamp":1794543178173,"sessionID":"ses_e2ce4c822ffeajVHIjUYYvzhCo","part":{"partID":"prt_1d31bd0250022eqGfTVmLJezrB","sessionID":"ses_e2ce4c822ffeajVHIjUYYvzhCo","messageID":"msg_1d31bb954001b25Qn6xxFFDSSm","type":"tool","id":"call_7333e58ecb994ebeade18813","tool":"read","state":{"status":"completed","input":{"path":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/lib/scorer/doctor-helper-handoff.ts"},"output":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/lib/scorer/doctor-helper-handoff.ts, lines 1-153\n1: // ───────────────────────────────────────────────────────────────\n2: // MODULE: Doctor Helper Hand-off\n3: // ───────────────────────────────────────────────────────────────\n4: \n5: // A doctor bridge passes only on its own declared wording, so a doctor problem\n6: // described in other words reaches no doctor command at all. /doctor:helper\n7: // already ranks free-text problems against every doctor route by word overlap.\n8: // When no doctor bridge passes, this module asks that same ranker whether the\n9: // prompt describes a doctor problem, and if it does the advisor offers\n10: // /doctor:helper, which then names the command.\n11: //\n12: // Two durable design choices:\n13: //   1. The ranker is the helper's own script, loaded from the workspace at run\n14: //      time, so the advisor and /doctor:helper can never disagree about what\n15: //      counts as a doctor problem. Any failure to load or rank is a no-match.\n16: //   2. Word overlap alone also fires on ordinary requests that share doctor\n17: //      vocabulary (\"start a deep review loop\"), so a weak match also needs the\n18: //      prompt to name a problem. Beside a passing skill only a strong cue\n19: //      counts, because bare words such as \"missing\" or \"broken\" are common in\n20: //      ordinary work. With no skill passing, a strong ranker match stands in\n21: //      for the cue.\n22: \n23: // ───────────────────────────────────────────────────────────────────\n24: // 1. IMPORTS\n25: // ───────────────────────────────────────────────────────────────────\n26: \n27: import { existsSync, statSync } from 'node:fs';\n28: import { createRequire } from 'node:module';\n29: import { join } from 'node:path';\n30: \n31: // ───────────────────────────────────────────────────────────────────\n32: // 2. CONSTANTS\n33: // ───────────────────────────────────────────────────────────────────\n34: \n35: const HELPER_SCRIPT = join('.skilled', 'commands', 'doctor', 'scripts', 'doctor-helper-match.cjs');\n36: const ROUTE_MANIFEST = join('.skilled', 'commands', 'doctor', '_routes.yaml');\n37: \n38: /** The bridge id the hand-off surfaces. */\n39: export const DOCTOR_HELPER_BRIDGE_ID = 'command-doctor-helper';\n40: \n41: /** Lowest helper rank score that counts as a doctor problem. */\n42: export const DOCTOR_HELPER_MIN_SCORE = 6;\n43: \n44: /** Helper rank score that stands in for a cue when no skill passes. */\n45: export const DOCTOR_HELPER_UNCUED_MIN_SCORE = 10;\n46: \n47: // A strong cue says a state is wrong or asks for a health or switch change, so\n48: // it can surface the helper beside a passing skill. A weak cue is a bare word\n49: // that ordinary work requests also use (\"fix the broken example\"), so it counts\n50: // only when no skill passes. Every hand-off needs at least one cue.\n51: const STRONG_PROBLEM_CUE = new RegExp([\n52:   \"\\\\b(?:not|isn'?t|aren'?t|doesn'?t|don'?t|won'?t|can'?t) (?:\\\\w+ )?(?:work|working|registered|found|load|loading|run|running|active|linked|fir(?:e|es|ing)|trigger(?:s|ing)?|converg\\\\w*)\\\\b\",\n53:   '\\\\bnever (?:converg\\\\w*|finish\\\\w*|stops?|works?|loads?|runs?)\\\\b',\n54:   '\\\\breturns? nothing\\\\b',\n55:   '\\\\b(?:healthy|health|diagnos\\\\w*)\\\\b',\n56:   '\\\\bturn(?:ed)? (?:on|off)\\\\b',\n57:   '\\\\bswitch(?:ed)? (?:on|off)\\\\b',\n58: ].join('|'), 'i');\n59: \n60: const WEAK_PROBLEM_CUE = new RegExp([\n61:   '\\\\b(?:broken|breaks?|failing|fails?|failed|wrong|stale|missing|stuck|errors?|drift(?:ed|s|ing)?)\\\\b',\n62:   '\\\\bout of (?:date|sync)\\\\b',\n63: ].join('|'), 'i');\n64: \n65: // ───────────────────────────────────────────────────────────────────\n66: // 3. TYPES\n67: // ───────────────────────────────────────────────────────────────────\n68: \n69: interface HelperCandidate {\n70:   readonly command: string;\n71:   readonly score: number;\n72: }\n73: \n74: interface HelperModule {\n75:   readonly loadEntries: (root: string) => { readonly entries: readonly unknown[] };\n76:   readonly rankProblem: (\n77:     entries: readonly unknown[],\n78:     text: string,\n79:     options: { readonly top: number },\n80:   ) => { readonly candidates?: readonly HelperCandidate[] };\n81: }\n82: \n83: interface LoadedHelper {\n84:   readonly manifestMtimeMs: number;\n85:   readonly module: HelperModule;\n86:   readonly entries: readonly unknown[];\n87: }\n88: \n89: /** The doctor command the helper ranked first, with its rank score. */\n90: export interface DoctorProblemMatch {\n91:   readonly command: string;\n92:   readonly score: number;\n93: }\n94: \n95: // ───────────────────────────────────────────────────────────────────\n96: // 4. HELPERS\n97: // ───────────────────────────────────────────────────────────────────\n98: \n99: const loadedByRoot = new Map<string, LoadedHelper | null>();\n100: \n101: function loadHelper(workspaceRoot: string): LoadedHelper | null {\n102:   const scriptPath = join(workspaceRoot, HELPER_SCRIPT);\n103:   const manifestPath = join(workspaceRoot, ROUTE_MANIFEST);\n104:   if (!existsSync(scriptPath) || !existsSync(manifestPath)) return null;\n105:   let manifestMtimeMs: number;\n106:   try {\n107:     manifestMtimeMs = statSync(manifestPath).mtimeMs;\n108:   } catch {\n109:     return null;\n110:   }\n111:   const cached = loadedByRoot.get(workspaceRoot);\n112:   if (cached && cached.manifestMtimeMs === manifestMtimeMs) return cached;\n113:   try {\n114:     const helper = createRequire(import.meta.url)(scriptPath) as HelperModule;\n115:     const loaded: LoadedHelper = {\n116:       manifestMtimeMs,\n117:       module: helper,\n118:       entries: helper.loadEntries(workspaceRoot).entries,\n119:     };\n120:     loadedByRoot.set(workspaceRoot, loaded);\n121:     return loaded;\n122:   } catch {\n123:     loadedByRoot.set(workspaceRoot, null);\n124:     return null;\n125:   }\n126: }\n127: \n128: // ───────────────────────────────────────────────────────────────────\n129: // 5. CORE LOGIC\n130: // ───────────────────────────────────────────────────────────────────\n131: \n132: /** The strongest problem cue the prompt carries. */\n133: export function doctorProblemCue(prompt: string): 'strong' | 'weak' | null {\n134:   if (STRONG_PROBLEM_CUE.test(prompt)) return 'strong';\n135:   if (WEAK_PROBLEM_CUE.test(prompt)) return 'weak';\n136:   return null;\n137: }\n138: \n139: /**\n140:  * Ranks the prompt with /doctor:helper's own matcher and returns its first\n141:  * candidate when that candidate reaches the hand-off score, or null.\n142:  */\n143: export function matchDoctorProblem(prompt: string, workspaceRoot: string): DoctorProblemMatch | null {\n144:   const loaded = loadHelper(workspaceRoot);\n145:   if (!loaded) return null;\n146:   try {\n147:     const first = loaded.module.rankProblem(loaded.entries, prompt, { top: 1 }).candidates?.[0];\n148:     if (!first || typeof first.command !== 'string' || typeof first.score !== 'number') return null;\n149:     return first.score >= DOCTOR_HELPER_MIN_SCORE ? { command: first.command, score: first.score } : null;\n150:   } catch {\n151:     return null;\n152:   }\n153: }","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/lib/scorer/doctor-helper-handoff.ts, lines 1-153\n1: // ───────────────────────────────────────────────────────────────\n2: // MODULE: Doctor Helper Hand-off\n3: // ───────────────────────────────────────────────────────────────\n4: \n5: // A doctor bridge passes only on its own declared wording, so a doctor problem\n6: // described in other words reaches no doctor command at all. /doctor:helper\n7: // already ranks free-text problems against every doctor route by word overlap.\n8: // When no doctor bridge passes, this module asks that same ranker whether the\n9: // prompt describes a doctor problem, and if it does the advisor offers\n10: // /doctor:helper, which then names the command.\n11: //\n12: // Two durable design choices:\n13: //   1. The ranker is the helper's own script, loaded from the workspace at run\n14: //      time, so the advisor and /doctor:helper can never disagree about what\n15: //      counts as a doctor problem. Any failure to load or rank is a no-match.\n16: //   2. Word overlap alone also fires on ordinary requests that share doctor\n17: //      vocabulary (\"start a deep review loop\"), so a weak match also needs the\n18: //      prompt to name a problem. Beside a passing skill only a strong cue\n19: //      counts, because bare words such as \"missing\" or \"broken\" are common in\n20: //      ordinary work. With no skill passing, a strong ranker match stands in\n21: //      for the cue.\n22: \n23: // ───────────────────────────────────────────────────────────────────\n24: // 1. IMPORTS\n25: // ───────────────────────────────────────────────────────────────────\n26: \n27: import { existsSync, statSync } from 'node:fs';\n28: import { createRequire } from 'node:module';\n29: import { join } from 'node:path';\n30: \n31: // ───────────────────────────────────────────────────────────────────\n32: // 2. CONSTANTS\n33: // ───────────────────────────────────────────────────────────────────\n34: \n35: const HELPER_SCRIPT = join('.skilled', 'commands', 'doctor', 'scripts', 'doctor-helper-match.cjs');\n36: const ROUTE_MANIFEST = join('.skilled', 'commands', 'doctor', '_routes.yaml');\n37: \n38: /** The bridge id the hand-off surfaces. */\n39: export const DOCTOR_HELPER_BRIDGE_ID = 'command-doctor-helper';\n40: \n41: /** Lowest helper rank score that counts as a doctor problem. */\n42: export const DOCTOR_HELPER_MIN_SCORE = 6;\n43: \n44: /** Helper rank score that stands in for a cue when no skill passes. */\n45: export const DOCTOR_HELPER_UNCUED_MIN_SCORE = 10;\n46: \n47: // A strong cue says a state is wrong or asks for a health or switch change, so\n48: // it can surface the helper beside a passing skill. A weak cue is a bare word\n49: // that ordinary work requests also use (\"fix the broken example\"), so it counts\n50: // only when no skill passes. Every hand-off needs at least one cue.\n51: const STRONG_PROBLEM_CUE = new RegExp([\n52:   \"\\\\b(?:not|isn'?t|aren'?t|doesn'?t|don'?t|won'?t|can'?t) (?:\\\\w+ )?(?:work|working|registered|found|load|loading|run|running|active|linked|fir(?:e|es|ing)|trigger(?:s|ing)?|converg\\\\w*)\\\\b\",\n53:   '\\\\bnever (?:converg\\\\w*|finish\\\\w*|stops?|works?|loads?|runs?)\\\\b',\n54:   '\\\\breturns? nothing\\\\b',\n55:   '\\\\b(?:healthy|health|diagnos\\\\w*)\\\\b',\n56:   '\\\\bturn(?:ed)? (?:on|off)\\\\b',\n57:   '\\\\bswitch(?:ed)? (?:on|off)\\\\b',\n58: ].join('|'), 'i');\n59: \n60: const WEAK_PROBLEM_CUE = new RegExp([\n61:   '\\\\b(?:broken|breaks?|failing|fails?|failed|wrong|stale|missing|stuck|errors?|drift(?:ed|s|ing)?)\\\\b',\n62:   '\\\\bout of (?:date|sync)\\\\b',\n63: ].join('|'), 'i');\n64: \n65: // ───────────────────────────────────────────────────────────────────\n66: // 3. TYPES\n67: // ───────────────────────────────────────────────────────────────────\n68: \n69: interface HelperCandidate {\n70:   readonly command: string;\n71:   readonly score: number;\n72: }\n73: \n74: interface HelperModule {\n75:   readonly loadEntries: (root: string) => { readonly entries: readonly unknown[] };\n76:   readonly rankProblem: (\n77:     entries: readonly unknown[],\n78:     text: string,\n79:     options: { readonly top: number },\n80:   ) => { readonly candidates?: readonly HelperCandidate[] };\n81: }\n82: \n83: interface LoadedHelper {\n84:   readonly manifestMtimeMs: number;\n85:   readonly module: HelperModule;\n86:   readonly entries: readonly unknown[];\n87: }\n88: \n89: /** The doctor command the helper ranked first, with its rank score. */\n90: export interface DoctorProblemMatch {\n91:   readonly command: string;\n92:   readonly score: number;\n93: }\n94: \n95: // ───────────────────────────────────────────────────────────────────\n96: // 4. HELPERS\n97: // ───────────────────────────────────────────────────────────────────\n98: \n99: const loadedByRoot = new Map<string, LoadedHelper | null>();\n100: \n101: function loadHelper(workspaceRoot: string): LoadedHelper | null {\n102:   const scriptPath = join(workspaceRoot, HELPER_SCRIPT);\n103:   const manifestPath = join(workspaceRoot, ROUTE_MANIFEST);\n104:   if (!existsSync(scriptPath) || !existsSync(manifestPath)) return null;\n105:   let manifestMtimeMs: number;\n106:   try {\n107:     manifestMtimeMs = statSync(manifestPath).mtimeMs;\n108:   } catch {\n109:     return null;\n110:   }\n111:   const cached = loadedByRoot.get(workspaceRoot);\n112:   if (cached && cached.manifestMtimeMs === manifestMtimeMs) return cached;\n113:   try {\n114:     const helper = createRequire(import.meta.url)(scriptPath) as HelperModule;\n115:     const loaded: LoadedHelper = {\n116:       manifestMtimeMs,\n117:       module: helper,\n118:       entries: helper.loadEntries(workspaceRoot).entries,\n119:     };\n120:     loadedByRoot.set(workspaceRoot, loaded);\n121:     return loaded;\n122:   } catch {\n123:     loadedByRoot.set(workspaceRoot, null);\n124:     return null;\n125:   }\n126: }\n127: \n128: // ───────────────────────────────────────────────────────────────────\n129: // 5. CORE LOGIC\n130: // ───────────────────────────────────────────────────────────────────\n131: \n132: /** The strongest problem cue the prompt carries. */\n133: export function doctorProblemCue(prompt: string): 'strong' | 'weak' | null {\n134:   if (STRONG_PROBLEM_CUE.test(prompt)) return 'strong';\n135:   if (WEAK_PROBLEM_CUE.test(prompt)) return 'weak';\n136:   return null;\n137: }\n138: \n139: /**\n140:  * Ranks the prompt with /doctor:helper's own matcher and returns its first\n141:  * candidate when that candidate reaches the hand-off score, or null.\n142:  */\n143: export function matchDoctorProblem(prompt: string, workspaceRoot: string): DoctorProblemMatch | null {\n144:   const loaded = loadHelper(workspaceRoot);\n145:   if (!loaded) return null;\n146:   try {\n147:     const first = loaded.module.rankProblem(loaded.entries, prompt, { top: 1 }).candidates?.[0];\n148:     if (!first || typeof first.command !== 'string' || typeof first.score !== 'number') return null;\n149:     return first.score >= DOCTOR_HELPER_MIN_SCORE ? { command: first.command, score: first.score } : null;\n150:   } catch {\n151:     return null;\n152:   }\n153: }"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/lib/scorer/doctor-helper-handoff.ts\"}"},"time":{"start":1794543177765,"end":1794543178173}}}}
