d the helper ranks first for a doctor problem', () => {\n69:     const match = matchDoctorProblem('my deep research run never converges', WORKSPACE);\n70:     expect(match?.command).toBe('/doctor:deep-loop');\n71:     expect(match?.score).toBeGreaterThanOrEqual(6);\n72:   });\n73: \n74:   // The manifest phrases are the whole reason this reaches a command: the ranker\n75:   // carries no synonym list of its own.\n76:   it('reaches the git route for hooks that stopped firing', () => {\n77:     const match = matchDoctorProblem('my hooks are not firing, what do I run', WORKSPACE);\n78:     expect(match?.command).toBe('/doctor:git');\n79:     expect(match?.score).toBeGreaterThanOrEqual(6);\n80:   });\n81: \n82:   // The ranker names the runnable with its subcommand, so a hand-off can offer\n83:   // the exact command that runs instead of the helper that lists it.\n84:   it('returns the ranked runnable with its subcommand', () => {\n85:     expect(matchDoctorProblem('confirm the AGENTS.md sections in this repo have not drifted', WORKSPACE)?.runnable).toBe('/doctor:agents-md check');\n86:     expect(matchDoctorProblem('show me every GitHub Actions workflow and whether each is enabled', WORKSPACE)?.runnable).toBe('/doctor:ci report');\n87:   });\n88: \n89:   it('returns null for a prompt the helper does not match', () => {\n90:     expect(matchDoctorProblem('write me a poem about cats', WORKSPACE)).toBeNull();\n91:   });\n92: \n93:   it('returns null when the workspace has no doctor helper', () => {\n94:     expect(matchDoctorProblem('my deep research run never converges', mkdtempSync(join(tmpdir(), 'no-doctor-')))).toBeNull();\n95:   });\n96: });"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/tests/doctor-helper-handoff.vitest.ts\"}"},"time":{"start":1794543322129,"end":1794543322522}}}}
