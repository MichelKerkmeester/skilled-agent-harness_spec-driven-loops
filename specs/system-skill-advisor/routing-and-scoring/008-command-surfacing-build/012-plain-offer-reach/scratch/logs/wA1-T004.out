{"type":"tool_use","timestamp":1794543350782,"sessionID":"ses_e2ce4c822ffeajVHIjUYYvzhCo","part":{"partID":"prt_1d31e6eb6002GVuH5A3dKEJPbx","sessionID":"ses_e2ce4c822ffeajVHIjUYYvzhCo","messageID":"msg_1d31e5e50001d5JCp4eZqUvwOJ","type":"tool","id":"call_561ccb6123e84204a92501b6","tool":"shell","state":{"status":"completed","input":{"command":"git -c core.fsmonitor=false diff -- .skilled/skills/system-skill-advisor/runtime/lib/scorer/doctor-helper-handoff.ts .skilled/skills/system-skill-advisor/runtime/tests/doctor-helper-handoff.vitest.ts","workdir":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research"},"output":"diff --git a/.skilled/skills/system-skill-advisor/runtime/lib/scorer/doctor-helper-handoff.ts b/.skilled/skills/system-skill-advisor/runtime/lib/scorer/doctor-helper-handoff.ts\nindex bd8a5422bf..b3e0c6a287 100644\n--- a/.skilled/skills/system-skill-advisor/runtime/lib/scorer/doctor-helper-handoff.ts\n+++ b/.skilled/skills/system-skill-advisor/runtime/lib/scorer/doctor-helper-handoff.ts\n@@ -6,8 +6,8 @@\n // described in other words reaches no doctor command at all. /doctor:helper\n // already ranks free-text problems against every doctor route by word overlap.\n // When no doctor bridge passes, this module asks that same ranker whether the\n-// prompt describes a doctor problem, and if it does the advisor offers\n-// /doctor:helper, which then names the command.\n+// prompt describes a doctor problem, and if it does the advisor offers the command the ranker named, or\n+// /doctor:helper when that command asks before it runs.\n //\n // Two durable design choices:\n //   1. The ranker is the helper's own script, loaded from the workspace at run\n@@ -51,6 +51,7 @@ export const DOCTOR_HELPER_UNCUED_MIN_SCORE = 10;\n const STRONG_PROBLEM_CUE = new RegExp([\n   \"\\\\b(?:not|isn'?t|aren'?t|doesn'?t|don'?t|won'?t|can'?t) (?:\\\\w+ )?(?:work|working|registered|found|load|loading|run|running|active|linked|fir(?:e|es|ing)|trigger(?:s|ing)?|converg\\\\w*)\\\\b\",\n   '\\\\bnever (?:converg\\\\w*|finish\\\\w*|stops?|works?|loads?|runs?)\\\\b',\n+  '\\\\bstopped converg\\\\w*\\\\b',\n   '\\\\breturns? nothing\\\\b',\n   '\\\\b(?:healthy|health|diagnos\\\\w*)\\\\b',\n   '\\\\bturn(?:ed)? (?:on|off)\\\\b',\n@@ -62,12 +63,18 @@ const WEAK_PROBLEM_CUE = new RegExp([\n   '\\\\bout of (?:date|sync)\\\\b',\n ].join('|'), 'i');\n \n+// A request for a repair route that names no problem the ranker knows still\n+// belongs to /doctor:helper, which lists the routes and their reasons. The two\n+// phrases are exact, so ordinary work requests never carry them.\n+const GENERIC_REPAIR_CUE = /\\b(?:repair path|i have a problem)\\b/i;\n+\n // ───────────────────────────────────────────────────────────────────\n // 3. TYPES\n // ───────────────────────────────────────────────────────────────────\n \n interface HelperCandidate {\n   readonly command: string;\n+  readonly runnable?: string;\n   readonly score: number;\n }\n \n@@ -89,6 +96,8 @@ interface LoadedHelper {\n /** The doctor command the helper ranked first, with its rank score. */\n export interface DoctorProblemMatch {\n   readonly command: string;\n+  /** The command with its subcommand, such as `/doctor:agents-md check`. */\n+  readonly runnable: string;\n   readonly score: number;\n }\n \n@@ -136,6 +145,11 @@ export function doctorProblemCue(prompt: string): 'strong' | 'weak' | null {\n   return null;\n }\n \n+/** True when the prompt asks for a repair route without naming the problem. */\n+export function genericRepairCue(prompt: string): boolean {\n+  return GENERIC_REPAIR_CUE.test(prompt);\n+}\n+\n /**\n  * Ranks the prompt with /doctor:helper's own matcher and returns its first\n  * candidate when that candidate reaches the hand-off score, or null.\n@@ -146,7 +160,13 @@ export function matchDoctorProblem(prompt: string, workspaceRoot: string): Docto\n   try {\n     const first = loaded.module.rankProblem(loaded.entries, prompt, { top: 1 }).candidates?.[0];\n     if (!first || typeof first.command !== 'string' || typeof first.score !== 'number') return null;\n-    return first.score >= DOCTOR_HELPER_MIN_SCORE ? { command: first.command, score: first.score } : null;\n+    return first.score >= DOCTOR_HELPER_MIN_SCORE\n+      ? {\n+          command: first.command,\n+          runnable: typeof first.runnable === 'string' && first.runnable !== '' ? first.runnable : first.command,\n+          score: first.score,\n+        }\n+      : null;\n   } catch {\n     return null;\n   }\ndiff --git a/.skilled/skills/system-skill-advisor/runtime/tests/doctor-helper-handoff.vitest.ts b/.skilled/skills/system-skill-advisor/runtime/tests/doctor-helper-handoff.vitest.ts\nindex 2b831e2c5c..6692626e63 100644\n--- a/.skilled/skills/system-skill-advisor/runtime/tests/doctor-helper-handoff.vitest.ts\n+++ b/.skilled/skills/system-skill-advisor/runtime/tests/doctor-helper-handoff.vitest.ts\n@@ -12,7 +12,7 @@ import { fileURLToPath } from 'node:url';\n \n import { describe, expect, it } from 'vitest';\n \n-import { doctorProblemCue, matchDoctorProblem } from '../lib/scorer/doctor-helper-handoff.js';\n+import { doctorProblemCue, genericRepairCue, matchDoctorProblem } from '../lib/scorer/doctor-helper-handoff.js';\n import { findAdvisorWorkspaceRoot } from '../lib/utils/workspace-root.js';\n \n const HERE = dirname(fileURLToPath(import.meta.url));\n@@ -34,6 +34,12 @@ describe('doctor problem cue', () => {\n     expect(doctorProblemCue('the git hooks are not triggering on commit')).toBe('strong');\n   });\n \n+  // A loop that stopped converging reports the same wrong state in the past\n+  // tense, which the \"never <verb>\" form does not cover.\n+  it('reads a loop that stopped converging as a strong cue', () => {\n+    expect(doctorProblemCue('my research loop stopped converging and I cannot see why')).toBe('strong');\n+  });\n+\n   it('reads a bare problem word as a weak cue', () => {\n     expect(doctorProblemCue('Fix the broken JSON example and revalidate the packet.')).toBe('weak');\n     expect(doctorProblemCue('my AGENTS.md is out of date with the template')).toBe('weak');\n@@ -45,6 +51,19 @@ describe('doctor problem cue', () => {\n   });\n });\n \n+describe('generic repair request cue', () => {\n+  // A repair route asked for in these words names no problem the ranker knows,\n+  // and the helper lists every route with its reason.\n+  it('reads a request for a repair route as a doctor request', () => {\n+    expect(genericRepairCue('I have a problem and want the right repair path suggested with reasons')).toBe(true);\n+  });\n+\n+  // The same words in a remark about resolved work describe no open problem.\n+  it('ignores the same words once the problem is fixed', () => {\n+    expect(genericRepairCue('much appreciated, that fixed the problem completely')).toBe(false);\n+  });\n+});\n+\n describe('doctor helper ranker bridge', () => {\n   it('returns the command the helper ranks first for a doctor problem', () => {\n     const match = matchDoctorProblem('my deep research run never converges', WORKSPACE);\n@@ -60,6 +79,13 @@ describe('doctor helper ranker bridge', () => {\n     expect(match?.score).toBeGreaterThanOrEqual(6);\n   });\n \n+  // The ranker names the runnable with its subcommand, so a hand-off can offer\n+  // the exact command that runs instead of the helper that lists it.\n+  it('returns the ranked runnable with its subcommand', () => {\n+    expect(matchDoctorProblem('confirm the AGENTS.md sections in this repo have not drifted', WORKSPACE)?.runnable).toBe('/doctor:agents-md check');\n+    expect(matchDoctorProblem('show me every GitHub Actions workflow and whether each is enabled', WORKSPACE)?.runnable).toBe('/doctor:ci report');\n+  });\n+\n   it('returns null for a prompt the helper does not match', () => {\n     expect(matchDoctorProblem('write me a poem about cats', WORKSPACE)).toBeNull();\n   });\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"diff --git a/.skilled/skills/system-skill-advisor/runtime/lib/scorer/doctor-helper-handoff.ts b/.skilled/skills/system-skill-advisor/runtime/lib/scorer/doctor-helper-handoff.ts\nindex bd8a5422bf..b3e0c6a287 100644\n--- a/.skilled/skills/system-skill-advisor/runtime/lib/scorer/doctor-helper-handoff.ts\n+++ b/.skilled/skills/system-skill-advisor/runtime/lib/scorer/doctor-helper-handoff.ts\n@@ -6,8 +6,8 @@\n // described in other words reaches no doctor command at all. /doctor:helper\n // already ranks free-text problems against every doctor route by word overlap.\n // When no doctor bridge passes, this module asks that same ranker whether the\n-// prompt describes a doctor problem, and if it does the advisor offers\n-// /doctor:helper, which then names the command.\n+// prompt describes a doctor problem, and if it does the advisor offers the command the ranker named, or\n+// /doctor:helper when that command asks before it runs.\n //\n // Two durable design choices:\n //   1. The ranker is the helper's own script, loaded from the workspace at run\n@@ -51,6 +51,7 @@ export const DOCTOR_HELPER_UNCUED_MIN_SCORE = 10;\n const STRONG_PROBLEM_CUE = new RegExp([\n   \"\\\\b(?:not|isn'?t|aren'?t|doesn'?t|don'?t|won'?t|can'?t) (?:\\\\w+ )?(?:work|working|registered|found|load|loading|run|running|active|linked|fir(?:e|es|ing)|trigger(?:s|ing)?|converg\\\\w*)\\\\b\",\n   '\\\\bnever (?:converg\\\\w*|finish\\\\w*|stops?|works?|loads?|runs?)\\\\b',\n+  '\\\\bstopped converg\\\\w*\\\\b',\n   '\\\\breturns? nothing\\\\b',\n   '\\\\b(?:healthy|health|diagnos\\\\w*)\\\\b',\n   '\\\\bturn(?:ed)? (?:on|off)\\\\b',\n@@ -62,12 +63,18 @@ const WEAK_PROBLEM_CUE = new RegExp([\n   '\\\\bout of (?:date|sync)\\\\b',\n ].join('|'), 'i');\n \n+// A request for a repair route that names no problem the ranker knows still\n+// belongs to /doctor:helper, which lists the routes and their reasons. The two\n+// phrases are exact, so ordinary work requests never carry them.\n+const GENERIC_REPAIR_CUE = /\\b(?:repair path|i have a problem)\\b/i;\n+\n // ───────────────────────────────────────────────────────────────────\n // 3. TYPES\n // ───────────────────────────────────────────────────────────────────\n \n interface HelperCandidate {\n   readonly command: string;\n+  readonly runnable?: string;\n   readonly score: number;\n }\n \n@@ -89,6 +96,8 @@ interface LoadedHelper {\n /** The doctor command the helper ranked first, with its rank score. */\n export interface DoctorProblemMatch {\n   readonly command: string;\n+  /** The command with its subcommand, such as `/doctor:agents-md check`. */\n+  readonly runnable: string;\n   readonly score: number;\n }\n \n@@ -136,6 +145,11 @@ export function doctorProblemCue(prompt: string): 'strong' | 'weak' | null {\n   return null;\n }\n \n+/** True when the prompt asks for a repair route without naming the problem. */\n+export function genericRepairCue(prompt: string): boolean {\n+  return GENERIC_REPAIR_CUE.test(prompt);\n+}\n+\n /**\n  * Ranks the prompt with /doctor:helper's own matcher and returns its first\n  * candidate when that candidate reaches the hand-off score, or null.\n@@ -146,7 +160,13 @@ export function matchDoctorProblem(prompt: string, workspaceRoot: string): Docto\n   try {\n     const first = loaded.module.rankProblem(loaded.entries, prompt, { top: 1 }).candidates?.[0];\n     if (!first || typeof first.command !== 'string' || typeof first.score !== 'number') return null;\n-    return first.score >= DOCTOR_HELPER_MIN_SCORE ? { command: first.command, score: first.score } : null;\n+    return first.score >= DOCTOR_HELPER_MIN_SCORE\n+      ? {\n+          command: first.command,\n+          runnable: typeof first.runnable === 'string' && first.runnable !== '' ? first.runnable : first.command,\n+          score: first.score,\n+        }\n+      : null;\n   } catch {\n     return null;\n   }\ndiff --git a/.skilled/skills/system-skill-advisor/runtime/tests/doctor-helper-handoff.vitest.ts b/.skilled/skills/system-skill-advisor/runtime/tests/doctor-helper-handoff.vitest.ts\nindex 2b831e2c5c..6692626e63 100644\n--- a/.skilled/skills/system-skill-advisor/runtime/tests/doctor-helper-handoff.vitest.ts\n+++ b/.skilled/skills/system-skill-advisor/runtime/tests/doctor-helper-handoff.vitest.ts\n@@ -12,7 +12,7 @@ import { fileURLToPath } from 'node:url';\n \n import { describe, expect, it } from 'vitest';\n \n-import { doctorProblemCue, matchDoctorProblem } from '../lib/scorer/doctor-helper-handoff.js';\n+import { doctorProblemCue, genericRepairCue, matchDoctorProblem } from '../lib/scorer/doctor-helper-handoff.js';\n import { findAdvisorWorkspaceRoot } from '../lib/utils/workspace-root.js';\n \n const HERE = dirname(fileURLToPath(import.meta.url));\n@@ -34,6 +34,12 @@ describe('doctor problem cue', () => {\n     expect(doctorProblemCue('the git hooks are not triggering on commit')).toBe('strong');\n   });\n \n+  // A loop that stopped converging reports the same wrong state in the past\n+  // tense, which the \"never <verb>\" form does not cover.\n+  it('reads a loop that stopped converging as a strong cue', () => {\n+    expect(doctorProblemCue('my research loop stopped converging and I cannot see why')).toBe('strong');\n+  });\n+\n   it('reads a bare problem word as a weak cue', () => {\n     expect(doctorProblemCue('Fix the broken JSON example and revalidate the packet.')).toBe('weak');\n     expect(doctorProblemCue('my AGENTS.md is out of date with the template')).toBe('weak');\n@@ -45,6 +51,19 @@ describe('doctor problem cue', () => {\n   });\n });\n \n+describe('generic repair request cue', () => {\n+  // A repair route asked for in these words names no problem the ranker knows,\n+  // and the helper lists every route with its reason.\n+  it('reads a request for a repair route as a doctor request', () => {\n+    expect(genericRepairCue('I have a problem and want the right repair path suggested with reasons')).toBe(true);\n+  });\n+\n+  // The same words in a remark about resolved work describe no open problem.\n+  it('ignores the same words once the problem is fixed', () => {\n+    expect(genericRepairCue('much appreciated, that fixed the problem completely')).toBe(false);\n+  });\n+});\n+\n describe('doctor helper ranker bridge', () => {\n   it('returns the command the helper ranks first for a doctor problem', () => {\n     const match = matchDoctorProblem('my deep research run never converges', WORKSPACE);\n@@ -60,6 +79,13 @@ describe('doctor helper ranker bridge', () => {\n     expect(match?.score).toBeGreaterThanOrEqual(6);\n   });\n \n+  // The ranker names the runnable with its subcommand, so a hand-off can offer\n+  // the exact command that runs instead of the helper that lists it.\n+  it('returns the ranked runnable with its subcommand', () => {\n+    expect(matchDoctorProblem('confirm the AGENTS.md sections in this repo have not drifted', WORKSPACE)?.runnable).toBe('/doctor:agents-md check');\n+    expect(matchDoctorProblem('show me every GitHub Actions workflow and whether each is enabled', WORKSPACE)?.runnable).toBe('/doctor:ci report');\n+  });\n+\n   it('returns null for a prompt the helper does not match', () => {\n     expect(matchDoctorProblem('write me a poem about cats', WORKSPACE)).toBeNull();\n   });\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"git -c core.fsmonitor=false diff -- .skilled/skills/system-skill-advisor/runtime/lib/scorer/doctor-helper-handoff.ts .skilled/skills/system-skill-advisor/runtime/tests/doctor-helper-handoff.vitest.ts\",\"workdir\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research\"}"},"time":{"start":1794543349430,"end":1794543350782}}}}
