{"type":"tool_use","timestamp":1794544735068,"sessionID":"ses_e2ccd293affe14TOdLD5l4JKj6","part":{"partID":"prt_1d3339073001iSIkg5WkWBMpN3","sessionID":"ses_e2ccd293affe14TOdLD5l4JKj6","messageID":"msg_1d3338911001jijpYygs8pRFLP","type":"tool","id":"call_8e632ee2046443aeb4fb3167","tool":"read","state":{"status":"completed","input":{"path":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/tests/handlers/advisor-recommend-compiled-route-option.vitest.ts"},"output":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/tests/handlers/advisor-recommend-compiled-route-option.vitest.ts, lines 1-166\n1: // ───────────────────────────────────────────────────────────────\n2: // MODULE: Advisor Recommend Compiled-Route Option Tests\n3: // ───────────────────────────────────────────────────────────────\n4: \n5: import { mkdtempSync, rmSync, writeFileSync } from 'node:fs';\n6: import { tmpdir } from 'node:os';\n7: import { join } from 'node:path';\n8: import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';\n9: \n10: const mockedChild = vi.hoisted(() => ({ execFileSync: vi.fn() }));\n11: vi.mock('node:child_process', () => ({ execFileSync: mockedChild.execFileSync }));\n12: \n13: import { frontDoorReadsPromptFromStdin, handleAdvisorRecommend } from '../../handlers/advisor-recommend.js';\n14: import { MODE_COMMANDS } from '../../lib/command-attach.js';\n15: \n16: const COMPILED_ROUTING_FLAG = 'SPECKIT_COMPILED_ROUTING';\n17: const prompt = 'Implement a TypeScript feature with focused tests.';\n18: \n19: type RecommendResponse = Awaited<ReturnType<typeof handleAdvisorRecommend>>;\n20: type ResponsePayload = {\n21:   data?: {\n22:     recommendations?: Array<{ skillId: string; command?: string }>;\n23:     cache?: { hit: boolean };\n24:   };\n25: };\n26: \n27: function responseData(response: RecommendResponse): ResponsePayload {\n28:   return JSON.parse(response.content[0]?.text ?? '{}') as ResponsePayload;\n29: }\n30: \n31: function compiledRouteCallCount(): number {\n32:   return mockedChild.execFileSync.mock.calls.filter(([, args]) => (\n33:     Array.isArray(args)\n34:       && args.some((argument) => (\n35:         typeof argument === 'string' && argument.endsWith('compiled-route.cjs')\n36:       ))\n37:   )).length;\n38: }\n39: \n40: function callsCompiledRoute(): boolean {\n41:   return compiledRouteCallCount() > 0;\n42: }\n43: \n44: describe('advisor_recommend compiled-route option', () => {\n45:   let previousCompiledRoutingFlag: string | undefined;\n46: \n47:   beforeEach(() => {\n48:     previousCompiledRoutingFlag = process.env[COMPILED_ROUTING_FLAG];\n49:     delete process.env[COMPILED_ROUTING_FLAG];\n50:     vi.clearAllMocks();\n51:     mockedChild.execFileSync.mockReturnValue(JSON.stringify({\n52:       action: 'route',\n53:       hubId: 'sk-code',\n54:       targets: ['quality'],\n55:       servingAuthority: 'compiled',\n56:       fingerprint: 'abc123',\n57:       generation: 3,\n58:     }));\n59:   });\n60: \n61:   afterEach(() => {\n62:     if (previousCompiledRoutingFlag === undefined) {\n63:       delete process.env[COMPILED_ROUTING_FLAG];\n64:     } else {\n65:       process.env[COMPILED_ROUTING_FLAG] = previousCompiledRoutingFlag;\n66:     }\n67:   });\n68: \n69:   it('skips compiled-route enrichment on fresh and cached results when requested', async () => {\n70:     const withoutOption = await handleAdvisorRecommend({\n71:       prompt,\n72:       options: { includeAttribution: true },\n73:     });\n74:     expect(responseData(withoutOption).data?.recommendations?.[0]?.skillId).toBe('sk-code');\n75:     expect(callsCompiledRoute()).toBe(true);\n76: \n77:     mockedChild.execFileSync.mockClear();\n78:     const withoutCompiledRoute = await handleAdvisorRecommend({\n79:       prompt,\n80:       options: { includeCompiledRoute: false },\n81:     });\n82:     expect(responseData(withoutCompiledRoute).data?.recommendations?.[0]?.skillId).toBe('sk-code');\n83:     expect(responseData(withoutCompiledRoute).data?.cache?.hit).toBe(false);\n84:     expect(callsCompiledRoute()).toBe(false);\n85: \n86:     const cachedWithoutCompiledRoute = await handleAdvisorRecommend({\n87:       prompt,\n88:       options: { includeCompiledRoute: false },\n89:     });\n90:     expect(responseData(cachedWithoutCompiledRoute).data?.recommendations?.[0]?.skillId).toBe('sk-code');\n91:     expect(responseData(cachedWithoutCompiledRoute).data?.cache?.hit).toBe(true);\n92:     expect(callsCompiledRoute()).toBe(false);\n93:   });\n94: \n95:   it('sends the prompt to the compiled-route front door on stdin, never in argv', async () => {\n96:     await handleAdvisorRecommend({ prompt, options: { includeAttribution: true } });\n97:     const call = mockedChild.execFileSync.mock.calls.find(([, args]) => (\n98:       Array.isArray(args) && args.some((argument) => typeof argument === 'string' && argument.endsWith('compiled-route.cjs'))\n99:     ));\n100:     expect(call).toBeDefined();\n101:     if (!call) return;\n102:     const [, args, options] = call as [string, string[], { input?: string }];\n103:     expect(args).toContain('--prompt-stdin');\n104:     expect(args).not.toContain(prompt);\n105:     expect(options.input).toBe(prompt);\n106:   });\n107: \n108:   it('looks up the route for the first recommendation alone when asked to', async () => {\n109:     const hubPrompt = 'create a new agent for code review';\n110:     await handleAdvisorRecommend({ prompt: hubPrompt, options: { includeCompiledRoute: true } });\n111:     const everyHub = compiledRouteCallCount();\n112:     expect(everyHub, 'the prompt ranks more than one hub').toBeGreaterThan(1);\n113: \n114:     mockedChild.execFileSync.mockClear();\n115:     const topOnly = responseData(await handleAdvisorRecommend({\n116:       prompt: hubPrompt,\n117:       options: { includeCompiledRoute: true, compiledRouteTopOnly: true },\n118:     })).data?.recommendations ?? [];\n119:     expect(compiledRouteCallCount()).toBeLessThanOrEqual(1);\n120:     expect(topOnly.slice(1).every((row) => !('compiledRoute' in row))).toBe(true);\n121:   });\n122: \n123:   it('never offers one command through both its own row and the owning hub', async () => {\n124:     const command = '/create:agent';\n125:     const mode = Object.entries(MODE_COMMANDS['sk-doc']).find(([, value]) => value === command)?.[0];\n126:     expect(mode, 'sk-doc declares a mode for /create:agent').toBeTruthy();\n127:     mockedChild.execFileSync.mockReturnValue(JSON.stringify({\n128:       action: 'route',\n129:       hubId: 'sk-doc',\n130:       selectionKind: 'single',\n131:       targets: [{ workflowMode: mode }],\n132:     }));\n133: \n134:     // The command row ranks beside the hub here, so the hub stays silent.\n135:     const both = responseData(await handleAdvisorRecommend({\n136:       prompt: 'create a new agent for code review',\n137:       options: { includeCompiledRoute: true },\n138:     })).data?.recommendations ?? [];\n139:     expect(both.map((row) => row.skillId)).toContain('create:agent');\n140:     const hubBesideRow = both.find((row) => row.skillId === 'sk-doc');\n141:     expect(hubBesideRow, 'the hub still ranks').toBeDefined();\n142:     expect(hubBesideRow?.command).toBeUndefined();\n143: \n144:     // With no command row in the result the same route does carry the command,\n145:     // which is what proves the silence above came from the collision.\n146:     const hubOnly = responseData(await handleAdvisorRecommend({\n147:       prompt: 'Write a README for the payments module',\n148:       options: { includeCompiledRoute: true },\n149:     })).data?.recommendations ?? [];\n150:     expect(hubOnly.map((row) => row.skillId)).not.toContain('create:agent');\n151:     expect(hubOnly.find((row) => row.skillId === 'sk-doc')?.command).toBe(command);\n152:   });\n153: \n154:   it('recognizes only a front door that reads the prompt from stdin', () => {\n155:     const dir = mkdtempSync(join(tmpdir(), 'front-door-'));\n156:     try {\n157:       writeFileSync(join(dir, 'current.cjs'), \"const promptFromStdin = args.includes('--prompt-stdin');\\n\");\n158:       writeFileSync(join(dir, 'older.cjs'), \"const promptIdx = args.indexOf('--prompt');\\n\");\n159:       expect(frontDoorReadsPromptFromStdin(join(dir, 'current.cjs'))).toBe(true);\n160:       expect(frontDoorReadsPromptFromStdin(join(dir, 'older.cjs'))).toBe(false);\n161:       expect(frontDoorReadsPromptFromStdin(join(dir, 'missing.cjs'))).toBe(false);\n162:     } finally {\n163:       rmSync(dir, { recursive: true, force: true });\n164:     }\n165:   });\n166: });","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/tests/handlers/advisor-recommend-compiled-route-option.vitest.ts, lines 1-166\n1: // ───────────────────────────────────────────────────────────────\n2: // MODULE: Advisor Recommend Compiled-Route Option Tests\n3: // ───────────────────────────────────────────────────────────────\n4: \n5: import { mkdtempSync, rmSync, writeFileSync } from 'node:fs';\n6: import { tmpdir } from 'node:os';\n7: import { join } from 'node:path';\n8: import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';\n9: \n10: const mockedChild = vi.hoisted(() => ({ execFileSync: vi.fn() }));\n11: vi.mock('node:child_process', () => ({ execFileSync: mockedChild.execFileSync }));\n12: \n13: import { frontDoorReadsPromptFromStdin, handleAdvisorRecommend } from '../../handlers/advisor-recommend.js';\n14: import { MODE_COMMANDS } from '../../lib/command-attach.js';\n15: \n16: const COMPILED_ROUTING_FLAG = 'SPECKIT_COMPILED_ROUTING';\n17: const prompt = 'Implement a TypeScript feature with focused tests.';\n18: \n19: type RecommendResponse = Awaited<ReturnType<typeof handleAdvisorRecommend>>;\n20: type ResponsePayload = {\n21:   data?: {\n22:     recommendations?: Array<{ skillId: string; command?: string }>;\n23:     cache?: { hit: boolean };\n24:   };\n25: };\n26: \n27: function responseData(response: RecommendResponse): ResponsePayload {\n28:   return JSON.parse(response.content[0]?.text ?? '{}') as ResponsePayload;\n29: }\n30: \n31: function compiledRouteCallCount(): number {\n32:   return mockedChild.execFileSync.mock.calls.filter(([, args]) => (\n33:     Array.isArray(args)\n34:       && args.some((argument) => (\n35:         typeof argument === 'string' && argument.endsWith('compiled-route.cjs')\n36:       ))\n37:   )).length;\n38: }\n39: \n40: function callsCompiledRoute(): boolean {\n41:   return compiledRouteCallCount() > 0;\n42: }\n43: \n44: describe('advisor_recommend compiled-route option', () => {\n45:   let previousCompiledRoutingFlag: string | undefined;\n46: \n47:   beforeEach(() => {\n48:     previousCompiledRoutingFlag = process.env[COMPILED_ROUTING_FLAG];\n49:     delete process.env[COMPILED_ROUTING_FLAG];\n50:     vi.clearAllMocks();\n51:     mockedChild.execFileSync.mockReturnValue(JSON.stringify({\n52:       action: 'route',\n53:       hubId: 'sk-code',\n54:       targets: ['quality'],\n55:       servingAuthority: 'compiled',\n56:       fingerprint: 'abc123',\n57:       generation: 3,\n58:     }));\n59:   });\n60: \n61:   afterEach(() => {\n62:     if (previousCompiledRoutingFlag === undefined) {\n63:       delete process.env[COMPILED_ROUTING_FLAG];\n64:     } else {\n65:       process.env[COMPILED_ROUTING_FLAG] = previousCompiledRoutingFlag;\n66:     }\n67:   });\n68: \n69:   it('skips compiled-route enrichment on fresh and cached results when requested', async () => {\n70:     const withoutOption = await handleAdvisorRecommend({\n71:       prompt,\n72:       options: { includeAttribution: true },\n73:     });\n74:     expect(responseData(withoutOption).data?.recommendations?.[0]?.skillId).toBe('sk-code');\n75:     expect(callsCompiledRoute()).toBe(true);\n76: \n77:     mockedChild.execFileSync.mockClear();\n78:     const withoutCompiledRoute = await handleAdvisorRecommend({\n79:       prompt,\n80:       options: { includeCompiledRoute: false },\n81:     });\n82:     expect(responseData(withoutCompiledRoute).data?.recommendations?.[0]?.skillId).toBe('sk-code');\n83:     expect(responseData(withoutCompiledRoute).data?.cache?.hit).toBe(false);\n84:     expect(callsCompiledRoute()).toBe(false);\n85: \n86:     const cachedWithoutCompiledRoute = await handleAdvisorRecommend({\n87:       prompt,\n88:       options: { includeCompiledRoute: false },\n89:     });\n90:     expect(responseData(cachedWithoutCompiledRoute).data?.recommendations?.[0]?.skillId).toBe('sk-code');\n91:     expect(responseData(cachedWithoutCompiledRoute).data?.cache?.hit).toBe(true);\n92:     expect(callsCompiledRoute()).toBe(false);\n93:   });\n94: \n95:   it('sends the prompt to the compiled-route front door on stdin, never in argv', async () => {\n96:     await handleAdvisorRecommend({ prompt, options: { includeAttribution: true } });\n97:     const call = mockedChild.execFileSync.mock.calls.find(([, args]) => (\n98:       Array.isArray(args) && args.some((argument) => typeof argument === 'string' && argument.endsWith('compiled-route.cjs'))\n99:     ));\n100:     expect(call).toBeDefined();\n101:     if (!call) return;\n102:     const [, args, options] = call as [string, string[], { input?: string }];\n103:     expect(args).toContain('--prompt-stdin');\n104:     expect(args).not.toContain(prompt);\n105:     expect(options.input).toBe(prompt);\n106:   });\n107: \n108:   it('looks up the route for the first recommendation alone when asked to', async () => {\n109:     const hubPrompt = 'create a new agent for code review';\n110:     await handleAdvisorRecommend({ prompt: hubPrompt, options: { includeCompiledRoute: true } });\n111:     const everyHub = compiledRouteCallCount();\n112:     expect(everyHub, 'the prompt ranks more than one hub').toBeGreaterThan(1);\n113: \n114:     mockedChild.execFileSync.mockClear();\n115:     const topOnly = responseData(await handleAdvisorRecommend({\n116:       prompt: hubPrompt,\n117:       options: { includeCompiledRoute: true, compiledRouteTopOnly: true },\n118:     })).data?.recommendations ?? [];\n119:     expect(compiledRouteCallCount()).toBeLessThanOrEqual(1);\n120:     expect(topOnly.slice(1).every((row) => !('compiledRoute' in row))).toBe(true);\n121:   });\n122: \n123:   it('never offers one command through both its own row and the owning hub', async () => {\n124:     const command = '/create:agent';\n125:     const mode = Object.entries(MODE_COMMANDS['sk-doc']).find(([, value]) => value === command)?.[0];\n126:     expect(mode, 'sk-doc declares a mode for /create:agent').toBeTruthy();\n127:     mockedChild.execFileSync.mockReturnValue(JSON.stringify({\n128:       action: 'route',\n129:       hubId: 'sk-doc',\n130:       selectionKind: 'single',\n131:       targets: [{ workflowMode: mode }],\n132:     }));\n133: \n134:     // The command row ranks beside the hub here, so the hub stays silent.\n135:     const both = responseData(await handleAdvisorRecommend({\n136:       prompt: 'create a new agent for code review',\n137:       options: { includeCompiledRoute: true },\n138:     })).data?.recommendations ?? [];\n139:     expect(both.map((row) => row.skillId)).toContain('create:agent');\n140:     const hubBesideRow = both.find((row) => row.skillId === 'sk-doc');\n141:     expect(hubBesideRow, 'the hub still ranks').toBeDefined();\n142:     expect(hubBesideRow?.command).toBeUndefined();\n143: \n144:     // With no command row in the result the same route does carry the command,\n145:     // which is what proves the silence above came from the collision.\n146:     const hubOnly = responseData(await handleAdvisorRecommend({\n147:       prompt: 'Write a README for the payments module',\n148:       options: { includeCompiledRoute: true },\n149:     })).data?.recommendations ?? [];\n150:     expect(hubOnly.map((row) => row.skillId)).not.toContain('create:agent');\n151:     expect(hubOnly.find((row) => row.skillId === 'sk-doc')?.command).toBe(command);\n152:   });\n153: \n154:   it('recognizes only a front door that reads the prompt from stdin', () => {\n155:     const dir = mkdtempSync(join(tmpdir(), 'front-door-'));\n156:     try {\n157:       writeFileSync(join(dir, 'current.cjs'), \"const promptFromStdin = args.includes('--prompt-stdin');\\n\");\n158:       writeFileSync(join(dir, 'older.cjs'), \"const promptIdx = args.indexOf('--prompt');\\n\");\n159:       expect(frontDoorReadsPromptFromStdin(join(dir, 'current.cjs'))).toBe(true);\n160:       expect(frontDoorReadsPromptFromStdin(join(dir, 'older.cjs'))).toBe(false);\n161:       expect(frontDoorReadsPromptFromStdin(join(dir, 'missing.cjs'))).toBe(false);\n162:     } finally {\n163:       rmSync(dir, { recursive: true, force: true });\n164:     }\n165:   });\n166: });"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/tests/handlers/advisor-recommend-compiled-route-option.vitest.ts\"}"},"time":{"start":1794544734323,"end":1794544735068}}}}
{"type":"step_finish","timestamp":1794544736928,"sessionID":"ses_e2ccd293affe14TOdLD5l4JKj6","part":{"id":"prt_1d3339aa0001c0rGlwNrr3zCuS","sessionID":"ses_e2ccd293affe14TOdLD5l4JKj6","messageID":"msg_1d3338911001jijpYygs8pRFLP","type":"step-finish","reason":"tool-calls","snapshot":"28c31a42533427f324a79a0a8842b79dbc03eb8d","cost":0,"tokens":{"input":9893,"output":144,"reasoning":84,"cache":{"read":31360,"write":0}}}}
{"type":"step_start","timestamp":1794544738408,"sessionID":"ses_e2ccd293affe14TOdLD5l4JKj6","part":{"id":"prt_1d333a0680011QwongY9iqMLRt","sessionID":"ses_e2ccd293affe14TOdLD5l4JKj6","messageID":"msg_1d3339aa5001WKzeTNE5wrN75Z","type":"step-start","snapshot":"4a0800557baa182d53200eda086a9d0c0a029809"}}
{"type":"tool_use","timestamp":1794544740323,"sessionID":"ses_e2ccd293affe14TOdLD5l4JKj6","part":{"partID":"prt_1d333a5a2001Blpr7suDWBhX8g","sessionID":"ses_e2ccd293affe14TOdLD5l4JKj6","messageID":"msg_1d3339aa5001WKzeTNE5wrN75Z","type":"tool","id":"call_782e204f746f4fa3b3dd812f","tool":"skill","state":{"status":"completed","input":{"id":"sk-code"},"output":"<skill_content name=\"sk-code\">\n# Skill: sk-code\n\n<!-- Keywords: sk-code, code, surface-aware, two-axis, opencode, typescript, python, shell, json, jsonc, github-actions, ci-workflow, sk-code-quality, sk-code-review, sk-code-ci, sk-code-frontend, quality, code-review, verification, debug, implement, workflow-doctrine, mode-registry, workflowmode, packetkind, backendkind, surface-router, evidence-base, surface-packet, guard, adapter, stderr, detector -->\n\n# Code Family Hub (sk-code)\n\nOne skill has two axes, one shared surface-detection router and one advisor identity.\nThe **workflow axis** has two code modes that act: sk-code-quality and sk-code-review.\nThe **surface axis** has three read-only evidence packets the hub bundles alongside a workflow mode: sk-code-ci, sk-code-frontend and sk-code-skilled.\nEach packet carries the shared **implement → debug → verify** workflow doctrine (`shared/references/workflow-*.md`, symlinked in) plus its own domain knowledge.\nThis hub holds NO per-mode logic. It routes by `workflowMode` through `mode-registry.json`, and each mode or surface keeps its own contract in its packet.\n\n**Version authority.** This file's `version` frontmatter is the hub's release version and matches the newest entry under `changelog/`.\n`description.json`, `mode-registry.json` and `hub-router.json` carry the same value. Each hub-root JSON routing file therefore states the same release.\n`ROUTER.md` and `README.md` keep their own document versions, as the frontmatter-versioning standard gives every doc but `SKILL.md`.\nThe authority stops at the hub root. Each `modes[]` packet carries its own version and release cadence.\nA packet version is independent of this one by design, so a gap between them is not drift.\n\n---\n\n## 1. WHEN TO USE\n\nUse this skill for code-family workflows. Invoke it as `sk-code` with an optional mode hint such as `quality: <request>`. The hub classifies the request, resolves a mode key, and loads the matching nested packet.\n\n**Workflow axis** (modes that act, one of them chosen as primary):\n\n| Mode | Use it for | Packet |\n|------|------------|--------|\n| **sk-code-quality** | Quality gate, P0/P1/P2 author checks, comment hygiene and surface checklists. | `sk-code/sk-code-quality/` |\n| **sk-code-review** | Findings-first review, security and correctness baseline, checklists, output contract and PR-state gates. | `sk-code/sk-code-review/` |\n\n**Surface axis** (read-only, advisor-invisible evidence. When a workflow mode scores, the hub bundles the surface after that primary mode. When no workflow mode scores, the hub routes the surface alone for a lookup, implement, debug or verify task, and the acting agent hands the author gates to `sk-code-quality` before it claims completion):\n\n| Surface | Carries | Packet |\n|---------|---------|--------|\n| **sk-code-ci** | GitHub Actions evidence: trigger, filter, permission, timeout, concurrency and caching rules, the protected set, the intentional message-contract exception and the scaffold templates, with the repository-specific values read from a CI profile. Read-only. | `sk-code/sk-code-ci/` |\n| **sk-code-frontend** | Stack-agnostic frontend evidence: web markup and CSS, web layout and accessibility, visual values, visual hierarchy and review, motion and interaction, the `tokens.css` starter tokens and Figma-to-code checks. Read-only. | `sk-code/sk-code-frontend/` |\n| **sk-code-skilled** | System-code evidence: TypeScript/Python/shell/config standards, hooks, alignment verification, authoring checklists. Bundles the implement → debug → verify workflow doctrine (read-only evidence) for the Skilled surface, and the acting agent applies it. | `sk-code/sk-code-skilled/` |\n\n**Surface list.** The hub has exactly three surfaces:\n- SKILLED (`sk-code-skilled`): the native surface for this framework's own code.\n- CI (`sk-code-ci`): the GitHub Actions workflow standards surface.\n- Frontend (`sk-code-frontend`): the stack-agnostic web practice and Figma-to-code surface, with visual values, visual hierarchy and review, and motion and interaction guidance, bundled from request vocabulary alone.\n\nThe hub also has two workflow modes: quality (`sk-code-quality`) and review (`sk-code-review`).\nAny other sk-code doc that counts surfaces points to this sentence.\n\n### When NOT to Use\n- Documentation-only changes with no code-work contract - use `sk-doc`.\n- Git workflow, branch, commit, PR, merge, or release work - use `sk-git`.\n- Pure browser inspection or external MCP transport work - use the relevant MCP skill.\n- For a measured Style Reference (design tokens extracted from a live source), use `sk-design-md-generator` first.\n- When a request or a frame leaves a visual value open (spacing, type, color, radius, shadow or motion), or a value sits off every token and scale, load `sk-code-frontend` and decide it from its visual-values reference.\n- Backend support primitives in `shared/` - they are consumed by the modes, not invoked as a user workflow.\n\n---\n\n## 2. SMART ROUTING\n\nRouting is **registry-driven at runtime and authored in `hub-router.json`** in two stages.\nStage 1 (hub → mode) uses `hub-router.json` as the authored mode vocabulary. `mode-registry.json` carries the packet contracts, whose aliases are checked against that vocabulary.\nStage 2 (mode → leaves) uses the root [`ROUTER.md`](./ROUTER.md) as the authored leaf-set router.\nBoth files point back here instead of restating the split.\n\nThe advisor routes every code query to the single identity `sk-code`. Resolve the mode with `node .skilled/bin/compiled-route.cjs --hub sk-code --prompt \"<task>\"` and follow the decision: `route` loads its `targets`, `clarify` and `defer` ask, `reject` refuses.\nCompiled routing is the default. The legacy fallback, the kill-switch and the `UNKNOWN_FALLBACK_CHECKLIST` live in the compiled-routing section of [`ROUTER.md`](./ROUTER.md).\n\nA bare implement, debug or verify request with no workflow mode becomes a pure surface bundle, and an unclear code intent asks for disambiguation. Neither path forces a stale default.\nRun the compiled-routing directive in [`ROUTER.md`](./ROUTER.md) before selecting hub resources.\n\n---\n\n## 3. HOW IT WORKS\n\n### Terms\n\n- **`workflowMode`**: the public mode or surface key a request resolves to.\n- **`packetKind`**: the axis a packet sits on, `workflow` for a mode that acts and `surface` for read-only evidence bundled alongside a mode.\n- **`backendKind`**: which backend runs the packet, `surface-router` or `review-cache` for a workflow mode and `evidence-base` for a surface.\n- **`surfaceBundle`**: the `routerPolicy.outcomes` entry where one workflow mode leads and zero or more surfaces follow as evidence.\n- **`mode-registry.json`**: the registry that owns each mode's discriminator, `surfaceDetection` markers and `advisorRouting`.\n- **`hub-router.json`**: stage one's `routerSignals`, `vocabularyClasses` and the surface-bundling policy.\n- **`ROUTER.md`**: stage two's `INTENT_SIGNALS` and `RESOURCE_MAP`, plus the `SHARED_CONTROL_RESOURCES` list and the always-loaded `DEFAULT_RESOURCE` preamble.\n- **shared control**: a hub-level resource declared in `SHARED_CONTROL_RESOURCES`, which resolves on disk and never projects as a leaf.\n- **leaf**: a typed `(workflowMode, leafResourceId)` pair from `leaf-manifest.json` that a `RESOURCE_MAP` path converts to.\n- **surface detection**: the shared detection order over the declared surfaces, which tries each specific surface first, then the `SKILLED` fallback, then `UNKNOWN`.\n- **`--surface-hint`**: the front-door flag that carries the detected surface into the compiled route, so a hinted surface leads a keyword tie.\n- **`UNKNOWN_FALLBACK`**: the load level the router returns, with a disambiguation checklist, when no mode resolves.\n\n### Layout\n```\nsk-code/\n  SKILL.md               # this routing hub (no per-mode code logic)\n  README.md              # human-facing front page for the hub\n  ROUTER.md              # active stage-two surface router and shared-control declaration\n  mode-registry.json     # the two-axis discriminator + advisorRouting contract\n  hub-router.json        # lexical routing signals + surfaceBundle policy for hub-local choice\n  description.json       # hub advisor descriptor\n  graph-metadata.json    # the ONE advisor identity for the whole skill\n  leaf-manifest.json     # typed (workflowMode, leaf) pairs the router guards validate\n  changelog/             # hub release notes, one v<version>.md per hub release\n  feature-catalog/       # current-state inventory of the hub's routing capabilities\n  manual-testing-playbook/  # routing and disambiguation scenarios for the hub\n  benchmark/             # historical routing benchmark inputs and reports\n  sk-code-quality/       # quality mode packet     (workflow)\n  sk-code-review/        # review mode packet      (workflow)\n  sk-code-ci/            # GitHub Actions workflow standards packet (read-only evidence; rules, protected set and scaffold templates)\n  sk-code-frontend/      # stack-agnostic web and Figma-to-code evidence packet (read-only; references/web-visual-values.md, web-visual-hierarchy.md and web-motion-and-interaction.md plus assets/tokens.css)\n  sk-code-skilled/      # skilled surface packet (read-only evidence; carries the workflow doctrine)\n  shared/                # shared surface-detection router, cross-mode helpers, and the implement/debug/verify workflow doctrine (references/workflow-*.md)\n```\n\nEach mode or surface packet is self-contained and carries no per-packet `graph-metadata.json`. Only this hub carries one, so the advisor discovers exactly one code skill identity. The implement/debug/verify workflow doctrine is a single shared source under `shared/references/`, and each surface symlinks it in rather than duplicating it.\n\n### Backend\nThe `surface-router` backend is the shared surface-detection router under `shared/`.\nIt centralizes the detection order over the declared surfaces, the SKILLED fallback and UNKNOWN.\nIt carries the shared implement → debug → verify workflow doctrine consumed by each surface.\nThe `review-cache` backend supports the sk-code-review mode's non-mutating review output cache.\nThe `evidence-base` backend serves the surface packets as read-only domain evidence (`sk-code-ci/`, `sk-code-frontend/`, `sk-code-skilled/`). The hub bundles them alongside the primary mode.\nThe packet mutates nothing and never carries process. The acting agent applies the doctrine it bundles.\nShared backend material provides surface identity, the workflow doctrine and cross-mode helpers.\nIt must never gain per-mode workflow contracts.\n\nThe **implement → debug → verify** phases are not standalone modes.\nTheir surface-agnostic doctrine lives once in `shared/references/workflow-implement.md`, `workflow-debug.md` and `workflow-verify.md`.\nThose files are symlinked into each surface, so the active surface carries the full workflow.\nA request to implement, debug or verify code causes the router to detect its surface and load that surface's bundled doctrine.\nThe acting agent applies that doctrine.\n\n### Maintenance\n\nAfter adding or removing a surface, run `/doctor:sk-code setup`. It checks the hub and names the repair for each failing check.\n\n---\n\n## 4. RULES\n\n### ✅ ALWAYS\n- **ALWAYS** resolve a mode through `mode-registry.json`, and never hardcode a router mapping in the hub.\n- **ALWAYS** keep mode contracts in the mode packets, so the hub stays routing-only.\n- **ALWAYS** keep exactly one `graph-metadata.json` (this hub's) so the advisor sees one skill identity.\n- **ALWAYS** give every mode an `advisorRouting` block with `routingClass: \"metadata\"` and the correct `packetSkillName`.\n- **ALWAYS** keep the implement/debug/verify workflow doctrine as one shared source under `shared/references/`, symlinked into each surface, and never fork per-surface copies.\n- **ALWAYS** keep `ROUTER.md` `RESOURCE_MAP` keys aligned with its intent keys and packet leaves aligned with `leaf-manifest.json`.\n- **ALWAYS** keep hub-shared map inputs explicit in `SHARED_CONTROL_RESOURCES`, because they are control resources and never typed leaves.\n\n### ⛔ NEVER\n- **NEVER** add a `graph-metadata.json` inside a mode packet or `shared/`.\n- **NEVER** put per-mode quality, review, or surface workflow logic in the hub.\n- **NEVER** hardcode a router mapping outside `mode-registry.json`.\n- **NEVER** reintroduce implement, debug, or verify as standalone mode packets, because they are surface-owned doctrine.\n\n### ⚠️ ESCALATE IF\n- A new code mode is needed - extend `mode-registry.json` and open a packet. Do not bolt logic onto the hub.\n- Surface identity and workflow ownership conflict in a way the shared router cannot classify.\n\n---\n\n## 5. REFERENCES\n\n- Workflow mode packets: `sk-code-quality/SKILL.md`, `sk-code-review/SKILL.md`.\n- Surface evidence packets: `sk-code-ci/SKILL.md`, `sk-code-frontend/SKILL.md`, `sk-code-skilled/SKILL.md`.\n- Shared workflow doctrine: `shared/references/workflow-implement.md`, `shared/references/workflow-debug.md`, `shared/references/workflow-verify.md` (symlinked into each surface).\n- Registry: `mode-registry.json` (two-axis: `packetKind` discriminates workflow vs surface).\n- Hub router signals + surface bundling: `hub-router.json`.\n- Surface router and shared controls: `ROUTER.md`.\n- Parent-skill pattern: `.skilled/skills/sk-doc/sk-create-skill/references/parent-skill/parent-skills-nested-packets.md`.\n- Sibling example: `.skilled/skills/sk-prompt/`.\n\nBase directory for this skill: /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.opencode/skills/sk-code\nRelative paths in this skill (e.g., scripts/, reference/) are relative to this base directory.\nNote: file list is sampled.\n\n<skill_files>\n<file>/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.opencode/skills/sk-code/README.md</file>\n<file>/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.opencode/skills/sk-code/ROUTER.md</file>\n<file>/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.opencode/skills/sk-code/benchmark/README.md</file>\n<file>/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.opencode/skills/sk-code/benchmark/reports/2026-06-01--after--router/README.md</file>\n<file>/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.opencode/skills/sk-code/benchmark/reports/2026-06-01--after--router/failed-runs.md</file>\n<file>/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.opencode/skills/sk-code/benchmark/reports/2026-06-01--after--router/findings-and-recommendations.md</file>\n<file>/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.opencode/skills/sk-code/benchmark/reports/2026-06-01--after--router/results.csv</file>\n<file>/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.opencode/skills/sk-code/benchmark/reports/2026-06-01--after--router/skill-benchmark-report.json</file>\n<file>/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.opencode/skills/sk-code/benchmark/reports/2026-06-01--after--router/skill-benchmark-report.md</file>\n<file>/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.opencode/skills/sk-code/benchmark/reports/2026-06-01--after--router/source.md</file>\n</skill_files>\n</skill_content>","title":"skill","metadata":{"metadata":{"name":"sk-code","directory":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.opencode/skills/sk-code","truncated":false},"content":[{"type":"text","text":"<skill_content name=\"sk-code\">\n# Skill: sk-code\n\n<!-- Keywords: sk-code, code, surface-aware, two-axis, opencode, typescript, python, shell, json, jsonc, github-actions, ci-workflow, sk-code-quality, sk-code-review, sk-code-ci, sk-code-frontend, quality, code-review, verification, debug, implement, workflow-doctrine, mode-registry, workflowmode, packetkind, backendkind, surface-router, evidence-base, surface-packet, guard, adapter, stderr, detector -->\n\n# Code Family Hub (sk-code)\n\nOne skill has two axes, one shared surface-detection router and one advisor identity.\nThe **workflow axis** has two code modes that act: sk-code-quality and sk-code-review.\nThe **surface axis** has three read-only evidence packets the hub bundles alongside a workflow mode: sk-code-ci, sk-code-frontend and sk-code-skilled.\nEach packet carries the shared **implement → debug → verify** workflow doctrine (`shared/references/workflow-*.md`, symlinked in) plus its own domain knowledge.\nThis hub holds NO per-mode logic. It routes by `workflowMode` through `mode-registry.json`, and each mode or surface keeps its own contract in its packet.\n\n**Version authority.** This file's `version` frontmatter is the hub's release version and matches the newest entry under `changelog/`.\n`description.json`, `mode-registry.json` and `hub-router.json` carry the same value. Each hub-root JSON routing file therefore states the same release.\n`ROUTER.md` and `README.md` keep their own document versions, as the frontmatter-versioning standard gives every doc but `SKILL.md`.\nThe authority stops at the hub root. Each `modes[]` packet carries its own version and release cadence.\nA packet version is independent of this one by design, so a gap between them is not drift.\n\n---\n\n## 1. WHEN TO USE\n\nUse this skill for code-family workflows. Invoke it as `sk-code` with an optional mode hint such as `quality: <request>`. The hub classifies the request, resolves a mode key, and loads the matching nested packet.\n\n**Workflow axis** (modes that act, one of them chosen as primary):\n\n| Mode | Use it for | Packet |\n|------|------------|--------|\n| **sk-code-quality** | Quality gate, P0/P1/P2 author checks, comment hygiene and surface checklists. | `sk-code/sk-code-quality/` |\n| **sk-code-review** | Findings-first review, security and correctness baseline, checklists, output contract and PR-state gates. | `sk-code/sk-code-review/` |\n\n**Surface axis** (read-only, advisor-invisible evidence. When a workflow mode scores, the hub bundles the surface after that primary mode. When no workflow mode scores, the hub routes the surface alone for a lookup, implement, debug or verify task, and the acting agent hands the author gates to `sk-code-quality` before it claims completion):\n\n| Surface | Carries | Packet |\n|---------|---------|--------|\n| **sk-code-ci** | GitHub Actions evidence: trigger, filter, permission, timeout, concurrency and caching rules, the protected set, the intentional message-contract exception and the scaffold templates, with the repository-specific values read from a CI profile. Read-only. | `sk-code/sk-code-ci/` |\n| **sk-code-frontend** | Stack-agnostic frontend evidence: web markup and CSS, web layout and accessibility, visual values, visual hierarchy and review, motion and interaction, the `tokens.css` starter tokens and Figma-to-code checks. Read-only. | `sk-code/sk-code-frontend/` |\n| **sk-code-skilled** | System-code evidence: TypeScript/Python/shell/config standards, hooks, alignment verification, authoring checklists. Bundles the implement → debug → verify workflow doctrine (read-only evidence) for the Skilled surface, and the acting agent applies it. | `sk-code/sk-code-skilled/` |\n\n**Surface list.** The hub has exactly three surfaces:\n- SKILLED (`sk-code-skilled`): the native surface for this framework's own code.\n- CI (`sk-code-ci`): the GitHub Actions workflow standards surface.\n- Frontend (`sk-code-frontend`): the stack-agnostic web practice and Figma-to-code surface, with visual values, visual hierarchy and review, and motion and interaction guidance, bundled from request vocabulary alone.\n\nThe hub also has two workflow modes: quality (`sk-code-quality`) and review (`sk-code-review`).\nAny other sk-code doc that counts surfaces points to this sentence.\n\n### When NOT to Use\n- Documentation-only changes with no code-work contract - use `sk-doc`.\n- Git workflow, branch, commit, PR, merge, or release work - use `sk-git`.\n- Pure browser inspection or external MCP transport work - use the relevant MCP skill.\n- For a measured Style Reference (design tokens extracted from a live source), use `sk-design-md-generator` first.\n- When a request or a frame leaves a visual value open (spacing, type, color, radius, shadow or motion), or a value sits off every token and scale, load `sk-code-frontend` and decide it from its visual-values reference.\n- Backend support primitives in `shared/` - they are consumed by the modes, not invoked as a user workflow.\n\n---\n\n## 2. SMART ROUTING\n\nRouting is **registry-driven at runtime and authored in `hub-router.json`** in two stages.\nStage 1 (hub → mode) uses `hub-router.json` as the authored mode vocabulary. `mode-registry.json` carries the packet contracts, whose aliases are checked against that vocabulary.\nStage 2 (mode → leaves) uses the root [`ROUTER.md`](./ROUTER.md) as the authored leaf-set router.\nBoth files point back here instead of restating the split.\n\nThe advisor routes every code query to the single identity `sk-code`. Resolve the mode with `node .skilled/bin/compiled-route.cjs --hub sk-code --prompt \"<task>\"` and follow the decision: `route` loads its `targets`, `clarify` and `defer` ask, `reject` refuses.\nCompiled routing is the default. The legacy fallback, the kill-switch and the `UNKNOWN_FALLBACK_CHECKLIST` live in the compiled-routing section of [`ROUTER.md`](./ROUTER.md).\n\nA bare implement, debug or verify request with no workflow mode becomes a pure surface bundle, and an unclear code intent asks for disambiguation. Neither path forces a stale default.\nRun the compiled-routing directive in [`ROUTER.md`](./ROUTER.md) before selecting hub resources.\n\n---\n\n## 3. HOW IT WORKS\n\n### Terms\n\n- **`workflowMode`**: the public mode or surface key a request resolves to.\n- **`packetKind`**: the axis a packet sits on, `workflow` for a mode that acts and `surface` for read-only evidence bundled alongside a mode.\n- **`backendKind`**: which backend runs the packet, `surface-router` or `review-cache` for a workflow mode and `evidence-base` for a surface.\n- **`surfaceBundle`**: the `routerPolicy.outcomes` entry where one workflow mode leads and zero or more surfaces follow as evidence.\n- **`mode-registry.json`**: the registry that owns each mode's discriminator, `surfaceDetection` markers and `advisorRouting`.\n- **`hub-router.json`**: stage one's `routerSignals`, `vocabularyClasses` and the surface-bundling policy.\n- **`ROUTER.md`**: stage two's `INTENT_SIGNALS` and `RESOURCE_MAP`, plus the `SHARED_CONTROL_RESOURCES` list and the always-loaded `DEFAULT_RESOURCE` preamble.\n- **shared control**: a hub-level resource declared in `SHARED_CONTROL_RESOURCES`, which resolves on disk and never projects as a leaf.\n- **leaf**: a typed `(workflowMode, leafResourceId)` pair from `leaf-manifest.json` that a `RESOURCE_MAP` path converts to.\n- **surface detection**: the shared detection order over the declared surfaces, which tries each specific surface first, then the `SKILLED` fallback, then `UNKNOWN`.\n- **`--surface-hint`**: the front-door flag that carries the detected surface into the compiled route, so a hinted surface leads a keyword tie.\n- **`UNKNOWN_FALLBACK`**: the load level the router returns, with a disambiguation checklist, when no mode resolves.\n\n### Layout\n```\nsk-code/\n  SKILL.md               # this routing hub (no per-mode code logic)\n  README.md              # human-facing front page for the hub\n  ROUTER.md              # active stage-two surface router and shared-control declaration\n  mode-registry.json     # the two-axis discriminator + advisorRouting contract\n  hub-router.json        # lexical routing signals + surfaceBundle policy for hub-local choice\n  description.json       # hub advisor descriptor\n  graph-metadata.json    # the ONE advisor identity for the whole skill\n  leaf-manifest.json     # typed (workflowMode, leaf) pairs the router guards validate\n  changelog/             # hub release notes, one v<version>.md per hub release\n  feature-catalog/       # current-state inventory of the hub's routing capabilities\n  manual-testing-playbook/  # routing and disambiguation scenarios for the hub\n  benchmark/             # historical routing benchmark inputs and reports\n  sk-code-quality/       # quality mode packet     (workflow)\n  sk-code-review/        # review mode packet      (workflow)\n  sk-code-ci/            # GitHub Actions workflow standards packet (read-only evidence; rules, protected set and scaffold templates)\n  sk-code-frontend/      # stack-agnostic web and Figma-to-code evidence packet (read-only; references/web-visual-values.md, web-visual-hierarchy.md and web-motion-and-interaction.md plus assets/tokens.css)\n  sk-code-skilled/      # skilled surface packet (read-only evidence; carries the workflow doctrine)\n  shared/                # shared surface-detection router, cross-mode helpers, and the implement/debug/verify workflow doctrine (references/workflow-*.md)\n```\n\nEach mode or surface packet is self-contained and carries no per-packet `graph-metadata.json`. Only this hub carries one, so the advisor discovers exactly one code skill identity. The implement/debug/verify workflow doctrine is a single shared source under `shared/references/`, and each surface symlinks it in rather than duplicating it.\n\n### Backend\nThe `surface-router` backend is the shared surface-detection router under `shared/`.\nIt centralizes the detection order over the declared surfaces, the SKILLED fallback and UNKNOWN.\nIt carries the shared implement → debug → verify workflow doctrine consumed by each surface.\nThe `review-cache` backend supports the sk-code-review mode's non-mutating review output cache.\nThe `evidence-base` backend serves the surface packets as read-only domain evidence (`sk-code-ci/`, `sk-code-frontend/`, `sk-code-skilled/`). The hub bundles them alongside the primary mode.\nThe packet mutates nothing and never carries process. The acting agent applies the doctrine it bundles.\nShared backend material provides surface identity, the workflow doctrine and cross-mode helpers.\nIt must never gain per-mode workflow contracts.\n\nThe **implement → debug → verify** phases are not standalone modes.\nTheir surface-agnostic doctrine lives once in `shared/references/workflow-implement.md`, `workflow-debug.md` and `workflow-verify.md`.\nThose files are symlinked into each surface, so the active surface carries the full workflow.\nA request to implement, debug or verify code causes the router to detect its surface and load that surface's bundled doctrine.\nThe acting agent applies that doctrine.\n\n### Maintenance\n\nAfter adding or removing a surface, run `/doctor:sk-code setup`. It checks the hub and names the repair for each failing check.\n\n---\n\n## 4. RULES\n\n### ✅ ALWAYS\n- **ALWAYS** resolve a mode through `mode-registry.json`, and never hardcode a router mapping in the hub.\n- **ALWAYS** keep mode contracts in the mode packets, so the hub stays routing-only.\n- **ALWAYS** keep exactly one `graph-metadata.json` (this hub's) so the advisor sees one skill identity.\n- **ALWAYS** give every mode an `advisorRouting` block with `routingClass: \"metadata\"` and the correct `packetSkillName`.\n- **ALWAYS** keep the implement/debug/verify workflow doctrine as one shared source under `shared/references/`, symlinked into each surface, and never fork per-surface copies.\n- **ALWAYS** keep `ROUTER.md` `RESOURCE_MAP` keys aligned with its intent keys and packet leaves aligned with `leaf-manifest.json`.\n- **ALWAYS** keep hub-shared map inputs explicit in `SHARED_CONTROL_RESOURCES`, because they are control resources and never typed leaves.\n\n### ⛔ NEVER\n- **NEVER** add a `graph-metadata.json` inside a mode packet or `shared/`.\n- **NEVER** put per-mode quality, review, or surface workflow logic in the hub.\n- **NEVER** hardcode a router mapping outside `mode-registry.json`.\n- **NEVER** reintroduce implement, debug, or verify as standalone mode packets, because they are surface-owned doctrine.\n\n### ⚠️ ESCALATE IF\n- A new code mode is needed - extend `mode-registry.json` and open a packet. Do not bolt logic onto the hub.\n- Surface identity and workflow ownership conflict in a way the shared router cannot classify.\n\n---\n\n## 5. REFERENCES\n\n- Workflow mode packets: `sk-code-quality/SKILL.md`, `sk-code-review/SKILL.md`.\n- Surface evidence packets: `sk-code-ci/SKILL.md`, `sk-code-frontend/SKILL.md`, `sk-code-skilled/SKILL.md`.\n- Shared workflow doctrine: `shared/references/workflow-implement.md`, `shared/references/workflow-debug.md`, `shared/references/workflow-verify.md` (symlinked into each surface).\n- Registry: `mode-registry.json` (two-axis: `packetKind` discriminates workflow vs surface).\n- Hub router signals + surface bundling: `hub-router.json`.\n- Surface router and shared controls: `ROUTER.md`.\n- Parent-skill pattern: `.skilled/skills/sk-doc/sk-create-skill/references/parent-skill/parent-skills-nested-packets.md`.\n- Sibling example: `.skilled/skills/sk-prompt/`.\n\nBase directory for this skill: /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.opencode/skills/sk-code\nRelative paths in this skill (e.g., scripts/, reference/) are relative to this base directory.\nNote: file list is sampled.\n\n<skill_files>\n<file>/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.opencode/skills/sk-code/README.md</file>\n<file>/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.opencode/skills/sk-code/ROUTER.md</file>\n<file>/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.opencode/skills/sk-code/benchmark/README.md</file>\n<file>/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.opencode/skills/sk-code/benchmark/reports/2026-06-01--after--router/README.md</file>\n<file>/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.opencode/skills/sk-code/benchmark/reports/2026-06-01--after--router/failed-runs.md</file>\n<file>/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.opencode/skills/sk-code/benchmark/reports/2026-06-01--after--router/findings-and-recommendations.md</file>\n<file>/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.opencode/skills/sk-code/benchmark/reports/2026-06-01--after--router/results.csv</file>\n<file>/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.opencode/skills/sk-code/benchmark/reports/2026-06-01--after--router/skill-benchmark-report.json</file>\n<file>/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.opencode/skills/sk-code/benchmark/reports/2026-06-01--after--router/skill-benchmark-report.md</file>\n<file>/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.opencode/skills/sk-code/benchmark/reports/2026-06-01--after--router/source.md</file>\n</skill_files>\n</skill_content>"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"id\":\"sk-code\"}"},"time":{"start":1794544739746,"end":1794544740323}}}}
{"type":"tool_use","timestamp":1794544740327,"sessionID":"ses_e2ccd293affe14TOdLD5l4JKj6","part":{"partID":"prt_1d333a63b001FW6q6Utj6t7SFn","sessionID":"ses_e2ccd293affe14TOdLD5l4JKj6","messageID":"msg_1d3339aa5001WKzeTNE5wrN75Z","type":"tool","id":"call_54ed50b27d0540cbb7905542","tool":"read","state":{"status":"completed","input":{"path":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/repo-rules/prevent-overengineering.md"},"output":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/repo-rules/prevent-overengineering.md, lines 1-175\n1: ---\n2: title: \"Rule: Prevent overengineering\"\n3: description: \"Build the smallest thing that solves the stated problem; take a costlier move only by naming what fails at the cheaper one.\"\n4: trigger_phrases:\n5:   - \"restraint ladder\"\n6:   - \"reversal cost order\"\n7:   - \"does this need to exist\"\n8:   - \"build nothing\"\n9:   - \"future proof\"\n10:   - \"might need it later\"\n11:   - \"flexible\"\n12:   - \"best practice\"\n13:   - \"while we're here\"\n14:   - \"premature abstraction\"\n15:   - \"DRY it up\"\n16:   - \"two is not a pattern\"\n17:   - \"speculative optimization\"\n18:   - \"add a config option\"\n19:   - \"add a dependency\"\n20:   - \"feature flag\"\n21:   - \"new abstraction layer\"\n22:   - \"pre-write pass\"\n23:   - \"climbing sentence\"\n24:   - \"fallback for a constraint that does not exist\"\n25:   - \"over-engineering\"\n26: importance_tier: important\n27: contextType: reference\n28: version: 1.0.1.4\n29: ---\n30: \n31: # Rule: Prevent overengineering\n32: \n33: > Routed from [`REPO RULES.md`](../../REPO%20RULES.md). Load before the first write of anything new.\n34: > Expands `AGENTS.md`, never overrides it. Where they appear to disagree, `AGENTS.md` wins and this file is wrong. Say so.\n35: \n36: ## Fires when\n37: \n38: - Adding a file, module, class, interface, abstraction, config option, feature flag, layer, or dependency.\n39: - Writing a spec or plan whose scope adds a file, module, option, layer, or dependency, before that scope is frozen.\n40: - Generalizing something that already works for its one caller.\n41: - Writing or thinking: *flexible*, *future-proof*, *scalable*, *extensible*, *might need*, *best practice*, *while we're here*.\n42: - Adding a test beyond the coverage floor, or wrapping something already callable.\n43: \n44: ## The rule\n45: \n46: **Build the smallest thing that solves the stated problem. Build the bigger thing only\n47: after naming what fails at the smaller one.**\n48: \n49: \"It's cleaner\" is not a failure. \"A future caller might\" is not a failure. A failure\n50: is something that breaks today, for a requirement that exists today.\n51: \n52: ---\n53: \n54: ## 1. THE REVERSAL-COST ORDER\n55: \n56: Start at the cheapest move every time. **Take a costlier one only by writing the sentence\n57: that says what fails at the cheaper one** in the response, not just in your head.\n58: \n59: | Move | Cost when wrong |\n60: |------|-----------------|\n61: | **Build nothing:** existing behavior already meets the requirement | zero |\n62: | Change a value, constant, or config that exists | one line to revert |\n63: | Extend an existing function or module in place | contained to one unit |\n64: | Add a new function beside the existing ones | one new symbol to learn |\n65: | Add a new file or module | a new place readers must look |\n66: | Add an abstraction, interface, or indirection layer | every future reader pays the hop |\n67: | Add a dependency | permanent supply-chain, version and trust surface |\n68: \n69: > **This orders moves by what being wrong costs, and it is deliberately not the numbered\n70: > rung ladder.** For code, the code skill's universal quality standards are the\n71: > authoritative rungs. Route through `sk-code` to reach them. That ladder orders\n72: > *solution sources*: standard library, then native platform, then an installed\n73: > dependency. Two orderings, two axes, one authority: cite rung numbers from that file,\n74: > and cite moves by name from this one. A \"rung 2\" named here would mean something\n75: > different there.\n76: \n77: Building nothing is not a formality: a surprising share of requests are already satisfied\n78: by code that exists, and reading first is what reveals it. The sentence, written out:\n79: \n80: > \"Extending `parseConfig` in place fails, because the CLI and the daemon call it with\n81: > incompatible defaults today, so the change breaks the daemon. Adding a new function\n82: > beside it.\"\n83: \n84: If you cannot write that with a real symbol and a real caller in it, you are reaching\n85: past the move you can justify.\n86: \n87: **A short diff is not a cheaper move when the next reader has to decode it.** A one-liner that packs two decisions into one expression moves the cost to every later reader, who must rebuild the intent before they can check it. When two moves cost the same, the one that handles the edge cases correctly wins.\n88: \n89: ---\n90: \n91: ## 2. THE PRE-WRITE PASS\n92: \n93: After reading the existing code, before the first edit, and before a spec or plan freezes its scope:\n94: \n95: 1. **Does this need to exist?** Walk §1 in order. Answer by naming the move and writing\n96:    its climbing sentence.\n97: 2. **What does it touch?** If the change can break a caller or a shared contract, name\n98:    the owning module, one real caller (`file:line`) and the contract that must not\n99:    break. Then list the tests, fixtures, config and exports the change must reach. No\n100:    real caller means the change is smaller than you think, or the code should not exist\n101:    either.\n102: \n103: ---\n104: \n105: ## 3. TWO SIGNALS `AGENTS.md` DOES NOT CARRY\n106: \n107: Its Restraint Signals table binds and is not repeated here.\n108: \n109: | Signal | What it means | Do this |\n110: |--------|---------------|---------|\n111: | A config option \"so we can change it later\" | a decision deferred into a permanent branch | Hardcode it (§4) |\n112: | A wrapper that only forwards arguments | indirection with no behavior | Call the thing directly |\n113: \n114: ---\n115: \n116: ## 4. SPECIFIC RESTRAINTS\n117: \n118: **Options.** Every option is a permanent branch in the code, a row in the docs, and an\n119: axis in the test matrix. Default to hardcoding. An option earns existence when **two\n120: real callers need different values today**.\n121: \n122: **Abstraction.** One instance is a case, two a coincidence, three a pattern. Abstracting\n123: at two buys a wrong abstraction more often than it saves a duplication.\n124: \n125: **Error handling.** Catch only what you can handle. A `try` that logs and re-raises, or\n126: swallows an exception into a default, converts a loud failure into a silent wrong answer.\n127: \n128: **Defensive checks.** Do not validate what the type system, the caller contract, or the\n129: layer above already guarantees. A null check on something never null tells the next\n130: reader it *is* sometimes null.\n131: \n132: **Tests.** The coverage floor and the earns-its-place bar are `AGENTS.md` §3. The ladder\n133: applies to test code exactly as to the code under test.\n134: \n135: **Performance.** No speculative optimization. Measure under stated conditions and report\n136: baseline and delta, or leave it alone.\n137: \n138: **Fallbacks.** A second code path for a constraint the target environment does not\n139: actually have is an untested branch that will rot. Add the no-install path, the offline\n140: path, or the degraded path only when you can name the environment that needs it. \"In\n141: case\" is not an environment.\n142: \n143: **Dependencies.** Prefer what the project has. A new one also takes the\n144: `blast-radius.md` pass, because installing mutates the environment.\n145: \n146: **Moves and merges.** Moved or merged code keeps its error handling and validation. Dropping a check during a move is a behavior change that needs its own reason.\n147: \n148: ---\n149: \n150: ## 5. WHAT THIS RULE IS NOT\n151: \n152: Restraint constrains *how much you build*, never *how much you deliver*.\n153: \n154: - **Not a license to under-deliver.** \"This part is unnecessary\" never authorizes\n155:   cutting it. Build the frozen scope **and** raise the amendment in the same response.\n156: - **Not a reason to skip real error handling.** A failure mode that happens is not\n157:   speculative.\n158: \n159: - **Not a reason to cut accessibility.** Restraint never cuts accessibility on user-facing UI: interactive elements stay keyboard-operable, carry an accessible name and keep a visible focus state.\n160: \n161: ---\n162: \n163: ## 6. SELF-CHECK\n164: \n165: - [ ] Named the move and wrote the climbing sentence for every move past \"build nothing\".\n166: - [ ] When two moves cost the same, I took the one that handles the edge cases correctly. A shorter diff that the next reader must decode did not count as cheaper.\n167: - [ ] Every new option, abstraction and dependency has a caller that needs it **today**.\n168: - [ ] Nothing is justified only by a future nobody asked for.\n169: - [ ] If I judged part of the scope unnecessary, I built it anyway and said so.\n170: - [ ] Any fallback path I added names the environment that requires it.\n171: - [ ] Where the change touches a caller or a shared contract, I named the owner, one real caller and the contract before editing. I listed the tests, fixtures, config and exports it must reach.\n172: - [ ] Every catch handles what it catches, and no check re-validates what a type or a caller contract already guarantees.\n173: - [ ] Every performance claim carries a measurement, and every new dependency names what the project's own tools could not do.\n174: - [ ] Moved or merged code kept its error handling and validation. Every check dropped during a move has its own stated reason.\n175: - [ ] Restraint did not cut accessibility on user-facing UI, where interactive elements stay keyboard-operable, carry an accessible name and keep a visible focus state.","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/repo-rules/prevent-overengineering.md, lines 1-175\n1: ---\n2: title: \"Rule: Prevent overengineering\"\n3: description: \"Build the smallest thing that solves the stated problem; take a costlier move only by naming what fails at the cheaper one.\"\n4: trigger_phrases:\n5:   - \"restraint ladder\"\n6:   - \"reversal cost order\"\n7:   - \"does this need to exist\"\n8:   - \"build nothing\"\n9:   - \"future proof\"\n10:   - \"might need it later\"\n11:   - \"flexible\"\n12:   - \"best practice\"\n13:   - \"while we're here\"\n14:   - \"premature abstraction\"\n15:   - \"DRY it up\"\n16:   - \"two is not a pattern\"\n17:   - \"speculative optimization\"\n18:   - \"add a config option\"\n19:   - \"add a dependency\"\n20:   - \"feature flag\"\n21:   - \"new abstraction layer\"\n22:   - \"pre-write pass\"\n23:   - \"climbing sentence\"\n24:   - \"fallback for a constraint that does not exist\"\n25:   - \"over-engineering\"\n26: importance_tier: important\n27: contextType: reference\n28: version: 1.0.1.4\n29: ---\n30: \n31: # Rule: Prevent overengineering\n32: \n33: > Routed from [`REPO RULES.md`](../../REPO%20RULES.md). Load before the first write of anything new.\n34: > Expands `AGENTS.md`, never overrides it. Where they appear to disagree, `AGENTS.md` wins and this file is wrong. Say so.\n35: \n36: ## Fires when\n37: \n38: - Adding a file, module, class, interface, abstraction, config option, feature flag, layer, or dependency.\n39: - Writing a spec or plan whose scope adds a file, module, option, layer, or dependency, before that scope is frozen.\n40: - Generalizing something that already works for its one caller.\n41: - Writing or thinking: *flexible*, *future-proof*, *scalable*, *extensible*, *might need*, *best practice*, *while we're here*.\n42: - Adding a test beyond the coverage floor, or wrapping something already callable.\n43: \n44: ## The rule\n45: \n46: **Build the smallest thing that solves the stated problem. Build the bigger thing only\n47: after naming what fails at the smaller one.**\n48: \n49: \"It's cleaner\" is not a failure. \"A future caller might\" is not a failure. A failure\n50: is something that breaks today, for a requirement that exists today.\n51: \n52: ---\n53: \n54: ## 1. THE REVERSAL-COST ORDER\n55: \n56: Start at the cheapest move every time. **Take a costlier one only by writing the sentence\n57: that says what fails at the cheaper one** in the response, not just in your head.\n58: \n59: | Move | Cost when wrong |\n60: |------|-----------------|\n61: | **Build nothing:** existing behavior already meets the requirement | zero |\n62: | Change a value, constant, or config that exists | one line to revert |\n63: | Extend an existing function or module in place | contained to one unit |\n64: | Add a new function beside the existing ones | one new symbol to learn |\n65: | Add a new file or module | a new place readers must look |\n66: | Add an abstraction, interface, or indirection layer | every future reader pays the hop |\n67: | Add a dependency | permanent supply-chain, version and trust surface |\n68: \n69: > **This orders moves by what being wrong costs, and it is deliberately not the numbered\n70: > rung ladder.** For code, the code skill's universal quality standards are the\n71: > authoritative rungs. Route through `sk-code` to reach them. That ladder orders\n72: > *solution sources*: standard library, then native platform, then an installed\n73: > dependency. Two orderings, two axes, one authority: cite rung numbers from that file,\n74: > and cite moves by name from this one. A \"rung 2\" named here would mean something\n75: > different there.\n76: \n77: Building nothing is not a formality: a surprising share of requests are already satisfied\n78: by code that exists, and reading first is what reveals it. The sentence, written out:\n79: \n80: > \"Extending `parseConfig` in place fails, because the CLI and the daemon call it with\n81: > incompatible defaults today, so the change breaks the daemon. Adding a new function\n82: > beside it.\"\n83: \n84: If you cannot write that with a real symbol and a real caller in it, you are reaching\n85: past the move you can justify.\n86: \n87: **A short diff is not a cheaper move when the next reader has to decode it.** A one-liner that packs two decisions into one expression moves the cost to every later reader, who must rebuild the intent before they can check it. When two moves cost the same, the one that handles the edge cases correctly wins.\n88: \n89: ---\n90: \n91: ## 2. THE PRE-WRITE PASS\n92: \n93: After reading the existing code, before the first edit, and before a spec or plan freezes its scope:\n94: \n95: 1. **Does this need to exist?** Walk §1 in order. Answer by naming the move and writing\n96:    its climbing sentence.\n97: 2. **What does it touch?** If the change can break a caller or a shared contract, name\n98:    the owning module, one real caller (`file:line`) and the contract that must not\n99:    break. Then list the tests, fixtures, config and exports the change must reach. No\n100:    real caller means the change is smaller than you think, or the code should not exist\n101:    either.\n102: \n103: ---\n104: \n105: ## 3. TWO SIGNALS `AGENTS.md` DOES NOT CARRY\n106: \n107: Its Restraint Signals table binds and is not repeated here.\n108: \n109: | Signal | What it means | Do this |\n110: |--------|---------------|---------|\n111: | A config option \"so we can change it later\" | a decision deferred into a permanent branch | Hardcode it (§4) |\n112: | A wrapper that only forwards arguments | indirection with no behavior | Call the thing directly |\n113: \n114: ---\n115: \n116: ## 4. SPECIFIC RESTRAINTS\n117: \n118: **Options.** Every option is a permanent branch in the code, a row in the docs, and an\n119: axis in the test matrix. Default to hardcoding. An option earns existence when **two\n120: real callers need different values today**.\n121: \n122: **Abstraction.** One instance is a case, two a coincidence, three a pattern. Abstracting\n123: at two buys a wrong abstraction more often than it saves a duplication.\n124: \n125: **Error handling.** Catch only what you can handle. A `try` that logs and re-raises, or\n126: swallows an exception into a default, converts a loud failure into a silent wrong answer.\n127: \n128: **Defensive checks.** Do not validate what the type system, the caller contract, or the\n129: layer above already guarantees. A null check on something never null tells the next\n130: reader it *is* sometimes null.\n131: \n132: **Tests.** The coverage floor and the earns-its-place bar are `AGENTS.md` §3. The ladder\n133: applies to test code exactly as to the code under test.\n134: \n135: **Performance.** No speculative optimization. Measure under stated conditions and report\n136: baseline and delta, or leave it alone.\n137: \n138: **Fallbacks.** A second code path for a constraint the target environment does not\n139: actually have is an untested branch that will rot. Add the no-install path, the offline\n140: path, or the degraded path only when you can name the environment that needs it. \"In\n141: case\" is not an environment.\n142: \n143: **Dependencies.** Prefer what the project has. A new one also takes the\n144: `blast-radius.md` pass, because installing mutates the environment.\n145: \n146: **Moves and merges.** Moved or merged code keeps its error handling and validation. Dropping a check during a move is a behavior change that needs its own reason.\n147: \n148: ---\n149: \n150: ## 5. WHAT THIS RULE IS NOT\n151: \n152: Restraint constrains *how much you build*, never *how much you deliver*.\n153: \n154: - **Not a license to under-deliver.** \"This part is unnecessary\" never authorizes\n155:   cutting it. Build the frozen scope **and** raise the amendment in the same response.\n156: - **Not a reason to skip real error handling.** A failure mode that happens is not\n157:   speculative.\n158: \n159: - **Not a reason to cut accessibility.** Restraint never cuts accessibility on user-facing UI: interactive elements stay keyboard-operable, carry an accessible name and keep a visible focus state.\n160: \n161: ---\n162: \n163: ## 6. SELF-CHECK\n164: \n165: - [ ] Named the move and wrote the climbing sentence for every move past \"build nothing\".\n166: - [ ] When two moves cost the same, I took the one that handles the edge cases correctly. A shorter diff that the next reader must decode did not count as cheaper.\n167: - [ ] Every new option, abstraction and dependency has a caller that needs it **today**.\n168: - [ ] Nothing is justified only by a future nobody asked for.\n169: - [ ] If I judged part of the scope unnecessary, I built it anyway and said so.\n170: - [ ] Any fallback path I added names the environment that requires it.\n171: - [ ] Where the change touches a caller or a shared contract, I named the owner, one real caller and the contract before editing. I listed the tests, fixtures, config and exports it must reach.\n172: - [ ] Every catch handles what it catches, and no check re-validates what a type or a caller contract already guarantees.\n173: - [ ] Every performance claim carries a measurement, and every new dependency names what the project's own tools could not do.\n174: - [ ] Moved or merged code kept its error handling and validation. Every check dropped during a move has its own stated reason.\n175: - [ ] Restraint did not cut accessibility on user-facing UI, where interactive elements stay keyboard-operable, carry an accessible name and keep a visible focus state."}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\