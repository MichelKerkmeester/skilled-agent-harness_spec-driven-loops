{"type":"tool_use","timestamp":1794544731136,"sessionID":"ses_e2ccd293affe14TOdLD5l4JKj6","part":{"partID":"prt_1d3338253001UnUx1g4L0cwFnJ","sessionID":"ses_e2ccd293affe14TOdLD5l4JKj6","messageID":"msg_1d33362a3001TbSb7x0PEXz5Mc","type":"tool","id":"call_49c34d117fbc47cfb933eacb","tool":"read","state":{"status":"completed","input":{"path":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/handlers/advisor-recommend.ts"},"output":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/handlers/advisor-recommend.ts, lines 1-732\n1: // ───────────────────────────────────────────────────────────────\n2: // MODULE: advisor_recommend Handler\n3: // ───────────────────────────────────────────────────────────────\n4: \n5: // ───────────────────────────────────────────────────────────────────\n6: // 1. IMPORTS\n7: // ───────────────────────────────────────────────────────────────────\n8: \n9: import { execFileSync } from 'node:child_process';\n10: import { readFileSync, realpathSync } from 'node:fs';\n11: import { resolve } from 'node:path';\n12: \n13: import { TRACKED_COMMANDS, attachCommand, commandRowFor, typedCommandForTop } from '../lib/command-attach.js';\n14: import { advisorPromptCache } from '../lib/prompt-cache.js';\n15: import {\n16:   resolveAdvisorThresholdConfig,\n17: } from '../lib/skill-advisor-brief.js';\n18: import { scoreAdvisorPrompt } from '../lib/scorer/fusion.js';\n19: import {\n20:   DEEP_ROUTING_PROJECTION_HASH,\n21:   MERGED_DEEP_SKILL_ID,\n22:   modeForAlias,\n23:   modeForPromptAlias,\n24: } from '../lib/scorer/aliases.js';\n25: import {\n26:   getSemanticShadowRuntimeHealth,\n27:   withSemanticShadowPromptEmbedding,\n28: } from '../lib/scorer/lanes/semantic-shadow.js';\n29: import { DEFAULT_SHADOW_SCORER_LANE_WEIGHTS } from '../lib/scorer/lane-registry.js';\n30: import { sanitizeSkillLabel } from '../lib/render.js';\n31: import { recordShadowDelta, shadowDeltaSinkEnabled } from '../lib/shadow/shadow-sink.js';\n32: import { findAdvisorWorkspaceRoot } from '../lib/utils/workspace-root.js';\n33: import {\n34:   AdvisorRecommendInputSchema,\n35:   AdvisorRecommendOutputSchema,\n36:   type AdvisorRecommendInput,\n37:   type AdvisorRecommendOutput,\n38: } from '../schemas/advisor-tool-schemas.js';\n39: import { readAdvisorStatus } from './advisor-status.js';\n40: import {\n41:   COMPILED_ROUTING_HUBS,\n42:   compiledRoutingEnabledForHub,\n43:   parseCompiledRoutingFlagMode,\n44: } from '../lib/compiled-routing-flag.js';\n45: import type { AdvisorScoringOptions } from '../lib/scorer/types.js';\n46: \n47: // ───────────────────────────────────────────────────────────────────\n48: // 2. TYPE DEFINITIONS\n49: // ───────────────────────────────────────────────────────────────────\n50: \n51: type HandlerResponse = { content: Array<{ type: string; text: string }> };\n52: type AdvisorStatus = ReturnType<typeof readAdvisorStatus>;\n53: type ScoredRecommendation = ReturnType<typeof scoreAdvisorPrompt>['recommendations'][number];\n54: type PublicRecommendationStatus = NonNullable<AdvisorRecommendOutput['recommendations'][number]['status']>;\n55: type PublicThresholds = AdvisorRecommendOutput['effectiveThresholds'];\n56: type ShadowRecommendation = NonNullable<AdvisorRecommendOutput['_shadow']>['recommendations'][number];\n57: \n58: // ───────────────────────────────────────────────────────────────────\n59: // 3. HELPERS\n60: // ───────────────────────────────────────────────────────────────────\n61: \n62: // Emit-only, stderr, debug-gated compiled-routing diagnostic. Never written to\n63: // stdout or the tool response, and never changes the recommendation outcome.\n64: function emitCompiledRoutingBreadcrumb(message: string): void {\n65:   if (process.env.SPECKIT_COMPILED_ROUTING_DEBUG) {\n66:     process.stderr.write(`[compiled-routing] ${message}\\n`);\n67:   }\n68: }\n69: \n70: function findWorkspaceRoot(start = process.cwd()): string {\n71:   return findAdvisorWorkspaceRoot(start, { maxDepth: 12 });\n72: }\n73: \n74: // Canonicalize a caller-supplied workspaceRoot via realpath.\n75: // The schema-level allowlist refinement runs against the same canonical\n76: // form, so a caller passing /tmp/symlink-to-repo gets the real path\n77: // post-symlink before downstream code uses it.\n78: function canonicalizeWorkspaceRoot(input: string): string {\n79:   const resolved = resolve(input);\n80:   try {\n81:     return realpathSync.native(resolved);\n82:   } catch {\n83:     return resolved;\n84:   }\n85: }\n86: \n87: function cacheSourceSignature(status: AdvisorStatus): string {\n88:   return `${status.freshness}:${status.generation}:${status.lastGenerationBump ?? 'never'}:${DEEP_ROUTING_PROJECTION_HASH}`;\n89: }\n90: \n91: function recommendationLabels(output: AdvisorRecommendOutput): string[] {\n92:   return output.recommendations.map((recommendation) => recommendation.skillId);\n93: }\n94: \n95: function unavailableTrustState(reason: string): AdvisorRecommendOutput['trustState'] {\n96:   return {\n97:     state: 'unavailable',\n98:     reason,\n99:     generation: 0,\n100:     checkedAt: new Date().toISOString(),\n101:     lastLiveAt: null,\n102:   };\n103: }\n104: \n105: function publicThresholds(args: {\n106:   confidenceThreshold?: number;\n107:   uncertaintyThreshold?: number;\n108: }): PublicThresholds {\n109:   const resolved = resolveAdvisorThresholdConfig(args);\n110:   return {\n111:     confidenceThreshold: resolved.confidenceThreshold,\n112:     uncertaintyThreshold: resolved.uncertaintyThreshold,\n113:     confidenceOnly: resolved.confidenceOnly,\n114:   };\n115: }\n116: \n117: function runtimeLaneHealthForStatus(status: AdvisorStatus): AdvisorScoringOptions['runtimeLaneHealth'] | undefined {\n118:   if (status.freshness !== 'stale') {\n119:     return undefined;\n120:   }\n121:   return {\n122:     graph_causal: {\n123:       status: 'runtime_degraded',\n124:       reason: status.trustState.reason ?? 'skill_graph_stale',\n125:     },\n126:   };\n127: }\n128: \n129: function renderableStatus(status: AdvisorStatus): AdvisorStatus {\n130:   const trustState = status.trustState.state;\n131:   if (status.freshness === 'unavailable' && (trustState === 'live' || trustState === 'stale')) {\n132:     return { ...status, freshness: trustState };\n133:   }\n134:   return status;\n135: }\n136: \n137: function emptyOutput(args: {\n138:   workspaceRoot: string;\n139:   effectiveThresholds: AdvisorRecommendOutput['effectiveThresholds'];\n140:   freshness: AdvisorRecommendOutput['freshness'];\n141:   trustState: AdvisorRecommendOutput['trustState'];\n142:   warnings?: readonly string[];\n143:   abstainReasons?: readonly string[];\n144: }): AdvisorRecommendOutput {\n145:   return AdvisorRecommendOutputSchema.parse({\n146:     workspaceRoot: args.workspaceRoot,\n147:     effectiveThresholds: args.effectiveThresholds,\n148:     recommendations: [],\n149:     ambiguous: false,\n150:     freshness: args.freshness,\n151:     trustState: args.trustState,\n152:     generatedAt: new Date().toISOString(),\n153:     cache: {\n154:       hit: false,\n155:       sourceSignaturePresent: false,\n156:     },\n157:     ...(args.warnings && args.warnings.length > 0 ? { warnings: [...args.warnings] } : {}),\n158:     ...(args.abstainReasons && args.abstainReasons.length > 0 ? { abstainReasons: [...args.abstainReasons] } : {}),\n159:   });\n160: }\n161: \n162: // The canonical flag is checked first so the reason names it when both are set.\n163: const ADVISOR_DISABLED_FLAGS = [\n164:   'SYSTEM_SKILL_ADVISOR_HOOK_DISABLED',\n165:   'SPECKIT_SKILL_ADVISOR_HOOK_DISABLED',\n166: ] as const;\n167: \n168: function disabledOutput(\n169:   workspaceRoot: string,\n170:   effectiveThresholds: PublicThresholds,\n171:   disabledBy: string,\n172: ): AdvisorRecommendOutput {\n173:   return emptyOutput({\n174:     workspaceRoot,\n175:     effectiveThresholds,\n176:     freshness: 'unavailable',\n177:     trustState: unavailableTrustState('ADVISOR_DISABLED'),\n178:     warnings: ['ADVISOR_DISABLED'],\n179:     abstainReasons: [`Skill advisor disabled by ${disabledBy}.`],\n180:   });\n181: }\n182: \n183: function absentOutput(\n184:   status: AdvisorStatus,\n185:   workspaceRoot: string,\n186:   effectiveThresholds: AdvisorRecommendOutput['effectiveThresholds'],\n187: ): AdvisorRecommendOutput {\n188:   return emptyOutput({\n189:     workspaceRoot,\n190:     effectiveThresholds,\n191:     freshness: 'absent',\n192:     trustState: status.trustState,\n193:     warnings: [status.trustState.reason ?? 'ADVISOR_FRESHNESS_ABSENT'],\n194:     abstainReasons: ['Skill advisor freshness is absent; returning fail-open empty recommendations.'],\n195:   });\n196: }\n197: \n198: function unavailableOutput(\n199:   status: AdvisorStatus,\n200:   workspaceRoot: string,\n201:   effectiveThresholds: AdvisorRecommendOutput['effectiveThresholds'],\n202: ): AdvisorRecommendOutput {\n203:   return emptyOutput({\n204:     workspaceRoot,\n205:     effectiveThresholds,\n206:     freshness: 'unavailable',\n207:     trustState: {\n208:       ...status.trustState,\n209:       state: 'unavailable',\n210:       reason: 'advisor_unavailable',\n211:     },\n212:     warnings: ['advisor_unavailable', ...(status.errors ?? [])],\n213:     abstainReasons: ['Skill advisor freshness is unavailable; returning fail-open empty recommendations.'],\n214:   });\n215: }\n216: \n217: function safeMany(values: readonly string[] | undefined): string[] {\n218:   return (values ?? [])\n219:     .map((value) => sanitizeSkillLabel(value))\n220:     .filter((value): value is string => Boolean(value));\n221: }\n222: \n223: function evidenceFeature(value: string): string {\n224:   const prefix = value.split(':', 1)[0];\n225:   switch (prefix) {\n226:     case 'phrase':\n227:       return 'phrase_match';\n228:     case 'token':\n229:       return 'token_match';\n230:     case 'hint':\n231:       return 'category_hint';\n232:     case 'derived':\n233:       return 'derived_skill_signal';\n234:     case 'doc':\n235:       return 'doc_reference_signal';\n236:     case 'cosine':\n237:       return 'semantic_similarity';\n238:     default:\n239:       if (value.includes('disambiguation')) return 'disambiguation_rule';\n240:       if (value.includes('surface')) return 'surface_signal';\n241:       if (value.includes('intent')) return 'intent_signal';\n242:       if (value.includes('loop')) return 'workflow_signal';\n243:       return 'scorer_signal';\n244:   }\n245: }\n246: \n247: function publicWhyRecommended(recommendation: ScoredRecommendation) {\n248:   const positiveLanes = recommendation.laneContributions\n249:     .filter((lane) => lane.rawScore > 0 || lane.weightedScore > 0)\n250:     .sort((left, right) => right.weightedScore - left.weightedScore)\n251:     .slice(0, 4);\n252:   const matchedSkillFeatures = positiveLanes.flatMap((lane) => (\n253:     Array.from(new Set(lane.evidence.map((entry) => evidenceFeature(entry)))).map((feature) => ({\n254:       lane: lane.lane,\n255:       feature,\n256:     }))\n257:   ));\n258:   const dominant = recommendation.dominantLane;\n259:   return {\n260:     reason: dominant\n261:       ? `Recommended from ranker signals: ${dominant} contributed the strongest live score.`\n262:       : 'Recommended from ranker signals without a single dominant live lane.',\n263:     dominantLane: dominant,\n264:     topLanes: positiveLanes.map((lane) => ({\n265:       lane: lane.lane,\n266:       rawScore: lane.rawScore,\n267:       weightedScore: lane.weightedScore,\n268:       weight: lane.weight,\n269:       shadowOnly: lane.shadowOnly,\n270:       evidenceTypes: Array.from(new Set(lane.evidence.map((entry) => evidenceFeature(entry)))),\n271:       evidenceCount: lane.evidence.length,\n272:     })),\n273:     matchedSkillFeatures,\n274:   };\n275: }\n276: \n277: // Doc evidence entries are skill-relative markdown paths emitted by the\n278: // derived lane as `doc:<path>`. The allowlist rejects anything that\n279: // could smuggle prompt content or path traversal into the response.\n280: const SAFE_DOC_PATH = /^(references|assets)\\/[A-Za-z0-9_./-]+\\.md$/;\n281: \n282: export function matchedDocsFromContributions(\n283:   recommendation: { readonly laneContributions: ReadonlyArray<{ readonly evidence: readonly string[] }> },\n284: ): string[] {\n285:   const docs: string[] = [];\n286:   for (const lane of recommendation.laneContributions) {\n287:     for (const entry of lane.evidence) {\n288:       if (!entry.startsWith('doc:')) continue;\n289:       const path = entry.slice(4);\n290:       if (!SAFE_DOC_PATH.test(path) || path.includes('..')) continue;\n291:       if (!docs.includes(path)) docs.push(path);\n292:       if (docs.length >= 3) return docs;\n293:     }\n294:   }\n295:   return docs;\n296: }\n297: \n298: function workflowModeForRecommendation(\n299:   recommendation: ScoredRecommendation,\n300:   prompt: string,\n301: ): string | undefined {\n302:   const directMode = modeForAlias(recommendation.skill);\n303:   const promptMode = recommendation.skill === MERGED_DEEP_SKILL_ID\n304:     ? modeForPromptAlias(prompt)\n305:     : null;\n306:   const workflowMode = sanitizeSkillLabel(directMode ?? promptMode ?? '');\n307:   return workflowMode || undefined;\n308: }\n309: \n310: function publicRecommendation(\n311:   recommendation: ScoredRecommendation,\n312:   includeAttribution: boolean,\n313:   prompt: string,\n314: ) {\n315:   const skillId = sanitizeSkillLabel(recommendation.skill);\n316:   if (!skillId) return null;\n317:   const commandRow = commandRowFor(recommendation.skill);\n318:   const matchedDocs = matchedDocsFromContributions(recommendation);\n319:   const redirectFrom = safeMany(recommendation.redirectFrom);\n320:   const redirectTo = sanitizeSkillLabel(recommendation.redirectTo ?? '');\n321:   const heldBelow = sanitizeSkillLabel(recommendation.heldBelow ?? '');\n322:   const sanitizedStatus = sanitizeSkillLabel(recommendation.lifecycleStatus);\n323:   const status: PublicRecommendationStatus | undefined = sanitizedStatus === 'active'\n324:     || sanitizedStatus === 'deprecated'\n325:     || sanitizedStatus === 'archived'\n326:     || sanitizedStatus === 'future'\n327:     ? sanitizedStatus as PublicRecommendationStatus\n328:     : undefined;\n329:   const workflowMode = workflowModeForRecommendation(recommendation, prompt);\n330:   return {\n331:     skillId,\n332:     kind: recommendation.kind,\n333:     score: recommendation.score,\n334:     confidence: recommendation.confidence,\n335:     uncertainty: recommendation.uncertainty,\n336:     dominantLane: recommendation.dominantLane,\n337:     ...(includeAttribution ? {\n338:       laneBreakdown: recommendation.laneContributions.map((lane) => ({\n339:         lane: lane.lane,\n340:         rawScore: lane.rawScore,\n341:         weightedScore: lane.weightedScore,\n342:         weight: lane.weight,\n343:         shadowOnly: lane.shadowOnly,\n344:       })),\n345:       why_recommended: publicWhyRecommended(recommendation),\n346:     } : {}),\n347:     ...(matchedDocs.length > 0 ? { matchedDocs } : {}),\n348:     ...(redirectFrom.length > 0 ? { redirectFrom } : {}),\n349:     ...(redirectTo ? { redirectTo } : {}),\n350:     // Hook briefs re-derive ambiguity from the public list, so a skill the typed\n351:     // command already ranked below its seed has to say so here.\n352:     ...(heldBelow ? { heldBelow } : {}),\n353:     ...(status ? { status } : {}),\n354:     ...(workflowMode ? { workflowMode } : {}),\n355:     // A command row is the contract a reader acts on, so its runnable string,\n356:     // policy and owner travel with the pick. An id with no row adds nothing.\n357:     ...(commandRow ? {\n358:       command: commandRow.command,\n359:       ...(commandRow.policy ? { policy: commandRow.policy } : {}),\n360:       ownerSkillId: commandRow.ownerSkillId,\n361:     } : {}),\n362:   };\n363: }\n364: \n365: // The front door runs from the request's workspaceRoot, and a caller may name\n366: // another checkout there, such as a worktree under the repository root. Its copy\n367: // can predate --prompt-stdin and would resolve an empty prompt, so such a copy\n368: // gets no compiled route rather than the prompt in argv.\n369: export function frontDoorReadsPromptFromStdin(frontDoorPath: string): boolean {\n370:   try {\n371:     return readFileSync(frontDoorPath, 'utf8').includes('--prompt-stdin');\n372:   } catch {\n373:     return false;\n374:   }\n375: }\n376: \n377: function compiledRouteForRecommendation(\n378:   skillId: string,\n379:   prompt: string,\n380:   workspaceRoot: string,\n381:   surfaceHint?: string,\n382: ): Record<string, unknown> | undefined {\n383:   if (!COMPILED_ROUTING_HUBS.has(skillId)) return undefined;\n384:   const frontDoor = resolve(workspaceRoot, '.skilled', 'bin', 'compiled-route.cjs');\n385:   if (!frontDoorReadsPromptFromStdin(frontDoor)) {\n386:     emitCompiledRoutingBreadcrumb(`compiled-route front door cannot read the prompt from stdin; skipping hub=${skillId}`);\n387:     return undefined;\n388:   }\n389:   try {\n390:     const args = [\n391:       frontDoor,\n392:       '--hub',\n393:       skillId,\n394:       '--prompt-stdin',\n395:     ];\n396:     // A hint the caller already holds is forwarded as its own argv element;\n397:     // the front door ignores a value that names no known surface.\n398:     if (surfaceHint) args.push('--surface-hint', surfaceHint);\n399:     const output = execFileSync(process.execPath, args, {\n400:       cwd: workspaceRoot,\n401:       encoding: 'utf8',\n402:       input: prompt,\n403:       stdio: ['pipe', 'pipe', 'pipe'],\n404:       timeout: 5_000,\n405:       maxBuffer: 1_048_576,\n406:     });\n407:     const parsed: unknown = JSON.parse(output.trim());\n408:     if (typeof parsed !== 'object' || parsed === null || Array.isArray(parsed)) {\n409:       return undefined;\n410:     }\n411:     const compiledRoute = parsed as Record<string, unknown>;\n412:     return compiledRoute.servingAuthority === 'legacy' ? undefined : compiledRoute;\n413:   } catch (error) {\n414:     // Surface the otherwise-silent fallback (debug-gated), including any child\n415:     // stderr the pipe above now captures instead of discarding. The served\n416:     // outcome is unchanged: a failed probe attaches no compiled route (legacy).\n417:     const childStderr = (error as { stderr?: unknown } | null)?.stderr;\n418:     const detail = typeof childStderr === 'string' && childStderr.trim()\n419:       ? ` child-stderr=${childStderr.trim()}`\n420:       : '';\n421:     emitCompiledRoutingBreadcrumb(\n422:       `compiled-route subprocess failed for hub=${skillId}: ${error instanceof Error ? error.message : String(error)}${detail}`,\n423:     );\n424:     return undefined;\n425:   }\n426: }\n427: \n428: function enrichCompiledRoutes(\n429:   output: AdvisorRecommendOutput,\n430:   prompt: string,\n431:   workspaceRoot: string,\n432:   surfaceHint?: string,\n433:   topOnly = false,\n434: ): AdvisorRecommendOutput {\n435:   const mode = parseCompiledRoutingFlagMode(process.env.SPECKIT_COMPILED_ROUTING);\n436:   if (mode === 'invalid') {\n437:     emitCompiledRoutingBreadcrumb(\n438:       `ignoring invalid SPECKIT_COMPILED_ROUTING=${JSON.stringify(process.env.SPECKIT_COMPILED_ROUTING)}; serving legacy`,\n439:     );\n440:   }\n441:   // Only enrich hubs the flag permits. The default cohort now covers all 7\n442:   // compiled-eligible hubs (mirrors the runtime resolver's own default-on\n443:   // cohort), so unset attaches compiledRoute for those hubs; the kill-switch\n444:   // ('0'|'false'|'off') and invalid values still skip enrichment for every hub.\n445:   // Skip the schema re-parse entirely when nothing is eligible so the output is\n446:   // returned unchanged.\n447:   const anyEligible = output.recommendations.some((r) => compiledRoutingEnabledForHub(r.skillId));\n448:   if (!anyEligible) return output;\n449:   // A command row that already ranks in this result offers its command by itself,\n450:   // so the owning hub must not offer the same one again and spend a second slot on it.\n451:   const alreadyOffered = new Set<string>();\n452:   for (const recommendation of output.recommendations) {\n453:     if (recommendation.command) alreadyOffered.add(recommendation.command);\n454:   }\n455:   return AdvisorRecommendOutputSchema.parse({\n456:     ...output,\n457:     recommendations: output.recommendations.map((recommendation, index) => {\n458:       // Each lookup is a subprocess, so a caller that acts on the top pick alone\n459:       // pays for that one and no more.\n460:       if (topOnly && index > 0) return recommendation;\n461:       if (!compiledRoutingEnabledForHub(recommendation.skillId)) return recommendation;\n462:       const compiledRoute = compiledRouteForRecommendation(\n463:         recommendation.skillId,\n464:         prompt,\n465:         workspaceRoot,\n466:         surfaceHint,\n467:       );\n468:       if (!compiledRoute) return recommendation;\n469:       // The route answers which mode the hub would take; the command is what a reader\n470:       // types to run it, so it rides along only when the route names exactly one mode\n471:       // that has a command. A broader route leaves the key off rather than guessing.\n472:       const command = attachCommand(recommendation.skillId, compiledRoute, prompt);\n473:       return command && !alreadyOffered.has(command)\n474:         ? {\n475:           ...recommendation,\n476:           compiledRoute,\n477:           command,\n478:           ...(Object.hasOwn(TRACKED_COMMANDS, command) ? { policy: TRACKED_COMMANDS[command].policy } : {}),\n479:         }\n480:         : { ...recommendation, compiledRoute };\n481:     }),\n482:   });\n483: }\n484: \n485: // A typed command is the reader's own choice, so it outranks a routed mode: the\n486: // reader already named the command, and a compiled route only guesses which mode\n487: // they meant. The top recommendation carries it because that is the row a reader\n488: // acts on, and an unrelated top keeps the output it had.\n489: export function attachTypedCommand(\n490:   output: AdvisorRecommendOutput,\n491:   prompt: string,\n492: ): AdvisorRecommendOutput {\n493:   const top = output.recommendations[0];\n494:   if (!top) return output;\n495:   const typed = typedCommandForTop(top.skillId, prompt);\n496:   if (!typed) return output;\n497:   return AdvisorRecommendOutputSchema.parse({\n498:     ...output,\n499:     recommendations: [\n500:       {\n501:         ...top,\n502:         command: typed.command,\n503:         policy: typed.policy,\n504:         ownerSkillId: typed.ownerSkillId,\n505:       },\n506:       ...output.recommendations.slice(1),\n507:     ],\n508:   });\n509: }\n510: \n511: function publicShadowRecommendations(recommendations: readonly ScoredRecommendation[], topK: number): ShadowRecommendation[] {\n512:   const shadowRecommendations: ShadowRecommendation[] = [];\n513:   for (const recommendation of recommendations) {\n514:     const skillId = sanitizeSkillLabel(recommendation.skill);\n515:     if (!skillId) continue;\n516:     const shadowContributions = recommendation.laneContributions.map((lane) => ({\n517:       lane: lane.lane,\n518:       weightedScore: lane.rawScore * DEFAULT_SHADOW_SCORER_LANE_WEIGHTS[lane.lane],\n519:     }));\n520:     const shadowScore = roundScore(shadowContributions.reduce((total, lane) => total + lane.weightedScore, 0));\n521:     const dominant = shadowContributions\n522:       .filter((lane) => lane.weightedScore > 0)\n523:       .sort((left, right) => right.weightedScore - left.weightedScore)[0]?.lane ?? null;\n524:     shadowRecommendations.push({\n525:         skillId,\n526:         liveScore: recommendation.score,\n527:         shadowScore,\n528:         delta: roundScore(shadowScore - recommendation.score),\n529:         dominantShadowLane: dominant,\n530:     });\n531:   }\n532:   return shadowRecommendations\n533:     .sort((left, right) => right.shadowScore - left.shadowScore || left.skillId.localeCompare(right.skillId))\n534:     .slice(0, topK);\n535: }\n536: \n537: function roundScore(value: number): number {\n538:   return Math.round(value * 1_000_000) / 1_000_000;\n539: }\n540: \n541: // A semantic lane that fell back to phrase scoring still answers, so the reason\n542: // it declined travels as a warning rather than changing the recommendation.\n543: export function semanticLaneOffWarning(reason: string | null): string[] {\n544:   return reason ? [`semantic_lane_off:${reason}`] : [];\n545: }\n546: \n547: function outputWarnings(\n548:   status: AdvisorStatus,\n549:   result: ReturnType<typeof scoreAdvisorPrompt>,\n550:   semanticLaneOffReason: string | null,\n551: ): string[] {\n552:   const degradedLanes = result.metrics.degradedLanes ?? [];\n553:   return [\n554:     ...(status.freshness === 'stale' ? [status.trustState.reason ?? 'STALE_ADVISOR_FRESHNESS'] : []),\n555:     ...(degradedLanes.length > 0\n556:       ? [`runtime_degraded_lanes:${degradedLanes.join(',')}`]\n557:       : []),\n558:     ...semanticLaneOffWarning(semanticLaneOffReason),\n559:   ];\n560: }\n561: \n562: function outputAbstainReasons(\n563:   input: AdvisorRecommendInput,\n564:   result: ReturnType<typeof scoreAdvisorPrompt>,\n565: ): string[] {\n566:   if (!input.options?.includeAbstainReasons) return [];\n567:   return [\n568:     ...(result.unknown ? ['No recommendation passed confidence and uncertainty thresholds.'] : []),\n569:     ...(result.abstainReasons ?? []),\n570:   ];\n571: }\n572: \n573: // ───────────────────────────────────────────────────────────────────\n574: // 4. CORE LOGIC\n575: // ───────────────────────────────────────────────────────────────────\n576: \n577: async function computeRecommendationOutput(input: AdvisorRecommendInput): Promise<AdvisorRecommendOutput> {\n578:   // Canonicalize via realpath after the schema allowlist check.\n579:   const workspaceRoot = input.workspaceRoot\n580:     ? canonicalizeWorkspaceRoot(input.workspaceRoot)\n581:     : findWorkspaceRoot();\n582:   const effectiveThresholds = publicThresholds({\n583:     confidenceThreshold: input.options?.confidenceThreshold,\n584:     uncertaintyThreshold: input.options?.uncertaintyThreshold,\n585:   });\n586:   // Detect on-disk corruption here too: without it a malformed artifact reads\n587:   // 'live' from the generation counters and the recommend path would serve\n588:   // results as fresh. The verdict is cached per generation, so the quick_check\n589:   // runs at most once per rebuild rather than on every recommendation.\n590:   const status = renderableStatus(readAdvisorStatus({ workspaceRoot, checkArtifactIntegrity: true }));\n591:   if (status.freshness === 'unavailable') {\n592:     return unavailableOutput(status, workspaceRoot, effectiveThresholds);\n593:   }\n594:   if (status.freshness === 'absent') {\n595:     return absentOutput(status, workspaceRoot, effectiveThresholds);\n596:   }\n597:   const sourceSignature = cacheSourceSignature(status);\n598:   advisorPromptCache.invalidateSourceSignatureChange(sourceSignature);\n599:   const key = advisorPromptCache.makeKey({\n600:     canonicalPrompt: input.prompt.trim(),\n601:     sourceSignature,\n602:     workspaceRoot,\n603:     runtime: 'mcp',\n604:     maxTokens: input.options?.topK,\n605:     thresholdConfig: {\n606:       confidenceThreshold: input.options?.confidenceThreshold,\n607:       uncertaintyThreshold: input.options?.uncertaintyThreshold,\n608:       includeAttribution: input.options?.includeAttribution,\n609:       includeAbstainReasons: input.options?.includeAbstainReasons,\n610:     },\n611:   });\n612:   const cached = advisorPromptCache.get(key);\n613:   if (cached) {\n614:     const cachedOutput = cached.value as AdvisorRecommendOutput;\n615:     const parsedCachedOutput = AdvisorRecommendOutputSchema.parse({\n616:       ...cachedOutput,\n617:       workspaceRoot,\n618:       effectiveThresholds,\n619:       cache: {\n620:         ...cachedOutput.cache,\n621:         hit: true,\n622:       },\n623:     });\n624:     return attachTypedCommand(\n625:       input.options?.includeCompiledRoute === false\n626:         ? parsedCachedOutput\n627:         : enrichCompiledRoutes(parsedCachedOutput, input.prompt, workspaceRoot, input.options?.surfaceHint, input.options?.compiledRouteTopOnly === true),\n628:       input.prompt,\n629:     );\n630:   }\n631: \n632:   const topK = input.options?.topK ?? 3;\n633:   const result = await withSemanticShadowPromptEmbedding(input.prompt, () => scoreAdvisorPrompt(input.prompt, {\n634:     workspaceRoot,\n635:     confidenceThreshold: input.options?.confidenceThreshold,\n636:     uncertaintyThreshold: input.options?.uncertaintyThreshold,\n637:     runtimeLaneHealth: runtimeLaneHealthForStatus(status),\n638:   }));\n639:   // The lane records its health while the scored call runs, so the reason is\n640:   // read right after that call settles to describe this call's own fallback.\n641:   const semanticLaneOffReason = getSemanticShadowRuntimeHealth().disabledReason;\n642:   const recommendations = result.recommendations\n643:     .map((recommendation) => publicRecommendation(\n644:       recommendation,\n645:       Boolean(input.options?.includeAttribution),\n646:       input.prompt,\n647:     ))\n648:     .filter((recommendation): recommendation is NonNullable<typeof recommendation> => Boolean(recommendation))\n649:     .slice(0, topK);\n650:   const degradedLanes = result.metrics.degradedLanes ?? [];\n651:   const warnings = outputWarnings(status, result, semanticLaneOffReason);\n652:   const abstainReasons = outputAbstainReasons(input, result);\n653:   const output: AdvisorRecommendOutput = {\n654:     workspaceRoot,\n655:     effectiveThresholds,\n656:     recommendations,\n657:     ambiguous: result.ambiguous,\n658:     freshness: status.freshness,\n659:     trustState: status.trustState,\n660:     generatedAt: new Date().toISOString(),\n661:     cache: {\n662:       hit: false,\n663:       sourceSignaturePresent: status.generation > 0 || status.lastGenerationBump !== null,\n664:     },\n665:     _shadow: {\n666:       model: 'advisor-shadow-learned-weights-v1',\n667:       liveWeightsFrozen: true,\n668:       recommendations: publicShadowRecommendations(result.recommendations, topK),\n669:     },\n670:     ...(degradedLanes.length > 0 ? {\n671:       runtimeLaneHealth: {\n672:         liveLaneCount: result.metrics.liveLaneCount,\n673:         degradedLanes: [...degradedLanes],\n674:       },\n675:     } : {}),\n676:     ...(warnings.length > 0 ? { warnings } : {}),\n677:     ...(abstainReasons.length > 0 ? { abstainReasons } : {}),\n678:   };\n679:   const parsed = AdvisorRecommendOutputSchema.parse(output);\n680:   if (shadowDeltaSinkEnabled()) {\n681:     for (const shadow of parsed._shadow?.recommendations ?? []) {\n682:       recordShadowDelta({\n683:         prompt: `hmac:${key}`,\n684:         recommendation: shadow.skillId,\n685:         liveScore: shadow.liveScore,\n686:         shadowScore: shadow.shadowScore,\n687:         delta: shadow.delta,\n688:         dominantLane: shadow.dominantShadowLane,\n689:         timestamp: parsed.generatedAt,\n690:       });\n691:     }\n692:   }\n693:   advisorPromptCache.set({\n694:     key,\n695:     sourceSignature,\n696:     value: parsed,\n697:     skillLabels: recommendationLabels(parsed),\n698:   });\n699:   return attachTypedCommand(\n700:     input.options?.includeCompiledRoute === false\n701:       ? parsed\n702:       : enrichCompiledRoutes(parsed, input.prompt, workspaceRoot, input.options?.surfaceHint, input.options?.compiledRouteTopOnly === true),\n703:     input.prompt,\n704:   );\n705: }\n706: \n707: // ───────────────────────────────────────────────────────────────────\n708: // 5. EXPORTS\n709: // ───────────────────────────────────────────────────────────────────\n710: \n711: export async function handleAdvisorRecommend(args: unknown): Promise<HandlerResponse> {\n712:   const input = AdvisorRecommendInputSchema.parse(args);\n713:   // Canonicalize via realpath after the schema allowlist check.\n714:   const workspaceRoot = input.workspaceRoot\n715:     ? canonicalizeWorkspaceRoot(input.workspaceRoot)\n716:     : findWorkspaceRoot();\n717:   const effectiveThresholds = publicThresholds({\n718:     confidenceThreshold: input.options?.confidenceThreshold,\n719:     uncertaintyThreshold: input.options?.uncertaintyThreshold,\n720:   });\n721:   const disabledBy = ADVISOR_DISABLED_FLAGS.find((flag) => process.env[flag] === '1');\n722:   const data = disabledBy\n723:     ? disabledOutput(workspaceRoot, effectiveThresholds, disabledBy)\n724:     : await computeRecommendationOutput(input);\n725:   return {\n726:     content: [{\n727:       type: 'text',\n728:       text: JSON.stringify({ status: 'ok', data }, null, 2),\n729:     }],\n730:   };\n731: }\n732: ","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/handlers/advisor-recommend.ts, lines 1-732\n1: // ───────────────────────────────────────────────────────────────\n2: // MODULE: advisor_recommend Handler\n3: // ───────────────────────────────────────────────────────────────\n4: \n5: // ───────────────────────────────────────────────────────────────────\n6: // 1. IMPORTS\n7: // ───────────────────────────────────────────────────────────────────\n8: \n9: import { execFileSync } from 'node:child_process';\n10: import { readFileSync, realpathSync } from 'node:fs';\n11: import { resolve } from 'node:path';\n12: \n13: import { TRACKED_COMMANDS, attachCommand, commandRowFor, typedCommandForTop } from '../lib/command-attach.js';\n14: import { advisorPromptCache } from '../lib/prompt-cache.js';\n15: import {\n16:   resolveAdvisorThresholdConfig,\n17: } from '../lib/skill-advisor-brief.js';\n18: import { scoreAdvisorPrompt } from '../lib/scorer/fusion.js';\n19: import {\n20:   DEEP_ROUTING_PROJECTION_HASH,\n21:   MERGED_DEEP_SKILL_ID,\n22:   modeForAlias,\n23:   modeForPromptAlias,\n24: } from '../lib/scorer/aliases.js';\n25: import {\n26:   getSemanticShadowRuntimeHealth,\n27:   withSemanticShadowPromptEmbedding,\n28: } from '../lib/scorer/lanes/semantic-shadow.js';\n29: import { DEFAULT_SHADOW_SCORER_LANE_WEIGHTS } from '../lib/scorer/lane-registry.js';\n30: import { sanitizeSkillLabel } from '../lib/render.js';\n31: import { recordShadowDelta, shadowDeltaSinkEnabled } from '../lib/shadow/shadow-sink.js';\n32: import { findAdvisorWorkspaceRoot } from '../lib/utils/workspace-root.js';\n33: import {\n34:   AdvisorRecommendInputSchema,\n35:   AdvisorRecommendOutputSchema,\n36:   type AdvisorRecommendInput,\n37:   type AdvisorRecommendOutput,\n38: } from '../schemas/advisor-tool-schemas.js';\n39: import { readAdvisorStatus } from './advisor-status.js';\n40: import {\n41:   COMPILED_ROUTING_HUBS,\n42:   compiledRoutingEnabledForHub,\n43:   parseCompiledRoutingFlagMode,\n44: } from '../lib/compiled-routing-flag.js';\n45: import type { AdvisorScoringOptions } from '../lib/scorer/types.js';\n46: \n47: // ───────────────────────────────────────────────────────────────────\n48: // 2. TYPE DEFINITIONS\n49: // ───────────────────────────────────────────────────────────────────\n50: \n51: type HandlerResponse = { content: Array<{ type: string; text: string }> };\n52: type AdvisorStatus = ReturnType<typeof readAdvisorStatus>;\n53: type ScoredRecommendation = ReturnType<typeof scoreAdvisorPrompt>['recommendations'][number];\n54: type PublicRecommendationStatus = NonNullable<AdvisorRecommendOutput['recommendations'][number]['status']>;\n55: type PublicThresholds = AdvisorRecommendOutput['effectiveThresholds'];\n56: type ShadowRecommendation = NonNullable<AdvisorRecommendOutput['_shadow']>['recommendations'][number];\n57: \n58: // ───────────────────────────────────────────────────────────────────\n59: // 3. HELPERS\n60: // ───────────────────────────────────────────────────────────────────\n61: \n62: // Emit-only, stderr, debug-gated compiled-routing diagnostic. Never written to\n63: // stdout or the tool response, and never changes the recommendation outcome.\n64: function emitCompiledRoutingBreadcrumb(message: string): void {\n65:   if (process.env.SPECKIT_COMPILED_ROUTING_DEBUG) {\n66:     process.stderr.write(`[compiled-routing] ${message}\\n`);\n67:   }\n68: }\n69: \n70: function findWorkspaceRoot(start = process.cwd()): string {\n71:   return findAdvisorWorkspaceRoot(start, { maxDepth: 12 });\n72: }\n73: \n74: // Canonicalize a caller-supplied workspaceRoot via realpath.\n75: // The schema-level allowlist refinement runs against the same canonical\n76: // form, so a caller passing /tmp/symlink-to-repo gets the real path\n77: // post-symlink before downstream code uses it.\n78: function canonicalizeWorkspaceRoot(input: string): string {\n79:   const resolved = resolve(input);\n80:   try {\n81:     return realpathSync.native(resolved);\n82:   } catch {\n83:     return resolved;\n84:   }\n85: }\n86: \n87: function cacheSourceSignature(status: AdvisorStatus): string {\n88:   return `${status.freshness}:${status.generation}:${status.lastGenerationBump ?? 'never'}:${DEEP_ROUTING_PROJECTION_HASH}`;\n89: }\n90: \n91: function recommendationLabels(output: AdvisorRecommendOutput): string[] {\n92:   return output.recommendations.map((recommendation) => recommendation.skillId);\n93: }\n94: \n95: function unavailableTrustState(reason: string): AdvisorRecommendOutput['trustState'] {\n96:   return {\n97:     state: 'unavailable',\n98:     reason,\n99:     generation: 0,\n100:     checkedAt: new Date().toISOString(),\n101:     lastLiveAt: null,\n102:   };\n103: }\n104: \n105: function publicThresholds(args: {\n106:   confidenceThreshold?: number;\n107:   uncertaintyThreshold?: number;\n108: }): PublicThresholds {\n109:   const resolved = resolveAdvisorThresholdConfig(args);\n110:   return {\n111:     confidenceThreshold: resolved.confidenceThreshold,\n112:     uncertaintyThreshold: resolved.uncertaintyThreshold,\n113:     confidenceOnly: resolved.confidenceOnly,\n114:   };\n115: }\n116: \n117: function runtimeLaneHealthForStatus(status: AdvisorStatus): AdvisorScoringOptions['runtimeLaneHealth'] | undefined {\n118:   if (status.freshness !== 'stale') {\n119:     return undefined;\n120:   }\n121:   return {\n122:     graph_causal: {\n123:       status: 'runtime_degraded',\n124:       reason: status.trustState.reason ?? 'skill_graph_stale',\n125:     },\n126:   };\n127: }\n128: \n129: function renderableStatus(status: AdvisorStatus): AdvisorStatus {\n130:   const trustState = status.trustState.state;\n131:   if (status.freshness === 'unavailable' && (trustState === 'live' || trustState === 'stale')) {\n132:     return { ...status, freshness: trustState };\n133:   }\n134:   return status;\n135: }\n136: \n137: function emptyOutput(args: {\n138:   workspaceRoot: string;\n139:   effectiveThresholds: AdvisorRecommendOutput['effectiveThresholds'];\n140:   freshness: AdvisorRecommendOutput['freshness'];\n141:   trustState: AdvisorRecommendOutput['trustState'];\n142:   warnings?: readonly string[];\n143:   abstainReasons?: readonly string[];\n144: }): AdvisorRecommendOutput {\n145:   return AdvisorRecommendOutputSchema.parse({\n146:     workspaceRoot: args.workspaceRoot,\n147:     effectiveThresholds: args.effectiveThresholds,\n148:     recommendations: [],\n149:     ambiguous: false,\n150:     freshness: args.freshness,\n151:     trustState: args.trustState,\n152:     generatedAt: new Date().toISOString(),\n153:     cache: {\n154:       hit: false,\n155:       sourceSignaturePresent: false,\n156:     },\n157:     ...(args.warnings && args.warnings.length > 0 ? { warnings: [...args.warnings] } : {}),\n158:     ...(args.abstainReasons && args.abstainReasons.length > 0 ? { abstainReasons: [...args.abstainReasons] } : {}),\n159:   });\n160: }\n161: \n162: // The canonical flag is checked first so the reason names it when both are set.\n163: const ADVISOR_DISABLED_FLAGS = [\n164:   'SYSTEM_SKILL_ADVISOR_HOOK_DISABLED',\n165:   'SPECKIT_SKILL_ADVISOR_HOOK_DISABLED',\n166: ] as const;\n167: \n168: function disabledOutput(\n169:   workspaceRoot: string,\n170:   effectiveThresholds: PublicThresholds,\n171:   disabledBy: string,\n172: ): AdvisorRecommendOutput {\n173:   return emptyOutput({\n174:     workspaceRoot,\n175:     effectiveThresholds,\n176:     freshness: 'unavailable',\n177:     trustState: unavailableTrustState('ADVISOR_DISABLED'),\n178:     warnings: ['ADVISOR_DISABLED'],\n179:     abstainReasons: [`Skill advisor disabled by ${disabledBy}.`],\n180:   });\n181: }\n182: \n183: function absentOutput(\n184:   status: AdvisorStatus,\n185:   workspaceRoot: string,\n186:   effectiveThresholds: AdvisorRecommendOutput['effectiveThresholds'],\n187: ): AdvisorRecommendOutput {\n188:   return emptyOutput({\n189:     workspaceRoot,\n190:     effectiveThresholds,\n191:     freshness: 'absent',\n192:     trustState: status.trustState,\n193:     warnings: [status.trustState.reason ?? 'ADVISOR_FRESHNESS_ABSENT'],\n194:     abstainReasons: ['Skill advisor freshness is absent; returning fail-open empty recommendations.'],\n195:   });\n196: }\n197: \n198: function unavailableOutput(\n199:   status: AdvisorStatus,\n200:   workspaceRoot: string,\n201:   effectiveThresholds: AdvisorRecommendOutput['effectiveThresholds'],\n202: ): AdvisorRecommendOutput {\n203:   return emptyOutput({\n204:     workspaceRoot,\n205:     effectiveThresholds,\n206:     freshness: 'unavailable',\n207:     trustState: {\n208:       ...status.trustState,\n209:       state: 'unavailable',\n210:       reason: 'advisor_unavailable',\n211:     },\n212:     warnings: ['advisor_unavailable', ...(status.errors ?? [])],\n213:     abstainReasons: ['Skill advisor freshness is unavailable; returning fail-open empty recommendations.'],\n214:   });\n215: }\n216: \n217: function safeMany(values: readonly string[] | undefined): string[] {\n218:   return (values ?? [])\n219:     .map((value) => sanitizeSkillLabel(value))\n220:     .filter((value): value is string => Boolean(value));\n221: }\n222: \n223: function evidenceFeature(value: string): string {\n224:   const prefix = value.split(':', 1)[0];\n225:   switch (prefix) {\n226:     case 'phrase':\n227:       return 'phrase_match';\n228:     case 'token':\n229:       return 'token_match';\n230:     case 'hint':\n231:       return 'category_hint';\n232:     case 'derived':\n233:       return 'derived_skill_signal';\n234:     case 'doc':\n235:       return 'doc_reference_signal';\n236:     case 'cosine':\n237:       return 'semantic_similarity';\n238:     default:\n239:       if (value.includes('disambiguation')) return 'disambiguation_rule';\n240:       if (value.includes('surface')) return 'surface_signal';\n241:       if (value.includes('intent')) return 'intent_signal';\n242:       if (value.includes('loop')) return 'workflow_signal';\n243:       return 'scorer_signal';\n244:   }\n245: }\n246: \n247: function publicWhyRecommended(recommendation: ScoredRecommendation) {\n248:   const positiveLanes = recommendation.laneContributions\n249:     .filter((lane) => lane.rawScore > 0 || lane.weightedScore > 0)\n250:     .sort((left, right) => right.weightedScore - left.weightedScore)\n251:     .slice(0, 4);\n252:   const matchedSkillFeatures = positiveLanes.flatMap((lane) => (\n253:     Array.from(new Set(lane.evidence.map((entry) => evidenceFeature(entry)))).map((feature) => ({\n254:       lane: lane.lane,\n255:       feature,\n256:     }))\n257:   ));\n258:   const dominant = recommendation.dominantLane;\n259:   return {\n260:     reason: dominant\n261:       ? `Recommended from ranker signals: ${dominant} contributed the strongest live score.`\n262:       : 'Recommended from ranker signals without a single dominant live lane.',\n263:     dominantLane: dominant,\n264:     topLanes: positiveLanes.map((lane) => ({\n265:       lane: lane.lane,\n266:       rawScore: lane.rawScore,\n267:       weightedScore: lane.weightedScore,\n268:       weight: lane.weight,\n269:       shadowOnly: lane.shadowOnly,\n270:       evidenceTypes: Array.from(new Set(lane.evidence.map((entry) => evidenceFeature(entry)))),\n271:       evidenceCount: lane.evidence.length,\n272:     })),\n273:     matchedSkillFeatures,\n274:   };\n275: }\n276: \n277: // Doc evidence entries are skill-relative markdown paths emitted by the\n278: // derived lane as `doc:<path>`. The allowlist rejects anything that\n279: // could smuggle prompt content or path traversal into the response.\n280: const SAFE_DOC_PATH = /^(references|assets)\\/[A-Za-z0-9_./-]+\\.md$/;\n281: \n282: export function matchedDocsFromContributions(\n283:   recommendation: { readonly laneContributions: ReadonlyArray<{ readonly evidence: readonly string[] }> },\n284: ): string[] {\n285:   const docs: string[] = [];\n286:   for (const lane of recommendation.laneContributions) {\n287:     for (const entry of lane.evidence) {\n288:       if (!entry.startsWith('doc:')) continue;\n289:       const path = entry.slice(4);\n290:       if (!SAFE_DOC_PATH.test(path) || path.includes('..')) continue;\n291:       if (!docs.includes(path)) docs.push(path);\n292:       if (docs.length >= 3) return docs;\n293:     }\n294:   }\n295:   return docs;\n296: }\n297: \n298: function workflowModeForRecommendation(\n299:   recommendation: ScoredRecommendation,\n300:   prompt: string,\n301: ): string | undefined {\n302:   const directMode = modeForAlias(recommendation.skill);\n303:   const promptMode = recommendation.skill === MERGED_DEEP_SKILL_ID\n304:     ? modeForPromptAlias(prompt)\n305:     : null;\n306:   const workflowMode = sanitizeSkillLabel(directMode ?? promptMode ?? '');\n307:   return workflowMode || undefined;\n308: }\n309: \n310: function publicRecommendation(\n311:   recommendation: ScoredRecommendation,\n312:   includeAttribution: boolean,\n313:   prompt: string,\n314: ) {\n315:   const skillId = sanitizeSkillLabel(recommendation.skill);\n316:   if (!skillId) return null;\n317:   const commandRow = commandRowFor(recommendation.skill);\n318:   const matchedDocs = matchedDocsFromContributions(recommendation);\n319:   const redirectFrom = safeMany(recommendation.redirectFrom);\n320:   const redirectTo = sanitizeSkillLabel(recommendation.redirectTo ?? '');\n321:   const heldBelow = sanitizeSkillLabel(recommendation.heldBelow ?? '');\n322:   const sanitizedStatus = sanitizeSkillLabel(recommendation.lifecycleStatus);\n323:   const status: PublicRecommendationStatus | undefined = sanitizedStatus === 'active'\n324:     || sanitizedStatus === 'deprecated'\n325:     || sanitizedStatus === 'archived'\n326:     || sanitizedStatus === 'future'\n327:     ? sanitizedStatus as PublicRecommendationStatus\n328:     : undefined;\n329:   const workflowMode = workflowModeForRecommendation(recommendation, prompt);\n330:   return {\n331:     skillId,\n332:     kind: recommendation.kind,\n333:     score: recommendation.score,\n334:     confidence: recommendation.confidence,\n335:     uncertainty: recommendation.uncertainty,\n336:     dominantLane: recommendation.dominantLane,\n337:     ...(includeAttribution ? {\n338:       laneBreakdown: recommendation.laneContributions.map((lane) => ({\n339:         lane: lane.lane,\n340:         rawScore: lane.rawScore,\n341:         weightedScore: lane.weightedScore,\n342:         weight: lane.weight,\n343:         shadowOnly: lane.shadowOnly,\n344:       })),\n345:       why_recommended: publicWhyRecommended(recommendation),\n346:     } : {}),\n347:     ...(matchedDocs.length > 0 ? { matchedDocs } : {}),\n348:     ...(redirectFrom.length > 0 ? { redirectFrom } : {}),\n349:     ...(redirectTo ? { redirectTo } : {}),\n350:     // Hook briefs re-derive ambiguity from the public list, so a skill the typed\n351:     // command already ranked below its seed has to say so here.\n352:     ...(heldBelow ? { heldBelow } : {}),\n353:     ...(status ? { status } : {}),\n354:     ...(workflowMode ? { workflowMode } : {}),\n355:     // A command row is the contract a reader acts on, so its runnable string,\n356:     // policy and owner travel with the pick. An id with no row adds nothing.\n357:     ...(commandRow ? {\n358:       command: commandRow.command,\n359:       ...(commandRow.policy ? { policy: commandRow.policy } : {}),\n360:       ownerSkillId: commandRow.ownerSkillId,\n361:     } : {}),\n362:   };\n363: }\n364: \n365: // The front door runs from the request's workspaceRoot, and a caller may name\n366: // another checkout there, such as a worktree under the repository root. Its copy\n367: // can predate --prompt-stdin and would resolve an empty prompt, so such a copy\n368: // gets no compiled route rather than the prompt in argv.\n369: export function frontDoorReadsPromptFromStdin(frontDoorPath: string): boolean {\n370:   try {\n371:     return readFileSync(frontDoorPath, 'utf8').includes('--prompt-stdin');\n372:   } catch {\n373:     return false;\n374:   }\n375: }\n376: \n377: function compiledRouteForRecommendation(\n378:   skillId: string,\n379:   prompt: string,\n380:   workspaceRoot: string,\n381:   surfaceHint?: string,\n382: ): Record<string, unknown> | undefined {\n383:   if (!COMPILED_ROUTING_HUBS.has(skillId)) return undefined;\n384:   const frontDoor = resolve(workspaceRoot, '.skilled', 'bin', 'compiled-route.cjs');\n385:   if (!frontDoorReadsPromptFromStdin(frontDoor)) {\n386:     emitCompiledRoutingBreadcrumb(`compiled-route front door cannot read the prompt from stdin; skipping hub=${skillId}`);\n387:     return undefined;\n388:   }\n389:   try {\n390:     const args = [\n391:       frontDoor,\n392:       '--hub',\n393:       skillId,\n394:       '--prompt-stdin',\n395:     ];\n396:     // A hint the caller already holds is forwarded as its own argv element;\n397:     // the front door ignores a value that names no known surface.\n398:     if (surfaceHint) args.push('--surface-hint', surfaceHint);\n399:     const output = execFileSync(process.execPath, args, {\n400:       cwd: workspaceRoot,\n401:       encoding: 'utf8',\n402:       input: prompt,\n403:       stdio: ['pipe', 'pipe', 'pipe'],\n404:       timeout: 5_000,\n405:       maxBuffer: 1_048_576,\n406:     });\n407:     const parsed: unknown = JSON.parse(output.trim());\n408:     if (typeof parsed !== 'object' || parsed === null || Array.isArray(parsed)) {\n409:       return undefined;\n410:     }\n411:     const compiledRoute = parsed as Record<string, unknown>;\n412:     return compiledRoute.servingAuthority === 'legacy' ? undefined : compiledRoute;\n413:   } catch (error) {\n414:     // Surface the otherwise-silent fallback (debug-gated), including any child\n415:     // stderr the pipe above now captures instead of discarding. The served\n416:     // outcome is unchanged: a failed probe attaches no compiled route (legacy).\n417:     const childStderr = (error as { stderr?: unknown } | null)?.stderr;\n418:     const detail = typeof childStderr === 'string' && childStderr.trim()\n419:       ? ` child-stderr=${childStderr.trim()}`\n420:       : '';\n421:     emitCompiledRoutingBreadcrumb(\n422:       `compiled-route subprocess failed for hub=${skillId}: ${error instanceof Error ? error.message : String(error)}${detail}`,\n423:     );\n424:     return undefined;\n425:   }\n426: }\n427: \n428: function enrichCompiledRoutes(\n429:   output: AdvisorRecommendOutput,\n430:   prompt: string,\n431:   workspaceRoot: string,\n432:   surfaceHint?: string,\n433:   topOnly = false,\n434: ): AdvisorRecommendOutput {\n435:   const mode = parseCompiledRoutingFlagMode(process.env.SPECKIT_COMPILED_ROUTING);\n436:   if (mode === 'invalid') {\n437:     emitCompiledRoutingBreadcrumb(\n438:       `ignoring invalid SPECKIT_COMPILED_ROUTING=${JSON.stringify(process.env.SPECKIT_COMPILED_ROUTING)}; serving legacy`,\n439:     );\n440:   }\n441:   // Only enrich hubs the flag permits. The default cohort now covers all 7\n442:   // compiled-eligible hubs (mirrors the runtime resolver's own default-on\n443:   // cohort), so unset attaches compiledRoute for those hubs; the kill-switch\n444:   // ('0'|'false'|'off') and invalid values still skip enrichment for every hub.\n445:   // Skip the schema re-parse entirely when nothing is eligible so the output is\n446:   // returned unchanged.\n447:   const anyEligible = output.recommendations.some((r) => compiledRoutingEnabledForHub(r.skillId));\n448:   if (!anyEligible) return output;\n449:   // A command row that already ranks in this result offers its command by itself,\n450:   // so the owning hub must not offer the same one again and spend a second slot on it.\n451:   const alreadyOffered = new Set<string>();\n452:   for (const recommendation of output.recommendations) {\n453:     if (recommendation.command) alreadyOffered.add(recommendation.command);\n454:   }\n455:   return AdvisorRecommendOutputSchema.parse({\n456:     ...output,\n457:     recommendations: output.recommendations.map((recommendation, index) => {\n458:       // Each lookup is a subprocess, so a caller that acts on the top pick alone\n459:       // pays for that one and no more.\n460:       if (topOnly && index > 0) return recommendation;\n461:       if (!compiledRoutingEnabledForHub(recommendation.skillId)) return recommendation;\n462:       const compiledRoute = compiledRouteForRecommendation(\n463:         recommendation.skillId,\n464:         prompt,\n465:         workspaceRoot,\n466:         surfaceHint,\n467:       );\n468:       if (!compiledRoute) return recommendation;\n469:       // The route answers which mode the hub would take; the command is what a reader\n470:       // types to run it, so it rides along only when the route names exactly one mode\n471:       // that has a command. A broader route leaves the key off rather than guessing.\n472:       const command = attachCommand(recommendation.skillId, compiledRoute, prompt);\n473:       return command && !alreadyOffered.has(command)\n474:         ? {\n475:           ...recommendation,\n476:           compiledRoute,\n477:           command,\n478:           ...(Object.hasOwn(TRACKED_COMMANDS, command) ? { policy: TRACKED_COMMANDS[command].policy } : {}),\n479:         }\n480:         : { ...recommendation, compiledRoute };\n481:     }),\n482:   });\n483: }\n484: \n485: // A typed command is the reader's own choice, so it outranks a routed mode: the\n486: // reader already named the command, and a compiled route only guesses which mode\n487: // they meant. The top recommendation carries it because that is the row a reader\n488: // acts on, and an unrelated top keeps the output it had.\n489: export function attachTypedCommand(\n490:   output: AdvisorRecommendOutput,\n491:   prompt: string,\n492: ): AdvisorRecommendOutput {\n493:   const top = output.recommendations[0];\n494:   if (!top) return output;\n495:   const typed = typedCommandForTop(top.skillId, prompt);\n496:   if (!typed) return output;\n497:   return AdvisorRecommendOutputSchema.parse({\n498:     ...output,\n499:     recommendations: [\n500:       {\n501:         ...top,\n502:         command: typed.command,\n503:         policy: typed.policy,\n504:         ownerSkillId: typed.ownerSkillId,\n505:       },\n506:       ...output.recommendations.slice(1),\n507:     ],\n508:   });\n509: }\n510: \n511: function publicShadowRecommendations(recommendations: readonly ScoredRecommendation[], topK: number): ShadowRecommendation[] {\n512:   const shadowRecommendations: ShadowRecommendation[] = [];\n513:   for (const recommendation of recommendations) {\n514:     const skillId = sanitizeSkillLabel(recommendation.skill);\n515:     if (!skillId) continue;\n516:     const shadowContributions = recommendation.laneContributions.map((lane) => ({\n517:       lane: lane.lane,\n518:       weightedScore: lane.rawScore * DEFAULT_SHADOW_SCORER_LANE_WEIGHTS[lane.lane],\n519:     }));\n520:     const shadowScore = roundScore(shadowContributions.reduce((total, lane) => total + lane.weightedScore, 0));\n521:     const dominant = shadowContributions\n522:       .filter((lane) => lane.weightedScore > 0)\n523:       .sort((left, right) => right.weightedScore - left.weightedScore)[0]?.lane ?? null;\n524:     shadowRecommendations.push({\n525:         skillId,\n526:         liveScore: recommendation.score,\n527:         shadowScore,\n528:         delta: roundScore(shadowScore - recommendation.score),\n529:         dominantShadowLane: dominant,\n530:     });\n531:   }\n532:   return shadowRecommendations\n533:     .sort((left, right) => right.shadowScore - left.shadowScore || left.skillId.localeCompare(right.skillId))\n534:     .slice(0, topK);\n535: }\n536: \n537: function roundScore(value: number): number {\n538:   return Math.round(value * 1_000_000) / 1_000_000;\n539: }\n540: \n541: // A semantic lane that fell back to phrase scoring still answers, so the reason\n542: // it declined travels as a warning rather than changing the recommendation.\n543: export function semanticLaneOffWarning(reason: string | null): string[] {\n544:   return reason ? [`semantic_lane_off:${reason}`] : [];\n545: }\n546: \n547: function outputWarnings(\n548:   status: AdvisorStatus,\n549:   result: ReturnType<typeof scoreAdvisorPrompt>,\n550:   semanticLaneOffReason: string | null,\n551: ): string[] {\n552:   const degradedLanes = result.metrics.degradedLanes ?? [];\n553:   return [\n554:     ...(status.freshness === 'stale' ? [status.trustState.reason ?? 'STALE_ADVISOR_FRESHNESS'] : []),\n555:     ...(degradedLanes.length > 0\n556:       ? [`runtime_degraded_lanes:${degradedLanes.join(',')}`]\n557:       : []),\n558:     ...semanticLaneOffWarning(semanticLaneOffReason),\n559:   ];\n560: }\n561: \n562: function outputAbstainReasons(\n563:   input: AdvisorRecommendInput,\n564:   result: ReturnType<typeof scoreAdvisorPrompt>,\n565: ): string[] {\n566:   if (!input.options?.includeAbstainReasons) return [];\n567:   return [\n568:     ...(result.unknown ? ['No recommendation passed confidence and uncertainty thresholds.'] : []),\n569:     ...(result.abstainReasons ?? []),\n570:   ];\n571: }\n572: \n573: // ───────────────────────────────────────────────────────────────────\n574: // 4. CORE LOGIC\n575: // ───────────────────────────────────────────────────────────────────\n576: \n577: async function computeRecommendationOutput(input: AdvisorRecommendInput): Promise<AdvisorRecommendOutput> {\n578:   // Canonicalize via realpath after the schema allowlist check.\n579:   const workspaceRoot = input.workspaceRoot\n580:     ? canonicalizeWorkspaceRoot(input.workspaceRoot)\n581:     : findWorkspaceRoot();\n582:   const effectiveThresholds = publicThresholds({\n583:     confidenceThreshold: input.options?.confidenceThreshold,\n584:     uncertaintyThreshold: input.options?.uncertaintyThreshold,\n585:   });\n586:   // Detect on-disk corruption here too: without it a malformed artifact reads\n587:   // 'live' from the generation counters and the recommend path would serve\n588:   // results as fresh. The verdict is cached per generation, so the quick_check\n589:   // runs at most once per rebuild rather than on every recommendation.\n590:   const status = renderableStatus(readAdvisorStatus({ workspaceRoot, checkArtifactIntegrity: true }));\n591:   if (status.freshness === 'unavailable') {\n592:     return unavailableOutput(status, workspaceRoot, effectiveThresholds);\n593:   }\n594:   if (status.freshness === 'absent') {\n595:     return absentOutput(status, workspaceRoot, effectiveThresholds);\n596:   }\n597:   const sourceSignature = cacheSourceSignature(status);\n598:   advisorPromptCache.invalidateSourceSignatureChange(sourceSignature);\n599:   const key = advisorPromptCache.makeKey({\n600:     canonicalPrompt: input.prompt.trim(),\n601:     sourceSignature,\n602:     workspaceRoot,\n603:     runtime: 'mcp',\n604:     maxTokens: input.options?.topK,\n605:     thresholdConfig: {\n606:       confidenceThreshold: input.options?.confidenceThreshold,\n607:       uncertaintyThreshold: input.options?.uncertaintyThreshold,\n608:       includeAttribution: input.options?.includeAttribution,\n609:       includeAbstainReasons: input.options?.includeAbstainReasons,\n610:     },\n611:   });\n612:   const cached = advisorPromptCache.get(key);\n613:   if (cached) {\n614:     const cachedOutput = cached.value as AdvisorRecommendOutput;\n615:     const parsedCachedOutput = AdvisorRecommendOutputSchema.parse({\n616:       ...cachedOutput,\n617:       workspaceRoot,\n618:       effectiveThresholds,\n619:       cache: {\n620:         ...cachedOutput.cache,\n621:         hit: true,\n622:       },\n623:     });\n624:     return attachTypedCommand(\n625:       input.options?.includeCompiledRoute === false\n626:         ? parsedCachedOutput\n627:         : enrichCompiledRoutes(parsedCachedOutput, input.prompt, workspaceRoot, input.options?.surfaceHint, input.options?.compiledRouteTopOnly === true),\n628:       input.prompt,\n629:     );\n630:   }\n631: \n632:   const topK = input.options?.topK ?? 3;\n633:   const result = await withSemanticShadowPromptEmbedding(input.prompt, () => scoreAdvisorPrompt(input.prompt, {\n634:     workspaceRoot,\n635:     confidenceThreshold: input.options?.confidenceThreshold,\n636:     uncertaintyThreshold: input.options?.uncertaintyThreshold,\n637:     runtimeLaneHealth: runtimeLaneHealthForStatus(status),\n638:   }));\n639:   // The lane records its health while the scored call runs, so the reason is\n640:   // read right after that call settles to describe this call's own fallback.\n641:   const semanticLaneOffReason = getSemanticShadowRuntimeHealth().disabledReason;\n642:   const recommendations = result.recommendations\n643:     .map((recommendation) => publicRecommendation(\n644:       recommendation,\n645:       Boolean(input.options?.includeAttribution),\n646:       input.prompt,\n647:     ))\n648:     .filter((recommendation): recommendation is NonNullable<typeof recommendation> => Boolean(recommendation))\n649:     .slice(0, topK);\n650:   const degradedLanes = result.metrics.degradedLanes ?? [];\n651:   const warnings = outputWarnings(status, result, semanticLaneOffReason);\n652:   const abstainReasons = outputAbstainReasons(input, result);\n653:   const output: AdvisorRecommendOutput = {\n654:     workspaceRoot,\n655:     effectiveThresholds,\n656:     recommendations,\n657:     ambiguous: result.ambiguous,\n658:     freshness: status.freshness,\n659:     trustState: status.trustState,\n660:     generatedAt: new Date().toISOString(),\n661:     cache: {\n662:       hit: false,\n663:       sourceSignaturePresent: status.generation > 0 || status.lastGenerationBump !== null,\n664:     },\n665:     _shadow: {\n666:       model: 'advisor-shadow-learned-weights-v1',\n667:       liveWeightsFrozen: true,\n668:       recommendations: publicShadowRecommendations(result.recommendations, topK),\n669:     },\n670:     ...(degradedLanes.length > 0 ? {\n671:       runtimeLaneHealth: {\n672:         liveLaneCount: result.metrics.liveLaneCount,\n673:         degradedLanes: [...degradedLanes],\n674:       },\n675:     } : {}),\n676:     ...(warnings.length > 0 ? { warnings } : {}),\n677:     ...(abstainReasons.length > 0 ? { abstainReasons } : {}),\n678:   };\n679:   const parsed = AdvisorRecommendOutputSchema.parse(output);\n680:   if (shadowDeltaSinkEnabled()) {\n681:     for (const shadow of parsed._shadow?.recommendations ?? []) {\n682:       recordShadowDelta({\n683:         prompt: `hmac:${key}`,\n684:         recommendation: shadow.skillId,\n685:         liveScore: shadow.liveScore,\n686:         shadowScore: shadow.shadowScore,\n687:         delta: shadow.delta,\n688:         dominantLane: shadow.dominantShadowLane,\n689:         timestamp: parsed.generatedAt,\n690:       });\n691:     }\n692:   }\n693:   advisorPromptCache.set({\n694:     key,\n695:     sourceSignature,\n696:     value: parsed,\n697:     skillLabels: recommendationLabels(parsed),\n698:   });\n699:   return attachTypedCommand(\n700:     input.options?.includeCompiledRoute === false\n701:       ? parsed\n702:       : enrichCompiledRoutes(parsed, input.prompt, workspaceRoot, input.options?.surfaceHint, input.options?.compiledRouteTopOnly === true),\n703:     input.prompt,\n704:   );\n705: }\n706: \n707: // ───────────────────────────────────────────────────────────────────\n708: // 5. EXPORTS\n709: // ───────────────────────────────────────────────────────────────────\n710: \n711: export async function handleAdvisorRecommend(args: unknown): Promise<HandlerResponse> {\n712:   const input = AdvisorRecommendInputSchema.parse(args);\n713:   // Canonicalize via realpath after the schema allowlist check.\n714:   const workspaceRoot = input.workspaceRoot\n715:     ? canonicalizeWorkspaceRoot(input.workspaceRoot)\n716:     : findWorkspaceRoot();\n717:   const effectiveThresholds = publicThresholds({\n718:     confidenceThreshold: input.options?.confidenceThreshold,\n719:     uncertaintyThreshold: input.options?.uncertaintyThreshold,\n720:   });\n721:   const disabledBy = ADVISOR_DISABLED_FLAGS.find((flag) => process.env[flag] === '1');\n722:   const data = disabledBy\n723:     ? disabledOutput(workspaceRoot, effectiveThresholds, disabledBy)\n724:     : await computeRecommendationOutput(input);\n725:   return {\n726:     content: [{\n727:       type: 'text',\n728:       text: JSON.stringify({ status: 'ok', data }, null, 2),\n729:     }],\n730:   };\n731: }\n732: "}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/handlers/advisor-recommend.ts\"}"},"time":{"start":1794544730707,"end":1794544731136}}}}
