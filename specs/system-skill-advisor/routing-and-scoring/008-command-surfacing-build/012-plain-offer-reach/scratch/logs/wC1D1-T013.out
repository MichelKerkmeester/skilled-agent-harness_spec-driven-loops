or/runtime/lib/command-attach.ts b/.skilled/skills/system-skill-advisor/runtime/lib/command-attach.ts\nindex 39102f902a..c97eae45c2 100644\n--- a/.skilled/skills/system-skill-advisor/runtime/lib/command-attach.ts\n+++ b/.skilled/skills/system-skill-advisor/runtime/lib/command-attach.ts\n@@ -387,3 +387,13 @@ export function attachCommand(\n \n   return commands[workflowMode];\n }\n+\n+// A hub that withholds its command because the prompt names no single mode must\n+// still tell the reader why no command came with it, and only a hub whose modes\n+// map to commands withholds one.\n+export function routeNeedsMode(skillId: string, compiledRoute: unknown): boolean {\n+  const route = asRecord(compiledRoute);\n+  if (!route) return false;\n+  if (route.action !== 'defer' && route.action !== 'clarify') return false;\n+  return Object.prototype.hasOwnProperty.call(MODE_COMMANDS, skillId);\n+}\ndiff --git a/.skilled/skills/system-skill-advisor/runtime/tests/command-attach.vitest.ts b/.skilled/skills/system-skill-advisor/runtime/tests/command-attach.vitest.ts\nindex 64b8788035..b56d9c6d77 100644\n--- a/.skilled/skills/system-skill-advisor/runtime/tests/command-attach.vitest.ts\n+++ b/.skilled/skills/system-skill-advisor/runtime/tests/command-attach.vitest.ts\n@@ -22,6 +22,7 @@ import {\n   attachCommand,\n   DEPTH_WORDING,\n   MODE_COMMANDS,\n+  routeNeedsMode,\n   typedCommandForTop,\n   typedCommandIn,\n } from '../lib/command-attach.js';\n@@ -186,3 +187,20 @@ describe('typed command on the leading recommendation', () => {\n     expect(typedCommandForTop('sk-doc', '/speckit:resume cache work')).toBeUndefined();\n   });\n });\n+\n+// A route that holds back its command for want of a single mode is worth saying\n+// out loud, but only for a hub that had a command to withhold, so the flag does\n+// not fire for a deferral that never named a mode in the first place.\n+describe('a route that waits for a mode', () => {\n+  it('flags a defer or clarify on a hub whose modes map to commands', () => {\n+    expect(routeNeedsMode('system-deep-loop', { action: 'defer' })).toBe(true);\n+    expect(routeNeedsMode('sk-doc', { action: 'clarify' })).toBe(true);\n+  });\n+\n+  it('stays quiet for a routed mode, a hub outside the table and a shape that is no route', () => {\n+    expect(routeNeedsMode('sk-doc', singleRoute('sk-create-readme'))).toBe(false);\n+    expect(routeNeedsMode('sk-code', { action: 'defer' })).toBe(false);\n+    expect(routeNeedsMode('sk-doc', undefined)).toBe(false);\n+    expect(routeNeedsMode('sk-doc', ['defer'])).toBe(false);\n+  });\n+});\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"git -c core.fsmonitor=false diff --stat -- .skilled/skills/system-skill-advisor/runtime/lib/command-attach.ts .skilled/skills/system-skill-advisor/runtime/tests/command-attach.vitest.ts && git -c core.fsmonitor=false diff -- .skilled/skills/system-skill-advisor/runtime/lib/command-attach.ts .skilled/skills/system-skill-advisor/runtime/tests/command-attach.vitest.ts\",\"workdir\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research\"}"},"time":{"start":1794544441139,"end":1794544442194}}}}
