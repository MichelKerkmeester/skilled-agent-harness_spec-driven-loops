 },\n203:   '/doctor:deep-loop': { policy: 'run', ownerSkillId: 'system-deep-loop', scorerRow: true },\n204:   '/doctor:env list': { policy: 'run', ownerSkillId: 'system-skilled-doctor', scorerRow: true },\n205:   '/doctor:git hooks': { policy: 'ask', ownerSkillId: 'sk-git', scorerRow: true },\n206:   '/doctor:git setup': { policy: 'run', ownerSkillId: 'sk-git', scorerRow: true },\n207:   '/doctor:git standards': { policy: 'ask', ownerSkillId: 'sk-git', scorerRow: true },\n208:   '/doctor:helper': { policy: 'run', ownerSkillId: 'system-skilled-doctor', scorerRow: true },\n209:   '/doctor:install': { policy: 'run', ownerSkillId: 'system-skilled-doctor', scorerRow: true },\n210:   '/doctor:mcp debug': { policy: 'ask', ownerSkillId: 'system-skilled-doctor', scorerRow: true },\n211:   '/doctor:mcp install': { policy: 'ask', ownerSkillId: 'system-skilled-doctor', scorerRow: true },\n212:   '/doctor:overlay apply': { policy: 'ask', ownerSkillId: 'system-skilled-doctor', scorerRow: true },\n213:   '/doctor:overlay repin': { policy: 'ask', ownerSkillId: 'system-skilled-doctor', scorerRow: true },\n214:   '/doctor:overlay status': { policy: 'run', ownerSkillId: 'system-skilled-doctor', scorerRow: true },\n215:   '/doctor:runtime-mirrors': { policy: 'run', ownerSkillId: 'system-skilled-doctor', scorerRow: true },\n216:   '/doctor:setup': { policy: 'run', ownerSkillId: 'system-skilled-doctor', scorerRow: true },\n217:   '/doctor:sk-code quality': { policy: 'ask', ownerSkillId: 'sk-code', scorerRow: true },\n218:   '/doctor:sk-code setup': { policy: 'run', ownerSkillId: 'sk-code', scorerRow: true },\n219:   '/doctor:sk-skill check': { policy: 'run', ownerSkillId: 'sk-doc', scorerRow: true },\n220:   '/doctor:sk-skill convert': { policy: 'ask', ownerSkillId: 'sk-doc', scorerRow: true },\n221:   '/doctor:skill-advisor embedder': { policy: 'ask', ownerSkillId: 'system-skill-advisor', scorerRow: true },\n222:   '/doctor:skill-advisor parent-skill': { policy: 'run', ownerSkillId: 'system-skill-advisor', scorerRow: true },\n223:   '/doctor:skill-advisor rebuild': { policy: 'ask', ownerSkillId: 'system-skill-advisor', scorerRow: true },\n224:   '/doctor:skill-advisor router-reach': { policy: 'run', ownerSkillId: 'system-skill-advisor', scorerRow: true },\n225:   '/doctor:skill-advisor skill-budget': { policy: 'run', ownerSkillId: 'system-skill-advisor', scorerRow: true },\n226:   '/doctor:skill-advisor skill-graph-freshness': { policy: 'run', ownerSkillId: 'system-skill-advisor', scorerRow: true },\n227:   '/doctor:skill-advisor tune': { policy: 'ask', ownerSkillId: 'system-skill-advisor', scorerRow: true },\n228:   '/doctor:speckit': { policy: 'run', ownerSkillId: 'system-skilled-doctor', scorerRow: true },\n229:   '/doctor:symlink check': { policy: 'run', ownerSkillId: 'system-skilled-doctor', scorerRow: true },\n230:   '/doctor:symlink link': { policy: 'ask', ownerSkillId: 'system-skilled-doctor', scorerRow: true },\n231:   '/doctor:symlink unlink': { policy: 'ask', ownerSkillId: 'system-skilled-doctor', scorerRow: true },\n232:   '/doctor:update': { policy: 'ask', ownerSkillId: 'system-skilled-doctor', scorerRow: true },\n233:   '/prompt:improve': { policy: 'start', ownerSkillId: 'sk-prompt', scorerRow: true },\n234:   '/speckit:complete': { policy: 'start', ownerSkillId: 'system-spec-kit', scorerRow: true },\n235:   '/speckit:handoff': { policy: 'ask', ownerSkillId: 'system-spec-kit', scorerRow: true },\n236:   '/speckit:implement': { policy: 'start', ownerSkillId: 'system-spec-kit', scorerRow: true },\n237:   '/speckit:plan': { policy: 'start', ownerSkillId: 'system-spec-kit', scorerRow: true },\n238:   '/speckit:resume': { policy: 'start', ownerSkillId: 'system-spec-kit', scorerRow: true },\n239:   '/speckit:save': { policy: 'start', ownerSkillId: 'system-spec-kit', scorerRow: true },\n240:   '/speckit:search': { policy: 'run', ownerSkillId: 'system-spec-kit', scorerRow: true },\n241: };\n242: // END GENERATED COMMAND ROWS\n243: \n244: // The row for an id a recommendation carries, or undefined when that id names no\n245: // command. Own-key lookup because the table is generated data, so an inherited\n246: // name such as `constructor` must not resolve to a row nobody declared.\n247: export function commandRowFor(id: string): CommandRow | undefined {\n248:   return Object.hasOwn(COMMAND_ROWS, id) ? COMMAND_ROWS[id] : undefined;\n249: }\n250: \n251: // A typed command is the reader's own wording, so it counts only where a command\n252: // can start and where it ends on a boundary. That keeps a path such as\n253: // `docs/create:goal.md` and a prefix such as `/create:sk` from reading as a\n254: // command, and the longest key wins so `/create:skill-parent` is never reduced to\n255: // its `/create:skill` prefix.\n256: const COMMAND_START_BOUNDARY = /[\\s`'\"(]/;\n257: const COMMAND_CONTINUATION = /[a-z0-9_:-]/;\n258: \n259: export function typedCommandIn(prompt: string): string | undefined {\n260:   const lowered = prompt.toLowerCase();\n261:   let found: string | undefined;\n262:   for (const key of Object.keys(TRACKED_COMMANDS)) {\n263:     let index = lowered.indexOf(key);\n264:     while (index !== -1) {\n265:       const before = index === 0 ? '' : lowered[index - 1];\n266:       const after = lowered[index + key.length] ?? '';\n267:       const startsAtBoundary = before === '' || COMMAND_START_BOUNDARY.test(before);\n268:       const endsAtBoundary = after === '' || !COMMAND_CONTINUATION.test(after);\n269:       if (startsAtBoundary && endsAtBoundary) {\n270:         if (found === undefined || key.length > found.length) found = key;\n271:         break;\n272:       }\n273:       index = lowered.indexOf(key, index + 1);\n274:     }\n275:   }\n276:   return found;\n277: }\n278: \n279: // A typed command travels on the recommendation that leads, so it is delivered\n280: // only when the leading skill owns the command or carries the same command row.\n281: // A leading skill unrelated to the command must not carry it.\n282: export interface TypedCommand {\n283:   readonly command: string;\n284:   readonly policy: 'run' | 'start' | 'ask';\n285:   readonly ownerSkillId: string;\n286: }\n287: \n288: export function typedCommandForTop(topSkillId: string, prompt: string): TypedCommand | undefined {\n289:   const command = typedCommandIn(prompt);\n290:   if (command === undefined || !Object.hasOwn(TRACKED_COMMANDS, command)) return undefined;\n291:   const row = TRACKED_COMMANDS[command];\n292:   const sameCommandRow = commandRowFor(topSkillId)?.command === command;\n293:   if (topSkillId !== row.ownerSkillId && !sameCommandRow) return undefined;\n294:   return { command, policy: row.policy, ownerSkillId: row.ownerSkillId };\n295: }\n296: \n297: // Deep-loop commands open a long, multi-pass run, so one attached to a prompt\n298: // that merely mentions the topic spends the reader's budget on work they never\n299: // asked for. The list below is the vocabulary that counts as asking for it, and\n300: // it holds only effort wording: a bare topic word such as `research`, `review`\n301: // or `council` says what to look at, never how far to go, so it never qualifies\n302: // on its own.\n303: //\n304: // The phrases live in a data list, one per line, so the vocabulary a reviewer\n305: // has to judge stays visible and cheap to correct.\n306: export const DEPTH_WORDING: readonly string[] = [\n307:   'in depth',\n308:   'deep dive',\n309:   'deep research',\n310:   'deep review',\n311:   'thorough',\n312:   'thoroughly',\n313:   'exhaustive',\n314:   'iteratively',\n315:   'multiple passes',\n316:   'many passes',\n317:   'several passes',\n318:   'ask the council',\n319:   'convene',\n320:   'several models',\n321:   'final verdict',\n322:   'everything you can',\n323: ];\n324: \n325: // A phrase may carry punctuation a regex would read as a metacharacter, so it is\n326: // escaped before it is trusted as a pattern.\n327: function escapePhrase(phrase: string): string {\n328:   return phrase.replace(/[.*+?^${}()|[\\]\\\\]/g, '\\\\$&');\n329: }\n330: \n331: // One alternation over the list keeps the gate a single test per prompt, and the\n332: // boundary markers keep `thorough` from firing inside a longer word while a\n333: // multi-word phrase still has to match as a whole.\n334: const DEPTH_REQUEST = new RegExp(`\\\\b(?:${DEPTH_WORDING.map(escapePhrase).join('|')})\\\\b`);\n335: \n336: // A compiled route arrives as unvalidated JSON from a separate process, so the\n337: // shape is narrowed here rather than trusted. Arrays count as objects in\n338: // JavaScript and would let `action` read off an unrelated field, so they are\n339: // excluded explicitly.\n340: function asRecord(value: unknown): Record<string, unknown> | undefined {\n341:   if (typeof value !== 'object' || value === null || Array.isArray(value)) return undefined;\n342:   return value as Record<string, unknown>;\n343: }\n344: \n345: // The command for a hub's recommendation, or undefined when the route does not\n346: // single out one mode. Only a single-mode route names a command unambiguously:\n347: // a bundle or a multi-target route has more than one answer, and asking the\n348: // reader to pick belongs to the recommend path, not here. Never throws, because\n349: // a missing command must degrade to \"no command offered\" rather than break\n350: // routing. The prompt decides whether a costly deep-loop command is offered at\n351: // all: a reader who only asks about the topic gets no command, rather than one\n352: // that would launch work they never requested.\n353: export function attachCommand(\n354:   skillId: string,\n355:   compiledRoute: unknown,\n356:   prompt: string,\n357:   modeCommands: Readonly<Record<string, Readonly<Record<string, string>>>> = MODE_COMMANDS,\n358: ): string | undefined {\n359:   const route = asRecord(compiledRoute);\n360:   if (!route) return undefined;\n361:   if (route.action !== 'route' || route.selectionKind !== 'single') return undefined;\n362: \n363:   const targets = route.targets;\n364:   if (!Array.isArray(targets) || targets.length !== 1) return undefined;\n365: \n366:   const onlyTarget = asRecord(targets[0]);\n367:   if (!onlyTarget) return undefined;\n368: \n369:   const workflowMode = onlyTarget.workflowMode;\n370:   if (typeof workflowMode !== 'string' || workflowMode === '') return undefined;\n371: \n372:   // Own-key lookup on both levels: the table is data read from a generated\n373:   // object, so an inherited name such as `constructor` must not resolve to a\n374:   // command the hub never declared.\n375:   if (!Object.prototype.hasOwnProperty.call(modeCommands, skillId)) return undefined;\n376:   const commands = modeCommands[skillId];\n377:   if (!Object.prototype.hasOwnProperty.call(commands, workflowMode)) return undefined;\n378: \n379:   // Deep-loop commands are the ones that commit the reader to a long, multi-pass\n380:   // run, so they are offered only when the prompt asks for that effort. Typing\n381:   // the slash command is itself the ask, and every other hub answers a short\n382:   // question with a short answer, so no other skill consults the wording list.\n383:   if (skillId === 'system-deep-loop') {\n384:     const lowered = prompt.toLowerCase();\n385:     if (!lowered.includes('/deep:') && !DEPTH_REQUEST.test(lowered)) return undefined;\n386:   }\n387: \n388:   return commands[workflowMode];\n389: }"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/lib/command-attach.ts\"}"},"time":{"start":1794544385224,"end":1794544385724}}}}
{"type":"tool_use","timestamp":1794544385729,"sessionID":"ses_e2cd28fc2ffe49qc7vO3Rw7pSc","part":{"partID":"prt_1d32e3da1001rc7OHC4eWqOpK4","sessionID":"ses_e2cd28fc2ffe49qc7vO3Rw7pSc","messageID":"msg_1d32e2d81001TTUP0AH6nY6utM","type":"tool","id":"call_6afddc4337024e4a9a996171","tool":"read","state":{"status":"completed","input":{"path":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/tests/command-attach.vitest.ts"},"output":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/tests/command-attach.vitest.ts, lines 1-188\n1: // ───────────────────────────────────────────────────────────────\n2: // MODULE: Command attach for a hub recommendation\n3: // ───────────────────────────────────────────────────────────────\n4: \n5: // The advisor names the workflow mode a hub would route a prompt to, and\n6: // `attachCommand()` turns that mode into the slash command a reader can type.\n7: // The table it reads is generated from each hub's own command files, so these\n8: // tests assert the properties the generator has to keep — an own-key lookup on\n9: // both levels, and a real command file behind every row — rather than restating\n10: // today's rows, which would drift from the generator instead of catching it.\n11: //\n12: // The deep-loop gate is asserted on its own, because a command offered for a\n13: // prompt that never asked for that effort commits the reader to a long run they\n14: // did not request, and the prompt is the only thing that can tell the two apart.\n15: \n16: import { existsSync } from 'node:fs';\n17: import { join } from 'node:path';\n18: \n19: import { describe, expect, it } from 'vitest';\n20: \n21: import {\n22:   attachCommand,\n23:   DEPTH_WORDING,\n24:   MODE_COMMANDS,\n25:   typedCommandForTop,\n26:   typedCommandIn,\n27: } from '../lib/command-attach.js';\n28: import { findAdvisorWorkspaceRoot } from '../lib/utils/workspace-root.js';\n29: import { AdvisorRecommendationSchema } from '../schemas/advisor-tool-schemas.js';\n30: \n31: type ModeCommands = Readonly<Record<string, Readonly<Record<string, string>>>>;\n32: \n33: const REPO_ROOT = findAdvisorWorkspaceRoot(import.meta.dirname);\n34: \n35: // A slash command spelling that also names the file behind it, so a generated row\n36: // can be checked against the command tree rather than against a second copy of\n37: // itself.\n38: const COMMAND_ID = /^\\/([a-z][a-z0-9-]*):([a-z0-9-]+)$/;\n39: \n40: // The only route shape that can name a command unambiguously: one decision, one\n41: // selected target, so the target's mode is the answer.\n42: function singleRoute(workflowMode: string, overrides: Record<string, unknown> = {}): Record<string, unknown> {\n43:   return { action: 'route', selectionKind: 'single', targets: [{ workflowMode }], ...overrides };\n44: }\n45: \n46: // Distinct from what the generated table holds for the same hub and mode, so a\n47: // passing assertion proves the injected table was read rather than the real one.\n48: const INJECTED_COMMAND = '/injected:readme';\n49: const INJECTED: ModeCommands = { 'sk-doc': { 'sk-create-readme': INJECTED_COMMAND } };\n50: const OTHER_HUB: ModeCommands = { 'made-up-hub': { 'made-up-mode': '/made-up:command' } };\n51: \n52: // Wording that names a topic without asking for effort: no phrase in the effort\n53: // vocabulary, and no typed slash command.\n54: const PLAIN_PROMPT = 'how does the routing table pick a skill';\n55: \n56: describe('command attach for a single routed mode', () => {\n57:   it('names the command the routed mode maps to', () => {\n58:     // Any generated hub except the gated one, read at test time so the case\n59:     // follows a regenerated table instead of pinning one of its rows.\n60:     const generated = Object.entries(MODE_COMMANDS).find(([hub]) => hub !== 'system-deep-loop');\n61:     expect(generated, 'the generated table names a hub outside the depth gate').toBeDefined();\n62:     const [hub, modes] = generated as [string, Readonly<Record<string, string>>];\n63:     const [mode, command] = Object.entries(modes)[0] as [string, string];\n64:     expect(command).toBeTypeOf('string');\n65: \n66:     expect(attachCommand(hub, singleRoute(mode), 'add a readme')).toBe(command);\n67: \n68:     expect(attachCommand('sk-doc', singleRoute('sk-create-readme'), 'anything', INJECTED)).toBe(INJECTED_COMMAND);\n69:     expect(attachCommand('made-up-hub', singleRoute('made-up-mode'), 'anything', OTHER_HUB)).toBe('/made-up:command');\n70:   });\n71: \n72:   it('offers no command unless the route names exactly one mode the table holds', () => {\n73:     const rows: Array<[string, string, unknown]> = [\n74:       ['a multi-selection route', 'sk-doc', {\n75:         action: 'route', selectionKind: 'multi', targets: [{ workflowMode: 'sk-create-readme' }],\n76:       }],\n77:       ['an ask decision', 'sk-doc', {\n78:         action: 'ask', selectionKind: 'single', targets: [{ workflowMode: 'sk-create-readme' }],\n79:       }],\n80:       ['a route with two targets', 'sk-doc', {\n81:         action: 'route',\n82:         selectionKind: 'single',\n83:         targets: [{ workflowMode: 'sk-create-readme' }, { workflowMode: 'sk-create-benchmark' }],\n84:       }],\n85:       ['a mode the table does not hold', 'sk-doc', singleRoute('sk-create-benchmark')],\n86:       ['a hub the table does not hold', 'sk-git', singleRoute('sk-create-readme')],\n87:       ['no route at all', 'sk-doc', null],\n88:       ['a route that is an array', 'sk-doc', [singleRoute('sk-create-readme')]],\n89:       // An inherited name such as `constructor` is never a command the hub\n90:       // declared, so the lookup must read own keys at both levels.\n91:       ['a mode named after an inherited key', 'sk-doc', singleRoute('constructor')],\n92:       ['a hub named after an inherited key', 'constructor', singleRoute('sk-create-readme')],\n93:     ];\n94: \n95:     for (const [label, skillId, compiledRoute] of rows) {\n96:       expect(attachCommand(skillId, compiledRoute, PLAIN_PROMPT, INJECTED), label).toBeUndefined();\n97:     }\n98:     expect(attachCommand('constructor', singleRoute('constructor'), PLAIN_PROMPT), 'both levels inherited').toBeUndefined();\n99:   });\n100: \n101:   it('offers a deep-loop command only when the prompt asks for that effort', () => {\n102:     const plainIsQuiet = DEPTH_WORDING.every((phrase) => !PLAIN_PROMPT.toLowerCase().includes(phrase));\n103:     expect(plainIsQuiet, 'the effort-free probe prompt mentions no effort wording').toBe(true);\n104: \n105:     const modes = Object.entries(MODE_COMMANDS['system-deep-loop']);\n106:     expect(modes.length).toBeGreaterThan(0);\n107:     const [effortPhrase] = DEPTH_WORDING;\n108:     expect(effortPhrase).toBeTruthy();\n109: \n110:     for (const [mode, command] of modes) {\n111:       const route = singleRoute(mode);\n112:       expect(attachCommand('system-deep-loop', route, PLAIN_PROMPT), mode).toBeUndefined();\n113:       expect(attachCommand('system-deep-loop', route, `explain the scorer ${effortPhrase}`), mode).toBe(command);\n114:       expect(attachCommand('system-deep-loop', route, `run ${command} for me`), mode).toBe(command);\n115:     }\n116: \n117:     // The gate belongs to the deep-loop hub alone: every other hub answers the\n118:     // same effort-free prompt with its command.\n119:     expect(attachCommand('sk-doc', singleRoute('sk-create-benchmark'), PLAIN_PROMPT, INJECTED)).toBeUndefined();\n120:     expect(attachCommand('sk-doc', singleRoute('sk-create-readme'), PLAIN_PROMPT, INJECTED)).toBe(INJECTED_COMMAND);\n121:   });\n122: \n123:   it('stays quiet when a prompt only names a deep-loop mode by its topic', () => {\n124:     const topicOnly: ReadonlyArray<readonly [string, string]> = [\n125:       ['ai-council', 'What does the AI council mode do?'],\n126:       ['research', 'what is research mode?'],\n127:       ['review', 'how does the review mode work?'],\n128:     ];\n129:     for (const [mode, prompt] of topicOnly) {\n130:       expect(MODE_COMMANDS['system-deep-loop'], mode).toHaveProperty(mode);\n131:       expect(attachCommand('system-deep-loop', singleRoute(mode), prompt), prompt).toBeUndefined();\n132:     }\n133:     expect(attachCommand('system-deep-loop', singleRoute('ai-council'), 'ask the council whether to split billing'))\n134:       .toBe(MODE_COMMANDS['system-deep-loop']['ai-council']);\n135:   });\n136: \n137:   it('names a real command file behind every generated row', () => {\n138:     const hubs = Object.keys(MODE_COMMANDS);\n139:     expect(hubs.length).toBeGreaterThan(0);\n140: \n141:     for (const hub of hubs) {\n142:       const modes = Object.entries(MODE_COMMANDS[hub]);\n143:       expect(modes.length, hub).toBeGreaterThan(0);\n144:       for (const [mode, command] of modes) {\n145:         const label = `${hub} ${mode}: ${command}`;\n146:         const match = command.match(COMMAND_ID);\n147:         expect(match, label).not.toBeNull();\n148:         const [, namespace, name] = match as RegExpMatchArray;\n149:         expect(existsSync(join(REPO_ROOT, '.skilled', 'commands', namespace, `${name}.md`)), label).toBe(true);\n150:       }\n151:     }\n152:   });\n153: \n154:   it('accepts a named command on a recommendation and refuses an empty one', () => {\n155:     // Only the schema's required keys, so the object proves the command field is\n156:     // the one under test rather than something an unrelated field satisfied.\n157:     const minimal = {\n158:       skillId: 'sk-create-readme',\n159:       score: 1,\n160:       confidence: 0.9,\n161:       uncertainty: 0.1,\n162:       dominantLane: null,\n163:     };\n164: \n165:     expect(AdvisorRecommendationSchema.safeParse(minimal).success).toBe(true);\n166:     expect(AdvisorRecommendationSchema.safeParse({ ...minimal, command: '/create:readme' }).success).toBe(true);\n167:     expect(AdvisorRecommendationSchema.safeParse({ ...minimal, command: '' }).success).toBe(false);\n168:   });\n169: });\n170: \n171: // A typed command is the reader's own wording, so the match runs on boundaries\n172: // and prefers the longest key, and it is delivered only through the skill that\n173: // owns it or through a recommendation carrying the same command row.\n174: describe('typed command on the leading recommendation', () => {\n175:   it('reads the longest typed command at a command boundary', () => {\n176:     expect(typedCommandIn('/create:skill-parent deploy-hub with three modes')).toBe('/create:skill-parent');\n177:     expect(typedCommandIn('/create:sk')).toBeUndefined();\n178:     expect(typedCommandIn('see docs/create:goal.md')).toBeUndefined();\n179:   });\n180: \n181:   it('delivers a typed command through its owner or through the same command row', () => {\n182:     const expected = { command: '/speckit:resume', policy: 'start', ownerSkillId: 'system-spec-kit' };\n183: \n184:     expect(typedCommandForTop('system-spec-kit', '/speckit:resume cache work')).toEqual(expected);\n185:     expect(typedCommandForTop('command-speckit-resume', '/speckit:resume cache work')).toEqual(expected);\n186:     expect(typedCommandForTop('sk-doc', '/speckit:resume cache work')).toBeUndefined();\n187:   });\n188: });","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/tests/command-attach.vitest.ts, lines 1-188\n1: // ───────────────────────────────────────────────────────────────\n2: // MODULE: Command attach for a hub recommendation\n3: // ───────────────────────────────────────────────────────────────\n4: \n5: // The advisor names the workflow mode a hub would route a prompt to, and\n6: // `attachCommand()` turns that mode into the slash command a reader can type.\n7: // The table it reads is generated from each hub's own command files, so these\n8: // tests assert the properties the generator has to keep — an own-key lookup on\n9: // both levels, and a real command file behind every row — rather than restating\n10: // today's rows, which would drift from the generator instead of catching it.\n11: //\n12: // The deep-loop gate is asserted on its own, because a command offered for a\n13: // prompt that never asked for that effort commits the reader to a long run they\n14: // did not request, and the prompt is the only thing that can tell the two apart.\n15: \n16: import { existsSync } from 'node:fs';\n17: import { join } from 'node:path';\n18: \n19: import { describe, expect, it } from 'vitest';\n20: \n21: import {\n22:   attachCommand,\n23:   DEPTH_WORDING,\n24:   MODE_COMMANDS,\n25:   typedCommandForTop,\n26:   typedCommandIn,\n27: } from '../lib/command-attach.js';\n28: import { findAdvisorWorkspaceRoot } from '../lib/utils/workspace-root.js';\n29: import { AdvisorRecommendationSchema } from '../schemas/advisor-tool-schemas.js';\n30: \n31: type ModeCommands = Readonly<Record<string, Readonly<Record<string, string>>>>;\n32: \n33: const REPO_ROOT = findAdvisorWorkspaceRoot(import.meta.dirname);\n34: \n35: // A slash command spelling that also names the file behind it, so a generated row\n36: // can be checked against the command tree rather than against a second copy of\n37: // itself.\n38: const COMMAND_ID = /^\\/([a-z][a-z0-9-]*):([a-z0-9-]+)$/;\n39: \n40: // The only route shape that can name a command unambiguously: one decision, one\n41: // selected target, so the target's mode is the answer.\n42: function singleRoute(workflowMode: string, overrides: Record<string, unknown> = {}): Record<string, unknown> {\n43:   return { action: 'route', selectionKind: 'single', targets: [{ workflowMode }], ...overrides };\n44: }\n45: \n46: // Distinct from what the generated table holds for the same hub and mode, so a\n47: // passing assertion proves the injected table was read rather than the real one.\n48: const INJECTED_COMMAND = '/injected:readme';\n49: const INJECTED: ModeCommands = { 'sk-doc': { 'sk-create-readme': INJECTED_COMMAND } };\n50: const OTHER_HUB: ModeCommands = { 'made-up-hub': { 'made-up-mode': '/made-up:command' } };\n51: \n52: // Wording that names a topic without asking for effort: no phrase in the effort\n53: // vocabulary, and no typed slash command.\n54: const PLAIN_PROMPT = 'how does the routing table pick a skill';\n55: \n56: describe('command attach for a single routed mode', () => {\n57:   it('names the command the routed mode maps to', () => {\n58:     // Any generated hub except the gated one, read at test time so the case\n59:     // follows a regenerated table instead of pinning one of its rows.\n60:     const generated = Object.entries(MODE_COMMANDS).find(([hub]) => hub !== 'system-deep-loop');\n61:     expect(generated, 'the generated table names a hub outside the depth gate').toBeDefined();\n62:     const [hub, modes] = generated as [string, Readonly<Record<string, string>>];\n63:     const [mode, command] = Object.entries(modes)[0] as [string, string];\n64:     expect(command).toBeTypeOf('string');\n65: \n66:     expect(attachCommand(hub, singleRoute(mode), 'add a readme')).toBe(command);\n67: \n68:     expect(attachCommand('sk-doc', singleRoute('sk-create-readme'), 'anything', INJECTED)).toBe(INJECTED_COMMAND);\n69:     expect(attachCommand('made-up-hub', singleRoute('made-up-mode'), 'anything', OTHER_HUB)).toBe('/made-up:command');\n70:   });\n71: \n72:   it('offers no command unless the route names exactly one mode the table holds', () => {\n73:     const rows: Array<[string, string, unknown]> = [\n74:       ['a multi-selection route', 'sk-doc', {\n75:         action: 'route', selectionKind: 'multi', targets: [{ workflowMode: 'sk-create-readme' }],\n76:       }],\n77:       ['an ask decision', 'sk-doc', {\n78:         action: 'ask', selectionKind: 'single', targets: [{ workflowMode: 'sk-create-readme' }],\n79:       }],\n80:       ['a route with two targets', 'sk-doc', {\n81:         action: 'route',\n82:         selectionKind: 'single',\n83:         targets: [{ workflowMode: 'sk-create-readme' }, { workflowMode: 'sk-create-benchmark' }],\n84:       }],\n85:       ['a mode the table does not hold', 'sk-doc', singleRoute('sk-create-benchmark')],\n86:       ['a hub the table does not hold', 'sk-git', singleRoute('sk-create-readme')],\n87:       ['no route at all', 'sk-doc', null],\n88:       ['a route that is an array', 'sk-doc', [singleRoute('sk-create-readme')]],\n89:       // An inherited name such as `constructor` is never a command the hub\n90:       // declared, so the lookup must read own keys at both levels.\n91:       ['a mode named after an inherited key', 'sk-doc', singleRoute('constructor')],\n92:       ['a hub named after an inherited key', 'constructor', singleRoute('sk-create-readme')],\n93:     ];\n94: \n95:     for (const [label, skillId, compiledRoute] of rows) {\n96:       expect(attachCommand(skillId, compiledRoute, PLAIN_PROMPT, INJECTED), label).toBeUndefined();\n97:     }\n98:     expect(attachCommand('constructor', singleRoute('constructor'), PLAIN_PROMPT), 'both levels inherited').toBeUndefined();\n99:   });\n100: \n101:   it('offers a deep-loop command only when the prompt asks for that effort', () => {\n102:     const plainIsQuiet = DEPTH_WORDING.every((phrase) => !PLAIN_PROMPT.toLowerCase().includes(phrase));\n103:     expect(plainIsQuiet, 'the effort-free probe prompt mentions no effort wording').toBe(true);\n104: \n105:     const modes = Object.entries(MODE_COMMANDS['system-deep-loop']);\n106:     expect(modes.length).toBeGreaterThan(0);\n107:     const [effortPhrase] = DEPTH_WORDING;\n108:     expect(effortPhrase).toBeTruthy();\n109: \n110:     for (const [mode, command] of modes) {\n111:       const route = singleRoute(mode);\n112:       expect(attachCommand('system-deep-loop', route, PLAIN_PROMPT), mode).toBeUndefined();\n113:       expect(attachCommand('system-deep-loop', route, `explain the scorer ${effortPhrase}`), mode).toBe(command);\n114:       expect(attachCommand('system-deep-loop', route, `run ${command} for me`), mode).toBe(command);\n115:     }\n116: \n117:     // The gate belongs to the deep-loop hub alone: every other hub answers the\n118:     // same effort-free prompt with its command.\n119:     expect(attachCommand('sk-doc', singleRoute('sk-create-benchmark'), PLAIN_PROMPT, INJECTED)).toBeUndefined();\n120:     expect(attachCommand('sk-doc', singleRoute('sk-create-readme'), PLAIN_PROMPT, INJECTED)).toBe(INJECTED_COMMAND);\n121:   });\n122: \n123:   it('stays quiet when a prompt only names a deep-loop mode by its topic', () => {\n124:     const topicOnly: ReadonlyArray<readonly [string, string]> = [\n125:       ['ai-council', 'What does the AI council mode do?'],\n126:       ['research', 'what is research mode?'],\n127:       ['review', 'how does the review mode work?'],\n128:     ];\n129:     for (const [mode, prompt] of topicOnly) {\n130:       expect(MODE_COMMANDS['system-deep-loop'], mode).toHaveProperty(mode);\n131:       expect(attachCommand('system-deep-loop', singleRoute(mode), prompt), prompt).toBeUndefined();\n132:     }\n133:     expect(attachCommand('system-deep-loop', singleRoute('ai-council'), 'ask the council whether to split billing'))\n134:       .toBe(MODE_COMMANDS['system-deep-loop']['ai-council']);\n135:   });\n136: \n137:   it('names a real command file behind every generated row', () => {\n138:     const hubs = Object.keys(MODE_COMMANDS);\n139:     expect(hubs.length).toBeGreaterThan(0);\n140: \n141:     for (const hub of hubs) {\n142:       const modes = Object.entries(MODE_COMMANDS[hub]);\n143:       expect(modes.length, hub).toBeGreaterThan(0);\n144:       for (const [mode, command] of modes) {\n145:         const label = `${hub} ${mode}: ${command}`;\n146:         const match = command.match(COMMAND_ID);\n147:         expect(match, label).not.toBeNull();\n148:         const [, namespace, name] = match as RegExpMatchArray;\n149:         expect(existsSync(join(REPO_ROOT, '.skilled', 'commands', namespace, `${name}.md`)), label).toBe(true);\n150:       }\n151:     }\n152:   });\n153: \n154:   it('accepts a named command on a recommendation and refuses an empty one', () => {\n155:     // Only the schema's required keys, so the object proves the command field is\n156:     // the one under test rather than something an unrelated field satisfied.\n157:     const minimal = {\n158:       skillId: 'sk-create-readme',\n159:       score: 1,\n160:       confidence: 0.9,\n161:       uncertainty: 0.1,\n162:       dominantLane: null,\n163:     };\n164: \n165:     expect(AdvisorRecommendationSchema.safeParse(minimal).success).toBe(true);\n166:     expect(AdvisorRecommendationSchema.safeParse({ ...minimal, command: '/create:readme' }).success).toBe(true);\n167:     expect(AdvisorRecommendationSchema.safeParse({ ...minimal, command: '' }).success).toBe(false);\n168:   });\n169: });\n170: \n171: // A typed command is the reader's own wording, so the match runs on boundaries\n172: // and prefers the longest key, and it is delivered only through the skill that\n173: // owns it or through a recommendation carrying the same command row.\n174: describe('typed command on the leading recommendation', () => {\n175:   it('reads the longest typed command at a command boundary', () => {\n176:     expect(typedCommandIn('/create:skill-parent deploy-hub with three modes')).toBe('/create:skill-parent');\n177:     expect(typedCommandIn('/create:sk')).toBeUndefined();\n178:     expect(typedCommandIn('see docs/create:goal.md')).toBeUndefined();\n179:   });\n180: \n181:   it('delivers a typed command through its owner or through the same command row', () => {\n182:     const expected = { command: '/speckit:resume', policy: 'start', ownerSkillId: 'system-spec-kit' };\n183: \n184:     expect(typedCommandForTop('system-spec-kit', '/speckit:resume cache work')).toEqual(expected);\n185:     expect(typedCommandForTop('command-speckit-resume', '/speckit:resume cache work')).toEqual(expected);\n186:     expect(typedCommandForTop('sk-doc', '/speckit:resume cache work')).toBeUndefined();\n187:   });\n188: });"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/tests/command-attach.vitest.ts\"}"},"time":{"start":1794544385441,"end":1794544385729}}}}
