{"type":"tool_use","timestamp":1794544733328,"sessionID":"ses_e2ccd29f3ffe8vcrbGoR5Y3ujq","part":{"partID":"prt_1d3338955001IlMSJ4rzNYHLfw","sessionID":"ses_e2ccd29f3ffe8vcrbGoR5Y3ujq","messageID":"msg_1d33362a5001QdcwShW6nANtTI","type":"tool","id":"call_7bd3b2c93a9e494ea5e0fb60","tool":"read","state":{"status":"completed","input":{"path":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/lib/render.ts"},"output":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/lib/render.ts, lines 1-646\n1: // ───────────────────────────────────────────────────────────────\n2: // MODULE: Skill Advisor Brief Renderer\n3: // ───────────────────────────────────────────────────────────────\n4: \n5: import { canonicalFold } from './shared/unicode-normalization.js';\n6: import { resolvedConfidenceThreshold, resolvedUncertaintyThreshold } from './compat/contract.js';\n7: import {\n8:   buildAdvisorRenderPlan,\n9:   evaluateDeliveryState,\n10:   isObservedDeliveryReceipt,\n11:   observeRenderedAdvisorPolicy,\n12:   POLICY_COMMENT_HYGIENE_ID,\n13:   recordObservedPolicyDelivery,\n14:   ROUTE_ADVISOR_ID,\n15:   SHADOW_DELIVERY_STATE_MACHINE,\n16:   type DeliveryStateMachine,\n17:   type DeliveryStateReceipt,\n18:   type DeliveryStateName,\n19:   type DeliveryStateSignals,\n20: } from './policy-plan.js';\n21: import { commandRowFor } from './command-attach.js';\n22: import { isAmbiguousTopTwo } from './scorer/ambiguity.js';\n23: import type { AdvisorRecommendation } from './subprocess.js';\n24: import type { AdvisorScoredRecommendation } from './scorer/types.js';\n25: import type { AdvisorHookResult } from './skill-advisor-brief.js';\n26: \n27: // ───────────────────────────────────────────────────────────────\n28: // 1. TYPES\n29: // ───────────────────────────────────────────────────────────────\n30: \n31: export interface AdvisorBriefRenderOptions {\n32:   readonly tokenCap?: number;\n33:   readonly thresholdConfig?: {\n34:     readonly confidenceThreshold?: number;\n35:     readonly uncertaintyThreshold?: number;\n36:     readonly confidenceOnly?: boolean;\n37:   };\n38:   readonly deliveryState?: ShadowDeliveryRenderOptions;\n39:   /**\n40:    * True when prompts use set up, set-up or setup wording, install or reinstall wording\n41:    * including installation and installer, configure or configuration wording or `check`\n42:    * followed within three words by environment, env, config, hooks, tools, tooling,\n43:    * toolchain or skilled. The renderer never reads prompt text.\n44:    */\n45:   readonly setupWording?: boolean;\n46:   /**\n47:    * True when a dispatched child renders the brief. A child keeps the skill line\n48:    * but a command it must not start alone renders as parent-named only. Defaults\n49:    * to `AI_SESSION_CHILD === '1'`.\n50:    */\n51:   readonly childSession?: boolean;\n52: }\n53: \n54: export interface ShadowDeliveryRenderOptions extends DeliveryStateSignals {\n55:   readonly runtime?: string;\n56:   readonly candidate?: string | null;\n57:   readonly stateMachine?: DeliveryStateMachine;\n58:   readonly deliveryConfirmed?: boolean;\n59:   readonly receipt?: DeliveryStateReceipt;\n60:   readonly transformMessageIdentity?: string | null;\n61:   readonly onShadowLog?: (record: ShadowRouteOnlyLogRecord) => void;\n62: }\n63: \n64: export interface ShadowRouteOnlyLogRecord {\n65:   readonly shadowId: string;\n66:   readonly sessionKnown: boolean;\n67:   readonly epoch: number;\n68:   readonly policySetHash: string;\n69:   readonly routeState: DeliveryStateName | null;\n70:   readonly emittedByteCount: number;\n71:   readonly routeOnlyByteCount: number;\n72:   readonly savedBytes: number;\n73: }\n74: \n75: export interface AdvisorBriefRenderableResult {\n76:   readonly status: 'ok' | 'stale' | 'skipped' | 'degraded' | 'fail_open';\n77:   readonly freshness: 'live' | 'stale' | 'absent' | 'unavailable';\n78:   readonly recommendations: readonly AdvisorRecommendation[];\n79:   readonly ambiguous?: boolean;\n80:   readonly metrics?: {\n81:     readonly tokenCap?: number;\n82:   } | null;\n83:   readonly sharedPayload?: {\n84:     readonly metadata?: {\n85:       readonly skillLabel?: string | null;\n86:     } | null;\n87:   } | null;\n88: }\n89: \n90: export type AdvisorFallbackCase = 'outage' | 'no-match' | 'skipped';\n91: export type AdvisorFallbackClassification =\n92:   | {\n93:     readonly fallbackCase: 'outage';\n94:     readonly outageLabel: 'absent' | 'degraded' | 'fail_open';\n95:   }\n96:   | {\n97:     readonly fallbackCase: 'no-match' | 'skipped';\n98:   };\n99: \n100: // ───────────────────────────────────────────────────────────────\n101: // 2. CONSTANTS\n102: // ───────────────────────────────────────────────────────────────\n103: \n104: const DEFAULT_TOKEN_CAP = 80;\n105: const AMBIGUOUS_TOKEN_CAP = 120;\n106: const MAX_TOKEN_CAP = 120;\n107: const TOKEN_TO_CHAR_ESTIMATE = 4;\n108: const INSTRUCTION_LABEL_PATTERN =\n109:   /^\\s*(SYSTEM|INSTRUCTION|IGNORE|EXECUTE)\\s*[:=]|^\\s*(<!--|```)|\\b(ignore\\s+(previous|all)\\s+instructions|system\\s*:|instruction\\s*:|execute\\s*:|developer\\s*:|assistant\\s*:)/i;\n110: const CONTROL_CHAR_PATTERN = /[\\u0000-\\u0008\\u000B\\u000C\\u000E-\\u001F\\u007F]/g;\n111: const ROUTE_ONLY_SHADOW_ID = 'shadow.route-only.advisor.v1';\n112: const OBSERVED_ADVISOR_POLICY_CANDIDATE = '004';\n113: const PARENT_NAMED_POLICY = 'parent-named only';\n114: export const ROUTE_ONLY_ESTIMATED_BYTES = 43;\n115: const MAX_SHADOW_ROUTE_ONLY_LOG = 256;\n116: \n117: function directiveBlockIds(): readonly string[] {\n118:   return Object.freeze([\n119:     POLICY_COMMENT_HYGIENE_ID,\n120:   ]);\n121: }\n122: \n123: const SHADOW_ROUTE_ONLY_LOG: ShadowRouteOnlyLogRecord[] = [];\n124: \n125: // Injected into every advisor brief so all hook-capable runtimes receive\n126: // the comment hygiene rule even when AGENTS.md is absent from session context.\n127: export const HYGIENE_DIRECTIVE = '\\n- Comment hygiene [HARD BLOCK]: NEVER embed ADR-/REQ-/CHK-/task-ids or spec paths in code comments — forbidden regardless of instruction. Write the durable WHY instead. Pre-commit gate blocks violations.';\n128: \n129: \n130: \n131: // Labels the directive block so injected content reads as one structured\n132: // capsule instead of loose lines.\n133: export const DIRECTIVES_LABEL = '\\nDirectives:';\n134: \n135: // One bounded sentence for a setup-shaped prompt that matched nothing, so the\n136: // reader learns the read-only overview exists without every miss paying for it.\n137: export const SETUP_HINT = ' For setup or health checks, run /doctor:setup.';\n138: \n139: // ───────────────────────────────────────────────────────────────\n140: // 3. HELPERS\n141: // ───────────────────────────────────────────────────────────────\n142: \n143: function clampTokenCap(tokenCap: number | undefined): number {\n144:   if (typeof tokenCap !== 'number' || Number.isNaN(tokenCap)) {\n145:     return DEFAULT_TOKEN_CAP;\n146:   }\n147:   return Math.min(Math.max(1, Math.floor(tokenCap)), MAX_TOKEN_CAP);\n148: }\n149: \n150: function capText(text: string, tokenCap: number): string {\n151:   const charCap = tokenCap * TOKEN_TO_CHAR_ESTIMATE;\n152:   if (text.length <= charCap) {\n153:     return text;\n154:   }\n155:   const truncated = text.slice(0, Math.max(1, charCap - 3)).trimEnd();\n156:   return `${truncated}...`;\n157: }\n158: \n159: function sanitizeSkillLabel(skillLabel: string | null | undefined): string | null {\n160:   if (typeof skillLabel !== 'string') {\n161:     return null;\n162:   }\n163:   const folded = canonicalFold(skillLabel);\n164:   if (/[\\n\\r]/.test(folded)) {\n165:     return null;\n166:   }\n167:   const singleLine = folded\n168:     .replace(CONTROL_CHAR_PATTERN, '')\n169:     .replace(/\\s+/g, ' ')\n170:     .trim();\n171:   if (!singleLine || INSTRUCTION_LABEL_PATTERN.test(singleLine)) {\n172:     return null;\n173:   }\n174:   return singleLine;\n175: }\n176: \n177: const DOCTOR_BRIDGE_PREFIX = 'command-doctor-';\n178: \n179: function isDoctorBridgeId(skillId: string): boolean {\n180:   return skillId.startsWith(DOCTOR_BRIDGE_PREFIX);\n181: }\n182: \n183: /** Return the sanitized runnable command for a doctor bridge id, or null when unmapped. */\n184: export function doctorCommandString(skillId: string): string | null {\n185:   if (!isDoctorBridgeId(skillId)) {\n186:     return null;\n187:   }\n188:   const command = commandRowFor(skillId)?.command;\n189:   return command === undefined ? null : sanitizeSkillLabel(command);\n190: }\n191: \n192: // A dispatched child cannot ask its operator whether to start an interactive run\n193: // or one that writes, so only a read-only run stays fully visible there.\n194: function parentNamedOnly(policy: string | undefined, mutating: string | undefined): boolean {\n195:   if (policy === 'start' || policy === 'ask') {\n196:     return true;\n197:   }\n198:   return policy === 'run' && mutating !== 'read-only';\n199: }\n200: \n201: // The policy word is the only part of a command label a child replaces. The\n202: // command itself and its owner stay visible so the child can report what the\n203: // parent named.\n204: function policyWord(\n205:   policy: string | undefined,\n206:   mutating: string | undefined,\n207:   childSession: boolean,\n208: ): string | null {\n209:   if (policy === undefined) {\n210:     return null;\n211:   }\n212:   const word = sanitizeSkillLabel(policy);\n213:   if (word === null) {\n214:     return null;\n215:   }\n216:   return childSession && parentNamedOnly(policy, mutating) ? PARENT_NAMED_POLICY : word;\n217: }\n218: \n219: // A recommendation that names a command renders as the skill that owns it, the\n220: // runnable command and the policy that governs the run. The recommendation's own\n221: // fields stay authoritative and the generated row fills only what they omit, so a\n222: // caller that already resolved the command is never second-guessed.\n223: function commandLabel(recommendation: RenderableRecommendation, childSession: boolean): string | null {\n224:   const row = commandRowFor(recommendation.skill);\n225:   const command = recommendation.command ?? row?.command;\n226:   const owner = recommendation.ownerSkillId ?? row?.ownerSkillId ?? recommendation.skill;\n227:   const policy = recommendation.policy ?? row?.policy;\n228:   const commandPart = command === undefined ? null : sanitizeSkillLabel(command);\n229:   const ownerPart = sanitizeSkillLabel(owner);\n230:   if (!commandPart || !ownerPart) {\n231:     return null;\n232:   }\n233:   const policyPart = policyWord(policy, row?.mutating, childSession);\n234:   return policyPart === null\n235:     ? `${ownerPart} → ${commandPart}`\n236:     : `${ownerPart} → ${commandPart} (${policyPart})`;\n237: }\n238: \n239: // A doctor bridge renders as its runnable command and never as its raw id; an\n240: // unmapped doctor id renders nothing.\n241: function recommendationLabel(recommendation: RenderableRecommendation, childSession: boolean): string | null {\n242:   return commandLabel(recommendation, childSession)\n243:     ?? (isDoctorBridgeId(recommendation.skill)\n244:       ? doctorCommandString(recommendation.skill)\n245:       : sanitizeSkillLabel(recommendation.skill));\n246: }\n247: \n248: // The companion line normally shows only the runnable command. A child gets the\n249: // downgrade marker appended because that command must not be started there.\n250: function companionCommandLabel(skillId: string, childSession: boolean): string | null {\n251:   const command = doctorCommandString(skillId);\n252:   if (command === null) {\n253:     return null;\n254:   }\n255:   const row = commandRowFor(skillId);\n256:   return childSession && parentNamedOnly(row?.policy, row?.mutating)\n257:     ? `${command} (${PARENT_NAMED_POLICY})`\n258:     : command;\n259: }\n260: \n261: function formatScore(value: number): string {\n262:   return Number.isFinite(value) ? value.toFixed(2) : '0.00';\n263: }\n264: \n265: type RenderableRecommendation = AdvisorRecommendation & {\n266:   readonly score?: number;\n267:   readonly ambiguousWith?: readonly string[];\n268:   readonly heldBelow?: string;\n269: };\n270: \n271: function toScoredRecommendation(recommendation: RenderableRecommendation): AdvisorScoredRecommendation {\n272:   return {\n273:     skill: recommendation.skill,\n274:     kind: recommendation.kind === 'command' ? 'command' : 'skill',\n275:     confidence: recommendation.confidence,\n276:     uncertainty: recommendation.uncertainty,\n277:     passes_threshold: recommendation.passes_threshold ?? true,\n278:     reason: '',\n279:     score: typeof recommendation.score === 'number' && Number.isFinite(recommendation.score)\n280:       ? recommendation.score\n281:       : recommendation.confidence,\n282:     laneContributions: [],\n283:     dominantLane: null,\n284:     lifecycleStatus: 'active',\n285:     ...(Array.isArray(recommendation.ambiguousWith) ? { ambiguousWith: recommendation.ambiguousWith } : {}),\n286:     ...(typeof recommendation.heldBelow === 'string' ? { heldBelow: recommendation.heldBelow } : {}),\n287:   };\n288: }\n289: \n290: /**\n291:  * Detect whether the renderable recommendation set carries ambiguity evidence.\n292:  *\n293:  * `precomputedAmbiguous` carries the scorer's own verdict. It wins when defined: the\n294:  * scorer knows which skills a typed command held below the top and which only cleared\n295:  * a confidence floor, and serialized recommendations lose that context. Only when the\n296:  * caller has no verdict is ambiguity re-derived from the rendered fields.\n297:  */\n298: export function hasAdvisorAmbiguitySignal(\n299:   recommendations: readonly AdvisorRecommendation[],\n300:   precomputedAmbiguous?: boolean,\n301: ): boolean {\n302:   if (typeof precomputedAmbiguous === 'boolean') {\n303:     return precomputedAmbiguous;\n304:   }\n305:   return isAmbiguousTopTwo((recommendations as readonly RenderableRecommendation[]).map(toScoredRecommendation));\n306: }\n307: \n308: function metadataSkillLabel(result: AdvisorBriefRenderableResult): string | null {\n309:   const metadata = result.sharedPayload?.metadata;\n310:   return typeof metadata?.skillLabel === 'string' ? metadata.skillLabel : null;\n311: }\n312: \n313: /** Return only the advisor route block that the shadow path would retain. */\n314: export function renderRouteOnlyAdvisorBrief(rendered: string | null): string | null {\n315:   const routeBlock = buildAdvisorRenderPlan(rendered).blocks.find((block) => (\n316:     block.id === ROUTE_ADVISOR_ID\n317:   ));\n318:   return routeBlock?.content ?? null;\n319: }\n320: \n321: /** Read the append-only in-process shadow log without exposing route content. */\n322: export function getShadowRouteOnlyLog(): readonly ShadowRouteOnlyLogRecord[] {\n323:   return Object.freeze(SHADOW_ROUTE_ONLY_LOG.map((record) => ({ ...record })));\n324: }\n325: \n326: /** Clear shadow log entries between isolated evaluations. */\n327: export function clearShadowRouteOnlyLog(): void {\n328:   SHADOW_ROUTE_ONLY_LOG.length = 0;\n329: }\n330: \n331: function stateSignalsForBlock(options: ShadowDeliveryRenderOptions): ShadowDeliveryRenderOptions {\n332:   return {\n333:     ...options,\n334:     lifecycleEvent: undefined,\n335:     scopeChanged: false,\n336:     policySetChanged: false,\n337:     goalChanged: false,\n338:   };\n339: }\n340: \n341: function pushShadowRouteOnlyLog(record: ShadowRouteOnlyLogRecord): void {\n342:   if (SHADOW_ROUTE_ONLY_LOG.length >= MAX_SHADOW_ROUTE_ONLY_LOG) {\n343:     SHADOW_ROUTE_ONLY_LOG.shift();\n344:   }\n345:   SHADOW_ROUTE_ONLY_LOG.push(record);\n346: }\n347: \n348: function directiveBlocksSuppressed(\n349:   plan: ReturnType<typeof buildAdvisorRenderPlan>,\n350:   decisions: readonly ReturnType<typeof evaluateDeliveryState>[],\n351: ): boolean {\n352:   for (const expectedId of directiveBlockIds()) {\n353:     const blockIndex = plan.blocks.findIndex((block) => block.id === expectedId);\n354:     if (blockIndex === -1) {\n355:       return false;\n356:     }\n357:     const decision = decisions[blockIndex];\n358:     if (!decision || decision.state !== 'SUPPRESSED_SAME') {\n359:       return false;\n360:     }\n361:   }\n362:   return true;\n363: }\n364: \n365: function recordObservedBlockDeliveries(\n366:   plan: ReturnType<typeof buildAdvisorRenderPlan>,\n367:   shadowOptions: ShadowDeliveryRenderOptions,\n368:   machine: DeliveryStateMachine,\n369:   epoch: number,\n370: ): void {\n371:   const blockOptions = stateSignalsForBlock(shadowOptions);\n372:   for (const block of plan.blocks) {\n373:     const receipt = shadowOptions.receipt;\n374:     if (!isObservedDeliveryReceipt(receipt, block.contentHash, epoch)) {\n375:       continue;\n376:     }\n377:     machine.recordDelivery({\n378:       ...blockOptions,\n379:       blockId: block.id,\n380:       contentHash: block.contentHash,\n381:       receipt,\n382:     });\n383:   }\n384: }\n385: \n386: function observeShadowRouteOnly(\n387:   rendered: string | null,\n388:   options: ShadowDeliveryRenderOptions | undefined,\n389: ): void {\n390:   try {\n391:     const plan = buildAdvisorRenderPlan(rendered);\n392:     const shadowOptions = options ?? {};\n393:     const machine = shadowOptions.stateMachine ?? SHADOW_DELIVERY_STATE_MACHINE;\n394:     const epochSnapshot = machine.advanceForSignals(shadowOptions);\n395:     const blockOptions = stateSignalsForBlock(shadowOptions);\n396:     const decisions = plan.blocks.map((block) => evaluateDeliveryState({\n397:       ...blockOptions,\n398:       blockId: block.id,\n399:       contentHash: block.contentHash,\n400:     }, machine));\n401: \n402:     recordObservedBlockDeliveries(plan, shadowOptions, machine, epochSnapshot.epoch);\n403: \n404:     const routeIndex = plan.blocks.findIndex((block) => block.id === ROUTE_ADVISOR_ID);\n405:     const routeDecision = routeIndex === -1 ? null : decisions[routeIndex] ?? null;\n406:     const routeOnlyEligible = Boolean(\n407:       routeDecision?.routeOnlyEligible && directiveBlocksSuppressed(plan, decisions),\n408:     );\n409:     const routeOnly = routeOnlyEligible\n410:       ? renderRouteOnlyAdvisorBrief(rendered)\n411:       : null;\n412:     const emittedByteCount = rendered === null ? 0 : Buffer.byteLength(rendered, 'utf8');\n413:     const routeOnlyByteCount = routeOnly === null ? 0 : Buffer.byteLength(routeOnly, 'utf8');\n414:     const savedBytes = routeOnly === null\n415:       ? 0\n416:       : Math.max(0, emittedByteCount - routeOnlyByteCount);\n417:     const record: ShadowRouteOnlyLogRecord = Object.freeze({\n418:       shadowId: ROUTE_ONLY_SHADOW_ID,\n419:       sessionKnown: routeDecision?.sessionKnown ?? epochSnapshot.sessionKnown,\n420:       epoch: routeDecision?.epoch ?? epochSnapshot.epoch,\n421:       policySetHash: plan.policySetHash,\n422:       routeState: routeDecision?.state ?? null,\n423:       emittedByteCount,\n424:       routeOnlyByteCount,\n425:       savedBytes,\n426:     });\n427:     pushShadowRouteOnlyLog(record);\n428:     try {\n429:       options?.onShadowLog?.(record);\n430:     } catch {\n431:       // Observer callbacks must never affect the rendered advisor bytes.\n432:     }\n433:   } catch {\n434:     // Shadow measurement is fail-open so a throwing observer cannot block delivery.\n435:   }\n436: }\n437: \n438: function observeAdvisorPolicy(\n439:   rendered: string | null,\n440:   options: AdvisorBriefRenderOptions = {},\n441: ): void {\n442:   try {\n443:     observeRenderedAdvisorPolicy(rendered);\n444:   } catch {\n445:     // Shadow measurement is fail-open so a throwing observer cannot block delivery.\n446:   }\n447:   observeShadowRouteOnly(rendered, options.deliveryState);\n448: }\n449: \n450: /** Run the shadow planner for a runtime callback without changing its output. */\n451: export function observeShadowDelivery(\n452:   rendered: string | null,\n453:   deliveryState: ShadowDeliveryRenderOptions = {},\n454: ): void {\n455:   observeAdvisorPolicy(rendered, { deliveryState });\n456: }\n457: \n458: /**\n459:  * Record host-observed policy blocks after the runtime places them into the\n460:  * emitted response. Fail-open: recording errors never change emitted bytes.\n461:  */\n462: export function observeEmittedAdvisorPolicy(\n463:   rendered: string | null,\n464:   deliveryState: ShadowDeliveryRenderOptions = {},\n465: ): void {\n466:   try {\n467:     if (typeof rendered !== 'string' || rendered.length === 0) {\n468:       return;\n469:     }\n470:     const runtime = typeof deliveryState.runtime === 'string' && deliveryState.runtime.length > 0\n471:       ? deliveryState.runtime\n472:       : 'unknown';\n473:     const machine = deliveryState.stateMachine ?? SHADOW_DELIVERY_STATE_MACHINE;\n474:     const epoch = machine.currentEpoch(deliveryState);\n475:     const plan = buildAdvisorRenderPlan(rendered);\n476:     for (const block of plan.blocks) {\n477:       recordObservedPolicyDelivery({\n478:         runtime,\n479:         candidate: deliveryState.candidate ?? OBSERVED_ADVISOR_POLICY_CANDIDATE,\n480:         blockId: block.id,\n481:         content: block.content,\n482:         contentHash: block.contentHash,\n483:         lifecycleEpoch: epoch,\n484:         sessionId: deliveryState.sessionId,\n485:         sessionIdentity: deliveryState.sessionIdentity,\n486:         sessionIdentityConfirmed: deliveryState.sessionIdentityConfirmed,\n487:         sessionIdentityAmbiguous: deliveryState.sessionIdentityAmbiguous,\n488:         transformMessageIdentity: deliveryState.transformMessageIdentity ?? null,\n489:       });\n490:     }\n491:   } catch {\n492:     // Host observation is fail-open so a throwing sink cannot affect delivery.\n493:   }\n494: }\n495: \n496: // ───────────────────────────────────────────────────────────────\n497: // 4. CORE LOGIC\n498: // ───────────────────────────────────────────────────────────────\n499: \n500: /**\n501:  * Render the model-visible advisor brief from typed advisor output only.\n502:  *\n503:  * The renderer is the prompt-boundary guard: it ignores free-form reasons,\n504:  * descriptions, stdout/stderr, and prompt text, and emits nothing when the\n505:  * repository-authored skill label looks instruction-shaped after folding.\n506:  */\n507: export function renderAdvisorBrief(\n508:   result: AdvisorBriefRenderableResult,\n509:   options: AdvisorBriefRenderOptions = {},\n510: ): string | null {\n511:   if (result.status !== 'ok') {\n512:     observeAdvisorPolicy(null, options);\n513:     return null;\n514:   }\n515:   if (result.freshness !== 'live' && result.freshness !== 'stale') {\n516:     observeAdvisorPolicy(null, options);\n517:     return null;\n518:   }\n519: \n520:   const tokenCap = clampTokenCap(result.metrics?.tokenCap ?? options.tokenCap);\n521:   const thresholdConfig = options.thresholdConfig;\n522:   const childSession = options.childSession ?? process.env.AI_SESSION_CHILD === '1';\n523:   const recommendations = result.recommendations.filter((recommendation) => (\n524:     recommendation.passes_threshold === true\n525:     || (\n526:       recommendation.confidence >= (thresholdConfig?.confidenceThreshold ?? resolvedConfidenceThreshold())\n527:       && (\n528:         thresholdConfig?.confidenceOnly === true\n529:         || recommendation.uncertainty <= (thresholdConfig?.uncertaintyThreshold ?? resolvedUncertaintyThreshold())\n530:       )\n531:     )\n532:   ));\n533:   const [top, second] = recommendations;\n534:   if (!top) {\n535:     observeAdvisorPolicy(null, options);\n536:     return null;\n537:   }\n538: \n539:   const topLabel = commandLabel(top, childSession)\n540:     ?? (isDoctorBridgeId(top.skill)\n541:       ? doctorCommandString(top.skill)\n542:       : sanitizeSkillLabel(metadataSkillLabel(result) ?? top.skill));\n543:   if (!topLabel) {\n544:     observeAdvisorPolicy(null, options);\n545:     return null;\n546:   }\n547: \n548:   const companion = isDoctorBridgeId(top.skill)\n549:     ? undefined\n550:     : recommendations.slice(1).find((recommendation) => doctorCommandString(recommendation.skill) !== null);\n551:   const companionLabel = companion ? companionCommandLabel(companion.skill, childSession) : null;\n552:   const companionLine = (shownSecond: string | undefined): string => (\n553:     companionLabel && companion && companion.skill !== shownSecond ? `\\nAlso: ${companionLabel}` : ''\n554:   );\n555:   const capWithCompanion = (head: string, companionText: string, cap: number): string => {\n556:     const companionFits = head.length + companionText.length <= cap * TOKEN_TO_CHAR_ESTIMATE;\n557:     return `${capText(head, cap)}${companionFits ? companionText : ''}`;\n558:   };\n559: \n560:   const precomputedAmbiguous = typeof result.ambiguous === 'boolean' ? result.ambiguous : undefined;\n561:   if (tokenCap > DEFAULT_TOKEN_CAP && second && hasAdvisorAmbiguitySignal(recommendations, precomputedAmbiguous)) {\n562:     // The scorer names its own tie partners, which can sit below the second passing\n563:     // entry, so prefer a named partner and fall back to the second entry.\n564:     const namedPartners = (top as RenderableRecommendation).ambiguousWith;\n565:     const ambiguousWith: readonly string[] = Array.isArray(namedPartners) ? namedPartners : [];\n566:     const vs = (ambiguousWith.length > 0\n567:       ? recommendations.find((recommendation) => ambiguousWith.includes(recommendation.skill))\n568:       : undefined) ?? second;\n569:     const vsLabel = recommendationLabel(vs, childSession);\n570:     if (!vsLabel && !isDoctorBridgeId(vs.skill)) {\n571:       observeAdvisorPolicy(null, options);\n572:       return null;\n573:     }\n574:     if (vsLabel) {\n575:       const head = `Advisor: ${result.freshness}; ambiguous: ${topLabel} `\n576:         + `${formatScore(top.confidence)}/${formatScore(top.uncertainty)} vs ${vsLabel} `\n577:         + `${formatScore(vs.confidence)}/${formatScore(vs.uncertainty)} pass.`;\n578:       const rendered = capWithCompanion(\n579:         head,\n580:         companionLine(vs.skill),\n581:         Math.min(tokenCap, AMBIGUOUS_TOKEN_CAP),\n582:       ) + DIRECTIVES_LABEL + HYGIENE_DIRECTIVE;\n583:       observeAdvisorPolicy(rendered, options);\n584:       return rendered;\n585:     }\n586:   }\n587: \n588:   const head = `Advisor: ${result.freshness}; use ${topLabel} `\n589:     + `${formatScore(top.confidence)}/${formatScore(top.uncertainty)} pass.`;\n590:   const rendered = capWithCompanion(\n591:     head,\n592:     companionLine(undefined),\n593:     Math.min(tokenCap, DEFAULT_TOKEN_CAP),\n594:   ) + DIRECTIVES_LABEL + HYGIENE_DIRECTIVE;\n595:   observeAdvisorPolicy(rendered, options);\n596:   return rendered;\n597: }\n598: \n599: /** Classify a result with no brief; no result at all means the advisor did not answer. */\n600: export function advisorFallbackCase(\n601:   result?: Pick<AdvisorHookResult, 'status' | 'freshness'>,\n602: ): AdvisorFallbackClassification {\n603:   if (!result || result.status === 'fail_open' || result.freshness === 'absent'\n604:     || (result.freshness === 'unavailable' && result.status !== 'skipped')) {\n605:     return {\n606:       fallbackCase: 'outage',\n607:       outageLabel: result?.freshness === 'absent'\n608:         ? 'absent'\n609:         : result?.status === 'degraded'\n610:           ? 'degraded'\n611:           : 'fail_open',\n612:     };\n613:   }\n614:   if (result.status === 'skipped' && result.freshness === 'unavailable') {\n615:     return { fallbackCase: 'skipped' };\n616:   }\n617:   return { fallbackCase: 'no-match' };\n618: }\n619: \n620: /** Render the fallback status and directive block when no advisor brief is available. */\n621: export function renderAdvisorFallbackDirective(\n622:   options: AdvisorBriefRenderOptions = {},\n623:   result?: Pick<AdvisorHookResult, 'status' | 'freshness'>,\n624: ): string {\n625:   const classification = advisorFallbackCase(result);\n626:   const head = classification.fallbackCase === 'outage'\n627:     ? `Advisor: outage (${classification.outageLabel});${options.setupWording === true ? ' for setup or health checks, run /doctor:setup;' : ''} route by hand: node .skilled/bin/skill-advisor.cjs advisor_recommend --json '{\"prompt\":\"<request>\"}' --format json`\n628:     : classification.fallbackCase === 'skipped'\n629:       ? 'Advisor: prompt skipped.'\n630:       : options.setupWording === true\n631:         ? `Advisor: no skill matched.${SETUP_HINT}`\n632:         : 'Advisor: no skill matched.';\n633:   const rendered = head + DIRECTIVES_LABEL + HYGIENE_DIRECTIVE;\n634:   observeAdvisorPolicy(rendered, options);\n635:   return rendered;\n636: }\n637: \n638: /** Render the outage fallback used when advisor execution times out or is unavailable. */\n639: export function renderAdvisorTimeoutFallback(\n640:   options: AdvisorBriefRenderOptions = {},\n641:   status: Extract<AdvisorHookResult['status'], 'fail_open' | 'degraded'> = 'fail_open',\n642: ): string {\n643:   return renderAdvisorFallbackDirective(options, { status, freshness: 'unavailable' });\n644: }\n645: \n646: export { sanitizeSkillLabel };","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/lib/render.ts, lines 1-646\n1: // ───────────────────────────────────────────────────────────────\n2: // MODULE: Skill Advisor Brief Renderer\n3: // ───────────────────────────────────────────────────────────────\n4: \n5: import { canonicalFold } from './shared/unicode-normalization.js';\n6: import { resolvedConfidenceThreshold, resolvedUncertaintyThreshold } from './compat/contract.js';\n7: import {\n8:   buildAdvisorRenderPlan,\n9:   evaluateDeliveryState,\n10:   isObservedDeliveryReceipt,\n11:   observeRenderedAdvisorPolicy,\n12:   POLICY_COMMENT_HYGIENE_ID,\n13:   recordObservedPolicyDelivery,\n14:   ROUTE_ADVISOR_ID,\n15:   SHADOW_DELIVERY_STATE_MACHINE,\n16:   type DeliveryStateMachine,\n17:   type DeliveryStateReceipt,\n18:   type DeliveryStateName,\n19:   type DeliveryStateSignals,\n20: } from './policy-plan.js';\n21: import { commandRowFor } from './command-attach.js';\n22: import { isAmbiguousTopTwo } from './scorer/ambiguity.js';\n23: import type { AdvisorRecommendation } from './subprocess.js';\n24: import type { AdvisorScoredRecommendation } from './scorer/types.js';\n25: import type { AdvisorHookResult } from './skill-advisor-brief.js';\n26: \n27: // ───────────────────────────────────────────────────────────────\n28: // 1. TYPES\n29: // ───────────────────────────────────────────────────────────────\n30: \n31: export interface AdvisorBriefRenderOptions {\n32:   readonly tokenCap?: number;\n33:   readonly thresholdConfig?: {\n34:     readonly confidenceThreshold?: number;\n35:     readonly uncertaintyThreshold?: number;\n36:     readonly confidenceOnly?: boolean;\n37:   };\n38:   readonly deliveryState?: ShadowDeliveryRenderOptions;\n39:   /**\n40:    * True when prompts use set up, set-up or setup wording, install or reinstall wording\n41:    * including installation and installer, configure or configuration wording or `check`\n42:    * followed within three words by environment, env, config, hooks, tools, tooling,\n43:    * toolchain or skilled. The renderer never reads prompt text.\n44:    */\n45:   readonly setupWording?: boolean;\n46:   /**\n47:    * True when a dispatched child renders the brief. A child keeps the skill line\n48:    * but a command it must not start alone renders as parent-named only. Defaults\n49:    * to `AI_SESSION_CHILD === '1'`.\n50:    */\n51:   readonly childSession?: boolean;\n52: }\n53: \n54: export interface ShadowDeliveryRenderOptions extends DeliveryStateSignals {\n55:   readonly runtime?: string;\n56:   readonly candidate?: string | null;\n57:   readonly stateMachine?: DeliveryStateMachine;\n58:   readonly deliveryConfirmed?: boolean;\n59:   readonly receipt?: DeliveryStateReceipt;\n60:   readonly transformMessageIdentity?: string | null;\n61:   readonly onShadowLog?: (record: ShadowRouteOnlyLogRecord) => void;\n62: }\n63: \n64: export interface ShadowRouteOnlyLogRecord {\n65:   readonly shadowId: string;\n66:   readonly sessionKnown: boolean;\n67:   readonly epoch: number;\n68:   readonly policySetHash: string;\n69:   readonly routeState: DeliveryStateName | null;\n70:   readonly emittedByteCount: number;\n71:   readonly routeOnlyByteCount: number;\n72:   readonly savedBytes: number;\n73: }\n74: \n75: export interface AdvisorBriefRenderableResult {\n76:   readonly status: 'ok' | 'stale' | 'skipped' | 'degraded' | 'fail_open';\n77:   readonly freshness: 'live' | 'stale' | 'absent' | 'unavailable';\n78:   readonly recommendations: readonly AdvisorRecommendation[];\n79:   readonly ambiguous?: boolean;\n80:   readonly metrics?: {\n81:     readonly tokenCap?: number;\n82:   } | null;\n83:   readonly sharedPayload?: {\n84:     readonly metadata?: {\n85:       readonly skillLabel?: string | null;\n86:     } | null;\n87:   } | null;\n88: }\n89: \n90: export type AdvisorFallbackCase = 'outage' | 'no-match' | 'skipped';\n91: export type AdvisorFallbackClassification =\n92:   | {\n93:     readonly fallbackCase: 'outage';\n94:     readonly outageLabel: 'absent' | 'degraded' | 'fail_open';\n95:   }\n96:   | {\n97:     readonly fallbackCase: 'no-match' | 'skipped';\n98:   };\n99: \n100: // ───────────────────────────────────────────────────────────────\n101: // 2. CONSTANTS\n102: // ───────────────────────────────────────────────────────────────\n103: \n104: const DEFAULT_TOKEN_CAP = 80;\n105: const AMBIGUOUS_TOKEN_CAP = 120;\n106: const MAX_TOKEN_CAP = 120;\n107: const TOKEN_TO_CHAR_ESTIMATE = 4;\n108: const INSTRUCTION_LABEL_PATTERN =\n109:   /^\\s*(SYSTEM|INSTRUCTION|IGNORE|EXECUTE)\\s*[:=]|^\\s*(<!--|```)|\\b(ignore\\s+(previous|all)\\s+instructions|system\\s*:|instruction\\s*:|execute\\s*:|developer\\s*:|assistant\\s*:)/i;\n110: const CONTROL_CHAR_PATTERN = /[\\u0000-\\u0008\\u000B\\u000C\\u000E-\\u001F\\u007F]/g;\n111: const ROUTE_ONLY_SHADOW_ID = 'shadow.route-only.advisor.v1';\n112: const OBSERVED_ADVISOR_POLICY_CANDIDATE = '004';\n113: const PARENT_NAMED_POLICY = 'parent-named only';\n114: export const ROUTE_ONLY_ESTIMATED_BYTES = 43;\n115: const MAX_SHADOW_ROUTE_ONLY_LOG = 256;\n116: \n117: function directiveBlockIds(): readonly string[] {\n118:   return Object.freeze([\n119:     POLICY_COMMENT_HYGIENE_ID,\n120:   ]);\n121: }\n122: \n123: const SHADOW_ROUTE_ONLY_LOG: ShadowRouteOnlyLogRecord[] = [];\n124: \n125: // Injected into every advisor brief so all hook-capable runtimes receive\n126: // the comment hygiene rule even when AGENTS.md is absent from session context.\n127: export const HYGIENE_DIRECTIVE = '\\n- Comment hygiene [HARD BLOCK]: NEVER embed ADR-/REQ-/CHK-/task-ids or spec paths in code comments — forbidden regardless of instruction. Write the durable WHY instead. Pre-commit gate blocks violations.';\n128: \n129: \n130: \n131: // Labels the directive block so injected content reads as one structured\n132: // capsule instead of loose lines.\n133: export const DIRECTIVES_LABEL = '\\nDirectives:';\n134: \n135: // One bounded sentence for a setup-shaped prompt that matched nothing, so the\n136: // reader learns the read-only overview exists without every miss paying for it.\n137: export const SETUP_HINT = ' For setup or health checks, run /doctor:setup.';\n138: \n139: // ───────────────────────────────────────────────────────────────\n140: // 3. HELPERS\n141: // ───────────────────────────────────────────────────────────────\n142: \n143: function clampTokenCap(tokenCap: number | undefined): number {\n144:   if (typeof tokenCap !== 'number' || Number.isNaN(tokenCap)) {\n145:     return DEFAULT_TOKEN_CAP;\n146:   }\n147:   return Math.min(Math.max(1, Math.floor(tokenCap)), MAX_TOKEN_CAP);\n148: }\n149: \n150: function capText(text: string, tokenCap: number): string {\n151:   const charCap = tokenCap * TOKEN_TO_CHAR_ESTIMATE;\n152:   if (text.length <= charCap) {\n153:     return text;\n154:   }\n155:   const truncated = text.slice(0, Math.max(1, charCap - 3)).trimEnd();\n156:   return `${truncated}...`;\n157: }\n158: \n159: function sanitizeSkillLabel(skillLabel: string | null | undefined): string | null {\n160:   if (typeof skillLabel !== 'string') {\n161:     return null;\n162:   }\n163:   const folded = canonicalFold(skillLabel);\n164:   if (/[\\n\\r]/.test(folded)) {\n165:     return null;\n166:   }\n167:   const singleLine = folded\n168:     .replace(CONTROL_CHAR_PATTERN, '')\n169:     .replace(/\\s+/g, ' ')\n170:     .trim();\n171:   if (!singleLine || INSTRUCTION_LABEL_PATTERN.test(singleLine)) {\n172:     return null;\n173:   }\n174:   return singleLine;\n175: }\n176: \n177: const DOCTOR_BRIDGE_PREFIX = 'command-doctor-';\n178: \n179: function isDoctorBridgeId(skillId: string): boolean {\n180:   return skillId.startsWith(DOCTOR_BRIDGE_PREFIX);\n181: }\n182: \n183: /** Return the sanitized runnable command for a doctor bridge id, or null when unmapped. */\n184: export function doctorCommandString(skillId: string): string | null {\n185:   if (!isDoctorBridgeId(skillId)) {\n186:     return null;\n187:   }\n188:   const command = commandRowFor(skillId)?.command;\n189:   return command === undefined ? null : sanitizeSkillLabel(command);\n190: }\n191: \n192: // A dispatched child cannot ask its operator whether to start an interactive run\n193: // or one that writes, so only a read-only run stays fully visible there.\n194: function parentNamedOnly(policy: string | undefined, mutating: string | undefined): boolean {\n195:   if (policy === 'start' || policy === 'ask') {\n196:     return true;\n197:   }\n198:   return policy === 'run' && mutating !== 'read-only';\n199: }\n200: \n201: // The policy word is the only part of a command label a child replaces. The\n202: // command itself and its owner stay visible so the child can report what the\n203: // parent named.\n204: function policyWord(\n205:   policy: string | undefined,\n206:   mutating: string | undefined,\n207:   childSession: boolean,\n208: ): string | null {\n209:   if (policy === undefined) {\n210:     return null;\n211:   }\n212:   const word = sanitizeSkillLabel(policy);\n213:   if (word === null) {\n214:     return null;\n215:   }\n216:   return childSession && parentNamedOnly(policy, mutating) ? PARENT_NAMED_POLICY : word;\n217: }\n218: \n219: // A recommendation that names a command renders as the skill that owns it, the\n220: // runnable command and the policy that governs the run. The recommendation's own\n221: // fields stay authoritative and the generated row fills only what they omit, so a\n222: // caller that already resolved the command is never second-guessed.\n223: function commandLabel(recommendation: RenderableRecommendation, childSession: boolean): string | null {\n224:   const row = commandRowFor(recommendation.skill);\n225:   const command = recommendation.command ?? row?.command;\n226:   const owner = recommendation.ownerSkillId ?? row?.ownerSkillId ?? recommendation.skill;\n227:   const policy = recommendation.policy ?? row?.policy;\n228:   const commandPart = command === undefined ? null : sanitizeSkillLabel(command);\n229:   const ownerPart = sanitizeSkillLabel(owner);\n230:   if (!commandPart || !ownerPart) {\n231:     return null;\n232:   }\n233:   const policyPart = policyWord(policy, row?.mutating, childSession);\n234:   return policyPart === null\n235:     ? `${ownerPart} → ${commandPart}`\n236:     : `${ownerPart} → ${commandPart} (${policyPart})`;\n237: }\n238: \n239: // A doctor bridge renders as its runnable command and never as its raw id; an\n240: // unmapped doctor id renders nothing.\n241: function recommendationLabel(recommendation: RenderableRecommendation, childSession: boolean): string | null {\n242:   return commandLabel(recommendation, childSession)\n243:     ?? (isDoctorBridgeId(recommendation.skill)\n244:       ? doctorCommandString(recommendation.skill)\n245:       : sanitizeSkillLabel(recommendation.skill));\n246: }\n247: \n248: // The companion line normally shows only the runnable command. A child gets the\n249: // downgrade marker appended because that command must not be started there.\n250: function companionCommandLabel(skillId: string, childSession: boolean): string | null {\n251:   const command = doctorCommandString(skillId);\n252:   if (command === null) {\n253:     return null;\n254:   }\n255:   const row = commandRowFor(skillId);\n256:   return childSession && parentNamedOnly(row?.policy, row?.mutating)\n257:     ? `${command} (${PARENT_NAMED_POLICY})`\n258:     : command;\n259: }\n260: \n261: function formatScore(value: number): string {\n262:   return Number.isFinite(value) ? value.toFixed(2) : '0.00';\n263: }\n264: \n265: type RenderableRecommendation = AdvisorRecommendation & {\n266:   readonly score?: number;\n267:   readonly ambiguousWith?: readonly string[];\n268:   readonly heldBelow?: string;\n269: };\n270: \n271: function toScoredRecommendation(recommendation: RenderableRecommendation): AdvisorScoredRecommendation {\n272:   return {\n273:     skill: recommendation.skill,\n274:     kind: recommendation.kind === 'command' ? 'command' : 'skill',\n275:     confidence: recommendation.confidence,\n276:     uncertainty: recommendation.uncertainty,\n277:     passes_threshold: recommendation.passes_threshold ?? true,\n278:     reason: '',\n279:     score: typeof recommendation.score === 'number' && Number.isFinite(recommendation.score)\n280:       ? recommendation.score\n281:       : recommendation.confidence,\n282:     laneContributions: [],\n283:     dominantLane: null,\n284:     lifecycleStatus: 'active',\n285:     ...(Array.isArray(recommendation.ambiguousWith) ? { ambiguousWith: recommendation.ambiguousWith } : {}),\n286:     ...(typeof recommendation.heldBelow === 'string' ? { heldBelow: recommendation.heldBelow } : {}),\n287:   };\n288: }\n289: \n290: /**\n291:  * Detect whether the renderable recommendation set carries ambiguity evidence.\n292:  *\n293:  * `precomputedAmbiguous` carries the scorer's own verdict. It wins when defined: the\n294:  * scorer knows which skills a typed command held below the top and which only cleared\n295:  * a confidence floor, and serialized recommendations lose that context. Only when the\n296:  * caller has no verdict is ambiguity re-derived from the rendered fields.\n297:  */\n298: export function hasAdvisorAmbiguitySignal(\n299:   recommendations: readonly AdvisorRecommendation[],\n300:   precomputedAmbiguous?: boolean,\n301: ): boolean {\n302:   if (typeof precomputedAmbiguous === 'boolean') {\n303:     return precomputedAmbiguous;\n304:   }\n305:   return isAmbiguousTopTwo((recommendations as readonly RenderableRecommendation[]).map(toScoredRecommendation));\n306: }\n307: \n308: function metadataSkillLabel(result: AdvisorBriefRenderableResult): string | null {\n309:   const metadata = result.sharedPayload?.metadata;\n310:   return typeof metadata?.skillLabel === 'string' ? metadata.skillLabel : null;\n311: }\n312: \n313: /** Return only the advisor route block that the shadow path would retain. */\n314: export function renderRouteOnlyAdvisorBrief(rendered: string | null): string | null {\n315:   const routeBlock = buildAdvisorRenderPlan(rendered).blocks.find((block) => (\n316:     block.id === ROUTE_ADVISOR_ID\n317:   ));\n318:   return routeBlock?.content ?? null;\n319: }\n320: \n321: /** Read the append-only in-process shadow log without exposing route content. */\n322: export function getShadowRouteOnlyLog(): readonly ShadowRouteOnlyLogRecord[] {\n323:   return Object.freeze(SHADOW_ROUTE_ONLY_LOG.map((record) => ({ ...record })));\n324: }\n325: \n326: /** Clear shadow log entries between isolated evaluations. */\n327: export function clearShadowRouteOnlyLog(): void {\n328:   SHADOW_ROUTE_ONLY_LOG.length = 0;\n329: }\n330: \n331: function stateSignalsForBlock(options: ShadowDeliveryRenderOptions): ShadowDeliveryRenderOptions {\n332:   return {\n333:     ...options,\n334:     lifecycleEvent: undefined,\n335:     scopeChanged: false,\n336:     policySetChanged: false,\n337:     goalChanged: false,\n338:   };\n339: }\n340: \n341: function pushShadowRouteOnlyLog(record: ShadowRouteOnlyLogRecord): void {\n342:   if (SHADOW_ROUTE_ONLY_LOG.length >= MAX_SHADOW_ROUTE_ONLY_LOG) {\n343:     SHADOW_ROUTE_ONLY_LOG.shift();\n344:   }\n345:   SHADOW_ROUTE_ONLY_LOG.push(record);\n346: }\n347: \n348: function directiveBlocksSuppressed(\n349:   plan: ReturnType<typeof buildAdvisorRenderPlan>,\n350:   decisions: readonly ReturnType<typeof evaluateDeliveryState>[],\n351: ): boolean {\n352:   for (const expectedId of directiveBlockIds()) {\n353:     const blockIndex = plan.blocks.findIndex((block) => block.id === expectedId);\n354:     if (blockIndex === -1) {\n355:       return false;\n356:     }\n357:     const decision = decisions[blockIndex];\n358:     if (!decision || decision.state !== 'SUPPRESSED_SAME') {\n359:       return false;\n360:     }\n361:   }\n362:   return true;\n363: }\n364: \n365: function recordObservedBlockDeliveries(\n366:   plan: ReturnType<typeof buildAdvisorRenderPlan>,\n367:   shadowOptions: ShadowDeliveryRenderOptions,\n368:   machine: DeliveryStateMachine,\n369:   epoch: number,\n370: ): void {\n371:   const blockOptions = stateSignalsForBlock(shadowOptions);\n372:   for (const block of plan.blocks) {\n373:     const receipt = shadowOptions.receipt;\n374:     if (!isObservedDeliveryReceipt(receipt, block.contentHash, epoch)) {\n375:       continue;\n376:     }\n377:     machine.recordDelivery({\n378:       ...blockOptions,\n379:       blockId: block.id,\n380:       contentHash: block.contentHash,\n381:       receipt,\n382:     });\n383:   }\n384: }\n385: \n386: function observeShadowRouteOnly(\n387:   rendered: string | null,\n388:   options: ShadowDeliveryRenderOptions | undefined,\n389: ): void {\n390:   try {\n391:     const plan = buildAdvisorRenderPlan(rendered);\n392:     const shadowOptions = options ?? {};\n393:     const machine = shadowOptions.stateMachine ?? SHADOW_DELIVERY_STATE_MACHINE;\n394:     const epochSnapshot = machine.advanceForSignals(shadowOptions);\n395:     const blockOptions = stateSignalsForBlock(shadowOptions);\n396:     const decisions = plan.blocks.map((block) => evaluateDeliveryState({\n397:       ...blockOptions,\n398:       blockId: block.id,\n399:       contentHash: block.contentHash,\n400:     }, machine));\n401: \n402:     recordObservedBlockDeliveries(plan, shadowOptions, machine, epochSnapshot.epoch);\n403: \n404:     const routeIndex = plan.blocks.findIndex((block) => block.id === ROUTE_ADVISOR_ID);\n405:     const routeDecision = routeIndex === -1 ? null : decisions[routeIndex] ?? null;\n406:     const routeOnlyEligible = Boolean(\n407:       routeDecision?.routeOnlyEligible && directiveBlocksSuppressed(plan, decisions),\n408:     );\n409:     const routeOnly = routeOnlyEligible\n410:       ? renderRouteOnlyAdvisorBrief(rendered)\n411:       : null;\n412:     const emittedByteCount = rendered === null ? 0 : Buffer.byteLength(rendered, 'utf8');\n413:     const routeOnlyByteCount = routeOnly === null ? 0 : Buffer.byteLength(routeOnly, 'utf8');\n414:     const savedBytes = routeOnly === null\n415:       ? 0\n416:       : Math.max(0, emittedByteCount - routeOnlyByteCount);\n417:     const record: ShadowRouteOnlyLogRecord = Object.freeze({\n418:       shadowId: ROUTE_ONLY_SHADOW_ID,\n419:       sessionKnown: routeDecision?.sessionKnown ?? epochSnapshot.sessionKnown,\n420:       epoch: routeDecision?.epoch ?? epochSnapshot.epoch,\n421:       policySetHash: plan.policySetHash,\n422:       routeState: routeDecision?.state ?? null,\n423:       emittedByteCount,\n424:       routeOnlyByteCount,\n425:       savedBytes,\n426:     });\n427:     pushShadowRouteOnlyLog(record);\n428:     try {\n429:       options?.onShadowLog?.(record);\n430:     } catch {\n431:       // Observer callbacks must never affect the rendered advisor bytes.\n432:     }\n433:   } catch {\n434:     // Shadow measurement is fail-open so a throwing observer cannot block delivery.\n435:   }\n436: }\n437: \n438: function observeAdvisorPolicy(\n439:   rendered: string | null,\n440:   options: AdvisorBriefRenderOptions = {},\n441: ): void {\n442:   try {\n443:     observeRenderedAdvisorPolicy(rendered);\n444:   } catch {\n445:     // Shadow measurement is fail-open so a throwing observer cannot block delivery.\n446:   }\n447:   observeShadowRouteOnly(rendered, options.deliveryState);\n448: }\n449: \n450: /** Run the shadow planner for a runtime callback without changing its output. */\n451: export function observeShadowDelivery(\n452:   rendered: string | null,\n453:   deliveryState: ShadowDeliveryRenderOptions = {},\n454: ): void {\n455:   observeAdvisorPolicy(rendered, { deliveryState });\n456: }\n457: \n458: /**\n459:  * Record host-observed policy blocks after the runtime places them into the\n460:  * emitted response. Fail-open: recording errors never change emitted bytes.\n461:  */\n462: export function observeEmittedAdvisorPolicy(\n463:   rendered: string | null,\n464:   deliveryState: ShadowDeliveryRenderOptions = {},\n465: ): void {\n466:   try {\n467:     if (typeof rendered !== 'string' || rendered.length === 0) {\n468:       return;\n469:     }\n470:     const runtime = typeof deliveryState.runtime === 'string' && deliveryState.runtime.length > 0\n471:       ? deliveryState.runtime\n472:       : 'unknown';\n473:     const machine = deliveryState.stateMachine ?? SHADOW_DELIVERY_STATE_MACHINE;\n474:     const epoch = machine.currentEpoch(deliveryState);\n475:     const plan = buildAdvisorRenderPlan(rendered);\n476:     for (const block of plan.blocks) {\n477:       recordObservedPolicyDelivery({\n478:         runtime,\n479:         candidate: deliveryState.candidate ?? OBSERVED_ADVISOR_POLICY_CANDIDATE,\n480:         blockId: block.id,\n481:         content: block.content,\n482:         contentHash: block.contentHash,\n483:         lifecycleEpoch: epoch,\n484:         sessionId: deliveryState.sessionId,\n485:         sessionIdentity: deliveryState.sessionIdentity,\n486:         sessionIdentityConfirmed: deliveryState.sessionIdentityConfirmed,\n487:         sessionIdentityAmbiguous: deliveryState.sessionIdentityAmbiguous,\n488:         transformMessageIdentity: deliveryState.transformMessageIdentity ?? null,\n489:       });\n490:     }\n491:   } catch {\n492:     // Host observation is fail-open so a throwing sink cannot affect delivery.\n493:   }\n494: }\n495: \n496: // ───────────────────────────────────────────────────────────────\n497: // 4. CORE LOGIC\n498: // ───────────────────────────────────────────────────────────────\n499: \n500: /**\n501:  * Render the model-visible advisor brief from typed advisor output only.\n502:  *\n503:  * The renderer is the prompt-boundary guard: it ignores free-form reasons,\n504:  * descriptions, stdout/stderr, and prompt text, and emits nothing when the\n505:  * repository-authored skill label looks instruction-shaped after folding.\n506:  */\n507: export function renderAdvisorBrief(\n508:   result: AdvisorBriefRenderableResult,\n509:   options: AdvisorBriefRenderOptions = {},\n510: ): string | null {\n511:   if (result.status !== 'ok') {\n512:     observeAdvisorPolicy(null, options);\n513:     return null;\n514:   }\n515:   if (result.freshness !== 'live' && result.freshness !== 'stale') {\n516:     observeAdvisorPolicy(null, options);\n517:     return null;\n518:   }\n519: \n520:   const tokenCap = clampTokenCap(result.metrics?.tokenCap ?? options.tokenCap);\n521:   const thresholdConfig = options.thresholdConfig;\n522:   const childSession = options.childSession ?? process.env.AI_SESSION_CHILD === '1';\n523:   const recommendations = result.recommendations.filter((recommendation) => (\n524:     recommendation.passes_threshold === true\n525:     || (\n526:       recommendation.confidence >= (thresholdConfig?.confidenceThreshold ?? resolvedConfidenceThreshold())\n527:       && (\n528:         thresholdConfig?.confidenceOnly === true\n529:         || recommendation.uncertainty <= (thresholdConfig?.uncertaintyThreshold ?? resolvedUncertaintyThreshold())\n530:       )\n531:     )\n532:   ));\n533:   const [top, second] = recommendations;\n534:   if (!top) {\n535:     observeAdvisorPolicy(null, options);\n536:     return null;\n537:   }\n538: \n539:   const topLabel = commandLabel(top, childSession)\n540:     ?? (isDoctorBridgeId(top.skill)\n541:       ? doctorCommandString(top.skill)\n542:       : sanitizeSkillLabel(metadataSkillLabel(result) ?? top.skill));\n543:   if (!topLabel) {\n544:     observeAdvisorPolicy(null, options);\n545:     return null;\n546:   }\n547: \n548:   const companion = isDoctorBridgeId(top.skill)\n549:     ? undefined\n550:     : recommendations.slice(1).find((recommendation) => doctorCommandString(recommendation.skill) !== null);\n551:   const companionLabel = companion ? companionCommandLabel(companion.skill, childSession) : null;\n552:   const companionLine = (shownSecond: string | undefined): string => (\n553:     companionLabel && companion && companion.skill !== shownSecond ? `\\nAlso: ${companionLabel}` : ''\n554:   );\n555:   const capWithCompanion = (head: string, companionText: string, cap: number): string => {\n556:     const companionFits = head.length + companionText.length <= cap * TOKEN_TO_CHAR_ESTIMATE;\n557:     return `${capText(head, cap)}${companionFits ? companionText : ''}`;\n558:   };\n559: \n560:   const precomputedAmbiguous = typeof result.ambiguous === 'boolean' ? result.ambiguous : undefined;\n561:   if (tokenCap > DEFAULT_TOKEN_CAP && second && hasAdvisorAmbiguitySignal(recommendations, precomputedAmbiguous)) {\n562:     // The scorer names its own tie partners, which can sit below the second passing\n563:     // entry, so prefer a named partner and fall back to the second entry.\n564:     const namedPartners = (top as RenderableRecommendation).ambiguousWith;\n565:     const ambiguousWith: readonly string[] = Array.isArray(namedPartners) ? namedPartners : [];\n566:     const vs = (ambiguousWith.length > 0\n567:       ? recommendations.find((recommendation) => ambiguousWith.includes(recommendation.skill))\n568:       : undefined) ?? second;\n569:     const vsLabel = recommendationLabel(vs, childSession);\n570:     if (!vsLabel && !isDoctorBridgeId(vs.skill)) {\n571:       observeAdvisorPolicy(null, options);\n572:       return null;\n573:     }\n574:     if (vsLabel) {\n575:       const head = `Advisor: ${result.freshness}; ambiguous: ${topLabel} `\n576:         + `${formatScore(top.confidence)}/${formatScore(top.uncertainty)} vs ${vsLabel} `\n577:         + `${formatScore(vs.confidence)}/${formatScore(vs.uncertainty)} pass.`;\n578:       const rendered = capWithCompanion(\n579:         head,\n580:         companionLine(vs.skill),\n581:         Math.min(tokenCap, AMBIGUOUS_TOKEN_CAP),\n582:       ) + DIRECTIVES_LABEL + HYGIENE_DIRECTIVE;\n583:       observeAdvisorPolicy(rendered, options);\n584:       return rendered;\n585:     }\n586:   }\n587: \n588:   const head = `Advisor: ${result.freshness}; use ${topLabel} `\n589:     + `${formatScore(top.confidence)}/${formatScore(top.uncertainty)} pass.`;\n590:   const rendered = capWithCompanion(\n591:     head,\n592:     companionLine(undefined),\n593:     Math.min(tokenCap, DEFAULT_TOKEN_CAP),\n594:   ) + DIRECTIVES_LABEL + HYGIENE_DIRECTIVE;\n595:   observeAdvisorPolicy(rendered, options);\n596:   return rendered;\n597: }\n598: \n599: /** Classify a result with no brief; no result at all means the advisor did not answer. */\n600: export function advisorFallbackCase(\n601:   result?: Pick<AdvisorHookResult, 'status' | 'freshness'>,\n602: ): AdvisorFallbackClassification {\n603:   if (!result || result.status === 'fail_open' || result.freshness === 'absent'\n604:     || (result.freshness === 'unavailable' && result.status !== 'skipped')) {\n605:     return {\n606:       fallbackCase: 'outage',\n607:       outageLabel: result?.freshness === 'absent'\n608:         ? 'absent'\n609:         : result?.status === 'degraded'\n610:           ? 'degraded'\n611:           : 'fail_open',\n612:     };\n613:   }\n614:   if (result.status === 'skipped' && result.freshness === 'unavailable') {\n615:     return { fallbackCase: 'skipped' };\n616:   }\n617:   return { fallbackCase: 'no-match' };\n618: }\n619: \n620: /** Render the fallback status and directive block when no advisor brief is available. */\n621: export function renderAdvisorFallbackDirective(\n622:   options: AdvisorBriefRenderOptions = {},\n623:   result?: Pick<AdvisorHookResult, 'status' | 'freshness'>,\n624: ): string {\n625:   const classification = advisorFallbackCase(result);\n626:   const head = classification.fallbackCase === 'outage'\n627:     ? `Advisor: outage (${classification.outageLabel});${options.setupWording === true ? ' for setup or health checks, run /doctor:setup;' : ''} route by hand: node .skilled/bin/skill-advisor.cjs advisor_recommend --json '{\"prompt\":\"<request>\"}' --format json`\n628:     : classification.fallbackCase === 'skipped'\n629:       ? 'Advisor: prompt skipped.'\n630:       : options.setupWording === true\n631:         ? `Advisor: no skill matched.${SETUP_HINT}`\n632:         : 'Advisor: no skill matched.';\n633:   const rendered = head + DIRECTIVES_LABEL + HYGIENE_DIRECTIVE;\n634:   observeAdvisorPolicy(rendered, options);\n635:   return rendered;\n636: }\n637: \n638: /** Render the outage fallback used when advisor execution times out or is unavailable. */\n639: export function renderAdvisorTimeoutFallback(\n640:   options: AdvisorBriefRenderOptions = {},\n641:   status: Extract<AdvisorHookResult['status'], 'fail_open' | 'degraded'> = 'fail_open',\n642: ): string {\n643:   return renderAdvisorFallbackDirective(options, { status, freshness: 'unavailable' });\n644: }\n645: \n646: export { sanitizeSkillLabel };"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/lib/render.ts\"}"},"time":{"start":1794544732501,"end":1794544733328}}}}
{"type":"tool_use","timestamp":1794544733332,"sessionID":"ses_e2ccd29f3ffe8vcrbGoR5Y3ujq","part":{"partID":"prt_1d3338b04001xfX3QVTG8EX2rk","sessionID":"ses_e2ccd29f3ffe8vcrbGoR5Y3ujq","messageID":"msg_1d33362a5001QdcwShW6nANtTI","type":"tool","id":"call_3db0bf8159c44d36b0b4e71b","tool":"read","state":{"status":"completed","input":{"path":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/tests/command-brief-golden.vitest.ts"},"output":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/tests/command-brief-golden.vitest.ts, lines 1-203\n1: // ───────────────────────────────────────────────────────────────\n2: // MODULE: Command Brief Golden Tests\n3: // ───────────────────────────────────────────────────────────────\n4: \n5: import { describe, expect, it } from 'vitest';\n6: import { renderAdvisorBrief } from '../lib/render.js';\n7: \n8: const DIRECTIVES_LABEL = '\\nDirectives:';\n9: // The advisor portion is capped at 80 tokens and the renderer estimates four\n10: // characters per token, so a longer head has already lost the command it offered.\n11: const HEAD_CHARACTER_CAP = 320;\n12: \n13: type AdvisorBriefResult = Parameters<typeof renderAdvisorBrief>[0];\n14: \n15: interface RecommendationInput {\n16:   readonly skill: string;\n17:   readonly kind?: 'skill' | 'command';\n18:   readonly command?: string;\n19:   readonly policy?: 'run' | 'start' | 'ask';\n20:   readonly ownerSkillId?: string;\n21:   readonly confidence: number;\n22:   readonly uncertainty: number;\n23: }\n24: \n25: interface HeadCase {\n26:   readonly name: string;\n27:   readonly recommendation: RecommendationInput;\n28:   readonly expectedHead: string;\n29: }\n30: \n31: const HEAD_CASES: readonly HeadCase[] = [\n32:   {\n33:     name: 'a documentation request names the owning skill, the command and its policy',\n34:     recommendation: {\n35:       skill: 'sk-doc',\n36:       kind: 'command',\n37:       command: '/create:readme',\n38:       policy: 'start',\n39:       ownerSkillId: 'sk-doc',\n40:       confidence: 0.95,\n41:       uncertainty: 0.12,\n42:     },\n43:     expectedHead: 'Advisor: live; use sk-doc → /create:readme (start) 0.95/0.12 pass.',\n44:   },\n45:   {\n46:     name: 'a research hub names the deep workflow it would start',\n47:     recommendation: {\n48:       skill: 'system-deep-loop',\n49:       kind: 'command',\n50:       command: '/deep:research',\n51:       policy: 'ask',\n52:       ownerSkillId: 'system-deep-loop',\n53:       confidence: 0.82,\n54:       uncertainty: 0.16,\n55:     },\n56:     expectedHead: 'Advisor: live; use system-deep-loop → /deep:research (ask) 0.82/0.16 pass.',\n57:   },\n58:   {\n59:     name: 'a design request names the chart mode',\n60:     recommendation: {\n61:       skill: 'sk-design',\n62:       kind: 'command',\n63:       command: '/design:chart',\n64:       policy: 'start',\n65:       ownerSkillId: 'sk-design',\n66:       confidence: 0.9,\n67:       uncertainty: 0.12,\n68:     },\n69:     expectedHead: 'Advisor: live; use sk-design → /design:chart (start) 0.90/0.12 pass.',\n70:   },\n71:   {\n72:     name: 'a doctor bridge names the owning skill and the runnable subcommand',\n73:     recommendation: {\n74:       skill: 'command-doctor-git-hooks',\n75:       kind: 'command',\n76:       command: '/doctor:git hooks',\n77:       policy: 'ask',\n78:       ownerSkillId: 'sk-git',\n79:       confidence: 0.82,\n80:       uncertainty: 0.12,\n81:     },\n82:     expectedHead: 'Advisor: live; use sk-git → /doctor:git hooks (ask) 0.82/0.12 pass.',\n83:   },\n84:   {\n85:     name: 'a memory save names the spec workflow',\n86:     recommendation: {\n87:       skill: 'system-spec-kit',\n88:       kind: 'command',\n89:       command: '/speckit:save',\n90:       policy: 'start',\n91:       ownerSkillId: 'system-spec-kit',\n92:       confidence: 0.89,\n93:       uncertainty: 0.12,\n94:     },\n95:     expectedHead: 'Advisor: live; use system-spec-kit → /speckit:save (start) 0.89/0.12 pass.',\n96:   },\n97:   {\n98:     name: 'a prompt rewrite names the prompt skill',\n99:     recommendation: {\n100:       skill: 'sk-prompt',\n101:       kind: 'command',\n102:       command: '/prompt:improve',\n103:       policy: 'start',\n104:       ownerSkillId: 'sk-prompt',\n105:       confidence: 0.89,\n106:       uncertainty: 0.12,\n107:     },\n108:     expectedHead: 'Advisor: live; use sk-prompt → /prompt:improve (start) 0.89/0.12 pass.',\n109:   },\n110:   {\n111:     name: 'a row id with no fields is filled from the generated command table',\n112:     recommendation: {\n113:       skill: 'command-create-readme',\n114:       kind: 'command',\n115:       confidence: 0.91,\n116:       uncertainty: 0.11,\n117:     },\n118:     expectedHead: 'Advisor: live; use sk-doc → /create:readme (start) 0.91/0.11 pass.',\n119:   },\n120:   {\n121:     name: 'an id with no row keeps the plain skill head',\n122:     recommendation: {\n123:       skill: 'sk-review',\n124:       confidence: 0.61,\n125:       uncertainty: 0.28,\n126:     },\n127:     expectedHead: 'Advisor: live; use sk-review 0.61/0.28 pass.',\n128:   },\n129:   {\n130:     name: 'a command with no known policy drops the parenthesis',\n131:     recommendation: {\n132:       skill: 'command-doctor-review-gate',\n133:       kind: 'command',\n134:       command: '/doctor:review gate',\n135:       ownerSkillId: 'sk-code',\n136:       confidence: 0.77,\n137:       uncertainty: 0.2,\n138:     },\n139:     expectedHead: 'Advisor: live; use sk-code → /doctor:review gate 0.77/0.20 pass.',\n140:   },\n141: ];\n142: \n143: // Every recommendation is marked as passing so each case isolates the head form\n144: // instead of threshold filtering.\n145: function advisorResult(recommendation: RecommendationInput): AdvisorBriefResult {\n146:   return {\n147:     status: 'ok',\n148:     freshness: 'live',\n149:     recommendations: [{ ...recommendation, passes_threshold: true }],\n150:     metrics: { tokenCap: 80 },\n151:   };\n152: }\n153: \n154: // The ambiguous branch renders only above the default token cap, so the two-sided\n155: // case carries its own wider-capped result instead of the single-entry helper.\n156: const AMBIGUOUS_COMMAND_RESULT: AdvisorBriefResult = {\n157:   status: 'ok',\n158:   freshness: 'live',\n159:   recommendations: [\n160:     {\n161:       skill: 'command-doctor-git-hooks',\n162:       kind: 'command',\n163:       confidence: 0.82,\n164:       uncertainty: 0.12,\n165:       passes_threshold: true,\n166:     },\n167:     {\n168:       skill: 'command-speckit-save',\n169:       kind: 'command',\n170:       confidence: 0.89,\n171:       uncertainty: 0.12,\n172:       passes_threshold: true,\n173:     },\n174:   ],\n175:   ambiguous: true,\n176:   metrics: { tokenCap: 120 },\n177: };\n178: \n179: function headOf(rendered: string | null): string {\n180:   if (rendered === null) {\n181:     throw new Error('expected a rendered brief');\n182:   }\n183:   return rendered.split(DIRECTIVES_LABEL)[0];\n184: }\n185: \n186: describe('command brief golden heads', () => {\n187:   it.each(HEAD_CASES)('renders $name', ({ recommendation, expectedHead }) => {\n188:     const head = headOf(renderAdvisorBrief(advisorResult(recommendation)));\n189: \n190:     expect(head).toBe(expectedHead);\n191:     expect(head.length).toBeLessThanOrEqual(HEAD_CHARACTER_CAP);\n192:     expect(head).not.toContain('command-');\n193:   });\n194: \n195:   it('renders both command labels under an ambiguous head', () => {\n196:     const head = headOf(renderAdvisorBrief(AMBIGUOUS_COMMAND_RESULT));\n197: \n198:     expect(head.startsWith('Advisor: live; ambiguous: sk-git → /doctor:git hooks (ask)')).toBe(true);\n199:     expect(head).toContain(' vs system-spec-kit → /speckit:save (start)');\n200:     expect(head.length).toBeLessThanOrEqual(HEAD_CHARACTER_CAP);\n201:     expect(head).not.toContain('command-');\n202:   });\n203: });","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/tests/command-brief-golden.vitest.ts, lines 1-203\n1: // ───────────────────────────────────────────────────────────────\n2: // MODULE: Command Brief Golden Tests\n3: // ───────────────────────────────────────────────────────────────\n4: \n5: import { describe, expect, it } from 'vitest';\n6: import { renderAdvisorBrief } from '../lib/render.js';\n7: \n8: const DIRECTIVES_LABEL = '\\nDirectives:';\n9: // The advisor portion is capped at 80 tokens and the renderer estimates four\n10: // characters per token, so a longer head has already lost the command it offered.\n11: const HEAD_CHARACTER_CAP = 320;\n12: \n13: type AdvisorBriefResult = Parameters<typeof renderAdvisorBrief>[0];\n14: \n15: interface RecommendationInput {\n16:   readonly skill: string;\n17:   readonly kind?: 'skill' | 'command';\n18:   readonly command?: string;\n19:   readonly policy?: 'run' | 'start' | 'ask';\n20:   readonly ownerSkillId?: string;\n21:   readonly confidence: number;\n22:   readonly uncertainty: number;\n23: }\n24: \n25: interface HeadCase {\n26:   readonly name: string;\n27:   readonly recommendation: RecommendationInput;\n28:   readonly expectedHead: string;\n29: }\n30: \n31: const HEAD_CASES: readonly HeadCase[] = [\n32:   {\n33:     name: 'a documentation request names the owning skill, the command and its policy',\n34:     recommendation: {\n35:       skill: 'sk-doc',\n36:       kind: 'command',\n37:       command: '/create:readme',\n38:       policy: 'start',\n39:       ownerSkillId: 'sk-doc',\n40:       confidence: 0.95,\n41:       uncertainty: 0.12,\n42:     },\n43:     expectedHead: 'Advisor: live; use sk-doc → /create:readme (start) 0.95/0.12 pass.',\n44:   },\n45:   {\n46:     name: 'a research hub names the deep workflow it would start',\n47:     recommendation: {\n48:       skill: 'system-deep-loop',\n49:       kind: 'command',\n50:       command: '/deep:research',\n51:       policy: 'ask',\n52:       ownerSkillId: 'system-deep-loop',\n53:       confidence: 0.82,\n54:       uncertainty: 0.16,\n55:     },\n56:     expectedHead: 'Advisor: live; use system-deep-loop → /deep:research (ask) 0.82/0.16 pass.',\n57:   },\n58:   {\n59:     name: 'a design request names the chart mode',\n60:     recommendation: {\n61:       skill: 'sk-design',\n62:       kind: 'command',\n63:       command: '/design:chart',\n64:       policy: 'start',\n65:       ownerSkillId: 'sk-design',\n66:       confidence: 0.9,\n67:       uncertainty: 0.12,\n68:     },\n69:     expectedHead: 'Advisor: live; use sk-design → /design:chart (start) 0.90/0.12 pass.',\n70:   },\n71:   {\n72:     name: 'a doctor bridge names the owning skill and the runnable subcommand',\n73:     recommendation: {\n74:       skill: 'command-doctor-git-hooks',\n75:       kind: 'command',\n76:       command: '/doctor:git hooks',\n77:       policy: 'ask',\n78:       ownerSkillId: 'sk-git',\n79:       confidence: 0.82,\n80:       uncertainty: 0.12,\n81:     },\n82:     expectedHead: 'Advisor: live; use sk-git → /doctor:git hooks (ask) 0.82/0.12 pass.',\n83:   },\n84:   {\n85:     name: 'a memory save names the spec workflow',\n86:     recommendation: {\n87:       skill: 'system-spec-kit',\n88:       kind: 'command',\n89:       command: '/speckit:save',\n90:       policy: 'start',\n91:       ownerSkillId: 'system-spec-kit',\n92:       confidence: 0.89,\n93:       uncertainty: 0.12,\n94:     },\n95:     expectedHead: 'Advisor: live; use system-spec-kit → /speckit:save (start) 0.89/0.12 pass.',\n96:   },\n97:   {\n98:     name: 'a prompt rewrite names the prompt skill',\n99:     recommendation: {\n100:       skill: 'sk-prompt',\n101:       kind: 'command',\n102:       command: '/prompt:improve',\n103:       policy: 'start',\n104:       ownerSkillId: 'sk-prompt',\n105:       confidence: 0.89,\n106:       uncertainty: 0.12,\n107:     },\n108:     expectedHead: 'Advisor: live; use sk-prompt → /prompt:improve (start) 0.89/0.12 pass.',\n109:   },\n110:   {\n111:     name: 'a row id with no fields is filled from the generated command table',\n112:     recommendation: {\n113:       skill: 'command-create-readme',\n114:       kind: 'command',\n115:       confidence: 0.91,\n116:       uncertainty: 0.11,\n117:     },\n118:     expectedHead: 'Advisor: live; use sk-doc → /create:readme (start) 0.91/0.11 pass.',\n119:   },\n120:   {\n121:     name: 'an id with no row keeps the plain skill head',\n122:     recommendation: {\n123:       skill: 'sk-review',\n124:       confidence: 0.61,\n125:       uncertainty: 0.28,\n126:     },\n127:     expectedHead: 'Advisor: live; use sk-review 0.61/0.28 pass.',\n128:   },\n129:   {\n130:     name: 'a command with no known policy drops the parenthesis',\n131:     recommendation: {\n132:       skill: 'command-doctor-review-gate',\n133:       kind: 'command',\n134:       command: '/doctor:review gate',\n135:       ownerSkillId: 'sk-code',\n136:       confidence: 0.77,\n137:       uncertainty: 0.2,\n138:     },\n139:     expectedHead: 'Advisor: live; use sk-code → /doctor:review gate 0.77/0.20 pass.',\n140:   },\n141: ];\n142: \n143: // Every recommendation is marked as passing so each case isolates the head form\n144: // instead of threshold filtering.\n145: function advisorResult(recommendation: RecommendationInput): AdvisorBriefResult {\n146:   return {\n147:     status: 'ok',\n148:     freshness: 'live',\n149:     recommendations: [{ ...recommendation, passes_threshold: true }],\n150:     metrics: { tokenCap: 80 },\n151:   };\n152: }\n153: \n154: // The ambiguous branch renders only above the default token cap, so the two-sided\n155: // case carries its own wider-capped result instead of the single-entry helper.\n156: const AMBIGUOUS_COMMAND_RESULT: AdvisorBriefResult = {\n157:   status: 'ok',\n158:   freshness: 'live',\n159:   recommendations: [\n160:     {\n161:       skill: 'command-doctor-git-hooks',\n162:       kind: 'command',\n163:       confidence: 0.82,\n164:       uncertainty: 0.12,\n165:       passes_threshold: true,\n166:     },\n167:     {\n168:       skill: 'command-speckit-save',\n169:       kind: 'command',\n170:       confidence: 0.89,\n171:       uncertainty: 0.12,\n172:       passes_threshold: true,\n173:     },\n174:   ],\n175:   ambiguous: true,\n176:   metrics: { tokenCap: 120 },\n177: };\n178: \n179: function headOf(rendered: string | null): string {\n180:   if (rendered === null) {\n181:     throw new Error('expected a rendered brief');\n182:   }\n183:   return rendered.split(DIRECTIVES_LABEL)[0];\n184: }\n185: \n186: describe('command brief golden heads', () => {\n187:   it.each(HEAD_CASES)('renders $name', ({ recommendation, expectedHead }) => {\n188:     const head = headOf(renderAdvisorBrief(advisorResult(recommendation)));\n189: \n190:     expect(head).toBe(expectedHead);\n191:     expect(head.length).toBeLessThanOrEqual(HEAD_CHARACTER_CAP);\n192:     expect(head).not.toContain('command-');\n193:   });\n194: \n195:   it('renders both command labels under an ambiguous head', () => {\n196:     const head = headOf(renderAdvisorBrief(AMBIGUOUS_COMMAND_RESULT));\n197: \n198:     expect(head.startsWith('Advisor: live; ambiguous: sk-git → /doctor:git hooks (ask)')).toBe(true);\n199:     expect(head).toContain(' vs system-spec-kit → /speckit:save (start)');\n200:     expect(head.length).toBeLessThanOrEqual(HEAD_CHARACTER_CAP);\n201:     expect(head).not.toContain('command-');\n202:   });\n203: });"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/tests/command-brief-golden.vitest.ts\"}"},"time":{"start":1794544732932,"end":1794544733332}}}}
