em-spec-kit\",\n        \"score\": 0.253354,\n        \"confidence\": 0.82,\n        \"uncertainty\": 0.26,\n        \"dominantLane\": \"explicit_author\",\n        \"status\": \"active\",\n        \"kind\": \"skill\"\n      },\n      {\n        \"skillId\": \"sk-doc\",\n        \"score\": 0.176776,\n        \"confidence\": 0.82,\n        \"uncertainty\": 0.22,\n        \"dominantLane\": \"lexical\",\n        \"status\": \"active\",\n        \"compiledRoute\": {\n          \"hubId\": \"sk-doc\",\n          \"action\": \"defer\",\n          \"selectionKind\": null,\n          \"targets\": [],\n          \"effectivePolicyHash\": \"0c36f5c183023baaed6076575b48271ef45e528322d8abb079f83cc0fd8843ed\",\n          \"generation\": 5\n        },\n        \"kind\": \"skill\"\nEXIT:0\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"node .skilled/bin/skill-advisor.cjs advisor_recommend --json '{\\\"prompt\\\":\\\"run build then recapture the command routing baseline json for the doctor command routing slice\\\"}' --format json 2>&1 | head -60; echo \\\"EXIT:$?\\\"\",\"workdir\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research\"}"},"time":{"start":1794543788675,"end":1794543790228}}}}
