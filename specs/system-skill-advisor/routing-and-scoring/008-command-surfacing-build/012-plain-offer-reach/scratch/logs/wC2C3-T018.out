IC\n498: // ───────────────────────────────────────────────────────────────\n499: \n500: /**\n501:  * Render the model-visible advisor brief from typed advisor output only.\n502:  *\n503:  * The renderer is the prompt-boundary guard: it ignores free-form reasons,\n504:  * descriptions, stdout/stderr, and prompt text, and emits nothing when the\n505:  * repository-authored skill label looks instruction-shaped after folding.\n506:  */\n507: export function renderAdvisorBrief(\n508:   result: AdvisorBriefRenderableResult,\n509:   options: AdvisorBriefRenderOptions = {},\n510: ): string | null {\n511:   if (result.status !== 'ok') {\n512:     observeAdvisorPolicy(null, options);\n513:     return null;\n514:   }\n515:   if (result.freshness !== 'live' && result.freshness !== 'stale') {\n516:     observeAdvisorPolicy(null, options);\n517:     return null;\n518:   }\n519: \n520:   const tokenCap = clampTokenCap(result.metrics?.tokenCap ?? options.tokenCap);\n521:   const thresholdConfig = options.thresholdConfig;\n522:   const childSession = options.childSession ?? process.env.AI_SESSION_CHILD === '1';\n523:   const recommendations = result.recommendations.filter((recommendation) => (\n524:     recommendation.passes_threshold === true\n525:     || (\n526:       recommendation.confidence >= (thresholdConfig?.confidenceThreshold ?? resolvedConfidenceThreshold())\n527:       && (\n528:         thresholdConfig?.confidenceOnly === true\n529:         || recommendation.uncertainty <= (thresholdConfig?.uncertaintyThreshold ?? resolvedUncertaintyThreshold())\n530:       )\n531:     )\n532:   ));\n533:   const [top, second] = recommendations;\n534:   if (!top) {\n535:     observeAdvisorPolicy(null, options);\n536:     return null;\n537:   }\n538: \n539:   const topLabel = commandLabel(top, childSession)\n540:     ?? (isDoctorBridgeId(top.skill)\n541:       ? doctorCommandString(top.skill)\n542:       : sanitizeSkillLabel(metadataSkillLabel(result) ?? top.skill));\n543:   if (!topLabel) {\n544:     observeAdvisorPolicy(null, options);\n545:     return null;\n546:   }\n547: \n548:   // A hub that withheld its command because the prompt names no single mode says\n549:   // so, so the reader asks for the mode instead of improvising one.\n550:   const headLabel = top.needsMode === true && top.command === undefined && commandRowFor(top.skill) === undefined\n551:     ? `${topLabel} (needs a mode)`\n552:     : topLabel;\n553: \n554:   const companion = isDoctorBridgeId(top.skill)\n555:     ? undefined\n556:     : recommendations.slice(1).find((recommendation) => doctorCommandString(recommendation.skill) !== null);\n557:   const companionLabel = companion ? companionCommandLabel(companion.skill, childSession) : null;\n558:   const companionLine = (shownSecond: string | undefined): string => (\n559:     companionLabel && companion && companion.skill !== shownSecond ? `\\nAlso: ${companionLabel}` : ''\n560:   );\n561:   const capWithCompanion = (head: string, companionText: string, cap: number): string => {\n562:     const companionFits = head.length + companionText.length <= cap * TOKEN_TO_CHAR_ESTIMATE;\n563:     return `${capText(head, cap)}${companionFits ? companionText : ''}`;\n564:   };\n565: \n566:   const precomputedAmbiguous = typeof result.ambiguous === 'boolean' ? result.ambiguous : undefined;\n567:   if (tokenCap > DEFAULT_TOKEN_CAP && second && hasAdvisorAmbiguitySignal(recommendations, precomputedAmbiguous)) {\n568:     // The scorer names its own tie partners, which can sit below the second passing\n569:     // entry, so prefer a named partner and fall back to the second entry.\n570:     const namedPartners = (top as RenderableRecommendation).ambiguousWith;\n571:     const ambiguousWith: readonly string[] = Array.isArray(namedPartners) ? namedPartners : [];\n572:     const vs = (ambiguousWith.length > 0\n573:       ? recommendations.find((recommendation) => ambiguousWith.includes(recommendation.skill))\n574:       : undefined) ?? second;\n575:     const vsLabel = recommendationLabel(vs, childSession);\n576:     if (!vsLabel && !isDoctorBridgeId(vs.skill)) {\n577:       observeAdvisorPolicy(null, options);\n578:       return null;\n579:     }\n580:     if (vsLabel) {\n581:       const head = `Advisor: ${result.freshness}; ambiguous: ${headLabel} `\n582:         + `${formatScore(top.confidence)}/${formatScore(top.uncertainty)} vs ${vsLabel} `\n583:         + `${formatScore(vs.confidence)}/${formatScore(vs.uncertainty)} pass.`;\n584:       const rendered = capWithCompanion(\n585:         head,\n586:         companionLine(vs.skill),\n587:         Math.min(tokenCap, AMBIGUOUS_TOKEN_CAP),\n588:       ) + DIRECTIVES_LABEL + HYGIENE_DIRECTIVE;\n589:       observeAdvisorPolicy(rendered, options);\n590:       return rendered;\n591:     }\n592:   }\n593: \n594:   const head = `Advisor: ${result.freshness}; use ${topLabel} `\n595:     + `${formatScore(top.confidence)}/${formatScore(top.uncertainty)} pass.`;\n596:   const rendered = capWithCompanion(\n597:     head,\n598:     companionLine(undefined),\n599:     Math.min(tokenCap, DEFAULT_TOKEN_CAP),\n600:   ) + DIRECTIVES_LABEL + HYGIENE_DIRECTIVE;\n601:   observeAdvisorPolicy(rendered, options);\n602:   return rendered;\n603: }\n604: \n605: /** Classify a result with no brief; no result at all means the advisor did not answer. */\n606: export function advisorFallbackCase(\n607:   result?: Pick<AdvisorHookResult, 'status' | 'freshness'>,\n608: ): AdvisorFallbackClassification {\n609:   if (!result || result.status === 'fail_open' || result.freshness === 'absent'\n[Output truncated. Continue reading with offset: 610]","title":"read","metadata":{"metadata":{"truncated":true},"content":[{"type":"text","text":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/lib/render.ts, lines 470-609\n470:     const runtime = typeof deliveryState.runtime === 'string' && deliveryState.runtime.length > 0