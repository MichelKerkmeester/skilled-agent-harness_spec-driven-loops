{"type":"tool_use","timestamp":1794544728303,"sessionID":"ses_e2ccd2a29ffep4L2jrNUtgPH5n","part":{"partID":"prt_1d33377410026PyCbjAPdm6G7g","sessionID":"ses_e2ccd2a29ffep4L2jrNUtgPH5n","messageID":"msg_1d333545b00196oDka7qrSWcTq","type":"tool","id":"call_9051a491abdb44248d715f35","tool":"read","state":{"status":"completed","input":{"path":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/hooks/lib/skill-advisor-cli-fallback.ts"},"output":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/hooks/lib/skill-advisor-cli-fallback.ts, lines 1-618\n1: // ───────────────────────────────────────────────────────────────\n2: // MODULE: Skill Advisor CLI Fallback\n3: // ───────────────────────────────────────────────────────────────\n4: \n5: // ───────────────────────────────────────────────────────────────\n6: // 1. IMPORTS\n7: // ───────────────────────────────────────────────────────────────\n8: \n9: import { spawn } from 'node:child_process';\n10: import { existsSync } from 'node:fs';\n11: import { dirname, join, resolve } from 'node:path';\n12: import { performance } from 'node:perf_hooks';\n13: \n14: import type {\n15:   AdvisorHookFreshness,\n16:   AdvisorHookResult,\n17:   AdvisorRuntime,\n18:   SkillAdvisorBriefOptions,\n19: } from '../../runtime/lib/skill-advisor-brief.js';\n20: import type { AdvisorRecommendation } from '../../runtime/lib/subprocess.js';\n21: import { ADVISOR_PROMPT_MAX_CHARS } from '../../runtime/schemas/advisor-tool-schemas.js';\n22: \n23: // ───────────────────────────────────────────────────────────────\n24: // 2. TYPES\n25: // ───────────────────────────────────────────────────────────────\n26: \n27: interface CliFallbackPaths {\n28:   readonly repoRoot: string;\n29:   readonly cliPath: string;\n30:   readonly bridgePath: string;\n31:   readonly dbDir: string;\n32: }\n33: \n34: interface CliProcessResult {\n35:   readonly stdout: string;\n36:   readonly exitCode: number | null;\n37:   readonly signal: NodeJS.Signals | null;\n38:   readonly timedOut: boolean;\n39:   readonly spawnError: string | null;\n40: }\n41: \n42: interface CliRecommendData {\n43:   readonly freshness?: unknown;\n44:   readonly recommendations?: unknown;\n45:   readonly effectiveThresholds?: unknown;\n46:   readonly cache?: unknown;\n47:   readonly warnings?: unknown;\n48:   readonly ambiguous?: unknown;\n49:   // Envelope-level markers, folded into the data view by parseCliPayload so the\n50:   // freshness decision can tell a degraded local-scorer answer from a missing one.\n51:   readonly degraded?: unknown;\n52:   readonly source?: unknown;\n53: }\n54: \n55: export type WarmSkillAdvisorCliFallbackStatus = 'ok' | 'skipped' | 'fail_open';\n56: \n57: export interface WarmSkillAdvisorCliFallbackEnvelope {\n58:   readonly status: WarmSkillAdvisorCliFallbackStatus;\n59:   readonly reason: string;\n60:   readonly exitCode: number | null;\n61:   readonly retryable: boolean;\n62: }\n63: \n64: interface WarmSkillAdvisorCliFallbackEnvelopeInput {\n65:   readonly status: WarmSkillAdvisorCliFallbackStatus;\n66:   readonly reason?: string | null;\n67:   readonly exitCode?: number | null;\n68:   readonly timedOut?: boolean;\n69: }\n70: \n71: export interface SkillAdvisorCliFallbackOptions {\n72:   readonly workspaceRoot: string;\n73:   readonly runtime: AdvisorRuntime;\n74:   readonly timeoutMs?: number;\n75:   readonly thresholdConfig?: SkillAdvisorBriefOptions['thresholdConfig'];\n76:   readonly maxTokens?: number;\n77: }\n78: \n79: interface SkillAdvisorCliFallbackDependencies {\n80:   readonly env?: NodeJS.ProcessEnv;\n81:   readonly now?: () => number;\n82: }\n83: \n84: // ───────────────────────────────────────────────────────────────\n85: // 3. CONSTANTS\n86: // ───────────────────────────────────────────────────────────────\n87: \n88: const DEFAULT_CLI_FALLBACK_TIMEOUT_MS = 250;\n89: const EXIT_RETRYABLE = 75;\n90: const EXIT_SETTLE_GRACE_MS = 25;\n91: const DEFAULT_SOCKET_DIR = '/tmp/system-skill-advisor';\n92: const MAX_STDOUT_BYTES = 1024 * 1024;\n93: const LOCAL_SCORER_SOURCE = 'local-scorer';\n94: \n95: // Reason codes here are post-normalization and shared with the spec-kit warm\n96: // CLI fallback envelope; 'socket_absent' and 'timeout' are the canonical\n97: // spellings for those conditions across the warm-fallback hook helpers.\n98: const RETRYABLE_REASONS = new Set([\n99:   'bad_json_response',\n100:   'socket_absent',\n101:   'timeout',\n102:   'warm_daemon_unavailable',\n103: ]);\n104: \n105: // ───────────────────────────────────────────────────────────────\n106: // 4. HELPERS\n107: // ───────────────────────────────────────────────────────────────\n108: \n109: function isRecord(value: unknown): value is Record<string, unknown> {\n110:   return typeof value === 'object' && value !== null && !Array.isArray(value);\n111: }\n112: \n113: function normalizeSkillAdvisorCliFallbackReason(reason: string | null | undefined, exitCode: number | null, status: WarmSkillAdvisorCliFallbackStatus): string {\n114:   const trimmed = typeof reason === 'string' ? reason.trim() : '';\n115:   if (trimmed) {\n116:     return trimmed\n117:       .replace(/^CLI_RETRYABLE_UNAVAILABLE\\s+exit\\s+75:\\s*/i, '')\n118:       .replace(/^CLI_/i, '')\n119:       .toLowerCase()\n120:       .replace(/[^a-z0-9]+/g, '_')\n121:       .replace(/^_+|_+$/g, '') || 'unknown';\n122:   }\n123:   if (status === 'ok') {\n124:     return 'ok';\n125:   }\n126:   return exitCode === null ? 'exit_unknown' : `exit_${exitCode}`;\n127: }\n128: \n129: export function skillAdvisorCliFallbackEnvelope(input: WarmSkillAdvisorCliFallbackEnvelopeInput): WarmSkillAdvisorCliFallbackEnvelope {\n130:   const exitCode = input.exitCode ?? null;\n131:   const reason = normalizeSkillAdvisorCliFallbackReason(input.reason, exitCode, input.status);\n132:   return {\n133:     status: input.status,\n134:     reason,\n135:     exitCode,\n136:     retryable: input.status !== 'ok' && (input.timedOut === true || exitCode === EXIT_RETRYABLE || RETRYABLE_REASONS.has(reason)),\n137:   };\n138: }\n139: \n140: function withCliFallbackEnvelope(\n141:   result: AdvisorHookResult,\n142:   envelope: WarmSkillAdvisorCliFallbackEnvelope,\n143: ): AdvisorHookResult & WarmSkillAdvisorCliFallbackEnvelope {\n144:   return { ...result, ...envelope };\n145: }\n146: \n147: function positiveIntFromEnv(value: string | undefined, fallback: number): number {\n148:   if (typeof value !== 'string' || value.trim().length === 0) {\n149:     return fallback;\n150:   }\n151:   const parsed = Number.parseInt(value, 10);\n152:   return Number.isFinite(parsed) && parsed > 0 ? parsed : fallback;\n153: }\n154: \n155: function clampUnitThreshold(value: number | undefined, fallback: number): number {\n156:   return typeof value === 'number' && Number.isFinite(value)\n157:     ? Math.min(1, Math.max(0, value))\n158:     : fallback;\n159: }\n160: \n161: export function resolveSkillAdvisorCliFallbackTimeoutMs(\n162:   hookBudgetMs?: number,\n163:   env: NodeJS.ProcessEnv = process.env,\n164: ): number {\n165:   if (hookBudgetMs === undefined || !Number.isFinite(hookBudgetMs) || hookBudgetMs <= 0) {\n166:     return positiveIntFromEnv(\n167:       env.SPECKIT_SKILL_ADVISOR_CLI_FALLBACK_TIMEOUT_MS,\n168:       DEFAULT_CLI_FALLBACK_TIMEOUT_MS,\n169:     );\n170:   }\n171:   // The caller budget is the hook's real deadline; clamping it to the fallback\n172:   // default would kill a warm CLI call inside its measured latency.\n173:   return Math.max(1, Math.floor(hookBudgetMs));\n174: }\n175: \n176: function findCliFallbackPaths(workspaceRoot: string, env: NodeJS.ProcessEnv): CliFallbackPaths | null {\n177:   let current = resolve(workspaceRoot || process.cwd());\n178:   for (let depth = 0; depth < 14; depth += 1) {\n179:     // The advisor CLI, its IPC bridge and the advisor database moved to the\n180:     // .skilled root; older checkouts and mirrors still know .opencode. Either\n181:     // root proves the same repository, but all three paths must come from that\n182:     // one root, never a mix, or a half-migrated checkout spawns a broken pair.\n183:     for (const rootName of ['.skilled', '.opencode']) {\n184:       const rootDir = join(current, rootName);\n185:       const cliPath = join(rootDir, 'bin', 'skill-advisor.cjs');\n186:       const bridgePath = join(rootDir, 'bin', 'lib', 'launcher-ipc-bridge.cjs');\n187:       const defaultDbDir = join(rootDir, 'skills', 'system-skill-advisor', 'runtime', 'database');\n188:       if (existsSync(cliPath) && existsSync(bridgePath)) {\n189:         return {\n190:           repoRoot: current,\n191:           cliPath,\n192:           bridgePath,\n193:           dbDir: resolve(env.SYSTEM_SKILL_ADVISOR_DB_DIR ?? defaultDbDir),\n194:         };\n195:       }\n196:     }\n197:     const parent = dirname(current);\n198:     if (parent === current) {\n199:       break;\n200:     }\n201:     current = parent;\n202:   }\n203:   return null;\n204: }\n205: \n206: function childEnvForCli(env: NodeJS.ProcessEnv): NodeJS.ProcessEnv {\n207:   return {\n208:     ...env,\n209:     SPECKIT_IPC_SOCKET_DIR: env.SPECKIT_IPC_SOCKET_DIR ?? DEFAULT_SOCKET_DIR,\n210:     SYSTEM_SKILL_ADVISOR_CLI_PROMPT_TIME: '1',\n211:   };\n212: }\n213: \n214: function capStdout(current: string, chunk: string): string {\n215:   if (current.length >= MAX_STDOUT_BYTES) {\n216:     return current;\n217:   }\n218:   return (current + chunk).slice(0, MAX_STDOUT_BYTES);\n219: }\n220: \n221: function runCliRecommend(args: {\n222:   readonly paths: CliFallbackPaths;\n223:   readonly prompt: string;\n224:   readonly options: SkillAdvisorCliFallbackOptions;\n225:   readonly env: NodeJS.ProcessEnv;\n226:   readonly timeoutMs: number;\n227: }): Promise<CliProcessResult> {\n228:   const payload = {\n229:     // The CLI refuses a longer prompt, so a longer one is sent as its head.\n230:     prompt: args.prompt.slice(0, ADVISOR_PROMPT_MAX_CHARS),\n231:     options: {\n232:       topK: 3,\n233:       includeAttribution: false,\n234:       includeAbstainReasons: true,\n235:       // The hook reads nothing out of the compiled route itself. It asks for the\n236:       // route only because the advisor derives the slash command from it, and a\n237:       // recommendation with no command cannot tell the reader which mode to run.\n238:       includeCompiledRoute: true,\n239:       // Each route is a subprocess inside the hook's time budget, and the brief\n240:       // leads with the top pick, so only that one is looked up.\n241:       compiledRouteTopOnly: true,\n242:       // Forward caller thresholds so the CLI scorer applies them; without this\n243:       // the scorer uses its own defaults and thresholdsFrom trusts the echoed\n244:       // defaults, silently discarding a caller's stricter thresholds.\n245:       confidenceThreshold: clampUnitThreshold(args.options.thresholdConfig?.confidenceThreshold, 0.8),\n246:       uncertaintyThreshold: clampUnitThreshold(args.options.thresholdConfig?.uncertaintyThreshold, 0.35),\n247:     },\n248:   };\n249:   return new Promise((resolvePromise) => {\n250:     let stdout = '';\n251:     let settled = false;\n252:     let timedOut = false;\n253:     const child = spawn(process.execPath, [\n254:       args.paths.cliPath,\n255:       'advisor_recommend',\n256:       '--json',\n257:       '-',\n258:       '--format',\n259:       'json',\n260:       '--timeout-ms',\n261:       String(args.timeoutMs),\n262:       // The CLI owns daemon reachability now: it starts the daemon when the socket is\n263:       // cold and bounds that wait itself. Without this flag the child env's prompt-time\n264:       // marker makes the CLI default to warm-only, which refuses with exit 75 and never\n265:       // starts anything, leaving every cold session with no brief at all.\n266:       '--no-warm-only',\n267:     ], {\n268:       cwd: args.paths.repoRoot,\n269:       env: childEnvForCli(args.env),\n270:       stdio: ['pipe', 'pipe', 'ignore'],\n271:       detached: true,\n272:     });\n273:     // The payload carries the user's prompt, so it goes on stdin rather than\n274:     // in argv, which any local user can read from the process table.\n275:     child.stdin?.on('error', () => undefined);\n276:     child.stdin?.end(JSON.stringify(payload));\n277:     const killProcessGroup = (): void => {\n278:       const pid = child.pid;\n279:       if (typeof pid !== 'number') return;\n280:       try {\n281:         // The shim runs the dist CLI as a grandchild via spawnSync; killing\n282:         // only the shim leaves that grandchild holding the stdout pipe.\n283:         process.kill(-pid, 'SIGKILL');\n284:       } catch {\n285:         // ESRCH: the group already exited.\n286:       }\n287:     };\n288:     const timer = setTimeout(() => {\n289:       timedOut = true;\n290:       killProcessGroup();\n291:     }, args.timeoutMs);\n292:     timer.unref?.();\n293:     const finish = (result: CliProcessResult): void => {\n294:       if (settled) return;\n295:       settled = true;\n296:       clearTimeout(timer);\n297:       resolvePromise(result);\n298:     };\n299:     const drainStdout = (): void => {\n300:       try {\n301:         const rest = child.stdout?.read() as string | null | undefined;\n302:         if (rest) {\n303:           stdout = capStdout(stdout, rest);\n304:         }\n305:       } catch {\n306:         // Best-effort drain only.\n307:       }\n308:     };\n309:     child.stdout?.setEncoding('utf8');\n310:     child.stdout?.on('data', (chunk: string) => {\n311:       stdout = capStdout(stdout, chunk);\n312:     });\n313:     child.once('error', (error: NodeJS.ErrnoException) => {\n314:       finish({ stdout, exitCode: null, signal: null, timedOut, spawnError: error.code ?? error.message });\n315:     });\n316:     child.once('exit', (exitCode: number | null, signal: NodeJS.Signals | null) => {\n317:       // 'close' never fires while a surviving grandchild holds the stdout\n318:       // pipe; settle shortly after exit so a held pipe cannot block the\n319:       // hook. 'close' below still wins the race in the normal case.\n320:       setTimeout(() => {\n321:         drainStdout();\n322:         finish({ stdout, exitCode, signal, timedOut, spawnError: null });\n323:       }, EXIT_SETTLE_GRACE_MS).unref?.();\n324:     });\n325:     child.once('close', (exitCode: number | null, signal: NodeJS.Signals | null) => {\n326:       finish({ stdout, exitCode, signal, timedOut, spawnError: null });\n327:     });\n328:   });\n329: }\n330: \n331: // A degraded answer is still an answer: the CLI spent its own local scorer because no\n332: // daemon answered, so the route is stale, not missing. Reporting it as unavailable is\n333: // what made the hook discard the payload and emit the directives alone.\n334: function freshnessFrom(value: unknown, degraded: boolean): AdvisorHookFreshness {\n335:   if (value === 'live' || value === 'stale' || value === 'absent' || value === 'unavailable') {\n336:     return value;\n337:   }\n338:   return degraded ? 'stale' : 'unavailable';\n339: }\n340: \n341: function thresholdsFrom(data: CliRecommendData, options: SkillAdvisorCliFallbackOptions): { readonly confidenceThreshold: number; readonly uncertaintyThreshold: number } {\n342:   const effective = isRecord(data.effectiveThresholds) ? data.effectiveThresholds : null;\n343:   const confidenceThreshold = typeof effective?.confidenceThreshold === 'number'\n344:     ? effective.confidenceThreshold\n345:     : options.thresholdConfig?.confidenceThreshold ?? 0.8;\n346:   const uncertaintyThreshold = typeof effective?.uncertaintyThreshold === 'number'\n347:     ? effective.uncertaintyThreshold\n348:     : options.thresholdConfig?.uncertaintyThreshold ?? 0.35;\n349:   return { confidenceThreshold, uncertaintyThreshold };\n350: }\n351: \n352: type CliAdvisorRecommendation = AdvisorRecommendation & {\n353:   readonly ambiguousWith?: readonly string[];\n354:   readonly heldBelow?: string;\n355:   // The slash command that runs the mode the advisor routed this skill to. Absent\n356:   // when the route names no single mode, and never derived here: the CLI owns it.\n357:   readonly command?: string;\n358: };\n359: \n360: function recommendationFromCli(value: unknown, thresholds: { readonly confidenceThreshold: number; readonly uncertaintyThreshold: number }): CliAdvisorRecommendation | null {\n361:   if (!isRecord(value) || typeof value.skillId !== 'string') {\n362:     return null;\n363:   }\n364:   const confidence = typeof value.confidence === 'number' ? value.confidence : 0;\n365:   const uncertainty = typeof value.uncertainty === 'number' ? value.uncertainty : 1;\n366:   return {\n367:     skill: value.skillId,\n368:     // A command row names the mode it runs, so the reader must keep that kind\n369:     // rather than having every CLI row flattened back to a skill.\n370:     kind: value.kind === 'skill' || value.kind === 'command' ? value.kind : 'skill',\n371:     confidence,\n372:     uncertainty,\n373:     passes_threshold: confidence >= thresholds.confidenceThreshold && uncertainty <= thresholds.uncertaintyThreshold,\n374:     ...(Array.isArray(value.ambiguousWith)\n375:       ? { ambiguousWith: value.ambiguousWith.filter((skill): skill is string => typeof skill === 'string') }\n376:       : {}),\n377:     // The brief re-derives ambiguity from these fields, so the typed-command hold\n378:     // must survive the trip or a pair the command already ranked reads as a tie.\n379:     ...(typeof value.heldBelow === 'string' ? { heldBelow: value.heldBelow } : {}),\n380:     // Kept only when it names something: an empty command would render a blank\n381:     // prompt where the reader expects a slash command to type.\n382:     ...(typeof value.command === 'string' && value.command.trim() !== '' ? { command: value.command } : {}),\n383:     // An unknown policy or a blank owner would render as if it were real, so each\n384:     // is kept only when its value is one a renderer knows how to print.\n385:     ...(value.policy === 'run' || value.policy === 'start' || value.policy === 'ask' ? { policy: value.policy } : {}),\n386:     ...(typeof value.ownerSkillId === 'string' && value.ownerSkillId.trim() !== '' ? { ownerSkillId: value.ownerSkillId } : {}),\n387:   };\n388: }\n389: \n390: function cacheHitFrom(data: CliRecommendData): boolean {\n391:   return isRecord(data.cache) && data.cache.hit === true;\n392: }\n393: \n394: function resultStatus(freshness: AdvisorHookFreshness, recommendations: readonly AdvisorRecommendation[]): WarmSkillAdvisorCliFallbackStatus {\n395:   if ((freshness === 'live' || freshness === 'stale') && recommendations.length > 0) {\n396:     return 'ok';\n397:   }\n398:   if (freshness === 'unavailable') {\n399:     return 'fail_open';\n400:   }\n401:   return 'skipped';\n402: }\n403: \n404: function failOpenResult(args: {\n405:   readonly startedAt: number;\n406:   readonly now: () => number;\n407:   readonly runtime: AdvisorRuntime;\n408:   readonly tokenCap: number;\n409:   readonly errorMessage: string;\n410:   readonly reason: string;\n411:   readonly exitCode: number | null;\n412:   readonly timedOut?: boolean;\n413:   readonly subprocessInvoked: boolean;\n414: }): AdvisorHookResult {\n415:   return withCliFallbackEnvelope({\n416:     status: 'fail_open',\n417:     freshness: 'unavailable',\n418:     brief: null,\n419:     recommendations: [],\n420:     diagnostics: {\n421:       errorCode: 'NON_ZERO_EXIT',\n422:       errorClass: 'unknown',\n423:       errorMessage: args.errorMessage,\n424:     },\n425:     metrics: {\n426:       durationMs: Number((args.now() - args.startedAt).toFixed(3)),\n427:       cacheHit: false,\n428:       subprocessInvoked: args.subprocessInvoked,\n429:       retriesAttempted: 0,\n430:       recommendationCount: 0,\n431:       tokenCap: args.tokenCap,\n432:     },\n433:     generatedAt: new Date().toISOString(),\n434:     sharedPayload: null,\n435:   }, skillAdvisorCliFallbackEnvelope({\n436:     status: 'fail_open',\n437:     reason: args.reason,\n438:     exitCode: args.exitCode,\n439:     timedOut: args.timedOut,\n440:   }));\n441: }\n442: \n443: type CliFallbackHookResult = AdvisorHookResult & {\n444:   readonly ambiguous?: boolean;\n445: };\n446: \n447: // ───────────────────────────────────────────────────────────────\n448: // 5. CORE LOGIC\n449: // ───────────────────────────────────────────────────────────────\n450: \n451: // Exported as a test seam. The diagnostics this builds are the only signal a\n452: // reader gets about why no brief appeared, and a wrong one here sends them\n453: // hunting a transport failure that never happened.\n454: export function resultFromCliData(args: {\n455:   readonly data: CliRecommendData;\n456:   readonly options: SkillAdvisorCliFallbackOptions;\n457:   readonly startedAt: number;\n458:   readonly now: () => number;\n459: }): AdvisorHookResult {\n460:   const degraded = args.data.degraded === true || args.data.source === LOCAL_SCORER_SOURCE;\n461:   const freshness = freshnessFrom(args.data.freshness, degraded);\n462:   const thresholds = thresholdsFrom(args.data, args.options);\n463:   const recommendations = Array.isArray(args.data.recommendations)\n464:     ? args.data.recommendations\n465:       .map((recommendation) => recommendationFromCli(recommendation, thresholds))\n466:       .filter((recommendation): recommendation is CliAdvisorRecommendation => Boolean(recommendation?.passes_threshold))\n467:     : [];\n468:   const ambiguous = typeof args.data.ambiguous === 'boolean' ? args.data.ambiguous : undefined;\n469:   const tokenCap = Math.min(Math.max(1, Math.floor(args.options.maxTokens ?? (ambiguous === true ? 120 : 80))), 120);\n470:   const status = resultStatus(freshness, recommendations);\n471:   const warnings = Array.isArray(args.data.warnings)\n472:     ? args.data.warnings.filter((value): value is string => typeof value === 'string')\n473:     : [];\n474:   // A live or stale advisor that returned nothing above the threshold answered\n475:   // the question; it simply had no skill to name. Reporting that as an outage\n476:   // sends a reader hunting a transport failure that never happened, which has\n477:   // already cost one long investigation.\n478:   const answeredWithNoMatch = freshness === 'live' || freshness === 'stale';\n479:   const reason = status === 'ok'\n480:     ? 'ok'\n481:     : answeredWithNoMatch\n482:       ? 'no_recommendation'\n483:       : (freshness === 'absent' ? 'advisor_absent' : 'advisor_unavailable');\n484:   const hookResult: CliFallbackHookResult = {\n485:     status,\n486:     freshness,\n487:     brief: null,\n488:     recommendations,\n489:     ...(ambiguous === undefined ? {} : { ambiguous }),\n490:     diagnostics: status === 'ok'\n491:       ? (freshness === 'stale' && warnings[0] ? { staleReason: warnings[0] } : null)\n492:       : answeredWithNoMatch\n493:         ? {\n494:           // No error code or class: nothing failed, so naming a failure class\n495:           // here is what made this look like an outage in the first place.\n496:           reason: 'no_recommendation',\n497:           errorMessage: 'CLI_ADVISOR_NO_MATCH',\n498:         }\n499:         : {\n500:           errorCode: 'NON_ZERO_EXIT',\n501:           errorClass: 'unknown',\n502:           errorMessage: freshness === 'absent' ? 'CLI_ADVISOR_ABSENT' : 'CLI_ADVISOR_UNAVAILABLE',\n503:         },\n504:     metrics: {\n505:       durationMs: Number((args.now() - args.startedAt).toFixed(3)),\n506:       cacheHit: cacheHitFrom(args.data),\n507:       subprocessInvoked: true,\n508:       retriesAttempted: 0,\n509:       recommendationCount: recommendations.length,\n510:       tokenCap,\n511:     },\n512:     generatedAt: new Date().toISOString(),\n513:     sharedPayload: null,\n514:   };\n515:   return withCliFallbackEnvelope(hookResult, skillAdvisorCliFallbackEnvelope({ status, reason, exitCode: 0 }));\n516: }\n517: \n518: function parseCliPayload(stdout: string): CliRecommendData | null {\n519:   try {\n520:     const parsed = JSON.parse(stdout) as unknown;\n521:     if (!isRecord(parsed) || !isRecord(parsed.data)) {\n522:       return null;\n523:     }\n524:     // degraded and source sit on the envelope, not inside data; fold them in so the\n525:     // freshness decision downstream can still recognise the local-scorer answer.\n526:     return {\n527:       ...parsed.data,\n528:       degraded: parsed.degraded,\n529:       source: parsed.source,\n530:     } as CliRecommendData;\n531:   } catch {\n532:     return null;\n533:   }\n534: }\n535: \n536: export async function buildSkillAdvisorBriefFromCli(\n537:   prompt: string,\n538:   options: SkillAdvisorCliFallbackOptions,\n539:   dependencies: SkillAdvisorCliFallbackDependencies = {},\n540: ): Promise<AdvisorHookResult> {\n541:   const env = dependencies.env ?? process.env;\n542:   const now = dependencies.now ?? performance.now.bind(performance);\n543:   const startedAt = now();\n544:   const timeoutMs = resolveSkillAdvisorCliFallbackTimeoutMs(options.timeoutMs, env);\n545:   const tokenCap = Math.min(Math.max(1, Math.floor(options.maxTokens ?? 80)), 120);\n546:   const paths = findCliFallbackPaths(options.workspaceRoot, env);\n547:   if (!paths) {\n548:     return failOpenResult({\n549:       startedAt,\n550:       now,\n551:       runtime: options.runtime,\n552:       tokenCap,\n553:       errorMessage: 'CLI_RETRYABLE_UNAVAILABLE exit 75: CLI assets missing',\n554:       reason: 'repo_paths_unavailable',\n555:       exitCode: null,\n556:       subprocessInvoked: false,\n557:     });\n558:   }\n559: \n560:   // The CLI is the only component that starts the daemon, so it is asked in every daemon\n561:   // state: a cold socket is a call the CLI answers by spawning and waiting, not a reason\n562:   // to skip the CLI and emit directives alone.\n563:   const remainingMs = Math.max(1, Math.floor(timeoutMs - (now() - startedAt)));\n564:   const cli = await runCliRecommend({ paths, prompt, options, env, timeoutMs: remainingMs });\n565:   if (cli.timedOut) {\n566:     return failOpenResult({\n567:       startedAt,\n568:       now,\n569:       runtime: options.runtime,\n570:       tokenCap,\n571:       errorMessage: 'CLI_RETRYABLE_UNAVAILABLE exit 75: CLI fallback timed out',\n572:       reason: 'timeout',\n573:       exitCode: EXIT_RETRYABLE,\n574:       timedOut: true,\n575:       subprocessInvoked: true,\n576:     });\n577:   }\n578:   if (cli.spawnError) {\n579:     return failOpenResult({\n580:       startedAt,\n581:       now,\n582:       runtime: options.runtime,\n583:       tokenCap,\n584:       errorMessage: `CLI_RETRYABLE_UNAVAILABLE exit 75: ${cli.spawnError}`,\n585:       reason: cli.spawnError,\n586:       exitCode: EXIT_RETRYABLE,\n587:       subprocessInvoked: true,\n588:     });\n589:   }\n590:   if (cli.exitCode !== 0 || cli.signal !== null) {\n591:     return failOpenResult({\n592:       startedAt,\n593:       now,\n594:       runtime: options.runtime,\n595:       tokenCap,\n596:       errorMessage: cli.exitCode === EXIT_RETRYABLE\n597:         ? 'CLI_RETRYABLE_EXIT_75'\n598:         : `CLI_EXIT_${cli.exitCode ?? 'SIGNAL'}`,\n599:       reason: cli.exitCode === EXIT_RETRYABLE ? 'exit_75' : `exit_${cli.exitCode ?? 'signal'}`,\n600:       exitCode: cli.exitCode,\n601:       subprocessInvoked: true,\n602:     });\n603:   }\n604:   const data = parseCliPayload(cli.stdout);\n605:   if (!data) {\n606:     return failOpenResult({\n607:       startedAt,\n608:       now,\n609:       runtime: options.runtime,\n610:       tokenCap,\n611:       errorMessage: 'CLI_RETRYABLE_UNAVAILABLE exit 75: bad JSON response',\n612:       reason: 'bad_json_response',\n613:       exitCode: EXIT_RETRYABLE,\n614:       subprocessInvoked: true,\n615:     });\n616:   }\n617:   return resultFromCliData({ data, options, startedAt, now });\n618: }","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/hooks/lib/skill-advisor-cli-fallback.ts, lines 1-618\n1: // ───────────────────────────────────────────────────────────────\n2: // MODULE: Skill Advisor CLI Fallback\n3: // ───────────────────────────────────────────────────────────────\n4: \n5: // ───────────────────────────────────────────────────────────────\n6: // 1. IMPORTS\n7: // ───────────────────────────────────────────────────────────────\n8: \n9: import { spawn } from 'node:child_process';\n10: import { existsSync } from 'node:fs';\n11: import { dirname, join, resolve } from 'node:path';\n12: import { performance } from 'node:perf_hooks';\n13: \n14: import type {\n15:   AdvisorHookFreshness,\n16:   AdvisorHookResult,\n17:   AdvisorRuntime,\n18:   SkillAdvisorBriefOptions,\n19: } from '../../runtime/lib/skill-advisor-brief.js';\n20: import type { AdvisorRecommendation } from '../../runtime/lib/subprocess.js';\n21: import { ADVISOR_PROMPT_MAX_CHARS } from '../../runtime/schemas/advisor-tool-schemas.js';\n22: \n23: // ───────────────────────────────────────────────────────────────\n24: // 2. TYPES\n25: // ───────────────────────────────────────────────────────────────\n26: \n27: interface CliFallbackPaths {\n28:   readonly repoRoot: string;\n29:   readonly cliPath: string;\n30:   readonly bridgePath: string;\n31:   readonly dbDir: string;\n32: }\n33: \n34: interface CliProcessResult {\n35:   readonly stdout: string;\n36:   readonly exitCode: number | null;\n37:   readonly signal: NodeJS.Signals | null;\n38:   readonly timedOut: boolean;\n39:   readonly spawnError: string | null;\n40: }\n41: \n42: interface CliRecommendData {\n43:   readonly freshness?: unknown;\n44:   readonly recommendations?: unknown;\n45:   readonly effectiveThresholds?: unknown;\n46:   readonly cache?: unknown;\n47:   readonly warnings?: unknown;\n48:   readonly ambiguous?: unknown;\n49:   // Envelope-level markers, folded into the data view by parseCliPayload so the\n50:   // freshness decision can tell a degraded local-scorer answer from a missing one.\n51:   readonly degraded?: unknown;\n52:   readonly source?: unknown;\n53: }\n54: \n55: export type WarmSkillAdvisorCliFallbackStatus = 'ok' | 'skipped' | 'fail_open';\n56: \n57: export interface WarmSkillAdvisorCliFallbackEnvelope {\n58:   readonly status: WarmSkillAdvisorCliFallbackStatus;\n59:   readonly reason: string;\n60:   readonly exitCode: number | null;\n61:   readonly retryable: boolean;\n62: }\n63: \n64: interface WarmSkillAdvisorCliFallbackEnvelopeInput {\n65:   readonly status: WarmSkillAdvisorCliFallbackStatus;\n66:   readonly reason?: string | null;\n67:   readonly exitCode?: number | null;\n68:   readonly timedOut?: boolean;\n69: }\n70: \n71: export interface SkillAdvisorCliFallbackOptions {\n72:   readonly workspaceRoot: string;\n73:   readonly runtime: AdvisorRuntime;\n74:   readonly timeoutMs?: number;\n75:   readonly thresholdConfig?: SkillAdvisorBriefOptions['thresholdConfig'];\n76:   readonly maxTokens?: number;\n77: }\n78: \n79: interface SkillAdvisorCliFallbackDependencies {\n80:   readonly env?: NodeJS.ProcessEnv;\n81:   readonly now?: () => number;\n82: }\n83: \n84: // ───────────────────────────────────────────────────────────────\n85: // 3. CONSTANTS\n86: // ───────────────────────────────────────────────────────────────\n87: \n88: const DEFAULT_CLI_FALLBACK_TIMEOUT_MS = 250;\n89: const EXIT_RETRYABLE = 75;\n90: const EXIT_SETTLE_GRACE_MS = 25;\n91: const DEFAULT_SOCKET_DIR = '/tmp/system-skill-advisor';\n92: const MAX_STDOUT_BYTES = 1024 * 1024;\n93: const LOCAL_SCORER_SOURCE = 'local-scorer';\n94: \n95: // Reason codes here are post-normalization and shared with the spec-kit warm\n96: // CLI fallback envelope; 'socket_absent' and 'timeout' are the canonical\n97: // spellings for those conditions across the warm-fallback hook helpers.\n98: const RETRYABLE_REASONS = new Set([\n99:   'bad_json_response',\n100:   'socket_absent',\n101:   'timeout',\n102:   'warm_daemon_unavailable',\n103: ]);\n104: \n105: // ───────────────────────────────────────────────────────────────\n106: // 4. HELPERS\n107: // ───────────────────────────────────────────────────────────────\n108: \n109: function isRecord(value: unknown): value is Record<string, unknown> {\n110:   return typeof value === 'object' && value !== null && !Array.isArray(value);\n111: }\n112: \n113: function normalizeSkillAdvisorCliFallbackReason(reason: string | null | undefined, exitCode: number | null, status: WarmSkillAdvisorCliFallbackStatus): string {\n114:   const trimmed = typeof reason === 'string' ? reason.trim() : '';\n115:   if (trimmed) {\n116:     return trimmed\n117:       .replace(/^CLI_RETRYABLE_UNAVAILABLE\\s+exit\\s+75:\\s*/i, '')\n118:       .replace(/^CLI_/i, '')\n119:       .toLowerCase()\n120:       .replace(/[^a-z0-9]+/g, '_')\n121:       .replace(/^_+|_+$/g, '') || 'unknown';\n122:   }\n123:   if (status === 'ok') {\n124:     return 'ok';\n125:   }\n126:   return exitCode === null ? 'exit_unknown' : `exit_${exitCode}`;\n127: }\n128: \n129: export function skillAdvisorCliFallbackEnvelope(input: WarmSkillAdvisorCliFallbackEnvelopeInput): WarmSkillAdvisorCliFallbackEnvelope {\n130:   const exitCode = input.exitCode ?? null;\n131:   const reason = normalizeSkillAdvisorCliFallbackReason(input.reason, exitCode, input.status);\n132:   return {\n133:     status: input.status,\n134:     reason,\n135:     exitCode,\n136:     retryable: input.status !== 'ok' && (input.timedOut === true || exitCode === EXIT_RETRYABLE || RETRYABLE_REASONS.has(reason)),\n137:   };\n138: }\n139: \n140: function withCliFallbackEnvelope(\n141:   result: AdvisorHookResult,\n142:   envelope: WarmSkillAdvisorCliFallbackEnvelope,\n143: ): AdvisorHookResult & WarmSkillAdvisorCliFallbackEnvelope {\n144:   return { ...result, ...envelope };\n145: }\n146: \n147: function positiveIntFromEnv(value: string | undefined, fallback: number): number {\n148:   if (typeof value !== 'string' || value.trim().length === 0) {\n149:     return fallback;\n150:   }\n151:   const parsed = Number.parseInt(value, 10);\n152:   return Number.isFinite(parsed) && parsed > 0 ? parsed : fallback;\n153: }\n154: \n155: function clampUnitThreshold(value: number | undefined, fallback: number): number {\n156:   return typeof value === 'number' && Number.isFinite(value)\n157:     ? Math.min(1, Math.max(0, value))\n158:     : fallback;\n159: }\n160: \n161: export function resolveSkillAdvisorCliFallbackTimeoutMs(\n162:   hookBudgetMs?: number,\n163:   env: NodeJS.ProcessEnv = process.env,\n164: ): number {\n165:   if (hookBudgetMs === undefined || !Number.isFinite(hookBudgetMs) || hookBudgetMs <= 0) {\n166:     return positiveIntFromEnv(\n167:       env.SPECKIT_SKILL_ADVISOR_CLI_FALLBACK_TIMEOUT_MS,\n168:       DEFAULT_CLI_FALLBACK_TIMEOUT_MS,\n169:     );\n170:   }\n171:   // The caller budget is the hook's real deadline; clamping it to the fallback\n172:   // default would kill a warm CLI call inside its measured latency.\n173:   return Math.max(1, Math.floor(hookBudgetMs));\n174: }\n175: \n176: function findCliFallbackPaths(workspaceRoot: string, env: NodeJS.ProcessEnv): CliFallbackPaths | null {\n177:   let current = resolve(workspaceRoot || process.cwd());\n178:   for (let depth = 0; depth < 14; depth += 1) {\n179:     // The advisor CLI, its IPC bridge and the advisor database moved to the\n180:     // .skilled root; older checkouts and mirrors still know .opencode. Either\n181:     // root proves the same repository, but all three paths must come from that\n182:     // one root, never a mix, or a half-migrated checkout spawns a broken pair.\n183:     for (const rootName of ['.skilled', '.opencode']) {\n184:       const rootDir = join(current, rootName);\n185:       const cliPath = join(rootDir, 'bin', 'skill-advisor.cjs');\n186:       const bridgePath = join(rootDir, 'bin', 'lib', 'launcher-ipc-bridge.cjs');\n187:       const defaultDbDir = join(rootDir, 'skills', 'system-skill-advisor', 'runtime', 'database');\n188:       if (existsSync(cliPath) && existsSync(bridgePath)) {\n189:         return {\n190:           repoRoot: current,\n191:           cliPath,\n192:           bridgePath,\n193:           dbDir: resolve(env.SYSTEM_SKILL_ADVISOR_DB_DIR ?? defaultDbDir),\n194:         };\n195:       }\n196:     }\n197:     const parent = dirname(current);\n198:     if (parent === current) {\n199:       break;\n200:     }\n201:     current = parent;\n202:   }\n203:   return null;\n204: }\n205: \n206: function childEnvForCli(env: NodeJS.ProcessEnv): NodeJS.ProcessEnv {\n207:   return {\n208:     ...env,\n209:     SPECKIT_IPC_SOCKET_DIR: env.SPECKIT_IPC_SOCKET_DIR ?? DEFAULT_SOCKET_DIR,\n210:     SYSTEM_SKILL_ADVISOR_CLI_PROMPT_TIME: '1',\n211:   };\n212: }\n213: \n214: function capStdout(current: string, chunk: string): string {\n215:   if (current.length >= MAX_STDOUT_BYTES) {\n216:     return current;\n217:   }\n218:   return (current + chunk).slice(0, MAX_STDOUT_BYTES);\n219: }\n220: \n221: function runCliRecommend(args: {\n222:   readonly paths: CliFallbackPaths;\n223:   readonly prompt: string;\n224:   readonly options: SkillAdvisorCliFallbackOptions;\n225:   readonly env: NodeJS.ProcessEnv;\n226:   readonly timeoutMs: number;\n227: }): Promise<CliProcessResult> {\n228:   const payload = {\n229:     // The CLI refuses a longer prompt, so a longer one is sent as its head.\n230:     prompt: args.prompt.slice(0, ADVISOR_PROMPT_MAX_CHARS),\n231:     options: {\n232:       topK: 3,\n233:       includeAttribution: false,\n234:       includeAbstainReasons: true,\n235:       // The hook reads nothing out of the compiled route itself. It asks for the\n236:       // route only because the advisor derives the slash command from it, and a\n237:       // recommendation with no command cannot tell the reader which mode to run.\n238:       includeCompiledRoute: true,\n239:       // Each route is a subprocess inside the hook's time budget, and the brief\n240:       // leads with the top pick, so only that one is looked up.\n241:       compiledRouteTopOnly: true,\n242:       // Forward caller thresholds so the CLI scorer applies them; without this\n243:       // the scorer uses its own defaults and thresholdsFrom trusts the echoed\n244:       // defaults, silently discarding a caller's stricter thresholds.\n245:       confidenceThreshold: clampUnitThreshold(args.options.thresholdConfig?.confidenceThreshold, 0.8),\n246:       uncertaintyThreshold: clampUnitThreshold(args.options.thresholdConfig?.uncertaintyThreshold, 0.35),\n247:     },\n248:   };\n249:   return new Promise((resolvePromise) => {\n250:     let stdout = '';\n251:     let settled = false;\n252:     let timedOut = false;\n253:     const child = spawn(process.execPath, [\n254:       args.paths.cliPath,\n255:       'advisor_recommend',\n256:       '--json',\n257:       '-',\n258:       '--format',\n259:       'json',\n260:       '--timeout-ms',\n261:       String(args.timeoutMs),\n262:       // The CLI owns daemon reachability now: it starts the daemon when the socket is\n263:       // cold and bounds that wait itself. Without this flag the child env's prompt-time\n264:       // marker makes the CLI default to warm-only, which refuses with exit 75 and never\n265:       // starts anything, leaving every cold session with no brief at all.\n266:       '--no-warm-only',\n267:     ], {\n268:       cwd: args.paths.repoRoot,\n269:       env: childEnvForCli(args.env),\n270:       stdio: ['pipe', 'pipe', 'ignore'],\n271:       detached: true,\n272:     });\n273:     // The payload carries the user's prompt, so it goes on stdin rather than\n274:     // in argv, which any local user can read from the process table.\n275:     child.stdin?.on('error', () => undefined);\n276:     child.stdin?.end(JSON.stringify(payload));\n277:     const killProcessGroup = (): void => {\n278:       const pid = child.pid;\n279:       if (typeof pid !== 'number') return;\n280:       try {\n281:         // The shim runs the dist CLI as a grandchild via spawnSync; killing\n282:         // only the shim leaves that grandchild holding the stdout pipe.\n283:         process.kill(-pid, 'SIGKILL');\n284:       } catch {\n285:         // ESRCH: the group already exited.\n286:       }\n287:     };\n288:     const timer = setTimeout(() => {\n289:       timedOut = true;\n290:       killProcessGroup();\n291:     }, args.timeoutMs);\n292:     timer.unref?.();\n293:     const finish = (result: CliProcessResult): void => {\n294:       if (settled) return;\n295:       settled = true;\n296:       clearTimeout(timer);\n297:       resolvePromise(result);\n298:     };\n299:     const drainStdout = (): void => {\n300:       try {\n301:         const rest = child.stdout?.read() as string | null | undefined;\n302:         if (rest) {\n303:           stdout = capStdout(stdout, rest);\n304:         }\n305:       } catch {\n306:         // Best-effort drain only.\n307:       }\n308:     };\n309:     child.stdout?.setEncoding('utf8');\n310:     child.stdout?.on('data', (chunk: string) => {\n311:       stdout = capStdout(stdout, chunk);\n312:     });\n313:     child.once('error', (error: NodeJS.ErrnoException) => {\n314:       finish({ stdout, exitCode: null, signal: null, timedOut, spawnError: error.code ?? error.message });\n315:     });\n316:     child.once('exit', (exitCode: number | null, signal: NodeJS.Signals | null) => {\n317:       // 'close' never fires while a surviving grandchild holds the stdout\n318:       // pipe; settle shortly after exit so a held pipe cannot block the\n319:       // hook. 'close' below still wins the race in the normal case.\n320:       setTimeout(() => {\n321:         drainStdout();\n322:         finish({ stdout, exitCode, signal, timedOut, spawnError: null });\n323:       }, EXIT_SETTLE_GRACE_MS).unref?.();\n324:     });\n325:     child.once('close', (exitCode: number | null, signal: NodeJS.Signals | null) => {\n326:       finish({ stdout, exitCode, signal, timedOut, spawnError: null });\n327:     });\n328:   });\n329: }\n330: \n331: // A degraded answer is still an answer: the CLI spent its own local scorer because no\n332: // daemon answered, so the route is stale, not missing. Reporting it as unavailable is\n333: // what made the hook discard the payload and emit the directives alone.\n334: function freshnessFrom(value: unknown, degraded: boolean): AdvisorHookFreshness {\n335:   if (value === 'live' || value === 'stale' || value === 'absent' || value === 'unavailable') {\n336:     return value;\n337:   }\n338:   return degraded ? 'stale' : 'unavailable';\n339: }\n340: \n341: function thresholdsFrom(data: CliRecommendData, options: SkillAdvisorCliFallbackOptions): { readonly confidenceThreshold: number; readonly uncertaintyThreshold: number } {\n342:   const effective = isRecord(data.effectiveThresholds) ? data.effectiveThresholds : null;\n343:   const confidenceThreshold = typeof effective?.confidenceThreshold === 'number'\n344:     ? effective.confidenceThreshold\n345:     : options.thresholdConfig?.confidenceThreshold ?? 0.8;\n346:   const uncertaintyThreshold = typeof effective?.uncertaintyThreshold === 'number'\n347:     ? effective.uncertaintyThreshold\n348:     : options.thresholdConfig?.uncertaintyThreshold ?? 0.35;\n349:   return { confidenceThreshold, uncertaintyThreshold };\n350: }\n351: \n352: type CliAdvisorRecommendation = AdvisorRecommendation & {\n353:   readonly ambiguousWith?: readonly string[];\n354:   readonly heldBelow?: string;\n355:   // The slash command that runs the mode the advisor routed this skill to. Absent\n356:   // when the route names no single mode, and never derived here: the CLI owns it.\n357:   readonly command?: string;\n358: };\n359: \n360: function recommendationFromCli(value: unknown, thresholds: { readonly confidenceThreshold: number; readonly uncertaintyThreshold: number }): CliAdvisorRecommendation | null {\n361:   if (!isRecord(value) || typeof value.skillId !== 'string') {\n362:     return null;\n363:   }\n364:   const confidence = typeof value.confidence === 'number' ? value.confidence : 0;\n365:   const uncertainty = typeof value.uncertainty === 'number' ? value.uncertainty : 1;\n366:   return {\n367:     skill: value.skillId,\n368:     // A command row names the mode it runs, so the reader must keep that kind\n369:     // rather than having every CLI row flattened back to a skill.\n370:     kind: value.kind === 'skill' || value.kind === 'command' ? value.kind : 'skill',\n371:     confidence,\n372:     uncertainty,\n373:     passes_threshold: confidence >= thresholds.confidenceThreshold && uncertainty <= thresholds.uncertaintyThreshold,\n374:     ...(Array.isArray(value.ambiguousWith)\n375:       ? { ambiguousWith: value.ambiguousWith.filter((skill): skill is string => typeof skill === 'string') }\n376:       : {}),\n377:     // The brief re-derives ambiguity from these fields, so the typed-command hold\n378:     // must survive the trip or a pair the command already ranked reads as a tie.\n379:     ...(typeof value.heldBelow === 'string' ? { heldBelow: value.heldBelow } : {}),\n380:     // Kept only when it names something: an empty command would render a blank\n381:     // prompt where the reader expects a slash command to type.\n382:     ...(typeof value.command === 'string' && value.command.trim() !== '' ? { command: value.command } : {}),\n383:     // An unknown policy or a blank owner would render as if it were real, so each\n384:     // is kept only when its value is one a renderer knows how to print.\n385:     ...(value.policy === 'run' || value.policy === 'start' || value.policy === 'ask' ? { policy: value.policy } : {}),\n386:     ...(typeof value.ownerSkillId === 'string' && value.ownerSkillId.trim() !== '' ? { ownerSkillId: value.ownerSkillId } : {}),\n387:   };\n388: }\n389: \n390: function cacheHitFrom(data: CliRecommendData): boolean {\n391:   return isRecord(data.cache) && data.cache.hit === true;\n392: }\n393: \n394: function resultStatus(freshness: AdvisorHookFreshness, recommendations: readonly AdvisorRecommendation[]): WarmSkillAdvisorCliFallbackStatus {\n395:   if ((freshness === 'live' || freshness === 'stale') && recommendations.length > 0) {\n396:     return 'ok';\n397:   }\n398:   if (freshness === 'unavailable') {\n399:     return 'fail_open';\n400:   }\n401:   return 'skipped';\n402: }\n403: \n404: function failOpenResult(args: {\n405:   readonly startedAt: number;\n406:   readonly now: () => number;\n407:   readonly runtime: AdvisorRuntime;\n408:   readonly tokenCap: number;\n409:   readonly errorMessage: string;\n410:   readonly reason: string;\n411:   readonly exitCode: number | null;\n412:   readonly timedOut?: boolean;\n413:   readonly subprocessInvoked: boolean;\n414: }): AdvisorHookResult {\n415:   return withCliFallbackEnvelope({\n416:     status: 'fail_open',\n417:     freshness: 'unavailable',\n418:     brief: null,\n419:     recommendations: [],\n420:     diagnostics: {\n421:       errorCode: 'NON_ZERO_EXIT',\n422:       errorClass: 'unknown',\n423:       errorMessage: args.errorMessage,\n424:     },\n425:     metrics: {\n426:       durationMs: Number((args.now() - args.startedAt).toFixed(3)),\n427:       cacheHit: false,\n428:       subprocessInvoked: args.subprocessInvoked,\n429:       retriesAttempted: 0,\n430:       recommendationCount: 0,\n431:       tokenCap: args.tokenCap,\n432:     },\n433:     generatedAt: new Date().toISOString(),\n434:     sharedPayload: null,\n435:   }, skillAdvisorCliFallbackEnvelope({\n436:     status: 'fail_open',\n437:     reason: args.reason,\n438:     exitCode: args.exitCode,\n439:     timedOut: args.timedOut,\n440:   }));\n441: }\n442: \n443: type CliFallbackHookResult = AdvisorHookResult & {\n444:   readonly ambiguous?: boolean;\n445: };\n446: \n447: // ───────────────────────────────────────────────────────────────\n448: // 5. CORE LOGIC\n449: // ───────────────────────────────────────────────────────────────\n450: \n451: // Exported as a test seam. The diagnostics this builds are the only signal a\n452: // reader gets about why no brief appeared, and a wrong one here sends them\n453: // hunting a transport failure that never happened.\n454: export function resultFromCliData(args: {\n455:   readonly data: CliRecommendData;\n456:   readonly options: SkillAdvisorCliFallbackOptions;\n457:   readonly startedAt: number;\n458:   readonly now: () => number;\n459: }): AdvisorHookResult {\n460:   const degraded = args.data.degraded === true || args.data.source === LOCAL_SCORER_SOURCE;\n461:   const freshness = freshnessFrom(args.data.freshness, degraded);\n462:   const thresholds = thresholdsFrom(args.data, args.options);\n463:   const recommendations = Array.isArray(args.data.recommendations)\n464:     ? args.data.recommendations\n465:       .map((recommendation) => recommendationFromCli(recommendation, thresholds))\n466:       .filter((recommendation): recommendation is CliAdvisorRecommendation => Boolean(recommendation?.passes_threshold))\n467:     : [];\n468:   const ambiguous = typeof args.data.ambiguous === 'boolean' ? args.data.ambiguous : undefined;\n469:   const tokenCap = Math.min(Math.max(1, Math.floor(args.options.maxTokens ?? (ambiguous === true ? 120 : 80))), 120);\n470:   const status = resultStatus(freshness, recommendations);\n471:   const warnings = Array.isArray(args.data.warnings)\n472:     ? args.data.warnings.filter((value): value is string => typeof value === 'string')\n473:     : [];\n474:   // A live or stale advisor that returned nothing above the threshold answered\n475:   // the question; it simply had no skill to name. Reporting that as an outage\n476:   // sends a reader hunting a transport failure that never happened, which has\n477:   // already cost one long investigation.\n478:   const answeredWithNoMatch = freshness === 'live' || freshness === 'stale';\n479:   const reason = status === 'ok'\n480:     ? 'ok'\n481:     : answeredWithNoMatch\n482:       ? 'no_recommendation'\n483:       : (freshness === 'absent' ? 'advisor_absent' : 'advisor_unavailable');\n484:   const hookResult: CliFallbackHookResult = {\n485:     status,\n486:     freshness,\n487:     brief: null,\n488:     recommendations,\n489:     ...(ambiguous === undefined ? {} : { ambiguous }),\n490:     diagnostics: status === 'ok'\n491:       ? (freshness === 'stale' && warnings[0] ? { staleReason: warnings[0] } : null)\n492:       : answeredWithNoMatch\n493:         ? {\n494:           // No error code or class: nothing failed, so naming a failure class\n495:           // here is what made this look like an outage in the first place.\n496:           reason: 'no_recommendation',\n497:           errorMessage: 'CLI_ADVISOR_NO_MATCH',\n498:         }\n499:         : {\n500:           errorCode: 'NON_ZERO_EXIT',\n501:           errorClass: 'unknown',\n502:           errorMessage: freshness === 'absent' ? 'CLI_ADVISOR_ABSENT' : 'CLI_ADVISOR_UNAVAILABLE',\n503:         },\n504:     metrics: {\n505:       durationMs: Number((args.now() - args.startedAt).toFixed(3)),\n506:       cacheHit: cacheHitFrom(args.data),\n507:       subprocessInvoked: true,\n508:       retriesAttempted: 0,\n509:       recommendationCount: recommendations.length,\n510:       tokenCap,\n511:     },\n512:     generatedAt: new Date().toISOString(),\n513:     sharedPayload: null,\n514:   };\n515:   return withCliFallbackEnvelope(hookResult, skillAdvisorCliFallbackEnvelope({ status, reason, exitCode: 0 }));\n516: }\n517: \n518: function parseCliPayload(stdout: string): CliRecommendData | null {\n519:   try {\n520:     const parsed = JSON.parse(stdout) as unknown;\n521:     if (!isRecord(parsed) || !isRecord(parsed.data)) {\n522:       return null;\n523:     }\n524:     // degraded and source sit on the envelope, not inside data; fold them in so the\n525:     // freshness decision downstream can still recognise the local-scorer answer.\n526:     return {\n527:       ...parsed.data,\n528:       degraded: parsed.degraded,\n529:       source: parsed.source,\n530:     } as CliRecommendData;\n531:   } catch {\n532:     return null;\n533:   }\n534: }\n535: \n536: export async function buildSkillAdvisorBriefFromCli(\n537:   prompt: string,\n538:   options: SkillAdvisorCliFallbackOptions,\n539:   dependencies: SkillAdvisorCliFallbackDependencies = {},\n540: ): Promise<AdvisorHookResult> {\n541:   const env = dependencies.env ?? process.env;\n542:   const now = dependencies.now ?? performance.now.bind(performance);\n543:   const startedAt = now();\n544:   const timeoutMs = resolveSkillAdvisorCliFallbackTimeoutMs(options.timeoutMs, env);\n545:   const tokenCap = Math.min(Math.max(1, Math.floor(options.maxTokens ?? 80)), 120);\n546:   const paths = findCliFallbackPaths(options.workspaceRoot, env);\n547:   if (!paths) {\n548:     return failOpenResult({\n549:       startedAt,\n550:       now,\n551:       runtime: options.runtime,\n552:       tokenCap,\n553:       errorMessage: 'CLI_RETRYABLE_UNAVAILABLE exit 75: CLI assets missing',\n554:       reason: 'repo_paths_unavailable',\n555:       exitCode: null,\n556:       subprocessInvoked: false,\n557:     });\n558:   }\n559: \n560:   // The CLI is the only component that starts the daemon, so it is asked in every daemon\n561:   // state: a cold socket is a call the CLI answers by spawning and waiting, not a reason\n562:   // to skip the CLI and emit directives alone.\n563:   const remainingMs = Math.max(1, Math.floor(timeoutMs - (now() - startedAt)));\n564:   const cli = await runCliRecommend({ paths, prompt, options, env, timeoutMs: remainingMs });\n565:   if (cli.timedOut) {\n566:     return failOpenResult({\n567:       startedAt,\n568:       now,\n569:       runtime: options.runtime,\n570:       tokenCap,\n571:       errorMessage: 'CLI_RETRYABLE_UNAVAILABLE exit 75: CLI fallback timed out',\n572:       reason: 'timeout',\n573:       exitCode: EXIT_RETRYABLE,\n574:       timedOut: true,\n575:       subprocessInvoked: true,\n576:     });\n577:   }\n578:   if (cli.spawnError) {\n579:     return failOpenResult({\n580:       startedAt,\n581:       now,\n582:       runtime: options.runtime,\n583:       tokenCap,\n584:       errorMessage: `CLI_RETRYABLE_UNAVAILABLE exit 75: ${cli.spawnError}`,\n585:       reason: cli.spawnError,\n586:       exitCode: EXIT_RETRYABLE,\n587:       subprocessInvoked: true,\n588:     });\n589:   }\n590:   if (cli.exitCode !== 0 || cli.signal !== null) {\n591:     return failOpenResult({\n592:       startedAt,\n593:       now,\n594:       runtime: options.runtime,\n595:       tokenCap,\n596:       errorMessage: cli.exitCode === EXIT_RETRYABLE\n597:         ? 'CLI_RETRYABLE_EXIT_75'\n598:         : `CLI_EXIT_${cli.exitCode ?? 'SIGNAL'}`,\n599:       reason: cli.exitCode === EXIT_RETRYABLE ? 'exit_75' : `exit_${cli.exitCode ?? 'signal'}`,\n600:       exitCode: cli.exitCode,\n601:       subprocessInvoked: true,\n602:     });\n603:   }\n604:   const data = parseCliPayload(cli.stdout);\n605:   if (!data) {\n606:     return failOpenResult({\n607:       startedAt,\n608:       now,\n609:       runtime: options.runtime,\n610:       tokenCap,\n611:       errorMessage: 'CLI_RETRYABLE_UNAVAILABLE exit 75: bad JSON response',\n612:       reason: 'bad_json_response',\n613:       exitCode: EXIT_RETRYABLE,\n614:       subprocessInvoked: true,\n615:     });\n616:   }\n617:   return resultFromCliData({ data, options, startedAt, now });\n618: }"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/hooks/lib/skill-advisor-cli-fallback.ts\"}"},"time":{"start":1794544727873,"end":1794544728303}}}}
