    }\n   }\n \n-  const head = `Advisor: ${result.freshness}; use ${topLabel} `\n+  const head = `Advisor: ${result.freshness}; use ${headLabel} `\n     + `${formatScore(top.confidence)}/${formatScore(top.uncertainty)} pass.`;\n   const rendered = capWithCompanion(\n     head,\n M .skilled/skills/system-skill-advisor/runtime/lib/render.ts\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"cd /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research && git -c core.fsmonitor=false diff HEAD -- .skilled/skills/system-skill-advisor/runtime/lib/render.ts; git -c core.fsmonitor=false status --short --untracked-files=no -- .skilled/skills/system-skill-advisor/runtime/lib/render.ts\"}"},"time":{"start":1794544778226,"end":1794544779106}}}}
