{"type":"tool_use","timestamp":1794543540237,"sessionID":"ses_e2ce11fa0ffeKrU1dSi2GXzG1K","part":{"partID":"prt_1d321328a002X7obWR185ZMnrf","sessionID":"ses_e2ce11fa0ffeKrU1dSi2GXzG1K","messageID":"msg_1d321150c001KIBL725PPJanV7","type":"tool","id":"call_eb611745ef8e4aa8b2643886","tool":"write","state":{"status":"completed","input":{"path":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/tests/scorer/doctor-handoff-command.vitest.ts","content":"// ───────────────────────────────────────────────────────────────\n// MODULE: Doctor Hand-off Command\n// ───────────────────────────────────────────────────────────────\n\n// A doctor problem worded unlike any bridge phrase reaches the helper's own\n// ranker. When that ranker names a command that runs without asking, the operator\n// is offered that command, and /doctor:helper keeps the hand-off otherwise. These\n// cases pin which id the hand-off inserts and where it sits.\n\nimport { mkdtempSync, readFileSync } from 'node:fs';\nimport { tmpdir } from 'node:os';\nimport { dirname, join, resolve } from 'node:path';\nimport { fileURLToPath } from 'node:url';\n\nimport { afterAll, beforeAll, describe, expect, it, vi } from 'vitest';\nimport type {\n  AdvisorProjection,\n  AdvisorScoringOptions,\n  AdvisorScoringResult,\n} from '../../lib/scorer/types.js';\n\nconst HERE = dirname(fileURLToPath(import.meta.url));\nconst ROUTING = resolve(HERE, '../../scripts/routing-accuracy');\nconst BASELINE_PATH = join(ROUTING, 'scorer-eval-baseline.json');\nconst SENTINEL = '.skilled/skills/system-spec-kit/SKILL.md';\nconst DOCTOR_PREFIX = 'command-doctor-';\n\n// Private `local-*` skills linked in through this variable live outside the\n// checkout, so a pinned ordering measured on a clean checkout must not see them.\nconst PRIVATE_SKILL_ROOTS_ENV = 'SPECKIT_PRIVATE_SKILL_ROOTS';\nconst PREVIOUS_PRIVATE_SKILL_ROOTS = process.env[PRIVATE_SKILL_ROOTS_ENV];\n\nfunction restorePrivateSkillRoots(): void {\n  if (PREVIOUS_PRIVATE_SKILL_ROOTS === undefined) delete process.env[PRIVATE_SKILL_ROOTS_ENV];\n  else process.env[PRIVATE_SKILL_ROOTS_ENV] = PREVIOUS_PRIVATE_SKILL_ROOTS;\n}\n\n// Freeze scoring to the reproducible filesystem projection: an empty DB dir makes the\n// SQLite loader return null, semantic embeddings are disabled, and the native\n// lane-ranking overrides are cleared so the ordering is deterministic.\nfunction freezeEvalEnv(): void {\n  process.env.SYSTEM_SKILL_ADVISOR_DB_DIR = mkdtempSync(join(tmpdir(), 'advisor-doctor-handoff-'));\n  process.env.SKILL_ADVISOR_DISABLE_BUILTIN_SEMANTIC = '1';\n  process.env.SPECKIT_SKILL_ADVISOR_FORCE_LOCAL = '1';\n  delete process.env.SPECKIT_ADVISOR_LANE_WEIGHTS_JSON;\n  delete process.env.SPECKIT_ADVISOR_LANE_SHADOW_WEIGHTS_JSON;\n  delete process.env.SPECKIT_ADVISOR_BM25_LEXICAL_SHADOW;\n  delete process.env[PRIVATE_SKILL_ROOTS_ENV];\n}\n\nlet scoreAdvisorPrompt: (prompt: string, options: AdvisorScoringOptions) => AdvisorScoringResult;\nlet runnableDoctorBridgeId: (runnable: string, projection: AdvisorProjection) => string | undefined;\nlet projectInfo: AdvisorProjection;\nlet workspaceRoot = '';\n\n// The projection holds one bridge whose policy runs and one that asks, so a\n// runnable can be found only when it runs without confirmation.\nconst BRIDGE_PROJECTION = {\n  skills: [\n    { id: 'command-doctor-agents-md-check' },\n    { id: 'command-doctor-git-hooks' },\n  ],\n} as unknown as AdvisorProjection;\n\nfunction scoredIds(prompt: string): string[] {\n  return scoreAdvisorPrompt(prompt, { workspaceRoot, projection: projectInfo })\n    .recommendations.map((recommendation) => recommendation.skill);\n}\n\ndescribe('doctor hand-off command', () => {\n  beforeAll(async () => {\n    freezeEvalEnv();\n    const fusion = await import('../../lib/scorer/fusion.js');\n    const projectionModule = await import('../../lib/scorer/projection.js');\n    const workspace = await import('../../lib/utils/workspace-root.js');\n    scoreAdvisorPrompt = fusion.scoreAdvisorPrompt;\n    runnableDoctorBridgeId = fusion.runnableDoctorBridgeId;\n    workspaceRoot = workspace.findAdvisorWorkspaceRoot(HERE, { maxDepth: 14, sentinel: SENTINEL });\n\n    const baseline = JSON.parse(readFileSync(BASELINE_PATH, 'utf8')) as { readonly capturedAt: string };\n\n    // The derived lane discounts each skill by its age at scoring time, so score at the\n    // instant the accuracy baseline was captured; a later calendar day must not move a\n    // row that no change touched.\n    vi.useFakeTimers({ toFake: ['Date'] });\n    vi.setSystemTime(new Date(`${baseline.capturedAt}T00:00:00Z`));\n\n    projectInfo = await projectionModule.loadAdvisorProjection(workspaceRoot);\n  });\n\n  afterAll(() => {\n    vi.useRealTimers();\n    restorePrivateSkillRoots();\n  });\n\n  it('offers the ranked command that runs without asking', () => {\n    expect(scoredIds('confirm the AGENTS.md sections in this repo have not drifted')[0])\n      .toBe('command-doctor-agents-md-check');\n  });\n\n  it('offers the ranked ci report command', () => {\n    expect(scoredIds('show me every GitHub Actions workflow and whether each is enabled')[0])\n      .toBe('command-doctor-ci-report');\n  });\n\n  // A strong cue stands beside a passing skill, and the hand-off follows it rather\n  // than displacing it.\n  it('puts the ranked command after the passing skill', () => {\n    const ids = scoredIds('my research loop stopped converging and I cannot see why');\n\n    expect(ids.slice(0, 2)).toEqual(['system-deep-loop', 'command-doctor-deep-loop']);\n  });\n\n  it('falls back to the helper for a repair request with no ranked command', () => {\n    expect(scoredIds('I have a problem and want the right repair path suggested with reasons')[0])\n      .toBe('command-doctor-helper');\n  });\n\n  it('leaves a fixed problem with no doctor command', () => {\n    const doctorIds = scoredIds('much appreciated, that fixed the problem completely')\n      .filter((id) => id.startsWith(DOCTOR_PREFIX));\n\n    expect(doctorIds).toEqual([]);\n  });\n\n  it('leaves an ordinary problem beside a passing skill with no doctor command', () => {\n    const doctorIds = scoredIds('I have a problem with my CSS layout')\n      .filter((id) => id.startsWith(DOCTOR_PREFIX));\n\n    expect(doctorIds).toEqual([]);\n  });\n});\n\ndescribe('runnableDoctorBridgeId', () => {\n  it('finds a bridge whose policy runs', () => {\n    expect(runnableDoctorBridgeId('/doctor:agents-md check', BRIDGE_PROJECTION))\n      .toBe('command-doctor-agents-md-check');\n  });\n\n  it('finds no bridge when the command asks before it runs', () => {\n    expect(runnableDoctorBridgeId('/doctor:git hooks', BRIDGE_PROJECTION)).toBeUndefined();\n  });\n\n  it('finds no bridge the projection does not hold', () => {\n    expect(runnableDoctorBridgeId('/doctor:ci report', BRIDGE_PROJECTION)).toBeUndefined();\n  });\n});\n"},"output":"Created file successfully: .skilled/skills/system-skill-advisor/runtime/tests/scorer/doctor-handoff-command.vitest.ts","title":"write","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Created file successfully: .skilled/skills/system-skill-advisor/runtime/tests/scorer/doctor-handoff-command.vitest.ts"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/tests/scorer/doctor-handoff-command.vitest.ts\",\"content\":\"// ───────────────────────────────────────────────────────────────\\n// MODULE: Doctor Hand-off Command\\n// ───────────────────────────────────────────────────────────────\\n\\n// A doctor problem worded unlike any bridge phrase reaches the helper's own\\n// ranker. When that ranker names a command that runs without asking, the operator\\n// is offered that command, and /doctor:helper keeps the hand-off otherwise. These\\n// cases pin which id the hand-off inserts and where it sits.\\n\\nimport { mkdtempSync, readFileSync } from 'node:fs';\\nimport { tmpdir } from 'node:os';\\nimport { dirname, join, resolve } from 'node:path';\\nimport { fileURLToPath } from 'node:url';\\n\\nimport { afterAll, beforeAll, describe, expect, it, vi } from 'vitest';\\nimport type {\\n  AdvisorProjection,\\n  AdvisorScoringOptions,\\n  AdvisorScoringResult,\\n} from '../../lib/scorer/types.js';\\n\\nconst HERE = dirname(fileURLToPath(import.meta.url));\\nconst ROUTING = resolve(HERE, '../../scripts/routing-accuracy');\\nconst BASELINE_PATH = join(ROUTING, 'scorer-eval-baseline.json');\\nconst SENTINEL = '.skilled/skills/system-spec-kit/SKILL.md';\\nconst DOCTOR_PREFIX = 'command-doctor-';\\n\\n// Private `local-*` skills linked in through this variable live outside the\\n// checkout, so a pinned ordering measured on a clean checkout must not see them.\\nconst PRIVATE_SKILL_ROOTS_ENV = 'SPECKIT_PRIVATE_SKILL_ROOTS';\\nconst PREVIOUS_PRIVATE_SKILL_ROOTS = process.env[PRIVATE_SKILL_ROOTS_ENV];\\n\\nfunction restorePrivateSkillRoots(): void {\\n  if (PREVIOUS_PRIVATE_SKILL_ROOTS === undefined) delete process.env[PRIVATE_SKILL_ROOTS_ENV];\\n  else process.env[PRIVATE_SKILL_ROOTS_ENV] = PREVIOUS_PRIVATE_SKILL_ROOTS;\\n}\\n\\n// Freeze scoring to the reproducible filesystem projection: an empty DB dir makes the\\n// SQLite loader return null, semantic embeddings are disabled, and the native\\n// lane-ranking overrides are cleared so the ordering is deterministic.\\nfunction freezeEvalEnv(): void {\\n  process.env.SYSTEM_SKILL_ADVISOR_DB_DIR = mkdtempSync(join(tmpdir(), 'advisor-doctor-handoff-'));\\n  process.env.SKILL_ADVISOR_DISABLE_BUILTIN_SEMANTIC = '1';\\n  process.env.SPECKIT_SKILL_ADVISOR_FORCE_LOCAL = '1';\\n  delete process.env.SPECKIT_ADVISOR_LANE_WEIGHTS_JSON;\\n  delete process.env.SPECKIT_ADVISOR_LANE_SHADOW_WEIGHTS_JSON;\\n  delete process.env.SPECKIT_ADVISOR_BM25_LEXICAL_SHADOW;\\n  delete process.env[PRIVATE_SKILL_ROOTS_ENV];\\n}\\n\\nlet scoreAdvisorPrompt: (prompt: string, options: AdvisorScoringOptions) => AdvisorScoringResult;\\nlet runnableDoctorBridgeId: (runnable: string, projection: AdvisorProjection) => string | undefined;\\nlet projectInfo: AdvisorProjection;\\nlet workspaceRoot = '';\\n\\n// The projection holds one bridge whose policy runs and one that asks, so a\\n// runnable can be found only when it runs without confirmation.\\nconst BRIDGE_PROJECTION = {\\n  skills: [\\n    { id: 'command-doctor-agents-md-check' },\\n    { id: 'command-doctor-git-hooks' },\\n  ],\\n} as unknown as AdvisorProjection;\\n\\nfunction scoredIds(prompt: string): string[] {\\n  return scoreAdvisorPrompt(prompt, { workspaceRoot, projection: projectInfo })\\n    .recommendations.map((recommendation) => recommendation.skill);\\n}\\n\\ndescribe('doctor hand-off command', () => {\\n  beforeAll(async () => {\\n    freezeEvalEnv();\\n    const fusion = await import('../../lib/scorer/fusion.js');\\n    const projectionModule = await import('../../lib/scorer/projection.js');\\n    const workspace = await import('../../lib/utils/workspace-root.js');\\n    scoreAdvisorPrompt = fusion.scoreAdvisorPrompt;\\n    runnableDoctorBridgeId = fusion.runnableDoctorBridgeId;\\n    workspaceRoot = workspace.findAdvisorWorkspaceRoot(HERE, { maxDepth: 14, sentinel: SENTINEL });\\n\\n    const baseline = JSON.parse(readFileSync(BASELINE_PATH, 'utf8')) as { readonly capturedAt: string };\\n\\n    // The derived lane discounts each skill by its age at scoring time, so score at the\\n    // instant the accuracy baseline was captured; a later calendar day must not move a\\n    // row that no change touched.\\n    vi.useFakeTimers({ toFake: ['Date'] });\\n    vi.setSystemTime(new Date(`${baseline.capturedAt}T00:00:00Z`));\\n\\n    projectInfo = await projectionModule.loadAdvisorProjection(workspaceRoot);\\n  });\\n\\n  afterAll(() => {\\n    vi.useRealTimers();\\n    restorePrivateSkillRoots();\\n  });\\n\\n  it('offers the ranked command that runs without asking', () => {\\n    expect(scoredIds('confirm the AGENTS.md sections in this repo have not drifted')[0])\\n      .toBe('command-doctor-agents-md-check');\\n  });\\n\\n  it('offers the ranked ci report command', () => {\\n    expect(scoredIds('show me every GitHub Actions workflow and whether each is enabled')[0])\\n      .toBe('command-doctor-ci-report');\\n  });\\n\\n  // A strong cue stands beside a passing skill, and the hand-off follows it rather\\n  // than displacing it.\\n  it('puts the ranked command after the passing skill', () => {\\n    const ids = scoredIds('my research loop stopped converging and I cannot see why');\\n\\n    expect(ids.slice(0, 2)).toEqual(['system-deep-loop', 'command-doctor-deep-loop']);\\n  });\\n\\n  it('falls back to the helper for a repair request with no ranked command', () => {\\n    expect(scoredIds('I have a problem and want the right repair path suggested with reasons')[0])\\n      .toBe('command-doctor-helper');\\n  });\\n\\n  it('leaves a fixed problem with no doctor command', () => {\\n    const doctorIds = scoredIds('much appreciated, that fixed the problem completely')\\n      .filter((id) => id.startsWith(DOCTOR_PREFIX));\\n\\n    expect(doctorIds).toEqual([]);\\n  });\\n\\n  it('leaves an ordinary problem beside a passing skill with no doctor command', () => {\\n    const doctorIds = scoredIds('I have a problem with my CSS layout')\\n      .filter((id) => id.startsWith(DOCTOR_PREFIX));\\n\\n    expect(doctorIds).toEqual([]);\\n  });\\n});\\n\\ndescribe('runnableDoctorBridgeId', () => {\\n  it('finds a bridge whose policy runs', () => {\\n    expect(runnableDoctorBridgeId('/doctor:agents-md check', BRIDGE_PROJECTION))\\n      .toBe('command-doctor-agents-md-check');\\n  });\\n\\n  it('finds no bridge when the command asks before it runs', () => {\\n    expect(runnableDoctorBridgeId('/doctor:git hooks', BRIDGE_PROJECTION)).toBeUndefined();\\n  });\\n\\n  it('finds no bridge the projection does not hold', () => {\\n    expect(runnableDoctorBridgeId('/doctor:ci report', BRIDGE_PROJECTION)).toBeUndefined();\\n  });\\n});\\n\"}"},"time":{"start":1794543530634,"end":1794543540237}}}}
