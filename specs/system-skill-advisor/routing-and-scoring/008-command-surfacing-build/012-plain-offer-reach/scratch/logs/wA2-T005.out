{"type":"tool_use","timestamp":1794543441729,"sessionID":"ses_e2ce11fa0ffeKrU1dSi2GXzG1K","part":{"partID":"prt_1d31fd5f8001v0o17KCCglmv6N","sessionID":"ses_e2ce11fa0ffeKrU1dSi2GXzG1K","messageID":"msg_1d31fcb040017FHiBYp4EXvXnh","type":"tool","id":"call_4212148143e14ad591711cd8","tool":"read","state":{"status":"completed","input":{"path":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/tests/scorer/doctor-ordering.vitest.ts"},"output":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/tests/scorer/doctor-ordering.vitest.ts, lines 1-439\n1: // ───────────────────────────────────────────────────────────────\n2: // MODULE: Doctor Bridge Ordering\n3: // ───────────────────────────────────────────────────────────────\n4: \n5: import { describe, expect, it } from 'vitest';\n6: import {\n7:   isDoctorCommandTyped,\n8:   keepPassingSkillsAboveDoctorBridges,\n9:   requireCommandPhraseAnchor,\n10: } from '../../lib/scorer/fusion.js';\n11: import type { AdvisorScoredRecommendation } from '../../lib/scorer/types.js';\n12: \n13: describe('isDoctorCommandTyped', () => {\n14:   it('accepts a leading doctor command after whitespace', () => {\n15:     expect(isDoctorCommandTyped('  /doctor:x')).toBe(true);\n16:   });\n17: \n18:   it.each([\n19:     ['run /doctor:x', true],\n20:     ['kick off /doctor:x', true],\n21:     ['rerun /doctor:x', false],\n22:     [\"don't run /doctor:x\", true],\n23:     ['run `/doctor:x`', false],\n24:     ['the hook that /doctor:git setup lists', false],\n25:     ['say \"run /doctor:x\"', false],\n26:   ] as const)('detects typed invocation boundaries in %s', (prompt, expected) => {\n27:     expect(isDoctorCommandTyped(prompt)).toBe(expected);\n28:   });\n29: });\n30: \n31: // A typed doctor command moves its matching passing bridge ahead of passing skills.\n32: describe('doctor bridge ordering', () => {\n33:   const leadPhrasesById = new Map<string, readonly string[]>([\n34:     ['command-doctor-env', ['check my environment variables']],\n35:   ]);\n36: \n37:   it('moves a doctor bridge below the passing skill', () => {\n38:     const ranked = [\n39:       rec('command-doctor-git-setup', 'command', true),\n40:       rec('sk-git', 'skill', true),\n41:     ];\n42: \n43:     const result = keepPassingSkillsAboveDoctorBridges(ranked, 'check my git hooks setup');\n44: \n45:     expect(result.map((recommendation) => recommendation.skill)).toEqual([\n46:       'sk-git',\n47:       'command-doctor-git-setup',\n48:     ]);\n49:   });\n50: \n51:   it('moves passing doctor bridges after the second passing skill in order', () => {\n52:     const ranked = [\n53:       rec('command-doctor-a', 'command', true),\n54:       rec('sk-code', 'skill', true),\n55:       rec('command-doctor-b', 'command', true),\n56:       rec('sk-git', 'skill', true),\n57:       rec('sk-ops', 'skill', true),\n58:       rec('sk-doc', 'skill', false),\n59:     ];\n60: \n61:     const result = keepPassingSkillsAboveDoctorBridges(ranked, 'check my git hooks setup');\n62: \n63:     expect(result.map((recommendation) => recommendation.skill)).toEqual([\n64:       'sk-code',\n65:       'sk-git',\n66:       'command-doctor-a',\n67:       'command-doctor-b',\n68:       'sk-ops',\n69:       'sk-doc',\n70:     ]);\n71:   });\n72: \n73:   it('puts a passing doctor bridge at index two when three skills pass', () => {\n74:     const ranked = [\n75:       rec('sk-code', 'skill', true),\n76:       rec('sk-git', 'skill', true),\n77:       rec('sk-doc', 'skill', true),\n78:       rec('command-doctor-setup', 'command', true),\n79:     ];\n80: \n81:     const result = keepPassingSkillsAboveDoctorBridges(ranked, 'check my tooling');\n82: \n83:     expect(result.map((recommendation) => recommendation.skill)).toEqual([\n84:       'sk-code',\n85:       'sk-git',\n86:       'command-doctor-setup',\n87:       'sk-doc',\n88:     ]);\n89:   });\n90: \n91:   it('moves a matching lead-phrase bridge ahead of a passing skill', () => {\n92:     const ranked = [\n93:       rec('sk-env', 'skill', true),\n94:       rec('command-doctor-env', 'command', true),\n95:     ];\n96: \n97:     const result = keepPassingSkillsAboveDoctorBridges(\n98:       ranked,\n99:       'check my environment variables',\n100:       leadPhrasesById,\n101:     );\n102: \n103:     expect(result.map((recommendation) => recommendation.skill)).toEqual([\n104:       'command-doctor-env',\n105:       'sk-env',\n106:     ]);\n107:   });\n108: \n109:   it('keeps the skill-first order when no lead-phrase map is passed', () => {\n110:     const ranked = [\n111:       rec('sk-env', 'skill', true),\n112:       rec('command-doctor-env', 'command', true),\n113:     ];\n114: \n115:     const result = keepPassingSkillsAboveDoctorBridges(ranked, 'check my environment variables');\n116: \n117:     expect(result.map((recommendation) => recommendation.skill)).toEqual([\n118:       'sk-env',\n119:       'command-doctor-env',\n120:     ]);\n121:   });\n122: \n123:   it('does not match a partial lead phrase', () => {\n124:     const ranked = [\n125:       rec('sk-env', 'skill', true),\n126:       rec('command-doctor-env', 'command', true),\n127:     ];\n128: \n129:     const result = keepPassingSkillsAboveDoctorBridges(\n130:       ranked,\n131:       'environment variables',\n132:       leadPhrasesById,\n133:     );\n134: \n135:     expect(result.map((recommendation) => recommendation.skill)).toEqual([\n136:       'sk-env',\n137:       'command-doctor-env',\n138:     ]);\n139:   });\n140: \n141:   it('does not promote a non-passing lead-phrase bridge', () => {\n142:     const ranked = [\n143:       rec('sk-env', 'skill', true),\n144:       rec('command-doctor-env', 'command', false),\n145:     ];\n146: \n147:     const result = keepPassingSkillsAboveDoctorBridges(\n148:       ranked,\n149:       'check my environment variables',\n150:       leadPhrasesById,\n151:     );\n152: \n153:     expect(result.map((recommendation) => recommendation.skill)).toEqual([\n154:       'sk-env',\n155:       'command-doctor-env',\n156:     ]);\n157:   });\n158: \n159:   it('moves the invoked passing doctor bridge first', () => {\n160:     const ranked = [\n161:       rec('sk-code', 'skill', true),\n162:       rec('command-doctor-setup', 'command', true),\n163:     ];\n164: \n165:     const result = keepPassingSkillsAboveDoctorBridges(\n166:       ranked,\n167:       'please run /doctor:setup for me',\n168:     );\n169: \n170:     expect(result.map((recommendation) => recommendation.skill)).toEqual([\n171:       'command-doctor-setup',\n172:       'sk-code',\n173:     ]);\n174:   });\n175: \n176:   it('keeps a doctor bridge first when the prompt types a doctor slash command', () => {\n177:     const ranked = [\n178:       rec('command-doctor-git', 'command', true),\n179:       rec('command-doctor-git-setup', 'command', true),\n180:       rec('sk-git', 'skill', true),\n181:     ];\n182: \n183:     const result = keepPassingSkillsAboveDoctorBridges(\n184:       ranked,\n185:       '/doctor:git setup lists',\n186:     );\n187: \n188:     expect(result.map((recommendation) => recommendation.skill)).toEqual([\n189:       'command-doctor-git-setup',\n190:       'command-doctor-git',\n191:       'sk-git',\n192:     ]);\n193:   });\n194: \n195:   it('moves a doctor bridge below the passing skill when the prompt quotes the command', () => {\n196:     const ranked = [\n197:       rec('command-doctor-git-setup', 'command', true),\n198:       rec('sk-git', 'skill', true),\n199:     ];\n200: \n201:     const result = keepPassingSkillsAboveDoctorBridges(\n202:       ranked,\n203:       'see the output of `/doctor:git setup`',\n204:     );\n205: \n206:     expect(result.map((recommendation) => recommendation.skill)).toEqual([\n207:       'sk-git',\n208:       'command-doctor-git-setup',\n209:     ]);\n210:   });\n211: \n212:   it('puts the matching skill bridge first when its id appears in the slash command', () => {\n213:     const ranked = [\n214:       rec('sk-code', 'skill', true),\n215:       rec('command-doctor-sk-code-setup', 'command', true),\n216:     ];\n217: \n218:     const result = keepPassingSkillsAboveDoctorBridges(ranked, '/doctor:sk-code setup');\n219: \n220:     expect(result.map((recommendation) => recommendation.skill)).toEqual([\n221:       'command-doctor-sk-code-setup',\n222:       'sk-code',\n223:     ]);\n224:   });\n225: \n226:   it.each([\n227:     ['/doctor:ci toggle', 'command-doctor-ci-report', 'command-doctor-ci-toggle'],\n228:     ['/doctor:ci scaffold', 'command-doctor-ci-report', 'command-doctor-ci-scaffold'],\n229:     ['/doctor:git standards', 'command-doctor-git-setup', 'command-doctor-git-standards'],\n230:     ['/doctor:sk-code quality', 'command-doctor-sk-code-setup', 'command-doctor-sk-code-quality'],\n231:   ] as const)('puts the typed sibling target of %s ahead of its default target', (prompt, defaultTarget, typedTarget) => {\n232:     const ranked = [\n233:       rec(defaultTarget, 'command', true),\n234:       rec(typedTarget, 'command', true),\n235:       rec('sk-code', 'skill', true),\n236:     ];\n237: \n238:     const result = keepPassingSkillsAboveDoctorBridges(ranked, prompt);\n239: \n240:     expect(result.map((recommendation) => recommendation.skill)).toEqual([\n241:       typedTarget,\n242:       defaultTarget,\n243:       'sk-code',\n244:     ]);\n245:   });\n246: \n247:   it('keeps scored order when a typed command has no matching passing bridge', () => {\n248:     const ranked = [\n249:       rec('sk-code', 'skill', true),\n250:       rec('command-doctor-setup', 'command', true),\n251:     ];\n252: \n253:     const result = keepPassingSkillsAboveDoctorBridges(ranked, '/doctor:sk-code');\n254: \n255:     expect(result.map((recommendation) => recommendation.skill)).toEqual([\n256:       'sk-code',\n257:       'command-doctor-setup',\n258:     ]);\n259:   });\n260: \n261:   it('keeps a nonpassing doctor bridge in place while moving passing bridges', () => {\n262:     const ranked = [\n263:       rec('command-doctor-setup', 'command', true),\n264:       rec('sk-code', 'skill', true),\n265:       rec('sk-git', 'skill', true),\n266:       rec('command-doctor-stale', 'command', false),\n267:     ];\n268: \n269:     const result = keepPassingSkillsAboveDoctorBridges(ranked, 'check my tools');\n270: \n271:     expect(result.map((recommendation) => recommendation.skill)).toEqual([\n272:       'sk-code',\n273:       'sk-git',\n274:       'command-doctor-setup',\n275:       'command-doctor-stale',\n276:     ]);\n277:   });\n278: \n279:   it('keeps a doctor bridge first when no skill passes', () => {\n280:     const ranked = [\n281:       rec('command-doctor-setup', 'command', true),\n282:       rec('sk-code', 'skill', false),\n283:     ];\n284: \n285:     const result = keepPassingSkillsAboveDoctorBridges(ranked, 'check my git hooks setup');\n286: \n287:     expect(result.map((recommendation) => recommendation.skill)).toEqual([\n288:       'command-doctor-setup',\n289:       'sk-code',\n290:     ]);\n291:   });\n292: \n293:   it('leaves non-doctor commands where they are', () => {\n294:     const ranked = [\n295:       rec('memory:save', 'command', true),\n296:       rec('system-spec-kit', 'skill', true),\n297:     ];\n298: \n299:     const result = keepPassingSkillsAboveDoctorBridges(ranked, 'save context');\n300: \n301:     expect(result.map((recommendation) => recommendation.skill)).toEqual([\n302:       'memory:save',\n303:       'system-spec-kit',\n304:     ]);\n305:   });\n306: \n307:   it('does not mutate its input array', () => {\n308:     const ranked = Object.freeze([\n309:       rec('command-doctor-git-setup', 'command', true),\n310:       rec('sk-git', 'skill', true),\n311:     ]);\n312: \n313:     expect(() => keepPassingSkillsAboveDoctorBridges(ranked, 'check my git hooks setup')).not.toThrow();\n314: \n315:     expect(ranked.map((recommendation) => recommendation.skill)).toEqual([\n316:       'command-doctor-git-setup',\n317:       'sk-git',\n318:     ]);\n319:   });\n320: });\n321: \n322: describe('requireCommandPhraseAnchor', () => {\n323:   const withLanes = (\n324:     recommendation: AdvisorScoredRecommendation,\n325:     laneContributions: AdvisorScoredRecommendation['laneContributions'],\n326:   ): AdvisorScoredRecommendation => ({ ...recommendation, laneContributions });\n327: \n328:   it('drops a doctor bridge that passed on shared tokens alone', () => {\n329:     const ranked = [\n330:       withLanes(rec('command-doctor-git-setup', 'command', true), [\n331:         {\n332:           lane: 'lexical',\n333:           rawScore: 0.25,\n334:           weightedScore: 0,\n335:           weight: 0,\n336:           evidence: ['token:git'],\n337:           shadowOnly: false,\n338:         },\n339:       ]),\n340:     ];\n341: \n342:     const result = requireCommandPhraseAnchor(ranked);\n343: \n344:     expect(result[0].passes_threshold).toBe(false);\n345:   });\n346: \n347:   it('keeps a doctor bridge anchored on its own phrase', () => {\n348:     const ranked = [\n349:       withLanes(rec('command-doctor-git-setup', 'command', true), [\n350:         {\n351:           lane: 'explicit_author',\n352:           rawScore: 1,\n353:           weightedScore: 0,\n354:           weight: 0,\n355:           evidence: ['author:disable comment hygiene gate'],\n356:           shadowOnly: false,\n357:         },\n358:       ]),\n359:     ];\n360: \n361:     const result = requireCommandPhraseAnchor(ranked);\n362: \n363:     expect(result[0].passes_threshold).toBe(true);\n364:   });\n365: \n366:   it('leaves skills alone while every command needs its own phrase', () => {\n367:     // Command phrases are everyday words, so a command row that matched only\n368:     // shared tokens would offer itself on vocabulary alone. The anchor applies\n369:     // to every command family, not to doctor bridges only.\n370:     const lexicalOnly: AdvisorScoredRecommendation['laneContributions'] = [\n371:       {\n372:         lane: 'lexical',\n373:         rawScore: 0.25,\n374:         weightedScore: 0,\n375:         weight: 0,\n376:         evidence: ['token:git'],\n377:         shadowOnly: false,\n378:       },\n379:     ];\n380:     const authored: AdvisorScoredRecommendation['laneContributions'] = [\n381:       {\n382:         lane: 'explicit_author',\n383:         rawScore: 1,\n384:         weightedScore: 0,\n385:         weight: 0,\n386:         evidence: ['author:save the session context'],\n387:         shadowOnly: false,\n388:       },\n389:     ];\n390: \n391:     const ranked = [\n392:       withLanes(rec('sk-git', 'skill', true), lexicalOnly),\n393:       withLanes(rec('memory:save', 'command', true), lexicalOnly),\n394:       withLanes(rec('create:agent', 'command', true), authored),\n395:     ];\n396: \n397:     const result = requireCommandPhraseAnchor(ranked);\n398: \n399:     expect(result.map((recommendation) => recommendation.passes_threshold)).toEqual([true, false, true]);\n400:   });\n401: \n402:   it('does not revive a doctor bridge that was not passing', () => {\n403:     const ranked = [\n404:       withLanes(rec('command-doctor-git-setup', 'command', false), [\n405:         {\n406:           lane: 'explicit_author',\n407:           rawScore: 1,\n408:           weightedScore: 0,\n409:           weight: 0,\n410:           evidence: ['author:disable comment hygiene gate'],\n411:           shadowOnly: false,\n412:         },\n413:       ]),\n414:     ];\n415: \n416:     const result = requireCommandPhraseAnchor(ranked);\n417: \n418:     expect(result[0].passes_threshold).toBe(false);\n419:   });\n420: });\n421: \n422: function rec(\n423:   skill: string,\n424:   kind: 'skill' | 'command',\n425:   passes: boolean,\n426: ): AdvisorScoredRecommendation {\n427:   return {\n428:     skill,\n429:     kind,\n430:     confidence: 0.9,\n431:     uncertainty: 0.2,\n432:     passes_threshold: passes,\n433:     reason: '',\n434:     score: 1,\n435:     laneContributions: [],\n436:     dominantLane: null,\n437:     lifecycleStatus: 'active',\n438:   };\n439: }","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/tests/scorer/doctor-ordering.vitest.ts, lines 1-439\n1: // ───────────────────────────────────────────────────────────────\n2: // MODULE: Doctor Bridge Ordering\n3: // ───────────────────────────────────────────────────────────────\n4: \n5: import { describe, expect, it } from 'vitest';\n6: import {\n7:   isDoctorCommandTyped,\n8:   keepPassingSkillsAboveDoctorBridges,\n9:   requireCommandPhraseAnchor,\n10: } from '../../lib/scorer/fusion.js';\n11: import type { AdvisorScoredRecommendation } from '../../lib/scorer/types.js';\n12: \n13: describe('isDoctorCommandTyped', () => {\n14:   it('accepts a leading doctor command after whitespace', () => {\n15:     expect(isDoctorCommandTyped('  /doctor:x')).toBe(true);\n16:   });\n17: \n18:   it.each([\n19:     ['run /doctor:x', true],\n20:     ['kick off /doctor:x', true],\n21:     ['rerun /doctor:x', false],\n22:     [\"don't run /doctor:x\", true],\n23:     ['run `/doctor:x`', false],\n24:     ['the hook that /doctor:git setup lists', false],\n25:     ['say \"run /doctor:x\"', false],\n26:   ] as const)('detects typed invocation boundaries in %s', (prompt, expected) => {\n27:     expect(isDoctorCommandTyped(prompt)).toBe(expected);\n28:   });\n29: });\n30: \n31: // A typed doctor command moves its matching passing bridge ahead of passing skills.\n32: describe('doctor bridge ordering', () => {\n33:   const leadPhrasesById = new Map<string, readonly string[]>([\n34:     ['command-doctor-env', ['check my environment variables']],\n35:   ]);\n36: \n37:   it('moves a doctor bridge below the passing skill', () => {\n38:     const ranked = [\n39:       rec('command-doctor-git-setup', 'command', true),\n40:       rec('sk-git', 'skill', true),\n41:     ];\n42: \n43:     const result = keepPassingSkillsAboveDoctorBridges(ranked, 'check my git hooks setup');\n44: \n45:     expect(result.map((recommendation) => recommendation.skill)).toEqual([\n46:       'sk-git',\n47:       'command-doctor-git-setup',\n48:     ]);\n49:   });\n50: \n51:   it('moves passing doctor bridges after the second passing skill in order', () => {\n52:     const ranked = [\n53:       rec('command-doctor-a', 'command', true),\n54:       rec('sk-code', 'skill', true),\n55:       rec('command-doctor-b', 'command', true),\n56:       rec('sk-git', 'skill', true),\n57:       rec('sk-ops', 'skill', true),\n58:       rec('sk-doc', 'skill', false),\n59:     ];\n60: \n61:     const result = keepPassingSkillsAboveDoctorBridges(ranked, 'check my git hooks setup');\n62: \n63:     expect(result.map((recommendation) => recommendation.skill)).toEqual([\n64:       'sk-code',\n65:       'sk-git',\n66:       'command-doctor-a',\n67:       'command-doctor-b',\n68:       'sk-ops',\n69:       'sk-doc',\n70:     ]);\n71:   });\n72: \n73:   it('puts a passing doctor bridge at index two when three skills pass', () => {\n74:     const ranked = [\n75:       rec('sk-code', 'skill', true),\n76:       rec('sk-git', 'skill', true),\n77:       rec('sk-doc', 'skill', true),\n78:       rec('command-doctor-setup', 'command', true),\n79:     ];\n80: \n81:     const result = keepPassingSkillsAboveDoctorBridges(ranked, 'check my tooling');\n82: \n83:     expect(result.map((recommendation) => recommendation.skill)).toEqual([\n84:       'sk-code',\n85:       'sk-git',\n86:       'command-doctor-setup',\n87:       'sk-doc',\n88:     ]);\n89:   });\n90: \n91:   it('moves a matching lead-phrase bridge ahead of a passing skill', () => {\n92:     const ranked = [\n93:       rec('sk-env', 'skill', true),\n94:       rec('command-doctor-env', 'command', true),\n95:     ];\n96: \n97:     const result = keepPassingSkillsAboveDoctorBridges(\n98:       ranked,\n99:       'check my environment variables',\n100:       leadPhrasesById,\n101:     );\n102: \n103:     expect(result.map((recommendation) => recommendation.skill)).toEqual([\n104:       'command-doctor-env',\n105:       'sk-env',\n106:     ]);\n107:   });\n108: \n109:   it('keeps the skill-first order when no lead-phrase map is passed', () => {\n110:     const ranked = [\n111:       rec('sk-env', 'skill', true),\n112:       rec('command-doctor-env', 'command', true),\n113:     ];\n114: \n115:     const result = keepPassingSkillsAboveDoctorBridges(ranked, 'check my environment variables');\n116: \n117:     expect(result.map((recommendation) => recommendation.skill)).toEqual([\n118:       'sk-env',\n119:       'command-doctor-env',\n120:     ]);\n121:   });\n122: \n123:   it('does not match a partial lead phrase', () => {\n124:     const ranked = [\n125:       rec('sk-env', 'skill', true),\n126:       rec('command-doctor-env', 'command', true),\n127:     ];\n128: \n129:     const result = keepPassingSkillsAboveDoctorBridges(\n130:       ranked,\n131:       'environment variables',\n132:       leadPhrasesById,\n133:     );\n134: \n135:     expect(result.map((recommendation) => recommendation.skill)).toEqual([\n136:       'sk-env',\n137:       'command-doctor-env',\n138:     ]);\n139:   });\n140: \n141:   it('does not promote a non-passing lead-phrase bridge', () => {\n142:     const ranked = [\n143:       rec('sk-env', 'skill', true),\n144:       rec('command-doctor-env', 'command', false),\n145:     ];\n146: \n147:     const result = keepPassingSkillsAboveDoctorBridges(\n148:       ranked,\n149:       'check my environment variables',\n150:       leadPhrasesById,\n151:     );\n152: \n153:     expect(result.map((recommendation) => recommendation.skill)).toEqual([\n154:       'sk-env',\n155:       'command-doctor-env',\n156:     ]);\n157:   });\n158: \n159:   it('moves the invoked passing doctor bridge first', () => {\n160:     const ranked = [\n161:       rec('sk-code', 'skill', true),\n162:       rec('command-doctor-setup', 'command', true),\n163:     ];\n164: \n165:     const result = keepPassingSkillsAboveDoctorBridges(\n166:       ranked,\n167:       'please run /doctor:setup for me',\n168:     );\n169: \n170:     expect(result.map((recommendation) => recommendation.skill)).toEqual([\n171:       'command-doctor-setup',\n172:       'sk-code',\n173:     ]);\n174:   });\n175: \n176:   it('keeps a doctor bridge first when the prompt types a doctor slash command', () => {\n177:     const ranked = [\n178:       rec('command-doctor-git', 'command', true),\n179:       rec('command-doctor-git-setup', 'command', true),\n180:       rec('sk-git', 'skill', true),\n181:     ];\n182: \n183:     const result = keepPassingSkillsAboveDoctorBridges(\n184:       ranked,\n185:       '/doctor:git setup lists',\n186:     );\n187: \n188:     expect(result.map((recommendation) => recommendation.skill)).toEqual([\n189:       'command-doctor-git-setup',\n190:       'command-doctor-git',\n191:       'sk-git',\n192:     ]);\n193:   });\n194: \n195:   it('moves a doctor bridge below the passing skill when the prompt quotes the command', () => {\n196:     const ranked = [\n197:       rec('command-doctor-git-setup', 'command', true),\n198:       rec('sk-git', 'skill', true),\n199:     ];\n200: \n201:     const result = keepPassingSkillsAboveDoctorBridges(\n202:       ranked,\n203:       'see the output of `/doctor:git setup`',\n204:     );\n205: \n206:     expect(result.map((recommendation) => recommendation.skill)).toEqual([\n207:       'sk-git',\n208:       'command-doctor-git-setup',\n209:     ]);\n210:   });\n211: \n212:   it('puts the matching skill bridge first when its id appears in the slash command', () => {\n213:     const ranked = [\n214:       rec('sk-code', 'skill', true),\n215:       rec('command-doctor-sk-code-setup', 'command', true),\n216:     ];\n217: \n218:     const result = keepPassingSkillsAboveDoctorBridges(ranked, '/doctor:sk-code setup');\n219: \n220:     expect(result.map((recommendation) => recommendation.skill)).toEqual([\n221:       'command-doctor-sk-code-setup',\n222:       'sk-code',\n223:     ]);\n224:   });\n225: \n226:   it.each([\n227:     ['/doctor:ci toggle', 'command-doctor-ci-report', 'command-doctor-ci-toggle'],\n228:     ['/doctor:ci scaffold', 'command-doctor-ci-report', 'command-doctor-ci-scaffold'],\n229:     ['/doctor:git standards', 'command-doctor-git-setup', 'command-doctor-git-standards'],\n230:     ['/doctor:sk-code quality', 'command-doctor-sk-code-setup', 'command-doctor-sk-code-quality'],\n231:   ] as const)('puts the typed sibling target of %s ahead of its default target', (prompt, defaultTarget, typedTarget) => {\n232:     const ranked = [\n233:       rec(defaultTarget, 'command', true),\n234:       rec(typedTarget, 'command', true),\n235:       rec('sk-code', 'skill', true),\n236:     ];\n237: \n238:     const result = keepPassingSkillsAboveDoctorBridges(ranked, prompt);\n239: \n240:     expect(result.map((recommendation) => recommendation.skill)).toEqual([\n241:       typedTarget,\n242:       defaultTarget,\n243:       'sk-code',\n244:     ]);\n245:   });\n246: \n247:   it('keeps scored order when a typed command has no matching passing bridge', () => {\n248:     const ranked = [\n249:       rec('sk-code', 'skill', true),\n250:       rec('command-doctor-setup', 'command', true),\n251:     ];\n252: \n253:     const result = keepPassingSkillsAboveDoctorBridges(ranked, '/doctor:sk-code');\n254: \n255:     expect(result.map((recommendation) => recommendation.skill)).toEqual([\n256:       'sk-code',\n257:       'command-doctor-setup',\n258:     ]);\n259:   });\n260: \n261:   it('keeps a nonpassing doctor bridge in place while moving passing bridges', () => {\n262:     const ranked = [\n263:       rec('command-doctor-setup', 'command', true),\n264:       rec('sk-code', 'skill', true),\n265:       rec('sk-git', 'skill', true),\n266:       rec('command-doctor-stale', 'command', false),\n267:     ];\n268: \n269:     const result = keepPassingSkillsAboveDoctorBridges(ranked, 'check my tools');\n270: \n271:     expect(result.map((recommendation) => recommendation.skill)).toEqual([\n272:       'sk-code',\n273:       'sk-git',\n274:       'command-doctor-setup',\n275:       'command-doctor-stale',\n276:     ]);\n277:   });\n278: \n279:   it('keeps a doctor bridge first when no skill passes', () => {\n280:     const ranked = [\n281:       rec('command-doctor-setup', 'command', true),\n282:       rec('sk-code', 'skill', false),\n283:     ];\n284: \n285:     const result = keepPassingSkillsAboveDoctorBridges(ranked, 'check my git hooks setup');\n286: \n287:     expect(result.map((recommendation) => recommendation.skill)).toEqual([\n288:       'command-doctor-setup',\n289:       'sk-code',\n290:     ]);\n291:   });\n292: \n293:   it('leaves non-doctor commands where they are', () => {\n294:     const ranked = [\n295:       rec('memory:save', 'command', true),\n296:       rec('system-spec-kit', 'skill', true),\n297:     ];\n298: \n299:     const result = keepPassingSkillsAboveDoctorBridges(ranked, 'save context');\n300: \n301:     expect(result.map((recommendation) => recommendation.skill)).toEqual([\n302:       'memory:save',\n303:       'system-spec-kit',\n304:     ]);\n305:   });\n306: \n307:   it('does not mutate its input array', () => {\n308:     const ranked = Object.freeze([\n309:       rec('command-doctor-git-setup', 'command', true),\n310:       rec('sk-git', 'skill', true),\n311:     ]);\n312: \n313:     expect(() => keepPassingSkillsAboveDoctorBridges(ranked, 'check my git hooks setup')).not.toThrow();\n314: \n315:     expect(ranked.map((recommendation) => recommendation.skill)).toEqual([\n316:       'command-doctor-git-setup',\n317:       'sk-git',\n318:     ]);\n319:   });\n320: });\n321: \n322: describe('requireCommandPhraseAnchor', () => {\n323:   const withLanes = (\n324:     recommendation: AdvisorScoredRecommendation,\n325:     laneContributions: AdvisorScoredRecommendation['laneContributions'],\n326:   ): AdvisorScoredRecommendation => ({ ...recommendation, laneContributions });\n327: \n328:   it('drops a doctor bridge that passed on shared tokens alone', () => {\n329:     const ranked = [\n330:       withLanes(rec('command-doctor-git-setup', 'command', true), [\n331:         {\n332:           lane: 'lexical',\n333:           rawScore: 0.25,\n334:           weightedScore: 0,\n335:           weight: 0,\n336:           evidence: ['token:git'],\n337:           shadowOnly: false,\n338:         },\n339:       ]),\n340:     ];\n341: \n342:     const result = requireCommandPhraseAnchor(ranked);\n343: \n344:     expect(result[0].passes_threshold).toBe(false);\n345:   });\n346: \n347:   it('keeps a doctor bridge anchored on its own phrase', () => {\n348:     const ranked = [\n349:       withLanes(rec('command-doctor-git-setup', 'command', true), [\n350:         {\n351:           lane: 'explicit_author',\n352:           rawScore: 1,\n353:           weightedScore: 0,\n354:           weight: 0,\n355:           evidence: ['author:disable comment hygiene gate'],\n356:           shadowOnly: false,\n357:         },\n358:       ]),\n359:     ];\n360: \n361:     const result = requireCommandPhraseAnchor(ranked);\n362: \n363:     expect(result[0].passes_threshold).toBe(true);\n364:   });\n365: \n366:   it('leaves skills alone while every command needs its own phrase', () => {\n367:     // Command phrases are everyday words, so a command row that matched only\n368:     // shared tokens would offer itself on vocabulary alone. The anchor applies\n369:     // to every command family, not to doctor bridges only.\n370:     const lexicalOnly: AdvisorScoredRecommendation['laneContributions'] = [\n371:       {\n372:         lane: 'lexical',\n373:         rawScore: 0.25,\n374:         weightedScore: 0,\n375:         weight: 0,\n376:         evidence: ['token:git'],\n377:         shadowOnly: false,\n378:       },\n379:     ];\n380:     const authored: AdvisorScoredRecommendation['laneContributions'] = [\n381:       {\n382:         lane: 'explicit_author',\n383:         rawScore: 1,\n384:         weightedScore: 0,\n385:         weight: 0,\n386:         evidence: ['author:save the session context'],\n387:         shadowOnly: false,\n388:       },\n389:     ];\n390: \n391:     const ranked = [\n392:       withLanes(rec('sk-git', 'skill', true), lexicalOnly),\n393:       withLanes(rec('memory:save', 'command', true), lexicalOnly),\n394:       withLanes(rec('create:agent', 'command', true), authored),\n395:     ];\n396: \n397:     const result = requireCommandPhraseAnchor(ranked);\n398: \n399:     expect(result.map((recommendation) => recommendation.passes_threshold)).toEqual([true, false, true]);\n400:   });\n401: \n402:   it('does not revive a doctor bridge that was not passing', () => {\n403:     const ranked = [\n404:       withLanes(rec('command-doctor-git-setup', 'command', false), [\n405:         {\n406:           lane: 'explicit_author',\n407:           rawScore: 1,\n408:           weightedScore: 0,\n409:           weight: 0,\n410:           evidence: ['author:disable comment hygiene gate'],\n411:           shadowOnly: false,\n412:         },\n413:       ]),\n414:     ];\n415: \n416:     const result = requireCommandPhraseAnchor(ranked);\n417: \n418:     expect(result[0].passes_threshold).toBe(false);\n419:   });\n420: });\n421: \n422: function rec(\n423:   skill: string,\n424:   kind: 'skill' | 'command',\n425:   passes: boolean,\n426: ): AdvisorScoredRecommendation {\n427:   return {\n428:     skill,\n429:     kind,\n430:     confidence: 0.9,\n431:     uncertainty: 0.2,\n432:     passes_threshold: passes,\n433:     reason: '',\n434:     score: 1,\n435:     laneContributions: [],\n436:     dominantLane: null,\n437:     lifecycleStatus: 'active',\n438:   };\n439: }"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/tests/scorer/doctor-ordering.vitest.ts\"}"},"time":{"start":1794543441400,"end":1794543441729}}}}
