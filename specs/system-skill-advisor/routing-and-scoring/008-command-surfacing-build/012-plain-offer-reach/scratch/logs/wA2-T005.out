{"type":"tool_use","timestamp":1794543614668,"sessionID":"ses_e2ce11fa0ffeKrU1dSi2GXzG1K","part":{"partID":"prt_1d322791f002K6YyZOobxZq0o5","sessionID":"ses_e2ce11fa0ffeKrU1dSi2GXzG1K","messageID":"msg_1d3226049001xxfb2XVppqbbfw","type":"tool","id":"call_a32717cbc5144929ba5341d0","tool":"read","state":{"status":"completed","input":{"path":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/tests/scorer/doctor-handoff-command.vitest.ts"},"output":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/tests/scorer/doctor-handoff-command.vitest.ts, lines 1-147\n1: // ───────────────────────────────────────────────────────────────\n2: // MODULE: Doctor Hand-off Command\n3: // ───────────────────────────────────────────────────────────────\n4: \n5: // A doctor problem worded unlike any bridge phrase reaches the helper's own\n6: // ranker. When that ranker names a command that runs without asking, the operator\n7: // is offered that command, and /doctor:helper keeps the hand-off otherwise. These\n8: // cases pin which id the hand-off inserts and where it sits.\n9: \n10: import { mkdtempSync, readFileSync } from 'node:fs';\n11: import { tmpdir } from 'node:os';\n12: import { dirname, join, resolve } from 'node:path';\n13: import { fileURLToPath } from 'node:url';\n14: \n15: import { afterAll, beforeAll, describe, expect, it, vi } from 'vitest';\n16: import type {\n17:   AdvisorProjection,\n18:   AdvisorScoringOptions,\n19:   AdvisorScoringResult,\n20: } from '../../lib/scorer/types.js';\n21: \n22: const HERE = dirname(fileURLToPath(import.meta.url));\n23: const ROUTING = resolve(HERE, '../../scripts/routing-accuracy');\n24: const BASELINE_PATH = join(ROUTING, 'scorer-eval-baseline.json');\n25: const SENTINEL = '.skilled/skills/system-spec-kit/SKILL.md';\n26: const DOCTOR_PREFIX = 'command-doctor-';\n27: \n28: // Private `local-*` skills linked in through this variable live outside the\n29: // checkout, so a pinned ordering measured on a clean checkout must not see them.\n30: const PRIVATE_SKILL_ROOTS_ENV = 'SPECKIT_PRIVATE_SKILL_ROOTS';\n31: const PREVIOUS_PRIVATE_SKILL_ROOTS = process.env[PRIVATE_SKILL_ROOTS_ENV];\n32: \n33: function restorePrivateSkillRoots(): void {\n34:   if (PREVIOUS_PRIVATE_SKILL_ROOTS === undefined) delete process.env[PRIVATE_SKILL_ROOTS_ENV];\n35:   else process.env[PRIVATE_SKILL_ROOTS_ENV] = PREVIOUS_PRIVATE_SKILL_ROOTS;\n36: }\n37: \n38: // Freeze scoring to the reproducible filesystem projection: an empty DB dir makes the\n39: // SQLite loader return null, semantic embeddings are disabled, and the native\n40: // lane-ranking overrides are cleared so the ordering is deterministic.\n41: function freezeEvalEnv(): void {\n42:   process.env.SYSTEM_SKILL_ADVISOR_DB_DIR = mkdtempSync(join(tmpdir(), 'advisor-doctor-handoff-'));\n43:   process.env.SKILL_ADVISOR_DISABLE_BUILTIN_SEMANTIC = '1';\n44:   process.env.SPECKIT_SKILL_ADVISOR_FORCE_LOCAL = '1';\n45:   delete process.env.SPECKIT_ADVISOR_LANE_WEIGHTS_JSON;\n46:   delete process.env.SPECKIT_ADVISOR_LANE_SHADOW_WEIGHTS_JSON;\n47:   delete process.env.SPECKIT_ADVISOR_BM25_LEXICAL_SHADOW;\n48:   delete process.env[PRIVATE_SKILL_ROOTS_ENV];\n49: }\n50: \n51: let scoreAdvisorPrompt: (prompt: string, options: AdvisorScoringOptions) => AdvisorScoringResult;\n52: let runnableDoctorBridgeId: (runnable: string, projection: AdvisorProjection) => string | undefined;\n53: let projection: AdvisorProjection;\n54: let workspaceRoot = '';\n55: \n56: // The projection holds one bridge whose policy runs and one that asks, so a\n57: // runnable can be found only when it runs without confirmation.\n58: const BRIDGE_PROJECTION = {\n59:   skills: [\n60:     { id: 'command-doctor-agents-md-check' },\n61:     { id: 'command-doctor-git-hooks' },\n62:   ],\n63: } as unknown as AdvisorProjection;\n64: \n65: function scoredIds(prompt: string): string[] {\n66:   return scoreAdvisorPrompt(prompt, { workspaceRoot, projection })\n67:     .recommendations.map((recommendation) => recommendation.skill);\n68: }\n69: \n70: describe('doctor hand-off command', () => {\n71:   beforeAll(async () => {\n72:     freezeEvalEnv();\n73:     const fusion = await import('../../lib/scorer/fusion.js');\n74:     const projectionModule = await import('../../lib/scorer/projection.js');\n75:     const workspace = await import('../../lib/utils/workspace-root.js');\n76:     scoreAdvisorPrompt = fusion.scoreAdvisorPrompt;\n77:     runnableDoctorBridgeId = fusion.runnableDoctorBridgeId;\n78:     workspaceRoot = workspace.findAdvisorWorkspaceRoot(HERE, { maxDepth: 14, sentinel: SENTINEL });\n79: \n80:     const baseline = JSON.parse(readFileSync(BASELINE_PATH, 'utf8')) as { readonly capturedAt: string };\n81: \n82:     // The derived lane discounts each skill by its age at scoring time, so score at the\n83:     // instant the accuracy baseline was captured; a later calendar day must not move a\n84:     // row that no change touched.\n85:     vi.useFakeTimers({ toFake: ['Date'] });\n86:     vi.setSystemTime(new Date(`${baseline.capturedAt}T00:00:00Z`));\n87: \n88:     projection = await projectionModule.loadAdvisorProjection(workspaceRoot);\n89:   });\n90: \n91:   afterAll(() => {\n92:     vi.useRealTimers();\n93:     restorePrivateSkillRoots();\n94:   });\n95: \n96:   it('offers the ranked command that runs without asking', () => {\n97:     expect(scoredIds('confirm the AGENTS.md sections in this repo have not drifted')[0])\n98:       .toBe('command-doctor-agents-md-check');\n99:   });\n100: \n101:   it('offers the ranked ci report command', () => {\n102:     expect(scoredIds('show me every GitHub Actions workflow and whether each is enabled')[0])\n103:       .toBe('command-doctor-ci-report');\n104:   });\n105: \n106:   // A strong cue stands beside a passing skill, and the hand-off follows it rather\n107:   // than displacing it.\n108:   it('puts the ranked command after the passing skill', () => {\n109:     const ids = scoredIds('my research loop stopped converging and I cannot see why');\n110: \n111:     expect(ids.slice(0, 2)).toEqual(['system-deep-loop', 'command-doctor-deep-loop']);\n112:   });\n113: \n114:   it('falls back to the helper for a repair request with no ranked command', () => {\n115:     expect(scoredIds('I have a problem and want the right repair path suggested with reasons')[0])\n116:       .toBe('command-doctor-helper');\n117:   });\n118: \n119:   it('leaves a fixed problem with no doctor command', () => {\n120:     const doctorIds = scoredIds('much appreciated, that fixed the problem completely')\n121:       .filter((id) => id.startsWith(DOCTOR_PREFIX));\n122: \n123:     expect(doctorIds).toEqual([]);\n124:   });\n125: \n126:   it('leaves an ordinary problem beside a passing skill with no doctor command', () => {\n127:     const doctorIds = scoredIds('I have a problem with my CSS layout')\n128:       .filter((id) => id.startsWith(DOCTOR_PREFIX));\n129: \n130:     expect(doctorIds).toEqual([]);\n131:   });\n132: });\n133: \n134: describe('runnableDoctorBridgeId', () => {\n135:   it('finds a bridge whose policy runs', () => {\n136:     expect(runnableDoctorBridgeId('/doctor:agents-md check', BRIDGE_PROJECTION))\n137:       .toBe('command-doctor-agents-md-check');\n138:   });\n139: \n140:   it('finds no bridge when the command asks before it runs', () => {\n141:     expect(runnableDoctorBridgeId('/doctor:git hooks', BRIDGE_PROJECTION)).toBeUndefined();\n142:   });\n143: \n144:   it('finds no bridge the projection does not hold', () => {\n145:     expect(runnableDoctorBridgeId('/doctor:ci report', BRIDGE_PROJECTION)).toBeUndefined();\n146:   });\n147: });","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/tests/scorer/doctor-handoff-command.vitest.ts, lines 1-147\n1: // ───────────────────────────────────────────────────────────────\n2: // MODULE: Doctor Hand-off Command\n3: // ───────────────────────────────────────────────────────────────\n4: \n5: // A doctor problem worded unlike any bridge phrase reaches the helper's own\n6: // ranker. When that ranker names a command that runs without asking, the operator\n7: // is offered that command, and /doctor:helper keeps the hand-off otherwise. These\n8: // cases pin which id the hand-off inserts and where it sits.\n9: \n10: import { mkdtempSync, readFileSync } from 'node:fs';\n11: import { tmpdir } from 'node:os';\n12: import { dirname, join, resolve } from 'node:path';\n13: import { fileURLToPath } from 'node:url';\n14: \n15: import { afterAll, beforeAll, describe, expect, it, vi } from 'vitest';\n16: import type {\n17:   AdvisorProjection,\n18:   AdvisorScoringOptions,\n19:   AdvisorScoringResult,\n20: } from '../../lib/scorer/types.js';\n21: \n22: const HERE = dirname(fileURLToPath(import.meta.url));\n23: const ROUTING = resolve(HERE, '../../scripts/routing-accuracy');\n24: const BASELINE_PATH = join(ROUTING, 'scorer-eval-baseline.json');\n25: const SENTINEL = '.skilled/skills/system-spec-kit/SKILL.md';\n26: const DOCTOR_PREFIX = 'command-doctor-';\n27: \n28: // Private `local-*` skills linked in through this variable live outside the\n29: // checkout, so a pinned ordering measured on a clean checkout must not see them.\n30: const PRIVATE_SKILL_ROOTS_ENV = 'SPECKIT_PRIVATE_SKILL_ROOTS';\n31: const PREVIOUS_PRIVATE_SKILL_ROOTS = process.env[PRIVATE_SKILL_ROOTS_ENV];\n32: \n33: function restorePrivateSkillRoots(): void {\n34:   if (PREVIOUS_PRIVATE_SKILL_ROOTS === undefined) delete process.env[PRIVATE_SKILL_ROOTS_ENV];\n35:   else process.env[PRIVATE_SKILL_ROOTS_ENV] = PREVIOUS_PRIVATE_SKILL_ROOTS;\n36: }\n37: \n38: // Freeze scoring to the reproducible filesystem projection: an empty DB dir makes the\n39: // SQLite loader return null, semantic embeddings are disabled, and the native\n40: // lane-ranking overrides are cleared so the ordering is deterministic.\n41: function freezeEvalEnv(): void {\n42:   process.env.SYSTEM_SKILL_ADVISOR_DB_DIR = mkdtempSync(join(tmpdir(), 'advisor-doctor-handoff-'));\n43:   process.env.SKILL_ADVISOR_DISABLE_BUILTIN_SEMANTIC = '1';\n44:   process.env.SPECKIT_SKILL_ADVISOR_FORCE_LOCAL = '1';\n45:   delete process.env.SPECKIT_ADVISOR_LANE_WEIGHTS_JSON;\n46:   delete process.env.SPECKIT_ADVISOR_LANE_SHADOW_WEIGHTS_JSON;\n47:   delete process.env.SPECKIT_ADVISOR_BM25_LEXICAL_SHADOW;\n48:   delete process.env[PRIVATE_SKILL_ROOTS_ENV];\n49: }\n50: \n51: let scoreAdvisorPrompt: (prompt: string, options: AdvisorScoringOptions) => AdvisorScoringResult;\n52: let runnableDoctorBridgeId: (runnable: string, projection: AdvisorProjection) => string | undefined;\n53: let projection: AdvisorProjection;\n54: let workspaceRoot = '';\n55: \n56: // The projection holds one bridge whose policy runs and one that asks, so a\n57: // runnable can be found only when it runs without confirmation.\n58: const BRIDGE_PROJECTION = {\n59:   skills: [\n60:     { id: 'command-doctor-agents-md-check' },\n61:     { id: 'command-doctor-git-hooks' },\n62:   ],\n63: } as unknown as AdvisorProjection;\n64: \n65: function scoredIds(prompt: string): string[] {\n66:   return scoreAdvisorPrompt(prompt, { workspaceRoot, projection })\n67:     .recommendations.map((recommendation) => recommendation.skill);\n68: }\n69: \n70: describe('doctor hand-off command', () => {\n71:   beforeAll(async () => {\n72:     freezeEvalEnv();\n73:     const fusion = await import('../../lib/scorer/fusion.js');\n74:     const projectionModule = await import('../../lib/scorer/projection.js');\n75:     const workspace = await import('../../lib/utils/workspace-root.js');\n76:     scoreAdvisorPrompt = fusion.scoreAdvisorPrompt;\n77:     runnableDoctorBridgeId = fusion.runnableDoctorBridgeId;\n78:     workspaceRoot = workspace.findAdvisorWorkspaceRoot(HERE, { maxDepth: 14, sentinel: SENTINEL });\n79: \n80:     const baseline = JSON.parse(readFileSync(BASELINE_PATH, 'utf8')) as { readonly capturedAt: string };\n81: \n82:     // The derived lane discounts each skill by its age at scoring time, so score at the\n83:     // instant the accuracy baseline was captured; a later calendar day must not move a\n84:     // row that no change touched.\n85:     vi.useFakeTimers({ toFake: ['Date'] });\n86:     vi.setSystemTime(new Date(`${baseline.capturedAt}T00:00:00Z`));\n87: \n88:     projection = await projectionModule.loadAdvisorProjection(workspaceRoot);\n89:   });\n90: \n91:   afterAll(() => {\n92:     vi.useRealTimers();\n93:     restorePrivateSkillRoots();\n94:   });\n95: \n96:   it('offers the ranked command that runs without asking', () => {\n97:     expect(scoredIds('confirm the AGENTS.md sections in this repo have not drifted')[0])\n98:       .toBe('command-doctor-agents-md-check');\n99:   });\n100: \n101:   it('offers the ranked ci report command', () => {\n102:     expect(scoredIds('show me every GitHub Actions workflow and whether each is enabled')[0])\n103:       .toBe('command-doctor-ci-report');\n104:   });\n105: \n106:   // A strong cue stands beside a passing skill, and the hand-off follows it rather\n107:   // than displacing it.\n108:   it('puts the ranked command after the passing skill', () => {\n109:     const ids = scoredIds('my research loop stopped converging and I cannot see why');\n110: \n111:     expect(ids.slice(0, 2)).toEqual(['system-deep-loop', 'command-doctor-deep-loop']);\n112:   });\n113: \n114:   it('falls back to the helper for a repair request with no ranked command', () => {\n115:     expect(scoredIds('I have a problem and want the right repair path suggested with reasons')[0])\n116:       .toBe('command-doctor-helper');\n117:   });\n118: \n119:   it('leaves a fixed problem with no doctor command', () => {\n120:     const doctorIds = scoredIds('much appreciated, that fixed the problem completely')\n121:       .filter((id) => id.startsWith(DOCTOR_PREFIX));\n122: \n123:     expect(doctorIds).toEqual([]);\n124:   });\n125: \n126:   it('leaves an ordinary problem beside a passing skill with no doctor command', () => {\n127:     const doctorIds = scoredIds('I have a problem with my CSS layout')\n128:       .filter((id) => id.startsWith(DOCTOR_PREFIX));\n129: \n130:     expect(doctorIds).toEqual([]);\n131:   });\n132: });\n133: \n134: describe('runnableDoctorBridgeId', () => {\n135:   it('finds a bridge whose policy runs', () => {\n136:     expect(runnableDoctorBridgeId('/doctor:agents-md check', BRIDGE_PROJECTION))\n137:       .toBe('command-doctor-agents-md-check');\n138:   });\n139: \n140:   it('finds no bridge when the command asks before it runs', () => {\n141:     expect(runnableDoctorBridgeId('/doctor:git hooks', BRIDGE_PROJECTION)).toBeUndefined();\n142:   });\n143: \n144:   it('finds no bridge the projection does not hold', () => {\n145:     expect(runnableDoctorBridgeId('/doctor:ci report', BRIDGE_PROJECTION)).toBeUndefined();\n146:   });\n147: });"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/tests/scorer/doctor-handoff-command.vitest.ts\"}"},"time":{"start":1794543614239,"end":1794543614668}}}}
