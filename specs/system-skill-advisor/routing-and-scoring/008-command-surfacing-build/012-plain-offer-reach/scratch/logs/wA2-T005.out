{"type":"tool_use","timestamp":1794543406717,"sessionID":"ses_e2ce11fa0ffeKrU1dSi2GXzG1K","part":{"partID":"prt_1d31f4d83001f3I6AfSfYw4MRM","sessionID":"ses_e2ce11fa0ffeKrU1dSi2GXzG1K","messageID":"msg_1d31f47eb001uy9RhPcbRSbmrh","type":"tool","id":"call_5f361548695c40fab1da6e67","tool":"read","state":{"status":"completed","input":{"path":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/tests/doctor-routing-slice.vitest.ts"},"output":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/tests/doctor-routing-slice.vitest.ts, lines 1-170\n1: // ───────────────────────────────────────────────────────────────\n2: // MODULE: Doctor Routing Slice\n3: // ───────────────────────────────────────────────────────────────\n4: \n5: // Scores only the doctor slice fixture, under the pinned force-local regime. It reads\n6: // no other routing fixture, so the pinned fixture hashes are untouched, and a row is\n7: // asserted only when its wave is active, so a half-shipped bridge cannot fail the gate\n8: // before its commands exist.\n9: \n10: import { mkdtempSync, readFileSync } from 'node:fs';\n11: import { tmpdir } from 'node:os';\n12: import { dirname, join, resolve } from 'node:path';\n13: import { fileURLToPath } from 'node:url';\n14: \n15: import { afterAll, beforeAll, describe, expect, it, vi } from 'vitest';\n16: import type {\n17:   AdvisorScoredRecommendation,\n18:   AdvisorScoringOptions,\n19:   AdvisorScoringResult,\n20: } from '../lib/scorer/types.js';\n21: \n22: const HERE = dirname(fileURLToPath(import.meta.url));\n23: const ROUTING = resolve(HERE, '../scripts/routing-accuracy');\n24: const SLICE_PATH = join(ROUTING, 'doctor-prompts.jsonl');\n25: const BASELINE_PATH = join(ROUTING, 'scorer-eval-baseline.json');\n26: const COMPATIBILITY_PATH = resolve(HERE, '../scripts/command-bridges/scoring-compatibility.json');\n27: const SENTINEL = '.skilled/skills/system-spec-kit/SKILL.md';\n28: const DOCTOR_PREFIX = 'command-doctor-';\n29: \n30: interface DoctorRow {\n31:   readonly id: string;\n32:   readonly prompt: string;\n33:   readonly expected_top: string | null;\n34:   readonly expected_second: string | null;\n35:   readonly wave: string;\n36: }\n37: \n38: interface CompatibilityDoc {\n39:   readonly typescript: readonly { readonly inventoryId: string }[];\n40: }\n41: \n42: function readJsonl<T>(path: string): T[] {\n43:   return readFileSync(path, 'utf8').trim().split('\\n').filter(Boolean).map((line) => JSON.parse(line) as T);\n44: }\n45: \n46: // Private `local-*` skills linked in through this variable live outside the\n47: // checkout, so a pinned count measured on a clean checkout must not see them.\n48: const PRIVATE_SKILL_ROOTS_ENV = 'SPECKIT_PRIVATE_SKILL_ROOTS';\n49: const PREVIOUS_PRIVATE_SKILL_ROOTS = process.env[PRIVATE_SKILL_ROOTS_ENV];\n50: \n51: function restorePrivateSkillRoots(): void {\n52:   if (PREVIOUS_PRIVATE_SKILL_ROOTS === undefined) delete process.env[PRIVATE_SKILL_ROOTS_ENV];\n53:   else process.env[PRIVATE_SKILL_ROOTS_ENV] = PREVIOUS_PRIVATE_SKILL_ROOTS;\n54: }\n55: \n56: // Freeze scoring to the reproducible filesystem projection: an empty DB dir makes the\n57: // SQLite loader return null, semantic embeddings are disabled, and the native\n58: // lane-ranking overrides are cleared so the top-1 decision is deterministic.\n59: function freezeEvalEnv(): void {\n60:   process.env.SYSTEM_SKILL_ADVISOR_DB_DIR = mkdtempSync(join(tmpdir(), 'advisor-doctor-slice-'));\n61:   process.env.SKILL_ADVISOR_DISABLE_BUILTIN_SEMANTIC = '1';\n62:   process.env.SPECKIT_SKILL_ADVISOR_FORCE_LOCAL = '1';\n63:   delete process.env.SPECKIT_ADVISOR_LANE_WEIGHTS_JSON;\n64:   delete process.env.SPECKIT_ADVISOR_LANE_SHADOW_WEIGHTS_JSON;\n65:   delete process.env.SPECKIT_ADVISOR_BM25_LEXICAL_SHADOW;\n66:   delete process.env[PRIVATE_SKILL_ROOTS_ENV];\n67: }\n68: \n69: function activeTypescriptBridgeIds(): Set<string> {\n70:   const doc = JSON.parse(readFileSync(COMPATIBILITY_PATH, 'utf8')) as CompatibilityDoc;\n71:   return new Set(doc.typescript.map((entry) => entry.inventoryId));\n72: }\n73: \n74: // Control rows always run, so an unknown-intent regression is caught even with no\n75: // doctor bridge shipped. A doctor wave runs only once every doctor bridge its rows\n76: // expect is active, which turns the wave on with the bridge rather than before it.\n77: function activeWaves(rows: readonly DoctorRow[], activeIds: ReadonlySet<string>): Set<string> {\n78:   const active = new Set<string>(['control']);\n79:   const referenced = new Map<string, Set<string>>();\n80:   for (const row of rows) {\n81:     if (row.wave === 'control') continue;\n82:     const ids = referenced.get(row.wave) ?? new Set<string>();\n83:     for (const value of [row.expected_top, row.expected_second]) {\n84:       if (value !== null && value.startsWith(DOCTOR_PREFIX)) ids.add(value);\n85:     }\n86:     referenced.set(row.wave, ids);\n87:   }\n88:   for (const [wave, ids] of referenced) {\n89:     if (ids.size > 0 && [...ids].every((id) => activeIds.has(id))) active.add(wave);\n90:   }\n91:   return active;\n92: }\n93: \n94: // The rendered brief keeps three recommendations and omits a second line for a\n95: // null or doctor top pick.\n96: function secondDoctor(\n97:   recommendations: readonly AdvisorScoredRecommendation[],\n98:   top: string | null,\n99: ): string | null {\n100:   if (top === null || top.startsWith(DOCTOR_PREFIX)) return null;\n101: \n102:   const renderedRecommendations = recommendations.slice(0, 3);\n103:   for (const recommendation of renderedRecommendations.slice(1)) {\n104:     if (recommendation.skill.startsWith(DOCTOR_PREFIX)) return recommendation.skill;\n105:   }\n106:   return null;\n107: }\n108: \n109: let scoreAdvisorPrompt: (prompt: string, options: AdvisorScoringOptions) => AdvisorScoringResult;\n110: let rows: DoctorRow[] = [];\n111: let workspaceRoot = '';\n112: \n113: describe('doctor routing slice', () => {\n114:   beforeAll(async () => {\n115:     freezeEvalEnv();\n116:     const fusion = await import('../lib/scorer/fusion.js');\n117:     const workspace = await import('../lib/utils/workspace-root.js');\n118:     scoreAdvisorPrompt = fusion.scoreAdvisorPrompt;\n119:     workspaceRoot = workspace.findAdvisorWorkspaceRoot(HERE, { maxDepth: 14, sentinel: SENTINEL });\n120: \n121:     const baseline = JSON.parse(readFileSync(BASELINE_PATH, 'utf8')) as { readonly capturedAt: string };\n122: \n123:     // The derived lane discounts each skill by its age at scoring time, so score at the\n124:     // instant the accuracy baseline was captured; a later calendar day must not move a\n125:     // row that no change touched.\n126:     vi.useFakeTimers({ toFake: ['Date'] });\n127:     vi.setSystemTime(new Date(`${baseline.capturedAt}T00:00:00Z`));\n128: \n129:     rows = readJsonl<DoctorRow>(SLICE_PATH);\n130:   });\n131: \n132:   afterAll(() => {\n133:     vi.useRealTimers();\n134:     restorePrivateSkillRoots();\n135:   });\n136: \n137:   it('reads a well-formed slice', () => {\n138:     const ids = new Set<string>();\n139:     for (const row of rows) {\n140:       expect(typeof row.id).toBe('string');\n141:       expect(typeof row.prompt).toBe('string');\n142:       expect(row.expected_top === null || typeof row.expected_top === 'string').toBe(true);\n143:       expect(row.expected_second === null || typeof row.expected_second === 'string').toBe(true);\n144:       expect(typeof row.wave).toBe('string');\n145:       ids.add(row.id);\n146:     }\n147:     expect(ids.size).toBe(rows.length);\n148:     expect(rows.some((row) => row.wave === 'control')).toBe(true);\n149:   });\n150: \n151:   it('scores every row of every active wave as expected', () => {\n152:     const active = activeWaves(rows, activeTypescriptBridgeIds());\n153:     const mismatches: string[] = [];\n154:     let asserted = 0;\n155:     for (const row of rows) {\n156:       if (!active.has(row.wave)) continue;\n157:       asserted += 1;\n158:       const result = scoreAdvisorPrompt(row.prompt, { workspaceRoot });\n159:       const top = result.topSkill;\n160:       const second = secondDoctor(result.recommendations, top);\n161:       if (top !== row.expected_top || second !== row.expected_second) {\n162:         mismatches.push(\n163:           `${row.id} [${row.wave}] \"${row.prompt}\": top=${top} (want ${row.expected_top}), second=${second} (want ${row.expected_second})`,\n164:         );\n165:       }\n166:     }\n167:     expect(asserted).toBeGreaterThan(0);\n168:     expect(mismatches).toEqual([]);\n169:   });\n170: });","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/tests/doctor-routing-slice.vitest.ts, lines 1-170\n1: // ───────────────────────────────────────────────────────────────\n2: // MODULE: Doctor Routing Slice\n3: // ───────────────────────────────────────────────────────────────\n4: \n5: // Scores only the doctor slice fixture, under the pinned force-local regime. It reads\n6: // no other routing fixture, so the pinned fixture hashes are untouched, and a row is\n7: // asserted only when its wave is active, so a half-shipped bridge cannot fail the gate\n8: // before its commands exist.\n9: \n10: import { mkdtempSync, readFileSync } from 'node:fs';\n11: import { tmpdir } from 'node:os';\n12: import { dirname, join, resolve } from 'node:path';\n13: import { fileURLToPath } from 'node:url';\n14: \n15: import { afterAll, beforeAll, describe, expect, it, vi } from 'vitest';\n16: import type {\n17:   AdvisorScoredRecommendation,\n18:   AdvisorScoringOptions,\n19:   AdvisorScoringResult,\n20: } from '../lib/scorer/types.js';\n21: \n22: const HERE = dirname(fileURLToPath(import.meta.url));\n23: const ROUTING = resolve(HERE, '../scripts/routing-accuracy');\n24: const SLICE_PATH = join(ROUTING, 'doctor-prompts.jsonl');\n25: const BASELINE_PATH = join(ROUTING, 'scorer-eval-baseline.json');\n26: const COMPATIBILITY_PATH = resolve(HERE, '../scripts/command-bridges/scoring-compatibility.json');\n27: const SENTINEL = '.skilled/skills/system-spec-kit/SKILL.md';\n28: const DOCTOR_PREFIX = 'command-doctor-';\n29: \n30: interface DoctorRow {\n31:   readonly id: string;\n32:   readonly prompt: string;\n33:   readonly expected_top: string | null;\n34:   readonly expected_second: string | null;\n35:   readonly wave: string;\n36: }\n37: \n38: interface CompatibilityDoc {\n39:   readonly typescript: readonly { readonly inventoryId: string }[];\n40: }\n41: \n42: function readJsonl<T>(path: string): T[] {\n43:   return readFileSync(path, 'utf8').trim().split('\\n').filter(Boolean).map((line) => JSON.parse(line) as T);\n44: }\n45: \n46: // Private `local-*` skills linked in through this variable live outside the\n47: // checkout, so a pinned count measured on a clean checkout must not see them.\n48: const PRIVATE_SKILL_ROOTS_ENV = 'SPECKIT_PRIVATE_SKILL_ROOTS';\n49: const PREVIOUS_PRIVATE_SKILL_ROOTS = process.env[PRIVATE_SKILL_ROOTS_ENV];\n50: \n51: function restorePrivateSkillRoots(): void {\n52:   if (PREVIOUS_PRIVATE_SKILL_ROOTS === undefined) delete process.env[PRIVATE_SKILL_ROOTS_ENV];\n53:   else process.env[PRIVATE_SKILL_ROOTS_ENV] = PREVIOUS_PRIVATE_SKILL_ROOTS;\n54: }\n55: \n56: // Freeze scoring to the reproducible filesystem projection: an empty DB dir makes the\n57: // SQLite loader return null, semantic embeddings are disabled, and the native\n58: // lane-ranking overrides are cleared so the top-1 decision is deterministic.\n59: function freezeEvalEnv(): void {\n60:   process.env.SYSTEM_SKILL_ADVISOR_DB_DIR = mkdtempSync(join(tmpdir(), 'advisor-doctor-slice-'));\n61:   process.env.SKILL_ADVISOR_DISABLE_BUILTIN_SEMANTIC = '1';\n62:   process.env.SPECKIT_SKILL_ADVISOR_FORCE_LOCAL = '1';\n63:   delete process.env.SPECKIT_ADVISOR_LANE_WEIGHTS_JSON;\n64:   delete process.env.SPECKIT_ADVISOR_LANE_SHADOW_WEIGHTS_JSON;\n65:   delete process.env.SPECKIT_ADVISOR_BM25_LEXICAL_SHADOW;\n66:   delete process.env[PRIVATE_SKILL_ROOTS_ENV];\n67: }\n68: \n69: function activeTypescriptBridgeIds(): Set<string> {\n70:   const doc = JSON.parse(readFileSync(COMPATIBILITY_PATH, 'utf8')) as CompatibilityDoc;\n71:   return new Set(doc.typescript.map((entry) => entry.inventoryId));\n72: }\n73: \n74: // Control rows always run, so an unknown-intent regression is caught even with no\n75: // doctor bridge shipped. A doctor wave runs only once every doctor bridge its rows\n76: // expect is active, which turns the wave on with the bridge rather than before it.\n77: function activeWaves(rows: readonly DoctorRow[], activeIds: ReadonlySet<string>): Set<string> {\n78:   const active = new Set<string>(['control']);\n79:   const referenced = new Map<string, Set<string>>();\n80:   for (const row of rows) {\n81:     if (row.wave === 'control') continue;\n82:     const ids = referenced.get(row.wave) ?? new Set<string>();\n83:     for (const value of [row.expected_top, row.expected_second]) {\n84:       if (value !== null && value.startsWith(DOCTOR_PREFIX)) ids.add(value);\n85:     }\n86:     referenced.set(row.wave, ids);\n87:   }\n88:   for (const [wave, ids] of referenced) {\n89:     if (ids.size > 0 && [...ids].every((id) => activeIds.has(id))) active.add(wave);\n90:   }\n91:   return active;\n92: }\n93: \n94: // The rendered brief keeps three recommendations and omits a second line for a\n95: // null or doctor top pick.\n96: function secondDoctor(\n97:   recommendations: readonly AdvisorScoredRecommendation[],\n98:   top: string | null,\n99: ): string | null {\n100:   if (top === null || top.startsWith(DOCTOR_PREFIX)) return null;\n101: \n102:   const renderedRecommendations = recommendations.slice(0, 3);\n103:   for (const recommendation of renderedRecommendations.slice(1)) {\n104:     if (recommendation.skill.startsWith(DOCTOR_PREFIX)) return recommendation.skill;\n105:   }\n106:   return null;\n107: }\n108: \n109: let scoreAdvisorPrompt: (prompt: string, options: AdvisorScoringOptions) => AdvisorScoringResult;\n110: let rows: DoctorRow[] = [];\n111: let workspaceRoot = '';\n112: \n113: describe('doctor routing slice', () => {\n114:   beforeAll(async () => {\n115:     freezeEvalEnv();\n116:     const fusion = await import('../lib/scorer/fusion.js');\n117:     const workspace = await import('../lib/utils/workspace-root.js');\n118:     scoreAdvisorPrompt = fusion.scoreAdvisorPrompt;\n119:     workspaceRoot = workspace.findAdvisorWorkspaceRoot(HERE, { maxDepth: 14, sentinel: SENTINEL });\n120: \n121:     const baseline = JSON.parse(readFileSync(BASELINE_PATH, 'utf8')) as { readonly capturedAt: string };\n122: \n123:     // The derived lane discounts each skill by its age at scoring time, so score at the\n124:     // instant the accuracy baseline was captured; a later calendar day must not move a\n125:     // row that no change touched.\n126:     vi.useFakeTimers({ toFake: ['Date'] });\n127:     vi.setSystemTime(new Date(`${baseline.capturedAt}T00:00:00Z`));\n128: \n129:     rows = readJsonl<DoctorRow>(SLICE_PATH);\n130:   });\n131: \n132:   afterAll(() => {\n133:     vi.useRealTimers();\n134:     restorePrivateSkillRoots();\n135:   });\n136: \n137:   it('reads a well-formed slice', () => {\n138:     const ids = new Set<string>();\n139:     for (const row of rows) {\n140:       expect(typeof row.id).toBe('string');\n141:       expect(typeof row.prompt).toBe('string');\n142:       expect(row.expected_top === null || typeof row.expected_top === 'string').toBe(true);\n143:       expect(row.expected_second === null || typeof row.expected_second === 'string').toBe(true);\n144:       expect(typeof row.wave).toBe('string');\n145:       ids.add(row.id);\n146:     }\n147:     expect(ids.size).toBe(rows.length);\n148:     expect(rows.some((row) => row.wave === 'control')).toBe(true);\n149:   });\n150: \n151:   it('scores every row of every active wave as expected', () => {\n152:     const active = activeWaves(rows, activeTypescriptBridgeIds());\n153:     const mismatches: string[] = [];\n154:     let asserted = 0;\n155:     for (const row of rows) {\n156:       if (!active.has(row.wave)) continue;\n157:       asserted += 1;\n158:       const result = scoreAdvisorPrompt(row.prompt, { workspaceRoot });\n159:       const top = result.topSkill;\n160:       const second = secondDoctor(result.recommendations, top);\n161:       if (top !== row.expected_top || second !== row.expected_second) {\n162:         mismatches.push(\n163:           `${row.id} [${row.wave}] \"${row.prompt}\": top=${top} (want ${row.expected_top}), second=${second} (want ${row.expected_second})`,\n164:         );\n165:       }\n166:     }\n167:     expect(asserted).toBeGreaterThan(0);\n168:     expect(mismatches).toEqual([]);\n169:   });\n170: });"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/tests/doctor-routing-slice.vitest.ts\"}"},"time":{"start":1794543406467,"end":1794543406717}}}}
