 '/create:feature-catalog': { policy: 'start', ownerSkillId: 'sk-doc', scorerRow: false },\n184:  '/create:goal': { policy: 'start', ownerSkillId: 'sk-doc', scorerRow: false },\n185:  '/create:manual-testing-playbook': { policy: 'start', ownerSkillId: 'sk-doc', scorerRow: true },\n186:  '/create:readme': { policy: 'start', ownerSkillId: 'sk-doc', scorerRow: false },\n187:  '/create:repo-rule': { policy: 'start', ownerSkillId: 'sk-doc', scorerRow: false },\n188:  '/create:skill': { policy: 'start', ownerSkillId: 'sk-doc', scorerRow: false },\n189:  '/create:skill-parent': { policy: 'start', ownerSkillId: 'sk-doc', scorerRow: false },\n190:  '/create:with-human-voice': { policy: 'start', ownerSkillId: 'sk-doc', scorerRow: false },\n191:  '/deep:ai-council': { policy: 'ask', ownerSkillId: 'system-deep-loop', scorerRow: false },\n192:  '/deep:research': { policy: 'ask', ownerSkillId: 'system-deep-loop', scorerRow: false },\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"grep -n \\\"COMMAND_ROWS\\\\|policy\\\\|export const\\\\|export function\\\\|DOCTOR_BRIDGE_PREFIX\\\\|runnable\\\\|command:\\\" .skilled/skills/system-skill-advisor/runtime/lib/command-attach.ts | head -80\",\"workdir\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research\"}"},"time":{"start":1794543420094,"end":1794543420687}}}}
