n39:   'commit message',\n40:   'commit message rules',\n41:   'commit standards',\n42:   'commit hook',\n43:   'pre-commit hook',\n44:   'branch naming',\n45:   'branch rules',\n46:   'worktree',\n47:   'create worktree',\n48:   'rebase',\n49:   'merge conflict',\n50:   'conventional commits',\n51:   'open a pr',\n52:   'pull request',\n53:   'finish branch',\n54:   'speckit doctor',\n55:   'advisor rebuild',\n56:   'advisor status',\n57:   'skill advisor',\n58:   'update skilled',\n59:   'trigger index',\n60:   'spec folder',\n61:   'deep research',\n62:   'code mode',\n63:   'parent skill',\n64:   'pre-push hook',\n65:   'push allowlist',\n66:   'hook trust',\n67:   'hook gates',\n68:   'cherry pick',\n69:   'squash commits',\n70:   'env vars',\n71:   // Deliberately has no expected owner: routing it to system-spec-kit would put the skill above /doctor:env on \"check my environment variables\".\n72:   'environment variables',\n73:   'mcp tools',\n74:   'runtime mirrors',\n75:   'resume spec',\n76:   'validate spec',\n77:   'Review this PR for blocking routing regressions and list findings first.',\n78: ] as const;\n79: \n80: const EXPECTED_TOP_SKILLS: ReadonlyMap<string, string> = new Map([\n81:   ['git hooks', 'sk-git'],\n82:   ['git hook', 'sk-git'],\n83:   ['git setup', 'sk-git'],\n84:   ['git standards', 'sk-git'],\n85:   ['git hooks broken', 'sk-git'],\n86:   ['git rules', 'sk-git'],\n87:   ['speckit doctor', 'system-spec-kit'],\n88:   ['pre-push hook', 'sk-git'],\n89:   ['push allowlist', 'sk-git'],\n90:   ['hook trust', 'sk-git'],\n91:   ['hook gates', 'sk-git'],\n92:   ['cherry pick', 'sk-git'],\n93:   ['squash commits', 'sk-git'],\n94:   ['env vars', 'system-spec-kit'],\n95:   ['mcp tools', 'mcp-tooling'],\n96:   ['runtime mirrors', 'system-spec-kit'],\n97:   ['resume spec', 'system-spec-kit'],\n98:   ['validate spec', 'system-spec-kit'],\n99:   // The lexical lane substring-matches prompt tokens against joined intent signals:\n100:   // \"allowlist\" hit \"list\" and pulled this review prompt to sk-git.\n101:   ['Review this PR for blocking routing regressions and list findings first.', 'sk-code'],\n102: ]);\n103: \n104: function freezeEvalEnv(): void {\n105:   process.env.SYSTEM_SKILL_ADVISOR_DB_DIR = mkdtempSync(\n106:     join(tmpdir(), 'advisor-doctor-isolation-'),\n107:   );\n108:   process.env.SKILL_ADVISOR_DISABLE_BUILTIN_SEMANTIC = '1';\n109:   process.env.SPECKIT_SKILL_ADVISOR_FORCE_LOCAL = '1';\n110:   delete process.env.SPECKIT_ADVISOR_LANE_WEIGHTS_JSON;\n111:   delete process.env.SPECKIT_ADVISOR_LANE_SHADOW_WEIGHTS_JSON;\n112:   delete process.env.SPECKIT_ADVISOR_BM25_LEXICAL_SHADOW;\n113: }\n114: \n115: function isDoctorBridge(\n116:   recommendation: AdvisorScoredRecommendation,\n117: ): boolean {\n118:   return recommendation.kind === 'command'\n119:     && recommendation.skill.startsWith(DOCTOR_PREFIX);\n120: }\n121: \n122: function scoreSnapshots(\n123:   recommendations: readonly AdvisorScoredRecommendation[],\n124: ): Array<Pick<\n125:   AdvisorScoredRecommendation,\n126:   'skill' | 'confidence' | 'uncertainty' | 'passes_threshold'\n127: >> {\n128:   return recommendations.map((recommendation) => ({\n129:     skill: recommendation.skill,\n130:     confidence: recommendation.confidence,\n131:     uncertainty: recommendation.uncertainty,\n132:     passes_threshold: recommendation.passes_threshold,\n133:   }));\n134: }\n135: \n136: let scoreAdvisorPrompt: (\n137:   prompt: string,\n138:   options: AdvisorScoringOptions,\n139: ) => AdvisorScoringResult;\n140: let workspaceRoot = '';\n141: let projection: AdvisorProjection;\n142: let doctorFreeProjection: AdvisorProjection;\n143: \n144: describe('doctor bridge scoring isolation', () => {\n145:   beforeAll(async () => {\n146:     freezeEvalEnv();\n147:     const fusion = await import('../../lib/scorer/fusion.js');\n148:     const projectionModule = await import('../../lib/scorer/projection.js');\n149:     const workspace = await import('../../lib/utils/workspace-root.js');\n150:     scoreAdvisorPrompt = fusion.scoreAdvisorPrompt;\n151:     workspaceRoot = workspace.findAdvisorWorkspaceRoot(HERE, {\n152:       maxDepth: 14,\n153:       sentinel: SENTINEL,\n154:     });\n155: \n156:     const baseline = JSON.parse(readFileSync(BASELINE_PATH, 'utf8')) as {\n157:       readonly capturedAt: string;\n158:     };\n159: \n160:     // Derived-lane age decay uses the baseline date so the scoring stays reproducible.\n161:     vi.useFakeTimers({ toFake: ['Date'] });\n162:     vi.setSystemTime(new Date(`${baseline.capturedAt}T00:00:00Z`));\n163: \n164:     projection = await projectionModule.loadAdvisorProjection(workspaceRoot);\n165:     doctorFreeProjection = {\n166:       ...projection,\n167:       skills: projection.skills.filter((skill) => !skill.id.startsWith(DOCTOR_PREFIX)),\n168:     };\n169:   });\n170: \n171:   afterAll(() => {\n172:     vi.useRealTimers();\n173:   });\n174: \n175:   it.each(PROMPTS)('keeps skill scoring isolated for \"%s\"', (prompt) => {\n176:     const fullResult = scoreAdvisorPrompt(prompt, {\n177:       workspaceRoot,\n178:       projection,\n179:       includeAllCandidates: true,\n180:     });\n181:     const doctorFreeResult = scoreAdvisorPrompt(prompt, {\n182:       workspaceRoot,\n183:       projection: doctorFreeProjection,\n184:       includeAllCandidates: true,\n185:     });\n186:     const fullSkills = fullResult.recommendations.filter(\n187:       (recommendation) => !isDoctorBridge(recommendation),\n188:     );\n189: \n190:     expect(scoreSnapshots(fullSkills)).toEqual(\n191:       scoreSnapshots(doctorFreeResult.recommendations),\n192:     );\n193:     if (doctorFreeResult.topSkill !== null) {\n194:       expect(fullResult.topSkill).toBe(doctorFreeResult.topSkill);\n195:     }\n196: \n197:     const expectedTopSkill = EXPECTED_TOP_SKILLS.get(prompt);\n198:     if (expectedTopSkill !== undefined) {\n199:       expect(fullResult.topSkill).toBe(expectedTopSkill);\n200:     }\n201:   