{"type":"tool_use","timestamp":1794543409513,"sessionID":"ses_e2ce11fa0ffeKrU1dSi2GXzG1K","part":{"partID":"prt_1d31f572e001Px5Y1YPHRiJmmI","sessionID":"ses_e2ce11fa0ffeKrU1dSi2GXzG1K","messageID":"msg_1d31f51e1001q11CSlRICBV3nq","type":"tool","id":"call_a8993971e4df49c6a4b7790b","tool":"read","state":{"status":"completed","input":{"path":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/lib/scorer/fusion.ts"},"output":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/lib/scorer/fusion.ts, lines 1-1059\n1: // ───────────────────────────────────────────────────────────────\n2: // MODULE: Advisor 5-Lane Fusion\n3: // ───────────────────────────────────────────────────────────────\n4: \n5: // ───────────────────────────────────────────────────────────────────\n6: // 1. IMPORTS\n7: // ───────────────────────────────────────────────────────────────────\n8: \n9: import { fuseResultsMulti } from '@spec-kit/shared/algorithms/rrf-fusion.js';\n10: \n11: import { applyAmbiguity, isAmbiguousTopTwo, wideAmbiguityMembers } from './ambiguity.js';\n12: import { attributionReason, dominantLane, isDerivedDominant } from './attribution.js';\n13: import {\n14:   ADVISOR_HOOK_FRESHNESS_VALUES,\n15:   ADVISOR_RUNTIME_VALUES,\n16:   isSpeckitMetricsEnabled,\n17:   speckitMetrics,\n18: } from '../metrics.js';\n19: import { normalize } from '../affordance-normalizer.js';\n20: import { TRACKED_COMMANDS, typedCommandIn } from '../command-attach.js';\n21: import { scoreDerivedLane } from './lanes/derived.js';\n22: import { scoreExplicitLane } from './lanes/explicit.js';\n23: import { scoreGraphCausalLaneSplit } from './lanes/graph-causal.js';\n24: import { scoreLexicalLane } from './lanes/lexical.js';\n25: import { scoreSemanticShadowExactSubset, scoreSemanticShadowLane } from './lanes/semantic-shadow.js';\n26: import { applyExecutorDelegationOverride } from './executor-delegation.js';\n27: import {\n28:   DOCTOR_HELPER_BRIDGE_ID,\n29:   DOCTOR_HELPER_UNCUED_MIN_SCORE,\n30:   doctorProblemCue,\n31:   matchDoctorProblem,\n32: } from './doctor-helper-handoff.js';\n33: import { loadAdvisorProjection } from './projection.js';\n34: import { SCORING_CALIBRATION } from './scoring-constants.js';\n35: import { isReadOnlyExplainer, matchesPhraseBoundary } from './text.js';\n36: import {\n37:   DEFAULT_SCORER_WEIGHTS,\n38:   SCORER_LANES,\n39:   liveWeightTotal,\n40: } from './weights-config.js';\n41: import { isLiveScorerLane } from './lane-registry.js';\n42: import { isRouteExcludedSkillId } from '../route-exclusions.js';\n43: import { SKILL_ADVISOR_COMPAT_CONTRACT, resolvedConfidenceThreshold, resolvedUncertaintyThreshold } from '../compat/contract.js';\n44: import type {\n45:   AdvisorProjection,\n46:   AdvisorScoredRecommendation,\n47:   AdvisorScoringOptions,\n48:   AdvisorScoringResult,\n49:   LaneContribution,\n50:   LaneMatch,\n51:   LaneRuntimeHealth,\n52:   LaneScores,\n53:   ScorerLane,\n54:   SkillProjection,\n55: } from './types.js';\n56: import type { NormalizedAffordance } from '../affordance-normalizer.js';\n57: import type { RankedList, RrfItem } from '@spec-kit/shared/algorithms/rrf-fusion.js';\n58: \n59: // ───────────────────────────────────────────────────────────────────\n60: // 2. CONSTANTS\n61: // ───────────────────────────────────────────────────────────────────\n62: \n63: const DEFAULT_CONFIDENCE_THRESHOLD = resolvedConfidenceThreshold();\n64: const DEFAULT_UNCERTAINTY_THRESHOLD = resolvedUncertaintyThreshold();\n65: export const ADVISOR_RRF_FUSION_FLAG = 'SPECKIT_ADVISOR_RRF_FUSION';\n66: export const ADVISOR_QUERY_CLASS_ROUTING_FLAG = 'SPECKIT_ADVISOR_QUERY_CLASS_ROUTING';\n67: export const ADVISOR_EXACT_SEMANTIC_RERANK_FLAG = 'SPECKIT_ADVISOR_EXACT_SEMANTIC_RERANK';\n68: export const ADVISOR_RRF_K = 8;\n69: export const ADVISOR_EXACT_SEMANTIC_RERANK_TOP_K = 10;\n70: const ADVISOR_EXACT_SEMANTIC_RERANK_WINDOW = 0.05;\n71: const TASK_INTENT = /\\b(add|append|build|change|configure|create|edit|fix|generate|implement|modify|move|patch|refactor|rename|replace|run|start|sweep|update|write)\\b/;\n72: const DEEP_RESEARCH_CYCLE = /\\b(automated research cycle|looped investigation|continue iteration|resume iteration|overnight run|overnight research run|packet-local iteration|delta record|canonical jsonl|same lineage)\\b/;\n73: // Writing a test or a helper is code work even when the prompt also names a deep-review phrase or a\n74: // study artifact: the thing asked for comes before the phrase it is written about, so a \"deep review\"\n75: // between the verb and the noun means the loop itself is the subject.\n76: const AUTHORS_CODE = /\\b(?:add|build|create|implement|write)\\b(?:(?!deep[- ]review)[^.?!]){0,60}?\\b(?:helper|vitest|tests?)\\b/;\n77: // Writing a changelog is sk-doc's changelog mode even when the prompt names a\n78: // packet or spec folder. That folder is only where the change history comes from.\n79: // The verb must govern the changelog itself: only articles and folder or scope\n80: // modifiers may sit between them, so \"add a nested phase ... for the changelog\n81: // work\" or \"write the spec folder docs, including the changelog ...\" stay\n82: // spec-folder work.\n83: const CHANGELOG_AUTHORING = /\\b(?:add|create|draft|write)\\s+(?:(?:a|an|the|new|nested|packet|packet-local|phase|global|release)\\s+){0,4}changelog(?:\\s+entry)?\\b/;\n84: const CHANGELOG_PACKET_SOURCE = /\\b(?:packet|nested|spec folder)\\b/;\n85: const FILE_SAVE_OPERATION = /\\bsave\\b.{0,48}\\b(file|files|document|documents|buffer|tab|workspace)\\b|\\b(file|files|document|documents|buffer|tab|workspace)\\b.{0,48}\\bsave\\b/;\n86: const MEMORY_SAVE_CONTEXT_ANCHOR = /\\b(memory|context|conversation|session|handover|checkpoint|resume|preserve|remember|capture|store)\\b|\\/memory:save|memory:save/;\n87: // Class C breadth/multi-concern abstention gates. A broad greenfield build or a\n88: // multi-concern optimization is under-specified for single-skill routing.\n89: const BREADTH_BUILD_VERB = /\\b(build|create|implement|generate|scaffold)\\b/;\n90: const BREADTH_NOUN = /\\b(full[- ]?stack|service|platform|application|microservice|saas|backend|whole (app|system))\\b/;\n91: // Narrow anchors that make a broad-build prompt specific enough to route.\n92: const BREADTH_NARROW_ANCHOR = /\\.[a-z]{2,4}\\b|\\b(test|tests|error|bug|failure|failing|handler|component|function|route|endpoint|class|method|benchmark|review|audit|migration|schema)\\b/;\n93: const MULTI_CONCERN_VERB = /\\b(optimize|improve|enhance|harden|speed up)\\b/;\n94: const CONCERN_PERF = /\\b(speed|latency|execution|throughput|performance|startup|memory|cpu)\\b/;\n95: const CONCERN_QUALITY = /\\b(quality|accuracy|recommendation|recommendations|correctness|reliability|coverage)\\b/;\n96: const TRUE_FLAG_VALUES = new Set(['1', 'true', 'yes', 'on', 'enabled']);\n97: const NO_RRF_RANK = Number.MAX_SAFE_INTEGER;\n98: const ADVISOR_SELF_RECOMMENDATION_SKILL_IDS = new Set(['system-skill-advisor', 'skill-advisor']);\n99: const DOCTOR_BRIDGE_PREFIX = 'command-doctor-';\n100: const DOCTOR_COMMAND_PREFIX = '/doctor:';\n101: \n102: // ───────────────────────────────────────────────────────────────────\n103: // 3. TYPE DEFINITIONS\n104: // ───────────────────────────────────────────────────────────────────\n105: \n106: type MutableLaneScores = {\n107:   -readonly [K in keyof LaneScores]: LaneMatch[];\n108: };\n109: \n110: interface LaneScoreBundle {\n111:   readonly laneScores: LaneScores;\n112:   readonly graphConflictMatches: readonly LaneMatch[];\n113:   readonly graphSupportBySeed: ReadonlyMap<string, ReadonlyMap<string, number>>;\n114: }\n115: \n116: interface AdvisorRrfFusion {\n117:   readonly scoreBySkill: ReadonlyMap<string, number>;\n118:   readonly rankBySkill: ReadonlyMap<string, number>;\n119: }\n120: \n121: type AdvisorRuntimeLabel = (typeof ADVISOR_RUNTIME_VALUES)[number];\n122: type AdvisorFreshnessLabel = (typeof ADVISOR_HOOK_FRESHNESS_VALUES)[number];\n123: export type AdvisorQueryClass = 'implementation' | 'review' | 'documentation' | 'memory' | 'tooling' | 'unknown';\n124: \n125: interface ExactSemanticRerankEntry {\n126:   readonly rawScore: number;\n127: }\n128: \n129: type ExactSemanticRerankIndex = ReadonlyMap<string, ExactSemanticRerankEntry>;\n130: \n131: // ───────────────────────────────────────────────────────────────────\n132: // 4. HELPERS\n133: // ───────────────────────────────────────────────────────────────────\n134: \n135: function emptyLaneScores(): MutableLaneScores {\n136:   return Object.fromEntries(SCORER_LANES.map((lane) => [lane, []])) as unknown as MutableLaneScores;\n137: }\n138: \n139: function projectionWithUsableSkillIds(projection: AdvisorProjection): AdvisorProjection {\n140:   const skills = projection.skills.filter((skill) => {\n141:     const skillId: unknown = skill.id;\n142:     return typeof skillId === 'string' && skillId.trim().length > 0;\n143:   });\n144:   return skills.length === projection.skills.length\n145:     ? projection\n146:     : { ...projection, skills };\n147: }\n148: \n149: export function isAdvisorRrfFusionEnabled(): boolean {\n150:   const value = process.env[ADVISOR_RRF_FUSION_FLAG]?.trim().toLowerCase();\n151:   return value ? TRUE_FLAG_VALUES.has(value) : false;\n152: }\n153: \n154: export function isAdvisorQueryClassRoutingEnabled(): boolean {\n155:   const value = process.env[ADVISOR_QUERY_CLASS_ROUTING_FLAG]?.trim().toLowerCase();\n156:   return value ? TRUE_FLAG_VALUES.has(value) : false;\n157: }\n158: \n159: export function isAdvisorExactSemanticRerankEnabled(): boolean {\n160:   const value = process.env[ADVISOR_EXACT_SEMANTIC_RERANK_FLAG]?.trim().toLowerCase();\n161:   return value ? TRUE_FLAG_VALUES.has(value) : false;\n162: }\n163: \n164: export function classifyAdvisorQuery(prompt: string): AdvisorQueryClass {\n165:   const promptLower = prompt.toLowerCase();\n166:   if (/\\b(save context|save memory|handover|resume|checkpoint|spec folder|implementation summary|packet docs?)\\b/.test(promptLower)) {\n167:     return 'memory';\n168:   }\n169:   if (/\\b(review|audit|findings|regression|pull request|pr readiness|release readiness)\\b/.test(promptLower)) {\n170:     return 'review';\n171:   }\n172:   if (/\\b(readme|markdown|documentation|docs|manual testing playbook|feature catalog|taxonomy)\\b/.test(promptLower)) {\n173:     return 'documentation';\n174:   }\n175:   if (/\\b(call_tool_chain|code mode|tool ?chain|chrome devtools|browser console|figma|github|clickup)\\b/.test(promptLower)) {\n176:     return 'tooling';\n177:   }\n178:   if (TASK_INTENT.test(promptLower) || /\\b(typescript|javascript|python|vitest|mcp|handler|schema|fixture)\\b/.test(promptLower)) {\n179:     return 'implementation';\n180:   }\n181:   return 'unknown';\n182: }\n183: \n184: export function queryClassLaneMultipliers(queryClass: AdvisorQueryClass): Readonly<Partial<Record<ScorerLane, number>>> {\n185:   switch (queryClass) {\n186:     case 'implementation':\n187:       return { explicit_author: 1.04, lexical: 1.00, graph_causal: 0.98, derived_generated: 0.98, semantic_shadow: 1.00 };\n188:     case 'review':\n189:       return { explicit_author: 1.03, lexical: 1.02, graph_causal: 0.96, derived_generated: 0.98, semantic_shadow: 1.00 };\n190:     case 'documentation':\n191:       return { explicit_author: 1.03, lexical: 0.98, graph_causal: 0.95, derived_generated: 1.04, semantic_shadow: 1.00 };\n192:     case 'memory':\n193:       return { explicit_author: 1.04, lexical: 0.98, graph_causal: 1.02, derived_generated: 1.00, semantic_shadow: 0.96 };\n194:     case 'tooling':\n195:       return { explicit_author: 1.04, lexical: 1.00, graph_causal: 0.98, derived_generated: 0.96, semantic_shadow: 1.00 };\n196:     case 'unknown':\n197:       return {};\n198:   }\n199: }\n200: \n201: export function applyQueryClassLaneMultipliers(\n202:   weights: Readonly<Record<ScorerLane, number>>,\n203:   queryClass: AdvisorQueryClass,\n204: ): Readonly<Record<ScorerLane, number>> {\n205:   const multipliers = queryClassLaneMultipliers(queryClass);\n206:   if (Object.keys(multipliers).length === 0) return weights;\n207:   const next = { ...weights };\n208:   for (const lane of SCORER_LANES) {\n209:     const multiplier = multipliers[lane];\n210:     if (typeof multiplier === 'number' && Number.isFinite(multiplier)) {\n211:       next[lane] = Number((next[lane] * multiplier).toFixed(6));\n212:     }\n213:   }\n214:   const strongestOther = Math.max(...SCORER_LANES\n215:     .filter((lane) => lane !== 'explicit_author')\n216:     .map((lane) => next[lane]));\n217:   if (next.explicit_author < strongestOther) {\n218:     next.explicit_author = Number(strongestOther.toFixed(6));\n219:   }\n220:   return next;\n221: }\n222: \n223: function effectiveScorerWeights(\n224:   override: AdvisorScoringOptions['laneWeightsOverride'] | undefined,\n225:   queryClass: AdvisorQueryClass = 'unknown',\n226: ): Readonly<Record<ScorerLane, number>> {\n227:   const base = !override ? DEFAULT_SCORER_WEIGHTS : (() => {\n228:     const weights: Record<ScorerLane, number> = { ...DEFAULT_SCORER_WEIGHTS };\n229:     const runtimeOverride = override as Partial<Record<string, number>>;\n230:     for (const lane of SCORER_LANES) {\n231:       const value = runtimeOverride[lane];\n232:       if (typeof value === 'number' && Number.isFinite(value)) {\n233:         weights[lane] = value;\n234:       }\n235:     }\n236:     return weights;\n237:   })();\n238:   if (queryClass === 'unknown') return base;\n239:   return applyQueryClassLaneMultipliers(base, queryClass);\n240: }\n241: \n242: function normalizeRuntimeLabel(value: string | undefined): AdvisorRuntimeLabel | null {\n243:   if (value === undefined) {\n244:     return null;\n245:   }\n246:   return ADVISOR_RUNTIME_VALUES.includes(value as AdvisorRuntimeLabel) ? value as AdvisorRuntimeLabel : null;\n247: }\n248: \n249: function normalizeFreshnessLabel(value: string | undefined): AdvisorFreshnessLabel | null {\n250:   if (value === undefined) {\n251:     return 'unavailable';\n252:   }\n253:   return ADVISOR_HOOK_FRESHNESS_VALUES.includes(value as AdvisorFreshnessLabel) ? value as AdvisorFreshnessLabel : null;\n254: }\n255: \n256: interface LaneMatchIndexEntry {\n257:   rawScore: number;\n258:   evidence: string[];\n259:   producerSkillIds: string[];\n260: }\n261: \n262: type LaneMatchIndex = Map<string, LaneMatchIndexEntry>;\n263: \n264: function buildLaneRuntimeHealth(\n265:   laneScores: LaneScores,\n266:   disabled: ReadonlySet<ScorerLane>,\n267:   runtimeLaneHealth: AdvisorScoringOptions['runtimeLaneHealth'] | undefined,\n268: ): readonly LaneRuntimeHealth[] {\n269:   return SCORER_LANES.map((lane): LaneRuntimeHealth => {\n270:     const matchCount = laneScores[lane].length;\n271:     const signal = runtimeLaneHealth?.[lane];\n272:     if (!disabled.has(lane) && signal?.status === 'runtime_degraded' && matchCount === 0) {\n273:       return {\n274:         lane,\n275:         status: 'runtime_degraded',\n276:         matchCount,\n277:         ...(signal.reason ? { reason: signal.reason } : {}),\n278:       };\n279:     }\n280:     return {\n281:       lane,\n282:       status: matchCount > 0 ? 'healthy' : 'matched_nothing',\n283:       matchCount,\n284:       ...(signal?.reason && signal.status === 'healthy' ? { reason: signal.reason } : {}),\n285:     };\n286:   });\n287: }\n288: \n289: function projectionRuntimeLaneHealth(\n290:   projection: AdvisorProjection,\n291:   runtimeLaneHealth: AdvisorScoringOptions['runtimeLaneHealth'] | undefined,\n292: ): AdvisorScoringOptions['runtimeLaneHealth'] | undefined {\n293:   if (!projection.embeddingStaleness?.stale) {\n294:     return runtimeLaneHealth;\n295:   }\n296:   return {\n297:     ...runtimeLaneHealth,\n298:     semantic_shadow: runtimeLaneHealth?.semantic_shadow ?? {\n299:       status: 'runtime_degraded',\n300:       reason: projection.embeddingStaleness.reason ?? 'projection_embedding_stale',\n301:     },\n302:   };\n303: }\n304: \n305: function degradedLaneReason(degradedLanes: readonly ScorerLane[]): string | null {\n306:   if (degradedLanes.length === 0) return null;\n307:   return `Runtime-degraded scorer lanes omitted from confidence normalization: ${degradedLanes.join(', ')}.`;\n308: }\n309: \n310: function buildLaneMatchIndex(matches: readonly LaneMatch[]): LaneMatchIndex {\n311:   const index: LaneMatchIndex = new Map();\n312:   for (const match of matches) {\n313:     const existing = index.get(match.skillId) ?? { rawScore: 0, evidence: [], producerSkillIds: [] };\n314:     existing.rawScore = Math.max(existing.rawScore, match.score);\n315:     if (existing.evidence.length < 6) {\n316:       existing.evidence.push(...match.evidence.slice(0, 6 - existing.evidence.length));\n317:     }\n318:     for (const producerSkillId of match.producerSkillIds ?? []) {\n319:       if (!existing.producerSkillIds.includes(producerSkillId)) {\n320:         existing.producerSkillIds.push(producerSkillId);\n321:       }\n322:     }\n323:     index.set(match.skillId, existing);\n324:   }\n325:   return index;\n326: }\n327: \n328: function buildConflictMatchIndex(matches: readonly LaneMatch[]): LaneMatchIndex {\n329:   const index: LaneMatchIndex = new Map();\n330:   for (const match of matches) {\n331:     const existing = index.get(match.skillId) ?? { rawScore: 0, evidence: [], producerSkillIds: [] };\n332:     existing.rawScore = Math.min(existing.rawScore, match.score);\n333:     if (existing.evidence.length < 6) {\n334:       existing.evidence.push(...match.evidence.slice(0, 6 - existing.evidence.length));\n335:     }\n336:     index.set(match.skillId, existing);\n337:   }\n338:   return index;\n339: }\n340: \n341: function rankedRrfItems(matches: readonly LaneMatch[]): RrfItem[] {\n342:   return [...matches]\n343:     .filter((match) => match.score > 0)\n344:     .sort((left, right) => right.score - left.score || left.skillId.localeCompare(right.skillId))\n345:     .map((match) => ({ id: match.skillId }));\n346: }\n347: \n348: export function fuseAdvisorLaneRanks(\n349:   laneScores: LaneScores,\n350:   weights: Readonly<Record<ScorerLane, number>>,\n351:   disabled: ReadonlySet<ScorerLane> = new Set(),\n352:   runtimeDegraded: ReadonlySet<ScorerLane> = new Set(),\n353: ): AdvisorRrfFusion {\n354:   const lists: RankedList[] = SCORER_LANES.map((lane) => ({\n355:     source: lane,\n356:     results: rankedRrfItems(laneScores[lane]),\n357:     weight: disabled.has(lane) || runtimeDegraded.has(lane) || !isLiveScorerLane(lane)\n358:       ? 0\n359:       : weights[lane],\n360:   }));\n361:   const fused = fuseResultsMulti(lists, {\n362:     k: ADVISOR_RRF_K,\n363:     convergenceBonus: 0,\n364:     calibratedOverlapBeta: 0,\n365:     bonusOverChannels: 'configured',\n366:   });\n367:   const scoreBySkill = new Map<string, number>();\n368:   const rankBySkill = new Map<string, number>();\n369:   fused.forEach((result, index) => {\n370:     const skillId = String(result.id);\n371:     scoreBySkill.set(skillId, result.rrfScore);\n372:     rankBySkill.set(skillId, index);\n373:   });\n374:   return { scoreBySkill, rankBySkill };\n375: }\n376: \n377: function graphConflictAdjustment(\n378:   conflictIndex: LaneMatchIndex,\n379:   recommendation: AdvisorScoredRecommendation,\n380: ): number {\n381:   return conflictIndex.get(recommendation.skill)?.rawScore ?? 0;\n382: }\n383: \n384: function buildExactSemanticRerankIndex(\n385:   prompt: string,\n386:   projection: AdvisorProjection,\n387:   recommendations: readonly AdvisorScoredRecommendation[],\n388:   fusion: AdvisorRrfFusion | null,\n389: ): ExactSemanticRerankIndex {\n390:   if (!fusion) return new Map();\n391:   const topSkillIds = [...recommendations]\n392:     .filter((recommendation) => fusion.rankBySkill.has(recommendation.skill))\n393:     .sort((left, right) => rrfRankFor(fusion, left) - rrfRankFor(fusion, right))\n394:     .slice(0, ADVISOR_EXACT_SEMANTIC_RERANK_TOP_K)\n395:     .map((recommendation) => recommendation.skill);\n396:   const matches = scoreSemanticShadowExactSubset(prompt, projection, topSkillIds);\n397:   return new Map(matches.map((match) => [match.skillId, {\n398:     rawScore: match.score,\n399:   }]));\n400: }\n401: \n402: function exactSemanticRerankScore(\n403:   rerankIndex: ExactSemanticRerankIndex,\n404:   recommendation: AdvisorScoredRecommendation,\n405: ): number | null {\n406:   return rerankIndex.get(recommendation.skill)?.rawScore ?? null;\n407: }\n408: \n409: function rrfRankFor(\n410:   fusion: AdvisorRrfFusion | null,\n411:   recommendation: AdvisorScoredRecommendation,\n412: ): number {\n413:   return fusion?.rankBySkill.get(recommendation.skill) ?? NO_RRF_RANK;\n414: }\n415: \n416: function promptMentionsSkill(promptLower: string, skill: SkillProjection): boolean {\n417:   const phrases = [skill.id, skill.name, skill.id.replace(/-/g, ' ')];\n418:   // A cli skill wraps one named external tool, so the tool's own name (\"orca\"\n419:   // for cli-orca) names the skill as surely as its id does.\n420:   if (skill.family === 'cli' && skill.id.startsWith('cli-')) {\n421:     phrases.push(skill.id.slice('cli-'.length).replace(/-/g, ' '));\n422:   }\n423:   return phrases.some((phrase) => matchesPhraseBoundary(promptLower, phrase.toLowerCase()));\n424: }\n425: \n426: function isDefaultRoutable(promptLower: string, skill: SkillProjection): boolean {\n427:   if (isRouteExcludedSkillId(skill.id)) return false;\n428:   if (skill.lifecycleStatus === 'archived' || skill.lifecycleStatus === 'future') return false;\n429:   if (skill.lifecycleStatus === 'deprecated') return promptMentionsSkill(promptLower, skill);\n430:   return true;\n431: }\n432: \n433: function isAdvisorSelfRecommendationSkill(skillId: string): boolean {\n434:   return ADVISOR_SELF_RECOMMENDATION_SKILL_IDS.has(skillId);\n435: }\n436: \n437: function confidenceFor(args: {\n438:   liveNormalized: number;\n439:   directScore: number;\n440:   readOnlyExplainer: boolean;\n441:   hasExplicitWorkflowSignal: boolean;\n442:   hasTaskIntent: boolean;\n443:   readOnlyRouteAllowed: boolean;\n444:   derivedDominant: boolean;\n445:   skillId: string;\n446: }): { value: number; floored: boolean } {\n447:   const C = SCORING_CALIBRATION.confidence;\n448:   // The advisor alias must never rank itself first on a read-only explainer;\n449:   // floor its confidence. The canonical id is demoted separately by the audit\n450:   // penalty in primaryIntentBonus, so this branch intentionally matches only\n451:   // the alias id.\n452:   if (args.readOnlyExplainer && args.skillId === 'skill-advisor') {\n453:     return { value: C.readOnlyExplainerFloor, floored: false };\n454:   }\n455:   const base = C.baseConstant\n456:     + Math.min(1, args.liveNormalized * C.liveNormalizedRampGain) * C.liveNormalizedRampCoefficient;\n457:   if (args.readOnlyExplainer && !args.readOnlyRouteAllowed) {\n458:     return { value: C.readOnlyExplainerFloor, floored: false };\n459:   }\n460:   if (args.readOnlyRouteAllowed) {\n461:     return {\n462:       value: Number(Math.max(base, C.readOnlyRouteAllowedFloor).toFixed(4)),\n463:       floored: C.readOnlyRouteAllowedFloor > base,\n464:     };\n465:   }\n466:   if (args.derivedDominant && args.directScore < C.derivedDominantDirectScoreCeiling) {\n467:     return { value: C.derivedDominantConfidence, floored: false };\n468:   }\n469:   if (args.hasTaskIntent\n470:     && (args.directScore >= C.taskIntentDirectScoreFloor\n471:       || args.liveNormalized >= C.taskIntentLiveNormalizedFloor)) {\n472:     // Token-stuffing dispersion guard. Without this, a prompt\n473:     // with task-intent + many weak signals (saturating liveNormalized) but\n474:     // no strong direct anchor would force confidence to taskIntentFloor for\n475:     // many unrelated skills. The guard fires when liveNormalized is near-\n476:     // saturated AND directScore is below the directScoreLiftThreshold —\n477:     // the precise signature of a token-stuffed prompt. Legitimate task-intent\n478:     // prompts have at least one strong direct hit and pass via directScore;\n479:     // they don't hit this branch. When the guard fires we fall through to\n480:     // the standard `base + directBonus` math below.\n481:     const dispersionGuardTripped = args.liveNormalized >= 0.95\n482:       && args.directScore < C.directScoreLiftThreshold;\n483:     if (!dispersionGuardTripped) {\n484:       return {\n485:         value: Number(Math.max(base, C.taskIntentFloor).toFixed(4)),\n486:         floored: C.taskIntentFloor > base,\n487:       };\n488:     }\n489:   }\n490:   if (args.directScore >= C.directScoreLiftThreshold) {\n491:     return {\n492:       value: Number(Math.max(base, C.directScoreFloor).toFixed(4)),\n493:       floored: C.directScoreFloor > base,\n494:     };\n495:   }\n496:   const directBonus = args.directScore >= C.directScoreBonusThreshold ? C.directScoreBonus : 0;\n497:   return { value: Number(Math.max(0, Math.min(C.hardCeiling, base + directBonus)).toFixed(4)), floored: false };\n498: }\n499: \n500: function uncertaintyFor(contributions: readonly LaneContribution[], confidence: number, ambiguousPressure: number): number {\n501:   const U = SCORING_CALIBRATION.uncertainty;\n502:   const evidenceCount = contributions.reduce((total, contribution) => total + contribution.evidence.length, 0);\n503:   const direct = contributions\n504:     .filter((contribution) => contribution.lane === 'explicit_author' || contribution.lane === 'lexical')\n505:     .reduce((max, contribution) => Math.max(max, contribution.rawScore), 0);\n506:   let uncertainty = U.noEvidenceDefault;\n507:   if (evidenceCount >= U.highEvidenceCount) uncertainty = U.lowFloor;\n508:   else if (evidenceCount >= U.mediumEvidenceCount) uncertainty = U.mediumFloor;\n509:   else if (evidenceCount >= U.someEvidenceCount) uncertainty = U.elevatedFloor;\n510:   if (direct >= U.directEvidenceDiscountThreshold) uncertainty -= U.directEvidenceDiscount;\n511:   if (confidence < U.lowConfidencePenaltyThreshold) uncertainty += U.lowConfidencePenalty;\n512:   uncertainty += ambiguousPressure;\n513:   return Number(Math.max(U.hardFloor, Math.min(U.hardCeiling, uncertainty)).toFixed(2));\n514: }\n515: \n516: function buildLaneScores(\n517:   prompt: string,\n518:   projection: AdvisorProjection,\n519:   disabled: Set<ScorerLane>,\n520:   affordances: readonly NormalizedAffordance[],\n521:   useRrfFusion: boolean,\n522: ): LaneScoreBundle {\n523:   const scores = emptyLaneScores();\n524:   if (!disabled.has('explicit_author')) {\n525:     scores.explicit_author = scoreExplicitLane(prompt, projection);\n526:   }\n527:   if (!disabled.has('lexical')) scores.lexical = scoreLexicalLane(prompt, projection);\n528:   if (!disabled.has('derived_generated')) scores.derived_generated = scoreDerivedLane(prompt, projection, new Date(), affordances);\n529:   if (!disabled.has('semantic_shadow')) scores.semantic_shadow = scoreSemanticShadowLane(prompt, projection);\n530:   let graphConflictMatches: readonly LaneMatch[] = [];\n531:   let graphSupportBySeed: ReadonlyMap<string, ReadonlyMap<string, number>> = new Map();\n532:   if (!disabled.has('graph_causal')) {\n533:     const graphSplit = scoreGraphCausalLaneSplit([\n534:       ...scores.explicit_author,\n535:       ...scores.lexical,\n536:       ...scores.derived_generated,\n537:     ], projection, {}, affordances);\n538:     scores.graph_causal = useRrfFusion ? graphSplit.positiveMatches : graphSplit.combinedMatches;\n539:     graphConflictMatches = graphSplit.conflictMatches;\n540:     graphSupportBySeed = graphSplit.positiveSupportBySeed;\n541:   }\n542:   return { laneScores: scores, graphConflictMatches, graphSupportBySeed };\n543: }\n544: \n545: // Smallest gap the rounded weighted score can still express, so a bounded\n546: // target sorts strictly below its seed instead of tying with it.\n547: const SEED_BOUND_GAP = 0.000001;\n548: \n549: // Below this explicit-lane score a match is a side mention, not a request.\n550: const EXPLICIT_WORKFLOW_SIGNAL_FLOOR = 0.55;\n551: \n552: // Explicit-lane evidence that a typed slash command named this skill.\n553: const SLASH_COMMAND_EVIDENCE = /^(phrase|author|explicit):\\//;\n554: \n555: export function hasSlashCommandAnchor(rawScore: number, evidence: readonly string[]): boolean {\n556:   return rawScore >= EXPLICIT_WORKFLOW_SIGNAL_FLOOR\n557:     && evidence.some((entry) => SLASH_COMMAND_EVIDENCE.test(entry));\n558: }\n559: \n560: // Graph support is lent: a seed's own evidence propagates to its neighbours so\n561: // related skills surface beside it. When the seed was invoked by a typed slash\n562: // command, the user has named it outright, so support it lends may lift a\n563: // target up to it but never past it; otherwise the command's own match is what\n564: // buries the command (a typed \"/deep:research\" handing its dependency enough\n565: // support to win). Seeds matched only on loose tokens keep ordinary graph\n566: // lending, since there the neighbour may well be the better route. Two skills\n567: // often lend to each other, so the pair is compared on what each holds once\n568: // the other's loan is taken back: a target whose own evidence still beats the\n569: // seed's own evidence keeps its score.\n570: export function boundGraphSupportBySeed(\n571:   scores: ReadonlyMap<string, number>,\n572:   graphRawBySkill: ReadonlyMap<string, number>,\n573:   graphSupportBySeed: ReadonlyMap<string, ReadonlyMap<string, number>>,\n574:   graphWeight: number,\n575:   slashAnchoredSeeds: ReadonlySet<string>,\n576: ): Map<string, number> {\n577:   return boundGraphSupportBySeedWithHolders(\n578:     scores,\n579:     graphRawBySkill,\n580:     graphSupportBySeed,\n581:     graphWeight,\n582:     slashAnchoredSeeds,\n583:   ).scores;\n584: }\n585: \n586: export interface SeedBoundResult {\n587:   readonly scores: Map<string, number>;\n588:   // Target skill -> the typed-command seed whose ceiling actually lowered it.\n589:   readonly heldBelow: Map<string, string>;\n590: }\n591: \n592: export function boundGraphSupportBySeedWithHolders(\n593:   scores: ReadonlyMap<string, number>,\n594:   graphRawBySkill: ReadonlyMap<string, number>,\n595:   graphSupportBySeed: ReadonlyMap<string, ReadonlyMap<string, number>>,\n596:   graphWeight: number,\n597:   slashAnchoredSeeds: ReadonlySet<string>,\n598: ): SeedBoundResult {\n599:   const bounded = new Map(scores);\n600:   const heldBelow = new Map<string, string>();\n601:   if (graphWeight <= 0) return { scores: bounded, heldBelow };\n602:   const lentBy = (lenderId: string, receiverId: string): number => {\n603:     const support = graphSupportBySeed.get(receiverId)?.get(lenderId) ?? 0;\n604:     const graphRaw = Math.max(0, graphRawBySkill.get(receiverId) ?? 0);\n605:     return Math.min(support, graphRaw) * graphWeight;\n606:   };\n607:   // Which seed holds which target down is decided once, on the unbounded\n608:   // scores, so the evidence comparison never sees a cap.\n609:   const holdersByTarget = new Map<string, string[]>();\n610:   for (const [targetId, supportBySeed] of graphSupportBySeed) {\n611:     const targetScore = scores.get(targetId);\n612:     if (targetScore === undefined) continue;\n613:     const holders: string[] = [];\n614:     for (const seedId of supportBySeed.keys()) {\n615:       if (seedId === targetId || !slashAnchoredSeeds.has(seedId)) continue;\n616:       const seedScore = scores.get(seedId);\n617:       if (seedScore === undefined) continue;\n618:       const targetOwn = targetScore - lentBy(seedId, targetId);\n619:       const seedOwn = seedScore - lentBy(targetId, seedId);\n620:       if (targetOwn < seedOwn) holders.push(seedId);\n621:     }\n622:     if (holders.length > 0) holdersByTarget.set(targetId, holders);\n623:   }\n624:   // A held seed can itself be held by another typed command, so each ceiling\n625:   // follows the seed's bounded score and the caps repeat until nothing moves.\n626:   // Caps only ever lower a score, and each pass settles at least one more link\n627:   // of a chain, so one pass per held target is enough.\n628:   for (let pass = 0; pass <= holdersByTarget.size; pass += 1) {\n629:     let moved = false;\n630:     for (const [targetId, holders] of holdersByTarget) {\n631:       const current = bounded.get(targetId) ?? 0;\n632:       let ceiling = current;\n633:       for (const seedId of holders) ceiling = Math.min(ceiling, (bounded.get(seedId) ?? 0) - SEED_BOUND_GAP);\n634:       if (ceiling < current) {\n635:         bounded.set(targetId, Math.max(0, ceiling));\n636:         moved = true;\n637:       }\n638:     }\n639:     if (!moved) break;\n640:   }\n641:   // Only a target the cap really lowered is marked, and only against the seed\n642:   // whose ceiling set its final score: a seed that merely could have held it\n643:   // ranked nothing, so the pair keeps its ordinary ambiguity check.\n644:   for (const [targetId, holders] of holdersByTarget) {\n645:     const final = bounded.get(targetId) ?? 0;\n646:     if (final >= (scores.get(targetId) ?? 0)) continue;\n647:     let binding: string | null = null;\n648:     let lowestSeed = Number.POSITIVE_INFINITY;\n649:     for (const seedId of holders) {\n650:       const seedScore = bounded.get(seedId) ?? 0;\n651:       if (seedScore < lowestSeed) {\n652:         lowestSeed = seedScore;\n653:         binding = seedId;\n654:       }\n655:     }\n656:     if (binding) heldBelow.set(targetId, binding);\n657:   }\n658:   return { scores: bounded, heldBelow };\n659: }\n660: \n661: function hasExplicitWorkflowSignal(contributions: readonly LaneContribution[], skillId: string): boolean {\n662:   const explicit = contributions.find((contribution) => contribution.lane === 'explicit_author');\n663:   if (!explicit || explicit.rawScore < EXPLICIT_WORKFLOW_SIGNAL_FLOOR) return false;\n664:   return explicit.evidence.some((entry) => (\n665:     entry.startsWith('phrase:')\n666:     || entry.startsWith('explicit:')\n667:     || entry.startsWith('author:')\n668:     || entry.includes(skillId)\n669:     || entry.includes('loop')\n670:     || entry.includes('write-')\n671:   ));\n672: }\n673: \n674: // Wording that asks for an answer and rules out a change. One pattern serves\n675: // every gate that has to honour it, so a new gate cannot drift from the first.\n676: const NO_EDIT_REQUEST = /\\b(no edits?|without making changes|do not (change|edit|modify|touch)|read-only only|no edits yet|only; do not|just show|just list)\\b/;\n677: \n678: export function readOnlyRouteAllowed(promptLower: string, skill: SkillProjection): boolean {\n679:   const skillId = skill.id;\n680:   if (NO_EDIT_REQUEST.test(promptLower)) {\n681:     return false;\n682:   }\n683:   // The explainer floor exists to stop an ambiguous read-only question from\n684:   // routing anywhere. Naming the skill removes the ambiguity: the caller has\n685:   // already chosen, and a read-only verb does not undo that choice. Without\n686:   // this, an explicit request is answered with an abstention while the same\n687:   // sentence phrased with a write verb routes fine.\n688:   if (promptMentionsSkill(promptLower, skill)) {\n689:     return true;\n690:   }\n691:   // A command whose route only reads (a report, a status check) is the answer\n692:   // to a list or show question, so its own trigger phrase lifts it off the\n693:   // floor. A mutating command never carries the flag and stays gated.\n694:   if (skill.kind === 'command' && 'readOnly' in skill && skill.readOnly === true\n695:     && skill.keywords.some((phrase) => matchesPhraseBoundary(promptLower, phrase.toLowerCase()))) {\n696:     return true;\n697:   }\n698:   if (skillId === 'sk-code' && /\\b(compare|audit|review)\\b/.test(promptLower)\n699:     && /\\b(classifier|vocabulary|prose|implementation|agents\\.md|drift|mismatch)\\b/.test(promptLower)) {\n700:     return true;\n701:   }\n702:   if (skillId === 'system-spec-kit' && /\\b(memory_save|resume_write|routing taxonomy|corpus|source-type|routing bucket)\\b/.test(promptLower)) {\n703:     return true;\n704:   }\n705:   if (skillId === 'system-spec-kit' && /\\b(packet|spec folder|save memory|phase|continuation prompts|resume handling)\\b/.test(promptLower)) {\n706:     return true;\n707:   }\n708:   // Captured operator answers wait in a queue that spec-kit's save step owns, so a show or list\n709:   // question about that queue, its chat candidates or the decision record is answered there.\n710:   // Only a read-only question is lifted: a lift applies to any prompt, and a request to research,\n711:   // dispatch or build something about decisions belongs to another skill.\n712:   if (skillId === 'system-spec-kit' && isReadOnlyExplainer(promptLower)\n713:     && /\\b(decision capture|decision record|chat candidates?|operator decisions?|recorded as decisions?)\\b/.test(promptLower)) {\n714:     return true;\n715:   }\n716:   // The trigger index is spec-kit's own lookup surface, so a question about what a lookup\n717:   // returned, counted or left out is answered there. Without the lift no skill passes on such a\n718:   // question, and the doctor hand-off claims it on the index noun alone. Drift is the doctor's\n719:   // own diagnosis, so a drift question stays with the hand-off.\n720:   if (skillId === 'system-spec-kit' && isReadOnlyExplainer(promptLower)\n721:     && /\\btrigger[- ]index\\b/.test(promptLower) && !/\\bdrift\\b/.test(promptLower)) {\n722:     return true;\n723:   }\n724:   if (skillId === 'system-deep-loop' && /\\b(ai council|planning council|council deliberation|council artifacts|multi-seat planning)\\b/.test(promptLower)) {\n725:     return true;\n726:   }\n727:   // Browser/devtools inspection is a genuine chrome-devtools task even though\n728:   // its verb (\"inspect\") reads as a read-only explainer. Lift it off the\n729:   // explainer floor when the prompt carries devtools-specific vocabulary.\n730:   if (skillId === 'mcp-tooling'\n731:     && /\\b(network waterfall|network tab|network request|dev ?tools|browser console|page inspector|dom inspector|performance trace|inspect (the )?(network|dom|page|element|browser))\\b/.test(promptLower)) {\n732:     return true;\n733:   }\n734:   if (skillId === 'sk-code' && /\\bgate-3-classifier\\.ts\\b/.test(promptLower)) {\n735:     return true;\n736:   }\n737:   return false;\n738: }\n739: \n740: function isPlainFileSavePrompt(promptLower: string): boolean {\n741:   return FILE_SAVE_OPERATION.test(promptLower) && !MEMORY_SAVE_CONTEXT_ANCHOR.test(promptLower.replace(/\\bfile(s)?\\b/g, ''));\n742: }\n743: \n744: function primaryIntentBonus(\n745:   promptLower: string,\n746:   recommendation: AdvisorScoredRecommendation,\n747: ): number {\n748:   const R = SCORING_CALIBRATION.routing;\n749:   if (/\\bsemantic (code )?search\\b/.test(promptLower)) {\n750:   }\n751:   if (/\\bdeep[- ]review\\b/.test(promptLower)) {\n752:     if (recommendation.skill === 'sk-code') {\n753:       return AUTHORS_CODE.test(promptLower) ? R.deepReviewCodeAuthoringSkCodeBonus : R.deepReviewSkCodeReviewPenalty;\n754:     }\n755:   }\n756:   if (/\\bdeep[- ]research\\b/.test(promptLower)) {\n757:     if (recommendation.skill === 'system-spec-kit' || recommendation.skill === 'sk-code') return R.deepResearchOtherSkillsPenalty;\n758:   }\n759:   if (DEEP_RESEARCH_CYCLE.test(promptLower)) {\n760:     if (recommendation.skill === 'system-spec-kit' || recommendation.skill === 'sk-code') return R.deepResearchCycleOtherSkillsPenalty;\n761:   }\n762:   if (/\\b(compare|audit|review)\\b/.test(promptLower) && /\\b(classifier|vocabulary|prose|implementation|agents\\.md|drift|mismatch)\\b/.test(promptLower)) {\n763:     if (recommendation.skill === 'sk-code') return R.compareAuditCodeReviewBonus;\n764:   }\n765:   // A changelog request that names its packet or spec folder still asks for a\n766:   // changelog, so sk-doc must outrank the spec workflow that \"spec folder\" lifts.\n767:   // Only those two skills are adjusted here. Every other skill falls through so\n768:   // later rules such as save-context or /speckit:plan still apply to it.\n769:   const changelogFromPacket = CHANGELOG_AUTHORING.test(promptLower)\n770:     && CHANGELOG_PACKET_SOURCE.test(promptLower)\n771:     && !AUTHORS_CODE.test(promptLower);\n772:   if (changelogFromPacket) {\n773:     if (recommendation.skill === 'sk-doc') return R.changelogFromPacketSkDocBonus;\n774:     if (recommendation.skill === 'system-spec-kit') return R.changelogFromPacketSpecKitPenalty;\n775:   }\n776:   // The corpus-study rule reads \"packet-local\" as study vocabulary, so it must\n777:   // stay off a changelog request or it would pull the prompt to system-spec-kit.\n778:   // \"packet-local changelog\" names sk-doc's changelog mode with or without an\n779:   // authoring verb, so packet-local is study vocabulary only when it qualifies\n780:   // something other than a changelog.\n781:   if (!changelogFromPacket && /\\b(corpus ids?|first-100 predictions|continuation prompts|routing study config|confusion matrix|source-mix note|prompt template|packet-local(?!\\s+changelog))\\b/.test(promptLower) && !AUTHORS_CODE.test(promptLower)) {\n782:     if (recommendation.skill === 'system-spec-kit') return R.corpusStudySpecKitBonus;\n783:     if (recommendation.skill === 'sk-prompt' || recommendation.skill === 'mcp-tooling' || recommendation.skill === 'sk-doc') return R.corpusStudyOtherSkillsPenalty;\n784:   }\n785:   if (promptLower.includes('/speckit:resume')) {\n786:     if (recommendation.skill === 'system-spec-kit') return R.speckitResumeSpecKitBonus;\n787:     if (recommendation.skill === 'command-speckit-resume') return R.speckitResumeCommandPenalty;\n788:   }\n789:   if (promptLower.includes('/speckit:plan')) {\n790:     if (recommendation.skill === 'command-speckit-plan') return R.speckitPlanCommandBonus;\n791:     if (recommendation.skill === 'sk-doc') return R.speckitPlanSkDocPenalty;\n792:   }\n793:   // External-tool-chain (\"call_tool_chain\") vocabulary belongs to mcp-code-mode,\n794:   // not the generic code skill. Disambiguate so the best guess for these\n795:   // toolchain-shaped prompts is mcp-code-mode.\n796:   // Toolchain + external-data-source vocabulary (webflow CMS, cms collection)\n797:   // is mcp-code-mode territory, not the generic code skill.\n798:   if (/\\b(call_tool_chain|code mode|tool ?chain|api chain|webflow cms|cms collection)\\b/.test(promptLower)) {\n799:     if (recommendation.skill === 'mcp-code-mode') return R.mcpToolchainCodeModeBonus;\n800:     if (recommendation.skill === 'sk-code') return R.mcpToolchainSkCodePenalty;\n801:   }\n802:   // A \"code audit\" is a single-pass code-review task, not a deep-review loop, so\n803:   // sk-code should win the near-tie this phrase produces. The sk-code bonus\n804:   // carries that; the deep-loop skills intentionally hold no \"code audit\"\n805:   // vocabulary, so they need no counter-penalty here.\n806:   if (/\\bcode audit\\b/.test(promptLower)) {\n807:     if (recommendation.skill === 'sk-code') return R.codeAuditCodeReviewBonus;\n808:   }\n809:   // Colon-command review-loop syntax (\":review:auto\") invokes the deep-review\n810:   // loop; rank it above single-pass code review.\n811:   if (/:review:(auto|confirm)\\b/.test(promptLower)) {\n812:     if (recommendation.skill === 'system-deep-loop') return R.reviewLoopDeepReviewBonus;\n813:     if (recommendation.skill === 'sk-code') return R.deepReviewSkCodeReviewPenalty;\n814:   }\n815:   // Auditing recommendation quality is a review task, not an advisor-self task.\n816:   if (/\\baudit\\b/.test(promptLower) && /\\b(recommendation|recommendations|recommendation quality|routing quality)\\b/.test(promptLower)) {\n817:     if (recommendation.skill === 'sk-code') return R.auditRecsCodeReviewBonus;\n818:     // Auditing routing output is a review task, not an advisor invocation: demote\n819:     // the advisor and its alias (the canonical self-rec id set) so neither ranks\n820:     // itself first here.\n821:     if (isAdvisorSelfRecommendationSkill(recommendation.skill)) return R.auditRecsAdvisorPenalty;\n822:   }\n823:   if (/\\b(save context|save memory)\\b/.test(promptLower)) {\n824:     if (recommendation.skill === 'command-speckit-save') return R.saveContextMemorySaveBonus;\n825:     if (recommendation.skill === 'system-spec-kit') return R.saveContextMemorySpecKitPenalty;\n826:   }\n827:   if (/\\b(create (a )?new agent|create agent)\\b/.test(promptLower) || promptLower.includes('/create:agent')) {\n828:     if (recommendation.skill === 'create:agent') return R.createAgentCreateAgentBonus;\n829:     if (recommendation.skill === 'sk-doc') return R.createAgentSkDocPenalty;\n830:   }\n831:   if (/\\bcreate (a )?(test|testing) playbook\\b/.test(promptLower) || promptLower.includes('/create:manual-testing-playbook')) {\n832:     if (recommendation.skill === 'create:manual-testing-playbook' || recommendation.skill === 'command-create-manual-testing-playbook') return R.createTestingPlaybookBonus;\n833:     if (recommendation.skill === 'sk-doc') return R.createTestingPlaybookSkDocPenalty;\n834:     if (recommendation.skill === 'system-deep-loop') return R.createTestingPlaybookOtherSkillsPenalty;\n835:   }\n836:   if (/\\bphase folder\\b/.test(promptLower)) {\n837:     if (recommendation.skill === 'system-spec-kit') return R.phaseFolderSpecKitBonus;\n838:   }\n839:   return 0;\n840: }\n841: \n842: // ───────────────────────────────────────────────────────────────────\n843: // 5. CORE LOGIC\n844: // ───────────────────────────────────────────────────────────────────\n845: \n846: // The bar sits above the highest cosine any prompt that must stay silent reached\n847: // against a command row, with headroom, because a command offered for the wrong\n848: // prompt costs more than one that stays quiet. The margin asks for a small lead\n849: // over the next command and over the top skill, which is what kept a wrong\n850: // command out of first place on the tuning rows. Raise the bar before the\n851: // margin if a false offer appears.\n852: export const COMMAND_MEANING_MIN_COSINE = 0.72;\n853: export const COMMAND_MEANING_MARGIN = 0.02;\n854: \n855: // The lane reports a real embedder cosine as \"cosine:\", while the word-overlap\n856: // stand-in used under test reports \"shadow:\". Only a real cosine may carry a\n857: // command on meaning, because the stand-in measures shared words rather than\n858: // shared meaning.\n859: function commandMeaningCosine(contribution: LaneContribution | undefined): number | null {\n860:   if (!contribution) return null;\n861:   return contribution.evidence.some((entry) => entry.startsWith('cosine:'))\n862:     ? contribution.rawScore\n863:     : null;\n864: }\n865: \n866: // A command bridge passes on its own wording: one of its authored phrases or its\n867: // runnable slash string, which the explicit-author lane reports. A bridge that\n868: // passed on shared single tokens alone stays scored but stops passing, because\n869: // its phrases are everyday words and a command must not be offered for a prompt\n870: // that merely shares some of them. A paraphrase shares no words at all, so the\n871: // second way in is meaning: a real prompt embedding that clears both bars above.\n872: // Meaning-passed ids are collected so a later ordering step can tell them apart,\n873: // and a doctor problem in other words reaches /doctor:helper through\n874: // applyDoctorHelperHandoff instead.\n875: // A question that only wants an answer must not be handed a command that\n876: // changes things, however close the meaning. Phrase matches are already held to\n877: // this by the read-only confidence floor, and a meaning match lifts confidence\n878: // past that floor, so it has to ask the same question itself. A command whose\n879: // route only reads stays eligible for a plain explainer, because running it is\n880: // the answer. An explicit no-edit request rules out every command.\n881: export function commandMeaningEligible(\n882:   promptLower: string,\n883:   readOnlyExplainer: boolean,\n884:   skill: SkillProjection | undefined,\n885: ): boolean {\n886:   if (NO_EDIT_REQUEST.test(promptLower)) return false;\n887:   if (!readOnlyExplainer) return true;\n888:   return skill !== undefined && skill.kind === 'command' && 'readOnly' in skill && skill.readOnly === true;\n889: }\n890: \n891: export function requireCommandPhraseAnchor(\n892:   ranked: readonly AdvisorScoredRecommendation[],\n893:   confidenceThreshold: number = DEFAULT_CONFIDENCE_THRESHOLD,\n894:   meaningPassed: Set<string> = new Set(),\n895:   meaningEligible: (skillId: string) => boolean = () => true,\n896: ): AdvisorScoredRecommendation[] {\n897:   const cosineByCommandId = new Map<string, number>();\n898:   for (const recommendation of ranked) {\n899:     if (recommendation.kind !== 'command') continue;\n900:     const cosine = commandMeaningCosine(\n901:       recommendation.laneContributions.find((contribution) => contribution.lane === 'semantic_shadow'),\n902:     );\n903:     if (cosine !== null) cosineByCommandId.set(recommendation.skill, cosine);\n904:   }\n905:   // A command row with no cosine counts as 0, so the bar is the strongest other\n906:   // command row, not the strongest row overall: a skill row never decides this.\n907:   const leadingOtherCosine = (skillId: string): number => {\n908:     let lead = 0;\n909:     for (const [otherSkillId, cosine] of cosineByCommandId) {\n910:       if (otherSkillId !== skillId && cosine > lead) lead = cosine;\n911:     }\n912:     return lead;\n913:   };\n914:   return ranked.map((recommendation) => {\n915:     if (recommendation.kind !== 'command') return recommendation;\n916:     const anchored = recommendation.laneContributions.some((contribution) => (\n917:       contribution.lane === 'explicit_author' && contribution.rawScore > 0\n918:     ));\n919:     if (anchored) return recommendation;\n920:     const cosine = cosineByCommandId.get(recommendation.skill);\n921:     if (cosine !== undefined\n922:       && cosine >= COMMAND_MEANING_MIN_COSINE\n923:       && cosine - leadingOtherCosine(recommendation.skill) >= COMMAND_MEANING_MARGIN\n924:       && meaningEligible(recommendation.skill)) {\n925:       // A meaning match alone rarely clears the threshold on its lane weight, so\n926:       // the anchor lifts the row to it rather than leaving it scored but unpassed.\n927:       meaningPassed.add(recommendation.skill);\n928:       return {\n929:         ...recommendation,\n930:         confidence: Math.max(recommendation.confidence, confidenceThreshold),\n931:         passes_threshold: true,\n932:       };\n933:     }\n934:     return recommendation.passes_threshold\n935:       ? { ...recommendation, passes_threshold: false }\n936:       : recommendation;\n937:   });\n938: }\n939: \n940: function findTypedDoctorCommandText(promptLower: string): string | null {\n941:   const prompt = promptLower.trim();\n942:   if (prompt.startsWith(DOCTOR_COMMAND_PREFIX)) {\n943:     return prompt.slice(DOCTOR_COMMAND_PREFIX.length);\n944:   }\n945: \n946:   const invocationPattern = /\\b(?:run|execute|start|launch|use|kick\\s+off)\\s+\\/doctor:/g;\n947:   let quote: \"'\" | '\"' | '`' | null = null;\n948:   let quoteScanPosition = 0;\n949:   let invocation: RegExpExecArray | null;\n950: \n951:   while ((invocation = invocationPattern.exec(prompt)) !== null) {\n952:     const commandPosition = (\n953:       invocation.index + invocation[0].length - DOCTOR_COMMAND_PREFIX.length\n954:     );\n955:     while (quoteScanPosition < commandPosition) {\n956:       const character = prompt.charAt(quoteScanPosition);\n957:       const isWordApostrophe = character === \"'\"\n958:         && /[a-z0-9]/.test(prompt.charAt(quoteScanPosition - 1))\n959:         && /[a-z0-9]/.test(prompt.charAt(quoteScanPosition + 1));\n960:       if (!isWordApostrophe) {\n961:         if (quote === null) {\n962:           if (character === \"'\" || character === '\"' || character === '`') {\n963:             quote = character;\n964:           }\n965:         } else if (character === quote) {\n966:           quote = null;\n967:         }\n968:       }\n969:       quoteScanPosition += 1;\n970:     }\n971:     if (quote === null) return prompt.slice(commandPosition + DOCTOR_COMMAND_PREFIX.length);\n972:   }\n973:   return null;\n974: }\n975: \n976: export function isDoctorCommandTyped(promptLower: string): boolean {\n977:   return findTypedDoctorCommandText(promptLower) !== null;\n978: }\n979: \n980: // A typed command or matching doctor lead phrase moves its passing bridge first; otherwise passing\n981: // bridges follow the second passing skill or the only passing skill, and other recommendations keep order.\n982: export function keepPassingSkillsAboveDoctorBridges(\n983:   ranked: readonly AdvisorScoredRecommendation[],\n984:   promptLower: string,\n985:   leadPhrasesById: ReadonlyMap<string, readonly string[]> = new Map(),\n986: ): AdvisorScoredRecommendation[] {\n987:   const isDoctorBridge = (recommendation: AdvisorScoredRecommendation): boolean => (\n988:     recommendation.kind === 'command' && recommendation.skill.startsWith(DOCTOR_BRIDGE_PREFIX)\n989:   );\n990:   const isPassingDoctorBridge = (recommendation: AdvisorScoredRecommendation): boolean => (\n991:     isDoctorBridge(recommendation) && recommendation.passes_threshold\n992:   );\n993:   const typedCommandText = findTypedDoctorCommandText(promptLower);\n994:   if (typedCommandText !== null) {\n995:     const normalizedCommand = typedCommandText.toLowerCase().trim().replace(/\\s+/g, '-');\n996:     let matchedBridgeIndex = -1;\n997:     let matchedBridgeLength = -1;\n998:     ranked.forEach((recommendation, index) => {\n999:       if (!isPassingDoctorBridge(recommendation)) return;\n1000:       const bridgeName = recommendation.skill.slice(DOCTOR_BRIDGE_PREFIX.length);\n1001:       if (bridgeName.length === 0 || !normalizedCommand.startsWith(bridgeName)) return;\n1002:       const nextCharacter = normalizedCommand.charAt(bridgeName.length);\n1003:       const endsAtWordBoundary = (\n1004:         nextCharacter === '' || !/[a-z0-9_]/.test(nextCharacter)\n1005:       );\n1006:       if (!endsAtWordBoundary || bridgeName.length <= matchedBridgeLength) return;\n1007:       matchedBridgeIndex = index;\n1008:       matchedBridgeLength = bridgeName.length;\n1009:     });\n1010:     const matchedBridge = ranked[matchedBridgeIndex];\n1011:     if (!matchedBridge) return [...ranked];\n1012:     return [\n1013:       matchedBridge,\n1014:       ...ranked.slice(0, matchedBridgeIndex),\n1015:       ...ranked.slice(matchedBridgeIndex + 1),\n1016:     ];\n1017:   }\n1018: \n1019:   const leadPhraseBridgeIndex = ranked.findIndex((recommendation) => {\n1020:     if (!isPassingDoctorBridge(recommendation)) return false;\n1021:     return leadPhrasesById.get(recommendation.skill)?.some((phrase) => (\n1022:       matchesPhraseBoundary(promptLower, phrase.toLowerCase())\n1023:     )) ?? false;\n1024:   });\n1025:   const leadPhraseBridge = ranked[leadPhraseBridgeIndex];\n1026:   if (leadPhraseBridge) {\n1027:     return [\n1028:       leadPhraseBridge,\n1029:       ...ranked.slice(0, leadPhraseBridgeIndex),\n1030:       ...ranked.slice(leadPhraseBridgeIndex + 1),\n1031:     ];\n1032:   }\n1033: \n1034:   const passingSkillCount = ranked.filter((recommendation) => (\n1035:     recommendation.kind === 'skill' && recommendation.passes_threshold\n1036:   )).length;\n1037:   if (passingSkillCount === 0) return [...ranked];\n1038: \n1039:   const passingDoctorBridges = ranked.filter(isPassingDoctorBridge);\n1040:   if (passingDoctorBridges.length === 0) return [...ranked];\n1041:   const remaining = ranked.filter((recommendation) => !isPassingDoctorBridge(recommendation));\n1042:   const targetPassingSkillCount = Math.min(2, passingSkillCount);\n1043:   let seenPassingSkills = 0;\n1044:   let insertionIndex = remaining.length;\n1045:   for (const [index, recommendation] of remaining.entries()) {\n1046:     if (recommendation.kind !== 'skill' || !recommendation.passes_threshold) continue;\n1047:     seenPassingSkills += 1;\n1048:     if (seenPassingSkills === targetPassingSkillCount) {\n1049:       insertionIndex = index + 1;\n1050:       break;\n1051:     }\n1052:   }\n1053:   return [\n1054:     ...remaining.slice(0, insertionIndex),\n1055:     ...passingDoctorBridges,\n1056:     ...remaining.slice(insertionIndex),\n1057:   ];\n1058: }\n1059: \n[Output truncated. Continue reading with offset: 1060]","title":"read","metadata":{"metadata":{"truncated":true},"content":[{"type":"text","text":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/lib/scorer/fusion.ts, lines 1-1059\n1: // ───────────────────────────────────────────────────────────────\n2: // MODULE: Advisor 5-Lane Fusion\n3: // ───────────────────────────────────────────────────────────────\n4: \n5: // ───────────────────────────────────────────────────────────────────\n6: // 1. IMPORTS\n7: // ───────────────────────────────────────────────────────────────────\n8: \n9: import { fuseResultsMulti } from '@spec-kit/shared/algorithms/rrf-fusion.js';\n10: \n11: import { applyAmbiguity, isAmbiguousTopTwo, wideAmbiguityMembers } from './ambiguity.js';\n12: import { attributionReason, dominantLane, isDerivedDominant } from './attribution.js';\n13: import {\n14:   ADVISOR_HOOK_FRESHNESS_VALUES,\n15:   ADVISOR_RUNTIME_VALUES,\n16:   isSpeckitMetricsEnabled,\n17:   speckitMetrics,\n18: } from '../metrics.js';\n19: import { normalize } from '../affordance-normalizer.js';\n20: import { TRACKED_COMMANDS, typedCommandIn } from '../command-attach.js';\n21: import { scoreDerivedLane } from './lanes/derived.js';\n22: import { scoreExplicitLane } from './lanes/explicit.js';\n23: import { scoreGraphCausalLaneSplit } from './lanes/graph-causal.js';\n24: import { scoreLexicalLane } from './lanes/lexical.js';\n25: import { scoreSemanticShadowExactSubset, scoreSemanticShadowLane } from './lanes/semantic-shadow.js';\n26: import { applyExecutorDelegationOverride } from './executor-delegation.js';\n27: import {\n28:   DOCTOR_HELPER_BRIDGE_ID,\n29:   DOCTOR_HELPER_UNCUED_MIN_SCORE,\n30:   doctorProblemCue,\n31:   matchDoctorProblem,\n32: } from './doctor-helper-handoff.js';\n33: import { loadAdvisorProjection } from './projection.js';\n34: import { SCORING_CALIBRATION } from './scoring-constants.js';\n35: import { isReadOnlyExplainer, matchesPhraseBoundary } from './text.js';\n36: import {\n37:   DEFAULT_SCORER_WEIGHTS,\n38:   SCORER_LANES,\n39:   liveWeightTotal,\n40: } from './weights-config.js';\n41: import { isLiveScorerLane } from './lane-registry.js';\n42: import { isRouteExcludedSkillId } from '../route-exclusions.js';\n43: import { SKILL_ADVISOR_COMPAT_CONTRACT, resolvedConfidenceThreshold, resolvedUncertaintyThreshold } from '../compat/contract.js';\n44: import type {\n45:   AdvisorProjection,\n46:   AdvisorScoredRecommendation,\n47:   AdvisorScoringOptions,\n48:   AdvisorScoringResult,\n49:   LaneContribution,\n50:   LaneMatch,\n51:   LaneRuntimeHealth,\n52:   LaneScores,\n53:   ScorerLane,\n54:   SkillProjection,\n55: } from './types.js';\n56: import type { NormalizedAffordance } from '../affordance-normalizer.js';\n57: import type { RankedList, RrfItem } from '@spec-kit/shared/algorithms/rrf-fusion.js';\n58: \n59: // ───────────────────────────────────────────────────────────────────\n60: // 2. CONSTANTS\n61: // ───────────────────────────────────────────────────────────────────\n62: \n63: const DEFAULT_CONFIDENCE_THRESHOLD = resolvedConfidenceThreshold();\n64: const DEFAULT_UNCERTAINTY_THRESHOLD = resolvedUncertaintyThreshold();\n65: export const ADVISOR_RRF_FUSION_FLAG = 'SPECKIT_ADVISOR_RRF_FUSION';\n66: export const ADVISOR_QUERY_CLASS_ROUTING_FLAG = 'SPECKIT_ADVISOR_QUERY_CLASS_ROUTING';\n67: export const ADVISOR_EXACT_SEMANTIC_RERANK_FLAG = 'SPECKIT_ADVISOR_EXACT_SEMANTIC_RERANK';\n68: export const ADVISOR_RRF_K = 8;\n69: export const ADVISOR_EXACT_SEMANTIC_RERANK_TOP_K = 10;\n70: const ADVISOR_EXACT_SEMANTIC_RERANK_WINDOW = 0.05;\n71: const TASK_INTENT = /\\b(add|append|build|change|configure|create|edit|fix|generate|implement|modify|move|patch|refactor|rename|replace|run|start|sweep|update|write)\\b/;\n72: const DEEP_RESEARCH_CYCLE = /\\b(automated research cycle|looped investigation|continue iteration|resume iteration|overnight run|overnight research run|packet-local iteration|delta record|canonical jsonl|same lineage)\\b/;\n73: // Writing a test or a helper is code work even when the prompt also names a deep-review phrase or a\n74: // study artifact: the thing asked for comes before the phrase it is written about, so a \"deep review\"\n75: // between the verb and the noun means the loop itself is the subject.\n76: const AUTHORS_CODE = /\\b(?:add|build|create|implement|write)\\b(?:(?!deep[- ]review)[^.?!]){0,60}?\\b(?:helper|vitest|tests?)\\b/;\n77: // Writing a changelog is sk-doc's changelog mode even when the prompt names a\n78: // packet or spec folder. That folder is only where the change history comes from.\n79: // The verb must govern the changelog itself: only articles and folder or scope\n80: // modifiers may sit between them, so \"add a nested phase ... for the changelog\n81: // work\" or \"write the spec folder docs, including the changelog ...\" stay\n82: // spec-folder work.\n83: const CHANGELOG_AUTHORING = /\\b(?:add|create|draft|write)\\s+(?:(?:a|an|the|new|nested|packet|packet-local|phase|global|release)\\s+){0,4}changelog(?:\\s+entry)?\\b/;\n84: const CHANGELOG_PACKET_SOURCE = /\\b(?:packet|nested|spec folder)\\b/;\n85: const FILE_SAVE_OPERATION = /\\bsave\\b.{0,48}\\b(file|files|document|documents|buffer|tab|workspace)\\b|\\b(file|files|document|documents|buffer|tab|workspace)\\b.{0,48}\\bsave\\b/;\n86: const MEMORY_SAVE_CONTEXT_ANCHOR = /\\b(memory|context|conversation|session|handover|checkpoint|resume|preserve|remember|capture|store)\\b|\\/memory:save|memory:save/;\n87: // Class C breadth/multi-concern abstention gates. A broad greenfield build or a\n88: // multi-concern optimization is under-specified for single-skill routing.\n89: const BREADTH_BUILD_VERB = /\\b(build|create|implement|generate|scaffold)\\b/;\n90: const BREADTH_NOUN = /\\b(full[- ]?stack|service|platform|application|microservice|saas|backend|whole (app|system))\\b/;\n91: // Narrow anchors that make a broad-build prompt specific enough to route.\n92: const BREADTH_NARROW_ANCHOR = /\\.[a-z]{2,4}\\b|\\b(test|tests|error|bug|failure|failing|handler|component|function|route|endpoint|class|method|benchmark|review|audit|migration|schema)\\b/;\n93: const MULTI_CONCERN_VERB = /\\b(optimize|improve|enhance|harden|speed up)\\b/;\n94: const CONCERN_PERF = /\\b(speed|latency|execution|throughput|performance|startup|memory|cpu)\\b/;\n95: const CONCERN_QUALITY = /\\b(quality|accuracy|recommendation|recommendations|correctness|reliability|coverage)\\b/;\n96: const TRUE_FLAG_VALUES = new Set(['1', 'true', 'yes', 'on', 'enabled']);\n97: const NO_RRF_RANK = Number.MAX_SAFE_INTEGER;\n98: const ADVISOR_SELF_RECOMMENDATION_SKILL_IDS = new Set(['system-skill-advisor', 'skill-advisor']);\n99: const DOCTOR_BRIDGE_PREFIX = 'command-doctor-';\n100: const DOCTOR_COMMAND_PREFIX = '/doctor:';\n101: \n102: // ───────────────────────────────────────────────────────────────────\n103: // 3. TYPE DEFINITIONS\n104: // ───────────────────────────────────────────────────────────────────\n105: \n106: type MutableLaneScores = {\n107:   -readonly [K in keyof LaneScores]: LaneMatch[];\n108: };\n109: \n110: interface LaneScoreBundle {\n111:   readonly laneScores: LaneScores;\n112:   readonly graphConflictMatches: readonly LaneMatch[];\n113:   readonly graphSupportBySeed: ReadonlyMap<string, ReadonlyMap<string, number>>;\n114: }\n115: \n116: interface AdvisorRrfFusion {\n117:   readonly scoreBySkill: ReadonlyMap<string, number>;\n118:   readonly rankBySkill: ReadonlyMap<string, number>;\n119: }\n120: \n121: type AdvisorRuntimeLabel = (typeof ADVISOR_RUNTIME_VALUES)[number];\n122: type AdvisorFreshnessLabel = (typeof ADVISOR_HOOK_FRESHNESS_VALUES)[number];\n123: export type AdvisorQueryClass = 'implementation' | 'review' | 'documentation' | 'memory' | 'tooling' | 'unknown';\n124: \n125: interface ExactSemanticRerankEntry {\n126:   readonly rawScore: number;\n127: }\n128: \n129: type ExactSemanticRerankIndex = ReadonlyMap<string, ExactSemanticRerankEntry>;\n130: \n131: // ───────────────────────────────────────────────────────────────────\n132: // 4. HELPERS\n133: // ───────────────────────────────────────────────────────────────────\n134: \n135: function emptyLaneScores(): MutableLaneScores {\n136:   return Object.fromEntries(SCORER_LANES.map((lane) => [lane, []])) as unknown as MutableLaneScores;\n137: }\n138: \n139: function projectionWithUsableSkillIds(projection: AdvisorProjection): AdvisorProjection {\n140:   const skills = projection.skills.filter((skill) => {\n141:     const skillId: unknown = skill.id;\n142:     return typeof skillId === 'string' && skillId.trim().length > 0;\n143:   });\n144:   return skills.length === projection.skills.length\n145:     ? projection\n146:     : { ...projection, skills };\n147: }\n148: \n149: export function isAdvisorRrfFusionEnabled(): boolean {\n150:   const value = process.env[ADVISOR_RRF_FUSION_FLAG]?.trim().toLowerCase();\n151:   return value ? TRUE_FLAG_VALUES.has(value) : false;\n152: }\n153: \n154: export function isAdvisorQueryClassRoutingEnabled(): boolean {\n155:   const value = process.env[ADVISOR_QUERY_CLASS_ROUTING_FLAG]?.trim().toLowerCase();\n156:   return value ? TRUE_FLAG_VALUES.has(value) : false;\n157: }\n158: \n159: export function isAdvisorExactSemanticRerankEnabled(): boolean {\n160:   const value = process.env[ADVISOR_EXACT_SEMANTIC_RERANK_FLAG]?.trim().toLowerCase();\n161:   return value ? TRUE_FLAG_VALUES.has(value) : false;\n162: }\n163: \n164: export function classifyAdvisorQuery(prompt: string): AdvisorQueryClass {\n165:   const promptLower = prompt.toLowerCase();\n166:   if (/\\b(save context|save memory|handover|resume|checkpoint|spec folder|implementation summary|packet docs?)\\b/.test(promptLower)) {\n167:     return 'memory';\n168:   }\n169:   if (/\\b(review|audit|findings|regression|pull request|pr readiness|release readiness)\\b/.test(promptLower)) {\n170:     return 'review';\n171:   }\n172:   if (/\\b(readme|markdown|documentation|docs|manual testing playbook|feature catalog|taxonomy)\\b/.test(promptLower)) {\n173:     return 'documentation';\n174:   }\n175:   if (/\\b(call_tool_chain|code mode|tool ?chain|chrome devtools|browser console|figma|github|clickup)\\b/.test(promptLower)) {\n176:     return 'tooling';\n177:   }\n178:   if (TASK_INTENT.test(promptLower) || /\\b(typescript|javascript|python|vitest|mcp|handler|schema|fixture)\\b/.test(promptLower)) {\n179:     return 'implementation';\n180:   }\n181:   return 'unknown';\n182: }\n183: \n184: export function queryClassLaneMultipliers(queryClass: AdvisorQueryClass): Readonly<Partial<Record<ScorerLane, number>>> {\n185:   switch (queryClass) {\n186:     case 'implementation':\n187:       return { explicit_author: 1.04, lexical: 1.00, graph_causal: 0.98, derived_generated: 0.98, semantic_shadow: 1.00 };\n188:     case 'review':\n189:       return { explicit_author: 1.03, lexical: 1.02, graph_causal: 0.96, derived_generated: 0.98, semantic_shadow: 1.00 };\n190:     case 'documentation':\n191:       return { explicit_author: 1.03, lexical: 0.98, graph_causal: 0.95, derived_generated: 1.04, semantic_shadow: 1.00 };\n192:     case 'memory':\n193:       return { explicit_author: 1.04, lexical: 0.98, graph_causal: 1.02, derived_generated: 1.00, semantic_shadow: 0.96 };\n194:     case 'tooling':\n195:       return { explicit_author: 1.04, lexical: 1.00, graph_causal: 0.98, derived_generated: 0.96, semantic_shadow: 1.00 };\n196:     case 'unknown':\n197:       return {};\n198:   }\n199: }\n200: \n201: export function applyQueryClassLaneMultipliers(\n202:   weights: Readonly<Record<ScorerLane, number>>,\n203:   queryClass: AdvisorQueryClass,\n204: ): Readonly<Record<ScorerLane, number>> {\n205:   const multipliers = queryClassLaneMultipliers(queryClass);\n206:   if (Object.keys(multipliers).length === 0) return weights;\n207:   const next = { ...weights };\n208:   for (const lane of SCORER_LANES) {\n209:     const multiplier = multipliers[lane];\n210:     if (typeof multiplier === 'number' && Number.isFinite(multiplier)) {\n211:       next[lane] = Number((next[lane] * multiplier).toFixed(6));\n212:     }\n213:   }\n214:   const strongestOther = Math.max(...SCORER_LANES\n215:     .filter((lane) => lane !== 'explicit_author')\n216:     .map((lane) => next[lane]));\n217:   if (next.explicit_author < strongestOther) {\n218:     next.explicit_author = Number(strongestOther.toFixed(6));\n219:   }\n220:   return next;\n221: }\n222: \n223: function effectiveScorerWeights(\n224:   override: AdvisorScoringOptions['laneWeightsOverride'] | undefined,\n225:   queryClass: AdvisorQueryClass = 'unknown',\n226: ): Readonly<Record<ScorerLane, number>> {\n227:   const base = !override ? DEFAULT_SCORER_WEIGHTS : (() => {\n228:     const weights: Record<ScorerLane, number> = { ...DEFAULT_SCORER_WEIGHTS };\n229:     const runtimeOverride = override as Partial<Record<string, number>>;\n230:     for (const lane of SCORER_LANES) {\n231:       const value = runtimeOverride[lane];\n232:       if (typeof value === 'number' && Number.isFinite(value)) {\n233:         weights[lane] = value;\n234:       }\n235:     }\n236:     return weights;\n237:   })();\n238:   if (queryClass === 'unknown') return base;\n239:   return applyQueryClassLaneMultipliers(base, queryClass);\n240: }\n241: \n242: function normalizeRuntimeLabel(value: string | undefined): AdvisorRuntimeLabel | null {\n243:   if (value === undefined) {\n244:     return null;\n245:   }\n246:   return ADVISOR_RUNTIME_VALUES.includes(value as AdvisorRuntimeLabel) ? value as AdvisorRuntimeLabel : null;\n247: }\n248: \n249: function normalizeFreshnessLabel(value: string | undefined): AdvisorFreshnessLabel | null {\n250:   if (value === undefined) {\n251:     return 'unavailable';\n252:   }\n253:   return ADVISOR_HOOK_FRESHNESS_VALUES.includes(value as AdvisorFreshnessLabel) ? value as AdvisorFreshnessLabel : null;\n254: }\n255: \n256: interface LaneMatchIndexEntry {\n257:   rawScore: number;\n258:   evidence: string[];\n259:   producerSkillIds: string[];\n260: }\n261: \n262: type LaneMatchIndex = Map<string, LaneMatchIndexEntry>;\n263: \n264: function buildLaneRuntimeHealth(\n265:   laneScores: LaneScores,\n266:   disabled: ReadonlySet<ScorerLane>,\n267:   runtimeLaneHealth: AdvisorScoringOptions['runtimeLaneHealth'] | undefined,\n268: ): readonly LaneRuntimeHealth[] {\n269:   return SCORER_LANES.map((lane): LaneRuntimeHealth => {\n270:     const matchCount = laneScores[lane].length;\n271:     const signal = runtimeLaneHealth?.[lane];\n272:     if (!disabled.has(lane) && signal?.status === 'runtime_degraded' && matchCount === 0) {\n273:       return {\n274:         lane,\n275:         status: 'runtime_degraded',\n276:         matchCount,\n277:         ...(signal.reason ? { reason: signal.reason } : {}),\n278:       };\n279:     }\n280:     return {\n281:       lane,\n282:       status: matchCount > 0 ? 'healthy' : 'matched_nothing',\n283:       matchCount,\n284:       ...(signal?.reason && signal.status === 'healthy' ? { reason: signal.reason } : {}),\n285:     };\n286:   });\n287: }\n288: \n289: function projectionRuntimeLaneHealth(\n290:   projection: AdvisorProjection,\n291:   runtimeLaneHealth: AdvisorScoringOptions['runtimeLaneHealth'] | undefined,\n292: ): AdvisorScoringOptions['runtimeLaneHealth'] | undefined {\n293:   if (!projection.embeddingStaleness?.stale) {\n294:     return runtimeLaneHealth;\n295:   }\n296:   return {\n297:     ...runtimeLaneHealth,\n298:     semantic_shadow: runtimeLaneHealth?.semantic_shadow ?? {\n299:       status: 'runtime_degraded',\n300:       reason: projection.embeddingStaleness.reason ?? 'projection_embedding_stale',\n301:     },\n302:   };\n303: }\n304: \n305: function degradedLaneReason(degradedLanes: readonly ScorerLane[]): string | null {\n306:   if (degradedLanes.length === 0) return null;\n307:   return `Runtime-degraded scorer lanes omitted from confidence normalization: ${degradedLanes.join(', ')}.`;\n308: }\n309: \n310: function buildLaneMatchIndex(matches: readonly LaneMatch[]): LaneMatchIndex {\n311:   const index: LaneMatchIndex = new Map();\n312:   for (const match of matches) {\n313:     const existing = index.get(match.skillId) ?? { rawScore: 0, evidence: [], producerSkillIds: [] };\n314:     existing.rawScore = Math.max(existing.rawScore, match.score);\n315:     if (existing.evidence.length < 6) {\n316:       existing.evidence.push(...match.evidence.slice(0, 6 - existing.evidence.length));\n317:     }\n318:     for (const producerSkillId of match.producerSkillIds ?? []) {\n319:       if (!existing.producerSkillIds.includes(producerSkillId)) {\n320:         existing.producerSkillIds.push(producerSkillId);\n321:       }\n322:     }\n323:     index.set(match.skillId, existing);\n324:   }\n325:   return index;\n326: }\n327: \n328: function buildConflictMatchIndex(matches: readonly LaneMatch[]): LaneMatchIndex {\n329:   const index: LaneMatchIndex = new Map();\n330:   for (const match of matches) {\n331:     const existing = index.get(match.skillId) ?? { rawScore: 0, evidence: [], producerSkillIds: [] };\n332:     existing.rawScore = Math.min(existing.rawScore, match.score);\n333:     if (existing.evidence.length < 6) {\n334:       existing.evidence.push(...match.evidence.slice(0, 6 - existing.evidence.length));\n335:     }\n336:     index.set(match.skillId, existing);\n337:   }\n338:   return index;\n339: }\n340: \n341: function rankedRrfItems(matches: readonly LaneMatch[]): RrfItem[] {\n342:   return [...matches]\n343:     .filter((match) => match.score > 0)\n344:     .sort((left, right) => right.score - left.score || left.skillId.localeCompare(right.skillId))\n345:     .map((match) => ({ id: match.skillId }));\n346: }\n347: \n348: export function fuseAdvisorLaneRanks(\n349:   laneScores: LaneScores,\n350:   weights: Readonly<Record<ScorerLane, number>>,\n351:   disabled: ReadonlySet<ScorerLane> = new Set(),\n352:   runtimeDegraded: ReadonlySet<ScorerLane> = new Set(),\n353: ): AdvisorRrfFusion {\n354:   const lists: RankedList[] = SCORER_LANES.map((lane) => ({\n355:     source: lane,\n356:     results: rankedRrfItems(laneScores[lane]),\n357:     weight: disabled.has(lane) || runtimeDegraded.has(lane) || !isLiveScorerLane(lane)\n358:       ? 0\n359:       : weights[lane],\n360:   }));\n361:   const fused = fuseResultsMulti(lists, {\n362:     k: ADVISOR_RRF_K,\n363:     convergenceBonus: 0,\n364:     calibratedOverlapBeta: 0,\n365:     bonusOverChannels: 'configured',\n366:   });\n367:   const scoreBySkill = new Map<string, number>();\n368:   const rankBySkill = new Map<string, number>();\n369:   fused.forEach((result, index) => {\n370:     const skillId = String(result.id);\n371:     scoreBySkill.set(skillId, result.rrfScore);\n372:     rankBySkill.set(skillId, index);\n373:   });\n374:   return { scoreBySkill, rankBySkill };\n375: }\n376: \n377: function graphConflictAdjustment(\n378:   conflictIndex: LaneMatchIndex,\n379:   recommendation: AdvisorScoredRecommendation,\n380: ): number {\n381:   return conflictIndex.get(recommendation.skill)?.rawScore ?? 0;\n382: }\n383: \n384: function buildExactSemanticRerankIndex(\n385:   prompt: string,\n386:   projection: AdvisorProjection,\n387:   recommendations: readonly AdvisorScoredRecommendation[],\n388:   fusion: AdvisorRrfFusion | null,\n389: ): ExactSemanticRerankIndex {\n390:   if (!fusion) return new Map();\n391:   const topSkillIds = [...recommendations]\n392:     .filter((recommendation) => fusion.rankBySkill.has(recommendation.skill))\n393:     .sort((left, right) => rrfRankFor(fusion, left) - rrfRankFor(fusion, right))\n394:     .slice(0, ADVISOR_EXACT_SEMANTIC_RERANK_TOP_K)\n395:     .map((recommendation) => recommendation.skill);\n396:   const matches = scoreSemanticShadowExactSubset(prompt, projection, topSkillIds);\n397:   return new Map(matches.map((match) => [match.skillId, {\n398:     rawScore: match.score,\n399:   }]));\n400: }\n401: \n402: function exactSemanticRerankScore(\n403:   rerankIndex: ExactSemanticRerankIndex,\n404:   recommendation: AdvisorScoredRecommendation,\n405: ): number | null {\n406:   return rerankIndex.get(recommendation.skill)?.rawScore ?? null;\n407: }\n408: \n409: function rrfRankFor(\n410:   fusion: AdvisorRrfFusion | null,\n411:   recommendation: AdvisorScoredRecommendation,\n412: ): number {\n413:   return fusion?.rankBySkill.get(recommendation.skill) ?? NO_RRF_RANK;\n414: }\n415: \n416: function promptMentionsSkill(promptLower: string, skill: SkillProjection): boolean {\n417:   const phrases = [skill.id, skill.name, skill.id.replace(/-/g, ' ')];\n418:   // A cli skill wraps one named external tool, so the tool's own name (\"orca\"\n419:   // for cli-orca) names the skill as surely as its id does.\n420:   if (skill.family === 'cli' && skill.id.startsWith('cli-')) {\n421:     phrases.push(skill.id.slice('cli-'.length).replace(/-/g, ' '));\n422:   }\n423:   return phrases.some((phrase) => matchesPhraseBoundary(promptLower, phrase.toLowerCase()));\n424: }\n425: \n426: function isDefaultRoutable(promptLower: string, skill: SkillProjection): boolean {\n427:   if (isRouteExcludedSkillId(skill.id)) return false;\n428:   if (skill.lifecycleStatus === 'archived' || skill.lifecycleStatus === 'future') return false;\n429:   if (skill.lifecycleStatus === 'deprecated') return promptMentionsSkill(promptLower, skill);\n430:   return true;\n431: }\n432: \n433: function isAdvisorSelfRecommendationSkill(skillId: string): boolean {\n434:   return ADVISOR_SELF_RECOMMENDATION_SKILL_IDS.has(skillId);\n435: }\n436: \n437: function confidenceFor(args: {\n438:   liveNormalized: number;\n439:   directScore: number;\n440:   readOnlyExplainer: boolean;\n441:   hasExplicitWorkflowSignal: boolean;\n442:   hasTaskIntent: boolean;\n443:   readOnlyRouteAllowed: boolean;\n444:   derivedDominant: boolean;\n445:   skillId: string;\n446: }): { value: number; floored: boolean } {\n447:   const C = SCORING_CALIBRATION.confidence;\n448:   // The advisor alias must never rank itself first on a read-only explainer;\n449:   // floor its confidence. The canonical id is demoted separately by the audit\n450:   // penalty in primaryIntentBonus, so this branch intentionally matches only\n451:   // the alias id.\n452:   if (args.readOnlyExplainer && args.skillId === 'skill-advisor') {\n453:     return { value: C.readOnlyExplainerFloor, floored: false };\n454:   }\n455:   const base = C.baseConstant\n456:     + Math.min(1, args.liveNormalized * C.liveNormalizedRampGain) * C.liveNormalizedRampCoefficient;\n457:   if (args.readOnlyExplainer && !args.readOnlyRouteAllowed) {\n458:     return { value: C.readOnlyExplainerFloor, floored: false };\n459:   }\n460:   if (args.readOnlyRouteAllowed) {\n461:     return {\n462:       value: Number(Math.max(base, C.readOnlyRouteAllowedFloor).toFixed(4)),\n463:       floored: C.readOnlyRouteAllowedFloor > base,\n464:     };\n465:   }\n466:   if (args.derivedDominant && args.directScore < C.derivedDominantDirectScoreCeiling) {\n467:     return { value: C.derivedDominantConfidence, floored: false };\n468:   }\n469:   if (args.hasTaskIntent\n470:     && (args.directScore >= C.taskIntentDirectScoreFloor\n471:       || args.liveNormalized >= C.taskIntentLiveNormalizedFloor)) {\n472:     // Token-stuffing dispersion guard. Without this, a prompt\n473:     // with task-intent + many weak signals (saturating liveNormalized) but\n474:     // no strong direct anchor would force confidence to taskIntentFloor for\n475:     // many unrelated skills. The guard fires when liveNormalized is near-\n476:     // saturated AND directScore is below the directScoreLiftThreshold —\n477:     // the precise signature of a token-stuffed prompt. Legitimate task-intent\n478:     // prompts have at least one strong direct hit and pass via directScore;\n479:     // they don't hit this branch. When the guard fires we fall through to\n480:     // the standard `base + directBonus` math below.\n481:     const dispersionGuardTripped = args.liveNormalized >= 0.95\n482:       && args.directScore < C.directScoreLiftThreshold;\n483:     if (!dispersionGuardTripped) {\n484:       return {\n485:         value: Number(Math.max(base, C.taskIntentFloor).toFixed(4)),\n486:         floored: C.taskIntentFloor > base,\n487:       };\n488:     }\n489:   }\n490:   if (args.directScore >= C.directScoreLiftThreshold) {\n491:     return {\n492:       value: Number(Math.max(base, C.directScoreFloor).toFixed(4)),\n493:       floored: C.directScoreFloor > base,\n494:     };\n495:   }\n496:   const directBonus = args.directScore >= C.directScoreBonusThreshold ? C.directScoreBonus : 0;\n497:   return { value: Number(Math.max(0, Math.min(C.hardCeiling, base + directBonus)).toFixed(4)), floored: false };\n498: }\n499: \n500: function uncertaintyFor(contributions: readonly LaneContribution[], confidence: number, ambiguousPressure: number): number {\n501:   const U = SCORING_CALIBRATION.uncertainty;\n502:   const evidenceCount = contributions.reduce((total, contribution) => total + contribution.evidence.length, 0);\n503:   const direct = contributions\n504:     .filter((contribution) => contribution.lane === 'explicit_author' || contribution.lane === 'lexical')\n505:     .reduce((max, contribution) => Math.max(max, contribution.rawScore), 0);\n506:   let uncertainty = U.noEvidenceDefault;\n507:   if (evidenceCount >= U.highEvidenceCount) uncertainty = U.lowFloor;\n508:   else if (evidenceCount >= U.mediumEvidenceCount) uncertainty = U.mediumFloor;\n509:   else if (evidenceCount >= U.someEvidenceCount) uncertainty = U.elevatedFloor;\n510:   if (direct >= U.directEvidenceDiscountThreshold) uncertainty -= U.directEvidenceDiscount;\n511:   if (confidence < U.lowConfidencePenaltyThreshold) uncertainty += U.lowConfidencePenalty;\n512:   uncertainty += ambiguousPressure;\n513:   return Number(Math.max(U.hardFloor, Math.min(U.hardCeiling, uncertainty)).toFixed(2));\n514: }\n515: \n516: function buildLaneScores(\n517:   prompt: string,\n518:   projection: AdvisorProjection,\n519:   disabled: Set<ScorerLane>,\n520:   affordances: readonly NormalizedAffordance[],\n521:   useRrfFusion: boolean,\n522: ): LaneScoreBundle {\n523:   const scores = emptyLaneScores();\n524:   if (!disabled.has('explicit_author')) {\n525:     scores.explicit_author = scoreExplicitLane(prompt, projection);\n526:   }\n527:   if (!disabled.has('lexical')) scores.lexical = scoreLexicalLane(prompt, projection);\n528:   if (!disabled.has('derived_generated')) scores.derived_generated = scoreDerivedLane(prompt, projection, new Date(), affordances);\n529:   if (!disabled.has('semantic_shadow')) scores.semantic_shadow = scoreSemanticShadowLane(prompt, projection);\n530:   let graphConflictMatches: readonly LaneMatch[] = [];\n531:   let graphSupportBySeed: ReadonlyMap<string, ReadonlyMap<string, number>> = new Map();\n532:   if (!disabled.has('graph_causal')) {\n533:     const graphSplit = scoreGraphCausalLaneSplit([\n534:       ...scores.explicit_author,\n535:       ...scores.lexical,\n536:       ...scores.derived_generated,\n537:     ], projection, {}, affordances);\n538:     scores.graph_causal = useRrfFusion ? graphSplit.positiveMatches : graphSplit.combinedMatches;\n539:     graphConflictMatches = graphSplit.conflictMatches;\n540:     graphSupportBySeed = graphSplit.positiveSupportBySeed;\n541:   }\n542:   return { laneScores: scores, graphConflictMatches, graphSupportBySeed };\n543: }\n544: \n545: // Smallest gap the rounded weighted score can still express, so a bounded\n546: // target sorts strictly below its seed instead of tying with it.\n547: const SEED_BOUND_GAP = 0.000001;\n548: \n549: // Below this explicit-lane score a match is a side mention, not a request.\n550: const EXPLICIT_WORKFLOW_SIGNAL_FLOOR = 0.55;\n551: \n552: // Explicit-lane evidence that a typed slash command named this skill.\n553: const SLASH_COMMAND_EVIDENCE = /^(phrase|author|explicit):\\//;\n554: \n555: export function hasSlashCommandAnchor(rawScore: number, evidence: readonly string[]): boolean {\n556:   return rawScore >= EXPLICIT_WORKFLOW_SIGNAL_FLOOR\n557:     && evidence.some((entry) => SLASH_COMMAND_EVIDENCE.test(entry));\n558: }\n559: \n560: // Graph support is lent: a seed's own evidence propagates to its neighbours so\n561: // related skills surface beside it. When the seed was invoked by a typed slash\n562: // command, the user has named it outright, so support it lends may lift a\n563: // target up to it but never past it; otherwise the command's own match is what\n564: // buries the command (a typed \"/deep:research\" handing its dependency enough\n565: // support to win). Seeds matched only on loose tokens keep ordinary graph\n566: // lending, since there the neighbour may well be the better route. Two skills\n567: // often lend to each other, so the pair is compared on what each holds once\n568: // the other's loan is taken back: a target whose own evidence still beats the\n569: // seed's own evidence keeps its score.\n570: export function boundGraphSupportBySeed(\n571:   scores: ReadonlyMap<string, number>,\n572:   graphRawBySkill: ReadonlyMap<string, number>,\n573:   graphSupportBySeed: ReadonlyMap<string, ReadonlyMap<string, number>>,\n574:   graphWeight: number,\n575:   slashAnchoredSeeds: ReadonlySet<string>,\n576: ): Map<string, number> {\n577:   return boundGraphSupportBySeedWithHolders(\n578:     scores,\n579:     graphRawBySkill,\n580:     graphSupportBySeed,\n581:     graphWeight,\n582:     slashAnchoredSeeds,\n583:   ).scores;\n584: }\n585: \n586: export interface SeedBoundResult {\n587:   readonly scores: Map<string, number>;\n588:   // Target skill -> the typed-command seed whose ceiling actually lowered it.\n589:   readonly heldBelow: Map<string, string>;\n590: }\n591: \n592: export function boundGraphSupportBySeedWithHolders(\n593:   scores: ReadonlyMap<string, number>,\n594:   graphRawBySkill: ReadonlyMap<string, number>,\n595:   graphSupportBySeed: ReadonlyMap<string, ReadonlyMap<string, number>>,\n596:   graphWeight: number,\n597:   slashAnchoredSeeds: ReadonlySet<string>,\n598: ): SeedBoundResult {\n599:   const bounded = new Map(scores);\n600:   const heldBelow = new Map<string, string>();\n601:   if (graphWeight <= 0) return { scores: bounded, heldBelow };\n602:   const lentBy = (lenderId: string, receiverId: string): number => {\n603:     const support = graphSupportBySeed.get(receiverId)?.get(lenderId) ?? 0;\n604:     const graphRaw = Math.max(0, graphRawBySkill.get(receiverId) ?? 0);\n605:     return Math.min(support, graphRaw) * graphWeight;\n606:   };\n607:   // Which seed holds which target down is decided once, on the unbounded\n608:   // scores, so the evidence comparison never sees a cap.\n609:   const holdersByTarget = new Map<string, string[]>();\n610:   for (const [targetId, supportBySeed] of graphSupportBySeed) {\n611:     const targetScore = scores.get(targetId);\n612:     if (targetScore === undefined) continue;\n613:     const holders: string[] = [];\n614:     for (const seedId of supportBySeed.keys()) {\n615:       if (seedId === targetId || !slashAnchoredSeeds.has(seedId)) continue;\n616:       const seedScore = scores.get(seedId);\n617:       if (seedScore === undefined) continue;\n618:       const targetOwn = targetScore - lentBy(seedId, targetId);\n619:       const seedOwn = seedScore - lentBy(targetId, seedId);\n620:       if (targetOwn < seedOwn) holders.push(seedId);\n621:     }\n622:     if (holders.length > 0) holdersByTarget.set(targetId, holders);\n623:   }\n624:   // A held seed can itself be held by another typed command, so each ceiling\n625:   // follows the seed's bounded score and the caps repeat until nothing moves.\n626:   // Caps only ever lower a score, and each pass settles at least one more link\n627:   // of a chain, so one pass per held target is enough.\n628:   for (let pass = 0; pass <= holdersByTarget.size; pass += 1) {\n629:     let moved = false;\n630:     for (const [targetId, holders] of holdersByTarget) {\n631:       const current = bounded.get(targetId) ?? 0;\n632:       let ceiling = current;\n633:       for (const seedId of holders) ceiling = Math.min(ceiling, (bounded.get(seedId) ?? 0) - SEED_BOUND_GAP);\n634:       if (ceiling < current) {\n635:         bounded.set(targetId, Math.max(0, ceiling));\n636:         moved = true;\n637:       }\n638:     }\n639:     if (!moved) break;\n640:   }\n641:   // Only a target the cap really lowered is marked, and only against the seed\n642:   // whose ceiling set its final score: a seed that merely could have held it\n643:   // ranked nothing, so the pair keeps its ordinary ambiguity check.\n644:   for (const [targetId, holders] of holdersByTarget) {\n645:     const final = bounded.get(targetId) ?? 0;\n646:     if (final >= (scores.get(targetId) ?? 0)) continue;\n647:     let binding: string | null = null;\n648:     let lowestSeed = Number.POSITIVE_INFINITY;\n649:     for (const seedId of holders) {\n650:       const seedScore = bounded.get(seedId) ?? 0;\n651:       if (seedScore < lowestSeed) {\n652:         lowestSeed = seedScore;\n653:         binding = seedId;\n654:       }\n655:     }\n656:     if (binding) heldBelow.set(targetId, binding);\n657:   }\n658:   return { scores: bounded, heldBelow };\n659: }\n660: \n661: function hasExplicitWorkflowSignal(contributions: readonly LaneContribution[], skillId: string): boolean {\n662:   const explicit = contributions.find((contribution) => contribution.lane === 'explicit_author');\n663:   if (!explicit || explicit.rawScore < EXPLICIT_WORKFLOW_SIGNAL_FLOOR) return false;\n664:   return explicit.evidence.some((entry) => (\n665:     entry.startsWith('phrase:')\n666:     || entry.startsWith('explicit:')\n667:     || entry.startsWith('author:')\n668:     || entry.includes(skillId)\n669:     || entry.includes('loop')\n670:     || entry.includes('write-')\n671:   ));\n672: }\n673: \n674: // Wording that asks for an answer and rules out a change. One pattern serves\n675: // every gate that has to honour it, so a new gate cannot drift from the first.\n676: const NO_EDIT_REQUEST = /\\b(no edits?|without making changes|do not (change|edit|modify|touch)|read-only only|no edits yet|only; do not|just show|just list)\\b/;\n677: \n678: export function readOnlyRouteAllowed(promptLower: string, skill: SkillProjection): boolean {\n679:   const skillId = skill.id;\n680:   if (NO_EDIT_REQUEST.test(promptLower)) {\n681:     return false;\n682:   }\n683:   // The explainer floor exists to stop an ambiguous read-only question from\n684:   // routing anywhere. Naming the skill removes the ambiguity: the caller has\n685:   // already chosen, and a read-only verb does not undo that choice. Without\n686:   // this, an explicit request is answered with an abstention while the same\n687:   // sentence phrased with a write verb routes fine.\n688:   if (promptMentionsSkill(promptLower, skill)) {\n689:     return true;\n690:   }\n691:   // A command whose route only reads (a report, a status check) is the answer\n692:   // to a list or show question, so its own trigger phrase lifts it off the\n693:   // floor. A mutating command never carries the flag and stays gated.\n694:   if (skill.kind === 'command' && 'readOnly' in skill && skill.readOnly === true\n695:     && skill.keywords.some((phrase) => matchesPhraseBoundary(promptLower, phrase.toLowerCase()))) {\n696:     return true;\n697:   }\n698:   if (skillId === 'sk-code' && /\\b(compare|audit|review)\\b/.test(promptLower)\n699:     && /\\b(classifier|vocabulary|prose|implementation|agents\\.md|drift|mismatch)\\b/.test(promptLower)) {\n700:     return true;\n701:   }\n702:   if (skillId === 'system-spec-kit' && /\\b(memory_save|resume_write|routing taxonomy|corpus|source-type|routing bucket)\\b/.test(promptLower)) {\n703:     return true;\n704:   }\n705:   if (skillId === 'system-spec-kit' && /\\b(packet|spec folder|save memory|phase|continuation prompts|resume handling)\\b/.test(promptLower)) {\n706:     return true;\n707:   }\n708:   // Captured operator answers wait in a queue that spec-kit's save step owns, so a show or list\n709:   // question about that queue, its chat candidates or the decision record is answered there.\n710:   // Only a read-only question is lifted: a lift applies to any prompt, and a request to research,\n711:   // dispatch or build something about decisions belongs to another skill.\n712:   if (skillId === 'system-spec-kit' && isReadOnlyExplainer(promptLower)\n713:     && /\\b(decision capture|decision record|chat candidates?|operator decisions?|recorded as decisions?)\\b/.test(promptLower)) {\n714:     return true;\n715:   }\n716:   // The trigger index is spec-kit's own lookup surface, so a question about what a lookup\n717:   // returned, counted or left out is answered there. Without the lift no skill passes on such a\n718:   // question, and the doctor hand-off claims it on the index noun alone. Drift is the doctor's\n719:   // own diagnosis, so a drift question stays with the hand-off.\n720:   if (skillId === 'system-spec-kit' && isReadOnlyExplainer(promptLower)\n721:     && /\\btrigger[- ]index\\b/.test(promptLower) && !/\\bdrift\\b/.test(promptLower)) {\n722:     return true;\n723:   }\n724:   if (skillId === 'system-deep-loop' && /\\b(ai council|planning council|council deliberation|council artifacts|multi-seat planning)\\b/.test(promptLower)) {\n725:     return true;\n726:   }\n727:   // Browser/devtools inspection is a genuine chrome-devtools task even though\n728:   // its verb (\"inspect\") reads as a read-only explainer. Lift it off the\n729:   // explainer floor when the prompt carries devtools-specific vocabulary.\n730:   if (skillId === 'mcp-tooling'\n731:     && /\\b(network waterfall|network tab|network request|dev ?tools|browser console|page inspector|dom inspector|performance trace|inspect (the )?(network|dom|page|element|browser))\\b/.test(promptLower)) {\n732:     return true;\n733:   }\n734:   if (skillId === 'sk-code' && /\\bgate-3-classifier\\.ts\\b/.test(promptLower)) {\n735:     return true;\n736:   }\n737:   return false;\n738: }\n739: \n740: function isPlainFileSavePrompt(promptLower: string): boolean {\n741:   return FILE_SAVE_OPERATION.test(promptLower) && !MEMORY_SAVE_CONTEXT_ANCHOR.test(promptLower.replace(/\\bfile(s)?\\b/g, ''));\n742: }\n743: \n744: function primaryIntentBonus(\n745:   promptLower: string,\n746:   recommendation: AdvisorScoredRecommendation,\n747: ): number {\n748:   const R = SCORING_CALIBRATION.routing;\n749:   if (/\\bsemantic (code )?search\\b/.test(promptLower)) {\n750:   }\n751:   if (/\\bdeep[- ]review\\b/.test(promptLower)) {\n752:     if (recommendation.skill === 'sk-code') {\n753:       return AUTHORS_CODE.test(promptLower) ? R.deepReviewCodeAuthoringSkCodeBonus : R.deepReviewSkCodeReviewPenalty;\n754:     }\n755:   }\n756:   if (/\\bdeep[- ]research\\b/.test(promptLower)) {\n757:     if (recommendation.skill === 'system-spec-kit' || recommendation.skill === 'sk-code') return R.deepResearchOtherSkillsPenalty;\n758:   }\n759:   if (DEEP_RESEARCH_CYCLE.test(promptLower)) {\n760:     if (recommendation.skill === 'system-spec-kit' || recommendation.skill === 'sk-code') return R.deepResearchCycleOtherSkillsPenalty;\n761:   }\n762:   if (/\\b(compare|audit|review)\\b/.test(promptLower) && /\\b(classifier|vocabulary|prose|implementation|agents\\.md|drift|mismatch)\\b/.test(promptLower)) {\n763:     if (recommendation.skill === 'sk-code') return R.compareAuditCodeReviewBonus;\n764:   }\n765:   // A changelog request that names its packet or spec folder still asks for a\n766:   // changelog, so sk-doc must outrank the spec workflow that \"spec folder\" lifts.\n767:   // Only those two skills are adjusted here. Every other skill falls through so\n768:   // later rules such as save-context or /speckit:plan still apply to it.\n769:   const changelogFromPacket = CHANGELOG_AUTHORING.test(promptLower)\n770:     && CHANGELOG_PACKET_SOURCE.test(promptLower)\n771:     && !AUTHORS_CODE.test(promptLower);\n772:   if (changelogFromPacket) {\n773:     if (recommendation.skill === 'sk-doc') return R.changelogFromPacketSkDocBonus;\n774:     if (recommendation.skill === 'system-spec-kit') return R.changelogFromPacketSpecKitPenalty;\n775:   }\n776:   // The corpus-study rule reads \"packet-local\" as study vocabulary, so it must\n777:   // stay off a changelog request or it would pull the prompt to system-spec-kit.\n778:   // \"packet-local changelog\" names sk-doc's changelog mode with or without an\n779:   // authoring verb, so packet-local is study vocabulary only when it qualifies\n780:   // something other than a changelog.\n781:   if (!changelogFromPacket && /\\b(corpus ids?|first-100 predictions|continuation prompts|routing study config|confusion matrix|source-mix note|prompt template|packet-local(?!\\s+changelog))\\b/.test(promptLower) && !AUTHORS_CODE.test(promptLower)) {\n782:     if (recommendation.skill === 'system-spec-kit') return R.corpusStudySpecKitBonus;\n783:     if (recommendation.skill === 'sk-prompt' || recommendation.skill === 'mcp-tooling' || recommendation.skill === 'sk-doc') return R.corpusStudyOtherSkillsPenalty;\n784:   }\n785:   if (promptLower.includes('/speckit:resume')) {\n786:     if (recommendation.skill === 'system-spec-kit') return R.speckitResumeSpecKitBonus;\n787:     if (recommendation.skill === 'command-speckit-resume') return R.speckitResumeCommandPenalty;\n788:   }\n789:   if (promptLower.includes('/speckit:plan')) {\n790:     if (recommendation.skill === 'command-speckit-plan') return R.speckitPlanCommandBonus;\n791:     if (recommendation.skill === 'sk-doc') return R.speckitPlanSkDocPenalty;\n792:   }\n793:   // External-tool-chain (\"call_tool_chain\") vocabulary belongs to mcp-code-mode,\n794:   // not the generic code skill. Disambiguate so the best guess for these\n795:   // toolchain-shaped prompts is mcp-code-mode.\n796:   // Toolchain + external-data-source vocabulary (webflow CMS, cms collection)\n797:   // is mcp-code-mode territory, not the generic code skill.\n798:   if (/\\b(call_tool_chain|code mode|tool ?chain|api chain|webflow cms|cms collection)\\b/.test(promptLower)) {\n799:     if (recommendation.skill === 'mcp-code-mode') return R.mcpToolchainCodeModeBonus;\n800:     if (recommendation.skill === 'sk-code') return R.mcpToolchainSkCodePenalty;\n801:   }\n802:   // A \"code audit\" is a single-pass code-review task, not a deep-review loop, so\n803:   // sk-code should win the near-tie this phrase produces. The sk-code bonus\n804:   // carries that; the deep-loop skills intentionally hold no \"code audit\"\n805:   // vocabulary, so they need no counter-penalty here.\n806:   if (/\\bcode audit\\b/.test(promptLower)) {\n807:     if (recommendation.skill === 'sk-code') return R.codeAuditCodeReviewBonus;\n808:   }\n809:   // Colon-command review-loop syntax (\":review:auto\") invokes the deep-review\n810:   // loop; rank it above single-pass code review.\n811:   if (/:review:(auto|confirm)\\b/.test(promptLower)) {\n812:     if (recommendation.skill === 'system-deep-loop') return R.reviewLoopDeepReviewBonus;\n813:     if (recommendation.skill === 'sk-code') return R.deepReviewSkCodeReviewPenalty;\n814:   }\n815:   // Auditing recommendation quality is a review task, not an advisor-self task.\n816:   if (/\\baudit\\b/.test(promptLower) && /\\b(recommendation|recommendations|recommendation quality|routing quality)\\b/.test(promptLower)) {\n817:     if (recommendation.skill === 'sk-code') return R.auditRecsCodeReviewBonus;\n818:     // Auditing routing output is a review task, not an advisor invocation: demote\n819:     // the advisor and its alias (the canonical self-rec id set) so neither ranks\n820:     // itself first here.\n821:     if (isAdvisorSelfRecommendationSkill(recommendation.skill)) return R.auditRecsAdvisorPenalty;\n822:   }\n823:   if (/\\b(save context|save memory)\\b/.test(promptLower)) {\n824:     if (recommendation.skill === 'command-speckit-save') return R.saveContextMemorySaveBonus;\n825:     if (recommendation.skill === 'system-spec-kit') return R.saveContextMemorySpecKitPenalty;\n826:   }\n827:   if (/\\b(create (a )?new agent|create agent)\\b/.test(promptLower) || promptLower.includes('/create:agent')) {\n828:     if (recommendation.skill === 'create:agent') return R.createAgentCreateAgentBonus;\n829:     if (recommendation.skill === 'sk-doc') return R.createAgentSkDocPenalty;\n830:   }\n831:   if (/\\bcreate (a )?(test|testing) playbook\\b/.test(promptLower) || promptLower.includes('/create:manual-testing-playbook')) {\n832:     if (recommendation.skill === 'create:manual-testing-playbook' || recommendation.skill === 'command-create-manual-testing-playbook') return R.createTestingPlaybookBonus;\n833:     if (recommendation.skill === 'sk-doc') return R.createTestingPlaybookSkDocPenalty;\n834:     if (recommendation.skill === 'system-deep-loop') return R.createTestingPlaybookOtherSkillsPenalty;\n835:   }\n836:   if (/\\bphase folder\\b/.test(promptLower)) {\n837:     if (recommendation.skill === 'system-spec-kit') return R.phaseFolderSpecKitBonus;\n838:   }\n839:   return 0;\n840: }\n841: \n842: // ───────────────────────────────────────────────────────────────────\n843: // 5. CORE LOGIC\n844: // ───────────────────────────────────────────────────────────────────\n845: \n846: // The bar sits above the highest cosine any prompt that must stay silent reached\n847: // against a command row, with headroom, because a command offered for the wrong\n848: // prompt costs more than one that stays quiet. The margin asks for a small lead\n849: // over the next command and over the top skill, which is what kept a wrong\n850: // command out of first place on the tuning rows. Raise the bar before the\n851: // margin if a false offer appears.\n852: export const COMMAND_MEANING_MIN_COSINE = 0.72;\n853: export const COMMAND_MEANING_MARGIN = 0.02;\n854: \n855: // The lane reports a real embedder cosine as \"cosine:\", while the word-overlap\n856: // stand-in used under test reports \"shadow:\". Only a real cosine may carry a\n857: // command on meaning, because the stand-in measures shared words rather than\n858: // shared meaning.\n859: function commandMeaningCosine(contribution: LaneContribution | undefined): number | null {\n860:   if (!contribution) return null;\n861:   return contribution.evidence.some((entry) => entry.startsWith('cosine:'))\n862:     ? contribution.rawScore\n863:     : null;\n864: }\n865: \n866: // A command bridge passes on its own wording: one of its authored phrases or its\n867: // runnable slash string, which the explicit-author lane reports. A bridge that\n868: // passed on shared single tokens alone stays scored but stops passing, because\n869: // its phrases are everyday words and a command must not be offered for a prompt\n870: // that merely shares some of them. A paraphrase shares no words at all, so the\n871: // second way in is meaning: a real prompt embedding that clears both bars above.\n872: // Meaning-passed ids are collected so a later ordering step can tell them apart,\n873: // and a doctor problem in other words reaches /doctor:helper through\n874: // applyDoctorHelperHandoff instead.\n875: // A question that only wants an answer must not be handed a command that\n876: // changes things, however close the meaning. Phrase matches are already held to\n877: // this by the read-only confidence floor, and a meaning match lifts confidence\n878: // past that floor, so it has to ask the same question itself. A command whose\n879: // route only reads stays eligible for a plain explainer, because running it is\n880: // the answer. An explicit no-edit request rules out every command.\n881: export function commandMeaningEligible(\n882:   promptLower: string,\n883:   readOnlyExplainer: boolean,\n884:   skill: SkillProjection | undefined,\n885: ): boolean {\n886:   if (NO_EDIT_REQUEST.test(promptLower)) return false;\n887:   if (!readOnlyExplainer) return true;\n888:   return skill !== undefined && skill.kind === 'command' && 'readOnly' in skill && skill.readOnly === true;\n889: }\n890: \n891: export function requireCommandPhraseAnchor(\n892:   ranked: readonly AdvisorScoredRecommendation[],\n893:   confidenceThreshold: number = DEFAULT_CONFIDENCE_THRESHOLD,\n894:   meaningPassed: Set<string> = new Set(),\n895:   meaningEligible: (skillId: string) => boolean = () => true,\n896: ): AdvisorScoredRecommendation[] {\n897:   const cosineByCommandId = new Map<string, number>();\n898:   for (const recommendation of ranked) {\n899:     if (recommendation.kind !== 'command') continue;\n900:     const cosine = commandMeaningCosine(\n901:       recommendation.laneContributions.find((contribution) => contribution.lane === 'semantic_shadow'),\n902:     );\n903:     if (cosine !== null) cosineByCommandId.set(recommendation.skill, cosine);\n904:   }\n905:   // A command row with no cosine counts as 0, so the bar is the strongest other\n906:   // command row, not the strongest row overall: a skill row never decides this.\n907:   const leadingOtherCosine = (skillId: string): number => {\n908:     let lead = 0;\n909:     for (const [otherSkillId, cosine] of cosineByCommandId) {\n910:       if (otherSkillId !== skillId && cosine > lead) lead = cosine;\n911:     }\n912:     return lead;\n913:   };\n914:   return ranked.map((recommendation) => {\n915:     if (recommendation.kind !== 'command') return recommendation;\n916:     const anchored = recommendation.laneContributions.some((contribution) => (\n917:       contribution.lane === 'explicit_author' && contribution.rawScore > 0\n918:     ));\n919:     if (anchored) return recommendation;\n920:     const cosine = cosineByCommandId.get(recommendation.skill);\n921:     if (cosine !== undefined\n922:       && cosine >= COMMAND_MEANING_MIN_COSINE\n923:       && cosine - leadingOtherCosine(recommendation.skill) >= COMMAND_MEANING_MARGIN\n924:       && meaningEligible(recommendation.skill)) {\n925:       // A meaning match alone rarely clears the threshold on its lane weight, so\n926:       // the anchor lifts the row to it rather than leaving it scored but unpassed.\n927:       meaningPassed.add(recommendation.skill);\n928:       return {\n929:         ...recommendation,\n930:         confidence: Math.max(recommendation.confidence, confidenceThreshold),\n931:         passes_threshold: true,\n932:       };\n933:     }\n934:     return recommendation.passes_threshold\n935:       ? { ...recommendation, passes_threshold: false }\n936:       : recommendation;\n937:   });\n938: }\n939: \n940: function findTypedDoctorCommandText(promptLower: string): string | null {\n941:   const prompt = promptLower.trim();\n942:   if (prompt.startsWith(DOCTOR_COMMAND_PREFIX)) {\n943:     return prompt.slice(DOCTOR_COMMAND_PREFIX.length);\n944:   }\n945: \n946:   const invocationPattern = /\\b(?:run|execute|start|launch|use|kick\\s+off)\\s+\\/doctor:/g;\n947:   let quote: \"'\" | '\"' | '`' | null = null;\n948:   let quoteScanPosition = 0;\n949:   let invocation: RegExpExecArray | null;\n950: \n951:   while ((invocation = invocationPattern.exec(prompt)) !== null) {\n952:     const commandPosition = (\n953:       invocation.index + invocation[0].length - DOCTOR_COMMAND_PREFIX.length\n954:     );\n955:     while (quoteScanPosition < commandPosition) {\n956:       const character = prompt.charAt(quoteScanPosition);\n957:       const isWordApostrophe = character === \"'\"\n958:         && /[a-z0-9]/.test(prompt.charAt(quoteScanPosition - 1))\n959:         && /[a-z0-9]/.test(prompt.charAt(quoteScanPosition + 1));\n960:       if (!isWordApostrophe) {\n961:         if (quote === null) {\n962:           if (character === \"'\" || character === '\"' || character === '`') {\n963:             quote = character;\n964:           }\n965:         } else if (character === quote) {\n966:           quote = null;\n967:         }\n968:       }\n969:       quoteScanPosition += 1;\n970:     }\n971:     if (quote === null) return prompt.slice(commandPosition + DOCTOR_COMMAND_PREFIX.length);\n972:   }\n973:   return null;\n974: }\n975: \n976: export function isDoctorCommandTyped(promptLower: string): boolean {\n977:   return findTypedDoctorCommandText(promptLower) !== null;\n978: }\n979: \n980: // A typed command or matching doctor lead phrase moves its passing bridge first; otherwise passing\n981: // bridges follow the second passing skill or the only passing skill, and other recommendations keep order.\n982: export function keepPassingSkillsAboveDoctorBridges(\n983:   ranked: readonly AdvisorScoredRecommendation[],\n984:   promptLower: string,\n985:   leadPhrasesById: ReadonlyMap<string, readonly string[]> = new Map(),\n986: ): AdvisorScoredRecommendation[] {\n987:   const isDoctorBridge = (recommendation: AdvisorScoredRecommendation): boolean => (\n988:     recommendation.kind === 'command' && recommendation.skill.startsWith(DOCTOR_BRIDGE_PREFIX)\n989:   );\n990:   const isPassingDoctorBridge = (recommendation: AdvisorScoredRecommendation): boolean => (\n991:     isDoctorBridge(recommendation) && recommendation.passes_threshold\n992:   );\n993:   const typedCommandText = findTypedDoctorCommandText(promptLower);\n994:   if (typedCommandText !== null) {\n995:     const normalizedCommand = typedCommandText.toLowerCase().trim().replace(/\\s+/g, '-');\n996:     let matchedBridgeIndex = -1;\n997:     let matchedBridgeLength = -1;\n998:     ranked.forEach((recommendation, index) => {\n999:       if (!isPassingDoctorBridge(recommendation)) return;\n1000:       const bridgeName = recommendation.skill.slice(DOCTOR_BRIDGE_PREFIX.length);\n1001:       if (bridgeName.length === 0 || !normalizedCommand.startsWith(bridgeName)) return;\n1002:       const nextCharacter = normalizedCommand.charAt(bridgeName.length);\n1003:       const endsAtWordBoundary = (\n1004:         nextCharacter === '' || !/[a-z0-9_]/.test(nextCharacter)\n1005:       );\n1006:       if (!endsAtWordBoundary || bridgeName.length <= matchedBridgeLength) return;\n1007:       matchedBridgeIndex = index;\n1008:       matchedBridgeLength = bridgeName.length;\n1009:     });\n1010:     const matchedBridge = ranked[matchedBridgeIndex];\n1011:     if (!matchedBridge) return [...ranked];\n1012:     return [\n1013:       matchedBridge,\n1014:       ...ranked.slice(0, matchedBridgeIndex),\n1015:       ...ranked.slice(matchedBridgeIndex + 1),\n1016:     ];\n1017:   }\n1018: \n1019:   const leadPhraseBridgeIndex = ranked.findIndex((recommendation) => {\n1020:     if (!isPassingDoctorBridge(recommendation)) return false;\n1021:     return leadPhrasesById.get(recommendation.skill)?.some((phrase) => (\n1022:       matchesPhraseBoundary(promptLower, phrase.toLowerCase())\n1023:     )) ?? false;\n1024:   });\n1025:   const leadPhraseBridge = ranked[leadPhraseBridgeIndex];\n1026:   if (leadPhraseBridge) {\n1027:     return [\n1028:       leadPhraseBridge,\n1029:       ...ranked.slice(0, leadPhraseBridgeIndex),\n1030:       ...ranked.slice(leadPhraseBridgeIndex + 1),\n1031:     ];\n1032:   }\n1033: \n1034:   const passingSkillCount = ranked.filter((recommendation) => (\n1035:     recommendation.kind === 'skill' && recommendation.passes_threshold\n1036:   )).length;\n1037:   if (passingSkillCount === 0) return [...ranked];\n1038: \n1039:   const passingDoctorBridges = ranked.filter(isPassingDoctorBridge);\n1040:   if (passingDoctorBridges.length === 0) return [...ranked];\n1041:   const remaining = ranked.filter((recommendation) => !isPassingDoctorBridge(recommendation));\n1042:   const targetPassingSkillCount = Math.min(2, passingSkillCount);\n1043:   let seenPassingSkills = 0;\n1044:   let insertionIndex = remaining.length;\n1045:   for (const [index, recommendation] of remaining.entries()) {\n1046:     if (recommendation.kind !== 'skill' || !recommendation.passes_threshold) continue;\n1047:     seenPassingSkills += 1;\n1048:     if (seenPassingSkills === targetPassingSkillCount) {\n1049:       insertionIndex = index + 1;\n1050:       break;\n1051:     }\n1052:   }\n1053:   return [\n1054:     ...remaining.slice(0, insertionIndex),\n1055:     ...passingDoctorBridges,\n1056:     ...remaining.slice(insertionIndex),\n1057:   ];\n1058: }\n1059: \n[Output truncated. Continue reading with offset: 1060]"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/lib/scorer/fusion.ts\"}"},"time":{"start":1794543408942,"end":1794543409513}}}}
