e', 1.6], ['system-spec-kit', 0.45]],\n97:   '/deep:research': [['system-deep-loop', 1.6]],\n98:   '/deep:review': [['system-deep-loop', 1.6]],\n99:   '/speckit:resume': [['system-spec-kit', 0.9], ['command-speckit-resume', 0.75]],\n100:   'auto review release readiness': [['system-deep-loop', 1]],\n101:   // Colon-command syntax (\":review:auto\") is a deep-review LOOP invocation,\n102:   // distinct from natural-language \"auto review this PR\" (which routes to\n103:   // sk-code's code-review mode). Strong direct-evidence anchor + a bounded\n104:   // penalty on the single-pass skill so the loop skill wins the rank.\n105:   ':review:auto': [['system-deep-loop', 1.6], ['sk-code', -0.6]],\n106:   ':review:confirm': [['system-deep-loop', 1.6], ['sk-code', -0.6]],\n107:   // Domain phrase anchors (multi-token, so they lift confidence via the direct\n108:   // lane without firing on single tokens like \"cms\").\n109:   'webflow cms': [['mcp-code-mode', 1.5], ['sk-code', -0.5]],\n110:   'cms collection': [['mcp-code-mode', 1.4]],\n111:   'chrome devtools': [['mcp-tooling', 1]],\n112:   'gitlens launchpad': [['sk-git', 0.85]],\n113:   'staging url': [['mcp-tooling', 0.65]],\n114:   'staging site': [['mcp-tooling', 0.65]],\n115:   'staging website': [['mcp-tooling', 0.65]],\n116:   'live site': [['mcp-tooling', 0.65]],\n117:   'live website': [['mcp-tooling', 0.65]],\n118:   'live url': [['mcp-tooling', 0.65]],\n119:   'production site': [['mcp-tooling', 0.65]],\n120:   'production website': [['mcp-tooling', 0.65]],\n121:   'production url': [['mcp-tooling', 0.65]],\n122:   'browser console': [['mcp-tooling', 0.75]],\n123:   'cleaner prompt': [['sk-prompt', 1]],\n124:   'code review': [['sk-code', 1]],\n125:   'review the routing': [['sk-code', 0.6]],\n126:   'review the taxonomy': [['sk-code', 0.6]],\n127:   'review the routing taxonomy': [['sk-code', 1.1], ['sk-doc', -0.4]],\n128:   'review the packet docs': [['sk-code', 1.2]],\n129:   'audit packet docs': [['sk-code',