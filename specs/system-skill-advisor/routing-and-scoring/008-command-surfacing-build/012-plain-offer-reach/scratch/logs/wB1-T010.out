"V1\",\"selectedPolicy\":{\"effectivePolicyHash\":\"0c36f5c183023baaed6076575b48271ef45e528322d8abb079f83cc0fd8843ed\",\"generation\":5},\"servingAuthority\":\"compiled\",\"shadowOnly\":false}\n+{\"schemaVersion\":\"V1\",\"selectedPolicy\":{\"effectivePolicyHash\":\"c0ef88b811d75969ee726921ac8797265388fe009069d3af3fae5647da09298d\",\"generation\":5},\"servingAuthority\":\"compiled\",\"shadowOnly\":false}\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"git -c core.fsmonitor=false diff -- .skilled/bin/lib/compiled-routing/013-live-activation/activation/sk-doc/manifest.json | head -30\",\"workdir\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research\"}"},"time":{"start":1794544358614,"end":1794544359436}}}}
