o mode scores (zero-signal branch), and then only as the defer-time suggestion offered with the disambiguation checklist. It is never a stage-two preamble loaded on every route, and never unioned into a scored route's resource set.\",\n35:     \"bundleRules\": [\n36:       {\n37:         \"name\": \"create-then-quality\",\n38:         \"whenAll\": [\n39:           \"sk-create-skill\",\n40:           \"sk-create-quality-control\"\n41:         ],\n42:         \"outcome\": \"orderedBundle\"\n43:       }\n44:     ],\n45:     \"discoveryClasses\": [\n46:       \"hub-identity\"\n47:     ],\n48:     \"discoveryClassesContract\": \"Classes listed here are hub discovery/defer evidence only. They are intentionally referenced by NO mode's scoring classes: a prompt naming only the hub scores zero modes and takes the defer outcome instead of fanning out to every authoring mode.\"\n49:   },\n50:   \"routerSignals\": {\n51:     \"sk-create-skill\": {\n52:       \"weight\": 4,\n53:       \"classes\": [\n54:         \"create-skill-aliases\"\n55:       ],\n56:       \"resources\": [\n57:         \"sk-create-skill/SKILL.md\"\n58:       ]\n59:     },\n60:     \"sk-create-skill-parent\": {\n61:       \"weight\": 4,\n62:       \"classes\": [\n63:         \"create-skill-parent-aliases\"\n64:       ],\n65:       \"resources\": [\n66:         \"sk-create-skill/SKILL.md\"\n67:       ]\n68:     },\n69:     \"sk-create-readme\": {\n70:       \"weight\": 4,\n71:       \"classes\": [\n72:         \"create-readme-aliases\"\n73:       ],\n74:       \"resources\": [\n75:         \"sk-create-readme/SKILL.md\"\n76:       ]\n77:     },\n78:     \"sk-create-agent\": {\n79:       \"weight\": 4,\n80:       \"classes\": [\n81:         \"create-agent-aliases\"\n82:       ],\n83:       \"resources\": [\n84:         \"sk-create-agent/SKILL.md\"\n85:       ]\n86:     },\n87:     \"sk-create-command\": {\n88:       \"weight\": 3,\n89:       \"classes\": [\n90:         \"create-command-aliases\"\n91:       ],\n92:       \"resources\": [\n93:         \"sk-create-command/SKILL.md\"\n94:       ]\n95:     },\n96:     \"sk-create-feature-catalog\": {\n97:       \"weight\": 4,\n98:       \"classes\": [\n99:         \"create-feature-catalog-aliases\"\n100:       ],\n101:       \"resources\": [\n102:         \"sk-create-feature-catalog/SKILL.md\"\n103:       ]\n104:     },\n105:     \"sk-create-manual-testing-playbook\": {\n106:       \"weight\": 4,\n107:       \"classes\": [\n108:         \"create-manual-testing-playbook-aliases\"\n109:       ],\n110:       \"resources\": [\n111:         \"sk-create-manual-testing-playbook/SKILL.md\"\n112:       ]\n113:     },\n114:     \"sk-create-benchmark\": {\n115:       \"weight\": 3,\n116:       \"classes\": [\n117:         \"create-benchmark-aliases\"\n118:       ],\n119:       \"resources\": [\n120:         \"sk-create-benchmark/SKILL.md\"\n121:       ]\n122:     },\n123:     \"sk-create-changelog\": {\n124:       \"weight\": 3,\n125:       \"classes\": [\n126:         \"create-changelog-aliases\"\n127:       ],\n128:       \"resources\": [\n129:         \"sk-create-changelog/SKILL.md\"\n130:       ]\n131:     },\n132:     \"sk-create-diff\": {\n133:       \"weight\": 3,\n134:       \"classes\": [\n135:         \"create-diff-aliases\"\n136:       ],\n137:       \"resources\": [\n138:         \"sk-create-diff/SKILL.md\"\n139:       ]\n140:     },\n141:     \"sk-create-quality-control\": {\n142:       \"weight\": 4,\n143:       \"classes\": [\n144:         \"create-quality-control-aliases\",\n145:         \"quality-actions\"\n146:       ],\n147:       \"resources\": [\n148:         \"sk-create-quality-control/SKILL.md\"\n149:       ]\n150:     },\n151:     \"sk-create-repo-rule\": {\n152:       \"weight\": 4,\n153:       \"classes\": [\n154:         \"create-repo-rule-aliases\"\n155:       ],\n156:       \"resources\": [\n157:         \"sk-create-repo-rule/SKILL.md\"\n158:       ]\n159:     },\n160:     \"sk-create-with-human-voice\": {\n161:       \"weight\": 4,\n162:       \"classes\": [\n163:         \"create-with-human-voice-aliases\"\n164:       ],\n165:       \"resources\": [\n166:         \"sk-create-with-human-voice/SKILL.md\"\n167:       ]\n168:     },\n169:     \"sk-create-frontmatter\": {\n170:       \"weight\": 4,\n171:       \"classes\": [\n172:         \"create-frontmatter-aliases\"\n173:       ],\n174:       \"resources\": [\n175:         \"sk-create-frontmatter/SKILL.md\"\n176:       ]\n177:     },\n178:     \"sk-create-goal\": {\n179:       \"weight\": 4,\n180:       \"classes\": [\n181:         \"create-goal-aliases\"\n182:       ],\n183:       \"resources\": [\n184:         \"sk-create-goal/SKILL.md\"\n185:       ]\n186:     }\n187:   },\n188:   \"vocabularyClasses\": {\n189:     \"quality-actions\": {\n190:       \"keywords\": [\n191:         \"validate\",\n192:         \"score\",\n193:         \"optimize\",\n194:         \"harden\",\n195:         \"audit\"\n196:       ]\n197:     },\n198:     \"create-skill-aliases\": {\n199:       \"keywords\": [\n200:         \"create skill\",\n201:         \"new skill\",\n202:         \"skill scaffold\",\n203:         \"SKILL.md scaffold\",\n204:         \"OpenCode skill\",\n205:         \"package skill\",\n206:         \"sk-skill\",\n207:         \"create sk-\",\n208:         \"reusable capability\",\n209:         \"reusable helper\",\n210:         \"starter reference docs\",\n211:         \"which json files does a skill need\",\n212:         \"skill root metadata contract\",\n213:         \"leaf-manifest config aliases required\",\n214:         \"hub versus standalone skill class\",\n215:         \"create a skill\",\n216:         \"build a skill\",\n217:         \"author a skill\",\n218:         \"scaffold a skill\",\n219:         \"/create:skill\",\n220:         \"doc rewrite guard\",\n221:         \"doc-rewrite-guard.py\",\n222:         \"render ledger\",\n223:         \"render-known-debt.json\",\n224:         \"exempt from the render chec