624:// rather than the operator's authenticated one, and an empty credential helper
631:  GIT_CONFIG_KEY_0: 'credential.helper',
645:  env.GH_CONFIG_DIR = ghConfig;
646:  env.GIT_TERMINAL_PROMPT = '0';
rg exit=0
