ls/system-skill-advisor/runtime/scripts/command-bridges/derive-command-bridges.cjs\n@@ -53,8 +53,30 @@\n // reverse) and nothing downstream would notice.\n const MUTATING_CLASSES = ['read-only', 'add-only', 'mutates'];\n const ASK_FIRST_REASONS = ['settings', 'outside-repo', 'spend', 'relaunch'];\n const WRITE_SCOPES = ['spec-folder'];\n+// A lead phrase outranks a passing skill, which is only safe when the prompt asks\n+// about the state of something. A phrase that names no state or health word could\n+// outrank the skill on an ordinary task, so it belongs only on a route that\n+// already asks before it runs.\n+const LEAD_PHRASE_STATE_WORDS = [\n+  'check',\n+  'state',\n+  'status',\n+  'report',\n+  'health',\n+  'off',\n+  'on',\n+  'which',\n+  'show',\n+  'list',\n+  'inventory',\n+  'drift',\n+  'stale',\n+  'missing',\n+  'failing',\n+  'broken',\n+];\n const RENDER_PATH = join(SKILLS_ROOT, 'system-skill-advisor', 'runtime', 'lib', 'render.ts');\n const RENDER_GENERATED_START = '// BEGIN GENERATED DOCTOR COMMANDS';\n const RENDER_GENERATED_END = '// END GENERATED DOCTOR COMMANDS';\n const COMMAND_ATTACH_PATH = join(\n","status":"modified","additions":22,"deletions":0}],"truncated":false},"content":[{"type":"text","text":"Edited .skilled/skills/system-skill-advisor/runtime/scripts/command-bridges/derive-command-bridges.cjs (1 replacement)"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/scripts/command-bridges/derive-command-bridges.cjs\",\"oldString\":\"const MUTATING_CLASSES = ['read-only', 'add-only', 'mutates'];\\nconst ASK_FIRST_REASONS = ['settings', 'outside-repo', 'spend', 'relaunch'];\\nconst WRITE_SCOPES = ['spec-folder'];\",\"newString\":\"const MUTATING_CLASSES = ['read-only', 'add-only', 'mutates'];\\nconst ASK_FIRST_REASONS = ['settings', 'outside-repo', 'spend', 'relaunch'];\\nconst WRITE_SCOPES = ['spec-folder'];\\n// A lead phrase outranks a passing skill, which is only safe when the prompt asks\\n// about the state of something. A phrase that names no state or health word could\\n// outrank the skill on an ordinary task, so it belongs only on a route that\\n// already asks before it runs.\\nconst LEAD_PHRASE_STATE_WORDS = [\\n  'check',\\n  'state',\\n  'status',\\n  'report',\\n  'health',\\n  'off',\\n  'on',\\n  'which',\\n  'show',\\n  'list',\\n  'inventory',\\n  'drift',\\n  'stale',\\n  'missing',\\n  'failing',\\n  'broken',\\n];\"}"},"time":{"start":1794522612669,"end":1794522615033}}}}
