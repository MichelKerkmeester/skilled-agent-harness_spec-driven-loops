.txt\n?? specs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/007-per-runtime-behaviour-proof/scratch/briefs/w17a-T016.txt\n?? specs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/007-per-runtime-behaviour-proof/scratch/briefs/w17a-T017.txt\n?? specs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/007-per-runtime-behaviour-proof/scratch/briefs/w17a-T021.txt\n?? specs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/007-per-runtime-behaviour-proof/scratch/g2-fixture/\n?? specs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/007-per-runtime-behaviour-proof/scratch/logs/w17a-T016.err\n?? specs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/007-per-runtime-behaviour-proof/scratch/logs/w17a-T016.out\n?? specs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/007-per-runtime-behaviour-proof/scratch/logs/w17a-T017.err\n?? specs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/007-per-runtime-behaviour-proof/scratch/logs/w17a-T017.out\n?? specs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/007-per-runtime-behaviour-proof/scratch/logs/w17a-T021.err\n?? specs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/007-per-runtime-behaviour-proof/scratch/logs/w17a-T021.out\n?? specs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/007-per-runtime-behaviour-proof/scratch/runs-pre.jsonl\n?? specs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/008-embedder-setup-and-cost/scratch/briefs/\n?? specs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/008-embedder-setup-and-cost/scratch/logs/\n---DIFF---\ndiff --git a/.skilled/skills/system-skill-advisor/runtime/scripts/command-bridges/derive-command-bridges.cjs b/.skilled/skills/system-skill-advisor/runtime/scripts/command-bridges/derive-command-bridges.cjs\nindex 6a1ed1e488..5a9dd8f1d0 100644\n--- a/.skilled/skills/system-skill-advisor/runtime/scripts/command-bridges/derive-command-bridges.cjs\n+++ b/.skilled/skills/system-skill-advisor/runtime/scripts/command-bridges/derive-command-bridges.cjs\n@@ -54,6 +54,28 @@ const DOCTOR_MCP_COMMAND = '/doctor:mcp';\n const MUTATING_CLASSES = ['read-only', 'add-only', 'mutates'];\n const ASK_FIRST_REASONS = ['settings', 'outside-repo', 'spend', 'relaunch'];\n const WRITE_SCOPES = ['spec-folder'];\n+// A lead phrase outranks a passing skill, which is only safe when the prompt asks\n+// about the state of something. A phrase that names no state or health word could\n+// outrank the skill on an ordinary task, so it belongs only on a route that\n+// already asks before it runs.\n+const LEAD_PHRASE_STATE_WORDS = [\n+  'check',\n+  'state',\n+  'status',\n+  'report',\n+  'health',\n+  'off',\n+  'on',\n+  'which',\n+  'show',\n+  'list',\n+  'inventory',\n+  'drift',\n+  'stale',\n+  'missing',\n+  'failing',\n+  'broken',\n+];\n const RENDER_PATH = join(SKILLS_ROOT, 'system-skill-advisor', 'runtime', 'lib', 'render.ts');\n const RENDER_GENERATED_START = '// BEGIN GENERATED DOCTOR COMMANDS';\n const RENDER_GENERATED_END = '// END GENERATED DOCTOR COMMANDS';\n@@ -743,16 +765,39 @@ function doctorDefaultTarget(route, label, multiTarget) {\n   return route.command;\n }\n \n+// A lead phrase is matched against the whole prompt, so the state word has to be\n+// a word of its own: \"on\" inside \"environment\" would clear a phrase that asks\n+// nothing about state.\n+function hasStateWord(phrase) {\n+  return phrase\n+    .toLowerCase()\n+    .split(/[^a-z0-9]+/)\n+    .some((word) => LEAD_PHRASE_STATE_WORDS.includes(word));\n+}\n+\n+// A route that asks first may lead with a phrase that names no state or health\n+// word, because the ask already keeps the run behind a decision.\n function doctorLeadPhrases(item, label, triggerPhrases) {\n   const leadPhrases = Object.prototype.hasOwnProperty.call(item, 'lead_phrases')\n     ? stringArray(item.lead_phrases, `${label}.lead_phrases`)\n     : [];\n+  const asksFirst = derivePolicy({\n+    doctor: true,\n+    mutating: item.mutating,\n+    ask_first: item.ask_first,\n+    write_scope: item.write_scope,\n+  }) === 'ask';\n   for (const phrase of leadPhrases) {\n     if (!triggerPhrases.includes(phrase)) {\n       throw new Error(\n         `[command-bridges] ${label}.lead_phrases entry ${JSON.stringify(phrase)} must also appear in trigger_phrases`,\n       );\n     }\n+    if (!asksFirst && !hasStateWord(phrase)) {\n+      throw new Error(\n+        `[command-bridges] ${label}.lead_phrases entry ${JSON.stringify(phrase)} needs a state or health word because its route does not ask first`,\n+      );\n+    }\n   }\n   return leadPhrases;\n }\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":" M .skilled/skills/system-skill-advisor/runtime/scripts/command-bridges/derive-command-bridges.cjs\n M .skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/README.md\n M specs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/007-per-runtime-behaviour-proof/scratch/pre-change-commit.txt\n?? specs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/005-recommendation-contract-and-brief/scratch/before.txt\n?? specs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/005-recommendation-contract-and-brief/scratch/brief-heads-before.txt\n?? specs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/005-recommendation-contract-and-brief/scratch/brief-heads.mjs\n?? specs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/005-recommendation-contract-and-brief/scratch/briefs/\n?? specs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/005-recommendation-contract-and-brief/scratch/logs/\n?? specs/system-skill-advisor/routing-and-scoring/008-command-sur