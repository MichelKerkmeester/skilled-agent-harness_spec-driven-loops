{"type":"tool_use","timestamp":1794522592121,"sessionID":"ses_e2e209c6fffekjqz9ELii6MPkV","part":{"partID":"prt_1d1e1b077001fIR8dByZ56BCCO","sessionID":"ses_e2e209c6fffekjqz9ELii6MPkV","messageID":"msg_1d1e19f28001KM7zlawHbxog7c","type":"tool","id":"call_ccb432e99566492c85667a66","tool":"shell","state":{"status":"completed","input":{"command":"sed -n '500,550p' .skilled/commands/doctor/scripts/route-validate.py"},"output":"\ndef check_trigger_phrases(routes: Sequence[Dict[str, Any]], result: Result) -> None:\n    \"\"\"G1: every route carries at least one trigger phrase.\"\"\"\n    g1_failed = False\n    for route in routes:\n        target = route.get(\"target\")\n        if len(route.get(\"trigger_phrases\") or []) < 1:\n            result.fail(f\"G1: route '{target}' has empty trigger_phrases (schema requires >=1 descriptive phrase per route)\")\n            g1_failed = True\n    if not g1_failed:\n        result.passed(\"G1: every route has ≥1 trigger phrase\")\n\n\ndef check_lead_phrases(manifest: Dict[str, Any], result: Result) -> None:\n    \"\"\"G2: lead phrases are long enough and belong to the same item's triggers.\"\"\"\n    g2_failed = False\n    for section in (\"routes\", \"standalone\", \"mcp_subroutes\"):\n        items = manifest.get(section, [])\n        if not isinstance(items, list):\n            continue\n        for index, item in enumerate(items):\n            if not isinstance(item, dict) or \"lead_phrases\" not in item:\n                continue\n            label = f\"{section}[{index}].lead_phrases\"\n            lead_phrases = item[\"lead_phrases\"]\n            if not isinstance(lead_phrases, list) or any(\n                not isinstance(phrase, str) for phrase in lead_phrases\n            ):\n                result.fail(f\"G2: {label} must be a list of strings\")\n                g2_failed = True\n                continue\n\n            trigger_phrases = item.get(\"trigger_phrases\")\n            for phrase in lead_phrases:\n                if len(phrase.split()) < 3:\n                    result.fail(\n                        f\"G2: {label} phrase {phrase!r} has fewer than three space-separated words\"\n                    )\n                    g2_failed = True\n                if not isinstance(trigger_phrases, list) or phrase not in trigger_phrases:\n                    result.fail(\n                        f\"G2: {label} phrase {phrase!r} is missing from trigger_phrases\"\n                    )\n                    g2_failed = True\n\n    if not g2_failed:\n        result.passed(\"G2: lead_phrases are valid across routes, standalone and mcp_subroutes\")\n\n\ndef check_default_targets(routes: Sequence[Dict[str, Any]], result: Result) -> None:\n    \"\"\"G3: default_target is a boolean, read-only, and set on at most one target per command.\"\"\"\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"\ndef check_trigger_phrases(routes: Sequence[Dict[str, Any]], result: Result) -> None:\n    \"\"\"G1: every route carries at least one trigger phrase.\"\"\"\n    g1_failed = False\n    for route in routes:\n        target = route.get(\"target\")\n        if len(route.get(\"trigger_phrases\") or []) < 1:\n            result.fail(f\"G1: route '{target}' has empty trigger_phrases (schema requires >=1 descriptive phrase per route)\")\n            g1_failed = True\n    if not g1_failed:\n        result.passed(\"G1: every route has ≥1 trigger phrase\")\n\n\ndef check_lead_phrases(manifest: Dict[str, Any], result: Result) -> None:\n    \"\"\"G2: lead phrases are long enough and belong to the same item's triggers.\"\"\"\n    g2_failed = False\n    for section in (\"routes\", \"standalone\", \"mcp_subroutes\"):\n        items = manifest.get(section, [])\n        if not isinstance(items, list):\n            continue\n        for index, item in enumerate(items):\n            if not isinstance(item, dict) or \"lead_phrases\" not in item:\n                continue\n            label = f\"{section}[{index}].lead_phrases\"\n            lead_phrases = item[\"lead_phrases\"]\n            if not isinstance(lead_phrases, list) or any(\n                not isinstance(phrase, str) for phrase in lead_phrases\n            ):\n                result.fail(f\"G2: {label} must be a list of strings\")\n                g2_failed = True\n                continue\n\n            trigger_phrases = item.get(\"trigger_phrases\")\n            for phrase in lead_phrases:\n                if len(phrase.split()) < 3:\n                    result.fail(\n                        f\"G2: {label} phrase {phrase!r} has fewer than three space-separated words\"\n                    )\n                    g2_failed = True\n                if not isinstance(trigger_phrases, list) or phrase not in trigger_phrases:\n                    result.fail(\n                        f\"G2: {label} phrase {phrase!r} is missing from trigger_phrases\"\n                    )\n                    g2_failed = True\n\n    if not g2_failed:\n        result.passed(\"G2: lead_phrases are valid across routes, standalone and mcp_subroutes\")\n\n\ndef check_default_targets(routes: Sequence[Dict[str, Any]], result: Result) -> None:\n    \"\"\"G3: default_target is a boolean, read-only, and set on at most one target per command.\"\"\"\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"sed -n '500,550p' .skilled/commands/doctor/scripts/route-validate.py\"}"},"time":{"start":1794522591351,"end":1794522592121}}}}
